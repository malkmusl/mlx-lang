# Imports a layer must not make (mlx-codemap layers; tools/codemap/structure.mlx).
# One rule a line: a path (directory or file) and the paths it must not import.
std !-> projects examples tools compiler experiments tests
compiler !-> projects examples tools experiments tests

# The compiler's own import closure never reaches the std root: it stays
# what the previous canonical compiler and mlx0 build (tools/check_bootstrap.sh,
# compiler/selfhost/README.md). The compiler imports std.crash; these are
# the std/src modules it brings in, and std/bootstrap under them.
compiler/selfhost !-> std/src/std.mlx
std/bootstrap !-> std/src/std.mlx
std/src/crash.mlx !-> std/src/std.mlx
std/src/leaks.mlx !-> std/src/std.mlx
std/src/diagnostics.mlx !-> std/src/std.mlx
std/src/turns.mlx !-> std/src/std.mlx
std/src/heap.mlx !-> std/src/std.mlx
std/src/io.mlx !-> std/src/std.mlx
