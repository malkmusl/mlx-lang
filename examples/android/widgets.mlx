// std.ui's widgets on Android and on the desktop, from this one file
// (std.ui.host): the same switch rows, check rows, buttons and segments as
// the desktop apps, driven by the finger or the mouse, below the status bar
// and above the navigation bar on a phone.
//
// Build (from the repository root):
//   mlx-out/bin/compiler/mlx4 examples/android/widgets.mlx -o widgets.apk \
//       --target=aarch64-android --android-package=dev.mlxlang.widgets \
//       --android-label="Mlx Widgets"
//   mlx-out/bin/compiler/mlx4 examples/android/widgets.mlx -o widgets
const std = @import("std")
const ui = @import("std.ui")
const app = @import("std.ui.app")
const host_module = @import("std.ui.host")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const controls = @import("std.ui.controls")

fn options() -> host_module.Options {
    return host_module.Options.{ .title = "Mlx Widgets", .appId = "dev.mlxlang.widgets", .width = 480, .height = 760, .minWidth = 0, .minHeight = 0 }
}

const State = struct {
    host: *host_module.Host
    // The window's size (EVENT_CONFIGURED): the layout's, also in a
    // layout pass.
    width: i32
    height: i32
    ui: view.Ui
    theme: theme_module.Theme
    body: text_module.Text
    small: text_module.Text
    fontScale: i32
    dark: bool
    sounds: bool
    names: bool
    choice: usize
    taps: usize
}

fn stateOf(context: *anyopaque) -> *State {
    unsafe { return @ptrCast(*State, context) }
}

fn uiOf(state: *State) -> *view.Ui {
    unsafe { return @ptrCast(*view.Ui, &state.*.ui) }
}

fn themeOf(state: *State) -> *theme_module.Theme {
    unsafe { return @ptrCast(*theme_module.Theme, &state.*.theme) }
}

fn draw(context: *anyopaque, canvas: *canvas_module.Canvas) -> void {
    const state = stateOf(context)
    if state.*.fontScale == 0 { return }
    const widgets = uiOf(state)
    const theme = themeOf(state)
    view.begin(widgets, canvas)
    canvas_module.clear(canvas, theme.*.background)
    // The space the system bars leave, with a margin.
    const scale = host_module.scale(state.*.host)
    const free = ui.inset(ui.inset(ui.rect(0, 0, state.*.width, state.*.height), host_module.insets(state.*.host)), ui.uniform(8 * scale))
    const row = 32 * scale
    var y = free.y
    if controls.switchRow(widgets, view.id("dark"), ui.rect(free.x, y, free.width, row), "Dark look", "The desktop apps' colours", state.*.dark) {
        state.*.dark = !state.*.dark
        theme.* = if state.*.dark { theme_module.dark() } else { theme_module.light() }
    }
    y += row + 8
    if controls.switchRow(widgets, view.id("sounds"), ui.rect(free.x, y, free.width, row), "Sounds", "A click for every tap", state.*.sounds) { state.*.sounds = !state.*.sounds }
    y += row + 8
    if controls.checkRow(widgets, view.id("names"), ui.rect(free.x, y, free.width, row), "Show names", if state.*.names { controls.CHECK_ON } else { controls.CHECK_OFF }) { state.*.names = !state.*.names }
    y += row + 24
    // One of three.
    controls.segmentsFrame(widgets, ui.rect(free.x, y, free.width, row))
    const third = (free.width - 4) / 3
    var segment: usize = 0
    while segment < 3 {
        const label = if segment == 0 { "Small" } else if segment == 1 { "Medium" } else { "Large" }
        if controls.segment(widgets, view.idOf(view.id("size"), segment), ui.rect(free.x + 2 + @intCast(i32, segment) * third, y + 2, third, row - 4), label, state.*.choice == segment, 0) { state.*.choice = segment }
        segment += 1
    }
    y += row + 24
    if controls.button(widgets, view.id("tap"), ui.rect(free.x, y, free.width, row), "Tap me", controls.BUTTON_PRIMARY, true) { state.*.taps += 1 }
    y += row + 16
    var digits: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    var length: usize = 0
    var count = state.*.taps
    if count == 0 {
        bytes[0] = 48
        length = 1
    }
    while count > 0 && length < 20 {
        bytes[length] = @intCast(u8, 48 + count % 10)
        count /= 10
        length += 1
    }
    // The digits came backwards.
    var low: usize = 0
    while low < length / 2 {
        const swap = bytes[low]
        bytes[low] = bytes[length - 1 - low]
        bytes[length - 1 - low] = swap
        low += 1
    }
    controls.centeredLabel(widgets, widgets.*.body, bytes[0..length], ui.rect(free.x, y, free.width, row), theme.*.text)
    const again = view.end(widgets)
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const state = stateOf(context)
    if kind == app.EVENT_CONFIGURED {
        state.*.width = @bitCast(i32, a)
        state.*.height = b
        loadFonts(state)
    }
    if state.*.fontScale == 0 { return }
    // Laid out before a press; a click is taken at once (the runtime
    // paints after every touch).
    if app.pressing(kind, a, b) { layOut(context) }
    const fed = app.feed(uiOf(state), kind, a, b)
    if fed == app.FEED_CLICK { layOut(context) }
    if fed != app.FEED_NONE || kind == app.EVENT_CONFIGURED { host_module.redraw(state.*.host) }
}

fn layOut(context: *anyopaque) -> void {
    var nowhere = view.layoutCanvas()
    draw(context, &nowhere)
}

// Text at the window's scale (the system's fonts, see std.ui.text).
fn loadFonts(state: *State) -> void {
    const scale = host_module.scale(state.*.host)
    if scale == state.*.fontScale { return }
    var body: *text_module.Text = undefined
    var small: *text_module.Text = undefined
    unsafe {
        body = @ptrCast(*text_module.Text, &state.*.body)
        small = @ptrCast(*text_module.Text, &state.*.small)
    }
    if state.*.fontScale != 0 {
        text_module.unloadText(body)
        text_module.unloadText(small)
    }
    state.*.fontScale = scale
    const allocator = std.page_allocator.init()
    const loaded_body = text_module.loadText(body, @intCast(u32, 14 * scale), allocator)
    const loaded_small = text_module.loadText(small, @intCast(u32, 11 * scale), allocator)
    view.init(uiOf(state), themeOf(state), body, small, body)
}

fn create() -> ?*State {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(State), 16)
    if memory == null { return null }
    var state: *State = undefined
    unsafe { state = @ptrCast(*State, memory.?) }
    state.*.width = 0
    state.*.height = 0
    state.*.fontScale = 0
    state.*.dark = true
    state.*.sounds = false
    state.*.names = true
    state.*.choice = 1
    state.*.taps = 0
    themeOf(state).* = theme_module.dark()
    const host = host_module.create(options(), @ptrCast(*anyopaque, state), draw, onEvent)
    if host == null { return null }
    state.*.host = host.?
    return state
}

pub fn main(arguments: [][*]const u8) -> !void {
    const state = create()
    if state == null { return }
    try host_module.open(state.?.*.host, arguments)
    try host_module.run(state.?.*.host)
}

export fn ANativeActivity_onCreate(activity: usize, saved_state: usize, saved_state_size: usize) -> void {
    const state = create()
    if state == null { return }
    const opened = host_module.openActivity(state.?.*.host, activity, saved_state, saved_state_size)
}
