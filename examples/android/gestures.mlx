// Touch gestures on Android: the screen shows the color of the last
// recognized gesture, below the status bar and above the navigation bar
// (the space std.android reserves for them only gets the background).
//
//   blue     nothing yet        green    tap
//   yellow   long press         red      swipe right
//   magenta  swipe left         cyan     swipe down
//   orange   swipe up
//
// Build (from the repository root):
//   zig-out/bin/mlx1 examples/android/gestures.mlx -o gestures.apk \
//       --target=aarch64-android --android-package=dev.mlxlang.gestures \
//       --android-label="Mlx Gestures"
const android = @import("std.android")

const NONE: usize = 0
const TAP: usize = 1
const LONG_PRESS: usize = 2
const SWIPE_RIGHT: usize = 3
const SWIPE_LEFT: usize = 4
const SWIPE_DOWN: usize = 5
const SWIPE_UP: usize = 6

fn color(state: usize) -> u32 {
    if state == TAP { return android.rgb(0, 200, 0) }
    if state == LONG_PRESS { return android.rgb(255, 220, 0) }
    if state == SWIPE_RIGHT { return android.rgb(220, 0, 0) }
    if state == SWIPE_LEFT { return android.rgb(255, 0, 255) }
    if state == SWIPE_DOWN { return android.rgb(0, 255, 255) }
    if state == SWIPE_UP { return android.rgb(255, 128, 0) }
    return android.rgb(0, 0, 255)
}

fn draw(canvas: *android.Canvas, state: usize) -> void {
    android.fill(canvas, android.rgb(16, 20, 24))
    android.fillArea(canvas, canvas.*.free, color(state))
}

fn update(state: usize, gesture: android.Gesture) -> usize {
    match gesture {
        android.Gesture.tap => { return TAP },
        android.Gesture.long_press => { return LONG_PRESS },
        android.Gesture.swipe_right => { return SWIPE_RIGHT },
        android.Gesture.swipe_left => { return SWIPE_LEFT },
        android.Gesture.swipe_down => { return SWIPE_DOWN },
        else => { return SWIPE_UP },
    }
    return state
}

export fn ANativeActivity_onCreate(activity: usize, saved_state: usize, saved_state_size: usize) -> void {
    android.start(activity, saved_state, saved_state_size, draw, update)
}
