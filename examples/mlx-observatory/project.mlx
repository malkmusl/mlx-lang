// New files and folders, branches and the graph, building and committing (part of main.mlx, split from it).
const std = @import("std")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const panel_module = @import("../desktop-shared/panel.mlx")
const index_module = @import("../../tools/codemap/index.mlx")
const programs_module = @import("../../tools/codemap/programs.mlx")
const binaries_module = @import("../../tools/codemap/binaries.mlx")
const git_module = @import("../../tools/codemap/git.mlx")
const history_module = @import("../../tools/codemap/history.mlx")
const check_module = @import("../../tools/mlx-lsp/check.mlx")
const editor_module = @import("./editor.mlx")
const m = @import("./math3d.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const lists_module = @import("./lists.mlx")
const input_module = @import("./input.mlx")
const drawing_module = @import("./drawing.mlx")
const tabs_module = @import("./tabs.mlx")
const actions_module = @import("./actions.mlx")

// ---------------------------------------------------------------------------
// New files and folders (the sidebar's groups: + file, + folder)

// A group's folder relative to the root ("" for the root), into `into`;
// its length.
pub fn folderOf(codemap: *app.Codemap, node: u32, into: [*]u8) -> usize {
    var chain: [32]u32 = undefined
    var count: usize = 0
    var current = node
    const root = access_module.graphOf(codemap).*.root
    while current != app.NONE && current != root && count < 32 {
        chain[count] = current
        count += 1
        current = access_module.nodeOf(codemap, current).*.parent
    }
    var length: usize = 0
    while count > 0 {
        count -= 1
        if length > 0 { length = filters_module.writeText(into, length, "/") }
        length = filters_module.writeText(into, length, access_module.nameOf(codemap, chain[count]))
    }
    return length
}

// The field for a new file (or folder) in the folder `folder` (relative).
pub fn openCreate(codemap: *app.Codemap, folder: []const u8, is_folder: bool, y: i32) -> void {
    codemap.*.createDirLength = filters_module.writeText(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "createDir")), 0, if folder.length > 900 { folder[0..900] } else { folder })
    codemap.*.createFolder = is_folder
    codemap.*.createLength = 0
    codemap.*.createY = y
    codemap.*.createOpen = true
    codemap.*.searchFocused = false
}

pub fn createKey(codemap: *app.Codemap, key: u32) -> bool {
    if !codemap.*.createOpen { return false }
    if key == app.KEY_ESCAPE {
        codemap.*.createOpen = false
        return true
    }
    if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        createNamed(codemap, access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "createText"))[0..codemap.*.createLength])
        return true
    }
    if key == app.KEY_BACKSPACE {
        if codemap.*.createLength > 0 { codemap.*.createLength -= 1 }
        return true
    }
    const panel = access_module.panelOf(codemap)
    if panel.*.textLength == 0 || access_module.modifiers(codemap) & (app.CONTROL | app.ALT) != 0 { return true }
    var at: usize = 0
    while at < panel.*.textLength && codemap.*.createLength < 120 {
        const byte = panel.*.text[at]
        // A name: no slashes, no blanks at its start.
        if byte >= 32 && byte != 47 && !(byte == 32 && codemap.*.createLength == 0) {
            codemap.*.createText[codemap.*.createLength] = byte
            codemap.*.createLength += 1
        }
        at += 1
    }
    return true
}

// Makes it: a folder (then the field for a file in it, since a folder
// shows in the map with the code in it), or a file (.mlx when the name
// has no extension; the code read again, the file opened).
pub fn createNamed(codemap: *app.Codemap, name: []const u8) -> void {
    if name.length == 0 || access_module.sameBytes(name, ".") || access_module.sameBytes(name, "..") { return }
    var path: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    const folder = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "createDir"))[0..codemap.*.createDirLength]
    var length = filters_module.writeText(bytes, 0, access_module.rootText(codemap))
    if folder.length > 0 {
        length = filters_module.writeText(bytes, length, "/")
        length = filters_module.writeText(bytes, length, folder)
    }
    length = filters_module.writeText(bytes, length, "/")
    length = filters_module.writeText(bytes, length, name)
    var dotted = false
    for byte in name {
        if byte == 46 { dotted = true }
    }
    if !codemap.*.createFolder && !dotted { length = filters_module.writeText(bytes, length, ".mlx") }
    bytes[length] = 0
    // Relative to the root, for the notes.
    const relative_start = access_module.rootText(codemap).length + 1
    if codemap.*.createFolder {
        const made = std.linux.syscall2(83, @intFromPtr(bytes), 493)
        if made != 0 {
            access_module.setNote(codemap, access_module.say(codemap, "Cannot make the folder ", "Kann den Ordner nicht anlegen: "), bytes[relative_start..length])
            return
        }
        if codemap.*.trace { navigation_module.traceLine(codemap, "created folder ", bytes[relative_start..length]) }
        // Now its first file.
        var inner: [1024]u8 = undefined
        var inner_bytes: [*]u8 = undefined
        unsafe { inner_bytes = @ptrCast([*]u8, &inner) }
        const inner_length = filters_module.writeText(inner_bytes, 0, bytes[relative_start..length])
        openCreate(codemap, inner_bytes[0..inner_length], false, codemap.*.createY)
        access_module.setNote(codemap, access_module.say(codemap, "Folder made; now its first file: ", "Ordner angelegt; jetzt seine erste Datei: "), bytes[relative_start..length])
        return
    }
    // O_WRONLY | O_CREAT | O_EXCL: not over a file that is there.
    const file = std.fs.open(bytes, 193, 420)
    if !std.fs.isValid(file) {
        access_module.setNote(codemap, access_module.say(codemap, "Cannot make the file (is it there already?) ", "Kann die Datei nicht anlegen (gibt es sie schon?) "), bytes[relative_start..length])
        return
    }
    const closed = std.fs.close(file)
    codemap.*.createOpen = false
    if codemap.*.trace { navigation_module.traceLine(codemap, "created file ", bytes[relative_start..length]) }
    // In the index, then open.
    navigation_module.reload(codemap)
    const opened = tabs_module.openFile(codemap, bytes[0..length], 1, 1)
    access_module.setNote(codemap, access_module.say(codemap, "Made ", "Angelegt: "), bytes[relative_start..length])
}

// The field, over the sidebar's row it was asked for on.
pub fn drawCreate(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    if !codemap.*.createOpen { return }
    const slide = drawing_module.fadeIn(codemap, canvas, app.OVERLAY_CREATE, if codemap.*.createFolder { 2 } else { 1 })
    const x: i32 = 10
    const width: i32 = 360
    const y = codemap.*.createY - slide
    const height: i32 = 86
    canvas_module.fillRoundedRect(canvas, x + 2, y + 3, width, height, 9, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 9, canvas_module.color(250, 32, 34, 43))
    canvas_module.strokeRoundedRect(canvas, x, y, width, height, 9, 1, canvas_module.color(255, 58, 62, 76))
    var text: [1100]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeText(bytes, 0, if codemap.*.createFolder { access_module.say(codemap, "New folder in ", "Neuer Ordner in ") } else { access_module.say(codemap, "New file in ", "Neue Datei in ") })
    const folder = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "createDir"))[0..codemap.*.createDirLength]
    length = filters_module.writeText(bytes, length, if folder.length > 0 { folder } else { access_module.say(codemap, "the root", "der Wurzel") })
    length = filters_module.writeText(bytes, length, "/")
    canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 14, y + 10, app.DIM_COLOR, width - 28)
    canvas_module.fillRoundedRect(canvas, x + 12, y + 30, width - 24, 28, 7, canvas_module.color(255, 22, 24, 30))
    canvas_module.strokeRoundedRect(canvas, x + 11, y + 29, width - 22, 30, 8, 2, app.ACCENT)
    const name = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "createText"))[0..codemap.*.createLength]
    if name.length == 0 {
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), if codemap.*.createFolder { access_module.say(codemap, "name", "Name") } else { access_module.say(codemap, "name.mlx", "name.mlx") }, x + 22, y + 36, app.DIM_COLOR, width - 44)
    } else {
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), name, x + 22, y + 36, app.TEXT_COLOR, width - 44)
    }
    const caret = x + 22 + canvas_module.measure(access_module.bodyOf(codemap), name)
    if caret < x + width - 20 { canvas_module.fillRect(canvas, caret + 1, y + 35, 2, 17, app.ACCENT) }
    canvas_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "Enter makes it, Esc leaves it", "Enter legt an, Esc lässt es"), x + 14, y + 64, app.DIM_COLOR, width - 28)
}

// A page and a folder, each with a small plus (the group row's buttons).
pub fn drawNewIcon(canvas: *app.Canvas, x: i32, y: i32, folder: bool, color: u32) -> void {
    if folder {
        canvas_module.fillRoundedRect(canvas, x, y + 2, 12, 9, 2, color)
        canvas_module.fillRect(canvas, x, y, 5, 3, color)
    } else {
        canvas_module.strokeRoundedRect(canvas, x + 1, y, 9, 12, 2, 1, color)
    }
    canvas_module.fillRect(canvas, x + 8, y + 7, 7, 2, app.ACCENT)
    canvas_module.fillRect(canvas, x + 10, y + 5, 2, 7, app.ACCENT)
}

// ---------------------------------------------------------------------------
// Branches and the commit graph (the history's top and rows)

pub const BRANCH_BAR: i32 = 38

// The branch checked out and the local branches.
pub fn loadBranches(codemap: *app.Codemap) -> void {
    codemap.*.branchNameLength = 0
    codemap.*.branchCount = 0
    codemap.*.branchesLength = 0
    const git = access_module.gitOf(codemap)
    if !git_module.usable(git) { return }
    const head = git_module.run(git, "rev-parse --abbrev-ref HEAD")
    var head_end: usize = 0
    while head_end < head.length && head[head_end] != 10 && head_end < 120 { head_end += 1 }
    codemap.*.branchNameLength = filters_module.writeText(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "branchName")), 0, head[0..head_end])
    const text = git_module.run(git, "branch --format='%(refname:short)'")
    var at: usize = 0
    while at < text.length && codemap.*.branchCount < 32 {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        if line.length > 0 && codemap.*.branchesLength + line.length < 4096 {
            codemap.*.branchStart[codemap.*.branchCount] = codemap.*.branchesLength
            codemap.*.branchesLength = filters_module.writeText(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "branches")), codemap.*.branchesLength, line)
            codemap.*.branchEnd[codemap.*.branchCount] = codemap.*.branchesLength
            codemap.*.branchCount += 1
        }
        at = end + 1
    }
}

pub fn branchAt(codemap: *app.Codemap, at: usize) -> []const u8 {
    return access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "branches"))[codemap.*.branchStart[at]..codemap.*.branchEnd[at]]
}

pub fn branchName(codemap: *app.Codemap) -> []const u8 { return access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "branchName"))[0..codemap.*.branchNameLength] }

// Checks out a branch (-c: a new one from here); the code, the tabs and
// Changed follow.
pub fn switchBranch(codemap: *app.Codemap, name: []const u8, create: bool) -> void {
    const git = access_module.gitOf(codemap)
    if !git_module.usable(git) || name.length == 0 { return }
    git_module.begin(git)
    git_module.more(git, if create { "switch -c " } else { "switch " })
    git_module.addQuoted(git, name)
    const said = git_module.finish(git)
    if git.*.status != 0 {
        access_module.setNote(codemap, if create { access_module.say(codemap, "Cannot make the branch ", "Kann den Branch nicht anlegen: ") } else { access_module.say(codemap, "Cannot switch (changes not committed?) to ", "Kann nicht wechseln (Änderungen nicht committet?) zu ") }, name)
        return
    }
    codemap.*.popup = app.POPUP_NONE
    codemap.*.branchesOpen = false
    codemap.*.branchNaming = false
    // Tabs without edits read their files as the branch has them.
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        codemap.*.tabStamp[tab] = -2
        tab += 1
    }
    tabs_module.watchDiskTabs(codemap)
    navigation_module.reload(codemap)
    refreshChanges(codemap)
    access_module.runDiff(codemap)
    loadBranches(codemap)
    access_module.setNote(codemap, if create { access_module.say(codemap, "New branch: ", "Neuer Branch: ") } else { access_module.say(codemap, "On branch ", "Auf Branch ") }, name)
    if codemap.*.trace { navigation_module.traceLine(codemap, if create { "branch made " } else { "branch switched " }, name) }
}

// The keys of the new branch's name.
pub fn branchKey(codemap: *app.Codemap, key: u32) -> bool {
    if codemap.*.popup != app.POPUP_BASE || !codemap.*.branchNaming { return false }
    if key == app.KEY_ESCAPE {
        codemap.*.branchNaming = false
        return true
    }
    if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        switchBranch(codemap, access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "branchText"))[0..codemap.*.branchTextLength], true)
        return true
    }
    if key == app.KEY_BACKSPACE {
        if codemap.*.branchTextLength > 0 { codemap.*.branchTextLength -= 1 }
        return true
    }
    const panel = access_module.panelOf(codemap)
    if panel.*.textLength == 0 || access_module.modifiers(codemap) & (app.CONTROL | app.ALT) != 0 { return true }
    var at: usize = 0
    while at < panel.*.textLength && codemap.*.branchTextLength < 100 {
        const byte = panel.*.text[at]
        // What a branch name may hold: no blanks, ~ ^ : ? * [ \.
        if byte > 32 && byte != 126 && byte != 94 && byte != 58 && byte != 63 && byte != 42 && byte != 91 && byte != 92 {
            codemap.*.branchText[codemap.*.branchTextLength] = byte
            codemap.*.branchTextLength += 1
        }
        at += 1
    }
    return true
}

// The history's top: the branch (a list of the others opens) and New
// branch.
pub fn drawBranchBar(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> void {
    const y = top + 8
    const name = branchName(codemap)
    const label_width = canvas_module.measure(access_module.bodyOf(codemap), if name.length > 0 { name } else { "-" }) + 46
    codemap.*.branchButtonX = x + 12
    codemap.*.branchButtonWidth = label_width
    const lit = codemap.*.hover == app.HIT_BRANCH || codemap.*.branchesOpen
    canvas_module.fillRoundedRect(canvas, x + 12, y, label_width, 26, 7, if lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    drawBranchGlyph(canvas, x + 20, y + 6, filters_module.canvasColor(app.CHANGED_COLOR, 255))
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), if name.length > 0 { name } else { "-" }, x + 36, y + 4, app.TEXT_COLOR, 0)
    drawing_module.drawArrow(canvas, x + 12 + label_width - 16, y + 8, true, app.DIM_COLOR)
    const new_label = access_module.say(codemap, "New branch", "Neuer Branch")
    const new_width = canvas_module.measure(access_module.bodyOf(codemap), new_label) + 24
    codemap.*.newBranchX = x + width - 12 - new_width
    codemap.*.newBranchWidth = new_width
    canvas_module.fillRoundedRect(canvas, codemap.*.newBranchX, y, new_width, 26, 7, if codemap.*.hover == app.HIT_NEW_BRANCH || codemap.*.branchNaming { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), new_label, codemap.*.newBranchX + 12, y + 4, app.TEXT_COLOR, 0)
    canvas_module.fillRect(canvas, x + 12, top + BRANCH_BAR - 1, width - 24, 1, canvas_module.color(255, 58, 62, 76))
}

// A small branch: two dots on a line and a fork.
pub fn drawBranchGlyph(canvas: *app.Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x + 2, y, 2, 14, color)
    drawing_module.drawDot(canvas, x + 3, y + 2, 5, color)
    drawing_module.drawDot(canvas, x + 3, y + 12, 5, color)
    drawing_module.drawDot(canvas, x + 10, y + 4, 5, color)
    drawLine(canvas, x + 10, y + 6, x + 4, y + 11, color)
}

// A line of two pixels' width from (x0, y0) to (x1, y1).
fn drawLine(canvas: *app.Canvas, x0: i32, y0: i32, x1: i32, y1: i32, color: u32) -> void {
    const dx = if x1 > x0 { x1 - x0 } else { x0 - x1 }
    const dy = if y1 > y0 { y1 - y0 } else { y0 - y1 }
    const steps = if dx > dy { dx } else { dy }
    if steps == 0 {
        canvas_module.fillRect(canvas, x0, y0, 2, 2, color)
        return
    }
    var step: i32 = 0
    while step <= steps {
        canvas_module.fillRect(canvas, x0 + (x1 - x0) * step / steps, y0 + (y1 - y0) * step / steps, 2, 2, color)
        step += 1
    }
}

fn laneColor(lane: usize) -> u32 {
    const which = lane % 6
    if which == 0 { return filters_module.canvasColor(app.ACCENT, 255) }
    if which == 1 { return filters_module.canvasColor(app.CHANGED_COLOR, 255) }
    if which == 2 { return filters_module.canvasColor(app.WORKAROUND_COLOR, 255) }
    if which == 3 { return filters_module.canvasColor(app.COMPLEX_COLOR, 255) }
    if which == 4 { return filters_module.canvasColor(app.CRASH_COLOR, 255) }
    return filters_module.canvasColor(app.TYPE_COLOR, 255)
}

// A row of git's graph (* | / \ _), each column 7 pixels wide, lanes in
// their colors; the commit's dot.
pub fn drawGraphRow(canvas: *app.Canvas, graph: []const u8, x: i32, y: i32, height: i32) -> void {
    const cell: i32 = 7
    var at: usize = 0
    while at < graph.length {
        const byte = graph[at]
        const cx = x + @intCast(i32, at) * cell
        const color = laneColor(at / 2)
        if byte == 124 {
            canvas_module.fillRect(canvas, cx, y, 2, height, color)
        } else if byte == 42 {
            canvas_module.fillRect(canvas, cx, y, 2, height, color)
            drawing_module.drawDot(canvas, cx + 1, y + height / 2, 9, color)
        } else if byte == 47 {
            drawLine(canvas, cx + cell, y, cx - cell, y + height, laneColor((at + 1) / 2))
        } else if byte == 92 && at > 0 {
            drawLine(canvas, cx - cell, y, cx + cell, y + height, laneColor((at - 1) / 2))
        } else if byte == 95 {
            canvas_module.fillRect(canvas, cx - cell, y + height - 2, 2 * cell, 2, color)
        }
        at += 1
    }
}

// A graph line's parts: the graph, and for a commit its hash, its refs
// (branches, tags) and subject (tab apart).
pub fn graphPart(line: []const u8, part: usize) -> []const u8 {
    var start: usize = 0
    var index: usize = 0
    var at: usize = 0
    while at <= line.length {
        if at == line.length || line[at] == 9 {
            if index == part {
                var end = at
                // The graph without its blanks at the end.
                if part == 0 {
                    while end > start && line[end - 1] == 32 { end -= 1 }
                }
                return line[start..end]
            }
            index += 1
            start = at + 1
        }
        at += 1
    }
    return line[0..0]
}

// ---------------------------------------------------------------------------
// Building and committing

// The program Build builds: the one whose main file the editor shows,
// else the one chosen under Program (the count: none).
fn buildTarget(codemap: *app.Codemap) -> usize {
    const programs = access_module.programsOf(codemap)
    if !codemap.*.built { return programs.*.count }
    if codemap.*.view == app.VIEW_EDITOR && tabs_module.hasTab(codemap) {
        const tab = codemap.*.activeTab
        const program = programs_module.programOfPath(programs, tabs_module.tabRelative(codemap, tab))
        if program < programs.*.count { return program }
        if access_module.programChosen(codemap) { return codemap.*.program }
        // A file of no program's own: the first program that reaches the
        // declaration at the cursor, else one in the file.
        const editor = tabs_module.activeEditor(codemap)
        const symbol = tabs_module.declarationOnLine(codemap, tab, editor_module.lineOf(editor, editor.*.cursor))
        const spans = tabs_module.spansOf(codemap, tab)
        var span: usize = 0
        while span <= codemap.*.tabSpanCount[tab] {
            const which = if span == 0 { symbol } else { spans[(span - 1) * 4 + 3] }
            if which != app.NONE {
                var reaching: usize = 0
                while reaching < programs.*.count {
                    if programs_module.reaches(programs, reaching, which) { return reaching }
                    reaching += 1
                }
            }
            span += 1
        }
    }
    return if access_module.programChosen(codemap) { codemap.*.program } else { programs.*.count }
}

// Build: the program into ROOT/mlx-out/bin/NAME (its /s as -), in the
// background; its problems go on the lines like a check's.
pub fn startBuild(codemap: *app.Codemap) -> void {
    const build = access_module.buildOf(codemap)
    if build.*.running { return }
    const programs = access_module.programsOf(codemap)
    const program = buildTarget(codemap)
    if program >= programs.*.count {
        access_module.setNote(codemap, access_module.say(codemap, "Build: no program reaches this; choose one under Program", "Bauen: kein Programm erreicht das; wähle eins unter Programm"), "")
        return
    }
    // Edited tabs are saved first.
    saveAllTabs(codemap)
    const name = programs_module.nameOf(programs, program)
    codemap.*.buildNameLength = 0
    for byte in name {
        if codemap.*.buildNameLength < 120 {
            codemap.*.buildName[codemap.*.buildNameLength] = if byte == 47 { 45 } else { byte }
            codemap.*.buildNameLength += 1
        }
    }
    var target: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &target) }
    var length = filters_module.writeText(bytes, 0, access_module.rootText(codemap))
    length = filters_module.writeText(bytes, length, "/mlx-out")
    bytes[length] = 0
    const made_out = std.linux.syscall2(83, @intFromPtr(bytes), 493)
    length = filters_module.writeText(bytes, length, "/bin")
    bytes[length] = 0
    const made_bin = std.linux.syscall2(83, @intFromPtr(bytes), 493)
    length = filters_module.writeText(bytes, length, "/")
    length = filters_module.writeText(bytes, length, access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "buildName"))[0..codemap.*.buildNameLength])
    const source = index_module.pathOf(codemap.*.index, programs.*.file[program])
    if !check_module.requestBuild(build, source, bytes[0..length], panel_module.milliseconds()) {
        if check_module.compilerPath(build).length == 0 {
            access_module.setNote(codemap, access_module.say(codemap, "Build: no compiler found (MLX_COMPILER, mlx-out/bin/compiler/mlx4 or mlx4)", "Bauen: kein Compiler gefunden (MLX_COMPILER, mlx-out/bin/compiler/mlx4 oder mlx4)"), "")
        } else {
            access_module.setNote(codemap, access_module.say(codemap, "Build: the compiler did not start: ", "Bauen: der Compiler startete nicht: "), check_module.compilerPath(build))
        }
        return
    }
    codemap.*.buildStarted = panel_module.milliseconds()
    if codemap.*.trace { navigation_module.traceLine(codemap, "build ", access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "buildName"))[0..codemap.*.buildNameLength]) }
    access_module.panelOf(codemap).*.dirty = true
}

// The tabs with edits not saved.
pub fn unsavedTabs(codemap: *app.Codemap) -> usize {
    var count: usize = 0
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        if editor_module.isDirty(access_module.editorAt(codemap, tab)) { count += 1 }
        tab += 1
    }
    return count
}

fn saveAllTabs(codemap: *app.Codemap) -> void {
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = access_module.editorAt(codemap, tab)
        if editor_module.isDirty(editor) && editor_module.save(editor) {
            codemap.*.stale = true
            codemap.*.tabStamp[tab] = tabs_module.fileStamp(editor_module.pathOf(editor))
        }
        tab += 1
    }
}

// The build ended: the new program's machine code into the map, or its
// first error in the editor.
pub fn finishBuild(codemap: *app.Codemap) -> void {
    const build = access_module.buildOf(codemap)
    const name = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "buildName"))[0..codemap.*.buildNameLength]
    var errors: usize = 0
    var first: usize = build.*.count
    var at: usize = 0
    while at < build.*.count {
        if check_module.diagnosticAt(build, at).*.isError {
            if errors == 0 { first = at }
            errors += 1
        }
        at += 1
    }
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length: usize = 0
    if build.*.status == 0 && errors == 0 {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Built ", "Gebaut: "))
        length = filters_module.writeText(bytes, length, name)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " in ", " in "))
        const tenths = (panel_module.milliseconds() - codemap.*.buildStarted) / 100
        length = lists_module.writeNumberPlain(bytes, length, tenths / 10)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, ".", ","))
        length = lists_module.writeNumberPlain(bytes, length, tenths % 10)
        length = filters_module.writeText(bytes, length, " s: mlx-out/bin/")
        length = filters_module.writeText(bytes, length, name)
        rescanBinaries(codemap)
    } else {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Build of ", "Bauen von "))
        length = filters_module.writeText(bytes, length, name)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " failed: ", " fehlgeschlagen: "))
        length = filters_module.writeNumber(codemap, bytes, length, errors)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " errors", " Fehler"))
        // The first error, in the editor.
        if first < build.*.count {
            const diagnostic = check_module.diagnosticAt(build, first)
            const output = check_module.outputText(build)
            const where = output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength]
            var path: [1200]u8 = undefined
            var path_bytes: [*]u8 = undefined
            unsafe { path_bytes = @ptrCast([*]u8, &path) }
            var path_length: usize = 0
            if where.length > 0 && where[0] != 47 {
                path_length = filters_module.writeText(path_bytes, 0, access_module.rootText(codemap))
                path_length = filters_module.writeText(path_bytes, path_length, "/")
            }
            path_length = filters_module.writeText(path_bytes, path_length, where)
            const opened = tabs_module.openFile(codemap, path_bytes[0..path_length], diagnostic.*.line, diagnostic.*.column)
        }
    }
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        tabs_module.computeMarks(codemap, tab)
        tab += 1
    }
    access_module.setNote(codemap, bytes[0..length], "")
    if codemap.*.trace { navigation_module.traceLine(codemap, "build done: ", bytes[0..length]) }
    access_module.panelOf(codemap).*.dirty = true
    // Run or Profile waited for it.
    const after = codemap.*.afterBuild
    codemap.*.afterBuild = app.ACTION_NONE
    if after != app.ACTION_NONE && build.*.status == 0 && errors == 0 { actions_module.launch(codemap, after) }
}

// The binaries again (after a build): the machine code of each function.
fn rescanBinaries(codemap: *app.Codemap) -> void {
    var directories: [8192]u8 = undefined
    var directory_bytes: [*]u8 = undefined
    unsafe { directory_bytes = @ptrCast([*]u8, &directories) }
    const length = binaries_module.defaultDirectories(access_module.rootText(codemap), codemap.*.environment, directory_bytes)
    binaries_module.scan(access_module.binariesOf(codemap), codemap.*.index, access_module.programsOf(codemap), directory_bytes[0..length])
    access_module.chooseBinary(codemap)
    access_module.computeMetric(codemap)
    filters_module.refreshFindings(codemap)
}

// The files Git names as changed (git status --porcelain).
pub fn refreshChanges(codemap: *app.Codemap) -> void {
    codemap.*.changeCount = 0
    codemap.*.changesLength = 0
    const git = access_module.gitOf(codemap)
    if !codemap.*.built || !git_module.usable(git) { return }
    const text = git_module.run(git, "status --porcelain")
    for byte in text {
        if codemap.*.changesLength < 4096 {
            codemap.*.changes[codemap.*.changesLength] = byte
            codemap.*.changesLength += 1
        }
        if byte == 10 { codemap.*.changeCount += 1 }
    }
}

// Commit (and push): the message, all changes (edited tabs saved first),
// in the background.
pub fn startCommit(codemap: *app.Codemap, push: bool) -> void {
    if codemap.*.job != app.JOB_NONE { return }
    const message = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "commitMessage"))[0..codemap.*.commitLength]
    if message.length == 0 {
        access_module.setNote(codemap, access_module.say(codemap, "Commit: write a message first", "Commit: erst eine Nachricht schreiben"), "")
        return
    }
    saveAllTabs(codemap)
    const git = access_module.gitOf(codemap)
    const log_length = jobLogPath(codemap)
    if log_length == 0 { return }
    const log = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "jobLog"))[0..log_length]
    const root = access_module.rootText(codemap)
    git_module.beginShell(git)
    git_module.more(git, "{ ( git -C ")
    git_module.addQuoted(git, root)
    git_module.more(git, " add -A && git -C ")
    git_module.addQuoted(git, root)
    git_module.more(git, " commit -q -m ")
    git_module.addQuoted(git, message)
    if push {
        git_module.more(git, " && git -C ")
        git_module.addQuoted(git, root)
        git_module.more(git, " push -q -u origin HEAD")
    }
    git_module.more(git, " ) > ")
    git_module.addQuoted(git, log)
    git_module.more(git, " 2>&1; echo \"exit $?\" >> ")
    git_module.addQuoted(git, log)
    git_module.more(git, "; }")
    codemap.*.jobProcess = git_module.spawn(git)
    if codemap.*.jobProcess <= 0 { return }
    codemap.*.job = if push { app.JOB_PUSH } else { app.JOB_COMMIT }
    codemap.*.popup = app.POPUP_NONE
    if codemap.*.trace { navigation_module.traceLine(codemap, if push { "commit and push: " } else { "commit: " }, message) }
    access_module.setNote(codemap, if push { access_module.say(codemap, "Committing and pushing ...", "Commit und Push laufen ...") } else { access_module.say(codemap, "Committing ...", "Commit läuft ...") }, "")
}

// $XDG_CACHE_HOME/mlx/codemap/observatory-job.log; its length (0: none).
fn jobLogPath(codemap: *app.Codemap) -> usize {
    const into = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "jobLog"))
    var length = history_module.cacheDirectoryOf(codemap.*.environment, into)
    if length == 0 { return 0 }
    length = filters_module.writeText(into, length, "/observatory-job.log")
    into[length] = 0
    codemap.*.jobLogLength = length
    return length
}

// The commit (and push) ended: what Git said, the changes again.
pub fn finishJob(codemap: *app.Codemap) -> void {
    const push = codemap.*.job == app.JOB_PUSH
    codemap.*.job = app.JOB_NONE
    var text: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length: usize = 0
    const file = std.fs.open(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "jobLog")), 0, 0)
    if std.fs.isValid(file) {
        const got = std.fs.read(file, bytes, 4000)
        if got > 0 { length = @intCast(usize, got) }
        const closed = std.fs.close(file)
    }
    const output = bytes[0..length]
    // "exit N" on the last line.
    var end = length
    while end > 0 && (output[end - 1] == 10 || output[end - 1] == 32) { end -= 1 }
    var start = end
    while start > 0 && output[start - 1] != 10 { start -= 1 }
    const status_line = output[start..end]
    const ok = status_line.length == 6 && access_module.sameBytes(status_line, "exit 0")
    const message = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "commitMessage"))[0..codemap.*.commitLength]
    if ok {
        access_module.setNote(codemap, if push { access_module.say(codemap, "Committed and pushed: ", "Committet und gepusht: ") } else { access_module.say(codemap, "Committed: ", "Committet: ") }, message)
        codemap.*.commitLength = 0
    } else {
        // What Git said: its last "fatal:" or "error:" line, else its first.
        var said_start: usize = 0
        var said_end: usize = 0
        var line_start: usize = 0
        while line_start < start {
            var line_end = line_start
            while line_end < start && output[line_end] != 10 { line_end += 1 }
            const line = output[line_start..line_end]
            const telling = (line.length > 6 && access_module.sameBytes(line[0..6], "fatal:")) || (line.length > 6 && access_module.sameBytes(line[0..6], "error:"))
            if telling || (said_end == 0 && line.length > 0) {
                said_start = line_start
                said_end = line_end
            }
            line_start = line_end + 1
        }
        if said_end > said_start + 120 { said_end = said_start + 120 }
        access_module.setNote(codemap, if push { access_module.say(codemap, "Commit or push failed: ", "Commit oder Push fehlgeschlagen: ") } else { access_module.say(codemap, "Commit failed: ", "Commit fehlgeschlagen: ") }, output[said_start..said_end])
    }
    if codemap.*.trace { navigation_module.traceLine(codemap, "commit done: ", status_line) }
    refreshChanges(codemap)
    access_module.runDiff(codemap)
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        tabs_module.computeMarks(codemap, tab)
        tab += 1
    }
    filters_module.refreshFindings(codemap)
    access_module.panelOf(codemap).*.dirty = true
}

// The history's top: the changed files, the message, Commit and Commit
// and push (nothing changed: a line that says so).
pub fn commitSectionHeight(codemap: *app.Codemap) -> i32 {
    if codemap.*.changeCount == 0 { return 40 }
    const files_shown = if codemap.*.changeCount > 8 { 8 } else { codemap.*.changeCount }
    return 44 + @intCast(i32, files_shown) * 20 + (if codemap.*.changeCount > 8 { 20 } else { 0 }) + 92
}

pub fn drawCommitSection(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> void {
    if codemap.*.changeCount == 0 {
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), access_module.say(codemap, "Nothing to commit", "Nichts zu committen"), x + 16, top + 14, app.DIM_COLOR, width - 32)
        return
    }
    const files_shown = if codemap.*.changeCount > 8 { 8 } else { codemap.*.changeCount }
    var text: [128]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeNumber(codemap, bytes, 0, codemap.*.changeCount)
    length = filters_module.writeText(bytes, length, if codemap.*.changeCount == 1 { access_module.say(codemap, " changed file", " geänderte Datei") } else { access_module.say(codemap, " changed files", " geänderte Dateien") })
    var y = top + 14
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), bytes[0..length], x + 16, y, app.TEXT_COLOR, width - 32)
    y += 26
    // The files: Git's two letters and the path.
    const changes = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "changes"))[0..codemap.*.changesLength]
    var at: usize = 0
    var shown: usize = 0
    while at < changes.length && shown < files_shown {
        var end = at
        while end < changes.length && changes[end] != 10 { end += 1 }
        const line = changes[at..end]
        if line.length > 3 {
            const state = line[0..2]
            const color = if state[0] == 63 || state[1] == 65 || state[0] == 65 { app.CHANGED_COLOR } else if state[0] == 68 || state[1] == 68 { app.ERROR_COLOR } else { app.TYPE_COLOR }
            canvas_module.drawText(canvas, access_module.monoOf(codemap), state, x + 16, y, filters_module.canvasColor(color, 255), 0)
            canvas_module.drawText(canvas, access_module.smallOf(codemap), line[3..line.length], x + 44, y + 1, app.TEXT_COLOR, width - 60)
        }
        y += 20
        shown += 1
        at = end + 1
    }
    if codemap.*.changeCount > 8 {
        length = filters_module.writeText(bytes, 0, "+ ")
        length = filters_module.writeNumber(codemap, bytes, length, codemap.*.changeCount - 8)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
        canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 44, y + 1, app.DIM_COLOR, 0)
        y += 20
    }
    // The message.
    y += 6
    codemap.*.commitFieldY = y
    canvas_module.fillRoundedRect(canvas, x + 12, y, width - 24, 30, 7, canvas_module.color(255, 22, 24, 30))
    canvas_module.strokeRoundedRect(canvas, x + 11, y - 1, width - 22, 32, 8, 2, app.ACCENT)
    const message = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "commitMessage"))[0..codemap.*.commitLength]
    if message.length == 0 {
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), access_module.say(codemap, "Commit message", "Commit-Nachricht"), x + 22, y + 7, app.DIM_COLOR, width - 44)
    } else {
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), message, x + 22, y + 7, app.TEXT_COLOR, width - 44)
    }
    const caret = x + 22 + canvas_module.measure(access_module.bodyOf(codemap), message)
    if caret < x + width - 20 { canvas_module.fillRect(canvas, caret + 1, y + 7, 2, 16, app.ACCENT) }
    y += 42
    // The buttons.
    codemap.*.commitButtonsY = y
    const commit_label = access_module.say(codemap, "Commit", "Commit")
    const push_label = access_module.say(codemap, "Commit and push", "Commit und Push")
    const commit_width = canvas_module.measure(access_module.bodyOf(codemap), commit_label) + 28
    const push_width = canvas_module.measure(access_module.bodyOf(codemap), push_label) + 28
    codemap.*.pushButtonX = x + width - 12 - push_width
    codemap.*.commitButtonX = codemap.*.pushButtonX - 8 - commit_width
    const enabled = message.length > 0 && codemap.*.changeCount > 0
    canvas_module.fillRoundedRect(canvas, codemap.*.commitButtonX, y, commit_width, 30, 8, if codemap.*.hover == app.HIT_COMMIT_DO && enabled { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), commit_label, codemap.*.commitButtonX + 14, y + 7, if enabled { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
    canvas_module.fillRoundedRect(canvas, codemap.*.pushButtonX, y, push_width, 30, 8, if !enabled { canvas_module.color(255, 52, 56, 68) } else if codemap.*.hover == app.HIT_COMMIT_PUSH { canvas_module.color(255, 70, 110, 190) } else { canvas_module.color(255, 52, 88, 160) })
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), push_label, codemap.*.pushButtonX + 14, y + 7, if enabled { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
    canvas_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "Enter: commit", "Enter: Commit"), x + 16, y + 8, app.DIM_COLOR, codemap.*.commitButtonX - x - 24)
}

// Typing into the commit message (the list open); true when it took the
// key.
pub fn commitKey(codemap: *app.Codemap, key: u32) -> bool {
    if key == app.KEY_ESCAPE {
        codemap.*.popup = app.POPUP_NONE
        return true
    }
    if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        startCommit(codemap, access_module.modifiers(codemap) & app.CONTROL != 0)
        return true
    }
    if key == app.KEY_BACKSPACE {
        if codemap.*.commitLength > 0 { codemap.*.commitLength -= 1 }
        while codemap.*.commitLength > 0 && codemap.*.commitMessage[codemap.*.commitLength] >= 128 && codemap.*.commitMessage[codemap.*.commitLength] < 192 { codemap.*.commitLength -= 1 }
        return true
    }
    const panel = access_module.panelOf(codemap)
    if panel.*.textLength == 0 || panel.*.text[0] < 32 || access_module.modifiers(codemap) & (app.CONTROL | app.ALT) != 0 { return false }
    var at: usize = 0
    while at < panel.*.textLength && codemap.*.commitLength < 500 {
        codemap.*.commitMessage[codemap.*.commitLength] = panel.*.text[at]
        codemap.*.commitLength += 1
        at += 1
    }
    return true
}

fn buildLabel(codemap: *app.Codemap) -> []const u8 {
    if access_module.buildOf(codemap).*.running { return access_module.say(codemap, "Building ...", "Baut ...") }
    if actions_module.runOf(codemap).*.running { return if actions_module.runOf(codemap).*.profiled { access_module.say(codemap, "Profiling", "Profiliert") } else { access_module.say(codemap, "Running", "Läuft") } }
    return actionLabel(codemap, codemap.*.runAction)
}

fn actionLabel(codemap: *app.Codemap, action: u8) -> []const u8 {
    if action == app.ACTION_RUN { return access_module.say(codemap, "Run", "Starten") }
    if action == app.ACTION_PROFILE { return access_module.say(codemap, "Profile", "Profilieren") }
    return access_module.say(codemap, "Build", "Bauen")
}

// The arrow at the Build button's right opens its list.
pub const BUILD_ARROW: i32 = 24

pub fn buildWidth(codemap: *app.Codemap) -> i32 { return canvas_module.measure(access_module.bodyOf(codemap), buildLabel(codemap)) + 36 + BUILD_ARROW }
pub fn buildX(codemap: *app.Codemap) -> i32 { return input_module.baseX(codemap) - 8 - buildWidth(codemap) }

// The toolbar's Build (a triangle, the program).
pub fn drawBuild(codemap: *app.Codemap, canvas: *app.Canvas, top: i32) -> void {
    const build_x = buildX(codemap)
    const building = access_module.buildOf(codemap).*.running
    const running = actions_module.runOf(codemap).*.running
    const lit = codemap.*.hover == app.HIT_BUILD
    const width = buildWidth(codemap)
    canvas_module.fillRoundedRect(canvas, build_x, top, width, app.BUTTON, 8, if building || running { canvas_module.color(255, 60, 70, 60) } else { canvas_module.color(255, 52, 56, 68) })
    if lit { canvas_module.fillRoundedRect(canvas, build_x, top, width - BUILD_ARROW, app.BUTTON, 8, canvas_module.color(255, 72, 76, 92)) }
    if codemap.*.hover == app.HIT_BUILD_MENU || codemap.*.popup == app.POPUP_RUN { canvas_module.fillRoundedRect(canvas, build_x + width - BUILD_ARROW, top, BUILD_ARROW, app.BUTTON, 8, canvas_module.color(255, 72, 76, 92)) }
    if running {
        // Stop: a square.
        canvas_module.fillRect(canvas, build_x + 11, top + 10, 9, 9, filters_module.canvasColor(app.CRASH_COLOR, 255))
    } else {
        drawPlay(canvas, build_x + 12, top + 9, codemap.*.runAction)
    }
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), buildLabel(codemap), build_x + 26, top + 7, app.TEXT_COLOR, 0)
    canvas_module.fillRect(canvas, build_x + width - BUILD_ARROW, top + 6, 1, app.BUTTON - 12, canvas_module.color(255, 76, 80, 96))
    drawing_module.drawArrow(canvas, build_x + width - BUILD_ARROW + 8, top + 9, true, app.DIM_COLOR)
}

// Build's triangle; Run's is filled green, Profile's has the heat's color.
pub fn drawPlay(canvas: *app.Canvas, x: i32, y: i32, action: u8) -> void {
    const color = if action == app.ACTION_RUN { filters_module.canvasColor(app.CHANGED_COLOR, 255) } else if action == app.ACTION_PROFILE { filters_module.canvasColor(app.HOT_COLOR, 255) } else { filters_module.canvasColor(app.STRING_COLOR, 255) }
    var step: i32 = 0
    while step < 6 {
        canvas_module.fillRect(canvas, x + step, y + step, 1, 12 - 2 * step, color)
        step += 1
    }
}
