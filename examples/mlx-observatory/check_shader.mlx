// Builds the 3D view's shader and validates it with std.spirv.module; with a
// directory, writes it there as scene.spv (for spirv-val).
//
//     mlx4 examples/mlx-observatory/check_shader.mlx -o check-codemap-shader
//     ./check-codemap-shader [DIRECTORY]      exits 0 when it is valid
const std = @import("std")
const module = @import("std.spirv.module")
const scene_shader = @import("./scene_shader.mlx")

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stderr(), text) }

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var words: [*]u32 = undefined
    const count = scene_shader.words(allocator, &words)
    if count == 0 { return 1 }
    var diagnostic: module.Diagnostic = undefined
    const result = module.validate(words, count, allocator, &diagnostic)
    if result != module.Error.none {
        say("scene.spv: ")
        say(module.errorMessage(result))
        say("\n")
        return 1
    }
    if std.process.count(arguments) < 2 { return 0 }
    const directory = std.process.argument(arguments, 1)
    var path: [512]u8 = undefined
    var length: usize = 0
    var index: usize = 0
    while index < directory.length && length < 400 {
        path[length] = directory.pointer[index]
        length += 1
        index += 1
    }
    for byte in "/scene.spv" {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    var file = std.fs.open(@ptrFromInt([*]const u8, 0), 0, 0)
    unsafe { file = std.fs.open(@ptrCast([*]const u8, &path), 577, 420) }
    if !std.fs.isValid(file) { return 1 }
    var written = false
    unsafe { written = std.fs.writeAllBytes(file, @ptrCast([*]const u8, words), count * 4) }
    const closed = std.fs.close(file)
    return if written { 0 } else { 1 }
}
