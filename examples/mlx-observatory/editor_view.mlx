// Drawing the editor: its lines, the lens rows, the references list (part of main.mlx, split from it).
const canvas_module = @import("../desktop-shared/canvas.mlx")
const crash = @import("../wayland-compositor/crash.mlx")
const index_module = @import("../../tools/codemap/index.mlx")
const analysis_module = @import("../../tools/codemap/analysis.mlx")
const crashes_module = @import("../../tools/codemap/crashes.mlx")
const workarounds_module = @import("../../tools/codemap/workarounds.mlx")
const programs_module = @import("../../tools/codemap/programs.mlx")
const binaries_module = @import("../../tools/codemap/binaries.mlx")
const complexity_module = @import("../../tools/codemap/complexity.mlx")
const history_module = @import("../../tools/codemap/history.mlx")
const profiles_module = @import("../../tools/codemap/profiles.mlx")
const measures_module = @import("../../tools/codemap/measures.mlx")
const diff_module = @import("../../tools/codemap/diff.mlx")
const rewrite_module = @import("../../tools/codemap/rewrite.mlx")
const check_module = @import("../../tools/mlx-lsp/check.mlx")
const editor_module = @import("./editor.mlx")
const m = @import("./math3d.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const lists_module = @import("./lists.mlx")
const drawing_module = @import("./drawing.mlx")
const detail_module = @import("./detail.mlx")
const tabs_module = @import("./tabs.mlx")
const assist_module = @import("./assist.mlx")
const actions_module = @import("./actions.mlx")

// ---------------------------------------------------------------------------
// Drawing the editor

pub fn editorRight(codemap: *app.Codemap) -> i32 { return if access_module.detailOpen(codemap) { filters_module.detailX(codemap) } else { access_module.surfaceWidth(codemap) } }
pub fn editorCodeTop() -> i32 { return app.TOOLBAR + app.TAB_BAR }
pub fn editorBottom(codemap: *app.Codemap) -> i32 { return access_module.surfaceHeight(codemap) - app.STATUS }

pub fn editorRows(codemap: *app.Codemap) -> usize {
    const rows = (editorBottom(codemap) - editorCodeTop()) / app.EDITOR_LINE
    return if rows > 0 { @intCast(usize, rows) } else { 1 }
}

pub fn tokenColor(kind: u8) -> u32 {
    if kind == editor_module.KEYWORD { return app.KEYWORD_COLOR }
    if kind == editor_module.TYPE { return app.TYPE_COLOR }
    if kind == editor_module.BUILTIN { return app.BUILTIN_COLOR }
    if kind == editor_module.STRING { return app.STRING_COLOR }
    if kind == editor_module.NUMBER { return app.NUMBER_COLOR }
    if kind == editor_module.COMMENT { return app.COMMENT_COLOR }
    if kind == editor_module.DOC { return app.DOC_COLOR }
    if kind == editor_module.CALL { return app.CALL_COLOR }
    if kind == editor_module.PUNCTUATION { return app.PUNCTUATION_COLOR }
    if kind == editor_module.CONSTANT { return app.CONSTANT_COLOR }
    return app.TEXT_COLOR
}

fn digitsOf(value: usize) -> i32 {
    var digits: i32 = 1
    var rest = value
    while rest >= 10 {
        rest /= 10
        digits += 1
    }
    return digits
}

// Where the text starts (after the gutter).
fn gutterWidth(codemap: *app.Codemap) -> i32 {
    const lines = if tabs_module.hasTab(codemap) { tabs_module.activeEditor(codemap).*.lineCount } else { 1 }
    var digits = digitsOf(lines)
    if digits < 3 { digits = 3 }
    return 16 + digits * codemap.*.charWidth + 20
}

pub fn drawEditor(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const left = app.SIDEBAR
    const right = editorRight(codemap)
    const bottom = editorBottom(codemap)
    canvas_module.fillRect(canvas, left, app.TOOLBAR, right - left, bottom - app.TOOLBAR, app.EDITOR_BACKGROUND)
    drawing_module.drawTabs(codemap, canvas, left, right)
    if !tabs_module.hasTab(codemap) {
        const hint = access_module.say(codemap, "No file open: \"Open in editor\" in the panel, Ctrl+O, a search result or a click on a file opens one.", "Keine Datei offen: \"Im Editor öffnen\" im Panel, Strg+O, ein Suchergebnis oder ein Klick auf eine Datei öffnet eine.")
        const drawn = detail_module.drawWrapped(codemap, canvas, hint, access_module.bodyOf(codemap), left + 40, app.TOOLBAR + app.TAB_BAR + 40, right - left - 80, app.DIM_COLOR, 4, 20)
        return
    }
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    const mono = access_module.monoOf(codemap)
    const cw = codemap.*.charWidth
    const gutter = gutterWidth(codemap)
    const text_x = left + gutter
    codemap.*.editorLeft = text_x
    const top = editorCodeTop()
    const rows = editorRows(codemap)
    if editor.*.top >= editor.*.lineCount { editor.*.top = if editor.*.lineCount > 0 { editor.*.lineCount - 1 } else { 0 } }
    canvas_module.fillRect(canvas, left, top, gutter - 8, bottom - top, app.GUTTER_BACKGROUND)
    const marks = tabs_module.marksOf(codemap, tab)
    const heat = tabs_module.heatOf(codemap, tab)
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    const select_start = editor_module.selectionStart(editor)
    const select_end = editor_module.selectionEnd(editor)
    const checked_now = codemap.*.tabChecked[tab] == editor.*.version
    // The index's offsets fit the text: names by what they are, and the
    // name at the cursor with its uses.
    const indexed_now = tabs_module.tabIndexedNow(codemap, tab) && codemap.*.built
    const cursor_ref = if indexed_now { index_module.refAtOffset(codemap.*.index, codemap.*.tabFile[tab], editor.*.cursor) } else { index_module.MAX_REFS }
    const cursor_symbol = if cursor_ref != index_module.MAX_REFS { index_module.refAt(codemap.*.index, cursor_ref).*.symbol } else { app.NONE }
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    codemap.*.chipCount = 0
    // A line hidden in a fold is not the top; the cursor's line is shown.
    editor.*.top = assist_module.shownLine(codemap, tab, editor.*.top)
    if assist_module.hiddenIn(codemap, tab, cursor_line) != 18446744073709551615 { assist_module.unfoldAtCursor(codemap) }
    var row_y = top
    var line = editor.*.top
    while line < editor.*.lineCount && row_y + app.EDITOR_LINE <= bottom {
        // A lens row above a function or a type: what the map knows of it.
        if hasLensRow(codemap, tab, line) {
            const symbol = lensSymbolAt(codemap, tab, line)
            if symbol != app.NONE {
                buildLens(codemap, symbol)
                const indent = editor_module.columnsBetween(editor, editor_module.lineStart(editor, line), editor_module.lineStart(editor, line) + indentOf(editor_module.lineText(editor, line)))
                const drawn = drawChips(codemap, canvas, text_x + @intCast(i32, indent) * cw, row_y, right - 12, 190)
            }
            row_y += app.EDITOR_LINE
            if row_y + app.EDITOR_LINE > bottom { break }
        }
        const y = row_y
        const start = editor_module.lineStart(editor, line)
        const end = editor_module.lineEnd(editor, line)
        const mark = if line < codemap.*.tabMarkLines[tab] { marks[line] } else { 0 }
        if line == cursor_line { canvas_module.fillRect(canvas, text_x - 6, y, right - text_x + 6, app.EDITOR_LINE, app.LINE_HIGHLIGHT) }
        // The selection on this line.
        if select_start != select_end && select_start <= end && select_end >= start && !(select_end == start && line > 0 && select_start < start && false) {
            const from = if select_start > start { select_start } else { start }
            const to = if select_end < end { select_end } else { end }
            const x0 = text_x + @intCast(i32, editor_module.columnsBetween(editor, start, from)) * cw
            var x1 = text_x + @intCast(i32, editor_module.columnsBetween(editor, start, to)) * cw
            if select_end > end { x1 += cw / 2 }
            if x1 > x0 { canvas_module.fillRect(canvas, x0, y, x1 - x0, app.EDITOR_LINE, app.SELECTION_COLOR) }
        }
        // The gutter: changes (a bar), crash and workaround (dots), a
        // problem (a dot), heat (a bar by the numbers), the number.
        if mark & app.MARK_ADDED != 0 { canvas_module.fillRect(canvas, left + 2, y + 1, 3, app.EDITOR_LINE - 2, filters_module.canvasColor(app.CHANGED_COLOR, 255)) }
        if mark & app.MARK_CHANGED != 0 { canvas_module.fillRect(canvas, left + 2, y + 1, 3, app.EDITOR_LINE - 2, filters_module.canvasColor(app.TYPE_COLOR, 255)) }
        if mark & app.MARK_REMOVED != 0 { canvas_module.fillRect(canvas, left + 1, y + app.EDITOR_LINE - 2, 6, 3, filters_module.canvasColor(app.ERROR_COLOR, 220)) }
        if mark & (app.MARK_ERROR | app.MARK_WARNING) != 0 {
            drawing_module.drawDot(canvas, left + 8, y + 5, 8, filters_module.canvasColor(if mark & app.MARK_ERROR != 0 { app.ERROR_COLOR } else { app.WARNING_COLOR }, 255))
        } else if mark & app.MARK_CRASH != 0 {
            drawing_module.drawDot(canvas, left + 8, y + 5, 8, filters_module.canvasColor(app.CRASH_COLOR, 255))
        } else if mark & app.MARK_WORKAROUND != 0 {
            drawing_module.drawDot(canvas, left + 9, y + 6, 6, filters_module.canvasColor(app.WORKAROUND_COLOR, 230))
        }
        const heat_value = if line < codemap.*.tabMarkLines[tab] { heat[line] } else { 0 }
        if heat_value > 0 { canvas_module.fillRect(canvas, text_x - 14, y, 3, app.EDITOR_LINE, filters_module.canvasColor(access_module.heatColor(m.toFloat(@intCast(i64, heat_value)) / 255.0), 255)) }
        const number_length = lists_module.writeNumberPlain(digit_bytes, 0, line + 1)
        const number_x = text_x - 18 - @intCast(i32, number_length) * cw
        canvas_module.drawText(canvas, mono, digit_bytes[0..number_length], number_x, y + 2, if line == cursor_line { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
        // A block opens here: a chevron to fold it (folded: pointing right).
        const folded_end = assist_module.foldEndAt(codemap, tab, line)
        if folded_end != 18446744073709551615 {
            drawing_module.drawArrow(canvas, text_x - 12, y + 3, false, app.TEXT_COLOR)
        } else if codemap.*.pointerX < text_x && codemap.*.pointerX >= app.SIDEBAR && assist_module.braceDepth(editor_module.lineText(editor, line)) > 0 {
            drawing_module.drawArrow(canvas, text_x - 13, y + 3, true, app.DIM_COLOR)
        }
        // The text, token by token; a name in the colors of what it is
        // (the index knows), the uses of the name at the cursor lit.
        const text = editor.*.text[start..end]
        var x = text_x
        var at: usize = 0
        while at < text.length && x < right - 4 {
            var kind: u8 = 0
            const token_end = editor_module.token(text, at, &kind)
            const piece = text[at..token_end]
            const columns = @intCast(i32, editor_module.columnsBetween(editor, start + at, start + token_end))
            var color = tokenColor(kind)
            if indexed_now && isNameStart(piece[0]) && (kind == editor_module.PLAIN || kind == editor_module.CALL || kind == editor_module.TYPE || kind == editor_module.CONSTANT) {
                const ref = index_module.refAtOffset(codemap.*.index, codemap.*.tabFile[tab], start + at)
                if ref != index_module.MAX_REFS {
                    const value = index_module.refAt(codemap.*.index, ref)
                    if @intCast(usize, value.*.start) == start + at {
                        color = semanticColor(codemap, value.*.symbol, color)
                        if value.*.symbol == cursor_symbol && cursor_symbol != app.NONE {
                            const written = value.*.use == index_module.USE_WRITE || value.*.use == index_module.USE_DECLARATION
                            canvas_module.fillRoundedRect(canvas, x - 1, y + 1, columns * cw + 2, app.EDITOR_LINE - 2, 3, if written { canvas_module.color(255, 78, 64, 56) } else { canvas_module.color(255, 52, 60, 80) })
                        }
                    }
                }
            }
            if piece[0] != 32 { canvas_module.drawText(canvas, mono, piece, x, y + 2, filters_module.canvasColor(color, 255), right - 4 - x) }
            x += columns * cw
            at = token_end
        }
        // The compiler's problem on it, after the text; and what the map
        // knows of a function named on it.
        var after = x + 3 * cw
        if mark & (app.MARK_ERROR | app.MARK_WARNING) != 0 && checked_now {
            after = drawProblemAfter(codemap, canvas, line, after, y, right, text_x, x)
        }
        // Folded: what is hidden, as a chip that opens it.
        if folded_end != 18446744073709551615 && x < right - 80 {
            var hidden: [48]u8 = undefined
            var hidden_bytes: [*]u8 = undefined
            unsafe { hidden_bytes = @ptrCast([*]u8, &hidden) }
            var hidden_length = filters_module.writeText(hidden_bytes, 0, " … ")
            hidden_length = lists_module.writeNumberPlain(hidden_bytes, hidden_length, folded_end - line)
            hidden_length = filters_module.writeText(hidden_bytes, hidden_length, access_module.say(codemap, " lines } ", " Zeilen } "))
            const chip_width = canvas_module.measure(access_module.smallOf(codemap), hidden_bytes[0..hidden_length]) + 8
            const chip_x = x + cw
            const slot = codemap.*.chipCount
            const lit = codemap.*.hover == app.HIT_CHIP + slot
            canvas_module.fillRoundedRect(canvas, chip_x, y + 2, chip_width, app.EDITOR_LINE - 4, 5, if lit { canvas_module.color(255, 70, 76, 96) } else { canvas_module.color(255, 48, 52, 66) })
            canvas_module.drawText(canvas, access_module.smallOf(codemap), hidden_bytes[0..hidden_length], chip_x + 4, y + 2, app.DIM_COLOR, 0)
            if slot < app.MAX_CHIPS {
                codemap.*.chipX0[slot] = chip_x
                codemap.*.chipX1[slot] = chip_x + chip_width
                codemap.*.chipY[slot] = y
                codemap.*.chipKind[slot] = app.CHIP_UNFOLD
                codemap.*.chipTarget[slot] = @intCast(u32, line)
                codemap.*.chipCount = slot + 1
            }
            after = chip_x + chip_width + 3 * cw
        }
        // A crash or a workaround on it: what it is (a rewrite, if any).
        if mark & (app.MARK_CRASH | app.MARK_WORKAROUND) != 0 && codemap.*.built && after < right - 60 {
            buildLineHints(codemap, tab, line, mark)
            const hinted = drawChips(codemap, canvas, after, y, right - 12, 230)
        }
        row_y += app.EDITOR_LINE
        line = assist_module.nextShown(codemap, tab, line)
    }
    // The cursor.
    const cursor_y = lineY(codemap, tab, cursor_line)
    if cursor_y >= top && cursor_y + app.EDITOR_LINE <= bottom {
        const x = text_x + @intCast(i32, editor_module.columnOf(editor, editor.*.cursor)) * cw
        canvas_module.fillRect(canvas, x, cursor_y + 1, 2, app.EDITOR_LINE - 2, app.ACCENT)
    }
    drawing_module.drawEditorScrollbar(codemap, canvas, right, top, bottom)
    assist_module.drawSignatureHelp(codemap, canvas, right)
    drawing_module.fadeDone(canvas)
    if !codemap.*.refsOpen && !codemap.*.completeOpen { drawing_module.drawEditorHover(codemap, canvas, right, bottom) }
    drawing_module.fadeDone(canvas)
    assist_module.drawCompletion(codemap, canvas, right, bottom)
    drawing_module.fadeDone(canvas)
    drawRefs(codemap, canvas, right, bottom)
    drawing_module.fadeDone(canvas)
    assist_module.drawRename(codemap, canvas)
    drawing_module.fadeDone(canvas)
    assist_module.drawBlame(codemap, canvas, right)
    drawing_module.fadeDone(canvas)
}

// A name's color by what it names (else the lexer's).
pub fn semanticColor(codemap: *app.Codemap, symbol: u32, fallback: u32) -> u32 {
    if symbol == app.NONE { return fallback }
    const kind = index_module.symbolAt(codemap.*.index, symbol).*.kind
    if kind == index_module.FIELD { return app.FIELD_COLOR }
    if kind == index_module.PARAM { return app.PARAM_COLOR }
    if kind == index_module.LOCAL_CONST || kind == index_module.LOCAL_VAR || kind == index_module.CAPTURE { return app.TEXT_COLOR }
    if kind == index_module.FUNCTION { return app.CALL_COLOR }
    if kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET || kind == index_module.ALIAS { return app.TYPE_COLOR }
    if kind == index_module.CONST || kind == index_module.VAR || kind == index_module.MEMBER { return app.CONSTANT_COLOR }
    if kind == index_module.IMPORT || kind == index_module.FILE { return app.MODULE_COLOR }
    return fallback
}

pub fn isNameStart(byte: u8) -> bool { return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95 }

// How many blanks a line starts with.
fn indentOf(text: []const u8) -> usize {
    var at: usize = 0
    while at < text.length && (text[at] == 32 || text[at] == 9) { at += 1 }
    return at
}

// The first problem of `line`, in its color after the text (and a wave
// under its column); where the next thing may go.
fn drawProblemAfter(codemap: *app.Codemap, canvas: *app.Canvas, line: usize, x: i32, y: i32, right: i32, text_x: i32, text_end: i32) -> i32 {
    const first = drawProblemFrom(codemap, canvas, access_module.checkOf(codemap), line, x, y, right, text_x, text_end)
    if first != x { return first }
    return drawProblemFrom(codemap, canvas, access_module.buildOf(codemap), line, x, y, right, text_x, text_end)
}

fn drawProblemFrom(codemap: *app.Codemap, canvas: *app.Canvas, check: *check_module.Check, line: usize, x: i32, y: i32, right: i32, text_x: i32, text_end: i32) -> i32 {
    const editor = tabs_module.activeEditor(codemap)
    const path = editor_module.pathOf(editor)
    var at: usize = 0
    while at < check.*.count {
        const diagnostic = check_module.diagnosticAt(check, at)
        const output = check_module.outputText(check)
        const where = output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength]
        if diagnostic.*.line == line + 1 && tabs_module.diagnosticInFile(codemap, where, path) {
            const color = if diagnostic.*.isError { app.ERROR_COLOR } else { app.WARNING_COLOR }
            // A wave from the column to the end of the text.
            var wave_x = text_x + @intCast(i32, if diagnostic.*.column > 0 { diagnostic.*.column - 1 } else { 0 }) * codemap.*.charWidth
            var up = false
            while wave_x < text_end && wave_x < right {
                canvas_module.fillRect(canvas, wave_x, y + app.EDITOR_LINE - (if up { 3 } else { 2 }), 2, 1, filters_module.canvasColor(color, 255))
                wave_x += 2
                up = !up
            }
            const message = output[diagnostic.*.messageStart..diagnostic.*.messageStart + diagnostic.*.messageLength]
            if x < right - 40 {
                canvas_module.fillRoundedRect(canvas, x - 4, y + 1, (if canvas_module.measure(access_module.smallOf(codemap), message) + 12 < right - x { canvas_module.measure(access_module.smallOf(codemap), message) + 12 } else { right - x }), app.EDITOR_LINE - 2, 4, filters_module.canvasColor(color, 40))
                canvas_module.drawText(canvas, access_module.smallOf(codemap), message, x + 2, y + 2, filters_module.canvasColor(color, 255), right - x - 8)
            }
            return x + canvas_module.measure(access_module.smallOf(codemap), message) + 24
        }
        at += 1
    }
    return x
}

pub fn writeLens(codemap: *app.Codemap, into: [*]u8, symbol: u32) -> usize {
    if !access_module.measured(codemap, symbol) { return filters_module.writeText(into, 0, access_module.say(codemap, "new: the map measures it when it reads the code again", "neu: die Karte misst es, wenn sie den Code neu einliest")) }
    var length: usize = 0
    const uses = analysis_module.usesOf(access_module.analysisOf(codemap), symbol)
    length = filters_module.writeNumber(codemap, into, length, @intCast(usize, uses))
    length = filters_module.writeText(into, length, if uses == 1 { access_module.say(codemap, " use", " Verwendung") } else { access_module.say(codemap, " uses", " Verwendungen") })
    const bytes = binaries_module.bytesOf(access_module.binariesOf(codemap), symbol)
    if bytes > 0 {
        length = filters_module.writeText(into, length, " · ")
        length = filters_module.writeNumber(codemap, into, length, @intCast(usize, bytes))
        length = filters_module.writeText(into, length, " B")
    }
    const commits = history_module.commitsOf(access_module.historyOf(codemap), symbol)
    if commits > 0 {
        length = filters_module.writeText(into, length, " · ")
        length = filters_module.writeNumber(codemap, into, length, @intCast(usize, commits))
        length = filters_module.writeText(into, length, if commits == 1 { " Commit" } else { " Commits" })
    }
    const risk = measures_module.risk(access_module.measuresOf(codemap), symbol)
    if risk > 0 {
        length = filters_module.writeText(into, length, access_module.say(codemap, " · risk ", " · Risiko "))
        length = filters_module.writeNumber(codemap, into, length, @intCast(usize, risk))
    }
    const crashes = access_module.crashesOf(codemap)
    const crashed = crashes_module.stoppedIn(crashes, symbol) + crashes_module.wentThrough(crashes, symbol)
    if crashed > 0 {
        length = filters_module.writeText(into, length, access_module.say(codemap, " · crashed ", " · abgestürzt "))
        length = filters_module.writeNumber(codemap, into, length, @intCast(usize, crashed))
        length = filters_module.writeText(into, length, "x")
    }
    const profiles = access_module.profilesOf(codemap)
    const hot = profiles_module.totalOf(profiles, symbol)
    if hot > 0 && profiles.*.allSamples > 0 {
        length = filters_module.writeText(into, length, access_module.say(codemap, " · time ", " · Zeit "))
        length = filters_module.writeNumber(codemap, into, length, @intCast(usize, @intCast(u64, hot) * 100 / profiles.*.allSamples))
        length = filters_module.writeText(into, length, "%")
    }
    return length
}

// ---------------------------------------------------------------------------
// What the map knows, in the editor: a lens row above each function and
// type (its uses and findings, as chips), hints on the lines a crash or a
// workaround is on, the references list.

fn lensBytes(codemap: *app.Codemap) -> [*]u8 { return access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "lensText")) }

fn addChip(codemap: *app.Codemap, kind: u8, color: u32, target: u32, text: []const u8) -> void {
    const count = codemap.*.lensCount
    if count >= 24 { return }
    const start = if count == 0 { 0 } else { codemap.*.lensEnd[count - 1] }
    if start + text.length > 1000 { return }
    codemap.*.lensEnd[count] = filters_module.writeText(lensBytes(codemap), start, text)
    codemap.*.lensColor[count] = color
    codemap.*.lensKind[count] = kind
    codemap.*.lensTarget[count] = target
    codemap.*.lensCount = count + 1
}

fn chipText(codemap: *app.Codemap, chip: usize) -> []const u8 {
    const start = if chip == 0 { 0 } else { codemap.*.lensEnd[chip - 1] }
    return lensBytes(codemap)[start..codemap.*.lensEnd[chip]]
}

// Another member of `symbol`'s group of `kind` (copies, shapes, names);
// NONE: none.
fn otherMember(codemap: *app.Codemap, kind: u8, symbol: u32) -> u32 {
    const analysis = access_module.analysisOf(codemap)
    const group = analysis_module.groupOf(analysis, kind, symbol)
    if group == app.NONE { return app.NONE }
    for member in analysis_module.groupMembers(analysis, kind, @intCast(usize, group)) {
        if member != symbol { return member }
    }
    return app.NONE
}

fn isUnused(codemap: *app.Codemap, symbol: u32) -> bool {
    const analysis = access_module.analysisOf(codemap)
    var at: usize = 0
    while at < analysis.*.unusedCount {
        if analysis.*.unused[at] == symbol { return true }
        at += 1
    }
    return false
}

// The chips of a declaration's lens: its uses, crashes, workarounds, time,
// risk, complexity, reach, copies, namesakes, machine code, commits and
// whether it changed since the base.
fn buildLens(codemap: *app.Codemap, symbol: u32) -> void {
    codemap.*.lensCount = 0
    if !access_module.measured(codemap, symbol) {
        addChip(codemap, app.CHIP_TEXT, app.CHANGED_COLOR, app.NONE, access_module.say(codemap, "new: measured when the map reads the code again", "neu: gemessen, wenn die Karte den Code neu einliest"))
        return
    }
    const index = codemap.*.index
    const kind = index_module.symbolAt(index, symbol).*.kind
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const uses = analysis_module.usesOf(access_module.analysisOf(codemap), symbol)
    var length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, uses))
    length = filters_module.writeText(bytes, length, if uses == 1 { access_module.say(codemap, " use", " Verwendung") } else { access_module.say(codemap, " uses", " Verwendungen") })
    addChip(codemap, app.CHIP_USES, app.DIM_COLOR, symbol, bytes[0..length])
    const crashes = access_module.crashesOf(codemap)
    const stopped = crashes_module.stoppedIn(crashes, symbol)
    const through = crashes_module.wentThrough(crashes, symbol)
    if stopped > 0 {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "crashed here ", "hier abgestürzt "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, stopped))
        length = filters_module.writeText(bytes, length, "x")
        addChip(codemap, app.CHIP_CRASHES, app.CRASH_COLOR, symbol, bytes[0..length])
    }
    if through > 0 {
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, through))
        length = filters_module.writeText(bytes, length, if through == 1 { access_module.say(codemap, " crash went through", " Absturz lief hindurch") } else { access_module.say(codemap, " crashes went through", " Abstürze liefen hindurch") })
        addChip(codemap, app.CHIP_CRASHES, app.CRASH_COLOR, symbol, bytes[0..length])
    }
    const places = workarounds_module.placesOf(access_module.workaroundsOf(codemap), symbol)
    if places > 0 {
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, places))
        length = filters_module.writeText(bytes, length, if places == 1 { " workaround" } else { " workarounds" })
        addChip(codemap, app.CHIP_WORKAROUNDS, app.WORKAROUND_COLOR, symbol, bytes[0..length])
    }
    const profiles = access_module.profilesOf(codemap)
    const hot = profiles_module.totalOf(profiles, symbol)
    if hot > 0 && profiles.*.allSamples > 0 {
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, @intCast(u64, hot) * 100 / profiles.*.allSamples))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, "% of the time", "% der Zeit"))
        addChip(codemap, app.CHIP_TEXT, app.HOT_COLOR, app.NONE, bytes[0..length])
    }
    const risk = measures_module.risk(access_module.measuresOf(codemap), symbol)
    if risk >= measures_module.RISKY {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "risky (", "riskant ("))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, risk))
        length = filters_module.writeText(bytes, length, ")")
        addChip(codemap, app.CHIP_TEXT, app.RISKY_COLOR, app.NONE, bytes[0..length])
    } else if risk > 0 {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "risk ", "Risiko "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, risk))
        addChip(codemap, app.CHIP_TEXT, app.DIM_COLOR, app.NONE, bytes[0..length])
    }
    const complexity = access_module.complexityOf(codemap)
    if complexity_module.isComplex(complexity, symbol) {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "complex: ", "komplex: "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, complexity_module.branchesOf(complexity, symbol)))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " branches, ", " Zweige, "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, complexity_module.depthOf(complexity, symbol)))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " deep", " tief"))
        addChip(codemap, app.CHIP_TEXT, app.COMPLEX_COLOR, app.NONE, bytes[0..length])
    }
    if kind == index_module.FUNCTION {
        const programs = access_module.programsOf(codemap)
        if programs_module.isUnreachable(programs, symbol) && binaries_module.bytesOf(access_module.binariesOf(codemap), symbol) == 0 {
            addChip(codemap, app.CHIP_TEXT, app.UNREACHABLE_COLOR, app.NONE, access_module.say(codemap, "no program reaches it", "kein Programm erreicht das"))
        } else if programs_module.isUntested(programs, symbol) {
            addChip(codemap, app.CHIP_TEXT, app.UNTESTED_COLOR, app.NONE, access_module.say(codemap, "no check reaches it", "kein Check erreicht das"))
        }
    }
    if uses == 0 && isUnused(codemap, symbol) { addChip(codemap, app.CHIP_TEXT, app.FINDING_COLOR, app.NONE, access_module.say(codemap, "unused", "ungenutzt")) }
    const copy = otherMember(codemap, analysis_module.COPIES, symbol)
    const shape = if copy == app.NONE { otherMember(codemap, analysis_module.SHAPES, symbol) } else { app.NONE }
    if copy != app.NONE || shape != app.NONE {
        length = filters_module.writeText(bytes, 0, if copy != app.NONE { access_module.say(codemap, "same body as ", "gleicher Rumpf wie ") } else { access_module.say(codemap, "same shape as ", "gleiche Form wie ") })
        length = filters_module.writeText(bytes, length, index_module.nameOf(index, if copy != app.NONE { copy } else { shape }))
        length = filters_module.writeText(bytes, length, " (")
        length = filters_module.writeText(bytes, length, fileNameOf(index, if copy != app.NONE { copy } else { shape }))
        length = filters_module.writeText(bytes, length, ")")
        addChip(codemap, app.CHIP_OPEN, app.FINDING_COLOR, if copy != app.NONE { copy } else { shape }, bytes[0..length])
    }
    const namesake = otherMember(codemap, analysis_module.NAMES, symbol)
    if namesake != app.NONE {
        const group = analysis_module.groupOf(access_module.analysisOf(codemap), analysis_module.NAMES, symbol)
        const others = analysis_module.groupMembers(access_module.analysisOf(codemap), analysis_module.NAMES, @intCast(usize, group)).length - 1
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "written again in ", "noch einmal geschrieben in "))
        length = filters_module.writeNumber(codemap, bytes, length, others)
        length = filters_module.writeText(bytes, length, if others == 1 { access_module.say(codemap, " other file", " anderen Datei") } else { access_module.say(codemap, " other files", " anderen Dateien") })
        addChip(codemap, app.CHIP_OPEN, app.FINDING_COLOR, namesake, bytes[0..length])
    }
    const code = binaries_module.bytesOf(access_module.binariesOf(codemap), symbol)
    if code > 0 {
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, code))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " B of code", " B Code"))
        addChip(codemap, app.CHIP_TEXT, app.DIM_COLOR, app.NONE, bytes[0..length])
    }
    const commits = history_module.commitsOf(access_module.historyOf(codemap), symbol)
    if commits > 0 {
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, commits))
        length = filters_module.writeText(bytes, length, if commits == 1 { " commit" } else { " commits" })
        addChip(codemap, app.CHIP_TEXT, app.DIM_COLOR, app.NONE, bytes[0..length])
    }
    const state = diff_module.stateOf(access_module.diffOf(codemap), symbol)
    if state == diff_module.ADDED || state == diff_module.CHANGED {
        length = filters_module.writeText(bytes, 0, if state == diff_module.ADDED { access_module.say(codemap, "added since ", "neu seit ") } else { access_module.say(codemap, "changed since ", "geändert seit ") })
        length = filters_module.writeText(bytes, length, diff_module.baseName(access_module.diffOf(codemap)))
        addChip(codemap, app.CHIP_TEXT, app.CHANGED_COLOR, app.NONE, bytes[0..length])
    }
}

// The file name (no folders) a symbol is declared in.
fn fileNameOf(index: *index_module.Index, symbol: u32) -> []const u8 {
    const path = index_module.pathOf(index, index_module.symbolAt(index, symbol).*.file)
    var slash = path.length
    while slash > 0 && path[slash - 1] != 47 { slash -= 1 }
    return path[slash..path.length]
}

// The hints of a line: the crashes that stopped on it or went through it,
// the workaround on it (with a rewrite when there is one).
pub fn buildLineHints(codemap: *app.Codemap, tab: usize, line: usize, mark: u8) -> void {
    codemap.*.lensCount = 0
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length: usize = 0
    if mark & app.MARK_CRASH != 0 {
        const crashes = access_module.crashesOf(codemap)
        const relative = tabs_module.tabRelative(codemap, tab)
        var stopped: usize = 0
        var through: usize = 0
        var newest: u32 = app.NONE
        var frame: usize = 0
        while frame < crashes.*.frameCount {
            const where = crashes_module.frameWhere(crashes_module.frameText(crashes, frame))
            var colon = where.length
            while colon > 0 && where[colon - 1] != 58 { colon -= 1 }
            if colon > 1 && access_module.sameBytes(where[0..colon - 1], relative) && tabs_module.parseDigits(where, colon) == line + 1 {
                if crashes.*.frameDepth[frame] == 0 { stopped += 1 } else { through += 1 }
                const record = crashes.*.frameRecord[frame]
                if newest == app.NONE || crashes_module.timeOf(crashes, record) >= crashes_module.timeOf(crashes, newest) { newest = record }
            }
            frame += 1
        }
        if stopped > 0 {
            length = filters_module.writeText(bytes, 0, access_module.say(codemap, "crashed here ", "hier abgestürzt "))
            length = filters_module.writeNumber(codemap, bytes, length, stopped)
            length = filters_module.writeText(bytes, length, "x: ")
            const reason = crashes_module.field(crashes, newest, 3)
            length = filters_module.writeText(bytes, length, if reason.length > 200 { reason[0..200] } else { reason })
            addChip(codemap, app.CHIP_CRASHES, app.CRASH_COLOR, app.NONE, bytes[0..length])
        } else if through > 0 {
            length = filters_module.writeNumber(codemap, bytes, 0, through)
            length = filters_module.writeText(bytes, length, if through == 1 { access_module.say(codemap, " crash went through here", " Absturz lief hier hindurch") } else { access_module.say(codemap, " crashes went through here", " Abstürze liefen hier hindurch") })
            addChip(codemap, app.CHIP_CRASHES, app.CRASH_COLOR, app.NONE, bytes[0..length])
        }
    }
    if mark & app.MARK_WORKAROUND != 0 && codemap.*.tabPlaces[tab] != 0 {
        const places = tabs_module.placesOfTab(codemap, tab)
        const workarounds = access_module.workaroundsOf(codemap)
        var place: usize = 0
        while place < codemap.*.tabPlaceCount[tab] {
            if @intCast(usize, places[place * 2]) == line {
                const which = @intCast(usize, places[place * 2 + 1])
                const pattern = workarounds.*.pattern[which]
                // The rewrite first (the text may not fit).
                if rewrite_module.rewritable(pattern) && tabs_module.tabIndexedNow(codemap, tab) {
                    addChip(codemap, app.CHIP_REWRITE, app.ACCENT, @intCast(u32, which), access_module.say(codemap, "Rewrite", "Umschreiben"))
                }
                length = filters_module.writeText(bytes, 0, workarounds_module.shortTitle(pattern, codemap.*.german))
                length = filters_module.writeText(bytes, length, " (")
                length = filters_module.writeText(bytes, length, workarounds_module.missing(pattern, codemap.*.german))
                length = filters_module.writeText(bytes, length, ")")
                addChip(codemap, app.CHIP_TEXT, app.WORKAROUND_COLOR, app.NONE, bytes[0..length])
                return
            }
            place += 1
        }
    }
}

// The chips made last, from x on the row at y: text, or (with an action)
// lit under the pointer; where the row ends.
pub fn drawChips(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, y: i32, right: i32, alpha: u32) -> i32 {
    const small = access_module.smallOf(codemap)
    var at_x = x
    var chip: usize = 0
    while chip < codemap.*.lensCount && at_x < right - 30 {
        const text = chipText(codemap, chip)
        const kind = codemap.*.lensKind[chip]
        const width = canvas_module.measure(small, text)
        if chip > 0 && kind != app.CHIP_REWRITE && codemap.*.lensKind[chip - 1] != app.CHIP_REWRITE {
            canvas_module.drawText(canvas, small, "·", at_x + 4, y + 2, filters_module.canvasColor(app.DIM_COLOR, alpha), 0)
            at_x += 16
        }
        const slot = codemap.*.chipCount
        const lit = kind != app.CHIP_TEXT && codemap.*.hover == app.HIT_CHIP + slot
        if kind == app.CHIP_REWRITE {
            at_x += 8
            canvas_module.fillRoundedRect(canvas, at_x - 6, y + 1, width + 12, app.EDITOR_LINE - 2, 5, if lit { filters_module.canvasColor(app.ACCENT, 120) } else { filters_module.canvasColor(app.ACCENT, 60) })
        }
        canvas_module.drawText(canvas, small, text, at_x, y + 2, if lit { app.TEXT_COLOR } else { filters_module.canvasColor(codemap.*.lensColor[chip], alpha) }, right - at_x - 4)
        if lit && kind != app.CHIP_REWRITE { canvas_module.fillRect(canvas, at_x, y + app.EDITOR_LINE - 3, width, 1, app.TEXT_COLOR) }
        if kind != app.CHIP_TEXT && slot < app.MAX_CHIPS {
            codemap.*.chipX0[slot] = at_x - 4
            codemap.*.chipX1[slot] = at_x + width + 4
            codemap.*.chipY[slot] = y
            codemap.*.chipKind[slot] = kind
            codemap.*.chipTarget[slot] = codemap.*.lensTarget[chip]
            codemap.*.chipCount = slot + 1
        }
        at_x += width + (if kind == app.CHIP_REWRITE { 14 } else { 0 })
        chip += 1
    }
    return at_x
}

// The declaration a lens row above `line` is for (NONE: none).
fn lensSymbolAt(codemap: *app.Codemap, tab: usize, line: usize) -> u32 {
    const spans = tabs_module.spansOf(codemap, tab)
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        if @intCast(usize, spans[span * 4]) == line && tabs_module.hasLens(codemap.*.index, spans[span * 4 + 3]) { return spans[span * 4 + 3] }
        span += 1
    }
    return app.NONE
}

pub fn hasLensRow(codemap: *app.Codemap, tab: usize, line: usize) -> bool {
    return line < codemap.*.tabMarkLines[tab] && tabs_module.marksOf(codemap, tab)[line] & app.MARK_LENS != 0 && codemap.*.built
}

// Where a line's text row is (a lens row may be above it); -1 above the
// view, the bottom below it.
pub fn lineY(codemap: *app.Codemap, tab: usize, line: usize) -> i32 {
    const editor = access_module.editorAt(codemap, tab)
    if line < editor.*.top { return -1 }
    const bottom = editorBottom(codemap)
    var y = editorCodeTop()
    var at = editor.*.top
    while at < line {
        y += app.EDITOR_LINE
        if hasLensRow(codemap, tab, at) { y += app.EDITOR_LINE }
        if y > bottom { return bottom }
        at = assist_module.nextShown(codemap, tab, at)
    }
    // Hidden in a fold: not on the view.
    if at != line { return bottom }
    if hasLensRow(codemap, tab, line) { y += app.EDITOR_LINE }
    return y
}

// The line whose row is at y (its lens row counts as it).
pub fn lineAtY(codemap: *app.Codemap, tab: usize, y: i32) -> usize {
    const editor = access_module.editorAt(codemap, tab)
    var row_y = editorCodeTop()
    var line = editor.*.top
    while line < editor.*.lineCount {
        var height = app.EDITOR_LINE
        if hasLensRow(codemap, tab, line) { height += app.EDITOR_LINE }
        if y < row_y + height { return line }
        row_y += height
        line = assist_module.nextShown(codemap, tab, line)
    }
    return editor.*.lineCount
}

// A click on a chip.
pub fn pressChip(codemap: *app.Codemap, chip: usize) -> void {
    if chip >= codemap.*.chipCount { return }
    const kind = codemap.*.chipKind[chip]
    const target = codemap.*.chipTarget[chip]
    if kind == app.CHIP_USES {
        openRefs(codemap, target, codemap.*.chipX0[chip], codemap.*.chipY[chip] + app.EDITOR_LINE)
    } else if kind == app.CHIP_CRASHES {
        access_module.openFinding(codemap, app.FINDING_CRASHES)
    } else if kind == app.CHIP_WORKAROUNDS {
        nextWorkaround(codemap, target)
    } else if kind == app.CHIP_OPEN {
        const node = access_module.nodeOfSymbol(codemap, target)
        if node != app.NONE { navigation_module.select(codemap, node) }
        tabs_module.openSymbol(codemap, target)
    } else if kind == app.CHIP_REWRITE {
        rewriteHere(codemap, @intCast(usize, target))
    } else if kind == app.CHIP_UNFOLD && tabs_module.hasTab(codemap) {
        assist_module.toggleFold(codemap, codemap.*.activeTab, @intCast(usize, target))
    }
}

// The cursor to the next workaround line of a declaration (from the top
// again after the last).
fn nextWorkaround(codemap: *app.Codemap, symbol: u32) -> void {
    if !tabs_module.hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    const spans = tabs_module.spansOf(codemap, tab)
    var first: usize = 0
    var last: usize = editor.*.lineCount
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        if spans[span * 4 + 3] == symbol {
            first = @intCast(usize, spans[span * 4])
            last = @intCast(usize, spans[span * 4 + 1])
        }
        span += 1
    }
    const marks = tabs_module.marksOf(codemap, tab)
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    var found = editor.*.lineCount
    var line = first
    while line <= last && line < codemap.*.tabMarkLines[tab] {
        if marks[line] & app.MARK_WORKAROUND != 0 {
            if found == editor.*.lineCount { found = line }
            if line > cursor_line {
                found = line
                break
            }
        }
        line += 1
    }
    if found >= editor.*.lineCount { return }
    editor_module.moveTo(editor, editor_module.lineStart(editor, found), false)
    editor_module.home(editor, false)
    tabs_module.keepCursorSeen(codemap)
}

// The rewrite of one workaround place, in the editor's text (undo takes it
// back; Save writes it).
fn rewriteHere(codemap: *app.Codemap, place: usize) -> void {
    if !tabs_module.hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    if !tabs_module.tabIndexedNow(codemap, tab) { return }
    const workarounds = access_module.workaroundsOf(codemap)
    const pattern = workarounds.*.pattern[place]
    if !codemap.*.rewriteReady {
        rewrite_module.init(actions_module.rewriteEditsOf(codemap), codemap.*.allocator)
        codemap.*.rewriteReady = true
    }
    const edits = actions_module.rewriteEditsOf(codemap)
    rewrite_module.plan(edits, workarounds, codemap.*.index, pattern, tabs_module.tabRelative(codemap, tab))
    const offset = @intCast(usize, workarounds.*.offset[place])
    const file = codemap.*.tabFile[tab]
    var chosen = edits.*.count
    var edit: usize = 0
    while edit < edits.*.count {
        if edits.*.file[edit] == file && @intCast(usize, edits.*.start[edit]) <= offset + 64 && @intCast(usize, edits.*.end[edit]) >= offset {
            if chosen == edits.*.count { chosen = edit }
        }
        edit += 1
    }
    if chosen == edits.*.count {
        access_module.setNote(codemap, access_module.say(codemap, "Nothing to rewrite here", "Hier gibt es nichts umzuschreiben"), "")
        return
    }
    const editor = tabs_module.activeEditor(codemap)
    const line_before = editor_module.lineOf(editor, @intCast(usize, edits.*.start[chosen]))
    const lines_before = editor.*.lineCount
    editor.*.anchor = @intCast(usize, edits.*.start[chosen])
    editor.*.cursor = @intCast(usize, edits.*.end[chosen])
    editor_module.insert(editor, rewrite_module.replacement(edits, chosen))
    tabs_module.shiftMarks(codemap, tab, line_before, lines_before)
    tabs_module.marksOf(codemap, tab)[line_before] = (tabs_module.marksOf(codemap, tab)[line_before] & ~app.MARK_WORKAROUND) | app.MARK_CHANGED
    if codemap.*.rewritePattern != 255 { actions_module.planRewrite(codemap, codemap.*.rewritePattern) }
    access_module.setNote(codemap, access_module.say(codemap, "Rewritten (Ctrl+Z takes it back, Ctrl+S saves): ", "Umgeschrieben (Strg+Z nimmt es zurück, Strg+S speichert): "), workarounds_module.shortTitle(pattern, codemap.*.german))
    if codemap.*.trace { navigation_module.traceLine(codemap, "rewritten here: ", editor_module.lineText(editor, line_before)) }
    access_module.panelOf(codemap).*.dirty = true
}

// ---------------------------------------------------------------------------
// The references list

// The uses of `symbol` (the first 512), listed under (x, y).
pub fn openRefs(codemap: *app.Codemap, symbol: u32, x: i32, y: i32) -> void {
    if symbol == app.NONE || !codemap.*.built { return }
    const index = codemap.*.index
    codemap.*.refsCount = 0
    codemap.*.refsTotal = 0
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol && value.*.use != index_module.USE_DECLARATION {
            if codemap.*.refsCount < app.MAX_REFS_SHOWN {
                codemap.*.refsList[codemap.*.refsCount] = @intCast(u32, ref)
                codemap.*.refsCount += 1
            }
            codemap.*.refsTotal += 1
        }
        ref += 1
    }
    codemap.*.refsOpen = true
    codemap.*.refsSymbol = symbol
    codemap.*.refsSelected = 0
    codemap.*.refsScroll = 0
    codemap.*.refsX = x
    codemap.*.refsY = y
    if codemap.*.trace {
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = filters_module.writeText(bytes, 0, ": ")
        length = lists_module.writeNumberPlain(bytes, length, codemap.*.refsTotal)
        navigation_module.traceLine(codemap, "references ", index_module.nameOf(index, symbol))
        navigation_module.traceLine(codemap, "references count", bytes[0..length])
    }
    access_module.panelOf(codemap).*.dirty = true
}

fn refsShown() -> usize { return 12 }

fn drawRefs(codemap: *app.Codemap, canvas: *app.Canvas, right: i32, bottom: i32) -> void {
    if !codemap.*.refsOpen { return }
    const slide = drawing_module.fadeIn(codemap, canvas, app.OVERLAY_REFS, @intCast(u64, codemap.*.refsSymbol) + 1)
    const index = codemap.*.index
    var width: i32 = 720
    var x = codemap.*.refsX
    if x + width > right - 14 { x = right - 14 - width }
    if x < app.SIDEBAR + 8 {
        x = app.SIDEBAR + 8
        width = right - 14 - x
    }
    const rows = if codemap.*.refsCount < refsShown() { codemap.*.refsCount } else { refsShown() }
    const height = 34 + @intCast(i32, if rows > 0 { rows } else { 1 }) * app.REF_ROW + 8
    var y = codemap.*.refsY
    if y + height > bottom - 4 { y = bottom - 4 - height }
    codemap.*.refsX = x
    codemap.*.refsY = y
    y -= slide
    codemap.*.refsWidth = width
    canvas_module.fillRoundedRect(canvas, x + 2, y + 4, width, height, 10, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 10, canvas_module.color(250, 32, 34, 43))
    canvas_module.strokeRoundedRect(canvas, x, y, width, height, 10, 1, canvas_module.color(255, 58, 62, 76))
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeNumber(codemap, bytes, 0, codemap.*.refsTotal)
    length = filters_module.writeText(bytes, length, if codemap.*.refsTotal == 1 { access_module.say(codemap, " use of ", " Verwendung von ") } else { access_module.say(codemap, " uses of ", " Verwendungen von ") })
    length = filters_module.writeText(bytes, length, index_module.nameOf(index, codemap.*.refsSymbol))
    if codemap.*.refsTotal > codemap.*.refsCount {
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " (the first ", " (die ersten "))
        length = filters_module.writeNumber(codemap, bytes, length, codemap.*.refsCount)
        length = filters_module.writeText(bytes, length, ")")
    }
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), bytes[0..length], x + 14, y + 9, app.TEXT_COLOR, width - 28)
    canvas_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "Enter opens, Esc closes", "Enter öffnet, Esc schließt"), x + width - 170, y + 11, app.DIM_COLOR, 160)
    var row: usize = 0
    while row < rows {
        const at = codemap.*.refsScroll + row
        if at >= codemap.*.refsCount { break }
        const row_y = y + 34 + @intCast(i32, row) * app.REF_ROW
        if at == codemap.*.refsSelected || codemap.*.hover == app.HIT_REF_ROW + row { canvas_module.fillRoundedRect(canvas, x + 6, row_y, width - 12, app.REF_ROW, 6, if at == codemap.*.refsSelected { canvas_module.color(255, 52, 78, 130) } else { canvas_module.color(255, 46, 50, 62) }) }
        const value = index_module.refAt(index, @intCast(usize, codemap.*.refsList[at]))
        const file = value.*.file
        const source = index_module.sourceOf(index, file)
        const offset = @intCast(usize, value.*.start)
        const line = index_module.lineOf(index, file, offset)
        length = filters_module.writeText(bytes, 0, programs_module.relativePath(index, file))
        length = filters_module.writeText(bytes, length, ":")
        length = lists_module.writeNumberPlain(bytes, length, line + 1)
        const place_width: i32 = 250
        canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 14, row_y + 4, app.DIM_COLOR, place_width - 10)
        var line_start = offset
        while line_start > 0 && source[line_start - 1] != 10 { line_start -= 1 }
        while line_start < offset && (source[line_start] == 32 || source[line_start] == 9) { line_start += 1 }
        var line_end = offset
        while line_end < source.length && source[line_end] != 10 { line_end += 1 }
        canvas_module.drawText(canvas, access_module.monoOf(codemap), source[line_start..line_end], x + 14 + place_width, row_y + 3, app.TEXT_COLOR, width - place_width - 28)
        row += 1
    }
    if codemap.*.refsCount == 0 { canvas_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "Nothing uses it.", "Nichts verwendet das."), x + 14, y + 38, app.DIM_COLOR, width - 28) }
}

pub fn refsHit(codemap: *app.Codemap, x: i32, y: i32) -> usize {
    if !codemap.*.refsOpen { return app.HIT_NONE }
    const rows = if codemap.*.refsCount < refsShown() { codemap.*.refsCount } else { refsShown() }
    const height = 34 + @intCast(i32, if rows > 0 { rows } else { 1 }) * app.REF_ROW + 8
    if !filters_module.inside(x, y, codemap.*.refsX, codemap.*.refsY, codemap.*.refsWidth, height) { return app.HIT_NONE }
    if y >= codemap.*.refsY + 34 {
        const row = @intCast(usize, (y - codemap.*.refsY - 34) / app.REF_ROW)
        if row < rows { return app.HIT_REF_ROW + row }
    }
    return app.HIT_REFS
}

// Opens use `at` of the list.
pub fn openRef(codemap: *app.Codemap, at: usize) -> void {
    if at >= codemap.*.refsCount { return }
    const index = codemap.*.index
    const value = index_module.refAt(index, @intCast(usize, codemap.*.refsList[at]))
    const offset = @intCast(usize, value.*.start)
    codemap.*.refsOpen = false
    const opened = tabs_module.openFile(codemap, index_module.pathOf(index, value.*.file), index_module.lineOf(index, value.*.file, offset) + 1, index_module.columnOf(index, value.*.file, offset) + 1)
    if codemap.*.trace { navigation_module.traceLine(codemap, "reference opened ", programs_module.relativePath(index, value.*.file)) }
}

// The keys of the list (open); true when it took the key.
pub fn refsKey(codemap: *app.Codemap, key: u32) -> bool {
    if !codemap.*.refsOpen { return false }
    if key == app.KEY_ESCAPE {
        codemap.*.refsOpen = false
    } else if key == app.KEY_DOWN {
        if codemap.*.refsSelected + 1 < codemap.*.refsCount { codemap.*.refsSelected += 1 }
    } else if key == app.KEY_UP {
        if codemap.*.refsSelected > 0 { codemap.*.refsSelected -= 1 }
    } else if key == app.KEY_PAGE_DOWN {
        codemap.*.refsSelected = if codemap.*.refsSelected + refsShown() < codemap.*.refsCount { codemap.*.refsSelected + refsShown() } else { if codemap.*.refsCount > 0 { codemap.*.refsCount - 1 } else { 0 } }
    } else if key == app.KEY_PAGE_UP {
        codemap.*.refsSelected = if codemap.*.refsSelected > refsShown() { codemap.*.refsSelected - refsShown() } else { 0 }
    } else if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        openRef(codemap, codemap.*.refsSelected)
        return true
    } else {
        return false
    }
    if codemap.*.refsSelected < codemap.*.refsScroll { codemap.*.refsScroll = codemap.*.refsSelected }
    if codemap.*.refsSelected >= codemap.*.refsScroll + refsShown() { codemap.*.refsScroll = codemap.*.refsSelected + 1 - refsShown() }
    return true
}
