// The little math the 3D view needs, in f64: square roots, sines and
// cosines (written out: there is no libm), vectors, and the orbit camera
// that turns world points into view pixels.

pub fn sqrt(value: f64) -> f64 {
    if value <= 0.0 { return 0.0 }
    // A first guess from the exponent (halved), then Newton's steps.
    const bits: u64 = @bitCast(u64, value)
    var guess: f64 = @bitCast(f64, (bits >> 1) + 2303591209400008704)
    guess = 0.5 * (guess + value / guess)
    guess = 0.5 * (guess + value / guess)
    guess = 0.5 * (guess + value / guess)
    guess = 0.5 * (guess + value / guess)
    guess = 0.5 * (guess + value / guess)
    return guess
}

pub fn absolute(value: f64) -> f64 { return if value < 0.0 { -value } else { value } }
pub fn minimum(a: f64, b: f64) -> f64 { return if a < b { a } else { b } }
pub fn maximum(a: f64, b: f64) -> f64 { return if a > b { a } else { b } }
pub fn clamp(value: f64, low: f64, high: f64) -> f64 { return if value < low { low } else if value > high { high } else { value } }

// `value` moved into -PI .. PI.
// (Module-level f64 constants do not reach the backend, and arithmetic on
// two float literals folds wrong: values are spelled out in the functions.)
fn wrapAngle(value: f64) -> f64 {
    const pi: f64 = 3.141592653589793
    const turns: f64 = value / (2.0 * pi)
    const whole: i64 = @intFromFloat(i64, turns)
    const back: f64 = @floatFromInt(f64, whole)
    var rest = value - back * 2.0 * pi
    if rest > pi { rest = rest - 2.0 * pi }
    if rest < -pi { rest = rest + 2.0 * pi }
    return rest
}

pub fn sin(value: f64) -> f64 {
    const pi: f64 = 3.141592653589793
    var x = wrapAngle(value)
    // Into -PI/2 .. PI/2 (sin(PI - x) = sin(x)).
    const half_pi: f64 = 1.5707963267948966
    if x > half_pi { x = pi - x }
    if x < -half_pi { x = -pi - x }
    const x2 = x * x
    // Taylor to x^13: under 1e-9 off there.
    return x * (1.0 - x2 / 6.0 * (1.0 - x2 / 20.0 * (1.0 - x2 / 42.0 * (1.0 - x2 / 72.0 * (1.0 - x2 / 110.0 * (1.0 - x2 / 156.0))))))
}

pub fn cos(value: f64) -> f64 { return sin(value + 1.5707963267948966) }

// The natural logarithm: the exponent times ln 2, and the mantissa's by
// 2 atanh((m - 1) / (m + 1)).
pub fn ln(value: f64) -> f64 {
    if value <= 0.0 { return -1000.0 }
    const bits: u64 = @bitCast(u64, value)
    const exponent = @intCast(i64, bits >> 52) - 1023
    const mantissa: f64 = @bitCast(f64, (bits & 4503599627370495) | 4607182418800017408)
    const z = (mantissa - 1.0) / (mantissa + 1.0)
    const z2 = z * z
    const series = 2.0 * z * (1.0 + z2 * (0.3333333333333333 + z2 * (0.2 + z2 * (0.14285714285714285 + z2 * (0.1111111111111111 + z2 * 0.09090909090909091)))))
    return toFloat(exponent) * 0.6931471805599453 + series
}

// e to the `value`: 2^k (the exponent's bits) times e^r, |r| <= ln 2 / 2.
pub fn exp(value: f64) -> f64 {
    if value > 700.0 { return exp(700.0) }
    if value < -700.0 { return 0.0 }
    const k = floor(value * 1.4426950408889634 + 0.5)
    const r = value - toFloat(k) * 0.6931471805599453
    const series = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * (0.001388888888888889 + r * (0.0001984126984126984 + r * 0.0000248015873015873)))))))
    const scale_bits: u64 = @intCast(u64, k + 1023) << 52
    const power: f64 = @bitCast(f64, scale_bits)
    return series * power
}

pub fn toFloat(value: i64) -> f64 {
    const result: f64 = @floatFromInt(f64, value)
    return result
}
pub fn toInt(value: f64) -> i64 {
    const whole: i64 = @intFromFloat(i64, value)
    return whole
}

pub fn floor(value: f64) -> i64 {
    const whole: i64 = @intFromFloat(i64, value)
    const back: f64 = @floatFromInt(f64, whole)
    return if back > value { whole - 1 } else { whole }
}

// Smooth start and end for animations (t in 0..1).
pub fn ease(t: f64) -> f64 {
    const c = clamp(t, 0.0, 1.0)
    return c * c * (3.0 - 2.0 * c)
}

pub const Vec = struct {
    x: f64
    y: f64
    z: f64
}

pub fn vec(x: f64, y: f64, z: f64) -> Vec { return Vec.{ .x = x, .y = y, .z = z } }
pub fn add(a: Vec, b: Vec) -> Vec { return Vec.{ .x = a.x + b.x, .y = a.y + b.y, .z = a.z + b.z } }
pub fn sub(a: Vec, b: Vec) -> Vec { return Vec.{ .x = a.x - b.x, .y = a.y - b.y, .z = a.z - b.z } }
pub fn scale(a: Vec, factor: f64) -> Vec { return Vec.{ .x = a.x * factor, .y = a.y * factor, .z = a.z * factor } }
pub fn dot(a: Vec, b: Vec) -> f64 { return a.x * b.x + a.y * b.y + a.z * b.z }
pub fn cross(a: Vec, b: Vec) -> Vec { return Vec.{ .x = a.y * b.z - a.z * b.y, .y = a.z * b.x - a.x * b.z, .z = a.x * b.y - a.y * b.x } }
pub fn length(a: Vec) -> f64 { return sqrt(dot(a, a)) }
pub fn mix(a: Vec, b: Vec, t: f64) -> Vec { return add(a, scale(sub(b, a), t)) }

pub fn normalize(a: Vec) -> Vec {
    const size = length(a)
    if size < 0.000000001 { return a }
    return scale(a, 1.0 / size)
}

// An orbit camera: it looks at `target` from `distance` away, turned by
// `yaw` around the vertical and tilted by `pitch`; `focal` is how many
// pixels one unit is at distance one, (centerX, centerY) where the target
// shows. update() works out the frame it sees with.
pub const Camera = struct {
    target: Vec
    distance: f64
    yaw: f64
    pitch: f64
    focal: f64
    centerX: f64
    centerY: f64
    eye: Vec
    forward: Vec
    right: Vec
    up: Vec
}

pub fn update(camera: *Camera) -> void {
    const cp = cos(camera.*.pitch)
    const offset = vec(cp * sin(camera.*.yaw), sin(camera.*.pitch), cp * cos(camera.*.yaw))
    camera.*.eye = add(camera.*.target, scale(offset, camera.*.distance))
    camera.*.forward = scale(offset, -1.0)
    camera.*.right = normalize(cross(camera.*.forward, vec(0.0, 1.0, 0.0)))
    camera.*.up = cross(camera.*.right, camera.*.forward)
}

// Where a point is seen: view pixels, and its depth (along the view; under
// 0.05, near: behind the eye or too close to show).
pub const Seen = struct {
    x: f64
    y: f64
    depth: f64
}

pub fn project(camera: *const Camera, point: Vec) -> Seen {
    const relative = sub(point, camera.*.eye)
    const depth = dot(relative, camera.*.forward)
    if depth < 0.05 { return Seen.{ .x = 0.0, .y = 0.0, .depth = depth } }
    const scale_factor = camera.*.focal / depth
    return Seen.{ .x = camera.*.centerX + dot(relative, camera.*.right) * scale_factor, .y = camera.*.centerY - dot(relative, camera.*.up) * scale_factor, .depth = depth }
}
