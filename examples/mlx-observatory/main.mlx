const Codemap = struct {
    panel: Panel
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    german: bool
    // MLX_CODEMAP_TRACE: what is selected and read goes to the output (for
    // tests).
    trace: bool
    // The tree read, the index of it and what the view shows of it.
    root: [1024]u8
    rootLength: usize
    index: *Index
    hasIndex: bool
    graph: Graph
    built: bool
    drawnOnce: bool
    buildMilliseconds: usize
    scene: scene_module.Scene
    camera: m.Camera
    // A flight: from where to where, since when.
    flying: bool
    flyStart: usize
    flyDuration: usize
    fromTarget: m.Vec
    toTarget: m.Vec
    fromDistance: f64
    toDistance: f64
    fromYaw: f64
    toYaw: f64
    fromPitch: f64
    toPitch: f64
    bump: f64
    // Where each node was seen last frame (view pixels, radius, depth).
    seenX: [*]f64
    seenY: [*]f64
    seenRadius: [*]f64
    seenDepth: [*]f64
    seen: [*]u8
    // The spheres drawn (to find what the pointer is on).
    drawn: [*]u32
    drawnCount: usize
    // Labels: candidates and those placed.
    labelKeys: [*]u64
    labelScratch: [*]u64
    labelNodes: [90]u32
    labelX: [90]i32
    labelY: [90]i32
    labelWidth: [90]i32
    labelCount: usize
    // What is selected, what the camera is on, what the pointer is on.
    selected: u32
    focus: u32
    hoverNode: u32
    relations: graph_module.Relations
    related: [*]u8
    // Where we were.
    back: [64]u32
    backCount: usize
    forward: [64]u32
    forwardCount: usize
    // The pointer: where, what it is over, a press and the last click.
    pointerX: i32
    pointerY: i32
    hover: usize
    pressed: bool
    pressButton: u32
    pressX: i32
    pressY: i32
    pressHit: usize
    moved: bool
    lastClick: usize
    lastClickHit: usize
    lastClickNode: u32
    // The search: its text, results, and the nodes matching it.
    searchFocused: bool
    search: [256]u8
    searchLength: usize
    // A query in the search (tools/codemap/query.mlx): it leaves out what
    // does not answer it. Bad: a word not understood.
    query: query_module.Query
    queryActive: bool
    queryBad: bool
    queryCount: usize
    // The list open under a toolbar button (POPUP_*), its rows and place.
    popup: u8
    popupX: i32
    popupWidth: i32
    popupRows: usize
    // Where the list's rows start (the history's: under the commit).
    popupRowTop: i32
    // The commits to compare with (git log: "hash subject" lines).
    baseLog: [4096]u8
    baseLogLength: usize
    baseStart: [16]usize
    baseEnd: [16]usize
    baseCount: usize
    // The editor: the files open (tabs), the one shown, per tab its file
    // in the index (NONE: not there), the edit the index knows (its text
    // is the same then), the marks of its lines (crash, workaround,
    // changed, problem: an address of a byte per line), how hot each line
    // is, and its declarations (first, last, name line, symbol: four words
    // each).
    view: u8
    editors: [6]editor_module.Editor
    tabCount: usize
    activeTab: usize
    tabFile: [6]u32
    tabIndexed: [6]usize
    tabMarks: [6]usize
    tabHeat: [6]usize
    tabMarkLines: [6]usize
    tabSpans: [6]usize
    tabSpanCount: [6]usize
    tabChecked: [6]usize
    // The file's time when the tab read or wrote it (ms).
    tabStamp: [6]isize
    // The newest time of the indexed files and their folders (ms), and
    // how many of them there were, when the code was read.
    diskStamp: isize
    // The hover's lines (where a name belongs, its type).
    hoverText: protocol.Writer
    // The editor's lens chips drawn this frame: where, what a click does.
    chipX0: [256]i32
    chipX1: [256]i32
    chipY: [256]i32
    chipKind: [256]u8
    chipTarget: [256]u32
    chipCount: usize
    // One lens (or line hint) being made: its chips' texts, colors, kinds.
    lensText: [1024]u8
    lensEnd: [24]usize
    lensColor: [24]u32
    lensKind: [24]u8
    lensTarget: [24]u32
    lensCount: usize
    // Each tab's workaround places: line and place, in pairs.
    tabPlaces: [6]usize
    tabPlaceCount: [6]usize
    // The references list in the editor (Shift+F12, a lens's uses).
    refsOpen: bool
    refsSymbol: u32
    refsList: [512]u32
    refsCount: usize
    refsTotal: usize
    refsSelected: usize
    refsScroll: usize
    refsX: i32
    refsY: i32
    refsWidth: i32
    // Completion: the items (symbols, or a keyword's or builtin's place),
    // where the name typed starts; signature help while in a call.
    completeOpen: bool
    completeList: [64]u32
    completeCount: usize
    completeSelected: usize
    completeScroll: usize
    completeStart: usize
    signatureActive: bool
    // Renaming: the field's text, the symbol, where its name is.
    renameOpen: bool
    renameSymbol: u32
    renameStart: usize
    renameText: [128]u8
    renameLength: usize
    // The line number under the pointer, and the blame of the last one.
    gutterHover: usize
    blameTab: usize
    blameLineNumber: usize
    blameVersion: usize
    blameText: [256]u8
    blameLength: usize
    diskCount: usize
    // The same, as last looked at (a change since: files changed on disk).
    diskSeenStamp: isize
    diskSeenCount: usize
    mono: Text
    charWidth: i32
    editorDragging: bool
    editorClickAt: usize
    editorClickOffset: usize
    editorHover: usize
    editorLeft: i32
    // The compiler's check of the file shown (diagnostics), and whether a
    // save made the index older than the files.
    check: check_module.Check
    stale: bool
    // Building a program (the compiler with -o, its problems like a
    // check's), and committing: the files Git names as changed, the
    // message, the job and its log.
    build: check_module.Check
    buildName: [128]u8
    buildNameLength: usize
    buildStarted: usize
    changes: [4096]u8
    changesLength: usize
    changeCount: usize
    commitMessage: [512]u8
    commitLength: usize
    job: u8
    jobProcess: isize
    jobLog: [1100]u8
    jobLogLength: usize
    commitFieldY: i32
    commitButtonX: i32
    pushButtonX: i32
    commitButtonsY: i32
    // Where the tabs, the tab bar's buttons and the view switch are.
    tabX: [6]i32
    tabWidth: [6]i32
    editorMapX: i32
    editorSaveX: i32
    viewSwitchY: i32
    // The sidebar's sections folded up, and where their headings are.
    sectionFolded: [8]bool
    headingY: [8]i32
    // The views of codemap.views, at the sidebar's end.
    views: views_module.Views
    viewY: [64]i32
    viewRows: usize
    // What changed since the base (--diff REV, else HEAD).
    diff: diff_module.Diff
    diffBase: [128]u8
    diffBaseLength: usize
    // Asked for at the start: --only GROUP,GROUP and --view NAME or
    // --query WORDS (into the search), applied once the code is read.
    startOnly: [512]u8
    startOnlyLength: usize
    startSearch: [256]u8
    startSearchLength: usize
    results: [12]u32
    resultScores: [12]u32
    resultCount: usize
    resultCursor: usize
    matches: [*]u8
    matchCount: usize
    // What is shown.
    showImports: bool
    showTree: bool
    showLabels: bool
    // The sidebar's rows (group nodes, their indent), the detail panel's
    // rows (for clicks) and how far it is scrolled, sections opened up.
    sidebarNodes: [96]u32
    sidebarIndent: [96]i32
    sidebarCount: usize
    toggleTop: i32
    detailRows: [512]u32
    detailRowY: [512]i32
    detailRowKind: [512]u8
    // A button's part of its row (width 0: the whole row).
    detailRowX: [512]i32
    detailRowWidth: [512]i32
    // Rewriting a kind of workaround away: the kind shown (255: none),
    // its edits, whether the compiler takes the result.
    rewritePattern: u8
    rewriteEdits: rewrite_module.Edits
    rewriteReady: bool
    rewriteAccepted: bool
    // A demo (MLX_CODEMAP_DEMO: a script of steps, see runDemo) and where
    // its pictures go (MLX_CODEMAP_DEMO_OUT).
    demoText: [*]u8
    demoLength: usize
    demoAt: usize
    demoActive: bool
    demoUntil: usize
    demoSettle: bool
    demoShot: [128]u8
    demoShotLength: usize
    demoShotFrame: usize
    demoRecord: usize
    demoRecordIndex: usize
    demoRecordEvery: usize
    demoSpin: f64
    demoSpinAt: usize
    demoClock: usize
    closeAskedAt: usize
    demoOut: [1024]u8
    demoOutLength: usize
    // Work in the background: counting the history (mlx-codemap history),
    // a program under mlx-profile (its process; 0: none).
    historyJob: isize
    profileJob: isize
    detailRowCount: usize
    detailScroll: i32
    detailHeight: i32
    expanded: [12]bool
    // What the code base says as a whole (tools/codemap/analysis.mlx): the
    // findings shown (FINDING_*), their groups in order (kind << 24 |
    // group; unused: symbols), the nodes in them.
    analysis: analysis_module.Analysis
    finding: u8
    findingOrder: [*]u32
    findingCount: usize
    findingMark: [*]u16
    findingTop: i32
    // The crashes the desktop programs kept (tools/codemap/crashes.mlx)
    // and the workarounds of missing features (tools/codemap/
    // workarounds.mlx). Per node: 2 a crash stopped in it, 1 one went
    // through it, 3 one of those is inside it. The log's size when read,
    // and when to look at it again.
    crashes: crashes_module.Crashes
    workarounds: workarounds_module.Workarounds
    crashMark: [*]u8
    // The declarations listed for a missing feature (and how many places).
    keptSymbols: [*]u32
    keptCounts: [*]u32
    crashedCount: usize
    crashLogSize: isize
    crashCheckAt: usize
    // What the sidebar's check boxes leave out. Per node: taken out itself
    // (off); left out (hidden: 1), or shown with something inside left out
    // (2). Kinds of declarations left out, by index kind.
    off: [*]u8
    hidden: [*]u8
    anyOff: bool
    kindOff: [20]bool
    // The findings shown in space (their check boxes), how many of each
    // are shown, the kinds of workarounds (most places first) and which
    // are shown, and whether their list is open in the sidebar.
    findingOn: [16]bool
    findingCounts: [16]usize
    patternOrder: [9]u8
    patternCount: usize
    patternOn: [9]bool
    patternPlaces: [9]usize
    workaroundsOpen: bool
    // Where the sidebar drew the findings' rows and the kinds' rows.
    findingY: [16]i32
    patternY: [9]i32
    patternRows: usize
    legendTop: i32
    // Groups of copies and names joined in space (kind << 24 | group).
    lineGroups: [*]u32
    lineGroupCount: usize
    // The sidebar scrolled (pixels), how tall what it holds is, and where
    // it drew the groups' rows.
    sidebarScroll: i32
    sidebarHeight: i32
    sidebarRowY: [96]i32
    // The programs (tools/codemap/programs.mlx), what they are built into
    // (binaries.mlx), and the other measures (complexity, structure,
    // history from Git, profiles; measures.mlx puts them together). The
    // program shown (the programs' count: all), their order by name, the
    // list open, where its rows are.
    programs: programs_module.Programs
    binaries: binaries_module.Binaries
    complexity: complexity_module.Complexity
    structure: structure_module.Structure
    git: git_module.Git
    history: history_module.History
    profiles: profiles_module.Profiles
    measures: measures_module.Measures
    // The workarounds at the last commits (what mlx-codemap history kept).
    trend: trend_module.Trend
    historyShown: usize
    profilesTime: isize
    historyCheckAt: usize
    program: usize
    programOrder: [128]u32
    programsOpen: bool
    programRowY: [129]i32
    programRows: usize
    programTop: i32
    // What the spheres are colored by (measures_module.KIND: their kind),
    // per node its value (a group's: its members' summed), and the biggest
    // of declarations, files and groups; where the choices are.
    metric: u8
    metricValues: [*]f64
    metricMax: [3]f64
    metricY: [6]i32
    sortKeys: [*]u64
    // Nodes used much as the selection is.
    similarNodes: [12]u32
    similarShares: [12]u32
    similarCount: usize
    crumbX: [32]i32
    crumbNodes: [32]u32
    crumbCount: usize
    // Modifier keys held.
    held: u32
    // A note in the status bar until noteUntil.
    note: [160]u8
    noteLength: usize
    noteUntil: usize
    body: Text
    small: Text
    title: Text
}

// ---------------------------------------------------------------------------
// Access

fn codemapOf(context: *anyopaque) -> *Codemap {
    unsafe { return @ptrCast(*Codemap, context) }
}

fn panelOf(codemap: *Codemap) -> *Panel {
    unsafe { return @ptrCast(*Panel, &codemap.*.panel) }
}

fn graphOf(codemap: *Codemap) -> *Graph {
    unsafe { return @ptrCast(*Graph, &codemap.*.graph) }
}

fn sceneOf(codemap: *Codemap) -> *scene_module.Scene {
    unsafe { return @ptrCast(*scene_module.Scene, &codemap.*.scene) }
}

fn cameraOf(codemap: *Codemap) -> *m.Camera {
    unsafe { return @ptrCast(*m.Camera, &codemap.*.camera) }
}

fn relationsOf(codemap: *Codemap) -> *graph_module.Relations {
    unsafe { return @ptrCast(*graph_module.Relations, &codemap.*.relations) }
}

fn bodyOf(codemap: *Codemap) -> *Text {
    unsafe { return @ptrCast(*Text, &codemap.*.body) }
}

fn smallOf(codemap: *Codemap) -> *Text {
    unsafe { return @ptrCast(*Text, &codemap.*.small) }
}

fn monoOf(codemap: *Codemap) -> *Text {
    unsafe { return @ptrCast(*Text, &codemap.*.mono) }
}

fn hoverTextOf(codemap: *Codemap) -> *protocol.Writer {
    unsafe { return @ptrCast(*protocol.Writer, &codemap.*.hoverText) }
}

fn checkOf(codemap: *Codemap) -> *check_module.Check {
    unsafe { return @ptrCast(*check_module.Check, &codemap.*.check) }
}

fn buildOf(codemap: *Codemap) -> *check_module.Check {
    unsafe { return @ptrCast(*check_module.Check, &codemap.*.build) }
}

// The compiler's problems come from the last check (0) and the last build
// (1).
fn problemsOf(codemap: *Codemap, source: usize) -> *check_module.Check {
    return if source == 0 { checkOf(codemap) } else { buildOf(codemap) }
}

fn editorAt(codemap: *Codemap, tab: usize) -> *editor_module.Editor {
    unsafe { return @ptrFromInt(*editor_module.Editor, @intFromPtr(&codemap.*.editors) + tab * @sizeOf(editor_module.Editor)) }
}

fn titleOf(codemap: *Codemap) -> *Text {
    unsafe { return @ptrCast(*Text, &codemap.*.title) }
}

fn fieldBytes(codemap: *Codemap, field: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(codemap) + field) }
}

fn rootText(codemap: *Codemap) -> []const u8 { return fieldBytes(codemap, @offsetOf(Codemap, "root"))[0..codemap.*.rootLength] }
fn searchText(codemap: *Codemap) -> []const u8 { return fieldBytes(codemap, @offsetOf(Codemap, "search"))[0..codemap.*.searchLength] }
fn noteText(codemap: *Codemap) -> []const u8 { return fieldBytes(codemap, @offsetOf(Codemap, "note"))[0..codemap.*.noteLength] }

fn nodeOf(codemap: *Codemap, node: u32) -> *graph_module.Node { return graph_module.nodeAt(graphOf(codemap), node) }
fn nameOf(codemap: *Codemap, node: u32) -> []const u8 { return graph_module.nameOf(graphOf(codemap), node) }

fn say(codemap: *Codemap, english: []const u8, german: []const u8) -> []const u8 {
    return if codemap.*.german { german } else { english }
}

fn sameBytes(first: []const u8, second: []const u8) -> bool { return index_module.sameBytes(first, second) }

fn cString(value: [*]const u8) -> []const u8 {
    var length: usize = 0
    while value[length] != 0 { length += 1 }
    return value[0..length]
}

fn modifiers(codemap: *Codemap) -> u32 { return panelOf(codemap).*.keyboard.depressed | codemap.*.held }

// Modifier keys as they go down and up (a compositor may send their state
// late or not at all to a window that just got the keyboard).
fn trackModifier(codemap: *Codemap, code: u32, pressed: bool) -> void {
    var bit: u32 = 0
    if code == KEY_LEFT_SHIFT || code == KEY_RIGHT_SHIFT { bit = SHIFT }
    if code == KEY_LEFT_CONTROL || code == KEY_RIGHT_CONTROL { bit = CONTROL }
    if code == KEY_LEFT_ALT || code == KEY_RIGHT_ALT { bit = ALT }
    if bit == 0 { return }
    codemap.*.held = if pressed { codemap.*.held | bit } else { codemap.*.held & ~bit }
}

fn setNote(codemap: *Codemap, first: []const u8, second: []const u8) -> void {
    codemap.*.noteLength = 0
    for byte in first {
        if codemap.*.noteLength < 160 {
            codemap.*.note[codemap.*.noteLength] = byte
            codemap.*.noteLength += 1
        }
    }
    for byte in second {
        if codemap.*.noteLength < 160 {
            codemap.*.note[codemap.*.noteLength] = byte
            codemap.*.noteLength += 1
        }
    }
    codemap.*.noteUntil = panel_module.milliseconds() + 4000
}

fn surfaceWidth(codemap: *Codemap) -> i32 { return @intCast(i32, panelOf(codemap).*.width) }
fn surfaceHeight(codemap: *Codemap) -> i32 { return @intCast(i32, panelOf(codemap).*.height) }
fn viewWidth(codemap: *Codemap) -> i32 { return surfaceWidth(codemap) - SIDEBAR }
fn viewHeight(codemap: *Codemap) -> i32 { return surfaceHeight(codemap) - TOOLBAR - STATUS }
fn detailOpen(codemap: *Codemap) -> bool { return codemap.*.built && (codemap.*.selected != NONE || codemap.*.finding != FINDING_NONE || codemap.*.rewritePattern != 255) }

fn analysisOf(codemap: *Codemap) -> *analysis_module.Analysis {
    unsafe { return @ptrCast(*analysis_module.Analysis, &codemap.*.analysis) }
}

fn crashesOf(codemap: *Codemap) -> *crashes_module.Crashes {
    unsafe { return @ptrCast(*crashes_module.Crashes, &codemap.*.crashes) }
}

fn workaroundsOf(codemap: *Codemap) -> *workarounds_module.Workarounds {
    unsafe { return @ptrCast(*workarounds_module.Workarounds, &codemap.*.workarounds) }
}

fn findingColor(finding: u8) -> u32 {
    if finding == FINDING_WORKAROUNDS { return WORKAROUND_COLOR }
    if finding == FINDING_CRASHES { return CRASH_COLOR }
    if finding == FINDING_UNREACHABLE { return UNREACHABLE_COLOR }
    if finding == FINDING_UNTESTED { return UNTESTED_COLOR }
    if finding == FINDING_COMPLEX { return COMPLEX_COLOR }
    if finding == FINDING_STRUCTURE { return STRUCTURE_COLOR }
    if finding == FINDING_RISKY { return RISKY_COLOR }
    if finding == FINDING_HOT { return HOT_COLOR }
    if finding == FINDING_CHANGED { return CHANGED_COLOR }
    return FINDING_COLOR
}

// The glow of a node marked by several findings: the most telling one.
fn markColor(bits: u16) -> u32 {
    if bits & 512 != 0 { return RISKY_COLOR }
    if bits & 1024 != 0 { return HOT_COLOR }
    if bits & 2048 != 0 { return CHANGED_COLOR }
    if bits & 128 != 0 { return COMPLEX_COLOR }
    if bits & 64 != 0 { return UNTESTED_COLOR }
    if bits & 32 != 0 { return UNREACHABLE_COLOR }
    if bits & 256 != 0 { return STRUCTURE_COLOR }
    if bits & 8 != 0 { return WORKAROUND_COLOR }
    return FINDING_COLOR
}

fn programsOf(codemap: *Codemap) -> *programs_module.Programs {
    unsafe { return @ptrCast(*programs_module.Programs, &codemap.*.programs) }
}

fn binariesOf(codemap: *Codemap) -> *binaries_module.Binaries {
    unsafe { return @ptrCast(*binaries_module.Binaries, &codemap.*.binaries) }
}

fn complexityOf(codemap: *Codemap) -> *complexity_module.Complexity {
    unsafe { return @ptrCast(*complexity_module.Complexity, &codemap.*.complexity) }
}

fn structureOf(codemap: *Codemap) -> *structure_module.Structure {
    unsafe { return @ptrCast(*structure_module.Structure, &codemap.*.structure) }
}

fn gitOf(codemap: *Codemap) -> *git_module.Git {
    unsafe { return @ptrCast(*git_module.Git, &codemap.*.git) }
}

fn historyOf(codemap: *Codemap) -> *history_module.History {
    unsafe { return @ptrCast(*history_module.History, &codemap.*.history) }
}

fn profilesOf(codemap: *Codemap) -> *profiles_module.Profiles {
    unsafe { return @ptrCast(*profiles_module.Profiles, &codemap.*.profiles) }
}

fn trendOf(codemap: *Codemap) -> *trend_module.Trend {
    unsafe { return @ptrCast(*trend_module.Trend, &codemap.*.trend) }
}

fn queryOf(codemap: *Codemap) -> *query_module.Query {
    unsafe { return @ptrCast(*query_module.Query, &codemap.*.query) }
}

fn viewsOf(codemap: *Codemap) -> *views_module.Views {
    unsafe { return @ptrCast(*views_module.Views, &codemap.*.views) }
}

fn diffOf(codemap: *Codemap) -> *diff_module.Diff {
    unsafe { return @ptrCast(*diff_module.Diff, &codemap.*.diff) }
}

fn measuresOf(codemap: *Codemap) -> *measures_module.Measures {
    unsafe { return @ptrCast(*measures_module.Measures, &codemap.*.measures) }
}

// Whether a program is chosen (else: all).
fn programChosen(codemap: *Codemap) -> bool { return codemap.*.program < programsOf(codemap).*.count }

// The measures, the programs and their binaries, worked out on a new
// index; the history (Git) starts over, read in ticks.
fn measureAll(codemap: *Codemap) -> void {
    const index = codemap.*.index
    const programs = programsOf(codemap)
    // The program shown, by name across a read again.
    var chosen: [256]u8 = undefined
    var chosen_bytes: [*]u8 = undefined
    unsafe { chosen_bytes = @ptrCast([*]u8, &chosen) }
    var chosen_length: usize = 0
    if codemap.*.built && programChosen(codemap) {
        for byte in programs_module.nameOf(programs, codemap.*.program) {
            if chosen_length < 256 {
                chosen_bytes[chosen_length] = byte
                chosen_length += 1
            }
        }
    }
    programs_module.run(programs, index)
    codemap.*.program = programs.*.count
    var program: usize = 0
    while program < programs.*.count && chosen_length > 0 {
        if index_module.sameBytes(programs_module.nameOf(programs, program), chosen_bytes[0..chosen_length]) { codemap.*.program = program }
        program += 1
    }
    // By name.
    program = 0
    while program < programs.*.count {
        const name = programs_module.nameOf(programs, program)
        var place = program
        while place > 0 && nameBefore(name, programs_module.nameOf(programs, @intCast(usize, codemap.*.programOrder[place - 1]))) {
            codemap.*.programOrder[place] = codemap.*.programOrder[place - 1]
            place -= 1
        }
        codemap.*.programOrder[place] = @intCast(u32, program)
        program += 1
    }
    var directories: [8192]u8 = undefined
    var directory_bytes: [*]u8 = undefined
    unsafe { directory_bytes = @ptrCast([*]u8, &directories) }
    const length = binaries_module.defaultDirectories(rootText(codemap), codemap.*.environment, directory_bytes)
    binaries_module.scan(binariesOf(codemap), index, programs, directory_bytes[0..length])
    chooseBinary(codemap)
    complexity_module.run(complexityOf(codemap), index)
    structure_module.run(structureOf(codemap), index)
    profiles_module.load(profilesOf(codemap), index, codemap.*.environment)
    loadTrend(codemap)
    runDiff(codemap)
    views_module.load(viewsOf(codemap), rootText(codemap))
    refreshChanges(codemap)
    history_module.start(historyOf(codemap), index)
    codemap.*.historyShown = 0
    const measures = measuresOf(codemap)
    measures.*.index = index
    measures.*.analysis = @intFromPtr(analysisOf(codemap))
    measures.*.workarounds = @intFromPtr(workaroundsOf(codemap))
    measures.*.crashes = @intFromPtr(crashesOf(codemap))
    measures.*.programs = @intFromPtr(programs)
    measures.*.binaries = @intFromPtr(binariesOf(codemap))
    measures.*.complexity = @intFromPtr(complexityOf(codemap))
    measures.*.history = @intFromPtr(historyOf(codemap))
    measures.*.profiles = @intFromPtr(profilesOf(codemap))
    if codemap.*.trace {
        var text: [96]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var at = writeNumberPlain(bytes, 0, programs.*.count)
        at = writeText(bytes, at, " programs, ")
        at = writeNumberPlain(bytes, at, binariesOf(codemap).*.count)
        at = writeText(bytes, at, " built")
        traceLine(codemap, "measured ", bytes[0..at])
    }
}

fn nameBefore(first: []const u8, second: []const u8) -> bool {
    var at: usize = 0
    while at < first.length && at < second.length {
        if first[at] != second[at] { return first[at] < second[at] }
        at += 1
    }
    return first.length < second.length
}

// The machine code of the program shown (its binary), else of all.
fn chooseBinary(codemap: *Codemap) -> void {
    const binaries = binariesOf(codemap)
    var binary = binaries_module.ALL
    if programChosen(codemap) {
        const built = binaries_module.binaryOf(binaries, codemap.*.program)
        if built < binaries.*.count { binary = built }
    }
    binaries_module.choose(binaries, binary)
}

// Shows one program (the programs' count: all).
fn chooseProgram(codemap: *Codemap, program: usize) -> void {
    codemap.*.program = program
    chooseBinary(codemap)
    refreshVisibility(codemap)
    computeMetric(codemap)
    if codemap.*.trace {
        traceLine(codemap, "program ", if programChosen(codemap) { programs_module.nameOf(programsOf(codemap), program) } else { "all" })
    }
    flyToShown(codemap)
}

// The workarounds at the last 20 commits, as far as they are kept (only
// mlx-codemap history works them out: it takes seconds a commit).
fn loadTrend(codemap: *Codemap) -> void {
    const trend = trendOf(codemap)
    trend_module.load(trend, gitOf(codemap), 20)
    if codemap.*.trace {
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeNumberPlain(bytes, 0, trend.*.count)
        length = writeText(bytes, length, " commits, counted ")
        length = writeNumberPlain(bytes, length, trend.*.count - trend_module.missing(trend))
        traceLine(codemap, "trend ", bytes[0..length])
    }
}

// What changed since the base: the finding Changed, and changed/added in
// queries.
fn runDiff(codemap: *Codemap) -> void {
    var base_bytes: [*]u8 = undefined
    unsafe { base_bytes = @ptrCast([*]u8, &codemap.*.diffBase) }
    const base = if codemap.*.diffBaseLength > 0 { base_bytes[0..codemap.*.diffBaseLength] } else { "HEAD" }
    const diff = diffOf(codemap)
    const ran = diff_module.run(diff, codemap.*.index, gitOf(codemap), base, "")
    if codemap.*.trace {
        var text: [128]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeText(bytes, 0, base)
        if ran {
            length = writeText(bytes, length, ": ")
            length = writeNumberPlain(bytes, length, diff.*.added)
            length = writeText(bytes, length, " added, ")
            length = writeNumberPlain(bytes, length, diff.*.changed)
            length = writeText(bytes, length, " changed, ")
            length = writeNumberPlain(bytes, length, diff.*.removedCount)
            length = writeText(bytes, length, " removed")
        } else {
            length = writeText(bytes, length, ": none")
        }
        traceLine(codemap, "diff since ", bytes[0..length])
    }
}

// Reads on in the history (a tick's worth); now and then, and when done,
// what depends on it is worked out again.
fn stepHistory(codemap: *Codemap) -> void {
    const history = historyOf(codemap)
    if history_module.finished(history) { return }
    const done = history_module.step(history, 25)
    const now = panel_module.milliseconds()
    if done || now >= codemap.*.historyCheckAt {
        codemap.*.historyCheckAt = now + 1500
        codemap.*.historyShown = history.*.done
        computeMetric(codemap)
        refreshFindings(codemap)
        panelOf(codemap).*.dirty = true
        if done && codemap.*.trace {
            var text: [64]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &text) }
            const length = writeNumberPlain(bytes, 0, history.*.total)
            traceLine(codemap, "history read, files ", bytes[0..length])
        }
    }
}

// The value of the metric colored by on every node: a declaration's own,
// a group's the sum of its members'; and the biggest of each class.
fn computeMetric(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    var node: usize = 0
    while node < graph.*.count {
        codemap.*.metricValues[node] = 0.0
        node += 1
    }
    var class: usize = 0
    while class < 3 {
        codemap.*.metricMax[class] = 0.0
        class += 1
    }
    if codemap.*.metric == measures_module.KIND || !codemap.*.built { return }
    const measures = measuresOf(codemap)
    node = 0
    while node < graph.*.count {
        const record = graph_module.nodeAt(graph, @intCast(u32, node))
        if record.*.kind == graph_module.DECLARATION {
            const value = measures_module.value(measures, codemap.*.metric, record.*.symbol)
            if value > 0 {
                const amount = m.toFloat(@intCast(i64, value))
                var current = @intCast(u32, node)
                while current != NONE {
                    codemap.*.metricValues[@intCast(usize, current)] += amount
                    current = graph_module.nodeAt(graph, current).*.parent
                }
            }
        }
        node += 1
    }
    node = 0
    while node < graph.*.count {
        const at = metricClass(codemap, @intCast(u32, node))
        if at < 3 && codemap.*.metricValues[node] > codemap.*.metricMax[at] { codemap.*.metricMax[at] = codemap.*.metricValues[node] }
        node += 1
    }
}

// 0: a declaration, 1: a file, 2: a group, 3: the root.
fn metricClass(codemap: *Codemap, node: u32) -> usize {
    const record = nodeOf(codemap, node)
    if record.*.kind == graph_module.DECLARATION { return 0 }
    if record.*.kind == graph_module.FILE { return 1 }
    if node == graphOf(codemap).*.root { return 3 }
    return 2
}

// A sphere's color: its kind's, or its value's on the heat scale (cold
// blue, violet, orange, hot yellow; grey without a value).
fn sphereColor(codemap: *Codemap, node: u32) -> u32 {
    const record = nodeOf(codemap, node)
    if codemap.*.metric == measures_module.KIND { return record.*.color }
    const value = codemap.*.metricValues[@intCast(usize, node)]
    const class = metricClass(codemap, node)
    if value <= 0.0 || class >= 3 { return 4282928218 }
    const most = codemap.*.metricMax[class]
    var share: f64 = 1.0
    if most > 0.0 { share = m.ln(value + 1.0) / m.ln(most + 1.0) }
    return heatColor(share)
}

fn heatColor(share: f64) -> u32 {
    // Stops at 0, 1/3, 2/3 and 1.
    var t = share
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    var r0: f64 = 70.0
    var g0: f64 = 110.0
    var b0: f64 = 220.0
    var r1: f64 = 180.0
    var g1: f64 = 80.0
    var b1: f64 = 220.0
    var local: f64 = t * 3.0
    if t > 0.6666 {
        r0 = 255.0
        g0 = 140.0
        b0 = 60.0
        r1 = 255.0
        g1 = 235.0
        b1 = 110.0
        local = t * 3.0 - 2.0
    } else if t > 0.3333 {
        r0 = 180.0
        g0 = 80.0
        b0 = 220.0
        r1 = 255.0
        g1 = 140.0
        b1 = 60.0
        local = t * 3.0 - 1.0
    }
    const r = m.toInt(r0 + (r1 - r0) * local)
    const g = m.toInt(g0 + (g1 - g0) * local)
    const b = m.toInt(b0 + (b1 - b0) * local)
    return 4278190080 | (@intCast(u32, r) << 16) | (@intCast(u32, g) << 8) | @intCast(u32, b)
}

// The crash log's path (into 4096 bytes); its length, 0: none.
fn crashLogPath(codemap: *Codemap, into: [*]u8) -> usize {
    return crashes_module.logPath(codemap.*.environment, into)
}

// When the profiles' directory last changed (-1: there is none).
fn profilesTime(codemap: *Codemap) -> isize {
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    if profiles_module.directory(codemap.*.environment, bytes) == 0 { return -1 }
    var status: std.fs.Stat = undefined
    if std.fs.status(bytes, &status) != 0 { return -1 }
    return status.modifiedSeconds * 1000 + status.modifiedNanoseconds / 1000000
}

// The crash log's size (-1: there is none).
fn crashLogSize(codemap: *Codemap) -> isize {
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    if crashLogPath(codemap, bytes) == 0 { return -1 }
    var status: std.fs.Stat = undefined
    if std.fs.status(bytes, &status) != 0 { return -1 }
    return status.size
}

// Reads the crash log again and flags the nodes the crashes went through
// (and what holds them).
fn loadCrashes(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    const crashes = crashesOf(codemap)
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    codemap.*.crashLogSize = crashLogSize(codemap)
    if crashLogPath(codemap, bytes) == 0 { bytes[0] = 0 }
    crashes_module.load(crashes, codemap.*.index, bytes)
    codemap.*.crashedCount = 0
    var node: usize = 0
    while node < graph.*.count {
        codemap.*.crashMark[node] = 0
        node += 1
    }
    node = 0
    while node < graph.*.count {
        const record = graph_module.nodeAt(graph, @intCast(u32, node))
        if record.*.kind == graph_module.DECLARATION && crashes_module.latestOf(crashes, record.*.symbol) != NONE {
            codemap.*.crashMark[node] = if crashes_module.stoppedIn(crashes, record.*.symbol) > 0 { 2 } else { 1 }
            codemap.*.crashedCount += 1
            var parent = record.*.parent
            while parent != NONE && codemap.*.crashMark[@intCast(usize, parent)] == 0 {
                codemap.*.crashMark[@intCast(usize, parent)] = 3
                parent = graph_module.nodeAt(graph, parent).*.parent
            }
        }
        node += 1
    }
    if codemap.*.trace {
        var text: [96]u8 = undefined
        var trace_bytes: [*]u8 = undefined
        unsafe { trace_bytes = @ptrCast([*]u8, &text) }
        var length = writeNumberPlain(trace_bytes, 0, crashes.*.count)
        length = writeText(trace_bytes, length, " kept, on ")
        length = writeNumberPlain(trace_bytes, length, codemap.*.crashedCount)
        length = writeText(trace_bytes, length, " declarations")
        traceLine(codemap, "crashes ", trace_bytes[0..length])
    }
}

// The node of an index symbol (NONE: not shown).
fn nodeOfSymbol(codemap: *Codemap, symbol: u32) -> u32 {
    if symbol == NONE { return NONE }
    return graphOf(codemap).*.nodeOfSymbol[@intCast(usize, symbol)]
}

fn findingEntryKind(entry: u32) -> u8 { return @intCast(u8, entry >> 24) }
fn findingEntryGroup(entry: u32) -> usize { return @intCast(usize, entry & 16777215) }

// Opens a list of findings (FINDING_NONE: closes it); what it lists is
// shown in space too.
fn openFinding(codemap: *Codemap, finding: u8) -> void {
    codemap.*.finding = finding
    codemap.*.detailScroll = 0
    var at: usize = 0
    while at < 12 {
        codemap.*.expanded[at] = false
        at += 1
    }
    if finding != FINDING_NONE { codemap.*.findingOn[@intCast(usize, finding)] = true }
    refreshFindings(codemap)
}

// ---------------------------------------------------------------------------
// What the sidebar's check boxes leave out

fn isHidden(codemap: *Codemap, node: u32) -> bool {
    return node == NONE || hiddenAt(codemap, @intCast(usize, node))
}

// Left out: by a check box or a kind (1), not reached by the program
// shown (4), or not answering the query in the search (8).
fn hiddenAt(codemap: *Codemap, node: usize) -> bool {
    const state = codemap.*.hidden[node]
    return state == 1 || state == 4 || state == 8
}

// Whether an index symbol's node is shown.
fn symbolShown(codemap: *Codemap, symbol: u32) -> bool {
    return !isHidden(codemap, nodeOfSymbol(codemap, symbol))
}

// Works out what is left out: a node taken out, or inside one, or of a
// kind left out; and what is shown with something inside left out.
fn refreshVisibility(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    codemap.*.anyOff = false
    var node: usize = 0
    while node < graph.*.count {
        var hidden: u8 = 0
        var current = @intCast(u32, node)
        while current != NONE {
            const record = graph_module.nodeAt(graph, current)
            if codemap.*.off[@intCast(usize, current)] != 0 { hidden = 1 }
            if record.*.kind == graph_module.DECLARATION && codemap.*.kindOff[@intCast(usize, record.*.symbolKind)] { hidden = 1 }
            if hidden != 0 { break }
            current = record.*.parent
        }
        codemap.*.hidden[node] = hidden
        if codemap.*.off[node] != 0 { codemap.*.anyOff = true }
        node += 1
    }
    // A program shown: what it does not reach is left out, and what holds
    // nothing it reaches.
    if programChosen(codemap) {
        const programs = programsOf(codemap)
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 && !programs_module.reaches(programs, codemap.*.program, record.*.symbol) { codemap.*.hidden[node] = 4 }
            node += 1
        }
        // Mark (3) what holds something shown, then leave out the rest.
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 {
                var parent = record.*.parent
                while parent != NONE && codemap.*.hidden[@intCast(usize, parent)] == 0 {
                    codemap.*.hidden[@intCast(usize, parent)] = 3
                    parent = graph_module.nodeAt(graph, parent).*.parent
                }
            }
            node += 1
        }
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind != graph_module.DECLARATION && codemap.*.hidden[node] == 0 && @intCast(u32, node) != graph.*.root { codemap.*.hidden[node] = 4 }
            if codemap.*.hidden[node] == 3 { codemap.*.hidden[node] = 0 }
            node += 1
        }
    }
    // A query: what does not answer it is left out, and what holds
    // nothing that does.
    updateQuery(codemap)
    if codemap.*.queryActive {
        const query = queryOf(codemap)
        codemap.*.queryCount = 0
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 {
                if query_module.matches(query, record.*.symbol) { codemap.*.queryCount += 1 } else { codemap.*.hidden[node] = 8 }
            }
            node += 1
        }
        // Mark (3) what holds an answer (a struct that does not answer
        // itself is shown for its members that do).
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 {
                var parent = record.*.parent
                while parent != NONE && (codemap.*.hidden[@intCast(usize, parent)] == 0 || codemap.*.hidden[@intCast(usize, parent)] == 8) {
                    codemap.*.hidden[@intCast(usize, parent)] = 3
                    parent = graph_module.nodeAt(graph, parent).*.parent
                }
            }
            node += 1
        }
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind != graph_module.DECLARATION && codemap.*.hidden[node] == 0 && @intCast(u32, node) != graph.*.root { codemap.*.hidden[node] = 8 }
            if codemap.*.hidden[node] == 3 { codemap.*.hidden[node] = 0 }
            node += 1
        }
        if codemap.*.trace {
            var text: [320]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &text) }
            var length = writeText(bytes, 0, searchText(codemap))
            length = writeText(bytes, length, ": ")
            length = writeNumberPlain(bytes, length, codemap.*.queryCount)
            length = writeText(bytes, length, " declarations")
            traceLine(codemap, "query ", bytes[0..length])
        }
    }
    node = 0
    while node < graph.*.count {
        if codemap.*.off[node] != 0 {
            var parent = graph_module.nodeAt(graph, @intCast(u32, node)).*.parent
            while parent != NONE && codemap.*.hidden[@intCast(usize, parent)] == 0 {
                codemap.*.hidden[@intCast(usize, parent)] = 2
                parent = graph_module.nodeAt(graph, parent).*.parent
            }
        }
        node += 1
    }
    refreshFindings(codemap)
    runSearch(codemap)
    panelOf(codemap).*.dirty = true
    if codemap.*.trace {
        var text: [128]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var shown: usize = 0
        node = 0
        while node < graph.*.count {
            if !hiddenAt(codemap, node) { shown += 1 }
            node += 1
        }
        var length = writeNumberPlain(bytes, 0, shown)
        length = writeText(bytes, length, " nodes, findings")
        var finding: usize = 0
        while finding < FINDINGS {
            length = writeText(bytes, length, " ")
            length = writeNumberPlain(bytes, length, codemap.*.findingCounts[finding])
            finding += 1
        }
        traceLine(codemap, "shown ", bytes[0..length])
    }
}

// A group's check box: 1 shown, 2 shown with something inside left out,
// 0 left out.
fn checkState(codemap: *Codemap, node: u32) -> u8 {
    if node == graphOf(codemap).*.root {
        if !codemap.*.anyOff { return 1 }
        var child = nodeOf(codemap, node).*.firstChild
        while child != NONE {
            if codemap.*.hidden[@intCast(usize, child)] != 1 { return 2 }
            child = nodeOf(codemap, child).*.nextSibling
        }
        return 0
    }
    const hidden = codemap.*.hidden[@intCast(usize, node)]
    if hidden == 1 { return 0 }
    if hidden == 2 { return 2 }
    return 1
}

// Whether `node` is `ancestor` or inside it.
fn isInside(codemap: *Codemap, node: u32, ancestor: u32) -> bool {
    var current = node
    while current != NONE {
        if current == ancestor { return true }
        current = nodeOf(codemap, current).*.parent
    }
    return false
}

// A click on a group's check box. Everything: all, or (when all is
// shown) nothing. A group left out: shown, and only it where what holds
// it was left out. Shown in part: all of it. Shown: left out.
fn toggleGroup(codemap: *Codemap, node: u32) -> void {
    const graph = graphOf(codemap)
    if node == graph.*.root {
        const show_all = codemap.*.anyOff
        var at: usize = 0
        while at < graph.*.count {
            codemap.*.off[at] = 0
            at += 1
        }
        if !show_all {
            var child = nodeOf(codemap, node).*.firstChild
            while child != NONE {
                codemap.*.off[@intCast(usize, child)] = 1
                child = nodeOf(codemap, child).*.nextSibling
            }
        }
    } else {
        const state = checkState(codemap, node)
        if state == 1 {
            codemap.*.off[@intCast(usize, node)] = 1
        } else if state == 2 {
            var at: usize = 0
            while at < graph.*.count {
                if codemap.*.off[at] != 0 && isInside(codemap, @intCast(u32, at), node) { codemap.*.off[at] = 0 }
                at += 1
            }
        } else {
            // From the top down: what is taken out on the way comes back,
            // with only the way in it.
            var path: [48]u32 = undefined
            var count: usize = 0
            var current = node
            while current != NONE && count < 48 {
                path[count] = current
                count += 1
                current = nodeOf(codemap, current).*.parent
            }
            var at = count
            while at > 0 {
                at -= 1
                const step = path[at]
                if codemap.*.off[@intCast(usize, step)] != 0 {
                    codemap.*.off[@intCast(usize, step)] = 0
                    if at > 0 {
                        var child = nodeOf(codemap, step).*.firstChild
                        while child != NONE {
                            if child != path[at - 1] { codemap.*.off[@intCast(usize, child)] = 1 }
                            child = nodeOf(codemap, child).*.nextSibling
                        }
                    }
                }
            }
        }
    }
    refreshVisibility(codemap)
    // What was selected and is left out now is not selected any more.
    if codemap.*.selected != NONE && isHidden(codemap, codemap.*.selected) { select(codemap, NONE) }
    flyToShown(codemap)
}

// The smallest group holding everything shown: down from the top while
// only one group is shown in it.
fn shownGroup(codemap: *Codemap) -> u32 {
    var group = graphOf(codemap).*.root
    while true {
        var only = NONE
        var shown: usize = 0
        var child = nodeOf(codemap, group).*.firstChild
        while child != NONE {
            if !isHidden(codemap, child) {
                shown += 1
                only = child
            }
            child = nodeOf(codemap, child).*.nextSibling
        }
        if shown != 1 || nodeOf(codemap, only).*.kind != graph_module.DIRECTORY { return group }
        group = only
    }
    return group
}

// After the check boxes changed: the camera flies to what is shown (not
// when nothing is).
fn flyToShown(codemap: *Codemap) -> void {
    const root = graphOf(codemap).*.root
    var any = false
    var child = nodeOf(codemap, root).*.firstChild
    while child != NONE && !any {
        if !isHidden(codemap, child) { any = true }
        child = nodeOf(codemap, child).*.nextSibling
    }
    if !any { return }
    const group = shownGroup(codemap)
    if codemap.*.trace {
        var key: [1024]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &key) }
        const length = keyOf(codemap, group, bytes)
        traceLine(codemap, "flying to ", bytes[0..length])
    }
    flyTo(codemap, group)
}

// The legend's kinds, in the order drawn (Struct/Union is one).
fn legendKind(index: usize) -> u8 {
    if index == 0 { return index_module.FUNCTION }
    if index == 1 { return index_module.STRUCT }
    if index == 2 { return index_module.ENUM }
    if index == 3 { return index_module.CONST }
    if index == 4 { return index_module.VAR }
    if index == 5 { return index_module.FIELD }
    return index_module.TEST
}

fn toggleKind(codemap: *Codemap, index: usize) -> void {
    const kind = @intCast(usize, legendKind(index))
    const off = !codemap.*.kindOff[kind]
    codemap.*.kindOff[kind] = off
    if kind == @intCast(usize, index_module.STRUCT) { codemap.*.kindOff[@intCast(usize, index_module.UNION)] = off }
    refreshVisibility(codemap)
}

// Whether a crash went through something shown (one that names nothing
// here: while nothing is left out).
fn recordShown(codemap: *Codemap, record: u32) -> bool {
    const crashes = crashesOf(codemap)
    var frame = crashes_module.firstFrame(crashes, record)
    var named = false
    while frame < crashes.*.frameCount && crashes.*.frameRecord[frame] == record {
        const node = nodeOfSymbol(codemap, crashes.*.frameSymbol[frame])
        if node != NONE {
            named = true
            if !isHidden(codemap, node) { return true }
        }
        frame += 1
    }
    return !named && !codemap.*.anyOff
}

fn groupShown(codemap: *Codemap, kind: u8, group: usize) -> bool {
    for symbol in analysis_module.groupMembers(analysisOf(codemap), kind, group) {
        if symbolShown(codemap, symbol) { return true }
    }
    return false
}

fn markGroup(codemap: *Codemap, kind: u8, group: usize, bit: u16) -> void {
    for symbol in analysis_module.groupMembers(analysisOf(codemap), kind, group) {
        const node = nodeOfSymbol(codemap, symbol)
        if node != NONE { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | bit }
    }
}

// Counts what each finding shows, marks the nodes of the findings checked
// (a bit each), picks the groups joined in space, and lists the open one.
fn refreshFindings(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    var at: usize = 0
    while at < graph.*.count {
        codemap.*.findingMark[at] = 0
        at += 1
    }
    codemap.*.findingCount = 0
    codemap.*.lineGroupCount = 0
    at = 0
    while at < FINDINGS {
        codemap.*.findingCounts[at] = 0
        at += 1
    }
    if !codemap.*.built { return }
    const analysis = analysisOf(codemap)
    const ranked = graph.*.order
    // Copies (exact, then by shape) and names, heaviest first.
    var finding: u8 = FINDING_COPIES
    while finding <= FINDING_NAMES {
        var kinds: [2]u8 = [2]u8{ analysis_module.COPIES, analysis_module.SHAPES }
        if finding == FINDING_NAMES {
            kinds[0] = analysis_module.NAMES
            kinds[1] = 255
        }
        const index = @intCast(usize, finding)
        const bit = @intCast(u16, 1) << @intCast(u16, finding)
        for kind in kinds {
            if kind == 255 { continue }
            const count = analysis_module.ranked(analysis, kind, ranked)
            var group: usize = 0
            while group < count {
                const which = @intCast(usize, ranked[group])
                if groupShown(codemap, kind, which) {
                    const entry = (@intCast(u32, kind) << 24) | @intCast(u32, which)
                    codemap.*.findingCounts[index] += 1
                    if codemap.*.findingOn[index] {
                        markGroup(codemap, kind, which, bit)
                        if codemap.*.lineGroupCount < LINE_GROUPS {
                            codemap.*.lineGroups[codemap.*.lineGroupCount] = entry
                            codemap.*.lineGroupCount += 1
                        }
                    }
                    if codemap.*.finding == finding {
                        codemap.*.findingOrder[codemap.*.findingCount] = entry
                        codemap.*.findingCount += 1
                    }
                }
                group += 1
            }
        }
        finding += 1
    }
    // Unused declarations.
    at = 0
    while at < analysis.*.unusedCount {
        const symbol = analysis.*.unused[at]
        const node = nodeOfSymbol(codemap, symbol)
        if node != NONE && !isHidden(codemap, node) {
            codemap.*.findingCounts[@intCast(usize, FINDING_UNUSED)] += 1
            if codemap.*.findingOn[@intCast(usize, FINDING_UNUSED)] { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | 4 }
            if codemap.*.finding == FINDING_UNUSED {
                codemap.*.findingOrder[codemap.*.findingCount] = symbol
                codemap.*.findingCount += 1
            }
        }
        at += 1
    }
    // Workarounds: the places of the kinds checked, in what is shown.
    const workarounds = workaroundsOf(codemap)
    var pattern: usize = 0
    var mask: u16 = 0
    while pattern < workarounds_module.PATTERNS {
        codemap.*.patternPlaces[pattern] = 0
        if codemap.*.patternOn[pattern] { mask = mask | (@intCast(u16, 1) << @intCast(u16, pattern)) }
        pattern += 1
    }
    at = 0
    while at < workarounds.*.count {
        if workarounds.*.symbol[at] != NONE && symbolShown(codemap, workarounds.*.symbol[at]) { codemap.*.patternPlaces[@intCast(usize, workarounds.*.pattern[at])] += 1 }
        at += 1
    }
    pattern = 0
    while pattern < workarounds_module.PATTERNS {
        if codemap.*.patternOn[pattern] { codemap.*.findingCounts[@intCast(usize, FINDING_WORKAROUNDS)] += codemap.*.patternPlaces[pattern] }
        pattern += 1
    }
    if codemap.*.findingOn[@intCast(usize, FINDING_WORKAROUNDS)] {
        at = 0
        while at < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, at))
            if record.*.kind == graph_module.DECLARATION && workarounds_module.marksOf(workarounds, record.*.symbol) & mask != 0 { codemap.*.findingMark[at] = codemap.*.findingMark[at] | 8 }
            at += 1
        }
    }
    if codemap.*.finding == FINDING_WORKAROUNDS {
        at = 0
        while at < codemap.*.patternCount {
            const kind = codemap.*.patternOrder[at]
            if codemap.*.patternOn[@intCast(usize, kind)] && codemap.*.patternPlaces[@intCast(usize, kind)] > 0 {
                codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, kind)
                codemap.*.findingCount += 1
            }
            at += 1
        }
    }
    // Dead code, untested, complex, risky and hot functions.
    listSymbols(codemap, FINDING_UNREACHABLE)
    listSymbols(codemap, FINDING_UNTESTED)
    listSymbols(codemap, FINDING_COMPLEX)
    listSymbols(codemap, FINDING_RISKY)
    listSymbols(codemap, FINDING_HOT)
    listSymbols(codemap, FINDING_CHANGED)
    listStructure(codemap)
    // Crashes, newest first.
    const crashes = crashesOf(codemap)
    var record = crashes.*.count
    while record > 0 {
        record -= 1
        if recordShown(codemap, @intCast(u32, record)) {
            codemap.*.findingCounts[@intCast(usize, FINDING_CRASHES)] += 1
            if codemap.*.finding == FINDING_CRASHES {
                codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, record)
                codemap.*.findingCount += 1
            }
        }
    }
}

// Whether `symbol` is one of the finding's (0: no), and its weight (most
// first; 1 and more).
fn findingWeight(codemap: *Codemap, finding: u8, symbol: u32) -> u64 {
    if finding == FINDING_UNREACHABLE {
        if !programs_module.isUnreachable(programsOf(codemap), symbol) || binaries_module.bytesOf(binariesOf(codemap), symbol) != 0 { return 0 }
        return 1 + @intCast(u64, complexity_module.tokensOf(complexityOf(codemap), symbol))
    }
    if finding == FINDING_UNTESTED {
        if !programs_module.isUntested(programsOf(codemap), symbol) { return 0 }
        return 1 + @intCast(u64, complexity_module.scoreOf(complexityOf(codemap), symbol))
    }
    if finding == FINDING_COMPLEX {
        if !complexity_module.isComplex(complexityOf(codemap), symbol) { return 0 }
        return 1 + @intCast(u64, complexity_module.scoreOf(complexityOf(codemap), symbol))
    }
    if finding == FINDING_RISKY {
        const risk = measures_module.risk(measuresOf(codemap), symbol)
        return if risk >= measures_module.RISKY { risk } else { 0 }
    }
    if finding == FINDING_HOT { return @intCast(u64, profiles_module.totalOf(profilesOf(codemap), symbol)) }
    if finding == FINDING_CHANGED {
        const state = diff_module.stateOf(diffOf(codemap), symbol)
        if state == diff_module.ADDED { return 2 }
        if state == diff_module.CHANGED { return 1 }
    }
    return 0
}

// A finding made of functions: counts the shown, marks them when checked,
// lists them (most first) when open.
fn listSymbols(codemap: *Codemap, finding: u8) -> void {
    const index = codemap.*.index
    const on = codemap.*.findingOn[@intCast(usize, finding)]
    const open = codemap.*.finding == finding
    const bit = @intCast(u16, 1) << @intCast(u16, finding)
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const kind = index_module.symbolAt(index, id).*.kind
        if kind == index_module.FUNCTION || (finding == FINDING_CHANGED && query_module.isDeclaration(kind)) {
            const weight = findingWeight(codemap, finding, id)
            if weight > 0 {
                const node = nodeOfSymbol(codemap, id)
                if node != NONE && !isHidden(codemap, node) {
                    codemap.*.findingCounts[@intCast(usize, finding)] += 1
                    if on { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | bit }
                    if open {
                        codemap.*.sortKeys[count] = (@intCast(u64, 4294967295 - (if weight > 4294967295 { 4294967295 } else { weight })) << 32) | @intCast(u64, symbol)
                        count += 1
                    }
                }
            }
        }
        symbol += 1
    }
    if !open { return }
    sortKeys(codemap.*.sortKeys, count)
    var at: usize = 0
    while at < count {
        codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, codemap.*.sortKeys[at] & 4294967295)
        codemap.*.findingCount += 1
        at += 1
    }
}

fn sortKeys(values: [*]u64, count: usize) -> void {
    var gap = count / 2
    while gap > 0 {
        var at = gap
        while at < count {
            const value = values[at]
            var place = at
            while place >= gap && values[place - gap] > value {
                values[place] = values[place - gap]
                place -= gap
            }
            values[place] = value
            at += 1
        }
        gap /= 2
    }
}

fn fileNode(codemap: *Codemap, file: u32) -> u32 {
    return nodeOfSymbol(codemap, index_module.fileAt(codemap.*.index, file).*.symbol)
}

// Cycles of imports and imports against the rules: an entry each (a
// cycle, or 1 << 31 and the broken import), shown when a file of it is.
fn listStructure(codemap: *Codemap) -> void {
    const structure = structureOf(codemap)
    const on = codemap.*.findingOn[@intCast(usize, FINDING_STRUCTURE)]
    const open = codemap.*.finding == FINDING_STRUCTURE
    var cycle: usize = 0
    while cycle < structure.*.cycleCount {
        var shown = false
        for file in structure_module.cycleMembers(structure, cycle) {
            const node = fileNode(codemap, file)
            if node != NONE && !isHidden(codemap, node) { shown = true }
        }
        if shown {
            codemap.*.findingCounts[@intCast(usize, FINDING_STRUCTURE)] += 1
            if on {
                for file in structure_module.cycleMembers(structure, cycle) {
                    const node = fileNode(codemap, file)
                    if node != NONE { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | 256 }
                }
            }
            if open {
                codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, cycle)
                codemap.*.findingCount += 1
            }
        }
        cycle += 1
    }
    var broken: usize = 0
    while broken < structure.*.brokenCount {
        const import = @intCast(usize, structure.*.broken[broken])
        const from = fileNode(codemap, structure.*.importFrom[import])
        if from != NONE && !isHidden(codemap, from) {
            codemap.*.findingCounts[@intCast(usize, FINDING_STRUCTURE)] += 1
            if on { codemap.*.findingMark[@intCast(usize, from)] = codemap.*.findingMark[@intCast(usize, from)] | 256 }
            if open {
                codemap.*.findingOrder[codemap.*.findingCount] = 2147483648 | @intCast(u32, broken)
                codemap.*.findingCount += 1
            }
        }
        broken += 1
    }
}

fn findingSize(codemap: *Codemap, finding: u8) -> usize {
    return codemap.*.findingCounts[@intCast(usize, finding)]
}

fn detailX(codemap: *Codemap) -> i32 { return surfaceWidth(codemap) - DETAIL }

fn inside(x: i32, y: i32, left: i32, top: i32, width: i32, height: i32) -> bool {
    return x >= left && x < left + width && y >= top && y < top + height
}

// ---------------------------------------------------------------------------
// Numbers and text

fn writeText(out: [*]u8, at: usize, text: []const u8) -> usize {
    var length = at
    for byte in text {
        out[length] = byte
        length += 1
    }
    return length
}

// `value` in digits, thousands apart (German: 1.234, English: 1,234).
fn writeNumber(codemap: *Codemap, out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var length = at
    while count > 0 {
        count -= 1
        out[length] = digits[count]
        length += 1
        if count > 0 && count % 3 == 0 {
            out[length] = if codemap.*.german { 46 } else { 44 }
            length += 1
        }
    }
    return length
}

fn kindLabel(codemap: *Codemap, node: u32) -> []const u8 {
    const record = nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return say(codemap, "Group", "Gruppe") }
    if record.*.kind == graph_module.FILE { return say(codemap, "File", "Datei") }
    const kind = record.*.symbolKind
    if kind == index_module.STRUCT { return "Struct" }
    if kind == index_module.ENUM { return "Enum" }
    if kind == index_module.UNION { return "Union" }
    if kind == index_module.ERROR_SET { return say(codemap, "Error set", "Fehlermenge") }
    if kind == index_module.FIELD { return say(codemap, "Field", "Feld") }
    if kind == index_module.MEMBER { return say(codemap, "Member", "Element") }
    if kind == index_module.FUNCTION { return say(codemap, "Function", "Funktion") }
    if kind == index_module.CONST { return say(codemap, "Constant", "Konstante") }
    if kind == index_module.VAR { return "Variable" }
    if kind == index_module.TEST { return "Test" }
    return say(codemap, "Declaration", "Deklaration")
}

// A lighter or darker color (factor in 1/256).
fn shaded(color: u32, factor: u32) -> u32 {
    var red = ((color >> 16) & 255) * factor / 256
    var green = ((color >> 8) & 255) * factor / 256
    var blue = (color & 255) * factor / 256
    if red > 255 { red = 255 }
    if green > 255 { green = 255 }
    if blue > 255 { blue = 255 }
    return (color & 4278190080) | (red << 16) | (green << 8) | blue
}

// `color` (opaque) with alpha `alpha` (straight, for the scene).
fn withAlpha(color: u32, alpha: u32) -> u32 { return (color & 16777215) | ((if alpha > 255 { 255 } else { alpha }) << 24) }

// The same, premultiplied (for the canvas).
fn canvasColor(color: u32, alpha: u32) -> u32 { return canvas_module.premultiplied(withAlpha(color, alpha)) }

// ---------------------------------------------------------------------------
// Reading the code

fn buildIndex(codemap: *Codemap) -> void {
    const started = panel_module.milliseconds()
    const root = rootText(codemap)
    if !codemap.*.hasIndex {
        codemap.*.index = index_module.create(root)
        codemap.*.hasIndex = true
    } else {
        index_module.reset(codemap.*.index, root)
    }
    index_module.addTree(codemap.*.index, root)
    var disk_count: usize = 0
    codemap.*.diskStamp = readDiskStamp(codemap, &disk_count)
    codemap.*.diskCount = disk_count
    codemap.*.diskSeenStamp = codemap.*.diskStamp
    codemap.*.diskSeenCount = disk_count
    index_module.build(codemap.*.index)
    graph_module.build(graphOf(codemap), codemap.*.index, root)
    analysis_module.run(analysisOf(codemap), codemap.*.index)
    workarounds_module.run(workaroundsOf(codemap), codemap.*.index)
    loadCrashes(codemap)
    var patterns: [9]u8 = undefined
    var pattern_bytes: [*]u8 = undefined
    unsafe { pattern_bytes = @ptrCast([*]u8, &patterns) }
    codemap.*.patternCount = workarounds_module.ranked(workaroundsOf(codemap), pattern_bytes)
    var pattern: usize = 0
    while pattern < codemap.*.patternCount {
        codemap.*.patternOrder[pattern] = patterns[pattern]
        pattern += 1
    }
    measureAll(codemap)
    codemap.*.built = true
    computeMetric(codemap)
    refreshVisibility(codemap)
    codemap.*.buildMilliseconds = panel_module.milliseconds() - started
    if codemap.*.trace {
        var text: [96]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeNumberPlain(bytes, 0, codemap.*.index.*.fileCount)
        length = writeText(bytes, length, " files, ")
        length = writeNumberPlain(bytes, length, graphOf(codemap).*.count)
        length = writeText(bytes, length, " nodes, ")
        length = writeNumberPlain(bytes, length, graphOf(codemap).*.importCount)
        length = writeText(bytes, length, " imports")
        traceLine(codemap, "read ", bytes[0..length])
    }
    var at: usize = 0
    while at < graph_module.MAX_NODES {
        codemap.*.related[at] = 0
        codemap.*.matches[at] = 0
        at += 1
    }
}

// A node's name for finding it again after the code is read again: its
// path in the tree ("examples/mlx-files/main.mlx/Files/scroll").
fn keyOf(codemap: *Codemap, node: u32, out: [*]u8) -> usize {
    if node == NONE { return 0 }
    var chain: [48]u32 = undefined
    var count: usize = 0
    var current = node
    while current != NONE && count < 48 {
        chain[count] = current
        count += 1
        current = nodeOf(codemap, current).*.parent
    }
    var length: usize = 0
    while count > 0 {
        count -= 1
        const name = nameOf(codemap, chain[count])
        if length + name.length + 1 < 1024 {
            length = writeText(out, length, name)
            out[length] = 47
            length += 1
        }
    }
    return length
}

fn findKey(codemap: *Codemap, key: []const u8) -> u32 {
    if key.length == 0 { return NONE }
    var buffer: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var node: usize = 0
    while node < graphOf(codemap).*.count {
        const length = keyOf(codemap, @intCast(u32, node), bytes)
        if length == key.length && sameBytes(bytes[0..length], key) { return @intCast(u32, node) }
        node += 1
    }
    return NONE
}

// Reads the code again, keeping what is selected and what the camera is on.
fn reload(codemap: *Codemap) -> void {
    var selected_key: [1024]u8 = undefined
    var focus_key: [1024]u8 = undefined
    var selected_bytes: [*]u8 = undefined
    var focus_bytes: [*]u8 = undefined
    unsafe {
        selected_bytes = @ptrCast([*]u8, &selected_key)
        focus_bytes = @ptrCast([*]u8, &focus_key)
    }
    const selected_length = keyOf(codemap, codemap.*.selected, selected_bytes)
    const focus_length = keyOf(codemap, codemap.*.focus, focus_bytes)
    // What the sidebar left out, by name (the nodes are made again).
    var off_keys: [16384]u8 = undefined
    var off_bytes: [*]u8 = undefined
    unsafe { off_bytes = @ptrCast([*]u8, &off_keys) }
    var off_starts: [33]usize = undefined
    var off_count: usize = 0
    off_starts[0] = 0
    const graph = graphOf(codemap)
    var node: usize = 0
    while node < graph.*.count && off_count < 32 {
        if codemap.*.off[node] != 0 {
            var key: [1024]u8 = undefined
            var key_bytes: [*]u8 = undefined
            unsafe { key_bytes = @ptrCast([*]u8, &key) }
            const length = keyOf(codemap, @intCast(u32, node), key_bytes)
            if off_starts[off_count] + length <= 16384 {
                var at: usize = 0
                while at < length {
                    off_bytes[off_starts[off_count] + at] = key_bytes[at]
                    at += 1
                }
                off_starts[off_count + 1] = off_starts[off_count] + length
                off_count += 1
            }
        }
        codemap.*.off[node] = 0
        node += 1
    }
    while node < graph.*.count {
        codemap.*.off[node] = 0
        node += 1
    }
    buildIndex(codemap)
    var restored: usize = 0
    while restored < off_count {
        const found = findKey(codemap, off_bytes[off_starts[restored]..off_starts[restored + 1]])
        if found != NONE { codemap.*.off[@intCast(usize, found)] = 1 }
        restored += 1
    }
    if off_count > 0 { refreshVisibility(codemap) }
    codemap.*.backCount = 0
    codemap.*.forwardCount = 0
    codemap.*.hoverNode = NONE
    codemap.*.focus = findKey(codemap, focus_bytes[0..focus_length])
    if codemap.*.focus == NONE { codemap.*.focus = graphOf(codemap).*.root }
    setSelected(codemap, findKey(codemap, selected_bytes[0..selected_length]))
    runSearch(codemap)
    if codemap.*.trace { traceLine(codemap, "read again", "") }
    // The tabs: their files in the new index (the text of one not edited
    // since it was saved is the index's).
    codemap.*.stale = false
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = editorAt(codemap, tab)
        codemap.*.tabFile[tab] = fileOfPath(codemap, editor_module.pathOf(editor))
        computeMarks(codemap, tab)
        // The index read the file as the tab has it (unless it is edited).
        codemap.*.tabIndexed[tab] = if editor_module.isDirty(editor) { 18446744073709551615 } else { editor.*.version }
        tab += 1
    }
    var text: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeNumber(codemap, bytes, 0, codemap.*.index.*.fileCount)
    length = writeText(bytes, length, say(codemap, " files read in ", " Dateien gelesen in "))
    length = writeNumber(codemap, bytes, length, codemap.*.buildMilliseconds)
    length = writeText(bytes, length, " ms")
    setNote(codemap, bytes[0..length], "")
}

// ---------------------------------------------------------------------------
// The camera

fn extentOf(codemap: *Codemap, node: u32) -> f64 {
    const record = nodeOf(codemap, node)
    return m.maximum(record.*.extent, 1.2)
}

// The middle of what a node holds (where the camera looks at it).
fn middleOf(codemap: *Codemap, node: u32) -> m.Vec {
    const record = nodeOf(codemap, node)
    return m.vec(record.*.x + record.*.centerX, record.*.y + record.*.centerY, record.*.z + record.*.centerZ)
}

// The time flights go by: the demo's while one plays (a recorded frame
// moves it on by its interval, so flights are smooth however long a
// frame takes to draw), else the clock's.
fn cameraClock(codemap: *Codemap) -> usize {
    if codemap.*.demoActive { return codemap.*.demoClock }
    return panel_module.milliseconds()
}

// Flies to `node`: it and what is around it fill the view.
fn flyTo(codemap: *Codemap, node: u32) -> void {
    if node == NONE || !codemap.*.built { return }
    const camera = cameraOf(codemap)
    codemap.*.fromTarget = camera.*.target
    codemap.*.fromDistance = camera.*.distance
    codemap.*.fromYaw = camera.*.yaw
    codemap.*.fromPitch = camera.*.pitch
    codemap.*.toTarget = middleOf(codemap, node)
    // Small things with some of what is around them.
    const smallest: f64 = if nodeOf(codemap, node).*.kind == graph_module.DECLARATION { 5.0 } else { 3.0 }
    codemap.*.toDistance = m.maximum(extentOf(codemap, node), smallest) * 2.4
    codemap.*.toYaw = camera.*.yaw + 0.35
    codemap.*.toPitch = m.clamp(camera.*.pitch, -0.9, 0.9)
    // Far apart: out on the way, like a jump.
    const travel = m.length(m.sub(codemap.*.toTarget, codemap.*.fromTarget))
    codemap.*.bump = m.clamp(travel / (codemap.*.fromDistance + codemap.*.toDistance) * 0.6, 0.0, 2.5)
    codemap.*.flyStart = cameraClock(codemap)
    codemap.*.flyDuration = 950
    codemap.*.flying = true
    codemap.*.focus = node
    animate(codemap)
}

fn animate(codemap: *Codemap) -> void {
    const panel = panelOf(codemap)
    // The next tick now, not when the slow tick (the crash log's) was due.
    if panel.*.tickInterval != 16 { panel.*.nextTick = 0 }
    panel.*.tickInterval = 16
    panel.*.dirty = true
}

// Where the flight is now.
fn advance(codemap: *Codemap) -> void {
    if !codemap.*.flying { return }
    const camera = cameraOf(codemap)
    const now = cameraClock(codemap)
    var t: f64 = 1.0
    if now < codemap.*.flyStart + codemap.*.flyDuration {
        t = m.toFloat(@intCast(i64, now - codemap.*.flyStart)) / m.toFloat(@intCast(i64, codemap.*.flyDuration))
    } else {
        codemap.*.flying = false
    }
    const e = m.ease(t)
    camera.*.target = m.mix(codemap.*.fromTarget, codemap.*.toTarget, e)
    const log_from = m.ln(m.maximum(codemap.*.fromDistance, 0.01))
    const log_to = m.ln(m.maximum(codemap.*.toDistance, 0.01))
    const arc = 1.0 + codemap.*.bump * 4.0 * e * (1.0 - e)
    camera.*.distance = m.exp(log_from + (log_to - log_from) * e) * arc
    camera.*.yaw = codemap.*.fromYaw + (codemap.*.toYaw - codemap.*.fromYaw) * e
    camera.*.pitch = codemap.*.fromPitch + (codemap.*.toPitch - codemap.*.fromPitch) * e
}

fn stopFlying(codemap: *Codemap) -> void { codemap.*.flying = false }

fn orbit(codemap: *Codemap, yaw: f64, pitch: f64) -> void {
    stopFlying(codemap)
    const camera = cameraOf(codemap)
    camera.*.yaw = camera.*.yaw + yaw
    camera.*.pitch = m.clamp(camera.*.pitch + pitch, -1.45, 1.45)
}

fn zoom(codemap: *Codemap, factor: f64) -> void {
    stopFlying(codemap)
    const camera = cameraOf(codemap)
    camera.*.distance = m.clamp(camera.*.distance * factor, 0.3, 200000.0)
}

// Moves what is looked at by (dx, dy) pixels on the screen.
fn pan(codemap: *Codemap, dx: i32, dy: i32) -> void {
    stopFlying(codemap)
    const camera = cameraOf(codemap)
    const scale = camera.*.distance / m.maximum(camera.*.focal, 1.0)
    const across = m.scale(camera.*.right, -m.toFloat(@intCast(i64, dx)) * scale)
    const upward = m.scale(camera.*.up, m.toFloat(@intCast(i64, dy)) * scale)
    camera.*.target = m.add(camera.*.target, m.add(across, upward))
}

// ---------------------------------------------------------------------------
// Selecting

fn traceLine(codemap: *Codemap, first: []const u8, second: []const u8) -> void {
    if !codemap.*.trace { return }
    var line: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length = writeText(bytes, 0, "codemap: ")
    length = writeText(bytes, length, first)
    if length + second.length < 1190 { length = writeText(bytes, length, second) }
    bytes[length] = 10
    const written = std.io.writeAll(std.io.stdout(), bytes[0..length + 1])
}

fn setSelected(codemap: *Codemap, node: u32) -> void {
    if codemap.*.trace {
        var key: [1024]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &key) }
        const length = keyOf(codemap, node, bytes)
        traceLine(codemap, "selected ", bytes[0..length])
    }
    codemap.*.selected = node
    codemap.*.detailScroll = 0
    var at: usize = 0
    while at < 12 {
        codemap.*.expanded[at] = false
        at += 1
    }
    const relations = relationsOf(codemap)
    // Unmark what was related.
    at = 0
    while at < relations.*.outgoingCount {
        codemap.*.related[@intCast(usize, relations.*.outgoing[at].node)] = 0
        at += 1
    }
    at = 0
    while at < relations.*.incomingCount {
        codemap.*.related[@intCast(usize, relations.*.incoming[at].node)] = 0
        at += 1
    }
    graph_module.relate(graphOf(codemap), node, relations)
    at = 0
    while at < relations.*.outgoingCount {
        codemap.*.related[@intCast(usize, relations.*.outgoing[at].node)] |= 1
        at += 1
    }
    at = 0
    while at < relations.*.incomingCount {
        codemap.*.related[@intCast(usize, relations.*.incoming[at].node)] |= 2
        at += 1
    }
    codemap.*.similarCount = 0
    if node != NONE && nodeOf(codemap, node).*.kind == graph_module.DECLARATION {
        unsafe { codemap.*.similarCount = graph_module.similar(graphOf(codemap), node, @ptrCast([*]u32, &codemap.*.similarNodes), @ptrCast([*]u32, &codemap.*.similarShares), 12) }
    }
    if codemap.*.trace && node != NONE {
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeText(bytes, 0, "out ")
        length = writeNumberPlain(bytes, length, relations.*.outgoingCount)
        length = writeText(bytes, length, " in ")
        length = writeNumberPlain(bytes, length, relations.*.incomingCount)
        traceLine(codemap, "related ", bytes[0..length])
    }
    panelOf(codemap).*.dirty = true
}

// Selects `node`, remembered for Back.
fn select(codemap: *Codemap, node: u32) -> void {
    if node == codemap.*.selected { return }
    if codemap.*.selected != NONE {
        if codemap.*.backCount == HISTORY {
            var at: usize = 1
            while at < HISTORY {
                codemap.*.back[at - 1] = codemap.*.back[at]
                at += 1
            }
            codemap.*.backCount -= 1
        }
        codemap.*.back[codemap.*.backCount] = codemap.*.selected
        codemap.*.backCount += 1
    }
    codemap.*.forwardCount = 0
    setSelected(codemap, node)
}

fn goTo(codemap: *Codemap, node: u32) -> void {
    select(codemap, node)
    // In the editor: its file, at it (a group: the galaxy flies there).
    showNode(codemap, node)
}

fn goBack(codemap: *Codemap) -> void {
    if codemap.*.backCount == 0 { return }
    codemap.*.backCount -= 1
    const node = codemap.*.back[codemap.*.backCount]
    if codemap.*.selected != NONE && codemap.*.forwardCount < HISTORY {
        codemap.*.forward[codemap.*.forwardCount] = codemap.*.selected
        codemap.*.forwardCount += 1
    }
    setSelected(codemap, node)
    showNode(codemap, node)
}

fn goForward(codemap: *Codemap) -> void {
    if codemap.*.forwardCount == 0 { return }
    codemap.*.forwardCount -= 1
    const node = codemap.*.forward[codemap.*.forwardCount]
    if codemap.*.selected != NONE && codemap.*.backCount < HISTORY {
        codemap.*.back[codemap.*.backCount] = codemap.*.selected
        codemap.*.backCount += 1
    }
    setSelected(codemap, node)
    showNode(codemap, node)
}

// The map flies to `node`; in the editor, its file opens at it.
fn showNode(codemap: *Codemap, node: u32) -> void {
    if codemap.*.view == VIEW_EDITOR && node != NONE && nodeOf(codemap, node).*.kind != graph_module.DIRECTORY {
        openNode(codemap, node)
        return
    }
    flyTo(codemap, node)
}

// Up a group: the selection's (or the camera's) parent.
fn goUp(codemap: *Codemap) -> void {
    const from = if codemap.*.selected != NONE { codemap.*.selected } else { codemap.*.focus }
    if from == NONE { return }
    const parent = nodeOf(codemap, from).*.parent
    if parent == NONE { return }
    goTo(codemap, parent)
}

// ---------------------------------------------------------------------------
// Searching

// The query the search holds (a view's, for @NAME); "" when it holds a
// plain name.
fn searchQuery(codemap: *Codemap) -> []const u8 {
    const text = searchText(codemap)
    if text.length > 1 && text[0] == 64 {
        const views = viewsOf(codemap)
        const view = views_module.find(views, text[1..text.length])
        if view < views.*.count { return views_module.queryOf(views, view) }
        return ""
    }
    if query_module.isQuery(text) { return text }
    return ""
}

// Reads the query in the search again (and works out what it needs).
fn updateQuery(codemap: *Codemap) -> void {
    codemap.*.queryActive = false
    codemap.*.queryBad = false
    if !codemap.*.built { return }
    const text = searchText(codemap)
    const words = searchQuery(codemap)
    if words.length == 0 {
        codemap.*.queryBad = text.length > 1 && text[0] == 64
        return
    }
    const query = queryOf(codemap)
    if !query_module.parse(query, words) {
        codemap.*.queryBad = true
        return
    }
    query_module.prepare(query, measuresOf(codemap), @intFromPtr(diffOf(codemap)))
    codemap.*.queryActive = true
}

// The search changed: a query (then or now) leaves out anew, a name is
// only looked for.
fn searchChanged(codemap: *Codemap) -> void {
    const text = searchText(codemap)
    if codemap.*.queryActive || searchQuery(codemap).length > 0 || (text.length > 1 && text[0] == 64) {
        refreshVisibility(codemap)
    } else {
        codemap.*.queryBad = false
        runSearch(codemap)
    }
}

fn runSearch(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    var at: usize = 0
    while at < graph.*.count {
        codemap.*.matches[at] = 0
        at += 1
    }
    codemap.*.matchCount = 0
    codemap.*.resultCount = 0
    codemap.*.resultCursor = 0
    const text = searchText(codemap)
    if text.length == 0 || !codemap.*.built { return }
    if codemap.*.queryActive || codemap.*.queryBad {
        // The answers are what is shown of the declarations.
        if codemap.*.queryBad { return }
        at = 1
        while at < graph.*.count {
            if graph_module.nodeAt(graph, @intCast(u32, at)).*.kind == graph_module.DECLARATION && !hiddenAt(codemap, at) {
                codemap.*.matches[at] = 1
                codemap.*.matchCount += 1
                if codemap.*.resultCount < RESULTS {
                    codemap.*.results[codemap.*.resultCount] = @intCast(u32, at)
                    codemap.*.resultScores[codemap.*.resultCount] = 0
                    codemap.*.resultCount += 1
                }
            }
            at += 1
        }
        return
    }
    unsafe {
        codemap.*.resultCount = graph_module.search(graph, text, @ptrCast([*]u32, &codemap.*.results), @ptrCast([*]u32, &codemap.*.resultScores), RESULTS)
    }
    // What the sidebar leaves out is not found.
    var kept: usize = 0
    at = 0
    while at < codemap.*.resultCount {
        if !isHidden(codemap, codemap.*.results[at]) {
            codemap.*.results[kept] = codemap.*.results[at]
            codemap.*.resultScores[kept] = codemap.*.resultScores[at]
            kept += 1
        }
        at += 1
    }
    codemap.*.resultCount = kept
    at = 1
    while at < graph.*.count {
        if !hiddenAt(codemap, at) && graph_module.matchScore(graph, @intCast(u32, at), text) != NONE {
            codemap.*.matches[at] = 1
            codemap.*.matchCount += 1
        }
        at += 1
    }
}

fn clearSearch(codemap: *Codemap) -> void {
    codemap.*.searchLength = 0
    codemap.*.searchFocused = false
    searchChanged(codemap)
}

// Puts `text` into the search (a view chosen, --query).
fn setSearch(codemap: *Codemap, text: []const u8) -> void {
    codemap.*.searchLength = 0
    for byte in text {
        if codemap.*.searchLength < 256 {
            codemap.*.search[codemap.*.searchLength] = byte
            codemap.*.searchLength += 1
        }
    }
    searchChanged(codemap)
    if codemap.*.queryActive { flyToShown(codemap) }
}

// ---------------------------------------------------------------------------
// The lists under the toolbar's buttons

fn openPopup(codemap: *Codemap, popup: u8) -> void {
    if !codemap.*.built { return }
    codemap.*.searchFocused = false
    codemap.*.popup = popup
    codemap.*.popupRowTop = TOOLBAR + 2
    if popup == POPUP_BASE {
        // The history: the commit of what changed, then the bases.
        refreshChanges(codemap)
        loadBases(codemap)
        codemap.*.popupX = baseX(codemap)
        codemap.*.popupWidth = 440
        codemap.*.popupRows = 1 + codemap.*.baseCount
        codemap.*.popupRowTop = TOOLBAR - 4 + commitSectionHeight(codemap) + 26
    } else {
        codemap.*.popupWidth = 330
        codemap.*.popupX = filterX(codemap) + filterWidth(codemap) - codemap.*.popupWidth
        codemap.*.popupRows = filterRows(codemap)
    }
    if codemap.*.popupX + codemap.*.popupWidth > surfaceWidth(codemap) - 8 { codemap.*.popupX = surfaceWidth(codemap) - 8 - codemap.*.popupWidth }
}


// The last commits (the bases to choose from).
fn loadBases(codemap: *Codemap) -> void {
    codemap.*.baseCount = 0
    codemap.*.baseLogLength = 0
    const git = gitOf(codemap)
    if !git_module.usable(git) { return }
    const text = git_module.run(git, "log --format='%h %s' -n 15")
    var at: usize = 0
    while at < text.length && codemap.*.baseCount < 15 {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..(if end - at > 120 { at + 120 } else { end })]
        if codemap.*.baseLogLength + line.length < 4096 {
            codemap.*.baseStart[codemap.*.baseCount] = codemap.*.baseLogLength
            for byte in line {
                codemap.*.baseLog[codemap.*.baseLogLength] = byte
                codemap.*.baseLogLength += 1
            }
            codemap.*.baseEnd[codemap.*.baseCount] = codemap.*.baseLogLength
            codemap.*.baseCount += 1
        }
        at = end + 1
    }
}

fn baseLine(codemap: *Codemap, row: usize) -> []const u8 {
    return fieldBytes(codemap, @offsetOf(Codemap, "baseLog"))[codemap.*.baseStart[row]..codemap.*.baseEnd[row]]
}

// Compares with a new base: Changed (opened) and the query follow.
fn chooseBase(codemap: *Codemap, base: []const u8) -> void {
    codemap.*.diffBaseLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "diffBase")), 0, base, 128)
    runDiff(codemap)
    codemap.*.findingOn[@intCast(usize, FINDING_CHANGED)] = true
    select(codemap, NONE)
    refreshVisibility(codemap)
    openFinding(codemap, FINDING_CHANGED)
}

// The query builder's rows: first what fits the selection (in its
// group, calls it, called by it, uses it), then the words.
fn filterRows(codemap: *Codemap) -> usize { return contextRows(codemap) + FILTER_TERMS }

fn contextRows(codemap: *Codemap) -> usize {
    const node = codemap.*.selected
    if node == NONE { return 0 }
    const record = nodeOf(codemap, node)
    if record.*.kind == graph_module.DECLARATION { return 4 }
    return if node == graphOf(codemap).*.root { 0 } else { 1 }
}

// The path of a group or file (relative, a directory's with a / after).
fn groupPath(codemap: *Codemap, node: u32, into: [*]u8) -> usize {
    const record = nodeOf(codemap, node)
    if record.*.kind != graph_module.DIRECTORY { return writeText(into, 0, graph_module.pathOf(graphOf(codemap), node)) }
    var key: [1024]u8 = undefined
    var key_bytes: [*]u8 = undefined
    unsafe { key_bytes = @ptrCast([*]u8, &key) }
    const length = keyOf(codemap, node, key_bytes)
    // Without the root's name.
    var start: usize = 0
    while start < length && key_bytes[start] != 47 { start += 1 }
    return writeText(into, 0, key_bytes[(if start < length { start + 1 } else { length })..length])
}

// The word of a row (into `into`) and what it means (into `about`).
fn filterRow(codemap: *Codemap, row: usize, into: [*]u8, about: [*]u8) -> usize {
    const context = contextRows(codemap)
    var length: usize = 0
    var about_length: usize = 0
    if row < context {
        const node = codemap.*.selected
        const record = nodeOf(codemap, node)
        if record.*.kind != graph_module.DECLARATION {
            length = writeText(into, 0, "in:")
            var path: [1024]u8 = undefined
            var path_bytes: [*]u8 = undefined
            unsafe { path_bytes = @ptrCast([*]u8, &path) }
            const path_length = groupPath(codemap, node, path_bytes)
            length = writeText(into, length, path_bytes[0..path_length])
            about_length = writeText(about, 0, say(codemap, "In what is selected", "Im Gewählten"))
        } else {
            const name = nameOf(codemap, node)
            const keys = [4][]const u8{ "calls:", "by:", "uses:", "name:" }
            length = writeText(into, 0, keys[row])
            length = writeText(into, length, name)
            if row == 0 { about_length = writeText(about, 0, say(codemap, "Calls it", "Ruft es auf")) }
            if row == 1 { about_length = writeText(about, 0, say(codemap, "Called by it", "Wird von ihm aufgerufen")) }
            if row == 2 { about_length = writeText(about, 0, say(codemap, "Uses it", "Verwendet es")) }
            if row == 3 { about_length = writeText(about, 0, say(codemap, "Named like it", "Heißt so ähnlich")) }
        }
    } else {
        const term = row - context
        const words = [13][]const u8{ "kind:fn", "kind:struct", "crashed", "workaround", "changed", "added", "untested", "unreachable", "complex", "risky", "hot", "unused", "copy" }
        length = writeText(into, 0, words[term])
        const english = [13][]const u8{ "Functions", "Structs", "Crashed", "With a workaround", "Changed since the base", "Added since the base", "Untested", "Unreachable", "Complex", "Risky", "Hot (profiles)", "Unused", "A copy" }
        const german = [13][]const u8{ "Funktionen", "Structs", "Abgestürzt", "Mit Workaround", "Geändert seit der Basis", "Neu seit der Basis", "Ungetestet", "Unerreichbar", "Komplex", "Riskant", "Heiß (Profile)", "Ungenutzt", "Eine Kopie" }
        about_length = writeText(about, 0, if codemap.*.german { german[term] } else { english[term] })
    }
    about[about_length] = 0
    return length
}

fn choosePopupRow(codemap: *Codemap, row: usize) -> void {
    const popup = codemap.*.popup
    codemap.*.popup = POPUP_NONE
    if popup == POPUP_BASE {
        if row == 0 {
            chooseBase(codemap, "HEAD")
        } else if row - 1 < codemap.*.baseCount {
            const line = baseLine(codemap, row - 1)
            var end: usize = 0
            while end < line.length && line[end] != 32 { end += 1 }
            chooseBase(codemap, line[0..end])
        }
        return
    }
    if popup != POPUP_FILTER || row >= filterRows(codemap) { return }
    var word: [1100]u8 = undefined
    var about: [256]u8 = undefined
    var word_bytes: [*]u8 = undefined
    var about_bytes: [*]u8 = undefined
    unsafe {
        word_bytes = @ptrCast([*]u8, &word)
        about_bytes = @ptrCast([*]u8, &about)
    }
    const length = filterRow(codemap, row, word_bytes, about_bytes)
    if codemap.*.trace { traceLine(codemap, "filter word ", word_bytes[0..length]) }
    // Added to what the search holds (a plain name there is replaced).
    const text = searchText(codemap)
    var joined: [512]u8 = undefined
    var joined_bytes: [*]u8 = undefined
    unsafe { joined_bytes = @ptrCast([*]u8, &joined) }
    var joined_length: usize = 0
    if searchQuery(codemap).length > 0 && !(text.length > 0 && text[0] == 64) {
        joined_length = writeText(joined_bytes, 0, text)
        if joined_length > 0 && joined_bytes[joined_length - 1] != 32 { joined_length = writeText(joined_bytes, joined_length, " ") }
    }
    if joined_length + length < 256 { joined_length = writeText(joined_bytes, joined_length, word_bytes[0..length]) }
    setSearch(codemap, joined_bytes[0..joined_length])
    codemap.*.searchFocused = true
}

fn drawPopup(codemap: *Codemap, canvas: *Canvas) -> void {
    if codemap.*.popup == POPUP_NONE { return }
    const x = codemap.*.popupX
    const width = codemap.*.popupWidth
    const top = TOOLBAR - 4
    const rows = @intCast(i32, codemap.*.popupRows)
    const footer: i32 = if codemap.*.popup == POPUP_FILTER { 40 } else { 0 }
    // The history: the commit first, then "Compare with" and the bases.
    const head: i32 = if codemap.*.popup == POPUP_BASE { commitSectionHeight(codemap) + 26 } else { 6 }
    codemap.*.popupRowTop = top + head
    const height = head + rows * POPUP_ROW + 6 + footer
    canvas_module.fillRoundedRect(canvas, x + 2, top + 4, width, height, 10, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, top, width, height, 10, canvas_module.color(250, 32, 34, 43))
    canvas_module.strokeRoundedRect(canvas, x, top, width, height, 10, 1, canvas_module.color(255, 58, 62, 76))
    if codemap.*.popup == POPUP_BASE {
        drawCommitSection(codemap, canvas, x, top, width)
        const heading_y = top + head - 22
        canvas_module.fillRect(canvas, x + 12, heading_y - 6, width - 24, 1, canvas_module.color(255, 58, 62, 76))
        canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Changed compares with", "Geändert vergleicht mit"), x + 16, heading_y, DIM_COLOR, width - 32)
    }
    var word: [1100]u8 = undefined
    var about: [256]u8 = undefined
    var word_bytes: [*]u8 = undefined
    var about_bytes: [*]u8 = undefined
    unsafe {
        word_bytes = @ptrCast([*]u8, &word)
        about_bytes = @ptrCast([*]u8, &about)
    }
    var row: usize = 0
    while row < codemap.*.popupRows {
        const y = codemap.*.popupRowTop + @intCast(i32, row) * POPUP_ROW
        if codemap.*.hover == HIT_POPUP_ROW + row { canvas_module.fillRoundedRect(canvas, x + 6, y, width - 12, POPUP_ROW, 7, canvas_module.color(255, 52, 78, 130)) }
        if codemap.*.popup == POPUP_BASE {
            if row == 0 {
                drawDot(canvas, x + 16, y + 9, 8, canvasColor(CHANGED_COLOR, 255))
                canvas_module.drawText(canvas, bodyOf(codemap), say(codemap, "Not committed yet (HEAD)", "Noch nicht committet (HEAD)"), x + 32, y + 5, TEXT_COLOR, width - 44)
            } else {
                const line = baseLine(codemap, row - 1)
                var end: usize = 0
                while end < line.length && line[end] != 32 { end += 1 }
                canvas_module.drawText(canvas, smallOf(codemap), line[0..end], x + 16, y + 7, canvasColor(CHANGED_COLOR, 255), 0)
                if end < line.length { canvas_module.drawText(canvas, bodyOf(codemap), line[end + 1..line.length], x + 84, y + 5, TEXT_COLOR, width - 96) }
            }
        } else {
            const length = filterRow(codemap, row, word_bytes, about_bytes)
            var about_length: usize = 0
            while about_bytes[about_length] != 0 { about_length += 1 }
            canvas_module.drawText(canvas, bodyOf(codemap), word_bytes[0..length], x + 16, y + 5, if row < contextRows(codemap) { ACCENT } else { TEXT_COLOR }, 150)
            canvas_module.drawText(canvas, smallOf(codemap), about_bytes[0..about_length], x + 176, y + 7, DIM_COLOR, width - 188)
        }
        row += 1
    }
    if footer > 0 {
        const y = codemap.*.popupRowTop + 6 + rows * POPUP_ROW
        const hint = say(codemap, "A click adds the word to the search; - before one turns it around, the bookmark keeps the query.", "Ein Klick fügt das Wort der Suche hinzu; - davor kehrt es um, das Lesezeichen hält die Abfrage fest.")
        const drawn = drawWrapped(codemap, canvas, hint, smallOf(codemap), x + 16, y, width - 32, DIM_COLOR, 2, 16)
    }
}

// Ctrl+S: the query in the search, kept as a view in codemap.views.
fn saveView(codemap: *Codemap) -> void {
    if !codemap.*.queryActive { return }
    const text = searchText(codemap)
    if text.length > 0 && text[0] == 64 { return }
    const views = viewsOf(codemap)
    var name: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &name) }
    var length = writeText(bytes, 0, say(codemap, "View ", "Ansicht "))
    length = writeNumberPlain(bytes, length, views.*.count + 1)
    const saved = views_module.add(views, rootText(codemap), bytes[0..length], text)
    if codemap.*.trace { traceLine(codemap, if saved { "view saved " } else { "view not saved " }, bytes[0..length]) }
    panelOf(codemap).*.dirty = true
}

fn chooseResult(codemap: *Codemap, index: usize) -> void {
    if index >= codemap.*.resultCount { return }
    const node = codemap.*.results[index]
    codemap.*.searchFocused = false
    goTo(codemap, node)
}

fn searchKey(codemap: *Codemap, key: u32) -> void {
    if key == KEY_ESCAPE {
        clearSearch(codemap)
        return
    }
    if key == KEY_ENTER || key == KEY_KP_ENTER {
        if codemap.*.queryActive {
            codemap.*.searchFocused = false
            flyToShown(codemap)
            return
        }
        chooseResult(codemap, codemap.*.resultCursor)
        return
    }
    if key == KEY_DOWN {
        if codemap.*.resultCursor + 1 < codemap.*.resultCount { codemap.*.resultCursor += 1 }
        return
    }
    if key == KEY_UP {
        if codemap.*.resultCursor > 0 { codemap.*.resultCursor -= 1 }
        return
    }
    if key == KEY_BACKSPACE {
        if codemap.*.searchLength == 0 { return }
        codemap.*.searchLength -= 1
        while codemap.*.searchLength > 0 && codemap.*.search[codemap.*.searchLength] >= 128 && codemap.*.search[codemap.*.searchLength] < 192 { codemap.*.searchLength -= 1 }
        searchChanged(codemap)
        return
    }
    typeInto(codemap)
}

// What the last key typed, into the search.
fn typeInto(codemap: *Codemap) -> void {
    const panel = panelOf(codemap)
    if panel.*.textLength == 0 || modifiers(codemap) & (CONTROL | ALT) != 0 || panel.*.text[0] < 32 { return }
    if codemap.*.searchLength + panel.*.textLength > 256 { return }
    var at: usize = 0
    while at < panel.*.textLength {
        codemap.*.search[codemap.*.searchLength] = panel.*.text[at]
        codemap.*.searchLength += 1
        at += 1
    }
    codemap.*.searchFocused = true
    searchChanged(codemap)
}

// ---------------------------------------------------------------------------
// Opening in the editor

fn quoteInto(out: [*]u8, at: usize, text: []const u8) -> usize {
    var length = at
    out[length] = 39
    length += 1
    for byte in text {
        if length > 1900 { return length }
        if byte == 39 {
            length = writeText(out, length, "'\\''")
        } else {
            out[length] = byte
            length += 1
        }
    }
    out[length] = 39
    return length + 1
}

// "Open in editor", Ctrl+O: the built-in editor, at the declaration.
fn openInEditor(codemap: *Codemap, node: u32) -> void {
    if node == NONE { return }
    openNode(codemap, node)
}

// Ctrl+Shift+O: another editor (MLX_EDITOR, else VS Code, else
// xdg-open) at the same place.
fn openExternally(codemap: *Codemap, node: u32) -> void {
    if node == NONE { return }
    const record = nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return }
    const index = codemap.*.index
    const file = index_module.symbolAt(index, record.*.symbol).*.file
    const path = index_module.pathOf(index, file)
    var line: usize = 1
    var column: usize = 1
    if record.*.kind == graph_module.DECLARATION {
        const offset = @intCast(usize, index_module.symbolAt(index, record.*.symbol).*.nameStart)
        line = index_module.lineOf(index, file, offset) + 1
        column = index_module.columnOf(index, file, offset) + 1
    }
    var place: [1200]u8 = undefined
    var place_bytes: [*]u8 = undefined
    unsafe { place_bytes = @ptrCast([*]u8, &place) }
    var place_length = writeText(place_bytes, 0, path)
    place_length = writeText(place_bytes, place_length, ":")
    place_length = writeNumberPlain(place_bytes, place_length, line)
    place_length = writeText(place_bytes, place_length, ":")
    place_length = writeNumberPlain(place_bytes, place_length, column)
    var command: [2048]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &command) }
    var length: usize = 0
    const editor = apps_module.environmentValue(codemap.*.environment, "MLX_EDITOR")
    if @intFromPtr(editor) != 0 && editor[0] != 0 {
        length = writeText(bytes, length, "exec ")
        length = writeText(bytes, length, cString(editor))
        length = writeText(bytes, length, " ")
        length = quoteInto(bytes, length, place_bytes[0..place_length])
    } else {
        length = writeText(bytes, length, "if command -v code > /dev/null 2>&1; then exec code -g ")
        length = quoteInto(bytes, length, place_bytes[0..place_length])
        length = writeText(bytes, length, "; else exec xdg-open ")
        length = quoteInto(bytes, length, path)
        length = writeText(bytes, length, "; fi")
    }
    bytes[length] = 0
    apps_module.spawn(bytes, codemap.*.environment)
    setNote(codemap, say(codemap, "Opening ", "Öffne "), place_bytes[0..place_length])
}

fn writeNumberPlain(out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var length = at
    while count > 0 {
        count -= 1
        out[length] = digits[count]
        length += 1
    }
    return length
}

// ---------------------------------------------------------------------------
// The 3D view: what the camera sees, as the scene's spheres, glows and
// lines

fn seenOf(codemap: *Codemap, node: u32) -> bool { return codemap.*.seen[@intCast(usize, node)] != 0 }

// The radius a node is drawn at: its own, but groups and files not less
// than a few pixels (so the whole shows from afar).
fn shownRadius(codemap: *Codemap, node: u32) -> f64 {
    const record = nodeOf(codemap, node)
    const radius = codemap.*.seenRadius[@intCast(usize, node)]
    if record.*.kind == graph_module.DIRECTORY { return m.maximum(radius, 3.4) }
    if record.*.kind == graph_module.FILE { return m.maximum(radius, 1.8) }
    if graph_module.isContainer(record.*.symbolKind) { return m.maximum(radius, 1.1) }
    return radius
}

// How opaque a node is drawn (0-255): small declarations fade in as they
// come closer; what a search does not match fades out.
fn opacityOf(codemap: *Codemap, node: u32) -> u32 {
    const record = nodeOf(codemap, node)
    var alpha: f64 = 1.0
    if record.*.kind == graph_module.DECLARATION && !graph_module.isContainer(record.*.symbolKind) {
        const radius = codemap.*.seenRadius[@intCast(usize, node)]
        if radius < 0.45 { return 0 }
        if radius < 1.4 { alpha = (radius - 0.45) / 0.95 }
    }
    if codemap.*.searchFocused && codemap.*.searchLength > 0 && codemap.*.matches[@intCast(usize, node)] == 0 && codemap.*.related[@intCast(usize, node)] == 0 && node != codemap.*.selected { alpha = alpha * 0.25 }
    return @intCast(u32, m.toInt(alpha * 255.0))
}

// A line from node a to node b, between the edges of their spheres.
fn nodeLine(codemap: *Codemap, a: u32, b: u32, width: f64, near_color: u32, far_color: u32, in_front: bool) -> void {
    if !seenOf(codemap, a) || !seenOf(codemap, b) { return }
    const ax = codemap.*.seenX[@intCast(usize, a)]
    const ay = codemap.*.seenY[@intCast(usize, a)]
    const bx = codemap.*.seenX[@intCast(usize, b)]
    const by = codemap.*.seenY[@intCast(usize, b)]
    const dx = bx - ax
    const dy = by - ay
    const size = m.sqrt(dx * dx + dy * dy)
    const ra = shownRadius(codemap, a)
    const rb = shownRadius(codemap, b)
    if size <= ra + rb + 1.0 { return }
    const ux = dx / size
    const uy = dy / size
    const da = codemap.*.seenDepth[@intCast(usize, a)]
    const db = codemap.*.seenDepth[@intCast(usize, b)]
    // Behind both ends, or (highlighted) in front of them.
    const depth = if in_front { m.minimum(da, db) * 0.999 } else { m.maximum(da, db) * 1.001 }
    scene_module.line(sceneOf(codemap), ax + ux * ra, ay + uy * ra, bx - ux * rb, by - uy * rb, width, near_color, far_color, depth)
}

fn project(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    const camera = cameraOf(codemap)
    var node: usize = 0
    while node < graph.*.count {
        const record = graph_module.nodeAt(graph, @intCast(u32, node))
        const where = m.project(camera, m.vec(record.*.x, record.*.y, record.*.z))
        codemap.*.seenDepth[node] = where.depth
        if where.depth < 0.05 || hiddenAt(codemap, node) {
            codemap.*.seen[node] = 0
        } else {
            codemap.*.seen[node] = 1
            codemap.*.seenX[node] = where.x
            codemap.*.seenY[node] = where.y
            codemap.*.seenRadius[node] = record.*.radius * camera.*.focal / where.depth
        }
        node += 1
    }
}

fn buildScene(codemap: *Codemap) -> void {
    const scene = sceneOf(codemap)
    const width = viewWidth(codemap)
    const height = viewHeight(codemap)
    scene_module.begin(scene, SIDEBAR, TOOLBAR, width, height)
    codemap.*.drawnCount = 0
    // In the editor no galaxy is drawn; a flight still ends.
    if codemap.*.view == VIEW_EDITOR {
        advance(codemap)
        return
    }
    if !codemap.*.built || width <= 0 || height <= 0 { return }
    const camera = cameraOf(codemap)
    const open_width = if detailOpen(codemap) { width - DETAIL } else { width }
    camera.*.centerX = m.toFloat(@intCast(i64, open_width)) * 0.5
    camera.*.centerY = m.toFloat(@intCast(i64, height)) * 0.5
    camera.*.focal = m.toFloat(@intCast(i64, height)) * 0.95
    advance(codemap)
    m.update(camera)
    project(codemap)
    const graph = graphOf(codemap)
    const full_width: f64 = m.toFloat(@intCast(i64, width))
    const full_height: f64 = m.toFloat(@intCast(i64, height))
    const selected = codemap.*.selected
    const quiet = selected != NONE
    // The groups: a haze as big as each, and the lines of the tree.
    var node: usize = 0
    while node < graph.*.count {
        const id = @intCast(u32, node)
        if codemap.*.seen[node] != 0 {
            const record = graph_module.nodeAt(graph, id)
            if record.*.kind == graph_module.DIRECTORY && id != graph.*.root {
                const depth = codemap.*.seenDepth[node]
                if depth > record.*.extent {
                    const haze = record.*.extent * camera.*.focal / depth
                    if haze > 6.0 {
                        var alpha: f64 = 22.0
                        if haze > full_height { alpha = alpha * full_height / haze }
                        scene_module.glow(scene, codemap.*.seenX[node], codemap.*.seenY[node], haze, withAlpha(record.*.color, @intCast(u32, m.toInt(alpha))), depth + record.*.extent)
                    }
                }
            }
            if codemap.*.showTree && record.*.parent != NONE && shownRadius(codemap, id) >= 1.0 {
                const alpha: u32 = if quiet { 30 } else { 52 }
                const fade = opacityOf(codemap, id)
                if fade > 0 {
                    const parent_color = graph_module.nodeAt(graph, record.*.parent).*.color
                    nodeLine(codemap, record.*.parent, id, 1.0, withAlpha(parent_color, alpha * fade / 255), withAlpha(record.*.color, alpha * fade / 255), false)
                }
            }
        }
        node += 1
    }
    // The imports between files.
    if codemap.*.showImports {
        const alpha: u32 = if quiet { 14 } else { 34 }
        var at: usize = 0
        while at < graph.*.importCount {
            const from = graph.*.importFrom[at]
            const to = graph.*.importTo[at]
            nodeLine(codemap, from, to, 1.0, withAlpha(nodeOf(codemap, from).*.color, alpha), withAlpha(nodeOf(codemap, to).*.color, alpha), false)
            at += 1
        }
    }
    // The spheres.
    node = 0
    while node < graph.*.count {
        const id = @intCast(u32, node)
        if codemap.*.seen[node] != 0 {
            const radius = shownRadius(codemap, id)
            const x = codemap.*.seenX[node]
            const y = codemap.*.seenY[node]
            const on_screen = x + radius > 0.0 && y + radius > 0.0 && x - radius < full_width && y - radius < full_height
            const alpha = opacityOf(codemap, id)
            if on_screen && alpha > 0 && radius >= 0.45 {
                const record = graph_module.nodeAt(graph, id)
                const depth = codemap.*.seenDepth[node]
                scene_module.sphere(scene, x, y, radius, withAlpha(sphereColor(codemap, id), alpha), depth)
                if codemap.*.drawnCount < graph_module.MAX_NODES {
                    codemap.*.drawn[codemap.*.drawnCount] = id
                    codemap.*.drawnCount += 1
                }
                const related = codemap.*.related[node]
                if related != 0 {
                    const color = if related & 1 != 0 { OUTGOING } else { INCOMING }
                    scene_module.glow(scene, x, y, radius * 2.0 + 7.0, withAlpha(color, 120), depth + radius * depth / camera.*.focal)
                } else if codemap.*.searchLength > 0 && codemap.*.matches[node] != 0 && codemap.*.matchCount < 4000 {
                    scene_module.glow(scene, x, y, radius * 2.0 + 6.0, withAlpha(4294953835, 110), depth + radius * depth / camera.*.focal)
                }
            }
        }
        node += 1
    }
    // The findings checked in the sidebar: their nodes aglow (workarounds
    // amber, the others magenta), the groups of copies and names joined.
    node = 0
    while node < graph.*.count {
        const bits = codemap.*.findingMark[node]
        if bits != 0 && codemap.*.seen[node] != 0 {
            const id = @intCast(u32, node)
            const radius = shownRadius(codemap, id)
            // Close up the node says it (a glow that big costs).
            if radius < 90.0 {
                const depth = codemap.*.seenDepth[node]
                const color = markColor(bits)
                const alpha: u32 = if bits == 4 { 110 } else { 150 }
                scene_module.glow(scene, codemap.*.seenX[node], codemap.*.seenY[node], radius * 2.4 + 8.0, withAlpha(color, alpha), depth + radius * depth / camera.*.focal)
            }
        }
        node += 1
    }
    if codemap.*.lineGroupCount > 0 {
        const analysis = analysisOf(codemap)
        var at: usize = 0
        while at < codemap.*.lineGroupCount {
            const entry = codemap.*.lineGroups[at]
            const members = analysis_module.groupMembers(analysis, findingEntryKind(entry), findingEntryGroup(entry))
            var previous = NONE
            for symbol in members {
                const member = nodeOfSymbol(codemap, symbol)
                if member != NONE {
                    if previous != NONE { nodeLine(codemap, previous, member, 1.4, withAlpha(FINDING_COLOR, 170), withAlpha(FINDING_COLOR, 170), true) }
                    previous = member
                }
            }
            at += 1
        }
    }
    if codemap.*.findingOn[@intCast(usize, FINDING_STRUCTURE)] {
        // Cycles round, and the imports against the rules.
        const structure = structureOf(codemap)
        var cycle: usize = 0
        while cycle < structure.*.cycleCount {
            const members = structure_module.cycleMembers(structure, cycle)
            var at: usize = 0
            while at < members.length {
                const from = fileNode(codemap, members[at])
                const to = fileNode(codemap, members[(at + 1) % members.length])
                if from != NONE && to != NONE { nodeLine(codemap, from, to, 1.6, withAlpha(STRUCTURE_COLOR, 210), withAlpha(STRUCTURE_COLOR, 210), true) }
                at += 1
            }
            cycle += 1
        }
        var broken: usize = 0
        while broken < structure.*.brokenCount {
            const import = @intCast(usize, structure.*.broken[broken])
            const from = fileNode(codemap, structure.*.importFrom[import])
            const to = fileNode(codemap, structure.*.importTo[import])
            if from != NONE && to != NONE { nodeLine(codemap, from, to, 1.6, withAlpha(STRUCTURE_COLOR, 220), withAlpha(RISKY_COLOR, 220), true) }
            broken += 1
        }
    }
    const crashes_on = codemap.*.findingOn[@intCast(usize, FINDING_CRASHES)]
    if crashes_on {
        // Each crash's calls, from the caller to what it called.
        const crashes = crashesOf(codemap)
        var record: usize = 0
        while record < crashes.*.count && record < 400 {
            var frame = crashes_module.firstFrame(crashes, @intCast(u32, record))
            var callee = NONE
            while frame < crashes.*.frameCount && crashes.*.frameRecord[frame] == @intCast(u32, record) {
                const caller = nodeOfSymbol(codemap, crashes.*.frameSymbol[frame])
                if caller != NONE && callee != NONE && caller != callee { nodeLine(codemap, caller, callee, 1.6, withAlpha(CRASH_COLOR, 200), withAlpha(CRASH_COLOR, 200), true) }
                if caller != NONE { callee = caller }
                frame += 1
            }
            record += 1
        }
    }
    // Crashes: a red flag on what crashed and on what holds it, in front
    // of everything; a glow on where a crash stopped (strong) or went
    // through.
    if crashes_on && codemap.*.crashedCount > 0 {
        node = 0
        while node < graph.*.count {
            const mark = codemap.*.crashMark[node]
            if mark != 0 && codemap.*.seen[node] != 0 {
                const id = @intCast(u32, node)
                const radius = shownRadius(codemap, id)
                const depth = codemap.*.seenDepth[node]
                const x = codemap.*.seenX[node]
                const y = codemap.*.seenY[node]
                if radius >= 0.45 && x + radius > 0.0 && y + radius > 0.0 && x - radius < full_width && y - radius < full_height {
                    // Close up the flag says it (a glow that big costs).
                    if mark == 2 && radius < 60.0 { scene_module.glow(scene, x, y, radius * 2.2 + 7.0, withAlpha(CRASH_COLOR, 190), depth + radius * depth / camera.*.focal) }
                    if mark == 1 && radius < 60.0 { scene_module.glow(scene, x, y, radius * 1.8 + 5.0, withAlpha(CRASH_COLOR, 90), depth + radius * depth / camera.*.focal) }
                    // The flag stays in front of everything, as a pin would.
                    var flag = radius * 0.3
                    if flag < 3.5 { flag = 3.5 }
                    if mark == 3 && flag > 5.0 { flag = 5.0 }
                    scene_module.sphere(scene, x + radius * 0.7, y - radius * 0.7, flag, withAlpha(CRASH_COLOR, 255), 0.001)
                }
            }
            node += 1
        }
    }
    // What is selected: its connections, a halo; what the pointer is on.
    if selected != NONE && seenOf(codemap, selected) {
        const relations = relationsOf(codemap)
        var at: usize = 0
        while at < relations.*.outgoingCount {
            const other = relations.*.outgoing[at].node
            nodeLine(codemap, selected, other, 1.8, withAlpha(OUTGOING, 230), withAlpha(nodeOf(codemap, other).*.color, 200), true)
            at += 1
        }
        at = 0
        while at < relations.*.incomingCount {
            const other = relations.*.incoming[at].node
            nodeLine(codemap, other, selected, 1.8, withAlpha(nodeOf(codemap, other).*.color, 200), withAlpha(INCOMING, 230), true)
            at += 1
        }
        const index = @intCast(usize, selected)
        const radius = shownRadius(codemap, selected)
        scene_module.glow(scene, codemap.*.seenX[index], codemap.*.seenY[index], radius * 2.6 + 12.0, withAlpha(4294967295, 110), codemap.*.seenDepth[index] + radius * codemap.*.seenDepth[index] / camera.*.focal)
    }
    const hovered = codemap.*.hoverNode
    if hovered != NONE && hovered != selected && seenOf(codemap, hovered) {
        const index = @intCast(usize, hovered)
        const radius = shownRadius(codemap, hovered)
        scene_module.glow(scene, codemap.*.seenX[index], codemap.*.seenY[index], radius * 2.2 + 9.0, withAlpha(4294967295, 80), codemap.*.seenDepth[index] + radius * codemap.*.seenDepth[index] / camera.*.focal)
    }
}

// The node drawn under (x, y) in the view, the nearest; else NONE.
fn nodeAt(codemap: *Codemap, x: i32, y: i32) -> u32 {
    const px = m.toFloat(@intCast(i64, x - SIDEBAR))
    const py = m.toFloat(@intCast(i64, y - TOOLBAR))
    var best = NONE
    var best_depth: f64 = 1000000000.0
    var nearest = NONE
    var nearest_distance: f64 = 64.0
    var at: usize = 0
    while at < codemap.*.drawnCount {
        const node = codemap.*.drawn[at]
        const index = @intCast(usize, node)
        const dx = codemap.*.seenX[index] - px
        const dy = codemap.*.seenY[index] - py
        const radius = shownRadius(codemap, node)
        const distance = dx * dx + dy * dy
        if distance <= (radius + 1.5) * (radius + 1.5) && codemap.*.seenDepth[index] < best_depth {
            best = node
            best_depth = codemap.*.seenDepth[index]
        }
        if distance < nearest_distance {
            nearest = node
            nearest_distance = distance
        }
        at += 1
    }
    return if best != NONE { best } else { nearest }
}

// ---------------------------------------------------------------------------
// Labels

fn labelPriority(codemap: *Codemap, node: u32) -> u64 {
    var priority: u64 = @intCast(u64, m.toInt(m.minimum(shownRadius(codemap, node), 5000.0) * 100.0))
    const record = nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { priority += 200000 }
    if node == codemap.*.selected { priority += 4000000 }
    if node == codemap.*.hoverNode { priority += 3000000 }
    if codemap.*.related[@intCast(usize, node)] != 0 { priority += 1000000 }
    if codemap.*.searchLength > 0 && codemap.*.matches[@intCast(usize, node)] != 0 { priority += 800000 }
    return priority
}

fn wantsLabel(codemap: *Codemap, node: u32) -> bool {
    if node == codemap.*.selected || node == codemap.*.hoverNode { return true }
    if !codemap.*.showLabels { return false }
    const record = nodeOf(codemap, node)
    const radius = shownRadius(codemap, node)
    if codemap.*.related[@intCast(usize, node)] != 0 && radius >= 1.5 { return true }
    if codemap.*.searchLength > 0 && codemap.*.matches[@intCast(usize, node)] != 0 && radius >= 1.5 { return true }
    if record.*.kind == graph_module.DIRECTORY { return true }
    if record.*.kind == graph_module.FILE { return radius >= 4.0 }
    return radius >= 6.0
}

fn sortLabelKeys(codemap: *Codemap, count: usize) -> void {
    var source = codemap.*.labelKeys
    var target = codemap.*.labelScratch
    var width: usize = 1
    while width < count {
        var low: usize = 0
        while low < count {
            const middle = if low + width < count { low + width } else { count }
            const high = if low + width * 2 < count { low + width * 2 } else { count }
            var left = low
            var right = middle
            var out = low
            while out < high {
                if left < middle && (right >= high || source[left] >= source[right]) {
                    target[out] = source[left]
                    left += 1
                } else {
                    target[out] = source[right]
                    right += 1
                }
                out += 1
            }
            low = high
        }
        const swap = source
        source = target
        target = swap
        width = width * 2
    }
    if @intFromPtr(source) != @intFromPtr(codemap.*.labelKeys) {
        var at: usize = 0
        while at < count {
            codemap.*.labelKeys[at] = source[at]
            at += 1
        }
    }
}

// Chooses the labels: the most important first, none over another.
fn placeLabels(codemap: *Codemap) -> void {
    codemap.*.labelCount = 0
    if !codemap.*.built { return }
    var count: usize = 0
    var at: usize = 0
    while at < codemap.*.drawnCount && count < LABEL_CANDIDATES {
        const node = codemap.*.drawn[at]
        if wantsLabel(codemap, node) {
            codemap.*.labelKeys[count] = (labelPriority(codemap, node) << 24) | @intCast(u64, node)
            count += 1
        }
        at += 1
    }
    sortLabelKeys(codemap, count)
    const small = smallOf(codemap)
    const right_edge = if detailOpen(codemap) { detailX(codemap) } else { surfaceWidth(codemap) }
    const bottom = surfaceHeight(codemap) - STATUS
    at = 0
    while at < count && codemap.*.labelCount < MAX_LABELS {
        const node = @intCast(u32, codemap.*.labelKeys[at] & 16777215)
        const index = @intCast(usize, node)
        const radius = shownRadius(codemap, node)
        const x = SIDEBAR + @intCast(i32, m.toInt(codemap.*.seenX[index] + radius)) + 5
        const y = TOOLBAR + @intCast(i32, m.toInt(codemap.*.seenY[index])) - 8
        const width = canvas_module.measure(small, nameOf(codemap, node))
        var fits = x >= SIDEBAR && y >= TOOLBAR && x + width < right_edge && y + 16 < bottom
        var other: usize = 0
        while fits && other < codemap.*.labelCount {
            const ox = codemap.*.labelX[other]
            const oy = codemap.*.labelY[other]
            if x < ox + codemap.*.labelWidth[other] + 6 && ox < x + width + 6 && y < oy + 16 && oy < y + 16 { fits = false }
            other += 1
        }
        if fits {
            codemap.*.labelNodes[codemap.*.labelCount] = node
            codemap.*.labelX[codemap.*.labelCount] = x
            codemap.*.labelY[codemap.*.labelCount] = y
            codemap.*.labelWidth[codemap.*.labelCount] = width
            codemap.*.labelCount += 1
        }
        at += 1
    }
}

fn drawLabels(codemap: *Codemap, canvas: *Canvas) -> void {
    const small = smallOf(codemap)
    var at: usize = 0
    while at < codemap.*.labelCount {
        const node = codemap.*.labelNodes[at]
        const record = nodeOf(codemap, node)
        const x = codemap.*.labelX[at]
        const y = codemap.*.labelY[at]
        var color = if record.*.kind == graph_module.DECLARATION { canvas_module.color(255, 200, 206, 218) } else { TEXT_COLOR }
        if node == codemap.*.selected { color = canvas_module.color(255, 255, 255, 255) }
        const related = codemap.*.related[@intCast(usize, node)]
        if related & 1 != 0 { color = canvasColor(OUTGOING, 255) } else if related & 2 != 0 { color = canvasColor(INCOMING, 255) }
        canvas_module.drawText(canvas, small, nameOf(codemap, node), x + 1, y + 1, canvas_module.color(170, 0, 0, 0), 0)
        canvas_module.drawText(canvas, small, nameOf(codemap, node), x, y, color, 0)
        at += 1
    }
}

// ---------------------------------------------------------------------------
// Hit testing

fn backX() -> i32 { return SIDEBAR + 12 }
fn forwardX() -> i32 { return SIDEBAR + 12 + BUTTON + 4 }
fn searchX(codemap: *Codemap) -> i32 { return surfaceWidth(codemap) - 14 - SEARCH_WIDTH }
fn keepX(codemap: *Codemap) -> i32 { return searchX(codemap) - 6 - BUTTON }
fn filterWidth(codemap: *Codemap) -> i32 { return canvas_module.measure(bodyOf(codemap), filterLabel(codemap)) + 36 }
fn filterX(codemap: *Codemap) -> i32 { return keepX(codemap) - 6 - filterWidth(codemap) }
fn filterLabel(codemap: *Codemap) -> []const u8 { return "Filter" }
fn baseWidth(codemap: *Codemap) -> i32 {
    var text: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = writeBaseLabel(codemap, bytes)
    return canvas_module.measure(bodyOf(codemap), bytes[0..length]) + 46 + changesPillWidth(codemap)
}
fn baseX(codemap: *Codemap) -> i32 { return filterX(codemap) - 8 - baseWidth(codemap) }

// The files changed and not committed, as a small count by the history's
// label (a commit running: "...").
fn writeChangesPill(codemap: *Codemap, into: [*]u8) -> usize {
    if codemap.*.job != JOB_NONE { return writeText(into, 0, "...") }
    if codemap.*.changeCount == 0 { return 0 }
    return writeNumberPlain(into, 0, codemap.*.changeCount)
}
fn changesPillWidth(codemap: *Codemap) -> i32 {
    var text: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = writeChangesPill(codemap, bytes)
    return if length == 0 { 0 } else { canvas_module.measure(smallOf(codemap), bytes[0..length]) + 20 }
}

// "Since HEAD" (the base of Changed; a commit by its short name).
fn writeBaseLabel(codemap: *Codemap, into: [*]u8) -> usize {
    var length = writeText(into, 0, say(codemap, "Since ", "Seit "))
    var base_bytes: [*]u8 = undefined
    unsafe { base_bytes = @ptrCast([*]u8, &codemap.*.diffBase) }
    const base = if codemap.*.diffBaseLength > 0 { base_bytes[0..codemap.*.diffBaseLength] } else { "HEAD" }
    return writeText(into, length, if base.length > 12 { base[0..7] } else { base })
}
fn resultsX(codemap: *Codemap) -> i32 { return searchX(codemap) - 150 }
fn resultsWidth() -> i32 { return SEARCH_WIDTH + 150 }
fn resultsShown(codemap: *Codemap) -> bool { return codemap.*.searchFocused && codemap.*.searchLength > 0 }

fn hitAt(codemap: *Codemap, x: i32, y: i32) -> usize {
    const width = surfaceWidth(codemap)
    const height = surfaceHeight(codemap)
    // An open list lies over the rest (the history: the commit's field and
    // buttons over its rows).
    if codemap.*.popup != POPUP_NONE {
        const rows = @intCast(i32, codemap.*.popupRows)
        if inside(x, y, codemap.*.popupX, TOOLBAR - 4, codemap.*.popupWidth, codemap.*.popupRowTop - TOOLBAR + 4 + rows * POPUP_ROW + 6) {
            if codemap.*.popup == POPUP_BASE && codemap.*.changeCount > 0 && y < codemap.*.popupRowTop {
                if y >= codemap.*.commitButtonsY && y < codemap.*.commitButtonsY + 30 {
                    if x >= codemap.*.pushButtonX { return HIT_COMMIT_PUSH }
                    if x >= codemap.*.commitButtonX { return HIT_COMMIT_DO }
                }
                if y >= codemap.*.commitFieldY && y < codemap.*.commitFieldY + 30 { return HIT_COMMIT_FIELD }
            }
            if y >= codemap.*.popupRowTop {
                const row = (y - codemap.*.popupRowTop) / POPUP_ROW
                if row >= 0 && row < rows { return HIT_POPUP_ROW + @intCast(usize, row) }
            }
            return HIT_POPUP
        }
    }
    // The search's results lie over the rest.
    if resultsShown(codemap) {
        const top = TOOLBAR - 4
        const rows = if codemap.*.resultCount > 0 { @intCast(i32, codemap.*.resultCount) } else { 1 }
        if inside(x, y, resultsX(codemap), top, resultsWidth(), rows * RESULT_ROW + 12) {
            const row = (y - top - 6) / RESULT_ROW
            if row >= 0 && row < @intCast(i32, codemap.*.resultCount) { return HIT_RESULT + @intCast(usize, row) }
            return HIT_NONE
        }
    }
    if x < SIDEBAR {
        if inside(x, y, 12, codemap.*.viewSwitchY, SIDEBAR - 24, 28) { return if x < SIDEBAR / 2 { HIT_VIEW_MAP } else { HIT_VIEW_EDITOR } }
        var section: usize = 0
        while section < SECTIONS {
            if inside(x, y, 8, codemap.*.headingY[section], SIDEBAR - 16, 20) { return HIT_HEADING + section }
            section += 1
        }
        var index: usize = 0
        while index < codemap.*.sidebarCount {
            if inside(x, y, 8, codemap.*.sidebarRowY[index], SIDEBAR - 16, GROUP_ROW) {
                // The check box (and what is left of it), else the row.
                if x < 32 + codemap.*.sidebarIndent[index] * 14 { return HIT_GROUP_CHECK + index }
                return HIT_GROUP + index
            }
            index += 1
        }
        index = 0
        while index < FINDINGS {
            if index < 3 && inside(x, y, 12 + @intCast(i32, index % 2) * 100, codemap.*.toggleTop - 3 + @intCast(i32, index / 2) * 20, 98, 19) { return HIT_TOGGLE + index }
            if inside(x, y, 8, codemap.*.findingY[index], SIDEBAR - 16, GROUP_ROW) {
                if x < 32 { return HIT_FINDING_CHECK + index }
                if index == @intCast(usize, FINDING_WORKAROUNDS) && x >= SIDEBAR - 72 && x < SIDEBAR - 50 { return HIT_DROPDOWN }
                return HIT_FINDING + index
            }
            index += 1
        }
        if inside(x, y, 8, codemap.*.programTop, SIDEBAR - 16, GROUP_ROW) { return HIT_PROGRAMS }
        index = 0
        while index < codemap.*.programRows {
            if inside(x, y, 26, codemap.*.programRowY[index], SIDEBAR - 34, SUB_ROW) { return HIT_PROGRAM + index }
            index += 1
        }
        index = 0
        while index < measures_module.METRICS {
            if inside(x, y, 8, codemap.*.metricY[index], SIDEBAR - 16, SUB_ROW) { return HIT_METRIC + index }
            index += 1
        }
        index = 0
        while index < codemap.*.patternRows {
            if inside(x, y, 26, codemap.*.patternY[index], SIDEBAR - 34, SUB_ROW) { return HIT_PATTERN + index }
            index += 1
        }
        index = 0
        while index < codemap.*.viewRows {
            if inside(x, y, 8, codemap.*.viewY[index], SIDEBAR - 16, SUB_ROW) { return if x >= SIDEBAR - 38 { HIT_VIEW_REMOVE + index } else { HIT_VIEW_ROW + index } }
            index += 1
        }
        index = 0
        while index < LEGEND_KINDS {
            if inside(x, y, 12 + @intCast(i32, index % 2) * 100, codemap.*.legendTop - 3 + @intCast(i32, index / 2) * 20, 98, 19) { return HIT_KIND + index }
            index += 1
        }
        return HIT_SIDEBAR
    }
    if y < TOOLBAR {
        const top = (TOOLBAR - BUTTON) / 2
        if inside(x, y, searchX(codemap), top, SEARCH_WIDTH, BUTTON) { return HIT_SEARCH }
        if inside(x, y, baseX(codemap), top, baseWidth(codemap), BUTTON) { return HIT_BASE }
        if inside(x, y, buildX(codemap), top, buildWidth(codemap), BUTTON) { return HIT_BUILD }
        if inside(x, y, filterX(codemap), top, filterWidth(codemap), BUTTON) { return HIT_FILTER }
        if inside(x, y, keepX(codemap), top, BUTTON, BUTTON) { return HIT_KEEP }
        return HIT_NONE
    }
    if y >= height - STATUS {
        var index: usize = 0
        while index < codemap.*.crumbCount {
            const left = codemap.*.crumbX[index]
            const right = if index + 1 < codemap.*.crumbCount { codemap.*.crumbX[index + 1] } else { left + 160 }
            if x >= left - 5 && x < right - 10 { return HIT_CRUMB + index }
            index += 1
        }
        return HIT_NONE
    }
    if detailOpen(codemap) && x >= detailX(codemap) {
        if inside(x, y, width - 38, TOOLBAR + 10, 28, 28) { return HIT_CLOSE }
        if inside(x, y, width - 104, TOOLBAR + 10, 30, 28) { return HIT_BACK }
        if inside(x, y, width - 72, TOOLBAR + 10, 30, 28) { return HIT_FORWARD }
        var index: usize = 0
        while index < codemap.*.detailRowCount {
            const row_y = codemap.*.detailRowY[index]
            const row_x = codemap.*.detailRowX[index]
            const row_width = codemap.*.detailRowWidth[index]
            if y >= row_y && y < row_y + DETAIL_ROW && row_y >= TOOLBAR && (row_width == 0 || (x >= row_x && x < row_x + row_width)) { return HIT_ROW + index }
            index += 1
        }
        return HIT_DETAIL
    }
    if codemap.*.view == VIEW_EDITOR {
        if y < TOOLBAR + TAB_BAR {
            var tab: usize = 0
            while tab < codemap.*.tabCount {
                if x >= codemap.*.tabX[tab] && x < codemap.*.tabX[tab] + codemap.*.tabWidth[tab] {
                    return if x >= codemap.*.tabX[tab] + codemap.*.tabWidth[tab] - 26 { HIT_TAB_CLOSE + tab } else { HIT_TAB + tab }
                }
                tab += 1
            }
            if hasTab(codemap) && x >= codemap.*.editorMapX { return HIT_EDITOR_MAP }
            if hasTab(codemap) && x >= codemap.*.editorSaveX && x < codemap.*.editorMapX - 6 { return HIT_EDITOR_SAVE }
            return HIT_NONE
        }
        if x >= editorRight(codemap) - 10 { return HIT_EDITOR_SCROLL }
        const in_refs = refsHit(codemap, x, y)
        if in_refs != HIT_NONE { return in_refs }
        var chip: usize = 0
        while chip < codemap.*.chipCount {
            if y >= codemap.*.chipY[chip] && y < codemap.*.chipY[chip] + EDITOR_LINE && x >= codemap.*.chipX0[chip] && x < codemap.*.chipX1[chip] { return HIT_CHIP + chip }
            chip += 1
        }
        return HIT_EDITOR
    }
    return HIT_VIEW
}

// The offset of the editor's text under (x, y).
fn editorOffsetAt(codemap: *Codemap, x: i32, y: i32) -> usize {
    const editor = activeEditor(codemap)
    const line = lineAtY(codemap, codemap.*.activeTab, if y < editorCodeTop() { editorCodeTop() } else { y })
    if line >= editor.*.lineCount { return editor.*.length }
    var column: i32 = 0
    if x > codemap.*.editorLeft { column = (x - codemap.*.editorLeft + codemap.*.charWidth / 2) / codemap.*.charWidth }
    return editor_module.offsetAt(editor, line, @intCast(usize, column))
}

fn setView(codemap: *Codemap, view: u8) -> void {
    if codemap.*.view == view { return }
    codemap.*.view = view
    codemap.*.searchFocused = false
    if view == VIEW_EDITOR && hasTab(codemap) { followCursor(codemap) }
    // Files saved in the editor: the map reads them again first.
    if view == VIEW_MAP && codemap.*.stale { reload(codemap) }
    if view == VIEW_MAP && codemap.*.selected != NONE { flyTo(codemap, codemap.*.selected) }
    if codemap.*.trace { traceLine(codemap, "view ", if view == VIEW_MAP { "map" } else { "editor" }) }
    panelOf(codemap).*.dirty = true
}

// A press in the editor: the cursor there (Shift: the selection to it;
// twice: the word; Ctrl: its declaration), and dragging selects.
fn pressEditor(codemap: *Codemap) -> void {
    if !hasTab(codemap) { return }
    codemap.*.completeOpen = false
    codemap.*.signatureActive = false
    const editor = activeEditor(codemap)
    const offset = editorOffsetAt(codemap, codemap.*.pointerX, codemap.*.pointerY)
    const held = modifiers(codemap)
    const now = panel_module.milliseconds()
    if held & CONTROL != 0 {
        goToDefinition(codemap, offset)
        return
    }
    if now < codemap.*.editorClickAt + 400 && offset == codemap.*.editorClickOffset {
        var start: usize = 0
        var end: usize = 0
        editor_module.wordAt(editor, offset, &start, &end)
        editor.*.anchor = start
        editor.*.cursor = end
        codemap.*.editorClickAt = 0
        return
    }
    codemap.*.editorClickAt = now
    codemap.*.editorClickOffset = offset
    editor_module.moveTo(editor, offset, held & SHIFT != 0)
    codemap.*.editorDragging = true
    followCursor(codemap)
}

// The keys in the editor; false when it is not the editor's.
fn editorKey(codemap: *Codemap, key: u32) -> bool {
    if !hasTab(codemap) { return false }
    const editor = activeEditor(codemap)
    const held = modifiers(codemap)
    const control = held & CONTROL != 0
    const shift = held & SHIFT != 0
    const alt = held & ALT != 0
    const tab = codemap.*.activeTab
    const line_before = editor_module.lineOf(editor, editor_module.selectionStart(editor))
    const lines_before = editor.*.lineCount
    const version_before = editor.*.version
    const cursor_before = editor.*.cursor
    var typed: u8 = 0
    if alt { return false }
    if key == KEY_LEFT {
        editor_module.left(editor, shift, control)
    } else if key == KEY_RIGHT {
        editor_module.right(editor, shift, control)
    } else if key == KEY_UP {
        editor_module.vertical(editor, -1, shift)
    } else if key == KEY_DOWN {
        editor_module.vertical(editor, 1, shift)
    } else if key == KEY_PAGE_UP {
        editor_module.vertical(editor, -@intCast(isize, editorRows(codemap)), shift)
    } else if key == KEY_PAGE_DOWN {
        editor_module.vertical(editor, @intCast(isize, editorRows(codemap)), shift)
    } else if key == KEY_HOME {
        if control { editor_module.moveTo(editor, 0, shift) } else { editor_module.home(editor, shift) }
    } else if key == KEY_END {
        if control { editor_module.moveTo(editor, editor.*.length, shift) } else { editor_module.end(editor, shift) }
    } else if key == KEY_BACKSPACE {
        editor_module.backspace(editor, control)
    } else if key == KEY_DELETE {
        editor_module.delete(editor, control)
    } else if key == KEY_ENTER || key == KEY_KP_ENTER {
        editor_module.newline(editor)
    } else if key == KEY_TAB {
        editor_module.tab(editor)
    } else if key == KEY_ESCAPE {
        if !editor_module.hasSelection(editor) { return false }
        editor_module.moveTo(editor, editor.*.cursor, false)
    } else if key == KEY_F12 {
        goToDefinition(codemap, editor.*.cursor)
        return true
    } else if control && key == KEY_S {
        saveTab(codemap)
        return true
    } else if control && key == KEY_Z {
        if shift { editor_module.redo(editor) } else { editor_module.undo(editor) }
    } else if control && key == KEY_Y {
        editor_module.redo(editor)
    } else if control && key == KEY_A {
        editor_module.selectAll(editor)
    } else if control && key == KEY_C {
        editor_module.copy(editor)
        return true
    } else if control && key == KEY_X {
        editor_module.cut(editor)
    } else if control && key == KEY_V {
        editor_module.paste(editor, editor_module.clipboardText(editor))
    } else if control {
        return false
    } else {
        const panel = panelOf(codemap)
        if panel.*.textLength == 0 || panel.*.text[0] < 32 { return false }
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrCast([*]const u8, &panel.*.text) }
        editor_module.insert(editor, bytes[0..panel.*.textLength])
        typed = bytes[panel.*.textLength - 1]
    }
    // The clipboard is one for all tabs.
    var other: usize = 0
    while other < codemap.*.tabCount {
        if other != tab {
            editorAt(codemap, other).*.clipboard = editor.*.clipboard
            editorAt(codemap, other).*.clipboardLength = editor.*.clipboardLength
        }
        other += 1
    }
    if editor.*.version != version_before { shiftMarks(codemap, tab, line_before, lines_before) }
    keepCursorSeen(codemap)
    if editor.*.cursor != cursor_before { followCursor(codemap) }
    // A name typed (or a dot, an @): what fits; a call opened: its
    // signature.
    if typed != 0 && (isNameByte(typed) || typed == 46 || typed == 64) {
        updateCompletion(codemap)
    } else if key == KEY_BACKSPACE && codemap.*.completeOpen {
        updateCompletion(codemap)
    } else {
        codemap.*.completeOpen = false
    }
    if typed == 40 || typed == 44 { codemap.*.signatureActive = true }
    if key == KEY_ESCAPE { codemap.*.signatureActive = false }
    return true
}

fn groupTop(index: usize) -> i32 { return 44 + @intCast(i32, index) * GROUP_ROW }

// ---------------------------------------------------------------------------
// Input

fn press(codemap: *Codemap, hit: usize, button: u32) -> void {
    const now = panel_module.milliseconds()
    codemap.*.pressed = true
    codemap.*.pressButton = button
    codemap.*.pressHit = hit
    codemap.*.moved = false
    if button != BUTTON_LEFT { return }
    const was_focused = codemap.*.searchFocused
    codemap.*.searchFocused = hit == HIT_SEARCH || (was_focused && hit >= HIT_RESULT && hit < HIT_RESULT + RESULTS)
    // A click anywhere but in it closes the open list.
    const open_popup = codemap.*.popup
    if hit != HIT_POPUP && hit != HIT_COMMIT_FIELD && hit != HIT_COMMIT_DO && hit != HIT_COMMIT_PUSH && !(hit >= HIT_POPUP_ROW && hit < HIT_POPUP_ROW + 64) { codemap.*.popup = POPUP_NONE }
    if hit != HIT_REFS && !(hit >= HIT_REF_ROW && hit < HIT_REF_ROW + 64) && !(hit >= HIT_CHIP && hit < HIT_CHIP + MAX_CHIPS) { codemap.*.refsOpen = false }
    if hit >= HIT_POPUP_ROW && hit < HIT_POPUP_ROW + 64 {
        choosePopupRow(codemap, hit - HIT_POPUP_ROW)
    } else if hit == HIT_BUILD {
        startBuild(codemap)
    } else if hit == HIT_COMMIT_DO {
        startCommit(codemap, false)
    } else if hit == HIT_COMMIT_PUSH {
        startCommit(codemap, true)
    } else if hit == HIT_VIEW_MAP {
        setView(codemap, VIEW_MAP)
    } else if hit == HIT_VIEW_EDITOR {
        setView(codemap, VIEW_EDITOR)
    } else if hit >= HIT_CHIP && hit < HIT_CHIP + MAX_CHIPS {
        pressChip(codemap, hit - HIT_CHIP)
    } else if hit >= HIT_REF_ROW && hit < HIT_REF_ROW + 64 {
        openRef(codemap, codemap.*.refsScroll + hit - HIT_REF_ROW)
    } else if hit == HIT_REFS {
        // In the list: it stays.
    } else if hit == HIT_EDITOR {
        pressEditor(codemap)
    } else if hit >= HIT_TAB && hit < HIT_TAB + MAX_TABS {
        codemap.*.activeTab = hit - HIT_TAB
        followCursor(codemap)
    } else if hit >= HIT_TAB_CLOSE && hit < HIT_TAB_CLOSE + MAX_TABS {
        const tab = hit - HIT_TAB_CLOSE
        if editor_module.isDirty(editorAt(codemap, tab)) && modifiers(codemap) & SHIFT == 0 {
            setNote(codemap, say(codemap, "Not saved: Ctrl+S saves it, Shift+click closes it anyway", "Nicht gespeichert: Strg+S speichert, Umschalt+Klick schließt trotzdem"), "")
        } else {
            closeTab(codemap, tab)
        }
    } else if hit == HIT_EDITOR_SAVE {
        saveTab(codemap)
    } else if hit == HIT_EDITOR_MAP {
        const editor = activeEditor(codemap)
        const symbol = declarationOnLine(codemap, codemap.*.activeTab, editor_module.lineOf(editor, editor.*.cursor))
        var node = if symbol != NONE { nodeOfSymbol(codemap, symbol) } else { NONE }
        if node == NONE && codemap.*.tabFile[codemap.*.activeTab] != NONE { node = nodeOfSymbol(codemap, index_module.fileAt(codemap.*.index, codemap.*.tabFile[codemap.*.activeTab]).*.symbol) }
        setView(codemap, VIEW_MAP)
        if node != NONE { goTo(codemap, node) }
    } else if hit == HIT_BASE {
        if open_popup != POPUP_BASE { openPopup(codemap, POPUP_BASE) }
    } else if hit == HIT_FILTER {
        if open_popup != POPUP_FILTER { openPopup(codemap, POPUP_FILTER) }
    } else if hit == HIT_KEEP {
        saveView(codemap)
    } else if hit == HIT_BACK {
        goBack(codemap)
    } else if hit == HIT_FORWARD {
        goForward(codemap)
    } else if hit == HIT_CLOSE {
        if codemap.*.rewritePattern != 255 {
            codemap.*.rewritePattern = 255
        } else if codemap.*.selected != NONE {
            select(codemap, NONE)
        } else {
            openFinding(codemap, FINDING_NONE)
        }
    } else if hit >= HIT_GROUP_CHECK && hit < HIT_GROUP_CHECK + SIDEBAR_ROWS {
        toggleGroup(codemap, codemap.*.sidebarNodes[hit - HIT_GROUP_CHECK])
    } else if hit >= HIT_FINDING_CHECK && hit < HIT_FINDING_CHECK + FINDINGS {
        const which = hit - HIT_FINDING_CHECK
        codemap.*.findingOn[which] = !codemap.*.findingOn[which]
        refreshFindings(codemap)
    } else if hit == HIT_DROPDOWN {
        codemap.*.workaroundsOpen = !codemap.*.workaroundsOpen
    } else if hit >= HIT_PATTERN && hit < HIT_PATTERN + 9 {
        const pattern = @intCast(usize, codemap.*.patternOrder[hit - HIT_PATTERN])
        codemap.*.patternOn[pattern] = !codemap.*.patternOn[pattern]
        codemap.*.findingOn[@intCast(usize, FINDING_WORKAROUNDS)] = true
        refreshFindings(codemap)
    } else if hit == HIT_PROGRAMS {
        codemap.*.programsOpen = !codemap.*.programsOpen
    } else if hit >= HIT_PROGRAM && hit < HIT_PROGRAM + 128 {
        const row = hit - HIT_PROGRAM
        chooseProgram(codemap, if row == 0 { programsOf(codemap).*.count } else { @intCast(usize, codemap.*.programOrder[row - 1]) })
    } else if hit >= HIT_METRIC && hit < HIT_METRIC + measures_module.METRICS {
        codemap.*.metric = @intCast(u8, hit - HIT_METRIC)
        computeMetric(codemap)
        if codemap.*.trace { traceLine(codemap, "color by ", measures_module.name(codemap.*.metric, false)) }
    } else if hit >= HIT_HEADING && hit < HIT_HEADING + SECTIONS {
        toggleSection(codemap, hit - HIT_HEADING)
    } else if hit >= HIT_VIEW_REMOVE && hit < HIT_VIEW_REMOVE + 64 {
        const views = viewsOf(codemap)
        if codemap.*.trace { traceLine(codemap, "view removed ", views_module.nameOf(views, hit - HIT_VIEW_REMOVE)) }
        const removed = views_module.remove(views, rootText(codemap), hit - HIT_VIEW_REMOVE)
    } else if hit >= HIT_VIEW_ROW && hit < HIT_VIEW_ROW + 64 {
        const views = viewsOf(codemap)
        const query = views_module.queryOf(views, hit - HIT_VIEW_ROW)
        // Chosen again: shown no more.
        if codemap.*.queryActive && sameBytes(searchQuery(codemap), query) { clearSearch(codemap) } else { setSearch(codemap, query) }
        if codemap.*.trace { traceLine(codemap, "view ", views_module.nameOf(views, hit - HIT_VIEW_ROW)) }
    } else if hit >= HIT_KIND && hit < HIT_KIND + LEGEND_KINDS {
        toggleKind(codemap, hit - HIT_KIND)
    } else if hit >= HIT_FINDING && hit < HIT_FINDING + FINDINGS {
        const which = @intCast(u8, hit - HIT_FINDING)
        select(codemap, NONE)
        openFinding(codemap, if codemap.*.finding == which { FINDING_NONE } else { which })
    } else if hit >= HIT_RESULT && hit < HIT_RESULT + RESULTS {
        chooseResult(codemap, hit - HIT_RESULT)
    } else if hit >= HIT_GROUP && hit < HIT_GROUP + SIDEBAR_ROWS {
        goTo(codemap, codemap.*.sidebarNodes[hit - HIT_GROUP])
    } else if hit >= HIT_TOGGLE && hit < HIT_TOGGLE + 3 {
        const which = hit - HIT_TOGGLE
        if which == 0 { codemap.*.showImports = !codemap.*.showImports }
        if which == 1 { codemap.*.showTree = !codemap.*.showTree }
        if which == 2 { codemap.*.showLabels = !codemap.*.showLabels }
    } else if hit >= HIT_CRUMB && hit < HIT_CRUMB + 32 {
        goTo(codemap, codemap.*.crumbNodes[hit - HIT_CRUMB])
    } else if hit >= HIT_ROW && hit < HIT_ROW + DETAIL_ROWS {
        const row = hit - HIT_ROW
        const kind = codemap.*.detailRowKind[row]
        if kind == ROW_NODE {
            goTo(codemap, codemap.*.detailRows[row])
        } else if kind == ROW_MORE {
            codemap.*.expanded[@intCast(usize, codemap.*.detailRows[row])] = true
        } else if kind == ROW_REWRITE {
            planRewrite(codemap, @intCast(u8, codemap.*.detailRows[row]))
        } else if kind == ROW_APPLY {
            applyRewrite(codemap)
        } else if kind == ROW_BACK {
            codemap.*.rewritePattern = 255
            codemap.*.detailScroll = 0
        } else if kind == ROW_HISTORY {
            countHistory(codemap)
        } else if kind == ROW_PROFILE {
            startProfile(codemap)
        } else {
            openInEditor(codemap, codemap.*.selected)
        }
    }
    codemap.*.lastClick = now
}

fn release(codemap: *Codemap) -> void {
    const was_pressed = codemap.*.pressed
    codemap.*.pressed = false
    codemap.*.editorDragging = false
    if !was_pressed || codemap.*.pressHit != HIT_VIEW || codemap.*.moved || codemap.*.pressButton != BUTTON_LEFT { return }
    // A click in the view: selects; twice flies there.
    const node = nodeAt(codemap, codemap.*.pointerX, codemap.*.pointerY)
    const now = panel_module.milliseconds()
    const is_double = now < codemap.*.lastClickHit + 450 && node == codemap.*.lastClickNode
    codemap.*.lastClickHit = if is_double { 0 } else { now }
    codemap.*.lastClickNode = node
    if node == NONE {
        if is_double { goUp(codemap) } else { select(codemap, NONE) }
        return
    }
    select(codemap, node)
    if is_double { flyTo(codemap, node) }
}

fn motion(codemap: *Codemap, x: i32, y: i32) -> bool {
    const dx = x - codemap.*.pointerX
    const dy = y - codemap.*.pointerY
    codemap.*.pointerX = x
    codemap.*.pointerY = y
    if codemap.*.editorDragging && hasTab(codemap) {
        const editor = activeEditor(codemap)
        editor_module.moveTo(editor, editorOffsetAt(codemap, x, y), true)
        // Beyond the top or the bottom: it scrolls.
        if y < editorCodeTop() && editor.*.top > 0 { editor.*.top -= 1 }
        if y > editorBottom(codemap) && editor.*.top + 1 < editor.*.lineCount { editor.*.top += 1 }
        return true
    }
    if codemap.*.view == VIEW_EDITOR && hasTab(codemap) {
        // Over a line number: its blame.
        const gutter_before = codemap.*.gutterHover
        codemap.*.gutterHover = if x >= SIDEBAR && x < codemap.*.editorLeft - 8 && y >= editorCodeTop() && y < editorBottom(codemap) && hitAt(codemap, x, y) == HIT_EDITOR { lineAtY(codemap, codemap.*.activeTab, y) } else { 18446744073709551615 }
        if gutter_before != codemap.*.gutterHover {
            codemap.*.hover = hitAt(codemap, x, y)
            return true
        }
        const before = codemap.*.editorHover
        codemap.*.editorHover = if hitAt(codemap, x, y) == HIT_EDITOR && x >= codemap.*.editorLeft { editorOffsetAt(codemap, x, y) } else { 18446744073709551615 }
        // Only a name: between words none.
        if codemap.*.editorHover != 18446744073709551615 {
            const editor = activeEditor(codemap)
            var start: usize = 0
            var end: usize = 0
            editor_module.wordAt(editor, codemap.*.editorHover, &start, &end)
            codemap.*.editorHover = if end > start { start } else { 18446744073709551615 }
        }
        if before != codemap.*.editorHover {
            const hit = hitAt(codemap, x, y)
            codemap.*.hover = hit
            return true
        }
    }
    if codemap.*.pressed && codemap.*.pressHit == HIT_VIEW {
        const far_x = x - codemap.*.pressX
        const far_y = y - codemap.*.pressY
        if !codemap.*.moved && far_x * far_x + far_y * far_y > 16 { codemap.*.moved = true }
        if codemap.*.moved {
            const panning = codemap.*.pressButton != BUTTON_LEFT || modifiers(codemap) & SHIFT != 0
            if panning {
                pan(codemap, dx, dy)
            } else {
                orbit(codemap, -m.toFloat(@intCast(i64, dx)) * 0.006, m.toFloat(@intCast(i64, dy)) * 0.006)
            }
            return true
        }
        return false
    }
    var changed = false
    const hit = hitAt(codemap, x, y)
    if hit != codemap.*.hover {
        codemap.*.hover = hit
        changed = true
    }
    const node = if hit == HIT_VIEW && codemap.*.built { nodeAt(codemap, x, y) } else { NONE }
    if node != codemap.*.hoverNode {
        codemap.*.hoverNode = node
        changed = true
    }
    return changed
}

fn onKey(codemap: *Codemap, key: u32) -> void {
    const held = modifiers(codemap)
    const control = held & CONTROL != 0
    const alt = held & ALT != 0
    if control && key == KEY_W {
        // Edits not saved: a second Ctrl+W (within 4 s) closes anyway.
        const now = panel_module.milliseconds()
        if unsavedTabs(codemap) > 0 && now > codemap.*.closeAskedAt + 4000 {
            codemap.*.closeAskedAt = now
            setNote(codemap, say(codemap, "Tabs not saved: Ctrl+S saves, Ctrl+W again closes anyway", "Tabs nicht gespeichert: Strg+S speichert, nochmal Strg+W schließt trotzdem"), "")
            return
        }
        panelOf(codemap).*.running = false
        return
    }
    if control && key == KEY_F || (!codemap.*.searchFocused && key == KEY_SLASH && !control && !alt) {
        codemap.*.searchFocused = true
        return
    }
    if !codemap.*.built { return }
    // The history open with something to commit: the keys write its message.
    if codemap.*.popup == POPUP_BASE && codemap.*.changeCount > 0 && commitKey(codemap, key) {
        panelOf(codemap).*.dirty = true
        return
    }
    if control && key == KEY_B {
        startBuild(codemap)
        return
    }
    if control && key == KEY_K {
        if codemap.*.popup == POPUP_BASE { codemap.*.popup = POPUP_NONE } else { openPopup(codemap, POPUP_BASE) }
        return
    }
    if control && key == KEY_E {
        setView(codemap, if codemap.*.view == VIEW_MAP { VIEW_EDITOR } else { VIEW_MAP })
        return
    }
    if control && held & SHIFT != 0 && key == KEY_O {
        openExternally(codemap, codemap.*.selected)
        return
    }
    // The references list, then the editor's keys (not while the search or
    // a list has them).
    if codemap.*.view == VIEW_EDITOR && (renameKey(codemap, key) || refsKey(codemap, key) || completeKey(codemap, key)) {
        panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == VIEW_EDITOR && key == KEY_ESCAPE && codemap.*.signatureActive {
        codemap.*.signatureActive = false
        panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == VIEW_EDITOR && key == KEY_F2 {
        startRename(codemap)
        panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == VIEW_EDITOR && key == KEY_F12 && held & SHIFT != 0 && hasTab(codemap) {
        const editor = activeEditor(codemap)
        const cursor_y = lineY(codemap, codemap.*.activeTab, editor_module.lineOf(editor, editor.*.cursor))
        openRefs(codemap, symbolAtCursor(codemap, editor.*.cursor), codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, editor.*.cursor)) * codemap.*.charWidth, cursor_y + EDITOR_LINE)
        return
    }
    if codemap.*.view == VIEW_EDITOR && !codemap.*.searchFocused && codemap.*.popup == POPUP_NONE {
        if editorKey(codemap, key) {
            panelOf(codemap).*.dirty = true
            return
        }
    }
    if control && key == KEY_S {
        saveView(codemap)
        return
    }
    if codemap.*.searchFocused && !control && !alt {
        searchKey(codemap, key)
        return
    }
    if key == KEY_F5 || (control && key == KEY_R) {
        reload(codemap)
    } else if control && key == KEY_O {
        openInEditor(codemap, codemap.*.selected)
    } else if alt && key == KEY_LEFT || key == KEY_BACKSPACE {
        goBack(codemap)
    } else if alt && key == KEY_RIGHT {
        goForward(codemap)
    } else if alt && key == KEY_UP {
        goUp(codemap)
    } else if key == KEY_ENTER || key == KEY_KP_ENTER {
        if codemap.*.selected != NONE { flyTo(codemap, codemap.*.selected) }
    } else if key == KEY_ESCAPE {
        if codemap.*.popup != POPUP_NONE {
            codemap.*.popup = POPUP_NONE
        } else if codemap.*.searchLength > 0 {
            clearSearch(codemap)
        } else if codemap.*.view == VIEW_EDITOR {
            // The editor keeps its file (the map's selection stays).
        } else if codemap.*.selected != NONE {
            select(codemap, NONE)
        } else if codemap.*.finding != FINDING_NONE {
            openFinding(codemap, FINDING_NONE)
        } else {
            goUp(codemap)
        }
    } else if codemap.*.view == VIEW_EDITOR {
        if !control && !alt { typeInto(codemap) }
    } else if key == KEY_HOME {
        goTo(codemap, graphOf(codemap).*.root)
    } else if key == KEY_LEFT {
        orbit(codemap, 0.12, 0.0)
    } else if key == KEY_RIGHT {
        orbit(codemap, -0.12, 0.0)
    } else if key == KEY_UP {
        orbit(codemap, 0.0, -0.1)
    } else if key == KEY_DOWN {
        orbit(codemap, 0.0, 0.1)
    } else if key == KEY_EQUAL || key == KEY_KP_PLUS || key == KEY_PAGE_UP {
        zoom(codemap, 0.8)
    } else if key == KEY_MINUS || key == KEY_KP_MINUS || key == KEY_PAGE_DOWN {
        zoom(codemap, 1.25)
    } else if !control && !alt {
        typeInto(codemap)
    }
}

// Events, frames and the scene make only temporaries in the compiler's
// arena (tools/codemap/aggregates.mlx): it is taken back after each.
fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const codemap = codemapOf(context)
    const where = aggregates.mark(codemap.*.graph.arena)
    handleEvent(codemap, kind, a, b)
    aggregates.reset(codemap.*.graph.arena, where)
}

fn handleEvent(codemap: *Codemap, kind: u32, a: u32, b: i32) -> void {
    const panel = panelOf(codemap)
    if kind == panel_module.EVENT_CONFIGURED {
        // Blur behind the translucent sidebar.
        var rects: [4]i32 = [4]i32{ 0, 0, SIDEBAR, surfaceHeight(codemap) }
        unsafe { panel_module.setBlur(panel, @ptrCast([*]const i32, &rects), 1) }
    } else if kind == panel_module.EVENT_MOTION {
        if !motion(codemap, @bitCast(i32, a), b) { return }
    } else if kind == panel_module.EVENT_LEAVE {
        codemap.*.hover = HIT_NONE
        codemap.*.hoverNode = NONE
    } else if kind == panel_module.EVENT_BUTTON {
        if b == 1 {
            codemap.*.pressX = codemap.*.pointerX
            codemap.*.pressY = codemap.*.pointerY
            press(codemap, hitAt(codemap, codemap.*.pointerX, codemap.*.pointerY), a)
        } else {
            release(codemap)
        }
    } else if kind == panel_module.EVENT_WHEEL {
        if a != 0 { return }
        var pixels = panel.*.wheelPixels
        if pixels == 0 { pixels = b * 15 }
        const hit = hitAt(codemap, codemap.*.pointerX, codemap.*.pointerY)
        if hit == HIT_DETAIL || (hit >= HIT_ROW && hit < HIT_ROW + DETAIL_ROWS) || hit == HIT_CLOSE {
            codemap.*.detailScroll += pixels * 3
            if codemap.*.detailScroll > codemap.*.detailHeight - (viewHeight(codemap) - 40) { codemap.*.detailScroll = codemap.*.detailHeight - (viewHeight(codemap) - 40) }
            if codemap.*.detailScroll < 0 { codemap.*.detailScroll = 0 }
        } else if (hit == HIT_EDITOR || hit == HIT_EDITOR_SCROLL) && hasTab(codemap) {
            const editor = activeEditor(codemap)
            var lines = @intCast(isize, pixels) / 6
            if lines == 0 { lines = if pixels > 0 { 1 } else { -1 } }
            var top = @intCast(isize, editor.*.top) + lines
            if top < 0 { top = 0 }
            if top >= @intCast(isize, editor.*.lineCount) { top = @intCast(isize, editor.*.lineCount) - 1 }
            editor.*.top = @intCast(usize, top)
            codemap.*.editorHover = 18446744073709551615
        } else if hit == HIT_VIEW {
            zoom(codemap, m.exp(m.toFloat(@intCast(i64, pixels)) * 0.012))
        } else if codemap.*.pointerX < SIDEBAR {
            codemap.*.sidebarScroll += pixels * 3
        }
    } else if kind == panel_module.EVENT_KEY {
        trackModifier(codemap, a, b != 0)
        if b == 0 { return }
        onKey(codemap, a)
    } else if kind == panel_module.EVENT_KEYBOARD_LEAVE {
        codemap.*.held = 0
        return
    } else if kind == panel_module.EVENT_TICK {
        tick(codemap)
        return
    }
    panel.*.dirty = true
}

// Every tick: the code read once the window shows, the flight on.
fn tick(codemap: *Codemap) -> void {
    const panel = panelOf(codemap)
    if !codemap.*.built {
        if !codemap.*.drawnOnce { return }
        buildIndex(codemap)
        startView(codemap)
        applyStart(codemap)
        panel.*.dirty = true
    }
    if codemap.*.flying { panel.*.dirty = true }
    if codemap.*.noteLength > 0 && panel_module.milliseconds() >= codemap.*.noteUntil {
        codemap.*.noteLength = 0
        panel.*.dirty = true
    }
    watchJobs(codemap)
    pumpCheck(codemap)
    runDemo(codemap)
    // The history (Git) read on, a little each tick.
    if codemap.*.built && !history_module.finished(historyOf(codemap)) { stepHistory(codemap) }
    // A crash since the log was read: flag it.
    if codemap.*.built && panel_module.milliseconds() >= codemap.*.crashCheckAt {
        codemap.*.crashCheckAt = panel_module.milliseconds() + CRASH_CHECK
        watchDisk(codemap)
        // New profiles (mlx-profile wrote one): read them again.
        const profiles_time = profilesTime(codemap)
        if profiles_time != codemap.*.profilesTime {
            codemap.*.profilesTime = profiles_time
            profiles_module.load(profilesOf(codemap), codemap.*.index, codemap.*.environment)
            computeMetric(codemap)
            refreshFindings(codemap)
            panel.*.dirty = true
        }
        const size = crashLogSize(codemap)
        if size != codemap.*.crashLogSize {
            const before = crashesOf(codemap).*.count
            loadCrashes(codemap)
            refreshFindings(codemap)
            if crashesOf(codemap).*.count > before { noteCrash(codemap) }
            if codemap.*.trace && crashesOf(codemap).*.count > before { traceLine(codemap, "new crash in ", crashes_module.field(crashesOf(codemap), @intCast(u32, crashesOf(codemap).*.count - 1), 2)) }
            panel.*.dirty = true
        }
    }
    panel.*.tickInterval = if codemap.*.flying || codemap.*.demoActive { 16 } else if codemap.*.built && !history_module.finished(historyOf(codemap)) { 30 } else if codemap.*.noteLength > 0 { 250 } else if checkOf(codemap).*.running || buildOf(codemap).*.running || codemap.*.job != JOB_NONE { 100 } else if codemap.*.historyJob > 0 || codemap.*.profileJob > 0 { 500 } else { CRASH_CHECK }
}

// A file's time (ms; -1: it is not there).
fn fileStamp(path: []const u8) -> isize {
    var name: [1100]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &name) }
    if path.length >= 1090 { return -1 }
    const length = writeText(bytes, 0, path)
    bytes[length] = 0
    var status: std.fs.Stat = undefined
    if std.fs.status(bytes, &status) != 0 { return -1 }
    return status.modifiedSeconds * 1000 + status.modifiedNanoseconds / 1000000
}

// The newest time of the indexed files and of their folders (a file added
// or taken out changes its folder's), and how many files are there.
fn readDiskStamp(codemap: *Codemap, count: *usize) -> isize {
    const index = codemap.*.index
    var newest: isize = 0
    count.* = 0
    var last_folder: usize = 0
    var last_file: u32 = NONE
    var file: usize = 0
    while file < index.*.fileCount {
        const path = index_module.pathOf(index, @intCast(u32, file))
        const stamp = fileStamp(path)
        if stamp >= 0 {
            count.* += 1
            if stamp > newest { newest = stamp }
        }
        var folder = path.length
        while folder > 0 && path[folder - 1] != 47 { folder -= 1 }
        if folder > 1 && !(last_file != NONE && folder == last_folder && sameBytes(path[0..folder], index_module.pathOf(index, last_file)[0..folder])) {
            const folder_stamp = fileStamp(path[0..folder - 1])
            if folder_stamp > newest { newest = folder_stamp }
            last_folder = folder
            last_file = @intCast(u32, file)
        }
        file += 1
    }
    return newest
}

// Every few seconds: files changed on disk (Git, another editor). Tabs
// without edits read their file again; the map reads the code again (in
// the editor: when it is shown next).
fn watchDisk(codemap: *Codemap) -> void {
    if !codemap.*.built || codemap.*.demoActive { return }
    watchDiskTabs(codemap)
    var count: usize = 0
    const stamp = readDiskStamp(codemap, &count)
    if stamp == codemap.*.diskSeenStamp && count == codemap.*.diskSeenCount { return }
    codemap.*.diskSeenStamp = stamp
    codemap.*.diskSeenCount = count
    if codemap.*.view == VIEW_MAP && codemap.*.popup == POPUP_NONE && !codemap.*.pressed {
        reload(codemap)
        setNote(codemap, say(codemap, "Files changed: read again", "Dateien geändert: neu eingelesen"), "")
    } else {
        codemap.*.stale = true
    }
    panelOf(codemap).*.dirty = true
}

// Tabs without edits whose file changed read it again.
fn watchDiskTabs(codemap: *Codemap) -> void {
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = editorAt(codemap, tab)
        const stamp = fileStamp(editor_module.pathOf(editor))
        if stamp >= 0 && stamp != codemap.*.tabStamp[tab] && !editor_module.isDirty(editor) {
            var path: [1100]u8 = undefined
            var path_bytes: [*]u8 = undefined
            unsafe { path_bytes = @ptrCast([*]u8, &path) }
            const path_length = writeText(path_bytes, 0, editor_module.pathOf(editor))
            const line = editor_module.lineOf(editor, editor.*.cursor)
            const top = editor.*.top
            if editor_module.load(editor, path_bytes[0..path_length]) {
                editor_module.moveTo(editor, editor_module.offsetAt(editor, if line < editor.*.lineCount { line } else { editor.*.lineCount - 1 }, 0), false)
                editor.*.top = if top < editor.*.lineCount { top } else { 0 }
                // The index is older than the text now.
                codemap.*.tabIndexed[tab] = 18446744073709551615
                computeMarks(codemap, tab)
                requestCheck(codemap, tab)
                if codemap.*.trace { traceLine(codemap, "tab read again ", tabRelative(codemap, tab)) }
            }
            codemap.*.tabStamp[tab] = stamp
            panelOf(codemap).*.dirty = true
        }
        tab += 1
    }
}

// A note of the newest crash in the status bar.
fn noteCrash(codemap: *Codemap) -> void {
    const crashes = crashesOf(codemap)
    if crashes.*.count == 0 { return }
    const record = @intCast(u32, crashes.*.count - 1)
    var text: [160]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeText(bytes, 0, crashes_module.field(crashes, record, 2))
    length = writeText(bytes, length, say(codemap, " crashed: ", " ist abgestürzt: "))
    const reason = crashes_module.field(crashes, record, 3)
    length = writeText(bytes, length, if reason.length > 100 { reason[0..100] } else { reason })
    setNote(codemap, bytes[0..length], "")
}

// The first view: the whole, coming closer.
fn startView(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    const camera = cameraOf(codemap)
    const root = graph.*.root
    codemap.*.focus = root
    camera.*.target = middleOf(codemap, root)
    camera.*.distance = extentOf(codemap, root) * 7.0
    camera.*.yaw = -0.9
    camera.*.pitch = 0.55
    flyTo(codemap, root)
    codemap.*.toYaw = -0.4
    codemap.*.toPitch = 0.3
    codemap.*.bump = 0.0
    codemap.*.flyDuration = 1400
}

// ---------------------------------------------------------------------------
// Drawing

fn drawChevron(canvas: *Canvas, x: i32, y: i32, left: bool, color: u32, size: i32, thickness: i32) -> void {
    const half = size / 2
    var row: i32 = 0
    while row < size {
        const offset = if row < half { half - row } else { row - half }
        const column = if left { x + offset } else { x + half - offset }
        canvas_module.fillRect(canvas, column, y + row, thickness, 1, color)
        row += 1
    }
}

fn drawButton(codemap: *Codemap, canvas: *Canvas, x: i32, width: i32, hit: usize) -> void {
    const top = (TOOLBAR - BUTTON) / 2
    if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x, top, width, BUTTON, 8, canvas_module.color(255, 50, 54, 66)) }
}

// A magnifier: a ring and its handle.
fn drawSearchGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 11, 11, 5, 2, color)
    var step: i32 = 0
    while step < 5 {
        canvas_module.fillRect(canvas, x + 9 + step, y + 9 + step, 2, 2, color)
        step += 1
    }
}

// A bookmark: a band with a notch at its foot.
fn drawBookmark(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y, 10, 11, color)
    var step: i32 = 0
    while step < 5 {
        canvas_module.fillRect(canvas, x, y + 11 + step, 5 - step, 1, color)
        canvas_module.fillRect(canvas, x + 5 + step, y + 11 + step, 5 - step, 1, color)
        step += 1
    }
}

fn drawDot(canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, size, size, size / 2, color)
}

fn drawToolbar(codemap: *Codemap, canvas: *Canvas) -> void {
    const width = surfaceWidth(codemap)
    canvas_module.fillRect(canvas, SIDEBAR, 0, width - SIDEBAR, TOOLBAR, canvas_module.color(255, 36, 38, 47))
    canvas_module.fillRect(canvas, SIDEBAR, TOOLBAR - 1, width - SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    const top = (TOOLBAR - BUTTON) / 2
    // What is selected (else what the camera is on); in the editor, the
    // file shown.
    const title_x = SIDEBAR + 18
    const shown = if codemap.*.selected != NONE { codemap.*.selected } else { codemap.*.focus }
    const title = if codemap.*.view == VIEW_EDITOR && hasTab(codemap) { tabRelative(codemap, codemap.*.activeTab) } else if codemap.*.built && shown != NONE { nameOf(codemap, shown) } else { "Observatory" }
    const title_room = buildX(codemap) - title_x - 12
    drawBuild(codemap, canvas, top)
    // A path too long for its room loses its first folders ("…/" for them).
    var from: usize = 0
    if codemap.*.view == VIEW_EDITOR && canvas_module.measure(titleOf(codemap), title) > title_room {
        const dots = canvas_module.measure(titleOf(codemap), "…/")
        var at: usize = 0
        while at < title.length && canvas_module.measure(titleOf(codemap), title[from..title.length]) + dots > title_room {
            if title[at] == 47 { from = at + 1 }
            at += 1
        }
    }
    if title_room > 20 && from > 0 {
        const dots = canvas_module.measure(titleOf(codemap), "…/")
        canvas_module.drawText(canvas, titleOf(codemap), "…/", title_x, (TOOLBAR - 17) / 2, DIM_COLOR, 0)
        canvas_module.drawText(canvas, titleOf(codemap), title[from..title.length], title_x + dots, (TOOLBAR - 17) / 2, TEXT_COLOR, title_room - dots)
    } else if title_room > 20 {
        canvas_module.drawText(canvas, titleOf(codemap), title, title_x, (TOOLBAR - 17) / 2, TEXT_COLOR, title_room)
    }
    // The base Changed compares with (a list of commits opens).
    const base_x = baseX(codemap)
    var base_text: [64]u8 = undefined
    var base_bytes: [*]u8 = undefined
    unsafe { base_bytes = @ptrCast([*]u8, &base_text) }
    const base_length = writeBaseLabel(codemap, base_bytes)
    const base_lit = codemap.*.hover == HIT_BASE || codemap.*.popup == POPUP_BASE
    canvas_module.fillRoundedRect(canvas, base_x, top, baseWidth(codemap), BUTTON, 8, if base_lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    drawDot(canvas, base_x + 10, top + 11, 8, canvasColor(CHANGED_COLOR, 255))
    canvas_module.drawText(canvas, bodyOf(codemap), base_bytes[0..base_length], base_x + 24, top + 7, TEXT_COLOR, 0)
    var pill_text: [32]u8 = undefined
    var pill_bytes: [*]u8 = undefined
    unsafe { pill_bytes = @ptrCast([*]u8, &pill_text) }
    const pill_length = writeChangesPill(codemap, pill_bytes)
    if pill_length > 0 {
        const pill_x = base_x + 30 + canvas_module.measure(bodyOf(codemap), base_bytes[0..base_length])
        const pill_width = changesPillWidth(codemap) - 8
        canvas_module.fillRoundedRect(canvas, pill_x, top + 6, pill_width, BUTTON - 12, 8, canvasColor(TYPE_COLOR, 70))
        canvas_module.drawText(canvas, smallOf(codemap), pill_bytes[0..pill_length], pill_x + 6, top + 8, TEXT_COLOR, 0)
    }
    drawArrow(canvas, base_x + baseWidth(codemap) - 16, top + 10, true, DIM_COLOR)
    // The query builder (a list of words opens) and keeping the query as a
    // view (a bookmark, lit when there is a query to keep).
    const filter_x = filterX(codemap)
    const filter_lit = codemap.*.hover == HIT_FILTER || codemap.*.popup == POPUP_FILTER
    canvas_module.fillRoundedRect(canvas, filter_x, top, filterWidth(codemap), BUTTON, 8, if filter_lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    canvas_module.drawText(canvas, bodyOf(codemap), filterLabel(codemap), filter_x + 12, top + 7, TEXT_COLOR, 0)
    drawArrow(canvas, filter_x + filterWidth(codemap) - 16, top + 10, true, DIM_COLOR)
    const keep_x = keepX(codemap)
    const can_keep = codemap.*.queryActive && !(searchText(codemap).length > 0 && searchText(codemap)[0] == 64)
    if codemap.*.hover == HIT_KEEP && can_keep { canvas_module.fillRoundedRect(canvas, keep_x, top, BUTTON, BUTTON, 8, canvas_module.color(255, 72, 76, 92)) }
    drawBookmark(canvas, keep_x + 10, top + 7, if can_keep { canvasColor(CHANGED_COLOR, 255) } else { canvas_module.color(255, 80, 84, 96) })
    // The search field.
    const search_x = searchX(codemap)
    canvas_module.fillRoundedRect(canvas, search_x, top, SEARCH_WIDTH, BUTTON, 8, canvas_module.color(255, 26, 28, 35))
    if codemap.*.searchFocused { canvas_module.strokeRoundedRect(canvas, search_x - 1, top - 1, SEARCH_WIDTH + 2, BUTTON + 2, 9, 2, ACCENT) }
    drawSearchGlyph(canvas, search_x + 10, top + 8, DIM_COLOR)
    const search = searchText(codemap)
    const text_x = search_x + 32
    if search.length == 0 {
        if !codemap.*.searchFocused { canvas_module.drawText(canvas, bodyOf(codemap), say(codemap, "Search code", "Code durchsuchen"), text_x, top + 7, DIM_COLOR, 0) }
    } else {
        // A query: how many answer it at the right (red when a word is not
        // understood).
        var note_width: i32 = 0
        if codemap.*.queryActive || codemap.*.queryBad {
            var digits: [24]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &digits) }
            const length = if codemap.*.queryBad { writeText(bytes, 0, "?") } else { writeNumber(codemap, bytes, 0, codemap.*.queryCount) }
            note_width = canvas_module.measure(smallOf(codemap), bytes[0..length]) + 10
            canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], search_x + SEARCH_WIDTH - note_width, top + 8, if codemap.*.queryBad { canvasColor(CRASH_COLOR, 255) } else { canvasColor(CHANGED_COLOR, 255) }, 0)
        }
        canvas_module.drawText(canvas, bodyOf(codemap), search, text_x, top + 7, if codemap.*.queryBad { canvasColor(CRASH_COLOR, 255) } else { TEXT_COLOR }, SEARCH_WIDTH - 40 - note_width)
    }
    if codemap.*.searchFocused {
        const caret_x = text_x + canvas_module.measure(bodyOf(codemap), search)
        if caret_x < search_x + SEARCH_WIDTH - 8 { canvas_module.fillRect(canvas, caret_x + 1, top + 7, 2, 16, ACCENT) }
    }
}

// Where `node` is: its file's name, or its group's.
fn contextOf(codemap: *Codemap, node: u32) -> []const u8 {
    const record = nodeOf(codemap, node)
    if record.*.parent == NONE { return "" }
    if record.*.kind == graph_module.DECLARATION {
        const parent = nodeOf(codemap, record.*.parent)
        if parent.*.kind == graph_module.DECLARATION { return nameOf(codemap, record.*.parent) }
        return nameOf(codemap, record.*.parent)
    }
    return nameOf(codemap, record.*.parent)
}

fn drawResults(codemap: *Codemap, canvas: *Canvas) -> void {
    if !resultsShown(codemap) { return }
    const x = resultsX(codemap)
    const top = TOOLBAR - 4
    const rows = if codemap.*.resultCount > 0 { @intCast(i32, codemap.*.resultCount) } else { 1 }
    const height = rows * RESULT_ROW + 12
    canvas_module.fillRoundedRect(canvas, x + 2, top + 4, resultsWidth(), height, 10, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, top, resultsWidth(), height, 10, canvas_module.color(250, 32, 34, 43))
    canvas_module.strokeRoundedRect(canvas, x, top, resultsWidth(), height, 10, 1, canvas_module.color(255, 58, 62, 76))
    if codemap.*.resultCount == 0 {
        canvas_module.drawText(canvas, bodyOf(codemap), say(codemap, "Nothing found", "Nichts gefunden"), x + 16, top + 13, DIM_COLOR, 0)
        return
    }
    var at: usize = 0
    while at < codemap.*.resultCount {
        const node = codemap.*.results[at]
        const y = top + 6 + @intCast(i32, at) * RESULT_ROW
        if at == codemap.*.resultCursor {
            canvas_module.fillRoundedRect(canvas, x + 6, y, resultsWidth() - 12, RESULT_ROW, 7, canvas_module.color(255, 52, 78, 130))
        } else if codemap.*.hover == HIT_RESULT + at {
            canvas_module.fillRoundedRect(canvas, x + 6, y, resultsWidth() - 12, RESULT_ROW, 7, canvas_module.color(255, 46, 49, 60))
        }
        drawDot(canvas, x + 16, y + 10, 10, canvasColor(nodeOf(codemap, node).*.color, 255))
        const name = nameOf(codemap, node)
        canvas_module.drawText(canvas, bodyOf(codemap), name, x + 34, y + 7, TEXT_COLOR, resultsWidth() - 200)
        const name_width = canvas_module.measure(bodyOf(codemap), name)
        const where = if nodeOf(codemap, node).*.kind == graph_module.DIRECTORY { kindLabel(codemap, node) } else { graph_module.pathOf(graphOf(codemap), node) }
        const where_x = x + 34 + (if name_width < resultsWidth() - 200 { name_width } else { resultsWidth() - 200 }) + 12
        const room = x + resultsWidth() - 14 - where_x
        if room > 30 {
            // The end of a long path (a new slice: assigning one to a
            // slice variable would keep its old length).
            var cut: usize = 0
            while where.length - cut > 4 && canvas_module.measure(smallOf(codemap), where[cut..where.length]) > room { cut += 1 }
            const tail = where[cut..where.length]
            canvas_module.drawText(canvas, smallOf(codemap), tail, x + resultsWidth() - 14 - canvas_module.measure(smallOf(codemap), tail), y + 8, DIM_COLOR, 0)
        }
        at += 1
    }
}

fn isOnPath(codemap: *Codemap, node: u32) -> bool {
    const subject = if codemap.*.selected != NONE { codemap.*.selected } else { codemap.*.focus }
    if subject == NONE { return false }
    return graph_module.isUnder(graphOf(codemap), subject, node)
}

// The sidebar's groups: the whole, the top-level groups, and the groups
// inside those on the way to what is selected.
fn addSidebarRows(codemap: *Codemap, parent: u32, indent: i32) -> void {
    var child = nodeOf(codemap, parent).*.firstChild
    while child != NONE && codemap.*.sidebarCount < SIDEBAR_ROWS {
        const record = nodeOf(codemap, child)
        if record.*.kind == graph_module.DIRECTORY {
            codemap.*.sidebarNodes[codemap.*.sidebarCount] = child
            codemap.*.sidebarIndent[codemap.*.sidebarCount] = indent
            codemap.*.sidebarCount += 1
            if isOnPath(codemap, child) { addSidebarRows(codemap, child, indent + 1) }
        }
        child = record.*.nextSibling
    }
}

// A check box (14 pixels): 0 empty, 1 ticked, 2 in part (a dash), in
// `color` when not empty.
fn drawCheck(canvas: *Canvas, x: i32, y: i32, state: u8, color: u32) -> void {
    if state == 0 {
        canvas_module.fillRoundedRect(canvas, x, y, 14, 14, 4, canvas_module.color(255, 96, 101, 118))
        canvas_module.fillRoundedRect(canvas, x + 1, y + 1, 12, 12, 3, canvas_module.color(255, 30, 32, 41))
        return
    }
    canvas_module.fillRoundedRect(canvas, x, y, 14, 14, 4, color)
    const mark = canvas_module.color(255, 255, 255, 255)
    if state == 2 {
        canvas_module.fillRect(canvas, x + 3, y + 6, 8, 2, mark)
        return
    }
    var step: i32 = 0
    while step < 3 {
        canvas_module.fillRect(canvas, x + 3 + step, y + 6 + step, 2, 2, mark)
        step += 1
    }
    step = 0
    while step < 6 {
        canvas_module.fillRect(canvas, x + 5 + step, y + 8 - step, 2, 2, mark)
        step += 1
    }
}

// A view setting: a check box and its name, two to a row.
fn drawToggle(codemap: *Codemap, canvas: *Canvas, index: usize, label: []const u8, on: bool) -> void {
    const x = 16 + @intCast(i32, index % 2) * 100
    const y = codemap.*.toggleTop + @intCast(i32, index / 2) * 20
    if codemap.*.hover == HIT_TOGGLE + index { canvas_module.fillRoundedRect(canvas, x - 4, y - 3, 98, 19, 5, canvas_module.color(255, 42, 45, 56)) }
    drawCheck(canvas, x, y - 1, if on { 1 } else { 0 }, ACCENT)
    canvas_module.drawText(canvas, smallOf(codemap), label, x + 19, y, if on { canvas_module.color(255, 190, 194, 204) } else { DIM_COLOR }, 76)
}

// A section's heading at y; the y below it.
// A section's heading: its name and an arrow (down: open, right:
// folded up); a click folds it up or opens it.
fn drawHeading(codemap: *Codemap, canvas: *Canvas, section: usize, label: []const u8, y: i32) -> i32 {
    codemap.*.headingY[section] = y
    const lit = codemap.*.hover == HIT_HEADING + section
    if lit { canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, 20, 6, canvas_module.color(255, 36, 39, 49)) }
    canvas_module.drawText(canvas, smallOf(codemap), label, 18, y + 4, if lit { TEXT_COLOR } else { DIM_COLOR }, 0)
    drawArrow(canvas, SIDEBAR - 28, y + 5, !codemap.*.sectionFolded[section], if lit { TEXT_COLOR } else { DIM_COLOR })
    return y + 26
}

// A small arrow: down (open) or right.
fn drawArrow(canvas: *Canvas, x: i32, y: i32, down: bool, color: u32) -> void {
    var step: i32 = 0
    while step < 4 {
        if down {
            canvas_module.fillRect(canvas, x + step, y + 3 + step, 8 - 2 * step, 1, color)
        } else {
            canvas_module.fillRect(canvas, x + 2 + step, y + 2 + step, 1, 8 - 2 * step, color)
        }
        step += 1
    }
}

fn isFolded(codemap: *Codemap, section: usize) -> bool { return codemap.*.sectionFolded[section] }

// Folds a section up or opens it (kept in
// $XDG_CONFIG_HOME/mlx/observatory-sections).
fn toggleSection(codemap: *Codemap, section: usize) -> void {
    codemap.*.sectionFolded[section] = !codemap.*.sectionFolded[section]
    if codemap.*.trace {
        var text: [32]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeNumberPlain(bytes, 0, section)
        length = writeText(bytes, length, if codemap.*.sectionFolded[section] { " folded" } else { " opened" })
        traceLine(codemap, "section ", bytes[0..length])
    }
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    const length = sectionsPath(codemap, bytes)
    if length == 0 { return }
    var text: [8]u8 = undefined
    var at: usize = 0
    while at < SECTIONS {
        text[at] = if codemap.*.sectionFolded[at] { 49 } else { 48 }
        at += 1
    }
    const file = std.fs.open(bytes, 577, 420)
    if !std.fs.isValid(file) { return }
    var text_bytes: [*]u8 = undefined
    unsafe { text_bytes = @ptrCast([*]u8, &text) }
    const wrote = std.fs.writeAllBytes(file, text_bytes, SECTIONS)
    const closed = std.fs.close(file)
}

// $XDG_CONFIG_HOME/mlx/observatory-sections (else ~/.config/...), the
// directories made; its length (0: no home).
fn sectionsPath(codemap: *Codemap, into: [*]u8) -> usize {
    var length: usize = 0
    const config = apps_module.environmentValue(codemap.*.environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] == 47 {
        length = writeText(into, 0, cString(config))
    } else {
        const home = apps_module.environmentValue(codemap.*.environment, "HOME")
        if @intFromPtr(home) == 0 || home[0] == 0 { return 0 }
        length = writeText(into, 0, cString(home))
        length = writeText(into, length, "/.config")
    }
    into[length] = 0
    const made = std.linux.syscall2(83, @intFromPtr(into), 493)
    length = writeText(into, length, "/mlx")
    into[length] = 0
    const made_mlx = std.linux.syscall2(83, @intFromPtr(into), 493)
    length = writeText(into, length, "/observatory-sections")
    into[length] = 0
    return length
}

fn loadSections(codemap: *Codemap) -> void {
    var at: usize = 0
    while at < 8 {
        codemap.*.sectionFolded[at] = false
        codemap.*.headingY[at] = AWAY
        at += 1
    }
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    if sectionsPath(codemap, bytes) == 0 { return }
    const file = std.fs.open(bytes, 0, 0)
    if !std.fs.isValid(file) { return }
    var text: [8]u8 = undefined
    var text_bytes: [*]u8 = undefined
    unsafe { text_bytes = @ptrCast([*]u8, &text) }
    const got = std.fs.read(file, text_bytes, 8)
    const closed = std.fs.close(file)
    at = 0
    while got > 0 && at < SECTIONS && at < @intCast(usize, got) {
        codemap.*.sectionFolded[at] = text[at] == 49
        at += 1
    }
}

// The sidebar, top to bottom (it scrolls when it is taller than the
// window): the groups, the program shown, the findings, what the spheres
// are colored by, the view settings and the kinds.
fn drawSidebar(codemap: *Codemap, canvas: *Canvas) -> void {
    const height = surfaceHeight(codemap)
    canvas_module.fillRect(canvas, 0, 0, SIDEBAR, height, canvas_module.color(214, 26, 28, 36))
    canvas_module.fillRect(canvas, SIDEBAR - 1, 0, 1, height, canvas_module.color(255, 18, 19, 25))
    const small = smallOf(codemap)
    const body = bodyOf(codemap)
    if codemap.*.sidebarScroll > codemap.*.sidebarHeight - height { codemap.*.sidebarScroll = codemap.*.sidebarHeight - height }
    if codemap.*.sidebarScroll < 0 { codemap.*.sidebarScroll = 0 }
    var y: i32 = 18 - codemap.*.sidebarScroll
    // What the middle shows: the galaxy or the editor.
    y = drawHeading(codemap, canvas, SECTION_VIEW, say(codemap, "View", "Ansicht"), y)
    codemap.*.viewSwitchY = AWAY
    if !isFolded(codemap, SECTION_VIEW) {
        drawViewSwitch(codemap, canvas, y)
        y += 34
    }
    y += 2
    y = drawHeading(codemap, canvas, SECTION_GROUPS, say(codemap, "Groups", "Gruppen"), y)
    codemap.*.sidebarCount = 0
    if codemap.*.built {
        const root = graphOf(codemap).*.root
        codemap.*.sidebarNodes[0] = root
        codemap.*.sidebarIndent[0] = 0
        codemap.*.sidebarCount = 1
        addSidebarRows(codemap, root, 0)
    }
    const subject = if codemap.*.selected != NONE { codemap.*.selected } else { codemap.*.focus }
    var index: usize = 0
    if isFolded(codemap, SECTION_GROUPS) {
        while index < codemap.*.sidebarCount {
            codemap.*.sidebarRowY[index] = AWAY
            index += 1
        }
    }
    while index < codemap.*.sidebarCount {
        const node = codemap.*.sidebarNodes[index]
        const record = nodeOf(codemap, node)
        codemap.*.sidebarRowY[index] = y
        if node == subject {
            canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, GROUP_ROW, 7, canvas_module.color(255, 58, 63, 78))
        } else if codemap.*.hover == HIT_GROUP + index || codemap.*.hover == HIT_GROUP_CHECK + index {
            canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, GROUP_ROW, 7, canvas_module.color(255, 42, 45, 56))
        }
        const indent = codemap.*.sidebarIndent[index] * 14
        const label = if index == 0 { say(codemap, "Everything", "Alles") } else { nameOf(codemap, node) }
        const state = checkState(codemap, node)
        drawCheck(canvas, 14 + indent, y + 6, state, ACCENT)
        if index == 0 {
            drawDot(canvas, 36, y + 8, 10, canvas_module.color(255, 220, 222, 230))
        } else {
            drawDot(canvas, 36 + indent, y + 8, 10, canvasColor(record.*.color, if state == 0 { 90 } else { 255 }))
        }
        // How many files, at the right.
        var digits: [24]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &digits) }
        const count_length = writeNumber(codemap, bytes, 0, @intCast(usize, record.*.files))
        const count_width = canvas_module.measure(small, bytes[0..count_length])
        canvas_module.drawText(canvas, small, bytes[0..count_length], SIDEBAR - 18 - count_width, y + 6, DIM_COLOR, 0)
        canvas_module.drawText(canvas, body, label, 54 + indent, y + 5, if state == 0 { DIM_COLOR } else { TEXT_COLOR }, SIDEBAR - 54 - indent - count_width - 26)
        y += GROUP_ROW
        index += 1
    }
    // The program shown; opened, all of them.
    y += 6
    y = drawHeading(codemap, canvas, SECTION_PROGRAM, say(codemap, "Program", "Programm"), y)
    codemap.*.programTop = AWAY
    codemap.*.programRows = 0
    if !isFolded(codemap, SECTION_PROGRAM) {
        codemap.*.programTop = y
        drawProgramRow(codemap, canvas, y)
        y += GROUP_ROW
    }
    if codemap.*.programsOpen && codemap.*.built && !isFolded(codemap, SECTION_PROGRAM) {
        const programs = programsOf(codemap)
        var row: usize = 0
        while row <= programs.*.count && row < 128 {
            codemap.*.programRowY[row] = y
            drawProgramChoice(codemap, canvas, row, y)
            y += SUB_ROW
            row += 1
        }
        codemap.*.programRows = row
        y += 4
    }
    // The findings; under Workarounds (opened) their kinds.
    y += 6
    y = drawHeading(codemap, canvas, SECTION_FINDINGS, say(codemap, "Findings", "Befunde"), y)
    codemap.*.findingTop = y
    var finding: u8 = 0
    codemap.*.patternRows = 0
    if isFolded(codemap, SECTION_FINDINGS) {
        while @intCast(usize, finding) < FINDINGS {
            codemap.*.findingY[@intCast(usize, finding)] = AWAY
            finding += 1
        }
    }
    while @intCast(usize, finding) < FINDINGS {
        codemap.*.findingY[@intCast(usize, finding)] = y
        drawFindingRow(codemap, canvas, finding, y)
        y += GROUP_ROW
        if finding == FINDING_WORKAROUNDS && codemap.*.workaroundsOpen {
            var at: usize = 0
            while at < codemap.*.patternCount {
                codemap.*.patternY[at] = y
                drawPatternRow(codemap, canvas, at, y)
                y += SUB_ROW
                at += 1
            }
            codemap.*.patternRows = codemap.*.patternCount
            y += 4
        }
        finding += 1
    }
    // What the spheres are colored by.
    y += 6
    y = drawHeading(codemap, canvas, SECTION_COLOR, say(codemap, "Color by", "Färben nach"), y)
    var metric: usize = 0
    while metric < measures_module.METRICS {
        if isFolded(codemap, SECTION_COLOR) {
            codemap.*.metricY[metric] = AWAY
        } else {
            codemap.*.metricY[metric] = y
            drawMetricRow(codemap, canvas, @intCast(u8, metric), y)
            y += SUB_ROW
        }
        metric += 1
    }
    if codemap.*.metric != measures_module.KIND && !isFolded(codemap, SECTION_COLOR) {
        // The scale, cold to hot.
        var step: i32 = 0
        while step < SIDEBAR - 36 {
            canvas_module.fillRect(canvas, 18 + step, y + 4, 1, 8, canvasColor(heatColor(m.toFloat(@intCast(i64, step)) / m.toFloat(@intCast(i64, SIDEBAR - 36))), 255))
            step += 1
        }
        canvas_module.drawText(canvas, small, say(codemap, "little", "wenig"), 18, y + 14, DIM_COLOR, 0)
        const most = say(codemap, "much", "viel")
        canvas_module.drawText(canvas, small, most, SIDEBAR - 18 - canvas_module.measure(small, most), y + 14, DIM_COLOR, 0)
        y += 32
    }
    // The view settings.
    y += 6
    y = drawHeading(codemap, canvas, SECTION_SHOW, say(codemap, "Show", "Anzeigen"), y - 2) - 2
    codemap.*.toggleTop = AWAY
    if !isFolded(codemap, SECTION_SHOW) {
        codemap.*.toggleTop = y
        drawToggle(codemap, canvas, 0, say(codemap, "Imports", "Importe"), codemap.*.showImports)
        drawToggle(codemap, canvas, 1, say(codemap, "Tree", "Baum"), codemap.*.showTree)
        drawToggle(codemap, canvas, 2, say(codemap, "Names", "Namen"), codemap.*.showLabels)
        y += 2 * 20 + 12
    } else {
        y += 6
    }
    // What the colors mean, each kind shown or not.
    y = drawHeading(codemap, canvas, SECTION_KINDS, say(codemap, "Kinds", "Arten"), y - 4) - 2
    codemap.*.legendTop = AWAY
    if !isFolded(codemap, SECTION_KINDS) {
        codemap.*.legendTop = y
        drawLegend(codemap, canvas, 0, say(codemap, "Function", "Funktion"))
        drawLegend(codemap, canvas, 1, "Struct/Union")
        drawLegend(codemap, canvas, 2, "Enum")
        drawLegend(codemap, canvas, 3, say(codemap, "Constant", "Konstante"))
        drawLegend(codemap, canvas, 4, "Variable")
        drawLegend(codemap, canvas, 5, say(codemap, "Field", "Feld"))
        drawLegend(codemap, canvas, 6, "Test")
        y += 4 * 20 + 12
    } else {
        y += 6
    }
    // The views kept (codemap.views): a click puts one's query into the
    // search, the x takes one out.
    y = drawHeading(codemap, canvas, SECTION_VIEWS, say(codemap, "Views", "Ansichten"), y)
    const views = viewsOf(codemap)
    codemap.*.viewRows = 0
    if !isFolded(codemap, SECTION_VIEWS) {
        var view: usize = 0
        while view < views.*.count && view < 64 {
            codemap.*.viewY[view] = y
            drawViewRow(codemap, canvas, view, y)
            y += SUB_ROW
            view += 1
        }
        codemap.*.viewRows = view
        const hint = if codemap.*.queryActive { say(codemap, "The bookmark next to the search keeps it as a view", "Das Lesezeichen neben der Suche hält sie als Ansicht fest") } else { say(codemap, "Filter (top) builds a query to keep", "Filter (oben) baut eine Abfrage zum Festhalten") }
        y += 2
        y += drawWrapped(codemap, canvas, hint, small, 18, y + 2, SIDEBAR - 36, DIM_COLOR, 3, 16)
    }
    y += 12
    codemap.*.sidebarHeight = y + codemap.*.sidebarScroll
}

fn drawViewRow(codemap: *Codemap, canvas: *Canvas, view: usize, y: i32) -> void {
    const views = viewsOf(codemap)
    const query = views_module.queryOf(views, view)
    const chosen = codemap.*.queryActive && sameBytes(searchQuery(codemap), query)
    if chosen {
        canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, SUB_ROW, 6, canvas_module.color(255, 58, 63, 78))
    } else if codemap.*.hover == HIT_VIEW_ROW + view {
        canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, SUB_ROW, 6, canvas_module.color(255, 42, 45, 56))
    }
    drawRadio(canvas, 14, y + 4, chosen)
    const name = views_module.nameOf(views, view)
    canvas_module.drawText(canvas, smallOf(codemap), name, 36, y + 4, TEXT_COLOR, 100)
    const name_width = canvas_module.measure(smallOf(codemap), name)
    const room = SIDEBAR - 36 - name_width - 44
    if room > 30 { canvas_module.drawText(canvas, smallOf(codemap), query, 36 + name_width + 10, y + 4, DIM_COLOR, room) }
    // The x that takes it out (lit under the pointer).
    const lit = codemap.*.hover == HIT_VIEW_REMOVE + view
    if lit || codemap.*.hover == HIT_VIEW_ROW + view {
        const color = if lit { canvasColor(CRASH_COLOR, 255) } else { DIM_COLOR }
        var step: i32 = 0
        while step < 8 {
            canvas_module.fillRect(canvas, SIDEBAR - 30 + step, y + 6 + step, 2, 1, color)
            canvas_module.fillRect(canvas, SIDEBAR - 30 + 7 - step, y + 6 + step, 2, 1, color)
            step += 1
        }
    }
}

// The program shown (a list opens under it).
fn drawProgramRow(codemap: *Codemap, canvas: *Canvas, y: i32) -> void {
    if codemap.*.hover == HIT_PROGRAMS { canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, GROUP_ROW, 7, canvas_module.color(255, 42, 45, 56)) }
    const label = if codemap.*.built && programChosen(codemap) { programs_module.nameOf(programsOf(codemap), codemap.*.program) } else { say(codemap, "All programs", "Alle Programme") }
    drawDot(canvas, 18, y + 8, 10, if programChosen(codemap) { ACCENT } else { canvas_module.color(255, 120, 124, 140) })
    canvas_module.drawText(canvas, bodyOf(codemap), label, 36, y + 5, TEXT_COLOR, SIDEBAR - 36 - 34)
    // The arrow.
    const arrow_x = SIDEBAR - 30
    var step: i32 = 0
    while step < 4 {
        if codemap.*.programsOpen {
            canvas_module.fillRect(canvas, arrow_x + step, y + 10 + step, 8 - 2 * step, 1, DIM_COLOR)
        } else {
            canvas_module.fillRect(canvas, arrow_x + 2 + step, y + 9 + step, 1, 8 - 2 * step, DIM_COLOR)
        }
        step += 1
    }
}

// Row `row` of the programs' list: first "all", then the programs by
// name, with how many declarations each reaches and its machine code.
fn drawProgramChoice(codemap: *Codemap, canvas: *Canvas, row: usize, y: i32) -> void {
    const programs = programsOf(codemap)
    const program = if row == 0 { programs.*.count } else { @intCast(usize, codemap.*.programOrder[row - 1]) }
    const chosen = program == codemap.*.program
    if chosen {
        canvas_module.fillRoundedRect(canvas, 26, y, SIDEBAR - 34, SUB_ROW, 6, canvas_module.color(255, 58, 63, 78))
    } else if codemap.*.hover == HIT_PROGRAM + row {
        canvas_module.fillRoundedRect(canvas, 26, y, SIDEBAR - 34, SUB_ROW, 6, canvas_module.color(255, 42, 45, 56))
    }
    drawRadio(canvas, 34, y + 4, chosen)
    var digits: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    var count_length: usize = 0
    if row > 0 {
        const binary = binaries_module.binaryOf(binariesOf(codemap), program)
        if binary < binariesOf(codemap).*.count {
            count_length = writeNumber(codemap, bytes, 0, binariesOf(codemap).*.total[binary] / 1024)
            count_length = writeText(bytes, count_length, " KB")
        } else {
            count_length = writeNumber(codemap, bytes, 0, programs.*.size[program])
        }
    }
    const count_width = canvas_module.measure(smallOf(codemap), bytes[0..count_length])
    canvas_module.drawText(canvas, smallOf(codemap), bytes[0..count_length], SIDEBAR - 18 - count_width, y + 4, DIM_COLOR, 0)
    const label = if row == 0 { say(codemap, "All", "Alle") } else { programs_module.nameOf(programs, program) }
    canvas_module.drawText(canvas, smallOf(codemap), label, 54, y + 4, TEXT_COLOR, SIDEBAR - 54 - count_width - 24)
}

// A round choice (14 pixels), filled when chosen.
fn drawRadio(canvas: *Canvas, x: i32, y: i32, chosen: bool) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, 14, 14, 7, if chosen { ACCENT } else { canvas_module.color(255, 96, 101, 118) })
    if !chosen { canvas_module.fillRoundedRect(canvas, x + 1, y + 1, 12, 12, 6, canvas_module.color(255, 30, 32, 41)) }
    if chosen { canvas_module.fillRoundedRect(canvas, x + 4, y + 4, 6, 6, 3, canvas_module.color(255, 255, 255, 255)) }
}

// What the spheres can be colored by, one row each (what cannot be had
// yet says why).
fn drawMetricRow(codemap: *Codemap, canvas: *Canvas, metric: u8, y: i32) -> void {
    const chosen = codemap.*.metric == metric
    if codemap.*.hover == HIT_METRIC + @intCast(usize, metric) { canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, SUB_ROW, 6, canvas_module.color(255, 42, 45, 56)) }
    drawRadio(canvas, 14, y + 4, chosen)
    canvas_module.drawText(canvas, smallOf(codemap), measures_module.name(metric, codemap.*.german), 36, y + 4, TEXT_COLOR, 110)
    const note = metricNote(codemap, metric)
    if note.length > 0 {
        const width = canvas_module.measure(smallOf(codemap), note)
        canvas_module.drawText(canvas, smallOf(codemap), note, SIDEBAR - 18 - width, y + 4, DIM_COLOR, 0)
    }
}

// Why a measure cannot be had yet ("": it can). A slice returned, not
// assigned: the compiler keeps an assigned slice's old length.
fn metricNote(codemap: *Codemap, metric: u8) -> []const u8 {
    if !codemap.*.built { return "" }
    if metric == measures_module.SIZE && binariesOf(codemap).*.count == 0 { return say(codemap, "not built", "nicht gebaut") }
    if metric == measures_module.CHURN {
        if !git_module.usable(gitOf(codemap)) { return say(codemap, "no Git", "kein Git") }
        if !history_module.finished(historyOf(codemap)) { return say(codemap, "reading", "wird gelesen") }
    }
    if metric == measures_module.HEAT && profilesOf(codemap).*.count == 0 { return say(codemap, "no profile", "kein Profil") }
    return ""
}

fn drawFindingRow(codemap: *Codemap, canvas: *Canvas, finding: u8, y: i32) -> void {
    const index = @intCast(usize, finding)
    if codemap.*.finding == finding {
        canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, GROUP_ROW, 7, canvas_module.color(255, 58, 63, 78))
    } else if codemap.*.hover == HIT_FINDING + index || codemap.*.hover == HIT_FINDING_CHECK + index || (finding == FINDING_WORKAROUNDS && codemap.*.hover == HIT_DROPDOWN) {
        canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, GROUP_ROW, 7, canvas_module.color(255, 42, 45, 56))
    }
    const color = findingColor(finding)
    drawCheck(canvas, 14, y + 6, if codemap.*.findingOn[index] { 1 } else { 0 }, canvasColor(color, 255))
    drawDot(canvas, 36, y + 8, 10, canvasColor(color, if finding == FINDING_UNUSED { 150 } else { 255 }))
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    const count_length = if codemap.*.built { writeNumber(codemap, bytes, 0, findingSize(codemap, finding)) } else { 0 }
    const count_width = canvas_module.measure(smallOf(codemap), bytes[0..count_length])
    canvas_module.drawText(canvas, smallOf(codemap), bytes[0..count_length], SIDEBAR - 18 - count_width, y + 6, DIM_COLOR, 0)
    var room = SIDEBAR - 54 - count_width - 26
    if finding == FINDING_WORKAROUNDS {
        // The arrow that opens the kinds (down when open).
        const arrow_x = SIDEBAR - 64
        const arrow_color = if codemap.*.hover == HIT_DROPDOWN { TEXT_COLOR } else { DIM_COLOR }
        var step: i32 = 0
        while step < 4 {
            if codemap.*.workaroundsOpen {
                canvas_module.fillRect(canvas, arrow_x + step, y + 10 + step, 8 - 2 * step, 1, arrow_color)
            } else {
                canvas_module.fillRect(canvas, arrow_x + 2 + step, y + 9 + step, 1, 8 - 2 * step, arrow_color)
            }
            step += 1
        }
        room = arrow_x - 54 - 6
    }
    canvas_module.drawText(canvas, bodyOf(codemap), findingLabel(codemap, finding), 54, y + 5, TEXT_COLOR, room)
}

fn findingLabel(codemap: *Codemap, finding: u8) -> []const u8 {
    if finding == FINDING_UNREACHABLE { return say(codemap, "Unreachable", "Unerreichbar") }
    if finding == FINDING_UNTESTED { return say(codemap, "Untested", "Ungetestet") }
    if finding == FINDING_COMPLEX { return say(codemap, "Complex", "Komplex") }
    if finding == FINDING_STRUCTURE { return say(codemap, "Cycles and layers", "Zyklen und Schichten") }
    if finding == FINDING_RISKY { return say(codemap, "Risky", "Riskant") }
    if finding == FINDING_HOT { return say(codemap, "Hot", "Heiß") }
    if finding == FINDING_CHANGED { return say(codemap, "Changed", "Geändert") }
    if finding == FINDING_COPIES { return say(codemap, "Copies", "Kopien") }
    if finding == FINDING_NAMES { return say(codemap, "Written again", "Mehrfach geschrieben") }
    if finding == FINDING_UNUSED { return say(codemap, "Unused", "Ungenutzt") }
    if finding == FINDING_WORKAROUNDS { return "Workarounds" }
    return say(codemap, "Crashes", "Abstürze")
}

// A kind of workaround under Workarounds: its check box, name and places.
fn drawPatternRow(codemap: *Codemap, canvas: *Canvas, row: usize, y: i32) -> void {
    const pattern = codemap.*.patternOrder[row]
    const on = codemap.*.patternOn[@intCast(usize, pattern)]
    if codemap.*.hover == HIT_PATTERN + row { canvas_module.fillRoundedRect(canvas, 26, y, SIDEBAR - 34, SUB_ROW, 6, canvas_module.color(255, 42, 45, 56)) }
    drawCheck(canvas, 34, y + 4, if on { 1 } else { 0 }, canvasColor(WORKAROUND_COLOR, 255))
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    const count_length = writeNumber(codemap, bytes, 0, codemap.*.patternPlaces[@intCast(usize, pattern)])
    const count_width = canvas_module.measure(smallOf(codemap), bytes[0..count_length])
    canvas_module.drawText(canvas, smallOf(codemap), bytes[0..count_length], SIDEBAR - 18 - count_width, y + 4, DIM_COLOR, 0)
    const drawn = drawSparkline(codemap, canvas, pattern, SIDEBAR - 24 - count_width - SPARKLINE, y + 3, if on { WORKAROUND_COLOR } else { 4284112491 })
    const room = if drawn { SIDEBAR - 54 - count_width - SPARKLINE - 30 } else { SIDEBAR - 54 - count_width - 24 }
    canvas_module.drawText(canvas, smallOf(codemap), workarounds_module.shortTitle(pattern, codemap.*.german), 54, y + 4, if on { TEXT_COLOR } else { DIM_COLOR }, room)
}

const SPARKLINE: i32 = 34

// How a kind of workaround went over the last commits: a bar each (the
// oldest left), between the least and the most; drawn when two commits
// or more are counted.
fn drawSparkline(codemap: *Codemap, canvas: *Canvas, pattern: u8, x: i32, y: i32, color: u32) -> bool {
    const trend = trendOf(codemap)
    var known: usize = 0
    var commit: usize = 0
    while commit < trend.*.count {
        if trend_module.isKnown(trend, commit) { known += 1 }
        commit += 1
    }
    if known < 2 { return false }
    const most = trend_module.most(trend, @intCast(usize, pattern))
    const least = trend_module.least(trend, @intCast(usize, pattern))
    const height: i32 = 12
    var width = SPARKLINE / @intCast(i32, known)
    if width < 1 { width = 1 }
    var left = x + SPARKLINE - width * @intCast(i32, known)
    commit = 0
    while commit < trend.*.count {
        if trend_module.isKnown(trend, commit) {
            const value = trend_module.countOf(trend, commit, pattern)
            var bar: i32 = height / 2
            if most > least { bar = 2 + @intCast(i32, (value - least) * @intCast(u32, height - 2) / (most - least)) }
            const gap: i32 = if width > 2 { 1 } else { 0 }
            canvas_module.fillRect(canvas, left, y + height - bar, width - gap, bar, canvasColor(color, 200))
            left += width
        }
        commit += 1
    }
    return true
}

// A kind in the legend: a check box in its color, its name.
fn drawLegend(codemap: *Codemap, canvas: *Canvas, index: usize, label: []const u8) -> void {
    const x = 16 + @intCast(i32, index % 2) * 100
    const y = codemap.*.legendTop + @intCast(i32, index / 2) * 20
    const kind = legendKind(index)
    const on = !codemap.*.kindOff[@intCast(usize, kind)]
    if codemap.*.hover == HIT_KIND + index { canvas_module.fillRoundedRect(canvas, x - 4, y - 3, 98, 19, 5, canvas_module.color(255, 42, 45, 56)) }
    drawCheck(canvas, x, y - 1, if on { 1 } else { 0 }, canvasColor(graph_module.kindColor(kind), 255))
    canvas_module.drawText(canvas, smallOf(codemap), label, x + 19, y, if on { canvas_module.color(255, 190, 194, 204) } else { DIM_COLOR }, 76)
}

// The status bar: where the selection is (its parts to click on), and a
// note, what the pointer is on, or how big the code is.
fn drawStatus(codemap: *Codemap, canvas: *Canvas) -> void {
    const width = surfaceWidth(codemap)
    const height = surfaceHeight(codemap)
    const top = height - STATUS
    canvas_module.fillRect(canvas, SIDEBAR, top, width - SIDEBAR, STATUS, canvas_module.color(255, 34, 36, 45))
    canvas_module.fillRect(canvas, SIDEBAR, top, width - SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    if codemap.*.view == VIEW_EDITOR && hasTab(codemap) {
        drawEditorStatus(codemap, canvas, top, width)
        return
    }
    const small = smallOf(codemap)
    codemap.*.crumbCount = 0
    var x = SIDEBAR + 12
    const subject = if codemap.*.selected != NONE { codemap.*.selected } else { codemap.*.focus }
    if codemap.*.built && subject != NONE {
        var chain: [32]u32 = undefined
        var count: usize = 0
        var current = subject
        while current != NONE && count < 32 {
            chain[count] = current
            count += 1
            current = nodeOf(codemap, current).*.parent
        }
        while count > 0 {
            count -= 1
            const node = chain[count]
            const label = nameOf(codemap, node)
            const w = canvas_module.measure(small, label)
            const index = codemap.*.crumbCount
            codemap.*.crumbX[index] = x
            codemap.*.crumbNodes[index] = node
            codemap.*.crumbCount += 1
            if codemap.*.hover == HIT_CRUMB + index { canvas_module.fillRoundedRect(canvas, x - 5, top + 5, w + 10, STATUS - 10, 6, canvas_module.color(255, 52, 56, 68)) }
            canvas_module.drawText(canvas, small, label, x, top + 8, if count == 0 { TEXT_COLOR } else { DIM_COLOR }, 0)
            x += w
            if count > 0 { drawChevron(canvas, x + 8, top + 11, false, DIM_COLOR, 9, 2) }
            x += 22
        }
    }
    var buffer: [256]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    var length: usize = 0
    var color = DIM_COLOR
    if codemap.*.noteLength > 0 {
        length = writeText(text, 0, noteText(codemap))
        color = canvas_module.color(255, 240, 160, 90)
    } else if codemap.*.built && codemap.*.hoverNode != NONE {
        const node = codemap.*.hoverNode
        length = writeText(text, 0, kindLabel(codemap, node))
        length = writeText(text, length, " ")
        length = writeText(text, length, nameOf(codemap, node))
        const path = graph_module.pathOf(graphOf(codemap), node)
        if path.length > 0 && path.length < 160 {
            length = writeText(text, length, "  ")
            length = writeText(text, length, path)
        }
    } else if codemap.*.built {
        const graph = graphOf(codemap)
        const root = nodeOf(codemap, graph.*.root)
        length = writeNumber(codemap, text, 0, @intCast(usize, root.*.files))
        length = writeText(text, length, say(codemap, " files, ", " Dateien, "))
        length = writeNumber(codemap, text, length, @intCast(usize, root.*.declarations))
        length = writeText(text, length, say(codemap, " declarations, ", " Deklarationen, "))
        length = writeNumber(codemap, text, length, codemap.*.index.*.refCount)
        length = writeText(text, length, say(codemap, " uses", " Verwendungen"))
    }
    const shown = text[0..length]
    const w = canvas_module.measure(small, shown)
    if x + 20 < width - 14 - w { canvas_module.drawText(canvas, small, shown, width - 14 - w, top + 8, color, 0) }
}

// ---------------------------------------------------------------------------
// The detail panel

// The doc comment's text (the `//` taken off), paragraphs apart by a
// newline, into out; how long.
fn docText(codemap: *Codemap, node: u32, out: [*]u8, capacity: usize) -> usize {
    const record = nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return 0 }
    const index = codemap.*.index
    var start: usize = 0
    var size: usize = 0
    index_module.docRange(index, record.*.symbol, &start, &size)
    if size == 0 { return 0 }
    const source = index_module.sourceOf(index, index_module.symbolAt(index, record.*.symbol).*.file)
    var length: usize = 0
    var at = start
    const end = start + size
    while at < end {
        var line_end = at
        while line_end < end && source[line_end] != 10 { line_end += 1 }
        var from = at
        while from < line_end && (source[from] == 32 || source[from] == 9) { from += 1 }
        if from + 1 < line_end + 1 && from + 1 <= line_end && from < line_end && source[from] == 47 { from += 1 }
        if from < line_end && source[from] == 47 { from += 1 }
        if from < line_end && source[from] == 32 { from += 1 }
        if from >= line_end {
            // An empty comment line: a new paragraph.
            if length > 0 && length < capacity && out[length - 1] != 10 {
                out[length] = 10
                length += 1
            }
        } else {
            // An indented line (code in a comment) keeps its own line.
            const code_line = from < line_end && source[from] == 32
            if length > 0 && length < capacity && out[length - 1] != 10 {
                out[length] = if code_line { 10 } else { 32 }
                length += 1
            }
            var copy = from
            while copy < line_end && length < capacity {
                out[length] = source[copy]
                length += 1
                copy += 1
            }
            if code_line && length < capacity {
                out[length] = 10
                length += 1
            }
        }
        at = line_end + 1
    }
    while length > 0 && (out[length - 1] == 10 || out[length - 1] == 32) { length -= 1 }
    return length
}

// Draws `text` wrapped to `width` from (x, y), paragraphs at newlines, up
// to `most` lines; the height it took.
fn drawWrapped(codemap: *Codemap, canvas: *Canvas, text: []const u8, font: *Text, x: i32, y: i32, width: i32, color: u32, most: usize, line_height: i32) -> i32 {
    var lines: usize = 0
    var start: usize = 0
    var bottom = y
    while start < text.length && lines < most {
        // One line: as many words as fit.
        var end = start
        var fit_end = start
        while end < text.length && text[end] != 10 {
            var word_end = end
            while word_end < text.length && text[word_end] == 32 { word_end += 1 }
            while word_end < text.length && text[word_end] != 32 && text[word_end] != 10 { word_end += 1 }
            if canvas_module.measure(font, text[start..word_end]) > width && fit_end > start { break }
            fit_end = word_end
            end = word_end
            if canvas_module.measure(font, text[start..word_end]) > width { break }
        }
        if fit_end == start { fit_end = end }
        if fit_end == start && start < text.length { fit_end = start + 1 }
        const shown = text[start..fit_end]
        if bottom + line_height > TOOLBAR && bottom < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, font, shown, x, bottom, color, width) }
        bottom += line_height
        lines += 1
        start = fit_end
        while start < text.length && text[start] == 32 { start += 1 }
        if start < text.length && text[start] == 10 { start += 1 }
    }
    return bottom - y
}

fn addDetailRow(codemap: *Codemap, y: i32, node: u32, kind: u8) -> void {
    if codemap.*.detailRowCount >= DETAIL_ROWS { return }
    codemap.*.detailRows[codemap.*.detailRowCount] = node
    codemap.*.detailRowY[codemap.*.detailRowCount] = y
    codemap.*.detailRowKind[codemap.*.detailRowCount] = kind
    codemap.*.detailRowX[codemap.*.detailRowCount] = 0
    codemap.*.detailRowWidth[codemap.*.detailRowCount] = 0
    codemap.*.detailRowCount += 1
}

// A button in the detail panel (one of a row's); its width.
fn detailButton(codemap: *Codemap, canvas: *Canvas, label: []const u8, x: i32, y: i32, value: u32, kind: u8, primary: bool, enabled: bool) -> i32 {
    const width = canvas_module.measure(bodyOf(codemap), label) + 24
    const hit = HIT_ROW + codemap.*.detailRowCount
    if enabled && codemap.*.detailRowCount < DETAIL_ROWS {
        addDetailRow(codemap, y, value, kind)
        codemap.*.detailRowX[codemap.*.detailRowCount - 1] = x
        codemap.*.detailRowWidth[codemap.*.detailRowCount - 1] = width
    }
    if y + DETAIL_ROW > TOOLBAR && y < surfaceHeight(codemap) - STATUS {
        const lit = enabled && codemap.*.hover == hit
        var fill = if lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) }
        if primary && enabled { fill = if lit { canvas_module.color(255, 70, 110, 190) } else { canvas_module.color(255, 52, 88, 160) } }
        canvas_module.fillRoundedRect(canvas, x, y - 2, width, 28, 8, fill)
        canvas_module.drawText(canvas, bodyOf(codemap), label, x + 12, y + 4, if enabled { TEXT_COLOR } else { DIM_COLOR }, 0)
    }
    return width
}

// One row: the node's color, name, where it is and how often.
fn drawRelationRow(codemap: *Codemap, canvas: *Canvas, node: u32, count: u32, x: i32, y: i32, width: i32, accent: u32) -> void { drawRow(codemap, canvas, node, count, false, x, y, width, accent) }

// A row; `percent`: count is a share.
fn drawRow(codemap: *Codemap, canvas: *Canvas, node: u32, count: u32, percent: bool, x: i32, y: i32, width: i32, accent: u32) -> void {
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    var length: usize = 0
    if count > 1 || percent {
        length = writeNumber(codemap, bytes, 0, @intCast(usize, count))
        length = writeText(bytes, length, if percent { "%" } else { "x" })
    }
    drawRowNote(codemap, canvas, node, bytes[0..length], x, y, width, accent)
}

// A row for a node: its dot, name and where it is, and `note` at the
// right (a count, a size).
fn drawRowNote(codemap: *Codemap, canvas: *Canvas, node: u32, note: []const u8, x: i32, y: i32, width: i32, accent: u32) -> void {
    const hit = HIT_ROW + codemap.*.detailRowCount
    addDetailRow(codemap, y, node, ROW_NODE)
    if y + DETAIL_ROW <= TOOLBAR || y >= surfaceHeight(codemap) - STATUS { return }
    if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x - 6, y, width + 12, DETAIL_ROW, 6, canvas_module.color(255, 48, 52, 64)) }
    drawDot(canvas, x, y + 8, 8, canvasColor(nodeOf(codemap, node).*.color, 255))
    if accent != 0 { canvas_module.fillRect(canvas, x - 6, y + 5, 2, DETAIL_ROW - 10, canvasColor(accent, 255)) }
    const small = smallOf(codemap)
    var count_width: i32 = 0
    if note.length > 0 {
        count_width = canvas_module.measure(small, note)
        canvas_module.drawText(canvas, small, note, x + width - count_width, y + 5, DIM_COLOR, 0)
    }
    const name = nameOf(codemap, node)
    const name_room = width - 16 - count_width - 8
    canvas_module.drawText(canvas, bodyOf(codemap), name, x + 16, y + 4, TEXT_COLOR, name_room)
    const name_width = canvas_module.measure(bodyOf(codemap), name)
    const where = contextOf(codemap, node)
    const where_x = x + 16 + name_width + 8
    const room = x + width - count_width - 8 - where_x
    if room > 24 && where.length > 0 { canvas_module.drawText(canvas, small, where, where_x, y + 5, DIM_COLOR, room) }
}

// A section: its title and how many, the rows (the first few unless
// opened up), and a row to open it up.
fn drawSection(codemap: *Codemap, canvas: *Canvas, section: usize, title: []const u8, relations: [*]Relation, count: usize, kind: i32, accent: u32, x: i32, y: i32, width: i32) -> i32 {
    // Only relations of `kind` (-1: all).
    var total: usize = 0
    var at: usize = 0
    while at < count {
        if kind < 0 || @intCast(i32, relations[at].kind) == kind { total += 1 }
        at += 1
    }
    if total == 0 { return y }
    var row_y = y + 10
    var heading: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &heading) }
    var length = writeText(bytes, 0, title)
    length = writeText(bytes, length, "  ")
    length = writeNumber(codemap, bytes, length, total)
    if row_y > TOOLBAR && row_y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x, row_y, if accent != 0 { canvasColor(accent, 255) } else { DIM_COLOR }, 0) }
    row_y += 20
    const most = if codemap.*.expanded[section] { 400 } else { SECTION_ROWS }
    var shown: usize = 0
    at = 0
    while at < count && shown < most {
        if kind < 0 || @intCast(i32, relations[at].kind) == kind {
            drawRelationRow(codemap, canvas, relations[at].node, relations[at].count, x + 6, row_y, width - 6, accent)
            row_y += DETAIL_ROW
            shown += 1
        }
        at += 1
    }
    if shown < total {
        const hit = HIT_ROW + codemap.*.detailRowCount
        addDetailRow(codemap, row_y, @intCast(u32, section), ROW_MORE)
        if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x, row_y, width, DETAIL_ROW, 6, canvas_module.color(255, 48, 52, 64)) }
        length = writeText(bytes, 0, "+ ")
        length = writeNumber(codemap, bytes, length, total - shown)
        length = writeText(bytes, length, say(codemap, " more", " weitere"))
        if row_y > TOOLBAR && row_y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 22, row_y + 5, ACCENT, 0) }
        row_y += DETAIL_ROW
    }
    return row_y
}

// The members section: the node's children.
fn drawMembers(codemap: *Codemap, canvas: *Canvas, section: usize, title: []const u8, node: u32, x: i32, y: i32, width: i32) -> i32 {
    const record = nodeOf(codemap, node)
    if record.*.childCount == 0 { return y }
    var row_y = y + 10
    var heading: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &heading) }
    var length = writeText(bytes, 0, title)
    length = writeText(bytes, length, "  ")
    length = writeNumber(codemap, bytes, length, @intCast(usize, record.*.childCount))
    if row_y > TOOLBAR && row_y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x, row_y, DIM_COLOR, 0) }
    row_y += 20
    const most = if codemap.*.expanded[section] { 400 } else { SECTION_ROWS }
    var shown: usize = 0
    var child = record.*.firstChild
    while child != NONE && shown < most {
        drawRelationRow(codemap, canvas, child, 0, x + 6, row_y, width - 6, 0)
        row_y += DETAIL_ROW
        shown += 1
        child = nodeOf(codemap, child).*.nextSibling
    }
    if shown < @intCast(usize, record.*.childCount) {
        const hit = HIT_ROW + codemap.*.detailRowCount
        addDetailRow(codemap, row_y, @intCast(u32, section), ROW_MORE)
        if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x, row_y, width, DETAIL_ROW, 6, canvas_module.color(255, 48, 52, 64)) }
        length = writeText(bytes, 0, "+ ")
        length = writeNumber(codemap, bytes, length, @intCast(usize, record.*.childCount) - shown)
        length = writeText(bytes, length, say(codemap, " more", " weitere"))
        if row_y > TOOLBAR && row_y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 22, row_y + 5, ACCENT, 0) }
        row_y += DETAIL_ROW
    }
    return row_y
}

// A group of symbols (copies, names) but `self`: the shown ones as rows.
fn drawSymbols(codemap: *Codemap, canvas: *Canvas, section: usize, title: []const u8, analysis: *analysis_module.Analysis, kind: u8, group: u32, self_symbol: u32, x: i32, y: i32, width: i32) -> i32 {
    if group == NONE { return y }
    const members = analysis_module.groupMembers(analysis, kind, @intCast(usize, group))
    var row_y = y + 10
    if row_y > TOOLBAR && row_y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), title, x, row_y, canvasColor(FINDING_COLOR, 255), 0) }
    row_y += 20
    const most: usize = if codemap.*.expanded[section] { 400 } else { SECTION_ROWS }
    var shown: usize = 0
    for symbol in members {
        const node = nodeOfSymbol(codemap, symbol)
        if symbol != self_symbol && node != NONE && shown < most {
            drawRow(codemap, canvas, node, analysis_module.usesOf(analysis, symbol), false, x + 6, row_y, width - 6, FINDING_COLOR)
            row_y += DETAIL_ROW
            shown += 1
        }
    }
    if members.length - 1 > shown && !codemap.*.expanded[section] {
        addDetailRow(codemap, row_y, @intCast(u32, section), ROW_MORE)
        var text: [48]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeText(bytes, 0, "+ ")
        length = writeNumber(codemap, bytes, length, members.length - 1 - shown)
        length = writeText(bytes, length, say(codemap, " more", " weitere"))
        if row_y > TOOLBAR && row_y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 22, row_y + 5, ACCENT, 0) }
        row_y += DETAIL_ROW
    }
    return row_y
}

fn drawCloseButton(codemap: *Codemap, canvas: *Canvas) -> void {
    const close_x = surfaceWidth(codemap) - 38
    // Back and forward (through what was selected), left of it.
    const off = canvas_module.color(255, 80, 84, 96)
    const back_x = surfaceWidth(codemap) - 104
    const forward_x = surfaceWidth(codemap) - 72
    if codemap.*.hover == HIT_BACK && codemap.*.backCount > 0 { canvas_module.fillRoundedRect(canvas, back_x, TOOLBAR + 10, 30, 28, 8, canvas_module.color(255, 60, 64, 78)) }
    if codemap.*.hover == HIT_FORWARD && codemap.*.forwardCount > 0 { canvas_module.fillRoundedRect(canvas, forward_x, TOOLBAR + 10, 30, 28, 8, canvas_module.color(255, 60, 64, 78)) }
    drawChevron(canvas, back_x + 10, TOOLBAR + 17, true, if codemap.*.backCount > 0 { TEXT_COLOR } else { off }, 13, 3)
    drawChevron(canvas, forward_x + 11, TOOLBAR + 17, false, if codemap.*.forwardCount > 0 { TEXT_COLOR } else { off }, 13, 3)
    canvas_module.fillRoundedRect(canvas, close_x, TOOLBAR + 10, 28, 28, 14, if codemap.*.hover == HIT_CLOSE { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 44, 47, 58) })
    var step: i32 = 0
    while step < 10 {
        canvas_module.fillRect(canvas, close_x + 9 + step, TOOLBAR + 19 + step, 2, 2, TEXT_COLOR)
        canvas_module.fillRect(canvas, close_x + 18 - step, TOOLBAR + 19 + step, 2, 2, TEXT_COLOR)
        step += 1
    }
}

// The list of findings: each group's heading (how many, what they have in
// common) and its members; unused declarations one by one.
fn drawFindings(codemap: *Codemap, canvas: *Canvas) -> void {
    if codemap.*.finding == FINDING_WORKAROUNDS || codemap.*.finding == FINDING_CRASHES {
        drawKeptFindings(codemap, canvas)
        return
    }
    if codemap.*.finding >= FINDING_UNREACHABLE {
        drawMeasuredFindings(codemap, canvas)
        return
    }
    const analysis = analysisOf(codemap)
    const left = detailX(codemap)
    const height = viewHeight(codemap)
    canvas_module.fillRect(canvas, left, TOOLBAR, DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = DETAIL - 40
    var y = TOOLBAR + 18 - codemap.*.detailScroll
    const finding = codemap.*.finding
    const title = if finding == FINDING_COPIES { say(codemap, "Copies", "Kopien") } else if finding == FINDING_NAMES { say(codemap, "Written again", "Mehrfach geschrieben") } else { say(codemap, "Unused", "Ungenutzt") }
    const about = if finding == FINDING_COPIES {
        say(codemap, "Functions with the same body: exact copies, then copies but for names and values (one generic function could serve them). The most to gain first.", "Funktionen mit gleichem Rumpf: exakte Kopien, dann gleiche bis auf Namen und Werte (eine generische Funktion könnte sie ersetzen). Das meiste Einsparpotenzial zuerst.")
    } else if finding == FINDING_NAMES {
        say(codemap, "Functions of the same name in several files: helpers each file wrote again, candidates for one shared version.", "Funktionen gleichen Namens in mehreren Dateien: Helfer, die jede Datei neu geschrieben hat, Kandidaten für eine gemeinsame Version.")
    } else {
        say(codemap, "Declarations nothing uses (generated code aside).", "Deklarationen, die nichts verwendet (erzeugter Code ausgenommen).")
    }
    y += drawWrapped(codemap, canvas, title, titleOf(codemap), x, y, width - 100, TEXT_COLOR, 1, 22)
    y += 4
    y += drawWrapped(codemap, canvas, about, smallOf(codemap), x, y, width, DIM_COLOR, 6, 17)
    y += 8
    const most_groups: usize = if codemap.*.expanded[0] { codemap.*.findingCount } else { 40 }
    var at: usize = 0
    while at < codemap.*.findingCount && at < most_groups {
        const entry = codemap.*.findingOrder[at]
        if finding == FINDING_UNUSED {
            const node = nodeOfSymbol(codemap, entry)
            if node != NONE {
                drawRow(codemap, canvas, node, 0, false, x + 6, y, width - 6, 0)
                y += DETAIL_ROW
            }
        } else {
            const kind = findingEntryKind(entry)
            const group = findingEntryGroup(entry)
            const members = analysis_module.groupMembers(analysis, kind, group)
            var heading: [160]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &heading) }
            var length = writeNumber(codemap, bytes, 0, members.length)
            if kind == analysis_module.NAMES {
                length = writeText(bytes, length, "x ")
                length = writeText(bytes, length, index_module.nameOf(codemap.*.index, members[0]))
            } else {
                length = writeText(bytes, length, if kind == analysis_module.COPIES { say(codemap, " exact copies, ", " exakte Kopien, ") } else { say(codemap, " alike, ", " gleichartig, ") })
                length = writeNumber(codemap, bytes, length, @intCast(usize, analysis_module.bodySize(analysis, members[0])))
                length = writeText(bytes, length, say(codemap, " tokens each", " Tokens je"))
            }
            y += 8
            if y > TOOLBAR && y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x, y, canvasColor(FINDING_COLOR, 255), width) }
            y += 20
            var shown: usize = 0
            for symbol in members {
                const node = nodeOfSymbol(codemap, symbol)
                if node != NONE && !isHidden(codemap, node) && shown < 12 {
                    drawRow(codemap, canvas, node, analysis_module.usesOf(analysis, symbol), false, x + 6, y, width - 6, FINDING_COLOR)
                    y += DETAIL_ROW
                    shown += 1
                }
            }
            if members.length > shown && shown == 12 {
                var more: [48]u8 = undefined
                var more_bytes: [*]u8 = undefined
                unsafe { more_bytes = @ptrCast([*]u8, &more) }
                var more_length = writeText(more_bytes, 0, "+ ")
                more_length = writeNumber(codemap, more_bytes, more_length, members.length - shown)
                more_length = writeText(more_bytes, more_length, say(codemap, " more", " weitere"))
                if y > TOOLBAR && y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), more_bytes[0..more_length], x + 22, y + 4, DIM_COLOR, 0) }
                y += DETAIL_ROW
            }
        }
        at += 1
    }
    if at < codemap.*.findingCount {
        addDetailRow(codemap, y, 0, ROW_MORE)
        var more: [48]u8 = undefined
        var more_bytes: [*]u8 = undefined
        unsafe { more_bytes = @ptrCast([*]u8, &more) }
        var more_length = writeText(more_bytes, 0, "+ ")
        more_length = writeNumber(codemap, more_bytes, more_length, codemap.*.findingCount - at)
        more_length = writeText(more_bytes, more_length, say(codemap, " more", " weitere"))
        if y > TOOLBAR && y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), more_bytes[0..more_length], x + 22, y + 5, ACCENT, 0) }
        y += DETAIL_ROW
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - TOOLBAR + 20
    drawCloseButton(codemap, canvas)
}

// The workarounds by what is missing, each with the declarations it is
// written in (the most places first); or the crashes, newest first, with
// the functions each went through.
// What a measured finding is (a slice returned, not assigned: the
// compiler keeps an assigned slice's old length).
fn measuredAbout(codemap: *Codemap, finding: u8) -> []const u8 {
    if finding == FINDING_UNREACHABLE {
        return say(codemap, "Functions no program and no check reaches from its main (nor are they in a binary): dead code, however often other dead code uses it. Calls through function pointers set at run time are not seen. Biggest first.", "Funktionen, die kein Programm und kein Check von seinem main aus erreicht (und die in keiner Binary stecken): toter Code, wie oft anderer toter Code sie auch verwendet. Aufrufe über zur Laufzeit gesetzte Funktionszeiger sieht die Karte nicht. Die größten zuerst.")
    } else if finding == FINDING_UNTESTED {
        return say(codemap, "Functions a program reaches and no check does (tests/, check_*.mlx, test blocks, what the check scripts build). The most complex first.", "Funktionen, die ein Programm erreicht, aber kein Check (tests/, check_*.mlx, test-Blöcke, was die Check-Skripte bauen). Die komplexesten zuerst.")
    } else if finding == FINDING_COMPLEX {
        return say(codemap, "Functions hard to follow: 15 branches or more, blocks 6 deep, or 1500 tokens. Candidates for splitting up.", "Schwer zu überblickende Funktionen: 15 Verzweigungen und mehr, 6 Ebenen tief oder 1500 Tokens. Kandidaten zum Aufteilen.")
    } else if finding == FINDING_RISKY {
        return say(codemap, "Functions most likely to break: crashes, workarounds, commits, complexity, copies and missing checks together (tools/codemap/measures.mlx).", "Funktionen, die am ehesten brechen: Abstürze, Workarounds, Commits, Komplexität, Kopien und fehlende Checks zusammen (tools/codemap/measures.mlx).")
    } else if finding == FINDING_CHANGED {
        return say(codemap, "Declarations added (first) and changed since the base (--diff REV; without it HEAD: what is not committed yet), by the files Git names as changed. The ones removed are listed at the end.", "Deklarationen, die seit der Basis hinzugekommen (zuerst) oder geändert sind (--diff REV; ohne das HEAD: was noch nicht committet ist), in den Dateien, die Git als geändert nennt. Die entfernten stehen am Ende.")
    } else if finding == FINDING_HOT {
        return say(codemap, "Where the programs spend their time, from the profiles of mlx-profile (tools/profile): samples in each function with what it calls.", "Wo die Programme ihre Zeit verbringen, aus den Profilen von mlx-profile (tools/profile): Samples je Funktion mit dem, was sie aufruft.")
    } else {
        return say(codemap, "Files that import each other, round about, and imports the rules forbid (codemap.layers at the root; without it: std imports nothing outside std, the compiler nothing from examples, tools, experiments or tests).", "Dateien, die einander reihum importieren, und Importe, die die Regeln verbieten (codemap.layers im Wurzelordner; ohne sie: std importiert nichts außerhalb von std, der Compiler nichts aus examples, tools, experiments oder tests).")
    }
}

// The findings measured: dead code, untested, complex, risky and hot
// functions (most first, with their measure), and the structure (cycles,
// imports against the rules).
fn drawMeasuredFindings(codemap: *Codemap, canvas: *Canvas) -> void {
    const left = detailX(codemap)
    const height = viewHeight(codemap)
    canvas_module.fillRect(canvas, left, TOOLBAR, DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = DETAIL - 40
    var y = TOOLBAR + 18 - codemap.*.detailScroll
    const finding = codemap.*.finding
    const bottom = surfaceHeight(codemap) - STATUS
    const color = findingColor(finding)
    const about = measuredAbout(codemap, finding)
    y += drawWrapped(codemap, canvas, findingLabel(codemap, finding), titleOf(codemap), x, y, width - 100, TEXT_COLOR, 1, 22)
    y += 4
    y += drawWrapped(codemap, canvas, about, smallOf(codemap), x, y, width, DIM_COLOR, 8, 17)
    y += 8
    if finding == FINDING_HOT { y = drawProfileBlock(codemap, canvas, x, y, width) }
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const most: usize = if codemap.*.expanded[0] { codemap.*.findingCount } else { 60 }
    var at: usize = 0
    while at < codemap.*.findingCount && at < most {
        const entry = codemap.*.findingOrder[at]
        if finding == FINDING_STRUCTURE {
            const structure = structureOf(codemap)
            if entry & 2147483648 == 0 {
                const members = structure_module.cycleMembers(structure, @intCast(usize, entry))
                var length = writeNumber(codemap, bytes, 0, members.length)
                length = writeText(bytes, length, say(codemap, " files import each other", " Dateien importieren einander"))
                y += 8
                if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x, y, canvasColor(color, 255), width) }
                y += 20
                for file in members {
                    const node = fileNode(codemap, file)
                    if node != NONE {
                        drawRowNote(codemap, canvas, node, "", x + 6, y, width - 6, STRUCTURE_COLOR)
                        y += DETAIL_ROW
                    }
                }
            } else {
                const broken = @intCast(usize, entry & 2147483647)
                const import = @intCast(usize, structure.*.broken[broken])
                const rule = @intCast(usize, structure.*.brokenRule[broken])
                var length = writeText(bytes, 0, programs_module.relativePath(codemap.*.index, structure.*.importFrom[import]))
                length = writeText(bytes, length, say(codemap, " imports ", " importiert "))
                length = writeText(bytes, length, programs_module.relativePath(codemap.*.index, structure.*.importTo[import]))
                length = writeText(bytes, length, " (")
                length = writeText(bytes, length, structure_module.ruleFrom(structure, rule))
                length = writeText(bytes, length, " !-> ")
                length = writeText(bytes, length, structure_module.ruleTo(structure, rule))
                length = writeText(bytes, length, ")")
                y += 8
                y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, y, width, canvasColor(RISKY_COLOR, 255), 3, 17)
                const node = fileNode(codemap, structure.*.importFrom[import])
                if node != NONE {
                    drawRowNote(codemap, canvas, node, "", x + 6, y, width - 6, STRUCTURE_COLOR)
                    y += DETAIL_ROW
                }
            }
        } else {
            const node = nodeOfSymbol(codemap, entry)
            if node != NONE {
                const length = writeMeasure(codemap, bytes, finding, entry)
                drawRowNote(codemap, canvas, node, bytes[0..length], x + 6, y, width - 6, color)
                y += DETAIL_ROW
            }
        }
        at += 1
    }
    if at < codemap.*.findingCount {
        addDetailRow(codemap, y, 0, ROW_MORE)
        var length = writeText(bytes, 0, "+ ")
        length = writeNumber(codemap, bytes, length, codemap.*.findingCount - at)
        length = writeText(bytes, length, say(codemap, " more", " weitere"))
        if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 22, y + 5, ACCENT, 0) }
        y += DETAIL_ROW
    }
    if codemap.*.findingCount == 0 && y > TOOLBAR && y < bottom {
        canvas_module.drawText(canvas, bodyOf(codemap), say(codemap, "None in what is shown.", "Keine in dem, was gezeigt ist."), x, y + 4, DIM_COLOR, width)
        y += 24
    }
    if finding == FINDING_CHANGED { y = drawRemoved(codemap, canvas, x, y, width, bottom) }
    codemap.*.detailHeight = y + codemap.*.detailScroll - TOOLBAR + 20
    drawCloseButton(codemap, canvas)
}

// The declarations removed since the base (they have no place on the map):
// "- path:line name".
fn drawRemoved(codemap: *Codemap, canvas: *Canvas, x: i32, top: i32, width: i32, bottom: i32) -> i32 {
    const diff = diffOf(codemap)
    if !diff.*.hasBefore || diff.*.removedCount == 0 { return top }
    const before = diff.*.before
    var y = top + 8
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeNumber(codemap, bytes, 0, diff.*.removedCount)
    length = writeText(bytes, length, say(codemap, " removed", " entfernt"))
    if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x, y, canvasColor(CHANGED_COLOR, 255), width) }
    y += 20
    var at: usize = 0
    while at < diff.*.removedCount && at < 40 {
        const symbol = diff.*.removed[at] & 2147483647
        const record = index_module.symbolAt(before, symbol)
        length = writeText(bytes, 0, "- ")
        length = writeText(bytes, length, index_module.nameOf(before, symbol))
        length = writeText(bytes, length, "  ")
        length = writeText(bytes, length, programs_module.relativePath(before, record.*.file))
        length = writeText(bytes, length, ":")
        length = writeNumber(codemap, bytes, length, index_module.lineOf(before, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
        if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 6, y, DIM_COLOR, width - 6) }
        y += 18
        at += 1
    }
    return y
}


// ---------------------------------------------------------------------------
// The editor: files open in tabs, what the code map knows on their lines

fn activeEditor(codemap: *Codemap) -> *editor_module.Editor { return editorAt(codemap, codemap.*.activeTab) }

fn hasTab(codemap: *Codemap) -> bool { return codemap.*.tabCount > 0 }

fn marksOf(codemap: *Codemap, tab: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, codemap.*.tabMarks[tab]) }
}

fn heatOf(codemap: *Codemap, tab: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, codemap.*.tabHeat[tab]) }
}

fn placesOfTab(codemap: *Codemap, tab: usize) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, codemap.*.tabPlaces[tab]) }
}

// Functions and types have a lens above them.
fn hasLens(index: *index_module.Index, symbol: u32) -> bool {
    const kind = index_module.symbolAt(index, symbol).*.kind
    return kind == index_module.FUNCTION || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET
}

fn spansOf(codemap: *Codemap, tab: usize) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, codemap.*.tabSpans[tab]) }
}

// Whether the index's offsets fit the tab's text (not edited since).
fn tabIndexedNow(codemap: *Codemap, tab: usize) -> bool {
    return codemap.*.tabFile[tab] != NONE && editorAt(codemap, tab).*.version == codemap.*.tabIndexed[tab]
}

// The file of `path` in the index (NONE: not there).
fn fileOfPath(codemap: *Codemap, path: []const u8) -> u32 {
    if !codemap.*.built { return NONE }
    return index_module.findFile(codemap.*.index, path)
}

// Shows `path` in the editor (a tab of its own; the oldest tab not edited
// gives way when all are taken), the cursor at `line` and `column` (from
// 1; 0: where it was).
fn openFile(codemap: *Codemap, path: []const u8, line: usize, column: usize) -> bool {
    var tab = codemap.*.tabCount
    var at: usize = 0
    while at < codemap.*.tabCount {
        if sameBytes(editor_module.pathOf(editorAt(codemap, at)), path) { tab = at }
        at += 1
    }
    if tab == codemap.*.tabCount {
        const added = codemap.*.tabCount < MAX_TABS
        if added {
            codemap.*.tabCount += 1
        } else {
            // The first tab not edited (the one shown last); none: the
            // edits stay, the file does not open.
            tab = MAX_TABS
            at = 0
            while at < codemap.*.tabCount {
                if !editor_module.isDirty(editorAt(codemap, at)) && at != codemap.*.activeTab {
                    tab = at
                    break
                }
                at += 1
            }
            if tab == MAX_TABS && !editor_module.isDirty(editorAt(codemap, codemap.*.activeTab)) { tab = codemap.*.activeTab }
            if tab == MAX_TABS {
                setNote(codemap, say(codemap, "All tabs have edits: save or close one first", "Alle Tabs haben Änderungen: erst einen speichern oder schließen"), "")
                return false
            }
        }
        const editor = editorAt(codemap, tab)
        if !editor_module.load(editor, path) {
            if added { codemap.*.tabCount -= 1 }
            setNote(codemap, say(codemap, "Cannot read ", "Kann nicht lesen: "), path)
            return false
        }
        if tab > 0 { editor_module.shareClipboard(editor, editorAt(codemap, 0)) }
        codemap.*.tabFile[tab] = fileOfPath(codemap, path)
        // The index's offsets fit the text read (not when the file changed
        // since the index read it).
        codemap.*.tabIndexed[tab] = if fileStamp(path) > codemap.*.diskStamp { 18446744073709551615 } else { 0 }
        codemap.*.tabChecked[tab] = 18446744073709551615
        codemap.*.tabStamp[tab] = fileStamp(path)
        computeMarks(codemap, tab)
        requestCheck(codemap, tab)
    }
    codemap.*.activeTab = tab
    codemap.*.view = VIEW_EDITOR
    const editor = editorAt(codemap, tab)
    if line > 0 {
        editor_module.moveTo(editor, editor_module.offsetAt(editor, line - 1, if column > 0 { column - 1 } else { 0 }), false)
        centerCursor(codemap)
    }
    if codemap.*.trace { traceLine(codemap, "editor open ", path) }
    panelOf(codemap).*.dirty = true
    return true
}

// Opens the file of a node, at its declaration.
fn openNode(codemap: *Codemap, node: u32) -> void {
    if node == NONE { return }
    const record = nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return }
    openSymbol(codemap, record.*.symbol)
}

fn openSymbol(codemap: *Codemap, symbol: u32) -> void {
    if symbol == NONE { return }
    const index = codemap.*.index
    const record = index_module.symbolAt(index, symbol)
    const file = record.*.file
    var line: usize = 1
    var column: usize = 1
    if record.*.kind != index_module.FILE {
        const offset = @intCast(usize, record.*.nameStart)
        line = index_module.lineOf(index, file, offset) + 1
        column = index_module.columnOf(index, file, offset) + 1
    }
    const opened = openFile(codemap, index_module.pathOf(index, file), line, column)
}

fn closeTab(codemap: *Codemap, tab: usize) -> void {
    if tab >= codemap.*.tabCount { return }
    // The tab's parts move down (its buffers go to the end, for another).
    var at = tab
    while at + 1 < codemap.*.tabCount {
        swapTabs(codemap, at, at + 1)
        at += 1
    }
    codemap.*.tabCount -= 1
    editorAt(codemap, codemap.*.tabCount).*.open = false
    if codemap.*.activeTab >= codemap.*.tabCount && codemap.*.activeTab > 0 { codemap.*.activeTab -= 1 }
    if codemap.*.activeTab > tab { codemap.*.activeTab -= 1 }
    if codemap.*.tabCount == 0 { codemap.*.view = VIEW_MAP }
}

fn swapTabs(codemap: *Codemap, first: usize, second: usize) -> void {
    const size = @sizeOf(editor_module.Editor)
    var a: [*]u8 = undefined
    var b: [*]u8 = undefined
    unsafe {
        a = @ptrCast([*]u8, editorAt(codemap, first))
        b = @ptrCast([*]u8, editorAt(codemap, second))
    }
    var at: usize = 0
    while at < size {
        const byte = a[at]
        a[at] = b[at]
        b[at] = byte
        at += 1
    }
    const file = codemap.*.tabFile[first]
    codemap.*.tabFile[first] = codemap.*.tabFile[second]
    codemap.*.tabFile[second] = file
    const indexed = codemap.*.tabIndexed[first]
    codemap.*.tabIndexed[first] = codemap.*.tabIndexed[second]
    codemap.*.tabIndexed[second] = indexed
    const marks = codemap.*.tabMarks[first]
    codemap.*.tabMarks[first] = codemap.*.tabMarks[second]
    codemap.*.tabMarks[second] = marks
    const heat = codemap.*.tabHeat[first]
    codemap.*.tabHeat[first] = codemap.*.tabHeat[second]
    codemap.*.tabHeat[second] = heat
    const lines = codemap.*.tabMarkLines[first]
    codemap.*.tabMarkLines[first] = codemap.*.tabMarkLines[second]
    codemap.*.tabMarkLines[second] = lines
    const spans = codemap.*.tabSpans[first]
    codemap.*.tabSpans[first] = codemap.*.tabSpans[second]
    codemap.*.tabSpans[second] = spans
    const span_count = codemap.*.tabSpanCount[first]
    codemap.*.tabSpanCount[first] = codemap.*.tabSpanCount[second]
    codemap.*.tabSpanCount[second] = span_count
    const checked = codemap.*.tabChecked[first]
    codemap.*.tabChecked[first] = codemap.*.tabChecked[second]
    codemap.*.tabChecked[second] = checked
    const stamp = codemap.*.tabStamp[first]
    codemap.*.tabStamp[first] = codemap.*.tabStamp[second]
    codemap.*.tabStamp[second] = stamp
    const places = codemap.*.tabPlaces[first]
    codemap.*.tabPlaces[first] = codemap.*.tabPlaces[second]
    codemap.*.tabPlaces[second] = places
    const place_count = codemap.*.tabPlaceCount[first]
    codemap.*.tabPlaceCount[first] = codemap.*.tabPlaceCount[second]
    codemap.*.tabPlaceCount[second] = place_count
}

// Room for the marks of `lines` lines.
fn fitMarks(codemap: *Codemap, tab: usize, lines: usize) -> void {
    if codemap.*.tabMarks[tab] != 0 && codemap.*.tabMarkLines[tab] >= lines + 1 { return }
    const capacity = lines * 2 + 4096
    unsafe {
        codemap.*.tabMarks[tab] = @intFromPtr(codemap.*.allocator.alloc(capacity, 16).?)
        codemap.*.tabHeat[tab] = @intFromPtr(codemap.*.allocator.alloc(capacity, 16).?)
        if codemap.*.tabSpans[tab] == 0 { codemap.*.tabSpans[tab] = @intFromPtr(codemap.*.allocator.alloc(65536 * 16, 16).?) }
    }
    codemap.*.tabMarkLines[tab] = capacity
}

// The relative path of a tab's file.
fn tabRelative(codemap: *Codemap, tab: usize) -> []const u8 {
    const path = editor_module.pathOf(editorAt(codemap, tab))
    const root = rootText(codemap)
    if path.length > root.length + 1 && sameBytes(path[0..root.length], root) && path[root.length] == 47 { return path[root.length + 1..path.length] }
    return path
}

// What the code map knows on the lines of a tab: crashes, workarounds,
// changes since the base, the compiler's problems, heat, declarations.
fn computeMarks(codemap: *Codemap, tab: usize) -> void {
    const editor = editorAt(codemap, tab)
    const lines = editor.*.lineCount
    fitMarks(codemap, tab, lines)
    const marks = marksOf(codemap, tab)
    const heat = heatOf(codemap, tab)
    var line: usize = 0
    while line < codemap.*.tabMarkLines[tab] {
        marks[line] = 0
        heat[line] = 0
        line += 1
    }
    codemap.*.tabSpanCount[tab] = 0
    const file = codemap.*.tabFile[tab]
    if file != NONE && codemap.*.built {
        const index = codemap.*.index
        // Workarounds (and each place's line, for its hint).
        const workarounds = workaroundsOf(codemap)
        if codemap.*.tabPlaces[tab] == 0 { codemap.*.tabPlaces[tab] = @intFromPtr(codemap.*.allocator.alloc(4096 * 8, 16).?) }
        const places = placesOfTab(codemap, tab)
        codemap.*.tabPlaceCount[tab] = 0
        var place: usize = 0
        while place < workarounds.*.count {
            if workarounds.*.file[place] == file {
                const at = index_module.lineOf(index, file, @intCast(usize, workarounds.*.offset[place]))
                if at < lines { marks[at] = marks[at] | MARK_WORKAROUND }
                if codemap.*.tabPlaceCount[tab] < 4096 {
                    places[codemap.*.tabPlaceCount[tab] * 2] = @intCast(u32, at)
                    places[codemap.*.tabPlaceCount[tab] * 2 + 1] = @intCast(u32, place)
                    codemap.*.tabPlaceCount[tab] += 1
                }
            }
            place += 1
        }
        // Declarations, and how hot the functions are.
        const spans = spansOf(codemap, tab)
        const profiles = profilesOf(codemap)
        var hottest: u32 = 1
        var symbol: usize = 0
        while symbol < index.*.symbolCount {
            const id = @intCast(u32, symbol)
            const record = index_module.symbolAt(index, id)
            if record.*.file == file && query_module.isDeclaration(record.*.kind) && record.*.kind != index_module.FIELD && record.*.kind != index_module.MEMBER && codemap.*.tabSpanCount[tab] < 65536 {
                const count = codemap.*.tabSpanCount[tab]
                spans[count * 4] = @intCast(u32, index_module.lineOf(index, file, index_module.declarationOffset(index, id)))
                spans[count * 4 + 1] = @intCast(u32, index_module.lineOf(index, file, index_module.declarationEnd(index, id)))
                spans[count * 4 + 2] = @intCast(u32, index_module.lineOf(index, file, @intCast(usize, record.*.nameStart)))
                spans[count * 4 + 3] = id
                codemap.*.tabSpanCount[tab] = count + 1
                if profiles_module.totalOf(profiles, id) > hottest { hottest = profiles_module.totalOf(profiles, id) }
            }
            symbol += 1
        }
        var span: usize = 0
        while span < codemap.*.tabSpanCount[tab] {
            // A lens above functions and types.
            const first_line = @intCast(usize, spans[span * 4])
            if hasLens(index, spans[span * 4 + 3]) && first_line < lines { marks[first_line] = marks[first_line] | MARK_LENS }
            const total = profiles_module.totalOf(profiles, spans[span * 4 + 3])
            if total > 0 {
                const value = @intCast(u8, 40 + total * 215 / hottest)
                var at = @intCast(usize, spans[span * 4])
                while at <= @intCast(usize, spans[span * 4 + 1]) && at < lines {
                    if value > heat[at] { heat[at] = value }
                    at += 1
                }
            }
            span += 1
        }
    }
    // Crashes: the lines their frames name ("... at path:line").
    const crashes = crashesOf(codemap)
    const relative = tabRelative(codemap, tab)
    var frame: usize = 0
    while frame < crashes.*.frameCount {
        const where = crashes_module.frameWhere(crashes_module.frameText(crashes, frame))
        var colon = where.length
        while colon > 0 && where[colon - 1] != 58 { colon -= 1 }
        if colon > 1 && sameBytes(where[0..colon - 1], relative) {
            var number: usize = 0
            for byte in where[colon..where.length] {
                if byte >= 48 && byte <= 57 { number = number * 10 + @intCast(usize, byte - 48) }
            }
            if number > 0 && number <= lines { marks[number - 1] = marks[number - 1] | MARK_CRASH }
        }
        frame += 1
    }
    markChanges(codemap, tab)
    markProblems(codemap, tab)
}

// Lines changed since the base of Changed (git diff -U0).
fn markChanges(codemap: *Codemap, tab: usize) -> void {
    const git = gitOf(codemap)
    if !git_module.usable(git) { return }
    const editor = editorAt(codemap, tab)
    const marks = marksOf(codemap, tab)
    var base_bytes: [*]u8 = undefined
    unsafe { base_bytes = @ptrCast([*]u8, &codemap.*.diffBase) }
    git_module.begin(git)
    git_module.more(git, "diff -U0 ")
    git_module.addQuoted(git, if codemap.*.diffBaseLength > 0 { base_bytes[0..codemap.*.diffBaseLength] } else { "HEAD" })
    git_module.more(git, " -- ")
    git_module.addQuoted(git, editor_module.pathOf(editor))
    const text = git_module.finish(git)
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        // "@@ -a,b +c,d @@"
        if end - at > 4 && text[at] == 64 && text[at + 1] == 64 {
            var cursor = at + 3
            while cursor < end && text[cursor] != 43 { cursor += 1 }
            var removed_count: usize = 1
            var scan = at + 3
            while scan < cursor && text[scan] != 44 { scan += 1 }
            if scan < cursor { removed_count = parseDigits(text, scan + 1) }
            cursor += 1
            const first = parseDigits(text, cursor)
            while cursor < end && text[cursor] >= 48 && text[cursor] <= 57 { cursor += 1 }
            var count: usize = 1
            if cursor < end && text[cursor] == 44 { count = parseDigits(text, cursor + 1) }
            if count == 0 {
                if first < editor.*.lineCount { marks[first] = marks[first] | MARK_REMOVED }
            } else {
                var line = first
                while line < first + count && line <= editor.*.lineCount {
                    if line > 0 { marks[line - 1] = marks[line - 1] | (if removed_count == 0 { MARK_ADDED } else { MARK_CHANGED }) }
                    line += 1
                }
            }
        }
        at = end + 1
    }
}

fn parseDigits(text: []const u8, start: usize) -> usize {
    var value: usize = 0
    var at = start
    while at < text.length && text[at] >= 48 && text[at] <= 57 {
        value = value * 10 + @intCast(usize, text[at] - 48)
        at += 1
    }
    return value
}

// The compiler's problems of the tab's file (the last check).
fn markProblems(codemap: *Codemap, tab: usize) -> void {
    var source: usize = 0
    while source < 2 {
        markProblemsFrom(codemap, tab, problemsOf(codemap, source))
        source += 1
    }
}

fn markProblemsFrom(codemap: *Codemap, tab: usize, check: *check_module.Check) -> void {
    const marks = marksOf(codemap, tab)
    const editor = editorAt(codemap, tab)
    const path = editor_module.pathOf(editor)
    var at: usize = 0
    while at < check.*.count {
        const diagnostic = check_module.diagnosticAt(check, at)
        const where = check_module.outputText(check)[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength]
        if diagnosticInFile(codemap, where, path) && diagnostic.*.line > 0 && diagnostic.*.line <= editor.*.lineCount {
            marks[diagnostic.*.line - 1] = marks[diagnostic.*.line - 1] | (if diagnostic.*.isError { MARK_ERROR } else { MARK_WARNING })
        }
        at += 1
    }
}

// Whether a diagnostic's path (as the compiler wrote it: absolute, or
// relative to the root) is `path`.
fn diagnosticInFile(codemap: *Codemap, where: []const u8, path: []const u8) -> bool {
    if sameBytes(where, path) { return true }
    const root = rootText(codemap)
    return path.length == root.length + 1 + where.length && sameBytes(path[0..root.length], root) && sameBytes(path[root.length + 1..path.length], where)
}

// After an edit: the marks and declarations below the edited line move
// with the lines added or taken out.
fn shiftMarks(codemap: *Codemap, tab: usize, line: usize, before: usize) -> void {
    const editor = editorAt(codemap, tab)
    const now = editor.*.lineCount
    if now == before { return }
    fitMarks(codemap, tab, now + 4096)
    const marks = marksOf(codemap, tab)
    const heat = heatOf(codemap, tab)
    if now > before {
        const grow = now - before
        var at = now
        while at > line + grow {
            at -= 1
            marks[at] = marks[at - grow]
            heat[at] = heat[at - grow]
        }
        at = line + 1
        while at <= line + grow && at < now {
            marks[at] = MARK_ADDED
            heat[at] = heat[line]
            at += 1
        }
    } else {
        const shrink = before - now
        var at = line + 1
        while at + shrink < before {
            marks[at] = marks[at + shrink]
            heat[at] = heat[at + shrink]
            at += 1
        }
    }
    const spans = spansOf(codemap, tab)
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        var part: usize = 0
        while part < 3 {
            const value = @intCast(usize, spans[span * 4 + part])
            if value > line {
                if now > before { spans[span * 4 + part] = @intCast(u32, value + (now - before)) } else if value >= before - now + line { spans[span * 4 + part] = @intCast(u32, value - (before - now)) } else { spans[span * 4 + part] = @intCast(u32, line) }
            }
            part += 1
        }
        span += 1
    }
    // The workaround places' lines move the same way.
    const places = placesOfTab(codemap, tab)
    var place: usize = 0
    while place < codemap.*.tabPlaceCount[tab] {
        const value = @intCast(usize, places[place * 2])
        if value > line {
            if now > before { places[place * 2] = @intCast(u32, value + (now - before)) } else if value >= before - now + line { places[place * 2] = @intCast(u32, value - (before - now)) } else { places[place * 2] = @intCast(u32, line) }
        }
        place += 1
    }
    if marks[line] & (MARK_ADDED | MARK_CHANGED) == 0 { marks[line] = marks[line] | MARK_CHANGED }
}

// The innermost declaration on `line` of a tab (NONE: none).
fn declarationOnLine(codemap: *Codemap, tab: usize, line: usize) -> u32 {
    const spans = spansOf(codemap, tab)
    var best = NONE
    var best_size: usize = 18446744073709551615
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        const first = @intCast(usize, spans[span * 4])
        const last = @intCast(usize, spans[span * 4 + 1])
        if first <= line && line <= last && last - first < best_size {
            best = spans[span * 4 + 3]
            best_size = last - first
        }
        span += 1
    }
    return best
}

// The declaration a name at `offset` of the tab shown means: from the
// index when the text is as it read it, else by the name (in this file
// first).
fn symbolAtCursor(codemap: *Codemap, offset: usize) -> u32 {
    if !hasTab(codemap) || !codemap.*.built { return NONE }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const index = codemap.*.index
    const file = codemap.*.tabFile[tab]
    if tabIndexedNow(codemap, tab) {
        const ref = index_module.refAtOffset(index, file, offset)
        if ref != index_module.MAX_REFS { return index_module.refAt(index, ref).*.symbol }
    }
    var start: usize = 0
    var end: usize = 0
    editor_module.wordAt(editor, offset, &start, &end)
    if end <= start { return NONE }
    const word = editor.*.text[start..end]
    var found = NONE
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        if query_module.isDeclaration(record.*.kind) && sameBytes(index_module.nameOf(index, id), word) {
            if record.*.file == file { return id }
            if found == NONE { found = id }
        }
        symbol += 1
    }
    return found
}

// F12, Ctrl+click: the declaration of the name at the cursor.
fn goToDefinition(codemap: *Codemap, offset: usize) -> void {
    const symbol = symbolAtCursor(codemap, offset)
    if symbol == NONE {
        setNote(codemap, say(codemap, "No declaration found here", "Hier keine Deklaration gefunden"), "")
        return
    }
    const node = nodeOfSymbol(codemap, symbol)
    if node != NONE { select(codemap, node) }
    openSymbol(codemap, symbol)
    if codemap.*.trace { traceLine(codemap, "definition ", index_module.nameOf(codemap.*.index, symbol)) }
}

// The cursor moved: what it is in becomes the selection (the panel shows
// it), without flying.
fn followCursor(codemap: *Codemap) -> void {
    if !hasTab(codemap) || !codemap.*.built { return }
    const editor = activeEditor(codemap)
    const symbol = declarationOnLine(codemap, codemap.*.activeTab, editor_module.lineOf(editor, editor.*.cursor))
    const node = if symbol != NONE { nodeOfSymbol(codemap, symbol) } else { NONE }
    if node != NONE && node != codemap.*.selected { setSelected(codemap, node) }
}

// Scrolls so the cursor is seen (the middle when it was far).
fn centerCursor(codemap: *Codemap) -> void {
    const editor = activeEditor(codemap)
    const tab = codemap.*.activeTab
    const line = editor_module.lineOf(editor, editor.*.cursor)
    // Up from the cursor's line while the rows above fill half the view.
    const half = (editorBottom(codemap) - editorCodeTop()) / 2
    var top = line
    var height: i32 = EDITOR_LINE + (if hasLensRow(codemap, tab, line) { EDITOR_LINE } else { 0 })
    while top > 0 {
        const above = EDITOR_LINE + (if hasLensRow(codemap, tab, top - 1) { EDITOR_LINE } else { 0 })
        if height + above > half { break }
        height += above
        top -= 1
    }
    editor.*.top = top
}

fn keepCursorSeen(codemap: *Codemap) -> void {
    const editor = activeEditor(codemap)
    const tab = codemap.*.activeTab
    const line = editor_module.lineOf(editor, editor.*.cursor)
    if line < editor.*.top { editor.*.top = line }
    if line == editor.*.top && hasLensRow(codemap, tab, line) { return }
    const bottom = editorBottom(codemap)
    while editor.*.top < line && lineY(codemap, tab, line) + 2 * EDITOR_LINE > bottom { editor.*.top += 1 }
}

// Checks a tab's file with the compiler in the background.
fn requestCheck(codemap: *Codemap, tab: usize) -> void {
    const editor = editorAt(codemap, tab)
    const path = editor_module.pathOf(editor)
    if path.length < 4 || !sameBytes(path[path.length - 4..path.length], ".mlx") { return }
    check_module.request(checkOf(codemap), path, panel_module.milliseconds())
    codemap.*.tabChecked[tab] = editor.*.version
}

// Reads what the check wrote so far (without waiting); when it is done,
// the problems go on the lines.
fn pumpCheck(codemap: *Codemap) -> void {
    if pumpOne(buildOf(codemap)) { finishBuild(codemap) }
    const check = checkOf(codemap)
    if !check.*.running {
        const started = check_module.next(check, panel_module.milliseconds())
        return
    }
    if pumpOne(check) { finishCheck(codemap) }
}

// Reads what a compiler run wrote so far (without waiting); true when it
// is done.
fn pumpOne(check: *check_module.Check) -> bool {
    if !check.*.running { return false }
    var descriptor: [2]i32 = [2]i32{ @intCast(i32, check.*.pipe), 1 }
    var ready: isize = 0
    unsafe { ready = std.linux.syscall3(7, @intFromPtr(&descriptor), 1, 0) }
    var rounds: usize = 0
    while ready > 0 && rounds < 16 {
        if check_module.pump(check) { return true }
        unsafe { ready = std.linux.syscall3(7, @intFromPtr(&descriptor), 1, 0) }
        rounds += 1
    }
    return check_module.stopIfStuck(check, panel_module.milliseconds())
}

fn finishCheck(codemap: *Codemap) -> void {
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        computeMarks(codemap, tab)
        tab += 1
    }
    refreshFindings(codemap)
    if codemap.*.trace {
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        const length = writeNumberPlain(bytes, 0, checkOf(codemap).*.count)
        traceLine(codemap, "checked, problems ", bytes[0..length])

    }
    panelOf(codemap).*.dirty = true
}

// Writes the tab shown; the compiler checks it, and the index is older
// than the file now (switching to the map reads it again).
fn saveTab(codemap: *Codemap) -> void {
    if !hasTab(codemap) { return }
    const editor = activeEditor(codemap)
    if !editor_module.save(editor) {
        setNote(codemap, say(codemap, "Cannot write ", "Kann nicht schreiben: "), editor_module.pathOf(editor))
        return
    }
    codemap.*.stale = true
    codemap.*.tabStamp[codemap.*.activeTab] = fileStamp(editor_module.pathOf(editor))
    requestCheck(codemap, codemap.*.activeTab)
    refreshChanges(codemap)
    setNote(codemap, say(codemap, "Saved ", "Gespeichert: "), tabRelative(codemap, codemap.*.activeTab))
    if codemap.*.trace { traceLine(codemap, "saved ", tabRelative(codemap, codemap.*.activeTab)) }
}


// ---------------------------------------------------------------------------
// Drawing the editor

fn editorRight(codemap: *Codemap) -> i32 { return if detailOpen(codemap) { detailX(codemap) } else { surfaceWidth(codemap) } }
fn editorCodeTop() -> i32 { return TOOLBAR + TAB_BAR }
fn editorBottom(codemap: *Codemap) -> i32 { return surfaceHeight(codemap) - STATUS }

fn editorRows(codemap: *Codemap) -> usize {
    const rows = (editorBottom(codemap) - editorCodeTop()) / EDITOR_LINE
    return if rows > 0 { @intCast(usize, rows) } else { 1 }
}

fn tokenColor(kind: u8) -> u32 {
    if kind == editor_module.KEYWORD { return KEYWORD_COLOR }
    if kind == editor_module.TYPE { return TYPE_COLOR }
    if kind == editor_module.BUILTIN { return BUILTIN_COLOR }
    if kind == editor_module.STRING { return STRING_COLOR }
    if kind == editor_module.NUMBER { return NUMBER_COLOR }
    if kind == editor_module.COMMENT { return COMMENT_COLOR }
    if kind == editor_module.DOC { return DOC_COLOR }
    if kind == editor_module.CALL { return CALL_COLOR }
    if kind == editor_module.PUNCTUATION { return PUNCTUATION_COLOR }
    if kind == editor_module.CONSTANT { return CONSTANT_COLOR }
    return TEXT_COLOR
}

fn digitsOf(value: usize) -> i32 {
    var digits: i32 = 1
    var rest = value
    while rest >= 10 {
        rest /= 10
        digits += 1
    }
    return digits
}

// Where the text starts (after the gutter).
fn gutterWidth(codemap: *Codemap) -> i32 {
    const lines = if hasTab(codemap) { activeEditor(codemap).*.lineCount } else { 1 }
    var digits = digitsOf(lines)
    if digits < 3 { digits = 3 }
    return 16 + digits * codemap.*.charWidth + 20
}

fn drawEditor(codemap: *Codemap, canvas: *Canvas) -> void {
    const left = SIDEBAR
    const right = editorRight(codemap)
    const bottom = editorBottom(codemap)
    canvas_module.fillRect(canvas, left, TOOLBAR, right - left, bottom - TOOLBAR, EDITOR_BACKGROUND)
    drawTabs(codemap, canvas, left, right)
    if !hasTab(codemap) {
        const hint = say(codemap, "No file open: \"Open in editor\" in the panel, Ctrl+O, a search result or a click on a file opens one.", "Keine Datei offen: \"Im Editor öffnen\" im Panel, Strg+O, ein Suchergebnis oder ein Klick auf eine Datei öffnet eine.")
        const drawn = drawWrapped(codemap, canvas, hint, bodyOf(codemap), left + 40, TOOLBAR + TAB_BAR + 40, right - left - 80, DIM_COLOR, 4, 20)
        return
    }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const mono = monoOf(codemap)
    const cw = codemap.*.charWidth
    const gutter = gutterWidth(codemap)
    const text_x = left + gutter
    codemap.*.editorLeft = text_x
    const top = editorCodeTop()
    const rows = editorRows(codemap)
    if editor.*.top >= editor.*.lineCount { editor.*.top = if editor.*.lineCount > 0 { editor.*.lineCount - 1 } else { 0 } }
    canvas_module.fillRect(canvas, left, top, gutter - 8, bottom - top, GUTTER_BACKGROUND)
    const marks = marksOf(codemap, tab)
    const heat = heatOf(codemap, tab)
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    const select_start = editor_module.selectionStart(editor)
    const select_end = editor_module.selectionEnd(editor)
    const checked_now = codemap.*.tabChecked[tab] == editor.*.version
    // The index's offsets fit the text: names by what they are, and the
    // name at the cursor with its uses.
    const indexed_now = tabIndexedNow(codemap, tab) && codemap.*.built
    const cursor_ref = if indexed_now { index_module.refAtOffset(codemap.*.index, codemap.*.tabFile[tab], editor.*.cursor) } else { index_module.MAX_REFS }
    const cursor_symbol = if cursor_ref != index_module.MAX_REFS { index_module.refAt(codemap.*.index, cursor_ref).*.symbol } else { NONE }
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    codemap.*.chipCount = 0
    var row_y = top
    var line = editor.*.top
    while line < editor.*.lineCount && row_y + EDITOR_LINE <= bottom {
        // A lens row above a function or a type: what the map knows of it.
        if hasLensRow(codemap, tab, line) {
            const symbol = lensSymbolAt(codemap, tab, line)
            if symbol != NONE {
                buildLens(codemap, symbol)
                const indent = editor_module.columnsBetween(editor, editor_module.lineStart(editor, line), editor_module.lineStart(editor, line) + indentOf(editor_module.lineText(editor, line)))
                const drawn = drawChips(codemap, canvas, text_x + @intCast(i32, indent) * cw, row_y, right - 12, 190)
            }
            row_y += EDITOR_LINE
            if row_y + EDITOR_LINE > bottom { break }
        }
        const y = row_y
        const start = editor_module.lineStart(editor, line)
        const end = editor_module.lineEnd(editor, line)
        const mark = if line < codemap.*.tabMarkLines[tab] { marks[line] } else { 0 }
        if line == cursor_line { canvas_module.fillRect(canvas, text_x - 6, y, right - text_x + 6, EDITOR_LINE, LINE_HIGHLIGHT) }
        // The selection on this line.
        if select_start != select_end && select_start <= end && select_end >= start && !(select_end == start && line > 0 && select_start < start && false) {
            const from = if select_start > start { select_start } else { start }
            const to = if select_end < end { select_end } else { end }
            const x0 = text_x + @intCast(i32, editor_module.columnsBetween(editor, start, from)) * cw
            var x1 = text_x + @intCast(i32, editor_module.columnsBetween(editor, start, to)) * cw
            if select_end > end { x1 += cw / 2 }
            if x1 > x0 { canvas_module.fillRect(canvas, x0, y, x1 - x0, EDITOR_LINE, SELECTION_COLOR) }
        }
        // The gutter: changes (a bar), crash and workaround (dots), a
        // problem (a dot), heat (a bar by the numbers), the number.
        if mark & MARK_ADDED != 0 { canvas_module.fillRect(canvas, left + 2, y + 1, 3, EDITOR_LINE - 2, canvasColor(CHANGED_COLOR, 255)) }
        if mark & MARK_CHANGED != 0 { canvas_module.fillRect(canvas, left + 2, y + 1, 3, EDITOR_LINE - 2, canvasColor(TYPE_COLOR, 255)) }
        if mark & MARK_REMOVED != 0 { canvas_module.fillRect(canvas, left + 1, y + EDITOR_LINE - 2, 6, 3, canvasColor(ERROR_COLOR, 220)) }
        if mark & (MARK_ERROR | MARK_WARNING) != 0 {
            drawDot(canvas, left + 8, y + 5, 8, canvasColor(if mark & MARK_ERROR != 0 { ERROR_COLOR } else { WARNING_COLOR }, 255))
        } else if mark & MARK_CRASH != 0 {
            drawDot(canvas, left + 8, y + 5, 8, canvasColor(CRASH_COLOR, 255))
        } else if mark & MARK_WORKAROUND != 0 {
            drawDot(canvas, left + 9, y + 6, 6, canvasColor(WORKAROUND_COLOR, 230))
        }
        const heat_value = if line < codemap.*.tabMarkLines[tab] { heat[line] } else { 0 }
        if heat_value > 0 { canvas_module.fillRect(canvas, text_x - 14, y, 3, EDITOR_LINE, canvasColor(heatColor(m.toFloat(@intCast(i64, heat_value)) / 255.0), 255)) }
        const number_length = writeNumberPlain(digit_bytes, 0, line + 1)
        const number_x = text_x - 18 - @intCast(i32, number_length) * cw
        canvas_module.drawText(canvas, mono, digit_bytes[0..number_length], number_x, y + 2, if line == cursor_line { TEXT_COLOR } else { DIM_COLOR }, 0)
        // The text, token by token; a name in the colors of what it is
        // (the index knows), the uses of the name at the cursor lit.
        const text = editor.*.text[start..end]
        var x = text_x
        var at: usize = 0
        while at < text.length && x < right - 4 {
            var kind: u8 = 0
            const token_end = editor_module.token(text, at, &kind)
            const piece = text[at..token_end]
            const columns = @intCast(i32, editor_module.columnsBetween(editor, start + at, start + token_end))
            var color = tokenColor(kind)
            if indexed_now && isNameStart(piece[0]) && (kind == editor_module.PLAIN || kind == editor_module.CALL || kind == editor_module.TYPE || kind == editor_module.CONSTANT) {
                const ref = index_module.refAtOffset(codemap.*.index, codemap.*.tabFile[tab], start + at)
                if ref != index_module.MAX_REFS {
                    const value = index_module.refAt(codemap.*.index, ref)
                    if @intCast(usize, value.*.start) == start + at {
                        color = semanticColor(codemap, value.*.symbol, color)
                        if value.*.symbol == cursor_symbol && cursor_symbol != NONE {
                            const written = value.*.use == index_module.USE_WRITE || value.*.use == index_module.USE_DECLARATION
                            canvas_module.fillRoundedRect(canvas, x - 1, y + 1, columns * cw + 2, EDITOR_LINE - 2, 3, if written { canvas_module.color(255, 78, 64, 56) } else { canvas_module.color(255, 52, 60, 80) })
                        }
                    }
                }
            }
            if piece[0] != 32 { canvas_module.drawText(canvas, mono, piece, x, y + 2, canvasColor(color, 255), right - 4 - x) }
            x += columns * cw
            at = token_end
        }
        // The compiler's problem on it, after the text; and what the map
        // knows of a function named on it.
        var after = x + 3 * cw
        if mark & (MARK_ERROR | MARK_WARNING) != 0 && checked_now {
            after = drawProblemAfter(codemap, canvas, line, after, y, right, text_x, x)
        }
        // A crash or a workaround on it: what it is (a rewrite, if any).
        if mark & (MARK_CRASH | MARK_WORKAROUND) != 0 && codemap.*.built && after < right - 60 {
            buildLineHints(codemap, tab, line, mark)
            const hinted = drawChips(codemap, canvas, after, y, right - 12, 230)
        }
        row_y += EDITOR_LINE
        line += 1
    }
    // The cursor.
    const cursor_y = lineY(codemap, tab, cursor_line)
    if cursor_y >= top && cursor_y + EDITOR_LINE <= bottom {
        const x = text_x + @intCast(i32, editor_module.columnOf(editor, editor.*.cursor)) * cw
        canvas_module.fillRect(canvas, x, cursor_y + 1, 2, EDITOR_LINE - 2, ACCENT)
    }
    drawEditorScrollbar(codemap, canvas, right, top, bottom)
    drawSignatureHelp(codemap, canvas, right)
    if !codemap.*.refsOpen && !codemap.*.completeOpen { drawEditorHover(codemap, canvas, right, bottom) }
    drawCompletion(codemap, canvas, right, bottom)
    drawRefs(codemap, canvas, right, bottom)
    drawRename(codemap, canvas)
    drawBlame(codemap, canvas, right)
}

// A name's color by what it names (else the lexer's).
fn semanticColor(codemap: *Codemap, symbol: u32, fallback: u32) -> u32 {
    if symbol == NONE { return fallback }
    const kind = index_module.symbolAt(codemap.*.index, symbol).*.kind
    if kind == index_module.FIELD { return FIELD_COLOR }
    if kind == index_module.PARAM { return PARAM_COLOR }
    if kind == index_module.LOCAL_CONST || kind == index_module.LOCAL_VAR || kind == index_module.CAPTURE { return TEXT_COLOR }
    if kind == index_module.FUNCTION { return CALL_COLOR }
    if kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET || kind == index_module.ALIAS { return TYPE_COLOR }
    if kind == index_module.CONST || kind == index_module.VAR || kind == index_module.MEMBER { return CONSTANT_COLOR }
    if kind == index_module.IMPORT || kind == index_module.FILE { return MODULE_COLOR }
    return fallback
}

fn isNameStart(byte: u8) -> bool { return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95 }

// How many blanks a line starts with.
fn indentOf(text: []const u8) -> usize {
    var at: usize = 0
    while at < text.length && (text[at] == 32 || text[at] == 9) { at += 1 }
    return at
}

// The first problem of `line`, in its color after the text (and a wave
// under its column); where the next thing may go.
fn drawProblemAfter(codemap: *Codemap, canvas: *Canvas, line: usize, x: i32, y: i32, right: i32, text_x: i32, text_end: i32) -> i32 {
    const first = drawProblemFrom(codemap, canvas, checkOf(codemap), line, x, y, right, text_x, text_end)
    if first != x { return first }
    return drawProblemFrom(codemap, canvas, buildOf(codemap), line, x, y, right, text_x, text_end)
}

fn drawProblemFrom(codemap: *Codemap, canvas: *Canvas, check: *check_module.Check, line: usize, x: i32, y: i32, right: i32, text_x: i32, text_end: i32) -> i32 {
    const editor = activeEditor(codemap)
    const path = editor_module.pathOf(editor)
    var at: usize = 0
    while at < check.*.count {
        const diagnostic = check_module.diagnosticAt(check, at)
        const output = check_module.outputText(check)
        const where = output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength]
        if diagnostic.*.line == line + 1 && diagnosticInFile(codemap, where, path) {
            const color = if diagnostic.*.isError { ERROR_COLOR } else { WARNING_COLOR }
            // A wave from the column to the end of the text.
            var wave_x = text_x + @intCast(i32, if diagnostic.*.column > 0 { diagnostic.*.column - 1 } else { 0 }) * codemap.*.charWidth
            var up = false
            while wave_x < text_end && wave_x < right {
                canvas_module.fillRect(canvas, wave_x, y + EDITOR_LINE - (if up { 3 } else { 2 }), 2, 1, canvasColor(color, 255))
                wave_x += 2
                up = !up
            }
            const message = output[diagnostic.*.messageStart..diagnostic.*.messageStart + diagnostic.*.messageLength]
            if x < right - 40 {
                canvas_module.fillRoundedRect(canvas, x - 4, y + 1, (if canvas_module.measure(smallOf(codemap), message) + 12 < right - x { canvas_module.measure(smallOf(codemap), message) + 12 } else { right - x }), EDITOR_LINE - 2, 4, canvasColor(color, 40))
                canvas_module.drawText(canvas, smallOf(codemap), message, x + 2, y + 2, canvasColor(color, 255), right - x - 8)
            }
            return x + canvas_module.measure(smallOf(codemap), message) + 24
        }
        at += 1
    }
    return x
}

fn writeLens(codemap: *Codemap, into: [*]u8, symbol: u32) -> usize {
    var length: usize = 0
    const uses = analysis_module.usesOf(analysisOf(codemap), symbol)
    length = writeNumber(codemap, into, length, @intCast(usize, uses))
    length = writeText(into, length, if uses == 1 { say(codemap, " use", " Verwendung") } else { say(codemap, " uses", " Verwendungen") })
    const bytes = binaries_module.bytesOf(binariesOf(codemap), symbol)
    if bytes > 0 {
        length = writeText(into, length, " · ")
        length = writeNumber(codemap, into, length, @intCast(usize, bytes))
        length = writeText(into, length, " B")
    }
    const commits = history_module.commitsOf(historyOf(codemap), symbol)
    if commits > 0 {
        length = writeText(into, length, " · ")
        length = writeNumber(codemap, into, length, @intCast(usize, commits))
        length = writeText(into, length, if commits == 1 { " Commit" } else { " Commits" })
    }
    const risk = measures_module.risk(measuresOf(codemap), symbol)
    if risk > 0 {
        length = writeText(into, length, say(codemap, " · risk ", " · Risiko "))
        length = writeNumber(codemap, into, length, @intCast(usize, risk))
    }
    const crashes = crashesOf(codemap)
    const crashed = crashes_module.stoppedIn(crashes, symbol) + crashes_module.wentThrough(crashes, symbol)
    if crashed > 0 {
        length = writeText(into, length, say(codemap, " · crashed ", " · abgestürzt "))
        length = writeNumber(codemap, into, length, @intCast(usize, crashed))
        length = writeText(into, length, "x")
    }
    const profiles = profilesOf(codemap)
    const hot = profiles_module.totalOf(profiles, symbol)
    if hot > 0 && profiles.*.allSamples > 0 {
        length = writeText(into, length, say(codemap, " · time ", " · Zeit "))
        length = writeNumber(codemap, into, length, @intCast(usize, @intCast(u64, hot) * 100 / profiles.*.allSamples))
        length = writeText(into, length, "%")
    }
    return length
}

// ---------------------------------------------------------------------------
// What the map knows, in the editor: a lens row above each function and
// type (its uses and findings, as chips), hints on the lines a crash or a
// workaround is on, the references list.

fn lensBytes(codemap: *Codemap) -> [*]u8 { return fieldBytes(codemap, @offsetOf(Codemap, "lensText")) }

fn addChip(codemap: *Codemap, kind: u8, color: u32, target: u32, text: []const u8) -> void {
    const count = codemap.*.lensCount
    if count >= 24 { return }
    const start = if count == 0 { 0 } else { codemap.*.lensEnd[count - 1] }
    if start + text.length > 1000 { return }
    codemap.*.lensEnd[count] = writeText(lensBytes(codemap), start, text)
    codemap.*.lensColor[count] = color
    codemap.*.lensKind[count] = kind
    codemap.*.lensTarget[count] = target
    codemap.*.lensCount = count + 1
}

fn chipText(codemap: *Codemap, chip: usize) -> []const u8 {
    const start = if chip == 0 { 0 } else { codemap.*.lensEnd[chip - 1] }
    return lensBytes(codemap)[start..codemap.*.lensEnd[chip]]
}

// Another member of `symbol`'s group of `kind` (copies, shapes, names);
// NONE: none.
fn otherMember(codemap: *Codemap, kind: u8, symbol: u32) -> u32 {
    const analysis = analysisOf(codemap)
    const group = analysis_module.groupOf(analysis, kind, symbol)
    if group == NONE { return NONE }
    for member in analysis_module.groupMembers(analysis, kind, @intCast(usize, group)) {
        if member != symbol { return member }
    }
    return NONE
}

fn isUnused(codemap: *Codemap, symbol: u32) -> bool {
    const analysis = analysisOf(codemap)
    var at: usize = 0
    while at < analysis.*.unusedCount {
        if analysis.*.unused[at] == symbol { return true }
        at += 1
    }
    return false
}

// The chips of a declaration's lens: its uses, crashes, workarounds, time,
// risk, complexity, reach, copies, namesakes, machine code, commits and
// whether it changed since the base.
fn buildLens(codemap: *Codemap, symbol: u32) -> void {
    codemap.*.lensCount = 0
    const index = codemap.*.index
    const kind = index_module.symbolAt(index, symbol).*.kind
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const uses = analysis_module.usesOf(analysisOf(codemap), symbol)
    var length = writeNumber(codemap, bytes, 0, @intCast(usize, uses))
    length = writeText(bytes, length, if uses == 1 { say(codemap, " use", " Verwendung") } else { say(codemap, " uses", " Verwendungen") })
    addChip(codemap, CHIP_USES, DIM_COLOR, symbol, bytes[0..length])
    const crashes = crashesOf(codemap)
    const stopped = crashes_module.stoppedIn(crashes, symbol)
    const through = crashes_module.wentThrough(crashes, symbol)
    if stopped > 0 {
        length = writeText(bytes, 0, say(codemap, "crashed here ", "hier abgestürzt "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, stopped))
        length = writeText(bytes, length, "x")
        addChip(codemap, CHIP_CRASHES, CRASH_COLOR, symbol, bytes[0..length])
    }
    if through > 0 {
        length = writeNumber(codemap, bytes, 0, @intCast(usize, through))
        length = writeText(bytes, length, if through == 1 { say(codemap, " crash went through", " Absturz lief hindurch") } else { say(codemap, " crashes went through", " Abstürze liefen hindurch") })
        addChip(codemap, CHIP_CRASHES, CRASH_COLOR, symbol, bytes[0..length])
    }
    const places = workarounds_module.placesOf(workaroundsOf(codemap), symbol)
    if places > 0 {
        length = writeNumber(codemap, bytes, 0, @intCast(usize, places))
        length = writeText(bytes, length, if places == 1 { " workaround" } else { " workarounds" })
        addChip(codemap, CHIP_WORKAROUNDS, WORKAROUND_COLOR, symbol, bytes[0..length])
    }
    const profiles = profilesOf(codemap)
    const hot = profiles_module.totalOf(profiles, symbol)
    if hot > 0 && profiles.*.allSamples > 0 {
        length = writeNumber(codemap, bytes, 0, @intCast(usize, @intCast(u64, hot) * 100 / profiles.*.allSamples))
        length = writeText(bytes, length, say(codemap, "% of the time", "% der Zeit"))
        addChip(codemap, CHIP_TEXT, HOT_COLOR, NONE, bytes[0..length])
    }
    const risk = measures_module.risk(measuresOf(codemap), symbol)
    if risk >= measures_module.RISKY {
        length = writeText(bytes, 0, say(codemap, "risky (", "riskant ("))
        length = writeNumber(codemap, bytes, length, @intCast(usize, risk))
        length = writeText(bytes, length, ")")
        addChip(codemap, CHIP_TEXT, RISKY_COLOR, NONE, bytes[0..length])
    } else if risk > 0 {
        length = writeText(bytes, 0, say(codemap, "risk ", "Risiko "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, risk))
        addChip(codemap, CHIP_TEXT, DIM_COLOR, NONE, bytes[0..length])
    }
    const complexity = complexityOf(codemap)
    if complexity_module.isComplex(complexity, symbol) {
        length = writeText(bytes, 0, say(codemap, "complex: ", "komplex: "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, complexity_module.branchesOf(complexity, symbol)))
        length = writeText(bytes, length, say(codemap, " branches, ", " Zweige, "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, complexity_module.depthOf(complexity, symbol)))
        length = writeText(bytes, length, say(codemap, " deep", " tief"))
        addChip(codemap, CHIP_TEXT, COMPLEX_COLOR, NONE, bytes[0..length])
    }
    if kind == index_module.FUNCTION {
        const programs = programsOf(codemap)
        if programs_module.isUnreachable(programs, symbol) && binaries_module.bytesOf(binariesOf(codemap), symbol) == 0 {
            addChip(codemap, CHIP_TEXT, UNREACHABLE_COLOR, NONE, say(codemap, "no program reaches it", "kein Programm erreicht das"))
        } else if programs_module.isUntested(programs, symbol) {
            addChip(codemap, CHIP_TEXT, UNTESTED_COLOR, NONE, say(codemap, "no check reaches it", "kein Check erreicht das"))
        }
    }
    if uses == 0 && isUnused(codemap, symbol) { addChip(codemap, CHIP_TEXT, FINDING_COLOR, NONE, say(codemap, "unused", "ungenutzt")) }
    const copy = otherMember(codemap, analysis_module.COPIES, symbol)
    const shape = if copy == NONE { otherMember(codemap, analysis_module.SHAPES, symbol) } else { NONE }
    if copy != NONE || shape != NONE {
        length = writeText(bytes, 0, if copy != NONE { say(codemap, "same body as ", "gleicher Rumpf wie ") } else { say(codemap, "same shape as ", "gleiche Form wie ") })
        length = writeText(bytes, length, index_module.nameOf(index, if copy != NONE { copy } else { shape }))
        length = writeText(bytes, length, " (")
        length = writeText(bytes, length, fileNameOf(index, if copy != NONE { copy } else { shape }))
        length = writeText(bytes, length, ")")
        addChip(codemap, CHIP_OPEN, FINDING_COLOR, if copy != NONE { copy } else { shape }, bytes[0..length])
    }
    const namesake = otherMember(codemap, analysis_module.NAMES, symbol)
    if namesake != NONE {
        const group = analysis_module.groupOf(analysisOf(codemap), analysis_module.NAMES, symbol)
        const others = analysis_module.groupMembers(analysisOf(codemap), analysis_module.NAMES, @intCast(usize, group)).length - 1
        length = writeText(bytes, 0, say(codemap, "written again in ", "noch einmal geschrieben in "))
        length = writeNumber(codemap, bytes, length, others)
        length = writeText(bytes, length, if others == 1 { say(codemap, " other file", " anderen Datei") } else { say(codemap, " other files", " anderen Dateien") })
        addChip(codemap, CHIP_OPEN, FINDING_COLOR, namesake, bytes[0..length])
    }
    const code = binaries_module.bytesOf(binariesOf(codemap), symbol)
    if code > 0 {
        length = writeNumber(codemap, bytes, 0, @intCast(usize, code))
        length = writeText(bytes, length, say(codemap, " B of code", " B Code"))
        addChip(codemap, CHIP_TEXT, DIM_COLOR, NONE, bytes[0..length])
    }
    const commits = history_module.commitsOf(historyOf(codemap), symbol)
    if commits > 0 {
        length = writeNumber(codemap, bytes, 0, @intCast(usize, commits))
        length = writeText(bytes, length, if commits == 1 { " commit" } else { " commits" })
        addChip(codemap, CHIP_TEXT, DIM_COLOR, NONE, bytes[0..length])
    }
    const state = diff_module.stateOf(diffOf(codemap), symbol)
    if state == diff_module.ADDED || state == diff_module.CHANGED {
        length = writeText(bytes, 0, if state == diff_module.ADDED { say(codemap, "added since ", "neu seit ") } else { say(codemap, "changed since ", "geändert seit ") })
        length = writeText(bytes, length, diff_module.baseName(diffOf(codemap)))
        addChip(codemap, CHIP_TEXT, CHANGED_COLOR, NONE, bytes[0..length])
    }
}

// The file name (no folders) a symbol is declared in.
fn fileNameOf(index: *index_module.Index, symbol: u32) -> []const u8 {
    const path = index_module.pathOf(index, index_module.symbolAt(index, symbol).*.file)
    var slash = path.length
    while slash > 0 && path[slash - 1] != 47 { slash -= 1 }
    return path[slash..path.length]
}

// The hints of a line: the crashes that stopped on it or went through it,
// the workaround on it (with a rewrite when there is one).
fn buildLineHints(codemap: *Codemap, tab: usize, line: usize, mark: u8) -> void {
    codemap.*.lensCount = 0
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length: usize = 0
    if mark & MARK_CRASH != 0 {
        const crashes = crashesOf(codemap)
        const relative = tabRelative(codemap, tab)
        var stopped: usize = 0
        var through: usize = 0
        var newest: u32 = NONE
        var frame: usize = 0
        while frame < crashes.*.frameCount {
            const where = crashes_module.frameWhere(crashes_module.frameText(crashes, frame))
            var colon = where.length
            while colon > 0 && where[colon - 1] != 58 { colon -= 1 }
            if colon > 1 && sameBytes(where[0..colon - 1], relative) && parseDigits(where, colon) == line + 1 {
                if crashes.*.frameDepth[frame] == 0 { stopped += 1 } else { through += 1 }
                const record = crashes.*.frameRecord[frame]
                if newest == NONE || crashes_module.timeOf(crashes, record) >= crashes_module.timeOf(crashes, newest) { newest = record }
            }
            frame += 1
        }
        if stopped > 0 {
            length = writeText(bytes, 0, say(codemap, "crashed here ", "hier abgestürzt "))
            length = writeNumber(codemap, bytes, length, stopped)
            length = writeText(bytes, length, "x: ")
            const reason = crashes_module.field(crashes, newest, 3)
            length = writeText(bytes, length, if reason.length > 200 { reason[0..200] } else { reason })
            addChip(codemap, CHIP_CRASHES, CRASH_COLOR, NONE, bytes[0..length])
        } else if through > 0 {
            length = writeNumber(codemap, bytes, 0, through)
            length = writeText(bytes, length, if through == 1 { say(codemap, " crash went through here", " Absturz lief hier hindurch") } else { say(codemap, " crashes went through here", " Abstürze liefen hier hindurch") })
            addChip(codemap, CHIP_CRASHES, CRASH_COLOR, NONE, bytes[0..length])
        }
    }
    if mark & MARK_WORKAROUND != 0 && codemap.*.tabPlaces[tab] != 0 {
        const places = placesOfTab(codemap, tab)
        const workarounds = workaroundsOf(codemap)
        var place: usize = 0
        while place < codemap.*.tabPlaceCount[tab] {
            if @intCast(usize, places[place * 2]) == line {
                const which = @intCast(usize, places[place * 2 + 1])
                const pattern = workarounds.*.pattern[which]
                // The rewrite first (the text may not fit).
                if rewrite_module.rewritable(pattern) && tabIndexedNow(codemap, tab) {
                    addChip(codemap, CHIP_REWRITE, ACCENT, @intCast(u32, which), say(codemap, "Rewrite", "Umschreiben"))
                }
                length = writeText(bytes, 0, workarounds_module.shortTitle(pattern, codemap.*.german))
                length = writeText(bytes, length, " (")
                length = writeText(bytes, length, workarounds_module.missing(pattern, codemap.*.german))
                length = writeText(bytes, length, ")")
                addChip(codemap, CHIP_TEXT, WORKAROUND_COLOR, NONE, bytes[0..length])
                return
            }
            place += 1
        }
    }
}

// The chips made last, from x on the row at y: text, or (with an action)
// lit under the pointer; where the row ends.
fn drawChips(codemap: *Codemap, canvas: *Canvas, x: i32, y: i32, right: i32, alpha: u32) -> i32 {
    const small = smallOf(codemap)
    var at_x = x
    var chip: usize = 0
    while chip < codemap.*.lensCount && at_x < right - 30 {
        const text = chipText(codemap, chip)
        const kind = codemap.*.lensKind[chip]
        const width = canvas_module.measure(small, text)
        if chip > 0 && kind != CHIP_REWRITE && codemap.*.lensKind[chip - 1] != CHIP_REWRITE {
            canvas_module.drawText(canvas, small, "·", at_x + 4, y + 2, canvasColor(DIM_COLOR, alpha), 0)
            at_x += 16
        }
        const slot = codemap.*.chipCount
        const lit = kind != CHIP_TEXT && codemap.*.hover == HIT_CHIP + slot
        if kind == CHIP_REWRITE {
            at_x += 8
            canvas_module.fillRoundedRect(canvas, at_x - 6, y + 1, width + 12, EDITOR_LINE - 2, 5, if lit { canvasColor(ACCENT, 120) } else { canvasColor(ACCENT, 60) })
        }
        canvas_module.drawText(canvas, small, text, at_x, y + 2, if lit { TEXT_COLOR } else { canvasColor(codemap.*.lensColor[chip], alpha) }, right - at_x - 4)
        if lit && kind != CHIP_REWRITE { canvas_module.fillRect(canvas, at_x, y + EDITOR_LINE - 3, width, 1, TEXT_COLOR) }
        if kind != CHIP_TEXT && slot < MAX_CHIPS {
            codemap.*.chipX0[slot] = at_x - 4
            codemap.*.chipX1[slot] = at_x + width + 4
            codemap.*.chipY[slot] = y
            codemap.*.chipKind[slot] = kind
            codemap.*.chipTarget[slot] = codemap.*.lensTarget[chip]
            codemap.*.chipCount = slot + 1
        }
        at_x += width + (if kind == CHIP_REWRITE { 14 } else { 0 })
        chip += 1
    }
    return at_x
}

// The declaration a lens row above `line` is for (NONE: none).
fn lensSymbolAt(codemap: *Codemap, tab: usize, line: usize) -> u32 {
    const spans = spansOf(codemap, tab)
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        if @intCast(usize, spans[span * 4]) == line && hasLens(codemap.*.index, spans[span * 4 + 3]) { return spans[span * 4 + 3] }
        span += 1
    }
    return NONE
}

fn hasLensRow(codemap: *Codemap, tab: usize, line: usize) -> bool {
    return line < codemap.*.tabMarkLines[tab] && marksOf(codemap, tab)[line] & MARK_LENS != 0 && codemap.*.built
}

// Where a line's text row is (a lens row may be above it); -1 above the
// view, the bottom below it.
fn lineY(codemap: *Codemap, tab: usize, line: usize) -> i32 {
    const editor = editorAt(codemap, tab)
    if line < editor.*.top { return -1 }
    const bottom = editorBottom(codemap)
    var y = editorCodeTop()
    var at = editor.*.top
    while at < line {
        y += EDITOR_LINE
        if hasLensRow(codemap, tab, at) { y += EDITOR_LINE }
        if y > bottom { return bottom }
        at += 1
    }
    if hasLensRow(codemap, tab, line) { y += EDITOR_LINE }
    return y
}

// The line whose row is at y (its lens row counts as it).
fn lineAtY(codemap: *Codemap, tab: usize, y: i32) -> usize {
    const editor = editorAt(codemap, tab)
    var row_y = editorCodeTop()
    var line = editor.*.top
    while line < editor.*.lineCount {
        var height = EDITOR_LINE
        if hasLensRow(codemap, tab, line) { height += EDITOR_LINE }
        if y < row_y + height { return line }
        row_y += height
        line += 1
    }
    return editor.*.lineCount
}

// A click on a chip.
fn pressChip(codemap: *Codemap, chip: usize) -> void {
    if chip >= codemap.*.chipCount { return }
    const kind = codemap.*.chipKind[chip]
    const target = codemap.*.chipTarget[chip]
    if kind == CHIP_USES {
        openRefs(codemap, target, codemap.*.chipX0[chip], codemap.*.chipY[chip] + EDITOR_LINE)
    } else if kind == CHIP_CRASHES {
        openFinding(codemap, FINDING_CRASHES)
    } else if kind == CHIP_WORKAROUNDS {
        nextWorkaround(codemap, target)
    } else if kind == CHIP_OPEN {
        const node = nodeOfSymbol(codemap, target)
        if node != NONE { select(codemap, node) }
        openSymbol(codemap, target)
    } else if kind == CHIP_REWRITE {
        rewriteHere(codemap, @intCast(usize, target))
    }
}

// The cursor to the next workaround line of a declaration (from the top
// again after the last).
fn nextWorkaround(codemap: *Codemap, symbol: u32) -> void {
    if !hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const spans = spansOf(codemap, tab)
    var first: usize = 0
    var last: usize = editor.*.lineCount
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        if spans[span * 4 + 3] == symbol {
            first = @intCast(usize, spans[span * 4])
            last = @intCast(usize, spans[span * 4 + 1])
        }
        span += 1
    }
    const marks = marksOf(codemap, tab)
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    var found = editor.*.lineCount
    var line = first
    while line <= last && line < codemap.*.tabMarkLines[tab] {
        if marks[line] & MARK_WORKAROUND != 0 {
            if found == editor.*.lineCount { found = line }
            if line > cursor_line {
                found = line
                break
            }
        }
        line += 1
    }
    if found >= editor.*.lineCount { return }
    editor_module.moveTo(editor, editor_module.lineStart(editor, found), false)
    editor_module.home(editor, false)
    keepCursorSeen(codemap)
}

// The rewrite of one workaround place, in the editor's text (undo takes it
// back; Save writes it).
fn rewriteHere(codemap: *Codemap, place: usize) -> void {
    if !hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    if !tabIndexedNow(codemap, tab) { return }
    const workarounds = workaroundsOf(codemap)
    const pattern = workarounds.*.pattern[place]
    if !codemap.*.rewriteReady {
        rewrite_module.init(rewriteEditsOf(codemap), codemap.*.allocator)
        codemap.*.rewriteReady = true
    }
    const edits = rewriteEditsOf(codemap)
    rewrite_module.plan(edits, workarounds, codemap.*.index, pattern, tabRelative(codemap, tab))
    const offset = @intCast(usize, workarounds.*.offset[place])
    const file = codemap.*.tabFile[tab]
    var chosen = edits.*.count
    var edit: usize = 0
    while edit < edits.*.count {
        if edits.*.file[edit] == file && @intCast(usize, edits.*.start[edit]) <= offset + 64 && @intCast(usize, edits.*.end[edit]) >= offset {
            if chosen == edits.*.count { chosen = edit }
        }
        edit += 1
    }
    if chosen == edits.*.count {
        setNote(codemap, say(codemap, "Nothing to rewrite here", "Hier gibt es nichts umzuschreiben"), "")
        return
    }
    const editor = activeEditor(codemap)
    const line_before = editor_module.lineOf(editor, @intCast(usize, edits.*.start[chosen]))
    const lines_before = editor.*.lineCount
    editor.*.anchor = @intCast(usize, edits.*.start[chosen])
    editor.*.cursor = @intCast(usize, edits.*.end[chosen])
    editor_module.insert(editor, rewrite_module.replacement(edits, chosen))
    shiftMarks(codemap, tab, line_before, lines_before)
    marksOf(codemap, tab)[line_before] = (marksOf(codemap, tab)[line_before] & ~MARK_WORKAROUND) | MARK_CHANGED
    if codemap.*.rewritePattern != 255 { planRewrite(codemap, codemap.*.rewritePattern) }
    setNote(codemap, say(codemap, "Rewritten (Ctrl+Z takes it back, Ctrl+S saves): ", "Umgeschrieben (Strg+Z nimmt es zurück, Strg+S speichert): "), workarounds_module.shortTitle(pattern, codemap.*.german))
    if codemap.*.trace { traceLine(codemap, "rewritten here: ", editor_module.lineText(editor, line_before)) }
    panelOf(codemap).*.dirty = true
}

// ---------------------------------------------------------------------------
// The references list

// The uses of `symbol` (the first 512), listed under (x, y).
fn openRefs(codemap: *Codemap, symbol: u32, x: i32, y: i32) -> void {
    if symbol == NONE || !codemap.*.built { return }
    const index = codemap.*.index
    codemap.*.refsCount = 0
    codemap.*.refsTotal = 0
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol && value.*.use != index_module.USE_DECLARATION {
            if codemap.*.refsCount < MAX_REFS_SHOWN {
                codemap.*.refsList[codemap.*.refsCount] = @intCast(u32, ref)
                codemap.*.refsCount += 1
            }
            codemap.*.refsTotal += 1
        }
        ref += 1
    }
    codemap.*.refsOpen = true
    codemap.*.refsSymbol = symbol
    codemap.*.refsSelected = 0
    codemap.*.refsScroll = 0
    codemap.*.refsX = x
    codemap.*.refsY = y
    if codemap.*.trace {
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeText(bytes, 0, ": ")
        length = writeNumberPlain(bytes, length, codemap.*.refsTotal)
        traceLine(codemap, "references ", index_module.nameOf(index, symbol))
        traceLine(codemap, "references count", bytes[0..length])
    }
    panelOf(codemap).*.dirty = true
}

fn refsShown() -> usize { return 12 }

fn drawRefs(codemap: *Codemap, canvas: *Canvas, right: i32, bottom: i32) -> void {
    if !codemap.*.refsOpen { return }
    const index = codemap.*.index
    var width: i32 = 720
    var x = codemap.*.refsX
    if x + width > right - 14 { x = right - 14 - width }
    if x < SIDEBAR + 8 {
        x = SIDEBAR + 8
        width = right - 14 - x
    }
    const rows = if codemap.*.refsCount < refsShown() { codemap.*.refsCount } else { refsShown() }
    const height = 34 + @intCast(i32, if rows > 0 { rows } else { 1 }) * REF_ROW + 8
    var y = codemap.*.refsY
    if y + height > bottom - 4 { y = bottom - 4 - height }
    codemap.*.refsX = x
    codemap.*.refsY = y
    codemap.*.refsWidth = width
    canvas_module.fillRoundedRect(canvas, x + 2, y + 4, width, height, 10, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 10, canvas_module.color(250, 32, 34, 43))
    canvas_module.strokeRoundedRect(canvas, x, y, width, height, 10, 1, canvas_module.color(255, 58, 62, 76))
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeNumber(codemap, bytes, 0, codemap.*.refsTotal)
    length = writeText(bytes, length, if codemap.*.refsTotal == 1 { say(codemap, " use of ", " Verwendung von ") } else { say(codemap, " uses of ", " Verwendungen von ") })
    length = writeText(bytes, length, index_module.nameOf(index, codemap.*.refsSymbol))
    if codemap.*.refsTotal > codemap.*.refsCount {
        length = writeText(bytes, length, say(codemap, " (the first ", " (die ersten "))
        length = writeNumber(codemap, bytes, length, codemap.*.refsCount)
        length = writeText(bytes, length, ")")
    }
    canvas_module.drawText(canvas, bodyOf(codemap), bytes[0..length], x + 14, y + 9, TEXT_COLOR, width - 28)
    canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Enter opens, Esc closes", "Enter öffnet, Esc schließt"), x + width - 170, y + 11, DIM_COLOR, 160)
    var row: usize = 0
    while row < rows {
        const at = codemap.*.refsScroll + row
        if at >= codemap.*.refsCount { break }
        const row_y = y + 34 + @intCast(i32, row) * REF_ROW
        if at == codemap.*.refsSelected || codemap.*.hover == HIT_REF_ROW + row { canvas_module.fillRoundedRect(canvas, x + 6, row_y, width - 12, REF_ROW, 6, if at == codemap.*.refsSelected { canvas_module.color(255, 52, 78, 130) } else { canvas_module.color(255, 46, 50, 62) }) }
        const value = index_module.refAt(index, @intCast(usize, codemap.*.refsList[at]))
        const file = value.*.file
        const source = index_module.sourceOf(index, file)
        const offset = @intCast(usize, value.*.start)
        const line = index_module.lineOf(index, file, offset)
        length = writeText(bytes, 0, programs_module.relativePath(index, file))
        length = writeText(bytes, length, ":")
        length = writeNumberPlain(bytes, length, line + 1)
        const place_width: i32 = 250
        canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 14, row_y + 4, DIM_COLOR, place_width - 10)
        var line_start = offset
        while line_start > 0 && source[line_start - 1] != 10 { line_start -= 1 }
        while line_start < offset && (source[line_start] == 32 || source[line_start] == 9) { line_start += 1 }
        var line_end = offset
        while line_end < source.length && source[line_end] != 10 { line_end += 1 }
        canvas_module.drawText(canvas, monoOf(codemap), source[line_start..line_end], x + 14 + place_width, row_y + 3, TEXT_COLOR, width - place_width - 28)
        row += 1
    }
    if codemap.*.refsCount == 0 { canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Nothing uses it.", "Nichts verwendet das."), x + 14, y + 38, DIM_COLOR, width - 28) }
}

fn refsHit(codemap: *Codemap, x: i32, y: i32) -> usize {
    if !codemap.*.refsOpen { return HIT_NONE }
    const rows = if codemap.*.refsCount < refsShown() { codemap.*.refsCount } else { refsShown() }
    const height = 34 + @intCast(i32, if rows > 0 { rows } else { 1 }) * REF_ROW + 8
    if !inside(x, y, codemap.*.refsX, codemap.*.refsY, codemap.*.refsWidth, height) { return HIT_NONE }
    if y >= codemap.*.refsY + 34 {
        const row = @intCast(usize, (y - codemap.*.refsY - 34) / REF_ROW)
        if row < rows { return HIT_REF_ROW + row }
    }
    return HIT_REFS
}

// Opens use `at` of the list.
fn openRef(codemap: *Codemap, at: usize) -> void {
    if at >= codemap.*.refsCount { return }
    const index = codemap.*.index
    const value = index_module.refAt(index, @intCast(usize, codemap.*.refsList[at]))
    const offset = @intCast(usize, value.*.start)
    codemap.*.refsOpen = false
    const opened = openFile(codemap, index_module.pathOf(index, value.*.file), index_module.lineOf(index, value.*.file, offset) + 1, index_module.columnOf(index, value.*.file, offset) + 1)
    if codemap.*.trace { traceLine(codemap, "reference opened ", programs_module.relativePath(index, value.*.file)) }
}

// The keys of the list (open); true when it took the key.
fn refsKey(codemap: *Codemap, key: u32) -> bool {
    if !codemap.*.refsOpen { return false }
    if key == KEY_ESCAPE {
        codemap.*.refsOpen = false
    } else if key == KEY_DOWN {
        if codemap.*.refsSelected + 1 < codemap.*.refsCount { codemap.*.refsSelected += 1 }
    } else if key == KEY_UP {
        if codemap.*.refsSelected > 0 { codemap.*.refsSelected -= 1 }
    } else if key == KEY_PAGE_DOWN {
        codemap.*.refsSelected = if codemap.*.refsSelected + refsShown() < codemap.*.refsCount { codemap.*.refsSelected + refsShown() } else { if codemap.*.refsCount > 0 { codemap.*.refsCount - 1 } else { 0 } }
    } else if key == KEY_PAGE_UP {
        codemap.*.refsSelected = if codemap.*.refsSelected > refsShown() { codemap.*.refsSelected - refsShown() } else { 0 }
    } else if key == KEY_ENTER || key == KEY_KP_ENTER {
        openRef(codemap, codemap.*.refsSelected)
        return true
    } else {
        return false
    }
    if codemap.*.refsSelected < codemap.*.refsScroll { codemap.*.refsScroll = codemap.*.refsSelected }
    if codemap.*.refsSelected >= codemap.*.refsScroll + refsShown() { codemap.*.refsScroll = codemap.*.refsSelected + 1 - refsShown() }
    return true
}

// ---------------------------------------------------------------------------
// Completion and signature help (from the index: what is in scope, the
// members of what is before a dot, the builtins after @; the call around
// the cursor)

fn isNameByte(byte: u8) -> bool { return isNameStart(byte) || (byte >= 48 && byte <= 57) }

// Where the cursor is in the index's copy of the tab's file (the same
// line and column when the text was edited since).
fn offsetInIndex(codemap: *Codemap, tab: usize) -> usize {
    const editor = editorAt(codemap, tab)
    if tabIndexedNow(codemap, tab) { return editor.*.cursor }
    return features.offsetIn(codemap.*.index, codemap.*.tabFile[tab], editor_module.lineOf(editor, editor.*.cursor), editor_module.columnOf(editor, editor.*.cursor))
}

// A word of the keywords' or builtins' list as an item: its bit 31, the
// list (bit 30), where it starts and ends.
fn wordItem(list: u32, start: usize, end: usize) -> u32 { return 2147483648 | (list << 30) | (@intCast(u32, start) << 15) | @intCast(u32, end) }

fn itemText(codemap: *Codemap, item: u32) -> []const u8 {
    if item & 2147483648 == 0 { return index_module.nameOf(codemap.*.index, item) }
    const list = if item & 1073741824 != 0 { features.builtins() } else { features.keywords() }
    return list[@intCast(usize, (item >> 15) & 32767)..@intCast(usize, item & 32767)]
}

fn startsWithFolded(text: []const u8, prefix: []const u8) -> bool {
    if prefix.length > text.length { return false }
    var at: usize = 0
    while at < prefix.length {
        if lowerByte(text[at]) != lowerByte(prefix[at]) { return false }
        at += 1
    }
    return true
}

fn lowerByte(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// The list for what is typed at the cursor (closed when nothing fits).
fn updateCompletion(codemap: *Codemap) -> void {
    codemap.*.completeOpen = false
    if !hasTab(codemap) || !codemap.*.built { return }
    const tab = codemap.*.activeTab
    if codemap.*.tabFile[tab] == NONE { return }
    const editor = activeEditor(codemap)
    const text = editor.*.text[0..editor.*.length]
    var found: [4096]u32 = undefined
    var mode: u8 = 0
    var start: usize = 0
    var in_method = false
    var count: usize = 0
    unsafe { count = features.candidates(codemap.*.index, codemap.*.tabFile[tab], text, editor.*.cursor, offsetInIndex(codemap, tab), @ptrCast([*]u32, &found), 4096, &mode, &start, &in_method) }
    const prefix = text[start..editor.*.cursor]
    // Only while a name is typed (or right after a dot or an @).
    if prefix.length == 0 && mode == features.SCOPE { return }
    codemap.*.completeStart = start
    codemap.*.completeCount = 0
    var at: usize = 0
    while at < count && codemap.*.completeCount < 64 {
        const name = index_module.nameOf(codemap.*.index, found[at])
        if startsWithFolded(name, prefix) && !(name.length == prefix.length && prefix.length > 0) && !alreadyListed(codemap, name) {
            codemap.*.completeList[codemap.*.completeCount] = found[at]
            codemap.*.completeCount += 1
        }
        at += 1
    }
    if mode != features.MEMBERS {
        const list: u32 = if mode == features.BUILTINS { 1 } else { 0 }
        const words = if mode == features.BUILTINS { features.builtins() } else { features.keywords() }
        var word_start: usize = 0
        at = 0
        while at <= words.length {
            if at == words.length || words[at] == 32 {
                const word = words[word_start..at]
                if at > word_start && startsWithFolded(word, prefix) && word.length > prefix.length && codemap.*.completeCount < 64 {
                    codemap.*.completeList[codemap.*.completeCount] = wordItem(list, word_start, at)
                    codemap.*.completeCount += 1
                }
                word_start = at + 1
            }
            at += 1
        }
    }
    if codemap.*.completeCount == 0 { return }
    codemap.*.completeOpen = true
    codemap.*.completeSelected = 0
    codemap.*.completeScroll = 0
    if codemap.*.trace {
        var line: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &line) }
        var length = writeNumberPlain(bytes, 0, codemap.*.completeCount)
        length = writeText(bytes, length, ", first ")
        traceLine(codemap, "completion ", bytes[0..length])
        traceLine(codemap, "completion first ", itemText(codemap, codemap.*.completeList[0]))
    }
}

fn alreadyListed(codemap: *Codemap, name: []const u8) -> bool {
    var at: usize = 0
    while at < codemap.*.completeCount {
        if sameBytes(itemText(codemap, codemap.*.completeList[at]), name) { return true }
        at += 1
    }
    return false
}

// The chosen item in place of what was typed of it.
fn acceptCompletion(codemap: *Codemap) -> void {
    if !codemap.*.completeOpen || !hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const name = itemText(codemap, codemap.*.completeList[codemap.*.completeSelected])
    var copy: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &copy) }
    const length = writeText(bytes, 0, if name.length > 250 { name[0..250] } else { name })
    const line_before = editor_module.lineOf(editor, editor.*.cursor)
    const lines_before = editor.*.lineCount
    editor.*.anchor = codemap.*.completeStart
    editor_module.insert(editor, bytes[0..length])
    shiftMarks(codemap, tab, line_before, lines_before)
    codemap.*.completeOpen = false
    if codemap.*.trace { traceLine(codemap, "completed ", bytes[0..length]) }
}

// The keys of the list (open); true when it took the key.
fn completeKey(codemap: *Codemap, key: u32) -> bool {
    if !codemap.*.completeOpen { return false }
    if key == KEY_ESCAPE {
        codemap.*.completeOpen = false
    } else if key == KEY_DOWN {
        if codemap.*.completeSelected + 1 < codemap.*.completeCount { codemap.*.completeSelected += 1 }
    } else if key == KEY_UP {
        if codemap.*.completeSelected > 0 { codemap.*.completeSelected -= 1 }
    } else if key == KEY_ENTER || key == KEY_KP_ENTER || key == KEY_TAB {
        acceptCompletion(codemap)
        keepCursorSeen(codemap)
    } else {
        return false
    }
    if codemap.*.completeSelected < codemap.*.completeScroll { codemap.*.completeScroll = codemap.*.completeSelected }
    if codemap.*.completeSelected >= codemap.*.completeScroll + 8 { codemap.*.completeScroll = codemap.*.completeSelected - 7 }
    return true
}

// The list under the cursor: each name in its kind's color, and what it is.
fn drawCompletion(codemap: *Codemap, canvas: *Canvas, right: i32, bottom: i32) -> void {
    if !codemap.*.completeOpen || !hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const line_y = lineY(codemap, tab, editor_module.lineOf(editor, editor.*.cursor))
    const rows = if codemap.*.completeCount < 8 { codemap.*.completeCount } else { 8 }
    const width: i32 = 520
    const height = @intCast(i32, rows) * 22 + 8
    var x = codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, codemap.*.completeStart)) * codemap.*.charWidth - 30
    if x + width > right - 14 { x = right - 14 - width }
    var y = line_y + EDITOR_LINE + 2
    if y + height > bottom - 4 { y = line_y - height - 2 }
    canvas_module.fillRoundedRect(canvas, x + 2, y + 3, width, height, 8, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 8, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, y, width, height, 8, 1, canvas_module.color(255, 64, 68, 84))
    var row: usize = 0
    while row < rows {
        const at = codemap.*.completeScroll + row
        if at >= codemap.*.completeCount { break }
        const item = codemap.*.completeList[at]
        const row_y = y + 4 + @intCast(i32, row) * 22
        if at == codemap.*.completeSelected { canvas_module.fillRoundedRect(canvas, x + 4, row_y, width - 8, 22, 6, canvas_module.color(255, 52, 78, 130)) }
        const is_word = item & 2147483648 != 0
        const color = if is_word { KEYWORD_COLOR } else { semanticColor(codemap, item, TEXT_COLOR) }
        drawDot(canvas, x + 12, row_y + 7, 8, canvasColor(color, 255))
        const name = itemText(codemap, item)
        canvas_module.drawText(canvas, monoOf(codemap), name, x + 28, row_y + 3, TEXT_COLOR, 220)
        if !is_word {
            const record = index_module.symbolAt(codemap.*.index, item)
            // What it is: its signature (a value: its kind and type).
            const lines = hoverTextOf(codemap)
            protocol.clear(lines)
            if record.*.kind == index_module.FUNCTION {
                protocol.text(lines, features.signatureText(codemap.*.index, item))
            } else if !features.typePlace(lines, codemap.*.index, item) {
                protocol.text(lines, index_module.kindName(record.*.kind))
            }
            canvas_module.drawText(canvas, smallOf(codemap), protocol.contents(lines), x + 256, row_y + 5, DIM_COLOR, width - 268)
        } else {
            canvas_module.drawText(canvas, smallOf(codemap), if item & 1073741824 != 0 { "builtin" } else { "keyword" }, x + 256, row_y + 5, DIM_COLOR, width - 268)
        }
        row += 1
    }
}

// Above the cursor in a call: the function's signature, the argument the
// cursor is at lit, its doc comment's first line.
fn drawSignatureHelp(codemap: *Codemap, canvas: *Canvas, right: i32) -> void {
    if !codemap.*.signatureActive || !hasTab(codemap) || !codemap.*.built { return }
    const tab = codemap.*.activeTab
    if codemap.*.tabFile[tab] == NONE { return }
    const editor = activeEditor(codemap)
    const index = codemap.*.index
    var argument: usize = 0
    const function = features.callAt(index, codemap.*.tabFile[tab], editor.*.text[0..editor.*.length], editor.*.cursor, offsetInIndex(codemap, tab), &argument)
    if function == NONE {
        codemap.*.signatureActive = false
        return
    }
    const label = features.signatureText(index, function)
    const shown = if label.length > 160 { label[0..160] } else { label }
    // The argument's part of the label: the nth parameter's "name: Type".
    const signature_start = index_module.declarationOffset(index, function)
    const source = index_module.sourceOf(index, index_module.symbolAt(index, function).*.file)
    var from: usize = 0
    var to: usize = 0
    var nth: usize = 0
    var child = index_module.symbolAt(index, function).*.firstChild
    while child != NONE {
        const record = index_module.symbolAt(index, child)
        if record.*.kind == index_module.PARAM {
            if nth == argument {
                from = @intCast(usize, record.*.nameStart)
                to = from
                var level: usize = 0
                while to < source.length && !((source[to] == 44 || source[to] == 41) && level == 0) {
                    if source[to] == 40 || source[to] == 91 { level += 1 }
                    if (source[to] == 41 || source[to] == 93) && level > 0 { level -= 1 }
                    to += 1
                }
            }
            nth += 1
        }
        child = record.*.nextSibling
    }
    const mono = monoOf(codemap)
    const cw = codemap.*.charWidth
    const width = @intCast(i32, shown.length) * cw + 24
    const line_y = lineY(codemap, tab, editor_module.lineOf(editor, editor.*.cursor))
    var x = codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, editor.*.cursor)) * cw - 40
    if x + width > right - 14 { x = right - 14 - width }
    if x < codemap.*.editorLeft { x = codemap.*.editorLeft }
    const y = if line_y - 30 >= editorCodeTop() { line_y - 30 } else { line_y + EDITOR_LINE + 4 }
    canvas_module.fillRoundedRect(canvas, x + 2, y + 3, width, 26, 7, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, 26, 7, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, y, width, 26, 7, 1, canvas_module.color(255, 64, 68, 84))
    if to > from && from >= signature_start && to - signature_start <= shown.length {
        const lit_x = x + 12 + @intCast(i32, from - signature_start) * cw
        canvas_module.fillRoundedRect(canvas, lit_x - 2, y + 4, @intCast(i32, to - from) * cw + 4, 18, 4, canvasColor(ACCENT, 90))
    }
    canvas_module.drawText(canvas, mono, shown, x + 12, y + 5, TEXT_COLOR, width - 20)
}

// ---------------------------------------------------------------------------
// Renaming (F2): every use the index knows, in every file

// F2: a field over the name at the cursor, with the name in it.
fn startRename(codemap: *Codemap) -> void {
    if !hasTab(codemap) || !codemap.*.built { return }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    if !tabIndexedNow(codemap, tab) {
        setNote(codemap, say(codemap, "Rename: the file changed since the map read it; show the map once (Ctrl+E) and come back", "Umbenennen: die Datei hat sich geändert, seit die Karte sie las; einmal die Karte zeigen (Strg+E) und zurück"), "")
        return
    }
    const ref = index_module.refAtOffset(codemap.*.index, codemap.*.tabFile[tab], editor.*.cursor)
    if ref == index_module.MAX_REFS {
        setNote(codemap, say(codemap, "Rename: no name here", "Umbenennen: hier ist kein Name"), "")
        return
    }
    const value = index_module.refAt(codemap.*.index, ref)
    const symbol = value.*.symbol
    const kind = index_module.symbolAt(codemap.*.index, symbol).*.kind
    if kind == index_module.FILE {
        setNote(codemap, say(codemap, "Rename: a file is not renamed here", "Umbenennen: eine Datei wird hier nicht umbenannt"), "")
        return
    }
    codemap.*.renameSymbol = symbol
    codemap.*.renameStart = @intCast(usize, value.*.start)
    const name = index_module.nameOf(codemap.*.index, symbol)
    codemap.*.renameLength = writeText(fieldBytes(codemap, @offsetOf(Codemap, "renameText")), 0, if name.length > 120 { name[0..120] } else { name })
    codemap.*.renameOpen = true
    codemap.*.completeOpen = false
}

fn renameKey(codemap: *Codemap, key: u32) -> bool {
    if !codemap.*.renameOpen { return false }
    if key == KEY_ESCAPE {
        codemap.*.renameOpen = false
        return true
    }
    if key == KEY_ENTER || key == KEY_KP_ENTER {
        codemap.*.renameOpen = false
        applyRename(codemap, fieldBytes(codemap, @offsetOf(Codemap, "renameText"))[0..codemap.*.renameLength])
        return true
    }
    if key == KEY_BACKSPACE {
        if codemap.*.renameLength > 0 { codemap.*.renameLength -= 1 }
        return true
    }
    const panel = panelOf(codemap)
    if panel.*.textLength == 0 || modifiers(codemap) & (CONTROL | ALT) != 0 { return true }
    var at: usize = 0
    while at < panel.*.textLength && codemap.*.renameLength < 120 {
        const byte = panel.*.text[at]
        if isNameByte(byte) {
            codemap.*.renameText[codemap.*.renameLength] = byte
            codemap.*.renameLength += 1
        }
        at += 1
    }
    return true
}

// The field over the name.
fn drawRename(codemap: *Codemap, canvas: *Canvas) -> void {
    if !codemap.*.renameOpen || !hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const line = editor_module.lineOf(editor, codemap.*.renameStart)
    const y = lineY(codemap, tab, line)
    const x = codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, codemap.*.renameStart)) * codemap.*.charWidth
    const text = fieldBytes(codemap, @offsetOf(Codemap, "renameText"))[0..codemap.*.renameLength]
    const width = (if text.length > 12 { @intCast(i32, text.length) } else { 12 }) * codemap.*.charWidth + 16
    canvas_module.fillRoundedRect(canvas, x - 6, y - 2, width, EDITOR_LINE + 4, 5, canvas_module.color(255, 22, 24, 30))
    canvas_module.strokeRoundedRect(canvas, x - 7, y - 3, width + 2, EDITOR_LINE + 6, 6, 2, ACCENT)
    canvas_module.drawText(canvas, monoOf(codemap), text, x, y + 2, TEXT_COLOR, 0)
    canvas_module.fillRect(canvas, x + @intCast(i32, text.length) * codemap.*.charWidth + 1, y + 1, 2, EDITOR_LINE - 2, ACCENT)
    canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Enter renames everywhere, Esc keeps it", "Enter benennt überall um, Esc lässt es"), x - 4, y + EDITOR_LINE + 6, DIM_COLOR, 0)
}

// Every use of the symbol (its declaration too) gets the new name, in the
// files (the tabs of them read them again), then the code is read again.
fn applyRename(codemap: *Codemap, name: []const u8) -> void {
    const index = codemap.*.index
    const symbol = codemap.*.renameSymbol
    const old = index_module.nameOf(index, symbol)
    if name.length == 0 || !isNameStart(name[0]) || sameBytes(name, old) { return }
    // The files: none may have changed since the index read it, and no tab
    // of one may hold edits.
    var files: [256]u32 = undefined
    var file_count: usize = 0
    var places: usize = 0
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol {
            places += 1
            var known = false
            var at: usize = 0
            while at < file_count {
                if files[at] == value.*.file { known = true }
                at += 1
            }
            if !known {
                if file_count == 256 {
                    setNote(codemap, say(codemap, "Rename: in more than 256 files, not here", "Umbenennen: in mehr als 256 Dateien, nicht hier"), "")
                    return
                }
                files[file_count] = value.*.file
                file_count += 1
            }
        }
        ref += 1
    }
    var at: usize = 0
    while at < file_count {
        const path = index_module.pathOf(index, files[at])
        if fileStamp(path) > codemap.*.diskStamp {
            setNote(codemap, say(codemap, "Rename: a file changed since the map read it: ", "Umbenennen: eine Datei hat sich geändert, seit die Karte sie las: "), programs_module.relativePath(index, files[at]))
            return
        }
        var tab: usize = 0
        while tab < codemap.*.tabCount {
            if sameBytes(editor_module.pathOf(editorAt(codemap, tab)), path) && editor_module.isDirty(editorAt(codemap, tab)) {
                setNote(codemap, say(codemap, "Rename: save the tab first: ", "Umbenennen: erst den Tab speichern: "), programs_module.relativePath(index, files[at]))
                return
            }
            tab += 1
        }
        at += 1
    }
    // Each file: its text with the name replaced at each use (in order).
    at = 0
    var written: usize = 0
    while at < file_count {
        const file = files[at]
        const source = index_module.sourceOf(index, file)
        const capacity = source.length + places * (if name.length > old.length { name.length - old.length } else { 0 }) + 16
        const memory = codemap.*.allocator.alloc(capacity, 16)
        if memory == null { return }
        const out = memory.?
        var length: usize = 0
        var copied: usize = 0
        var use: usize = index_module.fileAt(index, file).*.refStart
        while use < index_module.fileAt(index, file).*.refEnd {
            const value = index_module.refAt(index, use)
            const start = @intCast(usize, value.*.start)
            if value.*.symbol == symbol && start >= copied && start + old.length <= source.length && sameBytes(source[start..start + old.length], old) {
                length = writeText(out, length, source[copied..start])
                length = writeText(out, length, name)
                copied = start + old.length
            }
            use += 1
        }
        length = writeText(out, length, source[copied..source.length])
        var path_buffer: [1100]u8 = undefined
        var path_bytes: [*]u8 = undefined
        unsafe { path_bytes = @ptrCast([*]u8, &path_buffer) }
        const path_length = writeText(path_bytes, 0, index_module.pathOf(index, file))
        path_bytes[path_length] = 0
        // O_WRONLY | O_CREAT | O_TRUNC
        const handle = std.fs.open(path_bytes, 577, 420)
        if std.fs.isValid(handle) {
            if std.fs.writeAllBytes(handle, out, length) { written += 1 }
            const closed = std.fs.close(handle)
        }
        codemap.*.allocator.free(out, capacity, 16)
        at += 1
    }
    // The tabs of those files read them again, the index reads the code.
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        codemap.*.tabStamp[tab] = -2
        tab += 1
    }
    watchDiskTabs(codemap)
    reload(codemap)
    var text: [160]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeNumber(codemap, bytes, 0, places)
    length = writeText(bytes, length, if places == 1 { say(codemap, " place in ", " Stelle in ") } else { say(codemap, " places in ", " Stellen in ") })
    length = writeNumber(codemap, bytes, length, written)
    length = writeText(bytes, length, if written == 1 { say(codemap, " file: ", " Datei: ") } else { say(codemap, " files: ", " Dateien: ") })
    length = writeText(bytes, length, if name.length > 60 { name[0..60] } else { name })
    setNote(codemap, say(codemap, "Renamed ", "Umbenannt: "), bytes[0..length])
    if codemap.*.trace { traceLine(codemap, "renamed ", bytes[0..length]) }
}

// ---------------------------------------------------------------------------
// Blame on the line numbers: who wrote the line, when, in which commit

fn secondsNow() -> i64 {
    var time: [2]i64 = [2]i64{ 0, 0 }
    // clock_gettime(CLOCK_REALTIME)
    unsafe { const got = std.linux.syscall2(228, 0, @intFromPtr(&time)) }
    return time[0]
}

// The blame of a line of the tab shown (git blame -L N,N), kept until the
// pointer is on another line.
fn blameLine(codemap: *Codemap, tab: usize, line: usize) -> []const u8 {
    const editor = editorAt(codemap, tab)
    if codemap.*.blameTab == tab && codemap.*.blameLineNumber == line && codemap.*.blameVersion == editor.*.version {
        return fieldBytes(codemap, @offsetOf(Codemap, "blameText"))[0..codemap.*.blameLength]
    }
    codemap.*.blameTab = tab
    codemap.*.blameLineNumber = line
    codemap.*.blameVersion = editor.*.version
    const into = fieldBytes(codemap, @offsetOf(Codemap, "blameText"))
    codemap.*.blameLength = 0
    if editor_module.isDirty(editor) {
        codemap.*.blameLength = writeText(into, 0, say(codemap, "Edited: saved, Git can say who wrote the line", "Geändert: gespeichert kann Git sagen, wer die Zeile schrieb"))
        return into[0..codemap.*.blameLength]
    }
    const git = gitOf(codemap)
    if !git_module.usable(git) { return "" }
    var number: [32]u8 = undefined
    var number_bytes: [*]u8 = undefined
    unsafe { number_bytes = @ptrCast([*]u8, &number) }
    var number_length = writeNumberPlain(number_bytes, 0, line + 1)
    number_length = writeText(number_bytes, number_length, ",")
    number_length = writeNumberPlain(number_bytes, number_length, line + 1)
    git_module.begin(git)
    git_module.more(git, "blame --porcelain -L ")
    git_module.more(git, number_bytes[0..number_length])
    git_module.more(git, " -- ")
    git_module.addQuoted(git, editor_module.pathOf(editor))
    const output = git_module.finish(git)
    if output.length < 40 { return "" }
    // The commit, its author, time and summary.
    const hash = output[0..7]
    const uncommitted = sameBytes(output[0..8], "00000000")
    // (Where the author and the summary are: a slice set again would keep
    // its first length.)
    var author_start: usize = 0
    var author_end: usize = 0
    var summary_start: usize = 0
    var summary_end: usize = 0
    var time: i64 = 0
    var at: usize = 0
    while at < output.length {
        var end = at
        while end < output.length && output[end] != 10 { end += 1 }
        const row = output[at..end]
        if row.length > 7 && sameBytes(row[0..7], "author ") {
            author_start = at + 7
            author_end = end
        }
        if row.length > 8 && sameBytes(row[0..8], "summary ") {
            summary_start = at + 8
            summary_end = end
        }
        if row.length > 12 && sameBytes(row[0..12], "author-time ") { time = @intCast(i64, parseDigits(row, 12)) }
        at = end + 1
    }
    const author = output[author_start..author_end]
    const summary = output[summary_start..summary_end]
    var length: usize = 0
    if uncommitted {
        length = writeText(into, 0, say(codemap, "Not committed yet", "Noch nicht committet"))
    } else {
        length = writeText(into, 0, hash)
        length = writeText(into, length, " · ")
        length = writeText(into, length, if author.length > 40 { author[0..40] } else { author })
        length = writeText(into, length, " · ")
        const ago = secondsNow() - time
        const days = if ago > 0 { @intCast(usize, ago) / 86400 } else { 0 }
        if days == 0 {
            length = writeText(into, length, say(codemap, "today", "heute"))
        } else if days < 60 {
            length = writeNumberPlain(into, length, days)
            length = writeText(into, length, if days == 1 { say(codemap, " day ago", " Tag her") } else { say(codemap, " days ago", " Tage her") })
        } else {
            length = writeNumberPlain(into, length, days / 30)
            length = writeText(into, length, say(codemap, " months ago", " Monate her"))
        }
        length = writeText(into, length, " · ")
        length = writeText(into, length, if summary.length > 120 { summary[0..120] } else { summary })
    }
    codemap.*.blameLength = length
    return into[0..length]
}

// Over a line number: who wrote the line.
fn drawBlame(codemap: *Codemap, canvas: *Canvas, right: i32) -> void {
    if codemap.*.gutterHover == 18446744073709551615 || !hasTab(codemap) || codemap.*.hover != HIT_EDITOR { return }
    const tab = codemap.*.activeTab
    const line = codemap.*.gutterHover
    if line >= activeEditor(codemap).*.lineCount { return }
    const text = blameLine(codemap, tab, line)
    if text.length == 0 { return }
    const y = lineY(codemap, tab, line)
    const width = canvas_module.measure(smallOf(codemap), text) + 20
    const x = SIDEBAR + 8
    const box_y = if y + EDITOR_LINE + 30 < editorBottom(codemap) { y + EDITOR_LINE + 2 } else { y - 28 }
    canvas_module.fillRoundedRect(canvas, x + 2, box_y + 3, (if width < right - x - 12 { width } else { right - x - 12 }), 26, 7, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, box_y, (if width < right - x - 12 { width } else { right - x - 12 }), 26, 7, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, box_y, (if width < right - x - 12 { width } else { right - x - 12 }), 26, 7, 1, canvas_module.color(255, 64, 68, 84))
    canvas_module.drawText(canvas, smallOf(codemap), text, x + 10, box_y + 6, TEXT_COLOR, right - x - 32)
}

// A bar at the right: where the view is in the file, and the file's
// problems, crashes and changes as ticks.
fn drawEditorScrollbar(codemap: *Codemap, canvas: *Canvas, right: i32, top: i32, bottom: i32) -> void {
    const editor = activeEditor(codemap)
    const tab = codemap.*.activeTab
    const x = right - 10
    const height = bottom - top
    canvas_module.fillRect(canvas, x, top, 10, height, canvas_module.color(255, 24, 26, 33))
    const lines = if editor.*.lineCount > 0 { editor.*.lineCount } else { 1 }
    const rows = editorRows(codemap)
    const thumb_top = top + @intCast(i32, editor.*.top * @intCast(usize, height) / lines)
    var thumb = @intCast(i32, rows * @intCast(usize, height) / lines)
    if thumb < 20 { thumb = 20 }
    if thumb > height { thumb = height }
    canvas_module.fillRoundedRect(canvas, x + 2, thumb_top, 6, thumb, 3, canvas_module.color(255, 70, 74, 90))
    const marks = marksOf(codemap, tab)
    var line: usize = 0
    while line < editor.*.lineCount && line < codemap.*.tabMarkLines[tab] {
        const mark = marks[line]
        if mark != 0 {
            const y = top + @intCast(i32, line * @intCast(usize, height) / lines)
            var color: u32 = 0
            if mark & (MARK_ADDED | MARK_CHANGED) != 0 { color = canvasColor(CHANGED_COLOR, 200) }
            if mark & MARK_CRASH != 0 { color = canvasColor(CRASH_COLOR, 255) }
            if mark & MARK_WARNING != 0 { color = canvasColor(WARNING_COLOR, 255) }
            if mark & MARK_ERROR != 0 { color = canvasColor(ERROR_COLOR, 255) }
            if color != 0 { canvas_module.fillRect(canvas, x + 1, y, 8, 2, color) }
        }
        line += 1
    }
}

// What the name under the pointer is: its signature, doc comment and what
// the map measures of it.
fn drawEditorHover(codemap: *Codemap, canvas: *Canvas, right: i32, bottom: i32) -> void {
    if codemap.*.editorHover == 18446744073709551615 || codemap.*.hover != HIT_EDITOR || codemap.*.pressed { return }
    const symbol = symbolAtCursor(codemap, codemap.*.editorHover)
    if symbol == NONE { return }
    const index = codemap.*.index
    var signature_start: usize = 0
    var signature_length: usize = 0
    index_module.signatureRange(index, symbol, &signature_start, &signature_length)
    var doc_start: usize = 0
    var doc_length: usize = 0
    index_module.docRange(index, symbol, &doc_start, &doc_length)
    const source = index_module.sourceOf(index, index_module.symbolAt(index, symbol).*.file)
    const signature = if signature_length > 0 { source[signature_start..signature_start + (if signature_length > 200 { 200 } else { signature_length })] } else { index_module.nameOf(index, symbol) }
    var lens: [256]u8 = undefined
    var lens_bytes: [*]u8 = undefined
    unsafe { lens_bytes = @ptrCast([*]u8, &lens) }
    const lens_length = writeLens(codemap, lens_bytes, symbol)
    // Where it belongs (a field of which struct, a local in which
    // function; its file and line), and its type with where that is.
    const lines = hoverTextOf(codemap)
    protocol.clear(lines)
    features.place(lines, index, symbol)
    const place_length = lines.*.length
    const typed = features.typePlace(lines, index, symbol)
    const place = protocol.contents(lines)[0..place_length]
    const type_line = protocol.contents(lines)[place_length..lines.*.length]
    const width: i32 = 460
    var x = codemap.*.pointerX + 12
    if x + width > right - 12 { x = right - 12 - width }
    var y = codemap.*.pointerY + 18
    // Measure first (drawn off screen), then the box and the text.
    const doc = source[doc_start..doc_start + (if doc_length > 600 { 600 } else { doc_length })]
    const signature_height = drawWrapped(codemap, canvas, signature, monoOf(codemap), x + 12, -10000, width - 24, TEXT_COLOR, 4, 17)
    const doc_height = if doc_length > 0 { drawWrapped(codemap, canvas, doc, smallOf(codemap), x + 12, -10000, width - 24, DIM_COLOR, 8, 16) } else { 0 }
    const place_height = drawWrapped(codemap, canvas, place, smallOf(codemap), x + 12, -10000, width - 24, TEXT_COLOR, 2, 16)
    const type_height = if typed { drawWrapped(codemap, canvas, type_line, smallOf(codemap), x + 12, -10000, width - 24, TEXT_COLOR, 2, 16) } else { 0 }
    const height = signature_height + doc_height + place_height + type_height + 52
    if y + height > bottom - 4 { y = codemap.*.pointerY - height - 8 }
    canvas_module.fillRoundedRect(canvas, x + 2, y + 3, width, height, 8, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 8, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, y, width, height, 8, 1, canvas_module.color(255, 64, 68, 84))
    var line_y = y + 10
    line_y += drawWrapped(codemap, canvas, signature, monoOf(codemap), x + 12, line_y, width - 24, TEXT_COLOR, 4, 17)
    line_y += 4
    line_y += drawWrapped(codemap, canvas, place, smallOf(codemap), x + 12, line_y, width - 24, canvasColor(TYPE_COLOR, 255), 2, 16)
    if typed { line_y += drawWrapped(codemap, canvas, type_line, smallOf(codemap), x + 12, line_y, width - 24, DIM_COLOR, 2, 16) }
    if doc_length > 0 { line_y += drawWrapped(codemap, canvas, doc, smallOf(codemap), x + 12, line_y + 4, width - 24, DIM_COLOR, 8, 16) + 4 }
    canvas_module.drawText(canvas, smallOf(codemap), lens_bytes[0..lens_length], x + 12, line_y + 6, canvasColor(ACCENT, 255), width - 24)
}

// The tabs, the file's place, Map (the declaration at the cursor in the
// galaxy) and Save.
fn drawTabs(codemap: *Codemap, canvas: *Canvas, left: i32, right: i32) -> void {
    canvas_module.fillRect(canvas, left, TOOLBAR, right - left, TAB_BAR, canvas_module.color(255, 30, 32, 40))
    canvas_module.fillRect(canvas, left, TOOLBAR + TAB_BAR - 1, right - left, 1, canvas_module.color(255, 20, 21, 27))
    var x = left + 6
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = editorAt(codemap, tab)
        const path = editor_module.pathOf(editor)
        var slash = path.length
        while slash > 0 && path[slash - 1] != 47 { slash -= 1 }
        const name = path[slash..path.length]
        const width = canvas_module.measure(bodyOf(codemap), name) + 44
        const active = tab == codemap.*.activeTab
        if active {
            canvas_module.fillRect(canvas, x, TOOLBAR + 4, width, TAB_BAR - 4, EDITOR_BACKGROUND)
            canvas_module.fillRect(canvas, x, TOOLBAR + 4, width, 2, ACCENT)
        } else if codemap.*.hover == HIT_TAB + tab || codemap.*.hover == HIT_TAB_CLOSE + tab {
            canvas_module.fillRect(canvas, x, TOOLBAR + 4, width, TAB_BAR - 4, canvas_module.color(255, 38, 41, 51))
        }
        canvas_module.drawText(canvas, bodyOf(codemap), name, x + 12, TOOLBAR + 9, if active { TEXT_COLOR } else { DIM_COLOR }, 0)
        // Edited: a dot; under the pointer: an x that closes.
        const mark_x = x + width - 22
        if codemap.*.hover == HIT_TAB_CLOSE + tab || (codemap.*.hover == HIT_TAB + tab && !editor_module.isDirty(editor)) {
            var step: i32 = 0
            while step < 8 {
                canvas_module.fillRect(canvas, mark_x + 3 + step, TOOLBAR + 12 + step, 2, 1, TEXT_COLOR)
                canvas_module.fillRect(canvas, mark_x + 10 - step, TOOLBAR + 12 + step, 2, 1, TEXT_COLOR)
                step += 1
            }
        } else if editor_module.isDirty(editor) {
            drawDot(canvas, mark_x + 4, TOOLBAR + 13, 8, TEXT_COLOR)
        }
        codemap.*.tabX[tab] = x
        codemap.*.tabWidth[tab] = width
        x += width + 2
        tab += 1
    }
    // At the right: Save and Map.
    const map_label = say(codemap, "Show in map", "In der Karte")
    const map_width = canvas_module.measure(smallOf(codemap), map_label) + 20
    const save_label = say(codemap, "Save", "Speichern")
    const save_width = canvas_module.measure(smallOf(codemap), save_label) + 20
    const map_x = right - 10 - map_width
    const save_x = map_x - 6 - save_width
    codemap.*.editorMapX = map_x
    codemap.*.editorSaveX = save_x
    if hasTab(codemap) {
        const dirty = editor_module.isDirty(activeEditor(codemap))
        canvas_module.fillRoundedRect(canvas, save_x, TOOLBAR + 5, save_width, TAB_BAR - 10, 6, if codemap.*.hover == HIT_EDITOR_SAVE && dirty { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 46, 49, 60) })
        canvas_module.drawText(canvas, smallOf(codemap), save_label, save_x + 10, TOOLBAR + 9, if dirty { TEXT_COLOR } else { DIM_COLOR }, 0)
        canvas_module.fillRoundedRect(canvas, map_x, TOOLBAR + 5, map_width, TAB_BAR - 10, 6, if codemap.*.hover == HIT_EDITOR_MAP { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 46, 49, 60) })
        canvas_module.drawText(canvas, smallOf(codemap), map_label, map_x + 10, TOOLBAR + 9, TEXT_COLOR, 0)
    }
}

// The status bar in the editor: the file, line and column, edited, the
// problems (the cursor's line's message), and when the index is older.
fn drawEditorStatus(codemap: *Codemap, canvas: *Canvas, top: i32, width: i32) -> void {
    codemap.*.crumbCount = 0
    const editor = activeEditor(codemap)
    const small = smallOf(codemap)
    // A note (saved, built, committed) on the right; the rest before it.
    var right = width - 12
    if codemap.*.noteLength > 0 {
        const note = noteText(codemap)
        const note_width = canvas_module.measure(small, note)
        right = width - 14 - note_width - 20
        canvas_module.drawText(canvas, small, note, width - 14 - note_width, top + 7, canvas_module.color(255, 240, 160, 90), 0)
    }
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const line = editor_module.lineOf(editor, editor.*.cursor)
    var length = writeText(bytes, 0, tabRelative(codemap, codemap.*.activeTab))
    length = writeText(bytes, length, say(codemap, "   Ln ", "   Z "))
    length = writeNumberPlain(bytes, length, line + 1)
    length = writeText(bytes, length, say(codemap, ", Col ", ", Sp "))
    length = writeNumberPlain(bytes, length, editor_module.columnOf(editor, editor.*.cursor) + 1)
    if editor_module.isDirty(editor) { length = writeText(bytes, length, say(codemap, "   edited", "   geändert")) }
    canvas_module.drawText(canvas, small, bytes[0..length], SIDEBAR + 12, top + 7, DIM_COLOR, 0)
    var x = SIDEBAR + 24 + canvas_module.measure(small, bytes[0..length])
    // Problems of the file, and the message on the cursor's line.
    const path = editor_module.pathOf(editor)
    var errors: usize = 0
    var warnings: usize = 0
    var source: usize = 0
    while source < 2 {
        const check = problemsOf(codemap, source)
        const output = check_module.outputText(check)
        var at: usize = 0
        while at < check.*.count {
            const diagnostic = check_module.diagnosticAt(check, at)
            if diagnosticInFile(codemap, output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength], path) {
                if diagnostic.*.isError { errors += 1 } else { warnings += 1 }
            }
            at += 1
        }
        source += 1
    }
    length = 0
    if errors + warnings > 0 {
        length = writeNumberPlain(bytes, 0, errors)
        length = writeText(bytes, length, say(codemap, " errors, ", " Fehler, "))
        length = writeNumberPlain(bytes, length, warnings)
        length = writeText(bytes, length, say(codemap, " warnings", " Warnungen"))
        canvas_module.drawText(canvas, small, bytes[0..length], x, top + 7, canvasColor(if errors > 0 { ERROR_COLOR } else { WARNING_COLOR }, 255), 0)
        x += canvas_module.measure(small, bytes[0..length]) + 14
        const shown = problemOnLine(codemap, line)
        if shown.length > 0 && right - x > 40 { canvas_module.drawText(canvas, small, shown, x, top + 7, TEXT_COLOR, right - x) }
    } else if right - x <= 40 {
        // No room left.
    } else if codemap.*.stale {
        const note = say(codemap, "Saved: the map reads it again when you switch to it", "Gespeichert: die Karte liest neu ein, sobald du zu ihr wechselst")
        canvas_module.drawText(canvas, small, note, x, top + 7, canvasColor(WARNING_COLOR, 255), right - x)
    } else if checkOf(codemap).*.running {
        canvas_module.drawText(canvas, small, say(codemap, "The compiler checks the file ...", "Der Compiler prüft die Datei ..."), x, top + 7, DIM_COLOR, right - x)
    }
}

// The compiler's message on `line` of the tab shown ("": none).
fn problemOnLine(codemap: *Codemap, line: usize) -> []const u8 {
    const first = problemOnLineFrom(codemap, checkOf(codemap), line)
    if first.length > 0 { return first }
    return problemOnLineFrom(codemap, buildOf(codemap), line)
}

fn problemOnLineFrom(codemap: *Codemap, check: *check_module.Check, line: usize) -> []const u8 {
    const path = editor_module.pathOf(activeEditor(codemap))
    const output = check_module.outputText(check)
    var at: usize = 0
    while at < check.*.count {
        const diagnostic = check_module.diagnosticAt(check, at)
        if diagnostic.*.line == line + 1 && diagnosticInFile(codemap, output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength], path) {
            return output[diagnostic.*.messageStart..diagnostic.*.messageStart + diagnostic.*.messageLength]
        }
        at += 1
    }
    return ""
}

// The view switch at the top of the sidebar: Map | Editor.
fn drawViewSwitch(codemap: *Codemap, canvas: *Canvas, y: i32) -> void {
    const half = (SIDEBAR - 24) / 2
    canvas_module.fillRoundedRect(canvas, 10, y, SIDEBAR - 20, 28, 8, canvas_module.color(255, 20, 22, 28))
    var which: u8 = 0
    while which < 2 {
        const x = 12 + @intCast(i32, which) * half
        const chosen = codemap.*.view == which
        const hit = if which == VIEW_MAP { HIT_VIEW_MAP } else { HIT_VIEW_EDITOR }
        if chosen {
            canvas_module.fillRoundedRect(canvas, x, y + 2, half, 24, 7, canvas_module.color(255, 58, 63, 78))
        } else if codemap.*.hover == hit {
            canvas_module.fillRoundedRect(canvas, x, y + 2, half, 24, 7, canvas_module.color(255, 40, 43, 54))
        }
        var label: [48]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &label) }
        var length = writeText(bytes, 0, if which == VIEW_MAP { say(codemap, "Map", "Karte") } else { "Editor" })
        if which == VIEW_EDITOR && codemap.*.tabCount > 0 {
            length = writeText(bytes, length, " ")
            length = writeNumberPlain(bytes, length, codemap.*.tabCount)
        }
        const width = canvas_module.measure(bodyOf(codemap), bytes[0..length])
        // A small galaxy or lines of text before the name.
        const icon_x = x + (half - width - 16) / 2
        if which == VIEW_MAP {
            drawDot(canvas, icon_x, y + 9, 6, canvasColor(TYPE_COLOR, 255))
            drawDot(canvas, icon_x + 6, y + 14, 4, canvasColor(KEYWORD_COLOR, 255))
            drawDot(canvas, icon_x + 3, y + 17, 3, canvasColor(STRING_COLOR, 255))
        } else {
            var step: i32 = 0
            while step < 4 {
                canvas_module.fillRect(canvas, icon_x, y + 8 + step * 4, if step % 2 == 0 { 10 } else { 7 }, 2, if chosen { TEXT_COLOR } else { DIM_COLOR })
                step += 1
            }
        }
        canvas_module.drawText(canvas, bodyOf(codemap), bytes[0..length], icon_x + 16, y + 6, if chosen { TEXT_COLOR } else { DIM_COLOR }, 0)
        which += 1
    }
    codemap.*.viewSwitchY = y
}


// ---------------------------------------------------------------------------
// Building and committing

// The program Build builds: the one whose main file the editor shows,
// else the one chosen under Program (the count: none).
fn buildTarget(codemap: *Codemap) -> usize {
    const programs = programsOf(codemap)
    if !codemap.*.built { return programs.*.count }
    if codemap.*.view == VIEW_EDITOR && hasTab(codemap) {
        const tab = codemap.*.activeTab
        const program = programs_module.programOfPath(programs, tabRelative(codemap, tab))
        if program < programs.*.count { return program }
        if programChosen(codemap) { return codemap.*.program }
        // A file of no program's own: the first program that reaches the
        // declaration at the cursor, else one in the file.
        const editor = activeEditor(codemap)
        const symbol = declarationOnLine(codemap, tab, editor_module.lineOf(editor, editor.*.cursor))
        const spans = spansOf(codemap, tab)
        var span: usize = 0
        while span <= codemap.*.tabSpanCount[tab] {
            const which = if span == 0 { symbol } else { spans[(span - 1) * 4 + 3] }
            if which != NONE {
                var reaching: usize = 0
                while reaching < programs.*.count {
                    if programs_module.reaches(programs, reaching, which) { return reaching }
                    reaching += 1
                }
            }
            span += 1
        }
    }
    return if programChosen(codemap) { codemap.*.program } else { programs.*.count }
}

// Build: the program into ROOT/mlx-out/bin/NAME (its /s as -), in the
// background; its problems go on the lines like a check's.
fn startBuild(codemap: *Codemap) -> void {
    const build = buildOf(codemap)
    if build.*.running { return }
    const programs = programsOf(codemap)
    const program = buildTarget(codemap)
    if program >= programs.*.count {
        setNote(codemap, say(codemap, "Build: no program reaches this; choose one under Program", "Bauen: kein Programm erreicht das; wähle eins unter Programm"), "")
        return
    }
    // Edited tabs are saved first.
    saveAllTabs(codemap)
    const name = programs_module.nameOf(programs, program)
    codemap.*.buildNameLength = 0
    for byte in name {
        if codemap.*.buildNameLength < 120 {
            codemap.*.buildName[codemap.*.buildNameLength] = if byte == 47 { 45 } else { byte }
            codemap.*.buildNameLength += 1
        }
    }
    var target: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &target) }
    var length = writeText(bytes, 0, rootText(codemap))
    length = writeText(bytes, length, "/mlx-out")
    bytes[length] = 0
    const made_out = std.linux.syscall2(83, @intFromPtr(bytes), 493)
    length = writeText(bytes, length, "/bin")
    bytes[length] = 0
    const made_bin = std.linux.syscall2(83, @intFromPtr(bytes), 493)
    length = writeText(bytes, length, "/")
    length = writeText(bytes, length, fieldBytes(codemap, @offsetOf(Codemap, "buildName"))[0..codemap.*.buildNameLength])
    const source = index_module.pathOf(codemap.*.index, programs.*.file[program])
    if !check_module.requestBuild(build, source, bytes[0..length], panel_module.milliseconds()) {
        if check_module.compilerPath(build).length == 0 {
            setNote(codemap, say(codemap, "Build: no compiler found (MLX_COMPILER, mlx-out/bin/compiler/mlx4 or mlx4)", "Bauen: kein Compiler gefunden (MLX_COMPILER, mlx-out/bin/compiler/mlx4 oder mlx4)"), "")
        } else {
            setNote(codemap, say(codemap, "Build: the compiler did not start: ", "Bauen: der Compiler startete nicht: "), check_module.compilerPath(build))
        }
        return
    }
    codemap.*.buildStarted = panel_module.milliseconds()
    if codemap.*.trace { traceLine(codemap, "build ", fieldBytes(codemap, @offsetOf(Codemap, "buildName"))[0..codemap.*.buildNameLength]) }
    panelOf(codemap).*.dirty = true
}

// The tabs with edits not saved.
fn unsavedTabs(codemap: *Codemap) -> usize {
    var count: usize = 0
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        if editor_module.isDirty(editorAt(codemap, tab)) { count += 1 }
        tab += 1
    }
    return count
}

fn saveAllTabs(codemap: *Codemap) -> void {
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = editorAt(codemap, tab)
        if editor_module.isDirty(editor) && editor_module.save(editor) {
            codemap.*.stale = true
            codemap.*.tabStamp[tab] = fileStamp(editor_module.pathOf(editor))
        }
        tab += 1
    }
}

// The build ended: the new program's machine code into the map, or its
// first error in the editor.
fn finishBuild(codemap: *Codemap) -> void {
    const build = buildOf(codemap)
    const name = fieldBytes(codemap, @offsetOf(Codemap, "buildName"))[0..codemap.*.buildNameLength]
    var errors: usize = 0
    var first: usize = build.*.count
    var at: usize = 0
    while at < build.*.count {
        if check_module.diagnosticAt(build, at).*.isError {
            if errors == 0 { first = at }
            errors += 1
        }
        at += 1
    }
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length: usize = 0
    if build.*.status == 0 && errors == 0 {
        length = writeText(bytes, 0, say(codemap, "Built ", "Gebaut: "))
        length = writeText(bytes, length, name)
        length = writeText(bytes, length, say(codemap, " in ", " in "))
        const tenths = (panel_module.milliseconds() - codemap.*.buildStarted) / 100
        length = writeNumberPlain(bytes, length, tenths / 10)
        length = writeText(bytes, length, say(codemap, ".", ","))
        length = writeNumberPlain(bytes, length, tenths % 10)
        length = writeText(bytes, length, " s: mlx-out/bin/")
        length = writeText(bytes, length, name)
        rescanBinaries(codemap)
    } else {
        length = writeText(bytes, 0, say(codemap, "Build of ", "Bauen von "))
        length = writeText(bytes, length, name)
        length = writeText(bytes, length, say(codemap, " failed: ", " fehlgeschlagen: "))
        length = writeNumber(codemap, bytes, length, errors)
        length = writeText(bytes, length, say(codemap, " errors", " Fehler"))
        // The first error, in the editor.
        if first < build.*.count {
            const diagnostic = check_module.diagnosticAt(build, first)
            const output = check_module.outputText(build)
            const where = output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength]
            var path: [1200]u8 = undefined
            var path_bytes: [*]u8 = undefined
            unsafe { path_bytes = @ptrCast([*]u8, &path) }
            var path_length: usize = 0
            if where.length > 0 && where[0] != 47 {
                path_length = writeText(path_bytes, 0, rootText(codemap))
                path_length = writeText(path_bytes, path_length, "/")
            }
            path_length = writeText(path_bytes, path_length, where)
            const opened = openFile(codemap, path_bytes[0..path_length], diagnostic.*.line, diagnostic.*.column)
        }
    }
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        computeMarks(codemap, tab)
        tab += 1
    }
    setNote(codemap, bytes[0..length], "")
    if codemap.*.trace { traceLine(codemap, "build done: ", bytes[0..length]) }
    panelOf(codemap).*.dirty = true
}

// The binaries again (after a build): the machine code of each function.
fn rescanBinaries(codemap: *Codemap) -> void {
    var directories: [8192]u8 = undefined
    var directory_bytes: [*]u8 = undefined
    unsafe { directory_bytes = @ptrCast([*]u8, &directories) }
    const length = binaries_module.defaultDirectories(rootText(codemap), codemap.*.environment, directory_bytes)
    binaries_module.scan(binariesOf(codemap), codemap.*.index, programsOf(codemap), directory_bytes[0..length])
    chooseBinary(codemap)
    computeMetric(codemap)
    refreshFindings(codemap)
}

// The files Git names as changed (git status --porcelain).
fn refreshChanges(codemap: *Codemap) -> void {
    codemap.*.changeCount = 0
    codemap.*.changesLength = 0
    const git = gitOf(codemap)
    if !codemap.*.built || !git_module.usable(git) { return }
    const text = git_module.run(git, "status --porcelain")
    for byte in text {
        if codemap.*.changesLength < 4096 {
            codemap.*.changes[codemap.*.changesLength] = byte
            codemap.*.changesLength += 1
        }
        if byte == 10 { codemap.*.changeCount += 1 }
    }
}

// Commit (and push): the message, all changes (edited tabs saved first),
// in the background.
fn startCommit(codemap: *Codemap, push: bool) -> void {
    if codemap.*.job != JOB_NONE { return }
    const message = fieldBytes(codemap, @offsetOf(Codemap, "commitMessage"))[0..codemap.*.commitLength]
    if message.length == 0 {
        setNote(codemap, say(codemap, "Commit: write a message first", "Commit: erst eine Nachricht schreiben"), "")
        return
    }
    saveAllTabs(codemap)
    const git = gitOf(codemap)
    const log_length = jobLogPath(codemap)
    if log_length == 0 { return }
    const log = fieldBytes(codemap, @offsetOf(Codemap, "jobLog"))[0..log_length]
    const root = rootText(codemap)
    git_module.beginShell(git)
    git_module.more(git, "{ ( git -C ")
    git_module.addQuoted(git, root)
    git_module.more(git, " add -A && git -C ")
    git_module.addQuoted(git, root)
    git_module.more(git, " commit -q -m ")
    git_module.addQuoted(git, message)
    if push {
        git_module.more(git, " && git -C ")
        git_module.addQuoted(git, root)
        git_module.more(git, " push -q -u origin HEAD")
    }
    git_module.more(git, " ) > ")
    git_module.addQuoted(git, log)
    git_module.more(git, " 2>&1; echo \"exit $?\" >> ")
    git_module.addQuoted(git, log)
    git_module.more(git, "; }")
    codemap.*.jobProcess = git_module.spawn(git)
    if codemap.*.jobProcess <= 0 { return }
    codemap.*.job = if push { JOB_PUSH } else { JOB_COMMIT }
    codemap.*.popup = POPUP_NONE
    if codemap.*.trace { traceLine(codemap, if push { "commit and push: " } else { "commit: " }, message) }
    setNote(codemap, if push { say(codemap, "Committing and pushing ...", "Commit und Push laufen ...") } else { say(codemap, "Committing ...", "Commit läuft ...") }, "")
}

// $XDG_CACHE_HOME/mlx/codemap/observatory-job.log; its length (0: none).
fn jobLogPath(codemap: *Codemap) -> usize {
    const into = fieldBytes(codemap, @offsetOf(Codemap, "jobLog"))
    var length = history_module.cacheDirectoryOf(codemap.*.environment, into)
    if length == 0 { return 0 }
    length = writeText(into, length, "/observatory-job.log")
    into[length] = 0
    codemap.*.jobLogLength = length
    return length
}

// The commit (and push) ended: what Git said, the changes again.
fn finishJob(codemap: *Codemap) -> void {
    const push = codemap.*.job == JOB_PUSH
    codemap.*.job = JOB_NONE
    var text: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length: usize = 0
    const file = std.fs.open(fieldBytes(codemap, @offsetOf(Codemap, "jobLog")), 0, 0)
    if std.fs.isValid(file) {
        const got = std.fs.read(file, bytes, 4000)
        if got > 0 { length = @intCast(usize, got) }
        const closed = std.fs.close(file)
    }
    const output = bytes[0..length]
    // "exit N" on the last line.
    var end = length
    while end > 0 && (output[end - 1] == 10 || output[end - 1] == 32) { end -= 1 }
    var start = end
    while start > 0 && output[start - 1] != 10 { start -= 1 }
    const status_line = output[start..end]
    const ok = status_line.length == 6 && sameBytes(status_line, "exit 0")
    const message = fieldBytes(codemap, @offsetOf(Codemap, "commitMessage"))[0..codemap.*.commitLength]
    if ok {
        setNote(codemap, if push { say(codemap, "Committed and pushed: ", "Committet und gepusht: ") } else { say(codemap, "Committed: ", "Committet: ") }, message)
        codemap.*.commitLength = 0
    } else {
        // What Git said: its last "fatal:" or "error:" line, else its first.
        var said_start: usize = 0
        var said_end: usize = 0
        var line_start: usize = 0
        while line_start < start {
            var line_end = line_start
            while line_end < start && output[line_end] != 10 { line_end += 1 }
            const line = output[line_start..line_end]
            const telling = (line.length > 6 && sameBytes(line[0..6], "fatal:")) || (line.length > 6 && sameBytes(line[0..6], "error:"))
            if telling || (said_end == 0 && line.length > 0) {
                said_start = line_start
                said_end = line_end
            }
            line_start = line_end + 1
        }
        if said_end > said_start + 120 { said_end = said_start + 120 }
        setNote(codemap, if push { say(codemap, "Commit or push failed: ", "Commit oder Push fehlgeschlagen: ") } else { say(codemap, "Commit failed: ", "Commit fehlgeschlagen: ") }, output[said_start..said_end])
    }
    if codemap.*.trace { traceLine(codemap, "commit done: ", status_line) }
    refreshChanges(codemap)
    runDiff(codemap)
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        computeMarks(codemap, tab)
        tab += 1
    }
    refreshFindings(codemap)
    panelOf(codemap).*.dirty = true
}

// The history's top: the changed files, the message, Commit and Commit
// and push (nothing changed: a line that says so).
fn commitSectionHeight(codemap: *Codemap) -> i32 {
    if codemap.*.changeCount == 0 { return 40 }
    const files_shown = if codemap.*.changeCount > 8 { 8 } else { codemap.*.changeCount }
    return 44 + @intCast(i32, files_shown) * 20 + (if codemap.*.changeCount > 8 { 20 } else { 0 }) + 92
}

fn drawCommitSection(codemap: *Codemap, canvas: *Canvas, x: i32, top: i32, width: i32) -> void {
    if codemap.*.changeCount == 0 {
        canvas_module.drawText(canvas, bodyOf(codemap), say(codemap, "Nothing to commit", "Nichts zu committen"), x + 16, top + 14, DIM_COLOR, width - 32)
        return
    }
    const files_shown = if codemap.*.changeCount > 8 { 8 } else { codemap.*.changeCount }
    var text: [128]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeNumber(codemap, bytes, 0, codemap.*.changeCount)
    length = writeText(bytes, length, if codemap.*.changeCount == 1 { say(codemap, " changed file", " geänderte Datei") } else { say(codemap, " changed files", " geänderte Dateien") })
    var y = top + 14
    canvas_module.drawText(canvas, bodyOf(codemap), bytes[0..length], x + 16, y, TEXT_COLOR, width - 32)
    y += 26
    // The files: Git's two letters and the path.
    const changes = fieldBytes(codemap, @offsetOf(Codemap, "changes"))[0..codemap.*.changesLength]
    var at: usize = 0
    var shown: usize = 0
    while at < changes.length && shown < files_shown {
        var end = at
        while end < changes.length && changes[end] != 10 { end += 1 }
        const line = changes[at..end]
        if line.length > 3 {
            const state = line[0..2]
            const color = if state[0] == 63 || state[1] == 65 || state[0] == 65 { CHANGED_COLOR } else if state[0] == 68 || state[1] == 68 { ERROR_COLOR } else { TYPE_COLOR }
            canvas_module.drawText(canvas, monoOf(codemap), state, x + 16, y, canvasColor(color, 255), 0)
            canvas_module.drawText(canvas, smallOf(codemap), line[3..line.length], x + 44, y + 1, TEXT_COLOR, width - 60)
        }
        y += 20
        shown += 1
        at = end + 1
    }
    if codemap.*.changeCount > 8 {
        length = writeText(bytes, 0, "+ ")
        length = writeNumber(codemap, bytes, length, codemap.*.changeCount - 8)
        length = writeText(bytes, length, say(codemap, " more", " weitere"))
        canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 44, y + 1, DIM_COLOR, 0)
        y += 20
    }
    // The message.
    y += 6
    codemap.*.commitFieldY = y
    canvas_module.fillRoundedRect(canvas, x + 12, y, width - 24, 30, 7, canvas_module.color(255, 22, 24, 30))
    canvas_module.strokeRoundedRect(canvas, x + 11, y - 1, width - 22, 32, 8, 2, ACCENT)
    const message = fieldBytes(codemap, @offsetOf(Codemap, "commitMessage"))[0..codemap.*.commitLength]
    if message.length == 0 {
        canvas_module.drawText(canvas, bodyOf(codemap), say(codemap, "Commit message", "Commit-Nachricht"), x + 22, y + 7, DIM_COLOR, width - 44)
    } else {
        canvas_module.drawText(canvas, bodyOf(codemap), message, x + 22, y + 7, TEXT_COLOR, width - 44)
    }
    const caret = x + 22 + canvas_module.measure(bodyOf(codemap), message)
    if caret < x + width - 20 { canvas_module.fillRect(canvas, caret + 1, y + 7, 2, 16, ACCENT) }
    y += 42
    // The buttons.
    codemap.*.commitButtonsY = y
    const commit_label = say(codemap, "Commit", "Commit")
    const push_label = say(codemap, "Commit and push", "Commit und Push")
    const commit_width = canvas_module.measure(bodyOf(codemap), commit_label) + 28
    const push_width = canvas_module.measure(bodyOf(codemap), push_label) + 28
    codemap.*.pushButtonX = x + width - 12 - push_width
    codemap.*.commitButtonX = codemap.*.pushButtonX - 8 - commit_width
    const enabled = message.length > 0 && codemap.*.changeCount > 0
    canvas_module.fillRoundedRect(canvas, codemap.*.commitButtonX, y, commit_width, 30, 8, if codemap.*.hover == HIT_COMMIT_DO && enabled { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    canvas_module.drawText(canvas, bodyOf(codemap), commit_label, codemap.*.commitButtonX + 14, y + 7, if enabled { TEXT_COLOR } else { DIM_COLOR }, 0)
    canvas_module.fillRoundedRect(canvas, codemap.*.pushButtonX, y, push_width, 30, 8, if !enabled { canvas_module.color(255, 52, 56, 68) } else if codemap.*.hover == HIT_COMMIT_PUSH { canvas_module.color(255, 70, 110, 190) } else { canvas_module.color(255, 52, 88, 160) })
    canvas_module.drawText(canvas, bodyOf(codemap), push_label, codemap.*.pushButtonX + 14, y + 7, if enabled { TEXT_COLOR } else { DIM_COLOR }, 0)
    canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Enter: commit", "Enter: Commit"), x + 16, y + 8, DIM_COLOR, codemap.*.commitButtonX - x - 24)
}

// Typing into the commit message (the list open); true when it took the
// key.
fn commitKey(codemap: *Codemap, key: u32) -> bool {
    if key == KEY_ESCAPE {
        codemap.*.popup = POPUP_NONE
        return true
    }
    if key == KEY_ENTER || key == KEY_KP_ENTER {
        startCommit(codemap, modifiers(codemap) & CONTROL != 0)
        return true
    }
    if key == KEY_BACKSPACE {
        if codemap.*.commitLength > 0 { codemap.*.commitLength -= 1 }
        while codemap.*.commitLength > 0 && codemap.*.commitMessage[codemap.*.commitLength] >= 128 && codemap.*.commitMessage[codemap.*.commitLength] < 192 { codemap.*.commitLength -= 1 }
        return true
    }
    const panel = panelOf(codemap)
    if panel.*.textLength == 0 || panel.*.text[0] < 32 || modifiers(codemap) & (CONTROL | ALT) != 0 { return false }
    var at: usize = 0
    while at < panel.*.textLength && codemap.*.commitLength < 500 {
        codemap.*.commitMessage[codemap.*.commitLength] = panel.*.text[at]
        codemap.*.commitLength += 1
        at += 1
    }
    return true
}

fn buildLabel(codemap: *Codemap) -> []const u8 {
    return if buildOf(codemap).*.running { say(codemap, "Building ...", "Baut ...") } else { say(codemap, "Build", "Bauen") }
}

fn buildWidth(codemap: *Codemap) -> i32 { return canvas_module.measure(bodyOf(codemap), buildLabel(codemap)) + 36 }
fn buildX(codemap: *Codemap) -> i32 { return baseX(codemap) - 8 - buildWidth(codemap) }


// The toolbar's Build (a triangle, the program).
fn drawBuild(codemap: *Codemap, canvas: *Canvas, top: i32) -> void {
    const build_x = buildX(codemap)
    const building = buildOf(codemap).*.running
    const lit = codemap.*.hover == HIT_BUILD
    canvas_module.fillRoundedRect(canvas, build_x, top, buildWidth(codemap), BUTTON, 8, if building { canvas_module.color(255, 60, 70, 60) } else if lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    var step: i32 = 0
    while step < 6 {
        canvas_module.fillRect(canvas, build_x + 12 + step, top + 9 + step, 1, 12 - 2 * step, canvasColor(STRING_COLOR, 255))
        step += 1
    }
    canvas_module.drawText(canvas, bodyOf(codemap), buildLabel(codemap), build_x + 24, top + 7, TEXT_COLOR, 0)
}

// ---------------------------------------------------------------------------
// Rewriting workarounds away (tools/codemap/rewrite.mlx)

fn planRewrite(codemap: *Codemap, pattern: u8) -> void {
    if !codemap.*.rewriteReady {
        rewrite_module.init(rewriteEditsOf(codemap), codemap.*.allocator)
        codemap.*.rewriteReady = true
    }
    const edits = rewriteEditsOf(codemap)
    rewrite_module.plan(edits, workaroundsOf(codemap), codemap.*.index, pattern, "")
    codemap.*.rewriteAccepted = edits.*.count > 0 && rewrite_module.compilerAccepts(gitOf(codemap), pattern)
    codemap.*.rewritePattern = pattern
    codemap.*.detailScroll = 0
    if codemap.*.trace {
        var text: [96]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = writeNumberPlain(bytes, 0, edits.*.count)
        length = writeText(bytes, length, " edits, ")
        length = writeText(bytes, length, if codemap.*.rewriteAccepted { "accepted" } else { "not accepted" })
        traceLine(codemap, "rewrite planned: ", bytes[0..length])
    }
}

fn rewriteEditsOf(codemap: *Codemap) -> *rewrite_module.Edits {
    unsafe { return @ptrCast(*rewrite_module.Edits, &codemap.*.rewriteEdits) }
}

// Writes the rewrites and reads the code again.
fn applyRewrite(codemap: *Codemap) -> void {
    if codemap.*.rewritePattern == 255 || !codemap.*.rewriteAccepted { return }
    const edits = rewriteEditsOf(codemap)
    const count = edits.*.count
    const written = rewrite_module.apply(edits, codemap.*.index)
    codemap.*.rewritePattern = 255
    var text: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeNumberPlain(bytes, 0, count)
    length = writeText(bytes, length, say(codemap, " places rewritten in ", " Stellen umgeschrieben in "))
    length = writeNumberPlain(bytes, length, written)
    length = writeText(bytes, length, say(codemap, " files", " Dateien"))
    if codemap.*.trace { traceLine(codemap, "rewritten: ", bytes[0..length]) }
    reload(codemap)
    setNote(codemap, bytes[0..length], "")
}

// The line around bytes start..end of `source` with `instead` in their
// place, from its first non-blank byte on (into `into`).
fn editedLine(source: []const u8, start: usize, end: usize, instead: []const u8, into: [*]u8) -> usize {
    var first = start
    while first > 0 && source[first - 1] != 10 { first -= 1 }
    while first < start && (source[first] == 32 || source[first] == 9) { first += 1 }
    var last = end
    while last < source.length && source[last] != 10 { last += 1 }
    var length = writeText(into, 0, source[first..start])
    if length + instead.length < 900 { length = writeText(into, length, instead) }
    const rest = source[end..last]
    return writeText(into, length, if rest.length > 400 { rest[0..400] } else { rest })
}

// The rewrites of one kind: each line before and after, and whether the
// compiler takes them; Apply writes them.
fn drawRewrite(codemap: *Codemap, canvas: *Canvas) -> void {
    const left = detailX(codemap)
    const height = viewHeight(codemap)
    canvas_module.fillRect(canvas, left, TOOLBAR, DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = DETAIL - 40
    var y = TOOLBAR + 18 - codemap.*.detailScroll
    const bottom = surfaceHeight(codemap) - STATUS
    const pattern = codemap.*.rewritePattern
    const edits = rewriteEditsOf(codemap)
    const index = codemap.*.index
    var text: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = writeText(bytes, 0, say(codemap, "Rewrite: ", "Umschreiben: "))
    length = writeText(bytes, length, workarounds_module.shortTitle(pattern, codemap.*.german))
    y += drawWrapped(codemap, canvas, bytes[0..length], titleOf(codemap), x, y, width - 100, TEXT_COLOR, 2, 22)
    y += 4
    length = writeNumber(codemap, bytes, 0, edits.*.count)
    length = writeText(bytes, length, say(codemap, " places in ", " Stellen in "))
    length = writeNumber(codemap, bytes, length, rewrite_module.fileCount(edits))
    length = writeText(bytes, length, say(codemap, " files. ", " Dateien. "))
    if pattern == workarounds_module.DROPPED { length = writeText(bytes, length, say(codemap, "A constant bound only to drop a result becomes _ = ... ", "Eine Konstante, die nur ein Ergebnis verwirft, wird zu _ = ... ")) }
    if pattern == workarounds_module.COUNTED { length = writeText(bytes, length, say(codemap, "A loop counting a slice's bytes becomes its .length. ", "Eine Schleife, die die Bytes eines Slices zählt, wird zu seiner .length. ")) }
    length = writeText(bytes, length, say(codemap, "compiler/, std/bootstrap/ and tests/ stay as they are.", "compiler/, std/bootstrap/ und tests/ bleiben, wie sie sind."))
    y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, y, width, DIM_COLOR, 6, 17)
    y += 6
    if codemap.*.rewriteAccepted {
        y += drawWrapped(codemap, canvas, say(codemap, "The compiler takes the result: Apply writes the files and reads the code again.", "Der Compiler nimmt das Ergebnis: Anwenden schreibt die Dateien und liest den Code neu ein."), smallOf(codemap), x, y, width, canvasColor(CHANGED_COLOR, 255), 3, 17)
    } else if edits.*.count > 0 {
        y += drawWrapped(codemap, canvas, say(codemap, "The compiler does not take the result yet: nothing can be written.", "Der Compiler nimmt das Ergebnis noch nicht: es kann nichts geschrieben werden."), smallOf(codemap), x, y, width, canvasColor(CRASH_COLOR, 255), 3, 17)
    }
    y += 10
    const apply_width = detailButton(codemap, canvas, say(codemap, "Apply", "Anwenden"), x, y, 0, ROW_APPLY, true, codemap.*.rewriteAccepted)
    const back_width = detailButton(codemap, canvas, say(codemap, "Back", "Zurück"), x + apply_width + 8, y, 0, ROW_BACK, false, true)
    y += DETAIL_ROW + 14
    var edit: usize = 0
    const most: usize = if codemap.*.expanded[0] { edits.*.count } else { 150 }
    while edit < edits.*.count && edit < most {
        const file = edits.*.file[edit]
        const source = index_module.sourceOf(index, file)
        const start = @intCast(usize, edits.*.start[edit])
        const end = @intCast(usize, edits.*.end[edit])
        if y > TOOLBAR - 60 && y < bottom {
            length = writeText(bytes, 0, programs_module.relativePath(index, file))
            length = writeText(bytes, length, ":")
            length = writeNumber(codemap, bytes, length, index_module.lineOf(index, file, start) + 1)
            canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x, y, DIM_COLOR, width)
            length = editedLine(source, start, end, source[start..end], bytes)
            canvas_module.drawText(canvas, smallOf(codemap), "-", x, y + 17, canvasColor(CRASH_COLOR, 255), 0)
            canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 12, y + 17, canvas_module.color(255, 200, 150, 150), width - 12)
            length = editedLine(source, start, end, rewrite_module.replacement(edits, edit), bytes)
            canvas_module.drawText(canvas, smallOf(codemap), "+", x, y + 34, canvasColor(CHANGED_COLOR, 255), 0)
            canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 12, y + 34, canvasColor(CHANGED_COLOR, 255), width - 12)
        }
        y += 58
        edit += 1
    }
    if edit < edits.*.count {
        addDetailRow(codemap, y, 0, ROW_MORE)
        length = writeText(bytes, 0, "+ ")
        length = writeNumber(codemap, bytes, length, edits.*.count - edit)
        length = writeText(bytes, length, say(codemap, " more", " weitere"))
        if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 22, y + 5, ACCENT, 0) }
        y += DETAIL_ROW
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - TOOLBAR + 20
    drawCloseButton(codemap, canvas)
}

// ---------------------------------------------------------------------------
// The workarounds over the last commits, and counting them

// A bar per commit counted (all kinds together), and what is left to
// count (a button starts it; it runs in the background).
fn drawTrend(codemap: *Codemap, canvas: *Canvas, x: i32, top: i32, width: i32, bottom: i32) -> i32 {
    const trend = trendOf(codemap)
    var y = top
    var text: [160]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var known: usize = 0
    var first_total: u32 = 0
    var last_total: u32 = 0
    var commit: usize = 0
    while commit < trend.*.count {
        if trend_module.isKnown(trend, commit) {
            if known == 0 { first_total = trend_module.totalOf(trend, commit) }
            last_total = trend_module.totalOf(trend, commit)
            known += 1
        }
        commit += 1
    }
    if known >= 2 {
        var length = writeText(bytes, 0, say(codemap, "Over the last ", "Über die letzten "))
        length = writeNumber(codemap, bytes, length, known)
        length = writeText(bytes, length, say(codemap, " commits: ", " Commits: "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, first_total))
        length = writeText(bytes, length, " -> ")
        length = writeNumber(codemap, bytes, length, @intCast(usize, last_total))
        if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x, y, TEXT_COLOR, width) }
        y += 20
        const most = trend_module.most(trend, workarounds_module.PATTERNS)
        const least = trend_module.least(trend, workarounds_module.PATTERNS)
        const chart: i32 = 44
        var bar = width / @intCast(i32, known)
        if bar > 18 { bar = 18 }
        if bar < 2 { bar = 2 }
        var left = x
        commit = 0
        while commit < trend.*.count {
            if trend_module.isKnown(trend, commit) {
                const value = trend_module.totalOf(trend, commit)
                var high: i32 = chart / 2
                if most > least { high = 4 + @intCast(i32, (value - least) * @intCast(u32, chart - 4) / (most - least)) }
                if y > TOOLBAR && y + chart < bottom { canvas_module.fillRect(canvas, left, y + chart - high, bar - (if bar > 3 { 1 } else { 0 }), high, canvasColor(WORKAROUND_COLOR, 210)) }
                left += bar
            }
            commit += 1
        }
        y += chart + 10
    }
    const missing = trend_module.missing(trend)
    if codemap.*.historyJob > 0 {
        if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Counting the commits in the background ...", "Die Commits werden im Hintergrund gezählt ..."), x, y + 4, DIM_COLOR, width) }
        y += DETAIL_ROW + 6
    } else if missing > 0 && trend.*.count > 1 {
        var length = writeText(bytes, 0, say(codemap, "Count the history (", "Verlauf zählen ("))
        length = writeNumber(codemap, bytes, length, missing)
        length = writeText(bytes, length, say(codemap, " commits)", " Commits)"))
        const button = detailButton(codemap, canvas, bytes[0..length], x, y, 0, ROW_HISTORY, false, true)
        y += DETAIL_ROW + 10
    }
    return y
}

// Counts the workarounds of the commits not counted yet: this program's
// command line (mlx-codemap -C ROOT history 20) in the background.
fn countHistory(codemap: *Codemap) -> void {
    if codemap.*.historyJob > 0 { return }
    const trend = trendOf(codemap)
    if trend.*.selfLength == 0 { return }
    const git = gitOf(codemap)
    git_module.beginShell(git)
    git_module.more(git, "exec ")
    git_module.addQuoted(git, trend.*.self[0..trend.*.selfLength])
    git_module.more(git, " -C ")
    git_module.addQuoted(git, rootText(codemap))
    git_module.more(git, " history 20")
    codemap.*.historyJob = git_module.spawn(git)
    if codemap.*.trace { traceLine(codemap, "counting the history", "") }
}

// ---------------------------------------------------------------------------
// Profiling the program shown (mlx-profile, tools/profile)

fn drawProfileBlock(codemap: *Codemap, canvas: *Canvas, x: i32, top: i32, width: i32) -> i32 {
    var y = top
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const programs = programsOf(codemap)
    const binaries = binariesOf(codemap)
    if codemap.*.profileJob > 0 {
        y += drawWrapped(codemap, canvas, say(codemap, "The program runs under mlx-profile: ending it writes its profile, read here then.", "Das Programm läuft unter mlx-profile: wird es beendet, schreibt es sein Profil, das dann hier gelesen wird."), smallOf(codemap), x, y, width, canvasColor(HOT_COLOR, 255), 3, 17)
        return y + 10
    }
    if !programChosen(codemap) || binaries_module.binaryOf(binaries, codemap.*.program) >= binaries.*.count {
        y += drawWrapped(codemap, canvas, say(codemap, "Choose a built program under Program to run it under mlx-profile.", "Wähle unter Programm ein gebautes Programm, um es unter mlx-profile laufen zu lassen."), smallOf(codemap), x, y, width, DIM_COLOR, 3, 17)
        return y + 10
    }
    var length = writeText(bytes, 0, say(codemap, "Profile ", "Profilieren: "))
    length = writeText(bytes, length, programs_module.nameOf(programs, codemap.*.program))
    const button = detailButton(codemap, canvas, bytes[0..length], x, y, 0, ROW_PROFILE, true, true)
    return y + DETAIL_ROW + 12
}

// Runs the program shown under mlx-profile (next to this program, else on
// the PATH) in the background.
fn startProfile(codemap: *Codemap) -> void {
    if codemap.*.profileJob > 0 || !programChosen(codemap) { return }
    const binaries = binariesOf(codemap)
    const binary = binaries_module.binaryOf(binaries, codemap.*.program)
    if binary >= binaries.*.count { return }
    const trend = trendOf(codemap)
    const git = gitOf(codemap)
    git_module.beginShell(git)
    git_module.more(git, "p=\"$(dirname ")
    git_module.addQuoted(git, trend.*.self[0..trend.*.selfLength])
    git_module.more(git, ")/mlx-profile\"; [ -x \"$p\" ] || p=mlx-profile; exec \"$p\" ")
    git_module.addQuoted(git, binaries_module.pathOf(binaries, binary))
    codemap.*.profileJob = git_module.spawn(git)
    if codemap.*.trace { traceLine(codemap, "profiling ", binaries_module.pathOf(binaries, binary)) }
}

// ---------------------------------------------------------------------------
// The demo: MLX_CODEMAP_DEMO names a script the app plays, a step a line
// ("#" starts a comment), and writes its own frames as pictures (PPM) into
// MLX_CODEMAP_DEMO_OUT. tools/observatory_screenshots.sh makes the README's
// pictures with it.
//
//   wait MS                 go on after MS milliseconds
//   settle                  wait until the camera stands and the history
//                           is read
//   shot NAME               the next frame, as NAME.ppm
//   record NAME N MS        N frames, one each MS: NAME-000.ppm ...
//   spin MILLIRADIANS       turn the view that much a second (0: stop)
//   search TEXT             TEXT into the search (a name or a query)
//   enter, escape           the keys
//   select PATH             select PATH under the root and fly there
//                           (examples/mlx-observatory/main.mlx/drawSidebar)
//   finding NAME            open a finding (copies names unused workarounds
//                           crashes unreachable untested complex structure
//                           risky hot changed; none: close)
//   check NAME on|off       a finding's check box
//   metric NAME             color by kind size churn complexity risk heat
//   program NAME|all        the program shown
//   programs open|close     the list of programs
//   workarounds open|close  the kinds of workarounds
//   popup base|filter|none  a toolbar list
//   base REV                the base of Changed
//   rewrite PATTERN         the rewrite of dropped or counted (back: close)
//   fold NAME, unfold NAME  a sidebar section (groups program findings
//                           color show kinds views)
//   only PATHS, all         the groups shown
//   scroll N, detail N      the sidebar's, the panel's scroll
//   view map|editor         what the middle shows
//   open PATH [LINE]        a file (relative to the root) in the editor
//   cursor LINE COLUMN      the editor's cursor (select-to: the selection)
//   edit TEXT               typed at the cursor (\n: Enter)
//   undo, save, definition  Ctrl+Z, Ctrl+S, F12
//   hoverat LINE COLUMN     the pointer over that character
//   chip NAME               the first lens chip of a kind (uses crashes
//                           workarounds open rewrite) drawn, clicked
//   references, choose      Shift+F12; Enter in the references list
//   complete, accept        the completion list at the cursor; Enter in it
//   signature               the signature help of the call at the cursor
//   delete-selection        what is selected taken out
//   rename NAME             F2 on the name at the cursor, NAME, Enter
//   blameat LINE            who wrote the line (the line number's hover)
//   build                   Build (the program of the file shown, else
//                           the one chosen)
//   popup commit, message TEXT, commit, commit-push
//                           the commit list, its message, its buttons
//   quit                    end

fn startDemo(codemap: *Codemap) -> void {
    codemap.*.demoActive = false
    const path = apps_module.environmentValue(codemap.*.environment, "MLX_CODEMAP_DEMO")
    if @intFromPtr(path) == 0 || path[0] == 0 { return }
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return }
    codemap.*.demoText = codemap.*.allocator.alloc(65536, 16).?
    codemap.*.demoLength = 0
    while codemap.*.demoLength + 4096 <= 65536 {
        var chunk: [*]u8 = undefined
        unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(codemap.*.demoText) + codemap.*.demoLength) }
        const got = std.fs.read(file, chunk, 4096)
        if got <= 0 { break }
        codemap.*.demoLength += @intCast(usize, got)
    }
    const closed = std.fs.close(file)
    const out = apps_module.environmentValue(codemap.*.environment, "MLX_CODEMAP_DEMO_OUT")
    codemap.*.demoOutLength = if @intFromPtr(out) != 0 { copyOption(fieldBytes(codemap, @offsetOf(Codemap, "demoOut")), 0, cString(out), 1000) } else { copyOption(fieldBytes(codemap, @offsetOf(Codemap, "demoOut")), 0, ".", 1000) }
    codemap.*.demoAt = 0
    codemap.*.demoUntil = 0
    codemap.*.demoSettle = false
    codemap.*.demoShotLength = 0
    codemap.*.demoRecord = 0
    codemap.*.demoSpin = 0.0
    codemap.*.demoClock = panel_module.milliseconds()
    codemap.*.demoSpinAt = codemap.*.demoClock
    codemap.*.demoActive = true
}

fn demoNumber(text: []const u8) -> usize {
    var value: usize = 0
    for byte in text {
        if byte >= 48 && byte <= 57 { value = value * 10 + @intCast(usize, byte - 48) }
    }
    return value
}

fn findingNamed(word: []const u8) -> u8 {
    const names = [12][]const u8{ "copies", "names", "unused", "workarounds", "crashes", "unreachable", "untested", "complex", "structure", "risky", "hot", "changed" }
    var at: usize = 0
    while at < 12 {
        if sameBytes(names[at], word) { return @intCast(u8, at) }
        at += 1
    }
    return FINDING_NONE
}

fn sectionNamed(word: []const u8) -> usize {
    const names = [7][]const u8{ "groups", "program", "findings", "color", "show", "kinds", "views" }
    var at: usize = 0
    while at < 7 {
        if sameBytes(names[at], word) { return at }
        at += 1
    }
    return SECTIONS
}

fn metricNamed(word: []const u8) -> u8 {
    const names = [6][]const u8{ "kind", "size", "churn", "complexity", "risk", "heat" }
    var at: usize = 0
    while at < 6 {
        if sameBytes(names[at], word) { return @intCast(u8, at) }
        at += 1
    }
    return 255
}

// Plays the demo on: steps until one has to wait.
fn runDemo(codemap: *Codemap) -> void {
    if !codemap.*.demoActive || !codemap.*.built { return }
    const panel = panelOf(codemap)
    const now = panel_module.milliseconds()
    // The demo's clock goes with the real one, but for recording (then
    // each frame moves it on).
    const elapsed = if now > codemap.*.demoSpinAt { now - codemap.*.demoSpinAt } else { 0 }
    codemap.*.demoSpinAt = now
    if codemap.*.demoRecord == 0 {
        codemap.*.demoClock += elapsed
        turnDemo(codemap, elapsed)
    }
    // A picture asked for: once a frame after the ask is shown.
    if codemap.*.demoShotLength > 0 {
        // (A flight keeps the panel dirty: a frame drawn after the ask is
        // enough.)
        if panel.*.shownFrames < codemap.*.demoShotFrame {
            panel.*.dirty = true
            return
        }
        writeDemoShot(codemap)
        codemap.*.demoShotLength = 0
    }
    if codemap.*.demoRecord > 0 {
        takeRecordFrame(codemap)
        return
    }
    if now < codemap.*.demoUntil { return }
    if codemap.*.demoSettle {
        if codemap.*.flying || !history_module.finished(historyOf(codemap)) || codemap.*.historyJob > 0 || checkOf(codemap).*.running || buildOf(codemap).*.running || codemap.*.job != JOB_NONE { return }
        codemap.*.demoSettle = false
    }
    const text = codemap.*.demoText[0..codemap.*.demoLength]
    while codemap.*.demoAt < text.length {
        var end = codemap.*.demoAt
        while end < text.length && text[end] != 10 { end += 1 }
        const start = codemap.*.demoAt
        codemap.*.demoAt = end + 1
        var word_end = start
        while word_end < end && text[word_end] != 32 { word_end += 1 }
        const word = text[start..word_end]
        const rest = if word_end < end { text[word_end + 1..end] } else { text[end..end] }
        if word.length == 0 || word[0] == 35 { continue }
        if codemap.*.trace { traceLine(codemap, "demo ", text[start..end]) }
        panel.*.dirty = true
        if demoStep(codemap, word, rest) { return }
    }
    codemap.*.demoActive = false
}

// One step; true when it has to wait.
fn demoStep(codemap: *Codemap, word: []const u8, rest: []const u8) -> bool {
    const panel = panelOf(codemap)
    const now = panel_module.milliseconds()
    if sameBytes(word, "wait") {
        codemap.*.demoUntil = now + demoNumber(rest)
        return true
    }
    if sameBytes(word, "settle") {
        codemap.*.demoSettle = true
        codemap.*.demoUntil = now + 100
        return true
    }
    if sameBytes(word, "shot") {
        codemap.*.demoShotLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "demoShot")), 0, rest, 120)
        codemap.*.demoShotFrame = panel.*.shownFrames + 1
        return true
    }
    if sameBytes(word, "record") {
        // NAME N MS
        var name_end: usize = 0
        while name_end < rest.length && rest[name_end] != 32 { name_end += 1 }
        codemap.*.demoShotLength = 0
        const name_length = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "demoShot")), 0, rest[0..name_end], 100)
        var count_end = name_end + 1
        while count_end < rest.length && rest[count_end] != 32 { count_end += 1 }
        codemap.*.demoRecord = if name_end + 1 < rest.length { demoNumber(rest[name_end + 1..(if count_end < rest.length { count_end } else { rest.length })]) } else { 0 }
        codemap.*.demoRecordEvery = if count_end < rest.length { demoNumber(rest[count_end..rest.length]) } else { 100 }
        codemap.*.demoRecordIndex = 0
        codemap.*.demoShotFrame = panel.*.shownFrames + 1
        codemap.*.demoShot[name_length] = 0
        codemap.*.demoUntil = now
        return codemap.*.demoRecord > 0
    }
    if sameBytes(word, "spin") {
        codemap.*.demoSpin = m.toFloat(@intCast(i64, demoNumber(rest))) / 1000.0
        if rest.length > 0 && rest[0] == 45 { codemap.*.demoSpin = -codemap.*.demoSpin }
        codemap.*.demoSpinAt = now
        return false
    }
    if sameBytes(word, "search") {
        setSearch(codemap, rest)
        codemap.*.searchFocused = true
        return false
    }
    if sameBytes(word, "enter") {
        searchKey(codemap, KEY_ENTER)
        return false
    }
    if sameBytes(word, "escape") {
        onKey(codemap, KEY_ESCAPE)
        return false
    }
    if sameBytes(word, "select") {
        var key: [1100]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &key) }
        var length = writeText(bytes, 0, nameOf(codemap, graphOf(codemap).*.root))
        length = writeText(bytes, length, "/")
        if rest.length < 1000 { length = writeText(bytes, length, rest) }
        if length > 0 && bytes[length - 1] != 47 { length = writeText(bytes, length, "/") }
        const node = findKey(codemap, bytes[0..length])
        if node != NONE { goTo(codemap, node) } else if codemap.*.trace { traceLine(codemap, "demo: no node ", bytes[0..length]) }
        return false
    }
    if sameBytes(word, "finding") {
        const finding = findingNamed(rest)
        select(codemap, NONE)
        if finding != FINDING_NONE { codemap.*.findingOn[@intCast(usize, finding)] = true }
        openFinding(codemap, finding)
        codemap.*.detailScroll = 0
        return false
    }
    if sameBytes(word, "check") {
        var name_end: usize = 0
        while name_end < rest.length && rest[name_end] != 32 { name_end += 1 }
        const finding = findingNamed(rest[0..name_end])
        if finding != FINDING_NONE {
            codemap.*.findingOn[@intCast(usize, finding)] = name_end + 1 < rest.length && sameBytes(rest[name_end + 1..rest.length], "on")
            refreshFindings(codemap)
        }
        return false
    }
    if sameBytes(word, "metric") {
        const metric = metricNamed(rest)
        if metric != 255 {
            codemap.*.metric = metric
            computeMetric(codemap)
        }
        return false
    }
    if sameBytes(word, "program") {
        const programs = programsOf(codemap)
        var chosen = programs.*.count
        var program: usize = 0
        while program < programs.*.count {
            if sameBytes(programs_module.nameOf(programs, program), rest) { chosen = program }
            program += 1
        }
        chooseProgram(codemap, chosen)
        return false
    }
    if sameBytes(word, "programs") {
        codemap.*.programsOpen = sameBytes(rest, "open")
        return false
    }
    if sameBytes(word, "workarounds") {
        codemap.*.workaroundsOpen = sameBytes(rest, "open")
        return false
    }
    if sameBytes(word, "popup") {
        codemap.*.popup = POPUP_NONE
        if sameBytes(rest, "base") { openPopup(codemap, POPUP_BASE) }
        if sameBytes(rest, "filter") { openPopup(codemap, POPUP_FILTER) }
        if sameBytes(rest, "commit") { openPopup(codemap, POPUP_BASE) }
        return false
    }
    if sameBytes(word, "build") {
        startBuild(codemap)
        return false
    }
    if sameBytes(word, "message") {
        codemap.*.commitLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "commitMessage")), 0, rest, 500)
        return false
    }
    if sameBytes(word, "commit") || sameBytes(word, "commit-push") {
        startCommit(codemap, sameBytes(word, "commit-push"))
        return false
    }
    if sameBytes(word, "base") {
        codemap.*.popup = POPUP_NONE
        chooseBase(codemap, rest)
        return false
    }
    if sameBytes(word, "rewrite") {
        const pattern = rewrite_module.patternNamed(rest)
        if pattern != 255 { planRewrite(codemap, pattern) }
        return false
    }
    if sameBytes(word, "back") {
        codemap.*.rewritePattern = 255
        return false
    }
    if sameBytes(word, "fold") || sameBytes(word, "unfold") {
        const section = sectionNamed(rest)
        if section < SECTIONS { codemap.*.sectionFolded[section] = sameBytes(word, "fold") }
        return false
    }
    if sameBytes(word, "only") {
        var node: usize = 0
        while node < graphOf(codemap).*.count {
            codemap.*.off[node] = 0
            node += 1
        }
        markOnly(codemap, rest)
        refreshVisibility(codemap)
        flyToShown(codemap)
        return false
    }
    if sameBytes(word, "all") {
        var node: usize = 0
        while node < graphOf(codemap).*.count {
            codemap.*.off[node] = 0
            node += 1
        }
        refreshVisibility(codemap)
        return false
    }
    if sameBytes(word, "scroll") {
        codemap.*.sidebarScroll = @intCast(i32, demoNumber(rest))
        return false
    }
    if sameBytes(word, "detail") {
        codemap.*.detailScroll = @intCast(i32, demoNumber(rest))
        return false
    }
    if sameBytes(word, "chip") {
        // uses, crashes, workarounds, open or rewrite: the first such chip
        // drawn.
        const kind = if sameBytes(rest, "uses") { CHIP_USES } else if sameBytes(rest, "crashes") { CHIP_CRASHES } else if sameBytes(rest, "workarounds") { CHIP_WORKAROUNDS } else if sameBytes(rest, "open") { CHIP_OPEN } else { CHIP_REWRITE }
        var chip: usize = 0
        while chip < codemap.*.chipCount {
            if codemap.*.chipKind[chip] == kind {
                pressChip(codemap, chip)
                return false
            }
            chip += 1
        }
        if codemap.*.trace { traceLine(codemap, "no chip ", rest) }
        return false
    }
    if sameBytes(word, "choose") {
        openRef(codemap, codemap.*.refsSelected)
        return false
    }
    if sameBytes(word, "references") && hasTab(codemap) {
        openRefs(codemap, symbolAtCursor(codemap, activeEditor(codemap).*.cursor), codemap.*.editorLeft, editorCodeTop() + 40)
        return false
    }
    if sameBytes(word, "view") {
        setView(codemap, if sameBytes(rest, "editor") { VIEW_EDITOR } else { VIEW_MAP })
        return false
    }
    if sameBytes(word, "open") {
        // RELATIVE-PATH [LINE]
        var path_end: usize = 0
        while path_end < rest.length && rest[path_end] != 32 { path_end += 1 }
        var path: [1100]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &path) }
        var length = writeText(bytes, 0, rootText(codemap))
        length = writeText(bytes, length, "/")
        if path_end < 1000 { length = writeText(bytes, length, rest[0..path_end]) }
        const line = if path_end < rest.length { demoNumber(rest[path_end..rest.length]) } else { 1 }
        const opened = openFile(codemap, bytes[0..length], line, 1)
        followCursor(codemap)
        return false
    }
    if sameBytes(word, "cursor") && hasTab(codemap) {
        // LINE COLUMN (from 1)
        var split: usize = 0
        while split < rest.length && rest[split] != 32 { split += 1 }
        const line = demoNumber(rest[0..split])
        const column = if split < rest.length { demoNumber(rest[split..rest.length]) } else { 1 }
        const editor = activeEditor(codemap)
        editor_module.moveTo(editor, editor_module.offsetAt(editor, if line > 0 { line - 1 } else { 0 }, if column > 0 { column - 1 } else { 0 }), false)
        keepCursorSeen(codemap)
        followCursor(codemap)
        return false
    }
    if sameBytes(word, "select-to") && hasTab(codemap) {
        var split: usize = 0
        while split < rest.length && rest[split] != 32 { split += 1 }
        const editor = activeEditor(codemap)
        const line = demoNumber(rest[0..split])
        const column = if split < rest.length { demoNumber(rest[split..rest.length]) } else { 1 }
        editor_module.moveTo(editor, editor_module.offsetAt(editor, if line > 0 { line - 1 } else { 0 }, if column > 0 { column - 1 } else { 0 }), true)
        return false
    }
    if sameBytes(word, "edit") && hasTab(codemap) {
        const editor = activeEditor(codemap)
        const tab = codemap.*.activeTab
        const line_before = editor_module.lineOf(editor, editor_module.selectionStart(editor))
        const lines_before = editor.*.lineCount
        // "\n" in the text: a new line (with the indentation).
        var at: usize = 0
        var start: usize = 0
        while at <= rest.length {
            if at == rest.length || (at + 1 < rest.length && rest[at] == 92 && rest[at + 1] == 110) {
                if at > start { editor_module.insert(editor, rest[start..at]) }
                if at < rest.length { editor_module.newline(editor) }
                start = at + 2
                at += 2
            } else {
                at += 1
            }
        }
        shiftMarks(codemap, tab, line_before, lines_before)
        keepCursorSeen(codemap)
        return false
    }
    if sameBytes(word, "rename") {
        startRename(codemap)
        if codemap.*.renameOpen {
            codemap.*.renameOpen = false
            applyRename(codemap, rest)
        }
        return false
    }
    if sameBytes(word, "blameat") && hasTab(codemap) {
        const text = blameLine(codemap, codemap.*.activeTab, demoNumber(rest) - 1)
        if codemap.*.trace { traceLine(codemap, "blame ", text) }
        return false
    }
    if sameBytes(word, "complete") {
        updateCompletion(codemap)
        return false
    }
    if sameBytes(word, "accept") {
        acceptCompletion(codemap)
        return false
    }
    if sameBytes(word, "signature") && hasTab(codemap) && codemap.*.tabFile[codemap.*.activeTab] != NONE {
        codemap.*.signatureActive = true
        const editor = activeEditor(codemap)
        var argument: usize = 0
        const function = features.callAt(codemap.*.index, codemap.*.tabFile[codemap.*.activeTab], editor.*.text[0..editor.*.length], editor.*.cursor, offsetInIndex(codemap, codemap.*.activeTab), &argument)
        if codemap.*.trace && function != NONE {
            var text: [32]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &text) }
            var length = writeText(bytes, 0, ", argument ")
            length = writeNumberPlain(bytes, length, argument)
            traceLine(codemap, "signature ", index_module.nameOf(codemap.*.index, function))
            traceLine(codemap, "signature at", bytes[0..length])
        }
        return false
    }
    if sameBytes(word, "delete-selection") && hasTab(codemap) {
        const editor = activeEditor(codemap)
        const line_before = editor_module.lineOf(editor, editor_module.selectionStart(editor))
        const lines_before = editor.*.lineCount
        editor_module.deleteSelection(editor)
        shiftMarks(codemap, codemap.*.activeTab, line_before, lines_before)
        return false
    }
    if sameBytes(word, "undo") && hasTab(codemap) {
        editor_module.undo(activeEditor(codemap))
        return false
    }
    if sameBytes(word, "save") {
        saveTab(codemap)
        return false
    }
    if sameBytes(word, "definition") && hasTab(codemap) {
        goToDefinition(codemap, activeEditor(codemap).*.cursor)
        return false
    }
    if sameBytes(word, "hoverat") && hasTab(codemap) {
        // LINE COLUMN: the pointer over that character.
        var split: usize = 0
        while split < rest.length && rest[split] != 32 { split += 1 }
        const line = demoNumber(rest[0..split])
        const column = if split < rest.length { demoNumber(rest[split..rest.length]) } else { 1 }
        const editor = activeEditor(codemap)
        codemap.*.pointerX = codemap.*.editorLeft + @intCast(i32, if column > 0 { column - 1 } else { 0 }) * codemap.*.charWidth + 2
        codemap.*.pointerY = lineY(codemap, codemap.*.activeTab, if line > 0 { line - 1 } else { 0 }) + 4
        const moved = motion(codemap, codemap.*.pointerX, codemap.*.pointerY)
        // What the hover says of it: where it belongs, its type.
        const symbol = if codemap.*.editorHover != 18446744073709551615 { symbolAtCursor(codemap, codemap.*.editorHover) } else { NONE }
        if codemap.*.trace && symbol != NONE {
            const lines = hoverTextOf(codemap)
            protocol.clear(lines)
            features.place(lines, codemap.*.index, symbol)
            protocol.text(lines, " | ")
            const typed = features.typePlace(lines, codemap.*.index, symbol)
            traceLine(codemap, "hover ", protocol.contents(lines))
        }
        return false
    }
    if sameBytes(word, "quit") {
        panel.*.running = false
        return true
    }
    return false
}

// Turns the view by the spin asked for, over `elapsed` milliseconds.
fn turnDemo(codemap: *Codemap, elapsed: usize) -> void {
    if codemap.*.demoSpin == 0.0 || codemap.*.flying || elapsed == 0 { return }
    const camera = cameraOf(codemap)
    camera.*.yaw = camera.*.yaw + codemap.*.demoSpin * m.toFloat(@intCast(i64, elapsed)) / 1000.0
    panelOf(codemap).*.dirty = true
}

fn takeRecordFrame(codemap: *Codemap) -> void {
    const panel = panelOf(codemap)
    // The frame of this moment: drawn first.
    if panel.*.shownFrames < codemap.*.demoShotFrame {
        panel.*.dirty = true
        return
    }
    var name: [140]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &name) }
    var base_length: usize = 0
    while codemap.*.demoShot[base_length] != 0 && base_length < 100 { base_length += 1 }
    var length = writeText(bytes, 0, fieldBytes(codemap, @offsetOf(Codemap, "demoShot"))[0..base_length])
    length = writeText(bytes, length, "-")
    const index = codemap.*.demoRecordIndex
    bytes[length] = @intCast(u8, 48 + index / 100 % 10)
    bytes[length + 1] = @intCast(u8, 48 + index / 10 % 10)
    bytes[length + 2] = @intCast(u8, 48 + index % 10)
    length += 3
    codemap.*.demoShotLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "demoShot")), 0, bytes[0..length], 120)
    writeDemoShot(codemap)
    // The base name back (the next frame's).
    const kept = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "demoShot")), 0, bytes[0..base_length], 100)
    codemap.*.demoShot[kept] = 0
    codemap.*.demoShotLength = 0
    codemap.*.demoRecordIndex += 1
    codemap.*.demoRecord -= 1
    // The next frame: the flight and the turn an interval on.
    codemap.*.demoClock += codemap.*.demoRecordEvery
    turnDemo(codemap, codemap.*.demoRecordEvery)
    codemap.*.demoUntil = 0
    codemap.*.demoShotFrame = panel.*.shownFrames + 1
    panel.*.dirty = true
}

// The frame shown last, as OUT/NAME.ppm.
fn writeDemoShot(codemap: *Codemap) -> void {
    const panel = panelOf(codemap)
    const address = panel_module.shownPixels(panel)
    if address == 0 { return }
    var path: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var length = writeText(bytes, 0, fieldBytes(codemap, @offsetOf(Codemap, "demoOut"))[0..codemap.*.demoOutLength])
    length = writeText(bytes, length, "/")
    length = writeText(bytes, length, fieldBytes(codemap, @offsetOf(Codemap, "demoShot"))[0..codemap.*.demoShotLength])
    length = writeText(bytes, length, ".ppm")
    bytes[length] = 0
    const file = std.fs.open(bytes, 577, 420)
    if !std.fs.isValid(file) { return }
    const width = panel.*.width
    const height = panel.*.height
    var header: [64]u8 = undefined
    var header_bytes: [*]u8 = undefined
    unsafe { header_bytes = @ptrCast([*]u8, &header) }
    var header_length = writeText(header_bytes, 0, "P6\n")
    header_length = writeNumberPlain(header_bytes, header_length, width)
    header_length = writeText(header_bytes, header_length, " ")
    header_length = writeNumberPlain(header_bytes, header_length, height)
    header_length = writeText(header_bytes, header_length, "\n255\n")
    var ok = std.fs.writeAllBytes(file, header_bytes, header_length)
    const row = codemap.*.allocator.alloc(width * 3 + 16, 16).?
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrFromInt([*]u32, address) }
    var y: usize = 0
    while y < height && ok {
        var x: usize = 0
        while x < width {
            const pixel = pixels[y * width + x]
            row[x * 3] = @intCast(u8, (pixel >> 16) & 255)
            row[x * 3 + 1] = @intCast(u8, (pixel >> 8) & 255)
            row[x * 3 + 2] = @intCast(u8, pixel & 255)
            x += 1
        }
        ok = std.fs.writeAllBytes(file, row, width * 3)
        y += 1
    }
    codemap.*.allocator.free(row, width * 3 + 16, 16)
    const closed = std.fs.close(file)
    if codemap.*.trace { traceLine(codemap, "demo shot ", bytes[0..length]) }
}

// The work in the background, looked after each tick.
fn watchJobs(codemap: *Codemap) -> void {
    if codemap.*.job != JOB_NONE && git_module.exited(codemap.*.jobProcess) { finishJob(codemap) }
    if codemap.*.historyJob > 0 && git_module.exited(codemap.*.historyJob) {
        codemap.*.historyJob = 0
        loadTrend(codemap)
        panelOf(codemap).*.dirty = true
    }
    if codemap.*.profileJob > 0 && git_module.exited(codemap.*.profileJob) {
        codemap.*.profileJob = 0
        // The profiles are read again at once.
        codemap.*.profilesTime = -2
        codemap.*.crashCheckAt = 0
        panelOf(codemap).*.dirty = true
    }
}

// What a finding measured of `symbol`, for the right of its row.
fn writeMeasure(codemap: *Codemap, out: [*]u8, finding: u8, symbol: u32) -> usize {
    if finding == FINDING_UNREACHABLE || finding == FINDING_UNTESTED {
        const length = writeNumber(codemap, out, 0, @intCast(usize, complexity_module.tokensOf(complexityOf(codemap), symbol)))
        return writeText(out, length, " Tokens")
    }
    if finding == FINDING_COMPLEX {
        var length = writeNumber(codemap, out, 0, @intCast(usize, complexity_module.branchesOf(complexityOf(codemap), symbol)))
        length = writeText(out, length, say(codemap, " branches, ", " Zweige, "))
        length = writeNumber(codemap, out, length, @intCast(usize, complexity_module.depthOf(complexityOf(codemap), symbol)))
        return writeText(out, length, say(codemap, " deep", " tief"))
    }
    if finding == FINDING_RISKY {
        const length = writeText(out, 0, say(codemap, "risk ", "Risiko "))
        return writeNumber(codemap, out, length, @intCast(usize, measures_module.risk(measuresOf(codemap), symbol)))
    }
    if finding == FINDING_CHANGED {
        return writeText(out, 0, if diff_module.stateOf(diffOf(codemap), symbol) == diff_module.ADDED { say(codemap, "new", "neu") } else { say(codemap, "changed", "geändert") })
    }
    if finding == FINDING_HOT {
        const profiles = profilesOf(codemap)
        const all = if profiles.*.allSamples > 0 { profiles.*.allSamples } else { 1 }
        var length = writeNumber(codemap, out, 0, @intCast(usize, @intCast(u64, profiles_module.totalOf(profiles, symbol)) * 100 / all))
        length = writeText(out, length, say(codemap, "% with calls, ", "% mit Aufrufen, "))
        length = writeNumber(codemap, out, length, @intCast(usize, @intCast(u64, profiles_module.selfOf(profiles, symbol)) * 100 / all))
        return writeText(out, length, say(codemap, "% itself", "% selbst"))
    }
    return 0
}

fn drawKeptFindings(codemap: *Codemap, canvas: *Canvas) -> void {
    const left = detailX(codemap)
    const height = viewHeight(codemap)
    canvas_module.fillRect(canvas, left, TOOLBAR, DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = DETAIL - 40
    var y = TOOLBAR + 18 - codemap.*.detailScroll
    const german = codemap.*.german
    const bottom = surfaceHeight(codemap) - STATUS
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    if codemap.*.finding == FINDING_WORKAROUNDS {
        const workarounds = workaroundsOf(codemap)
        y += drawWrapped(codemap, canvas, "Workarounds", titleOf(codemap), x, y, width - 100, TEXT_COLOR, 1, 22)
        y += 4
        y += drawWrapped(codemap, canvas, say(codemap, "Where the code works around what the language or its compiler does not do yet, by what is missing: every place is one more reason to add it. The most written first.", "Wo der Code umgeht, was Sprache oder Compiler noch nicht können, nach dem, was fehlt: jede Stelle ist ein Grund mehr, es einzubauen. Das am meisten Geschriebene zuerst."), smallOf(codemap), x, y, width, DIM_COLOR, 6, 17)
        y += 8
        y = drawTrend(codemap, canvas, x, y, width, bottom)
        var at: usize = 0
        while at < codemap.*.findingCount {
            const pattern = @intCast(u8, codemap.*.findingOrder[at])
            var length = writeNumber(codemap, bytes, 0, codemap.*.patternPlaces[@intCast(usize, pattern)])
            length = writeText(bytes, length, "x ")
            length = writeText(bytes, length, workarounds_module.title(pattern, german))
            y += 8
            y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, y, width, canvasColor(WORKAROUND_COLOR, 255), 2, 17)
            y += drawWrapped(codemap, canvas, workarounds_module.missing(pattern, german), smallOf(codemap), x, y, width, DIM_COLOR, 3, 17)
            y += 4
            if rewrite_module.rewritable(pattern) {
                y += 4
                const button = detailButton(codemap, canvas, say(codemap, "Rewrite ...", "Umschreiben ..."), x, y, @intCast(u32, pattern), ROW_REWRITE, false, true)
                y += DETAIL_ROW + 8
            }
            const count = workarounds_module.declarations(workarounds, pattern, codemap.*.keptSymbols, codemap.*.keptCounts, KEPT_ROWS)
            const section = at + 1
            const most: usize = if codemap.*.expanded[section] { 400 } else { SECTION_ROWS }
            var shown: usize = 0
            var entry: usize = 0
            while entry < count && shown < most {
                const node = nodeOfSymbol(codemap, codemap.*.keptSymbols[entry])
                if node != NONE && !isHidden(codemap, node) {
                    drawRow(codemap, canvas, node, codemap.*.keptCounts[entry], false, x + 6, y, width - 6, WORKAROUND_COLOR)
                    y += DETAIL_ROW
                    shown += 1
                }
                entry += 1
            }
            if count > shown && !codemap.*.expanded[section] {
                addDetailRow(codemap, y, @intCast(u32, section), ROW_MORE)
                var more_length = writeText(bytes, 0, "+ ")
                more_length = writeNumber(codemap, bytes, more_length, count - shown)
                more_length = writeText(bytes, more_length, say(codemap, " more", " weitere"))
                if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..more_length], x + 22, y + 5, ACCENT, 0) }
                y += DETAIL_ROW
            }
            at += 1
        }
    } else {
        const crashes = crashesOf(codemap)
        y += drawWrapped(codemap, canvas, say(codemap, "Crashes", "Abstürze"), titleOf(codemap), x, y, width - 100, TEXT_COLOR, 1, 22)
        y += 4
        var path: [4096]u8 = undefined
        var path_bytes: [*]u8 = undefined
        unsafe { path_bytes = @ptrCast([*]u8, &path) }
        const path_length = crashLogPath(codemap, path_bytes)
        var length = writeText(bytes, 0, say(codemap, "What the desktop programs kept when they crashed, newest first: where each stopped and the functions that called it. Their nodes carry a red flag. From ", "Was die Desktop-Programme bei einem Absturz festgehalten haben, das Neueste zuerst: wo jeder stehen blieb und die Funktionen, die dorthin riefen. Ihre Knoten tragen eine rote Fahne. Aus "))
        // Under the home: ~/...
        const home = apps_module.environmentValue(codemap.*.environment, "HOME")
        var skip: usize = 0
        if @intFromPtr(home) != 0 {
            const home_text = cString(home)
            if home_text.length > 1 && path_length > home_text.length && sameBytes(path_bytes[0..home_text.length], home_text) && path_bytes[home_text.length] == 47 {
                length = writeText(bytes, length, "~")
                skip = home_text.length
            }
        }
        const shown_end = if path_length - skip > 200 { skip + 200 } else { path_length }
        length = writeText(bytes, length, path_bytes[skip..shown_end])
        y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, y, width, DIM_COLOR, 8, 17)
        y += 8
        if crashes.*.count == 0 {
            y += drawWrapped(codemap, canvas, say(codemap, "No crashes kept.", "Keine Abstürze festgehalten."), bodyOf(codemap), x, y, width, TEXT_COLOR, 1, 19)
        }
        var now: [2]usize = [2]usize{ 0, 0 }
        const clock_status = std.linux.syscall2(228, 0, @intFromPtr(&now))
        const most: usize = if codemap.*.expanded[0] { codemap.*.findingCount } else { 30 }
        var at: usize = 0
        while at < codemap.*.findingCount && at < most {
            const record = codemap.*.findingOrder[at]
            length = writeText(bytes, 0, crashes_module.field(crashes, record, 2))
            length = writeText(bytes, length, ", ")
            length = writeAgo(codemap, bytes, length, now[0], @intCast(usize, crashes_module.timeOf(crashes, record)))
            length = writeText(bytes, length, ": ")
            const reason = crashes_module.field(crashes, record, 3)
            length = writeText(bytes, length, if reason.length > 300 { reason[0..300] } else { reason })
            y += 8
            y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, y, width, canvasColor(CRASH_COLOR, 255), 3, 17)
            y += 2
            var frame = crashes_module.firstFrame(crashes, record)
            var shown: usize = 0
            while frame < crashes.*.frameCount && crashes.*.frameRecord[frame] == record && shown < 12 {
                const node = nodeOfSymbol(codemap, crashes.*.frameSymbol[frame])
                if node != NONE && !isHidden(codemap, node) {
                    // The line it was on (the compiler's line table).
                    const where = crashes_module.frameWhere(crashes_module.frameText(crashes, frame))
                    var colon = where.length
                    while colon > 0 && where[colon - 1] != 58 { colon -= 1 }
                    var line_length = writeText(bytes, 0, if where.length > 0 { say(codemap, "line ", "Zeile ") } else { "" })
                    if where.length > 0 { line_length = writeText(bytes, line_length, where[colon..where.length]) }
                    drawRowNote(codemap, canvas, node, bytes[0..line_length], x + 6, y, width - 6, if crashes.*.frameDepth[frame] == 0 { CRASH_COLOR } else { 0 })
                } else if y > TOOLBAR && y < bottom {
                    canvas_module.drawText(canvas, smallOf(codemap), crashes_module.frameText(crashes, frame), x + 22, y + 5, DIM_COLOR, width - 22)
                }
                y += DETAIL_ROW
                shown += 1
                frame += 1
            }
            at += 1
        }
        if at < codemap.*.findingCount {
            addDetailRow(codemap, y, 0, ROW_MORE)
            length = writeText(bytes, 0, "+ ")
            length = writeNumber(codemap, bytes, length, codemap.*.findingCount - at)
            length = writeText(bytes, length, say(codemap, " more", " weitere"))
            if y > TOOLBAR && y < bottom { canvas_module.drawText(canvas, smallOf(codemap), bytes[0..length], x + 22, y + 5, ACCENT, 0) }
            y += DETAIL_ROW
        }
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - TOOLBAR + 20
    drawCloseButton(codemap, canvas)
}

// How long ago `then` was (seconds since 1970), as "5 min ago".
fn writeAgo(codemap: *Codemap, out: [*]u8, at: usize, now: usize, then: usize) -> usize {
    const seconds = if now > then { now - then } else { 0 }
    var length = writeText(out, at, say(codemap, "", "vor "))
    if seconds < 60 {
        length = writeText(out, length, say(codemap, "just now", "wenigen Sekunden"))
        return length
    }
    if seconds < 3600 {
        length = writeNumber(codemap, out, length, seconds / 60)
        length = writeText(out, length, " min")
    } else if seconds < 172800 {
        length = writeNumber(codemap, out, length, seconds / 3600)
        length = writeText(out, length, say(codemap, " h", " Std."))
    } else {
        length = writeNumber(codemap, out, length, seconds / 86400)
        length = writeText(out, length, say(codemap, " days", " Tagen"))
    }
    return writeText(out, length, say(codemap, " ago", ""))
}

// The measures of a declaration: its machine code, the programs that
// reach it (or that none does), its checks, commits, complexity, time
// spent in it and its risk.
fn drawMeasuresOf(codemap: *Codemap, canvas: *Canvas, symbol: u32, x: i32, y: i32, width: i32) -> i32 {
    var row_y = y
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const programs = programsOf(codemap)
    var length: usize = 0
    // Programs.
    var reached: usize = 0
    var program: usize = 0
    while program < programs.*.count {
        if programs_module.reaches(programs, program, symbol) { reached += 1 }
        program += 1
    }
    if reached == 0 {
        length = writeText(bytes, 0, if programs_module.checked(programs, symbol) { say(codemap, "Reached by checks only", "Nur von Checks erreicht") } else { say(codemap, "No program reaches it", "Kein Programm erreicht das") })
    } else {
        length = writeText(bytes, 0, say(codemap, "Reached by ", "Erreicht von "))
        var named: usize = 0
        program = 0
        while program < programs.*.count && named < 4 {
            if programs_module.reaches(programs, program, symbol) {
                if named > 0 { length = writeText(bytes, length, ", ") }
                length = writeText(bytes, length, programs_module.nameOf(programs, program))
                named += 1
            }
            program += 1
        }
        if reached > named {
            length = writeText(bytes, length, say(codemap, " and ", " und "))
            length = writeNumber(codemap, bytes, length, reached - named)
            length = writeText(bytes, length, say(codemap, " more", " weitere"))
        }
        length = writeText(bytes, length, if programs_module.checked(programs, symbol) { say(codemap, "; checked", "; geprüft") } else { say(codemap, "; no check reaches it", "; kein Check erreicht das") })
    }
    row_y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, row_y, width, DIM_COLOR, 3, 17)
    // Machine code, commits, complexity, time, risk: one line.
    length = 0
    const bytes_of = binaries_module.bytesOf(binariesOf(codemap), symbol)
    if bytes_of > 0 {
        length = writeNumber(codemap, bytes, length, @intCast(usize, bytes_of))
        length = writeText(bytes, length, say(codemap, " bytes of code", " Bytes Code"))
    }
    const commits = history_module.commitsOf(historyOf(codemap), symbol)
    if commits > 0 {
        if length > 0 { length = writeText(bytes, length, " · ") }
        length = writeNumber(codemap, bytes, length, @intCast(usize, commits))
        length = writeText(bytes, length, " Commits")
    }
    const branches = complexity_module.branchesOf(complexityOf(codemap), symbol)
    if branches > 0 {
        if length > 0 { length = writeText(bytes, length, " · ") }
        length = writeNumber(codemap, bytes, length, @intCast(usize, branches))
        length = writeText(bytes, length, say(codemap, " branches, ", " Zweige, "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, complexity_module.depthOf(complexityOf(codemap), symbol)))
        length = writeText(bytes, length, say(codemap, " deep", " tief"))
    }
    const samples = profiles_module.totalOf(profilesOf(codemap), symbol)
    if samples > 0 {
        const all = if profilesOf(codemap).*.allSamples > 0 { profilesOf(codemap).*.allSamples } else { 1 }
        if length > 0 { length = writeText(bytes, length, " · ") }
        length = writeNumber(codemap, bytes, length, @intCast(usize, @intCast(u64, samples) * 100 / all))
        length = writeText(bytes, length, say(codemap, "% of the time", "% der Zeit"))
    }
    const risk = measures_module.risk(measuresOf(codemap), symbol)
    if risk > 0 {
        if length > 0 { length = writeText(bytes, length, " · ") }
        length = writeText(bytes, length, say(codemap, "risk ", "Risiko "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, risk))
    }
    if length > 0 { row_y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, row_y, width, if risk >= measures_module.RISKY { canvasColor(RISKY_COLOR, 255) } else { DIM_COLOR }, 3, 17) }
    return row_y
}

// What the crashes and the workarounds say of a declaration.
fn drawKeptOf(codemap: *Codemap, canvas: *Canvas, symbol: u32, x: i32, y: i32, width: i32) -> i32 {
    var row_y = y
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const crashes = crashesOf(codemap)
    const latest = crashes_module.latestOf(crashes, symbol)
    if latest != NONE {
        const stopped = crashes_module.stoppedIn(crashes, symbol)
        const through = crashes_module.wentThrough(crashes, symbol)
        var length: usize = 0
        if stopped > 0 {
            length = writeText(bytes, length, say(codemap, "Crashed here ", "Hier abgestürzt "))
            length = writeNumber(codemap, bytes, length, @intCast(usize, stopped))
            length = writeText(bytes, length, "x")
            if through > 0 { length = writeText(bytes, length, ", ") }
        }
        if through > 0 {
            length = writeText(bytes, length, say(codemap, "on the way of a crash ", "auf dem Weg eines Absturzes "))
            length = writeNumber(codemap, bytes, length, @intCast(usize, through))
            length = writeText(bytes, length, "x")
        }
        length = writeText(bytes, length, say(codemap, ". Last: ", ". Zuletzt: "))
        length = writeText(bytes, length, crashes_module.field(crashes, latest, 2))
        length = writeText(bytes, length, ", ")
        const reason = crashes_module.field(crashes, latest, 3)
        length = writeText(bytes, length, if reason.length > 240 { reason[0..240] } else { reason })
        row_y += 4
        row_y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, row_y, width, canvasColor(CRASH_COLOR, 255), 4, 17)
    }
    const workarounds = workaroundsOf(codemap)
    const marks = workarounds_module.marksOf(workarounds, symbol)
    if marks != 0 {
        var pattern: usize = 0
        while pattern < workarounds_module.PATTERNS {
            if marks & (@intCast(u16, 1) << @intCast(u16, pattern)) != 0 {
                const places = workarounds_module.placesIn(workarounds, @intCast(u8, pattern), symbol, codemap.*.keptCounts, KEPT_ROWS)
                var length = writeText(bytes, 0, say(codemap, "Workaround: ", "Workaround: "))
                length = writeText(bytes, length, workarounds_module.title(@intCast(u8, pattern), codemap.*.german))
                if places > 1 {
                    length = writeText(bytes, length, " (")
                    length = writeNumber(codemap, bytes, length, places)
                    length = writeText(bytes, length, "x)")
                }
                length = writeText(bytes, length, ". ")
                length = writeText(bytes, length, workarounds_module.missing(@intCast(u8, pattern), codemap.*.german))
                row_y += 2
                row_y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, row_y, width, canvasColor(WORKAROUND_COLOR, 255), 3, 17)
            }
            pattern += 1
        }
    }
    return row_y
}

fn drawDetail(codemap: *Codemap, canvas: *Canvas) -> void {
    codemap.*.detailRowCount = 0
    if !detailOpen(codemap) { return }
    if codemap.*.rewritePattern != 255 {
        drawRewrite(codemap, canvas)
        return
    }
    if codemap.*.selected == NONE {
        drawFindings(codemap, canvas)
        return
    }
    const node = codemap.*.selected
    const record = nodeOf(codemap, node)
    const left = detailX(codemap)
    const height = viewHeight(codemap)
    canvas_module.fillRect(canvas, left, TOOLBAR, DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = DETAIL - 40
    const top = TOOLBAR + 18 - codemap.*.detailScroll
    var y = top
    // The kind, the name, where it is.
    drawDot(canvas, x, y + 3, 10, canvasColor(record.*.color, 255))
    canvas_module.drawText(canvas, smallOf(codemap), kindLabel(codemap, node), x + 16, y, DIM_COLOR, 0)
    y += 22
    y += drawWrapped(codemap, canvas, nameOf(codemap, node), titleOf(codemap), x, y, width, TEXT_COLOR, 3, 22)
    var place: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &place) }
    var length: usize = 0
    const index = codemap.*.index
    if record.*.kind == graph_module.DIRECTORY {
        length = writeNumber(codemap, bytes, 0, @intCast(usize, record.*.files))
        length = writeText(bytes, length, say(codemap, " files, ", " Dateien, "))
        length = writeNumber(codemap, bytes, length, @intCast(usize, record.*.declarations))
        length = writeText(bytes, length, say(codemap, " declarations", " Deklarationen"))
    } else {
        length = writeText(bytes, 0, graph_module.pathOf(graphOf(codemap), node))
        if record.*.kind == graph_module.DECLARATION {
            const symbol = index_module.symbolAt(index, record.*.symbol)
            length = writeText(bytes, length, ":")
            length = writeNumber(codemap, bytes, length, index_module.lineOf(index, symbol.*.file, @intCast(usize, symbol.*.nameStart)) + 1)
        }
    }
    y += 4
    y += drawWrapped(codemap, canvas, bytes[0..length], smallOf(codemap), x, y, width, DIM_COLOR, 3, 17)
    // Its weight: how often it is used, from outside itself.
    if record.*.kind != graph_module.DIRECTORY {
        const uses = if record.*.kind == graph_module.DECLARATION { @intCast(usize, analysis_module.usesOf(analysisOf(codemap), record.*.symbol)) } else { 0 }
        const outside = @intCast(usize, graph_module.weightTo(graphOf(codemap), node))
        var weight: [96]u8 = undefined
        var weight_bytes: [*]u8 = undefined
        unsafe { weight_bytes = @ptrCast([*]u8, &weight) }
        var weight_length: usize = 0
        if record.*.kind == graph_module.DECLARATION {
            weight_length = writeText(weight_bytes, 0, say(codemap, "Used ", "Verwendet "))
            weight_length = writeNumber(codemap, weight_bytes, weight_length, uses)
            weight_length = writeText(weight_bytes, weight_length, say(codemap, "x, from elsewhere ", "x, von anderswo "))
        } else {
            weight_length = writeText(weight_bytes, 0, say(codemap, "Used from elsewhere ", "Von anderswo verwendet "))
        }
        weight_length = writeNumber(codemap, weight_bytes, weight_length, outside)
        weight_length = writeText(weight_bytes, weight_length, "x")
        if y > TOOLBAR { canvas_module.drawText(canvas, smallOf(codemap), weight_bytes[0..weight_length], x, y + 2, if uses == 0 && record.*.kind == graph_module.DECLARATION { canvasColor(FINDING_COLOR, 255) } else { DIM_COLOR }, 0) }
        y += 20
    }
    if record.*.kind == graph_module.DECLARATION {
        y = drawMeasuresOf(codemap, canvas, record.*.symbol, x, y, width)
        y = drawKeptOf(codemap, canvas, record.*.symbol, x, y, width)
    }
    // Open in the editor.
    if record.*.kind != graph_module.DIRECTORY {
        y += 8
        const label = say(codemap, "Open in editor", "Im Editor öffnen")
        const button_width = canvas_module.measure(bodyOf(codemap), label) + 24
        const hit = HIT_ROW + codemap.*.detailRowCount
        addDetailRow(codemap, y, node, ROW_OPEN)
        if y + DETAIL_ROW > TOOLBAR {
            canvas_module.fillRoundedRect(canvas, x, y - 2, button_width, 28, 8, if codemap.*.hover == hit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
            canvas_module.drawText(canvas, bodyOf(codemap), label, x + 12, y + 4, TEXT_COLOR, 0)
        }
        y += 34
    }
    // The signature.
    if record.*.kind == graph_module.DECLARATION {
        var start: usize = 0
        var size: usize = 0
        index_module.signatureRange(index, record.*.symbol, &start, &size)
        if size > 0 {
            const source = index_module.sourceOf(index, index_module.symbolAt(index, record.*.symbol).*.file)
            const signature = source[start..start + (if size > 600 { 600 } else { size })]
            y += 4
            // Its box, sized by drawing it once out of sight first.
            const lines_height = measureWrapped(codemap, signature, smallOf(codemap), width - 20, 8, 17)
            if y + lines_height + 12 > TOOLBAR { canvas_module.fillRoundedRect(canvas, x, y, width, lines_height + 14, 8, canvas_module.color(255, 17, 18, 24)) }
            y += 7
            y += drawWrapped(codemap, canvas, signature, smallOf(codemap), x + 10, y, width - 20, canvas_module.color(255, 190, 210, 255), 8, 17)
            y += 12
        }
    }
    // The doc comment.
    var doc: [4096]u8 = undefined
    var doc_bytes: [*]u8 = undefined
    unsafe { doc_bytes = @ptrCast([*]u8, &doc) }
    const doc_length = docText(codemap, node, doc_bytes, 4096)
    if doc_length > 0 {
        y += 6
        y += drawWrapped(codemap, canvas, doc_bytes[0..doc_length], bodyOf(codemap), x, y, width, canvas_module.color(255, 206, 210, 220), 30, 19)
        y += 4
    }
    // What it connects to.
    const relations = relationsOf(codemap)
    if record.*.kind == graph_module.DECLARATION {
        y = drawSection(codemap, canvas, 0, say(codemap, "Calls", "Ruft auf"), relations.*.outgoing, relations.*.outgoingCount, @intCast(i32, graph_module.RELATION_CALL), OUTGOING, x, y, width)
        y = drawSection(codemap, canvas, 1, say(codemap, "Uses", "Verwendet"), relations.*.outgoing, relations.*.outgoingCount, @intCast(i32, graph_module.RELATION_USE), OUTGOING, x, y, width)
        y = drawSection(codemap, canvas, 2, say(codemap, "Called by", "Aufgerufen von"), relations.*.incoming, relations.*.incomingCount, @intCast(i32, graph_module.RELATION_CALL), INCOMING, x, y, width)
        y = drawSection(codemap, canvas, 3, say(codemap, "Used by", "Verwendet von"), relations.*.incoming, relations.*.incomingCount, @intCast(i32, graph_module.RELATION_USE), INCOMING, x, y, width)
        y = drawMembers(codemap, canvas, 4, say(codemap, "Members", "Mitglieder"), node, x, y, width)
        // What the code base as a whole says of it.
        const analysis = analysisOf(codemap)
        const symbol = record.*.symbol
        y = drawSymbols(codemap, canvas, 5, say(codemap, "Same code", "Gleicher Code"), analysis, analysis_module.COPIES, analysis_module.groupOf(analysis, analysis_module.COPIES, symbol), symbol, x, y, width)
        y = drawSymbols(codemap, canvas, 6, say(codemap, "Same but for names and values", "Gleich bis auf Namen und Werte"), analysis, analysis_module.SHAPES, analysis_module.groupOf(analysis, analysis_module.SHAPES, symbol), symbol, x, y, width)
        y = drawSymbols(codemap, canvas, 7, say(codemap, "Same name elsewhere", "Gleicher Name anderswo"), analysis, analysis_module.NAMES, analysis_module.groupOf(analysis, analysis_module.NAMES, symbol), symbol, x, y, width)
        if codemap.*.similarCount > 0 {
            y += 10
            if y > TOOLBAR && y < surfaceHeight(codemap) - STATUS { canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Used much alike", "Ähnlich verwendet"), x, y, canvasColor(FINDING_COLOR, 255), 0) }
            y += 20
            var similar: usize = 0
            while similar < codemap.*.similarCount {
                drawRow(codemap, canvas, codemap.*.similarNodes[similar], codemap.*.similarShares[similar], true, x + 6, y, width - 6, FINDING_COLOR)
                y += DETAIL_ROW
                similar += 1
            }
        }
        if relations.*.outgoingCount == 0 && relations.*.incomingCount == 0 && record.*.childCount == 0 {
            y += 10
            canvas_module.drawText(canvas, smallOf(codemap), say(codemap, "Nothing uses it.", "Nichts verwendet das."), x, y, DIM_COLOR, 0)
            y += 20
        }
    } else if record.*.kind == graph_module.FILE {
        y = drawSection(codemap, canvas, 0, say(codemap, "Imports", "Importiert"), relations.*.outgoing, relations.*.outgoingCount, -1, OUTGOING, x, y, width)
        y = drawSection(codemap, canvas, 1, say(codemap, "Imported by", "Importiert von"), relations.*.incoming, relations.*.incomingCount, -1, INCOMING, x, y, width)
        y = drawMembers(codemap, canvas, 4, say(codemap, "Declarations", "Deklarationen"), node, x, y, width)
    } else {
        y = drawSection(codemap, canvas, 0, say(codemap, "Depends on", "Hängt ab von"), relations.*.outgoing, relations.*.outgoingCount, -1, OUTGOING, x, y, width)
        y = drawSection(codemap, canvas, 1, say(codemap, "Used by", "Genutzt von"), relations.*.incoming, relations.*.incomingCount, -1, INCOMING, x, y, width)
        y = drawMembers(codemap, canvas, 4, say(codemap, "Contains", "Enthält"), node, x, y, width)
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - TOOLBAR + 20
    // Closing it (over what scrolls).
    const close_x = surfaceWidth(codemap) - 38
    canvas_module.fillRoundedRect(canvas, close_x, TOOLBAR + 10, 28, 28, 14, if codemap.*.hover == HIT_CLOSE { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 44, 47, 58) })
    var step: i32 = 0
    while step < 10 {
        canvas_module.fillRect(canvas, close_x + 9 + step, TOOLBAR + 19 + step, 2, 2, TEXT_COLOR)
        canvas_module.fillRect(canvas, close_x + 18 - step, TOOLBAR + 19 + step, 2, 2, TEXT_COLOR)
        step += 1
    }
    // A thin bar while there is more to scroll to.
    const view = height - 20
    if codemap.*.detailHeight > view {
        var thumb = view * view / codemap.*.detailHeight
        if thumb < 30 { thumb = 30 }
        const most = codemap.*.detailHeight - view
        const bar_y = TOOLBAR + 10 + (view - thumb) * codemap.*.detailScroll / (if most > 0 { most } else { 1 })
        canvas_module.fillRoundedRect(canvas, surfaceWidth(codemap) - 8, bar_y, 5, thumb, 3, canvas_module.color(110, 200, 205, 215))
    }
}

// The height drawWrapped would take.
fn measureWrapped(codemap: *Codemap, text: []const u8, font: *Text, width: i32, most: usize, line_height: i32) -> i32 {
    var lines: usize = 0
    var start: usize = 0
    while start < text.length && lines < most {
        var end = start
        var fit_end = start
        while end < text.length && text[end] != 10 {
            var word_end = end
            while word_end < text.length && text[word_end] == 32 { word_end += 1 }
            while word_end < text.length && text[word_end] != 32 && text[word_end] != 10 { word_end += 1 }
            if canvas_module.measure(font, text[start..word_end]) > width && fit_end > start { break }
            fit_end = word_end
            end = word_end
            if canvas_module.measure(font, text[start..word_end]) > width { break }
        }
        if fit_end == start { fit_end = end }
        if fit_end == start && start < text.length { fit_end = start + 1 }
        lines += 1
        start = fit_end
        while start < text.length && text[start] == 32 { start += 1 }
        if start < text.length && text[start] == 10 { start += 1 }
    }
    return @intCast(i32, lines) * line_height
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const codemap = codemapOf(context)
    const where = aggregates.mark(codemap.*.graph.arena)
    drawFrame(codemap, canvas)
    aggregates.reset(codemap.*.graph.arena, where)
}

fn drawFrame(codemap: *Codemap, canvas: *Canvas) -> void {
    const width = surfaceWidth(codemap)
    const height = surfaceHeight(codemap)
    canvas_module.clear(canvas, 0)
    buildScene(codemap)
    // Without the GPU the scene is drawn here, under the rest.
    if canvas.*.device == 0 { scene_module.drawCpu(sceneOf(codemap), canvas.*.pixels, canvas.*.width, canvas.*.width, canvas.*.height) }
    if !codemap.*.built {
        const message = say(codemap, "Reading the code...", "Der Code wird gelesen ...")
        canvas_module.drawText(canvas, titleOf(codemap), message, SIDEBAR + (width - SIDEBAR - canvas_module.measure(titleOf(codemap), message)) / 2, TOOLBAR + (height - TOOLBAR - STATUS) / 2 - 10, DIM_COLOR, 0)
        const root = rootText(codemap)
        canvas_module.drawText(canvas, smallOf(codemap), root, SIDEBAR + (width - SIDEBAR - canvas_module.measure(smallOf(codemap), root)) / 2, TOOLBAR + (height - TOOLBAR - STATUS) / 2 + 20, DIM_COLOR, 0)
    }
    if codemap.*.view == VIEW_EDITOR {
        drawEditor(codemap, canvas)
    } else {
        placeLabels(codemap)
        drawLabels(codemap, canvas)
    }
    drawDetail(codemap, canvas)
    drawToolbar(codemap, canvas)
    drawStatus(codemap, canvas)
    drawSidebar(codemap, canvas)
    drawResults(codemap, canvas)
    drawPopup(codemap, canvas)
    codemap.*.drawnOnce = true
    // The flight goes on.
    if codemap.*.flying { animate(codemap) }
}

// The scene, drawn by the GPU under what the canvas drew (panel.Scene).
fn drawScene(context: *anyopaque, gpu_context: *gpu.Context, target: vk.Buffer, width: u32, height: u32) -> bool {
    const codemap = codemapOf(context)
    const where = aggregates.mark(codemap.*.graph.arena)
    const rendered = scene_module.render(sceneOf(codemap), gpu_context, target, width, height)
    aggregates.reset(codemap.*.graph.arena, where)
    return rendered
}

// ---------------------------------------------------------------------------
// Starting

const Failure = error { NoMemory }

fn noMemory() -> Failure!void { return Failure.NoMemory }

fn allocate(codemap: *Codemap, bytes: usize) -> ?[*]u8 {
    return codemap.*.allocator.alloc(bytes, 16)
}

fn isDirectory(path: [*]const u8) -> bool {
    const handle = std.linux.syscall3(2, @intFromPtr(path), 65536 | 524288, 0)
    if handle < 0 { return false }
    const closed = std.linux.syscall1(3, @bitCast(usize, handle))
    return true
}

// The root: the argument, else MLX_CODEMAP_ROOT, else the Git work tree
// around the working directory, else the working directory.
fn findRoot(codemap: *Codemap, arguments: [][*]const u8, root_argument: usize) -> void {
    var root: [*]u8 = fieldBytes(codemap, @offsetOf(Codemap, "root"))
    var length: usize = 0
    if root_argument > 0 {
        const given = cString(arguments[root_argument])
        if given.length > 0 && given[0] != 47 {
            const got = std.fs.getWorkingDirectory(root, 1000)
            while length < 1000 && root[length] != 0 { length += 1 }
            root[length] = 47
            length += 1
        }
        for byte in given {
            if length < 1000 {
                root[length] = byte
                length += 1
            }
        }
    } else if @intFromPtr(apps_module.environmentValue(codemap.*.environment, "MLX_CODEMAP_ROOT")) != 0 {
        const given = cString(apps_module.environmentValue(codemap.*.environment, "MLX_CODEMAP_ROOT"))
        for byte in given {
            if length < 1000 {
                root[length] = byte
                length += 1
            }
        }
    } else {
        const got = std.fs.getWorkingDirectory(root, 1000)
        while length < 1000 && root[length] != 0 { length += 1 }
        // Up to the directory with .git in it.
        var probe = length
        while probe > 0 {
            var at = probe
            for byte in "/.git" {
                root[at] = byte
                at += 1
            }
            root[at] = 0
            if isDirectory(root) {
                length = probe
                break
            }
            probe -= 1
            while probe > 0 && root[probe] != 47 { probe -= 1 }
        }
    }
    while length > 1 && root[length - 1] == 47 { length -= 1 }
    root[length] = 0
    codemap.*.rootLength = length
}

// The options: --only GROUP,GROUP (the groups shown, by path), --view
// NAME (a view of codemap.views), --query WORDS, --diff REV (the base of
// Changed); the argument that is none of them is the root (0: none).
fn readOptions(codemap: *Codemap, arguments: [][*]const u8) -> usize {
    codemap.*.startOnlyLength = 0
    codemap.*.startSearchLength = 0
    codemap.*.diffBaseLength = 0
    var root_argument: usize = 0
    var at: usize = 1
    while at < arguments.length {
        const word = cString(arguments[at])
        const value = if at + 1 < arguments.length { cString(arguments[at + 1]) } else { "" }
        if sameBytes(word, "--only") {
            codemap.*.startOnlyLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "startOnly")), 0, value, 512)
            at += 1
        } else if sameBytes(word, "--view") {
            var length = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "startSearch")), 0, "@", 256)
            codemap.*.startSearchLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "startSearch")), length, value, 256)
            at += 1
        } else if sameBytes(word, "--query") {
            codemap.*.startSearchLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "startSearch")), 0, value, 256)
            at += 1
        } else if sameBytes(word, "--diff") {
            codemap.*.diffBaseLength = copyOption(fieldBytes(codemap, @offsetOf(Codemap, "diffBase")), 0, value, 128)
            at += 1
        } else if root_argument == 0 && (word.length == 0 || word[0] != 45) {
            root_argument = at
        }
        at += 1
    }
    return root_argument
}

fn copyOption(into: [*]u8, start: usize, text: []const u8, room: usize) -> usize {
    var length = start
    for byte in text {
        if length < room {
            into[length] = byte
            length += 1
        }
    }
    return length
}

// After the code is read the first time: the groups asked for with --only
// (the others left out), and the search asked for.
fn applyStart(codemap: *Codemap) -> void {
    const graph = graphOf(codemap)
    const root = graph.*.root
    const only = fieldBytes(codemap, @offsetOf(Codemap, "startOnly"))[0..codemap.*.startOnlyLength]
    markOnly(codemap, only)
    const search = fieldBytes(codemap, @offsetOf(Codemap, "startSearch"))[0..codemap.*.startSearchLength]
    if search.length > 0 {
        setSearch(codemap, search)
    } else if only.length > 0 {
        refreshVisibility(codemap)
    }
    // (A query flew there already.)
    if only.length > 0 && !codemap.*.queryActive { flyToShown(codemap) }
}

// Leaves out all but the groups named in `only` ("std,examples/mlx-files").
fn markOnly(codemap: *Codemap, only: []const u8) -> void {
    const graph = graphOf(codemap)
    if only.length > 0 {
        // The groups named ("std", "examples/mlx-files").
        var wanted: [32]u32 = undefined
        var wanted_count: usize = 0
        var start: usize = 0
        var at: usize = 0
        while at <= only.length {
            if at == only.length || only[at] == 44 {
                var end = at
                while end > start && only[end - 1] == 47 { end -= 1 }
                const node = groupAtPath(codemap, only[start..end])
                if node != NONE && wanted_count < 32 {
                    wanted[wanted_count] = node
                    wanted_count += 1
                }
                start = at + 1
            }
            at += 1
        }
        // Out: every node on the way to a wanted group that is neither on
        // the way nor wanted.
        var node: usize = 0
        while node < graph.*.count {
            const id = @intCast(u32, node)
            const parent = nodeOf(codemap, id).*.parent
            if parent != NONE && nodeOf(codemap, id).*.kind != graph_module.DECLARATION {
                var parent_on_way = false
                var self_kept = false
                var which: usize = 0
                while which < wanted_count {
                    if isInside(codemap, wanted[which], parent) && wanted[which] != parent && !isInsideWanted(codemap, parent, wanted[0..wanted_count]) { parent_on_way = true }
                    if isInside(codemap, wanted[which], id) { self_kept = true }
                    which += 1
                }
                if parent_on_way && !self_kept { codemap.*.off[node] = 1 }
            }
            node += 1
        }
        if codemap.*.trace { traceLine(codemap, "only ", only) }
    }
}

// Whether `node` is inside (or is) one of the wanted groups.
fn isInsideWanted(codemap: *Codemap, node: u32, wanted: []const u32) -> bool {
    for group in wanted {
        if isInside(codemap, node, group) { return true }
    }
    return false
}

// The group (directory or file) at a path under the root; NONE: none.
fn groupAtPath(codemap: *Codemap, path: []const u8) -> u32 {
    var node = graphOf(codemap).*.root
    var start: usize = 0
    var at: usize = 0
    while at <= path.length {
        if at == path.length || path[at] == 47 {
            if at > start {
                const part = path[start..at]
                var found = NONE
                var child = nodeOf(codemap, node).*.firstChild
                while child != NONE && found == NONE {
                    if nodeOf(codemap, child).*.kind != graph_module.DECLARATION && sameBytes(nameOf(codemap, child), part) { found = child }
                    child = nodeOf(codemap, child).*.nextSibling
                }
                if found == NONE { return NONE }
                node = found
            }
            start = at + 1
        }
        at += 1
    }
    return if node == graphOf(codemap).*.root { NONE } else { node }
}

pub fn main(arguments: [][*]const u8) -> !void {
    // A command: the command line tool.
    if arguments.length > 1 && cli.isCommand(cString(arguments[1])) {
        try cli.run(arguments)
        return
    }
    crash.install()
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Codemap), 16)
    if memory == null { return noMemory() }
    var codemap: *Codemap = undefined
    unsafe { codemap = @ptrCast(*Codemap, memory.?) }
    codemap.*.allocator = allocator
    codemap.*.environment = environment
    codemap.*.german = clock.germanLocale(environment)
    const trace = apps_module.environmentValue(environment, "MLX_CODEMAP_TRACE")
    codemap.*.trace = @intFromPtr(trace) != 0 && trace[0] != 0
    codemap.*.hasIndex = false
    codemap.*.built = false
    codemap.*.drawnOnce = false
    codemap.*.selected = NONE
    codemap.*.focus = NONE
    codemap.*.hoverNode = NONE
    codemap.*.hover = HIT_NONE
    codemap.*.pressHit = HIT_NONE
    codemap.*.lastClickNode = NONE
    codemap.*.showImports = true
    codemap.*.showTree = true
    codemap.*.showLabels = true
    codemap.*.searchLength = 0
    codemap.*.queryActive = false
    codemap.*.queryBad = false
    codemap.*.queryCount = 0
    codemap.*.viewRows = 0
    codemap.*.popup = POPUP_NONE
    codemap.*.popupRows = 0
    codemap.*.view = VIEW_MAP
    codemap.*.tabCount = 0
    codemap.*.activeTab = 0
    codemap.*.editorDragging = false
    codemap.*.editorClickAt = 0
    codemap.*.editorHover = 18446744073709551615
    codemap.*.editorLeft = SIDEBAR
    codemap.*.stale = false
    codemap.*.viewSwitchY = AWAY
    var tab_at: usize = 0
    while tab_at < MAX_TABS {
        editor_module.init(editorAt(codemap, tab_at), allocator)
        codemap.*.tabMarks[tab_at] = 0
        codemap.*.tabHeat[tab_at] = 0
        codemap.*.tabSpans[tab_at] = 0
        codemap.*.tabPlaces[tab_at] = 0
        codemap.*.tabPlaceCount[tab_at] = 0
        codemap.*.tabMarkLines[tab_at] = 0
        codemap.*.tabSpanCount[tab_at] = 0
        tab_at += 1
    }
    check_module.init(checkOf(codemap), allocator, environment)
    protocol.initWriter(hoverTextOf(codemap), allocator, 1024)
    codemap.*.chipCount = 0
    codemap.*.refsOpen = false
    codemap.*.refsCount = 0
    codemap.*.completeOpen = false
    codemap.*.signatureActive = false
    codemap.*.renameOpen = false
    codemap.*.gutterHover = 18446744073709551615
    codemap.*.blameTab = 999
    check_module.init(buildOf(codemap), allocator, environment)
    codemap.*.job = JOB_NONE
    codemap.*.commitLength = 0
    codemap.*.changeCount = 0
    codemap.*.changesLength = 0
    codemap.*.buildNameLength = 0
    codemap.*.rewritePattern = 255
    codemap.*.rewriteReady = false
    codemap.*.rewriteAccepted = false
    codemap.*.historyJob = 0
    codemap.*.profileJob = 0
    startDemo(codemap)
    codemap.*.baseCount = 0
    loadSections(codemap)
    const root_argument = readOptions(codemap, arguments)
    findRoot(codemap, arguments, root_argument)
    // The compiler (checks and Build): MLX_COMPILER, else the root's
    // mlx-out/bin/compiler/mlx4, else mlx4 on the PATH.
    const compiler_variable = apps_module.environmentValue(environment, "MLX_COMPILER")
    const path_variable = apps_module.environmentValue(environment, "PATH")
    check_module.configure(checkOf(codemap), rootText(codemap), if @intFromPtr(compiler_variable) != 0 { cString(compiler_variable) } else { "" }, if @intFromPtr(path_variable) != 0 { cString(path_variable) } else { "" })
    check_module.configure(buildOf(codemap), rootText(codemap), if @intFromPtr(compiler_variable) != 0 { cString(compiler_variable) } else { "" }, if @intFromPtr(path_variable) != 0 { cString(path_variable) } else { "" })
    graph_module.init(graphOf(codemap), allocator)
    scene_module.init(sceneOf(codemap), allocator)
    const count = graph_module.MAX_NODES
    const seen_x = allocate(codemap, count * 8)
    const seen_y = allocate(codemap, count * 8)
    const seen_radius = allocate(codemap, count * 8)
    const seen_depth = allocate(codemap, count * 8)
    const seen = allocate(codemap, count)
    const drawn = allocate(codemap, count * 4)
    const related = allocate(codemap, count)
    const matches = allocate(codemap, count)
    const finding_order = allocate(codemap, index_module.MAX_SYMBOLS * 4)
    const finding_mark = allocate(codemap, count * 2)
    const metric_values = allocate(codemap, count * 8)
    const sort_keys = allocate(codemap, index_module.MAX_SYMBOLS * 8)
    const crash_mark = allocate(codemap, count)
    const kept_symbols = allocate(codemap, KEPT_ROWS * 4)
    const off = allocate(codemap, count)
    const hidden = allocate(codemap, count)
    const line_groups = allocate(codemap, LINE_GROUPS * 4)
    const kept_counts = allocate(codemap, KEPT_ROWS * 4)
    const keys = allocate(codemap, LABEL_CANDIDATES * 8)
    const key_scratch = allocate(codemap, LABEL_CANDIDATES * 8)
    const outgoing = allocate(codemap, graph_module.MAX_RELATED * @sizeOf(Relation))
    const incoming = allocate(codemap, graph_module.MAX_RELATED * @sizeOf(Relation))
    if finding_order == null || finding_mark == null || crash_mark == null || kept_symbols == null || kept_counts == null || off == null || hidden == null || line_groups == null || metric_values == null || sort_keys == null { return noMemory() }
    unsafe {
        codemap.*.metricValues = @ptrCast([*]f64, metric_values.?)
        codemap.*.sortKeys = @ptrCast([*]u64, sort_keys.?)
        codemap.*.off = off.?
        codemap.*.hidden = hidden.?
        codemap.*.lineGroups = @ptrCast([*]u32, line_groups.?)
        codemap.*.keptSymbols = @ptrCast([*]u32, kept_symbols.?)
        codemap.*.keptCounts = @ptrCast([*]u32, kept_counts.?)
        codemap.*.findingOrder = @ptrCast([*]u32, finding_order.?)
        codemap.*.findingMark = @ptrCast([*]u16, finding_mark.?)
        codemap.*.crashMark = crash_mark.?
    }
    codemap.*.crashedCount = 0
    codemap.*.anyOff = false
    codemap.*.lineGroupCount = 0
    codemap.*.patternCount = 0
    codemap.*.patternRows = 0
    codemap.*.workaroundsOpen = false
    var at: usize = 0
    while at < count {
        codemap.*.off[at] = 0
        codemap.*.hidden[at] = 0
        at += 1
    }
    at = 0
    while at < 20 {
        codemap.*.kindOff[at] = false
        at += 1
    }
    at = 0
    while at < FINDINGS {
        codemap.*.findingOn[at] = at == @intCast(usize, FINDING_CRASHES)
        codemap.*.findingCounts[at] = 0
        codemap.*.findingY[at] = -1000
        at += 1
    }
    at = 0
    while at < 9 {
        codemap.*.patternOn[at] = true
        codemap.*.patternPlaces[at] = 0
        at += 1
    }
    codemap.*.crashLogSize = -1
    codemap.*.crashCheckAt = 0
    crashes_module.init(crashesOf(codemap), allocator)
    workarounds_module.init(workaroundsOf(codemap), allocator)
    programs_module.init(programsOf(codemap), allocator)
    binaries_module.init(binariesOf(codemap), allocator)
    complexity_module.init(complexityOf(codemap), allocator)
    structure_module.init(structureOf(codemap), allocator)
    git_module.init(gitOf(codemap), allocator, rootText(codemap), codemap.*.environment)
    history_module.init(historyOf(codemap), allocator, gitOf(codemap))
    profiles_module.init(profilesOf(codemap), allocator)
    trend_module.init(trendOf(codemap), allocator)
    query_module.init(queryOf(codemap), allocator)
    diff_module.init(diffOf(codemap), allocator)
    viewsOf(codemap).*.count = 0
    codemap.*.program = 0
    codemap.*.programsOpen = false
    codemap.*.programRows = 0
    codemap.*.metric = measures_module.KIND
    codemap.*.sidebarScroll = 0
    codemap.*.sidebarHeight = 0
    codemap.*.historyShown = 0
    codemap.*.historyCheckAt = 0
    codemap.*.profilesTime = -1
    codemap.*.finding = FINDING_NONE
    codemap.*.findingCount = 0
    codemap.*.similarCount = 0
    analysis_module.init(analysisOf(codemap), allocator)
    if seen_x == null || seen_y == null || seen_radius == null || seen_depth == null || seen == null || drawn == null || related == null || matches == null || keys == null || key_scratch == null || outgoing == null || incoming == null { return noMemory() }
    unsafe {
        codemap.*.seenX = @ptrCast([*]f64, seen_x.?)
        codemap.*.seenY = @ptrCast([*]f64, seen_y.?)
        codemap.*.seenRadius = @ptrCast([*]f64, seen_radius.?)
        codemap.*.seenDepth = @ptrCast([*]f64, seen_depth.?)
        codemap.*.seen = seen.?
        codemap.*.drawn = @ptrCast([*]u32, drawn.?)
        codemap.*.related = related.?
        codemap.*.matches = matches.?
        codemap.*.labelKeys = @ptrCast([*]u64, keys.?)
        codemap.*.labelScratch = @ptrCast([*]u64, key_scratch.?)
        codemap.*.relations.outgoing = @ptrCast([*]Relation, outgoing.?)
        codemap.*.relations.incoming = @ptrCast([*]Relation, incoming.?)
    }
    codemap.*.relations.subject = NONE
    codemap.*.relations.outgoingCount = 0
    codemap.*.relations.incomingCount = 0
    const camera = cameraOf(codemap)
    camera.*.target = m.vec(0.0, 0.0, 0.0)
    camera.*.distance = 100.0
    camera.*.yaw = 0.0
    camera.*.pitch = 0.3
    camera.*.focal = 600.0
    camera.*.centerX = 400.0
    camera.*.centerY = 300.0
    const loaded_body = canvas_module.loadText(bodyOf(codemap), 13, allocator)
    const loaded_small = canvas_module.loadText(smallOf(codemap), 12, allocator)
    const loaded_title = canvas_module.loadText(titleOf(codemap), 17, allocator)
    const loaded_mono = canvas_module.loadMonoText(monoOf(codemap), 13, allocator)
    codemap.*.charWidth = canvas_module.measure(monoOf(codemap), "M")
    if codemap.*.charWidth <= 0 { codemap.*.charWidth = 8 }

    const panel = panelOf(codemap)
    panel.*.context = @ptrCast(*anyopaque, codemap)
    panel.*.draw = draw
    panel.*.event = onEvent
    try panel_module.openWindow(panel, allocator, arguments, "Observatory", "org.mlx.observatory", @intCast(u32, WIDTH), @intCast(u32, HEIGHT))
    panel.*.scene = @intFromPtr(drawScene)
    panel.*.toplevel.setMinSize(MIN_WIDTH, MIN_HEIGHT)
    panel_module.report(panel, "mlx-observatory")
    panel.*.tickInterval = 50
    try panel_module.run(panel)
    panel_module.close(panel)
}
