// Completion, signature help, rename, blame, hover text and folding (part of main.mlx, split from it).
const std = @import("std")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const index_module = @import("../../tools/codemap/index.mlx")
const programs_module = @import("../../tools/codemap/programs.mlx")
const git_module = @import("../../tools/codemap/git.mlx")
const features = @import("../../tools/mlx-lsp/features.mlx")
const protocol = @import("../../tools/mlx-lsp/protocol.mlx")
const editor_module = @import("./editor.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const lists_module = @import("./lists.mlx")
const drawing_module = @import("./drawing.mlx")
const tabs_module = @import("./tabs.mlx")
const editor_view_module = @import("./editor_view.mlx")

// ---------------------------------------------------------------------------
// Completion and signature help (from the index: what is in scope, the
// members of what is before a dot, the builtins after @; the call around
// the cursor)

pub fn isNameByte(byte: u8) -> bool { return editor_view_module.isNameStart(byte) || (byte >= 48 && byte <= 57) }

// Where the cursor is in the index's copy of the tab's file (the same
// line and column when the text was edited since).
pub fn offsetInIndex(codemap: *app.Codemap, tab: usize) -> usize {
    const editor = access_module.editorAt(codemap, tab)
    if tabs_module.tabIndexedNow(codemap, tab) { return editor.*.cursor }
    return features.offsetIn(codemap.*.index, codemap.*.tabFile[tab], editor_module.lineOf(editor, editor.*.cursor), editor_module.columnOf(editor, editor.*.cursor))
}

// A word of the keywords' or builtins' list as an item: its bit 31, the
// list (bit 30), where it starts and ends.
fn wordItem(list: u32, start: usize, end: usize) -> u32 { return 2147483648 | (list << 30) | (@intCast(u32, start) << 15) | @intCast(u32, end) }

fn itemText(codemap: *app.Codemap, item: u32) -> []const u8 {
    if item & 2147483648 == 0 { return index_module.nameOf(codemap.*.index, item) }
    const list = if item & 1073741824 != 0 { features.builtins() } else { features.keywords() }
    return list[@intCast(usize, (item >> 15) & 32767)..@intCast(usize, item & 32767)]
}

fn startsWithFolded(text: []const u8, prefix: []const u8) -> bool {
    if prefix.length > text.length { return false }
    var at: usize = 0
    while at < prefix.length {
        if lowerByte(text[at]) != lowerByte(prefix[at]) { return false }
        at += 1
    }
    return true
}

fn lowerByte(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// How well `name` fits what was typed (0: not at all): the typed text
// at its start (as typed, then any case) first, then its letters in order
// in the name, the more of them at the starts of its words the better.
fn matchScore(name: []const u8, typed: []const u8) -> u32 {
    if typed.length == 0 { return 1 }
    if typed.length > name.length { return 0 }
    const shorter = @intCast(u32, if name.length < 900 { name.length } else { 900 })
    if access_module.sameBytes(name[0..typed.length], typed) { return 5000 - shorter }
    if startsWithFolded(name, typed) { return 4000 - shorter }
    var at: usize = 0
    var starts: u32 = 0
    var gaps: u32 = 0
    var matched: usize = 0
    while at < name.length && matched < typed.length {
        if lowerByte(name[at]) == lowerByte(typed[matched]) {
            const word_start = at == 0 || name[at - 1] == 95 || (name[at] >= 65 && name[at] <= 90 && !(name[at - 1] >= 65 && name[at - 1] <= 90))
            if word_start { starts += 1 }
            matched += 1
        } else if matched > 0 {
            gaps += 1
        }
        at += 1
    }
    if matched < typed.length { return 0 }
    // The first letter must start a word.
    if lowerByte(name[0]) != lowerByte(typed[0]) && starts == 0 { return 0 }
    const score = 2000 + starts * 100
    return if gaps * 5 < score - 1000 { score - gaps * 5 } else { 1000 }
}

// The list for what is typed at the cursor (closed when nothing fits);
// `forced` (Ctrl+Space): also with nothing typed yet.
pub fn updateCompletion(codemap: *app.Codemap) -> void { openCompletion(codemap, false) }

pub fn openCompletion(codemap: *app.Codemap, forced: bool) -> void {
    codemap.*.completeOpen = false
    if !tabs_module.hasTab(codemap) || !codemap.*.built { return }
    const tab = codemap.*.activeTab
    if codemap.*.tabFile[tab] == app.NONE { return }
    const editor = tabs_module.activeEditor(codemap)
    const text = editor.*.text[0..editor.*.length]
    var found: [4096]u32 = undefined
    var mode: u8 = 0
    var start: usize = 0
    var in_method = false
    var count: usize = 0
    unsafe { count = features.candidates(codemap.*.index, codemap.*.tabFile[tab], text, editor.*.cursor, offsetInIndex(codemap, tab), @ptrCast([*]u32, &found), 3900, &mode, &start, &in_method) }
    const typed = text[start..editor.*.cursor]
    // Only while a name is typed (or right after a dot or an @).
    if typed.length == 0 && mode == features.SCOPE && !forced { return }
    // The keywords or builtins too, as items.
    if mode != features.MEMBERS {
        const list: u32 = if mode == features.BUILTINS { 1 } else { 0 }
        const words = if mode == features.BUILTINS { features.builtins() } else { features.keywords() }
        var word_start: usize = 0
        var at: usize = 0
        while at <= words.length {
            if at == words.length || words[at] == 32 {
                if at > word_start && count < 4096 {
                    found[count] = wordItem(list, word_start, at)
                    count += 1
                }
                word_start = at + 1
            }
            at += 1
        }
    }
    // Each scored; the best 64, best first (the same score: in scope
    // order, locals first).
    var scores: [4096]u32 = undefined
    var at: usize = 0
    while at < count {
        const name = itemText(codemap, found[at])
        scores[at] = if name.length == typed.length && typed.length > 0 && access_module.sameBytes(name, typed) { 0 } else { matchScore(name, typed) }
        at += 1
    }
    codemap.*.completeStart = start
    codemap.*.completeCount = 0
    while codemap.*.completeCount < 64 {
        var best = count
        at = 0
        while at < count {
            if scores[at] > 0 && (best == count || scores[at] > scores[best]) { best = at }
            at += 1
        }
        if best == count { break }
        scores[best] = 0
        if !alreadyListed(codemap, itemText(codemap, found[best])) {
            codemap.*.completeList[codemap.*.completeCount] = found[best]
            codemap.*.completeCount += 1
        }
    }
    if codemap.*.completeCount == 0 { return }
    codemap.*.completeOpen = true
    codemap.*.completeSelected = 0
    codemap.*.completeScroll = 0
    if codemap.*.trace {
        var line: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &line) }
        var length = lists_module.writeNumberPlain(bytes, 0, codemap.*.completeCount)
        length = filters_module.writeText(bytes, length, ", first ")
        navigation_module.traceLine(codemap, "completion ", bytes[0..length])
        navigation_module.traceLine(codemap, "completion first ", itemText(codemap, codemap.*.completeList[0]))
    }
}

fn alreadyListed(codemap: *app.Codemap, name: []const u8) -> bool {
    var at: usize = 0
    while at < codemap.*.completeCount {
        if access_module.sameBytes(itemText(codemap, codemap.*.completeList[at]), name) { return true }
        at += 1
    }
    return false
}

// The chosen item in place of what was typed of it.
pub fn acceptCompletion(codemap: *app.Codemap) -> void {
    if !codemap.*.completeOpen || !tabs_module.hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    const name = itemText(codemap, codemap.*.completeList[codemap.*.completeSelected])
    var copy: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &copy) }
    const length = filters_module.writeText(bytes, 0, if name.length > 250 { name[0..250] } else { name })
    var total = length
    // A function: its parentheses (with parameters: the cursor in them,
    // and its signature shown).
    const item = codemap.*.completeList[codemap.*.completeSelected]
    var takes = false
    const is_call = item & 2147483648 == 0 && index_module.symbolAt(codemap.*.index, item).*.kind == index_module.FUNCTION
    if is_call {
        var child = index_module.symbolAt(codemap.*.index, item).*.firstChild
        while child != app.NONE {
            if index_module.symbolAt(codemap.*.index, child).*.kind == index_module.PARAM { takes = true }
            child = index_module.symbolAt(codemap.*.index, child).*.nextSibling
        }
        // Not when a ( follows already.
        const next = if editor.*.cursor < editor.*.length { editor.*.text[editor.*.cursor] } else { 0 }
        if next != 40 { total = filters_module.writeText(bytes, total, if takes { "(" } else { "()" }) }
    }
    const line_before = editor_module.lineOf(editor, editor.*.cursor)
    const lines_before = editor.*.lineCount
    editor.*.anchor = codemap.*.completeStart
    editor_module.insert(editor, bytes[0..total])
    tabs_module.shiftMarks(codemap, tab, line_before, lines_before)
    codemap.*.completeOpen = false
    if is_call && takes { codemap.*.signatureActive = true }
    if codemap.*.trace { navigation_module.traceLine(codemap, "completed ", bytes[0..total]) }
}

// The keys of the list (open); true when it took the key.
pub fn completeKey(codemap: *app.Codemap, key: u32) -> bool {
    if !codemap.*.completeOpen { return false }
    if key == app.KEY_ESCAPE {
        codemap.*.completeOpen = false
    } else if key == app.KEY_DOWN {
        if codemap.*.completeSelected + 1 < codemap.*.completeCount { codemap.*.completeSelected += 1 }
    } else if key == app.KEY_UP {
        if codemap.*.completeSelected > 0 { codemap.*.completeSelected -= 1 }
    } else if key == app.KEY_ENTER || key == app.KEY_KP_ENTER || key == app.KEY_TAB {
        acceptCompletion(codemap)
        tabs_module.keepCursorSeen(codemap)
    } else {
        return false
    }
    if codemap.*.completeSelected < codemap.*.completeScroll { codemap.*.completeScroll = codemap.*.completeSelected }
    if codemap.*.completeSelected >= codemap.*.completeScroll + 8 { codemap.*.completeScroll = codemap.*.completeSelected - 7 }
    return true
}

// The list under the cursor: each name in its kind's color, and what it is.
pub fn drawCompletion(codemap: *app.Codemap, canvas: *app.Canvas, right: i32, bottom: i32) -> void {
    if !codemap.*.completeOpen || !tabs_module.hasTab(codemap) { return }
    const slide = drawing_module.fadeIn(codemap, canvas, app.OVERLAY_COMPLETE, @intCast(u64, codemap.*.completeStart) + 1)
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    const line_y = editor_view_module.lineY(codemap, tab, editor_module.lineOf(editor, editor.*.cursor)) - slide
    const rows = if codemap.*.completeCount < 8 { codemap.*.completeCount } else { 8 }
    const width: i32 = 520
    const height = @intCast(i32, rows) * 22 + 8
    var x = codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, codemap.*.completeStart)) * codemap.*.charWidth - 30
    if x + width > right - 14 { x = right - 14 - width }
    var y = line_y + app.EDITOR_LINE + 2
    if y + height > bottom - 4 { y = line_y - height - 2 }
    canvas_module.fillRoundedRect(canvas, x + 2, y + 3, width, height, 8, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 8, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, y, width, height, 8, 1, canvas_module.color(255, 64, 68, 84))
    var row: usize = 0
    while row < rows {
        const at = codemap.*.completeScroll + row
        if at >= codemap.*.completeCount { break }
        const item = codemap.*.completeList[at]
        const row_y = y + 4 + @intCast(i32, row) * 22
        if at == codemap.*.completeSelected { canvas_module.fillRoundedRect(canvas, x + 4, row_y, width - 8, 22, 6, canvas_module.color(255, 52, 78, 130)) }
        const is_word = item & 2147483648 != 0
        const color = if is_word { app.KEYWORD_COLOR } else { editor_view_module.semanticColor(codemap, item, app.TEXT_COLOR) }
        drawing_module.drawDot(canvas, x + 12, row_y + 7, 8, filters_module.canvasColor(color, 255))
        const name = itemText(codemap, item)
        canvas_module.drawText(canvas, access_module.monoOf(codemap), name, x + 28, row_y + 3, app.TEXT_COLOR, 220)
        if !is_word {
            const record = index_module.symbolAt(codemap.*.index, item)
            // What it is: its signature (a value: its kind and type).
            const lines = access_module.hoverTextOf(codemap)
            protocol.clear(lines)
            if record.*.kind == index_module.FUNCTION {
                protocol.text(lines, features.signatureText(codemap.*.index, item))
            } else if record.*.kind == index_module.IMPORT && record.*.target != app.NONE {
                protocol.text(lines, access_module.say(codemap, "module ", "Modul "))
                protocol.text(lines, programs_module.relativePath(codemap.*.index, index_module.symbolAt(codemap.*.index, record.*.target).*.file))
            } else if record.*.kind == index_module.FIELD || record.*.kind == index_module.PARAM || record.*.kind == index_module.MEMBER {
                // As declared (name: Type).
                protocol.text(lines, features.signatureText(codemap.*.index, item))
            } else if !features.typePlace(lines, codemap.*.index, item) {
                protocol.text(lines, index_module.kindName(record.*.kind))
            }
            canvas_module.drawText(canvas, access_module.smallOf(codemap), protocol.contents(lines), x + 256, row_y + 5, app.DIM_COLOR, width - 268)
        } else {
            canvas_module.drawText(canvas, access_module.smallOf(codemap), if item & 1073741824 != 0 { "builtin" } else { "keyword" }, x + 256, row_y + 5, app.DIM_COLOR, width - 268)
        }
        row += 1
    }
    // The chosen item's doc: where it is, its signature, its doc comment.
    const chosen = codemap.*.completeList[codemap.*.completeSelected]
    if chosen & 2147483648 != 0 { return }
    const index = codemap.*.index
    var doc_start: usize = 0
    var doc_length: usize = 0
    index_module.docRange(index, chosen, &doc_start, &doc_length)
    const source = index_module.sourceOf(index, index_module.symbolAt(index, chosen).*.file)
    const doc = source[doc_start..doc_start + (if doc_length > 3000 { 3000 } else { doc_length })]
    var side_x = x + width + 6
    var side_width: i32 = 380
    var side_y = y
    if side_x + side_width > right - 8 {
        // No room at the side: under the list.
        side_x = x
        side_width = width
        side_y = y + height + 6
    }
    const inner = side_width - 24
    const lines = access_module.hoverTextOf(codemap)
    protocol.clear(lines)
    features.owner(lines, index, chosen)
    var signature_start: usize = 0
    var signature_length: usize = 0
    index_module.signatureRange(index, chosen, &signature_start, &signature_length)
    const signature = source[signature_start..signature_start + (if signature_length > 300 { 300 } else { signature_length })]
    const code_height = drawCode(codemap, canvas, signature, 0, 0, inner, false)
    const doc_height = if doc_length > 0 { drawDoc(codemap, canvas, doc, 0, 0, inner, 10, false) + 10 } else { 0 }
    const side_height = 10 + 20 + code_height + doc_height + 8
    if side_y + side_height > bottom - 4 { return }
    canvas_module.fillRoundedRect(canvas, side_x + 2, side_y + 3, side_width, side_height, 8, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, side_x, side_y, side_width, side_height, 8, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, side_x, side_y, side_width, side_height, 8, 1, canvas_module.color(255, 64, 68, 84))
    canvas_module.drawText(canvas, access_module.smallOf(codemap), protocol.contents(lines), side_x + 12, side_y + 10, app.DIM_COLOR, inner)
    var at_y = side_y + 30
    at_y += drawCode(codemap, canvas, signature, side_x + 12, at_y, inner, true)
    if doc_length > 0 {
        canvas_module.fillRect(canvas, side_x + 1, at_y + 4, side_width - 2, 1, canvas_module.color(255, 52, 56, 68))
        const drawn = drawDoc(codemap, canvas, doc, side_x + 12, at_y + 10, inner, 10, true)
    }
}

// Above the cursor in a call: the function's signature, the argument the
// cursor is at lit, its doc comment's first line.
pub fn drawSignatureHelp(codemap: *app.Codemap, canvas: *app.Canvas, right: i32) -> void {
    if !codemap.*.signatureActive || !tabs_module.hasTab(codemap) || !codemap.*.built { return }
    const tab = codemap.*.activeTab
    if codemap.*.tabFile[tab] == app.NONE { return }
    const editor = tabs_module.activeEditor(codemap)
    const index = codemap.*.index
    var argument: usize = 0
    const function = features.callAt(index, codemap.*.tabFile[tab], editor.*.text[0..editor.*.length], editor.*.cursor, offsetInIndex(codemap, tab), &argument)
    if function == app.NONE {
        codemap.*.signatureActive = false
        return
    }
    const slide = drawing_module.fadeIn(codemap, canvas, app.OVERLAY_SIGNATURE, @intCast(u64, function) + 1)
    const label = features.signatureText(index, function)
    const shown = if label.length > 160 { label[0..160] } else { label }
    // The argument's part of the label: the nth parameter's "name: Type".
    const signature_start = index_module.declarationOffset(index, function)
    const source = index_module.sourceOf(index, index_module.symbolAt(index, function).*.file)
    var from: usize = 0
    var to: usize = 0
    var nth: usize = 0
    var child = index_module.symbolAt(index, function).*.firstChild
    while child != app.NONE {
        const record = index_module.symbolAt(index, child)
        if record.*.kind == index_module.PARAM {
            if nth == argument {
                from = @intCast(usize, record.*.nameStart)
                to = from
                var level: usize = 0
                while to < source.length && !((source[to] == 44 || source[to] == 41) && level == 0) {
                    if source[to] == 40 || source[to] == 91 { level += 1 }
                    if (source[to] == 41 || source[to] == 93) && level > 0 { level -= 1 }
                    to += 1
                }
            }
            nth += 1
        }
        child = record.*.nextSibling
    }
    const mono = access_module.monoOf(codemap)
    const cw = codemap.*.charWidth
    var width = @intCast(i32, shown.length) * cw + 24
    if width > right - codemap.*.editorLeft - 20 { width = right - codemap.*.editorLeft - 20 }
    const line_y = editor_view_module.lineY(codemap, tab, editor_module.lineOf(editor, editor.*.cursor))
    var x = codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, editor.*.cursor)) * cw - 40
    if x + width > right - 14 { x = right - 14 - width }
    if x < codemap.*.editorLeft { x = codemap.*.editorLeft }
    const y = (if line_y - 30 >= editor_view_module.editorCodeTop() { line_y - 30 } else { line_y + app.EDITOR_LINE + 4 }) - slide
    canvas_module.fillRoundedRect(canvas, x + 2, y + 3, width, 26, 7, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, 26, 7, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, y, width, 26, 7, 1, canvas_module.color(255, 64, 68, 84))
    if to > from && from >= signature_start && to - signature_start <= shown.length {
        const lit_x = x + 12 + @intCast(i32, from - signature_start) * cw
        canvas_module.fillRoundedRect(canvas, lit_x - 2, y + 4, @intCast(i32, to - from) * cw + 4, 18, 4, filters_module.canvasColor(app.ACCENT, 90))
    }
    canvas_module.drawText(canvas, mono, shown, x + 12, y + 5, app.TEXT_COLOR, width - 20)
}

// ---------------------------------------------------------------------------
// Renaming (F2): every use the index knows, in every file

// F2: a field over the name at the cursor, with the name in it.
pub fn startRename(codemap: *app.Codemap) -> void {
    if !tabs_module.hasTab(codemap) || !codemap.*.built { return }
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    if editor_module.isDirty(editor) {
        access_module.setNote(codemap, access_module.say(codemap, "Rename: save the file first (Ctrl+S)", "Umbenennen: erst die Datei speichern (Strg+S)"), "")
        return
    }
    if !tabs_module.tabIndexedNow(codemap, tab) {
        access_module.setNote(codemap, access_module.say(codemap, "Rename: the file changed since the map read it; show the map once (Ctrl+E) and come back", "Umbenennen: die Datei hat sich geändert, seit die Karte sie las; einmal die Karte zeigen (Strg+E) und zurück"), "")
        return
    }
    const ref = index_module.refAtOffset(codemap.*.index, codemap.*.tabFile[tab], editor.*.cursor)
    if ref == index_module.MAX_REFS {
        access_module.setNote(codemap, access_module.say(codemap, "Rename: no name here", "Umbenennen: hier ist kein Name"), "")
        return
    }
    const value = index_module.refAt(codemap.*.index, ref)
    const symbol = value.*.symbol
    const kind = index_module.symbolAt(codemap.*.index, symbol).*.kind
    if kind == index_module.FILE {
        access_module.setNote(codemap, access_module.say(codemap, "Rename: a file is not renamed here", "Umbenennen: eine Datei wird hier nicht umbenannt"), "")
        return
    }
    codemap.*.renameSymbol = symbol
    codemap.*.renameStart = @intCast(usize, value.*.start)
    const name = index_module.nameOf(codemap.*.index, symbol)
    codemap.*.renameLength = filters_module.writeText(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "renameText")), 0, if name.length > 120 { name[0..120] } else { name })
    codemap.*.renameOpen = true
    codemap.*.completeOpen = false
}

pub fn renameKey(codemap: *app.Codemap, key: u32) -> bool {
    if !codemap.*.renameOpen { return false }
    if key == app.KEY_ESCAPE {
        codemap.*.renameOpen = false
        return true
    }
    if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        codemap.*.renameOpen = false
        applyRename(codemap, access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "renameText"))[0..codemap.*.renameLength])
        return true
    }
    if key == app.KEY_BACKSPACE {
        if codemap.*.renameLength > 0 { codemap.*.renameLength -= 1 }
        return true
    }
    const panel = access_module.panelOf(codemap)
    if panel.*.textLength == 0 || access_module.modifiers(codemap) & (app.CONTROL | app.ALT) != 0 { return true }
    var at: usize = 0
    while at < panel.*.textLength && codemap.*.renameLength < 120 {
        const byte = panel.*.text[at]
        if isNameByte(byte) {
            codemap.*.renameText[codemap.*.renameLength] = byte
            codemap.*.renameLength += 1
        }
        at += 1
    }
    return true
}

// The field over the name.
pub fn drawRename(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    if !codemap.*.renameOpen || !tabs_module.hasTab(codemap) { return }
    const slide = drawing_module.fadeIn(codemap, canvas, app.OVERLAY_RENAME, @intCast(u64, codemap.*.renameSymbol) + 1)
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    const line = editor_module.lineOf(editor, codemap.*.renameStart)
    const y = editor_view_module.lineY(codemap, tab, line)
    const x = codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, codemap.*.renameStart)) * codemap.*.charWidth
    const text = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "renameText"))[0..codemap.*.renameLength]
    const width = (if text.length > 12 { @intCast(i32, text.length) } else { 12 }) * codemap.*.charWidth + 16
    canvas_module.fillRoundedRect(canvas, x - 6, y - 2, width, app.EDITOR_LINE + 4, 5, canvas_module.color(255, 22, 24, 30))
    canvas_module.strokeRoundedRect(canvas, x - 7, y - 3, width + 2, app.EDITOR_LINE + 6, 6, 2, app.ACCENT)
    canvas_module.drawText(canvas, access_module.monoOf(codemap), text, x, y + 2, app.TEXT_COLOR, 0)
    canvas_module.fillRect(canvas, x + @intCast(i32, text.length) * codemap.*.charWidth + 1, y + 1, 2, app.EDITOR_LINE - 2, app.ACCENT)
    const hint = access_module.say(codemap, "Enter renames everywhere, Esc keeps it", "Enter benennt überall um, Esc lässt es")
    canvas_module.fillRoundedRect(canvas, x - 7, y + app.EDITOR_LINE + 4, canvas_module.measure(access_module.smallOf(codemap), hint) + 14, 20, 5, canvas_module.color(250, 30, 32, 41))
    canvas_module.drawText(canvas, access_module.smallOf(codemap), hint, x, y + app.EDITOR_LINE + 7, app.DIM_COLOR, 0)
}

// Every use of the symbol (its declaration too) gets the new name, in the
// files (the tabs of them read them again), then the code is read again.
pub fn applyRename(codemap: *app.Codemap, name: []const u8) -> void {
    const index = codemap.*.index
    const symbol = codemap.*.renameSymbol
    const old = index_module.nameOf(index, symbol)
    if name.length == 0 || !editor_view_module.isNameStart(name[0]) || access_module.sameBytes(name, old) { return }
    // The files: none may have changed since the index read it, and no tab
    // of one may hold edits.
    var files: [256]u32 = undefined
    var file_count: usize = 0
    var places: usize = 0
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol {
            places += 1
            var known = false
            var at: usize = 0
            while at < file_count {
                if files[at] == value.*.file { known = true }
                at += 1
            }
            if !known {
                if file_count == 256 {
                    access_module.setNote(codemap, access_module.say(codemap, "Rename: in more than 256 files, not here", "Umbenennen: in mehr als 256 Dateien, nicht hier"), "")
                    return
                }
                files[file_count] = value.*.file
                file_count += 1
            }
        }
        ref += 1
    }
    var at: usize = 0
    while at < file_count {
        const path = index_module.pathOf(index, files[at])
        // (A tab of it whose text the index read again, saved, is as new.)
        var fresh = false
        var open: usize = 0
        while open < codemap.*.tabCount {
            if access_module.sameBytes(editor_module.pathOf(access_module.editorAt(codemap, open)), path) && tabs_module.tabIndexedNow(codemap, open) && !editor_module.isDirty(access_module.editorAt(codemap, open)) { fresh = true }
            open += 1
        }
        if !fresh && tabs_module.fileStamp(path) > codemap.*.diskStamp {
            access_module.setNote(codemap, access_module.say(codemap, "Rename: a file changed since the map read it: ", "Umbenennen: eine Datei hat sich geändert, seit die Karte sie las: "), programs_module.relativePath(index, files[at]))
            return
        }
        var tab: usize = 0
        while tab < codemap.*.tabCount {
            if access_module.sameBytes(editor_module.pathOf(access_module.editorAt(codemap, tab)), path) && editor_module.isDirty(access_module.editorAt(codemap, tab)) {
                access_module.setNote(codemap, access_module.say(codemap, "Rename: save the tab first: ", "Umbenennen: erst den Tab speichern: "), programs_module.relativePath(index, files[at]))
                return
            }
            tab += 1
        }
        at += 1
    }
    // Each file: its text with the name replaced at each use (in order).
    at = 0
    var written: usize = 0
    while at < file_count {
        const file = files[at]
        const source = index_module.sourceOf(index, file)
        const capacity = source.length + places * (if name.length > old.length { name.length - old.length } else { 0 }) + 16
        const memory = codemap.*.allocator.alloc(capacity, 16)
        if memory == null { return }
        const out = memory.?
        var length: usize = 0
        var copied: usize = 0
        var use: usize = index_module.fileAt(index, file).*.refStart
        while use < index_module.fileAt(index, file).*.refEnd {
            const value = index_module.refAt(index, use)
            const start = @intCast(usize, value.*.start)
            if value.*.symbol == symbol && start >= copied && start + old.length <= source.length && access_module.sameBytes(source[start..start + old.length], old) {
                length = filters_module.writeText(out, length, source[copied..start])
                length = filters_module.writeText(out, length, name)
                copied = start + old.length
            }
            use += 1
        }
        length = filters_module.writeText(out, length, source[copied..source.length])
        var path_buffer: [1100]u8 = undefined
        var path_bytes: [*]u8 = undefined
        unsafe { path_bytes = @ptrCast([*]u8, &path_buffer) }
        const path_length = filters_module.writeText(path_bytes, 0, index_module.pathOf(index, file))
        path_bytes[path_length] = 0
        // O_WRONLY | O_CREAT | O_TRUNC
        const handle = std.fs.open(path_bytes, 577, 420)
        if std.fs.isValid(handle) {
            if std.fs.writeAllBytes(handle, out, length) { written += 1 }
            const closed = std.fs.close(handle)
        }
        codemap.*.allocator.free(out, capacity, 16)
        at += 1
    }
    // The tabs of those files read them again, the index reads the code.
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        codemap.*.tabStamp[tab] = -2
        tab += 1
    }
    tabs_module.watchDiskTabs(codemap)
    navigation_module.reload(codemap)
    var text: [160]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeNumber(codemap, bytes, 0, places)
    length = filters_module.writeText(bytes, length, if places == 1 { access_module.say(codemap, " place in ", " Stelle in ") } else { access_module.say(codemap, " places in ", " Stellen in ") })
    length = filters_module.writeNumber(codemap, bytes, length, written)
    length = filters_module.writeText(bytes, length, if written == 1 { access_module.say(codemap, " file: ", " Datei: ") } else { access_module.say(codemap, " files: ", " Dateien: ") })
    length = filters_module.writeText(bytes, length, if name.length > 60 { name[0..60] } else { name })
    access_module.setNote(codemap, access_module.say(codemap, "Renamed ", "Umbenannt: "), bytes[0..length])
    if codemap.*.trace { navigation_module.traceLine(codemap, "renamed ", bytes[0..length]) }
}

// ---------------------------------------------------------------------------
// Blame on the line numbers: who wrote the line, when, in which commit

fn secondsNow() -> i64 {
    var time: [2]i64 = [2]i64{ 0, 0 }
    // clock_gettime(CLOCK_REALTIME)
    unsafe { const got = std.linux.syscall2(228, 0, @intFromPtr(&time)) }
    return time[0]
}

// The blame of a line of the tab shown (git blame -L N,N), kept until the
// pointer is on another line.
pub fn blameLine(codemap: *app.Codemap, tab: usize, line: usize) -> []const u8 {
    const editor = access_module.editorAt(codemap, tab)
    if codemap.*.blameTab == tab && codemap.*.blameLineNumber == line && codemap.*.blameVersion == editor.*.version {
        return access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "blameText"))[0..codemap.*.blameLength]
    }
    codemap.*.blameTab = tab
    codemap.*.blameLineNumber = line
    codemap.*.blameVersion = editor.*.version
    const into = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "blameText"))
    codemap.*.blameLength = 0
    if editor_module.isDirty(editor) {
        codemap.*.blameLength = filters_module.writeText(into, 0, access_module.say(codemap, "Edited: saved, Git can say who wrote the line", "Geändert: gespeichert kann Git sagen, wer die Zeile schrieb"))
        return into[0..codemap.*.blameLength]
    }
    const git = access_module.gitOf(codemap)
    if !git_module.usable(git) { return "" }
    var number: [32]u8 = undefined
    var number_bytes: [*]u8 = undefined
    unsafe { number_bytes = @ptrCast([*]u8, &number) }
    var number_length = lists_module.writeNumberPlain(number_bytes, 0, line + 1)
    number_length = filters_module.writeText(number_bytes, number_length, ",")
    number_length = lists_module.writeNumberPlain(number_bytes, number_length, line + 1)
    git_module.begin(git)
    git_module.more(git, "blame --porcelain -L ")
    git_module.more(git, number_bytes[0..number_length])
    git_module.more(git, " -- ")
    git_module.addQuoted(git, editor_module.pathOf(editor))
    const output = git_module.finish(git)
    if output.length < 40 { return "" }
    // The commit, its author, time and summary.
    const hash = output[0..7]
    const uncommitted = access_module.sameBytes(output[0..8], "00000000")
    // (Where the author and the summary are: a slice set again would keep
    // its first length.)
    var author_start: usize = 0
    var author_end: usize = 0
    var summary_start: usize = 0
    var summary_end: usize = 0
    var time: i64 = 0
    var at: usize = 0
    while at < output.length {
        var end = at
        while end < output.length && output[end] != 10 { end += 1 }
        const row = output[at..end]
        if row.length > 7 && access_module.sameBytes(row[0..7], "author ") {
            author_start = at + 7
            author_end = end
        }
        if row.length > 8 && access_module.sameBytes(row[0..8], "summary ") {
            summary_start = at + 8
            summary_end = end
        }
        if row.length > 12 && access_module.sameBytes(row[0..12], "author-time ") { time = @intCast(i64, tabs_module.parseDigits(row, 12)) }
        at = end + 1
    }
    const author = output[author_start..author_end]
    const summary = output[summary_start..summary_end]
    var length: usize = 0
    if uncommitted {
        length = filters_module.writeText(into, 0, access_module.say(codemap, "Not committed yet", "Noch nicht committet"))
    } else {
        length = filters_module.writeText(into, 0, hash)
        length = filters_module.writeText(into, length, " · ")
        length = filters_module.writeText(into, length, if author.length > 40 { author[0..40] } else { author })
        length = filters_module.writeText(into, length, " · ")
        const ago = secondsNow() - time
        const days = if ago > 0 { @intCast(usize, ago) / 86400 } else { 0 }
        if days == 0 {
            length = filters_module.writeText(into, length, access_module.say(codemap, "today", "heute"))
        } else if days < 60 {
            length = lists_module.writeNumberPlain(into, length, days)
            length = filters_module.writeText(into, length, if days == 1 { access_module.say(codemap, " day ago", " Tag her") } else { access_module.say(codemap, " days ago", " Tage her") })
        } else {
            length = lists_module.writeNumberPlain(into, length, days / 30)
            length = filters_module.writeText(into, length, access_module.say(codemap, " months ago", " Monate her"))
        }
        length = filters_module.writeText(into, length, " · ")
        length = filters_module.writeText(into, length, if summary.length > 120 { summary[0..120] } else { summary })
    }
    codemap.*.blameLength = length
    return into[0..length]
}

// Over a line number: who wrote the line.
pub fn drawBlame(codemap: *app.Codemap, canvas: *app.Canvas, right: i32) -> void {
    if codemap.*.gutterHover == 18446744073709551615 || !tabs_module.hasTab(codemap) || codemap.*.hover != app.HIT_EDITOR { return }
    const tab = codemap.*.activeTab
    const line = codemap.*.gutterHover
    if line >= tabs_module.activeEditor(codemap).*.lineCount { return }
    const text = blameLine(codemap, tab, line)
    if text.length == 0 { return }
    const slide = drawing_module.fadeIn(codemap, canvas, app.OVERLAY_BLAME, @intCast(u64, line) + 1)
    const y = editor_view_module.lineY(codemap, tab, line) - slide
    const width = canvas_module.measure(access_module.smallOf(codemap), text) + 20
    const x = app.SIDEBAR + 8
    const box_y = if y + app.EDITOR_LINE + 30 < editor_view_module.editorBottom(codemap) { y + app.EDITOR_LINE + 2 } else { y - 28 }
    canvas_module.fillRoundedRect(canvas, x + 2, box_y + 3, (if width < right - x - 12 { width } else { right - x - 12 }), 26, 7, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, box_y, (if width < right - x - 12 { width } else { right - x - 12 }), 26, 7, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, box_y, (if width < right - x - 12 { width } else { right - x - 12 }), 26, 7, 1, canvas_module.color(255, 64, 68, 84))
    canvas_module.drawText(canvas, access_module.smallOf(codemap), text, x + 10, box_y + 6, app.TEXT_COLOR, right - x - 32)
}

// ---------------------------------------------------------------------------
// Code and doc comments, set like an editor's hover (rust-analyzer's)

// Code in the editor's colors, wrapped at `width` (a wrapped line goes on
// four columns in); its height. Nothing is drawn when `draw` is false.
pub fn drawCode(codemap: *app.Codemap, canvas: *app.Canvas, text: []const u8, x: i32, y: i32, width: i32, draw: bool) -> i32 {
    const mono = access_module.monoOf(codemap)
    const cw = codemap.*.charWidth
    var at_y = y
    var line_start: usize = 0
    while line_start <= text.length {
        // Line by line (a comment ends with its line).
        var line_end = line_start
        while line_end < text.length && text[line_end] != 10 { line_end += 1 }
        const line = text[line_start..line_end]
        var at_x = x
        var at: usize = 0
        while at < line.length {
            var kind: u8 = 0
            const end = editor_module.token(line, at, &kind)
            const piece = line[at..end]
            const piece_width = @intCast(i32, piece.length) * cw
            if at_x + piece_width > x + width && at_x > x + 4 * cw && piece[0] != 32 {
                at_x = x + 4 * cw
                at_y += app.EDITOR_LINE
            }
            if draw && piece[0] != 32 { canvas_module.drawText(canvas, mono, piece, at_x, at_y + 2, filters_module.canvasColor(editor_view_module.tokenColor(kind), 255), x + width - at_x) }
            at_x += piece_width
            at = end
        }
        at_y += app.EDITOR_LINE
        line_start = line_end + 1
    }
    return at_y - y
}

// A container's declaration with its fields or members, one a line (the
// first 12); 0 when it is none.
pub fn writeShape(codemap: *app.Codemap, into: [*]u8, symbol: u32, head: []const u8) -> usize {
    const index = codemap.*.index
    const kind = index_module.symbolAt(index, symbol).*.kind
    if kind != index_module.STRUCT && kind != index_module.ENUM && kind != index_module.UNION && kind != index_module.ERROR_SET { return 0 }
    var length = filters_module.writeText(into, 0, if head.length > 300 { head[0..300] } else { head })
    length = filters_module.writeText(into, length, " {")
    var shown: usize = 0
    var more: usize = 0
    var child = index_module.symbolAt(index, symbol).*.firstChild
    while child != app.NONE {
        const record = index_module.symbolAt(index, child)
        if record.*.kind == index_module.FIELD || record.*.kind == index_module.MEMBER {
            if shown < 12 {
                var start: usize = 0
                var size: usize = 0
                index_module.signatureRange(index, child, &start, &size)
                const source = index_module.sourceOf(index, record.*.file)
                length = filters_module.writeText(into, length, "\n    ")
                length = filters_module.writeText(into, length, if size > 0 && size < 120 { source[start..start + size] } else { index_module.nameOf(index, child) })
                shown += 1
            } else {
                more += 1
            }
        }
        child = record.*.nextSibling
    }
    if more > 0 {
        length = filters_module.writeText(into, length, "\n    // ")
        length = lists_module.writeNumberPlain(into, length, more)
        length = filters_module.writeText(into, length, access_module.say(codemap, " more", " weitere"))
    }
    length = filters_module.writeText(into, length, "\n}")
    return length
}

// A doc comment's text (its `//` taken off) set as paragraphs: lines of
// a paragraph run together, `code` in the code font, "- " items, lines
// set in four columns as code; at most `most` lines. Its height.
pub fn drawDoc(codemap: *app.Codemap, canvas: *app.Canvas, doc: []const u8, x: i32, y: i32, width: i32, most: usize, draw: bool) -> i32 {
    const small = access_module.smallOf(codemap)
    const mono = access_module.monoOf(codemap)
    const line_height: i32 = 17
    const space = canvas_module.measure(small, " ")
    var at_x = x
    var at_y = y
    var lines: usize = 1
    var in_code = false
    var paragraph_open = false
    var start: usize = 0
    while start < doc.length && lines <= most {
        var end = start
        while end < doc.length && doc[end] != 10 { end += 1 }
        // The line without its blanks, // and one space.
        var from = start
        while from < end && (doc[from] == 32 || doc[from] == 9) { from += 1 }
        if from + 1 < end + 1 && from < end && doc[from] == 47 { from += 1 }
        if from < end && doc[from] == 47 { from += 1 }
        if from < end && doc[from] == 32 { from += 1 }
        const line = doc[from..end]
        var blank = true
        for byte in line {
            if byte != 32 { blank = false }
        }
        if blank {
            // A paragraph ends: a little space.
            if paragraph_open {
                at_y += line_height + 4
                at_x = x
                lines += 1
                paragraph_open = false
            }
        } else if line.length > 4 && line[0] == 32 && line[1] == 32 && line[2] == 32 && line[3] == 32 {
            // Code, as it is.
            if paragraph_open {
                at_y += line_height
                lines += 1
            }
            if draw && lines <= most { canvas_module.drawText(canvas, mono, line[4..line.length], x + 8, at_y + 1, filters_module.canvasColor(app.STRING_COLOR, 235), width - 8) }
            at_y += line_height
            at_x = x
            lines += 1
            paragraph_open = false
        } else {
            var word_start: usize = 0
            if line.length > 2 && (line[0] == 45 || line[0] == 42) && line[1] == 32 {
                // An item: on a line of its own, a dot before it.
                if paragraph_open {
                    at_y += line_height
                    lines += 1
                }
                if draw && lines <= most { canvas_module.drawText(canvas, small, "•", x + 2, at_y, filters_module.canvasColor(app.DIM_COLOR, 255), 0) }
                at_x = x + 14
                word_start = 2
            }
            paragraph_open = true
            // Word by word; `...` in the code font.
            var at = word_start
            while at <= line.length && lines <= most {
                if at == line.length || line[at] == 32 {
                    if at > word_start {
                        var word = line[word_start..at]
                        var opens = false
                        var closes = false
                        var first: usize = 0
                        var last = word.length
                        if word[0] == 96 {
                            opens = true
                            first = 1
                        }
                        var tick = first
                        while tick < last {
                            if word[tick] == 96 {
                                closes = true
                                break
                            }
                            tick += 1
                        }
                        const coded = in_code || opens
                        const shown = if closes { if tick > first { word[first..tick] } else { word[first..first] } } else { word[first..last] }
                        const after = if closes && tick + 1 < last { word[tick + 1..last] } else { word[0..0] }
                        const font = if coded { mono } else { small }
                        const shown_width = canvas_module.measure(font, shown) + canvas_module.measure(small, after)
                        if at_x + shown_width > x + width && at_x > x + 14 {
                            at_x = x
                            at_y += line_height
                            lines += 1
                        }
                        if draw && lines <= most {
                            canvas_module.drawText(canvas, font, shown, at_x, at_y + (if coded { 1 } else { 0 }), if coded { filters_module.canvasColor(app.CALL_COLOR, 255) } else { filters_module.canvasColor(app.TEXT_COLOR, 225) }, 0)
                            if after.length > 0 { canvas_module.drawText(canvas, small, after, at_x + canvas_module.measure(font, shown), at_y, filters_module.canvasColor(app.TEXT_COLOR, 225), 0) }
                        }
                        at_x += shown_width + space
                        if opens { in_code = true }
                        if closes { in_code = false }
                    }
                    word_start = at + 1
                }
                at += 1
            }
        }
        start = end + 1
    }
    return at_y + line_height - y
}

// ---------------------------------------------------------------------------
// Folding: a block's body (a function's, a struct's, ...) hidden behind its
// first line. Each tab keeps its folds as pairs of lines (the line that
// opens the block, the line that closes it); the lines after the first up
// to the last are not shown.

fn foldsOf(codemap: *app.Codemap, tab: usize) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, codemap.*.tabFolds[tab]) }
}

// The last line of the fold that starts on `line` (none: MAX).
pub fn foldEndAt(codemap: *app.Codemap, tab: usize, line: usize) -> usize {
    const folds = foldsOf(codemap, tab)
    var at: usize = 0
    while at < codemap.*.tabFoldCount[tab] {
        if @intCast(usize, folds[at * 2]) == line { return @intCast(usize, folds[at * 2 + 1]) }
        at += 1
    }
    return 18446744073709551615
}

// The first line of the outermost fold `line` is hidden in (not hidden:
// MAX).
pub fn hiddenIn(codemap: *app.Codemap, tab: usize, line: usize) -> usize {
    const folds = foldsOf(codemap, tab)
    var outer: usize = 18446744073709551615
    var at: usize = 0
    while at < codemap.*.tabFoldCount[tab] {
        const first = @intCast(usize, folds[at * 2])
        if first < line && line <= @intCast(usize, folds[at * 2 + 1]) && (outer == 18446744073709551615 || first < outer) { outer = first }
        at += 1
    }
    return outer
}

// The line shown after `line` (past its fold).
pub fn nextShown(codemap: *app.Codemap, tab: usize, line: usize) -> usize {
    if codemap.*.tabFoldCount[tab] == 0 { return line + 1 }
    const end = foldEndAt(codemap, tab, line)
    return if end == 18446744073709551615 { line + 1 } else { end + 1 }
}

// The line itself, or the first line of the fold it is hidden in.
pub fn shownLine(codemap: *app.Codemap, tab: usize, line: usize) -> usize {
    if codemap.*.tabFoldCount[tab] == 0 { return line }
    const first = hiddenIn(codemap, tab, line)
    return if first == 18446744073709551615 { line } else { first }
}

// How a line changes the depth of braces (strings and comments left
// out); > 0: it opens a block.
pub fn braceDepth(text: []const u8) -> isize {
    var depth: isize = 0
    var at: usize = 0
    while at < text.length {
        const byte = text[at]
        if byte == 47 && at + 1 < text.length && text[at + 1] == 47 { break }
        if byte == 34 {
            at += 1
            while at < text.length && text[at] != 34 {
                if text[at] == 92 { at += 1 }
                at += 1
            }
        } else if byte == 123 {
            depth += 1
        } else if byte == 125 {
            depth -= 1
        }
        at += 1
    }
    return depth
}

// The line that closes the block `line` opens (none: MAX).
fn blockEnd(editor: *editor_module.Editor, line: usize) -> usize {
    var depth = braceDepth(editor_module.lineText(editor, line))
    if depth <= 0 { return 18446744073709551615 }
    var at = line + 1
    while at < editor.*.lineCount {
        depth += braceDepth(editor_module.lineText(editor, at))
        if depth <= 0 { return at }
        at += 1
    }
    return 18446744073709551615
}

// Folds the block `line` opens, or opens it again.
pub fn toggleFold(codemap: *app.Codemap, tab: usize, line: usize) -> void {
    const folds = foldsOf(codemap, tab)
    var at: usize = 0
    while at < codemap.*.tabFoldCount[tab] {
        if @intCast(usize, folds[at * 2]) == line {
            // Open again: the last fold takes its place.
            const last = codemap.*.tabFoldCount[tab] - 1
            folds[at * 2] = folds[last * 2]
            folds[at * 2 + 1] = folds[last * 2 + 1]
            codemap.*.tabFoldCount[tab] = last
            if codemap.*.trace { traceFold(codemap, "unfolded ", line) }
            return
        }
        at += 1
    }
    const end = blockEnd(access_module.editorAt(codemap, tab), line)
    if end == 18446744073709551615 || end <= line { return }
    if codemap.*.tabFolds[tab] == 0 { codemap.*.tabFolds[tab] = @intFromPtr(codemap.*.allocator.alloc(512 * 8, 16).?) }
    if codemap.*.tabFoldCount[tab] >= 512 { return }
    const fresh = foldsOf(codemap, tab)
    fresh[codemap.*.tabFoldCount[tab] * 2] = @intCast(u32, line)
    fresh[codemap.*.tabFoldCount[tab] * 2 + 1] = @intCast(u32, end)
    codemap.*.tabFoldCount[tab] += 1
    // The cursor inside: to the first line.
    const editor = access_module.editorAt(codemap, tab)
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    if cursor_line > line && cursor_line <= end { editor_module.moveTo(editor, editor_module.lineStart(editor, line) + editor_module.lineText(editor, line).length, false) }
    if codemap.*.trace { traceFold(codemap, "folded ", line) }
}

fn traceFold(codemap: *app.Codemap, what: []const u8, line: usize) -> void {
    var text: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = lists_module.writeNumberPlain(bytes, 0, line + 1)
    navigation_module.traceLine(codemap, what, bytes[0..length])
}

// The innermost block around the cursor folded (Ctrl+Shift+[).
pub fn foldAtCursor(codemap: *app.Codemap) -> void {
    if !tabs_module.hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    var line = cursor_line + 1
    while line > 0 {
        line -= 1
        if foldEndAt(codemap, tab, line) == 18446744073709551615 {
            const end = blockEnd(editor, line)
            if end != 18446744073709551615 && end >= cursor_line {
                toggleFold(codemap, tab, line)
                tabs_module.keepCursorSeen(codemap)
                return
            }
        }
    }
}

// The folds the cursor's line is in opened (Ctrl+Shift+], or the cursor
// moved into one).
pub fn unfoldAtCursor(codemap: *app.Codemap) -> void {
    if !tabs_module.hasTab(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = tabs_module.activeEditor(codemap)
    const cursor_line = editor_module.lineOf(editor, editor.*.cursor)
    var changed = true
    while changed {
        changed = false
        const folds = foldsOf(codemap, tab)
        var at: usize = 0
        while at < codemap.*.tabFoldCount[tab] {
            const first = @intCast(usize, folds[at * 2])
            if first <= cursor_line && cursor_line <= @intCast(usize, folds[at * 2 + 1]) {
                toggleFold(codemap, tab, first)
                changed = true
                break
            }
            at += 1
        }
    }
}

// Folds follow the lines added or taken out above them; one an edit is
// inside opens.
pub fn shiftFolds(codemap: *app.Codemap, tab: usize, line: usize, before: usize, now: usize) -> void {
    const folds = foldsOf(codemap, tab)
    var at: usize = 0
    while at < codemap.*.tabFoldCount[tab] {
        const first = @intCast(usize, folds[at * 2])
        const last = @intCast(usize, folds[at * 2 + 1])
        if line > first && line <= last {
            const end = codemap.*.tabFoldCount[tab] - 1
            folds[at * 2] = folds[end * 2]
            folds[at * 2 + 1] = folds[end * 2 + 1]
            codemap.*.tabFoldCount[tab] = end
        } else {
            if first > line {
                if now > before { folds[at * 2] = @intCast(u32, first + (now - before)) } else if first >= line + (before - now) { folds[at * 2] = @intCast(u32, first - (before - now)) }
                if now > before { folds[at * 2 + 1] = @intCast(u32, last + (now - before)) } else if last >= line + (before - now) { folds[at * 2 + 1] = @intCast(u32, last - (before - now)) }
            }
            at += 1
        }
    }
}
