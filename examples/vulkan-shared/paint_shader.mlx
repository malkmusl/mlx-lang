// The paint shader, the desktop apps' canvas on the GPU: part of
// shaders.mlx, which describes its push constants and commands.
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")
const compute = @import("std.spirv.compute")
const shaders = @import("./shaders.mlx")

// ---------------------------------------------------------------------------
// paint

// `a < b ? a : b` and the like, on signed values.
fn smallerInt(b: *builder.Builder, common: *const shaders.Common, a: u32, c: u32) -> u32 {
    return compute.select(b, common.*.int, builder.binary(b, spv.Op.sLessThan, common.*.boolean, a, c), a, c)
}

fn smallerUint(b: *builder.Builder, common: *const shaders.Common, a: u32, c: u32) -> u32 {
    return compute.select(b, common.*.uint, builder.binary(b, spv.Op.uLessThan, common.*.boolean, a, c), a, c)
}

// canvas.over: `color` (premultiplied) at `coverage` (0-255) over `under`.
fn emitOver(b: *builder.Builder, common: *const shaders.Common, under: u32, color: u32, coverage: u32) -> u32 {
    const c255 = compute.constant(b, common, 255)
    const c127 = compute.constant(b, common, 127)
    const partial = builder.binary(b, spv.Op.uLessThan, common.*.boolean, coverage, c255)
    var scaled: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    var index: u32 = 0
    while index < 4 {
        const value = compute.channel(b, common, color, 24 - index * 8)
        const reduced = builder.binary(b, spv.Op.uDiv, common.*.uint, builder.binary(b, spv.Op.iAdd, common.*.uint, builder.binary(b, spv.Op.iMul, common.*.uint, value, coverage), c127), c255)
        scaled[index] = compute.select(b, common.*.uint, partial, reduced, value)
        index += 1
    }
    const alpha = scaled[0]
    const keep = builder.binary(b, spv.Op.iSub, common.*.uint, c255, alpha)
    var opaque = common.*.zero
    var mixed = common.*.zero
    index = 0
    while index < 4 {
        const shift = compute.constant(b, common, 24 - index * 8)
        opaque = builder.binary(b, spv.Op.bitwiseOr, common.*.uint, opaque, builder.binary(b, spv.Op.shiftLeftLogical, common.*.uint, scaled[index], shift))
        const kept = builder.binary(b, spv.Op.uDiv, common.*.uint, builder.binary(b, spv.Op.iAdd, common.*.uint, builder.binary(b, spv.Op.iMul, common.*.uint, compute.channel(b, common, under, 24 - index * 8), keep), c127), c255)
        const sum = smallerUint(b, common, builder.binary(b, spv.Op.iAdd, common.*.uint, scaled[index], kept), c255)
        mixed = builder.binary(b, spv.Op.bitwiseOr, common.*.uint, mixed, builder.binary(b, spv.Op.shiftLeftLogical, common.*.uint, sum, shift))
        index += 1
    }
    const full = builder.binary(b, spv.Op.iEqual, common.*.boolean, alpha, c255)
    const blended = compute.select(b, common.*.uint, full, opaque, mixed)
    return compute.select(b, common.*.uint, builder.binary(b, spv.Op.iEqual, common.*.boolean, coverage, common.*.zero), under, blended)
}

// canvas.clampTo: value into 0 .. limit - 1 (signed).
fn clampSigned(b: *builder.Builder, common: *const shaders.Common, value: u32, limit: u32) -> u32 {
    const zero = shaders.intConstant(b, common, 0)
    const last = builder.binary(b, spv.Op.iSub, common.*.int, limit, shaders.intConstant(b, common, 1))
    const low = compute.select(b, common.*.int, builder.binary(b, spv.Op.sLessThan, common.*.boolean, value, zero), zero, value)
    return compute.select(b, common.*.int, builder.binary(b, spv.Op.sGreaterThan, common.*.boolean, low, last), last, low)
}

// canvas.sample: the image pixel at (sx, sy) in 1/256 pixels, bilinear.
fn emitSample(b: *builder.Builder, common: *const shaders.Common, heap: u32, image_offset: u32, width: u32, height: u32, sx: u32, sy: u32) -> u32 {
    const zero = shaders.intConstant(b, common, 0)
    const c256 = shaders.intConstant(b, common, 256)
    const negative_x = builder.binary(b, spv.Op.sLessThan, common.*.boolean, sx, zero)
    const negative_y = builder.binary(b, spv.Op.sLessThan, common.*.boolean, sy, zero)
    const x0 = clampSigned(b, common, compute.select(b, common.*.int, negative_x, zero, builder.binary(b, spv.Op.sDiv, common.*.int, sx, c256)), width)
    const y0 = clampSigned(b, common, compute.select(b, common.*.int, negative_y, zero, builder.binary(b, spv.Op.sDiv, common.*.int, sy, c256)), height)
    const x1 = clampSigned(b, common, builder.binary(b, spv.Op.iAdd, common.*.int, x0, shaders.intConstant(b, common, 1)), width)
    const y1 = clampSigned(b, common, builder.binary(b, spv.Op.iAdd, common.*.int, y0, shaders.intConstant(b, common, 1)), height)
    const fx = shaders.unsigned(b, common, compute.select(b, common.*.int, negative_x, zero, builder.binary(b, spv.Op.sRem, common.*.int, sx, c256)))
    const fy = shaders.unsigned(b, common, compute.select(b, common.*.int, negative_y, zero, builder.binary(b, spv.Op.sRem, common.*.int, sy, c256)))
    const row0 = builder.binary(b, spv.Op.iMul, common.*.int, y0, width)
    const row1 = builder.binary(b, spv.Op.iMul, common.*.int, y1, width)
    const a = builder.load(b, common.*.uint, compute.element(b, common, heap, builder.binary(b, spv.Op.iAdd, common.*.uint, image_offset, shaders.unsigned(b, common, builder.binary(b, spv.Op.iAdd, common.*.int, row0, x0)))))
    const pb = builder.load(b, common.*.uint, compute.element(b, common, heap, builder.binary(b, spv.Op.iAdd, common.*.uint, image_offset, shaders.unsigned(b, common, builder.binary(b, spv.Op.iAdd, common.*.int, row0, x1)))))
    const c = builder.load(b, common.*.uint, compute.element(b, common, heap, builder.binary(b, spv.Op.iAdd, common.*.uint, image_offset, shaders.unsigned(b, common, builder.binary(b, spv.Op.iAdd, common.*.int, row1, x0)))))
    const d = builder.load(b, common.*.uint, compute.element(b, common, heap, builder.binary(b, spv.Op.iAdd, common.*.uint, image_offset, shaders.unsigned(b, common, builder.binary(b, spv.Op.iAdd, common.*.int, row1, x1)))))
    const u256 = compute.constant(b, common, 256)
    const left_x = builder.binary(b, spv.Op.iSub, common.*.uint, u256, fx)
    const upper_y = builder.binary(b, spv.Op.iSub, common.*.uint, u256, fy)
    var result = common.*.zero
    var shift: u32 = 0
    while shift < 32 {
        const top = builder.binary(b, spv.Op.iAdd, common.*.uint, builder.binary(b, spv.Op.iMul, common.*.uint, compute.channel(b, common, a, shift), left_x), builder.binary(b, spv.Op.iMul, common.*.uint, compute.channel(b, common, pb, shift), fx))
        const bottom = builder.binary(b, spv.Op.iAdd, common.*.uint, builder.binary(b, spv.Op.iMul, common.*.uint, compute.channel(b, common, c, shift), left_x), builder.binary(b, spv.Op.iMul, common.*.uint, compute.channel(b, common, d, shift), fx))
        const value = builder.binary(b, spv.Op.uDiv, common.*.uint, builder.binary(b, spv.Op.iAdd, common.*.uint, builder.binary(b, spv.Op.iMul, common.*.uint, top, upper_y), builder.binary(b, spv.Op.iMul, common.*.uint, bottom, fy)), compute.constant(b, common, 65536))
        const placed = if shift == 0 { smallerUint(b, common, value, compute.constant(b, common, 255)) } else { builder.binary(b, spv.Op.shiftLeftLogical, common.*.uint, smallerUint(b, common, value, compute.constant(b, common, 255)), compute.constant(b, common, shift)) }
        result = builder.binary(b, spv.Op.bitwiseOr, common.*.uint, result, placed)
        shift += 8
    }
    return result
}

// A command word (signed or not) at `base + index` of binding 1.
fn commandWord(b: *builder.Builder, common: *const shaders.Common, base: u32, index: u32) -> u32 {
    return builder.load(b, common.*.uint, compute.element(b, common, common.*.buffers[1], builder.binary(b, spv.Op.iAdd, common.*.uint, base, compute.constant(b, common, index))))
}

// Opens `if (kind == value)`: returns the merge block to close it with
// compute.closeIf.
fn openKind(b: *builder.Builder, common: *const shaders.Common, kind: u32, value: u32) -> u32 {
    const matches = builder.binary(b, spv.Op.iEqual, common.*.boolean, kind, compute.constant(b, common, value))
    return compute.openIf(b, matches)
}

pub fn buildPaint(b: *builder.Builder) -> void { buildPaintParts(b, 31) }

// buildPaint with only some kinds of commands (bit 1 << kind): for finding
// what a driver does not take.
pub fn buildPaintParts(b: *builder.Builder, parts: u32) -> void {
    var common: shaders.Common = undefined
    compute.declare(b, &common, shaders.PAINT_WORDS, 3, false)
    const function_pointer = builder.typePointer(b, spv.StorageClass.function, common.uint)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    // Function variables come first in the entry block.
    const result = builder.localVariable(b, function_pointer)
    const counter = builder.localVariable(b, function_pointer)
    const cover_first = builder.localVariable(b, function_pointer)
    const cover_second = builder.localVariable(b, function_pointer)
    const quad_counter = builder.localVariable(b, function_pointer)
    const glyph_cover = builder.localVariable(b, function_pointer)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const width = compute.pushWord(b, &common, 0)
    const height = compute.pushWord(b, &common, 1)
    const target_offset = compute.pushWord(b, &common, 2)
    const target_stride = compute.pushWord(b, &common, 3)
    const command_offset = compute.pushWord(b, &common, 4)
    const command_count = compute.pushWord(b, &common, 5)
    const tile_columns = compute.pushWord(b, &common, 6)
    const tile_offset = compute.pushWord(b, &common, 7)
    const zero_int = shaders.intConstant(b, &common, 0)
    const inside_target = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.uLessThan, common.boolean, x, width), builder.binary(b, spv.Op.uLessThan, common.boolean, y, height))
    const body = builder.newId(b)
    const done = builder.newId(b)
    builder.selectionMerge(b, done)
    builder.branchConditional(b, inside_target, body, done)

    const body_label = builder.labelWith(b, body)
    const px = shaders.signed(b, &common, x)
    const py = shaders.signed(b, &common, y)
    // The pixel's tile and its list (word 0 when not tiled: loaded, unused).
    const tiled = builder.binary(b, spv.Op.iNotEqual, common.boolean, tile_columns, common.zero)
    const tile_shift = compute.constant(b, &common, shaders.PAINT_TILE_SHIFT)
    const tile = builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.shiftRightLogical, common.uint, x, tile_shift), builder.binary(b, spv.Op.iMul, common.uint, builder.binary(b, spv.Op.shiftRightLogical, common.uint, y, tile_shift), tile_columns))
    const tile_header = compute.select(b, common.uint, tiled, builder.binary(b, spv.Op.iAdd, common.uint, tile_offset, builder.binary(b, spv.Op.shiftLeftLogical, common.uint, tile, compute.constant(b, &common, 1))), common.zero)
    const list_start = commandWord(b, &common, tile_header, 0)
    const list_length = commandWord(b, &common, tile_header, 1)
    const loop_count = compute.select(b, common.uint, tiled, list_length, command_count)
    builder.store(b, result, common.zero)
    builder.store(b, counter, common.zero)
    const header = builder.newId(b)
    const condition_block = builder.newId(b)
    const loop_body = builder.newId(b)
    const continue_block = builder.newId(b)
    const loop_end = builder.newId(b)
    builder.branch(b, header)

    // for (i = 0; i < count; i += 1)
    const header_label = builder.labelWith(b, header)
    builder.loopMerge(b, loop_end, continue_block)
    builder.branch(b, condition_block)

    const condition_label = builder.labelWith(b, condition_block)
    const index = builder.load(b, common.uint, counter)
    builder.branchConditional(b, builder.binary(b, spv.Op.uLessThan, common.boolean, index, loop_count), loop_body, loop_end)

    const loop_body_label = builder.labelWith(b, loop_body)
    const entry_word = compute.select(b, common.uint, tiled, builder.binary(b, spv.Op.iAdd, common.uint, list_start, builder.binary(b, spv.Op.shiftLeftLogical, common.uint, index, compute.constant(b, &common, 1))), common.zero)
    const command_index = compute.select(b, common.uint, tiled, commandWord(b, &common, entry_word, 0), index)
    const quad_range = commandWord(b, &common, entry_word, 1)
    const base = builder.binary(b, spv.Op.iAdd, common.uint, command_offset, builder.binary(b, spv.Op.iMul, common.uint, command_index, compute.constant(b, &common, shaders.PAINT_COMMAND_WORDS)))
    const kind = commandWord(b, &common, base, 0)
    const box_x = shaders.signed(b, &common, commandWord(b, &common, base, 1))
    const box_y = shaders.signed(b, &common, commandWord(b, &common, base, 2))
    const box_width = shaders.signed(b, &common, commandWord(b, &common, base, 3))
    const box_height = shaders.signed(b, &common, commandWord(b, &common, base, 4))
    const lx = builder.binary(b, spv.Op.iSub, common.int, px, box_x)
    const ly = builder.binary(b, spv.Op.iSub, common.int, py, box_y)
    const in_box_x = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, lx, zero_int), builder.binary(b, spv.Op.sLessThan, common.boolean, lx, box_width))
    const in_box_y = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, ly, zero_int), builder.binary(b, spv.Op.sLessThan, common.boolean, ly, box_height))
    const in_box = builder.binary(b, spv.Op.logicalAnd, common.boolean, in_box_x, in_box_y)
    const touched = builder.newId(b)
    const after = builder.newId(b)
    builder.selectionMerge(b, after)
    builder.branchConditional(b, in_box, touched, after)

    const touched_label = builder.labelWith(b, touched)
    const color = commandWord(b, &common, base, 7)
    const radius = shaders.signed(b, &common, commandWord(b, &common, base, 5))

    // CLEAR
    var merge: u32 = 0
    if parts & 1 != 0 {
    merge = openKind(b, &common, kind, shaders.PAINT_CLEAR)
    builder.store(b, result, color)
    compute.closeIf(b, merge)
    }

    // FILL
    if parts & 2 != 0 {
    merge = openKind(b, &common, kind, shaders.PAINT_FILL)
    const fill_coverage = shaders.emitRounded(b, &common, cover_first, lx, ly, box_width, box_height, radius)
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), color, fill_coverage))
    compute.closeIf(b, merge)
    }

    // STROKE: the outline `thickness` wide, inside the rectangle.
    if parts & 4 != 0 {
    merge = openKind(b, &common, kind, shaders.PAINT_STROKE)
    const thickness = shaders.signed(b, &common, commandWord(b, &common, base, 6))
    const outer = shaders.emitRounded(b, &common, cover_first, lx, ly, box_width, box_height, radius)
    const twice = builder.binary(b, spv.Op.iMul, common.int, thickness, shaders.intConstant(b, &common, 2))
    const inner_radius = compute.select(b, common.int, builder.binary(b, spv.Op.sGreaterThan, common.boolean, radius, thickness), builder.binary(b, spv.Op.iSub, common.int, radius, thickness), zero_int)
    const inner = shaders.emitRounded(b, &common, cover_second, builder.binary(b, spv.Op.iSub, common.int, lx, thickness), builder.binary(b, spv.Op.iSub, common.int, ly, thickness), builder.binary(b, spv.Op.iSub, common.int, box_width, twice), builder.binary(b, spv.Op.iSub, common.int, box_height, twice), inner_radius)
    const ring = compute.select(b, common.uint, builder.binary(b, spv.Op.uGreaterThan, common.boolean, outer, inner), builder.binary(b, spv.Op.iSub, common.uint, outer, inner), common.zero)
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), color, ring))
    compute.closeIf(b, merge)
    }

    // IMAGE: canvas.drawImage's mapping into a size x size box.
    if parts & 8 != 0 {
    merge = openKind(b, &common, kind, shaders.PAINT_IMAGE)
    const image_offset = commandWord(b, &common, base, 8)
    const source_width = shaders.signed(b, &common, commandWord(b, &common, base, 9))
    const source_height = shaders.signed(b, &common, commandWord(b, &common, base, 10))
    const opacity = commandWord(b, &common, base, 11)
    const c128 = shaders.intConstant(b, &common, 128)
    const sample_x = builder.binary(b, spv.Op.iSub, common.int, builder.binary(b, spv.Op.sDiv, common.int, builder.binary(b, spv.Op.iMul, common.int, builder.binary(b, spv.Op.iMul, common.int, builder.binary(b, spv.Op.iAdd, common.int, builder.binary(b, spv.Op.iMul, common.int, lx, shaders.intConstant(b, &common, 2)), shaders.intConstant(b, &common, 1)), source_width), c128), box_width), c128)
    const sample_y = builder.binary(b, spv.Op.iSub, common.int, builder.binary(b, spv.Op.sDiv, common.int, builder.binary(b, spv.Op.iMul, common.int, builder.binary(b, spv.Op.iMul, common.int, builder.binary(b, spv.Op.iAdd, common.int, builder.binary(b, spv.Op.iMul, common.int, ly, shaders.intConstant(b, &common, 2)), shaders.intConstant(b, &common, 1)), source_height), c128), box_height), c128)
    const pixel = emitSample(b, &common, common.buffers[2], image_offset, source_width, source_height, sample_x, sample_y)
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), pixel, opacity))
    compute.closeIf(b, merge)
    }

    // GLYPHS: the largest atlas coverage among the quads over the pixel.
    if parts & 16 != 0 {
    merge = openKind(b, &common, kind, shaders.PAINT_GLYPHS)
    // Tiled: only the quads that reach into the tile's columns.
    const all_quads = commandWord(b, &common, base, 9)
    const first_quad = compute.select(b, common.uint, tiled, builder.binary(b, spv.Op.shiftRightLogical, common.uint, quad_range, compute.constant(b, &common, 16)), common.zero)
    const quad_offset = builder.binary(b, spv.Op.iAdd, common.uint, commandWord(b, &common, base, 8), builder.binary(b, spv.Op.shiftLeftLogical, common.uint, first_quad, compute.constant(b, &common, 2)))
    const quad_count = compute.select(b, common.uint, tiled, builder.binary(b, spv.Op.bitwiseAnd, common.uint, quad_range, compute.constant(b, &common, 65535)), all_quads)
    const atlas_offset = commandWord(b, &common, base, 10)
    const atlas_width = commandWord(b, &common, base, 11)
    const origin_x = shaders.signed(b, &common, commandWord(b, &common, base, 12))
    const origin_y = shaders.signed(b, &common, commandWord(b, &common, base, 13))
    const limit = shaders.signed(b, &common, commandWord(b, &common, base, 14))
    const run_x = builder.binary(b, spv.Op.iSub, common.int, px, origin_x)
    const run_y = builder.binary(b, spv.Op.iSub, common.int, py, origin_y)
    builder.store(b, glyph_cover, common.zero)
    builder.store(b, quad_counter, common.zero)
    const quad_header = builder.newId(b)
    const quad_condition = builder.newId(b)
    const quad_body = builder.newId(b)
    const quad_continue = builder.newId(b)
    const quad_end = builder.newId(b)
    builder.branch(b, quad_header)

    const quad_header_label = builder.labelWith(b, quad_header)
    builder.loopMerge(b, quad_end, quad_continue)
    builder.branch(b, quad_condition)

    const quad_condition_label = builder.labelWith(b, quad_condition)
    const quad_index = builder.load(b, common.uint, quad_counter)
    builder.branchConditional(b, builder.binary(b, spv.Op.uLessThan, common.boolean, quad_index, quad_count), quad_body, quad_end)

    const quad_body_label = builder.labelWith(b, quad_body)
    const quad_base = builder.binary(b, spv.Op.iAdd, common.uint, quad_offset, builder.binary(b, spv.Op.shiftLeftLogical, common.uint, quad_index, compute.constant(b, &common, 2)))
    const word0 = commandWord(b, &common, quad_base, 0)
    const word1 = commandWord(b, &common, quad_base, 1)
    const quad_x = shaders.signed(b, &common, commandWord(b, &common, quad_base, 2))
    const quad_y = shaders.signed(b, &common, commandWord(b, &common, quad_base, 3))
    const mask = compute.constant(b, &common, 65535)
    const sixteen = compute.constant(b, &common, 16)
    const atlas_x = builder.binary(b, spv.Op.bitwiseAnd, common.uint, word0, mask)
    const atlas_y = builder.binary(b, spv.Op.shiftRightLogical, common.uint, word0, sixteen)
    const quad_width = shaders.signed(b, &common, builder.binary(b, spv.Op.bitwiseAnd, common.uint, word1, mask))
    const quad_height = shaders.signed(b, &common, builder.binary(b, spv.Op.shiftRightLogical, common.uint, word1, sixteen))
    const local_x = builder.binary(b, spv.Op.iSub, common.int, run_x, quad_x)
    const local_y = builder.binary(b, spv.Op.iSub, common.int, run_y, quad_y)
    const inside_x = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, local_x, zero_int), builder.binary(b, spv.Op.sLessThan, common.boolean, local_x, quad_width))
    const inside_y = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, local_y, zero_int), builder.binary(b, spv.Op.sLessThan, common.boolean, local_y, quad_height))
    const inside_quad = builder.binary(b, spv.Op.logicalAnd, common.boolean, inside_x, inside_y)
    const sample = builder.newId(b)
    const sampled = builder.newId(b)
    builder.selectionMerge(b, sampled)
    builder.branchConditional(b, inside_quad, sample, sampled)

    const sample_label = builder.labelWith(b, sample)
    const atlas_row = builder.binary(b, spv.Op.iAdd, common.uint, atlas_y, shaders.unsigned(b, &common, local_y))
    const atlas_column = builder.binary(b, spv.Op.iAdd, common.uint, atlas_x, shaders.unsigned(b, &common, local_x))
    const byte_index = builder.binary(b, spv.Op.iAdd, common.uint, atlas_offset, builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, atlas_row, atlas_width), atlas_column))
    const word = builder.load(b, common.uint, compute.element(b, &common, common.buffers[2], builder.binary(b, spv.Op.shiftRightLogical, common.uint, byte_index, compute.constant(b, &common, 2))))
    const bit_shift = builder.binary(b, spv.Op.shiftLeftLogical, common.uint, builder.binary(b, spv.Op.bitwiseAnd, common.uint, byte_index, compute.constant(b, &common, 3)), compute.constant(b, &common, 3))
    const value = builder.binary(b, spv.Op.bitwiseAnd, common.uint, builder.binary(b, spv.Op.shiftRightLogical, common.uint, word, bit_shift), compute.constant(b, &common, 255))
    const current = builder.load(b, common.uint, glyph_cover)
    builder.store(b, glyph_cover, compute.select(b, common.uint, builder.binary(b, spv.Op.uGreaterThan, common.boolean, value, current), value, current))
    builder.branch(b, sampled)

    const sampled_label = builder.labelWith(b, sampled)
    builder.branch(b, quad_continue)

    const quad_continue_label = builder.labelWith(b, quad_continue)
    builder.store(b, quad_counter, builder.binary(b, spv.Op.iAdd, common.uint, quad_index, compute.constant(b, &common, 1)))
    builder.branch(b, quad_header)

    const quad_end_label = builder.labelWith(b, quad_end)
    const limited = builder.binary(b, spv.Op.logicalAnd, common.boolean, builder.binary(b, spv.Op.iNotEqual, common.boolean, limit, zero_int), builder.binary(b, spv.Op.sGreaterThanEqual, common.boolean, run_x, limit))
    const glyph_coverage = compute.select(b, common.uint, limited, common.zero, builder.load(b, common.uint, glyph_cover))
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), color, glyph_coverage))
    compute.closeIf(b, merge)
    }

    builder.branch(b, after)
    const after_label = builder.labelWith(b, after)
    builder.branch(b, continue_block)

    const continue_label = builder.labelWith(b, continue_block)
    builder.store(b, counter, builder.binary(b, spv.Op.iAdd, common.uint, index, compute.constant(b, &common, 1)))
    builder.branch(b, header)

    const loop_end_label = builder.labelWith(b, loop_end)
    const target_index = builder.binary(b, spv.Op.iAdd, common.uint, target_offset, builder.binary(b, spv.Op.iAdd, common.uint, builder.binary(b, spv.Op.iMul, common.uint, y, target_stride), x))
    builder.store(b, compute.element(b, &common, common.buffers[0], target_index), builder.load(b, common.uint, result))
    builder.branch(b, done)

    const done_label = builder.labelWith(b, done)
    builder.returnVoid(b)
    builder.functionEnd(b)
    compute.finish(b, &common, main, shaders.GROUP_SIZE, shaders.GROUP_SIZE)
}
