// Builds the example shaders, validates them with std.spirv.module and, when
// given a directory, writes pattern.spv and blit.spv there (for spirv-val).
//
//     mlx4 examples/vulkan-shared/check_shaders.mlx -o check-shaders
//     ./check-shaders /tmp        exits 0 when both shaders are valid
const std = @import("std")
const module = @import("std.spirv.module")
const shaders = @import("./shaders.mlx")

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stderr(), text) }

fn check(which: u8, directory: std.string.String, file_name: []const u8) -> bool {
    const allocator = std.page_allocator.init()
    var words: [*]u32 = undefined
    const count = shaders.build(allocator, which, &words)
    if count == 0 { return false }
    var diagnostic: module.Diagnostic = undefined
    const result = module.validate(words, count, allocator, &diagnostic)
    if result != module.Error.none {
        say(file_name)
        say(": ")
        say(module.errorMessage(result))
        say("\n")
        return false
    }
    if directory.length == 0 { return true }
    var path: [512]u8 = undefined
    var length: usize = 0
    var index: usize = 0
    while index < directory.length && length < 400 {
        path[length] = directory.pointer[index]
        length += 1
        index += 1
    }
    path[length] = 47
    length += 1
    for byte in file_name {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    var file = std.fs.open(@ptrFromInt([*]const u8, 0), 0, 0)
    unsafe { file = std.fs.open(@ptrCast([*]const u8, &path), 577, 420) }
    if !std.fs.isValid(file) { return false }
    var written = false
    unsafe { written = std.fs.writeAllBytes(file, @ptrCast([*]const u8, words), count * 4) }
    const closed = std.fs.close(file)
    return written
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const directory = if std.process.count(arguments) > 1 { std.process.argument(arguments, 1) } else { std.string.fromSlice("") }
    if !check(0, directory, "pattern.spv") { return 1 }
    if !check(1, directory, "blit.spv") { return 1 }
    return 0
}
