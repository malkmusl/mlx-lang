// Text for the Vulkan examples: std.truetype lays out and rasterizes, the
// `text` compute shader (shaders.mlx) draws. The atlas lives in a
// host-visible buffer that is refreshed whenever std.truetype added glyphs
// (Atlas.revision); the runs drawn in one frame are packed one after
// another into a second buffer, since they are all read when the frame's
// command buffer runs.

const std = @import("std")
const vk = @import("std.vulkan")
const tt = @import("std.truetype")
const ui = @import("std.ui")
const gpu = @import("./gpu.mlx")
const shaders = @import("./shaders.mlx")

pub const Text = struct {
    kernel: *gpu.Kernel
    atlas: *gpu.Buffer
    runs: *gpu.Buffer
    // Words of `runs` used by the frame being recorded, and its capacity.
    used: u32
    capacity: u32
    revision: u32
}

fn record(allocator: std.allocator.Allocator, size: usize) -> usize {
    const memory = allocator.alloc(size, 16)
    if memory == null { return 0 }
    return @intFromPtr(memory.?)
}

// `quads`: how many glyphs one frame may draw in total.
pub fn init(context: *gpu.Context, text: *Text, atlas: *const tt.Atlas, quads: u32) -> bool {
    return initSized(context, text, atlas.*.width, atlas.*.height, quads)
}

// The same for an atlas of `atlas_width` x `atlas_height`, or without one
// (pass 4 x 1) to only fill rectangles.
pub fn initSized(context: *gpu.Context, text: *Text, atlas_width: u32, atlas_height: u32, quads: u32) -> bool {
    const allocator = context.*.allocator
    const kernel = record(allocator, @sizeOf(gpu.Kernel))
    const atlas_buffer = record(allocator, @sizeOf(gpu.Buffer))
    const runs = record(allocator, @sizeOf(gpu.Buffer))
    if kernel == 0 || atlas_buffer == 0 || runs == 0 { return false }
    unsafe {
        text.*.kernel = @ptrFromInt(*gpu.Kernel, kernel)
        text.*.atlas = @ptrFromInt(*gpu.Buffer, atlas_buffer)
        text.*.runs = @ptrFromInt(*gpu.Buffer, runs)
    }
    var code: [*]u32 = undefined
    const words = shaders.buildTextWords(allocator, &code)
    if words == 0 || !gpu.createKernel(context, text.*.kernel, code, words, 3, shaders.TEXT_WORDS) { return false }
    const atlas_size = @intCast(u64, atlas_width) * @intCast(u64, atlas_height)
    if !gpu.createBuffer(context, text.*.atlas, atlas_size, false) { return false }
    text.*.capacity = quads * 4
    if !gpu.createBuffer(context, text.*.runs, @intCast(u64, text.*.capacity) * 4, false) { return false }
    text.*.used = 0
    text.*.revision = 0
    return true
}

// Call when a frame starts recording (after gpu.begin).
pub fn beginFrame(text: *Text) -> void { text.*.used = 0 }

fn refreshAtlas(text: *Text, atlas: *const tt.Atlas) -> void {
    if text.*.revision == atlas.*.revision { return }
    const size = @intCast(usize, atlas.*.width) * @intCast(usize, atlas.*.height)
    var target: [*]u8 = undefined
    unsafe { target = @ptrFromInt([*]u8, text.*.atlas.*.address) }
    var index: usize = 0
    while index < size {
        target[index] = atlas.*.pixels[index]
        index += 1
    }
    text.*.revision = atlas.*.revision
}

// Records drawing `run` with its origin at (x, y) into `target` (a
// `width` x `height` image starting `offset` pixels in). `color` is
// 0xAARRGGBB; for R8G8B8A8 targets pass it with red and blue swapped.
// False when the frame's run space is exhausted or Vulkan failed.
pub fn draw(context: *gpu.Context, text: *Text, atlas: *const tt.Atlas, run: *const tt.Run, target: vk.Buffer, width: u32, height: u32, offset: u32, x: i32, y: i32, color: u32) -> bool {
    return drawIn(context, text, atlas, run, target, width, height, offset, x, y, color, ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
}

// draw, with only the part of the run inside `clip` (target pixels) drawn.
pub fn drawIn(context: *gpu.Context, text: *Text, atlas: *const tt.Atlas, run: *const tt.Run, target: vk.Buffer, width: u32, height: u32, offset: u32, x: i32, y: i32, color: u32, clip: ui.Rect) -> bool {
    if run.*.count == 0 { return true }
    // The run's box in the target, clipped, back relative to the origin.
    const box = ui.intersect(ui.rect(x + run.*.left, y + run.*.top, run.*.right - run.*.left, run.*.bottom - run.*.top), clip)
    if ui.isEmpty(box) { return true }
    const words = @intCast(u32, run.*.count) * 4
    if text.*.used + words > text.*.capacity { return false }
    refreshAtlas(text, atlas)
    var slots: [*]u32 = undefined
    unsafe { slots = @ptrFromInt([*]u32, text.*.runs.*.address) }
    var index: usize = 0
    var at = @intCast(usize, text.*.used)
    while index < run.*.count {
        const quad = run.*.quads[index]
        slots[at] = quad.atlasX | (quad.atlasY << 16)
        slots[at + 1] = quad.width | (quad.height << 16)
        slots[at + 2] = @bitCast(u32, quad.x)
        slots[at + 3] = @bitCast(u32, quad.y)
        at += 4
        index += 1
    }
    const box_width = @intCast(u32, box.width)
    const box_height = @intCast(u32, box.height)
    const push = shaders.Text.{
        .targetWidth = width,
        .targetHeight = height,
        .targetOffset = offset,
        .originX = @bitCast(u32, x),
        .originY = @bitCast(u32, y),
        .boxLeft = @bitCast(u32, box.x - x),
        .boxTop = @bitCast(u32, box.y - y),
        .boxWidth = box_width,
        .boxHeight = box_height,
        .count = @intCast(u32, run.*.count),
        .atlasWidth = atlas.*.width,
        .color = color,
        .runOffset = text.*.used,
        .baseCoverage = 0,
    }
    text.*.used += words
    var buffers: [3]vk.Buffer = [3]vk.Buffer{ text.*.atlas.*.buffer, text.*.runs.*.buffer, target }
    unsafe {
        return gpu.dispatch(context, text.*.kernel, @ptrCast([*]const vk.Buffer, &buffers), &push, gpu.groups(box_width, shaders.GROUP_SIZE), gpu.groups(box_height, shaders.GROUP_SIZE))
    }
}

// Records filling `area` of `target` with `color` (0xAARRGGBB, straight
// alpha; red and blue swapped for R8G8B8A8 targets), blended the way
// std.ui.fillRect does it on the CPU: the text shader with no glyphs and
// every pixel fully covered.
pub fn fill(context: *gpu.Context, text: *Text, target: vk.Buffer, width: u32, height: u32, offset: u32, area: ui.Rect, color: u32) -> bool {
    const clipped = ui.intersect(area, ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
    if ui.isEmpty(clipped) { return true }
    const box_width = @intCast(u32, clipped.width)
    const box_height = @intCast(u32, clipped.height)
    const push = shaders.Text.{
        .targetWidth = width,
        .targetHeight = height,
        .targetOffset = offset,
        .originX = @bitCast(u32, clipped.x),
        .originY = @bitCast(u32, clipped.y),
        .boxLeft = 0,
        .boxTop = 0,
        .boxWidth = box_width,
        .boxHeight = box_height,
        .count = 0,
        .atlasWidth = 4,
        .color = color,
        .runOffset = 0,
        .baseCoverage = 255,
    }
    var buffers: [3]vk.Buffer = [3]vk.Buffer{ text.*.atlas.*.buffer, text.*.runs.*.buffer, target }
    unsafe {
        return gpu.dispatch(context, text.*.kernel, @ptrCast([*]const vk.Buffer, &buffers), &push, gpu.groups(box_width, shaders.GROUP_SIZE), gpu.groups(box_height, shaders.GROUP_SIZE))
    }
}
