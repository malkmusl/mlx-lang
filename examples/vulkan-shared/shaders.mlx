// The compute shaders the Vulkan examples run, written with
// std.spirv.builder (no GLSL compiler involved).
//
// pattern (binding 0: pixels, push constants: Pattern)
//     An animated XOR/gradient pattern with a ring following the pointer;
//     each invocation writes one pixel 0xAARRGGBB (DRM XRGB8888 / Vulkan
//     B8G8R8A8 in memory), or 0xAABBGGRR with FLAG_SWAP_RED_BLUE.
//
// blit (binding 0: source pixels, binding 1: destination pixels,
//       push constants: Blit)
//     Blends one window (premultiplied ARGB, the wl_shm convention, or XRGB
//     with FLAG_OPAQUE) into the output at (targetX, targetY), clipped to
//     the output; the output starts `targetOffset` pixels into binding 1,
//     its rows `targetStride` pixels apart (a DRM dumb buffer's pitch may
//     exceed a row). A source stride of 0 repeats the first row (solid
//     rectangles). Two rounded shapes (A and B: x, y, width and height in
//     the output, corner radii for the top and the bottom half) mask it:
//     FLAG_CLIP_CORNERS scales each pixel by A's coverage inside A's
//     rectangle (rounded window corners; outside it, shadows, nothing
//     changes), FLAG_RING by A's coverage minus B's (a window's frame).
//     Coverage is the desktop canvas's: 4x4 samples in the corners. The
//     target's alpha is blended too (it stays 255 over an opaque target),
//     so an offscreen target keeps its transparency.
//
// warp (binding 0: source pixels, binding 1: destination pixels,
//       binding 2: control points, push constants: Warp)
//     Draws a window bent (wobbly windows): the source is the window drawn
//     flat, its rest rectangle's size, rows `sourceStride` apart; 16
//     control points (a 4x4 Bezier surface over the rest rectangle) at
//     `gridOffset` in binding 2 give their offsets from rest in 1/16
//     pixels, 16 x offsets then 16 y offsets (signed). Each pixel of the
//     box finds the source point the surface carries onto it (three
//     fixed-point iterations, s = p - offset(s)), samples it bilinearly
//     and blends it over the target (premultiplied). Integers only.
//
// shrink (binding 0: source pixels, binding 1: destination pixels,
//         push constants: Shrink)
//     Draws the source (sourceWidth x sourceHeight, rows `sourceStride`
//     apart) scaled into the box of the target (window previews): each
//     pixel is the mean of 4x4 samples spread over the part of the source
//     it covers, blended over the target (premultiplied).
//
// text (binding 0: glyph atlas, binding 1: glyph run, binding 2:
//      destination pixels, push constants: Text)
//     Draws a std.truetype Run: each invocation is one pixel of the run's
//     bounding box, takes the largest atlas coverage among the run's quads
//     covering it and blends `color` at that coverage, exactly like
//     std.truetype.drawRun. The atlas holds 8-bit coverage, four per word;
//     each quad is four words: atlasX | atlasY << 16, width | height << 16,
//     x, y (signed, relative to the run origin).
//
// blurPass (binding 0: source pixels, binding 1: destination pixels,
//           push constants: BlurPass)
//     One box blur pass over a width x height rectangle: each pixel becomes
//     the mean (per channel, truncated) of the BLUR_RADIUS pixels either
//     side of it across (or down, with `vertical`), the rectangle's edge
//     pixels repeated beyond it. Both rectangles start at an offset, rows
//     `stride` pixels apart.
//
// blurMask (binding 0: blurred pixels, binding 1: destination pixels,
//           binding 2: region, push constants: BlurMask)
//     Copies the blurred rectangle into the destination at (areaX, areaY)
//     where the pixel is in a region: `opCount` (at most BLUR_OPS) records of
//     five words at `opsOffset` (subtract, x, y, width, height, relative to
//     (originX, originY)); the last one covering a pixel decides.
//
// All use 8x8 work groups: dispatch ceil(width / 8) x ceil(height / 8).

const std = @import("std")
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")

pub const GROUP_SIZE: u32 = 8

// Pattern flags.
pub const FLAG_POINTER: u32 = 1
pub const FLAG_PRESSED: u32 = 2
pub const FLAG_SWAP_RED_BLUE: u32 = 4

// Blit flags.
pub const FLAG_OPAQUE: u32 = 1
pub const FLAG_CLIP_CORNERS: u32 = 2
pub const FLAG_RING: u32 = 4

// Push constants (u32 words).
pub const Pattern = struct {
    width: u32
    height: u32
    time: u32
    pointerX: u32
    pointerY: u32
    flags: u32
}

pub const Blit = struct {
    sourceWidth: u32
    sourceHeight: u32
    sourceStride: u32
    sourceOffset: u32
    targetWidth: u32
    targetHeight: u32
    targetX: u32
    targetY: u32
    flags: u32
    targetOffset: u32
    targetStride: u32
    // The shapes (signed; see the top).
    shapeAX: u32
    shapeAY: u32
    shapeAWidth: u32
    shapeAHeight: u32
    shapeATop: u32
    shapeABottom: u32
    shapeBX: u32
    shapeBY: u32
    shapeBWidth: u32
    shapeBHeight: u32
    shapeBTop: u32
    shapeBBottom: u32
}

// Text: the target (as in Blit), the run's origin in the target, its
// bounding box relative to the origin, the quad count, the atlas width (a
// multiple of 4) and the color (0xAARRGGBB, straight alpha; swap red and
// blue on the host for R8G8B8A8 targets). Every pixel of the box starts at
// `baseCoverage` before the glyphs are sampled: 0 for text, 255 with no
// quads to fill the box with the color (a solid rectangle).
pub const Text = struct {
    targetWidth: u32
    targetHeight: u32
    targetOffset: u32
    originX: u32
    originY: u32
    boxLeft: u32
    boxTop: u32
    boxWidth: u32
    boxHeight: u32
    count: u32
    atlasWidth: u32
    color: u32
    // Where this run's quads start in binding 1 (words).
    runOffset: u32
    baseCoverage: u32
    targetStride: u32
}

pub const PATTERN_WORDS: u32 = 6
pub const BLIT_WORDS: u32 = 23
pub const TEXT_WORDS: u32 = 15
pub const BLUR_PASS_WORDS: u32 = 7
pub const BLUR_MASK_WORDS: u32 = 12

// The blur's radius (a pass averages 2 * BLUR_RADIUS + 1 pixels) and the
// most region rectangles blurMask reads.
pub const BLUR_RADIUS: i32 = 6
pub const BLUR_OPS: u32 = 32

pub const BlurPass = struct {
    width: u32
    height: u32
    sourceOffset: u32
    sourceStride: u32
    targetOffset: u32
    targetStride: u32
    vertical: u32
}

pub const BlurMask = struct {
    width: u32
    height: u32
    sourceOffset: u32
    sourceStride: u32
    targetOffset: u32
    targetStride: u32
    areaX: u32
    areaY: u32
    originX: u32
    originY: u32
    opsOffset: u32
    opCount: u32
}
pub const PATTERN: u8 = 0
pub const BLIT: u8 = 1
pub const TEXT: u8 = 2
pub const PAINT: u8 = 3
pub const BLUR_PASS: u8 = 4
pub const BLUR_MASK: u8 = 5
pub const WARP: u8 = 6

pub const Warp = struct {
    targetWidth: u32
    targetHeight: u32
    targetOffset: u32
    targetStride: u32
    // The part of the target to cover, and the rest rectangle (signed).
    boxX: u32
    boxY: u32
    boxWidth: u32
    boxHeight: u32
    restX: u32
    restY: u32
    restWidth: u32
    restHeight: u32
    sourceStride: u32
    gridOffset: u32
}

pub const WARP_WORDS: u32 = 14

pub const SHRINK: u8 = 7

pub const Shrink = struct {
    targetWidth: u32
    targetHeight: u32
    targetOffset: u32
    targetStride: u32
    boxX: u32
    boxY: u32
    boxWidth: u32
    boxHeight: u32
    sourceWidth: u32
    sourceHeight: u32
    sourceStride: u32
    // 255 draws it whole; less fades it (a window opening out of the dock).
    opacity: u32
}

pub const SHRINK_WORDS: u32 = 12

// Types and variables shared by both shaders.
const Common = struct {
    uint: u32
    int: u32
    boolean: u32
    uvec3: u32
    pushPointer: u32
    push: u32
    storagePointer: u32
    globalId: u32
    zero: u32
    buffers: [3]u32
    voidType: u32
    functionType: u32
}

fn words(count: u32) -> usize { return @intCast(usize, count) }

// Declares the module header, the common types, `push_words` u32 push
// constants and `buffer_count` storage buffers of u32 (bindings 0..).
fn declare(b: *builder.Builder, common: *Common, push_words: u32, buffer_count: u32) -> void {
    builder.capability(b, spv.Capability.shader)
    builder.memoryModel(b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    common.*.voidType = builder.typeVoid(b)
    common.*.functionType = builder.typeFunction(b, common.*.voidType, null, 0)
    common.*.boolean = builder.typeBool(b)
    common.*.uint = builder.typeInt(b, 32, false)
    common.*.int = builder.typeInt(b, 32, true)
    common.*.uvec3 = builder.typeVector(b, common.*.uint, 3)
    const input_pointer = builder.typePointer(b, spv.StorageClass.input, common.*.uvec3)
    common.*.globalId = builder.variable(b, input_pointer, spv.StorageClass.input)
    builder.decorateBuiltIn(b, common.*.globalId, spv.BuiltIn.globalInvocationId)
    common.*.zero = builder.constant(b, common.*.uint, 0)

    // Push constants: a Block of `push_words` (at most 32: 128 bytes, the
    // least every device offers) u32 members.
    var members: [32]u32 = undefined
    var member_index: usize = 0
    while member_index < 32 {
        members[member_index] = common.*.uint
        member_index += 1
    }
    var push_block: u32 = 0
    unsafe { push_block = builder.typeStruct(b, @ptrCast([*]const u32, &members), words(push_words)) }
    builder.decorate(b, push_block, spv.Decoration.block)
    var member: u32 = 0
    while member < push_words {
        builder.memberDecorateValue(b, push_block, member, spv.Decoration.offset, member * 4)
        member += 1
    }
    const push_block_pointer = builder.typePointer(b, spv.StorageClass.pushConstant, push_block)
    common.*.push = builder.variable(b, push_block_pointer, spv.StorageClass.pushConstant)
    common.*.pushPointer = builder.typePointer(b, spv.StorageClass.pushConstant, common.*.uint)

    // Storage buffers: struct { uint pixels[]; }.
    const pixels = builder.typeRuntimeArray(b, common.*.uint)
    builder.decorateValue(b, pixels, spv.Decoration.arrayStride, 4)
    var fields: [1]u32 = [1]u32{ pixels }
    var buffer_block: u32 = 0
    unsafe { buffer_block = builder.typeStruct(b, @ptrCast([*]const u32, &fields), 1) }
    builder.decorate(b, buffer_block, spv.Decoration.block)
    builder.memberDecorateValue(b, buffer_block, 0, spv.Decoration.offset, 0)
    const buffer_pointer = builder.typePointer(b, spv.StorageClass.storageBuffer, buffer_block)
    common.*.storagePointer = builder.typePointer(b, spv.StorageClass.storageBuffer, common.*.uint)
    var binding: u32 = 0
    while binding < buffer_count {
        const variable = builder.variable(b, buffer_pointer, spv.StorageClass.storageBuffer)
        builder.decorateValue(b, variable, spv.Decoration.descriptorSet, 0)
        builder.decorateValue(b, variable, spv.Decoration.binding, binding)
        common.*.buffers[binding] = variable
        binding += 1
    }
}

fn constant(b: *builder.Builder, common: *const Common, value: u32) -> u32 {
    return builder.constant(b, common.*.uint, value)
}

fn pushWord(b: *builder.Builder, common: *const Common, index: u32) -> u32 {
    var chain: [1]u32 = [1]u32{ constant(b, common, index) }
    var pointer: u32 = 0
    unsafe { pointer = builder.accessChain(b, common.*.pushPointer, common.*.push, @ptrCast([*]const u32, &chain), 1) }
    return builder.load(b, common.*.uint, pointer)
}

// Pointer to element `index` of storage buffer `buffer`.
fn element(b: *builder.Builder, common: *const Common, buffer: u32, index: u32) -> u32 {
    var chain: [2]u32 = [2]u32{ common.*.zero, index }
    var pointer: u32 = 0
    unsafe { pointer = builder.accessChain(b, common.*.storagePointer, buffer, @ptrCast([*]const u32, &chain), 2) }
    return pointer
}

fn op(b: *builder.Builder, opcode: spv.Op, type_id: u32, left: u32, right: u32) -> u32 {
    return builder.binary(b, opcode, type_id, left, right)
}

fn select(b: *builder.Builder, type_id: u32, condition: u32, yes: u32, no: u32) -> u32 {
    const id = builder.newId(b)
    builder.op5(b, builder.SECTION_FUNCTION, spv.Op.select, type_id, id, condition, yes, no)
    return id
}

fn flagSet(b: *builder.Builder, common: *const Common, flags: u32, flag: u32) -> u32 {
    const masked = op(b, spv.Op.bitwiseAnd, common.*.uint, flags, constant(b, common, flag))
    return op(b, spv.Op.iNotEqual, common.*.boolean, masked, common.*.zero)
}

// (value >> shift) & 255
fn channel(b: *builder.Builder, common: *const Common, value: u32, shift: u32) -> u32 {
    const shifted = if shift == 0 { value } else { op(b, spv.Op.shiftRightLogical, common.*.uint, value, constant(b, common, shift)) }
    return op(b, spv.Op.bitwiseAnd, common.*.uint, shifted, constant(b, common, 255))
}

// 0xFF000000 | red << 16 | green << 8 | blue
fn pack(b: *builder.Builder, common: *const Common, red: u32, green: u32, blue: u32) -> u32 {
    const r = op(b, spv.Op.shiftLeftLogical, common.*.uint, red, constant(b, common, 16))
    const g = op(b, spv.Op.shiftLeftLogical, common.*.uint, green, constant(b, common, 8))
    const rg = op(b, spv.Op.bitwiseOr, common.*.uint, r, g)
    const rgb = op(b, spv.Op.bitwiseOr, common.*.uint, rg, blue)
    return op(b, spv.Op.bitwiseOr, common.*.uint, rgb, constant(b, common, 4278190080))
}

// alpha << 24 | red << 16 | green << 8 | blue
fn packAlpha(b: *builder.Builder, common: *const Common, alpha: u32, red: u32, green: u32, blue: u32) -> u32 {
    const a = op(b, spv.Op.shiftLeftLogical, common.*.uint, alpha, constant(b, common, 24))
    const r = op(b, spv.Op.shiftLeftLogical, common.*.uint, red, constant(b, common, 16))
    const g = op(b, spv.Op.shiftLeftLogical, common.*.uint, green, constant(b, common, 8))
    return op(b, spv.Op.bitwiseOr, common.*.uint, op(b, spv.Op.bitwiseOr, common.*.uint, a, r), op(b, spv.Op.bitwiseOr, common.*.uint, g, blue))
}

fn finish(b: *builder.Builder, common: *const Common, main: u32) -> void {
    var interfaces: [1]u32 = [1]u32{ common.*.globalId }
    unsafe { builder.entryPoint(b, spv.ExecutionModel.glCompute, main, "main", @ptrCast([*]const u32, &interfaces), 1) }
    builder.localSize(b, main, GROUP_SIZE, GROUP_SIZE, 1)
    builder.name(b, main, "main")
}

pub fn buildPattern(b: *builder.Builder) -> void {
    var common: Common = undefined
    declare(b, &common, PATTERN_WORDS, 1)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const width = pushWord(b, &common, 0)
    const height = pushWord(b, &common, 1)
    const time = pushWord(b, &common, 2)
    const pointer_x = pushWord(b, &common, 3)
    const pointer_y = pushWord(b, &common, 4)
    const flags = pushWord(b, &common, 5)
    const inside_x = op(b, spv.Op.uLessThan, common.boolean, x, width)
    const inside_y = op(b, spv.Op.uLessThan, common.boolean, y, height)
    const inside = op(b, spv.Op.logicalAnd, common.boolean, inside_x, inside_y)
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, inside, body, merge)

    const body_label = builder.labelWith(b, body)
    // The pattern.
    const red = op(b, spv.Op.bitwiseAnd, common.uint, op(b, spv.Op.iAdd, common.uint, x, time), constant(b, &common, 255))
    const half_time = op(b, spv.Op.shiftRightLogical, common.uint, time, constant(b, &common, 1))
    const green = op(b, spv.Op.bitwiseAnd, common.uint, op(b, spv.Op.iAdd, common.uint, y, half_time), constant(b, &common, 255))
    const double_time = op(b, spv.Op.shiftLeftLogical, common.uint, time, constant(b, &common, 1))
    const xor = op(b, spv.Op.bitwiseXor, common.uint, x, y)
    const blue = op(b, spv.Op.bitwiseAnd, common.uint, op(b, spv.Op.iAdd, common.uint, xor, double_time), constant(b, &common, 255))
    const color = pack(b, &common, red, green, blue)
    // The ring around the pointer: 30 <= distance < 40.
    const dx = op(b, spv.Op.iSub, common.int, builder.unary(b, spv.Op.bitcast, common.int, x), builder.unary(b, spv.Op.bitcast, common.int, pointer_x))
    const dy = op(b, spv.Op.iSub, common.int, builder.unary(b, spv.Op.bitcast, common.int, y), builder.unary(b, spv.Op.bitcast, common.int, pointer_y))
    const distance = op(b, spv.Op.iAdd, common.int, op(b, spv.Op.iMul, common.int, dx, dx), op(b, spv.Op.iMul, common.int, dy, dy))
    const outer = op(b, spv.Op.sLessThan, common.boolean, distance, builder.constant(b, common.int, 1600))
    const inner = op(b, spv.Op.sGreaterThanEqual, common.boolean, distance, builder.constant(b, common.int, 900))
    const on_ring = op(b, spv.Op.logicalAnd, common.boolean, outer, inner)
    const near = op(b, spv.Op.logicalAnd, common.boolean, on_ring, flagSet(b, &common, flags, FLAG_POINTER))
    const ring_color = select(b, common.uint, flagSet(b, &common, flags, FLAG_PRESSED), constant(b, &common, 4294967295), constant(b, &common, 4294955072))
    const shaded = select(b, common.uint, near, ring_color, color)
    // Red and blue swapped for R8G8B8A8 targets.
    const kept = op(b, spv.Op.bitwiseAnd, common.uint, shaded, constant(b, &common, 4278255360))
    const swapped_red = op(b, spv.Op.shiftLeftLogical, common.uint, channel(b, &common, shaded, 0), constant(b, &common, 16))
    const swapped = op(b, spv.Op.bitwiseOr, common.uint, op(b, spv.Op.bitwiseOr, common.uint, kept, swapped_red), channel(b, &common, shaded, 16))
    const final = select(b, common.uint, flagSet(b, &common, flags, FLAG_SWAP_RED_BLUE), swapped, shaded)
    const index = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, y, width), x)
    builder.store(b, element(b, &common, common.buffers[0], index), final)
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

pub fn buildBlit(b: *builder.Builder) -> void {
    var common: Common = undefined
    declare(b, &common, BLIT_WORDS, 2)
    const function_pointer = builder.typePointer(b, spv.StorageClass.function, common.uint)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    // Function variables come first in the entry block.
    const cover_a = builder.localVariable(b, function_pointer)
    const cover_b = builder.localVariable(b, function_pointer)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const source_width = pushWord(b, &common, 0)
    const source_height = pushWord(b, &common, 1)
    const source_stride = pushWord(b, &common, 2)
    const source_offset = pushWord(b, &common, 3)
    const target_width = pushWord(b, &common, 4)
    const target_height = pushWord(b, &common, 5)
    const target_x = builder.unary(b, spv.Op.bitcast, common.int, pushWord(b, &common, 6))
    const target_y = builder.unary(b, spv.Op.bitcast, common.int, pushWord(b, &common, 7))
    const flags = pushWord(b, &common, 8)
    const target_offset = pushWord(b, &common, 9)
    const target_stride = pushWord(b, &common, 10)
    const in_source = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.uLessThan, common.boolean, x, source_width), op(b, spv.Op.uLessThan, common.boolean, y, source_height))
    const dx = op(b, spv.Op.iAdd, common.int, target_x, builder.unary(b, spv.Op.bitcast, common.int, x))
    const dy = op(b, spv.Op.iAdd, common.int, target_y, builder.unary(b, spv.Op.bitcast, common.int, y))
    const zero = builder.constant(b, common.int, 0)
    const in_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, dx, zero), op(b, spv.Op.sLessThan, common.boolean, dx, builder.unary(b, spv.Op.bitcast, common.int, target_width)))
    const in_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, dy, zero), op(b, spv.Op.sLessThan, common.boolean, dy, builder.unary(b, spv.Op.bitcast, common.int, target_height)))
    const visible = op(b, spv.Op.logicalAnd, common.boolean, in_source, op(b, spv.Op.logicalAnd, common.boolean, in_x, in_y))
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, visible, body, merge)

    const body_label = builder.labelWith(b, body)
    const source_index = op(b, spv.Op.iAdd, common.uint, source_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, y, source_stride), x))
    const source = builder.load(b, common.uint, element(b, &common, common.buffers[0], source_index))
    const target_index = op(b, spv.Op.iAdd, common.uint, target_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, builder.unary(b, spv.Op.bitcast, common.uint, dy), target_stride), builder.unary(b, spv.Op.bitcast, common.uint, dx)))
    const target_pointer = element(b, &common, common.buffers[1], target_index)
    const target = builder.load(b, common.uint, target_pointer)
    const full_alpha = select(b, common.uint, flagSet(b, &common, flags, FLAG_OPAQUE), constant(b, &common, 255), channel(b, &common, source, 24))
    // The masks' coverage (255 without one).
    const cover_first = shapeCoverage(b, &common, cover_a, dx, dy, 11)
    const cover_second = shapeCoverage(b, &common, cover_b, dx, dy, 17)
    const in_first = shapeContains(b, &common, dx, dy, 11)
    const full = constant(b, &common, 255)
    const clipped = select(b, common.uint, in_first, cover_first, full)
    const ring = select(b, common.uint, op(b, spv.Op.uGreaterThan, common.boolean, cover_first, cover_second), op(b, spv.Op.iSub, common.uint, cover_first, cover_second), common.zero)
    const coverage = select(b, common.uint, flagSet(b, &common, flags, FLAG_CLIP_CORNERS), clipped, select(b, common.uint, flagSet(b, &common, flags, FLAG_RING), ring, full))
    // The source and its alpha scaled by the coverage, each (value *
    // coverage + 127) / 255 (unchanged at 255).
    const alpha = scaleBy(b, &common, full_alpha, coverage)
    const inverse = op(b, spv.Op.iSub, common.uint, constant(b, &common, 255), alpha)
    // Each channel, premultiplied: min(255, source + (target * (255 - alpha) + 127) / 255).
    var blended: [3]u32 = [3]u32{ 0, 0, 0 }
    var index: u32 = 0
    while index < 3 {
        const shift = 16 - index * 8
        const kept = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, channel(b, &common, target, shift), inverse), constant(b, &common, 127))
        const sum = op(b, spv.Op.iAdd, common.uint, scaleBy(b, &common, channel(b, &common, source, shift), coverage), op(b, spv.Op.uDiv, common.uint, kept, constant(b, &common, 255)))
        const saturated = op(b, spv.Op.uGreaterThan, common.boolean, sum, constant(b, &common, 255))
        blended[index] = select(b, common.uint, saturated, constant(b, &common, 255), sum)
        index += 1
    }
    // The target's alpha likewise: 255 over an opaque target.
    const kept_alpha = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, channel(b, &common, target, 24), inverse), constant(b, &common, 127))
    const alpha_sum = op(b, spv.Op.iAdd, common.uint, alpha, op(b, spv.Op.uDiv, common.uint, kept_alpha, constant(b, &common, 255)))
    const out_alpha = select(b, common.uint, op(b, spv.Op.uGreaterThan, common.boolean, alpha_sum, constant(b, &common, 255)), constant(b, &common, 255), alpha_sum)
    builder.store(b, target_pointer, packAlpha(b, &common, out_alpha, blended[0], blended[1], blended[2]))
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

fn signed(b: *builder.Builder, common: *const Common, value: u32) -> u32 {
    return builder.unary(b, spv.Op.bitcast, common.*.int, value)
}

// (value * coverage + 127) / 255
fn scaleBy(b: *builder.Builder, common: *const Common, value: u32, coverage: u32) -> u32 {
    const product = op(b, spv.Op.iAdd, common.*.uint, op(b, spv.Op.iMul, common.*.uint, value, coverage), constant(b, common, 127))
    return op(b, spv.Op.uDiv, common.*.uint, product, constant(b, common, 255))
}

// Whether output pixel (x, y) (signed) is in the rectangle of the Blit
// shape whose words start at push word `first`.
fn shapeContains(b: *builder.Builder, common: *const Common, x: u32, y: u32, first: u32) -> u32 {
    const zero = intConstant(b, common, 0)
    const lx = op(b, spv.Op.iSub, common.*.int, x, signed(b, common, pushWord(b, common, first)))
    const ly = op(b, spv.Op.iSub, common.*.int, y, signed(b, common, pushWord(b, common, first + 1)))
    const width = signed(b, common, pushWord(b, common, first + 2))
    const height = signed(b, common, pushWord(b, common, first + 3))
    const in_x = op(b, spv.Op.logicalAnd, common.*.boolean, op(b, spv.Op.sGreaterThanEqual, common.*.boolean, lx, zero), op(b, spv.Op.sLessThan, common.*.boolean, lx, width))
    const in_y = op(b, spv.Op.logicalAnd, common.*.boolean, op(b, spv.Op.sGreaterThanEqual, common.*.boolean, ly, zero), op(b, spv.Op.sLessThan, common.*.boolean, ly, height))
    return op(b, spv.Op.logicalAnd, common.*.boolean, in_x, in_y)
}

// The coverage of output pixel (x, y) by the Blit shape whose words start
// at push word `first` (scene.shapeCoverage): the top radius in the upper
// half, the bottom one in the lower half.
fn shapeCoverage(b: *builder.Builder, common: *const Common, variable: u32, x: u32, y: u32, first: u32) -> u32 {
    const lx = op(b, spv.Op.iSub, common.*.int, x, signed(b, common, pushWord(b, common, first)))
    const ly = op(b, spv.Op.iSub, common.*.int, y, signed(b, common, pushWord(b, common, first + 1)))
    const width = signed(b, common, pushWord(b, common, first + 2))
    const height = signed(b, common, pushWord(b, common, first + 3))
    const upper = op(b, spv.Op.sLessThan, common.*.boolean, op(b, spv.Op.iMul, common.*.int, ly, intConstant(b, common, 2)), height)
    const radius = select(b, common.*.int, upper, signed(b, common, pushWord(b, common, first + 4)), signed(b, common, pushWord(b, common, first + 5)))
    return emitRounded(b, common, variable, lx, ly, width, height, radius)
}

pub fn buildText(b: *builder.Builder) -> void {
    var common: Common = undefined
    declare(b, &common, TEXT_WORDS, 3)
    const function_pointer = builder.typePointer(b, spv.StorageClass.function, common.uint)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    // Function variables come first in the entry block.
    const counter = builder.localVariable(b, function_pointer)
    const coverage = builder.localVariable(b, function_pointer)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const target_width = pushWord(b, &common, 0)
    const target_height = pushWord(b, &common, 1)
    const target_offset = pushWord(b, &common, 2)
    const origin_x = signed(b, &common, pushWord(b, &common, 3))
    const origin_y = signed(b, &common, pushWord(b, &common, 4))
    const box_left = signed(b, &common, pushWord(b, &common, 5))
    const box_top = signed(b, &common, pushWord(b, &common, 6))
    const box_width = pushWord(b, &common, 7)
    const box_height = pushWord(b, &common, 8)
    const count = pushWord(b, &common, 9)
    const atlas_width = pushWord(b, &common, 10)
    const color = pushWord(b, &common, 11)
    const run_offset = pushWord(b, &common, 12)
    const base_coverage = pushWord(b, &common, 13)
    const target_stride = pushWord(b, &common, 14)
    const zero_int = builder.constant(b, common.int, 0)
    // The run pixel (relative to the origin) and the target pixel.
    const run_x = op(b, spv.Op.iAdd, common.int, box_left, signed(b, &common, x))
    const run_y = op(b, spv.Op.iAdd, common.int, box_top, signed(b, &common, y))
    const target_x = op(b, spv.Op.iAdd, common.int, origin_x, run_x)
    const target_y = op(b, spv.Op.iAdd, common.int, origin_y, run_y)
    const in_box = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.uLessThan, common.boolean, x, box_width), op(b, spv.Op.uLessThan, common.boolean, y, box_height))
    const in_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, target_x, zero_int), op(b, spv.Op.sLessThan, common.boolean, target_x, signed(b, &common, target_width)))
    const in_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, target_y, zero_int), op(b, spv.Op.sLessThan, common.boolean, target_y, signed(b, &common, target_height)))
    const visible = op(b, spv.Op.logicalAnd, common.boolean, in_box, op(b, spv.Op.logicalAnd, common.boolean, in_x, in_y))
    const body = builder.newId(b)
    const done = builder.newId(b)
    builder.selectionMerge(b, done)
    builder.branchConditional(b, visible, body, done)

    const body_label = builder.labelWith(b, body)
    builder.store(b, counter, common.zero)
    builder.store(b, coverage, base_coverage)
    const header = builder.newId(b)
    const condition_block = builder.newId(b)
    const loop_body = builder.newId(b)
    const continue_block = builder.newId(b)
    const loop_end = builder.newId(b)
    builder.branch(b, header)

    // for (i = 0; i < count; i += 1)
    const header_label = builder.labelWith(b, header)
    builder.loopMerge(b, loop_end, continue_block)
    builder.branch(b, condition_block)

    const condition_label = builder.labelWith(b, condition_block)
    const index = builder.load(b, common.uint, counter)
    const more = op(b, spv.Op.uLessThan, common.boolean, index, count)
    builder.branchConditional(b, more, loop_body, loop_end)

    const loop_body_label = builder.labelWith(b, loop_body)
    const base = op(b, spv.Op.iAdd, common.uint, run_offset, op(b, spv.Op.shiftLeftLogical, common.uint, index, constant(b, &common, 2)))
    const word0 = builder.load(b, common.uint, element(b, &common, common.buffers[1], base))
    const word1 = builder.load(b, common.uint, element(b, &common, common.buffers[1], op(b, spv.Op.iAdd, common.uint, base, constant(b, &common, 1))))
    const quad_x = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[1], op(b, spv.Op.iAdd, common.uint, base, constant(b, &common, 2)))))
    const quad_y = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[1], op(b, spv.Op.iAdd, common.uint, base, constant(b, &common, 3)))))
    const mask = constant(b, &common, 65535)
    const sixteen = constant(b, &common, 16)
    const atlas_x = op(b, spv.Op.bitwiseAnd, common.uint, word0, mask)
    const atlas_y = op(b, spv.Op.shiftRightLogical, common.uint, word0, sixteen)
    const quad_width = signed(b, &common, op(b, spv.Op.bitwiseAnd, common.uint, word1, mask))
    const quad_height = signed(b, &common, op(b, spv.Op.shiftRightLogical, common.uint, word1, sixteen))
    const local_x = op(b, spv.Op.iSub, common.int, run_x, quad_x)
    const local_y = op(b, spv.Op.iSub, common.int, run_y, quad_y)
    const inside_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, local_x, zero_int), op(b, spv.Op.sLessThan, common.boolean, local_x, quad_width))
    const inside_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, local_y, zero_int), op(b, spv.Op.sLessThan, common.boolean, local_y, quad_height))
    const inside = op(b, spv.Op.logicalAnd, common.boolean, inside_x, inside_y)
    const sample = builder.newId(b)
    const sampled = builder.newId(b)
    builder.selectionMerge(b, sampled)
    builder.branchConditional(b, inside, sample, sampled)

    const sample_label = builder.labelWith(b, sample)
    const row = op(b, spv.Op.iAdd, common.uint, atlas_y, builder.unary(b, spv.Op.bitcast, common.uint, local_y))
    const column = op(b, spv.Op.iAdd, common.uint, atlas_x, builder.unary(b, spv.Op.bitcast, common.uint, local_x))
    const byte_index = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, row, atlas_width), column)
    const word = builder.load(b, common.uint, element(b, &common, common.buffers[0], op(b, spv.Op.shiftRightLogical, common.uint, byte_index, constant(b, &common, 2))))
    const shift = op(b, spv.Op.shiftLeftLogical, common.uint, op(b, spv.Op.bitwiseAnd, common.uint, byte_index, constant(b, &common, 3)), constant(b, &common, 3))
    const value = op(b, spv.Op.bitwiseAnd, common.uint, op(b, spv.Op.shiftRightLogical, common.uint, word, shift), constant(b, &common, 255))
    const current = builder.load(b, common.uint, coverage)
    builder.store(b, coverage, select(b, common.uint, op(b, spv.Op.uGreaterThan, common.boolean, value, current), value, current))
    builder.branch(b, sampled)

    const sampled_label = builder.labelWith(b, sampled)
    builder.branch(b, continue_block)

    const continue_label = builder.labelWith(b, continue_block)
    builder.store(b, counter, op(b, spv.Op.iAdd, common.uint, index, constant(b, &common, 1)))
    builder.branch(b, header)

    // Blend: alpha = (coverage * color alpha + 127) / 255; each channel
    // (color * alpha + target * (255 - alpha) + 127) / 255.
    const loop_end_label = builder.labelWith(b, loop_end)
    const final_coverage = builder.load(b, common.uint, coverage)
    const covered = op(b, spv.Op.iNotEqual, common.boolean, final_coverage, common.zero)
    const blend = builder.newId(b)
    const blended = builder.newId(b)
    builder.selectionMerge(b, blended)
    builder.branchConditional(b, covered, blend, blended)

    const blend_label = builder.labelWith(b, blend)
    const target_index = op(b, spv.Op.iAdd, common.uint, target_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, builder.unary(b, spv.Op.bitcast, common.uint, target_y), target_stride), builder.unary(b, spv.Op.bitcast, common.uint, target_x)))
    const target_pointer = element(b, &common, common.buffers[2], target_index)
    const under = builder.load(b, common.uint, target_pointer)
    const c255 = constant(b, &common, 255)
    const c127 = constant(b, &common, 127)
    const alpha = op(b, spv.Op.uDiv, common.uint, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, final_coverage, channel(b, &common, color, 24)), c127), c255)
    const inverse = op(b, spv.Op.iSub, common.uint, c255, alpha)
    var mixed: [3]u32 = [3]u32{ 0, 0, 0 }
    var channel_index: u32 = 0
    while channel_index < 3 {
        const shift_bits = 16 - channel_index * 8
        const sum = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, channel(b, &common, color, shift_bits), alpha), op(b, spv.Op.iMul, common.uint, channel(b, &common, under, shift_bits), inverse)), c127)
        mixed[channel_index] = op(b, spv.Op.uDiv, common.uint, sum, c255)
        channel_index += 1
    }
    builder.store(b, target_pointer, pack(b, &common, mixed[0], mixed[1], mixed[2]))
    builder.branch(b, blended)

    const blended_label = builder.labelWith(b, blended)
    builder.branch(b, done)

    const done_label = builder.labelWith(b, done)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

fn unsigned(b: *builder.Builder, common: *const Common, value: u32) -> u32 {
    return builder.unary(b, spv.Op.bitcast, common.*.uint, value)
}

// min(max(value, 0), limit - 1) for signed `value` and unsigned `limit`.
fn clampToCount(b: *builder.Builder, common: *const Common, value: u32, limit: u32) -> u32 {
    const zero = builder.constant(b, common.*.int, 0)
    const last = op(b, spv.Op.iSub, common.*.int, signed(b, common, limit), builder.constant(b, common.*.int, 1))
    const low = select(b, common.*.int, op(b, spv.Op.sLessThan, common.*.boolean, value, zero), zero, value)
    return select(b, common.*.int, op(b, spv.Op.sGreaterThan, common.*.boolean, low, last), last, low)
}

pub fn buildBlurPass(b: *builder.Builder) -> void {
    var common: Common = undefined
    declare(b, &common, BLUR_PASS_WORDS, 2)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const width = pushWord(b, &common, 0)
    const height = pushWord(b, &common, 1)
    const source_offset = pushWord(b, &common, 2)
    const source_stride = pushWord(b, &common, 3)
    const target_offset = pushWord(b, &common, 4)
    const target_stride = pushWord(b, &common, 5)
    const vertical = op(b, spv.Op.iNotEqual, common.boolean, pushWord(b, &common, 6), common.zero)
    const inside = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.uLessThan, common.boolean, x, width), op(b, spv.Op.uLessThan, common.boolean, y, height))
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, inside, body, merge)

    const body_label = builder.labelWith(b, body)
    const sx = signed(b, &common, x)
    const sy = signed(b, &common, y)
    var sums: [4]u32 = [4]u32{ common.zero, common.zero, common.zero, common.zero }
    var offset: i32 = 0 - BLUR_RADIUS
    while offset <= BLUR_RADIUS {
        const step = builder.constant(b, common.int, @bitCast(u32, offset))
        const along_x = clampToCount(b, &common, op(b, spv.Op.iAdd, common.int, sx, step), width)
        const along_y = clampToCount(b, &common, op(b, spv.Op.iAdd, common.int, sy, step), height)
        const column = unsigned(b, &common, select(b, common.int, vertical, sx, along_x))
        const row = unsigned(b, &common, select(b, common.int, vertical, along_y, sy))
        const index = op(b, spv.Op.iAdd, common.uint, source_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, row, source_stride), column))
        const pixel = builder.load(b, common.uint, element(b, &common, common.buffers[0], index))
        var channel_index: u32 = 0
        while channel_index < 4 {
            sums[channel_index] = op(b, spv.Op.iAdd, common.uint, sums[channel_index], channel(b, &common, pixel, 24 - channel_index * 8))
            channel_index += 1
        }
        offset += 1
    }
    const window = constant(b, &common, @intCast(u32, BLUR_RADIUS * 2 + 1))
    var result = common.zero
    var channel_index: u32 = 0
    while channel_index < 4 {
        const mean = op(b, spv.Op.uDiv, common.uint, sums[channel_index], window)
        const placed = op(b, spv.Op.shiftLeftLogical, common.uint, mean, constant(b, &common, 24 - channel_index * 8))
        result = op(b, spv.Op.bitwiseOr, common.uint, result, placed)
        channel_index += 1
    }
    const target_index = op(b, spv.Op.iAdd, common.uint, target_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, y, target_stride), x))
    builder.store(b, element(b, &common, common.buffers[1], target_index), result)
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

pub fn buildBlurMask(b: *builder.Builder) -> void {
    var common: Common = undefined
    declare(b, &common, BLUR_MASK_WORDS, 3)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const width = pushWord(b, &common, 0)
    const height = pushWord(b, &common, 1)
    const source_offset = pushWord(b, &common, 2)
    const source_stride = pushWord(b, &common, 3)
    const target_offset = pushWord(b, &common, 4)
    const target_stride = pushWord(b, &common, 5)
    const area_x = pushWord(b, &common, 6)
    const area_y = pushWord(b, &common, 7)
    const origin_x = signed(b, &common, pushWord(b, &common, 8))
    const origin_y = signed(b, &common, pushWord(b, &common, 9))
    const ops_offset = pushWord(b, &common, 10)
    const op_count = pushWord(b, &common, 11)
    const in_area = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.uLessThan, common.boolean, x, width), op(b, spv.Op.uLessThan, common.boolean, y, height))
    const out_x = op(b, spv.Op.iAdd, common.uint, area_x, x)
    const out_y = op(b, spv.Op.iAdd, common.uint, area_y, y)
    // The pixel relative to the surface.
    const relative_x = op(b, spv.Op.iSub, common.int, signed(b, &common, out_x), origin_x)
    const relative_y = op(b, spv.Op.iSub, common.int, signed(b, &common, out_y), origin_y)
    var covered = builder.constantBool(b, common.boolean, false)
    var index: u32 = 0
    while index < BLUR_OPS {
        const base = op(b, spv.Op.iAdd, common.uint, ops_offset, constant(b, &common, index * 5))
        const subtract = builder.load(b, common.uint, element(b, &common, common.buffers[2], base))
        const rect_x = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[2], op(b, spv.Op.iAdd, common.uint, base, constant(b, &common, 1)))))
        const rect_y = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[2], op(b, spv.Op.iAdd, common.uint, base, constant(b, &common, 2)))))
        const rect_width = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[2], op(b, spv.Op.iAdd, common.uint, base, constant(b, &common, 3)))))
        const rect_height = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[2], op(b, spv.Op.iAdd, common.uint, base, constant(b, &common, 4)))))
        const in_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, relative_x, rect_x), op(b, spv.Op.sLessThan, common.boolean, relative_x, op(b, spv.Op.iAdd, common.int, rect_x, rect_width)))
        const in_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, relative_y, rect_y), op(b, spv.Op.sLessThan, common.boolean, relative_y, op(b, spv.Op.iAdd, common.int, rect_y, rect_height)))
        const counted = op(b, spv.Op.uLessThan, common.boolean, constant(b, &common, index), op_count)
        const hit = op(b, spv.Op.logicalAnd, common.boolean, counted, op(b, spv.Op.logicalAnd, common.boolean, in_x, in_y))
        const adds = op(b, spv.Op.iEqual, common.boolean, subtract, common.zero)
        covered = select(b, common.boolean, hit, adds, covered)
        index += 1
    }
    const copy = op(b, spv.Op.logicalAnd, common.boolean, in_area, covered)
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, copy, body, merge)

    const body_label = builder.labelWith(b, body)
    const source_index = op(b, spv.Op.iAdd, common.uint, source_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, y, source_stride), x))
    const pixel = builder.load(b, common.uint, element(b, &common, common.buffers[0], source_index))
    const target_index = op(b, spv.Op.iAdd, common.uint, target_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, out_y, target_stride), out_x))
    builder.store(b, element(b, &common, common.buffers[1], target_index), pixel)
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

// ---------------------------------------------------------------------------
// paint: the desktop apps' canvas on the GPU (examples/desktop-shared)

// Draws every pixel of a width x height image once from a list of commands
// (binding 1, PAINT_COMMAND_WORDS words each from `commandOffset`), in
// order, each blended over what the ones before made, the way
// examples/desktop-shared/canvas.mlx draws on the CPU (the same integer
// arithmetic: the same pixels). Binding 0 is the target (rows
// `targetStride` pixels apart from `targetOffset`), binding 2 a heap of
// images (premultiplied ARGB words) and glyph atlases (coverage bytes,
// four a word). Binding 1 also holds the glyph quads (four words each, as
// the text shader's).
//
// With `tileColumns` set, a pixel looks only at the commands of its tile
// (PAINT_TILE pixels square, tiles row by row, `tileColumns` a row): from
// `tileOffset` in binding 1 each tile has two words, where its list starts
// (binding 1 words) and how long it is; each entry of a list is two words,
// the command's index and, for GLYPHS, the quads that reach into the
// tile's columns (the first << 16 | how many). Without, every pixel looks
// at every command.
pub const Paint = struct {
    width: u32
    height: u32
    targetOffset: u32
    targetStride: u32
    commandOffset: u32
    commandCount: u32
    tileColumns: u32
    tileOffset: u32
}

pub const PAINT_WORDS: u32 = 8
pub const PAINT_TILE_SHIFT: u32 = 5
pub const PAINT_TILE: u32 = 32
pub const PAINT_COMMAND_WORDS: u32 = 16

// Command words: 0 kind, 1 x, 2 y, 3 width, 4 height (the box it touches;
// signed), then by kind:
//   CLEAR   7 color: the pixel becomes it
//   FILL    5 radius, 7 color: a rounded rectangle, 4x4 samples at corners
//   STROKE  5 radius, 6 thickness, 7 color: its outline inside it
//   IMAGE   8 image offset (heap words), 9 its width, 10 its height, 11
//           opacity: the image scaled into the box (bilinear)
//   GLYPHS  7 color, 8 quad offset (binding 1 words), 9 quad count,
//           10 atlas offset (heap bytes), 11 atlas width, 12 origin x,
//           13 origin y (the baseline), 14 limit (columns from origin x
//           drawn; 0: all)
pub const PAINT_CLEAR: u32 = 0
pub const PAINT_FILL: u32 = 1
pub const PAINT_STROKE: u32 = 2
pub const PAINT_IMAGE: u32 = 3
pub const PAINT_GLYPHS: u32 = 4

fn intConstant(b: *builder.Builder, common: *const Common, value: i32) -> u32 {
    return builder.constant(b, common.*.int, @bitCast(u32, value))
}

// `a < b ? a : b` and the like, on signed values.
fn smallerInt(b: *builder.Builder, common: *const Common, a: u32, c: u32) -> u32 {
    return select(b, common.*.int, op(b, spv.Op.sLessThan, common.*.boolean, a, c), a, c)
}

fn smallerUint(b: *builder.Builder, common: *const Common, a: u32, c: u32) -> u32 {
    return select(b, common.*.uint, op(b, spv.Op.uLessThan, common.*.boolean, a, c), a, c)
}

// canvas.over: `color` (premultiplied) at `coverage` (0-255) over `under`.
fn emitOver(b: *builder.Builder, common: *const Common, under: u32, color: u32, coverage: u32) -> u32 {
    const c255 = constant(b, common, 255)
    const c127 = constant(b, common, 127)
    const partial = op(b, spv.Op.uLessThan, common.*.boolean, coverage, c255)
    var scaled: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    var index: u32 = 0
    while index < 4 {
        const value = channel(b, common, color, 24 - index * 8)
        const reduced = op(b, spv.Op.uDiv, common.*.uint, op(b, spv.Op.iAdd, common.*.uint, op(b, spv.Op.iMul, common.*.uint, value, coverage), c127), c255)
        scaled[index] = select(b, common.*.uint, partial, reduced, value)
        index += 1
    }
    const alpha = scaled[0]
    const keep = op(b, spv.Op.iSub, common.*.uint, c255, alpha)
    var opaque = common.*.zero
    var mixed = common.*.zero
    index = 0
    while index < 4 {
        const shift = constant(b, common, 24 - index * 8)
        opaque = op(b, spv.Op.bitwiseOr, common.*.uint, opaque, op(b, spv.Op.shiftLeftLogical, common.*.uint, scaled[index], shift))
        const kept = op(b, spv.Op.uDiv, common.*.uint, op(b, spv.Op.iAdd, common.*.uint, op(b, spv.Op.iMul, common.*.uint, channel(b, common, under, 24 - index * 8), keep), c127), c255)
        const sum = smallerUint(b, common, op(b, spv.Op.iAdd, common.*.uint, scaled[index], kept), c255)
        mixed = op(b, spv.Op.bitwiseOr, common.*.uint, mixed, op(b, spv.Op.shiftLeftLogical, common.*.uint, sum, shift))
        index += 1
    }
    const full = op(b, spv.Op.iEqual, common.*.boolean, alpha, c255)
    const blended = select(b, common.*.uint, full, opaque, mixed)
    return select(b, common.*.uint, op(b, spv.Op.iEqual, common.*.boolean, coverage, common.*.zero), under, blended)
}

// canvas.roundedCoverage of (lx, ly) in a width x height rectangle with
// corners of `radius` (all signed), through `variable` (a function
// variable of uint): 0 outside, 255 off the corners, else 4x4 samples.
fn emitRounded(b: *builder.Builder, common: *const Common, variable: u32, lx: u32, ly: u32, width: u32, height: u32, radius: u32) -> u32 {
    const zero = intConstant(b, common, 0)
    const one = intConstant(b, common, 1)
    const outside_x = op(b, spv.Op.logicalOr, common.*.boolean, op(b, spv.Op.sLessThan, common.*.boolean, lx, zero), op(b, spv.Op.sGreaterThanEqual, common.*.boolean, lx, width))
    const outside_y = op(b, spv.Op.logicalOr, common.*.boolean, op(b, spv.Op.sLessThan, common.*.boolean, ly, zero), op(b, spv.Op.sGreaterThanEqual, common.*.boolean, ly, height))
    const outside = op(b, spv.Op.logicalOr, common.*.boolean, outside_x, outside_y)
    const right_edge = op(b, spv.Op.iSub, common.*.int, width, radius)
    const bottom_edge = op(b, spv.Op.iSub, common.*.int, height, radius)
    const left_corner = op(b, spv.Op.sLessThan, common.*.boolean, lx, radius)
    const right_corner = op(b, spv.Op.sGreaterThanEqual, common.*.boolean, lx, right_edge)
    const top_corner = op(b, spv.Op.sLessThan, common.*.boolean, ly, radius)
    const bottom_corner = op(b, spv.Op.sGreaterThanEqual, common.*.boolean, ly, bottom_edge)
    const dx = select(b, common.*.int, left_corner, op(b, spv.Op.iSub, common.*.int, op(b, spv.Op.iSub, common.*.int, radius, one), lx), select(b, common.*.int, right_corner, op(b, spv.Op.iSub, common.*.int, lx, right_edge), zero))
    const dy = select(b, common.*.int, top_corner, op(b, spv.Op.iSub, common.*.int, op(b, spv.Op.iSub, common.*.int, radius, one), ly), select(b, common.*.int, bottom_corner, op(b, spv.Op.iSub, common.*.int, ly, bottom_edge), zero))
    const middle_x = op(b, spv.Op.logicalAnd, common.*.boolean, op(b, spv.Op.sGreaterThanEqual, common.*.boolean, lx, radius), op(b, spv.Op.sLessThan, common.*.boolean, lx, right_edge))
    const middle_y = op(b, spv.Op.logicalAnd, common.*.boolean, op(b, spv.Op.sGreaterThanEqual, common.*.boolean, ly, radius), op(b, spv.Op.sLessThan, common.*.boolean, ly, bottom_edge))
    const middle = op(b, spv.Op.logicalOr, common.*.boolean, middle_x, middle_y)
    builder.store(b, variable, select(b, common.*.uint, outside, common.*.zero, constant(b, common, 255)))
    const corner = op(b, spv.Op.logicalAnd, common.*.boolean, builder.unary(b, spv.Op.logicalNot, common.*.boolean, outside), builder.unary(b, spv.Op.logicalNot, common.*.boolean, middle))
    const sampled = builder.newId(b)
    const done = builder.newId(b)
    builder.selectionMerge(b, done)
    builder.branchConditional(b, corner, sampled, done)

    const sampled_label = builder.labelWith(b, sampled)
    const limit = op(b, spv.Op.iMul, common.*.int, op(b, spv.Op.iMul, common.*.int, radius, radius), intConstant(b, common, 64))
    const base_x = op(b, spv.Op.iMul, common.*.int, dx, intConstant(b, common, 8))
    const base_y = op(b, spv.Op.iMul, common.*.int, dy, intConstant(b, common, 8))
    var inside = common.*.zero
    var sy: i32 = 0
    while sy < 4 {
        const py = op(b, spv.Op.iAdd, common.*.int, base_y, intConstant(b, common, sy * 2 + 1))
        const py2 = op(b, spv.Op.iMul, common.*.int, py, py)
        var sx: i32 = 0
        while sx < 4 {
            const px = op(b, spv.Op.iAdd, common.*.int, base_x, intConstant(b, common, sx * 2 + 1))
            const distance = op(b, spv.Op.iAdd, common.*.int, op(b, spv.Op.iMul, common.*.int, px, px), py2)
            const hit = op(b, spv.Op.sLessThanEqual, common.*.boolean, distance, limit)
            inside = op(b, spv.Op.iAdd, common.*.uint, inside, select(b, common.*.uint, hit, constant(b, common, 1), common.*.zero))
            sx += 1
        }
        sy += 1
    }
    builder.store(b, variable, op(b, spv.Op.uDiv, common.*.uint, op(b, spv.Op.iMul, common.*.uint, inside, constant(b, common, 255)), constant(b, common, 16)))
    builder.branch(b, done)

    const done_label = builder.labelWith(b, done)
    return builder.load(b, common.*.uint, variable)
}

// canvas.clampTo: value into 0 .. limit - 1 (signed).
fn clampSigned(b: *builder.Builder, common: *const Common, value: u32, limit: u32) -> u32 {
    const zero = intConstant(b, common, 0)
    const last = op(b, spv.Op.iSub, common.*.int, limit, intConstant(b, common, 1))
    const low = select(b, common.*.int, op(b, spv.Op.sLessThan, common.*.boolean, value, zero), zero, value)
    return select(b, common.*.int, op(b, spv.Op.sGreaterThan, common.*.boolean, low, last), last, low)
}

// canvas.sample: the image pixel at (sx, sy) in 1/256 pixels, bilinear.
fn emitSample(b: *builder.Builder, common: *const Common, heap: u32, image_offset: u32, width: u32, height: u32, sx: u32, sy: u32) -> u32 {
    const zero = intConstant(b, common, 0)
    const c256 = intConstant(b, common, 256)
    const negative_x = op(b, spv.Op.sLessThan, common.*.boolean, sx, zero)
    const negative_y = op(b, spv.Op.sLessThan, common.*.boolean, sy, zero)
    const x0 = clampSigned(b, common, select(b, common.*.int, negative_x, zero, op(b, spv.Op.sDiv, common.*.int, sx, c256)), width)
    const y0 = clampSigned(b, common, select(b, common.*.int, negative_y, zero, op(b, spv.Op.sDiv, common.*.int, sy, c256)), height)
    const x1 = clampSigned(b, common, op(b, spv.Op.iAdd, common.*.int, x0, intConstant(b, common, 1)), width)
    const y1 = clampSigned(b, common, op(b, spv.Op.iAdd, common.*.int, y0, intConstant(b, common, 1)), height)
    const fx = unsigned(b, common, select(b, common.*.int, negative_x, zero, op(b, spv.Op.sRem, common.*.int, sx, c256)))
    const fy = unsigned(b, common, select(b, common.*.int, negative_y, zero, op(b, spv.Op.sRem, common.*.int, sy, c256)))
    const row0 = op(b, spv.Op.iMul, common.*.int, y0, width)
    const row1 = op(b, spv.Op.iMul, common.*.int, y1, width)
    const a = builder.load(b, common.*.uint, element(b, common, heap, op(b, spv.Op.iAdd, common.*.uint, image_offset, unsigned(b, common, op(b, spv.Op.iAdd, common.*.int, row0, x0)))))
    const pb = builder.load(b, common.*.uint, element(b, common, heap, op(b, spv.Op.iAdd, common.*.uint, image_offset, unsigned(b, common, op(b, spv.Op.iAdd, common.*.int, row0, x1)))))
    const c = builder.load(b, common.*.uint, element(b, common, heap, op(b, spv.Op.iAdd, common.*.uint, image_offset, unsigned(b, common, op(b, spv.Op.iAdd, common.*.int, row1, x0)))))
    const d = builder.load(b, common.*.uint, element(b, common, heap, op(b, spv.Op.iAdd, common.*.uint, image_offset, unsigned(b, common, op(b, spv.Op.iAdd, common.*.int, row1, x1)))))
    const u256 = constant(b, common, 256)
    const left_x = op(b, spv.Op.iSub, common.*.uint, u256, fx)
    const upper_y = op(b, spv.Op.iSub, common.*.uint, u256, fy)
    var result = common.*.zero
    var shift: u32 = 0
    while shift < 32 {
        const top = op(b, spv.Op.iAdd, common.*.uint, op(b, spv.Op.iMul, common.*.uint, channel(b, common, a, shift), left_x), op(b, spv.Op.iMul, common.*.uint, channel(b, common, pb, shift), fx))
        const bottom = op(b, spv.Op.iAdd, common.*.uint, op(b, spv.Op.iMul, common.*.uint, channel(b, common, c, shift), left_x), op(b, spv.Op.iMul, common.*.uint, channel(b, common, d, shift), fx))
        const value = op(b, spv.Op.uDiv, common.*.uint, op(b, spv.Op.iAdd, common.*.uint, op(b, spv.Op.iMul, common.*.uint, top, upper_y), op(b, spv.Op.iMul, common.*.uint, bottom, fy)), constant(b, common, 65536))
        const placed = if shift == 0 { smallerUint(b, common, value, constant(b, common, 255)) } else { op(b, spv.Op.shiftLeftLogical, common.*.uint, smallerUint(b, common, value, constant(b, common, 255)), constant(b, common, shift)) }
        result = op(b, spv.Op.bitwiseOr, common.*.uint, result, placed)
        shift += 8
    }
    return result
}

// A command word (signed or not) at `base + index` of binding 1.
fn commandWord(b: *builder.Builder, common: *const Common, base: u32, index: u32) -> u32 {
    return builder.load(b, common.*.uint, element(b, common, common.*.buffers[1], op(b, spv.Op.iAdd, common.*.uint, base, constant(b, common, index))))
}

// Opens `if (kind == value)`: returns the merge block to close it with
// closeIf.
fn openKind(b: *builder.Builder, common: *const Common, kind: u32, value: u32) -> u32 {
    // (OpSelectionMerge must come right before the branch.)
    const matches = op(b, spv.Op.iEqual, common.*.boolean, kind, constant(b, common, value))
    const then = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, matches, then, merge)
    const then_label = builder.labelWith(b, then)
    return merge
}

fn closeIf(b: *builder.Builder, merge: u32) -> void {
    builder.branch(b, merge)
    const merge_label = builder.labelWith(b, merge)
}

pub fn buildPaint(b: *builder.Builder) -> void { buildPaintParts(b, 31) }

// buildPaint with only some kinds of commands (bit 1 << kind): for finding
// what a driver does not take.
pub fn buildPaintParts(b: *builder.Builder, parts: u32) -> void {
    var common: Common = undefined
    declare(b, &common, PAINT_WORDS, 3)
    const function_pointer = builder.typePointer(b, spv.StorageClass.function, common.uint)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    // Function variables come first in the entry block.
    const result = builder.localVariable(b, function_pointer)
    const counter = builder.localVariable(b, function_pointer)
    const cover_first = builder.localVariable(b, function_pointer)
    const cover_second = builder.localVariable(b, function_pointer)
    const quad_counter = builder.localVariable(b, function_pointer)
    const glyph_cover = builder.localVariable(b, function_pointer)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const width = pushWord(b, &common, 0)
    const height = pushWord(b, &common, 1)
    const target_offset = pushWord(b, &common, 2)
    const target_stride = pushWord(b, &common, 3)
    const command_offset = pushWord(b, &common, 4)
    const command_count = pushWord(b, &common, 5)
    const tile_columns = pushWord(b, &common, 6)
    const tile_offset = pushWord(b, &common, 7)
    const zero_int = intConstant(b, &common, 0)
    const inside_target = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.uLessThan, common.boolean, x, width), op(b, spv.Op.uLessThan, common.boolean, y, height))
    const body = builder.newId(b)
    const done = builder.newId(b)
    builder.selectionMerge(b, done)
    builder.branchConditional(b, inside_target, body, done)

    const body_label = builder.labelWith(b, body)
    const px = signed(b, &common, x)
    const py = signed(b, &common, y)
    // The pixel's tile and its list (word 0 when not tiled: loaded, unused).
    const tiled = op(b, spv.Op.iNotEqual, common.boolean, tile_columns, common.zero)
    const tile_shift = constant(b, &common, PAINT_TILE_SHIFT)
    const tile = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.shiftRightLogical, common.uint, x, tile_shift), op(b, spv.Op.iMul, common.uint, op(b, spv.Op.shiftRightLogical, common.uint, y, tile_shift), tile_columns))
    const tile_header = select(b, common.uint, tiled, op(b, spv.Op.iAdd, common.uint, tile_offset, op(b, spv.Op.shiftLeftLogical, common.uint, tile, constant(b, &common, 1))), common.zero)
    const list_start = commandWord(b, &common, tile_header, 0)
    const list_length = commandWord(b, &common, tile_header, 1)
    const loop_count = select(b, common.uint, tiled, list_length, command_count)
    builder.store(b, result, common.zero)
    builder.store(b, counter, common.zero)
    const header = builder.newId(b)
    const condition_block = builder.newId(b)
    const loop_body = builder.newId(b)
    const continue_block = builder.newId(b)
    const loop_end = builder.newId(b)
    builder.branch(b, header)

    // for (i = 0; i < count; i += 1)
    const header_label = builder.labelWith(b, header)
    builder.loopMerge(b, loop_end, continue_block)
    builder.branch(b, condition_block)

    const condition_label = builder.labelWith(b, condition_block)
    const index = builder.load(b, common.uint, counter)
    builder.branchConditional(b, op(b, spv.Op.uLessThan, common.boolean, index, loop_count), loop_body, loop_end)

    const loop_body_label = builder.labelWith(b, loop_body)
    const entry_word = select(b, common.uint, tiled, op(b, spv.Op.iAdd, common.uint, list_start, op(b, spv.Op.shiftLeftLogical, common.uint, index, constant(b, &common, 1))), common.zero)
    const command_index = select(b, common.uint, tiled, commandWord(b, &common, entry_word, 0), index)
    const quad_range = commandWord(b, &common, entry_word, 1)
    const base = op(b, spv.Op.iAdd, common.uint, command_offset, op(b, spv.Op.iMul, common.uint, command_index, constant(b, &common, PAINT_COMMAND_WORDS)))
    const kind = commandWord(b, &common, base, 0)
    const box_x = signed(b, &common, commandWord(b, &common, base, 1))
    const box_y = signed(b, &common, commandWord(b, &common, base, 2))
    const box_width = signed(b, &common, commandWord(b, &common, base, 3))
    const box_height = signed(b, &common, commandWord(b, &common, base, 4))
    const lx = op(b, spv.Op.iSub, common.int, px, box_x)
    const ly = op(b, spv.Op.iSub, common.int, py, box_y)
    const in_box_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, lx, zero_int), op(b, spv.Op.sLessThan, common.boolean, lx, box_width))
    const in_box_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, ly, zero_int), op(b, spv.Op.sLessThan, common.boolean, ly, box_height))
    const in_box = op(b, spv.Op.logicalAnd, common.boolean, in_box_x, in_box_y)
    const touched = builder.newId(b)
    const after = builder.newId(b)
    builder.selectionMerge(b, after)
    builder.branchConditional(b, in_box, touched, after)

    const touched_label = builder.labelWith(b, touched)
    const color = commandWord(b, &common, base, 7)
    const radius = signed(b, &common, commandWord(b, &common, base, 5))

    // CLEAR
    var merge: u32 = 0
    if parts & 1 != 0 {
    merge = openKind(b, &common, kind, PAINT_CLEAR)
    builder.store(b, result, color)
    closeIf(b, merge)
    }

    // FILL
    if parts & 2 != 0 {
    merge = openKind(b, &common, kind, PAINT_FILL)
    const fill_coverage = emitRounded(b, &common, cover_first, lx, ly, box_width, box_height, radius)
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), color, fill_coverage))
    closeIf(b, merge)
    }

    // STROKE: the outline `thickness` wide, inside the rectangle.
    if parts & 4 != 0 {
    merge = openKind(b, &common, kind, PAINT_STROKE)
    const thickness = signed(b, &common, commandWord(b, &common, base, 6))
    const outer = emitRounded(b, &common, cover_first, lx, ly, box_width, box_height, radius)
    const twice = op(b, spv.Op.iMul, common.int, thickness, intConstant(b, &common, 2))
    const inner_radius = select(b, common.int, op(b, spv.Op.sGreaterThan, common.boolean, radius, thickness), op(b, spv.Op.iSub, common.int, radius, thickness), zero_int)
    const inner = emitRounded(b, &common, cover_second, op(b, spv.Op.iSub, common.int, lx, thickness), op(b, spv.Op.iSub, common.int, ly, thickness), op(b, spv.Op.iSub, common.int, box_width, twice), op(b, spv.Op.iSub, common.int, box_height, twice), inner_radius)
    const ring = select(b, common.uint, op(b, spv.Op.uGreaterThan, common.boolean, outer, inner), op(b, spv.Op.iSub, common.uint, outer, inner), common.zero)
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), color, ring))
    closeIf(b, merge)
    }

    // IMAGE: canvas.drawImage's mapping into a size x size box.
    if parts & 8 != 0 {
    merge = openKind(b, &common, kind, PAINT_IMAGE)
    const image_offset = commandWord(b, &common, base, 8)
    const source_width = signed(b, &common, commandWord(b, &common, base, 9))
    const source_height = signed(b, &common, commandWord(b, &common, base, 10))
    const opacity = commandWord(b, &common, base, 11)
    const c128 = intConstant(b, &common, 128)
    const sample_x = op(b, spv.Op.iSub, common.int, op(b, spv.Op.sDiv, common.int, op(b, spv.Op.iMul, common.int, op(b, spv.Op.iMul, common.int, op(b, spv.Op.iAdd, common.int, op(b, spv.Op.iMul, common.int, lx, intConstant(b, &common, 2)), intConstant(b, &common, 1)), source_width), c128), box_width), c128)
    const sample_y = op(b, spv.Op.iSub, common.int, op(b, spv.Op.sDiv, common.int, op(b, spv.Op.iMul, common.int, op(b, spv.Op.iMul, common.int, op(b, spv.Op.iAdd, common.int, op(b, spv.Op.iMul, common.int, ly, intConstant(b, &common, 2)), intConstant(b, &common, 1)), source_height), c128), box_height), c128)
    const pixel = emitSample(b, &common, common.buffers[2], image_offset, source_width, source_height, sample_x, sample_y)
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), pixel, opacity))
    closeIf(b, merge)
    }

    // GLYPHS: the largest atlas coverage among the quads over the pixel.
    if parts & 16 != 0 {
    merge = openKind(b, &common, kind, PAINT_GLYPHS)
    // Tiled: only the quads that reach into the tile's columns.
    const all_quads = commandWord(b, &common, base, 9)
    const first_quad = select(b, common.uint, tiled, op(b, spv.Op.shiftRightLogical, common.uint, quad_range, constant(b, &common, 16)), common.zero)
    const quad_offset = op(b, spv.Op.iAdd, common.uint, commandWord(b, &common, base, 8), op(b, spv.Op.shiftLeftLogical, common.uint, first_quad, constant(b, &common, 2)))
    const quad_count = select(b, common.uint, tiled, op(b, spv.Op.bitwiseAnd, common.uint, quad_range, constant(b, &common, 65535)), all_quads)
    const atlas_offset = commandWord(b, &common, base, 10)
    const atlas_width = commandWord(b, &common, base, 11)
    const origin_x = signed(b, &common, commandWord(b, &common, base, 12))
    const origin_y = signed(b, &common, commandWord(b, &common, base, 13))
    const limit = signed(b, &common, commandWord(b, &common, base, 14))
    const run_x = op(b, spv.Op.iSub, common.int, px, origin_x)
    const run_y = op(b, spv.Op.iSub, common.int, py, origin_y)
    builder.store(b, glyph_cover, common.zero)
    builder.store(b, quad_counter, common.zero)
    const quad_header = builder.newId(b)
    const quad_condition = builder.newId(b)
    const quad_body = builder.newId(b)
    const quad_continue = builder.newId(b)
    const quad_end = builder.newId(b)
    builder.branch(b, quad_header)

    const quad_header_label = builder.labelWith(b, quad_header)
    builder.loopMerge(b, quad_end, quad_continue)
    builder.branch(b, quad_condition)

    const quad_condition_label = builder.labelWith(b, quad_condition)
    const quad_index = builder.load(b, common.uint, quad_counter)
    builder.branchConditional(b, op(b, spv.Op.uLessThan, common.boolean, quad_index, quad_count), quad_body, quad_end)

    const quad_body_label = builder.labelWith(b, quad_body)
    const quad_base = op(b, spv.Op.iAdd, common.uint, quad_offset, op(b, spv.Op.shiftLeftLogical, common.uint, quad_index, constant(b, &common, 2)))
    const word0 = commandWord(b, &common, quad_base, 0)
    const word1 = commandWord(b, &common, quad_base, 1)
    const quad_x = signed(b, &common, commandWord(b, &common, quad_base, 2))
    const quad_y = signed(b, &common, commandWord(b, &common, quad_base, 3))
    const mask = constant(b, &common, 65535)
    const sixteen = constant(b, &common, 16)
    const atlas_x = op(b, spv.Op.bitwiseAnd, common.uint, word0, mask)
    const atlas_y = op(b, spv.Op.shiftRightLogical, common.uint, word0, sixteen)
    const quad_width = signed(b, &common, op(b, spv.Op.bitwiseAnd, common.uint, word1, mask))
    const quad_height = signed(b, &common, op(b, spv.Op.shiftRightLogical, common.uint, word1, sixteen))
    const local_x = op(b, spv.Op.iSub, common.int, run_x, quad_x)
    const local_y = op(b, spv.Op.iSub, common.int, run_y, quad_y)
    const inside_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, local_x, zero_int), op(b, spv.Op.sLessThan, common.boolean, local_x, quad_width))
    const inside_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, local_y, zero_int), op(b, spv.Op.sLessThan, common.boolean, local_y, quad_height))
    const inside_quad = op(b, spv.Op.logicalAnd, common.boolean, inside_x, inside_y)
    const sample = builder.newId(b)
    const sampled = builder.newId(b)
    builder.selectionMerge(b, sampled)
    builder.branchConditional(b, inside_quad, sample, sampled)

    const sample_label = builder.labelWith(b, sample)
    const atlas_row = op(b, spv.Op.iAdd, common.uint, atlas_y, unsigned(b, &common, local_y))
    const atlas_column = op(b, spv.Op.iAdd, common.uint, atlas_x, unsigned(b, &common, local_x))
    const byte_index = op(b, spv.Op.iAdd, common.uint, atlas_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, atlas_row, atlas_width), atlas_column))
    const word = builder.load(b, common.uint, element(b, &common, common.buffers[2], op(b, spv.Op.shiftRightLogical, common.uint, byte_index, constant(b, &common, 2))))
    const bit_shift = op(b, spv.Op.shiftLeftLogical, common.uint, op(b, spv.Op.bitwiseAnd, common.uint, byte_index, constant(b, &common, 3)), constant(b, &common, 3))
    const value = op(b, spv.Op.bitwiseAnd, common.uint, op(b, spv.Op.shiftRightLogical, common.uint, word, bit_shift), constant(b, &common, 255))
    const current = builder.load(b, common.uint, glyph_cover)
    builder.store(b, glyph_cover, select(b, common.uint, op(b, spv.Op.uGreaterThan, common.boolean, value, current), value, current))
    builder.branch(b, sampled)

    const sampled_label = builder.labelWith(b, sampled)
    builder.branch(b, quad_continue)

    const quad_continue_label = builder.labelWith(b, quad_continue)
    builder.store(b, quad_counter, op(b, spv.Op.iAdd, common.uint, quad_index, constant(b, &common, 1)))
    builder.branch(b, quad_header)

    const quad_end_label = builder.labelWith(b, quad_end)
    const limited = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.iNotEqual, common.boolean, limit, zero_int), op(b, spv.Op.sGreaterThanEqual, common.boolean, run_x, limit))
    const glyph_coverage = select(b, common.uint, limited, common.zero, builder.load(b, common.uint, glyph_cover))
    builder.store(b, result, emitOver(b, &common, builder.load(b, common.uint, result), color, glyph_coverage))
    closeIf(b, merge)
    }

    builder.branch(b, after)
    const after_label = builder.labelWith(b, after)
    builder.branch(b, continue_block)

    const continue_label = builder.labelWith(b, continue_block)
    builder.store(b, counter, op(b, spv.Op.iAdd, common.uint, index, constant(b, &common, 1)))
    builder.branch(b, header)

    const loop_end_label = builder.labelWith(b, loop_end)
    const target_index = op(b, spv.Op.iAdd, common.uint, target_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, y, target_stride), x))
    builder.store(b, element(b, &common, common.buffers[0], target_index), builder.load(b, common.uint, result))
    builder.branch(b, done)

    const done_label = builder.labelWith(b, done)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

pub fn buildPaintWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    return buildPaintPartsWords(allocator, 31, result)
}

pub fn buildPaintPartsWords(allocator: std.allocator.Allocator, parts: u32, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildPaintParts(&b, parts)
    return moduleWords(allocator, &b, result)
}

pub fn buildBlurPassWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildBlurPass(&b)
    return moduleWords(allocator, &b, result)
}

pub fn buildBlurMaskWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildBlurMask(&b)
    return moduleWords(allocator, &b, result)
}

// Builds a shader into words allocated from `allocator`; returns the word
// count (0 when out of memory). `which` is PATTERN, BLIT, TEXT, PAINT,
// BLUR_PASS or BLUR_MASK.
pub fn build(allocator: std.allocator.Allocator, which: u8, result: *[*]u32) -> usize {
    if which == WARP { return buildWarpWords(allocator, result) }
    if which == SHRINK { return buildShrinkWords(allocator, result) }
    if which == PATTERN { return buildPatternWords(allocator, result) }
    if which == BLIT { return buildBlitWords(allocator, result) }
    if which == PAINT { return buildPaintWords(allocator, result) }
    if which == BLUR_PASS { return buildBlurPassWords(allocator, result) }
    if which == BLUR_MASK { return buildBlurMaskWords(allocator, result) }
    return buildTextWords(allocator, result)
}

// One shader each: a program that calls only these carries only the
// builders it uses (`build` keeps all three).
pub fn buildPatternWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildPattern(&b)
    return moduleWords(allocator, &b, result)
}

pub fn buildBlitWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildBlit(&b)
    return moduleWords(allocator, &b, result)
}

pub fn buildTextWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildText(&b)
    return moduleWords(allocator, &b, result)
}

// The module's words in memory from `allocator` (their count; 0 when out
// of memory).
fn moduleWords(allocator: std.allocator.Allocator, b: *builder.Builder, result: *[*]u32) -> usize {
    const count = builder.wordCount(b)
    const memory = allocator.alloc(count * 4, 4)
    if memory == null { return 0 }
    unsafe { result.* = @ptrCast([*]u32, memory.?) }
    builder.writeWords(b, result.*)
    builder.deinit(b)
    return count
}

// ---------------------------------------------------------------------------
// warp

fn iconst(b: *builder.Builder, common: *const Common, value: i32) -> u32 { return intConstant(b, common, value) }

fn iop(b: *builder.Builder, common: *const Common, opcode: spv.Op, left: u32, right: u32) -> u32 {
    return op(b, opcode, common.*.int, left, right)
}

fn clampInt(b: *builder.Builder, common: *const Common, value: u32, low: u32, high: u32) -> u32 {
    const raised = select(b, common.*.int, op(b, spv.Op.sLessThan, common.*.boolean, value, low), low, value)
    return select(b, common.*.int, op(b, spv.Op.sGreaterThan, common.*.boolean, raised, high), high, raised)
}

// The four cubic Bernstein weights of t (0-1024) in 1/1024.
fn bernstein(b: *builder.Builder, common: *const Common, t: u32, weights: *[4]u32) -> void {
    const s = iop(b, common, spv.Op.iSub, iconst(b, common, 1024), t)
    const shift = iconst(b, common, 20)
    const three = iconst(b, common, 3)
    const ss = iop(b, common, spv.Op.iMul, s, s)
    const tt = iop(b, common, spv.Op.iMul, t, t)
    weights.*[0] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, ss, s), shift)
    weights.*[1] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, iop(b, common, spv.Op.iMul, three, t), ss), shift)
    weights.*[2] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, iop(b, common, spv.Op.iMul, three, tt), s), shift)
    weights.*[3] = iop(b, common, spv.Op.shiftRightArithmetic, iop(b, common, spv.Op.iMul, tt, t), shift)
}

// The surface's offset at point (x, y) (1/16 pixels, relative to the rest
// rectangle's origin, which is `width` x `height` in 1/16 pixels): the
// control points' offsets weighted along x in each row, then down.
fn warpOffset(b: *builder.Builder, common: *const Common, x: u32, y: u32, width: u32, height: u32, offsets: *const [16]u32, out: *u32) -> void {
    const zero = iconst(b, common, 0)
    const full = iconst(b, common, 1024)
    const u = clampInt(b, common, iop(b, common, spv.Op.sDiv, iop(b, common, spv.Op.iMul, x, full), width), zero, full)
    const v = clampInt(b, common, iop(b, common, spv.Op.sDiv, iop(b, common, spv.Op.iMul, y, full), height), zero, full)
    var across: [4]u32 = undefined
    var down: [4]u32 = undefined
    bernstein(b, common, u, &across)
    bernstein(b, common, v, &down)
    const ten = iconst(b, common, 10)
    var total = zero
    var row: usize = 0
    while row < 4 {
        var sum = zero
        var column: usize = 0
        while column < 4 {
            sum = iop(b, common, spv.Op.iAdd, sum, iop(b, common, spv.Op.iMul, across[column], offsets.*[row * 4 + column]))
            column += 1
        }
        const row_value = iop(b, common, spv.Op.shiftRightArithmetic, sum, ten)
        total = iop(b, common, spv.Op.iAdd, total, iop(b, common, spv.Op.iMul, down[row], row_value))
        row += 1
    }
    out.* = iop(b, common, spv.Op.shiftRightArithmetic, total, ten)
}

// Source pixel (x, y) (signed), 0 outside the width x height source.
fn warpTexel(b: *builder.Builder, common: *const Common, x: u32, y: u32, width: u32, height: u32, stride: u32) -> u32 {
    const zero = iconst(b, common, 0)
    const in_x = op(b, spv.Op.logicalAnd, common.*.boolean, op(b, spv.Op.sGreaterThanEqual, common.*.boolean, x, zero), op(b, spv.Op.sLessThan, common.*.boolean, x, width))
    const in_y = op(b, spv.Op.logicalAnd, common.*.boolean, op(b, spv.Op.sGreaterThanEqual, common.*.boolean, y, zero), op(b, spv.Op.sLessThan, common.*.boolean, y, height))
    const inside = op(b, spv.Op.logicalAnd, common.*.boolean, in_x, in_y)
    const index = iop(b, common, spv.Op.iAdd, iop(b, common, spv.Op.iMul, y, stride), x)
    const safe = builder.unary(b, spv.Op.bitcast, common.*.uint, select(b, common.*.int, inside, index, zero))
    const value = builder.load(b, common.*.uint, element(b, common, common.*.buffers[0], safe))
    return select(b, common.*.uint, inside, value, common.*.zero)
}

pub fn buildWarp(b: *builder.Builder) -> void {
    var common: Common = undefined
    declare(b, &common, WARP_WORDS, 3)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const target_width = pushWord(b, &common, 0)
    const target_height = pushWord(b, &common, 1)
    const target_offset = pushWord(b, &common, 2)
    const target_stride = pushWord(b, &common, 3)
    const box_x = signed(b, &common, pushWord(b, &common, 4))
    const box_y = signed(b, &common, pushWord(b, &common, 5))
    const box_width = pushWord(b, &common, 6)
    const box_height = pushWord(b, &common, 7)
    const rest_x = signed(b, &common, pushWord(b, &common, 8))
    const rest_y = signed(b, &common, pushWord(b, &common, 9))
    const rest_width = signed(b, &common, pushWord(b, &common, 10))
    const rest_height = signed(b, &common, pushWord(b, &common, 11))
    const source_stride = signed(b, &common, pushWord(b, &common, 12))
    const grid_offset = pushWord(b, &common, 13)
    const px = iop(b, &common, spv.Op.iAdd, box_x, signed(b, &common, x))
    const py = iop(b, &common, spv.Op.iAdd, box_y, signed(b, &common, y))
    const zero = iconst(b, &common, 0)
    const in_box = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.uLessThan, common.boolean, x, box_width), op(b, spv.Op.uLessThan, common.boolean, y, box_height))
    const in_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, px, zero), op(b, spv.Op.sLessThan, common.boolean, px, signed(b, &common, target_width)))
    const in_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, py, zero), op(b, spv.Op.sLessThan, common.boolean, py, signed(b, &common, target_height)))
    const visible = op(b, spv.Op.logicalAnd, common.boolean, in_box, op(b, spv.Op.logicalAnd, common.boolean, in_x, in_y))
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, visible, body, merge)

    const body_label = builder.labelWith(b, body)
    var offsets_x: [16]u32 = undefined
    var offsets_y: [16]u32 = undefined
    var index: u32 = 0
    while index < 16 {
        offsets_x[index] = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[2], op(b, spv.Op.iAdd, common.uint, grid_offset, constant(b, &common, index)))))
        offsets_y[index] = signed(b, &common, builder.load(b, common.uint, element(b, &common, common.buffers[2], op(b, spv.Op.iAdd, common.uint, grid_offset, constant(b, &common, index + 16)))))
        index += 1
    }
    // In 1/16 pixels, relative to the rest rectangle: the pixel's centre,
    // and the rectangle's size.
    const sixteen = iconst(b, &common, 16)
    const px16 = iop(b, &common, spv.Op.iSub, iop(b, &common, spv.Op.iAdd, iop(b, &common, spv.Op.iMul, px, sixteen), iconst(b, &common, 8)), iop(b, &common, spv.Op.iMul, rest_x, sixteen))
    const py16 = iop(b, &common, spv.Op.iSub, iop(b, &common, spv.Op.iAdd, iop(b, &common, spv.Op.iMul, py, sixteen), iconst(b, &common, 8)), iop(b, &common, spv.Op.iMul, rest_y, sixteen))
    const width16 = iop(b, &common, spv.Op.iMul, rest_width, sixteen)
    const height16 = iop(b, &common, spv.Op.iMul, rest_height, sixteen)
    // s = p - offset(s), three times from s = p.
    var sx = px16
    var sy = py16
    var round: u32 = 0
    while round < 3 {
        var offset_x: u32 = 0
        var offset_y: u32 = 0
        warpOffset(b, &common, sx, sy, width16, height16, &offsets_x, &offset_x)
        warpOffset(b, &common, sx, sy, width16, height16, &offsets_y, &offset_y)
        sx = iop(b, &common, spv.Op.iSub, px16, offset_x)
        sy = iop(b, &common, spv.Op.iSub, py16, offset_y)
        round += 1
    }
    // Bilinear: the pixel centres around (sx, sy).
    const centred_x = iop(b, &common, spv.Op.iSub, sx, iconst(b, &common, 8))
    const centred_y = iop(b, &common, spv.Op.iSub, sy, iconst(b, &common, 8))
    const four = iconst(b, &common, 4)
    const fifteen = iconst(b, &common, 15)
    const ix = iop(b, &common, spv.Op.shiftRightArithmetic, centred_x, four)
    const iy = iop(b, &common, spv.Op.shiftRightArithmetic, centred_y, four)
    const fx = builder.unary(b, spv.Op.bitcast, common.uint, iop(b, &common, spv.Op.bitwiseAnd, centred_x, fifteen))
    const fy = builder.unary(b, spv.Op.bitcast, common.uint, iop(b, &common, spv.Op.bitwiseAnd, centred_y, fifteen))
    const one = iconst(b, &common, 1)
    const ix1 = iop(b, &common, spv.Op.iAdd, ix, one)
    const iy1 = iop(b, &common, spv.Op.iAdd, iy, one)
    const c00 = warpTexel(b, &common, ix, iy, rest_width, rest_height, source_stride)
    const c10 = warpTexel(b, &common, ix1, iy, rest_width, rest_height, source_stride)
    const c01 = warpTexel(b, &common, ix, iy1, rest_width, rest_height, source_stride)
    const c11 = warpTexel(b, &common, ix1, iy1, rest_width, rest_height, source_stride)
    const u16 = constant(b, &common, 16)
    const gx = op(b, spv.Op.iSub, common.uint, u16, fx)
    const gy = op(b, spv.Op.iSub, common.uint, u16, fy)
    const w00 = op(b, spv.Op.iMul, common.uint, gx, gy)
    const w10 = op(b, spv.Op.iMul, common.uint, fx, gy)
    const w01 = op(b, spv.Op.iMul, common.uint, gx, fy)
    const w11 = op(b, spv.Op.iMul, common.uint, fx, fy)
    var sampled: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    index = 0
    while index < 4 {
        const shift = 24 - index * 8
        var sum = op(b, spv.Op.iMul, common.uint, channel(b, &common, c00, shift), w00)
        sum = op(b, spv.Op.iAdd, common.uint, sum, op(b, spv.Op.iMul, common.uint, channel(b, &common, c10, shift), w10))
        sum = op(b, spv.Op.iAdd, common.uint, sum, op(b, spv.Op.iMul, common.uint, channel(b, &common, c01, shift), w01))
        sum = op(b, spv.Op.iAdd, common.uint, sum, op(b, spv.Op.iMul, common.uint, channel(b, &common, c11, shift), w11))
        sampled[index] = op(b, spv.Op.shiftRightLogical, common.uint, op(b, spv.Op.iAdd, common.uint, sum, constant(b, &common, 128)), constant(b, &common, 8))
        index += 1
    }
    // Over the target, premultiplied (as the blit shader blends).
    const target_index = op(b, spv.Op.iAdd, common.uint, target_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, builder.unary(b, spv.Op.bitcast, common.uint, py), target_stride), builder.unary(b, spv.Op.bitcast, common.uint, px)))
    const target_pointer = element(b, &common, common.buffers[1], target_index)
    const target = builder.load(b, common.uint, target_pointer)
    const inverse = op(b, spv.Op.iSub, common.uint, constant(b, &common, 255), sampled[0])
    var blended: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    index = 0
    while index < 4 {
        const shift = 24 - index * 8
        const kept = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, channel(b, &common, target, shift), inverse), constant(b, &common, 127))
        const sum = op(b, spv.Op.iAdd, common.uint, sampled[index], op(b, spv.Op.uDiv, common.uint, kept, constant(b, &common, 255)))
        blended[index] = select(b, common.uint, op(b, spv.Op.uGreaterThan, common.boolean, sum, constant(b, &common, 255)), constant(b, &common, 255), sum)
        index += 1
    }
    builder.store(b, target_pointer, packAlpha(b, &common, blended[0], blended[1], blended[2], blended[3]))
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

pub fn buildWarpWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildWarp(&b)
    return moduleWords(allocator, &b, result)
}

// ---------------------------------------------------------------------------
// shrink

pub fn buildShrink(b: *builder.Builder) -> void {
    var common: Common = undefined
    declare(b, &common, SHRINK_WORDS, 2)
    const main = builder.function(b, common.voidType, spv.FUNCTION_CONTROL_NONE, common.functionType)
    const entry = builder.label(b)
    const id = builder.load(b, common.uvec3, common.globalId)
    const x = builder.compositeExtract(b, common.uint, id, 0)
    const y = builder.compositeExtract(b, common.uint, id, 1)
    const target_width = pushWord(b, &common, 0)
    const target_height = pushWord(b, &common, 1)
    const target_offset = pushWord(b, &common, 2)
    const target_stride = pushWord(b, &common, 3)
    const box_x = signed(b, &common, pushWord(b, &common, 4))
    const box_y = signed(b, &common, pushWord(b, &common, 5))
    const box_width = pushWord(b, &common, 6)
    const box_height = pushWord(b, &common, 7)
    const source_width = pushWord(b, &common, 8)
    const source_height = pushWord(b, &common, 9)
    const source_stride = pushWord(b, &common, 10)
    const opacity = pushWord(b, &common, 11)
    const px = iop(b, &common, spv.Op.iAdd, box_x, signed(b, &common, x))
    const py = iop(b, &common, spv.Op.iAdd, box_y, signed(b, &common, y))
    const zero = iconst(b, &common, 0)
    const in_box = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.uLessThan, common.boolean, x, box_width), op(b, spv.Op.uLessThan, common.boolean, y, box_height))
    const in_x = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, px, zero), op(b, spv.Op.sLessThan, common.boolean, px, signed(b, &common, target_width)))
    const in_y = op(b, spv.Op.logicalAnd, common.boolean, op(b, spv.Op.sGreaterThanEqual, common.boolean, py, zero), op(b, spv.Op.sLessThan, common.boolean, py, signed(b, &common, target_height)))
    const visible = op(b, spv.Op.logicalAnd, common.boolean, in_box, op(b, spv.Op.logicalAnd, common.boolean, in_x, in_y))
    const body = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, visible, body, merge)

    const body_label = builder.labelWith(b, body)
    // Sample k (0-3) across: source column (x * 8 + 2k + 1) * width / (box * 8).
    const eight = constant(b, &common, 8)
    const across = op(b, spv.Op.iMul, common.uint, box_width, eight)
    const down = op(b, spv.Op.iMul, common.uint, box_height, eight)
    var columns: [4]u32 = undefined
    var rows: [4]u32 = undefined
    var k: u32 = 0
    while k < 4 {
        const offset = constant(b, &common, 2 * k + 1)
        columns[k] = op(b, spv.Op.uDiv, common.uint, op(b, spv.Op.iMul, common.uint, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, x, eight), offset), source_width), across)
        rows[k] = op(b, spv.Op.uDiv, common.uint, op(b, spv.Op.iMul, common.uint, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, y, eight), offset), source_height), down)
        k += 1
    }
    var sums: [4]u32 = [4]u32{ common.zero, common.zero, common.zero, common.zero }
    var row: u32 = 0
    while row < 4 {
        var column: u32 = 0
        while column < 4 {
            const index = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, rows[row], source_stride), columns[column])
            const texel = builder.load(b, common.uint, element(b, &common, common.buffers[0], index))
            var channel_index: u32 = 0
            while channel_index < 4 {
                sums[channel_index] = op(b, spv.Op.iAdd, common.uint, sums[channel_index], channel(b, &common, texel, 24 - channel_index * 8))
                channel_index += 1
            }
            column += 1
        }
        row += 1
    }
    var sampled: [4]u32 = undefined
    k = 0
    while k < 4 {
        const averaged = op(b, spv.Op.shiftRightLogical, common.uint, op(b, spv.Op.iAdd, common.uint, sums[k], constant(b, &common, 8)), constant(b, &common, 4))
        // Premultiplied: every channel faded alike.
        sampled[k] = op(b, spv.Op.uDiv, common.uint, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, averaged, opacity), constant(b, &common, 127)), constant(b, &common, 255))
        k += 1
    }
    const target_index = op(b, spv.Op.iAdd, common.uint, target_offset, op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, builder.unary(b, spv.Op.bitcast, common.uint, py), target_stride), builder.unary(b, spv.Op.bitcast, common.uint, px)))
    const target_pointer = element(b, &common, common.buffers[1], target_index)
    const target = builder.load(b, common.uint, target_pointer)
    const inverse = op(b, spv.Op.iSub, common.uint, constant(b, &common, 255), sampled[0])
    var blended: [4]u32 = undefined
    k = 0
    while k < 4 {
        const kept = op(b, spv.Op.iAdd, common.uint, op(b, spv.Op.iMul, common.uint, channel(b, &common, target, 24 - k * 8), inverse), constant(b, &common, 127))
        const sum = op(b, spv.Op.iAdd, common.uint, sampled[k], op(b, spv.Op.uDiv, common.uint, kept, constant(b, &common, 255)))
        blended[k] = select(b, common.uint, op(b, spv.Op.uGreaterThan, common.boolean, sum, constant(b, &common, 255)), constant(b, &common, 255), sum)
        k += 1
    }
    builder.store(b, target_pointer, packAlpha(b, &common, blended[0], blended[1], blended[2], blended[3]))
    builder.branch(b, merge)

    const merge_label = builder.labelWith(b, merge)
    builder.returnVoid(b)
    builder.functionEnd(b)
    finish(b, &common, main)
}

pub fn buildShrinkWords(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    buildShrink(&b)
    return moduleWords(allocator, &b, result)
}
