// The shell as a shared object (libmlx-shell.so), for the compositor to load
// and load again while it runs (modules.mlx, entries.mlx):
//
//     mlx4 --shared examples/wayland-compositor/shell_module.mlx -o libmlx-shell.so
//
// Its one export answers the program's queries: what it is, the layout of
// the records it shares, its entries and its handlers by name.
const entries = @import("./entries.mlx")
const table = @import("./shell_table.mlx")

export fn mlx_compositor_module(query: usize, index: usize) -> usize {
    if query == entries.QUERY_KIND { return entries.MODULE_SHELL }
    if query == entries.QUERY_LAYOUT { return table.layout() }
    if query == entries.QUERY_ENTRY { return table.entry(index) }
    if query == entries.QUERY_HANDLER_COUNT { return table.handlerCount() }
    if query == entries.QUERY_HANDLER_ADDRESS { return table.handlerAddress(index) }
    if query == entries.QUERY_HANDLER_NAME {
        unsafe { return @intFromPtr(@ptrCast([*]const u8, table.handlerName(index))) }
    }
    if query == entries.QUERY_HANDLER_NAME_LENGTH { return table.handlerName(index).length }
    return 0
}
