// The shell's side of the module boundary (entries.mlx): its entries, its
// handlers by name, and the layout of the records it shares with the
// program. The program compiles this in as its built-in shell; the shell
// module (shell_module.mlx, libmlx-shell.so) answers queries from it.
const state = @import("./state.mlx")
const shell = @import("./shell.mlx")
const data = @import("./data.mlx")
const dmabuf = @import("./dmabuf.mlx")
const pointer = @import("./pointer.mlx")
const entries = @import("./entries.mlx")
const kms = @import("./kms.mlx")

const Compositor = state.Compositor

// The protocol globals: the shell's, clipboard, linux-dmabuf, relative
// pointers and pointer constraints.
fn createGlobals(compositor: *Compositor) -> bool {
    return shell.createGlobals(compositor) && dmabuf.createGlobal(compositor) && data.createGlobal(compositor) && pointer.createGlobals(compositor)
}

pub fn entry(index: usize) -> usize {
    if index == entries.SHELL_CREATE_GLOBALS { return @intFromPtr(createGlobals) }
    if index == entries.SHELL_LAUNCH { return @intFromPtr(shell.launch) }
    if index == entries.SHELL_REAP_CHILDREN { return @intFromPtr(shell.reapChildren) }
    if index == entries.SHELL_FRAME_DONE { return @intFromPtr(shell.frameDone) }
    if index == entries.SHELL_ADOPT_CPU_RENDERER { return @intFromPtr(shell.adoptCpuRenderer) }
    if index == entries.SHELL_BROADCAST_KEYMAP { return @intFromPtr(shell.broadcastKeymap) }
    if index == entries.SHELL_KEYBOARD_KEY { return @intFromPtr(shell.keyboardKey) }
    if index == entries.SHELL_KEYBOARD_MODIFIERS { return @intFromPtr(shell.keyboardModifiers) }
    if index == entries.SHELL_POINTER_AXIS { return @intFromPtr(shell.pointerAxis) }
    if index == entries.SHELL_POINTER_BUTTON { return @intFromPtr(shell.pointerButton) }
    if index == entries.SHELL_POINTER_MOTION { return @intFromPtr(shell.pointerMotion) }
    if index == entries.SHELL_POINTER_LEAVE { return @intFromPtr(shell.pointerLeave) }
    if index == entries.SHELL_START_HELPERS { return @intFromPtr(shell.startHelpers) }
    if index == entries.SHELL_HELPER_MESSAGES { return @intFromPtr(shell.helperMessages) }
    if index == entries.SHELL_SETTINGS_CHANGED { return @intFromPtr(shell.settingsChanged) }
    if index == entries.SHELL_POINTER_RELATIVE { return @intFromPtr(shell.pointerRelative) }
    return 0
}

pub fn handlerCount() -> usize {
    return shell.HANDLER_COUNT + data.HANDLER_COUNT + dmabuf.HANDLER_COUNT + pointer.HANDLER_COUNT
}

pub fn handlerAddress(index: usize) -> usize {
    if index < shell.HANDLER_COUNT { return shell.handlerAddress(index) }
    if index < shell.HANDLER_COUNT + data.HANDLER_COUNT { return data.handlerAddress(index - shell.HANDLER_COUNT) }
    if index < shell.HANDLER_COUNT + data.HANDLER_COUNT + dmabuf.HANDLER_COUNT { return dmabuf.handlerAddress(index - shell.HANDLER_COUNT - data.HANDLER_COUNT) }
    return pointer.handlerAddress(index - shell.HANDLER_COUNT - data.HANDLER_COUNT - dmabuf.HANDLER_COUNT)
}

pub fn handlerName(index: usize) -> []const u8 {
    if index < shell.HANDLER_COUNT { return shell.handlerName(index) }
    if index < shell.HANDLER_COUNT + data.HANDLER_COUNT { return data.handlerName(index - shell.HANDLER_COUNT) }
    if index < shell.HANDLER_COUNT + data.HANDLER_COUNT + dmabuf.HANDLER_COUNT { return dmabuf.handlerName(index - shell.HANDLER_COUNT - data.HANDLER_COUNT) }
    return pointer.handlerName(index - shell.HANDLER_COUNT - data.HANDLER_COUNT - dmabuf.HANDLER_COUNT)
}

// The records the shell keeps across a reload, by size (a changed record
// needs a restart). state.LAYOUT_VERSION covers what sizes miss.
pub fn layout() -> usize {
    var value = state.layout()
    value = value *% 31 +% @sizeOf(data.Source)
    value = value *% 31 +% @sizeOf(data.Device)
    value = value *% 31 +% @sizeOf(data.Offer)
    value = value *% 31 +% @sizeOf(dmabuf.Params)
    value = value *% 31 +% @sizeOf(kms.Output)
    return value
}
