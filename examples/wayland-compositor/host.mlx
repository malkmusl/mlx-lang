// The compositor's host side: it is itself a Wayland client of the session
// compositor (GNOME, KDE, sway, weston, ...). It shows the composed output
// in an xdg_toplevel window and receives the host seat's keyboard and
// pointer input, which shell.mlx routes to the nested clients.

const std = @import("std")
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const shell = @import("./shell.mlx")

const Compositor = state.Compositor

fn minimum(left: u32, right: u32) -> u32 {
    return if left < right { left } else { right }
}

fn isNamed(value: wl.String, name: []const u8) -> bool {
    return std.string.eql(value, std.string.fromSlice(name))
}

fn contextOf(compositor: *Compositor) -> *anyopaque {
    unsafe { return @ptrCast(*anyopaque, compositor) }
}

fn onPointer(context: *anyopaque, event: wl.client.Event) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.wl_pointer.decodeEvent(event)
    const opcode = event.opcode
    if opcode == wl.wl_pointer.EVENT_ENTER {
        // Hide the host cursor; the compositor draws the clients' cursor.
        compositor.*.hostPointer.setCursor(decoded.enter.serial, null, 0, 0)
        shell.pointerMotion(compositor, decoded.enter.surface_x.toInt(), decoded.enter.surface_y.toInt())
    } else if opcode == wl.wl_pointer.EVENT_LEAVE {
        shell.pointerLeave(compositor)
    } else if opcode == wl.wl_pointer.EVENT_MOTION {
        compositor.*.time = decoded.motion.time
        shell.pointerMotion(compositor, decoded.motion.surface_x.toInt(), decoded.motion.surface_y.toInt())
    } else if opcode == wl.wl_pointer.EVENT_BUTTON {
        compositor.*.time = decoded.button.time
        shell.pointerButton(compositor, decoded.button.button, decoded.button.state == @intFromEnum(wl.wl_pointer.ButtonState.pressed))
    } else if opcode == wl.wl_pointer.EVENT_AXIS {
        compositor.*.time = decoded.axis.time
        shell.pointerAxis(compositor, decoded.axis.axis, decoded.axis.value)
    }
}

fn onKeyboard(context: *anyopaque, event: wl.client.Event) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.wl_keyboard.decodeEvent(event)
    const opcode = event.opcode
    if opcode == wl.wl_keyboard.EVENT_KEYMAP {
        if compositor.*.hasKeymap { compositor.*.keymap.close() }
        compositor.*.keymap = decoded.keymap.fd
        compositor.*.keymapFormat = decoded.keymap.format
        compositor.*.keymapSize = decoded.keymap.size
        compositor.*.hasKeymap = true
        shell.broadcastKeymap(compositor)
    } else if opcode == wl.wl_keyboard.EVENT_LEAVE {
        compositor.*.alt = false
        compositor.*.shift = false
        compositor.*.control = false
    } else if opcode == wl.wl_keyboard.EVENT_KEY {
        compositor.*.time = decoded.key.time
        shell.keyboardKey(compositor, decoded.key.key, decoded.key.state == @intFromEnum(wl.wl_keyboard.KeyState.pressed))
    } else if opcode == wl.wl_keyboard.EVENT_MODIFIERS {
        const modifiers = decoded.modifiers
        shell.keyboardModifiers(compositor, modifiers.mods_depressed, modifiers.mods_latched, modifiers.mods_locked, modifiers.group)
    } else if opcode == wl.wl_keyboard.EVENT_REPEAT_INFO {
        compositor.*.repeatRate = decoded.repeat_info.rate
        compositor.*.repeatDelay = decoded.repeat_info.delay
    }
}

fn onSeat(context: *anyopaque, event: wl.client.Event) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.wl_seat.decodeEvent(event)
    if event.opcode != wl.wl_seat.EVENT_CAPABILITIES { return }
    const capabilities = decoded.capabilities.capabilities
    if wl.flags.has(capabilities, @intFromEnum(wl.wl_seat.Capability.pointer)) && !compositor.*.hasHostPointer {
        compositor.*.hostPointer = compositor.*.hostSeat.getPointer()
        compositor.*.hostPointer.setHandler(onPointer, context)
        compositor.*.hasHostPointer = true
    }
    if wl.flags.has(capabilities, @intFromEnum(wl.wl_seat.Capability.keyboard)) && !compositor.*.hasHostKeyboard {
        compositor.*.hostKeyboard = compositor.*.hostSeat.getKeyboard()
        compositor.*.hostKeyboard.setHandler(onKeyboard, context)
        compositor.*.hasHostKeyboard = true
    }
}

fn onRegistry(context: *anyopaque, event: wl.client.Event) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.wl_registry.decodeEvent(event)
    if event.opcode != wl.wl_registry.EVENT_GLOBAL { return }
    const global = decoded.global
    const registry = compositor.*.hostRegistry
    if isNamed(global.interface, "wl_compositor") {
        compositor.*.hostCompositor = wl.wl_compositor.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_compositor, minimum(global.version, 4)))
        compositor.*.hasHostCompositor = true
    } else if isNamed(global.interface, "wl_shm") {
        compositor.*.hostShm = wl.wl_shm.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_shm, 1))
        compositor.*.hasHostShm = true
    } else if isNamed(global.interface, "xdg_wm_base") {
        compositor.*.hostWmBase = wl.xdg_wm_base.Proxy.fromObject(registry.bind(global.name, wl.Interface.xdg_wm_base, minimum(global.version, 2)))
        compositor.*.hasHostWmBase = true
    } else if isNamed(global.interface, "wl_seat") && !compositor.*.hasHostSeat {
        compositor.*.hostSeat = wl.wl_seat.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_seat, minimum(global.version, 5)))
        compositor.*.hostSeat.setHandler(onSeat, context)
        compositor.*.hasHostSeat = true
    }
}

fn onWmBase(context: *anyopaque, event: wl.client.Event) -> void {
    const decoded = wl.xdg_wm_base.decodeEvent(event)
    state.compositorOf(context).*.hostWmBase.pong(decoded.ping.serial)
}

fn onXdgSurface(context: *anyopaque, event: wl.client.Event) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.xdg_surface.decodeEvent(event)
    compositor.*.hostXdgSurface.ackConfigure(decoded.configure.serial)
    compositor.*.hostConfigured = true
    compositor.*.needsRedraw = true
}

fn onToplevel(context: *anyopaque, event: wl.client.Event) -> void {
    if event.opcode == wl.xdg_toplevel.EVENT_CLOSE { state.compositorOf(context).*.running = false }
}

fn onBuffer(context: *anyopaque, event: wl.client.Event) -> void {
    const compositor = state.compositorOf(context)
    if event.object.id == compositor.*.hostFirstBuffer.id() { compositor.*.hostFirstBusy = false }
    if event.object.id == compositor.*.hostSecondBuffer.id() { compositor.*.hostSecondBusy = false }
}

fn onFrame(context: *anyopaque, event: wl.client.Event) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.wl_callback.decodeEvent(event)
    compositor.*.hostFramePending = false
    shell.frameDone(compositor, decoded.done.callback_data)
}

const Failure = error { MissingHostGlobals, NoSharedMemory }

fn missingHostGlobals() -> Failure!void { return Failure.MissingHostGlobals }
fn noSharedMemory() -> Failure!void { return Failure.NoSharedMemory }

// Connects to the session compositor and opens the output window.
pub fn connect(compositor: *Compositor) -> !void {
    var display: wl.client.Display = undefined
    try wl.client.Display.connect(&display, compositor.*.allocator)
    compositor.*.host = display
    const context = contextOf(compositor)
    compositor.*.hostRegistry = wl.displayProxy(display).getRegistry()
    compositor.*.hostRegistry.setHandler(onRegistry, context)
    try display.roundtrip()
    if !compositor.*.hasHostCompositor || !compositor.*.hasHostShm || !compositor.*.hasHostWmBase { return missingHostGlobals() }
    compositor.*.hostWmBase.setHandler(onWmBase, context)

    const frame_size = compositor.*.width * compositor.*.height * 4
    var memory: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&memory, frame_size * 2) { return noSharedMemory() }
    compositor.*.hostMemory = memory
    const pool = compositor.*.hostShm.createPool(memory.handle, @intCast(i32, frame_size * 2))
    const width = @intCast(i32, compositor.*.width)
    const height = @intCast(i32, compositor.*.height)
    const format = @intFromEnum(wl.wl_shm.Format.xrgb8888)
    compositor.*.hostFirstBuffer = pool.createBuffer(0, width, height, width * 4, format)
    compositor.*.hostSecondBuffer = pool.createBuffer(@intCast(i32, frame_size), width, height, width * 4, format)
    compositor.*.hostFirstBuffer.setHandler(onBuffer, context)
    compositor.*.hostSecondBuffer.setHandler(onBuffer, context)
    pool.destroy()

    compositor.*.hostSurface = compositor.*.hostCompositor.createSurface()
    compositor.*.hostXdgSurface = compositor.*.hostWmBase.getXdgSurface(compositor.*.hostSurface)
    compositor.*.hostXdgSurface.setHandler(onXdgSurface, context)
    compositor.*.hostToplevel = compositor.*.hostXdgSurface.getToplevel()
    compositor.*.hostToplevel.setHandler(onToplevel, context)
    compositor.*.hostToplevel.setTitle("Mlx Compositor")
    compositor.*.hostToplevel.setAppId("org.mlx.compositor")
    compositor.*.hostToplevel.setMinSize(width, height)
    compositor.*.hostToplevel.setMaxSize(width, height)
    compositor.*.hostSurface.commit()
    try display.roundtrip()
}

// Composes and shows a new frame when something changed and the host is
// ready for one.
pub fn present(compositor: *Compositor) -> void {
    if !compositor.*.hostConfigured || compositor.*.hostFramePending || !compositor.*.needsRedraw { return }
    var buffer = compositor.*.hostFirstBuffer
    var offset: usize = 0
    if compositor.*.hostFirstBusy {
        if compositor.*.hostSecondBusy { return }
        buffer = compositor.*.hostSecondBuffer
        offset = compositor.*.width * compositor.*.height * 4
        compositor.*.hostSecondBusy = true
    } else {
        compositor.*.hostFirstBusy = true
    }
    var pixels: [*]u8 = undefined
    unsafe { pixels = @ptrFromInt([*]u8, compositor.*.hostMemory.address + offset) }
    scene.compose(compositor, pixels)
    compositor.*.lastFrame = pixels
    compositor.*.frames += 1
    const surface = compositor.*.hostSurface
    surface.attach(&buffer, 0, 0)
    surface.damage(0, 0, @intCast(i32, compositor.*.width), @intCast(i32, compositor.*.height))
    const callback = surface.frame()
    callback.setHandler(onFrame, contextOf(compositor))
    surface.commit()
    compositor.*.hostFramePending = true
    compositor.*.needsRedraw = false
}

fn appendNumber(bytes: [*]u8, start: usize, value: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var length = start
    while count > 0 {
        count -= 1
        bytes[length] = digits[count]
        length += 1
    }
    return length
}

// Writes the last composed frame as a binary PPM image.
pub fn screenshot(compositor: *Compositor, path: [*]const u8) -> bool {
    if compositor.*.frames == 0 { return false }
    const file = std.fs.open(path, 577, 420)
    if !std.fs.isValid(file) { return false }
    var header: [64]u8 = undefined
    var length: usize = 0
    for byte in "P6\n" {
        header[length] = byte
        length += 1
    }
    unsafe { length = appendNumber(@ptrCast([*]u8, &header), length, compositor.*.width) }
    header[length] = 32
    length += 1
    unsafe { length = appendNumber(@ptrCast([*]u8, &header), length, compositor.*.height) }
    for byte in "\n255\n" {
        header[length] = byte
        length += 1
    }
    var ok = false
    unsafe { ok = std.fs.writeAllBytes(file, @ptrCast([*]const u8, &header), length) }
    const row_bytes = compositor.*.width * 3
    const row = state.allocate(compositor, row_bytes)
    var y: usize = 0
    while ok && y < compositor.*.height {
        var x: usize = 0
        while x < compositor.*.width {
            const source = (y * compositor.*.width + x) * 4
            row[x * 3] = compositor.*.lastFrame[source + 2]
            row[x * 3 + 1] = compositor.*.lastFrame[source + 1]
            row[x * 3 + 2] = compositor.*.lastFrame[source]
            x += 1
        }
        ok = std.fs.writeAllBytes(file, row, row_bytes)
        y += 1
    }
    state.release(compositor, row, row_bytes)
    const closed = std.fs.close(file)
    return ok
}
