// The aggregate arena, and how the compositor keeps it from filling up.
//
// This compiler keeps every struct, array and tuple value that is not a
// field of something else — locals, literals, values returned by
// functions — in one 256 MiB mapping that is only ever bumped: nothing in
// it is released when a function returns. A program that runs for long
// allocates it up (each pointer motion costs a few hundred bytes, an
// event's decoded payload and a few rectangles, so a mouse at 1000 Hz
// fills it within minutes) and traps with an illegal instruction when it
// is full: that was the compositor dying with signal 4 after a minute or
// two of use.
//
// The compositor's event loop is a fixed point: everything that outlives
// one turn of the loop is in memory from the allocator (surfaces, clients,
// lists, renderer records, the frame buffers) or was allocated before the
// loop started (the compositor record, the backends, the font). So the loop
// notes the arena's fill before its first turn and restores it at the start
// of every turn (release), which frees what the turn's handlers and frame
// allocated. The arena's first word is the fill (the next free address),
// which the generated code bumps; the arena is found by walking down from
// a local of this module, page by page within the mapping /proc/self/maps
// lists for it (the kernel merges neighbouring anonymous mappings, so the
// mapping can be larger than the arena), to the word that an allocation
// proves to be the fill.
//
// MLX_ARENA_RELEASE=0 keeps the arena growing (as before), and
// MLX_ARENA_POISON=1 overwrites the released bytes so that a value wrongly
// kept across turns is noticed in tests rather than read back intact.
const std = @import("std")
const state = @import("./state.mlx")

const Compositor = state.Compositor

const SYS_read: usize = 0
const SYS_open: usize = 2
const SYS_close: usize = 3

// The arena's size: 256 MiB plus the fill word.
const ARENA_SIZE: usize = 268435464
const POISON: u8 = 165

// Finds the arena; 0 when it is not where this module expects it (the
// loop then runs without releasing, as before).
pub fn locate() -> usize {
    var probe: [8]u8 = undefined
    const inside = @intFromPtr(&probe)
    const low = mappingStart(inside)
    if low == 0 { return 0 }
    var candidate = inside & 18446744073709547520
    while candidate >= low {
        if confirm(candidate, inside) { return candidate }
        if candidate < 4096 { break }
        candidate -= 4096
    }
    return 0
}

// Whether the word at `candidate` is the arena's fill: it points past
// `inside`, and allocating a value places it there and advances it.
fn confirm(candidate: usize, inside: usize) -> bool {
    const before = fillWord(candidate).*
    if before <= inside || before > candidate + ARENA_SIZE { return false }
    const placed = allocateWord()
    return placed == before && fillWord(candidate).* == before + 8
}

// Allocates one 8-byte value and returns where it was placed.
fn allocateWord() -> usize {
    var probe: [8]u8 = undefined
    return @intFromPtr(&probe)
}

// The start of the mapping in /proc/self/maps that holds `inside`.
fn mappingStart(inside: usize) -> usize {
    var path: [16]u8 = [16]u8{ 47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 109, 97, 112, 115, 0 } // /proc/self/maps
    const file = std.linux.syscall3(SYS_open, @intFromPtr(&path), 0, 0)
    if file < 0 { return 0 }
    // Lines are "lo-hi perms offset device inode path"; the mapping's
    // bounds are the first two hexadecimal numbers of a line.
    var buffer: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var low: usize = 0
    var high: usize = 0
    var field: usize = 0
    var found: usize = 0
    while found == 0 {
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, file), @intFromPtr(bytes), 4096)
        if count <= 0 { break }
        var index: usize = 0
        while index < @bitCast(usize, count) {
            const byte = bytes[index]
            index += 1
            if byte == 10 {
                if field >= 1 && low <= inside && inside < high { found = low }
                low = 0
                high = 0
                field = 0
            } else if field == 0 && byte == 45 {
                field = 1
            } else if field == 1 && byte == 32 {
                field = 2
            } else if field < 2 {
                const digit = hexDigit(byte)
                if field == 0 { low = low * 16 + digit } else { high = high * 16 + digit }
            }
        }
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, file))
    return found
}

fn hexDigit(byte: u8) -> usize {
    if byte >= 48 && byte <= 57 { return @intCast(usize, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(usize, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(usize, byte - 55) }
    return 0
}

fn fillWord(base: usize) -> *usize {
    var word: *usize = undefined
    unsafe { word = @ptrFromInt(*usize, base) }
    return word
}

// Bytes of the arena in use.
pub fn used(base: usize) -> usize {
    if base == 0 { return 0 }
    return fillWord(base).* - base - 8
}

// Reads the environment and finds the arena; says what it will do when
// verbose. Called once everything the loop keeps was set up, right before
// the loop's first turn.
pub fn begin(compositor: *Compositor) -> void {
    const disabled = state.environmentValue(compositor.*.environment, "MLX_ARENA_RELEASE")
    compositor.*.arenaRelease = @intFromPtr(disabled) == 0 || disabled[0] != 48
    const poison = state.environmentValue(compositor.*.environment, "MLX_ARENA_POISON")
    compositor.*.arenaPoison = @intFromPtr(poison) != 0 && poison[0] == 49
    compositor.*.arena = if compositor.*.arenaRelease { locate() } else { 0 }
    compositor.*.arenaMark = if compositor.*.arena != 0 { fillWord(compositor.*.arena).* } else { 0 }
    if !compositor.*.verbose { return }
    if compositor.*.arena != 0 {
        state.say("memory: ")
        state.sayNumber(used(compositor.*.arena) / 1024)
        state.say(" KiB of values kept; each turn of the loop releases its own")
        if compositor.*.arenaPoison { state.say(" (and poisons them)") }
        state.say("\n")
    } else if compositor.*.arenaRelease {
        state.say("memory: the value arena was not found; values are kept until the compositor ends\n")
    } else {
        state.say("memory: values are kept until the compositor ends (MLX_ARENA_RELEASE=0)\n")
    }
}

// Says, when verbose, how much the loop's turns allocated at most; called
// when the loop ended.
pub fn end(compositor: *Compositor) -> void {
    if !compositor.*.verbose || compositor.*.arena == 0 { return }
    turn(compositor)
    state.say("memory: a turn of the loop allocated up to ")
    state.sayNumber(compositor.*.arenaPeak)
    state.say(" bytes of values\n")
}

// Releases what the last turn of the loop allocated.
pub fn turn(compositor: *Compositor) -> void {
    const base = compositor.*.arena
    if base == 0 { return }
    const word = fillWord(base)
    const fill = word.*
    const mark = compositor.*.arenaMark
    if fill <= mark { return }
    if fill - mark > compositor.*.arenaPeak { compositor.*.arenaPeak = fill - mark }
    if compositor.*.arenaPoison {
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrFromInt([*]u8, mark) }
        var index: usize = 0
        while index < fill - mark {
            bytes[index] = POISON
            index += 1
        }
    }
    word.* = mark
}
