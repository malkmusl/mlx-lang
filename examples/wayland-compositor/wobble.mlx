// Wobbly windows: a window being moved bends like jelly and swings back,
// as Compiz's did. Its outline is a Bezier surface with 4x4 control points
// over its rest bounds (scene.restBounds: the frame, the title bar and
// every buffer), each kept as its offset from where it rests and a
// velocity (fixed point, 1/65536 pixels). Neighbouring points pull on each other (NEIGHBOUR), every
// point back to its rest (ANCHOR), and friction (DAMPING) settles them.
// While the window moves, the point nearest where it was grabbed stays
// under the pointer and the others lag behind (moved), then catch up and
// swing.
//
// The shell steps the springs after every frame (advance: fixed 4 ms
// steps) and damages what the window covers, bounds widened by the largest
// offset (wobbleReach), so frames keep coming until it is still. The
// Vulkan renderer draws it bent (vulkan.mlx, the warp shader); the CPU
// renderer draws it flat, so there it does not wobble at all.
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const ui = @import("std.ui")

const Compositor = state.Compositor
const Surface = state.Surface

pub const POINTS: usize = 16
// No point grabbed.
pub const NONE: usize = 16

// Springs (per second squared), friction (per second), steps a second,
// how far a point may lag, and what one pixel is (the offsets and
// velocities are fixed point: 1/65536 pixels).
const NEIGHBOUR: i64 = 3000
const ANCHOR: i64 = 150
const DAMPING: i64 = 12
const STEPS_PER_SECOND: i64 = 250
const STEP_MICROS: usize = 4000
const MAX_STEPS: usize = 50
const PIXEL: i64 = 65536
const LIMIT: i64 = 16384000

// Wobbling needs the Vulkan renderer (and the setting).
pub fn enabled(compositor: *const Compositor) -> bool {
    return compositor.*.wobblyWindows && compositor.*.renderer != 0
}

fn start(surface: *Surface) -> void {
    if surface.*.wobbling { return }
    var index: usize = 0
    while index < POINTS {
        surface.*.wobbleX[index] = 0
        surface.*.wobbleY[index] = 0
        surface.*.wobbleVX[index] = 0
        surface.*.wobbleVY[index] = 0
        index += 1
    }
    surface.*.wobbling = true
    surface.*.wobbleGrab = NONE
    surface.*.wobbleTime = state.microseconds()
    surface.*.wobbleReach = 0
}

fn clampIndex(value: i32) -> usize {
    if value < 0 { return 0 }
    if value > 3 { return 3 }
    return @intCast(usize, value)
}

// The toplevel is grabbed at (x, y) (a move starts): the control point
// nearest it stays under the pointer.
pub fn grab(compositor: *Compositor, surface: *Surface, x: i32, y: i32) -> void {
    if !enabled(compositor) { return }
    start(surface)
    const bounds = scene.restBounds(surface)
    if bounds.width <= 0 || bounds.height <= 0 { return }
    const column = clampIndex(((x - bounds.x) * 3 + bounds.width / 2) / bounds.width)
    const row = clampIndex(((y - bounds.y) * 3 + bounds.height / 2) / bounds.height)
    surface.*.wobbleGrab = row * 4 + column
}

// The move ended: every point swings freely back to its rest.
pub fn release(surface: *Surface) -> void {
    surface.*.wobbleGrab = NONE
}

fn limited(value: i64) -> i64 {
    if value > LIMIT { return LIMIT }
    if value < 0 - LIMIT { return 0 - LIMIT }
    return value
}

fn magnitude(value: i64) -> i64 { return if value < 0 { 0 - value } else { value } }

// The largest offset, rounded up to whole pixels (plus one for the
// sampling): scene.surfaceBounds widens by it.
fn updateReach(surface: *Surface) -> void {
    var largest: i64 = 0
    var index: usize = 0
    while index < POINTS {
        if magnitude(surface.*.wobbleX[index]) > largest { largest = magnitude(surface.*.wobbleX[index]) }
        if magnitude(surface.*.wobbleY[index]) > largest { largest = magnitude(surface.*.wobbleY[index]) }
        index += 1
    }
    surface.*.wobbleReach = @intCast(i32, largest / PIXEL) + 2
}

// The toplevel moved by (dx, dy) (its x and y changed already): the points
// not held stay where they were on the screen, lagging behind.
pub fn moved(compositor: *Compositor, surface: *Surface, dx: i32, dy: i32) -> void {
    if !enabled(compositor) { return }
    start(surface)
    const fx = @intCast(i64, dx) * PIXEL
    const fy = @intCast(i64, dy) * PIXEL
    var index: usize = 0
    while index < POINTS {
        if index != surface.*.wobbleGrab {
            surface.*.wobbleX[index] = limited(surface.*.wobbleX[index] - fx)
            surface.*.wobbleY[index] = limited(surface.*.wobbleY[index] - fy)
        }
        index += 1
    }
    updateReach(surface)
}

fn step(surface: *Surface) -> void {
    var ax: [16]i64 = undefined
    var ay: [16]i64 = undefined
    var index: usize = 0
    while index < POINTS {
        const column = index % 4
        const row = index / 4
        const x = surface.*.wobbleX[index]
        const y = surface.*.wobbleY[index]
        var fx = 0 - ANCHOR * x - DAMPING * surface.*.wobbleVX[index]
        var fy = 0 - ANCHOR * y - DAMPING * surface.*.wobbleVY[index]
        if column > 0 {
            fx += NEIGHBOUR * (surface.*.wobbleX[index - 1] - x)
            fy += NEIGHBOUR * (surface.*.wobbleY[index - 1] - y)
        }
        if column < 3 {
            fx += NEIGHBOUR * (surface.*.wobbleX[index + 1] - x)
            fy += NEIGHBOUR * (surface.*.wobbleY[index + 1] - y)
        }
        if row > 0 {
            fx += NEIGHBOUR * (surface.*.wobbleX[index - 4] - x)
            fy += NEIGHBOUR * (surface.*.wobbleY[index - 4] - y)
        }
        if row < 3 {
            fx += NEIGHBOUR * (surface.*.wobbleX[index + 4] - x)
            fy += NEIGHBOUR * (surface.*.wobbleY[index + 4] - y)
        }
        ax[index] = fx
        ay[index] = fy
        index += 1
    }
    index = 0
    while index < POINTS {
        if index == surface.*.wobbleGrab {
            surface.*.wobbleX[index] = 0
            surface.*.wobbleY[index] = 0
            surface.*.wobbleVX[index] = 0
            surface.*.wobbleVY[index] = 0
        } else {
            // Semi-implicit Euler: the velocity first, the offset with it.
            surface.*.wobbleVX[index] = surface.*.wobbleVX[index] + ax[index] / STEPS_PER_SECOND
            surface.*.wobbleVY[index] = surface.*.wobbleVY[index] + ay[index] / STEPS_PER_SECOND
            surface.*.wobbleX[index] = limited(surface.*.wobbleX[index] + surface.*.wobbleVX[index] / STEPS_PER_SECOND)
            surface.*.wobbleY[index] = limited(surface.*.wobbleY[index] + surface.*.wobbleVY[index] / STEPS_PER_SECOND)
        }
        index += 1
    }
}

// Whether every point rests (within a third of a pixel, nearly still).
fn settled(surface: *const Surface) -> bool {
    if surface.*.wobbleGrab != NONE { return false }
    var index: usize = 0
    while index < POINTS {
        if magnitude(surface.*.wobbleX[index]) > PIXEL / 3 || magnitude(surface.*.wobbleY[index]) > PIXEL / 3 { return false }
        if magnitude(surface.*.wobbleVX[index]) > PIXEL * 3 || magnitude(surface.*.wobbleVY[index]) > PIXEL * 3 { return false }
        index += 1
    }
    return true
}

// Steps every wobbling window up to now (after each frame), damaging what
// it covers before and after.
pub fn advance(compositor: *Compositor) -> void {
    const now = state.microseconds()
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const surface = state.surfaceAt(state.listAt(compositor.*.surfaces, index))
        index += 1
        if !surface.*.wobbling { continue }
        if !enabled(compositor) || surface.*.role != state.ROLE_TOPLEVEL {
            scene.damageSurface(compositor, surface)
            surface.*.wobbling = false
            surface.*.wobbleReach = 0
            continue
        }
        var steps = (now - surface.*.wobbleTime) / STEP_MICROS
        if steps == 0 { continue }
        scene.damageSurface(compositor, surface)
        if steps > MAX_STEPS {
            steps = MAX_STEPS
            surface.*.wobbleTime = now
        } else {
            surface.*.wobbleTime += steps * STEP_MICROS
        }
        while steps > 0 {
            step(surface)
            steps -= 1
        }
        if settled(surface) {
            surface.*.wobbling = false
            surface.*.wobbleReach = 0
        } else {
            updateReach(surface)
        }
        scene.damageSurface(compositor, surface)
    }
}

// The offsets in 1/16 pixels (x for the 16 points, then y), for the warp
// shader.
pub fn offset(surface: *const Surface, index: usize) -> i32 {
    const value = if index < POINTS { surface.*.wobbleX[index] } else { surface.*.wobbleY[index - POINTS] }
    return @intCast(i32, value / 4096)
}
