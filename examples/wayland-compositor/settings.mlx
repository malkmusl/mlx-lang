// The compositor's settings, from $XDG_CONFIG_HOME/mlx/compositor.conf
// (~/.config/mlx/compositor.conf), read at start and again whenever the
// file changes (looked at twice a second), so a settings app (examples/
// mlx-settings) changes the running compositor by writing it. One setting
// per line, lines starting with `#` are comments:
//
//     border-color = #5aa0ff           (the focused window's frame and title bar)
//     inactive-border-color = #505060  (the other windows')
//     title-bars = on                  (on or off)
//     fps-counter = on                 (frames per second in title bars)
//     client-decorations = off         (programs draw their own title bars)
//
// Settings the file leaves out keep their defaults; a line that does not
// parse is ignored (and logged).
const std = @import("std")
const state = @import("./state.mlx")
const entries = @import("./entries.mlx")
const scene = @import("./scene.mlx")

const Compositor = state.Compositor

const CHECK_INTERVAL: usize = 500

fn say(text: []const u8) -> void { state.say(text) }

// Where the file is: into compositor.settingsPath. Call once, with the
// environment set.
pub fn init(compositor: *Compositor) -> void {
    compositor.*.settingsPathLength = 0
    compositor.*.settingsStamp = 0
    compositor.*.settingsCheckedAt = 0
    const config = state.environmentValue(compositor.*.environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] != 0 {
        appendC(compositor, config)
    } else {
        const home = state.environmentValue(compositor.*.environment, "HOME")
        if @intFromPtr(home) == 0 || home[0] == 0 { return }
        appendC(compositor, home)
        append(compositor, "/.config")
    }
    append(compositor, "/mlx/compositor.conf")
    compositor.*.settingsPath[compositor.*.settingsPathLength] = 0
    check(compositor)
}

fn append(compositor: *Compositor, text: []const u8) -> void {
    for byte in text {
        if compositor.*.settingsPathLength < 250 {
            compositor.*.settingsPath[compositor.*.settingsPathLength] = byte
            compositor.*.settingsPathLength += 1
        }
    }
}

fn appendC(compositor: *Compositor, text: [*]const u8) -> void {
    var index: usize = 0
    while text[index] != 0 && compositor.*.settingsPathLength < 250 {
        compositor.*.settingsPath[compositor.*.settingsPathLength] = text[index]
        compositor.*.settingsPathLength += 1
        index += 1
    }
}

fn pathOf(compositor: *Compositor) -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, @intFromPtr(compositor) + @offsetOf(Compositor, "settingsPath")) }
}

// Reads the file again when it changed; cheap enough for every turn of the
// event loop (it looks only twice a second).
pub fn poll(compositor: *Compositor) -> void {
    if compositor.*.settingsPathLength == 0 { return }
    const now = state.microseconds() / 1000
    if now - compositor.*.settingsCheckedAt < CHECK_INTERVAL { return }
    check(compositor)
}

fn check(compositor: *Compositor) -> void {
    compositor.*.settingsCheckedAt = state.microseconds() / 1000
    var status: std.fs.Stat = undefined
    // A missing file counts as stamp 1: the defaults.
    var stamp: usize = 1
    if std.fs.status(pathOf(compositor), &status) == 0 {
        stamp = @bitCast(usize, status.modifiedSeconds) *% 1000000000 +% @bitCast(usize, status.modifiedNanoseconds) +% @bitCast(usize, status.size) *% 7
    }
    if stamp == compositor.*.settingsStamp { return }
    compositor.*.settingsStamp = stamp
    load(compositor, stamp != 1)
}

// Back to the defaults, then what the file says.
fn load(compositor: *Compositor, exists: bool) -> void {
    compositor.*.focusColor = scene.FOCUS_COLOR
    compositor.*.frameColor = scene.FRAME_COLOR
    compositor.*.titleBars = true
    compositor.*.clientDecorations = false
    compositor.*.showFps = !compositor.*.noFpsOption
    if exists {
        const file = std.fs.open(pathOf(compositor), 0, 0)
        if std.fs.isValid(file) {
            const contents = std.fs.readToEndAlloc(file, compositor.*.allocator)
            const closed = std.fs.close(file)
            const text = contents.items
            var at: usize = 0
            while at < contents.length {
                var end = at
                while end < contents.length && text[end] != 10 { end += 1 }
                line(compositor, text[at..end])
                at = end + 1
            }
            std.fs.ArrayList.deinit(contents)
        }
    }
    if compositor.*.verbose {
        say("settings: border #")
        sayColor(compositor.*.focusColor)
        say(", inactive #")
        sayColor(compositor.*.frameColor)
        say(if compositor.*.titleBars { ", title bars on" } else { ", title bars off" })
        say(if compositor.*.showFps { ", fps counter on" } else { ", fps counter off" })
        say(if compositor.*.clientDecorations { ", client decorations on\n" } else { ", client decorations off\n" })
    }
    // Everything is drawn again, with the colours in the renderer's
    // palette refreshed.
    if compositor.*.renderer != 0 { entries.rendererReloaded(compositor) }
    scene.damageAll(compositor)
    entries.settingsChanged(compositor)
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

fn trimmed(text: []const u8) -> []const u8 {
    var start: usize = 0
    var end = text.length
    while start < end && isSpace(text[start]) { start += 1 }
    while end > start && isSpace(text[end - 1]) { end -= 1 }
    return text[start..end]
}

fn same(text: []const u8, word: []const u8) -> bool {
    if text.length != word.length { return false }
    var index: usize = 0
    while index < text.length {
        if text[index] != word[index] { return false }
        index += 1
    }
    return true
}

// "on"/"off" (also yes/no, true/false, 1/0) into `value`; false when it is
// neither.
fn parseSwitch(text: []const u8, value: *bool) -> bool {
    if same(text, "on") || same(text, "yes") || same(text, "true") || same(text, "1") {
        value.* = true
        return true
    }
    if same(text, "off") || same(text, "no") || same(text, "false") || same(text, "0") {
        value.* = false
        return true
    }
    return false
}

fn hexDigit(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(u32, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(u32, byte - 55) }
    return 16
}

// "#rrggbb" (or without the #) into an opaque colour; false otherwise.
fn parseColor(text: []const u8, color: *u32) -> bool {
    var start: usize = 0
    if text.length > 0 && text[0] == 35 { start = 1 }
    if text.length - start != 6 { return false }
    var value: u32 = 0
    var index = start
    while index < text.length {
        const digit = hexDigit(text[index])
        if digit == 16 { return false }
        value = value * 16 + digit
        index += 1
    }
    color.* = 4278190080 | value
    return true
}

fn line(compositor: *Compositor, raw: []const u8) -> void {
    const text = trimmed(raw)
    if text.length == 0 || text[0] == 35 { return }
    var equals: usize = 0
    while equals < text.length && text[equals] != 61 { equals += 1 }
    if equals == text.length {
        bad(text)
        return
    }
    const key = trimmed(text[0..equals])
    const value = trimmed(text[equals + 1..text.length])
    var ok = false
    var color: u32 = 0
    var on = true
    if same(key, "border-color") {
        ok = parseColor(value, &color)
        if ok { compositor.*.focusColor = color }
    } else if same(key, "inactive-border-color") {
        ok = parseColor(value, &color)
        if ok { compositor.*.frameColor = color }
    } else if same(key, "title-bars") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.titleBars = on }
    } else if same(key, "fps-counter") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.showFps = on && !compositor.*.noFpsOption }
    } else if same(key, "client-decorations") {
        ok = parseSwitch(value, &on)
        if ok { compositor.*.clientDecorations = on }
    }
    if !ok { bad(text) }
}

fn bad(text: []const u8) -> void {
    say("settings: ignored line: ")
    say(text)
    say("\n")
}

fn sayColor(color: u32) -> void {
    var digits: [6]u8 = undefined
    var index: usize = 0
    while index < 6 {
        const nibble = (color >> @intCast(u5, (5 - index) * 4)) & 15
        digits[index] = @intCast(u8, if nibble < 10 { 48 + nibble } else { 87 + nibble })
        index += 1
    }
    say(digits[0..6])
}
