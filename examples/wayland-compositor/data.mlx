// Copy and paste between clients: wl_data_device_manager with its data
// sources, data devices and data offers (GTK 4 refuses a display without
// it). The selection (the clipboard) is a data source a client set; the
// client with keyboard focus gets it as a data offer, when it gains focus
// and whenever the selection changes. Reading an offer asks the source's
// client to write the data into the reader's pipe; the compositor only
// passes the pipe along. Drag and drop is not supported: the source of a
// drag is cancelled at once, as for a drag that ended nowhere.

const std = @import("std")
const wl = @import("std.wayland")
const state = @import("./state.mlx")

const Compositor = state.Compositor

// Room for a source's MIME types, each stored as a length byte and its
// bytes (types longer than 255 bytes are not offered).
const MIME_BYTES: usize = 4096

pub const Source = struct {
    compositor: *Compositor
    resource: wl.server.Object
    mimes: [*]u8
    mimeBytes: usize
}

pub const Device = struct {
    compositor: *Compositor
    resource: wl.server.Object
}

pub const Offer = struct {
    compositor: *Compositor
    resource: wl.server.Object
    // The Source it reads from; 0 once that source is gone.
    source: usize
}

fn sourceAt(address: usize) -> *Source {
    unsafe { return @ptrFromInt(*Source, address) }
}

fn deviceAt(address: usize) -> *Device {
    unsafe { return @ptrFromInt(*Device, address) }
}

fn offerAt(address: usize) -> *Offer {
    unsafe { return @ptrFromInt(*Offer, address) }
}

fn recordOf(context: *anyopaque) -> usize { return @intFromPtr(context) }

fn contextAt(address: usize) -> *anyopaque {
    unsafe { return @ptrFromInt(*anyopaque, address) }
}

fn findSource(compositor: *Compositor, object: wl.server.Object) -> usize {
    var index: usize = 0
    while index < compositor.*.dataSources.length {
        const address = state.listAt(compositor.*.dataSources, index)
        const source = sourceAt(address)
        if source.*.resource.id == object.id && state.sameClient(source.*.resource, object) { return address }
        index += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Offering the selection

// Sends the selection to `device`: a new data offer listing the source's
// MIME types, or none when nothing is selected.
fn offerSelection(compositor: *Compositor, device: *Device) -> void {
    const resource = wl.wl_data_device.Resource.fromObject(device.*.resource)
    if compositor.*.selection == 0 {
        resource.sendSelection(null)
        return
    }
    const source = sourceAt(compositor.*.selection)
    var offer = resource.sendDataOffer()
    if offer.isNull() { return }
    const memory = state.allocate(compositor, @sizeOf(Offer))
    const address = @intFromPtr(memory)
    const record = offerAt(address)
    record.*.compositor = compositor
    record.*.resource = offer.object
    record.*.source = compositor.*.selection
    compositor.*.dataOffers = state.listAppend(compositor.*.dataOffers, address)
    offer.setHandler(onOffer, contextAt(address))
    offer.setDestroyHandler(onOfferDestroyed, contextAt(address))
    var at: usize = 0
    while at < source.*.mimeBytes {
        const length = @intCast(usize, source.*.mimes[at])
        offer.sendOffer(source.*.mimes[at + 1..at + 1 + length])
        at += 1 + length
    }
    resource.sendSelection(&offer)
}

// Gives the client with keyboard focus the current selection (on every
// data device it has). Call when the focus or the selection changed,
// before the keyboard enter event.
pub fn offerToFocus(compositor: *Compositor) -> void {
    const focused = compositor.*.keyboardFocus
    if focused == 0 { return }
    const surface = state.surfaceAt(focused).*.resource
    var index: usize = 0
    while index < compositor.*.dataDevices.length {
        const device = deviceAt(state.listAt(compositor.*.dataDevices, index))
        if state.sameClient(device.*.resource, surface) { offerSelection(compositor, device) }
        index += 1
    }
}

fn setSelection(compositor: *Compositor, address: usize) -> void {
    const old = compositor.*.selection
    if old == address { return }
    // The replaced source learns that it is no longer the selection.
    if old != 0 { wl.wl_data_source.Resource.fromObject(sourceAt(old).*.resource).sendCancelled() }
    compositor.*.selection = address
    if compositor.*.verbose {
        if address == 0 { state.say("selection: cleared\n") } else { state.say("selection: set\n") }
    }
    offerToFocus(compositor)
}

// ---------------------------------------------------------------------------
// wl_data_offer

fn onOffer(context: *anyopaque, request: wl.server.Request) -> void {
    const offer = offerAt(recordOf(context))
    if request.opcode != wl.wl_data_offer.REQUEST_RECEIVE { return }
    const decoded = wl.wl_data_offer.decodeRequest(request)
    const receive = decoded.receive
    // The source's client writes into the pipe (sendSend passes a copy);
    // the reader sees end of file once the writer closes it.
    if offer.*.source != 0 {
        const mime = receive.mime_type
        wl.wl_data_source.Resource.fromObject(sourceAt(offer.*.source).*.resource).sendSend(mime.pointer[0..mime.length], receive.fd)
    }
    receive.fd.close()
}

fn onOfferDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = recordOf(context)
    const compositor = offerAt(address).*.compositor
    compositor.*.dataOffers = state.listRemove(compositor.*.dataOffers, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Offer)) }
}

// ---------------------------------------------------------------------------
// wl_data_source

fn onSource(context: *anyopaque, request: wl.server.Request) -> void {
    const source = sourceAt(recordOf(context))
    if request.opcode != wl.wl_data_source.REQUEST_OFFER { return }
    const decoded = wl.wl_data_source.decodeRequest(request)
    const mime = decoded.offer.mime_type
    if mime.length == 0 || mime.length > 255 || source.*.mimeBytes + 1 + mime.length > MIME_BYTES { return }
    source.*.mimes[source.*.mimeBytes] = @intCast(u8, mime.length)
    var index: usize = 0
    while index < mime.length {
        source.*.mimes[source.*.mimeBytes + 1 + index] = mime.pointer[index]
        index += 1
    }
    source.*.mimeBytes += 1 + mime.length
}

fn onSourceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = recordOf(context)
    const source = sourceAt(address)
    const compositor = source.*.compositor
    compositor.*.dataSources = state.listRemove(compositor.*.dataSources, address)
    var index: usize = 0
    while index < compositor.*.dataOffers.length {
        const offer = offerAt(state.listAt(compositor.*.dataOffers, index))
        if offer.*.source == address { offer.*.source = 0 }
        index += 1
    }
    // A selection whose source is gone is no selection.
    if compositor.*.selection == address {
        compositor.*.selection = 0
        offerToFocus(compositor)
    }
    state.release(compositor, source.*.mimes, MIME_BYTES)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Source)) }
}

fn createSource(compositor: *Compositor, resource: wl.wl_data_source.Resource) -> void {
    const memory = state.allocate(compositor, @sizeOf(Source))
    const address = @intFromPtr(memory)
    const source = sourceAt(address)
    source.*.compositor = compositor
    source.*.resource = resource.object
    source.*.mimes = state.allocate(compositor, MIME_BYTES)
    source.*.mimeBytes = 0
    compositor.*.dataSources = state.listAppend(compositor.*.dataSources, address)
    resource.setHandler(onSource, contextAt(address))
    resource.setDestroyHandler(onSourceDestroyed, contextAt(address))
}

// ---------------------------------------------------------------------------
// wl_data_device

fn onDevice(context: *anyopaque, request: wl.server.Request) -> void {
    const device = deviceAt(recordOf(context))
    const compositor = device.*.compositor
    const decoded = wl.wl_data_device.decodeRequest(request)
    if request.opcode == wl.wl_data_device.REQUEST_SET_SELECTION {
        const source = decoded.set_selection.source
        setSelection(compositor, if source.isNull() { 0 } else { findSource(compositor, source.object) })
    } else if request.opcode == wl.wl_data_device.REQUEST_START_DRAG {
        const source = decoded.start_drag.source
        if !source.isNull() { source.sendCancelled() }
    }
}

fn onDeviceDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const address = recordOf(context)
    const compositor = deviceAt(address).*.compositor
    compositor.*.dataDevices = state.listRemove(compositor.*.dataDevices, address)
    unsafe { state.release(compositor, @ptrFromInt([*]u8, address), @sizeOf(Device)) }
}

// ---------------------------------------------------------------------------
// wl_data_device_manager

fn onManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.wl_data_device_manager.decodeRequest(request)
    if request.opcode == wl.wl_data_device_manager.REQUEST_CREATE_DATA_SOURCE {
        createSource(compositor, decoded.create_data_source.id)
    } else if request.opcode == wl.wl_data_device_manager.REQUEST_GET_DATA_DEVICE {
        const resource = decoded.get_data_device.id
        const memory = state.allocate(compositor, @sizeOf(Device))
        const address = @intFromPtr(memory)
        const device = deviceAt(address)
        device.*.compositor = compositor
        device.*.resource = resource.object
        compositor.*.dataDevices = state.listAppend(compositor.*.dataDevices, address)
        resource.setHandler(onDevice, contextAt(address))
        resource.setDestroyHandler(onDeviceDestroyed, contextAt(address))
        // A client that already has focus gets the selection right away.
        const focused = compositor.*.keyboardFocus
        if focused != 0 && state.sameClient(resource.object, state.surfaceAt(focused).*.resource) { offerSelection(compositor, device) }
    }
}

fn bindManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.wl_data_device_manager.Resource.fromObject(object).setHandler(onManager, context)
}

pub fn createGlobal(compositor: *Compositor) -> bool {
    compositor.*.dataSources = state.newList(compositor.*.allocator)
    compositor.*.dataDevices = state.newList(compositor.*.allocator)
    compositor.*.dataOffers = state.newList(compositor.*.allocator)
    compositor.*.selection = 0
    var memory: [*]u8 = undefined
    unsafe { memory = @ptrCast([*]u8, compositor) }
    return compositor.*.server.createGlobal(wl.Interface.wl_data_device_manager, 3, bindManager, state.contextOf(memory)) != 0
}
