// When the compositor (or the dock) dies of a signal it says so first: which signal, the
// address of the instruction (a failed runtime check, an index out of
// range, a subtraction below zero or an overflow, is compiled to an illegal
// instruction), the address a fault touched, and the code addresses on the
// stack. The handler runs on a stack of its own, so a stack overflow is
// reported too. With the compiler building the same binary from the same
// sources, the addresses find the place. Freestanding, the message is the
// last line of the session log.

const std = @import("std")

const SYS_rt_sigaction: usize = 13
const SYS_exit_group: usize = 231
const SYS_rt_sigreturn: usize = 15
const SYS_mincore: usize = 27
const SYS_mmap: usize = 9
const SYS_sigaltstack: usize = 131
const SA_SIGINFO: usize = 4
const SA_ONSTACK: usize = 134217728
const SA_RESTORER: usize = 67108864
// The handler's own stack: a stack overflow is one of the crashes to
// report, and the handler could not run on the stack that overflowed.
const HANDLER_STACK_SIZE: usize = 262144
// siginfo_t: signo, errno, code, then (padding) the faulting address.
const SI_ADDR_OFFSET: usize = 16
const SIGILL: usize = 4
const SIGBUS: usize = 7
const SIGFPE: usize = 8
const SIGSEGV: usize = 11
// ucontext_t: uc_flags, uc_link, uc_stack (24 bytes), then uc_mcontext,
// whose gregs hold rsp at 15 and rip at 16.
const RSP_OFFSET: usize = 40 + 15 * 8
const RIP_OFFSET: usize = 40 + 16 * 8

const SignalAction = struct {
    handler: usize
    flags: usize
    restorer: usize
    mask: usize
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stdout(), text)
}

fn sayHex(value: usize) -> void {
    const ignored = std.io.writeHex(std.io.stdout(), value)
}

// The C-ABI handler (the kernel calls it with the signal, siginfo_t and
// ucontext_t, on the handler stack). It never returns.
export fn mlxCompositorCrashed(signal: i32, info: usize, context: usize) -> void {
    // The program's name (the dock uses this too), from /proc/self/comm.
    var name: [32]u8 = undefined
    var length: isize = 0
    const file = std.linux.syscall3(2, @intFromPtr("/proc/self/comm"), 0, 0)
    if file >= 0 {
        length = std.linux.syscall3(0, @bitCast(usize, file), @intFromPtr(&name), 31)
        const closed = std.linux.syscall1(3, @bitCast(usize, file))
    }
    if length > 0 && name[@intCast(usize, length - 1)] == 10 { length -= 1 }
    if length > 0 {
        const written = std.io.writeAll(std.io.stdout(), name[0..@intCast(usize, length)])
        say(": crashed: ")
    } else {
        say("mlx-compositor: crashed: ")
    }
    var registers: [*]const usize = undefined
    unsafe { registers = @ptrFromInt([*]const usize, context) }
    const rip = registers[RIP_OFFSET / 8]
    const rsp = registers[RSP_OFFSET / 8]
    var fault: usize = 0
    if info != 0 {
        var fields: [*]const usize = undefined
        unsafe { fields = @ptrFromInt([*]const usize, info) }
        fault = fields[SI_ADDR_OFFSET / 8]
    }
    if signal == 4 {
        say("illegal instruction (a failed runtime check: an index out of range, an unsigned subtraction below zero, an overflow)")
    } else if signal == 11 {
        say("segmentation fault touching ")
        sayHex(fault)
        // A fault just below the stack pointer is the stack running out.
        if fault + 65536 >= rsp && fault <= rsp + 65536 { say(" (next to the stack pointer: the stack ran out, a recursion without end?)") }
    } else if signal == 7 {
        say("bus error touching ")
        sayHex(fault)
    } else if signal == 8 {
        say("arithmetic exception")
    } else {
        say("signal")
    }
    say(" at ")
    sayHex(rip)
    say(", stack pointer ")
    sayHex(rsp)
    // A rough backtrace: the words on the stack that point into the code
    // (return addresses among them; the code sits within 2 MB of us and
    // above the first page).
    say("; code addresses on the stack:")
    var here: usize = 0
    unsafe { here = @intFromPtr(mlxCompositorCrashed) }
    var low = here - 2097152
    if here < 2097152 + 65536 { low = 65536 }
    const high = here + 2097152
    var words: [*]const usize = undefined
    unsafe { words = @ptrFromInt([*]const usize, rsp) }
    var index: usize = 0
    var shown: usize = 0
    while index < 2048 && shown < 16 && pageMapped(rsp + index * 8) {
        const word = words[index]
        if word >= low && word < high && word != here {
            say(" ")
            sayHex(word)
            shown += 1
        }
        index += 1
    }
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 128 + @intCast(usize, signal))
}

// Whether the page holding `address` is mapped (the stack ends somewhere
// above the frame that crashed).
fn pageMapped(address: usize) -> bool {
    var residency: [1]u8 = [1]u8{ 0 }
    return std.linux.syscall3(SYS_mincore, address & 18446744073709547520, 4096, @intFromPtr(&residency)) == 0
}

// The kernel insists on a return path for the handler (SA_RESTORER) even
// though ours never returns.
export fn mlxCompositorSignalReturn() -> void {
    const ignored = std.linux.syscall0(SYS_rt_sigreturn)
}

// Installs the handler for the fatal signals, on a stack of its own;
// false when the kernel refused (the default action then remains).
pub fn install() -> bool {
    // The alternate stack (stack_t: sp, flags, size).
    const stack = std.linux.syscall6(SYS_mmap, 0, HANDLER_STACK_SIZE, 3, 34, 18446744073709551615, 0)
    if stack < 0 { return false }
    var alternate: [3]usize = [3]usize{ @bitCast(usize, stack), 0, HANDLER_STACK_SIZE }
    if std.linux.syscall2(SYS_sigaltstack, @intFromPtr(&alternate), 0) != 0 { return false }
    var handler: usize = 0
    var restorer: usize = 0
    unsafe {
        handler = @intFromPtr(mlxCompositorCrashed)
        restorer = @intFromPtr(mlxCompositorSignalReturn)
    }
    // Not SA_NODEFER: a handler that crashes must not run again.
    var action = SignalAction.{ .handler = handler, .flags = SA_SIGINFO | SA_ONSTACK | SA_RESTORER, .restorer = restorer, .mask = 0 }
    var ok = true
    const signals: [4]usize = [4]usize{ SIGILL, SIGSEGV, SIGBUS, SIGFPE }
    for signal in signals {
        if std.linux.syscall4(SYS_rt_sigaction, signal, @intFromPtr(&action), 0, 8) != 0 { ok = false }
    }
    return ok
}
