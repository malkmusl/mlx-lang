#!/bin/sh
# The "Mlx Compositor" desktop session, started by the display manager (GDM,
# SDDM, ...) after login.
#
# mlx-compositor runs freestanding: it drives the monitor (DRM/KMS) and
# reads the keyboard, mouse and touchpad itself, with the devices and VT
# switching from systemd-logind, at the monitor's preferred resolution,
# composing on the GPU when a Vulkan driver works (the default).
# When it quits (Alt+Shift+Q, or Ctrl+Alt+Backspace) the session ends.
#
# MLX_SESSION_HOST=cage or weston runs it nested instead, fullscreen in a
# minimal host compositor that drives the monitor (cage, or weston's kiosk
# shell).
#
# The session log goes to ${XDG_CONFIG_HOME:-~/.config}/mlx/compositor.log
# (the previous run's to compositor.log.old): the environment the session
# started with, the devices and drivers it found, everything the
# compositor prints (--verbose), and how it ended. A compositor that
# crashes within its first 20 seconds, or gives up that early while
# composing with Vulkan, is started once more with --renderer cpu.
#
# Environment:
#   MLX_SESSION_HOST      none (default: freestanding), cage or weston
#   MLX_SESSION_BACKEND   a host's backend: drm (default) or headless
#                         (tests)
#   MLX_COMPOSITOR_ARGS   more arguments for mlx-compositor, for example
#                         "--renderer cpu"
#   MLX_SESSION_LOG       the log file (default above)
#   XKB_DEFAULT_LAYOUT, XKB_DEFAULT_VARIANT, XKB_DEFAULT_MODEL,
#   XKB_DEFAULT_OPTIONS   keyboard (default: the system's, from localectl,
#                         /etc/default/keyboard or /etc/vconsole.conf)
set -u

# A first trace where it can always be written, for the case that the log
# below never appears: was the launcher started at all, and by whom?
trace="/tmp/mlx-session-$(id -u 2> /dev/null || echo unknown).log"
{
    echo "mlx-session: invoked $(date) as $(id -un 2> /dev/null || echo "$USER") HOME=${HOME:-unset} XDG_SESSION_ID=${XDG_SESSION_ID:-unset} inside=${MLX_SESSION_INSIDE:-no}"
} >> "$trace" 2> /dev/null

self=$(readlink -f "$0")
bindir=$(dirname "$self")
# The compositor writes to our log through its stdout (freestanding it
# would otherwise open a log of its own).
export MLX_COMPOSITOR_LOG=-

# Inside a host: the compositor itself. (Weston's autolaunch passes no
# arguments, so the host starts this script again with MLX_SESSION_INSIDE.)
if [ -n "${MLX_SESSION_INSIDE:-}" ]; then
    unset MLX_SESSION_INSIDE
    # MLX_COMPOSITOR_ARGS is split into words on purpose.
    # shellcheck disable=SC2086
    exec "$bindir/mlx-compositor" --backend nested --fullscreen --verbose ${MLX_COMPOSITOR_ARGS:-}
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Mlx
export XDG_SESSION_DESKTOP=mlx
unset DISPLAY WAYLAND_DISPLAY

log_file="${MLX_SESSION_LOG:-${XDG_CONFIG_HOME:-$HOME/.config}/mlx/compositor.log}"
mkdir -p "$(dirname "$log_file")"
[ -f "$log_file" ] && mv -f "$log_file" "$log_file.old"
exec > "$log_file" 2>&1
echo "mlx-session: logging to $log_file" >> "$trace" 2> /dev/null
echo "mlx-session: started $(date)"
echo "mlx-session: user $(id -un 2> /dev/null || echo "$USER") (uid $(id -u)), home $HOME"
echo "mlx-session: XDG_SESSION_ID=${XDG_SESSION_ID:-unset} XDG_SEAT=${XDG_SEAT:-unset} XDG_VTNR=${XDG_VTNR:-unset} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}"
if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl > /dev/null 2>&1; then
    session_info=$(loginctl show-session "$XDG_SESSION_ID" -p Type -p Class -p Active -p TTY -p Seat --value 2> /dev/null | tr '\n' ' ')
    echo "mlx-session: logind session: ${session_info:-not found}"
fi
bus_address="${DBUS_SYSTEM_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}"
if [ -S "${bus_address#unix:path=}" ]; then
    echo "mlx-session: system bus: $bus_address"
else
    echo "mlx-session: system bus: none at $bus_address (no logind: devices opened directly, no VT switching)"
fi
echo "mlx-session: DRM devices: $(ls /dev/dri 2> /dev/null | tr '\n' ' ')"
echo "mlx-session: Vulkan drivers: $(ls /usr/share/vulkan/icd.d /etc/vulkan/icd.d 2> /dev/null | grep json | tr '\n' ' ')${VK_DRIVER_FILES:+ (VK_DRIVER_FILES=$VK_DRIVER_FILES)}"
echo "mlx-session: compositor $bindir/mlx-compositor $(sha256sum "$bindir/mlx-compositor" 2> /dev/null | cut -c1-16)"
echo "mlx-session: MLX_COMPOSITOR_ARGS=${MLX_COMPOSITOR_ARGS:-}"

# The keyboard layout the system is set to, unless one is given.
field() {
    # field NAME FILE: the value of NAME=... in a shell-style file.
    sed -n "s/^$1=//p" "$2" 2> /dev/null | tail -n 1 | tr -d '"'
}
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ]; then
    layout="" variant="" model="" options=""
    if command -v localectl > /dev/null 2>&1; then
        status=$(localectl status 2> /dev/null)
        layout=$(printf '%s\n' "$status" | sed -n 's/^ *X11 Layout: *//p')
        variant=$(printf '%s\n' "$status" | sed -n 's/^ *X11 Variant: *//p')
        model=$(printf '%s\n' "$status" | sed -n 's/^ *X11 Model: *//p')
        options=$(printf '%s\n' "$status" | sed -n 's/^ *X11 Options: *//p')
    fi
    for file in /etc/default/keyboard /etc/vconsole.conf; do
        if [ -z "$layout" ] && [ -r "$file" ]; then
            layout=$(field XKBLAYOUT "$file")
            variant=$(field XKBVARIANT "$file")
            model=$(field XKBMODEL "$file")
            options=$(field XKBOPTIONS "$file")
        fi
    done
    [ -n "$layout" ] && export XKB_DEFAULT_LAYOUT="$layout"
    [ -n "$variant" ] && export XKB_DEFAULT_VARIANT="$variant"
    [ -n "$model" ] && export XKB_DEFAULT_MODEL="$model"
    [ -n "$options" ] && export XKB_DEFAULT_OPTIONS="$options"
fi
echo "mlx-session: keyboard ${XKB_DEFAULT_LAYOUT:-us}${XKB_DEFAULT_VARIANT:+ ($XKB_DEFAULT_VARIANT)}"

backend=${MLX_SESSION_BACKEND:-drm}
host=${MLX_SESSION_HOST:-none}
echo "mlx-session: host $host"

# Runs the compositor freestanding with the given arguments and reports how
# it ended; returns its status (128 + the signal when a signal killed it).
run_compositor() {
    started=$(date +%s)
    echo "mlx-session: starting: mlx-compositor --backend drm --verbose $*"
    "$bindir/mlx-compositor" --backend drm --verbose "$@"
    status=$?
    seconds=$(( $(date +%s) - started ))
    if [ "$status" -gt 128 ]; then
        echo "mlx-session: mlx-compositor was killed by signal $((status - 128)) after $seconds s"
    else
        echo "mlx-session: mlx-compositor exited with status $status after $seconds s"
    fi
    return "$status"
}

if [ "$host" = none ]; then
    # shellcheck disable=SC2086
    # A compositor that crashed early, or gave up early while composing with
    # Vulkan, gets a second chance on the CPU renderer.
    if ! run_compositor ${MLX_COMPOSITOR_ARGS:-} && [ "$seconds" -lt 20 ] && { [ "$status" -gt 128 ] || grep -q "^renderer: vulkan" "$log_file"; }; then
        echo "mlx-session: it died within 20 seconds; trying once more on the CPU renderer"
        # shellcheck disable=SC2086
        run_compositor ${MLX_COMPOSITOR_ARGS:-} --renderer cpu
    fi
    echo "mlx-session: ended $(date)"
    exit "$status"
fi
echo "mlx-session: host backend $backend"

export MLX_SESSION_INSIDE=1
case $host in
cage)
    if [ "$backend" != drm ]; then
        export WLR_BACKENDS="$backend" WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1
    fi
    # -s: switching to other VTs stays possible.
    exec cage -s -- "$self"
    ;;
weston)
    config="${XDG_RUNTIME_DIR:-/tmp}/mlx-session-weston.ini"
    {
        echo "[core]"
        echo "shell=kiosk-shell.so"
        echo "idle-time=0"
        echo "[keyboard]"
        [ -n "${XKB_DEFAULT_LAYOUT:-}" ] && echo "keymap_layout=$XKB_DEFAULT_LAYOUT"
        [ -n "${XKB_DEFAULT_VARIANT:-}" ] && echo "keymap_variant=$XKB_DEFAULT_VARIANT"
        [ -n "${XKB_DEFAULT_MODEL:-}" ] && echo "keymap_model=$XKB_DEFAULT_MODEL"
        [ -n "${XKB_DEFAULT_OPTIONS:-}" ] && echo "keymap_options=$XKB_DEFAULT_OPTIONS"
        echo "[autolaunch]"
        echo "path=$self"
        # Weston quits with the compositor, ending the session.
        echo "watch=true"
    } > "$config"
    exec weston --backend="$backend-backend.so" --config="$config"
    ;;
*)
    echo "mlx-session: unknown host '$host' (none, cage or weston)"
    exit 1
    ;;
esac
