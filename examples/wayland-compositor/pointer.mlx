// Relative pointer motion (zwp_relative_pointer_manager_v1) and pointer
// constraints (zwp_pointer_constraints_v1): what games and 3D programs need
// to turn the camera with the mouse. SDL3 (Minecraft) refuses its relative
// mouse mode without both.
//
// Relative motion goes to the relative pointers of the client whose surface
// has the pointer: the mouse's own movement (unaccelerated) and the
// accelerated one, also where the pointer cannot move (the output's edge,
// a lock). Nested, the host's pointer movement stands in for it.
//
// A constraint is active while its surface's window has both the pointer
// and the keyboard: Super (the launcher) or a click on another window
// always frees the pointer. Locked, the pointer stays put and clients get
// no wl_pointer.motion; when the lock ends the pointer goes to the cursor
// position hint, if any. Confined, the pointer stays within the surface's
// buffer and the bounds of the region, if one is set. Regions and hints
// apply at once rather than on the next commit.
//
// Keyboard shortcut inhibitors (zwp_keyboard_shortcuts_inhibit_manager_v1)
// are here too: one is active while its surface's window has the keyboard,
// and then the compositor's hotkeys and Super go to the window (mlx-settings
// records a hotkey that way; virtual machines and remote desktops want it).
// Alt+Shift+Q and, freestanding, Ctrl+Alt+F1..F12 stay the compositor's.
const std = @import("std")
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")

const Compositor = state.Compositor
const Constraint = state.Constraint
const RelativePointer = state.RelativePointer
const Inhibitor = state.Inhibitor

fn constraintAt(address: usize) -> *Constraint {
    unsafe { return @ptrFromInt(*Constraint, address) }
}

fn relativeAt(address: usize) -> *RelativePointer {
    unsafe { return @ptrFromInt(*RelativePointer, address) }
}

fn sameObject(first: wl.server.Object, second: wl.server.Object) -> bool {
    return first.id == second.id && state.sameClient(first, second)
}

fn findSurface(compositor: *Compositor, object: wl.server.Object) -> usize {
    var index: usize = 0
    while index < compositor.*.surfaces.length {
        const address = state.listAt(compositor.*.surfaces, index)
        if sameObject(state.surfaceAt(address).*.resource, object) { return address }
        index += 1
    }
    return 0
}

// A wl_region's operations into the constraint (none for a null region).
fn setRegion(constraint: *Constraint, region: wl.wl_region.Resource) -> void {
    constraint.*.hasRegion = false
    constraint.*.regionCount = 0
    if region.isNull() { return }
    const compositor = constraint.*.compositor
    var index: usize = 0
    while index < compositor.*.regions.length {
        const address = state.listAt(compositor.*.regions, index)
        var found: *state.Region = undefined
        unsafe { found = @ptrFromInt(*state.Region, address) }
        if sameObject(found.*.resource, region.object) {
            var target: [*]state.RegionOp = undefined
            var source: [*]const state.RegionOp = undefined
            unsafe {
                target = @ptrCast([*]state.RegionOp, &constraint.*.regionOps)
                source = @ptrCast([*]const state.RegionOp, &found.*.ops)
            }
            state.copyRegionOps(target, source, found.*.count)
            constraint.*.regionCount = found.*.count
            constraint.*.hasRegion = true
            return
        }
        index += 1
    }
}

fn regionContains(constraint: *const Constraint, x: i32, y: i32) -> bool {
    if !constraint.*.hasRegion { return true }
    var ops: [*]const state.RegionOp = undefined
    unsafe { ops = @ptrCast([*]const state.RegionOp, &constraint.*.regionOps) }
    return state.regionContains(ops, constraint.*.regionCount, x, y)
}

// ---------------------------------------------------------------------------
// Relative pointers

fn onRelativeManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    if request.opcode != wl.zwp_relative_pointer_manager_v1.REQUEST_GET_RELATIVE_POINTER { return }
    const decoded = wl.zwp_relative_pointer_manager_v1.decodeRequest(request)
    const memory = state.allocate(compositor, @sizeOf(RelativePointer))
    var relative: *RelativePointer = undefined
    unsafe { relative = @ptrCast(*RelativePointer, memory) }
    relative.*.compositor = compositor
    relative.*.object = decoded.get_relative_pointer.id.object
    compositor.*.relativePointers = state.listAppend(compositor.*.relativePointers, @intFromPtr(memory))
    decoded.get_relative_pointer.id.setDestroyHandler(onRelativeDestroyed, state.contextOf(memory))
}

fn onRelativeDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    var relative: *RelativePointer = undefined
    unsafe { relative = @ptrCast(*RelativePointer, context) }
    const compositor = relative.*.compositor
    compositor.*.relativePointers = state.listRemove(compositor.*.relativePointers, @intFromPtr(relative))
    unsafe { state.release(compositor, @ptrCast([*]u8, relative), @sizeOf(RelativePointer)) }
}

fn bindRelativeManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.zwp_relative_pointer_manager_v1.Resource.fromObject(object).setHandler(onRelativeManager, context)
}

fn fixed(value: i32) -> wl.Fixed { return wl.Fixed.fromInt(value) }

// The pointer moved by (dx, dy) pixels, (raw_dx, raw_dy) before
// acceleration: to the relative pointers of the client under the pointer.
// While a lock holds the pointer no wl_pointer.motion follows, so the frame
// is closed here.
pub fn relativeMotion(compositor: *Compositor, dx: i32, dy: i32, raw_dx: i32, raw_dy: i32) -> void {
    if compositor.*.pointerFocus == 0 { return }
    if dx == 0 && dy == 0 && raw_dx == 0 && raw_dy == 0 { return }
    const surface = state.surfaceAt(compositor.*.pointerFocus)
    const now = state.microseconds()
    const high = @intCast(u32, (now >> 32) & 4294967295)
    const low = @intCast(u32, now & 4294967295)
    var sent = false
    var index: usize = 0
    while index < compositor.*.relativePointers.length {
        const relative = relativeAt(state.listAt(compositor.*.relativePointers, index))
        if state.sameClient(relative.*.object, surface.*.resource) {
            wl.zwp_relative_pointer_v1.Resource.fromObject(relative.*.object).sendRelativeMotion(high, low, fixed(dx), fixed(dy), fixed(raw_dx), fixed(raw_dy))
            sent = true
        }
        index += 1
    }
    if !sent || !isLocked(compositor) { return }
    index = 0
    while index < compositor.*.pointers.length {
        var pointer: *state.SeatResource = undefined
        unsafe { pointer = @ptrFromInt(*state.SeatResource, state.listAt(compositor.*.pointers, index)) }
        if state.sameClient(pointer.*.object, surface.*.resource) { wl.wl_pointer.Resource.fromObject(pointer.*.object).sendFrame() }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Constraints

fn onConstraints(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    const decoded = wl.zwp_pointer_constraints_v1.decodeRequest(request)
    var lock = false
    var created: wl.server.Object = undefined
    var surface_object: wl.server.Object = undefined
    var region: wl.wl_region.Resource = undefined
    var lifetime: u32 = 0
    if request.opcode == wl.zwp_pointer_constraints_v1.REQUEST_LOCK_POINTER {
        lock = true
        created = decoded.lock_pointer.id.object
        surface_object = decoded.lock_pointer.surface.object
        region = decoded.lock_pointer.region
        lifetime = decoded.lock_pointer.lifetime
    } else if request.opcode == wl.zwp_pointer_constraints_v1.REQUEST_CONFINE_POINTER {
        created = decoded.confine_pointer.id.object
        surface_object = decoded.confine_pointer.surface.object
        region = decoded.confine_pointer.region
        lifetime = decoded.confine_pointer.lifetime
    } else {
        return
    }
    const address = findSurface(compositor, surface_object)
    if address == 0 { return }
    var index: usize = 0
    while index < compositor.*.constraints.length {
        if constraintAt(state.listAt(compositor.*.constraints, index)).*.surface == address {
            wl.zwp_pointer_constraints_v1.Resource.fromObject(request.object).postError(@intFromEnum(wl.zwp_pointer_constraints_v1.Error.already_constrained), "the surface has a pointer constraint already")
            return
        }
        index += 1
    }
    const memory = state.allocate(compositor, @sizeOf(Constraint))
    var constraint: *Constraint = undefined
    unsafe { constraint = @ptrCast(*Constraint, memory) }
    constraint.*.compositor = compositor
    constraint.*.object = created
    constraint.*.surface = address
    constraint.*.lock = lock
    constraint.*.persistent = lifetime == @intFromEnum(wl.zwp_pointer_constraints_v1.Lifetime.persistent)
    constraint.*.active = false
    constraint.*.defunct = false
    constraint.*.hasHint = false
    constraint.*.hintX = 0
    constraint.*.hintY = 0
    setRegion(constraint, region)
    compositor.*.constraints = state.listAppend(compositor.*.constraints, @intFromPtr(memory))
    if lock {
        wl.server.setHandler(created, onLocked, state.contextOf(memory))
    } else {
        wl.server.setHandler(created, onConfined, state.contextOf(memory))
    }
    wl.server.setDestroyHandler(created, onConstraintDestroyed, state.contextOf(memory))
    if compositor.*.verbose {
        state.say(if lock { "pointer: a lock for " } else { "pointer: a confinement for " })
        state.sayTitle(state.surfaceAt(scene.toplevelOf(address)))
        state.say(if constraint.*.persistent { " (persistent)\n" } else { " (oneshot)\n" })
    }
    update(compositor)
}

fn onLocked(context: *anyopaque, request: wl.server.Request) -> void {
    var constraint: *Constraint = undefined
    unsafe { constraint = @ptrCast(*Constraint, context) }
    const decoded = wl.zwp_locked_pointer_v1.decodeRequest(request)
    if request.opcode == wl.zwp_locked_pointer_v1.REQUEST_SET_CURSOR_POSITION_HINT {
        constraint.*.hasHint = true
        constraint.*.hintX = decoded.set_cursor_position_hint.surface_x.toInt()
        constraint.*.hintY = decoded.set_cursor_position_hint.surface_y.toInt()
    } else if request.opcode == wl.zwp_locked_pointer_v1.REQUEST_SET_REGION {
        setRegion(constraint, decoded.set_region.region)
    }
}

fn onConfined(context: *anyopaque, request: wl.server.Request) -> void {
    var constraint: *Constraint = undefined
    unsafe { constraint = @ptrCast(*Constraint, context) }
    const decoded = wl.zwp_confined_pointer_v1.decodeRequest(request)
    if request.opcode == wl.zwp_confined_pointer_v1.REQUEST_SET_REGION {
        setRegion(constraint, decoded.set_region.region)
        clampPointer(constraint.*.compositor)
    }
}

fn onConstraintDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    var constraint: *Constraint = undefined
    unsafe { constraint = @ptrCast(*Constraint, context) }
    const compositor = constraint.*.compositor
    if constraint.*.active { released(constraint) }
    compositor.*.constraints = state.listRemove(compositor.*.constraints, @intFromPtr(constraint))
    unsafe { state.release(compositor, @ptrCast([*]u8, constraint), @sizeOf(Constraint)) }
    update(compositor)
}

fn bindConstraints(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.zwp_pointer_constraints_v1.Resource.fromObject(object).setHandler(onConstraints, context)
}

// A lock ended: the pointer goes where the client hinted.
fn released(constraint: *Constraint) -> void {
    constraint.*.active = false
    const compositor = constraint.*.compositor
    if !constraint.*.lock || !constraint.*.hasHint || constraint.*.surface == 0 { return }
    const surface = state.surfaceAt(constraint.*.surface)
    if compositor.*.pointerInside { scene.damageCursor(compositor) }
    compositor.*.pointerX = scene.originX(surface) + constraint.*.hintX
    compositor.*.pointerY = scene.originY(surface) + constraint.*.hintY
    scene.damageCursor(compositor)
}

// Whether the constraint should hold now: its surface's window has the
// pointer and the keyboard (and, to start, the pointer is in the region).
fn wanted(compositor: *Compositor, constraint: *const Constraint) -> bool {
    if constraint.*.defunct || constraint.*.surface == 0 || compositor.*.pointerFocus == 0 || !compositor.*.pointerInside { return false }
    const toplevel = scene.toplevelOf(constraint.*.surface)
    if toplevel == 0 || scene.toplevelOf(compositor.*.pointerFocus) != toplevel || compositor.*.keyboardFocus != toplevel { return false }
    if constraint.*.active { return true }
    const surface = state.surfaceAt(constraint.*.surface)
    return regionContains(constraint, compositor.*.pointerX - scene.originX(surface), compositor.*.pointerY - scene.originY(surface))
}

// Activates and deactivates constraints after the pointer or keyboard
// focus changed (and after one came or went).
pub fn update(compositor: *Compositor) -> void {
    updateInhibitors(compositor)
    var index: usize = 0
    while index < compositor.*.constraints.length {
        const constraint = constraintAt(state.listAt(compositor.*.constraints, index))
        const should = wanted(compositor, constraint)
        if should && !constraint.*.active {
            constraint.*.active = true
            if constraint.*.lock { wl.zwp_locked_pointer_v1.Resource.fromObject(constraint.*.object).sendLocked() } else { wl.zwp_confined_pointer_v1.Resource.fromObject(constraint.*.object).sendConfined() }
            if compositor.*.verbose { state.say(if constraint.*.lock { "pointer: locked\n" } else { "pointer: confined\n" }) }
        } else if !should && constraint.*.active {
            released(constraint)
            if constraint.*.lock { wl.zwp_locked_pointer_v1.Resource.fromObject(constraint.*.object).sendUnlocked() } else { wl.zwp_confined_pointer_v1.Resource.fromObject(constraint.*.object).sendUnconfined() }
            if !constraint.*.persistent { constraint.*.defunct = true }
            if compositor.*.verbose { state.say(if constraint.*.lock { "pointer: unlocked\n" } else { "pointer: unconfined\n" }) }
        }
        index += 1
    }
}

// A surface is going away: its constraints hold no more (their objects
// stay until the client destroys them).
pub fn surfaceGone(compositor: *Compositor, address: usize) -> void {
    var index: usize = 0
    while index < compositor.*.inhibitors.length {
        const inhibitor = inhibitorAt(state.listAt(compositor.*.inhibitors, index))
        if inhibitor.*.surface == address {
            inhibitor.*.surface = 0
            inhibitor.*.active = false
        }
        index += 1
    }
    index = 0
    while index < compositor.*.constraints.length {
        const constraint = constraintAt(state.listAt(compositor.*.constraints, index))
        if constraint.*.surface == address {
            constraint.*.active = false
            constraint.*.surface = 0
            constraint.*.defunct = true
        }
        index += 1
    }
}

fn activeConstraint(compositor: *Compositor) -> usize {
    var index: usize = 0
    while index < compositor.*.constraints.length {
        const address = state.listAt(compositor.*.constraints, index)
        if constraintAt(address).*.active { return address }
        index += 1
    }
    return 0
}

// A lock holds the pointer where it is.
pub fn isLocked(compositor: *Compositor) -> bool {
    const address = activeConstraint(compositor)
    return address != 0 && constraintAt(address).*.lock
}

fn clampTo(value: i32, low: i32, high: i32) -> i32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

// Where the pointer may go while confined: (x, y) moved into the surface's
// buffer and the region's bounds.
pub fn confine(compositor: *Compositor, x: *i32, y: *i32) -> void {
    const address = activeConstraint(compositor)
    if address == 0 { return }
    const constraint = constraintAt(address)
    if constraint.*.lock || constraint.*.surface == 0 { return }
    const surface = state.surfaceAt(constraint.*.surface)
    var left: i32 = 0
    var top: i32 = 0
    var right = @intCast(i32, surface.*.pixelWidth) - 1
    var bottom = @intCast(i32, surface.*.pixelHeight) - 1
    if constraint.*.hasRegion && constraint.*.regionCount > 0 {
        // The bounds of what the region adds.
        var first = true
        var index: usize = 0
        while index < constraint.*.regionCount {
            const op = constraint.*.regionOps[index]
            if !op.subtract && op.width > 0 && op.height > 0 {
                if first {
                    left = op.x
                    top = op.y
                    right = op.x + op.width - 1
                    bottom = op.y + op.height - 1
                    first = false
                } else {
                    if op.x < left { left = op.x }
                    if op.y < top { top = op.y }
                    if op.x + op.width - 1 > right { right = op.x + op.width - 1 }
                    if op.y + op.height - 1 > bottom { bottom = op.y + op.height - 1 }
                }
            }
            index += 1
        }
        if left < 0 { left = 0 }
        if top < 0 { top = 0 }
        if right > @intCast(i32, surface.*.pixelWidth) - 1 { right = @intCast(i32, surface.*.pixelWidth) - 1 }
        if bottom > @intCast(i32, surface.*.pixelHeight) - 1 { bottom = @intCast(i32, surface.*.pixelHeight) - 1 }
    }
    if right < left || bottom < top { return }
    const origin_x = scene.originX(surface)
    const origin_y = scene.originY(surface)
    x.* = clampTo(x.*, origin_x + left, origin_x + right)
    y.* = clampTo(y.*, origin_y + top, origin_y + bottom)
}

// The confinement changed: the pointer moves back inside.
fn clampPointer(compositor: *Compositor) -> void {
    var x = compositor.*.pointerX
    var y = compositor.*.pointerY
    confine(compositor, &x, &y)
    if x == compositor.*.pointerX && y == compositor.*.pointerY { return }
    scene.damageCursor(compositor)
    compositor.*.pointerX = x
    compositor.*.pointerY = y
    scene.damageCursor(compositor)
}

// ---------------------------------------------------------------------------
// Keyboard shortcut inhibitors

fn inhibitorAt(address: usize) -> *Inhibitor {
    unsafe { return @ptrFromInt(*Inhibitor, address) }
}

fn onInhibitManager(context: *anyopaque, request: wl.server.Request) -> void {
    const compositor = state.compositorOf(context)
    if request.opcode != wl.zwp_keyboard_shortcuts_inhibit_manager_v1.REQUEST_INHIBIT_SHORTCUTS { return }
    const decoded = wl.zwp_keyboard_shortcuts_inhibit_manager_v1.decodeRequest(request)
    const address = findSurface(compositor, decoded.inhibit_shortcuts.surface.object)
    if address == 0 { return }
    var index: usize = 0
    while index < compositor.*.inhibitors.length {
        if inhibitorAt(state.listAt(compositor.*.inhibitors, index)).*.surface == address {
            wl.zwp_keyboard_shortcuts_inhibit_manager_v1.Resource.fromObject(request.object).postError(@intFromEnum(wl.zwp_keyboard_shortcuts_inhibit_manager_v1.Error.already_inhibited), "the surface inhibits shortcuts already")
            return
        }
        index += 1
    }
    const memory = state.allocate(compositor, @sizeOf(Inhibitor))
    const inhibitor = inhibitorAt(@intFromPtr(memory))
    inhibitor.*.compositor = compositor
    inhibitor.*.object = decoded.inhibit_shortcuts.id.object
    inhibitor.*.surface = address
    inhibitor.*.active = false
    compositor.*.inhibitors = state.listAppend(compositor.*.inhibitors, @intFromPtr(memory))
    decoded.inhibit_shortcuts.id.setHandler(onInhibitor, state.contextOf(memory))
    decoded.inhibit_shortcuts.id.setDestroyHandler(onInhibitorDestroyed, state.contextOf(memory))
    update(compositor)
}

fn onInhibitor(context: *anyopaque, request: wl.server.Request) -> void {}

fn onInhibitorDestroyed(context: *anyopaque, object: wl.server.Object) -> void {
    const inhibitor = inhibitorAt(@intFromPtr(context))
    const compositor = inhibitor.*.compositor
    if inhibitor.*.active && compositor.*.verbose { state.say("shortcuts: back to the compositor\n") }
    compositor.*.inhibitors = state.listRemove(compositor.*.inhibitors, @intFromPtr(context))
    unsafe { state.release(compositor, @ptrCast([*]u8, context), @sizeOf(Inhibitor)) }
}

fn bindInhibitManager(context: *anyopaque, client: wl.server.Client, object: wl.server.Object, version: u32) -> void {
    wl.zwp_keyboard_shortcuts_inhibit_manager_v1.Resource.fromObject(object).setHandler(onInhibitManager, context)
}

// Activates the inhibitor of the window with the keyboard, deactivates
// the others.
fn updateInhibitors(compositor: *Compositor) -> void {
    var index: usize = 0
    while index < compositor.*.inhibitors.length {
        const inhibitor = inhibitorAt(state.listAt(compositor.*.inhibitors, index))
        const should = inhibitor.*.surface != 0 && compositor.*.keyboardFocus != 0 && scene.toplevelOf(inhibitor.*.surface) == compositor.*.keyboardFocus
        if should != inhibitor.*.active {
            inhibitor.*.active = should
            const resource = wl.zwp_keyboard_shortcuts_inhibitor_v1.Resource.fromObject(inhibitor.*.object)
            if should { resource.sendActive() } else { resource.sendInactive() }
            if compositor.*.verbose { state.say(if should { "shortcuts: inhibited\n" } else { "shortcuts: back to the compositor\n" }) }
        }
        index += 1
    }
}

// Whether the keys go to the focused window, not to the hotkeys.
pub fn shortcutsInhibited(compositor: *Compositor) -> bool {
    var index: usize = 0
    while index < compositor.*.inhibitors.length {
        if inhibitorAt(state.listAt(compositor.*.inhibitors, index)).*.active { return true }
        index += 1
    }
    return false
}

pub fn createGlobals(compositor: *Compositor) -> bool {
    var memory: [*]u8 = undefined
    unsafe { memory = @ptrCast([*]u8, compositor) }
    const context = state.contextOf(memory)
    if compositor.*.server.createGlobal(wl.Interface.zwp_relative_pointer_manager_v1, 1, bindRelativeManager, context) == 0 { return false }
    if compositor.*.server.createGlobal(wl.Interface.zwp_keyboard_shortcuts_inhibit_manager_v1, 1, bindInhibitManager, context) == 0 { return false }
    return compositor.*.server.createGlobal(wl.Interface.zwp_pointer_constraints_v1, 1, bindConstraints, context) != 0
}

// ---------------------------------------------------------------------------
// The handlers this file registers with the Wayland server, by name: when
// the shell is loaded again (modules.mlx), each resource's handler is
// replaced by the new code's function of the same name. Every function
// passed to setHandler, setDestroyHandler, createGlobal or a client
// handler here must be listed (tools/check_compositor_modules.py checks;
// --fix rewrites this table).

pub const HANDLER_COUNT: usize = 12

pub fn handlerAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(bindConstraints) }
    if index == 1 { return @intFromPtr(bindInhibitManager) }
    if index == 2 { return @intFromPtr(bindRelativeManager) }
    if index == 3 { return @intFromPtr(onConfined) }
    if index == 4 { return @intFromPtr(onConstraintDestroyed) }
    if index == 5 { return @intFromPtr(onConstraints) }
    if index == 6 { return @intFromPtr(onInhibitManager) }
    if index == 7 { return @intFromPtr(onInhibitor) }
    if index == 8 { return @intFromPtr(onInhibitorDestroyed) }
    if index == 9 { return @intFromPtr(onLocked) }
    if index == 10 { return @intFromPtr(onRelativeDestroyed) }
    if index == 11 { return @intFromPtr(onRelativeManager) }
    return 0
}

pub fn handlerName(index: usize) -> []const u8 {
    if index == 0 { return "pointer.bindConstraints" }
    if index == 1 { return "pointer.bindInhibitManager" }
    if index == 2 { return "pointer.bindRelativeManager" }
    if index == 3 { return "pointer.onConfined" }
    if index == 4 { return "pointer.onConstraintDestroyed" }
    if index == 5 { return "pointer.onConstraints" }
    if index == 6 { return "pointer.onInhibitManager" }
    if index == 7 { return "pointer.onInhibitor" }
    if index == 8 { return "pointer.onInhibitorDestroyed" }
    if index == 9 { return "pointer.onLocked" }
    if index == 10 { return "pointer.onRelativeDestroyed" }
    if index == 11 { return "pointer.onRelativeManager" }
    return ""
}
