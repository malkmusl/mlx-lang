// The renderer's side of the module boundary (entries.mlx): its entries and
// the layout of the records it keeps across a reload. The program compiles
// this in as its built-in renderer; the render module (render_module.mlx,
// libmlx-render.so) answers queries from it. The renderer registers no
// Wayland handlers.
const state = @import("./state.mlx")
const scene = @import("./scene.mlx")
const vulkan = @import("./vulkan.mlx")
const entries = @import("./entries.mlx")
const kms = @import("./kms.mlx")
const gpu = @import("../vulkan-shared/gpu.mlx")
const shaders = @import("../vulkan-shared/shaders.mlx")
const text = @import("../vulkan-shared/text.mlx")

pub fn entry(index: usize) -> usize {
    if index == entries.RENDER_OPEN { return @intFromPtr(vulkan.open) }
    if index == entries.RENDER_COMPOSE { return @intFromPtr(vulkan.compose) }
    if index == entries.RENDER_COPY_INSTEAD { return @intFromPtr(vulkan.copyInstead) }
    if index == entries.RENDER_VERIFY_OUTPUT { return @intFromPtr(vulkan.verifyOutput) }
    if index == entries.RENDER_RELEASE_POOL { return @intFromPtr(vulkan.releasePool) }
    if index == entries.RENDER_RELEASE_SURFACE { return @intFromPtr(vulkan.releaseSurface) }
    if index == entries.RENDER_COMPOSE_CPU { return @intFromPtr(scene.compose) }
    if index == entries.RENDER_RELOADED { return @intFromPtr(vulkan.reloaded) }
    return 0
}

pub fn handlerCount() -> usize { return 0 }
pub fn handlerAddress(index: usize) -> usize { return 0 }
pub fn handlerName(index: usize) -> []const u8 { return "" }

pub fn layout() -> usize {
    var value = state.layout()
    value = value *% 31 +% @sizeOf(vulkan.Renderer)
    value = value *% 31 +% @sizeOf(gpu.Context)
    value = value *% 31 +% @sizeOf(gpu.Buffer)
    value = value *% 31 +% @sizeOf(gpu.Kernel)
    value = value *% 31 +% @sizeOf(shaders.Blit)
    value = value *% 31 +% @sizeOf(shaders.Warp)
    value = value *% 31 +% @sizeOf(shaders.Text)
    value = value *% 31 +% @sizeOf(text.Text)
    value = value *% 31 +% @sizeOf(kms.Output)
    return value
}
