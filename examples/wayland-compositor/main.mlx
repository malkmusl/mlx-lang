// A nested Wayland compositor written with std.wayland.
//
// It runs as a window inside your session compositor (any Wayland desktop,
// or weston on X11) and is a compositor in its own right: Wayland clients
// connect to its socket and appear as windows inside it. It receives the
// session's keyboard and pointer input and routes it to its clients:
//
//   - pointer motion, buttons and scrolling go to the window under the
//     pointer, and a click focuses and raises it;
//   - keys and modifiers go to the focused window (the host's xkb keymap is
//     handed to clients);
//   - windows move by dragging their title bar (xdg_toplevel.move) or with
//     Alt+drag anywhere;
//   - Alt+Enter opens a terminal, Alt+Tab switches windows, Alt+F4 closes
//     the focused window and Alt+Shift+Q quits.
//
// Supported protocol: wl_compositor, wl_shm (ARGB8888/XRGB8888),
// zwp_linux_dmabuf_v1 (ARGB8888/XRGB8888, linear), wl_output, wl_seat
// (pointer and keyboard) and xdg_wm_base (toplevels and popups).
//
// Windows are composed on the CPU, or with --renderer vulkan by a Vulkan
// compute shader that reads client buffers (wl_shm pools and dma-bufs) in
// place and writes the output straight into the host window's buffer.
//
//     mlx4 examples/wayland-compositor/main.mlx -o mlx-compositor
//     mlx4 examples/wayland-terminal/main.mlx -o mlx-terminal
//     ./mlx-compositor --run ./mlx-terminal
//
// Options:
//     --socket NAME       listen on $XDG_RUNTIME_DIR/NAME (default wayland-mlx)
//     --size WxH          output size (default 1024x768)
//     --renderer NAME     cpu (default) or vulkan
//     --font PATH         TrueType font for window titles (default DejaVu
//                         Sans; `none` for bars without titles)
//     --terminal PROGRAM  what Alt+Enter runs (default: mlx-terminal next to
//                         this program, else mlx-terminal from PATH)
//     --run PROGRAM       start PROGRAM once the compositor is up (repeatable)
//     --screenshot FILE   write the last frame to FILE (PPM) on exit
//     --timeout SECONDS   exit after SECONDS (for demos and tests)
//     --verbose           log clients, windows, focus and forwarded keys

const std = @import("std")
const wl = @import("std.wayland")
const state = @import("./state.mlx")
const shell = @import("./shell.mlx")
const host = @import("./host.mlx")
const dmabuf = @import("./dmabuf.mlx")
const vulkan = @import("./vulkan.mlx")
const tt = @import("std.truetype")
const scene = @import("./scene.mlx")

const DEFAULT_FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"

const Compositor = state.Compositor
const String = std.string.String

fn equals(value: String, text: []const u8) -> bool {
    return std.string.eql(value, std.string.fromSlice(text))
}

fn parseNumber(text: String, start: usize, end: usize) -> usize {
    var value: usize = 0
    var index = start
    while index < end {
        const byte = text.pointer[index]
        if byte < 48 || byte > 57 { return 0 }
        value = value * 10 + @intCast(usize, byte - 48)
        index += 1
    }
    return value
}

// "mlx-terminal" next to this program when it was started by path.
fn defaultTerminal(compositor: *Compositor, program: String) -> [*]const u8 {
    var slash: usize = 0
    var found = false
    var index: usize = 0
    while index < program.length {
        if program.pointer[index] == 47 {
            slash = index
            found = true
        }
        index += 1
    }
    const name = "mlx-terminal"
    if !found {
        unsafe { return @ptrCast([*]const u8, name) }
    }
    const memory = state.allocate(compositor, slash + 16)
    index = 0
    while index <= slash {
        memory[index] = program.pointer[index]
        index += 1
    }
    var length = slash + 1
    for byte in name {
        memory[length] = byte
        length += 1
    }
    memory[length] = 0
    unsafe { return @ptrCast([*]const u8, memory) }
}

// Our environment for children, with WAYLAND_DISPLAY naming our socket.
fn childEnvironment(compositor: *Compositor, arguments: [][*]const u8) -> [*][*]const u8 {
    const count = std.process.environmentCount(arguments)
    const entries = std.process.environmentEntries(arguments)
    var result: [*][*]const u8 = undefined
    unsafe { result = @ptrCast([*][*]const u8, state.allocate(compositor, (count + 2) * 8)) }
    var used: usize = 0
    var index: usize = 0
    while index < count {
        const entry = std.process.fromCString(entries[index])
        if !std.string.startsWith(entry, std.string.fromSlice("WAYLAND_DISPLAY=")) && !std.string.startsWith(entry, std.string.fromSlice("WAYLAND_SOCKET=")) {
            result[used] = entries[index]
            used += 1
        }
        index += 1
    }
    const variable = state.allocate(compositor, 17 + compositor.*.socketNameLength)
    var length: usize = 0
    for byte in "WAYLAND_DISPLAY=" {
        variable[length] = byte
        length += 1
    }
    index = 0
    while index < compositor.*.socketNameLength {
        variable[length] = compositor.*.socketName[index]
        length += 1
        index += 1
    }
    variable[length] = 0
    unsafe {
        result[used] = @ptrCast([*]const u8, variable)
        result[used + 1] = @ptrFromInt([*]const u8, 0)
    }
    return result
}

// Monotonic time in milliseconds.
fn milliseconds() -> usize {
    var time: [16]u8 = undefined
    const result = std.linux.syscall2(228, 1, @intFromPtr(&time))
    var seconds: usize = 0
    var nanoseconds: usize = 0
    var index: usize = 0
    while index < 8 {
        seconds = seconds | (@intCast(usize, time[index]) << (index * 8))
        nanoseconds = nanoseconds | (@intCast(usize, time[8 + index]) << (index * 8))
        index += 1
    }
    return seconds * 1000 + nanoseconds / 1000000
}

fn initialize(compositor: *Compositor) -> void {
    compositor.*.allocator = std.page_allocator.init()
    compositor.*.width = 1024
    compositor.*.height = 768
    compositor.*.running = true
    compositor.*.verbose = false
    compositor.*.socketNameLength = 0
    compositor.*.hasHostCompositor = false
    compositor.*.hasHostShm = false
    compositor.*.hasHostWmBase = false
    compositor.*.hasHostSeat = false
    compositor.*.hasHostPointer = false
    compositor.*.hasHostKeyboard = false
    compositor.*.hostFirstBusy = false
    compositor.*.hostSecondBusy = false
    compositor.*.hostConfigured = false
    compositor.*.hostFramePending = false
    compositor.*.needsRedraw = true
    compositor.*.frames = 0
    compositor.*.hasKeymap = false
    compositor.*.repeatRate = 25
    compositor.*.repeatDelay = 600
    compositor.*.modsDepressed = 0
    compositor.*.modsLatched = 0
    compositor.*.modsLocked = 0
    compositor.*.modsGroup = 0
    const allocator = compositor.*.allocator
    compositor.*.surfaces = state.newList(allocator)
    compositor.*.stack = state.newList(allocator)
    compositor.*.buffers = state.newList(allocator)
    compositor.*.positioners = state.newList(allocator)
    compositor.*.pointers = state.newList(allocator)
    compositor.*.keyboards = state.newList(allocator)
    compositor.*.nextWindowX = 24
    compositor.*.nextWindowY = 24
    compositor.*.pointerX = 0
    compositor.*.pointerY = 0
    compositor.*.pointerInside = false
    compositor.*.pointerFocus = 0
    compositor.*.keyboardFocus = 0
    compositor.*.buttonsDown = 0
    compositor.*.moving = 0
    compositor.*.moveOffsetX = 0
    compositor.*.moveOffsetY = 0
    compositor.*.cursorSurface = 0
    compositor.*.cursorHidden = false
    compositor.*.alt = false
    compositor.*.shift = false
    compositor.*.control = false
    compositor.*.swallowedKey = 0
    compositor.*.swallowedButton = false
    compositor.*.time = 0
    compositor.*.renderer = 0
    compositor.*.hasText = false
}

// Window titles: the font, its atlas and a run for laying titles out.
fn loadFont(compositor: *Compositor, path: [*]const u8) -> void {
    if path[0] == 0 { return }
    const allocator = compositor.*.allocator
    unsafe {
        compositor.*.font = @ptrCast(*tt.Font, state.allocate(compositor, @sizeOf(tt.Font)))
        compositor.*.atlas = @ptrCast(*tt.Atlas, state.allocate(compositor, @sizeOf(tt.Atlas)))
        compositor.*.run = @ptrCast(*tt.Run, state.allocate(compositor, @sizeOf(tt.Run)))
    }
    const status = tt.loadFile(compositor.*.font, path, allocator)
    if status != tt.Status.ok {
        if compositor.*.verbose {
            state.say("titles: ")
            state.say(tt.statusMessage(status))
            state.say("\n")
        }
        return
    }
    if !tt.initAtlas(compositor.*.atlas, compositor.*.font, scene.TITLE_TEXT_SIZE, 512, 256, allocator) { return }
    if !tt.initRun(compositor.*.run, 64, allocator) { return }
    compositor.*.hasText = true
}

const Failure = error { InvalidArguments, GlobalsFailed, NoVulkan }

fn invalidArguments() -> Failure!void { return Failure.InvalidArguments }
fn globalsFailed() -> Failure!void { return Failure.GlobalsFailed }
fn noVulkan() -> Failure!void { return Failure.NoVulkan }

fn run(compositor: *Compositor, arguments: [][*]const u8) -> !void {
    var socket = std.string.fromSlice("wayland-mlx")
    var screenshot = std.string.fromSlice("")
    var launches: [8]usize = [8]usize{ 0, 0, 0, 0, 0, 0, 0, 0 }
    var launch_count: usize = 0
    var terminal_set = false
    var timeout: usize = 0
    var use_vulkan = false
    var font_path: [*]const u8 = undefined
    unsafe { font_path = @ptrCast([*]const u8, DEFAULT_FONT) }
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        const has_value = index + 1 < count
        if equals(argument, "--verbose") {
            compositor.*.verbose = true
        } else if equals(argument, "--socket") && has_value {
            index += 1
            socket = std.process.argument(arguments, index)
        } else if equals(argument, "--renderer") && has_value {
            index += 1
            const name = std.process.argument(arguments, index)
            if equals(name, "vulkan") {
                use_vulkan = true
            } else if !equals(name, "cpu") {
                return invalidArguments()
            }
        } else if equals(argument, "--font") && has_value {
            index += 1
            const path = std.process.argument(arguments, index)
            if equals(path, "none") {
                unsafe { font_path = @ptrCast([*]const u8, "") }
            } else {
                font_path = path.pointer
            }
        } else if equals(argument, "--screenshot") && has_value {
            index += 1
            screenshot = std.process.argument(arguments, index)
        } else if equals(argument, "--terminal") && has_value {
            index += 1
            compositor.*.terminal = std.process.argument(arguments, index).pointer
            terminal_set = true
        } else if equals(argument, "--run") && has_value && launch_count < 8 {
            index += 1
            launches[launch_count] = @intFromPtr(std.process.argument(arguments, index).pointer)
            launch_count += 1
        } else if equals(argument, "--timeout") && has_value {
            index += 1
            const seconds = std.process.argument(arguments, index)
            timeout = parseNumber(seconds, 0, seconds.length) * 1000
        } else if equals(argument, "--size") && has_value {
            index += 1
            const size = std.process.argument(arguments, index)
            var split: usize = 0
            while split < size.length && size.pointer[split] != 120 { split += 1 }
            const width = parseNumber(size, 0, split)
            const height = if split < size.length { parseNumber(size, split + 1, size.length) } else { 0 }
            if width < 64 || height < 64 || width > 8192 || height > 8192 { return invalidArguments() }
            compositor.*.width = width
            compositor.*.height = height
        } else {
            const usage = std.io.eprintln("usage: mlx-compositor [--socket NAME] [--size WxH] [--renderer cpu|vulkan] [--font PATH|none] [--terminal PROGRAM] [--run PROGRAM]... [--screenshot FILE] [--timeout SECONDS] [--verbose]")
            return invalidArguments()
        }
        index += 1
    }
    if socket.length == 0 || socket.length > 60 { return invalidArguments() }
    index = 0
    while index < socket.length {
        compositor.*.socketName[index] = socket.pointer[index]
        index += 1
    }
    compositor.*.socketNameLength = socket.length
    if !terminal_set { compositor.*.terminal = defaultTerminal(compositor, std.process.argument(arguments, 0)) }
    compositor.*.environment = childEnvironment(compositor, arguments)

    var server: wl.server.Display = undefined
    try wl.server.Display.init(&server, compositor.*.allocator)
    compositor.*.server = server
    try server.addSocket(std.string.asSlice(socket))
    if !shell.createGlobals(compositor) || !dmabuf.createGlobal(compositor) { return globalsFailed() }
    try host.connect(compositor)
    loadFont(compositor, font_path)
    if use_vulkan && !vulkan.open(compositor, arguments) { return noVulkan() }
    if compositor.*.verbose {
        state.say("listening on ")
        const shown = std.io.writeString(std.io.stdout(), socket)
        state.say("\n")
    }
    index = 0
    while index < launch_count {
        unsafe { shell.launch(compositor, @ptrFromInt([*]const u8, launches[index])) }
        index += 1
    }

    const display = compositor.*.host
    var handles: [2]wl.Handle = undefined
    handles[0] = wl.Handle.fromDescriptor(display.descriptor())
    handles[1] = wl.Handle.fromDescriptor(server.descriptor())
    var ready: [2]bool = [2]bool{ false, false }
    const deadline = milliseconds() + timeout
    while compositor.*.running && display.running() {
        if timeout > 0 && milliseconds() >= deadline { compositor.*.running = false }
        shell.reapChildren()
        host.present(compositor)
        try display.flush()
        server.flushClients()
        var waited: isize = 0
        unsafe { waited = wl.transport.waitAny(@ptrCast([*]const wl.Handle, &handles), 2, @ptrCast([*]bool, &ready), 1000) }
        if ready[0] { try display.dispatch() }
        if ready[1] { try server.dispatch(0) }
    }
    if screenshot.length > 0 {
        if host.screenshot(compositor, screenshot.pointer) {
            if compositor.*.verbose { state.say("screenshot written\n") }
        }
    }
    server.deinit()
    display.disconnect()
}

pub fn main(arguments: [][*]const u8) -> !void {
    var compositor: Compositor = undefined
    initialize(&compositor)
    try run(&compositor, arguments)
}
