// Shared state of the nested compositor: the compositor record, surfaces,
// buffer memory (wl_shm pools and linux-dmabuf buffers), xdg positioners,
// seat resources, and small pointer-list helpers.
//
// Records are allocated individually so their addresses stay stable; lists
// hold their addresses as usize values.

const std = @import("std")
const wl = @import("std.wayland")
const gpu = @import("../vulkan-shared/gpu.mlx")
const tt = @import("std.truetype")
const ui = @import("std.ui")

pub const Allocator = std.allocator.Allocator
pub const Vector = std.vector.Vector

pub const ROLE_NONE: u8 = 0
pub const ROLE_TOPLEVEL: u8 = 1
pub const ROLE_POPUP: u8 = 2
pub const ROLE_CURSOR: u8 = 3
// A wl_subsurface: drawn with its parent, at an offset from it.
pub const ROLE_SUBSURFACE: u8 = 4
pub const ROLE_LAYER: u8 = 5

// zwlr_layer_shell_v1 layers and anchors.
pub const LAYER_BACKGROUND: u32 = 0
pub const LAYER_BOTTOM: u32 = 1
pub const LAYER_TOP: u32 = 2
pub const LAYER_OVERLAY: u32 = 3
pub const ANCHOR_TOP: u32 = 1
pub const ANCHOR_BOTTOM: u32 = 2
pub const ANCHOR_LEFT: u32 = 4
pub const ANCHOR_RIGHT: u32 = 8
pub const KEYBOARD_NONE: u32 = 0
pub const KEYBOARD_EXCLUSIVE: u32 = 1
pub const KEYBOARD_ON_DEMAND: u32 = 2

pub const SEAT_POINTER: u8 = 0
pub const SEAT_KEYBOARD: u8 = 1
pub const SEAT_TOPLEVEL_MANAGER: u8 = 2

pub const MAX_CALLBACKS: usize = 32
pub const MAX_LAUNCH: usize = 8

// Start-up stages (Compositor.stage).
pub const STAGE_ARGUMENTS: u8 = 0
pub const STAGE_SOCKET: u8 = 1
pub const STAGE_GLOBALS: u8 = 2
pub const STAGE_OUTPUT: u8 = 3
// Connected to the session compositor (compositor.host is valid).
pub const STAGE_HOST: u8 = 4
// The window is open; the renderer starts (and says why when it cannot).
pub const STAGE_RENDERER: u8 = 5
pub const STAGE_RUNNING: u8 = 6
pub const STAGE_DONE: u8 = 7

pub const Compositor = struct {
    allocator: Allocator
    server: wl.server.Display
    host: wl.client.Display
    width: usize
    height: usize
    running: bool
    verbose: bool
    // Title bars show frames per second (--no-fps: they do not).
    showFps: bool
    socketName: [64]u8
    socketNameLength: usize

    // Host connection (this compositor is a client of the host).
    hostRegistry: wl.wl_registry.Proxy
    hostCompositor: wl.wl_compositor.Proxy
    hostShm: wl.wl_shm.Proxy
    hostWmBase: wl.xdg_wm_base.Proxy
    hostSeat: wl.wl_seat.Proxy
    hostPointer: wl.wl_pointer.Proxy
    hostKeyboard: wl.wl_keyboard.Proxy
    hasHostCompositor: bool
    hasHostShm: bool
    hasHostWmBase: bool
    hasHostSeat: bool
    hasHostPointer: bool
    hasHostKeyboard: bool
    // The host's (first) monitor: its current mode and scale, and what the
    // host's toplevel configure asked for (0: nothing yet). With
    // `fullscreen` the output takes that size instead of --size.
    hostOutput: wl.wl_output.Proxy
    hasHostOutput: bool
    hostModeWidth: i32
    hostModeHeight: i32
    hostScale: i32
    hostConfigureWidth: i32
    hostConfigureHeight: i32
    fullscreen: bool
    hostSurface: wl.wl_surface.Proxy
    hostXdgSurface: wl.xdg_surface.Proxy
    hostToplevel: wl.xdg_toplevel.Proxy
    hostMemory: wl.SharedMemory
    hostFirstBuffer: wl.wl_buffer.Proxy
    hostSecondBuffer: wl.wl_buffer.Proxy
    hostFirstBusy: bool
    hostSecondBusy: bool
    hostConfigured: bool
    hostFramePending: bool
    // Something changed since the last frame (scene.damage*).
    needsRedraw: bool
    // What changed since the last frame was composed, as one rectangle in
    // output coordinates (empty: nothing), and what each of the two frame
    // slots still lacks (everything that changed since it was composed
    // into): the CPU renderer composes and copies only those parts.
    damage: ui.Rect
    slotDamage: [2]ui.Rect
    // What the renderer copies of a frame it composed elsewhere into the
    // output buffer: what that buffer lacks.
    copyRegion: ui.Rect
    frames: usize
    // The last composed frame (for --screenshot), its rows `lastFrameStride`
    // bytes apart.
    lastFrame: [*]u8
    lastFrameStride: usize

    // Keyboard description received from the host, handed to clients.
    hasKeymap: bool
    keymap: wl.Handle
    keymapFormat: u32
    keymapSize: u32
    repeatRate: i32
    repeatDelay: i32
    modsDepressed: u32
    modsLatched: u32
    modsLocked: u32
    modsGroup: u32

    // Scene: every surface, and mapped windows from bottom to top.
    surfaces: Vector
    stack: Vector
    buffers: Vector
    regions: Vector
    positioners: Vector
    pointers: Vector
    keyboards: Vector
    // Copy and paste (data.mlx): data sources, data devices, data offers
    // and the Source that is the selection (0 for none).
    dataSources: Vector
    dataDevices: Vector
    dataOffers: Vector
    selection: usize
    nextWindowX: i32
    nextWindowY: i32

    // Input state (compositor coordinates).
    pointerX: i32
    pointerY: i32
    pointerInside: bool
    pointerFocus: usize
    // The serial of the last wl_pointer.enter: a set_cursor with another
    // (sent before the pointer moved on) is ignored.
    pointerEnterSerial: u32
    keyboardFocus: usize
    buttonsDown: u32
    moving: usize
    moveOffsetX: i32
    moveOffsetY: i32
    // Interactive resize: the toplevel (0: none), its edges (scene.EDGE_*),
    // and where the pointer and the window's size started. hoverEdges: the
    // border under the pointer (for the cursor).
    resizing: usize
    resizeEdges: u32
    resizeStartX: i32
    resizeStartY: i32
    resizeStartWidth: i32
    resizeStartHeight: i32
    hoverEdges: u32
    cursorSurface: usize
    cursorHotspotX: i32
    cursorHotspotY: i32
    cursorHidden: bool
    alt: bool
    shift: bool
    control: bool
    swallowedKey: u32
    swallowedButton: bool
    time: u32

    // The Vulkan renderer (vulkan.mlx), 0 when composing on the CPU.
    renderer: usize
    // Counts buffer commits (for Surface.contentSerial).
    commits: usize
    // How far start-up got (STAGE_*), to say why the compositor stopped.
    stage: u8

    // Window titles (std.truetype), when the font loaded.
    hasText: bool
    font: *tt.Font
    atlas: *tt.Atlas
    run: *tt.Run

    // Freestanding (drm.mlx: the compositor drives the monitor itself):
    // its backend record, and a VT asked for with Ctrl+Alt+F<n> (0: none).
    freestanding: bool
    drm: usize
    vtRequest: u32

    // Programs: Alt+Enter runs `terminal`; `environment` carries our
    // WAYLAND_DISPLAY to children.
    terminal: [*]const u8
    // Super on its own opens `launcher` (or closes the one open); 0: none.
    launcher: [*]const u8
    hasLauncher: bool
    superDown: bool
    superUsed: bool
    launcherStartedAt: u32
    // Frames per second: the desktop's (frames presented) and, per
    // window, frames committed; counted since fpsStart, shown in title bars.
    desktopFrames: u32
    // How long presenting frames took since fpsStart (microseconds).
    presentMicros: usize
    presentMax: usize
    presentCount: usize
    desktopFps: u32
    fpsStart: u32
    // The layer surface that holds the keyboard (exclusive interactivity in
    // the top or overlay layer; 0: none), and the edges layer surfaces
    // reserve (their exclusive zones), which windows keep clear of.
    exclusiveLayer: usize
    reserveTop: i32
    reserveBottom: i32
    reserveLeft: i32
    reserveRight: i32
    // wlr-foreign-toplevel-management: the managers bound (SeatResource
    // records, kind SEAT_TOPLEVEL_MANAGER) and the handles (ToplevelHandle
    // records).
    toplevelManagers: Vector
    toplevelHandles: Vector
    // ext-background-effect-v1: surfaces with a blur region (addresses).
    blurred: Vector
    environment: [*][*]const u8

    // The aggregate arena (arena.mlx): its base (0: not found), its fill
    // before the loop's first turn, and whether turns release and poison.
    arena: usize
    arenaMark: usize
    arenaPeak: usize
    arenaRelease: bool
    arenaPoison: bool

    // The shell's and the renderer's current entries (entries.mlx), and the
    // program's module record (modules.mlx; 0 without --modules).
    shellEntries: [16]usize
    renderEntries: [16]usize
    modules: usize
}

// Bumped whenever a shared record changes in a way its size does not show
// (fields reordered or retyped): modules built for another layout are
// refused (modules.mlx).
pub const LAYOUT_VERSION: usize = 1

// The layout of the records the program and its modules share.
pub fn layout() -> usize {
    var value = LAYOUT_VERSION
    value = value *% 31 +% @sizeOf(Compositor)
    value = value *% 31 +% @sizeOf(Pool)
    value = value *% 31 +% @sizeOf(RegionOp)
    value = value *% 31 +% @sizeOf(Region)
    value = value *% 31 +% @sizeOf(Buffer)
    value = value *% 31 +% @sizeOf(Positioner)
    value = value *% 31 +% @sizeOf(Surface)
    value = value *% 31 +% @sizeOf(SeatResource)
    value = value *% 31 +% @sizeOf(ToplevelHandle)
    return value
}

// Memory holding client pixels: a wl_shm pool, or the dma-buf of one
// linux-dmabuf buffer (mapped the same way, so both render alike). With
// the Vulkan renderer it is imported into the GPU on first use.
pub const Pool = struct {
    compositor: *Compositor
    memory: wl.SharedMemory
    references: usize
    dmabuf: bool
    imported: bool
    gpuBuffer: gpu.Buffer
    // The driver cannot import this memory (RADV and others refuse
    // file-backed host memory): its buffers are uploaded instead.
    importFailed: bool
}

// A wl_region: the rectangles added to and subtracted from it, in order
// (a point is in the region when the last operation covering it added).
pub const MAX_REGION_OPS: usize = 32

pub const RegionOp = struct {
    subtract: bool
    x: i32
    y: i32
    width: i32
    height: i32
}

pub const Region = struct {
    compositor: *Compositor
    resource: wl.server.Object
    ops: [32]RegionOp
    count: usize
}

// Whether (x, y) is in a region of `count` operations.
pub fn regionContains(ops: [*]const RegionOp, count: usize, x: i32, y: i32) -> bool {
    var inside = false
    var index: usize = 0
    while index < count {
        const op = ops[index]
        if x >= op.x && y >= op.y && x < op.x + op.width && y < op.y + op.height { inside = !op.subtract }
        index += 1
    }
    return inside
}

// Copies region operations (field by field: see takeDamage in scene.mlx).
pub fn copyRegionOps(target: [*]RegionOp, source: [*]const RegionOp, count: usize) -> void {
    var index: usize = 0
    while index < count {
        target[index].subtract = source[index].subtract
        target[index].x = source[index].x
        target[index].y = source[index].y
        target[index].width = source[index].width
        target[index].height = source[index].height
        index += 1
    }
}

pub const Buffer = struct {
    compositor: *Compositor
    resource: wl.server.Object
    pool: *Pool
    offset: i32
    width: i32
    height: i32
    stride: i32
    format: u32
}

pub const Positioner = struct {
    compositor: *Compositor
    resource: wl.server.Object
    width: i32
    height: i32
    anchorX: i32
    anchorY: i32
    anchorWidth: i32
    anchorHeight: i32
    anchor: u32
    gravity: u32
    offsetX: i32
    offsetY: i32
}

pub const Surface = struct {
    compositor: *Compositor
    resource: wl.server.Object
    role: u8
    hasXdgSurface: bool
    xdgSurface: wl.server.Object
    hasToplevel: bool
    toplevel: wl.server.Object
    hasPopup: bool
    popup: wl.server.Object
    parent: usize
    configured: bool
    mapped: bool
    x: i32
    y: i32
    hasGeometry: bool
    geometryX: i32
    geometryY: i32
    geometryWidth: i32
    geometryHeight: i32
    pendingBuffer: usize
    hasPendingAttach: bool
    // The CPU renderer copies each committed buffer into `pixels` and
    // releases it; the Vulkan renderer reads `current` in place and
    // releases it when the next buffer replaces it.
    current: usize
    pixels: [*]u8
    pixelCapacity: usize
    pixelWidth: usize
    pixelHeight: usize
    hasContent: bool
    // Every pixel of `pixels` is opaque (an XRGB buffer, or an ARGB one
    // whose alpha was 255 throughout): rows are copied, not blended.
    opaque: bool
    pendingCallbacks: [32]u32
    pendingCallbackCount: usize
    frameCallbacks: [32]u32
    frameCallbackCount: usize
    title: [64]u8
    titleLength: usize
    fpsFrames: u32
    fps: u32
    // Toplevel size: what the compositor configured last (0 x 0: the
    // client's choice) and wants next, whether a configure still awaits
    // its ack and commit, and the client's limits (0: none).
    configuredWidth: i32
    configuredHeight: i32
    wantedWidth: i32
    wantedHeight: i32
    configureSerial: u32
    ackedSerial: u32
    configurePending: bool
    resizing: bool
    minWidth: i32
    minHeight: i32
    maxWidth: i32
    maxHeight: i32
    // While a resize from the left or top is applied: those edges, and
    // the right and bottom edges that stay where they are.
    anchorEdges: u32
    anchorRight: i32
    anchorBottom: i32
    // The window size last logged (--verbose).
    loggedWidth: i32
    loggedHeight: i32
    // Vulkan, when the buffer's memory cannot be imported: a GPU copy of
    // it (a gpu.Buffer record, 0: none) of `stagingSize` bytes, and the
    // content it holds (`contentSerial` when it is up to date).
    staging: usize
    stagingSize: usize
    stagingSerial: usize
    contentSerial: usize
    // What the client said changed (wl_surface.damage and damage_buffer,
    // in buffer pixels) since its last commit, and since the staging copy
    // was last brought up to date: only that part is uploaded.
    pendingDamage: ui.Rect
    uploadDamage: ui.Rect
    // Subsurfaces: this surface's wl_subsurface (role ROLE_SUBSURFACE,
    // `parent` set), its offset from the parent (applied) and the offset
    // asked for since (applied with the parent's commit), synchronized mode
    // (its commits wait for the parent's; `subCached` when one waits), and
    // its own subsurfaces bottom to top, of which the first `belowCount`
    // are drawn below it.
    hasSubsurface: bool
    subsurface: wl.server.Object
    subX: i32
    subY: i32
    pendingSubX: i32
    pendingSubY: i32
    hasPendingSubPosition: bool
    subSync: bool
    subCached: bool
    children: Vector
    belowCount: usize
    // The input region (wl_surface.set_input_region, surface coordinates):
    // when set, the pointer only enters the surface inside it (Firefox's
    // content subsurface has an empty one, so its window gets the pointer;
    // GTK 4 leaves its shadows out). The pending one is applied on commit.
    // Layer shell (ROLE_LAYER): the zwlr_layer_surface_v1, its namespace
    // (also copied to `title`), and its state as applied by the last commit
    // and as requested since.
    hasLayerSurface: bool
    layerSurface: wl.server.Object
    layer: u32
    anchor: u32
    exclusiveZone: i32
    marginTop: i32
    marginRight: i32
    marginBottom: i32
    marginLeft: i32
    keyboardInteractivity: u32
    layerWidth: u32
    layerHeight: u32
    pendingLayer: u32
    pendingAnchor: u32
    pendingExclusiveZone: i32
    pendingMarginTop: i32
    pendingMarginRight: i32
    pendingMarginBottom: i32
    pendingMarginLeft: i32
    pendingKeyboardInteractivity: u32
    pendingLayerWidth: u32
    pendingLayerHeight: u32
    // The size last configured, whether a configure was sent (since the
    // surface was created or unmapped) and acknowledged, and whether the
    // compositor closed it.
    layerConfiguredWidth: i32
    layerConfiguredHeight: i32
    layerConfigureSent: bool
    layerAcked: bool
    layerClosed: bool
    // A popup's position relative to its parent, as last configured.
    popupRelativeX: i32
    popupRelativeY: i32
    // xdg_toplevel.set_app_id, for the foreign-toplevel handles.
    appId: [64]u8
    appIdLength: usize
    // ext-background-effect-v1: the effect object and the blur region
    // (surface coordinates), applied on commit.
    hasBackgroundEffect: bool
    backgroundEffect: wl.server.Object
    hasBlur: bool
    blurOps: [32]RegionOp
    blurCount: usize
    hasPendingBlur: bool
    pendingBlurOps: [32]RegionOp
    pendingBlurCount: usize
    blurChanged: bool
    hasInputRegion: bool
    inputOps: [32]RegionOp
    inputCount: usize
    hasPendingInputRegion: bool
    pendingInputOps: [32]RegionOp
    pendingInputCount: usize
    inputRegionChanged: bool
}

// A zwlr_foreign_toplevel_handle_v1: one window, for one manager's client.
pub const ToplevelHandle = struct {
    compositor: *Compositor
    object: wl.server.Object
    surface: usize
    // The state last sent (activated), to send changes only.
    activated: bool
    closed: bool
}

pub const SeatResource = struct {
    compositor: *Compositor
    object: wl.server.Object
    kind: u8
}

// ---------------------------------------------------------------------------
// Allocation

pub fn allocate(compositor: *Compositor, size: usize) -> [*]u8 {
    const memory = compositor.*.allocator.alloc(size, 16)
    return memory.?
}

pub fn release(compositor: *Compositor, memory: [*]u8, size: usize) -> void {
    compositor.*.allocator.free(memory, size, 16)
}

pub fn contextOf(record: [*]u8) -> *anyopaque {
    unsafe { return @ptrCast(*anyopaque, record) }
}

pub fn compositorOf(context: *anyopaque) -> *Compositor {
    unsafe { return @ptrCast(*Compositor, context) }
}

pub fn surfaceOf(context: *anyopaque) -> *Surface {
    unsafe { return @ptrCast(*Surface, context) }
}

pub fn surfaceAt(address: usize) -> *Surface {
    unsafe { return @ptrFromInt(*Surface, address) }
}

pub fn addressOfSurface(surface: *Surface) -> usize { return @intFromPtr(surface) }

// ---------------------------------------------------------------------------
// Lists of record addresses (value style: they return the updated list)

pub fn newList(allocator: Allocator) -> Vector {
    var list: Vector = undefined
    Vector.initAt(&list, allocator, 8, 8, 16)
    return list
}

pub fn listAt(list: Vector, index: usize) -> usize {
    unsafe { return @ptrCast(*usize, list.at(index)).* }
}

pub fn listAppend(list: Vector, value: usize) -> Vector {
    var result = list
    var copy = value
    unsafe { const appended = Vector.appendAt(&result, @ptrCast([*]const u8, &copy)) }
    return result
}

// Inserts `value` at `position` (at most the length).
pub fn listInsert(list: Vector, position: usize, value: usize) -> Vector {
    var result = listAppend(list, value)
    var index = result.length - 1
    while index > position {
        unsafe {
            const slot = @ptrCast(*usize, result.at(index))
            slot.* = listAt(result, index - 1)
        }
        index -= 1
    }
    unsafe {
        const slot = @ptrCast(*usize, result.at(position))
        slot.* = value
    }
    return result
}

// The position of `value` in the list, or its length when absent.
pub fn listIndexOf(list: Vector, value: usize) -> usize {
    var index: usize = 0
    while index < list.length {
        if listAt(list, index) == value { return index }
        index += 1
    }
    return list.length
}

pub fn listRemove(list: Vector, value: usize) -> Vector {
    var result = list
    var write: usize = 0
    var read: usize = 0
    while read < result.length {
        const current = listAt(result, read)
        if current != value {
            unsafe {
                const slot = @ptrCast(*usize, result.at(write))
                slot.* = current
            }
            write += 1
        }
        read += 1
    }
    result.length = write
    return result
}

pub fn listContains(list: Vector, value: usize) -> bool {
    var index: usize = 0
    while index < list.length {
        if listAt(list, index) == value { return true }
        index += 1
    }
    return false
}

pub fn sameClient(first: wl.server.Object, second: wl.server.Object) -> bool {
    return @intFromPtr(first.client.state) == @intFromPtr(second.client.state)
}

// The value of `name` in a NUL-terminated environment list (a null
// pointer when it is not set).
pub fn environmentValue(environment: [*][*]const u8, name: []const u8) -> [*]const u8 {
    var index: usize = 0
    while @intFromPtr(environment[index]) != 0 {
        const entry = environment[index]
        var matches = true
        var length: usize = 0
        for byte in name {
            if entry[length] != byte { matches = false }
            length += 1
        }
        if matches && entry[length] == 61 {
            unsafe { return @ptrFromInt([*]const u8, @intFromPtr(entry) + length + 1) }
        }
        index += 1
    }
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

// ---------------------------------------------------------------------------
// Pixel copies

// Copies `bytes` (a multiple of 8) from `source` to `destination`, both
// 8-byte aligned.
pub fn copyWords(destination: usize, source: usize, bytes: usize) -> void {
    var to: [*]u64 = undefined
    var from: [*]const u64 = undefined
    unsafe {
        to = @ptrFromInt([*]u64, destination)
        from = @ptrFromInt([*]const u64, source)
    }
    const words = bytes / 8
    var index: usize = 0
    while index + 4 <= words {
        to[index] = from[index]
        to[index + 1] = from[index + 1]
        to[index + 2] = from[index + 2]
        to[index + 3] = from[index + 3]
        index += 4
    }
    while index < words {
        to[index] = from[index]
        index += 1
    }
}

// Copies `count` 32-bit pixels from `source` to `destination` (addresses,
// 4-byte aligned).
pub fn copyPixels(destination: usize, source: usize, count: usize) -> void {
    const even = count / 2 * 2
    if destination % 8 == 0 && source % 8 == 0 {
        copyWords(destination, source, even * 4)
    } else {
        var to: [*]u32 = undefined
        var from: [*]const u32 = undefined
        unsafe {
            to = @ptrFromInt([*]u32, destination)
            from = @ptrFromInt([*]const u32, source)
        }
        var index: usize = 0
        while index < even {
            to[index] = from[index]
            index += 1
        }
    }
    if even < count {
        var last: [*]u32 = undefined
        var first: [*]const u32 = undefined
        unsafe {
            last = @ptrFromInt([*]u32, destination)
            first = @ptrFromInt([*]const u32, source)
        }
        last[even] = first[even]
    }
}

// Fills `count` 32-bit pixels at `destination` (4-byte aligned) with `color`.
pub fn fillPixels(destination: usize, count: usize, color: u32) -> void {
    var index: usize = 0
    var to: [*]u32 = undefined
    unsafe { to = @ptrFromInt([*]u32, destination) }
    if destination % 8 == 0 {
        const pair = @intCast(u64, color) | (@intCast(u64, color) << 32)
        var pairs: [*]u64 = undefined
        unsafe { pairs = @ptrFromInt([*]u64, destination) }
        const even = count / 2
        var pair_index: usize = 0
        while pair_index + 4 <= even {
            pairs[pair_index] = pair
            pairs[pair_index + 1] = pair
            pairs[pair_index + 2] = pair
            pairs[pair_index + 3] = pair
            pair_index += 4
        }
        while pair_index < even {
            pairs[pair_index] = pair
            pair_index += 1
        }
        index = even * 2
    }
    while index < count {
        to[index] = color
        index += 1
    }
}

// Monotonic time in microseconds.
pub fn microseconds() -> usize {
    var time: [2]usize = [2]usize{ 0, 0 }
    const result = std.linux.syscall2(228, 1, @intFromPtr(&time))
    return time[0] * 1000000 + time[1] / 1000
}

// Adds a frame's presenting time, taken from `start`, to the statistics.
pub fn countPresent(compositor: *Compositor, start: usize) -> void {
    const spent = microseconds() - start
    compositor.*.presentMicros += spent
    compositor.*.presentCount += 1
    if spent > compositor.*.presentMax { compositor.*.presentMax = spent }
}

pub fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stdout(), text)
}

pub fn sayNumber(value: usize) -> void {
    const ignored = std.io.writeUnsigned(std.io.stdout(), value)
}

pub fn sayInteger(value: i32) -> void {
    if value < 0 {
        say("-")
        sayNumber(@intCast(usize, 0 - value))
    } else {
        sayNumber(@intCast(usize, value))
    }
}

pub fn sayTitle(surface: *const Surface) -> void {
    var copy: [64]u8 = undefined
    var index: usize = 0
    while index < surface.*.titleLength {
        copy[index] = surface.*.title[index]
        index += 1
    }
    unsafe { const ignored = std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, &copy), surface.*.titleLength) }
}
