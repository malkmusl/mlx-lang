// Layout and drawing (part of main.mlx, split from it).
const std = @import("std")
const png = @import("std.png")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const places = @import("../desktop-shared/places.mlx")
const icons = @import("../desktop-shared/icons.mlx")
const clock = @import("../desktop-shared/clock.mlx")
const app = @import("./main.mlx")
const folder_module = @import("./folder.mlx")
const input_module = @import("./input.mlx")

// ---------------------------------------------------------------------------
// Layout

fn surfaceWidth(files: *app.Files) -> i32 { return @intCast(i32, app.panelOf(files).*.width) }
pub fn surfaceHeight(files: *app.Files) -> i32 { return @intCast(i32, app.panelOf(files).*.height) }

pub fn contentTop(files: *app.Files) -> i32 { return if files.*.listView { app.TOOLBAR + app.HEADER } else { app.TOOLBAR } }
pub fn contentBottom(files: *app.Files) -> i32 { return surfaceHeight(files) - app.STATUS }
fn contentWidth(files: *app.Files) -> i32 { return surfaceWidth(files) - app.SIDEBAR }

pub fn columns(files: *app.Files) -> i32 {
    const count = (contentWidth(files) - app.GRID_PADDING * 2) / app.CELL_WIDTH
    return if count < 1 { 1 } else { count }
}

fn cellWidth(files: *app.Files) -> i32 { return (contentWidth(files) - app.GRID_PADDING * 2) / columns(files) }

fn contentHeight(files: *app.Files) -> i32 {
    const count = @intCast(i32, files.*.shownCount)
    if files.*.listView { return count * app.ROW + 8 }
    return app.GRID_PADDING * 2 + (count + columns(files) - 1) / columns(files) * app.CELL_HEIGHT
}

fn maxScroll(files: *app.Files) -> i32 {
    const extra = contentHeight(files) - (contentBottom(files) - contentTop(files))
    return if extra > 0 { extra } else { 0 }
}

pub fn clampScroll(files: *app.Files) -> void {
    if files.*.scroll > maxScroll(files) { files.*.scroll = maxScroll(files) }
    if files.*.scroll < 0 { files.*.scroll = 0 }
}

// Where item `index` (among those shown) is.
pub fn itemX(files: *app.Files, index: usize) -> i32 {
    if files.*.listView { return app.SIDEBAR }
    return app.SIDEBAR + app.GRID_PADDING + @intCast(i32, index) % columns(files) * cellWidth(files)
}

pub fn itemY(files: *app.Files, index: usize) -> i32 {
    if files.*.listView { return contentTop(files) + @intCast(i32, index) * app.ROW - files.*.scroll }
    return contentTop(files) + app.GRID_PADDING + @intCast(i32, index) / columns(files) * app.CELL_HEIGHT - files.*.scroll
}

pub fn itemWidth(files: *app.Files) -> i32 { return if files.*.listView { contentWidth(files) } else { cellWidth(files) } }
pub fn itemHeight(files: *app.Files) -> i32 { return if files.*.listView { app.ROW } else { app.CELL_HEIGHT } }

// The list's columns: where each starts (0: not shown for want of room).
fn kindColumn(files: *app.Files) -> i32 { return if contentWidth(files) >= 700 { surfaceWidth(files) - 130 } else { 0 } }
fn sizeColumnRight(files: *app.Files) -> i32 {
    if contentWidth(files) < 470 { return 0 }
    return if kindColumn(files) > 0 { kindColumn(files) - 20 } else { surfaceWidth(files) - 20 }
}
fn dateColumn(files: *app.Files) -> i32 {
    if contentWidth(files) < 380 { return 0 }
    const right = if sizeColumnRight(files) > 0 { sizeColumnRight(files) - 80 } else { surfaceWidth(files) - 20 }
    return right - 170
}
fn nameLimit(files: *app.Files) -> i32 {
    const end = if dateColumn(files) > 0 { dateColumn(files) } else { surfaceWidth(files) }
    return end - (app.SIDEBAR + 44) - 12
}

// The toolbar's buttons.
fn backX() -> i32 { return app.SIDEBAR + 12 }
fn forwardX() -> i32 { return app.SIDEBAR + 12 + app.BUTTON + 4 }
fn searchX(files: *app.Files) -> i32 { return surfaceWidth(files) - 14 - app.SEARCH_WIDTH }
fn listButtonX(files: *app.Files) -> i32 { return searchX(files) - 12 - app.BUTTON }
fn gridButtonX(files: *app.Files) -> i32 { return listButtonX(files) - app.BUTTON }
fn emptyTrashX(files: *app.Files) -> i32 { return gridButtonX(files) - 12 - 110 }

fn inside(x: i32, y: i32, left: i32, top: i32, width: i32, height: i32) -> bool {
    return x >= left && x < left + width && y >= top && y < top + height
}

// The breadcrumbs of the status bar: part `index` of the path, and where
// it starts; count of them.
fn crumbCount(files: *app.Files) -> usize {
    if files.*.inTrash { return 1 }
    const path = app.pathText(app.pathOf(files))
    var start: usize = 0
    var count: usize = 1
    if app.underHome(files, path) { start = app.homeLength(files) }
    var index = start
    while index < path.length {
        if path[index] == 47 && index + 1 < path.length { count += 1 }
        index += 1
    }
    return count
}

// Crumb `index`: its label, and the length of the path up to it.
pub fn crumb(files: *app.Files, index: usize, end: *usize) -> []const u8 {
    const path = app.pathText(app.pathOf(files))
    if files.*.inTrash {
        end.* = path.length
        return app.say(files, "Trash", "Papierkorb")
    }
    const home = app.underHome(files, path)
    const start = if home { app.homeLength(files) } else { 0 }
    if index == 0 {
        end.* = if start == 0 { 1 } else { start }
        if home { return places.baseName(path[0..start]) }
        return app.say(files, "Computer", "Computer")
    }
    var at = start
    var part: usize = 0
    while at < path.length {
        if path[at] == 47 && at + 1 < path.length {
            part += 1
            if part == index {
                var stop = at + 1
                while stop < path.length && path[stop] != 47 { stop += 1 }
                end.* = stop
                return path[at + 1..stop]
            }
        }
        at += 1
    }
    end.* = path.length
    return path[0..0]
}

fn crumbWidth(files: *app.Files, index: usize) -> i32 {
    var end: usize = 0
    return canvas_module.measure(app.smallOf(files), crumb(files, index, &end)) + 22
}

pub fn hitAt(files: *app.Files, x: i32, y: i32) -> usize {
    const width = surfaceWidth(files)
    const height = surfaceHeight(files)
    if x < app.SIDEBAR {
        var index: usize = 0
        while index < files.*.placeCount {
            if inside(x, y, 8, folder_module.placeTop(files, index), app.SIDEBAR - 16, app.PLACE_ROW) { return app.HIT_PLACE + index }
            index += 1
        }
        return app.HIT_SIDEBAR
    }
    if y < app.TOOLBAR {
        const top = (app.TOOLBAR - app.BUTTON) / 2
        if inside(x, y, backX(), top, app.BUTTON, app.BUTTON) { return app.HIT_BACK }
        if inside(x, y, forwardX(), top, app.BUTTON, app.BUTTON) { return app.HIT_FORWARD }
        if inside(x, y, gridButtonX(files), top, app.BUTTON, app.BUTTON) { return app.HIT_GRID }
        if inside(x, y, listButtonX(files), top, app.BUTTON, app.BUTTON) { return app.HIT_LIST }
        if inside(x, y, searchX(files), top, app.SEARCH_WIDTH, app.BUTTON) { return app.HIT_SEARCH }
        if files.*.inTrash && inside(x, y, emptyTrashX(files), top, 110, app.BUTTON) { return app.HIT_EMPTY_TRASH }
        return app.NONE
    }
    if y >= height - app.STATUS {
        var left = app.SIDEBAR + 12
        var index: usize = 0
        while index < crumbCount(files) {
            const w = crumbWidth(files, index)
            if x >= left && x < left + w { return app.HIT_CRUMB + index }
            left += w
            index += 1
        }
        return app.NONE
    }
    if files.*.listView && y < app.TOOLBAR + app.HEADER {
        if x < app.SIDEBAR + 44 + nameLimit(files) { return app.HIT_COLUMN + app.SORT_NAME }
        if dateColumn(files) > 0 && x >= dateColumn(files) && x < dateColumn(files) + 170 { return app.HIT_COLUMN + app.SORT_DATE }
        if sizeColumnRight(files) > 0 && x >= sizeColumnRight(files) - 80 && x < sizeColumnRight(files) + 10 { return app.HIT_COLUMN + app.SORT_SIZE }
        if kindColumn(files) > 0 && x >= kindColumn(files) { return app.HIT_COLUMN + app.SORT_KIND }
        return app.NONE
    }
    // An item.
    if files.*.listView {
        const row = y - contentTop(files) + files.*.scroll
        if row >= 0 {
            const index = @intCast(usize, row / app.ROW)
            if index < files.*.shownCount { return index }
        }
        return app.HIT_CONTENT
    }
    const column = (x - app.SIDEBAR - app.GRID_PADDING) / cellWidth(files)
    const row_y = y - contentTop(files) - app.GRID_PADDING + files.*.scroll
    if x < app.SIDEBAR + app.GRID_PADDING || column >= columns(files) || row_y < 0 { return app.HIT_CONTENT }
    const index = @intCast(usize, row_y / app.CELL_HEIGHT * columns(files) + column)
    if index >= files.*.shownCount { return app.HIT_CONTENT }
    // The icon and the name, not the space around them.
    const cell_x = itemX(files, index)
    const cell_y = itemY(files, index)
    if !inside(x, y, cell_x + 6, cell_y + 4, cellWidth(files) - 12, app.CELL_HEIGHT - 8) { return app.HIT_CONTENT }
    return index
}

// Scrolls so the cursor shows.
pub fn revealCursor(files: *app.Files) -> void {
    if files.*.cursor == app.NONE { return }
    const index = folder_module.shownIndexOf(files, files.*.cursor)
    if index == app.NONE { return }
    const top = itemY(files, index) + files.*.scroll - contentTop(files)
    const view = contentBottom(files) - contentTop(files)
    const pad = if files.*.listView { 0 } else { app.GRID_PADDING }
    if top - pad < files.*.scroll { files.*.scroll = top - pad }
    if top + itemHeight(files) + pad > files.*.scroll + view { files.*.scroll = top + itemHeight(files) + pad - view }
    clampScroll(files)
}

// ---------------------------------------------------------------------------
// Drawing

const BACKGROUND: u32 = 4280164392
const TEXT_COLOR: u32 = 4293652213
const DIM_COLOR: u32 = 4287402656
const ACCENT: u32 = 4284129535

pub fn writeNumber(out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var index = at
    while count > 0 {
        count -= 1
        out[index] = digits[count]
        index += 1
    }
    return index
}

// A size as people read it: "812 bytes", "1.2 KB", "34 MB" (German: "1,2
// MB"); into `out` from `at`, the length then.
fn formatSize(files: *app.Files, size: isize, out: [*]u8, at: usize) -> usize {
    var length: usize = 0
    const value = if size > 0 { @intCast(usize, size) } else { 0 }
    if value < 1000 {
        length = writeNumber(out, at, value)
        return writeText(out, length, if value == 1 { app.say(files, " byte", " Byte") } else { app.say(files, " bytes", " Bytes") })
    }
    var unit: usize = 0
    // Tenths of the unit.
    var tenths = value / 100
    while tenths >= 10000 && unit < 4 {
        tenths = tenths / 1000
        unit += 1
    }
    if tenths >= 100 {
        length = writeNumber(out, at, (tenths + 5) / 10)
    } else {
        length = writeNumber(out, at, tenths / 10)
        var separator: u8 = 46
        if files.*.german { separator = 44 }
        out[length] = separator
        length = writeNumber(out, length + 1, tenths % 10)
    }
    const units = match unit { 0 => " KB", 1 => " MB", 2 => " GB", 3 => " TB", else => " PB" }
    return writeText(out, length, units)
}

fn writeText(out: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        out[index] = byte
        index += 1
    }
    return index
}

// What kind of file an entry is ("Folder", "PNG image", ...).
fn kindOf(files: *app.Files, entry: *const app.Entry, out: [*]u8) -> usize {
    if entry.*.directory { return writeText(out, 0, app.say(files, "Folder", "Ordner")) }
    const extension = folder_module.extensionOf(app.nameOf(files, entry))
    var upper: [8]u8 = undefined
    var length: usize = 0
    for byte in extension {
        if length < 8 {
            upper[length] = if byte >= 97 && byte <= 122 { byte - 32 } else { byte }
            length += 1
        }
    }
    const kind = upper[0..length]
    if length == 0 || extension.length > 8 {
        if entry.*.executable { return writeText(out, 0, app.say(files, "Program", "Programm")) }
        return writeText(out, 0, app.say(files, "Document", "Dokument"))
    }
    if std.text.same(kind, "PNG") || std.text.same(kind, "JPG") || std.text.same(kind, "JPEG") || std.text.same(kind, "GIF") || std.text.same(kind, "WEBP") || std.text.same(kind, "SVG") || std.text.same(kind, "BMP") {
        length = writeText(out, 0, kind)
        return writeText(out, length, app.say(files, " image", "-Bild"))
    }
    if std.text.same(kind, "PDF") { return writeText(out, 0, app.say(files, "PDF document", "PDF-Dokument")) }
    if std.text.same(kind, "TXT") || std.text.same(kind, "MD") { return writeText(out, 0, app.say(files, "Plain text", "Text")) }
    if std.text.same(kind, "ZIP") || std.text.same(kind, "GZ") || std.text.same(kind, "XZ") || std.text.same(kind, "ZST") || std.text.same(kind, "TAR") || std.text.same(kind, "7Z") || std.text.same(kind, "RAR") || std.text.same(kind, "BZ2") { return writeText(out, 0, app.say(files, "Archive", "Archiv")) }
    if std.text.same(kind, "MP3") || std.text.same(kind, "FLAC") || std.text.same(kind, "OGG") || std.text.same(kind, "WAV") || std.text.same(kind, "OPUS") || std.text.same(kind, "M4A") { return writeText(out, 0, "Audio") }
    if std.text.same(kind, "MP4") || std.text.same(kind, "MKV") || std.text.same(kind, "WEBM") || std.text.same(kind, "MOV") || std.text.same(kind, "AVI") { return writeText(out, 0, "Video") }
    if std.text.same(kind, "DESKTOP") { return writeText(out, 0, app.say(files, "App", "Programm")) }
    if std.text.same(kind, "MLX") || std.text.same(kind, "C") || std.text.same(kind, "H") || std.text.same(kind, "RS") || std.text.same(kind, "PY") || std.text.same(kind, "JS") || std.text.same(kind, "TS") || std.text.same(kind, "ZIG") || std.text.same(kind, "SH") || std.text.same(kind, "GO") || std.text.same(kind, "CPP") || std.text.same(kind, "JAVA") { return writeText(out, 0, app.say(files, "Source code", "Quelltext")) }
    length = writeText(out, 0, kind)
    return writeText(out, length, app.say(files, " file", "-Datei"))
}

// Two strokes meeting at a point, `size` rows high (odd).
fn drawBackChevron(canvas: *app.Canvas, x: i32, y: i32, left: bool, color: u32) -> void { canvas_module.drawChevron(canvas, x, y, left, color, 13, 3) }

fn drawButton(files: *app.Files, canvas: *app.Canvas, x: i32, hit: usize, active: bool) -> void {
    const top = (app.TOOLBAR - app.BUTTON) / 2
    if active {
        canvas_module.fillRoundedRect(canvas, x, top, app.BUTTON, app.BUTTON, 8, canvas_module.color(255, 66, 70, 84))
    } else if files.*.hover == hit {
        canvas_module.fillRoundedRect(canvas, x, top, app.BUTTON, app.BUTTON, 8, canvas_module.color(255, 50, 54, 66))
    }
}

fn drawGridGlyph(canvas: *app.Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, 6, 6, 2, color)
    canvas_module.fillRoundedRect(canvas, x + 8, y, 6, 6, 2, color)
    canvas_module.fillRoundedRect(canvas, x, y + 8, 6, 6, 2, color)
    canvas_module.fillRoundedRect(canvas, x + 8, y + 8, 6, 6, 2, color)
}

fn drawListGlyph(canvas: *app.Canvas, x: i32, y: i32, color: u32) -> void {
    var row: i32 = 0
    while row < 3 {
        canvas_module.fillRoundedRect(canvas, x, y + row * 5, 3, 3, 1, color)
        canvas_module.fillRoundedRect(canvas, x + 5, y + row * 5, 11, 3, 1, color)
        row += 1
    }
}

// A house for the home folder.
fn drawHomeGlyph(canvas: *app.Canvas, x: i32, y: i32, color: u32) -> void {
    var row: i32 = 0
    while row < 8 {
        canvas_module.fillRect(canvas, x + 9 - row, y + 1 + row, row * 2, 1, color)
        row += 1
    }
    canvas_module.fillRect(canvas, x + 3, y + 9, 12, 8, color)
    canvas_module.fillRect(canvas, x + 7, y + 12, 4, 5, canvas_module.color(255, 26, 28, 36))
}

// A screen on a stand for the computer.
fn drawComputerGlyph(canvas: *app.Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.fillRoundedRect(canvas, x + 1, y + 2, 16, 11, 2, color)
    canvas_module.fillRect(canvas, x + 3, y + 4, 12, 7, canvas_module.color(255, 26, 28, 36))
    canvas_module.fillRect(canvas, x + 7, y + 13, 4, 3, color)
    canvas_module.fillRect(canvas, x + 4, y + 16, 10, 2, color)
}

fn drawSidebar(files: *app.Files, canvas: *app.Canvas) -> void {
    const height = surfaceHeight(files)
    canvas_module.fillRect(canvas, 0, 0, app.SIDEBAR, height, canvas_module.color(214, 26, 28, 36))
    canvas_module.fillRect(canvas, app.SIDEBAR - 1, 0, 1, height, canvas_module.color(255, 18, 19, 25))
    const small = app.smallOf(files)
    const body = app.bodyOf(files)
    canvas_module.drawText(canvas, small, app.say(files, "Favorites", "Favoriten"), 18, 22, DIM_COLOR, 0)
    var index: usize = 0
    var locations_drawn = false
    while index < files.*.placeCount {
        const kind = files.*.placeKinds[index]
        const y = folder_module.placeTop(files, index)
        if (kind == app.PLACE_COMPUTER || kind == app.PLACE_TRASH) && !locations_drawn {
            canvas_module.drawText(canvas, small, app.say(files, "Locations", "Orte"), 18, y - 22, DIM_COLOR, 0)
            locations_drawn = true
        }
        const active = folder_module.placeActive(files, index)
        if active {
            canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.PLACE_ROW, 7, canvas_module.color(255, 58, 63, 78))
        } else if files.*.hover == app.HIT_PLACE + index {
            canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.PLACE_ROW, 7, canvas_module.color(255, 42, 45, 56))
        }
        const glyph = ACCENT
        const icon_y = y + (app.PLACE_ROW - 18) / 2
        if kind == app.PLACE_HOME {
            drawHomeGlyph(canvas, 16, icon_y, glyph)
        } else if kind == app.PLACE_COMPUTER {
            drawComputerGlyph(canvas, 16, icon_y, glyph)
        } else if kind == app.PLACE_TRASH {
            icons.drawTrash(canvas, 14, icon_y - 2, 22, places.trashFull(files.*.environment), false)
        } else {
            icons.drawFolder(small, canvas, app.pathText(app.placePathAt(files, index)), 15, icon_y, 20)
        }
        canvas_module.drawText(canvas, body, folder_module.placeLabel(files, index), 44, y + (app.PLACE_ROW - 16) / 2, TEXT_COLOR, app.SIDEBAR - 56)
        index += 1
    }
}

fn drawToolbar(files: *app.Files, canvas: *app.Canvas) -> void {
    const width = surfaceWidth(files)
    canvas_module.fillRect(canvas, app.SIDEBAR, 0, width - app.SIDEBAR, app.TOOLBAR, canvas_module.color(255, 36, 38, 47))
    canvas_module.fillRect(canvas, app.SIDEBAR, app.TOOLBAR - 1, width - app.SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    const top = (app.TOOLBAR - app.BUTTON) / 2
    const can_back = files.*.backCount > 0
    const can_forward = files.*.forwardCount > 0
    drawButton(files, canvas, backX(), app.HIT_BACK, false)
    drawButton(files, canvas, forwardX(), app.HIT_FORWARD, false)
    drawBackChevron(canvas, backX() + 11, top + 9, true, if can_back { TEXT_COLOR } else { canvas_module.color(255, 80, 84, 96) })
    drawBackChevron(canvas, forwardX() + 12, top + 9, false, if can_forward { TEXT_COLOR } else { canvas_module.color(255, 80, 84, 96) })
    // The folder's name.
    const name = folder_module.folderTitle(files)
    const title_x = forwardX() + app.BUTTON + 14
    const title_end = if files.*.inTrash { emptyTrashX(files) } else { gridButtonX(files) }
    canvas_module.drawText(canvas, app.titleOf(files), name, title_x, (app.TOOLBAR - 17) / 2, TEXT_COLOR, title_end - title_x - 12)
    // Grid or list.
    canvas_module.fillRoundedRect(canvas, gridButtonX(files), top, app.BUTTON * 2, app.BUTTON, 8, canvas_module.color(255, 44, 47, 58))
    drawButton(files, canvas, gridButtonX(files), app.HIT_GRID, !files.*.listView)
    drawButton(files, canvas, listButtonX(files), app.HIT_LIST, files.*.listView)
    drawGridGlyph(canvas, gridButtonX(files) + 8, top + 8, TEXT_COLOR)
    drawListGlyph(canvas, listButtonX(files) + 7, top + 8, TEXT_COLOR)
    // The trash's Empty button.
    if files.*.inTrash {
        const x = emptyTrashX(files)
        const lit = files.*.hover == app.HIT_EMPTY_TRASH
        canvas_module.fillRoundedRect(canvas, x, top, 110, app.BUTTON, 8, if lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
        const label = app.say(files, "Empty", "Leeren")
        canvas_module.drawText(canvas, app.bodyOf(files), label, x + (110 - canvas_module.measure(app.bodyOf(files), label)) / 2, top + 7, TEXT_COLOR, 0)
    }
    // The search field.
    const search_x = searchX(files)
    canvas_module.fillRoundedRect(canvas, search_x, top, app.SEARCH_WIDTH, app.BUTTON, 8, canvas_module.color(255, 26, 28, 35))
    if files.*.searchFocused { canvas_module.strokeRoundedRect(canvas, search_x - 1, top - 1, app.SEARCH_WIDTH + 2, app.BUTTON + 2, 9, 2, ACCENT) }
    canvas_module.drawSearchGlyph(canvas, search_x + 10, top + 8, DIM_COLOR)
    const search = app.searchText(files)
    const text_x = search_x + 32
    if search.length == 0 {
        if !files.*.searchFocused { canvas_module.drawText(canvas, app.bodyOf(files), app.say(files, "Search", "Suchen"), text_x, top + 7, DIM_COLOR, 0) }
    } else {
        canvas_module.drawText(canvas, app.bodyOf(files), search, text_x, top + 7, TEXT_COLOR, app.SEARCH_WIDTH - 40)
    }
    if files.*.searchFocused {
        const caret_x = text_x + canvas_module.measure(app.bodyOf(files), search)
        if caret_x < search_x + app.SEARCH_WIDTH - 8 { canvas_module.fillRect(canvas, caret_x + 1, top + 7, 2, 16, ACCENT) }
    }
}

fn drawStatus(files: *app.Files, canvas: *app.Canvas) -> void {
    const width = surfaceWidth(files)
    const height = surfaceHeight(files)
    const top = height - app.STATUS
    canvas_module.fillRect(canvas, app.SIDEBAR, top, width - app.SIDEBAR, app.STATUS, canvas_module.color(255, 34, 36, 45))
    canvas_module.fillRect(canvas, app.SIDEBAR, top, width - app.SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    const small = app.smallOf(files)
    // The path: the parts to click on.
    var x = app.SIDEBAR + 12
    var index: usize = 0
    const count = crumbCount(files)
    while index < count {
        var end: usize = 0
        const label = crumb(files, index, &end)
        const w = canvas_module.measure(small, label)
        if files.*.hover == app.HIT_CRUMB + index { canvas_module.fillRoundedRect(canvas, x - 5, top + 5, w + 10, app.STATUS - 10, 6, canvas_module.color(255, 52, 56, 68)) }
        canvas_module.drawText(canvas, small, label, x, top + 8, if index + 1 == count { TEXT_COLOR } else { DIM_COLOR }, 0)
        x += w
        if index + 1 < count {
            canvas_module.drawChevron(canvas, x + 8, top + 11, false, DIM_COLOR, 9, 2)
        }
        x += 22
        index += 1
    }
    // How many, or a note.
    var buffer: [160]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    var length: usize = 0
    var color = DIM_COLOR
    if files.*.noteLength > 0 {
        length = writeText(text, 0, app.noteText(files))
        color = canvas_module.color(255, 240, 160, 90)
    } else {
        const selected = input_module.selectedCount(files)
        if selected > 0 {
            length = writeNumber(text, 0, selected)
            length = writeText(text, length, app.say(files, " of ", " von "))
            length = writeNumber(text, length, files.*.shownCount)
            length = writeText(text, length, app.say(files, " selected", " ausgewählt"))
        } else {
            length = writeNumber(text, 0, files.*.shownCount)
            length = writeText(text, length, if files.*.shownCount == 1 { app.say(files, " item", " Objekt") } else { app.say(files, " items", " Objekte") })
            var disk: std.fs.FileSystemStat = undefined
            if !files.*.inTrash && std.fs.fileSystemStatus(folder_module.listedPath(files), &disk) == 0 {
                length = writeText(text, length, ", ")
                length = formatSize(files, @intCast(isize, disk.blocksAvailable) * disk.blockSize, text, length)
                length = writeText(text, length, app.say(files, " available", " verfügbar"))
            }
        }
    }
    const shown = text[0..length]
    const w = canvas_module.measure(small, shown)
    if x + 20 < width - 14 - w { canvas_module.drawText(canvas, small, shown, width - 14 - w, top + 8, color, 0) }
}

// Entry `index`'s icon in a `size` square at (x, y): its picture, a folder
// or a page; `faded` while cut.
pub fn drawEntryIcon(files: *app.Files, canvas: *app.Canvas, index: usize, x: i32, y: i32, size: i32, allow_thumb: bool) -> void {
    const entry = app.entryAt(files, index)
    const name = app.nameOf(files, entry)
    if entry.*.directory {
        icons.drawFolder(app.smallOf(files), canvas, name, x, y, size)
        return
    }
    if allow_thumb {
        const thumb = findThumb(files, index)
        if thumb != null {
            const image = thumb.?
            const w = @intCast(i32, image.*.width)
            canvas_module.drawImage(canvas, image, x + (size - w) / 2, y + (size - w) / 2, w, 255)
            return
        }
    }
    icons.drawFile(app.smallOf(files), canvas, name, x, y, size)
}

// A picture already read (drawDragIcon draws outside a frame).
fn findThumb(files: *app.Files, index: usize) -> ?*png.Image {
    var slot: usize = 0
    while slot < app.THUMBS {
        if files.*.thumbEntry[slot] == index && files.*.thumbState[slot] == 1 { return app.thumbAt(files, slot) }
        slot += 1
    }
    return null
}

// Whether the path of an entry was cut (it shows faded until pasted).
fn isCut(files: *app.Files, index: usize) -> bool {
    if !files.*.clipCut || files.*.clipCount == 0 { return false }
    var path: app.Path = undefined
    app.entryPath(files, index, &path)
    const clip = app.fieldBytes(files, @offsetOf(app.Files, "clip"))
    var at: usize = 0
    while at < files.*.clipLength {
        var end = at
        while clip[end] != 0 { end += 1 }
        if std.text.same(clip[at..end], app.pathText(&path)) { return true }
        at = end + 1
    }
    return false
}

// The field renaming an entry: the name typed, the caret.
fn drawEditor(files: *app.Files, canvas: *app.Canvas, x: i32, y: i32, width: i32, height: i32) -> void {
    const body = app.bodyOf(files)
    canvas_module.fillRoundedRect(canvas, x - 2, y - 2, width + 4, height + 4, 6, ACCENT)
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 5, canvas_module.color(255, 22, 24, 30))
    const text = app.editText(files)
    // Scrolled so the caret shows.
    const caret_at = canvas_module.measure(body, text[0..files.*.caret])
    var shift: i32 = 0
    if caret_at > width - 12 { shift = caret_at - (width - 12) }
    if files.*.editSelected { canvas_module.fillRect(canvas, x + 5 - shift, y + 3, caret_at, height - 6, canvas_module.color(255, 50, 90, 150)) }
    canvas_module.drawText(canvas, body, text, x + 5 - shift, y + (height - 16) / 2, TEXT_COLOR, width - 8 + shift)
    canvas_module.fillRect(canvas, x + 5 - shift + caret_at, y + 3, 2, height - 6, ACCENT)
}

fn drawGrid(files: *app.Files, canvas: *app.Canvas) -> void {
    const small = app.smallOf(files)
    const body = app.bodyOf(files)
    const top = contentTop(files)
    const bottom = contentBottom(files)
    const cell = cellWidth(files)
    var budget: usize = 12
    var index: usize = 0
    while index < files.*.shownCount {
        const x = itemX(files, index)
        const y = itemY(files, index)
        if y + app.CELL_HEIGHT > top && y < bottom {
            const at = files.*.shown[index]
            const entry = app.entryAt(files, at)
            const icon_x = x + (cell - app.GRID_ICON) / 2
            const icon_y = y + 6
            const drop_here = files.*.dropHover == at
            if entry.*.selected || drop_here {
                canvas_module.fillRoundedRect(canvas, icon_x - 6, icon_y - 4, app.GRID_ICON + 12, app.GRID_ICON + 8, 9, canvas_module.color(255, 58, 62, 76))
            } else if files.*.hover == index {
                canvas_module.fillRoundedRect(canvas, icon_x - 6, icon_y - 4, app.GRID_ICON + 12, app.GRID_ICON + 8, 9, canvas_module.color(255, 42, 45, 56))
            }
            if !entry.*.directory { const thumb = folder_module.thumbOf(files, at, app.GRID_ICON, &budget) }
            drawEntryIcon(files, canvas, at, icon_x, icon_y, app.GRID_ICON, true)
            if isCut(files, at) { canvas_module.fillRect(canvas, icon_x, icon_y, app.GRID_ICON, app.GRID_ICON, canvas_module.color(150, 30, 32, 40)) }
            const name_y = icon_y + app.GRID_ICON + 8
            if files.*.editing == at {
                drawEditor(files, canvas, x + 4, name_y - 3, cell - 8, 22)
            } else {
                var buffer: [100]u8 = undefined
                var bytes: [*]u8 = undefined
                unsafe { bytes = @ptrCast([*]u8, &buffer) }
                const name = icons.fitText(small, app.nameOf(files, entry), cell - 12, bytes)
                const w = canvas_module.measure(small, name)
                const name_x = x + (cell - w) / 2
                if entry.*.selected { canvas_module.fillRoundedRect(canvas, name_x - 5, name_y - 2, w + 10, 18, 6, ACCENT) }
                canvas_module.drawText(canvas, small, name, name_x, name_y, if entry.*.hidden && !entry.*.selected { DIM_COLOR } else { TEXT_COLOR }, 0)
            }
        }
        index += 1
    }
}

fn drawListHeader(files: *app.Files, canvas: *app.Canvas) -> void {
    const width = surfaceWidth(files)
    const small = app.smallOf(files)
    canvas_module.fillRect(canvas, app.SIDEBAR, app.TOOLBAR, width - app.SIDEBAR, app.HEADER, BACKGROUND)
    canvas_module.fillRect(canvas, app.SIDEBAR + 8, app.TOOLBAR + app.HEADER - 1, width - app.SIDEBAR - 16, 1, canvas_module.color(255, 52, 56, 66))
    const y = app.TOOLBAR + 7
    drawColumnTitle(files, canvas, app.say(files, "Name", "Name"), app.SIDEBAR + 44, y, app.SORT_NAME, false)
    if dateColumn(files) > 0 { drawColumnTitle(files, canvas, app.say(files, "Date Modified", "Änderungsdatum"), dateColumn(files), y, app.SORT_DATE, false) }
    if sizeColumnRight(files) > 0 { drawColumnTitle(files, canvas, app.say(files, "Size", "Größe"), sizeColumnRight(files), y, app.SORT_SIZE, true) }
    if kindColumn(files) > 0 { drawColumnTitle(files, canvas, app.say(files, "Kind", "Art"), kindColumn(files), y, app.SORT_KIND, false) }
}

// A column's title (right-aligned at x for `right`), with a triangle when
// the list is sorted by it.
fn drawColumnTitle(files: *app.Files, canvas: *app.Canvas, title: []const u8, x: i32, y: i32, key: usize, right: bool) -> void {
    const small = app.smallOf(files)
    const w = canvas_module.measure(small, title)
    const left = if right { x - w } else { x }
    const sorted = files.*.sortKey == key
    canvas_module.drawText(canvas, small, title, left, y, if sorted { TEXT_COLOR } else { DIM_COLOR }, 0)
    if !sorted { return }
    // Down for the usual order, up reversed.
    const tip_x = if right { left - 12 } else { left + w + 6 }
    var row: i32 = 0
    while row < 4 {
        const half = if files.*.sortReversed { row } else { 3 - row }
        canvas_module.fillRect(canvas, tip_x + 3 - half, y + 5 + row, half * 2 + 1, 1, DIM_COLOR)
        row += 1
    }
}

fn drawList(files: *app.Files, canvas: *app.Canvas) -> void {
    const width = surfaceWidth(files)
    const small = app.smallOf(files)
    const body = app.bodyOf(files)
    const top = contentTop(files)
    const bottom = contentBottom(files)
    const name_x = app.SIDEBAR + 44
    const limit = nameLimit(files)
    var index: usize = 0
    var buffer: [160]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    const today = localDay(files, clock.now())
    while index < files.*.shownCount {
        const y = itemY(files, index)
        if y + app.ROW > top && y < bottom {
            const at = files.*.shown[index]
            const entry = app.entryAt(files, at)
            const selected = entry.*.selected
            if selected {
                canvas_module.fillRoundedRect(canvas, app.SIDEBAR + 8, y, width - app.SIDEBAR - 16, app.ROW, 6, if files.*.searchFocused { canvas_module.color(255, 70, 76, 92) } else { ACCENT })
            } else if files.*.dropHover == at {
                canvas_module.fillRoundedRect(canvas, app.SIDEBAR + 8, y, width - app.SIDEBAR - 16, app.ROW, 6, canvas_module.color(255, 58, 62, 76))
            } else if index % 2 == 1 {
                canvas_module.fillRoundedRect(canvas, app.SIDEBAR + 8, y, width - app.SIDEBAR - 16, app.ROW, 6, canvas_module.color(255, 35, 37, 46))
            }
            drawEntryIcon(files, canvas, at, app.SIDEBAR + 18, y + (app.ROW - app.LIST_ICON) / 2, app.LIST_ICON, false)
            if isCut(files, at) { canvas_module.fillRect(canvas, app.SIDEBAR + 18, y + (app.ROW - app.LIST_ICON) / 2, app.LIST_ICON, app.LIST_ICON, canvas_module.color(150, 30, 32, 40)) }
            const color = if selected { canvas_module.color(255, 255, 255, 255) } else if entry.*.hidden { DIM_COLOR } else { TEXT_COLOR }
            const dim = if selected { canvas_module.color(255, 225, 235, 255) } else { DIM_COLOR }
            if files.*.editing == at {
                drawEditor(files, canvas, name_x - 4, y + 2, limit, app.ROW - 4)
            } else {
                var name_buffer: [100]u8 = undefined
                var name_bytes: [*]u8 = undefined
                unsafe { name_bytes = @ptrCast([*]u8, &name_buffer) }
                canvas_module.drawText(canvas, body, icons.fitText(body, app.nameOf(files, entry), limit, name_bytes), name_x, y + 5, color, 0)
            }
            if dateColumn(files) > 0 {
                const modified = @intCast(i64, entry.*.modified)
                const time = clock.civil(modified + clock.offsetAt(app.zoneOf(files), modified))
                const length = clock.formatDate(&time, today - clock.daysFromCivil(time.year, time.month, time.day), files.*.german, text)
                canvas_module.drawText(canvas, small, text[0..length], dateColumn(files), y + 6, dim, 0)
            }
            if sizeColumnRight(files) > 0 {
                var length: usize = 0
                if entry.*.directory {
                    length = writeText(text, 0, "--")
                } else {
                    length = formatSize(files, entry.*.size, text, 0)
                }
                const shown = text[0..length]
                canvas_module.drawText(canvas, small, shown, sizeColumnRight(files) - canvas_module.measure(small, shown), y + 6, dim, 0)
            }
            if kindColumn(files) > 0 {
                const length = kindOf(files, entry, text)
                canvas_module.drawText(canvas, small, text[0..length], kindColumn(files), y + 6, dim, width - kindColumn(files) - 16)
            }
        }
        index += 1
    }
}

// The day number of a moment in the local time zone.
fn localDay(files: *app.Files, utc: i64) -> i64 {
    const time = clock.civil(utc + clock.offsetAt(app.zoneOf(files), utc))
    return clock.daysFromCivil(time.year, time.month, time.day)
}

// A thin bar at the right while there is more to scroll to.
fn drawScrollbar(files: *app.Files, canvas: *app.Canvas) -> void {
    const most = maxScroll(files)
    if most <= 0 { return }
    const top = contentTop(files) + 4
    const view = contentBottom(files) - 4 - top
    const total = contentHeight(files)
    var thumb = view * view / total
    if thumb < 30 { thumb = 30 }
    const y = top + (view - thumb) * files.*.scroll / most
    canvas_module.fillRoundedRect(canvas, surfaceWidth(files) - 9, y, 5, thumb, 3, canvas_module.color(110, 200, 205, 215))
}

pub fn draw(context: *anyopaque, canvas: *app.Canvas) -> void {
    const files = app.filesOf(context)
    const width = surfaceWidth(files)
    const height = surfaceHeight(files)
    canvas_module.clear(canvas, 0)
    canvas_module.fillRect(canvas, app.SIDEBAR, 0, width - app.SIDEBAR, height, BACKGROUND)
    // The files first: the bars are drawn over what scrolls under them.
    if files.*.unreadable {
        const message = app.say(files, "This folder can't be read", "Dieser Ordner kann nicht gelesen werden")
        canvas_module.drawText(canvas, app.bodyOf(files), message, app.SIDEBAR + (width - app.SIDEBAR - canvas_module.measure(app.bodyOf(files), message)) / 2, contentTop(files) + 60, DIM_COLOR, 0)
    } else if files.*.shownCount == 0 {
        const message = if files.*.searchLength > 0 { app.say(files, "No matches", "Keine Treffer") } else if files.*.inTrash { app.say(files, "The trash is empty", "Der Papierkorb ist leer") } else { app.say(files, "This folder is empty", "Dieser Ordner ist leer") }
        canvas_module.drawText(canvas, app.bodyOf(files), message, app.SIDEBAR + (width - app.SIDEBAR - canvas_module.measure(app.bodyOf(files), message)) / 2, contentTop(files) + 60, DIM_COLOR, 0)
    } else if files.*.listView {
        drawList(files, canvas)
    } else {
        drawGrid(files, canvas)
    }
    // Files dragged over the folder itself.
    if files.*.dropping && files.*.dropHover == app.NONE && !files.*.inTrash {
        canvas_module.strokeRoundedRect(canvas, app.SIDEBAR + 3, app.TOOLBAR + 3, width - app.SIDEBAR - 6, height - app.TOOLBAR - app.STATUS - 6, 8, 2, ACCENT)
    }
    // The selecting rectangle.
    if files.*.pressed && files.*.banding {
        const left = if files.*.pressX < files.*.pointerX { files.*.pressX } else { files.*.pointerX }
        const top = if files.*.pressY < files.*.pointerY { files.*.pressY } else { files.*.pointerY }
        const w = if files.*.pressX < files.*.pointerX { files.*.pointerX - files.*.pressX } else { files.*.pressX - files.*.pointerX }
        const h = if files.*.pressY < files.*.pointerY { files.*.pointerY - files.*.pressY } else { files.*.pressY - files.*.pointerY }
        canvas_module.fillRect(canvas, left, top, w, h, canvas_module.color(50, 90, 160, 255))
        canvas_module.strokeRoundedRect(canvas, left, top, w, h, 0, 1, canvas_module.color(200, 90, 160, 255))
    }
    drawScrollbar(files, canvas)
    if files.*.listView { drawListHeader(files, canvas) }
    drawToolbar(files, canvas)
    drawStatus(files, canvas)
    drawSidebar(files, canvas)
}
