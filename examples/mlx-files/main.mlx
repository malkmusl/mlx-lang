// The file manager of the Mlx desktop, laid out like the Finder of macOS:
// a translucent sidebar with the places (home, the XDG folders such as
// Downloads, the computer, the trash), a toolbar with back and forward,
// the folder's name, grid or list view and a search field, the folder's
// files as icons or as a list (name, date modified, size, kind; a click on
// a column sorts by it), and a status bar with the path and how many items
// there are. Folders come first and names sort as people count
// ("File 2" before "File 10").
//
//   mlx-files [PATH | file:///PATH | trash:///]
//
// A click selects (Ctrl adds, Shift a range, dragging over empty space
// selects what the rectangle touches), a double click or Enter opens: a
// folder here, a file with its app (xdg-open). The keyboard: the arrows,
// Home, End, Page Up/Down move, typing jumps to a name, Backspace or
// Alt+Left goes back, Alt+Right forward, Alt+Up to the parent, F2
// renames, Ctrl+Shift+N makes a folder, Delete moves to the trash,
// Ctrl+C/X/V copy, cut and paste (within the file manager), Ctrl+A selects
// all, Ctrl+F searches, Ctrl+H shows hidden files, Ctrl+1/2 switch the
// view, F5 reloads, Ctrl+W closes. A right click offers the same. Files
// dragged out go as text/uri-list (onto the dock's trash, another folder,
// other apps); files dropped in are copied here (onto a folder: into it),
// the file manager's own ones moved. A folder that changes is read again
// within a second. Dates and labels follow the locale (German or English).
const std = @import("std")
const png = @import("std.png")
const apps_module = @import("../desktop-shared/apps.mlx")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const panel_module = @import("../desktop-shared/panel.mlx")
const menu_module = @import("../desktop-shared/menu.mlx")
const places = @import("../desktop-shared/places.mlx")
const pins_module = @import("../desktop-shared/pins.mlx")
const icons = @import("../desktop-shared/icons.mlx")
const clock = @import("../desktop-shared/clock.mlx")
const crash = @import("../wayland-compositor/crash.mlx")

const Canvas = canvas_module.Canvas
const Text = canvas_module.Text
const Panel = panel_module.Panel
const Path = apps_module.Path

const WIDTH: i32 = 940
const HEIGHT: i32 = 580
const MIN_WIDTH: i32 = 560
const MIN_HEIGHT: i32 = 340
const SIDEBAR: i32 = 200
const TOOLBAR: i32 = 52
const STATUS: i32 = 30
const HEADER: i32 = 28
const ROW: i32 = 26
const LIST_ICON: i32 = 18
const CELL_WIDTH: i32 = 104
const CELL_HEIGHT: i32 = 104
const GRID_ICON: i32 = 56
const GRID_PADDING: i32 = 14
const PLACE_ROW: i32 = 28
const SEARCH_WIDTH: i32 = 190
const BUTTON: i32 = 30

const NONE: usize = 1 << 40
const BUTTON_LEFT: u32 = 272
const BUTTON_RIGHT: u32 = 273

// What a point is over: an item (its index among those shown), or one of
// these.
const HIT_PLACE: usize = 1 << 31
const HIT_CRUMB: usize = 1 << 32
const HIT_COLUMN: usize = 1 << 33
const HIT_BACK: usize = 1 << 34
const HIT_FORWARD: usize = HIT_BACK + 1
const HIT_GRID: usize = HIT_BACK + 2
const HIT_LIST: usize = HIT_BACK + 3
const HIT_SEARCH: usize = HIT_BACK + 4
const HIT_EMPTY_TRASH: usize = HIT_BACK + 5
const HIT_CONTENT: usize = HIT_BACK + 6
const HIT_SIDEBAR: usize = HIT_BACK + 7

// A folder's entries: at most MAX_ENTRIES, their names in one buffer.
const MAX_ENTRIES: usize = 16384
const NAMES: usize = 2097152
const HISTORY: usize = 32
const MAX_PLACES: usize = 10
const THUMBS: usize = 96
const THUMB_BYTES: isize = 16777216
const CLIP: usize = 16384
const EDIT: usize = 255
const SEARCH: usize = 64
const SCRIPT: usize = 32768

// Sort keys (the list's columns).
const SORT_NAME: usize = 0
const SORT_DATE: usize = 1
const SORT_SIZE: usize = 2
const SORT_KIND: usize = 3

// Places.
const PLACE_HOME: u8 = 0
const PLACE_FOLDER: u8 = 1
const PLACE_COMPUTER: u8 = 2
const PLACE_TRASH: u8 = 3

// What a menu entry does.
const MENU_OPEN: u32 = 0
const MENU_RENAME: u32 = 1
const MENU_TRASH: u32 = 2
const MENU_COPY: u32 = 3
const MENU_CUT: u32 = 4
const MENU_PASTE: u32 = 5
const MENU_NEW_FOLDER: u32 = 6
const MENU_TERMINAL: u32 = 7
const MENU_HIDDEN: u32 = 8
const MENU_RESTORE: u32 = 9
const MENU_DELETE: u32 = 10
const MENU_EMPTY_TRASH: u32 = 11
const MENU_DOCK: u32 = 12
const MENU_SORT: u32 = 13
const MENU_VIEW: u32 = 14

// Keys (evdev).
const KEY_ESCAPE: u32 = 1
const KEY_1: u32 = 2
const KEY_2: u32 = 3
const KEY_BACKSPACE: u32 = 14
const KEY_W: u32 = 17
const KEY_ENTER: u32 = 28
const KEY_A: u32 = 30
const KEY_F: u32 = 33
const KEY_H: u32 = 35
const KEY_X: u32 = 45
const KEY_C: u32 = 46
const KEY_V: u32 = 47
const KEY_N: u32 = 49
const KEY_F2: u32 = 60
const KEY_F5: u32 = 63
const KEY_KP_ENTER: u32 = 96
const KEY_HOME: u32 = 102
const KEY_UP: u32 = 103
const KEY_PAGE_UP: u32 = 104
const KEY_LEFT: u32 = 105
const KEY_RIGHT: u32 = 106
const KEY_END: u32 = 107
const KEY_DOWN: u32 = 108
const KEY_PAGE_DOWN: u32 = 109
const KEY_DELETE: u32 = 111

// Modifiers (the compositor's keymap: wl_keyboard.modifiers).
const SHIFT: u32 = 1
const CONTROL: u32 = 4
const ALT: u32 = 8

const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_getdents64: usize = 217
const O_DIRECTORY: usize = 65536
const O_CLOEXEC: usize = 524288

const Entry = struct {
    // Where its name is in the names buffer.
    name: usize
    nameLength: usize
    size: isize
    modified: isize
    directory: bool
    link: bool
    executable: bool
    hidden: bool
    selected: bool
}

const Files = struct {
    panel: Panel
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    terminal: [*]const u8
    german: bool
    zone: clock.Zone
    // The folder shown (the trash's files directory for the trash), and
    // what its directory looked like when read (see refresh).
    path: Path
    inTrash: bool
    unreadable: bool
    changedSeconds: isize
    changedNanoseconds: isize
    lastCheck: usize
    // Its entries (entries, names), sorted (order), and those shown after
    // the hidden ones and the search are left out (shown: indices into
    // entries).
    entries: [*]Entry
    names: [*]u8
    namesUsed: usize
    count: usize
    order: [*]usize
    scratch: [*]usize
    shown: [*]usize
    shownCount: usize
    // Where we were and where Back came from.
    back: [32]Path
    backCount: usize
    forward: [32]Path
    forwardCount: usize
    // The view.
    listView: bool
    showHidden: bool
    sortKey: usize
    sortReversed: bool
    scroll: i32
    // The selection: the entry the keyboard is at (NONE: none), and where
    // a Shift range starts.
    cursor: usize
    anchor: usize
    // The pointer, what it is over, a press (where, on what, whether it
    // became a drag or a selecting rectangle), and the last click (for
    // double clicks).
    pointerX: i32
    pointerY: i32
    hover: usize
    pressed: bool
    pressX: i32
    pressY: i32
    pressHit: usize
    pressKeep: bool
    dragging: bool
    banding: bool
    bandBase: [*]bool
    lastClick: usize
    lastClickHit: usize
    // A drag of files over the window: the folder entry under it (NONE:
    // the folder shown), and whether one is over us.
    dropHover: usize
    dropping: bool
    // Renaming (editing: the entry, NONE: not renaming): the name typed
    // and the caret in it.
    editing: usize
    edit: [256]u8
    editLength: usize
    caret: usize
    // The name before its extension is selected (typing replaces it).
    editSelected: bool
    // The search field.
    searchFocused: bool
    search: [64]u8
    searchLength: usize
    // Typing jumps to names: what was typed lately and when.
    typed: [32]u8
    typedLength: usize
    typedAt: usize
    // Copied or cut paths (NUL after each).
    clip: [16384]u8
    clipLength: usize
    clipCount: usize
    clipCut: bool
    // The sidebar.
    placeKinds: [10]u8
    placePaths: [10]Path
    placeCount: usize
    // The right-click menu and what it is for (an entry, NONE: the folder).
    menu: menu_module.Menu
    menuOpen: bool
    menuEntry: usize
    // Pictures of PNG files in the grid: which entry each slot holds and
    // its state (0 free, 1 read, 2 none), and the next slot to reuse.
    thumbs: [96]png.Image
    thumbEntry: [96]usize
    thumbState: [96]u8
    thumbNext: usize
    thumbsPending: bool
    // A note in the status bar (an error) until noteUntil.
    note: [160]u8
    noteLength: usize
    noteUntil: usize
    // Names kept across a reload (the selection; NUL after each).
    keep: [8192]u8
    keepLength: usize
    keepCursor: [256]u8
    keepCursorLength: usize
    // Modifier keys held (see modifiers).
    held: u32
    body: Text
    small: Text
    title: Text
}

// ---------------------------------------------------------------------------
// Access

fn filesOf(context: *anyopaque) -> *Files {
    unsafe { return @ptrCast(*Files, context) }
}

fn panelOf(files: *Files) -> *Panel {
    unsafe { return @ptrCast(*Panel, &files.*.panel) }
}

fn zoneOf(files: *Files) -> *clock.Zone {
    unsafe { return @ptrCast(*clock.Zone, &files.*.zone) }
}

fn pathOf(files: *Files) -> *Path {
    unsafe { return @ptrCast(*Path, &files.*.path) }
}

fn menuOf(files: *Files) -> *menu_module.Menu {
    unsafe { return @ptrCast(*menu_module.Menu, &files.*.menu) }
}

fn bodyOf(files: *Files) -> *Text {
    unsafe { return @ptrCast(*Text, &files.*.body) }
}

fn smallOf(files: *Files) -> *Text {
    unsafe { return @ptrCast(*Text, &files.*.small) }
}

fn titleOf(files: *Files) -> *Text {
    unsafe { return @ptrCast(*Text, &files.*.title) }
}

fn fieldBytes(files: *Files, field: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(files) + field) }
}

fn backAt(files: *Files, index: usize) -> *Path {
    unsafe { return @ptrFromInt(*Path, @intFromPtr(files) + @offsetOf(Files, "back") + index * @sizeOf(Path)) }
}

fn forwardAt(files: *Files, index: usize) -> *Path {
    unsafe { return @ptrFromInt(*Path, @intFromPtr(files) + @offsetOf(Files, "forward") + index * @sizeOf(Path)) }
}

fn placePathAt(files: *Files, index: usize) -> *Path {
    unsafe { return @ptrFromInt(*Path, @intFromPtr(files) + @offsetOf(Files, "placePaths") + index * @sizeOf(Path)) }
}

fn thumbAt(files: *Files, slot: usize) -> *png.Image {
    unsafe { return @ptrFromInt(*png.Image, @intFromPtr(files) + @offsetOf(Files, "thumbs") + slot * @sizeOf(png.Image)) }
}

fn entryAt(files: *Files, index: usize) -> *Entry {
    unsafe { return @ptrFromInt(*Entry, @intFromPtr(files.*.entries) + index * @sizeOf(Entry)) }
}

fn nameOf(files: *Files, entry: *const Entry) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(files.*.names) + entry.*.name) }
    return bytes[0..entry.*.nameLength]
}

fn editText(files: *Files) -> []const u8 { return fieldBytes(files, @offsetOf(Files, "edit"))[0..files.*.editLength] }
fn searchText(files: *Files) -> []const u8 { return fieldBytes(files, @offsetOf(Files, "search"))[0..files.*.searchLength] }
fn noteText(files: *Files) -> []const u8 { return fieldBytes(files, @offsetOf(Files, "note"))[0..files.*.noteLength] }

fn pathText(path: *Path) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, path) }
    return bytes[0..path.*.length]
}

fn copyPath(target: *Path, source: *Path) -> void {
    apps_module.pathClear(target)
    apps_module.pathAdd(target, pathText(source))
}

fn noString() -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

// The label in the locale's language.
fn say(files: *Files, english: []const u8, german: []const u8) -> []const u8 {
    return if files.*.german { german } else { english }
}

fn sameBytes(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// The modifiers held: what the compositor says (wl_keyboard.modifiers)
// and the modifier keys seen pressed (for compositors that say little).
fn modifiers(files: *Files) -> u32 { return panelOf(files).*.keyboard.depressed | files.*.held }

fn trackModifier(files: *Files, code: u32, pressed: bool) -> void {
    var bit: u32 = 0
    if code == 42 || code == 54 { bit = SHIFT }
    if code == 29 || code == 97 { bit = CONTROL }
    if code == 56 || code == 100 { bit = ALT }
    if bit == 0 { return }
    files.*.held = if pressed { files.*.held | bit } else { files.*.held & ~bit }
}

// A note in the status bar for four seconds.
fn setNote(files: *Files, first: []const u8, second: []const u8) -> void {
    var length: usize = 0
    for byte in first {
        if length < 160 {
            files.*.note[length] = byte
            length += 1
        }
    }
    for byte in second {
        if length < 160 {
            files.*.note[length] = byte
            length += 1
        }
    }
    files.*.noteLength = length
    files.*.noteUntil = panel_module.milliseconds() + 4000
}

// ---------------------------------------------------------------------------
// Paths

// The path of entry `index` into `into`.
fn entryPath(files: *Files, index: usize, into: *Path) -> void {
    copyPath(into, pathOf(files))
    if into.*.length == 0 || into.*.bytes[into.*.length - 1] != 47 { apps_module.pathAdd(into, "/") }
    apps_module.pathAdd(into, nameOf(files, entryAt(files, index)))
}

// `path` without its last part ("/" stays "/").
fn parentOf(path: *Path) -> void {
    var end = path.*.length
    while end > 1 && path.*.bytes[end - 1] == 47 { end -= 1 }
    while end > 0 && path.*.bytes[end - 1] != 47 { end -= 1 }
    while end > 1 && path.*.bytes[end - 1] == 47 { end -= 1 }
    if end == 0 { end = 1 }
    path.*.length = end
    path.*.bytes[0] = 47
}

fn homeOf(files: *Files) -> [*]const u8 { return apps_module.environmentValue(files.*.environment, "HOME") }

fn homeLength(files: *Files) -> usize {
    const home = homeOf(files)
    if @intFromPtr(home) == 0 { return 0 }
    var length: usize = 0
    while home[length] != 0 { length += 1 }
    while length > 1 && home[length - 1] == 47 { length -= 1 }
    return length
}

// Whether `path` is $HOME or inside it.
fn underHome(files: *Files, path: []const u8) -> bool {
    const length = homeLength(files)
    if length == 0 || path.length < length { return false }
    const home = homeOf(files)
    if !sameBytes(path[0..length], home[0..length]) { return false }
    return path.length == length || path[length] == 47
}

// ---------------------------------------------------------------------------
// Reading a folder

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

// Names compared as people read them: letters in any case, runs of digits
// by their value. Negative, 0 or positive.
fn compareNames(first: []const u8, second: []const u8) -> i32 {
    var i: usize = 0
    var j: usize = 0
    while i < first.length && j < second.length {
        if isDigit(first[i]) && isDigit(second[j]) {
            var end_i = i
            while end_i < first.length && isDigit(first[end_i]) { end_i += 1 }
            var end_j = j
            while end_j < second.length && isDigit(second[end_j]) { end_j += 1 }
            var start_i = i
            while start_i + 1 < end_i && first[start_i] == 48 { start_i += 1 }
            var start_j = j
            while start_j + 1 < end_j && second[start_j] == 48 { start_j += 1 }
            if end_i - start_i != end_j - start_j { return if end_i - start_i < end_j - start_j { -1 } else { 1 } }
            while start_i < end_i {
                if first[start_i] != second[start_j] { return if first[start_i] < second[start_j] { -1 } else { 1 } }
                start_i += 1
                start_j += 1
            }
            i = end_i
            j = end_j
        } else {
            const a = lower(first[i])
            const b = lower(second[j])
            if a != b { return if a < b { -1 } else { 1 } }
            i += 1
            j += 1
        }
    }
    const rest_i = first.length - i
    const rest_j = second.length - j
    if rest_i != rest_j { return if rest_i < rest_j { -1 } else { 1 } }
    // The same but for case: the bytes decide.
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return if first[index] < second[index] { -1 } else { 1 } }
        index += 1
    }
    return 0
}

// The extension of a name ("png"), empty without one.
fn extensionOf(name: []const u8) -> []const u8 {
    var dot = name.length
    while dot > 1 && name[dot - 1] != 46 { dot -= 1 }
    if dot <= 1 { return name[0..0] }
    return name[dot..name.length]
}

// Whether entry `a` goes before entry `b`: folders first, then by the sort
// key (names for the rest).
fn before(files: *Files, a: usize, b: usize) -> bool {
    const first = entryAt(files, a)
    const second = entryAt(files, b)
    if first.*.directory != second.*.directory { return first.*.directory }
    var order: i32 = 0
    if files.*.sortKey == SORT_DATE {
        if first.*.modified != second.*.modified { order = if first.*.modified > second.*.modified { -1 } else { 1 } }
    } else if files.*.sortKey == SORT_SIZE {
        if first.*.size != second.*.size { order = if first.*.size > second.*.size { -1 } else { 1 } }
    } else if files.*.sortKey == SORT_KIND {
        order = compareNames(extensionOf(nameOf(files, first)), extensionOf(nameOf(files, second)))
    }
    if order == 0 { order = compareNames(nameOf(files, first), nameOf(files, second)) }
    if files.*.sortReversed { order = -order }
    return order < 0
}

// Sorts `order` (merge sort, bottom up, through `scratch`).
fn sortEntries(files: *Files) -> void {
    const count = files.*.count
    var index: usize = 0
    while index < count {
        files.*.order[index] = index
        index += 1
    }
    var width: usize = 1
    var source = files.*.order
    var target = files.*.scratch
    while width < count {
        var start: usize = 0
        while start < count {
            const middle = if start + width < count { start + width } else { count }
            const end = if start + width * 2 < count { start + width * 2 } else { count }
            var left = start
            var right = middle
            var at = start
            while at < end {
                if left < middle && (right >= end || !before(files, source[right], source[left])) {
                    target[at] = source[left]
                    left += 1
                } else {
                    target[at] = source[right]
                    right += 1
                }
                at += 1
            }
            start = end
        }
        const swap = source
        source = target
        target = swap
        width = width * 2
    }
    if @intFromPtr(source) != @intFromPtr(files.*.order) {
        index = 0
        while index < count {
            files.*.order[index] = source[index]
            index += 1
        }
    }
}

// Which entries show: hidden ones only when asked for, and those the
// search matches.
fn buildShown(files: *Files) -> void {
    files.*.shownCount = 0
    const search = searchText(files)
    var index: usize = 0
    while index < files.*.count {
        const at = files.*.order[index]
        const entry = entryAt(files, at)
        if (!entry.*.hidden || files.*.showHidden) && apps_module.containsText(nameOf(files, entry), search) {
            files.*.shown[files.*.shownCount] = at
            files.*.shownCount += 1
        } else {
            entry.*.selected = false
        }
        index += 1
    }
    if files.*.cursor != NONE && shownIndexOf(files, files.*.cursor) == NONE { files.*.cursor = NONE }
    clampScroll(files)
}

// Where entry `entry` is among those shown, NONE when it is not.
fn shownIndexOf(files: *Files, entry: usize) -> usize {
    var index: usize = 0
    while index < files.*.shownCount {
        if files.*.shown[index] == entry { return index }
        index += 1
    }
    return NONE
}

// The directory read for the folder shown.
fn listedPath(files: *Files) -> [*]const u8 { return apps_module.pathEnd(pathOf(files)) }

// Its modification time now (entries added, removed or renamed change it).
fn directoryChanged(files: *Files) -> bool {
    var status: std.fs.Stat = undefined
    if std.fs.status(listedPath(files), &status) != 0 { return files.*.changedSeconds != -1 }
    return status.modifiedSeconds != files.*.changedSeconds || status.modifiedNanoseconds != files.*.changedNanoseconds
}

// Reads the folder again.
fn load(files: *Files) -> void {
    files.*.count = 0
    files.*.namesUsed = 0
    files.*.unreadable = false
    dropThumbs(files)
    var status: std.fs.Stat = undefined
    files.*.changedSeconds = -1
    files.*.changedNanoseconds = 0
    if std.fs.status(listedPath(files), &status) == 0 {
        files.*.changedSeconds = status.modifiedSeconds
        files.*.changedNanoseconds = status.modifiedNanoseconds
    }
    const handle = std.linux.syscall3(SYS_open, @intFromPtr(listedPath(files)), O_DIRECTORY | O_CLOEXEC, 0)
    if handle < 0 {
        files.*.unreadable = true
        buildShown(files)
        return
    }
    const directory = std.fs.File.{ .descriptor = handle }
    var buffer: [16384]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var full = false
    while !full {
        const count = std.linux.syscall3(SYS_getdents64, @bitCast(usize, handle), @intFromPtr(bytes), 16384)
        if count <= 0 { break }
        var offset: usize = 0
        while offset < @bitCast(usize, count) {
            const record_length = @intCast(usize, bytes[offset + 16]) | (@intCast(usize, bytes[offset + 17]) << 8)
            const kind = bytes[offset + 18]
            var name: [*]const u8 = undefined
            unsafe { name = @ptrFromInt([*]const u8, @intFromPtr(bytes) + offset + 19) }
            var length: usize = 0
            while name[length] != 0 { length += 1 }
            const dots = (length == 1 && name[0] == 46) || (length == 2 && name[0] == 46 && name[1] == 46)
            if !dots && length > 0 {
                if files.*.count >= MAX_ENTRIES || files.*.namesUsed + length > NAMES {
                    full = true
                } else {
                    const entry = entryAt(files, files.*.count)
                    entry.*.name = files.*.namesUsed
                    entry.*.nameLength = length
                    var byte: usize = 0
                    while byte < length {
                        files.*.names[files.*.namesUsed + byte] = name[byte]
                        byte += 1
                    }
                    files.*.namesUsed += length
                    entry.*.hidden = name[0] == 46
                    entry.*.selected = false
                    entry.*.link = kind == 10
                    entry.*.size = 0
                    entry.*.modified = 0
                    entry.*.directory = kind == 4
                    entry.*.executable = false
                    var found = std.fs.statusFrom(directory, name, &status, false) == 0
                    if !found { found = std.fs.statusFrom(directory, name, &status, true) == 0 }
                    if found {
                        entry.*.directory = status.mode & 61440 == 16384
                        entry.*.executable = !entry.*.directory && status.mode & 73 != 0
                        entry.*.size = status.size
                        entry.*.modified = status.modifiedSeconds
                    }
                    files.*.count += 1
                }
            }
            if record_length == 0 { break }
            offset += record_length
        }
    }
    const closed = std.fs.close(directory)
    sortEntries(files)
    buildShown(files)
}

// Reads the folder again keeping the selection and the cursor (by name).
fn reload(files: *Files) -> void {
    files.*.keepLength = 0
    files.*.keepCursorLength = 0
    var index: usize = 0
    while index < files.*.count {
        const entry = entryAt(files, index)
        const name = nameOf(files, entry)
        if entry.*.selected && files.*.keepLength + name.length + 1 <= 8192 {
            for byte in name {
                files.*.keep[files.*.keepLength] = byte
                files.*.keepLength += 1
            }
            files.*.keep[files.*.keepLength] = 0
            files.*.keepLength += 1
        }
        if index == files.*.cursor && name.length <= 256 {
            for byte in name {
                files.*.keepCursor[files.*.keepCursorLength] = byte
                files.*.keepCursorLength += 1
            }
        }
        index += 1
    }
    const scroll = files.*.scroll
    files.*.cursor = NONE
    load(files)
    const cursor_name = fieldBytes(files, @offsetOf(Files, "keepCursor"))[0..files.*.keepCursorLength]
    const kept = fieldBytes(files, @offsetOf(Files, "keep"))
    index = 0
    while index < files.*.count {
        const entry = entryAt(files, index)
        const name = nameOf(files, entry)
        if files.*.keepCursorLength > 0 && sameBytes(name, cursor_name) { files.*.cursor = index }
        var at: usize = 0
        while at < files.*.keepLength {
            var end = at
            while kept[end] != 0 { end += 1 }
            if sameBytes(name, kept[at..end]) { entry.*.selected = true }
            at = end + 1
        }
        index += 1
    }
    files.*.anchor = files.*.cursor
    buildShown(files)
    files.*.scroll = scroll
    clampScroll(files)
}

// ---------------------------------------------------------------------------
// Pictures

fn dropThumbs(files: *Files) -> void {
    var slot: usize = 0
    while slot < THUMBS {
        if files.*.thumbState[slot] == 1 { png.deinit(thumbAt(files, slot)) }
        files.*.thumbState[slot] = 0
        files.*.thumbEntry[slot] = NONE
        slot += 1
    }
    files.*.thumbNext = 0
}

fn isPicture(name: []const u8) -> bool {
    return icons.endsWith(name, ".png") || icons.endsWith(name, ".PNG")
}

// The picture of entry `index` (a PNG file) scaled into a `size` square,
// read the first time it shows (a few each frame: `budget`), else null.
fn thumbOf(files: *Files, index: usize, size: i32, budget: *usize) -> ?*png.Image {
    var slot: usize = 0
    while slot < THUMBS {
        if files.*.thumbEntry[slot] == index {
            if files.*.thumbState[slot] == 1 { return thumbAt(files, slot) }
            return null
        }
        slot += 1
    }
    const entry = entryAt(files, index)
    if entry.*.size > THUMB_BYTES || !isPicture(nameOf(files, entry)) { return null }
    if budget.* == 0 {
        files.*.thumbsPending = true
        return null
    }
    budget.* -= 1
    slot = files.*.thumbNext
    files.*.thumbNext = (slot + 1) % THUMBS
    if files.*.thumbState[slot] == 1 { png.deinit(thumbAt(files, slot)) }
    files.*.thumbEntry[slot] = index
    files.*.thumbState[slot] = 2
    var path: Path = undefined
    entryPath(files, index, &path)
    var image: png.Image = undefined
    if png.loadFile(&image, apps_module.pathEnd(&path), files.*.allocator) != png.Status.ok { return null }
    var width = @intCast(usize, size)
    var height = @intCast(usize, size)
    if image.width > image.height { height = image.height * width / image.width } else { width = image.width * height / image.height }
    if width == 0 { width = 1 }
    if height == 0 { height = 1 }
    var scaled_image: png.Image = undefined
    const scaled = png.scale(&scaled_image, &image, width, height, files.*.allocator)
    png.deinit(&image)
    if scaled != png.Status.ok { return null }
    // Centred in a square with nothing around it (the GPU draws images
    // as squares).
    const square = @intCast(usize, size)
    const memory = files.*.allocator.alloc(square * square * 4, 16)
    if memory == null {
        png.deinit(&scaled_image)
        return null
    }
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, memory.?) }
    var cleared: usize = 0
    while cleared < square * square {
        pixels[cleared] = 0
        cleared += 1
    }
    const left = (square - width) / 2
    const top = (square - height) / 2
    var row: usize = 0
    while row < height {
        var column: usize = 0
        while column < width {
            pixels[(top + row) * square + left + column] = scaled_image.pixels[row * width + column]
            column += 1
        }
        row += 1
    }
    png.deinit(&scaled_image)
    const thumb = thumbAt(files, slot)
    thumb.*.pixels = pixels
    thumb.*.width = square
    thumb.*.height = square
    thumb.*.allocator = files.*.allocator
    files.*.thumbState[slot] = 1
    return thumb
}

// ---------------------------------------------------------------------------
// Going places

// The folder's name: its directory's, "Computer" for /, the trash's.
fn folderTitle(files: *Files) -> []const u8 {
    if files.*.inTrash { return say(files, "Trash", "Papierkorb") }
    if pathOf(files).*.length == 1 { return say(files, "Computer", "Computer") }
    return places.baseName(pathText(pathOf(files)))
}

fn setTitle(files: *Files) -> void {
    const panel = panelOf(files)
    if !panel.*.hasSurface { return }
    panel.*.toplevel.setTitle(folderTitle(files))
}

// Shows the folder `text` (the trash for `trash`), remembering where we
// were for Back when `remember`.
fn go(files: *Files, text: []const u8, trash: bool, remember: bool) -> bool {
    var target: Path = undefined
    apps_module.pathClear(&target)
    apps_module.pathAdd(&target, text)
    while target.length > 1 && target.bytes[target.length - 1] == 47 { target.length -= 1 }
    if !trash && !places.isDirectory(apps_module.pathEnd(&target)) {
        setNote(files, say(files, "Can't open ", "Kann nicht geöffnet werden: "), text)
        return false
    }
    if remember {
        if files.*.backCount == HISTORY {
            var index: usize = 1
            while index < HISTORY {
                copyPath(backAt(files, index - 1), backAt(files, index))
                index += 1
            }
            files.*.backCount -= 1
        }
        copyPath(backAt(files, files.*.backCount), pathOf(files))
        files.*.backCount += 1
        files.*.forwardCount = 0
    }
    copyPath(pathOf(files), &target)
    files.*.inTrash = trash
    files.*.cursor = NONE
    files.*.anchor = NONE
    files.*.scroll = 0
    files.*.editing = NONE
    files.*.searchLength = 0
    files.*.searchFocused = false
    load(files)
    setTitle(files)
    panelOf(files).*.dirty = true
    return true
}

// Whether `text` is the trash's files directory.
fn isTrashPath(files: *Files, text: []const u8) -> bool {
    var trash: Path = undefined
    if !places.trashPath(files.*.environment, &trash) { return false }
    apps_module.pathAdd(&trash, "/files")
    return sameBytes(pathText(&trash), text)
}

fn goHistory(files: *Files, path: *Path) -> void {
    const text = pathText(path)
    const shown = go(files, text, isTrashPath(files, text), false)
}

fn pushCurrent(files: *Files, into: *Path) -> void {
    copyPath(into, pathOf(files))
}

fn goBack(files: *Files) -> void {
    if files.*.backCount == 0 { return }
    if files.*.forwardCount < HISTORY {
        pushCurrent(files, forwardAt(files, files.*.forwardCount))
        files.*.forwardCount += 1
    }
    files.*.backCount -= 1
    var target: Path = undefined
    copyPath(&target, backAt(files, files.*.backCount))
    goHistory(files, &target)
}

fn goForward(files: *Files) -> void {
    if files.*.forwardCount == 0 { return }
    if files.*.backCount < HISTORY {
        pushCurrent(files, backAt(files, files.*.backCount))
        files.*.backCount += 1
    }
    files.*.forwardCount -= 1
    var target: Path = undefined
    copyPath(&target, forwardAt(files, files.*.forwardCount))
    goHistory(files, &target)
}

// The parent folder, with the folder we came from selected.
fn goUp(files: *Files) -> void {
    if files.*.inTrash || pathOf(files).*.length <= 1 { return }
    var name: [256]u8 = undefined
    const base = places.baseName(pathText(pathOf(files)))
    var length: usize = 0
    for byte in base {
        if length < 256 {
            name[length] = byte
            length += 1
        }
    }
    var parent: Path = undefined
    copyPath(&parent, pathOf(files))
    parentOf(&parent)
    if !go(files, pathText(&parent), false, true) { return }
    var index: usize = 0
    while index < files.*.count {
        if sameBytes(nameOf(files, entryAt(files, index)), name[0..length]) {
            selectOnly(files, index)
            revealCursor(files)
        }
        index += 1
    }
}

fn goTrash(files: *Files) -> void {
    var trash: Path = undefined
    if !places.trashPath(files.*.environment, &trash) { return }
    apps_module.pathAdd(&trash, "/files")
    const made = std.fs.makeDir(apps_module.pathEnd(&trash), 448)
    const shown = go(files, pathText(&trash), true, true)
}

// Opens entry `index`: a folder here, a file with its app.
fn openEntry(files: *Files, index: usize) -> void {
    var path: Path = undefined
    entryPath(files, index, &path)
    if entryAt(files, index).*.directory && !files.*.inTrash {
        const shown = go(files, pathText(&path), false, true)
        return
    }
    places.open(pathText(&path), files.*.environment)
}

fn openSelected(files: *Files) -> void {
    // Folders: the first one (we can show one); files: all of them.
    var index: usize = 0
    var folder = NONE
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        const entry = entryAt(files, at)
        if entry.*.selected {
            if entry.*.directory && !files.*.inTrash {
                if folder == NONE { folder = at }
            } else {
                openEntry(files, at)
            }
        }
        index += 1
    }
    if folder != NONE { openEntry(files, folder) }
}

// ---------------------------------------------------------------------------
// The sidebar's places

fn addPlace(files: *Files, kind: u8, path: []const u8) -> void {
    if files.*.placeCount >= MAX_PLACES { return }
    const index = files.*.placeCount
    files.*.placeKinds[index] = kind
    const place = placePathAt(files, index)
    apps_module.pathClear(place)
    apps_module.pathAdd(place, path)
    files.*.placeCount += 1
}

// A folder of the user's (XDG_DOWNLOAD_DIR in ~/.config/user-dirs.dirs,
// else HOME/`fallback`) when it exists and is not the home itself.
fn addUserFolder(files: *Files, text: []const u8, key: []const u8, fallback: []const u8) -> void {
    var path: Path = undefined
    apps_module.pathClear(&path)
    // KEY="$HOME/Downloads"
    var at: usize = 0
    var found = false
    while at < text.length && !found {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        if line.length > key.length + 2 && sameBytes(line[0..key.length], key) && line[key.length] == 61 {
            var value_start = key.length + 1
            var value_end = line.length
            if line[value_start] == 34 { value_start += 1 }
            if value_end > value_start && line[value_end - 1] == 34 { value_end -= 1 }
            const value = line[value_start..value_end]
            if value.length >= 5 && sameBytes(value[0..5], "$HOME") {
                apps_module.pathAddC(&path, homeOf(files))
                apps_module.pathAdd(&path, value[5..value.length])
            } else {
                apps_module.pathAdd(&path, value)
            }
            found = true
        }
        at = end + 1
    }
    if !found {
        apps_module.pathAddC(&path, homeOf(files))
        apps_module.pathAdd(&path, "/")
        apps_module.pathAdd(&path, fallback)
    }
    while path.length > 1 && path.bytes[path.length - 1] == 47 { path.length -= 1 }
    if path.length == homeLength(files) { return }
    if !places.isDirectory(apps_module.pathEnd(&path)) { return }
    addPlace(files, PLACE_FOLDER, pathText(&path))
}

fn findPlaces(files: *Files) -> void {
    files.*.placeCount = 0
    const home = homeOf(files)
    if @intFromPtr(home) != 0 {
        addPlace(files, PLACE_HOME, home[0..homeLength(files)])
        // ~/.config/user-dirs.dirs names the folders (in the user's
        // language: Dokumente, Bilder).
        var dirs: Path = undefined
        apps_module.pathClear(&dirs)
        const config = apps_module.environmentValue(files.*.environment, "XDG_CONFIG_HOME")
        if @intFromPtr(config) != 0 && config[0] != 0 {
            apps_module.pathAddC(&dirs, config)
        } else {
            apps_module.pathAddC(&dirs, home)
            apps_module.pathAdd(&dirs, "/.config")
        }
        apps_module.pathAdd(&dirs, "/user-dirs.dirs")
        var contents: std.fs.ArrayList = undefined
        const file = std.fs.open(apps_module.pathEnd(&dirs), 0, 0)
        var loaded = false
        if std.fs.isValid(file) {
            contents = std.fs.readToEndAlloc(file, files.*.allocator)
            const closed = std.fs.close(file)
            loaded = true
        }
        const known = if loaded { contents.items[0..contents.length] } else { "" }
        addUserFolder(files, known, "XDG_DESKTOP_DIR", "Desktop")
        addUserFolder(files, known, "XDG_DOCUMENTS_DIR", "Documents")
        addUserFolder(files, known, "XDG_DOWNLOAD_DIR", "Downloads")
        addUserFolder(files, known, "XDG_PICTURES_DIR", "Pictures")
        addUserFolder(files, known, "XDG_MUSIC_DIR", "Music")
        addUserFolder(files, known, "XDG_VIDEOS_DIR", "Videos")
        if loaded { std.fs.ArrayList.deinit(contents) }
    }
    addPlace(files, PLACE_COMPUTER, "/")
    addPlace(files, PLACE_TRASH, "")
}

fn placeLabel(files: *Files, index: usize) -> []const u8 {
    const kind = files.*.placeKinds[index]
    if kind == PLACE_COMPUTER { return say(files, "Computer", "Computer") }
    if kind == PLACE_TRASH { return say(files, "Trash", "Papierkorb") }
    return places.baseName(pathText(placePathAt(files, index)))
}

// Whether place `index` is the folder shown.
fn placeActive(files: *Files, index: usize) -> bool {
    if files.*.placeKinds[index] == PLACE_TRASH { return files.*.inTrash }
    return !files.*.inTrash && sameBytes(pathText(placePathAt(files, index)), pathText(pathOf(files)))
}

fn placeY(index: usize) -> i32 {
    // "Favorites" above the folders, "Locations" above the computer.
    return 44 + @intCast(i32, index) * PLACE_ROW
}

// The row of place `index` (the Locations heading pushes the last two
// down).
fn placeTop(files: *Files, index: usize) -> i32 {
    var y = placeY(index)
    if files.*.placeKinds[index] == PLACE_COMPUTER || files.*.placeKinds[index] == PLACE_TRASH { y += 30 }
    return y
}

fn goPlace(files: *Files, index: usize) -> void {
    if files.*.placeKinds[index] == PLACE_TRASH {
        goTrash(files)
        return
    }
    const shown = go(files, pathText(placePathAt(files, index)), false, true)
}

// ---------------------------------------------------------------------------
// Layout

fn surfaceWidth(files: *Files) -> i32 { return @intCast(i32, panelOf(files).*.width) }
fn surfaceHeight(files: *Files) -> i32 { return @intCast(i32, panelOf(files).*.height) }

fn contentTop(files: *Files) -> i32 { return if files.*.listView { TOOLBAR + HEADER } else { TOOLBAR } }
fn contentBottom(files: *Files) -> i32 { return surfaceHeight(files) - STATUS }
fn contentWidth(files: *Files) -> i32 { return surfaceWidth(files) - SIDEBAR }

fn columns(files: *Files) -> i32 {
    const count = (contentWidth(files) - GRID_PADDING * 2) / CELL_WIDTH
    return if count < 1 { 1 } else { count }
}

fn cellWidth(files: *Files) -> i32 { return (contentWidth(files) - GRID_PADDING * 2) / columns(files) }

fn contentHeight(files: *Files) -> i32 {
    const count = @intCast(i32, files.*.shownCount)
    if files.*.listView { return count * ROW + 8 }
    return GRID_PADDING * 2 + (count + columns(files) - 1) / columns(files) * CELL_HEIGHT
}

fn maxScroll(files: *Files) -> i32 {
    const extra = contentHeight(files) - (contentBottom(files) - contentTop(files))
    return if extra > 0 { extra } else { 0 }
}

fn clampScroll(files: *Files) -> void {
    if files.*.scroll > maxScroll(files) { files.*.scroll = maxScroll(files) }
    if files.*.scroll < 0 { files.*.scroll = 0 }
}

// Where item `index` (among those shown) is.
fn itemX(files: *Files, index: usize) -> i32 {
    if files.*.listView { return SIDEBAR }
    return SIDEBAR + GRID_PADDING + @intCast(i32, index) % columns(files) * cellWidth(files)
}

fn itemY(files: *Files, index: usize) -> i32 {
    if files.*.listView { return contentTop(files) + @intCast(i32, index) * ROW - files.*.scroll }
    return contentTop(files) + GRID_PADDING + @intCast(i32, index) / columns(files) * CELL_HEIGHT - files.*.scroll
}

fn itemWidth(files: *Files) -> i32 { return if files.*.listView { contentWidth(files) } else { cellWidth(files) } }
fn itemHeight(files: *Files) -> i32 { return if files.*.listView { ROW } else { CELL_HEIGHT } }

// The list's columns: where each starts (0: not shown for want of room).
fn kindColumn(files: *Files) -> i32 { return if contentWidth(files) >= 700 { surfaceWidth(files) - 130 } else { 0 } }
fn sizeColumnRight(files: *Files) -> i32 {
    if contentWidth(files) < 470 { return 0 }
    return if kindColumn(files) > 0 { kindColumn(files) - 20 } else { surfaceWidth(files) - 20 }
}
fn dateColumn(files: *Files) -> i32 {
    if contentWidth(files) < 380 { return 0 }
    const right = if sizeColumnRight(files) > 0 { sizeColumnRight(files) - 80 } else { surfaceWidth(files) - 20 }
    return right - 170
}
fn nameLimit(files: *Files) -> i32 {
    const end = if dateColumn(files) > 0 { dateColumn(files) } else { surfaceWidth(files) }
    return end - (SIDEBAR + 44) - 12
}

// The toolbar's buttons.
fn backX() -> i32 { return SIDEBAR + 12 }
fn forwardX() -> i32 { return SIDEBAR + 12 + BUTTON + 4 }
fn searchX(files: *Files) -> i32 { return surfaceWidth(files) - 14 - SEARCH_WIDTH }
fn listButtonX(files: *Files) -> i32 { return searchX(files) - 12 - BUTTON }
fn gridButtonX(files: *Files) -> i32 { return listButtonX(files) - BUTTON }
fn emptyTrashX(files: *Files) -> i32 { return gridButtonX(files) - 12 - 110 }

fn inside(x: i32, y: i32, left: i32, top: i32, width: i32, height: i32) -> bool {
    return x >= left && x < left + width && y >= top && y < top + height
}

// The breadcrumbs of the status bar: part `index` of the path, and where
// it starts; count of them.
fn crumbCount(files: *Files) -> usize {
    if files.*.inTrash { return 1 }
    const path = pathText(pathOf(files))
    var start: usize = 0
    var count: usize = 1
    if underHome(files, path) { start = homeLength(files) }
    var index = start
    while index < path.length {
        if path[index] == 47 && index + 1 < path.length { count += 1 }
        index += 1
    }
    return count
}

// Crumb `index`: its label, and the length of the path up to it.
fn crumb(files: *Files, index: usize, end: *usize) -> []const u8 {
    const path = pathText(pathOf(files))
    if files.*.inTrash {
        end.* = path.length
        return say(files, "Trash", "Papierkorb")
    }
    const home = underHome(files, path)
    const start = if home { homeLength(files) } else { 0 }
    if index == 0 {
        end.* = if start == 0 { 1 } else { start }
        if home { return places.baseName(path[0..start]) }
        return say(files, "Computer", "Computer")
    }
    var at = start
    var part: usize = 0
    while at < path.length {
        if path[at] == 47 && at + 1 < path.length {
            part += 1
            if part == index {
                var stop = at + 1
                while stop < path.length && path[stop] != 47 { stop += 1 }
                end.* = stop
                return path[at + 1..stop]
            }
        }
        at += 1
    }
    end.* = path.length
    return path[0..0]
}

fn crumbWidth(files: *Files, index: usize) -> i32 {
    var end: usize = 0
    return canvas_module.measure(smallOf(files), crumb(files, index, &end)) + 22
}

fn hitAt(files: *Files, x: i32, y: i32) -> usize {
    const width = surfaceWidth(files)
    const height = surfaceHeight(files)
    if x < SIDEBAR {
        var index: usize = 0
        while index < files.*.placeCount {
            if inside(x, y, 8, placeTop(files, index), SIDEBAR - 16, PLACE_ROW) { return HIT_PLACE + index }
            index += 1
        }
        return HIT_SIDEBAR
    }
    if y < TOOLBAR {
        const top = (TOOLBAR - BUTTON) / 2
        if inside(x, y, backX(), top, BUTTON, BUTTON) { return HIT_BACK }
        if inside(x, y, forwardX(), top, BUTTON, BUTTON) { return HIT_FORWARD }
        if inside(x, y, gridButtonX(files), top, BUTTON, BUTTON) { return HIT_GRID }
        if inside(x, y, listButtonX(files), top, BUTTON, BUTTON) { return HIT_LIST }
        if inside(x, y, searchX(files), top, SEARCH_WIDTH, BUTTON) { return HIT_SEARCH }
        if files.*.inTrash && inside(x, y, emptyTrashX(files), top, 110, BUTTON) { return HIT_EMPTY_TRASH }
        return NONE
    }
    if y >= height - STATUS {
        var left = SIDEBAR + 12
        var index: usize = 0
        while index < crumbCount(files) {
            const w = crumbWidth(files, index)
            if x >= left && x < left + w { return HIT_CRUMB + index }
            left += w
            index += 1
        }
        return NONE
    }
    if files.*.listView && y < TOOLBAR + HEADER {
        if x < SIDEBAR + 44 + nameLimit(files) { return HIT_COLUMN + SORT_NAME }
        if dateColumn(files) > 0 && x >= dateColumn(files) && x < dateColumn(files) + 170 { return HIT_COLUMN + SORT_DATE }
        if sizeColumnRight(files) > 0 && x >= sizeColumnRight(files) - 80 && x < sizeColumnRight(files) + 10 { return HIT_COLUMN + SORT_SIZE }
        if kindColumn(files) > 0 && x >= kindColumn(files) { return HIT_COLUMN + SORT_KIND }
        return NONE
    }
    // An item.
    if files.*.listView {
        const row = y - contentTop(files) + files.*.scroll
        if row >= 0 {
            const index = @intCast(usize, row / ROW)
            if index < files.*.shownCount { return index }
        }
        return HIT_CONTENT
    }
    const column = (x - SIDEBAR - GRID_PADDING) / cellWidth(files)
    const row_y = y - contentTop(files) - GRID_PADDING + files.*.scroll
    if x < SIDEBAR + GRID_PADDING || column >= columns(files) || row_y < 0 { return HIT_CONTENT }
    const index = @intCast(usize, row_y / CELL_HEIGHT * columns(files) + column)
    if index >= files.*.shownCount { return HIT_CONTENT }
    // The icon and the name, not the space around them.
    const cell_x = itemX(files, index)
    const cell_y = itemY(files, index)
    if !inside(x, y, cell_x + 6, cell_y + 4, cellWidth(files) - 12, CELL_HEIGHT - 8) { return HIT_CONTENT }
    return index
}

// Scrolls so the cursor shows.
fn revealCursor(files: *Files) -> void {
    if files.*.cursor == NONE { return }
    const index = shownIndexOf(files, files.*.cursor)
    if index == NONE { return }
    const top = itemY(files, index) + files.*.scroll - contentTop(files)
    const view = contentBottom(files) - contentTop(files)
    const pad = if files.*.listView { 0 } else { GRID_PADDING }
    if top - pad < files.*.scroll { files.*.scroll = top - pad }
    if top + itemHeight(files) + pad > files.*.scroll + view { files.*.scroll = top + itemHeight(files) + pad - view }
    clampScroll(files)
}

// ---------------------------------------------------------------------------
// Selection

fn clearSelection(files: *Files) -> void {
    var index: usize = 0
    while index < files.*.count {
        entryAt(files, index).*.selected = false
        index += 1
    }
}

fn selectOnly(files: *Files, entry: usize) -> void {
    clearSelection(files)
    entryAt(files, entry).*.selected = true
    files.*.cursor = entry
    files.*.anchor = entry
}

fn selectedCount(files: *Files) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        if entryAt(files, files.*.shown[index]).*.selected { count += 1 }
        index += 1
    }
    return count
}

// Selects the items from the anchor to `to` (shown indices).
fn selectRange(files: *Files, last: usize) -> void {
    var from = if files.*.anchor == NONE { NONE } else { shownIndexOf(files, files.*.anchor) }
    if from == NONE { from = last }
    clearSelection(files)
    var low = if from < last { from } else { last }
    const high = if from < last { last } else { from }
    while low <= high {
        entryAt(files, files.*.shown[low]).*.selected = true
        low += 1
    }
    files.*.cursor = files.*.shown[last]
}

// Moves the cursor by `step` items (Shift: selecting on the way).
fn moveCursor(files: *Files, step: i32, extend: bool) -> void {
    if files.*.shownCount == 0 { return }
    var at: i32 = 0
    if files.*.cursor != NONE {
        const index = shownIndexOf(files, files.*.cursor)
        if index != NONE { at = @intCast(i32, index) + step }
    } else if step < 0 {
        at = @intCast(i32, files.*.shownCount) - 1
    }
    if at < 0 { at = 0 }
    if at >= @intCast(i32, files.*.shownCount) { at = @intCast(i32, files.*.shownCount) - 1 }
    const index = @intCast(usize, at)
    if extend {
        selectRange(files, index)
    } else {
        selectOnly(files, files.*.shown[index])
    }
    revealCursor(files)
}

// The selecting rectangle: the items it touches are selected (with those
// selected before when Ctrl was held).
fn updateBand(files: *Files) -> void {
    const left = if files.*.pressX < files.*.pointerX { files.*.pressX } else { files.*.pointerX }
    const right = if files.*.pressX < files.*.pointerX { files.*.pointerX } else { files.*.pressX }
    const top = if files.*.pressY < files.*.pointerY { files.*.pressY } else { files.*.pointerY }
    const bottom = if files.*.pressY < files.*.pointerY { files.*.pointerY } else { files.*.pressY }
    var index: usize = 0
    while index < files.*.shownCount {
        const entry = entryAt(files, files.*.shown[index])
        var x = itemX(files, index)
        var w = itemWidth(files)
        if !files.*.listView {
            x += 8
            w -= 16
        }
        const y = itemY(files, index)
        const touches = x < right && x + w > left && y < bottom && y + itemHeight(files) > top
        entry.*.selected = touches || (files.*.pressKeep && files.*.bandBase[files.*.shown[index]])
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Changing files (in the background: the folder is read again when its
// directory changes)

const Script = struct {
    bytes: [32768]u8
    length: usize
}

fn scriptAdd(script: *Script, text: []const u8) -> void {
    for byte in text {
        if script.*.length < SCRIPT - 2 {
            script.*.bytes[script.*.length] = byte
            script.*.length += 1
        }
    }
}

fn scriptQuoted(script: *Script, text: []const u8) -> void {
    scriptAdd(script, "'")
    for byte in text {
        if byte == 39 {
            scriptAdd(script, "'\\''")
        } else if script.*.length < SCRIPT - 2 {
            script.*.bytes[script.*.length] = byte
            script.*.length += 1
        }
    }
    scriptAdd(script, "'")
}

fn runScript(files: *Files, script: *Script) -> void {
    script.*.bytes[script.*.length] = 0
    var text: [*]const u8 = undefined
    unsafe { text = @ptrCast([*]const u8, script) }
    apps_module.spawn(text, files.*.environment)
}

// Adds the selected items' paths, quoted.
fn scriptSelected(files: *Files, script: *Script) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if entryAt(files, at).*.selected {
            var path: Path = undefined
            entryPath(files, at, &path)
            scriptAdd(script, " ")
            scriptQuoted(script, pathText(&path))
            count += 1
        }
        index += 1
    }
    return count
}

fn trashSelected(files: *Files) -> void {
    if files.*.inTrash {
        deleteSelected(files)
        return
    }
    var script: Script = undefined
    script.length = 0
    scriptAdd(&script, "exec gio trash --")
    if scriptSelected(files, &script) == 0 { return }
    runScript(files, &script)
}

// In the trash: deletes the selected items for good, with what the trash
// knows of them.
fn deleteSelected(files: *Files) -> void {
    var script: Script = undefined
    script.length = 0
    scriptAdd(&script, "exec rm -rf --")
    var index: usize = 0
    var count: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if entryAt(files, at).*.selected {
            var path: Path = undefined
            entryPath(files, at, &path)
            scriptAdd(&script, " ")
            scriptQuoted(&script, pathText(&path))
            infoPath(files, at, &path)
            scriptAdd(&script, " ")
            scriptQuoted(&script, pathText(&path))
            count += 1
        }
        index += 1
    }
    if count > 0 { runScript(files, &script) }
}

// The trash's note on entry `index` (Trash/info/NAME.trashinfo).
fn infoPath(files: *Files, index: usize, into: *Path) -> void {
    copyPath(into, pathOf(files))
    parentOf(into)
    apps_module.pathAdd(into, "/info/")
    apps_module.pathAdd(into, nameOf(files, entryAt(files, index)))
    apps_module.pathAdd(into, ".trashinfo")
}

fn hexValue(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(u32, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(u32, byte - 55) }
    return 16
}

// Puts the selected items of the trash back where they were (the Path=
// line of their note, %XX decoded).
fn restoreSelected(files: *Files) -> void {
    var script: Script = undefined
    script.length = 0
    var count: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if entryAt(files, at).*.selected {
            var info: Path = undefined
            infoPath(files, at, &info)
            const file = std.fs.open(apps_module.pathEnd(&info), 0, 0)
            if std.fs.isValid(file) {
                var buffer: [4096]u8 = undefined
                var bytes: [*]u8 = undefined
                unsafe { bytes = @ptrCast([*]u8, &buffer) }
                const read = std.fs.read(file, bytes, 4096)
                const closed = std.fs.close(file)
                var target: Path = undefined
                apps_module.pathClear(&target)
                var line: usize = 0
                const length = if read > 0 { @intCast(usize, read) } else { 0 }
                while line + 5 < length {
                    if (line == 0 || bytes[line - 1] == 10) && bytes[line] == 80 && bytes[line + 1] == 97 && bytes[line + 2] == 116 && bytes[line + 3] == 104 && bytes[line + 4] == 61 {
                        var at_byte = line + 5
                        while at_byte < length && bytes[at_byte] != 10 && bytes[at_byte] != 13 && target.length < 1020 {
                            if bytes[at_byte] == 37 && at_byte + 2 < length && hexValue(bytes[at_byte + 1]) < 16 && hexValue(bytes[at_byte + 2]) < 16 {
                                target.bytes[target.length] = @intCast(u8, hexValue(bytes[at_byte + 1]) * 16 + hexValue(bytes[at_byte + 2]))
                                at_byte += 3
                            } else {
                                target.bytes[target.length] = bytes[at_byte]
                                at_byte += 1
                            }
                            target.length += 1
                        }
                        line = length
                    }
                    line += 1
                }
                if target.length > 1 && target.bytes[0] == 47 {
                    var source: Path = undefined
                    entryPath(files, at, &source)
                    var parent: Path = undefined
                    copyPath(&parent, &target)
                    parentOf(&parent)
                    scriptAdd(&script, "mkdir -p -- ")
                    scriptQuoted(&script, pathText(&parent))
                    scriptAdd(&script, " && mv -n -- ")
                    scriptQuoted(&script, pathText(&source))
                    scriptAdd(&script, " ")
                    scriptQuoted(&script, pathText(&target))
                    scriptAdd(&script, " && rm -f -- ")
                    scriptQuoted(&script, pathText(&info))
                    scriptAdd(&script, "\n")
                    count += 1
                }
            }
        }
        index += 1
    }
    if count > 0 { runScript(files, &script) }
}

// Copies (or cuts) the selected items' paths.
fn copySelected(files: *Files, cut: bool) -> void {
    files.*.clipLength = 0
    files.*.clipCount = 0
    files.*.clipCut = cut
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if entryAt(files, at).*.selected {
            var path: Path = undefined
            entryPath(files, at, &path)
            if files.*.clipLength + path.length + 1 < CLIP {
                for byte in pathText(&path) {
                    files.*.clip[files.*.clipLength] = byte
                    files.*.clipLength += 1
                }
                files.*.clip[files.*.clipLength] = 0
                files.*.clipLength += 1
                files.*.clipCount += 1
            }
        }
        index += 1
    }
}

// Copies (or moves, after a cut) what was copied into the folder shown;
// nothing is overwritten.
fn paste(files: *Files) -> void {
    if files.*.clipCount == 0 || files.*.inTrash { return }
    var script: Script = undefined
    script.length = 0
    scriptAdd(&script, if files.*.clipCut { "exec mv -n --" } else { "exec cp -Rn --" })
    const clip = fieldBytes(files, @offsetOf(Files, "clip"))
    var at: usize = 0
    while at < files.*.clipLength {
        var end = at
        while clip[end] != 0 { end += 1 }
        scriptAdd(&script, " ")
        scriptQuoted(&script, clip[at..end])
        at = end + 1
    }
    scriptAdd(&script, " ")
    scriptQuoted(&script, pathText(pathOf(files)))
    runScript(files, &script)
    if files.*.clipCut {
        files.*.clipCount = 0
        files.*.clipLength = 0
    }
}

// Makes "untitled folder" (or "untitled folder 2" and so on) and renames it.
fn newFolder(files: *Files) -> void {
    if files.*.inTrash { return }
    const base = say(files, "untitled folder", "Neuer Ordner")
    var number: usize = 1
    var path: Path = undefined
    var name: [64]u8 = undefined
    var name_length: usize = 0
    while number < 100 {
        name_length = 0
        for byte in base {
            name[name_length] = byte
            name_length += 1
        }
        if number > 1 {
            name[name_length] = 32
            name_length += 1
            if number >= 10 {
                name[name_length] = @intCast(u8, 48 + number / 10)
                name_length += 1
            }
            name[name_length] = @intCast(u8, 48 + number % 10)
            name_length += 1
        }
        copyPath(&path, pathOf(files))
        if path.length > 1 { apps_module.pathAdd(&path, "/") }
        apps_module.pathAdd(&path, name[0..name_length])
        if std.fs.makeDir(apps_module.pathEnd(&path), 493) {
            load(files)
            var index: usize = 0
            while index < files.*.count {
                if sameBytes(nameOf(files, entryAt(files, index)), name[0..name_length]) {
                    selectOnly(files, index)
                    revealCursor(files)
                    startRename(files, index)
                }
                index += 1
            }
            return
        }
        var status: std.fs.Stat = undefined
        if std.fs.status(apps_module.pathEnd(&path), &status) != 0 {
            setNote(files, say(files, "Can't make a folder here", "Hier kann kein Ordner angelegt werden"), "")
            return
        }
        number += 1
    }
}

fn startRename(files: *Files, index: usize) -> void {
    if files.*.inTrash { return }
    files.*.editing = index
    files.*.editLength = 0
    for byte in nameOf(files, entryAt(files, index)) {
        if files.*.editLength < EDIT {
            files.*.edit[files.*.editLength] = byte
            files.*.editLength += 1
        }
    }
    // The caret before the extension, as the Finder does.
    const extension = extensionOf(editText(files))
    files.*.caret = if extension.length > 0 && !entryAt(files, index).*.directory { files.*.editLength - extension.length - 1 } else { files.*.editLength }
    files.*.editSelected = files.*.caret > 0
    files.*.searchFocused = false
}

// Renames the entry to what was typed (nothing happens for an empty name,
// one with a slash, or one that is taken).
fn finishRename(files: *Files) -> void {
    const index = files.*.editing
    files.*.editing = NONE
    if index == NONE || index >= files.*.count { return }
    const name = editText(files)
    if name.length == 0 || sameBytes(name, nameOf(files, entryAt(files, index))) { return }
    for byte in name {
        if byte == 47 {
            setNote(files, say(files, "A name can't have a slash", "Ein Name darf keinen Schrägstrich enthalten"), "")
            return
        }
    }
    var old: Path = undefined
    entryPath(files, index, &old)
    var new: Path = undefined
    copyPath(&new, pathOf(files))
    if new.length > 1 { apps_module.pathAdd(&new, "/") }
    apps_module.pathAdd(&new, name)
    var status: std.fs.Stat = undefined
    if std.fs.statusAt(apps_module.pathEnd(&new), &status, true) == 0 {
        setNote(files, say(files, "The name is taken: ", "Der Name ist vergeben: "), name)
        return
    }
    if !std.fs.rename(apps_module.pathEnd(&old), apps_module.pathEnd(&new)) {
        setNote(files, say(files, "Can't rename ", "Kann nicht umbenannt werden: "), nameOf(files, entryAt(files, index)))
        return
    }
    // Read again with the new name selected.
    var kept: [256]u8 = undefined
    var kept_length: usize = 0
    for byte in name {
        kept[kept_length] = byte
        kept_length += 1
    }
    load(files)
    var at: usize = 0
    while at < files.*.count {
        if sameBytes(nameOf(files, entryAt(files, at)), kept[0..kept_length]) {
            selectOnly(files, at)
            revealCursor(files)
        }
        at += 1
    }
}

// Removes the selected part of the name (what is before the caret).
fn cutEditSelection(files: *Files) -> void {
    if !files.*.editSelected { return }
    files.*.editSelected = false
    const removed = files.*.caret
    var index = removed
    while index < files.*.editLength {
        files.*.edit[index - removed] = files.*.edit[index]
        index += 1
    }
    files.*.editLength -= removed
    files.*.caret = 0
}

// A key while renaming.
fn editKey(files: *Files, key: u32) -> void {
    if key == KEY_ENTER || key == KEY_KP_ENTER {
        finishRename(files)
        return
    }
    if key == KEY_ESCAPE {
        files.*.editing = NONE
        return
    }
    if (key == KEY_LEFT || key == KEY_HOME) && files.*.editSelected {
        files.*.editSelected = false
        files.*.caret = 0
        return
    }
    if key == KEY_RIGHT || key == KEY_END { files.*.editSelected = false }
    if key == KEY_LEFT && files.*.caret > 0 {
        files.*.caret -= 1
        while files.*.caret > 0 && files.*.edit[files.*.caret] >= 128 && files.*.edit[files.*.caret] < 192 { files.*.caret -= 1 }
        return
    }
    if key == KEY_RIGHT && files.*.caret < files.*.editLength {
        files.*.caret += 1
        while files.*.caret < files.*.editLength && files.*.edit[files.*.caret] >= 128 && files.*.edit[files.*.caret] < 192 { files.*.caret += 1 }
        return
    }
    if key == KEY_HOME {
        files.*.caret = 0
        return
    }
    if key == KEY_END {
        files.*.caret = files.*.editLength
        return
    }
    if (key == KEY_BACKSPACE || key == KEY_DELETE) && files.*.editSelected {
        cutEditSelection(files)
        return
    }
    if key == KEY_BACKSPACE || key == KEY_DELETE {
        // One character (all its UTF-8 bytes) before or after the caret.
        var start = files.*.caret
        var end = files.*.caret
        if key == KEY_BACKSPACE {
            if start == 0 { return }
            start -= 1
            while start > 0 && files.*.edit[start] >= 128 && files.*.edit[start] < 192 { start -= 1 }
        } else {
            if end >= files.*.editLength { return }
            end += 1
            while end < files.*.editLength && files.*.edit[end] >= 128 && files.*.edit[end] < 192 { end += 1 }
        }
        var index = end
        while index < files.*.editLength {
            files.*.edit[index - (end - start)] = files.*.edit[index]
            index += 1
        }
        files.*.editLength -= end - start
        files.*.caret = start
        return
    }
    const panel = panelOf(files)
    if panel.*.textLength == 0 || modifiers(files) & (CONTROL | ALT) != 0 { return }
    if panel.*.text[0] < 32 { return }
    cutEditSelection(files)
    if files.*.editLength + panel.*.textLength > EDIT { return }
    var index = files.*.editLength
    while index > files.*.caret {
        index -= 1
        files.*.edit[index + panel.*.textLength] = files.*.edit[index]
    }
    var at: usize = 0
    while at < panel.*.textLength {
        files.*.edit[files.*.caret + at] = panel.*.text[at]
        at += 1
    }
    files.*.editLength += panel.*.textLength
    files.*.caret += panel.*.textLength
}

// A key while the search field has the keyboard.
fn searchKey(files: *Files, key: u32) -> void {
    if key == KEY_ESCAPE {
        files.*.searchLength = 0
        files.*.searchFocused = false
    } else if key == KEY_ENTER || key == KEY_KP_ENTER || key == KEY_DOWN {
        files.*.searchFocused = false
        if files.*.shownCount > 0 && files.*.cursor == NONE { selectOnly(files, files.*.shown[0]) }
    } else if key == KEY_BACKSPACE {
        if files.*.searchLength == 0 { return }
        files.*.searchLength -= 1
        while files.*.searchLength > 0 && files.*.search[files.*.searchLength] >= 128 && files.*.search[files.*.searchLength] < 192 { files.*.searchLength -= 1 }
    } else {
        const panel = panelOf(files)
        if panel.*.textLength == 0 || modifiers(files) & (CONTROL | ALT) != 0 || panel.*.text[0] < 32 { return }
        if files.*.searchLength + panel.*.textLength > SEARCH { return }
        var at: usize = 0
        while at < panel.*.textLength {
            files.*.search[files.*.searchLength] = panel.*.text[at]
            files.*.searchLength += 1
            at += 1
        }
    }
    files.*.scroll = 0
    buildShown(files)
}

// Typing selects the first name that starts with what was typed lately.
fn typeAhead(files: *Files) -> void {
    const panel = panelOf(files)
    if panel.*.textLength == 0 || panel.*.text[0] <= 32 { return }
    const now = panel_module.milliseconds()
    if now > files.*.typedAt + 1000 { files.*.typedLength = 0 }
    files.*.typedAt = now
    var at: usize = 0
    while at < panel.*.textLength && files.*.typedLength < 32 {
        files.*.typed[files.*.typedLength] = panel.*.text[at]
        files.*.typedLength += 1
        at += 1
    }
    const typed = fieldBytes(files, @offsetOf(Files, "typed"))[0..files.*.typedLength]
    var index: usize = 0
    while index < files.*.shownCount {
        const name = nameOf(files, entryAt(files, files.*.shown[index]))
        if name.length >= typed.length && apps_module.containsText(name[0..typed.length], typed) {
            selectOnly(files, files.*.shown[index])
            revealCursor(files)
            return
        }
        index += 1
    }
}

// The folder under the pointer's path or the folder shown into `into`, for
// files dropped there.
fn dropTarget(files: *Files, into: *Path) -> void {
    if files.*.dropHover != NONE {
        entryPath(files, files.*.dropHover, into)
    } else {
        copyPath(into, pathOf(files))
    }
}

// Files dropped on the window: moved when they came from this window,
// else copied; nothing is overwritten.
fn dropFiles(files: *Files) -> void {
    const list = panel_module.dropDataOf(panelOf(files))
    var target: Path = undefined
    dropTarget(files, &target)
    files.*.dropping = false
    files.*.dropHover = NONE
    if files.*.inTrash { return }
    var script: Script = undefined
    script.length = 0
    scriptAdd(&script, if files.*.dragging { "exec mv -n --" } else { "exec cp -Rn --" })
    var count: usize = 0
    var path: Path = undefined
    var line: usize = 0
    while places.uriPath(list, line, &path) {
        // Not into itself, nor where it is already.
        var parent: Path = undefined
        copyPath(&parent, &path)
        parentOf(&parent)
        if !sameBytes(pathText(&path), pathText(&target)) && !sameBytes(pathText(&parent), pathText(&target)) {
            scriptAdd(&script, " ")
            scriptQuoted(&script, pathText(&path))
            count += 1
        }
        line += 1
    }
    if count == 0 { return }
    scriptAdd(&script, " ")
    scriptQuoted(&script, pathText(&target))
    runScript(files, &script)
}

// Adds a pinned folder to the dock (~/.config/mlx/dock-folders).
fn addToDock(files: *Files, index: usize) -> void {
    var path: Path = undefined
    entryPath(files, index, &path)
    var pinned: Path = undefined
    apps_module.pathClear(&pinned)
    const text = pathText(&path)
    if underHome(files, text) {
        apps_module.pathAdd(&pinned, "~")
        apps_module.pathAdd(&pinned, text[homeLength(files)..text.length])
    } else {
        apps_module.pathAdd(&pinned, text)
    }
    var pins: pins_module.Pins = undefined
    if !pins_module.read(files.*.environment, pins_module.FOLDERS, files.*.allocator, &pins) {
        pins.count = 0
        pins_module.insert(&pins, "~/Downloads", 0)
    }
    if pins_module.find(&pins, pathText(&pinned)) == pins.count { pins_module.insert(&pins, pathText(&pinned), pins.count) }
    const written = pins_module.write(files.*.environment, pins_module.FOLDERS, &pins)
}

fn openTerminal(files: *Files) -> void {
    var command: Path = undefined
    apps_module.pathClear(&command)
    apps_module.pathAdd(&command, "cd ")
    var quoted: Script = undefined
    quoted.length = 0
    scriptQuoted(&quoted, pathText(pathOf(files)))
    apps_module.pathAdd(&command, quoted.bytes[0..quoted.length])
    apps_module.pathAdd(&command, " && exec \"${SHELL:-/bin/sh}\"")
    var terminal = files.*.terminal
    if @intFromPtr(terminal) == 0 { unsafe { terminal = @ptrCast([*]const u8, "mlx-terminal") } }
    apps_module.run(pathText(&command), terminal, files.*.environment)
}

// ---------------------------------------------------------------------------
// The menu

fn drawMenu(context: *anyopaque, canvas: *Canvas) -> void {
    const files = filesOf(context)
    menu_module.draw(menuOf(files), canvas, bodyOf(files))
}

fn openMenu(files: *Files, entry: usize) -> void {
    const menu = menuOf(files)
    menu_module.clear(menu)
    files.*.menuEntry = entry
    if entry != NONE {
        if files.*.inTrash {
            menu_module.add(menu, say(files, "Put Back", "Zurücklegen"), MENU_RESTORE, 0)
            menu_module.add(menu, say(files, "Delete Immediately", "Sofort löschen"), MENU_DELETE, 0)
        } else {
            menu_module.add(menu, say(files, "Open", "Öffnen"), MENU_OPEN, 0)
            menu_module.separator(menu)
            menu_module.add(menu, say(files, "Rename", "Umbenennen"), MENU_RENAME, 0)
            menu_module.add(menu, say(files, "Copy", "Kopieren"), MENU_COPY, 0)
            menu_module.add(menu, say(files, "Cut", "Ausschneiden"), MENU_CUT, 0)
            if entryAt(files, entry).*.directory { menu_module.add(menu, say(files, "Add to Dock", "Zum Dock hinzufügen"), MENU_DOCK, 0) }
            menu_module.separator(menu)
            menu_module.add(menu, say(files, "Move to Trash", "In den Papierkorb legen"), MENU_TRASH, 0)
        }
    } else if files.*.inTrash {
        menu_module.add(menu, say(files, "Empty Trash", "Papierkorb leeren"), MENU_EMPTY_TRASH, 0)
    } else {
        menu_module.add(menu, say(files, "New Folder", "Neuer Ordner"), MENU_NEW_FOLDER, 0)
        if files.*.clipCount > 0 { menu_module.add(menu, say(files, "Paste", "Einfügen"), MENU_PASTE, 0) }
        menu_module.add(menu, say(files, "Open in Terminal", "Im Terminal öffnen"), MENU_TERMINAL, 0)
        menu_module.separator(menu)
        menu_module.add(menu, if files.*.listView { say(files, "View as Icons", "Als Symbole") } else { say(files, "View as List", "Als Liste") }, MENU_VIEW, 0)
        menu_module.add(menu, say(files, "Sort by Name", "Nach Name sortieren"), MENU_SORT, SORT_NAME)
        menu_module.add(menu, say(files, "Sort by Date", "Nach Datum sortieren"), MENU_SORT, SORT_DATE)
        menu_module.add(menu, say(files, "Sort by Size", "Nach Größe sortieren"), MENU_SORT, SORT_SIZE)
        menu_module.add(menu, say(files, "Sort by Kind", "Nach Art sortieren"), MENU_SORT, SORT_KIND)
        menu_module.add(menu, if files.*.showHidden { say(files, "Hide Hidden Files", "Versteckte Dateien ausblenden") } else { say(files, "Show Hidden Files", "Versteckte Dateien zeigen") }, MENU_HIDDEN, 0)
    }
    const panel = panelOf(files)
    files.*.menuOpen = panel_module.openMenu(panel, files.*.pointerX, files.*.pointerY, 1, 1, panel_module.PLACE_BOTTOM_RIGHT, menu_module.width(menu, bodyOf(files)), menu_module.height(menu), drawMenu)
}

fn setSort(files: *Files, key: usize) -> void {
    if files.*.sortKey == key {
        files.*.sortReversed = !files.*.sortReversed
    } else {
        files.*.sortKey = key
        files.*.sortReversed = false
    }
    sortEntries(files)
    buildShown(files)
}

fn choose(files: *Files, index: usize) -> void {
    const menu = menuOf(files)
    const kind = menu_module.kindAt(menu, index)
    const value = menu_module.valueAt(menu, index)
    const entry = files.*.menuEntry
    panel_module.closeMenu(panelOf(files))
    files.*.menuOpen = false
    if kind == MENU_OPEN { openSelected(files) }
    if kind == MENU_RENAME && entry != NONE { startRename(files, entry) }
    if kind == MENU_COPY { copySelected(files, false) }
    if kind == MENU_CUT { copySelected(files, true) }
    if kind == MENU_PASTE { paste(files) }
    if kind == MENU_TRASH { trashSelected(files) }
    if kind == MENU_DELETE { deleteSelected(files) }
    if kind == MENU_RESTORE { restoreSelected(files) }
    if kind == MENU_EMPTY_TRASH { places.emptyTrash(files.*.environment) }
    if kind == MENU_NEW_FOLDER { newFolder(files) }
    if kind == MENU_TERMINAL { openTerminal(files) }
    if kind == MENU_DOCK && entry != NONE { addToDock(files, entry) }
    if kind == MENU_VIEW { setView(files, !files.*.listView) }
    if kind == MENU_SORT { setSort(files, value) }
    if kind == MENU_HIDDEN {
        files.*.showHidden = !files.*.showHidden
        buildShown(files)
    }
    panelOf(files).*.dirty = true
}

fn setView(files: *Files, list: bool) -> void {
    files.*.listView = list
    clampScroll(files)
    revealCursor(files)
}

// ---------------------------------------------------------------------------
// Input

// Starts dragging the selected items (text/uri-list, as file:// URIs).
fn startDragOut(files: *Files) -> void {
    var data: [1024]u8 = undefined
    var length: usize = 0
    var index: usize = 0
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        if entryAt(files, at).*.selected {
            var path: Path = undefined
            entryPath(files, at, &path)
            // file://PATH with the bytes a URI can't hold as %XX.
            var uri: [1024]u8 = undefined
            var uri_length: usize = 0
            for byte in "file://" {
                uri[uri_length] = byte
                uri_length += 1
            }
            for byte in pathText(&path) {
                const plain = (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || isDigit(byte) || byte == 47 || byte == 45 || byte == 46 || byte == 95 || byte == 126
                if uri_length + 3 < 1020 {
                    if plain {
                        uri[uri_length] = byte
                        uri_length += 1
                    } else {
                        const digits = "0123456789ABCDEF"
                        uri[uri_length] = 37
                        uri[uri_length + 1] = digits[@intCast(usize, byte >> 4)]
                        uri[uri_length + 2] = digits[@intCast(usize, byte & 15)]
                        uri_length += 3
                    }
                }
            }
            if length + uri_length + 2 <= 1024 {
                var at_byte: usize = 0
                while at_byte < uri_length {
                    data[length] = uri[at_byte]
                    length += 1
                    at_byte += 1
                }
                data[length] = 13
                data[length + 1] = 10
                length += 2
            }
        }
        index += 1
    }
    if length == 0 { return }
    files.*.dragging = panel_module.startDrag(panelOf(files), "text/uri-list", data[0..length], 64, drawDragIcon)
}

fn drawDragIcon(context: *anyopaque, canvas: *Canvas) -> void {
    const files = filesOf(context)
    if files.*.cursor == NONE || files.*.cursor >= files.*.count { return }
    drawEntryIcon(files, canvas, files.*.cursor, 4, 4, 56, true)
    const count = selectedCount(files)
    if count > 1 {
        // A badge with how many.
        var digits: [24]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &digits) }
        const length = writeNumber(bytes, 0, count)
        canvas_module.fillRoundedRect(canvas, 36, 0, 28, 20, 10, canvas_module.color(255, 230, 60, 60))
        const text = bytes[0..length]
        canvas_module.drawText(canvas, smallOf(files), text, 50 - canvas_module.measure(smallOf(files), text) / 2, 3, canvas_module.color(255, 255, 255, 255), 0)
    }
}

fn press(files: *Files, hit: usize) -> void {
    const now = panel_module.milliseconds()
    const is_double = hit == files.*.lastClickHit && now < files.*.lastClick + 400
    files.*.lastClick = if is_double { 0 } else { now }
    files.*.lastClickHit = hit
    if files.*.editing != NONE && hit != shownIndexOf(files, files.*.editing) { finishRename(files) }
    files.*.searchFocused = hit == HIT_SEARCH
    if hit == HIT_BACK {
        goBack(files)
    } else if hit == HIT_FORWARD {
        goForward(files)
    } else if hit == HIT_GRID {
        setView(files, false)
    } else if hit == HIT_LIST {
        setView(files, true)
    } else if hit == HIT_EMPTY_TRASH {
        places.emptyTrash(files.*.environment)
    } else if hit >= HIT_COLUMN && hit < HIT_COLUMN + 4 {
        setSort(files, hit - HIT_COLUMN)
    } else if hit >= HIT_CRUMB && hit < HIT_CRUMB + 256 {
        var end: usize = 0
        const label = crumb(files, hit - HIT_CRUMB, &end)
        if !files.*.inTrash && end < pathOf(files).*.length {
            var target: Path = undefined
            copyPath(&target, pathOf(files))
            target.length = end
            const shown = go(files, pathText(&target), false, true)
        }
    } else if hit >= HIT_PLACE && hit < HIT_PLACE + MAX_PLACES {
        goPlace(files, hit - HIT_PLACE)
    } else if hit == HIT_CONTENT {
        // A selecting rectangle from here.
        files.*.pressed = true
        files.*.banding = true
        files.*.pressKeep = modifiers(files) & (CONTROL | SHIFT) != 0
        var index: usize = 0
        while index < files.*.count {
            files.*.bandBase[index] = entryAt(files, index).*.selected
            index += 1
        }
        if !files.*.pressKeep {
            clearSelection(files)
            files.*.cursor = NONE
        }
    } else if hit < files.*.shownCount {
        const entry_index = files.*.shown[hit]
        const entry = entryAt(files, entry_index)
        const held = modifiers(files)
        files.*.pressed = true
        files.*.pressHit = hit
        files.*.pressKeep = false
        if held & CONTROL != 0 {
            entry.*.selected = !entry.*.selected
            files.*.cursor = entry_index
            files.*.anchor = entry_index
        } else if held & SHIFT != 0 {
            selectRange(files, hit)
        } else if entry.*.selected {
            // Kept for a drag of all of them; one alone on release.
            files.*.cursor = entry_index
            files.*.pressKeep = true
        } else {
            selectOnly(files, entry_index)
        }
        if is_double && held & (CONTROL | SHIFT) == 0 {
            files.*.pressed = false
            openSelected(files)
        }
    }
}

fn release(files: *Files) -> void {
    if files.*.pressed && !files.*.banding && files.*.pressKeep && !files.*.dragging && files.*.pressHit < files.*.shownCount {
        selectOnly(files, files.*.shown[files.*.pressHit])
    }
    files.*.pressed = false
    files.*.banding = false
    files.*.pressHit = NONE
}

fn motion(files: *Files, x: i32, y: i32) -> bool {
    files.*.pointerX = x
    files.*.pointerY = y
    if files.*.pressed && files.*.banding {
        updateBand(files)
        return true
    }
    if files.*.pressed && !files.*.dragging && files.*.pressHit < files.*.shownCount {
        const dx = x - files.*.pressX
        const dy = y - files.*.pressY
        if dx * dx + dy * dy > 36 {
            files.*.pressed = false
            startDragOut(files)
            return true
        }
    }
    const hover = hitAt(files, x, y)
    if hover == files.*.hover { return false }
    files.*.hover = hover
    return true
}

fn onKey(files: *Files, key_code: u32) -> void {
    const panel = panelOf(files)
    const held = modifiers(files)
    const control = held & CONTROL != 0
    const alt = held & ALT != 0
    const shift = held & SHIFT != 0
    if files.*.editing != NONE {
        editKey(files, key_code)
        return
    }
    if control && key_code == KEY_F {
        files.*.searchFocused = true
        return
    }
    if files.*.searchFocused && !control && !alt {
        searchKey(files, key_code)
        return
    }
    if control && key_code == KEY_W {
        panel.*.running = false
    } else if control && key_code == KEY_H {
        files.*.showHidden = !files.*.showHidden
        buildShown(files)
    } else if control && key_code == KEY_A {
        var index: usize = 0
        while index < files.*.shownCount {
            entryAt(files, files.*.shown[index]).*.selected = true
            index += 1
        }
    } else if control && key_code == KEY_C {
        copySelected(files, false)
    } else if control && key_code == KEY_X {
        copySelected(files, true)
    } else if control && key_code == KEY_V {
        paste(files)
    } else if control && shift && key_code == KEY_N {
        newFolder(files)
    } else if control && key_code == KEY_1 {
        setView(files, false)
    } else if control && key_code == KEY_2 {
        setView(files, true)
    } else if key_code == KEY_F5 {
        reload(files)
    } else if key_code == KEY_F2 {
        if files.*.cursor != NONE && entryAt(files, files.*.cursor).*.selected { startRename(files, files.*.cursor) }
    } else if key_code == KEY_DELETE {
        trashSelected(files)
    } else if alt && key_code == KEY_LEFT || key_code == KEY_BACKSPACE {
        goBack(files)
    } else if alt && key_code == KEY_RIGHT {
        goForward(files)
    } else if alt && key_code == KEY_UP {
        goUp(files)
    } else if (control || alt) && key_code == KEY_DOWN {
        openSelected(files)
    } else if key_code == KEY_ENTER || key_code == KEY_KP_ENTER {
        openSelected(files)
    } else if key_code == KEY_ESCAPE {
        if files.*.searchLength > 0 {
            files.*.searchLength = 0
            buildShown(files)
        } else {
            clearSelection(files)
            files.*.cursor = NONE
        }
    } else if key_code == KEY_LEFT {
        moveCursor(files, -1, shift)
    } else if key_code == KEY_RIGHT {
        moveCursor(files, 1, shift)
    } else if key_code == KEY_UP {
        moveCursor(files, if files.*.listView { -1 } else { -columns(files) }, shift)
    } else if key_code == KEY_DOWN {
        moveCursor(files, if files.*.listView { 1 } else { columns(files) }, shift)
    } else if key_code == KEY_PAGE_UP || key_code == KEY_PAGE_DOWN {
        const rows = (contentBottom(files) - contentTop(files)) / itemHeight(files)
        const per_row = if files.*.listView { 1 } else { columns(files) }
        var step = rows - 1
        if step < 1 { step = 1 }
        step = step * per_row
        moveCursor(files, if key_code == KEY_PAGE_UP { -step } else { step }, shift)
    } else if key_code == KEY_HOME {
        moveCursor(files, -1000000, shift)
    } else if key_code == KEY_END {
        moveCursor(files, 1000000, shift)
    } else if !control && !alt {
        typeAhead(files)
    }
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const files = filesOf(context)
    const panel = panelOf(files)
    if kind == panel_module.EVENT_CONFIGURED {
        // Blur behind the translucent sidebar.
        var rects: [4]i32 = [4]i32{ 0, 0, SIDEBAR, surfaceHeight(files) }
        unsafe { panel_module.setBlur(panel, @ptrCast([*]const i32, &rects), 1) }
        clampScroll(files)
        revealCursor(files)
    } else if kind == panel_module.EVENT_MOTION {
        if !motion(files, @bitCast(i32, a), b) { return }
    } else if kind == panel_module.EVENT_LEAVE {
        files.*.hover = NONE
    } else if kind == panel_module.EVENT_BUTTON {
        if a == BUTTON_LEFT && b == 1 {
            files.*.pressX = files.*.pointerX
            files.*.pressY = files.*.pointerY
            press(files, hitAt(files, files.*.pointerX, files.*.pointerY))
        } else if a == BUTTON_LEFT && b == 0 {
            release(files)
        } else if a == BUTTON_RIGHT && b == 1 {
            if files.*.editing != NONE { finishRename(files) }
            const hit = hitAt(files, files.*.pointerX, files.*.pointerY)
            if hit < files.*.shownCount {
                const entry = files.*.shown[hit]
                if !entryAt(files, entry).*.selected { selectOnly(files, entry) }
                files.*.cursor = entry
                openMenu(files, entry)
            } else if hit == HIT_CONTENT {
                clearSelection(files)
                files.*.cursor = NONE
                openMenu(files, NONE)
            }
        }
    } else if kind == panel_module.EVENT_WHEEL {
        if a != 0 { return }
        var pixels = panel.*.wheelPixels * 3
        if pixels == 0 { pixels = b * 40 }
        files.*.scroll += pixels
        clampScroll(files)
        files.*.hover = hitAt(files, files.*.pointerX, files.*.pointerY)
    } else if kind == panel_module.EVENT_KEY {
        trackModifier(files, a, b != 0)
        if b == 0 { return }
        onKey(files, a)
    } else if kind == panel_module.EVENT_KEYBOARD_LEAVE {
        files.*.held = 0
        return
    } else if kind == panel_module.EVENT_MENU_MOTION {
        if menu_module.hover(menuOf(files), b) { panel_module.menuChanged(panel) }
        return
    } else if kind == panel_module.EVENT_MENU_LEAVE {
        menuOf(files).*.hover = menu_module.NONE
        panel_module.menuChanged(panel)
        return
    } else if kind == panel_module.EVENT_MENU_BUTTON {
        if b == 0 && menuOf(files).*.hover != menu_module.NONE { choose(files, menuOf(files).*.hover) }
    } else if kind == panel_module.EVENT_MENU_CLOSED {
        files.*.menuOpen = false
    } else if kind == panel_module.EVENT_DRAG_MOTION {
        files.*.dropping = true
        const hit = hitAt(files, @bitCast(i32, a), b)
        files.*.dropHover = NONE
        if hit < files.*.shownCount && entryAt(files, files.*.shown[hit]).*.directory && !entryAt(files, files.*.shown[hit]).*.selected { files.*.dropHover = files.*.shown[hit] }
    } else if kind == panel_module.EVENT_DRAG_LEAVE {
        files.*.dropping = false
        files.*.dropHover = NONE
    } else if kind == panel_module.EVENT_DROP {
        const hit = hitAt(files, @bitCast(i32, a), b)
        files.*.dropHover = NONE
        if hit < files.*.shownCount && entryAt(files, files.*.shown[hit]).*.directory && !entryAt(files, files.*.shown[hit]).*.selected { files.*.dropHover = files.*.shown[hit] }
        dropFiles(files)
    } else if kind == panel_module.EVENT_DRAG_END {
        files.*.dragging = false
    } else if kind == panel_module.EVENT_TICK {
        tick(files)
        return
    }
    panel.*.dirty = true
}

// Every tick: pictures still to read, the folder changed, the note gone.
fn tick(files: *Files) -> void {
    const panel = panelOf(files)
    const now = panel_module.milliseconds()
    const pending = files.*.thumbsPending
    files.*.thumbsPending = false
    if pending { panel.*.dirty = true }
    if files.*.noteLength > 0 && now >= files.*.noteUntil {
        files.*.noteLength = 0
        panel.*.dirty = true
    }
    if now >= files.*.lastCheck + 700 {
        files.*.lastCheck = now
        // Not while something points at entries by their place (renaming,
        // the menu, a press, a drag over us).
        const busy = files.*.editing != NONE || files.*.menuOpen || files.*.pressed || files.*.dropping
        if !busy && directoryChanged(files) {
            reload(files)
            panel.*.dirty = true
        }
    }
    panel.*.tickInterval = if pending { 60 } else { 250 }
}

// ---------------------------------------------------------------------------
// Drawing

const BACKGROUND: u32 = 4280164392
const TEXT_COLOR: u32 = 4293652213
const DIM_COLOR: u32 = 4287402656
const ACCENT: u32 = 4284129535

fn writeNumber(out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var index = at
    while count > 0 {
        count -= 1
        out[index] = digits[count]
        index += 1
    }
    return index
}

// A size as people read it: "812 bytes", "1.2 KB", "34 MB" (German: "1,2
// MB"); into `out` from `at`, the length then.
fn formatSize(files: *Files, size: isize, out: [*]u8, at: usize) -> usize {
    var length: usize = 0
    const value = if size > 0 { @intCast(usize, size) } else { 0 }
    if value < 1000 {
        length = writeNumber(out, at, value)
        return writeText(out, length, if value == 1 { say(files, " byte", " Byte") } else { say(files, " bytes", " Bytes") })
    }
    var unit: usize = 0
    // Tenths of the unit.
    var tenths = value / 100
    while tenths >= 10000 && unit < 4 {
        tenths = tenths / 1000
        unit += 1
    }
    if tenths >= 100 {
        length = writeNumber(out, at, (tenths + 5) / 10)
    } else {
        length = writeNumber(out, at, tenths / 10)
        var separator: u8 = 46
        if files.*.german { separator = 44 }
        out[length] = separator
        length = writeNumber(out, length + 1, tenths % 10)
    }
    const units = match unit { 0 => " KB", 1 => " MB", 2 => " GB", 3 => " TB", else => " PB" }
    return writeText(out, length, units)
}

fn writeText(out: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        out[index] = byte
        index += 1
    }
    return index
}

// What kind of file an entry is ("Folder", "PNG image", ...).
fn kindOf(files: *Files, entry: *const Entry, out: [*]u8) -> usize {
    if entry.*.directory { return writeText(out, 0, say(files, "Folder", "Ordner")) }
    const extension = extensionOf(nameOf(files, entry))
    var upper: [8]u8 = undefined
    var length: usize = 0
    for byte in extension {
        if length < 8 {
            upper[length] = if byte >= 97 && byte <= 122 { byte - 32 } else { byte }
            length += 1
        }
    }
    const kind = upper[0..length]
    if length == 0 || extension.length > 8 {
        if entry.*.executable { return writeText(out, 0, say(files, "Program", "Programm")) }
        return writeText(out, 0, say(files, "Document", "Dokument"))
    }
    if sameBytes(kind, "PNG") || sameBytes(kind, "JPG") || sameBytes(kind, "JPEG") || sameBytes(kind, "GIF") || sameBytes(kind, "WEBP") || sameBytes(kind, "SVG") || sameBytes(kind, "BMP") {
        length = writeText(out, 0, kind)
        return writeText(out, length, say(files, " image", "-Bild"))
    }
    if sameBytes(kind, "PDF") { return writeText(out, 0, say(files, "PDF document", "PDF-Dokument")) }
    if sameBytes(kind, "TXT") || sameBytes(kind, "MD") { return writeText(out, 0, say(files, "Plain text", "Text")) }
    if sameBytes(kind, "ZIP") || sameBytes(kind, "GZ") || sameBytes(kind, "XZ") || sameBytes(kind, "ZST") || sameBytes(kind, "TAR") || sameBytes(kind, "7Z") || sameBytes(kind, "RAR") || sameBytes(kind, "BZ2") { return writeText(out, 0, say(files, "Archive", "Archiv")) }
    if sameBytes(kind, "MP3") || sameBytes(kind, "FLAC") || sameBytes(kind, "OGG") || sameBytes(kind, "WAV") || sameBytes(kind, "OPUS") || sameBytes(kind, "M4A") { return writeText(out, 0, "Audio") }
    if sameBytes(kind, "MP4") || sameBytes(kind, "MKV") || sameBytes(kind, "WEBM") || sameBytes(kind, "MOV") || sameBytes(kind, "AVI") { return writeText(out, 0, "Video") }
    if sameBytes(kind, "DESKTOP") { return writeText(out, 0, say(files, "App", "Programm")) }
    if sameBytes(kind, "MLX") || sameBytes(kind, "C") || sameBytes(kind, "H") || sameBytes(kind, "RS") || sameBytes(kind, "PY") || sameBytes(kind, "JS") || sameBytes(kind, "TS") || sameBytes(kind, "ZIG") || sameBytes(kind, "SH") || sameBytes(kind, "GO") || sameBytes(kind, "CPP") || sameBytes(kind, "JAVA") { return writeText(out, 0, say(files, "Source code", "Quelltext")) }
    length = writeText(out, 0, kind)
    return writeText(out, length, say(files, " file", "-Datei"))
}

// Two strokes meeting at a point, `size` rows high (odd).
fn drawChevron(canvas: *Canvas, x: i32, y: i32, left: bool, color: u32) -> void { drawChevronSized(canvas, x, y, left, color, 13, 3) }

fn drawChevronSized(canvas: *Canvas, x: i32, y: i32, left: bool, color: u32, size: i32, thickness: i32) -> void {
    const half = size / 2
    var row: i32 = 0
    while row < size {
        const offset = if row < half { half - row } else { row - half }
        const column = if left { x + offset } else { x + half - offset }
        canvas_module.fillRect(canvas, column, y + row, thickness, 1, color)
        row += 1
    }
}

fn drawButton(files: *Files, canvas: *Canvas, x: i32, hit: usize, active: bool) -> void {
    const top = (TOOLBAR - BUTTON) / 2
    if active {
        canvas_module.fillRoundedRect(canvas, x, top, BUTTON, BUTTON, 8, canvas_module.color(255, 66, 70, 84))
    } else if files.*.hover == hit {
        canvas_module.fillRoundedRect(canvas, x, top, BUTTON, BUTTON, 8, canvas_module.color(255, 50, 54, 66))
    }
}

fn drawGridGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, 6, 6, 2, color)
    canvas_module.fillRoundedRect(canvas, x + 8, y, 6, 6, 2, color)
    canvas_module.fillRoundedRect(canvas, x, y + 8, 6, 6, 2, color)
    canvas_module.fillRoundedRect(canvas, x + 8, y + 8, 6, 6, 2, color)
}

fn drawListGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    var row: i32 = 0
    while row < 3 {
        canvas_module.fillRoundedRect(canvas, x, y + row * 5, 3, 3, 1, color)
        canvas_module.fillRoundedRect(canvas, x + 5, y + row * 5, 11, 3, 1, color)
        row += 1
    }
}

// A magnifier: a ring and its handle.
fn drawSearchGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 11, 11, 5, 2, color)
    var step: i32 = 0
    while step < 5 {
        canvas_module.fillRect(canvas, x + 9 + step, y + 9 + step, 2, 2, color)
        step += 1
    }
}

// A house for the home folder.
fn drawHomeGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    var row: i32 = 0
    while row < 8 {
        canvas_module.fillRect(canvas, x + 9 - row, y + 1 + row, row * 2, 1, color)
        row += 1
    }
    canvas_module.fillRect(canvas, x + 3, y + 9, 12, 8, color)
    canvas_module.fillRect(canvas, x + 7, y + 12, 4, 5, canvas_module.color(255, 26, 28, 36))
}

// A screen on a stand for the computer.
fn drawComputerGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.fillRoundedRect(canvas, x + 1, y + 2, 16, 11, 2, color)
    canvas_module.fillRect(canvas, x + 3, y + 4, 12, 7, canvas_module.color(255, 26, 28, 36))
    canvas_module.fillRect(canvas, x + 7, y + 13, 4, 3, color)
    canvas_module.fillRect(canvas, x + 4, y + 16, 10, 2, color)
}

fn drawSidebar(files: *Files, canvas: *Canvas) -> void {
    const height = surfaceHeight(files)
    canvas_module.fillRect(canvas, 0, 0, SIDEBAR, height, canvas_module.color(214, 26, 28, 36))
    canvas_module.fillRect(canvas, SIDEBAR - 1, 0, 1, height, canvas_module.color(255, 18, 19, 25))
    const small = smallOf(files)
    const body = bodyOf(files)
    canvas_module.drawText(canvas, small, say(files, "Favorites", "Favoriten"), 18, 22, DIM_COLOR, 0)
    var index: usize = 0
    var locations_drawn = false
    while index < files.*.placeCount {
        const kind = files.*.placeKinds[index]
        const y = placeTop(files, index)
        if (kind == PLACE_COMPUTER || kind == PLACE_TRASH) && !locations_drawn {
            canvas_module.drawText(canvas, small, say(files, "Locations", "Orte"), 18, y - 22, DIM_COLOR, 0)
            locations_drawn = true
        }
        const active = placeActive(files, index)
        if active {
            canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, PLACE_ROW, 7, canvas_module.color(255, 58, 63, 78))
        } else if files.*.hover == HIT_PLACE + index {
            canvas_module.fillRoundedRect(canvas, 8, y, SIDEBAR - 16, PLACE_ROW, 7, canvas_module.color(255, 42, 45, 56))
        }
        const glyph = ACCENT
        const icon_y = y + (PLACE_ROW - 18) / 2
        if kind == PLACE_HOME {
            drawHomeGlyph(canvas, 16, icon_y, glyph)
        } else if kind == PLACE_COMPUTER {
            drawComputerGlyph(canvas, 16, icon_y, glyph)
        } else if kind == PLACE_TRASH {
            icons.drawTrash(canvas, 14, icon_y - 2, 22, places.trashFull(files.*.environment), false)
        } else {
            icons.drawFolder(small, canvas, pathText(placePathAt(files, index)), 15, icon_y, 20)
        }
        canvas_module.drawText(canvas, body, placeLabel(files, index), 44, y + (PLACE_ROW - 16) / 2, TEXT_COLOR, SIDEBAR - 56)
        index += 1
    }
}

fn drawToolbar(files: *Files, canvas: *Canvas) -> void {
    const width = surfaceWidth(files)
    canvas_module.fillRect(canvas, SIDEBAR, 0, width - SIDEBAR, TOOLBAR, canvas_module.color(255, 36, 38, 47))
    canvas_module.fillRect(canvas, SIDEBAR, TOOLBAR - 1, width - SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    const top = (TOOLBAR - BUTTON) / 2
    const can_back = files.*.backCount > 0
    const can_forward = files.*.forwardCount > 0
    drawButton(files, canvas, backX(), HIT_BACK, false)
    drawButton(files, canvas, forwardX(), HIT_FORWARD, false)
    drawChevron(canvas, backX() + 11, top + 9, true, if can_back { TEXT_COLOR } else { canvas_module.color(255, 80, 84, 96) })
    drawChevron(canvas, forwardX() + 12, top + 9, false, if can_forward { TEXT_COLOR } else { canvas_module.color(255, 80, 84, 96) })
    // The folder's name.
    const name = folderTitle(files)
    const title_x = forwardX() + BUTTON + 14
    const title_end = if files.*.inTrash { emptyTrashX(files) } else { gridButtonX(files) }
    canvas_module.drawText(canvas, titleOf(files), name, title_x, (TOOLBAR - 17) / 2, TEXT_COLOR, title_end - title_x - 12)
    // Grid or list.
    canvas_module.fillRoundedRect(canvas, gridButtonX(files), top, BUTTON * 2, BUTTON, 8, canvas_module.color(255, 44, 47, 58))
    drawButton(files, canvas, gridButtonX(files), HIT_GRID, !files.*.listView)
    drawButton(files, canvas, listButtonX(files), HIT_LIST, files.*.listView)
    drawGridGlyph(canvas, gridButtonX(files) + 8, top + 8, TEXT_COLOR)
    drawListGlyph(canvas, listButtonX(files) + 7, top + 8, TEXT_COLOR)
    // The trash's Empty button.
    if files.*.inTrash {
        const x = emptyTrashX(files)
        const lit = files.*.hover == HIT_EMPTY_TRASH
        canvas_module.fillRoundedRect(canvas, x, top, 110, BUTTON, 8, if lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
        const label = say(files, "Empty", "Leeren")
        canvas_module.drawText(canvas, bodyOf(files), label, x + (110 - canvas_module.measure(bodyOf(files), label)) / 2, top + 7, TEXT_COLOR, 0)
    }
    // The search field.
    const search_x = searchX(files)
    canvas_module.fillRoundedRect(canvas, search_x, top, SEARCH_WIDTH, BUTTON, 8, canvas_module.color(255, 26, 28, 35))
    if files.*.searchFocused { canvas_module.strokeRoundedRect(canvas, search_x - 1, top - 1, SEARCH_WIDTH + 2, BUTTON + 2, 9, 2, ACCENT) }
    drawSearchGlyph(canvas, search_x + 10, top + 8, DIM_COLOR)
    const search = searchText(files)
    const text_x = search_x + 32
    if search.length == 0 {
        if !files.*.searchFocused { canvas_module.drawText(canvas, bodyOf(files), say(files, "Search", "Suchen"), text_x, top + 7, DIM_COLOR, 0) }
    } else {
        canvas_module.drawText(canvas, bodyOf(files), search, text_x, top + 7, TEXT_COLOR, SEARCH_WIDTH - 40)
    }
    if files.*.searchFocused {
        const caret_x = text_x + canvas_module.measure(bodyOf(files), search)
        if caret_x < search_x + SEARCH_WIDTH - 8 { canvas_module.fillRect(canvas, caret_x + 1, top + 7, 2, 16, ACCENT) }
    }
}

fn drawStatus(files: *Files, canvas: *Canvas) -> void {
    const width = surfaceWidth(files)
    const height = surfaceHeight(files)
    const top = height - STATUS
    canvas_module.fillRect(canvas, SIDEBAR, top, width - SIDEBAR, STATUS, canvas_module.color(255, 34, 36, 45))
    canvas_module.fillRect(canvas, SIDEBAR, top, width - SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    const small = smallOf(files)
    // The path: the parts to click on.
    var x = SIDEBAR + 12
    var index: usize = 0
    const count = crumbCount(files)
    while index < count {
        var end: usize = 0
        const label = crumb(files, index, &end)
        const w = canvas_module.measure(small, label)
        if files.*.hover == HIT_CRUMB + index { canvas_module.fillRoundedRect(canvas, x - 5, top + 5, w + 10, STATUS - 10, 6, canvas_module.color(255, 52, 56, 68)) }
        canvas_module.drawText(canvas, small, label, x, top + 8, if index + 1 == count { TEXT_COLOR } else { DIM_COLOR }, 0)
        x += w
        if index + 1 < count {
            drawChevronSized(canvas, x + 8, top + 11, false, DIM_COLOR, 9, 2)
        }
        x += 22
        index += 1
    }
    // How many, or a note.
    var buffer: [160]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    var length: usize = 0
    var color = DIM_COLOR
    if files.*.noteLength > 0 {
        length = writeText(text, 0, noteText(files))
        color = canvas_module.color(255, 240, 160, 90)
    } else {
        const selected = selectedCount(files)
        if selected > 0 {
            length = writeNumber(text, 0, selected)
            length = writeText(text, length, say(files, " of ", " von "))
            length = writeNumber(text, length, files.*.shownCount)
            length = writeText(text, length, say(files, " selected", " ausgewählt"))
        } else {
            length = writeNumber(text, 0, files.*.shownCount)
            length = writeText(text, length, if files.*.shownCount == 1 { say(files, " item", " Objekt") } else { say(files, " items", " Objekte") })
            var disk: std.fs.FileSystemStat = undefined
            if !files.*.inTrash && std.fs.fileSystemStatus(listedPath(files), &disk) == 0 {
                length = writeText(text, length, ", ")
                length = formatSize(files, @intCast(isize, disk.blocksAvailable) * disk.blockSize, text, length)
                length = writeText(text, length, say(files, " available", " verfügbar"))
            }
        }
    }
    const shown = text[0..length]
    const w = canvas_module.measure(small, shown)
    if x + 20 < width - 14 - w { canvas_module.drawText(canvas, small, shown, width - 14 - w, top + 8, color, 0) }
}

// Entry `index`'s icon in a `size` square at (x, y): its picture, a folder
// or a page; `faded` while cut.
fn drawEntryIcon(files: *Files, canvas: *Canvas, index: usize, x: i32, y: i32, size: i32, allow_thumb: bool) -> void {
    const entry = entryAt(files, index)
    const name = nameOf(files, entry)
    if entry.*.directory {
        icons.drawFolder(smallOf(files), canvas, name, x, y, size)
        return
    }
    if allow_thumb {
        const thumb = findThumb(files, index)
        if thumb != null {
            const image = thumb.?
            const w = @intCast(i32, image.*.width)
            canvas_module.drawImage(canvas, image, x + (size - w) / 2, y + (size - w) / 2, w, 255)
            return
        }
    }
    icons.drawFile(smallOf(files), canvas, name, x, y, size)
}

// A picture already read (drawDragIcon draws outside a frame).
fn findThumb(files: *Files, index: usize) -> ?*png.Image {
    var slot: usize = 0
    while slot < THUMBS {
        if files.*.thumbEntry[slot] == index && files.*.thumbState[slot] == 1 { return thumbAt(files, slot) }
        slot += 1
    }
    return null
}

// Whether the path of an entry was cut (it shows faded until pasted).
fn isCut(files: *Files, index: usize) -> bool {
    if !files.*.clipCut || files.*.clipCount == 0 { return false }
    var path: Path = undefined
    entryPath(files, index, &path)
    const clip = fieldBytes(files, @offsetOf(Files, "clip"))
    var at: usize = 0
    while at < files.*.clipLength {
        var end = at
        while clip[end] != 0 { end += 1 }
        if sameBytes(clip[at..end], pathText(&path)) { return true }
        at = end + 1
    }
    return false
}

// The field renaming an entry: the name typed, the caret.
fn drawEditor(files: *Files, canvas: *Canvas, x: i32, y: i32, width: i32, height: i32) -> void {
    const body = bodyOf(files)
    canvas_module.fillRoundedRect(canvas, x - 2, y - 2, width + 4, height + 4, 6, ACCENT)
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 5, canvas_module.color(255, 22, 24, 30))
    const text = editText(files)
    // Scrolled so the caret shows.
    const caret_at = canvas_module.measure(body, text[0..files.*.caret])
    var shift: i32 = 0
    if caret_at > width - 12 { shift = caret_at - (width - 12) }
    if files.*.editSelected { canvas_module.fillRect(canvas, x + 5 - shift, y + 3, caret_at, height - 6, canvas_module.color(255, 50, 90, 150)) }
    canvas_module.drawText(canvas, body, text, x + 5 - shift, y + (height - 16) / 2, TEXT_COLOR, width - 8 + shift)
    canvas_module.fillRect(canvas, x + 5 - shift + caret_at, y + 3, 2, height - 6, ACCENT)
}

fn drawGrid(files: *Files, canvas: *Canvas) -> void {
    const small = smallOf(files)
    const body = bodyOf(files)
    const top = contentTop(files)
    const bottom = contentBottom(files)
    const cell = cellWidth(files)
    var budget: usize = 6
    var index: usize = 0
    while index < files.*.shownCount {
        const x = itemX(files, index)
        const y = itemY(files, index)
        if y + CELL_HEIGHT > top && y < bottom {
            const at = files.*.shown[index]
            const entry = entryAt(files, at)
            const icon_x = x + (cell - GRID_ICON) / 2
            const icon_y = y + 6
            const drop_here = files.*.dropHover == at
            if entry.*.selected || drop_here {
                canvas_module.fillRoundedRect(canvas, icon_x - 6, icon_y - 4, GRID_ICON + 12, GRID_ICON + 8, 9, canvas_module.color(255, 58, 62, 76))
            } else if files.*.hover == index {
                canvas_module.fillRoundedRect(canvas, icon_x - 6, icon_y - 4, GRID_ICON + 12, GRID_ICON + 8, 9, canvas_module.color(255, 42, 45, 56))
            }
            if !entry.*.directory { const thumb = thumbOf(files, at, GRID_ICON, &budget) }
            drawEntryIcon(files, canvas, at, icon_x, icon_y, GRID_ICON, true)
            if isCut(files, at) { canvas_module.fillRect(canvas, icon_x, icon_y, GRID_ICON, GRID_ICON, canvas_module.color(150, 30, 32, 40)) }
            const name_y = icon_y + GRID_ICON + 8
            if files.*.editing == at {
                drawEditor(files, canvas, x + 4, name_y - 3, cell - 8, 22)
            } else {
                var buffer: [100]u8 = undefined
                var bytes: [*]u8 = undefined
                unsafe { bytes = @ptrCast([*]u8, &buffer) }
                const name = icons.fitText(small, nameOf(files, entry), cell - 12, bytes)
                const w = canvas_module.measure(small, name)
                const name_x = x + (cell - w) / 2
                if entry.*.selected { canvas_module.fillRoundedRect(canvas, name_x - 5, name_y - 2, w + 10, 18, 6, ACCENT) }
                canvas_module.drawText(canvas, small, name, name_x, name_y, if entry.*.hidden && !entry.*.selected { DIM_COLOR } else { TEXT_COLOR }, 0)
            }
        }
        index += 1
    }
}

fn drawListHeader(files: *Files, canvas: *Canvas) -> void {
    const width = surfaceWidth(files)
    const small = smallOf(files)
    canvas_module.fillRect(canvas, SIDEBAR, TOOLBAR, width - SIDEBAR, HEADER, BACKGROUND)
    canvas_module.fillRect(canvas, SIDEBAR + 8, TOOLBAR + HEADER - 1, width - SIDEBAR - 16, 1, canvas_module.color(255, 52, 56, 66))
    const y = TOOLBAR + 7
    drawColumnTitle(files, canvas, say(files, "Name", "Name"), SIDEBAR + 44, y, SORT_NAME, false)
    if dateColumn(files) > 0 { drawColumnTitle(files, canvas, say(files, "Date Modified", "Änderungsdatum"), dateColumn(files), y, SORT_DATE, false) }
    if sizeColumnRight(files) > 0 { drawColumnTitle(files, canvas, say(files, "Size", "Größe"), sizeColumnRight(files), y, SORT_SIZE, true) }
    if kindColumn(files) > 0 { drawColumnTitle(files, canvas, say(files, "Kind", "Art"), kindColumn(files), y, SORT_KIND, false) }
}

// A column's title (right-aligned at x for `right`), with a triangle when
// the list is sorted by it.
fn drawColumnTitle(files: *Files, canvas: *Canvas, title: []const u8, x: i32, y: i32, key: usize, right: bool) -> void {
    const small = smallOf(files)
    const w = canvas_module.measure(small, title)
    const left = if right { x - w } else { x }
    const sorted = files.*.sortKey == key
    canvas_module.drawText(canvas, small, title, left, y, if sorted { TEXT_COLOR } else { DIM_COLOR }, 0)
    if !sorted { return }
    // Down for the usual order, up reversed.
    const tip_x = if right { left - 12 } else { left + w + 6 }
    var row: i32 = 0
    while row < 4 {
        const half = if files.*.sortReversed { row } else { 3 - row }
        canvas_module.fillRect(canvas, tip_x + 3 - half, y + 5 + row, half * 2 + 1, 1, DIM_COLOR)
        row += 1
    }
}

fn drawList(files: *Files, canvas: *Canvas) -> void {
    const width = surfaceWidth(files)
    const small = smallOf(files)
    const body = bodyOf(files)
    const top = contentTop(files)
    const bottom = contentBottom(files)
    const name_x = SIDEBAR + 44
    const limit = nameLimit(files)
    var index: usize = 0
    var buffer: [160]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    const today = localDay(files, clock.now())
    while index < files.*.shownCount {
        const y = itemY(files, index)
        if y + ROW > top && y < bottom {
            const at = files.*.shown[index]
            const entry = entryAt(files, at)
            const selected = entry.*.selected
            if selected {
                canvas_module.fillRoundedRect(canvas, SIDEBAR + 8, y, width - SIDEBAR - 16, ROW, 6, if files.*.searchFocused { canvas_module.color(255, 70, 76, 92) } else { ACCENT })
            } else if files.*.dropHover == at {
                canvas_module.fillRoundedRect(canvas, SIDEBAR + 8, y, width - SIDEBAR - 16, ROW, 6, canvas_module.color(255, 58, 62, 76))
            } else if index % 2 == 1 {
                canvas_module.fillRoundedRect(canvas, SIDEBAR + 8, y, width - SIDEBAR - 16, ROW, 6, canvas_module.color(255, 35, 37, 46))
            }
            drawEntryIcon(files, canvas, at, SIDEBAR + 18, y + (ROW - LIST_ICON) / 2, LIST_ICON, false)
            if isCut(files, at) { canvas_module.fillRect(canvas, SIDEBAR + 18, y + (ROW - LIST_ICON) / 2, LIST_ICON, LIST_ICON, canvas_module.color(150, 30, 32, 40)) }
            const color = if selected { canvas_module.color(255, 255, 255, 255) } else if entry.*.hidden { DIM_COLOR } else { TEXT_COLOR }
            const dim = if selected { canvas_module.color(255, 225, 235, 255) } else { DIM_COLOR }
            if files.*.editing == at {
                drawEditor(files, canvas, name_x - 4, y + 2, limit, ROW - 4)
            } else {
                var name_buffer: [100]u8 = undefined
                var name_bytes: [*]u8 = undefined
                unsafe { name_bytes = @ptrCast([*]u8, &name_buffer) }
                canvas_module.drawText(canvas, body, icons.fitText(body, nameOf(files, entry), limit, name_bytes), name_x, y + 5, color, 0)
            }
            if dateColumn(files) > 0 {
                const modified = @intCast(i64, entry.*.modified)
                const time = clock.civil(modified + clock.offsetAt(zoneOf(files), modified))
                const length = clock.formatDate(&time, today - clock.daysFromCivil(time.year, time.month, time.day), files.*.german, text)
                canvas_module.drawText(canvas, small, text[0..length], dateColumn(files), y + 6, dim, 0)
            }
            if sizeColumnRight(files) > 0 {
                var length: usize = 0
                if entry.*.directory {
                    length = writeText(text, 0, "--")
                } else {
                    length = formatSize(files, entry.*.size, text, 0)
                }
                const shown = text[0..length]
                canvas_module.drawText(canvas, small, shown, sizeColumnRight(files) - canvas_module.measure(small, shown), y + 6, dim, 0)
            }
            if kindColumn(files) > 0 {
                const length = kindOf(files, entry, text)
                canvas_module.drawText(canvas, small, text[0..length], kindColumn(files), y + 6, dim, width - kindColumn(files) - 16)
            }
        }
        index += 1
    }
}

// The day number of a moment in the local time zone.
fn localDay(files: *Files, utc: i64) -> i64 {
    const time = clock.civil(utc + clock.offsetAt(zoneOf(files), utc))
    return clock.daysFromCivil(time.year, time.month, time.day)
}

// A thin bar at the right while there is more to scroll to.
fn drawScrollbar(files: *Files, canvas: *Canvas) -> void {
    const most = maxScroll(files)
    if most <= 0 { return }
    const top = contentTop(files) + 4
    const view = contentBottom(files) - 4 - top
    const total = contentHeight(files)
    var thumb = view * view / total
    if thumb < 30 { thumb = 30 }
    const y = top + (view - thumb) * files.*.scroll / most
    canvas_module.fillRoundedRect(canvas, surfaceWidth(files) - 9, y, 5, thumb, 3, canvas_module.color(110, 200, 205, 215))
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const files = filesOf(context)
    const width = surfaceWidth(files)
    const height = surfaceHeight(files)
    canvas_module.clear(canvas, 0)
    canvas_module.fillRect(canvas, SIDEBAR, 0, width - SIDEBAR, height, BACKGROUND)
    // The files first: the bars are drawn over what scrolls under them.
    if files.*.unreadable {
        const message = say(files, "This folder can't be read", "Dieser Ordner kann nicht gelesen werden")
        canvas_module.drawText(canvas, bodyOf(files), message, SIDEBAR + (width - SIDEBAR - canvas_module.measure(bodyOf(files), message)) / 2, contentTop(files) + 60, DIM_COLOR, 0)
    } else if files.*.shownCount == 0 {
        const message = if files.*.searchLength > 0 { say(files, "No matches", "Keine Treffer") } else if files.*.inTrash { say(files, "The trash is empty", "Der Papierkorb ist leer") } else { say(files, "This folder is empty", "Dieser Ordner ist leer") }
        canvas_module.drawText(canvas, bodyOf(files), message, SIDEBAR + (width - SIDEBAR - canvas_module.measure(bodyOf(files), message)) / 2, contentTop(files) + 60, DIM_COLOR, 0)
    } else if files.*.listView {
        drawList(files, canvas)
    } else {
        drawGrid(files, canvas)
    }
    // Files dragged over the folder itself.
    if files.*.dropping && files.*.dropHover == NONE && !files.*.inTrash {
        canvas_module.strokeRoundedRect(canvas, SIDEBAR + 3, TOOLBAR + 3, width - SIDEBAR - 6, height - TOOLBAR - STATUS - 6, 8, 2, ACCENT)
    }
    // The selecting rectangle.
    if files.*.pressed && files.*.banding {
        const left = if files.*.pressX < files.*.pointerX { files.*.pressX } else { files.*.pointerX }
        const top = if files.*.pressY < files.*.pointerY { files.*.pressY } else { files.*.pointerY }
        const w = if files.*.pressX < files.*.pointerX { files.*.pointerX - files.*.pressX } else { files.*.pressX - files.*.pointerX }
        const h = if files.*.pressY < files.*.pointerY { files.*.pointerY - files.*.pressY } else { files.*.pressY - files.*.pointerY }
        canvas_module.fillRect(canvas, left, top, w, h, canvas_module.color(50, 90, 160, 255))
        canvas_module.strokeRoundedRect(canvas, left, top, w, h, 0, 1, canvas_module.color(200, 90, 160, 255))
    }
    drawScrollbar(files, canvas)
    if files.*.listView { drawListHeader(files, canvas) }
    drawToolbar(files, canvas)
    drawStatus(files, canvas)
    drawSidebar(files, canvas)
}

// ---------------------------------------------------------------------------
// Starting

const Failure = error { NoMemory, NoHome }

fn noMemory() -> Failure!void { return Failure.NoMemory }

fn allocate(files: *Files, bytes: usize) -> ?[*]u8 {
    return files.*.allocator.alloc(bytes, 16)
}

// Where to start: the argument (a path, a file:// URI, trash:///), else
// the home folder; a file's folder with the file selected.
fn startAt(files: *Files, arguments: [][*]const u8) -> void {
    var target: Path = undefined
    apps_module.pathClear(&target)
    var select_name: [256]u8 = undefined
    var select_length: usize = 0
    if arguments.length > 1 {
        const argument = arguments[1]
        var length: usize = 0
        while argument[length] != 0 { length += 1 }
        const text = argument[0..length]
        if length >= 6 && sameBytes(text[0..6], "trash:") {
            goTrash(files)
            files.*.backCount = 0
            return
        }
        if length >= 7 && sameBytes(text[0..7], "file://") {
            const found = places.uriPath(text, 0, &target)
        } else if length > 0 && text[0] != 47 {
            var cwd: [1024]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &cwd) }
            if std.fs.getWorkingDirectory(bytes, 1024) > 0 {
                apps_module.pathAddC(&target, bytes)
                apps_module.pathAdd(&target, "/")
            }
            apps_module.pathAdd(&target, text)
        } else {
            apps_module.pathAdd(&target, text)
        }
    }
    if target.length > 0 && !places.isDirectory(apps_module.pathEnd(&target)) {
        const base = places.baseName(pathText(&target))
        for byte in base {
            if select_length < 256 {
                select_name[select_length] = byte
                select_length += 1
            }
        }
        parentOf(&target)
    }
    if target.length == 0 || !places.isDirectory(apps_module.pathEnd(&target)) {
        apps_module.pathClear(&target)
        const home = homeOf(files)
        if @intFromPtr(home) != 0 { apps_module.pathAdd(&target, home[0..homeLength(files)]) } else { apps_module.pathAdd(&target, "/") }
    }
    const shown = go(files, pathText(&target), false, false)
    var index: usize = 0
    while select_length > 0 && index < files.*.count {
        if sameBytes(nameOf(files, entryAt(files, index)), select_name[0..select_length]) {
            selectOnly(files, index)
            revealCursor(files)
        }
        index += 1
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    crash.install()
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Files), 16)
    if memory == null { return noMemory() }
    var files: *Files = undefined
    unsafe { files = @ptrCast(*Files, memory.?) }
    files.*.allocator = allocator
    files.*.environment = environment
    files.*.terminal = apps_module.environmentValue(environment, "MLX_TERMINAL")
    files.*.german = clock.germanLocale(environment)
    clock.load(zoneOf(files), environment, allocator)
    const entries = allocate(files, MAX_ENTRIES * @sizeOf(Entry))
    const names = allocate(files, NAMES)
    const order = allocate(files, MAX_ENTRIES * 8)
    const scratch = allocate(files, MAX_ENTRIES * 8)
    const shown = allocate(files, MAX_ENTRIES * 8)
    const band = allocate(files, MAX_ENTRIES)
    if entries == null || names == null || order == null || scratch == null || shown == null || band == null { return noMemory() }
    unsafe {
        files.*.entries = @ptrCast([*]Entry, entries.?)
        files.*.names = names.?
        files.*.order = @ptrCast([*]usize, order.?)
        files.*.scratch = @ptrCast([*]usize, scratch.?)
        files.*.shown = @ptrCast([*]usize, shown.?)
        files.*.bandBase = @ptrCast([*]bool, band.?)
    }
    files.*.cursor = NONE
    files.*.anchor = NONE
    files.*.hover = NONE
    files.*.pressHit = NONE
    files.*.lastClickHit = NONE
    files.*.dropHover = NONE
    files.*.editing = NONE
    files.*.menuEntry = NONE
    files.*.sortKey = SORT_NAME
    files.*.listView = false
    var slot: usize = 0
    while slot < THUMBS {
        files.*.thumbState[slot] = 0
        files.*.thumbEntry[slot] = NONE
        slot += 1
    }
    const loaded_body = canvas_module.loadText(bodyOf(files), 13, allocator)
    const loaded_small = canvas_module.loadText(smallOf(files), 12, allocator)
    const loaded_title = canvas_module.loadText(titleOf(files), 16, allocator)
    findPlaces(files)
    startAt(files, arguments)

    const panel = panelOf(files)
    panel.*.context = @ptrCast(*anyopaque, files)
    panel.*.draw = draw
    panel.*.event = onEvent
    try panel_module.openWindow(panel, allocator, arguments, "Files", "org.mlx.files", @intCast(u32, WIDTH), @intCast(u32, HEIGHT))
    panel.*.toplevel.setMinSize(MIN_WIDTH, MIN_HEIGHT)
    setTitle(files)
    panel_module.acceptDrops(panel, "text/uri-list")
    panel_module.report(panel, "mlx-files")
    panel.*.tickInterval = 250
    try panel_module.run(panel)
    panel_module.close(panel)
}
