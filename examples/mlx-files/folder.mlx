// Reading a folder, pictures, going places and the sidebar's places (part of main.mlx, split from it).
const std = @import("std")
const png = @import("std.png")
const apps_module = @import("../desktop-shared/apps.mlx")
const panel_module = @import("../desktop-shared/panel.mlx")
const places = @import("../desktop-shared/places.mlx")
const thumbs_module = @import("../desktop-shared/thumbs.mlx")
const app = @import("./main.mlx")
const input_module = @import("./input.mlx")
const drawing_module = @import("./drawing.mlx")

// ---------------------------------------------------------------------------
// Reading a folder

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

pub fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

// Names compared as people read them: letters in any case, runs of digits
// by their value. Negative, 0 or positive.
fn compareNames(first: []const u8, second: []const u8) -> i32 {
    var i: usize = 0
    var j: usize = 0
    while i < first.length && j < second.length {
        if isDigit(first[i]) && isDigit(second[j]) {
            var end_i = i
            while end_i < first.length && isDigit(first[end_i]) { end_i += 1 }
            var end_j = j
            while end_j < second.length && isDigit(second[end_j]) { end_j += 1 }
            var start_i = i
            while start_i + 1 < end_i && first[start_i] == 48 { start_i += 1 }
            var start_j = j
            while start_j + 1 < end_j && second[start_j] == 48 { start_j += 1 }
            if end_i - start_i != end_j - start_j { return if end_i - start_i < end_j - start_j { -1 } else { 1 } }
            while start_i < end_i {
                if first[start_i] != second[start_j] { return if first[start_i] < second[start_j] { -1 } else { 1 } }
                start_i += 1
                start_j += 1
            }
            i = end_i
            j = end_j
        } else {
            const a = lower(first[i])
            const b = lower(second[j])
            if a != b { return if a < b { -1 } else { 1 } }
            i += 1
            j += 1
        }
    }
    const rest_i = first.length - i
    const rest_j = second.length - j
    if rest_i != rest_j { return if rest_i < rest_j { -1 } else { 1 } }
    // The same but for case: the bytes decide.
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return if first[index] < second[index] { -1 } else { 1 } }
        index += 1
    }
    return 0
}

// The extension of a name ("png"), empty without one.
pub fn extensionOf(name: []const u8) -> []const u8 {
    var dot = name.length
    while dot > 1 && name[dot - 1] != 46 { dot -= 1 }
    if dot <= 1 { return name[0..0] }
    return name[dot..name.length]
}

// Whether entry `a` goes before entry `b`: folders first, then by the sort
// key (names for the rest).
fn before(files: *app.Files, a: usize, b: usize) -> bool {
    const first = app.entryAt(files, a)
    const second = app.entryAt(files, b)
    if first.*.directory != second.*.directory { return first.*.directory }
    var order: i32 = 0
    if files.*.sortKey == app.SORT_DATE {
        if first.*.modified != second.*.modified { order = if first.*.modified > second.*.modified { -1 } else { 1 } }
    } else if files.*.sortKey == app.SORT_SIZE {
        if first.*.size != second.*.size { order = if first.*.size > second.*.size { -1 } else { 1 } }
    } else if files.*.sortKey == app.SORT_KIND {
        order = compareNames(extensionOf(app.nameOf(files, first)), extensionOf(app.nameOf(files, second)))
    }
    if order == 0 { order = compareNames(app.nameOf(files, first), app.nameOf(files, second)) }
    if files.*.sortReversed { order = -order }
    return order < 0
}

// Sorts `order` (merge sort, bottom up, through `scratch`).
pub fn sortEntries(files: *app.Files) -> void {
    const count = files.*.count
    var index: usize = 0
    while index < count {
        files.*.order[index] = index
        index += 1
    }
    var width: usize = 1
    var source = files.*.order
    var target = files.*.scratch
    while width < count {
        var start: usize = 0
        while start < count {
            const middle = if start + width < count { start + width } else { count }
            const end = if start + width * 2 < count { start + width * 2 } else { count }
            var left = start
            var right = middle
            var at = start
            while at < end {
                if left < middle && (right >= end || !before(files, source[right], source[left])) {
                    target[at] = source[left]
                    left += 1
                } else {
                    target[at] = source[right]
                    right += 1
                }
                at += 1
            }
            start = end
        }
        const swap = source
        source = target
        target = swap
        width = width * 2
    }
    if @intFromPtr(source) != @intFromPtr(files.*.order) {
        index = 0
        while index < count {
            files.*.order[index] = source[index]
            index += 1
        }
    }
}

// Which entries show: hidden ones only when asked for, and those the
// search matches.
pub fn buildShown(files: *app.Files) -> void {
    files.*.shownCount = 0
    const search = app.searchText(files)
    var index: usize = 0
    while index < files.*.count {
        const at = files.*.order[index]
        const entry = app.entryAt(files, at)
        if (!entry.*.hidden || files.*.showHidden) && apps_module.containsText(app.nameOf(files, entry), search) {
            files.*.shown[files.*.shownCount] = at
            files.*.shownCount += 1
        } else {
            entry.*.selected = false
        }
        index += 1
    }
    if files.*.cursor != app.NONE && shownIndexOf(files, files.*.cursor) == app.NONE { files.*.cursor = app.NONE }
    drawing_module.clampScroll(files)
}

// Where entry `entry` is among those shown, NONE when it is not.
pub fn shownIndexOf(files: *app.Files, entry: usize) -> usize {
    var index: usize = 0
    while index < files.*.shownCount {
        if files.*.shown[index] == entry { return index }
        index += 1
    }
    return app.NONE
}

// The directory read for the folder shown.
pub fn listedPath(files: *app.Files) -> [*]const u8 { return apps_module.pathEnd(app.pathOf(files)) }

// Its modification time now (entries added, removed or renamed change it).
pub fn directoryChanged(files: *app.Files) -> bool {
    var status: std.fs.Stat = undefined
    if std.fs.status(listedPath(files), &status) != 0 { return files.*.changedSeconds != -1 }
    return status.modifiedSeconds != files.*.changedSeconds || status.modifiedNanoseconds != files.*.changedNanoseconds
}

// Reads the folder again.
pub fn load(files: *app.Files) -> void {
    files.*.count = 0
    files.*.namesUsed = 0
    files.*.unreadable = false
    dropThumbs(files)
    var status: std.fs.Stat = undefined
    files.*.changedSeconds = -1
    files.*.changedNanoseconds = 0
    if std.fs.status(listedPath(files), &status) == 0 {
        files.*.changedSeconds = status.modifiedSeconds
        files.*.changedNanoseconds = status.modifiedNanoseconds
    }
    const handle = std.linux.syscall3(app.SYS_open, @intFromPtr(listedPath(files)), app.O_DIRECTORY | app.O_CLOEXEC, 0)
    if handle < 0 {
        files.*.unreadable = true
        buildShown(files)
        return
    }
    const directory = std.fs.File.{ .descriptor = handle }
    var buffer: [16384]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var full = false
    var reader = std.fs.entries(directory, bytes, 16384)
    var record: std.fs.Entry = undefined
    while !full && std.fs.nextEntry(&reader, &record) {
        const kind = record.kind
        const name = record.name.pointer
        const length = record.name.length
        const dots = std.fs.isDotName(record.name)
        if !dots && length > 0 {
            if files.*.count >= app.MAX_ENTRIES || files.*.namesUsed + length > app.NAMES {
                full = true
            } else {
                const entry = app.entryAt(files, files.*.count)
                entry.*.name = files.*.namesUsed
                entry.*.nameLength = length
                var byte: usize = 0
                while byte < length {
                    files.*.names[files.*.namesUsed + byte] = name[byte]
                    byte += 1
                }
                files.*.namesUsed += length
                entry.*.hidden = name[0] == 46
                entry.*.selected = false
                entry.*.link = kind == 10
                entry.*.size = 0
                entry.*.modified = 0
                entry.*.directory = kind == 4
                entry.*.executable = false
                var found = std.fs.statusFrom(directory, name, &status, false) == 0
                if !found { found = std.fs.statusFrom(directory, name, &status, true) == 0 }
                if found {
                    entry.*.directory = status.mode & 61440 == 16384
                    entry.*.executable = !entry.*.directory && status.mode & 73 != 0
                    entry.*.size = status.size
                    entry.*.modified = status.modifiedSeconds
                }
                files.*.count += 1
            }
        }
    }
    const closed = std.fs.close(directory)
    sortEntries(files)
    buildShown(files)
}

// Reads the folder again keeping the selection and the cursor (by name).
pub fn reload(files: *app.Files) -> void {
    files.*.keepLength = 0
    files.*.keepCursorLength = 0
    var index: usize = 0
    while index < files.*.count {
        const entry = app.entryAt(files, index)
        const name = app.nameOf(files, entry)
        if entry.*.selected && files.*.keepLength + name.length + 1 <= 8192 {
            for byte in name {
                files.*.keep[files.*.keepLength] = byte
                files.*.keepLength += 1
            }
            files.*.keep[files.*.keepLength] = 0
            files.*.keepLength += 1
        }
        if index == files.*.cursor && name.length <= 256 {
            for byte in name {
                files.*.keepCursor[files.*.keepCursorLength] = byte
                files.*.keepCursorLength += 1
            }
        }
        index += 1
    }
    const scroll = files.*.scroll
    files.*.cursor = app.NONE
    load(files)
    const cursor_name = app.fieldBytes(files, @offsetOf(app.Files, "keepCursor"))[0..files.*.keepCursorLength]
    const kept = app.fieldBytes(files, @offsetOf(app.Files, "keep"))
    index = 0
    while index < files.*.count {
        const entry = app.entryAt(files, index)
        const name = app.nameOf(files, entry)
        if files.*.keepCursorLength > 0 && std.text.same(name, cursor_name) { files.*.cursor = index }
        var at: usize = 0
        while at < files.*.keepLength {
            var end = at
            while kept[end] != 0 { end += 1 }
            if std.text.same(name, kept[at..end]) { entry.*.selected = true }
            at = end + 1
        }
        index += 1
    }
    files.*.anchor = files.*.cursor
    buildShown(files)
    files.*.scroll = scroll
    drawing_module.clampScroll(files)
}

// ---------------------------------------------------------------------------
// Pictures

pub fn picturesOf(files: *app.Files) -> *thumbs_module.Thumbs {
    unsafe { return @ptrCast(*thumbs_module.Thumbs, &files.*.pictures) }
}

// Frees slot `slot`'s picture. The GPU knows its images by where their
// pixels are, and a new picture may come where this one was: it forgets
// them all (they are uploaded again as drawn).
fn freeThumb(files: *app.Files, slot: usize) -> void {
    if files.*.thumbState[slot] == 1 {
        png.deinit(app.thumbAt(files, slot))
        panel_module.forgetImages(app.panelOf(files))
    }
    files.*.thumbState[slot] = 0
    files.*.thumbEntry[slot] = app.NONE
}

fn dropThumbs(files: *app.Files) -> void {
    var slot: usize = 0
    while slot < app.THUMBS {
        freeThumb(files, slot)
        slot += 1
    }
    files.*.thumbNext = 0
    thumbs_module.clearQueue(picturesOf(files))
}

// The picture of entry `index` fitted into a `size` square: from the
// thumbnail cache (a few each frame: `budget`), made by the thumbnail
// worker when missing (desktop-shared/thumbs.mlx); null until then. Never
// waits on the file itself.
pub fn thumbOf(files: *app.Files, index: usize, size: i32, budget: *usize) -> ?*png.Image {
    var slot: usize = 0
    while slot < app.THUMBS {
        if files.*.thumbEntry[slot] == index {
            if files.*.thumbState[slot] == 1 { return app.thumbAt(files, slot) }
            return null
        }
        slot += 1
    }
    if budget.* == 0 {
        files.*.thumbsPending = true
        return null
    }
    budget.* -= 1
    slot = files.*.thumbNext
    files.*.thumbNext = (slot + 1) % app.THUMBS
    freeThumb(files, slot)
    files.*.thumbEntry[slot] = index
    files.*.thumbState[slot] = 2
    var path: app.Path = undefined
    app.entryPath(files, index, &path)
    const found = thumbs_module.lookup(picturesOf(files), app.pathText(&path), app.entryAt(files, index).*.modified, @intCast(usize, size), app.thumbAt(files, slot))
    if found == thumbs_module.COMING {
        files.*.thumbState[slot] = 3
        files.*.thumbsPending = true
        return null
    }
    if found != thumbs_module.READY { return null }
    files.*.thumbState[slot] = 1
    return app.thumbAt(files, slot)
}

// Pictures the worker was making: looked up again.
pub fn recheckThumbs(files: *app.Files) -> bool {
    var again = false
    var slot: usize = 0
    while slot < app.THUMBS {
        if files.*.thumbState[slot] == 3 {
            freeThumb(files, slot)
            again = true
        }
        slot += 1
    }
    return again
}

// ---------------------------------------------------------------------------
// Going places

// The folder's name: its directory's, "Computer" for /, the trash's.
pub fn folderTitle(files: *app.Files) -> []const u8 {
    if files.*.inTrash { return app.say(files, "Trash", "Papierkorb") }
    if app.pathOf(files).*.length == 1 { return app.say(files, "Computer", "Computer") }
    return places.baseName(app.pathText(app.pathOf(files)))
}

pub fn setTitle(files: *app.Files) -> void {
    const panel = app.panelOf(files)
    if !panel.*.hasSurface { return }
    panel.*.toplevel.setTitle(folderTitle(files))
}

// Shows the folder `text` (the trash for `trash`), remembering where we
// were for Back when `remember`.
pub fn go(files: *app.Files, text: []const u8, trash: bool, remember: bool) -> bool {
    var target: app.Path = undefined
    apps_module.pathClear(&target)
    apps_module.pathAdd(&target, text)
    while target.length > 1 && target.bytes[target.length - 1] == 47 { target.length -= 1 }
    if !trash && !places.isDirectory(apps_module.pathEnd(&target)) {
        app.setNote(files, app.say(files, "Can't open ", "Kann nicht geöffnet werden: "), text)
        return false
    }
    if remember {
        if files.*.backCount == app.HISTORY {
            var index: usize = 1
            while index < app.HISTORY {
                app.copyPath(app.backAt(files, index - 1), app.backAt(files, index))
                index += 1
            }
            files.*.backCount -= 1
        }
        app.copyPath(app.backAt(files, files.*.backCount), app.pathOf(files))
        files.*.backCount += 1
        files.*.forwardCount = 0
    }
    app.copyPath(app.pathOf(files), &target)
    files.*.inTrash = trash
    files.*.cursor = app.NONE
    files.*.anchor = app.NONE
    files.*.scroll = 0
    files.*.editing = app.NONE
    files.*.searchLength = 0
    files.*.searchFocused = false
    load(files)
    setTitle(files)
    app.panelOf(files).*.dirty = true
    return true
}

// Whether `text` is the trash's files directory.
fn isTrashPath(files: *app.Files, text: []const u8) -> bool {
    var trash: app.Path = undefined
    if !places.trashPath(files.*.environment, &trash) { return false }
    apps_module.pathAdd(&trash, "/files")
    return std.text.same(app.pathText(&trash), text)
}

fn goHistory(files: *app.Files, path: *app.Path) -> void {
    const text = app.pathText(path)
    const shown = go(files, text, isTrashPath(files, text), false)
}

fn pushCurrent(files: *app.Files, into: *app.Path) -> void {
    app.copyPath(into, app.pathOf(files))
}

pub fn goBack(files: *app.Files) -> void {
    if files.*.backCount == 0 { return }
    if files.*.forwardCount < app.HISTORY {
        pushCurrent(files, app.forwardAt(files, files.*.forwardCount))
        files.*.forwardCount += 1
    }
    files.*.backCount -= 1
    var target: app.Path = undefined
    app.copyPath(&target, app.backAt(files, files.*.backCount))
    goHistory(files, &target)
}

pub fn goForward(files: *app.Files) -> void {
    if files.*.forwardCount == 0 { return }
    if files.*.backCount < app.HISTORY {
        pushCurrent(files, app.backAt(files, files.*.backCount))
        files.*.backCount += 1
    }
    files.*.forwardCount -= 1
    var target: app.Path = undefined
    app.copyPath(&target, app.forwardAt(files, files.*.forwardCount))
    goHistory(files, &target)
}

// The parent folder, with the folder we came from selected.
pub fn goUp(files: *app.Files) -> void {
    if files.*.inTrash || app.pathOf(files).*.length <= 1 { return }
    var name: [256]u8 = undefined
    const base = places.baseName(app.pathText(app.pathOf(files)))
    var length: usize = 0
    for byte in base {
        if length < 256 {
            name[length] = byte
            length += 1
        }
    }
    var parent: app.Path = undefined
    app.copyPath(&parent, app.pathOf(files))
    app.parentOf(&parent)
    if !go(files, app.pathText(&parent), false, true) { return }
    var index: usize = 0
    while index < files.*.count {
        if std.text.same(app.nameOf(files, app.entryAt(files, index)), name[0..length]) {
            input_module.selectOnly(files, index)
            drawing_module.revealCursor(files)
        }
        index += 1
    }
}

pub fn goTrash(files: *app.Files) -> void {
    var trash: app.Path = undefined
    if !places.trashPath(files.*.environment, &trash) { return }
    apps_module.pathAdd(&trash, "/files")
    const made = std.fs.makeDir(apps_module.pathEnd(&trash), 448)
    const shown = go(files, app.pathText(&trash), true, true)
}

// Opens entry `index`: a folder here, a file with its app.
fn openEntry(files: *app.Files, index: usize) -> void {
    var path: app.Path = undefined
    app.entryPath(files, index, &path)
    if app.entryAt(files, index).*.directory && !files.*.inTrash {
        const shown = go(files, app.pathText(&path), false, true)
        return
    }
    places.open(app.pathText(&path), files.*.environment)
}

pub fn openSelected(files: *app.Files) -> void {
    // Folders: the first one (we can show one); files: all of them.
    var index: usize = 0
    var folder = app.NONE
    while index < files.*.shownCount {
        const at = files.*.shown[index]
        const entry = app.entryAt(files, at)
        if entry.*.selected {
            if entry.*.directory && !files.*.inTrash {
                if folder == app.NONE { folder = at }
            } else {
                openEntry(files, at)
            }
        }
        index += 1
    }
    if folder != app.NONE { openEntry(files, folder) }
}

// ---------------------------------------------------------------------------
// The sidebar's places

fn addPlace(files: *app.Files, kind: u8, path: []const u8) -> void {
    if files.*.placeCount >= app.MAX_PLACES { return }
    const index = files.*.placeCount
    files.*.placeKinds[index] = kind
    const place = app.placePathAt(files, index)
    apps_module.pathClear(place)
    apps_module.pathAdd(place, path)
    files.*.placeCount += 1
}

// A folder of the user's (XDG_DOWNLOAD_DIR in ~/.config/user-dirs.dirs,
// else HOME/`fallback`) when it exists and is not the home itself.
fn addUserFolder(files: *app.Files, text: []const u8, key: []const u8, fallback: []const u8) -> void {
    var path: app.Path = undefined
    apps_module.pathClear(&path)
    // KEY="$HOME/Downloads"
    var at: usize = 0
    var found = false
    while at < text.length && !found {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        if line.length > key.length + 2 && std.text.same(line[0..key.length], key) && line[key.length] == 61 {
            var value_start = key.length + 1
            var value_end = line.length
            if line[value_start] == 34 { value_start += 1 }
            if value_end > value_start && line[value_end - 1] == 34 { value_end -= 1 }
            const value = line[value_start..value_end]
            if value.length >= 5 && std.text.same(value[0..5], "$HOME") {
                apps_module.pathAddC(&path, app.homeOf(files))
                apps_module.pathAdd(&path, value[5..value.length])
            } else {
                apps_module.pathAdd(&path, value)
            }
            found = true
        }
        at = end + 1
    }
    if !found {
        apps_module.pathAddC(&path, app.homeOf(files))
        apps_module.pathAdd(&path, "/")
        apps_module.pathAdd(&path, fallback)
    }
    while path.length > 1 && path.bytes[path.length - 1] == 47 { path.length -= 1 }
    if path.length == app.homeLength(files) { return }
    if !places.isDirectory(apps_module.pathEnd(&path)) { return }
    addPlace(files, app.PLACE_FOLDER, app.pathText(&path))
}

pub fn findPlaces(files: *app.Files) -> void {
    files.*.placeCount = 0
    const home = app.homeOf(files)
    if @intFromPtr(home) != 0 {
        addPlace(files, app.PLACE_HOME, home[0..app.homeLength(files)])
        // ~/.config/user-dirs.dirs names the folders (in the user's
        // language: Dokumente, Bilder).
        var dirs: app.Path = undefined
        apps_module.pathClear(&dirs)
        const config = apps_module.environmentValue(files.*.environment, "XDG_CONFIG_HOME")
        if @intFromPtr(config) != 0 && config[0] != 0 {
            apps_module.pathAddC(&dirs, config)
        } else {
            apps_module.pathAddC(&dirs, home)
            apps_module.pathAdd(&dirs, "/.config")
        }
        apps_module.pathAdd(&dirs, "/user-dirs.dirs")
        var contents: std.fs.ArrayList = undefined
        const file = std.fs.open(apps_module.pathEnd(&dirs), 0, 0)
        var loaded = false
        if std.fs.isValid(file) {
            contents = std.fs.readToEndAlloc(file, files.*.allocator)
            const closed = std.fs.close(file)
            loaded = true
        }
        const known = if loaded { contents.items[0..contents.length] } else { "" }
        addUserFolder(files, known, "XDG_DESKTOP_DIR", "Desktop")
        addUserFolder(files, known, "XDG_DOCUMENTS_DIR", "Documents")
        addUserFolder(files, known, "XDG_DOWNLOAD_DIR", "Downloads")
        addUserFolder(files, known, "XDG_PICTURES_DIR", "Pictures")
        addUserFolder(files, known, "XDG_MUSIC_DIR", "Music")
        addUserFolder(files, known, "XDG_VIDEOS_DIR", "Videos")
        if loaded { std.fs.ArrayList.deinit(contents) }
    }
    addPlace(files, app.PLACE_COMPUTER, "/")
    addPlace(files, app.PLACE_TRASH, "")
}

pub fn placeLabel(files: *app.Files, index: usize) -> []const u8 {
    const kind = files.*.placeKinds[index]
    if kind == app.PLACE_COMPUTER { return app.say(files, "Computer", "Computer") }
    if kind == app.PLACE_TRASH { return app.say(files, "Trash", "Papierkorb") }
    return places.baseName(app.pathText(app.placePathAt(files, index)))
}

// Whether place `index` is the folder shown.
pub fn placeActive(files: *app.Files, index: usize) -> bool {
    if files.*.placeKinds[index] == app.PLACE_TRASH { return files.*.inTrash }
    return !files.*.inTrash && std.text.same(app.pathText(app.placePathAt(files, index)), app.pathText(app.pathOf(files)))
}

fn placeY(index: usize) -> i32 {
    // "Favorites" above the folders, "Locations" above the computer.
    return 44 + @intCast(i32, index) * app.PLACE_ROW
}

// The row of place `index` (the Locations heading pushes the last two
// down).
pub fn placeTop(files: *app.Files, index: usize) -> i32 {
    var y = placeY(index)
    if files.*.placeKinds[index] == app.PLACE_COMPUTER || files.*.placeKinds[index] == app.PLACE_TRASH { y += 30 }
    return y
}

pub fn goPlace(files: *app.Files, index: usize) -> void {
    if files.*.placeKinds[index] == app.PLACE_TRASH {
        goTrash(files)
        return
    }
    const shown = go(files, app.pathText(app.placePathAt(files, index)), false, true)
}
