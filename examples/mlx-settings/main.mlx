// The settings app of the Mlx desktop: a window (a Wayland client) that
// changes the compositor's look while it runs. It shows the border colour
// of the focused window as a row of colours to pick from, and switches for
// the title bars, their frames-per-second counter and whether programs
// draw their own title bars (client decorations, off by default: the
// compositor tells them it decorates windows). Every change is
// written to $XDG_CONFIG_HOME/mlx/compositor.conf (~/.config/mlx/
// compositor.conf), which the compositor reads again within half a second
// (examples/wayland-compositor/settings.mlx).
//
//   mlx-settings
const std = @import("std")
const apps_module = @import("../desktop-shared/apps.mlx")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const panel_module = @import("../desktop-shared/panel.mlx")

const Canvas = canvas_module.Canvas
const Text = canvas_module.Text
const Panel = panel_module.Panel

const WIDTH: i32 = 440
const HEIGHT: i32 = 378
const PADDING: i32 = 24
const SWATCHES: i32 = 10
const SWATCH: i32 = 30
const SWATCH_GAP: i32 = 8
const SWATCH_TOP: i32 = 100
const ROW_TOP: i32 = 160
const ROW_HEIGHT: i32 = 48
const SWITCH_WIDTH: i32 = 44
const SWITCH_HEIGHT: i32 = 24
const NONE: usize = 1 << 40
const BUTTON_LEFT: u32 = 272
const KEY_ESCAPE: u32 = 1

const O_WRONLY_CREATE_TRUNCATE: usize = 577

// The compositor's defaults (scene.FOCUS_COLOR, FRAME_COLOR).
const DEFAULT_BORDER: u32 = 5939455
const DEFAULT_INACTIVE: u32 = 5263456

const Settings = struct {
    panel: Panel
    // The settings file (NUL-terminated), and the same with ".new" for
    // writing it whole before it replaces the old one.
    path: [256]u8
    pathLength: usize
    // What the file says (colours as 0xRRGGBB).
    border: u32
    inactive: u32
    titleBars: bool
    fpsCounter: bool
    clientDecorations: bool
    // The pointer, and what it is over (a swatch, a switch row, NONE).
    pointerX: i32
    pointerY: i32
    hover: usize
    saved: bool
    title: Text
    body: Text
    small: Text
}

fn settingsOf(context: *anyopaque) -> *Settings {
    unsafe { return @ptrCast(*Settings, context) }
}

fn panelOf(settings: *Settings) -> *Panel {
    unsafe { return @ptrCast(*Panel, &settings.*.panel) }
}

fn titleOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.title) }
}

fn bodyOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.body) }
}

fn smallOf(settings: *Settings) -> *Text {
    unsafe { return @ptrCast(*Text, &settings.*.small) }
}

fn pathOf(settings: *Settings) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(settings) + @offsetOf(Settings, "path")) }
}

// The colours on offer (0xRRGGBB): the compositor's blue first.
fn preset(index: usize) -> u32 {
    return match index {
        0 => DEFAULT_BORDER, 1 => 9662683, 2 => 15548997, 3 => 15485081, 4 => 16225862,
        5 => 16436245, 6 => 2278750, 7 => 1357990, 8 => 7109249,
        else => 15132390
    }
}

// ---------------------------------------------------------------------------
// The settings file

fn append(settings: *Settings, text: []const u8) -> void {
    for byte in text {
        if settings.*.pathLength < 240 {
            settings.*.path[settings.*.pathLength] = byte
            settings.*.pathLength += 1
        }
    }
    settings.*.path[settings.*.pathLength] = 0
}

fn appendC(settings: *Settings, text: [*]const u8) -> void {
    var index: usize = 0
    while text[index] != 0 && settings.*.pathLength < 240 {
        settings.*.path[settings.*.pathLength] = text[index]
        settings.*.pathLength += 1
        index += 1
    }
    settings.*.path[settings.*.pathLength] = 0
}

// The directory part of the path so far exists (mkdir, errors ignored).
fn makeDirectory(settings: *Settings) -> void {
    const made = std.fs.makeDir(pathOf(settings), 493)
}

// Finds the file's path; makes ~/.config and ~/.config/mlx on the way.
fn locate(settings: *Settings, environment: [*][*]const u8) -> bool {
    settings.*.pathLength = 0
    const config = apps_module.environmentValue(environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] != 0 {
        appendC(settings, config)
    } else {
        const home = apps_module.environmentValue(environment, "HOME")
        if @intFromPtr(home) == 0 || home[0] == 0 { return false }
        appendC(settings, home)
        append(settings, "/.config")
    }
    makeDirectory(settings)
    append(settings, "/mlx")
    makeDirectory(settings)
    append(settings, "/compositor.conf")
    return true
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

fn trimmed(text: []const u8) -> []const u8 {
    var start: usize = 0
    var end = text.length
    while start < end && isSpace(text[start]) { start += 1 }
    while end > start && isSpace(text[end - 1]) { end -= 1 }
    return text[start..end]
}

fn same(text: []const u8, word: []const u8) -> bool {
    if text.length != word.length { return false }
    var index: usize = 0
    while index < text.length {
        if text[index] != word[index] { return false }
        index += 1
    }
    return true
}

fn hexDigit(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(u32, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(u32, byte - 55) }
    return 16
}

fn parseColor(text: []const u8, fallback: u32) -> u32 {
    var start: usize = 0
    if text.length > 0 && text[0] == 35 { start = 1 }
    if text.length - start != 6 { return fallback }
    var value: u32 = 0
    var index = start
    while index < text.length {
        const digit = hexDigit(text[index])
        if digit == 16 { return fallback }
        value = value * 16 + digit
        index += 1
    }
    return value
}

fn parseSwitch(text: []const u8, fallback: bool) -> bool {
    if same(text, "on") || same(text, "yes") || same(text, "true") || same(text, "1") { return true }
    if same(text, "off") || same(text, "no") || same(text, "false") || same(text, "0") { return false }
    return fallback
}

// What the file says now (the defaults for what it leaves out).
fn load(settings: *Settings, allocator: std.allocator.Allocator) -> void {
    settings.*.border = DEFAULT_BORDER
    settings.*.inactive = DEFAULT_INACTIVE
    settings.*.titleBars = true
    settings.*.fpsCounter = true
    settings.*.clientDecorations = false
    const file = std.fs.open(pathOf(settings), 0, 0)
    if !std.fs.isValid(file) { return }
    const contents = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    const text = contents.items
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        const line = trimmed(text[at..end])
        var equals: usize = 0
        while equals < line.length && line[equals] != 61 { equals += 1 }
        if line.length > 0 && line[0] != 35 && equals < line.length {
            const key = trimmed(line[0..equals])
            const value = trimmed(line[equals + 1..line.length])
            if same(key, "border-color") { settings.*.border = parseColor(value, settings.*.border) }
            if same(key, "inactive-border-color") { settings.*.inactive = parseColor(value, settings.*.inactive) }
            if same(key, "title-bars") { settings.*.titleBars = parseSwitch(value, settings.*.titleBars) }
            if same(key, "fps-counter") { settings.*.fpsCounter = parseSwitch(value, settings.*.fpsCounter) }
            if same(key, "client-decorations") { settings.*.clientDecorations = parseSwitch(value, settings.*.clientDecorations) }
        }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
}

fn writeColor(line: [*]u8, at: usize, color: u32) -> usize {
    line[at] = 35
    var index: usize = 0
    while index < 6 {
        const nibble = (color >> @intCast(u5, (5 - index) * 4)) & 15
        line[at + 1 + index] = @intCast(u8, if nibble < 10 { 48 + nibble } else { 87 + nibble })
        index += 1
    }
    return at + 7
}

fn writeText(line: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        line[index] = byte
        index += 1
    }
    return index
}

// Writes the file whole (as NAME.new, renamed over it: the compositor never
// reads half a file).
fn save(settings: *Settings) -> void {
    var bytes: [512]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length = writeText(text, 0, "# The Mlx compositor's settings (mlx-settings writes this file).\nborder-color = ")
    length = writeColor(text, length, settings.*.border)
    length = writeText(text, length, "\ninactive-border-color = ")
    length = writeColor(text, length, settings.*.inactive)
    length = writeText(text, length, if settings.*.titleBars { "\ntitle-bars = on\n" } else { "\ntitle-bars = off\n" })
    length = writeText(text, length, if settings.*.fpsCounter { "fps-counter = on\n" } else { "fps-counter = off\n" })
    length = writeText(text, length, if settings.*.clientDecorations { "client-decorations = on\n" } else { "client-decorations = off\n" })

    var temporary: [264]u8 = undefined
    var temporary_path: [*]u8 = undefined
    unsafe { temporary_path = @ptrCast([*]u8, &temporary) }
    var index: usize = 0
    while index < settings.*.pathLength {
        temporary_path[index] = settings.*.path[index]
        index += 1
    }
    index = writeText(temporary_path, index, ".new")
    temporary_path[index] = 0
    const file = std.fs.open(temporary_path, O_WRONLY_CREATE_TRUNCATE, 420)
    if !std.fs.isValid(file) {
        settings.*.saved = false
        return
    }
    const written = std.fs.writeAllBytes(file, text, length)
    const closed = std.fs.close(file)
    settings.*.saved = written && std.fs.rename(temporary_path, pathOf(settings))
}

// ---------------------------------------------------------------------------
// Layout and input

fn swatchX(index: usize) -> i32 { return PADDING + @intCast(i32, index) * (SWATCH + SWATCH_GAP) }

// Row 0: title bars, row 1: the fps counter, row 2: client decorations.
fn rowY(row: usize) -> i32 { return ROW_TOP + @intCast(i32, row) * ROW_HEIGHT }

// What (x, y) is over: swatch 0..9, switch row 100 + row, or NONE.
fn itemAt(x: i32, y: i32) -> usize {
    if y >= SWATCH_TOP && y < SWATCH_TOP + SWATCH {
        var index: usize = 0
        while index < @intCast(usize, SWATCHES) {
            if x >= swatchX(index) && x < swatchX(index) + SWATCH { return index }
            index += 1
        }
    }
    var row: usize = 0
    while row < 3 {
        if y >= rowY(row) && y < rowY(row) + ROW_HEIGHT && x >= PADDING && x < WIDTH - PADDING { return 100 + row }
        row += 1
    }
    return NONE
}

fn click(settings: *Settings, item: usize) -> void {
    if item < @intCast(usize, SWATCHES) {
        settings.*.border = preset(item)
    } else if item == 100 {
        settings.*.titleBars = !settings.*.titleBars
    } else if item == 101 {
        settings.*.fpsCounter = !settings.*.fpsCounter
    } else if item == 102 {
        settings.*.clientDecorations = !settings.*.clientDecorations
    } else {
        return
    }
    save(settings)
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const settings = settingsOf(context)
    const panel = panelOf(settings)
    if kind == panel_module.EVENT_MOTION {
        settings.*.pointerX = @bitCast(i32, a)
        settings.*.pointerY = b
        const hover = itemAt(settings.*.pointerX, settings.*.pointerY)
        if hover == settings.*.hover { return }
        settings.*.hover = hover
    } else if kind == panel_module.EVENT_LEAVE {
        settings.*.hover = NONE
    } else if kind == panel_module.EVENT_BUTTON {
        if a == BUTTON_LEFT && b == 1 { click(settings, settings.*.hover) }
    } else if kind == panel_module.EVENT_KEY {
        if a == KEY_ESCAPE && b == 1 { panel.*.running = false }
    }
    panel.*.dirty = true
}

// ---------------------------------------------------------------------------
// Drawing

fn opaque(rgb: u32) -> u32 { return 4278190080 | rgb }

fn drawSwitch(canvas: *Canvas, x: i32, y: i32, on: bool, hover: bool) -> void {
    const track = if on { canvas_module.color(255, 90, 160, 255) } else if hover { canvas_module.color(255, 92, 96, 108) } else { canvas_module.color(255, 70, 74, 84) }
    canvas_module.fillRoundedRect(canvas, x, y, SWITCH_WIDTH, SWITCH_HEIGHT, SWITCH_HEIGHT / 2, track)
    const knob_x = if on { x + SWITCH_WIDTH - SWITCH_HEIGHT + 3 } else { x + 3 }
    canvas_module.fillRoundedRect(canvas, knob_x, y + 3, SWITCH_HEIGHT - 6, SWITCH_HEIGHT - 6, (SWITCH_HEIGHT - 6) / 2, canvas_module.color(255, 245, 246, 250))
}

fn drawRow(settings: *Settings, canvas: *Canvas, row: usize, label: []const u8, note: []const u8, on: bool) -> void {
    const y = rowY(row)
    const hover = settings.*.hover == 100 + row
    if hover { canvas_module.fillRoundedRect(canvas, PADDING - 8, y, WIDTH - PADDING * 2 + 16, ROW_HEIGHT - 4, 10, canvas_module.color(255, 44, 48, 58)) }
    canvas_module.drawText(canvas, bodyOf(settings), label, PADDING, y + 4, canvas_module.color(255, 235, 238, 245), 0)
    canvas_module.drawText(canvas, smallOf(settings), note, PADDING, y + 25, canvas_module.color(255, 140, 146, 160), 0)
    drawSwitch(canvas, WIDTH - PADDING - SWITCH_WIDTH, y + (ROW_HEIGHT - 4 - SWITCH_HEIGHT) / 2, on, hover)
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const settings = settingsOf(context)
    canvas_module.clear(canvas, canvas_module.color(255, 30, 32, 40))
    const heading = canvas_module.color(255, 245, 246, 250)
    const dim = canvas_module.color(255, 140, 146, 160)
    canvas_module.drawText(canvas, titleOf(settings), "Settings", PADDING, 18, heading, 0)

    // The border colour.
    canvas_module.drawText(canvas, bodyOf(settings), "Border color", PADDING, 66, heading, 0)
    var index: usize = 0
    while index < @intCast(usize, SWATCHES) {
        const x = swatchX(index)
        const chosen = preset(index) == settings.*.border
        if chosen {
            canvas_module.fillRoundedRect(canvas, x - 4, SWATCH_TOP - 4, SWATCH + 8, SWATCH + 8, (SWATCH + 8) / 2, canvas_module.color(255, 245, 246, 250))
            canvas_module.fillRoundedRect(canvas, x - 2, SWATCH_TOP - 2, SWATCH + 4, SWATCH + 4, (SWATCH + 4) / 2, canvas_module.color(255, 30, 32, 40))
        } else if settings.*.hover == index {
            canvas_module.fillRoundedRect(canvas, x - 3, SWATCH_TOP - 3, SWATCH + 6, SWATCH + 6, (SWATCH + 6) / 2, canvas_module.color(255, 90, 94, 106))
            canvas_module.fillRoundedRect(canvas, x - 1, SWATCH_TOP - 1, SWATCH + 2, SWATCH + 2, (SWATCH + 2) / 2, canvas_module.color(255, 30, 32, 40))
        }
        canvas_module.fillRoundedRect(canvas, x, SWATCH_TOP, SWATCH, SWATCH, SWATCH / 2, opaque(preset(index)))
        index += 1
    }

    canvas_module.fillRect(canvas, PADDING, ROW_TOP - 14, WIDTH - PADDING * 2, 1, canvas_module.color(255, 52, 56, 66))
    drawRow(settings, canvas, 0, "Title bars", "A bar with the title above each window", settings.*.titleBars)
    drawRow(settings, canvas, 1, "FPS counter", "Frames per second in the title bars", settings.*.fpsCounter)
    drawRow(settings, canvas, 2, "App decorations", "Programs draw their own title bars and frames", settings.*.clientDecorations)

    const footer = if settings.*.saved { "Saved to ~/.config/mlx/compositor.conf" } else { "Changes apply at once" }
    canvas_module.drawText(canvas, smallOf(settings), footer, PADDING, HEIGHT - 34, dim, 0)
}

const Failure = error { NoMemory, NoHome }

fn noMemory() -> Failure!void { return Failure.NoMemory }
fn noHome() -> Failure!void { return Failure.NoHome }

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Settings), 16)
    if memory == null { return noMemory() }
    var settings: *Settings = undefined
    unsafe { settings = @ptrCast(*Settings, memory.?) }
    settings.*.hover = NONE
    settings.*.pointerX = 0
    settings.*.pointerY = 0
    settings.*.saved = false
    if !locate(settings, environment) { return noHome() }
    load(settings, allocator)
    const loaded_title = canvas_module.loadText(titleOf(settings), 22, allocator)
    const loaded_body = canvas_module.loadText(bodyOf(settings), 15, allocator)
    const loaded_small = canvas_module.loadText(smallOf(settings), 12, allocator)

    const panel = panelOf(settings)
    panel.*.context = @ptrCast(*anyopaque, settings)
    panel.*.draw = draw
    panel.*.event = onEvent
    try panel_module.openWindow(panel, allocator, arguments, "Settings", "org.mlx.settings", @intCast(u32, WIDTH), @intCast(u32, HEIGHT))
    panel_module.report(panel, "mlx-settings")
    try panel_module.run(panel)
    panel_module.close(panel)
}
