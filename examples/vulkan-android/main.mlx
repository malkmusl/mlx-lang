// Vulkan on Android: a NativeActivity that renders the animated pattern of
// examples/vulkan-shared with a compute shader and presents it through a
// VK_KHR_android_surface swapchain. Touch moves the ring; it turns white
// while the finger is down. Unless the app is fullscreen, the space of
// the status and navigation bars is reserved (std.android.reservedInsets):
// only the app's background is drawn there, and everything else starts
// below it (std.ui). A label (the GPU and the frame count) sits at the top
// center of the free area, laid out by std.truetype from the system font
// and drawn by the `text` shader.
//
// No C Vulkan headers and no NDK toolchain: the system loader (libvulkan.so)
// is opened with std.vulkan.loader, the shader is built with
// std.spirv.builder, and the activity is driven through std.android's NDK
// bindings.
//
// Build (from the repository root, with the aarch64-android compiler):
//   zig-out/bin/mlx1 examples/vulkan-android/main.mlx -o vulkan.apk \
//       --target=aarch64-android --android-package=dev.mlxlang.vulkan \
//       --android-label="Mlx Vulkan"
//   adb install -r vulkan.apk && adb logcat -s mlx
//
// Frames are paced by a 60 Hz timerfd on the main looper; each frame waits
// for the GPU (FIFO presentation), so the pace never outruns the display.

const std = @import("std")
const android = @import("std.android")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const gpu = @import("../vulkan-shared/gpu.mlx")
const shaders = @import("../vulkan-shared/shaders.mlx")
const swapchain = @import("../vulkan-shared/swapchain.mlx")
const tt = @import("std.truetype")
const ui = @import("std.ui")
const text_module = @import("../vulkan-shared/text.mlx")

// struct ANativeActivity: callbacks at 0, instance at 56.
const ACTIVITY_CALLBACKS: usize = 0
const ACTIVITY_INSTANCE: usize = 56
// struct ANativeActivityCallbacks, one function pointer each.
const ON_DESTROY: usize = 40
const ON_NATIVE_WINDOW_CREATED: usize = 56
const ON_NATIVE_WINDOW_RESIZED: usize = 64
const ON_NATIVE_WINDOW_REDRAW_NEEDED: usize = 72
const ON_NATIVE_WINDOW_DESTROYED: usize = 80
const ON_INPUT_QUEUE_CREATED: usize = 88
const ON_INPUT_QUEUE_DESTROYED: usize = 96

const CLOCK_MONOTONIC: i32 = 1
const TIMER_FLAGS: i32 = 526336 // TFD_NONBLOCK | TFD_CLOEXEC
const FRAME_NANOSECONDS: u64 = 16666667
const ON_CONTENT_RECT_CHANGED: usize = 104
// Colors (0xAARRGGBB): the app's background, the only thing drawn under the
// status and navigation bars; the label and its shadow.
const BACKGROUND_COLOR: u32 = 4279243800 // 0xFF101418
const LABEL_COLOR: u32 = 4294967295
const SHADOW_COLOR: u32 = 3019898880 // 0xB4000000
const BUTTON_COLOR: u32 = 3423606808 // 0xCC101418
// Frames between two looks at the reserved space: hiding or showing a bar
// changes it without a layout callback.
const INSETS_POLL: u32 = 8

const App = struct {
    activity: usize
    window: usize
    queue: usize
    looper: usize
    timer: i32
    // Vulkan: the device, the pattern pipeline, the window's swapchain.
    vulkan: bool
    context: *gpu.Context
    kernel: *gpu.Kernel
    chain: *swapchain.Swapchain
    hasSwapchain: bool
    time: u32
    frames: usize
    // Touch: the ring follows the last position.
    pointerSeen: bool
    touching: bool
    pointerX: u32
    pointerY: u32
    // Scratch: the AInputEvent* out-parameter and an itimerspec.
    event: usize
    timerSpec: usize
    // The label: the system font, and (from the first frame, sized to the
    // screen) its atlas and the text shader.
    hasFont: bool
    hasText: bool
    textFailed: bool
    // The space reserved for the system (std.android.reservedInsets): the
    // status and navigation bars, or nothing when fullscreen or not known yet.
    reserved: android.Reserved
    insets: ui.Insets
    framesSinceInsets: u32
    // The runtime switches: fullscreen hides both system bars, the other
    // only the navigation bar. Their buttons (visible part, from the last
    // frame) and the touch that went down.
    fullscreen: bool
    navigationHidden: bool
    // The third switch: what shows behind the navigation (gesture) bar,
    // the background or, transparent, the content.
    gestureBarTransparent: bool
    fullscreenRun: *tt.Run
    navigationRun: *tt.Run
    gestureRun: *tt.Run
    fullscreenButton: ui.Rect
    navigationButton: ui.Rect
    gestureButton: ui.Rect
    downX: i32
    downY: i32
    font: *tt.Font
    atlas: *tt.Atlas
    run: *tt.Run
    text: *text_module.Text
    label: usize
}

fn appOf(activity: usize) -> *App {
    unsafe { return @ptrFromInt(*App, @ptrFromInt(*usize, activity + ACTIVITY_INSTANCE).*) }
}

fn setCallback(activity: usize, offset: usize, function: usize) -> void {
    unsafe {
        const callbacks = @ptrFromInt(*usize, activity + ACTIVITY_CALLBACKS).*
        @ptrFromInt(*usize, callbacks + offset).* = function
    }
}

fn writeU64(address: usize, value: u64) -> void {
    unsafe { @ptrFromInt(*u64, address).* = value }
}

fn allocate(size: usize) -> usize {
    const memory = std.page_allocator.init().alloc(size, 16)
    if memory == null { return 0 }
    return @intFromPtr(memory.?)
}

// ── Logging ───────────────────────────────────────────────────────────────

// Every step up to the first frame is logged (tag "mlx"), so a driver that
// fails or crashes shows where: `adb logcat -s mlx`.
fn traceStep(text: [*]const u8) -> void {
    unsafe { const written = android.__android_log_write(android.LOG_INFO, @ptrCast([*]const u8, "mlx"), text) }
}

fn appendText(buffer: usize, length: usize, text: [*]const u8) -> usize {
    var at = length
    var index: usize = 0
    while text[index] != 0 && at < 300 {
        unsafe { @ptrFromInt(*u8, buffer + at).* = text[index] }
        at += 1
        index += 1
    }
    return at
}

fn appendNumber(buffer: usize, length: usize, value: u32) -> usize {
    var digits: [10]u8 = undefined
    var count: usize = 0
    var rest = value
    while count == 0 || rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var at = length
    while count > 0 {
        count -= 1
        unsafe { @ptrFromInt(*u8, buffer + at).* = digits[count] }
        at += 1
    }
    return at
}

// "vulkan: device NAME, Vulkan MAJOR.MINOR.PATCH"
fn logDevice(context: *gpu.Context) -> void {
    const buffer = allocate(320)
    if buffer == 0 { return }
    var length: usize = 0
    unsafe {
        length = appendText(buffer, length, @ptrCast([*]const u8, "vulkan: device "))
        length = appendText(buffer, length, gpu.deviceName(context))
        length = appendText(buffer, length, @ptrCast([*]const u8, ", Vulkan "))
    }
    const version = context.*.apiVersion
    length = appendNumber(buffer, length, (version >> 22) & 127)
    unsafe { @ptrFromInt(*u8, buffer + length).* = 46 }
    length = appendNumber(buffer, length + 1, (version >> 12) & 1023)
    unsafe { @ptrFromInt(*u8, buffer + length).* = 46 }
    length = appendNumber(buffer, length + 1, version & 4095)
    unsafe {
        @ptrFromInt(*u8, buffer + length).* = 0
        traceStep(@ptrFromInt([*]const u8, buffer))
    }
}

// ── Label ─────────────────────────────────────────────────────────────────

// Android's system fonts that are TrueType (glyf) on current releases.
fn loadFont(app: *App) -> void {
    app.*.hasFont = false
    const allocator = std.page_allocator.init()
    var index: usize = 0
    while index < 4 && !app.*.hasFont {
        var path: [*]const u8 = undefined
        unsafe {
            path = if index == 0 { @ptrCast([*]const u8, "/system/fonts/Roboto-Regular.ttf") } else if index == 1 { @ptrCast([*]const u8, "/system/fonts/NotoSans-Regular.ttf") } else if index == 2 { @ptrCast([*]const u8, "/system/fonts/DroidSans.ttf") } else { @ptrCast([*]const u8, "/system/fonts/DroidSansMono.ttf") }
        }
        if tt.loadFile(app.*.font, path, allocator) == tt.Status.ok {
            app.*.hasFont = true
            android.log("text: font loaded")
            traceStep(path)
        }
        index += 1
    }
    if !app.*.hasFont { android.log("text: no system font (no label)") }
}

fn swapRedBlue(color: u32, flags: u32) -> u32 {
    if flags & shaders.FLAG_SWAP_RED_BLUE == 0 { return color }
    return (color & 4278255360) | ((color & 255) << 16) | ((color >> 16) & 255)
}

// The text shader, once: with the font's atlas at a size that reads well
// on this screen (from the shorter side, so portrait and landscape, which
// restart the activity, get the same size), or only for fills.
fn setUpText(app: *App, context: *gpu.Context, chain: *swapchain.Swapchain) -> bool {
    if app.*.hasFont {
        const shorter = if chain.*.width < chain.*.height { chain.*.width } else { chain.*.height }
        var size = shorter / 28
        if size < 16 { size = 16 }
        const allocator = std.page_allocator.init()
        if !tt.initAtlas(app.*.atlas, app.*.font, size, 1024, 512, allocator) || !tt.initRun(app.*.run, 128, allocator) || !tt.initRun(app.*.fullscreenRun, 32, allocator) || !tt.initRun(app.*.navigationRun, 32, allocator) || !tt.initRun(app.*.gestureRun, 32, allocator) {
            android.log("text: cannot set up the atlas (no label)")
            app.*.hasFont = false
        }
    }
    if app.*.hasFont { return text_module.init(context, app.*.text, app.*.atlas, 512) }
    return text_module.initSized(context, app.*.text, 4, 1, 512)
}

// Asks for the reserved space again; true when it changed (logged).
fn updateInsets(app: *App) -> bool {
    var insets = ui.uniform(0)
    const kind = android.reservedInsets(app.*.activity, &insets)
    const old = app.*.insets
    if kind == app.*.reserved && insets.top == old.top && insets.right == old.right && insets.bottom == old.bottom && insets.left == old.left { return false }
    app.*.reserved = kind
    app.*.insets = insets
    if kind == android.Reserved.fullscreen {
        android.log("ui: fullscreen, nothing reserved")
        return true
    }
    if kind == android.Reserved.unknown {
        android.log("ui: reserved space not known yet")
        return true
    }
    const buffer = app.*.label
    var length: usize = 0
    unsafe { length = appendText(buffer, length, @ptrCast([*]const u8, "ui: reserved for the system bars: top ")) }
    length = appendNumber(buffer, length, @bitCast(u32, insets.top))
    unsafe { length = appendText(buffer, length, @ptrCast([*]const u8, " right ")) }
    length = appendNumber(buffer, length, @bitCast(u32, insets.right))
    unsafe { length = appendText(buffer, length, @ptrCast([*]const u8, " bottom ")) }
    length = appendNumber(buffer, length, @bitCast(u32, insets.bottom))
    unsafe { length = appendText(buffer, length, @ptrCast([*]const u8, " left ")) }
    length = appendNumber(buffer, length, @bitCast(u32, insets.left))
    unsafe {
        @ptrFromInt(*u8, buffer + length).* = 0
        const written = android.__android_log_write(android.LOG_INFO, @ptrCast([*]const u8, "mlx"), @ptrFromInt([*]const u8, buffer))
    }
    return true
}

// swapchain.DecorateFn: the app's background in the space reserved for
// the status and navigation bars (none when fullscreen), then "Mlx + Vulkan ·
// GPU · frame N" at the top center of the rest (std.ui): like every
// component, it starts below the reserved space.
fn decorateFrame(data: usize, context: *gpu.Context, chain: *swapchain.Swapchain) -> bool {
    var app: *App = undefined
    unsafe { app = @ptrFromInt(*App, data) }
    if !app.*.hasText && !app.*.textFailed {
        if setUpText(app, context, chain) {
            app.*.hasText = true
        } else {
            android.log("text: cannot set up the text shader")
            app.*.textFailed = true
        }
    }
    if !app.*.hasText { return true }
    text_module.beginFrame(app.*.text)
    const flags = chain.*.formatFlags
    const frame = chain.*.frame.buffer
    const width = chain.*.width
    const height = chain.*.height
    var screen = ui.screen(@intCast(i32, width), @intCast(i32, height), app.*.insets)
    // Only the background where the system draws: the bands around the
    // free area. Behind a transparent gesture bar (the navigation bar's
    // bands: the bottom, or a side with three buttons) the content shows
    // instead; the components still stay clear of it.
    var rest = screen.bounds
    const background = swapRedBlue(BACKGROUND_COLOR, flags)
    const top_band = ui.takeTop(&rest, screen.safe.top)
    const bottom_band = ui.takeBottom(&rest, screen.safe.bottom)
    const left_band = ui.takeLeft(&rest, screen.safe.left)
    const right_band = ui.takeRight(&rest, screen.safe.right)
    if !text_module.fill(context, app.*.text, frame, width, height, 0, top_band, background) { return false }
    if !app.*.gestureBarTransparent {
        if !text_module.fill(context, app.*.text, frame, width, height, 0, bottom_band, background) { return false }
        if !text_module.fill(context, app.*.text, frame, width, height, 0, left_band, background) { return false }
        if !text_module.fill(context, app.*.text, frame, width, height, 0, right_band, background) { return false }
    }
    if !app.*.hasFont { return true }
    var length: usize = 0
    unsafe {
        length = appendText(app.*.label, length, @ptrCast([*]const u8, "Mlx + Vulkan · "))
    }
    // Where the label restarts when the whole of it is too wide.
    const short_start = length
    unsafe {
        length = appendText(app.*.label, length, gpu.deviceName(context))
        length = appendText(app.*.label, length, @ptrCast([*]const u8, " · frame "))
    }
    length = appendNumber(app.*.label, length, @intCast(u32, app.*.frames))
    var label: [*]const u8 = undefined
    unsafe { label = @ptrFromInt([*]const u8, app.*.label) }
    tt.layoutBytes(app.*.atlas, label, length, app.*.run)

    // The label: top center of the free area, inside a padding of half a line.
    const text_height = app.*.atlas.*.ascent + app.*.atlas.*.descent
    const padding = @intCast(i32, app.*.atlas.*.pixelHeight) / 2
    const box = ui.container(screen.free, ui.uniform(padding), ui.topCenter())
    if app.*.run.*.right - app.*.run.*.left > ui.content(&box).width {
        var shorter_label: [*]const u8 = undefined
        unsafe { shorter_label = @ptrFromInt([*]const u8, app.*.label + short_start) }
        tt.layoutBytes(app.*.atlas, shorter_label, length - short_start, app.*.run)
    }
    const run = app.*.run
    const placed = ui.placeIn(&box, ui.size(run.*.right - run.*.left, text_height))
    // From the label's box to its pen origin (on the baseline).
    const x = placed.x - run.*.left
    const y = placed.y + app.*.atlas.*.ascent
    // Clipped to the free area: nothing but the background under the bars.
    if !text_module.drawIn(context, app.*.text, app.*.atlas, run, frame, width, height, 0, x + 2, y + 2, swapRedBlue(SHADOW_COLOR, flags), screen.free) { return false }
    if !text_module.drawIn(context, app.*.text, app.*.atlas, run, frame, width, height, 0, x, y, swapRedBlue(LABEL_COLOR, flags), screen.free) { return false }

    // The switches at the bottom center: side by side when they fit the
    // width, else one above the other, all as wide as the widest.
    if app.*.fullscreen { tt.layout(app.*.atlas, "Fullscreen: on", app.*.fullscreenRun) } else { tt.layout(app.*.atlas, "Fullscreen: off", app.*.fullscreenRun) }
    if app.*.navigationHidden { tt.layout(app.*.atlas, "Navigation bar: hidden", app.*.navigationRun) } else { tt.layout(app.*.atlas, "Navigation bar: shown", app.*.navigationRun) }
    if app.*.gestureBarTransparent { tt.layout(app.*.atlas, "Gesture bar: transparent", app.*.gestureRun) } else { tt.layout(app.*.atlas, "Gesture bar: solid", app.*.gestureRun) }
    const button_height = text_height + padding
    const first = ui.size(app.*.fullscreenRun.*.right - app.*.fullscreenRun.*.left + 2 * padding, button_height)
    const second = ui.size(app.*.navigationRun.*.right - app.*.navigationRun.*.left + 2 * padding, button_height)
    const third = ui.size(app.*.gestureRun.*.right - app.*.gestureRun.*.left + 2 * padding, button_height)
    const group_box = ui.container(screen.free, ui.uniform(padding), ui.bottomCenter())
    const row_width = first.width + second.width + third.width + 2 * padding
    var group = ui.stack(ui.placeIn(&group_box, ui.size(row_width, button_height)), ui.Axis.horizontal, padding, ui.Align.fill)
    if row_width > ui.content(&group_box).width {
        var column_width = first.width
        if second.width > column_width { column_width = second.width }
        if third.width > column_width { column_width = third.width }
        group = ui.stack(ui.placeIn(&group_box, ui.size(column_width, 3 * button_height + 2 * padding)), ui.Axis.vertical, padding, ui.Align.fill)
    }
    const fullscreen_button = ui.intersect(ui.next(&group, first), screen.free)
    const navigation_button = ui.intersect(ui.next(&group, second), screen.free)
    const gesture_button = ui.intersect(ui.next(&group, third), screen.free)
    if !sameRect(fullscreen_button, app.*.fullscreenButton) || !sameRect(navigation_button, app.*.navigationButton) || !sameRect(gesture_button, app.*.gestureButton) {
        app.*.fullscreenButton = fullscreen_button
        app.*.navigationButton = navigation_button
        app.*.gestureButton = gesture_button
        logButtons(app)
    }
    if !drawButton(app, context, chain, fullscreen_button, app.*.fullscreenRun) { return false }
    if !drawButton(app, context, chain, navigation_button, app.*.navigationRun) { return false }
    return drawButton(app, context, chain, gesture_button, app.*.gestureRun)
}

fn sameRect(a: ui.Rect, b: ui.Rect) -> bool {
    return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}

// A button: its background, and its text centered and clipped to it.
fn drawButton(app: *App, context: *gpu.Context, chain: *swapchain.Swapchain, area: ui.Rect, run: *tt.Run) -> bool {
    if ui.isEmpty(area) { return true }
    const flags = chain.*.formatFlags
    const frame = chain.*.frame.buffer
    if !text_module.fill(context, app.*.text, frame, chain.*.width, chain.*.height, 0, area, swapRedBlue(BUTTON_COLOR, flags)) { return false }
    const text_height = app.*.atlas.*.ascent + app.*.atlas.*.descent
    const placed = ui.place(area, ui.size(run.*.right - run.*.left, text_height), ui.centered())
    return text_module.drawIn(context, app.*.text, app.*.atlas, run, frame, chain.*.width, chain.*.height, 0, placed.x - run.*.left, placed.y + app.*.atlas.*.ascent, swapRedBlue(LABEL_COLOR, flags), area)
}

fn appendRect(buffer: usize, length: usize, area: ui.Rect) -> usize {
    var at = appendNumber(buffer, length, @bitCast(u32, area.x))
    unsafe { at = appendText(buffer, at, @ptrCast([*]const u8, " ")) }
    at = appendNumber(buffer, at, @bitCast(u32, area.y))
    unsafe { at = appendText(buffer, at, @ptrCast([*]const u8, " ")) }
    at = appendNumber(buffer, at, @bitCast(u32, area.width))
    unsafe { at = appendText(buffer, at, @ptrCast([*]const u8, " ")) }
    return appendNumber(buffer, at, @bitCast(u32, area.height))
}

// "ui: buttons: fullscreen X Y W H, navigation bar X Y W H, gesture bar
// X Y W H" (when they move).
fn logButtons(app: *App) -> void {
    const buffer = app.*.label
    var length: usize = 0
    unsafe { length = appendText(buffer, length, @ptrCast([*]const u8, "ui: buttons: fullscreen ")) }
    length = appendRect(buffer, length, app.*.fullscreenButton)
    unsafe { length = appendText(buffer, length, @ptrCast([*]const u8, ", navigation bar ")) }
    length = appendRect(buffer, length, app.*.navigationButton)
    unsafe { length = appendText(buffer, length, @ptrCast([*]const u8, ", gesture bar ")) }
    length = appendRect(buffer, length, app.*.gestureButton)
    unsafe {
        @ptrFromInt(*u8, buffer + length).* = 0
        const written = android.__android_log_write(android.LOG_INFO, @ptrCast([*]const u8, "mlx"), @ptrFromInt([*]const u8, buffer))
    }
}

// Applies the switches to the window; the reserved space is asked for
// again from the next frame on.
fn applySystemBars(app: *App) -> void {
    if !android.setSystemBarsHidden(app.*.activity, app.*.fullscreen, app.*.fullscreen || app.*.navigationHidden) {
        android.log("ui: cannot change the system bars")
    }
    app.*.framesSinceInsets = INSETS_POLL
}

fn toggleFullscreen(app: *App) -> void {
    app.*.fullscreen = !app.*.fullscreen
    if app.*.fullscreen { android.log("ui: fullscreen on") } else { android.log("ui: fullscreen off") }
    applySystemBars(app)
}

// Only what is drawn changes: the next frame shows it.
fn toggleGestureBar(app: *App) -> void {
    app.*.gestureBarTransparent = !app.*.gestureBarTransparent
    if app.*.gestureBarTransparent { android.log("ui: gesture bar transparent") } else { android.log("ui: gesture bar solid") }
}

fn toggleNavigationBar(app: *App) -> void {
    app.*.navigationHidden = !app.*.navigationHidden
    if app.*.navigationHidden { android.log("ui: navigation bar hidden") } else { android.log("ui: navigation bar shown") }
    applySystemBars(app)
}

// ── Vulkan ────────────────────────────────────────────────────────────────

fn openVulkan(app: *App) -> bool {
    const allocator = std.page_allocator.init()
    var driver: loader.Driver = undefined
    android.log("vulkan: opening libvulkan.so")
    unsafe {
        if loader.openSystemLoader(&driver, @ptrCast([*]const u8, loader.SYSTEM_LOADER_ANDROID), allocator) != loader.Status.ok {
            android.log("vulkan: libvulkan.so is not available")
            return false
        }
    }
    const names = allocate(24)
    if names == 0 { return false }
    unsafe {
        @ptrFromInt(*usize, names).* = @intFromPtr(@ptrCast([*]const u8, vk.KHR_SURFACE_EXTENSION_NAME))
        @ptrFromInt(*usize, names + 8).* = @intFromPtr(@ptrCast([*]const u8, vk.KHR_ANDROID_SURFACE_EXTENSION_NAME))
        @ptrFromInt(*usize, names + 16).* = @intFromPtr(@ptrCast([*]const u8, vk.KHR_SWAPCHAIN_EXTENSION_NAME))
    }
    var options = gpu.defaultOptions(@ptrCast([*]const u8, "mlx-vulkan-android"))
    unsafe {
        options.instanceExtensions = @ptrFromInt([*]const [*]const u8, names)
        options.deviceExtensions = @ptrFromInt([*]const [*]const u8, names + 16)
    }
    options.instanceExtensionCount = 2
    options.deviceExtensionCount = 1
    options.trace = @intFromPtr(traceStep)
    if gpu.open(app.*.context, driver, &options, allocator) != gpu.Status.ok {
        android.log("vulkan: no device with the surface and swapchain extensions")
        return false
    }
    logDevice(app.*.context)
    android.log("vulkan: building the shader")
    var code: [*]u32 = undefined
    const words = shaders.build(allocator, 0, &code)
    if words == 0 || !gpu.createKernel(app.*.context, app.*.kernel, code, words, 1, shaders.PATTERN_WORDS) {
        android.log("vulkan: cannot create the compute pipeline")
        gpu.close(app.*.context)
        return false
    }
    android.log("vulkan: device ready")
    return true
}

// A swapchain for the current window; its surface is created here.
fn createSwapchain(app: *App) -> void {
    if !app.*.vulkan || app.*.window == 0 || app.*.hasSwapchain { return }
    const context = app.*.context
    gpu.step(context, "vkCreateAndroidSurfaceKHR")
    var info = vk.AndroidSurfaceCreateInfoKHR.init()
    unsafe { info.window = @ptrFromInt(*anyopaque, app.*.window) }
    var surface: vk.SurfaceKHR = 0
    if vk.createAndroidSurfaceKHR(context.*.instanceCommands, context.*.instance, &info, null, &surface) != vk.Result.success {
        android.log("vulkan: cannot create the window surface")
        return
    }
    // The window decides the size: the hint is unused on Android.
    if !swapchain.create(context, app.*.chain, surface, 0, 0) {
        android.log("vulkan: cannot create the swapchain")
        swapchain.destroy(context, app.*.chain, false)
        return
    }
    app.*.hasSwapchain = true
    android.log("vulkan: swapchain created")
}

fn destroySwapchain(app: *App, keep_surface: bool) -> void {
    if !app.*.hasSwapchain { return }
    swapchain.destroy(app.*.context, app.*.chain, keep_surface)
    app.*.hasSwapchain = false
}

// Same surface, new swapchain (the window was resized or rotated).
fn recreateSwapchain(app: *App) -> void {
    if !app.*.hasSwapchain { return }
    const surface = app.*.chain.*.surface
    swapchain.destroy(app.*.context, app.*.chain, true)
    if !swapchain.create(app.*.context, app.*.chain, surface, 0, 0) {
        swapchain.destroy(app.*.context, app.*.chain, false)
        app.*.hasSwapchain = false
        android.log("vulkan: cannot recreate the swapchain")
    }
}

fn render(app: *App) -> void {
    if !app.*.hasSwapchain { return }
    var flags: u32 = 0
    if app.*.pointerSeen { flags = flags | shaders.FLAG_POINTER }
    if app.*.touching { flags = flags | shaders.FLAG_PRESSED }
    const pattern = shaders.Pattern.{ .width = 0, .height = 0, .time = app.*.time, .pointerX = app.*.pointerX, .pointerY = app.*.pointerY, .flags = flags }
    const status = swapchain.present(app.*.context, app.*.chain, app.*.kernel, pattern, @intFromPtr(decorateFrame), @intFromPtr(app))
    if status == swapchain.FrameStatus.out_of_date {
        recreateSwapchain(app)
        return
    }
    if status == swapchain.FrameStatus.failed {
        android.log("vulkan: frame failed")
        destroySwapchain(app, false)
        return
    }
    app.*.time += 2
    app.*.frames += 1
    app.*.framesSinceInsets += 1
    if app.*.framesSinceInsets >= INSETS_POLL {
        app.*.framesSinceInsets = 0
        const changed = updateInsets(app)
    }
    if app.*.frames == 1 {
        android.log("vulkan: first frame presented")
        // Steps are logged up to here; frames are too frequent for logcat.
        app.*.context.*.trace = 0
    }
}

// ── Frame timer ───────────────────────────────────────────────────────────

fn setTimer(app: *App, running: bool) -> void {
    if app.*.timer < 0 { return }
    const spec = app.*.timerSpec
    const period: u64 = if running { FRAME_NANOSECONDS } else { 0 }
    writeU64(spec, 0) // it_interval: seconds, nanoseconds
    writeU64(spec + 8, period)
    writeU64(spec + 16, 0) // it_value (all 0 disarms)
    writeU64(spec + 24, period)
    const set = android.timerfd_settime(app.*.timer, 0, spec, 0)
}

fn onTimer(fd: i32, events: i32, data: usize) -> i32 {
    var app: *App = undefined
    unsafe { app = @ptrFromInt(*App, data) }
    const expirations = android.read(fd, app.*.event, 8)
    render(app)
    return 1
}

// ── Input ─────────────────────────────────────────────────────────────────

fn handleMotion(app: *App, event: usize) -> void {
    const action = android.AMotionEvent_getAction(event) & android.MOTION_ACTION_MASK
    const x_position: f32 = android.AMotionEvent_getX(event, 0)
    const y_position: f32 = android.AMotionEvent_getY(event, 0)
    const x: i64 = @intFromFloat(i64, x_position)
    const y: i64 = @intFromFloat(i64, y_position)
    // A tap on a button (down and up inside it) flips its switch.
    const touch_x = @intCast(i32, x)
    const touch_y = @intCast(i32, y)
    if action == android.MOTION_ACTION_DOWN {
        app.*.downX = touch_x
        app.*.downY = touch_y
    } else if action == android.MOTION_ACTION_UP {
        if ui.contains(app.*.fullscreenButton, app.*.downX, app.*.downY) && ui.contains(app.*.fullscreenButton, touch_x, touch_y) { toggleFullscreen(app) }
        if ui.contains(app.*.navigationButton, app.*.downX, app.*.downY) && ui.contains(app.*.navigationButton, touch_x, touch_y) { toggleNavigationBar(app) }
        if ui.contains(app.*.gestureButton, app.*.downX, app.*.downY) && ui.contains(app.*.gestureButton, touch_x, touch_y) { toggleGestureBar(app) }
    }
    if action == android.MOTION_ACTION_DOWN || action == android.MOTION_ACTION_MOVE {
        app.*.pointerX = if x < 0 { 0 } else { @intCast(u32, x) }
        app.*.pointerY = if y < 0 { 0 } else { @intCast(u32, y) }
        app.*.pointerSeen = true
        app.*.touching = true
    } else if action == android.MOTION_ACTION_UP || action == android.MOTION_ACTION_CANCEL {
        app.*.touching = false
    }
}

fn onInput(fd: i32, events: i32, data: usize) -> i32 {
    var app: *App = undefined
    unsafe { app = @ptrFromInt(*App, data) }
    while app.*.queue != 0 && android.AInputQueue_getEvent(app.*.queue, app.*.event) >= 0 {
        var event: usize = 0
        unsafe { event = @ptrFromInt(*usize, app.*.event).* }
        if android.AInputQueue_preDispatchEvent(app.*.queue, event) == 0 {
            if android.AInputEvent_getType(event) == android.INPUT_EVENT_TYPE_MOTION { handleMotion(app, event) }
            android.AInputQueue_finishEvent(app.*.queue, event, 0)
        }
    }
    return 1
}

// ── Activity callbacks ────────────────────────────────────────────────────

fn onWindowCreated(activity: usize, window: usize) -> void {
    const app = appOf(activity)
    android.log("vulkan: window created")
    app.*.window = window
    const changed = updateInsets(app)
    createSwapchain(app)
    render(app)
    setTimer(app, true)
}

fn onWindowResized(activity: usize, window: usize) -> void {
    const app = appOf(activity)
    const changed = updateInsets(app)
    recreateSwapchain(app)
    render(app)
}

// After a layout pass: the system bars may have appeared, moved or changed
// size (their insets are only known once the window is laid out).
fn onContentRectChanged(activity: usize, rect: usize) -> void {
    const app = appOf(activity)
    if updateInsets(app) { render(app) }
}

fn onRedrawNeeded(activity: usize, window: usize) -> void {
    render(appOf(activity))
}

// The surface must be gone before this returns.
fn onWindowDestroyed(activity: usize, window: usize) -> void {
    const app = appOf(activity)
    setTimer(app, false)
    destroySwapchain(app, false)
    app.*.window = 0
}

fn onInputQueueCreated(activity: usize, queue: usize) -> void {
    const app = appOf(activity)
    app.*.queue = queue
    android.AInputQueue_attachLooper(queue, app.*.looper, 1, @intFromPtr(onInput), @intFromPtr(app))
}

fn onInputQueueDestroyed(activity: usize, queue: usize) -> void {
    const app = appOf(activity)
    android.AInputQueue_detachLooper(queue)
    app.*.queue = 0
    app.*.touching = false
}

fn onDestroy(activity: usize) -> void {
    const app = appOf(activity)
    if app.*.timer >= 0 {
        if app.*.looper != 0 { const removed = android.ALooper_removeFd(app.*.looper, app.*.timer) }
        const closed = android.close(app.*.timer)
    }
    destroySwapchain(app, false)
    if app.*.vulkan { gpu.close(app.*.context) }
    unsafe { @ptrFromInt(*usize, activity + ACTIVITY_INSTANCE).* = 0 }
}

export fn ANativeActivity_onCreate(activity: usize, saved_state: usize, saved_state_size: usize) -> void {
    android.log("vulkan: onCreate")
    const block = allocate(@sizeOf(App) + 8 + 32)
    const context = allocate(@sizeOf(gpu.Context))
    const kernel = allocate(@sizeOf(gpu.Kernel))
    const chain = allocate(@sizeOf(swapchain.Swapchain))
    const font = allocate(@sizeOf(tt.Font))
    const atlas = allocate(@sizeOf(tt.Atlas))
    const run = allocate(@sizeOf(tt.Run))
    const fullscreen_run = allocate(@sizeOf(tt.Run))
    const navigation_run = allocate(@sizeOf(tt.Run))
    const gesture_run = allocate(@sizeOf(tt.Run))
    const text = allocate(@sizeOf(text_module.Text))
    const label = allocate(320)
    if block == 0 || context == 0 || kernel == 0 || chain == 0 || font == 0 || atlas == 0 || run == 0 || fullscreen_run == 0 || navigation_run == 0 || gesture_run == 0 || text == 0 || label == 0 { return }
    var app: *App = undefined
    unsafe {
        app = @ptrFromInt(*App, block)
        app.*.context = @ptrFromInt(*gpu.Context, context)
        app.*.kernel = @ptrFromInt(*gpu.Kernel, kernel)
        app.*.chain = @ptrFromInt(*swapchain.Swapchain, chain)
        app.*.font = @ptrFromInt(*tt.Font, font)
        app.*.atlas = @ptrFromInt(*tt.Atlas, atlas)
        app.*.run = @ptrFromInt(*tt.Run, run)
        app.*.fullscreenRun = @ptrFromInt(*tt.Run, fullscreen_run)
        app.*.navigationRun = @ptrFromInt(*tt.Run, navigation_run)
        app.*.gestureRun = @ptrFromInt(*tt.Run, gesture_run)
        app.*.text = @ptrFromInt(*text_module.Text, text)
    }
    app.*.label = label
    app.*.hasText = false
    app.*.textFailed = false
    app.*.reserved = android.Reserved.unknown
    app.*.insets = ui.uniform(0)
    app.*.framesSinceInsets = 0
    app.*.fullscreen = false
    app.*.navigationHidden = false
    app.*.gestureBarTransparent = false
    app.*.fullscreenButton = ui.rect(0, 0, 0, 0)
    app.*.navigationButton = ui.rect(0, 0, 0, 0)
    app.*.gestureButton = ui.rect(0, 0, 0, 0)
    app.*.downX = -1
    app.*.downY = -1
    app.*.activity = activity
    app.*.window = 0
    app.*.queue = 0
    app.*.looper = android.ALooper_forThread()
    app.*.hasSwapchain = false
    app.*.time = 0
    app.*.frames = 0
    app.*.pointerSeen = false
    app.*.touching = false
    app.*.pointerX = 0
    app.*.pointerY = 0
    app.*.event = block + @sizeOf(App)
    app.*.timerSpec = app.*.event + 8
    app.*.vulkan = openVulkan(app)
    if app.*.vulkan { loadFont(app) } else { app.*.hasFont = false }
    app.*.timer = android.timerfd_create(CLOCK_MONOTONIC, TIMER_FLAGS)
    if app.*.timer >= 0 && app.*.looper != 0 {
        const added = android.ALooper_addFd(app.*.looper, app.*.timer, 2, android.LOOPER_EVENT_INPUT, @intFromPtr(onTimer), block)
    }
    unsafe { @ptrFromInt(*usize, activity + ACTIVITY_INSTANCE).* = block }
    setCallback(activity, ON_DESTROY, @intFromPtr(onDestroy))
    setCallback(activity, ON_NATIVE_WINDOW_CREATED, @intFromPtr(onWindowCreated))
    setCallback(activity, ON_NATIVE_WINDOW_RESIZED, @intFromPtr(onWindowResized))
    setCallback(activity, ON_NATIVE_WINDOW_REDRAW_NEEDED, @intFromPtr(onRedrawNeeded))
    setCallback(activity, ON_NATIVE_WINDOW_DESTROYED, @intFromPtr(onWindowDestroyed))
    setCallback(activity, ON_INPUT_QUEUE_CREATED, @intFromPtr(onInputQueueCreated))
    setCallback(activity, ON_INPUT_QUEUE_DESTROYED, @intFromPtr(onInputQueueDestroyed))
    setCallback(activity, ON_CONTENT_RECT_CHANGED, @intFromPtr(onContentRectChanged))
}
