// The app launcher of the Mlx desktop: a Wayland client in the
// compositor's overlay layer, centred on the screen, holding the keyboard
// until it closes. It lists the installed apps (desktop entries) with
// their icons, narrows the list as you type, and starts the one chosen
// (Enter, or a click) before it closes. Escape, Super or a click outside
// close it without starting anything. A right click on an app opens its
// menu: its own actions ("New Window", "New Private Window") and pinning
// it to the dock; an app dragged onto the dock is pinned there.
//
// The panel behind the list is translucent and asks the compositor to
// blur what is under it (ext-background-effect-v1).
//
//   mlx-launcher
//
// Apps that want a terminal run inside $MLX_TERMINAL (the compositor sets
// it), else mlx-terminal.
const std = @import("std")
const apps_module = @import("../desktop-shared/apps.mlx")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const panel_module = @import("../desktop-shared/panel.mlx")
const panel_drag = @import("../desktop-shared/panel_drag.mlx")
const panel_menu = @import("../desktop-shared/panel_menu.mlx")
const pins_module = @import("../desktop-shared/pins.mlx")
const menu_module = @import("../desktop-shared/menu.mlx")
const crash = @import("../wayland-compositor/crash.mlx")

const Apps = apps_module.Apps
const App = apps_module.App
const Canvas = canvas_module.Canvas
const Text = canvas_module.Text
const Panel = panel_module.Panel

const WIDTH: i32 = 720
const HEIGHT: i32 = 540
const RADIUS: i32 = 20
const PADDING: i32 = 24
const FIELD_HEIGHT: i32 = 44
const GRID_TOP: i32 = 92
const CELL_WIDTH: i32 = 112
const CELL_HEIGHT: i32 = 108
const COLUMNS: i32 = 6
const ROWS: i32 = 4
const ICON: i32 = 56
const MAX_QUERY: usize = 64
const NONE: usize = 1 << 40

const KEY_ESCAPE: u32 = 1
const KEY_BACKSPACE: u32 = 14
const KEY_TAB: u32 = 15
const KEY_ENTER: u32 = 28
const KEY_KEYPAD_ENTER: u32 = 96
const KEY_HOME: u32 = 102
const KEY_UP: u32 = 103
const KEY_PAGE_UP: u32 = 104
const KEY_LEFT: u32 = 105
const KEY_RIGHT: u32 = 106
const KEY_END: u32 = 107
const KEY_DOWN: u32 = 108
const KEY_PAGE_DOWN: u32 = 109
const KEY_LEFTMETA: u32 = 125
const KEY_RIGHTMETA: u32 = 126
const BUTTON_LEFT: u32 = 272
const BUTTON_RIGHT: u32 = 273
// How far the pointer moves with the button down before it drags.
const DRAG_DISTANCE: i32 = 8

const MENU_ACTION: u32 = 0
const MENU_PIN: u32 = 1
const MENU_UNPIN: u32 = 2

const Launcher = struct {
    panel: Panel
    apps: Apps
    environment: [*][*]const u8
    terminal: [*]const u8
    // What was typed, and the apps that match it (indexes into apps).
    query: [64]u8
    queryLength: usize
    matches: [*]usize
    matchCount: usize
    selected: usize
    firstRow: usize
    hover: usize
    // Text for names, the search field and letter tiles.
    small: Text
    field: Text
    large: Text
    // Started by the compositor to stay (MLX_LAUNCHER_FD): hidden until the
    // compositor says "show" on `channel`, and hidden again instead of
    // ending.
    stays: bool
    channel: isize
    // What the application directories looked like at the last scan.
    appsSignature: usize
    // The right-click menu, the app it is for (an index into apps; NONE:
    // closed) and its actions.
    menu: menu_module.Menu
    menuApp: usize
    actions: apps_module.Actions
    // The left button down on a choice (NONE: not), where, and whether it
    // became a drag.
    pressed: usize
    pressX: i32
    pressY: i32
    dragging: bool
    dragApp: usize
    // The pointer's last position.
    pointerX: i32
    pointerY: i32
}

fn launcherOf(context: *anyopaque) -> *Launcher {
    unsafe { return @ptrCast(*Launcher, context) }
}

fn menuOf(launcher: *Launcher) -> *menu_module.Menu {
    unsafe { return @ptrCast(*menu_module.Menu, &launcher.*.menu) }
}

fn actionsOf(launcher: *Launcher) -> *apps_module.Actions {
    unsafe { return @ptrCast(*apps_module.Actions, &launcher.*.actions) }
}

fn panelOf(launcher: *Launcher) -> *Panel {
    unsafe { return @ptrCast(*Panel, &launcher.*.panel) }
}

fn appsOf(launcher: *Launcher) -> *Apps {
    unsafe { return @ptrCast(*Apps, &launcher.*.apps) }
}

fn smallOf(launcher: *Launcher) -> *Text {
    unsafe { return @ptrCast(*Text, &launcher.*.small) }
}

fn fieldOf(launcher: *Launcher) -> *Text {
    unsafe { return @ptrCast(*Text, &launcher.*.field) }
}

fn largeOf(launcher: *Launcher) -> *Text {
    unsafe { return @ptrCast(*Text, &launcher.*.large) }
}

fn queryOf(launcher: *Launcher) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(launcher) + @offsetOf(Launcher, "query")) }
    return bytes[0..launcher.*.queryLength]
}

fn startsWithText(text: []const u8, part: []const u8) -> bool {
    return part.length <= text.length && apps_module.sameText(text[0..part.length], part)
}

// The apps matching the query: names that start with it first, then
// names, ids and commands that contain it.
fn filter(launcher: *Launcher) -> void {
    const apps = appsOf(launcher)
    const query = queryOf(launcher)
    launcher.*.matchCount = 0
    var index: usize = 0
    while index < apps.*.count {
        if startsWithText(apps_module.nameOf(apps_module.appAt(apps, index)), query) {
            launcher.*.matches[launcher.*.matchCount] = index
            launcher.*.matchCount += 1
        }
        index += 1
    }
    index = 0
    while index < apps.*.count {
        const app = apps_module.appAt(apps, index)
        const name = apps_module.nameOf(app)
        if !startsWithText(name, query) && (apps_module.containsText(name, query) || apps_module.containsText(apps_module.idOf(app), query) || apps_module.containsText(apps_module.execOf(app), query)) {
            launcher.*.matches[launcher.*.matchCount] = index
            launcher.*.matchCount += 1
        }
        index += 1
    }
    launcher.*.selected = 0
    launcher.*.firstRow = 0
    launcher.*.hover = NONE
}

fn rowCount(launcher: *Launcher) -> usize {
    return (launcher.*.matchCount + @intCast(usize, COLUMNS) - 1) / @intCast(usize, COLUMNS)
}

// Keeps the selected app on screen.
fn reveal(launcher: *Launcher) -> void {
    const row = launcher.*.selected / @intCast(usize, COLUMNS)
    if row < launcher.*.firstRow { launcher.*.firstRow = row }
    if row >= launcher.*.firstRow + @intCast(usize, ROWS) { launcher.*.firstRow = row + 1 - @intCast(usize, ROWS) }
}

fn scroll(launcher: *Launcher, rows: i32) -> void {
    const total = rowCount(launcher)
    const last = if total > @intCast(usize, ROWS) { total - @intCast(usize, ROWS) } else { 0 }
    if rows < 0 {
        const back = @intCast(usize, -rows)
        launcher.*.firstRow = if launcher.*.firstRow > back { launcher.*.firstRow - back } else { 0 }
    } else {
        launcher.*.firstRow += @intCast(usize, rows)
        if launcher.*.firstRow > last { launcher.*.firstRow = last }
    }
}

// Done with this showing: hidden (it stays) or ended.
fn dismiss(launcher: *Launcher) -> void {
    closeMenu(launcher)
    launcher.*.pressed = NONE
    if launcher.*.stays { panel_module.hide(panelOf(launcher)) } else { panelOf(launcher).*.running = false }
}

// Takes in apps installed or removed since the last look (one stat per
// application directory when nothing changed); the icons are loaded again
// right away for a launcher that stays.
fn refreshApps(launcher: *Launcher) -> void {
    const now = apps_module.signature(appsOf(launcher))
    if now == launcher.*.appsSignature { return }
    launcher.*.appsSignature = now
    apps_module.rescan(appsOf(launcher))
    panel_module.forgetImages(panelOf(launcher))
    if launcher.*.stays { loadIcons(launcher) }
    filter(launcher)
}

fn loadIcons(launcher: *Launcher) -> void {
    var index: usize = 0
    while index < appsOf(launcher).*.count {
        const loaded = apps_module.loadIcon(appsOf(launcher), apps_module.appAt(appsOf(launcher), index), @intCast(usize, ICON))
        index += 1
    }
}

// Shows it again, fresh: nothing typed, the first app chosen.
fn show(launcher: *Launcher) -> void {
    const panel = panelOf(launcher)
    if panel.*.hasSurface { return }
    refreshApps(launcher)
    launcher.*.queryLength = 0
    filter(launcher)
    const shown = panel_module.showLayer(panel, "mlx-launcher", panel_module.LAYER_OVERLAY, 0, @intCast(u32, WIDTH), @intCast(u32, HEIGHT), 0, 0, panel_module.KEYBOARD_EXCLUSIVE)
}

// What the compositor said on the channel: "s" shows; the end of it (the
// compositor is gone) ends us.
fn listen(launcher: *Launcher) -> void {
    var bytes: [16]u8 = undefined
    const count = std.linux.syscall3(0, @bitCast(usize, launcher.*.channel), @intFromPtr(&bytes), 16)
    if count == 0 {
        panelOf(launcher).*.running = false
        return
    }
    var index: isize = 0
    while index < count {
        if bytes[@intCast(usize, index)] == 115 { show(launcher) }
        index += 1
    }
}

fn start(launcher: *Launcher, choice: usize) -> void {
    if choice >= launcher.*.matchCount { return }
    const app = apps_module.appAt(appsOf(launcher), launcher.*.matches[choice])
    apps_module.launch(app, launcher.*.terminal, launcher.*.environment)
    dismiss(launcher)
}

fn moveSelection(launcher: *Launcher, by: i32) -> void {
    if launcher.*.matchCount == 0 { return }
    const count = @intCast(i32, launcher.*.matchCount)
    var next = @intCast(i32, launcher.*.selected) + by
    if next < 0 { next = if by == -1 { count - 1 } else { 0 } }
    if next >= count { next = if by == 1 { 0 } else { count - 1 } }
    launcher.*.selected = @intCast(usize, next)
    reveal(launcher)
}

// The choice under surface point (x, y), or NONE.
fn matchAt(launcher: *Launcher, x: i32, y: i32) -> usize {
    const left = (WIDTH - COLUMNS * CELL_WIDTH) / 2
    if x < left || x >= left + COLUMNS * CELL_WIDTH || y < GRID_TOP || y >= GRID_TOP + ROWS * CELL_HEIGHT { return NONE }
    const column = @intCast(usize, (x - left) / CELL_WIDTH)
    const row = @intCast(usize, (y - GRID_TOP) / CELL_HEIGHT) + launcher.*.firstRow
    const choice = row * @intCast(usize, COLUMNS) + column
    return if choice < launcher.*.matchCount { choice } else { NONE }
}

fn removeLastCharacter(launcher: *Launcher) -> void {
    while launcher.*.queryLength > 0 {
        launcher.*.queryLength -= 1
        const byte = launcher.*.query[launcher.*.queryLength]
        if byte < 128 || byte >= 192 { return }
    }
}

fn onKey(launcher: *Launcher, panel: *Panel, key: u32) -> void {
    if key == KEY_ESCAPE && launcher.*.menuApp != NONE {
        closeMenu(launcher)
    } else if key == KEY_ESCAPE || (!launcher.*.stays && (key == KEY_LEFTMETA || key == KEY_RIGHTMETA)) {
        // (Super: the compositor closes the launcher that stays itself.)
        dismiss(launcher)
    } else if key == KEY_ENTER || key == KEY_KEYPAD_ENTER {
        start(launcher, launcher.*.selected)
    } else if key == KEY_BACKSPACE {
        if launcher.*.queryLength > 0 {
            removeLastCharacter(launcher)
            filter(launcher)
        }
    } else if key == KEY_LEFT {
        moveSelection(launcher, -1)
    } else if key == KEY_RIGHT || key == KEY_TAB {
        moveSelection(launcher, 1)
    } else if key == KEY_UP {
        if launcher.*.selected >= @intCast(usize, COLUMNS) { moveSelection(launcher, -COLUMNS) }
    } else if key == KEY_DOWN {
        if launcher.*.selected + @intCast(usize, COLUMNS) < launcher.*.matchCount { moveSelection(launcher, COLUMNS) }
    } else if key == KEY_PAGE_UP {
        moveSelection(launcher, -COLUMNS * ROWS)
    } else if key == KEY_PAGE_DOWN {
        moveSelection(launcher, COLUMNS * ROWS)
    } else if key == KEY_HOME {
        moveSelection(launcher, -@intCast(i32, launcher.*.selected))
    } else if key == KEY_END {
        if launcher.*.matchCount > 0 { moveSelection(launcher, @intCast(i32, launcher.*.matchCount - 1 - launcher.*.selected)) }
    } else {
        // Typing narrows the list.
        const typed = panel_module.textOf(panel)
        if typed.length == 0 || typed[0] < 32 || typed[0] == 127 { return }
        if launcher.*.queryLength + typed.length > MAX_QUERY { return }
        for byte in typed {
            launcher.*.query[launcher.*.queryLength] = byte
            launcher.*.queryLength += 1
        }
        filter(launcher)
    }
}

// ---------------------------------------------------------------------------
// The right-click menu and dragging to the dock

fn drawMenu(context: *anyopaque, canvas: *Canvas) -> void {
    const launcher = launcherOf(context)
    menu_module.draw(menuOf(launcher), canvas, smallOf(launcher))
}

fn closeMenu(launcher: *Launcher) -> void {
    launcher.*.menuApp = NONE
    panel_menu.closeMenu(panelOf(launcher))
}

fn openMenu(launcher: *Launcher, choice: usize, x: i32, y: i32) -> void {
    if choice >= launcher.*.matchCount { return }
    const apps = appsOf(launcher)
    const index = launcher.*.matches[choice]
    const app = apps_module.appAt(apps, index)
    const menu = menuOf(launcher)
    menu_module.clear(menu)
    apps_module.loadActions(apps, app, actionsOf(launcher))
    var action: usize = 0
    while action < actionsOf(launcher).*.count {
        menu_module.add(menu, apps_module.actionName(actionsOf(launcher), action), MENU_ACTION, action)
        action += 1
    }
    menu_module.separator(menu)
    var pins: pins_module.Pins = undefined
    const read = pins_module.read(launcher.*.environment, pins_module.APPS, apps.*.allocator, &pins)
    if pins_module.find(&pins, apps_module.idOf(app)) < pins.count { menu_module.add(menu, "Unpin from Dock", MENU_UNPIN, 0) } else { menu_module.add(menu, "Pin to Dock", MENU_PIN, 0) }
    launcher.*.menuApp = index
    if !panel_menu.openMenu(panelOf(launcher), x, y, 1, 1, panel_module.PLACE_BOTTOM_RIGHT, menu_module.width(menu, smallOf(launcher)), menu_module.height(menu), drawMenu) { launcher.*.menuApp = NONE }
}

fn choose(launcher: *Launcher, entry: usize) -> void {
    const index = launcher.*.menuApp
    closeMenu(launcher)
    const apps = appsOf(launcher)
    if index >= apps.*.count || entry >= menuOf(launcher).*.count { return }
    const app = apps_module.appAt(apps, index)
    const kind = menu_module.kindAt(menuOf(launcher), entry)
    if kind == MENU_ACTION {
        apps_module.runAction(app, actionsOf(launcher), menu_module.valueAt(menuOf(launcher), entry), launcher.*.terminal, launcher.*.environment)
        dismiss(launcher)
        return
    }
    var pins: pins_module.Pins = undefined
    const read = pins_module.read(launcher.*.environment, pins_module.APPS, apps.*.allocator, &pins)
    if kind == MENU_PIN {
        pins_module.insert(&pins, apps_module.idOf(app), pins.count)
    } else {
        pins_module.remove(&pins, pins_module.find(&pins, apps_module.idOf(app)))
    }
    const written = pins_module.write(launcher.*.environment, pins_module.APPS, &pins)
}

fn drawDragIcon(context: *anyopaque, canvas: *Canvas) -> void {
    const launcher = launcherOf(context)
    const apps = appsOf(launcher)
    if launcher.*.dragApp < apps.*.count { drawIcon(launcher, canvas, apps_module.appAt(apps, launcher.*.dragApp), 0, 0) }
}

// The button went down on a choice and the pointer moved away: the app is
// dragged as its desktop entry file (for the dock).
fn startDrag(launcher: *Launcher) -> void {
    const choice = launcher.*.pressed
    launcher.*.pressed = NONE
    if choice >= launcher.*.matchCount { return }
    const apps = appsOf(launcher)
    const index = launcher.*.matches[choice]
    var path: apps_module.Path = undefined
    if !apps_module.entryPath(apps, apps_module.appAt(apps, index), &path) { return }
    var uri: apps_module.Path = undefined
    apps_module.pathClear(&uri)
    apps_module.pathAdd(&uri, "file://")
    apps_module.pathAdd(&uri, path.bytes[0..path.length])
    apps_module.pathAdd(&uri, "\r\n")
    launcher.*.dragApp = index
    launcher.*.dragging = panel_drag.startDrag(panelOf(launcher), "text/uri-list", uri.bytes[0..uri.length], @intCast(u32, ICON), drawDragIcon)
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const launcher = launcherOf(context)
    const panel = panelOf(launcher)
    if kind == panel_module.EVENT_CONFIGURED {
        // Blur behind the rounded panel.
        var rects: [52]i32 = undefined
        var count: usize = 0
        unsafe { count = panel_module.roundedRects(@ptrCast([*]i32, &rects), 0, 0, WIDTH, HEIGHT, RADIUS, 6) }
        unsafe { panel_module.setBlur(panel, @ptrCast([*]const i32, &rects), count) }
    } else if kind == panel_module.EVENT_MOTION {
        const x = @bitCast(i32, a)
        launcher.*.pointerX = x
        launcher.*.pointerY = b
        if launcher.*.pressed != NONE && !launcher.*.dragging {
            const dx = x - launcher.*.pressX
            const dy = b - launcher.*.pressY
            if dx * dx + dy * dy > DRAG_DISTANCE * DRAG_DISTANCE { startDrag(launcher) }
        }
        const hover = matchAt(launcher, x, b)
        if hover != launcher.*.hover {
            launcher.*.hover = hover
            panel.*.dirty = true
        }
        return
    } else if kind == panel_module.EVENT_LEAVE {
        launcher.*.hover = NONE
    } else if kind == panel_module.EVENT_BUTTON {
        // A click starts the app on release (pressed and moved, it drags).
        if a == BUTTON_LEFT && b == 1 {
            launcher.*.pressed = launcher.*.hover
            launcher.*.pressX = launcher.*.pointerX
            launcher.*.pressY = launcher.*.pointerY
        }
        if a == BUTTON_LEFT && b == 0 {
            const pressed = launcher.*.pressed
            launcher.*.pressed = NONE
            if pressed != NONE && pressed == launcher.*.hover { start(launcher, pressed) }
        }
        if a == BUTTON_RIGHT && b == 1 && launcher.*.hover != NONE { openMenu(launcher, launcher.*.hover, launcher.*.pointerX, launcher.*.pointerY) }
    } else if kind == panel_module.EVENT_MENU_MOTION {
        if menu_module.hover(menuOf(launcher), b) { panel_menu.menuChanged(panel) }
        return
    } else if kind == panel_module.EVENT_MENU_LEAVE {
        menuOf(launcher).*.hover = menu_module.NONE
        panel_menu.menuChanged(panel)
        return
    } else if kind == panel_module.EVENT_MENU_BUTTON {
        if b == 0 && menuOf(launcher).*.hover != menu_module.NONE { choose(launcher, menuOf(launcher).*.hover) }
    } else if kind == panel_module.EVENT_MENU_CLOSED {
        launcher.*.menuApp = NONE
    } else if kind == panel_module.EVENT_DRAG_END {
        launcher.*.dragging = false
        launcher.*.pressed = NONE
    } else if kind == panel_module.EVENT_WHEEL {
        if a == 0 { scroll(launcher, b) }
    } else if kind == panel_module.EVENT_WATCH {
        listen(launcher)
        return
    } else if kind == panel_module.EVENT_TICK {
        // While hidden: the list is up to date before it is next shown.
        if !panel.*.hasSurface { refreshApps(launcher) }
        return
    } else if kind == panel_module.EVENT_KEY {
        if b != 0 { onKey(launcher, panel, a) }
    }
    panel.*.dirty = true
}

// ---------------------------------------------------------------------------
// Drawing

const TEXT: u32 = 4294967295

// An app's icon, or a coloured tile with its first letter.
fn drawIcon(launcher: *Launcher, canvas: *Canvas, app: *App, x: i32, y: i32) -> void {
    if apps_module.loadIcon(appsOf(launcher), app, @intCast(usize, ICON)) {
        canvas_module.drawImage(canvas, apps_module.imageOf(app), x, y, ICON, 255)
        return
    }
    const name = apps_module.nameOf(app)
    canvas_module.fillRoundedRect(canvas, x + 2, y + 2, ICON - 4, ICON - 4, 14, apps_module.tileColor(name))
    if name.length == 0 { return }
    var letter: [1]u8 = [1]u8{ name[0] }
    if letter[0] >= 97 && letter[0] <= 122 { letter[0] -= 32 }
    const large = largeOf(launcher)
    const width = canvas_module.measure(large, letter[0..1])
    canvas_module.drawText(canvas, large, letter[0..1], x + (ICON - width) / 2, y + (ICON - 30) / 2, TEXT, 0)
}

fn drawCell(launcher: *Launcher, canvas: *Canvas, choice: usize, x: i32, y: i32) -> void {
    if choice == launcher.*.selected {
        canvas_module.fillRoundedRect(canvas, x + 4, y + 2, CELL_WIDTH - 8, CELL_HEIGHT - 4, 14, canvas_module.color(80, 255, 255, 255))
    } else if choice == launcher.*.hover {
        canvas_module.fillRoundedRect(canvas, x + 4, y + 2, CELL_WIDTH - 8, CELL_HEIGHT - 4, 14, canvas_module.color(40, 255, 255, 255))
    }
    const app = apps_module.appAt(appsOf(launcher), launcher.*.matches[choice])
    drawIcon(launcher, canvas, app, x + (CELL_WIDTH - ICON) / 2, y + 12)
    const small = smallOf(launcher)
    const name = apps_module.nameOf(app)
    var shortened: [100]u8 = undefined
    const shown = fitted(small, name, CELL_WIDTH - 12, &shortened)
    const width = canvas_module.measure(small, shown)
    canvas_module.drawText(canvas, small, shown, x + (CELL_WIDTH - width) / 2, y + ICON + 20, TEXT, 0)
}

// `name`, or as much of it as fits in `limit` pixels followed by an
// ellipsis (written into `buffer`).
fn fitted(text: *Text, name: []const u8, limit: i32, buffer: *[100]u8) -> []const u8 {
    if canvas_module.measure(text, name) <= limit { return name }
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, buffer) }
    var length = if name.length > 96 { 96 } else { name.length }
    while length > 0 {
        length -= 1
        // Cut between characters only.
        if length == 0 || name[length] < 128 || name[length] >= 192 {
            var index: usize = 0
            while index < length {
                bytes[index] = name[index]
                index += 1
            }
            bytes[length] = 226
            bytes[length + 1] = 128
            bytes[length + 2] = 166
            if canvas_module.measure(text, bytes[0..length + 3]) <= limit { return bytes[0..length + 3] }
        }
    }
    return bytes[0..0]
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const launcher = launcherOf(context)
    canvas_module.clear(canvas, 0)
    canvas_module.fillRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, RADIUS, canvas_module.color(165, 22, 26, 34))
    canvas_module.strokeRoundedRect(canvas, 0, 0, WIDTH, HEIGHT, RADIUS, 1, canvas_module.color(64, 255, 255, 255))

    // The search field.
    canvas_module.fillRoundedRect(canvas, PADDING, PADDING, WIDTH - PADDING * 2, FIELD_HEIGHT, 12, canvas_module.color(32, 255, 255, 255))
    const field = fieldOf(launcher)
    const query = queryOf(launcher)
    const text_top = PADDING + (FIELD_HEIGHT - 22) / 2
    if query.length == 0 {
        canvas_module.drawText(canvas, field, "Search apps", PADDING + 16, text_top, canvas_module.color(128, 255, 255, 255), 0)
        canvas_module.fillRect(canvas, PADDING + 15, text_top, 2, 22, TEXT)
    } else {
        const width = canvas_module.measure(field, query)
        canvas_module.drawText(canvas, field, query, PADDING + 16, text_top, TEXT, WIDTH - PADDING * 2 - 32)
        canvas_module.fillRect(canvas, PADDING + 17 + width, text_top, 2, 22, TEXT)
    }

    // The apps.
    const left = (WIDTH - COLUMNS * CELL_WIDTH) / 2
    if launcher.*.matchCount == 0 {
        const small = smallOf(launcher)
        const message = if appsOf(launcher).*.count == 0 { "No apps found" } else { "Nothing matches" }
        canvas_module.drawText(canvas, small, message, (WIDTH - canvas_module.measure(small, message)) / 2, GRID_TOP + 40, canvas_module.color(128, 255, 255, 255), 0)
        return
    }
    var row: i32 = 0
    while row < ROWS {
        var column: i32 = 0
        while column < COLUMNS {
            const choice = (launcher.*.firstRow + @intCast(usize, row)) * @intCast(usize, COLUMNS) + @intCast(usize, column)
            if choice < launcher.*.matchCount { drawCell(launcher, canvas, choice, left + column * CELL_WIDTH, GRID_TOP + row * CELL_HEIGHT) }
            column += 1
        }
        row += 1
    }
    // A scroll bar when there is more.
    const total = rowCount(launcher)
    if total > @intCast(usize, ROWS) {
        const track = ROWS * CELL_HEIGHT - 8
        const bar = track * ROWS / @intCast(i32, total)
        const top = GRID_TOP + 4 + track * @intCast(i32, launcher.*.firstRow) / @intCast(i32, total)
        canvas_module.fillRoundedRect(canvas, WIDTH - 12, top, 4, bar, 2, canvas_module.color(96, 255, 255, 255))
    }
}

const Failure = error { NoMemory }

fn noMemory() -> Failure!void { return Failure.NoMemory }

pub fn main(arguments: [][*]const u8) -> !void {
    crash.install()
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Launcher), 16)
    if memory == null { return noMemory() }
    var launcher: *Launcher = undefined
    unsafe { launcher = @ptrCast(*Launcher, memory.?) }
    launcher.*.environment = environment
    launcher.*.terminal = apps_module.environmentValue(environment, "MLX_TERMINAL")
    if @intFromPtr(launcher.*.terminal) == 0 {
        unsafe { launcher.*.terminal = @ptrCast([*]const u8, "mlx-terminal") }
    }
    launcher.*.queryLength = 0
    launcher.*.hover = NONE
    launcher.*.menuApp = NONE
    launcher.*.pressed = NONE
    launcher.*.dragging = false
    launcher.*.dragApp = NONE
    launcher.*.pointerX = 0
    launcher.*.pointerY = 0
    if !apps_module.init(appsOf(launcher), environment, allocator) { return noMemory() }
    apps_module.scan(appsOf(launcher))
    launcher.*.appsSignature = apps_module.signature(appsOf(launcher))
    const matches = allocator.alloc(apps_module.MAX_APPS * 8, 8)
    if matches == null { return noMemory() }
    unsafe { launcher.*.matches = @ptrCast([*]usize, matches.?) }
    filter(launcher)
    const loaded_small = canvas_module.loadText(smallOf(launcher), 13, allocator)
    const loaded_field = canvas_module.loadText(fieldOf(launcher), 18, allocator)
    const loaded_large = canvas_module.loadText(largeOf(launcher), 30, allocator)

    const panel = panelOf(launcher)
    panel.*.context = @ptrCast(*anyopaque, launcher)
    panel.*.draw = draw
    panel.*.event = onEvent
    const channel = apps_module.environmentValue(environment, "MLX_LAUNCHER_FD")
    launcher.*.stays = @intFromPtr(channel) != 0 && channel[0] >= 48 && channel[0] <= 57
    if !launcher.*.stays {
        try panel_module.open(panel, allocator, arguments, "mlx-launcher", panel_module.LAYER_OVERLAY, 0, @intCast(u32, WIDTH), @intCast(u32, HEIGHT), 0, 0, panel_module.KEYBOARD_EXCLUSIVE, false)
        try panel_module.run(panel)
        panel_module.close(panel)
        return
    }
    // Staying: everything a showing needs is loaded now (the icons too), so
    // Super shows it within a frame.
    var descriptor: isize = 0
    var index: usize = 0
    while channel[index] >= 48 && channel[index] <= 57 {
        descriptor = descriptor * 10 + @intCast(isize, channel[index] - 48)
        index += 1
    }
    launcher.*.channel = descriptor
    loadIcons(launcher)
    try panel_module.connect(panel, allocator, arguments, @intCast(u32, WIDTH), @intCast(u32, HEIGHT), false)
    panel_module.report(panel, "mlx-launcher")
    panel.*.keepAlive = true
    panel.*.watch = descriptor
    panel.*.tickInterval = 15000
    const wanted = apps_module.environmentValue(environment, "MLX_LAUNCHER_SHOW")
    if @intFromPtr(wanted) != 0 && wanted[0] == 49 { show(launcher) }
    try panel_module.run(panel)
    panel_module.close(panel)
}
