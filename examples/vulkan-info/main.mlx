// Lists the Vulkan drivers installed on this system and, for each, the
// physical devices it exposes -- through std.vulkan.loader, with no C
// loader: the ICD manifests are read and the drivers loaded directly.
//
//     mlx4 examples/vulkan-info/main.mlx -o vulkan-info
//     ./vulkan-info                 all drivers
//     ./vulkan-info --system        through the system loader (libvulkan.so.1)
//
// VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json limits the search to
// one driver, as with the Khronos loader.

const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }
fn sayNumber(value: usize) -> void { const ignored = std.io.writeUnsigned(std.io.stdout(), value) }
fn sayC(text: [*]const u8) -> void { const ignored = std.io.writeString(std.io.stdout(), std.process.fromCString(text)) }

fn sayVersion(version: u32) -> void {
    sayNumber(@intCast(usize, vk.apiVersionMajor(version)))
    say(".")
    sayNumber(@intCast(usize, vk.apiVersionMinor(version)))
    say(".")
    sayNumber(@intCast(usize, vk.apiVersionPatch(version)))
}

fn sayFixed(bytes: [*]const u8) -> void { sayC(bytes) }

fn deviceType(kind: vk.PhysicalDeviceType) -> []const u8 {
    if kind == vk.PhysicalDeviceType.integratedGpu { return "integrated GPU" }
    if kind == vk.PhysicalDeviceType.discreteGpu { return "discrete GPU" }
    if kind == vk.PhysicalDeviceType.virtualGpu { return "virtual GPU" }
    if kind == vk.PhysicalDeviceType.cpu { return "CPU" }
    return "other"
}

fn describeDevice(commands: *const vk.InstanceCommands, device: vk.PhysicalDevice) -> void {
    var properties: vk.PhysicalDeviceProperties = undefined
    vk.getPhysicalDeviceProperties(commands, device, &properties)
    say("    device: ")
    unsafe { sayFixed(@ptrCast([*]const u8, &properties.deviceName)) }
    say(" (")
    say(deviceType(properties.deviceType))
    say(", Vulkan ")
    sayVersion(properties.apiVersion)
    say(")\n")

    var family_count: u32 = 0
    vk.getPhysicalDeviceQueueFamilyProperties(commands, device, &family_count, null)
    var families: [16]vk.QueueFamilyProperties = undefined
    if family_count > 16 { family_count = 16 }
    unsafe { vk.getPhysicalDeviceQueueFamilyProperties(commands, device, &family_count, @ptrCast([*]vk.QueueFamilyProperties, &families)) }
    var index: u32 = 0
    while index < family_count {
        const family = families[index]
        say("      queue family ")
        sayNumber(@intCast(usize, index))
        say(": ")
        sayNumber(@intCast(usize, family.queueCount))
        say(" queue(s),")
        if family.queueFlags & vk.QUEUE_GRAPHICS_BIT != 0 { say(" graphics") }
        if family.queueFlags & vk.QUEUE_COMPUTE_BIT != 0 { say(" compute") }
        if family.queueFlags & vk.QUEUE_TRANSFER_BIT != 0 { say(" transfer") }
        say("\n")
        index += 1
    }

    var memory: vk.PhysicalDeviceMemoryProperties = undefined
    vk.getPhysicalDeviceMemoryProperties(commands, device, &memory)
    var heap: u32 = 0
    while heap < memory.memoryHeapCount {
        say("      memory heap ")
        sayNumber(@intCast(usize, heap))
        say(": ")
        sayNumber(@intCast(usize, memory.memoryHeaps[heap].size / 1048576))
        say(" MiB")
        if memory.memoryHeaps[heap].flags & vk.MEMORY_HEAP_DEVICE_LOCAL_BIT != 0 { say(", device local") }
        say("\n")
        heap += 1
    }
}

fn describeDriver(driver: *const loader.Driver) -> bool {
    var application = vk.ApplicationInfo.init()
    unsafe { application.pApplicationName = @ptrCast([*]const u8, "vulkan-info") }
    application.apiVersion = vk.API_VERSION_1_3
    var info = vk.InstanceCreateInfo.init()
    info.pApplicationInfo = &application
    var instance: vk.Instance = 0
    const created = vk.createInstance(driver.*.global, &info, null, &instance)
    if created != vk.Result.success {
        say("    vkCreateInstance failed: ")
        const code = std.io.writeSigned(std.io.stdout(), @intCast(isize, @intFromEnum(created)))
        say("\n")
        return false
    }
    var commands: vk.InstanceCommands = undefined
    vk.loadInstanceCommands(&commands, instance, driver.*.getInstanceProcAddr)
    var count: u32 = 0
    const counted = vk.enumeratePhysicalDevices(&commands, instance, &count, null)
    var devices: [8]vk.PhysicalDevice = undefined
    if count > 8 { count = 8 }
    unsafe { const listed = vk.enumeratePhysicalDevices(&commands, instance, &count, @ptrCast([*]vk.PhysicalDevice, &devices)) }
    var index: u32 = 0
    while index < count {
        describeDevice(&commands, devices[index])
        index += 1
    }
    vk.destroyInstance(&commands, instance, null)
    return count > 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    if std.process.count(arguments) > 1 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--system")) {
        var system: loader.Driver = undefined
        var status = loader.Status.ok
        unsafe { status = loader.openSystemLoader(&system, @ptrCast([*]const u8, loader.SYSTEM_LOADER_LINUX), allocator) }
        if status != loader.Status.ok {
            say("system loader: ")
            say(loader.statusMessage(status))
            say("\n")
            return 1
        }
        say("system loader (Vulkan ")
        sayVersion(system.apiVersion)
        say(")\n")
        if !describeDriver(&system) { return 1 }
        return 0
    }
    var manifests: loader.Manifests = undefined
    const found = loader.findDrivers(&manifests, arguments, allocator)
    if found == 0 {
        say("no Vulkan drivers found\n")
        return 1
    }
    var working: usize = 0
    var index: usize = 0
    while index < found {
        const manifest = loader.manifestAt(&manifests, index)
        say("driver ")
        sayC(loader.libraryPath(manifest))
        say(" (")
        sayC(loader.manifestPath(manifest))
        say(")\n")
        var driver: loader.Driver = undefined
        const status = loader.openDriver(&driver, manifest, allocator)
        if status != loader.Status.ok {
            say("    ")
            say(loader.statusMessage(status))
            say("\n")
        } else {
            say("    interface version ")
            sayNumber(@intCast(usize, driver.interfaceVersion))
            say(", Vulkan ")
            sayVersion(driver.apiVersion)
            say("\n")
            if describeDriver(&driver) { working += 1 }
        }
        index += 1
    }
    return if working > 0 { 0 } else { 1 }
}
