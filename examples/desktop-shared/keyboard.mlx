// Keyboard text for clients: the compositor's keymap (wl_keyboard.keymap)
// compiled by libxkbcommon when it is installed, so any layout types what
// its keys say (a German keyboard types ä and z where it should); without
// it, a US layout (examples/wayland-terminal/keys.mlx) with Shift and Caps
// Lock taken from the modifiers.
const std = @import("std")
const wl = @import("std.wayland")
const us = @import("../wayland-terminal/keys.mlx")

extern("c") fn dlopen(name: [*]const u8, flags: i32) -> usize
extern("c") fn dlsym(handle: usize, name: [*]const u8) -> usize

const RTLD_NOW: i32 = 2

const ContextNew = fn(i32) -> usize
const KeymapNewFromString = fn(usize, [*]const u8, i32, i32) -> usize
const StateNew = fn(usize) -> usize
const StateUpdateMask = fn(usize, u32, u32, u32, u32, u32, u32) -> i32
const StateKeyGetUtf8 = fn(usize, u32, [*]u8, usize) -> i32

pub const Keyboard = struct {
    context: usize
    keymapNew: usize
    stateNew: usize
    updateMask: usize
    getUtf8: usize
    state: usize
    depressed: u32
    latched: u32
    locked: u32
}

fn symbol(library: usize, name: []const u8) -> usize {
    unsafe { return dlsym(library, @ptrCast([*]const u8, name)) }
}

pub fn init(keyboard: *Keyboard) -> void {
    keyboard.*.context = 0
    keyboard.*.state = 0
    keyboard.*.depressed = 0
    keyboard.*.latched = 0
    keyboard.*.locked = 0
    var library: usize = 0
    unsafe { library = dlopen(@ptrCast([*]const u8, "libxkbcommon.so.0"), RTLD_NOW) }
    if library == 0 { return }
    const context_new = symbol(library, "xkb_context_new")
    keyboard.*.keymapNew = symbol(library, "xkb_keymap_new_from_string")
    keyboard.*.stateNew = symbol(library, "xkb_state_new")
    keyboard.*.updateMask = symbol(library, "xkb_state_update_mask")
    keyboard.*.getUtf8 = symbol(library, "xkb_state_key_get_utf8")
    if context_new == 0 || keyboard.*.keymapNew == 0 || keyboard.*.stateNew == 0 || keyboard.*.updateMask == 0 || keyboard.*.getUtf8 == 0 { return }
    var make_context: ContextNew = undefined
    unsafe { make_context = @ptrFromInt(ContextNew, context_new) }
    keyboard.*.context = make_context(0)
}

// wl_keyboard.keymap: compiles the keymap text the compositor sent.
pub fn keymap(keyboard: *Keyboard, handle: wl.Handle, format: u32, size: u32) -> void {
    if keyboard.*.context == 0 || format != 1 || size == 0 {
        handle.close()
        return
    }
    var memory: wl.SharedMemory = undefined
    if !wl.transport.mapSharedMemory(&memory, handle, @intCast(usize, size), false) {
        handle.close()
        return
    }
    var make_keymap: KeymapNewFromString = undefined
    var make_state: StateNew = undefined
    unsafe {
        make_keymap = @ptrFromInt(KeymapNewFromString, keyboard.*.keymapNew)
        make_state = @ptrFromInt(StateNew, keyboard.*.stateNew)
    }
    const compiled = make_keymap(keyboard.*.context, memory.bytes(), 1, 0)
    memory.release()
    if compiled == 0 { return }
    const created = make_state(compiled)
    if created != 0 { keyboard.*.state = created }
}

// wl_keyboard.modifiers.
pub fn modifiers(keyboard: *Keyboard, depressed: u32, latched: u32, locked: u32, group: u32) -> void {
    keyboard.*.depressed = depressed
    keyboard.*.latched = latched
    keyboard.*.locked = locked
    if keyboard.*.state == 0 { return }
    var update: StateUpdateMask = undefined
    unsafe { update = @ptrFromInt(StateUpdateMask, keyboard.*.updateMask) }
    const changed = update(keyboard.*.state, depressed, latched, locked, 0, 0, group)
}

pub fn control(keyboard: *const Keyboard) -> bool { return keyboard.*.depressed & 4 != 0 }

// The text evdev key `key` types now (UTF-8 into `out`, at most 8 bytes);
// 0 bytes for keys that type nothing (and for control characters).
pub fn text(keyboard: *Keyboard, key: u32, out: [*]u8) -> usize {
    if keyboard.*.state != 0 {
        var get: StateKeyGetUtf8 = undefined
        unsafe { get = @ptrFromInt(StateKeyGetUtf8, keyboard.*.getUtf8) }
        const length = get(keyboard.*.state, key + 8, out, 8)
        if length <= 0 || length > 7 { return 0 }
        if out[0] < 32 || out[0] == 127 { return 0 }
        return @intCast(usize, length)
    }
    const shift = keyboard.*.depressed & 1 != 0
    const caps = keyboard.*.locked & 2 != 0
    const length = us.encode(key, shift, false, caps, out)
    if length != 1 || out[0] < 32 || out[0] == 127 { return 0 }
    return length
}
