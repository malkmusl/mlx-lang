// Key combinations as the compositor's settings file writes them
// ("Super+Up", "Alt+Return", "Ctrl+Shift+F5"): Linux input key codes
// (evdev) and a modifier mask. Shared by the compositor (its hotkeys) and
// mlx-settings (which records and writes them).
pub const SHIFT: u32 = 1
pub const CONTROL: u32 = 2
pub const ALT: u32 = 4
pub const SUPER: u32 = 8

const Named = struct {
    code: u32
    name: []const u8
}

fn named(index: usize) -> Named {
    return match index {
        0 => Named.{ .code = 16, .name = "Q" }, 1 => Named.{ .code = 17, .name = "W" }, 2 => Named.{ .code = 18, .name = "E" },
        3 => Named.{ .code = 19, .name = "R" }, 4 => Named.{ .code = 20, .name = "T" }, 5 => Named.{ .code = 21, .name = "Y" },
        6 => Named.{ .code = 22, .name = "U" }, 7 => Named.{ .code = 23, .name = "I" }, 8 => Named.{ .code = 24, .name = "O" },
        9 => Named.{ .code = 25, .name = "P" }, 10 => Named.{ .code = 30, .name = "A" }, 11 => Named.{ .code = 31, .name = "S" },
        12 => Named.{ .code = 32, .name = "D" }, 13 => Named.{ .code = 33, .name = "F" }, 14 => Named.{ .code = 34, .name = "G" },
        15 => Named.{ .code = 35, .name = "H" }, 16 => Named.{ .code = 36, .name = "J" }, 17 => Named.{ .code = 37, .name = "K" },
        18 => Named.{ .code = 38, .name = "L" }, 19 => Named.{ .code = 44, .name = "Z" }, 20 => Named.{ .code = 45, .name = "X" },
        21 => Named.{ .code = 46, .name = "C" }, 22 => Named.{ .code = 47, .name = "V" }, 23 => Named.{ .code = 48, .name = "B" },
        24 => Named.{ .code = 49, .name = "N" }, 25 => Named.{ .code = 50, .name = "M" },
        26 => Named.{ .code = 2, .name = "1" }, 27 => Named.{ .code = 3, .name = "2" }, 28 => Named.{ .code = 4, .name = "3" },
        29 => Named.{ .code = 5, .name = "4" }, 30 => Named.{ .code = 6, .name = "5" }, 31 => Named.{ .code = 7, .name = "6" },
        32 => Named.{ .code = 8, .name = "7" }, 33 => Named.{ .code = 9, .name = "8" }, 34 => Named.{ .code = 10, .name = "9" },
        35 => Named.{ .code = 11, .name = "0" },
        36 => Named.{ .code = 59, .name = "F1" }, 37 => Named.{ .code = 60, .name = "F2" }, 38 => Named.{ .code = 61, .name = "F3" },
        39 => Named.{ .code = 62, .name = "F4" }, 40 => Named.{ .code = 63, .name = "F5" }, 41 => Named.{ .code = 64, .name = "F6" },
        42 => Named.{ .code = 65, .name = "F7" }, 43 => Named.{ .code = 66, .name = "F8" }, 44 => Named.{ .code = 67, .name = "F9" },
        45 => Named.{ .code = 68, .name = "F10" }, 46 => Named.{ .code = 87, .name = "F11" }, 47 => Named.{ .code = 88, .name = "F12" },
        48 => Named.{ .code = 103, .name = "Up" }, 49 => Named.{ .code = 108, .name = "Down" }, 50 => Named.{ .code = 105, .name = "Left" },
        51 => Named.{ .code = 106, .name = "Right" }, 52 => Named.{ .code = 28, .name = "Return" }, 53 => Named.{ .code = 57, .name = "Space" },
        54 => Named.{ .code = 15, .name = "Tab" }, 55 => Named.{ .code = 1, .name = "Escape" }, 56 => Named.{ .code = 14, .name = "BackSpace" },
        57 => Named.{ .code = 111, .name = "Delete" }, 58 => Named.{ .code = 102, .name = "Home" }, 59 => Named.{ .code = 107, .name = "End" },
        60 => Named.{ .code = 104, .name = "PageUp" }, 61 => Named.{ .code = 109, .name = "PageDown" }, 62 => Named.{ .code = 110, .name = "Insert" },
        63 => Named.{ .code = 99, .name = "Print" }, 64 => Named.{ .code = 12, .name = "Minus" }, 65 => Named.{ .code = 13, .name = "Equal" },
        else => Named.{ .code = 0, .name = "" }
    }
}

const NAMES: usize = 66

// A key's name, "" for one without.
pub fn keyName(code: u32) -> []const u8 {
    var index: usize = 0
    while index < NAMES {
        const entry = named(index)
        if entry.code == code { return entry.name }
        index += 1
    }
    return ""
}

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn sameName(text: []const u8, name: []const u8) -> bool {
    if text.length != name.length { return false }
    var index: usize = 0
    while index < text.length {
        if lower(text[index]) != lower(name[index]) { return false }
        index += 1
    }
    return true
}

// A key's code from its name (any case; "Enter" too), 0 when unknown.
pub fn keyCode(name: []const u8) -> u32 {
    if sameName(name, "Enter") { return 28 }
    if sameName(name, "Esc") { return 1 }
    var index: usize = 0
    while index < NAMES {
        const entry = named(index)
        if sameName(name, entry.name) { return entry.code }
        index += 1
    }
    return 0
}

fn modifierNamed(name: []const u8) -> u32 {
    if sameName(name, "Shift") { return SHIFT }
    if sameName(name, "Ctrl") || sameName(name, "Control") { return CONTROL }
    if sameName(name, "Alt") { return ALT }
    if sameName(name, "Super") || sameName(name, "Meta") || sameName(name, "Logo") { return SUPER }
    return 0
}

// The modifier a modifier key is (0 for other keys).
pub fn modifierOf(code: u32) -> u32 {
    if code == 42 || code == 54 { return SHIFT }
    if code == 29 || code == 97 { return CONTROL }
    if code == 56 || code == 100 { return ALT }
    if code == 125 || code == 126 { return SUPER }
    return 0
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 }

// "Mod+Mod+Key" into a mask and a key code; false when it does not parse
// (an unknown name, no key, the key a modifier).
pub fn parse(text: []const u8, modifiers: *u32, key: *u32) -> bool {
    var mask: u32 = 0
    var found: u32 = 0
    var start: usize = 0
    var index: usize = 0
    while index <= text.length {
        if index == text.length || text[index] == 43 {
            var first = start
            var last = index
            while first < last && isSpace(text[first]) { first += 1 }
            while last > first && isSpace(text[last - 1]) { last -= 1 }
            if first == last { return false }
            const part = text[first..last]
            const modifier = modifierNamed(part)
            if modifier != 0 && index != text.length {
                mask = mask | modifier
            } else {
                if index != text.length { return false }
                found = keyCode(part)
                if found == 0 { return false }
            }
            start = index + 1
        }
        index += 1
    }
    modifiers.* = mask
    key.* = found
    return true
}

fn put(out: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        out[index] = byte
        index += 1
    }
    return index
}

// The combination as text into `out` (at least 40 bytes); its length.
pub fn format(modifiers: u32, key: u32, out: [*]u8) -> usize {
    var length: usize = 0
    if modifiers & SUPER != 0 { length = put(out, length, "Super+") }
    if modifiers & CONTROL != 0 { length = put(out, length, "Ctrl+") }
    if modifiers & ALT != 0 { length = put(out, length, "Alt+") }
    if modifiers & SHIFT != 0 { length = put(out, length, "Shift+") }
    return put(out, length, keyName(key))
}

// The actions the compositor binds, in the order of its table.
pub const ACTIONS: usize = 6
pub const ACTION_MAXIMIZE: usize = 0
pub const ACTION_MINIMIZE: usize = 1
pub const ACTION_FULLSCREEN: usize = 2
pub const ACTION_CLOSE: usize = 3
pub const ACTION_TERMINAL: usize = 4
pub const ACTION_SWITCH: usize = 5

// The settings file's key for an action ("key-maximize").
pub fn actionKey(action: usize) -> []const u8 {
    return match action {
        0 => "key-maximize", 1 => "key-minimize", 2 => "key-fullscreen", 3 => "key-close", 4 => "key-terminal",
        else => "key-switch"
    }
}

// What the action does, for mlx-settings.
pub fn actionLabel(action: usize) -> []const u8 {
    return match action {
        0 => "Maximize or restore", 1 => "Minimize", 2 => "Fullscreen", 3 => "Close window", 4 => "Open a terminal",
        else => "Next window"
    }
}

// The default combination of an action.
pub fn defaultBinding(action: usize, modifiers: *u32, key: *u32) -> void {
    modifiers.* = match action { 0 => SUPER, 1 => SUPER, 2 => SUPER, else => ALT }
    key.* = match action { 0 => 103, 1 => 108, 2 => 33, 3 => 62, 4 => 28, else => 15 }
}
