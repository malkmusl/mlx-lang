// Drawing for the dock and the launcher, in premultiplied ARGB (wl_shm
// ARGB8888): filled and rounded rectangles with smooth corners, images
// (std.png) at any size, and text (std.truetype) that blends over
// translucent pixels too.
const std = @import("std")
const png = @import("std.png")
const tt = @import("std.truetype")

const Allocator = std.allocator.Allocator

pub const Canvas = struct {
    pixels: [*]u32
    width: usize
    height: usize
}

// `color` (premultiplied) over `under` at `coverage` (0-255).
pub fn over(under: u32, color: u32, coverage: u32) -> u32 {
    if coverage == 0 { return under }
    var alpha = color >> 24
    var red = (color >> 16) & 255
    var green = (color >> 8) & 255
    var blue = color & 255
    if coverage < 255 {
        alpha = (alpha * coverage + 127) / 255
        red = (red * coverage + 127) / 255
        green = (green * coverage + 127) / 255
        blue = (blue * coverage + 127) / 255
    }
    if alpha == 255 { return (alpha << 24) | (red << 16) | (green << 8) | blue }
    const keep = 255 - alpha
    const a = alpha + ((under >> 24) * keep + 127) / 255
    const r = red + (((under >> 16) & 255) * keep + 127) / 255
    const g = green + (((under >> 8) & 255) * keep + 127) / 255
    const b = blue + ((under & 255) * keep + 127) / 255
    return (minimum(a, 255) << 24) | (minimum(r, 255) << 16) | (minimum(g, 255) << 8) | minimum(b, 255)
}

fn minimum(value: u32, limit: u32) -> u32 { return if value > limit { limit } else { value } }

// A straight-alpha colour premultiplied: 0xAARRGGBB with alpha applied.
pub fn premultiplied(color: u32) -> u32 {
    const alpha = color >> 24
    if alpha == 255 { return color }
    return (alpha << 24) | ((((color >> 16) & 255) * alpha + 127) / 255 << 16) | ((((color >> 8) & 255) * alpha + 127) / 255 << 8) | ((color & 255) * alpha + 127) / 255
}

// A colour from straight alpha, red, green and blue (0-255), premultiplied.
pub fn color(alpha: u32, red: u32, green: u32, blue: u32) -> u32 {
    return premultiplied((alpha << 24) | (red << 16) | (green << 8) | blue)
}

pub fn clear(canvas: *Canvas, color: u32) -> void {
    var index: usize = 0
    while index < canvas.*.width * canvas.*.height {
        canvas.*.pixels[index] = color
        index += 1
    }
}

fn blend(canvas: *Canvas, x: i32, y: i32, color: u32, coverage: u32) -> void {
    if x < 0 || y < 0 || x >= @intCast(i32, canvas.*.width) || y >= @intCast(i32, canvas.*.height) { return }
    const at = @intCast(usize, y) * canvas.*.width + @intCast(usize, x)
    canvas.*.pixels[at] = over(canvas.*.pixels[at], color, coverage)
}

pub fn fillRect(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, color: u32) -> void {
    var row = y
    while row < y + height {
        var column = x
        while column < x + width {
            blend(canvas, column, row, color, 255)
            column += 1
        }
        row += 1
    }
}

// How much of pixel (x, y) (relative to a corner circle's centre, in a
// quarter of radius `radius`) lies inside the circle: 4x4 samples.
fn cornerCoverage(x: i32, y: i32, radius: i32) -> u32 {
    var inside: u32 = 0
    const limit = radius * radius * 64
    var sy: i32 = 0
    while sy < 4 {
        var sx: i32 = 0
        while sx < 4 {
            const px = x * 8 + sx * 2 + 1
            const py = y * 8 + sy * 2 + 1
            if px * px + py * py <= limit { inside += 1 }
            sx += 1
        }
        sy += 1
    }
    return inside * 255 / 16
}

// Whether (x, y) of a width x height rectangle with corners of `radius`
// is covered, as coverage 0-255.
pub fn roundedCoverage(x: i32, y: i32, width: i32, height: i32, radius: i32) -> u32 {
    if x < 0 || y < 0 || x >= width || y >= height { return 0 }
    var dx: i32 = 0
    var dy: i32 = 0
    if x < radius { dx = radius - 1 - x } else if x >= width - radius { dx = x - (width - radius) }
    if y < radius { dy = radius - 1 - y } else if y >= height - radius { dy = y - (height - radius) }
    if (x >= radius && x < width - radius) || (y >= radius && y < height - radius) { return 255 }
    return cornerCoverage(dx, dy, radius)
}

pub fn fillRoundedRect(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, radius: i32, color: u32) -> void {
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            blend(canvas, x + column, y + row, color, roundedCoverage(column, row, width, height, radius))
            column += 1
        }
        row += 1
    }
}

// The outline of a rounded rectangle, `thickness` wide, inside it.
pub fn strokeRoundedRect(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, radius: i32, thickness: i32, color: u32) -> void {
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            const outer = roundedCoverage(column, row, width, height, radius)
            const inner = roundedCoverage(column - thickness, row - thickness, width - thickness * 2, height - thickness * 2, if radius > thickness { radius - thickness } else { 0 })
            if outer > inner { blend(canvas, x + column, y + row, color, outer - inner) }
            column += 1
        }
        row += 1
    }
}

// Draws `image` at (x, y) resized to `size` x `size` (bilinear), faded by
// `opacity` (255: as it is).
pub fn drawImage(canvas: *Canvas, image: *const png.Image, x: i32, y: i32, size: i32, opacity: u32) -> void {
    if size <= 0 || image.*.width == 0 { return }
    const source_width = @intCast(i32, image.*.width)
    const source_height = @intCast(i32, image.*.height)
    var row: i32 = 0
    while row < size {
        var column: i32 = 0
        while column < size {
            // Sample position in 1/256 source pixels.
            const sx = ((column * 2 + 1) * source_width * 128) / size - 128
            const sy = ((row * 2 + 1) * source_height * 128) / size - 128
            const pixel = sample(image, sx, sy)
            blend(canvas, x + column, y + row, pixel, opacity)
            column += 1
        }
        row += 1
    }
}

fn clampTo(value: i32, limit: i32) -> i32 {
    if value < 0 { return 0 }
    if value >= limit { return limit - 1 }
    return value
}

fn sample(image: *const png.Image, sx: i32, sy: i32) -> u32 {
    const width = @intCast(i32, image.*.width)
    const height = @intCast(i32, image.*.height)
    const x0 = clampTo(if sx < 0 { 0 } else { sx / 256 }, width)
    const y0 = clampTo(if sy < 0 { 0 } else { sy / 256 }, height)
    const x1 = clampTo(x0 + 1, width)
    const y1 = clampTo(y0 + 1, height)
    const fx = @intCast(u32, if sx < 0 { 0 } else { sx % 256 })
    const fy = @intCast(u32, if sy < 0 { 0 } else { sy % 256 })
    const a = image.*.pixels[@intCast(usize, y0 * width + x0)]
    const b = image.*.pixels[@intCast(usize, y0 * width + x1)]
    const c = image.*.pixels[@intCast(usize, y1 * width + x0)]
    const d = image.*.pixels[@intCast(usize, y1 * width + x1)]
    var result: u32 = 0
    var shift: u32 = 0
    while shift < 32 {
        const top = ((a >> shift) & 255) * (256 - fx) + ((b >> shift) & 255) * fx
        const bottom = ((c >> shift) & 255) * (256 - fx) + ((d >> shift) & 255) * fx
        const value = (top * (256 - fy) + bottom * fy) / 65536
        result = result | (minimum(value, 255) << shift)
        shift += 8
    }
    return result
}

// ---------------------------------------------------------------------------
// Text

pub const Text = struct {
    font: tt.Font
    atlas: tt.Atlas
    run: tt.Run
    loaded: bool
    // Pixels above and below the baseline of a line.
    ascent: i32
}

fn fontPath(index: usize) -> []const u8 {
    if index == 0 { return "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" }
    if index == 1 { return "/usr/share/fonts/TTF/DejaVuSans.ttf" }
    if index == 2 { return "/usr/share/fonts/dejavu/DejaVuSans.ttf" }
    if index == 3 { return "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf" }
    if index == 4 { return "/usr/share/fonts/noto/NotoSans-Regular.ttf" }
    if index == 5 { return "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf" }
    if index == 6 { return "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf" }
    if index == 7 { return "/usr/share/fonts/TTF/LiberationSans-Regular.ttf" }
    return "/usr/share/fonts/liberation/LiberationSans-Regular.ttf"
}

fn fontOf(text: *Text) -> *tt.Font {
    unsafe { return @ptrCast(*tt.Font, &text.*.font) }
}

fn atlasOf(text: *Text) -> *tt.Atlas {
    unsafe { return @ptrCast(*tt.Atlas, &text.*.atlas) }
}

fn runOf(text: *Text) -> *tt.Run {
    unsafe { return @ptrCast(*tt.Run, &text.*.run) }
}

// Loads the first font found at `pixel_height`; false without one (text is
// then not drawn).
pub fn loadText(text: *Text, pixel_height: u32, allocator: Allocator) -> bool {
    text.*.loaded = false
    var index: usize = 0
    while index < 9 && !text.*.loaded {
        var path: [128]u8 = undefined
        var length: usize = 0
        for byte in fontPath(index) {
            path[length] = byte
            length += 1
        }
        path[length] = 0
        var status = tt.Status.unreadable
        unsafe { status = tt.loadFile(fontOf(text), @ptrCast([*]const u8, &path), allocator) }
        if status == tt.Status.ok { text.*.loaded = true }
        index += 1
    }
    if !text.*.loaded { return false }
    if !tt.initAtlas(atlasOf(text), fontOf(text), pixel_height, 1024, 1024, allocator) || !tt.initRun(runOf(text), 256, allocator) {
        text.*.loaded = false
        return false
    }
    text.*.ascent = @intCast(i32, pixel_height) * 4 / 5
    return true
}

// The width `string` takes.
pub fn measure(text: *Text, string: []const u8) -> i32 {
    if !text.*.loaded { return 0 }
    tt.layout(atlasOf(text), string, runOf(text))
    return text.*.run.advance
}

// Draws `string` with the top of its line at (x, y) in `color`
// (premultiplied), up to `limit` pixels wide (0: no limit).
pub fn drawText(canvas: *Canvas, text: *Text, string: []const u8, x: i32, y: i32, color: u32, limit: i32) -> void {
    if !text.*.loaded { return }
    const run = runOf(text)
    tt.layout(atlasOf(text), string, run)
    const baseline = y + text.*.ascent
    var row = run.*.top
    while row < run.*.bottom {
        var column = run.*.left
        while column < run.*.right {
            if limit == 0 || column < limit {
                const coverage = tt.runCoverage(atlasOf(text), run, column, row)
                if coverage > 0 { blend(canvas, x + column, baseline + row, color, coverage) }
            }
            column += 1
        }
        row += 1
    }
}
