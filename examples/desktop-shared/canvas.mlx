// Drawing for the dock, the launcher and the settings, in premultiplied
// ARGB (ARGB8888): filled and rounded rectangles with smooth corners,
// images (std.png) at any size, and text (std.truetype) that blends over
// translucent pixels too. On the GPU (gpu_canvas.mlx: the apps' standard)
// or, without Vulkan, on the CPU: the same pixels either way.
const std = @import("std")
const ui = @import("std.ui")
const png = @import("std.png")
const tt = @import("std.truetype")
const gpu_canvas = @import("./gpu_canvas.mlx")

const Allocator = std.allocator.Allocator

// Pixels to draw into, or (with `device`, a *gpu_canvas.Device) commands
// for the GPU to draw the same pixels.
pub const Canvas = struct {
    pixels: [*]u32
    width: usize
    height: usize
    device: usize
    // How much of what is drawn shows (255: all of it; less: it fades in
    // or out, for animations).
    opacity: u32
}

// What is drawn from now on shows `opacity` of itself (255: all).
pub fn setOpacity(canvas: *Canvas, opacity: u32) -> void { canvas.*.opacity = if opacity > 255 { 255 } else { opacity } }

// A premultiplied colour at the canvas's opacity.
fn faded(canvas: *Canvas, color: u32) -> u32 {
    const opacity = canvas.*.opacity
    if opacity >= 255 { return color }
    const alpha = ((color >> 24) * opacity + 127) / 255
    const red = (((color >> 16) & 255) * opacity + 127) / 255
    const green = (((color >> 8) & 255) * opacity + 127) / 255
    const blue = ((color & 255) * opacity + 127) / 255
    return (alpha << 24) | (red << 16) | (green << 8) | blue
}

fn deviceOf(canvas: *Canvas) -> *gpu_canvas.Device {
    unsafe { return @ptrFromInt(*gpu_canvas.Device, canvas.*.device) }
}

// `color` (premultiplied) over `under` at `coverage` (0-255).
pub fn over(under: u32, color: u32, coverage: u32) -> u32 {
    if coverage == 0 { return under }
    var alpha = color >> 24
    var red = (color >> 16) & 255
    var green = (color >> 8) & 255
    var blue = color & 255
    if coverage < 255 {
        alpha = (alpha * coverage + 127) / 255
        red = (red * coverage + 127) / 255
        green = (green * coverage + 127) / 255
        blue = (blue * coverage + 127) / 255
    }
    if alpha == 255 { return (alpha << 24) | (red << 16) | (green << 8) | blue }
    const keep = 255 - alpha
    const a = alpha + ((under >> 24) * keep + 127) / 255
    const r = red + (((under >> 16) & 255) * keep + 127) / 255
    const g = green + (((under >> 8) & 255) * keep + 127) / 255
    const b = blue + ((under & 255) * keep + 127) / 255
    return (minimum(a, 255) << 24) | (minimum(r, 255) << 16) | (minimum(g, 255) << 8) | minimum(b, 255)
}

fn minimum(value: u32, limit: u32) -> u32 { return if value > limit { limit } else { value } }

// A straight-alpha colour premultiplied: 0xAARRGGBB with alpha applied.
pub fn premultiplied(color: u32) -> u32 {
    const alpha = color >> 24
    if alpha == 255 { return color }
    return (alpha << 24) | ((((color >> 16) & 255) * alpha + 127) / 255 << 16) | ((((color >> 8) & 255) * alpha + 127) / 255 << 8) | ((color & 255) * alpha + 127) / 255
}

// A colour from straight alpha, red, green and blue (0-255), premultiplied.
pub fn color(alpha: u32, red: u32, green: u32, blue: u32) -> u32 {
    return premultiplied((alpha << 24) | (red << 16) | (green << 8) | blue)
}

pub fn clear(canvas: *Canvas, color: u32) -> void {
    if canvas.*.device != 0 {
        gpu_canvas.clear(deviceOf(canvas), color)
        return
    }
    var index: usize = 0
    while index < canvas.*.width * canvas.*.height {
        canvas.*.pixels[index] = color
        index += 1
    }
}

fn blend(canvas: *Canvas, x: i32, y: i32, color: u32, coverage: u32) -> void {
    if x < 0 || y < 0 || x >= @intCast(i32, canvas.*.width) || y >= @intCast(i32, canvas.*.height) { return }
    const at = @intCast(usize, y) * canvas.*.width + @intCast(usize, x)
    canvas.*.pixels[at] = over(canvas.*.pixels[at], color, coverage)
}

pub fn fillRect(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, given: u32) -> void {
    const color = faded(canvas, given)
    if canvas.*.device != 0 {
        gpu_canvas.fill(deviceOf(canvas), x, y, width, height, 0, color)
        return
    }
    var row = y
    while row < y + height {
        var column = x
        while column < x + width {
            blend(canvas, column, row, color, 255)
            column += 1
        }
        row += 1
    }
}

pub fn fillRoundedRect(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, radius: i32, given: u32) -> void {
    const color = faded(canvas, given)
    if canvas.*.device != 0 {
        gpu_canvas.fill(deviceOf(canvas), x, y, width, height, radius, color)
        return
    }
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            blend(canvas, x + column, y + row, color, ui.roundedCoverage(column, row, width, height, radius))
            column += 1
        }
        row += 1
    }
}

// The outline of a rounded rectangle, `thickness` wide, inside it.
pub fn strokeRoundedRect(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, radius: i32, thickness: i32, given: u32) -> void {
    const color = faded(canvas, given)
    if canvas.*.device != 0 {
        gpu_canvas.stroke(deviceOf(canvas), x, y, width, height, radius, thickness, color)
        return
    }
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            const outer = ui.roundedCoverage(column, row, width, height, radius)
            const inner = ui.roundedCoverage(column - thickness, row - thickness, width - thickness * 2, height - thickness * 2, if radius > thickness { radius - thickness } else { 0 })
            if outer > inner { blend(canvas, x + column, y + row, color, outer - inner) }
            column += 1
        }
        row += 1
    }
}

// Draws `image` at (x, y) resized to `size` x `size` (bilinear), faded by
// `opacity` (255: as it is).
pub fn drawImage(canvas: *Canvas, image: *const png.Image, x: i32, y: i32, size: i32, given: u32) -> void {
    const opacity = given * (if canvas.*.opacity > 255 { 255 } else { canvas.*.opacity }) / 255
    if size <= 0 || image.*.width == 0 { return }
    if canvas.*.device != 0 {
        gpu_canvas.image(deviceOf(canvas), image, x, y, size, opacity)
        return
    }
    drawImageRect(canvas, image, x, y, size, size, given)
}

// An image scaled to `width` x `height` (on the CPU; on the GPU as a square
// of the larger side).
pub fn drawImageRect(canvas: *Canvas, image: *const png.Image, x: i32, y: i32, width: i32, height: i32, given: u32) -> void {
    const opacity = given * (if canvas.*.opacity > 255 { 255 } else { canvas.*.opacity }) / 255
    if width <= 0 || height <= 0 || image.*.width == 0 { return }
    if canvas.*.device != 0 {
        gpu_canvas.image(deviceOf(canvas), image, x, y, if width > height { width } else { height }, opacity)
        return
    }
    const source_width = @intCast(i32, image.*.width)
    const source_height = @intCast(i32, image.*.height)
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            // Sample position in 1/256 source pixels.
            const sx = ((column * 2 + 1) * source_width * 128) / width - 128
            const sy = ((row * 2 + 1) * source_height * 128) / height - 128
            const pixel = sample(image, sx, sy)
            blend(canvas, x + column, y + row, pixel, opacity)
            column += 1
        }
        row += 1
    }
}

fn clampTo(value: i32, limit: i32) -> i32 {
    if value < 0 { return 0 }
    if value >= limit { return limit - 1 }
    return value
}

fn sample(image: *const png.Image, sx: i32, sy: i32) -> u32 {
    const width = @intCast(i32, image.*.width)
    const height = @intCast(i32, image.*.height)
    const x0 = clampTo(if sx < 0 { 0 } else { sx / 256 }, width)
    const y0 = clampTo(if sy < 0 { 0 } else { sy / 256 }, height)
    const x1 = clampTo(x0 + 1, width)
    const y1 = clampTo(y0 + 1, height)
    const fx = @intCast(u32, if sx < 0 { 0 } else { sx % 256 })
    const fy = @intCast(u32, if sy < 0 { 0 } else { sy % 256 })
    const a = image.*.pixels[@intCast(usize, y0 * width + x0)]
    const b = image.*.pixels[@intCast(usize, y0 * width + x1)]
    const c = image.*.pixels[@intCast(usize, y1 * width + x0)]
    const d = image.*.pixels[@intCast(usize, y1 * width + x1)]
    var result: u32 = 0
    var shift: u32 = 0
    while shift < 32 {
        const top = ((a >> shift) & 255) * (256 - fx) + ((b >> shift) & 255) * fx
        const bottom = ((c >> shift) & 255) * (256 - fx) + ((d >> shift) & 255) * fx
        const value = (top * (256 - fy) + bottom * fy) / 65536
        result = result | (minimum(value, 255) << shift)
        shift += 8
    }
    return result
}

// ---------------------------------------------------------------------------
// Text

pub const Text = struct {
    font: tt.Font
    atlas: tt.Atlas
    run: tt.Run
    loaded: bool
    // Pixels above and below the baseline of a line.
    ascent: i32
}

fn fontPath(index: usize) -> []const u8 {
    if index == 0 { return "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" }
    if index == 1 { return "/usr/share/fonts/TTF/DejaVuSans.ttf" }
    if index == 2 { return "/usr/share/fonts/dejavu/DejaVuSans.ttf" }
    if index == 3 { return "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf" }
    if index == 4 { return "/usr/share/fonts/noto/NotoSans-Regular.ttf" }
    if index == 5 { return "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf" }
    if index == 6 { return "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf" }
    if index == 7 { return "/usr/share/fonts/TTF/LiberationSans-Regular.ttf" }
    return "/usr/share/fonts/liberation/LiberationSans-Regular.ttf"
}

fn fontOf(text: *Text) -> *tt.Font {
    unsafe { return @ptrCast(*tt.Font, &text.*.font) }
}

fn atlasOf(text: *Text) -> *tt.Atlas {
    unsafe { return @ptrCast(*tt.Atlas, &text.*.atlas) }
}

fn runOf(text: *Text) -> *tt.Run {
    unsafe { return @ptrCast(*tt.Run, &text.*.run) }
}

fn monoPath(index: usize) -> []const u8 {
    if index == 0 { return "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf" }
    if index == 1 { return "/usr/share/fonts/TTF/DejaVuSansMono.ttf" }
    if index == 2 { return "/usr/share/fonts/dejavu/DejaVuSansMono.ttf" }
    if index == 3 { return "/usr/share/fonts/dejavu-sans-mono-fonts/DejaVuSansMono.ttf" }
    if index == 4 { return "/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf" }
    if index == 5 { return "/usr/share/fonts/TTF/LiberationMono-Regular.ttf" }
    if index == 6 { return "/usr/share/fonts/noto/NotoSansMono-Regular.ttf" }
    if index == 7 { return "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf" }
    return "/usr/share/fonts/liberation/LiberationMono-Regular.ttf"
}

// Loads the first font found at `pixel_height`; false without one (text is
// then not drawn).
pub fn loadText(text: *Text, pixel_height: u32, allocator: Allocator) -> bool {
    return loadFrom(text, pixel_height, allocator, false)
}

// The same with a monospaced font (for code; a proportional one when there
// is none).
pub fn loadMonoText(text: *Text, pixel_height: u32, allocator: Allocator) -> bool {
    return loadFrom(text, pixel_height, allocator, true) || loadFrom(text, pixel_height, allocator, false)
}

fn loadFrom(text: *Text, pixel_height: u32, allocator: Allocator, mono: bool) -> bool {
    text.*.loaded = false
    var index: usize = 0
    while index < 9 && !text.*.loaded {
        var path: [128]u8 = undefined
        var length: usize = 0
        const source = if mono { monoPath(index) } else { fontPath(index) }
        for byte in source {
            path[length] = byte
            length += 1
        }
        path[length] = 0
        var status = tt.Status.unreadable
        unsafe { status = tt.loadFile(fontOf(text), @ptrCast([*]const u8, &path), allocator) }
        if status == tt.Status.ok { text.*.loaded = true }
        index += 1
    }
    if !text.*.loaded { return false }
    if !tt.initAtlas(atlasOf(text), fontOf(text), pixel_height, 1024, 1024, allocator) || !tt.initRun(runOf(text), 256, allocator) {
        text.*.loaded = false
        return false
    }
    text.*.ascent = @intCast(i32, pixel_height) * 4 / 5
    return true
}

// The width `string` takes.
pub fn measure(text: *Text, string: []const u8) -> i32 {
    if !text.*.loaded { return 0 }
    tt.layout(atlasOf(text), string, runOf(text))
    return text.*.run.advance
}

// Draws `string` with the top of its line at (x, y) in `color`
// (premultiplied), up to `limit` pixels wide (0: no limit).
pub fn drawText(canvas: *Canvas, text: *Text, string: []const u8, x: i32, y: i32, given: u32, limit: i32) -> void {
    if !text.*.loaded { return }
    const color = faded(canvas, given)
    const run = runOf(text)
    tt.layout(atlasOf(text), string, run)
    const baseline = y + text.*.ascent
    if canvas.*.device != 0 {
        gpu_canvas.glyphs(deviceOf(canvas), atlasOf(text), run, x, baseline, color, limit)
        return
    }
    var row = run.*.top
    while row < run.*.bottom {
        var column = run.*.left
        while column < run.*.right {
            if limit == 0 || column < limit {
                const coverage = tt.runCoverage(atlasOf(text), run, column, row)
                if coverage > 0 { blend(canvas, x + column, baseline + row, color, coverage) }
            }
            column += 1
        }
        row += 1
    }
}

// A chevron `size` tall, its strokes `thickness` wide, pointing left or
// right (back and forward buttons, list arrows).
pub fn drawChevron(canvas: *Canvas, x: i32, y: i32, left: bool, color: u32, size: i32, thickness: i32) -> void {
    const half = size / 2
    var row: i32 = 0
    while row < size {
        const offset = if row < half { half - row } else { row - half }
        const column = if left { x + offset } else { x + half - offset }
        fillRect(canvas, column, y + row, thickness, 1, color)
        row += 1
    }
}

// The magnifier of a search field.
// A magnifier: a ring and its handle.
pub fn drawSearchGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    strokeRoundedRect(canvas, x, y, 11, 11, 5, 2, color)
    var step: i32 = 0
    while step < 5 {
        fillRect(canvas, x + 9 + step, y + 9 + step, 2, 2, color)
        step += 1
    }
}
