// Folders and the trash for the dock: a folder's newest entries, opening a
// path or a URI with the desktop's handler (xdg-open), and the freedesktop
// trash ($XDG_DATA_HOME/Trash, ~/.local/share/Trash): whether it holds
// anything, emptying it, and moving files into it (gio trash).
const std = @import("std")
const apps_module = @import("./apps.mlx")

const Path = apps_module.Path

const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_getdents64: usize = 217
const O_DIRECTORY: usize = 65536
const O_CLOEXEC: usize = 524288

// Up to STACK entries of a folder, newest first.
pub const STACK: usize = 12
const NAME: usize = 128

pub const Entries = struct {
    names: [1536]u8
    lengths: [12]usize
    times: [12]isize
    count: usize
}

pub fn nameAt(entries: *const Entries, index: usize) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(entries) + @offsetOf(Entries, "names") + index * NAME) }
    return bytes[0..entries.*.lengths[index]]
}

fn none() -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

// `text` with "~/" at its start standing for $HOME, into `into`; false
// when it needs a home and there is none.
pub fn expand(environment: [*][*]const u8, text: []const u8, into: *Path) -> bool {
    apps_module.pathClear(into)
    if text.length > 0 && text[0] == 126 {
        const home = apps_module.environmentValue(environment, "HOME")
        if @intFromPtr(home) == 0 { return false }
        apps_module.pathAddC(into, home)
        apps_module.pathAdd(into, text[1..text.length])
        return true
    }
    apps_module.pathAdd(into, text)
    return true
}

// The last part of a path ("Downloads" for "~/Downloads").
pub fn baseName(text: []const u8) -> []const u8 {
    var end = text.length
    while end > 1 && text[end - 1] == 47 { end -= 1 }
    var start = end
    while start > 0 && text[start - 1] != 47 { start -= 1 }
    return text[start..end]
}

pub fn isDirectory(path: [*]const u8) -> bool {
    var status: std.fs.Stat = undefined
    if std.fs.status(path, &status) != 0 { return false }
    return status.mode & 61440 == 16384
}

fn hexValue(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(u32, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(u32, byte - 55) }
    return 16
}

// The path of the file:// URI on line `line` of a text/uri-list (%XX
// decoded) into `into`; false past the last or for another kind of URI.
pub fn uriPath(list: []const u8, line: usize, into: *Path) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index < line {
        while start < list.length && list[start] != 10 { start += 1 }
        if start >= list.length { return false }
        start += 1
        index += 1
    }
    var end = start
    while end < list.length && list[end] != 13 && list[end] != 10 { end += 1 }
    if end - start < 8 { return false }
    const uri = list[start..end]
    if !apps_module.sameText(uri[0..7], "file://") { return false }
    var at: usize = 7
    // file://host/path: the host (usually none or localhost) is skipped.
    while at < uri.length && uri[at] != 47 { at += 1 }
    apps_module.pathClear(into)
    while at < uri.length && into.*.length < 1020 {
        if uri[at] == 37 && at + 2 < uri.length && hexValue(uri[at + 1]) < 16 && hexValue(uri[at + 2]) < 16 {
            into.*.bytes[into.*.length] = @intCast(u8, hexValue(uri[at + 1]) * 16 + hexValue(uri[at + 2]))
            at += 3
        } else {
            into.*.bytes[into.*.length] = uri[at]
            at += 1
        }
        into.*.length += 1
    }
    return into.*.length > 0
}

// Appends `text` in single quotes for /bin/sh.
fn addQuoted(line: *Path, text: []const u8) -> void {
    apps_module.pathAdd(line, "'")
    for byte in text {
        if byte == 39 { apps_module.pathAdd(line, "'\\''") }
        if byte != 39 && line.*.length < 1020 {
            line.*.bytes[line.*.length] = byte
            line.*.length += 1
        }
    }
    apps_module.pathAdd(line, "'")
}

// Opens a path or a URI with the desktop's handler; a folder in the Mlx
// file manager when it is installed (as the Finder on macOS), else with
// xdg-open too.
pub fn open(target: []const u8, environment: [*][*]const u8) -> void {
    var line: Path = undefined
    apps_module.pathClear(&line)
    var path: Path = undefined
    apps_module.pathClear(&path)
    apps_module.pathAdd(&path, target)
    if isDirectory(apps_module.pathEnd(&path)) {
        apps_module.pathAdd(&line, "command -v mlx-files > /dev/null && exec mlx-files ")
        addQuoted(&line, target)
        apps_module.pathAdd(&line, "; exec xdg-open ")
        addQuoted(&line, target)
        apps_module.runScript(line.bytes[0..line.length], environment)
        return
    }
    apps_module.pathAdd(&line, "xdg-open ")
    addQuoted(&line, target)
    apps_module.run(line.bytes[0..line.length], none(), environment)
}

// Opens the trash in the file manager: mlx-files when it is installed,
// else asked over D-Bus (org.freedesktop.FileManager1, which Nautilus,
// Dolphin, Nemo and others offer), else its directory with xdg-open.
// (xdg-open trash:/// would go to whatever takes unknown URIs, often the
// browser.)
pub fn openTrash(environment: [*][*]const u8) -> void {
    var line: Path = undefined
    apps_module.pathClear(&line)
    apps_module.pathAdd(&line, "command -v mlx-files > /dev/null && exec mlx-files trash:///; gdbus call --session --dest org.freedesktop.FileManager1 --object-path /org/freedesktop/FileManager1 --method org.freedesktop.FileManager1.ShowFolders \"['trash:///']\" '' > /dev/null 2>&1 || exec xdg-open ")
    var path: Path = undefined
    if !trashPath(environment, &path) { return }
    apps_module.pathAdd(&path, "/files")
    addQuoted(&line, path.bytes[0..path.length])
    apps_module.runScript(line.bytes[0..line.length], environment)
}

// The trash directory into `into`; false without a home.
pub fn trashPath(environment: [*][*]const u8, into: *Path) -> bool {
    apps_module.pathClear(into)
    const data = apps_module.environmentValue(environment, "XDG_DATA_HOME")
    if @intFromPtr(data) != 0 && data[0] != 0 {
        apps_module.pathAddC(into, data)
    } else {
        const home = apps_module.environmentValue(environment, "HOME")
        if @intFromPtr(home) == 0 { return false }
        apps_module.pathAddC(into, home)
        apps_module.pathAdd(into, "/.local/share")
    }
    apps_module.pathAdd(into, "/Trash")
    return true
}

// Whether a directory has an entry besides . and .. (false when it cannot
// be read).
fn firstEntry(path: [*]const u8) -> bool {
    const handle = std.linux.syscall3(SYS_open, @intFromPtr(path), O_DIRECTORY | O_CLOEXEC, 0)
    if handle < 0 { return false }
    var buffer: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var found = false
    const count = std.linux.syscall3(SYS_getdents64, @bitCast(usize, handle), @intFromPtr(bytes), 4096)
    var offset: usize = 0
    while count > 0 && offset < @bitCast(usize, count) && !found {
        const record_length = @intCast(usize, bytes[offset + 16]) | (@intCast(usize, bytes[offset + 17]) << 8)
        const first = bytes[offset + 19]
        const second = bytes[offset + 20]
        const third = bytes[offset + 21]
        const dot = first == 46 && (second == 0 || (second == 46 && third == 0))
        if !dot { found = true }
        if record_length == 0 { break }
        offset += record_length
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, handle))
    return found
}

// Whether the trash holds anything.
pub fn trashFull(environment: [*][*]const u8) -> bool {
    var path: Path = undefined
    if !trashPath(environment, &path) { return false }
    apps_module.pathAdd(&path, "/files")
    return firstEntry(apps_module.pathEnd(&path))
}

// Deletes everything in the trash (its files and what it knows of them);
// its own directories stay.
pub fn emptyTrash(environment: [*][*]const u8) -> void {
    var trash: Path = undefined
    if !trashPath(environment, &trash) { return }
    var line: Path = undefined
    apps_module.pathClear(&line)
    apps_module.pathAdd(&line, "find ")
    var path: Path = undefined
    apps_module.pathClear(&path)
    apps_module.pathAdd(&path, trash.bytes[0..trash.length])
    apps_module.pathAdd(&path, "/files")
    addQuoted(&line, path.bytes[0..path.length])
    apps_module.pathAdd(&line, " ")
    apps_module.pathClear(&path)
    apps_module.pathAdd(&path, trash.bytes[0..trash.length])
    apps_module.pathAdd(&path, "/info")
    addQuoted(&line, path.bytes[0..path.length])
    apps_module.pathAdd(&line, " -mindepth 1 -delete")
    apps_module.run(line.bytes[0..line.length], none(), environment)
}

// Whether `path` is an app's desktop entry (".../applications/NAME.desktop"):
// an app dragged from the launcher, which the trash does not take.
fn isAppEntry(path: []const u8) -> bool {
    if path.length < 8 || !apps_module.sameText(path[path.length - 8..path.length], ".desktop") { return false }
    return apps_module.containsText(path, "/applications/")
}

// Moves the files a text/uri-list names into the trash (not apps' desktop
// entries); how many.
pub fn moveToTrash(list: []const u8, environment: [*][*]const u8) -> usize {
    var line: Path = undefined
    apps_module.pathClear(&line)
    apps_module.pathAdd(&line, "gio trash --")
    var count: usize = 0
    var path: Path = undefined
    var index: usize = 0
    while uriPath(list, index, &path) {
        if !isAppEntry(path.bytes[0..path.length]) {
            apps_module.pathAdd(&line, " ")
            addQuoted(&line, path.bytes[0..path.length])
            count += 1
        }
        index += 1
    }
    if count > 0 { apps_module.run(line.bytes[0..line.length], none(), environment) }
    return count
}

// The newest entries of the directory `path` (hidden ones left out).
pub fn newest(path: [*]const u8, entries: *Entries) -> void {
    entries.*.count = 0
    const handle = std.linux.syscall3(SYS_open, @intFromPtr(path), O_DIRECTORY | O_CLOEXEC, 0)
    if handle < 0 { return }
    var buffer: [8192]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    while true {
        const count = std.linux.syscall3(SYS_getdents64, @bitCast(usize, handle), @intFromPtr(bytes), 8192)
        if count <= 0 { break }
        var offset: usize = 0
        while offset < @bitCast(usize, count) {
            const record_length = @intCast(usize, bytes[offset + 16]) | (@intCast(usize, bytes[offset + 17]) << 8)
            var name: [*]const u8 = undefined
            unsafe { name = @ptrFromInt([*]const u8, @intFromPtr(bytes) + offset + 19) }
            var length: usize = 0
            while name[length] != 0 { length += 1 }
            if length > 0 && name[0] != 46 && length <= NAME {
                // Its time, then into the list (newest first) if it is
                // among the newest.
                var status: std.fs.Stat = undefined
                var time: isize = 0
                if std.fs.statusFrom(std.fs.File.{ .descriptor = handle }, name, &status, false) == 0 { time = status.modifiedSeconds }
                var slot = entries.*.count
                while slot > 0 && entries.*.times[slot - 1] < time { slot -= 1 }
                if slot < STACK {
                    var last = if entries.*.count < STACK { entries.*.count } else { STACK - 1 }
                    while last > slot {
                        var byte: usize = 0
                        while byte < NAME {
                            entries.*.names[last * NAME + byte] = entries.*.names[(last - 1) * NAME + byte]
                            byte += 1
                        }
                        entries.*.lengths[last] = entries.*.lengths[last - 1]
                        entries.*.times[last] = entries.*.times[last - 1]
                        last -= 1
                    }
                    var byte: usize = 0
                    while byte < length {
                        entries.*.names[slot * NAME + byte] = name[byte]
                        byte += 1
                    }
                    entries.*.lengths[slot] = length
                    entries.*.times[slot] = time
                    if entries.*.count < STACK { entries.*.count += 1 }
                }
            }
            if record_length == 0 { break }
            offset += record_length
        }
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, handle))
}

// ---------------------------------------------------------------------------
// A folder's contents for the dock's stack view: up to LIST entries
// (hidden ones left out), newest first, and which are folders.

pub const LIST: usize = 256

pub const Listing = struct {
    names: [32768]u8
    lengths: [256]usize
    times: [256]isize
    directories: [256]bool
    // Slots newest first.
    order: [256]usize
    count: usize
}

// Entry `index` (newest first).
pub fn listedName(listing: *const Listing, index: usize) -> []const u8 {
    const slot = listing.*.order[index]
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(listing) + @offsetOf(Listing, "names") + slot * NAME) }
    return bytes[0..listing.*.lengths[slot]]
}

pub fn listedDirectory(listing: *const Listing, index: usize) -> bool { return listing.*.directories[listing.*.order[index]] }

pub fn list(path: [*]const u8, listing: *Listing) -> void {
    listing.*.count = 0
    const handle = std.linux.syscall3(SYS_open, @intFromPtr(path), O_DIRECTORY | O_CLOEXEC, 0)
    if handle < 0 { return }
    var buffer: [8192]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    while listing.*.count < LIST {
        const count = std.linux.syscall3(SYS_getdents64, @bitCast(usize, handle), @intFromPtr(bytes), 8192)
        if count <= 0 { break }
        var offset: usize = 0
        while offset < @bitCast(usize, count) && listing.*.count < LIST {
            const record_length = @intCast(usize, bytes[offset + 16]) | (@intCast(usize, bytes[offset + 17]) << 8)
            var name: [*]const u8 = undefined
            unsafe { name = @ptrFromInt([*]const u8, @intFromPtr(bytes) + offset + 19) }
            var length: usize = 0
            while name[length] != 0 { length += 1 }
            if length > 0 && name[0] != 46 && length <= NAME {
                const slot = listing.*.count
                var status: std.fs.Stat = undefined
                listing.*.times[slot] = 0
                listing.*.directories[slot] = false
                if std.fs.statusFrom(std.fs.File.{ .descriptor = handle }, name, &status, false) == 0 {
                    listing.*.times[slot] = status.modifiedSeconds
                    listing.*.directories[slot] = status.mode & 61440 == 16384
                }
                var byte: usize = 0
                while byte < length {
                    listing.*.names[slot * NAME + byte] = name[byte]
                    byte += 1
                }
                listing.*.lengths[slot] = length
                // Into the order, newest first.
                var at = slot
                while at > 0 && listing.*.times[listing.*.order[at - 1]] < listing.*.times[slot] {
                    listing.*.order[at] = listing.*.order[at - 1]
                    at -= 1
                }
                listing.*.order[at] = slot
                listing.*.count += 1
            }
            if record_length == 0 { break }
            offset += record_length
        }
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, handle))
}
