// Icons of files, folders and the trash, drawn with shapes (the dock's
// stacks, the file manager): a page with a coloured band naming its type,
// a blue folder with its name's first letter (an arrow for Downloads), a
// bin with paper in it when it holds something; and a name shortened with
// an ellipsis to fit.
const apps_module = @import("./apps.mlx")
const canvas_module = @import("./canvas.mlx")
const places = @import("./places.mlx")

const Canvas = canvas_module.Canvas
const Text = canvas_module.Text

pub fn endsWith(name: []const u8, suffix: []const u8) -> bool {
    return name.length >= suffix.length && apps_module.sameText(name[name.length - suffix.length..name.length], suffix)
}

// A file: a page with its folded corner and its type (the extension).
pub fn drawFile(text: *Text, canvas: *Canvas, name: []const u8, x: i32, y: i32, size: i32) -> void {
    const left = x + size * 18 / 100
    const width = size * 64 / 100
    const top = y + size * 6 / 100
    const height = size * 86 / 100
    const fold = size * 18 / 100
    const page = canvas_module.color(255, 238, 240, 245)
    canvas_module.fillRoundedRect(canvas, left, top + fold, width, height - fold, size / 16, page)
    canvas_module.fillRect(canvas, left, top + size / 16, width - fold, fold, page)
    var row: i32 = 0
    while row < fold {
        canvas_module.fillRect(canvas, left + width - fold, top + row, row + 1, 1, canvas_module.color(255, 190, 195, 206))
        canvas_module.fillRect(canvas, left + width - fold + row + 1, top + row, fold - row - 1, 1, canvas_module.color(0, 0, 0, 0))
        row += 1
    }
    // The extension on a coloured band.
    var dot = name.length
    while dot > 0 && name[dot - 1] != 46 { dot -= 1 }
    if dot == 0 || name.length - dot > 4 || name.length == dot { return }
    var label: [4]u8 = undefined
    var length: usize = 0
    while dot + length < name.length {
        var byte = name[dot + length]
        if byte >= 97 && byte <= 122 { byte -= 32 }
        label[length] = byte
        length += 1
    }
    const kind = label[0..length]
    var band = canvas_module.color(255, 110, 120, 140)
    if apps_module.sameText(kind, "PDF") { band = canvas_module.color(255, 220, 60, 60) }
    if apps_module.sameText(kind, "PNG") || apps_module.sameText(kind, "JPG") || apps_module.sameText(kind, "JPEG") || apps_module.sameText(kind, "GIF") || apps_module.sameText(kind, "WEBP") || apps_module.sameText(kind, "SVG") { band = canvas_module.color(255, 60, 170, 110) }
    if apps_module.sameText(kind, "ZIP") || apps_module.sameText(kind, "GZ") || apps_module.sameText(kind, "XZ") || apps_module.sameText(kind, "ZST") || apps_module.sameText(kind, "TAR") || apps_module.sameText(kind, "7Z") { band = canvas_module.color(255, 230, 150, 40) }
    if apps_module.sameText(kind, "MP3") || apps_module.sameText(kind, "FLAC") || apps_module.sameText(kind, "OGG") || apps_module.sameText(kind, "WAV") { band = canvas_module.color(255, 150, 90, 220) }
    if apps_module.sameText(kind, "MP4") || apps_module.sameText(kind, "MKV") || apps_module.sameText(kind, "WEBM") || apps_module.sameText(kind, "MOV") { band = canvas_module.color(255, 225, 80, 150) }
    const band_top = top + height * 55 / 100
    canvas_module.fillRoundedRect(canvas, left + 3, band_top, width - 6, size * 22 / 100, size / 20, band)
    // Too small for the letters.
    if size < 32 { return }
    const text_width = canvas_module.measure(text, kind)
    canvas_module.drawText(canvas, text, kind, left + (width - text_width) / 2, band_top + (size * 22 / 100 - 15) / 2, canvas_module.color(255, 255, 255, 255), 0)
}

// `name`, or as much of it as fits in `limit` pixels and an ellipsis.
pub fn fitText(text: *Text, name: []const u8, limit: i32, buffer: [*]u8) -> []const u8 {
    if canvas_module.measure(text, name) <= limit { return name }
    var length = if name.length > 96 { 96 } else { name.length }
    while length > 0 {
        length -= 1
        if length == 0 || name[length] < 128 || name[length] >= 192 {
            var index: usize = 0
            while index < length {
                buffer[index] = name[index]
                index += 1
            }
            buffer[length] = 226
            buffer[length + 1] = 128
            buffer[length + 2] = 166
            if canvas_module.measure(text, buffer[0..length + 3]) <= limit { return buffer[0..length + 3] }
        }
    }
    return buffer[0..0]
}

// A folder: a blue folder, with an arrow for Downloads and the name's
// first letter for others.
pub fn drawFolder(text: *Text, canvas: *Canvas, path: []const u8, x: i32, y: i32, size: i32) -> void {
    const back = canvas_module.color(255, 52, 120, 210)
    const front = canvas_module.color(255, 92, 160, 240)
    const left = x + size * 6 / 100
    const width = size * 88 / 100
    canvas_module.fillRoundedRect(canvas, left, y + size * 14 / 100, width * 40 / 100, size * 16 / 100, size / 16, back)
    canvas_module.fillRoundedRect(canvas, left, y + size * 20 / 100, width, size * 64 / 100, size / 12, back)
    canvas_module.fillRoundedRect(canvas, left, y + size * 30 / 100, width, size * 56 / 100, size / 12, front)
    const white = canvas_module.color(235, 255, 255, 255)
    const name = places.baseName(path)
    const middle = x + size / 2
    const top = y + size * 40 / 100
    if apps_module.sameText(name, "Downloads") {
        // An arrow pointing down.
        const stem = size / 12
        canvas_module.fillRect(canvas, middle - stem / 2, top, stem, size * 20 / 100, white)
        var row: i32 = 0
        const head = size * 14 / 100
        while row < head {
            const half = head - row
            canvas_module.fillRect(canvas, middle - half, top + size * 20 / 100 + row, half * 2, 1, white)
            row += 1
        }
        return
    }
    if name.length == 0 || size < 32 { return }
    var letter: [1]u8 = [1]u8{ name[0] }
    if letter[0] >= 97 && letter[0] <= 122 { letter[0] -= 32 }
    const letter_width = canvas_module.measure(text, letter[0..1])
    canvas_module.drawText(canvas, text, letter[0..1], middle - letter_width / 2, top + size * 6 / 100, white, 0)
}

// The trash: a bin, with paper in it when it holds something; lit while
// something is dragged over it.
pub fn drawTrash(canvas: *Canvas, x: i32, y: i32, size: i32, full: bool, lit: bool) -> void {
    if lit { canvas_module.fillRoundedRect(canvas, x, y, size, size, size / 5, canvas_module.color(90, 90, 160, 255)) }
    const body = canvas_module.color(255, 205, 210, 220)
    const groove = canvas_module.color(255, 150, 156, 170)
    const left = x + size * 24 / 100
    const width = size * 52 / 100
    const top = y + size * 30 / 100
    const height = size * 60 / 100
    if full {
        // Paper above the rim.
        canvas_module.fillRoundedRect(canvas, left + width * 8 / 100, top - size * 14 / 100, width * 46 / 100, size * 22 / 100, size / 20, canvas_module.color(255, 250, 250, 252))
        canvas_module.fillRoundedRect(canvas, left + width * 44 / 100, top - size * 10 / 100, width * 48 / 100, size * 20 / 100, size / 20, canvas_module.color(255, 236, 238, 244))
    }
    canvas_module.fillRoundedRect(canvas, left, top, width, height, size / 12, body)
    var groove_x = left + width / 4
    while groove_x < left + width * 3 / 4 + 1 {
        canvas_module.fillRect(canvas, groove_x - 1, top + height / 6, 2, height * 2 / 3, groove)
        groove_x += width / 4
    }
    if !full {
        // The lid and its handle.
        canvas_module.fillRoundedRect(canvas, x + size * 18 / 100, top - size * 9 / 100, size * 64 / 100, size * 7 / 100, size / 30, body)
        canvas_module.fillRoundedRect(canvas, x + size * 42 / 100, top - size * 14 / 100, size * 16 / 100, size * 6 / 100, size / 40, body)
    }
}
