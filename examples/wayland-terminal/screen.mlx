// The terminal screen: a character grid fed by the shell's output, and its
// rendering into an ARGB8888 buffer.
//
// The byte stream is interpreted as ASCII with the controls a dumb terminal
// needs (CR, LF, BS, HT, BEL) plus a small ECMA-48 subset: cursor movement
// (CSI A B C D H f G d), erase (CSI J, CSI K), delete/insert characters
// (CSI P, CSI @). Other escape sequences, including SGR attributes, are
// parsed and ignored so they never show up as garbage.

const font = @import("./font.mlx")

// The size a new terminal starts with, and the range it can be resized in.
pub const COLUMNS: usize = 80
pub const ROWS: usize = 24
pub const MIN_COLUMNS: usize = 10
pub const MIN_ROWS: usize = 2
pub const MAX_COLUMNS: usize = 256
pub const MAX_ROWS: usize = 96
pub const CELL_WIDTH: usize = 8
pub const CELL_HEIGHT: usize = 16
pub const PADDING: usize = 6
// The largest image: MAX_COLUMNS x MAX_ROWS cells.
pub const MAX_PIXEL_WIDTH: usize = 2060
pub const MAX_PIXEL_HEIGHT: usize = 1548

const PARSE_TEXT: u8 = 0
const PARSE_ESCAPE: u8 = 1
const PARSE_CSI: u8 = 2
const PARSE_STRING: u8 = 3

const BACKGROUND: u32 = 4280163870
const FOREGROUND: u32 = 4291875024
const CURSOR: u32 = 4287152255

pub const Screen = struct {
    // columns x rows cells, row by row; `scratch` is room for resizing.
    cells: [24576]u8
    scratch: [24576]u8
    columns: usize
    rows: usize
    row: usize
    column: usize
    state: u8
    parameters: [8]usize
    parameterCount: usize
    focused: bool
}

pub fn initAt(screen: *Screen) -> void {
    screen.*.columns = COLUMNS
    screen.*.rows = ROWS
    var index: usize = 0
    while index < COLUMNS * ROWS {
        screen.*.cells[index] = 32
        index += 1
    }
    screen.*.row = 0
    screen.*.column = 0
    screen.*.state = PARSE_TEXT
    screen.*.parameterCount = 0
    screen.*.focused = false
}

fn clearRange(screen: *Screen, start: usize, end: usize) -> void {
    var index = start
    while index < end && index < screen.*.columns * screen.*.rows {
        screen.*.cells[index] = 32
        index += 1
    }
}

fn scrollUp(screen: *Screen) -> void {
    var index: usize = 0
    while index < screen.*.columns * (screen.*.rows - 1) {
        screen.*.cells[index] = screen.*.cells[index + screen.*.columns]
        index += 1
    }
    clearRange(screen, screen.*.columns * (screen.*.rows - 1), screen.*.columns * screen.*.rows)
}

fn lineFeed(screen: *Screen) -> void {
    if screen.*.row + 1 >= screen.*.rows {
        scrollUp(screen)
    } else {
        screen.*.row += 1
    }
}

fn put(screen: *Screen, byte: u8) -> void {
    if screen.*.column >= screen.*.columns {
        screen.*.column = 0
        lineFeed(screen)
    }
    screen.*.cells[screen.*.row * screen.*.columns + screen.*.column] = byte
    screen.*.column += 1
}

fn parameter(screen: *const Screen, index: usize, fallback: usize) -> usize {
    if index >= screen.*.parameterCount || screen.*.parameters[index] == 0 { return fallback }
    return screen.*.parameters[index]
}

fn clampRow(screen: *const Screen, value: usize) -> usize { return if value >= screen.*.rows { screen.*.rows - 1 } else { value } }
fn clampColumn(screen: *const Screen, value: usize) -> usize { return if value >= screen.*.columns { screen.*.columns - 1 } else { value } }

fn finishCsi(screen: *Screen, final: u8) -> void {
    const count = parameter(screen, 0, 1)
    const here = screen.*.row * screen.*.columns + screen.*.column
    if final == 65 {
        screen.*.row = if count > screen.*.row { 0 } else { screen.*.row - count }
    } else if final == 66 {
        screen.*.row = clampRow(screen, screen.*.row + count)
    } else if final == 67 {
        screen.*.column = clampColumn(screen, screen.*.column + count)
    } else if final == 68 {
        screen.*.column = if count > screen.*.column { 0 } else { screen.*.column - count }
    } else if final == 72 || final == 102 {
        screen.*.row = clampRow(screen, parameter(screen, 0, 1) - 1)
        screen.*.column = clampColumn(screen, parameter(screen, 1, 1) - 1)
    } else if final == 71 {
        screen.*.column = clampColumn(screen, count - 1)
    } else if final == 100 {
        screen.*.row = clampRow(screen, count - 1)
    } else if final == 74 {
        const mode = parameter(screen, 0, 0)
        if mode == 0 { clearRange(screen, here, screen.*.columns * screen.*.rows) }
        if mode == 1 { clearRange(screen, 0, here + 1) }
        if mode >= 2 { clearRange(screen, 0, screen.*.columns * screen.*.rows) }
    } else if final == 75 {
        const line = screen.*.row * screen.*.columns
        const mode = parameter(screen, 0, 0)
        if mode == 0 { clearRange(screen, here, line + screen.*.columns) }
        if mode == 1 { clearRange(screen, line, here + 1) }
        if mode >= 2 { clearRange(screen, line, line + screen.*.columns) }
    } else if final == 80 {
        // Delete characters: shift the rest of the line left.
        const line_end = screen.*.row * screen.*.columns + screen.*.columns
        var index = here
        while index < line_end {
            screen.*.cells[index] = if index + count < line_end { screen.*.cells[index + count] } else { 32 }
            index += 1
        }
    } else if final == 64 {
        // Insert blanks: shift the rest of the line right.
        const line_start = screen.*.row * screen.*.columns
        var index = line_start + screen.*.columns
        while index > here {
            index -= 1
            screen.*.cells[index] = if index >= here + count { screen.*.cells[index - count] } else { 32 }
        }
    }
}

// Interprets one byte of shell output.
pub fn feed(screen: *Screen, byte: u8) -> void {
    const state = screen.*.state
    if state == PARSE_ESCAPE {
        if byte == 91 {
            screen.*.state = PARSE_CSI
            screen.*.parameterCount = 0
            screen.*.parameters[0] = 0
        } else if byte == 93 || byte == 80 {
            screen.*.state = PARSE_STRING
        } else {
            screen.*.state = PARSE_TEXT
        }
        return
    }
    if state == PARSE_CSI {
        if byte >= 48 && byte <= 57 {
            if screen.*.parameterCount == 0 {
                screen.*.parameterCount = 1
                screen.*.parameters[0] = 0
            }
            const slot = screen.*.parameterCount - 1
            screen.*.parameters[slot] = screen.*.parameters[slot] * 10 + @intCast(usize, byte - 48)
        } else if byte == 59 {
            if screen.*.parameterCount == 0 {
                screen.*.parameterCount = 1
                screen.*.parameters[0] = 0
            }
            if screen.*.parameterCount < 8 {
                screen.*.parameters[screen.*.parameterCount] = 0
                screen.*.parameterCount += 1
            }
        } else if byte >= 64 && byte <= 126 {
            finishCsi(screen, byte)
            screen.*.state = PARSE_TEXT
        }
        return
    }
    if state == PARSE_STRING {
        // OSC/DCS strings end with BEL or ESC \.
        if byte == 7 || byte == 27 { screen.*.state = if byte == 27 { PARSE_ESCAPE } else { PARSE_TEXT } }
        return
    }
    if byte == 27 {
        screen.*.state = PARSE_ESCAPE
    } else if byte == 13 {
        screen.*.column = 0
    } else if byte == 10 || byte == 11 || byte == 12 {
        lineFeed(screen)
    } else if byte == 8 {
        if screen.*.column > 0 { screen.*.column -= 1 }
    } else if byte == 9 {
        var next = (screen.*.column / 8 + 1) * 8
        if next >= screen.*.columns { next = screen.*.columns - 1 }
        screen.*.column = next
    } else if byte >= 32 && byte < 127 {
        put(screen, byte)
    }
}

fn store(pixels: [*]u8, offset: usize, color: u32) -> void {
    pixels[offset] = @intCast(u8, color & 255)
    pixels[offset + 1] = @intCast(u8, (color >> 8) & 255)
    pixels[offset + 2] = @intCast(u8, (color >> 16) & 255)
    pixels[offset + 3] = @intCast(u8, (color >> 24) & 255)
}

// The image size for the current grid.
pub fn pixelWidth(screen: *const Screen) -> usize { return screen.*.columns * CELL_WIDTH + 2 * PADDING }
pub fn pixelHeight(screen: *const Screen) -> usize { return screen.*.rows * CELL_HEIGHT + 2 * PADDING }

// Changes the grid to `columns` x `rows` (clamped to the supported range),
// keeping what fits from the top left. When the cursor's line would fall
// off the bottom, lines scroll off the top instead. False when the size
// stays the same.
pub fn resize(screen: *Screen, wanted_columns: usize, wanted_rows: usize) -> bool {
    var columns = wanted_columns
    if columns < MIN_COLUMNS { columns = MIN_COLUMNS }
    if columns > MAX_COLUMNS { columns = MAX_COLUMNS }
    var rows = wanted_rows
    if rows < MIN_ROWS { rows = MIN_ROWS }
    if rows > MAX_ROWS { rows = MAX_ROWS }
    if columns == screen.*.columns && rows == screen.*.rows { return false }
    const shift = if screen.*.row >= rows { screen.*.row - rows + 1 } else { 0 }
    var row: usize = 0
    while row < rows {
        const source_row = row + shift
        var column: usize = 0
        while column < columns {
            const inside = source_row < screen.*.rows && column < screen.*.columns
            screen.*.scratch[row * columns + column] = if inside { screen.*.cells[source_row * screen.*.columns + column] } else { 32 }
            column += 1
        }
        row += 1
    }
    var index: usize = 0
    while index < columns * rows {
        screen.*.cells[index] = screen.*.scratch[index]
        index += 1
    }
    screen.*.columns = columns
    screen.*.rows = rows
    screen.*.row -= shift
    // A column just past the end (a wrap still pending) stays allowed.
    if screen.*.column > columns { screen.*.column = columns }
    return true
}

// Renders the grid into an ARGB8888 image of pixelWidth x pixelHeight.
pub fn render(screen: *const Screen, pixels: [*]u8) -> void {
    const stride = pixelWidth(screen) * 4
    var offset: usize = 0
    while offset < stride * pixelHeight(screen) {
        store(pixels, offset, BACKGROUND)
        offset += 4
    }
    var row: usize = 0
    while row < screen.*.rows {
        var column: usize = 0
        while column < screen.*.columns {
            const character = screen.*.cells[row * screen.*.columns + column]
            const is_cursor = row == screen.*.row && column == screen.*.column
            if character != 32 || is_cursor {
                const glyph = font.glyph(character)
                const cursor_color = if screen.*.focused { CURSOR } else { FOREGROUND }
                var y: usize = 0
                while y < CELL_HEIGHT {
                    const bits = @intCast(u32, (glyph >> ((y / 2) * 8)) & 255)
                    var x: usize = 0
                    const line = (PADDING + row * CELL_HEIGHT + y) * stride + (PADDING + column * CELL_WIDTH) * 4
                    while x < CELL_WIDTH {
                        const lit = ((bits >> @intCast(u32, x)) & 1) != 0
                        if is_cursor {
                            store(pixels, line + x * 4, if lit { BACKGROUND } else { cursor_color })
                        } else if lit {
                            store(pixels, line + x * 4, FOREGROUND)
                        }
                        x += 1
                    }
                    y += 1
                }
            }
            column += 1
        }
        row += 1
    }
}
