// The terminal screen: a character grid fed by the shell's output, and its
// rendering into an ARGB8888 buffer.
//
// The byte stream is interpreted as ASCII with the controls a dumb terminal
// needs (CR, LF, BS, HT, BEL) plus a small ECMA-48 subset: cursor movement
// (CSI A B C D H f G d), erase (CSI J, CSI K), delete/insert characters
// (CSI P, CSI @). Other escape sequences, including SGR attributes, are
// parsed and ignored so they never show up as garbage.

const font = @import("./font.mlx")

pub const COLUMNS: usize = 80
pub const ROWS: usize = 24
pub const CELL_WIDTH: usize = 8
pub const CELL_HEIGHT: usize = 16
pub const PADDING: usize = 6
pub const PIXEL_WIDTH: usize = 652
pub const PIXEL_HEIGHT: usize = 396

const PARSE_TEXT: u8 = 0
const PARSE_ESCAPE: u8 = 1
const PARSE_CSI: u8 = 2
const PARSE_STRING: u8 = 3

const BACKGROUND: u32 = 4280163870
const FOREGROUND: u32 = 4291875024
const CURSOR: u32 = 4287152255

pub const Screen = struct {
    cells: [1920]u8
    row: usize
    column: usize
    state: u8
    parameters: [8]usize
    parameterCount: usize
    focused: bool
}

pub fn initAt(screen: *Screen) -> void {
    var index: usize = 0
    while index < COLUMNS * ROWS {
        screen.*.cells[index] = 32
        index += 1
    }
    screen.*.row = 0
    screen.*.column = 0
    screen.*.state = PARSE_TEXT
    screen.*.parameterCount = 0
    screen.*.focused = false
}

fn clearRange(screen: *Screen, start: usize, end: usize) -> void {
    var index = start
    while index < end && index < COLUMNS * ROWS {
        screen.*.cells[index] = 32
        index += 1
    }
}

fn scrollUp(screen: *Screen) -> void {
    var index: usize = 0
    while index < COLUMNS * (ROWS - 1) {
        screen.*.cells[index] = screen.*.cells[index + COLUMNS]
        index += 1
    }
    clearRange(screen, COLUMNS * (ROWS - 1), COLUMNS * ROWS)
}

fn lineFeed(screen: *Screen) -> void {
    if screen.*.row + 1 >= ROWS {
        scrollUp(screen)
    } else {
        screen.*.row += 1
    }
}

fn put(screen: *Screen, byte: u8) -> void {
    if screen.*.column >= COLUMNS {
        screen.*.column = 0
        lineFeed(screen)
    }
    screen.*.cells[screen.*.row * COLUMNS + screen.*.column] = byte
    screen.*.column += 1
}

fn parameter(screen: *const Screen, index: usize, fallback: usize) -> usize {
    if index >= screen.*.parameterCount || screen.*.parameters[index] == 0 { return fallback }
    return screen.*.parameters[index]
}

fn clampRow(value: usize) -> usize { return if value >= ROWS { ROWS - 1 } else { value } }
fn clampColumn(value: usize) -> usize { return if value >= COLUMNS { COLUMNS - 1 } else { value } }

fn finishCsi(screen: *Screen, final: u8) -> void {
    const count = parameter(screen, 0, 1)
    const here = screen.*.row * COLUMNS + screen.*.column
    if final == 65 {
        screen.*.row = if count > screen.*.row { 0 } else { screen.*.row - count }
    } else if final == 66 {
        screen.*.row = clampRow(screen.*.row + count)
    } else if final == 67 {
        screen.*.column = clampColumn(screen.*.column + count)
    } else if final == 68 {
        screen.*.column = if count > screen.*.column { 0 } else { screen.*.column - count }
    } else if final == 72 || final == 102 {
        screen.*.row = clampRow(parameter(screen, 0, 1) - 1)
        screen.*.column = clampColumn(parameter(screen, 1, 1) - 1)
    } else if final == 71 {
        screen.*.column = clampColumn(count - 1)
    } else if final == 100 {
        screen.*.row = clampRow(count - 1)
    } else if final == 74 {
        const mode = parameter(screen, 0, 0)
        if mode == 0 { clearRange(screen, here, COLUMNS * ROWS) }
        if mode == 1 { clearRange(screen, 0, here + 1) }
        if mode >= 2 { clearRange(screen, 0, COLUMNS * ROWS) }
    } else if final == 75 {
        const line = screen.*.row * COLUMNS
        const mode = parameter(screen, 0, 0)
        if mode == 0 { clearRange(screen, here, line + COLUMNS) }
        if mode == 1 { clearRange(screen, line, here + 1) }
        if mode >= 2 { clearRange(screen, line, line + COLUMNS) }
    } else if final == 80 {
        // Delete characters: shift the rest of the line left.
        const line_end = screen.*.row * COLUMNS + COLUMNS
        var index = here
        while index < line_end {
            screen.*.cells[index] = if index + count < line_end { screen.*.cells[index + count] } else { 32 }
            index += 1
        }
    } else if final == 64 {
        // Insert blanks: shift the rest of the line right.
        const line_start = screen.*.row * COLUMNS
        var index = line_start + COLUMNS
        while index > here {
            index -= 1
            screen.*.cells[index] = if index >= here + count { screen.*.cells[index - count] } else { 32 }
        }
    }
}

// Interprets one byte of shell output.
pub fn feed(screen: *Screen, byte: u8) -> void {
    const state = screen.*.state
    if state == PARSE_ESCAPE {
        if byte == 91 {
            screen.*.state = PARSE_CSI
            screen.*.parameterCount = 0
            screen.*.parameters[0] = 0
        } else if byte == 93 || byte == 80 {
            screen.*.state = PARSE_STRING
        } else {
            screen.*.state = PARSE_TEXT
        }
        return
    }
    if state == PARSE_CSI {
        if byte >= 48 && byte <= 57 {
            if screen.*.parameterCount == 0 {
                screen.*.parameterCount = 1
                screen.*.parameters[0] = 0
            }
            const slot = screen.*.parameterCount - 1
            screen.*.parameters[slot] = screen.*.parameters[slot] * 10 + @intCast(usize, byte - 48)
        } else if byte == 59 {
            if screen.*.parameterCount == 0 {
                screen.*.parameterCount = 1
                screen.*.parameters[0] = 0
            }
            if screen.*.parameterCount < 8 {
                screen.*.parameters[screen.*.parameterCount] = 0
                screen.*.parameterCount += 1
            }
        } else if byte >= 64 && byte <= 126 {
            finishCsi(screen, byte)
            screen.*.state = PARSE_TEXT
        }
        return
    }
    if state == PARSE_STRING {
        // OSC/DCS strings end with BEL or ESC \.
        if byte == 7 || byte == 27 { screen.*.state = if byte == 27 { PARSE_ESCAPE } else { PARSE_TEXT } }
        return
    }
    if byte == 27 {
        screen.*.state = PARSE_ESCAPE
    } else if byte == 13 {
        screen.*.column = 0
    } else if byte == 10 || byte == 11 || byte == 12 {
        lineFeed(screen)
    } else if byte == 8 {
        if screen.*.column > 0 { screen.*.column -= 1 }
    } else if byte == 9 {
        var next = (screen.*.column / 8 + 1) * 8
        if next >= COLUMNS { next = COLUMNS - 1 }
        screen.*.column = next
    } else if byte >= 32 && byte < 127 {
        put(screen, byte)
    }
}

fn store(pixels: [*]u8, offset: usize, color: u32) -> void {
    pixels[offset] = @intCast(u8, color & 255)
    pixels[offset + 1] = @intCast(u8, (color >> 8) & 255)
    pixels[offset + 2] = @intCast(u8, (color >> 16) & 255)
    pixels[offset + 3] = @intCast(u8, (color >> 24) & 255)
}

// Renders the grid into an ARGB8888 image of PIXEL_WIDTH x PIXEL_HEIGHT.
pub fn render(screen: *const Screen, pixels: [*]u8) -> void {
    const stride = PIXEL_WIDTH * 4
    var offset: usize = 0
    while offset < stride * PIXEL_HEIGHT {
        store(pixels, offset, BACKGROUND)
        offset += 4
    }
    var row: usize = 0
    while row < ROWS {
        var column: usize = 0
        while column < COLUMNS {
            const character = screen.*.cells[row * COLUMNS + column]
            const is_cursor = row == screen.*.row && column == screen.*.column
            if character != 32 || is_cursor {
                const glyph = font.glyph(character)
                const cursor_color = if screen.*.focused { CURSOR } else { FOREGROUND }
                var y: usize = 0
                while y < CELL_HEIGHT {
                    const bits = @intCast(u32, (glyph >> ((y / 2) * 8)) & 255)
                    var x: usize = 0
                    const line = (PADDING + row * CELL_HEIGHT + y) * stride + (PADDING + column * CELL_WIDTH) * 4
                    while x < CELL_WIDTH {
                        const lit = ((bits >> @intCast(u32, x)) & 1) != 0
                        if is_cursor {
                            store(pixels, line + x * 4, if lit { BACKGROUND } else { cursor_color })
                        } else if lit {
                            store(pixels, line + x * 4, FOREGROUND)
                        }
                        x += 1
                    }
                    y += 1
                }
            }
            column += 1
        }
        row += 1
    }
}
