// Pseudo-terminal and child process for the terminal emulator, over raw
// Linux x86_64 syscalls.

const std = @import("std")

pub extern("syscall") fn syscall0(number: usize) -> isize {}
pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_close: usize = 3
const SYS_ioctl: usize = 16
const SYS_dup2: usize = 33
const SYS_fork: usize = 57
const SYS_execve: usize = 59
const SYS_kill: usize = 62
const SYS_wait4: usize = 61
const SYS_fcntl: usize = 72
const SYS_setsid: usize = 112
const SYS_clock_gettime: usize = 228
const SYS_exit_group: usize = 231
const SYS_openat: usize = 257

const AT_FDCWD: usize = 18446744073709551516
const O_RDWR: usize = 2
const O_NOCTTY: usize = 256
const O_NONBLOCK: usize = 2048
const O_CLOEXEC: usize = 524288
const TIOCSPTLCK: usize = 1074025521
const TIOCGPTN: usize = 2147767344
const TIOCSWINSZ: usize = 21524
const TIOCSCTTY: usize = 21518
const F_SETFL: usize = 4
const WNOHANG: usize = 1
const SIGHUP: usize = 1

pub const EAGAIN: isize = -11

pub const Child = struct {
    master: isize
    pid: isize
}

// Opens a pty sized `columns` x `rows`, forks, and runs `path` with
// `arguments` and `environment` (NULL-terminated pointer arrays) on the
// slave side as a session leader. Returns false when any step fails.
pub fn spawn(child: *Child, path: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8, columns: u16, rows: u16) -> bool {
    var ptmx: usize = 0
    unsafe { ptmx = @intFromPtr(@ptrCast([*]const u8, "/dev/ptmx")) }
    const master = syscall4(SYS_openat, AT_FDCWD, ptmx, O_RDWR | O_NOCTTY | O_CLOEXEC, 0)
    if master < 0 { return false }
    var unlock: u32 = 0
    if syscall3(SYS_ioctl, @bitCast(usize, master), TIOCSPTLCK, @intFromPtr(&unlock)) < 0 { return false }
    var number: u32 = 0
    if syscall3(SYS_ioctl, @bitCast(usize, master), TIOCGPTN, @intFromPtr(&number)) < 0 { return false }
    // Window size: rows, columns, then pixel sizes (unused).
    var size: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    size[0] = @intCast(u8, rows & 255)
    size[1] = @intCast(u8, rows >> 8)
    size[2] = @intCast(u8, columns & 255)
    size[3] = @intCast(u8, columns >> 8)
    const sized = syscall3(SYS_ioctl, @bitCast(usize, master), TIOCSWINSZ, @intFromPtr(&size))

    // "/dev/pts/<number>"
    var slave_path: [32]u8 = undefined
    var length: usize = 0
    for byte in "/dev/pts/" {
        slave_path[length] = byte
        length += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = number
    if rest == 0 {
        digits[0] = 48
        count = 1
    }
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        slave_path[length] = digits[count]
        length += 1
    }
    slave_path[length] = 0

    const pid = syscall0(SYS_fork)
    if pid < 0 { return false }
    if pid == 0 {
        const session = syscall0(SYS_setsid)
        const slave = syscall4(SYS_openat, AT_FDCWD, @intFromPtr(&slave_path), O_RDWR, 0)
        if slave < 0 { const failed = syscall1(SYS_exit_group, 127) }
        const controlling = syscall3(SYS_ioctl, @bitCast(usize, slave), TIOCSCTTY, 0)
        const standard_input = syscall2(SYS_dup2, @bitCast(usize, slave), 0)
        const standard_output = syscall2(SYS_dup2, @bitCast(usize, slave), 1)
        const standard_error = syscall2(SYS_dup2, @bitCast(usize, slave), 2)
        if slave > 2 { const closed = syscall1(SYS_close, @bitCast(usize, slave)) }
        const executed = syscall3(SYS_execve, @intFromPtr(path), @intFromPtr(arguments), @intFromPtr(environment))
        const exited = syscall1(SYS_exit_group, 127)
    }
    const nonblocking = syscall3(SYS_fcntl, @bitCast(usize, master), F_SETFL, O_RDWR | O_NONBLOCK)
    child.*.master = master
    child.*.pid = pid
    return true
}

// Reads available output; 0 means the shell side closed, EAGAIN nothing yet.
pub fn read(child: *const Child, buffer: [*]u8, capacity: usize) -> isize {
    return syscall3(SYS_read, @bitCast(usize, child.*.master), @intFromPtr(buffer), capacity)
}

pub fn write(child: *const Child, bytes: [*]const u8, length: usize) -> void {
    var sent: usize = 0
    while sent < length {
        const result = syscall3(SYS_write, @bitCast(usize, child.*.master), @intFromPtr(bytes) + sent, length - sent)
        if result <= 0 { return }
        sent += @bitCast(usize, result)
    }
}

pub fn hangUp(child: *const Child) -> void {
    const killed = syscall2(SYS_kill, @bitCast(usize, child.*.pid), SIGHUP)
    const closed = syscall1(SYS_close, @bitCast(usize, child.*.master))
    var status: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    const waited = syscall4(SYS_wait4, @bitCast(usize, child.*.pid), @intFromPtr(&status), WNOHANG, 0)
}

// Monotonic time in milliseconds.
pub fn milliseconds() -> usize {
    var time: [16]u8 = undefined
    const result = syscall2(SYS_clock_gettime, 1, @intFromPtr(&time))
    var seconds: usize = 0
    var nanoseconds: usize = 0
    var index: usize = 0
    while index < 8 {
        seconds = seconds | (@intCast(usize, time[index]) << (index * 8))
        nanoseconds = nanoseconds | (@intCast(usize, time[8 + index]) << (index * 8))
        index += 1
    }
    return seconds * 1000 + nanoseconds / 1000000
}
