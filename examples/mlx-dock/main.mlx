// The dock of the Mlx desktop: a Wayland client in the compositor's top
// layer, along the bottom edge of the screen, keeping that strip free of
// windows. It shows an apps button (the launcher), the pinned apps, and
// after a separator the apps that have windows but are not pinned; a dot
// under an icon marks an app that runs. Icons grow under the pointer and
// the one under it shows its name. A click brings an app's window forward
// (again: its next window), or starts the app.
//
// The windows come from the compositor (wlr-foreign-toplevel-management),
// the apps from their desktop entries, and the bar asks the compositor to
// blur what is behind it (ext-background-effect-v1).
//
//   mlx-dock
//
// Pinned apps are listed in $XDG_CONFIG_HOME/mlx/dock (~/.config/mlx/dock),
// one desktop entry id per line ("org.gnome.Nautilus", "firefox"), and
// "terminal" for the Mlx terminal. Without that file the dock pins the
// terminal, a file manager, a browser and an editor when they are
// installed. The terminal is $MLX_TERMINAL. Started by the compositor to
// stay, the apps button asks it for its launcher on MLX_DOCK_FD; otherwise
// it runs $MLX_LAUNCHER. New apps and a changed configuration are taken in
// within five seconds.
const std = @import("std")
const apps_module = @import("../desktop-shared/apps.mlx")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const panel_module = @import("../desktop-shared/panel.mlx")

const Apps = apps_module.Apps
const App = apps_module.App
const Canvas = canvas_module.Canvas
const Text = canvas_module.Text
const Panel = panel_module.Panel
const Window = panel_module.Window

const ICON: i32 = 48
const MAX_ICON: i32 = 76
const SPACING: i32 = 10
const PADDING: i32 = 8
const SEPARATOR: i32 = 17
const BAR_HEIGHT: i32 = 64
const GAP: i32 = 8
const RADIUS: i32 = 18
const REACH: i32 = 150
const HEIGHT: i32 = 150
const EXTRA_WIDTH: i32 = 120
const MAX_ITEMS: usize = 48
const NONE: usize = 1 << 40
const BUTTON_LEFT: u32 = 272

const KIND_APPS: u32 = 0
const KIND_APP: u32 = 1
const KIND_TERMINAL: u32 = 2
const KIND_WINDOW: u32 = 3

const TERMINAL_ID: []const u8 = "org.mlx.terminal"

// One icon of the dock.
const Item = struct {
    kind: u32
    // The desktop entry (KIND_APP), else NONE.
    app: usize
    // The windows' app id (KIND_WINDOW).
    appId: [96]u8
    appIdLength: usize
    // How many windows it has, and whether one of them is active.
    running: usize
    active: bool
    // Where it is drawn this frame.
    x: i32
    size: i32
}

const Dock = struct {
    panel: Panel
    apps: Apps
    environment: [*][*]const u8
    terminal: [*]const u8
    launcher: [*]const u8
    items: [48]Item
    itemCount: usize
    // The apps button and the pinned apps come first.
    pinnedCount: usize
    // The pointer.
    pointerX: i32
    pointerIn: bool
    hover: usize
    // The bar as last laid out, and the region last asked to be blurred.
    barLeft: i32
    barWidth: i32
    blurLeft: i32
    blurWidth: i32
    small: Text
    large: Text
    // Started by the compositor to stay (MLX_DOCK_FD): the channel the apps
    // button asks it for the launcher on, else -1.
    channel: isize
    // What the apps and the configuration looked like when last read (see
    // refresh).
    appsSignature: usize
    configSignature: usize
}

fn dockOf(context: *anyopaque) -> *Dock {
    unsafe { return @ptrCast(*Dock, context) }
}

fn panelOf(dock: *Dock) -> *Panel {
    unsafe { return @ptrCast(*Panel, &dock.*.panel) }
}

fn appsOf(dock: *Dock) -> *Apps {
    unsafe { return @ptrCast(*Apps, &dock.*.apps) }
}

fn smallOf(dock: *Dock) -> *Text {
    unsafe { return @ptrCast(*Text, &dock.*.small) }
}

fn largeOf(dock: *Dock) -> *Text {
    unsafe { return @ptrCast(*Text, &dock.*.large) }
}

fn itemAt(dock: *Dock, index: usize) -> *Item {
    unsafe { return @ptrFromInt(*Item, @intFromPtr(dock) + @offsetOf(Dock, "items") + index * @sizeOf(Item)) }
}

fn appIdOf(item: *const Item) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(item) + @offsetOf(Item, "appId")) }
    return bytes[0..item.*.appIdLength]
}

fn noString() -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

// ---------------------------------------------------------------------------
// Items

fn addItem(dock: *Dock, kind: u32, app: usize, app_id: []const u8) -> *Item {
    const item = itemAt(dock, dock.*.itemCount)
    dock.*.itemCount += 1
    item.*.kind = kind
    item.*.app = app
    item.*.appIdLength = 0
    for byte in app_id {
        if item.*.appIdLength < 96 {
            item.*.appId[item.*.appIdLength] = byte
            item.*.appIdLength += 1
        }
    }
    item.*.running = 0
    item.*.active = false
    item.*.x = 0
    item.*.size = ICON
    return item
}

fn hasApp(dock: *Dock, app: usize) -> bool {
    var index: usize = 0
    while index < dock.*.itemCount {
        if itemAt(dock, index).*.kind == KIND_APP && itemAt(dock, index).*.app == app { return true }
        index += 1
    }
    return false
}

fn hasTerminal(dock: *Dock) -> bool {
    var index: usize = 0
    while index < dock.*.itemCount {
        if itemAt(dock, index).*.kind == KIND_TERMINAL { return true }
        index += 1
    }
    return false
}

// Pins what `name` names, when it is installed (or the terminal).
fn pin(dock: *Dock, name: []const u8) -> void {
    if name.length == 0 || dock.*.itemCount >= MAX_ITEMS { return }
    if apps_module.sameText(name, "terminal") || apps_module.sameText(name, TERMINAL_ID) {
        if !hasTerminal(dock) { const item = addItem(dock, KIND_TERMINAL, NONE, TERMINAL_ID) }
        return
    }
    const app = apps_module.find(appsOf(dock), name)
    if app < appsOf(dock).*.count && !hasApp(dock, app) { const item = addItem(dock, KIND_APP, app, "") }
}

// The pinned apps without a configuration: the first of each group that is
// installed.
fn defaultPin(index: usize) -> []const u8 {
    return match index {
        0 => "terminal",
        1 => "org.gnome.Nautilus", 2 => "nautilus", 3 => "org.kde.dolphin", 4 => "thunar", 5 => "pcmanfm",
        6 => "firefox", 7 => "org.mozilla.firefox", 8 => "chromium", 9 => "google-chrome", 10 => "brave-browser",
        11 => "code", 12 => "code-oss", 13 => "codium", 14 => "org.gnome.TextEditor", 15 => "gedit", 16 => "org.kde.kate",
        else => ""
    }
}

fn defaultGroupEnd(index: usize) -> bool {
    return index == 0 || index == 5 || index == 10 || index == 16
}

fn pinDefaults(dock: *Dock) -> void {
    var index: usize = 0
    var group_done = false
    while index <= 16 {
        const before = dock.*.itemCount
        if !group_done { pin(dock, defaultPin(index)) }
        if dock.*.itemCount != before { group_done = true }
        if defaultGroupEnd(index) { group_done = false }
        index += 1
    }
}

// The configuration file's path into `path`; false without a home.
fn configPath(dock: *Dock, path: *apps_module.Path) -> bool {
    apps_module.pathClear(path)
    const config = apps_module.environmentValue(dock.*.environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] != 0 {
        apps_module.pathAddC(path, config)
    } else {
        const home = apps_module.environmentValue(dock.*.environment, "HOME")
        if @intFromPtr(home) == 0 { return false }
        apps_module.pathAddC(path, home)
        apps_module.pathAdd(path, "/.config")
    }
    apps_module.pathAdd(path, "/mlx/dock")
    return true
}

// When the configuration file last changed (1: there is none).
fn configSignature(dock: *Dock) -> usize {
    var path: apps_module.Path = undefined
    if !configPath(dock, &path) { return 1 }
    var status: std.fs.Stat = undefined
    if std.fs.status(apps_module.pathEnd(&path), &status) != 0 { return 1 }
    return @bitCast(usize, status.modifiedSeconds) *% 1000000007 +% @bitCast(usize, status.modifiedNanoseconds) +% @bitCast(usize, status.size)
}

// Reads the pinned apps from the configuration file; false without one.
fn pinConfigured(dock: *Dock) -> bool {
    var path: apps_module.Path = undefined
    if !configPath(dock, &path) { return false }
    const file = std.fs.open(apps_module.pathEnd(&path), 0, 0)
    if !std.fs.isValid(file) { return false }
    const contents = std.fs.readToEndAlloc(file, appsOf(dock).*.allocator)
    const closed = std.fs.close(file)
    const text = contents.items
    var at: usize = 0
    while at < contents.length {
        var end = at
        while end < contents.length && text[end] != 10 { end += 1 }
        var start = at
        while start < end && (text[start] == 32 || text[start] == 9) { start += 1 }
        var stop = end
        while stop > start && (text[stop - 1] == 32 || text[stop - 1] == 9 || text[stop - 1] == 13) { stop -= 1 }
        if stop > start && text[start] != 35 { pin(dock, text[start..stop]) }
        at = end + 1
    }
    std.fs.ArrayList.deinit(contents)
    return true
}

fn isTerminalWindow(window: *const Window) -> bool {
    return apps_module.sameText(panel_module.appIdOf(window), TERMINAL_ID)
}

// Whether `window` is one of `item`'s.
fn owns(dock: *Dock, item: *Item, window: *Window) -> bool {
    if !window.*.live { return false }
    if item.*.kind == KIND_TERMINAL { return isTerminalWindow(window) }
    if item.*.kind == KIND_APP {
        const app_id = panel_module.appIdOf(window)
        return app_id.length > 0 && apps_module.find(appsOf(dock), app_id) == item.*.app
    }
    if item.*.kind == KIND_WINDOW { return apps_module.sameText(panel_module.appIdOf(window), appIdOf(item)) }
    return false
}

// The items again after the windows changed: the pinned ones, then one for
// each other app that has windows.
fn rebuild(dock: *Dock) -> void {
    const panel = panelOf(dock)
    const before = dock.*.itemCount
    dock.*.itemCount = dock.*.pinnedCount
    var index: usize = 0
    while index < dock.*.itemCount {
        itemAt(dock, index).*.running = 0
        itemAt(dock, index).*.active = false
        index += 1
    }
    var window_index: usize = 0
    while window_index < panel.*.windowCount {
        const window = panel_module.windowAt(panel, window_index)
        if window.*.live {
            var found = NONE
            index = 0
            while index < dock.*.itemCount && found == NONE {
                if owns(dock, itemAt(dock, index), window) { found = index }
                index += 1
            }
            if found == NONE && dock.*.itemCount < MAX_ITEMS {
                const app_id = panel_module.appIdOf(window)
                const app = if app_id.length > 0 { apps_module.find(appsOf(dock), app_id) } else { appsOf(dock).*.count }
                found = dock.*.itemCount
                if isTerminalWindow(window) {
                    const item = addItem(dock, KIND_TERMINAL, NONE, TERMINAL_ID)
                } else if app < appsOf(dock).*.count {
                    const item = addItem(dock, KIND_APP, app, "")
                } else {
                    const item = addItem(dock, KIND_WINDOW, NONE, app_id)
                }
            }
            if found != NONE {
                const item = itemAt(dock, found)
                item.*.running += 1
                if window.*.activated { item.*.active = true }
            }
        }
        window_index += 1
    }
    if dock.*.itemCount != before { fitWidth(dock) }
    dock.*.hover = NONE
}

// ---------------------------------------------------------------------------
// Layout

fn baseWidth(dock: *Dock) -> i32 {
    var width = PADDING * 2 + @intCast(i32, dock.*.itemCount) * (ICON + SPACING) - SPACING
    if dock.*.itemCount > dock.*.pinnedCount { width += SEPARATOR }
    return width
}

// Asks for a surface as wide as the dock can grow.
fn fitWidth(dock: *Dock) -> void {
    panel_module.resize(panelOf(dock), @intCast(u32, baseWidth(dock) + EXTRA_WIDTH), @intCast(u32, HEIGHT))
}

// How big an icon is whose resting centre is `distance` pixels from the
// pointer: full size under it, easing down to the normal size at REACH.
fn magnified(distance: i32) -> i32 {
    const away = if distance < 0 { -distance } else { distance }
    if away >= REACH { return ICON }
    // Smoothstep of how close it is, in 1/1024.
    const close = (REACH - away) * 1024 / REACH
    const eased = close * close * (3072 - 2 * close) / (1024 * 1024)
    return ICON + (MAX_ICON - ICON) * eased / 1024
}

fn barTop(dock: *Dock) -> i32 {
    return @intCast(i32, panelOf(dock).*.height) - GAP - BAR_HEIGHT
}

// Sizes and places the items for the pointer where it is.
fn layout(dock: *Dock) -> void {
    const surface_width = @intCast(i32, panelOf(dock).*.width)
    const resting = baseWidth(dock)
    const resting_left = (surface_width - resting) / 2
    var total = PADDING * 2
    var offset = resting_left + PADDING
    var index: usize = 0
    while index < dock.*.itemCount {
        if index == dock.*.pinnedCount && index > 0 { offset += SEPARATOR }
        const item = itemAt(dock, index)
        item.*.size = if dock.*.pointerIn { magnified(dock.*.pointerX - (offset + ICON / 2)) } else { ICON }
        total += item.*.size + if index + 1 < dock.*.itemCount { SPACING } else { 0 }
        offset += ICON + SPACING
        index += 1
    }
    if dock.*.itemCount > dock.*.pinnedCount && dock.*.pinnedCount > 0 { total += SEPARATOR }
    dock.*.barWidth = total
    dock.*.barLeft = (surface_width - total) / 2
    var x = dock.*.barLeft + PADDING
    index = 0
    while index < dock.*.itemCount {
        if index == dock.*.pinnedCount && index > 0 { x += SEPARATOR }
        const item = itemAt(dock, index)
        item.*.x = x
        x += item.*.size + SPACING
        index += 1
    }
}

fn itemUnder(dock: *Dock, x: i32) -> usize {
    var index: usize = 0
    while index < dock.*.itemCount {
        const item = itemAt(dock, index)
        if x >= item.*.x - SPACING / 2 && x < item.*.x + item.*.size + SPACING / 2 { return index }
        index += 1
    }
    return NONE
}

// ---------------------------------------------------------------------------
// Input

fn nameOf(dock: *Dock, item: *Item) -> []const u8 {
    if item.*.kind == KIND_APPS { return "Apps" }
    if item.*.kind == KIND_TERMINAL { return "Terminal" }
    if item.*.kind == KIND_APP { return apps_module.nameOf(apps_module.appAt(appsOf(dock), item.*.app)) }
    return appIdOf(item)
}

// Brings the item's next window forward: the one after the active one, else
// the first. False when it has none.
fn activateNext(dock: *Dock, item: *Item) -> bool {
    const panel = panelOf(dock)
    var first = NONE
    var active = NONE
    var next = NONE
    var index: usize = 0
    while index < panel.*.windowCount {
        const window = panel_module.windowAt(panel, index)
        if owns(dock, item, window) {
            if first == NONE { first = index }
            if active != NONE && next == NONE { next = index }
            if window.*.activated { active = index }
        }
        index += 1
    }
    if first == NONE { return false }
    const chosen = if next != NONE { next } else { first }
    panel_module.activate(panel, panel_module.windowAt(panel, chosen))
    return true
}

// Asks the compositor to show the item's windows as previews: 112 'p',
// their count and their handles' object ids (at most 8). False without a
// compositor to ask.
fn showPreviews(dock: *Dock, item: *Item) -> bool {
    if dock.*.channel < 0 { return false }
    const panel = panelOf(dock)
    var message: [34]u8 = undefined
    message[0] = 112
    var count: usize = 0
    var index: usize = 0
    while index < panel.*.windowCount && count < 8 {
        const window = panel_module.windowAt(panel, index)
        if owns(dock, item, window) {
            const id = window.*.handle.id()
            message[2 + count * 4] = @intCast(u8, id & 255)
            message[3 + count * 4] = @intCast(u8, (id >> 8) & 255)
            message[4 + count * 4] = @intCast(u8, (id >> 16) & 255)
            message[5 + count * 4] = @intCast(u8, id >> 24)
            count += 1
        }
        index += 1
    }
    if count < 2 { return false }
    message[1] = @intCast(u8, count)
    const sent = std.linux.syscall6(44, @bitCast(usize, dock.*.channel), @intFromPtr(&message), 2 + count * 4, 64 | 16384, 0, 0)
    return sent > 0
}

// The items from scratch: the apps button, the pinned apps (the
// configuration may have changed), then the apps with windows.
fn reloadItems(dock: *Dock) -> void {
    dock.*.itemCount = 0
    if dock.*.channel >= 0 || @intFromPtr(dock.*.launcher) != 0 { const item = addItem(dock, KIND_APPS, NONE, "") }
    if !pinConfigured(dock) { pinDefaults(dock) }
    dock.*.pinnedCount = dock.*.itemCount
    rebuild(dock)
    fitWidth(dock)
    panelOf(dock).*.dirty = true
}

// Looks whether apps were installed or removed, or the pinned apps
// changed, and takes them in (twice a minute and more: see main).
fn refresh(dock: *Dock) -> void {
    const apps_now = apps_module.signature(appsOf(dock))
    const config_now = configSignature(dock)
    if apps_now == dock.*.appsSignature && config_now == dock.*.configSignature { return }
    if apps_now != dock.*.appsSignature {
        apps_module.rescan(appsOf(dock))
        panel_module.forgetImages(panelOf(dock))
    }
    dock.*.appsSignature = apps_now
    dock.*.configSignature = config_now
    reloadItems(dock)
}

// The compositor's end of the channel: its going ends us (it starts a new
// dock with itself).
fn listen(dock: *Dock) -> void {
    var bytes: [16]u8 = undefined
    const count = std.linux.syscall3(0, @bitCast(usize, dock.*.channel), @intFromPtr(&bytes), 16)
    if count == 0 { panelOf(dock).*.running = false }
}

fn click(dock: *Dock, index: usize) -> void {
    const item = itemAt(dock, index)
    if item.*.kind == KIND_APPS {
        if dock.*.channel >= 0 {
            // The compositor shows its launcher (that stays: at once).
            var byte: [1]u8 = [1]u8{ 108 }
            const sent = std.linux.syscall6(44, @bitCast(usize, dock.*.channel), @intFromPtr(&byte), 1, 64 | 16384, 0, 0)
            return
        }
        if @intFromPtr(dock.*.launcher) != 0 {
            var length: usize = 0
            while dock.*.launcher[length] != 0 { length += 1 }
            apps_module.run(dock.*.launcher[0..length], noString(), dock.*.environment)
        }
        return
    }
    if item.*.running >= 2 && showPreviews(dock, item) { return }
    if activateNext(dock, item) { return }
    if item.*.kind == KIND_TERMINAL {
        var length: usize = 0
        while dock.*.terminal[length] != 0 { length += 1 }
        apps_module.run(dock.*.terminal[0..length], noString(), dock.*.environment)
    } else if item.*.kind == KIND_APP {
        apps_module.launch(apps_module.appAt(appsOf(dock), item.*.app), dock.*.terminal, dock.*.environment)
    }
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const dock = dockOf(context)
    const panel = panelOf(dock)
    if kind == panel_module.EVENT_CONFIGURED {
        // The pointer counts on the bar's strip only; above it, clicks go
        // to what is behind.
        var rects: [4]i32 = [4]i32{ 0, barTop(dock), @intCast(i32, panel.*.width), BAR_HEIGHT + GAP }
        unsafe { panel_module.setInput(panel, @ptrCast([*]const i32, &rects), 1) }
        dock.*.blurWidth = 0
    } else if kind == panel_module.EVENT_MOTION {
        dock.*.pointerX = @bitCast(i32, a)
        dock.*.pointerIn = true
        layout(dock)
        dock.*.hover = itemUnder(dock, dock.*.pointerX)
    } else if kind == panel_module.EVENT_LEAVE {
        dock.*.pointerIn = false
        dock.*.hover = NONE
    } else if kind == panel_module.EVENT_BUTTON {
        if a == BUTTON_LEFT && b == 1 && dock.*.hover != NONE { click(dock, dock.*.hover) }
    } else if kind == panel_module.EVENT_WINDOWS {
        rebuild(dock)
    } else if kind == panel_module.EVENT_TICK {
        refresh(dock)
        return
    } else if kind == panel_module.EVENT_WATCH {
        listen(dock)
        return
    }
    panel.*.dirty = true
}

// ---------------------------------------------------------------------------
// Drawing

fn tileColor(name: []const u8) -> u32 {
    var hash: u32 = 2166136261
    for byte in name { hash = (hash ^ @intCast(u32, byte)) *% 16777619 }
    return match hash % 6 {
        0 => 4282154168, 1 => 4290005830, 2 => 4283215696, 3 => 4292241438, 4 => 4287646649,
        else => 4278235830
    }
}

fn drawLetter(dock: *Dock, canvas: *Canvas, name: []const u8, x: i32, y: i32, size: i32) -> void {
    canvas_module.fillRoundedRect(canvas, x + size / 24, y + size / 24, size - size / 12, size - size / 12, size / 4, tileColor(name))
    if name.length == 0 { return }
    var letter: [1]u8 = [1]u8{ name[0] }
    if letter[0] >= 97 && letter[0] <= 122 { letter[0] -= 32 }
    const large = largeOf(dock)
    const width = canvas_module.measure(large, letter[0..1])
    canvas_module.drawText(canvas, large, letter[0..1], x + (size - width) / 2, y + (size - 30) / 2, 4294967295, 0)
}

fn drawAppsIcon(canvas: *Canvas, x: i32, y: i32, size: i32) -> void {
    canvas_module.fillRoundedRect(canvas, x + size / 24, y + size / 24, size - size / 12, size - size / 12, size / 4, canvas_module.color(255, 88, 96, 112))
    const dot = size / 8
    const step = size / 4
    var row: i32 = 0
    while row < 3 {
        var column: i32 = 0
        while column < 3 {
            canvas_module.fillRoundedRect(canvas, x + step * (column + 1) - dot / 2, y + step * (row + 1) - dot / 2, dot, dot, dot / 2, canvas_module.color(235, 255, 255, 255))
            column += 1
        }
        row += 1
    }
}

fn drawTerminalIcon(dock: *Dock, canvas: *Canvas, x: i32, y: i32, size: i32) -> void {
    canvas_module.fillRoundedRect(canvas, x + size / 24, y + size / 24, size - size / 12, size - size / 12, size / 4, canvas_module.color(255, 30, 32, 38))
    canvas_module.strokeRoundedRect(canvas, x + size / 24, y + size / 24, size - size / 12, size - size / 12, size / 4, 1, canvas_module.color(90, 255, 255, 255))
    const small = smallOf(dock)
    const width = canvas_module.measure(small, ">_")
    canvas_module.drawText(canvas, small, ">_", x + (size - width) / 2, y + (size - 16) / 2, canvas_module.color(255, 120, 220, 140), 0)
}

fn drawItem(dock: *Dock, canvas: *Canvas, item: *Item, y: i32) -> void {
    const size = item.*.size
    if item.*.kind == KIND_APPS {
        drawAppsIcon(canvas, item.*.x, y, size)
    } else if item.*.kind == KIND_TERMINAL {
        drawTerminalIcon(dock, canvas, item.*.x, y, size)
    } else if item.*.kind == KIND_APP {
        const app = apps_module.appAt(appsOf(dock), item.*.app)
        if apps_module.loadIcon(appsOf(dock), app, @intCast(usize, MAX_ICON)) {
            canvas_module.drawImage(canvas, apps_module.imageOf(app), item.*.x, y, size, 255)
        } else {
            drawLetter(dock, canvas, apps_module.nameOf(app), item.*.x, y, size)
        }
    } else {
        drawLetter(dock, canvas, appIdOf(item), item.*.x, y, size)
    }
}

// The name above the item under the pointer.
fn drawName(dock: *Dock, canvas: *Canvas, item: *Item, icon_top: i32) -> void {
    const small = smallOf(dock)
    const name = nameOf(dock, item)
    const width = canvas_module.measure(small, name) + 20
    var left = item.*.x + item.*.size / 2 - width / 2
    if left < 2 { left = 2 }
    const surface_width = @intCast(i32, panelOf(dock).*.width)
    if left + width > surface_width - 2 { left = surface_width - 2 - width }
    const top = icon_top - 34
    canvas_module.fillRoundedRect(canvas, left, top, width, 26, 9, canvas_module.color(225, 28, 30, 36))
    canvas_module.drawText(canvas, small, name, left + 10, top + 5, 4294967295, 0)
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const dock = dockOf(context)
    const panel = panelOf(dock)
    layout(dock)
    canvas_module.clear(canvas, 0)
    const top = barTop(dock)
    // The bar, and the blur behind it when it moved.
    if dock.*.barLeft != dock.*.blurLeft || dock.*.barWidth != dock.*.blurWidth {
        var rects: [36]i32 = undefined
        var count: usize = 0
        unsafe { count = panel_module.roundedRects(@ptrCast([*]i32, &rects), dock.*.barLeft, top, dock.*.barWidth, BAR_HEIGHT, RADIUS, 4) }
        unsafe { panel_module.setBlur(panel, @ptrCast([*]const i32, &rects), count) }
        dock.*.blurLeft = dock.*.barLeft
        dock.*.blurWidth = dock.*.barWidth
    }
    canvas_module.fillRoundedRect(canvas, dock.*.barLeft, top, dock.*.barWidth, BAR_HEIGHT, RADIUS, canvas_module.color(150, 40, 44, 54))
    canvas_module.strokeRoundedRect(canvas, dock.*.barLeft, top, dock.*.barWidth, BAR_HEIGHT, RADIUS, 1, canvas_module.color(70, 255, 255, 255))

    var index: usize = 0
    while index < dock.*.itemCount {
        const item = itemAt(dock, index)
        if index == dock.*.pinnedCount && index > 0 {
            canvas_module.fillRect(canvas, item.*.x - SPACING / 2 - SEPARATOR / 2 - 1, top + 12, 1, BAR_HEIGHT - 24, canvas_module.color(80, 255, 255, 255))
        }
        const icon_top = top + BAR_HEIGHT - 8 - item.*.size
        drawItem(dock, canvas, item, icon_top)
        if item.*.running > 0 {
            const dot_color = if item.*.active { canvas_module.color(255, 255, 255, 255) } else { canvas_module.color(170, 255, 255, 255) }
            canvas_module.fillRoundedRect(canvas, item.*.x + item.*.size / 2 - 2, top + BAR_HEIGHT - 6, 5, 5, 2, dot_color)
        }
        index += 1
    }
    if dock.*.hover != NONE && dock.*.hover < dock.*.itemCount {
        const item = itemAt(dock, dock.*.hover)
        drawName(dock, canvas, item, top + BAR_HEIGHT - 8 - item.*.size)
    }
}

const Failure = error { NoMemory }

fn noMemory() -> Failure!void { return Failure.NoMemory }

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Dock), 16)
    if memory == null { return noMemory() }
    var dock: *Dock = undefined
    unsafe { dock = @ptrCast(*Dock, memory.?) }
    dock.*.environment = environment
    dock.*.terminal = apps_module.environmentValue(environment, "MLX_TERMINAL")
    if @intFromPtr(dock.*.terminal) == 0 {
        unsafe { dock.*.terminal = @ptrCast([*]const u8, "mlx-terminal") }
    }
    dock.*.launcher = apps_module.environmentValue(environment, "MLX_LAUNCHER")
    dock.*.itemCount = 0
    dock.*.pointerIn = false
    dock.*.pointerX = 0
    dock.*.hover = NONE
    dock.*.blurLeft = 0
    dock.*.blurWidth = 0
    const channel = apps_module.environmentValue(environment, "MLX_DOCK_FD")
    dock.*.channel = -1
    if @intFromPtr(channel) != 0 && channel[0] >= 48 && channel[0] <= 57 {
        var descriptor: isize = 0
        var digit: usize = 0
        while channel[digit] >= 48 && channel[digit] <= 57 {
            descriptor = descriptor * 10 + @intCast(isize, channel[digit] - 48)
            digit += 1
        }
        dock.*.channel = descriptor
    }
    if !apps_module.init(appsOf(dock), environment, allocator) { return noMemory() }
    apps_module.scan(appsOf(dock))
    dock.*.appsSignature = apps_module.signature(appsOf(dock))
    dock.*.configSignature = configSignature(dock)
    if dock.*.channel >= 0 || @intFromPtr(dock.*.launcher) != 0 { const item = addItem(dock, KIND_APPS, NONE, "") }
    if !pinConfigured(dock) { pinDefaults(dock) }
    dock.*.pinnedCount = dock.*.itemCount
    const loaded_small = canvas_module.loadText(smallOf(dock), 13, allocator)
    const loaded_large = canvas_module.loadText(largeOf(dock), 26, allocator)

    const panel = panelOf(dock)
    panel.*.context = @ptrCast(*anyopaque, dock)
    panel.*.draw = draw
    panel.*.event = onEvent
    const anchor = panel_module.ANCHOR_BOTTOM
    try panel_module.open(panel, allocator, arguments, "mlx-dock", panel_module.LAYER_TOP, anchor, @intCast(u32, baseWidth(dock) + EXTRA_WIDTH), @intCast(u32, HEIGHT), BAR_HEIGHT + GAP, 0, panel_module.KEYBOARD_NONE, true)
    // New apps and a changed configuration are taken in within five
    // seconds; the compositor's end of the channel going ends us.
    panel_module.report(panel, "mlx-dock")
    panel.*.tickInterval = 5000
    panel.*.watch = dock.*.channel
    try panel_module.run(panel)
    panel_module.close(panel)
}
