// A native Wayland client: opens an xdg_toplevel window, draws a gradient
// into a shared-memory buffer and presents it, then exits after the
// compositor has shown `FRAMES` frames. No libc, no libwayland: only
// std.wayland.
//
//     mlx4 examples/wayland-client/main.mlx -o hello-wayland
//     ./hello-wayland            # uses $WAYLAND_DISPLAY / $XDG_RUNTIME_DIR

const std = @import("std")
const wl = @import("std.wayland")

const WIDTH: i32 = 320
const HEIGHT: i32 = 240
const STRIDE: i32 = 1280
const BUFFER_SIZE: usize = 307200
const FRAMES: u32 = 3

const App = struct {
    display: wl.client.Display
    registry: wl.wl_registry.Proxy
    compositor: wl.wl_compositor.Proxy
    shm: wl.wl_shm.Proxy
    wmBase: wl.xdg_wm_base.Proxy
    hasCompositor: bool
    hasShm: bool
    hasWmBase: bool
    surface: wl.wl_surface.Proxy
    xdgSurface: wl.xdg_surface.Proxy
    toplevel: wl.xdg_toplevel.Proxy
    buffer: wl.wl_buffer.Proxy
    memory: wl.SharedMemory
    configured: bool
    closed: bool
    framesShown: u32
    frame: u32
}

fn appOf(context: *anyopaque) -> *App {
    unsafe { return @ptrCast(*App, context) }
}

fn contextOf(app: *App) -> *anyopaque {
    unsafe { return @ptrCast(*anyopaque, app) }
}

fn minimum(left: u32, right: u32) -> u32 {
    if left < right { return left }
    return right
}

fn onRegistry(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.wl_registry.decodeEvent(event)
    if @tagOf(decoded) != 0 { return }
    const global = decoded.global
    if std.string.eql(global.interface, std.string.fromSlice("wl_compositor")) {
        const object = app.*.registry.bind(global.name, wl.Interface.wl_compositor, minimum(global.version, 4))
        app.*.compositor = wl.wl_compositor.Proxy.fromObject(object)
        app.*.hasCompositor = true
    } else if std.string.eql(global.interface, std.string.fromSlice("wl_shm")) {
        app.*.shm = wl.wl_shm.Proxy.fromObject(app.*.registry.bind(global.name, wl.Interface.wl_shm, 1))
        app.*.hasShm = true
    } else if std.string.eql(global.interface, std.string.fromSlice("xdg_wm_base")) {
        const object = app.*.registry.bind(global.name, wl.Interface.xdg_wm_base, minimum(global.version, 5))
        app.*.wmBase = wl.xdg_wm_base.Proxy.fromObject(object)
        app.*.hasWmBase = true
    }
}

// The compositor pings to check the client is alive.
fn onWmBase(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.xdg_wm_base.decodeEvent(event)
    app.*.wmBase.pong(decoded.ping.serial)
}

fn onXdgSurface(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.xdg_surface.decodeEvent(event)
    app.*.xdgSurface.ackConfigure(decoded.configure.serial)
    if !app.*.configured {
        app.*.configured = true
        present(app)
    }
}

fn onToplevel(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.xdg_toplevel.decodeEvent(event)
    if @tagOf(decoded) == 1 { app.*.closed = true }
}

fn onFrame(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    app.*.framesShown += 1
    if app.*.framesShown < FRAMES { present(app) }
}

fn draw(app: *App) -> void {
    const pixels = app.*.memory.bytes()
    var y: usize = 0
    while y < 240 {
        var x: usize = 0
        while x < 320 {
            const offset = y * 1280 + x * 4
            pixels[offset] = @intCast(u8, (x * 255) / 320)
            pixels[offset + 1] = @intCast(u8, (y * 255) / 240)
            pixels[offset + 2] = @intCast(u8, (app.*.frame * 60) & 255)
            pixels[offset + 3] = 255
            x += 1
        }
        y += 1
    }
    app.*.frame += 1
}

// Draws, attaches the buffer, requests a frame callback and commits.
fn present(app: *App) -> void {
    draw(app)
    const buffer = app.*.buffer
    app.*.surface.attach(&buffer, 0, 0)
    app.*.surface.damage(0, 0, WIDTH, HEIGHT)
    const callback = app.*.surface.frame()
    callback.setHandler(onFrame, contextOf(app))
    app.*.surface.commit()
}

const Failure = error { MissingGlobals, NoSharedMemory, WindowClosed }

fn missingGlobals() -> Failure!void { return Failure.MissingGlobals }
fn noSharedMemory() -> Failure!void { return Failure.NoSharedMemory }

fn run(app: *App) -> !void {
    const allocator = std.page_allocator.init()
    var display: wl.client.Display = undefined
    try wl.client.Display.connect(&display, allocator)
    app.*.display = display
    app.*.registry = wl.displayProxy(display).getRegistry()
    app.*.registry.setHandler(onRegistry, contextOf(app))
    try display.roundtrip()
    if !app.*.hasCompositor || !app.*.hasShm || !app.*.hasWmBase { return missingGlobals() }
    app.*.wmBase.setHandler(onWmBase, contextOf(app))

    var memory: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&memory, BUFFER_SIZE) { return noSharedMemory() }
    app.*.memory = memory
    const pool = app.*.shm.createPool(memory.handle, @intCast(i32, BUFFER_SIZE))
    app.*.buffer = pool.createBuffer(0, WIDTH, HEIGHT, STRIDE, @intFromEnum(wl.wl_shm.Format.argb8888))
    pool.destroy()

    app.*.surface = app.*.compositor.createSurface()
    app.*.xdgSurface = app.*.wmBase.getXdgSurface(app.*.surface)
    app.*.xdgSurface.setHandler(onXdgSurface, contextOf(app))
    app.*.toplevel = app.*.xdgSurface.getToplevel()
    app.*.toplevel.setHandler(onToplevel, contextOf(app))
    app.*.toplevel.setTitle("Mlx on Wayland")
    app.*.toplevel.setAppId("org.mlx.hello")
    app.*.surface.commit()

    while display.running() && !app.*.closed && app.*.framesShown < FRAMES {
        try display.dispatch()
    }
    app.*.toplevel.destroy()
    app.*.xdgSurface.destroy()
    app.*.surface.destroy()
    app.*.buffer.destroy()
    try display.roundtrip()
    memory.release()
    display.disconnect()
}

pub fn main() -> !void {
    var app: App = undefined
    app.hasCompositor = false
    app.hasShm = false
    app.hasWmBase = false
    app.configured = false
    app.closed = false
    app.framesShown = 0
    app.frame = 0
    try run(&app)
    const shown = std.io.println("mlx wayland client: presented frames")
}
