// A native Wayland client: opens an xdg_toplevel window, draws a gradient
// into a shared-memory buffer and presents it, then exits after the
// compositor has shown `FRAMES` frames. No libc, no libwayland: only
// std.wayland.
//
//     mlx4 examples/wayland-client/main.mlx -o hello-wayland
//     ./hello-wayland            # uses $WAYLAND_DISPLAY / $XDG_RUNTIME_DIR
//
// With --subsurface-gone the subsurface goes away when the pointer first
// enters (tools/check_wayland_compositor.sh moves the pointer over it and
// on: the compositor must drop its focus on the destroyed surface).
// With --subsurface it also shows a green wl_subsurface (SUB_WIDTH x
// SUB_HEIGHT at SUB_X, SUB_Y in the window, committed in synchronized mode
// before the window's first commit) and stays until the window is closed.
//
// With --decoration client (or server) it asks for that decoration mode
// (xdg-decoration), prints each mode the compositor answers with
// ("decoration: server side") and stays until the window is closed.
//
// With --lock it locks the pointer on its window (pointer constraints,
// persistent) and reads relative motion: it prints "pointer: locked" and
// "pointer: unlocked" as the compositor sends them, and after each motion
// the unaccelerated relative motion so far ("relative: dx dy"). It stays
// until the window is closed.

const std = @import("std")
const wl = @import("std.wayland")
const crash = @import("std.crash")
const wayland_crash = @import("std.wayland.crash")

const WIDTH: i32 = 320
const HEIGHT: i32 = 240
const STRIDE: i32 = 1280
const BUFFER_SIZE: usize = 307200
const FRAMES: u32 = 3
const SUB_X: i32 = 40
const SUB_Y: i32 = 30
const SUB_WIDTH: i32 = 100
const SUB_HEIGHT: i32 = 80
const SUB_BUFFER_SIZE: usize = 32000

const App = struct {
    display: wl.client.Display
    registry: wl.wl_registry.Proxy
    compositor: wl.wl_compositor.Proxy
    shm: wl.wl_shm.Proxy
    wmBase: wl.xdg_wm_base.Proxy
    hasCompositor: bool
    hasShm: bool
    hasWmBase: bool
    subcompositor: wl.wl_subcompositor.Proxy
    hasSubcompositor: bool
    wantSubsurface: bool
    decorationManager: wl.zxdg_decoration_manager_v1.Proxy
    hasDecorationManager: bool
    // 0: no decoration object; 1: client side, 2: server side.
    wantDecoration: u32
    decoration: wl.zxdg_toplevel_decoration_v1.Proxy
    wantLock: bool
    seat: wl.wl_seat.Proxy
    hasSeat: bool
    relativeManager: wl.zwp_relative_pointer_manager_v1.Proxy
    hasRelativeManager: bool
    constraints: wl.zwp_pointer_constraints_v1.Proxy
    hasConstraints: bool
    relativeX: i32
    relativeY: i32
    surface: wl.wl_surface.Proxy
    xdgSurface: wl.xdg_surface.Proxy
    toplevel: wl.xdg_toplevel.Proxy
    buffer: wl.wl_buffer.Proxy
    memory: wl.SharedMemory
    configured: bool
    closed: bool
    framesShown: u32
    frame: u32
    // --subsurface-gone: the subsurface, destroyed when the pointer first
    // enters (the compositor must not keep a focus on it afterwards).
    wantSubsurfaceGone: bool
    child: wl.wl_surface.Proxy
    subsurface: wl.wl_subsurface.Proxy
    subsurfaceAlive: bool
}

fn appOf(context: *anyopaque) -> *App {
    unsafe { return @ptrCast(*App, context) }
}

fn contextOf(app: *App) -> *anyopaque {
    unsafe { return @ptrCast(*anyopaque, app) }
}

fn minimum(left: u32, right: u32) -> u32 {
    if left < right { return left }
    return right
}

fn onRegistry(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.wl_registry.decodeEvent(event)
    if @tagOf(decoded) != 0 { return }
    const global = decoded.global
    if std.string.eql(global.interface, std.string.fromSlice("wl_compositor")) {
        const object = app.*.registry.bind(global.name, wl.Interface.wl_compositor, minimum(global.version, 4))
        app.*.compositor = wl.wl_compositor.Proxy.fromObject(object)
        app.*.hasCompositor = true
    } else if std.string.eql(global.interface, std.string.fromSlice("wl_shm")) {
        app.*.shm = wl.wl_shm.Proxy.fromObject(app.*.registry.bind(global.name, wl.Interface.wl_shm, 1))
        app.*.hasShm = true
    } else if std.string.eql(global.interface, std.string.fromSlice("wl_subcompositor")) {
        app.*.subcompositor = wl.wl_subcompositor.Proxy.fromObject(app.*.registry.bind(global.name, wl.Interface.wl_subcompositor, 1))
        app.*.hasSubcompositor = true
    } else if std.string.eql(global.interface, std.string.fromSlice("xdg_wm_base")) {
        const object = app.*.registry.bind(global.name, wl.Interface.xdg_wm_base, minimum(global.version, 5))
        app.*.wmBase = wl.xdg_wm_base.Proxy.fromObject(object)
        app.*.hasWmBase = true
    } else if std.string.eql(global.interface, std.string.fromSlice("wl_seat")) {
        app.*.seat = wl.wl_seat.Proxy.fromObject(app.*.registry.bind(global.name, wl.Interface.wl_seat, 1))
        app.*.hasSeat = true
    } else if std.string.eql(global.interface, std.string.fromSlice("zwp_relative_pointer_manager_v1")) {
        app.*.relativeManager = wl.zwp_relative_pointer_manager_v1.Proxy.fromObject(app.*.registry.bind(global.name, wl.Interface.zwp_relative_pointer_manager_v1, 1))
        app.*.hasRelativeManager = true
    } else if std.string.eql(global.interface, std.string.fromSlice("zwp_pointer_constraints_v1")) {
        app.*.constraints = wl.zwp_pointer_constraints_v1.Proxy.fromObject(app.*.registry.bind(global.name, wl.Interface.zwp_pointer_constraints_v1, 1))
        app.*.hasConstraints = true
    } else if std.string.eql(global.interface, std.string.fromSlice("zxdg_decoration_manager_v1")) {
        app.*.decorationManager = wl.zxdg_decoration_manager_v1.Proxy.fromObject(app.*.registry.bind(global.name, wl.Interface.zxdg_decoration_manager_v1, 1))
        app.*.hasDecorationManager = true
    }
}

fn onLocked(context: *anyopaque, event: wl.client.Event) -> void {
    const said = std.io.println(if event.opcode == wl.zwp_locked_pointer_v1.EVENT_LOCKED { "pointer: locked" } else { "pointer: unlocked" })
}

fn onRelative(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.zwp_relative_pointer_v1.decodeEvent(event)
    app.*.relativeX += decoded.relative_motion.dx_unaccel.toInt()
    app.*.relativeY += decoded.relative_motion.dy_unaccel.toInt()
    const shown = std.io.writeAll(std.io.stdout(), "relative: ")
    sayNumber(app.*.relativeX)
    const gap = std.io.writeAll(std.io.stdout(), " ")
    sayNumber(app.*.relativeY)
    const end = std.io.println("")
}

fn ignoreEvent(context: *anyopaque, event: wl.client.Event) -> void {}

fn sayNumber(value: i32) -> void {
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { 0 - value } else { value }
    while true {
        digits[11 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    if value < 0 {
        digits[11 - count] = 45
        count += 1
    }
    const shown = std.io.writeAll(std.io.stdout(), digits[12 - count..12])
}

fn onDecoration(context: *anyopaque, event: wl.client.Event) -> void {
    const decoded = wl.zxdg_toplevel_decoration_v1.decodeEvent(event)
    const said = std.io.println(if decoded.configure.mode == 2 { "decoration: server side" } else { "decoration: client side" })
}

// The compositor pings to check the client is alive.
fn onWmBase(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.xdg_wm_base.decodeEvent(event)
    app.*.wmBase.pong(decoded.ping.serial)
}

fn onXdgSurface(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.xdg_surface.decodeEvent(event)
    app.*.xdgSurface.ackConfigure(decoded.configure.serial)
    if !app.*.configured {
        app.*.configured = true
        present(app)
    }
}

fn onToplevel(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    const decoded = wl.xdg_toplevel.decodeEvent(event)
    if @tagOf(decoded) == 1 { app.*.closed = true }
}

fn onFrame(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    app.*.framesShown += 1
    if app.*.framesShown < FRAMES { present(app) }
}

fn draw(app: *App) -> void {
    const pixels = app.*.memory.bytes()
    var y: usize = 0
    while y < 240 {
        var x: usize = 0
        while x < 320 {
            const offset = y * 1280 + x * 4
            pixels[offset] = @intCast(u8, (x * 255) / 320)
            pixels[offset + 1] = @intCast(u8, (y * 255) / 240)
            pixels[offset + 2] = @intCast(u8, (app.*.frame * 60) & 255)
            pixels[offset + 3] = 255
            x += 1
        }
        y += 1
    }
    app.*.frame += 1
}

// Draws, attaches the buffer, requests a frame callback and commits.
fn present(app: *App) -> void {
    draw(app)
    const buffer = app.*.buffer
    app.*.surface.attach(&buffer, 0, 0)
    app.*.surface.damage(0, 0, WIDTH, HEIGHT)
    const callback = app.*.surface.frame()
    callback.setHandler(onFrame, contextOf(app))
    app.*.surface.commit()
}

const Failure = error { MissingGlobals, NoSharedMemory, WindowClosed }

fn missingGlobals() -> Failure!void { return Failure.MissingGlobals }
fn noSharedMemory() -> Failure!void { return Failure.NoSharedMemory }

// A green subsurface in the window, committed before the window's first
// commit: in synchronized mode (the default) that commit is kept until the
// window's is applied, so both appear together.
fn addSubsurface(app: *App) -> !void {
    if !app.*.hasSubcompositor { return missingGlobals() }
    var memory: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&memory, SUB_BUFFER_SIZE) { return noSharedMemory() }
    const pixels = memory.bytes()
    var index: usize = 0
    while index < SUB_BUFFER_SIZE {
        pixels[index] = 0
        pixels[index + 1] = 255
        pixels[index + 2] = 0
        pixels[index + 3] = 255
        index += 4
    }
    const pool = app.*.shm.createPool(memory.handle, @intCast(i32, SUB_BUFFER_SIZE))
    const buffer = pool.createBuffer(0, SUB_WIDTH, SUB_HEIGHT, SUB_WIDTH * 4, @intFromEnum(wl.wl_shm.Format.argb8888))
    pool.destroy()
    const child = app.*.compositor.createSurface()
    const subsurface = app.*.subcompositor.getSubsurface(child, app.*.surface)
    subsurface.setPosition(SUB_X, SUB_Y)
    child.attach(&buffer, 0, 0)
    child.damage(0, 0, SUB_WIDTH, SUB_HEIGHT)
    child.commit()
    app.*.child = child
    app.*.subsurface = subsurface
    app.*.subsurfaceAlive = true
}

// --subsurface-gone: the pointer entering any of the client's surfaces
// destroys the subsurface (and commits the window, so the compositor
// applies it): the pointer is then over nothing of that subsurface.
fn onPointer(context: *anyopaque, event: wl.client.Event) -> void {
    const app = appOf(context)
    if event.opcode != wl.wl_pointer.EVENT_ENTER || !app.*.subsurfaceAlive { return }
    app.*.subsurfaceAlive = false
    app.*.subsurface.destroy()
    app.*.child.destroy()
    app.*.surface.commit()
    const said = std.io.println("mlx wayland client: subsurface destroyed on pointer enter")
}

fn run(app: *App) -> !void {
    const allocator = std.page_allocator.init()
    var display: wl.client.Display = undefined
    try wl.client.Display.connect(&display, allocator)
    wayland_crash.watch(display)
    app.*.display = display
    app.*.registry = wl.displayProxy(display).getRegistry()
    app.*.registry.setHandler(onRegistry, contextOf(app))
    try display.roundtrip()
    if !app.*.hasCompositor || !app.*.hasShm || !app.*.hasWmBase { return missingGlobals() }
    app.*.wmBase.setHandler(onWmBase, contextOf(app))

    var memory: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&memory, BUFFER_SIZE) { return noSharedMemory() }
    app.*.memory = memory
    const pool = app.*.shm.createPool(memory.handle, @intCast(i32, BUFFER_SIZE))
    app.*.buffer = pool.createBuffer(0, WIDTH, HEIGHT, STRIDE, @intFromEnum(wl.wl_shm.Format.argb8888))
    pool.destroy()

    app.*.surface = app.*.compositor.createSurface()
    app.*.xdgSurface = app.*.wmBase.getXdgSurface(app.*.surface)
    app.*.xdgSurface.setHandler(onXdgSurface, contextOf(app))
    app.*.toplevel = app.*.xdgSurface.getToplevel()
    app.*.toplevel.setHandler(onToplevel, contextOf(app))
    app.*.toplevel.setTitle("Mlx on Wayland")
    app.*.toplevel.setAppId("org.mlx.hello")
    if app.*.wantSubsurface { try addSubsurface(app) }
    if app.*.wantSubsurfaceGone {
        if !app.*.hasSeat { return missingGlobals() }
        const pointer = app.*.seat.getPointer()
        pointer.setHandler(onPointer, contextOf(app))
    }
    if app.*.wantDecoration != 0 {
        if !app.*.hasDecorationManager { return missingGlobals() }
        app.*.decoration = app.*.decorationManager.getToplevelDecoration(app.*.toplevel)
        app.*.decoration.setHandler(onDecoration, contextOf(app))
        app.*.decoration.setMode(app.*.wantDecoration)
    }
    if app.*.wantLock {
        if !app.*.hasSeat || !app.*.hasRelativeManager || !app.*.hasConstraints { return missingGlobals() }
        const pointer = app.*.seat.getPointer()
        pointer.setHandler(ignoreEvent, contextOf(app))
        const relative = app.*.relativeManager.getRelativePointer(pointer)
        relative.setHandler(onRelative, contextOf(app))
        const locked = app.*.constraints.lockPointer(app.*.surface, pointer, null, @intFromEnum(wl.zwp_pointer_constraints_v1.Lifetime.persistent))
        locked.setHandler(onLocked, contextOf(app))
    }
    app.*.surface.commit()

    while display.running() && !app.*.closed && (app.*.wantSubsurface || app.*.wantDecoration != 0 || app.*.wantLock || app.*.framesShown < FRAMES) {
        try display.dispatch()
    }
    if app.*.wantDecoration != 0 { app.*.decoration.destroy() }
    app.*.toplevel.destroy()
    app.*.xdgSurface.destroy()
    app.*.surface.destroy()
    app.*.buffer.destroy()
    try display.roundtrip()
    memory.release()
    display.disconnect()
}

pub fn main(arguments: [][*]const u8) -> !void {
    const installed = crash.install()
    var app: App = undefined
    app.hasCompositor = false
    app.hasShm = false
    app.hasWmBase = false
    app.hasSubcompositor = false
    app.hasDecorationManager = false
    app.hasSeat = false
    app.hasRelativeManager = false
    app.hasConstraints = false
    app.relativeX = 0
    app.relativeY = 0
    app.wantLock = std.process.count(arguments) > 1 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--lock"))
    app.wantSubsurfaceGone = std.process.count(arguments) > 1 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--subsurface-gone"))
    app.wantSubsurface = app.wantSubsurfaceGone || (std.process.count(arguments) > 1 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--subsurface")))
    app.subsurfaceAlive = false
    app.wantDecoration = 0
    if std.process.count(arguments) > 2 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--decoration")) {
        app.wantDecoration = if std.string.eql(std.process.argument(arguments, 2), std.string.fromSlice("server")) { 2 } else { 1 }
    }
    app.configured = false
    app.closed = false
    app.framesShown = 0
    app.frame = 0
    try run(&app)
    const shown = std.io.println("mlx wayland client: presented frames")
}
