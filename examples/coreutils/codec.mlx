const std = @import("std")

pub const EncodeResult = struct {
    data: [*]u8
    length: usize
}

pub const DecodeResult = struct {
    data: [*]u8
    length: usize
    ok: bool
}

fn allocateBytes(count: usize) -> [*]u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const size = if count > 0 { count } else { 1 }
    const allocation = allocator.alloc(size, 1)
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, allocation.?) }
    return pointer
}

pub fn base64Alphabet() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/") }
}

pub fn base64UrlAlphabet() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_") }
}

pub fn base32Alphabet() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567") }
}

pub fn base32HexAlphabet() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "0123456789ABCDEFGHIJKLMNOPQRSTUV") }
}

pub fn base16Alphabet() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "0123456789ABCDEF") }
}

pub fn encodeGeneric(data: [*]const u8, length: usize, alphabet: [*]const u8, bits_per_char: usize, group_chars: usize, use_padding: bool) -> EncodeResult {
    const total_bits = length * 8
    const char_count = (total_bits + bits_per_char - 1) / bits_per_char
    var out_length = char_count
    if use_padding && group_chars > 1 {
        const remainder = char_count % group_chars
        if remainder != 0 { out_length += group_chars - remainder }
    }
    const out = allocateBytes(out_length)
    var bit_buffer: usize = 0
    var bit_count: usize = 0
    var byte_index: usize = 0
    var out_index: usize = 0
    const mask = (@intCast(usize, 1) << bits_per_char) - 1
    while byte_index < length {
        bit_buffer = (bit_buffer << 8) | @intCast(usize, data[byte_index])
        bit_count += 8
        byte_index += 1
        while bit_count >= bits_per_char {
            bit_count -= bits_per_char
            const chunk = (bit_buffer >> bit_count) & mask
            out[out_index] = alphabet[chunk]
            out_index += 1
        }
    }
    if bit_count > 0 {
        const chunk = (bit_buffer << (bits_per_char - bit_count)) & mask
        out[out_index] = alphabet[chunk]
        out_index += 1
    }
    while out_index < out_length {
        out[out_index] = 61
        out_index += 1
    }
    return EncodeResult.{ .data = out, .length = out_length }
}

pub fn encodeBase2(data: [*]const u8, length: usize, msb_first: bool) -> EncodeResult {
    const out_length = length * 8
    const out = allocateBytes(out_length)
    var i: usize = 0
    while i < length {
        const byte = data[i]
        var b: usize = 0
        while b < 8 {
            const bit_index: usize = if msb_first { 7 - b } else { b }
            const bit = (byte >> bit_index) & 1
            out[i * 8 + b] = if bit == 1 { 49 } else { 48 }
            b += 1
        }
        i += 1
    }
    return EncodeResult.{ .data = out, .length = out_length }
}

pub fn buildLookup(alphabet: [*]const u8, alphabet_length: usize) -> [*]u8 {
    const table = allocateBytes(256)
    var z: usize = 0
    while z < 256 {
        table[z] = 255
        z += 1
    }
    var i: usize = 0
    while i < alphabet_length {
        table[alphabet[i]] = @intCast(u8, i)
        i += 1
    }
    return table
}

pub fn decodeGeneric(text: [*]const u8, length: usize, lookup: [*]u8, bits_per_char: usize, ignore_garbage: bool) -> DecodeResult {
    const capacity = (length * bits_per_char) / 8 + 1
    const out = allocateBytes(capacity)
    var bit_buffer: usize = 0
    var bit_count: usize = 0
    var out_index: usize = 0
    var i: usize = 0
    while i < length {
        const c = text[i]
        i += 1
        if c == 10 || c == 13 || c == 32 || c == 9 { continue }
        if c == 61 { break }
        const value = lookup[c]
        if value == 255 {
            if ignore_garbage { continue }
            return DecodeResult.{ .data = out, .length = out_index, .ok = false }
        }
        bit_buffer = (bit_buffer << bits_per_char) | @intCast(usize, value)
        bit_count += bits_per_char
        if bit_count >= 8 {
            bit_count -= 8
            out[out_index] = @intCast(u8, (bit_buffer >> bit_count) & 255)
            out_index += 1
        }
    }
    return DecodeResult.{ .data = out, .length = out_index, .ok = true }
}

pub fn decodeBase2(text: [*]const u8, length: usize, msb_first: bool, ignore_garbage: bool) -> DecodeResult {
    const capacity = length / 8 + 1
    const out = allocateBytes(capacity)
    var bit_buffer: usize = 0
    var bit_position: usize = 0
    var out_index: usize = 0
    var i: usize = 0
    while i < length {
        const c = text[i]
        i += 1
        if c == 10 || c == 13 || c == 32 || c == 9 { continue }
        if c != 48 && c != 49 {
            if ignore_garbage { continue }
            return DecodeResult.{ .data = out, .length = out_index, .ok = false }
        }
        const bit: usize = if c == 49 { 1 } else { 0 }
        const shift: usize = if msb_first { 7 - bit_position } else { bit_position }
        bit_buffer = bit_buffer | (bit << shift)
        bit_position += 1
        if bit_position == 8 {
            out[out_index] = @intCast(u8, bit_buffer)
            out_index += 1
            bit_buffer = 0
            bit_position = 0
        }
    }
    return DecodeResult.{ .data = out, .length = out_index, .ok = true }
}

pub fn writeWrapped(file: std.fs.File, data: [*]const u8, length: usize, wrap_width: usize) -> bool {
    if wrap_width == 0 {
        if length == 0 { return true }
        return std.io.writeAllBytes(file, data, length)
    }
    var offset: usize = 0
    while offset < length {
        var chunk = wrap_width
        if offset + chunk > length { chunk = length - offset }
        unsafe {
            var pointer: [*]const u8 = undefined
            pointer = @ptrFromInt([*]const u8, @intFromPtr(data) + offset)
            if !std.io.writeAllBytes(file, pointer, chunk) { return false }
        }
        if !std.io.writeAll(file, "\n") { return false }
        offset += chunk
    }
    return true
}
