const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    numberNonblank: bool
    numberAll: bool
    squeezeBlank: bool
    showEnds: bool
    showTabs: bool
    showNonprinting: bool
    firstFile: usize
    action: u8
    invalid: bool
}

const Writer = struct {
    buffer: [*]u8
    length: usize
    capacity: usize
}

const State = struct {
    line: usize
    atLineStart: bool
    previousBlank: bool
}

fn emptyOptions() -> Options {
    return Options.{ .numberNonblank = false, .numberAll = false, .squeezeBlank = false, .showEnds = false, .showTabs = false, .showNonprinting = false, .firstFile = 1, .action = 0, .invalid = false }
}

fn parseLong(argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--number-nonblank") {
        options.*.numberNonblank = true
        return true
    }
    if common.equals(argument, "--number") {
        options.*.numberAll = true
        return true
    }
    if common.equals(argument, "--squeeze-blank") {
        options.*.squeezeBlank = true
        return true
    }
    if common.equals(argument, "--show-ends") {
        options.*.showEnds = true
        return true
    }
    if common.equals(argument, "--show-tabs") {
        options.*.showTabs = true
        return true
    }
    if common.equals(argument, "--show-nonprinting") {
        options.*.showNonprinting = true
        return true
    }
    if common.equals(argument, "--show-all") {
        options.*.showEnds = true
        options.*.showTabs = true
        options.*.showNonprinting = true
        return true
    }
    if common.equals(argument, "--help") {
        options.*.action = 1
        return true
    }
    if common.equals(argument, "--version") {
        options.*.action = 2
        return true
    }
    return false
}

fn applyShort(byte: u8, options: *Options) -> bool {
    if byte == 65 {
        options.*.showEnds = true
        options.*.showTabs = true
        options.*.showNonprinting = true
    } else if byte == 98 {
        options.*.numberNonblank = true
    } else if byte == 101 {
        options.*.showEnds = true
        options.*.showNonprinting = true
    } else if byte == 69 {
        options.*.showEnds = true
    } else if byte == 110 { options.*.numberAll = true } else if byte == 115 {
        options.*.squeezeBlank = true
    } else if byte == 116 {
        options.*.showTabs = true
        options.*.showNonprinting = true
    } else if byte == 84 {
        options.*.showTabs = true
    } else if byte == 118 { options.*.showNonprinting = true } else if byte != 117 { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = emptyOptions()
    const count = std.process.count(arguments)
    while result.firstFile < count {
        const argument = std.process.argument(arguments, result.firstFile)
        if common.equals(argument, "--") {
            result.firstFile += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if argument.pointer[1] == 45 {
            if !parseLong(argument, &result) { result.invalid = true }
        } else {
            var index: usize = 1
            while index < argument.length {
                if !applyShort(argument.pointer[index], &result) { result.invalid = true }
                index += 1
            }
        }
        result.firstFile += 1
    }
    if result.numberNonblank { result.numberAll = false }
    return result
}

fn transformed(options: Options) -> bool {
    return options.numberNonblank || options.numberAll || options.squeezeBlank || options.showEnds || options.showTabs || options.showNonprinting
}

fn flush(writer: *Writer) -> bool {
    if writer.*.length == 0 { return true }
    unsafe {
        if !std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, writer.*.buffer), writer.*.length) { return false }
    }
    writer.*.length = 0
    return true
}

fn emit(writer: *Writer, byte: u8) -> bool {
    if writer.*.length == writer.*.capacity && !flush(writer) { return false }
    writer.*.buffer[writer.*.length] = byte
    writer.*.length += 1
    return true
}

fn emitLineNumber(writer: *Writer, value: usize) -> bool {
    var digits: [32]u8 = undefined
    var number = value
    var length: usize = 0
    while true {
        digits[length] = @intCast(u8, 48 + number % 10)
        length += 1
        number /= 10
        if number == 0 { break }
    }
    var spaces: usize = if length < 6 { 6 - length } else { 0 }
    while spaces > 0 {
        if !emit(writer, 32) { return false }
        spaces -= 1
    }
    while length > 0 {
        length -= 1
        if !emit(writer, digits[length]) { return false }
    }
    return emit(writer, 9)
}

fn emitControl(writer: *Writer, byte: u8) -> bool {
    if byte < 32 { return emit(writer, 94) && emit(writer, byte + 64) }
    if byte == 127 { return emit(writer, 94) && emit(writer, 63) }
    return emit(writer, byte)
}

fn emitVisible(writer: *Writer, byte: u8, options: Options) -> bool {
    if byte == 10 {
        if options.showEnds && !emit(writer, 36) { return false }
        return emit(writer, 10)
    }
    if byte == 9 {
        if options.showTabs { return emit(writer, 94) && emit(writer, 73) }
        return emit(writer, byte)
    }
    if !options.showNonprinting { return emit(writer, byte) }
    if byte < 32 || byte == 127 { return emitControl(writer, byte) }
    if byte < 128 { return emit(writer, byte) }
    if !emit(writer, 77) || !emit(writer, 45) { return false }
    return emitControl(writer, byte & 127)
}

fn transformByte(writer: *Writer, state: *State, byte: u8, options: Options) -> bool {
    if state.*.atLineStart {
        const blank = byte == 10
        if blank && options.squeezeBlank && state.*.previousBlank { return true }
        state.*.previousBlank = blank
        if options.numberAll || options.numberNonblank && !blank {
            if !emitLineNumber(writer, state.*.line) { return false }
            state.*.line += 1
        }
        state.*.atLineStart = false
    }
    if !emitVisible(writer, byte, options) { return false }
    if byte == 10 { state.*.atLineStart = true }
    return true
}

fn copyTransformed(file: std.fs.File, writer: *Writer, state: *State, options: Options) -> bool {
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = true
    while true {
        const amount = std.fs.read(file, buffer, common.BUFFER_SIZE)
        if amount < 0 {
            success = false
            break
        }
        if amount == 0 { break }
        var index: usize = 0
        while index < @bitCast(usize, amount) {
            if !transformByte(writer, state, buffer[index], options) {
                success = false
                break
            }
            index += 1
        }
        if !success { break }
    }
    allocator.freeFn(allocator.context, buffer, common.BUFFER_SIZE, 8)
    return success
}

fn copyPath(path: std.string.String, writer: *Writer, state: *State, options: Options) -> bool {
    const file = if common.isDash(path) { std.io.stdin() } else { std.fs.open(path.pointer, std.fs.READ_ONLY, 0) }
    if !std.fs.isValid(file) {
        common.writeFileError("cat", path)
        return false
    }
    const copied = if transformed(options) { copyTransformed(file, writer, state, options) } else { std.fs.copy(file, std.io.stdout()) }
    const closed = if common.isDash(path) { true } else { std.fs.close(file) }
    if !copied { common.writeFileError("cat", path) }
    return copied && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: cat [OPTION]... [FILE]...\nConcatenate FILEs to standard output.\n  -A, --show-all  equivalent to -vET\n  -b, --number-nonblank  number nonempty lines\n  -E, --show-ends  display $ at line ends\n  -n, --number  number all lines\n  -s, --squeeze-blank  suppress repeated empty lines\n  -T, --show-tabs  display TAB as ^I\n  -v, --show-nonprinting  use ^ and M- notation\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx cat 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("cat", "invalid option")
        return 1
    }
    const allocator = std.page_allocator.init()
    const output = allocator.allocFn(allocator.context, common.BUFFER_SIZE, 8)
    if output == null { return 1 }
    var writer = Writer.{ .buffer = output.?, .length = 0, .capacity = common.BUFFER_SIZE }
    var state = State.{ .line = 1, .atLineStart = true, .previousBlank = false }
    const count = std.process.count(arguments)
    var index = options.firstFile
    var status: u8 = 0
    if index >= count && !copyPath(std.string.fromSlice("-"), &writer, &state, options) { status = 1 }
    while index < count {
        if !copyPath(std.process.argument(arguments, index), &writer, &state, options) { status = 1 }
        index += 1
    }
    if !flush(&writer) { status = 1 }
    allocator.freeFn(allocator.context, writer.buffer, writer.capacity, 8)
    return status
}
