const std = @import("std")
const common = @import("../common.mlx")

fn copyPath(path: std.string.String) -> bool {
    if common.isDash(path) { return common.copy(std.io.stdin(), std.io.stdout()) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("mlx-cat", path)
        return false
    }
    const copied = common.copy(file, std.io.stdout())
    const closed = std.fs.close(file)
    if !copied { common.writeFileError("mlx-cat", path) }
    return copied && closed
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    var index: usize = 1
    if index < count {
        const first = std.process.argument(arguments, index)
        if first.length == 2 && first.pointer[0] == 45 && first.pointer[1] == 45 { index += 1 }
    }
    if index >= count { return if common.copy(std.io.stdin(), std.io.stdout()) { 0 } else { 1 } }
    var status: u8 = 0
    while index < count {
        if !copyPath(std.process.argument(arguments, index)) { status = 1 }
        index += 1
    }
    return status
}
