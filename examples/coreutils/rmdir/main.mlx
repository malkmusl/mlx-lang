const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    parents: bool
    verbose: bool
    ignoreNonEmpty: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .parents = false, .verbose = false, .ignoreNonEmpty = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstOperand < count {
        const argument = std.process.argument(arguments, result.firstOperand)
        if common.equals(argument, "--") {
            result.firstOperand += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "--parents") { result.parents = true } else if common.equals(argument, "--verbose") { result.verbose = true } else if common.equals(argument, "--ignore-fail-on-non-empty") { result.ignoreNonEmpty = true } else if common.equals(argument, "--help") { result.action = 1 } else if common.equals(argument, "--version") { result.action = 2 } else if argument.pointer[1] != 45 {
            var index: usize = 1
            while index < argument.length {
                if argument.pointer[index] == 112 { result.parents = true } else if argument.pointer[index] == 118 { result.verbose = true } else { result.invalid = true }
                index += 1
            }
        } else { result.invalid = true }
        result.firstOperand += 1
    }
    return result
}

fn reportRemoval(path: std.string.String, verbose: bool) -> void {
    if !verbose { return }
    const first = std.io.print("rmdir: removing directory '")
    const second = std.io.printString(path)
    const third = std.io.print("'\n")
}

fn removeOne(path: std.string.String, options: Options) -> bool {
    reportRemoval(path, options.verbose)
    const result = std.fs.removeDirResult(path.pointer)
    return result == 0 || options.ignoreNonEmpty && result == -39
}

fn removeParents(path: std.string.String, options: Options) -> bool {
    const allocated = std.path.allocate(path)
    if allocated == null { return false }
    const mutable = allocated.?
    var end = mutable.length
    var success = true
    while end > 0 {
        while end > 1 && mutable.pointer[end - 1] == 47 { end -= 1 }
        mutable.pointer[end] = 0
        const current = std.string.fromParts(mutable.pointer, end)
        if !removeOne(current, options) {
            success = false
            break
        }
        while end > 0 && mutable.pointer[end - 1] != 47 { end -= 1 }
        while end > 1 && mutable.pointer[end - 1] == 47 { end -= 1 }
    }
    std.path.free(mutable)
    return success
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: mlx-rmdir [OPTION]... DIRECTORY...\n  -p, --parents    remove DIRECTORY and its ancestors\n  -v, --verbose    output a diagnostic for every directory processed\n      --ignore-fail-on-non-empty\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx rmdir 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstOperand >= count {
        common.writeMessage("rmdir", "missing or invalid operand")
        return 1
    }
    var status: u8 = 0
    var index = options.firstOperand
    while index < count {
        const path = std.process.argument(arguments, index)
        const removed = if options.parents { removeParents(path, options) } else { removeOne(path, options) }
        if !removed {
            common.writePathError("rmdir", "failed to remove", path)
            status = 1
        }
        index += 1
    }
    return status
}
