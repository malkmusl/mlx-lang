const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    noCreate: bool
    firstFile: usize
    action: u8
    invalid: bool
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .noCreate = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstFile < count {
        const argument = std.process.argument(arguments, result.firstFile)
        if common.equals(argument, "--") {
            result.firstFile += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "-c") || common.equals(argument, "--no-create") {
            result.noCreate = true
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else { result.invalid = true }
        result.firstFile += 1
    }
    return result
}

fn touchPath(path: std.string.String, no_create: bool) -> bool {
    var status: std.fs.Stat = undefined
    if std.fs.status(path.pointer, &status) < 0 {
        if no_create { return true }
        const file = std.fs.open(path.pointer, std.fs.WRITE_ONLY | std.fs.CREATE, 438)
        if !std.fs.isValid(file) { return false }
        if !std.fs.close(file) { return false }
    }
    return std.fs.updateTimes(path.pointer)
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: touch [OPTION]... FILE...\nUpdate access and modification times to the current time.\n  -c, --no-create  do not create files\n      --help       display this help and exit\n      --version    output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx touch 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstFile >= count {
        common.writeMessage("mlx-touch", "missing file operand or invalid option")
        return 1
    }
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !touchPath(path, options.noCreate) {
            common.writePathError("mlx-touch", "cannot touch", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
