const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    noCreate: bool
    noDereference: bool
    access: bool
    modify: bool
    timestamp: std.calendar.Timestamp
    explicitTime: bool
    reference: std.string.String
    referenceSet: bool
    firstFile: usize
    action: u8
    invalid: bool
}

const Times = struct {
    accessedSeconds: isize
    accessedNanoseconds: isize
    modifiedSeconds: isize
    modifiedNanoseconds: isize
    valid: bool
}

fn setDate(options: *Options, text: std.string.String, touch_format: bool) -> void {
    options.*.timestamp = if touch_format { std.calendar.parseTouch(text) } else { std.calendar.parseDate(text) }
    options.*.explicitTime = options.*.timestamp.valid
    if !options.*.explicitTime { options.*.invalid = true }
}

fn setSelection(options: *Options, text: std.string.String) -> bool {
    if common.equals(text, "access") || common.equals(text, "atime") || common.equals(text, "use") {
        options.*.access = true
    } else if common.equals(text, "modify") || common.equals(text, "mtime") {
        options.*.modify = true
    } else { return false }
    return true
}

fn optionValue(arguments: [][*]const u8, index: *usize, attached: std.string.String) -> ?std.string.String {
    if attached.length > 0 { return attached }
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const byte = argument.pointer[current]
        if byte == 97 { options.*.access = true } else if byte == 99 { options.*.noCreate = true } else if byte == 102 {
        } else if byte == 104 { options.*.noDereference = true } else if byte == 109 { options.*.modify = true } else if byte == 100 || byte == 114 || byte == 116 {
            const value = optionValue(arguments, index, std.string.slice(argument, current + 1, argument.length))
            if value == null { return false }
            if byte == 100 { setDate(options, value.?, false) } else if byte == 116 { setDate(options, value.?, true) } else {
                options.*.reference = value.?
                options.*.referenceSet = true
            }
            return true
        } else { return false }
        current += 1
    }
    return true
}

fn requiredLongValue(arguments: [][*]const u8, index: *usize) -> ?std.string.String {
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn parseLongWithEquals(argument: std.string.String, options: *Options) -> bool {
    if std.string.startsWith(argument, std.string.fromSlice("--date=")) {
        setDate(options, std.string.slice(argument, 7, argument.length), false)
    } else if std.string.startsWith(argument, std.string.fromSlice("--reference=")) {
        options.*.reference = std.string.slice(argument, 12, argument.length)
        options.*.referenceSet = options.*.reference.length > 0
    } else if std.string.startsWith(argument, std.string.fromSlice("--time=")) {
        return setSelection(options, std.string.slice(argument, 7, argument.length))
    } else { return false }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--no-create") { options.*.noCreate = true } else if common.equals(argument, "--no-dereference") {
        options.*.noDereference = true
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") {
        options.*.action = 2
    } else if common.equals(argument, "--date") || common.equals(argument, "--reference") || common.equals(argument, "--time") {
        const value = requiredLongValue(arguments, index)
        if value == null { return false }
        if argument.pointer[2] == 100 { setDate(options, value.?, false) } else if argument.pointer[2] == 114 {
            options.*.reference = value.?
            options.*.referenceSet = true
        } else { return setSelection(options, value.?) }
    } else { return parseLongWithEquals(argument, options) }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .noCreate = false, .noDereference = false, .access = false, .modify = false, .timestamp = std.calendar.Timestamp.{ .seconds = 0, .nanoseconds = 0, .valid = false }, .explicitTime = false, .reference = std.string.fromSlice(""), .referenceSet = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    if !result.access && !result.modify {
        result.access = true
        result.modify = true
    }
    result.firstFile = index
    return result
}

fn sourceTimes(options: Options) -> Times {
    if options.explicitTime {
        return Times.{ .accessedSeconds = options.timestamp.seconds, .accessedNanoseconds = options.timestamp.nanoseconds, .modifiedSeconds = options.timestamp.seconds, .modifiedNanoseconds = options.timestamp.nanoseconds, .valid = true }
    }
    if options.referenceSet {
        var status: std.fs.Stat = undefined
        if std.fs.statusAt(options.reference.pointer, &status, options.noDereference) != 0 {
            return Times.{ .accessedSeconds = 0, .accessedNanoseconds = 0, .modifiedSeconds = 0, .modifiedNanoseconds = 0, .valid = false }
        }
        return Times.{ .accessedSeconds = status.accessedSeconds, .accessedNanoseconds = status.accessedNanoseconds, .modifiedSeconds = status.modifiedSeconds, .modifiedNanoseconds = status.modifiedNanoseconds, .valid = true }
    }
    return Times.{ .accessedSeconds = 0, .accessedNanoseconds = std.fs.UTIME_NOW, .modifiedSeconds = 0, .modifiedNanoseconds = std.fs.UTIME_NOW, .valid = true }
}

fn selectedTimes(options: Options, source: Times) -> Times {
    return Times.{
        .accessedSeconds = if options.access { source.accessedSeconds } else { 0 },
        .accessedNanoseconds = if options.access { source.accessedNanoseconds } else { std.fs.UTIME_OMIT },
        .modifiedSeconds = if options.modify { source.modifiedSeconds } else { 0 },
        .modifiedNanoseconds = if options.modify { source.modifiedNanoseconds } else { std.fs.UTIME_OMIT },
        .valid = source.valid,
    }
}

fn createMissing(path: std.string.String) -> bool {
    const file = std.fs.open(path.pointer, std.fs.WRITE_ONLY | std.fs.CREATE, 438)
    if !std.fs.isValid(file) { return false }
    return std.fs.close(file)
}

fn touchPath(path: std.string.String, options: Options, times: *Times) -> bool {
    if common.equals(path, "-") {
        return std.fs.setDescriptorTimes(std.io.stdout(), times.*.accessedSeconds, times.*.accessedNanoseconds, times.*.modifiedSeconds, times.*.modifiedNanoseconds)
    }
    var status: std.fs.Stat = undefined
    const exists = std.fs.statusAt(path.pointer, &status, options.noDereference) == 0
    if !exists {
        if options.noCreate { return true }
        if options.noDereference || !createMissing(path) { return false }
    }
    return std.fs.setTimes(path.pointer, times.*.accessedSeconds, times.*.accessedNanoseconds, times.*.modifiedSeconds, times.*.modifiedNanoseconds, options.noDereference)
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: touch [OPTION]... FILE...\n  -a  change only access time\n  -c, --no-create  do not create files\n  -d, --date=STRING  parse and use STRING\n  -f  ignored for compatibility\n  -h, --no-dereference  affect symbolic links\n  -m  change only modification time\n  -r, --reference=FILE  copy FILE times\n  -t STAMP  use [[CC]YY]MMDDhhmm[.ss]\n      --time=WORD  select access or modification time\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx touch 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    var times = selectedTimes(options, sourceTimes(options))
    if options.invalid || options.firstFile >= count || !times.valid {
        common.writeMessage("touch", "missing file operand, invalid time, or invalid option")
        return 1
    }
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !touchPath(path, options, &times) {
            common.writePathError("touch", "cannot touch", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
