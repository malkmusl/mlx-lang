const std = @import("std")
const common = @import("../common.mlx")

const Size = struct {
    value: usize
    valid: bool
}

const Options = struct {
    size: usize
    sizeSet: bool
    noCreate: bool
    firstFile: usize
    action: u8
    invalid: bool
}

fn suffixMultiplier(byte: u8) -> usize {
    if byte == 75 || byte == 107 { return 1024 }
    if byte == 77 || byte == 109 { return 1048576 }
    if byte == 71 || byte == 103 { return 1073741824 }
    if byte == 84 || byte == 116 { return 1099511627776 }
    return 1
}

fn parseSize(text: std.string.String) -> Size {
    if text.length == 0 { return Size.{ .value = 0, .valid = false } }
    var end = text.length
    var multiplier: usize = 1
    const suffix = text.pointer[end - 1]
    if suffixMultiplier(suffix) != 1 {
        multiplier = suffixMultiplier(suffix)
        end -= 1
    }
    if end == 0 { return Size.{ .value = 0, .valid = false } }
    var value: usize = 0
    var index: usize = 0
    while index < end {
        const byte = text.pointer[index]
        if byte < 48 || byte > 57 { return Size.{ .value = 0, .valid = false } }
        const digit = @intCast(usize, byte - 48)
        if value > (18446744073709551615 - digit) / 10 { return Size.{ .value = 0, .valid = false } }
        value = value * 10 + digit
        index += 1
    }
    if value > 18446744073709551615 / multiplier { return Size.{ .value = 0, .valid = false } }
    return Size.{ .value = value * multiplier, .valid = true }
}

fn applySize(options: *Options, value: std.string.String) -> void {
    const parsed = parseSize(value)
    if !parsed.valid { options.*.invalid = true } else {
        options.*.size = parsed.value
        options.*.sizeSet = true
    }
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .size = 0, .sizeSet = false, .noCreate = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstFile < count {
        const argument = std.process.argument(arguments, result.firstFile)
        if common.equals(argument, "--") {
            result.firstFile += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "-c") || common.equals(argument, "--no-create") { result.noCreate = true } else if common.equals(argument, "-s") || common.equals(argument, "--size") {
            result.firstFile += 1
            if result.firstFile >= count { result.invalid = true } else { applySize(&result, std.process.argument(arguments, result.firstFile)) }
        } else if std.string.startsWith(argument, std.string.fromSlice("--size=")) {
            applySize(&result, std.string.slice(argument, 7, argument.length))
        } else if common.equals(argument, "--help") { result.action = 1 } else if common.equals(argument, "--version") {
            result.action = 2
        } else { result.invalid = true }
        result.firstFile += 1
    }
    return result
}

fn truncatePath(path: std.string.String, size: usize, no_create: bool) -> bool {
    var status: std.fs.Stat = undefined
    const exists = std.fs.status(path.pointer, &status) == 0
    if !exists && no_create { return true }
    const flags = std.fs.WRITE_ONLY | if no_create { 0 } else { std.fs.CREATE }
    const file = std.fs.open(path.pointer, flags, 438)
    if !std.fs.isValid(file) { return false }
    const resized = std.fs.truncate(file, size)
    const closed = std.fs.close(file)
    return resized && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: truncate OPTION... FILE...\nShrink or extend each FILE to the specified size.\n  -c, --no-create  do not create files\n  -s, --size=SIZE  set size; K, M, G, and T suffixes use powers of 1024\n      --help       display this help and exit\n      --version    output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx truncate 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || !options.sizeSet || options.firstFile >= count {
        common.writeMessage("mlx-truncate", "missing file or invalid size")
        return 1
    }
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !truncatePath(path, options.size, options.noCreate) {
            common.writePathError("mlx-truncate", "cannot truncate", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
