const std = @import("std")
const common = @import("../common.mlx")

const Size = struct {
    value: usize
    operation: u8
    valid: bool
}

const Value = struct {
    value: usize
    valid: bool
}

const Options = struct {
    size: Size
    sizeSet: bool
    noCreate: bool
    ioBlocks: bool
    reference: std.string.String
    referenceSet: bool
    firstFile: usize
    action: u8
    invalid: bool
}

fn operationFor(byte: u8) -> u8 {
    if byte == 43 { return 1 }
    if byte == 45 { return 2 }
    if byte == 60 { return 3 }
    if byte == 62 { return 4 }
    if byte == 47 { return 5 }
    if byte == 37 { return 6 }
    return 0
}

fn parseSize(text: std.string.String) -> Size {
    if text.length == 0 { return Size.{ .value = 0, .operation = 0, .valid = false } }
    const operation = operationFor(text.pointer[0])
    const start: usize = if operation == 0 { 0 } else { 1 }
    if start >= text.length { return Size.{ .value = 0, .operation = operation, .valid = false } }
    const parsed = std.parse.size(std.string.slice(text, start, text.length))
    return Size.{ .value = parsed.value, .operation = operation, .valid = parsed.valid && !parsed.negative && !parsed.positive }
}

fn setSize(options: *Options, text: std.string.String) -> void {
    options.*.size = parseSize(text)
    options.*.sizeSet = options.*.size.valid
    if !options.*.sizeSet { options.*.invalid = true }
}

fn setReference(options: *Options, text: std.string.String) -> void {
    options.*.reference = text
    options.*.referenceSet = text.length > 0
    if !options.*.referenceSet { options.*.invalid = true }
}

fn consumeValue(arguments: [][*]const u8, index: *usize, attached: std.string.String) -> ?std.string.String {
    if attached.length > 0 { return attached }
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const byte = argument.pointer[current]
        if byte == 99 { options.*.noCreate = true } else if byte == 111 { options.*.ioBlocks = true } else if byte == 114 || byte == 115 {
            const value = consumeValue(arguments, index, std.string.slice(argument, current + 1, argument.length))
            if value == null { return false }
            if byte == 114 { setReference(options, value.?) } else { setSize(options, value.?) }
            return true
        } else { return false }
        current += 1
    }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--no-create") { options.*.noCreate = true } else if common.equals(argument, "--io-blocks") {
        options.*.ioBlocks = true
    } else if std.string.startsWith(argument, std.string.fromSlice("--reference=")) {
        setReference(options, std.string.slice(argument, 12, argument.length))
    } else if std.string.startsWith(argument, std.string.fromSlice("--size=")) {
        setSize(options, std.string.slice(argument, 7, argument.length))
    } else if common.equals(argument, "--reference") || common.equals(argument, "--size") {
        index.* += 1
        if index.* >= std.process.count(arguments) { return false }
        const value = std.process.argument(arguments, index.*)
        if argument.pointer[2] == 114 { setReference(options, value) } else { setSize(options, value) }
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") {
        options.*.action = 2
    } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .size = Size.{ .value = 0, .operation = 0, .valid = false }, .sizeSet = false, .noCreate = false, .ioBlocks = false, .reference = std.string.fromSlice(""), .referenceSet = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    if result.referenceSet && result.sizeSet && result.size.operation == 0 { result.invalid = true }
    return result
}

fn multiplied(value: usize, multiplier: usize) -> Value {
    if multiplier > 0 && value > 18446744073709551615 / multiplier {
        return Value.{ .value = 0, .valid = false }
    }
    return Value.{ .value = value * multiplier, .valid = true }
}

fn targetSize(base: usize, amount: usize, operation: u8) -> Value {
    if operation == 0 { return Value.{ .value = amount, .valid = true } }
    if operation == 1 {
        if base > 18446744073709551615 - amount { return Value.{ .value = 0, .valid = false } }
        return Value.{ .value = base + amount, .valid = true }
    }
    if operation == 2 { return Value.{ .value = if amount >= base { 0 } else { base - amount }, .valid = true } }
    if operation == 3 { return Value.{ .value = if base < amount { base } else { amount }, .valid = true } }
    if operation == 4 { return Value.{ .value = if base > amount { base } else { amount }, .valid = true } }
    if amount == 0 { return Value.{ .value = 0, .valid = false } }
    if operation == 5 { return Value.{ .value = base - base % amount, .valid = true } }
    const remainder = base % amount
    if remainder == 0 { return Value.{ .value = base, .valid = true } }
    if base > 18446744073709551615 - (amount - remainder) { return Value.{ .value = 0, .valid = false } }
    return Value.{ .value = base + amount - remainder, .valid = true }
}

fn truncatePath(path: std.string.String, options: Options, reference_size: usize) -> bool {
    var status: std.fs.Stat = undefined
    const exists = std.fs.status(path.pointer, &status) == 0
    if !exists && options.noCreate { return true }
    const flags = std.fs.WRITE_ONLY | if options.noCreate { 0 } else { std.fs.CREATE }
    const file = std.fs.open(path.pointer, flags, 438)
    if !std.fs.isValid(file) { return false }
    if !exists && std.fs.fileStatus(file, &status) != 0 {
        const closed = std.fs.close(file)
        return false
    }
    const base = if options.referenceSet { reference_size } else { @bitCast(usize, status.size) }
    var amount = if options.sizeSet { options.size.value } else { reference_size }
    if options.ioBlocks {
        const scaled = multiplied(amount, @bitCast(usize, status.blockSize))
        if !scaled.valid {
            const closed = std.fs.close(file)
            return false
        }
        amount = scaled.value
    }
    const size = if options.sizeSet { targetSize(base, amount, options.size.operation) } else { Value.{ .value = reference_size, .valid = true } }
    const resized = size.valid && std.fs.truncate(file, size.value)
    const closed = std.fs.close(file)
    return resized && closed
}

fn referenceSize(options: Options) -> Value {
    if !options.referenceSet { return Value.{ .value = 0, .valid = true } }
    var status: std.fs.Stat = undefined
    if std.fs.status(options.reference.pointer, &status) != 0 || status.size < 0 {
        return Value.{ .value = 0, .valid = false }
    }
    return Value.{ .value = @bitCast(usize, status.size), .valid = true }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: truncate OPTION... FILE...\n  -c, --no-create  do not create files\n  -o, --io-blocks  treat SIZE as IO blocks\n  -r, --reference=FILE  base size on FILE\n  -s, --size=SIZE  set or adjust file size\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx truncate 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || !options.sizeSet && !options.referenceSet || options.firstFile >= count {
        common.writeMessage("truncate", "missing file or invalid size")
        return 1
    }
    const reference_size = referenceSize(options)
    if !reference_size.valid {
        common.writeFileError("truncate", options.reference)
        return 1
    }
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !truncatePath(path, options, reference_size.value) {
            common.writePathError("truncate", "cannot truncate", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
