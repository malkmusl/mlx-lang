const std = @import("std")

const CAPACITY: usize = 65536

const Database = struct {
    buffer: [*]u8
    length: usize
    valid: bool
}

pub const User = struct {
    id: u32
    group: u32
    valid: bool
    groupValid: bool
}

pub const Group = struct {
    id: u32
    valid: bool
}

pub const Spec = struct {
    user: u32
    group: u32
    userSet: bool
    groupSet: bool
    valid: bool
}

fn load(path: [*]const u8) -> Database {
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, CAPACITY, 8)
    if allocation == null { return Database.{ .buffer = undefined, .length = 0, .valid = false } }
    const buffer = allocation.?
    const file = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        allocator.freeFn(allocator.context, buffer, CAPACITY, 8)
        return Database.{ .buffer = undefined, .length = 0, .valid = false }
    }
    var length: usize = 0
    var valid = true
    while length < CAPACITY - 1 {
        var current: [*]u8 = undefined
        unsafe { current = @ptrFromInt([*]u8, @intFromPtr(buffer) + length) }
        const amount = std.fs.read(file, current, CAPACITY - 1 - length)
        if amount < 0 {
            valid = false
            break
        }
        if amount == 0 { break }
        length += @bitCast(usize, amount)
    }
    const closed = std.fs.close(file)
    if !valid || !closed {
        allocator.freeFn(allocator.context, buffer, CAPACITY, 8)
        return Database.{ .buffer = undefined, .length = 0, .valid = false }
    }
    buffer[length] = 0
    return Database.{ .buffer = buffer, .length = length, .valid = true }
}

fn unload(database: Database) -> void {
    if !database.valid { return }
    const allocator = std.page_allocator.init()
    allocator.freeFn(allocator.context, database.buffer, CAPACITY, 8)
}

fn parseNumber(value: std.string.String) -> ?u32 {
    if value.length == 0 { return null }
    var index: usize = if value.pointer[0] == 43 { 1 } else { 0 }
    if index == value.length { return null }
    var result: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        if byte < 48 || byte > 57 { return null }
        result = result * 10 + @intCast(usize, byte - 48)
        if result >= 4294967295 { return null }
        index += 1
    }
    return @intCast(u32, result)
}

fn nextField(line: std.string.String, index: *usize) -> std.string.String {
    const start = index.*
    while index.* < line.length && line.pointer[index.*] != 58 { index.* += 1 }
    const result = std.string.slice(line, start, index.*)
    if index.* < line.length { index.* += 1 }
    return result
}

fn namesEqual(left: std.string.String, right: std.string.String) -> bool {
    return std.string.eql(left, right)
}

fn userFromLine(line: std.string.String, requested: std.string.String, by_id: bool, requested_id: u32) -> User {
    var index: usize = 0
    const name = nextField(line, &index)
    const password = nextField(line, &index)
    const id_text = nextField(line, &index)
    const group_text = nextField(line, &index)
    const id = parseNumber(id_text)
    const group = parseNumber(group_text)
    if id == null || group == null { return User.{ .id = 0, .group = 0, .valid = false, .groupValid = false } }
    const matches = if by_id { id.? == requested_id } else { namesEqual(name, requested) }
    return User.{ .id = id.?, .group = group.?, .valid = matches, .groupValid = matches }
}

fn findUser(requested: std.string.String, by_id: bool, requested_id: u32) -> User {
    const database = load(@ptrCast([*]const u8, "/etc/passwd"))
    if !database.valid { return User.{ .id = 0, .group = 0, .valid = false, .groupValid = false } }
    var result = User.{ .id = 0, .group = 0, .valid = false, .groupValid = false }
    var start: usize = 0
    while start < database.length && !result.valid {
        var end = start
        while end < database.length && database.buffer[end] != 10 { end += 1 }
        var pointer: [*]const u8 = undefined
        unsafe { pointer = @ptrFromInt([*]const u8, @intFromPtr(database.buffer) + start) }
        result = userFromLine(std.string.fromParts(pointer, end - start), requested, by_id, requested_id)
        start = end + 1
    }
    unload(database)
    return result
}

pub fn resolveUser(value: std.string.String) -> User {
    const numeric = parseNumber(value)
    if numeric == null { return findUser(value, false, 0) }
    const found = findUser(value, true, numeric.?)
    if found.valid { return found }
    return User.{ .id = numeric.?, .group = 0, .valid = true, .groupValid = false }
}

fn groupFromLine(line: std.string.String, requested: std.string.String) -> Group {
    var index: usize = 0
    const name = nextField(line, &index)
    const password = nextField(line, &index)
    const id = parseNumber(nextField(line, &index))
    return Group.{ .id = if id == null { 0 } else { id.? }, .valid = id != null && namesEqual(name, requested) }
}

pub fn resolveGroup(value: std.string.String) -> Group {
    const numeric = parseNumber(value)
    if numeric != null { return Group.{ .id = numeric.?, .valid = true } }
    const database = load(@ptrCast([*]const u8, "/etc/group"))
    if !database.valid { return Group.{ .id = 0, .valid = false } }
    var result = Group.{ .id = 0, .valid = false }
    var start: usize = 0
    while start < database.length && !result.valid {
        var end = start
        while end < database.length && database.buffer[end] != 10 { end += 1 }
        var pointer: [*]const u8 = undefined
        unsafe { pointer = @ptrFromInt([*]const u8, @intFromPtr(database.buffer) + start) }
        result = groupFromLine(std.string.fromParts(pointer, end - start), value)
        start = end + 1
    }
    unload(database)
    return result
}

fn separator(value: std.string.String) -> usize {
    var index: usize = 0
    while index < value.length {
        if value.pointer[index] == 58 { return index }
        index += 1
    }
    index = 0
    while index < value.length {
        if value.pointer[index] == 46 { return index }
        index += 1
    }
    return value.length
}

pub fn parseSpec(value: std.string.String, group_only: bool) -> Spec {
    var result = Spec.{ .user = 0, .group = 0, .userSet = false, .groupSet = false, .valid = true }
    if group_only {
        const group = resolveGroup(value)
        result.group = group.id
        result.groupSet = group.valid
        result.valid = group.valid
        return result
    }
    var has_colon = false
    var scan: usize = 0
    while scan < value.length {
        if value.pointer[scan] == 58 { has_colon = true }
        scan += 1
    }
    if !has_colon {
        const whole_user = resolveUser(value)
        if whole_user.valid {
            result.user = whole_user.id
            result.userSet = true
            return result
        }
    }
    const split = separator(value)
    const owner_text = std.string.slice(value, 0, split)
    const group_text = if split < value.length { std.string.slice(value, split + 1, value.length) } else { std.string.fromSlice("") }
    var user = User.{ .id = 0, .group = 0, .valid = false, .groupValid = false }
    if owner_text.length > 0 {
        user = resolveUser(owner_text)
        result.user = user.id
        result.userSet = user.valid
        result.valid = user.valid
    }
    if split < value.length && group_text.length > 0 {
        const group = resolveGroup(group_text)
        result.group = group.id
        result.groupSet = group.valid
        result.valid = result.valid && group.valid
    } else if split < value.length && owner_text.length > 0 {
        result.group = user.group
        result.groupSet = user.groupValid
        result.valid = result.valid && user.groupValid
    }
    return result
}
