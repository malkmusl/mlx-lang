const std = @import("std")
const common = @import("../common.mlx")
const accounts = @import("./accounts.mlx")

pub const Options = struct {
    program: std.string.String
    target: accounts.Spec
    filter: accounts.Spec
    filterSet: bool
    recursive: bool
    noDereference: bool
    traversalMode: u8
    preserveRoot: bool
    report: u8
    silent: bool
}

fn isDirectory(status: std.fs.Stat) -> bool { return status.mode & 61440 == 16384 }
fn isSymbolicLink(status: std.fs.Stat) -> bool { return status.mode & 61440 == 40960 }

fn isDotEntry(name: std.string.String) -> bool {
    if name.length == 1 { return name.pointer[0] == 46 }
    return name.length == 2 && name.pointer[0] == 46 && name.pointer[1] == 46
}

fn entryName(buffer: [*]u8, offset: usize, record_length: usize) -> std.string.String {
    var length: usize = 0
    while 19 + length < record_length && buffer[offset + 19 + length] != 0 { length += 1 }
    unsafe { return std.string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(buffer) + offset + 19), length) }
}

fn matches(status: std.fs.Stat, options: Options) -> bool {
    if !options.filterSet { return true }
    if options.filter.userSet && status.user != options.filter.user { return false }
    return !options.filter.groupSet || status.group == options.filter.group
}

fn changed(status: std.fs.Stat, options: Options) -> bool {
    if options.target.userSet && status.user != options.target.user { return true }
    return options.target.groupSet && status.group != options.target.group
}

fn report(path: std.string.String, did_change: bool, options: Options) -> void {
    if options.report == 0 || options.report == 1 && !did_change { return }
    const first = std.io.print(if did_change { "ownership changed for '" } else { "ownership retained for '" })
    const second = std.io.printString(path)
    const third = std.io.print("'\n")
}

fn reportError(path: std.string.String, options: Options) -> void {
    if options.silent { return }
    const first = std.io.writeString(std.io.stderr(), options.program)
    const second = std.io.eprint(": cannot change ownership of '")
    const third = std.io.writeString(std.io.stderr(), path)
    const fourth = std.io.eprint("'\n")
}

fn targetUser(options: Options) -> usize {
    return if options.target.userSet { @intCast(usize, options.target.user) } else { 18446744073709551615 }
}

fn targetGroup(options: Options) -> usize {
    return if options.target.groupSet { @intCast(usize, options.target.group) } else { 18446744073709551615 }
}

fn applyAt(directory: std.fs.File, name: std.string.String, path: std.string.String, status: std.fs.Stat, no_follow: bool, options: Options) -> bool {
    if !matches(status, options) {
        report(path, false, options)
        return true
    }
    const did_change = changed(status, options)
    if !std.fs.changeOwnerAt(directory, name.pointer, targetUser(options), targetGroup(options), no_follow) { return false }
    report(path, did_change, options)
    return true
}

fn changeDirectoryContents(directory: std.fs.File, path: std.string.String, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = true
    while true {
        const amount = std.fs.readDirectory(directory, buffer, common.BUFFER_SIZE)
        if amount < 0 {
            success = false
            break
        }
        if amount == 0 { break }
        var offset: usize = 0
        const length = @bitCast(usize, amount)
        while offset < length {
            const record_length = @intCast(usize, std.mem.readU16Little(buffer, offset + 16))
            if record_length < 20 || offset + record_length > length {
                success = false
                break
            }
            const name = entryName(buffer, offset, record_length)
            if !isDotEntry(name) && !changeEntry(directory, name, path, options) { success = false }
            offset += record_length
        }
    }
    allocator.free(buffer, common.BUFFER_SIZE, 8)
    return success
}

fn changeDirectoryAt(parent: std.fs.File, name: std.string.String, path: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    const directory = std.fs.openAt(parent, name.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY | std.fs.NO_FOLLOW, 0)
    if !std.fs.isValid(directory) { return false }
    const ownership_changed = applyAt(parent, name, path, status, false, options)
    const traversed = ownership_changed && changeDirectoryContents(directory, path, options)
    const closed = std.fs.close(directory)
    return ownership_changed && traversed && closed
}

fn changeEntry(parent: std.fs.File, name: std.string.String, parent_path: std.string.String, options: Options) -> bool {
    const joined = std.path.join(parent_path, name)
    if joined == null { return false }
    const owned = joined.?
    const path = std.string.fromParts(owned.pointer, owned.length)
    var status: std.fs.Stat = undefined
    const status_result = std.fs.statusFrom(parent, name.pointer, &status, true)
    var succeeded = false
    if status_result == 0 && isDirectory(status) {
        succeeded = changeDirectoryAt(parent, name, path, status, options)
    } else if status_result == 0 {
        succeeded = applyAt(parent, name, path, status, isSymbolicLink(status), options)
    }
    if !succeeded { reportError(path, options) }
    std.path.free(owned)
    return succeeded
}

fn isRoot(status: std.fs.Stat) -> bool {
    var root: std.fs.Stat = undefined
    unsafe {
        return std.fs.status(@ptrCast([*]const u8, "/"), &root) == 0 && root.device == status.device && root.inode == status.inode
    }
}

fn applyTop(path: std.string.String, status: std.fs.Stat, no_follow: bool, options: Options) -> bool {
    if !matches(status, options) {
        report(path, false, options)
        return true
    }
    const did_change = changed(status, options)
    if !std.fs.changeOwner(path.pointer, targetUser(options), targetGroup(options), no_follow) { return false }
    report(path, did_change, options)
    return true
}

fn changeTopDirectory(path: std.string.String, status: std.fs.Stat, follow_link: bool, options: Options) -> bool {
    if options.preserveRoot && isRoot(status) { return false }
    const flags = std.fs.READ_ONLY | std.fs.DIRECTORY | if follow_link { 0 } else { std.fs.NO_FOLLOW }
    const directory = std.fs.open(path.pointer, flags, 0)
    if !std.fs.isValid(directory) { return false }
    const ownership_changed = applyTop(path, status, false, options)
    const traversed = ownership_changed && changeDirectoryContents(directory, path, options)
    const closed = std.fs.close(directory)
    return ownership_changed && traversed && closed
}

pub fn change(path: std.string.String, options: Options) -> bool {
    var direct: std.fs.Stat = undefined
    if std.fs.statusAt(path.pointer, &direct, true) != 0 {
        reportError(path, options)
        return false
    }
    if isSymbolicLink(direct) && options.recursive && options.traversalMode == 2 {
        const succeeded = applyTop(path, direct, true, options)
        if !succeeded { reportError(path, options) }
        return succeeded
    }
    var status = direct
    const follows = isSymbolicLink(direct) && !options.noDereference
    if follows && std.fs.status(path.pointer, &status) != 0 {
        reportError(path, options)
        return false
    }
    const succeeded = if options.recursive && isDirectory(status) { changeTopDirectory(path, status, follows, options) } else { applyTop(path, status, options.noDereference && isSymbolicLink(direct), options) }
    if !succeeded { reportError(path, options) }
    return succeeded
}
