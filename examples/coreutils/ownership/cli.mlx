const std = @import("std")
const common = @import("../common.mlx")
const accounts = @import("./accounts.mlx")
const traversal = @import("./traversal.mlx")

const Options = struct {
    recursive: bool
    noDereference: bool
    traversalMode: u8
    preserveRoot: bool
    report: u8
    silent: bool
    reference: std.string.String
    referenceSet: bool
    from: std.string.String
    fromSet: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn parseShort(argument: std.string.String, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        const byte = argument.pointer[index]
        if byte == 99 { options.*.report = 1 } else if byte == 102 { options.*.silent = true } else if byte == 118 {
            options.*.report = 2
        } else if byte == 104 { options.*.noDereference = true } else if byte == 82 { options.*.recursive = true } else if byte == 72 {
            options.*.traversalMode = 0
        } else if byte == 76 { options.*.traversalMode = 1 } else if byte == 80 { options.*.traversalMode = 2 } else { return false }
        index += 1
    }
    return true
}

fn consumeValue(arguments: [][*]const u8, index: *usize, attached: std.string.String) -> ?std.string.String {
    if attached.length > 0 { return attached }
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn setNamedValue(arguments: [][*]const u8, index: *usize, attached: std.string.String, reference: bool, options: *Options) -> bool {
    const value = consumeValue(arguments, index, attached)
    if value == null { return false }
    if reference {
        options.*.reference = value.?
        options.*.referenceSet = true
    } else {
        options.*.from = value.?
        options.*.fromSet = true
    }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--changes") { options.*.report = 1 } else if common.equals(argument, "--silent") || common.equals(argument, "--quiet") {
        options.*.silent = true
    } else if common.equals(argument, "--verbose") { options.*.report = 2 } else if common.equals(argument, "--dereference") { options.*.noDereference = false } else if common.equals(argument, "--no-dereference") {
        options.*.noDereference = true
    } else if common.equals(argument, "--recursive") { options.*.recursive = true } else if common.equals(argument, "--preserve-root") { options.*.preserveRoot = true } else if common.equals(argument, "--no-preserve-root") {
        options.*.preserveRoot = false
    } else if common.equals(argument, "--reference") { return setNamedValue(arguments, index, std.string.fromSlice(""), true, options) } else if std.string.startsWith(argument, std.string.fromSlice("--reference=")) {
        const value = std.string.slice(argument, 12, argument.length)
        if value.length == 0 { return false }
        return setNamedValue(arguments, index, value, true, options)
    } else if common.equals(argument, "--from") { return setNamedValue(arguments, index, std.string.fromSlice(""), false, options) } else if std.string.startsWith(argument, std.string.fromSlice("--from=")) {
        const value = std.string.slice(argument, 7, argument.length)
        if value.length == 0 { return false }
        return setNamedValue(arguments, index, value, false, options)
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") { options.*.action = 2 } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .recursive = false, .noDereference = false, .traversalMode = 2, .preserveRoot = false, .report = 0, .silent = false, .reference = std.string.fromSlice(""), .referenceSet = false, .from = std.string.fromSlice(""), .fromSet = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn referenceSpec(path: std.string.String) -> accounts.Spec {
    var status: std.fs.Stat = undefined
    if std.fs.status(path.pointer, &status) != 0 { return accounts.Spec.{ .user = 0, .group = 0, .userSet = false, .groupSet = false, .valid = false } }
    return accounts.Spec.{ .user = status.user, .group = status.group, .userSet = true, .groupSet = true, .valid = true }
}

fn makeSettings(options: Options, program: std.string.String, target: accounts.Spec, filter: accounts.Spec) -> traversal.Options {
    return traversal.Options.{ .program = program, .target = target, .filter = filter, .filterSet = options.fromSet, .recursive = options.recursive, .noDereference = options.noDereference, .traversalMode = options.traversalMode, .preserveRoot = options.preserveRoot, .report = options.report, .silent = options.silent }
}

fn printHelp(group_only: bool) -> u8 {
    const usage = if group_only { "Usage: chgrp [OPTION]... GROUP FILE...\n" } else { "Usage: chown [OPTION]... [OWNER][:[GROUP]] FILE...\n" }
    if !std.io.print(usage) { return 1 }
    return if std.io.print("  -c, --changes\n  -f, --silent, --quiet\n  -h, --no-dereference\n  -v, --verbose\n  -R, --recursive\n  -H, -L, -P\n      --from=OWNER:GROUP\n      --reference=FILE\n      --[no-]preserve-root\n") { 0 } else { 1 }
}

pub fn run(arguments: [][*]const u8, group_only: bool) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp(group_only) }
    if options.action == 2 { return if std.io.print(if group_only { "mlx chgrp 0.1.0\n" } else { "mlx chown 0.1.0\n" }) { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.recursive && options.traversalMode == 1 {
        common.writeMessage(if group_only { "mlx-chgrp" } else { "mlx-chown" }, "invalid or unsafe option combination")
        return 1
    }
    const owner_index = options.firstOperand
    const file_index = if options.referenceSet { owner_index } else { owner_index + 1 }
    if file_index >= count {
        common.writeMessage(if group_only { "mlx-chgrp" } else { "mlx-chown" }, "missing ownership or file operand")
        return 1
    }
    const target = if options.referenceSet { referenceSpec(options.reference) } else { accounts.parseSpec(std.process.argument(arguments, owner_index), group_only) }
    const filter = if options.fromSet { accounts.parseSpec(options.from, false) } else { accounts.Spec.{ .user = 0, .group = 0, .userSet = false, .groupSet = false, .valid = true } }
    if !target.valid || !filter.valid {
        common.writeMessage(if group_only { "mlx-chgrp" } else { "mlx-chown" }, "invalid user or group")
        return 1
    }
    const program = std.string.fromSlice(if group_only { "mlx-chgrp" } else { "mlx-chown" })
    const settings = makeSettings(options, program, target, filter)
    var success = true
    var index = file_index
    while index < count {
        if !traversal.change(std.process.argument(arguments, index), settings) { success = false }
        index += 1
    }
    return if success { 0 } else { 1 }
}
