const std = @import("std")
const common = @import("../common.mlx")

const MAX_KEYS: usize = 32

const KeySpec = struct {
    startField: usize
    startChar: usize
    endField: usize
    hasEnd: bool
    endChar: usize
    numeric: bool
    general: bool
    reverse: bool
    foldCase: bool
    ignoreBlanks: bool
    hasOpts: bool
}

const Options = struct {
    keys: [32]KeySpec
    keyCount: usize
    reverse: bool
    unique: bool
    numeric: bool
    general: bool
    foldCase: bool
    ignoreBlanks: bool
    check: bool
    checkQuiet: bool
    merge: bool
    stable: bool
    zero: bool
    hasSeparator: bool
    separator: u8
    hasOutput: bool
    outputPath: std.string.String
    action: u8
    invalid: bool
    firstFile: usize
}

fn zeroKey() -> KeySpec {
    return KeySpec.{
        .startField = 1, .startChar = 0, .endField = 0, .hasEnd = false, .endChar = 0,
        .numeric = false, .general = false, .reverse = false, .foldCase = false, .ignoreBlanks = false, .hasOpts = false,
    }
}

fn defaultKeys() -> [32]KeySpec {
    var result: [32]KeySpec = undefined
    var i: usize = 0
    while i < MAX_KEYS {
        result[i] = zeroKey()
        i += 1
    }
    return result
}

fn isBlank(byte: u8) -> bool { return byte == 32 || byte == 9 }

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn parseFieldSpec(text: std.string.String, at: usize, field: *usize, hasChar: *bool, char: *usize) -> usize {
    var i = at
    var f: usize = 0
    while i < text.length && isDigit(text.pointer[i]) {
        f = f * 10 + @intCast(usize, text.pointer[i] - 48)
        i += 1
    }
    field.* = f
    hasChar.* = false
    char.* = 0
    if i < text.length && text.pointer[i] == 46 {
        i += 1
        var c: usize = 0
        while i < text.length && isDigit(text.pointer[i]) {
            c = c * 10 + @intCast(usize, text.pointer[i] - 48)
            i += 1
        }
        hasChar.* = true
        char.* = c
    }
    return i
}

fn applyOptLetter(byte: u8, key: *KeySpec) -> bool {
    if byte == 110 {
        key.*.numeric = true
        key.*.hasOpts = true
        return true
    }
    if byte == 103 {
        key.*.general = true
        key.*.hasOpts = true
        return true
    }
    if byte == 114 {
        key.*.reverse = true
        key.*.hasOpts = true
        return true
    }
    if byte == 102 {
        key.*.foldCase = true
        key.*.hasOpts = true
        return true
    }
    if byte == 98 {
        key.*.ignoreBlanks = true
        key.*.hasOpts = true
        return true
    }
    if byte == 100 || byte == 105 || byte == 77 || byte == 104 || byte == 82 || byte == 86 {
        key.*.hasOpts = true
        return true
    }
    return false
}

fn parseKeyDef(text: std.string.String, options: *Options) -> bool {
    if options.*.keyCount >= MAX_KEYS { return false }
    var key = zeroKey()
    var startField: usize = 0
    var hasStartChar = false
    var startChar: usize = 0
    var i = parseFieldSpec(text, 0, &startField, &hasStartChar, &startChar)
    if startField == 0 { return false }
    key.startField = startField
    key.startChar = if hasStartChar { startChar } else { 0 }
    while i < text.length && text.pointer[i] != 44 {
        if !applyOptLetter(text.pointer[i], &key) { return false }
        i += 1
    }
    if i < text.length && text.pointer[i] == 44 {
        i += 1
        var endField: usize = 0
        var hasEndChar = false
        var endChar: usize = 0
        i = parseFieldSpec(text, i, &endField, &hasEndChar, &endChar)
        if endField == 0 { return false }
        key.hasEnd = true
        key.endField = endField
        key.endChar = if hasEndChar { endChar } else { 0 }
        while i < text.length {
            if !applyOptLetter(text.pointer[i], &key) { return false }
            i += 1
        }
    }
    options.*.keys[options.*.keyCount] = key
    options.*.keyCount += 1
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .keys = defaultKeys(), .keyCount = 0,
        .reverse = false, .unique = false, .numeric = false, .general = false,
        .foldCase = false, .ignoreBlanks = false, .check = false, .checkQuiet = false,
        .merge = false, .stable = false, .zero = false,
        .hasSeparator = false, .separator = 0,
        .hasOutput = false, .outputPath = std.string.fromSlice(""),
        .action = 0, .invalid = false, .firstFile = 1,
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-r") || common.equals(argument, "--reverse") {
            result.reverse = true
            index += 1
            continue
        }
        if common.equals(argument, "-u") || common.equals(argument, "--unique") {
            result.unique = true
            index += 1
            continue
        }
        if common.equals(argument, "-n") || common.equals(argument, "--numeric-sort") {
            result.numeric = true
            index += 1
            continue
        }
        if common.equals(argument, "-g") || common.equals(argument, "--general-numeric-sort") {
            result.general = true
            index += 1
            continue
        }
        if common.equals(argument, "-f") || common.equals(argument, "--ignore-case") {
            result.foldCase = true
            index += 1
            continue
        }
        if common.equals(argument, "-b") || common.equals(argument, "--ignore-leading-blanks") {
            result.ignoreBlanks = true
            index += 1
            continue
        }
        if common.equals(argument, "-c") || common.equals(argument, "--check") {
            result.check = true
            index += 1
            continue
        }
        if common.equals(argument, "-C") {
            result.check = true
            result.checkQuiet = true
            index += 1
            continue
        }
        if common.equals(argument, "-m") || common.equals(argument, "--merge") {
            result.merge = true
            index += 1
            continue
        }
        if common.equals(argument, "-s") || common.equals(argument, "--stable") {
            result.stable = true
            index += 1
            continue
        }
        if common.equals(argument, "-z") || common.equals(argument, "--zero-terminated") {
            result.zero = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--field-separator=")) {
            const value = std.string.slice(argument, 19, argument.length)
            if value.length == 0 { result.invalid = true } else {
                result.hasSeparator = true
                result.separator = value.pointer[0]
            }
            index += 1
            continue
        }
        if common.equals(argument, "-t") || common.equals(argument, "--field-separator") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const value = std.process.argument(arguments, index)
            if value.length == 0 { result.invalid = true } else {
                result.hasSeparator = true
                result.separator = value.pointer[0]
            }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--key=")) {
            if !parseKeyDef(std.string.slice(argument, 6, argument.length), &result) { result.invalid = true }
            index += 1
            continue
        }
        if common.equals(argument, "-k") || common.equals(argument, "--key") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            if !parseKeyDef(std.process.argument(arguments, index), &result) { result.invalid = true }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--output=")) {
            result.hasOutput = true
            result.outputPath = std.string.slice(argument, 9, argument.length)
            index += 1
            continue
        }
        if common.equals(argument, "-o") || common.equals(argument, "--output") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            result.hasOutput = true
            result.outputPath = std.process.argument(arguments, index)
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 107 {
            if !parseKeyDef(std.string.slice(argument, 2, argument.length), &result) { result.invalid = true }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 116 {
            const value = std.string.slice(argument, 2, argument.length)
            result.hasSeparator = true
            result.separator = value.pointer[0]
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 111 {
            result.hasOutput = true
            result.outputPath = std.string.slice(argument, 2, argument.length)
            index += 1
            continue
        }
        var bundleOk = true
        var bundleIndex: usize = 1
        while bundleIndex < argument.length {
            const flag = argument.pointer[bundleIndex]
            if flag == 114 { result.reverse = true } else if flag == 117 {
                result.unique = true
            } else if flag == 110 {
                result.numeric = true
            } else if flag == 103 {
                result.general = true
            } else if flag == 102 {
                result.foldCase = true
            } else if flag == 98 {
                result.ignoreBlanks = true
            } else if flag == 99 {
                result.check = true
            } else if flag == 67 {
                result.check = true
                result.checkQuiet = true
            } else if flag == 109 {
                result.merge = true
            } else if flag == 115 {
                result.stable = true
            } else if flag == 122 {
                result.zero = true
            } else {
                bundleOk = false
            }
            bundleIndex += 1
        }
        if bundleOk {
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn fieldRange(line: [*]const u8, length: usize, fieldNum: usize, hasSep: bool, sep: u8, start_out: *usize, end_out: *usize) -> void {
    if !hasSep {
        var pos: usize = 0
        var field: usize = 1
        while field < fieldNum {
            while pos < length && !isBlank(line[pos]) { pos += 1 }
            while pos < length && isBlank(line[pos]) { pos += 1 }
            field += 1
        }
        const start = pos
        while pos < length && !isBlank(line[pos]) { pos += 1 }
        start_out.* = start
        end_out.* = pos
        return
    }
    var pos: usize = 0
    var field: usize = 1
    while field < fieldNum && pos < length {
        while pos < length && line[pos] != sep { pos += 1 }
        if pos < length { pos += 1 }
        field += 1
    }
    if field < fieldNum {
        start_out.* = length
        end_out.* = length
        return
    }
    const start = pos
    while pos < length && line[pos] != sep { pos += 1 }
    start_out.* = start
    end_out.* = pos
}

fn keyRange(line: [*]const u8, length: usize, key: KeySpec, options: Options, start_out: *usize, end_out: *usize) -> void {
    var fstart: usize = 0
    var fend: usize = 0
    fieldRange(line, length, key.startField, options.hasSeparator, options.separator, &fstart, &fend)
    var start = fstart
    if key.startChar > 0 {
        start = fstart + (key.startChar - 1)
        if start > length { start = length }
    } else {
        const ignoreBlanks = if key.hasOpts { key.ignoreBlanks } else { options.ignoreBlanks }
        if ignoreBlanks {
            while start < fend && isBlank(line[start]) { start += 1 }
        }
    }
    var end = length
    if key.hasEnd {
        var gstart: usize = 0
        var gend: usize = 0
        fieldRange(line, length, key.endField, options.hasSeparator, options.separator, &gstart, &gend)
        if key.endChar > 0 {
            end = gstart + key.endChar
            if end > length { end = length }
        } else {
            end = gend
        }
    }
    if end < start { end = start }
    start_out.* = start
    end_out.* = end
}

fn upperFold(byte: u8) -> u8 {
    if byte >= 97 && byte <= 122 { return byte - 32 }
    return byte
}

fn compareBytes(a: [*]const u8, as: usize, ae: usize, b: [*]const u8, bs: usize, be: usize, foldCase: bool) -> isize {
    const alen = ae - as
    const blen = be - bs
    const minLen = if alen < blen { alen } else { blen }
    var i: usize = 0
    while i < minLen {
        var ac = a[as + i]
        var bc = b[bs + i]
        if foldCase {
            ac = upperFold(ac)
            bc = upperFold(bc)
        }
        if ac != bc { return if ac < bc { -1 } else { 1 } }
        i += 1
    }
    if alen < blen { return -1 }
    if alen > blen { return 1 }
    return 0
}

fn skipBlanksIn(line: [*]const u8, start: usize, end: usize) -> usize {
    var i = start
    while i < end && isBlank(line[i]) { i += 1 }
    return i
}

fn stripLeadingZeros(line: [*]const u8, start: usize, end: usize) -> usize {
    if start >= end { return start }
    var i = start
    while i + 1 < end && line[i] == 48 { i += 1 }
    return i
}

fn numericCompare(a: [*]const u8, as: usize, ae: usize, b: [*]const u8, bs: usize, be: usize) -> isize {
    var ai = skipBlanksIn(a, as, ae)
    var bi = skipBlanksIn(b, bs, be)
    var aneg = false
    var bneg = false
    if ai < ae && (a[ai] == 45 || a[ai] == 43) {
        aneg = a[ai] == 45
        ai += 1
    }
    if bi < be && (b[bi] == 45 || b[bi] == 43) {
        bneg = b[bi] == 45
        bi += 1
    }
    const aIntStart = ai
    while ai < ae && isDigit(a[ai]) { ai += 1 }
    const aIntEnd = ai
    const bIntStart = bi
    while bi < be && isDigit(b[bi]) { bi += 1 }
    const bIntEnd = bi
    var aFracStart = ai
    var aFracEnd = ai
    if ai < ae && a[ai] == 46 {
        ai += 1
        aFracStart = ai
        while ai < ae && isDigit(a[ai]) { ai += 1 }
        aFracEnd = ai
    }
    var bFracStart = bi
    var bFracEnd = bi
    if bi < be && b[bi] == 46 {
        bi += 1
        bFracStart = bi
        while bi < be && isDigit(b[bi]) { bi += 1 }
        bFracEnd = bi
    }
    const aIntStripped = stripLeadingZeros(a, aIntStart, aIntEnd)
    const bIntStripped = stripLeadingZeros(b, bIntStart, bIntEnd)
    const aIntLen = aIntEnd - aIntStripped
    const bIntLen = bIntEnd - bIntStripped
    var magCmp: isize = 0
    if aIntLen != bIntLen {
        magCmp = if aIntLen < bIntLen { -1 } else { 1 }
    } else {
        magCmp = compareBytes(a, aIntStripped, aIntEnd, b, bIntStripped, bIntEnd, false)
    }
    if magCmp == 0 {
        const aFracLen = aFracEnd - aFracStart
        const bFracLen = bFracEnd - bFracStart
        const maxFracLen = if aFracLen > bFracLen { aFracLen } else { bFracLen }
        var i: usize = 0
        while i < maxFracLen && magCmp == 0 {
            const ad: u8 = if i < aFracLen { a[aFracStart + i] } else { 48 }
            const bd: u8 = if i < bFracLen { b[bFracStart + i] } else { 48 }
            if ad != bd { magCmp = if ad < bd { -1 } else { 1 } }
            i += 1
        }
    }
    if magCmp == 0 { return 0 }
    if aneg && !bneg { return -1 }
    if !aneg && bneg { return 1 }
    if aneg && bneg { return -magCmp }
    return magCmp
}

fn compareKeyEffective(a: [*]const u8, as: usize, ae: usize, b: [*]const u8, bs: usize, be: usize, numeric: bool, general: bool, foldCase: bool, ignoreBlanks: bool) -> isize {
    var astart = as
    var bstart = bs
    if ignoreBlanks {
        while astart < ae && isBlank(a[astart]) { astart += 1 }
        while bstart < be && isBlank(b[bstart]) { bstart += 1 }
    }
    if numeric || general { return numericCompare(a, astart, ae, b, bstart, be) }
    return compareBytes(a, astart, ae, b, bstart, be, foldCase)
}

fn compareLines(linePtr: [*][*]const u8, lineLen: [*]usize, ai: usize, bi: usize, options: Options, useFallback: bool) -> isize {
    const aPtr = linePtr[ai]
    const aLen = lineLen[ai]
    const bPtr = linePtr[bi]
    const bLen = lineLen[bi]
    if options.keyCount == 0 {
        var result = compareKeyEffective(aPtr, 0, aLen, bPtr, 0, bLen, options.numeric, options.general, options.foldCase, options.ignoreBlanks)
        if options.reverse { result = -result }
        return result
    }
    var result: isize = 0
    var i: usize = 0
    while i < options.keyCount && result == 0 {
        const key = options.keys[i]
        var as: usize = 0
        var ae: usize = 0
        var bs: usize = 0
        var be: usize = 0
        keyRange(aPtr, aLen, key, options, &as, &ae)
        keyRange(bPtr, bLen, key, options, &bs, &be)
        const numeric = if key.hasOpts { key.numeric } else { options.numeric }
        const general = if key.hasOpts { key.general } else { options.general }
        const foldCase = if key.hasOpts { key.foldCase } else { options.foldCase }
        var cmp = compareKeyEffective(aPtr, as, ae, bPtr, bs, be, numeric, general, foldCase, false)
        const keyReverse = if key.hasOpts { key.reverse } else { options.reverse }
        if keyReverse { cmp = -cmp }
        result = cmp
        i += 1
    }
    if result == 0 && useFallback {
        result = compareKeyEffective(aPtr, 0, aLen, bPtr, 0, bLen, false, false, options.foldCase, options.ignoreBlanks)
        if options.reverse { result = -result }
    }
    return result
}

fn merge(indices: [*]usize, temp: [*]usize, left: usize, mid: usize, right: usize, linePtr: [*][*]const u8, lineLen: [*]usize, options: Options) -> void {
    var i = left
    var j = mid
    var k = left
    while i < mid && j < right {
        const cmp = compareLines(linePtr, lineLen, indices[i], indices[j], options, !options.stable)
        if cmp <= 0 {
            temp[k] = indices[i]
            i += 1
        } else {
            temp[k] = indices[j]
            j += 1
        }
        k += 1
    }
    while i < mid {
        temp[k] = indices[i]
        i += 1
        k += 1
    }
    while j < right {
        temp[k] = indices[j]
        j += 1
        k += 1
    }
    var m = left
    while m < right {
        indices[m] = temp[m]
        m += 1
    }
}

fn mergeSort(indices: [*]usize, n: usize, temp: [*]usize, linePtr: [*][*]const u8, lineLen: [*]usize, options: Options) -> void {
    var width: usize = 1
    while width < n {
        var left: usize = 0
        while left < n {
            const mid = if left + width < n { left + width } else { n }
            const right = if left + 2 * width < n { left + 2 * width } else { n }
            if mid < right { merge(indices, temp, left, mid, right, linePtr, lineLen, options) }
            left += 2 * width
        }
        width *= 2
    }
}

fn openAndRead(path: std.string.String, ok: *bool) -> std.fs.ArrayList {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if common.isDash(path) {
        ok.* = true
        return std.fs.readToEndAlloc(std.io.stdin(), allocator)
    }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("sort", path)
        ok.* = false
        return std.array_list.ArrayList.init(allocator, 0)
    }
    ok.* = true
    const data = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return data
}

fn writeLine(file: std.fs.File, ptr: [*]const u8, length: usize, zero: bool) -> bool {
    if length > 0 {
        unsafe { if !std.io.writeAllBytes(file, ptr, length) { return false } }
    }
    return std.io.writeAll(file, if zero { "\0" } else { "\n" })
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: sort [OPTION]... [FILE]...\nWrite sorted concatenation of all FILE(s) to standard output.\n  -b, --ignore-leading-blanks  ignore leading blanks\n  -f, --ignore-case            fold lower case to upper case characters\n  -g, --general-numeric-sort   compare according to general numerical value\n  -n, --numeric-sort            compare according to string numerical value\n  -r, --reverse                 reverse the result of comparisons\n  -c, --check                   check for sorted input; do not sort\n  -k, --key=KEYDEF              sort via a key\n  -m, --merge                   merge already sorted files\n  -o, --output=FILE             write result to FILE instead of standard output\n  -s, --stable                  stabilize sort by disabling last-resort comparison\n  -t, --field-separator=SEP     use SEP instead of non-blank to blank transition\n  -u, --unique                  output only the first of an equal run\n  -z, --zero-terminated         line delimiter is NUL, not newline\n      --help        display this help and exit\n      --version     output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx sort 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("sort", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    const allocator: std.allocator.Allocator = std.page_allocator.init()

    var fileCount = if count > options.firstFile { count - options.firstFile } else { 0 }
    if fileCount == 0 { fileCount = 1 }

    const filePtrAlloc = allocator.alloc(fileCount * 8, 8)
    const fileLenAlloc = allocator.alloc(fileCount * 8, 8)
    var filePtr: [*][*]const u8 = undefined
    var fileLen: [*]usize = undefined
    unsafe {
        filePtr = @ptrCast([*][*]const u8, filePtrAlloc.?)
        fileLen = @ptrCast([*]usize, fileLenAlloc.?)
    }
    var status: u8 = 0
    var i: usize = 0
    while i < fileCount {
        const path = if count > options.firstFile { std.process.argument(arguments, options.firstFile + i) } else { std.string.fromSlice("-") }
        var opened = false
        const data = openAndRead(path, &opened)
        if !opened { status = 2 }
        unsafe { filePtr[i] = @ptrCast([*]const u8, data.items) }
        fileLen[i] = data.length
        i += 1
    }

    const terminator: u8 = if options.zero { 0 } else { 10 }
    var totalLines: usize = 0
    i = 0
    while i < fileCount {
        const ptr = filePtr[i]
        const len = fileLen[i]
        var j: usize = 0
        while j < len {
            if ptr[j] == terminator { totalLines += 1 }
            j += 1
        }
        if len > 0 && ptr[len - 1] != terminator { totalLines += 1 }
        i += 1
    }

    var linePtr: [*][*]const u8 = undefined
    var lineLen: [*]usize = undefined
    if totalLines > 0 {
        const linePtrAlloc = allocator.alloc(totalLines * 8, 8)
        const lineLenAlloc = allocator.alloc(totalLines * 8, 8)
        unsafe {
            linePtr = @ptrCast([*][*]const u8, linePtrAlloc.?)
            lineLen = @ptrCast([*]usize, lineLenAlloc.?)
        }
        var lineIdx: usize = 0
        i = 0
        while i < fileCount {
            const ptr = filePtr[i]
            const len = fileLen[i]
            var lineStart: usize = 0
            var j: usize = 0
            while j < len {
                if ptr[j] == terminator {
                    unsafe { linePtr[lineIdx] = @ptrFromInt([*]const u8, @intFromPtr(ptr) + lineStart) }
                    lineLen[lineIdx] = j - lineStart
                    lineIdx += 1
                    lineStart = j + 1
                }
                j += 1
            }
            if lineStart < len {
                unsafe { linePtr[lineIdx] = @ptrFromInt([*]const u8, @intFromPtr(ptr) + lineStart) }
                lineLen[lineIdx] = len - lineStart
                lineIdx += 1
            }
            i += 1
        }
    }

    if options.check {
        if status != 0 { return status }
        var ok = true
        var badLine: usize = 0
        var k: usize = 1
        while k < totalLines && ok {
            const cmp = compareLines(linePtr, lineLen, k - 1, k, options, !options.stable)
            if cmp > 0 || (options.unique && cmp == 0) {
                ok = false
                badLine = k
            }
            k += 1
        }
        if !ok && !options.checkQuiet {
            const w1 = std.io.print("sort: disorder at line ")
            const w2 = std.io.writeUnsigned(std.io.stdout(), badLine + 1)
            const w3 = std.io.print("\n")
        }
        return if ok { 0 } else { 1 }
    }

    var outputFile = std.io.stdout()
    var outputOpened = false
    if options.hasOutput {
        outputFile = std.fs.open(options.outputPath.pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
        if !std.fs.isValid(outputFile) {
            common.writeFileError("sort", options.outputPath)
            return 1
        }
        outputOpened = true
    }

    if totalLines > 0 {
        const indexAlloc = allocator.alloc(totalLines * 8, 8)
        const tempAlloc = allocator.alloc(totalLines * 8, 8)
        var indices: [*]usize = undefined
        var temp: [*]usize = undefined
        unsafe {
            indices = @ptrCast([*]usize, indexAlloc.?)
            temp = @ptrCast([*]usize, tempAlloc.?)
        }
        var idx: usize = 0
        while idx < totalLines {
            indices[idx] = idx
            idx += 1
        }
        mergeSort(indices, totalLines, temp, linePtr, lineLen, options)

        var ok = true
        var prevValid = false
        var prevIdx: usize = 0
        idx = 0
        while idx < totalLines && ok {
            const cur = indices[idx]
            var skip = false
            if options.unique && prevValid {
                if compareLines(linePtr, lineLen, prevIdx, cur, options, false) == 0 { skip = true }
            }
            if !skip {
                if !writeLine(outputFile, linePtr[cur], lineLen[cur], options.zero) { ok = false }
                prevIdx = cur
                prevValid = true
            }
            idx += 1
        }
        if !ok { status = 1 }
    }

    if outputOpened { const closed = std.fs.close(outputFile) }
    return status
}
