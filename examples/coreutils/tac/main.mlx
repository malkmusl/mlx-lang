const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    before: bool
    separator: std.string.String
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .before = false, .separator = std.string.fromSlice("\n"), .action = 0, .invalid = false, .firstFile = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-b") || common.equals(argument, "--before") {
            result.before = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--separator=")) {
            result.separator = std.string.slice(argument, 12, argument.length)
            index += 1
            continue
        }
        if common.equals(argument, "-s") || common.equals(argument, "--separator") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            result.separator = std.process.argument(arguments, index)
            index += 1
            continue
        }
        if argument.pointer[1] == 115 && argument.length > 2 {
            result.separator = std.string.slice(argument, 2, argument.length)
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn findNext(data: [*]const u8, length: usize, start: usize, separator: [*]const u8, sep_length: usize) -> isize {
    if sep_length == 0 || start + sep_length > length { return -1 }
    var i = start
    while i + sep_length <= length {
        var matched = true
        var j: usize = 0
        while j < sep_length {
            if data[i + j] != separator[j] {
                matched = false
                break
            }
            j += 1
        }
        if matched { return @bitCast(isize, i) }
        i += 1
    }
    return -1
}

fn countOccurrences(data: [*]const u8, length: usize, separator: [*]const u8, sep_length: usize) -> usize {
    var count: usize = 0
    var pos: usize = 0
    while true {
        const found = findNext(data, length, pos, separator, sep_length)
        if found < 0 { break }
        count += 1
        pos = @bitCast(usize, found) + sep_length
    }
    return count
}

fn processBuffer(data: [*]const u8, length: usize, separator: [*]const u8, sep_length: usize, before: bool) -> bool {
    if length == 0 { return true }
    const count = countOccurrences(data, length, separator, sep_length)
    if count == 0 {
        return std.io.writeAllBytes(std.io.stdout(), data, length)
    }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(count * 8, 8)
    if allocation == null { return false }
    var cuts: [*]usize = undefined
    unsafe { cuts = @ptrCast([*]usize, allocation.?) }
    var index: usize = 0
    var pos: usize = 0
    while index < count {
        const found = findNext(data, length, pos, separator, sep_length)
        const start = @bitCast(usize, found)
        cuts[index] = if before { start } else { start + sep_length }
        pos = start + sep_length
        index += 1
    }
    var ok = true
    var chunk_end = length
    var i: usize = count
    while i > 0 {
        i -= 1
        const chunk_start = cuts[i]
        if chunk_end > chunk_start {
            unsafe {
                if !std.io.writeAllBytes(std.io.stdout(), @ptrFromInt([*]const u8, @intFromPtr(data) + chunk_start), chunk_end - chunk_start) {
                    ok = false
                    break
                }
            }
        }
        chunk_end = chunk_start
    }
    if ok && chunk_end > 0 {
        ok = std.io.writeAllBytes(std.io.stdout(), data, chunk_end)
    }
    allocator.free(allocation.?, count * 8, 8)
    return ok
}

fn processFile(file: std.fs.File, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(file, allocator)
    var ok = true
    unsafe {
        ok = processBuffer(@ptrCast([*]const u8, data.items), data.length, @ptrCast([*]const u8, options.separator.pointer), options.separator.length, options.before)
    }
    data.deinit()
    return ok
}

fn processPath(path: std.string.String, options: Options) -> bool {
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("tac", path)
        return false
    }
    const processed = processFile(file, options)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("tac", path) }
    return processed && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: tac [OPTION]... [FILE]...\nWrite each FILE to standard output, last line first.\n  -b, --before             attach the separator before instead of after\n  -s, --separator=STRING   use STRING as the separator instead of newline\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx tac 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("tac", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    if options.firstFile >= count { return if processFile(std.io.stdin(), options) { 0 } else { 1 } }
    var status: u8 = 0
    var index = options.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), options) { status = 1 }
        index += 1
    }
    return status
}
