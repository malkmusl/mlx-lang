const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    mode: u8
    count: usize
    quiet: bool
    verbose: bool
    zero: bool
    firstFile: usize
    action: u8
    invalid: bool
}

const CountResult = struct {
    value: usize
    valid: bool
}

fn parseCount(text: std.string.String) -> CountResult {
    if text.length == 0 { return CountResult.{ .value = 0, .valid = false } }
    var value: usize = 0
    var index: usize = 0
    while index < text.length {
        const byte = text.pointer[index]
        if byte < 48 || byte > 57 { return CountResult.{ .value = 0, .valid = false } }
        const digit = @intCast(usize, byte - 48)
        if value > (18446744073709551615 - digit) / 10 { return CountResult.{ .value = 0, .valid = false } }
        value = value * 10 + digit
        index += 1
    }
    return CountResult.{ .value = value, .valid = true }
}

fn setCount(options: *Options, mode: u8, text: std.string.String) -> bool {
    const parsed = parseCount(text)
    if !parsed.valid { return false }
    options.*.mode = mode
    options.*.count = parsed.value
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--quiet") || common.equals(argument, "--silent") {
        options.*.quiet = true
        return true
    }
    if common.equals(argument, "--verbose") {
        options.*.verbose = true
        return true
    }
    if common.equals(argument, "--zero-terminated") {
        options.*.zero = true
        return true
    }
    if common.equals(argument, "--help") {
        options.*.action = 1
        return true
    }
    if common.equals(argument, "--version") {
        options.*.action = 2
        return true
    }
    if std.string.startsWith(argument, std.string.fromSlice("--lines=")) { return setCount(options, 0, std.string.slice(argument, 8, argument.length)) }
    if std.string.startsWith(argument, std.string.fromSlice("--bytes=")) { return setCount(options, 1, std.string.slice(argument, 8, argument.length)) }
    var mode: u8 = 0
    if common.equals(argument, "--lines") { mode = 0 } else if common.equals(argument, "--bytes") { mode = 1 } else { return false }
    index.* += 1
    if index.* >= std.process.count(arguments) { return false }
    return setCount(options, mode, std.process.argument(arguments, index.*))
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if argument.pointer[1] >= 48 && argument.pointer[1] <= 57 { return setCount(options, 0, std.string.slice(argument, 1, argument.length)) }
    var current: usize = 1
    while current < argument.length {
        const option = argument.pointer[current]
        if option == 113 { options.*.quiet = true } else if option == 118 { options.*.verbose = true } else if option == 122 {
            options.*.zero = true
        } else if option == 110 || option == 99 {
            var text = std.string.slice(argument, current + 1, argument.length)
            if text.length == 0 {
                index.* += 1
                if index.* >= std.process.count(arguments) { return false }
                text = std.process.argument(arguments, index.*)
            }
            return setCount(options, if option == 110 { 0 } else { 1 }, text)
        } else { return false }
        current += 1
    }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .mode = 0, .count = 10, .quiet = false, .verbose = false, .zero = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    return result
}

fn headBytes(file: std.fs.File, buffer: [*]u8, count: usize) -> bool {
    var remaining = count
    while remaining > 0 {
        const requested = if remaining < common.BUFFER_SIZE { remaining } else { common.BUFFER_SIZE }
        const amount = std.fs.read(file, buffer, requested)
        if amount < 0 { return false }
        if amount == 0 { return true }
        const length = @bitCast(usize, amount)
        unsafe { if !std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, buffer), length) { return false } }
        remaining -= length
    }
    return true
}

fn headLines(file: std.fs.File, buffer: [*]u8, count: usize, delimiter: u8) -> bool {
    var remaining = count
    while remaining > 0 {
        const amount = std.fs.read(file, buffer, common.BUFFER_SIZE)
        if amount < 0 { return false }
        if amount == 0 { return true }
        const length = @bitCast(usize, amount)
        var output_length: usize = 0
        while output_length < length {
            if buffer[output_length] == delimiter {
                remaining -= 1
                output_length += 1
                if remaining == 0 { break }
            } else { output_length += 1 }
        }
        unsafe { if !std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, buffer), output_length) { return false } }
    }
    return true
}

fn printHeader(name: std.string.String, first: *bool) -> bool {
    if !first.* && !std.io.print("\n") { return false }
    first.* = false
    if !std.io.print("==> ") { return false }
    if common.isDash(name) {
        if !std.io.print("standard input") { return false }
    } else if !std.io.printString(name) { return false }
    return std.io.print(" <==\n")
}

fn processFile(file: std.fs.File, options: Options) -> bool {
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    const success = if options.mode == 1 { headBytes(file, buffer, options.count) } else { headLines(file, buffer, options.count, if options.zero { 0 } else { 10 }) }
    allocator.freeFn(allocator.context, buffer, common.BUFFER_SIZE, 8)
    return success
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: head [OPTION]... [FILE]...\nPrint the first 10 lines of each FILE.\n  -c, --bytes=NUM       print the first NUM bytes\n  -n, --lines=NUM       print the first NUM lines\n  -q, --quiet           never print file headers\n  -v, --verbose         always print file headers\n  -z, --zero-terminated use NUL as the line delimiter\n") { 0 } else { 1 }
}

fn processPath(path: std.string.String, options: Options, show_header: bool, first_header: *bool) -> bool {
    if show_header && !printHeader(path, first_header) { return false }
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("mlx-head", path)
        return false
    }
    const processed = processFile(file, options)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("mlx-head", path) }
    return processed && closed
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx head 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("mlx-head", "invalid option or count")
        return 1
    }
    const count = std.process.count(arguments)
    if options.firstFile >= count { return if processFile(std.io.stdin(), options) { 0 } else { 1 } }
    const file_count = count - options.firstFile
    const show_header = options.verbose || !options.quiet && file_count > 1
    var first_header = true
    var status: u8 = 0
    var index = options.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), options, show_header, &first_header) { status = 1 }
        index += 1
    }
    return status
}
