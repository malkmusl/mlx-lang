const std = @import("std")
const common = @import("../common.mlx")

fn firstOperand(arguments: [][*]const u8) -> usize {
    if std.process.count(arguments) > 1 && common.equals(std.process.argument(arguments, 1), "--") { return 2 }
    return 1
}

fn lineLength(arguments: [][*]const u8, first: usize) -> usize {
    const count = std.process.count(arguments)
    if first >= count { return 2 }
    var length: usize = 1
    var index = first
    while index < count {
        length += std.process.argument(arguments, index).length
        if index > first { length += 1 }
        index += 1
    }
    return length
}

fn writeLine(arguments: [][*]const u8, first: usize, buffer: [*]u8) -> usize {
    const count = std.process.count(arguments)
    if first >= count {
        buffer[0] = 121
        buffer[1] = 10
        return 2
    }
    var offset: usize = 0
    var index = first
    while index < count {
        if index > first {
            buffer[offset] = 32
            offset += 1
        }
        const argument = std.process.argument(arguments, index)
        unsafe { std.mem.copy(@ptrFromInt([*]u8, @intFromPtr(buffer) + offset), argument.pointer, argument.length) }
        offset += argument.length
        index += 1
    }
    buffer[offset] = 10
    return offset + 1
}

fn fillBuffer(buffer: [*]u8, line_length: usize, capacity: usize) -> void {
    var filled = line_length
    while filled < capacity {
        const remaining = capacity - filled
        const amount = if filled < remaining { filled } else { remaining }
        unsafe { std.mem.copy(@ptrFromInt([*]u8, @intFromPtr(buffer) + filled), @ptrCast([*]const u8, buffer), amount) }
        filled += amount
    }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: yes [STRING]...\n  or:  yes OPTION\nRepeatedly output a line with all specified STRING(s), or 'y'.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const argument_count = std.process.count(arguments)
    if argument_count == 2 && common.equals(std.process.argument(arguments, 1), "--help") { return printHelp() }
    if argument_count == 2 && common.equals(std.process.argument(arguments, 1), "--version") { return if std.io.print("mlx yes 0.1.0\n") { 0 } else { 1 } }
    if argument_count > 1 {
        const first_argument = std.process.argument(arguments, 1)
        if first_argument.length > 1 && first_argument.pointer[0] == 45 && !common.equals(first_argument, "--") {
            common.writeMessage("yes", "invalid option")
            return 1
        }
    }
    const first = firstOperand(arguments)
    const line_length = lineLength(arguments, first)
    const capacity = if line_length > common.BUFFER_SIZE { line_length } else { common.BUFFER_SIZE }
    const allocator = std.page_allocator.init()
    const allocation = allocator.alloc(capacity, 8)
    if allocation == null { return 1 }
    const buffer = allocation.?
    const written = writeLine(arguments, first, buffer)
    fillBuffer(buffer, written, capacity)
    unsafe {
        while std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, buffer), capacity) {}
    }
    allocator.free(buffer, capacity, 8)
    return 1
}
