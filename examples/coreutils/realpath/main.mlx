const std = @import("std")
const common = @import("../common.mlx")
const canonical = @import("../canonical_path.mlx")

const Options = struct {
    mode: u8
    logical: bool
    strip: bool
    quiet: bool
    zero: bool
    relativeTo: std.string.String
    relativeToSet: bool
    relativeBase: std.string.String
    relativeBaseSet: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn consumeValue(arguments: [][*]const u8, index: *usize, attached: std.string.String) -> ?std.string.String {
    if attached.length > 0 { return attached }
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn parseShort(argument: std.string.String, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        const byte = argument.pointer[index]
        if byte == 69 { options.*.mode = 0 } else if byte == 101 { options.*.mode = 1 } else if byte == 109 {
            options.*.mode = 2
        } else if byte == 76 { options.*.logical = true } else if byte == 80 { options.*.logical = false } else if byte == 113 {
            options.*.quiet = true
        } else if byte == 115 { options.*.strip = true } else if byte == 122 { options.*.zero = true } else { return false }
        index += 1
    }
    return true
}

fn setRelative(arguments: [][*]const u8, index: *usize, attached: std.string.String, base: bool, options: *Options) -> bool {
    const value = consumeValue(arguments, index, attached)
    if value == null { return false }
    if base {
        options.*.relativeBase = value.?
        options.*.relativeBaseSet = true
    } else {
        options.*.relativeTo = value.?
        options.*.relativeToSet = true
    }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--canonicalize") { options.*.mode = 0 } else if common.equals(argument, "--canonicalize-existing") { options.*.mode = 1 } else if common.equals(argument, "--canonicalize-missing") {
        options.*.mode = 2
    } else if common.equals(argument, "--logical") { options.*.logical = true } else if common.equals(argument, "--physical") { options.*.logical = false } else if common.equals(argument, "--quiet") {
        options.*.quiet = true
    } else if common.equals(argument, "--strip") || common.equals(argument, "--no-symlinks") { options.*.strip = true } else if common.equals(argument, "--zero") {
        options.*.zero = true
    } else if common.equals(argument, "--relative-to") { return setRelative(arguments, index, std.string.fromSlice(""), false, options) } else if std.string.startsWith(argument, std.string.fromSlice("--relative-to=")) {
        const value = std.string.slice(argument, 14, argument.length)
        if value.length == 0 { return false }
        return setRelative(arguments, index, value, false, options)
    } else if common.equals(argument, "--relative-base") { return setRelative(arguments, index, std.string.fromSlice(""), true, options) } else if std.string.startsWith(argument, std.string.fromSlice("--relative-base=")) {
        const value = std.string.slice(argument, 16, argument.length)
        if value.length == 0 { return false }
        return setRelative(arguments, index, value, true, options)
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") { options.*.action = 2 } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .mode = 0, .logical = false, .strip = false, .quiet = false, .zero = false, .relativeTo = std.string.fromSlice(""), .relativeToSet = false, .relativeBase = std.string.fromSlice(""), .relativeBaseSet = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn writeDelimiter(zero: bool) -> bool {
    if !zero { return std.io.print("\n") }
    var terminator: [1]u8 = [1]u8{ 0 }
    unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, terminator[0..1]), 1) }
}

fn resolveOptionPath(path: std.string.String, options: Options) -> ?common.MutablePath {
    const effective_mode: u8 = if options.strip && options.mode == 0 { 2 } else { options.mode }
    if !options.logical || options.strip { return canonical.canonicalize(path, effective_mode, !options.strip) }
    const lexical = canonical.canonicalize(path, 2, false)
    if lexical == null { return null }
    const owned = lexical.?
    const resolved = canonical.canonicalize(std.string.fromParts(owned.pointer, owned.length), effective_mode, true)
    common.freePath(owned)
    return resolved
}

fn chooseOutput(resolved: common.MutablePath, relative_to: ?common.MutablePath, relative_base: ?common.MutablePath) -> ?common.MutablePath {
    const path = std.string.fromParts(resolved.pointer, resolved.length)
    if relative_base != null {
        const base = relative_base.?
        const base_path = std.string.fromParts(base.pointer, base.length)
        if !canonical.isBelow(path, base_path) { return common.allocatePath(path) }
        if relative_to != null {
            const origin = relative_to.?
            if !canonical.isBelow(std.string.fromParts(origin.pointer, origin.length), base_path) { return common.allocatePath(path) }
        }
    }
    if relative_to != null {
        const origin = relative_to.?
        return canonical.relativeTo(path, std.string.fromParts(origin.pointer, origin.length))
    }
    if relative_base != null {
        const base = relative_base.?
        return canonical.relativeTo(path, std.string.fromParts(base.pointer, base.length))
    }
    return common.allocatePath(path)
}

fn processPath(path: std.string.String, options: Options, relative_to: ?common.MutablePath, relative_base: ?common.MutablePath) -> bool {
    const resolved = resolveOptionPath(path, options)
    if resolved == null { return false }
    const owned_resolved = resolved.?
    const output = chooseOutput(owned_resolved, relative_to, relative_base)
    common.freePath(owned_resolved)
    if output == null { return false }
    const owned_output = output.?
    const written = std.io.writeAllBytes(std.io.stdout(), owned_output.pointer, owned_output.length) && writeDelimiter(options.zero)
    common.freePath(owned_output)
    return written
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: realpath [OPTION]... FILE...\n  -E, --canonicalize\n  -e, --canonicalize-existing\n  -m, --canonicalize-missing\n  -P, --physical\n  -q, --quiet\n  -s, --strip, --no-symlinks\n      --relative-to=DIR\n      --relative-base=DIR\n  -z, --zero\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx realpath 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstOperand >= count {
        common.writeMessage("realpath", "missing operand or invalid option")
        return 1
    }
    const relative_to = if options.relativeToSet { resolveOptionPath(options.relativeTo, options) } else { null }
    const relative_base = if options.relativeBaseSet { resolveOptionPath(options.relativeBase, options) } else { null }
    if options.relativeToSet && relative_to == null || options.relativeBaseSet && relative_base == null { return 1 }
    var success = true
    var index = options.firstOperand
    while index < count {
        const path = std.process.argument(arguments, index)
        if !processPath(path, options, relative_to, relative_base) {
            if !options.quiet { common.writePathError("realpath", "cannot resolve", path) }
            success = false
        }
        index += 1
    }
    if relative_to != null { common.freePath(relative_to.?) }
    if relative_base != null { common.freePath(relative_base.?) }
    return if success { 0 } else { 1 }
}
