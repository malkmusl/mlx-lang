const std = @import("std")
const common = @import("../common.mlx")
const mode_parser = @import("../mode.mlx")
const security_context = @import("../security_context.mlx")

const Options = struct {
    parents: bool
    verbose: bool
    mode: usize
    modeSet: bool
    contextExplicit: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn setMode(options: *Options, argument: std.string.String) -> void {
    const parsed = mode_parser.parse(argument, 511, true, true)
    if !parsed.valid { options.*.invalid = true } else {
        options.*.mode = parsed.value
        options.*.modeSet = true
    }
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--parents") {
        options.*.parents = true
        return true
    }
    if common.equals(argument, "--verbose") {
        options.*.verbose = true
        return true
    }
    if common.equals(argument, "--help") {
        options.*.action = 1
        return true
    }
    if common.equals(argument, "--version") {
        options.*.action = 2
        return true
    }
    if common.equals(argument, "--context") {
        return true
    }
    if std.string.startsWith(argument, std.string.fromSlice("--context=")) {
        options.*.contextExplicit = true
        return true
    }
    if std.string.startsWith(argument, std.string.fromSlice("--mode=")) {
        setMode(options, std.string.slice(argument, 7, argument.length))
        return true
    }
    if common.equals(argument, "--mode") {
        index.* += 1
        if index.* >= std.process.count(arguments) {
            options.*.invalid = true
            return true
        }
        setMode(options, std.process.argument(arguments, index.*))
        return true
    }
    return false
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const option = argument.pointer[current]
        if option == 112 { options.*.parents = true } else if option == 118 { options.*.verbose = true } else if option == 90 {
            options.*.contextExplicit = false
        } else if option == 109 {
            var text = std.string.slice(argument, current + 1, argument.length)
            if text.length == 0 {
                index.* += 1
                if index.* >= std.process.count(arguments) {
                    return false
                }
                text = std.process.argument(arguments, index.*)
            }
            setMode(options, text)
            return true
        } else {
            return false
        }
        current += 1
    }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .parents = false, .verbose = false, .mode = 511, .modeSet = false, .contextExplicit = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if argument.pointer[1] == 45 {
            if !parseLong(arguments, &index, argument, &result) { result.invalid = true }
        } else if !parseShort(arguments, &index, argument, &result) { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn isDirectory(path: [*]const u8) -> bool {
    var status: std.fs.Stat = undefined
    if std.fs.status(path, &status) != 0 { return false }
    return status.mode & 61440 == 16384
}

fn reportCreated(path: std.string.String, verbose: bool) -> void {
    if !verbose { return }
    const first = std.io.print("mlx-mkdir: created directory '")
    const second = std.io.printString(path)
    const third = std.io.print("'\n")
}

fn createPath(path: std.string.String, mode: usize, exact_mode: bool, allow_existing: bool, verbose: bool) -> bool {
    const result = std.fs.makeDirResult(path.pointer, mode)
    if result == 0 {
        if exact_mode && !std.fs.chmod(path.pointer, mode) { return false }
        reportCreated(path, verbose)
        return true
    }
    return allow_existing && result == -17 && isDirectory(path.pointer)
}

fn parentMode() -> usize {
    return (511 & ~std.fs.currentUmask()) | 192
}

fn createParents(path: std.string.String, options: Options) -> bool {
    const allocated = common.allocatePath(path)
    if allocated == null { return false }
    const mutable = allocated.?
    var index: usize = 1
    var success = true
    const parent_mode = parentMode()
    while index < mutable.length {
        if mutable.pointer[index] == 47 && mutable.pointer[index - 1] != 47 {
            mutable.pointer[index] = 0
            const component = std.string.fromParts(mutable.pointer, index)
            if !createPath(component, parent_mode, true, true, options.verbose) { success = false }
            mutable.pointer[index] = 47
            if !success { break }
        }
        index += 1
    }
    if success { success = createPath(path, options.mode, options.modeSet, true, options.verbose) }
    common.freePath(mutable)
    return success
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: mlx-mkdir [OPTION]... DIRECTORY...\n  -m, --mode=MODE  set file mode (as in chmod)\n  -p, --parents    make parent directories as needed\n  -v, --verbose    print each created directory\n  -Z, --context[=CTX]  select a security context\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx mkdir 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstOperand >= count {
        common.writeMessage("mlx-mkdir", "missing or invalid operand")
        return 1
    }
    security_context.warnIfUnavailable(std.string.fromSlice("mlx-mkdir"), options.contextExplicit)
    var status: u8 = 0
    var index = options.firstOperand
    while index < count {
        const path = std.process.argument(arguments, index)
        const created = if options.parents { createParents(path, options) } else { createPath(path, options.mode, options.modeSet, false, options.verbose) }
        if !created {
            common.writePathError("mlx-mkdir", "cannot create directory", path)
            status = 1
        }
        index += 1
    }
    return status
}
