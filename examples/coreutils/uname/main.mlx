const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    system: bool
    node: bool
    release: bool
    version: bool
    machine: bool
    processor: bool
    platform: bool
    operatingSystem: bool
    action: u8
    invalid: bool
}

fn emptyOptions() -> Options {
    return Options.{ .system = false, .node = false, .release = false, .version = false, .machine = false, .processor = false, .platform = false, .operatingSystem = false, .action = 0, .invalid = false }
}

fn selectAll(options: *Options) -> void {
    options.*.system = true
    options.*.node = true
    options.*.release = true
    options.*.version = true
    options.*.machine = true
    options.*.operatingSystem = true
}

fn parseLong(argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--all") {
        selectAll(options)
        return true
    }
    if common.equals(argument, "--kernel-name") {
        options.*.system = true
        return true
    }
    if common.equals(argument, "--nodename") {
        options.*.node = true
        return true
    }
    if common.equals(argument, "--kernel-release") {
        options.*.release = true
        return true
    }
    if common.equals(argument, "--kernel-version") {
        options.*.version = true
        return true
    }
    if common.equals(argument, "--machine") {
        options.*.machine = true
        return true
    }
    if common.equals(argument, "--processor") {
        options.*.processor = true
        return true
    }
    if common.equals(argument, "--hardware-platform") {
        options.*.platform = true
        return true
    }
    if common.equals(argument, "--operating-system") {
        options.*.operatingSystem = true
        return true
    }
    if common.equals(argument, "--help") {
        options.*.action = 1
        return true
    }
    if common.equals(argument, "--version") {
        options.*.action = 2
        return true
    }
    return false
}

fn parseShort(argument: std.string.String, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        const option = argument.pointer[index]
        if option == 97 { selectAll(options) } else if option == 115 { options.*.system = true } else if option == 110 {
            options.*.node = true
        } else if option == 114 { options.*.release = true } else if option == 118 { options.*.version = true } else if option == 109 {
            options.*.machine = true
        } else if option == 112 { options.*.processor = true } else if option == 105 { options.*.platform = true } else if option == 111 {
            options.*.operatingSystem = true
        } else { return false }
        index += 1
    }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = emptyOptions()
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 {
            result.invalid = true
            break
        }
        const valid = if argument.pointer[1] == 45 { parseLong(argument, &result) } else { parseShort(argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    if index < count { result.invalid = true }
    if !result.system && !result.node && !result.release && !result.version && !result.machine && !result.processor && !result.platform && !result.operatingSystem { result.system = true }
    return result
}

fn infoField(info: *std.os.linux.system.UtsName, index: usize) -> std.string.String {
    unsafe {
        const pointer = @ptrFromInt([*]const u8, @intFromPtr(info) + index * 65)
        return std.process.fromCString(pointer)
    }
}

fn writePart(value: std.string.String, first: *bool) -> bool {
    if !first.* && !std.io.print(" ") { return false }
    first.* = false
    return std.io.printString(value)
}

fn writeSelected(options: Options, info: *std.os.linux.system.UtsName) -> bool {
    var first = true
    if options.system && !writePart(infoField(info, 0), &first) { return false }
    if options.node && !writePart(infoField(info, 1), &first) { return false }
    if options.release && !writePart(infoField(info, 2), &first) { return false }
    if options.version && !writePart(infoField(info, 3), &first) { return false }
    if options.machine && !writePart(infoField(info, 4), &first) { return false }
    if options.processor && !writePart(std.string.fromSlice("unknown"), &first) { return false }
    if options.platform && !writePart(std.string.fromSlice("unknown"), &first) { return false }
    if options.operatingSystem && !writePart(std.string.fromSlice("GNU/Linux"), &first) { return false }
    return std.io.print("\n")
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: uname [OPTION]...\nPrint system information.\n  -a, --all  print all available information\n  -s, --kernel-name  -n, --nodename  -r, --kernel-release\n  -v, --kernel-version  -m, --machine  -p, --processor\n  -i, --hardware-platform  -o, --operating-system\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx uname 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("mlx-uname", "invalid option or operand")
        return 1
    }
    var info: std.os.linux.system.UtsName = undefined
    if !std.os.linux.system.getSystemInfo(&info) {
        common.writeMessage("mlx-uname", "cannot read system information")
        return 1
    }
    return if writeSelected(options, &info) { 0 } else { 1 }
}
