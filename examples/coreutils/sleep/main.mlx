const std = @import("std")
const common = @import("../common.mlx")

const Duration = struct {
    nanoseconds: usize
    valid: bool
}

fn unitForSuffix(byte: u8) -> usize {
    if byte == 109 { return 60000000000 }
    if byte == 104 { return 3600000000000 }
    if byte == 100 { return 86400000000000 }
    return 1000000000
}

fn parseDuration(text: std.string.String) -> Duration {
    if text.length == 0 { return Duration.{ .nanoseconds = 0, .valid = false } }
    var end = text.length
    var unit: usize = 1000000000
    const suffix = text.pointer[end - 1]
    if suffix == 115 || suffix == 109 || suffix == 104 || suffix == 100 {
        unit = unitForSuffix(suffix)
        end -= 1
    }
    if end == 0 { return Duration.{ .nanoseconds = 0, .valid = false } }
    var whole: usize = 0
    var fraction: usize = 0
    var scale: usize = 1
    var digits: usize = 0
    var dot = false
    var index: usize = 0
    while index < end {
        const byte = text.pointer[index]
        if byte == 46 && !dot { dot = true } else if byte >= 48 && byte <= 57 {
            digits += 1
            const digit = @intCast(usize, byte - 48)
            if !dot {
                if whole > (18446744073709551615 - digit) / 10 { return Duration.{ .nanoseconds = 0, .valid = false } }
                whole = whole * 10 + digit
            } else if scale < 1000000000 {
                fraction = fraction * 10 + digit
                scale *= 10
            }
        } else { return Duration.{ .nanoseconds = 0, .valid = false } }
        index += 1
    }
    if digits == 0 || whole > 18446744073709551615 / unit { return Duration.{ .nanoseconds = 0, .valid = false } }
    const whole_ns = whole * unit
    const fraction_ns = (unit / scale) * fraction
    if whole_ns > 18446744073709551615 - fraction_ns { return Duration.{ .nanoseconds = 0, .valid = false } }
    return Duration.{ .nanoseconds = whole_ns + fraction_ns, .valid = true }
}

fn firstOperand(arguments: [][*]const u8) -> usize {
    if std.process.count(arguments) > 1 && common.equals(std.process.argument(arguments, 1), "--") { return 2 }
    return 1
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: sleep NUMBER[SUFFIX]...\nPause for NUMBER seconds. SUFFIX may be s, m, h, or d.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--help") { return printHelp() }
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--version") { return if std.io.print("mlx sleep 0.1.0\n") { 0 } else { 1 } }
    const first = firstOperand(arguments)
    if first >= count {
        common.writeMessage("mlx-sleep", "missing operand")
        return 1
    }
    var total: usize = 0
    var index = first
    while index < count {
        const parsed = parseDuration(std.process.argument(arguments, index))
        if !parsed.valid || total > 18446744073709551615 - parsed.nanoseconds {
            common.writeMessage("mlx-sleep", "invalid time interval")
            return 1
        }
        total += parsed.nanoseconds
        index += 1
    }
    if !std.time.sleepNanoseconds(total) {
        common.writeMessage("mlx-sleep", "sleep failed")
        return 1
    }
    return 0
}
