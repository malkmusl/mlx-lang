const std = @import("std")
const common = @import("../common.mlx")
const duration = @import("../duration.mlx")

fn firstOperand(arguments: [][*]const u8) -> usize {
    if std.process.count(arguments) > 1 && common.equals(std.process.argument(arguments, 1), "--") { return 2 }
    return 1
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: sleep NUMBER[SUFFIX]...\nPause for NUMBER seconds. SUFFIX may be s, m, h, or d.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--help") { return printHelp() }
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--version") { return if std.io.print("mlx sleep 0.1.0\n") { 0 } else { 1 } }
    const first = firstOperand(arguments)
    if first >= count {
        common.writeMessage("mlx-sleep", "missing operand")
        return 1
    }
    var total: usize = 0
    var index = first
    while index < count {
        const parsed = duration.parse(std.process.argument(arguments, index))
        if !parsed.valid || total > 18446744073709551615 - parsed.nanoseconds {
            common.writeMessage("mlx-sleep", "invalid time interval")
            return 1
        }
        total += parsed.nanoseconds
        index += 1
    }
    if !std.time.sleepNanoseconds(total) {
        common.writeMessage("mlx-sleep", "sleep failed")
        return 1
    }
    return 0
}
