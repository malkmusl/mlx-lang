const std = @import("std")
const common = @import("../common.mlx")

fn printHelp() -> u8 {
    return if std.io.print("Usage: arch [OPTION]...\nPrint machine architecture.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count == 2 {
        const argument = std.process.argument(arguments, 1)
        if common.equals(argument, "--help") { return printHelp() }
        if common.equals(argument, "--version") { return if std.io.print("mlx arch 0.1.0\n") { 0 } else { 1 } }
    }
    if count > 1 {
        common.writeMessage("arch", "extra operand")
        return 1
    }
    var info: std.os.linux.system.UtsName = undefined
    if !std.os.linux.system.getSystemInfo(&info) {
        common.writeMessage("arch", "cannot determine architecture")
        return 1
    }
    unsafe {
        const machine = std.process.fromCString(@ptrFromInt([*]const u8, @intFromPtr(&info) + 4 * 65))
        if !std.io.printString(machine) || !std.io.print("\n") { return 1 }
    }
    return 0
}
