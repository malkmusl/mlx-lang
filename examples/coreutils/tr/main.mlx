const std = @import("std")
const common = @import("../common.mlx")

const SET_CAPACITY: usize = 512

const SetResult = struct {
    bytes: [*]u8
    count: usize
    valid: bool
}

fn appendByte(bytes: [*]u8, count: *usize, value: u8) -> void {
    if count.* < SET_CAPACITY {
        bytes[count.*] = value
        count.* += 1
    }
}

fn appendClassBytes(bytes: [*]u8, count: *usize, name: std.string.String) -> void {
    var b: usize = 0
    while b < 256 {
        const byte = @intCast(u8, b)
        const is_upper = byte >= 65 && byte <= 90
        const is_lower = byte >= 97 && byte <= 122
        const is_digit = byte >= 48 && byte <= 57
        const is_alpha = is_upper || is_lower
        const is_alnum = is_alpha || is_digit
        const is_graph = byte > 32 && byte < 127
        var matches = false
        if common.equals(name, "upper") { matches = is_upper } else if common.equals(name, "lower") {
            matches = is_lower
        } else if common.equals(name, "digit") { matches = is_digit } else if common.equals(name, "alpha") {
            matches = is_alpha
        } else if common.equals(name, "alnum") { matches = is_alnum } else if common.equals(name, "space") {
            matches = byte == 32 || byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13
        } else if common.equals(name, "blank") { matches = byte == 32 || byte == 9 } else if common.equals(name, "cntrl") {
            matches = byte < 32 || byte == 127
        } else if common.equals(name, "print") { matches = byte >= 32 && byte < 127 } else if common.equals(name, "graph") {
            matches = is_graph
        } else if common.equals(name, "punct") { matches = is_graph && !is_alnum } else if common.equals(name, "xdigit") {
            matches = is_digit || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102)
        }
        if matches { appendByte(bytes, count, byte) }
        b += 1
    }
}

fn parseSet(text: std.string.String) -> SetResult {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(SET_CAPACITY, 1)
    if allocation == null { return SetResult.{ .bytes = undefined, .count = 0, .valid = false } }
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, allocation.?) }
    var count: usize = 0
    var i: usize = 0
    while i < text.length {
        const c = text.pointer[i]
        if c == 92 && i + 1 < text.length {
            const next = text.pointer[i + 1]
            if next >= 48 && next <= 55 {
                var value: usize = 0
                var digits: usize = 0
                var j = i + 1
                while digits < 3 && j < text.length && text.pointer[j] >= 48 && text.pointer[j] <= 55 {
                    value = value * 8 + @intCast(usize, text.pointer[j] - 48)
                    j += 1
                    digits += 1
                }
                appendByte(bytes, &count, @intCast(u8, value % 256))
                i = j
                continue
            }
            var value: u8 = next
            if next == 110 { value = 10 } else if next == 116 {
                value = 9
            } else if next == 92 { value = 92 } else if next == 97 {
                value = 7
            } else if next == 98 { value = 8 } else if next == 102 {
                value = 12
            } else if next == 114 { value = 13 } else if next == 118 {
                value = 11
            }
            appendByte(bytes, &count, value)
            i += 2
            continue
        }
        if c == 91 && i + 1 < text.length && text.pointer[i + 1] == 58 {
            var j = i + 2
            const name_start = j
            while j < text.length && text.pointer[j] != 58 { j += 1 }
            if j + 1 < text.length && text.pointer[j] == 58 && text.pointer[j + 1] == 93 {
                const name = std.string.slice(text, name_start, j)
                appendClassBytes(bytes, &count, name)
                i = j + 2
                continue
            }
        }
        if i + 2 < text.length && text.pointer[i + 1] == 45 {
            const start_byte = c
            const end_byte = text.pointer[i + 2]
            if end_byte >= start_byte {
                var v = start_byte
                while v <= end_byte {
                    appendByte(bytes, &count, v)
                    if v == 255 { break }
                    v += 1
                }
                i += 3
                continue
            }
        }
        appendByte(bytes, &count, c)
        i += 1
    }
    return SetResult.{ .bytes = bytes, .count = count, .valid = true }
}

fn complementOf(set1: SetResult) -> SetResult {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const membership_allocation = allocator.alloc(256, 1)
    var membership: [*]u8 = undefined
    unsafe { membership = @ptrCast([*]u8, membership_allocation.?) }
    var z: usize = 0
    while z < 256 {
        membership[z] = 0
        z += 1
    }
    var k: usize = 0
    while k < set1.count {
        membership[set1.bytes[k]] = 1
        k += 1
    }
    const result_allocation = allocator.alloc(256, 1)
    var result_bytes: [*]u8 = undefined
    unsafe { result_bytes = @ptrCast([*]u8, result_allocation.?) }
    var count: usize = 0
    var b: usize = 0
    while b < 256 {
        if membership[b] == 0 {
            result_bytes[count] = @intCast(u8, b)
            count += 1
        }
        b += 1
    }
    allocator.free(membership_allocation.?, 256, 1)
    return SetResult.{ .bytes = result_bytes, .count = count, .valid = true }
}

fn buildMembership(set: SetResult) -> [*]u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(256, 1)
    var table: [*]u8 = undefined
    unsafe { table = @ptrCast([*]u8, allocation.?) }
    var z: usize = 0
    while z < 256 {
        table[z] = 0
        z += 1
    }
    var k: usize = 0
    while k < set.count {
        table[set.bytes[k]] = 1
        k += 1
    }
    return table
}

fn buildTranslateTable(set1: SetResult, set2: SetResult, truncate1: bool) -> [*]u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(256, 1)
    var table: [*]u8 = undefined
    unsafe { table = @ptrCast([*]u8, allocation.?) }
    var b: usize = 0
    while b < 256 {
        table[b] = @intCast(u8, b)
        b += 1
    }
    var length1 = set1.count
    if truncate1 && set2.count < length1 { length1 = set2.count }
    var i: usize = 0
    while i < length1 {
        const from = set1.bytes[i]
        var to: u8 = from
        if set2.count > 0 {
            to = if i < set2.count { set2.bytes[i] } else { set2.bytes[set2.count - 1] }
        }
        table[from] = to
        i += 1
    }
    return table
}

const Options = struct {
    complement: bool
    delete: bool
    squeeze: bool
    truncate: bool
    action: u8
    invalid: bool
    set1Set: bool
    set1: std.string.String
    set2Set: bool
    set2: std.string.String
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .complement = false, .delete = false, .squeeze = false, .truncate = false, .action = 0, .invalid = false,
        .set1Set = false, .set1 = std.string.fromSlice(""), .set2Set = false, .set2 = std.string.fromSlice(""),
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    var positional: usize = 0
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "--complement") {
            result.complement = true
            index += 1
            continue
        }
        if common.equals(argument, "--delete") {
            result.delete = true
            index += 1
            continue
        }
        if common.equals(argument, "--squeeze-repeats") {
            result.squeeze = true
            index += 1
            continue
        }
        if common.equals(argument, "--truncate-set1") {
            result.truncate = true
            index += 1
            continue
        }
        if argument.pointer[1] == 45 {
            result.invalid = true
            index += 1
            continue
        }
        var i: usize = 1
        var ok = true
        while i < argument.length {
            const byte = argument.pointer[i]
            if byte == 99 || byte == 67 { result.complement = true } else if byte == 100 {
                result.delete = true
            } else if byte == 115 { result.squeeze = true } else if byte == 116 {
                result.truncate = true
            } else { ok = false }
            i += 1
        }
        if !ok { result.invalid = true }
        index += 1
    }
    while index < count {
        const argument = std.process.argument(arguments, index)
        if positional == 0 {
            result.set1 = argument
            result.set1Set = true
        } else if positional == 1 {
            result.set2 = argument
            result.set2Set = true
        } else {
            result.invalid = true
        }
        positional += 1
        index += 1
    }
    if !result.set1Set { result.invalid = true }
    if !result.delete && !result.squeeze && !result.set2Set { result.invalid = true }
    return result
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: tr [OPTION]... SET1 [SET2]\nTranslate, squeeze, and/or delete characters from standard input,\nwriting to standard output.\n  -c, -C, --complement    use the complement of SET1\n  -d, --delete            delete characters in SET1, do not translate\n  -s, --squeeze-repeats   replace each sequence of a repeated character\n                            that is listed in the last specified SET,\n                            with a single occurrence of that character\n  -t, --truncate-set1     first truncate SET1 to length of SET2\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx tr 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("tr", "invalid arguments")
        return 1
    }
    var set1 = parseSet(options.set1)
    if !set1.valid {
        common.writeMessage("tr", "invalid set")
        return 1
    }
    if options.complement { set1 = complementOf(set1) }
    var set2 = SetResult.{ .bytes = undefined, .count = 0, .valid = true }
    if options.set2Set {
        set2 = parseSet(options.set2)
        if !set2.valid {
            common.writeMessage("tr", "invalid set")
            return 1
        }
    }
    var delete_membership: [*]u8 = undefined
    var translate_table: [*]u8 = undefined
    if options.delete {
        delete_membership = buildMembership(set1)
    } else {
        translate_table = buildTranslateTable(set1, set2, options.truncate)
    }
    var squeeze_membership: [*]u8 = undefined
    if options.squeeze {
        const squeeze_set = if options.set2Set { set2 } else { set1 }
        squeeze_membership = buildMembership(squeeze_set)
    }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(std.io.stdin(), allocator)
    const output_allocation = allocator.alloc(if data.length > 0 { data.length } else { 1 }, 1)
    var output: [*]u8 = undefined
    unsafe { output = @ptrCast([*]u8, output_allocation.?) }
    var output_length: usize = 0
    var have_last = false
    var last_output_byte: u8 = 0
    var index: usize = 0
    while index < data.length {
        const input_byte = data.items[index]
        var keep = true
        var output_byte = input_byte
        if options.delete {
            if delete_membership[input_byte] == 1 { keep = false }
        } else {
            output_byte = translate_table[input_byte]
        }
        if keep {
            var squeeze_this = false
            if options.squeeze && squeeze_membership[output_byte] == 1 && have_last && last_output_byte == output_byte { squeeze_this = true }
            if !squeeze_this {
                output[output_length] = output_byte
                output_length += 1
                last_output_byte = output_byte
                have_last = true
            }
        }
        index += 1
    }
    var ok = true
    unsafe {
        if output_length > 0 { ok = std.io.writeAllBytes(std.io.stdout(), output, output_length) }
    }
    data.deinit()
    return if ok { 0 } else { 1 }
}
