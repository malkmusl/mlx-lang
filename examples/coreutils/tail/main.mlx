const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    mode: u8
    count: usize
    fromStart: bool
    quiet: bool
    verbose: bool
    zero: bool
    followMode: u8
    retry: bool
    debug: bool
    sleepNanoseconds: usize
    maxUnchanged: usize
    pid: usize
    pidSet: bool
    firstFile: usize
    action: u8
    invalid: bool
}

const Start = struct {
    offset: usize
    valid: bool
}

fn setCount(options: *Options, mode: u8, text: std.string.String) -> bool {
    const parsed = std.parse.size(text)
    if !parsed.valid { return false }
    options.*.mode = mode
    options.*.count = parsed.value
    options.*.fromStart = parsed.positive
    return true
}

fn setFollow(options: *Options, text: std.string.String) -> bool {
    if common.equals(text, "descriptor") { options.*.followMode = 1 } else if common.equals(text, "name") {
        options.*.followMode = 2
    } else { return false }
    return true
}

fn setUnsigned(options: *Options, text: std.string.String, pid: bool) -> bool {
    const parsed = std.parse.unsigned(text)
    if !parsed.valid { return false }
    if pid {
        options.*.pid = parsed.value
        options.*.pidSet = true
    } else { options.*.maxUnchanged = parsed.value }
    return true
}

fn setInterval(options: *Options, text: std.string.String) -> bool {
    const parsed = std.parse.duration(text)
    if !parsed.valid { return false }
    options.*.sleepNanoseconds = parsed.nanoseconds
    return true
}

fn parseLongValue(argument: std.string.String, options: *Options) -> bool {
    if std.string.startsWith(argument, std.string.fromSlice("--follow=")) {
        return setFollow(options, std.string.slice(argument, 9, argument.length))
    }
    if std.string.startsWith(argument, std.string.fromSlice("--max-unchanged-stats=")) {
        return setUnsigned(options, std.string.slice(argument, 22, argument.length), false)
    }
    if std.string.startsWith(argument, std.string.fromSlice("--pid=")) {
        return setUnsigned(options, std.string.slice(argument, 6, argument.length), true)
    }
    if std.string.startsWith(argument, std.string.fromSlice("--sleep-interval=")) {
        return setInterval(options, std.string.slice(argument, 17, argument.length))
    }
    return false
}

fn parseSeparateLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    const pid = common.equals(argument, "--pid")
    const unchanged = common.equals(argument, "--max-unchanged-stats")
    const interval = common.equals(argument, "--sleep-interval")
    if !pid && !unchanged && !interval { return false }
    index.* += 1
    if index.* >= std.process.count(arguments) { return false }
    const value = std.process.argument(arguments, index.*)
    if interval { return setInterval(options, value) }
    return setUnsigned(options, value, pid)
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--quiet") || common.equals(argument, "--silent") {
        options.*.quiet = true
        return true
    }
    if common.equals(argument, "--verbose") {
        options.*.verbose = true
        return true
    }
    if common.equals(argument, "--zero-terminated") {
        options.*.zero = true
        return true
    }
    if common.equals(argument, "--debug") {
        options.*.debug = true
        return true
    }
    if common.equals(argument, "--follow") {
        options.*.followMode = 1
        return true
    }
    if common.equals(argument, "--retry") {
        options.*.retry = true
        return true
    }
    if common.equals(argument, "--help") {
        options.*.action = 1
        return true
    }
    if common.equals(argument, "--version") {
        options.*.action = 2
        return true
    }
    if std.string.startsWith(argument, std.string.fromSlice("--lines=")) { return setCount(options, 0, std.string.slice(argument, 8, argument.length)) }
    if std.string.startsWith(argument, std.string.fromSlice("--bytes=")) { return setCount(options, 1, std.string.slice(argument, 8, argument.length)) }
    if common.equals(argument, "--pid") || common.equals(argument, "--max-unchanged-stats") || common.equals(argument, "--sleep-interval") {
        return parseSeparateLong(arguments, index, argument, options)
    }
    var mode: u8 = 0
    if common.equals(argument, "--lines") { mode = 0 } else if common.equals(argument, "--bytes") { mode = 1 } else {
        return parseLongValue(argument, options)
    }
    index.* += 1
    if index.* >= std.process.count(arguments) { return false }
    return setCount(options, mode, std.process.argument(arguments, index.*))
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if argument.pointer[1] >= 48 && argument.pointer[1] <= 57 { return setCount(options, 0, std.string.slice(argument, 1, argument.length)) }
    var current: usize = 1
    while current < argument.length {
        const option = argument.pointer[current]
        if option == 113 { options.*.quiet = true } else if option == 118 { options.*.verbose = true } else if option == 122 {
            options.*.zero = true
        } else if option == 102 { options.*.followMode = 1 } else if option == 70 {
            options.*.followMode = 2
            options.*.retry = true
        } else if option == 115 {
            var text = std.string.slice(argument, current + 1, argument.length)
            if text.length == 0 {
                index.* += 1
                if index.* >= std.process.count(arguments) { return false }
                text = std.process.argument(arguments, index.*)
            }
            return setInterval(options, text)
        } else if option == 110 || option == 99 {
            var text = std.string.slice(argument, current + 1, argument.length)
            if text.length == 0 {
                index.* += 1
                if index.* >= std.process.count(arguments) { return false }
                text = std.process.argument(arguments, index.*)
            }
            return setCount(options, if option == 110 { 0 } else { 1 }, text)
        } else { return false }
        current += 1
    }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .mode = 0, .count = 10, .fromStart = false, .quiet = false, .verbose = false, .zero = false, .followMode = 0, .retry = false, .debug = false, .sleepNanoseconds = 1000000000, .maxUnchanged = 5, .pid = 0, .pidSet = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    return result
}

fn memoryLineStart(bytes: [*]u8, length: usize, count: usize, delimiter: u8) -> usize {
    if count == 0 { return length }
    var index = length
    if index > 0 && bytes[index - 1] == delimiter { index -= 1 }
    var found: usize = 0
    while index > 0 {
        index -= 1
        if bytes[index] == delimiter {
            found += 1
            if found == count { return index + 1 }
        }
    }
    return 0
}

fn memoryLineFromStart(bytes: [*]u8, length: usize, count: usize, delimiter: u8) -> usize {
    if count <= 1 { return 0 }
    var remaining = count - 1
    var index: usize = 0
    while index < length {
        if bytes[index] == delimiter {
            remaining -= 1
            if remaining == 0 { return index + 1 }
        }
        index += 1
    }
    return length
}

fn fileLineStart(file: std.fs.File, length: usize, count: usize, delimiter: u8, buffer: [*]u8) -> Start {
    if count == 0 { return Start.{ .offset = length, .valid = true } }
    var position = length
    if position > 0 {
        if std.fs.pread(file, buffer, 1, position - 1) != 1 { return Start.{ .offset = 0, .valid = false } }
        if buffer[0] == delimiter { position -= 1 }
    }
    var found: usize = 0
    while position > 0 {
        const amount = if position < common.BUFFER_SIZE { position } else { common.BUFFER_SIZE }
        const start = position - amount
        if std.fs.pread(file, buffer, amount, start) != @intCast(isize, amount) { return Start.{ .offset = 0, .valid = false } }
        var index = amount
        while index > 0 {
            index -= 1
            if buffer[index] == delimiter {
                found += 1
                if found == count { return Start.{ .offset = start + index + 1, .valid = true } }
            }
        }
        position = start
    }
    return Start.{ .offset = 0, .valid = true }
}

fn fileLineFromStart(file: std.fs.File, length: usize, count: usize, delimiter: u8, buffer: [*]u8) -> Start {
    if count <= 1 { return Start.{ .offset = 0, .valid = true } }
    var remaining = count - 1
    var position: usize = 0
    while position < length {
        const amount = if length - position < common.BUFFER_SIZE { length - position } else { common.BUFFER_SIZE }
        if std.fs.pread(file, buffer, amount, position) != @intCast(isize, amount) { return Start.{ .offset = 0, .valid = false } }
        var index: usize = 0
        while index < amount {
            if buffer[index] == delimiter {
                remaining -= 1
                if remaining == 0 { return Start.{ .offset = position + index + 1, .valid = true } }
            }
            index += 1
        }
        position += amount
    }
    return Start.{ .offset = length, .valid = true }
}

fn regularStart(file: std.fs.File, length: usize, options: Options, buffer: [*]u8) -> Start {
    if options.mode == 1 {
        if options.fromStart { return Start.{ .offset = if options.count <= 1 { 0 } else if options.count - 1 < length { options.count - 1 } else { length }, .valid = true } }
        return Start.{ .offset = if options.count < length { length - options.count } else { 0 }, .valid = true }
    }
    if options.fromStart { return fileLineFromStart(file, length, options.count, if options.zero { 0 } else { 10 }, buffer) }
    return fileLineStart(file, length, options.count, if options.zero { 0 } else { 10 }, buffer)
}

fn tailRegular(file: std.fs.File, length: usize, options: Options, buffer: [*]u8) -> bool {
    const start = regularStart(file, length, options, buffer)
    if !start.valid { return false }
    if start.offset >= length { return true }
    if std.fs.seek(file, @intCast(isize, start.offset), std.fs.SEEK_START) < 0 { return false }
    return std.fs.copy(file, std.io.stdout())
}

fn tailBuffered(file: std.fs.File, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(file, allocator)
    var start: usize = 0
    if options.mode == 1 {
        if options.fromStart {
            start = if options.count <= 1 { 0 } else if options.count - 1 < data.length { options.count - 1 } else { data.length }
        } else { start = if options.count < data.length { data.length - options.count } else { 0 } }
    } else {
        start = if options.fromStart { memoryLineFromStart(data.items, data.length, options.count, if options.zero { 0 } else { 10 }) } else { memoryLineStart(data.items, data.length, options.count, if options.zero { 0 } else { 10 }) }
    }
    var success = true
    if start < data.length {
        unsafe {
            const source = @ptrFromInt([*]const u8, @intFromPtr(data.items) + start)
            success = std.io.writeAllBytes(std.io.stdout(), source, data.length - start)
        }
    }
    std.array_list.ArrayList.deinit(data)
    return success
}

fn processFile(file: std.fs.File, options: Options) -> bool {
    if options.count == 0 && !options.fromStart { return true }
    const end = std.fs.seek(file, 0, std.fs.SEEK_END)
    if end < 0 { return tailBuffered(file, options) }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    const success = tailRegular(file, @bitCast(usize, end), options, buffer)
    allocator.free(buffer, common.BUFFER_SIZE, 8)
    return success
}

fn printHeader(name: std.string.String, first: *bool) -> bool {
    if !first.* && !std.io.print("\n") { return false }
    first.* = false
    if !std.io.print("==> ") { return false }
    if common.isDash(name) {
        if !std.io.print("standard input") { return false }
    } else if !std.io.printString(name) { return false }
    return std.io.print(" <==\n")
}

fn processPath(path: std.string.String, options: Options, show_header: bool, first_header: *bool) -> bool {
    if show_header && !printHeader(path, first_header) { return false }
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("tail", path)
        return false
    }
    const processed = processFile(file, options)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("tail", path) }
    return processed && closed
}

fn writerExited(options: Options) -> bool {
    return options.pidSet && !std.linux.process.isAlive(options.pid)
}

fn debugFollow(options: Options) -> void {
    if options.debug { common.writeMessage("tail", "using polling mode") }
}

fn waitForFile(path: std.string.String, options: Options) -> std.fs.File {
    var file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    while !std.fs.isValid(file) && options.retry && !writerExited(options) {
        const slept = std.time.sleepNanoseconds(options.sleepNanoseconds)
        file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    }
    return file
}

fn drainFollow(file: std.fs.File) -> bool {
    var status: std.fs.Stat = undefined
    const position = std.fs.seek(file, 0, std.fs.SEEK_CURRENT)
    if position < 0 || std.fs.fileStatus(file, &status) != 0 { return false }
    if status.size < position && std.fs.seek(file, 0, std.fs.SEEK_START) < 0 { return false }
    return std.fs.copy(file, std.io.stdout())
}

fn refreshName(path: std.string.String, file: *std.fs.File) -> bool {
    var path_status: std.fs.Stat = undefined
    var file_status: std.fs.Stat = undefined
    if std.fs.status(path.pointer, &path_status) != 0 { return true }
    if std.fs.fileStatus(file.*, &file_status) != 0 { return false }
    if path_status.device == file_status.device && path_status.inode == file_status.inode { return true }
    const replacement = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(replacement) { return true }
    const closed = std.fs.close(file.*)
    file.* = replacement
    return closed
}

fn followPath(path: std.string.String, options: Options) -> bool {
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    var file = waitForFile(path, options)
    if !std.fs.isValid(file) {
        if writerExited(options) { return true }
        common.writeFileError("tail", path)
        return false
    }
    if !processFile(file, options) {
        const closed = std.fs.close(file)
        return false
    }
    if options.count == 0 && !options.fromStart && std.fs.seek(file, 0, std.fs.SEEK_END) < 0 { return false }
    debugFollow(options)
    var unchanged: usize = 0
    while true {
        if !drainFollow(file) { return false }
        if writerExited(options) { return std.fs.close(file) }
        if !std.time.sleepNanoseconds(options.sleepNanoseconds) { return false }
        unchanged += 1
        if options.followMode == 2 && (options.maxUnchanged == 0 || unchanged >= options.maxUnchanged) {
            if !refreshName(path, &file) { return false }
            unchanged = 0
        }
    }
    return false
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: tail [OPTION]... [FILE]...\n  -c, --bytes=[+]NUM    print final bytes or start at NUM\n  -f, --follow[=HOW]    output appended data\n  -F                    follow names and retry\n  -n, --lines=[+]NUM    print final lines or start at NUM\n  -q, --quiet           never print file headers\n  -s, --sleep-interval=N  polling interval\n  -v, --verbose         always print file headers\n  -z, --zero-terminated use NUL as the line delimiter\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx tail 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("tail", "invalid option or count")
        return 1
    }
    const count = std.process.count(arguments)
    if options.firstFile >= count { return if processFile(std.io.stdin(), options) { 0 } else { 1 } }
    const file_count = count - options.firstFile
    if options.followMode != 0 && file_count == 1 {
        return if followPath(std.process.argument(arguments, options.firstFile), options) { 0 } else { 1 }
    }
    const show_header = options.verbose || !options.quiet && file_count > 1
    var first_header = true
    var status: u8 = 0
    var index = options.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), options, show_header, &first_header) { status = 1 }
        index += 1
    }
    return status
}
