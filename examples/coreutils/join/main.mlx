const std = @import("std")
const common = @import("../common.mlx")

const MAX_FORMAT: usize = 64

const FormatToken = struct {
    isZero: bool
    file: usize
    field: usize
}

const Options = struct {
    field1: usize
    field2: usize
    print1: bool
    print2: bool
    suppressJoined: bool
    ignoreCase: bool
    hasFormat: bool
    format: [64]FormatToken
    formatCount: usize
    hasSeparator: bool
    separator: u8
    hasReplacement: bool
    replacement: std.string.String
    header: bool
    zero: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn isBlank(byte: u8) -> bool { return byte == 32 || byte == 9 }

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn parseUnsignedAt(text: std.string.String, at: usize, out: *usize) -> usize {
    var i = at
    var v: usize = 0
    while i < text.length && isDigit(text.pointer[i]) {
        v = v * 10 + @intCast(usize, text.pointer[i] - 48)
        i += 1
    }
    out.* = v
    return i
}

fn zeroToken() -> FormatToken {
    return FormatToken.{ .isZero = false, .file = 1, .field = 1 }
}

fn defaultFormat() -> [64]FormatToken {
    var result: [64]FormatToken = undefined
    var i: usize = 0
    while i < MAX_FORMAT {
        result[i] = zeroToken()
        i += 1
    }
    return result
}

fn parseFormat(text: std.string.String, options: *Options) -> bool {
    var i: usize = 0
    var count: usize = 0
    while i < text.length {
        while i < text.length && (text.pointer[i] == 44 || isBlank(text.pointer[i])) { i += 1 }
        if i >= text.length { break }
        if count >= MAX_FORMAT { return false }
        if text.pointer[i] == 48 {
            options.*.format[count] = FormatToken.{ .isZero = true, .file = 0, .field = 0 }
            count += 1
            i += 1
        } else if isDigit(text.pointer[i]) {
            var file: usize = 0
            i = parseUnsignedAt(text, i, &file)
            if i >= text.length || text.pointer[i] != 46 { return false }
            i += 1
            var field: usize = 0
            i = parseUnsignedAt(text, i, &field)
            if file != 1 && file != 2 { return false }
            if field == 0 { return false }
            options.*.format[count] = FormatToken.{ .isZero = false, .file = file, .field = field }
            count += 1
        } else {
            return false
        }
    }
    options.*.formatCount = count
    options.*.hasFormat = true
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .field1 = 1, .field2 = 1, .print1 = false, .print2 = false, .suppressJoined = false,
        .ignoreCase = false, .hasFormat = false, .format = defaultFormat(), .formatCount = 0,
        .hasSeparator = false, .separator = 0, .hasReplacement = false, .replacement = std.string.fromSlice(""),
        .header = false, .zero = false, .action = 0, .invalid = false, .firstFile = 1,
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-i") || common.equals(argument, "--ignore-case") {
            result.ignoreCase = true
            index += 1
            continue
        }
        if common.equals(argument, "--header") {
            result.header = true
            index += 1
            continue
        }
        if common.equals(argument, "--check-order") || common.equals(argument, "--nocheck-order") {
            index += 1
            continue
        }
        if common.equals(argument, "-z") || common.equals(argument, "--zero-terminated") {
            result.zero = true
            index += 1
            continue
        }
        if common.equals(argument, "-a") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const value = std.process.argument(arguments, index)
            if common.equals(value, "1") { result.print1 = true } else if common.equals(value, "2") {
                result.print2 = true
            } else {
                result.invalid = true
            }
            index += 1
            continue
        }
        if common.equals(argument, "-v") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const value = std.process.argument(arguments, index)
            result.suppressJoined = true
            if common.equals(value, "1") { result.print1 = true } else if common.equals(value, "2") {
                result.print2 = true
            } else {
                result.invalid = true
            }
            index += 1
            continue
        }
        if common.equals(argument, "-j") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else {
                result.field1 = parsed.value
                result.field2 = parsed.value
            }
            index += 1
            continue
        }
        if common.equals(argument, "-1") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.field1 = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-2") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.field2 = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-e") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            result.hasReplacement = true
            result.replacement = std.process.argument(arguments, index)
            index += 1
            continue
        }
        if common.equals(argument, "-t") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const value = std.process.argument(arguments, index)
            if value.length == 0 { result.invalid = true } else {
                result.hasSeparator = true
                result.separator = value.pointer[0]
            }
            index += 1
            continue
        }
        if common.equals(argument, "-o") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            if !parseFormat(std.process.argument(arguments, index), &result) { result.invalid = true }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 116 {
            const value = std.string.slice(argument, 2, argument.length)
            result.hasSeparator = true
            result.separator = value.pointer[0]
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 111 {
            if !parseFormat(std.string.slice(argument, 2, argument.length), &result) { result.invalid = true }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 106 {
            const parsed = std.parse.unsigned(std.string.slice(argument, 2, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else {
                result.field1 = parsed.value
                result.field2 = parsed.value
            }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 97 {
            const value = std.string.slice(argument, 2, argument.length)
            if common.equals(value, "1") { result.print1 = true } else if common.equals(value, "2") {
                result.print2 = true
            } else {
                result.invalid = true
            }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 118 {
            const value = std.string.slice(argument, 2, argument.length)
            result.suppressJoined = true
            if common.equals(value, "1") { result.print1 = true } else if common.equals(value, "2") {
                result.print2 = true
            } else {
                result.invalid = true
            }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 49 {
            const parsed = std.parse.unsigned(std.string.slice(argument, 2, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.field1 = parsed.value }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 50 {
            const parsed = std.parse.unsigned(std.string.slice(argument, 2, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.field2 = parsed.value }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 101 {
            result.hasReplacement = true
            result.replacement = std.string.slice(argument, 2, argument.length)
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn fieldRange(line: [*]const u8, length: usize, fieldNum: usize, hasSep: bool, sep: u8, start_out: *usize, end_out: *usize) -> void {
    if !hasSep {
        var pos: usize = 0
        while pos < length && isBlank(line[pos]) { pos += 1 }
        var field: usize = 1
        while field < fieldNum {
            while pos < length && !isBlank(line[pos]) { pos += 1 }
            while pos < length && isBlank(line[pos]) { pos += 1 }
            field += 1
        }
        const start = pos
        while pos < length && !isBlank(line[pos]) { pos += 1 }
        start_out.* = start
        end_out.* = pos
        return
    }
    var pos: usize = 0
    var field: usize = 1
    while field < fieldNum && pos < length {
        while pos < length && line[pos] != sep { pos += 1 }
        if pos < length { pos += 1 }
        field += 1
    }
    if field < fieldNum {
        start_out.* = length
        end_out.* = length
        return
    }
    const start = pos
    while pos < length && line[pos] != sep { pos += 1 }
    start_out.* = start
    end_out.* = pos
}

fn countFields(line: [*]const u8, length: usize, hasSep: bool, sep: u8) -> usize {
    if length == 0 { return 0 }
    if !hasSep {
        var pos: usize = 0
        var n: usize = 0
        while pos < length {
            while pos < length && isBlank(line[pos]) { pos += 1 }
            if pos >= length { break }
            n += 1
            while pos < length && !isBlank(line[pos]) { pos += 1 }
        }
        return n
    }
    var n: usize = 1
    var pos: usize = 0
    while pos < length {
        if line[pos] == sep { n += 1 }
        pos += 1
    }
    return n
}

fn upperFold(byte: u8) -> u8 {
    if byte >= 97 && byte <= 122 { return byte - 32 }
    return byte
}

fn compareKeys(a: [*]const u8, as: usize, ae: usize, b: [*]const u8, bs: usize, be: usize, ignoreCase: bool) -> isize {
    const alen = ae - as
    const blen = be - bs
    const minLen = if alen < blen { alen } else { blen }
    var i: usize = 0
    while i < minLen {
        var ac = a[as + i]
        var bc = b[bs + i]
        if ignoreCase {
            ac = upperFold(ac)
            bc = upperFold(bc)
        }
        if ac != bc { return if ac < bc { -1 } else { 1 } }
        i += 1
    }
    if alen < blen { return -1 }
    if alen > blen { return 1 }
    return 0
}

fn writeField(file: std.fs.File, ptr: [*]const u8, start: usize, end: usize) -> bool {
    if end <= start { return true }
    unsafe {
        return std.io.writeAllBytes(file, @ptrFromInt([*]const u8, @intFromPtr(ptr) + start), end - start)
    }
}

fn writeSeparator(file: std.fs.File, options: Options) -> bool {
    if options.hasSeparator {
        var buffer: [1]u8 = [1]u8{ options.separator }
        unsafe { return std.io.writeAllBytes(file, @ptrCast([*]const u8, buffer[0..1]), 1) }
    }
    return std.io.writeAll(file, " ")
}

fn writeMissingOrField(file: std.fs.File, options: Options, ptr: [*]const u8, len: usize, present: bool, fieldNum: usize) -> bool {
    if !present {
        if options.hasReplacement { return std.io.writeString(file, options.replacement) }
        return true
    }
    var fs: usize = 0
    var fe: usize = 0
    fieldRange(ptr, len, fieldNum, options.hasSeparator, options.separator, &fs, &fe)
    return writeField(file, ptr, fs, fe)
}

fn writeJoinKeyOrMissing(file: std.fs.File, options: Options, ptr: [*]const u8, len: usize, present: bool, fieldNum: usize) -> bool {
    if present {
        var fs: usize = 0
        var fe: usize = 0
        fieldRange(ptr, len, fieldNum, options.hasSeparator, options.separator, &fs, &fe)
        return writeField(file, ptr, fs, fe)
    }
    if options.hasReplacement { return std.io.writeString(file, options.replacement) }
    return true
}

fn writeRow(file: std.fs.File, options: Options,
    ptr1: [*]const u8, len1: usize, present1: bool, field1: usize,
    ptr2: [*]const u8, len2: usize, present2: bool, field2: usize) -> bool {
    if options.hasFormat {
        var i: usize = 0
        var ok = true
        while i < options.formatCount && ok {
            if i > 0 { if !writeSeparator(file, options) { ok = false } }
            if ok {
                const token = options.format[i]
                if token.isZero {
                    if present1 {
                        if !writeJoinKeyOrMissing(file, options, ptr1, len1, true, field1) { ok = false }
                    } else if present2 {
                        if !writeJoinKeyOrMissing(file, options, ptr2, len2, true, field2) { ok = false }
                    }
                } else if token.file == 1 {
                    if !writeMissingOrField(file, options, ptr1, len1, present1, token.field) { ok = false }
                } else {
                    if !writeMissingOrField(file, options, ptr2, len2, present2, token.field) { ok = false }
                }
            }
            i += 1
        }
        return ok
    }
    var ok = if present1 { writeJoinKeyOrMissing(file, options, ptr1, len1, true, field1) } else { writeJoinKeyOrMissing(file, options, ptr2, len2, present2, field2) }
    if !ok { return false }
    if present1 {
        const total1 = countFields(ptr1, len1, options.hasSeparator, options.separator)
        var f: usize = 1
        while f <= total1 && ok {
            if f != field1 {
                if !writeSeparator(file, options) { ok = false }
                if ok && !writeMissingOrField(file, options, ptr1, len1, true, f) { ok = false }
            }
            f += 1
        }
    }
    if present2 {
        const total2 = countFields(ptr2, len2, options.hasSeparator, options.separator)
        var f: usize = 1
        while f <= total2 && ok {
            if f != field2 {
                if !writeSeparator(file, options) { ok = false }
                if ok && !writeMissingOrField(file, options, ptr2, len2, true, f) { ok = false }
            }
            f += 1
        }
    }
    return ok
}

fn readLines(path: std.string.String, terminator: u8, linePtr: *[*][*]const u8, lineLen: *[*]usize, lineCount: *usize) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var data: std.fs.ArrayList = undefined
    if common.isDash(path) {
        data = std.fs.readToEndAlloc(std.io.stdin(), allocator)
    } else {
        const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
        if !std.fs.isValid(file) {
            common.writeFileError("join", path)
            return false
        }
        data = std.fs.readToEndAlloc(file, allocator)
        const closed = std.fs.close(file)
    }
    unsafe {
        var raw: [*]const u8 = undefined
        raw = @ptrCast([*]const u8, data.items)
        var n: usize = 0
        var i: usize = 0
        while i < data.length {
            if raw[i] == terminator { n += 1 }
            i += 1
        }
        if data.length > 0 && raw[data.length - 1] != terminator { n += 1 }
        if n == 0 {
            lineCount.* = 0
            return true
        }
        const ptrAlloc = allocator.alloc(n * 8, 8)
        const lenAlloc = allocator.alloc(n * 8, 8)
        var ptrs: [*][*]const u8 = @ptrCast([*][*]const u8, ptrAlloc.?)
        var lens: [*]usize = @ptrCast([*]usize, lenAlloc.?)
        var idx: usize = 0
        var lineStart: usize = 0
        i = 0
        while i < data.length {
            if raw[i] == terminator {
                ptrs[idx] = @ptrFromInt([*]const u8, @intFromPtr(raw) + lineStart)
                lens[idx] = i - lineStart
                idx += 1
                lineStart = i + 1
            }
            i += 1
        }
        if lineStart < data.length {
            ptrs[idx] = @ptrFromInt([*]const u8, @intFromPtr(raw) + lineStart)
            lens[idx] = data.length - lineStart
            idx += 1
        }
        linePtr.* = ptrs
        lineLen.* = lens
        lineCount.* = n
    }
    return true
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: join [OPTION]... FILE1 FILE2\nFor each pair of input lines with identical join fields, write a line to\nstandard output.\n  -a FILENUM              also print unpairable lines from file FILENUM\n  -e STRING                replace missing input fields with STRING\n  -i, --ignore-case        ignore differences in case when comparing fields\n  -j FIELD                 equivalent to '-1 FIELD -2 FIELD'\n  -o FORMAT                obey FORMAT while constructing output line\n  -t CHAR                  use CHAR as input and output field separator\n  -v FILENUM               like -a FILENUM, but suppress joined output lines\n  -1 FIELD                 join on this FIELD of file 1\n  -2 FIELD                 join on this FIELD of file 2\n      --header              treat the first line in each file as field headers\n  -z, --zero-terminated    line delimiter is NUL, not newline\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx join 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("join", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    if options.firstFile + 2 > count {
        common.writeMessage("join", "missing operand")
        return 1
    }
    const path1 = std.process.argument(arguments, options.firstFile)
    const path2 = std.process.argument(arguments, options.firstFile + 1)
    const terminator: u8 = if options.zero { 0 } else { 10 }

    var ptr1: [*][*]const u8 = undefined
    var len1: [*]usize = undefined
    var n1: usize = 0
    if !readLines(path1, terminator, &ptr1, &len1, &n1) { return 1 }
    var ptr2: [*][*]const u8 = undefined
    var len2: [*]usize = undefined
    var n2: usize = 0
    if !readLines(path2, terminator, &ptr2, &len2, &n2) { return 1 }

    const stdout = std.io.stdout()
    var ok = true

    var i: usize = 0
    var j: usize = 0

    if options.header {
        if n1 > 0 && n2 > 0 {
            ok = writeRow(stdout, options, ptr1[0], len1[0], true, options.field1, ptr2[0], len2[0], true, options.field2)
            if ok { ok = std.io.writeAll(stdout, if options.zero { "\0" } else { "\n" }) }
            i = 1
            j = 1
        } else if n1 > 0 {
            i = 1
        } else if n2 > 0 {
            j = 1
        }
    }

    while ok && i < n1 && j < n2 {
        var as: usize = 0
        var ae: usize = 0
        var bs: usize = 0
        var be: usize = 0
        fieldRange(ptr1[i], len1[i], options.field1, options.hasSeparator, options.separator, &as, &ae)
        fieldRange(ptr2[j], len2[j], options.field2, options.hasSeparator, options.separator, &bs, &be)
        const cmp = compareKeys(ptr1[i], as, ae, ptr2[j], bs, be, options.ignoreCase)
        if cmp < 0 {
            if options.print1 {
                ok = writeRow(stdout, options, ptr1[i], len1[i], true, options.field1, ptr1[i], 0, false, options.field2)
                if ok { ok = std.io.writeAll(stdout, if options.zero { "\0" } else { "\n" }) }
            }
            i += 1
        } else if cmp > 0 {
            if options.print2 {
                ok = writeRow(stdout, options, ptr2[j], 0, false, options.field1, ptr2[j], len2[j], true, options.field2)
                if ok { ok = std.io.writeAll(stdout, if options.zero { "\0" } else { "\n" }) }
            }
            j += 1
        } else {
            var iEnd = i
            while iEnd < n1 {
                var as2: usize = 0
                var ae2: usize = 0
                fieldRange(ptr1[iEnd], len1[iEnd], options.field1, options.hasSeparator, options.separator, &as2, &ae2)
                if compareKeys(ptr1[iEnd], as2, ae2, ptr2[j], bs, be, options.ignoreCase) != 0 { break }
                iEnd += 1
            }
            var jEnd = j
            while jEnd < n2 {
                var bs2: usize = 0
                var be2: usize = 0
                fieldRange(ptr2[jEnd], len2[jEnd], options.field2, options.hasSeparator, options.separator, &bs2, &be2)
                if compareKeys(ptr1[i], as, ae, ptr2[jEnd], bs2, be2, options.ignoreCase) != 0 { break }
                jEnd += 1
            }
            if !options.suppressJoined {
                var a = i
                while a < iEnd && ok {
                    var b = j
                    while b < jEnd && ok {
                        ok = writeRow(stdout, options, ptr1[a], len1[a], true, options.field1, ptr2[b], len2[b], true, options.field2)
                        if ok { ok = std.io.writeAll(stdout, if options.zero { "\0" } else { "\n" }) }
                        b += 1
                    }
                    a += 1
                }
            }
            i = iEnd
            j = jEnd
        }
    }
    while ok && i < n1 {
        if options.print1 {
            ok = writeRow(stdout, options, ptr1[i], len1[i], true, options.field1, ptr1[i], 0, false, options.field2)
            if ok { ok = std.io.writeAll(stdout, if options.zero { "\0" } else { "\n" }) }
        }
        i += 1
    }
    while ok && j < n2 {
        if options.print2 {
            ok = writeRow(stdout, options, ptr2[j], 0, false, options.field1, ptr2[j], len2[j], true, options.field2)
            if ok { ok = std.io.writeAll(stdout, if options.zero { "\0" } else { "\n" }) }
        }
        j += 1
    }

    return if ok { 0 } else { 1 }
}
