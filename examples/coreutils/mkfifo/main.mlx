const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    mode: usize
    firstFile: usize
    action: u8
    invalid: bool
}

fn setMode(options: *Options, text: std.string.String) -> void {
    const parsed = common.parseOctal(text)
    if parsed == null || parsed.? > 4095 { options.*.invalid = true } else { options.*.mode = parsed.? }
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .mode = 438, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstFile < count {
        const argument = std.process.argument(arguments, result.firstFile)
        if common.equals(argument, "--") {
            result.firstFile += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "-m") || common.equals(argument, "--mode") {
            result.firstFile += 1
            if result.firstFile >= count { result.invalid = true } else { setMode(&result, std.process.argument(arguments, result.firstFile)) }
        } else if std.string.startsWith(argument, std.string.fromSlice("--mode=")) {
            setMode(&result, std.string.slice(argument, 7, argument.length))
        } else if argument.length > 2 && argument.pointer[1] == 109 {
            setMode(&result, std.string.slice(argument, 2, argument.length))
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else { result.invalid = true }
        result.firstFile += 1
    }
    return result
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: mkfifo [OPTION]... NAME...\nCreate named pipes with the given names.\n  -m, --mode=MODE  set octal permission mode\n      --help       display this help and exit\n      --version    output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx mkfifo 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstFile >= count {
        common.writeMessage("mlx-mkfifo", "missing path or invalid mode")
        return 1
    }
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !std.fs.makeFifo(path.pointer, options.mode) {
            common.writePathError("mlx-mkfifo", "cannot create fifo", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
