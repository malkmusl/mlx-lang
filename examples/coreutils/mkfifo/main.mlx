const std = @import("std")
const common = @import("../common.mlx")
const mode_parser = @import("../mode.mlx")
const security_context = @import("../security_context.mlx")

const Options = struct {
    mode: usize
    modeSet: bool
    contextExplicit: bool
    firstFile: usize
    action: u8
    invalid: bool
}

fn setMode(options: *Options, text: std.string.String) -> void {
    const parsed = mode_parser.parse(text, 438, false, false)
    if !parsed.valid { options.*.invalid = true } else {
        options.*.mode = parsed.value
        options.*.modeSet = true
    }
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const byte = argument.pointer[current]
        if byte == 90 { current += 1 } else if byte == 109 {
            var text = std.string.slice(argument, current + 1, argument.length)
            if text.length == 0 {
                index.* += 1
                if index.* >= std.process.count(arguments) { return false }
                text = std.process.argument(arguments, index.*)
            }
            setMode(options, text)
            return true
        } else { return false }
    }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--mode") {
        index.* += 1
        if index.* >= std.process.count(arguments) { return false }
        setMode(options, std.process.argument(arguments, index.*))
    } else if std.string.startsWith(argument, std.string.fromSlice("--mode=")) {
        setMode(options, std.string.slice(argument, 7, argument.length))
    } else if common.equals(argument, "--context") {
    } else if std.string.startsWith(argument, std.string.fromSlice("--context=")) {
        options.*.contextExplicit = true
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") {
        options.*.action = 2
    } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .mode = 438, .modeSet = false, .contextExplicit = false, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    return result
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: mkfifo [OPTION]... NAME...\nCreate named pipes with the given names.\n  -m, --mode=MODE  set permission mode (as in chmod)\n  -Z, --context[=CTX]  select a security context\n      --help       display this help and exit\n      --version    output version information and exit\n") { 0 } else { 1 }
}

fn createFifo(path: std.string.String, options: Options) -> bool {
    if !std.fs.makeFifo(path.pointer, options.mode) { return false }
    return !options.modeSet || std.fs.chmod(path.pointer, options.mode)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx mkfifo 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstFile >= count {
        common.writeMessage("mkfifo", "missing path or invalid mode")
        return 1
    }
    security_context.warnIfUnavailable(std.string.fromSlice("mkfifo"), options.contextExplicit)
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        if !createFifo(path, options) {
            common.writePathError("mkfifo", "cannot create fifo", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
