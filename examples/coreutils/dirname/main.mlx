const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    zero: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .zero = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstOperand < count {
        const argument = std.process.argument(arguments, result.firstOperand)
        if common.equals(argument, "--") {
            result.firstOperand += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "--zero") { result.zero = true } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else if argument.pointer[1] != 45 {
            var index: usize = 1
            while index < argument.length {
                if argument.pointer[index] == 122 { result.zero = true } else { result.invalid = true }
                index += 1
            }
        } else { result.invalid = true }
        result.firstOperand += 1
    }
    return result
}

fn directoryName(path: std.string.String) -> std.string.String {
    if path.length == 0 { return std.string.fromSlice(".") }
    var end = path.length
    while end > 0 && path.pointer[end - 1] == 47 { end -= 1 }
    if end == 0 { return std.string.fromSlice("/") }
    var slash = end
    while slash > 0 && path.pointer[slash - 1] != 47 { slash -= 1 }
    if slash == 0 { return std.string.fromSlice(".") }
    while slash > 1 && path.pointer[slash - 1] == 47 { slash -= 1 }
    return std.string.slice(path, 0, slash)
}

fn writeDirectory(path: std.string.String, zero: bool) -> bool {
    if !std.io.writeString(std.io.stdout(), directoryName(path)) { return false }
    if !zero { return std.io.print("\n") }
    var terminator: [1]u8 = [1]u8{ 0 }
    unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, terminator[0..1]), 1) }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: dirname [OPTION] NAME...\n  -z, --zero     end each output line with NUL, not newline\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx dirname 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstOperand >= count {
        common.writeMessage("mlx-dirname", "missing or invalid operand")
        return 1
    }
    var index = options.firstOperand
    while index < count {
        if !writeDirectory(std.process.argument(arguments, index), options.zero) { return 1 }
        index += 1
    }
    return 0
}
