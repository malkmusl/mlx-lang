const std = @import("std")
const common = @import("../common.mlx")

const Number = struct {
    value: usize
    valid: bool
}

const Options = struct {
    all: bool
    ignore: usize
    action: u8
    invalid: bool
}

fn parseNumber(value: std.string.String) -> Number {
    if value.length == 0 { return Number.{ .value = 0, .valid = false } }
    var result: usize = 0
    var index: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        if byte < 48 || byte > 57 { return Number.{ .value = 0, .valid = false } }
        const digit = @intCast(usize, byte - 48)
        if result > (18446744073709551615 - digit) / 10 { return Number.{ .value = 0, .valid = false } }
        result = result * 10 + digit
        index += 1
    }
    return Number.{ .value = result, .valid = true }
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .all = false, .ignore = 0, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        var ignored: ?Number = null
        if common.equals(argument, "--all") { result.all = true } else if common.equals(argument, "--ignore") {
            index += 1
            if index >= count { result.invalid = true } else { ignored = parseNumber(std.process.argument(arguments, index)) }
        } else if std.string.startsWith(argument, std.string.fromSlice("--ignore=")) {
            ignored = parseNumber(std.string.slice(argument, 9, argument.length))
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else { result.invalid = true }
        if ignored != null {
            if !ignored.?.valid { result.invalid = true } else { result.ignore = ignored.?.value }
        }
        index += 1
    }
    return result
}

fn segmentCount(segment: std.string.String) -> usize {
    var dash = segment.length
    var index: usize = 0
    while index < segment.length {
        if segment.pointer[index] == 45 {
            dash = index
            break
        }
        index += 1
    }
    const first = parseNumber(std.string.slice(segment, 0, dash))
    if !first.valid { return 0 }
    if dash == segment.length { return 1 }
    const last = parseNumber(std.string.slice(segment, dash + 1, segment.length))
    if !last.valid || last.value < first.value { return 0 }
    return last.value - first.value + 1
}

fn parseProcessorList(value: std.string.String) -> usize {
    var result: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index <= value.length {
        if index == value.length || value.pointer[index] == 44 || value.pointer[index] == 10 {
            if index > start { result += segmentCount(std.string.slice(value, start, index)) }
            if index == value.length || value.pointer[index] == 10 { break }
            start = index + 1
        }
        index += 1
    }
    return result
}

fn configuredProcessorCount() -> usize {
    const path = std.string.fromSlice("/sys/devices/system/cpu/possible")
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return std.os.linux.system.availableProcessorCount() }
    var buffer: [256]u8 = undefined
    var amount: isize = 0
    unsafe { amount = std.fs.read(file, @ptrCast([*]u8, buffer[0..256]), 256) }
    const closed = std.fs.close(file)
    if amount <= 0 { return std.os.linux.system.availableProcessorCount() }
    unsafe {
        const value = std.string.fromParts(@ptrCast([*]const u8, buffer[0..256]), @bitCast(usize, amount))
        const parsed = parseProcessorList(value)
        return if parsed == 0 { std.os.linux.system.availableProcessorCount() } else { parsed }
    }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: nproc [OPTION]...\nPrint the number of available processing units.\n      --all       print installed processors\n      --ignore=N  exclude up to N processors\n      --help      display this help and exit\n      --version   output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx nproc 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("nproc", "invalid option or count")
        return 1
    }
    const processors = if options.all { configuredProcessorCount() } else { std.os.linux.system.availableProcessorCount() }
    const result = if options.ignore >= processors { 1 } else { processors - options.ignore }
    if !std.io.writeUnsigned(std.io.stdout(), result) { return 1 }
    return if std.io.print("\n") { 0 } else { 1 }
}
