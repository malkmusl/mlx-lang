const std = @import("std")

pub fn main(arguments: [][*]const u8) -> u8 {
    if std.process.count(arguments) == 2 {
        const option = std.process.argument(arguments, 1)
        if std.string.eql(option, std.string.fromSlice("--help")) {
            return if std.io.print("Usage: true [ignored command line arguments]\nReturn a successful status code.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
        }
        if std.string.eql(option, std.string.fromSlice("--version")) {
            return if std.io.print("mlx true 0.1.0\n") { 0 } else { 1 }
        }
    }
    return 0
}
