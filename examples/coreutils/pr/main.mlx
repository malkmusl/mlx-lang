const std = @import("std")
const common = @import("../common.mlx")
const timezone = @import("../ls/timezone.mlx")

const Options = struct {
    pageLength: usize
    pageWidth: usize
    omitHeader: bool
    hasHeaderText: bool
    headerText: std.string.String
    numberLines: bool
    numberWidth: usize
    numberSep: u8
    indent: usize
    doubleSpace: bool
    formFeed: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{
        .pageLength = 66, .pageWidth = 72, .omitHeader = false,
        .hasHeaderText = false, .headerText = std.string.fromSlice(""),
        .numberLines = false, .numberWidth = 5, .numberSep = 9,
        .indent = 0, .doubleSpace = false, .formFeed = false,
        .action = 0, .invalid = false, .firstFile = 1,
    }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-t") || common.equals(argument, "--omit-header") || common.equals(argument, "-T") || common.equals(argument, "--omit-pagination") {
            result.omitHeader = true
            index += 1
            continue
        }
        if common.equals(argument, "-d") || common.equals(argument, "--double-space") {
            result.doubleSpace = true
            index += 1
            continue
        }
        if common.equals(argument, "-F") || common.equals(argument, "-f") || common.equals(argument, "--form-feed") {
            result.formFeed = true
            index += 1
            continue
        }
        if common.equals(argument, "-r") || common.equals(argument, "--no-file-warnings") {
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--length=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 9, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.pageLength = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-l") || common.equals(argument, "--length") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.pageLength = parsed.value }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--width=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 8, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.pageWidth = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-w") || common.equals(argument, "--width") || common.equals(argument, "-W") || common.equals(argument, "--page-width") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.pageWidth = parsed.value }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--header=")) {
            result.hasHeaderText = true
            result.headerText = std.string.slice(argument, 9, argument.length)
            index += 1
            continue
        }
        if common.equals(argument, "-h") || common.equals(argument, "--header") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            result.hasHeaderText = true
            result.headerText = std.process.argument(arguments, index)
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--indent=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 9, argument.length))
            if !parsed.valid { result.invalid = true } else { result.indent = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-o") || common.equals(argument, "--indent") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid { result.invalid = true } else { result.indent = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-n") || common.equals(argument, "--number-lines") {
            result.numberLines = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--number-lines=")) {
            result.numberLines = true
            const value = std.string.slice(argument, 15, argument.length)
            if value.length > 0 {
                result.numberSep = value.pointer[0]
                if value.length > 1 {
                    const parsed = std.parse.unsigned(std.string.slice(value, 1, value.length))
                    if parsed.valid { result.numberWidth = parsed.value }
                }
            }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 110 {
            result.numberLines = true
            const value = std.string.slice(argument, 2, argument.length)
            if value.length > 0 && !isDigit(value.pointer[0]) {
                result.numberSep = value.pointer[0]
                if value.length > 1 {
                    const parsed = std.parse.unsigned(std.string.slice(value, 1, value.length))
                    if parsed.valid { result.numberWidth = parsed.value }
                }
            } else if value.length > 0 {
                const parsed = std.parse.unsigned(value)
                if parsed.valid { result.numberWidth = parsed.value }
            }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 111 {
            const parsed = std.parse.unsigned(std.string.slice(argument, 2, argument.length))
            if !parsed.valid { result.invalid = true } else { result.indent = parsed.value }
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 108 {
            const parsed = std.parse.unsigned(std.string.slice(argument, 2, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.pageLength = parsed.value }
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    if result.pageLength <= 10 { result.omitHeader = true }
    result.firstFile = index
    return result
}

const Calendar = struct {
    year: isize
    month: usize
    day: usize
    hour: usize
    minute: usize
}

fn leap(year: isize) -> bool { return year % 4 == 0 && year % 100 != 0 || year % 400 == 0 }

fn monthDays(year: isize, month: usize) -> usize {
    if month == 2 { return if leap(year) { 29 } else { 28 } }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

fn floorDays(seconds: isize) -> isize {
    if seconds >= 0 { return seconds / 86400 }
    return -((-seconds + 86399) / 86400)
}

fn calendarFromSeconds(seconds: isize) -> Calendar {
    const days = floorDays(seconds)
    const clock = @intCast(usize, seconds - days * 86400)
    const shifted = days + 719468
    const era = if shifted >= 0 { shifted / 146097 } else { (shifted - 146096) / 146097 }
    const dayOfEra = shifted - era * 146097
    const yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var year = yearOfEra + era * 400
    const dayOfYearMarch = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    const monthPart = (5 * dayOfYearMarch + 2) / 153
    const day = dayOfYearMarch - (153 * monthPart + 2) / 5 + 1
    const month = if monthPart < 10 { monthPart + 3 } else { monthPart - 9 }
    if month <= 2 { year += 1 }
    return Calendar.{ .year = year, .month = @intCast(usize, month), .day = @intCast(usize, day), .hour = clock / 3600, .minute = clock / 60 % 60 }
}

fn digitsOf(value: usize) -> usize {
    var result: usize = 1
    var remaining = value
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn writeNumber(file: std.fs.File, value: usize, width: usize, pad: u8) -> bool {
    const length = digitsOf(value)
    var padCount = if width > length { width - length } else { 0 }
    while padCount > 0 {
        if !std.io.writeAll(file, if pad == 48 { "0" } else { " " }) { return false }
        padCount -= 1
    }
    return std.io.writeUnsigned(file, value)
}

fn writeSpaces(file: std.fs.File, count: usize) -> bool {
    var i: usize = 0
    while i < count {
        if !std.io.writeAll(file, " ") { return false }
        i += 1
    }
    return true
}

fn dateTimeText(buffer: [*]u8) -> usize {
    const zone = timezone.init(std.string.fromSlice(""))
    const now = std.time.realtime()
    const offset = timezone.offset(zone, now.seconds)
    const value = calendarFromSeconds(now.seconds + offset)
    timezone.deinit(zone)
    var pos: usize = 0
    var digits: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    var y = value.year
    if y < 0 { y = 0 }
    digits[0] = 48 + @intCast(u8, (y / 1000) % 10)
    digits[1] = 48 + @intCast(u8, (y / 100) % 10)
    digits[2] = 48 + @intCast(u8, (y / 10) % 10)
    digits[3] = 48 + @intCast(u8, y % 10)
    var i: usize = 0
    while i < 4 {
        buffer[pos] = digits[i]
        pos += 1
        i += 1
    }
    buffer[pos] = 45
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.month / 10)
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.month % 10)
    pos += 1
    buffer[pos] = 45
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.day / 10)
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.day % 10)
    pos += 1
    buffer[pos] = 32
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.hour / 10)
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.hour % 10)
    pos += 1
    buffer[pos] = 58
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.minute / 10)
    pos += 1
    buffer[pos] = 48 + @intCast(u8, value.minute % 10)
    pos += 1
    return pos
}

fn writeHeaderLine(file: std.fs.File, options: Options, dateText: [*]const u8, dateLength: usize, headerText: std.string.String, pageNumber: usize) -> bool {
    unsafe { if !std.io.writeAllBytes(file, dateText, dateLength) { return false } }
    const pageDigits = digitsOf(pageNumber)
    const pagePartLength = 5 + pageDigits
    if options.pageWidth <= dateLength + pagePartLength { return std.io.print("Page ") && std.io.writeUnsigned(file, pageNumber) }
    const midWidth = options.pageWidth - dateLength - pagePartLength
    const headerLength = if headerText.length < midWidth { headerText.length } else { midWidth }
    const leftPad = (midWidth - headerLength) / 2
    const rightPad = midWidth - headerLength - leftPad
    if !writeSpaces(file, leftPad) { return false }
    if headerLength > 0 { if !std.io.writeAllBytes(file, headerText.pointer, headerLength) { return false } }
    if !writeSpaces(file, rightPad) { return false }
    if !std.io.print("Page ") { return false }
    return std.io.writeUnsigned(file, pageNumber)
}

fn writeSep(file: std.fs.File, sep: u8) -> bool {
    var buffer: [1]u8 = [1]u8{ sep }
    unsafe { return std.io.writeAllBytes(file, @ptrCast([*]const u8, buffer[0..1]), 1) }
}

fn processLines(options: Options, path: std.string.String, displayName: std.string.String, linePtr: [*][*]const u8, lineLen: [*]usize, totalLines: usize, dateText: [*]const u8, dateLength: usize) -> bool {
    const stdout = std.io.stdout()
    const headerText = if options.hasHeaderText { options.headerText } else { displayName }
    var headerTrailer: usize = 0
    if !options.omitHeader { headerTrailer = if options.formFeed { 5 } else { 10 } }
    const contentBudget = if options.pageLength > headerTrailer { options.pageLength - headerTrailer } else { 1 }
    const effectiveBudget = if options.doubleSpace { if contentBudget > 1 { contentBudget / 2 } else { 1 } } else { contentBudget }

    var lineNumberCounter: usize = 1
    var pageNumber: usize = 1
    var lineIndex: usize = 0
    var ok = true
    var producedPage = false
    while ok && (lineIndex < totalLines || !producedPage) {
        producedPage = true
        if !options.omitHeader {
            if !std.io.print("\n\n") { ok = false }
            if ok && !writeHeaderLine(stdout, options, dateText, dateLength, headerText, pageNumber) { ok = false }
            if ok && !std.io.print("\n\n\n") { ok = false }
        }
        const remaining = if lineIndex < totalLines { totalLines - lineIndex } else { 0 }
        const linesThisPage = if effectiveBudget < remaining { effectiveBudget } else { remaining }
        const padContent = !options.omitHeader && !options.formFeed
        const slotBound = if padContent { effectiveBudget } else { linesThisPage }
        var slot: usize = 0
        while ok && slot < slotBound {
            if !writeSpaces(stdout, options.indent) { ok = false }
            if ok && slot < linesThisPage {
                if options.numberLines {
                    if !writeNumber(stdout, lineNumberCounter, options.numberWidth, 32) { ok = false }
                    if ok && !writeSep(stdout, options.numberSep) { ok = false }
                    lineNumberCounter += 1
                }
                if ok && lineLen[lineIndex + slot] > 0 {
                    unsafe { if !std.io.writeAllBytes(stdout, linePtr[lineIndex + slot], lineLen[lineIndex + slot]) { ok = false } }
                }
            }
            if ok && !std.io.print("\n") { ok = false }
            if ok && options.doubleSpace && !std.io.print("\n") { ok = false }
            slot += 1
        }
        if ok {
            if options.formFeed && !options.omitHeader {
                var ffBuffer: [1]u8 = [1]u8{ 12 }
                unsafe { ok = std.io.writeAllBytes(stdout, @ptrCast([*]const u8, ffBuffer[0..1]), 1) }
            } else if !options.omitHeader {
                ok = std.io.print("\n\n\n\n\n")
            }
        }
        lineIndex += linesThisPage
        pageNumber += 1
    }
    return ok
}

fn readAll(path: std.string.String, ok: *bool) -> std.fs.ArrayList {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if common.isDash(path) {
        ok.* = true
        return std.fs.readToEndAlloc(std.io.stdin(), allocator)
    }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("pr", path)
        ok.* = false
        return std.array_list.ArrayList.init(allocator, 0)
    }
    ok.* = true
    const data = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return data
}

fn processPath(options: Options, path: std.string.String, dateText: [*]const u8, dateLength: usize) -> bool {
    var opened = false
    const data = readAll(path, &opened)
    if !opened {
        data.deinit()
        return false
    }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var ok = true
    unsafe {
        var raw: [*]const u8 = undefined
        raw = @ptrCast([*]const u8, data.items)
        var totalLines: usize = 0
        var i: usize = 0
        while i < data.length {
            if raw[i] == 10 { totalLines += 1 }
            i += 1
        }
        if data.length > 0 && raw[data.length - 1] != 10 { totalLines += 1 }
        var linePtr: [*][*]const u8 = undefined
        var lineLen: [*]usize = undefined
        if totalLines > 0 {
            const ptrAlloc = allocator.alloc(totalLines * 8, 8)
            const lenAlloc = allocator.alloc(totalLines * 8, 8)
            linePtr = @ptrCast([*][*]const u8, ptrAlloc.?)
            lineLen = @ptrCast([*]usize, lenAlloc.?)
            var idx: usize = 0
            var lineStart: usize = 0
            i = 0
            while i < data.length {
                if raw[i] == 10 {
                    linePtr[idx] = @ptrFromInt([*]const u8, @intFromPtr(raw) + lineStart)
                    lineLen[idx] = i - lineStart
                    idx += 1
                    lineStart = i + 1
                }
                i += 1
            }
            if lineStart < data.length {
                linePtr[idx] = @ptrFromInt([*]const u8, @intFromPtr(raw) + lineStart)
                lineLen[idx] = data.length - lineStart
                idx += 1
            }
        }
        const displayName = if common.isDash(path) { std.string.fromSlice("<standard input>") } else { path }
        ok = processLines(options, path, displayName, linePtr, lineLen, totalLines, dateText, dateLength)
    }
    data.deinit()
    return ok
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: pr [OPTION]... [FILE]...\nPaginate or columnate FILE(s) for printing.\n  -d, --double-space         double space the output\n  -F, -f, --form-feed        use form feeds instead of newlines to separate pages\n  -h, --header=HEADER        use a centered HEADER instead of filename\n  -l, --length=PAGE_LENGTH   set the page length (66)\n  -n[SEP[DIGITS]], --number-lines[=SEP[DIGITS]]  number lines\n  -o, --indent=MARGIN        offset each line with MARGIN spaces\n  -t, --omit-header          omit page headers and trailers\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx pr 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("pr", "invalid option")
        return 1
    }
    var dateBuffer: [32]u8 = undefined
    var dateLength: usize = 0
    unsafe { dateLength = dateTimeText(@ptrCast([*]u8, dateBuffer[0..32])) }

    const count = std.process.count(arguments)
    var status: u8 = 0
    unsafe {
        if options.firstFile >= count {
            if !processPath(options, std.string.fromSlice("-"), @ptrCast([*]const u8, dateBuffer[0..32]), dateLength) { status = 1 }
        } else {
            var index = options.firstFile
            while index < count {
                if !processPath(options, std.process.argument(arguments, index), @ptrCast([*]const u8, dateBuffer[0..32]), dateLength) { status = 1 }
                index += 1
            }
        }
    }
    return status
}

