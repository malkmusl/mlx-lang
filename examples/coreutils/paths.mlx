const std = @import("std")
const common = @import("./common.mlx")

pub fn basename(path: std.string.String) -> std.string.String {
    var end = path.length
    while end > 1 && path.pointer[end - 1] == 47 { end -= 1 }
    var start = end
    while start > 0 && path.pointer[start - 1] != 47 { start -= 1 }
    return std.string.slice(path, start, end)
}

pub fn join(directory: std.string.String, name: std.string.String) -> ?common.MutablePath {
    const separator: usize = if directory.length > 0 && directory.pointer[directory.length - 1] == 47 { 0 } else { 1 }
    if directory.length > 18446744073709551614 - separator - name.length { return null }
    const length = directory.length + separator + name.length
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, length + 1, 1)
    if allocation == null { return null }
    const pointer = allocation.?
    var index: usize = 0
    while index < directory.length {
        pointer[index] = directory.pointer[index]
        index += 1
    }
    if separator == 1 {
        pointer[index] = 47
        index += 1
    }
    var source: usize = 0
    while source < name.length {
        pointer[index] = name.pointer[source]
        index += 1
        source += 1
    }
    pointer[length] = 0
    return common.MutablePath.{ .pointer = pointer, .length = length }
}
