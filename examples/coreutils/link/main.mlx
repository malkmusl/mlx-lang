const std = @import("std")
const common = @import("../common.mlx")

fn printHelp() -> u8 {
    return if std.io.print("Usage: link FILE1 FILE2\nCreate a hard link named FILE2 to FILE1.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--help") { return printHelp() }
    if count == 2 && common.equals(std.process.argument(arguments, 1), "--version") {
        return if std.io.print("mlx link 0.1.0\n") { 0 } else { 1 }
    }
    const first: usize = if count > 1 && common.equals(std.process.argument(arguments, 1), "--") { 2 } else { 1 }
    if count != first + 2 {
        common.writeMessage("mlx-link", "expected source and destination")
        return 1
    }
    const source = std.process.argument(arguments, first)
    const destination = std.process.argument(arguments, first + 1)
    if !std.fs.hardLink(source.pointer, destination.pointer) {
        common.writePathError("mlx-link", "cannot create link", destination)
        return 1
    }
    return 0
}
