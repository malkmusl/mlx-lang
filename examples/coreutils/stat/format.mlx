const std = @import("std")
const accounts = @import("../ownership/accounts.mlx")

pub const Context = struct {
    path: std.string.String
    status: std.fs.Stat
    dereference: bool
    birthSeconds: isize
    birthNanoseconds: isize
    birthKnown: bool
}

fn writeUnsigned(value: usize, base: usize) -> bool {
    var buffer: [64]u8 = undefined
    var index: usize = 64
    var remaining = value
    if remaining == 0 {
        index -= 1
        buffer[index] = 48
    }
    while remaining > 0 {
        const digit = remaining % base
        index -= 1
        buffer[index] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        remaining /= base
    }
    return std.io.writeAll(std.io.stdout(), buffer[index..64])
}

fn writeSigned(value: isize) -> bool {
    if value >= 0 { return writeUnsigned(@bitCast(usize, value), 10) }
    if !std.io.print("-") { return false }
    const magnitude = @bitCast(usize, -(value + 1)) + 1
    return writeUnsigned(magnitude, 10)
}

fn fileTypeValue(mode: usize) -> usize { return mode & 61440 }

fn typeCharacter(mode: usize) -> u8 {
    const kind = fileTypeValue(mode)
    if kind == 16384 { return 100 }
    if kind == 40960 { return 108 }
    if kind == 24576 { return 98 }
    if kind == 8192 { return 99 }
    if kind == 4096 { return 112 }
    if kind == 49152 { return 115 }
    return if kind == 32768 { 45 } else { 63 }
}

fn fileTypeName(mode: usize) -> []const u8 {
    const kind = fileTypeValue(mode)
    if kind == 16384 { return "directory" }
    if kind == 40960 { return "symbolic link" }
    if kind == 24576 { return "block special file" }
    if kind == 8192 { return "character special file" }
    if kind == 4096 { return "fifo" }
    if kind == 49152 { return "socket" }
    if kind == 32768 { return if mode & 73 != 0 { "regular file" } else { "regular file" } }
    return "unknown"
}

fn executeCharacter(mode: usize, execute: usize, special: usize, lower: u8, upper: u8) -> u8 {
    if mode & special != 0 { return if mode & execute != 0 { lower } else { upper } }
    return if mode & execute != 0 { 120 } else { 45 }
}

fn writePermissions(mode: usize) -> bool {
    var text: [10]u8 = undefined
    text[0] = typeCharacter(mode)
    text[1] = if mode & 256 != 0 { 114 } else { 45 }
    text[2] = if mode & 128 != 0 { 119 } else { 45 }
    text[3] = executeCharacter(mode, 64, 2048, 115, 83)
    text[4] = if mode & 32 != 0 { 114 } else { 45 }
    text[5] = if mode & 16 != 0 { 119 } else { 45 }
    text[6] = executeCharacter(mode, 8, 1024, 115, 83)
    text[7] = if mode & 4 != 0 { 114 } else { 45 }
    text[8] = if mode & 2 != 0 { 119 } else { 45 }
    text[9] = executeCharacter(mode, 1, 512, 116, 84)
    return std.io.writeAll(std.io.stdout(), text[0..10])
}

fn deviceMajor(device: usize) -> usize {
    return (device & 1048320) >> 8 | (device & 18446726481523507200) >> 32
}

fn deviceMinor(device: usize) -> usize {
    return device & 255 | (device & 17592184995840) >> 12
}

fn writeQuotedName(context: Context) -> bool {
    if !std.io.print("'") || !std.io.printString(context.path) || !std.io.print("'") { return false }
    if context.dereference || fileTypeValue(@intCast(usize, context.status.mode)) != 40960 { return true }
    var target: [4096]u8 = undefined
    const length = std.fs.readLink(context.path.pointer, @ptrCast([*]u8, target[0..4096]), 4096)
    if length < 0 { return true }
    if !std.io.print(" -> '") { return false }
    if !std.io.writeAll(std.io.stdout(), target[0..@bitCast(usize, length)]) { return false }
    return std.io.print("'")
}

fn writeHumanTime(seconds: isize, nanoseconds: isize) -> bool {
    if !writeSigned(seconds) || !std.io.print(".") { return false }
    var divisor: usize = 100000000
    const value = @bitCast(usize, nanoseconds)
    while divisor > 0 {
        const digit = value / divisor % 10
        const byte = [1]u8{@intCast(u8, digit + 48)}
        if !std.io.writeAll(std.io.stdout(), byte[0..1]) { return false }
        divisor /= 10
    }
    return true
}

fn writeDevice(context: Context, modifier: u8, raw: bool) -> bool {
    const device = if raw { context.status.specialDevice } else { context.status.device }
    if modifier == 72 { return writeUnsigned(deviceMajor(device), 10) }
    if modifier == 76 { return writeUnsigned(deviceMinor(device), 10) }
    return writeUnsigned(device, if raw { 10 } else { 10 })
}

fn writeTime(context: Context, specifier: u8) -> bool {
    if specifier == 87 { return writeSigned(if context.birthKnown { context.birthSeconds } else { 0 }) }
    if specifier == 119 {
        if !context.birthKnown { return std.io.print("-") }
        return writeHumanTime(context.birthSeconds, context.birthNanoseconds)
    }
    if specifier == 88 { return writeSigned(context.status.accessedSeconds) }
    if specifier == 89 { return writeSigned(context.status.modifiedSeconds) }
    if specifier == 90 { return writeSigned(context.status.changedSeconds) }
    if specifier == 120 { return writeHumanTime(context.status.accessedSeconds, context.status.accessedNanoseconds) }
    if specifier == 121 { return writeHumanTime(context.status.modifiedSeconds, context.status.modifiedNanoseconds) }
    return writeHumanTime(context.status.changedSeconds, context.status.changedNanoseconds)
}

fn writeNumeric(context: Context, specifier: u8, modifier: u8) -> bool {
    const status = context.status
    if specifier == 97 { return writeUnsigned(@intCast(usize, status.mode) & 4095, 8) }
    if specifier == 98 { return writeSigned(status.blocks) }
    if specifier == 66 { return writeUnsigned(512, 10) }
    if specifier == 100 { return writeDevice(context, modifier, false) }
    if specifier == 68 { return writeUnsigned(status.device, 16) }
    if specifier == 102 { return writeUnsigned(@intCast(usize, status.mode), 16) }
    if specifier == 103 { return writeUnsigned(@intCast(usize, status.group), 10) }
    if specifier == 104 { return writeUnsigned(status.links, 10) }
    if specifier == 105 { return writeUnsigned(status.inode, 10) }
    if specifier == 111 { return writeSigned(status.blockSize) }
    if specifier == 115 { return writeSigned(status.size) }
    if specifier == 114 { return writeDevice(context, modifier, true) }
    if specifier == 82 { return writeUnsigned(status.specialDevice, 16) }
    if specifier == 116 { return writeUnsigned(deviceMajor(status.specialDevice), 16) }
    if specifier == 84 { return writeUnsigned(deviceMinor(status.specialDevice), 16) }
    if specifier == 117 { return writeUnsigned(@intCast(usize, status.user), 10) }
    return false
}

fn writeSpecifier(context: Context, specifier: u8, modifier: u8) -> bool {
    if specifier == 65 { return writePermissions(@intCast(usize, context.status.mode)) }
    if specifier == 70 { return std.io.writeAll(std.io.stdout(), fileTypeName(@intCast(usize, context.status.mode))) }
    if specifier == 109 { return std.io.print("/") }
    if specifier == 110 { return std.io.printString(context.path) }
    if specifier == 78 { return writeQuotedName(context) }
    if specifier == 67 { return std.io.print("?") }
    if specifier == 71 { return accounts.writeGroupName(context.status.group, std.io.stdout()) }
    if specifier == 85 { return accounts.writeUserName(context.status.user, std.io.stdout()) }
    if specifier == 119 || specifier == 87 || specifier == 120 || specifier == 88 || specifier == 121 || specifier == 89 || specifier == 122 || specifier == 90 {
        return writeTime(context, specifier)
    }
    return writeNumeric(context, specifier, modifier)
}

fn isFlag(byte: u8) -> bool {
    return byte == 35 || byte == 48 || byte == 45 || byte == 43 || byte == 32 || byte == 39
}

fn writePercent(context: Context, format: std.string.String, index: *usize) -> bool {
    index.* += 1
    if index.* >= format.length { return false }
    if format.pointer[index.*] == 37 { return std.io.print("%") }
    while index.* < format.length && isFlag(format.pointer[index.*]) { index.* += 1 }
    while index.* < format.length && format.pointer[index.*] >= 48 && format.pointer[index.*] <= 57 { index.* += 1 }
    if index.* < format.length && format.pointer[index.*] == 46 {
        index.* += 1
        while index.* < format.length && format.pointer[index.*] >= 48 && format.pointer[index.*] <= 57 { index.* += 1 }
    }
    var modifier: u8 = 0
    if index.* < format.length && (format.pointer[index.*] == 72 || format.pointer[index.*] == 76) {
        modifier = format.pointer[index.*]
        index.* += 1
    }
    if index.* >= format.length { return false }
    return writeSpecifier(context, format.pointer[index.*], modifier)
}

fn escapedByte(byte: u8) -> u8 {
    if byte == 97 { return 7 }
    if byte == 98 { return 8 }
    if byte == 101 { return 27 }
    if byte == 102 { return 12 }
    if byte == 110 { return 10 }
    if byte == 114 { return 13 }
    if byte == 116 { return 9 }
    if byte == 118 { return 11 }
    return byte
}

fn writeLiteral(format: std.string.String, index: *usize, escapes: bool) -> bool {
    var byte = format.pointer[index.*]
    if escapes && byte == 92 && index.* + 1 < format.length {
        index.* += 1
        byte = escapedByte(format.pointer[index.*])
    }
    const value = [1]u8{byte}
    return std.io.writeAll(std.io.stdout(), value[0..1])
}

pub fn write(context: Context, format: std.string.String, escapes: bool, newline: bool) -> bool {
    var index: usize = 0
    while index < format.length {
        const success = if format.pointer[index] == 37 { writePercent(context, format, &index) } else { writeLiteral(format, &index, escapes) }
        if !success { return false }
        index += 1
    }
    return !newline || std.io.print("\n")
}
