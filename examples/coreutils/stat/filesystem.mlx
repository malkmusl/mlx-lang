const std = @import("std")

pub const Context = struct {
    path: std.string.String
    status: std.fs.FileSystemStat
}

fn writeUnsigned(value: usize, base: usize) -> bool {
    var buffer: [64]u8 = undefined
    var index: usize = 64
    var remaining = value
    if remaining == 0 {
        index -= 1
        buffer[index] = 48
    }
    while remaining > 0 {
        const digit = remaining % base
        index -= 1
        buffer[index] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        remaining /= base
    }
    return std.io.writeAll(std.io.stdout(), buffer[index..64])
}

fn typeName(value: usize) -> []const u8 {
    if value == 16914836 { return "tmpfs" }
    if value == 61267 { return "ext2/ext3" }
    if value == 2435016766 { return "btrfs" }
    if value == 2035054128 { return "overlayfs" }
    if value == 1481003842 { return "xfs" }
    if value == 40864 { return "proc" }
    if value == 1650812274 { return "sysfs" }
    if value == 1936814952 { return "squashfs" }
    return "UNKNOWN"
}

fn identifier(status: std.fs.FileSystemStat) -> usize {
    const low = @bitCast(usize, @intCast(isize, status.fileSystemId0)) & 4294967295
    const high = @bitCast(usize, @intCast(isize, status.fileSystemId1)) & 4294967295
    return low << 32 | high
}

fn writeSpecifier(context: Context, specifier: u8) -> bool {
    const status = context.status
    if specifier == 97 { return writeUnsigned(status.blocksAvailable, 10) }
    if specifier == 98 { return writeUnsigned(status.blocks, 10) }
    if specifier == 99 { return writeUnsigned(status.files, 10) }
    if specifier == 100 { return writeUnsigned(status.filesFree, 10) }
    if specifier == 102 { return writeUnsigned(status.blocksFree, 10) }
    if specifier == 105 { return writeUnsigned(identifier(status), 16) }
    if specifier == 108 { return writeUnsigned(@bitCast(usize, status.nameLength), 10) }
    if specifier == 110 { return std.io.printString(context.path) }
    if specifier == 115 { return writeUnsigned(@bitCast(usize, status.blockSize), 10) }
    if specifier == 83 { return writeUnsigned(@bitCast(usize, status.fragmentSize), 10) }
    if specifier == 116 { return writeUnsigned(@bitCast(usize, status.fileSystemType), 16) }
    if specifier == 84 { return std.io.writeAll(std.io.stdout(), typeName(@bitCast(usize, status.fileSystemType))) }
    return false
}

fn writePercent(context: Context, format: std.string.String, index: *usize) -> bool {
    index.* += 1
    if index.* >= format.length { return false }
    if format.pointer[index.*] == 37 { return std.io.print("%") }
    while index.* < format.length && format.pointer[index.*] != 97 && format.pointer[index.*] != 98 && format.pointer[index.*] != 99 && format.pointer[index.*] != 100 && format.pointer[index.*] != 102 && format.pointer[index.*] != 105 && format.pointer[index.*] != 108 && format.pointer[index.*] != 110 && format.pointer[index.*] != 115 && format.pointer[index.*] != 83 && format.pointer[index.*] != 116 && format.pointer[index.*] != 84 {
        index.* += 1
    }
    return index.* < format.length && writeSpecifier(context, format.pointer[index.*])
}

fn escapedByte(byte: u8) -> u8 {
    if byte == 110 { return 10 }
    if byte == 116 { return 9 }
    if byte == 114 { return 13 }
    if byte == 98 { return 8 }
    return byte
}

pub fn write(context: Context, format: std.string.String, escapes: bool, newline: bool) -> bool {
    var index: usize = 0
    while index < format.length {
        var success = true
        if format.pointer[index] == 37 {
            success = writePercent(context, format, &index)
        } else {
            var byte = format.pointer[index]
            if escapes && byte == 92 && index + 1 < format.length {
                index += 1
                byte = escapedByte(format.pointer[index])
            }
            const value = [1]u8{byte}
            success = std.io.writeAll(std.io.stdout(), value[0..1])
        }
        if !success { return false }
        index += 1
    }
    return !newline || std.io.print("\n")
}
