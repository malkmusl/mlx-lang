const std = @import("std")
const common = @import("../common.mlx")
const file_format = @import("./format.mlx")
const file_system = @import("./filesystem.mlx")

const Options = struct {
    dereference: bool
    fileSystem: bool
    terse: bool
    format: std.string.String
    formatSet: bool
    printf: bool
    firstFile: usize
    action: u8
    invalid: bool
}

fn emptyOptions() -> Options {
    return Options.{ .dereference = false, .fileSystem = false, .terse = false, .format = std.string.fromSlice(""), .formatSet = false, .printf = false, .firstFile = 1, .action = 0, .invalid = false }
}

fn optionValue(arguments: [][*]const u8, index: *usize, attached: std.string.String) -> ?std.string.String {
    if attached.length > 0 { return attached }
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn setFormat(options: *Options, value: ?std.string.String, printf: bool) -> bool {
    if value == null { return false }
    options.*.format = value.?
    options.*.formatSet = true
    options.*.printf = printf
    return true
}

fn validCacheMode(value: std.string.String) -> bool {
    return common.equals(value, "always") || common.equals(value, "never") || common.equals(value, "default")
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--dereference") { options.*.dereference = true } else if common.equals(argument, "--file-system") {
        options.*.fileSystem = true
    } else if common.equals(argument, "--terse") { options.*.terse = true } else if common.equals(argument, "--help") {
        options.*.action = 1
    } else if common.equals(argument, "--version") { options.*.action = 2 } else if std.string.startsWith(argument, std.string.fromSlice("--format=")) {
        return setFormat(options, std.string.slice(argument, 9, argument.length), false)
    } else if std.string.startsWith(argument, std.string.fromSlice("--printf=")) {
        return setFormat(options, std.string.slice(argument, 9, argument.length), true)
    } else if common.equals(argument, "--format") || common.equals(argument, "--printf") {
        const value = optionValue(arguments, index, std.string.fromSlice(""))
        return setFormat(options, value, argument.pointer[2] == 112)
    } else if std.string.startsWith(argument, std.string.fromSlice("--cached=")) {
        return validCacheMode(std.string.slice(argument, 9, argument.length))
    } else { return false }
    return true
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const byte = argument.pointer[current]
        if byte == 76 { options.*.dereference = true } else if byte == 102 { options.*.fileSystem = true } else if byte == 116 {
            options.*.terse = true
        } else if byte == 99 {
            const attached = std.string.slice(argument, current + 1, argument.length)
            return setFormat(options, optionValue(arguments, index, attached), false)
        } else { return false }
        current += 1
    }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = emptyOptions()
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    return result
}

fn selectedFormat(options: Options) -> std.string.String {
    if options.formatSet { return options.format }
    if options.fileSystem && options.terse { return std.string.fromSlice("%n %i %l %t %s %S %b %f %a %c %d") }
    if options.fileSystem { return std.string.fromSlice("  File: %n\n    ID: %i Namelen: %l Type: %T\nBlock size: %s Fundamental block size: %S\nBlocks: Total: %b Free: %f Available: %a\nInodes: Total: %c Free: %d") }
    if options.terse { return std.string.fromSlice("%n %s %b %f %u %g %D %i %h %t %T %X %Y %Z %W %o") }
    return std.string.fromSlice("  File: %N\n  Size: %s Blocks: %b IO Block: %o %F\nDevice: %d Inode: %i Links: %h\nAccess: (%a/%A) Uid: (%u/%U) Gid: (%g/%G)\nAccess: %x\nModify: %y\nChange: %z\n Birth: %w")
}

fn printFile(path: std.string.String, options: Options) -> bool {
    var status: std.fs.Stat = undefined
    if std.fs.statusAt(path.pointer, &status, !options.dereference) != 0 {
        common.writePathError("mlx-stat", "cannot stat", path)
        return false
    }
    var extended: std.fs.Statx = undefined
    const has_extended = std.fs.extendedStatus(path.pointer, &extended, !options.dereference) == 0
    const has_birth = has_extended && extended.mask & 2048 != 0
    const context = file_format.Context.{
        .path = path,
        .status = status,
        .dereference = options.dereference,
        .birthSeconds = if has_birth { extended.born.seconds } else { 0 },
        .birthNanoseconds = if has_birth { @intCast(isize, extended.born.nanoseconds) } else { 0 },
        .birthKnown = has_birth,
    }
    return file_format.write(context, selectedFormat(options), options.printf, !options.printf)
}

fn printFileSystem(path: std.string.String, options: Options) -> bool {
    var status: std.fs.FileSystemStat = undefined
    if std.fs.fileSystemStatus(path.pointer, &status) != 0 {
        common.writePathError("mlx-stat", "cannot read file system", path)
        return false
    }
    const context = file_system.Context.{ .path = path, .status = status }
    return file_system.write(context, selectedFormat(options), options.printf, !options.printf)
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: stat [OPTION]... FILE...\n  -L, --dereference     follow links\n  -f, --file-system    display file system status\n  -c, --format=FORMAT  use FORMAT and append a newline\n      --printf=FORMAT  interpret escapes without an implicit newline\n  -t, --terse          print terse information\n      --cached=MODE    select cached attribute policy\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx stat 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstFile >= count {
        common.writeMessage("mlx-stat", "missing operand or invalid option")
        return 1
    }
    var success = true
    var index = options.firstFile
    while index < count {
        const path = std.process.argument(arguments, index)
        const printed = if options.fileSystem { printFileSystem(path, options) } else { printFile(path, options) }
        if !printed { success = false }
        index += 1
    }
    return if success { 0 } else { 1 }
}
