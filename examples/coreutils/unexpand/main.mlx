const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    tabWidth: usize
    all: bool
    firstOnly: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .tabWidth = 8, .all = false, .firstOnly = false, .action = 0, .invalid = false, .firstFile = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "--first-only") {
            result.firstOnly = true
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--tabs=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 7, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.tabWidth = parsed.value }
            result.all = true
            index += 1
            continue
        }
        if common.equals(argument, "-a") || common.equals(argument, "--all") {
            result.all = true
            index += 1
            continue
        }
        if common.equals(argument, "-t") || common.equals(argument, "--tabs") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.tabWidth = parsed.value }
            result.all = true
            index += 1
            continue
        }
        if argument.length > 2 && argument.pointer[1] == 116 {
            const text = std.string.slice(argument, 2, argument.length)
            const parsed = std.parse.unsigned(text)
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.tabWidth = parsed.value }
            result.all = true
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn writeSpaces(file: std.fs.File, count: usize) -> bool {
    var i: usize = 0
    while i < count {
        if !std.io.writeAll(file, " ") { return false }
        i += 1
    }
    return true
}

fn writeTabsForSpan(file: std.fs.File, tab_width: usize, start_col: usize, end_col: usize) -> bool {
    var col = start_col
    while true {
        const next_stop = col + (tab_width - (col % tab_width))
        if next_stop > end_col { break }
        if next_stop - col >= 2 {
            if !std.io.writeAll(file, "\t") { return false }
        } else {
            if !writeSpaces(file, next_stop - col) { return false }
        }
        col = next_stop
    }
    if end_col > col {
        if !writeSpaces(file, end_col - col) { return false }
    }
    return true
}

fn unexpandLine(file: std.fs.File, line: [*]const u8, length: usize, options: Options, trailing_newline: bool) -> bool {
    var column: usize = 0
    var non_blank_seen = false
    var blank_start_col: usize = 0
    var blank_run = false
    var i: usize = 0
    while i < length {
        const byte = line[i]
        const is_blank = byte == 32 || byte == 9
        const converting = options.all || !non_blank_seen
        if is_blank && converting {
            if !blank_run {
                blank_run = true
                blank_start_col = column
            }
            if byte == 9 { column += options.tabWidth - (column % options.tabWidth) } else { column += 1 }
        } else {
            if blank_run {
                if !writeTabsForSpan(file, options.tabWidth, blank_start_col, column) { return false }
                blank_run = false
            }
            var buffer: [1]u8 = [1]u8{ byte }
            unsafe { if !std.io.writeAllBytes(file, @ptrCast([*]const u8, buffer[0..1]), 1) { return false } }
            column += 1
            if !is_blank { non_blank_seen = true }
        }
        i += 1
    }
    if blank_run {
        if !writeTabsForSpan(file, options.tabWidth, blank_start_col, column) { return false }
    }
    if trailing_newline { return std.io.writeAll(file, "\n") }
    return true
}

fn processBuffer(file: std.fs.File, options: Options, data: [*]const u8, length: usize) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index < length {
        if data[index] == 10 {
            var line: [*]const u8 = undefined
            unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
            if !unexpandLine(file, line, index - start, options, true) { return false }
            start = index + 1
        }
        index += 1
    }
    if start < length {
        var line: [*]const u8 = undefined
        unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
        if !unexpandLine(file, line, length - start, options, false) { return false }
    }
    return true
}

fn processFile(file: std.fs.File, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(file, allocator)
    var ok = true
    unsafe {
        ok = processBuffer(std.io.stdout(), options, @ptrCast([*]const u8, data.items), data.length)
    }
    data.deinit()
    return ok
}

fn processPath(path: std.string.String, options: Options) -> bool {
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("unexpand", path)
        return false
    }
    const processed = processFile(file, options)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("unexpand", path) }
    return processed && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: unexpand [OPTION]... [FILE]...\nConvert blanks in each FILE to tabs, writing to standard output.\n  -a, --all        convert all blanks, instead of just initial blanks\n      --first-only  convert only leading sequences of blanks (overrides -a)\n  -t, --tabs=N     have tabs N characters apart instead of 8 (enables -a)\n      --help        display this help and exit\n      --version     output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx unexpand 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("unexpand", "invalid option")
        return 1
    }
    var effective = options
    if options.firstOnly { effective.all = false }
    const count = std.process.count(arguments)
    if effective.firstFile >= count { return if processFile(std.io.stdin(), effective) { 0 } else { 1 } }
    var status: u8 = 0
    var index = effective.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), effective) { status = 1 }
        index += 1
    }
    return status
}
