const std = @import("std")
const common = @import("../common.mlx")
const paths = @import("../paths.mlx")

const Options = struct {
    symbolic: bool
    logical: bool
    force: bool
    interactive: bool
    noDereference: bool
    relative: bool
    verbose: bool
    backup: bool
    suffix: std.string.String
    targetDirectory: std.string.String
    targetSet: bool
    noTargetDirectory: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

const Operands = struct {
    destination: std.string.String
    sourceEnd: usize
    destinationDirectory: bool
    valid: bool
}

fn consumeValue(arguments: [][*]const u8, index: *usize, attached: std.string.String) -> ?std.string.String {
    if attached.length > 0 { return attached }
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn setTarget(arguments: [][*]const u8, index: *usize, attached: std.string.String, options: *Options) -> bool {
    const value = consumeValue(arguments, index, attached)
    if value == null { return false }
    options.*.targetDirectory = value.?
    options.*.targetSet = true
    return true
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const byte = argument.pointer[current]
        if byte == 98 { options.*.backup = true } else if byte == 100 || byte == 70 {
        } else if byte == 102 {
            options.*.force = true
            options.*.interactive = false
        } else if byte == 105 {
            options.*.force = false
            options.*.interactive = true
        } else if byte == 76 { options.*.logical = true } else if byte == 110 { options.*.noDereference = true } else if byte == 80 {
            options.*.logical = false
        } else if byte == 114 { options.*.relative = true } else if byte == 115 { options.*.symbolic = true } else if byte == 84 {
            options.*.noTargetDirectory = true
        } else if byte == 118 { options.*.verbose = true } else if byte == 116 || byte == 83 {
            const value = consumeValue(arguments, index, std.string.slice(argument, current + 1, argument.length))
            if value == null { return false }
            if byte == 116 {
                options.*.targetDirectory = value.?
                options.*.targetSet = true
            } else {
                options.*.suffix = if value.?.length == 0 { std.string.fromSlice("~") } else { value.? }
            }
            return true
        } else { return false }
        current += 1
    }
    return true
}

fn parseLongValue(argument: std.string.String, prefix: []const u8) -> std.string.String {
    return std.string.slice(argument, std.string.fromSlice(prefix).length, argument.length)
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--backup") || std.string.startsWith(argument, std.string.fromSlice("--backup=")) { options.*.backup = true } else if common.equals(argument, "--directory") {
    } else if common.equals(argument, "--force") {
        options.*.force = true
        options.*.interactive = false
    } else if common.equals(argument, "--interactive") {
        options.*.force = false
        options.*.interactive = true
    } else if common.equals(argument, "--logical") { options.*.logical = true } else if common.equals(argument, "--no-dereference") { options.*.noDereference = true } else if common.equals(argument, "--physical") {
        options.*.logical = false
    } else if common.equals(argument, "--relative") { options.*.relative = true } else if common.equals(argument, "--symbolic") { options.*.symbolic = true } else if common.equals(argument, "--no-target-directory") {
        options.*.noTargetDirectory = true
    } else if common.equals(argument, "--verbose") { options.*.verbose = true } else if common.equals(argument, "--target-directory") {
        return setTarget(arguments, index, std.string.fromSlice(""), options)
    } else if std.string.startsWith(argument, std.string.fromSlice("--target-directory=")) {
        const target = parseLongValue(argument, "--target-directory=")
        if target.length == 0 { return false }
        return setTarget(arguments, index, target, options)
    } else if common.equals(argument, "--suffix") {
        const value = consumeValue(arguments, index, std.string.fromSlice(""))
        if value == null { return false }
        options.*.suffix = if value.?.length == 0 { std.string.fromSlice("~") } else { value.? }
    } else if std.string.startsWith(argument, std.string.fromSlice("--suffix=")) {
        const suffix = parseLongValue(argument, "--suffix=")
        options.*.suffix = if suffix.length == 0 { std.string.fromSlice("~") } else { suffix }
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") { options.*.action = 2 } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .symbolic = false, .logical = false, .force = false, .interactive = false, .noDereference = false, .relative = false, .verbose = false, .backup = false, .suffix = std.string.fromSlice("~"), .targetDirectory = std.string.fromSlice(""), .targetSet = false, .noTargetDirectory = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn isDirectory(status: std.fs.Stat) -> bool { return status.mode & 61440 == 16384 }
fn isSymbolicLink(status: std.fs.Stat) -> bool { return status.mode & 61440 == 40960 }

fn destinationIsDirectory(path: std.string.String, options: Options) -> bool {
    if options.noTargetDirectory { return false }
    var direct: std.fs.Stat = undefined
    if std.fs.statusAt(path.pointer, &direct, true) != 0 { return false }
    if options.noDereference && isSymbolicLink(direct) { return false }
    var followed: std.fs.Stat = undefined
    return std.fs.status(path.pointer, &followed) == 0 && isDirectory(followed)
}

fn resolveOperands(arguments: [][*]const u8, options: Options) -> Operands {
    const count = std.process.count(arguments)
    const operand_count = count - options.firstOperand
    if options.targetSet {
        const directory = destinationIsDirectory(options.targetDirectory, options)
        return Operands.{ .destination = options.targetDirectory, .sourceEnd = count, .destinationDirectory = directory, .valid = operand_count > 0 && directory && !options.noTargetDirectory }
    }
    if operand_count == 1 {
        return Operands.{ .destination = std.string.fromSlice("."), .sourceEnd = count, .destinationDirectory = true, .valid = !options.noTargetDirectory }
    }
    const destination = std.process.argument(arguments, count - 1)
    const directory = destinationIsDirectory(destination, options)
    return Operands.{ .destination = destination, .sourceEnd = count - 1, .destinationDirectory = directory, .valid = operand_count >= 2 && (operand_count == 2 || directory) }
}

fn confirmReplace(destination: std.string.String) -> bool {
    const first = std.io.eprint("mlx-ln: replace '")
    const second = std.io.writeString(std.io.stderr(), destination)
    const third = std.io.eprint("'? ")
    var byte: [1]u8 = [1]u8{ 0 }
    var answer: u8 = 0
    while true {
        var amount: isize = 0
        unsafe { amount = std.fs.read(std.io.stdin(), @ptrCast([*]u8, byte[0..1]), 1) }
        if amount <= 0 || byte[0] == 10 { break }
        if answer == 0 { answer = byte[0] }
    }
    return answer == 121 || answer == 89
}

fn createLink(source: std.string.String, destination: std.string.String, options: Options) -> bool {
    if options.symbolic { return std.fs.symbolicLink(source.pointer, destination.pointer) }
    if options.logical { return std.fs.hardLinkFollow(source.pointer, destination.pointer) }
    return std.fs.hardLink(source.pointer, destination.pointer)
}

fn sameHardLink(source: std.string.String, destination: std.string.String, options: Options) -> bool {
    if options.symbolic { return false }
    var source_status: std.fs.Stat = undefined
    var destination_status: std.fs.Stat = undefined
    const source_result = if options.logical { std.fs.status(source.pointer, &source_status) } else { std.fs.statusAt(source.pointer, &source_status, true) }
    return source_result == 0 && std.fs.statusAt(destination.pointer, &destination_status, true) == 0 && source_status.device == destination_status.device && source_status.inode == destination_status.inode
}

fn reportLink(source: std.string.String, destination: std.string.String, options: Options) -> void {
    if !options.verbose { return }
    const first = std.io.print("'")
    const second = std.io.printString(destination)
    const third = std.io.print(if options.symbolic { "' -> '" } else { "' => '" })
    const fourth = std.io.printString(source)
    const fifth = std.io.print("'\n")
}

fn replaceWithBackup(source: std.string.String, destination: std.string.String, options: Options) -> bool {
    const allocation = paths.append(destination, options.suffix)
    if allocation == null { return false }
    const owned = allocation.?
    const backup = std.string.fromParts(owned.pointer, owned.length)
    const removed_old_backup = std.fs.delete(backup.pointer)
    const renamed = std.fs.rename(destination.pointer, backup.pointer)
    var linked = false
    if renamed { linked = createLink(source, destination, options) }
    if renamed && !linked { const restored = std.fs.rename(backup.pointer, destination.pointer) }
    common.freePath(owned)
    return renamed && linked
}

fn linkOne(source: std.string.String, destination: std.string.String, options: Options) -> bool {
    if createLink(source, destination, options) {
        reportLink(source, destination, options)
        return true
    }
    var target_status: std.fs.Stat = undefined
    if std.fs.statusAt(destination.pointer, &target_status, true) != 0 || sameHardLink(source, destination, options) { return false }
    if options.interactive && !confirmReplace(destination) { return false }
    if !options.force && !options.interactive && !options.backup { return false }
    const linked = if options.backup { replaceWithBackup(source, destination, options) } else { std.fs.delete(destination.pointer) && createLink(source, destination, options) }
    if linked { reportLink(source, destination, options) }
    return linked
}

fn linkInto(source: std.string.String, operands: Operands, options: Options) -> bool {
    if !operands.destinationDirectory { return linkOne(source, operands.destination, options) }
    const joined = paths.join(operands.destination, paths.basename(source))
    if joined == null { return false }
    const owned = joined.?
    const linked = linkOne(source, std.string.fromParts(owned.pointer, owned.length), options)
    common.freePath(owned)
    return linked
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: ln [OPTION]... TARGET [LINK_NAME]\n  -b, --backup      back up existing destinations\n  -f, --force       remove existing destinations\n  -i, --interactive prompt before replacement\n  -L, --logical     follow symbolic TARGETs\n  -P, --physical    link symbolic TARGETs directly\n  -s, --symbolic    create symbolic links\n  -t, --target-directory=DIR\n  -T, --no-target-directory\n  -v, --verbose\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx ln 0.1.0\n") { 0 } else { 1 } }
    if options.invalid || options.relative || options.firstOperand >= std.process.count(arguments) {
        common.writeMessage("mlx-ln", "missing operand or unsupported option combination")
        return 1
    }
    const operands = resolveOperands(arguments, options)
    if !operands.valid {
        common.writeMessage("mlx-ln", "invalid target directory or operands")
        return 1
    }
    var success = true
    var index = options.firstOperand
    while index < operands.sourceEnd {
        const source = std.process.argument(arguments, index)
        if !linkInto(source, operands, options) {
            common.writePathError("mlx-ln", "failed to create link to", source)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
