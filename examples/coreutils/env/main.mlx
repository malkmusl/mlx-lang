const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    ignore: bool
    zero: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

const Environment = struct {
    items: [*][*]const u8
    length: usize
    bytes: usize
}

fn unsetOption(argument: std.string.String) -> bool {
    if argument.length > 2 && argument.pointer[0] == 45 && argument.pointer[1] == 117 { return true }
    return std.string.startsWith(argument, std.string.fromSlice("--unset="))
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .ignore = false, .zero = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstOperand < count {
        const argument = std.process.argument(arguments, result.firstOperand)
        if common.equals(argument, "--") {
            result.firstOperand += 1
            break
        }
        if common.equals(argument, "-") || common.equals(argument, "-i") || common.equals(argument, "--ignore-environment") {
            result.ignore = true
        } else if common.equals(argument, "-0") || common.equals(argument, "--null") {
            result.zero = true
        } else if common.equals(argument, "-u") || common.equals(argument, "--unset") {
            result.firstOperand += 1
            if result.firstOperand >= count { result.invalid = true }
        } else if unsetOption(argument) {
            const name_start: usize = if argument.pointer[1] == 117 { 2 } else { 8 }
            if argument.length == name_start { result.invalid = true }
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else if argument.length > 0 && argument.pointer[0] == 45 {
            result.invalid = true
        } else { break }
        result.firstOperand += 1
    }
    return result
}

fn assignmentName(value: std.string.String) -> ?std.string.String {
    var index: usize = 0
    while index < value.length && value.pointer[index] != 61 { index += 1 }
    if index == 0 || index >= value.length { return null }
    return std.string.slice(value, 0, index)
}

fn entryName(value: std.string.String) -> std.string.String {
    var index: usize = 0
    while index < value.length && value.pointer[index] != 61 { index += 1 }
    return std.string.slice(value, 0, index)
}

fn unsetName(arguments: [][*]const u8, index: usize) -> std.string.String {
    const option = std.process.argument(arguments, index)
    if common.equals(option, "-u") || common.equals(option, "--unset") {
        return std.process.argument(arguments, index + 1)
    }
    if option.pointer[1] == 117 { return std.string.slice(option, 2, option.length) }
    return std.string.slice(option, 8, option.length)
}

fn isUnset(arguments: [][*]const u8, end: usize, name: std.string.String) -> bool {
    var index: usize = 1
    while index < end {
        const option = std.process.argument(arguments, index)
        if common.equals(option, "-u") || common.equals(option, "--unset") {
            if std.string.eql(name, unsetName(arguments, index)) { return true }
            index += 1
        } else if unsetOption(option) && std.string.eql(name, unsetName(arguments, index)) { return true }
        index += 1
    }
    return false
}

fn commandIndex(arguments: [][*]const u8, first: usize) -> usize {
    const count = std.process.count(arguments)
    var index = first
    while index < count && assignmentName(std.process.argument(arguments, index)) != null { index += 1 }
    return index
}

fn assignedValue(arguments: [][*]const u8, first: usize, end: usize, name: std.string.String) -> ?std.string.String {
    var result: ?std.string.String = null
    var index = first
    while index < end {
        const value = std.process.argument(arguments, index)
        const assigned = assignmentName(value)
        if assigned != null && std.string.eql(name, assigned.?) { result = value }
        index += 1
    }
    return result
}

fn originalContains(arguments: [][*]const u8, name: std.string.String) -> bool {
    const entries = std.process.environmentEntries(arguments)
    const count = std.process.environmentCount(arguments)
    var index: usize = 0
    while index < count {
        if std.string.eql(entryName(std.process.fromCString(entries[index])), name) { return true }
        index += 1
    }
    return false
}

fn allocateEnvironment(arguments: [][*]const u8, options: Options, command: usize) -> ?Environment {
    const original_count = std.process.environmentCount(arguments)
    const assignment_count = command - options.firstOperand
    const bytes = (original_count + assignment_count + 1) * @sizeOf([*]const u8)
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, bytes, @alignOf([*]const u8))
    if allocation == null { return null }
    var items: [*][*]const u8 = undefined
    unsafe { items = @ptrCast([*][*]const u8, allocation.?) }
    const entries = std.process.environmentEntries(arguments)
    var length: usize = 0
    var index: usize = 0
    while !options.ignore && index < original_count {
        const name = entryName(std.process.fromCString(entries[index]))
        if !isUnset(arguments, options.firstOperand, name) {
            const assigned = assignedValue(arguments, options.firstOperand, command, name)
            items[length] = if assigned == null { entries[index] } else { assigned.?.pointer }
            length += 1
        }
        index += 1
    }
    index = options.firstOperand
    while index < command {
        const value = std.process.argument(arguments, index)
        const name = assignmentName(value).?
        const original_active = !options.ignore && !isUnset(arguments, options.firstOperand, name) && originalContains(arguments, name)
        const appeared = assignedValue(arguments, options.firstOperand, index, name) != null
        if !original_active && !appeared {
            items[length] = assignedValue(arguments, options.firstOperand, command, name).?.pointer
            length += 1
        }
        index += 1
    }
    unsafe { items[length] = @ptrFromInt([*]const u8, 0) }
    return Environment.{ .items = items, .length = length, .bytes = bytes }
}

fn freeEnvironment(environment: Environment) -> void {
    const allocator = std.page_allocator.init()
    unsafe { allocator.freeFn(allocator.context, @ptrCast([*]u8, environment.items), environment.bytes, @alignOf([*]const u8)) }
}

fn writeEntry(entry: std.string.String, zero: bool) -> bool {
    if !std.io.writeString(std.io.stdout(), entry) { return false }
    if !zero { return std.io.print("\n") }
    var terminator: [1]u8 = [1]u8{ 0 }
    unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, terminator[0..1]), 1) }
}

fn writeEnvironment(environment: Environment, zero: bool) -> bool {
    var index: usize = 0
    while index < environment.length {
        if !writeEntry(std.process.fromCString(environment.items[index]), zero) { return false }
        index += 1
    }
    return true
}

fn findValue(environment: Environment, name: std.string.String) -> ?std.string.String {
    var index: usize = 0
    while index < environment.length {
        const entry = std.process.fromCString(environment.items[index])
        const current_name = entryName(entry)
        if std.string.eql(current_name, name) {
            return std.string.slice(entry, current_name.length + 1, entry.length)
        }
        index += 1
    }
    return null
}

fn containsSlash(value: std.string.String) -> bool {
    var index: usize = 0
    while index < value.length {
        if value.pointer[index] == 47 { return true }
        index += 1
    }
    return false
}

fn executeAt(path: [*]const u8, arguments: [][*]const u8, command: usize, environment: Environment) -> isize {
    unsafe {
        const base = @ptrCast([*][*]const u8, arguments)
        const command_arguments = @ptrFromInt([*][*]const u8, @intFromPtr(base) + command * @sizeOf([*]const u8))
        return std.os.linux.process.execute(path, command_arguments, environment.items)
    }
}

fn fillCandidate(buffer: [*]u8, directory: std.string.String, command: std.string.String) -> void {
    var length: usize = 0
    var index: usize = 0
    while index < directory.length {
        buffer[length] = directory.pointer[index]
        length += 1
        index += 1
    }
    if directory.length > 0 {
        buffer[length] = 47
        length += 1
    }
    index = 0
    while index < command.length {
        buffer[length] = command.pointer[index]
        length += 1
        index += 1
    }
    buffer[length] = 0
}

fn executeFromPath(arguments: [][*]const u8, command_index: usize, environment: Environment) -> u8 {
    const command = std.process.argument(arguments, command_index)
    const found = findValue(environment, std.string.fromSlice("PATH"))
    const path = if found == null { std.string.fromSlice("/bin:/usr/bin") } else { found.? }
    if path.length > 18446744073709551613 - command.length { return 127 }
    const capacity = path.length + command.length + 2
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, capacity, 1)
    if allocation == null { return 127 }
    const buffer = allocation.?
    var denied = false
    var start: usize = 0
    while start <= path.length {
        var end = start
        while end < path.length && path.pointer[end] != 58 { end += 1 }
        fillCandidate(buffer, std.string.slice(path, start, end), command)
        const result = executeAt(buffer, arguments, command_index, environment)
        if result == -13 { denied = true }
        if end == path.length { break }
        start = end + 1
    }
    allocator.freeFn(allocator.context, buffer, capacity, 1)
    return if denied { 126 } else { 127 }
}

fn executeCommand(arguments: [][*]const u8, command: usize, environment: Environment) -> u8 {
    const name = std.process.argument(arguments, command)
    var status: u8 = 127
    if containsSlash(name) {
        const result = executeAt(name.pointer, arguments, command, environment)
        status = if result == -13 { 126 } else { 127 }
    } else { status = executeFromPath(arguments, command, environment) }
    common.writePathError("mlx-env", "cannot execute", name)
    return status
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: env [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]\nSet variables and run COMMAND, or print the resulting environment.\n  -i, --ignore-environment  start with an empty environment\n  -0, --null                end output with NUL instead of newline\n  -u, --unset=NAME          remove a variable\n      --help                display this help and exit\n      --version             output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx env 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("mlx-env", "invalid option")
        return 125
    }
    const command = commandIndex(arguments, options.firstOperand)
    if options.zero && command < std.process.count(arguments) {
        common.writeMessage("mlx-env", "-0 is only valid without a command")
        return 125
    }
    const created = allocateEnvironment(arguments, options, command)
    if created == null {
        common.writeMessage("mlx-env", "cannot allocate environment")
        return 125
    }
    const environment = created.?
    const status = if command >= std.process.count(arguments) { if writeEnvironment(environment, options.zero) { 0 } else { 125 } } else { executeCommand(arguments, command, environment) }
    freeEnvironment(environment)
    return status
}
