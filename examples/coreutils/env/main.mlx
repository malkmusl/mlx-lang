const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    ignore: bool
    zero: bool
    debug: bool
    argv0: std.string.String
    argv0Set: bool
    directory: std.string.String
    directorySet: bool
    split: std.string.String
    splitSet: bool
    ignoredSignals: usize
    defaultSignals: usize
    blockedSignals: usize
    unblockedSignals: usize
    listSignals: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

const SignalMask = struct {
    value: usize
    valid: bool
}

const Environment = struct {
    items: [*][*]const u8
    length: usize
    bytes: usize
}

fn unsetOption(argument: std.string.String) -> bool {
    if argument.length > 2 && argument.pointer[0] == 45 && argument.pointer[1] == 117 { return true }
    return std.string.startsWith(argument, std.string.fromSlice("--unset="))
}

fn signalNumber(name: std.string.String) -> usize {
    if name.length > 3 && name.pointer[0] == 83 && name.pointer[1] == 73 && name.pointer[2] == 71 {
        return signalNumber(std.string.slice(name, 3, name.length))
    }
    const parsed = std.parse.unsigned(name)
    if parsed.valid && parsed.value > 0 && parsed.value <= 64 { return parsed.value }
    if common.equals(name, "HUP") { return 1 }
    if common.equals(name, "INT") { return 2 }
    if common.equals(name, "QUIT") { return 3 }
    if common.equals(name, "ILL") { return 4 }
    if common.equals(name, "TRAP") { return 5 }
    if common.equals(name, "ABRT") || common.equals(name, "IOT") { return 6 }
    if common.equals(name, "BUS") { return 7 }
    if common.equals(name, "FPE") { return 8 }
    if common.equals(name, "KILL") { return 9 }
    if common.equals(name, "USR1") { return 10 }
    if common.equals(name, "SEGV") { return 11 }
    if common.equals(name, "USR2") { return 12 }
    if common.equals(name, "PIPE") { return 13 }
    if common.equals(name, "ALRM") { return 14 }
    if common.equals(name, "TERM") { return 15 }
    if common.equals(name, "STKFLT") { return 16 }
    if common.equals(name, "CHLD") { return 17 }
    if common.equals(name, "CONT") { return 18 }
    if common.equals(name, "STOP") { return 19 }
    if common.equals(name, "TSTP") { return 20 }
    if common.equals(name, "TTIN") { return 21 }
    if common.equals(name, "TTOU") { return 22 }
    if common.equals(name, "URG") { return 23 }
    if common.equals(name, "XCPU") { return 24 }
    if common.equals(name, "XFSZ") { return 25 }
    if common.equals(name, "VTALRM") { return 26 }
    if common.equals(name, "PROF") { return 27 }
    if common.equals(name, "WINCH") { return 28 }
    if common.equals(name, "IO") || common.equals(name, "POLL") { return 29 }
    if common.equals(name, "PWR") { return 30 }
    if common.equals(name, "SYS") { return 31 }
    return 0
}

fn parseSignals(text: std.string.String, all_when_empty: bool) -> SignalMask {
    if text.length == 0 { return SignalMask.{ .value = if all_when_empty { 18446744073709551615 } else { 0 }, .valid = true } }
    var mask: usize = 0
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text.pointer[end] != 44 { end += 1 }
        const number = signalNumber(std.string.slice(text, start, end))
        if number == 0 { return SignalMask.{ .value = 0, .valid = false } }
        mask |= @intCast(usize, 1) << @intCast(u6, number - 1)
        if end == text.length { break }
        start = end + 1
    }
    return SignalMask.{ .value = mask, .valid = true }
}

fn applySignalOption(options: *Options, kind: u8, text: std.string.String, all_when_empty: bool) -> bool {
    const parsed = parseSignals(text, all_when_empty)
    if !parsed.valid { return false }
    if kind == 0 {
        options.*.blockedSignals |= parsed.value
        options.*.unblockedSignals &= ~parsed.value
    } else if kind == 1 {
        options.*.defaultSignals |= parsed.value
        options.*.ignoredSignals &= ~parsed.value
        options.*.unblockedSignals |= parsed.value
        options.*.blockedSignals &= ~parsed.value
    } else {
        options.*.ignoredSignals |= parsed.value
        options.*.defaultSignals &= ~parsed.value
    }
    return true
}

fn setOptionValue(arguments: [][*]const u8, index: *usize, attached: std.string.String) -> ?std.string.String {
    if attached.length > 0 { return attached }
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn parseSignalLong(argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--block-signal") { return applySignalOption(options, 0, std.string.fromSlice(""), true) }
    if common.equals(argument, "--default-signal") { return applySignalOption(options, 1, std.string.fromSlice(""), true) }
    if common.equals(argument, "--ignore-signal") { return applySignalOption(options, 2, std.string.fromSlice(""), true) }
    if std.string.startsWith(argument, std.string.fromSlice("--block-signal=")) { return applySignalOption(options, 0, std.string.slice(argument, 15, argument.length), false) }
    if std.string.startsWith(argument, std.string.fromSlice("--default-signal=")) { return applySignalOption(options, 1, std.string.slice(argument, 17, argument.length), false) }
    if std.string.startsWith(argument, std.string.fromSlice("--ignore-signal=")) { return applySignalOption(options, 2, std.string.slice(argument, 16, argument.length), false) }
    return false
}

fn namedValueKind(argument: std.string.String) -> u8 {
    if common.equals(argument, "-a") || common.equals(argument, "--argv0") || std.string.startsWith(argument, std.string.fromSlice("--argv0=")) || argument.length > 2 && argument.pointer[1] == 97 { return 1 }
    if common.equals(argument, "-C") || common.equals(argument, "--chdir") || std.string.startsWith(argument, std.string.fromSlice("--chdir=")) || argument.length > 2 && argument.pointer[1] == 67 { return 2 }
    if common.equals(argument, "-S") || common.equals(argument, "--split-string") || std.string.startsWith(argument, std.string.fromSlice("--split-string=")) || argument.length > 2 && argument.pointer[1] == 83 || argument.length > 2 && argument.pointer[1] == 118 && argument.pointer[2] == 83 { return 3 }
    return 0
}

fn storeNamedValue(options: *Options, kind: u8, value: std.string.String) -> void {
    if kind == 1 {
        options.*.argv0 = value
        options.*.argv0Set = true
    } else if kind == 2 {
        options.*.directory = value
        options.*.directorySet = true
    } else {
        options.*.split = value
        options.*.splitSet = true
    }
}

fn parseNamedValue(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    const kind = namedValueKind(argument)
    if argument.length > 2 && argument.pointer[1] == 118 { options.*.debug = true }
    var attached = std.string.fromSlice("")
    var attached_set = false
    if argument.length > 2 && argument.pointer[1] != 45 && !(argument.length == 3 && argument.pointer[1] == 118) {
        const start: usize = if argument.pointer[1] == 118 { 3 } else { 2 }
        attached = std.string.slice(argument, start, argument.length)
        attached_set = true
    }
    if std.string.startsWith(argument, std.string.fromSlice("--argv0=")) || std.string.startsWith(argument, std.string.fromSlice("--chdir=")) {
        attached = std.string.slice(argument, 8, argument.length)
        attached_set = true
    }
    if std.string.startsWith(argument, std.string.fromSlice("--split-string=")) {
        attached = std.string.slice(argument, 15, argument.length)
        attached_set = true
    }
    const value = if attached_set { attached } else { setOptionValue(arguments, index, attached) }
    if value == null { return false }
    storeNamedValue(options, kind, value.?)
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .ignore = false, .zero = false, .debug = false, .argv0 = std.string.fromSlice(""), .argv0Set = false, .directory = std.string.fromSlice(""), .directorySet = false, .split = std.string.fromSlice(""), .splitSet = false, .ignoredSignals = 0, .defaultSignals = 0, .blockedSignals = 0, .unblockedSignals = 0, .listSignals = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if common.equals(argument, "-") || common.equals(argument, "-i") || common.equals(argument, "--ignore-environment") {
            result.ignore = true
        } else if common.equals(argument, "-0") || common.equals(argument, "--null") {
            result.zero = true
        } else if common.equals(argument, "-v") || common.equals(argument, "--debug") {
            result.debug = true
        } else if common.equals(argument, "-u") || common.equals(argument, "--unset") {
            index += 1
            if index >= count { result.invalid = true }
        } else if unsetOption(argument) {
            const name_start: usize = if argument.pointer[1] == 117 { 2 } else { 8 }
            if argument.length == name_start { result.invalid = true }
        } else if namedValueKind(argument) != 0 {
            if !parseNamedValue(arguments, &index, argument, &result) { result.invalid = true }
        } else if common.equals(argument, "--list-signal-handling") {
            result.listSignals = true
        } else if std.string.startsWith(argument, std.string.fromSlice("--block-signal")) || std.string.startsWith(argument, std.string.fromSlice("--default-signal")) || std.string.startsWith(argument, std.string.fromSlice("--ignore-signal")) {
            if !parseSignalLong(argument, &result) { result.invalid = true }
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else if argument.length > 0 && argument.pointer[0] == 45 {
            result.invalid = true
        } else { break }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn assignmentName(value: std.string.String) -> ?std.string.String {
    var index: usize = 0
    while index < value.length && value.pointer[index] != 61 { index += 1 }
    if index == 0 || index >= value.length { return null }
    return std.string.slice(value, 0, index)
}

fn entryName(value: std.string.String) -> std.string.String {
    var index: usize = 0
    while index < value.length && value.pointer[index] != 61 { index += 1 }
    return std.string.slice(value, 0, index)
}

fn unsetName(arguments: [][*]const u8, index: usize) -> std.string.String {
    const option = std.process.argument(arguments, index)
    if common.equals(option, "-u") || common.equals(option, "--unset") {
        return std.process.argument(arguments, index + 1)
    }
    if option.pointer[1] == 117 { return std.string.slice(option, 2, option.length) }
    return std.string.slice(option, 8, option.length)
}

fn isUnset(arguments: [][*]const u8, end: usize, name: std.string.String) -> bool {
    var index: usize = 1
    while index < end {
        const option = std.process.argument(arguments, index)
        if common.equals(option, "-u") || common.equals(option, "--unset") {
            if std.string.eql(name, unsetName(arguments, index)) { return true }
            index += 1
        } else if unsetOption(option) && std.string.eql(name, unsetName(arguments, index)) { return true }
        index += 1
    }
    return false
}

fn commandIndex(arguments: [][*]const u8, first: usize) -> usize {
    const count = std.process.count(arguments)
    var index = first
    while index < count && assignmentName(std.process.argument(arguments, index)) != null { index += 1 }
    return index
}

fn assignedValue(arguments: [][*]const u8, first: usize, end: usize, name: std.string.String) -> ?std.string.String {
    var result: ?std.string.String = null
    var index = first
    while index < end {
        const value = std.process.argument(arguments, index)
        const assigned = assignmentName(value)
        if assigned != null && std.string.eql(name, assigned.?) { result = value }
        index += 1
    }
    return result
}

fn originalContains(arguments: [][*]const u8, name: std.string.String) -> bool {
    const entries = std.process.environmentEntries(arguments)
    const count = std.process.environmentCount(arguments)
    var index: usize = 0
    while index < count {
        if std.string.eql(entryName(std.process.fromCString(entries[index])), name) { return true }
        index += 1
    }
    return false
}

fn allocateEnvironment(arguments: [][*]const u8, options: Options, command: usize) -> ?Environment {
    const original_count = std.process.environmentCount(arguments)
    const assignment_count = command - options.firstOperand
    const bytes = (original_count + assignment_count + 1) * @sizeOf([*]const u8)
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(bytes, @alignOf([*]const u8))
    if allocation == null { return null }
    var items: [*][*]const u8 = undefined
    unsafe { items = @ptrCast([*][*]const u8, allocation.?) }
    const entries = std.process.environmentEntries(arguments)
    var length: usize = 0
    var index: usize = 0
    while !options.ignore && index < original_count {
        const name = entryName(std.process.fromCString(entries[index]))
        if !isUnset(arguments, options.firstOperand, name) {
            const assigned = assignedValue(arguments, options.firstOperand, command, name)
            items[length] = if assigned == null { entries[index] } else { assigned.?.pointer }
            length += 1
        }
        index += 1
    }
    index = options.firstOperand
    while index < command {
        const value = std.process.argument(arguments, index)
        const name = assignmentName(value).?
        const original_active = !options.ignore && !isUnset(arguments, options.firstOperand, name) && originalContains(arguments, name)
        const appeared = assignedValue(arguments, options.firstOperand, index, name) != null
        if !original_active && !appeared {
            items[length] = assignedValue(arguments, options.firstOperand, command, name).?.pointer
            length += 1
        }
        index += 1
    }
    unsafe { items[length] = @ptrFromInt([*]const u8, 0) }
    return Environment.{ .items = items, .length = length, .bytes = bytes }
}

fn freeEnvironment(environment: Environment) -> void {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    unsafe { allocator.free(@ptrCast([*]u8, environment.items), environment.bytes, @alignOf([*]const u8)) }
}

fn writeEntry(entry: std.string.String, zero: bool) -> bool {
    if !std.io.writeString(std.io.stdout(), entry) { return false }
    if !zero { return std.io.print("\n") }
    var terminator: [1]u8 = [1]u8{ 0 }
    unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, terminator[0..1]), 1) }
}

fn writeEnvironment(environment: Environment, zero: bool) -> bool {
    var index: usize = 0
    while index < environment.length {
        if !writeEntry(std.process.fromCString(environment.items[index]), zero) { return false }
        index += 1
    }
    return true
}

fn findValue(environment: Environment, name: std.string.String) -> ?std.string.String {
    var index: usize = 0
    while index < environment.length {
        const entry = std.process.fromCString(environment.items[index])
        const current_name = entryName(entry)
        if std.string.eql(current_name, name) {
            return std.string.slice(entry, current_name.length + 1, entry.length)
        }
        index += 1
    }
    return null
}

fn containsSlash(value: std.string.String) -> bool {
    var index: usize = 0
    while index < value.length {
        if value.pointer[index] == 47 { return true }
        index += 1
    }
    return false
}

fn executeAt(path: [*]const u8, arguments: [][*]const u8, command: usize, environment: Environment, options: Options) -> isize {
    unsafe {
        const base = @ptrCast([*][*]const u8, arguments)
        const command_arguments = @ptrFromInt([*][*]const u8, @intFromPtr(base) + command * @sizeOf([*]const u8))
        if options.argv0Set { command_arguments[0] = options.argv0.pointer }
        return std.os.linux.process.execute(path, command_arguments, environment.items)
    }
}

fn fillCandidate(buffer: [*]u8, directory: std.string.String, command: std.string.String) -> void {
    var length: usize = 0
    var index: usize = 0
    while index < directory.length {
        buffer[length] = directory.pointer[index]
        length += 1
        index += 1
    }
    if directory.length > 0 {
        buffer[length] = 47
        length += 1
    }
    index = 0
    while index < command.length {
        buffer[length] = command.pointer[index]
        length += 1
        index += 1
    }
    buffer[length] = 0
}

fn executeFromPath(arguments: [][*]const u8, command_index: usize, environment: Environment, options: Options) -> u8 {
    const command = std.process.argument(arguments, command_index)
    const found = findValue(environment, std.string.fromSlice("PATH"))
    const path = if found == null { std.string.fromSlice("/bin:/usr/bin") } else { found.? }
    if path.length > 18446744073709551613 - command.length { return 127 }
    const capacity = path.length + command.length + 2
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(capacity, 1)
    if allocation == null { return 127 }
    const buffer = allocation.?
    var denied = false
    var start: usize = 0
    while start <= path.length {
        var end = start
        while end < path.length && path.pointer[end] != 58 { end += 1 }
        fillCandidate(buffer, std.string.slice(path, start, end), command)
        const result = executeAt(buffer, arguments, command_index, environment, options)
        if result == -13 { denied = true }
        if end == path.length { break }
        start = end + 1
    }
    allocator.free(buffer, capacity, 1)
    return if denied { 126 } else { 127 }
}

fn executeCommand(arguments: [][*]const u8, command: usize, environment: Environment, options: Options) -> u8 {
    const name = std.process.argument(arguments, command)
    var status: u8 = 127
    if containsSlash(name) {
        const result = executeAt(name.pointer, arguments, command, environment, options)
        status = if result == -13 { 126 } else { 127 }
    } else { status = executeFromPath(arguments, command, environment, options) }
    common.writePathError("env", "cannot execute", name)
    return status
}

fn executeRawPath(name: std.string.String, items: [*][*]const u8, environment: Environment) -> isize {
    return std.os.linux.process.execute(name.pointer, items, environment.items)
}

fn executeRawFromPath(name: std.string.String, items: [*][*]const u8, environment: Environment) -> u8 {
    const found = findValue(environment, std.string.fromSlice("PATH"))
    const path = if found == null { std.string.fromSlice("/bin:/usr/bin") } else { found.? }
    if path.length > 18446744073709551613 - name.length { return 127 }
    const capacity = path.length + name.length + 2
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(capacity, 1)
    if allocation == null { return 127 }
    const buffer = allocation.?
    var denied = false
    var start: usize = 0
    while start <= path.length {
        var end = start
        while end < path.length && path.pointer[end] != 58 { end += 1 }
        fillCandidate(buffer, std.string.slice(path, start, end), name)
        const result = std.os.linux.process.execute(buffer, items, environment.items)
        if result == -13 { denied = true }
        if end == path.length { break }
        start = end + 1
    }
    allocator.free(buffer, capacity, 1)
    return if denied { 126 } else { 127 }
}

fn executeSplit(arguments: [][*]const u8, append_from: usize, environment: Environment, options: Options) -> u8 {
    const expanded = std.shell.expand(options.split, arguments, append_from)
    if !expanded.valid { return 125 }
    const name = std.process.fromCString(expanded.items[0])
    if options.argv0Set { expanded.items[0] = options.argv0.pointer }
    var status: u8 = 127
    if containsSlash(name) {
        const result = executeRawPath(name, expanded.items, environment)
        status = if result == -13 { 126 } else { 127 }
    } else { status = executeRawFromPath(name, expanded.items, environment) }
    std.shell.deinit(expanded)
    common.writePathError("env", "cannot execute", name)
    return status
}

fn signalSelected(mask: usize, number: usize) -> bool {
    return mask & (@intCast(usize, 1) << @intCast(u6, number - 1)) != 0
}

fn applySignalActions(options: Options) -> bool {
    if options.blockedSignals != 0 && !std.os.linux.process.blockSignals(options.blockedSignals) { return false }
    if options.unblockedSignals != 0 && !std.os.linux.process.unblockSignals(options.unblockedSignals) { return false }
    var number: usize = 1
    while number <= 64 {
        if number != 9 && number != 19 {
            if signalSelected(options.defaultSignals, number) && !std.os.linux.process.defaultSignal(number) { return false }
            if signalSelected(options.ignoredSignals, number) && !std.os.linux.process.ignoreSignal(number) { return false }
        }
        number += 1
    }
    return true
}

fn reportDebug(options: Options) -> void {
    if options.debug { common.writeMessage("env", "processing environment and execution options") }
    if options.listSignals && options.blockedSignals != 0 { common.writeMessage("env", "signals blocked") }
    if options.listSignals && options.ignoredSignals != 0 { common.writeMessage("env", "signals ignored") }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: env [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]\n  -a, --argv0=ARG           override command argument zero\n  -i, --ignore-environment  start with an empty environment\n  -0, --null                end output with NUL instead of newline\n  -u, --unset=NAME          remove a variable\n  -C, --chdir=DIR           change working directory\n  -S, --split-string=S      split shebang arguments\n      --block-signal[=SIG]  block signals\n      --default-signal[=SIG] reset signals\n      --ignore-signal[=SIG] ignore signals\n      --list-signal-handling list changed signals\n  -v, --debug               trace processing\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx env 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("env", "invalid option")
        return 125
    }
    if options.directorySet && !std.fs.changeDirectory(options.directory.pointer) {
        common.writePathError("env", "cannot change directory", options.directory)
        return 125
    }
    if !applySignalActions(options) {
        common.writeMessage("env", "cannot configure signal handling")
        return 125
    }
    reportDebug(options)
    const command = commandIndex(arguments, options.firstOperand)
    if options.zero && command < std.process.count(arguments) {
        common.writeMessage("env", "-0 is only valid without a command")
        return 125
    }
    const created = allocateEnvironment(arguments, options, command)
    if created == null {
        common.writeMessage("env", "cannot allocate environment")
        return 125
    }
    const environment = created.?
    var status: u8 = 0
    if options.splitSet {
        status = executeSplit(arguments, command, environment, options)
    } else if command >= std.process.count(arguments) {
        status = if writeEnvironment(environment, options.zero) { 0 } else { 125 }
    } else { status = executeCommand(arguments, command, environment, options) }
    freeEnvironment(environment)
    return status
}
