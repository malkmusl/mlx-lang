const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    logical: bool
    action: u8
    invalid: bool
    operands: bool
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .logical = true, .action = 0, .invalid = false, .operands = false }
    const count = std.process.count(arguments)
    var options_enabled = true
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if options_enabled && common.equals(argument, "--") { options_enabled = false } else if options_enabled && common.equals(argument, "--logical") { result.logical = true } else if options_enabled && common.equals(argument, "--physical") { result.logical = false } else if options_enabled && common.equals(argument, "--help") { result.action = 1 } else if options_enabled && common.equals(argument, "--version") { result.action = 2 } else if options_enabled && argument.length > 1 && argument.pointer[0] == 45 {
            var option_index: usize = 1
            while option_index < argument.length {
                const option = argument.pointer[option_index]
                if option == 76 { result.logical = true } else if option == 80 { result.logical = false } else { result.invalid = true }
                option_index += 1
            }
        } else {
            result.operands = true
        }
        index += 1
    }
    return result
}

fn validLogicalPath(path: std.string.String) -> bool {
    if path.length == 0 || path.pointer[0] != 47 { return false }
    var index: usize = 1
    while index < path.length {
        while index < path.length && path.pointer[index] == 47 { index += 1 }
        const start = index
        while index < path.length && path.pointer[index] != 47 { index += 1 }
        const length = index - start
        if length == 1 && path.pointer[start] == 46 { return false }
        if length == 2 && path.pointer[start] == 46 && path.pointer[start + 1] == 46 { return false }
    }
    return true
}

fn writeLogical(arguments: [][*]const u8) -> bool {
    const found = std.process.environment(arguments, "PWD")
    if found == null || !validLogicalPath(found.?) { return false }
    const path = found.?
    var logical_status: std.fs.Stat = undefined
    var physical_status: std.fs.Stat = undefined
    unsafe {
        if std.fs.status(path.pointer, &logical_status) != 0 { return false }
        if std.fs.status(@ptrCast([*]const u8, "."), &physical_status) != 0 { return false }
    }
    if logical_status.device != physical_status.device || logical_status.inode != physical_status.inode { return false }
    return std.io.writeString(std.io.stdout(), path) && std.io.print("\n")
}

fn writePhysical() -> bool {
    const allocator = std.page_allocator.init()
    var capacity: usize = 4096
    while capacity <= 1048576 {
        const allocation = allocator.alloc(capacity, 8)
        if allocation == null { return false }
        const buffer = allocation.?
        const result = std.fs.getWorkingDirectory(buffer, capacity)
        if result > 0 {
            const length = @bitCast(usize, result) - 1
            var written = false
            unsafe { written = std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, buffer), length) }
            if written { written = std.io.print("\n") }
            allocator.free(buffer, capacity, 8)
            return written
        }
        allocator.free(buffer, capacity, 8)
        if result != -34 { return false }
        capacity *= 2
    }
    return false
}

fn printHelp() -> u8 {
    const written = std.io.print("Usage: mlx-pwd [OPTION]...\nPrint the full filename of the current working directory.\n\n  -L, --logical   use PWD from the environment\n  -P, --physical  avoid all symbolic links\n      --help      display this help and exit\n      --version   output version information and exit\n")
    return if written { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx pwd 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("pwd", "invalid option; try '--help'")
        return 1
    }
    if options.operands { common.writeMessage("pwd", "ignoring non-option arguments") }
    if options.logical && writeLogical(arguments) { return 0 }
    if writePhysical() { return 0 }
    common.writeMessage("pwd", "failed to read current directory")
    return 1
}
