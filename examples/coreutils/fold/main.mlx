const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    width: usize
    bytes: bool
    spaces: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .width = 80, .bytes = false, .spaces = false, .action = 0, .invalid = false, .firstFile = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--width=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 8, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.width = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-w") || common.equals(argument, "--width") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.width = parsed.value }
            index += 1
            continue
        }
        var i: usize = 1
        var ok = true
        while i < argument.length {
            const byte = argument.pointer[i]
            if byte == 98 { result.bytes = true } else if byte == 115 {
                result.spaces = true
            } else if byte == 119 {
                const text = std.string.slice(argument, i + 1, argument.length)
                if text.length > 0 {
                    const parsed = std.parse.unsigned(text)
                    if !parsed.valid || parsed.value == 0 { ok = false } else { result.width = parsed.value }
                } else {
                    index += 1
                    if index >= count { ok = false } else {
                        const parsed = std.parse.unsigned(std.process.argument(arguments, index))
                        if !parsed.valid || parsed.value == 0 { ok = false } else { result.width = parsed.value }
                    }
                }
                i = argument.length
                break
            } else {
                ok = false
            }
            i += 1
        }
        if !ok { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    return result
}

fn writeChunk(file: std.fs.File, line: [*]const u8, start: usize, end: usize, newline: bool) -> bool {
    unsafe {
        var pointer: [*]const u8 = undefined
        pointer = @ptrFromInt([*]const u8, @intFromPtr(line) + start)
        if end > start && !std.io.writeAllBytes(file, pointer, end - start) { return false }
    }
    if newline { return std.io.writeAll(file, "\n") }
    return true
}

fn foldLine(file: std.fs.File, line: [*]const u8, length: usize, options: Options, trailing_newline: bool) -> bool {
    var chunk_start: usize = 0
    var column: usize = 0
    var has_last_space = false
    var last_space_index: usize = 0
    var i: usize = 0
    while i < length {
        const byte = line[i]
        var char_width: usize = 1
        if !options.bytes && byte == 9 { char_width = 8 - (column % 8) }
        if column + char_width > options.width && column > 0 {
            var break_at = i
            if options.spaces && has_last_space { break_at = last_space_index + 1 }
            if !writeChunk(file, line, chunk_start, break_at, true) { return false }
            chunk_start = break_at
            i = break_at
            column = 0
            has_last_space = false
            continue
        }
        if byte == 32 || byte == 9 {
            has_last_space = true
            last_space_index = i
        }
        column += char_width
        i += 1
    }
    return writeChunk(file, line, chunk_start, length, trailing_newline)
}

fn processBuffer(file: std.fs.File, options: Options, data: [*]const u8, length: usize) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index < length {
        if data[index] == 10 {
            var line: [*]const u8 = undefined
            unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
            if !foldLine(file, line, index - start, options, true) { return false }
            start = index + 1
        }
        index += 1
    }
    if start < length {
        var line: [*]const u8 = undefined
        unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(data) + start) }
        if !foldLine(file, line, length - start, options, false) { return false }
    }
    return true
}

fn processFile(file: std.fs.File, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const data = std.fs.readToEndAlloc(file, allocator)
    var ok = true
    unsafe {
        ok = processBuffer(std.io.stdout(), options, @ptrCast([*]const u8, data.items), data.length)
    }
    data.deinit()
    return ok
}

fn processPath(path: std.string.String, options: Options) -> bool {
    if common.isDash(path) { return processFile(std.io.stdin(), options) }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("fold", path)
        return false
    }
    const processed = processFile(file, options)
    const closed = std.fs.close(file)
    if !processed { common.writeFileError("fold", path) }
    return processed && closed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: fold [OPTION]... [FILE]...\nWrap input lines in each FILE, writing to standard output.\n  -b, --bytes         count bytes rather than columns\n  -s, --spaces        break at spaces\n  -w, --width=WIDTH    use WIDTH columns instead of 80\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx fold 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("fold", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    if options.firstFile >= count { return if processFile(std.io.stdin(), options) { 0 } else { 1 } }
    var status: u8 = 0
    var index = options.firstFile
    while index < count {
        if !processPath(std.process.argument(arguments, index), options) { status = 1 }
        index += 1
    }
    return status
}
