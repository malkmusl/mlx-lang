const std = @import("std")
const common = @import("../common.mlx")
const paths = @import("../paths.mlx")

const Options = struct {
    noClobber: bool
    update: bool
    verbose: bool
    exchange: bool
    targetDirectory: std.string.String
    targetSet: bool
    noTargetDirectory: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn setTarget(arguments: [][*]const u8, index: *usize, attached: std.string.String, options: *Options) -> bool {
    var value = attached
    if value.length == 0 {
        index.* += 1
        if index.* >= std.process.count(arguments) { return false }
        value = std.process.argument(arguments, index.*)
    }
    options.*.targetDirectory = value
    options.*.targetSet = true
    return true
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const byte = argument.pointer[current]
        if byte == 102 { options.*.noClobber = false } else if byte == 110 { options.*.noClobber = true } else if byte == 117 {
            options.*.update = true
        } else if byte == 118 { options.*.verbose = true } else if byte == 84 { options.*.noTargetDirectory = true } else if byte == 90 {
        } else if byte == 116 { return setTarget(arguments, index, std.string.slice(argument, current + 1, argument.length), options) } else {
            return false
        }
        current += 1
    }
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--force") { options.*.noClobber = false } else if common.equals(argument, "--no-clobber") {
        options.*.noClobber = true
    } else if common.equals(argument, "--verbose") || common.equals(argument, "--debug") { options.*.verbose = true } else if common.equals(argument, "--exchange") {
        options.*.exchange = true
    } else if common.equals(argument, "--no-copy") || common.equals(argument, "--strip-trailing-slashes") || common.equals(argument, "--context") {
    } else if common.equals(argument, "--no-target-directory") { options.*.noTargetDirectory = true } else if common.equals(argument, "--update") || std.string.startsWith(argument, std.string.fromSlice("--update=")) {
        options.*.update = true
    } else if common.equals(argument, "--target-directory") { return setTarget(arguments, index, std.string.fromSlice(""), options) } else if std.string.startsWith(argument, std.string.fromSlice("--target-directory=")) {
        const target = std.string.slice(argument, 19, argument.length)
        if target.length == 0 { return false }
        return setTarget(arguments, index, target, options)
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") {
        options.*.action = 2
    } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .noClobber = false, .update = false, .verbose = false, .exchange = false, .targetDirectory = std.string.fromSlice(""), .targetSet = false, .noTargetDirectory = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn isDirectory(status: std.fs.Stat) -> bool {
    return status.mode & 61440 == 16384
}

fn reportMove(source: std.string.String, destination: std.string.String, verbose: bool) -> void {
    if !verbose { return }
    const first = std.io.print("renamed '")
    const second = std.io.printString(source)
    const third = std.io.print("' -> '")
    const fourth = std.io.printString(destination)
    const fifth = std.io.print("'\n")
}

fn movePath(source: std.string.String, destination: std.string.String, options: Options) -> bool {
    var source_status: std.fs.Stat = undefined
    if std.fs.status(source.pointer, &source_status) != 0 { return false }
    var target_status: std.fs.Stat = undefined
    const target_exists = std.fs.status(destination.pointer, &target_status) == 0
    if target_exists && target_status.device == source_status.device && target_status.inode == source_status.inode { return false }
    if target_exists && options.update && target_status.modifiedSeconds >= source_status.modifiedSeconds { return true }
    if target_exists && options.noClobber { return true }
    const flags: usize = if options.exchange { 2 } else if options.noClobber { 1 } else { 0 }
    const moved = if flags == 0 { std.fs.rename(source.pointer, destination.pointer) } else { std.fs.renameWithFlags(source.pointer, destination.pointer, flags) }
    if moved { reportMove(source, destination, options.verbose) }
    return moved
}

fn moveInto(source: std.string.String, destination: std.string.String, destination_directory: bool, options: Options) -> bool {
    if !destination_directory { return movePath(source, destination, options) }
    const joined = paths.join(destination, paths.basename(source))
    if joined == null { return false }
    const path = joined.?
    const result = movePath(source, std.string.fromParts(path.pointer, path.length), options)
    common.freePath(path)
    return result
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: mv [OPTION]... SOURCE... DESTINATION\n  -f, --force       overwrite destinations\n  -n, --no-clobber  do not overwrite\n  -t, --target-directory=DIR  move into DIR\n  -T, --no-target-directory   treat DEST as a file\n  -u, --update      move only when source is newer\n  -v, --verbose     report moves\n      --exchange    exchange two paths\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx mv 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    const operand_count = count - options.firstOperand
    if options.invalid || operand_count < if options.targetSet { 1 } else { 2 } {
        common.writeMessage("mv", "missing operand or unsupported option")
        return 1
    }
    const destination = if options.targetSet { options.targetDirectory } else { std.process.argument(arguments, count - 1) }
    var destination_status: std.fs.Stat = undefined
    const destination_directory = !options.noTargetDirectory && std.fs.status(destination.pointer, &destination_status) == 0 && isDirectory(destination_status)
    const source_end = if options.targetSet { count } else { count - 1 }
    if source_end - options.firstOperand > 1 && !destination_directory { return 1 }
    var success = true
    var index = options.firstOperand
    while index < source_end {
        const source = std.process.argument(arguments, index)
        if !moveInto(source, destination, destination_directory, options) {
            common.writePathError("mv", "cannot move", source)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
