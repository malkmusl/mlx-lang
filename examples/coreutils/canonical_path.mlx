const std = @import("std")
const common = @import("./common.mlx")

const LIMIT: usize = 65536

const Scratch = struct {
    first: [*]u8
    second: [*]u8
    third: [*]u8
    link: [*]u8
    valid: bool
}

const Component = struct {
    start: usize
    end: usize
    valid: bool
}

fn allocateScratch() -> Scratch {
    const allocator = std.page_allocator.init()
    const first = allocator.allocFn(allocator.context, LIMIT, 8)
    const second = allocator.allocFn(allocator.context, LIMIT, 8)
    const third = allocator.allocFn(allocator.context, LIMIT, 8)
    const link = allocator.allocFn(allocator.context, LIMIT, 8)
    if first == null || second == null || third == null || link == null {
        if first != null { allocator.freeFn(allocator.context, first.?, LIMIT, 8) }
        if second != null { allocator.freeFn(allocator.context, second.?, LIMIT, 8) }
        if third != null { allocator.freeFn(allocator.context, third.?, LIMIT, 8) }
        if link != null { allocator.freeFn(allocator.context, link.?, LIMIT, 8) }
        return Scratch.{ .first = undefined, .second = undefined, .third = undefined, .link = undefined, .valid = false }
    }
    return Scratch.{ .first = first.?, .second = second.?, .third = third.?, .link = link.?, .valid = true }
}

fn freeScratch(scratch: Scratch) -> void {
    if !scratch.valid { return }
    const allocator = std.page_allocator.init()
    allocator.freeFn(allocator.context, scratch.first, LIMIT, 8)
    allocator.freeFn(allocator.context, scratch.second, LIMIT, 8)
    allocator.freeFn(allocator.context, scratch.third, LIMIT, 8)
    allocator.freeFn(allocator.context, scratch.link, LIMIT, 8)
}

fn copyBytes(destination: [*]u8, offset: *usize, source: [*]const u8, length: usize) -> bool {
    if offset.* + length >= LIMIT { return false }
    var index: usize = 0
    while index < length {
        destination[offset.*] = source[index]
        offset.* += 1
        index += 1
    }
    destination[offset.*] = 0
    return true
}

fn initialPath(destination: [*]u8, input: std.string.String) -> ?usize {
    var length: usize = 0
    if input.length == 0 { return null }
    if input.pointer[0] != 47 {
        const cwd = std.fs.getWorkingDirectory(destination, LIMIT)
        if cwd <= 0 { return null }
        length = @bitCast(usize, cwd) - 1
        if length + 1 >= LIMIT { return null }
        destination[length] = 47
        length += 1
    }
    if !copyBytes(destination, &length, input.pointer, input.length) { return null }
    return length
}

fn appendComponent(destination: [*]u8, length: *usize, component: [*]const u8, component_length: usize) -> bool {
    if length.* + component_length + 1 >= LIMIT { return false }
    if length.* == 0 || destination[length.* - 1] != 47 {
        destination[length.*] = 47
        length.* += 1
    }
    return copyBytes(destination, length, component, component_length)
}

fn popComponent(path: [*]u8, length: *usize) -> void {
    while length.* > 0 && path[length.* - 1] == 47 { length.* -= 1 }
    while length.* > 0 && path[length.* - 1] != 47 { length.* -= 1 }
    while length.* > 1 && path[length.* - 1] == 47 { length.* -= 1 }
    path[length.*] = 0
}

fn nextComponent(path: [*]u8, length: usize, index: *usize) -> std.string.String {
    while index.* < length && path[index.*] == 47 { index.* += 1 }
    const start = index.*
    while index.* < length && path[index.*] != 47 { index.* += 1 }
    unsafe { return std.string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(path) + start), index.* - start) }
}

fn hasComponent(path: [*]u8, length: usize, index: usize) -> bool {
    var current = index
    while current < length && path[current] == 47 { current += 1 }
    return current < length
}

fn isDot(component: std.string.String) -> bool {
    return component.length == 1 && component.pointer[0] == 46
}

fn isDotDot(component: std.string.String) -> bool {
    return component.length == 2 && component.pointer[0] == 46 && component.pointer[1] == 46
}

fn rebuildPending(destination: [*]u8, resolved: [*]u8, resolved_length: usize, target: [*]u8, target_length: usize, pending: [*]u8, pending_length: usize, remainder: usize) -> ?usize {
    var length: usize = 0
    if target_length == 0 { return null }
    if target[0] != 47 && resolved_length > 0 && !copyBytes(destination, &length, resolved, resolved_length) { return null }
    if target[0] != 47 && (length == 0 || destination[length - 1] != 47) {
        destination[length] = 47
        length += 1
    }
    if !copyBytes(destination, &length, target, target_length) { return null }
    if remainder < pending_length && destination[length - 1] != 47 {
        destination[length] = 47
        length += 1
    }
    if remainder < pending_length {
        var remainder_pointer: [*]const u8 = undefined
        unsafe { remainder_pointer = @ptrFromInt([*]const u8, @intFromPtr(pending) + remainder) }
        if !copyBytes(destination, &length, remainder_pointer, pending_length - remainder) { return null }
    }
    return length
}

fn componentAllowed(path: [*]u8, last: bool, mode: u8, follow: bool, scratch: Scratch, link_count: *usize) -> (bool, usize) {
    var status: std.fs.Stat = undefined
    const result = std.fs.statusAt(path, &status, true)
    if result != 0 { return -> (mode == 2 || mode == 0 && last, 0) }
    const symbolic = status.mode & 61440 == 40960
    if symbolic && follow {
        const amount = std.fs.readLink(path, scratch.link, LIMIT - 1)
        if amount <= 0 || link_count.* >= 40 { return -> (false, 0) }
        link_count.* += 1
        return -> (true, @bitCast(usize, amount))
    }
    if !last && status.mode & 61440 != 16384 { return -> (mode == 2, 0) }
    return -> (true, 0)
}

fn resolveLoop(scratch: Scratch, pending_length_start: usize, mode: u8, follow: bool) -> ?std.string.String {
    var pending = scratch.first
    var spare = scratch.second
    var available = scratch.third
    var pending_length = pending_length_start
    var resolved_length: usize = 0
    var index: usize = 0
    var links: usize = 0
    while hasComponent(pending, pending_length, index) {
        const component = nextComponent(pending, pending_length, &index)
        if isDot(component) { continue }
        if isDotDot(component) {
            popComponent(spare, &resolved_length)
            continue
        }
        if !appendComponent(spare, &resolved_length, component.pointer, component.length) { return null }
        const last = !hasComponent(pending, pending_length, index)
        const allowance = componentAllowed(spare, last, mode, follow, scratch, &links)
        if !allowance.0 { return null }
        const link_length = allowance.1
        if link_length > 0 {
            popComponent(spare, &resolved_length)
            const rebuilt = rebuildPending(available, spare, resolved_length, scratch.link, link_length, pending, pending_length, index)
            if rebuilt == null { return null }
            const previous_pending = pending
            pending = available
            available = spare
            spare = previous_pending
            pending_length = rebuilt.?
            index = 0
            resolved_length = 0
        }
    }
    if resolved_length == 0 {
        spare[0] = 47
        spare[1] = 0
        resolved_length = 1
    }
    return std.string.fromParts(spare, resolved_length)
}

pub fn canonicalize(input: std.string.String, mode: u8, follow: bool) -> ?common.MutablePath {
    const scratch = allocateScratch()
    if !scratch.valid { return null }
    const pending_length = initialPath(scratch.first, input)
    var result: ?common.MutablePath = null
    if pending_length != null {
        const resolved = resolveLoop(scratch, pending_length.?, mode, follow)
        if resolved != null {
            var valid = true
            if mode == 1 {
                var status: std.fs.Stat = undefined
                valid = std.fs.status(resolved.?.pointer, &status) == 0
                if valid && input.length > 0 && input.pointer[input.length - 1] == 47 { valid = status.mode & 61440 == 16384 }
            }
            if valid { result = common.allocatePath(resolved.?) }
        }
    }
    freeScratch(scratch)
    return result
}

fn nextPathComponent(path: std.string.String, index: *usize) -> Component {
    while index.* < path.length && path.pointer[index.*] == 47 { index.* += 1 }
    if index.* >= path.length { return Component.{ .start = path.length, .end = path.length, .valid = false } }
    const start = index.*
    while index.* < path.length && path.pointer[index.*] != 47 { index.* += 1 }
    return Component.{ .start = start, .end = index.*, .valid = true }
}

fn componentsEqual(left: std.string.String, left_component: Component, right: std.string.String, right_component: Component) -> bool {
    const left_length = left_component.end - left_component.start
    if left_length != right_component.end - right_component.start { return false }
    var index: usize = 0
    while index < left_length {
        if left.pointer[left_component.start + index] != right.pointer[right_component.start + index] { return false }
        index += 1
    }
    return true
}

fn appendRelativeComponent(buffer: [*]u8, length: *usize, component: [*]const u8, component_length: usize) -> bool {
    if length.* > 0 {
        if length.* + 1 >= LIMIT { return false }
        buffer[length.*] = 47
        length.* += 1
    }
    return copyBytes(buffer, length, component, component_length)
}

fn relativeRemainder(buffer: [*]u8, length: *usize, base: std.string.String, base_index: usize, target: std.string.String, target_index: usize) -> bool {
    var current = base_index
    while true {
        const component = nextPathComponent(base, &current)
        if !component.valid { break }
        if !appendRelativeComponent(buffer, length, @ptrCast([*]const u8, ".."), 2) { return false }
    }
    current = target_index
    while true {
        const component = nextPathComponent(target, &current)
        if !component.valid { break }
        var pointer: [*]const u8 = undefined
        unsafe { pointer = @ptrFromInt([*]const u8, @intFromPtr(target.pointer) + component.start) }
        if !appendRelativeComponent(buffer, length, pointer, component.end - component.start) { return false }
    }
    return true
}

pub fn relativeTo(target: std.string.String, base: std.string.String) -> ?common.MutablePath {
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, LIMIT, 8)
    if allocation == null { return null }
    const buffer = allocation.?
    var target_index: usize = 0
    var base_index: usize = 0
    while true {
        const target_before = target_index
        const base_before = base_index
        const target_component = nextPathComponent(target, &target_index)
        const base_component = nextPathComponent(base, &base_index)
        if !target_component.valid || !base_component.valid || !componentsEqual(target, target_component, base, base_component) {
            target_index = target_before
            base_index = base_before
            break
        }
    }
    var length: usize = 0
    var valid = relativeRemainder(buffer, &length, base, base_index, target, target_index)
    if valid && length == 0 { valid = copyBytes(buffer, &length, @ptrCast([*]const u8, "."), 1) }
    var result: ?common.MutablePath = null
    if valid { result = common.allocatePath(std.string.fromParts(buffer, length)) }
    allocator.freeFn(allocator.context, buffer, LIMIT, 8)
    return result
}

pub fn isBelow(path: std.string.String, base: std.string.String) -> bool {
    if base.length == 1 && base.pointer[0] == 47 { return path.length > 0 && path.pointer[0] == 47 }
    if path.length < base.length { return false }
    var index: usize = 0
    while index < base.length {
        if path.pointer[index] != base.pointer[index] { return false }
        index += 1
    }
    return path.length == base.length || path.pointer[base.length] == 47
}
