const std = @import("std")

const CAPACITY: usize = 65536

const Database = struct {
    buffer: [*]u8
    length: usize
    valid: bool
}

pub const Context = struct {
    users: Database
    groups: Database
}

fn load(path: [*]const u8) -> Database {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(CAPACITY, 8)
    if allocation == null { return Database.{ .buffer = undefined, .length = 0, .valid = false } }
    const file = std.fs.open(path, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        allocator.free(allocation.?, CAPACITY, 8)
        return Database.{ .buffer = undefined, .length = 0, .valid = false }
    }
    var length: usize = 0
    var valid = true
    while length < CAPACITY {
        var destination: [*]u8 = undefined
        unsafe { destination = @ptrFromInt([*]u8, @intFromPtr(allocation.?) + length) }
        const amount = std.fs.read(file, destination, CAPACITY - length)
        if amount < 0 {
            valid = false
            break
        }
        if amount == 0 { break }
        length += @bitCast(usize, amount)
    }
    const closed = std.fs.close(file)
    if valid && closed { return Database.{ .buffer = allocation.?, .length = length, .valid = true } }
    allocator.free(allocation.?, CAPACITY, 8)
    return Database.{ .buffer = undefined, .length = 0, .valid = false }
}

pub fn init() -> Context {
    unsafe {
        return Context.{ .users = load(@ptrCast([*]const u8, "/etc/passwd")), .groups = load(@ptrCast([*]const u8, "/etc/group")) }
    }
}

fn unload(database: Database) -> void {
    if !database.valid { return }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    allocator.free(database.buffer, CAPACITY, 8)
}

pub fn deinit(context: Context) -> void {
    unload(context.users)
    unload(context.groups)
}

const IdResult = struct {
    value: u32
    valid: bool
}

fn invalidId() -> IdResult { return IdResult.{ .value = 0, .valid = false } }

fn parseId(value: std.string.String) -> IdResult {
    if value.length == 0 { return invalidId() }
    var result: usize = 0
    var index: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        if byte < 48 || byte > 57 { return invalidId() }
        result = result * 10 + @intCast(usize, byte - 48)
        if result > 4294967295 { return invalidId() }
        index += 1
    }
    return IdResult.{ .value = @intCast(u32, result), .valid = true }
}

fn field(line: std.string.String, wanted: usize) -> std.string.String {
    var fieldIndex: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index <= line.length {
        if index == line.length || line.pointer[index] == 58 {
            if fieldIndex == wanted { return std.string.slice(line, start, index) }
            fieldIndex += 1
            start = index + 1
        }
        index += 1
    }
    return std.string.slice(line, line.length, line.length)
}

fn nameIn(database: Database, id: u32) -> ?std.string.String {
    if !database.valid { return null }
    var start: usize = 0
    while start < database.length {
        var end = start
        while end < database.length && database.buffer[end] != 10 { end += 1 }
        var pointer: [*]const u8 = undefined
        unsafe { pointer = @ptrFromInt([*]const u8, @intFromPtr(database.buffer) + start) }
        const line = std.string.fromParts(pointer, end - start)
        const parsed = parseId(field(line, 2))
        if parsed.valid && parsed.value == id { return field(line, 0) }
        start = end + 1
    }
    return null
}

pub fn user(context: Context, id: u32) -> ?std.string.String { return nameIn(context.users, id) }

pub fn group(context: Context, id: u32) -> ?std.string.String { return nameIn(context.groups, id) }
