const std = @import("std")

const TCGETS: usize = 21505
const TIOCGWINSZ: usize = 21523

const WindowSize = struct {
    rows: u16
    columns: u16
    pixelWidth: u16
    pixelHeight: u16
}

pub fn isTerminal(file: std.fs.File) -> bool {
    var termios: [64]u8 = undefined
    unsafe { return std.os.linux.syscall3(std.os.linux.SYS_ioctl, @bitCast(usize, file.descriptor), TCGETS, @intFromPtr(&termios)) == 0 }
}

pub fn width(file: std.fs.File) -> usize {
    var size = WindowSize.{ .rows = 0, .columns = 0, .pixelWidth = 0, .pixelHeight = 0 }
    var result: isize = 0
    unsafe { result = std.os.linux.syscall3(std.os.linux.SYS_ioctl, @bitCast(usize, file.descriptor), TIOCGWINSZ, @intFromPtr(&size)) }
    if result != 0 || size.columns == 0 { return 80 }
    return @intCast(usize, size.columns)
}
