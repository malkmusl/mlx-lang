const std = @import("std")

const ClassResult = struct {
    matched: bool
    next: usize
    valid: bool
}

fn classContains(nameByte: u8, pattern: std.string.String, start: usize) -> ClassResult {
    var index = start + 1
    var negate = false
    if index < pattern.length && (pattern.pointer[index] == 33 || pattern.pointer[index] == 94) {
        negate = true
        index += 1
    }
    var matched = false
    var consumed = false
    while index < pattern.length && pattern.pointer[index] != 93 {
        var first = pattern.pointer[index]
        if first == 92 && index + 1 < pattern.length {
            index += 1
            first = pattern.pointer[index]
        }
        index += 1
        var last = first
        if index + 1 < pattern.length && pattern.pointer[index] == 45 && pattern.pointer[index + 1] != 93 {
            index += 1
            last = pattern.pointer[index]
            index += 1
        }
        if nameByte >= first && nameByte <= last { matched = true }
        consumed = true
    }
    if index >= pattern.length || !consumed { return ClassResult.{ .matched = false, .next = start + 1, .valid = false } }
    return ClassResult.{ .matched = if negate { !matched } else { matched }, .next = index + 1, .valid = true }
}

fn matchFrom(name: std.string.String, nameIndex: usize, pattern: std.string.String, patternIndex: usize) -> bool {
    if patternIndex == pattern.length { return nameIndex == name.length }
    const token = pattern.pointer[patternIndex]
    if token == 42 {
        var next = patternIndex + 1
        while next < pattern.length && pattern.pointer[next] == 42 { next += 1 }
        if next == pattern.length { return true }
        var index = nameIndex
        while index <= name.length {
            if matchFrom(name, index, pattern, next) { return true }
            index += 1
        }
        return false
    }
    if nameIndex == name.length { return false }
    if token == 63 { return matchFrom(name, nameIndex + 1, pattern, patternIndex + 1) }
    if token == 91 {
        const result = classContains(name.pointer[nameIndex], pattern, patternIndex)
        if result.valid { return result.matched && matchFrom(name, nameIndex + 1, pattern, result.next) }
    }
    var literal = token
    var next = patternIndex + 1
    if token == 92 && next < pattern.length {
        literal = pattern.pointer[next]
        next += 1
    }
    return name.pointer[nameIndex] == literal && matchFrom(name, nameIndex + 1, pattern, next)
}

pub fn matches(name: std.string.String, pattern: std.string.String) -> bool {
    return matchFrom(name, 0, pattern, 0)
}
