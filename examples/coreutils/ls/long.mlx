const std = @import("std")
const common = @import("../common.mlx")
const paths = @import("../paths.mlx")
const accounts = @import("../ownership/accounts.mlx")
const entries = @import("./entries.mlx")
const options_module = @import("./options.mlx")

const Options = options_module.Options

const Widths = struct {
    inode: usize
    blocks: usize
    links: usize
    user: usize
    group: usize
    size: usize
}

const Calendar = struct {
    year: usize
    month: usize
    day: usize
    hour: usize
    minute: usize
    second: usize
}

fn digits(value: usize) -> usize {
    var remaining = value
    var result: usize = 1
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn blocks(status: std.fs.Stat) -> usize {
    const raw = if status.blocks < 0 { 0 } else { @bitCast(usize, status.blocks) }
    return (raw + 1) / 2
}

fn widths(listing: *entries.List) -> Widths {
    var result = Widths.{ .inode = 1, .blocks = 1, .links = 1, .user = 1, .group = 1, .size = 1 }
    var index: usize = 0
    while index < listing.*.items.length {
        const status = entries.at(listing, index).*.status
        const size = if status.size < 0 { 0 } else { @bitCast(usize, status.size) }
        result.inode = if digits(status.inode) > result.inode { digits(status.inode) } else { result.inode }
        result.blocks = if digits(blocks(status)) > result.blocks { digits(blocks(status)) } else { result.blocks }
        result.links = if digits(status.links) > result.links { digits(status.links) } else { result.links }
        result.user = if digits(@intCast(usize, status.user)) > result.user { digits(@intCast(usize, status.user)) } else { result.user }
        result.group = if digits(@intCast(usize, status.group)) > result.group { digits(@intCast(usize, status.group)) } else { result.group }
        result.size = if digits(size) > result.size { digits(size) } else { result.size }
        index += 1
    }
    return result
}

fn padding(amount: usize, byte: u8) -> bool {
    var remaining = amount
    const value = [1]u8{byte}
    while remaining > 0 {
        if !std.io.writeAll(std.io.stdout(), value[0..1]) { return false }
        remaining -= 1
    }
    return true
}

fn unsignedField(value: usize, width: usize) -> bool {
    const length = digits(value)
    return padding(if width > length { width - length } else { 0 }, 32) && std.io.writeUnsigned(std.io.stdout(), value)
}

fn executeCharacter(mode: usize, execute: usize, special: usize, lower: u8, upper: u8) -> u8 {
    if mode & special != 0 { return if mode & execute != 0 { lower } else { upper } }
    return if mode & execute != 0 { 120 } else { 45 }
}

fn typeCharacter(mode: usize) -> u8 {
    const kind = mode & 61440
    if kind == 16384 { return 100 }
    if kind == 40960 { return 108 }
    if kind == 24576 { return 98 }
    if kind == 8192 { return 99 }
    if kind == 4096 { return 112 }
    if kind == 49152 { return 115 }
    return if kind == 32768 { 45 } else { 63 }
}

fn writeMode(raw_mode: u32) -> bool {
    const mode = @intCast(usize, raw_mode)
    var text: [10]u8 = undefined
    text[0] = typeCharacter(mode)
    text[1] = if mode & 256 != 0 { 114 } else { 45 }
    text[2] = if mode & 128 != 0 { 119 } else { 45 }
    text[3] = executeCharacter(mode, 64, 2048, 115, 83)
    text[4] = if mode & 32 != 0 { 114 } else { 45 }
    text[5] = if mode & 16 != 0 { 119 } else { 45 }
    text[6] = executeCharacter(mode, 8, 1024, 115, 83)
    text[7] = if mode & 4 != 0 { 114 } else { 45 }
    text[8] = if mode & 2 != 0 { 119 } else { 45 }
    text[9] = executeCharacter(mode, 1, 512, 116, 84)
    return std.io.writeAll(std.io.stdout(), text[0..10])
}

fn calendar(seconds: isize) -> Calendar {
    const safe_seconds: usize = if seconds < 0 { 0 } else { @bitCast(usize, seconds) }
    const days = safe_seconds / 86400
    const clock = safe_seconds % 86400
    const z = days + 719468
    const era = z / 146097
    const day_of_era = z - era * 146097
    const year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365
    var year = year_of_era + era * 400
    const day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
    const month_part = (5 * day_of_year + 2) / 153
    const day = day_of_year - (153 * month_part + 2) / 5 + 1
    const month = if month_part < 10 { month_part + 3 } else { month_part - 9 }
    if month <= 2 { year += 1 }
    return Calendar.{ .year = year, .month = month, .day = day, .hour = clock / 3600, .minute = clock / 60 % 60, .second = clock % 60 }
}

fn fixed(value: usize, width: usize) -> bool {
    const length = digits(value)
    return padding(if width > length { width - length } else { 0 }, 48) && std.io.writeUnsigned(std.io.stdout(), value)
}

fn writeTime(status: std.fs.Stat) -> bool {
    const value = calendar(status.modifiedSeconds)
    if !fixed(value.year, 4) || !std.io.print("-") || !fixed(value.month, 2) || !std.io.print("-") || !fixed(value.day, 2) { return false }
    if !std.io.print(" ") || !fixed(value.hour, 2) || !std.io.print(":") || !fixed(value.minute, 2) || !std.io.print(":") || !fixed(value.second, 2) { return false }
    if !std.io.print(".") || !fixed(@bitCast(usize, status.modifiedNanoseconds), 9) { return false }
    return std.io.print(" +0000")
}

fn indicator(status: std.fs.Stat, style: u8) -> u8 {
    if style == 0 { return 0 }
    const mode = @intCast(usize, status.mode)
    const kind = mode & 61440
    if kind == 16384 { return 47 }
    if style == 1 { return 0 }
    if kind == 40960 { return 64 }
    if kind == 4096 { return 124 }
    if kind == 49152 { return 61 }
    if style == 3 && kind == 32768 && mode & 73 != 0 { return 42 }
    return 0
}

fn writeLinkTarget(parent: std.string.String, name: std.string.String, status: std.fs.Stat) -> bool {
    if status.mode & 61440 != 40960 { return true }
    const owned = if parent.length > 0 { paths.join(parent, name) } else { common.allocatePath(name) }
    if owned == null { return false }
    var target: [4096]u8 = undefined
    const length = std.fs.readLink(owned.?.pointer, @ptrCast([*]u8, target[0..4096]), 4096)
    common.freePath(owned.?)
    if length < 0 { return false }
    return std.io.print(" -> ") && std.io.writeAll(std.io.stdout(), target[0..@bitCast(usize, length)])
}

fn writeIdentity(status: std.fs.Stat, options: Options, sizes: Widths) -> bool {
    if options.numeric {
        if !unsignedField(@intCast(usize, status.user), sizes.user) { return false }
    } else if !accounts.writeUserName(status.user, std.io.stdout()) { return false }
    if !std.io.print(" ") { return false }
    if options.numeric { return unsignedField(@intCast(usize, status.group), sizes.group) }
    return accounts.writeGroupName(status.group, std.io.stdout())
}

fn writeRow(entry: *entries.Entry, parent: std.string.String, options: Options, sizes: Widths) -> bool {
    const status = entry.*.status
    const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
    if options.inode && (!unsignedField(status.inode, sizes.inode) || !std.io.print(" ")) { return false }
    if options.blocks && (!unsignedField(blocks(status), sizes.blocks) || !std.io.print(" ")) { return false }
    if !writeMode(status.mode) || !std.io.print(" ") || !unsignedField(status.links, sizes.links) || !std.io.print(" ") { return false }
    if !writeIdentity(status, options, sizes) || !std.io.print(" ") { return false }
    const size = if status.size < 0 { 0 } else { @bitCast(usize, status.size) }
    if !unsignedField(size, sizes.size) || !std.io.print(" ") || !writeTime(status) || !std.io.print(" ") { return false }
    if !std.io.printString(name) { return false }
    const suffix = indicator(status, options.indicator)
    if suffix != 0 {
        const value = [1]u8{suffix}
        if !std.io.writeAll(std.io.stdout(), value[0..1]) { return false }
    }
    return writeLinkTarget(parent, name, status) && std.io.print("\n")
}

fn writeTotal(listing: *entries.List) -> bool {
    var raw_blocks: usize = 0
    var index: usize = 0
    while index < listing.*.items.length {
        const value = entries.at(listing, index).*.status.blocks
        if value > 0 { raw_blocks += @bitCast(usize, value) }
        index += 1
    }
    return std.io.print("total ") && std.io.writeUnsigned(std.io.stdout(), (raw_blocks + 1) / 2) && std.io.print("\n")
}

pub fn list(listing: *entries.List, parent: std.string.String, directory: bool, options: Options) -> bool {
    if directory && !writeTotal(listing) { return false }
    const sizes = widths(listing)
    var index: usize = 0
    while index < listing.*.items.length {
        if !writeRow(entries.at(listing, index), parent, options, sizes) { return false }
        index += 1
    }
    return true
}
