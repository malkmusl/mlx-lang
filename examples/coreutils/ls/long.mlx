const std = @import("std")
const common = @import("../common.mlx")
const paths = @import("../paths.mlx")
const entries = @import("./entries.mlx")
const identity = @import("./identity.mlx")
const item = @import("./item.mlx")
const names = @import("./names.mlx")
const options_module = @import("./options.mlx")
const size_format = @import("./size_format.mlx")
const time_format = @import("./time_format.mlx")
const timezone = @import("./timezone.mlx")

const Options = options_module.Options

const Widths = struct {
    inode: usize
    blocks: usize
    links: usize
    user: usize
    group: usize
    size: usize
}

fn digits(value: usize) -> usize {
    var remaining = value
    var result: usize = 1
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn blockCount(status: std.fs.Stat, options: Options) -> usize {
    const raw = if status.blocks < 0 { 0 } else { @bitCast(usize, status.blocks) }
    if options.human != 0 { return raw * 512 }
    const unit = if options.blockSize == 0 { 1 } else { options.blockSize }
    return (raw * 512 + unit - 1) / unit
}

fn identityWidth(name: ?std.string.String, id: u32, numeric: bool) -> usize {
    if !numeric && name != null { return name.?.length }
    return digits(@intCast(usize, id))
}

fn widths(listing: *entries.List, options: Options, identities: identity.Context) -> Widths {
    var result = Widths.{ .inode = 1, .blocks = 1, .links = 1, .user = 1, .group = 1, .size = 1 }
    var index: usize = 0
    while index < listing.*.items.length {
        const status = entries.at(listing, index).*.status
        const size = if status.size < 0 { 0 } else { @bitCast(usize, status.size) }
        const inodeWidth = digits(status.inode)
        const blockWidth = if options.human == 0 { digits(blockCount(status, options)) } else { size_format.width(blockCount(status, options), options) }
        const linkWidth = digits(status.links)
        const userWidth = identityWidth(identity.user(identities, status.user), status.user, options.numeric)
        const groupWidth = identityWidth(identity.group(identities, status.group), status.group, options.numeric)
        const sizeWidth = size_format.width(size, options)
        if inodeWidth > result.inode { result.inode = inodeWidth }
        if blockWidth > result.blocks { result.blocks = blockWidth }
        if linkWidth > result.links { result.links = linkWidth }
        if userWidth > result.user { result.user = userWidth }
        if groupWidth > result.group { result.group = groupWidth }
        if sizeWidth > result.size { result.size = sizeWidth }
        index += 1
    }
    return result
}

fn padding(amount: usize) -> bool {
    var remaining = amount
    while remaining > 0 {
        if !std.io.print(" ") { return false }
        remaining -= 1
    }
    return true
}

fn unsignedField(value: usize, width: usize) -> bool {
    const length = digits(value)
    return padding(if width > length { width - length } else { 0 }) && std.io.writeUnsigned(std.io.stdout(), value)
}

fn executeCharacter(mode: usize, execute: usize, special: usize, lower: u8, upper: u8) -> u8 {
    if mode & special != 0 { return if mode & execute != 0 { lower } else { upper } }
    return if mode & execute != 0 { 120 } else { 45 }
}

fn typeCharacter(mode: usize) -> u8 {
    const kind = mode & 61440
    if kind == 16384 { return 100 }
    if kind == 40960 { return 108 }
    if kind == 24576 { return 98 }
    if kind == 8192 { return 99 }
    if kind == 4096 { return 112 }
    if kind == 49152 { return 115 }
    return if kind == 32768 { 45 } else { 63 }
}

fn writeMode(rawMode: u32) -> bool {
    const mode = @intCast(usize, rawMode)
    var text: [10]u8 = undefined
    text[0] = typeCharacter(mode)
    text[1] = if mode & 256 != 0 { 114 } else { 45 }
    text[2] = if mode & 128 != 0 { 119 } else { 45 }
    text[3] = executeCharacter(mode, 64, 2048, 115, 83)
    text[4] = if mode & 32 != 0 { 114 } else { 45 }
    text[5] = if mode & 16 != 0 { 119 } else { 45 }
    text[6] = executeCharacter(mode, 8, 1024, 115, 83)
    text[7] = if mode & 4 != 0 { 114 } else { 45 }
    text[8] = if mode & 2 != 0 { 119 } else { 45 }
    text[9] = executeCharacter(mode, 1, 512, 116, 84)
    return std.io.writeAll(std.io.stdout(), text[0..10])
}

fn writeNamed(value: ?std.string.String, id: u32, width: usize, numeric: bool) -> bool {
    if numeric || value == null { return unsignedField(@intCast(usize, id), width) }
    return std.io.printString(value.?) && padding(width - value.?.length)
}

fn writeIdentities(status: std.fs.Stat, options: Options, sizes: Widths, identities: identity.Context) -> bool {
    const user = identity.user(identities, status.user)
    const group = identity.group(identities, status.group)
    if options.showOwner && (!writeNamed(user, status.user, sizes.user, options.numeric) || !std.io.print(" ")) { return false }
    if options.showGroup && (!writeNamed(group, status.group, sizes.group, options.numeric) || !std.io.print(" ")) { return false }
    if options.author && (!writeNamed(user, status.user, sizes.user, options.numeric) || !std.io.print(" ")) { return false }
    return true
}

fn writeLinkTarget(parent: std.string.String, name: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    if status.mode & 61440 != 40960 { return true }
    const owned = if parent.length > 0 { paths.join(parent, name) } else { common.allocatePath(name) }
    if owned == null { return false }
    var target: [4096]u8 = undefined
    const length = std.fs.readLink(owned.?.pointer, @ptrCast([*]u8, target[0..4096]), 4096)
    common.freePath(owned.?)
    if length < 0 { return false }
    unsafe { return std.io.print(" -> ") && names.write(std.string.fromParts(@ptrCast([*]const u8, target[0..4096]), @bitCast(usize, length)), options.quoting) }
}

fn writeSize(status: std.fs.Stat, options: Options, width: usize) -> bool {
    const value = if status.size < 0 { 0 } else { @bitCast(usize, status.size) }
    const length = size_format.width(value, options)
    return padding(if width > length { width - length } else { 0 }) && size_format.write(value, options)
}

fn writeRow(entry: *entries.Entry, parent: std.string.String, options: Options, sizes: Widths, identities: identity.Context, zone: timezone.Context) -> bool {
    const status = entry.*.status
    const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
    if options.inode && (!unsignedField(status.inode, sizes.inode) || !std.io.print(" ")) { return false }
    if options.blocks && (!unsignedField(blockCount(status, options), sizes.blocks) || !std.io.print(" ")) { return false }
    if !writeMode(status.mode) || !std.io.print(" ") || !unsignedField(status.links, sizes.links) || !std.io.print(" ") { return false }
    if !writeIdentities(status, options, sizes, identities) { return false }
    if !writeSize(status, options, sizes.size) || !std.io.print(" ") || !time_format.write(entry, options, zone) || !std.io.print(" ") { return false }
    if !names.write(name, options.quoting) { return false }
    const suffix = item.indicator(status, options.indicator)
    if suffix != 0 {
        const value = [1]u8{suffix}
        if !std.io.writeAll(std.io.stdout(), value[0..1]) { return false }
    }
    return writeLinkTarget(parent, name, status, options) && std.io.print("\n")
}

fn writeTotal(listing: *entries.List, options: Options) -> bool {
    var rawBlocks: usize = 0
    var index: usize = 0
    while index < listing.*.items.length {
        const value = entries.at(listing, index).*.status.blocks
        if value > 0 { rawBlocks += @bitCast(usize, value) }
        index += 1
    }
    return std.io.print("total ") && size_format.writeTotal(rawBlocks * 512, options) && std.io.print("\n")
}

pub fn list(listing: *entries.List, parent: std.string.String, directory: bool, options: Options) -> bool {
    if directory && !writeTotal(listing, options) { return false }
    const identities = identity.init()
    const zone = timezone.init(options.timezone)
    const sizes = widths(listing, options, identities)
    var index: usize = 0
    var written = true
    while index < listing.*.items.length && written {
        written = writeRow(entries.at(listing, index), parent, options, sizes, identities, zone)
        index += 1
    }
    timezone.deinit(zone)
    identity.deinit(identities)
    return written
}
