const std = @import("std")
const common = @import("../common.mlx")
const decorated = @import("./decorated_name.mlx")
const context = @import("./context.mlx")
const dired = @import("./dired.mlx")
const paths = @import("../paths.mlx")
const entries = @import("./entries.mlx")
const identity = @import("./identity.mlx")
const item = @import("./item.mlx")
const names = @import("./names.mlx")
const options_module = @import("./options.mlx")
const size_format = @import("./size_format.mlx")
const time_format = @import("./time_format.mlx")
const timezone = @import("./timezone.mlx")

const Options = options_module.Options

const Widths = struct {
    inode: usize
    blocks: usize
    links: usize
    user: usize
    group: usize
    context: usize
    size: usize
    major: usize
    minor: usize
    hasDevice: bool
    markers: bool
    alignQuotes: bool
}

fn digits(value: usize) -> usize {
    var remaining = value
    var result: usize = 1
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn blockCount(status: std.fs.Stat, options: Options) -> usize {
    const raw = if status.blocks < 0 { 0 } else { @bitCast(usize, status.blocks) }
    if options.human != 0 { return raw * 512 }
    const unit = if options.blockSize == 0 { 1 } else { options.blockSize }
    return (raw * 512 + unit - 1) / unit
}

fn identityWidth(name: ?std.string.String, id: u32, numeric: bool) -> usize {
    if !numeric && name != null { return name.?.length }
    return digits(@intCast(usize, id))
}

fn widths(listing: *entries.List, parent: std.string.String, options: Options, identities: identity.Context) -> Widths {
    var result = Widths.{ .inode = 1, .blocks = 1, .links = 1, .user = 1, .group = 1, .context = 1, .size = 1, .major = 1, .minor = 1, .hasDevice = false, .markers = false, .alignQuotes = false }
    var index: usize = 0
    while index < listing.*.items.length {
        const status = entries.at(listing, index).*.status
        const size = if status.size < 0 { 0 } else { @bitCast(usize, status.size) }
        const inodeWidth = digits(status.inode)
        const blockWidth = if options.human == 0 { digits(blockCount(status, options)) } else { size_format.width(blockCount(status, options), options) }
        const linkWidth = digits(status.links)
        const userWidth = identityWidth(identity.user(identities, status.user), status.user, options.numeric)
        const groupWidth = identityWidth(identity.group(identities, status.group), status.group, options.numeric)
        const device = status.mode & 61440 == 24576 || status.mode & 61440 == 8192
        const sizeWidth = if device { 0 } else { size_format.width(size, options) }
        const majorWidth = if device { digits(size_format.major(status.specialDevice)) } else { 0 }
        const minorWidth = if device { digits(size_format.minor(status.specialDevice)) } else { 0 }
        if device { result.hasDevice = true }
        const entry = entries.at(listing, index)
        const entryName = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
        if names.quoted(entryName, options.quoting) { result.alignQuotes = true }
        if context.marker(parent, entryName) != 0 { result.markers = true }
        if inodeWidth > result.inode { result.inode = inodeWidth }
        if blockWidth > result.blocks { result.blocks = blockWidth }
        if linkWidth > result.links { result.links = linkWidth }
        if userWidth > result.user { result.user = userWidth }
        if groupWidth > result.group { result.group = groupWidth }
        if majorWidth > result.major { result.major = majorWidth }
        if minorWidth > result.minor { result.minor = minorWidth }
        if options.context {
            const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
            const contextWidth = context.width(parent, name)
            if contextWidth > result.context { result.context = contextWidth }
        }
        if sizeWidth > result.size { result.size = sizeWidth }
        index += 1
    }
    if result.hasDevice {
        const deviceWidth = result.major + 2 + result.minor
        if deviceWidth > result.size { result.size = deviceWidth }
    }
    return result
}

fn padding(amount: usize) -> bool {
    var remaining = amount
    while remaining > 0 {
        if !std.io.print(" ") { return false }
        remaining -= 1
    }
    return true
}

fn unsignedField(value: usize, width: usize) -> bool {
    const length = digits(value)
    return padding(if width > length { width - length } else { 0 }) && std.io.writeUnsigned(std.io.stdout(), value)
}

fn executeCharacter(mode: usize, execute: usize, special: usize, lower: u8, upper: u8) -> u8 {
    if mode & special != 0 { return if mode & execute != 0 { lower } else { upper } }
    return if mode & execute != 0 { 120 } else { 45 }
}

fn typeCharacter(mode: usize) -> u8 {
    const kind = mode & 61440
    if kind == 16384 { return 100 }
    if kind == 40960 { return 108 }
    if kind == 24576 { return 98 }
    if kind == 8192 { return 99 }
    if kind == 4096 { return 112 }
    if kind == 49152 { return 115 }
    return if kind == 32768 { 45 } else { 63 }
}

fn writeMode(rawMode: u32) -> bool {
    const mode = @intCast(usize, rawMode)
    var text: [10]u8 = undefined
    text[0] = typeCharacter(mode)
    text[1] = if mode & 256 != 0 { 114 } else { 45 }
    text[2] = if mode & 128 != 0 { 119 } else { 45 }
    text[3] = executeCharacter(mode, 64, 2048, 115, 83)
    text[4] = if mode & 32 != 0 { 114 } else { 45 }
    text[5] = if mode & 16 != 0 { 119 } else { 45 }
    text[6] = executeCharacter(mode, 8, 1024, 115, 83)
    text[7] = if mode & 4 != 0 { 114 } else { 45 }
    text[8] = if mode & 2 != 0 { 119 } else { 45 }
    text[9] = executeCharacter(mode, 1, 512, 116, 84)
    return std.io.writeAll(std.io.stdout(), text[0..10])
}

fn writeNamed(value: ?std.string.String, id: u32, width: usize, numeric: bool) -> bool {
    if numeric || value == null { return unsignedField(@intCast(usize, id), width) }
    return std.io.printString(value.?) && padding(width - value.?.length)
}

fn writeIdentities(status: std.fs.Stat, options: Options, sizes: Widths, identities: identity.Context) -> bool {
    const user = identity.user(identities, status.user)
    const group = identity.group(identities, status.group)
    if options.showOwner && (!writeNamed(user, status.user, sizes.user, options.numeric) || !std.io.print(" ")) { return false }
    if options.showGroup && (!writeNamed(group, status.group, sizes.group, options.numeric) || !std.io.print(" ")) { return false }
    if options.author && (!writeNamed(user, status.user, sizes.user, options.numeric) || !std.io.print(" ")) { return false }
    return true
}

fn writeLinkTarget(parent: std.string.String, name: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    if status.mode & 61440 != 40960 { return true }
    const owned = if parent.length > 0 { paths.join(parent, name) } else { common.allocatePath(name) }
    if owned == null { return false }
    var target: [4096]u8 = undefined
    const length = std.fs.readLink(owned.?.pointer, @ptrCast([*]u8, target[0..4096]), 4096)
    common.freePath(owned.?)
    if length < 0 { return false }
    unsafe { return std.io.print(" -> ") && names.write(std.string.fromParts(@ptrCast([*]const u8, target[0..4096]), @bitCast(usize, length)), options.quoting) }
}

fn linkTargetWidth(parent: std.string.String, name: std.string.String, status: std.fs.Stat, options: Options) -> usize {
    if status.mode & 61440 != 40960 { return 0 }
    const owned = if parent.length > 0 { paths.join(parent, name) } else { common.allocatePath(name) }
    if owned == null { return 0 }
    var target: [4096]u8 = undefined
    const length = std.fs.readLink(owned.?.pointer, @ptrCast([*]u8, target[0..4096]), 4096)
    common.freePath(owned.?)
    if length < 0 { return 0 }
    unsafe { return 4 + names.width(std.string.fromParts(@ptrCast([*]const u8, target[0..4096]), @bitCast(usize, length)), options.quoting) }
}

fn writeSize(status: std.fs.Stat, options: Options, sizes: Widths) -> bool {
    const kind = status.mode & 61440
    if kind == 24576 || kind == 8192 {
        const deviceWidth = sizes.major + 2 + sizes.minor
        return padding(if sizes.size > deviceWidth { sizes.size - deviceWidth } else { 0 }) && unsignedField(size_format.major(status.specialDevice), sizes.major) && std.io.print(", ") && unsignedField(size_format.minor(status.specialDevice), sizes.minor)
    }
    const value = if status.size < 0 { 0 } else { @bitCast(usize, status.size) }
    const length = size_format.width(value, options)
    return padding(if sizes.size > length { sizes.size - length } else { 0 }) && size_format.write(value, options)
}

fn rowPrefixWidth(entry: *entries.Entry, options: Options, sizes: Widths, zone: timezone.Context) -> usize {
    var result: usize = 10 + 1 + sizes.links + 1
    if sizes.markers { result += 1 }
    if options.inode { result += sizes.inode + 1 }
    if options.blocks { result += sizes.blocks + 1 }
    if options.showOwner { result += sizes.user + 1 }
    if options.showGroup { result += sizes.group + 1 }
    if options.author { result += sizes.user + 1 }
    if options.context { result += sizes.context + 1 }
    result += sizes.size + 1
    result += time_format.width(entry, options, zone) + 1
    const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
    return result + if sizes.alignQuotes && !names.quoted(name, options.quoting) { 1 } else { 0 }
}

fn writeRow(entry: *entries.Entry, parent: std.string.String, options: Options, sizes: Widths, identities: identity.Context, zone: timezone.Context, state: *decorated.State, diredState: *dired.State) -> bool {
    const status = entry.*.status
    const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
    if options.dired {
        if !std.io.print("  ") { return false }
        dired.advance(diredState, 2)
    }
    if options.inode && (!unsignedField(status.inode, sizes.inode) || !std.io.print(" ")) { return false }
    if options.blocks && (!unsignedField(blockCount(status, options), sizes.blocks) || !std.io.print(" ")) { return false }
    if !writeMode(status.mode) { return false }
    if sizes.markers {
        const marker = context.marker(parent, name)
        if marker == 0 {
            if !std.io.print(" ") { return false }
        } else if !std.io.writeAll(std.io.stdout(), [1]u8{marker}[0..1]) { return false }
    }
    if !std.io.print(" ") || !unsignedField(status.links, sizes.links) || !std.io.print(" ") { return false }
    if !writeIdentities(status, options, sizes, identities) { return false }
    if options.context && (!context.write(parent, name, sizes.context) || !std.io.print(" ")) { return false }
    if !writeSize(status, options, sizes) || !std.io.print(" ") || !time_format.write(entry, options, zone) || !std.io.print(" ") { return false }
    if sizes.alignQuotes && !names.quoted(name, options.quoting) && !std.io.print(" ") { return false }
    if options.dired {
        dired.advance(diredState, rowPrefixWidth(entry, options, sizes, zone))
        if !dired.beginName(diredState) { return false }
    }
    if !decorated.write(name, status, parent, options, state) { return false }
    if options.dired {
        dired.advance(diredState, names.width(name, options.quoting))
        if !dired.endName(diredState) { return false }
    }
    const suffix = item.indicator(status, options.indicator)
    if suffix != 0 {
        const value = [1]u8{suffix}
        if !std.io.writeAll(std.io.stdout(), value[0..1]) { return false }
    }
    const targetWidth = linkTargetWidth(parent, name, status, options)
    const written = writeLinkTarget(parent, name, status, options) && std.io.print("\n")
    if options.dired { dired.advance(diredState, if suffix == 0 { targetWidth + 1 } else { targetWidth + 2 }) }
    return written
}

fn writeTotal(listing: *entries.List, options: Options, diredState: *dired.State) -> bool {
    var rawBlocks: usize = 0
    var index: usize = 0
    while index < listing.*.items.length {
        const value = entries.at(listing, index).*.status.blocks
        if value > 0 { rawBlocks += @bitCast(usize, value) }
        index += 1
    }
    if options.dired && !std.io.print("  ") { return false }
    const written = std.io.print("total ") && size_format.writeTotal(rawBlocks * 512, options) && std.io.print("\n")
    if options.dired { dired.advance(diredState, 2 + 6 + size_format.totalWidth(rawBlocks * 512, options) + 1) }
    return written
}

pub fn list(listing: *entries.List, parent: std.string.String, directory: bool, options: Options, diredState: *dired.State) -> bool {
    if directory && !writeTotal(listing, options, diredState) { return false }
    const identities = identity.init()
    const zone = timezone.init(options.timezone)
    const sizes = widths(listing, parent, options, identities)
    var index: usize = 0
    var written = true
    var state = decorated.init()
    while index < listing.*.items.length && written {
        written = writeRow(entries.at(listing, index), parent, options, sizes, identities, zone, &state, diredState)
        index += 1
    }
    timezone.deinit(zone)
    identity.deinit(identities)
    return written
}
