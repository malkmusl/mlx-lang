const std = @import("std")
const entries = @import("./entries.mlx")
const item = @import("./item.mlx")
const layout = @import("./layout.mlx")
const long = @import("./long.mlx")
const options_module = @import("./options.mlx")

const Options = options_module.Options

pub fn one(name: std.string.String, status: std.fs.Stat, valid: bool, options: Options) -> bool {
    var listing = entries.init()
    if !entries.appendPath(&listing, name, status) {
        entries.deinit(&listing)
        return false
    }
    entries.at(&listing, 0).*.statusValid = valid
    const sizes = item.metrics(&listing, options)
    const written = item.write(entries.at(&listing, 0), options, sizes) && std.io.writeAll(std.io.stdout(), if options.zero { "\0" } else { "\n" })
    entries.deinit(&listing)
    return written
}

fn single(listing: *entries.List, options: Options) -> bool {
    const sizes = item.metrics(listing, options)
    var index: usize = 0
    while index < listing.*.items.length {
        if !item.write(entries.at(listing, index), options, sizes) { return false }
        if !std.io.writeAll(std.io.stdout(), if options.zero { "\0" } else { "\n" }) { return false }
        index += 1
    }
    return true
}

pub fn list(listing: *entries.List, parent: std.string.String, directory: bool, options: Options) -> bool {
    if options.long { return long.list(listing, parent, directory, options) }
    if options.format == 1 { return layout.columns(listing, options, false) }
    if options.format == 2 { return layout.columns(listing, options, true) }
    if options.format == 3 { return layout.commas(listing, options) }
    return single(listing, options)
}
