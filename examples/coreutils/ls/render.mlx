const std = @import("std")
const entries = @import("./entries.mlx")
const decorated = @import("./decorated_name.mlx")
const dired = @import("./dired.mlx")
const item = @import("./item.mlx")
const layout = @import("./layout.mlx")
const long = @import("./long.mlx")
const options_module = @import("./options.mlx")

const Options = options_module.Options

pub fn one(name: std.string.String, status: std.fs.Stat, valid: bool, options: Options) -> bool {
    var listing = entries.init()
    if !entries.appendPath(&listing, name, status, true) {
        entries.deinit(&listing)
        return false
    }
    entries.at(&listing, 0).*.statusValid = valid
    const sizes = item.metrics(&listing, std.string.fromSlice(""), options)
    var state = decorated.init()
    var diredState = dired.init()
    const written = item.write(entries.at(&listing, 0), std.string.fromSlice(""), options, sizes, &state) && std.io.writeAll(std.io.stdout(), if options.zero { "\0" } else { "\n" })
    dired.deinit(&diredState)
    entries.deinit(&listing)
    return written
}

fn single(listing: *entries.List, parent: std.string.String, options: Options) -> bool {
    const sizes = item.metrics(listing, parent, options)
    var state = decorated.init()
    var index: usize = 0
    while index < listing.*.items.length {
        if !item.write(entries.at(listing, index), parent, options, sizes, &state) { return false }
        if !std.io.writeAll(std.io.stdout(), if options.zero { "\0" } else { "\n" }) { return false }
        index += 1
    }
    return true
}

pub fn list(listing: *entries.List, parent: std.string.String, directory: bool, options: Options, diredState: *dired.State) -> bool {
    if options.long { return long.list(listing, parent, directory, options, diredState) }
    if options.format == 1 { return layout.columns(listing, parent, options, false) }
    if options.format == 2 { return layout.columns(listing, parent, options, true) }
    if options.format == 3 { return layout.commas(listing, parent, options) }
    return single(listing, parent, options)
}
