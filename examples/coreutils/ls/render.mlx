const std = @import("std")
const options_module = @import("./options.mlx")
const entries = @import("./entries.mlx")

const Options = options_module.Options

fn writeEscaped(name: std.string.String, options: Options) -> bool {
    if options.quote && !std.io.print("\"") { return false }
    var index: usize = 0
    while index < name.length {
        const byte = name.pointer[index]
        if options.escape && (byte < 32 || byte == 92 || byte == 127) {
            if !std.io.print("\\") { return false }
            if byte == 10 {
                if !std.io.print("n") { return false }
            } else if byte == 9 {
                if !std.io.print("t") { return false }
            } else if !std.io.writeUnsigned(std.io.stdout(), @intCast(usize, byte)) { return false }
        } else {
            const output = if options.hideControl && (byte < 32 || byte == 127) { 63 } else { byte }
            const value = [1]u8{output}
            if !std.io.writeAll(std.io.stdout(), value[0..1]) { return false }
        }
        index += 1
    }
    return !options.quote || std.io.print("\"")
}

fn indicator(status: std.fs.Stat, style: u8) -> u8 {
    if style == 0 { return 0 }
    const mode = @intCast(usize, status.mode)
    const kind = mode & 61440
    if kind == 16384 { return 47 }
    if style == 1 { return 0 }
    if kind == 40960 { return 64 }
    if kind == 4096 { return 124 }
    if kind == 49152 { return 61 }
    if style == 3 && kind == 32768 && mode & 73 != 0 { return 42 }
    return 0
}

fn writePrefix(status: std.fs.Stat, valid: bool, options: Options) -> bool {
    if options.inode {
        if !std.io.writeUnsigned(std.io.stdout(), if valid { status.inode } else { 0 }) || !std.io.print(" ") { return false }
    }
    if options.blocks {
        if !std.io.writeUnsigned(std.io.stdout(), if valid { @bitCast(usize, status.blocks) } else { 0 }) || !std.io.print(" ") { return false }
    }
    return true
}

pub fn one(name: std.string.String, status: std.fs.Stat, valid: bool, options: Options) -> bool {
    if !writePrefix(status, valid, options) || !writeEscaped(name, options) { return false }
    const suffix = if valid { indicator(status, options.indicator) } else { 0 }
    if suffix != 0 {
        const value = [1]u8{suffix}
        if !std.io.writeAll(std.io.stdout(), value[0..1]) { return false }
    }
    return std.io.writeAll(std.io.stdout(), if options.zero { "\0" } else { "\n" })
}

pub fn list(listing: *entries.List, options: Options) -> bool {
    var index: usize = 0
    while index < listing.*.items.length {
        const entry = entries.at(listing, index)
        const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
        if !one(name, entry.*.status, entry.*.statusValid, options) { return false }
        index += 1
    }
    return true
}
