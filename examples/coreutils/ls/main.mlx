const std = @import("std")
const common = @import("../common.mlx")
const paths = @import("../paths.mlx")
const options_module = @import("./options.mlx")
const entries = @import("./entries.mlx")
const render = @import("./render.mlx")

const Options = options_module.Options

fn isDirectory(status: std.fs.Stat) -> bool { return status.mode & 61440 == 16384 }

fn gatherOptions(options: Options) -> entries.GatherOptions {
    return entries.GatherOptions.{ .all = options.all, .almostAll = options.almostAll, .ignoreBackups = options.ignoreBackups, .dereference = options.dereference, .ignorePatterns = options.ignorePatterns, .hidePatterns = options.hidePatterns }
}

fn sortOptions(options: Options) -> entries.SortOptions {
    return entries.SortOptions.{ .mode = options.sort, .timeField = options.timeField, .reverse = options.reverse, .groupDirectories = options.groupDirectories }
}

fn writeHeader(path: std.string.String) -> bool {
    return std.io.printString(path) && std.io.print(":\n")
}

fn recurse(path: std.string.String, listing: *entries.List, options: Options, success: *bool) -> bool {
    var index: usize = 0
    while index < listing.*.items.length {
        const entry = entries.at(listing, index)
        const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
        if entry.*.statusValid && isDirectory(entry.*.status) && !(name.length == 1 && name.pointer[0] == 46) && !(name.length == 2 && name.pointer[0] == 46 && name.pointer[1] == 46) {
            const child = paths.join(path, name)
            if child == null {
                success.* = false
                return false
            }
            const child_path = std.string.fromParts(child.?.pointer, child.?.length)
            if !std.io.print("\n") || !listDirectory(child_path, options, true, success) {
                common.freePath(child.?)
                return false
            }
            common.freePath(child.?)
        }
        index += 1
    }
    return true
}

fn listDirectory(path: std.string.String, options: Options, header: bool, success: *bool) -> bool {
    const directory = std.fs.open(path.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(directory) {
        common.writePathError("ls", "cannot open directory", path)
        success.* = false
        return true
    }
    var listing = entries.read(directory, gatherOptions(options))
    const closed = std.fs.close(directory)
    entries.sort(&listing, sortOptions(options))
    if header && !writeHeader(path) {
        entries.deinit(&listing)
        return false
    }
    const written = render.list(&listing, path, true, options)
    if !listing.valid || !closed { success.* = false }
    const recursed = !options.recursive || recurse(path, &listing, options, success)
    entries.deinit(&listing)
    return written && recursed
}

fn collectOperand(path: std.string.String, options: Options, files: *entries.List, directories: *entries.List, success: *bool) -> void {
    var direct: std.fs.Stat = undefined
    if std.fs.statusAt(path.pointer, &direct, true) != 0 {
        common.writePathError("ls", "cannot access", path)
        success.* = false
        return
    }
    var target = direct
    const followed = std.fs.status(path.pointer, &target) == 0
    const is_directory = !options.directory && followed && isDirectory(target)
    const displayed = if options.dereference && followed { target } else { direct }
    const appended = if is_directory { entries.appendPath(directories, path, target, false) } else { entries.appendPath(files, path, displayed, !options.dereference) }
    if !appended { success.* = false }
}

fn printDirectories(directories: *entries.List, files_written: bool, options: Options, success: *bool) -> bool {
    var index: usize = 0
    const headers = files_written || directories.*.items.length > 1 || options.recursive
    while index < directories.*.items.length {
        if (files_written || index > 0) && !std.io.print("\n") { return false }
        const entry = entries.at(directories, index)
        const path = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
        if !listDirectory(path, options, headers, success) { return false }
        index += 1
    }
    return true
}

fn listOperands(arguments: [][*]const u8, options: Options, success: *bool) -> bool {
    var files = entries.init()
    var directories = entries.init()
    var index = options.firstFile
    const count = std.process.count(arguments)
    while index < count {
        collectOperand(std.process.argument(arguments, index), options, &files, &directories, success)
        index += 1
    }
    entries.sort(&files, sortOptions(options))
    entries.sort(&directories, sortOptions(options))
    const files_written = files.items.length > 0
    const rendered = render.list(&files, std.string.fromSlice(""), false, options)
    const listed = rendered && printDirectories(&directories, files_written, options, success)
    entries.deinit(&files)
    entries.deinit(&directories)
    return listed
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: ls [OPTION]... [FILE]...\n  -a, --all  include hidden entries\n  -A, --almost-all  exclude only . and ..\n  -d, --directory  list directories themselves\n  -F, --classify  append type indicators\n  -r, --reverse  reverse sorting\n  -R, --recursive  list subdirectories recursively\n  -S, -t, -X, -v, -U  select sorting\n  -1  list one entry per line\n      --zero  terminate entries with NUL\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = options_module.parse(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx ls 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("ls", "invalid option")
        return 2
    }
    const count = std.process.count(arguments)
    var success = true
    if options.firstFile == count {
        const current = std.string.fromSlice(".")
        return if listDirectory(current, options, options.recursive, &success) && success { 0 } else { 1 }
    }
    if !listOperands(arguments, options, &success) { return 2 }
    return if success { 0 } else { 2 }
}
