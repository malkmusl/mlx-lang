const std = @import("std")
const common = @import("../common.mlx")
const paths = @import("../paths.mlx")
const options_module = @import("./options.mlx")
const entries = @import("./entries.mlx")
const dired = @import("./dired.mlx")
const render = @import("./render.mlx")
const traversal = @import("./traversal.mlx")

const Options = options_module.Options

fn isDirectory(status: std.fs.Stat) -> bool { return status.mode & 61440 == 16384 }

fn raise(status: *u8, value: u8) -> void { if value > status.* { status.* = value } }

fn metadataRequired(options: Options) -> bool {
    return options.long || options.inode || options.blocks || options.context || options.indicator != 0 || options.color != 0 || options.hyperlink != 0 || options.sort == 2 || options.sort == 3 || options.groupDirectories || options.recursive
}

fn gatherOptions(options: Options) -> entries.GatherOptions {
    return entries.GatherOptions.{ .all = options.all, .almostAll = options.almostAll, .ignoreBackups = options.ignoreBackups, .dereference = options.dereference, .requireMetadata = metadataRequired(options), .ignorePatterns = options.ignorePatterns, .hidePatterns = options.hidePatterns }
}

fn sortOptions(options: Options) -> entries.SortOptions {
    return entries.SortOptions.{ .mode = options.sort, .timeField = options.timeField, .reverse = options.reverse, .groupDirectories = options.groupDirectories }
}

fn writeSeparator(options: Options, state: *dired.State) -> bool {
    const written = std.io.print("\n")
    if options.dired { dired.advance(state, 1) }
    return written
}

fn writeHeader(path: std.string.String, options: Options, state: *dired.State) -> bool {
    if options.dired {
        if !std.io.print("  ") { return false }
        dired.advance(state, 2)
        if !dired.beginDirectory(state) { return false }
    }
    if !std.io.printString(path) { return false }
    if options.dired {
        dired.advance(state, path.length)
        if !dired.endDirectory(state) { return false }
    }
    const written = std.io.print(":\n")
    if options.dired { dired.advance(state, 2) }
    return written
}

fn recurse(path: std.string.String, listing: *entries.List, options: Options, status: *u8, visited: *traversal.State, diredState: *dired.State) -> bool {
    var index: usize = 0
    while index < listing.*.items.length {
        const entry = entries.at(listing, index)
        const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
        if entry.*.statusValid && isDirectory(entry.*.status) && !(name.length == 1 && name.pointer[0] == 46) && !(name.length == 2 && name.pointer[0] == 46 && name.pointer[1] == 46) {
            const child = paths.join(path, name)
            if child == null {
                raise(status, 2)
                return false
            }
            const child_path = std.string.fromParts(child.?.pointer, child.?.length)
            if traversal.contains(visited, entry.*.status) {
                alreadyListed(child_path)
                raise(status, 2)
                common.freePath(child.?)
                index += 1
                continue
            }
            if !writeSeparator(options, diredState) || !listDirectory(child_path, options, true, true, status, visited, diredState) {
                common.freePath(child.?)
                return false
            }
            common.freePath(child.?)
        }
        index += 1
    }
    return true
}

fn alreadyListed(path: std.string.String) -> void {
    const first = std.io.writeAll(std.io.stderr(), "ls: ")
    const second = std.io.writeString(std.io.stderr(), path)
    const third = std.io.writeAll(std.io.stderr(), ": not listing already-listed directory\n")
}

fn writeMetadataError(path: std.string.String) -> void {
    const first = std.io.writeAll(std.io.stderr(), "ls: cannot access '")
    const second = std.io.writeString(std.io.stderr(), path)
    const third = std.io.writeAll(std.io.stderr(), "': No such file or directory\n")
}

fn reportInvalidMetadata(listing: *entries.List, parent: std.string.String) -> void {
    var index: usize = 0
    while index < listing.*.items.length {
        const entry = entries.at(listing, index)
        if !entry.*.statusValid {
            const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
            const joined = paths.join(parent, name)
            if joined != null {
                writeMetadataError(std.string.fromParts(joined.?.pointer, joined.?.length))
                common.freePath(joined.?)
            }
        }
        index += 1
    }
}

fn listDirectory(path: std.string.String, options: Options, header: bool, nested: bool, statusCode: *u8, visited: *traversal.State, diredState: *dired.State) -> bool {
    const directory = std.fs.open(path.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(directory) {
        common.writePathError("ls", "cannot open directory", path)
        raise(statusCode, if nested { 1 } else { 2 })
        return true
    }
    if options.recursive {
        var status: std.fs.Stat = undefined
        if std.fs.fileStatus(directory, &status) != 0 || !traversal.visit(visited, status) {
            const closedDuplicate = std.fs.close(directory)
            alreadyListed(path)
            raise(statusCode, 2)
            return true
        }
    }
    var listing = entries.read(directory, gatherOptions(options))
    const closed = std.fs.close(directory)
    if !listing.metadataValid { reportInvalidMetadata(&listing, path) }
    entries.sort(&listing, sortOptions(options))
    if header && !writeHeader(path, options, diredState) {
        entries.deinit(&listing)
        return false
    }
    const written = render.list(&listing, path, true, options, diredState)
    if !listing.valid || !listing.metadataValid || !closed { raise(statusCode, 1) }
    const recursed = !options.recursive || recurse(path, &listing, options, statusCode, visited, diredState)
    entries.deinit(&listing)
    return written && recursed
}

fn collectOperand(path: std.string.String, options: Options, files: *entries.List, directories: *entries.List, statusCode: *u8) -> void {
    var direct: std.fs.Stat = undefined
    if std.fs.statusAt(path.pointer, &direct, true) != 0 {
        common.writePathError("ls", "cannot access", path)
        raise(statusCode, 2)
        return
    }
    var target: std.fs.Stat = undefined
    const followed = std.fs.status(path.pointer, &target) == 0
    const direct_directory = isDirectory(direct)
    const symlink_directory = direct.mode & 61440 == 40960 && followed && isDirectory(target)
    const explicit_follow = options.dereference || options.dereferenceCommandLine || options.dereferenceCommandLineDirectories
    const default_follow = !options.long && options.indicator != 2 && options.indicator != 3
    const is_directory = !options.directory && (direct_directory || symlink_directory && (explicit_follow || default_follow))
    const follow_display = followed && (options.dereference || options.dereferenceCommandLine || options.dereferenceCommandLineDirectories && isDirectory(target))
    const displayed = if follow_display { target } else { direct }
    const appended = if is_directory { entries.appendPath(directories, path, target, false) } else { entries.appendPath(files, path, displayed, !follow_display) }
    if !appended { raise(statusCode, 2) }
}

fn printDirectories(directories: *entries.List, files_written: bool, options: Options, statusCode: *u8, visited: *traversal.State, diredState: *dired.State) -> bool {
    var index: usize = 0
    const headers = files_written || directories.*.items.length > 1 || options.recursive
    while index < directories.*.items.length {
        if (files_written || index > 0) && !writeSeparator(options, diredState) { return false }
        const entry = entries.at(directories, index)
        const path = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
        if !listDirectory(path, options, headers, false, statusCode, visited, diredState) { return false }
        index += 1
    }
    return true
}

fn listOperands(arguments: [][*]const u8, options: Options, statusCode: *u8, visited: *traversal.State, diredState: *dired.State) -> bool {
    var files = entries.init()
    var directories = entries.init()
    var index = options.firstFile
    const count = std.process.count(arguments)
    while index < count {
        collectOperand(std.process.argument(arguments, index), options, &files, &directories, statusCode)
        index += 1
    }
    entries.sort(&files, sortOptions(options))
    entries.sort(&directories, sortOptions(options))
    const files_written = files.items.length > 0
    const rendered = render.list(&files, std.string.fromSlice(""), false, options, diredState)
    const listed = rendered && printDirectories(&directories, files_written, options, statusCode, visited, diredState)
    entries.deinit(&files)
    entries.deinit(&directories)
    return listed
}

fn helpPartOne() -> bool {
    return std.io.print("Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if none of -cftuvSUX nor --sort is specified.\n\n") &&
        std.io.print("  -a, --all                  do not ignore entries starting with .\n  -A, --almost-all           do not list implied . and ..\n      --author               with -l, print the author of each file\n  -b, --escape               print C-style escapes for nongraphic characters\n      --block-size=SIZE      scale sizes by SIZE when printing them\n  -B, --ignore-backups       do not list implied entries ending with ~\n  -c                         use ctime for display or sorting\n  -C                         list entries by columns\n      --color[=WHEN]         color the output WHEN\n  -d, --directory            list directories themselves\n  -D, --dired                generate output for Emacs dired mode\n")
}

fn helpPartTwo() -> bool {
    return std.io.print("  -f                         same as -a -U\n  -F, --classify[=WHEN]      append type indicators WHEN\n      --file-type            append type indicators except '*'\n      --format=WORD          across, commas, long, single-column, vertical\n      --full-time            like -l --time-style=full-iso\n  -g                         like -l, but do not list owner\n      --group-directories-first\n  -G, --no-group             do not print group names\n  -h, --human-readable       print human-readable sizes\n      --si                   use powers of 1000\n  -H, --dereference-command-line\n  -L, --dereference          show information for symlink targets\n      --hide=PATTERN         hide implied entries matching PATTERN\n      --hyperlink[=WHEN]     hyperlink file names WHEN\n      --indicator-style=WORD\n  -i, --inode                print inode numbers\n  -I, --ignore=PATTERN       ignore implied entries matching PATTERN\n  -k, --kibibytes            use 1024-byte blocks\n")
}

fn helpPartThree() -> bool {
    return std.io.print("  -l                         use a long listing format\n  -m                         comma-separated output\n  -n, --numeric-uid-gid      list numeric user and group IDs\n  -N, --literal              print names without quoting\n  -o                         like -l, but omit group information\n  -p                         append / to directories\n  -q, --hide-control-chars   print ? for nongraphic characters\n  -Q, --quote-name           enclose names in double quotes\n      --quoting-style=WORD   select name quoting style\n  -r, --reverse              reverse sorting\n  -R, --recursive            list subdirectories recursively\n  -s, --size                 print allocated sizes\n  -S                         sort by file size\n      --sort=WORD            none, size, time, version, extension, name, width\n      --time=WORD            select displayed or sorted timestamp\n      --time-style=STYLE     select long-listing timestamp format\n  -t                         sort by time\n  -T, --tabsize=COLS         set tab stops\n  -u                         use access time for display or sorting\n  -U                         do not sort\n  -v                         natural version sort\n  -w, --width=COLS           set output width\n  -x                         list entries by lines\n  -X                         sort by extension\n  -Z, --context              print security contexts\n      --zero                 terminate entries with NUL\n  -1                         list one entry per line\n      --help                 display this help and exit\n      --version              output version information and exit\n")
}

fn printHelp() -> u8 {
    return if helpPartOne() && helpPartTwo() && helpPartThree() { 0 } else { 1 }
}

fn run(arguments: [][*]const u8, options: Options) -> u8 {
    if options.invalid {
        common.writeMessage("ls", "invalid option")
        return 2
    }
    var visited = traversal.init()
    var diredState = dired.init()
    const count = std.process.count(arguments)
    var result: u8 = 0
    if options.firstFile == count {
        const current = std.string.fromSlice(".")
        if !listDirectory(current, options, options.recursive, false, &result, &visited, &diredState) { raise(&result, 2) }
    } else if !listOperands(arguments, options, &result, &visited, &diredState) { raise(&result, 2) }
    if options.dired && !dired.finish(&diredState, options.quoting) { raise(&result, 2) }
    traversal.deinit(&visited)
    dired.deinit(&diredState)
    return result
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var options = options_module.parse(arguments)
    var result: u8 = 0
    if options.action == 1 { result = printHelp() } else if options.action == 2 {
        result = if std.io.print("mlx ls 0.1.0\n") { 0 } else { 1 }
    } else { result = run(arguments, options) }
    options_module.deinit(&options)
    return result
}
