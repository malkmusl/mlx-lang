const std = @import("std")
const common = @import("../common.mlx")
const terminal = @import("./terminal.mlx")

const String = std.string.String
const Vector = std.vector.Vector

pub const Options = struct {
    all: bool
    almostAll: bool
    ignoreBackups: bool
    directory: bool
    recursive: bool
    reverse: bool
    dereference: bool
    dereferenceCommandLine: bool
    dereferenceCommandLineDirectories: bool
    groupDirectories: bool
    indicator: u8
    sort: u8
    sortExplicit: bool
    timeField: u8
    format: u8
    width: usize
    tabSize: usize
    zero: bool
    quoting: u8
    quotingSet: bool
    inode: bool
    blocks: bool
    long: bool
    numeric: bool
    showOwner: bool
    showGroup: bool
    author: bool
    context: bool
    dired: bool
    human: u8
    blockSize: usize
    scaleSize: bool
    blockSuffix: u8
    blockUnit: u8
    timeStyle: String
    timezone: String
    color: u8
    hyperlink: u8
    terminalOutput: bool
    colors: String
    colorsSet: bool
    ignorePatterns: *Vector
    hidePatterns: *Vector
    firstFile: usize
    action: u8
    invalid: bool
}

fn emptyString() -> String { return std.string.fromSlice("") }

fn newPatterns() -> *Vector {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    unsafe {
        const result = @ptrCast(*Vector, allocator.alloc(@sizeOf(Vector), @alignOf(Vector)).?)
        Vector.initAt(result, allocator, @sizeOf(String), @alignOf(String), 4)
        return result
    }
}

fn empty() -> Options {
    return Options.{
        .all = false, .almostAll = false, .ignoreBackups = false, .directory = false,
        .recursive = false, .reverse = false, .dereference = false, .dereferenceCommandLine = false,
        .dereferenceCommandLineDirectories = false,
        .groupDirectories = false, .indicator = 0, .sort = 0, .sortExplicit = false, .timeField = 0,
        .format = 0, .width = 80, .tabSize = 8, .zero = false, .quoting = 5, .quotingSet = false,
        .inode = false, .blocks = false, .long = false, .numeric = false,
        .showOwner = true, .showGroup = true, .author = false, .context = false,
        .dired = false, .human = 0, .blockSize = 1024, .scaleSize = false, .blockSuffix = 0, .blockUnit = 0,
        .timeStyle = emptyString(), .timezone = emptyString(),
        .color = 0, .hyperlink = 0, .terminalOutput = false, .colors = emptyString(), .colorsSet = false,
        .ignorePatterns = newPatterns(), .hidePatterns = newPatterns(),
        .firstFile = 1, .action = 0, .invalid = false,
    }
}

pub fn patternAt(patterns: *Vector, index: usize) -> String {
    unsafe { return @ptrCast(*String, Vector.at(patterns.*, index)).* }
}

fn addPattern(patterns: *Vector, value: String) -> bool {
    unsafe { return Vector.appendAt(patterns, @ptrCast([*]const u8, &value)) }
}

const NumberResult = struct {
    value: usize
    valid: bool
}

fn invalidNumber() -> NumberResult { return NumberResult.{ .value = 0, .valid = false } }

fn parseNumber(value: std.string.String) -> NumberResult {
    if value.length == 0 { return invalidNumber() }
    var result: usize = 0
    var index: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        if byte < 48 || byte > 57 { return invalidNumber() }
        const digit = @intCast(usize, byte - 48)
        if result > (18446744073709551615 - digit) / 10 { return invalidNumber() }
        result = result * 10 + digit
        index += 1
    }
    return NumberResult.{ .value = result, .valid = true }
}

const SizeSpec = struct {
    value: usize
    suffix: u8
    unit: u8
}

fn unitIndex(byte: u8) -> u8 {
    if byte == 75 || byte == 107 { return 1 }
    if byte == 77 { return 2 }
    if byte == 71 { return 3 }
    if byte == 84 { return 4 }
    if byte == 80 { return 5 }
    if byte == 69 { return 6 }
    return 0
}

fn unitMultiplier(unit: u8, base: usize) -> ?usize {
    var result: usize = 1
    var index: u8 = 0
    while index < unit {
        if result > 18446744073709551615 / base { return null }
        result *= base
        index += 1
    }
    return result
}

fn parseSize(value: std.string.String) -> ?SizeSpec {
    if value.length == 0 { return null }
    var numberEnd: usize = 0
    while numberEnd < value.length && value.pointer[numberEnd] >= 48 && value.pointer[numberEnd] <= 57 { numberEnd += 1 }
    const explicit = numberEnd > 0
    const amount = if explicit { parseNumber(std.string.slice(value, 0, numberEnd)) } else { NumberResult.{ .value = 1, .valid = true } }
    if !amount.valid || amount.value == 0 || numberEnd == value.length && !explicit { return null }
    if numberEnd == value.length { return SizeSpec.{ .value = amount.value, .suffix = 0, .unit = 0 } }
    const suffixLength = value.length - numberEnd
    const unit = unitIndex(value.pointer[numberEnd])
    if unit == 0 { return null }
    var mode: u8 = 1
    var base: usize = 1024
    if suffixLength == 2 && value.pointer[numberEnd + 1] == 66 {
        mode = 2
        base = 1000
    } else if suffixLength == 3 && value.pointer[numberEnd + 1] == 105 && value.pointer[numberEnd + 2] == 66 {
        mode = 3
    } else if suffixLength != 1 { return null }
    const multiplier = unitMultiplier(unit, base)
    if multiplier == null || amount.value > 18446744073709551615 / multiplier.? { return null }
    return SizeSpec.{ .value = amount.value * multiplier.?, .suffix = if explicit { 0 } else { mode }, .unit = unit }
}

fn setSort(options: *Options, value: std.string.String) -> bool {
    if common.equals(value, "name") { options.*.sort = 0 } else if common.equals(value, "width") {
        options.*.sort = 6
    } else if common.equals(value, "none") {
        options.*.sort = 1
    } else if common.equals(value, "size") { options.*.sort = 2 } else if common.equals(value, "time") {
        options.*.sort = 3
    } else if common.equals(value, "extension") { options.*.sort = 4 } else if common.equals(value, "version") {
        options.*.sort = 5
    } else { return false }
    options.*.sortExplicit = true
    return true
}

fn setIndicator(options: *Options, value: std.string.String) -> bool {
    if common.equals(value, "none") { options.*.indicator = 0 } else if common.equals(value, "slash") {
        options.*.indicator = 1
    } else if common.equals(value, "file-type") { options.*.indicator = 2 } else if common.equals(value, "classify") {
        options.*.indicator = 3
    } else { return false }
    return true
}

fn setFormat(options: *Options, value: std.string.String) -> bool {
    options.*.long = false
    if common.equals(value, "single-column") { options.*.format = 0 } else if common.equals(value, "vertical") {
        options.*.format = 1
    } else if common.equals(value, "across") || common.equals(value, "horizontal") { options.*.format = 2 } else if common.equals(value, "commas") {
        options.*.format = 3
    } else if common.equals(value, "long") || common.equals(value, "verbose") {
        options.*.format = 4
        options.*.long = true
    } else { return false }
    return true
}

fn setQuoting(options: *Options, value: std.string.String) -> bool {
    if common.equals(value, "literal") { options.*.quoting = 0 } else if common.equals(value, "escape") {
        options.*.quoting = 1
    } else if common.equals(value, "c") { options.*.quoting = 2 } else if common.equals(value, "shell") {
        options.*.quoting = 3
    } else if common.equals(value, "shell-always") { options.*.quoting = 4 } else if common.equals(value, "shell-escape") {
        options.*.quoting = 5
    } else if common.equals(value, "shell-escape-always") { options.*.quoting = 6 } else if common.equals(value, "locale") {
        options.*.quoting = 7
    } else { return false }
    options.*.quotingSet = true
    return true
}

const WhenResult = struct {
    value: u8
    valid: bool
}

fn whenValue(value: std.string.String) -> WhenResult {
    if common.equals(value, "never") || common.equals(value, "none") { return WhenResult.{ .value = 0, .valid = true } }
    if common.equals(value, "always") || common.equals(value, "yes") || common.equals(value, "force") { return WhenResult.{ .value = 1, .valid = true } }
    if common.equals(value, "auto") || common.equals(value, "tty") || common.equals(value, "if-tty") { return WhenResult.{ .value = 2, .valid = true } }
    return WhenResult.{ .value = 0, .valid = false }
}

fn setTime(options: *Options, value: std.string.String) -> bool {
    if common.equals(value, "mtime") || common.equals(value, "modification") { options.*.timeField = 0 } else if common.equals(value, "atime") || common.equals(value, "access") || common.equals(value, "use") {
        options.*.timeField = 1
    } else if common.equals(value, "ctime") || common.equals(value, "status") { options.*.timeField = 2 } else if common.equals(value, "birth") || common.equals(value, "creation") {
        options.*.timeField = 3
    } else { return false }
    return true
}

fn longValue(argument: std.string.String, prefix: []const u8) -> ?std.string.String {
    const wanted = std.string.fromSlice(prefix)
    if !std.string.startsWith(argument, wanted) { return null }
    return std.string.slice(argument, wanted.length, argument.length)
}

fn setLongOutputValue(argument: std.string.String, options: *Options) -> bool {
    var value = longValue(argument, "--width=")
    if value != null {
        const parsed = parseNumber(value.?)
        if !parsed.valid { return false }
        options.*.width = parsed.value
        return true
    }
    value = longValue(argument, "--tabsize=")
    if value != null {
        const parsed = parseNumber(value.?)
        if !parsed.valid { return false }
        options.*.tabSize = parsed.value
        return true
    }
    value = longValue(argument, "--block-size=")
    if value != null {
        const parsed = parseSize(value.?)
        if parsed == null { return false }
        options.*.blockSize = parsed.?.value
        options.*.scaleSize = true
        options.*.blockSuffix = parsed.?.suffix
        options.*.blockUnit = parsed.?.unit
        return true
    }
    value = longValue(argument, "--ignore=")
    if value != null { return addPattern(options.*.ignorePatterns, value.?) }
    value = longValue(argument, "--hide=")
    if value != null { return addPattern(options.*.hidePatterns, value.?) }
    value = longValue(argument, "--color=")
    if value != null {
        const parsed = whenValue(value.?)
        if !parsed.valid { return false }
        options.*.color = parsed.value
        return true
    }
    value = longValue(argument, "--hyperlink=")
    if value != null {
        const parsed = whenValue(value.?)
        if !parsed.valid { return false }
        options.*.hyperlink = parsed.value
        return true
    }
    value = longValue(argument, "--classify=")
    if value != null {
        const parsed = whenValue(value.?)
        if !parsed.valid { return false }
        options.*.indicator = if parsed.value == 0 || parsed.value == 2 && !options.*.terminalOutput { 0 } else { 3 }
        return true
    }
    return false
}

fn setLongValue(argument: std.string.String, options: *Options) -> bool {
    var value = longValue(argument, "--sort=")
    if value != null { return setSort(options, value.?) }
    value = longValue(argument, "--indicator-style=")
    if value != null { return setIndicator(options, value.?) }
    value = longValue(argument, "--format=")
    if value != null { return setFormat(options, value.?) }
    value = longValue(argument, "--quoting-style=")
    if value != null { return setQuoting(options, value.?) }
    value = longValue(argument, "--time=")
    if value != null { return setTime(options, value.?) }
    value = longValue(argument, "--time-style=")
    if value != null {
        options.*.timeStyle = value.?
        return true
    }
    return setLongOutputValue(argument, options)
}

fn parseLongFlag(argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--all") { options.*.all = true } else if common.equals(argument, "--almost-all") { options.*.almostAll = true } else if common.equals(argument, "--ignore-backups") {
        options.*.ignoreBackups = true
    } else if common.equals(argument, "--directory") { options.*.directory = true } else if common.equals(argument, "--recursive") {
        options.*.recursive = true
    } else if common.equals(argument, "--reverse") { options.*.reverse = true } else if common.equals(argument, "--dereference") {
        options.*.dereference = true
    } else if common.equals(argument, "--dereference-command-line") { options.*.dereferenceCommandLine = true } else if common.equals(argument, "--dereference-command-line-symlink-to-dir") {
        options.*.dereferenceCommandLineDirectories = true
    } else if common.equals(argument, "--group-directories-first") {
        options.*.groupDirectories = true
    } else if common.equals(argument, "--file-type") { options.*.indicator = 2 } else if common.equals(argument, "--classify") { options.*.indicator = 3 } else if common.equals(argument, "--zero") {
        options.*.zero = true
        options.*.format = 0
        options.*.long = false
        options.*.quoting = 0
        options.*.quotingSet = true
        options.*.color = 0
    } else if common.equals(argument, "--inode") { options.*.inode = true } else if common.equals(argument, "--size") { options.*.blocks = true } else if common.equals(argument, "--numeric-uid-gid") {
        options.*.numeric = true
        options.*.long = true
        options.*.format = 4
    } else if common.equals(argument, "--full-time") {
        options.*.long = true
        options.*.format = 4
        options.*.timeStyle = std.string.fromSlice("full-iso")
    } else if common.equals(argument, "--author") {
        options.*.author = true
    } else if common.equals(argument, "--dired") { options.*.dired = true } else if common.equals(argument, "--human-readable") {
        options.*.human = 1
    } else if common.equals(argument, "--si") { options.*.human = 2 } else if common.equals(argument, "--kibibytes") {
        options.*.blockSize = 1024
    } else if common.equals(argument, "--context") {
        options.*.context = true
    } else if common.equals(argument, "--show-control-chars") || common.equals(argument, "--literal") {
        options.*.quoting = 0
        options.*.quotingSet = true
    } else if common.equals(argument, "--escape") {
        options.*.quoting = 1
        options.*.quotingSet = true
    } else if common.equals(argument, "--hide-control-chars") {
        options.*.quoting = 8
        options.*.quotingSet = true
    } else if common.equals(argument, "--quote-name") {
        options.*.quoting = 2
        options.*.quotingSet = true
    } else if common.equals(argument, "--color") {
        options.*.color = 1
    } else if common.equals(argument, "--hyperlink") { options.*.hyperlink = 1 } else if common.equals(argument, "--no-group") { options.*.showGroup = false } else if common.equals(argument, "--help") {
        options.*.action = 1
    } else if common.equals(argument, "--version") { options.*.action = 2 } else { return setLongValue(argument, options) }
    return true
}

fn argumentValue(arguments: [][*]const u8, index: *usize) -> ?std.string.String {
    index.* += 1
    if index.* >= std.process.count(arguments) { return null }
    return std.process.argument(arguments, index.*)
}

fn attachedOrNext(argument: std.string.String, offset: usize, arguments: [][*]const u8, index: *usize) -> ?std.string.String {
    if offset < argument.length { return std.string.slice(argument, offset, argument.length) }
    return argumentValue(arguments, index)
}

fn parseShortValue(byte: u8, value: std.string.String, options: *Options) -> bool {
    if byte == 73 { return addPattern(options.*.ignorePatterns, value) }
    const parsed = parseNumber(value)
    if !parsed.valid { return false }
    if byte == 84 { options.*.tabSize = parsed.value } else { options.*.width = parsed.value }
    return true
}

fn parseShortSort(byte: u8, options: *Options) -> bool {
    if byte == 83 { options.*.sort = 2 } else if byte == 116 { options.*.sort = 3 } else if byte == 85 {
        options.*.sort = 1
    } else if byte == 88 { options.*.sort = 4 } else if byte == 118 { options.*.sort = 5 } else if byte == 99 {
        options.*.timeField = 2
        if !options.*.long { options.*.sort = 3 }
        return true
    } else if byte == 117 {
        options.*.timeField = 1
        if !options.*.long { options.*.sort = 3 }
        return true
    } else { return false }
    options.*.sortExplicit = true
    return true
}

fn parseShortQuote(byte: u8, options: *Options) -> bool {
    if byte == 81 { options.*.quoting = 2 } else if byte == 98 { options.*.quoting = 1 } else if byte == 113 {
        options.*.quoting = 8
    } else if byte == 78 { options.*.quoting = 0 } else { return false }
    options.*.quotingSet = true
    return true
}

fn parseShortFormat(byte: u8, options: *Options) -> bool {
    if byte == 108 || byte == 103 || byte == 111 || byte == 110 {
        options.*.long = true
        options.*.format = 4
        if byte == 103 { options.*.showOwner = false }
        if byte == 111 { options.*.showGroup = false }
        if byte == 110 { options.*.numeric = true }
    } else if byte == 49 {
        options.*.format = 0
        options.*.long = false
    } else if byte == 67 {
        options.*.format = 1
        options.*.long = false
    } else if byte == 120 {
        options.*.format = 2
        options.*.long = false
    } else if byte == 109 {
        options.*.format = 3
        options.*.long = false
    } else { return false }
    return true
}

fn parseShortFlag(byte: u8, options: *Options) -> bool {
    if parseShortSort(byte, options) || parseShortQuote(byte, options) || parseShortFormat(byte, options) { return true }
    if byte == 97 { options.*.all = true } else if byte == 65 { options.*.almostAll = true } else if byte == 66 { options.*.ignoreBackups = true } else if byte == 100 { options.*.directory = true } else if byte == 82 {
        options.*.recursive = true
    } else if byte == 114 { options.*.reverse = true } else if byte == 76 { options.*.dereference = true } else if byte == 72 { options.*.dereferenceCommandLine = true } else if byte == 102 {
        options.*.all = true
        options.*.sort = 1
        options.*.sortExplicit = true
    } else if byte == 70 { options.*.indicator = 3 } else if byte == 112 { options.*.indicator = 1 } else if byte == 105 { options.*.inode = true } else if byte == 115 { options.*.blocks = true } else if byte == 71 {
        options.*.showGroup = false
    } else if byte == 104 { options.*.human = 1 } else if byte == 107 { options.*.blockSize = 1024 } else if byte == 68 {
        options.*.dired = true
    } else if byte == 90 { options.*.context = true } else { return false }
    return true
}

fn parseShort(argument: std.string.String, arguments: [][*]const u8, argumentIndex: *usize, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        const byte = argument.pointer[index]
        if byte == 73 || byte == 84 || byte == 119 {
            const value = attachedOrNext(argument, index + 1, arguments, argumentIndex)
            if value == null { return false }
            return parseShortValue(byte, value.?, options)
        }
        if !parseShortFlag(byte, options) { return false }
        index += 1
    }
    return true
}

fn longNeedsValue(argument: std.string.String) -> bool {
    return common.equals(argument, "--sort") || common.equals(argument, "--indicator-style") || common.equals(argument, "--format") || common.equals(argument, "--quoting-style") || common.equals(argument, "--time") || common.equals(argument, "--time-style") || common.equals(argument, "--width") || common.equals(argument, "--tabsize") || common.equals(argument, "--block-size") || common.equals(argument, "--ignore") || common.equals(argument, "--hide")
}

fn parseSeparatedLong(argument: std.string.String, value: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--sort") { return setSort(options, value) }
    if common.equals(argument, "--indicator-style") { return setIndicator(options, value) }
    if common.equals(argument, "--format") { return setFormat(options, value) }
    if common.equals(argument, "--quoting-style") { return setQuoting(options, value) }
    if common.equals(argument, "--time") { return setTime(options, value) }
    if common.equals(argument, "--time-style") {
        options.*.timeStyle = value
        return true
    }
    if common.equals(argument, "--ignore") { return addPattern(options.*.ignorePatterns, value) }
    if common.equals(argument, "--hide") { return addPattern(options.*.hidePatterns, value) }
    if common.equals(argument, "--block-size") {
        const parsed = parseSize(value)
        if parsed == null { return false }
        options.*.blockSize = parsed.?.value
        options.*.scaleSize = true
        options.*.blockSuffix = parsed.?.suffix
        options.*.blockUnit = parsed.?.unit
        return true
    }
    const parsed = parseNumber(value)
    if !parsed.valid { return false }
    if common.equals(argument, "--width") { options.*.width = parsed.value } else { options.*.tabSize = parsed.value }
    return true
}

pub fn parse(arguments: [][*]const u8) -> Options {
    var result = empty()
    result.terminalOutput = terminal.isTerminal(std.io.stdout())
    result.format = if result.terminalOutput { 1 } else { 0 }
    result.quoting = if result.terminalOutput { 5 } else { 0 }
    result.width = if result.terminalOutput { terminal.width(std.io.stdout()) } else { 80 }
    const timeStyle = std.process.environment(arguments, "TIME_STYLE")
    if timeStyle != null { result.timeStyle = timeStyle.? }
    const timezone = std.process.environment(arguments, "TZ")
    if timezone != null { result.timezone = timezone.? }
    const columns = std.process.environment(arguments, "COLUMNS")
    if columns != null {
        const parsed = parseNumber(columns.?)
        if parsed.valid && parsed.value > 0 { result.width = parsed.value }
    }
    const tabSize = std.process.environment(arguments, "TABSIZE")
    if tabSize != null {
        const parsed = parseNumber(tabSize.?)
        if parsed.valid { result.tabSize = parsed.value }
    }
    const quoting = std.process.environment(arguments, "QUOTING_STYLE")
    if quoting != null && !setQuoting(&result, quoting.?) { result.invalid = true }
    const colors = std.process.environment(arguments, "LS_COLORS")
    if colors != null {
        result.colors = colors.?
        result.colorsSet = true
    }
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        var valid = false
        if argument.pointer[1] != 45 { valid = parseShort(argument, arguments, &index, &result) } else if longNeedsValue(argument) {
            const value = argumentValue(arguments, &index)
            valid = value != null && parseSeparatedLong(argument, value.?, &result)
        } else { valid = parseLongFlag(argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    if result.long && (result.timeField == 1 || result.timeField == 2) && !result.sortExplicit { result.sort = 0 }
    if result.dired {
        result.long = true
        result.format = 4
        result.indicator = 0
        result.color = 0
        result.hyperlink = 0
        if !result.quotingSet { result.quoting = 0 }
    }
    return result
}

pub fn deinit(options: *Options) -> void {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    Vector.deinit(options.*.ignorePatterns.*)
    Vector.deinit(options.*.hidePatterns.*)
    unsafe {
        allocator.free(@ptrCast([*]u8, options.*.ignorePatterns), @sizeOf(Vector), @alignOf(Vector))
        allocator.free(@ptrCast([*]u8, options.*.hidePatterns), @sizeOf(Vector), @alignOf(Vector))
    }
}
