const std = @import("std")
const common = @import("../common.mlx")

pub const Options = struct {
    all: bool
    almostAll: bool
    ignoreBackups: bool
    directory: bool
    recursive: bool
    reverse: bool
    dereference: bool
    groupDirectories: bool
    indicator: u8
    sort: u8
    zero: bool
    quote: bool
    escape: bool
    hideControl: bool
    inode: bool
    blocks: bool
    long: bool
    numeric: bool
    fullTime: bool
    firstFile: usize
    action: u8
    invalid: bool
}

fn empty() -> Options {
    return Options.{ .all = false, .almostAll = false, .ignoreBackups = false, .directory = false, .recursive = false, .reverse = false, .dereference = false, .groupDirectories = false, .indicator = 0, .sort = 0, .zero = false, .quote = false, .escape = false, .hideControl = false, .inode = false, .blocks = false, .long = false, .numeric = false, .fullTime = false, .firstFile = 1, .action = 0, .invalid = false }
}

fn setSort(options: *Options, value: std.string.String) -> bool {
    if common.equals(value, "name") { options.*.sort = 0 } else if common.equals(value, "none") { options.*.sort = 1 } else if common.equals(value, "size") {
        options.*.sort = 2
    } else if common.equals(value, "time") { options.*.sort = 3 } else if common.equals(value, "extension") {
        options.*.sort = 4
    } else if common.equals(value, "version") { options.*.sort = 5 } else if common.equals(value, "width") {
        options.*.sort = 0
    } else { return false }
    return true
}

fn setIndicator(options: *Options, value: std.string.String) -> bool {
    if common.equals(value, "none") { options.*.indicator = 0 } else if common.equals(value, "slash") { options.*.indicator = 1 } else if common.equals(value, "file-type") {
        options.*.indicator = 2
    } else if common.equals(value, "classify") { options.*.indicator = 3 } else { return false }
    return true
}

fn ignoredValueOption(argument: std.string.String) -> bool {
    return std.string.startsWith(argument, std.string.fromSlice("--color=")) || std.string.startsWith(argument, std.string.fromSlice("--hyperlink=")) || std.string.startsWith(argument, std.string.fromSlice("--time=")) || std.string.startsWith(argument, std.string.fromSlice("--time-style=")) || std.string.startsWith(argument, std.string.fromSlice("--block-size=")) || std.string.startsWith(argument, std.string.fromSlice("--quoting-style=")) || std.string.startsWith(argument, std.string.fromSlice("--hide=")) || std.string.startsWith(argument, std.string.fromSlice("--ignore="))
}

fn parseLong(argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--all") { options.*.all = true } else if common.equals(argument, "--almost-all") { options.*.almostAll = true } else if common.equals(argument, "--ignore-backups") {
        options.*.ignoreBackups = true
    } else if common.equals(argument, "--directory") { options.*.directory = true } else if common.equals(argument, "--recursive") {
        options.*.recursive = true
    } else if common.equals(argument, "--reverse") { options.*.reverse = true } else if common.equals(argument, "--dereference") {
        options.*.dereference = true
    } else if common.equals(argument, "--group-directories-first") { options.*.groupDirectories = true } else if common.equals(argument, "--file-type") {
        options.*.indicator = 2
    } else if common.equals(argument, "--classify") { options.*.indicator = 3 } else if common.equals(argument, "--zero") {
        options.*.zero = true
    } else if common.equals(argument, "--inode") { options.*.inode = true } else if common.equals(argument, "--size") {
        options.*.blocks = true
    } else if common.equals(argument, "--numeric-uid-gid") {
        options.*.numeric = true
        options.*.long = true
    } else if common.equals(argument, "--help") {
        options.*.action = 1
    } else if common.equals(argument, "--version") { options.*.action = 2 } else if common.equals(argument, "--full-time") {
        options.*.long = true
        options.*.fullTime = true
    } else if std.string.startsWith(argument, std.string.fromSlice("--sort=")) {
        return setSort(options, std.string.slice(argument, 7, argument.length))
    } else if std.string.startsWith(argument, std.string.fromSlice("--indicator-style=")) {
        return setIndicator(options, std.string.slice(argument, 18, argument.length))
    } else if ignoredValueOption(argument) || common.equals(argument, "--show-control-chars") || common.equals(argument, "--author") || common.equals(argument, "--dired") || common.equals(argument, "--si") || common.equals(argument, "--dereference-command-line") || common.equals(argument, "--dereference-command-line-symlink-to-dir") {
        return true
    } else { return false }
    return true
}

fn parseShortByte(byte: u8, options: *Options) -> bool {
    if byte == 97 { options.*.all = true } else if byte == 65 { options.*.almostAll = true } else if byte == 66 { options.*.ignoreBackups = true } else if byte == 100 {
        options.*.directory = true
    } else if byte == 82 { options.*.recursive = true } else if byte == 114 { options.*.reverse = true } else if byte == 76 { options.*.dereference = true } else if byte == 102 {
        options.*.all = true
        options.*.sort = 1
    } else if byte == 70 { options.*.indicator = 3 } else if byte == 112 { options.*.indicator = 1 } else if byte == 105 { options.*.inode = true } else if byte == 115 {
        options.*.blocks = true
    } else if byte == 83 { options.*.sort = 2 } else if byte == 116 || byte == 99 || byte == 117 { options.*.sort = 3 } else if byte == 85 { options.*.sort = 1 } else if byte == 88 {
        options.*.sort = 4
    } else if byte == 118 { options.*.sort = 5 } else if byte == 81 { options.*.quote = true } else if byte == 98 { options.*.escape = true } else if byte == 113 {
        options.*.hideControl = true
    } else if byte == 108 || byte == 103 || byte == 111 { options.*.long = true } else if byte == 110 {
        options.*.numeric = true
        options.*.long = true
    } else if byte == 49 || byte == 67 || byte == 120 || byte == 109 || byte == 78 || byte == 104 || byte == 107 || byte == 72 || byte == 71 || byte == 90 {
        return true
    } else { return false }
    return true
}

fn parseShort(argument: std.string.String, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        if !parseShortByte(argument.pointer[index], options) { return false }
        index += 1
    }
    return true
}

pub fn parse(arguments: [][*]const u8) -> Options {
    var result = empty()
    var index: usize = 1
    const count = std.process.count(arguments)
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(argument, &result) } else { parseShort(argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstFile = index
    return result
}
