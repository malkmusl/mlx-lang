const std = @import("std")
const common = @import("../common.mlx")
const entries = @import("./entries.mlx")
const options_module = @import("./options.mlx")
const timezone = @import("./timezone.mlx")

const Options = options_module.Options

const Timestamp = struct {
    seconds: isize
    nanoseconds: isize
    known: bool
}

const Calendar = struct {
    year: isize
    month: usize
    day: usize
    hour: usize
    minute: usize
    second: usize
    weekday: usize
    yearDay: usize
}

fn leap(year: isize) -> bool { return year % 4 == 0 && year % 100 != 0 || year % 400 == 0 }

fn monthDays(year: isize, month: usize) -> usize {
    if month == 2 { return if leap(year) { 29 } else { 28 } }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

fn floorDays(seconds: isize) -> isize {
    if seconds >= 0 { return seconds / 86400 }
    return -((-seconds + 86399) / 86400)
}

fn calendar(seconds: isize) -> Calendar {
    const days = floorDays(seconds)
    const clock = @intCast(usize, seconds - days * 86400)
    const shifted = days + 719468
    const era = if shifted >= 0 { shifted / 146097 } else { (shifted - 146096) / 146097 }
    const dayOfEra = shifted - era * 146097
    const yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    var year = yearOfEra + era * 400
    const dayOfYearMarch = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    const monthPart = (5 * dayOfYearMarch + 2) / 153
    const day = dayOfYearMarch - (153 * monthPart + 2) / 5 + 1
    const month = if monthPart < 10 { monthPart + 3 } else { monthPart - 9 }
    if month <= 2 { year += 1 }
    var yearDay: usize = @intCast(usize, day)
    var scan: usize = 1
    while scan < @intCast(usize, month) {
        yearDay += monthDays(year, scan)
        scan += 1
    }
    var weekday = (days + 4) % 7
    if weekday < 0 { weekday += 7 }
    return Calendar.{ .year = year, .month = @intCast(usize, month), .day = @intCast(usize, day), .hour = clock / 3600, .minute = clock / 60 % 60, .second = clock % 60, .weekday = @intCast(usize, weekday), .yearDay = yearDay }
}

fn timestamp(entry: *entries.Entry, field: u8) -> Timestamp {
    if field == 1 { return Timestamp.{ .seconds = entry.*.status.accessedSeconds, .nanoseconds = entry.*.status.accessedNanoseconds, .known = true } }
    if field == 2 { return Timestamp.{ .seconds = entry.*.status.changedSeconds, .nanoseconds = entry.*.status.changedNanoseconds, .known = true } }
    if field == 3 { return Timestamp.{ .seconds = entry.*.birthSeconds, .nanoseconds = entry.*.birthNanoseconds, .known = entry.*.birthKnown } }
    return Timestamp.{ .seconds = entry.*.status.modifiedSeconds, .nanoseconds = entry.*.status.modifiedNanoseconds, .known = true }
}

fn digits(value: usize) -> usize {
    var result: usize = 1
    var remaining = value
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn padding(amount: usize, byte: u8) -> bool {
    const value = [1]u8{byte}
    var remaining = amount
    while remaining > 0 {
        if !std.io.writeAll(std.io.stdout(), value[0..1]) { return false }
        remaining -= 1
    }
    return true
}

fn number(value: usize, width: usize, pad: u8) -> bool {
    const length = digits(value)
    return padding(if width > length { width - length } else { 0 }, pad) && std.io.writeUnsigned(std.io.stdout(), value)
}

fn signedYear(value: isize, width: usize) -> bool {
    if value >= 0 { return number(@bitCast(usize, value), width, 48) }
    return std.io.print("-") && number(@bitCast(usize, -(value + 1)) + 1, width, 48)
}

fn monthName(month: usize, full: bool) -> []const u8 {
    if month == 1 { return if full { "January" } else { "Jan" } }
    if month == 2 { return if full { "February" } else { "Feb" } }
    if month == 3 { return if full { "March" } else { "Mar" } }
    if month == 4 { return if full { "April" } else { "Apr" } }
    if month == 5 { return "May" }
    if month == 6 { return if full { "June" } else { "Jun" } }
    if month == 7 { return if full { "July" } else { "Jul" } }
    if month == 8 { return if full { "August" } else { "Aug" } }
    if month == 9 { return if full { "September" } else { "Sep" } }
    if month == 10 { return if full { "October" } else { "Oct" } }
    if month == 11 { return if full { "November" } else { "Nov" } }
    return if full { "December" } else { "Dec" }
}

fn weekdayName(day: usize, full: bool) -> []const u8 {
    if day == 0 { return if full { "Sunday" } else { "Sun" } }
    if day == 1 { return if full { "Monday" } else { "Mon" } }
    if day == 2 { return if full { "Tuesday" } else { "Tue" } }
    if day == 3 { return if full { "Wednesday" } else { "Wed" } }
    if day == 4 { return if full { "Thursday" } else { "Thu" } }
    if day == 5 { return if full { "Friday" } else { "Fri" } }
    return if full { "Saturday" } else { "Sat" }
}

fn writeOffset(offset: isize) -> bool {
    const positive = offset >= 0
    const magnitude = if positive { @bitCast(usize, offset) } else { @bitCast(usize, -(offset + 1)) + 1 }
    return std.io.print(if positive { "+" } else { "-" }) && number(magnitude / 3600, 2, 48) && number(magnitude / 60 % 60, 2, 48)
}

fn writeClock(value: Calendar, seconds: bool) -> bool {
    if !number(value.hour, 2, 48) || !std.io.print(":") || !number(value.minute, 2, 48) { return false }
    return !seconds || std.io.print(":") && number(value.second, 2, 48)
}

fn writeDate(value: Calendar) -> bool {
    return signedYear(value.year, 4) && std.io.print("-") && number(value.month, 2, 48) && std.io.print("-") && number(value.day, 2, 48)
}

fn recent(stamp: Timestamp) -> bool {
    const now = std.time.realtime()
    return now.seconds >= 0 && stamp.seconds > now.seconds - 15778476 && stamp.seconds <= now.seconds + 3600
}

fn customSpecifier(specifier: u8, value: Calendar, stamp: Timestamp, zone: timezone.Context) -> bool {
    if specifier == 37 { return std.io.print("%") }
    if specifier == 89 { return signedYear(value.year, 4) }
    if specifier == 121 { return number(@intCast(usize, if value.year >= 0 { value.year % 100 } else { -value.year % 100 }), 2, 48) }
    if specifier == 109 { return number(value.month, 2, 48) }
    if specifier == 100 { return number(value.day, 2, 48) }
    if specifier == 101 { return number(value.day, 2, 32) }
    if specifier == 72 || specifier == 107 { return number(value.hour, 2, if specifier == 107 { 32 } else { 48 }) }
    if specifier == 77 { return number(value.minute, 2, 48) }
    if specifier == 83 { return number(value.second, 2, 48) }
    if specifier == 78 { return number(@bitCast(usize, stamp.nanoseconds), 9, 48) }
    if specifier == 98 || specifier == 104 { return std.io.writeAll(std.io.stdout(), monthName(value.month, false)) }
    if specifier == 66 { return std.io.writeAll(std.io.stdout(), monthName(value.month, true)) }
    if specifier == 97 { return std.io.writeAll(std.io.stdout(), weekdayName(value.weekday, false)) }
    if specifier == 65 { return std.io.writeAll(std.io.stdout(), weekdayName(value.weekday, true)) }
    if specifier == 106 { return number(value.yearDay, 3, 48) }
    if specifier == 119 { return std.io.writeUnsigned(std.io.stdout(), value.weekday) }
    if specifier == 117 { return std.io.writeUnsigned(std.io.stdout(), if value.weekday == 0 { 7 } else { value.weekday }) }
    if specifier == 122 { return writeOffset(timezone.offset(zone, stamp.seconds)) }
    if specifier == 90 { return std.io.printString(timezone.abbreviation(zone, stamp.seconds)) }
    if specifier == 115 { return if stamp.seconds >= 0 { std.io.writeUnsigned(std.io.stdout(), @bitCast(usize, stamp.seconds)) } else { std.io.print("-") && std.io.writeUnsigned(std.io.stdout(), @bitCast(usize, -(stamp.seconds + 1)) + 1) } }
    if specifier == 70 { return writeDate(value) }
    if specifier == 82 { return writeClock(value, false) }
    if specifier == 84 { return writeClock(value, true) }
    if specifier == 110 { return std.io.print("\n") }
    if specifier == 116 { return std.io.print("\t") }
    return std.io.print("%") && std.io.writeAll(std.io.stdout(), [1]u8{specifier}[0..1])
}

fn writeCustom(format: std.string.String, value: Calendar, stamp: Timestamp, zone: timezone.Context) -> bool {
    var index: usize = 0
    while index < format.length {
        if format.pointer[index] != 37 {
            if !std.io.writeAll(std.io.stdout(), format.pointer[index..index + 1]) { return false }
            index += 1
        } else {
            index += 1
            while index < format.length && (format.pointer[index] == 45 || format.pointer[index] == 95 || format.pointer[index] == 48 || format.pointer[index] == 94 || format.pointer[index] == 35) { index += 1 }
            if index == format.length || !customSpecifier(format.pointer[index], value, stamp, zone) { return false }
            index += 1
        }
    }
    return true
}

fn selectedCustom(style: std.string.String, isRecent: bool) -> std.string.String {
    var split = style.length
    var index: usize = 0
    while index < style.length {
        if style.pointer[index] == 10 {
            split = index
            break
        }
        index += 1
    }
    if split == style.length || !isRecent { return std.string.slice(style, 0, split) }
    return std.string.slice(style, split + 1, style.length)
}

fn writeStyle(style: std.string.String, value: Calendar, stamp: Timestamp, zone: timezone.Context) -> bool {
    if style.length > 0 && style.pointer[0] == 43 { return writeCustom(selectedCustom(std.string.slice(style, 1, style.length), recent(stamp)), value, stamp, zone) }
    if common.equals(style, "full-iso") { return writeDate(value) && std.io.print(" ") && writeClock(value, true) && std.io.print(".") && number(@bitCast(usize, stamp.nanoseconds), 9, 48) && std.io.print(" ") && writeOffset(timezone.offset(zone, stamp.seconds)) }
    if common.equals(style, "long-iso") { return writeDate(value) && std.io.print(" ") && writeClock(value, false) }
    if common.equals(style, "iso") {
        if !recent(stamp) { return writeDate(value) }
        return number(value.month, 2, 48) && std.io.print("-") && number(value.day, 2, 48) && std.io.print(" ") && writeClock(value, false)
    }
    if !std.io.writeAll(std.io.stdout(), monthName(value.month, false)) || !std.io.print(" ") || !number(value.day, 2, 32) || !std.io.print(" ") { return false }
    return if recent(stamp) { writeClock(value, false) } else { std.io.print(" ") && signedYear(value.year, 4) }
}

pub fn write(entry: *entries.Entry, options: Options, zone: timezone.Context) -> bool {
    const stamp = timestamp(entry, options.timeField)
    if !stamp.known { return std.io.print("-") }
    const value = calendar(stamp.seconds + timezone.offset(zone, stamp.seconds))
    return writeStyle(options.timeStyle, value, stamp, zone)
}

pub fn seconds(entry: *entries.Entry, field: u8) -> isize { return timestamp(entry, field).seconds }

pub fn nanoseconds(entry: *entries.Entry, field: u8) -> isize { return timestamp(entry, field).nanoseconds }
