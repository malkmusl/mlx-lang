const std = @import("std")
const common = @import("../common.mlx")

const ZoneData = struct {
    pointer: [*]u8
    length: usize
    valid: bool
}

const Layout = struct {
    transitions: usize
    indices: usize
    types: usize
    abbreviations: usize
    timeCount: usize
    typeCount: usize
    wide: bool
    valid: bool
}

pub const Context = struct {
    data: ZoneData
    fixed: bool
    fixedOffset: isize
    fixedName: std.string.String
}

fn byteString(pointer: [*]const u8, length: usize) -> std.string.String {
    return std.string.fromParts(pointer, length)
}

fn load(path: std.string.String) -> ZoneData {
    var status: std.fs.Stat = undefined
    if std.fs.status(path.pointer, &status) != 0 || status.size <= 0 { return ZoneData.{ .pointer = undefined, .length = 0, .valid = false } }
    const length = @bitCast(usize, status.size)
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, length, 8)
    if allocation == null { return ZoneData.{ .pointer = undefined, .length = 0, .valid = false } }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        allocator.freeFn(allocator.context, allocation.?, length, 8)
        return ZoneData.{ .pointer = undefined, .length = 0, .valid = false }
    }
    var offset: usize = 0
    var valid = true
    while offset < length {
        var destination: [*]u8 = undefined
        unsafe { destination = @ptrFromInt([*]u8, @intFromPtr(allocation.?) + offset) }
        const amount = std.fs.read(file, destination, length - offset)
        if amount <= 0 {
            valid = false
            break
        }
        offset += @bitCast(usize, amount)
    }
    const closed = std.fs.close(file)
    if valid && closed { return ZoneData.{ .pointer = allocation.?, .length = length, .valid = true } }
    allocator.freeFn(allocator.context, allocation.?, length, 8)
    return ZoneData.{ .pointer = undefined, .length = 0, .valid = false }
}

fn be32(data: ZoneData, offset: usize) -> usize {
    if offset + 4 > data.length { return 0 }
    return @intCast(usize, data.pointer[offset]) << 24 | @intCast(usize, data.pointer[offset + 1]) << 16 | @intCast(usize, data.pointer[offset + 2]) << 8 | @intCast(usize, data.pointer[offset + 3])
}

fn signed32(data: ZoneData, offset: usize) -> isize {
    const value = be32(data, offset)
    if value & 2147483648 == 0 { return @intCast(isize, value) }
    return -@intCast(isize, 4294967296 - value)
}

fn signed64(data: ZoneData, offset: usize) -> isize {
    if offset + 8 > data.length { return 0 }
    var value: usize = 0
    var index: usize = 0
    while index < 8 {
        value = value << 8 | @intCast(usize, data.pointer[offset + index])
        index += 1
    }
    if value & 9223372036854775808 == 0 { return @intCast(isize, value) }
    return -@intCast(isize, 18446744073709551615 - value) - 1
}

fn blockSize(data: ZoneData, header: usize, wide: bool) -> usize {
    const timeCount = be32(data, header + 32)
    const typeCount = be32(data, header + 36)
    const charCount = be32(data, header + 40)
    const leapCount = be32(data, header + 28)
    const standardCount = be32(data, header + 24)
    const utcCount = be32(data, header + 20)
    const word: usize = if wide { 8 } else { 4 }
    return 44 + timeCount * word + timeCount + typeCount * 6 + charCount + leapCount * (word + 4) + standardCount + utcCount
}

fn layout(data: ZoneData) -> Layout {
    if data.length < 44 || data.pointer[0] != 84 || data.pointer[1] != 90 || data.pointer[2] != 105 || data.pointer[3] != 102 { return Layout.{ .transitions = 0, .indices = 0, .types = 0, .abbreviations = 0, .timeCount = 0, .typeCount = 0, .wide = false, .valid = false } }
    var header: usize = 0
    var wide = false
    if data.pointer[4] == 50 || data.pointer[4] == 51 || data.pointer[4] == 52 {
        header = blockSize(data, 0, false)
        wide = true
    }
    if header + 44 > data.length { return Layout.{ .transitions = 0, .indices = 0, .types = 0, .abbreviations = 0, .timeCount = 0, .typeCount = 0, .wide = false, .valid = false } }
    const timeCount = be32(data, header + 32)
    const typeCount = be32(data, header + 36)
    const word: usize = if wide { 8 } else { 4 }
    const transitions = header + 44
    const indices = transitions + timeCount * word
    const types = indices + timeCount
    const abbreviations = types + typeCount * 6
    return Layout.{ .transitions = transitions, .indices = indices, .types = types, .abbreviations = abbreviations, .timeCount = timeCount, .typeCount = typeCount, .wide = wide, .valid = abbreviations <= data.length }
}

fn transition(data: ZoneData, info: Layout, index: usize) -> isize {
    const width: usize = if info.wide { 8 } else { 4 }
    const offset = info.transitions + index * width
    return if info.wide { signed64(data, offset) } else { signed32(data, offset) }
}

fn defaultType(data: ZoneData, info: Layout) -> usize {
    var index: usize = 0
    while index < info.typeCount {
        if data.pointer[info.types + index * 6 + 4] == 0 { return index }
        index += 1
    }
    return 0
}

fn typeFor(context: Context, seconds: isize) -> usize {
    const info = layout(context.data)
    if !info.valid || info.typeCount == 0 { return 0 }
    var result = defaultType(context.data, info)
    var index: usize = 0
    while index < info.timeCount && transition(context.data, info, index) <= seconds {
        result = @intCast(usize, context.data.pointer[info.indices + index])
        index += 1
    }
    return if result < info.typeCount { result } else { 0 }
}

fn fixedZone(value: std.string.String) -> Context {
    var digit: usize = 0
    while digit < value.length && (value.pointer[digit] < 48 || value.pointer[digit] > 57) { digit += 1 }
    var hours: usize = 0
    var index = digit
    while index < value.length && value.pointer[index] >= 48 && value.pointer[index] <= 57 {
        hours = hours * 10 + @intCast(usize, value.pointer[index] - 48)
        index += 1
    }
    const negative = digit > 0 && value.pointer[digit - 1] == 45
    const positive = digit > 0 && value.pointer[digit - 1] == 43
    var offset = @intCast(isize, hours * 3600)
    if !negative || positive { offset = -offset }
    const nameEnd = if digit > 0 && (value.pointer[digit - 1] == 45 || value.pointer[digit - 1] == 43) { digit - 1 } else { digit }
    return Context.{ .data = ZoneData.{ .pointer = undefined, .length = 0, .valid = false }, .fixed = true, .fixedOffset = offset, .fixedName = std.string.slice(value, 0, nameEnd) }
}

fn zonePath(value: std.string.String) -> ?std.path.MutablePath {
    if value.length > 0 && value.pointer[0] == 47 { return std.path.allocate(value) }
    return std.path.join(std.string.fromSlice("/usr/share/zoneinfo"), value)
}

pub fn init(value: std.string.String) -> Context {
    if value.length == 0 {
        const data = load(std.string.fromSlice("/etc/localtime"))
        return Context.{ .data = data, .fixed = !data.valid, .fixedOffset = 0, .fixedName = std.string.fromSlice("UTC") }
    }
    const actual = if value.pointer[0] == 58 { std.string.slice(value, 1, value.length) } else { value }
    const owned = zonePath(actual)
    if owned != null {
        const data = load(byteString(owned.?.pointer, owned.?.length))
        std.path.free(owned.?)
        if data.valid { return Context.{ .data = data, .fixed = false, .fixedOffset = 0, .fixedName = actual } }
    }
    return fixedZone(actual)
}

pub fn deinit(context: Context) -> void {
    if !context.data.valid { return }
    const allocator = std.page_allocator.init()
    allocator.freeFn(allocator.context, context.data.pointer, context.data.length, 8)
}

pub fn offset(context: Context, seconds: isize) -> isize {
    if context.fixed { return context.fixedOffset }
    const info = layout(context.data)
    if !info.valid || info.typeCount == 0 { return 0 }
    return signed32(context.data, info.types + typeFor(context, seconds) * 6)
}

pub fn abbreviation(context: Context, seconds: isize) -> std.string.String {
    if context.fixed { return context.fixedName }
    const info = layout(context.data)
    if !info.valid || info.typeCount == 0 { return std.string.fromSlice("") }
    const abbreviationIndex = @intCast(usize, context.data.pointer[info.types + typeFor(context, seconds) * 6 + 5])
    var length: usize = 0
    while info.abbreviations + abbreviationIndex + length < context.data.length && context.data.pointer[info.abbreviations + abbreviationIndex + length] != 0 { length += 1 }
    unsafe { return std.string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(context.data.pointer) + info.abbreviations + abbreviationIndex), length) }
}
