const std = @import("std")

const Key = struct {
    device: usize
    inode: usize
}

pub const State = struct {
    keys: *std.vector.Vector
}

pub fn init() -> State {
    const allocator = std.page_allocator.init()
    unsafe {
        const keys = @ptrCast(*std.vector.Vector, allocator.allocFn(allocator.context, @sizeOf(std.vector.Vector), @alignOf(std.vector.Vector)).?)
        std.vector.Vector.initAt(keys, allocator, @sizeOf(Key), @alignOf(Key), 16)
        return State.{ .keys = keys }
    }
}

fn at(state: *State, index: usize) -> *Key {
    unsafe { return @ptrCast(*Key, std.vector.Vector.at(state.*.keys.*, index)) }
}

pub fn contains(state: *State, status: std.fs.Stat) -> bool {
    var index: usize = 0
    while index < state.*.keys.*.length {
        const existing = at(state, index)
        if existing.*.device == status.device && existing.*.inode == status.inode { return true }
        index += 1
    }
    return false
}

pub fn visit(state: *State, status: std.fs.Stat) -> bool {
    if contains(state, status) { return false }
    var key = Key.{ .device = status.device, .inode = status.inode }
    unsafe { return std.vector.Vector.appendAt(state.*.keys, @ptrCast([*]const u8, &key)) }
}

pub fn deinit(state: *State) -> void {
    const allocator = std.page_allocator.init()
    std.vector.Vector.deinit(state.*.keys.*)
    unsafe { allocator.freeFn(allocator.context, @ptrCast([*]u8, state.*.keys), @sizeOf(std.vector.Vector), @alignOf(std.vector.Vector)) }
}
