const std = @import("std")
const entries = @import("./entries.mlx")
const names = @import("./names.mlx")
const options_module = @import("./options.mlx")

const Options = options_module.Options

pub const Metrics = struct {
    inode: usize
    blocks: usize
}

fn digits(value: usize) -> usize {
    var result: usize = 1
    var remaining = value
    while remaining >= 10 {
        remaining /= 10
        result += 1
    }
    return result
}

fn scaledBlocks(status: std.fs.Stat, options: Options) -> usize {
    const raw = if status.blocks < 0 { 0 } else { @bitCast(usize, status.blocks) }
    const unit = if options.blockSize == 0 { 1 } else { options.blockSize }
    if raw > 18446744073709551615 / 512 { return raw }
    return (raw * 512 + unit - 1) / unit
}

pub fn metrics(listing: *entries.List, options: Options) -> Metrics {
    var result = Metrics.{ .inode = 1, .blocks = 1 }
    var index: usize = 0
    while index < listing.*.items.length {
        const entry = entries.at(listing, index)
        if entry.*.statusValid {
            const inode = digits(entry.*.status.inode)
            const blocks = digits(scaledBlocks(entry.*.status, options))
            if inode > result.inode { result.inode = inode }
            if blocks > result.blocks { result.blocks = blocks }
        }
        index += 1
    }
    return result
}

fn padding(amount: usize) -> bool {
    var remaining = amount
    while remaining > 0 {
        if !std.io.print(" ") { return false }
        remaining -= 1
    }
    return true
}

fn unsignedField(value: usize, width: usize) -> bool {
    const length = digits(value)
    return padding(if width > length { width - length } else { 0 }) && std.io.writeUnsigned(std.io.stdout(), value)
}

pub fn indicator(status: std.fs.Stat, style: u8) -> u8 {
    if style == 0 { return 0 }
    const mode = @intCast(usize, status.mode)
    const kind = mode & 61440
    if kind == 16384 { return 47 }
    if style == 1 { return 0 }
    if kind == 40960 { return 64 }
    if kind == 4096 { return 124 }
    if kind == 49152 { return 61 }
    if style == 3 && kind == 32768 && mode & 73 != 0 { return 42 }
    return 0
}

fn prefixWidth(entry: *entries.Entry, options: Options, sizes: Metrics) -> usize {
    var result: usize = 0
    if options.inode { result += sizes.inode + 1 }
    if options.blocks { result += sizes.blocks + 1 }
    return result
}

pub fn width(entry: *entries.Entry, options: Options, sizes: Metrics) -> usize {
    const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
    const suffix = if entry.*.statusValid { indicator(entry.*.status, options.indicator) } else { 0 }
    return prefixWidth(entry, options, sizes) + names.width(name, options.quoting) + if suffix == 0 { 0 } else { 1 }
}

fn writePrefix(entry: *entries.Entry, options: Options, sizes: Metrics) -> bool {
    if options.inode {
        const value = if entry.*.statusValid { entry.*.status.inode } else { 0 }
        if !unsignedField(value, sizes.inode) || !std.io.print(" ") { return false }
    }
    if options.blocks {
        const value = if entry.*.statusValid { scaledBlocks(entry.*.status, options) } else { 0 }
        if !unsignedField(value, sizes.blocks) || !std.io.print(" ") { return false }
    }
    return true
}

pub fn write(entry: *entries.Entry, options: Options, sizes: Metrics) -> bool {
    if !writePrefix(entry, options, sizes) { return false }
    const name = std.string.fromParts(entry.*.name.pointer, entry.*.name.length)
    if !names.write(name, options.quoting) { return false }
    const suffix = if entry.*.statusValid { indicator(entry.*.status, options.indicator) } else { 0 }
    if suffix == 0 { return true }
    const value = [1]u8{suffix}
    return std.io.writeAll(std.io.stdout(), value[0..1])
}
