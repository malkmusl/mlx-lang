const std = @import("std")
const entries = @import("./entries.mlx")
const decorated = @import("./decorated_name.mlx")
const item = @import("./item.mlx")
const options_module = @import("./options.mlx")

const Options = options_module.Options

fn indexFor(row: usize, column: usize, rows: usize, columns: usize, horizontal: bool) -> usize {
    return if horizontal { row * columns + column } else { column * rows + row }
}

fn clearWidths(widths: [*]usize, columns: usize) -> void {
    var index: usize = 0
    while index < columns {
        widths[index] = 0
        index += 1
    }
}

fn fillWidths(listing: *entries.List, options: Options, sizes: item.Metrics, widths: [*]usize, columns: usize, horizontal: bool) -> usize {
    const rows = (listing.*.items.length + columns - 1) / columns
    clearWidths(widths, columns)
    var index: usize = 0
    while index < listing.*.items.length {
        const column = if horizontal { index % columns } else { index / rows }
        const value = item.columnWidth(entries.at(listing, index), options, sizes)
        if value > widths[column] { widths[column] = value }
        index += 1
    }
    var total: usize = 0
    index = 0
    while index < columns {
        total += widths[index]
        if index + 1 < columns { total += 2 }
        index += 1
    }
    return total
}

fn chooseColumns(listing: *entries.List, options: Options, sizes: item.Metrics, widths: [*]usize, horizontal: bool) -> usize {
    if listing.*.items.length == 0 { return 1 }
    var columns = listing.*.items.length
    while columns > 1 {
        const total = fillWidths(listing, options, sizes, widths, columns, horizontal)
        if options.width == 0 || total <= options.width { return columns }
        columns -= 1
    }
    const ignored = fillWidths(listing, options, sizes, widths, 1, horizontal)
    return 1
}

fn padTo(current: usize, target: usize, tabSize: usize) -> bool {
    var position = current
    while tabSize > 0 && (position / tabSize + 1) * tabSize <= target && (position / tabSize + 1) * tabSize - position >= 2 {
        if !std.io.print("\t") { return false }
        position = (position / tabSize + 1) * tabSize
    }
    while position < target {
        if !std.io.print(" ") { return false }
        position += 1
    }
    return true
}

fn writeRows(listing: *entries.List, parent: std.string.String, options: Options, sizes: item.Metrics, widths: [*]usize, columns: usize, horizontal: bool, state: *decorated.State) -> bool {
    const rows = (listing.*.items.length + columns - 1) / columns
    var row: usize = 0
    while row < rows {
        var column: usize = 0
        var position: usize = 0
        var columnStart: usize = 0
        while column < columns {
            const index = indexFor(row, column, rows, columns, horizontal)
            if index < listing.*.items.length {
                if column > 0 {
                    columnStart += widths[column - 1] + 2
                    if !padTo(position, columnStart, options.tabSize) { return false }
                    position = columnStart
                }
                const entry = entries.at(listing, index)
                if !item.writeColumn(entry, parent, options, sizes, state) { return false }
                position += item.columnWidth(entry, options, sizes)
            }
            column += 1
        }
        if !std.io.print("\n") { return false }
        row += 1
    }
    return true
}

pub fn columns(listing: *entries.List, parent: std.string.String, options: Options, horizontal: bool) -> bool {
    if listing.*.items.length == 0 { return true }
    const allocator = std.page_allocator.init()
    const memory = allocator.allocFn(allocator.context, listing.*.items.length * @sizeOf(usize), @alignOf(usize))
    if memory == null { return false }
    var written = false
    var state = decorated.init()
    unsafe {
        const widths = @ptrCast([*]usize, memory.?)
        const sizes = item.metrics(listing, parent, options)
        const count = chooseColumns(listing, options, sizes, widths, horizontal)
        written = writeRows(listing, parent, options, sizes, widths, count, horizontal, &state)
    }
    allocator.freeFn(allocator.context, memory.?, listing.*.items.length * @sizeOf(usize), @alignOf(usize))
    return written
}

pub fn commas(listing: *entries.List, parent: std.string.String, options: Options) -> bool {
    const sizes = item.metrics(listing, parent, options)
    var state = decorated.init()
    var position: usize = 0
    var index: usize = 0
    while index < listing.*.items.length {
        const entry = entries.at(listing, index)
        const width = item.width(entry, options, sizes)
        if position > 0 && options.width > 0 && position + 2 + width > options.width {
            if !std.io.print(",\n") { return false }
            position = 0
        } else if position > 0 {
            if !std.io.print(", ") { return false }
            position += 2
        }
        if !item.write(entry, parent, options, sizes, &state) { return false }
        position += width
        index += 1
    }
    return listing.*.items.length == 0 || std.io.print("\n")
}
