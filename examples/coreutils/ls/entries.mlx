const std = @import("std")
const common = @import("../common.mlx")
const options_module = @import("./options.mlx")
const pattern = @import("./pattern.mlx")

pub const Entry = struct {
    name: std.path.MutablePath
    status: std.fs.Stat
    statusValid: bool
    birthSeconds: isize
    birthNanoseconds: isize
    birthKnown: bool
}

pub const List = struct {
    items: std.vector.Vector
    valid: bool
    metadataValid: bool
}

pub const GatherOptions = struct {
    all: bool
    almostAll: bool
    ignoreBackups: bool
    dereference: bool
    requireMetadata: bool
    ignorePatterns: *std.vector.Vector
    hidePatterns: *std.vector.Vector
}

pub const SortOptions = struct {
    mode: u8
    timeField: u8
    reverse: bool
    groupDirectories: bool
}

pub fn at(list: *List, index: usize) -> *Entry {
    unsafe { return @ptrCast(*Entry, std.vector.Vector.at(list.*.items, index)) }
}

pub fn init() -> List {
    const allocator = std.page_allocator.init()
    return List.{ .items = std.vector.Vector.init(allocator, @sizeOf(Entry), @alignOf(Entry), 16), .valid = true, .metadataValid = true }
}

fn isDotEntry(name: std.string.String) -> bool {
    if name.length == 1 { return name.pointer[0] == 46 }
    return name.length == 2 && name.pointer[0] == 46 && name.pointer[1] == 46
}

fn matchesAny(name: std.string.String, patterns: *std.vector.Vector) -> bool {
    var index: usize = 0
    while index < patterns.*.length {
        if pattern.matches(name, options_module.patternAt(patterns, index)) { return true }
        index += 1
    }
    return false
}

fn wanted(name: std.string.String, options: GatherOptions) -> bool {
    if options.ignoreBackups && name.length > 0 && name.pointer[name.length - 1] == 126 { return false }
    if matchesAny(name, options.ignorePatterns) { return false }
    if !options.all && !options.almostAll && matchesAny(name, options.hidePatterns) { return false }
    if name.length == 0 || name.pointer[0] != 46 { return true }
    if options.all { return true }
    return options.almostAll && !isDotEntry(name)
}

fn entryName(buffer: [*]u8, offset: usize, record_length: usize) -> std.string.String {
    var length: usize = 0
    while 19 + length < record_length && buffer[offset + 19 + length] != 0 { length += 1 }
    unsafe { return std.string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(buffer) + offset + 19), length) }
}

fn append(list: *List, directory: std.fs.File, name: std.string.String, options: GatherOptions) -> bool {
    if !wanted(name, options) { return true }
    const owned = std.path.allocate(name)
    if owned == null { return false }
    const stored_name = owned.?
    var status: std.fs.Stat = undefined
    const status_result = std.fs.statusFrom(directory, stored_name.pointer, &status, !options.dereference)
    if status_result != 0 {
        const fallback = std.fs.statusFrom(directory, stored_name.pointer, &status, true)
        if options.requireMetadata { list.*.metadataValid = false }
    }
    var extended: std.fs.Statx = undefined
    const has_extended = std.fs.extendedStatusFrom(directory, stored_name.pointer, &extended, !options.dereference) == 0
    const has_birth = has_extended && extended.mask & 2048 != 0
    var entry = Entry.{
        .name = stored_name, .status = status, .statusValid = status_result == 0,
        .birthSeconds = if has_birth { extended.born.seconds } else { 0 },
        .birthNanoseconds = if has_birth { @intCast(isize, extended.born.nanoseconds) } else { 0 },
        .birthKnown = has_birth,
    }
    unsafe {
        list.*.items = std.vector.Vector.append(list.*.items, @ptrCast([*]const u8, &entry))
    }
    return true
}

pub fn appendPath(list: *List, path: std.string.String, status: std.fs.Stat, noFollow: bool) -> bool {
    const owned = std.path.allocate(path)
    if owned == null { return false }
    var extended: std.fs.Statx = undefined
    const has_extended = std.fs.extendedStatus(path.pointer, &extended, noFollow) == 0
    const has_birth = has_extended && extended.mask & 2048 != 0
    var entry = Entry.{
        .name = owned.?, .status = status, .statusValid = true,
        .birthSeconds = if has_birth { extended.born.seconds } else { 0 },
        .birthNanoseconds = if has_birth { @intCast(isize, extended.born.nanoseconds) } else { 0 },
        .birthKnown = has_birth,
    }
    unsafe {
        list.*.items = std.vector.Vector.append(list.*.items, @ptrCast([*]const u8, &entry))
    }
    return true
}

fn consumeBuffer(list: *List, directory: std.fs.File, buffer: [*]u8, length: usize, options: GatherOptions) -> bool {
    var offset: usize = 0
    while offset < length {
        const record_length = @intCast(usize, std.mem.readU16Little(buffer, offset + 16))
        if record_length < 20 || offset + record_length > length { return false }
        if !append(list, directory, entryName(buffer, offset, record_length), options) { return false }
        offset += record_length
    }
    return true
}

pub fn read(directory: std.fs.File, options: GatherOptions) -> List {
    const allocator = std.page_allocator.init()
    var result = init()
    const allocation = allocator.allocFn(allocator.context, common.BUFFER_SIZE, 8)
    if allocation == null {
        result.valid = false
        return result
    }
    const buffer = allocation.?
    while result.valid {
        const amount = std.fs.readDirectory(directory, buffer, common.BUFFER_SIZE)
        if amount < 0 {
            result.valid = false
            break
        }
        if amount == 0 { break }
        result.valid = consumeBuffer(&result, directory, buffer, @bitCast(usize, amount), options)
    }
    allocator.freeFn(allocator.context, buffer, common.BUFFER_SIZE, 8)
    return result
}

fn isDirectory(entry: Entry) -> bool { return entry.statusValid && entry.status.mode & 61440 == 16384 }

fn extension(name: std.string.String) -> std.string.String {
    var index = name.length
    while index > 0 {
        index -= 1
        if name.pointer[index] == 46 { return std.string.slice(name, index + 1, name.length) }
    }
    return std.string.slice(name, name.length, name.length)
}

fn digit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn versionOrder(value: std.string.String, index: usize) -> isize {
    if index >= value.length { return 0 }
    const byte = value.pointer[index]
    if byte == 126 { return -1 }
    if digit(byte) { return 0 }
    if byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 { return @intCast(isize, byte) }
    return @intCast(isize, byte) + 256
}

fn compareDigitRun(left: std.string.String, right: std.string.String, leftIndex: *usize, rightIndex: *usize, zeroDifference: *isize) -> isize {
    const leftZerosStart = leftIndex.*
    const rightZerosStart = rightIndex.*
    while leftIndex.* < left.length && left.pointer[leftIndex.*] == 48 { leftIndex.* += 1 }
    while rightIndex.* < right.length && right.pointer[rightIndex.*] == 48 { rightIndex.* += 1 }
    const leftZeros = leftIndex.* - leftZerosStart
    const rightZeros = rightIndex.* - rightZerosStart
    var leftEnd = leftIndex.*
    var rightEnd = rightIndex.*
    while leftEnd < left.length && digit(left.pointer[leftEnd]) { leftEnd += 1 }
    while rightEnd < right.length && digit(right.pointer[rightEnd]) { rightEnd += 1 }
    if leftEnd - leftIndex.* != rightEnd - rightIndex.* { return if leftEnd - leftIndex.* < rightEnd - rightIndex.* { -1 } else { 1 } }
    const compared = std.string.compare(std.string.slice(left, leftIndex.*, leftEnd), std.string.slice(right, rightIndex.*, rightEnd))
    leftIndex.* = leftEnd
    rightIndex.* = rightEnd
    if compared != 0 { return compared }
    if zeroDifference.* == 0 && leftZeros != rightZeros { zeroDifference.* = if leftZeros > rightZeros { -1 } else { 1 } }
    return 0
}

fn versionCompare(left: std.string.String, right: std.string.String) -> isize {
    if isDotEntry(left) { return if isDotEntry(right) { std.string.compare(left, right) } else { -1 } }
    if isDotEntry(right) { return 1 }
    const leftDot = left.length > 0 && left.pointer[0] == 46
    const rightDot = right.length > 0 && right.pointer[0] == 46
    if leftDot != rightDot { return if leftDot { -1 } else { 1 } }
    var leftIndex: usize = if leftDot { 1 } else { 0 }
    var rightIndex: usize = if rightDot { 1 } else { 0 }
    var zeroDifference: isize = 0
    while leftIndex < left.length || rightIndex < right.length {
        while leftIndex < left.length && !digit(left.pointer[leftIndex]) || rightIndex < right.length && !digit(right.pointer[rightIndex]) {
            const leftOrder = versionOrder(left, leftIndex)
            const rightOrder = versionOrder(right, rightIndex)
            if leftOrder != rightOrder { return if leftOrder < rightOrder { -1 } else { 1 } }
            if leftIndex < left.length { leftIndex += 1 }
            if rightIndex < right.length { rightIndex += 1 }
        }
        if leftIndex >= left.length || rightIndex >= right.length { break }
        const compared = compareDigitRun(left, right, &leftIndex, &rightIndex, &zeroDifference)
        if compared != 0 { return compared }
    }
    if leftIndex != left.length || rightIndex != right.length { return if leftIndex == left.length { -1 } else { 1 } }
    return zeroDifference
}

fn selectedSeconds(entry: *Entry, field: u8) -> isize {
    if field == 1 { return entry.*.status.accessedSeconds }
    if field == 2 { return entry.*.status.changedSeconds }
    if field == 3 { return entry.*.birthSeconds }
    return entry.*.status.modifiedSeconds
}

fn selectedNanoseconds(entry: *Entry, field: u8) -> isize {
    if field == 1 { return entry.*.status.accessedNanoseconds }
    if field == 2 { return entry.*.status.changedNanoseconds }
    if field == 3 { return entry.*.birthNanoseconds }
    return entry.*.status.modifiedNanoseconds
}

fn compareCore(left: *Entry, right: *Entry, options: SortOptions) -> isize {
    const left_name = std.string.fromParts(left.*.name.pointer, left.*.name.length)
    const right_name = std.string.fromParts(right.*.name.pointer, right.*.name.length)
    if options.mode == 2 && left.*.statusValid && right.*.statusValid && left.*.status.size != right.*.status.size { return if left.*.status.size > right.*.status.size { -1 } else { 1 } }
    if options.mode == 3 && left.*.statusValid && right.*.statusValid {
        const left_seconds = selectedSeconds(left, options.timeField)
        const right_seconds = selectedSeconds(right, options.timeField)
        if left_seconds != right_seconds { return if left_seconds > right_seconds { -1 } else { 1 } }
        const left_nanos = selectedNanoseconds(left, options.timeField)
        const right_nanos = selectedNanoseconds(right, options.timeField)
        if left_nanos != right_nanos { return if left_nanos > right_nanos { -1 } else { 1 } }
    }
    if options.mode == 4 {
        const compared = std.string.compare(extension(left_name), extension(right_name))
        if compared != 0 { return compared }
    }
    if options.mode == 5 {
        const compared = versionCompare(left_name, right_name)
        if compared != 0 { return compared }
    }
    if options.mode == 6 && left_name.length != right_name.length { return if left_name.length < right_name.length { -1 } else { 1 } }
    return std.string.compare(left_name, right_name)
}

fn compare(left: *Entry, right: *Entry, options: SortOptions) -> isize {
    if options.groupDirectories && isDirectory(left.*) != isDirectory(right.*) { return if isDirectory(left.*) { -1 } else { 1 } }
    const result = compareCore(left, right, options)
    return if options.reverse { -result } else { result }
}

fn swap(list: *List, left: usize, right: usize) -> void {
    var temporary: Entry = undefined
    unsafe {
        std.mem.copy(@ptrCast([*]u8, &temporary), std.vector.Vector.at(list.*.items, left), @sizeOf(Entry))
        std.mem.copy(std.vector.Vector.at(list.*.items, left), std.vector.Vector.at(list.*.items, right), @sizeOf(Entry))
        std.mem.copy(std.vector.Vector.at(list.*.items, right), @ptrCast([*]const u8, &temporary), @sizeOf(Entry))
    }
}

pub fn sort(list: *List, options: SortOptions) -> void {
    if options.mode == 1 { return }
    var remaining = list.*.items.length
    while remaining > 1 {
        var index: usize = 1
        var changed = false
        while index < remaining {
            if compare(at(list, index - 1), at(list, index), options) > 0 {
                swap(list, index - 1, index)
                changed = true
            }
            index += 1
        }
        if !changed { break }
        remaining -= 1
    }
}

pub fn deinit(list: *List) -> void {
    var index: usize = 0
    while index < list.*.items.length {
        std.path.free(at(list, index).*.name)
        index += 1
    }
    std.vector.Vector.deinit(list.*.items)
}
