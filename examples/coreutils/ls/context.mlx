const std = @import("std")
const common = @import("../common.mlx")
const paths = @import("../paths.mlx")

const CAPACITY: usize = 4096

fn hasAttribute(path: [*]const u8, name: [*]const u8) -> bool {
    var buffer: [4096]u8 = undefined
    return std.fs.getExtendedAttribute(path, name, @ptrCast([*]u8, buffer[0..4096]), CAPACITY, true) > 0
}

pub fn marker(parent: std.string.String, name: std.string.String) -> u8 {
    const path = if parent.length > 0 { paths.join(parent, name) } else { common.allocatePath(name) }
    if path == null { return 0 }
    var result: u8 = 0
    if hasAttribute(path.?.pointer, @ptrCast([*]const u8, "system.posix_acl_access")) { result = 43 } else if hasAttribute(path.?.pointer, @ptrCast([*]const u8, "security.selinux")) || hasAttribute(path.?.pointer, @ptrCast([*]const u8, "security.SMACK64")) {
        result = 46
    }
    common.freePath(path.?)
    return result
}

fn read(parent: std.string.String, name: std.string.String, buffer: [*]u8) -> usize {
    const path = if parent.length > 0 { paths.join(parent, name) } else { common.allocatePath(name) }
    if path == null { return 0 }
    var amount = std.fs.getExtendedAttribute(path.?.pointer, @ptrCast([*]const u8, "security.selinux"), buffer, CAPACITY, true)
    if amount < 0 { amount = std.fs.getExtendedAttribute(path.?.pointer, @ptrCast([*]const u8, "security.SMACK64"), buffer, CAPACITY, true) }
    common.freePath(path.?)
    if amount <= 0 { return 0 }
    var length = @bitCast(usize, amount)
    if length > 0 && buffer[length - 1] == 0 { length -= 1 }
    return length
}

pub fn width(parent: std.string.String, name: std.string.String) -> usize {
    var buffer: [4096]u8 = undefined
    const length = read(parent, name, @ptrCast([*]u8, buffer[0..4096]))
    return if length == 0 { 1 } else { length }
}

pub fn write(parent: std.string.String, name: std.string.String, widthValue: usize) -> bool {
    var buffer: [4096]u8 = undefined
    const length = read(parent, name, @ptrCast([*]u8, buffer[0..4096]))
    if length == 0 {
        if !std.io.print("?") { return false }
    } else if !std.io.writeAll(std.io.stdout(), buffer[0..length]) { return false }
    const actualLength: usize = if length == 0 { 1 } else { length }
    var padding = widthValue - actualLength
    while padding > 0 {
        if !std.io.print(" ") { return false }
        padding -= 1
    }
    return true
}
