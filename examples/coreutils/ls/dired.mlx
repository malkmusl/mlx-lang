const std = @import("std")

const Vector = std.vector.Vector

pub const State = struct {
    position: usize
    names: *Vector
    directories: *Vector
}

fn newOffsets() -> *Vector {
    const allocator = std.page_allocator.init()
    unsafe {
        const result = @ptrCast(*Vector, allocator.allocFn(allocator.context, @sizeOf(Vector), @alignOf(Vector)).?)
        Vector.initAt(result, allocator, @sizeOf(usize), @alignOf(usize), 16)
        return result
    }
}

pub fn init() -> State {
    return State.{ .position = 0, .names = newOffsets(), .directories = newOffsets() }
}

fn append(vector: *Vector, value: usize) -> bool {
    unsafe { return Vector.appendAt(vector, @ptrCast([*]const u8, &value)) }
}

pub fn advance(state: *State, amount: usize) -> void { state.*.position += amount }

pub fn beginName(state: *State) -> bool { return append(state.*.names, state.*.position) }

pub fn endName(state: *State) -> bool { return append(state.*.names, state.*.position) }

pub fn beginDirectory(state: *State) -> bool { return append(state.*.directories, state.*.position) }

pub fn endDirectory(state: *State) -> bool { return append(state.*.directories, state.*.position) }

fn offsetAt(vector: *Vector, index: usize) -> usize {
    unsafe { return @ptrCast(*usize, Vector.at(vector.*, index)).* }
}

fn writeOffsets(label: []const u8, vector: *Vector) -> bool {
    if vector.*.length == 0 { return true }
    if !std.io.print(label) { return false }
    var index: usize = 0
    while index < vector.*.length {
        if !std.io.print(" ") || !std.io.writeUnsigned(std.io.stdout(), offsetAt(vector, index)) { return false }
        index += 1
    }
    return std.io.print("\n")
}

fn quotingName(style: u8) -> []const u8 {
    if style == 0 { return "literal" }
    if style == 1 { return "escape" }
    if style == 2 { return "c" }
    if style == 3 { return "shell" }
    if style == 4 { return "shell-always" }
    if style == 5 { return "shell-escape" }
    if style == 6 { return "shell-escape-always" }
    if style == 7 { return "locale" }
    return "literal"
}

pub fn finish(state: *State, quoting: u8) -> bool {
    if !writeOffsets("//DIRED//", state.*.names) || !writeOffsets("//SUBDIRED//", state.*.directories) { return false }
    return std.io.print("//DIRED-OPTIONS// --quoting-style=") && std.io.print(quotingName(quoting)) && std.io.print("\n")
}

fn freeOffsets(vector: *Vector) -> void {
    const allocator = std.page_allocator.init()
    Vector.deinit(vector.*)
    unsafe { allocator.freeFn(allocator.context, @ptrCast([*]u8, vector), @sizeOf(Vector), @alignOf(Vector)) }
}

pub fn deinit(state: *State) -> void {
    freeOffsets(state.*.names)
    freeOffsets(state.*.directories)
}
