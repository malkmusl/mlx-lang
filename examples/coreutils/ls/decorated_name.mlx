const std = @import("std")
const common = @import("../common.mlx")
const names = @import("./names.mlx")
const options_module = @import("./options.mlx")
const pattern = @import("./pattern.mlx")

const Options = options_module.Options

pub const State = struct {
    colorStarted: bool
}

pub fn init() -> State { return State.{ .colorStarted = false } }

fn escape() -> bool {
    const value = [1]u8{27}
    return std.io.writeAll(std.io.stdout(), value[0..1])
}

fn mapping(colors: std.string.String, key: std.string.String) -> ?std.string.String {
    var start: usize = 0
    while start <= colors.length {
        var end = start
        while end < colors.length && colors.pointer[end] != 58 { end += 1 }
        var equal = start
        while equal < end && colors.pointer[equal] != 61 { equal += 1 }
        if equal < end && std.string.eql(std.string.slice(colors, start, equal), key) { return std.string.slice(colors, equal + 1, end) }
        if end == colors.length { break }
        start = end + 1
    }
    return null
}

fn extensionMapping(colors: std.string.String, name: std.string.String) -> ?std.string.String {
    var result: ?std.string.String = null
    var start: usize = 0
    while start <= colors.length {
        var end = start
        while end < colors.length && colors.pointer[end] != 58 { end += 1 }
        var equal = start
        while equal < end && colors.pointer[equal] != 61 { equal += 1 }
        const key = std.string.slice(colors, start, equal)
        if equal < end && key.length > 0 && key.pointer[0] == 42 && pattern.matches(name, key) { result = std.string.slice(colors, equal + 1, end) }
        if end == colors.length { break }
        start = end + 1
    }
    return result
}

fn typeKey(status: std.fs.Stat) -> []const u8 {
    const mode = @intCast(usize, status.mode)
    const kind = mode & 61440
    if kind == 16384 {
        if mode & 512 != 0 && mode & 2 != 0 { return "tw" }
        if mode & 2 != 0 { return "ow" }
        if mode & 512 != 0 { return "st" }
        return "di"
    }
    if kind == 40960 { return "ln" }
    if kind == 4096 { return "pi" }
    if kind == 49152 { return "so" }
    if kind == 24576 { return "bd" }
    if kind == 8192 { return "cd" }
    if mode & 2048 != 0 { return "su" }
    if mode & 1024 != 0 { return "sg" }
    if kind == 32768 && mode & 73 != 0 { return "ex" }
    return "fi"
}

fn colorCode(name: std.string.String, status: std.fs.Stat, options: Options) -> ?std.string.String {
    if !options.colorsSet || options.colors.length == 0 { return null }
    const key = std.string.fromSlice(typeKey(status))
    const selected = mapping(options.colors, key)
    if selected != null && selected.?.length > 0 { return selected }
    if status.mode & 61440 == 32768 && status.mode & 73 == 0 { return extensionMapping(options.colors, name) }
    return null
}

fn beginColor(code: ?std.string.String, state: *State) -> bool {
    if code == null { return true }
    if !state.*.colorStarted {
        if !escape() || !std.io.print("[0m") { return false }
        state.*.colorStarted = true
    }
    return escape() && std.io.print("[") && std.io.printString(code.?) && std.io.print("m")
}

fn endColor(code: ?std.string.String) -> bool {
    return code == null || escape() && std.io.print("[0m")
}

fn writeEncoded(value: std.string.String) -> bool {
    var index: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        const safe = byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte == 45 || byte == 46 || byte == 95 || byte == 126 || byte == 47
        if safe {
            if !std.io.writeAll(std.io.stdout(), value.pointer[index..index + 1]) { return false }
        } else {
            const digits = "0123456789ABCDEF"
            const encoded = [3]u8{37, digits[byte / 16], digits[byte % 16]}
            if !std.io.writeAll(std.io.stdout(), encoded[0..3]) { return false }
        }
        index += 1
    }
    return true
}

fn writeHost() -> bool {
    var info: std.os.linux.system.UtsName = undefined
    if !std.os.linux.system.getSystemInfo(&info) { return true }
    var length: usize = 0
    while length < 65 && info.nodeName[length] != 0 { length += 1 }
    return std.io.writeAll(std.io.stdout(), info.nodeName[0..length])
}

fn writeAbsolute(parent: std.string.String, name: std.string.String) -> bool {
    const combined = if parent.length > 0 { std.path.join(parent, name) } else { std.path.allocate(name) }
    if combined == null { return false }
    const value = std.string.fromParts(combined.?.pointer, combined.?.length)
    var written = true
    if value.length == 0 || value.pointer[0] != 47 {
        var working: [4096]u8 = undefined
        const length = std.fs.getWorkingDirectory(@ptrCast([*]u8, working[0..4096]), 4096)
        if length <= 0 { written = false } else {
            unsafe { written = writeEncoded(std.string.fromParts(@ptrCast([*]const u8, working[0..4096]), @bitCast(usize, length) - 1)) && std.io.print("/") }
        }
    }
    if written { written = writeEncoded(value) }
    std.path.free(combined.?)
    return written
}

fn writeHyperlinkPath(parent: std.string.String, name: std.string.String, status: std.fs.Stat) -> bool {
    if status.mode & 61440 != 40960 { return writeAbsolute(parent, name) }
    const path = if parent.length > 0 { std.path.join(parent, name) } else { std.path.allocate(name) }
    if path == null { return false }
    var target: [4096]u8 = undefined
    const amount = std.fs.readLink(path.?.pointer, @ptrCast([*]u8, target[0..4096]), 4096)
    std.path.free(path.?)
    if amount < 0 { return writeAbsolute(parent, name) }
    unsafe {
        const value = std.string.fromParts(@ptrCast([*]const u8, target[0..4096]), @bitCast(usize, amount))
        return if value.length > 0 && value.pointer[0] == 47 { writeAbsolute(std.string.fromSlice(""), value) } else { writeAbsolute(parent, value) }
    }
}

fn beginHyperlink(parent: std.string.String, name: std.string.String, status: std.fs.Stat, active: bool) -> bool {
    if !active { return true }
    return escape() && std.io.print("]8;;file://") && writeHost() && writeHyperlinkPath(parent, name, status) && escape() && std.io.print("\\")
}

fn endHyperlink(active: bool) -> bool {
    return !active || escape() && std.io.print("]8;;") && escape() && std.io.print("\\")
}

pub fn write(name: std.string.String, status: std.fs.Stat, parent: std.string.String, options: Options, state: *State) -> bool {
    const colorActive = options.color == 1 || options.color == 2 && options.terminalOutput
    const hyperlinkActive = options.hyperlink == 1 || options.hyperlink == 2 && options.terminalOutput
    const code = if colorActive { colorCode(name, status, options) } else { null }
    if !beginColor(code, state) || !beginHyperlink(parent, name, status, hyperlinkActive) { return false }
    if !names.write(name, options.quoting) { return false }
    return endHyperlink(hyperlinkActive) && endColor(code)
}
