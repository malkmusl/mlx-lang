const std = @import("std")

pub const BUFFER_SIZE: usize = 65536
pub const SPLICE_SIZE: usize = 524288

pub fn isDash(value: std.string.String) -> bool {
    return value.length == 1 && value.pointer[0] == 45
}

pub fn equals(value: std.string.String, expected: []const u8) -> bool {
    return std.string.eql(value, std.string.fromSlice(expected))
}

pub fn writeMessage(program: []const u8, message: []const u8) -> void {
    const first = std.io.writeAll(std.io.stderr(), program)
    const second = std.io.writeAll(std.io.stderr(), ": ")
    const third = std.io.writeAll(std.io.stderr(), message)
    const fourth = std.io.writeAll(std.io.stderr(), "\n")
}

pub fn writeFileError(program: []const u8, path: std.string.String) -> void {
    const first = std.io.writeAll(std.io.stderr(), program)
    const second = std.io.writeAll(std.io.stderr(), ": cannot read '")
    const third = std.io.writeString(std.io.stderr(), path)
    const fourth = std.io.writeAll(std.io.stderr(), "'\n")
}

fn copyBuffered(source: std.fs.File, destination: std.fs.File) -> bool {
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = false
    while true {
        var amount: isize = 0
        unsafe {
            amount = std.fs.read(source, buffer, BUFFER_SIZE)
        }
        if amount < 0 { break }
        if amount == 0 {
            success = true
            break
        }
        const length = @bitCast(usize, amount)
        if !std.fs.writeAllBytes(destination, buffer, length) { break }
    }
    allocator.freeFn(allocator.context, buffer, BUFFER_SIZE, 8)
    return success
}

fn closePipe(pipe: std.fs.Pipe) -> bool {
    const read_closed = std.fs.close(std.fs.File.{ .descriptor = pipe.readDescriptor })
    const write_closed = std.fs.close(std.fs.File.{ .descriptor = pipe.writeDescriptor })
    return read_closed && write_closed
}

fn finishBufferedCopy(source: std.fs.File, read_end: std.fs.File, write_end: std.fs.File, destination: std.fs.File) -> bool {
    const write_closed = std.fs.close(write_end)
    const drained = copyBuffered(read_end, destination)
    const read_closed = std.fs.close(read_end)
    if !drained { return false }
    return copyBuffered(source, destination)
}

fn copySpliced(source: std.fs.File, destination: std.fs.File) -> ?bool {
    const created = std.fs.makePipe()
    if created == null { return null }
    const pipe = created.?
    const read_end = std.fs.File.{ .descriptor = pipe.readDescriptor }
    const write_end = std.fs.File.{ .descriptor = pipe.writeDescriptor }
    const resized = std.fs.setPipeSize(write_end, SPLICE_SIZE)
    var transferred = false
    while true {
        const amount = std.fs.splice(source, write_end, SPLICE_SIZE)
        if amount < 0 {
            const closed = closePipe(pipe)
            if !transferred { return null }
            return false
        }
        if amount == 0 { return closePipe(pipe) }
        transferred = true
        var remaining = @bitCast(usize, amount)
        while remaining > 0 {
            const written = std.fs.splice(read_end, destination, remaining)
            if written <= 0 {
                return finishBufferedCopy(source, read_end, write_end, destination)
            }
            remaining -= @bitCast(usize, written)
        }
    }
    return false
}

pub fn copy(source: std.fs.File, destination: std.fs.File) -> bool {
    const spliced = copySpliced(source, destination)
    if spliced != null { return spliced.? }
    return copyBuffered(source, destination)
}
