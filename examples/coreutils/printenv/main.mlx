const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    zero: bool
    firstName: usize
    action: u8
    invalid: bool
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .zero = false, .firstName = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstName < count {
        const argument = std.process.argument(arguments, result.firstName)
        if common.equals(argument, "--") {
            result.firstName += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "-0") || common.equals(argument, "--null") {
            result.zero = true
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else { result.invalid = true }
        result.firstName += 1
    }
    return result
}

fn writeValue(value: std.string.String, zero: bool) -> bool {
    if !std.io.writeString(std.io.stdout(), value) { return false }
    if !zero { return std.io.print("\n") }
    var terminator: [1]u8 = [1]u8{ 0 }
    unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, terminator[0..1]), 1) }
}

fn writeEnvironment(arguments: [][*]const u8, zero: bool) -> bool {
    const count = std.process.environmentCount(arguments)
    const entries = std.process.environmentEntries(arguments)
    var index: usize = 0
    while index < count {
        if !writeValue(std.process.fromCString(entries[index]), zero) { return false }
        index += 1
    }
    return true
}

fn writeNames(arguments: [][*]const u8, options: Options) -> u8 {
    const count = std.process.count(arguments)
    var status: u8 = 0
    var index = options.firstName
    while index < count {
        const name = std.process.argument(arguments, index)
        const value = std.process.environment(arguments, std.string.asSlice(name))
        if value == null {
            status = 1
        } else if !writeValue(value.?, options.zero) { return 1 }
        index += 1
    }
    return status
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: printenv [OPTION]... [VARIABLE]...\nPrint all or selected environment variables.\n  -0, --null     end each output line with NUL, not newline\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx printenv 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("mlx-printenv", "invalid option")
        return 1
    }
    if options.firstName >= std.process.count(arguments) {
        return if writeEnvironment(arguments, options.zero) { 0 } else { 1 }
    }
    return writeNames(arguments, options)
}
