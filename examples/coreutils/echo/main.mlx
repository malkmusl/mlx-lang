const std = @import("std")

fn isOption(value: std.string.String, expected: []const u8) -> bool {
    return std.string.eql(value, std.string.fromSlice(expected))
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    var index: usize = 1
    var newline = true
    if index < count && isOption(std.process.argument(arguments, index), "-n") {
        newline = false
        index += 1
    }
    var first = true
    while index < count {
        if !first && !std.io.print(" ") { return 1 }
        if !std.io.printString(std.process.argument(arguments, index)) { return 1 }
        first = false
        index += 1
    }
    if newline && !std.io.print("\n") { return 1 }
    return 0
}
