const std = @import("std")

const Options = struct {
    firstArgument: usize
    newline: bool
    escapes: bool
}

const WriteResult = struct {
    success: bool
    stop: bool
}

fn validOption(argument: std.string.String) -> bool {
    if argument.length < 2 || argument.pointer[0] != 45 { return false }
    var index: usize = 1
    while index < argument.length {
        const byte = argument.pointer[index]
        if byte != 110 && byte != 101 && byte != 69 { return false }
        index += 1
    }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .firstArgument = 1, .newline = true, .escapes = false }
    const count = std.process.count(arguments)
    while result.firstArgument < count {
        const argument = std.process.argument(arguments, result.firstArgument)
        if !validOption(argument) { break }
        var index: usize = 1
        while index < argument.length {
            const byte = argument.pointer[index]
            if byte == 110 { result.newline = false }
            if byte == 101 { result.escapes = true }
            if byte == 69 { result.escapes = false }
            index += 1
        }
        result.firstArgument += 1
    }
    return result
}

fn writeByte(byte: u8) -> bool {
    var buffer: [1]u8 = [1]u8{ 0 }
    buffer[0] = byte
    unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, buffer[0..1]), 1) }
}

fn hexDigit(byte: u8) -> usize {
    if byte >= 48 && byte <= 57 { return @intCast(usize, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(usize, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(usize, byte - 55) }
    return 16
}

fn controlEscape(byte: u8) -> usize {
    if byte == 97 { return 7 }
    if byte == 98 { return 8 }
    if byte == 101 { return 27 }
    if byte == 102 { return 12 }
    if byte == 110 { return 10 }
    if byte == 114 { return 13 }
    if byte == 116 { return 9 }
    if byte == 118 { return 11 }
    if byte == 92 { return 92 }
    return 256
}

fn writeNumeric(value: std.string.String, index: *usize, base: usize, maximum: usize) -> bool {
    var result: usize = 0
    var digits: usize = 0
    while index.* < value.length && digits < maximum {
        const digit = hexDigit(value.pointer[index.*])
        if digit >= base { break }
        result = result * base + digit
        index.* += 1
        digits += 1
    }
    if digits == 0 { return false }
    return writeByte(@intCast(u8, result & 255))
}

fn writeEscaped(value: std.string.String) -> WriteResult {
    var index: usize = 0
    while index < value.length {
        const byte = value.pointer[index]
        index += 1
        if byte != 92 || index >= value.length {
            if !writeByte(byte) { return WriteResult.{ .success = false, .stop = false } }
        } else {
            const escape = value.pointer[index]
            index += 1
            if escape == 99 { return WriteResult.{ .success = true, .stop = true } }
            const control = controlEscape(escape)
            if control < 256 {
                if !writeByte(@intCast(u8, control)) { return WriteResult.{ .success = false, .stop = false } }
            } else if escape == 48 {
                if !writeNumeric(value, &index, 8, 3) { if !writeByte(0) { return WriteResult.{ .success = false, .stop = false } } }
            } else if escape == 120 {
                if !writeNumeric(value, &index, 16, 2) {
                    if !writeByte(92) || !writeByte(120) { return WriteResult.{ .success = false, .stop = false } }
                }
            } else if !writeByte(92) || !writeByte(escape) { return WriteResult.{ .success = false, .stop = false } }
        }
    }
    return WriteResult.{ .success = true, .stop = false }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    const count = std.process.count(arguments)
    var index = options.firstArgument
    while index < count {
        if index > options.firstArgument && !std.io.print(" ") { return 1 }
        const argument = std.process.argument(arguments, index)
        if options.escapes {
            const written = writeEscaped(argument)
            if !written.success { return 1 }
            if written.stop { return 0 }
        } else if !std.io.printString(argument) { return 1 }
        index += 1
    }
    if options.newline && !std.io.print("\n") { return 1 }
    return 0
}
