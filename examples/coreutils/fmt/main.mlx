const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    width: usize
    uniform: bool
    splitOnly: bool
    action: u8
    invalid: bool
    firstFile: usize
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 }

fn isDigit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .width = 75, .uniform = false, .splitOnly = false, .action = 0, .invalid = false, .firstFile = 1 }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 || common.isDash(argument) { break }
        if common.equals(argument, "--help") {
            result.action = 1
            index += 1
            continue
        }
        if common.equals(argument, "--version") {
            result.action = 2
            index += 1
            continue
        }
        if common.equals(argument, "-u") || common.equals(argument, "--uniform-spacing") {
            result.uniform = true
            index += 1
            continue
        }
        if common.equals(argument, "-s") || common.equals(argument, "--split-only") {
            result.splitOnly = true
            index += 1
            continue
        }
        if common.equals(argument, "-c") || common.equals(argument, "--crown-margin") || common.equals(argument, "-t") || common.equals(argument, "--tagged-paragraph") {
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--prefix=")) {
            index += 1
            continue
        }
        if common.equals(argument, "-p") || common.equals(argument, "--prefix") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--goal=")) {
            index += 1
            continue
        }
        if common.equals(argument, "-g") || common.equals(argument, "--goal") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            index += 1
            continue
        }
        if std.string.startsWith(argument, std.string.fromSlice("--width=")) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 8, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.width = parsed.value }
            index += 1
            continue
        }
        if common.equals(argument, "-w") || common.equals(argument, "--width") {
            index += 1
            if index >= count {
                result.invalid = true
                break
            }
            const parsed = std.parse.unsigned(std.process.argument(arguments, index))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.width = parsed.value }
            index += 1
            continue
        }
        if isDigit(argument.pointer[1]) {
            const parsed = std.parse.unsigned(std.string.slice(argument, 1, argument.length))
            if !parsed.valid || parsed.value == 0 { result.invalid = true } else { result.width = parsed.value }
            index += 1
            continue
        }
        result.invalid = true
        index += 1
    }
    result.firstFile = index
    return result
}

fn lineIsBlank(ptr: [*]const u8, start: usize, end: usize) -> bool {
    var i = start
    while i < end {
        if !isSpace(ptr[i]) { return false }
        i += 1
    }
    return true
}

fn writeSpan(file: std.fs.File, ptr: [*]const u8, start: usize, end: usize) -> bool {
    if end <= start { return true }
    unsafe { return std.io.writeAllBytes(file, @ptrFromInt([*]const u8, @intFromPtr(ptr) + start), end - start) }
}

fn writeSpaces(file: std.fs.File, count: usize) -> bool {
    var i: usize = 0
    while i < count {
        if !std.io.writeAll(file, " ") { return false }
        i += 1
    }
    return true
}

fn endsSentence(ptr: [*]const u8, wordEnd: usize) -> bool {
    if wordEnd == 0 { return false }
    const last = ptr[wordEnd - 1]
    return last == 46 || last == 33 || last == 63
}

fn reflowParagraph(file: std.fs.File, options: Options, ptr: [*]const u8, lineStarts: [*]usize, lineEnds: [*]usize, paraStart: usize, paraEnd: usize) -> bool {
    var indentEnd = lineStarts[paraStart]
    while indentEnd < lineEnds[paraStart] && isSpace(ptr[indentEnd]) { indentEnd += 1 }
    const indentStart = lineStarts[paraStart]
    const indentWidth = indentEnd - indentStart

    var ok = true
    var column: usize = 0
    var started = false
    var li = paraStart
    while li < paraEnd && ok {
        var pos = lineStarts[li]
        const end = lineEnds[li]
        while pos < end && ok {
            while pos < end && isSpace(ptr[pos]) { pos += 1 }
            if pos >= end { break }
            const wordStart = pos
            while pos < end && !isSpace(ptr[pos]) { pos += 1 }
            const wordEnd = pos
            const wordLen = wordEnd - wordStart
            if !started {
                if !writeSpan(file, ptr, indentStart, indentEnd) { ok = false }
                if ok && !writeSpan(file, ptr, wordStart, wordEnd) { ok = false }
                column = indentWidth + wordLen
                started = true
            } else {
                const sep: usize = if options.uniform && endsSentence(ptr, lastWordEnd(ptr, wordStart)) { 2 } else { 1 }
                if column + sep + wordLen <= options.width {
                    if !writeSpaces(file, sep) { ok = false }
                    if ok && !writeSpan(file, ptr, wordStart, wordEnd) { ok = false }
                    column += sep + wordLen
                } else {
                    if !std.io.writeAll(file, "\n") { ok = false }
                    if ok && !writeSpan(file, ptr, indentStart, indentEnd) { ok = false }
                    if ok && !writeSpan(file, ptr, wordStart, wordEnd) { ok = false }
                    column = indentWidth + wordLen
                }
            }
        }
        li += 1
    }
    if ok && started { ok = std.io.writeAll(file, "\n") }
    return ok
}

fn lastWordEnd(ptr: [*]const u8, beforePos: usize) -> usize {
    var i = beforePos
    while i > 0 && isSpace(ptr[i - 1]) { i -= 1 }
    return i
}

fn splitLine(file: std.fs.File, options: Options, ptr: [*]const u8, start: usize, end: usize) -> bool {
    if end - start <= options.width { return writeSpan(file, ptr, start, end) && std.io.writeAll(file, "\n") }
    var indentEnd = start
    while indentEnd < end && isSpace(ptr[indentEnd]) { indentEnd += 1 }
    const indentWidth = indentEnd - start
    var ok = true
    var column: usize = 0
    var started = false
    var pos = start
    while pos < end && ok {
        while pos < end && isSpace(ptr[pos]) { pos += 1 }
        if pos >= end { break }
        const wordStart = pos
        while pos < end && !isSpace(ptr[pos]) { pos += 1 }
        const wordEnd = pos
        const wordLen = wordEnd - wordStart
        if !started {
            if !writeSpan(file, ptr, start, indentEnd) { ok = false }
            if ok && !writeSpan(file, ptr, wordStart, wordEnd) { ok = false }
            column = indentWidth + wordLen
            started = true
        } else {
            const sep: usize = if options.uniform && endsSentence(ptr, lastWordEnd(ptr, wordStart)) { 2 } else { 1 }
            if column + sep + wordLen <= options.width {
                if !writeSpaces(file, sep) { ok = false }
                if ok && !writeSpan(file, ptr, wordStart, wordEnd) { ok = false }
                column += sep + wordLen
            } else {
                if !std.io.writeAll(file, "\n") { ok = false }
                if ok && !writeSpan(file, ptr, start, indentEnd) { ok = false }
                if ok && !writeSpan(file, ptr, wordStart, wordEnd) { ok = false }
                column = indentWidth + wordLen
            }
        }
    }
    if ok && started { ok = std.io.writeAll(file, "\n") }
    return ok
}

fn processData(options: Options, ptr: [*]const u8, length: usize) -> bool {
    if length == 0 { return true }
    var lineCount: usize = 0
    var i: usize = 0
    while i < length {
        if ptr[i] == 10 { lineCount += 1 }
        i += 1
    }
    if length > 0 && ptr[length - 1] != 10 { lineCount += 1 }
    if lineCount == 0 { return true }

    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const startAlloc = allocator.alloc(lineCount * 8, 8)
    const endAlloc = allocator.alloc(lineCount * 8, 8)
    var starts: [*]usize = undefined
    var ends: [*]usize = undefined
    unsafe {
        starts = @ptrCast([*]usize, startAlloc.?)
        ends = @ptrCast([*]usize, endAlloc.?)
    }
    var idx: usize = 0
    var lineStart: usize = 0
    i = 0
    while i < length {
        if ptr[i] == 10 {
            starts[idx] = lineStart
            ends[idx] = i
            idx += 1
            lineStart = i + 1
        }
        i += 1
    }
    if lineStart < length {
        starts[idx] = lineStart
        ends[idx] = length
        idx += 1
    }

    const stdout = std.io.stdout()
    var ok = true

    if options.splitOnly {
        var li: usize = 0
        while li < lineCount && ok {
            if lineIsBlank(ptr, starts[li], ends[li]) {
                ok = std.io.writeAll(stdout, "\n")
            } else {
                ok = splitLine(stdout, options, ptr, starts[li], ends[li])
            }
            li += 1
        }
        return ok
    }

    var li: usize = 0
    while li < lineCount && ok {
        if lineIsBlank(ptr, starts[li], ends[li]) {
            ok = std.io.writeAll(stdout, "\n")
            li += 1
            continue
        }
        var paraEnd = li
        while paraEnd < lineCount && !lineIsBlank(ptr, starts[paraEnd], ends[paraEnd]) { paraEnd += 1 }
        ok = reflowParagraph(stdout, options, ptr, starts, ends, li, paraEnd)
        li = paraEnd
    }
    return ok
}

fn readAll(path: std.string.String, ok: *bool) -> std.fs.ArrayList {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if common.isDash(path) {
        ok.* = true
        return std.fs.readToEndAlloc(std.io.stdin(), allocator)
    }
    const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        common.writeFileError("fmt", path)
        ok.* = false
        return std.array_list.ArrayList.init(allocator, 0)
    }
    ok.* = true
    const data = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return data
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: fmt [-WIDTH] [OPTION]... [FILE]...\nReformat each paragraph in the FILE(s), writing to standard output.\n  -s, --split-only        split long lines, but do not refill\n  -u, --uniform-spacing   one space between words, two after sentences\n  -w, --width=WIDTH       maximum line width (default of 75 columns)\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx fmt 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("fmt", "invalid option")
        return 1
    }
    const count = std.process.count(arguments)
    var status: u8 = 0
    if options.firstFile >= count {
        var opened = false
        const data = readAll(std.string.fromSlice("-"), &opened)
        if !opened { return 1 }
        unsafe {
            if !processData(options, @ptrCast([*]const u8, data.items), data.length) { status = 1 }
        }
        data.deinit()
        return status
    }
    var index = options.firstFile
    while index < count {
        var opened = false
        const data = readAll(std.process.argument(arguments, index), &opened)
        if opened {
            unsafe {
                if !processData(options, @ptrCast([*]const u8, data.items), data.length) { status = 1 }
            }
        } else {
            status = 1
        }
        data.deinit()
        index += 1
    }
    return status
}
