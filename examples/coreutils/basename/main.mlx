const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    multiple: bool
    zero: bool
    suffix: std.string.String
    firstOperand: usize
    action: u8
    invalid: bool
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--multiple") {
        options.*.multiple = true
        return true
    }
    if common.equals(argument, "--zero") {
        options.*.zero = true
        return true
    }
    if common.equals(argument, "--help") {
        options.*.action = 1
        return true
    }
    if common.equals(argument, "--version") {
        options.*.action = 2
        return true
    }
    if std.string.startsWith(argument, std.string.fromSlice("--suffix=")) {
        options.*.suffix = std.string.slice(argument, 9, argument.length)
        options.*.multiple = true
        return true
    }
    if !common.equals(argument, "--suffix") { return false }
    index.* += 1
    if index.* >= std.process.count(arguments) { return false }
    options.*.suffix = std.process.argument(arguments, index.*)
    options.*.multiple = true
    return true
}

fn parseShort(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    var current: usize = 1
    while current < argument.length {
        const option = argument.pointer[current]
        if option == 97 {
            options.*.multiple = true
        } else if option == 122 {
            options.*.zero = true
        } else if option == 115 {
            var suffix = std.string.slice(argument, current + 1, argument.length)
            if suffix.length == 0 {
                index.* += 1
                if index.* >= std.process.count(arguments) { return false }
                suffix = std.process.argument(arguments, index.*)
            }
            options.*.suffix = suffix
            options.*.multiple = true
            return true
        } else { return false }
        current += 1
    }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .multiple = false, .zero = false, .suffix = std.string.fromSlice(""), .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(arguments, &index, argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn baseName(path: std.string.String) -> std.string.String {
    if path.length == 0 { return path }
    var end = path.length
    while end > 1 && path.pointer[end - 1] == 47 { end -= 1 }
    if end == 1 && path.pointer[0] == 47 { return std.string.slice(path, 0, 1) }
    var start = end
    while start > 0 && path.pointer[start - 1] != 47 { start -= 1 }
    return std.string.slice(path, start, end)
}

fn stripSuffix(name: std.string.String, suffix: std.string.String) -> std.string.String {
    if suffix.length == 0 || suffix.length >= name.length || !std.string.endsWith(name, suffix) { return name }
    return std.string.slice(name, 0, name.length - suffix.length)
}

fn writeName(path: std.string.String, suffix: std.string.String, zero: bool) -> bool {
    const name = stripSuffix(baseName(path), suffix)
    if !std.io.writeString(std.io.stdout(), name) { return false }
    if !zero { return std.io.print("\n") }
    var terminator: [1]u8 = [1]u8{ 0 }
    unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, terminator[0..1]), 1) }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: basename NAME [SUFFIX]\n  or:  basename OPTION... NAME...\n  -a, --multiple       support multiple arguments\n  -s, --suffix=SUFFIX  remove a trailing SUFFIX; implies -a\n  -z, --zero           end each output line with NUL, not newline\n      --help            display this help and exit\n      --version         output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx basename 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    const operands = count - options.firstOperand
    if options.invalid || operands == 0 || !options.multiple && operands > 2 {
        common.writeMessage(basename", "missing, extra, or invalid operand")
        return 1
    }
    const suffix = if !options.multiple && operands == 2 { std.process.argument(arguments, options.firstOperand + 1) } else { options.suffix }
    const end = if !options.multiple && operands == 2 { count - 1 } else { count }
    var index = options.firstOperand
    while index < end {
        if !writeName(std.process.argument(arguments, index), suffix, options.zero) { return 1 }
        index += 1
    }
    return 0
}
