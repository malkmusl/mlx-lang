const std = @import("std")
const common = @import("../common.mlx")

pub const Options = struct {
    modeText: std.string.String
    referenceMode: usize
    useReference: bool
    recursive: bool
    traversalMode: u8
    noDereference: bool
    preserveRoot: bool
    report: u8
    silent: bool
}

fn isDirectory(status: std.fs.Stat) -> bool { return status.mode & 61440 == 16384 }
fn isSymbolicLink(status: std.fs.Stat) -> bool { return status.mode & 61440 == 40960 }

fn targetMode(status: std.fs.Stat, options: Options) -> std.mode.Result {
    if options.useReference { return std.mode.Result.{ .value = options.referenceMode, .valid = true } }
    return std.mode.parse(options.modeText, @intCast(usize, status.mode & 4095), isDirectory(status), true)
}

fn report(path: std.string.String, changed: bool, options: Options) -> void {
    if options.report == 0 || options.report == 1 && !changed { return }
    const first = std.io.print(if changed { "mode changed for '" } else { "mode retained for '" })
    const second = std.io.printString(path)
    const third = std.io.print("'\n")
}

fn reportError(path: std.string.String, options: Options) -> void {
    if !options.silent { common.writePathError("chmod", "cannot change mode of", path) }
}

fn applyAt(directory: std.fs.File, name: std.string.String, path: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    const parsed = targetMode(status, options)
    if !parsed.valid { return false }
    const previous = @intCast(usize, status.mode & 4095)
    if !std.fs.chmodAt(directory, name.pointer, parsed.value) { return false }
    report(path, previous != parsed.value, options)
    return true
}

fn changeDirectoryContents(directory: std.fs.File, path: std.string.String, options: Options) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = true
    var reader = std.fs.entries(directory, buffer, common.BUFFER_SIZE)
    var entry: std.fs.Entry = undefined
    while std.fs.nextEntry(&reader, &entry) {
        if !std.fs.isDotName(entry.name) && !changeEntry(directory, entry.name, path, options) { success = false }
    }
    if reader.failed { success = false }
    allocator.free(buffer, common.BUFFER_SIZE, 8)
    return success
}

fn changeDirectoryAt(parent: std.fs.File, name: std.string.String, path: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    const directory = std.fs.openAt(parent, name.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY | std.fs.NO_FOLLOW, 0)
    if !std.fs.isValid(directory) { return false }
    const changed = applyAt(parent, name, path, status, options)
    const traversed = changed && changeDirectoryContents(directory, path, options)
    const closed = std.fs.close(directory)
    return changed && traversed && closed
}

fn changeEntry(parent: std.fs.File, name: std.string.String, parent_path: std.string.String, options: Options) -> bool {
    const joined = std.path.join(parent_path, name)
    if joined == null { return false }
    const owned = joined.?
    const path = std.string.fromParts(owned.pointer, owned.length)
    var status: std.fs.Stat = undefined
    const status_result = std.fs.statusFrom(parent, name.pointer, &status, true)
    var changed = false
    if status_result == 0 && isSymbolicLink(status) { changed = true } else if status_result == 0 && isDirectory(status) {
        changed = changeDirectoryAt(parent, name, path, status, options)
    } else if status_result == 0 { changed = applyAt(parent, name, path, status, options) }
    if !changed { reportError(path, options) }
    std.path.free(owned)
    return changed
}

fn isRoot(status: std.fs.Stat) -> bool {
    
    var root: std.fs.Stat = undefined
    unsafe { return std.fs.status(@ptrCast([*]const u8, "/"), &root) == 0 && root.device == status.device && root.inode == status.inode }
}

fn applyTop(path: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    const parsed = targetMode(status, options)
    if !parsed.valid || !std.fs.chmod(path.pointer, parsed.value) { return false }
    report(path, @intCast(usize, status.mode & 4095) != parsed.value, options)
    return true
}

fn changeTopDirectory(path: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    if options.preserveRoot && isRoot(status) { return false }
    const directory = std.fs.open(path.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(directory) { return false }
    const changed = applyTop(path, status, options)
    const traversed = changed && changeDirectoryContents(directory, path, options)
    const closed = std.fs.close(directory)
    return changed && traversed && closed
}

pub fn change(path: std.string.String, options: Options) -> bool {
    var direct: std.fs.Stat = undefined
    if std.fs.statusAt(path.pointer, &direct, true) != 0 {
        reportError(path, options)
        return false
    }
    if isSymbolicLink(direct) && (options.noDereference || options.recursive && options.traversalMode == 2) {
        report(path, false, options)
        return true
    }
    var status = direct
    if isSymbolicLink(direct) && std.fs.status(path.pointer, &status) != 0 {
        reportError(path, options)
        return false
    }
    const changed = if options.recursive && isDirectory(status) { changeTopDirectory(path, status, options) } else { applyTop(path, status, options) }
    if !changed { reportError(path, options) }
    return changed
}
