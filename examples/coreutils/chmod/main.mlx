const std = @import("std")
const common = @import("../common.mlx")
const traversal = @import("./traversal.mlx")

const Options = struct {
    recursive: bool
    noDereference: bool
    preserveRoot: bool
    traversalMode: u8
    report: u8
    silent: bool
    reference: std.string.String
    referenceSet: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn parseShort(argument: std.string.String, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        const byte = argument.pointer[index]
        if byte == 99 { options.*.report = 1 } else if byte == 102 { options.*.silent = true } else if byte == 118 {
            options.*.report = 2
        } else if byte == 104 { options.*.noDereference = true } else if byte == 82 { options.*.recursive = true } else if byte == 72 {
            options.*.traversalMode = 0
        } else if byte == 76 { options.*.traversalMode = 1 } else if byte == 80 { options.*.traversalMode = 2 } else { return false }
        index += 1
    }
    return true
}

fn consumeReference(arguments: [][*]const u8, index: *usize, value: std.string.String, options: *Options) -> bool {
    var reference = value
    if reference.length == 0 {
        index.* += 1
        if index.* >= std.process.count(arguments) { return false }
        reference = std.process.argument(arguments, index.*)
    }
    options.*.reference = reference
    options.*.referenceSet = true
    return true
}

fn parseLong(arguments: [][*]const u8, index: *usize, argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--changes") { options.*.report = 1 } else if common.equals(argument, "--silent") || common.equals(argument, "--quiet") {
        options.*.silent = true
    } else if common.equals(argument, "--verbose") { options.*.report = 2 } else if common.equals(argument, "--dereference") { options.*.noDereference = false } else if common.equals(argument, "--no-dereference") {
        options.*.noDereference = true
    } else if common.equals(argument, "--recursive") { options.*.recursive = true } else if common.equals(argument, "--preserve-root") { options.*.preserveRoot = true } else if common.equals(argument, "--no-preserve-root") {
        options.*.preserveRoot = false
    } else if common.equals(argument, "--reference") { return consumeReference(arguments, index, std.string.fromSlice(""), options) } else if std.string.startsWith(argument, std.string.fromSlice("--reference=")) {
        const value = std.string.slice(argument, 12, argument.length)
        if value.length == 0 { return false }
        return consumeReference(arguments, index, value, options)
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") { options.*.action = 2 } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .recursive = false, .noDereference = false, .preserveRoot = false, .traversalMode = 0, .report = 0, .silent = false, .reference = std.string.fromSlice(""), .referenceSet = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    var index: usize = 1
    while index < count {
        const argument = std.process.argument(arguments, index)
        if common.equals(argument, "--") {
            index += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(arguments, &index, argument, &result) } else { parseShort(argument, &result) }
        if !valid { result.invalid = true }
        index += 1
    }
    result.firstOperand = index
    return result
}

fn makeTraversalOptions(options: Options, mode_text: std.string.String, reference_mode: usize) -> traversal.Options {
    return traversal.Options.{ .modeText = mode_text, .referenceMode = reference_mode, .useReference = options.referenceSet, .recursive = options.recursive, .traversalMode = options.traversalMode, .noDereference = options.noDereference, .preserveRoot = options.preserveRoot, .report = options.report, .silent = options.silent }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: chmod [OPTION]... MODE FILE...\n  -c, --changes       report changed files\n  -f, --silent        suppress errors\n  -h, --no-dereference\n  -v, --verbose       report every file\n  -R, --recursive     change directories recursively\n      --reference=FILE\n      --[no-]preserve-root\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx chmod 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.recursive && options.traversalMode == 1 {
        common.writeMessage("mlx-chmod", "invalid or unsafe option combination")
        return 1
    }
    var reference_mode: usize = 0
    if options.referenceSet {
        var reference_status: std.fs.Stat = undefined
        if std.fs.status(options.reference.pointer, &reference_status) != 0 {
            common.writePathError("mlx-chmod", "cannot stat", options.reference)
            return 1
        }
        reference_mode = @intCast(usize, reference_status.mode & 4095)
    }
    const mode_index = options.firstOperand
    const file_index = if options.referenceSet { mode_index } else { mode_index + 1 }
    if file_index >= count {
        common.writeMessage("mlx-chmod", "missing mode or file operand")
        return 1
    }
    const mode_text = if options.referenceSet { std.string.fromSlice("") } else { std.process.argument(arguments, mode_index) }
    const settings = makeTraversalOptions(options, mode_text, reference_mode)
    var success = true
    var index = file_index
    while index < count {
        if !traversal.change(std.process.argument(arguments, index), settings) { success = false }
        index += 1
    }
    return if success { 0 } else { 1 }
}
