const std = @import("std")
const common = @import("../common.mlx")

pub const Options = struct {
    recursive: bool
    directories: bool
    force: bool
    verbose: bool
    promptAlways: bool
    oneFileSystem: bool
    preserveRoot: bool
}

fn isDirectory(status: std.fs.Stat) -> bool {
    return status.mode & 61440 == 16384
}

fn isDotEntry(name: std.string.String) -> bool {
    if name.length == 1 { return name.pointer[0] == 46 }
    return name.length == 2 && name.pointer[0] == 46 && name.pointer[1] == 46
}

fn entryName(buffer: [*]u8, offset: usize, record_length: usize) -> std.string.String {
    var length: usize = 0
    while 19 + length < record_length && buffer[offset + 19 + length] != 0 { length += 1 }
    unsafe { return std.string.fromParts(@ptrFromInt([*]const u8, @intFromPtr(buffer) + offset + 19), length) }
}

fn report(path: std.string.String, directory: bool, verbose: bool) -> void {
    if !verbose { return }
    const first = if directory { std.io.print("removed directory '") } else { std.io.print("removed '") }
    const second = std.io.printString(path)
    const third = std.io.print("'\n")
}

fn readConfirmation() -> bool {
    var byte: [1]u8 = [1]u8{ 0 }
    var answer: u8 = 0
    while true {
        var amount: isize = 0
        unsafe { amount = std.fs.read(std.io.stdin(), @ptrCast([*]u8, byte[0..1]), 1) }
        if amount <= 0 || byte[0] == 10 { break }
        if answer == 0 { answer = byte[0] }
    }
    return answer == 121 || answer == 89
}

pub fn confirm(path: std.string.String, directory: bool) -> bool {
    const first = std.io.eprint(if directory { "rm: descend into/remove directory '" } else { "rm: remove file '" })
    const second = std.io.writeString(std.io.stderr(), path)
    const third = std.io.eprint("'? ")
    return readConfirmation()
}

pub fn confirmBatch(count: usize, recursive: bool) -> bool {
    const first = std.io.eprint("rm: remove ")
    const second = std.io.writeUnsigned(std.io.stderr(), count)
    const third = std.io.eprint(if recursive { " arguments recursively? " } else { " arguments? " })
    return readConfirmation()
}

fn removeDirectoryContents(directory: std.fs.File, path: std.string.String, root_device: usize, options: Options) -> bool {
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = true
    while success {
        const amount = std.fs.readDirectory(directory, buffer, common.BUFFER_SIZE)
        if amount < 0 {
            success = false
            break
        }
        if amount == 0 { break }
        var offset: usize = 0
        const length = @bitCast(usize, amount)
        while offset < length {
            const record_length = @intCast(usize, std.mem.readU16Little(buffer, offset + 16))
            if record_length < 20 || offset + record_length > length {
                success = false
                break
            }
            const name = entryName(buffer, offset, record_length)
            if !isDotEntry(name) && !removeEntry(directory, name, path, root_device, options) { success = false }
            offset += record_length
        }
    }
    allocator.freeFn(allocator.context, buffer, common.BUFFER_SIZE, 8)
    return success
}

fn removeDirectoryAt(parent: std.fs.File, name: std.string.String, path: std.string.String, status: std.fs.Stat, root_device: usize, options: Options) -> bool {
    if options.oneFileSystem && status.device != root_device { return false }
    if options.promptAlways && !confirm(path, true) { return true }
    const directory = std.fs.openAt(parent, name.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY | std.fs.NO_FOLLOW, 0)
    if !std.fs.isValid(directory) { return false }
    const emptied = removeDirectoryContents(directory, path, root_device, options)
    const closed = std.fs.close(directory)
    if !emptied || !closed || !std.fs.deleteAt(parent, name.pointer, true) { return false }
    report(path, true, options.verbose)
    return true
}

fn removeEntry(parent: std.fs.File, name: std.string.String, parent_path: std.string.String, root_device: usize, options: Options) -> bool {
    const joined = std.path.join(parent_path, name)
    if joined == null { return false }
    const owned = joined.?
    const path = std.string.fromParts(owned.pointer, owned.length)
    var status: std.fs.Stat = undefined
    const status_result = std.fs.statusFrom(parent, name.pointer, &status, true)
    var removed = options.force && status_result == -2
    if status_result == 0 && isDirectory(status) {
        removed = removeDirectoryAt(parent, name, path, status, root_device, options)
    } else if status_result == 0 && (!options.promptAlways || confirm(path, false)) {
        removed = std.fs.deleteAt(parent, name.pointer, false)
        if removed { report(path, false, options.verbose) }
    } else if status_result == 0 { removed = true }
    if !removed { common.writePathError("rm", "cannot remove", path) }
    std.path.free(owned)
    return removed
}

fn isRoot(status: std.fs.Stat) -> bool {
    var root: std.fs.Stat = undefined
    return std.fs.status(@ptrCast([*]const u8, "/"), &root) == 0 && root.device == status.device && root.inode == status.inode
}

fn removeTopDirectory(path: std.string.String, status: std.fs.Stat, options: Options) -> bool {
    if options.preserveRoot && isRoot(status) { return false }
    if !options.recursive {
        if !options.directories { return false }
        if options.promptAlways && !confirm(path, true) { return true }
        const removed = std.fs.removeDir(path.pointer)
        if removed { report(path, true, options.verbose) }
        return removed
    }
    if options.promptAlways && !confirm(path, true) { return true }
    const directory = std.fs.open(path.pointer, std.fs.READ_ONLY | std.fs.DIRECTORY | std.fs.NO_FOLLOW, 0)
    if !std.fs.isValid(directory) { return false }
    const emptied = removeDirectoryContents(directory, path, status.device, options)
    const closed = std.fs.close(directory)
    if !emptied || !closed || !std.fs.removeDir(path.pointer) { return false }
    report(path, true, options.verbose)
    return true
}

pub fn remove(path: std.string.String, options: Options) -> bool {
    const name = std.path.basename(path)
    if isDotEntry(name) { return false }
    var status: std.fs.Stat = undefined
    const result = std.fs.statusAt(path.pointer, &status, true)
    if result != 0 { return options.force && result == -2 }
    if isDirectory(status) { return removeTopDirectory(path, status, options) }
    if options.promptAlways && !confirm(path, false) { return true }
    const removed = std.fs.delete(path.pointer)
    if removed { report(path, false, options.verbose) }
    return removed
}
