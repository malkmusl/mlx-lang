const std = @import("std")
const common = @import("../common.mlx")
const traversal = @import("./traversal.mlx")

const Options = struct {
    recursive: bool
    directories: bool
    force: bool
    verbose: bool
    prompt: u8
    oneFileSystem: bool
    preserveRoot: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn parseShort(argument: std.string.String, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        const byte = argument.pointer[index]
        if byte == 100 { options.*.directories = true } else if byte == 102 {
            options.*.force = true
            options.*.prompt = 0
        } else if byte == 105 {
            options.*.force = false
            options.*.prompt = 2
        } else if byte == 73 {
            options.*.force = false
            options.*.prompt = 1
        } else if byte == 114 || byte == 82 { options.*.recursive = true } else if byte == 118 {
            options.*.verbose = true
        } else { return false }
        index += 1
    }
    return true
}

fn setInteractive(argument: std.string.String, options: *Options) -> bool {
    options.*.force = false
    if common.equals(argument, "--interactive") || common.equals(argument, "--interactive=always") {
        options.*.prompt = 2
    } else if common.equals(argument, "--interactive=once") {
        options.*.prompt = 1
    } else if common.equals(argument, "--interactive=never") {
        options.*.prompt = 0
    } else { return false }
    return true
}

fn parseLong(argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--dir") { options.*.directories = true } else if common.equals(argument, "--force") {
        options.*.force = true
        options.*.prompt = 0
    } else if std.string.startsWith(argument, std.string.fromSlice("--interactive")) {
        return setInteractive(argument, options)
    } else if common.equals(argument, "--recursive") { options.*.recursive = true } else if common.equals(argument, "--verbose") {
        options.*.verbose = true
    } else if common.equals(argument, "--one-file-system") { options.*.oneFileSystem = true } else if common.equals(argument, "--no-preserve-root") {
        options.*.preserveRoot = false
    } else if common.equals(argument, "--preserve-root") || common.equals(argument, "--preserve-root=all") {
        options.*.preserveRoot = true
    } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") {
        options.*.action = 2
    } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .recursive = false, .directories = false, .force = false, .verbose = false, .prompt = 0, .oneFileSystem = false, .preserveRoot = true, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstOperand < count {
        const argument = std.process.argument(arguments, result.firstOperand)
        if common.equals(argument, "--") {
            result.firstOperand += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(argument, &result) } else { parseShort(argument, &result) }
        if !valid { result.invalid = true }
        result.firstOperand += 1
    }
    return result
}

fn removalOptions(options: Options) -> traversal.Options {
    return traversal.Options.{ .recursive = options.recursive, .directories = options.directories, .force = options.force, .verbose = options.verbose, .promptAlways = options.prompt == 2, .oneFileSystem = options.oneFileSystem, .preserveRoot = options.preserveRoot }
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: rm [OPTION]... [FILE]...\n  -f, --force       ignore missing files\n  -i                 prompt before every removal\n  -I                 prompt once for large or recursive removals\n  -d, --dir          remove empty directories\n  -r, -R, --recursive  remove directories recursively\n  -v, --verbose      explain what is being done\n      --one-file-system\n      --[no-]preserve-root\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx rm 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstOperand >= count {
        if options.force && !options.invalid { return 0 }
        common.writeMessage("mlx-rm", "missing operand or unsupported option")
        return 1
    }
    const operand_count = count - options.firstOperand
    if options.prompt == 1 && (options.recursive || operand_count > 3) && !traversal.confirmBatch(operand_count, options.recursive) { return 0 }
    const settings = removalOptions(options)
    var success = true
    var index = options.firstOperand
    while index < count {
        const path = std.process.argument(arguments, index)
        if !traversal.remove(path, settings) {
            common.writePathError("mlx-rm", "cannot remove", path)
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
