const std = @import("std")
const common = @import("../common.mlx")

const Options = struct {
    append: bool
    ignoreInterrupts: bool
    outputError: u8
    firstFile: usize
    action: u8
    invalid: bool
}

const Output = struct {
    file: std.fs.File
    name: std.string.String
    owned: bool
    active: bool
}

const Outputs = struct {
    items: [*]Output
    length: usize
    bytes: usize
    opened: bool
}

const ChunkResult = struct {
    success: bool
    stop: bool
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .append = false, .ignoreInterrupts = false, .outputError = 0, .firstFile = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstFile < count {
        const argument = std.process.argument(arguments, result.firstFile)
        if common.equals(argument, "--") {
            result.firstFile += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        if common.equals(argument, "--append") { result.append = true } else if common.equals(argument, "--ignore-interrupts") {
            result.ignoreInterrupts = true
        } else if common.equals(argument, "--output-error") { result.outputError = 2 } else if std.string.startsWith(argument, std.string.fromSlice("--output-error=")) {
            const mode = std.string.slice(argument, 15, argument.length)
            if common.equals(mode, "warn") { result.outputError = 1 } else if common.equals(mode, "warn-nopipe") {
                result.outputError = 2
            } else if common.equals(mode, "exit") { result.outputError = 3 } else if common.equals(mode, "exit-nopipe") {
                result.outputError = 4
            } else { result.invalid = true }
        } else if common.equals(argument, "--help") {
            result.action = 1
        } else if common.equals(argument, "--version") {
            result.action = 2
        } else if argument.pointer[1] != 45 {
            var index: usize = 1
            while index < argument.length {
                const option = argument.pointer[index]
                if option == 97 { result.append = true } else if option == 105 {
                    result.ignoreInterrupts = true
                } else if option == 112 { result.outputError = 2 } else { result.invalid = true }
                index += 1
            }
        } else { result.invalid = true }
        result.firstFile += 1
    }
    return result
}

fn outputFlags(append: bool) -> usize {
    return std.fs.WRITE_ONLY | std.fs.CREATE | if append { std.fs.APPEND } else { std.fs.TRUNCATE }
}

fn openOutputs(arguments: [][*]const u8, options: Options) -> ?Outputs {
    const count = std.process.count(arguments) - options.firstFile + 1
    const bytes = count * @sizeOf(Output)
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, bytes, @alignOf(Output))
    if allocation == null { return null }
    var items: [*]Output = undefined
    unsafe { items = @ptrCast([*]Output, allocation.?) }
    items[0] = Output.{ .file = std.io.stdout(), .name = std.string.fromSlice("standard output"), .owned = false, .active = true }
    var opened = true
    var index: usize = 1
    while index < count {
        const name = std.process.argument(arguments, options.firstFile + index - 1)
        const file = std.fs.open(name.pointer, outputFlags(options.append), 438)
        const valid = std.fs.isValid(file)
        items[index] = Output.{ .file = file, .name = name, .owned = true, .active = valid }
        if !valid {
            common.writePathError("tee", "cannot open", name)
            opened = false
        }
        index += 1
    }
    return Outputs.{ .items = items, .length = count, .bytes = bytes, .opened = opened }
}

fn outputAt(outputs: *Outputs, index: usize) -> *Output {
    unsafe { return @ptrFromInt(*Output, @intFromPtr(outputs.*.items) + index * @sizeOf(Output)) }
}

fn writeAllResult(file: std.fs.File, bytes: [*]const u8, length: usize) -> isize {
    var written: usize = 0
    while written < length {
        unsafe {
            const current = @ptrFromInt([*]const u8, @intFromPtr(bytes) + written)
            const result = std.fs.write(file, current, length - written)
            if result <= 0 { return result }
            written += @bitCast(usize, result)
        }
    }
    return 0
}

fn hasActiveOutput(outputs: *Outputs) -> bool {
    var index: usize = 0
    while index < outputs.*.length {
        if outputAt(outputs, index).*.active { return true }
        index += 1
    }
    return false
}

fn writeChunk(outputs: *Outputs, bytes: [*]const u8, length: usize, output_error: u8) -> ChunkResult {
    var success = true
    var index: usize = 0
    while index < outputs.*.length {
        const output = outputAt(outputs, index)
        const result = if output.*.active { writeAllResult(output.*.file, bytes, length) } else { 0 }
        if output.*.active && result < 0 {
            const pipe = result == -32
            const ignore_pipe = pipe && (output_error == 2 || output_error == 4)
            if !ignore_pipe { common.writePathError("tee", "cannot write", output.*.name) }
            output.*.active = false
            if !ignore_pipe { success = false }
            if output_error == 3 || output_error == 4 && !pipe {
                return ChunkResult.{ .success = false, .stop = true }
            }
        }
        index += 1
    }
    return ChunkResult.{ .success = success, .stop = !hasActiveOutput(outputs) }
}

fn transfer(outputs: *Outputs, output_error: u8) -> bool {
    const allocator = std.page_allocator.init()
    const allocation = allocator.allocFn(allocator.context, common.BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = outputs.*.opened
    while true {
        const amount = std.fs.read(std.io.stdin(), buffer, common.BUFFER_SIZE)
        if amount < 0 {
            common.writeMessage("tee", "cannot read standard input")
            success = false
            break
        }
        if amount == 0 { break }
        unsafe {
            const written = writeChunk(outputs, @ptrCast([*]const u8, buffer), @bitCast(usize, amount), output_error)
            if !written.success { success = false }
            if written.stop { break }
        }
    }
    allocator.freeFn(allocator.context, buffer, common.BUFFER_SIZE, 8)
    return success
}

fn closeOutputs(outputs: Outputs) -> bool {
    var success = true
    var index: usize = 1
    while index < outputs.length {
        const output = outputs.items[index]
        if output.owned && std.fs.isValid(output.file) && !std.fs.close(output.file) { success = false }
        index += 1
    }
    const allocator = std.page_allocator.init()
    unsafe { allocator.freeFn(allocator.context, @ptrCast([*]u8, outputs.items), outputs.bytes, @alignOf(Output)) }
    return success
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: tee [OPTION]... [FILE]...\nCopy standard input to each FILE and standard output.\n  -a, --append             append instead of overwriting files\n  -i, --ignore-interrupts  ignore interrupt signals\n  -p                       use warn-nopipe output handling\n      --output-error=MODE  warn, warn-nopipe, exit, or exit-nopipe\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx tee 0.1.0\n") { 0 } else { 1 } }
    if options.invalid {
        common.writeMessage("tee", "invalid option")
        return 1
    }
    if options.ignoreInterrupts && !std.os.linux.process.ignoreSignal(std.os.linux.process.INTERRUPT_SIGNAL) {
        common.writeMessage("tee", "cannot ignore interrupt signal")
        return 1
    }
    if options.outputError != 0 && !std.os.linux.process.ignoreSignal(std.os.linux.process.BROKEN_PIPE_SIGNAL) {
        common.writeMessage("tee", "cannot configure broken-pipe handling")
        return 1
    }
    const created = openOutputs(arguments, options)
    if created == null {
        common.writeMessage("tee", "cannot allocate output table")
        return 1
    }
    var outputs = created.?
    const copied = transfer(&outputs, options.outputError)
    const closed = closeOutputs(outputs)
    return if copied && closed { 0 } else { 1 }
}
