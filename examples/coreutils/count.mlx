const std = @import("std")

pub const Result = struct {
    value: usize
    valid: bool
}

pub const ExtendedResult = struct {
    value: usize
    valid: bool
    negative: bool
    positive: bool
}

fn unitExponent(byte: u8) -> usize {
    if byte == 75 || byte == 107 { return 1 }
    if byte == 77 || byte == 109 { return 2 }
    if byte == 71 || byte == 103 { return 3 }
    if byte == 84 || byte == 116 { return 4 }
    if byte == 80 || byte == 112 { return 5 }
    if byte == 69 || byte == 101 { return 6 }
    if byte == 90 || byte == 122 { return 7 }
    if byte == 89 || byte == 121 { return 8 }
    if byte == 82 || byte == 114 { return 9 }
    if byte == 81 || byte == 113 { return 10 }
    return 0
}

fn scale(value: usize, suffix: std.string.String) -> Result {
    if suffix.length == 0 { return Result.{ .value = value, .valid = true } }
    if suffix.length == 1 && suffix.pointer[0] == 98 {
        if value > 18446744073709551615 / 512 { return Result.{ .value = 0, .valid = false } }
        return Result.{ .value = value * 512, .valid = true }
    }
    const exponent = unitExponent(suffix.pointer[0])
    if exponent == 0 { return Result.{ .value = 0, .valid = false } }
    var base: usize = 1024
    if suffix.length == 2 && suffix.pointer[1] == 66 { base = 1000 } else if suffix.length == 3 && (suffix.pointer[1] == 105 || suffix.pointer[1] == 73) && suffix.pointer[2] == 66 {
        base = 1024
    } else if suffix.length != 1 { return Result.{ .value = 0, .valid = false } }
    var result = value
    var power: usize = 0
    while power < exponent {
        if result > 18446744073709551615 / base { return Result.{ .value = 0, .valid = false } }
        result *= base
        power += 1
    }
    return Result.{ .value = result, .valid = true }
}

pub fn parseExtended(text: std.string.String) -> ExtendedResult {
    if text.length == 0 { return ExtendedResult.{ .value = 0, .valid = false, .negative = false, .positive = false } }
    var index: usize = 0
    var negative = false
    var positive = false
    if text.pointer[0] == 45 || text.pointer[0] == 43 {
        negative = text.pointer[0] == 45
        positive = text.pointer[0] == 43
        index = 1
    }
    const digit_start = index
    var value: usize = 0
    while index < text.length && text.pointer[index] >= 48 && text.pointer[index] <= 57 {
        const digit = @intCast(usize, text.pointer[index] - 48)
        if value > (18446744073709551615 - digit) / 10 { return ExtendedResult.{ .value = 0, .valid = false, .negative = negative, .positive = positive } }
        value = value * 10 + digit
        index += 1
    }
    if index == digit_start { return ExtendedResult.{ .value = 0, .valid = false, .negative = negative, .positive = positive } }
    const scaled = scale(value, std.string.slice(text, index, text.length))
    return ExtendedResult.{ .value = scaled.value, .valid = scaled.valid, .negative = negative, .positive = positive }
}

pub fn parse(text: std.string.String) -> Result {
    if text.length == 0 { return Result.{ .value = 0, .valid = false } }
    var value: usize = 0
    var index: usize = 0
    while index < text.length {
        const byte = text.pointer[index]
        if byte < 48 || byte > 57 { return Result.{ .value = 0, .valid = false } }
        const digit = @intCast(usize, byte - 48)
        if value > (18446744073709551615 - digit) / 10 { return Result.{ .value = 0, .valid = false } }
        value = value * 10 + digit
        index += 1
    }
    return Result.{ .value = value, .valid = true }
}
