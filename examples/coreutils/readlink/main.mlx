const std = @import("std")
const common = @import("../common.mlx")

const BUFFER_SIZE: usize = 65536

const Options = struct {
    canonical: bool
    canonicalMode: u8
    noNewline: bool
    zero: bool
    verbose: bool
    firstOperand: usize
    action: u8
    invalid: bool
}

fn parseShort(argument: std.string.String, options: *Options) -> bool {
    var index: usize = 1
    while index < argument.length {
        const byte = argument.pointer[index]
        if byte == 102 {
            options.*.canonical = true
            options.*.canonicalMode = 0
        } else if byte == 101 {
            options.*.canonical = true
            options.*.canonicalMode = 1
        } else if byte == 109 {
            options.*.canonical = true
            options.*.canonicalMode = 2
        } else if byte == 110 {
            options.*.noNewline = true
        } else if byte == 113 || byte == 115 { options.*.verbose = false } else if byte == 118 { options.*.verbose = true } else if byte == 122 {
            options.*.zero = true
        } else { return false }
        index += 1
    }
    return true
}

fn parseLong(argument: std.string.String, options: *Options) -> bool {
    if common.equals(argument, "--canonicalize") {
        options.*.canonical = true
        options.*.canonicalMode = 0
    } else if common.equals(argument, "--canonicalize-existing") {
        options.*.canonical = true
        options.*.canonicalMode = 1
    } else if common.equals(argument, "--canonicalize-missing") {
        options.*.canonical = true
        options.*.canonicalMode = 2
    } else if common.equals(argument, "--no-newline") {
        options.*.noNewline = true
    } else if common.equals(argument, "--quiet") || common.equals(argument, "--silent") { options.*.verbose = false } else if common.equals(argument, "--verbose") {
        options.*.verbose = true
    } else if common.equals(argument, "--zero") { options.*.zero = true } else if common.equals(argument, "--help") { options.*.action = 1 } else if common.equals(argument, "--version") {
        options.*.action = 2
    } else { return false }
    return true
}

fn parseOptions(arguments: [][*]const u8) -> Options {
    var result = Options.{ .canonical = false, .canonicalMode = 0, .noNewline = false, .zero = false, .verbose = false, .firstOperand = 1, .action = 0, .invalid = false }
    const count = std.process.count(arguments)
    while result.firstOperand < count {
        const argument = std.process.argument(arguments, result.firstOperand)
        if common.equals(argument, "--") {
            result.firstOperand += 1
            break
        }
        if argument.length < 2 || argument.pointer[0] != 45 { break }
        const valid = if argument.pointer[1] == 45 { parseLong(argument, &result) } else { parseShort(argument, &result) }
        if !valid { result.invalid = true }
        result.firstOperand += 1
    }
    return result
}

fn writeDelimiter(options: Options, single: bool) -> bool {
    if options.noNewline && single && !options.zero { return true }
    if options.zero {
        var zero: [1]u8 = [1]u8{ 0 }
        unsafe { return std.io.writeAllBytes(std.io.stdout(), @ptrCast([*]const u8, zero[0..1]), 1) }
    }
    return std.io.print("\n")
}

fn writeRaw(path: std.string.String, options: Options, single: bool) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const allocation = allocator.alloc(BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    const amount = std.fs.readLink(path.pointer, buffer, BUFFER_SIZE)
    var success = false
    if amount >= 0 {
        success = std.io.writeAllBytes(std.io.stdout(), buffer, @bitCast(usize, amount)) && writeDelimiter(options, single)
    }
    allocator.free(buffer, BUFFER_SIZE, 8)
    return success
}

fn writeCanonical(path: std.string.String, options: Options, single: bool) -> bool {
    const resolved = std.path.canonicalize(path, options.canonicalMode, true)
    if resolved == null { return false }
    const owned = resolved.?
    const written = std.io.writeAllBytes(std.io.stdout(), owned.pointer, owned.length) && writeDelimiter(options, single)
    std.path.free(owned)
    return written
}

fn printHelp() -> u8 {
    return if std.io.print("Usage: readlink [OPTION]... FILE...\n  -f, --canonicalize\n  -e, --canonicalize-existing\n  -m, --canonicalize-missing\n  -n, --no-newline\n  -q, -s, --quiet, --silent\n  -v, --verbose\n  -z, --zero\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const options = parseOptions(arguments)
    if options.action == 1 { return printHelp() }
    if options.action == 2 { return if std.io.print("mlx readlink 0.1.0\n") { 0 } else { 1 } }
    const count = std.process.count(arguments)
    if options.invalid || options.firstOperand >= count {
        common.writeMessage("readlink", "missing operand or invalid option")
        return 1
    }
    const single = count - options.firstOperand == 1
    var success = true
    var index = options.firstOperand
    while index < count {
        const path = std.process.argument(arguments, index)
        const written = if options.canonical { writeCanonical(path, options, single) } else { writeRaw(path, options, single) }
        if !written {
            if options.verbose { common.writePathError("readlink", "cannot resolve", path) }
            success = false
        }
        index += 1
    }
    return if success { 0 } else { 1 }
}
