const std = @import("std")
const common = @import("../common.mlx")
const accounts = @import("../ownership/accounts.mlx")

fn printHelp() -> u8 {
    return if std.io.print("Usage: whoami [OPTION]...\nPrint the user name associated with the current effective user ID.\nSame as id -un.\n      --help     display this help and exit\n      --version  output version information and exit\n") { 0 } else { 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count == 2 {
        const argument = std.process.argument(arguments, 1)
        if common.equals(argument, "--help") { return printHelp() }
        if common.equals(argument, "--version") { return if std.io.print("mlx whoami 0.1.0\n") { 0 } else { 1 } }
    }
    if count > 1 {
        common.writeMessage("whoami", "extra operand")
        return 1
    }
    const uid = std.os.linux.process.effectiveUserId()
    if !accounts.writeUserName(uid, std.io.stdout()) || !std.io.print("\n") {
        common.writeMessage("whoami", "cannot find name for user ID")
        return 1
    }
    return 0
}
