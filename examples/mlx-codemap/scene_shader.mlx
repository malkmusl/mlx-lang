// The 3D view's compute shader (SPIR-V built with std.spirv.builder): each
// 16x16 workgroup draws one tile of the view from the primitives binned to
// it (the CPU projects, sorts back to front and bins them: scene.mlx):
// lit spheres (a key light, its highlight and a rim), soft glows, and
// anti-aliased lines, over a dark gradient; then what the 2D canvas drew
// (the overlay: panels, labels) goes over it.
//
// Binding 0: the target (premultiplied ARGB words, rows `stride` apart
// from `offset`, the overlay already in it). Binding 1: the data: per tile
// two words (the first index, how many), the index list (primitive numbers,
// back to front) from `indexOffset`, the primitives from `primOffset`,
// PRIM_WORDS each:
//   0 kind (SPHERE, LINE, GLOW), 1 x, 2 y (f32, view pixels),
//   3 radius (sphere, glow) or x2 (line), 4 y2 (line), 5 width (line),
//   6 color (straight ARGB: alpha is the opacity), 7 second color (a
//   line's far end).
const std = @import("std")
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")

pub const TILE: u32 = 16
pub const PRIM_WORDS: u32 = 8
pub const PUSH_WORDS: u32 = 10

pub const SPHERE: u32 = 1
pub const LINE: u32 = 2
pub const GLOW: u32 = 3

// Push constants.
pub const Push = struct {
    viewX: u32
    viewY: u32
    viewWidth: u32
    viewHeight: u32
    targetOffset: u32
    targetStride: u32
    tilesX: u32
    indexOffset: u32
    primOffset: u32
    flags: u32
}

// GLSL.std.450 instructions.
const GLSL_SQRT: u32 = 31
const GLSL_FMIN: u32 = 37
const GLSL_FMAX: u32 = 40
const GLSL_FCLAMP: u32 = 43

const Shader = struct {
    b: *builder.Builder
    uint: u32
    int: u32
    float: u32
    boolean: u32
    uvec3: u32
    glsl: u32
    push: u32
    pushPointer: u32
    storagePointer: u32
    globalId: u32
    target: u32
    data: u32
    voidType: u32
    functionType: u32
    floatPointer: u32
    uintPointer: u32
}

fn bitsOf(value: f64) -> u32 {
    const small: f32 = @floatCast(f32, value)
    return @bitCast(u32, small)
}

fn u(shader: *Shader, value: u32) -> u32 { return builder.constant(shader.*.b, shader.*.uint, value) }
fn f(shader: *Shader, value: f64) -> u32 { return builder.constant(shader.*.b, shader.*.float, bitsOf(value)) }

fn bin(shader: *Shader, opcode: spv.Op, type_id: u32, left: u32, right: u32) -> u32 { return builder.binary(shader.*.b, opcode, type_id, left, right) }
fn fadd(shader: *Shader, left: u32, right: u32) -> u32 { return bin(shader, spv.Op.fAdd, shader.*.float, left, right) }
fn fsub(shader: *Shader, left: u32, right: u32) -> u32 { return bin(shader, spv.Op.fSub, shader.*.float, left, right) }
fn fmul(shader: *Shader, left: u32, right: u32) -> u32 { return bin(shader, spv.Op.fMul, shader.*.float, left, right) }
fn fdiv(shader: *Shader, left: u32, right: u32) -> u32 { return bin(shader, spv.Op.fDiv, shader.*.float, left, right) }
fn uadd(shader: *Shader, left: u32, right: u32) -> u32 { return bin(shader, spv.Op.iAdd, shader.*.uint, left, right) }
fn umul(shader: *Shader, left: u32, right: u32) -> u32 { return bin(shader, spv.Op.iMul, shader.*.uint, left, right) }

fn ext1(shader: *Shader, instruction: u32, a: u32) -> u32 {
    const id = builder.newId(shader.*.b)
    var operands: [5]u32 = [5]u32{ shader.*.float, id, shader.*.glsl, instruction, a }
    unsafe { builder.instruction(shader.*.b, builder.SECTION_FUNCTION, spv.Op.extInst, @ptrCast([*]const u32, &operands), 5) }
    return id
}

fn ext2(shader: *Shader, instruction: u32, a: u32, c: u32) -> u32 {
    const id = builder.newId(shader.*.b)
    var operands: [6]u32 = [6]u32{ shader.*.float, id, shader.*.glsl, instruction, a, c }
    unsafe { builder.instruction(shader.*.b, builder.SECTION_FUNCTION, spv.Op.extInst, @ptrCast([*]const u32, &operands), 6) }
    return id
}

fn ext3(shader: *Shader, instruction: u32, a: u32, c: u32, d: u32) -> u32 {
    const id = builder.newId(shader.*.b)
    var operands: [7]u32 = [7]u32{ shader.*.float, id, shader.*.glsl, instruction, a, c, d }
    unsafe { builder.instruction(shader.*.b, builder.SECTION_FUNCTION, spv.Op.extInst, @ptrCast([*]const u32, &operands), 7) }
    return id
}

fn sqrt(shader: *Shader, a: u32) -> u32 { return ext1(shader, GLSL_SQRT, a) }
fn fmax(shader: *Shader, a: u32, c: u32) -> u32 { return ext2(shader, GLSL_FMAX, a, c) }
fn fmin(shader: *Shader, a: u32, c: u32) -> u32 { return ext2(shader, GLSL_FMIN, a, c) }
fn clamp01(shader: *Shader, a: u32) -> u32 { return ext3(shader, GLSL_FCLAMP, a, f(shader, 0.0), f(shader, 1.0)) }

fn toFloat(shader: *Shader, value: u32) -> u32 { return builder.unary(shader.*.b, spv.Op.convertUToF, shader.*.float, value) }
fn asFloat(shader: *Shader, value: u32) -> u32 { return builder.unary(shader.*.b, spv.Op.bitcast, shader.*.float, value) }

fn pushWord(shader: *Shader, index: u32) -> u32 {
    var chain: [1]u32 = [1]u32{ u(shader, index) }
    var pointer: u32 = 0
    unsafe { pointer = builder.accessChain(shader.*.b, shader.*.pushPointer, shader.*.push, @ptrCast([*]const u32, &chain), 1) }
    return builder.load(shader.*.b, shader.*.uint, pointer)
}

fn element(shader: *Shader, buffer: u32, index: u32) -> u32 {
    var chain: [2]u32 = [2]u32{ u(shader, 0), index }
    var pointer: u32 = 0
    unsafe { pointer = builder.accessChain(shader.*.b, shader.*.storagePointer, buffer, @ptrCast([*]const u32, &chain), 2) }
    return pointer
}

fn dataWord(shader: *Shader, index: u32) -> u32 { return builder.load(shader.*.b, shader.*.uint, element(shader, shader.*.data, index)) }

// A color channel (shift 16 red, 8 green, 0 blue, 24 alpha) as 0-1.
fn channel(shader: *Shader, color: u32, shift: u32) -> u32 {
    const byte = bin(shader, spv.Op.bitwiseAnd, shader.*.uint, bin(shader, spv.Op.shiftRightLogical, shader.*.uint, color, u(shader, shift)), u(shader, 255))
    return fmul(shader, toFloat(shader, byte), f(shader, 0.00392156862745098))
}

fn select(shader: *Shader, type_id: u32, condition: u32, yes: u32, no: u32) -> u32 {
    const id = builder.newId(shader.*.b)
    builder.op5(shader.*.b, builder.SECTION_FUNCTION, spv.Op.select, type_id, id, condition, yes, no)
    return id
}

fn openIf(shader: *Shader, condition: u32) -> u32 {
    const then = builder.newId(shader.*.b)
    const merge = builder.newId(shader.*.b)
    builder.selectionMerge(shader.*.b, merge)
    builder.branchConditional(shader.*.b, condition, then, merge)
    const then_label = builder.labelWith(shader.*.b, then)
    return merge
}

fn closeIf(shader: *Shader, merge: u32) -> void {
    builder.branch(shader.*.b, merge)
    const merge_label = builder.labelWith(shader.*.b, merge)
}

// result = color * alpha + result * (1 - alpha), per channel.
fn blend(shader: *Shader, result: [*]u32, red: u32, green: u32, blue: u32, alpha: u32) -> void {
    const keep = fsub(shader, f(shader, 1.0), alpha)
    var colors: [3]u32 = [3]u32{ red, green, blue }
    var at: usize = 0
    while at < 3 {
        const old = builder.load(shader.*.b, shader.*.float, result[at])
        builder.store(shader.*.b, result[at], fadd(shader, fmul(shader, colors[at], alpha), fmul(shader, old, keep)))
        at += 1
    }
}

fn declare(shader: *Shader) -> void {
    const b = shader.*.b
    builder.capability(b, spv.Capability.shader)
    shader.*.glsl = builder.extInstImport(b, "GLSL.std.450")
    builder.memoryModel(b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    shader.*.voidType = builder.typeVoid(b)
    shader.*.functionType = builder.typeFunction(b, shader.*.voidType, null, 0)
    shader.*.boolean = builder.typeBool(b)
    shader.*.uint = builder.typeInt(b, 32, false)
    shader.*.int = builder.typeInt(b, 32, true)
    shader.*.float = builder.typeFloat(b, 32)
    shader.*.uvec3 = builder.typeVector(b, shader.*.uint, 3)
    const input_pointer = builder.typePointer(b, spv.StorageClass.input, shader.*.uvec3)
    shader.*.globalId = builder.variable(b, input_pointer, spv.StorageClass.input)
    builder.decorateBuiltIn(b, shader.*.globalId, spv.BuiltIn.globalInvocationId)
    var members: [16]u32 = undefined
    var member: usize = 0
    while member < 16 {
        members[member] = shader.*.uint
        member += 1
    }
    var push_block: u32 = 0
    unsafe { push_block = builder.typeStruct(b, @ptrCast([*]const u32, &members), @intCast(usize, PUSH_WORDS)) }
    builder.decorate(b, push_block, spv.Decoration.block)
    var word: u32 = 0
    while word < PUSH_WORDS {
        builder.memberDecorateValue(b, push_block, word, spv.Decoration.offset, word * 4)
        word += 1
    }
    const push_block_pointer = builder.typePointer(b, spv.StorageClass.pushConstant, push_block)
    shader.*.push = builder.variable(b, push_block_pointer, spv.StorageClass.pushConstant)
    shader.*.pushPointer = builder.typePointer(b, spv.StorageClass.pushConstant, shader.*.uint)
    const words = builder.typeRuntimeArray(b, shader.*.uint)
    builder.decorateValue(b, words, spv.Decoration.arrayStride, 4)
    var fields: [1]u32 = [1]u32{ words }
    var block: u32 = 0
    unsafe { block = builder.typeStruct(b, @ptrCast([*]const u32, &fields), 1) }
    builder.decorate(b, block, spv.Decoration.block)
    builder.memberDecorateValue(b, block, 0, spv.Decoration.offset, 0)
    const block_pointer = builder.typePointer(b, spv.StorageClass.storageBuffer, block)
    shader.*.storagePointer = builder.typePointer(b, spv.StorageClass.storageBuffer, shader.*.uint)
    shader.*.target = builder.variable(b, block_pointer, spv.StorageClass.storageBuffer)
    builder.decorateValue(b, shader.*.target, spv.Decoration.descriptorSet, 0)
    builder.decorateValue(b, shader.*.target, spv.Decoration.binding, 0)
    shader.*.data = builder.variable(b, block_pointer, spv.StorageClass.storageBuffer)
    builder.decorateValue(b, shader.*.data, spv.Decoration.descriptorSet, 0)
    builder.decorateValue(b, shader.*.data, spv.Decoration.binding, 1)
    shader.*.floatPointer = builder.typePointer(b, spv.StorageClass.function, shader.*.float)
    shader.*.uintPointer = builder.typePointer(b, spv.StorageClass.function, shader.*.uint)
}

fn packChannel(shader: *Shader, value: u32, shift: u32) -> u32 {
    const scaled = fadd(shader, fmul(shader, clamp01(shader, value), f(shader, 255.0)), f(shader, 0.5))
    const byte = builder.unary(shader.*.b, spv.Op.convertFToU, shader.*.uint, scaled)
    return bin(shader, spv.Op.shiftLeftLogical, shader.*.uint, byte, u(shader, shift))
}

pub fn build(b: *builder.Builder) -> void {
    var shader = Shader.{ .b = b, .uint = 0, .int = 0, .float = 0, .boolean = 0, .uvec3 = 0, .glsl = 0, .push = 0, .pushPointer = 0, .storagePointer = 0, .globalId = 0, .target = 0, .data = 0, .voidType = 0, .functionType = 0, .floatPointer = 0, .uintPointer = 0 }
    const s = &shader
    declare(s)
    const main = builder.function(b, shader.voidType, spv.FUNCTION_CONTROL_NONE, shader.functionType)
    const entry = builder.label(b)
    // Function variables first: the color so far, the loop counter.
    var result: [3]u32 = undefined
    result[0] = builder.localVariable(b, shader.floatPointer)
    result[1] = builder.localVariable(b, shader.floatPointer)
    result[2] = builder.localVariable(b, shader.floatPointer)
    const counter = builder.localVariable(b, shader.uintPointer)
    var colors: [*]u32 = undefined
    unsafe { colors = @ptrCast([*]u32, &result) }
    const id = builder.load(b, shader.uvec3, shader.globalId)
    const x = builder.compositeExtract(b, shader.uint, id, 0)
    const y = builder.compositeExtract(b, shader.uint, id, 1)
    const view_x = pushWord(s, 0)
    const view_y = pushWord(s, 1)
    const view_width = pushWord(s, 2)
    const view_height = pushWord(s, 3)
    const target_offset = pushWord(s, 4)
    const target_stride = pushWord(s, 5)
    const tiles_x = pushWord(s, 6)
    const index_offset = pushWord(s, 7)
    const prim_offset = pushWord(s, 8)
    const inside = bin(s, spv.Op.logicalAnd, shader.boolean, bin(s, spv.Op.uLessThan, shader.boolean, x, view_width), bin(s, spv.Op.uLessThan, shader.boolean, y, view_height))
    const done = openIf(s, inside)

    // The background: a dark blue gradient, lighter in the middle.
    const px = fadd(s, toFloat(s, x), f(s, 0.5))
    const py = fadd(s, toFloat(s, y), f(s, 0.5))
    const fy = fdiv(s, py, toFloat(s, view_height))
    const cx = fsub(s, fdiv(s, px, toFloat(s, view_width)), f(s, 0.5))
    const cy = fsub(s, fy, f(s, 0.45))
    const glow = clamp01(s, fsub(s, f(s, 1.0), fmul(s, fadd(s, fmul(s, cx, cx), fmul(s, cy, cy)), f(s, 2.2))))
    builder.store(b, colors[0], fadd(s, fadd(s, f(s, 0.035), fmul(s, fy, f(s, 0.02))), fmul(s, glow, f(s, 0.035))))
    builder.store(b, colors[1], fadd(s, fadd(s, f(s, 0.040), fmul(s, fy, f(s, 0.025))), fmul(s, glow, f(s, 0.045))))
    builder.store(b, colors[2], fadd(s, fadd(s, f(s, 0.070), fmul(s, fy, f(s, 0.045))), fmul(s, glow, f(s, 0.080))))

    // This pixel's tile and its primitives.
    const tile = uadd(s, umul(s, bin(s, spv.Op.uDiv, shader.uint, y, u(s, TILE)), tiles_x), bin(s, spv.Op.uDiv, shader.uint, x, u(s, TILE)))
    const first = dataWord(s, umul(s, tile, u(s, 2)))
    const count = dataWord(s, uadd(s, umul(s, tile, u(s, 2)), u(s, 1)))
    builder.store(b, counter, u(s, 0))
    const header = builder.newId(b)
    const check = builder.newId(b)
    const body = builder.newId(b)
    const next = builder.newId(b)
    const end = builder.newId(b)
    builder.branch(b, header)
    const header_label = builder.labelWith(b, header)
    builder.loopMerge(b, end, next)
    builder.branch(b, check)
    const check_label = builder.labelWith(b, check)
    const at = builder.load(b, shader.uint, counter)
    builder.branchConditional(b, bin(s, spv.Op.uLessThan, shader.boolean, at, count), body, end)
    const body_label = builder.labelWith(b, body)

    const primitive = dataWord(s, uadd(s, index_offset, uadd(s, first, at)))
    const base = uadd(s, prim_offset, umul(s, primitive, u(s, PRIM_WORDS)))
    const kind = dataWord(s, base)
    const ax = asFloat(s, dataWord(s, uadd(s, base, u(s, 1))))
    const ay = asFloat(s, dataWord(s, uadd(s, base, u(s, 2))))
    const third = asFloat(s, dataWord(s, uadd(s, base, u(s, 3))))
    const fourth = asFloat(s, dataWord(s, uadd(s, base, u(s, 4))))
    const fifth = asFloat(s, dataWord(s, uadd(s, base, u(s, 5))))
    const color = dataWord(s, uadd(s, base, u(s, 6)))
    const color_far = dataWord(s, uadd(s, base, u(s, 7)))
    const red = channel(s, color, 16)
    const green = channel(s, color, 8)
    const blue = channel(s, color, 0)
    const opacity = channel(s, color, 24)
    const dx = fsub(s, px, ax)
    const dy = fsub(s, py, ay)
    const distance_squared = fadd(s, fmul(s, dx, dx), fmul(s, dy, dy))

    // A sphere: lit from the upper left, a highlight, a rim.
    const is_sphere = bin(s, spv.Op.iEqual, shader.boolean, kind, u(s, SPHERE))
    const reach = fadd(s, third, f(s, 1.0))
    const sphere_merge = openIf(s, bin(s, spv.Op.logicalAnd, shader.boolean, is_sphere, bin(s, spv.Op.fOrdLessThan, shader.boolean, distance_squared, fmul(s, reach, reach))))
    const distance = sqrt(s, distance_squared)
    const coverage = clamp01(s, fsub(s, fadd(s, third, f(s, 0.5)), distance))
    const inverse = fdiv(s, f(s, 1.0), fmax(s, third, f(s, 0.5)))
    const nx = fmul(s, dx, inverse)
    const ny = fmul(s, dy, inverse)
    const nz = sqrt(s, fmax(s, f(s, 0.0), fsub(s, f(s, 1.0), fadd(s, fmul(s, nx, nx), fmul(s, ny, ny)))))
    // L = (-0.45, -0.55, 0.70) normalized, H = normalize(L + view).
    const diffuse = fmax(s, f(s, 0.0), fadd(s, fadd(s, fmul(s, nx, f(s, -0.4546)), fmul(s, ny, f(s, -0.5556))), fmul(s, nz, f(s, 0.7071))))
    const specular_base = fmax(s, f(s, 0.0), fadd(s, fadd(s, fmul(s, nx, f(s, -0.2455)), fmul(s, ny, f(s, -0.3001))), fmul(s, nz, f(s, 0.9218))))
    const s2 = fmul(s, specular_base, specular_base)
    const s4 = fmul(s, s2, s2)
    const s8 = fmul(s, s4, s4)
    const s16 = fmul(s, s8, s8)
    const specular = fmul(s, fmul(s, s16, s8), f(s, 0.55))
    const edge = fsub(s, f(s, 1.0), nz)
    const rim = fmul(s, fmul(s, edge, edge), f(s, 0.45))
    const shade = fadd(s, f(s, 0.20), fmul(s, diffuse, f(s, 0.80)))
    const light = fadd(s, shade, rim)
    blend(s, colors, fadd(s, fmul(s, red, light), specular), fadd(s, fmul(s, green, light), specular), fadd(s, fmul(s, blue, light), specular), fmul(s, coverage, opacity))
    closeIf(s, sphere_merge)

    // A glow: falling off from the middle to the radius.
    const is_glow = bin(s, spv.Op.iEqual, shader.boolean, kind, u(s, GLOW))
    const glow_merge = openIf(s, bin(s, spv.Op.logicalAnd, shader.boolean, is_glow, bin(s, spv.Op.fOrdLessThan, shader.boolean, distance_squared, fmul(s, third, third))))
    const falloff = clamp01(s, fsub(s, f(s, 1.0), fdiv(s, sqrt(s, distance_squared), fmax(s, third, f(s, 1.0)))))
    blend(s, colors, red, green, blue, fmul(s, fmul(s, falloff, falloff), opacity))
    closeIf(s, glow_merge)

    // A line from (x, y) to (third, fourth), `fifth` wide, its color
    // changing towards the far end's.
    const is_line = bin(s, spv.Op.iEqual, shader.boolean, kind, u(s, LINE))
    const line_merge = openIf(s, is_line)
    const ex = fsub(s, third, ax)
    const ey = fsub(s, fourth, ay)
    const length_squared = fadd(s, fadd(s, fmul(s, ex, ex), fmul(s, ey, ey)), f(s, 0.0001))
    const along = clamp01(s, fdiv(s, fadd(s, fmul(s, dx, ex), fmul(s, dy, ey)), length_squared))
    const qx = fsub(s, dx, fmul(s, along, ex))
    const qy = fsub(s, dy, fmul(s, along, ey))
    const line_distance = sqrt(s, fadd(s, fmul(s, qx, qx), fmul(s, qy, qy)))
    const line_coverage = clamp01(s, fsub(s, fadd(s, fmul(s, fifth, f(s, 0.5)), f(s, 0.5)), line_distance))
    const back = fsub(s, f(s, 1.0), along)
    const line_red = fadd(s, fmul(s, red, back), fmul(s, channel(s, color_far, 16), along))
    const line_green = fadd(s, fmul(s, green, back), fmul(s, channel(s, color_far, 8), along))
    const line_blue = fadd(s, fmul(s, blue, back), fmul(s, channel(s, color_far, 0), along))
    const line_opacity = fadd(s, fmul(s, opacity, back), fmul(s, channel(s, color_far, 24), along))
    blend(s, colors, line_red, line_green, line_blue, fmul(s, line_coverage, line_opacity))
    closeIf(s, line_merge)

    builder.branch(b, next)
    const next_label = builder.labelWith(b, next)
    builder.store(b, counter, uadd(s, builder.load(b, shader.uint, counter), u(s, 1)))
    builder.branch(b, header)
    const end_label = builder.labelWith(b, end)

    // The overlay (premultiplied) over the scene.
    const target_index = uadd(s, target_offset, uadd(s, umul(s, uadd(s, view_y, y), target_stride), uadd(s, view_x, x)))
    const pointer = element(s, shader.target, target_index)
    const overlay = builder.load(b, shader.uint, pointer)
    const overlay_alpha = channel(s, overlay, 24)
    const keep = fsub(s, f(s, 1.0), overlay_alpha)
    const out_red = fadd(s, channel(s, overlay, 16), fmul(s, builder.load(b, shader.float, colors[0]), keep))
    const out_green = fadd(s, channel(s, overlay, 8), fmul(s, builder.load(b, shader.float, colors[1]), keep))
    const out_blue = fadd(s, channel(s, overlay, 0), fmul(s, builder.load(b, shader.float, colors[2]), keep))
    const pixel = bin(s, spv.Op.bitwiseOr, shader.uint, bin(s, spv.Op.bitwiseOr, shader.uint, packChannel(s, out_red, 16), packChannel(s, out_green, 8)), bin(s, spv.Op.bitwiseOr, shader.uint, packChannel(s, out_blue, 0), u(s, 4278190080)))
    builder.store(b, pointer, pixel)
    closeIf(s, done)
    builder.returnVoid(b)
    builder.functionEnd(b)
    var interfaces: [1]u32 = [1]u32{ shader.globalId }
    unsafe { builder.entryPoint(b, spv.ExecutionModel.glCompute, main, "main", @ptrCast([*]const u32, &interfaces), 1) }
    builder.localSize(b, main, TILE, TILE, 1)
    builder.name(b, main, "main")
}

// The shader's words (allocated from `allocator`) into `result`; how many.
pub fn words(allocator: std.allocator.Allocator, result: *[*]u32) -> usize {
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    build(&b)
    const count = builder.wordCount(&b)
    const memory = allocator.alloc(count * 4, 4)
    if memory == null { return 0 }
    unsafe { result.* = @ptrCast([*]u32, memory.?) }
    builder.writeWords(&b, result.*)
    builder.deinit(&b)
    return count
}
