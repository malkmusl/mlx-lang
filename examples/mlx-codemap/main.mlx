const FINDING_COPIES: u8 = 0
const FINDING_NAMES: u8 = 1
const FINDING_UNUSED: u8 = 2
const FINDING_WORKAROUNDS: u8 = 3
const FINDING_CRASHES: u8 = 4
const FINDING_UNREACHABLE: u8 = 5
