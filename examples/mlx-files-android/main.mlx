// Mlx Files for Android: the shared responsive Files UI on a Vulkan
// NativeActivity surface, with a locked-window CPU fallback for devices on
// which Vulkan cannot be opened. Raw motion events drive direct row and
// toolbar hit-testing; swipes retain keyboard-like selection navigation.
const std = @import("std")
const android = @import("std.android")
const ui = @import("std.ui")
const vk = @import("std.vulkan")
const canvas_module = @import("../desktop-shared/canvas.mlx")
const gpu_canvas = @import("../desktop-shared/gpu_canvas.mlx")
const icons = @import("../desktop-shared/icons.mlx")
const files_ui = @import("../filemanager-shared/ui.mlx")
const files_view = @import("../filemanager-shared/view.mlx")
const swapchain = @import("../vulkan-shared/swapchain.mlx")
const browser_module = @import("./browser.mlx")

const Canvas = canvas_module.Canvas
const Text = canvas_module.Text

// 64-bit NDK layout: ANativeActivity.callback/instance, callback-table
// entries and ANativeWindow_Buffer. These match the working Vulkan demo.
const ACTIVITY_CALLBACKS: usize = 0
const ACTIVITY_INSTANCE: usize = 56
const ON_DESTROY: usize = 40
const ON_NATIVE_WINDOW_CREATED: usize = 56
const ON_NATIVE_WINDOW_RESIZED: usize = 64
const ON_NATIVE_WINDOW_REDRAW_NEEDED: usize = 72
const ON_NATIVE_WINDOW_DESTROYED: usize = 80
const ON_INPUT_QUEUE_CREATED: usize = 88
const ON_INPUT_QUEUE_DESTROYED: usize = 96
const ON_CONTENT_RECT_CHANGED: usize = 104
const BUFFER_WIDTH: usize = 0
const BUFFER_HEIGHT: usize = 4
const BUFFER_STRIDE: usize = 8
const BUFFER_BITS: usize = 16
const BUFFER_SIZE: usize = 48
const TOUCH_SLOP: i32 = 24
const LONG_PRESS_NANOSECONDS: i64 = 500000000

const FilesApp = struct {
    activity: usize
    window: usize
    queue: usize
    looper: usize
    event: usize
    buffer: usize
    width: u32
    height: u32
    insets: ui.Insets
    selected: usize
    listView: bool
    tracking: bool
    moved: bool
    touchSeen: bool
    downX: i32
    downY: i32
    downTime: i64
    downItem: usize
    downOnBack: bool
    downOnGrid: bool
    downOnList: bool
    downOnSidebarButton: bool
    downInSidebar: bool
    downOnSearch: bool
    searchFocused: bool
    sidebarExpanded: bool
    sidebarOverlayOpen: bool
    textInput: android.TextInput
    vulkan: bool
    hasSwapchain: bool
    fallbackLogged: bool
    device: *gpu_canvas.Device
    chain: swapchain.Swapchain
    browser: browser_module.Browser
    body: Text
    small: Text
    title: Text
    textAttempted: bool
    textScale: i32
}

fn appOf(context: usize) -> *FilesApp {
    unsafe { return @ptrFromInt(*FilesApp, context) }
}

fn activityApp(activity: usize) -> *FilesApp {
    unsafe { return appOf(@ptrFromInt(*usize, activity + ACTIVITY_INSTANCE).*) }
}

fn chainOf(app: *FilesApp) -> *swapchain.Swapchain {
    unsafe { return @ptrFromInt(*swapchain.Swapchain, @intFromPtr(app) + @offsetOf(FilesApp, "chain")) }
}

fn browserOf(app: *FilesApp) -> *browser_module.Browser {
    unsafe { return @ptrFromInt(*browser_module.Browser, @intFromPtr(app) + @offsetOf(FilesApp, "browser")) }
}

fn bodyOf(app: *FilesApp) -> *Text {
    unsafe { return @ptrFromInt(*Text, @intFromPtr(app) + @offsetOf(FilesApp, "body")) }
}

fn smallOf(app: *FilesApp) -> *Text {
    unsafe { return @ptrFromInt(*Text, @intFromPtr(app) + @offsetOf(FilesApp, "small")) }
}

fn titleOf(app: *FilesApp) -> *Text {
    unsafe { return @ptrFromInt(*Text, @intFromPtr(app) + @offsetOf(FilesApp, "title")) }
}

fn textInputOf(app: *FilesApp) -> *android.TextInput {
    unsafe { return @ptrFromInt(*android.TextInput, @intFromPtr(app) + @offsetOf(FilesApp, "textInput")) }
}

fn sharedCpuCanvas(canvas: *android.Canvas) -> Canvas {
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrFromInt([*]u32, canvas.*.pixels) }
    return Canvas.{
        .pixels = pixels,
        .width = canvas.*.width,
        .height = canvas.*.height,
        .stride = canvas.*.stride,
        .swapRedBlue = true,
        .device = 0,
    }
}

fn sharedVulkanCanvas(app: *FilesApp, chain: *swapchain.Swapchain) -> Canvas {
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrFromInt([*]u32, chain.*.frame.address) }
    return Canvas.{
        .pixels = pixels,
        .width = @intCast(usize, chain.*.width),
        .height = @intCast(usize, chain.*.height),
        .stride = @intCast(usize, chain.*.width),
        .swapRedBlue = chain.*.formatFlags != 0,
        .device = @intFromPtr(app.*.device),
    }
}

fn unloadText(app: *FilesApp) -> void {
    canvas_module.unloadText(bodyOf(app))
    canvas_module.unloadText(smallOf(app))
    canvas_module.unloadText(titleOf(app))
}

fn prepareText(app: *FilesApp, width: usize, height: usize) -> void {
    const scale = files_ui.density(width, height)
    if app.*.textAttempted && app.*.textScale == scale { return }
    if app.*.textAttempted { unloadText(app) }
    app.*.textAttempted = true
    app.*.textScale = scale
    const allocator = std.page_allocator.init()
    const body_loaded = canvas_module.loadAndroidText(bodyOf(app), @intCast(u32, 13 * scale), allocator)
    const small_loaded = canvas_module.loadAndroidText(smallOf(app), @intCast(u32, 12 * scale), allocator)
    const title_loaded = canvas_module.loadAndroidText(titleOf(app), @intCast(u32, 16 * scale), allocator)
    if body_loaded && small_loaded && title_loaded { android.log("files: shared UI fonts loaded") } else { android.log("files: shared UI fonts unavailable") }
}

fn baseName(path: []const u8) -> []const u8 {
    var start: usize = 0
    var index: usize = 0
    while index < path.length {
        if path[index] == 47 && index + 1 < path.length { start = index + 1 }
        index += 1
    }
    return path[start..path.length]
}

fn writeNumber(out: [*]u8, value: usize) -> usize {
    if value == 0 {
        out[0] = 48
        return 1
    }
    var divisor: usize = 1
    while value / divisor >= 10 { divisor *= 10 }
    var at: usize = 0
    while divisor > 0 {
        out[at] = @intCast(u8, 48 + value / divisor % 10)
        at += 1
        divisor /= 10
    }
    return at
}

fn append(out: [*]u8, at: usize, text: []const u8) -> usize {
    var index = at
    for byte in text {
        out[index] = byte
        index += 1
    }
    return index
}

fn drawSidebar(app: *FilesApp, canvas: *Canvas, layout: *const files_ui.Layout) -> void {
    if ui.isEmpty(layout.*.sidebar) { return }
    const scale = layout.*.scale
    files_view.drawSidebarBackground(canvas, layout)
    if layout.*.sidebarOpen { canvas_module.drawText(canvas, smallOf(app), "Favorites", layout.*.sidebar.x + 18 * scale, layout.*.sidebar.y + 22 * scale, files_ui.DIM_COLOR, 0) }
    const row_y = layout.*.sidebar.y + (if layout.*.sidebarOpen { 44 } else { 12 }) * scale
    canvas_module.fillRoundedRect(canvas, layout.*.sidebar.x + 8 * scale, row_y, layout.*.sidebar.width - 16 * scale, 28 * scale, 7 * scale, canvas_module.color(255, 58, 63, 78))
    icons.drawFolder(smallOf(app), canvas, "Files", layout.*.sidebar.x + 15 * scale, row_y + 4 * scale, 20 * scale)
    if layout.*.sidebarOpen { canvas_module.drawText(canvas, bodyOf(app), "App files", layout.*.sidebar.x + 44 * scale, row_y + 6 * scale, files_ui.TEXT_COLOR, layout.*.sidebar.width - 56 * scale) }
}

fn drawToolbar(app: *FilesApp, canvas: *Canvas, layout: *const files_ui.Layout) -> void {
    const scale = layout.*.scale
    files_view.drawToolbarBackground(canvas, layout)
    const can_up = app.*.browser.pathLength > app.*.browser.rootLength
    const enabled = if can_up { files_ui.TEXT_COLOR } else { canvas_module.color(255, 80, 84, 96) }
    files_view.drawButtonBackground(canvas, layout.*.backButton, false, app.*.tracking && app.*.downOnBack)
    files_view.drawChevron(canvas, layout.*.backButton.x + (layout.*.buttonSize - 8 * scale) / 2, layout.*.backButton.y + (layout.*.buttonSize - 13 * scale) / 2, true, enabled, 13 * scale, 3 * scale)
    files_view.drawChevron(canvas, layout.*.forwardButton.x + (layout.*.buttonSize - 6 * scale) / 2, layout.*.forwardButton.y + (layout.*.buttonSize - 13 * scale) / 2, false, canvas_module.color(255, 80, 84, 96), 13 * scale, 3 * scale)
    const name = baseName(browser_module.path(browserOf(app)))
    if layout.*.title.width > 0 { canvas_module.drawText(canvas, titleOf(app), name, layout.*.title.x, layout.*.title.y + (layout.*.title.height - 16 * scale) / 2, files_ui.TEXT_COLOR, layout.*.title.width) }

    const toggle_width = ui.right(layout.*.listButton) - layout.*.gridButton.x
    canvas_module.fillRoundedRect(canvas, layout.*.gridButton.x, layout.*.gridButton.y, toggle_width, layout.*.buttonSize, 8 * scale, canvas_module.color(255, 44, 47, 58))
    files_view.drawButtonBackground(canvas, layout.*.gridButton, !app.*.listView, app.*.tracking && app.*.downOnGrid)
    files_view.drawButtonBackground(canvas, layout.*.listButton, app.*.listView, app.*.tracking && app.*.downOnList)
    files_view.drawGridGlyphScaled(canvas, layout.*.gridButton.x + (layout.*.buttonSize - 14 * scale) / 2, layout.*.gridButton.y + (layout.*.buttonSize - 14 * scale) / 2, files_ui.TEXT_COLOR, scale)
    files_view.drawListGlyphScaled(canvas, layout.*.listButton.x + (layout.*.buttonSize - 16 * scale) / 2, layout.*.listButton.y + (layout.*.buttonSize - 14 * scale) / 2, files_ui.TEXT_COLOR, scale)
    files_view.drawButtonBackground(canvas, layout.*.sidebarButton, layout.*.sidebarOpen, app.*.tracking && app.*.downOnSidebarButton)
    files_view.drawSidebarGlyphScaled(canvas, layout.*.sidebarButton.x + (layout.*.buttonSize - 16 * scale) / 2, layout.*.sidebarButton.y + (layout.*.buttonSize - 14 * scale) / 2, files_ui.TEXT_COLOR, scale)

    if !ui.isEmpty(layout.*.search) {
        const search = layout.*.search
        canvas_module.fillRoundedRect(canvas, search.x, search.y, search.width, search.height, 8 * scale, canvas_module.color(255, 26, 28, 35))
        if app.*.searchFocused { canvas_module.strokeRoundedRect(canvas, search.x - scale, search.y - scale, search.width + 2 * scale, search.height + 2 * scale, 9 * scale, 2 * scale, files_ui.ACCENT) }
        files_view.drawSearchGlyphScaled(canvas, search.x + 10 * scale, search.y + 8 * scale, files_ui.DIM_COLOR, scale)
        if !app.*.searchFocused { canvas_module.drawText(canvas, bodyOf(app), "Search", search.x + 32 * scale, search.y + 7 * scale, files_ui.DIM_COLOR, search.width - 40 * scale) }
    }
}

fn drawGridContent(app: *FilesApp, canvas: *Canvas, layout: *const files_ui.Layout, selected: usize) -> void {
    const scale = layout.*.scale
    const scroll = contentScroll(app, layout)
    const bottom = ui.bottom(layout.*.content)
    var index: usize = 0
    while index < app.*.browser.count {
        const area = files_ui.itemRect(layout, index, scroll, false)
        if area.width > 0 && area.y + area.height > layout.*.content.y && area.y < bottom {
            const entry = browser_module.entry(browserOf(app), index)
            const name = browser_module.name(browserOf(app), index)
            const icon_x = area.x + (area.width - layout.*.gridIconSize) / 2
            const icon_y = area.y + 6 * scale
            if index == selected {
                canvas_module.fillRoundedRect(canvas, icon_x - 6 * scale, icon_y - 4 * scale, layout.*.gridIconSize + 12 * scale, layout.*.gridIconSize + 8 * scale, 9 * scale, canvas_module.color(255, 58, 62, 76))
            }
            if entry.*.directory {
                icons.drawFolder(smallOf(app), canvas, name, icon_x, icon_y, layout.*.gridIconSize)
            } else {
                icons.drawFile(smallOf(app), canvas, name, icon_x, icon_y, layout.*.gridIconSize)
            }
            var buffer: [100]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &buffer) }
            const shown = icons.fitText(smallOf(app), name, area.width - 12 * scale, bytes)
            const width = canvas_module.measure(smallOf(app), shown)
            const name_x = area.x + (area.width - width) / 2
            const name_y = icon_y + layout.*.gridIconSize + 8 * scale
            if index == selected { canvas_module.fillRoundedRect(canvas, name_x - 5 * scale, name_y - 2 * scale, width + 10 * scale, 18 * scale, 6 * scale, files_ui.ACCENT) }
            const color = if entry.*.hidden && index != selected { files_ui.DIM_COLOR } else { files_ui.TEXT_COLOR }
            canvas_module.drawText(canvas, smallOf(app), shown, name_x, name_y, color, 0)
        }
        index += 1
    }
}

fn drawHeader(app: *FilesApp, canvas: *Canvas, layout: *const files_ui.Layout) -> void {
    if ui.isEmpty(layout.*.listHeader) { return }
    files_view.drawListHeaderBackground(canvas, layout)
    const scale = layout.*.scale
    const name_x = layout.*.content.x + 18 * scale + layout.*.listIconSize + 8 * scale
    canvas_module.drawText(canvas, smallOf(app), "Name", name_x, layout.*.listHeader.y + 7 * scale, files_ui.DIM_COLOR, 0)
}

fn drawStatus(app: *FilesApp, canvas: *Canvas, layout: *const files_ui.Layout) -> void {
    if ui.isEmpty(layout.*.status) { return }
    files_view.drawStatusBackground(canvas, layout)
    const scale = layout.*.scale
    const y = layout.*.status.y + (layout.*.status.height - 12 * scale) / 2
    const path = browser_module.path(browserOf(app))
    canvas_module.drawText(canvas, smallOf(app), path, layout.*.status.x + 12 * scale, y, files_ui.DIM_COLOR, layout.*.status.width / 2)
    var buffer: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var length = writeNumber(bytes, app.*.browser.count)
    length = append(bytes, length, if app.*.browser.count == 1 { " item" } else { " items" })
    const label = bytes[0..length]
    const label_width = canvas_module.measure(smallOf(app), label)
    canvas_module.drawText(canvas, smallOf(app), label, ui.right(layout.*.status) - 14 * scale - label_width, y, files_ui.DIM_COLOR, 0)
}

fn drawContent(app: *FilesApp, canvas: *Canvas, layout: *const files_ui.Layout, state: usize) -> void {
    if ui.isEmpty(layout.*.content) { return }
    const scale = layout.*.scale
    var selected = state
    if app.*.browser.count == 0 { selected = 0 } else if selected >= app.*.browser.count { selected = app.*.browser.count - 1 }
    var visible: usize = 0
    if layout.*.rowHeight > 0 { visible = @intCast(usize, layout.*.content.height / layout.*.rowHeight) }
    if visible == 0 && layout.*.content.height > 0 { visible = 1 }
    var first: usize = 0
    if visible > 0 && selected >= visible { first = selected - visible + 1 }

    if app.*.browser.unreadable || app.*.browser.count == 0 {
        const message = if app.*.browser.unreadable { "This folder can't be read" } else { "This folder is empty" }
        const width = canvas_module.measure(bodyOf(app), message)
        canvas_module.drawText(canvas, bodyOf(app), message, layout.*.content.x + (layout.*.content.width - width) / 2, layout.*.content.y + 60 * scale, files_ui.DIM_COLOR, 0)
        return
    }

    if !app.*.listView {
        drawGridContent(app, canvas, layout, selected)
        return
    }

    var shown: usize = 0
    while shown < visible && first + shown < app.*.browser.count {
        const index = first + shown
        const y = layout.*.content.y + @intCast(i32, shown) * layout.*.rowHeight
        if index == selected {
            files_view.drawListRow(canvas, layout, y, files_ui.ACCENT)
        } else if index % 2 == 1 {
            files_view.drawListRow(canvas, layout, y, canvas_module.color(255, 35, 37, 46))
        }
        const entry = browser_module.entry(browserOf(app), index)
        const name = browser_module.name(browserOf(app), index)
        const icon_x = layout.*.content.x + 18 * scale
        const icon_y = y + (layout.*.rowHeight - layout.*.listIconSize) / 2
        if entry.*.directory {
            icons.drawFolder(smallOf(app), canvas, name, icon_x, icon_y, layout.*.listIconSize)
        } else {
            icons.drawFile(smallOf(app), canvas, name, icon_x, icon_y, layout.*.listIconSize)
        }
        const name_x = icon_x + layout.*.listIconSize + 8 * scale
        const color = if index == selected { canvas_module.color(255, 255, 255, 255) } else if entry.*.hidden { files_ui.DIM_COLOR } else { files_ui.TEXT_COLOR }
        canvas_module.drawText(canvas, bodyOf(app), name, name_x, y + (layout.*.rowHeight - 13 * scale) / 2, color, layout.*.content.width - (name_x - layout.*.content.x) - 14 * scale)
        shown += 1
    }
}

fn drawInterface(app: *FilesApp, shared: *Canvas, insets: ui.Insets) -> void {
    prepareText(app, shared.*.width, shared.*.height)
    app.*.width = @intCast(u32, shared.*.width)
    app.*.height = @intCast(u32, shared.*.height)
    app.*.insets = insets
    const scale = files_ui.density(shared.*.width, shared.*.height)
    const layout = files_ui.layoutWithSidebar(@intCast(i32, shared.*.width), @intCast(i32, shared.*.height), insets, app.*.listView, scale, app.*.sidebarExpanded, app.*.sidebarOverlayOpen)
    canvas_module.clear(shared, files_ui.BACKGROUND)
    files_view.drawMainBackground(shared, &layout)
    drawContent(app, shared, &layout, app.*.selected)
    drawHeader(app, shared, &layout)
    drawToolbar(app, shared, &layout)
    drawStatus(app, shared, &layout)
    drawSidebar(app, shared, &layout)
}

fn openSelected(app: *FilesApp, selected: usize) bool {
    if selected >= app.*.browser.count || !browser_module.entry(browserOf(app), selected).*.directory { return false }
    if !browser_module.open(browserOf(app), selected) {
        android.log("files: cannot open directory")
        return false
    }
    android.log("files: opened directory")
    return true
}

fn setCallback(activity: usize, offset: usize, function: usize) -> void {
    unsafe {
        const callbacks = @ptrFromInt(*usize, activity + ACTIVITY_CALLBACKS).*
        @ptrFromInt(*usize, callbacks + offset).* = function
    }
}

fn readU32(address: usize) -> u32 {
    unsafe { return @ptrFromInt(*u32, address).* }
}

fn updateInsets(app: *FilesApp) -> void {
    var insets = ui.uniform(0)
    const kind = android.reservedInsets(app.*.activity, &insets)
    app.*.insets = insets
}

fn openVulkan(app: *FilesApp) -> bool {
    const opened = gpu_canvas.openAndroid(std.page_allocator.init())
    if opened == null {
        android.log("files: Vulkan unavailable")
        return false
    }
    app.*.device = opened.?
    android.log("files: Vulkan renderer ready")
    return true
}

fn createSwapchain(app: *FilesApp) -> void {
    if !app.*.vulkan || app.*.window == 0 || app.*.hasSwapchain { return }
    const context = gpu_canvas.context(app.*.device)
    var info = vk.AndroidSurfaceCreateInfoKHR.init()
    unsafe { info.window = @ptrFromInt(*anyopaque, app.*.window) }
    var surface: vk.SurfaceKHR = 0
    if vk.createAndroidSurfaceKHR(context.*.instanceCommands, context.*.instance, &info, null, &surface) != vk.Result.success {
        android.log("files: cannot create Vulkan window surface")
        return
    }
    if !swapchain.create(context, chainOf(app), surface, 0, 0) {
        android.log("files: cannot create Vulkan swapchain")
        swapchain.destroy(context, chainOf(app), false)
        return
    }
    app.*.hasSwapchain = true
    android.log("files: Vulkan swapchain created")
}

fn destroySwapchain(app: *FilesApp, keep_surface: bool) -> void {
    if !app.*.hasSwapchain { return }
    swapchain.destroy(gpu_canvas.context(app.*.device), chainOf(app), keep_surface)
    app.*.hasSwapchain = false
}

fn recreateSwapchain(app: *FilesApp) -> void {
    if !app.*.hasSwapchain { return }
    const context = gpu_canvas.context(app.*.device)
    const surface = chainOf(app).*.surface
    swapchain.destroy(context, chainOf(app), true)
    if !swapchain.create(context, chainOf(app), surface, 0, 0) {
        swapchain.destroy(context, chainOf(app), false)
        app.*.hasSwapchain = false
        android.log("files: cannot recreate Vulkan swapchain")
    }
}

// swapchain.PaintFn: record the shared Canvas UI into the swapchain's mapped
// frame using the same Vulkan paint shader as the desktop Files app.
fn paintVulkan(data: usize, chain: *swapchain.Swapchain) -> bool {
    const app = appOf(data)
    gpu_canvas.setSwapRedBlue(app.*.device, chain.*.formatFlags != 0)
    gpu_canvas.begin(app.*.device, chain.*.width, chain.*.height)
    var canvas = sharedVulkanCanvas(app, chain)
    drawInterface(app, &canvas, app.*.insets)
    return gpu_canvas.paint(app.*.device, chain.*.frame.buffer, 0, chain.*.width)
}

fn presentVulkan(app: *FilesApp) -> bool {
    if !app.*.hasSwapchain { return false }
    var status = swapchain.presentPixels(gpu_canvas.context(app.*.device), chainOf(app), @intFromPtr(paintVulkan), @intFromPtr(app))
    if status == swapchain.FrameStatus.out_of_date {
        recreateSwapchain(app)
        if !app.*.hasSwapchain { return false }
        status = swapchain.presentPixels(gpu_canvas.context(app.*.device), chainOf(app), @intFromPtr(paintVulkan), @intFromPtr(app))
    }
    if status == swapchain.FrameStatus.failed {
        android.log("files: Vulkan frame failed; using CPU fallback")
        destroySwapchain(app, false)
        return false
    }
    return status == swapchain.FrameStatus.presented
}

fn paintCpu(app: *FilesApp) -> void {
    if app.*.window == 0 { return }
    const geometry = android.ANativeWindow_setBuffersGeometry(app.*.window, 0, 0, android.WINDOW_FORMAT_RGBA_8888)
    if android.ANativeWindow_lock(app.*.window, app.*.buffer, 0) < 0 { return }
    const buffer = app.*.buffer
    var pixels: usize = 0
    unsafe { pixels = @ptrFromInt(*usize, buffer + BUFFER_BITS).* }
    var canvas = android.Canvas.{
        .pixels = pixels,
        .width = @intCast(usize, readU32(buffer + BUFFER_WIDTH)),
        .height = @intCast(usize, readU32(buffer + BUFFER_HEIGHT)),
        .stride = @intCast(usize, readU32(buffer + BUFFER_STRIDE)),
        .reserved = app.*.insets,
        .free = ui.rect(0, 0, 0, 0),
    }
    canvas.free = ui.inset(ui.rect(0, 0, @intCast(i32, canvas.width), @intCast(i32, canvas.height)), canvas.reserved)
    var shared = sharedCpuCanvas(&canvas)
    drawInterface(app, &shared, app.*.insets)
    const posted = android.ANativeWindow_unlockAndPost(app.*.window)
}

fn paint(app: *FilesApp) -> void {
    if app.*.window == 0 { return }
    updateInsets(app)
    if presentVulkan(app) { return }
    if !app.*.fallbackLogged {
        android.log("files: CPU window fallback active")
        app.*.fallbackLogged = true
    }
    paintCpu(app)
}

fn currentLayout(app: *FilesApp) -> files_ui.Layout {
    const width = @intCast(usize, app.*.width)
    const height = @intCast(usize, app.*.height)
    return files_ui.layoutWithSidebar(@intCast(i32, app.*.width), @intCast(i32, app.*.height), app.*.insets, app.*.listView, files_ui.density(width, height), app.*.sidebarExpanded, app.*.sidebarOverlayOpen)
}

fn visibleRows(layout: *const files_ui.Layout) -> usize {
    if layout.*.rowHeight <= 0 || layout.*.content.height <= 0 { return 0 }
    var visible = @intCast(usize, layout.*.content.height / layout.*.rowHeight)
    if visible == 0 { visible = 1 }
    return visible
}

fn firstVisible(app: *FilesApp, layout: *const files_ui.Layout) -> usize {
    const visible = visibleRows(layout)
    if visible > 0 && app.*.selected >= visible { return app.*.selected - visible + 1 }
    return 0
}

fn contentScroll(app: *FilesApp, layout: *const files_ui.Layout) -> i32 {
    if app.*.listView { return @intCast(i32, firstVisible(app, layout)) * layout.*.rowHeight }
    const columns = @intCast(usize, files_ui.columns(layout))
    if columns == 0 || layout.*.cellHeight <= 0 { return 0 }
    var available = layout.*.content.height - layout.*.gridPadding * 2
    if available < 0 { available = 0 }
    var visible_rows = @intCast(usize, available / layout.*.cellHeight)
    if visible_rows == 0 && layout.*.content.height > 0 { visible_rows = 1 }
    if visible_rows == 0 { return 0 }
    const selected_row = app.*.selected / columns
    const first_row = if selected_row >= visible_rows { selected_row - visible_rows + 1 } else { 0 }
    return @intCast(i32, first_row) * layout.*.cellHeight
}

fn itemAt(app: *FilesApp, x: i32, y: i32) -> usize {
    if app.*.width == 0 || app.*.height == 0 { return app.*.browser.count }
    const layout = currentLayout(app)
    if !ui.isEmpty(layout.sidebar) && ui.contains(layout.sidebar, x, y) { return app.*.browser.count }
    if !ui.contains(layout.content, x, y) { return app.*.browser.count }
    if app.*.listView {
        if layout.rowHeight <= 0 { return app.*.browser.count }
        const row = @intCast(usize, (y - layout.content.y) / layout.rowHeight)
        const index = firstVisible(app, &layout) + row
        return if index < app.*.browser.count { index } else { app.*.browser.count }
    }
    const scroll = contentScroll(app, &layout)
    var index: usize = 0
    while index < app.*.browser.count {
        if ui.contains(files_ui.itemRect(&layout, index, scroll, false), x, y) { return index }
        index += 1
    }
    return app.*.browser.count
}

fn clampSelection(app: *FilesApp) -> void {
    if app.*.browser.count == 0 {
        app.*.selected = 0
    } else if app.*.selected >= app.*.browser.count {
        app.*.selected = app.*.browser.count - 1
    }
}

fn goUp(app: *FilesApp) -> void {
    if browser_module.up(browserOf(app)) {
        app.*.selected = 0
        android.log("files: parent directory")
    }
}

fn refresh(app: *FilesApp) -> void {
    if browser_module.reload(browserOf(app)) { android.log("files: refreshed") } else { android.log("files: refresh failed") }
    clampSelection(app)
}

fn setView(app: *FilesApp, list: bool) -> void {
    if app.*.listView == list { return }
    app.*.listView = list
    android.log(if list { "files: list view" } else { "files: grid view" })
}

fn toggleSidebar(app: *FilesApp) -> void {
    if currentLayout(app).mode == files_ui.Mode.wide {
        app.*.sidebarExpanded = !app.*.sidebarExpanded
        android.log(if app.*.sidebarExpanded { "files: sidebar expanded" } else { "files: sidebar icon rail" })
    } else {
        app.*.sidebarOverlayOpen = !app.*.sidebarOverlayOpen
        android.log(if app.*.sidebarOverlayOpen { "files: sidebar drawer opened" } else { "files: sidebar drawer closed" })
    }
}

fn focusSearch(app: *FilesApp) -> void {
    if app.*.searchFocused { return }
    const layout = currentLayout(app)
    if ui.isEmpty(layout.search) { return }
    app.*.searchFocused = true
    if !android.focusTextInput(app.*.activity, textInputOf(app), layout.search, 32 * layout.scale, 8 * layout.scale, files_ui.TEXT_COLOR) {
        android.ANativeActivity_showSoftInput(app.*.activity, android.SHOW_SOFT_INPUT_FORCED)
        android.log("files: search editor unavailable; forced IME")
    }
    android.log("files: search focused")
}

fn dismissSearch(app: *FilesApp) -> void {
    if !app.*.searchFocused { return }
    app.*.searchFocused = false
    android.dismissTextInput(app.*.activity, textInputOf(app))
    android.log("files: search dismissed")
}

fn positionSearchInput(app: *FilesApp) -> void {
    if !app.*.searchFocused || app.*.textInput.view == 0 { return }
    const layout = currentLayout(app)
    if ui.isEmpty(layout.search) {
        dismissSearch(app)
    } else {
        if !android.positionTextInput(app.*.activity, textInputOf(app), layout.search) { android.log("files: cannot position search editor") }
    }
}

fn activate(app: *FilesApp, index: usize) -> void {
    if index >= app.*.browser.count { return }
    app.*.selected = index
    if openSelected(app, index) {
        app.*.selected = 0
    } else {
        android.log("files: selected file")
    }
}

fn absolute(value: i32) -> i32 { return if value < 0 { 0 - value } else { value } }

fn performTap(app: *FilesApp, x: i32, y: i32) -> void {
    const layout = currentLayout(app)
    if app.*.downOnSearch && ui.contains(layout.search, x, y) {
        focusSearch(app)
        return
    }
    if app.*.downOnSidebarButton && ui.contains(layout.sidebarButton, x, y) {
        dismissSearch(app)
        toggleSidebar(app)
        return
    }
    dismissSearch(app)
    if app.*.downInSidebar && ui.contains(layout.sidebar, x, y) { return }
    if app.*.downOnBack && ui.contains(layout.backButton, x, y) {
        goUp(app)
        return
    }
    if app.*.downOnGrid && ui.contains(layout.gridButton, x, y) {
        setView(app, false)
        return
    }
    if app.*.downOnList && ui.contains(layout.listButton, x, y) {
        setView(app, true)
        return
    }
    if itemAt(app, x, y) == app.*.downItem { activate(app, app.*.downItem) }
}

fn performSwipe(app: *FilesApp, dx: i32, dy: i32) -> void {
    if absolute(dx) >= absolute(dy) {
        if dx > 0 {
            goUp(app)
        } else if openSelected(app, app.*.selected) {
            app.*.selected = 0
        }
        return
    }
    if dy < 0 {
        if app.*.selected + 1 < app.*.browser.count { app.*.selected += 1 }
    } else if app.*.selected > 0 {
        app.*.selected -= 1
    }
}

fn handleMotion(app: *FilesApp, event: usize) -> bool {
    const action = android.AMotionEvent_getAction(event) & android.MOTION_ACTION_MASK
    const x_position: f32 = android.AMotionEvent_getX(event, 0)
    const y_position: f32 = android.AMotionEvent_getY(event, 0)
    const wide_x: i64 = @intFromFloat(i64, x_position)
    const wide_y: i64 = @intFromFloat(i64, y_position)
    const x = @intCast(i32, wide_x)
    const y = @intCast(i32, wide_y)
    if !app.*.touchSeen {
        app.*.touchSeen = true
        android.log("files: touch input active")
    }
    if action == android.MOTION_ACTION_DOWN {
        app.*.tracking = true
        app.*.moved = false
        app.*.downX = x
        app.*.downY = y
        app.*.downTime = android.AMotionEvent_getEventTime(event)
        const layout = currentLayout(app)
        app.*.downOnBack = ui.contains(layout.backButton, x, y)
        app.*.downOnGrid = ui.contains(layout.gridButton, x, y)
        app.*.downOnList = ui.contains(layout.listButton, x, y)
        app.*.downOnSidebarButton = ui.contains(layout.sidebarButton, x, y)
        app.*.downInSidebar = !ui.isEmpty(layout.sidebar) && ui.contains(layout.sidebar, x, y)
        app.*.downOnSearch = ui.contains(layout.search, x, y)
        app.*.downItem = itemAt(app, x, y)
        if app.*.downItem < app.*.browser.count {
            app.*.selected = app.*.downItem
        }
        paint(app)
        return true
    }
    if !app.*.tracking { return true }
    const dx = x - app.*.downX
    const dy = y - app.*.downY
    const scale = files_ui.density(@intCast(usize, app.*.width), @intCast(usize, app.*.height))
    const outside = absolute(dx) > TOUCH_SLOP * scale || absolute(dy) > TOUCH_SLOP * scale
    if action == android.MOTION_ACTION_MOVE {
        if outside { app.*.moved = true }
        return true
    }
    if action == android.MOTION_ACTION_UP {
        app.*.tracking = false
        const held = android.AMotionEvent_getEventTime(event) - app.*.downTime
        if !app.*.moved && !outside && held >= LONG_PRESS_NANOSECONDS {
            refresh(app)
        } else if (app.*.moved || outside) && !app.*.downInSidebar && !app.*.downOnSidebarButton {
            performSwipe(app, dx, dy)
        } else {
            performTap(app, x, y)
        }
        paint(app)
        return true
    }
    if action == android.MOTION_ACTION_CANCEL || action == android.MOTION_ACTION_POINTER_DOWN {
        app.*.tracking = false
        paint(app)
        return true
    }
    return true
}

fn onInput(fd: i32, events: i32, data: usize) -> i32 {
    const app = appOf(data)
    while app.*.queue != 0 && android.AInputQueue_getEvent(app.*.queue, app.*.event) >= 0 {
        var event: usize = 0
        unsafe { event = @ptrFromInt(*usize, app.*.event).* }
        if android.AInputQueue_preDispatchEvent(app.*.queue, event) == 0 {
            var handled: i32 = 0
            if android.AInputEvent_getType(event) == android.INPUT_EVENT_TYPE_MOTION && handleMotion(app, event) { handled = 1 }
            android.AInputQueue_finishEvent(app.*.queue, event, handled)
        }
    }
    return 1
}

fn onWindowCreated(activity: usize, window: usize) -> void {
    const app = activityApp(activity)
    app.*.window = window
    updateInsets(app)
    createSwapchain(app)
    paint(app)
}

fn onWindowResized(activity: usize, window: usize) -> void {
    const app = activityApp(activity)
    app.*.window = window
    if app.*.hasSwapchain { recreateSwapchain(app) } else { createSwapchain(app) }
    paint(app)
    positionSearchInput(app)
}

fn onContentRectChanged(activity: usize, rect: usize) -> void {
    const app = activityApp(activity)
    updateInsets(app)
    paint(app)
    positionSearchInput(app)
}

fn onRedrawNeeded(activity: usize, window: usize) -> void {
    paint(activityApp(activity))
}

fn onWindowDestroyed(activity: usize, window: usize) -> void {
    const app = activityApp(activity)
    destroySwapchain(app, false)
    app.*.window = 0
}

fn onInputQueueCreated(activity: usize, queue: usize) -> void {
    const app = activityApp(activity)
    app.*.queue = queue
    android.AInputQueue_attachLooper(queue, app.*.looper, 1, @intFromPtr(onInput), @intFromPtr(app))
    android.log("files: input queue attached")
}

fn onInputQueueDestroyed(activity: usize, queue: usize) -> void {
    const app = activityApp(activity)
    android.AInputQueue_detachLooper(queue)
    app.*.queue = 0
    app.*.tracking = false
    dismissSearch(app)
}

fn onDestroy(activity: usize) -> void {
    const app = activityApp(activity)
    android.destroyTextInput(activity, textInputOf(app))
    destroySwapchain(app, false)
    if app.*.vulkan { gpu_canvas.close(app.*.device) }
    if app.*.textAttempted { unloadText(app) }
    unsafe { @ptrFromInt(*usize, activity + ACTIVITY_INSTANCE).* = 0 }
    android.free(@intFromPtr(app))
}

export fn ANativeActivity_onCreate(activity: usize, saved_state: usize, saved_state_size: usize) -> void {
    const block = android.malloc(@sizeOf(FilesApp) + BUFFER_SIZE + 8)
    if block == 0 { return }
    const app = appOf(block)
    app.*.activity = activity
    app.*.window = 0
    app.*.queue = 0
    app.*.looper = android.ALooper_forThread()
    app.*.buffer = block + @sizeOf(FilesApp)
    app.*.event = app.*.buffer + BUFFER_SIZE
    app.*.width = 0
    app.*.height = 0
    app.*.insets = ui.uniform(0)
    app.*.selected = 0
    app.*.listView = true
    app.*.tracking = false
    app.*.moved = false
    app.*.touchSeen = false
    app.*.downX = 0
    app.*.downY = 0
    app.*.downTime = 0
    app.*.downItem = 0
    app.*.downOnBack = false
    app.*.downOnGrid = false
    app.*.downOnList = false
    app.*.downOnSidebarButton = false
    app.*.downInSidebar = false
    app.*.downOnSearch = false
    app.*.searchFocused = false
    app.*.sidebarExpanded = true
    app.*.sidebarOverlayOpen = false
    app.*.textInput.view = 0
    app.*.hasSwapchain = false
    app.*.fallbackLogged = false
    app.*.body.loaded = false
    app.*.small.loaded = false
    app.*.title.loaded = false
    app.*.textAttempted = false
    app.*.textScale = 0
    const root = android.internalDataPath(activity)
    if @intFromPtr(root) == 0 || !browser_module.init(browserOf(app), root) {
        app.*.browser.count = 0
        app.*.browser.unreadable = true
        android.log("files: private directory unavailable")
    } else {
        android.log("files: private directory loaded")
    }
    app.*.vulkan = openVulkan(app)
    unsafe { @ptrFromInt(*usize, activity + ACTIVITY_INSTANCE).* = block }
    setCallback(activity, ON_DESTROY, @intFromPtr(onDestroy))
    setCallback(activity, ON_NATIVE_WINDOW_CREATED, @intFromPtr(onWindowCreated))
    setCallback(activity, ON_NATIVE_WINDOW_RESIZED, @intFromPtr(onWindowResized))
    setCallback(activity, ON_NATIVE_WINDOW_REDRAW_NEEDED, @intFromPtr(onRedrawNeeded))
    setCallback(activity, ON_NATIVE_WINDOW_DESTROYED, @intFromPtr(onWindowDestroyed))
    setCallback(activity, ON_INPUT_QUEUE_CREATED, @intFromPtr(onInputQueueCreated))
    setCallback(activity, ON_INPUT_QUEUE_DESTROYED, @intFromPtr(onInputQueueDestroyed))
    setCallback(activity, ON_CONTENT_RECT_CHANGED, @intFromPtr(onContentRectChanged))
}
