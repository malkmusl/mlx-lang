// The system calls mlx-console needs beyond std (numbers for x86_64):
// files and ioctls (the framebuffer, the console, the input devices),
// memory mapping, polling, signals as a descriptor.
const std = @import("std")

extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
extern("syscall") fn syscall6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const SYS_read: usize = 0
pub const SYS_write: usize = 1
pub const SYS_open: usize = 2
pub const SYS_close: usize = 3
pub const SYS_poll: usize = 7
pub const SYS_mmap: usize = 9
pub const SYS_munmap: usize = 11
pub const SYS_rt_sigprocmask: usize = 14
pub const SYS_ioctl: usize = 16
pub const SYS_ftruncate: usize = 77
pub const SYS_getdents64: usize = 217
pub const SYS_exit_group: usize = 231
pub const SYS_signalfd4: usize = 289

pub const O_RDONLY: usize = 0
pub const O_WRONLY: usize = 1
pub const O_RDWR: usize = 2
pub const O_CREAT: usize = 64
pub const O_NONBLOCK: usize = 2048
pub const O_DIRECTORY: usize = 65536
pub const O_CLOEXEC: usize = 524288

pub const PROT_READ: usize = 1
pub const PROT_WRITE: usize = 2
pub const MAP_SHARED: usize = 1

pub const POLLIN: u16 = 1
pub const POLLERR: u16 = 8
pub const POLLHUP: u16 = 16

pub const EAGAIN: isize = -11
pub const EINTR: isize = -4

pub const SIGHUP: usize = 1
pub const SIGINT: usize = 2
pub const SIGTERM: usize = 15

// <linux/fb.h>: the fixed and the variable screen information.
pub const FBIOGET_VSCREENINFO: usize = 17920
pub const FBIOGET_FSCREENINFO: usize = 17922
// <linux/kd.h>: the console's mode (text or graphics) and its keyboard's
// (K_OFF: the kernel leaves the keys to us).
pub const KDSETMODE: usize = 19258
pub const KDGETMODE: usize = 19259
pub const KD_TEXT: usize = 0
pub const KD_GRAPHICS: usize = 1
pub const KDGKBMODE: usize = 19268
pub const KDSKBMODE: usize = 19269
pub const K_UNICODE: usize = 3
pub const K_OFF: usize = 4

pub fn open(path: [*]const u8, flags: usize, mode: usize) -> isize {
    return std.linux.syscall3(SYS_open, @intFromPtr(path), flags, mode)
}

pub fn close(descriptor: isize) -> void {
    const ignored = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

pub fn read(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    return std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), @intFromPtr(into), capacity)
}

pub fn write(descriptor: isize, bytes: [*]const u8, length: usize) -> isize {
    return std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(bytes), length)
}

pub fn writeAll(descriptor: isize, text: []const u8) -> bool {
    var pointer: [*]const u8 = undefined
    unsafe { pointer = @ptrCast([*]const u8, text) }
    var written: usize = 0
    while written < text.length {
        const count = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(pointer) + written, text.length - written)
        if count == EINTR { continue }
        if count <= 0 { return false }
        written += @bitCast(usize, count)
    }
    return true
}

pub fn ioctl(descriptor: isize, request: usize, argument: usize) -> isize {
    return std.linux.syscall3(SYS_ioctl, @bitCast(usize, descriptor), request, argument)
}

pub fn ioctlBytes(descriptor: isize, request: usize, bytes: [*]u8) -> isize {
    return ioctl(descriptor, request, @intFromPtr(bytes))
}

// `length` bytes of `descriptor` mapped shared for reading and writing.
pub fn mmap(length: usize, descriptor: isize) -> ?[*]u8 {
    const result = syscall6(SYS_mmap, 0, length, PROT_READ | PROT_WRITE, MAP_SHARED, @bitCast(usize, descriptor), 0)
    if result < 0 && result > -4096 { return null }
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrFromInt([*]u8, @bitCast(usize, result)) }
    return pointer
}

pub fn munmap(bytes: [*]u8, length: usize) -> void {
    const ignored = std.linux.syscall2(SYS_munmap, @intFromPtr(bytes), length)
}

pub fn ftruncate(descriptor: isize, length: usize) -> bool {
    return std.linux.syscall2(SYS_ftruncate, @bitCast(usize, descriptor), length) == 0
}

pub fn getdents(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    return std.linux.syscall3(SYS_getdents64, @bitCast(usize, descriptor), @intFromPtr(into), capacity)
}

// struct pollfd: i32 fd, i16 events, i16 revents (8 bytes each).
pub fn pollSet(entries: [*]u8, index: usize, descriptor: isize) -> void {
    storeInt(entries, index * 8, @intCast(i32, descriptor))
    store16(entries, index * 8 + 4, POLLIN)
    store16(entries, index * 8 + 6, 0)
}

pub fn pollResult(entries: [*]const u8, index: usize) -> u16 { return load16(entries, index * 8 + 6) }

pub fn poll(entries: [*]u8, count: usize, timeout_ms: isize) -> isize {
    return std.linux.syscall3(SYS_poll, @intFromPtr(entries), count, @bitCast(usize, timeout_ms))
}

// A descriptor that reads SIGHUP, SIGINT and SIGTERM (blocked from now
// on); -1 when the kernel refuses.
pub fn signalDescriptor() -> isize {
    var mask: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &mask) }
    // Bits 0, 1 and 14: SIGHUP, SIGINT, SIGTERM.
    const bits: u32 = 16387
    store32(bytes, 0, bits)
    store32(bytes, 4, 0)
    const blocked = syscall4(SYS_rt_sigprocmask, 0, @intFromPtr(bytes), 0, 8)
    if blocked != 0 { return -1 }
    var none: isize = -1
    return syscall4(SYS_signalfd4, @bitCast(usize, none), @intFromPtr(bytes), 8, O_NONBLOCK | O_CLOEXEC)
}

pub fn exit(code: usize) -> void {
    const ignored = std.linux.syscall1(SYS_exit_group, code)
}

pub fn load16(bytes: [*]const u8, at: usize) -> u16 {
    return @intCast(u16, bytes[at]) | (@intCast(u16, bytes[at + 1]) << 8)
}

pub fn load32(bytes: [*]const u8, at: usize) -> u32 {
    return @intCast(u32, bytes[at]) | (@intCast(u32, bytes[at + 1]) << 8) | (@intCast(u32, bytes[at + 2]) << 16) | (@intCast(u32, bytes[at + 3]) << 24)
}

pub fn loadInt(bytes: [*]const u8, at: usize) -> i32 { return @bitCast(i32, load32(bytes, at)) }

pub fn store16(bytes: [*]u8, at: usize, value: u16) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, value >> 8)
}

pub fn store32(bytes: [*]u8, at: usize, value: u32) -> void {
    bytes[at] = @intCast(u8, value & 255)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 255)
    bytes[at + 2] = @intCast(u8, (value >> 16) & 255)
    bytes[at + 3] = @intCast(u8, (value >> 24) & 255)
}

pub fn storeInt(bytes: [*]u8, at: usize, value: i32) -> void { store32(bytes, at, @bitCast(u32, value)) }

pub fn zero(bytes: [*]u8, count: usize) -> void {
    var index: usize = 0
    while index < count {
        bytes[index] = 0
        index += 1
    }
}

// "mlx-console: TEXT\n" on stderr.
pub fn say(text: []const u8) -> void {
    const a = writeAll(2, "mlx-console: ")
    const b = writeAll(2, text)
    const c = writeAll(2, "\n")
}

pub fn sayAbout(text: []const u8, subject: []const u8) -> void {
    const a = writeAll(2, "mlx-console: ")
    const b = writeAll(2, text)
    const c = writeAll(2, subject)
    const d = writeAll(2, "\n")
}
