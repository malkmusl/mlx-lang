// mlx-console's words on stderr. Its system calls (files, ioctls, the
// framebuffer, the input devices, poll, signals as a descriptor) are
// std.linux's.
const std = @import("std")

// "mlx-console: TEXT\n" on stderr.
pub fn say(text: []const u8) -> void {
    _ = std.linux.writeAll(2, "mlx-console: ")
    _ = std.linux.writeAll(2, text)
    _ = std.linux.writeAll(2, "\n")
}

pub fn sayAbout(text: []const u8, subject: []const u8) -> void {
    _ = std.linux.writeAll(2, "mlx-console: ")
    _ = std.linux.writeAll(2, text)
    _ = std.linux.writeAll(2, subject)
    _ = std.linux.writeAll(2, "\n")
}
