// The screen: the Linux framebuffer (/dev/fb0 at 32 bits per pixel)
// mapped into memory, or for tests a plain file of WIDTH x HEIGHT ARGB
// pixels (--framebuffer FILE --size WxH). Drawing happens on an ARGB
// canvas of its own; show() copies the canvas over, row by row, swapping
// red and blue where the device keeps them the other way round.
const std = @import("std")
const sys = @import("./sys.mlx")
const canvas_module = @import("std.ui.canvas")

const Allocator = std.allocator.Allocator

pub const Framebuffer = struct {
    descriptor: isize
    memory: [*]u8
    mapped: usize
    width: usize
    height: usize
    // Bytes between the starts of two rows, and where the visible part
    // starts (the virtual resolution's offsets).
    lineLength: usize
    start: usize
    // Red lives in the low byte (BGR order) rather than the word's third.
    swapRedBlue: bool
    // The canvas drawn on (ARGB, `width` pixels per row).
    canvas: canvas_module.Canvas
    pixelBytes: usize
    allocator: Allocator
}

pub fn canvasOf(fb: *Framebuffer) -> *canvas_module.Canvas {
    unsafe { return @ptrCast(*canvas_module.Canvas, &fb.*.canvas) }
}

// The device at `path` (NUL-terminated). False, with a word on stderr,
// when it cannot be opened, read or mapped, or is not 32 bits per pixel.
pub fn openDevice(fb: *Framebuffer, path: [*]const u8, allocator: Allocator) -> bool {
    fb.*.descriptor = std.linux.open(path, std.linux.O_RDWR | std.linux.O_CLOEXEC, 0)
    if fb.*.descriptor < 0 {
        sys.sayAbout("cannot open the framebuffer ", std.text.cString(path))
        return false
    }
    var screen: std.linux.fbdev.Screen = undefined
    if !std.linux.fbdev.query(fb.*.descriptor, &screen) {
        sys.sayAbout("not a framebuffer: ", std.text.cString(path))
        std.linux.close(fb.*.descriptor)
        return false
    }
    if screen.bitsPerPixel != 32 {
        sys.say("the framebuffer is not 32 bits per pixel (set the console to a 32-bit mode)")
        std.linux.close(fb.*.descriptor)
        return false
    }
    fb.*.swapRedBlue = screen.redOffset == 0
    fb.*.lineLength = screen.lineLength
    fb.*.start = std.linux.fbdev.start(&screen)
    fb.*.mapped = screen.memoryLength
    if !map(fb) {
        sys.say("the framebuffer cannot be mapped")
        std.linux.close(fb.*.descriptor)
        return false
    }
    return prepare(fb, screen.width, screen.height, allocator)
}

// fb.*.mapped bytes of the device or file, shared for reading and writing.
fn map(fb: *Framebuffer) -> bool {
    const address = std.linux.mapShared(fb.*.descriptor, fb.*.mapped, true)
    if address == 0 { return false }
    unsafe { fb.*.memory = @ptrFromInt([*]u8, address) }
    return true
}

// A plain file of `width` x `height` ARGB pixels (made or grown to that
// size), for tests and for drawing without a device.
pub fn openFile(fb: *Framebuffer, path: [*]const u8, width: usize, height: usize, allocator: Allocator) -> bool {
    fb.*.descriptor = std.linux.open(path, std.linux.O_RDWR | std.linux.O_CREAT | std.linux.O_CLOEXEC, 420)
    if fb.*.descriptor < 0 {
        sys.sayAbout("cannot open the framebuffer file ", std.text.cString(path))
        return false
    }
    const size = width * height * 4
    if std.linux.truncate(fb.*.descriptor, size) != 0 {
        sys.say("the framebuffer file cannot be sized")
        std.linux.close(fb.*.descriptor)
        return false
    }
    fb.*.swapRedBlue = false
    fb.*.lineLength = width * 4
    fb.*.start = 0
    fb.*.mapped = size
    if !map(fb) {
        sys.say("the framebuffer file cannot be mapped")
        std.linux.close(fb.*.descriptor)
        return false
    }
    return prepare(fb, width, height, allocator)
}

fn prepare(fb: *Framebuffer, width: usize, height: usize, allocator: Allocator) -> bool {
    fb.*.width = width
    fb.*.height = height
    fb.*.allocator = allocator
    fb.*.pixelBytes = width * height * 4
    const memory = allocator.alloc(fb.*.pixelBytes, 16)
    if memory == null {
        sys.say("out of memory for the screen")
        return false
    }
    const canvas = canvasOf(fb)
    unsafe { canvas.*.pixels = @ptrCast([*]u32, memory.?) }
    canvas.*.width = width
    canvas.*.height = height
    canvas.*.stride = width
    canvas.*.swapRedBlue = false
    canvas.*.device = 0
    canvas.*.opacity = 255
    return true
}

// The canvas onto the device.
pub fn show(fb: *Framebuffer) -> void {
    const canvas = canvasOf(fb)
    var y: usize = 0
    while y < fb.*.height {
        const row: [*]u32 = unsafe { @ptrFromInt([*]u32, @intFromPtr(fb.*.memory) + fb.*.start + y * fb.*.lineLength) }
        const source = y * fb.*.width
        var x: usize = 0
        if fb.*.swapRedBlue {
            while x < fb.*.width {
                const pixel = canvas.*.pixels[source + x]
                row[x] = (pixel & 4278255360) | ((pixel & 255) << 16) | ((pixel >> 16) & 255)
                x += 1
            }
        } else {
            while x < fb.*.width {
                row[x] = canvas.*.pixels[source + x]
                x += 1
            }
        }
        y += 1
    }
}

pub fn close(fb: *Framebuffer) -> void {
    std.linux.munmap(@intFromPtr(fb.*.memory), fb.*.mapped)
    std.linux.close(fb.*.descriptor)
}
