// The text the date formatters work in: UTF-16 strings in C memory that
// grow as they are built (patterns, symbols, results), with what they
// need of them: copies to and from C's strings, comparisons, edits, and
// ICU's SimpleFormatter ("{0} at {1}" with apostrophe quoting) to put
// strings into a pattern.
const m = @import("./memory.mlx")

pub const Text = struct {
    address: usize
    length: usize
    capacity: usize
}

pub fn empty() -> Text { return Text.{ .address = 0, .length = 0, .capacity = 0 } }

fn reserve(t: *Text, more: usize) -> void {
    if t.*.length + more + 1 <= t.*.capacity { return }
    var grown = if t.*.capacity < 16 { 16 } else { t.*.capacity * 2 }
    while grown < t.*.length + more + 1 { grown *= 2 }
    const address = m.grow(t.*.address, grown * 2)
    if address == 0 { return }
    t.*.address = address
    t.*.capacity = grown
}

pub fn push(t: *Text, unit: u16) -> void {
    reserve(t, 1)
    if t.*.capacity == 0 { return }
    m.put16(t.*.address + t.*.length * 2, unit)
    t.*.length += 1
    m.put16(t.*.address + t.*.length * 2, 0)
}

pub fn pushCodePoint(t: *Text, c: u32) -> void {
    if c < 65536 {
        push(t, @intCast(u16, c))
    } else {
        const v = c - 65536
        push(t, @intCast(u16, 55296 + (v >> 10)))
        push(t, @intCast(u16, 56320 + (v & 1023)))
    }
}

// UTF-8 text appended as UTF-16.
pub fn pushUtf8(t: *Text, utf8: []const u8) -> void {
    var at: usize = 0
    while at < utf8.length {
        const b = utf8[at]
        var c: u32 = 0
        var extra: usize = 0
        if b < 128 {
            c = @intCast(u32, b)
        } else if b >= 240 {
            c = @intCast(u32, b & 7)
            extra = 3
        } else if b >= 224 {
            c = @intCast(u32, b & 15)
            extra = 2
        } else {
            c = @intCast(u32, b & 31)
            extra = 1
        }
        var k: usize = 0
        while k < extra && at + 1 + k < utf8.length {
            c = (c << 6) | @intCast(u32, utf8[at + 1 + k] & 63)
            k += 1
        }
        pushCodePoint(t, c)
        at += 1 + extra
    }
}

pub fn pushUnits(t: *Text, units: usize, count: usize) -> void {
    reserve(t, count)
    var index: usize = 0
    while index < count {
        push(t, m.get16(units + index * 2))
        index += 1
    }
}

pub fn pushText(t: *Text, other: *const Text) -> void {
    if other.*.length == 0 { return }
    // The other may be the text itself.
    const count = other.*.length
    reserve(t, count)
    var index: usize = 0
    while index < count {
        push(t, m.get16(other.*.address + index * 2))
        index += 1
    }
}

// Units [start, end) of OTHER appended.
pub fn pushRange(t: *Text, other: *const Text, start: usize, end: usize) -> void {
    var index = start
    while index < end && index < other.*.length {
        push(t, m.get16(other.*.address + index * 2))
        index += 1
    }
}

pub fn at(t: *const Text, index: usize) -> u16 {
    if index >= t.*.length { return 0 }
    return m.get16(t.*.address + index * 2)
}

pub fn setAt(t: *Text, index: usize, unit: u16) -> void {
    if index < t.*.length { m.put16(t.*.address + index * 2, unit) }
}

pub fn clear(t: *Text) -> void {
    t.*.length = 0
    if t.*.address != 0 { m.put16(t.*.address, 0) }
}

pub fn dispose(t: *Text) -> void {
    m.release(t.*.address)
    t.*.address = 0
    t.*.length = 0
    t.*.capacity = 0
}

pub fn copy(t: *const Text) -> Text {
    var result = empty()
    pushText(&result, t)
    return result
}

pub fn fromUtf8(utf8: []const u8) -> Text {
    var result = empty()
    pushUtf8(&result, utf8)
    return result
}

// A copy of C's UTF-16 string (LENGTH units, or up to its NUL for -1).
pub fn fromUnits(units: usize, length: i32) -> Text {
    var result = empty()
    if units == 0 { return result }
    pushUnits(&result, units, m.units(units, length))
    return result
}

// The text's address, NUL-terminated (an empty text gets a buffer).
pub fn terminated(t: *Text) -> usize {
    reserve(t, 0)
    if t.*.address != 0 { m.put16(t.*.address + t.*.length * 2, 0) }
    return t.*.address
}

// The text into C's DEST of CAPACITY units, NUL-terminated when there is
// room, with the warnings and errors of C's results; its length.
pub fn give(t: *const Text, dest: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if dest != 0 && capacity > 0 {
        const room = @intCast(usize, capacity)
        const fit = if t.*.length < room { t.*.length } else { room }
        if fit > 0 { m.copy(dest, t.*.address, fit * 2) }
    }
    return m.terminate(dest, t.*.length, capacity, status)
}

pub fn same(a: *const Text, b: *const Text) -> bool {
    if a.*.length != b.*.length { return false }
    var index: usize = 0
    while index < a.*.length {
        if at(a, index) != at(b, index) { return false }
        index += 1
    }
    return true
}

// Whether the text is ASCII TEXT.
pub fn isAscii(t: *const Text, text: []const u8) -> bool {
    if t.*.length != text.length { return false }
    var index: usize = 0
    while index < text.length {
        if at(t, index) != @intCast(u16, text[index]) { return false }
        index += 1
    }
    return true
}

pub fn indexOf(t: *const Text, unit: u16) -> usize {
    var index: usize = 0
    while index < t.*.length {
        if at(t, index) == unit { return index }
        index += 1
    }
    return NOT_FOUND
}

pub const NOT_FOUND: usize = 18446744073709551615

pub fn contains(t: *const Text, unit: u16) -> bool { return indexOf(t, unit) != NOT_FOUND }

// The index of OTHER in the text from FROM on, or NOT_FOUND.
pub fn find(t: *const Text, other: *const Text, from: usize) -> usize {
    if other.*.length == 0 { return from }
    var index = from
    while index + other.*.length <= t.*.length {
        var k: usize = 0
        while k < other.*.length && at(t, index + k) == at(other, k) { k += 1 }
        if k == other.*.length { return index }
        index += 1
    }
    return NOT_FOUND
}

// COUNT units at START removed.
pub fn remove(t: *Text, start: usize, count: usize) -> void {
    if start >= t.*.length { return }
    const n = if start + count > t.*.length { t.*.length - start } else { count }
    var index = start
    while index + n < t.*.length {
        m.put16(t.*.address + index * 2, m.get16(t.*.address + (index + n) * 2))
        index += 1
    }
    t.*.length -= n
    m.put16(t.*.address + t.*.length * 2, 0)
}

// OTHER put in at unit WHERE.
pub fn insert(t: *Text, where: usize, other: *const Text) -> void {
    const count = other.*.length
    if count == 0 { return }
    var saved = copy(other)
    reserve(t, count)
    var index = t.*.length
    while index > where {
        index -= 1
        m.put16(t.*.address + (index + count) * 2, m.get16(t.*.address + index * 2))
    }
    var k: usize = 0
    while k < count {
        m.put16(t.*.address + (where + k) * 2, at(&saved, k))
        k += 1
    }
    t.*.length += count
    m.put16(t.*.address + t.*.length * 2, 0)
    dispose(&saved)
}

pub fn insertUnit(t: *Text, where: usize, unit: u16) -> void {
    var one = empty()
    push(&one, unit)
    insert(t, where, &one)
    dispose(&one)
}

// Every OLD replaced by NEW.
pub fn replaceAll(t: *Text, old: *const Text, new: *const Text) -> void {
    if old.*.length == 0 { return }
    var result = empty()
    var index: usize = 0
    while index < t.*.length {
        var k: usize = 0
        while k < old.*.length && index + k < t.*.length && at(t, index + k) == at(old, k) { k += 1 }
        if k == old.*.length {
            pushText(&result, new)
            index += old.*.length
        } else {
            push(&result, at(t, index))
            index += 1
        }
    }
    dispose(t)
    t.* = result
}

pub fn replaceAllAscii(t: *Text, old: []const u8, new: []const u8) -> void {
    var o = fromUtf8(old)
    var n = fromUtf8(new)
    replaceAll(t, &o, &n)
    dispose(&o)
    dispose(&n)
}

// The text as bytes when it is ASCII (each unit's low byte otherwise),
// for keys of the locale data.
pub fn asciiInto(t: *const Text, into: *m.Bytes) -> void {
    var index: usize = 0
    while index < t.*.length {
        const unit = at(t, index)
        m.pushByte(into, if unit < 128 { @intCast(u8, unit) } else { 63 })
        index += 1
    }
}

// The text as UTF-8.
pub fn utf8Into(t: *const Text, into: *m.Bytes) -> void {
    var index: usize = 0
    while index < t.*.length {
        var c = @intCast(u32, at(t, index))
        index += 1
        if c >= 55296 && c <= 56319 && index < t.*.length {
            const trail = @intCast(u32, at(t, index))
            if trail >= 56320 && trail <= 57343 {
                c = (c << 10) + trail - 56613888
                index += 1
            }
        }
        if c < 128 {
            m.pushByte(into, @intCast(u8, c))
        } else if c < 2048 {
            m.pushByte(into, @intCast(u8, 192 | (c >> 6)))
            m.pushByte(into, @intCast(u8, 128 | (c & 63)))
        } else if c < 65536 {
            m.pushByte(into, @intCast(u8, 224 | (c >> 12)))
            m.pushByte(into, @intCast(u8, 128 | ((c >> 6) & 63)))
            m.pushByte(into, @intCast(u8, 128 | (c & 63)))
        } else {
            m.pushByte(into, @intCast(u8, 240 | (c >> 18)))
            m.pushByte(into, @intCast(u8, 128 | ((c >> 12) & 63)))
            m.pushByte(into, @intCast(u8, 128 | ((c >> 6) & 63)))
            m.pushByte(into, @intCast(u8, 128 | (c & 63)))
        }
    }
}

pub fn isLetter(unit: u16) -> bool { return (unit >= 65 && unit <= 90) || (unit >= 97 && unit <= 122) }

// ---------------------------------------------------------------------------
// SimpleFormatter: a pattern with arguments {0}, {1}, ... ; an apostrophe
// starts quoting only before '{' or '|' (or another apostrophe, which is
// one apostrophe), as ICU's SimpleFormatter compiles it.

// The pattern with the arguments in ARGS (COUNT of them) put in, appended
// to OUT; OFFSETS (COUNT of them) gets where each argument went (-1 when it
// is not in the pattern), relative to OUT's start.
pub fn format(pattern: *const Text, args: [*]const Text, count: usize, out: *Text, offsets: [*]i64) -> void {
    var index: usize = 0
    var k: usize = 0
    while k < count {
        offsets[k] = -1
        k += 1
    }
    var inQuote = false
    while index < pattern.*.length {
        var c = at(pattern, index)
        index += 1
        if c == 39 {
            if index < pattern.*.length && at(pattern, index) == 39 {
                index += 1
                push(out, 39)
                continue
            } else if inQuote {
                inQuote = false
                continue
            } else if index < pattern.*.length && (at(pattern, index) == 123 || at(pattern, index) == 124) {
                push(out, at(pattern, index))
                index += 1
                inQuote = true
                continue
            }
            push(out, 39)
            continue
        }
        if !inQuote && c == 123 {
            // {n}
            var end = index
            var number: usize = 0
            var digits: usize = 0
            while end < pattern.*.length && at(pattern, end) >= 48 && at(pattern, end) <= 57 {
                number = number * 10 + @intCast(usize, at(pattern, end) - 48)
                digits += 1
                end += 1
            }
            if digits > 0 && end < pattern.*.length && at(pattern, end) == 125 && number < count {
                offsets[number] = @intCast(i64, out.*.length)
                pushText(out, &args[number])
                index = end + 1
                continue
            }
        }
        push(out, c)
    }
}

pub fn format1(pattern: *const Text, a: *const Text, out: *Text) -> void {
    var args: [1]Text = undefined
    args[0] = a.*
    var none: [1]i64 = undefined
    format(pattern, &args, 1, out, &none)
}

pub fn format2(pattern: *const Text, a: *const Text, b: *const Text, out: *Text) -> void {
    var args: [2]Text = undefined
    args[0] = a.*
    args[1] = b.*
    var none: [2]i64 = undefined
    format(pattern, &args, 2, out, &none)
}

pub fn format3(pattern: *const Text, a: *const Text, b: *const Text, c: *const Text, out: *Text) -> void {
    var args: [3]Text = undefined
    args[0] = a.*
    args[1] = b.*
    args[2] = c.*
    var none: [3]i64 = undefined
    format(pattern, &args, 3, out, &none)
}

// The pattern's text without its arguments (the quoting resolved) into
// OUT, and where arguments 0 and 1 are in it (getTextWithNoArguments).
pub fn textWithoutArguments(pattern: *const Text, out: *Text, first: *i64, second: *i64) -> void {
    var empties: [2]Text = undefined
    empties[0] = empty()
    empties[1] = empty()
    var offsets: [2]i64 = undefined
    format(pattern, &empties, 2, out, &offsets)
    first.* = offsets[0]
    second.* = offsets[1]
}
