// Currencies (ucurr.h) over CLDR: the names and symbols of a currency in
// a locale (numbers/currencies/XXX/symbol, symbol-alt-narrow, -formal,
// -variant, displayName, displayName-count-PLURAL), its fraction digits
// and rounding (currencyData/fractions, cash and standard), the
// currencies of a region over time (currencyData/region/RR/N/XXX with
// _from, _to and _tender), and ICU's list of ISO 4217 codes with its
// classes (common or not, deprecated or not), which is ICU's own table.
// The numeric codes are ISO 4217's as CLDR's codeMappings has them
// (supplemental codeMappings.json, which cldr.dat does not carry; the
// table below is of CLDR 48).
//
// The statuses are ICU's: a name found in the locale asked for is plain
// success, one found in a parent U_USING_FALLBACK_WARNING, in root
// U_USING_DEFAULT_WARNING, none at all the code itself with
// U_USING_DEFAULT_WARNING.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const enumeration = @import("./enumeration.mlx")
const locale = @import("./locale.mlx")
const nd = @import("./numberdata.mlx")

pub const SYMBOL_NAME: i32 = 0
pub const LONG_NAME: i32 = 1
pub const NARROW_SYMBOL_NAME: i32 = 2
pub const FORMAL_SYMBOL_NAME: i32 = 3
pub const VARIANT_SYMBOL_NAME: i32 = 4

pub const USAGE_STANDARD: i32 = 0
pub const USAGE_CASH: i32 = 1

const USING_FALLBACK_WARNING: i32 = -128
const USING_DEFAULT_WARNING: i32 = -127
const INVALID_FORMAT_ERROR: i32 = 3

// ICU's gCurrencyList: each code and its class (a hex digit: 1 common, 2
// uncommon, 4 deprecated, 8 not deprecated).
const ISO_LIST: []const u8 = ""

// ISO 4217's numeric codes (CLDR's codeMappings): code and three digits.
const NUMERIC_CODES: []const u8 = ""

// A currency code: three upper-case letters (the C string a UTF-16 code
// was upper-cased into), and its length (what C gave, up to 3).
pub const Code = struct {
    bytes: [4]u8
    length: usize
}

// The code of UTF-16 CURRENCY (NUL-terminated, the first three units).
pub fn codeOf(currency: usize) -> Code {
    var c = Code.{ .bytes = [4]u8{ 0, 0, 0, 0 }, .length = 0 }
    if currency == 0 { return c }
    while c.length < 3 {
        const unit = m.get16(currency + c.length * 2)
        if unit == 0 { break }
        c.bytes[c.length] = if unit < 128 { nd.upper(@intCast(u8, unit)) } else { 63 }
        c.length += 1
    }
    return c
}

pub fn codeText(c: *const Code) -> []const u8 { return c.*.bytes[0..c.*.length] }

// The key of currency C's FIELD (symbol, displayName...).
fn nameKey(c: *const Code, field: []const u8) -> nd.Key {
    var k = nd.key("numbers/currencies/")
    nd.add(&k, codeText(c))
    nd.addByte(&k, 47)
    nd.add(&k, field)
    return k
}

// Whether the locale asked for is the data locale itself (set by the
// callers before a lookup; a locale that falls back to another is found
// one level up at best).
pub const Lookup = struct {
    data: u32
    exact: bool
}

// Where in the chain of LOOKUP's locale KEY is found: 0 in the locale
// asked for, 1 in a parent, 2 in root; -1 nowhere.
fn levelOf(at0: Lookup, keyIndex: u32) -> i32 {
    if keyIndex == resources.NONE { return -1 }
    const root = resources.root()
    const data = at0.data
    var at = data
    var depth: i32 = if at0.exact { 0 } else { 1 }
    while at != resources.NONE {
        if resources.own(at, keyIndex) != resources.NONE {
            if at == root && !(data == root && at0.exact) { return 2 }
            return if depth == 0 { 0 } else { 1 }
        }
        at = resources.parent(at)
        depth += 1
    }
    return -1
}

// The level of the nearest locale with an entry for currency C (a symbol
// or a name), as ICU's Currencies table has one.
fn entryLevel(data: Lookup, c: *const Code) -> i32 {
    var k = nameKey(c, "symbol")
    const a = levelOf(data, nd.keyIndex(&k))
    k = nameKey(c, "displayName")
    const b = levelOf(data, nd.keyIndex(&k))
    if a < 0 { return b }
    if b < 0 { return a }
    return if a < b { a } else { b }
}

fn warning(level: i32) -> i32 {
    if level == 2 { return USING_DEFAULT_WARNING }
    if level == 1 { return USING_FALLBACK_WARNING }
    return 0
}

// ICU's way of passing the lookup's warning on.
fn passOn(status: usize, found: i32) -> void {
    if found == USING_DEFAULT_WARNING || (found == USING_FALLBACK_WARNING && m.getI32(status) != USING_DEFAULT_WARNING) { m.putI32(status, found) }
}

// The name of currency C in locale DATA in STYLE (UTF-8, from the data),
// "" when there is none; the ICU status of the lookup into STATUS (0, a
// warning, or -1 for none found).
pub fn name(data: Lookup, c: *const Code, style: i32, found: *i32) -> []const u8 {
    var id = resources.NONE
    found.* = 0
    var choice = style
    if style == NARROW_SYMBOL_NAME || style == FORMAL_SYMBOL_NAME || style == VARIANT_SYMBOL_NAME {
        const field = if style == NARROW_SYMBOL_NAME { "symbol-alt-narrow" } else if style == FORMAL_SYMBOL_NAME { "symbol-alt-formal" } else { "symbol-alt-variant" }
        var k = nameKey(c, field)
        const keyIndex = nd.keyIndex(&k)
        const level = levelOf(data, keyIndex)
        if level >= 0 {
            id = resources.valueOf(data.data, keyIndex)
            found.* = warning(level)
            return resources.string(id)
        }
        found.* = USING_FALLBACK_WARNING
        choice = SYMBOL_NAME
    }
    const level = entryLevel(data, c)
    if level < 0 {
        found.* = -1
        return ""
    }
    const w = warning(level)
    if w == USING_DEFAULT_WARNING || (w == USING_FALLBACK_WARNING && found.* != USING_DEFAULT_WARNING) { found.* = w }
    var k = nameKey(c, if choice == LONG_NAME { "displayName" } else { "symbol" })
    const value = nd.get(data.data, &k)
    // An entry without its own symbol: the code stands for itself.
    if value.length == 0 { return codeText(c) }
    return value
}

// UTF-16 copies of names, by their data address (an address in the
// mapped file or a code's own slot).
const KEPT: usize = 2048
var keptKeys: [2048]usize = undefined
var keptCopies: [2048]usize = undefined
var keptLengths: [2048]u32 = undefined
var keptReady: bool = false
var codeCopies: [17576]usize = undefined
var codesReady: bool = false

fn keptCopy(text: []const u8, len: usize) -> usize {
    if !keptReady {
        var index: usize = 0
        while index < KEPT {
            keptKeys[index] = 0
            keptCopies[index] = 0
            index += 1
        }
        keptReady = true
    }
    const address = @intFromPtr(text.pointer) +% text.length *% 31
    var slot = (address >> 3) % KEPT
    var probes: usize = 0
    while probes < KEPT {
        if keptKeys[slot] == address && keptCopies[slot] != 0 {
            if len != 0 { m.putI32(len, @intCast(i32, keptLengths[slot])) }
            return keptCopies[slot]
        }
        if keptCopies[slot] == 0 { break }
        slot = (slot + 1) % KEPT
        probes += 1
    }
    const copy = nd.utf16Copy(text)
    const count = nd.units16(copy)
    if probes < KEPT {
        keptKeys[slot] = address
        keptLengths[slot] = @intCast(u32, count)
        keptCopies[slot] = copy
    }
    if len != 0 { m.putI32(len, @intCast(i32, count)) }
    return copy
}

// A code that is three letters as a UTF-16 string kept for good.
fn codeCopy(c: *const Code, len: usize) -> usize {
    if !codesReady {
        var index: usize = 0
        while index < 17576 {
            codeCopies[index] = 0
            index += 1
        }
        codesReady = true
    }
    var slot: usize = 0
    var letters = true
    var index: usize = 0
    while index < 3 {
        const b = c.*.bytes[index]
        if b < 65 || b > 90 { letters = false }
        if letters { slot = slot * 26 + @intCast(usize, b - 65) }
        index += 1
    }
    if !letters || c.*.length != 3 { return keptCopy(codeText(c), len) }
    if codeCopies[slot] == 0 { codeCopies[slot] = nd.utf16Copy(codeText(c)) }
    if len != 0 { m.putI32(len, 3) }
    return codeCopies[slot]
}

// The plural name of C for plural keyword PLURAL in DATA (UTF-8), the
// long name when the data has none, the code at last (FOUND -1).
pub fn pluralName(data: Lookup, c: *const Code, plural: []const u8, found: *i32) -> []const u8 {
    found.* = 0
    var k = nameKey(c, "displayName-count-")
    nd.add(&k, plural)
    var keyIndex = nd.keyIndex(&k)
    var level = levelOf(data, keyIndex)
    if level < 0 {
        k = nameKey(c, "displayName-count-other")
        keyIndex = nd.keyIndex(&k)
        level = levelOf(data, keyIndex)
    }
    if level < 0 { return name(data, c, LONG_NAME, found) }
    found.* = warning(level)
    return resources.string(resources.valueOf(data.data, keyIndex))
}

// The lookup of locale ID.
pub fn lookupOf(id: []const u8) -> Lookup {
    const data = resources.find(id)
    return Lookup.{ .data = data, .exact = nd.isExactly(id, data) }
}

export fn ucurr_getName(currency: usize, localeId: usize, nameStyle: i32, isChoiceFormat: usize, len: usize, ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    if nameStyle < 0 || nameStyle > 4 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if currency == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    const data = lookupOf(id)
    const c = codeOf(currency)
    if isChoiceFormat != 0 { m.put8(isChoiceFormat, 0) }
    var found: i32 = 0
    const text = name(data, &c, nameStyle, &found)
    if found == -1 {
        if len != 0 { m.putI32(len, @intCast(i32, nd.units16(currency))) }
        m.putI32(ec, USING_DEFAULT_WARNING)
        return currency
    }
    passOn(ec, found)
    if m.same(text, codeText(&c)) && text.pointer == c.bytes[0..1].pointer { return codeCopy(&c, len) }
    return keptCopy(text, len)
}

export fn ucurr_getPluralName(currency: usize, localeId: usize, isChoiceFormat: usize, pluralCount: usize, len: usize, ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    if currency == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    const data = lookupOf(id)
    const c = codeOf(currency)
    if isChoiceFormat != 0 { m.put8(isChoiceFormat, 0) }
    var found: i32 = 0
    const plural = if pluralCount == 0 { "other" } else { m.cSlice(pluralCount) }
    const text = pluralName(data, &c, plural, &found)
    if found == -1 {
        if len != 0 { m.putI32(len, @intCast(i32, nd.units16(currency))) }
        m.putI32(ec, USING_DEFAULT_WARNING)
        return currency
    }
    passOn(ec, found)
    if text.pointer == c.bytes[0..1].pointer { return codeCopy(&c, len) }
    return keptCopy(text, len)
}

// ---------------------------------------------------------------------------
// Fraction digits and rounding.

fn fractionValue(c: *const Code, field: []const u8, fallback: i32) -> i32 {
    var k = nd.key("currencyData/fractions/")
    nd.add(&k, codeText(c))
    nd.addByte(&k, 47)
    nd.add(&k, field)
    var text = nd.supplemental(&k)
    if text.length == 0 {
        // A currency of its own without this field: its standard value;
        // one the data does not list: DEFAULT's.
        k = nd.key("currencyData/fractions/")
        nd.add(&k, codeText(c))
        nd.add(&k, "/_digits")
        if nd.supplemental(&k).length == 0 {
            k = nd.key("currencyData/fractions/DEFAULT/")
            nd.add(&k, field)
            text = nd.supplemental(&k)
        }
    }
    if text.length == 0 { return fallback }
    var value: i32 = 0
    for byte in text {
        if byte >= 48 && byte <= 57 { value = value * 10 + @intCast(i32, byte - 48) }
    }
    return value
}

// The fraction digits of C for USAGE.
pub fn fractionDigits(c: *const Code, usage: i32) -> i32 {
    const digits = fractionValue(c, "_digits", 2)
    if usage == USAGE_CASH { return fractionValue(c, "_cashDigits", digits) }
    return digits
}

// The rounding increment of C for USAGE in units of its last fraction
// digit (0 or 1: none).
pub fn roundingUnits(c: *const Code, usage: i32) -> i32 {
    const rounding = fractionValue(c, "_rounding", 0)
    if usage == USAGE_CASH { return fractionValue(c, "_cashRounding", rounding) }
    return rounding
}

fn metaCurrency(currency: usize, ec: usize) -> bool {
    if currency == 0 || m.get16(currency) == 0 {
        if !m.failed(ec) { m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR) }
        return false
    }
    return true
}

export fn ucurr_getDefaultFractionDigitsForUsage(currency: usize, usage: i32, ec: usize) -> i32 {
    if m.failed(ec) { return 0 }
    if usage != USAGE_STANDARD && usage != USAGE_CASH {
        m.setError(ec, m.UNSUPPORTED_ERROR)
        return 0
    }
    if !metaCurrency(currency, ec) { return 2 }
    const c = codeOf(currency)
    return fractionDigits(&c, usage)
}

export fn ucurr_getDefaultFractionDigits(currency: usize, ec: usize) -> i32 { return ucurr_getDefaultFractionDigitsForUsage(currency, USAGE_STANDARD, ec) }

export fn ucurr_getRoundingIncrementForUsage(currency: usize, usage: i32, ec: usize) -> f64 {
    if m.failed(ec) { return 0.0 }
    if !metaCurrency(currency, ec) { return 0.0 }
    if usage != USAGE_STANDARD && usage != USAGE_CASH {
        m.setError(ec, m.UNSUPPORTED_ERROR)
        return 0.0
    }
    const c = codeOf(currency)
    const digits = fractionDigits(&c, usage)
    const increment = roundingUnits(&c, usage)
    if digits < 0 || digits > 9 {
        m.setError(ec, INVALID_FORMAT_ERROR)
        return 0.0
    }
    if increment < 2 { return 0.0 }
    var power: f64 = 1.0
    var k: i32 = 0
    while k < digits {
        power *= 10.0
        k += 1
    }
    return @floatFromInt(f64, increment) / power
}

export fn ucurr_getRoundingIncrement(currency: usize, ec: usize) -> f64 { return ucurr_getRoundingIncrementForUsage(currency, USAGE_STANDARD, ec) }

// ---------------------------------------------------------------------------
// The currencies of a region.

// The region of locale ID for the supplemental data: its `rg` keyword's,
// its own region subtag, or (INFER) its language's likely one; "" when
// none. Into INTO (8 bytes); the length.
pub fn regionOf(id: []const u8, infer: bool, into: *[8]u8) -> usize {
    const rg = locale.keyword(id, "rg")
    if rg.length >= 3 && rg.length <= 7 {
        var length: usize = 0
        while length < 2 {
            into.*[length] = nd.upper(rg[length])
            length += 1
        }
        return length
    }
    // The subtags of the ID before its keywords.
    var end: usize = 0
    while end < id.length && id[end] != 64 { end += 1 }
    var at: usize = 0
    var index: usize = 0
    while at <= end {
        const start = at
        while at < end && id[at] != 95 && id[at] != 45 { at += 1 }
        const part = id[start..at]
        // A singleton starts the extensions.
        if index > 0 && part.length == 1 { break }
        if index > 0 && (part.length == 2 || (part.length == 3 && part[0] >= 48 && part[0] <= 57)) {
            var length: usize = 0
            while length < part.length {
                into.*[length] = nd.upper(part[length])
                length += 1
            }
            return length
        }
        index += 1
        at += 1
    }
    if !infer { return 0 }
    const code = locale.region(id)
    if code == 0 { return 0 }
    into.*[0] = @intCast(u8, code >> 8)
    into.*[1] = @intCast(u8, code & 255)
    return 2
}

// A region's currency number INDEX: its code, dates (ms since 1970, UTC;
// the end is the last millisecond of its last day) and whether it is
// tender. False when the region has fewer.
pub const RegionCurrency = struct {
    code: Code
    from: f64
    to: f64
    hasTo: bool
    tender: bool
}

const DATE_MIN: f64 = -184303902528000000.0
const DATE_MAX: f64 = 183882168921600000.0

pub fn regionCurrency(region: []const u8, index: usize, out: *RegionCurrency) -> bool {
    var k = nd.key("currencyData/region/")
    nd.add(&k, region)
    nd.addByte(&k, 47)
    nd.addNumber(&k, @intCast(u64, index))
    var first: u32 = 0
    var end: u32 = 0
    nd.below(&k, &first, &end)
    if first >= end { return false }
    const code = resources.childName(first, k.length)
    out.*.code = Code.{ .bytes = [4]u8{ 0, 0, 0, 0 }, .length = 0 }
    while out.*.code.length < 3 && out.*.code.length < code.length {
        out.*.code.bytes[out.*.code.length] = code[out.*.code.length]
        out.*.code.length += 1
    }
    nd.addByte(&k, 47)
    nd.add(&k, code)
    const base = k.length
    nd.add(&k, "/_from")
    const from = nd.supplemental(&k)
    out.*.from = if from.length >= 10 { dayMillis(from) } else { DATE_MIN }
    k.length = base
    nd.add(&k, "/_to")
    const to = nd.supplemental(&k)
    out.*.hasTo = to.length >= 10
    out.*.to = if out.*.hasTo { dayMillis(to) + 86399999.0 } else { DATE_MAX }
    k.length = base
    nd.add(&k, "/_tender")
    out.*.tender = !m.same(nd.supplemental(&k), "false")
    return true
}

// The UTC midnight of "YYYY-MM-DD" in ms since 1970.
fn dayMillis(text: []const u8) -> f64 {
    var year: i64 = 0
    var at: usize = 0
    var negative = false
    if text[0] == 45 {
        negative = true
        at = 1
    }
    while at < text.length && text[at] != 45 {
        year = year * 10 + @intCast(i64, text[at] - 48)
        at += 1
    }
    if negative { year = -year }
    const month = @intCast(i64, (text[at + 1] - 48) * 10 + (text[at + 2] - 48))
    const day = @intCast(i64, (text[at + 4] - 48) * 10 + (text[at + 5] - 48))
    // Days from civil (proleptic Gregorian).
    const y = if month <= 2 { year - 1 } else { year }
    const era = (if y >= 0 { y } else { y - 399 }) / 400
    const yoe = y - era * 400
    const mp = if month > 2 { month - 3 } else { month + 9 }
    const doy = (153 * mp + 2) / 5 + day - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    const days = era * 146097 + doe - 719468
    return @floatFromInt(f64, days) * 86400000.0
}

// The first tender currency of REGION (or its first one when none is
// tender) into OUT.
fn regionDefault(region: []const u8, out: *Code) -> bool {
    var index: usize = 0
    var have = false
    var entry: RegionCurrency = undefined
    while regionCurrency(region, index, &entry) {
        if !entry.tender && have {
            index += 1
            continue
        }
        out.* = entry.code
        have = true
        if entry.tender { return true }
        index += 1
    }
    return have
}

// The currency of locale ID: its `currency` (`cu`) keyword, else its
// region's; false (and FOUND MISSING) when it has none.
pub fn forLocale(id: []const u8, out: *Code) -> bool {
    var keyword = locale.keyword(id, "currency")
    if keyword.length == 0 { keyword = locale.keyword(id, "cu") }
    if keyword.length == 3 {
        out.* = Code.{ .bytes = [4]u8{ nd.upper(keyword[0]), nd.upper(keyword[1]), nd.upper(keyword[2]), 0 }, .length = 3 }
        return true
    }
    var region: [8]u8 = undefined
    const length = regionOf(id, false, &region)
    if length == 0 { return false }
    return regionDefault(region[0..length], out)
}

fn giveCode(c: *const Code, buff: usize, buffCapacity: i32, ec: usize) -> i32 {
    var index: usize = 0
    while index < c.*.length && @intCast(i32, index) < buffCapacity {
        m.put16(buff + index * 2, @intCast(u16, c.*.bytes[index]))
        index += 1
    }
    return m.terminate(buff, c.*.length, buffCapacity, ec)
}

export fn ucurr_forLocale(localeId: usize, buff: usize, buffCapacity: i32, ec: usize) -> i32 {
    if m.failed(ec) { return 0 }
    if buffCapacity < 0 || (buff == 0 && buffCapacity > 0) {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var c: Code = undefined
    if !forLocale(id, &c) {
        m.setError(ec, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    if c.length >= @intCast(usize, if buffCapacity > 0 { buffCapacity } else { 0 }) {
        return m.terminate(buff, c.length, buffCapacity, ec)
    }
    return giveCode(&c, buff, buffCapacity, ec)
}

export fn ucurr_countCurrencies(localeId: usize, date: f64, ec: usize) -> i32 {
    if ec == 0 || m.failed(ec) { return 0 }
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var region: [8]u8 = undefined
    const length = regionOf(id, false, &region)
    var entry: RegionCurrency = undefined
    if length == 0 || !regionCurrency(region[0..length], 0, &entry) {
        m.setError(ec, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    var count: i32 = 0
    var index: usize = 0
    while regionCurrency(region[0..length], index, &entry) {
        if entry.from <= date && (!entry.hasTo || date < entry.to) { count += 1 }
        index += 1
    }
    return count
}

export fn ucurr_forLocaleAndDate(localeId: usize, date: f64, index: i32, buff: usize, buffCapacity: i32, ec: usize) -> i32 {
    if ec == 0 || m.failed(ec) { return 0 }
    if !((buff != 0 && buffCapacity != 0) || buffCapacity == 0) {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var region: [8]u8 = undefined
    const length = regionOf(id, false, &region)
    var entry: RegionCurrency = undefined
    if length == 0 || !regionCurrency(region[0..length], 0, &entry) {
        m.setError(ec, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    var size: i32 = 0
    while regionCurrency(region[0..length], @intCast(usize, size), &entry) { size += 1 }
    if index <= 0 || index > size { return 0 }
    var current: i32 = 0
    var at: usize = 0
    while regionCurrency(region[0..length], at, &entry) {
        if entry.from <= date && (!entry.hasTo || date < entry.to) {
            current += 1
            if current == index {
                if buffCapacity <= 3 { return 0 }
                return giveCode(&entry.code, buff, buffCapacity, ec)
            }
        }
        at += 1
    }
    return 0
}

// Whether CODE is used somewhere between FROM and TO.
export fn ucurr_isAvailable(isoCode: usize, from: f64, to: f64, errorCode: usize) -> bool {
    if m.failed(errorCode) { return false }
    if isoCode == 0 { return false }
    const c = codeOf(isoCode)
    if m.get16(isoCode + c.length * 2) != 0 { return false }
    var lowest = DATE_MAX
    var highest = DATE_MIN
    var found = false
    var first: u32 = 0
    var end: u32 = 0
    resources.below("currencyData/region", &first, &end)
    var previous: []const u8 = ""
    var k = first
    while k < end {
        const region = resources.childName(k, 19)
        k += 1
        if m.same(region, previous) { continue }
        previous = region
        var entry: RegionCurrency = undefined
        var index: usize = 0
        while regionCurrency(region, index, &entry) {
            if m.same(codeText(&entry.code), codeText(&c)) {
                // ICU keeps one entry per code: the last one it reads.
                lowest = entry.from
                highest = entry.to
                found = true
            }
            index += 1
        }
    }
    if !found { return false }
    if from > to {
        m.setError(errorCode, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return !(from > highest || to < lowest)
}

export fn ucurr_openISOCurrencies(currType: u32, pErrorCode: usize) -> usize {
    if m.failed(pErrorCode) { return 0 }
    var lines = m.bytesBuffer()
    var at: usize = 0
    while at + 4 <= ISO_LIST.length {
        const digit = ISO_LIST[at + 3]
        const flags: u32 = if digit >= 97 { @intCast(u32, digit - 87) } else { @intCast(u32, digit - 48) }
        if currType == 2147483647 || (flags & currType) == currType {
            m.pushText(&lines, ISO_LIST[at..at + 3])
            m.pushByte(&lines, 10)
        }
        at += 4
    }
    const en = enumeration.ofLines(m.bytesText(&lines), pErrorCode)
    m.disposeBytes(&lines)
    return en
}

fn listed(lines: *m.Bytes, code: []const u8) -> bool {
    const text = m.bytesText(lines)
    var at: usize = 0
    while at + 3 <= text.length {
        if m.same(text[at..at + 3], code) { return true }
        at += 4
    }
    return false
}

// The currencies of locale ID's region in use now (COMMONLYUSED), or
// those and then every other currency of every region.
export fn ucurr_getKeywordValuesForLocale(key: usize, localeId: usize, commonlyUsed: bool, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var region: [8]u8 = undefined
    const length = regionOf(id, true, &region)
    const preferred = region[0..length]
    var values = m.bytesBuffer()
    var others = m.bytesBuffer()
    var first: u32 = 0
    var end: u32 = 0
    resources.below("currencyData/region", &first, &end)
    var previous: []const u8 = ""
    var k = first
    while k < end {
        const name = resources.childName(k, 19)
        k += 1
        if m.same(name, previous) { continue }
        previous = name
        const isPreferred = m.same(name, preferred)
        if !isPreferred && commonlyUsed { continue }
        var entry: RegionCurrency = undefined
        var index: usize = 0
        while regionCurrency(name, index, &entry) {
            const code = codeText(&entry.code)
            if isPreferred && !entry.hasTo && !listed(&values, code) {
                m.pushText(&values, code)
                m.pushByte(&values, 10)
            } else if !commonlyUsed && !listed(&others, code) {
                m.pushText(&others, code)
                m.pushByte(&others, 10)
            }
            index += 1
        }
    }
    if commonlyUsed && values.length == 0 {
        m.disposeBytes(&values)
        m.disposeBytes(&others)
        return ucurr_getKeywordValuesForLocale(key, m.literal("und\x00"), true, status)
    }
    if !commonlyUsed {
        const text = m.bytesText(&others)
        var at: usize = 0
        while at + 3 <= text.length {
            if !listed(&values, text[at..at + 3]) {
                m.pushText(&values, text[at..at + 3])
                m.pushByte(&values, 10)
            }
            at += 4
        }
    }
    const en = enumeration.ofLines(m.bytesText(&values), status)
    m.disposeBytes(&values)
    m.disposeBytes(&others)
    return en
}

export fn ucurr_getNumericCode(currency: usize) -> i32 {
    if currency == 0 { return 0 }
    const c = codeOf(currency)
    if c.length != 3 || m.get16(currency + 6) != 0 { return 0 }
    var at: usize = 0
    while at + 6 <= NUMERIC_CODES.length {
        if m.same(NUMERIC_CODES[at..at + 3], codeText(&c)) {
            return @intCast(i32, (NUMERIC_CODES[at + 3] - 48)) * 100 + @intCast(i32, (NUMERIC_CODES[at + 4] - 48)) * 10 + @intCast(i32, (NUMERIC_CODES[at + 5] - 48))
        }
        at += 6
    }
    return 0
}

// Whether C is one of ICU's ISO codes.
pub fn isKnown(c: *const Code) -> bool {
    var at: usize = 0
    while at + 4 <= ISO_LIST.length {
        if m.same(ISO_LIST[at..at + 3], codeText(c)) { return true }
        at += 4
    }
    return false
}
