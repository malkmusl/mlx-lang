// Number patterns (UTS #35's "#,##0.00;(#,##0.00)", ICU's
// ParsedPatternInfo): what the integer and fraction formats ask for
// (grouping sizes, digits, a rounding increment, the exponent), padding,
// and the prefix and suffix of the positive and the negative subpattern
// as affix patterns; and the affixes a formatter writes of them (ICU's
// PatternStringUtils::patternInfoToStringBuilder and AffixUtils): the
// sign put in or replaced for the sign display ('-' becomes '+' or the
// approximately sign), '%' by '‰' for permille, then the affix's tokens
// (quoted literals, - + ~ % ‰ and ¤ to ¤¤¤¤¤) as text with their fields.
const m = @import("./memory.mlx")
const nd = @import("./numberdata.mlx")
const nb = @import("./numberbuilder.mlx")

pub const UNQUOTED_SPECIAL: i32 = 65555
pub const UNEXPECTED_TOKEN: i32 = 65792
pub const MALFORMED_EXPONENTIAL_PATTERN: i32 = 65795
pub const MULTIPLE_PAD_SPECIFIERS: i32 = 65798
pub const PATTERN_SYNTAX_ERROR: i32 = 65799

// UNumberFormatPadPosition.
pub const PAD_BEFORE_PREFIX: i32 = 0
pub const PAD_AFTER_PREFIX: i32 = 1
pub const PAD_BEFORE_SUFFIX: i32 = 2
pub const PAD_AFTER_SUFFIX: i32 = 3

pub const Subpattern = struct {
    // Grouping: the sizes, 16 bits each from the right (ICU's
    // groupingSizes, 0x0000ffffffff0000 to start with).
    groupingSizes: u64
    integerLeadingHashSigns: i32
    integerTrailingHashSigns: i32
    integerNumerals: i32
    integerAtSigns: i32
    integerTotal: i32
    fractionNumerals: i32
    fractionHashSigns: i32
    fractionTotal: i32
    hasDecimal: bool
    widthExceptAffixes: i32
    paddingLocation: i32
    hasPadding: bool
    // The digits of the formats (0-9, with the point), for a rounding
    // increment ("#,##0.05": 0.05); roundingNonZero when it is one.
    rounding: [64]u8
    roundingLength: usize
    roundingNonZero: bool
    exponentZeros: i32
    exponentHasPlusSign: bool
    hasPercentSign: bool
    hasPerMilleSign: bool
    hasCurrencySign: bool
    hasCurrencyDecimal: bool
    hasMinusSign: bool
    hasPlusSign: bool
    // Byte offsets of the affixes and the pad character in the pattern.
    prefixStart: usize
    prefixEnd: usize
    suffixStart: usize
    suffixEnd: usize
    paddingStart: usize
    paddingEnd: usize
}

pub const Info = struct {
    text: []const u8
    positive: Subpattern
    negative: Subpattern
    hasNegative: bool
    fault: i32
    faultOffset: usize
}

fn initSubpattern(s: *Subpattern) -> void {
    s.*.groupingSizes = 281474976645120
    s.*.integerLeadingHashSigns = 0
    s.*.integerTrailingHashSigns = 0
    s.*.integerNumerals = 0
    s.*.integerAtSigns = 0
    s.*.integerTotal = 0
    s.*.fractionNumerals = 0
    s.*.fractionHashSigns = 0
    s.*.fractionTotal = 0
    s.*.hasDecimal = false
    s.*.widthExceptAffixes = 0
    s.*.paddingLocation = -1
    s.*.hasPadding = false
    s.*.roundingLength = 0
    s.*.roundingNonZero = false
    s.*.exponentZeros = 0
    s.*.exponentHasPlusSign = false
    s.*.hasPercentSign = false
    s.*.hasPerMilleSign = false
    s.*.hasCurrencySign = false
    s.*.hasCurrencyDecimal = false
    s.*.hasMinusSign = false
    s.*.hasPlusSign = false
    s.*.prefixStart = 0
    s.*.prefixEnd = 0
    s.*.suffixStart = 0
    s.*.suffixEnd = 0
    s.*.paddingStart = 0
    s.*.paddingEnd = 0
}

// The grouping sizes of a subpattern: the primary (last group), the
// secondary, the third (-1 when absent).
pub fn grouping(s: *const Subpattern, which: u32) -> i32 {
    const raw = (s.*.groupingSizes >> @intCast(u6, which * 16)) & 65535
    return @intCast(i32, @bitCast(i16, @intCast(u16, raw)))
}

const Parser = struct {
    info: *Info
    current: *Subpattern
    at: usize
}

const END: u32 = 4294967295

fn peek(p: *const Parser) -> u32 {
    const text = p.*.info.*.text
    if p.*.at >= text.length { return END }
    var at = p.*.at
    return nd.decode(text, &at)
}

fn peek2(p: *const Parser) -> u32 {
    const text = p.*.info.*.text
    if p.*.at >= text.length { return END }
    var at = p.*.at
    _ = nd.decode(text, &at)
    if at >= text.length { return END }
    return nd.decode(text, &at)
}

fn next(p: *Parser) -> u32 {
    const text = p.*.info.*.text
    if p.*.at >= text.length { return END }
    return nd.decode(text, &p.*.at)
}

fn fail(p: *Parser, code: i32) -> void {
    if p.*.info.*.fault == 0 {
        p.*.info.*.fault = code
        p.*.info.*.faultOffset = p.*.at
    }
}

fn failed(p: *const Parser) -> bool { return p.*.info.*.fault != 0 }

fn isDigit(c: u32) -> bool { return c >= 48 && c <= 57 }

fn consumeLiteral(p: *Parser) -> void {
    const c = peek(p)
    if c == END {
        fail(p, PATTERN_SYNTAX_ERROR)
        return
    }
    if c == 39 {
        _ = next(p)
        while peek(p) != 39 {
            if peek(p) == END {
                fail(p, PATTERN_SYNTAX_ERROR)
                return
            }
            _ = next(p)
        }
        _ = next(p)
    } else {
        _ = next(p)
    }
}

fn consumePadding(p: *Parser, location: i32) -> void {
    if peek(p) != 42 { return }
    if p.*.current.*.hasPadding {
        fail(p, MULTIPLE_PAD_SPECIFIERS)
        return
    }
    p.*.current.*.paddingLocation = location
    p.*.current.*.hasPadding = true
    _ = next(p)
    p.*.current.*.paddingStart = p.*.at
    consumeLiteral(p)
    p.*.current.*.paddingEnd = p.*.at
}

fn consumeAffix(p: *Parser, isPrefix: bool) -> void {
    const s = p.*.current
    const start = p.*.at
    while true {
        const c = peek(p)
        if c == 35 || c == 64 || c == 59 || c == 42 || c == 46 || c == 44 || isDigit(c) || c == END { break }
        if c == 37 { s.*.hasPercentSign = true }
        if c == 8240 { s.*.hasPerMilleSign = true }
        if c == 164 { s.*.hasCurrencySign = true }
        if c == 45 { s.*.hasMinusSign = true }
        if c == 43 { s.*.hasPlusSign = true }
        consumeLiteral(p)
        if failed(p) { return }
    }
    if isPrefix {
        s.*.prefixStart = start
        s.*.prefixEnd = p.*.at
    } else {
        s.*.suffixStart = start
        s.*.suffixEnd = p.*.at
    }
}

fn addRounding(s: *Subpattern, byte: u8) -> void {
    if s.*.roundingLength < 63 {
        s.*.rounding[s.*.roundingLength] = byte
        s.*.roundingLength += 1
    }
    if byte >= 49 && byte <= 57 { s.*.roundingNonZero = true }
}

fn consumeIntegerFormat(p: *Parser) -> void {
    const s = p.*.current
    while true {
        const c = peek(p)
        if c == 44 {
            s.*.widthExceptAffixes += 1
            s.*.groupingSizes <<= 16
        } else if c == 35 {
            if s.*.integerNumerals > 0 {
                fail(p, UNEXPECTED_TOKEN)
                return
            }
            s.*.widthExceptAffixes += 1
            s.*.groupingSizes += 1
            if s.*.integerAtSigns > 0 {
                s.*.integerTrailingHashSigns += 1
            } else {
                s.*.integerLeadingHashSigns += 1
            }
            s.*.integerTotal += 1
        } else if c == 64 {
            if s.*.integerNumerals > 0 || s.*.integerTrailingHashSigns > 0 {
                fail(p, UNEXPECTED_TOKEN)
                return
            }
            s.*.widthExceptAffixes += 1
            s.*.groupingSizes += 1
            s.*.integerAtSigns += 1
            s.*.integerTotal += 1
        } else if isDigit(c) {
            if s.*.integerAtSigns > 0 {
                fail(p, UNEXPECTED_TOKEN)
                return
            }
            s.*.widthExceptAffixes += 1
            s.*.groupingSizes += 1
            s.*.integerNumerals += 1
            s.*.integerTotal += 1
            addRounding(s, @intCast(u8, c))
        } else {
            break
        }
        _ = next(p)
    }
    const g1 = grouping(s, 0)
    const g2 = grouping(s, 1)
    const g3 = grouping(s, 2)
    if g1 == 0 && g2 != -1 {
        fail(p, UNEXPECTED_TOKEN)
        return
    }
    if g2 == 0 && g3 != -1 {
        fail(p, PATTERN_SYNTAX_ERROR)
        return
    }
}

fn consumeFractionFormat(p: *Parser) -> void {
    const s = p.*.current
    addRounding(s, 46)
    while true {
        const c = peek(p)
        if c == 35 {
            s.*.widthExceptAffixes += 1
            s.*.fractionHashSigns += 1
            s.*.fractionTotal += 1
        } else if isDigit(c) {
            if s.*.fractionHashSigns > 0 {
                fail(p, UNEXPECTED_TOKEN)
                return
            }
            s.*.widthExceptAffixes += 1
            s.*.fractionNumerals += 1
            s.*.fractionTotal += 1
            addRounding(s, @intCast(u8, c))
        } else {
            return
        }
        _ = next(p)
    }
}

fn consumeFormat(p: *Parser) -> void {
    const s = p.*.current
    consumeIntegerFormat(p)
    if failed(p) { return }
    const c = peek(p)
    if c == 46 {
        _ = next(p)
        s.*.hasDecimal = true
        s.*.widthExceptAffixes += 1
        consumeFractionFormat(p)
    } else if c == 164 {
        const after = peek2(p)
        if !(after == 35 || isDigit(after)) { return }
        s.*.hasCurrencySign = true
        s.*.hasCurrencyDecimal = true
        s.*.hasDecimal = true
        s.*.widthExceptAffixes += 1
        _ = next(p)
        consumeFractionFormat(p)
    }
}

fn consumeExponent(p: *Parser) -> void {
    const s = p.*.current
    if peek(p) != 69 { return }
    if (s.*.groupingSizes & 4294901760) != 4294901760 {
        fail(p, MALFORMED_EXPONENTIAL_PATTERN)
        return
    }
    _ = next(p)
    s.*.widthExceptAffixes += 1
    if peek(p) == 43 {
        _ = next(p)
        s.*.exponentHasPlusSign = true
        s.*.widthExceptAffixes += 1
    }
    while peek(p) == 48 {
        _ = next(p)
        s.*.exponentZeros += 1
        s.*.widthExceptAffixes += 1
    }
}

fn consumeSubpattern(p: *Parser) -> void {
    consumePadding(p, PAD_BEFORE_PREFIX)
    if failed(p) { return }
    consumeAffix(p, true)
    if failed(p) { return }
    consumePadding(p, PAD_AFTER_PREFIX)
    if failed(p) { return }
    consumeFormat(p)
    if failed(p) { return }
    consumeExponent(p)
    if failed(p) { return }
    consumePadding(p, PAD_BEFORE_SUFFIX)
    if failed(p) { return }
    consumeAffix(p, false)
    if failed(p) { return }
    consumePadding(p, PAD_AFTER_SUFFIX)
}

// Parses PATTERN into INFO (INFO's error is ICU's status of it).
pub fn parse(pattern: []const u8, info: *Info) -> void {
    info.*.text = pattern
    info.*.hasNegative = false
    info.*.fault = 0
    info.*.faultOffset = 0
    initSubpattern(&info.*.positive)
    initSubpattern(&info.*.negative)
    var p = Parser.{ .info = info, .current = &info.*.positive, .at = 0 }
    consumeSubpattern(&p)
    if failed(&p) { return }
    if peek(&p) == 59 {
        _ = next(&p)
        if peek(&p) != END {
            info.*.hasNegative = true
            p.current = &info.*.negative
            consumeSubpattern(&p)
            if failed(&p) { return }
        }
    }
    if peek(&p) != END { fail(&p, UNQUOTED_SPECIAL) }
}

// ---------------------------------------------------------------------------
// Affix patterns, from a parsed pattern or given on their own (a
// DecimalFormat's prefixes and suffixes).

pub const Affixes = struct {
    posPrefix: []const u8
    posSuffix: []const u8
    negPrefix: []const u8
    negSuffix: []const u8
    hasNegative: bool
    positiveHasPlusSign: bool
    negativeHasMinusSign: bool
    hasCurrencySign: bool
    hasBody: bool
    currencyAsDecimal: bool
    // Whether an affix has ¤¤¤ (a plural currency name).
    needsPlurals: bool
}

pub fn affixesOf(info: *const Info) -> Affixes {
    const text = info.*.text
    const pos = &info.*.positive
    const neg = &info.*.negative
    var a = Affixes.{
        .posPrefix = text[pos.*.prefixStart..pos.*.prefixEnd],
        .posSuffix = text[pos.*.suffixStart..pos.*.suffixEnd],
        .negPrefix = "",
        .negSuffix = "",
        .hasNegative = info.*.hasNegative,
        .positiveHasPlusSign = pos.*.hasPlusSign,
        .negativeHasMinusSign = neg.*.hasMinusSign,
        .hasCurrencySign = pos.*.hasCurrencySign || (info.*.hasNegative && neg.*.hasCurrencySign),
        .hasBody = pos.*.integerTotal > 0,
        .currencyAsDecimal = pos.*.hasCurrencyDecimal,
        .needsPlurals = false,
    }
    if info.*.hasNegative {
        a.negPrefix = text[neg.*.prefixStart..neg.*.prefixEnd]
        a.negSuffix = text[neg.*.suffixStart..neg.*.suffixEnd]
    }
    a.needsPlurals = hasCurrencyCount(text, 3)
    return a
}

// Affixes given as affix patterns (a DecimalFormat's properties), their
// flags read from them as ICU's PropertiesAffixPatternProvider does.
pub fn affixesOfPatterns(posPrefix: []const u8, posSuffix: []const u8, negPrefix: []const u8, negSuffix: []const u8, hasNegative: bool) -> Affixes {
    var a = Affixes.{
        .posPrefix = posPrefix,
        .posSuffix = posSuffix,
        .negPrefix = negPrefix,
        .negSuffix = negSuffix,
        .hasNegative = hasNegative,
        .positiveHasPlusSign = containsType(posPrefix, TOKEN_PLUS) || containsType(posSuffix, TOKEN_PLUS),
        .negativeHasMinusSign = containsType(negPrefix, TOKEN_MINUS) || containsType(negSuffix, TOKEN_MINUS),
        .hasCurrencySign = hasCurrency(posPrefix) || hasCurrency(posSuffix) || (hasNegative && (hasCurrency(negPrefix) || hasCurrency(negSuffix))),
        .hasBody = true,
        .currencyAsDecimal = false,
        .needsPlurals = hasCurrencyCount(posPrefix, 3) || hasCurrencyCount(posSuffix, 3) || hasCurrencyCount(negPrefix, 3) || hasCurrencyCount(negSuffix, 3),
    }
    return a
}

// ---------------------------------------------------------------------------
// The tokens of an affix pattern (ICU's AffixUtils).

pub const TOKEN_LITERAL: i32 = 0
pub const TOKEN_MINUS: i32 = -1
pub const TOKEN_PLUS: i32 = -2
pub const TOKEN_PERCENT: i32 = -4
pub const TOKEN_PERMILLE: i32 = -5
pub const TOKEN_APPROXIMATELY: i32 = -3
// ¤ to ¤¤¤¤¤: -6 to -10, more: -15 (overflow).
pub const TOKEN_CURRENCY_SINGLE: i32 = -6
pub const TOKEN_CURRENCY_DOUBLE: i32 = -7
pub const TOKEN_CURRENCY_TRIPLE: i32 = -8
pub const TOKEN_CURRENCY_QUAD: i32 = -9
pub const TOKEN_CURRENCY_QUINT: i32 = -10
pub const TOKEN_CURRENCY_OVERFLOW: i32 = -15

pub const Token = struct {
    kind: i32
    codePoint: u32
}

// The next token of PATTERN at AT (AT and the quoting STATE moved on);
// false at the end.
pub fn nextToken(pattern: []const u8, at: *usize, state: *i32, token: *Token) -> bool {
    // States: 0 base, 1 first quote, 2 inside quote, 3 after quote.
    while at.* < pattern.length {
        const start = at.*
        var after = at.*
        const c = nd.decode(pattern, &after)
        const s = state.*
        if s == 0 || s == 3 {
            if c == 39 {
                if s == 3 {
                    // A quote after a quoted part: a literal quote.
                    at.* = after
                    state.* = 2
                    token.* = Token.{ .kind = TOKEN_LITERAL, .codePoint = 39 }
                    return true
                }
                state.* = 1
                at.* = after
                continue
            }
            state.* = 0
            if c == 45 || c == 43 || c == 126 || c == 37 || c == 8240 {
                at.* = after
                const kind = if c == 45 { TOKEN_MINUS } else if c == 43 { TOKEN_PLUS } else if c == 126 { TOKEN_APPROXIMATELY } else if c == 37 { TOKEN_PERCENT } else { TOKEN_PERMILLE }
                token.* = Token.{ .kind = kind, .codePoint = 0 }
                return true
            }
            if c == 164 {
                var count: i32 = 0
                var end = start
                while end < pattern.length {
                    var probe = end
                    if nd.decode(pattern, &probe) != 164 { break }
                    end = probe
                    count += 1
                }
                at.* = end
                const kind = if count > 5 { TOKEN_CURRENCY_OVERFLOW } else { TOKEN_CURRENCY_SINGLE - (count - 1) }
                token.* = Token.{ .kind = kind, .codePoint = 0 }
                return true
            }
            at.* = after
            token.* = Token.{ .kind = TOKEN_LITERAL, .codePoint = c }
            return true
        }
        if s == 1 {
            at.* = after
            if c == 39 {
                state.* = 0
                token.* = Token.{ .kind = TOKEN_LITERAL, .codePoint = 39 }
                return true
            }
            state.* = 2
            token.* = Token.{ .kind = TOKEN_LITERAL, .codePoint = c }
            return true
        }
        // Inside a quote.
        at.* = after
        if c == 39 {
            state.* = 3
            continue
        }
        token.* = Token.{ .kind = TOKEN_LITERAL, .codePoint = c }
        return true
    }
    return false
}

pub fn containsType(pattern: []const u8, kind: i32) -> bool {
    var at: usize = 0
    var state: i32 = 0
    var token = Token.{ .kind = 0, .codePoint = 0 }
    while nextToken(pattern, &at, &state, &token) {
        if token.kind == kind { return true }
    }
    return false
}

fn hasCurrency(pattern: []const u8) -> bool {
    var at: usize = 0
    var state: i32 = 0
    var token = Token.{ .kind = 0, .codePoint = 0 }
    while nextToken(pattern, &at, &state, &token) {
        if token.kind <= TOKEN_CURRENCY_SINGLE { return true }
    }
    return false
}

// Whether TEXT has a run of exactly COUNT currency signs as a token.
fn hasCurrencyCount(text: []const u8, count: i32) -> bool { return containsType(text, TOKEN_CURRENCY_SINGLE - (count - 1)) }

// The number of code points PATTERN's literals and symbols take, as
// AffixUtils::estimateLength counts them (each symbol one).
pub fn estimateLength(pattern: []const u8) -> i32 {
    var length: i32 = 0
    var at: usize = 0
    var state: i32 = 0
    while at < pattern.length {
        const c = nd.decode(pattern, &at)
        if state == 0 {
            if c == 39 { state = 1 } else { length += 1 }
        } else if state == 1 {
            length += 1
            state = if c == 39 { 0 } else { 2 }
        } else if state == 2 {
            if c == 39 { state = 3 } else { length += 1 }
        } else {
            length += 1
            if c == 39 { state = 2 } else { state = 0 }
        }
    }
    return length
}

// ---------------------------------------------------------------------------
// The affix a sign display makes of a pattern's (patternInfoToStringBuilder).

// PatternSignType.
pub const SIGN_POS: i32 = 0
pub const SIGN_POS_SIGN: i32 = 1
pub const SIGN_NEG: i32 = 2

// The pattern sign type of a sign display and signum (ICU's
// resolveSignDisplay; signum as numberquantity's: 0 neg, 1 -0, 2 +0, 3 pos).
pub fn resolveSign(display: i32, signum: i32) -> i32 {
    const negative = signum == 0
    const negativeZero = signum == 1
    const positive = signum == 3
    if display == 0 || display == 3 {
        return if negative || negativeZero { SIGN_NEG } else { SIGN_POS }
    }
    if display == 1 || display == 4 {
        return if negative || negativeZero { SIGN_NEG } else { SIGN_POS_SIGN }
    }
    if display == 5 || display == 6 {
        if negative { return SIGN_NEG }
        return if positive { SIGN_POS_SIGN } else { SIGN_POS }
    }
    if display == 7 || display == 8 {
        return if negative { SIGN_NEG } else { SIGN_POS }
    }
    return SIGN_POS
}

// The affix pattern to render for the prefix (IS_PREFIX) or suffix, with
// the sign put in, into OUT.
pub fn affixPattern(a: *const Affixes, isPrefix: bool, signType: i32, approximately: bool, perMille: bool, out: *m.Bytes) -> void {
    const plusReplacesMinus = signType == SIGN_POS_SIGN && !a.*.positiveHasPlusSign
    const useNegative = a.*.hasNegative && (signType == SIGN_NEG || (a.*.negativeHasMinusSign && (plusReplacesMinus || approximately)))
    var prependSign = false
    if !isPrefix || useNegative {
        prependSign = false
    } else if signType == SIGN_NEG {
        prependSign = true
    } else {
        prependSign = plusReplacesMinus || approximately
    }
    // What takes the place of '-'.
    var sign: []const u8 = "-"
    if approximately {
        sign = if plusReplacesMinus { "~+" } else if signType == SIGN_NEG { "~-" } else { "~" }
    } else if plusReplacesMinus {
        sign = "+"
    }
    const pattern = if useNegative { if isPrefix { a.*.negPrefix } else { a.*.negSuffix } } else { if isPrefix { a.*.posPrefix } else { a.*.posSuffix } }
    if prependSign { put(out, 45, sign, perMille) }
    var at: usize = 0
    while at < pattern.length {
        const c = nd.decode(pattern, &at)
        put(out, c, sign, perMille)
    }
}

fn put(out: *m.Bytes, c: u32, sign: []const u8, perMille: bool) -> void {
    if c == 45 {
        m.pushText(out, sign)
        return
    }
    if perMille && c == 37 {
        nd.appendUtf8(out, 8240)
        return
    }
    nd.appendUtf8(out, c)
}

// What a formatter gives for the symbols of affixes.
pub const SymbolText = struct {
    minus: []const u8
    plus: []const u8
    approximately: []const u8
    percent: []const u8
    permille: []const u8
    currencySingle: []const u8
    currencyDouble: []const u8
    currencyTriple: []const u8
}

// Writes affix pattern PATTERN into B at INDEX: symbols with their
// fields, literals with LITERAL_FIELD; the units written.
pub fn render(pattern: []const u8, symbols: *const SymbolText, b: *nb.Builder, index: usize, literalField: u8) -> usize {
    var length: usize = 0
    var at: usize = 0
    var state: i32 = 0
    var token = Token.{ .kind = 0, .codePoint = 0 }
    while nextToken(pattern, &at, &state, &token) {
        const k = token.kind
        if k == TOKEN_LITERAL {
            length += nb.insertCodePoint(b, index + length, token.codePoint, literalField)
        } else if k == TOKEN_MINUS {
            length += nb.insertText(b, index + length, symbols.*.minus, nb.numberField(nb.SIGN))
        } else if k == TOKEN_PLUS {
            length += nb.insertText(b, index + length, symbols.*.plus, nb.numberField(nb.SIGN))
        } else if k == TOKEN_APPROXIMATELY {
            length += nb.insertText(b, index + length, symbols.*.approximately, nb.numberField(nb.APPROXIMATELY_SIGN))
        } else if k == TOKEN_PERCENT {
            length += nb.insertText(b, index + length, symbols.*.percent, nb.numberField(nb.PERCENT))
        } else if k == TOKEN_PERMILLE {
            length += nb.insertText(b, index + length, symbols.*.permille, nb.numberField(nb.PERMILL))
        } else if k == TOKEN_CURRENCY_SINGLE {
            length += nb.insertText(b, index + length, symbols.*.currencySingle, nb.numberField(nb.CURRENCY))
        } else if k == TOKEN_CURRENCY_DOUBLE {
            length += nb.insertText(b, index + length, symbols.*.currencyDouble, nb.numberField(nb.CURRENCY))
        } else if k == TOKEN_CURRENCY_TRIPLE {
            length += nb.insertText(b, index + length, symbols.*.currencyTriple, nb.numberField(nb.CURRENCY))
        } else {
            // ¤¤¤¤, ¤¤¤¤¤ and longer runs: U+FFFD.
            length += nb.insertCodePoint(b, index + length, 65533, nb.numberField(nb.CURRENCY))
        }
    }
    return length
}
