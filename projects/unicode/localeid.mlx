// Locale IDs (uloc.h), as ICU has them: `ll_Ssss_RR_VARIANT@key=value;...`
// (language lower case, script title case, region upper case, variants
// upper case, keywords sorted), BCP 47 language tags to and from them
// (the -u- extension as keywords under their legacy names, -t- and the
// others as one-letter keywords, -x- as x=...), likely subtags (CLDR's,
// UTS #35's algorithm), the keywords of an ID, the BCP 47 keys and types
// and their legacy names. The data is CLDR's (locales.mlx, made by
// cldrgenerate.mlx).
const m = @import("./memory.mlx")
const displaynames = @import("./displaynames.mlx")
const data = @import("./locales.mlx")
const enumeration = @import("./enumeration.mlx")
const p = @import("./properties.mlx")
const locale = @import("./locale.mlx")

const NONE: usize = 999999

// ---------------------------------------------------------------------------
// Characters

fn isLetter(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn isAlnum(c: u8) -> bool { return isLetter(c) || isDigit(c) }
fn lower(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }
fn upper(c: u8) -> u8 { return if c >= 97 && c <= 122 { c - 32 } else { c } }
fn isSeparator(c: u8) -> bool { return c == 95 || c == 45 }
fn isTerminator(c: u8) -> bool { return c == 46 || c == 64 }

fn sameIgnoringCase(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var i: usize = 0
    while i < a.length {
        if lower(a[i]) != lower(b[i]) { return false }
        i += 1
    }
    return true
}

fn allLetters(s: []const u8) -> bool {
    for c in s {
        if !isLetter(c) { return false }
    }
    return true
}

fn allDigits(s: []const u8) -> bool {
    for c in s {
        if !isDigit(c) { return false }
    }
    return true
}

fn allAlnum(s: []const u8) -> bool {
    for c in s {
        if !isAlnum(c) { return false }
    }
    return true
}

fn compare(a: []const u8, b: []const u8) -> i32 {
    var i: usize = 0
    while i < a.length && i < b.length {
        if a[i] != b[i] { return if a[i] < b[i] { -1 } else { 1 } }
        i += 1
    }
    if a.length == b.length { return 0 }
    return if a.length < b.length { -1 } else { 1 }
}

// ---------------------------------------------------------------------------
// The tables of locales.mlx: entries ended by NUL, sorted.

const Table = struct {
    keys: []const u8
    keyStarts: [*]const u32
    values: []const u8
    valueStarts: [*]const u32
    count: usize
}

fn keyAt(t: *const Table, index: usize) -> []const u8 {
    const start = @intCast(usize, t.*.keyStarts[index])
    const end = @intCast(usize, t.*.keyStarts[index + 1]) - 1
    return t.*.keys[start..end]
}

fn valueAt(t: *const Table, index: usize) -> []const u8 {
    const start = @intCast(usize, t.*.valueStarts[index])
    const end = @intCast(usize, t.*.valueStarts[index + 1]) - 1
    return t.*.values[start..end]
}

fn find(t: *const Table, key: []const u8) -> usize {
    var low: usize = 0
    var high = t.*.count
    while low < high {
        const middle = (low + high) / 2
        const order = compare(keyAt(t, middle), key)
        if order == 0 { return middle }
        if order < 0 { low = middle + 1 } else { high = middle }
    }
    return NONE
}

fn tableOf(keys: []const u8, keyStarts: [*]const u32, values: []const u8, valueStarts: [*]const u32, count: usize) -> Table {
    return Table.{ .keys = keys, .keyStarts = keyStarts, .values = values, .valueStarts = valueStarts, .count = count }
}

fn likelyTable() -> Table { return tableOf(data.LIKELY_KEYS, unsafe { @ptrCast([*]const u32, &data.LIKELY_KEYS_STARTS) }, data.LIKELY_VALUES, unsafe { @ptrCast([*]const u32, &data.LIKELY_VALUES_STARTS) }, data.LIKELY_COUNT) }
fn languageOverlong() -> Table { return tableOf(data.LANGUAGE_OVERLONG_KEYS, unsafe { @ptrCast([*]const u32, &data.LANGUAGE_OVERLONG_KEYS_STARTS) }, data.LANGUAGE_OVERLONG_VALUES, unsafe { @ptrCast([*]const u32, &data.LANGUAGE_OVERLONG_VALUES_STARTS) }, data.LANGUAGE_OVERLONG_COUNT) }
fn territoryOverlong() -> Table { return tableOf(data.TERRITORY_OVERLONG_KEYS, unsafe { @ptrCast([*]const u32, &data.TERRITORY_OVERLONG_KEYS_STARTS) }, data.TERRITORY_OVERLONG_VALUES, unsafe { @ptrCast([*]const u32, &data.TERRITORY_OVERLONG_VALUES_STARTS) }, data.TERRITORY_OVERLONG_COUNT) }
fn languageAliases() -> Table { return tableOf(data.LANGUAGE_ALIAS_KEYS, unsafe { @ptrCast([*]const u32, &data.LANGUAGE_ALIAS_KEYS_STARTS) }, data.LANGUAGE_ALIAS_VALUES, unsafe { @ptrCast([*]const u32, &data.LANGUAGE_ALIAS_VALUES_STARTS) }, data.LANGUAGE_ALIAS_COUNT) }
fn keyTable() -> Table { return tableOf(data.KEY_KEYS, unsafe { @ptrCast([*]const u32, &data.KEY_KEYS_STARTS) }, data.KEY_VALUES, unsafe { @ptrCast([*]const u32, &data.KEY_VALUES_STARTS) }, data.KEY_COUNT) }
fn legacyKeyTable() -> Table { return tableOf(data.LEGACY_KEY_KEYS, unsafe { @ptrCast([*]const u32, &data.LEGACY_KEY_KEYS_STARTS) }, data.LEGACY_KEY_VALUES, unsafe { @ptrCast([*]const u32, &data.LEGACY_KEY_VALUES_STARTS) }, data.LEGACY_KEY_COUNT) }
fn typeTable() -> Table { return tableOf(data.TYPE_KEYS, unsafe { @ptrCast([*]const u32, &data.TYPE_KEYS_STARTS) }, data.TYPE_VALUES, unsafe { @ptrCast([*]const u32, &data.TYPE_VALUES_STARTS) }, data.TYPE_COUNT) }
fn legacyTypeTable() -> Table { return tableOf(data.LEGACY_TYPE_KEYS, unsafe { @ptrCast([*]const u32, &data.LEGACY_TYPE_KEYS_STARTS) }, data.LEGACY_TYPE_VALUES, unsafe { @ptrCast([*]const u32, &data.LEGACY_TYPE_VALUES_STARTS) }, data.LEGACY_TYPE_COUNT) }
fn specialTable() -> Table { return tableOf(data.SPECIAL_TYPE_KEYS, unsafe { @ptrCast([*]const u32, &data.SPECIAL_TYPE_KEYS_STARTS) }, data.SPECIAL_TYPE_VALUES, unsafe { @ptrCast([*]const u32, &data.SPECIAL_TYPE_VALUES_STARTS) }, data.SPECIAL_TYPE_COUNT) }
fn alpha3Table() -> Table { return tableOf(data.ALPHA3_KEYS, unsafe { @ptrCast([*]const u32, &data.ALPHA3_KEYS_STARTS) }, data.ALPHA3_VALUES, unsafe { @ptrCast([*]const u32, &data.ALPHA3_VALUES_STARTS) }, data.ALPHA3_COUNT) }
fn availableTable() -> Table { return tableOf(data.AVAILABLE_KEYS, unsafe { @ptrCast([*]const u32, &data.AVAILABLE_KEYS_STARTS) }, data.AVAILABLE_VALUES, unsafe { @ptrCast([*]const u32, &data.AVAILABLE_VALUES_STARTS) }, data.AVAILABLE_COUNT) }

// The address of a table entry, a C string.
fn address(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

// ---------------------------------------------------------------------------
// Scratch text

fn push(b: *m.Bytes, c: u8) -> void { m.pushByte(b, c) }
fn pushText(b: *m.Bytes, s: []const u8) -> void { m.pushText(b, s) }
fn text(b: *m.Bytes) -> []const u8 { return m.bytesText(b) }
fn dispose(b: *m.Bytes) -> void { m.disposeBytes(b) }
fn fresh() -> m.Bytes { return m.bytesBuffer() }

fn pushLower(b: *m.Bytes, s: []const u8) -> void {
    for c in s { push(b, lower(c)) }
}

fn pushUpper(b: *m.Bytes, s: []const u8) -> void {
    for c in s { push(b, upper(c)) }
}

fn pushTitle(b: *m.Bytes, s: []const u8) -> void {
    var i: usize = 0
    while i < s.length {
        push(b, if i == 0 { upper(s[i]) } else { lower(s[i]) })
        i += 1
    }
}

// ---------------------------------------------------------------------------
// The subtags of an ICU locale ID (ICU's ulocimp_getSubtags)

const Subtags = struct {
    language: m.Bytes
    script: m.Bytes
    region: m.Bytes
    variant: m.Bytes
    // Where the subtags end in the ID.
    end: usize
    ok: bool
}

fn disposeSubtags(s: *Subtags) -> void {
    dispose(&s.*.language)
    dispose(&s.*.script)
    dispose(&s.*.region)
    dispose(&s.*.variant)
}

fn isBCP47Extension(id: []const u8, at: usize) -> bool {
    if at + 3 > id.length { return false }
    const c = lower(id[at + 1])
    return id[at] == 45 && (c == 116 || c == 117 || c == 120) && id[at + 2] == 45
}

fn getSubtags(id: []const u8) -> Subtags {
    var s = Subtags.{ .language = fresh(), .script = fresh(), .region = fresh(), .variant = fresh(), .end = 0, .ok = true }
    const n = id.length
    var pos: usize = 0
    if n == 0 { return s }
    // The language ("root" and "und" are none).
    if n == 4 && sameIgnoringCase(id, "root") {
        pos = 4
    } else if n >= 3 && sameIgnoringCase(id[0..3], "und") && (n == 3 || id[3] == 45 || id[3] == 95 || id[3] == 64) {
        pos = 3
    }
    const start = pos
    var length: usize = if n - pos >= 2 && (lower(id[pos]) == 120 || lower(id[pos]) == 105) && isSeparator(id[pos + 1]) { 2 } else { 0 }
    while pos + length < n && !isTerminator(id[pos + length]) && !isSeparator(id[pos + length]) {
        if length == 11 {
            s.ok = false
            return s
        }
        length += 1
    }
    if length > 0 {
        var lang = fresh()
        var i: usize = 0
        while i < length {
            push(&lang, if i == 1 && isSeparator(id[start + 1]) { 45 } else { lower(id[start + i]) })
            i += 1
        }
        const overlong = languageOverlong()
        const found = if length == 3 { find(&overlong, text(&lang)) } else { NONE }
        if found != NONE { pushText(&s.language, valueAt(&overlong, found)) } else { pushText(&s.language, text(&lang)) }
        dispose(&lang)
    }
    pos += length
    s.end = pos
    if pos >= n { return s }
    // The script.
    if isSeparator(id[pos]) {
        var len: usize = 0
        while pos + 1 + len < n && !isTerminator(id[pos + 1 + len]) && !isSeparator(id[pos + 1 + len]) && isLetter(id[pos + 1 + len]) {
            if len == 4 { len = 5 }
            if len == 5 { break }
            len += 1
        }
        const ends = pos + 1 + len >= n || isTerminator(id[pos + 1 + len]) || isSeparator(id[pos + 1 + len])
        if len == 4 && ends {
            pushTitle(&s.script, id[pos + 1..pos + 5])
            pos += 5
            s.end = pos
        }
    }
    if pos >= n { return s }
    // The region.
    var hasRegion = false
    if isSeparator(id[pos]) {
        var len: usize = 0
        while pos + 1 + len < n && !isTerminator(id[pos + 1 + len]) && !isSeparator(id[pos + 1 + len]) {
            len += 1
            if len > 3 { break }
        }
        if len >= 2 && len <= 3 {
            var region = fresh()
            pushUpper(&region, id[pos + 1..pos + 1 + len])
            const overlong = territoryOverlong()
            const found = if len == 3 && allLetters(text(&region)) { find(&overlong, text(&region)) } else { NONE }
            if found != NONE { pushText(&s.region, valueAt(&overlong, found)) } else { pushText(&s.region, text(&region)) }
            dispose(&region)
            hasRegion = true
            pos += len + 1
            s.end = pos
        }
    }
    if pos >= n { return s }
    // The variants.
    if isSeparator(id[pos]) && !isBCP47Extension(id, pos) {
        const skip: usize = if !hasRegion && pos + 1 < n && isSeparator(id[pos + 1]) { 2 } else { 1 }
        var at = pos + skip
        var any = false
        while at < n {
            var next = at
            while next < n && !isTerminator(id[next]) && !isSeparator(id[next]) { next += 1 }
            // A trailing separator is kept in the variant, as ICU does.
            const finished = next >= n || next + 1 == n
            const limit = if finished { n } else { next }
            if any { push(&s.variant, 95) }
            pushUpper(&s.variant, id[at..limit])
            any = true
            if finished {
                at = n
                break
            }
            if isTerminator(id[next]) || isBCP47Extension(id, next) {
                at = next
                break
            }
            at = next + 1
        }
        if any {
            pos = at
            s.end = pos
        }
    }
    return s
}

// ---------------------------------------------------------------------------
// Keywords: `@key=value;key=value`, keys lower case, sorted.

const MAX_KEYWORDS: usize = 32

const Keywords = struct {
    count: usize
    keys: [32][]const u8
    values: [32][]const u8
    storage: m.Bytes
}

fn trim(s: []const u8) -> []const u8 {
    var start: usize = 0
    var end = s.length
    while start < end && s[start] == 32 { start += 1 }
    while end > start && s[end - 1] == 32 { end -= 1 }
    return s[start..end]
}

// The keywords of `id` from its '@' (none without one). The keys are
// lowered copies; the values slices of `id`.
fn getKeywords(id: []const u8) -> Keywords {
    var k = Keywords.{ .count = 0, .keys = undefined, .values = undefined, .storage = fresh() }
    var at: usize = 0
    while at < id.length && id[at] != 64 { at += 1 }
    if at >= id.length { return k }
    at += 1
    // Keys are kept lowered in storage; their offsets first.
    var keyStarts: [32]usize = undefined
    var keyLengths: [32]usize = undefined
    while at < id.length && k.count < MAX_KEYWORDS {
        var end = at
        while end < id.length && id[end] != 59 { end += 1 }
        const item = id[at..end]
        var equals: usize = 0
        while equals < item.length && item[equals] != 61 { equals += 1 }
        if equals < item.length {
            const key = trim(item[0..equals])
            const value = trim(item[equals + 1..item.length])
            if key.length > 0 && allAlnum(key) && value.length > 0 {
                // Sorted insertion; a key seen before stays as it was.
                var lowered = fresh()
                pushLower(&lowered, key)
                var duplicate = false
                var i: usize = 0
                while i < k.count {
                    if sameIgnoringCase(id[keyStarts[i]..keyStarts[i] + keyLengths[i]], key) { duplicate = true }
                    i += 1
                }
                if !duplicate {
                    keyStarts[k.count] = @intFromPtr(key.pointer) - @intFromPtr(id.pointer)
                    keyLengths[k.count] = key.length
                    k.values[k.count] = value
                    k.count += 1
                }
                dispose(&lowered)
            }
        }
        at = end + 1
    }
    // The lowered keys in storage, then sorted together with the values.
    var offsets: [32]usize = undefined
    var i: usize = 0
    while i < k.count {
        offsets[i] = k.storage.length
        pushLower(&k.storage, id[keyStarts[i]..keyStarts[i] + keyLengths[i]])
        i += 1
    }
    i = 0
    while i < k.count {
        const end = if i + 1 < k.count { offsets[i + 1] } else { k.storage.length }
        k.keys[i] = m.bytes(k.storage.address + offsets[i], end - offsets[i])
        i += 1
    }
    i = 1
    while i < k.count {
        const key = k.keys[i]
        const value = k.values[i]
        var place = i
        while place > 0 && compare(k.keys[place - 1], key) > 0 {
            k.keys[place] = k.keys[place - 1]
            k.values[place] = k.values[place - 1]
            place -= 1
        }
        k.keys[place] = key
        k.values[place] = value
        i += 1
    }
    return k
}

fn pushKeywords(b: *m.Bytes, k: *Keywords) -> void {
    var i: usize = 0
    while i < k.*.count {
        push(b, if i == 0 { 64 } else { 59 })
        pushText(b, k.*.keys[i])
        push(b, 61)
        pushText(b, k.*.values[i])
        i += 1
    }
}

fn keywordIndex(k: *Keywords, key: []const u8) -> usize {
    var i: usize = 0
    while i < k.*.count {
        if sameIgnoringCase(k.*.keys[i], key) { return i }
        i += 1
    }
    return NONE
}

// ---------------------------------------------------------------------------
// IDs written: ICU's _canonicalize.

// The shortest subtag's length (an ID with one of 1 has an extension).
fn shortestSubtag(id: []const u8) -> usize {
    var shortest = id.length
    var current: usize = 0
    var reset = true
    for c in id {
        if c != 95 && c != 45 {
            if reset {
                current = 0
                reset = false
            }
            current += 1
        } else {
            if current != 0 && current < shortest { shortest = current }
            reset = true
        }
    }
    if !reset && current < shortest { shortest = current }
    return shortest
}

fn hasBCP47Extension(id: []const u8) -> bool {
    for c in id {
        if c == 64 { return false }
    }
    return shortestSubtag(id) == 1
}

const CANONICALIZE: u32 = 1
const STRIP_KEYWORDS: u32 = 2

// The ICU ID of `id` (which may be a language tag with extensions) into
// `out`; false when ill-formed.
fn canonicalize(id: []const u8, options: u32, out: *m.Bytes) -> bool {
    var converted = fresh()
    var source = id
    if hasBCP47Extension(id) {
        var hyphens = fresh()
        var i: usize = 0
        const convert = id.length >= 2 && !isSeparator(id[1])
        while i < id.length {
            push(&hyphens, if convert && id[i] == 95 { 45 } else { id[i] })
            i += 1
        }
        var parsed: usize = 0
        if forLanguageTag(text(&hyphens), &converted, &parsed) && converted.length > 0 { source = text(&converted) } else { source = text(&hyphens) }
        if converted.length == 0 {
            dispose(&converted)
            converted = hyphens
        } else {
            dispose(&hyphens)
        }
    }
    var s = getSubtags(source)
    if !s.ok {
        disposeSubtags(&s)
        dispose(&converted)
        return false
    }
    var tag = fresh()
    pushText(&tag, text(&s.language))
    var fieldCount: usize = 0
    if s.script.length > 0 {
        fieldCount += 1
        push(&tag, 95)
        pushText(&tag, text(&s.script))
    }
    if s.region.length > 0 {
        fieldCount += 1
        push(&tag, 95)
        pushText(&tag, text(&s.region))
    }
    if s.variant.length > 0 {
        fieldCount += 1
        if s.region.length == 0 { push(&tag, 95) }
        push(&tag, 95)
        pushText(&tag, text(&s.variant))
    }
    var rest = source[s.end..source.length]
    // A POSIX charset (`.utf8`) kept, unless canonicalizing.
    if rest.length > 0 && rest[0] == 46 {
        var end: usize = 1
        while end < rest.length && rest[end] != 64 { end += 1 }
        if (options & CANONICALIZE) == 0 { pushText(&tag, rest[0..end]) }
        rest = rest[end..rest.length]
    }
    var keywordsStart: usize = 0
    while keywordsStart < rest.length && rest[keywordsStart] != 64 { keywordsStart += 1 }
    rest = rest[keywordsStart..rest.length]
    var hasAssign = false
    for c in rest {
        if c == 61 { hasAssign = true }
    }
    // `@FOO` (no `=`): a POSIX variant.
    if rest.length > 0 && !hasAssign {
        if (options & CANONICALIZE) == 0 {
            pushText(&tag, rest)
        } else {
            if fieldCount < 2 || (fieldCount < 3 && s.script.length > 0) {
                while true {
                    push(&tag, 95)
                    fieldCount += 1
                    if fieldCount >= 2 { break }
                }
            }
            if s.variant.length > 0 { push(&tag, 95) }
            pushUpper(&tag, rest[1..rest.length])
        }
        rest = ""
    }
    if (options & CANONICALIZE) != 0 { canonicalizeMap(&tag, rest.length > 0) }
    pushText(out, text(&tag))
    if (options & STRIP_KEYWORDS) == 0 && rest.length > 0 && hasAssign {
        var k = getKeywords(rest)
        pushKeywords(out, &k)
        dispose(&k.storage)
    }
    dispose(&tag)
    disposeSubtags(&s)
    dispose(&converted)
    return true
}

// ICU's CANONICALIZE_MAP: registered names.
fn canonicalizeMap(tag: *m.Bytes, hasKeywords: bool) -> void {
    const current = text(tag)
    var replacement: []const u8 = ""
    if m.same(current, "art__LOJBAN") { replacement = "jbo" }
    if m.same(current, "hy__AREVELA") { replacement = "hy" }
    if m.same(current, "hy__AREVMDA") { replacement = "hyw" }
    if m.same(current, "zh__GUOYU") { replacement = "zh" }
    if m.same(current, "zh__HAKKA") { replacement = "hak" }
    if m.same(current, "zh__XIANG") { replacement = "hsn" }
    if m.same(current, "zh_GAN") { replacement = "gan" }
    if m.same(current, "zh_MIN_NAN") { replacement = "nan" }
    if m.same(current, "zh_WUU") { replacement = "wuu" }
    if m.same(current, "zh_YUE") { replacement = "yue" }
    if replacement.length > 0 {
        dispose(tag)
        tag.* = fresh()
        pushText(tag, replacement)
    }
}

// ---------------------------------------------------------------------------
// BCP 47 keys and types

fn isUnicodeLocaleKey(s: []const u8) -> bool { return s.length == 2 && isAlnum(s[0]) && isLetter(s[1]) }

// Subtags of 3 to 8 alphanumerics, joined by `-` or `_`.
fn isUnicodeLocaleType(s: []const u8) -> bool {
    if s.length == 0 { return false }
    var count: usize = 0
    for c in s {
        if c == 45 || c == 95 {
            if count < 3 { return false }
            count = 0
        } else {
            if !isAlnum(c) { return false }
            count += 1
            if count > 8 { return false }
        }
    }
    return count >= 3
}

fn isWellFormedLegacyKey(s: []const u8) -> bool { return s.length > 0 && allAlnum(s) }

fn isWellFormedLegacyType(s: []const u8) -> bool {
    if s.length == 0 { return false }
    var count: usize = 0
    for c in s {
        if c == 45 || c == 95 {
            if count == 0 { return false }
            count = 0
        } else {
            if !isAlnum(c) { return false }
            count += 1
        }
    }
    return count > 0
}

// A key's BCP 47 name: from its legacy name, its own, or a well-formed
// one; "" when none.
fn bcpKey(key: []const u8) -> []const u8 {
    var lowered = fresh()
    pushLower(&lowered, key)
    const legacy = legacyKeyTable()
    var found = find(&legacy, text(&lowered))
    var result: []const u8 = ""
    if found != NONE {
        result = valueAt(&legacy, found)
    } else {
        const keys = keyTable()
        found = find(&keys, text(&lowered))
        if found != NONE { result = keyAt(&keys, found) }
    }
    dispose(&lowered)
    return result
}

fn legacyKey(key: []const u8) -> []const u8 {
    var lowered = fresh()
    pushLower(&lowered, key)
    const keys = keyTable()
    var found = find(&keys, text(&lowered))
    var result: []const u8 = ""
    if found != NONE {
        result = valueAt(&keys, found)
    } else {
        const legacy = legacyKeyTable()
        found = find(&legacy, text(&lowered))
        if found != NONE { result = keyAt(&legacy, found) }
    }
    dispose(&lowered)
    return result
}

// Whether `value` fits a key's special kind of type (CODEPOINTS...).
fn fitsSpecial(bcp: []const u8, value: []const u8) -> bool {
    const specials = specialTable()
    const found = find(&specials, bcp)
    if found == NONE { return false }
    const kind = valueAt(&specials, found)
    if m.same(kind, "CODEPOINTS") {
        var count: usize = 0
        for c in value {
            if c == 45 || c == 95 {
                if count < 4 || count > 6 { return false }
                count = 0
            } else {
                if !(isDigit(c) || (lower(c) >= 97 && lower(c) <= 102)) { return false }
                count += 1
            }
        }
        return count >= 4 && count <= 6
    }
    if m.same(kind, "REORDER_CODE") {
        var count: usize = 0
        for c in value {
            if c == 45 || c == 95 {
                if count < 3 || count > 8 { return false }
                count = 0
            } else {
                if !isLetter(c) { return false }
                count += 1
            }
        }
        return count >= 3 && count <= 8
    }
    if m.same(kind, "RG_KEY_VALUE") { return value.length == 6 && allAlnum(value) }
    return isUnicodeLocaleType(value)
}

// The type's BCP 47 name for a key; "" when it has none.
fn bcpType(key: []const u8, value: []const u8) -> []const u8 {
    const bcp = bcpKey(key)
    if bcp.length == 0 { return "" }
    var lookup = fresh()
    pushText(&lookup, bcp)
    push(&lookup, 47)
    pushLower(&lookup, value)
    const types = typeTable()
    var found = find(&types, text(&lookup))
    var result: []const u8 = ""
    if found != NONE {
        result = keyAt(&types, found)[bcp.length + 1..keyAt(&types, found).length]
    } else {
        const legacy = legacyTypeTable()
        found = find(&legacy, text(&lookup))
        if found != NONE { result = valueAt(&legacy, found) }
    }
    dispose(&lookup)
    return result
}

fn legacyType(key: []const u8, value: []const u8) -> []const u8 {
    const bcp = bcpKey(key)
    if bcp.length == 0 { return "" }
    var lookup = fresh()
    pushText(&lookup, bcp)
    push(&lookup, 47)
    pushLower(&lookup, value)
    const types = typeTable()
    var found = find(&types, text(&lookup))
    var result: []const u8 = ""
    if found != NONE {
        result = valueAt(&types, found)
    } else {
        const legacy = legacyTypeTable()
        found = find(&legacy, text(&lookup))
        if found != NONE {
            // The legacy name as the type table spells it.
            var again = fresh()
            pushText(&again, bcp)
            push(&again, 47)
            pushText(&again, valueAt(&legacy, found))
            const back = find(&types, text(&again))
            if back != NONE { result = valueAt(&types, back) }
            dispose(&again)
        }
    }
    dispose(&lookup)
    return result
}

// ---------------------------------------------------------------------------
// Language tags to IDs (ICU's ultag_parse and ulocimp_forLanguageTag)

fn isLanguageSubtag(s: []const u8) -> bool { return ((s.length >= 2 && s.length <= 3) || (s.length >= 5 && s.length <= 8)) && allLetters(s) }
fn isExtlangSubtag(s: []const u8) -> bool { return s.length == 3 && allLetters(s) }
fn isScriptSubtag(s: []const u8) -> bool { return s.length == 4 && allLetters(s) }
fn isRegionSubtag(s: []const u8) -> bool { return (s.length == 2 && allLetters(s)) || (s.length == 3 && allDigits(s)) }
fn isVariantSubtag(s: []const u8) -> bool { return (s.length >= 5 && s.length <= 8 && allAlnum(s)) || (s.length == 4 && isDigit(s[0]) && allAlnum(s)) }
fn isExtensionSingleton(s: []const u8) -> bool { return s.length == 1 && isAlnum(s[0]) && lower(s[0]) != 120 }
fn isExtensionSubtag(s: []const u8) -> bool { return s.length >= 2 && s.length <= 8 && allAlnum(s) }
fn isPrivateUseSubtag(s: []const u8) -> bool { return s.length >= 1 && s.length <= 8 && allAlnum(s) }

// The legacy (grandfathered) tags BCP 47 lists, as ICU replaces them.
fn legacyTag(tag: []const u8) -> []const u8 {
    if sameIgnoringCase(tag, "art-lojban") { return "jbo" }
    if sameIgnoringCase(tag, "en-gb-oed") { return "en-gb-oxendict" }
    if sameIgnoringCase(tag, "i-ami") { return "ami" }
    if sameIgnoringCase(tag, "i-bnn") { return "bnn" }
    if sameIgnoringCase(tag, "i-hak") { return "hak" }
    if sameIgnoringCase(tag, "i-klingon") { return "tlh" }
    if sameIgnoringCase(tag, "i-lux") { return "lb" }
    if sameIgnoringCase(tag, "i-navajo") { return "nv" }
    if sameIgnoringCase(tag, "i-pwn") { return "pwn" }
    if sameIgnoringCase(tag, "i-tao") { return "tao" }
    if sameIgnoringCase(tag, "i-tay") { return "tay" }
    if sameIgnoringCase(tag, "i-tsu") { return "tsu" }
    if sameIgnoringCase(tag, "no-bok") { return "nb" }
    if sameIgnoringCase(tag, "no-nyn") { return "nn" }
    if sameIgnoringCase(tag, "sgn-be-fr") { return "sfb" }
    if sameIgnoringCase(tag, "sgn-be-nl") { return "vgt" }
    if sameIgnoringCase(tag, "sgn-ch-de") { return "sgg" }
    if sameIgnoringCase(tag, "zh-guoyu") { return "cmn" }
    if sameIgnoringCase(tag, "zh-hakka") { return "hak" }
    if sameIgnoringCase(tag, "zh-min-nan") { return "nan" }
    if sameIgnoringCase(tag, "zh-xiang") { return "hsn" }
    if sameIgnoringCase(tag, "cel-gaulish") { return "xtg-x-cel-gaulish" }
    if sameIgnoringCase(tag, "i-default") { return "en-x-i-default" }
    if sameIgnoringCase(tag, "i-enochian") { return "und-x-i-enochian" }
    if sameIgnoringCase(tag, "i-mingo") { return "see-x-i-mingo" }
    if sameIgnoringCase(tag, "zh-min") { return "nan-x-zh-min" }
    return ""
}

const Extension = struct {
    singleton: u8
    start: usize
    end: usize
}

// Parses `tag` into the ICU ID `out`; the length of the well-formed
// prefix in `parsed`. False when not even a language is there.
fn forLanguageTag(tagIn: []const u8, out: *m.Bytes, parsed: *usize) -> bool {
    parsed.* = 0
    var tag = tagIn
    var legacyLength: usize = 0
    // A legacy tag, whole or followed by more.
    var cut: usize = 0
    while cut <= tag.length {
        if cut == tag.length || tag[cut] == 45 || tag[cut] == 95 {
            const replacement = legacyTag(tag[0..cut])
            if replacement.length > 0 {
                var replaced = fresh()
                pushText(&replaced, replacement)
                pushText(&replaced, tag[cut..tag.length])
                legacyLength = cut
                const ok = forLanguageTagPlain(text(&replaced), out, parsed)
                // What was parsed counts in the original tag.
                if parsed.* >= replacement.length { parsed.* = parsed.* - replacement.length + legacyLength } else { parsed.* = legacyLength }
                dispose(&replaced)
                return ok
            }
        }
        cut += 1
    }
    return forLanguageTagPlain(tag, out, parsed)
}

fn forLanguageTagPlain(tag: []const u8, out: *m.Bytes, parsed: *usize) -> bool {
    // The subtags, `-` or `_` between them.
    var starts: [64]usize = undefined
    var ends: [64]usize = undefined
    var count: usize = 0
    var at: usize = 0
    while at <= tag.length && count < 64 {
        const start = at
        while at < tag.length && tag[at] != 45 && tag[at] != 95 { at += 1 }
        starts[count] = start
        ends[count] = at
        count += 1
        at += 1
    }
    var index: usize = 0
    var language: []const u8 = ""
    var extlang: []const u8 = ""
    var script: []const u8 = ""
    var region: []const u8 = ""
    var variants: [16][]const u8 = undefined
    var variantCount: usize = 0
    var extensions: [16]Extension = undefined
    var extensionCount: usize = 0
    var privateStart: usize = NONE
    var privateEnd: usize = 0
    var end: usize = 0
    // A private use tag alone: x-...
    if count > 0 && sameIgnoringCase(tag[starts[0]..ends[0]], "x") {
        index = 0
    } else {
        if count == 0 || !isLanguageSubtag(tag[starts[0]..ends[0]]) { return false }
        language = tag[starts[0]..ends[0]]
        end = ends[0]
        index = 1
        var extlangs: usize = 0
        while index < count && extlangs < 3 && language.length <= 3 && isExtlangSubtag(tag[starts[index]..ends[index]]) {
            if extlangs == 0 { extlang = tag[starts[index]..ends[index]] }
            extlangs += 1
            end = ends[index]
            index += 1
        }
        if index < count && isScriptSubtag(tag[starts[index]..ends[index]]) {
            script = tag[starts[index]..ends[index]]
            end = ends[index]
            index += 1
        }
        if index < count && isRegionSubtag(tag[starts[index]..ends[index]]) {
            region = tag[starts[index]..ends[index]]
            end = ends[index]
            index += 1
        }
        while index < count && variantCount < 16 && isVariantSubtag(tag[starts[index]..ends[index]]) {
            const variant = tag[starts[index]..ends[index]]
            var duplicate = false
            var i: usize = 0
            while i < variantCount {
                if sameIgnoringCase(variants[i], variant) { duplicate = true }
                i += 1
            }
            if duplicate { break }
            variants[variantCount] = variant
            variantCount += 1
            end = ends[index]
            index += 1
        }
        // Extensions: a singleton, then subtags of 2 to 8.
        while index < count && extensionCount < 16 && isExtensionSingleton(tag[starts[index]..ends[index]]) {
            const singleton = lower(tag[starts[index]])
            var duplicate = false
            var i: usize = 0
            while i < extensionCount {
                if extensions[i].singleton == singleton { duplicate = true }
                i += 1
            }
            if duplicate { break }
            var j = index + 1
            while j < count && isExtensionSubtag(tag[starts[j]..ends[j]]) && !isExtensionSingletonOrPrivate(tag[starts[j]..ends[j]]) { j += 1 }
            if j == index + 1 { break }
            extensions[extensionCount] = Extension.{ .singleton = singleton, .start = starts[index + 1], .end = ends[j - 1] }
            extensionCount += 1
            end = ends[j - 1]
            index = j
        }
    }
    // Private use: x-, subtags of 1 to 8.
    if index < count && sameIgnoringCase(tag[starts[index]..ends[index]], "x") {
        var j = index + 1
        while j < count && isPrivateUseSubtag(tag[starts[j]..ends[j]]) { j += 1 }
        if j > index + 1 {
            privateStart = starts[index + 1]
            privateEnd = ends[j - 1]
            end = privateEnd
            index = j
        }
    }
    if language.length == 0 && privateStart == NONE { return false }
    parsed.* = end
    // The ID: language (the extlang's when there is one), script, region,
    // variants sorted.
    var isEmpty = true
    const lang = if extlang.length > 0 { extlang } else { language }
    if lang.length > 0 && !sameIgnoringCase(lang, "und") {
        pushLower(out, lang)
        isEmpty = false
    }
    if script.length > 0 {
        push(out, 95)
        pushTitle(out, script)
        isEmpty = false
    }
    if region.length > 0 {
        push(out, 95)
        pushUpper(out, region)
        isEmpty = false
    }
    // Variants sorted (case-insensitively), upper case.
    var i: usize = 1
    while i < variantCount {
        const v = variants[i]
        var place = i
        while place > 0 && compareIgnoringCase(variants[place - 1], v) > 0 {
            variants[place] = variants[place - 1]
            place -= 1
        }
        variants[place] = v
        i += 1
    }
    var posix = false
    if variantCount > 0 {
        if region.length == 0 { push(out, 95) }
        isEmpty = false
        i = 0
        while i < variantCount {
            push(out, 95)
            pushUpper(out, variants[i])
            i += 1
        }
    }
    // Keywords.
    var keywords = fresh()
    var keys: [48][]const u8 = undefined
    var values: [48][]const u8 = undefined
    var keywordCount: usize = 0
    var keywordText = fresh()
    var offsets: [96]usize = undefined
    var e: usize = 0
    while e < extensionCount {
        const ext = extensions[e]
        const body = tag[ext.start..ext.end]
        if ext.singleton == 117 {
            unicodeExtensionKeywords(body, &keywordText, &offsets, &keywordCount, variantCount > 0, &posix)
        } else {
            offsets[keywordCount * 2] = keywordText.length
            push(&keywordText, ext.singleton)
            offsets[keywordCount * 2 + 1] = keywordText.length
            pushLowerHyphens(&keywordText, body)
            keywordCount += 1
        }
        e += 1
    }
    if privateStart != NONE {
        offsets[keywordCount * 2] = keywordText.length
        push(&keywordText, 120)
        offsets[keywordCount * 2 + 1] = keywordText.length
        pushLowerHyphens(&keywordText, tag[privateStart..privateEnd])
        keywordCount += 1
    }
    if posix {
        if variantCount == 0 && region.length == 0 { push(out, 95) }
        push(out, 95)
        pushText(out, "POSIX")
        isEmpty = false
    }
    if keywordCount > 0 {
        if isEmpty && extensionCount > 0 { pushText(out, "und") }
        // Slices of keywordText: key i from offsets[2i], value after.
        var k: usize = 0
        while k < keywordCount {
            const keyEnd = offsets[k * 2 + 1]
            const valueEnd = if k + 1 < keywordCount { offsets[k * 2 + 2] } else { keywordText.length }
            keys[k] = m.bytes(keywordText.address + offsets[k * 2], keyEnd - offsets[k * 2])
            values[k] = m.bytes(keywordText.address + keyEnd, valueEnd - keyEnd)
            k += 1
        }
        // Sorted by key; the first of equal keys stays.
        k = 1
        while k < keywordCount {
            const key = keys[k]
            const value = values[k]
            var place = k
            while place > 0 && compare(keys[place - 1], key) > 0 {
                keys[place] = keys[place - 1]
                values[place] = values[place - 1]
                place -= 1
            }
            keys[place] = key
            values[place] = value
            k += 1
        }
        k = 0
        var written: usize = 0
        while k < keywordCount {
            if k > 0 && m.same(keys[k], keys[k - 1]) {
                k += 1
                continue
            }
            push(out, if written == 0 { 64 } else { 59 })
            pushText(out, keys[k])
            push(out, 61)
            pushText(out, values[k])
            written += 1
            k += 1
        }
    }
    dispose(&keywords)
    dispose(&keywordText)
    return true
}

fn isExtensionSingletonOrPrivate(s: []const u8) -> bool { return s.length == 1 }

fn compareIgnoringCase(a: []const u8, b: []const u8) -> i32 {
    var i: usize = 0
    while i < a.length && i < b.length {
        const x = lower(a[i])
        const y = lower(b[i])
        if x != y { return if x < y { -1 } else { 1 } }
        i += 1
    }
    if a.length == b.length { return 0 }
    return if a.length < b.length { -1 } else { 1 }
}

fn pushLowerHyphens(b: *m.Bytes, s: []const u8) -> void {
    for c in s { push(b, if c == 95 { 45 } else { lower(c) }) }
}

// The -u- extension's attributes and keywords, as ICU writes them:
// attribute=a-b, then each key by its legacy name with its type's
// (`yes` for none); u-va-posix becomes the POSIX variant.
fn unicodeExtensionKeywords(body: []const u8, keywordText: *m.Bytes, offsets: *[96]usize, count: *usize, variantExists: bool, posix: *bool) -> void {
    var at: usize = 0
    var attributes = fresh()
    // Attributes: the subtags before the first key.
    while at < body.length {
        var end = at
        while end < body.length && body[end] != 45 && body[end] != 95 { end += 1 }
        const subtag = body[at..end]
        if isUnicodeLocaleKey(subtag) { break }
        if attributes.length > 0 { push(&attributes, 45) }
        pushLower(&attributes, subtag)
        at = if end < body.length { end + 1 } else { end }
    }
    if attributes.length > 0 && count.* < 47 {
        offsets.*[count.* * 2] = keywordText.*.length
        pushText(keywordText, "attribute")
        offsets.*[count.* * 2 + 1] = keywordText.*.length
        pushText(keywordText, text(&attributes))
        count.* += 1
    }
    dispose(&attributes)
    // Keys, each with the subtags of its type.
    while at < body.length && count.* < 47 {
        var end = at
        while end < body.length && body[end] != 45 && body[end] != 95 { end += 1 }
        const key = body[at..end]
        at = if end < body.length { end + 1 } else { end }
        const typeStart = at
        var typeEnd = at
        while at < body.length {
            var next = at
            while next < body.length && body[next] != 45 && body[next] != 95 { next += 1 }
            if isUnicodeLocaleKey(body[at..next]) { break }
            typeEnd = next
            at = if next < body.length { next + 1 } else { next }
        }
        var lowered = fresh()
        pushLower(&lowered, key)
        const legacy = legacyKey(text(&lowered))
        const keyName = if legacy.length > 0 { legacy } else { text(&lowered) }
        var typeName = fresh()
        if typeEnd > typeStart {
            var bcp = fresh()
            pushLowerHyphens(&bcp, body[typeStart..typeEnd])
            const known = legacyType(text(&lowered), text(&bcp))
            if known.length > 0 { pushText(&typeName, known) } else { pushText(&typeName, text(&bcp)) }
            dispose(&bcp)
        } else {
            pushText(&typeName, "yes")
        }
        if !variantExists && m.same(text(&lowered), "va") && m.same(text(&typeName), "posix") {
            posix.* = true
        } else {
            offsets.*[count.* * 2] = keywordText.*.length
            pushText(keywordText, keyName)
            offsets.*[count.* * 2 + 1] = keywordText.*.length
            pushText(keywordText, text(&typeName))
            count.* += 1
        }
        dispose(&typeName)
        dispose(&lowered)
    }
}

// ---------------------------------------------------------------------------
// IDs to language tags (ICU's ulocimp_toLanguageTag)

fn deprecatedLanguage(lang: []const u8) -> []const u8 {
    if m.same(lang, "in") { return "id" }
    if m.same(lang, "iw") { return "he" }
    if m.same(lang, "ji") { return "yi" }
    if m.same(lang, "jw") { return "jv" }
    if m.same(lang, "mo") { return "ro" }
    return lang
}

const LanguageTagEntry = struct {
    key: []const u8
    value: []const u8
}

fn toLanguageTag(id: []const u8, strict: bool, out: *m.Bytes) -> bool {
    var canonical = fresh()
    if !canonicalize(id, CANONICALIZE, &canonical) {
        dispose(&canonical)
        return false
    }
    const c = text(&canonical)
    // A private use tag alone.
    if c.length > 3 && c[0] == 64 {
        var k = getKeywords(c)
        if k.count == 1 && m.same(k.keys[0], "x") {
            const ok = isPrivateUseValue(k.values[0])
            if ok {
                pushText(out, "und-x-")
                pushText(out, k.values[0])
            }
            dispose(&k.storage)
            dispose(&canonical)
            return ok || !strict
        }
        dispose(&k.storage)
    }
    var s = getSubtags(c)
    var ok = true
    // The language.
    const lang = text(&s.language)
    if lang.length == 0 {
        pushText(out, "und")
    } else if isLanguageSubtag(lang) {
        pushText(out, deprecatedLanguage(lang))
    } else {
        if strict { ok = false }
        pushText(out, "und")
    }
    if s.script.length > 0 {
        if isScriptSubtag(text(&s.script)) {
            push(out, 45)
            pushText(out, text(&s.script))
        } else if strict {
            ok = false
        }
    }
    if s.region.length > 0 {
        if isRegionSubtag(text(&s.region)) {
            push(out, 45)
            pushText(out, text(&s.region))
        } else if strict {
            ok = false
        }
    }
    // Variants, lower case; POSIX becomes u-va-posix.
    var hadPosix = false
    var variantText = text(&s.variant)
    var at: usize = 0
    var seen = fresh()
    while at < variantText.length {
        var end = at
        while end < variantText.length && variantText[end] != 95 && variantText[end] != 45 { end += 1 }
        const variant = variantText[at..end]
        if variant.length > 0 {
            if sameIgnoringCase(variant, "posix") {
                hadPosix = true
            } else if isVariantSubtag(variant) {
                push(out, 45)
                pushLower(out, variant)
            } else if strict {
                ok = false
            }
        }
        at = end + 1
    }
    dispose(&seen)
    // Keywords: attributes and Unicode keys under -u-, the one-letter
    // ones as their extensions, x last.
    var k = getKeywords(c)
    var entries: [40]LanguageTagEntry = undefined
    var entryCount: usize = 0
    var storage = fresh()
    var offsets: [80]usize = undefined
    var attributes: []const u8 = ""
    var i: usize = 0
    while i < k.count && entryCount < 38 {
        const key = k.keys[i]
        const value = k.values[i]
        if m.same(key, "attribute") {
            attributes = value
        } else if key.length > 1 {
            const bcp = bcpKey(key)
            const keyName = if bcp.length > 0 { bcp } else if isUnicodeLocaleKey(key) { key } else { "" }
            if keyName.length == 0 {
                if strict { ok = false }
            } else {
                var type_ = bcpType(key, value)
                var typeText = fresh()
                if type_.length == 0 {
                    if isUnicodeLocaleType(value) || fitsSpecial(keyName, value) {
                        pushLowerHyphens(&typeText, value)
                    } else if m.same(value, "yes") || m.same(value, "true") {
                        pushText(&typeText, "true")
                    } else {
                        if strict { ok = false }
                    }
                } else {
                    pushText(&typeText, type_)
                }
                if typeText.length > 0 {
                    offsets[entryCount * 2] = storage.length
                    pushText(&storage, keyName)
                    offsets[entryCount * 2 + 1] = storage.length
                    pushText(&storage, text(&typeText))
                    entryCount += 1
                }
                dispose(&typeText)
            }
        } else {
            const isPrivate = key[0] == 120
            const valid = if isPrivate { isPrivateUseValue(value) } else { isExtensionSingleton(key) && isExtensionValue(value) }
            if valid {
                offsets[entryCount * 2] = storage.length
                pushText(&storage, key)
                offsets[entryCount * 2 + 1] = storage.length
                pushLowerHyphens(&storage, value)
                entryCount += 1
            } else if strict {
                ok = false
            }
        }
        i += 1
    }
    if hadPosix {
        offsets[entryCount * 2] = storage.length
        pushText(&storage, "va")
        offsets[entryCount * 2 + 1] = storage.length
        pushText(&storage, "posix")
        entryCount += 1
    }
    i = 0
    while i < entryCount {
        const keyEnd = offsets[i * 2 + 1]
        const valueEnd = if i + 1 < entryCount { offsets[i * 2 + 2] } else { storage.length }
        entries[i] = LanguageTagEntry.{ .key = m.bytes(storage.address + offsets[i * 2], keyEnd - offsets[i * 2]), .value = m.bytes(storage.address + keyEnd, valueEnd - keyEnd) }
        i += 1
    }
    // The order: the singletons before u, the u keys (after its
    // attributes), the singletons after u, x.
    i = 1
    while i < entryCount {
        const entry = entries[i]
        var place = i
        while place > 0 && extensionOrder(entries[place - 1].key, entry.key) > 0 {
            entries[place] = entries[place - 1]
            place -= 1
        }
        entries[place] = entry
        i += 1
    }
    var startedU = false
    var wroteAttributes = false
    i = 0
    while i < entryCount {
        const entry = entries[i]
        if entry.key.length > 1 || (attributes.length > 0 && !wroteAttributes && entry.key[0] > 117) {
            if !startedU {
                pushText(out, "-u")
                startedU = true
            }
            if attributes.length > 0 && !wroteAttributes {
                push(out, 45)
                pushLowerHyphens(out, attributes)
                wroteAttributes = true
            }
        }
        if entry.key.length > 1 {
            push(out, 45)
            pushText(out, entry.key)
            if !m.same(entry.value, "true") && !m.same(entry.value, "yes") {
                push(out, 45)
                pushText(out, entry.value)
            }
        } else {
            push(out, 45)
            pushText(out, entry.key)
            push(out, 45)
            pushText(out, entry.value)
        }
        i += 1
    }
    if attributes.length > 0 && !wroteAttributes {
        if !startedU { pushText(out, "-u") }
        push(out, 45)
        pushLowerHyphens(out, attributes)
    }
    dispose(&storage)
    dispose(&k.storage)
    disposeSubtags(&s)
    dispose(&canonical)
    return ok || !strict
}

// The order of extensions in a tag: by singleton, the u keys under u,
// x last.
fn extensionOrder(a: []const u8, b: []const u8) -> i32 {
    const sa: u8 = if a.length > 1 { 117 } else if a[0] == 120 { 255 } else { a[0] }
    const sb: u8 = if b.length > 1 { 117 } else if b[0] == 120 { 255 } else { b[0] }
    if sa != sb { return if sa < sb { -1 } else { 1 } }
    if a.length > 1 && b.length > 1 { return compare(a, b) }
    if a.length == 1 && b.length > 1 { return -1 }
    if a.length > 1 && b.length == 1 { return 1 }
    return 0
}

fn isPrivateUseValue(value: []const u8) -> bool {
    if value.length == 0 { return false }
    var count: usize = 0
    for c in value {
        if c == 45 || c == 95 {
            if count == 0 { return false }
            count = 0
        } else {
            if !isAlnum(c) { return false }
            count += 1
            if count > 8 { return false }
        }
    }
    return count > 0
}

fn isExtensionValue(value: []const u8) -> bool {
    if value.length == 0 { return false }
    var count: usize = 0
    for c in value {
        if c == 45 || c == 95 {
            if count < 2 { return false }
            count = 0
        } else {
            if !isAlnum(c) { return false }
            count += 1
            if count > 8 { return false }
        }
    }
    return count >= 2
}

// ---------------------------------------------------------------------------
// Likely subtags (UTS #35)

const Lsr = struct {
    language: m.Bytes
    script: m.Bytes
    region: m.Bytes
}

fn lookupLikely(key: []const u8) -> []const u8 {
    const likely = likelyTable()
    const found = find(&likely, key)
    return if found == NONE { "" } else { valueAt(&likely, found) }
}

fn candidate(language: []const u8, script: []const u8, region: []const u8) -> []const u8 {
    var key = fresh()
    pushText(&key, if language.length == 0 { "und" } else { language })
    if script.length > 0 {
        push(&key, 95)
        pushText(&key, script)
    }
    if region.length > 0 {
        push(&key, 95)
        pushText(&key, region)
    }
    const found = lookupLikely(text(&key))
    dispose(&key)
    return found
}

// The likely language, script and region of the subtags given (any may
// be empty); false when there is no best.
fn maximize(language: []const u8, script: []const u8, region: []const u8, into: *Lsr) -> bool {
    var best: []const u8 = ""
    var i: usize = 0
    while i < 2 && best.length == 0 {
        const l = if i == 0 { language } else { "" }
        if i == 1 && language.length == 0 { break }
        if script.length > 0 && region.length > 0 { best = candidate(l, script, region) }
        if best.length == 0 && region.length > 0 { best = candidate(l, "", region) }
        if best.length == 0 && script.length > 0 { best = candidate(l, script, "") }
        if best.length == 0 { best = candidate(l, "", "") }
        i += 1
    }
    if best.length == 0 { return false }
    var parts = getSubtags(best)
    pushText(&into.*.language, if language.length > 0 { language } else { text(&parts.language) })
    pushText(&into.*.script, if script.length > 0 { script } else { text(&parts.script) })
    pushText(&into.*.region, if region.length > 0 { region } else { text(&parts.region) })
    disposeSubtags(&parts)
    return true
}

fn newLsr() -> Lsr { return Lsr.{ .language = fresh(), .script = fresh(), .region = fresh() } }

fn disposeLsr(l: *Lsr) -> void {
    dispose(&l.*.language)
    dispose(&l.*.script)
    dispose(&l.*.region)
}

fn sameLsr(a: *Lsr, b: *Lsr) -> bool { return m.same(text(&a.*.language), text(&b.*.language)) && m.same(text(&a.*.script), text(&b.*.script)) && m.same(text(&a.*.region), text(&b.*.region)) }

fn pushLsr(out: *m.Bytes, language: []const u8, script: []const u8, region: []const u8) -> void {
    pushText(out, language)
    if script.length > 0 {
        push(out, 95)
        pushText(out, script)
    }
    if region.length > 0 {
        push(out, 95)
        pushText(out, region)
    }
}

// What follows the language, script and region: variants and keywords,
// as the ID has them.
fn pushRest(out: *m.Bytes, s: *Subtags, rest: []const u8, hasRegion: bool) -> void {
    if s.*.variant.length > 0 {
        push(out, 95)
        if !hasRegion { push(out, 95) }
        pushText(out, text(&s.*.variant))
    }
    pushText(out, rest)
}

fn addLikely(id: []const u8, out: *m.Bytes) -> bool {
    var canonical = fresh()
    if !canonicalize(id, 0, &canonical) {
        dispose(&canonical)
        return false
    }
    const c = text(&canonical)
    var s = getSubtags(c)
    var l = newLsr()
    var ok = maximize(text(&s.language), text(&s.script), text(&s.region), &l)
    if ok {
        pushLsr(out, text(&l.language), text(&l.script), text(&l.region))
        pushRest(out, &s, c[s.end..c.length], l.region.length > 0)
    } else {
        pushText(out, c)
        ok = true
    }
    disposeLsr(&l)
    disposeSubtags(&s)
    dispose(&canonical)
    return ok
}

// ID with its likely subtags (as uloc_addLikelySubtags gives it) into
// INTO: its length, 0 when it does not fit or ID is not well-formed.
pub fn likelyInto(id: []const u8, into: [*]u8, capacity: usize) -> usize {
    var out = fresh()
    var length: usize = 0
    if addLikely(id, &out) {
        const made = text(&out)
        if made.length <= capacity {
            var index: usize = 0
            while index < made.length {
                into[index] = made[index]
                index += 1
            }
            length = made.length
        }
    }
    dispose(&out)
    return length
}

fn minimize(id: []const u8, out: *m.Bytes) -> bool {
    var canonical = fresh()
    if !canonicalize(id, 0, &canonical) {
        dispose(&canonical)
        return false
    }
    const c = text(&canonical)
    var s = getSubtags(c)
    var max = newLsr()
    if !maximize(text(&s.language), text(&s.script), text(&s.region), &max) {
        pushText(out, c)
        disposeLsr(&max)
        disposeSubtags(&s)
        dispose(&canonical)
        return true
    }
    const language = text(&max.language)
    const script = text(&max.script)
    const region = text(&max.region)
    // The shortest that maximizes back: the language, with the region,
    // with the script.
    var done = false
    var keptRegion = true
    var trial: usize = 0
    while trial < 3 && !done {
        const tScript = if trial == 2 { script } else { "" }
        const tRegion = if trial == 1 { region } else { "" }
        var probe = newLsr()
        if maximize(language, tScript, tRegion, &probe) && sameLsr(&probe, &max) {
            pushLsr(out, language, tScript, tRegion)
            keptRegion = tRegion.length > 0
            done = true
        }
        disposeLsr(&probe)
        trial += 1
    }
    if !done { pushLsr(out, language, script, region) }
    pushRest(out, &s, c[s.end..c.length], keptRegion)
    disposeLsr(&max)
    disposeSubtags(&s)
    dispose(&canonical)
    return true
}

// Whether a locale's (likely) script is written right to left.
fn rightToLeft(id: []const u8) -> bool {
    var s = getSubtags(id)
    var l = newLsr()
    var result = false
    if maximize(text(&s.language), text(&s.script), text(&s.region), &l) {
        const script = text(&l.script)
        const rtl = "Adlm Arab Armi Avst Chrs Cprt Elym Hatr Hebr Hung Khar Lydi Mand Mani Mend Merc Mero Narb Nbat Nkoo Orkh Ougr Palm Phli Phlp Phnx Prti Rohg Samr Sarb Sogd Sogo Syrc Thaa Yezi "
        var at: usize = 0
        while at + 4 <= rtl.length {
            if m.same(rtl[at..at + 4], script) { result = true }
            at += 5
        }
    }
    disposeLsr(&l)
    disposeSubtags(&s)
    return result
}

// ---------------------------------------------------------------------------
// The C API

fn idOf(localeID: usize) -> []const u8 {
    if localeID == 0 { return locale.defaultLocale() }
    return m.cSlice(localeID)
}

// `text` into C's buffer with its NUL and status.
fn give(result: []const u8, dest: usize, capacity: i32, status: usize) -> i32 { return m.give(result, dest, capacity, status) }

export fn uloc_getDefault() -> usize {
    _ = locale.defaultLocale()
    return locale.defaultAddress()
}

export fn uloc_setDefault(localeID: usize, status: usize) -> void {
    if m.failed(status) { return }
    var name = fresh()
    if localeID == 0 {
        locale.resetDefault()
        return
    }
    _ = canonicalize(m.cSlice(localeID), CANONICALIZE, &name)
    locale.setDefault(text(&name))
    dispose(&name)
}

fn part(localeID: usize, which: usize, dest: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    var s = getSubtags(idOf(localeID))
    if !s.ok {
        disposeSubtags(&s)
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const result = if which == 0 { text(&s.language) } else if which == 1 { text(&s.script) } else if which == 2 { text(&s.region) } else { text(&s.variant) }
    const written = give(result, dest, capacity, status)
    disposeSubtags(&s)
    return written
}

export fn uloc_getLanguage(localeID: usize, language: usize, capacity: i32, err: usize) -> i32 { return part(localeID, 0, language, capacity, err) }
export fn uloc_getScript(localeID: usize, script: usize, capacity: i32, err: usize) -> i32 { return part(localeID, 1, script, capacity, err) }
export fn uloc_getCountry(localeID: usize, country: usize, capacity: i32, err: usize) -> i32 { return part(localeID, 2, country, capacity, err) }

export fn uloc_getVariant(localeID: usize, variant: usize, capacity: i32, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    // A language tag with extensions is read as the ID it names.
    var converted = fresh()
    var id = idOf(localeID)
    if hasBCP47Extension(id) {
        _ = canonicalize(id, 0, &converted)
        id = text(&converted)
    }
    var s = getSubtags(id)
    var result = fresh()
    pushText(&result, text(&s.variant))
    // `@FOO` without `=`: a POSIX variant.
    const rest = id[s.end..id.length]
    var at: usize = 0
    while at < rest.length && rest[at] != 64 { at += 1 }
    if result.length == 0 && at < rest.length {
        var hasAssign = false
        for c in rest[at..rest.length] {
            if c == 61 { hasAssign = true }
        }
        if !hasAssign { pushUpper(&result, rest[at + 1..rest.length]) }
    }
    const written = give(text(&result), variant, capacity, err)
    dispose(&result)
    disposeSubtags(&s)
    dispose(&converted)
    return written
}

fn written(localeID: usize, options: u32, dest: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    var out = fresh()
    if !canonicalize(idOf(localeID), options, &out) {
        dispose(&out)
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const length = give(text(&out), dest, capacity, status)
    dispose(&out)
    return length
}

export fn uloc_getName(localeID: usize, name: usize, capacity: i32, err: usize) -> i32 { return written(localeID, 0, name, capacity, err) }
export fn uloc_canonicalize(localeID: usize, name: usize, capacity: i32, err: usize) -> i32 { return written(localeID, CANONICALIZE, name, capacity, err) }
export fn uloc_getBaseName(localeID: usize, name: usize, capacity: i32, err: usize) -> i32 { return written(localeID, STRIP_KEYWORDS, name, capacity, err) }

export fn uloc_getParent(localeID: usize, parent: usize, capacity: i32, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    var id = idOf(localeID)
    var last = id.length
    var i: usize = 0
    var found = false
    while i < id.length {
        if id[i] == 95 {
            last = i
            found = true
        }
        i += 1
    }
    if !found { return give("", parent, capacity, err) }
    var start: usize = 0
    if id.length >= 4 && sameIgnoringCase(id[0..4], "und_") { start = 3 }
    return give(id[start..last], parent, capacity, err)
}

// An ID's keywords, from the ID it names when it is a language tag.
fn keywordsOf(id: []const u8, converted: *m.Bytes) -> Keywords {
    if hasBCP47Extension(id) {
        _ = canonicalize(id, 0, converted)
        return getKeywords(text(converted))
    }
    return getKeywords(id)
}

export fn uloc_openKeywords(localeID: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    var converted = fresh()
    var k = keywordsOf(idOf(localeID), &converted)
    if k.count == 0 {
        dispose(&k.storage)
        dispose(&converted)
        return 0
    }
    var lines = fresh()
    var i: usize = 0
    while i < k.count {
        pushText(&lines, k.keys[i])
        push(&lines, 10)
        i += 1
    }
    const en = enumeration.ofLines(text(&lines), status)
    dispose(&lines)
    dispose(&k.storage)
    dispose(&converted)
    return en
}

export fn uloc_getKeywordValue(localeID: usize, keywordName: usize, buffer: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    const key = m.cSlice(keywordName)
    if key.length == 0 || !allAlnum(key) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var converted = fresh()
    var k = keywordsOf(idOf(localeID), &converted)
    const found = keywordIndex(&k, key)
    const result = if found == NONE { "" } else { k.values[found] }
    const length = give(result, buffer, capacity, status)
    dispose(&k.storage)
    dispose(&converted)
    return length
}

fn isKeywordValue(value: []const u8) -> bool {
    for c in value {
        if !(isAlnum(c) || c == 47 || c == 95 || c == 43 || c == 45 || c == 46) { return false }
    }
    return true
}

export fn uloc_setKeywordValue(keywordName: usize, keywordValue: usize, buffer: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    const key = m.cSlice(keywordName)
    const value = if keywordValue == 0 { "" } else { m.cSlice(keywordValue) }
    if key.length == 0 || !allAlnum(key) || !isKeywordValue(value) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var converted = fresh()
    const original = m.cSlice(buffer)
    var id = original
    if hasBCP47Extension(id) {
        _ = canonicalize(id, 0, &converted)
        id = text(&converted)
    }
    var at: usize = 0
    while at < id.length && id[at] != 64 { at += 1 }
    var k = getKeywords(id[at..id.length])
    var out = fresh()
    pushText(&out, id[0..at])
    var lowered = fresh()
    pushLower(&lowered, key)
    // The keywords without this one, then with it (unless removed),
    // sorted.
    const found = keywordIndex(&k, key)
    var keys: [33][]const u8 = undefined
    var values: [33][]const u8 = undefined
    var count: usize = 0
    var i: usize = 0
    while i < k.count {
        if i != found {
            keys[count] = k.keys[i]
            values[count] = k.values[i]
            count += 1
        }
        i += 1
    }
    if value.length > 0 {
        var place = count
        while place > 0 && compare(keys[place - 1], text(&lowered)) > 0 {
            keys[place] = keys[place - 1]
            values[place] = values[place - 1]
            place -= 1
        }
        keys[place] = text(&lowered)
        values[place] = value
        count += 1
    }
    i = 0
    while i < count {
        push(&out, if i == 0 { 64 } else { 59 })
        pushText(&out, keys[i])
        push(&out, 61)
        pushText(&out, values[i])
        i += 1
    }
    // ICU: an overflow when the ID does not fit with its NUL.
    const result = text(&out)
    var length: i32 = @intCast(i32, result.length)
    if capacity <= 0 || result.length >= @intCast(usize, capacity) {
        m.setError(status, m.BUFFER_OVERFLOW_ERROR)
    } else {
        // `buffer` is read above; the result goes there now.
        var copyIndex: usize = 0
        while copyIndex < result.length {
            m.put8(buffer + copyIndex, result[copyIndex])
            copyIndex += 1
        }
        m.put8(buffer + result.length, 0)
    }
    dispose(&lowered)
    dispose(&out)
    dispose(&k.storage)
    dispose(&converted)
    return length
}

export fn uloc_forLanguageTag(langtag: usize, localeID: usize, capacity: i32, parsedLength: usize, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    var out = fresh()
    var parsed: usize = 0
    const tag = m.cSlice(langtag)
    if !forLanguageTag(tag, &out, &parsed) { parsed = 0 }
    if parsedLength != 0 { m.putI32(parsedLength, @intCast(i32, parsed)) }
    const length = give(text(&out), localeID, capacity, err)
    dispose(&out)
    return length
}

export fn uloc_toLanguageTag(localeID: usize, langtag: usize, capacity: i32, strict: u8, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    var out = fresh()
    if !toLanguageTag(idOf(localeID), strict != 0, &out) {
        dispose(&out)
        m.setError(err, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const length = give(text(&out), langtag, capacity, err)
    dispose(&out)
    return length
}

export fn uloc_addLikelySubtags(localeID: usize, maximized: usize, capacity: i32, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    var out = fresh()
    if !addLikely(idOf(localeID), &out) {
        dispose(&out)
        m.setError(err, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const length = give(text(&out), maximized, capacity, err)
    dispose(&out)
    return length
}

export fn uloc_minimizeSubtags(localeID: usize, minimized: usize, capacity: i32, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    var out = fresh()
    if !minimize(idOf(localeID), &out) {
        dispose(&out)
        m.setError(err, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const length = give(text(&out), minimized, capacity, err)
    dispose(&out)
    return length
}

export fn uloc_isRightToLeft(localeID: usize) -> u8 { return if rightToLeft(idOf(localeID)) { 1 } else { 0 } }

// ULayoutType: 0 left to right, 1 right to left, 2 top to bottom.
export fn uloc_getCharacterOrientation(localeID: usize, status: usize) -> i32 {
    if m.failed(status) { return 4 }
    return if rightToLeft(idOf(localeID)) { 1 } else { 0 }
}

export fn uloc_getLineOrientation(localeID: usize, status: usize) -> i32 {
    if m.failed(status) { return 4 }
    return 2
}

export fn uloc_countAvailable() -> i32 { return @intCast(i32, data.AVAILABLE_COUNT) }

export fn uloc_getAvailable(n: i32) -> usize {
    if n < 0 || @intCast(usize, n) >= data.AVAILABLE_COUNT { return 0 }
    const available = availableTable()
    return address(keyAt(&available, @intCast(usize, n)))
}

// ULocAvailableType: the locales (0), the legacy aliases only (1), both
// (2). No legacy aliases are listed here.
export fn uloc_openAvailableByType(kind: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if kind < 0 || kind > 2 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var lines = fresh()
    if kind != 1 {
        const available = availableTable()
        var i: usize = 0
        while i < available.count {
            pushText(&lines, keyAt(&available, i))
            push(&lines, 10)
            i += 1
        }
    }
    const en = enumeration.ofLines(text(&lines), status)
    dispose(&lines)
    return en
}

export fn uloc_toUnicodeLocaleKey(keyword: usize) -> usize {
    const key = m.cSlice(keyword)
    const bcp = bcpKey(key)
    if bcp.length > 0 { return address(bcp) }
    if isUnicodeLocaleKey(key) { return keyword }
    return 0
}

export fn uloc_toLegacyKey(keyword: usize) -> usize {
    const key = m.cSlice(keyword)
    const legacy = legacyKey(key)
    if legacy.length > 0 { return address(legacy) }
    if isWellFormedLegacyKey(key) { return keyword }
    return 0
}

export fn uloc_toUnicodeLocaleType(keyword: usize, value: usize) -> usize {
    const key = m.cSlice(keyword)
    const type_ = m.cSlice(value)
    const bcp = bcpType(key, type_)
    if bcp.length > 0 { return address(bcp) }
    const bcpName = bcpKey(key)
    if fitsSpecial(if bcpName.length > 0 { bcpName } else { key }, type_) { return value }
    if isUnicodeLocaleType(type_) { return value }
    return 0
}

export fn uloc_toLegacyType(keyword: usize, value: usize) -> usize {
    const key = m.cSlice(keyword)
    const type_ = m.cSlice(value)
    const legacy = legacyType(key, type_)
    if legacy.length > 0 { return address(legacy) }
    const bcpName = bcpKey(key)
    if fitsSpecial(if bcpName.length > 0 { bcpName } else { key }, type_) { return value }
    if isWellFormedLegacyType(type_) { return value }
    return 0
}

export fn uloc_getISO3Language(localeID: usize) -> usize {
    var s = getSubtags(idOf(localeID))
    const language = text(&s.language)
    var result = m.literal("")
    const overlong = languageOverlong()
    var i: usize = 0
    while i < overlong.count {
        if m.same(valueAt(&overlong, i), language) {
            result = address(keyAt(&overlong, i))
            break
        }
        i += 1
    }
    disposeSubtags(&s)
    return result
}

export fn uloc_getISO3Country(localeID: usize) -> usize {
    var s = getSubtags(idOf(localeID))
    const alpha3 = alpha3Table()
    const found = find(&alpha3, text(&s.region))
    disposeSubtags(&s)
    return if found == NONE { m.literal("") } else { address(valueAt(&alpha3, found)) }
}

// The display names, from CLDR's locale display names (displaynames.mlx).
export fn uloc_getDisplayLanguage(locale_: usize, displayLocale: usize, language: usize, capacity: i32, status: usize) -> i32 { return displaynames.displayLanguage(locale_, displayLocale, language, capacity, status) }
export fn uloc_getDisplayScript(locale_: usize, displayLocale: usize, script: usize, capacity: i32, status: usize) -> i32 { return displaynames.displayScript(locale_, displayLocale, script, capacity, status) }
export fn uloc_getDisplayCountry(locale_: usize, displayLocale: usize, country: usize, capacity: i32, status: usize) -> i32 { return displaynames.displayCountry(locale_, displayLocale, country, capacity, status) }
export fn uloc_getDisplayVariant(locale_: usize, displayLocale: usize, variant: usize, capacity: i32, status: usize) -> i32 { return displaynames.displayVariant(locale_, displayLocale, variant, capacity, status) }
export fn uloc_getDisplayName(localeID: usize, inLocaleID: usize, result: usize, capacity: i32, status: usize) -> i32 { return displaynames.displayName(localeID, inLocaleID, result, capacity, status) }
export fn uloc_getDisplayKeyword(keyword: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 { return displaynames.displayKeyword(keyword, displayLocale, dest, capacity, status) }
export fn uloc_getDisplayKeywordValue(localeID: usize, keyword: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 { return displaynames.displayKeywordValue(localeID, keyword, displayLocale, dest, capacity, status) }

// The ISO codes: built once, NULL-ended arrays of C strings.
var isoLanguages: usize = 0
var isoCountries: usize = 0

export fn uloc_getISOLanguages() -> usize {
    if isoLanguages == 0 {
        const overlong = languageOverlong()
        var list = m.alloc((overlong.count + 1) * 8)
        // The two-letter codes, sorted (the table is by the three-letter).
        var count: usize = 0
        var i: usize = 0
        while i < overlong.count {
            const code = valueAt(&overlong, i)
            var place = count
            var duplicate = false
            var j: usize = 0
            while j < count {
                if m.same(m.cSlice(m.getWord(list + j * 8)), code) { duplicate = true }
                j += 1
            }
            if !duplicate {
                while place > 0 && compare(m.cSlice(m.getWord(list + (place - 1) * 8)), code) > 0 {
                    m.putWord(list + place * 8, m.getWord(list + (place - 1) * 8))
                    place -= 1
                }
                m.putWord(list + place * 8, address(code))
                count += 1
            }
            i += 1
        }
        m.putWord(list + count * 8, 0)
        isoLanguages = list
    }
    return isoLanguages
}

export fn uloc_getISOCountries() -> usize {
    if isoCountries == 0 {
        const alpha3 = alpha3Table()
        var list = m.alloc((alpha3.count + 1) * 8)
        var count: usize = 0
        var i: usize = 0
        while i < alpha3.count {
            const code = keyAt(&alpha3, i)
            if code.length == 2 && allLetters(code) {
                m.putWord(list + count * 8, address(code))
                count += 1
            }
            i += 1
        }
        m.putWord(list + count * 8, 0)
        isoCountries = list
    }
    return isoCountries
}

// Windows LCIDs are not known here.
export fn uloc_getLCID(localeID: usize) -> u32 { return 0 }

export fn uloc_getLocaleForLCID(hostID: u32, locale_: usize, capacity: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    return 0
}

// The best of the available locales for those accepted (in order of
// preference): the first that is available, or whose parent is.
export fn uloc_acceptLanguage(result: usize, capacity: i32, outResult: usize, acceptList: usize, acceptListCount: i32, availableLocales: usize, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    var index: i32 = 0
    while index < acceptListCount {
        var candidate = fresh()
        pushText(&candidate, m.cSlice(m.getWord(acceptList + @intCast(usize, index) * 8)))
        var fallback = false
        while candidate.length > 0 {
            const en = availableLocales
            enumeration.restart(en)
            while true {
                const next = enumeration.nextString(en)
                if next == 0 { break }
                if sameIgnoringCase(m.cSlice(next), text(&candidate)) {
                    if outResult != 0 { m.putI32(outResult, if fallback { 2 } else { 1 }) }
                    const length = give(m.cSlice(next), result, capacity, status)
                    dispose(&candidate)
                    return length
                }
            }
            // The parent.
            var cut = candidate.length
            while cut > 0 && m.get8(candidate.address + cut - 1) != 95 { cut -= 1 }
            if cut == 0 { break }
            candidate.length = cut - 1
            fallback = true
        }
        dispose(&candidate)
        index += 1
    }
    if outResult != 0 { m.putI32(outResult, 0) }
    return give("", result, capacity, status)
}
