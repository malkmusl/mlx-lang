// Case mapping and folding of strings (ustring.h): the full mappings of
// SpecialCasing.txt, its conditions done here (Final_Sigma, and the
// Turkish, Azerbaijani and Lithuanian rules), and CaseFolding.txt.
const tables = @import("./tables.mlx")
const m = @import("./memory.mlx")
const p = @import("./properties.mlx")

const CASED: usize = 49
const CASE_IGNORABLE: usize = 50
const SOFT_DOTTED: usize = 27

// The languages with rules of their own.
pub const ROOT: u32 = 0
pub const TURKIC: u32 = 1
pub const LITHUANIAN: u32 = 2
pub const DUTCH: u32 = 3

// The language of a locale ID (`tr`, `az_Latn_AZ`, `lt-LT@x=y`).
pub fn language(locale: usize) -> u32 {
    if locale == 0 { return ROOT }
    const text = m.cSlice(locale)
    var end: usize = 0
    while end < text.length && text[end] != 95 && text[end] != 45 && text[end] != 64 && text[end] != 46 { end += 1 }
    const name = text[0..end]
    if p.looselySame(name, "tr") || p.looselySame(name, "az") || p.looselySame(name, "tur") || p.looselySame(name, "aze") { return TURKIC }
    if p.looselySame(name, "lt") || p.looselySame(name, "lit") { return LITHUANIAN }
    if p.looselySame(name, "nl") || p.looselySame(name, "nld") { return DUTCH }
    return ROOT
}

// The index + 1 of `c` among the codes of a table (0 when absent).
fn find(codes: usize, count: usize, c: i32) -> usize {
    if c < 0 { return 0 }
    const code = @intCast(u32, c)
    var low: usize = 0
    var high = count
    while low < high {
        const middle = (low + high) / 2
        const found = m.get32(codes + middle * 4)
        if found == code { return middle + 1 }
        if found < code { low = middle + 1 } else { high = middle }
    }
    return 0
}

fn special(c: i32) -> usize {
    if (p.caseFlags(c) & 1) == 0 { return 0 }
    return find(@intFromPtr(&tables.SPECIAL_CODES), tables.SPECIAL_CODES.length, c)
}

// Appends the code points `info` (offset << 8 | length) names in `data`.
fn appendList(out: *m.Buffer, data: usize, info: u32) -> void {
    const offset = @intCast(usize, info >> 8)
    const count = @intCast(usize, info & 255)
    var index: usize = 0
    while index < count {
        m.push(out, m.get32(data + (offset + index) * 4))
        index += 1
    }
}

fn specialData() -> usize { return @intFromPtr(&tables.SPECIAL_DATA) }

// ---------------------------------------------------------------------------
// Contexts (SpecialCasing.txt's conditions), at `index` in `text`.

fn at(text: *m.Buffer, index: usize) -> i32 { return @intCast(i32, m.at(text, index)) }

// Final_Sigma: a cased letter before (case-ignorables skipped), none after.
fn finalSigma(text: *m.Buffer, index: usize) -> bool {
    var before = index
    var casedBefore = false
    while before > 0 {
        before -= 1
        const c = at(text, before)
        if p.binary(c, CASE_IGNORABLE) { continue }
        casedBefore = p.binary(c, CASED)
        break
    }
    if !casedBefore { return false }
    var after = index + 1
    while after < text.*.length {
        const c = at(text, after)
        after += 1
        if p.binary(c, CASE_IGNORABLE) { continue }
        return !p.binary(c, CASED)
    }
    return true
}

// More_Above: a combining mark of class 230 follows, nothing of class 0
// or 230 between.
fn moreAbove(text: *m.Buffer, index: usize) -> bool {
    var after = index + 1
    while after < text.*.length {
        const ccc = p.combiningClass(at(text, after))
        if ccc == 230 { return true }
        if ccc == 0 { return false }
        after += 1
    }
    return false
}

// Before_Dot: U+0307 follows, nothing of class 0 or 230 between.
fn beforeDot(text: *m.Buffer, index: usize) -> bool {
    var after = index + 1
    while after < text.*.length {
        const c = at(text, after)
        if c == 775 { return true }
        const ccc = p.combiningClass(c)
        if ccc == 0 || ccc == 230 { return false }
        after += 1
    }
    return false
}

// After_I / After_Soft_Dotted: an I (or a soft-dotted letter) before,
// nothing of class 0 or 230 between.
fn precededBy(text: *m.Buffer, index: usize, softDotted: bool) -> bool {
    var before = index
    while before > 0 {
        before -= 1
        const c = at(text, before)
        if softDotted {
            if p.binary(c, SOFT_DOTTED) { return true }
        } else if c == 73 {
            return true
        }
        const ccc = p.combiningClass(c)
        if ccc == 0 || ccc == 230 { return false }
    }
    return false
}

// ---------------------------------------------------------------------------
// The mappings of one code point, appended to `out`.

pub fn lowerAt(out: *m.Buffer, text: *m.Buffer, index: usize, lang: u32) -> void {
    const c = at(text, index)
    if lang == TURKIC {
        if c == 304 {
            m.push(out, 105)
            return
        }
        if c == 775 && precededBy(text, index, false) { return }
        if c == 73 {
            m.push(out, if beforeDot(text, index) { 105 } else { 305 })
            return
        }
    }
    if lang == LITHUANIAN {
        if (c == 73 || c == 74 || c == 302) && moreAbove(text, index) {
            m.push(out, @intCast(u32, p.simpleLower(c)))
            m.push(out, 775)
            return
        }
        if c == 204 || c == 205 || c == 296 {
            m.push(out, 105)
            m.push(out, 775)
            m.push(out, if c == 204 { 768 } else if c == 205 { 769 } else { 771 })
            return
        }
    }
    if c == 931 {
        m.push(out, if finalSigma(text, index) { 962 } else { 963 })
        return
    }
    const found = special(c)
    if found != 0 {
        appendList(out, specialData(), tables.SPECIAL_LOWER[found - 1])
        return
    }
    m.push(out, @intCast(u32, p.simpleLower(c)))
}

pub fn upperAt(out: *m.Buffer, text: *m.Buffer, index: usize, lang: u32, title: bool) -> void {
    const c = at(text, index)
    if lang == TURKIC && c == 105 {
        m.push(out, 304)
        return
    }
    if lang == LITHUANIAN && c == 775 && precededBy(text, index, true) { return }
    const found = special(c)
    if found != 0 {
        appendList(out, specialData(), if title { tables.SPECIAL_TITLE[found - 1] } else { tables.SPECIAL_UPPER[found - 1] })
        return
    }
    m.push(out, @intCast(u32, if title { p.simpleTitle(c) } else { p.simpleUpper(c) }))
}

pub fn foldAt(out: *m.Buffer, c: i32, options: u32) -> void {
    if (options & 1) != 0 {
        if c == 73 {
            m.push(out, 305)
            return
        }
        if c == 304 {
            m.push(out, 105)
            return
        }
    }
    if (p.caseFlags(c) & 2) != 0 {
        const found = find(@intFromPtr(&tables.FOLD_CODES), tables.FOLD_CODES.length, c)
        if found != 0 {
            appendList(out, @intFromPtr(&tables.FOLD_DATA), tables.FOLD_INFO[found - 1])
            return
        }
    }
    m.push(out, @intCast(u32, p.simpleFold(c)))
}

// ---------------------------------------------------------------------------
// Strings

const LOWER: u32 = 0
const UPPER: u32 = 1
const FOLD: u32 = 2

fn mapString(dest: usize, capacity: i32, src: usize, length: i32, kind: u32, lang: u32, options: u32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if (src == 0 && length != 0) || length < -1 || capacity < 0 || (dest == 0 && capacity > 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const count = if src == 0 { 0 } else { m.units(src, length) }
    // (The result may not overlap the source.)
    if dest != 0 && src != 0 && dest < src + count * 2 && src < dest + @intCast(usize, capacity) * 2 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var text = m.buffer()
    m.decode16(&text, src, count)
    var out = m.buffer()
    var index: usize = 0
    while index < text.length {
        if kind == LOWER {
            lowerAt(&out, &text, index, lang)
        } else if kind == UPPER {
            upperAt(&out, &text, index, lang, false)
        } else {
            foldAt(&out, @intCast(i32, m.at(&text, index)), options)
        }
        index += 1
    }
    const written = m.encode16(&out, dest, @intCast(usize, capacity))
    m.dispose(&text)
    m.dispose(&out)
    return m.terminate(dest, written, capacity, status)
}

export fn u_strToLower(dest: usize, capacity: i32, src: usize, length: i32, locale: usize, status: usize) -> i32 {
    return mapString(dest, capacity, src, length, LOWER, language(locale), 0, status)
}

export fn u_strToUpper(dest: usize, capacity: i32, src: usize, length: i32, locale: usize, status: usize) -> i32 {
    return mapString(dest, capacity, src, length, UPPER, language(locale), 0, status)
}

export fn u_strFoldCase(dest: usize, capacity: i32, src: usize, length: i32, options: u32, status: usize) -> i32 {
    return mapString(dest, capacity, src, length, FOLD, ROOT, options, status)
}

// The full case folding of `count` units at `text`, as code points.
pub fn folded(out: *m.Buffer, text: usize, count: usize, options: u32) -> void {
    var source = m.buffer()
    m.decode16(&source, text, count)
    var index: usize = 0
    while index < source.length {
        foldAt(out, @intCast(i32, m.at(&source, index)), options)
        index += 1
    }
    m.dispose(&source)
}
