// udat.h: date formats (UDateFormat), as ICU's SimpleDateFormat and
// RelativeDateFormat: a pattern (of the date and time styles of the
// locale, or given), a calendar (ucal.h, calendar.mlx: the format's own,
// formatted through a copy, or one given), the locale's symbols and
// time zone names; formatting with the fields' positions, parsing,
// the symbols, the context of capitalization, the attributes of
// leniency, the century of two-digit years.
//
// Only the gregorian calendar is here: a locale's -u-ca- keyword other
// than gregory gets the gregorian calendar and data, as ICU gives for a
// calendar it has no data of.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const formatted = @import("./formatted.mlx")
const properties = @import("./properties.mlx")
const text = @import("./datetext.mlx")
const symbols = @import("./datesymbols.mlx")
const patterns = @import("./datepatterns.mlx")
const generator = @import("./patterngenerator.mlx")
const parsing = @import("./dateparse.mlx")

extern("c") fn ucal_open(zoneID: usize, len: i32, localeId: usize, kind: i32, status: usize) -> usize
extern("c") fn ucal_close(cal: usize) -> void
extern("c") fn ucal_clone(cal: usize, status: usize) -> usize
extern("c") fn ucal_setMillis(cal: usize, dateTime: f64, status: usize) -> void
extern("c") fn ucal_getMillis(cal: usize, status: usize) -> f64
extern("c") fn ucal_getNow() -> f64
extern("c") fn ucal_get(cal: usize, field: i32, status: usize) -> i32
extern("c") fn ucal_add(cal: usize, field: i32, amount: i32, status: usize) -> void
extern("c") fn ucal_setAttribute(cal: usize, attr: i32, newValue: i32) -> void
extern("c") fn ucal_getAttribute(cal: usize, attr: i32) -> i32
extern("c") fn uloc_countAvailable() -> i32
extern("c") fn uloc_getAvailable(n: i32) -> usize

const Text = text.Text

// UDateFormatStyle
pub const FULL: i32 = 0
pub const SHORT: i32 = 3
pub const RELATIVE: i32 = 128
pub const NONE: i32 = -1
pub const PATTERN: i32 = -2

// UDateFormatBooleanAttribute
const ATTRIBUTE_COUNT: usize = 4

const INVALID_FORMAT_ERROR: i32 = 3
const PARSE_ERROR: i32 = 9

// The category of date fields (UFIELD_CATEGORY_DATE).
pub const CATEGORY_DATE: i32 = 1

// "UDAT"
const MAGIC: u32 = 1413563477

pub const Format = struct {
    magic: u32
    calendar: usize
    fm: patterns.Formatter
    pattern: Text
    id: symbols.Id
    data: u32
    attributes: [4]bool
    capitalization: i32
    // The century of two-digit years: its first moment and year.
    centuryStart: f64
    centuryStartYear: i32
    valid: [100]u8
    validLength: usize
    actual: [100]u8
    actualLength: usize
    numberFormat: usize
    // A relative format: its date style (else -1), its date and time
    // patterns, the pattern joining them, the names of days near today
    // (-2 to 2).
    relativeStyle: i32
    datePattern: Text
    timePattern: Text
    glue: Text
    dayNames: [5]Text
    capitalizeRelativeForList: bool
    capitalizeRelativeStandalone: bool
}

fn formatAt(address: usize) -> *Format { unsafe { return @ptrFromInt(*Format, address) } }

pub fn isFormat(address: usize) -> bool { return address != 0 && m.get32(address) == MAGIC }

pub fn of(address: usize) -> *Format { return formatAt(address) }

fn copyName(into: *[100]u8, length: *usize, name: []const u8) -> void {
    var k: usize = 0
    while k < name.length && k < 99 {
        into.*[k] = name[k]
        k += 1
    }
    into.*[k] = 0
    length.* = k
}

// A calendar for the format: the zone given (UTF-16), else the locale's
// "timezone" keyword, else the default zone.
fn openCalendar(id: *const symbols.Id, zone: usize, zoneLength: i32, status: usize) -> usize {
    var name: [100]u8 = undefined
    const all = symbols.idText(id)
    var k: usize = 0
    while k < all.length && k < 99 {
        name[k] = all[k]
        k += 1
    }
    name[k] = 0
    if zone != 0 { return ucal_open(zone, zoneLength, @intFromPtr(&name), 0, status) }
    const keyword = symbols.keyword(id, "timezone")
    if keyword.length > 0 && keyword.length < 60 {
        var units: [64]u16 = undefined
        var n: usize = 0
        while n < keyword.length {
            units[n] = @intCast(u16, keyword[n])
            n += 1
        }
        return ucal_open(@intFromPtr(&units), @intCast(i32, keyword.length), @intFromPtr(&name), 0, status)
    }
    return ucal_open(0, 0, @intFromPtr(&name), 0, status)
}

// A format of locale ID with PATTERN (copied), its calendar of the zone
// given; 0 with STATUS set on failure.
pub fn create(id: *const symbols.Id, pattern: *const Text, zone: usize, zoneLength: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !resources.available() {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const data = symbols.dataLocale(id)
    if data == resources.NONE {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const address = m.alloc(@sizeOf(Format))
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    var f = formatAt(address)
    f.*.magic = MAGIC
    f.*.id = id.*
    f.*.data = data
    f.*.pattern = text.copy(pattern)
    f.*.capitalization = patterns.CAPITALIZATION_NONE
    f.*.relativeStyle = -1
    var k: usize = 0
    while k < ATTRIBUTE_COUNT {
        f.*.attributes[k] = true
        k += 1
    }
    if !patterns.initFormatter(&f.*.fm, id, data) {
        destroy(address)
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    f.*.calendar = openCalendar(id, zone, zoneLength, status)
    if m.failed(status) || f.*.calendar == 0 {
        destroy(address)
        return 0
    }
    initializeDefaultCentury(f)
    return address
}

// The century: 80 years before now.
fn initializeDefaultCentury(f: *Format) -> void {
    var local: i32 = 0
    const cal = ucal_clone(f.*.calendar, @intFromPtr(&local))
    if cal == 0 { return }
    ucal_setMillis(cal, ucal_getNow(), @intFromPtr(&local))
    ucal_add(cal, 1, -80, @intFromPtr(&local))
    f.*.centuryStart = ucal_getMillis(cal, @intFromPtr(&local))
    f.*.centuryStartYear = ucal_get(cal, 1, @intFromPtr(&local))
    ucal_close(cal)
}

pub fn destroy(address: usize) -> void {
    if !isFormat(address) { return }
    var f = formatAt(address)
    patterns.disposeFormatter(&f.*.fm)
    text.dispose(&f.*.pattern)
    text.dispose(&f.*.datePattern)
    text.dispose(&f.*.timePattern)
    text.dispose(&f.*.glue)
    var k: usize = 0
    while k < 5 {
        text.dispose(&f.*.dayNames[k])
        k += 1
    }
    if f.*.calendar != 0 { ucal_close(f.*.calendar) }
    f.*.magic = 0
    m.release(address)
}

pub fn clone(address: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const copy = m.alloc(@sizeOf(Format))
    if copy == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.copy(copy, address, @sizeOf(Format))
    var f = formatAt(copy)
    const source = formatAt(address)
    patterns.cloneFormatter(&f.*.fm, &source.*.fm)
    f.*.pattern = text.copy(&source.*.pattern)
    f.*.datePattern = text.copy(&source.*.datePattern)
    f.*.timePattern = text.copy(&source.*.timePattern)
    f.*.glue = text.copy(&source.*.glue)
    var k: usize = 0
    while k < 5 {
        f.*.dayNames[k] = text.copy(&source.*.dayNames[k])
        k += 1
    }
    f.*.calendar = ucal_clone(source.*.calendar, status)
    return copy
}

pub fn applyPattern(f: *Format, pattern: *const Text) -> void {
    text.dispose(&f.*.pattern)
    f.*.pattern = text.copy(pattern)
}

pub fn setCapitalization(f: *Format, value: i32) -> void { f.*.capitalization = value }

// ---------------------------------------------------------------------------
// Formatting.

// The pattern of a relative format for calendar CAL.
fn relativePattern(f: *Format, cal: usize, out: *Text, capitalization: *i32) -> void {
    var local: i32 = 0
    const now = ucal_clone(cal, @intFromPtr(&local))
    ucal_setMillis(now, ucal_getNow(), @intFromPtr(&local))
    const difference = ucal_get(cal, 20, @intFromPtr(&local)) - ucal_get(now, 20, @intFromPtr(&local))
    ucal_close(now)
    var dayName = text.empty()
    if difference >= -2 && difference <= 2 { text.pushText(&dayName, &f.*.dayNames[@intCast(usize, difference + 2)]) }
    const hasDateAtStart = f.*.glue.length >= 3 && text.at(&f.*.glue, 0) == 123 && text.at(&f.*.glue, 1) == 49 && text.at(&f.*.glue, 2) == 125
    if dayName.length > 0 && f.*.datePattern.length > 0 && (f.*.timePattern.length == 0 || f.*.glue.length == 0 || hasDateAtStart) {
        const c = capitalization.*
        if c == patterns.CAPITALIZATION_BEGINNING || (c == patterns.CAPITALIZATION_UI_LIST && f.*.capitalizeRelativeForList) || (c == patterns.CAPITALIZATION_STANDALONE && f.*.capitalizeRelativeStandalone) {
            titlecaseFirst(&dayName)
        }
        capitalization.* = patterns.CAPITALIZATION_NONE
    }
    // The day's name as a quoted literal.
    var quoted = text.empty()
    if dayName.length > 0 {
        text.push(&quoted, 39)
        var k: usize = 0
        while k < dayName.length {
            const unit = text.at(&dayName, k)
            text.push(&quoted, unit)
            if unit == 39 { text.push(&quoted, 39) }
            k += 1
        }
        text.push(&quoted, 39)
    }
    if f.*.datePattern.length == 0 {
        text.pushText(out, &f.*.timePattern)
    } else if f.*.timePattern.length == 0 || f.*.glue.length == 0 {
        text.pushText(out, if dayName.length > 0 { &quoted } else { &f.*.datePattern })
    } else {
        text.format2(&f.*.glue, &f.*.timePattern, if dayName.length > 0 { &quoted } else { &f.*.datePattern }, out)
    }
    text.dispose(&quoted)
    text.dispose(&dayName)
}

fn titlecaseFirst(t: *Text) -> void {
    if t.*.length == 0 { return }
    const c = text.at(t, 0)
    if c < 55296 || c > 57343 {
        const title = properties.simpleTitle(@intCast(i32, c))
        if title >= 0 && title < 65536 { text.setAt(t, 0, @intCast(u16, title)) }
    }
}

// The text of calendar CAL by the format into OUT, its fields' spans
// into S; 0 or an error code.
pub fn formatCalendar(f: *Format, cal: usize, out: *Text, s: *patterns.Spans) -> i32 {
    var fields: patterns.Fields = undefined
    var status: i32 = 0
    if !patterns.readCalendar(cal, &fields, @intFromPtr(&status)) { return status }
    var capitalization = f.*.capitalization
    if f.*.relativeStyle >= 0 {
        var pattern = text.empty()
        relativePattern(f, cal, &pattern, &capitalization)
        const code = patterns.format(&f.*.fm, &pattern, &fields, capitalization, out, s)
        text.dispose(&pattern)
        return code
    }
    return patterns.format(&f.*.fm, &f.*.pattern, &fields, capitalization, out, s)
}

// The text of DATE (as DateFormat::format formats it: a copy of the
// format's calendar at DATE).
pub fn formatDate(f: *Format, date: f64, out: *Text, s: *patterns.Spans) -> i32 {
    var local: i32 = 0
    const cal = ucal_clone(f.*.calendar, @intFromPtr(&local))
    if cal == 0 { return m.MEMORY_ALLOCATION_ERROR }
    ucal_setMillis(cal, date, @intFromPtr(&local))
    var code: i32 = 0
    if local <= 0 { code = formatCalendar(f, cal, out, s) }
    ucal_close(cal)
    return code
}

fn resultChecked(result: usize, resultLength: i32, status: usize) -> bool {
    if m.failed(status) { return false }
    if (result == 0 && resultLength != 0) || (result != 0 && resultLength < 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

// The field position: the last span of its field.
fn setPosition(position: usize, s: *const patterns.Spans) -> void {
    if position == 0 { return }
    const field = m.getI32(position)
    var begin: i32 = 0
    var end: i32 = 0
    var k: usize = 0
    while k < s.*.count {
        if patterns.spanField(s, k) == field {
            begin = patterns.spanStart(s, k)
            end = patterns.spanLimit(s, k)
        }
        k += 1
    }
    m.putI32(position + 4, begin)
    m.putI32(position + 8, end)
}

// The spans (not empty) to a UFieldPositionIterator.
pub fn fillIterator(fpositer: usize, s: *const patterns.Spans) -> void {
    if fpositer == 0 { return }
    const value = formatted.create(0, 0)
    if value == 0 { return }
    var k: usize = 0
    while k < s.*.count {
        const start = patterns.spanStart(s, k)
        const limit = patterns.spanLimit(s, k)
        if start < limit { formatted.addSpan(value, CATEGORY_DATE, patterns.spanField(s, k), @intCast(usize, start), @intCast(usize, limit)) }
        k += 1
    }
    formatted.fillIterator(fpositer, value, CATEGORY_DATE)
    formatted.destroy(value)
}

fn finish(code: i32, out: *Text, s: *patterns.Spans, result: usize, resultLength: i32, status: usize) -> i32 {
    var written: i32 = -1
    if code > 0 {
        m.setError(status, code)
    } else {
        written = text.give(out, result, resultLength, status)
    }
    text.dispose(out)
    patterns.disposeSpans(s)
    return written
}

// ---------------------------------------------------------------------------
// Opening: the patterns of the styles, relative formats.

const STYLE_NAMES: []const u8 = "\nfull\nlong\nmedium\nshort\n"

fn validStyle(style: i32) -> bool { return style >= -1 && style <= 3 }

fn loadRelative(f: *Format, timeStyle: i32, dateStyle: i32) -> void {
    const base = dateStyle & 127
    f.*.relativeStyle = base
    if base >= 0 && base <= 3 {
        _ = generator.stylePattern(&f.*.id, -1, base, &f.*.datePattern)
        if timeStyle >= 0 { _ = generator.stylePattern(&f.*.id, timeStyle, -1, &f.*.timePattern) }
        var key = m.bytesBuffer()
        m.pushText(&key, "dates/calendars/gregorian/dateTimeFormats/")
        m.pushText(&key, symbols.listItem(STYLE_NAMES, @intCast(usize, base)))
        _ = symbols.lookupText(f.*.data, m.bytesText(&key), &f.*.glue)
        m.disposeBytes(&key)
    }
    var k: i32 = -2
    while k <= 2 {
        var key = m.bytesBuffer()
        m.pushText(&key, "dates/fields/day/relative-type-")
        if k < 0 { m.pushByte(&key, 45) }
        m.pushByte(&key, @intCast(u8, 48 + (if k < 0 { -k } else { k })))
        _ = symbols.lookupText(f.*.data, m.bytesText(&key), &f.*.dayNames[@intCast(usize, k + 2)])
        m.disposeBytes(&key)
        k += 1
    }
    f.*.capitalizeRelativeForList = m.same(resources.get(f.*.data, "contextTransforms/relative/uiListOrMenu"), "titlecase-firstword")
    f.*.capitalizeRelativeStandalone = m.same(resources.get(f.*.data, "contextTransforms/relative/stand-alone"), "titlecase-firstword")
}

export fn udat_open(timeStyle: i32, dateStyle: i32, localeId: usize, tzID: usize, tzIDLength: i32, pattern: usize, patternLength: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const id = symbols.idOf(localeId)
    var source = text.empty()
    var styled = false
    var relative = false
    if timeStyle != PATTERN {
        if dateStyle != NONE && (dateStyle & RELATIVE) != 0 && validStyle(timeStyle) && validStyle(dateStyle & 127) {
            relative = true
        } else {
            var code: i32 = 3
            if validStyle(timeStyle) && validStyle(dateStyle) { code = generator.stylePattern(&id, timeStyle, dateStyle, &source) }
            if code != 0 {
                // The default pattern of ICU.
                text.clear(&source)
                text.pushUtf8(&source, "yMMdd hh:mm a")
            } else {
                styled = true
            }
        }
    } else {
        source = text.fromUnits(pattern, patternLength)
    }
    // A zone ID of no length is the default zone's.
    const address = create(&id, &source, tzID, if tzID != 0 && tzIDLength == 0 { 0 } else { tzIDLength }, status)
    text.dispose(&source)
    if address == 0 { return 0 }
    var f = formatAt(address)
    if relative {
        loadRelative(f, timeStyle, dateStyle)
    }
    if styled || relative {
        var valid = m.bytesBuffer()
        var actual = m.bytesBuffer()
        generator.styleLocales(&id, timeStyle, if relative { dateStyle & 127 } else { dateStyle }, &valid, &actual)
        copyName(&f.*.valid, &f.*.validLength, m.bytesText(&valid))
        copyName(&f.*.actual, &f.*.actualLength, m.bytesText(&actual))
        m.disposeBytes(&valid)
        m.disposeBytes(&actual)
    }
    return address
}

export fn udat_close(format: usize) -> void { destroy(format) }

export fn udat_clone(fmt: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !isFormat(fmt) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return clone(fmt, status)
}

export fn udat_format(format: usize, dateToFormat: f64, result: usize, resultLength: i32, position: usize, status: usize) -> i32 {
    if !resultChecked(result, resultLength, status) { return -1 }
    var out = text.empty()
    var s = patterns.spans()
    const code = formatDate(formatAt(format), dateToFormat, &out, &s)
    if code <= 0 { setPosition(position, &s) }
    return finish(code, &out, &s, result, resultLength, status)
}

export fn udat_formatCalendar(format: usize, calendar: usize, result: usize, capacity: i32, position: usize, status: usize) -> i32 {
    if !resultChecked(result, capacity, status) { return -1 }
    var out = text.empty()
    var s = patterns.spans()
    const code = formatCalendar(formatAt(format), calendar, &out, &s)
    if code <= 0 { setPosition(position, &s) }
    return finish(code, &out, &s, result, capacity, status)
}

export fn udat_formatForFields(format: usize, dateToFormat: f64, result: usize, resultLength: i32, fpositer: usize, status: usize) -> i32 {
    if !resultChecked(result, resultLength, status) { return -1 }
    var out = text.empty()
    var s = patterns.spans()
    const code = formatDate(formatAt(format), dateToFormat, &out, &s)
    if code <= 0 { fillIterator(fpositer, &s) }
    return finish(code, &out, &s, result, resultLength, status)
}

export fn udat_formatCalendarForFields(format: usize, calendar: usize, result: usize, capacity: i32, fpositer: usize, status: usize) -> i32 {
    if !resultChecked(result, capacity, status) { return -1 }
    var out = text.empty()
    var s = patterns.spans()
    const code = formatCalendar(formatAt(format), calendar, &out, &s)
    if code <= 0 { fillIterator(fpositer, &s) }
    return finish(code, &out, &s, result, capacity, status)
}

// ---------------------------------------------------------------------------
// Parsing.

export fn udat_parse(format: usize, textUnits: usize, textLength: i32, parsePos: usize, status: usize) -> f64 {
    if m.failed(status) { return 0.0 }
    var f = formatAt(format)
    var local: i32 = 0
    const cal = ucal_clone(f.*.calendar, @intFromPtr(&local))
    if cal == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0.0
    }
    parsing.clear(cal)
    const result = parseInto(f, cal, textUnits, textLength, parsePos, status)
    ucal_close(cal)
    return result
}

fn parseInto(f: *Format, cal: usize, textUnits: usize, textLength: i32, parsePos: usize, status: usize) -> f64 {
    var source = text.fromUnits(textUnits, textLength)
    var position: i32 = if parsePos != 0 { m.getI32(parsePos) } else { 0 }
    var errorIndex: i32 = -1
    var pattern = text.empty()
    var capitalization = f.*.capitalization
    if f.*.relativeStyle >= 0 {
        relativePattern(f, cal, &pattern, &capitalization)
    } else {
        text.pushText(&pattern, &f.*.pattern)
    }
    var p = parsing.Parse.{ .fm = &f.*.fm, .lenient = f.*.attributes[0] && f.*.attributes[1] && ucal_getAttribute(cal, 0) != 0, .allowWhitespace = f.*.attributes[0], .allowNumeric = f.*.attributes[1], .partialLiterals = f.*.attributes[2], .centuryStart = f.*.centuryStart, .centuryStartYear = f.*.centuryStartYear }
    const date = parsing.parse(&p, &pattern, &source, cal, &position, &errorIndex)
    text.dispose(&pattern)
    text.dispose(&source)
    if errorIndex >= 0 {
        if parsePos != 0 { m.putI32(parsePos, errorIndex) }
        m.setError(status, PARSE_ERROR)
        return date
    }
    if parsePos != 0 { m.putI32(parsePos, position) }
    return date
}

export fn udat_parseCalendar(format: usize, calendar: usize, textUnits: usize, textLength: i32, parsePos: usize, status: usize) -> void {
    if m.failed(status) { return }
    _ = parseInto(formatAt(format), calendar, textUnits, textLength, parsePos, status)
}

// ---------------------------------------------------------------------------
// Leniency and the attributes.

export fn udat_isLenient(fmt: usize) -> u8 {
    const f = formatAt(fmt)
    const lenient = ucal_getAttribute(f.*.calendar, 0) != 0 && f.*.attributes[0] && f.*.attributes[1]
    return if lenient { 1 } else { 0 }
}

export fn udat_setLenient(fmt: usize, isLenient: u8) -> void {
    var f = formatAt(fmt)
    ucal_setAttribute(f.*.calendar, 0, if isLenient != 0 { 1 } else { 0 })
    f.*.attributes[0] = isLenient != 0
    f.*.attributes[1] = isLenient != 0
}

export fn udat_getBooleanAttribute(fmt: usize, attr: i32, status: usize) -> u8 {
    if m.failed(status) { return 0 }
    if attr < 0 || attr >= 4 { return 0 }
    return if formatAt(fmt).*.attributes[@intCast(usize, attr)] { 1 } else { 0 }
}

export fn udat_setBooleanAttribute(fmt: usize, attr: i32, newValue: u8, status: usize) -> void {
    if m.failed(status) { return }
    if newValue > 1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    if attr < 0 || attr >= 4 { return }
    formatAt(fmt).*.attributes[@intCast(usize, attr)] = newValue != 0
}

// ---------------------------------------------------------------------------
// The calendar, the numbers.

export fn udat_getCalendar(fmt: usize) -> usize { return formatAt(fmt).*.calendar }

export fn udat_setCalendar(fmt: usize, calendarToSet: usize) -> void {
    if calendarToSet == 0 { return }
    var f = formatAt(fmt)
    var local: i32 = 0
    const copy = ucal_clone(calendarToSet, @intFromPtr(&local))
    if copy == 0 { return }
    ucal_close(f.*.calendar)
    f.*.calendar = copy
}

// The number formats: those given are kept (their digits are not
// used: the format numbers with the digits of its numbering system).
export fn udat_getNumberFormat(fmt: usize) -> usize { return formatAt(fmt).*.numberFormat }

export fn udat_getNumberFormatForField(fmt: usize, field: u16) -> usize {
    if patterns.letterIndex(field) == patterns.FIELD_COUNT { return 0 }
    return formatAt(fmt).*.numberFormat
}

export fn udat_adoptNumberFormatForFields(fmt: usize, fields: usize, numberFormatToSet: usize, status: usize) -> void {
    if m.failed(status) { return }
    if fields != 0 {
        var k: usize = 0
        while m.get16(fields + k * 2) != 0 {
            if patterns.letterIndex(m.get16(fields + k * 2)) == patterns.FIELD_COUNT {
                m.setError(status, INVALID_FORMAT_ERROR)
                return
            }
            k += 1
        }
    }
}

export fn udat_setNumberFormat(fmt: usize, numberFormatToSet: usize) -> void {}

export fn udat_adoptNumberFormat(fmt: usize, numberFormatToAdopt: usize) -> void {
    if numberFormatToAdopt != 0 { formatAt(fmt).*.numberFormat = numberFormatToAdopt }
}

// ---------------------------------------------------------------------------
// Locales.

export fn udat_getAvailable(localeIndex: i32) -> usize { return uloc_getAvailable(localeIndex) }

export fn udat_countAvailable() -> i32 { return uloc_countAvailable() }

export fn udat_getLocaleByType(fmt: usize, kind: i32, status: usize) -> usize {
    if fmt == 0 {
        if !m.failed(status) { m.setError(status, m.ILLEGAL_ARGUMENT_ERROR) }
        return 0
    }
    if m.failed(status) { return 0 }
    var f = formatAt(fmt)
    if kind == 0 { return @intFromPtr(&f.*.actual) }
    if kind == 1 { return @intFromPtr(&f.*.valid) }
    m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
    return 0
}

// ---------------------------------------------------------------------------
// Two-digit years.

export fn udat_get2DigitYearStart(fmt: usize, status: usize) -> f64 {
    if m.failed(status) { return 0.0 }
    return formatAt(fmt).*.centuryStart
}

export fn udat_set2DigitYearStart(fmt: usize, d: f64, status: usize) -> void {
    if m.failed(status) { return }
    var f = formatAt(fmt)
    ucal_setMillis(f.*.calendar, d, status)
    if m.failed(status) { return }
    f.*.centuryStart = d
    f.*.centuryStartYear = ucal_get(f.*.calendar, 1, status)
}

// ---------------------------------------------------------------------------
// Patterns.

// PATTERN with its letters of FROM changed to those of TO (quotes left
// alone); false for a letter FROM lacks or an open quote.
fn translate(pattern: *const Text, from: *const Text, to: *const Text, out: *Text) -> bool {
    var inQuote = false
    var k: usize = 0
    while k < pattern.*.length {
        var c = text.at(pattern, k)
        if inQuote {
            if c == 39 { inQuote = false }
        } else if c == 39 {
            inQuote = true
        } else if text.isLetter(c) {
            const at = text.indexOf(from, c)
            if at == text.NOT_FOUND || at >= to.*.length { return false }
            c = text.at(to, at)
        }
        text.push(out, c)
        k += 1
    }
    return !inQuote
}

fn relativeFullPattern(f: *Format, out: *Text) -> void {
    if f.*.datePattern.length > 0 {
        if f.*.timePattern.length > 0 && f.*.glue.length > 0 {
            text.format2(&f.*.glue, &f.*.timePattern, &f.*.datePattern, out)
        } else {
            text.pushText(out, &f.*.datePattern)
        }
    } else {
        text.pushText(out, &f.*.timePattern)
    }
}

export fn udat_toPattern(fmt: usize, localized: u8, result: usize, resultLength: i32, status: usize) -> i32 {
    if !resultChecked(result, resultLength, status) { return -1 }
    var f = formatAt(fmt)
    var out = text.empty()
    if f.*.relativeStyle >= 0 {
        if localized != 0 {
            m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
            return -1
        }
        relativeFullPattern(f, &out)
    } else if localized != 0 {
        var standard = text.fromUtf8(symbols.PATTERN_CHARS)
        const local = symbols.get(symbols.of(f.*.fm.symbols), symbols.LOCALIZED_CHARS, 0)
        const ok = translate(&f.*.pattern, &standard, local, &out)
        text.dispose(&standard)
        if !ok {
            text.dispose(&out)
            m.setError(status, INVALID_FORMAT_ERROR)
            return -1
        }
    } else {
        text.pushText(&out, &f.*.pattern)
    }
    const written = text.give(&out, result, resultLength, status)
    text.dispose(&out)
    return written
}

export fn udat_applyPattern(format: usize, localized: u8, pattern: usize, patternLength: i32) -> void {
    var f = formatAt(format)
    if f.*.relativeStyle >= 0 { return }
    var source = text.fromUnits(pattern, patternLength)
    if localized != 0 {
        var standard = text.fromUtf8(symbols.PATTERN_CHARS)
        const local = symbols.get(symbols.of(f.*.fm.symbols), symbols.LOCALIZED_CHARS, 0)
        var out = text.empty()
        if translate(&source, local, &standard, &out) { applyPattern(f, &out) }
        text.dispose(&out)
        text.dispose(&standard)
    } else {
        applyPattern(f, &source)
    }
    text.dispose(&source)
}

// ---------------------------------------------------------------------------
// Symbols.

export fn udat_getSymbols(fmt: usize, kind: i32, symbolIndex: i32, result: usize, resultLength: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    var f = formatAt(fmt)
    if kind < 0 || kind >= 30 || symbolIndex < 0 { return 0 }
    const set = @intCast(usize, kind)
    if @intCast(usize, symbolIndex) >= symbols.setSize(set) { return 0 }
    return text.give(symbols.get(symbols.of(f.*.fm.symbols), set, @intCast(usize, symbolIndex)), result, resultLength, status)
}

export fn udat_countSymbols(fmt: usize, kind: i32) -> i32 {
    if kind < 0 || kind >= 30 { return 0 }
    return @intCast(i32, symbols.setSize(@intCast(usize, kind)))
}

export fn udat_setSymbols(format: usize, kind: i32, symbolIndex: i32, value: usize, valueLength: i32, status: usize) -> void {
    if m.failed(status) { return }
    var f = formatAt(format)
    if f.*.relativeStyle >= 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    // The settable sets (not the cyclic and zodiac ones but their
    // abbreviated forms, nor the narrow eras).
    const settable = kind >= 0 && kind < 30 && kind != 22 && kind != 24 && kind != 25 && kind != 27
    if !settable {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return
    }
    const set = @intCast(usize, kind)
    if symbolIndex < 0 || @intCast(usize, symbolIndex) >= symbols.setSize(set) {
        m.setError(status, m.INDEX_OUTOFBOUNDS_ERROR)
        return
    }
    if value == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    var slot = symbols.get(symbols.of(f.*.fm.symbols), set, @intCast(usize, symbolIndex))
    text.dispose(slot)
    slot.* = text.fromUnits(value, valueLength)
}

// ---------------------------------------------------------------------------
// Contexts.

export fn udat_setContext(fmt: usize, value: i32, status: usize) -> void {
    if m.failed(status) { return }
    if (value >> 8) != 1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    formatAt(fmt).*.capitalization = value
}

export fn udat_getContext(fmt: usize, kind: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if kind != 1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return formatAt(fmt).*.capitalization
}

// ---------------------------------------------------------------------------

// The calendar field of a date format field (UCAL_FIELD_COUNT when none).
export fn udat_toCalendarDateField(field: i32) -> i32 {
    if field < 0 || field >= patterns.FIELD_COUNT { return 24 }
    // The time zone fields are the zone offset's; b, B and the time
    // separator have none.
    return @intCast(i32, patterns.calendarFieldOf(field))
}
