// The collation tailorings of mlx-unicode, made from CLDR's collation
// data (projects/unicode/cldr/collation, CLDR's XML, a file a locale):
//
//     collation-generate OUTPUT-FILE RADICALS-FILE XML-FILE...
//
// writes OUTPUT-FILE (projects/unicode/collationrules.mlx): the locales
// that have collation data, each one's default collation type, and the
// rules of each locale's collation types (UTS #35 Part 5's syntax, as
// ICU reads it), keyed `locale/type`; and the order of the Han characters
// in CLDR's root collation (radical-stroke order, RADICALS-FILE: the
// [radical] lines of CLDR's FractionalUCA), as ranges of code points. The rules are kept as CLDR writes
// them but for their comments and the white space around their lines;
// the library reads them when a collator of the locale is first opened.
// What ICU leaves out is left out here too: alternative rules (`alt`)
// but the short ones of Chinese, which ICU has in place of the long
// ones; provisional and unconfirmed rules; types that are not collation
// types of BCP 47.
// Each table is sorted text (`NAME_KEYS`, `NAME_VALUES`, each entry ended
// by a NUL) and where each entry begins (`*_STARTS`). `./mlx build
// unicode-collation` runs it.
const std = @import("std")

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231
const O_RDONLY: usize = 0
const O_WRITE_NEW: usize = 577

// ---------------------------------------------------------------------------
// Memory, files, output

var arenaNext: usize = 0
var arenaEnd: usize = 0

fn alloc(size: usize) -> usize {
    if arenaNext == 0 {
        const reserved = std.linux.syscall6(SYS_mmap, 0, 4294967296, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
        if reserved < 0 { fail("no memory") }
        arenaNext = @bitCast(usize, reserved)
        arenaEnd = arenaNext + 4294967296
    }
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fail("out of memory") }
    arenaNext = at + size
    return at
}

fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }

fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fail(message: []const u8) -> void {
    say("collation-generate: ")
    say(message)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool { return text.length >= prefix.length && same(text[0..prefix.length], prefix) }

// Where `pattern` is in `text` from `from` on (text.length when it is not).
fn find(text: []const u8, pattern: []const u8, from: usize) -> usize {
    var at = from
    while at + pattern.length <= text.length {
        if same(text[at..at + pattern.length], pattern) { return at }
        at += 1
    }
    return text.length
}

fn before(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    var index: usize = 0
    while index < first.length {
        put8(at + index, first[index])
        index += 1
    }
    index = 0
    while index < second.length {
        put8(at + first.length + index, second[index])
        index += 1
    }
    return bytes(at, first.length + second.length)
}

fn readWhole(path: []const u8) -> []const u8 {
    const name = join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 { fail(join("cannot read ", path)) }
    const capacity: usize = 16777216
    const data = alloc(capacity)
    var length: usize = 0
    while length < capacity {
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return bytes(data, length)
}

fn writeWhole(path: []const u8, text: []const u8) -> void {
    const name = join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_WRITE_NEW, 420)
    if descriptor < 0 { fail(join("cannot write ", path)) }
    var done: usize = 0
    while done < text.length {
        const count = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(text.pointer) + done, text.length - done)
        if count <= 0 { fail(join("cannot write ", path)) }
        done += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

const OUT_SIZE: usize = 67108864
var outBase: usize = 0
var outTop: usize = 0

fn outByte(byte: u8) -> void {
    if outBase == 0 { outBase = alloc(OUT_SIZE) }
    if outTop >= OUT_SIZE { fail("the output is too large") }
    put8(outBase + outTop, byte)
    outTop += 1
}

fn out(text: []const u8) -> void {
    for byte in text { outByte(byte) }
}

fn outNumber(value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    out(view[24 - count..24])
}

const HEX: []const u8 = "0123456789abcdef"

// A string literal's content: `"`, `\` and the control characters
// escaped, the rest as it is (UTF-8).
fn outEscaped(text: []const u8) -> void {
    for byte in text {
        if byte == 34 || byte == 92 {
            outByte(92)
            outByte(byte)
        } else if byte == 10 {
            out("\\n")
        } else if byte == 9 {
            out("\\t")
        } else if byte < 32 {
            out("\\x")
            outByte(HEX[@intCast(usize, byte >> 4)])
            outByte(HEX[@intCast(usize, byte & 15)])
        } else {
            outByte(byte)
        }
    }
}

// ---------------------------------------------------------------------------
// Tables: pairs of text, sorted by key.

const Table = struct {
    keys: [*][]const u8
    values: [*][]const u8
    count: usize
}

fn table() -> Table {
    var t = Table.{ .keys = undefined, .values = undefined, .count = 0 }
    unsafe {
        t.keys = @ptrFromInt([*][]const u8, alloc(8192 * 16))
        t.values = @ptrFromInt([*][]const u8, alloc(8192 * 16))
    }
    return t
}

fn add(t: *Table, key: []const u8, value: []const u8) -> void {
    if t.*.count >= 8192 { fail("a table too large") }
    t.*.keys[t.*.count] = key
    t.*.values[t.*.count] = value
    t.*.count += 1
}

// Sorted by key (insertion: the tables are small).
fn sort(t: *Table) -> void {
    var index: usize = 1
    while index < t.*.count {
        const key = t.*.keys[index]
        const value = t.*.values[index]
        var at = index
        while at > 0 && before(key, t.*.keys[at - 1]) {
            t.*.keys[at] = t.*.keys[at - 1]
            t.*.values[at] = t.*.values[at - 1]
            at -= 1
        }
        t.*.keys[at] = key
        t.*.values[at] = value
        index += 1
    }
}

fn outText(name: []const u8, items: [*][]const u8, count: usize) -> void {
    out("pub const ")
    out(name)
    out(": []const u8 = \"")
    var index: usize = 0
    while index < count {
        outEscaped(items[index])
        out("\\0")
        index += 1
    }
    out("\"\n")
    out("pub var ")
    out(name)
    out("_STARTS: [")
    outNumber(count + 1)
    out("]u32 = [")
    outNumber(count + 1)
    out("]u32{")
    var offset: usize = 0
    index = 0
    while index <= count {
        if index % 16 == 0 { out("\n    ") } else { out(" ") }
        outNumber(offset)
        out(",")
        if index < count { offset += items[index].length + 1 }
        index += 1
    }
    out("\n}\n")
}

fn outTable(name: []const u8, t: *Table) -> void {
    sort(t)
    out("pub const ")
    out(name)
    out("_COUNT: usize = ")
    outNumber(t.*.count)
    out("\n")
    outText(join(name, "_KEYS"), t.*.keys, t.*.count)
    outText(join(name, "_VALUES"), t.*.values, t.*.count)
    out("\n")
}

// ---------------------------------------------------------------------------
// The XML of a collation file: comments dropped, CDATA kept as text.

// The text of `xml` without its comments (CDATA sections stay whole).
fn withoutComments(xml: []const u8) -> []const u8 {
    const at = alloc(xml.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < xml.length {
        if startsWith(xml[index..xml.length], "<![CDATA[") {
            var end = find(xml, "]]>", index)
            end = if end < xml.length { end + 3 } else { xml.length }
            while index < end {
                put8(at + length, xml[index])
                length += 1
                index += 1
            }
            continue
        }
        if startsWith(xml[index..xml.length], "<!--") {
            const end = find(xml, "-->", index + 4)
            index = if end < xml.length { end + 3 } else { xml.length }
            continue
        }
        put8(at + length, xml[index])
        length += 1
        index += 1
    }
    return bytes(at, length)
}

// The value of attribute `name` in the tag `tag` ("" when it has none).
fn attribute(tag: []const u8, name: []const u8) -> []const u8 {
    var index: usize = 0
    while index < tag.length {
        const at = find(tag, name, index)
        if at >= tag.length { return "" }
        var next = at + name.length
        const boundary = at == 0 || tag[at - 1] == 32 || tag[at - 1] == 9 || tag[at - 1] == 10
        while next < tag.length && (tag[next] == 32 || tag[next] == 9) { next += 1 }
        if boundary && next < tag.length && tag[next] == 61 {
            next += 1
            while next < tag.length && (tag[next] == 32 || tag[next] == 9) { next += 1 }
            if next < tag.length && (tag[next] == 34 || tag[next] == 39) {
                const quote = tag[next]
                var end = next + 1
                while end < tag.length && tag[end] != quote { end += 1 }
                return tag[next + 1..end]
            }
        }
        index = at + 1
    }
    return ""
}

// The text of an element's content: CDATA as it is, the rest with its
// entities decoded.
fn content(text: []const u8) -> []const u8 {
    const at = alloc(text.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < text.length {
        if startsWith(text[index..text.length], "<![CDATA[") {
            const end = find(text, "]]>", index + 9)
            var k = index + 9
            while k < end {
                put8(at + length, text[k])
                length += 1
                k += 1
            }
            index = if end < text.length { end + 3 } else { text.length }
            continue
        }
        if text[index] == 38 {
            const rest = text[index..text.length]
            var replaced: u8 = 0
            var skip: usize = 0
            if startsWith(rest, "&amp;") {
                replaced = 38
                skip = 5
            }
            if startsWith(rest, "&lt;") {
                replaced = 60
                skip = 4
            }
            if startsWith(rest, "&gt;") {
                replaced = 62
                skip = 4
            }
            if startsWith(rest, "&apos;") {
                replaced = 39
                skip = 6
            }
            if startsWith(rest, "&quot;") {
                replaced = 34
                skip = 6
            }
            if skip > 0 {
                put8(at + length, replaced)
                length += 1
                index += skip
                continue
            }
        }
        put8(at + length, text[index])
        length += 1
        index += 1
    }
    return bytes(at, length)
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 || byte == 10 }

// Rules without their comments (`#` to the end of the line, outside
// quotes and escapes) and the white space that begins and ends their
// lines; empty lines dropped.
fn cleaned(rules: []const u8) -> []const u8 {
    const at = alloc(rules.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < rules.length {
        var end = index
        while end < rules.length && rules[end] != 10 { end += 1 }
        // The line up to its comment.
        var stop = index
        var quoted = false
        while stop < end {
            const byte = rules[stop]
            if byte == 92 && stop + 1 < end {
                stop += 2
                continue
            }
            if byte == 39 { quoted = !quoted }
            if byte == 35 && !quoted { break }
            stop += 1
        }
        var first = index
        while first < stop && isSpace(rules[first]) { first += 1 }
        var last = stop
        while last > first && isSpace(rules[last - 1]) { last -= 1 }
        if last > first {
            if length > 0 {
                put8(at + length, 10)
                length += 1
            }
            var k = first
            while k < last {
                put8(at + length, rules[k])
                length += 1
                k += 1
            }
        }
        index = end + 1
    }
    return bytes(at, length)
}

fn hexDigit(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) }
    if byte >= 65 && byte <= 70 { return @intCast(u32, byte - 55) }
    if byte >= 97 && byte <= 102 { return @intCast(u32, byte - 87) }
    return 16
}

// Rules with their escapes `\uhhhh` and `\Uhhhhhhhh` as the characters
// and `\\` as one backslash, as ICU's resource compiler reads CLDR's
// rules before its rule parser sees them (which takes any other `\x` as
// the character x).
fn unescaped(rules: []const u8) -> []const u8 {
    const at = alloc(rules.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < rules.length {
        const byte = rules[index]
        if byte == 92 && index + 1 < rules.length {
            const kind = rules[index + 1]
            const digits: usize = if kind == 117 { 4 } else if kind == 85 { 8 } else { 0 }
            if kind == 92 {
                put8(at + length, 92)
                length += 1
                index += 2
                continue
            }
            if digits > 0 && index + 2 + digits <= rules.length {
                var value: u32 = 0
                var good = true
                var k: usize = 0
                while k < digits {
                    const digit = hexDigit(rules[index + 2 + k])
                    if digit == 16 { good = false }
                    value = value * 16 + (if digit == 16 { 0 } else { digit })
                    k += 1
                }
                if good {
                    if value < 128 {
                        put8(at + length, @intCast(u8, value))
                        length += 1
                    } else if value < 2048 {
                        put8(at + length, @intCast(u8, 192 | (value >> 6)))
                        put8(at + length + 1, @intCast(u8, 128 | (value & 63)))
                        length += 2
                    } else if value < 65536 {
                        put8(at + length, @intCast(u8, 224 | (value >> 12)))
                        put8(at + length + 1, @intCast(u8, 128 | ((value >> 6) & 63)))
                        put8(at + length + 2, @intCast(u8, 128 | (value & 63)))
                        length += 3
                    } else {
                        put8(at + length, @intCast(u8, 240 | (value >> 18)))
                        put8(at + length + 1, @intCast(u8, 128 | ((value >> 12) & 63)))
                        put8(at + length + 2, @intCast(u8, 128 | ((value >> 6) & 63)))
                        put8(at + length + 3, @intCast(u8, 128 | (value & 63)))
                        length += 4
                    }
                    index += 2 + digits
                    continue
                }
            }
        }
        put8(at + length, byte)
        length += 1
        index += 1
    }
    return bytes(at, length)
}

// The collation types ICU has (BCP 47's, by their legacy names), and the
// private ones the others import.
fn knownType(kind: []const u8) -> bool {
    if startsWith(kind, "private-") { return true }
    const names = [17][]const u8{ "big5han", "compat", "dictionary", "ducet", "emoji", "eor", "gb2312han", "phonebook", "phonetic", "pinyin", "reformed", "search", "searchjl", "standard", "stroke", "traditional", "unihan" }
    var index: usize = 0
    while index < 17 {
        if same(names[index], kind) { return true }
        index += 1
    }
    return same(kind, "zhuyin")
}

var locales = Table.{ .keys = undefined, .values = undefined, .count = 0 }
var rules = Table.{ .keys = undefined, .values = undefined, .count = 0 }

// One locale's file: its default type and its types' rules.
fn readLocale(path: []const u8) -> void {
    var name = path.length
    while name > 0 && path[name - 1] != 47 { name -= 1 }
    var stem = path.length
    if stem > 4 && same(path[stem - 4..stem], ".xml") { stem -= 4 }
    const locale = path[name..stem]
    const xml = withoutComments(readWhole(path))
    var defaultType: []const u8 = ""
    const defaultAt = find(xml, "<defaultCollation>", 0)
    if defaultAt < xml.length {
        const start = defaultAt + 18
        const end = find(xml, "</defaultCollation>", start)
        defaultType = content(xml[start..end])
    }
    add(&locales, locale, defaultType)
    var index: usize = 0
    while true {
        const open = find(xml, "<collation ", index)
        if open >= xml.length { break }
        const tagEnd = find(xml, ">", open)
        const tag = xml[open + 11..tagEnd]
        index = tagEnd + 1
        if tag.length > 0 && tag[tag.length - 1] == 47 { continue }
        const close = find(xml, "</collation>", index)
        const body = xml[index..close]
        index = close
        const kind = attribute(tag, "type")
        // The short alternatives of the Chinese collations (only the
        // characters of common use) are the ones ICU has.
        const short = same(attribute(tag, "alt"), "short")
        if attribute(tag, "alt").length > 0 && !short { continue }
        if same(attribute(tag, "draft"), "provisional") || same(attribute(tag, "draft"), "unconfirmed") { continue }
        if !knownType(kind) { continue }
        var text: []const u8 = ""
        const cr = find(body, "<cr>", 0)
        if cr < body.length {
            const crEnd = find(body, "</cr>", cr + 4)
            text = unescaped(cleaned(content(body[cr + 4..crEnd])))
        }
        const key = join(join(locale, "/"), kind)
        var existing: usize = 0
        while existing < rules.count && !same(rules.keys[existing], key) { existing += 1 }
        if existing < rules.count {
            if short { rules.values[existing] = text }
        } else {
            add(&rules, key, text)
        }
    }
}

// The [radical] lines: the characters after each `:`, in order, as
// ranges (consecutive code points joined) into `ranges` (pairs); their
// count.
fn readRadicals(path: []const u8, ranges: usize) -> usize {
    const text = readWhole(path)
    var count: usize = 0
    var index: usize = 0
    while index < text.length {
        var end = index
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[index..end]
        index = end + 1
        if !startsWith(line, "[radical ") { continue }
        var at: usize = 0
        while at < line.length && line[at] != 58 { at += 1 }
        at += 1
        var stop = line.length
        while stop > at && line[stop - 1] != 93 { stop -= 1 }
        stop -= 1
        var previous: u32 = 0
        var pendingRange = false
        while at < stop {
            // One UTF-8 character.
            const lead = @intCast(u32, line[at])
            var c = lead
            var extra: usize = 0
            if lead >= 240 {
                c = lead & 7
                extra = 3
            } else if lead >= 224 {
                c = lead & 15
                extra = 2
            } else if lead >= 192 {
                c = lead & 31
                extra = 1
            }
            at += 1
            var k: usize = 0
            while k < extra {
                c = (c << 6) | @intCast(u32, line[at] & 63)
                at += 1
                k += 1
            }
            if c == 45 {
                pendingRange = true
                continue
            }
            var first = c
            if pendingRange {
                first = previous + 1
                pendingRange = false
            }
            // Each code point of first..c after the last range.
            if count > 0 && getRange(ranges, count - 1, 1) + 1 == first {
                setRange(ranges, count - 1, 1, c)
            } else {
                setRange(ranges, count, 0, first)
                setRange(ranges, count, 1, c)
                count += 1
            }
            previous = c
        }
    }
    return count
}

fn getRange(ranges: usize, index: usize, which: usize) -> u32 { unsafe { return @ptrFromInt(*u32, ranges + index * 8 + which * 4).* } }
fn setRange(ranges: usize, index: usize, which: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, ranges + index * 8 + which * 4).* = value } }

fn cString(pointer: [*]const u8) -> []const u8 {
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 4 {
        say("usage: collation-generate OUTPUT-FILE RADICALS-FILE XML-FILE...\n")
        return 2
    }
    locales = table()
    rules = table()
    const ranges = alloc(262144 * 8)
    const rangeCount = readRadicals(cString(arguments[2]), ranges)
    var index: usize = 3
    while index < arguments.length {
        readLocale(cString(arguments[index]))
        index += 1
    }
    out("// The collation tailorings of mlx-unicode: made by collation-generate\n")
    out("// (collationgenerate.mlx) from CLDR's collation data\n")
    out("// (projects/unicode/cldr/collation); do not edit. LOCALE: the locales with\n")
    out("// collation data and each one's default type (\"\" when it names none);\n")
    out("// RULES: the rules of each `locale/type`. Each table is sorted text, each\n")
    out("// entry ended by a NUL; *_STARTS say where each begins. HAN_RANGES: the\n")
    out("// Han characters in the root's radical-stroke order, as ranges (first,\n")
    out("// last).\n\n")
    outTable("LOCALE", &locales)
    outTable("RULES", &rules)
    out("pub const HAN_RANGE_COUNT: usize = ")
    outNumber(rangeCount)
    out("\npub var HAN_RANGES: [")
    outNumber(rangeCount * 2)
    out("]u32 = [")
    outNumber(rangeCount * 2)
    out("]u32{")
    index = 0
    while index < rangeCount * 2 {
        if index % 16 == 0 { out("\n    ") } else { out(" ") }
        outNumber(@intCast(usize, getRange(ranges, index / 2, index % 2)))
        out(",")
        index += 1
    }
    out("\n}\n")
    writeWhole(cString(arguments[1]), bytes(outBase, outTop))
    return 0
}
