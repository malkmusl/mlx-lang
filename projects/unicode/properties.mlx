// The properties of code points (uchar.h, uscript.h): looked up in the
// tries of tables.mlx.
const tables = @import("./tables.mlx")
const m = @import("./memory.mlx")

// ---------------------------------------------------------------------------
// Lookups

fn codePoint(c: i32) -> usize {
    if c < 0 || c > 1114111 { return 1114111 }
    return @intCast(usize, c)
}

fn record(c: i32) -> usize {
    const code = codePoint(c)
    const block = @intCast(usize, tables.PROPERTY_INDEX[code >> 6])
    return @intCast(usize, tables.PROPERTY_BLOCKS[(block << 6) + (code & 63)])
}

fn caseRecord(c: i32) -> usize {
    const code = codePoint(c)
    const block = @intCast(usize, tables.CASE_INDEX[code >> 6])
    return @intCast(usize, tables.CASE_BLOCKS[(block << 6) + (code & 63)])
}

pub fn core(c: i32) -> u64 { return tables.PROPERTY_CORE[record(c)] }
pub fn extra(c: i32) -> u64 { return tables.PROPERTY_EXTRA[record(c)] }

pub fn category(c: i32) -> u32 { return @intCast(u32, core(c) & 31) }
pub fn bidiClass(c: i32) -> u32 { return @intCast(u32, (core(c) >> 5) & 31) }
pub fn combiningClass(c: i32) -> u32 { return @intCast(u32, (core(c) >> 10) & 255) }
pub fn lineBreak(c: i32) -> u32 { return @intCast(u32, (core(c) >> 18) & 63) }
pub fn graphemeBreak(c: i32) -> u32 { return @intCast(u32, (core(c) >> 24) & 31) }
pub fn wordBreak(c: i32) -> u32 { return @intCast(u32, (core(c) >> 29) & 31) }
pub fn sentenceBreak(c: i32) -> u32 { return @intCast(u32, (core(c) >> 34) & 15) }
pub fn eastAsianWidth(c: i32) -> u32 { return @intCast(u32, (core(c) >> 38) & 7) }
pub fn hangulSyllableType(c: i32) -> u32 { return @intCast(u32, (core(c) >> 41) & 7) }
pub fn joiningType(c: i32) -> u32 { return @intCast(u32, (core(c) >> 44) & 7) }
pub fn numericType(c: i32) -> u32 { return @intCast(u32, (core(c) >> 47) & 3) }
pub fn decompositionType(c: i32) -> u32 { return @intCast(u32, (core(c) >> 49) & 31) }
pub fn bracketType(c: i32) -> u32 { return @intCast(u32, (core(c) >> 54) & 3) }
pub fn verticalOrientation(c: i32) -> u32 { return @intCast(u32, (core(c) >> 56) & 3) }
pub fn conjunctBreak(c: i32) -> u32 { return @intCast(u32, (core(c) >> 58) & 3) }
pub fn script(c: i32) -> u32 { return @intCast(u32, extra(c) & 1023) }
// The quick-check values as the data has them: 0 yes, 1 no, 2 maybe.
pub fn nfcQuickCheck(c: i32) -> u32 { return @intCast(u32, (extra(c) >> 10) & 3) }
pub fn nfkcQuickCheck(c: i32) -> u32 { return @intCast(u32, (extra(c) >> 12) & 3) }
pub fn nfdQuickCheck(c: i32) -> u32 { return @intCast(u32, (extra(c) >> 14) & 1) }
pub fn nfkdQuickCheck(c: i32) -> u32 { return @intCast(u32, (extra(c) >> 15) & 1) }
fn numericIndex(c: i32) -> usize { return @intCast(usize, (extra(c) >> 16) & 511) }

pub fn binary(c: i32, which: usize) -> bool {
    const index = record(c)
    if which < 64 { return ((tables.PROPERTY_BITS0[index] >> @intCast(u6, which)) & 1) != 0 }
    if which < 128 { return ((tables.PROPERTY_BITS1[index] >> @intCast(u6, which - 64)) & 1) != 0 }
    return false
}

// The simple mappings: the code point plus the record's difference.
fn mapped(c: i32, delta: i32) -> i32 {
    if c < 0 || c > 1114111 { return c }
    return c + delta
}

pub fn simpleUpper(c: i32) -> i32 { return mapped(c, tables.CASE_UPPER[caseRecord(c)]) }
pub fn simpleLower(c: i32) -> i32 { return mapped(c, tables.CASE_LOWER[caseRecord(c)]) }
pub fn simpleTitle(c: i32) -> i32 { return mapped(c, tables.CASE_TITLE[caseRecord(c)]) }
pub fn simpleFold(c: i32) -> i32 { return mapped(c, tables.CASE_FOLD[caseRecord(c)]) }
pub fn mirror(c: i32) -> i32 { return mapped(c, tables.CASE_MIRROR[caseRecord(c)]) }
pub fn pairedBracket(c: i32) -> i32 { return mapped(c, tables.CASE_BRACKET[caseRecord(c)]) }
// 1: full case mappings in SPECIAL_*; 2: a full folding in FOLD_*.
pub fn caseFlags(c: i32) -> u32 { return tables.CASE_FLAGS[caseRecord(c)] }

// The general categories as masks (U_GC_*_MASK).
pub const MASK_L: u32 = 62
pub const MASK_LC: u32 = 14
pub const MASK_M: u32 = 448
pub const MASK_MN: u32 = 64
pub const MASK_MC: u32 = 256
pub const MASK_ME: u32 = 128
pub const MASK_N: u32 = 3584
pub const MASK_ND: u32 = 512
pub const MASK_NL: u32 = 1024
pub const MASK_Z: u32 = 28672
pub const MASK_ZS: u32 = 4096
pub const MASK_C: u32 = 491521
pub const MASK_CC: u32 = 32768
pub const MASK_CF: u32 = 65536
pub const MASK_CS: u32 = 262144
pub const MASK_CN: u32 = 1
pub const MASK_P: u32 = 820510720
pub const MASK_PC: u32 = 4194304
pub const MASK_S: u32 = 251658240
pub const MASK_SC: u32 = 33554432

pub fn categoryMask(c: i32) -> u32 { return @intCast(u32, 1) << @intCast(u5, category(c)) }

// ---------------------------------------------------------------------------
// The binary properties

const ALPHABETIC: usize = 0
const BIDI_MIRRORED: usize = 3
const HEX_DIGIT: usize = 13
const LOWERCASE: usize = 22
const UPPERCASE: usize = 30
const WHITE_SPACE: usize = 31
const POSIX_ALNUM: usize = 44
const POSIX_BLANK: usize = 45
const POSIX_GRAPH: usize = 46
const POSIX_PRINT: usize = 47
const POSIX_XDIGIT: usize = 48
const BINARY_LIMIT: i32 = 76

fn isBlank(c: i32) -> bool {
    if c <= 159 { return c == 9 || c == 32 }
    return category(c) == 12
}

fn isGraphPosix(c: i32) -> bool { return (categoryMask(c) & (MASK_CC | MASK_CS | MASK_CN | MASK_Z)) == 0 }

pub fn hasBinary(c: i32, which: i32) -> bool {
    if which < 0 || which >= BINARY_LIMIT { return false }
    const property = @intCast(usize, which)
    if property == POSIX_ALNUM { return binary(c, ALPHABETIC) || category(c) == 9 }
    if property == POSIX_BLANK { return isBlank(c) }
    if property == POSIX_GRAPH { return isGraphPosix(c) }
    if property == POSIX_PRINT { return category(c) == 12 || isGraphPosix(c) }
    if property == POSIX_XDIGIT { return category(c) == 9 || binary(c, HEX_DIGIT) }
    return binary(c, property)
}

fn truth(value: bool) -> u8 { return if value { 1 } else { 0 } }

export fn u_hasBinaryProperty(c: i32, which: i32) -> u8 { return truth(hasBinary(c, which)) }

export fn u_stringHasBinaryProperty(s: usize, length: i32, which: i32) -> u8 {
    // (A string has a property of code points when it is one code point
    // with it; the properties of strings, the emoji sequences, none here.)
    if s == 0 { return 0 }
    const count = m.units(s, length)
    if count == 0 { return 0 }
    var c = @intCast(i32, m.get16(s))
    var used: usize = 1
    if c >= 55296 && c <= 56319 && count >= 2 {
        const trail = @intCast(i32, m.get16(s + 2))
        if trail >= 56320 && trail <= 57343 {
            c = (c << 10) + trail - 56613888
            used = 2
        }
    }
    if used != count { return 0 }
    return truth(hasBinary(c, which))
}

// ---------------------------------------------------------------------------
// The enumerated properties

const BIDI_CLASS: i32 = 4096
const BLOCK: i32 = 4097
const CANONICAL_COMBINING_CLASS: i32 = 4098
const DECOMPOSITION_TYPE: i32 = 4099
const EAST_ASIAN_WIDTH: i32 = 4100
const GENERAL_CATEGORY: i32 = 4101
const JOINING_GROUP: i32 = 4102
const JOINING_TYPE: i32 = 4103
const LINE_BREAK: i32 = 4104
const NUMERIC_TYPE: i32 = 4105
const SCRIPT: i32 = 4106
const HANGUL_SYLLABLE_TYPE: i32 = 4107
const NFD_QUICK_CHECK: i32 = 4108
const NFKD_QUICK_CHECK: i32 = 4109
const NFC_QUICK_CHECK: i32 = 4110
const NFKC_QUICK_CHECK: i32 = 4111
const LEAD_CANONICAL_COMBINING_CLASS: i32 = 4112
const TRAIL_CANONICAL_COMBINING_CLASS: i32 = 4113
const GRAPHEME_CLUSTER_BREAK: i32 = 4114
const SENTENCE_BREAK: i32 = 4115
const WORD_BREAK: i32 = 4116
const BIDI_PAIRED_BRACKET_TYPE: i32 = 4117
const INDIC_POSITIONAL_CATEGORY: i32 = 4118
const INDIC_SYLLABIC_CATEGORY: i32 = 4119
const VERTICAL_ORIENTATION: i32 = 4120
const IDENTIFIER_STATUS: i32 = 4121
const INDIC_CONJUNCT_BREAK: i32 = 4122
const INT_LIMIT: i32 = 4123
const GENERAL_CATEGORY_MASK: i32 = 8192

// The block (1.. by Blocks.txt; 0 none).
pub fn block(c: i32) -> i32 {
    if c < 0 || c > 1114111 { return 0 }
    const code = @intCast(u32, c)
    var low: usize = 0
    var high: usize = tables.BLOCK_FIRST.length
    while low < high {
        const middle = (low + high) / 2
        if code < tables.BLOCK_FIRST[middle] {
            high = middle
        } else if code > tables.BLOCK_LAST[middle] {
            low = middle + 1
        } else {
            return @intCast(i32, middle + 1)
        }
    }
    return 0
}

// Quick-check values as C sees them (UNORM_NO 0, YES 1, MAYBE 2).
fn checkResult(value: u32) -> i32 {
    if value == 0 { return 1 }
    if value == 1 { return 0 }
    return 2
}

// The canonical decomposition of `c` (its index + 1 in the tables, 0
// when it has none or only a compatibility one).
pub fn canonicalDecomposition(c: i32) -> usize {
    if c < 0 || c > 1114111 { return 0 }
    const code = @intCast(u32, c)
    var low: usize = 0
    var high: usize = tables.DECOMPOSITION_CODES.length
    while low < high {
        const middle = (low + high) / 2
        const found = tables.DECOMPOSITION_CODES[middle]
        if found == code {
            if (tables.DECOMPOSITION_INFO[middle] & 2147483648) != 0 { return 0 }
            return middle + 1
        }
        if found < code { low = middle + 1 } else { high = middle }
    }
    return 0
}

// The combining classes of the first and of the last code point of the
// full canonical decomposition of `c`.
fn leadClass(c: i32) -> i32 {
    var code = c
    while true {
        const found = canonicalDecomposition(code)
        if found == 0 { return @intCast(i32, combiningClass(code)) }
        const info = tables.DECOMPOSITION_INFO[found - 1]
        code = @intCast(i32, tables.DECOMPOSITION_DATA[@intCast(usize, info & 16777215)])
    }
    return 0
}

fn trailClass(c: i32) -> i32 {
    var code = c
    while true {
        const found = canonicalDecomposition(code)
        if found == 0 { return @intCast(i32, combiningClass(code)) }
        const info = tables.DECOMPOSITION_INFO[found - 1]
        const count = @intCast(usize, (info >> 24) & 127)
        code = @intCast(i32, tables.DECOMPOSITION_DATA[@intCast(usize, info & 16777215) + count - 1])
    }
    return 0
}

pub fn intValue(c: i32, which: i32) -> i32 {
    if which >= 0 && which < BINARY_LIMIT { return if hasBinary(c, which) { 1 } else { 0 } }
    if which == BIDI_CLASS { return @intCast(i32, bidiClass(c)) }
    if which == BLOCK { return block(c) }
    if which == CANONICAL_COMBINING_CLASS { return @intCast(i32, combiningClass(c)) }
    if which == DECOMPOSITION_TYPE { return @intCast(i32, decompositionType(c)) }
    if which == EAST_ASIAN_WIDTH { return @intCast(i32, eastAsianWidth(c)) }
    if which == GENERAL_CATEGORY { return @intCast(i32, category(c)) }
    if which == JOINING_TYPE { return @intCast(i32, joiningType(c)) }
    if which == LINE_BREAK { return @intCast(i32, lineBreak(c)) }
    if which == NUMERIC_TYPE { return @intCast(i32, numericType(c)) }
    if which == SCRIPT { return @intCast(i32, script(c)) }
    if which == HANGUL_SYLLABLE_TYPE { return @intCast(i32, hangulSyllableType(c)) }
    if which == NFD_QUICK_CHECK { return checkResult(nfdQuickCheck(c)) }
    if which == NFKD_QUICK_CHECK { return checkResult(nfkdQuickCheck(c)) }
    if which == NFC_QUICK_CHECK { return checkResult(nfcQuickCheck(c)) }
    if which == NFKC_QUICK_CHECK { return checkResult(nfkcQuickCheck(c)) }
    if which == LEAD_CANONICAL_COMBINING_CLASS { return leadClass(c) }
    if which == TRAIL_CANONICAL_COMBINING_CLASS { return trailClass(c) }
    if which == GRAPHEME_CLUSTER_BREAK { return @intCast(i32, graphemeBreak(c)) }
    if which == SENTENCE_BREAK { return @intCast(i32, sentenceBreak(c)) }
    if which == WORD_BREAK { return @intCast(i32, wordBreak(c)) }
    if which == BIDI_PAIRED_BRACKET_TYPE { return @intCast(i32, bracketType(c)) }
    if which == VERTICAL_ORIENTATION { return @intCast(i32, verticalOrientation(c)) }
    if which == INDIC_CONJUNCT_BREAK { return @intCast(i32, conjunctBreak(c)) }
    if which == GENERAL_CATEGORY_MASK { return @bitCast(i32, categoryMask(c)) }
    return 0
}

export fn u_getIntPropertyValue(c: i32, which: i32) -> i32 { return intValue(c, which) }

export fn u_getIntPropertyMinValue(which: i32) -> i32 { return 0 }

export fn u_getIntPropertyMaxValue(which: i32) -> i32 {
    if which >= 0 && which < BINARY_LIMIT { return 1 }
    if which == BIDI_CLASS { return 22 }
    if which == BLOCK { return @intCast(i32, tables.BLOCK_FIRST.length) }
    if which == CANONICAL_COMBINING_CLASS || which == LEAD_CANONICAL_COMBINING_CLASS || which == TRAIL_CANONICAL_COMBINING_CLASS { return 255 }
    if which == DECOMPOSITION_TYPE { return 17 }
    if which == EAST_ASIAN_WIDTH { return 5 }
    if which == GENERAL_CATEGORY { return 29 }
    if which == JOINING_TYPE { return 5 }
    if which == LINE_BREAK { return 47 }
    if which == NUMERIC_TYPE { return 3 }
    if which == SCRIPT { return @intCast(i32, tables.SCRIPT_COUNT) - 1 }
    if which == HANGUL_SYLLABLE_TYPE { return 5 }
    if which == NFD_QUICK_CHECK || which == NFKD_QUICK_CHECK { return 1 }
    if which == NFC_QUICK_CHECK || which == NFKC_QUICK_CHECK { return 2 }
    if which == GRAPHEME_CLUSTER_BREAK { return 17 }
    if which == SENTENCE_BREAK { return 14 }
    if which == WORD_BREAK { return 22 }
    if which == BIDI_PAIRED_BRACKET_TYPE { return 2 }
    if which == VERTICAL_ORIENTATION { return 3 }
    if which == INDIC_CONJUNCT_BREAK { return 3 }
    return -1
}

export fn u_getNumericValue(c: i32) -> f64 {
    const index = numericIndex(c)
    if index == 0 { return -123456789.0 }
    const numerator = @bitCast(i64, tables.NUMERIC_NUMERATORS[index - 1])
    const denominator = tables.NUMERIC_DENOMINATORS[index - 1]
    return @floatFromInt(f64, numerator) / @floatFromInt(f64, denominator)
}

// ---------------------------------------------------------------------------
// Names of properties and values (loosely: case, spaces, '-' and '_'
// do not count).

fn folded(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
}

fn skipped(byte: u8) -> bool { return byte == 32 || byte == 45 || byte == 95 || byte == 9 }

pub fn looselySame(first: []const u8, second: []const u8) -> bool {
    var a: usize = 0
    var b: usize = 0
    while true {
        while a < first.length && skipped(first[a]) { a += 1 }
        while b < second.length && skipped(second[b]) { b += 1 }
        if a == first.length || b == second.length { return a == first.length && b == second.length }
        if folded(first[a]) != folded(second[b]) { return false }
        a += 1
        b += 1
    }
    return false
}

// The names of the general categories by value: short, long.
const CATEGORY_NAMES: []const u8 = "Cn Unassigned\nLu Uppercase_Letter\nLl Lowercase_Letter\nLt Titlecase_Letter\nLm Modifier_Letter\nLo Other_Letter\nMn Nonspacing_Mark\nMe Enclosing_Mark\nMc Spacing_Mark\nNd Decimal_Number\nNl Letter_Number\nNo Other_Number\nZs Space_Separator\nZl Line_Separator\nZp Paragraph_Separator\nCc Control\nCf Format\nCo Private_Use\nCs Surrogate\nPd Dash_Punctuation\nPs Open_Punctuation\nPe Close_Punctuation\nPc Connector_Punctuation\nPo Other_Punctuation\nSm Math_Symbol\nSc Currency_Symbol\nSk Modifier_Symbol\nSo Other_Symbol\nPi Initial_Punctuation\nPf Final_Punctuation\n"
// The masks of the groups of categories, by name.
const CATEGORY_GROUPS: []const u8 = "L Letter 62\nLC Cased_Letter 14\nM Mark 448\nN Number 3584\nZ Separator 28672\nC Other 491521\nP Punctuation 820510720\nS Symbol 251658240\n"

// The value of `name` in a list of lines `short long...` by line number
// (-1 when none).
fn lineOf(list: []const u8, name: []const u8) -> i32 {
    var line: i32 = 0
    var at: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 10 { end += 1 }
        var word = at
        while word < end {
            var stop = word
            while stop < end && list[stop] != 32 { stop += 1 }
            if stop > word && looselySame(list[word..stop], name) { return line }
            word = stop + 1
        }
        at = end + 1
        line += 1
    }
    return -1
}

// Word `index` of line `line` of a list ("" when none).
pub fn wordOf(list: []const u8, line: usize, index: usize) -> []const u8 {
    var at: usize = 0
    var current: usize = 0
    while at < list.length && current < line {
        if list[at] == 10 { current += 1 }
        at += 1
    }
    var word: usize = 0
    while at < list.length && list[at] != 10 {
        var stop = at
        while stop < list.length && list[stop] != 32 && list[stop] != 10 { stop += 1 }
        if word == index { return list[at..stop] }
        word += 1
        at = stop
        if at < list.length && list[at] == 32 { at += 1 }
    }
    return ""
}

fn parseUnsigned(text: []const u8) -> u32 {
    var value: u32 = 0
    var index: usize = 0
    while index < text.length {
        value = value * 10 + @intCast(u32, text[index] - 48)
        index += 1
    }
    return value
}

// The names of the binary and enumerated properties C can ask for by
// name (u_getPropertyEnum), with their numbers.
const PROPERTY_NAMES: []const u8 = "0 Alpha Alphabetic\n1 AHex ASCII_Hex_Digit\n2 Bidi_C Bidi_Control\n3 Bidi_M Bidi_Mirrored\n4 Dash\n5 DI Default_Ignorable_Code_Point\n6 Dep Deprecated\n7 Dia Diacritic\n8 Ext Extender\n9 Comp_Ex Full_Composition_Exclusion\n10 Gr_Base Grapheme_Base\n11 Gr_Ext Grapheme_Extend\n12 Gr_Link Grapheme_Link\n13 Hex Hex_Digit\n14 Hyphen\n15 IDC ID_Continue\n16 IDS ID_Start\n17 Ideo Ideographic\n18 IDSB IDS_Binary_Operator\n19 IDST IDS_Trinary_Operator\n20 Join_C Join_Control\n21 LOE Logical_Order_Exception\n22 Lower Lowercase\n23 Math\n24 NChar Noncharacter_Code_Point\n25 QMark Quotation_Mark\n26 Radical\n27 SD Soft_Dotted\n28 Term Terminal_Punctuation\n29 UIdeo Unified_Ideograph\n30 Upper Uppercase\n31 WSpace White_Space space\n32 XIDC XID_Continue\n33 XIDS XID_Start\n34 Sensitive Case_Sensitive\n35 STerm Sentence_Terminal\n36 VS Variation_Selector\n37 nfdinert NFD_Inert\n38 nfkdinert NFKD_Inert\n39 nfcinert NFC_Inert\n40 nfkcinert NFKC_Inert\n41 segstart Segment_Starter\n42 Pat_Syn Pattern_Syntax\n43 Pat_WS Pattern_White_Space\n44 alnum\n45 blank\n46 graph\n47 print\n48 xdigit\n49 Cased\n50 CI Case_Ignorable\n51 CWL Changes_When_Lowercased\n52 CWU Changes_When_Uppercased\n53 CWT Changes_When_Titlecased\n54 CWCF Changes_When_Casefolded\n55 CWCM Changes_When_Casemapped\n56 CWKCF Changes_When_NFKC_Casefolded\n57 Emoji\n58 EPres Emoji_Presentation\n59 EMod Emoji_Modifier\n60 EBase Emoji_Modifier_Base\n61 EComp Emoji_Component\n62 RI Regional_Indicator\n63 PCM Prepended_Concatenation_Mark\n64 ExtPict Extended_Pictographic\n65 Basic_Emoji\n66 Emoji_Keycap_Sequence\n67 RGI_Emoji_Modifier_Sequence\n68 RGI_Emoji_Flag_Sequence\n69 RGI_Emoji_Tag_Sequence\n70 RGI_Emoji_ZWJ_Sequence\n71 RGI_Emoji\n72 IDSU IDS_Unary_Operator\n73 ID_Compat_Math_Start\n74 ID_Compat_Math_Continue\n75 MCM Modifier_Combining_Mark\n4096 bc Bidi_Class\n4097 blk Block\n4098 ccc Canonical_Combining_Class\n4099 dt Decomposition_Type\n4100 ea East_Asian_Width\n4101 gc General_Category\n4102 jg Joining_Group\n4103 jt Joining_Type\n4104 lb Line_Break\n4105 nt Numeric_Type\n4106 sc Script\n4107 hst Hangul_Syllable_Type\n4108 NFD_QC NFD_Quick_Check\n4109 NFKD_QC NFKD_Quick_Check\n4110 NFC_QC NFC_Quick_Check\n4111 NFKC_QC NFKC_Quick_Check\n4112 lccc Lead_Canonical_Combining_Class\n4113 tccc Trail_Canonical_Combining_Class\n4114 GCB Grapheme_Cluster_Break\n4115 SB Sentence_Break\n4116 WB Word_Break\n4117 bpt Bidi_Paired_Bracket_Type\n4120 vo Vertical_Orientation\n4122 InCB Indic_Conjunct_Break\n8192 gcm General_Category_Mask\n12288 nv Numeric_Value\n16384 age Age\n28672 scx Script_Extensions\n"

export fn u_getPropertyEnum(alias: usize) -> i32 {
    if alias == 0 { return -1 }
    const line = lineOf(PROPERTY_NAMES, m.cSlice(alias))
    if line < 0 { return -1 }
    return @intCast(i32, parseUnsigned(wordOf(PROPERTY_NAMES, @intCast(usize, line), 0)))
}

export fn u_getPropertyName(property: i32, choice: i32) -> usize {
    var line: usize = 0
    while true {
        const number = wordOf(PROPERTY_NAMES, line, 0)
        if number.length == 0 { return 0 }
        if parseUnsigned(number) == @bitCast(u32, property) {
            var word = wordOf(PROPERTY_NAMES, line, if choice == 0 { 1 } else { 2 })
            if word.length == 0 { word = wordOf(PROPERTY_NAMES, line, 1) }
            return cName(word)
        }
        line += 1
    }
    return 0
}

// A NUL-ended copy of a name in a list (kept: names handed to C live as
// long as the library).
var nameCache: [1024]usize = undefined
var nameCacheCount: usize = 0

fn cName(word: []const u8) -> usize {
    var index: usize = 0
    while index < nameCacheCount {
        const cached = nameCache[index]
        if m.cLength(cached) == word.length && m.get8(cached) != 0 {
            var same = true
            var at: usize = 0
            while at < word.length {
                if m.get8(cached + at) != word[at] {
                    same = false
                    break
                }
                at += 1
            }
            if same { return cached }
        }
        index += 1
    }
    const copy = m.alloc(word.length + 1)
    if copy == 0 { return 0 }
    var at: usize = 0
    while at < word.length {
        m.put8(copy + at, word[at])
        at += 1
    }
    if nameCacheCount < 1024 {
        nameCache[nameCacheCount] = copy
        nameCacheCount += 1
    }
    return copy
}

export fn u_getPropertyValueEnum(property: i32, alias: usize) -> i32 {
    if alias == 0 { return -1 }
    const name = m.cSlice(alias)
    if property == SCRIPT { return lineOf(tables.SCRIPT_NAMES, name) }
    if property == GENERAL_CATEGORY { return lineOf(CATEGORY_NAMES, name) }
    if property == GENERAL_CATEGORY_MASK {
        const single = lineOf(CATEGORY_NAMES, name)
        if single >= 0 { return @intCast(i32, 1) << @intCast(u5, single) }
        const group = lineOf(CATEGORY_GROUPS, name)
        if group < 0 { return -1 }
        return @bitCast(i32, parseUnsigned(wordOf(CATEGORY_GROUPS, @intCast(usize, group), 2)))
    }
    if property >= 0 && property < BINARY_LIMIT {
        if looselySame(name, "Y") || looselySame(name, "Yes") || looselySame(name, "T") || looselySame(name, "True") { return 1 }
        if looselySame(name, "N") || looselySame(name, "No") || looselySame(name, "F") || looselySame(name, "False") { return 0 }
    }
    return -1
}

export fn u_getPropertyValueName(property: i32, value: i32, choice: i32) -> usize {
    if value < 0 { return 0 }
    if property == SCRIPT {
        if value >= @intCast(i32, tables.SCRIPT_COUNT) { return 0 }
        var word = wordOf(tables.SCRIPT_NAMES, @intCast(usize, value), if choice == 0 { 0 } else { 1 })
        if word.length == 0 { word = wordOf(tables.SCRIPT_NAMES, @intCast(usize, value), 0) }
        return cName(word)
    }
    if property == GENERAL_CATEGORY {
        if value >= 30 { return 0 }
        return cName(wordOf(CATEGORY_NAMES, @intCast(usize, value), if choice == 0 { 0 } else { 1 }))
    }
    return 0
}

// ---------------------------------------------------------------------------
// Classification (uchar.h)

export fn u_charType(c: i32) -> i8 { return @intCast(i8, category(c)) }
export fn u_charDirection(c: i32) -> i32 { return @intCast(i32, bidiClass(c)) }
export fn u_isMirrored(c: i32) -> u8 { return truth(binary(c, BIDI_MIRRORED)) }
export fn u_charMirror(c: i32) -> i32 { return mirror(c) }

export fn u_getBidiPairedBracket(c: i32) -> i32 {
    if bracketType(c) == 0 { return c }
    return pairedBracket(c)
}

export fn u_getCombiningClass(c: i32) -> u8 { return @intCast(u8, combiningClass(c)) }

export fn u_charDigitValue(c: i32) -> i32 {
    if numericType(c) != 1 { return -1 }
    return @intCast(i32, u_getNumericValue(c))
}

export fn u_digit(ch: i32, radix: i8) -> i32 {
    if radix < 2 || radix > 36 { return -1 }
    var value: i32 = -1
    if category(ch) == 9 {
        value = u_charDigitValue(ch)
    } else if ch >= 48 && ch <= 57 {
        value = ch - 48
    } else if ch >= 97 && ch <= 122 {
        value = ch - 87
    } else if ch >= 65 && ch <= 90 {
        value = ch - 55
    } else if ch >= 65345 && ch <= 65370 {
        value = ch - 65335
    } else if ch >= 65313 && ch <= 65338 {
        value = ch - 65303
    }
    if value < @intCast(i32, radix) { return value }
    return -1
}

export fn u_forDigit(digit: i32, radix: i8) -> i32 {
    if radix < 2 || radix > 36 || digit < 0 || digit >= @intCast(i32, radix) { return 0 }
    if digit < 10 { return 48 + digit }
    return 87 + digit
}

export fn u_getUnicodeVersion(version: usize) -> void {
    m.put8(version, 16)
    m.put8(version + 1, 0)
    m.put8(version + 2, 0)
    m.put8(version + 3, 0)
}

export fn u_getVersion(version: usize) -> void {
    m.put8(version, 74)
    m.put8(version + 1, 2)
    m.put8(version + 2, 0)
    m.put8(version + 3, 0)
}

export fn u_charAge(c: i32, version: usize) -> void {
    // (The age is not kept; every assigned code point is reported as of
    // the version of the data, unassigned ones as 0.)
    u_getUnicodeVersion(version)
    if category(c) == 0 { m.put8(version, 0) }
}

export fn u_islower(c: i32) -> u8 { return truth(category(c) == 2) }
export fn u_isupper(c: i32) -> u8 { return truth(category(c) == 1) }
export fn u_istitle(c: i32) -> u8 { return truth(category(c) == 3) }
export fn u_isdigit(c: i32) -> u8 { return truth(category(c) == 9) }
export fn u_isalpha(c: i32) -> u8 { return truth((categoryMask(c) & MASK_L) != 0) }
export fn u_isalnum(c: i32) -> u8 { return truth((categoryMask(c) & (MASK_L | MASK_ND)) != 0) }

export fn u_isxdigit(c: i32) -> u8 {
    if (c <= 102 && c >= 65 && (c <= 70 || c >= 97)) || (c >= 65313 && c <= 65350 && (c <= 65318 || c >= 65345)) { return 1 }
    return truth(category(c) == 9)
}

export fn u_ispunct(c: i32) -> u8 { return truth((categoryMask(c) & MASK_P) != 0) }

export fn u_isgraph(c: i32) -> u8 { return truth((categoryMask(c) & (MASK_CC | MASK_CF | MASK_CS | MASK_CN | MASK_Z)) == 0) }

export fn u_isblank(c: i32) -> u8 { return truth(isBlank(c)) }
export fn u_isdefined(c: i32) -> u8 { return truth(category(c) != 0) }

fn isControlSpace(c: i32) -> bool { return c <= 159 && ((c >= 9 && c <= 13) || (c >= 28 && c <= 31) || c == 133) }

export fn u_isspace(c: i32) -> u8 { return truth((categoryMask(c) & MASK_Z) != 0 || isControlSpace(c)) }
export fn u_isJavaSpaceChar(c: i32) -> u8 { return truth((categoryMask(c) & MASK_Z) != 0) }

export fn u_isWhitespace(c: i32) -> u8 {
    const space = (categoryMask(c) & MASK_Z) != 0 && c != 160 && c != 8199 && c != 8239
    return truth(space || (c <= 31 && ((c >= 9 && c <= 13) || c >= 28)))
}

export fn u_iscntrl(c: i32) -> u8 { return truth((categoryMask(c) & (MASK_CC | MASK_CF | 8192 | 16384)) != 0) }
export fn u_isISOControl(c: i32) -> u8 { return truth(c >= 0 && c <= 159 && (c <= 31 || c >= 127)) }
export fn u_isprint(c: i32) -> u8 { return truth((categoryMask(c) & MASK_C) == 0) }
export fn u_isbase(c: i32) -> u8 { return truth((categoryMask(c) & (MASK_L | MASK_N | MASK_MC | MASK_ME)) != 0) }
export fn u_isIDStart(c: i32) -> u8 { return truth((categoryMask(c) & (MASK_L | MASK_NL)) != 0) }

export fn u_isIDIgnorable(c: i32) -> u8 {
    if c <= 159 { return truth(u_isISOControl(c) != 0 && !isControlSpace(c)) }
    return truth(category(c) == 16)
}

export fn u_isIDPart(c: i32) -> u8 {
    if (categoryMask(c) & (MASK_L | MASK_NL | MASK_MC | MASK_MN | MASK_ND | MASK_PC)) != 0 { return 1 }
    return u_isIDIgnorable(c)
}

export fn u_isJavaIDStart(c: i32) -> u8 { return truth((categoryMask(c) & (MASK_L | MASK_SC | MASK_PC)) != 0) }

export fn u_isJavaIDPart(c: i32) -> u8 {
    if (categoryMask(c) & (MASK_L | MASK_SC | MASK_PC | MASK_ND | MASK_NL | MASK_MC | MASK_MN)) != 0 { return 1 }
    return u_isIDIgnorable(c)
}

export fn u_isUAlphabetic(c: i32) -> u8 { return truth(binary(c, ALPHABETIC)) }
export fn u_isULowercase(c: i32) -> u8 { return truth(binary(c, LOWERCASE)) }
export fn u_isUUppercase(c: i32) -> u8 { return truth(binary(c, UPPERCASE)) }
export fn u_isUWhiteSpace(c: i32) -> u8 { return truth(binary(c, WHITE_SPACE)) }

export fn u_tolower(c: i32) -> i32 { return simpleLower(c) }
export fn u_toupper(c: i32) -> i32 { return simpleUpper(c) }
export fn u_totitle(c: i32) -> i32 { return simpleTitle(c) }

export fn u_foldCase(c: i32, options: u32) -> i32 {
    if (options & 1) != 0 {
        if c == 73 { return 305 }
        if c == 304 { return 105 }
    }
    return simpleFold(c)
}

export fn ublock_getCode(c: i32) -> i32 { return block(c) }

const EnumRange = fn(usize, i32, i32, i32) -> u8

export fn u_enumCharTypes(callback: usize, context: usize) -> void {
    var start: i32 = 0
    var current = category(0)
    var c: i32 = 1
    while c <= 1114112 {
        const next = if c < 1114112 { category(c) } else { 99 }
        if next != current {
            const target: EnumRange = unsafe { @ptrFromInt(EnumRange, callback) }
            if target(context, start, c, @intCast(i32, current)) == 0 { return }
            start = c
            current = next
        }
        c += 1
    }
}

// ---------------------------------------------------------------------------
// Scripts (uscript.h)

const USAGE_RECOMMENDED: i32 = 5

export fn uscript_getScript(c: i32, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    if c < 0 || c > 1114111 {
        m.setError(err, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return @intCast(i32, script(c))
}

// The index + 1 of the script extensions of `c` (0 when it has none).
fn extensions(c: i32) -> usize {
    if c < 0 || c > 1114111 { return 0 }
    const code = @intCast(u32, c)
    var low: usize = 0
    var high: usize = tables.SCX_FIRST.length
    while low < high {
        const middle = (low + high) / 2
        if code < tables.SCX_FIRST[middle] {
            high = middle
        } else if code > tables.SCX_LAST[middle] {
            low = middle + 1
        } else {
            return middle + 1
        }
    }
    return 0
}

export fn uscript_hasScript(c: i32, sc: i32) -> u8 {
    const found = extensions(c)
    if found == 0 { return truth(@intCast(i32, script(c)) == sc) }
    var at = @intCast(usize, tables.SCX_OFFSET[found - 1])
    while tables.SCX_DATA[at] != 65535 {
        if @intCast(i32, tables.SCX_DATA[at]) == sc { return 1 }
        at += 1
    }
    return 0
}

export fn uscript_getScriptExtensions(c: i32, scripts: usize, capacity: i32, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    if capacity < 0 || (capacity > 0 && scripts == 0) {
        m.setError(err, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    const room = @intCast(usize, capacity)
    const found = extensions(c)
    if found == 0 {
        if room >= 1 {
            m.putI32(scripts, @intCast(i32, script(c)))
        } else {
            m.setError(err, m.BUFFER_OVERFLOW_ERROR)
        }
        return 1
    }
    var count: usize = 0
    var at = @intCast(usize, tables.SCX_OFFSET[found - 1])
    while tables.SCX_DATA[at] != 65535 {
        if count < room { m.putI32(scripts + count * 4, @intCast(i32, tables.SCX_DATA[at])) }
        count += 1
        at += 1
    }
    if count > room { m.setError(err, m.BUFFER_OVERFLOW_ERROR) }
    return @intCast(i32, count)
}

export fn uscript_getName(code: i32) -> usize { return u_getPropertyValueName(SCRIPT, code, 1) }
export fn uscript_getShortName(code: i32) -> usize { return u_getPropertyValueName(SCRIPT, code, 0) }

export fn uscript_getCode(name: usize, fillIn: usize, capacity: i32, err: usize) -> i32 {
    if m.failed(err) { return 0 }
    if name == 0 || (capacity > 0 && fillIn == 0) {
        m.setError(err, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var text = m.cSlice(name)
    // A locale: its script subtag (`sr-Latn`), else none known here.
    var found = lineOf(tables.SCRIPT_NAMES, text)
    if found < 0 {
        var index: usize = 0
        while index < text.length {
            if (text[index] == 45 || text[index] == 95) && index + 5 <= text.length {
                const part = text[index + 1..index + 5]
                if index + 5 == text.length || text[index + 5] == 45 || text[index + 5] == 95 {
                    found = lineOf(tables.SCRIPT_NAMES, part)
                    if found >= 0 { break }
                }
            }
            index += 1
        }
    }
    if found < 0 { return 0 }
    if capacity < 1 {
        m.setError(err, m.BUFFER_OVERFLOW_ERROR)
        return 1
    }
    m.putI32(fillIn, found)
    return 1
}

export fn uscript_getUsage(code: i32) -> i32 { return USAGE_RECOMMENDED }

// Whether a script is written right to left: what its letters' bidi
// classes say (R or AL for the first letter found).
export fn uscript_isRightToLeft(code: i32) -> u8 {
    const short = wordOf(tables.SCRIPT_NAMES, if code >= 0 { @intCast(usize, code) } else { 0 }, 0)
    if looselySame(short, "Arab") || looselySame(short, "Hebr") || looselySame(short, "Syrc") || looselySame(short, "Thaa") || looselySame(short, "Nkoo") || looselySame(short, "Samr") || looselySame(short, "Mand") || looselySame(short, "Adlm") || looselySame(short, "Rohg") || looselySame(short, "Yezi") || looselySame(short, "Garay") { return 1 }
    return 0
}

export fn uscript_breaksBetweenLetters(code: i32) -> u8 {
    const short = wordOf(tables.SCRIPT_NAMES, if code >= 0 { @intCast(usize, code) } else { 0 }, 0)
    if looselySame(short, "Hani") || looselySame(short, "Hira") || looselySame(short, "Kana") || looselySame(short, "Hrkt") || looselySame(short, "Bopo") || looselySame(short, "Yiii") || looselySame(short, "Thai") || looselySame(short, "Laoo") || looselySame(short, "Khmr") || looselySame(short, "Mymr") || looselySame(short, "Jpan") { return 1 }
    return 0
}

export fn uscript_isCased(code: i32) -> u8 {
    const short = wordOf(tables.SCRIPT_NAMES, if code >= 0 { @intCast(usize, code) } else { 0 }, 0)
    if looselySame(short, "Latn") || looselySame(short, "Grek") || looselySame(short, "Cyrl") || looselySame(short, "Armn") || looselySame(short, "Geor") || looselySame(short, "Copt") || looselySame(short, "Glag") || looselySame(short, "Dsrt") || looselySame(short, "Osge") || looselySame(short, "Vith") || looselySame(short, "Adlm") || looselySame(short, "Cher") { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Errors and versions (utypes.h, uversion.h)

export fn u_errorName(code: i32) -> usize {
    if code == 0 { return m.literal("U_ZERO_ERROR") }
    if code == 1 { return m.literal("U_ILLEGAL_ARGUMENT_ERROR") }
    if code == 2 { return m.literal("U_MISSING_RESOURCE_ERROR") }
    if code == 3 { return m.literal("U_INVALID_FORMAT_ERROR") }
    if code == 4 { return m.literal("U_FILE_ACCESS_ERROR") }
    if code == 5 { return m.literal("U_INTERNAL_PROGRAM_ERROR") }
    if code == 6 { return m.literal("U_MESSAGE_PARSE_ERROR") }
    if code == 7 { return m.literal("U_MEMORY_ALLOCATION_ERROR") }
    if code == 8 { return m.literal("U_INDEX_OUTOFBOUNDS_ERROR") }
    if code == 9 { return m.literal("U_PARSE_ERROR") }
    if code == 10 { return m.literal("U_INVALID_CHAR_FOUND") }
    if code == 11 { return m.literal("U_TRUNCATED_CHAR_FOUND") }
    if code == 12 { return m.literal("U_ILLEGAL_CHAR_FOUND") }
    if code == 15 { return m.literal("U_BUFFER_OVERFLOW_ERROR") }
    if code == 16 { return m.literal("U_UNSUPPORTED_ERROR") }
    if code == 27 { return m.literal("U_INVALID_STATE_ERROR") }
    if code == -128 { return m.literal("U_USING_FALLBACK_WARNING") }
    if code == -127 { return m.literal("U_USING_DEFAULT_WARNING") }
    if code == -126 { return m.literal("U_SAFECLONE_ALLOCATED_WARNING") }
    if code == -124 { return m.literal("U_STRING_NOT_TERMINATED_WARNING") }
    if code >= 65536 && code < 65792 { return m.literal("U_PARSE_ERROR") }
    if code >= 65792 && code < 66048 { return m.literal("U_FORMAT_ERROR") }
    if code >= 66048 && code < 66304 { return m.literal("U_BRK_ERROR") }
    if code >= 66560 && code < 66816 { return m.literal("U_IDNA_ERROR") }
    return m.literal("[BOGUS UErrorCode]")
}

export fn u_versionToString(version: usize, text: usize) -> void {
    if text == 0 { return }
    if version == 0 {
        m.put8(text, 0)
        return
    }
    // The fields to the last that is not 0 (at least two).
    var count: usize = 4
    while count > 2 && m.get8(version + count - 1) == 0 { count -= 1 }
    var at: usize = 0
    var index: usize = 0
    while index < count {
        if index > 0 {
            m.put8(text + at, 46)
            at += 1
        }
        const value = m.get8(version + index)
        if value >= 100 {
            m.put8(text + at, 48 + value / 100)
            at += 1
        }
        if value >= 10 {
            m.put8(text + at, 48 + (value / 10) % 10)
            at += 1
        }
        m.put8(text + at, 48 + value % 10)
        at += 1
        index += 1
    }
    m.put8(text + at, 0)
}

export fn u_versionFromString(version: usize, text: usize) -> void {
    if version == 0 { return }
    m.put32(version, 0)
    if text == 0 { return }
    var at: usize = 0
    var index: usize = 0
    while index < 4 {
        var value: u32 = 0
        var digits: usize = 0
        while m.get8(text + at) >= 48 && m.get8(text + at) <= 57 {
            value = value * 10 + @intCast(u32, m.get8(text + at) - 48)
            at += 1
            digits += 1
        }
        if digits == 0 { return }
        m.put8(version + index, @intCast(u8, if value > 255 { 255 } else { value }))
        index += 1
        if m.get8(text + at) != 46 { return }
        at += 1
    }
}

export fn u_versionFromUString(version: usize, text: usize) -> void {
    if version == 0 { return }
    var ascii: [24]u8 = undefined
    var index: usize = 0
    if text != 0 {
        while index < 23 && m.get16(text + index * 2) != 0 && m.get16(text + index * 2) < 128 {
            ascii[index] = @intCast(u8, m.get16(text + index * 2))
            index += 1
        }
    }
    ascii[index] = 0
    u_versionFromString(version, @intFromPtr(&ascii))
}

// (For the other parts: an export is not a module's public function.)
pub fn digitValue(c: i32) -> i32 { return u_charDigitValue(c) }
