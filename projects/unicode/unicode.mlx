// libmlxunicode.so: Unicode for C and C++ programs, in Mlx, with the
// C API of ICU (declared by the modules of api/, whose C headers
// mlx-cheaders makes), for WebKit and what else is built here. The data
// is the Unicode Character Database 16.0 (ucd/), the Collation
// Algorithm's table (uca/), the IDNA mapping table (idna/), made into
// tables by generate.mlx, and the IANA time zone database (tz/), made
// into timezones.mlx by tzgenerate.mlx.
//
//     ./mlx build unicode
//
// The parts: properties.mlx (uchar.h, uscript.h), casing.mlx and
// strings.mlx (ustring.h), normalize.mlx (unorm2.h), breaks.mlx (ubrk.h,
// utext.h), collation.mlx (ucol.h, uiter.h), calendar.mlx and zones.mlx
// (ucal.h), idna.mlx (uidna.h), charsets.mlx (ucsdet.h), localeid.mlx
// (uloc.h), enumeration.mlx
// (uenum.h).
const properties = @import("./properties.mlx")
const casing = @import("./casing.mlx")
const strings = @import("./strings.mlx")
const normalize = @import("./normalize.mlx")
const breaks = @import("./breaks.mlx")
const enumeration = @import("./enumeration.mlx")
const collation = @import("./collation.mlx")
const calendar = @import("./calendar.mlx")
const idna = @import("./idna.mlx")
const charsets = @import("./charsets.mlx")
const localeid = @import("./localeid.mlx")
const formatted = @import("./formatted.mlx")
const bundles = @import("./bundles.mlx")
const plurals = @import("./plurals.mlx")
const decimal = @import("./decimal.mlx")
