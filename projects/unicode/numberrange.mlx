// Number ranges (unumberrangeformatter.h): ICU 74's NumberRangeFormatter
// over numberformat.mlx's formatter, both numbers by one skeleton. The
// numbers are worked out, then: when their modifiers differ, or they are
// not the same number before or after rounding, the range pattern
// (numbers/miscPatterns-numberSystem-NS/range, latn's, "{0}–{1}") with
// the modifiers collapsed as asked (all; auto: the unit's and the
// pattern's affixes when they are more than one code point; unit: those
// with a currency or percent sign) and spaces around the infix when a
// modifier is repeated; when they are the same, the identity fallback: a
// single value, "approximately" (the pattern's sign with the
// approximately sign, numbers/symbols.../approximatelySign) or the range.
// The result has the spans of the two numbers
// (UFIELD_CATEGORY_NUMBER_RANGE_SPAN, 0 and 1) before their fields; a
// long name collapsed takes the plural form of the range (CLDR's plural
// ranges).
const m = @import("./memory.mlx")
const formatted = @import("./formatted.mlx")
const nd = @import("./numberdata.mlx")
const sk = @import("./numberskeleton.mlx")
const nq = @import("./numberquantity.mlx")
const nb = @import("./numberbuilder.mlx")
const nf = @import("./numberformat.mlx")
const pluralrules = @import("./pluralrules.mlx")

// "UNR\0" and "FDNR" (ICU's magic of the formatter and its results).
const MAGIC: u32 = 1431195136
const RESULT_KIND: u32 = 1178881618

const CATEGORY_RANGE_SPAN: i32 = 4098

// UNumberRangeCollapse.
const COLLAPSE_AUTO: i32 = 0
const COLLAPSE_NONE: i32 = 1
const COLLAPSE_UNIT: i32 = 2
const COLLAPSE_ALL: i32 = 3

// UNumberRangeIdentityFallback.
const FALLBACK_SINGLE_VALUE: i32 = 0
const FALLBACK_APPROXIMATELY_OR_SINGLE_VALUE: i32 = 1
const FALLBACK_APPROXIMATELY: i32 = 2
const FALLBACK_RANGE: i32 = 3

// UNumberRangeIdentityResult.
const EQUAL_BEFORE_ROUNDING: i32 = 0
const EQUAL_AFTER_ROUNDING: i32 = 1
const NOT_EQUAL: i32 = 2

// A range formatter:
//     0 u32 magic, i32 collapse, i32 identity fallback
//     16 the number formatter's address
//     24 the range pattern (UTF-8 in the data: address, length)
//     40 the language for plural ranges (16 bytes), 56 its length
const SIZE: usize = 64

fn formatterOf(handle: usize) -> *nf.Formatter { return nf.formatterAt(m.getWord(handle + 16)) }

fn rangePattern(handle: usize) -> []const u8 { return m.bytes(m.getWord(handle + 24), m.getWord(handle + 32)) }

export fn unumrf_openForSkeletonWithCollapseAndIdentityFallback(skeleton: usize, skeletonLen: i32, collapse: i32, identityFallback: i32, localeId: usize, perror: usize, ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    if perror != 0 {
        m.putI32(perror, 0)
        m.putI32(perror + 4, -1)
        m.put16(perror + 8, 0)
        m.put16(perror + 40, 0)
    }
    const length = if skeleton == 0 { 0 } else { m.units(skeleton, skeletonLen) }
    const settingsAddress = m.alloc(@sizeOf(sk.Settings))
    const s: *sk.Settings = unsafe { @ptrFromInt(*sk.Settings, settingsAddress) }
    var offset: i32 = 0
    const result = sk.parse(skeleton, length, s, &offset)
    if result != 0 {
        m.setError(ec, result)
        if perror != 0 { nf.parseErrorContext(perror, skeleton, length, offset) }
    }
    var status: i32 = 0
    const formatter = nf.create(s, localeId, @intFromPtr(&status))
    m.release(settingsAddress)
    if formatter == 0 {
        m.setError(ec, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    const handle = m.alloc(SIZE)
    m.put32(handle, MAGIC)
    m.putI32(handle + 4, collapse)
    m.putI32(handle + 8, identityFallback)
    m.putWord(handle + 16, formatter)
    const f = nf.formatterAt(formatter)
    // The range pattern of the numbering system, latn's, the default.
    var pattern: []const u8 = ""
    var k = nd.key("numbers/miscPatterns-numberSystem-")
    nd.add(&k, f.*.ns[0..f.*.nsLength])
    nd.add(&k, "/range")
    if !nd.lookup(f.*.data, &k, &pattern) {
        k = nd.key("numbers/miscPatterns-numberSystem-latn/range")
        if !nd.lookup(f.*.data, &k, &pattern) { pattern = "{0}\u{2013}{1}" }
    }
    m.putWord(handle + 24, @intFromPtr(pattern.pointer))
    m.putWord(handle + 32, pattern.length)
    var language: [16]u8 = undefined
    const languageLength = pluralrules.languageOf(f.*.localeId[0..f.*.localeLength], &language)
    var index: usize = 0
    while index < languageLength {
        m.put8(handle + 40 + index, language[index])
        index += 1
    }
    m.putWord(handle + 56, languageLength)
    return handle
}

export fn unumrf_close(uformatter: usize) -> void {
    if uformatter == 0 || m.get32(uformatter) != MAGIC { return }
    nf.destroy(m.getWord(uformatter + 16))
    m.put32(uformatter, 0)
    m.release(uformatter)
}

// The result: a formatted value keeping its two quantities and the
// identity result.
export fn unumrf_openResult(ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    const value = formatted.create(RESULT_KIND, 24)
    if value == 0 {
        m.setError(ec, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.putWord(formatted.extra(value), nq.create())
    m.putWord(formatted.extra(value) + 8, nq.create())
    m.putI32(formatted.extra(value) + 16, 3)
    return value
}

export fn unumrf_closeResult(uresult: usize) -> void {
    if !formatted.isKind(uresult, RESULT_KIND) { return }
    nq.destroy(m.getWord(formatted.extra(uresult)))
    nq.destroy(m.getWord(formatted.extra(uresult) + 8))
    formatted.destroy(uresult)
}

pub fn validResult(uresult: usize, ec: usize) -> bool {
    if m.failed(ec) { return false }
    if uresult == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    if !formatted.isKind(uresult, RESULT_KIND) {
        m.setError(ec, nf.INVALID_FORMAT_ERROR)
        return false
    }
    return true
}

fn validFormatter(uformatter: usize, ec: usize) -> bool {
    if m.failed(ec) { return false }
    if uformatter == 0 {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    if m.get32(uformatter) != MAGIC {
        m.setError(ec, nf.INVALID_FORMAT_ERROR)
        return false
    }
    return true
}

pub fn firstQuantity(uresult: usize) -> *nq.Quantity { return nq.at(m.getWord(formatted.extra(uresult))) }
pub fn secondQuantity(uresult: usize) -> *nq.Quantity { return nq.at(m.getWord(formatted.extra(uresult) + 8)) }

// ---------------------------------------------------------------------------
// Formatting.

fn isWhiteSpace(unit: u16) -> bool {
    const c = @intCast(u32, unit)
    return c == 9 || c == 10 || c == 11 || c == 12 || c == 13 || c == 32 || c == 133 || c == 8206 || c == 8207 || c == 8232 || c == 8233
}

// Whether two numbers' middle modifiers are the same (their affixes' text
// and fields, and whether they keep the number).
fn sameMiddle(f: *const nf.Formatter, a: *const nf.Micros, b: *const nf.Micros) -> bool {
    var p1 = nb.builder()
    var s1 = nb.builder()
    var p2 = nb.builder()
    var s2 = nb.builder()
    const body1 = nf.middleParts(f, a, &p1, &s1)
    const body2 = nf.middleParts(f, b, &p2, &s2)
    const same = body1 == body2 && nb.same(&p1, &p2) && nb.same(&s1, &s2)
    nb.dispose(&p1)
    nb.dispose(&s1)
    nb.dispose(&p2)
    nb.dispose(&s2)
    return same
}

fn middleCodePoints(f: *const nf.Formatter, a: *const nf.Micros) -> usize {
    var p = nb.builder()
    var s = nb.builder()
    _ = nf.middleParts(f, a, &p, &s)
    const count = nb.codePointCount(&p) + nb.codePointCount(&s)
    nb.dispose(&p)
    nb.dispose(&s)
    return count
}

fn middleHasField(f: *const nf.Formatter, a: *const nf.Micros, field: u8) -> bool {
    var p = nb.builder()
    var s = nb.builder()
    _ = nf.middleParts(f, a, &p, &s)
    const has = nb.containsField(&p, field) || nb.containsField(&s, field)
    nb.dispose(&p)
    nb.dispose(&s)
    return has
}

fn sameInner(a: *const nf.Micros, b: *const nf.Micros) -> bool {
    if a.*.scientific != b.*.scientific { return false }
    return !a.*.scientific || a.*.exponent == b.*.exponent
}

fn sameOuter(a: *const nf.Micros, b: *const nf.Micros) -> bool { return (a.*.outerPlural >= 6) == (b.*.outerPlural >= 6) }

// The range of the two quantities into B with its two spans (ICU's
// formatRange).
fn formatRange(handle: usize, q1: *nq.Quantity, q2: *nq.Quantity, micros1: *nf.Micros, micros2: *nf.Micros, b: *nb.Builder, spans: *[2]nb.SpanInfo) -> void {
    const f = formatterOf(handle)
    const collapse = m.getI32(handle + 4)
    var collapseOuter = false
    var collapseMiddle = false
    var collapseInner = false
    if collapse == COLLAPSE_ALL || collapse == COLLAPSE_AUTO || collapse == COLLAPSE_UNIT {
        collapseOuter = sameOuter(micros1, micros2)
        if collapseOuter {
            collapseMiddle = sameMiddle(f, micros1, micros2)
            if collapseMiddle {
                if collapse == COLLAPSE_UNIT {
                    if !middleHasField(f, micros1, nb.numberField(nb.CURRENCY)) && !middleHasField(f, micros1, nb.numberField(nb.PERCENT)) { collapseMiddle = false }
                } else if collapse == COLLAPSE_AUTO {
                    if middleCodePoints(f, micros1) <= 1 { collapseMiddle = false }
                }
                if collapseMiddle && collapse == COLLAPSE_ALL { collapseInner = sameInner(micros1, micros2) }
            }
        }
    }
    // The range pattern: prefix, infix, suffix.
    const pattern = rangePattern(handle)
    var parts = [3]m.Bytes{ m.bytesBuffer(), m.bytesBuffer(), m.bytesBuffer() }
    var part: usize = 0
    var at: usize = 0
    while at < pattern.length {
        if pattern[at] == 123 && at + 2 < pattern.length && (pattern[at + 1] == 48 || pattern[at + 1] == 49) && pattern[at + 2] == 125 {
            if part < 2 { part += 1 }
            at += 3
            continue
        }
        if pattern[at] == 39 && at + 1 < pattern.length && pattern[at + 1] == 39 {
            m.pushByte(&parts[part], 39)
            at += 2
            continue
        }
        m.pushByte(&parts[part], pattern[at])
        at += 1
    }
    nb.clear(b)
    var lengthPrefix = nb.appendText(b, m.bytesText(&parts[0]), nb.NONE)
    var length1: i32 = 0
    var lengthInfix = nb.appendText(b, m.bytesText(&parts[1]), nb.NONE)
    var length2: i32 = 0
    var lengthSuffix: i32 = @intCast(i32, nb.appendText(b, m.bytesText(&parts[2]), nb.NONE))
    m.disposeBytes(&parts[0])
    m.disposeBytes(&parts[1])
    m.disposeBytes(&parts[2])
    // Spaces around the infix when a modifier is repeated.
    const repeatInner = !collapseInner && micros1.*.scientific
    const repeatMiddle = !collapseMiddle && middleCodePoints(f, micros1) > 0
    const repeatOuter = !collapseOuter && nf.outerCodePoints(f, micros1.*.outerPlural) > 0
    if repeatInner || repeatMiddle || repeatOuter {
        const i1 = lengthPrefix
        if i1 >= b.*.length || !isWhiteSpace(nb.unitAt(b, i1)) {
            lengthInfix += nb.insertCodePoint(b, i1, 32, nb.NONE)
        }
        const i2 = lengthPrefix + lengthInfix
        if !isWhiteSpace(nb.unitAt(b, i2 - 1)) {
            lengthInfix += nb.insertCodePoint(b, i2, 32, nb.NONE)
        }
    }
    length1 += @intCast(i32, nf.writeNumber(f, q1, b, lengthPrefix))
    var second = nb.builder()
    _ = nf.writeNumber(f, q2, &second, 0)
    length2 += @intCast(i32, nb.insertBuilder(b, @intCast(usize, @intCast(i32, lengthPrefix) + length1) + lengthInfix, &second))
    nb.dispose(&second)
    // The modifiers, inner to outer.
    var index0 = lengthPrefix
    // Inner (the exponent).
    if collapseInner {
        if micros1.*.scientific {
            const all = @intCast(usize, @intCast(i32, index0) + length1 + @intCast(i32, lengthInfix) + length2 + lengthSuffix)
            lengthSuffix += @intCast(i32, applyExponentAt(f, micros1, b, all))
        }
    } else {
        if micros1.*.scientific {
            length1 += @intCast(i32, applyExponentAt(f, micros1, b, @intCast(usize, @intCast(i32, index0) + length1)))
        }
        if micros2.*.scientific {
            const end = @intCast(usize, @intCast(i32, index0) + length1 + @intCast(i32, lengthInfix) + length2 + lengthSuffix)
            length2 += @intCast(i32, applyExponentAt(f, micros2, b, end))
        }
    }
    // Middle (the pattern's affixes).
    if collapseMiddle {
        const end = @intCast(usize, @intCast(i32, index0) + length1 + @intCast(i32, lengthInfix) + length2 + lengthSuffix)
        var prefix: usize = 0
        const added = nf.applyMiddlePrefix(f, micros1, b, index0, end, &prefix)
        lengthSuffix += added - @intCast(i32, prefix)
        lengthPrefix += prefix
        index0 = lengthPrefix
    } else {
        length1 += nf.applyMiddle(f, micros1, b, index0, @intCast(usize, @intCast(i32, index0) + length1))
        const start2 = @intCast(usize, @intCast(i32, index0) + length1) + lengthInfix
        const end = @intCast(usize, @intCast(i32, start2) + length2 + lengthSuffix)
        length2 += nf.applyMiddle(f, micros2, b, start2, end)
    }
    // Outer (the long name).
    if collapseOuter {
        const end = @intCast(usize, @intCast(i32, index0) + length1 + @intCast(i32, lengthInfix) + length2 + lengthSuffix)
        var plural = micros1.*.outerPlural
        if micros1.*.outerPlural < 6 && micros2.*.outerPlural < 6 {
            const language = m.bytes(handle + 40, m.getWord(handle + 56))
            plural = pluralrules.rangeForm(language, micros1.*.outerPlural, micros2.*.outerPlural)
        }
        var prefix: usize = 0
        const added = nf.applyOuterPrefix(f, plural, b, index0, end, &prefix)
        lengthSuffix += added - @intCast(i32, prefix)
        lengthPrefix += prefix
        index0 = lengthPrefix
    } else {
        length1 += nf.applyOuter(f, micros1.*.outerPlural, b, index0, @intCast(usize, @intCast(i32, index0) + length1))
        const start2 = @intCast(usize, @intCast(i32, index0) + length1) + lengthInfix
        const end = @intCast(usize, @intCast(i32, start2) + length2 + lengthSuffix)
        length2 += nf.applyOuter(f, micros2.*.outerPlural, b, start2, end)
    }
    spans.*[0] = nb.SpanInfo.{ .category = CATEGORY_RANGE_SPAN, .value = 0, .start = lengthPrefix, .length = @intCast(usize, length1) }
    spans.*[1] = nb.SpanInfo.{ .category = CATEGORY_RANGE_SPAN, .value = 1, .start = @intCast(usize, @intCast(i32, lengthPrefix) + length1) + lengthInfix, .length = @intCast(usize, length2) }
}

fn applyExponentAt(f: *const nf.Formatter, micros: *const nf.Micros, b: *nb.Builder, right: usize) -> usize { return nf.applyExponent(f, micros.*.exponent, b, right) }

// Formats the range of the result's quantities (set by the caller) into
// the result (ICU's NumberRangeFormatterImpl::format).
fn formatQuantities(handle: usize, uresult: usize, equalBeforeRounding: bool, ec: usize) -> void {
    const f = formatterOf(handle)
    const q1 = firstQuantity(uresult)
    const q2 = secondQuantity(uresult)
    var micros1: nf.Micros = undefined
    var micros2: nf.Micros = undefined
    var status: i32 = 0
    nf.preProcess(f, q1, &micros1, false, &status)
    if status <= 0 { nf.preProcess(f, q2, &micros2, false, &status) }
    if status > 0 {
        formatted.clear(uresult)
        m.setError(ec, status)
        return
    }
    var b = nb.builder()
    var spans: [2]nb.SpanInfo = undefined
    var spanCount: usize = 0
    var identity = NOT_EQUAL
    const fallback = m.getI32(handle + 8)
    if !sameInner(&micros1, &micros2) || !sameMiddle(f, &micros1, &micros2) || !sameOuterExactly(&micros1, &micros2) {
        formatRange(handle, q1, q2, &micros1, &micros2, &b, &spans)
        spanCount = 2
    } else {
        if equalBeforeRounding {
            identity = EQUAL_BEFORE_ROUNDING
        } else if nq.equals(q1, q2) {
            identity = EQUAL_AFTER_ROUNDING
        }
        var action: i32 = 0
        if fallback == FALLBACK_RANGE || identity == NOT_EQUAL {
            action = 0
        } else if fallback == FALLBACK_APPROXIMATELY {
            action = 1
        } else if fallback == FALLBACK_APPROXIMATELY_OR_SINGLE_VALUE {
            action = if identity == EQUAL_AFTER_ROUNDING { 1 } else { 2 }
        } else {
            action = 2
        }
        if action == 0 {
            formatRange(handle, q1, q2, &micros1, &micros2, &b, &spans)
            spanCount = 2
        } else if action == 1 {
            // Formatted again with the approximately sign.
            nq.adjustMagnitude(q1, q1.*.exponent)
            q1.*.exponent = 0
            var micros: nf.Micros = undefined
            nf.preProcess(f, q1, &micros, true, &status)
            if status > 0 {
                nb.dispose(&b)
                formatted.clear(uresult)
                m.setError(ec, status)
                return
            }
            nb.clear(&b)
            var length = @intCast(i32, nf.writeNumber(f, q1, &b, 0))
            if micros.scientific { length += @intCast(i32, applyExponentAt(f, &micros, &b, @intCast(usize, length))) }
            length += nf.applyMiddle(f, &micros, &b, 0, @intCast(usize, length))
            _ = nf.applyOuter(f, micros.outerPlural, &b, 0, @intCast(usize, length))
        } else {
            nb.clear(&b)
            const length = nf.writeNumber(f, q1, &b, 0)
            _ = nf.writeAffixes(f, &micros1, &b, 0, length)
        }
    }
    m.putI32(formatted.extra(uresult) + 16, identity)
    nb.toValue(&b, uresult, 0, &spans, spanCount)
    nb.dispose(&b)
}

// The long names are the same modifier (one handler) unless one has none.
fn sameOuterExactly(a: *const nf.Micros, b: *const nf.Micros) -> bool { return sameOuter(a, b) }

export fn unumrf_formatDoubleRange(uformatter: usize, first: f64, second: f64, uresult: usize, ec: usize) -> void {
    if !validFormatter(uformatter, ec) { return }
    if !validResult(uresult, ec) { return }
    formatted.clear(uresult)
    nf.setDoubleWithSign(firstQuantity(uresult), first)
    nf.setDoubleWithSign(secondQuantity(uresult), second)
    var equal = false
    if first == second { equal = true }
    formatQuantities(uformatter, uresult, equal, ec)
}

export fn unumrf_formatDecimalRange(uformatter: usize, first: usize, firstLen: i32, second: usize, secondLen: i32, uresult: usize, ec: usize) -> void {
    if !validFormatter(uformatter, ec) { return }
    if !validResult(uresult, ec) { return }
    formatted.clear(uresult)
    if !nf.setDecimalText(firstQuantity(uresult), first, firstLen) || !nf.setDecimalText(secondQuantity(uresult), second, secondLen) {
        m.setError(ec, nf.DECIMAL_NUMBER_SYNTAX_ERROR)
        return
    }
    // ICU compares the two strings' addresses.
    var equal = false
    if first == second { equal = true }
    formatQuantities(uformatter, uresult, equal, ec)
}

export fn unumrf_resultAsValue(uresult: usize, ec: usize) -> usize {
    if !validResult(uresult, ec) { return 0 }
    return uresult
}

export fn unumrf_resultGetIdentityResult(uresult: usize, ec: usize) -> i32 {
    if !validResult(uresult, ec) { return 3 }
    return m.getI32(formatted.extra(uresult) + 16)
}

fn giveDecimal(q: *const nq.Quantity, dest: usize, destCapacity: i32, ec: usize) -> i32 {
    var text = m.bytesBuffer()
    nq.decimalText(q, &text)
    const length = m.give(m.bytesText(&text), dest, destCapacity, ec)
    m.disposeBytes(&text)
    return length
}

export fn unumrf_resultGetFirstDecimalNumber(uresult: usize, dest: usize, destCapacity: i32, ec: usize) -> i32 {
    if !validResult(uresult, ec) { return 0 }
    return giveDecimal(firstQuantity(uresult), dest, destCapacity, ec)
}

export fn unumrf_resultGetSecondDecimalNumber(uresult: usize, dest: usize, destCapacity: i32, ec: usize) -> i32 {
    if !validResult(uresult, ec) { return 0 }
    return giveDecimal(secondQuantity(uresult), dest, destCapacity, ec)
}
