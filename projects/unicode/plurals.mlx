// Plural rules, CLDR's (UTS #35, Language Plural Rules): a locale's
// cardinal or ordinal rules from the supplemental data, and the keyword
// (zero, one, two, few, many, other) a number takes by them.
//
// A number is given as its decimal digits as shown ("1.50" has two
// visible fraction digits, so v = 2, f = 50, t = 5) and its compact
// exponent (e, c: "1.2K" is 1.2 with e = 3). The rules are read at each
// selection: a rule is short, and parsing it costs less than keeping it.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")

pub const CARDINAL: u32 = 0
pub const ORDINAL: u32 = 1

// The keywords in CLDR's order (the order uplrules_getKeywords gives).
pub const KEYWORDS = [6][]const u8{ "zero", "one", "two", "few", "many", "other" }

// A number's operands. An integer part beyond u64 is `huge` (then it
// equals no value a rule names; its remainders still come from its last
// digits).
pub const Operands = struct {
    // The integer digits (i), and the number's own digits for remainders.
    integer: u64
    huge: bool
    // The last 18 integer digits, for i % m and n % m on huge numbers.
    lastDigits: u64
    // v, w, f, t.
    visible: u32
    trimmed: u32
    fraction: u64
    fractionTrimmed: u64
    // e (and c).
    exponent: u32
}

// The operands of DIGITS ("-1234.50", an optional sign, digits, an
// optional point and fraction) with compact exponent EXPONENT.
pub fn operands(digits: []const u8, exponent: u32) -> Operands {
    var o = Operands.{ .integer = 0, .huge = false, .lastDigits = 0, .visible = 0, .trimmed = 0, .fraction = 0, .fractionTrimmed = 0, .exponent = exponent }
    var at: usize = 0
    if at < digits.length && (digits[at] == 45 || digits[at] == 43) { at += 1 }
    var count: u32 = 0
    while at < digits.length && digits[at] >= 48 && digits[at] <= 57 {
        const d = @intCast(u64, digits[at] - 48)
        if o.integer > 1844674407370955160 || (o.integer == 1844674407370955161 && d > 5) {
            o.huge = true
        } else if !o.huge {
            o.integer = o.integer * 10 + d
        }
        o.lastDigits = (o.lastDigits % 100000000000000000) * 10 + d
        count += 1
        at += 1
    }
    if at < digits.length && digits[at] == 46 {
        at += 1
        var trimmedValue: u64 = 0
        var trimmedCount: u32 = 0
        var zeros: u32 = 0
        while at < digits.length && digits[at] >= 48 && digits[at] <= 57 {
            const d = @intCast(u64, digits[at] - 48)
            if o.visible < 18 { o.fraction = o.fraction * 10 + d }
            o.visible += 1
            if d == 0 {
                zeros += 1
            } else {
                while zeros > 0 {
                    if trimmedCount < 18 { trimmedValue = trimmedValue * 10 }
                    trimmedCount += 1
                    zeros -= 1
                }
                if trimmedCount < 18 { trimmedValue = trimmedValue * 10 + d }
                trimmedCount += 1
            }
            at += 1
        }
        o.fractionTrimmed = trimmedValue
        o.trimmed = trimmedCount
    }
    return o
}

// ---------------------------------------------------------------------------
// The rules: `condition := and ('or' and)*`, `and := relation ('and'
// relation)*`, `relation := operand ('%' value)? ('='|'!=') ranges`,
// `ranges := (value | value '..' value) (',' ...)*`; samples (after '@')
// are not part of it.

const Parser = struct {
    text: []const u8
    at: usize
    failed: bool
}

fn skipSpace(p: *Parser) -> void {
    while p.*.at < p.*.text.length && (p.*.text[p.*.at] == 32 || p.*.text[p.*.at] == 9) { p.*.at += 1 }
}

fn atEnd(p: *Parser) -> bool {
    skipSpace(p)
    return p.*.at >= p.*.text.length || p.*.text[p.*.at] == 64
}

fn word(p: *Parser, expected: []const u8) -> bool {
    skipSpace(p)
    const end = p.*.at + expected.length
    if end > p.*.text.length || !m.same(p.*.text[p.*.at..end], expected) { return false }
    if end < p.*.text.length && p.*.text[end] >= 97 && p.*.text[end] <= 122 { return false }
    p.*.at = end
    return true
}

fn number(p: *Parser) -> u64 {
    skipSpace(p)
    var value: u64 = 0
    var any = false
    while p.*.at < p.*.text.length && p.*.text[p.*.at] >= 48 && p.*.text[p.*.at] <= 57 {
        if value < 1000000000000000000 { value = value * 10 + @intCast(u64, p.*.text[p.*.at] - 48) }
        p.*.at += 1
        any = true
    }
    if !any { p.*.failed = true }
    return value
}

// An operand's value modulo MODULUS (0 for none): whether it is an
// integer, and the value.
fn operandValue(o: *const Operands, name: u8, modulus: u64, isInteger: *bool) -> u64 {
    isInteger.* = true
    // n: the integer when there is no fraction.
    if name == 110 || name == 105 {
        if name == 110 && o.*.trimmed > 0 { isInteger.* = false }
        if modulus > 0 { return (if o.*.huge { o.*.lastDigits } else { o.*.integer }) % modulus }
        if o.*.huge {
            isInteger.* = false
            return 0
        }
        return o.*.integer
    }
    var value: u64 = 0
    if name == 118 { value = @intCast(u64, o.*.visible) }
    if name == 119 { value = @intCast(u64, o.*.trimmed) }
    if name == 102 { value = o.*.fraction }
    if name == 116 { value = o.*.fractionTrimmed }
    if name == 101 || name == 99 { value = @intCast(u64, o.*.exponent) }
    return if modulus > 0 { value % modulus } else { value }
}

fn relation(p: *Parser, o: *const Operands) -> bool {
    skipSpace(p)
    if p.*.at >= p.*.text.length {
        p.*.failed = true
        return false
    }
    const name = p.*.text[p.*.at]
    p.*.at += 1
    var modulus: u64 = 0
    skipSpace(p)
    if p.*.at < p.*.text.length && p.*.text[p.*.at] == 37 {
        p.*.at += 1
        modulus = number(p)
    }
    skipSpace(p)
    var negated = false
    if p.*.at + 1 < p.*.text.length && p.*.text[p.*.at] == 33 && p.*.text[p.*.at + 1] == 61 {
        negated = true
        p.*.at += 2
    } else if p.*.at < p.*.text.length && p.*.text[p.*.at] == 61 {
        p.*.at += 1
    } else {
        p.*.failed = true
        return false
    }
    var isInteger = true
    const value = operandValue(o, name, modulus, &isInteger)
    var matched = false
    while true {
        const low = number(p)
        var high = low
        skipSpace(p)
        if p.*.at + 1 < p.*.text.length && p.*.text[p.*.at] == 46 && p.*.text[p.*.at + 1] == 46 {
            p.*.at += 2
            high = number(p)
        }
        if isInteger && value >= low && value <= high { matched = true }
        skipSpace(p)
        if p.*.at < p.*.text.length && p.*.text[p.*.at] == 44 {
            p.*.at += 1
            continue
        }
        break
    }
    return if negated { !matched } else { matched }
}

// Whether RULE holds for O (an empty rule holds: "other").
pub fn holds(rule: []const u8, o: *const Operands) -> bool {
    var p = Parser.{ .text = rule, .at = 0, .failed = false }
    if atEnd(&p) { return true }
    var any = false
    while true {
        var all = true
        while true {
            if !relation(&p, o) { all = false }
            if p.failed { return false }
            if !word(&p, "and") { break }
        }
        if all { any = true }
        if !word(&p, "or") { break }
    }
    return any && !p.failed
}

// ---------------------------------------------------------------------------
// A locale's rules.

fn kindName(kind: u32) -> []const u8 { return if kind == ORDINAL { "plurals-type-ordinal" } else { "plurals-type-cardinal" } }

// The name the rules of LOCALE are under (its language, or the locale
// itself when CLDR has rules for it alone, as pt-PT), "" when none.
pub fn rulesLocale(locale: []const u8, kind: u32, into: *[64]u8) -> usize {
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, into) }
    var length: usize = 0
    for byte in locale {
        if byte == 64 || length == 60 { break }
        bytes[length] = if byte == 95 { 45 } else { byte }
        length += 1
    }
    const supplemental = resources.supplemental()
    if supplemental == resources.NONE { return 0 }
    while length > 0 {
        var first: u32 = 0
        var end: u32 = 0
        var path: [128]u8 = undefined
        const pathBytes: [*]u8 = unsafe { @ptrCast([*]u8, &path) }
        const name = kindName(kind)
        var p: usize = 0
        for byte in name {
            pathBytes[p] = byte
            p += 1
        }
        pathBytes[p] = 47
        p += 1
        var index: usize = 0
        while index < length {
            pathBytes[p] = bytes[index]
            p += 1
            index += 1
        }
        resources.below(pathBytes[0..p], &first, &end)
        if first < end { return length }
        // Shorter by a subtag.
        while length > 0 && bytes[length - 1] != 45 { length -= 1 }
        if length > 0 { length -= 1 }
    }
    // und's (root's) rules: everything is "other".
    return 0
}

// The rule of KEYWORD for the rules under NAME ("" when there is none).
pub fn rule(name: []const u8, kind: u32, keyword: []const u8) -> []const u8 {
    var path: [192]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &path) }
    var length: usize = 0
    const parts = [4][]const u8{ kindName(kind), "/", name, "/pluralRule-count-" }
    for part in parts {
        for byte in part {
            bytes[length] = byte
            length += 1
        }
    }
    for byte in keyword {
        bytes[length] = byte
        length += 1
    }
    return resources.get(resources.supplemental(), bytes[0..length])
}

// Whether the rules under NAME have KEYWORD ("other" they all have).
pub fn hasKeyword(name: []const u8, kind: u32, keyword: []const u8) -> bool {
    if m.same(keyword, "other") { return true }
    if name.length == 0 { return false }
    var value: []const u8 = ""
    var path: [192]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &path) }
    var length: usize = 0
    const parts = [4][]const u8{ kindName(kind), "/", name, "/pluralRule-count-" }
    for part in parts {
        for byte in part {
            bytes[length] = byte
            length += 1
        }
    }
    for byte in keyword {
        bytes[length] = byte
        length += 1
    }
    return resources.lookup(resources.supplemental(), bytes[0..length], &value)
}

// The keyword O takes by the rules under NAME: the first whose rule holds,
// in CLDR's order, else "other".
pub fn select(name: []const u8, kind: u32, o: *const Operands) -> []const u8 {
    if name.length == 0 { return "other" }
    var index: usize = 0
    while index < 5 {
        const r = rule(name, kind, KEYWORDS[index])
        if r.length > 0 && holds(r, o) { return KEYWORDS[index] }
        index += 1
    }
    return "other"
}

// The keyword a range takes from the keywords of its ends (CLDR's plural
// ranges for the language), "other" when CLDR does not say.
pub fn selectRange(name: []const u8, start: []const u8, end: []const u8) -> []const u8 {
    var language = name
    var cut: usize = 0
    while cut < name.length && name[cut] != 45 { cut += 1 }
    language = name[0..cut]
    var path: [128]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &path) }
    var length: usize = 0
    const parts = [6][]const u8{ "plurals/", language, "/pluralRange-start-", start, "-end-", end }
    for part in parts {
        for byte in part {
            if length < 127 {
                bytes[length] = byte
                length += 1
            }
        }
    }
    var value: []const u8 = ""
    if resources.lookup(resources.supplemental(), bytes[0..length], &value) { return value }
    return end
}
