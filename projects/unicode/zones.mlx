// Time zones (timezones.mlx, made by tzgenerate.mlx from the IANA
// database): an ID's zone, the offsets in force at a moment (the
// standard offset and what daylight saving adds), the transitions.
// Moments are seconds since 1970 (UTC), offsets seconds.
const tz = @import("./timezones.mlx")

pub const NONE: usize = 999999

pub const Offsets = struct {
    raw: i64
    save: i64
}

// ---------------------------------------------------------------------------
// IDs

pub fn idCount() -> usize { return tz.ID_COUNT }

pub fn idName(id: usize) -> []const u8 {
    const start = @intCast(usize, tz.ID_STARTS[id])
    const end = @intCast(usize, tz.ID_STARTS[id + 1]) - 1
    return tz.IDS[start..end]
}

fn compare(first: []const u8, second: []const u8) -> i32 {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return if first[index] < second[index] { -1 } else { 1 } }
        index += 1
    }
    if first.length == second.length { return 0 }
    return if first.length < second.length { -1 } else { 1 }
}

// The ID named `name` exactly; NONE.
pub fn find(name: []const u8) -> usize {
    var low: usize = 0
    var high = tz.ID_COUNT
    while low < high {
        const middle = (low + high) / 2
        const order = compare(idName(middle), name)
        if order == 0 { return middle }
        if order < 0 { low = middle + 1 } else { high = middle }
    }
    return NONE
}

pub fn zoneOf(id: usize) -> usize { return @intCast(usize, tz.ID_ZONES[id]) }

pub fn isCanonical(id: usize) -> bool { return tz.ID_CANONICAL[id] != 0 }

// The ID of a zone's own name.
pub fn zoneId(zone: usize) -> usize {
    var id: usize = 0
    while id < tz.ID_COUNT {
        if tz.ID_CANONICAL[id] != 0 && @intCast(usize, tz.ID_ZONES[id]) == zone { return id }
        id += 1
    }
    return NONE
}

// The ID's country: two letters, the first in the high byte; 0.
pub fn region(id: usize) -> u16 { return tz.ID_REGIONS[id] }

pub fn version() -> []const u8 { return tz.VERSION }

// ---------------------------------------------------------------------------
// The calendar of the rules (proleptic Gregorian).

fn floorDivide(value: i64, divisor: i64) -> i64 {
    const quotient = value / divisor
    return if value % divisor != 0 && (value < 0) != (divisor < 0) { quotient - 1 } else { quotient }
}

fn isLeap(year: i64) -> bool { return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 }

fn monthLength(year: i64, month: i64) -> i64 {
    if month == 2 { return if isLeap(year) { 29 } else { 28 } }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

fn daysFromCivil(year: i64, month: i64, day: i64) -> i64 {
    const y = if month <= 2 { year - 1 } else { year }
    const era = floorDivide(y, 400)
    const yearOfEra = y - era * 400
    const shifted = if month > 2 { month - 3 } else { month + 9 }
    const dayOfYear = (153 * shifted + 2) / 5 + day - 1
    return era * 146097 + yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear - 719468
}

fn weekday(days: i64) -> i64 {
    const value = (days + 4) % 7
    return if value < 0 { value + 7 } else { value }
}

// The (proleptic Gregorian) year of a moment in local seconds.
fn yearOf(seconds: i64) -> i64 {
    const days = floorDivide(seconds, 86400) + 719468
    const era = floorDivide(days, 146097)
    const dayOfEra = days - era * 146097
    const yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    const dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    const month = (5 * dayOfYear + 2) / 153
    return yearOfEra + era * 400 + (if month >= 10 { 1 } else { 0 })
}

// ---------------------------------------------------------------------------
// The final rules: the transitions of one year.

const MAX_RULES: usize = 8

const Year = struct {
    count: usize
    times: [8]i64
    saves: [8]i64
}

// Rule `rule`'s moment in `year`, local, by its own kind of time.
fn ruleMoment(rule: usize, year: i64) -> i64 {
    const month = @intCast(i64, tz.FINAL_MONTHS[rule])
    const kind = tz.FINAL_DAY_KINDS[rule]
    const day = @intCast(i64, tz.FINAL_DAYS[rule])
    const wanted = @intCast(i64, tz.FINAL_WEEKDAYS[rule])
    var days: i64 = 0
    if kind == 0 {
        days = daysFromCivil(year, month, day)
    } else if kind == 1 {
        days = daysFromCivil(year, month, monthLength(year, month))
        while weekday(days) != wanted { days -= 1 }
    } else if kind == 2 {
        days = daysFromCivil(year, month, day)
        while weekday(days) != wanted { days += 1 }
    } else {
        days = daysFromCivil(year, month, day)
        while weekday(days) != wanted { days -= 1 }
    }
    return days * 86400 + @intCast(i64, tz.FINAL_ATS[rule])
}

// The zone's final transitions in `year`, in order: the rules sorted by
// their moments, each in universal time by the save before it (the last
// rule's, the year before).
fn finalYear(zone: usize, year: i64, into: *Year) -> void {
    const first = @intCast(usize, tz.ZONE_FINAL_FIRSTS[zone])
    var count = @intCast(usize, tz.ZONE_FINAL_FIRSTS[zone + 1]) - first
    if count > MAX_RULES { count = MAX_RULES }
    var order: [8]usize = undefined
    var locals: [8]i64 = undefined
    var index: usize = 0
    while index < count {
        const moment = ruleMoment(first + index, year)
        var place = index
        while place > 0 && locals[place - 1] > moment {
            locals[place] = locals[place - 1]
            order[place] = order[place - 1]
            place -= 1
        }
        locals[place] = moment
        order[place] = first + index
        index += 1
    }
    const raw = @intCast(i64, tz.ZONE_FINAL_RAWS[zone])
    var save: i64 = if count > 0 { @intCast(i64, tz.FINAL_SAVES[order[count - 1]]) } else { 0 }
    into.*.count = count
    index = 0
    while index < count {
        const rule = order[index]
        const kindOfTime = tz.FINAL_AT_KINDS[rule]
        var time = locals[index]
        if kindOfTime != 2 { time -= raw }
        if kindOfTime == 0 { time -= save }
        save = @intCast(i64, tz.FINAL_SAVES[rule])
        into.*.times[index] = time
        into.*.saves[index] = save
        index += 1
    }
}

fn hasFinal(zone: usize) -> bool { return tz.ZONE_FINAL_YEARS[zone] != 0 }

// The first moment the final rules govern.
fn finalStart(zone: usize) -> i64 {
    var year: Year = undefined
    finalYear(zone, @intCast(i64, tz.ZONE_FINAL_YEARS[zone]), &year)
    if year.count == 0 { return 9223372036854775807 }
    return year.times[0]
}

// ---------------------------------------------------------------------------
// Offsets

fn firstTransition(zone: usize) -> usize { return @intCast(usize, tz.ZONE_FIRSTS[zone]) }
fn endTransition(zone: usize) -> usize { return @intCast(usize, tz.ZONE_FIRSTS[zone + 1]) }

// The index of the zone's last transition at or before `utc`; NONE.
fn lastAtOrBefore(zone: usize, utc: i64) -> usize {
    var low = firstTransition(zone)
    var high = endTransition(zone)
    if low == high || tz.TRANSITION_TIMES[low] > utc { return NONE }
    while high - low > 1 {
        const middle = (low + high) / 2
        if tz.TRANSITION_TIMES[middle] <= utc { low = middle } else { high = middle }
    }
    return low
}

pub fn offsetsAt(zone: usize, utc: i64) -> Offsets {
    if hasFinal(zone) && utc >= finalStart(zone) {
        const raw = @intCast(i64, tz.ZONE_FINAL_RAWS[zone])
        const year = yearOf(utc + raw)
        var save: i64 = 0
        var found = false
        var y = year - 1
        while y <= year + 1 {
            var rules: Year = undefined
            finalYear(zone, y, &rules)
            var index: usize = 0
            while index < rules.count {
                if rules.times[index] <= utc {
                    save = rules.saves[index]
                    found = true
                }
                index += 1
            }
            y += 1
        }
        if found { return Offsets.{ .raw = raw, .save = save } }
    }
    const at = lastAtOrBefore(zone, utc)
    if at == NONE { return Offsets.{ .raw = @intCast(i64, tz.ZONE_INITIAL_RAWS[zone]), .save = @intCast(i64, tz.ZONE_INITIAL_SAVES[zone]) } }
    return Offsets.{ .raw = @intCast(i64, tz.TRANSITION_RAWS[at]), .save = @intCast(i64, tz.TRANSITION_SAVES[at]) }
}

pub fn totalAt(zone: usize, utc: i64) -> i64 {
    const offsets = offsetsAt(zone, utc)
    return offsets.raw + offsets.save
}

// ---------------------------------------------------------------------------
// Transitions

pub const Transition = struct {
    found: bool
    time: i64
}

const NOT_FOUND = Transition.{ .found = false, .time = 0 }

// The first transition after `utc` (at it too when `inclusive`).
pub fn nextTransition(zone: usize, utc: i64, inclusive: bool) -> Transition {
    const end = endTransition(zone)
    var index = lastAtOrBefore(zone, utc)
    if index == NONE {
        index = firstTransition(zone)
    } else if !(inclusive && tz.TRANSITION_TIMES[index] == utc) {
        index += 1
    }
    if index < end && (!hasFinal(zone) || tz.TRANSITION_TIMES[index] < finalStart(zone)) {
        return Transition.{ .found = true, .time = tz.TRANSITION_TIMES[index] }
    }
    if !hasFinal(zone) { return NOT_FOUND }
    const startYear = @intCast(i64, tz.ZONE_FINAL_YEARS[zone])
    var y = yearOf(utc) - 1
    if y < startYear { y = startYear }
    const last = y + 3
    while y <= last {
        var rules: Year = undefined
        finalYear(zone, y, &rules)
        var at: usize = 0
        while at < rules.count {
            const time = rules.times[at]
            if time > utc || (inclusive && time == utc) { return Transition.{ .found = true, .time = time } }
            at += 1
        }
        y += 1
    }
    return NOT_FOUND
}

// The last transition before `utc` (or at it when `inclusive`).
pub fn previousTransition(zone: usize, utc: i64, inclusive: bool) -> Transition {
    if hasFinal(zone) && utc >= finalStart(zone) {
        const startYear = @intCast(i64, tz.ZONE_FINAL_YEARS[zone])
        var y = yearOf(utc) + 1
        while y >= startYear {
            var rules: Year = undefined
            finalYear(zone, y, &rules)
            var at = rules.count
            while at > 0 {
                at -= 1
                const time = rules.times[at]
                if time < utc || (inclusive && time == utc) { return Transition.{ .found = true, .time = time } }
            }
            y -= 1
        }
    }
    const probe = if inclusive { utc } else { utc - 1 }
    var index = lastAtOrBefore(zone, probe)
    if index == NONE { return NOT_FOUND }
    if hasFinal(zone) {
        const start = finalStart(zone)
        while index != NONE && tz.TRANSITION_TIMES[index] >= start {
            index = if index > firstTransition(zone) { index - 1 } else { NONE }
        }
        if index == NONE { return NOT_FOUND }
    }
    return Transition.{ .found = true, .time = tz.TRANSITION_TIMES[index] }
}
