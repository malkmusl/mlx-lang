// The names of time zones in date formats (ICU's TimeZoneFormat,
// TimeZoneNames and TimeZoneGenericNames), from CLDR's timeZoneNames
// (dates/timeZoneNames: gmtFormat, gmtZeroFormat, hourFormat,
// regionFormat, fallbackFormat, the names and exemplar cities of zones
// and metazones), the metazones of each zone in time and their golden
// zones (supplemental metaZones), primaryZones, the regions' names
// (localeDisplayNames/territories) and the zones of the IANA database
// (zones.mlx): the specific names (z), the generic ones (v) with their
// partial location fallbacks, the generic location (VVVV), the exemplar
// city (VVV), the IDs (V, VV), the localized GMT formats (O, ZZZZ) and
// ISO 8601's (X, x, Z).
//
// A zone's names are those of its CLDR canonical ID (Asia/Calcutta for
// Asia/Kolkata), CLDR's BCP 47 zone types (locales.mlx) giving the IDs.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const zones = @import("./zones.mlx")
const cldr = @import("./locales.mlx")
const text = @import("./datetext.mlx")
const symbols = @import("./datesymbols.mlx")

const Text = text.Text

// UTimeZoneFormatStyle
pub const GENERIC_LOCATION: i32 = 0
pub const GENERIC_LONG: i32 = 1
pub const GENERIC_SHORT: i32 = 2
pub const SPECIFIC_LONG: i32 = 3
pub const SPECIFIC_SHORT: i32 = 4
pub const LOCALIZED_GMT: i32 = 5
pub const LOCALIZED_GMT_SHORT: i32 = 6
pub const ISO_BASIC_SHORT: i32 = 7
pub const ISO_BASIC_LOCAL_SHORT: i32 = 8
pub const ISO_BASIC_FIXED: i32 = 9
pub const ISO_BASIC_LOCAL_FIXED: i32 = 10
pub const ISO_BASIC_FULL: i32 = 11
pub const ISO_BASIC_LOCAL_FULL: i32 = 12
pub const ISO_EXTENDED_FIXED: i32 = 13
pub const ISO_EXTENDED_LOCAL_FIXED: i32 = 14
pub const ISO_EXTENDED_FULL: i32 = 15
pub const ISO_EXTENDED_LOCAL_FULL: i32 = 16
pub const ZONE_ID: i32 = 17
pub const ZONE_ID_SHORT: i32 = 18
pub const EXEMPLAR_LOCATION: i32 = 19

const HOUR_MS: i64 = 3600000
const MINUTE_MS: i64 = 60000
const MAX_OFFSET: i64 = 86400000
// Six months: how near a daylight period must be for a generic name.
const DST_CHECK_RANGE: f64 = 15897600000.0

// The format of a locale:
pub const Format = struct {
    data: u32
    gmtPrefix: Text
    gmtSuffix: Text
    gmtZero: Text
    // +H, +HM, +HMS, -H, -HM, -HMS
    offsets: [6]Text
    regionFormat: Text
    fallbackFormat: Text
    region: [4]u8
    regionLength: usize
    digits: [10]u32
}

fn formatAt(address: usize) -> *Format { unsafe { return @ptrFromInt(*Format, address) } }

pub fn of(address: usize) -> *Format { return formatAt(address) }

fn unquote(source: *const Text, start: usize, end: usize, into: *Text) -> void {
    var previousQuote = false
    var index = start
    while index < end {
        const c = text.at(source, index)
        if c == 39 {
            if previousQuote {
                text.push(into, 39)
                previousQuote = false
            } else {
                previousQuote = true
            }
        } else {
            previousQuote = false
            text.push(into, c)
        }
        index += 1
    }
}

// "+HH:mm" to "+HH:mm:ss" and to "+HH".
fn expandOffset(hm: *const Text, into: *Text) -> bool {
    var mm = text.fromUtf8("mm")
    const minutes = text.find(hm, &mm, 0)
    text.dispose(&mm)
    if minutes == text.NOT_FOUND { return false }
    var hour = minutes
    while hour > 0 && text.at(hm, hour - 1) != 72 { hour -= 1 }
    text.pushRange(into, hm, 0, minutes + 2)
    if hour > 0 { text.pushRange(into, hm, hour, minutes) }
    text.pushUtf8(into, "ss")
    text.pushRange(into, hm, minutes + 2, hm.*.length)
    return true
}

fn truncateOffset(hm: *const Text, into: *Text) -> bool {
    var mm = text.fromUtf8("mm")
    const minutes = text.find(hm, &mm, 0)
    text.dispose(&mm)
    if minutes == text.NOT_FOUND { return false }
    var index = minutes
    while index > 1 {
        if text.at(hm, index - 1) == 72 && text.at(hm, index - 2) == 72 {
            text.pushRange(into, hm, 0, index)
            return true
        }
        index -= 1
    }
    index = minutes
    while index > 0 {
        if text.at(hm, index - 1) == 72 {
            text.pushRange(into, hm, 0, index)
            return true
        }
        index -= 1
    }
    return false
}

pub fn create(id: *const symbols.Id, data: u32, digits: *const symbols.Digits) -> usize {
    const address = m.alloc(@sizeOf(Format))
    if address == 0 { return 0 }
    var f = formatAt(address)
    f.*.data = data
    f.*.digits = digits.*.digits
    var gmt = text.empty()
    if !symbols.lookupText(data, "dates/timeZoneNames/gmtFormat", &gmt) || !text.contains(&gmt, 123) {
        text.clear(&gmt)
        text.pushUtf8(&gmt, "GMT{0}")
    }
    var arg = text.fromUtf8("{0}")
    const at = text.find(&gmt, &arg, 0)
    text.dispose(&arg)
    unquote(&gmt, 0, at, &f.*.gmtPrefix)
    unquote(&gmt, at + 3, gmt.length, &f.*.gmtSuffix)
    text.dispose(&gmt)
    if !symbols.lookupText(data, "dates/timeZoneNames/gmtZeroFormat", &f.*.gmtZero) { text.pushUtf8(&f.*.gmtZero, "GMT") }
    var hours = text.empty()
    var usable = false
    if symbols.lookupText(data, "dates/timeZoneNames/hourFormat", &hours) {
        const semicolon = text.indexOf(&hours, 59)
        if semicolon != text.NOT_FOUND {
            text.pushRange(&f.*.offsets[1], &hours, 0, semicolon)
            text.pushRange(&f.*.offsets[4], &hours, semicolon + 1, hours.length)
            usable = expandOffset(&f.*.offsets[1], &f.*.offsets[2]) && expandOffset(&f.*.offsets[4], &f.*.offsets[5])
            usable = usable && truncateOffset(&f.*.offsets[1], &f.*.offsets[0]) && truncateOffset(&f.*.offsets[4], &f.*.offsets[3])
        }
    }
    text.dispose(&hours)
    if !usable {
        const defaults = "\n+H\n+HH:mm\n+HH:mm:ss\n-H\n-HH:mm\n-HH:mm:ss\n"
        var k: usize = 0
        while k < 6 {
            text.clear(&f.*.offsets[k])
            text.pushUtf8(&f.*.offsets[k], symbols.listItem(defaults, k))
            k += 1
        }
    }
    if !symbols.lookupText(data, "dates/timeZoneNames/regionFormat", &f.*.regionFormat) { text.pushUtf8(&f.*.regionFormat, "{0}") }
    if !symbols.lookupText(data, "dates/timeZoneNames/fallbackFormat", &f.*.fallbackFormat) { text.pushUtf8(&f.*.fallbackFormat, "{1} ({0})") }
    // The target region: the locale's, else its likely one.
    const own = symbols.country(id)
    if own.length > 0 && own.length < 4 {
        var k: usize = 0
        while k < own.length {
            f.*.region[k] = own[k]
            k += 1
        }
        f.*.regionLength = own.length
    } else {
        const likely = symbols.likelyRegion(symbols.baseName(id))
        f.*.region[0] = @intCast(u8, likely >> 8)
        f.*.region[1] = @intCast(u8, likely & 255)
        f.*.regionLength = if likely == 0 { 0 } else { 2 }
    }
    return address
}

pub fn clone(address: usize) -> usize {
    if address == 0 { return 0 }
    const copy = m.alloc(@sizeOf(Format))
    if copy == 0 { return 0 }
    m.copy(copy, address, @sizeOf(Format))
    var f = formatAt(copy)
    const source = formatAt(address)
    f.*.gmtPrefix = text.copy(&source.*.gmtPrefix)
    f.*.gmtSuffix = text.copy(&source.*.gmtSuffix)
    f.*.gmtZero = text.copy(&source.*.gmtZero)
    var k: usize = 0
    while k < 6 {
        f.*.offsets[k] = text.copy(&source.*.offsets[k])
        k += 1
    }
    f.*.regionFormat = text.copy(&source.*.regionFormat)
    f.*.fallbackFormat = text.copy(&source.*.fallbackFormat)
    return copy
}

pub fn destroy(address: usize) -> void {
    if address == 0 { return }
    var f = formatAt(address)
    text.dispose(&f.*.gmtPrefix)
    text.dispose(&f.*.gmtSuffix)
    text.dispose(&f.*.gmtZero)
    var k: usize = 0
    while k < 6 {
        text.dispose(&f.*.offsets[k])
        k += 1
    }
    text.dispose(&f.*.regionFormat)
    text.dispose(&f.*.fallbackFormat)
    m.release(address)
}

// ---------------------------------------------------------------------------
// Zones: the CLDR canonical ID of an ID, its short (BCP 47) ID.

fn typeKey(index: usize) -> []const u8 {
    const start = @intCast(usize, cldr.TYPE_KEYS_STARTS[index])
    const end = @intCast(usize, cldr.TYPE_KEYS_STARTS[index + 1]) - 1
    return cldr.TYPE_KEYS[start..end]
}

fn typeValue(index: usize) -> []const u8 {
    const start = @intCast(usize, cldr.TYPE_VALUES_STARTS[index])
    const end = @intCast(usize, cldr.TYPE_VALUES_STARTS[index + 1]) - 1
    return cldr.TYPE_VALUES[start..end]
}

fn isZoneType(index: usize) -> bool {
    const key = typeKey(index)
    return key.length > 3 && key[0] == 116 && key[1] == 122 && key[2] == 47
}

fn hasSlash(name: []const u8) -> bool {
    for byte in name {
        if byte == 47 { return true }
    }
    return false
}

// The type of CLDR's canonical ID for ID (an index of the BCP 47 types),
// NONE_TYPE when it names no zone of CLDR's.
pub const NONE_TYPE: usize = 18446744073709551615

// The last ID looked up (shared by the threads under a lock).
var cacheLock: u32 = 0
var cachedId: [64]u8 = undefined
var cachedLength: usize = 99
var cachedType: usize = 0

pub fn canonicalType(id: []const u8) -> usize {
    if id.length >= 64 { return findCanonicalType(id) }
    while @atomicRmw(u32, &cacheLock, xchg, 1, acquire) != 0 {}
    if id.length == cachedLength {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &cachedId) }
        if m.same(view[0..cachedLength], id) {
            const kind = cachedType
            @atomicStore(u32, &cacheLock, 0, release)
            return kind
        }
    }
    @atomicStore(u32, &cacheLock, 0, release)
    const found = findCanonicalType(id)
    while @atomicRmw(u32, &cacheLock, xchg, 1, acquire) != 0 {}
    var k: usize = 0
    while k < id.length {
        cachedId[k] = id[k]
        k += 1
    }
    cachedLength = id.length
    cachedType = found
    @atomicStore(u32, &cacheLock, 0, release)
    return found
}

fn findCanonicalType(id: []const u8) -> usize {
    if id.length == 0 { return NONE_TYPE }
    var index: usize = 0
    while index < cldr.TYPE_COUNT {
        if isZoneType(index) {
            const value = typeValue(index)
            if (hasSlash(value) || isUpper(value)) && m.same(value, id) { return index }
        }
        index += 1
    }
    // An alias of the database: the CLDR ID of the same zone, the
    // zone's own name first.
    const found = zones.find(id)
    if found == zones.NONE { return NONE_TYPE }
    const zone = zones.zoneOf(found)
    const ownName = zones.idName(zones.zoneId(zone))
    var candidate = NONE_TYPE
    index = 0
    while index < cldr.TYPE_COUNT {
        if isZoneType(index) {
            const value = typeValue(index)
            if hasSlash(value) || isUpper(value) {
                const other = zones.find(value)
                if other != zones.NONE && zones.zoneOf(other) == zone {
                    if m.same(value, ownName) { return index }
                    if candidate == NONE_TYPE { candidate = index }
                }
            }
        }
        index += 1
    }
    return candidate
}

fn isUpper(value: []const u8) -> bool { return value.length > 0 && value[0] >= 65 && value[0] <= 90 }

pub fn canonicalId(kind: usize) -> []const u8 { return if kind == NONE_TYPE { "" } else { typeValue(kind) } }
pub fn shortId(kind: usize) -> []const u8 { return if kind == NONE_TYPE { "unk" } else { typeKey(kind)[3..] } }

// The region of a canonical ID ("" for the world or none).
fn regionOf(id: []const u8, into: *[4]u8) -> usize {
    const found = zones.find(id)
    if found == zones.NONE { return 0 }
    const region = zones.region(found)
    if region == 0 { return 0 }
    into.*[0] = @intCast(u8, region >> 8)
    into.*[1] = @intCast(u8, region & 255)
    return 2
}

// Whether ID is the zone of its region: the only one, or its primary
// zone.
fn isPrimary(id: []const u8, region: []const u8) -> bool {
    var count: usize = 0
    var index: usize = 0
    const wanted = (@intCast(u16, region[0]) << 8) | @intCast(u16, region[1])
    while index < zones.idCount() {
        if zones.isCanonical(index) && zones.region(index) == wanted { count += 1 }
        index += 1
    }
    if count == 1 { return true }
    var key = m.bytesBuffer()
    m.pushText(&key, "primaryZones/")
    m.pushText(&key, region)
    const primary = resources.get(resources.supplemental(), m.bytesText(&key))
    m.disposeBytes(&key)
    return m.same(primary, id)
}

// ---------------------------------------------------------------------------
// Metazones.

fn parseDate(value: []const u8) -> f64 {
    // "yyyy-MM-dd HH:mm" (UTC)
    if value.length < 16 { return 0.0 }
    const year = number(value, 0, 4)
    const month = number(value, 5, 2)
    const day = number(value, 8, 2)
    const hour = number(value, 11, 2)
    const minute = number(value, 14, 2)
    const y = if month <= 2 { year - 1 } else { year }
    const era = (if y >= 0 { y } else { y - 399 }) / 400
    const yearOfEra = y - era * 400
    const shifted = if month > 2 { month - 3 } else { month + 9 }
    const dayOfYear = (153 * shifted + 2) / 5 + day - 1
    const days = era * 146097 + yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear - 719468
    return @floatFromInt(f64, days * 86400000 + hour * HOUR_MS + minute * MINUTE_MS)
}

fn number(value: []const u8, start: usize, count: usize) -> i64 {
    var result: i64 = 0
    var k: usize = 0
    while k < count {
        result = result * 10 + @intCast(i64, value[start + k] - 48)
        k += 1
    }
    return result
}

// The metazone of canonical ID at DATE, into MZ ("" when none).
pub fn metazone(id: []const u8, date: f64, mz: *m.Bytes) -> void {
    const supplemental = resources.supplemental()
    var n: usize = 0
    while n < 64 {
        var key = m.bytesBuffer()
        m.pushText(&key, "metaZones/metazoneInfo/timezone/")
        m.pushText(&key, id)
        m.pushByte(&key, 47)
        symbols.pushNumber(&key, n)
        m.pushText(&key, "/usesMetazone/")
        const length = key.length
        m.pushText(&key, "_mzone")
        var name: []const u8 = ""
        if !resources.lookup(supplemental, m.bytesText(&key), &name) {
            m.disposeBytes(&key)
            return
        }
        key.length = length
        m.pushText(&key, "_from")
        const from = resources.get(supplemental, m.bytesText(&key))
        key.length = length
        m.pushText(&key, "_to")
        const to = resources.get(supplemental, m.bytesText(&key))
        m.disposeBytes(&key)
        // Without dates: from 1970 on (as ICU takes them).
        const after = date >= (if from.length == 0 { 0.0 } else { parseDate(from) })
        const before = to.length == 0 || date < parseDate(to)
        if after && before {
            m.pushText(mz, name)
            return
        }
        n += 1
    }
}

// The golden zone of metazone MZ for REGION (else the world's).
pub fn referenceZone(mz: []const u8, region: []const u8, into: *m.Bytes) -> void {
    const supplemental = resources.supplemental()
    var world: []const u8 = ""
    var n: usize = 0
    while n < 2000 {
        var key = m.bytesBuffer()
        m.pushText(&key, "metaZones/metazones/")
        symbols.pushNumber(&key, n)
        m.pushText(&key, "/mapZone/")
        const length = key.length
        m.pushText(&key, "_other")
        var other: []const u8 = ""
        const exists = resources.lookup(supplemental, m.bytesText(&key), &other)
        if !exists {
            m.disposeBytes(&key)
            break
        }
        if m.same(other, mz) {
            key.length = length
            m.pushText(&key, "_territory")
            const territory = resources.get(supplemental, m.bytesText(&key))
            key.length = length
            m.pushText(&key, "_type")
            const zone = resources.get(supplemental, m.bytesText(&key))
            if m.same(territory, region) {
                m.pushText(into, zone)
                m.disposeBytes(&key)
                return
            }
            if m.same(territory, "001") { world = zone }
        }
        m.disposeBytes(&key)
        n += 1
    }
    m.pushText(into, world)
}

// ---------------------------------------------------------------------------
// Names.

// The name of zone ID or metazone ("zone"/"metazone"), of LENGTH
// ("long"/"short") and TYPE ("generic", "standard", "daylight").
fn nameOf(f: *Format, which: []const u8, id: []const u8, length: []const u8, kind: []const u8, into: *Text) -> bool {
    if id.length == 0 { return false }
    var key = m.bytesBuffer()
    m.pushText(&key, "dates/timeZoneNames/")
    m.pushText(&key, which)
    m.pushByte(&key, 47)
    m.pushText(&key, id)
    m.pushByte(&key, 47)
    m.pushText(&key, length)
    m.pushByte(&key, 47)
    m.pushText(&key, kind)
    const found = symbols.lookupText(f.*.data, m.bytesText(&key), into)
    m.disposeBytes(&key)
    return found
}

// The exemplar city of canonical ID: the locale's, else the ID's last
// part with spaces for underscores (none for Etc/ and SystemV/ zones).
pub fn exemplarCity(f: *Format, id: []const u8, into: *Text) -> bool {
    if id.length == 0 { return false }
    var key = m.bytesBuffer()
    m.pushText(&key, "dates/timeZoneNames/zone/")
    m.pushText(&key, id)
    m.pushText(&key, "/exemplarCity")
    const found = symbols.lookupText(f.*.data, m.bytesText(&key), into)
    m.disposeBytes(&key)
    if found { return true }
    if (id.length >= 4 && m.same(id[0..4], "Etc/")) || (id.length >= 8 && m.same(id[0..8], "SystemV/")) { return false }
    var k = id.length
    while k > 0 && id[k - 1] != 47 { k -= 1 }
    if k == 0 || k == id.length { return false }
    var index = k
    while index < id.length {
        text.push(into, if id[index] == 95 { 32 } else { @intCast(u16, id[index]) })
        index += 1
    }
    return true
}

// The specific (standard or daylight) name of canonical ID at DATE.
fn specificName(f: *Format, id: []const u8, date: f64, long: bool, daylight: bool, into: *Text) -> bool {
    const length = if long { "long" } else { "short" }
    const kind = if daylight { "daylight" } else { "standard" }
    if nameOf(f, "zone", id, length, kind, into) { return true }
    var mz = m.bytesBuffer()
    metazone(id, date, &mz)
    const found = nameOf(f, "metazone", m.bytesText(&mz), length, kind, into)
    m.disposeBytes(&mz)
    return found
}

fn regionName(f: *Format, region: []const u8, into: *Text) -> void {
    var key = m.bytesBuffer()
    m.pushText(&key, "localeDisplayNames/territories/")
    m.pushText(&key, region)
    if !symbols.lookupText(f.*.data, m.bytesText(&key), into) { text.pushUtf8(into, region) }
    m.disposeBytes(&key)
}

// The generic location name of canonical ID: its country's name when it
// is the country's zone, else its city, in the region format.
pub fn genericLocation(f: *Format, id: []const u8, into: *Text) -> bool {
    var region: [4]u8 = undefined
    const regionLength = regionOf(id, &region)
    if regionLength == 0 { return false }
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &region) }
    const code = view[0..regionLength]
    var location = text.empty()
    if isPrimary(id, code) {
        regionName(f, code, &location)
    } else {
        _ = exemplarCity(f, id, &location)
    }
    text.format1(&f.*.regionFormat, &location, into)
    text.dispose(&location)
    return into.*.length > 0
}

fn partialLocation(f: *Format, id: []const u8, mz: []const u8, mzName: *const Text, into: *Text) -> void {
    var region: [4]u8 = undefined
    const regionLength = regionOf(id, &region)
    var location = text.empty()
    if regionLength > 0 {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &region) }
        const code = view[0..regionLength]
        var golden = m.bytesBuffer()
        referenceZone(mz, code, &golden)
        if m.same(m.bytesText(&golden), id) {
            regionName(f, code, &location)
        } else {
            _ = exemplarCity(f, id, &location)
        }
        m.disposeBytes(&golden)
    } else {
        if !exemplarCity(f, id, &location) { text.pushUtf8(&location, id) }
    }
    text.format2(&f.*.fallbackFormat, &location, mzName, into)
    text.dispose(&location)
}

// A zone at a moment, as the formats take it.
pub const Zone = struct {
    // The ID as the calendar has it, its canonical type.
    id: [64]u8
    idLength: usize
    kind: usize
    // The moment and the offsets then (milliseconds).
    date: f64
    raw: i64
    save: i64
}

pub fn zoneIdOf(z: *const Zone) -> []const u8 {
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &z.*.id) }
    return view[0..z.*.idLength]
}

fn zoneIndex(z: *const Zone) -> usize {
    const found = zones.find(canonicalId(z.*.kind))
    return if found == zones.NONE { zones.NONE } else { zones.zoneOf(found) }
}

// Whether the zone observes daylight time within six months of DATE.
fn daylightNear(z: *const Zone) -> bool {
    const zone = zoneIndex(z)
    if zone == zones.NONE { return false }
    const seconds = @intFromFloat(i64, @floor(z.*.date / 1000.0))
    const before = zones.previousTransition(zone, seconds, true)
    if before.found && z.*.date - @floatFromInt(f64, before.time) * 1000.0 < DST_CHECK_RANGE {
        if zones.offsetsAt(zone, before.time - 1).save != 0 { return true }
    }
    const after = zones.nextTransition(zone, seconds, false)
    if after.found && @floatFromInt(f64, after.time) * 1000.0 - z.*.date < DST_CHECK_RANGE {
        if zones.offsetsAt(zone, after.time).save != 0 { return true }
    }
    return false
}

// The offsets of zone ID at wall time WALL (milliseconds).
fn offsetsAtWall(id: []const u8, wall: f64, raw: *i64, save: *i64) -> bool {
    const found = zones.find(id)
    if found == zones.NONE { return false }
    const zone = zones.zoneOf(found)
    const wallSeconds = @intFromFloat(i64, @floor(wall / 1000.0))
    var guess = zones.offsetsAt(zone, wallSeconds)
    var utc = wallSeconds - guess.raw - guess.save
    var offsets = zones.offsetsAt(zone, utc)
    if offsets.raw + offsets.save != guess.raw + guess.save {
        utc = wallSeconds - offsets.raw - offsets.save
        offsets = zones.offsetsAt(zone, utc)
    }
    raw.* = offsets.raw * 1000
    save.* = offsets.save * 1000
    return true
}

fn genericNonLocation(f: *Format, z: *const Zone, long: bool, into: *Text) -> bool {
    const id = canonicalId(z.*.kind)
    if id.length == 0 { return false }
    const length = if long { "long" } else { "short" }
    if nameOf(f, "zone", id, length, "generic", into) { return true }
    var mz = m.bytesBuffer()
    metazone(id, z.*.date, &mz)
    const mzId = m.bytesText(&mz)
    if mzId.length == 0 {
        m.disposeBytes(&mz)
        return false
    }
    var useStandard = false
    if z.*.save == 0 { useStandard = !daylightNear(z) }
    var done = false
    if useStandard {
        var standard = text.empty()
        if specificName(f, id, z.*.date, long, false, &standard) {
            // A standard name that is the generic one is not used.
            var generic = text.empty()
            _ = nameOf(f, "metazone", mzId, length, "generic", &generic)
            if !sameIgnoringCase(&standard, &generic) {
                text.pushText(into, &standard)
                done = true
            }
            text.dispose(&generic)
        }
        text.dispose(&standard)
    }
    if !done {
        var mzName = text.empty()
        if nameOf(f, "metazone", mzId, length, "generic", &mzName) {
            var golden = m.bytesBuffer()
            const regionView: [*]const u8 = unsafe { @ptrCast([*]const u8, &f.*.region) }
            referenceZone(mzId, regionView[0..f.*.regionLength], &golden)
            const goldenId = m.bytesText(&golden)
            if goldenId.length > 0 && !m.same(goldenId, id) {
                var raw: i64 = 0
                var save: i64 = 0
                if offsetsAtWall(goldenId, z.*.date + @floatFromInt(f64, z.*.raw + z.*.save), &raw, &save) {
                    if raw != z.*.raw || save != z.*.save {
                        partialLocation(f, id, mzId, &mzName, into)
                    } else {
                        text.pushText(into, &mzName)
                    }
                }
            } else {
                text.pushText(into, &mzName)
            }
            m.disposeBytes(&golden)
            done = true
        }
        text.dispose(&mzName)
    }
    m.disposeBytes(&mz)
    return into.*.length > 0
}

fn sameIgnoringCase(a: *const Text, b: *const Text) -> bool {
    if a.*.length != b.*.length { return false }
    var k: usize = 0
    while k < a.*.length {
        var x = text.at(a, k)
        var y = text.at(b, k)
        if x >= 65 && x <= 90 { x += 32 }
        if y >= 65 && y <= 90 { y += 32 }
        if x != y { return false }
        k += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// Offsets.

fn digit(f: *Format, into: *Text, value: i64) -> void { text.pushCodePoint(into, f.*.digits[@intCast(usize, value)]) }

fn offsetDigits(f: *Format, into: *Text, value: i64, minimum: usize) -> void {
    if minimum == 2 && value < 10 { digit(f, into, 0) }
    if value >= 10 { digit(f, into, value / 10) }
    digit(f, into, value % 10)
}

// The localized GMT format of OFFSET (GMT+01:00, GMT+1 short).
pub fn localizedGmt(f: *Format, offset: i64, short: bool, into: *Text) -> bool {
    if offset <= -MAX_OFFSET || offset >= MAX_OFFSET { return false }
    if offset == 0 {
        text.pushText(into, &f.*.gmtZero)
        return true
    }
    const positive = offset > 0
    var rest = if positive { offset } else { -offset }
    const hours = rest / HOUR_MS
    rest = rest % HOUR_MS
    const minutes = rest / MINUTE_MS
    rest = rest % MINUTE_MS
    const seconds = rest / 1000
    var kind: usize = 0
    if seconds != 0 {
        kind = 2
    } else if minutes != 0 || !short {
        kind = 1
    }
    if !positive { kind += 3 }
    text.pushText(into, &f.*.gmtPrefix)
    const pattern = &f.*.offsets[kind]
    var index: usize = 0
    var inQuote = false
    while index < pattern.*.length {
        const c = text.at(pattern, index)
        if c == 39 {
            if index + 1 < pattern.*.length && text.at(pattern, index + 1) == 39 {
                text.push(into, 39)
                index += 2
                continue
            }
            inQuote = !inQuote
            index += 1
            continue
        }
        if !inQuote && (c == 72 || c == 109 || c == 115) {
            var end = index
            while end < pattern.*.length && text.at(pattern, end) == c { end += 1 }
            if c == 72 { offsetDigits(f, into, hours, if short { 1 } else { 2 }) }
            if c == 109 { offsetDigits(f, into, minutes, 2) }
            if c == 115 { offsetDigits(f, into, seconds, 2) }
            index = end
            continue
        }
        text.push(into, c)
        index += 1
    }
    text.pushText(into, &f.*.gmtSuffix)
    return true
}

fn pushTwo(into: *Text, value: i64) -> void {
    text.push(into, @intCast(u16, 48 + value / 10))
    text.push(into, @intCast(u16, 48 + value % 10))
}

// ISO 8601: basic (+0100) or extended (+01:00), Z for zero when
// UTCINDICATOR, the minutes optional when SHORT, no seconds when
// IGNORESECONDS.
pub fn iso8601(offset: i64, basic: bool, utcIndicator: bool, short: bool, ignoreSeconds: bool, into: *Text) -> bool {
    const absolute = if offset < 0 { -offset } else { offset }
    if utcIndicator && (absolute < 1000 || (ignoreSeconds && absolute < MINUTE_MS)) {
        text.push(into, 90)
        return true
    }
    if absolute >= MAX_OFFSET { return false }
    var fields: [3]i64 = undefined
    fields[0] = absolute / HOUR_MS
    fields[1] = absolute % HOUR_MS / MINUTE_MS
    fields[2] = absolute % MINUTE_MS / 1000
    const minFields: usize = if short { 0 } else { 1 }
    const maxFields: usize = if ignoreSeconds { 1 } else { 2 }
    var last = maxFields
    while last > minFields {
        if fields[last] != 0 { break }
        last -= 1
    }
    var negative = false
    if offset < 0 {
        var k: usize = 0
        while k <= last {
            if fields[k] != 0 { negative = true }
            k += 1
        }
    }
    text.push(into, if negative { 45 } else { 43 })
    var k: usize = 0
    while k <= last {
        if !basic && k != 0 { text.push(into, 58) }
        pushTwo(into, fields[k])
        k += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// The formats of the styles (TimeZoneFormat::format).

// Into INTO the zone in STYLE; the usage of capitalization it has (a
// datesymbols CAP_ value) into USAGE.
pub fn format(f: *Format, style: i32, z: *const Zone, into: *Text) -> void {
    const id = canonicalId(z.*.kind)
    var noFallback = false
    if style == GENERIC_LOCATION {
        if id.length > 0 { _ = genericLocation(f, id, into) }
    } else if style == GENERIC_LONG || style == GENERIC_SHORT {
        if !genericNonLocation(f, z, style == GENERIC_LONG, into) {
            text.clear(into)
            if id.length > 0 { _ = genericLocation(f, id, into) }
        }
    } else if style == SPECIFIC_LONG || style == SPECIFIC_SHORT {
        if id.length > 0 { _ = specificName(f, id, z.*.date, style == SPECIFIC_LONG, z.*.save != 0, into) }
    } else if style == ZONE_ID {
        text.pushUtf8(into, zoneIdOf(z))
        noFallback = true
    } else if style == ZONE_ID_SHORT {
        text.pushUtf8(into, shortId(z.*.kind))
        noFallback = true
    } else if style == EXEMPLAR_LOCATION {
        if id.length == 0 || !exemplarCity(f, id, into) {
            if !exemplarCity(f, "Etc/Unknown", into) { text.pushUtf8(into, "Unknown") }
        }
        noFallback = true
    }
    if into.*.length > 0 || noFallback { return }
    const offset = z.*.raw + z.*.save
    if style == GENERIC_LOCATION || style == GENERIC_LONG || style == SPECIFIC_LONG || style == LOCALIZED_GMT {
        _ = localizedGmt(f, offset, false, into)
    } else if style == GENERIC_SHORT || style == SPECIFIC_SHORT || style == LOCALIZED_GMT_SHORT {
        _ = localizedGmt(f, offset, true, into)
    } else if style == ISO_BASIC_SHORT {
        _ = iso8601(offset, true, true, true, true, into)
    } else if style == ISO_BASIC_LOCAL_SHORT {
        _ = iso8601(offset, true, false, true, true, into)
    } else if style == ISO_BASIC_FIXED {
        _ = iso8601(offset, true, true, false, true, into)
    } else if style == ISO_BASIC_LOCAL_FIXED {
        _ = iso8601(offset, true, false, false, true, into)
    } else if style == ISO_EXTENDED_FIXED {
        _ = iso8601(offset, false, true, false, true, into)
    } else if style == ISO_EXTENDED_LOCAL_FIXED {
        _ = iso8601(offset, false, false, false, true, into)
    } else if style == ISO_BASIC_FULL {
        _ = iso8601(offset, true, true, false, false, into)
    } else if style == ISO_BASIC_LOCAL_FULL {
        _ = iso8601(offset, true, false, false, false, into)
    } else if style == ISO_EXTENDED_FULL {
        _ = iso8601(offset, false, true, false, false, into)
    } else if style == ISO_EXTENDED_LOCAL_FULL {
        _ = iso8601(offset, false, false, false, false, into)
    }
}
