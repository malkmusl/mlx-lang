// ICU's number skeletons (unumberformatter.h's UNumberFormatter is made
// of one): the stems and their options as ICU 74's number_skeletons.cpp
// reads them, into the settings of a formatter (ICU's MacroProps):
// notation (simple, scientific and engineering with their exponent
// options, compact-short and -long), the unit (percent, permille,
// currency/XXX, measure-unit/TYPE-SUBTYPE, per-measure-unit, unit/ID,
// usage), precision (fraction and significant digits, increments,
// integer, unlimited, currency, the -r/-s rounding priority, /w), the
// rounding mode, integer width, grouping, the numbering system, the unit
// width, sign display, decimal display and scale, and the concise forms
// (K, KK, %, %x100, ,_, +!, ()...). A stem seen twice, an unknown stem or
// option, an option a stem does not take or a stem that needs one
// without it is U_NUMBER_SKELETON_SYNTAX_ERROR at the offset of its
// segment, as ICU reports it; values out of bounds (more than 999
// digits) are U_NUMBER_ARG_OUTOFBOUNDS_ERROR when formatting.
//
// Measure units are checked against ICU's list of built-in units
// (TYPE-SUBTYPE) and unit identifiers against UTS #35's syntax over the
// simple units of that list; formatting them needs CLDR's unit data,
// which the library does not have yet.
const m = @import("./memory.mlx")
const decimal = @import("./decimal.mlx")
const numbersystems = @import("./numbersystems.mlx")
const nd = @import("./numberdata.mlx")

pub const SKELETON_SYNTAX_ERROR: i32 = 65811
pub const ARG_OUTOFBOUNDS_ERROR: i32 = 65810

// Notations.
pub const NOTATION_SIMPLE: i32 = 0
pub const NOTATION_SCIENTIFIC: i32 = 1
pub const NOTATION_COMPACT_SHORT: i32 = 3
pub const NOTATION_COMPACT_LONG: i32 = 4

// Units.
pub const UNIT_NONE: i32 = 0
pub const UNIT_PERCENT: i32 = 1
pub const UNIT_PERMILLE: i32 = 2
pub const UNIT_CURRENCY: i32 = 3
pub const UNIT_MEASURE: i32 = 4

// Precisions (ICU's Precision types).
pub const PRECISION_BOGUS: i32 = 0
pub const PRECISION_NONE: i32 = 1
pub const PRECISION_FRACTION: i32 = 2
pub const PRECISION_SIGNIFICANT: i32 = 3
pub const PRECISION_FRACTION_SIGNIFICANT: i32 = 4
pub const PRECISION_INCREMENT: i32 = 5
pub const PRECISION_INCREMENT_ONE: i32 = 6
pub const PRECISION_INCREMENT_FIVE: i32 = 7
pub const PRECISION_CURRENCY: i32 = 8

pub const PRIORITY_RELAXED: i32 = 0
pub const PRIORITY_STRICT: i32 = 1

// UNumberGroupingStrategy, and the grouping DecimalFormat's properties
// give (sizes of their own).
pub const GROUPING_OFF: i32 = 0
pub const GROUPING_MIN2: i32 = 1
pub const GROUPING_AUTO: i32 = 2
pub const GROUPING_ON_ALIGNED: i32 = 3
pub const GROUPING_THOUSANDS: i32 = 4
pub const GROUPING_PROPERTIES: i32 = 5

// UNumberUnitWidth.
pub const WIDTH_NARROW: i32 = 0
pub const WIDTH_SHORT: i32 = 1
pub const WIDTH_FULL_NAME: i32 = 2
pub const WIDTH_ISO_CODE: i32 = 3
pub const WIDTH_FORMAL: i32 = 4
pub const WIDTH_VARIANT: i32 = 5
pub const WIDTH_HIDDEN: i32 = 6

// UNumberSignDisplay.
pub const SIGN_AUTO: i32 = 0
pub const SIGN_ALWAYS: i32 = 1
pub const SIGN_NEVER: i32 = 2
pub const SIGN_ACCOUNTING: i32 = 3
pub const SIGN_ACCOUNTING_ALWAYS: i32 = 4
pub const SIGN_EXCEPT_ZERO: i32 = 5
pub const SIGN_ACCOUNTING_EXCEPT_ZERO: i32 = 6
pub const SIGN_NEGATIVE: i32 = 7
pub const SIGN_ACCOUNTING_NEGATIVE: i32 = 8

pub const UNSET: i32 = -1

// The settings of a formatter (ICU's MacroProps); UNSET where the
// skeleton says nothing.
pub const Settings = struct {
    notation: i32
    // Scientific: the engineering interval (1, 3), the minimum exponent
    // digits, the exponent's sign display; whether the pattern asks for
    // its minimum integer digits ("000.00E0").
    engineering: i32
    minExponentDigits: i32
    exponentSign: i32
    requireMinInt: bool
    unit: i32
    currency: [4]u8
    // A measure unit: its identifier as given (TYPE-SUBTYPE or a core
    // unit identifier) and a per-unit.
    unitId: [96]u8
    unitIdLength: usize
    perUnitId: [96]u8
    perUnitIdLength: usize
    hasUsage: bool
    precision: i32
    minFrac: i32
    maxFrac: i32
    minSig: i32
    maxSig: i32
    priority: i32
    retain: bool
    increment: u64
    incrementMagnitude: i32
    incrementMinFrac: i32
    currencyUsage: i32
    trailingZeroHide: bool
    roundingMode: i32
    grouping: i32
    grouping1: i32
    grouping2: i32
    minGrouping: i32
    hasIntegerWidth: bool
    minInt: i32
    maxInt: i32
    numberingSystem: [16]u8
    numberingSystemLength: usize
    unitWidth: i32
    sign: i32
    decimal: i32
    // Scale: a power of ten, times an arbitrary decimal when there is
    // one (its digits as text, "" when none).
    scaleMagnitude: i32
    scaleText: [48]u8
    scaleTextLength: usize
    approximately: bool
    // An error found in a value (U_NUMBER_ARG_OUTOFBOUNDS_ERROR), given
    // when formatting.
    fault: i32
}

pub fn initialize(s: *Settings) -> void {
    s.*.notation = NOTATION_SIMPLE
    s.*.engineering = 1
    s.*.minExponentDigits = 1
    s.*.exponentSign = SIGN_AUTO
    s.*.requireMinInt = false
    s.*.unit = UNIT_NONE
    s.*.currency = [4]u8{ 0, 0, 0, 0 }
    s.*.unitIdLength = 0
    s.*.perUnitIdLength = 0
    s.*.hasUsage = false
    s.*.precision = PRECISION_BOGUS
    s.*.minFrac = -1
    s.*.maxFrac = -1
    s.*.minSig = -1
    s.*.maxSig = -1
    s.*.priority = PRIORITY_RELAXED
    s.*.retain = false
    s.*.increment = 0
    s.*.incrementMagnitude = 0
    s.*.incrementMinFrac = 0
    s.*.currencyUsage = 0
    s.*.trailingZeroHide = false
    s.*.roundingMode = decimal.HALF_EVEN
    s.*.grouping = UNSET
    s.*.grouping1 = -1
    s.*.grouping2 = -1
    s.*.minGrouping = -2
    s.*.hasIntegerWidth = false
    s.*.minInt = 1
    s.*.maxInt = -1
    s.*.numberingSystemLength = 0
    s.*.unitWidth = UNSET
    s.*.sign = UNSET
    s.*.decimal = UNSET
    s.*.scaleMagnitude = 0
    s.*.scaleTextLength = 0
    s.*.approximately = false
    s.*.fault = 0
}

// ---------------------------------------------------------------------------
// Precision constructors, with ICU's bounds (999 digits).

const MAX_DIGITS: i32 = 999

fn setFraction(s: *Settings, minFrac: i32, maxFrac: i32) -> void {
    if minFrac >= 0 && maxFrac <= MAX_DIGITS && (maxFrac == -1 || minFrac <= maxFrac) {
        s.*.precision = PRECISION_FRACTION
        s.*.minFrac = minFrac
        s.*.maxFrac = maxFrac
        s.*.minSig = -1
        s.*.maxSig = -1
    } else {
        s.*.fault = ARG_OUTOFBOUNDS_ERROR
    }
}

fn setSignificant(s: *Settings, minSig: i32, maxSig: i32) -> void {
    if minSig >= 1 && maxSig <= MAX_DIGITS && (maxSig == -1 || minSig <= maxSig) {
        s.*.precision = PRECISION_SIGNIFICANT
        s.*.minFrac = -1
        s.*.maxFrac = -1
        s.*.minSig = minSig
        s.*.maxSig = maxSig
    } else {
        s.*.fault = ARG_OUTOFBOUNDS_ERROR
    }
}

// The precision of an increment of MANTISSA x 10^MAGNITUDE.
pub fn setIncrement(s: *Settings, mantissa: u64, magnitude: i32) -> void {
    if mantissa == 0 {
        s.*.fault = ARG_OUTOFBOUNDS_ERROR
        return
    }
    s.*.increment = mantissa
    s.*.incrementMagnitude = magnitude
    s.*.incrementMinFrac = if magnitude > 0 { 0 } else { -magnitude }
    s.*.precision = if mantissa == 1 { PRECISION_INCREMENT_ONE } else if mantissa == 5 { PRECISION_INCREMENT_FIVE } else { PRECISION_INCREMENT }
}

// ---------------------------------------------------------------------------
// The stems.

const STATE_NULL: i32 = 0
const STATE_SCIENTIFIC: i32 = 1
const STATE_FRACTION_PRECISION: i32 = 2
const STATE_PRECISION: i32 = 3
const STATE_INCREMENT_PRECISION: i32 = 4
const STATE_MEASURE_UNIT: i32 = 5
const STATE_PER_MEASURE_UNIT: i32 = 6
const STATE_IDENTIFIER_UNIT: i32 = 7
const STATE_UNIT_USAGE: i32 = 8
const STATE_CURRENCY_UNIT: i32 = 9
const STATE_INTEGER_WIDTH: i32 = 10
const STATE_NUMBERING_SYSTEM: i32 = 11
const STATE_SCALE: i32 = 12

// What the skeleton has set (a stem of each kind once).
const SEEN_NOTATION: u32 = 1
const SEEN_UNIT: u32 = 2
const SEEN_PER_UNIT: u32 = 4
const SEEN_PRECISION: u32 = 8
const SEEN_ROUNDING: u32 = 16
const SEEN_GROUPER: u32 = 32
const SEEN_INTEGER_WIDTH: u32 = 64
const SEEN_SYMBOLS: u32 = 128
const SEEN_UNIT_WIDTH: u32 = 256
const SEEN_SIGN: u32 = 512
const SEEN_DECIMAL: u32 = 1024
const SEEN_SCALE: u32 = 2048
const SEEN_USAGE: u32 = 4096

const Parser = struct {
    settings: *Settings
    seen: u32
    failed: bool
}

fn mark(p: *Parser, what: u32) -> bool {
    if (p.*.seen & what) != 0 {
        p.*.failed = true
        return false
    }
    p.*.seen |= what
    return true
}

fn isWildcard(c: u8) -> bool { return c == 42 || c == 43 }

// The sign display a stem names, UNSET for none.
fn signOf(token: []const u8) -> i32 {
    if m.same(token, "sign-auto") { return SIGN_AUTO }
    if m.same(token, "sign-always") || m.same(token, "+!") { return SIGN_ALWAYS }
    if m.same(token, "sign-never") || m.same(token, "+_") { return SIGN_NEVER }
    if m.same(token, "sign-accounting") || m.same(token, "()") { return SIGN_ACCOUNTING }
    if m.same(token, "sign-accounting-always") || m.same(token, "()!") { return SIGN_ACCOUNTING_ALWAYS }
    if m.same(token, "sign-except-zero") || m.same(token, "+?") { return SIGN_EXCEPT_ZERO }
    if m.same(token, "sign-accounting-except-zero") || m.same(token, "()?") { return SIGN_ACCOUNTING_EXCEPT_ZERO }
    if m.same(token, "sign-negative") || m.same(token, "+-") { return SIGN_NEGATIVE }
    if m.same(token, "sign-accounting-negative") || m.same(token, "()-") { return SIGN_ACCOUNTING_NEGATIVE }
    return UNSET
}

fn roundingOf(token: []const u8) -> i32 {
    if !nd.startsWith(token, "rounding-mode-") { return UNSET }
    const rest = token[14..token.length]
    if m.same(rest, "ceiling") { return decimal.CEILING }
    if m.same(rest, "floor") { return decimal.FLOOR }
    if m.same(rest, "down") { return decimal.DOWN }
    if m.same(rest, "up") { return decimal.UP }
    if m.same(rest, "half-even") { return decimal.HALF_EVEN }
    if m.same(rest, "half-odd") { return decimal.HALF_ODD }
    if m.same(rest, "half-ceiling") { return decimal.HALF_CEILING }
    if m.same(rest, "half-floor") { return decimal.HALF_FLOOR }
    if m.same(rest, "half-down") { return decimal.HALF_DOWN }
    if m.same(rest, "half-up") { return decimal.HALF_UP }
    if m.same(rest, "unnecessary") { return decimal.UNNECESSARY }
    return UNSET
}

fn groupingOf(token: []const u8) -> i32 {
    if m.same(token, "group-off") || m.same(token, ",_") { return GROUPING_OFF }
    if m.same(token, "group-min2") || m.same(token, ",?") { return GROUPING_MIN2 }
    if m.same(token, "group-auto") { return GROUPING_AUTO }
    if m.same(token, "group-on-aligned") || m.same(token, ",!") { return GROUPING_ON_ALIGNED }
    if m.same(token, "group-thousands") { return GROUPING_THOUSANDS }
    return UNSET
}

fn widthOf(token: []const u8) -> i32 {
    if !nd.startsWith(token, "unit-width-") { return UNSET }
    const rest = token[11..token.length]
    if m.same(rest, "narrow") { return WIDTH_NARROW }
    if m.same(rest, "short") { return WIDTH_SHORT }
    if m.same(rest, "full-name") { return WIDTH_FULL_NAME }
    if m.same(rest, "iso-code") { return WIDTH_ISO_CODE }
    if m.same(rest, "formal") { return WIDTH_FORMAL }
    if m.same(rest, "variant") { return WIDTH_VARIANT }
    if m.same(rest, "hidden") { return WIDTH_HIDDEN }
    return UNSET
}

fn parseFractionStem(p: *Parser, token: []const u8) -> void {
    var offset: usize = 1
    var minFrac: i32 = 0
    var maxFrac: i32 = 0
    while offset < token.length && token[offset] == 48 {
        minFrac += 1
        offset += 1
    }
    if offset < token.length {
        if isWildcard(token[offset]) {
            maxFrac = -1
            offset += 1
        } else {
            maxFrac = minFrac
            while offset < token.length && token[offset] == 35 {
                maxFrac += 1
                offset += 1
            }
        }
    } else {
        maxFrac = minFrac
    }
    if offset < token.length {
        p.*.failed = true
        return
    }
    if maxFrac == -1 {
        if minFrac == 0 {
            p.*.settings.*.precision = PRECISION_NONE
        } else {
            setFraction(p.*.settings, minFrac, -1)
        }
    } else {
        setFraction(p.*.settings, minFrac, maxFrac)
    }
}

fn parseDigitsStem(p: *Parser, token: []const u8) -> void {
    var offset: usize = 0
    var minSig: i32 = 0
    var maxSig: i32 = 0
    while offset < token.length && token[offset] == 64 {
        minSig += 1
        offset += 1
    }
    if offset < token.length {
        if isWildcard(token[offset]) {
            maxSig = -1
            offset += 1
        } else {
            maxSig = minSig
            while offset < token.length && token[offset] == 35 {
                maxSig += 1
                offset += 1
            }
        }
    } else {
        maxSig = minSig
    }
    if offset < token.length {
        p.*.failed = true
        return
    }
    setSignificant(p.*.settings, minSig, maxSig)
}

fn parseScientificStem(p: *Parser, token: []const u8) -> void {
    var offset: usize = 1
    if token.length == offset {
        p.*.failed = true
        return
    }
    var engineering = false
    if token[offset] == 69 {
        engineering = true
        offset += 1
        if token.length == offset {
            p.*.failed = true
            return
        }
    }
    var sign = SIGN_AUTO
    if token[offset] == 43 {
        offset += 1
        if token.length == offset {
            p.*.failed = true
            return
        }
        if token[offset] == 33 {
            sign = SIGN_ALWAYS
        } else if token[offset] == 63 {
            sign = SIGN_EXCEPT_ZERO
        } else {
            p.*.failed = true
            return
        }
        offset += 1
        if token.length == offset {
            p.*.failed = true
            return
        }
    }
    var minDigits: i32 = 0
    while offset < token.length {
        if token[offset] != 48 {
            p.*.failed = true
            return
        }
        minDigits += 1
        offset += 1
    }
    const s = p.*.settings
    s.*.notation = NOTATION_SCIENTIFIC
    s.*.engineering = if engineering { 3 } else { 1 }
    s.*.requireMinInt = false
    s.*.exponentSign = sign
    if minDigits >= 1 && minDigits <= MAX_DIGITS {
        s.*.minExponentDigits = minDigits
    } else {
        s.*.fault = ARG_OUTOFBOUNDS_ERROR
    }
}

fn parseIntegerStem(p: *Parser, token: []const u8) -> void {
    var offset: usize = 1
    while offset < token.length {
        if token[offset] != 48 {
            offset -= 1
            break
        }
        offset += 1
    }
    if offset < token.length {
        p.*.failed = true
        return
    }
    zeroFill(p.*.settings, @intCast(i32, offset), -1)
}

fn zeroFill(s: *Settings, minInt: i32, maxInt: i32) -> void {
    if minInt < 0 || minInt > MAX_DIGITS || (maxInt != -1 && (maxInt < minInt || maxInt > MAX_DIGITS)) {
        s.*.fault = ARG_OUTOFBOUNDS_ERROR
        return
    }
    s.*.hasIntegerWidth = true
    s.*.minInt = minInt
    s.*.maxInt = maxInt
}

// A stem: the next state, or STATE_NULL (P failed when it is not one).
fn parseStem(p: *Parser, token: []const u8) -> i32 {
    const s = p.*.settings
    const first = token[0]
    if first == 46 {
        if !mark(p, SEEN_PRECISION) { return STATE_NULL }
        parseFractionStem(p, token)
        return STATE_FRACTION_PRECISION
    }
    if first == 64 {
        if !mark(p, SEEN_PRECISION) { return STATE_NULL }
        parseDigitsStem(p, token)
        return STATE_PRECISION
    }
    if first == 69 {
        if !mark(p, SEEN_NOTATION) { return STATE_NULL }
        parseScientificStem(p, token)
        return STATE_NULL
    }
    if first == 48 {
        if !mark(p, SEEN_INTEGER_WIDTH) { return STATE_NULL }
        parseIntegerStem(p, token)
        return STATE_NULL
    }
    if m.same(token, "compact-short") || m.same(token, "K") || m.same(token, "compact-long") || m.same(token, "KK") {
        if !mark(p, SEEN_NOTATION) { return STATE_NULL }
        s.*.notation = if m.same(token, "compact-short") || m.same(token, "K") { NOTATION_COMPACT_SHORT } else { NOTATION_COMPACT_LONG }
        return STATE_NULL
    }
    if m.same(token, "scientific") || m.same(token, "engineering") {
        if !mark(p, SEEN_NOTATION) { return STATE_NULL }
        s.*.notation = NOTATION_SCIENTIFIC
        s.*.engineering = if m.same(token, "engineering") { 3 } else { 1 }
        s.*.minExponentDigits = 1
        s.*.exponentSign = SIGN_AUTO
        return STATE_SCIENTIFIC
    }
    if m.same(token, "notation-simple") {
        if !mark(p, SEEN_NOTATION) { return STATE_NULL }
        s.*.notation = NOTATION_SIMPLE
        return STATE_NULL
    }
    if m.same(token, "base-unit") || m.same(token, "percent") || m.same(token, "%") || m.same(token, "permille") {
        if !mark(p, SEEN_UNIT) { return STATE_NULL }
        s.*.unit = if m.same(token, "base-unit") { UNIT_NONE } else if m.same(token, "permille") { UNIT_PERMILLE } else { UNIT_PERCENT }
        return STATE_NULL
    }
    if m.same(token, "%x100") {
        if !mark(p, SEEN_SCALE) { return STATE_NULL }
        if !mark(p, SEEN_UNIT) { return STATE_NULL }
        s.*.scaleMagnitude = 2
        s.*.scaleTextLength = 0
        s.*.unit = UNIT_PERCENT
        return STATE_NULL
    }
    if m.same(token, "precision-integer") {
        if !mark(p, SEEN_PRECISION) { return STATE_NULL }
        setFraction(s, 0, 0)
        return STATE_FRACTION_PRECISION
    }
    if m.same(token, "precision-unlimited") {
        if !mark(p, SEEN_PRECISION) { return STATE_NULL }
        s.*.precision = PRECISION_NONE
        return STATE_PRECISION
    }
    if m.same(token, "precision-currency-standard") || m.same(token, "precision-currency-cash") {
        if !mark(p, SEEN_PRECISION) { return STATE_NULL }
        s.*.precision = PRECISION_CURRENCY
        s.*.currencyUsage = if m.same(token, "precision-currency-cash") { 1 } else { 0 }
        return STATE_PRECISION
    }
    const rounding = roundingOf(token)
    if rounding != UNSET {
        if !mark(p, SEEN_ROUNDING) { return STATE_NULL }
        s.*.roundingMode = rounding
        return STATE_NULL
    }
    if m.same(token, "integer-width-trunc") {
        if !mark(p, SEEN_INTEGER_WIDTH) { return STATE_NULL }
        zeroFill(s, 0, 0)
        return STATE_NULL
    }
    const grouping = groupingOf(token)
    if grouping != UNSET {
        if !mark(p, SEEN_GROUPER) { return STATE_NULL }
        s.*.grouping = grouping
        return STATE_NULL
    }
    if m.same(token, "latin") {
        if !mark(p, SEEN_SYMBOLS) { return STATE_NULL }
        setNumberingSystem(s, "latn")
        return STATE_NULL
    }
    const width = widthOf(token)
    if width != UNSET {
        if !mark(p, SEEN_UNIT_WIDTH) { return STATE_NULL }
        s.*.unitWidth = width
        return STATE_NULL
    }
    const sign = signOf(token)
    if sign != UNSET {
        if !mark(p, SEEN_SIGN) { return STATE_NULL }
        s.*.sign = sign
        return STATE_NULL
    }
    if m.same(token, "decimal-auto") || m.same(token, "decimal-always") {
        if !mark(p, SEEN_DECIMAL) { return STATE_NULL }
        s.*.decimal = if m.same(token, "decimal-always") { 1 } else { 0 }
        return STATE_NULL
    }
    if m.same(token, "precision-increment") {
        if !mark(p, SEEN_PRECISION) { return STATE_NULL }
        return STATE_INCREMENT_PRECISION
    }
    if m.same(token, "measure-unit") {
        if !mark(p, SEEN_UNIT) { return STATE_NULL }
        return STATE_MEASURE_UNIT
    }
    if m.same(token, "per-measure-unit") {
        if !mark(p, SEEN_PER_UNIT) { return STATE_NULL }
        return STATE_PER_MEASURE_UNIT
    }
    if m.same(token, "unit") {
        if !mark(p, SEEN_UNIT) { return STATE_NULL }
        if !mark(p, SEEN_PER_UNIT) { return STATE_NULL }
        return STATE_IDENTIFIER_UNIT
    }
    if m.same(token, "usage") {
        if !mark(p, SEEN_USAGE) { return STATE_NULL }
        return STATE_UNIT_USAGE
    }
    if m.same(token, "currency") {
        if !mark(p, SEEN_UNIT) { return STATE_NULL }
        if !mark(p, SEEN_PER_UNIT) { return STATE_NULL }
        return STATE_CURRENCY_UNIT
    }
    if m.same(token, "integer-width") {
        if !mark(p, SEEN_INTEGER_WIDTH) { return STATE_NULL }
        return STATE_INTEGER_WIDTH
    }
    if m.same(token, "numbering-system") {
        if !mark(p, SEEN_SYMBOLS) { return STATE_NULL }
        return STATE_NUMBERING_SYSTEM
    }
    if m.same(token, "scale") {
        if !mark(p, SEEN_SCALE) { return STATE_NULL }
        return STATE_SCALE
    }
    p.*.failed = true
    return STATE_NULL
}

pub fn setNumberingSystem(s: *Settings, name: []const u8) -> void {
    var index: usize = 0
    while index < name.length && index < 15 {
        s.*.numberingSystem[index] = name[index]
        index += 1
    }
    s.*.numberingSystemLength = index
}

// ---------------------------------------------------------------------------
// Options.

fn parseIntegerWidthOption(p: *Parser, token: []const u8) -> void {
    var offset: usize = 0
    var minInt: i32 = 0
    var maxInt: i32 = 0
    if isWildcard(token[0]) {
        maxInt = -1
        offset += 1
    }
    while offset < token.length && maxInt != -1 && token[offset] == 35 {
        maxInt += 1
        offset += 1
    }
    while offset < token.length && token[offset] == 48 {
        minInt += 1
        offset += 1
    }
    if maxInt != -1 { maxInt += minInt }
    if offset < token.length {
        p.*.failed = true
        return
    }
    zeroFill(p.*.settings, minInt, maxInt)
}

fn parseExponentWidthOption(p: *Parser, token: []const u8) -> bool {
    if !isWildcard(token[0]) { return false }
    var offset: usize = 1
    var minExp: i32 = 0
    while offset < token.length && token[offset] == 101 {
        minExp += 1
        offset += 1
    }
    if offset < token.length { return false }
    if minExp >= 1 && minExp <= MAX_DIGITS {
        p.*.settings.*.minExponentDigits = minExp
    } else {
        p.*.settings.*.fault = ARG_OUTOFBOUNDS_ERROR
    }
    return true
}

fn parseFracSigOption(p: *Parser, token: []const u8) -> bool {
    if token[0] != 64 { return false }
    var offset: usize = 0
    var minSig: i32 = 0
    var maxSig: i32 = 0
    while offset < token.length && token[offset] == 64 {
        minSig += 1
        offset += 1
    }
    if offset < token.length {
        if isWildcard(token[offset]) {
            maxSig = -1
            offset += 1
        } else {
            maxSig = minSig
            while offset < token.length && token[offset] == 35 {
                maxSig += 1
                offset += 1
            }
        }
    } else {
        maxSig = minSig
    }
    const s = p.*.settings
    if s.*.precision != PRECISION_FRACTION {
        // A fraction precision in error stays so.
        if offset < token.length && (token[offset] != 114 && token[offset] != 115) {
            p.*.failed = true
            return false
        }
        return true
    }
    if offset < token.length {
        if maxSig == -1 {
            p.*.failed = true
            return false
        }
        var priority = PRIORITY_RELAXED
        if token[offset] == 114 {
            priority = PRIORITY_RELAXED
        } else if token[offset] == 115 {
            priority = PRIORITY_STRICT
        } else {
            p.*.failed = true
            return false
        }
        offset += 1
        if offset < token.length {
            p.*.failed = true
            return false
        }
        if minSig >= 1 && maxSig >= minSig && maxSig <= MAX_DIGITS {
            fractionSignificant(s, minSig, maxSig, priority, false)
        } else {
            s.*.fault = ARG_OUTOFBOUNDS_ERROR
        }
    } else if maxSig == -1 {
        if minSig >= 1 && minSig <= MAX_DIGITS {
            fractionSignificant(s, 1, minSig, PRIORITY_RELAXED, true)
        } else {
            s.*.fault = ARG_OUTOFBOUNDS_ERROR
        }
    } else if minSig == 1 {
        if maxSig >= 1 && maxSig <= MAX_DIGITS {
            fractionSignificant(s, 1, maxSig, PRIORITY_STRICT, true)
        } else {
            s.*.fault = ARG_OUTOFBOUNDS_ERROR
        }
    } else {
        p.*.failed = true
        return false
    }
    return true
}

pub fn fractionSignificant(s: *Settings, minSig: i32, maxSig: i32, priority: i32, retain: bool) -> void {
    s.*.precision = PRECISION_FRACTION_SIGNIFICANT
    s.*.minSig = minSig
    s.*.maxSig = maxSig
    s.*.priority = priority
    s.*.retain = retain
}

// A decimal option's value: digits and the place of the point.
fn parseDecimalText(token: []const u8, d: *decimal.Decimal) -> bool {
    return decimal.fromText(token, d)
}

fn parseIncrementOption(p: *Parser, token: []const u8) -> void {
    const d = scratchDecimal()
    if !parseDecimalText(token, d) || d.*.nan || d.*.infinite {
        p.*.failed = true
        return
    }
    // The mantissa is the digits without the trailing zeros, unless a
    // point is written: then all digits after it count.
    var magnitude = decimal.lowestPlace(d)
    var mantissa: u64 = 0
    var index: usize = 0
    while index < d.*.count {
        if mantissa < 1000000000000000000 { mantissa = mantissa * 10 + @intCast(u64, d.*.digits[index]) }
        index += 1
    }
    var dot: usize = 0
    var hasDot = false
    while dot < token.length {
        if token[dot] == 46 {
            hasDot = true
            break
        }
        dot += 1
    }
    if hasDot {
        const written = -@intCast(i32, token.length - dot - 1)
        if d.*.count > 0 {
            while magnitude > written {
                mantissa *= 10
                magnitude -= 1
            }
        } else {
            magnitude = written
        }
    }
    setIncrement(p.*.settings, mantissa, magnitude)
}

// A Decimal in C memory for the parser's own use (one per thread at a
// time would do; a fresh one is cheap enough at open time).
var scratch: usize = 0

fn scratchDecimal() -> *decimal.Decimal {
    if scratch == 0 { scratch = m.alloc(@sizeOf(decimal.Decimal)) }
    unsafe { return @ptrFromInt(*decimal.Decimal, scratch) }
}

fn parseScaleOption(p: *Parser, token: []const u8) -> void {
    const d = scratchDecimal()
    if !parseDecimalText(token, d) || d.*.nan || d.*.infinite {
        p.*.failed = true
        return
    }
    const s = p.*.settings
    // 10^k alone is a magnitude; anything else is kept as text.
    if d.*.count == 1 && d.*.digits[0] == 1 && !d.*.negative {
        s.*.scaleMagnitude = d.*.point - 1
        s.*.scaleTextLength = 0
        return
    }
    if d.*.count == 0 {
        s.*.scaleMagnitude = 0
        s.*.scaleText[0] = 48
        s.*.scaleTextLength = 1
        return
    }
    s.*.scaleMagnitude = 0
    var length: usize = 0
    for byte in token {
        if length < 47 {
            s.*.scaleText[length] = byte
            length += 1
        }
    }
    s.*.scaleTextLength = length
}

fn parseCurrencyOption(p: *Parser, token: []const u8) -> void {
    if token.length != 3 {
        p.*.failed = true
        return
    }
    const s = p.*.settings
    var index: usize = 0
    while index < 3 {
        const c = token[index]
        if c >= 128 || c == 0 {
            p.*.failed = true
            return
        }
        s.*.currency[index] = nd.upper(c)
        index += 1
    }
    s.*.currency[3] = 0
    s.*.unit = UNIT_CURRENCY
}

// ICU's built-in units (MeasureUnit's TYPE-SUBTYPE list).
const BUILT_IN_UNITS: []const u8 = "acceleration-g-force acceleration-meter-per-square-second angle-arc-minute angle-arc-second angle-degree angle-radian angle-revolution area-acre area-dunam area-hectare area-square-centimeter area-square-foot area-square-inch area-square-kilometer area-square-meter area-square-mile area-square-yard concentr-item concentr-karat concentr-milligram-ofglucose-per-deciliter concentr-milligram-per-deciliter concentr-millimole-per-liter concentr-mole concentr-percent concentr-permille concentr-permillion concentr-permyriad consumption-liter-per-100-kilometer consumption-liter-per-kilometer consumption-mile-per-gallon consumption-mile-per-gallon-imperial digital-bit digital-byte digital-gigabit digital-gigabyte digital-kilobit digital-kilobyte digital-megabit digital-megabyte digital-petabyte digital-terabit digital-terabyte duration-century duration-day duration-day-person duration-decade duration-hour duration-microsecond duration-millisecond duration-minute duration-month duration-month-person duration-nanosecond duration-quarter duration-second duration-week duration-week-person duration-year duration-year-person electric-ampere electric-milliampere electric-ohm electric-volt energy-british-thermal-unit energy-calorie energy-electronvolt energy-foodcalorie energy-joule energy-kilocalorie energy-kilojoule energy-kilowatt-hour energy-therm-us force-kilowatt-hour-per-100-kilometer force-newton force-pound-force frequency-gigahertz frequency-hertz frequency-kilohertz frequency-megahertz graphics-dot graphics-dot-per-centimeter graphics-dot-per-inch graphics-em graphics-megapixel graphics-pixel graphics-pixel-per-centimeter graphics-pixel-per-inch length-astronomical-unit length-centimeter length-decimeter length-earth-radius length-fathom length-foot length-furlong length-inch length-kilometer length-light-year length-meter length-micrometer length-mile length-mile-scandinavian length-millimeter length-nanometer length-nautical-mile length-parsec length-picometer length-point length-solar-radius length-yard light-candela light-lumen light-lux light-solar-luminosity mass-carat mass-dalton mass-earth-mass mass-grain mass-gram mass-kilogram mass-microgram mass-milligram mass-ounce mass-ounce-troy mass-pound mass-solar-mass mass-stone mass-ton mass-tonne none-base none-percent none-permille power-gigawatt power-horsepower power-kilowatt power-megawatt power-milliwatt power-watt pressure-atmosphere pressure-bar pressure-gasoline-energy-density pressure-hectopascal pressure-inch-ofhg pressure-kilopascal pressure-megapascal pressure-millibar pressure-millimeter-ofhg pressure-pascal pressure-pound-force-per-square-inch speed-beaufort speed-kilometer-per-hour speed-knot speed-light-speed speed-meter-per-second speed-mile-per-hour temperature-celsius temperature-fahrenheit temperature-generic temperature-kelvin torque-newton-meter torque-pound-force-foot volume-acre-foot volume-barrel volume-bushel volume-centiliter volume-cubic-centimeter volume-cubic-foot volume-cubic-inch volume-cubic-kilometer volume-cubic-meter volume-cubic-mile volume-cubic-yard volume-cup volume-cup-metric volume-deciliter volume-dessert-spoon volume-dessert-spoon-imperial volume-drop volume-dram volume-fluid-ounce volume-fluid-ounce-imperial volume-gallon volume-gallon-imperial volume-hectoliter volume-jigger volume-liter volume-megaliter volume-milliliter volume-pinch volume-pint volume-pint-metric volume-quart volume-quart-imperial volume-tablespoon volume-teaspoon "

// Whether TYPE-SUBTYPE is one of the built-in units.
fn builtIn(name: []const u8) -> bool {
    var at: usize = 0
    while at < BUILT_IN_UNITS.length {
        var end = at
        while end < BUILT_IN_UNITS.length && BUILT_IN_UNITS[end] != 32 { end += 1 }
        if m.same(BUILT_IN_UNITS[at..end], name) { return true }
        at = end + 1
    }
    return false
}

// Whether NAME is a simple unit: the subtype of a built-in unit.
fn simpleUnit(name: []const u8) -> bool {
    if name.length == 0 { return false }
    var at: usize = 0
    while at < BUILT_IN_UNITS.length {
        var end = at
        while end < BUILT_IN_UNITS.length && BUILT_IN_UNITS[end] != 32 { end += 1 }
        var dash = at
        while dash < end && BUILT_IN_UNITS[dash] != 45 { dash += 1 }
        if dash < end && m.same(BUILT_IN_UNITS[dash + 1..end], name) { return true }
        at = end + 1
    }
    return false
}

const SI_PREFIXES: []const u8 = "quetta ronna yotta zetta exa peta tera giga mega kilo hecto deka deci centi milli micro nano pico femto atto zepto yocto ronto quecto kibi mebi gibi tebi pebi exbi zebi yobi "

// Whether TEXT is a single unit of a core unit identifier: an optional
// power (square-, cubic-, powN-), an optional SI or binary prefix, a
// simple unit.
fn singleUnit(text: []const u8) -> bool {
    var rest = text
    if nd.startsWith(rest, "square-") {
        rest = rest[7..rest.length]
    } else if nd.startsWith(rest, "cubic-") {
        rest = rest[6..rest.length]
    } else if nd.startsWith(rest, "pow") {
        var at: usize = 3
        while at < rest.length && rest[at] >= 48 && rest[at] <= 57 { at += 1 }
        if at > 3 && at < rest.length && rest[at] == 45 { rest = rest[at + 1..rest.length] }
    }
    if simpleUnit(rest) { return true }
    var at: usize = 0
    while at < SI_PREFIXES.length {
        var end = at
        while end < SI_PREFIXES.length && SI_PREFIXES[end] != 32 { end += 1 }
        const prefix = SI_PREFIXES[at..end]
        if nd.startsWith(rest, prefix) && simpleUnit(rest[prefix.length..rest.length]) { return true }
        at = end + 1
    }
    return false
}

// Whether TEXT (a part between "-per-" and "-and-") is a product of
// single units joined by "-".
fn product(text: []const u8) -> bool {
    if text.length == 0 { return false }
    if singleUnit(text) { return true }
    // Split at each dash and try both sides.
    var at: usize = 1
    while at + 1 < text.length {
        if text[at] == 45 && singleUnit(text[0..at]) && product(text[at + 1..text.length]) { return true }
        at += 1
    }
    return false
}

// Whether ID is a core unit identifier (UTS #35): products, "-per-",
// mixed units with "-and-".
pub fn unitIdentifier(id: []const u8) -> bool {
    if id.length == 0 { return false }
    var rest = id
    if nd.startsWith(rest, "per-") { rest = rest[4..rest.length] }
    var start: usize = 0
    var at: usize = 0
    while at <= rest.length {
        var cut = false
        var skip: usize = 0
        if at == rest.length {
            cut = true
        } else if at + 5 <= rest.length && m.same(rest[at..at + 5], "-per-") {
            cut = true
            skip = 5
        } else if at + 5 <= rest.length && m.same(rest[at..at + 5], "-and-") {
            cut = true
            skip = 5
        }
        if cut {
            if !product(rest[start..at]) { return false }
            if at == rest.length { break }
            at += skip
            start = at
            continue
        }
        at += 1
    }
    return true
}

fn copyUnit(into: *[96]u8, length: *usize, token: []const u8) -> void {
    var index: usize = 0
    while index < token.length && index < 95 {
        into.*[index] = token[index]
        index += 1
    }
    length.* = index
}

fn parseMeasureUnitOption(p: *Parser, token: []const u8, per: bool) -> void {
    var dash: usize = 0
    while dash < token.length && token[dash] != 45 { dash += 1 }
    if dash == token.length {
        p.*.failed = true
        return
    }
    const s = p.*.settings
    if nd.startsWith(token, "currency-") && token.length == 12 {
        // A currency by its MeasureUnit name.
        if !per {
            parseCurrencyOption(p, token[9..12])
            return
        }
    }
    if !builtIn(token) {
        p.*.failed = true
        return
    }
    if per {
        if m.same(token, "none-base") {
            s.*.perUnitIdLength = 0
        } else {
            copyUnit(&s.*.perUnitId, &s.*.perUnitIdLength, token)
        }
        return
    }
    if m.same(token, "none-base") {
        s.*.unit = UNIT_NONE
    } else if m.same(token, "none-percent") {
        s.*.unit = UNIT_PERCENT
    } else if m.same(token, "none-permille") {
        s.*.unit = UNIT_PERMILLE
    } else {
        s.*.unit = UNIT_MEASURE
        copyUnit(&s.*.unitId, &s.*.unitIdLength, token)
    }
}

fn parseIdentifierUnitOption(p: *Parser, token: []const u8) -> void {
    if !unitIdentifier(token) {
        p.*.failed = true
        return
    }
    const s = p.*.settings
    s.*.unit = UNIT_MEASURE
    copyUnit(&s.*.unitId, &s.*.unitIdLength, token)
}

fn parseOption(p: *Parser, stem: i32, token: []const u8) -> i32 {
    const s = p.*.settings
    if stem == STATE_CURRENCY_UNIT {
        parseCurrencyOption(p, token)
        return STATE_NULL
    }
    if stem == STATE_MEASURE_UNIT {
        parseMeasureUnitOption(p, token, false)
        return STATE_NULL
    }
    if stem == STATE_PER_MEASURE_UNIT {
        parseMeasureUnitOption(p, token, true)
        return STATE_NULL
    }
    if stem == STATE_IDENTIFIER_UNIT {
        parseIdentifierUnitOption(p, token)
        return STATE_NULL
    }
    if stem == STATE_UNIT_USAGE {
        s.*.hasUsage = true
        return STATE_NULL
    }
    if stem == STATE_INCREMENT_PRECISION {
        parseIncrementOption(p, token)
        return STATE_PRECISION
    }
    if stem == STATE_INTEGER_WIDTH {
        parseIntegerWidthOption(p, token)
        return STATE_NULL
    }
    if stem == STATE_NUMBERING_SYSTEM {
        if token.length >= 16 || !numbersystems.exists(token) {
            p.*.failed = true
            return STATE_NULL
        }
        setNumberingSystem(s, token)
        return STATE_NULL
    }
    if stem == STATE_SCALE {
        parseScaleOption(p, token)
        return STATE_NULL
    }
    var state = stem
    if state == STATE_SCIENTIFIC {
        if parseExponentWidthOption(p, token) { return STATE_SCIENTIFIC }
        const sign = signOf(token)
        if sign != UNSET && !m.same(token, "+?") || (sign != UNSET && m.same(token, "+?")) {
            s.*.exponentSign = sign
            return STATE_SCIENTIFIC
        }
    }
    if state == STATE_FRACTION_PRECISION {
        if parseFracSigOption(p, token) { return STATE_PRECISION }
        if p.*.failed { return STATE_NULL }
        state = STATE_PRECISION
    }
    if state == STATE_PRECISION {
        if m.same(token, "w") {
            s.*.trailingZeroHide = true
            return STATE_NULL
        }
    }
    p.*.failed = true
    return STATE_NULL
}

fn isWhiteSpace(c: u32) -> bool {
    if c == 9 || c == 10 || c == 11 || c == 12 || c == 13 || c == 32 || c == 133 { return true }
    return c == 8206 || c == 8207 || c == 8232 || c == 8233
}

// Whether a stem in STATE needs an option.
fn needsOption(state: i32) -> bool {
    return state == STATE_INCREMENT_PRECISION || state == STATE_MEASURE_UNIT || state == STATE_PER_MEASURE_UNIT || state == STATE_IDENTIFIER_UNIT || state == STATE_UNIT_USAGE || state == STATE_CURRENCY_UNIT || state == STATE_INTEGER_WIDTH || state == STATE_NUMBERING_SYSTEM || state == STATE_SCALE
}

// Reads the skeleton (UTF-16 SKELETON, LENGTH units) into S. Returns 0,
// or U_NUMBER_SKELETON_SYNTAX_ERROR with the offset of the segment at
// fault in ERROR_OFFSET.
pub fn parse(skeleton: usize, length: usize, s: *Settings, errorOffset: *i32) -> i32 {
    initialize(s)
    var p = Parser.{ .settings = s, .seen = 0, .failed = false }
    var stem = STATE_NULL
    var segmentStart: usize = 0
    var offset: usize = 0
    // The token of the segment, as ASCII (anything else makes it
    // unknown).
    var token: [256]u8 = undefined
    while segmentStart + offset <= length {
        var c: u32 = 32
        var units: usize = 1
        if segmentStart + offset < length {
            var at = segmentStart + offset
            c = nd.decode16(skeleton, length, &at)
            units = at - segmentStart - offset
        }
        const tokenSeparator = isWhiteSpace(c)
        const optionSeparator = c == 47
        if !tokenSeparator && !optionSeparator {
            offset += units
            continue
        }
        if offset != 0 {
            var count: usize = 0
            var ascii = true
            var index: usize = 0
            while index < offset {
                const unit = m.get16(skeleton + (segmentStart + index) * 2)
                if unit >= 128 || unit == 0 { ascii = false }
                if count < 255 {
                    token[count] = @intCast(u8, unit & 127)
                    count += 1
                }
                index += 1
            }
            if !ascii || count >= 255 {
                p.failed = true
            } else if stem == STATE_NULL {
                stem = parseStem(&p, token[0..count])
            } else {
                stem = parseOption(&p, stem, token[0..count])
            }
            if p.failed {
                errorOffset.* = @intCast(i32, segmentStart)
                return SKELETON_SYNTAX_ERROR
            }
            segmentStart += offset
            offset = 0
        } else if stem != STATE_NULL {
            errorOffset.* = @intCast(i32, segmentStart)
            return SKELETON_SYNTAX_ERROR
        }
        if optionSeparator && stem == STATE_NULL {
            errorOffset.* = @intCast(i32, segmentStart)
            return SKELETON_SYNTAX_ERROR
        }
        if tokenSeparator && stem != STATE_NULL {
            if needsOption(stem) {
                errorOffset.* = @intCast(i32, segmentStart)
                return SKELETON_SYNTAX_ERROR
            }
            stem = STATE_NULL
        }
        segmentStart += units
    }
    return 0
}
