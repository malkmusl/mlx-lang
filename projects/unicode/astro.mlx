// The astronomy the lunar and lunisolar calendars take, as ICU's
// CalendarAstronomer works it out (Duffett-Smith's "Practical Astronomy
// with your Calculator"): the sun's ecliptic longitude, the moon's age
// (its longitude past the sun's) and the moment either reaches an angle,
// found by stepping toward it. The Chinese and Dangi calendars take
// their winter solstices, new moons and major solar terms of these, the
// astronomical Islamic calendar the age of the moon; the operations are
// ICU's, in its order, so the moments come out as ICU's do.
const math = @import("std.math")

pub const PI: f64 = 3.141592653589793
const PI2: f64 = 6.283185307179586
pub const SYNODIC_MONTH: f64 = 29.530588853
const TROPICAL_YEAR: f64 = 365.242191
const DAY_MS: f64 = 86400000.0
const MINUTE_MS: f64 = 60000.0
// The Julian day 0 and the epoch of the elements (1990, January 0.0).
const JULIAN_EPOCH_MS: f64 = -210866760000000.0
const JD_EPOCH: f64 = 2447891.5

// The sun's ecliptic longitude at the epoch, its perigee's, the orbit's
// eccentricity.
const SUN_ETA_G: f64 = 279.403303 * PI / 180.0
const SUN_OMEGA_G: f64 = 282.768422 * PI / 180.0
const SUN_E: f64 = 0.016713

// The moon's mean longitude at the epoch, its perigee's and its node's,
// the inclination of its orbit.
const MOON_L0: f64 = 318.351648 * PI / 180.0
const MOON_P0: f64 = 36.340410 * PI / 180.0
const MOON_N0: f64 = 318.510107 * PI / 180.0
const MOON_I: f64 = 5.145366 * PI / 180.0

pub const WINTER_SOLSTICE: f64 = PI * 3.0 / 2.0

fn normalize(value: f64, range: f64) -> f64 { return value - range * @floor(value / range) }

fn norm2PI(angle: f64) -> f64 { return normalize(angle, PI * 2.0) }

fn normPI(angle: f64) -> f64 { return normalize(angle + PI, PI * 2.0) - PI }

fn fabs(x: f64) -> f64 { return if x < 0.0 { -x } else { x } }

// ---------------------------------------------------------------------------
// The arc tangent: |x| above 1 is pi/2 - atan(1/x); below, atan(x) =
// atan(c) + atan((x - c) / (1 + x c)) for the nearest c in 0, 1/8, ...,
// 1, the second term a short series in |t| <= 1/16, the first from a
// table in two parts (as projects/libc's libm has it).

const PI_LOW: f64 = 0.00000000000000012246467991473532
const PI_2: f64 = 1.5707963267948966
const PI_2_LOW: f64 = 0.00000000000000006123233995736766

fn atanTableHigh(k: i64) -> f64 {
    if k == 1 { return 0.12435499454676144 }
    if k == 2 { return 0.24497866312686414 }
    if k == 3 { return 0.35877067027057225 }
    if k == 4 { return 0.4636476090008061 }
    if k == 5 { return 0.5585993153435624 }
    if k == 6 { return 0.6435011087932844 }
    if k == 7 { return 0.7188299996216245 }
    if k == 8 { return 0.7853981633974483 }
    return 0.0
}

fn atanTableLow(k: i64) -> f64 {
    if k == 1 { return -0.0000000000000000031253241424539383 }
    if k == 2 { return 0.000000000000000010698755618734451 }
    if k == 3 { return -0.000000000000000024623815582638635 }
    if k == 4 { return 0.000000000000000022698777452961687 }
    if k == 5 { return -0.0000000000000000054556305485916264 }
    if k == 6 { return 0.000000000000000015834785051444286 }
    if k == 7 { return -0.000000000000000021478388444456983 }
    if k == 8 { return 0.00000000000000003061616997868383 }
    return 0.0
}

fn withSign(magnitude: f64, sign: f64) -> f64 { return if sign < 0.0 { -magnitude } else { magnitude } }

fn atan(x: f64) -> f64 {
    if x != x { return x }
    var a = fabs(x)
    if a >= 73786976294838206464.0 { return withSign(PI_2 + PI_2_LOW, x) }
    if a < 0.00000000745058059692382812 { return x }
    const inverted = a > 1.0
    if inverted { a = 1.0 / a }
    const k = @intFromFloat(i64, math.round(a * 8.0))
    const c = @floatFromInt(f64, k) * 0.125
    const t = (a - c) / (1.0 + a * c)
    const z = t * t
    const series = t * (1.0 - z * (0.3333333333333333 - z * (0.2 - z * (0.14285714285714285 - z * (0.1111111111111111 - z * (0.09090909090909091 - z * (0.07692307692307693 - z * (0.06666666666666667 - z * 0.058823529411764705))))))))
    var result = atanTableHigh(k) + (atanTableLow(k) + series)
    if inverted { result = (PI_2 + PI_2_LOW) - result }
    return withSign(result, x)
}

fn atan2(y: f64, x: f64) -> f64 {
    if x != x || y != y { return x + y }
    if x == 1.0 { return atan(y) }
    const xNegative = x < 0.0
    if y == 0.0 { return if xNegative { withSign(PI, y) } else { y } }
    if x == 0.0 { return withSign(PI_2, y) }
    const ratio = fabs(y / x)
    var z: f64 = 0.0
    if ratio > 1152921504606846976.0 {
        z = PI_2 + 0.5 * PI_LOW
    } else if xNegative && ratio < 0.000000000000000000867361737988403547 {
        z = 0.0
    } else {
        z = atan(ratio)
    }
    if !xNegative { return withSign(z, y) }
    return withSign(PI - (z - PI_LOW), y)
}

fn tan(x: f64) -> f64 { return math.sin(x) / math.cos(x) }

// ---------------------------------------------------------------------------
// The sun and the moon at a moment (milliseconds since 1970, UTC).

fn julianDay(time: f64) -> f64 { return (time - JULIAN_EPOCH_MS) / DAY_MS }

// The true anomaly of a mean anomaly (Kepler's equation by Newton's
// method).
fn trueAnomaly(meanAnomaly: f64, eccentricity: f64) -> f64 {
    var delta: f64 = 0.0
    var e = meanAnomaly
    while true {
        delta = e - eccentricity * math.sin(e) - meanAnomaly
        e = e - delta / (1.0 - eccentricity * math.cos(e))
        if !(fabs(delta) > 0.00001) { break }
    }
    return 2.0 * atan(tan(e / 2.0) * @sqrt((1.0 + eccentricity) / (1.0 - eccentricity)))
}

pub const Sun = struct {
    longitude: f64
    meanAnomaly: f64
}

pub fn sun(time: f64) -> Sun {
    const day = julianDay(time) - JD_EPOCH
    const epochAngle = norm2PI(PI2 / TROPICAL_YEAR * day)
    const meanAnomaly = norm2PI(epochAngle + SUN_ETA_G - SUN_OMEGA_G)
    return Sun.{ .longitude = norm2PI(trueAnomaly(meanAnomaly, SUN_E) + SUN_OMEGA_G), .meanAnomaly = meanAnomaly }
}

pub fn sunLongitude(time: f64) -> f64 { return sun(time).longitude }

// The moon's age: its ecliptic longitude past the sun's, 0 to 2 pi (0 at
// the new moon).
pub fn moonAge(time: f64) -> f64 {
    const s = sun(time)
    const day = julianDay(time) - JD_EPOCH
    const meanLongitude = norm2PI(13.1763966 * PI / 180.0 * day + MOON_L0)
    var meanAnomalyMoon = norm2PI(meanLongitude - 0.1114041 * PI / 180.0 * day - MOON_P0)
    const evection = 1.2739 * PI / 180.0 * math.sin(2.0 * (meanLongitude - s.longitude) - meanAnomalyMoon)
    const annual = 0.1858 * PI / 180.0 * math.sin(s.meanAnomaly)
    const a3 = 0.3700 * PI / 180.0 * math.sin(s.meanAnomaly)
    meanAnomalyMoon += evection - annual - a3
    const center = 6.2886 * PI / 180.0 * math.sin(meanAnomalyMoon)
    const a4 = 0.2140 * PI / 180.0 * math.sin(2.0 * meanAnomalyMoon)
    var moonLongitude = meanLongitude + evection + center - annual + a4
    const variation = 0.6583 * PI / 180.0 * math.sin(2.0 * (moonLongitude - s.longitude))
    moonLongitude += variation
    var nodeLongitude = norm2PI(MOON_N0 - 0.0529539 * PI / 180.0 * day)
    nodeLongitude -= 0.16 * PI / 180.0 * math.sin(s.meanAnomaly)
    const y = math.sin(moonLongitude - nodeLongitude)
    const x = math.cos(moonLongitude - nodeLongitude)
    const eclipticLongitude = atan2(y * math.cos(MOON_I), x) + nodeLongitude
    return norm2PI(eclipticLongitude - s.longitude)
}

// ---------------------------------------------------------------------------
// The moment an angle of the sun or the moon is reached, the next or the
// last from START (ICU's timeOfAngle: steps of the angle's rate, back to
// an eighth of a period from the start when a step overshoots).

const SUN_ANGLE: u8 = 0
const MOON_AGE: u8 = 1

fn angleOf(which: u8, time: f64) -> f64 { return if which == SUN_ANGLE { sunLongitude(time) } else { moonAge(time) } }

fn timeOfAngle(which: u8, start: f64, desired: f64, periodDays: f64, epsilon: f64, next: bool) -> f64 {
    var startTime = start
    while true {
        var time = startTime
        var lastAngle = angleOf(which, time)
        const deltaAngle = norm2PI(desired - lastAngle)
        var deltaT = (deltaAngle + (if next { 0.0 } else { -PI2 })) * (periodDays * DAY_MS) / PI2
        var lastDeltaT = deltaT
        time = time + @ceil(deltaT)
        var restart = false
        while true {
            const angle = angleOf(which, time)
            const factor = fabs(deltaT / normPI(angle - lastAngle))
            deltaT = normPI(desired - angle) * factor
            if fabs(deltaT) > fabs(lastDeltaT) {
                const delta = @ceil(periodDays * DAY_MS / 8.0)
                startTime = startTime + (if next { delta } else { -delta })
                restart = true
                break
            }
            lastDeltaT = deltaT
            lastAngle = angle
            time = time + @ceil(deltaT)
            if !(fabs(deltaT) > epsilon) { break }
        }
        if !restart { return time }
    }
    return startTime
}

// The moment of the sun's longitude DESIRED after (or before) TIME.
pub fn sunTime(time: f64, desired: f64, next: bool) -> f64 { return timeOfAngle(SUN_ANGLE, time, desired, TROPICAL_YEAR, MINUTE_MS, next) }

// The moment of the moon's age DESIRED (0: the new moon) after (or
// before) TIME.
pub fn moonTime(time: f64, desired: f64, next: bool) -> f64 { return timeOfAngle(MOON_AGE, time, desired, SYNODIC_MONTH, MINUTE_MS, next) }
