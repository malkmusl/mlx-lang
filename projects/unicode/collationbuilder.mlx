// Collation tailorings: rules (UTS #35 Part 5, the syntax ICU reads) made
// into a tailoring of the root collation (collationelements.mlx), as
// ICU's CollationBuilder makes them.
//
// The rules are parsed as ICU's CollationRuleParser does: resets
// (`&x`, `&[before n]x`, `&[first variable]` and the other special
// positions), relations (`<`, `<<`, `<<<`, `<<<<`, `=`, their starred
// lists `<*abc` with ranges `a-c`), prefixes (`x|y`), extensions
// (`x/y`), quoting (`'...'`, `\x`), comments (`#`) and the settings
// (`[strength n]`, `[alternate shifted]`, `[backwards 2]`, `[caseLevel
// on]`, `[caseFirst upper]`, `[numericOrdering on]`, `[normalization
// on]`, `[maxVariable punct]`, `[reorder Grek Latn ...]`, `[import
// xx-u-co-yy]`, `[suppressContractions [...]]`, `[optimize [...]]`).
//
// Each tailored string gets a node in lists hanging off the root's
// primaries: a relation inserts its node after the reset position and the
// weaker nodes that follow it, `[before n]` before it. When the rules
// are read, the nodes of each list get weights in the gaps between the
// root weights (the root's primaries are 16-bit numbers shifted left by
// 16, its secondaries and tertiaries shifted left by 7, so there is room
// between any two), and the temporary elements of the mappings become
// those weights.
//
// The rules of CLDR's locales are in collationrules.mlx (made by
// collation-generate); a locale's collation and the rules `[import]`
// names are found there, the locale's parents after it as CLDR has them.
const m = @import("./memory.mlx")
const p = @import("./properties.mlx")
const tables = @import("./tables.mlx")
const normalize = @import("./normalize.mlx")
const localeid = @import("./localeid.mlx")
const e = @import("./collationelements.mlx")
const data = @import("./collationrules.mlx")

const PRIMARY: u32 = 0
const SECONDARY: u32 = 1
const TERTIARY: u32 = 2
const QUATERNARY: u32 = 3
const IDENTICAL: u32 = 15

pub const INVALID_FORMAT_ERROR: i32 = 3

// UColAttribute and its values, as collation.mlx has them.
const FRENCH_COLLATION: usize = 0
const ALTERNATE_HANDLING: usize = 1
const CASE_FIRST: usize = 2
const CASE_LEVEL: usize = 3
const NORMALIZATION_MODE: usize = 4
const STRENGTH: usize = 5
const NUMERIC_COLLATION: usize = 7
const ATTRIBUTE_OFF: i32 = 16
const ATTRIBUTE_ON: i32 = 17
const SHIFTED: i32 = 20
const NON_IGNORABLE: i32 = 21
const LOWER_FIRST: i32 = 24
const UPPER_FIRST: i32 = 25

// Node flags (with the strength in the low two bits).
const TAILORED: u32 = 4
const HAS_BEFORE2: u32 = 8
const HAS_BEFORE3: u32 = 16

// The special reset positions, as their order in POSITIONS.
const FIRST_TERTIARY_IGNORABLE: usize = 0
const LAST_TERTIARY_IGNORABLE: usize = 1
const FIRST_SECONDARY_IGNORABLE: usize = 2
const LAST_SECONDARY_IGNORABLE: usize = 3
const FIRST_PRIMARY_IGNORABLE: usize = 4
const LAST_PRIMARY_IGNORABLE: usize = 5
const FIRST_VARIABLE: usize = 6
const LAST_VARIABLE: usize = 7
const FIRST_REGULAR: usize = 8
const LAST_REGULAR: usize = 9
const FIRST_IMPLICIT: usize = 10
const LAST_IMPLICIT: usize = 11
const FIRST_TRAILING: usize = 12
const LAST_TRAILING: usize = 13
const POSITIONS: []const u8 = "first tertiary ignorable\nlast tertiary ignorable\nfirst secondary ignorable\nlast secondary ignorable\nfirst primary ignorable\nlast primary ignorable\nfirst variable\nlast variable\nfirst regular\nlast regular\nfirst implicit\nlast implicit\nfirst trailing\nlast trailing\n"
// A reset to a special position is this code point and the position's.
const POSITION_LEAD: u32 = 65534

const Builder = struct {
    tailoring: usize
    // The nodes: weight (32 bits for a primary node, 16 for the others),
    // flags and strength, the previous and the next node (0: none).
    weights: m.Buffer
    flags: m.Buffer
    previous: m.Buffer
    next: m.Buffer
    // The elements the nodes get (pairs).
    final: m.Buffer
    // The root primaries that have nodes: pairs of primary and node,
    // sorted.
    roots: m.Buffer
    // The elements of the current position (pairs).
    ces: m.Buffer
    // The rules being read (code points) and where.
    rules: *m.Buffer
    at: usize
    // The variable top the rules mean by [last variable].
    variableTop: u32
    status: i32
    depth: u32
}

fn builderAt(address: usize) -> *Builder { unsafe { return @ptrFromInt(*Builder, address) } }

fn fail(b: *Builder) -> void {
    if b.*.status <= 0 { b.*.status = INVALID_FORMAT_ERROR }
}

// ---------------------------------------------------------------------------
// Nodes

fn strengthOf(b: *Builder, node: u32) -> u32 { return m.at(&b.*.flags, @intCast(usize, node)) & 3 }
fn flagsOf(b: *Builder, node: u32) -> u32 { return m.at(&b.*.flags, @intCast(usize, node)) }
fn isTailored(b: *Builder, node: u32) -> bool { return (flagsOf(b, node) & TAILORED) != 0 }
fn hasBefore2(b: *Builder, node: u32) -> bool { return (flagsOf(b, node) & HAS_BEFORE2) != 0 }
fn hasBefore3(b: *Builder, node: u32) -> bool { return (flagsOf(b, node) & HAS_BEFORE3) != 0 }
fn weightOf(b: *Builder, node: u32) -> u32 { return m.at(&b.*.weights, @intCast(usize, node)) }
fn nextOf(b: *Builder, node: u32) -> u32 { return m.at(&b.*.next, @intCast(usize, node)) }
fn previousOf(b: *Builder, node: u32) -> u32 { return m.at(&b.*.previous, @intCast(usize, node)) }
fn setFlags(b: *Builder, node: u32, value: u32) -> void { m.setAt(&b.*.flags, @intCast(usize, node), value) }

fn newNode(b: *Builder, weight: u32, flags: u32) -> u32 {
    const node = @intCast(u32, b.*.weights.length)
    m.push(&b.*.weights, weight)
    m.push(&b.*.flags, flags)
    m.push(&b.*.previous, 0)
    m.push(&b.*.next, 0)
    return node
}

// A new node between `index` and `nextIndex` (0: none after).
fn insertNodeBetween(b: *Builder, index: u32, nextIndex: u32, weight: u32, flags: u32) -> u32 {
    const node = newNode(b, weight, flags)
    m.setAt(&b.*.previous, @intCast(usize, node), index)
    m.setAt(&b.*.next, @intCast(usize, node), nextIndex)
    m.setAt(&b.*.next, @intCast(usize, index), node)
    if nextIndex != 0 { m.setAt(&b.*.previous, @intCast(usize, nextIndex), node) }
    return node
}

// The common weight of a level.
fn commonOf(level: u32) -> u32 { return if level == SECONDARY { e.COMMON_SECONDARY } else { e.COMMON_TERTIARY } }
fn beforeOf(level: u32) -> u32 { return if level == SECONDARY { e.BEFORE_SECONDARY } else { e.BEFORE_TERTIARY } }

// The node of root primary `primary` (made when there is none).
fn nodeForPrimary(b: *Builder, primary: u32) -> u32 {
    var low: usize = 0
    var high = b.*.roots.length / 2
    while low < high {
        const middle = (low + high) / 2
        const value = m.at(&b.*.roots, middle * 2)
        if value == primary { return m.at(&b.*.roots, middle * 2 + 1) }
        if value < primary { low = middle + 1 } else { high = middle }
    }
    const node = newNode(b, primary, PRIMARY)
    m.push(&b.*.roots, 0)
    m.push(&b.*.roots, 0)
    var at = b.*.roots.length / 2 - 1
    while at > low {
        m.setAt(&b.*.roots, at * 2, m.at(&b.*.roots, at * 2 - 2))
        m.setAt(&b.*.roots, at * 2 + 1, m.at(&b.*.roots, at * 2 - 1))
        at -= 1
    }
    m.setAt(&b.*.roots, low * 2, primary)
    m.setAt(&b.*.roots, low * 2 + 1, node)
    return node
}

// The node after `index` that holds the common weight of `level`
// (`index` itself when it implies it).
fn findCommonNode(b: *Builder, index: u32, level: u32) -> u32 {
    if strengthOf(b, index) >= level { return index }
    if level == SECONDARY && !hasBefore2(b, index) { return index }
    if level == TERTIARY && !hasBefore3(b, index) { return index }
    var node = nextOf(b, index)
    while true {
        node = nextOf(b, node)
        if node == 0 { return index }
        if !(isTailored(b, node) || strengthOf(b, node) > level || weightOf(b, node) < commonOf(level)) { break }
    }
    return node
}

// The node of root weight `weight` of `level` after node `index` (made
// when there is none).
fn findOrInsertWeakNode(b: *Builder, index: u32, weight: u32, level: u32) -> u32 {
    if weight == commonOf(level) { return findCommonNode(b, index, level) }
    var current = index
    if weight != 0 && weight < commonOf(level) {
        const before = if level == SECONDARY { HAS_BEFORE2 } else { HAS_BEFORE3 }
        var flags = flagsOf(b, index)
        if (flags & before) == 0 {
            // The parent implied the common weight: below-common, then common.
            var commonFlags = level
            if level == SECONDARY {
                commonFlags = commonFlags | (flags & HAS_BEFORE3)
                flags = flags & ~HAS_BEFORE3
            }
            setFlags(b, index, flags | before)
            const nextIndex = nextOf(b, index)
            const below = insertNodeBetween(b, index, nextIndex, weight, level)
            _ = insertNodeBetween(b, below, nextIndex, commonOf(level), commonFlags)
            return below
        }
    }
    // Insert before the next stronger node, or before the next root
    // node of this strength with a larger weight.
    var nextIndex = nextOf(b, current)
    while nextIndex != 0 {
        const strength = strengthOf(b, nextIndex)
        if strength <= level {
            if strength < level { break }
            if !isTailored(b, nextIndex) {
                const nextWeight = weightOf(b, nextIndex)
                if nextWeight == weight { return nextIndex }
                if nextWeight > weight { break }
            }
        }
        current = nextIndex
        nextIndex = nextOf(b, current)
    }
    return insertNodeBetween(b, current, nextIndex, weight, level)
}

fn nodeForRootElement(b: *Builder, high: u32, low: u32, strength: u32) -> u32 {
    var index = nodeForPrimary(b, high)
    if strength >= SECONDARY {
        index = findOrInsertWeakNode(b, index, e.secondaryOf(low), SECONDARY)
        if strength >= TERTIARY { index = findOrInsertWeakNode(b, index, e.tertiaryOf(low), TERTIARY) }
    }
    return index
}

// A new tailored node of `strength` after `index` and the weaker nodes
// that follow it.
fn insertTailoredNodeAfter(b: *Builder, index: u32, strength: u32) -> u32 {
    var current = index
    if strength >= SECONDARY {
        current = findCommonNode(b, current, SECONDARY)
        if strength >= TERTIARY { current = findCommonNode(b, current, TERTIARY) }
    }
    var nextIndex = nextOf(b, current)
    while nextIndex != 0 {
        if strengthOf(b, nextIndex) <= strength { break }
        current = nextIndex
        nextIndex = nextOf(b, current)
    }
    return insertNodeBetween(b, current, nextIndex, 0, TAILORED | strength)
}

// ---------------------------------------------------------------------------
// The current position's elements

fn isTemporary(high: u32) -> bool { return high == e.TEMPORARY }

fn strengthOfElement(high: u32, low: u32) -> u32 {
    if isTemporary(high) { return low & 3 }
    if high != 0 { return PRIMARY }
    if e.secondaryOf(low) != 0 { return SECONDARY }
    if low != 0 { return TERTIARY }
    return IDENTICAL
}

fn cesCount(b: *Builder) -> usize { return b.*.ces.length / 2 }
fn ceHigh(b: *Builder, index: usize) -> u32 { return m.at(&b.*.ces, index * 2) }
fn ceLow(b: *Builder, index: usize) -> u32 { return m.at(&b.*.ces, index * 2 + 1) }

fn setLastElement(b: *Builder, high: u32, low: u32) -> void {
    m.setAt(&b.*.ces, b.*.ces.length - 2, high)
    m.setAt(&b.*.ces, b.*.ces.length - 1, low)
}

// The node of the last element of the position at least as strong as
// `strength` (the weaker ones after it dropped).
fn nodeForElements(b: *Builder, strength: u32) -> u32 {
    var high: u32 = 0
    var low: u32 = 0
    while true {
        if cesCount(b) == 0 {
            e.pushPair(&b.*.ces, 0, 0)
            break
        }
        high = ceHigh(b, cesCount(b) - 1)
        low = ceLow(b, cesCount(b) - 1)
        if strengthOfElement(high, low) <= strength { break }
        b.*.ces.length -= 2
    }
    if isTemporary(high) { return low >> 4 }
    return nodeForRootElement(b, high, low, strength)
}

fn temporary(node: u32, strength: u32) -> u32 { return (node << 4) | strength }

// ---------------------------------------------------------------------------
// Resets and relations

// The elements of the code points `text` (NFD) as the tailoring has them
// so far, appended to the position.
fn appendElements(b: *Builder, text: *m.Buffer) -> void { e.elements(b.*.tailoring, text, &b.*.ces) }

// NFD of `text` into `out`: a copy when it is NFD already, as most
// strings of rules are (normalizing takes some of the export's arena,
// which a tailoring of tens of thousands of strings would use up).
fn nfd(text: *m.Buffer, out: *m.Buffer) -> void {
    out.*.length = 0
    var already = true
    var lastClass: u32 = 0
    var index: usize = 0
    while index < text.*.length && already {
        const c = @intCast(i32, m.at(text, index))
        const combining = p.combiningClass(c)
        if p.nfdQuickCheck(c) != 0 || (combining != 0 && combining < lastClass) { already = false }
        lastClass = combining
        index += 1
    }
    if !already {
        normalize.normalizeCodes(out, text, normalize.NFD)
        return
    }
    index = 0
    while index < text.*.length {
        m.push(out, m.at(text, index))
        index += 1
    }
}

// The root weight of `level` before the one of node `node`, for a reset
// before it.
fn weightBefore(b: *Builder, index: u32, level: u32) -> u32 {
    var node = index
    var tertiary = if strengthOf(b, node) == TERTIARY { weightOf(b, node) } else { e.COMMON_TERTIARY }
    while strengthOf(b, node) > SECONDARY { node = previousOf(b, node) }
    if isTailored(b, node) { return beforeOf(level) }
    const secondary = if strengthOf(b, node) == SECONDARY { weightOf(b, node) } else { e.COMMON_SECONDARY }
    while strengthOf(b, node) > PRIMARY { node = previousOf(b, node) }
    if isTailored(b, node) { return beforeOf(level) }
    const weight = if level == SECONDARY { secondary } else { tertiary }
    if weight == commonOf(level) { return beforeOf(level) }
    return weight - (if level == SECONDARY { 64 } else { 32 })
}

fn specialPosition(b: *Builder, position: usize) -> void {
    b.*.ces.length = 0
    var high: u32 = 0
    var low: u32 = 0
    var strength = PRIMARY
    if position == FIRST_TERTIARY_IGNORABLE || position == LAST_TERTIARY_IGNORABLE {
        e.pushPair(&b.*.ces, 0, 0)
        return
    }
    if position == FIRST_SECONDARY_IGNORABLE || position == LAST_SECONDARY_IGNORABLE {
        high = 0
        low = e.lowerWord(0, 0, e.TERTIARY_BOUNDARY, 0)
        strength = TERTIARY
    } else if position == FIRST_PRIMARY_IGNORABLE {
        // A tailored secondary node after [0, 0, *] comes first.
        const zero = nodeForRootElement(b, 0, 0, SECONDARY)
        var node = nextOf(b, zero)
        while node != 0 {
            const s = strengthOf(b, node)
            if s < SECONDARY { break }
            if s == SECONDARY {
                if isTailored(b, node) {
                    var at = node
                    if hasBefore3(b, node) { at = nextOf(b, nextOf(b, node)) }
                    e.pushPair(&b.*.ces, e.TEMPORARY, temporary(at, SECONDARY))
                    return
                }
                break
            }
            node = nextOf(b, node)
        }
        low = e.firstSecondaryElement()
        strength = SECONDARY
    } else if position == LAST_PRIMARY_IGNORABLE {
        low = e.lastSecondaryElement()
        strength = SECONDARY
    } else if position == FIRST_VARIABLE {
        high = e.firstPrimary()
        low = e.lowerWord(e.COMMON_SECONDARY, 0, e.COMMON_TERTIARY, 0)
    } else if position == LAST_VARIABLE {
        high = e.lastPrimaryBelow(b.*.variableTop + 1)
        low = e.lowerWord(e.COMMON_SECONDARY, 0, e.COMMON_TERTIARY, 0)
    } else if position == FIRST_REGULAR {
        high = e.firstPrimaryFrom(b.*.variableTop + 1)
        low = e.lowerWord(e.COMMON_SECONDARY, 0, e.COMMON_TERTIARY, 0)
    } else if position == LAST_REGULAR {
        high = e.HAN_FIRST
        low = e.lowerWord(e.COMMON_SECONDARY, 0, e.COMMON_TERTIARY, 0)
    } else if position == FIRST_IMPLICIT {
        high = e.implicitPrimary(19968, false)
        low = e.lowerWord(e.COMMON_SECONDARY, 0, e.COMMON_TERTIARY, 0)
    } else if position == FIRST_TRAILING {
        high = 4294770688
        low = e.lowerWord(e.COMMON_SECONDARY, 0, e.COMMON_TERTIARY, 0)
    } else {
        // (LDML forbids tailoring to U+FFFF.)
        fail(b)
        e.pushPair(&b.*.ces, 0, 0)
        return
    }
    var node = nodeForRootElement(b, high, low, strength)
    if (position & 1) == 0 {
        // [first xyz]: before it what was tailored before it.
        if hasBefore2(b, node) || hasBefore3(b, node) {
            if hasBefore2(b, node) { node = nextOf(b, nextOf(b, node)) }
            if hasBefore3(b, node) { node = nextOf(b, nextOf(b, node)) }
            e.pushPair(&b.*.ces, e.TEMPORARY, temporary(node, strength))
            return
        }
    } else {
        // [last xyz]: after what was tailored after it at a strength no
        // greater than the position's.
        while true {
            const nextIndex = nextOf(b, node)
            if nextIndex == 0 || strengthOf(b, nextIndex) < strength { break }
            node = nextIndex
        }
        if isTailored(b, node) {
            e.pushPair(&b.*.ces, e.TEMPORARY, temporary(node, strength))
            return
        }
    }
    e.pushPair(&b.*.ces, high, low)
}

// `&[before strength]position` (IDENTICAL: no before), `position` a
// string or a special position.
fn addReset(b: *Builder, strength: u32, position: *m.Buffer) -> void {
    if position.*.length == 2 && m.at(position, 0) == POSITION_LEAD {
        specialPosition(b, @intCast(usize, m.at(position, 1)))
    } else {
        var text = m.buffer()
        nfd(position, &text)
        b.*.ces.length = 0
        appendElements(b, &text)
        m.dispose(&text)
    }
    if b.*.status > 0 || strength == IDENTICAL { return }
    var index = nodeForElements(b, strength)
    // Back over the weaker nodes.
    while strengthOf(b, index) > strength { index = previousOf(b, index) }
    var resetStrength = strength
    if strengthOf(b, index) == strength && isTailored(b, index) {
        // Just before this same-strength tailored node.
        index = previousOf(b, index)
    } else if strength == PRIMARY {
        const primary = weightOf(b, index)
        if primary == 0 {
            fail(b)
            return
        }
        index = nodeForPrimary(b, e.primaryBefore(primary))
        // After the last node between the two root primaries.
        while nextOf(b, index) != 0 { index = nextOf(b, index) }
    } else {
        index = findCommonNode(b, index, SECONDARY)
        if strength >= TERTIARY { index = findCommonNode(b, index, TERTIARY) }
        if strengthOf(b, index) == strength {
            // A same-strength node with an explicit weight: just before it,
            // at the root weight before it.
            const weight = weightBefore(b, index, strength)
            const previousIndex = previousOf(b, index)
            var previousWeight: u32 = commonOf(strength)
            var node = previousIndex
            while true {
                const s = strengthOf(b, node)
                if s < strength {
                    previousWeight = commonOf(strength)
                    break
                }
                if s == strength && !isTailored(b, node) {
                    previousWeight = weightOf(b, node)
                    break
                }
                node = previousOf(b, node)
            }
            if previousWeight == weight {
                index = previousIndex
            } else {
                index = insertNodeBetween(b, previousIndex, index, weight, strength)
            }
        } else {
            // A stronger node with an implied common weight.
            index = findOrInsertWeakNode(b, index, beforeOf(strength), strength)
        }
        resetStrength = strengthOfElement(ceHigh(b, cesCount(b) - 1), ceLow(b, cesCount(b) - 1))
        if resetStrength > QUATERNARY { resetStrength = strength }
    }
    setLastElement(b, e.TEMPORARY, temporary(index, resetStrength))
}

// The case bits of a tailored string's primaries from the root's for
// it; tertiary elements upper case.
fn setCaseBits(b: *Builder, text: *m.Buffer) -> void {
    var tailoredPrimaries: usize = 0
    var index: usize = 0
    while index < cesCount(b) {
        if strengthOfElement(ceHigh(b, index), ceLow(b, index)) == PRIMARY { tailoredPrimaries += 1 }
        index += 1
    }
    var cases: u64 = 0
    if tailoredPrimaries > 0 && tailoredPrimaries <= 31 {
        var base = m.buffer()
        e.elements(0, text, &base)
        var lastCase: u64 = 0
        var basePrimaries: usize = 0
        index = 0
        while index < base.length / 2 {
            if m.at(&base, index * 2) != 0 {
                basePrimaries += 1
                const c = @intCast(u64, e.caseOf(m.at(&base, index * 2 + 1)))
                if basePrimaries < tailoredPrimaries {
                    cases = cases | (c << @intCast(u6, (basePrimaries - 1) * 2))
                } else if basePrimaries == tailoredPrimaries {
                    lastCase = c
                } else if c != lastCase {
                    lastCase = 1
                    break
                }
            }
            index += 1
        }
        if basePrimaries >= tailoredPrimaries { cases = cases | (lastCase << @intCast(u6, (tailoredPrimaries - 1) * 2)) }
        m.dispose(&base)
    }
    index = 0
    while index < cesCount(b) {
        const high = ceHigh(b, index)
        var low = ceLow(b, index)
        const strength = strengthOfElement(high, low)
        var letterCase: u32 = 0
        if strength == PRIMARY {
            letterCase = @intCast(u32, cases & 3)
            cases = cases >> 2
        } else if strength == TERTIARY {
            letterCase = 2
        }
        if isTemporary(high) {
            low = (low & 4294967283) | (letterCase << 2)
        } else {
            low = (low & 4294918143) | (letterCase << 14)
        }
        m.setAt(&b.*.ces, index * 2 + 1, low)
        index += 1
    }
}

// Maps `string` after `prefix` (both NFD) to the elements `ces`; the
// root's contractions of its first code point stay.
fn addMapping(b: *Builder, prefix: *m.Buffer, string: *m.Buffer, ces: *m.Buffer) -> void {
    const t = e.tailoringAt(b.*.tailoring)
    const c = m.at(string, 0)
    if e.firstEntry(t, c) == 0 && !e.isSuppressed(t, c) {
        const root = e.rootTailoring()
        var entry = e.rootContractionsOf(c)
        var none = m.buffer()
        var copied = m.buffer()
        var elements = m.buffer()
        while entry != 0 {
            copied.length = 0
            elements.length = 0
            m.push(&copied, c)
            var at: usize = 0
            while at < e.restLength(root, entry) {
                m.push(&copied, e.restCode(root, entry, at))
                at += 1
            }
            const start = e.elementStart(root, entry)
            at = 0
            while at < e.elementCount(root, entry) * 2 {
                m.push(&elements, m.at(&root.*.ces, start + at))
                at += 1
            }
            e.addEntry(t, &none, &copied, &elements)
            entry = e.entryNext(root, entry)
        }
        m.dispose(&copied)
        m.dispose(&elements)
    }
    e.addEntry(t, prefix, string, ces)
}

fn addRelation(b: *Builder, strength: u32, prefix: *m.Buffer, string: *m.Buffer, extension: *m.Buffer) -> void {
    var nfdPrefix = m.buffer()
    var nfdString = m.buffer()
    if prefix.*.length > 0 { nfd(prefix, &nfdPrefix) }
    nfd(string, &nfdString)
    if nfdString.length == 0 {
        fail(b)
        m.dispose(&nfdPrefix)
        m.dispose(&nfdString)
        return
    }
    if strength != IDENTICAL {
        var index = nodeForElements(b, strength)
        const lastHigh = ceHigh(b, cesCount(b) - 1)
        const lastLow = ceLow(b, cesCount(b) - 1)
        if strength == PRIMARY && !isTemporary(lastHigh) && lastHigh == 0 {
            // (No primary gap between the ignorables and the first primary.)
            fail(b)
            m.dispose(&nfdPrefix)
            m.dispose(&nfdString)
            return
        }
        index = insertTailoredNodeAfter(b, index, strength)
        var elementStrength = strengthOfElement(lastHigh, lastLow)
        if strength < elementStrength { elementStrength = strength }
        setLastElement(b, e.TEMPORARY, temporary(index, elementStrength))
    }
    setCaseBits(b, &nfdString)
    const before = b.*.ces.length
    if extension.*.length > 0 {
        var nfdExtension = m.buffer()
        nfd(extension, &nfdExtension)
        appendElements(b, &nfdExtension)
        m.dispose(&nfdExtension)
    }
    addMapping(b, &nfdPrefix, &nfdString, &b.*.ces)
    b.*.ces.length = before
    m.dispose(&nfdPrefix)
    m.dispose(&nfdString)
}

// ---------------------------------------------------------------------------
// Weights for the nodes

// The weights `count` of them between `low` and `limit` take: the step.
fn stepBetween(low: u32, limit: u32, count: u32) -> u32 {
    if limit <= low { return 1 }
    const step = (limit - low) / (count + 1)
    return if step == 0 { 1 } else { step }
}

// The tailored nodes of `strength` from `start` on before a stronger
// node, and the weight of the root node of that strength they end at (0
// when they end otherwise).
fn countTailored(b: *Builder, start: u32, strength: u32, limit: *u32) -> u32 {
    var count: u32 = 0
    var node = start
    limit.* = 0
    while node != 0 {
        const s = strengthOf(b, node)
        if s < strength { break }
        if s == strength {
            if isTailored(b, node) {
                count += 1
            } else {
                limit.* = weightOf(b, node)
                break
            }
        }
        node = nextOf(b, node)
    }
    return count
}

fn makeTailoredElements(b: *Builder) -> void {
    var index: usize = 0
    while index < b.*.weights.length * 2 {
        m.push(&b.*.final, 0)
        index += 1
    }
    var root: usize = 0
    while root < b.*.roots.length / 2 {
        var node = m.at(&b.*.roots, root * 2 + 1)
        var primary = weightOf(b, node)
        var secondary: u32 = if primary == 0 { 0 } else { e.COMMON_SECONDARY }
        var tertiary: u32 = secondary
        if primary != 0 { tertiary = e.COMMON_TERTIARY }
        var quaternary: u32 = 0
        var primaryTailored = false
        var secondaryTailored = false
        var tertiaryTailored = false
        var primaryStep: u32 = 0
        var secondaryStep: u32 = 0
        var tertiaryStep: u32 = 0
        var nextIndex = nextOf(b, node)
        while nextIndex != 0 {
            node = nextIndex
            nextIndex = nextOf(b, node)
            const strength = strengthOf(b, node)
            if strength == QUATERNARY {
                if quaternary < 3 { quaternary += 1 }
            } else {
                if strength == TERTIARY {
                    if isTailored(b, node) {
                        if !tertiaryTailored {
                            var limit: u32 = 0
                            const count = countTailored(b, nextIndex, TERTIARY, &limit) + 1
                            if limit == 0 {
                                if tertiary == 0 {
                                    // Tertiary elements: above all other tertiaries.
                                    tertiary = e.TERTIARY_BOUNDARY
                                    limit = 4096
                                } else if !primaryTailored && !secondaryTailored {
                                    limit = if tertiary >= e.TERTIARY_BOUNDARY { 4096 } else { ((tertiary >> 6) + 1) << 6 }
                                } else if tertiary == e.BEFORE_TERTIARY {
                                    limit = e.COMMON_TERTIARY
                                } else {
                                    limit = e.TERTIARY_BOUNDARY
                                }
                            }
                            tertiaryStep = stepBetween(tertiary, limit, count)
                            tertiaryTailored = true
                        }
                        tertiary += tertiaryStep
                    } else {
                        tertiary = weightOf(b, node)
                        tertiaryTailored = false
                    }
                } else {
                    if strength == SECONDARY {
                        if isTailored(b, node) {
                            if !secondaryTailored {
                                var limit: u32 = 0
                                const count = countTailored(b, nextIndex, SECONDARY, &limit) + 1
                                if limit == 0 {
                                    if secondary == 0 {
                                        // Secondary elements tailored after [0, 0]: below
                                        // the root's first.
                                        secondary = e.COMMON_SECONDARY
                                        limit = e.secondaryOf(e.firstSecondaryElement())
                                    } else if !primaryTailored {
                                        limit = if secondary < e.VARIANT_SECONDARY { e.VARIANT_SECONDARY } else { ((secondary >> 7) + 1) << 7 }
                                        if secondary < e.COMMON_SECONDARY { limit = ((secondary >> 7) + 1) << 7 }
                                    } else if secondary == e.BEFORE_SECONDARY {
                                        limit = e.COMMON_SECONDARY
                                    } else {
                                        // Below the root's secondary elements.
                                        limit = e.SECONDARY_BOUNDARY
                                    }
                                }
                                secondaryStep = stepBetween(secondary, limit, count)
                                secondaryTailored = true
                            }
                            secondary += secondaryStep
                        } else {
                            secondary = weightOf(b, node)
                            secondaryTailored = false
                        }
                    } else {
                        if !primaryTailored {
                            var limit: u32 = 0
                            const count = countTailored(b, nextIndex, PRIMARY, &limit) + 1
                            primaryStep = stepBetween(primary, e.primaryAfter(primary), count)
                            primaryTailored = true
                        }
                        primary += primaryStep
                        secondary = e.COMMON_SECONDARY
                        secondaryTailored = false
                    }
                    tertiary = if secondary == 0 { 0 } else { e.COMMON_TERTIARY }
                    tertiaryTailored = false
                }
                quaternary = 0
            }
            if isTailored(b, node) {
                m.setAt(&b.*.final, @intCast(usize, node) * 2, primary)
                m.setAt(&b.*.final, @intCast(usize, node) * 2 + 1, e.lowerWord(secondary, 0, tertiary, quaternary))
            }
        }
        root += 1
    }
    // The mappings' temporary elements become the nodes' (with their own
    // case bits).
    const t = e.tailoringAt(b.*.tailoring)
    index = 0
    while index + 1 < t.*.ces.length {
        const high = m.at(&t.*.ces, index)
        if isTemporary(high) {
            const low = m.at(&t.*.ces, index + 1)
            const node = @intCast(usize, low >> 4)
            m.setAt(&t.*.ces, index, m.at(&b.*.final, node * 2))
            m.setAt(&t.*.ces, index + 1, m.at(&b.*.final, node * 2 + 1) | (((low >> 2) & 3) << 14))
        }
        index += 2
    }
}

// ---------------------------------------------------------------------------
// The parser

fn isWhiteSpace(c: u32) -> bool { return (c >= 9 && c <= 13) || c == 32 || c == 133 || c == 8206 || c == 8207 || c == 8232 || c == 8233 }

fn isSyntaxChar(c: u32) -> bool { return c >= 33 && c <= 126 && (c <= 47 || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || c >= 123) }

fn ruleAt(b: *Builder, index: usize) -> u32 { return if index < b.*.rules.*.length { m.at(b.*.rules, index) } else { 0 } }
fn ruleCount(b: *Builder) -> usize { return b.*.rules.*.length }

fn skipWhiteSpace(b: *Builder, from: usize) -> usize {
    var index = from
    while index < ruleCount(b) && isWhiteSpace(ruleAt(b, index)) { index += 1 }
    return index
}

fn skipComment(b: *Builder, from: usize) -> usize {
    var index = from
    while index < ruleCount(b) {
        const c = ruleAt(b, index)
        index += 1
        if c == 10 || c == 12 || c == 13 || c == 133 || c == 8232 || c == 8233 { break }
    }
    return index
}

// A string of the rules (quoted and escaped parts as their text) into
// `raw`; where it ends.
fn parseString(b: *Builder, from: usize, raw: *m.Buffer) -> usize {
    raw.*.length = 0
    var index = from
    while index < ruleCount(b) {
        var c = ruleAt(b, index)
        index += 1
        if isSyntaxChar(c) {
            if c == 39 {
                if index < ruleCount(b) && ruleAt(b, index) == 39 {
                    m.push(raw, 39)
                    index += 1
                    continue
                }
                while true {
                    if index >= ruleCount(b) {
                        fail(b)
                        return index
                    }
                    c = ruleAt(b, index)
                    index += 1
                    if c == 39 {
                        if index < ruleCount(b) && ruleAt(b, index) == 39 {
                            index += 1
                        } else {
                            break
                        }
                    }
                    m.push(raw, c)
                }
            } else if c == 92 {
                if index >= ruleCount(b) {
                    fail(b)
                    return index
                }
                m.push(raw, ruleAt(b, index))
                index += 1
            } else {
                index -= 1
                break
            }
        } else if isWhiteSpace(c) {
            index -= 1
            break
        } else {
            m.push(raw, c)
        }
    }
    return index
}

fn parseTailoringString(b: *Builder, from: usize, raw: *m.Buffer) -> usize {
    const index = parseString(b, skipWhiteSpace(b, from), raw)
    if raw.*.length == 0 { fail(b) }
    return skipWhiteSpace(b, index)
}

// Words (letters, digits, `-`, `_`, one space between them) into `raw`;
// where they end (at a syntax character), 0 at the end of the rules.
fn readWords(b: *Builder, from: usize, raw: *m.Buffer) -> usize {
    raw.*.length = 0
    var index = skipWhiteSpace(b, from)
    while true {
        if index >= ruleCount(b) { return 0 }
        const c = ruleAt(b, index)
        if isSyntaxChar(c) && c != 45 && c != 95 {
            if raw.*.length > 0 && m.at(raw, raw.*.length - 1) == 32 { raw.*.length -= 1 }
            return index
        }
        if isWhiteSpace(c) {
            m.push(raw, 32)
            index = skipWhiteSpace(b, index + 1)
        } else {
            m.push(raw, c)
            index += 1
        }
    }
    return 0
}

// Whether the code points `raw` from `start` (count `count`) spell `text`.
fn spells(raw: *m.Buffer, start: usize, count: usize, text: []const u8) -> bool {
    if count != text.length || start + count > raw.*.length { return false }
    var index: usize = 0
    while index < count {
        if m.at(raw, start + index) != @intCast(u32, text[index]) { return false }
        index += 1
    }
    return true
}

fn isWord(raw: *m.Buffer, text: []const u8) -> bool { return spells(raw, 0, raw.*.length, text) }

// The special position the words name (POSITIONS' order), or 99.
fn positionOf(raw: *m.Buffer) -> usize {
    var line: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index < POSITIONS.length {
        if POSITIONS[index] == 10 {
            if isWord(raw, POSITIONS[start..index]) { return line }
            line += 1
            start = index + 1
        }
        index += 1
    }
    if isWord(raw, "top") { return LAST_REGULAR }
    if isWord(raw, "variable top") { return LAST_VARIABLE }
    return 99
}

fn parseSpecialPosition(b: *Builder, from: usize, out: *m.Buffer) -> usize {
    var raw = m.buffer()
    const end = readWords(b, from + 1, &raw)
    out.*.length = 0
    var result = from
    if end > from && ruleAt(b, end) == 93 && raw.length > 0 {
        const position = positionOf(&raw)
        if position != 99 {
            m.push(out, POSITION_LEAD)
            m.push(out, @intCast(u32, position))
            result = end + 1
        } else {
            fail(b)
        }
    } else {
        fail(b)
    }
    m.dispose(&raw)
    return result
}

// `&...` and the relations that follow.
fn parseRuleChain(b: *Builder) -> void {
    var resetStrength = IDENTICAL
    var index = skipWhiteSpace(b, b.*.at + 1)
    // [before n]
    if spells(b.*.rules, index, 7, "[before") && index + 7 < ruleCount(b) && isWhiteSpace(ruleAt(b, index + 7)) {
        const j = skipWhiteSpace(b, index + 8)
        const c = ruleAt(b, j)
        if j + 1 < ruleCount(b) && c >= 49 && c <= 51 && ruleAt(b, j + 1) == 93 {
            resetStrength = c - 49
            index = skipWhiteSpace(b, j + 2)
        } else {
            fail(b)
            return
        }
    }
    if index >= ruleCount(b) {
        fail(b)
        return
    }
    var position = m.buffer()
    if ruleAt(b, index) == 91 {
        index = parseSpecialPosition(b, index, &position)
    } else {
        index = parseTailoringString(b, index, &position)
    }
    if b.*.status > 0 {
        m.dispose(&position)
        return
    }
    addReset(b, resetStrength, &position)
    m.dispose(&position)
    b.*.at = index
    var first = true
    var prefix = m.buffer()
    var string = m.buffer()
    var extension = m.buffer()
    while b.*.status <= 0 {
        index = skipWhiteSpace(b, b.*.at)
        if index >= ruleCount(b) {
            b.*.at = index
            break
        }
        // The relation operator.
        var c = ruleAt(b, index)
        var strength: u32 = 99
        var length: usize = 1
        if c == 60 {
            strength = PRIMARY
            while strength < QUATERNARY && ruleAt(b, index + length) == 60 {
                strength += 1
                length += 1
            }
        } else if c == 59 {
            strength = SECONDARY
        } else if c == 44 {
            strength = TERTIARY
        } else if c == 61 {
            strength = IDENTICAL
        }
        if strength == 99 {
            if c == 35 {
                b.*.at = skipComment(b, index + 1)
                continue
            }
            b.*.at = index
            break
        }
        var starred = false
        if (c == 60 || c == 61) && ruleAt(b, index + length) == 42 {
            starred = true
            length += 1
        }
        if resetStrength != IDENTICAL {
            if first && strength != resetStrength {
                fail(b)
                break
            }
            if !first && strength < resetStrength {
                fail(b)
                break
            }
        }
        index += length
        if starred {
            index = parseStarred(b, strength, index)
        } else {
            // prefix | string / extension
            prefix.length = 0
            extension.length = 0
            index = parseTailoringString(b, index, &string)
            if b.*.status > 0 { break }
            c = ruleAt(b, index)
            if index < ruleCount(b) && c == 124 {
                var at: usize = 0
                while at < string.length {
                    m.push(&prefix, m.at(&string, at))
                    at += 1
                }
                index = parseTailoringString(b, index + 1, &string)
                c = ruleAt(b, index)
            }
            if b.*.status <= 0 && index < ruleCount(b) && c == 47 {
                index = parseTailoringString(b, index + 1, &extension)
            }
            if b.*.status > 0 { break }
            addRelation(b, strength, &prefix, &string, &extension)
        }
        b.*.at = index
        first = false
    }
    m.dispose(&prefix)
    m.dispose(&string)
    m.dispose(&extension)
}

// `<*abc-e...`: a relation of each code point.
fn parseStarred(b: *Builder, strength: u32, from: usize) -> usize {
    var raw = m.buffer()
    var one = m.buffer()
    var none = m.buffer()
    var index = parseString(b, skipWhiteSpace(b, from), &raw)
    if raw.length == 0 { fail(b) }
    var previous: u32 = 4294967295
    var j: usize = 0
    while b.*.status <= 0 {
        while j < raw.length {
            const c = m.at(&raw, j)
            one.length = 0
            m.push(&one, c)
            addRelation(b, strength, &none, &one, &none)
            previous = c
            j += 1
        }
        if index >= ruleCount(b) || ruleAt(b, index) != 45 { break }
        if previous == 4294967295 {
            fail(b)
            break
        }
        index = parseString(b, index + 1, &raw)
        if raw.length == 0 {
            fail(b)
            break
        }
        const last = m.at(&raw, 0)
        if last < previous {
            fail(b)
            break
        }
        var c = previous + 1
        while c <= last && b.*.status <= 0 {
            one.length = 0
            m.push(&one, c)
            addRelation(b, strength, &none, &one, &none)
            c += 1
        }
        previous = 4294967295
        j = 1
    }
    m.dispose(&raw)
    m.dispose(&one)
    m.dispose(&none)
    return skipWhiteSpace(b, index)
}

// A code point of a set's escape at `from` (after the backslash) into
// `c`; where it ends.
fn setEscape(b: *Builder, from: usize, c: *u32) -> usize {
    const kind = ruleAt(b, from)
    var digits: usize = 0
    var index = from + 1
    if kind == 117 { digits = 4 }
    if kind == 85 { digits = 8 }
    if kind == 120 {
        if ruleAt(b, index) == 123 {
            index += 1
            var value: u32 = 0
            while index < ruleCount(b) && ruleAt(b, index) != 125 {
                value = value * 16 + hexValue(ruleAt(b, index))
                index += 1
            }
            c.* = value
            return index + 1
        }
        digits = 2
    }
    if digits == 0 {
        c.* = kind
        return from + 1
    }
    var value: u32 = 0
    var count: usize = 0
    while count < digits && index < ruleCount(b) {
        value = value * 16 + hexValue(ruleAt(b, index))
        index += 1
        count += 1
    }
    c.* = value
    return index
}

fn hexValue(c: u32) -> u32 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return 0
}

// A set (`[a-zĀ ...]`, nested sets as their union; properties and
// strings are not read) from `from` (its `[`); its ranges into `ranges`
// (pairs); where it ends.
fn parseSet(b: *Builder, from: usize, ranges: *m.Buffer) -> usize {
    var index = from + 1
    var previous: u32 = 4294967295
    var pendingRange = false
    while index < ruleCount(b) {
        const c = ruleAt(b, index)
        if isWhiteSpace(c) {
            index += 1
            continue
        }
        if c == 93 { return index + 1 }
        if c == 91 {
            if ruleAt(b, index + 1) == 58 {
                // [:property:] — not read.
                while index < ruleCount(b) && !(ruleAt(b, index) == 58 && ruleAt(b, index + 1) == 93) { index += 1 }
                index += 2
                continue
            }
            index = parseSet(b, index, ranges)
            continue
        }
        if c == 45 && previous != 4294967295 {
            pendingRange = true
            index += 1
            continue
        }
        if c == 123 {
            while index < ruleCount(b) && ruleAt(b, index) != 125 { index += 1 }
            index += 1
            continue
        }
        var value = c
        index += 1
        if c == 92 { index = setEscape(b, index, &value) }
        if pendingRange {
            m.setAt(ranges, ranges.*.length - 1, value)
            pendingRange = false
            previous = 4294967295
        } else {
            m.push(ranges, value)
            m.push(ranges, value)
            previous = value
        }
    }
    fail(b)
    return index
}

fn lowered(c: u32) -> u32 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

// Whether the code points `raw` from `start` (count `count`) spell `text`
// ignoring case.
fn spellsLoosely(raw: *m.Buffer, start: usize, count: usize, text: []const u8) -> bool {
    if count != text.length { return false }
    var index: usize = 0
    while index < count {
        if lowered(m.at(raw, start + index)) != lowered(@intCast(u32, text[index])) { return false }
        index += 1
    }
    return true
}

// The reordering code a word names (a group, a script's short or long
// name, `others`), -2 when none.
pub fn reorderCodeOf(raw: *m.Buffer, start: usize, count: usize) -> i32 {
    if spellsLoosely(raw, start, count, "space") { return e.GROUP_SPACE }
    if spellsLoosely(raw, start, count, "punct") { return e.GROUP_PUNCTUATION }
    if spellsLoosely(raw, start, count, "symbol") { return e.GROUP_SYMBOL }
    if spellsLoosely(raw, start, count, "currency") { return e.GROUP_CURRENCY }
    if spellsLoosely(raw, start, count, "digit") { return e.GROUP_DIGIT }
    if spellsLoosely(raw, start, count, "others") || spellsLoosely(raw, start, count, "zzzz") { return e.SCRIPT_UNKNOWN }
    if spellsLoosely(raw, start, count, "default") { return -1 }
    var code: usize = 0
    while code < tables.SCRIPT_COUNT {
        if spellsLoosely(raw, start, count, p.wordOf(tables.SCRIPT_NAMES, code, 0)) || spellsLoosely(raw, start, count, p.wordOf(tables.SCRIPT_NAMES, code, 1)) { return @intCast(i32, code) }
        code += 1
    }
    return -2
}

fn parseReorder(b: *Builder, raw: *m.Buffer) -> void {
    const t = e.tailoringAt(b.*.tailoring)
    t.*.reorder.length = 0
    var index: usize = 8
    while index < raw.*.length {
        var end = index
        while end < raw.*.length && m.at(raw, end) != 32 { end += 1 }
        const code = reorderCodeOf(raw, index, end - index)
        if code == -2 {
            fail(b)
            return
        }
        if code != -1 { m.push(&t.*.reorder, @bitCast(u32, code)) }
        index = end + 1
    }
}

fn setSetting(b: *Builder, which: usize, value: i32) -> void { e.tailoringAt(b.*.tailoring).*.settings[which] = value }

fn onOff(raw: *m.Buffer, start: usize) -> i32 {
    if spells(raw, start, raw.*.length - start, "on") { return ATTRIBUTE_ON }
    if spells(raw, start, raw.*.length - start, "off") { return ATTRIBUTE_OFF }
    return -1
}

// `[...]` at b.at.
fn parseSetting(b: *Builder) -> void {
    var raw = m.buffer()
    const start = b.*.at + 1
    const end = readWords(b, start, &raw)
    if end <= start || raw.length == 0 {
        fail(b)
        m.dispose(&raw)
        return
    }
    if ruleAt(b, end) == 93 {
        b.*.at = end + 1
        if spells(&raw, 0, 7, "reorder") && (raw.length == 7 || m.at(&raw, 7) == 32) {
            parseReorder(b, &raw)
        } else if isWord(&raw, "backwards 2") {
            setSetting(b, FRENCH_COLLATION, ATTRIBUTE_ON)
        } else {
            // The words: a name and its value after the last space.
            var space = raw.length
            while space > 0 && m.at(&raw, space - 1) != 32 { space -= 1 }
            const valueStart = space
            const nameLength = if space > 0 { space - 1 } else { 0 }
            const valueLength = raw.length - valueStart
            var known = false
            if spells(&raw, 0, nameLength, "strength") && valueLength == 1 {
                const c = m.at(&raw, valueStart)
                if c >= 49 && c <= 52 {
                    setSetting(b, STRENGTH, @intCast(i32, c - 49))
                    known = true
                }
                if c == 73 {
                    setSetting(b, STRENGTH, 15)
                    known = true
                }
            } else if spells(&raw, 0, nameLength, "alternate") {
                if spells(&raw, valueStart, valueLength, "non-ignorable") {
                    setSetting(b, ALTERNATE_HANDLING, NON_IGNORABLE)
                    known = true
                }
                if spells(&raw, valueStart, valueLength, "shifted") {
                    setSetting(b, ALTERNATE_HANDLING, SHIFTED)
                    known = true
                }
            } else if spells(&raw, 0, nameLength, "maxVariable") {
                var group: i32 = -1
                if spells(&raw, valueStart, valueLength, "space") { group = 0 }
                if spells(&raw, valueStart, valueLength, "punct") { group = 1 }
                if spells(&raw, valueStart, valueLength, "symbol") { group = 2 }
                if spells(&raw, valueStart, valueLength, "currency") { group = 3 }
                if group >= 0 {
                    e.tailoringAt(b.*.tailoring).*.maxVariable = group
                    b.*.variableTop = e.groupLastPrimary(e.GROUP_SPACE + group)
                    known = true
                }
            } else if spells(&raw, 0, nameLength, "caseFirst") {
                if spells(&raw, valueStart, valueLength, "off") {
                    setSetting(b, CASE_FIRST, ATTRIBUTE_OFF)
                    known = true
                }
                if spells(&raw, valueStart, valueLength, "lower") {
                    setSetting(b, CASE_FIRST, LOWER_FIRST)
                    known = true
                }
                if spells(&raw, valueStart, valueLength, "upper") {
                    setSetting(b, CASE_FIRST, UPPER_FIRST)
                    known = true
                }
            } else if spells(&raw, 0, nameLength, "caseLevel") && onOff(&raw, valueStart) >= 0 {
                setSetting(b, CASE_LEVEL, onOff(&raw, valueStart))
                known = true
            } else if spells(&raw, 0, nameLength, "normalization") && onOff(&raw, valueStart) >= 0 {
                setSetting(b, NORMALIZATION_MODE, onOff(&raw, valueStart))
                known = true
            } else if spells(&raw, 0, nameLength, "numericOrdering") && onOff(&raw, valueStart) >= 0 {
                setSetting(b, NUMERIC_COLLATION, onOff(&raw, valueStart))
                known = true
            } else if spells(&raw, 0, nameLength, "hiraganaQ") && onOff(&raw, valueStart) >= 0 {
                known = true
            } else if spells(&raw, 0, nameLength, "import") {
                importRules(b, &raw, valueStart)
                known = true
            }
            if !known { fail(b) }
        }
    } else if ruleAt(b, end) == 91 {
        var ranges = m.buffer()
        var after = skipWhiteSpace(b, parseSet(b, end, &ranges))
        // The option's own `]`.
        if ruleAt(b, after) == 93 { after += 1 } else { fail(b) }
        if isWord(&raw, "suppressContractions") {
            const t = e.tailoringAt(b.*.tailoring)
            var index: usize = 0
            while index + 1 < ranges.length {
                var c = m.at(&ranges, index)
                while c <= m.at(&ranges, index + 1) {
                    e.suppress(t, c)
                    c += 1
                }
                index += 2
            }
        } else if !isWord(&raw, "optimize") {
            fail(b)
        }
        m.dispose(&ranges)
        b.*.at = after
    } else {
        fail(b)
    }
    m.dispose(&raw)
}

// `[import tag]`: the rules of the locale and type the language tag
// names, read here.
fn importRules(b: *Builder, raw: *m.Buffer, start: usize) -> void {
    var tag = m.bytesBuffer()
    var index = start
    while index < raw.*.length {
        const c = m.at(raw, index)
        m.pushByte(&tag, @intCast(u8, if c < 128 { c } else { 63 }))
        index += 1
    }
    var locale: [64]u8 = undefined
    var kind: [32]u8 = undefined
    var kindLength: usize = 0
    const length = tagLocale(m.bytesText(&tag), &locale, &kind, &kindLength)
    m.disposeBytes(&tag)
    const localeText = unsafe { @ptrCast([*]u8, &locale) }
    const kindText = unsafe { @ptrCast([*]u8, &kind) }
    const key = findRules(localeText[0..length], if kindLength > 0 { kindText[0..kindLength] } else { "standard" }, false)
    if key == NOT_FOUND || b.*.depth > 8 {
        fail(b)
        return
    }
    var imported = m.buffer()
    rulesText(key, &imported)
    const outer = b.*.rules
    const outerAt = b.*.at
    b.*.depth += 1
    b.*.rules = &imported
    parseRules(b)
    b.*.depth -= 1
    b.*.rules = outer
    b.*.at = outerAt
    m.dispose(&imported)
}

fn parseRules(b: *Builder) -> void {
    b.*.at = 0
    while b.*.at < ruleCount(b) && b.*.status <= 0 {
        const c = ruleAt(b, b.*.at)
        if isWhiteSpace(c) {
            b.*.at += 1
        } else if c == 38 {
            parseRuleChain(b)
        } else if c == 91 {
            parseSetting(b)
        } else if c == 35 {
            b.*.at = skipComment(b, b.*.at + 1)
        } else if c == 64 {
            setSetting(b, FRENCH_COLLATION, ATTRIBUTE_ON)
            b.*.at += 1
        } else if c == 33 {
            b.*.at += 1
        } else {
            fail(b)
        }
    }
}

// The tailoring the rules `rules` (code points) make; its status (0, or
// an error) into `status`.
pub fn build(rules: *m.Buffer, status: *i32, offset: *usize) -> usize {
    e.ensureRoot()
    const address = m.alloc(@sizeOf(Builder))
    const b = builderAt(address)
    b.*.tailoring = e.newTailoring()
    b.*.weights = m.buffer()
    b.*.flags = m.buffer()
    b.*.previous = m.buffer()
    b.*.next = m.buffer()
    b.*.final = m.buffer()
    b.*.roots = m.buffer()
    b.*.ces = m.buffer()
    b.*.rules = rules
    b.*.at = 0
    b.*.variableTop = e.groupLastPrimary(e.GROUP_PUNCTUATION)
    b.*.status = 0
    b.*.depth = 0
    // Node 0: the root primary 0.
    _ = nodeForPrimary(b, 0)
    parseRules(b)
    if b.*.status <= 0 { makeTailoredElements(b) }
    status.* = b.*.status
    offset.* = b.*.at
    const t = b.*.tailoring
    m.dispose(&b.*.weights)
    m.dispose(&b.*.flags)
    m.dispose(&b.*.previous)
    m.dispose(&b.*.next)
    m.dispose(&b.*.final)
    m.dispose(&b.*.roots)
    m.dispose(&b.*.ces)
    m.release(address)
    if status.* > 0 {
        e.disposeTailoring(t)
        return 0
    }
    // The rules as UTF-16, for ucol_getRules.
    const tailoring = e.tailoringAt(t)
    tailoring.*.rulesUnits = m.alloc(rules.*.length * 4 + 2)
    tailoring.*.rulesLength = m.encode16(rules, tailoring.*.rulesUnits, rules.*.length * 2)
    return t
}

// ---------------------------------------------------------------------------
// CLDR's rules by locale

pub const NOT_FOUND: usize = 4294967295

fn compareText(a: []const u8, b: []const u8) -> i32 {
    var index: usize = 0
    while index < a.length && index < b.length {
        if a[index] != b[index] { return if a[index] < b[index] { -1 } else { 1 } }
        index += 1
    }
    if a.length == b.length { return 0 }
    return if a.length < b.length { -1 } else { 1 }
}

fn entryOf(keys: []const u8, starts: [*]const u32, count: usize, index: usize) -> []const u8 {
    const start = @intCast(usize, starts[index])
    const end = @intCast(usize, starts[index + 1]) - 1
    return keys[start..end]
}

fn search(keys: []const u8, starts: [*]const u32, count: usize, key: []const u8) -> usize {
    var low: usize = 0
    var high = count
    while low < high {
        const middle = (low + high) / 2
        const order = compareText(entryOf(keys, starts, count, middle), key)
        if order == 0 { return middle }
        if order < 0 { low = middle + 1 } else { high = middle }
    }
    return NOT_FOUND
}

fn localeStarts() -> [*]const u32 { return unsafe { @ptrCast([*]const u32, &data.LOCALE_KEYS_STARTS) } }
fn defaultStarts() -> [*]const u32 { return unsafe { @ptrCast([*]const u32, &data.LOCALE_VALUES_STARTS) } }
fn ruleKeyStarts() -> [*]const u32 { return unsafe { @ptrCast([*]const u32, &data.RULES_KEYS_STARTS) } }
fn ruleStarts() -> [*]const u32 { return unsafe { @ptrCast([*]const u32, &data.RULES_VALUES_STARTS) } }

pub fn localeCount() -> usize { return data.LOCALE_COUNT }
pub fn localeAt(index: usize) -> []const u8 { return entryOf(data.LOCALE_KEYS, localeStarts(), data.LOCALE_COUNT, index) }
pub fn localeAddress(index: usize) -> usize { return @intFromPtr(data.LOCALE_KEYS.pointer) + @intCast(usize, localeStarts()[index]) }
pub fn hasLocale(locale: []const u8) -> bool { return search(data.LOCALE_KEYS, localeStarts(), data.LOCALE_COUNT, locale) != NOT_FOUND }

// The default type of a locale's file ("" when it names none).
fn defaultOf(locale: []const u8) -> []const u8 {
    const index = search(data.LOCALE_KEYS, localeStarts(), data.LOCALE_COUNT, locale)
    if index == NOT_FOUND { return "" }
    return entryOf(data.LOCALE_VALUES, defaultStarts(), data.LOCALE_COUNT, index)
}

pub fn ruleCountOf() -> usize { return data.RULES_COUNT }
pub fn ruleKeyAt(index: usize) -> []const u8 { return entryOf(data.RULES_KEYS, ruleKeyStarts(), data.RULES_COUNT, index) }

// The rules of entry `key` as code points into `out`.
pub fn rulesText(key: usize, out: *m.Buffer) -> void {
    const text = entryOf(data.RULES_VALUES, ruleStarts(), data.RULES_COUNT, key)
    var index: usize = 0
    while index < text.length {
        const lead = @intCast(u32, text[index])
        var c = lead
        var extra: usize = 0
        if lead >= 240 {
            c = lead & 7
            extra = 3
        } else if lead >= 224 {
            c = lead & 15
            extra = 2
        } else if lead >= 192 {
            c = lead & 31
            extra = 1
        }
        index += 1
        var k: usize = 0
        while k < extra && index < text.length {
            c = (c << 6) | @intCast(u32, text[index] & 63)
            index += 1
            k += 1
        }
        m.push(out, c)
    }
}

// The entry of `locale/kind`, NOT_FOUND when there is none.
fn ruleEntry(locale: []const u8, kind: []const u8) -> usize {
    var key: [96]u8 = undefined
    if locale.length + kind.length + 1 > 96 { return NOT_FOUND }
    var index: usize = 0
    while index < locale.length {
        key[index] = locale[index]
        index += 1
    }
    key[locale.length] = 47
    index = 0
    while index < kind.length {
        key[locale.length + 1 + index] = kind[index]
        index += 1
    }
    const view = unsafe { @ptrCast([*]u8, &key) }
    return search(data.RULES_KEYS, ruleKeyStarts(), data.RULES_COUNT, view[0..locale.length + 1 + kind.length])
}

// ---------------------------------------------------------------------------
// A locale's chain of collation data, as ICU looks for it: the locale
// (with the script likely subtags give its language and region when that
// is not the language's own: zh_TW is zh_Hant_TW), less and less of it,
// the parents CLDR names for collation (nb and nn: no; yue: zh_Hant), the
// root. (Unlike the other locale data, a script the language does not
// usually have does not lead to the root: pa_Arab has pa's collation.)

pub const Chain = struct {
    text: [256]u8
    starts: [12]usize
    lengths: [12]usize
    count: usize
}

fn addLink(chain: *Chain, part: []const u8) -> void {
    if part.length == 0 || chain.*.count >= 12 { return }
    var index: usize = 0
    while index < chain.*.count {
        const start = chain.*.starts[index]
        if chain.*.lengths[index] == part.length && compareText(chainBytes(chain)[start..start + part.length], part) == 0 { return }
        index += 1
    }
    var end: usize = 0
    if chain.*.count > 0 { end = chain.*.starts[chain.*.count - 1] + chain.*.lengths[chain.*.count - 1] }
    if end + part.length > 256 { return }
    index = 0
    while index < part.length {
        chain.*.text[end + index] = part[index]
        index += 1
    }
    chain.*.starts[chain.*.count] = end
    chain.*.lengths[chain.*.count] = part.length
    chain.*.count += 1
}

fn chainBytes(chain: *Chain) -> [*]u8 { return unsafe { @ptrCast([*]u8, &chain.*.text) } }

pub fn chainLink(chain: *Chain, index: usize) -> []const u8 {
    const start = chain.*.starts[index]
    return chainBytes(chain)[start..start + chain.*.lengths[index]]
}

fn isAlpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn lowerByte(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }
fn upperByte(c: u8) -> u8 { return if c >= 97 && c <= 122 { c - 32 } else { c } }

// The parts of a locale ID or tag: language, script, region, variants
// (as ICU writes them: `ll`, `Ssss`, `RR`, `VARIANT`).
pub const Parts = struct {
    text: [96]u8
    language: usize
    script: usize
    region: usize
    variant: usize
}

fn partsBytes(parts: *Parts) -> [*]u8 { return unsafe { @ptrCast([*]u8, &parts.*.text) } }
fn languageOf(parts: *Parts) -> []const u8 { return partsBytes(parts)[0..parts.*.language] }
fn scriptOf(parts: *Parts) -> []const u8 { return partsBytes(parts)[16..16 + parts.*.script] }
fn regionOf(parts: *Parts) -> []const u8 { return partsBytes(parts)[24..24 + parts.*.region] }
fn variantOf(parts: *Parts) -> []const u8 { return partsBytes(parts)[32..32 + parts.*.variant] }

pub fn splitLocale(locale: []const u8, parts: *Parts) -> void {
    parts.*.language = 0
    parts.*.script = 0
    parts.*.region = 0
    parts.*.variant = 0
    const bytes = partsBytes(parts)
    var index: usize = 0
    var field: usize = 0
    while index < locale.length && locale[index] != 64 {
        const start = index
        while index < locale.length && locale[index] != 45 && locale[index] != 95 && locale[index] != 64 { index += 1 }
        const part = locale[start..index]
        if index < locale.length && locale[index] != 64 { index += 1 }
        // A singleton (`-u-`, `-x-`) ends the base.
        if part.length == 1 && field > 0 { break }
        if field == 0 {
            if part.length >= 2 && part.length <= 8 && part.length <= 15 {
                var k: usize = 0
                while k < part.length && k < 15 {
                    bytes[k] = lowerByte(part[k])
                    k += 1
                }
                parts.*.language = k
            }
            field = 1
            continue
        }
        if field == 1 && part.length == 4 && isAlpha(part[0]) {
            bytes[16] = upperByte(part[0])
            bytes[17] = lowerByte(part[1])
            bytes[18] = lowerByte(part[2])
            bytes[19] = lowerByte(part[3])
            parts.*.script = 4
            field = 2
            continue
        }
        if field <= 2 && ((part.length == 2 && isAlpha(part[0])) || (part.length == 3 && isDigit(part[0]))) {
            var k: usize = 0
            while k < part.length {
                bytes[24 + k] = upperByte(part[k])
                k += 1
            }
            parts.*.region = part.length
            field = 3
            continue
        }
        // A variant.
        field = 3
        var k: usize = 0
        if parts.*.variant > 0 && parts.*.variant < 63 {
            bytes[32 + parts.*.variant] = 95
            parts.*.variant += 1
        }
        while k < part.length && parts.*.variant < 63 {
            bytes[32 + parts.*.variant] = upperByte(part[k])
            parts.*.variant += 1
            k += 1
        }
    }
    if parts.*.language == 0 && locale.length >= 4 && compareText(locale[0..4], "root") == 0 { parts.*.language = 0 }
}

fn joinParts(into: *[64]u8, a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> usize {
    var length: usize = 0
    var index: usize = 0
    while index < 4 {
        const part = if index == 0 { a } else if index == 1 { b } else if index == 2 { c } else { d }
        if part.length > 0 {
            if length > 0 && length < 64 {
                into.*[length] = 95
                length += 1
            }
            var k: usize = 0
            while k < part.length && length < 64 {
                into.*[length] = part[k]
                length += 1
                k += 1
            }
        }
        index += 1
    }
    return length
}

fn joined(into: *[64]u8, length: usize) -> []const u8 {
    const view = unsafe { @ptrCast([*]u8, into) }
    return view[0..length]
}

// The script likely subtags give `id` ("" when none).
fn likelyScript(id: []const u8, into: *[4]u8) -> usize {
    var buffer: [96]u8 = undefined
    const view = unsafe { @ptrCast([*]u8, &buffer) }
    const length = localeid.likelyInto(id, view, 96)
    var parts: Parts = undefined
    splitLocale(view[0..length], &parts)
    var index: usize = 0
    while index < parts.script {
        into.*[index] = scriptOf(&parts)[index]
        index += 1
    }
    return parts.script
}

// The parents CLDR gives some locales for collation (parentLocales'
// collations and the language's own: nb, nn → no).
fn collationParent(locale: []const u8) -> []const u8 {
    if compareText(locale, "nb") == 0 || compareText(locale, "nn") == 0 { return "no" }
    if compareText(locale, "yue") == 0 || compareText(locale, "yue_Hant") == 0 { return "zh_Hant" }
    if compareText(locale, "yue_Hans") == 0 || compareText(locale, "yue_CN") == 0 { return "zh_Hans" }
    if compareText(locale, "sr_Cyrl_ME") == 0 { return "sr_ME" }
    return ""
}

pub fn makeChain(locale: []const u8, chain: *Chain) -> void {
    chain.*.count = 0
    var parts: Parts = undefined
    splitLocale(locale, &parts)
    var name: [64]u8 = undefined
    var language = languageOf(&parts)
    if language.length == 0 || compareText(language, "root") == 0 || compareText(language, "und") == 0 {
        addLink(chain, "root")
        return
    }
    var round: usize = 0
    while round < 3 {
        var script: [4]u8 = undefined
        var scriptLength = parts.script
        var index: usize = 0
        while index < scriptLength {
            script[index] = scriptOf(&parts)[index]
            index += 1
        }
        const region = regionOf(&parts)
        // (sr_ME is Cyrillic for collation: CLDR's parent of sr_Cyrl_ME.)
        if scriptLength == 0 && region.length > 0 && !(compareText(language, "sr") == 0 && compareText(region, "ME") == 0) {
            var own: [4]u8 = undefined
            const ownLength = likelyScript(language, &own)
            const length = joinParts(&name, language, "", region, "")
            scriptLength = likelyScript(joined(&name, length), &script)
            const scriptView: [*]const u8 = unsafe { @ptrCast([*]const u8, &script) }
            const ownView: [*]const u8 = unsafe { @ptrCast([*]const u8, &own) }
            if ownLength == scriptLength && compareText(scriptView[0..scriptLength], ownView[0..ownLength]) == 0 { scriptLength = 0 }
        }
        const scriptView: [*]const u8 = unsafe { @ptrCast([*]const u8, &script) }
        const scriptText = scriptView[0..scriptLength]
        // The locale and its truncations, up to one CLDR names a parent of.
        var parent: []const u8 = ""
        var level: usize = 0
        while level < 4 && parent.length == 0 {
            var length: usize = 0
            if level == 0 { length = joinParts(&name, language, scriptText, region, variantOf(&parts)) }
            if level == 1 { length = joinParts(&name, language, scriptText, region, "") }
            if level == 2 { length = joinParts(&name, language, scriptText, "", "") }
            if level == 3 { length = joinParts(&name, language, "", "", "") }
            addLink(chain, joined(&name, length))
            parent = collationParent(joined(&name, length))
            level += 1
        }
        if parent.length == 0 { break }
        var copy: [64]u8 = undefined
        index = 0
        while index < parent.length {
            copy[index] = parent[index]
            index += 1
        }
        const copyView = unsafe { @ptrCast([*]u8, &copy) }
        splitLocale(copyView[0..parent.length], &parts)
        language = languageOf(&parts)
        round += 1
    }
    addLink(chain, "root")
}

// The rules entry for `kind` of `locale` (its chain looked through);
// with `orDefault`, the default type's when the locale has no `kind`.
// The locale it was found in into `found` (when not 0).
pub fn findRulesIn(locale: []const u8, kind: []const u8, orDefault: bool, found: *[64]u8, foundLength: *usize) -> usize {
    var chain: Chain = undefined
    makeChain(locale, &chain)
    foundLength.* = 0
    var wanted = kind
    if wanted.length == 0 || (orDefault && wanted.length > 8 && compareText(wanted[0..8], "private-") == 0) { wanted = defaultTypeIn(&chain) }
    var attempt: usize = 0
    while attempt < 2 {
        var index: usize = 0
        while index < chain.count {
            const link = chainLink(&chain, index)
            const key = ruleEntry(link, wanted)
            if key != NOT_FOUND {
                var k: usize = 0
                while k < link.length && k < 64 {
                    found.*[k] = link[k]
                    k += 1
                }
                foundLength.* = k
                return key
            }
            index += 1
        }
        if !orDefault { break }
        wanted = defaultTypeIn(&chain)
        attempt += 1
    }
    return NOT_FOUND
}

pub fn findRules(locale: []const u8, kind: []const u8, orDefault: bool) -> usize {
    var found: [64]u8 = undefined
    var length: usize = 0
    return findRulesIn(locale, kind, orDefault, &found, &length)
}

// The default collation type along a chain.
fn defaultTypeIn(chain: *Chain) -> []const u8 {
    var index: usize = 0
    while index < chain.*.count {
        const kind = defaultOf(chainLink(chain, index))
        if kind.length > 0 { return kind }
        index += 1
    }
    return "standard"
}

pub fn defaultType(locale: []const u8) -> []const u8 {
    var chain: Chain = undefined
    makeChain(locale, &chain)
    return defaultTypeIn(&chain)
}

// The collation types of a locale: its default first, then those of its
// chain (the root's last), each once, the private ones not.
pub fn typesOf(locale: []const u8, out: *m.Bytes) -> void {
    var chain: Chain = undefined
    makeChain(locale, &chain)
    const first = defaultTypeIn(&chain)
    m.pushText(out, first)
    m.pushByte(out, 10)
    var index: usize = 0
    while index < chain.count {
        const link = chainLink(&chain, index)
        var key: usize = 0
        while key < data.RULES_COUNT {
            const name = ruleKeyAt(key)
            if name.length > link.length && name[link.length] == 47 && compareText(name[0..link.length], link) == 0 {
                const kind = name[link.length + 1..name.length]
                if !(kind.length > 8 && compareText(kind[0..8], "private-") == 0) && !listed(m.bytesText(out), kind) {
                    m.pushText(out, kind)
                    m.pushByte(out, 10)
                }
            }
            key += 1
        }
        index += 1
    }
    if !listed(m.bytesText(out), "standard") {
        m.pushText(out, "standard")
        m.pushByte(out, 10)
    }
}

// Whether `kind` is a line of `lines`.
pub fn listed(lines: []const u8, kind: []const u8) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index < lines.length {
        if lines[index] == 10 {
            if compareText(lines[start..index], kind) == 0 { return true }
            start = index + 1
        }
        index += 1
    }
    return false
}

// The BCP 47 collation type `kind` by its ICU name.
pub fn legacyType(kind: []const u8) -> []const u8 {
    if compareText(kind, "phonebk") == 0 { return "phonebook" }
    if compareText(kind, "trad") == 0 { return "traditional" }
    if compareText(kind, "dict") == 0 { return "dictionary" }
    if compareText(kind, "gb2312") == 0 { return "gb2312han" }
    return kind
}

// A language tag (`und-u-co-search`, `de`) as an ICU locale ID into
// `locale` and its collation type into `kind`; the ID's length.
fn tagLocale(tag: []const u8, locale: *[64]u8, kind: *[32]u8, kindLength: *usize) -> usize {
    var parts: Parts = undefined
    splitLocale(tag, &parts)
    var language = languageOf(&parts)
    if compareText(language, "und") == 0 { language = "root" }
    const length = joinParts(locale, language, scriptOf(&parts), regionOf(&parts), variantOf(&parts))
    kindLength.* = 0
    // -u-co-type
    var index: usize = 0
    while index + 6 <= tag.length {
        if (tag[index] == 45 || tag[index] == 95) && lowerByte(tag[index + 1]) == 99 && lowerByte(tag[index + 2]) == 111 && (tag[index + 3] == 45 || tag[index + 3] == 95) {
            // The type's subtags (three letters or more each).
            var end = index + 4
            var scan = index + 4
            while scan < tag.length {
                var stop = scan
                while stop < tag.length && tag[stop] != 45 && tag[stop] != 95 { stop += 1 }
                if stop - scan < 3 { break }
                end = stop
                scan = stop + 1
            }
            const value = legacyType(tag[index + 4..end])
            var k: usize = 0
            while k < value.length && k < 32 {
                kind.*[k] = lowerByte(value[k])
                k += 1
            }
            kindLength.* = k
            break
        }
        index += 1
    }
    if length == 0 {
        const root = "root"
        index = 0
        while index < 4 {
            locale.*[index] = root[index]
            index += 1
        }
        return 4
    }
    return length
}
