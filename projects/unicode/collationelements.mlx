// Collation elements (UTS #10) as the collators of collation.mlx compare
// them: those of the root collation (the table of uca/allkeys.txt, DUCET,
// whose order is CLDR's root collation) and those a tailoring
// (collationbuilder.mlx) gives its strings.
//
// An element here is two words:
//
//   first   the primary weight, 32 bits: a root primary P of the table as
//           P << 16, so that a tailoring has room for primaries between
//           two root ones; an implicit weight (Han, the scripts the table
//           names ranges for, unassigned code points) as one element,
//           its base << 16 | its offset << 1
//   second  secondary << 16 | case << 14 | tertiary << 2 | quaternary:
//           the root's secondaries S as S << 7 and tertiaries T as T << 6
//           (room between them too; the tertiaries of tertiary elements,
//           which only a tailoring makes, from TERTIARY_BOUNDARY on, above
//           all others, as ICU has them), the case bits as ICU has them (0
//           lower or uncased, 1 mixed, 2 upper), the quaternary weight a
//           tailoring's `<<<<` gives (0 to 3)
//
// A tailoring maps strings (in NFD, with a prefix the text must have
// before them, or none) to elements; the strings it does not map have
// the root's elements. The root's contractions are kept the same way.
// The root's script groups (space, punctuation, symbols, currency,
// digits, then the scripts in their order) are worked out once from the
// table and the characters' properties, for reordering and the variable
// top.
const tables = @import("./tables.mlx")
const m = @import("./memory.mlx")
const p = @import("./properties.mlx")
const rules = @import("./collationrules.mlx")

pub const COMMON_SECONDARY: u32 = 4096
pub const COMMON_TERTIARY: u32 = 128
pub const BEFORE_SECONDARY: u32 = 4032
pub const BEFORE_TERTIARY: u32 = 96
pub const TERTIARY_BOUNDARY: u32 = 2048
// The secondaries of the root's secondary elements begin here, above
// those of all primary elements (a tailoring's too).
pub const SECONDARY_BOUNDARY: u32 = 4224
// The table's variant secondaries (011E to 0126, after a primary) as the
// secondaries of their primaries: at the top of the room above the common
// one, above what a tailoring puts after the common secondary.
pub const VARIANT_SECONDARY: u32 = 4214
// The first word of an element a tailoring is still being built with:
// the second is then its node << 4 | case << 2 | strength.
pub const TEMPORARY: u32 = 4294967295
const NONE: u32 = 4294967295

pub fn lowerWord(secondary: u32, letterCase: u32, tertiary: u32, quaternary: u32) -> u32 { return (secondary << 16) | (letterCase << 14) | (tertiary << 2) | quaternary }
pub fn secondaryOf(low: u32) -> u32 { return low >> 16 }
pub fn caseOf(low: u32) -> u32 { return (low >> 14) & 3 }
pub fn tertiaryOf(low: u32) -> u32 { return (low >> 2) & 4095 }
pub fn quaternaryOf(low: u32) -> u32 { return low & 3 }

pub fn pushPair(out: *m.Buffer, high: u32, low: u32) -> void {
    m.push(out, high)
    m.push(out, low)
}

// ---------------------------------------------------------------------------
// The root's elements

fn record(c: i32) -> u32 {
    if c < 0 || c > 1114111 { return NONE }
    const code = @intCast(usize, c)
    const block = @intCast(usize, tables.COLLATION_INDEX[code >> 6])
    return tables.COLLATION_RECORDS[@intCast(usize, tables.COLLATION_BLOCKS[(block << 6) + (code & 63)])]
}

// The table's tertiary weights of capitals (and the like).
fn upperTertiary(t: u32) -> bool { return t == 8 || t == 9 || t == 10 || t == 11 || t == 12 || t == 14 || t == 17 || t == 18 || t == 29 }

// An element of the table (primary << 16 | secondary << 7 | tertiary << 2
// | variable) as a wide one.
fn pushTableElement(out: *m.Buffer, ce: u32) -> void {
    const primary = ce >> 16
    const tertiary = (ce >> 2) & 31
    const upper = primary != 0 && upperTertiary(tertiary)
    m.push(out, primary << 16)
    m.push(out, lowerWord(((ce >> 7) & 511) << 7, if upper { 2 } else { 0 }, tertiary << 6, 0))
}

fn pushTableElements(out: *m.Buffer, value: u32, ducet: bool) -> void {
    const offset = @intCast(usize, value >> 5)
    const count = @intCast(usize, value & 31)
    var index: usize = 0
    while index < count {
        const ce = tables.COLLATION_CES[offset + index]
        const primary = ce >> 16
        if primary >= 64256 && primary < 65472 && index + 1 < count {
            // An implicit weight the table spells out (a radical's: the
            // base, then the offset | 0x8000): one element here.
            const second = tables.COLLATION_CES[offset + index + 1]
            pushTableElement(out, ce)
            var implicit = (primary << 16) | (((second >> 16) & 32767) << 1)
            if !ducet && primary >= 64320 && primary < 64448 {
                // Han: its place in the root's radical-stroke order.
                const origin: u32 = if primary < 64384 { 64320 } else { 64384 }
                implicit = hanPrimary(((primary - origin) << 15) | ((second >> 16) & 32767))
            }
            m.setAt(out, out.*.length - 2, implicit)
            index += 2
            continue
        }
        if !ducet && primary != 0 && index + 1 < count {
            // A primary with one of the table's variant secondaries after it
            // (U+00F0 ð: d's primary, then 011E): one element whose
            // secondary is above the common one, as CLDR's root has it.
            const second = tables.COLLATION_CES[offset + index + 1]
            const variant = (second >> 7) & 511
            if (second >> 16) == 0 && variant >= 286 && variant <= 294 {
                pushTableElement(out, ce)
                m.setAt(out, out.*.length - 1, (m.at(out, out.*.length - 1) & 65535) | ((VARIANT_SECONDARY + (variant - 286)) << 16))
                index += 2
                continue
            }
        }
        pushTableElement(out, ce)
        index += 1
    }
}

// The Han characters' places in the root's radical-stroke order (CLDR's
// root, collationrules.mlx's HAN_RANGES), by code point in three blocks
// (U+3400..U+9FFF, U+F900..U+FAFF, U+20000..U+3347F): place + 1, 0 for
// none.
var hanPlaces: usize = 0
const HAN_PLACES: usize = 107136

fn hanSlot(code: u32) -> usize {
    if code >= 13312 && code < 40960 { return @intCast(usize, code - 13312) }
    if code >= 63744 && code < 64256 { return 27648 + @intCast(usize, code - 63744) }
    if code >= 131072 && code < 210048 { return 28160 + @intCast(usize, code - 131072) }
    return HAN_PLACES
}

fn buildHanPlaces() -> void {
    hanPlaces = m.alloc(HAN_PLACES * 4)
    var place: u32 = 1
    var index: usize = 0
    while index < rules.HAN_RANGE_COUNT {
        var code = rules.HAN_RANGES[index * 2]
        while code <= rules.HAN_RANGES[index * 2 + 1] {
            const slot = hanSlot(code)
            if slot < HAN_PLACES { m.put32(hanPlaces + slot * 4, place) }
            place += 1
            code += 1
        }
        index += 1
    }
}

// The primary of a Han character: by its place in the radical-stroke
// order, from the first Han implicit weight on (as the table's would be,
// in the same range).
fn hanPrimary(code: u32) -> u32 {
    if hanPlaces == 0 { ensureRoot() }
    const slot = hanSlot(code)
    const place = if slot < HAN_PLACES { m.get32(hanPlaces + slot * 4) } else { 0 }
    if place == 0 { return ((64384 + (code >> 15)) << 16) | ((code & 32767) << 1) }
    const rank = place - 1
    return ((64320 + (rank >> 15)) << 16) | ((rank & 32767) << 1)
}

// The implicit primary of a code point the table does not list; Han
// characters in the radical-stroke order unless `ducet` (the table's,
// code point order).
pub fn implicitPrimary(c: i32, ducet: bool) -> u32 {
    const code = @intCast(u32, if c < 0 { 65533 } else { c })
    var index: usize = 0
    while index < tables.IMPLICIT_FIRST.length {
        if code >= tables.IMPLICIT_FIRST[index] && code <= tables.IMPLICIT_LAST[index] {
            // (Counted from the first range of the same base: Tangut's
            // supplement follows Tangut.)
            const base = tables.IMPLICIT_BASE[index]
            var origin = tables.IMPLICIT_FIRST[index]
            var other: usize = 0
            while other < tables.IMPLICIT_FIRST.length {
                if tables.IMPLICIT_BASE[other] == base && tables.IMPLICIT_FIRST[other] < origin { origin = tables.IMPLICIT_FIRST[other] }
                other += 1
            }
            return (base << 16) | (((code - origin) & 32767) << 1)
        }
        index += 1
    }
    var base: u32 = 64448
    if p.binary(@intCast(i32, code), 29) {
        if !ducet { return hanPrimary(code) }
        base = if (code >= 19968 && code <= 40959) || (code >= 63744 && code <= 64255) { 64320 } else { 64384 }
    }
    return ((base + (code >> 15)) << 16) | ((code & 32767) << 1)
}

// The root's elements of the one code point `c` (no contraction).
pub fn pushSingle(out: *m.Buffer, c: u32, ducet: bool) -> void {
    const value = record(@intCast(i32, c))
    if value == NONE {
        m.push(out, implicitPrimary(@intCast(i32, c), ducet))
        m.push(out, lowerWord(COMMON_SECONDARY, 0, COMMON_TERTIARY, 0))
    } else {
        pushTableElements(out, value, ducet)
    }
}

// The primary weight of the root's (single) element for `c`; 0 when it
// has none or several.
pub fn singlePrimary(c: u32) -> u32 {
    var ces = m.buffer()
    pushSingle(&ces, c, false)
    const primary = if ces.length == 2 { m.at(&ces, 0) } else { 0 }
    m.dispose(&ces)
    return primary
}

// ---------------------------------------------------------------------------
// Tailorings: mappings of strings to elements, by the strings' first code
// point (an open-addressed table of code + 1 and the first entry + 1).
// An entry is ENTRY_WORDS words: the next entry of the same code + 1, the
// prefix (start, length in `codes`), the rest of the string after its
// first code point (start, length), the elements (start in `ces`, count
// of pairs).

const ENTRY_WORDS: usize = 7

pub const Tailoring = struct {
    slots: usize
    slotCount: usize
    slotsUsed: usize
    entries: m.Buffer
    codes: m.Buffer
    ces: m.Buffer
    // The code points whose root contractions do not apply, sorted.
    suppressed: m.Buffer
    // The attributes the rules set (by UColAttribute; -1 when they do not).
    settings: [8]i32
    // The rules' maxVariable (a group 0 to 3), -1 when they do not set it.
    maxVariable: i32
    // The rules' reordering (script codes and groups).
    reorder: m.Buffer
    // The rules as UTF-16 (for ucol_getRules), and their length in units.
    rulesUnits: usize
    rulesLength: usize
    // Collators that hold it (a tailoring of a locale is kept).
    references: u32
    permanent: bool
}

pub fn tailoringAt(address: usize) -> *Tailoring { unsafe { return @ptrFromInt(*Tailoring, address) } }

pub fn newTailoring() -> usize {
    const address = m.alloc(@sizeOf(Tailoring))
    const t = tailoringAt(address)
    t.*.slotCount = 64
    t.*.slots = m.alloc(64 * 8)
    t.*.slotsUsed = 0
    t.*.entries = m.buffer()
    t.*.codes = m.buffer()
    t.*.ces = m.buffer()
    t.*.suppressed = m.buffer()
    var index: usize = 0
    while index < 8 {
        t.*.settings[index] = -1
        index += 1
    }
    t.*.maxVariable = -1
    t.*.reorder = m.buffer()
    t.*.rulesUnits = 0
    t.*.rulesLength = 0
    t.*.references = 1
    t.*.permanent = false
    return address
}

pub fn disposeTailoring(address: usize) -> void {
    const t = tailoringAt(address)
    m.release(t.*.slots)
    m.dispose(&t.*.entries)
    m.dispose(&t.*.codes)
    m.dispose(&t.*.ces)
    m.dispose(&t.*.suppressed)
    m.dispose(&t.*.reorder)
    m.release(t.*.rulesUnits)
    m.release(address)
}

fn hashOf(c: u32) -> usize { return @intCast(usize, (c *% 2654435761) >> 7) }

// The slot of `c` (where it is or would go).
fn slotOf(t: *Tailoring, c: u32) -> usize {
    const mask = t.*.slotCount - 1
    var slot = hashOf(c) & mask
    while true {
        const key = m.get32(t.*.slots + slot * 8)
        if key == 0 || key == c + 1 { return slot }
        slot = (slot + 1) & mask
    }
    return slot
}

// The first entry of `c` + 1, 0 when there is none.
pub fn firstEntry(t: *Tailoring, c: u32) -> u32 {
    const slot = slotOf(t, c)
    if m.get32(t.*.slots + slot * 8) == 0 { return 0 }
    return m.get32(t.*.slots + slot * 8 + 4)
}

fn setFirstEntry(t: *Tailoring, c: u32, entry: u32) -> void {
    if (t.*.slotsUsed + 1) * 2 > t.*.slotCount {
        // Grow: every code again in a table twice as large.
        const oldSlots = t.*.slots
        const oldCount = t.*.slotCount
        t.*.slotCount = oldCount * 2
        t.*.slots = m.alloc(t.*.slotCount * 8)
        var index: usize = 0
        while index < oldCount {
            const key = m.get32(oldSlots + index * 8)
            if key != 0 {
                const slot = slotOf(t, key - 1)
                m.put32(t.*.slots + slot * 8, key)
                m.put32(t.*.slots + slot * 8 + 4, m.get32(oldSlots + index * 8 + 4))
            }
            index += 1
        }
        m.release(oldSlots)
    }
    const slot = slotOf(t, c)
    if m.get32(t.*.slots + slot * 8) == 0 { t.*.slotsUsed += 1 }
    m.put32(t.*.slots + slot * 8, c + 1)
    m.put32(t.*.slots + slot * 8 + 4, entry)
}

pub fn entryWord(t: *Tailoring, entry: u32, word: usize) -> u32 { return m.at(&t.*.entries, @intCast(usize, entry - 1) * ENTRY_WORDS + word) }
fn setEntryWord(t: *Tailoring, entry: u32, word: usize, value: u32) -> void { m.setAt(&t.*.entries, @intCast(usize, entry - 1) * ENTRY_WORDS + word, value) }

pub fn entryNext(t: *Tailoring, entry: u32) -> u32 { return entryWord(t, entry, 0) }
pub fn prefixLength(t: *Tailoring, entry: u32) -> usize { return @intCast(usize, entryWord(t, entry, 2)) }
pub fn prefixCode(t: *Tailoring, entry: u32, index: usize) -> u32 { return m.at(&t.*.codes, @intCast(usize, entryWord(t, entry, 1)) + index) }
pub fn restLength(t: *Tailoring, entry: u32) -> usize { return @intCast(usize, entryWord(t, entry, 4)) }
pub fn restCode(t: *Tailoring, entry: u32, index: usize) -> u32 { return m.at(&t.*.codes, @intCast(usize, entryWord(t, entry, 3)) + index) }
pub fn elementStart(t: *Tailoring, entry: u32) -> usize { return @intCast(usize, entryWord(t, entry, 5)) }
pub fn elementCount(t: *Tailoring, entry: u32) -> usize { return @intCast(usize, entryWord(t, entry, 6)) }

// Whether entry `entry` has prefix `prefix` and string `string`.
fn entryIs(t: *Tailoring, entry: u32, prefix: *m.Buffer, string: *m.Buffer) -> bool {
    if prefixLength(t, entry) != prefix.*.length || restLength(t, entry) + 1 != string.*.length { return false }
    var index: usize = 0
    while index < prefix.*.length {
        if prefixCode(t, entry, index) != m.at(prefix, index) { return false }
        index += 1
    }
    index = 1
    while index < string.*.length {
        if restCode(t, entry, index - 1) != m.at(string, index) { return false }
        index += 1
    }
    return true
}

// Maps `string` (NFD, not empty) after `prefix` to the pairs `ces` (a
// mapping it had before is replaced).
pub fn addEntry(t: *Tailoring, prefix: *m.Buffer, string: *m.Buffer, ces: *m.Buffer) -> void {
    const c = m.at(string, 0)
    const ceStart = @intCast(u32, t.*.ces.length)
    var index: usize = 0
    while index < ces.*.length {
        m.push(&t.*.ces, m.at(ces, index))
        index += 1
    }
    const ceCount = @intCast(u32, ces.*.length / 2)
    var entry = firstEntry(t, c)
    var last: u32 = 0
    while entry != 0 {
        if entryIs(t, entry, prefix, string) {
            setEntryWord(t, entry, 5, ceStart)
            setEntryWord(t, entry, 6, ceCount)
            return
        }
        last = entry
        entry = entryNext(t, entry)
    }
    const prefixStart = @intCast(u32, t.*.codes.length)
    index = 0
    while index < prefix.*.length {
        m.push(&t.*.codes, m.at(prefix, index))
        index += 1
    }
    const restStart = @intCast(u32, t.*.codes.length)
    index = 1
    while index < string.*.length {
        m.push(&t.*.codes, m.at(string, index))
        index += 1
    }
    const fresh = @intCast(u32, t.*.entries.length / ENTRY_WORDS) + 1
    m.push(&t.*.entries, 0)
    m.push(&t.*.entries, prefixStart)
    m.push(&t.*.entries, @intCast(u32, prefix.*.length))
    m.push(&t.*.entries, restStart)
    m.push(&t.*.entries, @intCast(u32, string.*.length - 1))
    m.push(&t.*.entries, ceStart)
    m.push(&t.*.entries, ceCount)
    if last == 0 { setFirstEntry(t, c, fresh) } else { setEntryWord(t, last, 0, fresh) }
}

pub fn isSuppressed(t: *Tailoring, c: u32) -> bool {
    var low: usize = 0
    var high = t.*.suppressed.length
    while low < high {
        const middle = (low + high) / 2
        const value = m.at(&t.*.suppressed, middle)
        if value == c { return true }
        if value < c { low = middle + 1 } else { high = middle }
    }
    return false
}

// Adds `c` to the code points whose root contractions do not apply.
pub fn suppress(t: *Tailoring, c: u32) -> void {
    if isSuppressed(t, c) { return }
    m.push(&t.*.suppressed, c)
    var at = t.*.suppressed.length - 1
    while at > 0 && m.at(&t.*.suppressed, at - 1) > c {
        m.setAt(&t.*.suppressed, at, m.at(&t.*.suppressed, at - 1))
        at -= 1
    }
    m.setAt(&t.*.suppressed, at, c)
}

// ---------------------------------------------------------------------------
// The root, worked out once: its contractions as a tailoring's entries,
// which primaries it uses, its script groups and special positions.

var rootLock: u32 = 0
var rootReady: u32 = 0
// The table's contractions as a tailoring's entries; and CLDR's root's:
// those and the few CLDR adds.
var tableContractions: usize = 0
var rootContractions: usize = 0
// A bit for each 16-bit primary the table uses.
var usedPrimaries: usize = 0
// The groups: their first primaries (32 bits) and their codes (a
// reordering group 0x1000 to 0x1004 or a script), in the root's order;
// the primaries from GROUP_LIMIT on (unassigned code points, U+FFFD) are
// in none and stay where they are.
var groupStarts = m.Buffer.{ .address = 0, .length = 0, .capacity = 0 }
var groupCodes = m.Buffer.{ .address = 0, .length = 0, .capacity = 0 }
pub const GROUP_LIMIT: u32 = 4223664128
// The first primary of the Han group: [last regular] (as ICU has it, the
// Han group's first primary), with the gap up to the implicit weights.
pub const HAN_FIRST: u32 = 4211277824
// The weights of the root's secondary elements (primary ignorable) at
// their lowest and highest, and their tertiaries.
var firstSecondary: u32 = 0
var firstSecondaryTertiary: u32 = 0
var lastSecondary: u32 = 0
var lastSecondaryTertiary: u32 = 0
// The last primary the table marks variable (`*`).
var ducetVariableTop: u32 = 0

pub const GROUP_SPACE: i32 = 4096
pub const GROUP_PUNCTUATION: i32 = 4097
pub const GROUP_SYMBOL: i32 = 4098
pub const GROUP_CURRENCY: i32 = 4099
pub const GROUP_DIGIT: i32 = 4100
const SCRIPT_COMMON: u32 = 0
const SCRIPT_INHERITED: u32 = 1
const SCRIPT_HAN: i32 = 17
const SCRIPT_HIRAGANA: u32 = 20
const SCRIPT_KATAKANA: u32 = 22
pub const SCRIPT_UNKNOWN: i32 = 103

pub fn ensureRoot() -> void {
    if @atomicLoad(u32, &rootReady, acquire) != 0 { return }
    while @atomicRmw(u32, &rootLock, xchg, 1, acquire) != 0 {}
    if rootReady == 0 {
        buildRoot()
        @atomicStore(u32, &rootReady, 1, release)
    }
    @atomicStore(u32, &rootLock, 0, release)
}

fn markUsed(primary16: u32) -> void {
    const index = @intCast(usize, primary16 >> 3)
    m.put8(usedPrimaries + index, m.get8(usedPrimaries + index) | (@intCast(u8, 1) << @intCast(u3, primary16 & 7)))
}

pub fn isUsedPrimary(primary16: u32) -> bool {
    return (m.get8(usedPrimaries + @intCast(usize, primary16 >> 3)) >> @intCast(u3, primary16 & 7)) & 1 != 0
}

fn isLetterCategory(category: u32) -> bool { return category == 1 || category == 2 || category == 3 || category == 5 }
fn isPunctuationCategory(category: u32) -> bool { return (category >= 19 && category <= 23) || category == 28 || category == 29 }
fn isSymbolCategory(category: u32) -> bool { return category == 24 || category == 26 || category == 27 }

fn addGroup(start: u32, code: i32) -> void {
    if groupCodes.length > 0 && @bitCast(i32, m.at(&groupCodes, groupCodes.length - 1)) == code { return }
    m.push(&groupStarts, start)
    m.push(&groupCodes, @bitCast(u32, code))
}

fn buildRoot() -> void {
    buildHanPlaces()
    usedPrimaries = m.alloc(8192)
    // Every primary of the table's elements.
    var index: usize = 0
    while index < tables.COLLATION_CES.length {
        const ce = tables.COLLATION_CES[index]
        const primary = ce >> 16
        if (ce & 1) != 0 && (primary << 16) > ducetVariableTop { ducetVariableTop = primary << 16 }
        // (Not the second halves of implicit weights the table spells out.)
        if primary != 0 && (ce & 65532) != 0 { markUsed(primary) }
        if primary == 0 && ((ce >> 7) & 511) != 0 && ((ce >> 7) & 511) < 286 {
            const secondary = ((ce >> 7) & 511) << 7
            const tertiary = ((ce >> 2) & 31) << 6
            if firstSecondary == 0 || secondary < firstSecondary {
                firstSecondary = secondary
                firstSecondaryTertiary = tertiary
            }
            if secondary > lastSecondary {
                lastSecondary = secondary
                lastSecondaryTertiary = tertiary
            }
        }
        index += 1
    }
    // The lowest code point whose (first) element has each primary.
    const firstOf = m.alloc(65536 * 4)
    // (Planes 0 to 3 and the variation selectors of plane 14: the rest is
    // unassigned or private use.)
    var code: u32 = 0
    while code < 1114112 {
        if code == 262144 { code = 917504 }
        if code == 918000 { break }
        const value = record(@intCast(i32, code))
        if value != NONE && (value & 31) != 0 {
            const primary = tables.COLLATION_CES[@intCast(usize, value >> 5)] >> 16
            if primary != 0 && m.get32(firstOf + @intCast(usize, primary) * 4) == 0 { m.put32(firstOf + @intCast(usize, primary) * 4, code + 1) }
        }
        code += 1
    }
    // The groups: space, punctuation, symbols, currency, digits while the
    // characters' categories say so, then the scripts of the letters.
    var state: i32 = GROUP_SPACE
    var current: i32 = GROUP_SPACE
    var primary: u32 = 1
    while primary < 64256 {
        if isUsedPrimary(primary) {
            const first = m.get32(firstOf + @intCast(usize, primary) * 4)
            if groupCodes.length == 0 { addGroup((primary << 16) - 32768, GROUP_SPACE) }
            if first != 0 {
                const c = @intCast(i32, first - 1)
                const category = p.category(c)
                if state < GROUP_DIGIT + 1 {
                    var next = state
                    if isPunctuationCategory(category) && state < GROUP_PUNCTUATION { next = GROUP_PUNCTUATION }
                    if isSymbolCategory(category) && state < GROUP_SYMBOL { next = GROUP_SYMBOL }
                    if category == 25 && state < GROUP_CURRENCY { next = GROUP_CURRENCY }
                    if category == 9 && state < GROUP_DIGIT { next = GROUP_DIGIT }
                    const script = p.script(c)
                    if isLetterCategory(category) && script != SCRIPT_COMMON && script != SCRIPT_INHERITED && state == GROUP_DIGIT { next = GROUP_DIGIT + 1 }
                    if next != state {
                        state = next
                        if state <= GROUP_DIGIT {
                            current = state
                            addGroup((primary << 16) - 32768, current)
                        }
                    }
                }
                if state > GROUP_DIGIT {
                    var script = p.script(c)
                    if script == SCRIPT_HIRAGANA { script = SCRIPT_KATAKANA }
                    if script != SCRIPT_COMMON && script != SCRIPT_INHERITED && @bitCast(i32, script) != current {
                        current = @bitCast(i32, script)
                        addGroup((primary << 16) - 32768, current)
                    }
                }
            }
        }
        primary += 1
    }
    // The scripts the table gives implicit weights of their own (before
    // Han), then Han from its first primary.
    var base: u32 = 64256
    while base < 64259 {
        var range: usize = 0
        while range < tables.IMPLICIT_FIRST.length {
            if tables.IMPLICIT_BASE[range] == base {
                addGroup((base << 16) - 32768, @bitCast(i32, p.script(@intCast(i32, tables.IMPLICIT_FIRST[range]))))
                break
            }
            range += 1
        }
        base += 1
    }
    addGroup(HAN_FIRST, SCRIPT_HAN)
    m.release(firstOf)
    // The root's contractions as entries.
    tableContractions = newTailoring()
    addTableContractions(tailoringAt(tableContractions), true)
    rootContractions = newTailoring()
    const t = tailoringAt(rootContractions)
    addTableContractions(t, false)
    var string = m.buffer()
    var prefix = m.buffer()
    var ces = m.buffer()
    // CLDR's root: Tibetan subjoined RA and LA with the vowel signs AA,
    // AA + I, II, AA + U, UU as contractions of their own (their elements
    // those of their parts), so that the RA's and LA's contractions with
    // the reversed vowel signs do not take them apart.
    // (Each vowel sequence ended by a 0.)
    const vowels = [12]u32{ 3953, 0, 3953, 3954, 0, 3955, 0, 3953, 3956, 0, 3957, 0 }
    var letter: u32 = 4018
    while letter <= 4019 {
        var vowel: usize = 0
        while vowel < 12 {
            string.length = 0
            ces.length = 0
            m.push(&string, letter)
            m.push(&string, vowels[vowel])
            if vowels[vowel + 1] != 0 { m.push(&string, vowels[vowel + 1]) }
            pushTableElements(&ces, record(@intCast(i32, letter)), false)
            if string.length == 2 {
                pushTableElements(&ces, record(@intCast(i32, vowels[vowel])), false)
            } else {
                // AA + I, AA + U: the table's contractions.
                var rest = m.buffer()
                m.push(&rest, vowels[vowel + 1])
                const entry = findRest(t, firstEntry(t, vowels[vowel]), 0, &rest)
                m.dispose(&rest)
                var k: usize = 0
                while entry != 0 && k < elementCount(t, entry) * 2 {
                    m.push(&ces, m.at(&t.*.ces, elementStart(t, entry) + k))
                    k += 1
                }
            }
            addEntry(t, &prefix, &string, &ces)
            vowel += if vowels[vowel + 1] != 0 { 3 } else { 2 }
        }
        letter += 1
    }
    // U+FDD1 and a character of a reordering group: the group's first
    // primary, as CLDR's root has them (`&[before 1]\uFDD1€`, before the
    // currency symbols).
    const samples = [5]u32{ 160, 8220, 9786, 8364, 52 }
    var group: usize = 0
    while group < 5 {
        const index = groupOf(GROUP_SPACE + @intCast(i32, group))
        if index < groupStarts.length {
            string.length = 0
            ces.length = 0
            m.push(&string, 64977)
            m.push(&string, samples[group])
            pushPair(&ces, m.at(&groupStarts, index), lowerWord(COMMON_SECONDARY, 0, COMMON_TERTIARY, 0))
            addEntry(t, &prefix, &string, &ces)
        }
        group += 1
    }
    m.dispose(&string)
    m.dispose(&ces)
}

fn addTableContractions(t: *Tailoring, ducet: bool) -> void {
    var string = m.buffer()
    var prefix = m.buffer()
    var ces = m.buffer()
    var index: usize = 0
    while index < tables.CONTRACTION_FIRST.length {
        string.length = 0
        ces.length = 0
        m.push(&string, tables.CONTRACTION_FIRST[index])
        const info = tables.CONTRACTION_INFO[index]
        var at: usize = 0
        while at < @intCast(usize, info & 255) {
            m.push(&string, tables.CONTRACTION_CODES[@intCast(usize, info >> 8) + at])
            at += 1
        }
        pushTableElements(&ces, tables.CONTRACTION_CES[index], ducet)
        addEntry(t, &prefix, &string, &ces)
        index += 1
    }
    m.dispose(&string)
    m.dispose(&ces)
}

pub fn tableVariableTop() -> u32 {
    ensureRoot()
    return ducetVariableTop
}

pub fn rootContractionsOf(c: u32) -> u32 { return firstEntry(tailoringAt(rootContractions), c) }
pub fn rootTailoring() -> *Tailoring { return tailoringAt(rootContractions) }

pub fn groupCount() -> usize { return groupStarts.length }
pub fn groupStart(index: usize) -> u32 { return m.at(&groupStarts, index) }
pub fn groupLimit(index: usize) -> u32 { return if index + 1 < groupStarts.length { m.at(&groupStarts, index + 1) } else { GROUP_LIMIT } }
pub fn groupCode(index: usize) -> i32 { return @bitCast(i32, m.at(&groupCodes, index)) }

// The group of a script or reordering code (Hiragana is Katakana's;
// Hans and Hant are Han); groupCount() when there is none.
pub fn groupOf(code: i32) -> usize {
    var wanted = code
    if wanted == @bitCast(i32, SCRIPT_HIRAGANA) || wanted == 54 { wanted = @bitCast(i32, SCRIPT_KATAKANA) }
    if wanted == 73 || wanted == 74 { wanted = SCRIPT_HAN }
    var index: usize = 0
    while index < groupStarts.length {
        if groupCode(index) == wanted { return index }
        index += 1
    }
    return groupStarts.length
}

// The last primary of reordering group `code` (space to currency), the
// variable top of that maxVariable.
pub fn groupLastPrimary(code: i32) -> u32 {
    ensureRoot()
    const index = groupOf(code)
    if index >= groupStarts.length { return 0 }
    return groupLimit(index) - 1
}

// The first primary of the group after the one `primary` is in (a
// group begins halfway into the gap before its first root primary, as
// ICU's groups begin with a boundary primary of their own).
fn nextGroupStart(primary: u32) -> u32 {
    var index: usize = 0
    while index < groupStarts.length {
        if m.at(&groupStarts, index) > primary { return m.at(&groupStarts, index) }
        index += 1
    }
    return if primary < GROUP_LIMIT { GROUP_LIMIT } else { 4294967295 }
}

fn isGroupStart(primary: u32) -> bool {
    var index: usize = 0
    while index < groupStarts.length {
        if m.at(&groupStarts, index) == primary { return true }
        index += 1
    }
    return false
}

// The root primary after `primary` (32 bits): the next one the table
// uses, the next implicit weight, or the end of the gap before Han; not
// beyond the start of the next group.
pub fn primaryAfter(primary: u32) -> u32 {
    ensureRoot()
    const high = primary >> 16
    var next: u32 = 0
    if high >= 64256 {
        if primary >= HAN_FIRST && primary < 4215275520 { return 4215275520 }
        next = (primary & 4294967294) + 2
    } else {
        var after = high + 1
        while after < 64256 && !isUsedPrimary(after) { after += 1 }
        next = after << 16
    }
    const limit = nextGroupStart(primary)
    return if limit < next { limit } else { next }
}

// The root primary before `primary`: 0 when there is none; for the first
// of a group, the group's start.
pub fn primaryBefore(primary: u32) -> u32 {
    ensureRoot()
    if (primary & 65535) == 0 && primary >= 32768 && isGroupStart(primary - 32768) { return primary - 32768 }
    const high = primary >> 16
    if high >= 64256 {
        if (primary & 65535) >= 2 { return (primary & 4294967294) - 2 }
        if primary == HAN_FIRST { return lastRegularPrimary() }
        return (high - 1) << 16
    }
    var previous = high
    if (primary & 65535) != 0 { return high << 16 }
    while previous > 1 {
        previous -= 1
        if isUsedPrimary(previous) { return previous << 16 }
    }
    return 0
}

fn lastRegularPrimary() -> u32 {
    var high: u32 = 64255
    while high > 1 && !isUsedPrimary(high) { high -= 1 }
    return high << 16
}

pub fn firstPrimary() -> u32 {
    ensureRoot()
    var high: u32 = 1
    while high < 64256 && !isUsedPrimary(high) { high += 1 }
    return high << 16
}

// The last root primary below `limit` (32 bits).
pub fn lastPrimaryBelow(limit: u32) -> u32 {
    ensureRoot()
    var high = limit >> 16
    if (limit & 65535) == 0 { high -= 1 }
    while high > 1 && !isUsedPrimary(high) { high -= 1 }
    return high << 16
}

// The first root primary at or above `start`.
pub fn firstPrimaryFrom(start: u32) -> u32 {
    ensureRoot()
    var high = start >> 16
    if (start & 65535) != 0 { high += 1 }
    while high < 64256 && !isUsedPrimary(high) { high += 1 }
    return high << 16
}

pub fn firstSecondaryElement() -> u32 {
    ensureRoot()
    return lowerWord(firstSecondary, 0, firstSecondaryTertiary, 0)
}

pub fn lastSecondaryElement() -> u32 {
    ensureRoot()
    return lowerWord(lastSecondary, 0, lastSecondaryTertiary, 0)
}

// ---------------------------------------------------------------------------
// The elements of a text

// Whether the code points before `at` in `text` end with entry `entry`'s
// prefix.
fn prefixMatches(t: *Tailoring, entry: u32, text: *m.Buffer, at: usize) -> bool {
    const length = prefixLength(t, entry)
    if length > at { return false }
    var index: usize = 0
    while index < length {
        if m.at(text, at - length + index) != prefixCode(t, entry, index) { return false }
        index += 1
    }
    return true
}

// The entry of `t` from `first` on with the same prefix as entry `like`
// and the rest `rest`, + 1 (0 when there is none).
fn findRest(t: *Tailoring, first: u32, like: u32, rest: *m.Buffer) -> u32 {
    const likePrefix = if like == 0 { 0 } else { prefixLength(t, like) }
    var entry = first
    while entry != 0 {
        if restLength(t, entry) == rest.*.length && prefixLength(t, entry) == likePrefix {
            var same = true
            var index: usize = 0
            while index < rest.*.length {
                if restCode(t, entry, index) != m.at(rest, index) {
                    same = false
                    break
                }
                index += 1
            }
            index = 0
            while same && index < likePrefix {
                if prefixCode(t, entry, index) != prefixCode(t, like, index) { same = false }
                index += 1
            }
            if same { return entry }
        }
        entry = entryNext(t, entry)
    }
    return 0
}

// What elements() takes for the root as the table has it (DUCET: Han in
// code point order) rather than as CLDR's root.
pub const DUCET: usize = 1

// The elements (pairs) of the code points `text` (in NFD) into `out`, by
// tailoring `source` (0: the root alone; DUCET): contractions matched longest
// first, then the unblocked non-starters that extend them; prefixes
// against the code points before.
pub fn elements(source: usize, text: *m.Buffer, out: *m.Buffer) -> void {
    ensureRoot()
    const ducet = source == DUCET
    const tailoring = if ducet { 0 } else { source }
    const count = text.*.length
    const consumed = m.alloc(count + 1)
    const root = tailoringAt(if ducet { tableContractions } else { rootContractions })
    var rest = m.buffer()
    var i: usize = 0
    while i < count {
        if m.get8(consumed + i) != 0 {
            i += 1
            continue
        }
        const c = m.at(text, i)
        var t = root
        var first: u32 = 0
        var rootAllowed = true
        if tailoring != 0 {
            const own = tailoringAt(tailoring)
            first = firstEntry(own, c)
            if first != 0 {
                t = own
            } else if own.*.suppressed.length > 0 && isSuppressed(own, c) {
                rootAllowed = false
            }
        }
        if first == 0 && rootAllowed { first = firstEntry(root, c) }
        if first == 0 {
            pushSingle(out, c, ducet)
            i += 1
            continue
        }
        // The longest entry that follows contiguously (and whose prefix
        // the text has before).
        var best: u32 = 0
        var bestLength: usize = 0
        var entry = first
        while entry != 0 {
            const length = restLength(t, entry)
            if (best == 0 || length > bestLength || (length == bestLength && prefixLength(t, entry) > prefixLength(t, best))) && i + length < count {
                var same = prefixLength(t, entry) == 0 || prefixMatches(t, entry, text, i)
                var at: usize = 0
                while same && at < length {
                    if m.get8(consumed + i + 1 + at) != 0 || restCode(t, entry, at) != m.at(text, i + 1 + at) { same = false }
                    at += 1
                }
                if same {
                    best = entry
                    bestLength = length
                }
            }
            entry = entryNext(t, entry)
        }
        rest.length = 0
        var at: usize = 0
        while at < bestLength {
            m.push(&rest, m.at(text, i + 1 + at))
            at += 1
        }
        // Then the unblocked non-starters that extend it.
        var k = i + 1 + bestLength
        var skipped: u32 = 0
        while k < count {
            if m.get8(consumed + k) != 0 {
                k += 1
                continue
            }
            const ccc = p.combiningClass(@intCast(i32, m.at(text, k)))
            if ccc == 0 { break }
            if ccc > skipped {
                m.push(&rest, m.at(text, k))
                const found = findRest(t, first, best, &rest)
                if found != 0 {
                    best = found
                    m.put8(consumed + k, 1)
                    k += 1
                    continue
                }
                rest.length -= 1
            }
            if ccc > skipped { skipped = ccc }
            k += 1
        }
        if best == 0 {
            pushSingle(out, c, ducet)
            i += 1
            continue
        }
        const start = elementStart(t, best)
        var index: usize = 0
        while index < elementCount(t, best) * 2 {
            m.push(out, m.at(&t.*.ces, start + index))
            index += 1
        }
        i += 1 + bestLength
    }
    m.dispose(&rest)
    m.release(consumed)
}
