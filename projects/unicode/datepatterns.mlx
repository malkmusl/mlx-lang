// Date patterns (UTS #35's field symbols) and formatting by them, as
// ICU's SimpleDateFormat formats: each run of a pattern letter is a
// field of the calendar (era, years, quarters, months, weeks, days,
// weekdays, day periods with the flexible ones of CLDR's dayPeriodRules,
// hours of each cycle, minutes, seconds and their fractions, time zones
// by timezonenames.mlx), its number in the locale's digits or its name
// in the locale's symbols (datesymbols.mlx); quoted text and the other
// characters stand for themselves. The fields' spans are kept with the
// text (for the field positions and formatToParts).
//
// Of the calendars' own: the Chinese calendars' cycle as a number (G),
// their years' cyclic names (U) and leap months by the locale's patterns
// ("{0}bis"); a Hebrew leap year's Adar as Adar II (its name; its number
// counts Adar I), the year of the Gregorian calendar a date is in (r),
// and the first year of a Japanese era as 元 (Gannen) where the pattern
// writes the year with 年 in Japanese.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const properties = @import("./properties.mlx")
const text = @import("./datetext.mlx")
const symbols = @import("./datesymbols.mlx")
const tz = @import("./timezonenames.mlx")
const calendars = @import("./calendar.mlx")

extern("c") fn ucal_get(cal: usize, field: i32, status: usize) -> i32
extern("c") fn ucal_getMillis(cal: usize, status: usize) -> f64
extern("c") fn ucal_getTimeZoneID(cal: usize, result: usize, resultLength: i32, status: usize) -> i32

const Text = text.Text

// UCalendarDateFields
pub const ERA: usize = 0
pub const YEAR: usize = 1
pub const MONTH: usize = 2
pub const WEEK_OF_YEAR: usize = 3
pub const WEEK_OF_MONTH: usize = 4
pub const DATE: usize = 5
pub const DAY_OF_YEAR: usize = 6
pub const DAY_OF_WEEK: usize = 7
pub const DAY_OF_WEEK_IN_MONTH: usize = 8
pub const AM_PM: usize = 9
pub const HOUR: usize = 10
pub const HOUR_OF_DAY: usize = 11
pub const MINUTE: usize = 12
pub const SECOND: usize = 13
pub const MILLISECOND: usize = 14
pub const ZONE_OFFSET: usize = 15
pub const DST_OFFSET: usize = 16
pub const YEAR_WOY: usize = 17
pub const DOW_LOCAL: usize = 18
pub const EXTENDED_YEAR: usize = 19
pub const JULIAN_DAY: usize = 20
pub const MILLISECONDS_IN_DAY: usize = 21
pub const IS_LEAP_MONTH: usize = 22
pub const CALENDAR_FIELD_COUNT: usize = 24

// UDateFormatField: the index of a letter in the pattern letters.
pub const ERA_FIELD: i32 = 0
pub const YEAR_FIELD: i32 = 1
pub const MONTH_FIELD: i32 = 2
pub const DATE_FIELD: i32 = 3
pub const HOUR_OF_DAY1_FIELD: i32 = 4
pub const HOUR_OF_DAY0_FIELD: i32 = 5
pub const MINUTE_FIELD: i32 = 6
pub const SECOND_FIELD: i32 = 7
pub const FRACTIONAL_SECOND_FIELD: i32 = 8
pub const DAY_OF_WEEK_FIELD: i32 = 9
pub const DAY_OF_YEAR_FIELD: i32 = 10
pub const DAY_OF_WEEK_IN_MONTH_FIELD: i32 = 11
pub const WEEK_OF_YEAR_FIELD: i32 = 12
pub const WEEK_OF_MONTH_FIELD: i32 = 13
pub const AM_PM_FIELD: i32 = 14
pub const HOUR1_FIELD: i32 = 15
pub const HOUR0_FIELD: i32 = 16
pub const TIMEZONE_FIELD: i32 = 17
pub const YEAR_WOY_FIELD: i32 = 18
pub const DOW_LOCAL_FIELD: i32 = 19
pub const EXTENDED_YEAR_FIELD: i32 = 20
pub const JULIAN_DAY_FIELD: i32 = 21
pub const MILLISECONDS_IN_DAY_FIELD: i32 = 22
pub const TIMEZONE_RFC_FIELD: i32 = 23
pub const TIMEZONE_GENERIC_FIELD: i32 = 24
pub const STANDALONE_DAY_FIELD: i32 = 25
pub const STANDALONE_MONTH_FIELD: i32 = 26
pub const QUARTER_FIELD: i32 = 27
pub const STANDALONE_QUARTER_FIELD: i32 = 28
pub const TIMEZONE_SPECIAL_FIELD: i32 = 29
pub const YEAR_NAME_FIELD: i32 = 30
pub const TIMEZONE_LOCALIZED_GMT_OFFSET_FIELD: i32 = 31
pub const TIMEZONE_ISO_FIELD: i32 = 32
pub const TIMEZONE_ISO_LOCAL_FIELD: i32 = 33
pub const RELATED_YEAR_FIELD: i32 = 34
pub const AM_PM_MIDNIGHT_NOON_FIELD: i32 = 35
pub const FLEXIBLE_DAY_PERIOD_FIELD: i32 = 36
pub const TIME_SEPARATOR_FIELD: i32 = 37
pub const FIELD_COUNT: i32 = 38

// The calendar field of each pattern letter (FIELD_NONE for b and B).
pub const FIELD_NONE: usize = 24
var LETTER_FIELDS: [38]usize = [38]usize{ 0, 1, 2, 5, 11, 11, 12, 13, 14, 7, 6, 8, 3, 4, 9, 10, 10, 15, 17, 18, 19, 20, 21, 15, 15, 18, 2, 2, 2, 15, 1, 15, 15, 15, 19, 24, 24, 24 }

pub fn calendarFieldOf(field: i32) -> usize {
    if field < 0 || field >= FIELD_COUNT { return FIELD_NONE }
    return LETTER_FIELDS[@intCast(usize, field)]
}

// The index of a pattern letter (its UDateFormatField), FIELD_COUNT for
// other characters.
pub fn letterIndex(c: u16) -> i32 {
    var k: usize = 0
    while k < symbols.PATTERN_CHARS.length {
        if @intCast(u16, symbols.PATTERN_CHARS[k]) == c { return @intCast(i32, k) }
        k += 1
    }
    return FIELD_COUNT
}

// The letters ICU takes as pattern syntax: A-Z and a-z.
pub fn isSyntax(c: u16) -> bool { return text.isLetter(c) }

// The level of a calendar field (bigger for smaller units) and of a
// pattern letter, as SimpleDateFormat ranks them.
var FIELD_LEVELS: [24]i32 = [24]i32{ 0, 10, 20, 20, 30, 30, 20, 30, 30, 40, 50, 50, 60, 70, 80, 0, 0, 10, 30, 10, 0, 40, 0, 0 }

pub fn fieldLevel(field: usize) -> i32 { return if field < 24 { FIELD_LEVELS[field] } else { 0 } }

pub fn letterLevel(c: u16) -> i32 {
    const levels = "A40 D20 E30 F30 G00 H50 K50 L20 M20 O00 Q20 S80 U10 V00 W30 X00 Y10 Z00 a40 c30 d30 e30 g00 h50 k50 l00 m60 q20 r10 s70 u10 v00 w20 x00 y10 z00 "
    var k: usize = 0
    while k + 3 < levels.length {
        if @intCast(u16, levels[k]) == c { return @intCast(i32, (levels[k + 1] - 48) * 10 + (levels[k + 2] - 48)) }
        k += 4
    }
    return -1
}

// Whether every field of PATTERN is bigger than calendar FIELD (so a
// difference in FIELD does not show).
pub fn isFieldUnitIgnored(pattern: *const Text, field: usize) -> bool {
    const level = fieldLevel(field)
    var inQuote = false
    var previous: u16 = 0
    var count: usize = 0
    var index: usize = 0
    while index < pattern.*.length {
        const c = text.at(pattern, index)
        if c != previous && count > 0 {
            if level <= letterLevel(previous) { return false }
            count = 0
        }
        if c == 39 {
            if index + 1 < pattern.*.length && text.at(pattern, index + 1) == 39 {
                index += 1
            } else {
                inQuote = !inQuote
            }
        } else if !inQuote && isSyntax(c) {
            previous = c
            count += 1
        }
        index += 1
    }
    if count > 0 && level <= letterLevel(previous) { return false }
    return true
}

// Whether a run of letter C of COUNT is numeric (DateFormatSymbols's
// isNumericField).
pub fn isNumeric(c: u16, count: usize) -> bool {
    const field = letterIndex(c)
    if field == FIELD_COUNT { return false }
    if field == MONTH_FIELD || field == STANDALONE_MONTH_FIELD || field == QUARTER_FIELD || field == STANDALONE_QUARTER_FIELD {
        return count <= 2
    }
    if field == DOW_LOCAL_FIELD || field == STANDALONE_DAY_FIELD { return count <= 2 }
    if field == ERA_FIELD || field == DAY_OF_WEEK_FIELD || field == AM_PM_FIELD || field == TIMEZONE_FIELD || field == TIMEZONE_RFC_FIELD {
        return false
    }
    if field == TIMEZONE_GENERIC_FIELD || field == TIMEZONE_SPECIAL_FIELD || field == YEAR_NAME_FIELD || field == TIMEZONE_LOCALIZED_GMT_OFFSET_FIELD {
        return false
    }
    if field == TIMEZONE_ISO_FIELD || field == TIMEZONE_ISO_LOCAL_FIELD || field == AM_PM_MIDNIGHT_NOON_FIELD || field == FLEXIBLE_DAY_PERIOD_FIELD {
        return false
    }
    if field == TIME_SEPARATOR_FIELD { return false }
    return true
}

// ---------------------------------------------------------------------------
// A calendar's fields at its moment.

pub const Fields = struct {
    values: [24]i32
    zone: tz.Zone
    // The calendar's type and the Gregorian year of its date (ICU's
    // related year).
    kind: u8
    relatedYear: i64
}

// The fields of calendar CAL (a UCalendar), false on failure.
pub fn readCalendar(cal: usize, f: *Fields, status: usize) -> bool {
    if m.failed(status) { return false }
    f.*.zone.date = ucal_getMillis(cal, status)
    var k: usize = 0
    while k < 24 {
        f.*.values[k] = ucal_get(cal, @intCast(i32, k), status)
        k += 1
    }
    if m.failed(status) { return false }
    f.*.kind = calendars.typeOf(cal)
    var ok = true
    f.*.relatedYear = calendars.relatedYear(cal, &ok)
    var units: [64]u16 = undefined
    var local: i32 = 0
    const length = ucal_getTimeZoneID(cal, @intFromPtr(&units), 64, @intFromPtr(&local))
    var n: usize = 0
    if local <= 0 && length > 0 && length < 64 {
        while n < @intCast(usize, length) {
            f.*.zone.id[n] = if units[n] < 128 { @intCast(u8, units[n]) } else { 63 }
            n += 1
        }
    }
    f.*.zone.idLength = n
    f.*.zone.kind = tz.canonicalType(tz.zoneIdOf(&f.*.zone))
    f.*.zone.raw = @intCast(i64, f.*.values[ZONE_OFFSET])
    f.*.zone.save = @intCast(i64, f.*.values[DST_OFFSET])
    return true
}

// ---------------------------------------------------------------------------
// The spans of the fields: (field, start, limit), empty ones too (a
// field position takes them; the iterators do not).

pub const Spans = struct {
    address: usize
    count: usize
    capacity: usize
}

pub fn spans() -> Spans { return Spans.{ .address = 0, .count = 0, .capacity = 0 } }

pub fn addSpan(s: *Spans, field: i32, start: usize, limit: usize) -> void {
    if s.*.count == s.*.capacity {
        const grown = if s.*.capacity < 16 { 16 } else { s.*.capacity * 2 }
        const address = m.grow(s.*.address, grown * 12)
        if address == 0 { return }
        s.*.address = address
        s.*.capacity = grown
    }
    const at = s.*.address + s.*.count * 12
    m.putI32(at, field)
    m.putI32(at + 4, @intCast(i32, start))
    m.putI32(at + 8, @intCast(i32, limit))
    s.*.count += 1
}

pub fn spanField(s: *const Spans, index: usize) -> i32 { return m.getI32(s.*.address + index * 12) }
pub fn spanStart(s: *const Spans, index: usize) -> i32 { return m.getI32(s.*.address + index * 12 + 4) }
pub fn spanLimit(s: *const Spans, index: usize) -> i32 { return m.getI32(s.*.address + index * 12 + 8) }

pub fn disposeSpans(s: *Spans) -> void {
    m.release(s.*.address)
    s.*.address = 0
    s.*.count = 0
    s.*.capacity = 0
}

// ---------------------------------------------------------------------------
// What formatting takes of a format.

pub const Formatter = struct {
    // datesymbols.Symbols, timezonenames.Format
    symbols: usize
    zones: usize
    // The calendar type of the symbols; whether the locale is Japanese
    // (for Gannen years).
    kind: u8
    japanese: bool
    digits: [10]u32
    minus: Text
    periods: symbols.DayPeriods
}

// UDisplayContext's capitalizations.
pub const CAPITALIZATION_NONE: i32 = 256
pub const CAPITALIZATION_MIDDLE: i32 = 257
pub const CAPITALIZATION_BEGINNING: i32 = 258
pub const CAPITALIZATION_UI_LIST: i32 = 259
pub const CAPITALIZATION_STANDALONE: i32 = 260

fn zeroPadding(fm: *Formatter, out: *Text, value: i64, minDigits: usize, maxDigits: usize) -> void {
    var magnitude: u64 = if value < 0 { @intCast(u64, -value) } else { @intCast(u64, value) }
    if value < 0 { text.pushText(out, &fm.*.minus) }
    var digits: [24]u8 = undefined
    var count: usize = 0
    while magnitude > 0 && count < 20 {
        digits[count] = @intCast(u8, magnitude % 10)
        magnitude /= 10
        count += 1
    }
    // The lowest maxDigits digits, at least minDigits.
    if count > maxDigits { count = maxDigits }
    var length = count
    if length < minDigits { length = minDigits }
    var k = length
    while k > 0 {
        k -= 1
        const d = if k < count { digits[k] } else { 0 }
        text.pushCodePoint(out, fm.*.digits[@intCast(usize, d)])
    }
}

fn appendSymbol(fm: *Formatter, out: *Text, set: usize, index: i64) -> void {
    if index < 0 || @intCast(usize, index) >= symbols.count(symbols.of(fm.*.symbols), set) { return }
    text.pushText(out, symbols.get(symbols.of(fm.*.symbols), set, @intCast(usize, index)))
}

// A name of SET in leap month pattern LEAP of the symbols (-1: none).
fn appendMonth(fm: *Formatter, out: *Text, set: usize, index: i64, leap: i64) -> void {
    const syms = symbols.of(fm.*.symbols)
    if index < 0 || @intCast(usize, index) >= symbols.count(syms, set) { return }
    const name = symbols.get(syms, set, @intCast(usize, index))
    if leap < 0 {
        text.pushText(out, name)
        return
    }
    text.format1(symbols.get(syms, symbols.LEAP_MONTH_PATTERNS, @intCast(usize, leap)), name, out)
}

fn isChineseType(kind: u8) -> bool { return kind == calendars.CHINESE || kind == calendars.DANGI }

fn hasPattern(pattern: *const Text, letter: u16) -> bool {
    var inQuote = false
    var k: usize = 0
    while k < pattern.*.length {
        const c = text.at(pattern, k)
        if c == 39 { inQuote = !inQuote }
        if !inQuote && c == letter { return true }
        k += 1
    }
    return false
}

const MAX_INT_COUNT: usize = 10

// One field: COUNT of letter C (written as OUTPUT in the spans).
fn subFormat(fm: *Formatter, out: *Text, c: u16, count: usize, capitalization: i32, fieldNumber: usize, output: u16, f: *const Fields, pattern: *const Text, s: *Spans) -> i32 {
    const index = letterIndex(c)
    const begin = out.*.length
    var usage = symbols.CAP_OTHER
    if index == FIELD_COUNT {
        // 'l' is ignored.
        if c != 108 { return 3 }
        return 0
    }
    const calendarField = LETTER_FIELDS[@intCast(usize, index)]
    var value: i64 = 0
    if calendarField < FIELD_NONE {
        value = @intCast(i64, f.*.values[calendarField])
        if index == RELATED_YEAR_FIELD { value = f.*.relatedYear }
    }
    const syms = symbols.of(fm.*.symbols)
    var cyclic = false
    if index == YEAR_NAME_FIELD {
        const names = symbols.count(syms, symbols.CYCLIC_YEARS_ABBREVIATED)
        cyclic = names > 0 && value <= @intCast(i64, names)
    }
    if index == ERA_FIELD && isChineseType(f.*.kind) {
        // The Chinese calendars' cycle of 60 years, as a number.
        zeroPadding(fm, out, value, 1, 9)
    } else if cyclic {
        appendSymbol(fm, out, symbols.CYCLIC_YEARS_ABBREVIATED, value - 1)
    } else if index == YEAR_FIELD && value == 1 && fm.*.japanese && f.*.kind == calendars.JAPANESE && hasPattern(pattern, 24180) {
        // Gannen, the era's first year, where the year is written 年.
        text.push(out, 20803)
    } else if index == ERA_FIELD {
        if count == 5 {
            appendSymbol(fm, out, symbols.NARROW_ERAS, value)
            usage = symbols.CAP_ERA_NARROW
        } else if count == 4 {
            appendSymbol(fm, out, symbols.ERA_NAMES, value)
            usage = symbols.CAP_ERA_WIDE
        } else {
            appendSymbol(fm, out, symbols.ERAS, value)
            usage = symbols.CAP_ERA_ABBREV
        }
    } else if index == YEAR_FIELD || index == YEAR_WOY_FIELD || index == YEAR_NAME_FIELD {
        if count == 2 {
            zeroPadding(fm, out, value, 2, 2)
        } else {
            zeroPadding(fm, out, value, count, MAX_INT_COUNT)
        }
    } else if index == MONTH_FIELD || index == STANDALONE_MONTH_FIELD {
        const format = index == MONTH_FIELD
        if f.*.kind == calendars.HEBREW {
            // Adar in a leap year by its other name (Adar II), the
            // months of a common year by number without Adar I.
            const leapYear = calendars.hebrewLeapYear(@intCast(i64, f.*.values[YEAR]))
            if leapYear && value == 6 && count >= 3 { value = 13 }
            if !leapYear && value >= 6 && count < 3 { value -= 1 }
        }
        // The leap month patterns: format wide, abbreviated, narrow,
        // stand-alone wide, abbreviated, narrow, numeric.
        var leap: i64 = -1
        if symbols.count(syms, symbols.LEAP_MONTH_PATTERNS) >= 7 && f.*.values[IS_LEAP_MONTH] != 0 {
            leap = if count == 5 { 2 } else if count == 4 { 0 } else if count == 3 { 1 } else { 6 }
            if !format && count >= 3 { leap += 3 }
        }
        if count == 5 {
            appendMonth(fm, out, if format { symbols.NARROW_MONTHS } else { symbols.STANDALONE_NARROW_MONTHS }, value, leap)
            usage = symbols.CAP_MONTH_NARROW
        } else if count == 4 {
            appendMonth(fm, out, if format { symbols.MONTHS } else { symbols.STANDALONE_MONTHS }, value, leap)
            usage = if format { symbols.CAP_MONTH_FORMAT } else { symbols.CAP_MONTH_STANDALONE }
        } else if count == 3 {
            appendMonth(fm, out, if format { symbols.SHORT_MONTHS } else { symbols.STANDALONE_SHORT_MONTHS }, value, leap)
            usage = if format { symbols.CAP_MONTH_FORMAT } else { symbols.CAP_MONTH_STANDALONE }
        } else if leap >= 0 {
            var number = text.empty()
            zeroPadding(fm, &number, value + 1, count, MAX_INT_COUNT)
            text.format1(symbols.get(syms, symbols.LEAP_MONTH_PATTERNS, @intCast(usize, leap)), &number, out)
            text.dispose(&number)
        } else {
            zeroPadding(fm, out, value + 1, count, MAX_INT_COUNT)
        }
    } else if index == HOUR_OF_DAY1_FIELD {
        zeroPadding(fm, out, if value == 0 { 24 } else { value }, count, MAX_INT_COUNT)
    } else if index == FRACTIONAL_SECOND_FIELD {
        const minDigits = if count > 3 { 3 } else { count }
        if count == 1 { value = value / 100 }
        if count == 2 { value = value / 10 }
        zeroPadding(fm, out, value, minDigits, MAX_INT_COUNT)
        if count > 3 { zeroPadding(fm, out, 0, count - 3, MAX_INT_COUNT) }
    } else if index == DOW_LOCAL_FIELD || index == DAY_OF_WEEK_FIELD {
        if index == DOW_LOCAL_FIELD && count < 3 {
            zeroPadding(fm, out, value, count, MAX_INT_COUNT)
        } else {
            const day = @intCast(i64, f.*.values[DAY_OF_WEEK])
            if count == 5 {
                appendSymbol(fm, out, symbols.NARROW_WEEKDAYS, day)
                usage = symbols.CAP_DAY_NARROW
            } else if count == 4 {
                appendSymbol(fm, out, symbols.WEEKDAYS, day)
                usage = symbols.CAP_DAY_FORMAT
            } else if count == 6 {
                appendSymbol(fm, out, symbols.SHORTER_WEEKDAYS, day)
                usage = symbols.CAP_DAY_FORMAT
            } else {
                appendSymbol(fm, out, symbols.SHORT_WEEKDAYS, day)
                usage = symbols.CAP_DAY_FORMAT
            }
        }
    } else if index == STANDALONE_DAY_FIELD {
        if count < 3 {
            zeroPadding(fm, out, value, 1, MAX_INT_COUNT)
        } else {
            const day = @intCast(i64, f.*.values[DAY_OF_WEEK])
            if count == 5 {
                appendSymbol(fm, out, symbols.STANDALONE_NARROW_WEEKDAYS, day)
                usage = symbols.CAP_DAY_NARROW
            } else if count == 4 {
                appendSymbol(fm, out, symbols.STANDALONE_WEEKDAYS, day)
                usage = symbols.CAP_DAY_STANDALONE
            } else if count == 6 {
                appendSymbol(fm, out, symbols.STANDALONE_SHORTER_WEEKDAYS, day)
                usage = symbols.CAP_DAY_STANDALONE
            } else {
                appendSymbol(fm, out, symbols.STANDALONE_SHORT_WEEKDAYS, day)
                usage = symbols.CAP_DAY_STANDALONE
            }
        }
    } else if index == AM_PM_FIELD {
        appendSymbol(fm, out, if count < 5 { symbols.AM_PMS } else { symbols.NARROW_AM_PMS }, value)
    } else if index == TIME_SEPARATOR_FIELD {
        appendSymbol(fm, out, symbols.TIME_SEPARATOR, 0)
    } else if index == HOUR1_FIELD {
        zeroPadding(fm, out, if value == 0 { 12 } else { value }, count, MAX_INT_COUNT)
    } else if index == TIMEZONE_FIELD || index == TIMEZONE_RFC_FIELD || index == TIMEZONE_GENERIC_FIELD || index == TIMEZONE_SPECIAL_FIELD || index == TIMEZONE_LOCALIZED_GMT_OFFSET_FIELD || index == TIMEZONE_ISO_FIELD || index == TIMEZONE_ISO_LOCAL_FIELD {
        var style: i32 = -1
        if index == TIMEZONE_FIELD {
            style = if count < 4 { tz.SPECIFIC_SHORT } else { tz.SPECIFIC_LONG }
            usage = if count < 4 { symbols.CAP_METAZONE_SHORT } else { symbols.CAP_METAZONE_LONG }
        } else if index == TIMEZONE_RFC_FIELD {
            style = if count < 4 { tz.ISO_BASIC_LOCAL_FULL } else if count == 5 { tz.ISO_EXTENDED_FULL } else { tz.LOCALIZED_GMT }
        } else if index == TIMEZONE_GENERIC_FIELD {
            if count == 1 {
                style = tz.GENERIC_SHORT
                usage = symbols.CAP_METAZONE_SHORT
            } else if count == 4 {
                style = tz.GENERIC_LONG
                usage = symbols.CAP_METAZONE_LONG
            }
        } else if index == TIMEZONE_SPECIAL_FIELD {
            if count == 1 { style = tz.ZONE_ID_SHORT }
            if count == 2 { style = tz.ZONE_ID }
            if count == 3 { style = tz.EXEMPLAR_LOCATION }
            if count == 4 {
                style = tz.GENERIC_LOCATION
                usage = symbols.CAP_ZONE_LONG
            }
        } else if index == TIMEZONE_LOCALIZED_GMT_OFFSET_FIELD {
            if count == 1 { style = tz.LOCALIZED_GMT_SHORT }
            if count == 4 { style = tz.LOCALIZED_GMT }
        } else if index == TIMEZONE_ISO_FIELD {
            if count == 1 { style = tz.ISO_BASIC_SHORT }
            if count == 2 { style = tz.ISO_BASIC_FIXED }
            if count == 3 { style = tz.ISO_EXTENDED_FIXED }
            if count == 4 { style = tz.ISO_BASIC_FULL }
            if count == 5 { style = tz.ISO_EXTENDED_FULL }
        } else {
            if count == 1 { style = tz.ISO_BASIC_LOCAL_SHORT }
            if count == 2 { style = tz.ISO_BASIC_LOCAL_FIXED }
            if count == 3 { style = tz.ISO_EXTENDED_LOCAL_FIXED }
            if count == 4 { style = tz.ISO_BASIC_LOCAL_FULL }
            if count == 5 { style = tz.ISO_EXTENDED_LOCAL_FULL }
        }
        if style >= 0 {
            var name = text.empty()
            tz.format(tz.of(fm.*.zones), style, &f.*.zone, &name)
            text.pushText(out, &name)
            text.dispose(&name)
        }
    } else if index == QUARTER_FIELD || index == STANDALONE_QUARTER_FIELD {
        const format = index == QUARTER_FIELD
        const quarter = value / 3
        if count >= 5 {
            appendSymbol(fm, out, if format { symbols.NARROW_QUARTERS } else { symbols.STANDALONE_NARROW_QUARTERS }, quarter)
        } else if count == 4 {
            appendSymbol(fm, out, if format { symbols.QUARTERS } else { symbols.STANDALONE_QUARTERS }, quarter)
        } else if count == 3 {
            appendSymbol(fm, out, if format { symbols.SHORT_QUARTERS } else { symbols.STANDALONE_SHORT_QUARTERS }, quarter)
        } else {
            zeroPadding(fm, out, quarter + 1, count, MAX_INT_COUNT)
        }
    } else if index == AM_PM_MIDNIGHT_NOON_FIELD {
        const hour = f.*.values[HOUR_OF_DAY]
        var written = false
        // Noon, as displayed (midnight is not used).
        if hour == 12 && (!hasPattern(pattern, 109) || f.*.values[MINUTE] == 0) && (!hasPattern(pattern, 115) || f.*.values[SECOND] == 0) {
            const which = @intCast(usize, f.*.values[AM_PM])
            const set = if count <= 3 { symbols.DAY_PERIODS_ABBREVIATED } else if count == 4 || count > 5 { symbols.DAY_PERIODS_WIDE } else { symbols.DAY_PERIODS_NARROW }
            if symbols.has(syms, set, which) {
                text.pushText(out, symbols.get(syms, set, which))
                written = true
            }
        }
        if !written { return subFormat(fm, out, 97, count, capitalization, fieldNumber, 98, f, pattern, s) }
    } else if index == FLEXIBLE_DAY_PERIOD_FIELD {
        if !fm.*.periods.found { return subFormat(fm, out, 97, count, capitalization, fieldNumber, 66, f, pattern, s) }
        const hour = f.*.values[HOUR_OF_DAY]
        const minute = if hasPattern(pattern, 109) { f.*.values[MINUTE] } else { 0 }
        const second = if hasPattern(pattern, 115) { f.*.values[SECOND] } else { 0 }
        var period = symbols.UNKNOWN
        if hour == 0 && minute == 0 && second == 0 && fm.*.periods.hasMidnight {
            period = symbols.MIDNIGHT
        } else if hour == 12 && minute == 0 && second == 0 && fm.*.periods.hasNoon {
            period = symbols.NOON
        } else {
            period = fm.*.periods.hours[@intCast(usize, hour)]
        }
        const set = if count <= 3 { symbols.DAY_PERIODS_ABBREVIATED } else if count == 4 || count > 5 { symbols.DAY_PERIODS_WIDE } else { symbols.DAY_PERIODS_NARROW }
        var have = false
        if period != symbols.AM && period != symbols.PM && period != symbols.MIDNIGHT && period >= 0 {
            have = symbols.has(syms, set, @intCast(usize, period))
        }
        // Midnight and noon without names: the period of the hour.
        if !have && (period == symbols.MIDNIGHT || period == symbols.NOON) {
            period = fm.*.periods.hours[@intCast(usize, hour)]
            if period >= 0 && period < 10 { have = symbols.has(syms, set, @intCast(usize, period)) }
        }
        if period == symbols.AM || period == symbols.PM || !have || period < 0 {
            return subFormat(fm, out, 97, count, capitalization, fieldNumber, 66, f, pattern, s)
        }
        text.pushText(out, symbols.get(syms, set, @intCast(usize, period)))
    } else {
        zeroPadding(fm, out, value, count, MAX_INT_COUNT)
    }
    // The first field capitalized as the context asks.
    if fieldNumber == 0 && out.*.length > begin && isLower(out, begin) {
        var titlecase = false
        if capitalization == CAPITALIZATION_BEGINNING { titlecase = true }
        if capitalization == CAPITALIZATION_UI_LIST { titlecase = symbols.capitalizes(syms, usage, false) }
        if capitalization == CAPITALIZATION_STANDALONE { titlecase = symbols.capitalizes(syms, usage, true) }
        if titlecase { titlecaseAt(out, begin) }
    }
    addSpan(s, letterIndex(output), begin, out.*.length)
    return 0
}

fn codePointAt(t: *const Text, index: usize, size: *usize) -> u32 {
    var c = @intCast(u32, text.at(t, index))
    size.* = 1
    if c >= 55296 && c <= 56319 && index + 1 < t.*.length {
        const trail = @intCast(u32, text.at(t, index + 1))
        if trail >= 56320 && trail <= 57343 {
            c = (c << 10) + trail - 56613888
            size.* = 2
        }
    }
    return c
}

fn isLower(t: *const Text, index: usize) -> bool {
    var size: usize = 0
    const c = codePointAt(t, index, &size)
    // Ll
    return properties.category(@intCast(i32, c)) == 2
}

fn titlecaseAt(t: *Text, index: usize) -> void {
    var size: usize = 0
    const c = codePointAt(t, index, &size)
    const title = @intCast(u32, properties.simpleTitle(@intCast(i32, c)))
    if title == c { return }
    text.remove(t, index, size)
    var one = text.empty()
    text.pushCodePoint(&one, title)
    text.insert(t, index, &one)
    text.dispose(&one)
}

// PATTERN of the fields F appended to OUT, the spans to S; 0 or an
// error code (U_INVALID_FORMAT_ERROR for a letter that is no field).
pub fn format(fm: *Formatter, pattern: *const Text, f: *const Fields, capitalization: i32, out: *Text, s: *Spans) -> i32 {
    var inQuote = false
    var previous: u16 = 0
    var count: usize = 0
    var fieldNumber: usize = 0
    var index: usize = 0
    while index < pattern.*.length {
        const c = text.at(pattern, index)
        if c != previous && count > 0 {
            const failure = subFormat(fm, out, previous, count, capitalization, fieldNumber, previous, f, pattern, s)
            if failure != 0 { return failure }
            fieldNumber += 1
            count = 0
        }
        if c == 39 {
            if index + 1 < pattern.*.length && text.at(pattern, index + 1) == 39 {
                text.push(out, 39)
                index += 1
            } else {
                inQuote = !inQuote
            }
        } else if !inQuote && isSyntax(c) {
            previous = c
            count += 1
        } else {
            text.push(out, c)
        }
        index += 1
    }
    if count > 0 {
        const failure = subFormat(fm, out, previous, count, capitalization, fieldNumber, previous, f, pattern, s)
        if failure != 0 { return failure }
    }
    return 0
}

// The formatter's parts for a locale.
pub fn initFormatter(fm: *Formatter, id: *const symbols.Id, data: u32) -> bool {
    var ns = m.bytesBuffer()
    const digits = symbols.numberingSystem(id, data, &ns)
    fm.*.digits = digits.digits
    fm.*.kind = symbols.calendarType(id)
    fm.*.japanese = m.same(symbols.language(id), "ja")
    fm.*.symbols = symbols.load(data, m.bytesText(&ns), fm.*.kind)
    fm.*.zones = tz.create(id, data, &digits)
    fm.*.minus = text.empty()
    var key = m.bytesBuffer()
    m.pushText(&key, "numbers/symbols-numberSystem-")
    m.pushText(&key, m.bytesText(&ns))
    m.pushText(&key, "/minusSign")
    if !symbols.lookupText(data, m.bytesText(&key), &fm.*.minus) { text.push(&fm.*.minus, 45) }
    m.disposeBytes(&key)
    m.disposeBytes(&ns)
    fm.*.periods = symbols.dayPeriods(symbols.baseName(id))
    return fm.*.symbols != 0 && fm.*.zones != 0
}

pub fn cloneFormatter(to: *Formatter, from: *const Formatter) -> void {
    to.* = from.*
    to.*.symbols = symbols.clone(from.*.symbols)
    to.*.zones = tz.clone(from.*.zones)
    to.*.minus = text.copy(&from.*.minus)
}

pub fn disposeFormatter(fm: *Formatter) -> void {
    symbols.destroy(fm.*.symbols)
    tz.destroy(fm.*.zones)
    text.dispose(&fm.*.minus)
    fm.*.symbols = 0
    fm.*.zones = 0
}
