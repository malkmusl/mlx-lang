// The text a number formatter builds (ICU's FormattedStringBuilder): UTF-16
// units, each with the field it belongs to (a category and a field in a
// byte: category << 4 | field; 0 for none), inserted anywhere; and the
// spans of the fields as ICU's FormattedValueStringBuilderImpl gives
// them (nextPositionImpl): a field when it ends, the integer part (with
// its grouping separators) when it ends, a "numeric" field of another
// category (the relative time's) around the number's fields after them,
// spans of other categories (a range's two numbers) before the fields
// inside them; the fields other than grouping separators trimmed of
// default ignorables at their ends (spaces, bidi controls, variation
// selectors).
const m = @import("./memory.mlx")
const formatted = @import("./formatted.mlx")
const nd = @import("./numberdata.mlx")

pub const CATEGORY_NUMBER: u8 = 2
pub const CATEGORY_RELATIVE: u8 = 4

// UNumberFormatFields.
pub const INTEGER: u8 = 0
pub const FRACTION: u8 = 1
pub const DECIMAL_SEPARATOR: u8 = 2
pub const EXPONENT_SYMBOL: u8 = 3
pub const EXPONENT_SIGN: u8 = 4
pub const EXPONENT: u8 = 5
pub const GROUPING_SEPARATOR: u8 = 6
pub const CURRENCY: u8 = 7
pub const PERCENT: u8 = 8
pub const PERMILL: u8 = 9
pub const SIGN: u8 = 10
pub const MEASURE_UNIT: u8 = 11
pub const COMPACT: u8 = 12
pub const APPROXIMATELY_SIGN: u8 = 13

pub const NONE: u8 = 0

pub fn numberField(field: u8) -> u8 { return (CATEGORY_NUMBER << 4) | field }

pub const Builder = struct {
    units: usize
    fields: usize
    length: usize
    capacity: usize
}

pub fn builder() -> Builder { return Builder.{ .units = 0, .fields = 0, .length = 0, .capacity = 0 } }

pub fn dispose(b: *Builder) -> void {
    m.release(b.*.units)
    m.release(b.*.fields)
    b.*.units = 0
    b.*.fields = 0
    b.*.length = 0
    b.*.capacity = 0
}

pub fn clear(b: *Builder) -> void { b.*.length = 0 }

fn reserve(b: *Builder, more: usize) -> void {
    if b.*.length + more <= b.*.capacity { return }
    var grown = if b.*.capacity < 32 { 32 } else { b.*.capacity * 2 }
    while grown < b.*.length + more { grown *= 2 }
    b.*.units = m.grow(b.*.units, grown * 2)
    b.*.fields = m.grow(b.*.fields, grown)
    b.*.capacity = grown
}

pub fn unitAt(b: *const Builder, index: usize) -> u16 { return m.get16(b.*.units + index * 2) }
pub fn fieldAt(b: *const Builder, index: usize) -> u8 { return m.get8(b.*.fields + index) }

// Room for COUNT units at INDEX (what follows moved up).
fn open(b: *Builder, index: usize, count: usize) -> void {
    reserve(b, count)
    var at = b.*.length
    while at > index {
        at -= 1
        m.put16(b.*.units + (at + count) * 2, m.get16(b.*.units + at * 2))
        m.put8(b.*.fields + at + count, m.get8(b.*.fields + at))
    }
    b.*.length += count
}

pub fn insertCodePoint(b: *Builder, index: usize, c: u32, field: u8) -> usize {
    var pair: [2]u16 = undefined
    const n = nd.units(c, &pair)
    open(b, index, n)
    var k: usize = 0
    while k < n {
        m.put16(b.*.units + (index + k) * 2, pair[k])
        m.put8(b.*.fields + index + k, field)
        k += 1
    }
    return n
}

// UTF-8 TEXT at INDEX, all of it FIELD; the units it takes.
pub fn insertText(b: *Builder, index: usize, utf8: []const u8, field: u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < utf8.length {
        count += insertCodePoint(b, index + count, nd.decode(utf8, &at), field)
    }
    return count
}

pub fn appendText(b: *Builder, utf8: []const u8, field: u8) -> usize { return insertText(b, b.*.length, utf8, field) }

// UTF-16 SOURCE (COUNT units) at INDEX, all of it FIELD.
pub fn insertUnits(b: *Builder, index: usize, source: usize, count: usize, field: u8) -> usize {
    open(b, index, count)
    var k: usize = 0
    while k < count {
        m.put16(b.*.units + (index + k) * 2, m.get16(source + k * 2))
        m.put8(b.*.fields + index + k, field)
        k += 1
    }
    return count
}

// Another builder's text and fields at INDEX.
pub fn insertBuilder(b: *Builder, index: usize, other: *const Builder) -> usize {
    const count = other.*.length
    open(b, index, count)
    var k: usize = 0
    while k < count {
        m.put16(b.*.units + (index + k) * 2, m.get16(other.*.units + k * 2))
        m.put8(b.*.fields + index + k, m.get8(other.*.fields + k))
        k += 1
    }
    return count
}

// The units [START, END) taken out; minus their count.
pub fn remove(b: *Builder, start: usize, end: usize) -> i32 {
    if end <= start { return 0 }
    const count = end - start
    var at = start
    while at + count < b.*.length {
        m.put16(b.*.units + at * 2, m.get16(b.*.units + (at + count) * 2))
        m.put8(b.*.fields + at, m.get8(b.*.fields + at + count))
        at += 1
    }
    b.*.length -= count
    return -@intCast(i32, count)
}

pub fn codePointAt(b: *const Builder, index: usize) -> u32 {
    var at = index
    return nd.decode16(b.*.units, b.*.length, &at)
}

pub fn codePointBefore(b: *const Builder, index: usize) -> u32 {
    if index == 0 { return 0 }
    const unit = @intCast(u32, unitAt(b, index - 1))
    if unit >= 56320 && unit <= 57343 && index >= 2 {
        const lead = @intCast(u32, unitAt(b, index - 2))
        if lead >= 55296 && lead <= 56319 { return (lead << 10) + unit - 56613888 }
    }
    return unit
}

pub fn codePointCount(b: *const Builder) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < b.*.length {
        _ = nd.decode16(b.*.units, b.*.length, &at)
        count += 1
    }
    return count
}

// Whether two builders hold the same text with the same fields.
pub fn same(a: *const Builder, b: *const Builder) -> bool {
    if a.*.length != b.*.length { return false }
    var k: usize = 0
    while k < a.*.length {
        if unitAt(a, k) != unitAt(b, k) || fieldAt(a, k) != fieldAt(b, k) { return false }
        k += 1
    }
    return true
}

pub fn containsField(b: *const Builder, field: u8) -> bool {
    var k: usize = 0
    while k < b.*.length {
        if fieldAt(b, k) == field { return true }
        k += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// The spans.

// A span of another category over part of the text (a range's numbers):
// its category, value, start and length.
pub const SpanInfo = struct {
    category: i32
    value: i32
    start: usize
    length: usize
}

fn isIntOrGroup(field: u8) -> bool { return field == numberField(INTEGER) || field == numberField(GROUPING_SEPARATOR) }

fn isTrimmable(field: u8) -> bool { return field != numberField(GROUPING_SEPARATOR) && (field >> 4) != 3 }

fn isNumeric(field: u8) -> bool { return (field >> 4) == CATEGORY_NUMBER }

// The default ignorables ICU trims fields of: [:Zs:], tab, the bidi
// controls and the variation selectors.
pub fn isIgnorable(c: u32) -> bool {
    if c == 9 || c == 32 || c == 160 || c == 5760 || c == 8239 || c == 8287 || c == 12288 { return true }
    if c >= 8192 && c <= 8202 { return true }
    if c == 1564 || c == 8206 || c == 8207 || (c >= 8234 && c <= 8238) || (c >= 8294 && c <= 8297) { return true }
    if c == 6155 || c == 6156 || c == 6157 || c == 6159 || (c >= 65024 && c <= 65039) || (c >= 917760 && c <= 917999) { return true }
    return false
}

fn trimBack(b: *const Builder, limit: usize, floor: usize) -> usize {
    var end = limit
    while end > floor {
        const c = codePointBefore(b, end)
        if !isIgnorable(c) { break }
        end -= if c >= 65536 { 2 } else { 1 }
    }
    return end
}

fn trimFront(b: *const Builder, start: usize, limit: usize) -> usize {
    var at = start
    while at < limit {
        var next = at
        const c = nd.decode16(b.*.units, b.*.length, &next)
        if !isIgnorable(c) { break }
        at = next
    }
    return at
}

// The spans of B into VALUE (a formatted value, its spans appended), in
// ICU's order. NUMERIC is the numeric field of another category (0 for
// none: (category << 4 | field) of e.g. the relative time's numeric
// field); SPANS (COUNT of them) the spans of other categories.
pub fn addSpans(b: *const Builder, value: usize, numeric: u8, spans: [*]const SpanInfo, spanCount: usize) -> void {
    // The state of ICU's iteration between positions.
    var limit: usize = 0
    var category: i32 = 0
    var field: i32 = 0
    var context: usize = 0
    const end = b.*.length
    // ICU's kEndField: a field that is none of the others.
    const END_FIELD: u16 = 255
    var running = true
    while running {
        var fieldStart: i32 = -1
        var current: u16 = 0
        var prevIsSpan = false
        var nextSpanStart: i64 = -1
        if spanCount > 0 {
            if context < spanCount { nextSpanStart = @intCast(i64, spans[context].start) }
            if context > 0 { prevIsSpan = category == spans[context - 1].category && field == spans[context - 1].value }
        }
        var prevIsNumeric = false
        if numeric != 0 { prevIsNumeric = category == @intCast(i32, numeric >> 4) && field == @intCast(i32, numeric & 15) }
        var prevIsInteger = category == 2 && field == 0
        var found = false
        var i = limit
        while i <= end {
            var here: u16 = if i < end { @intCast(u16, fieldAt(b, i)) } else { END_FIELD }
            // Scanning a field: it ends where another starts.
            if current != 0 {
                if current != here {
                    var stop = i
                    const f = @intCast(u8, current)
                    if isTrimmable(f) { stop = trimBack(b, i, 0) }
                    if @intCast(i32, stop) <= fieldStart {
                        fieldStart = -1
                        current = 0
                        // Look at this index again.
                        continue
                    }
                    var start = @intCast(usize, fieldStart)
                    if isTrimmable(f) { start = trimFront(b, start, stop) }
                    category = @intCast(i32, f >> 4)
                    field = @intCast(i32, f & 15)
                    formatted.addSpan(value, category, field, start, stop)
                    limit = stop
                    found = true
                    break
                }
                i += 1
                continue
            }
            // At the end of a span: the fields inside it, from its start.
            if i > 0 && prevIsSpan {
                const previous = i - spans[context - 1].length
                here = @intCast(u16, fieldAt(b, previous))
                i = previous
            }
            // The end of the integer: the integer with its grouping.
            if i > 0 && !prevIsInteger && !prevIsNumeric && isIntOrGroup(fieldAt(b, i - 1)) && !(here != END_FIELD && isIntOrGroup(@intCast(u8, here))) {
                var j = i - 1
                while j > 0 && isIntOrGroup(fieldAt(b, j - 1)) { j -= 1 }
                category = 2
                field = 0
                formatted.addSpan(value, 2, 0, j, i)
                limit = i
                found = true
                break
            }
            // The end of the numeric part: the numeric field around it.
            if numeric != 0 && i > 0 && !prevIsNumeric && isNumeric(fieldAt(b, i - 1)) && !(here != END_FIELD && isNumeric(@intCast(u8, here))) {
                var j = i - 1
                while j > 0 && isNumeric(fieldAt(b, j - 1)) { j -= 1 }
                category = @intCast(i32, numeric >> 4)
                field = @intCast(i32, numeric & 15)
                formatted.addSpan(value, category, field, j, i)
                limit = i
                found = true
                break
            }
            if !prevIsSpan && @intCast(i64, i) == nextSpanStart {
                if context >= spanCount { break }
                const span = spans[context]
                context += 1
                if context < spanCount { nextSpanStart = @intCast(i64, spans[context].start) }
                if span.length == 0 {
                    // ICU-21871: no field for an empty span.
                    continue
                }
                category = span.category
                field = span.value
                formatted.addSpan(value, category, field, i, i + span.length)
                limit = i + span.length
                found = true
                break
            } else if here == @intCast(u16, numberField(INTEGER)) {
                here = 0
            } else if here == 0 || here == END_FIELD {
                // No field starts here.
            } else {
                fieldStart = @intCast(i32, i)
                current = here
            }
            prevIsSpan = false
            prevIsNumeric = false
            prevIsInteger = false
            i += 1
        }
        if !found { running = false }
    }
}

// The text of B into VALUE (replacing what it had), with its spans.
pub fn toValue(b: *const Builder, value: usize, numeric: u8, spans: [*]const SpanInfo, spanCount: usize) -> void {
    formatted.clear(value)
    formatted.appendUnits(value, b.*.units, b.*.length)
    if formatted.text(value) == 0 { formatted.appendText(value, "") }
    addSpans(b, value, numeric, spans, spanCount)
}
