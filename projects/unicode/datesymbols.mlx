// The locale data of the date formats (ICU's DateFormatSymbols), from
// CLDR's gregorian calendar (dates/calendars/gregorian/...): eras,
// months, weekdays, quarters, AM/PM and the other day periods (format
// and stand-alone, each width), the time separator of the numbering
// system, the capitalization of names by context (contextTransforms);
// and what else a format takes of its locale: the locale's ID in ICU's
// form and its keywords (calendar, numbers, hours, rg), the locale with
// data it falls back to, the digits of its numbering system (CLDR's
// numberingSystems), its rules of day periods (dayPeriodRuleSet, for
// the flexible periods of 'B').
//
// Only the gregorian calendar has data here: a locale asking for
// another (-u-ca-japanese...) gets the gregorian names and patterns, as
// ICU does for a calendar without data of its own.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const locale = @import("./locale.mlx")
const text = @import("./datetext.mlx")

extern("c") fn uloc_getName(localeID: usize, name: usize, capacity: i32, err: usize) -> i32
extern("c") fn uloc_getDefault() -> usize
extern("c") fn uloc_addLikelySubtags(localeID: usize, maximized: usize, capacity: i32, err: usize) -> i32
extern("c") fn uloc_getCountry(localeID: usize, country: usize, capacity: i32, err: usize) -> i32
extern("c") fn uloc_getLanguage(localeID: usize, language: usize, capacity: i32, err: usize) -> i32

const Text = text.Text

// ---------------------------------------------------------------------------
// Locale IDs.

pub const Id = struct {
    // The ID in ICU's form ("de_AT@calendar=japanese;hours=h23").
    name: [160]u8
    length: usize
}

// The ICU form of C's locale ID (the default locale for 0).
pub fn idOf(localeId: usize) -> Id {
    var result: Id = undefined
    result.length = 0
    var status: i32 = 0
    const source = if localeId == 0 { uloc_getDefault() } else { localeId }
    const length = uloc_getName(source, @intFromPtr(&result.name), 159, @intFromPtr(&status))
    if status <= 0 && length >= 0 && length < 159 { result.length = @intCast(usize, length) }
    result.name[result.length] = 0
    return result
}

pub fn idText(id: *const Id) -> []const u8 {
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &id.*.name) }
    return view[0..id.*.length]
}

// The ID without its keywords.
pub fn baseName(id: *const Id) -> []const u8 {
    const all = idText(id)
    var end: usize = 0
    while end < all.length && all[end] != 64 { end += 1 }
    return all[0..end]
}

pub fn keyword(id: *const Id, key: []const u8) -> []const u8 { return locale.keyword(idText(id), key) }

// The language of the ID ("" for root).
pub fn language(id: *const Id) -> []const u8 {
    const base = baseName(id)
    var end: usize = 0
    while end < base.length && base[end] != 95 { end += 1 }
    return base[0..end]
}

// The region subtag of the ID itself ("" when it has none).
pub fn country(id: *const Id) -> []const u8 {
    const base = baseName(id)
    var at: usize = 0
    var start: usize = 0
    var part: usize = 0
    while at <= base.length {
        if at == base.length || base[at] == 95 {
            const piece = base[start..at]
            if part > 0 && (piece.length == 2 || (piece.length == 3 && piece[0] >= 48 && piece[0] <= 57)) { return piece }
            if part > 0 && piece.length != 4 { return "" }
            part += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

// The region of the ID with its likely subtags (zh_Hant: TW), two
// letters in a u16 (the first high); 0 for none.
pub fn likelyRegion(base: []const u8) -> u16 {
    var name: [160]u8 = undefined
    var k: usize = 0
    while k < base.length && k < 150 {
        name[k] = base[k]
        k += 1
    }
    name[k] = 0
    var maximized: [160]u8 = undefined
    var status: i32 = 0
    _ = uloc_addLikelySubtags(@intFromPtr(&name), @intFromPtr(&maximized), 159, @intFromPtr(&status))
    if status > 0 { return 0 }
    var region: [8]u8 = undefined
    status = 0
    const length = uloc_getCountry(@intFromPtr(&maximized), @intFromPtr(&region), 7, @intFromPtr(&status))
    if status > 0 || length != 2 { return 0 }
    return (@intCast(u16, region[0]) << 8) | @intCast(u16, region[1])
}

// The language of the ID with its likely subtags, into INTO; its length.
pub fn likelyLanguage(base: []const u8, into: *[12]u8) -> usize {
    var name: [160]u8 = undefined
    var k: usize = 0
    while k < base.length && k < 150 {
        name[k] = base[k]
        k += 1
    }
    name[k] = 0
    var maximized: [160]u8 = undefined
    var status: i32 = 0
    _ = uloc_addLikelySubtags(@intFromPtr(&name), @intFromPtr(&maximized), 159, @intFromPtr(&status))
    if status > 0 { return 0 }
    status = 0
    const length = uloc_getLanguage(@intFromPtr(&maximized), @intFromPtr(into), 11, @intFromPtr(&status))
    if status > 0 || length <= 0 { return 0 }
    return @intCast(usize, length)
}

// The region of the supplemental data for the ID: its rg keyword's, its
// own, else its likely one (0 for none).
pub fn supplementalRegion(id: *const Id) -> u16 {
    const rg = keyword(id, "rg")
    if rg.length >= 2 && isAlpha(rg[0]) && isAlpha(rg[1]) { return (@intCast(u16, upper(rg[0])) << 8) | @intCast(u16, upper(rg[1])) }
    const own = country(id)
    if own.length == 2 { return (@intCast(u16, own[0]) << 8) | @intCast(u16, own[1]) }
    return likelyRegion(baseName(id))
}

fn isAlpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn upper(c: u8) -> u8 { return if c >= 97 && c <= 122 { c - 32 } else { c } }

// The locale with data for the ID (its fallback).
pub fn dataLocale(id: *const Id) -> u32 { return resources.find(baseName(id)) }

// The ICU name of a locale of the data ("de_AT"; "root" for und).
pub fn dataName(index: u32, into: *m.Bytes) -> void {
    if index == resources.NONE { return }
    const name = resources.localeName(index)
    if m.same(name, "und") {
        m.pushText(into, "root")
        return
    }
    for byte in name { m.pushByte(into, if byte == 45 { 95 } else { byte }) }
}

// ---------------------------------------------------------------------------
// The data of the locale (and its parents) as UTF-16.

pub fn lookupText(data: u32, path: []const u8, into: *Text) -> bool {
    var value: []const u8 = ""
    if !resources.lookup(data, path, &value) { return false }
    text.pushUtf8(into, value)
    return true
}

pub fn calendarPath(rest: []const u8, into: *m.Bytes) -> void {
    m.pushText(into, "dates/calendars/gregorian/")
    m.pushText(into, rest)
}

// ---------------------------------------------------------------------------
// Numbering systems: the ten digits of the locale's.

pub const Digits = struct {
    digits: [10]u32
}

fn latin() -> Digits {
    var result: Digits = undefined
    var k: usize = 0
    while k < 10 {
        result.digits[k] = @intCast(u32, 48 + k)
        k += 1
    }
    return result
}

// The numbering system the ID names ("numbers" keyword: a system, or
// default, native, traditional, finance) or its locale's default, into
// NAME; its digits (Latin ones for an algorithmic system).
pub fn numberingSystem(id: *const Id, data: u32, name: *m.Bytes) -> Digits {
    var wanted = keyword(id, "numbers")
    if wanted.length == 0 || m.same(wanted, "default") {
        wanted = resources.get(data, "numbers/defaultNumberingSystem")
    } else if m.same(wanted, "native") || m.same(wanted, "traditional") || m.same(wanted, "finance") {
        var key = m.bytesBuffer()
        m.pushText(&key, "numbers/otherNumberingSystems/")
        m.pushText(&key, wanted)
        var found: []const u8 = ""
        if !resources.lookup(data, m.bytesText(&key), &found) && m.same(wanted, "traditional") {
            found = resources.get(data, "numbers/otherNumberingSystems/native")
        }
        m.disposeBytes(&key)
        wanted = if found.length > 0 { found } else { resources.get(data, "numbers/defaultNumberingSystem") }
    }
    if wanted.length == 0 { wanted = "latn" }
    var key = m.bytesBuffer()
    m.pushText(&key, "numberingSystems/")
    m.pushText(&key, wanted)
    m.pushText(&key, "/_digits")
    const digits = resources.get(resources.supplemental(), m.bytesText(&key))
    m.disposeBytes(&key)
    var result = latin()
    // Ten code points, else not a numeric system.
    var units = text.fromUtf8(digits)
    var count: usize = 0
    var codes: [10]u32 = undefined
    var index: usize = 0
    while index < units.length && count < 11 {
        var c = @intCast(u32, text.at(&units, index))
        index += 1
        if c >= 55296 && c <= 56319 && index < units.length {
            c = (c << 10) + @intCast(u32, text.at(&units, index)) - 56613888
            index += 1
        }
        if count < 10 { codes[count] = c }
        count += 1
    }
    text.dispose(&units)
    if count == 10 {
        result.digits = codes
        m.pushText(name, wanted)
    } else {
        m.pushText(name, "latn")
    }
    return result
}

// ---------------------------------------------------------------------------
// The symbols.

// The sets, in the order of UDateFormatSymbolType, then the ones C does
// not name.
pub const ERAS: usize = 0
pub const MONTHS: usize = 1
pub const SHORT_MONTHS: usize = 2
pub const WEEKDAYS: usize = 3
pub const SHORT_WEEKDAYS: usize = 4
pub const AM_PMS: usize = 5
pub const LOCALIZED_CHARS: usize = 6
pub const ERA_NAMES: usize = 7
pub const NARROW_MONTHS: usize = 8
pub const NARROW_WEEKDAYS: usize = 9
pub const STANDALONE_MONTHS: usize = 10
pub const STANDALONE_SHORT_MONTHS: usize = 11
pub const STANDALONE_NARROW_MONTHS: usize = 12
pub const STANDALONE_WEEKDAYS: usize = 13
pub const STANDALONE_SHORT_WEEKDAYS: usize = 14
pub const STANDALONE_NARROW_WEEKDAYS: usize = 15
pub const QUARTERS: usize = 16
pub const SHORT_QUARTERS: usize = 17
pub const STANDALONE_QUARTERS: usize = 18
pub const STANDALONE_SHORT_QUARTERS: usize = 19
pub const SHORTER_WEEKDAYS: usize = 20
pub const STANDALONE_SHORTER_WEEKDAYS: usize = 21
pub const CYCLIC_YEARS_WIDE: usize = 22
pub const CYCLIC_YEARS_ABBREVIATED: usize = 23
pub const CYCLIC_YEARS_NARROW: usize = 24
pub const ZODIAC_NAMES_WIDE: usize = 25
pub const ZODIAC_NAMES_ABBREVIATED: usize = 26
pub const ZODIAC_NAMES_NARROW: usize = 27
pub const NARROW_QUARTERS: usize = 28
pub const STANDALONE_NARROW_QUARTERS: usize = 29
pub const NARROW_ERAS: usize = 30
pub const NARROW_AM_PMS: usize = 31
pub const DAY_PERIODS_ABBREVIATED: usize = 32
pub const DAY_PERIODS_WIDE: usize = 33
pub const DAY_PERIODS_NARROW: usize = 34
pub const STANDALONE_DAY_PERIODS_ABBREVIATED: usize = 35
pub const STANDALONE_DAY_PERIODS_WIDE: usize = 36
pub const STANDALONE_DAY_PERIODS_NARROW: usize = 37
pub const TIME_SEPARATOR: usize = 38
pub const SET_COUNT: usize = 39

// The number of strings of each set.
const SIZES = [39]usize{ 2, 12, 12, 8, 8, 2, 1, 2, 12, 8, 12, 12, 12, 8, 8, 8, 4, 4, 4, 4, 8, 8, 0, 0, 0, 0, 0, 0, 4, 4, 2, 2, 10, 10, 10, 10, 10, 10, 1 }
pub const TEXT_COUNT: usize = 251

// The usages of capitalization by context (ICU's
// ECapitalizationContextUsageType), as contextTransforms names them.
pub const CAP_OTHER: usize = 0
pub const CAP_MONTH_FORMAT: usize = 1
pub const CAP_MONTH_STANDALONE: usize = 2
pub const CAP_MONTH_NARROW: usize = 3
pub const CAP_DAY_FORMAT: usize = 4
pub const CAP_DAY_STANDALONE: usize = 5
pub const CAP_DAY_NARROW: usize = 6
pub const CAP_ERA_WIDE: usize = 7
pub const CAP_ERA_ABBREV: usize = 8
pub const CAP_ERA_NARROW: usize = 9
pub const CAP_ZONE_LONG: usize = 10
pub const CAP_ZONE_SHORT: usize = 11
pub const CAP_METAZONE_LONG: usize = 12
pub const CAP_METAZONE_SHORT: usize = 13
pub const CAP_COUNT: usize = 14

const CAPITALIZATION_NAMES: []const u8 = "\nmonth-format-except-narrow\nmonth-standalone-except-narrow\nmonth-narrow\nday-format-except-narrow\nday-standalone-except-narrow\nday-narrow\nera-name\nera-abbr\nera-narrow\nzone-long\nzone-short\nmetazone-long\nmetazone-short\n"

// The pattern letters ICU uses (its "localized" letters are the same:
// CLDR has none of its own).
pub const PATTERN_CHARS: []const u8 = "GyMdkHmsSEDFwWahKzYeugAZvcLQqVUOXxrbB"

pub const Symbols = struct {
    texts: [251]Text
    // Whether a day period has a name in the locale (others are bogus).
    present: [251]bool
    capitalization: [28]bool
}

fn symbolsAt(address: usize) -> *Symbols { unsafe { return @ptrFromInt(*Symbols, address) } }

pub fn setOffset(set: usize) -> usize {
    var offset: usize = 0
    var k: usize = 0
    while k < set {
        offset += SIZES[k]
        k += 1
    }
    return offset
}

pub fn setSize(set: usize) -> usize { return if set < SET_COUNT { SIZES[set] } else { 0 } }

pub fn get(s: *Symbols, set: usize, index: usize) -> *Text { return &s.*.texts[setOffset(set) + index] }

pub fn has(s: *Symbols, set: usize, index: usize) -> bool { return index < setSize(set) && s.*.present[setOffset(set) + index] }

fn put(s: *Symbols, set: usize, index: usize, data: u32, path: []const u8) -> bool {
    const slot = setOffset(set) + index
    text.clear(&s.*.texts[slot])
    const found = lookupText(data, path, &s.*.texts[slot])
    s.*.present[slot] = found
    return found
}

fn copySet(s: *Symbols, to: usize, from: usize) -> void {
    var k: usize = 0
    while k < setSize(to) && k < setSize(from) {
        const a = setOffset(to) + k
        const b = setOffset(from) + k
        text.dispose(&s.*.texts[a])
        s.*.texts[a] = text.copy(&s.*.texts[b])
        s.*.present[a] = s.*.present[b]
        k += 1
    }
}

const DAY_KEYS: []const u8 = "sunmontuewedthufrisat"
const PERIOD_KEYS: []const u8 = "\nmidnight\nnoon\nmorning1\nafternoon1\nevening1\nnight1\nmorning2\nafternoon2\nevening2\nnight2\n"

// Line INDEX of a list written "\na\nb\n".
pub fn listItem(list: []const u8, index: usize) -> []const u8 {
    var at: usize = 1
    var line: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 10 { end += 1 }
        if line == index { return list[at..end] }
        line += 1
        at = end + 1
    }
    return ""
}

fn loadNames(s: *Symbols, set: usize, data: u32, what: []const u8, context: []const u8, width: []const u8) -> bool {
    var all = true
    var k: usize = 0
    while k < setSize(set) {
        var key = m.bytesBuffer()
        m.pushText(&key, "dates/calendars/gregorian/")
        m.pushText(&key, what)
        m.pushByte(&key, 47)
        m.pushText(&key, context)
        m.pushByte(&key, 47)
        m.pushText(&key, width)
        m.pushByte(&key, 47)
        if m.same(what, "days") {
            if k == 0 {
                m.disposeBytes(&key)
                k += 1
                continue
            }
            m.pushText(&key, DAY_KEYS[(k - 1) * 3..(k - 1) * 3 + 3])
        } else if m.same(what, "dayPeriods") {
            m.pushText(&key, listItem(PERIOD_KEYS, k))
        } else {
            pushNumber(&key, k + 1)
        }
        if !put(s, set, k, data, m.bytesText(&key)) { all = false }
        m.disposeBytes(&key)
        k += 1
    }
    return all
}

pub fn pushNumber(into: *m.Bytes, value: usize) -> void {
    if value >= 10 { pushNumber(into, value / 10) }
    m.pushByte(into, @intCast(u8, 48 + value % 10))
}

fn loadEras(s: *Symbols, set: usize, data: u32, kind: []const u8) -> bool {
    var all = true
    var k: usize = 0
    while k < 2 {
        var key = m.bytesBuffer()
        m.pushText(&key, "dates/calendars/gregorian/eras/")
        m.pushText(&key, kind)
        m.pushByte(&key, 47)
        pushNumber(&key, k)
        if !put(s, set, k, data, m.bytesText(&key)) { all = false }
        m.disposeBytes(&key)
        k += 1
    }
    return all
}

fn loadPair(s: *Symbols, set: usize, data: u32, width: []const u8) -> bool {
    var key = m.bytesBuffer()
    m.pushText(&key, "dates/calendars/gregorian/dayPeriods/format/")
    m.pushText(&key, width)
    m.pushText(&key, "/am")
    const am = put(s, set, 0, data, m.bytesText(&key))
    m.disposeBytes(&key)
    key = m.bytesBuffer()
    m.pushText(&key, "dates/calendars/gregorian/dayPeriods/format/")
    m.pushText(&key, width)
    m.pushText(&key, "/pm")
    const pm = put(s, set, 1, data, m.bytesText(&key))
    m.disposeBytes(&key)
    return am && pm
}

// The symbols of locale DATA (with the numbering system NS for the time
// separator), as ICU's DateFormatSymbols loads them, with its fallbacks
// for what is missing.
pub fn load(data: u32, ns: []const u8) -> usize {
    const address = m.alloc(@sizeOf(Symbols))
    if address == 0 { return 0 }
    var s = symbolsAt(address)
    _ = loadEras(s, ERAS, data, "eraAbbr")
    if !loadEras(s, ERA_NAMES, data, "eraNames") { copySet(s, ERA_NAMES, ERAS) }
    if !loadEras(s, NARROW_ERAS, data, "eraNarrow") { copySet(s, NARROW_ERAS, ERAS) }
    _ = loadNames(s, MONTHS, data, "months", "format", "wide")
    _ = loadNames(s, SHORT_MONTHS, data, "months", "format", "abbreviated")
    if !loadNames(s, STANDALONE_MONTHS, data, "months", "stand-alone", "wide") { copySet(s, STANDALONE_MONTHS, MONTHS) }
    if !loadNames(s, STANDALONE_SHORT_MONTHS, data, "months", "stand-alone", "abbreviated") { copySet(s, STANDALONE_SHORT_MONTHS, SHORT_MONTHS) }
    const narrow = loadNames(s, NARROW_MONTHS, data, "months", "format", "narrow")
    const standaloneNarrow = loadNames(s, STANDALONE_NARROW_MONTHS, data, "months", "stand-alone", "narrow")
    if !narrow && standaloneNarrow { copySet(s, NARROW_MONTHS, STANDALONE_NARROW_MONTHS) }
    if narrow && !standaloneNarrow { copySet(s, STANDALONE_NARROW_MONTHS, NARROW_MONTHS) }
    if !narrow && !standaloneNarrow {
        copySet(s, NARROW_MONTHS, SHORT_MONTHS)
        copySet(s, STANDALONE_NARROW_MONTHS, SHORT_MONTHS)
    }
    if !loadPair(s, AM_PMS, data, "wide") { _ = loadPair(s, AM_PMS, data, "abbreviated") }
    if !loadPair(s, NARROW_AM_PMS, data, "narrow") {
        if !loadPair(s, NARROW_AM_PMS, data, "abbreviated") { copySet(s, NARROW_AM_PMS, AM_PMS) }
    }
    _ = loadNames(s, QUARTERS, data, "quarters", "format", "wide")
    if !loadNames(s, SHORT_QUARTERS, data, "quarters", "format", "abbreviated") { copySet(s, SHORT_QUARTERS, QUARTERS) }
    if !loadNames(s, STANDALONE_QUARTERS, data, "quarters", "stand-alone", "wide") { copySet(s, STANDALONE_QUARTERS, QUARTERS) }
    if !loadNames(s, STANDALONE_SHORT_QUARTERS, data, "quarters", "stand-alone", "abbreviated") { copySet(s, STANDALONE_SHORT_QUARTERS, SHORT_QUARTERS) }
    if !loadNames(s, NARROW_QUARTERS, data, "quarters", "format", "narrow") { copySet(s, NARROW_QUARTERS, SHORT_QUARTERS) }
    if !loadNames(s, STANDALONE_NARROW_QUARTERS, data, "quarters", "stand-alone", "narrow") { copySet(s, STANDALONE_NARROW_QUARTERS, NARROW_QUARTERS) }
    _ = loadNames(s, WEEKDAYS, data, "days", "format", "wide")
    _ = loadNames(s, SHORT_WEEKDAYS, data, "days", "format", "abbreviated")
    if !loadNames(s, SHORTER_WEEKDAYS, data, "days", "format", "short") { copySet(s, SHORTER_WEEKDAYS, SHORT_WEEKDAYS) }
    if !loadNames(s, STANDALONE_WEEKDAYS, data, "days", "stand-alone", "wide") { copySet(s, STANDALONE_WEEKDAYS, WEEKDAYS) }
    if !loadNames(s, STANDALONE_SHORT_WEEKDAYS, data, "days", "stand-alone", "abbreviated") { copySet(s, STANDALONE_SHORT_WEEKDAYS, SHORT_WEEKDAYS) }
    if !loadNames(s, STANDALONE_SHORTER_WEEKDAYS, data, "days", "stand-alone", "short") { copySet(s, STANDALONE_SHORTER_WEEKDAYS, SHORTER_WEEKDAYS) }
    const narrowDays = loadNames(s, NARROW_WEEKDAYS, data, "days", "format", "narrow")
    const standaloneNarrowDays = loadNames(s, STANDALONE_NARROW_WEEKDAYS, data, "days", "stand-alone", "narrow")
    if !narrowDays && standaloneNarrowDays { copySet(s, NARROW_WEEKDAYS, STANDALONE_NARROW_WEEKDAYS) }
    if narrowDays && !standaloneNarrowDays { copySet(s, STANDALONE_NARROW_WEEKDAYS, NARROW_WEEKDAYS) }
    if !narrowDays && !standaloneNarrowDays {
        copySet(s, NARROW_WEEKDAYS, SHORT_WEEKDAYS)
        copySet(s, STANDALONE_NARROW_WEEKDAYS, SHORT_WEEKDAYS)
    }
    _ = loadNames(s, DAY_PERIODS_ABBREVIATED, data, "dayPeriods", "format", "abbreviated")
    _ = loadNames(s, DAY_PERIODS_WIDE, data, "dayPeriods", "format", "wide")
    _ = loadNames(s, DAY_PERIODS_NARROW, data, "dayPeriods", "format", "narrow")
    _ = loadNames(s, STANDALONE_DAY_PERIODS_ABBREVIATED, data, "dayPeriods", "stand-alone", "abbreviated")
    _ = loadNames(s, STANDALONE_DAY_PERIODS_WIDE, data, "dayPeriods", "stand-alone", "wide")
    _ = loadNames(s, STANDALONE_DAY_PERIODS_NARROW, data, "dayPeriods", "stand-alone", "narrow")
    // A missing wide or narrow day period is the abbreviated one; a
    // missing stand-alone one the format one.
    var k: usize = 0
    while k < 10 {
        fillPeriod(s, DAY_PERIODS_WIDE, DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, DAY_PERIODS_NARROW, DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, STANDALONE_DAY_PERIODS_ABBREVIATED, DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, STANDALONE_DAY_PERIODS_WIDE, STANDALONE_DAY_PERIODS_ABBREVIATED, k)
        fillPeriod(s, STANDALONE_DAY_PERIODS_NARROW, STANDALONE_DAY_PERIODS_ABBREVIATED, k)
        k += 1
    }
    put(s, LOCALIZED_CHARS, 0, resources.NONE, "")
    text.pushUtf8(get(s, LOCALIZED_CHARS, 0), PATTERN_CHARS)
    var key = m.bytesBuffer()
    m.pushText(&key, "numbers/symbols-numberSystem-")
    m.pushText(&key, ns)
    m.pushText(&key, "/timeSeparator")
    if !put(s, TIME_SEPARATOR, 0, data, m.bytesText(&key)) { text.push(get(s, TIME_SEPARATOR, 0), 58) }
    m.disposeBytes(&key)
    // Capitalization: [uiListOrMenu, stand-alone] of each usage.
    var usage: usize = 1
    while usage < CAP_COUNT {
        const name = listItem(CAPITALIZATION_NAMES, usage - 1)
        var ui = m.bytesBuffer()
        m.pushText(&ui, "contextTransforms/")
        m.pushText(&ui, name)
        m.pushText(&ui, "/uiListOrMenu")
        s.*.capitalization[usage * 2] = m.same(resources.get(data, m.bytesText(&ui)), "titlecase-firstword")
        m.disposeBytes(&ui)
        var alone = m.bytesBuffer()
        m.pushText(&alone, "contextTransforms/")
        m.pushText(&alone, name)
        m.pushText(&alone, "/stand-alone")
        s.*.capitalization[usage * 2 + 1] = m.same(resources.get(data, m.bytesText(&alone)), "titlecase-firstword")
        m.disposeBytes(&alone)
        usage += 1
    }
    return address
}

fn fillPeriod(s: *Symbols, set: usize, from: usize, index: usize) -> void {
    const a = setOffset(set) + index
    const b = setOffset(from) + index
    if !s.*.present[a] && s.*.present[b] {
        text.dispose(&s.*.texts[a])
        s.*.texts[a] = text.copy(&s.*.texts[b])
        s.*.present[a] = true
    }
}

pub fn clone(address: usize) -> usize {
    if address == 0 { return 0 }
    const copy = m.alloc(@sizeOf(Symbols))
    if copy == 0 { return 0 }
    m.copy(copy, address, @sizeOf(Symbols))
    var s = symbolsAt(copy)
    var k: usize = 0
    while k < TEXT_COUNT {
        s.*.texts[k] = text.copy(&symbolsAt(address).*.texts[k])
        k += 1
    }
    return copy
}

pub fn destroy(address: usize) -> void {
    if address == 0 { return }
    var s = symbolsAt(address)
    var k: usize = 0
    while k < TEXT_COUNT {
        text.dispose(&s.*.texts[k])
        k += 1
    }
    m.release(address)
}

pub fn of(address: usize) -> *Symbols { return symbolsAt(address) }

pub fn capitalizes(s: *Symbols, usage: usize, standalone: bool) -> bool {
    if usage == CAP_OTHER || usage >= CAP_COUNT { return false }
    return s.*.capitalization[usage * 2 + (if standalone { 1 } else { 0 })]
}

// ---------------------------------------------------------------------------
// The rules of day periods (CLDR's dayPeriodRuleSet): the period of each
// hour, and whether midnight and noon have their own.

pub const MIDNIGHT: i32 = 0
pub const NOON: i32 = 1
pub const MORNING1: i32 = 2
pub const AFTERNOON1: i32 = 3
pub const EVENING1: i32 = 4
pub const NIGHT1: i32 = 5
pub const MORNING2: i32 = 6
pub const AFTERNOON2: i32 = 7
pub const EVENING2: i32 = 8
pub const NIGHT2: i32 = 9
pub const AM: i32 = 10
pub const PM: i32 = 11
pub const UNKNOWN: i32 = -1

pub const DayPeriods = struct {
    found: bool
    hasMidnight: bool
    hasNoon: bool
    hours: [24]i32
}

fn hourOf(value: []const u8) -> i32 {
    var hour: i32 = 0
    var k: usize = 0
    while k < value.length && value[k] >= 48 && value[k] <= 57 {
        hour = hour * 10 + @intCast(i32, value[k] - 48)
        k += 1
    }
    return hour
}

// The rules of the locale named BASE (an ICU base name), else of its
// parents (by truncation, as ICU looks for them).
pub fn dayPeriods(base: []const u8) -> DayPeriods {
    var result: DayPeriods = undefined
    result.found = false
    result.hasMidnight = false
    result.hasNoon = false
    var h: usize = 0
    while h < 24 {
        result.hours[h] = UNKNOWN
        h += 1
    }
    var name: [100]u8 = undefined
    var length: usize = 0
    for byte in base {
        if length < 99 {
            name[length] = if byte == 95 { 45 } else { byte }
            length += 1
        }
    }
    if length == 0 {
        const root = "root"
        for byte in root {
            name[length] = byte
            length += 1
        }
    }
    const supplemental = resources.supplemental()
    while length > 0 {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &name) }
        var prefix = m.bytesBuffer()
        m.pushText(&prefix, "dayPeriodRuleSet/")
        m.pushText(&prefix, view[0..length])
        var first: u32 = 0
        var end: u32 = 0
        resources.below(m.bytesText(&prefix), &first, &end)
        const prefixLength = prefix.length
        var any = false
        var k = first
        while k < end {
            if resources.own(supplemental, k) != resources.NONE { any = true }
            k += 1
        }
        if any {
            k = first
            while k < end {
                const keyName = resources.keyName(k)
                const value = resources.get(supplemental, keyName)
                // dayPeriodRuleSet/LOCALE/PERIOD/_from|_before|_at
                const period = resources.childName(k, prefixLength)
                var leaf = keyName.length
                while leaf > 0 && keyName[leaf - 1] != 47 { leaf -= 1 }
                const attribute = keyName[leaf..keyName.length]
                const kind = periodNumber(period)
                if kind != UNKNOWN {
                    if m.same(attribute, "_at") {
                        if kind == MIDNIGHT { result.hasMidnight = true }
                        if kind == NOON { result.hasNoon = true }
                    } else if m.same(attribute, "_from") {
                        // Paired with _before of the same period.
                        var before = m.bytesBuffer()
                        m.pushText(&before, keyName[0..leaf])
                        m.pushText(&before, "_before")
                        const limitText = resources.get(supplemental, m.bytesText(&before))
                        m.disposeBytes(&before)
                        var start = hourOf(value)
                        var limit = hourOf(limitText)
                        if limit == 24 { limit = 0 }
                        if limitText.length > 0 {
                            // Ranges may wrap past midnight.
                            var guard: i32 = 0
                            while start != limit && guard < 24 {
                                result.hours[@intCast(usize, start)] = kind
                                start = if start == 23 { 0 } else { start + 1 }
                                guard += 1
                            }
                        }
                    }
                }
                k += 1
            }
            m.disposeBytes(&prefix)
            result.found = result.hours[0] != UNKNOWN
            return result
        }
        m.disposeBytes(&prefix)
        // The parent: without the last subtag.
        while length > 0 && name[length - 1] != 45 { length -= 1 }
        if length > 0 { length -= 1 }
    }
    return result
}

fn periodNumber(name: []const u8) -> i32 {
    var k: usize = 0
    while k < 10 {
        if m.same(listItem(PERIOD_KEYS, k), name) { return @intCast(i32, k) }
        k += 1
    }
    if m.same(name, "am") { return AM }
    if m.same(name, "pm") { return PM }
    return UNKNOWN
}
