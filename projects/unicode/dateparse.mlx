// Parsing dates by a pattern (udat_parse, udat_parseCalendar), after
// ICU's SimpleDateFormat::parse in its main lines: each field of the
// pattern read from the text (numbers in ASCII, the locale's or any
// decimal digits, a run of abutting numeric fields by their widths; names
// of eras, months, weekdays and quarters case-insensitively, the longest
// of the first set of names that has one, a final dot optional; day
// periods with ICU's rule for the hour; zone offsets in the localized GMT
// and ISO 8601 forms, the names of the calendar's zone, of the locale's
// metazones and zones, and zone IDs), the literals matched as ICU's
// matchLiterals matches them (leniently: whitespace, a dot after a field
// of names, ignorable punctuation before a field), the fields set on the
// calendar, two-digit years in the century of the format, a range check
// of the fields when not lenient.
const m = @import("./memory.mlx")
const properties = @import("./properties.mlx")
const text = @import("./datetext.mlx")
const symbols = @import("./datesymbols.mlx")
const patterns = @import("./datepatterns.mlx")
const tz = @import("./timezonenames.mlx")
const zones = @import("./zones.mlx")
const resources = @import("./resources.mlx")

extern("c") fn ucal_set(cal: usize, field: i32, value: i32) -> void
extern("c") fn ucal_getMillis(cal: usize, status: usize) -> f64
extern("c") fn ucal_clear(cal: usize) -> void
extern("c") fn ucal_setTimeZone(cal: usize, zoneID: usize, len: i32, status: usize) -> void
extern("c") fn ucal_get(cal: usize, field: i32, status: usize) -> i32
extern("c") fn ucal_isSet(cal: usize, field: i32) -> u8
extern("c") fn ucal_clone(cal: usize, status: usize) -> usize
extern("c") fn ucal_close(cal: usize) -> void

const Text = text.Text

pub const Parse = struct {
    fm: *patterns.Formatter
    lenient: bool
    allowWhitespace: bool
    allowNumeric: bool
    partialLiterals: bool
    centuryStart: f64
    centuryStartYear: i32
}


fn fold(c: u16) -> u32 { return @intCast(u32, properties.simpleFold(@intCast(i32, c))) }

// The digit value of C (ASCII or the locale's digits), -1 for none.
fn digitOf(p: *Parse, c: u16) -> i32 {
    if c >= 48 && c <= 57 { return @intCast(i32, c - 48) }
    var k: usize = 0
    while k < 10 {
        if p.*.fm.*.digits[k] == @intCast(u32, c) { return @intCast(i32, k) }
        k += 1
    }
    // Any decimal digit, as ICU's number parsing takes.
    if properties.category(@intCast(i32, c)) == 9 { return properties.digitValue(@intCast(i32, c)) }
    return -1
}

// The length of the longest name of SET matching SOURCE at AT
// (case-insensitively), its index into INDEX; 0 for none.
fn matchSet(p: *Parse, set: usize, source: *const Text, at: usize, index: *usize) -> usize {
    const s = symbols.of(p.*.fm.*.symbols)
    var best: usize = 0
    var k: usize = 0
    while k < symbols.count(s, set) {
        const name = symbols.get(s, set, k)
        if name.*.length > best {
            // The whole name, or all of it but a final dot.
            var n: usize = 0
            while n < name.*.length && at + n < source.*.length && fold(text.at(name, n)) == fold(text.at(source, at + n)) { n += 1 }
            if n > best && (n == name.*.length || (n + 1 == name.*.length && text.at(name, n) == 46)) {
                best = n
                index.* = k
            }
        }
        k += 1
    }
    return best
}

// The longest match among the sets of SETS (written "\x01\x02...").
// The match in the first of SETS that has one (among the first LIMIT
// names of each).
fn firstOf(p: *Parse, sets: []const u8, limit: usize, source: *const Text, at: usize, index: *usize) -> usize {
    for set in sets {
        var found: usize = 0
        const length = matchSet(p, @intCast(usize, set), source, at, &found)
        if length > 0 && found < limit {
            index.* = found
            return length
        }
    }
    return 0
}

// A number of at most MAX digits (0: any), its value and digit count.
fn number(p: *Parse, source: *const Text, at: usize, max: usize, allowSign: bool, value: *i64, digits: *usize) -> usize {
    var k = at
    var negative = false
    if allowSign && k < source.*.length && (text.at(source, k) == 45 || text.at(source, k) == 8722) {
        negative = true
        k += 1
    }
    var result: i64 = 0
    var count: usize = 0
    while k < source.*.length && (max == 0 || count < max) && count < 18 {
        const d = digitOf(p, text.at(source, k))
        if d < 0 { break }
        result = result * 10 + @intCast(i64, d)
        count += 1
        k += 1
    }
    if count == 0 { return 0 }
    value.* = if negative { -result } else { result }
    digits.* = count
    return k - at
}

// A zone offset in the GMT form (GMT, GMT+1, GMT+01:00, UTC-5) or ISO's
// (Z, +01, +0100, +01:00), in milliseconds; its length.
fn zoneOffset(p: *Parse, source: *const Text, at: usize, offset: *i64) -> usize {
    const zones = tz.of(p.*.fm.*.zones)
    var k = at
    var prefixed = false
    // The locale's GMT zero format and prefix, GMT, UTC, UT.
    const prefixes = "\nGMT\nUTC\nUT\n"
    var length = matchText(source, k, &zones.*.gmtPrefix)
    if length == 0 {
        var n: usize = 0
        while n < 3 && length == 0 {
            var candidate = text.fromUtf8(symbols.listItem(prefixes, n))
            length = matchText(source, k, &candidate)
            text.dispose(&candidate)
            n += 1
        }
    }
    if length > 0 {
        k += length
        prefixed = true
    }
    if k < source.*.length && (text.at(source, k) == 90 || text.at(source, k) == 122) && !prefixed {
        offset.* = 0
        return 1
    }
    if k >= source.*.length || (text.at(source, k) != 43 && text.at(source, k) != 45 && text.at(source, k) != 8722) {
        if prefixed {
            offset.* = 0
            return k - at
        }
        const zero = matchText(source, at, &zones.*.gmtZero)
        if zero > 0 {
            offset.* = 0
            return zero
        }
        return 0
    }
    const negative = text.at(source, k) != 43
    k += 1
    var hours: i64 = 0
    var digits: usize = 0
    var used = number(p, source, k, 2, false, &hours, &digits)
    if used == 0 { return 0 }
    k += used
    var minutes: i64 = 0
    var seconds: i64 = 0
    if k < source.*.length && text.at(source, k) == 58 {
        used = number(p, source, k + 1, 2, false, &minutes, &digits)
        if used == 2 {
            k += 3
            if k < source.*.length && text.at(source, k) == 58 {
                used = number(p, source, k + 1, 2, false, &seconds, &digits)
                if used == 2 { k += 3 }
            }
        }
    } else if digits == 2 {
        used = number(p, source, k, 2, false, &minutes, &digits)
        if used == 2 { k += 2 }
    }
    if hours > 23 || minutes > 59 || seconds > 59 { return 0 }
    const total = ((hours * 60 + minutes) * 60 + seconds) * 1000
    offset.* = if negative { -total } else { total }
    if p.*.fm.*.zones != 0 && length > 0 {
        k += matchText(source, k, &zones.*.gmtSuffix)
    }
    return k - at
}

fn matchText(source: *const Text, at: usize, expected: *const Text) -> usize {
    if expected.*.length == 0 || at + expected.*.length > source.*.length { return 0 }
    var n: usize = 0
    while n < expected.*.length && fold(text.at(expected, n)) == fold(text.at(source, at + n)) { n += 1 }
    return if n == expected.*.length { n } else { 0 }
}

// The calendar's zone's names (specific and generic, long and short)
// matched: the offsets of the zone at its moment.
fn zoneName(p: *Parse, cal: usize, source: *const Text, at: usize, kind: *i64) -> usize {
    var fields: patterns.Fields = undefined
    var local: i32 = 0
    if !patterns.readCalendar(cal, &fields, @intFromPtr(&local)) { return 0 }
    const styles = [6]i32{ tz.SPECIFIC_LONG, tz.SPECIFIC_SHORT, tz.GENERIC_LONG, tz.GENERIC_SHORT, tz.GENERIC_LOCATION, tz.ZONE_ID }
    var best: usize = 0
    var k: usize = 0
    while k < 6 {
        var name = text.empty()
        // Standard and daylight forms of the specific names.
        var pass: usize = 0
        while pass < 2 {
            var z = fields.zone
            z.save = if pass == 1 { 3600000 } else { 0 }
            text.clear(&name)
            tz.format(tz.of(p.*.fm.*.zones), styles[k], &z, &name)
            const length = matchText(source, at, &name)
            if length > best {
                best = length
                kind.* = if k >= 2 { 0 } else if pass == 1 { 2 } else { 1 }
            }
            pass += 1
        }
        text.dispose(&name)
        k += 1
    }
    return best
}

// The longest of the locale's names of metazones and zones at AT (as
// ICU's TimeZoneFormat finds them): the zone (a metazone's for the
// locale's region) into ZONE, the kind of name (0 generic, 1 standard, 2
// daylight); its length, 0 for none.
fn anyZoneName(p: *Parse, source: *const Text, at: usize, zone: *m.Bytes, kind: *i64) -> usize {
    const f = tz.of(p.*.fm.*.zones)
    var best: usize = 0
    var pass: usize = 0
    while pass < 2 {
        const prefix = if pass == 0 { "dates/timeZoneNames/metazone" } else { "dates/timeZoneNames/zone" }
        var first: u32 = 0
        var end: u32 = 0
        resources.below(prefix, &first, &end)
        var key = first
        while key < end {
            const name = resources.keyName(key)
            // PREFIX/ID/(long|short)/(generic|standard|daylight)
            var slash = name.length
            while slash > 0 && name[slash - 1] != 47 { slash -= 1 }
            const form = name[slash..name.length]
            var middle = if slash > 0 { slash - 1 } else { 0 }
            while middle > 0 && name[middle - 1] != 47 { middle -= 1 }
            const named = m.same(form, "generic") || m.same(form, "standard") || m.same(form, "daylight")
            var value: []const u8 = ""
            if named && middle > prefix.length + 1 && resources.lookup(f.*.data, name, &value) && value.length > 0 {
                var candidate = text.fromUtf8(value)
                const length = matchText(source, at, &candidate)
                text.dispose(&candidate)
                if length > best {
                    best = length
                    kind.* = if m.same(form, "daylight") { 2 } else if m.same(form, "standard") { 1 } else { 0 }
                    zone.*.length = 0
                    const id = name[prefix.length + 1..middle - 1]
                    if pass == 0 {
                        const region = f.*.region
                        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &region) }
                        tz.referenceZone(id, view[0..f.*.regionLength], zone)
                    } else {
                        m.pushText(zone, id)
                    }
                }
            }
            key += 1
        }
        pass += 1
    }
    return best
}

// The length of the longest zone ID at AT, copied into ID; 0 for none.
fn zoneIdAt(source: *const Text, at: usize, id: *[64]u16) -> usize {
    var bytes: [64]u8 = undefined
    var n: usize = 0
    while n < 64 && at + n < source.*.length {
        const c = text.at(source, at + n)
        if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 47 || c == 43 || c == 45) { break }
        bytes[n] = @intCast(u8, c)
        id.*[n] = c
        n += 1
    }
    while n > 0 {
        const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &bytes) }
        if zones.find(view[0..n]) != zones.NONE { return n }
        n -= 1
    }
    return 0
}

fn isNumericField(c: u16, count: usize) -> bool { return patterns.isNumeric(c, count) }

fn setField(cal: usize, field: usize, value: i64) -> void { ucal_set(cal, @intCast(i32, field), @intCast(i32, value)) }

// One field at AT; its length (0 when it does not match).
// What the fields parsed so far leave for the end: the hour of the
// half day, the half day, the hour of the day, the day period.
const State = struct {
    ambiguousYear: bool
    hourOfPeriod: i64
    period: i64
    hourOfDay: i64
    dayPeriod: i64
    zoneType: i64
    zoneId: [64]u16
    zoneIdLength: usize
}

fn subParse(p: *Parse, source: *const Text, at: usize, c: u16, count: usize, obeyCount: bool, cal: usize, state: *State) -> usize {
    var k = at
    // Leading whitespace of a field is skipped.
    while k < source.*.length && patternSpace(text.at(source, k)) && whiteSpace(text.at(source, k)) { k += 1 }
    if k >= source.*.length { return 0 }
    const index = patterns.letterIndex(c)
    if index == patterns.FIELD_COUNT { return 0 }
    var value: i64 = 0
    var digits: usize = 0
    const max = if obeyCount { count } else { 0 }
    var found: usize = 0
    if index == patterns.ERA_FIELD {
        const length = matchSet(p, if count == 5 { symbols.NARROW_ERAS } else if count == 4 { symbols.ERA_NAMES } else { symbols.ERAS }, source, k, &found)
        if length == 0 { return 0 }
        setField(cal, patterns.ERA, @intCast(i64, found))
        return k + length - at
    }
    if index == patterns.MONTH_FIELD || index == patterns.STANDALONE_MONTH_FIELD {
        if count <= 2 || (p.*.allowNumeric && digitOf(p, text.at(source, k)) >= 0) {
            const used = number(p, source, k, max, false, &value, &digits)
            if used == 0 { return 0 }
            if !p.*.lenient && (value < 1 || value > 12) { return 0 }
            setField(cal, patterns.MONTH, value - 1)
            return k + used - at
        }
        // The wide and abbreviated names of the field's context.
        const length = firstOf(p, if index == patterns.MONTH_FIELD { "\x01\x02" } else { "\x0a\x0b" }, 99, source, k, &found)
        if length == 0 { return 0 }
        setField(cal, patterns.MONTH, @intCast(i64, found))
        return k + length - at
    }
    if index == patterns.DAY_OF_WEEK_FIELD || ((index == patterns.DOW_LOCAL_FIELD || index == patterns.STANDALONE_DAY_FIELD) && count >= 3) {
        const length = firstOf(p, if index == patterns.STANDALONE_DAY_FIELD { "\x0d\x0e\x15" } else { "\x03\x04\x14\x09" }, 99, source, k, &found)
        if length == 0 { return 0 }
        setField(cal, patterns.DAY_OF_WEEK, @intCast(i64, found))
        return k + length - at
    }
    if (index == patterns.QUARTER_FIELD || index == patterns.STANDALONE_QUARTER_FIELD) && count >= 3 {
        const length = firstOf(p, if index == patterns.QUARTER_FIELD { "\x10\x11\x1c" } else { "\x12\x13\x1d" }, 99, source, k, &found)
        if length == 0 { return 0 }
        setField(cal, patterns.MONTH, @intCast(i64, found) * 3)
        return k + length - at
    }
    if index == patterns.AM_PM_FIELD || index == patterns.AM_PM_MIDNIGHT_NOON_FIELD {
        const length = firstOf(p, "\x05\x1f", 2, source, k, &found)
        if length > 0 {
            state.*.period = @intCast(i64, found)
            return k + length - at
        }
        if index == patterns.AM_PM_FIELD { return 0 }
    }
    if index == patterns.AM_PM_MIDNIGHT_NOON_FIELD || index == patterns.FLEXIBLE_DAY_PERIOD_FIELD {
        // The day periods (b: midnight and noon only), by their hours at
        // the end.
        const length = firstOf(p, "\x20\x22\x21", if index == patterns.FLEXIBLE_DAY_PERIOD_FIELD { 10 } else { 2 }, source, k, &found)
        if length == 0 { return 0 }
        state.*.dayPeriod = @intCast(i64, found)
        return k + length - at
    }
    if index == patterns.TIMEZONE_FIELD || index == patterns.TIMEZONE_RFC_FIELD || index == patterns.TIMEZONE_GENERIC_FIELD || index == patterns.TIMEZONE_SPECIAL_FIELD || index == patterns.TIMEZONE_LOCALIZED_GMT_OFFSET_FIELD || index == patterns.TIMEZONE_ISO_FIELD || index == patterns.TIMEZONE_ISO_LOCAL_FIELD {
        var offset: i64 = 0
        var length = zoneOffset(p, source, k, &offset)
        var kind: i64 = 0
        const name = zoneName(p, cal, source, k, &kind)
        const idLength = zoneIdAt(source, k, &state.*.zoneId)
        if idLength > name && idLength > length {
            // A zone's ID: the calendar's zone at the end.
            state.*.zoneIdLength = idLength
            return k + idLength - at
        }
        if name > length {
            // The calendar's own zone: its standard or daylight offsets
            // at the end.
            state.*.zoneType = kind
            return k + name - at
        }
        if name == 0 {
            // The name of another zone: the calendar's zone at the end.
            var other: m.Bytes = m.bytesBuffer()
            const named = anyZoneName(p, source, k, &other, &kind)
            if named > length && other.length > 0 && other.length < 64 {
                var n: usize = 0
                for byte in m.bytesText(&other) {
                    state.*.zoneId[n] = @intCast(u16, byte)
                    n += 1
                }
                state.*.zoneIdLength = n
                state.*.zoneType = kind
                m.disposeBytes(&other)
                return k + named - at
            }
            m.disposeBytes(&other)
        }
        if length == 0 { return 0 }
        setField(cal, patterns.ZONE_OFFSET, offset)
        setField(cal, patterns.DST_OFFSET, 0)
        return k + length - at
    }
    // The numeric fields.
    const allowSign = index == patterns.EXTENDED_YEAR_FIELD || index == patterns.JULIAN_DAY_FIELD || index == patterns.RELATED_YEAR_FIELD
    const used = number(p, source, k, max, allowSign, &value, &digits)
    if used == 0 { return 0 }
    const end = k + used
    // Strict: the value in the range of its field (ICU's range bias).
    if !p.*.lenient {
        if index == patterns.DATE_FIELD && (value < 1 || value > 31) { return 0 }
        if (index == patterns.MINUTE_FIELD || index == patterns.SECOND_FIELD) && value > 59 { return 0 }
        if index == patterns.STANDALONE_DAY_FIELD && (value < 1 || value > 7) { return 0 }
    }
    if index == patterns.YEAR_FIELD || index == patterns.YEAR_WOY_FIELD || index == patterns.YEAR_NAME_FIELD {
        // Two digits (as yy has them) in the century of the format.
        if count <= 2 && digits == 2 {
            const start = @intCast(i64, p.*.centuryStartYear)
            const ambiguous = start % 100
            state.*.ambiguousYear = value == ambiguous
            value += start / 100 * 100 + (if value < ambiguous { 100 } else { 0 })
        }
        setField(cal, if index == patterns.YEAR_WOY_FIELD { patterns.YEAR_WOY } else { patterns.YEAR }, value)
    } else if index == patterns.EXTENDED_YEAR_FIELD || index == patterns.RELATED_YEAR_FIELD {
        setField(cal, patterns.EXTENDED_YEAR, value)
    } else if index == patterns.DATE_FIELD {
        setField(cal, patterns.DATE, value)
    } else if index == patterns.HOUR_OF_DAY1_FIELD {
        state.*.hourOfDay = if value == 24 { 0 } else { value }
        setField(cal, patterns.HOUR_OF_DAY, state.*.hourOfDay)
    } else if index == patterns.HOUR_OF_DAY0_FIELD {
        state.*.hourOfDay = value
        setField(cal, patterns.HOUR_OF_DAY, value)
    } else if index == patterns.HOUR1_FIELD || index == patterns.HOUR0_FIELD {
        state.*.hourOfPeriod = if index == patterns.HOUR1_FIELD && value == 12 { 0 } else { value }
    } else if index == patterns.MINUTE_FIELD {
        setField(cal, patterns.MINUTE, value)
    } else if index == patterns.SECOND_FIELD {
        setField(cal, patterns.SECOND, value)
    } else if index == patterns.FRACTIONAL_SECOND_FIELD {
        // Digits of the fraction: milliseconds.
        var ms = value
        var n = digits
        while n < 3 {
            ms *= 10
            n += 1
        }
        while n > 3 {
            ms /= 10
            n -= 1
        }
        setField(cal, patterns.MILLISECOND, ms)
    } else if index == patterns.DAY_OF_YEAR_FIELD {
        setField(cal, patterns.DAY_OF_YEAR, value)
    } else if index == patterns.DAY_OF_WEEK_IN_MONTH_FIELD {
        setField(cal, patterns.DAY_OF_WEEK_IN_MONTH, value)
    } else if index == patterns.WEEK_OF_YEAR_FIELD {
        setField(cal, patterns.WEEK_OF_YEAR, value)
    } else if index == patterns.WEEK_OF_MONTH_FIELD {
        setField(cal, patterns.WEEK_OF_MONTH, value)
    } else if index == patterns.DOW_LOCAL_FIELD || index == patterns.STANDALONE_DAY_FIELD {
        setField(cal, patterns.DOW_LOCAL, value)
    } else if index == patterns.QUARTER_FIELD || index == patterns.STANDALONE_QUARTER_FIELD {
        setField(cal, patterns.MONTH, (value - 1) * 3)
    } else if index == patterns.JULIAN_DAY_FIELD {
        setField(cal, patterns.JULIAN_DAY, value)
    } else if index == patterns.MILLISECONDS_IN_DAY_FIELD {
        setField(cal, patterns.MILLISECONDS_IN_DAY, value)
    }
    return end - at
}

const Item = struct {
    // A field (letter, count) or a literal (its text).
    letter: u16
    count: usize
    literal: Text
}

// The pattern as items.
fn items(pattern: *const Text, into: *[64]Item) -> usize {
    var count: usize = 0
    var inQuote = false
    var index: usize = 0
    var literal = text.empty()
    while index < pattern.*.length && count < 63 {
        const c = text.at(pattern, index)
        if c == 39 {
            if index + 1 < pattern.*.length && text.at(pattern, index + 1) == 39 {
                text.push(&literal, 39)
                index += 2
                continue
            }
            inQuote = !inQuote
            index += 1
            continue
        }
        if !inQuote && text.isLetter(c) {
            if literal.length > 0 {
                into.*[count] = Item.{ .letter = 0, .count = 0, .literal = literal }
                count += 1
                literal = text.empty()
            }
            var end = index
            while end < pattern.*.length && text.at(pattern, end) == c { end += 1 }
            into.*[count] = Item.{ .letter = c, .count = end - index, .literal = text.empty() }
            count += 1
            index = end
            continue
        }
        text.push(&literal, c)
        index += 1
    }
    if literal.length > 0 && count < 64 {
        into.*[count] = Item.{ .letter = 0, .count = 0, .literal = literal }
        count += 1
    } else {
        text.dispose(&literal)
    }
    return count
}

// Pattern_White_Space, White_Space and u_isWhitespace.
fn patternSpace(c: u16) -> bool { return (c >= 9 && c <= 13) || c == 32 || c == 0x85 || c == 0x200E || c == 0x200F || c == 0x2028 || c == 0x2029 }
fn whiteSpace(c: u16) -> bool { return (c >= 9 && c <= 13) || c == 32 || c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000 }
fn javaSpace(c: u16) -> bool { return (c >= 9 && c <= 13) || (c >= 0x1C && c <= 0x20) || c == 0x1680 || (c >= 0x2000 && c <= 0x200A && c != 0x2007) || c == 0x2028 || c == 0x2029 || c == 0x205F || c == 0x3000 }

// What a literal that does not match may be read as before the field of
// letter NEXT (ICU's ignorables).
fn ignorable(next: u16, c: u16) -> bool {
    if whiteSpace(c) { return true }
    const index = patterns.letterIndex(next)
    if index == patterns.YEAR_FIELD || index == patterns.MONTH_FIELD || index == patterns.DATE_FIELD || index == patterns.STANDALONE_DAY_FIELD || index == patterns.STANDALONE_MONTH_FIELD { return c == 45 || c == 44 || c == 46 || c == 47 }
    if index == patterns.HOUR_OF_DAY1_FIELD || index == patterns.HOUR_OF_DAY0_FIELD || index == patterns.MINUTE_FIELD || index == patterns.SECOND_FIELD || index == patterns.HOUR1_FIELD || index == patterns.HOUR0_FIELD { return c == 45 || c == 46 || c == 58 }
    return false
}

// A literal at AT (ICU's matchLiterals), between the field PREVIOUS
// (letter 0 for none) and the field of letter NEXT (0 for none); its
// length, NOT_FOUND when it does not match.
fn matchLiteral(p: *Parse, item: *const Item, previous: *const Item, next: u16, source: *const Text, at: usize) -> usize {
    const literal = &item.*.literal
    var first: usize = 0
    var last = literal.*.length
    var t = at
    const lenientSpace = p.*.allowWhitespace
    if lenientSpace {
        while first < last && javaSpace(text.at(literal, first)) { first += 1 }
        while last > first && javaSpace(text.at(literal, last - 1)) { last -= 1 }
        while t < source.*.length && javaSpace(text.at(source, t)) { t += 1 }
    }
    var i = first
    while i < last && t < source.*.length {
        var needSpace = false
        while i < last && patternSpace(text.at(literal, i)) {
            needSpace = true
            i += 1
        }
        if needSpace {
            const before = t
            while t < source.*.length && (whiteSpace(text.at(source, t)) || patternSpace(text.at(source, t))) { t += 1 }
            if !lenientSpace && t == before { return text.NOT_FOUND }
            if i >= last { break }
        }
        if t >= source.*.length || text.at(literal, i) != text.at(source, t) {
            if lenientSpace {
                // A dot after a field of names (as "12. h").
                if t == at && t < source.*.length && text.at(source, t) == 46 && previous.*.letter != 0 && !isNumericField(previous.*.letter, previous.*.count) {
                    t += 1
                    continue
                }
                if t < source.*.length && patternSpace(text.at(source, t)) {
                    t += 1
                    continue
                }
            }
            if p.*.partialLiterals && p.*.lenient { break }
            return text.NOT_FOUND
        }
        i += 1
        t += 1
    }
    if i <= first {
        // Nothing matched: whitespace and ignorables taken instead.
        t = at
        while t < source.*.length && next != 0 && ignorable(next, text.at(source, t)) { t += 1 }
    }
    return t - at
}

// The middle of the hours of day period PERIOD, in hours; -1 when the
// locale has none such.
fn midPoint(p: *Parse, period: i64) -> f64 {
    if period == 0 { return 0.0 }
    if period == 1 { return 12.0 }
    const hours = &p.*.fm.*.periods.hours
    var start: i64 = -1
    var h: i64 = 0
    while h < 24 {
        if hours.*[@intCast(usize, h)] == @intCast(i32, period) && hours.*[@intCast(usize, (h + 23) % 24)] != @intCast(i32, period) { start = h }
        h += 1
    }
    if start < 0 { return -1.0 }
    var end = start
    while hours.*[@intCast(usize, end % 24)] == @intCast(i32, period) && end < start + 24 { end += 1 }
    var middle = @floatFromInt(f64, start + end) / 2.0
    if middle >= 24.0 { middle -= 24.0 }
    return middle
}

// The hour of a day period parsed (ICU's rule, with the calendar's
// fields as they are set): with no hour its middle; a 12-hour hour in the
// half of the day nearest it.
fn applyDayPeriod(p: *Parse, cal: usize, state: *State) -> void {
    const middle = midPoint(p, state.*.dayPeriod)
    if middle < 0.0 { return }
    const hourSet = ucal_isSet(cal, @intCast(i32, patterns.HOUR)) != 0
    const hourOfDaySet = ucal_isSet(cal, @intCast(i32, patterns.HOUR_OF_DAY)) != 0
    if !hourSet && !hourOfDaySet {
        const hour = @intFromFloat(i64, middle)
        setField(cal, patterns.HOUR_OF_DAY, hour)
        setField(cal, patterns.MINUTE, if middle - @floatFromInt(f64, hour) > 0.0 { 30 } else { 0 })
        return
    }
    var status: i32 = 0
    var hour: i64 = 0
    if hourOfDaySet {
        hour = @intCast(i64, ucal_get(cal, @intCast(i32, patterns.HOUR_OF_DAY), @intFromPtr(&status)))
    } else {
        hour = @intCast(i64, ucal_get(cal, @intCast(i32, patterns.HOUR), @intFromPtr(&status)))
        if hour == 0 { hour = 12 }
    }
    if hour == 0 || (hour >= 13 && hour <= 23) {
        setField(cal, patterns.HOUR_OF_DAY, hour)
        return
    }
    if hour == 12 { hour = 0 }
    const minute = ucal_get(cal, @intCast(i32, patterns.MINUTE), @intFromPtr(&status))
    const ahead = @floatFromInt(f64, hour) + @floatFromInt(f64, minute) / 60.0 - middle
    setField(cal, patterns.AM_PM, if ahead >= -6.0 && ahead < 6.0 { 0 } else { 1 })
}

// A standard (1) or daylight (2) name of the calendar's zone parsed: its
// offsets at the moment parsed made so (an hour of daylight saving when
// the zone has none then).
fn applyZoneType(cal: usize, kind: i64) -> void {
    var status: i32 = 0
    const copy = ucal_clone(cal, @intFromPtr(&status))
    if copy == 0 { return }
    _ = ucal_getMillis(copy, @intFromPtr(&status))
    const raw = ucal_get(copy, @intCast(i32, patterns.ZONE_OFFSET), @intFromPtr(&status))
    const save = ucal_get(copy, @intCast(i32, patterns.DST_OFFSET), @intFromPtr(&status))
    ucal_close(copy)
    if status > 0 { return }
    if kind == 1 && save != 0 {
        setField(cal, patterns.ZONE_OFFSET, @intCast(i64, raw))
        setField(cal, patterns.DST_OFFSET, 0)
    } else if kind == 2 && save == 0 {
        setField(cal, patterns.ZONE_OFFSET, @intCast(i64, raw))
        setField(cal, patterns.DST_OFFSET, 3600000)
    }
}

// A zone's ID parsed: the wall time read in it (the fields set again
// after the calendar's zone changes, as ucal_setTimeZone keeps the
// moment).
fn applyZone(cal: usize, state: *State) -> void {
    var status: i32 = 0
    _ = ucal_getMillis(cal, @intFromPtr(&status))
    if status > 0 { return }
    const fields = [8]usize{ patterns.ERA, patterns.YEAR, patterns.MONTH, patterns.DATE, patterns.HOUR_OF_DAY, patterns.MINUTE, patterns.SECOND, patterns.MILLISECOND }
    var values: [8]i32 = undefined
    var k: usize = 0
    while k < 8 {
        values[k] = ucal_get(cal, @intCast(i32, fields[k]), @intFromPtr(&status))
        k += 1
    }
    ucal_setTimeZone(cal, @intFromPtr(&state.*.zoneId), @intCast(i32, state.*.zoneIdLength), @intFromPtr(&status))
    k = 0
    while k < 8 {
        setField(cal, fields[k], @intCast(i64, values[k]))
        k += 1
    }
}

// Parses SOURCE from POSITION by PATTERN into calendar CAL (cleared
// first when CLEAR); the moment, POSITION moved past what was parsed,
// ERRORINDEX the index of the failure (-1 for none).
pub fn parse(p: *Parse, pattern: *const Text, source: *const Text, cal: usize, position: *i32, errorIndex: *i32) -> f64 {
    if position.* < 0 || @intCast(usize, position.*) > source.*.length {
        errorIndex.* = 0
        return 0.0
    }
    var list: [64]Item = undefined
    const count = items(pattern, &list)
    var at = @intCast(usize, position.*)
    const start = at
    const none = Item.{ .letter = 0, .count = 0, .literal = text.empty() }
    var state = State.{ .ambiguousYear = false, .hourOfPeriod = -1, .period = -1, .hourOfDay = -1, .dayPeriod = -1, .zoneType = 0, .zoneId = undefined, .zoneIdLength = 0 }
    var failed = false
    var i: usize = 0
    while i < count {
        const item = &list[i]
        if item.*.letter == 0 {
            const previous = if i > 0 { &list[i - 1] } else { &none }
            const next = if i + 1 < count { list[i + 1].letter } else { 0 }
            const length = matchLiteral(p, item, previous, next, source, at)
            if length == text.NOT_FOUND {
                failed = true
                break
            }
            at += length
        } else {
            // A numeric field followed by another one takes its width.
            const abuts = i + 1 < count && list[i + 1].letter != 0 && isNumericField(item.*.letter, item.*.count) && isNumericField(list[i + 1].letter, list[i + 1].count)
            const length = subParse(p, source, at, item.*.letter, item.*.count, abuts, cal, &state)
            if length == 0 {
                failed = true
                break
            }
            at += length
        }
        i += 1
    }
    i = 0
    while i < count {
        text.dispose(&list[i].literal)
        i += 1
    }
    if failed {
        errorIndex.* = @intCast(i32, at)
        position.* = @intCast(i32, start)
        return 0.0
    }
    if state.hourOfPeriod >= 0 { setField(cal, patterns.HOUR, state.hourOfPeriod) }
    if state.period >= 0 { setField(cal, patterns.AM_PM, state.period) }
    if state.dayPeriod >= 0 { applyDayPeriod(p, cal, &state) }
    if state.zoneIdLength > 0 { applyZone(cal, &state) }
    if state.zoneType != 0 { applyZoneType(cal, state.zoneType) }
    if state.ambiguousYear {
        // The year of the century's start: before the start it is the
        // next century's.
        var cloned: i32 = 0
        const copy = ucal_clone(cal, @intFromPtr(&cloned))
        if copy != 0 {
            const parsed = ucal_getMillis(copy, @intFromPtr(&cloned))
            if cloned <= 0 && parsed < p.*.centuryStart { setField(cal, patterns.YEAR, @intCast(i64, p.*.centuryStartYear) + 100) }
            ucal_close(copy)
        }
    }
    var local: i32 = 0
    const date = ucal_getMillis(cal, @intFromPtr(&local))
    if local > 0 {
        errorIndex.* = @intCast(i32, start)
        return 0.0
    }
    position.* = @intCast(i32, at)
    return date
}

pub fn clear(cal: usize) -> void { ucal_clear(cal) }
