// The macros of the API modules, run as the Mlx they are written in: what
// they read of UTF-8 and UTF-16 (the C headers made of them must do the
// same; tests/macros.c runs those).
const umachine = @import("../api/umachine.mlx")
const uvernum = @import("../api/uvernum.mlx")
const uversion = @import("../api/uversion.mlx")
const uconfig = @import("../api/uconfig.mlx")
const utypes = @import("../api/utypes.mlx")
const utf = @import("../api/utf.mlx")
const utf8 = @import("../api/utf8.mlx")
const utf16 = @import("../api/utf16.mlx")
const ugenerated = @import("../api/ugenerated.mlx")
const uchar = @import("../api/uchar.mlx")
const uscript = @import("../api/uscript.mlx")
const ustring = @import("../api/ustring.mlx")
const utext = @import("../api/utext.mlx")
const parseerr = @import("../api/parseerr.mlx")
const uloc = @import("../api/uloc.mlx")
const uenum = @import("../api/uenum.mlx")
const uiter = @import("../api/uiter.mlx")
const ubrk = @import("../api/ubrk.mlx")
const unorm2 = @import("../api/unorm2.mlx")
const uidna = @import("../api/uidna.mlx")
const uset = @import("../api/uset.mlx")
const ucol = @import("../api/ucol.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    // "aé€😀" and an ill-formed byte.
    const text: [12]u8 = [12]u8{ 0x61, 0xc3, 0xa9, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80, 0xff, 0x62 }
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &text) }
    const expected: [6]i32 = [6]i32{ 0x61, 0xe9, 0x20ac, 0x1f600, -1, 0x62 }
    var i: i64 = 0
    var n: usize = 0
    while i < 12 {
        var c: i32 = 0
        utf8.U8_NEXT(bytes, &i, 12, &c)
        if c != expected[n] { return 1 }
        n += 1
    }
    if n != 6 { return 2 }
    // Back again.
    var back: i64 = 12
    var c: i32 = 0
    utf8.U8_PREV(bytes, 0, &back, &c)
    if c != 0x62 || back != 11 { return 3 }
    back = 10
    utf8.U8_PREV(bytes, 0, &back, &c)
    if c != 0x1f600 || back != 6 { return 4 }
    // UTF-16: the same four, written and read.
    var units: [8]u16 = undefined
    const writable: [*]u16 = unsafe { @ptrCast([*]u16, &units) }
    var length: i64 = 0
    var failed = false
    utf16.U16_APPEND(writable, &length, 8, 0x61, &failed)
    utf16.U16_APPEND(writable, &length, 8, 0x1f600, &failed)
    if length != 3 || failed { return 5 }
    var j: i64 = 0
    utf16.U16_NEXT(writable, &j, length, &c)
    if c != 0x61 { return 6 }
    utf16.U16_NEXT(writable, &j, length, &c)
    if c != 0x1f600 || j != 3 { return 7 }
    if !utf.U_IS_SURROGATE(0xd800) || utf.U_IS_SURROGATE(0xe000) { return 8 }
    if !utypes.U_SUCCESS(utypes.UErrorCode.U_ZERO_ERROR) || utypes.U_SUCCESS(utypes.UErrorCode.U_BUFFER_OVERFLOW_ERROR) { return 9 }
    // The declarations of every module are what C sees: a few of them.
    if @intFromEnum(uchar.UProperty.UCHAR_SCRIPT) != 0x100a { return 10 }
    if uchar.U_GC_L_MASK != 62 { return 11 }
    if @intFromEnum(ubrk.UBreakIteratorType.UBRK_LINE) != 2 { return 12 }
    if utext.UTEXT_MAGIC != 0x345ad82c { return 13 }
    if @intFromEnum(ucol.UColAttributeValue.UCOL_SHIFTED) != 20 { return 14 }
    if @intFromEnum(ugenerated.UScriptCode.USCRIPT_COMMON) != 0 { return 15 }
    return 0
}
