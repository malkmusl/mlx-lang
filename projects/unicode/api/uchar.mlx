pub extern("c") fn u_getPropertyEnum(alias: [*]const umachine.c_char) -> UProperty
pub extern("c") fn u_getPropertyName(property: UProperty, nameChoice: UPropertyNameChoice) -> [*]const umachine.c_char
pub extern("c") fn u_getPropertyValueEnum(property: UProperty, alias: [*]const umachine.c_char) -> i32
pub extern("c") fn u_getPropertyValueName(property: UProperty, value: i32, nameChoice: UPropertyNameChoice) -> [*]const umachine.c_char
pub extern("c") fn u_charType(c: umachine.UChar32) -> i8
pub extern("c") fn u_charDirection(c: umachine.UChar32) -> UCharDirection
