    U_ENCLOSING_MARK = 7,
    U_COMBINING_SPACING_MARK = 8,
    U_DECIMAL_DIGIT_NUMBER = 9,
    U_LETTER_NUMBER = 10,
    U_OTHER_NUMBER = 11,
    U_SPACE_SEPARATOR = 12,
    U_LINE_SEPARATOR = 13,
    U_PARAGRAPH_SEPARATOR = 14,
    U_CONTROL_CHAR = 15,
    U_FORMAT_CHAR = 16,
    U_PRIVATE_USE_CHAR = 17,
    U_SURROGATE = 18,
    U_DASH_PUNCTUATION = 19,
    U_START_PUNCTUATION = 20,
    U_END_PUNCTUATION = 21,
    U_CONNECTOR_PUNCTUATION = 22,
    U_OTHER_PUNCTUATION = 23,
    U_MATH_SYMBOL = 24,
    U_CURRENCY_SYMBOL = 25,
    U_MODIFIER_SYMBOL = 26,
    U_OTHER_SYMBOL = 27,
    U_INITIAL_PUNCTUATION = 28,
    U_FINAL_PUNCTUATION = 29,
    U_CHAR_CATEGORY_COUNT,
}
pub const U_GENERAL_OTHER_TYPES: UCharCategory = UCharCategory.U_UNASSIGNED

// The general categories as masks (of U_MASK), and groups of them.
pub fn U_MASK(x: i32) -> u32 { return @intCast(u32, 1) << @intCast(u5, x) }
pub fn U_GET_GC_MASK(c: umachine.UChar32) -> u32 { return U_MASK(@intCast(i32, u_charType(c))) }
pub const U_GC_CN_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_UNASSIGNED)
pub const U_GC_LU_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_UPPERCASE_LETTER)
pub const U_GC_LL_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_LOWERCASE_LETTER)
pub const U_GC_LT_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_TITLECASE_LETTER)
pub const U_GC_LM_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_MODIFIER_LETTER)
pub const U_GC_LO_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_OTHER_LETTER)
pub const U_GC_MN_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_NON_SPACING_MARK)
pub const U_GC_ME_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_ENCLOSING_MARK)
pub const U_GC_MC_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_COMBINING_SPACING_MARK)
pub const U_GC_ND_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_DECIMAL_DIGIT_NUMBER)
pub const U_GC_NL_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_LETTER_NUMBER)
pub const U_GC_NO_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_OTHER_NUMBER)
pub const U_GC_ZS_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_SPACE_SEPARATOR)
pub const U_GC_ZL_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_LINE_SEPARATOR)
pub const U_GC_ZP_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_PARAGRAPH_SEPARATOR)
pub const U_GC_CC_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_CONTROL_CHAR)
pub const U_GC_CF_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_FORMAT_CHAR)
pub const U_GC_CO_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_PRIVATE_USE_CHAR)
pub const U_GC_CS_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_SURROGATE)
pub const U_GC_PD_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_DASH_PUNCTUATION)
pub const U_GC_PS_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_START_PUNCTUATION)
pub const U_GC_PE_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_END_PUNCTUATION)
pub const U_GC_PC_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_CONNECTOR_PUNCTUATION)
pub const U_GC_PO_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_OTHER_PUNCTUATION)
pub const U_GC_SM_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_MATH_SYMBOL)
pub const U_GC_SC_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_CURRENCY_SYMBOL)
pub const U_GC_SK_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_MODIFIER_SYMBOL)
pub const U_GC_SO_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_OTHER_SYMBOL)
pub const U_GC_PI_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_INITIAL_PUNCTUATION)
pub const U_GC_PF_MASK: u32 = 1 << @intFromEnum(UCharCategory.U_FINAL_PUNCTUATION)
pub const U_GC_L_MASK: u32 = U_GC_LU_MASK | U_GC_LL_MASK | U_GC_LT_MASK | U_GC_LM_MASK | U_GC_LO_MASK
pub const U_GC_LC_MASK: u32 = U_GC_LU_MASK | U_GC_LL_MASK | U_GC_LT_MASK
pub const U_GC_M_MASK: u32 = U_GC_MN_MASK | U_GC_ME_MASK | U_GC_MC_MASK
pub const U_GC_N_MASK: u32 = U_GC_ND_MASK | U_GC_NL_MASK | U_GC_NO_MASK
pub const U_GC_Z_MASK: u32 = U_GC_ZS_MASK | U_GC_ZL_MASK | U_GC_ZP_MASK
pub const U_GC_C_MASK: u32 = U_GC_CN_MASK | U_GC_CC_MASK | U_GC_CF_MASK | U_GC_CO_MASK | U_GC_CS_MASK
pub const U_GC_P_MASK: u32 = U_GC_PD_MASK | U_GC_PS_MASK | U_GC_PE_MASK | U_GC_PC_MASK | U_GC_PO_MASK | U_GC_PI_MASK | U_GC_PF_MASK
pub const U_GC_S_MASK: u32 = U_GC_SM_MASK | U_GC_SC_MASK | U_GC_SK_MASK | U_GC_SO_MASK

