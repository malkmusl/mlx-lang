// unicode/ures.h
// mlx-unicode: resource bundles (ICU's locale data by key and index).
const uenum = @import("./uenum.mlx")
const uloc = @import("./uloc.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UResourceBundle = struct {}

pub const UResType = enum(i32, nonexhaustive) {
    URES_NONE = -1,
    URES_STRING = 0,
    URES_BINARY = 1,
    URES_TABLE = 2,
    URES_ALIAS = 3,
    URES_INT = 7,
    URES_ARRAY = 8,
    URES_INT_VECTOR = 14,
    RES_RESERVED = 15,
    URES_LIMIT = 16,
}

pub extern("c") fn ures_open(packageName: [*]const umachine.c_char, locale: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UResourceBundle
pub extern("c") fn ures_openDirect(packageName: [*]const umachine.c_char, locale: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UResourceBundle
pub extern("c") fn ures_openU(packageName: [*]const umachine.UChar, locale: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UResourceBundle
pub extern("c") fn ures_close(resourceBundle: *UResourceBundle) -> void
pub extern("c") fn ures_getVersion(resB: *const UResourceBundle, versionInfo: [*]u8) -> void
pub extern("c") fn ures_getLocaleByType(resourceBundle: *const UResourceBundle, type_: uloc.ULocDataLocaleType, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ures_getString(resourceBundle: *const UResourceBundle, len: *i32, status: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ures_getUTF8String(resB: *const UResourceBundle, dest: [*]umachine.c_char, length: *i32, forceCopy: umachine.UBool, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ures_getBinary(resourceBundle: *const UResourceBundle, len: *i32, status: *utypes.UErrorCode) -> [*]const u8
pub extern("c") fn ures_getIntVector(resourceBundle: *const UResourceBundle, len: *i32, status: *utypes.UErrorCode) -> *const i32
pub extern("c") fn ures_getUInt(resourceBundle: *const UResourceBundle, status: *utypes.UErrorCode) -> u32
pub extern("c") fn ures_getInt(resourceBundle: *const UResourceBundle, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ures_getSize(resourceBundle: *const UResourceBundle) -> i32
pub extern("c") fn ures_getType(resourceBundle: *const UResourceBundle) -> UResType
pub extern("c") fn ures_getKey(resourceBundle: *const UResourceBundle) -> [*]const umachine.c_char
pub extern("c") fn ures_resetIterator(resourceBundle: *UResourceBundle) -> void
pub extern("c") fn ures_hasNext(resourceBundle: *const UResourceBundle) -> umachine.UBool
pub extern("c") fn ures_getNextResource(resourceBundle: *UResourceBundle, fillIn: *UResourceBundle, status: *utypes.UErrorCode) -> *UResourceBundle
pub extern("c") fn ures_getNextString(resourceBundle: *UResourceBundle, len: *i32, key: [*][*]const umachine.c_char, status: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ures_getByIndex(resourceBundle: *const UResourceBundle, indexR: i32, fillIn: *UResourceBundle, status: *utypes.UErrorCode) -> *UResourceBundle
pub extern("c") fn ures_getStringByIndex(resourceBundle: *const UResourceBundle, indexS: i32, len: *i32, status: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ures_getUTF8StringByIndex(resB: *const UResourceBundle, stringIndex: i32, dest: [*]umachine.c_char, pLength: *i32, forceCopy: umachine.UBool, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ures_getByKey(resourceBundle: *const UResourceBundle, key: [*]const umachine.c_char, fillIn: *UResourceBundle, status: *utypes.UErrorCode) -> *UResourceBundle
pub extern("c") fn ures_getStringByKey(resB: *const UResourceBundle, key: [*]const umachine.c_char, len: *i32, status: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ures_getUTF8StringByKey(resB: *const UResourceBundle, key: [*]const umachine.c_char, dest: [*]umachine.c_char, pLength: *i32, forceCopy: umachine.UBool, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ures_openAvailableLocales(packageName: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *uenum.UEnumeration
