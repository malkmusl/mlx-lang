// unicode/ufieldpositer.h
// mlx-unicode: iterators over the fields of formatted text.
// Declared only: the library does not implement these functions yet.
const utypes = @import("./utypes.mlx")

pub const UFieldPositionIterator = struct {}

pub extern("c") fn ufieldpositer_open(status: *utypes.UErrorCode) -> *UFieldPositionIterator
pub extern("c") fn ufieldpositer_close(fpositer: *UFieldPositionIterator) -> void
pub extern("c") fn ufieldpositer_next(fpositer: *UFieldPositionIterator, beginIndex: *i32, endIndex: *i32) -> i32
