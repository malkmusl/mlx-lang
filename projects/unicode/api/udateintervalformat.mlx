// unicode/udateintervalformat.h
// mlx-unicode: date interval formats (UDateIntervalFormat) and their
// results.
// Declared only: the library does not implement these functions yet.
const ucal = @import("./ucal.mlx")
const udisplaycontext = @import("./udisplaycontext.mlx")
const uformattedvalue = @import("./uformattedvalue.mlx")
const umachine = @import("./umachine.mlx")
const umisc = @import("./umisc.mlx")
const utypes = @import("./utypes.mlx")

pub const UDateIntervalFormat = struct {}

pub const UFormattedDateInterval = struct {}

pub extern("c") fn udtitvfmt_open(locale: [*]const umachine.c_char, skeleton: [*]const umachine.UChar, skeletonLength: i32, tzID: [*]const umachine.UChar, tzIDLength: i32, status: *utypes.UErrorCode) -> *UDateIntervalFormat
pub extern("c") fn udtitvfmt_close(formatter: *UDateIntervalFormat) -> void
pub extern("c") fn udtitvfmt_openResult(ec: *utypes.UErrorCode) -> *UFormattedDateInterval
pub extern("c") fn udtitvfmt_resultAsValue(uresult: *const UFormattedDateInterval, ec: *utypes.UErrorCode) -> *const uformattedvalue.UFormattedValue
pub extern("c") fn udtitvfmt_closeResult(uresult: *UFormattedDateInterval) -> void
pub extern("c") fn udtitvfmt_format(formatter: *const UDateIntervalFormat, fromDate: umachine.UDate, toDate: umachine.UDate, result: [*]umachine.UChar, resultCapacity: i32, position: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn udtitvfmt_formatToResult(formatter: *const UDateIntervalFormat, fromDate: umachine.UDate, toDate: umachine.UDate, result: *UFormattedDateInterval, status: *utypes.UErrorCode) -> void
pub extern("c") fn udtitvfmt_formatCalendarToResult(formatter: *const UDateIntervalFormat, fromCalendar: *ucal.UCalendar, toCalendar: *ucal.UCalendar, result: *UFormattedDateInterval, status: *utypes.UErrorCode) -> void
pub extern("c") fn udtitvfmt_setContext(formatter: *UDateIntervalFormat, value: udisplaycontext.UDisplayContext, status: *utypes.UErrorCode) -> void
pub extern("c") fn udtitvfmt_getContext(formatter: *const UDateIntervalFormat, type_: udisplaycontext.UDisplayContextType, status: *utypes.UErrorCode) -> udisplaycontext.UDisplayContext
