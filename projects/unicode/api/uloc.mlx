// unicode/uloc.h
// mlx-unicode: locale IDs (ICU's form `ll_Ssss_CC_VARIANT@key=value;...`
// and BCP 47 language tags).
const uenum = @import("./uenum.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const ULOC_CHINESE: []const u8 = "zh"
pub const ULOC_ENGLISH: []const u8 = "en"
pub const ULOC_FRENCH: []const u8 = "fr"
pub const ULOC_GERMAN: []const u8 = "de"
pub const ULOC_ITALIAN: []const u8 = "it"
pub const ULOC_JAPANESE: []const u8 = "ja"
pub const ULOC_KOREAN: []const u8 = "ko"
pub const ULOC_US: []const u8 = "en_US"
pub const ULOC_UK: []const u8 = "en_GB"
pub const ULOC_ROOT: []const u8 = ""
pub const ULOC_LANG_CAPACITY: i32 = 12
pub const ULOC_COUNTRY_CAPACITY: i32 = 4
pub const ULOC_FULLNAME_CAPACITY: i32 = 157
pub const ULOC_SCRIPT_CAPACITY: i32 = 6
pub const ULOC_KEYWORDS_CAPACITY: i32 = 96
pub const ULOC_KEYWORD_AND_VALUES_CAPACITY: i32 = 100
pub const ULOC_KEYWORD_SEPARATOR: i32 = 64
pub const ULOC_KEYWORD_SEPARATOR_UNICODE: i32 = 0x40
pub const ULOC_KEYWORD_ASSIGN: i32 = 61
pub const ULOC_KEYWORD_ASSIGN_UNICODE: i32 = 0x3D
pub const ULOC_KEYWORD_ITEM_SEPARATOR: i32 = 59
pub const ULOC_KEYWORD_ITEM_SEPARATOR_UNICODE: i32 = 0x3B
pub const ULocDataLocaleType = enum(i32, nonexhaustive) {
    ULOC_ACTUAL_LOCALE = 0,
    ULOC_VALID_LOCALE = 1,
    ULOC_REQUESTED_LOCALE = 2,
    ULOC_DATA_LOCALE_TYPE_LIMIT = 3,
}

pub const ULayoutType = enum(i32, nonexhaustive) {
    ULOC_LAYOUT_LTR = 0,
    ULOC_LAYOUT_RTL = 1,
    ULOC_LAYOUT_TTB = 2,
    ULOC_LAYOUT_BTT = 3,
    ULOC_LAYOUT_UNKNOWN,
}

pub const ULocAvailableType = enum(i32, nonexhaustive) {
    ULOC_AVAILABLE_DEFAULT,
    ULOC_AVAILABLE_ONLY_LEGACY_ALIASES,
    ULOC_AVAILABLE_WITH_LEGACY_ALIASES,
    ULOC_AVAILABLE_COUNT,
}

pub extern("c") fn uloc_getDefault() -> [*]const umachine.c_char
pub extern("c") fn uloc_setDefault(localeID: [*]const umachine.c_char, status: *utypes.UErrorCode) -> void
pub extern("c") fn uloc_getLanguage(localeID: [*]const umachine.c_char, language: [*]umachine.c_char, languageCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getScript(localeID: [*]const umachine.c_char, script: [*]umachine.c_char, scriptCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getCountry(localeID: [*]const umachine.c_char, country: [*]umachine.c_char, countryCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getVariant(localeID: [*]const umachine.c_char, variant: [*]umachine.c_char, variantCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getName(localeID: [*]const umachine.c_char, name: [*]umachine.c_char, nameCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_canonicalize(localeID: [*]const umachine.c_char, name: [*]umachine.c_char, nameCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getBaseName(localeID: [*]const umachine.c_char, name: [*]umachine.c_char, nameCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_openKeywords(localeID: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn uloc_getKeywordValue(localeID: [*]const umachine.c_char, keywordName: [*]const umachine.c_char, buffer: [*]umachine.c_char, bufferCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_setKeywordValue(keywordName: [*]const umachine.c_char, keywordValue: [*]const umachine.c_char, buffer: [*]umachine.c_char, bufferCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_isRightToLeft(locale: [*]const umachine.c_char) -> umachine.UBool
pub extern("c") fn uloc_getCharacterOrientation(localeId: [*]const umachine.c_char, status: *utypes.UErrorCode) -> ULayoutType
pub extern("c") fn uloc_getLineOrientation(localeId: [*]const umachine.c_char, status: *utypes.UErrorCode) -> ULayoutType
pub extern("c") fn uloc_getAvailable(n: i32) -> [*]const umachine.c_char
pub extern("c") fn uloc_countAvailable() -> i32
pub extern("c") fn uloc_openAvailableByType(kind: ULocAvailableType, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn uloc_addLikelySubtags(localeID: [*]const umachine.c_char, maximizedLocaleID: [*]umachine.c_char, maximizedLocaleIDCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_minimizeSubtags(localeID: [*]const umachine.c_char, minimizedLocaleID: [*]umachine.c_char, minimizedLocaleIDCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_forLanguageTag(langtag: [*]const umachine.c_char, localeID: [*]umachine.c_char, localeIDCapacity: i32, parsedLength: [*]i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_toLanguageTag(localeID: [*]const umachine.c_char, langtag: [*]umachine.c_char, langtagCapacity: i32, strict: umachine.UBool, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_toUnicodeLocaleKey(keyword: [*]const umachine.c_char) -> [*]const umachine.c_char
pub extern("c") fn uloc_toUnicodeLocaleType(keyword: [*]const umachine.c_char, value: [*]const umachine.c_char) -> [*]const umachine.c_char
pub extern("c") fn uloc_toLegacyKey(keyword: [*]const umachine.c_char) -> [*]const umachine.c_char
pub extern("c") fn uloc_toLegacyType(keyword: [*]const umachine.c_char, value: [*]const umachine.c_char) -> [*]const umachine.c_char
pub extern("c") fn uloc_getISO3Language(localeID: [*]const umachine.c_char) -> [*]const umachine.c_char
pub extern("c") fn uloc_getISO3Country(localeID: [*]const umachine.c_char) -> [*]const umachine.c_char
pub extern("c") fn uloc_getParent(localeID: [*]const umachine.c_char, parent: [*]umachine.c_char, parentCapacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getDisplayLanguage(locale: [*]const umachine.c_char, displayLocale: [*]const umachine.c_char, language: [*]umachine.UChar, languageCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getDisplayScript(locale: [*]const umachine.c_char, displayLocale: [*]const umachine.c_char, script: [*]umachine.UChar, scriptCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getDisplayCountry(locale: [*]const umachine.c_char, displayLocale: [*]const umachine.c_char, country: [*]umachine.UChar, countryCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getDisplayVariant(locale: [*]const umachine.c_char, displayLocale: [*]const umachine.c_char, variant: [*]umachine.UChar, variantCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getDisplayName(localeID: [*]const umachine.c_char, inLocaleID: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getDisplayKeyword(keyword: [*]const umachine.c_char, displayLocale: [*]const umachine.c_char, dest: [*]umachine.UChar, destCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getDisplayKeywordValue(locale: [*]const umachine.c_char, keyword: [*]const umachine.c_char, displayLocale: [*]const umachine.c_char, dest: [*]umachine.UChar, destCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uloc_getISOLanguages() -> [*]const [*]const umachine.c_char
pub extern("c") fn uloc_getISOCountries() -> [*]const [*]const umachine.c_char
pub extern("c") fn uloc_getLCID(localeID: [*]const umachine.c_char) -> u32
pub extern("c") fn uloc_getLocaleForLCID(hostID: u32, locale: [*]umachine.c_char, localeCapacity: i32, status: *utypes.UErrorCode) -> i32

pub const UAcceptResult = enum(i32, nonexhaustive) {
    ULOC_ACCEPT_FAILED = 0,
    ULOC_ACCEPT_VALID = 1,
    ULOC_ACCEPT_FALLBACK = 2,
}

pub extern("c") fn uloc_acceptLanguage(result: [*]umachine.c_char, resultAvailable: i32, outResult: *UAcceptResult, acceptList: [*][*]const umachine.c_char, acceptListCount: i32, availableLocales: *uenum.UEnumeration, status: *utypes.UErrorCode) -> i32
