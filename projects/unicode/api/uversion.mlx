// unicode/uversion.h
// mlx-unicode: versions as four bytes and as text.
const umachine = @import("./umachine.mlx")
const uvernum = @import("./uvernum.mlx")

pub extern("c") fn u_versionFromString(versionArray: *u8, versionString: ?[*]const umachine.c_char) -> void
pub extern("c") fn u_versionFromUString(versionArray: *u8, versionString: ?[*]const umachine.UChar) -> void
pub extern("c") fn u_versionToString(versionArray: [*]const u8, versionString: [*]umachine.c_char) -> void
pub extern("c") fn u_getVersion(versionArray: *u8) -> void
