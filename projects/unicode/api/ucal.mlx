// unicode/ucal.h
// mlx-unicode: calendars (the Gregorian calendar, Julian before its
// change) and time zones (the system's IANA zone files).
const uenum = @import("./uenum.mlx")
const uloc = @import("./uloc.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UCAL_UNKNOWN_ZONE_ID: []const u8 = "Etc/Unknown"

pub const UCalendar = *anyopaque

pub const UCalendarType = enum(i32, nonexhaustive) {
    UCAL_TRADITIONAL,
    UCAL_GREGORIAN,
}
pub const UCAL_DEFAULT: UCalendarType = UCalendarType.UCAL_TRADITIONAL

pub const UCalendarDateFields = enum(i32, nonexhaustive) {
    UCAL_ERA,
    UCAL_YEAR,
    UCAL_MONTH,
    UCAL_WEEK_OF_YEAR,
    UCAL_WEEK_OF_MONTH,
    UCAL_DATE,
    UCAL_DAY_OF_YEAR,
    UCAL_DAY_OF_WEEK,
    UCAL_DAY_OF_WEEK_IN_MONTH,
    UCAL_AM_PM,
    UCAL_HOUR,
    UCAL_HOUR_OF_DAY,
    UCAL_MINUTE,
    UCAL_SECOND,
    UCAL_MILLISECOND,
    UCAL_ZONE_OFFSET,
    UCAL_DST_OFFSET,
    UCAL_YEAR_WOY,
    UCAL_DOW_LOCAL,
    UCAL_EXTENDED_YEAR,
    UCAL_JULIAN_DAY,
    UCAL_MILLISECONDS_IN_DAY,
    UCAL_IS_LEAP_MONTH,
    UCAL_ORDINAL_MONTH,
    UCAL_FIELD_COUNT,
}
pub const UCAL_DAY_OF_MONTH: UCalendarDateFields = UCalendarDateFields.UCAL_DATE

pub const UCalendarDaysOfWeek = enum(i32, nonexhaustive) {
    UCAL_SUNDAY = 1,
    UCAL_MONDAY,
    UCAL_TUESDAY,
    UCAL_WEDNESDAY,
    UCAL_THURSDAY,
    UCAL_FRIDAY,
    UCAL_SATURDAY,
}

pub const UCalendarMonths = enum(i32, nonexhaustive) {
    UCAL_JANUARY,
    UCAL_FEBRUARY,
    UCAL_MARCH,
    UCAL_APRIL,
    UCAL_MAY,
    UCAL_JUNE,
    UCAL_JULY,
    UCAL_AUGUST,
    UCAL_SEPTEMBER,
    UCAL_OCTOBER,
    UCAL_NOVEMBER,
    UCAL_DECEMBER,
    UCAL_UNDECIMBER,
}

pub const UCalendarAMPMs = enum(i32, nonexhaustive) {
    UCAL_AM,
    UCAL_PM,
}

pub const USystemTimeZoneType = enum(i32, nonexhaustive) {
    UCAL_ZONE_TYPE_ANY,
    UCAL_ZONE_TYPE_CANONICAL,
    UCAL_ZONE_TYPE_CANONICAL_LOCATION,
}

pub const UCalendarDisplayNameType = enum(i32, nonexhaustive) {
    UCAL_STANDARD,
    UCAL_SHORT_STANDARD,
    UCAL_DST,
    UCAL_SHORT_DST,
}

pub const UCalendarAttribute = enum(i32, nonexhaustive) {
    UCAL_LENIENT,
    UCAL_FIRST_DAY_OF_WEEK,
    UCAL_MINIMAL_DAYS_IN_FIRST_WEEK,
    UCAL_REPEATED_WALL_TIME,
    UCAL_SKIPPED_WALL_TIME,
}

pub const UCalendarWallTimeOption = enum(i32, nonexhaustive) {
    UCAL_WALLTIME_LAST,
    UCAL_WALLTIME_FIRST,
    UCAL_WALLTIME_NEXT_VALID,
}

pub const UCalendarLimitType = enum(i32, nonexhaustive) {
    UCAL_MINIMUM,
    UCAL_MAXIMUM,
    UCAL_GREATEST_MINIMUM,
    UCAL_LEAST_MAXIMUM,
    UCAL_ACTUAL_MINIMUM,
    UCAL_ACTUAL_MAXIMUM,
}

pub const UCalendarWeekdayType = enum(i32, nonexhaustive) {
    UCAL_WEEKDAY,
    UCAL_WEEKEND,
    UCAL_WEEKEND_ONSET,
    UCAL_WEEKEND_CEASE,
}

pub const UTimeZoneTransitionType = enum(i32, nonexhaustive) {
    UCAL_TZ_TRANSITION_NEXT,
    UCAL_TZ_TRANSITION_NEXT_INCLUSIVE,
    UCAL_TZ_TRANSITION_PREVIOUS,
    UCAL_TZ_TRANSITION_PREVIOUS_INCLUSIVE,
}

pub const UTimeZoneLocalOption = enum(i32, nonexhaustive) {
    UCAL_TZ_LOCAL_FORMER = 0x04,
    UCAL_TZ_LOCAL_LATTER = 0x0C,
    UCAL_TZ_LOCAL_STANDARD_FORMER = 0x05,
    UCAL_TZ_LOCAL_STANDARD_LATTER = 0x0D,
    UCAL_TZ_LOCAL_DAYLIGHT_FORMER = 0x07,
    UCAL_TZ_LOCAL_DAYLIGHT_LATTER = 0x0F,
}

pub extern("c") fn ucal_openTimeZoneIDEnumeration(zoneType: USystemTimeZoneType, region: [*]const umachine.c_char, rawOffset: [*]const i32, ec: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucal_openTimeZones(ec: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucal_openCountryTimeZones(country: [*]const umachine.c_char, ec: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucal_getDefaultTimeZone(result: [*]umachine.UChar, resultCapacity: i32, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_setDefaultTimeZone(zoneID: [*]const umachine.UChar, ec: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_getHostTimeZone(result: [*]umachine.UChar, resultCapacity: i32, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getDSTSavings(zoneID: [*]const umachine.UChar, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getNow() -> umachine.UDate
pub extern("c") fn ucal_open(zoneID: [*]const umachine.UChar, len: i32, locale: [*]const umachine.c_char, type_: UCalendarType, status: *utypes.UErrorCode) -> *UCalendar
pub extern("c") fn ucal_close(cal: *UCalendar) -> void
pub extern("c") fn ucal_clone(cal: *const UCalendar, status: *utypes.UErrorCode) -> *UCalendar
pub extern("c") fn ucal_setTimeZone(cal: *UCalendar, zoneID: [*]const umachine.UChar, len: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_getTimeZoneID(cal: *const UCalendar, result: [*]umachine.UChar, resultLength: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getTimeZoneDisplayName(cal: *const UCalendar, type_: UCalendarDisplayNameType, locale: [*]const umachine.c_char, result: [*]umachine.UChar, resultLength: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_inDaylightTime(cal: *const UCalendar, status: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn ucal_setGregorianChange(cal: *UCalendar, date: umachine.UDate, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_getGregorianChange(cal: *const UCalendar, pErrorCode: *utypes.UErrorCode) -> umachine.UDate
pub extern("c") fn ucal_getAttribute(cal: *const UCalendar, attr: UCalendarAttribute) -> i32
pub extern("c") fn ucal_setAttribute(cal: *UCalendar, attr: UCalendarAttribute, newValue: i32) -> void
pub extern("c") fn ucal_getAvailable(localeIndex: i32) -> [*]const umachine.c_char
pub extern("c") fn ucal_countAvailable() -> i32
pub extern("c") fn ucal_getMillis(cal: *const UCalendar, status: *utypes.UErrorCode) -> umachine.UDate
pub extern("c") fn ucal_setMillis(cal: *UCalendar, dateTime: umachine.UDate, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_setDate(cal: *UCalendar, year: i32, month: i32, date: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_setDateTime(cal: *UCalendar, year: i32, month: i32, date: i32, hour: i32, minute: i32, second: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_equivalentTo(cal1: *const UCalendar, cal2: *const UCalendar) -> umachine.UBool
pub extern("c") fn ucal_add(cal: *UCalendar, field: UCalendarDateFields, amount: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_roll(cal: *UCalendar, field: UCalendarDateFields, amount: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucal_get(cal: *const UCalendar, field: UCalendarDateFields, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_set(cal: *UCalendar, field: UCalendarDateFields, value: i32) -> void
pub extern("c") fn ucal_isSet(cal: *const UCalendar, field: UCalendarDateFields) -> umachine.UBool
pub extern("c") fn ucal_clearField(cal: *UCalendar, field: UCalendarDateFields) -> void
pub extern("c") fn ucal_clear(calendar: *UCalendar) -> void
pub extern("c") fn ucal_getLimit(cal: *const UCalendar, field: UCalendarDateFields, type_: UCalendarLimitType, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getLocaleByType(cal: *const UCalendar, type_: uloc.ULocDataLocaleType, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ucal_getTZDataVersion(status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ucal_getCanonicalTimeZoneID(id: [*]const umachine.UChar, len: i32, result: [*]umachine.UChar, resultCapacity: i32, isSystemID: *umachine.UBool, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getIanaTimeZoneID(id: [*]const umachine.UChar, len: i32, result: [*]umachine.UChar, resultCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getType(cal: *const UCalendar, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ucal_getKeywordValuesForLocale(key: [*]const umachine.c_char, locale: [*]const umachine.c_char, commonlyUsed: umachine.UBool, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucal_getDayOfWeekType(cal: *const UCalendar, dayOfWeek: UCalendarDaysOfWeek, status: *utypes.UErrorCode) -> UCalendarWeekdayType
pub extern("c") fn ucal_getWeekendTransition(cal: *const UCalendar, dayOfWeek: UCalendarDaysOfWeek, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_isWeekend(cal: *const UCalendar, date: umachine.UDate, status: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn ucal_getFieldDifference(cal: *UCalendar, target: umachine.UDate, field: UCalendarDateFields, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getTimeZoneTransitionDate(cal: *const UCalendar, type_: UTimeZoneTransitionType, transition: *umachine.UDate, status: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn ucal_getWindowsTimeZoneID(id: [*]const umachine.UChar, len: i32, winid: [*]umachine.UChar, winidCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getTimeZoneIDForWindowsID(winid: [*]const umachine.UChar, len: i32, region: [*]const umachine.c_char, id: [*]umachine.UChar, idCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucal_getTimeZoneOffsetFromLocal(cal: *const UCalendar, nonExistingTimeOpt: UTimeZoneLocalOption, duplicatedTimeOpt: UTimeZoneLocalOption, rawOffset: *i32, dstOffset: *i32, status: *utypes.UErrorCode) -> void
