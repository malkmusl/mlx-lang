// unicode/utf8.h
// mlx-unicode: UTF-8 by macros. An ill-formed sequence reads as `sub`
// (U_SENTINEL, or U+FFFD for the _OR_FFFD forms) and moves past its
// longest well-formed beginning (its maximal subpart), as Unicode
// recommends. Each macro is the Mlx function of its name; one that
// writes takes what it writes as pointers.
const umachine = @import("./umachine.mlx")

const UChar32 = umachine.UChar32

pub fn U8_IS_SINGLE(c: i32) -> bool { return (c & 0x80) == 0 }
pub fn U8_IS_LEAD(c: i32) -> bool { return @intCast(u8, (c - 0xc2) & 0xff) <= 0x32 }
pub fn U8_IS_TRAIL(c: i32) -> bool { return @bitCast(i8, @intCast(u8, c & 0xff)) < -0x40 }
pub fn U8_LENGTH(c: UChar32) -> i32 {
    return if @bitCast(u32, c) <= 0x7f { 1 } else if @bitCast(u32, c) <= 0x7ff { 2 } else if @bitCast(u32, c) <= 0xd7ff { 3 } else if @bitCast(u32, c) <= 0xdfff || @bitCast(u32, c) > 0x10ffff { 0 } else if @bitCast(u32, c) <= 0xffff { 3 } else { 4 }
}
pub const U8_MAX_LENGTH: i32 = 4

// The trail bytes a lead byte announces (0 for one that is no lead).
pub fn U8_COUNT_TRAIL_BYTES(leadByte: i32) -> i32 {
    return if U8_IS_LEAD(leadByte) { (if (leadByte & 0xff) >= 0xe0 { 1 } else { 0 }) + (if (leadByte & 0xff) >= 0xf0 { 1 } else { 0 }) + 1 } else { 0 }
}
pub fn U8_COUNT_TRAIL_BYTES_UNSAFE(leadByte: i32) -> i32 {
    return (if (leadByte & 0xff) >= 0xc2 { 1 } else { 0 }) + (if (leadByte & 0xff) >= 0xe0 { 1 } else { 0 }) + (if (leadByte & 0xff) >= 0xf0 { 1 } else { 0 })
}

// The code point at `p[at]` with `available` bytes there (negative: as
// many as are well-formed); `used.*` the bytes it took.
pub fn mlx_u8_decode(p: [*]const u8, at: i64, available: i64, used: *i32, sub: UChar32) -> UChar32 {
    var c: UChar32 = @intCast(UChar32, p[@intCast(usize, at)])
    var low: i32 = 0x80
    var high: i32 = 0xbf
    var need: i32 = 0
    used.* = 1
    if c < 0x80 { return c }
    if c >= 0xc2 && c <= 0xdf {
        need = 1
        c = c & 0x1f
    } else if c >= 0xe0 && c <= 0xef {
        need = 2
        c = c & 0x0f
        if c == 0 { low = 0xa0 }
        if c == 0xd { high = 0x9f }
    } else if c >= 0xf0 && c <= 0xf4 {
        need = 3
        c = c & 0x07
        if c == 0 { low = 0x90 }
        if c == 4 { high = 0x8f }
    } else {
        return sub
    }
    var k: i32 = 1
    while k <= need {
        if available >= 0 && @intCast(i64, k) >= available { return sub }
        const t: i32 = @intCast(i32, p[@intCast(usize, at + @intCast(i64, k))])
        if t < low || t > high { return sub }
        low = 0x80
        high = 0xbf
        c = (c << 6) | (t & 0x3f)
        used.* = k + 1
        k += 1
    }
    return c
}

// The code point that ends at `s[i.*]` (`s[start]` the earliest it may
// begin); `i.*` moves to its start.
pub fn mlx_u8_previous(s: [*]const u8, start: i64, i: *i64, sub: UChar32) -> UChar32 {
    const end: i64 = i.*
    var lead: i64 = end - 1
    const c: i32 = @intCast(i32, s[@intCast(usize, lead)])
    if c < 0x80 {
        i.* = lead
        return c
    }
    if U8_IS_TRAIL(c) {
        var trails: i32 = 0
        while trails < 3 && lead > start && U8_IS_TRAIL(@intCast(i32, s[@intCast(usize, lead)])) {
            lead -= 1
            trails += 1
        }
        if !U8_IS_TRAIL(@intCast(i32, s[@intCast(usize, lead)])) {
            var used: i32 = 0
            const decoded: UChar32 = mlx_u8_decode(s, lead, end - lead, &used, -1)
            if decoded >= 0 && lead + @intCast(i64, used) == end {
                i.* = lead
                return decoded
            }
        }
    }
    i.* = end - 1
    return sub
}

pub fn U8_INTERNAL_NEXT_OR_SUB(s: [*]const u8, i: *i64, length: i64, c: *UChar32, sub: UChar32) -> void {
    var used: i32 = 0
    c.* = mlx_u8_decode(unsafe { @ptrCast([*]const u8, s) }, @intCast(i64, i.*), if @intCast(i64, length) < 0 { -1 } else { @intCast(i64, length) - @intCast(i64, i.*) }, &used, sub)
    i.* += @intCast(i64, used)
}

pub fn U8_NEXT(s: [*]const u8, i: *i64, length: i64, c: *UChar32) -> void { U8_INTERNAL_NEXT_OR_SUB(s, i, length, c, -1) }
pub fn U8_NEXT_OR_FFFD(s: [*]const u8, i: *i64, length: i64, c: *UChar32) -> void { U8_INTERNAL_NEXT_OR_SUB(s, i, length, c, 0xfffd) }

pub fn U8_NEXT_UNSAFE(s: [*]const u8, i: *i64, c: *UChar32) -> void {
    var used: i32 = 0
    c.* = mlx_u8_decode(unsafe { @ptrCast([*]const u8, s) }, @intCast(i64, i.*), 4, &used, 0xfffd)
    i.* += @intCast(i64, used)
}

pub fn U8_APPEND_UNSAFE(s: [*]u8, i: *i64, c: UChar32) -> void {
    const code: u32 = @bitCast(u32, c)
    if code <= 0x7f {
        s[@intCast(usize, i.*)] = @intCast(u8, code)
        i.* += 1
    } else {
        if code <= 0x7ff {
            s[@intCast(usize, i.*)] = @intCast(u8, (code >> 6) | 0xc0)
            i.* += 1
        } else {
            if code <= 0xffff {
                s[@intCast(usize, i.*)] = @intCast(u8, (code >> 12) | 0xe0)
                i.* += 1
            } else {
                s[@intCast(usize, i.*)] = @intCast(u8, (code >> 18) | 0xf0)
                i.* += 1
                s[@intCast(usize, i.*)] = @intCast(u8, ((code >> 12) & 0x3f) | 0x80)
                i.* += 1
            }
            s[@intCast(usize, i.*)] = @intCast(u8, ((code >> 6) & 0x3f) | 0x80)
            i.* += 1
        }
        s[@intCast(usize, i.*)] = @intCast(u8, (code & 0x3f) | 0x80)
        i.* += 1
    }
}

pub fn U8_APPEND(s: [*]u8, i: *i64, capacity: i64, c: UChar32, isError: *bool) -> void {
    const code: u32 = @bitCast(u32, c)
    if code <= 0x7f {
        s[@intCast(usize, i.*)] = @intCast(u8, code)
        i.* += 1
    } else if code <= 0x7ff && i.* + 1 < capacity {
        s[@intCast(usize, i.*)] = @intCast(u8, (code >> 6) | 0xc0)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(u8, (code & 0x3f) | 0x80)
        i.* += 1
    } else if (code <= 0xd7ff || (0xe000 <= code && code <= 0xffff)) && i.* + 2 < capacity {
        s[@intCast(usize, i.*)] = @intCast(u8, (code >> 12) | 0xe0)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(u8, ((code >> 6) & 0x3f) | 0x80)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(u8, (code & 0x3f) | 0x80)
        i.* += 1
    } else if 0xffff < code && code <= 0x10ffff && i.* + 3 < capacity {
        s[@intCast(usize, i.*)] = @intCast(u8, (code >> 18) | 0xf0)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(u8, ((code >> 12) & 0x3f) | 0x80)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(u8, ((code >> 6) & 0x3f) | 0x80)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(u8, (code & 0x3f) | 0x80)
        i.* += 1
    } else {
        isError.* = true
    }
}

pub fn U8_FWD_1(s: [*]const u8, i: *i64, length: i64) -> void {
    var used: i32 = 0
    _ = mlx_u8_decode(unsafe { @ptrCast([*]const u8, s) }, @intCast(i64, i.*), if @intCast(i64, length) < 0 { -1 } else { @intCast(i64, length) - @intCast(i64, i.*) }, &used, 0)
    i.* += @intCast(i64, used)
}

pub fn U8_FWD_1_UNSAFE(s: [*]const u8, i: *i64) -> void { i.* += 1 + @intCast(i64, U8_COUNT_TRAIL_BYTES_UNSAFE(@intCast(i32, s[@intCast(usize, i.*)]))) }

pub fn U8_FWD_N(s: [*]const u8, i: *i64, length: i64, n: i32) -> void {
    var count: i32 = n
    while count > 0 && (i.* < length || (length < 0 && s[@intCast(usize, i.*)] != 0)) {
        U8_FWD_1(s, i, length)
        count -= 1
    }
}

pub fn U8_PREV(s: [*]const u8, start: i64, i: *i64, c: *UChar32) -> void {
    var at: i64 = @intCast(i64, i.*)
    c.* = mlx_u8_previous(unsafe { @ptrCast([*]const u8, s) }, @intCast(i64, start), &at, -1)
    i.* = at
}

pub fn U8_PREV_OR_FFFD(s: [*]const u8, start: i64, i: *i64, c: *UChar32) -> void {
    var at: i64 = @intCast(i64, i.*)
    c.* = mlx_u8_previous(unsafe { @ptrCast([*]const u8, s) }, @intCast(i64, start), &at, 0xfffd)
    i.* = at
}

pub fn U8_BACK_1(s: [*]const u8, start: i64, i: *i64) -> void {
    var at: i64 = @intCast(i64, i.*)
    _ = mlx_u8_previous(unsafe { @ptrCast([*]const u8, s) }, @intCast(i64, start), &at, 0)
    i.* = at
}

pub fn U8_BACK_1_UNSAFE(s: [*]const u8, i: *i64) -> void {
    i.* -= 1
    while U8_IS_TRAIL(@intCast(i32, s[@intCast(usize, i.*)])) { i.* -= 1 }
}

pub fn U8_BACK_N(s: [*]const u8, start: i64, i: *i64, n: i32) -> void {
    var count: i32 = n
    while count > 0 && i.* > start {
        U8_BACK_1(s, start, i)
        count -= 1
    }
}

pub fn U8_SET_CP_START_UNSAFE(s: [*]const u8, i: *i64) -> void {
    while U8_IS_TRAIL(@intCast(i32, s[@intCast(usize, i.*)])) { i.* -= 1 }
}

pub fn U8_SET_CP_START(s: [*]const u8, start: i64, i: *i64) -> void {
    if U8_IS_TRAIL(@intCast(i32, s[@intCast(usize, i.*)])) {
        var end: i64 = @intCast(i64, i.*) + 1
        while end - @intCast(i64, i.*) < 4 && U8_IS_TRAIL(@intCast(i32, s[@intCast(usize, end)])) { end += 1 }
        var at: i64 = end
        _ = mlx_u8_previous(unsafe { @ptrCast([*]const u8, s) }, @intCast(i64, start), &at, -1)
        if at <= @intCast(i64, i.*) { i.* = at }
    }
}

pub fn U8_SET_CP_LIMIT(s: [*]const u8, start: i64, i: *i64, length: i64) -> void {
    if start < i.* && (i.* < length || length < 0) {
        var at: i64 = @intCast(i64, i.*)
        U8_BACK_1(s, start, &at)
        U8_FWD_1(s, &at, length)
        i.* = at
    }
}

pub fn U8_GET(s: [*]const u8, start: i64, i: i64, length: i64, c: *UChar32) -> void {
    var at: i64 = @intCast(i64, i)
    U8_SET_CP_START(s, start, &at)
    var used: i32 = 0
    c.* = mlx_u8_decode(unsafe { @ptrCast([*]const u8, s) }, at, if @intCast(i64, length) < 0 { -1 } else { @intCast(i64, length) - at }, &used, -1)
    if at + @intCast(i64, used) <= @intCast(i64, i) { c.* = -1 }
}

pub fn U8_GET_OR_FFFD(s: [*]const u8, start: i64, i: i64, length: i64, c: *UChar32) -> void {
    U8_GET(s, start, i, length, c)
    if c.* < 0 { c.* = 0xfffd }
}
