// unicode/unumberrangeformatter.h
// mlx-unicode: number range formatters (UNumberRangeFormatter) and
// their results.
// Declared only: the library does not implement these functions yet.
const parseerr = @import("./parseerr.mlx")
const ufieldpositer = @import("./ufieldpositer.mlx")
const uformattable = @import("./uformattable.mlx")
const uformattedvalue = @import("./uformattedvalue.mlx")
const umachine = @import("./umachine.mlx")
const umisc = @import("./umisc.mlx")
const utypes = @import("./utypes.mlx")

pub const UNumberRangeCollapse = enum(i32, nonexhaustive) {
    UNUM_RANGE_COLLAPSE_AUTO,
    UNUM_RANGE_COLLAPSE_NONE,
    UNUM_RANGE_COLLAPSE_UNIT,
    UNUM_RANGE_COLLAPSE_ALL,
}

pub const UNumberRangeIdentityFallback = enum(i32, nonexhaustive) {
    UNUM_IDENTITY_FALLBACK_SINGLE_VALUE,
    UNUM_IDENTITY_FALLBACK_APPROXIMATELY_OR_SINGLE_VALUE,
    UNUM_IDENTITY_FALLBACK_APPROXIMATELY,
    UNUM_IDENTITY_FALLBACK_RANGE,
}

pub const UNumberRangeIdentityResult = enum(i32, nonexhaustive) {
    UNUM_IDENTITY_RESULT_EQUAL_BEFORE_ROUNDING,
    UNUM_IDENTITY_RESULT_EQUAL_AFTER_ROUNDING,
    UNUM_IDENTITY_RESULT_NOT_EQUAL,
    UNUM_IDENTITY_RESULT_COUNT,
}

pub const UNumberRangeFormatter = struct {}

pub const UFormattedNumberRange = struct {}

pub extern("c") fn unumrf_openForSkeletonWithCollapseAndIdentityFallback(skeleton: [*]const umachine.UChar, skeletonLen: i32, collapse: UNumberRangeCollapse, identityFallback: UNumberRangeIdentityFallback, locale: [*]const umachine.c_char, perror: *parseerr.UParseError, ec: *utypes.UErrorCode) -> *UNumberRangeFormatter
pub extern("c") fn unumrf_openResult(ec: *utypes.UErrorCode) -> *UFormattedNumberRange
pub extern("c") fn unumrf_formatDoubleRange(uformatter: *const UNumberRangeFormatter, first: f64, second: f64, uresult: *UFormattedNumberRange, ec: *utypes.UErrorCode) -> void
pub extern("c") fn unumrf_formatDecimalRange(uformatter: *const UNumberRangeFormatter, first: [*]const umachine.c_char, firstLen: i32, second: [*]const umachine.c_char, secondLen: i32, uresult: *UFormattedNumberRange, ec: *utypes.UErrorCode) -> void
pub extern("c") fn unumrf_resultAsValue(uresult: *const UFormattedNumberRange, ec: *utypes.UErrorCode) -> *const uformattedvalue.UFormattedValue
pub extern("c") fn unumrf_resultGetIdentityResult(uresult: *const UFormattedNumberRange, ec: *utypes.UErrorCode) -> UNumberRangeIdentityResult
pub extern("c") fn unumrf_resultGetFirstDecimalNumber(uresult: *const UFormattedNumberRange, dest: [*]umachine.c_char, destCapacity: i32, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn unumrf_resultGetSecondDecimalNumber(uresult: *const UFormattedNumberRange, dest: [*]umachine.c_char, destCapacity: i32, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn unumrf_close(uformatter: *UNumberRangeFormatter) -> void
pub extern("c") fn unumrf_closeResult(uresult: *UFormattedNumberRange) -> void
