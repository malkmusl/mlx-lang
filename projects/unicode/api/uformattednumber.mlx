// unicode/uformattednumber.h
// mlx-unicode: UFormattedNumber, the result of a UNumberFormatter.
// Declared only: the library does not implement these functions yet.
const ufieldpositer = @import("./ufieldpositer.mlx")
const uformattedvalue = @import("./uformattedvalue.mlx")
const umachine = @import("./umachine.mlx")
const umisc = @import("./umisc.mlx")
const utypes = @import("./utypes.mlx")

pub const UFormattedNumber = struct {}

pub extern("c") fn unumf_openResult(ec: *utypes.UErrorCode) -> *UFormattedNumber
pub extern("c") fn unumf_resultAsValue(uresult: *const UFormattedNumber, ec: *utypes.UErrorCode) -> *const uformattedvalue.UFormattedValue
pub extern("c") fn unumf_resultToString(uresult: *const UFormattedNumber, buffer: [*]umachine.UChar, bufferCapacity: i32, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn unumf_resultNextFieldPosition(uresult: *const UFormattedNumber, ufpos: *umisc.UFieldPosition, ec: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn unumf_resultGetAllFieldPositions(uresult: *const UFormattedNumber, ufpositer: *ufieldpositer.UFieldPositionIterator, ec: *utypes.UErrorCode) -> void
pub extern("c") fn unumf_resultToDecimalNumber(uresult: *const UFormattedNumber, dest: [*]umachine.c_char, destCapacity: i32, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn unumf_closeResult(uresult: *UFormattedNumber) -> void
