// unicode/uidna.h
// mlx-unicode: internationalized domain names (UTS #46, with Punycode,
// RFC 3492).
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UIDNA = struct {}
// The options of uidna_openUTS46.
pub const UIDNA_DEFAULT: u32 = 0
pub const UIDNA_ALLOW_UNASSIGNED: u32 = 1
pub const UIDNA_USE_STD3_RULES: u32 = 2
pub const UIDNA_CHECK_BIDI: u32 = 4
pub const UIDNA_CHECK_CONTEXTJ: u32 = 8
pub const UIDNA_NONTRANSITIONAL_TO_ASCII: u32 = 0x10
pub const UIDNA_NONTRANSITIONAL_TO_UNICODE: u32 = 0x20
pub const UIDNA_CHECK_CONTEXTO: u32 = 0x40

// What a conversion found (`errors`: the UIDNA_ERROR_ bits).
pub const UIDNAInfo = struct {
    size: i16,
    isTransitionalDifferent: umachine.UBool,
    reservedB3: umachine.UBool,
    errors: u32,
    reservedI2: i32,
    reservedI3: i32,
}

pub const UIDNA_INFO_INITIALIZER: UIDNAInfo = UIDNAInfo.{ .size = @intCast(i16, @sizeOf(UIDNAInfo)), .isTransitionalDifferent = 0, .reservedB3 = 0, .errors = 0, .reservedI2 = 0, .reservedI3 = 0 }

pub const UIDNA_ERROR_EMPTY_LABEL: u32 = 1
pub const UIDNA_ERROR_LABEL_TOO_LONG: u32 = 2
pub const UIDNA_ERROR_DOMAIN_NAME_TOO_LONG: u32 = 4
pub const UIDNA_ERROR_LEADING_HYPHEN: u32 = 8
pub const UIDNA_ERROR_TRAILING_HYPHEN: u32 = 0x10
pub const UIDNA_ERROR_HYPHEN_3_4: u32 = 0x20
pub const UIDNA_ERROR_LEADING_COMBINING_MARK: u32 = 0x40
pub const UIDNA_ERROR_DISALLOWED: u32 = 0x80
pub const UIDNA_ERROR_PUNYCODE: u32 = 0x100
pub const UIDNA_ERROR_LABEL_HAS_DOT: u32 = 0x200
pub const UIDNA_ERROR_INVALID_ACE_LABEL: u32 = 0x400
pub const UIDNA_ERROR_BIDI: u32 = 0x800
pub const UIDNA_ERROR_CONTEXTJ: u32 = 0x1000
pub const UIDNA_ERROR_CONTEXTO_PUNCTUATION: u32 = 0x2000
pub const UIDNA_ERROR_CONTEXTO_DIGITS: u32 = 0x4000

pub extern("c") fn uidna_openUTS46(options: u32, pErrorCode: *utypes.UErrorCode) -> *UIDNA
pub extern("c") fn uidna_close(idna: *UIDNA) -> void
pub extern("c") fn uidna_labelToASCII(idna: *const UIDNA, label: [*]const umachine.UChar, length: i32, dest: [*]umachine.UChar, capacity: i32, pInfo: *UIDNAInfo, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uidna_labelToUnicode(idna: *const UIDNA, label: [*]const umachine.UChar, length: i32, dest: [*]umachine.UChar, capacity: i32, pInfo: *UIDNAInfo, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uidna_nameToASCII(idna: *const UIDNA, name: [*]const umachine.UChar, length: i32, dest: [*]umachine.UChar, capacity: i32, pInfo: *UIDNAInfo, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uidna_nameToUnicode(idna: *const UIDNA, name: [*]const umachine.UChar, length: i32, dest: [*]umachine.UChar, capacity: i32, pInfo: *UIDNAInfo, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uidna_nameToASCII_UTF8(idna: *const UIDNA, name: [*]const umachine.c_char, length: i32, dest: [*]umachine.c_char, capacity: i32, pInfo: *UIDNAInfo, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uidna_nameToUnicodeUTF8(idna: *const UIDNA, name: [*]const umachine.c_char, length: i32, dest: [*]umachine.c_char, capacity: i32, pInfo: *UIDNAInfo, pErrorCode: *utypes.UErrorCode) -> i32
