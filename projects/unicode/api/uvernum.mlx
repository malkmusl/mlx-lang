// unicode/uvernum.h
// mlx-unicode: the API level, ICU 74's (what WebKit and the programs
// built here check for). The data is Unicode 16.0.

pub const U_ICU_VERSION_MAJOR_NUM: i32 = 74
pub const U_ICU_VERSION_MINOR_NUM: i32 = 2
pub const U_ICU_VERSION_PATCHLEVEL_NUM: i32 = 0
pub const U_ICU_VERSION_BUILDLEVEL_NUM: i32 = 0
pub const U_ICU_VERSION: []const u8 = "74.2"
pub const U_ICU_VERSION_SHORT: []const u8 = "74"
pub const U_ICU_DATA_VERSION: []const u8 = "74.2"
