// unicode/ureldatefmt.h
// mlx-unicode: relative date-time formatters ("in 3 days", "yesterday").
// Declared only: the library does not implement these functions yet.
const udisplaycontext = @import("./udisplaycontext.mlx")
const uformattedvalue = @import("./uformattedvalue.mlx")
const umachine = @import("./umachine.mlx")
const unum = @import("./unum.mlx")
const utypes = @import("./utypes.mlx")

pub const UDateRelativeDateTimeFormatterStyle = enum(i32, nonexhaustive) {
    UDAT_STYLE_LONG,
    UDAT_STYLE_SHORT,
    UDAT_STYLE_NARROW,
    UDAT_STYLE_COUNT,
}

pub const URelativeDateTimeUnit = enum(i32, nonexhaustive) {
    UDAT_REL_UNIT_YEAR,
    UDAT_REL_UNIT_QUARTER,
    UDAT_REL_UNIT_MONTH,
    UDAT_REL_UNIT_WEEK,
    UDAT_REL_UNIT_DAY,
    UDAT_REL_UNIT_HOUR,
    UDAT_REL_UNIT_MINUTE,
    UDAT_REL_UNIT_SECOND,
    UDAT_REL_UNIT_SUNDAY,
    UDAT_REL_UNIT_MONDAY,
    UDAT_REL_UNIT_TUESDAY,
    UDAT_REL_UNIT_WEDNESDAY,
    UDAT_REL_UNIT_THURSDAY,
    UDAT_REL_UNIT_FRIDAY,
    UDAT_REL_UNIT_SATURDAY,
    UDAT_REL_UNIT_COUNT,
}

pub const URelativeDateTimeFormatterField = enum(i32, nonexhaustive) {
    UDAT_REL_LITERAL_FIELD,
    UDAT_REL_NUMERIC_FIELD,
}

pub const URelativeDateTimeFormatter = struct {}

pub extern("c") fn ureldatefmt_open(locale: [*]const umachine.c_char, nfToAdopt: *unum.UNumberFormat, width: UDateRelativeDateTimeFormatterStyle, capitalizationContext: udisplaycontext.UDisplayContext, status: *utypes.UErrorCode) -> *URelativeDateTimeFormatter
pub extern("c") fn ureldatefmt_close(reldatefmt: *URelativeDateTimeFormatter) -> void

pub const UFormattedRelativeDateTime = struct {}

pub extern("c") fn ureldatefmt_openResult(ec: *utypes.UErrorCode) -> *UFormattedRelativeDateTime
pub extern("c") fn ureldatefmt_resultAsValue(ufrdt: *const UFormattedRelativeDateTime, ec: *utypes.UErrorCode) -> *const uformattedvalue.UFormattedValue
pub extern("c") fn ureldatefmt_closeResult(ufrdt: *UFormattedRelativeDateTime) -> void
pub extern("c") fn ureldatefmt_formatNumeric(reldatefmt: *const URelativeDateTimeFormatter, offset: f64, unit: URelativeDateTimeUnit, result: [*]umachine.UChar, resultCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ureldatefmt_formatNumericToResult(reldatefmt: *const URelativeDateTimeFormatter, offset: f64, unit: URelativeDateTimeUnit, result: *UFormattedRelativeDateTime, status: *utypes.UErrorCode) -> void
pub extern("c") fn ureldatefmt_format(reldatefmt: *const URelativeDateTimeFormatter, offset: f64, unit: URelativeDateTimeUnit, result: [*]umachine.UChar, resultCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ureldatefmt_formatToResult(reldatefmt: *const URelativeDateTimeFormatter, offset: f64, unit: URelativeDateTimeUnit, result: *UFormattedRelativeDateTime, status: *utypes.UErrorCode) -> void
pub extern("c") fn ureldatefmt_combineDateAndTime(reldatefmt: *const URelativeDateTimeFormatter, relativeDateString: [*]const umachine.UChar, relativeDateStringLen: i32, timeString: [*]const umachine.UChar, timeStringLen: i32, result: [*]umachine.UChar, resultCapacity: i32, status: *utypes.UErrorCode) -> i32
