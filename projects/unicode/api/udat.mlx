// unicode/udat.h
// mlx-unicode: date formats (UDateFormat): styles, fields, symbols, the
// skeleton constants, formatting and parsing.
// Declared only: the library does not implement these functions yet.
const ucal = @import("./ucal.mlx")
const udisplaycontext = @import("./udisplaycontext.mlx")
const ufieldpositer = @import("./ufieldpositer.mlx")
const uloc = @import("./uloc.mlx")
const umachine = @import("./umachine.mlx")
const umisc = @import("./umisc.mlx")
const unum = @import("./unum.mlx")
const utypes = @import("./utypes.mlx")

pub const UDateFormat = *anyopaque

pub const UDateFormatStyle = enum(i32, nonexhaustive) {
    UDAT_FULL,
    UDAT_LONG,
    UDAT_MEDIUM,
    UDAT_SHORT,
    UDAT_RELATIVE = 0x80,
    UDAT_LONG_RELATIVE = 0x81,
    UDAT_MEDIUM_RELATIVE = 0x82,
    UDAT_SHORT_RELATIVE = 0x83,
    UDAT_NONE = -1,
    UDAT_PATTERN = -2,
}
pub const UDAT_DEFAULT: UDateFormatStyle = UDateFormatStyle.UDAT_MEDIUM
pub const UDAT_FULL_RELATIVE: UDateFormatStyle = UDateFormatStyle.UDAT_RELATIVE

// Skeletons (udatpg_getBestPattern's): the date fields.
pub const UDAT_YEAR: []const u8 = "y"
pub const UDAT_QUARTER: []const u8 = "QQQQ"
pub const UDAT_ABBR_QUARTER: []const u8 = "QQQ"
pub const UDAT_YEAR_QUARTER: []const u8 = "yQQQQ"
pub const UDAT_YEAR_ABBR_QUARTER: []const u8 = "yQQQ"
pub const UDAT_MONTH: []const u8 = "MMMM"
pub const UDAT_ABBR_MONTH: []const u8 = "MMM"
pub const UDAT_NUM_MONTH: []const u8 = "M"
pub const UDAT_YEAR_MONTH: []const u8 = "yMMMM"
pub const UDAT_YEAR_ABBR_MONTH: []const u8 = "yMMM"
pub const UDAT_YEAR_NUM_MONTH: []const u8 = "yM"
pub const UDAT_DAY: []const u8 = "d"
pub const UDAT_YEAR_MONTH_DAY: []const u8 = "yMMMMd"
pub const UDAT_YEAR_ABBR_MONTH_DAY: []const u8 = "yMMMd"
pub const UDAT_YEAR_NUM_MONTH_DAY: []const u8 = "yMd"
pub const UDAT_WEEKDAY: []const u8 = "EEEE"
pub const UDAT_ABBR_WEEKDAY: []const u8 = "E"
pub const UDAT_YEAR_MONTH_WEEKDAY_DAY: []const u8 = "yMMMMEEEEd"
pub const UDAT_YEAR_ABBR_MONTH_WEEKDAY_DAY: []const u8 = "yMMMEd"
pub const UDAT_YEAR_NUM_MONTH_WEEKDAY_DAY: []const u8 = "yMEd"
pub const UDAT_MONTH_DAY: []const u8 = "MMMMd"
pub const UDAT_ABBR_MONTH_DAY: []const u8 = "MMMd"
pub const UDAT_NUM_MONTH_DAY: []const u8 = "Md"
pub const UDAT_MONTH_WEEKDAY_DAY: []const u8 = "MMMMEEEEd"
pub const UDAT_ABBR_MONTH_WEEKDAY_DAY: []const u8 = "MMMEd"
pub const UDAT_NUM_MONTH_WEEKDAY_DAY: []const u8 = "MEd"
// The time fields.
pub const UDAT_HOUR: []const u8 = "j"
pub const UDAT_HOUR24: []const u8 = "H"
pub const UDAT_MINUTE: []const u8 = "m"
pub const UDAT_HOUR_MINUTE: []const u8 = "jm"
pub const UDAT_HOUR24_MINUTE: []const u8 = "Hm"
pub const UDAT_SECOND: []const u8 = "s"
pub const UDAT_HOUR_MINUTE_SECOND: []const u8 = "jms"
pub const UDAT_HOUR24_MINUTE_SECOND: []const u8 = "Hms"
pub const UDAT_MINUTE_SECOND: []const u8 = "ms"
// The time zones.
pub const UDAT_LOCATION_TZ: []const u8 = "VVVV"
pub const UDAT_GENERIC_TZ: []const u8 = "vvvv"
pub const UDAT_ABBR_GENERIC_TZ: []const u8 = "v"
pub const UDAT_SPECIFIC_TZ: []const u8 = "zzzz"
pub const UDAT_ABBR_SPECIFIC_TZ: []const u8 = "z"
pub const UDAT_ABBR_UTC_TZ: []const u8 = "ZZZZ"

pub const UDateFormatField = enum(i32, nonexhaustive) {
    UDAT_ERA_FIELD = 0,
    UDAT_YEAR_FIELD = 1,
    UDAT_MONTH_FIELD = 2,
    UDAT_DATE_FIELD = 3,
    UDAT_HOUR_OF_DAY1_FIELD = 4,
    UDAT_HOUR_OF_DAY0_FIELD = 5,
    UDAT_MINUTE_FIELD = 6,
    UDAT_SECOND_FIELD = 7,
    UDAT_FRACTIONAL_SECOND_FIELD = 8,
    UDAT_DAY_OF_WEEK_FIELD = 9,
    UDAT_DAY_OF_YEAR_FIELD = 10,
    UDAT_DAY_OF_WEEK_IN_MONTH_FIELD = 11,
    UDAT_WEEK_OF_YEAR_FIELD = 12,
    UDAT_WEEK_OF_MONTH_FIELD = 13,
    UDAT_AM_PM_FIELD = 14,
    UDAT_HOUR1_FIELD = 15,
    UDAT_HOUR0_FIELD = 16,
    UDAT_TIMEZONE_FIELD = 17,
    UDAT_YEAR_WOY_FIELD = 18,
    UDAT_DOW_LOCAL_FIELD = 19,
    UDAT_EXTENDED_YEAR_FIELD = 20,
    UDAT_JULIAN_DAY_FIELD = 21,
    UDAT_MILLISECONDS_IN_DAY_FIELD = 22,
    UDAT_TIMEZONE_RFC_FIELD = 23,
    UDAT_TIMEZONE_GENERIC_FIELD = 24,
    UDAT_STANDALONE_DAY_FIELD = 25,
    UDAT_STANDALONE_MONTH_FIELD = 26,
    UDAT_QUARTER_FIELD = 27,
    UDAT_STANDALONE_QUARTER_FIELD = 28,
    UDAT_TIMEZONE_SPECIAL_FIELD = 29,
    UDAT_YEAR_NAME_FIELD = 30,
    UDAT_TIMEZONE_LOCALIZED_GMT_OFFSET_FIELD = 31,
    UDAT_TIMEZONE_ISO_FIELD = 32,
    UDAT_TIMEZONE_ISO_LOCAL_FIELD = 33,
    UDAT_RELATED_YEAR_FIELD = 34,
    UDAT_AM_PM_MIDNIGHT_NOON_FIELD = 35,
    UDAT_FLEXIBLE_DAY_PERIOD_FIELD = 36,
    UDAT_TIME_SEPARATOR_FIELD = 37,
    UDAT_FIELD_COUNT = 38,
}

pub extern("c") fn udat_toCalendarDateField(field: UDateFormatField) -> ucal.UCalendarDateFields
pub extern("c") fn udat_open(timeStyle: UDateFormatStyle, dateStyle: UDateFormatStyle, locale: [*]const umachine.c_char, tzID: [*]const umachine.UChar, tzIDLength: i32, pattern: [*]const umachine.UChar, patternLength: i32, status: *utypes.UErrorCode) -> *UDateFormat
pub extern("c") fn udat_close(format: *UDateFormat) -> void

pub const UDateFormatBooleanAttribute = enum(i32, nonexhaustive) {
    UDAT_PARSE_ALLOW_WHITESPACE = 0,
    UDAT_PARSE_ALLOW_NUMERIC = 1,
    UDAT_PARSE_PARTIAL_LITERAL_MATCH = 2,
    UDAT_PARSE_MULTIPLE_PATTERNS_FOR_MATCH = 3,
    UDAT_BOOLEAN_ATTRIBUTE_COUNT = 4,
}

pub extern("c") fn udat_getBooleanAttribute(fmt: *const UDateFormat, attr: UDateFormatBooleanAttribute, status: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn udat_setBooleanAttribute(fmt: *UDateFormat, attr: UDateFormatBooleanAttribute, newValue: umachine.UBool, status: *utypes.UErrorCode) -> void

pub const UDateFormatHourCycle = enum(i32, nonexhaustive) {
    UDAT_HOUR_CYCLE_11,
    UDAT_HOUR_CYCLE_12,
    UDAT_HOUR_CYCLE_23,
    UDAT_HOUR_CYCLE_24,
}

pub extern("c") fn udat_clone(fmt: *const UDateFormat, status: *utypes.UErrorCode) -> *UDateFormat
pub extern("c") fn udat_format(format: *const UDateFormat, dateToFormat: umachine.UDate, result: [*]umachine.UChar, resultLength: i32, position: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn udat_formatCalendar(format: *const UDateFormat, calendar: *ucal.UCalendar, result: [*]umachine.UChar, capacity: i32, position: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn udat_formatForFields(format: *const UDateFormat, dateToFormat: umachine.UDate, result: [*]umachine.UChar, resultLength: i32, fpositer: *ufieldpositer.UFieldPositionIterator, status: *utypes.UErrorCode) -> i32
pub extern("c") fn udat_formatCalendarForFields(format: *const UDateFormat, calendar: *ucal.UCalendar, result: [*]umachine.UChar, capacity: i32, fpositer: *ufieldpositer.UFieldPositionIterator, status: *utypes.UErrorCode) -> i32
pub extern("c") fn udat_parse(format: *const UDateFormat, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, status: *utypes.UErrorCode) -> umachine.UDate
pub extern("c") fn udat_parseCalendar(format: *const UDateFormat, calendar: *ucal.UCalendar, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn udat_isLenient(fmt: *const UDateFormat) -> umachine.UBool
pub extern("c") fn udat_setLenient(fmt: *UDateFormat, isLenient: umachine.UBool) -> void
pub extern("c") fn udat_getCalendar(fmt: *const UDateFormat) -> *const ucal.UCalendar
pub extern("c") fn udat_setCalendar(fmt: *UDateFormat, calendarToSet: *const ucal.UCalendar) -> void
pub extern("c") fn udat_getNumberFormat(fmt: *const UDateFormat) -> *const unum.UNumberFormat
pub extern("c") fn udat_getNumberFormatForField(fmt: *const UDateFormat, field: umachine.UChar) -> *const unum.UNumberFormat
pub extern("c") fn udat_adoptNumberFormatForFields(fmt: *UDateFormat, fields: [*]const umachine.UChar, numberFormatToSet: *unum.UNumberFormat, status: *utypes.UErrorCode) -> void
pub extern("c") fn udat_setNumberFormat(fmt: *UDateFormat, numberFormatToSet: *const unum.UNumberFormat) -> void
pub extern("c") fn udat_adoptNumberFormat(fmt: *UDateFormat, numberFormatToAdopt: *unum.UNumberFormat) -> void
pub extern("c") fn udat_getAvailable(localeIndex: i32) -> [*]const umachine.c_char
pub extern("c") fn udat_countAvailable() -> i32
pub extern("c") fn udat_get2DigitYearStart(fmt: *const UDateFormat, status: *utypes.UErrorCode) -> umachine.UDate
pub extern("c") fn udat_set2DigitYearStart(fmt: *UDateFormat, d: umachine.UDate, status: *utypes.UErrorCode) -> void
pub extern("c") fn udat_toPattern(fmt: *const UDateFormat, localized: umachine.UBool, result: [*]umachine.UChar, resultLength: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn udat_applyPattern(format: *UDateFormat, localized: umachine.UBool, pattern: [*]const umachine.UChar, patternLength: i32) -> void

pub const UDateFormatSymbolType = enum(i32, nonexhaustive) {
    UDAT_ERAS,
    UDAT_MONTHS,
    UDAT_SHORT_MONTHS,
    UDAT_WEEKDAYS,
    UDAT_SHORT_WEEKDAYS,
    UDAT_AM_PMS,
    UDAT_LOCALIZED_CHARS,
    UDAT_ERA_NAMES,
    UDAT_NARROW_MONTHS,
    UDAT_NARROW_WEEKDAYS,
    UDAT_STANDALONE_MONTHS,
    UDAT_STANDALONE_SHORT_MONTHS,
    UDAT_STANDALONE_NARROW_MONTHS,
    UDAT_STANDALONE_WEEKDAYS,
    UDAT_STANDALONE_SHORT_WEEKDAYS,
    UDAT_STANDALONE_NARROW_WEEKDAYS,
    UDAT_QUARTERS,
    UDAT_SHORT_QUARTERS,
    UDAT_STANDALONE_QUARTERS,
    UDAT_STANDALONE_SHORT_QUARTERS,
    UDAT_SHORTER_WEEKDAYS,
    UDAT_STANDALONE_SHORTER_WEEKDAYS,
    UDAT_CYCLIC_YEARS_WIDE,
    UDAT_CYCLIC_YEARS_ABBREVIATED,
    UDAT_CYCLIC_YEARS_NARROW,
    UDAT_ZODIAC_NAMES_WIDE,
    UDAT_ZODIAC_NAMES_ABBREVIATED,
    UDAT_ZODIAC_NAMES_NARROW,
    UDAT_NARROW_QUARTERS,
    UDAT_STANDALONE_NARROW_QUARTERS,
}

pub const UDateFormatSymbols = struct {}

pub extern("c") fn udat_getSymbols(fmt: *const UDateFormat, type_: UDateFormatSymbolType, symbolIndex: i32, result: [*]umachine.UChar, resultLength: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn udat_countSymbols(fmt: *const UDateFormat, type_: UDateFormatSymbolType) -> i32
pub extern("c") fn udat_setSymbols(format: *UDateFormat, type_: UDateFormatSymbolType, symbolIndex: i32, value: [*]umachine.UChar, valueLength: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn udat_getLocaleByType(fmt: *const UDateFormat, type_: uloc.ULocDataLocaleType, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn udat_setContext(fmt: *UDateFormat, value: udisplaycontext.UDisplayContext, status: *utypes.UErrorCode) -> void
pub extern("c") fn udat_getContext(fmt: *const UDateFormat, type_: udisplaycontext.UDisplayContextType, status: *utypes.UErrorCode) -> udisplaycontext.UDisplayContext
