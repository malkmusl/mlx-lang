// unicode/unumsys.h
// mlx-unicode: numbering systems (CLDR's "latn", "arab", ... of a locale).
// Declared only: the library does not implement these functions yet.
const uenum = @import("./uenum.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UNumberingSystem = struct {}

pub extern("c") fn unumsys_open(locale: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UNumberingSystem
pub extern("c") fn unumsys_openByName(name: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UNumberingSystem
pub extern("c") fn unumsys_close(unumsys: *UNumberingSystem) -> void
pub extern("c") fn unumsys_openAvailableNames(status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn unumsys_getName(unumsys: *const UNumberingSystem) -> [*]const umachine.c_char
pub extern("c") fn unumsys_isAlgorithmic(unumsys: *const UNumberingSystem) -> umachine.UBool
pub extern("c") fn unumsys_getRadix(unumsys: *const UNumberingSystem) -> i32
pub extern("c") fn unumsys_getDescription(unumsys: *const UNumberingSystem, result: [*]umachine.UChar, resultLength: i32, status: *utypes.UErrorCode) -> i32
