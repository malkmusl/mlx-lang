// unicode/uiter.h
// mlx-unicode: character iterators (C structures of functions).
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

const UChar = umachine.UChar
const UChar32 = umachine.UChar32
const UBool = umachine.UBool
const UErrorCode = utypes.UErrorCode

pub const UCharIteratorOrigin = enum(i32, nonexhaustive) {
    UITER_START,
    UITER_CURRENT,
    UITER_LIMIT,
    UITER_ZERO,
    UITER_LENGTH,
}

pub const UITER_UNKNOWN_INDEX: i32 = -2
pub const UITER_NO_STATE: u32 = 0xffffffff


// (The structure before the function types that take it: Mlx works
// out a type that names one still being worked out only from inside a
// structure.)
pub const UCharIterator = struct {
    context: ?*const anyopaque,
    length: i32,
    start: i32,
    index: i32,
    limit: i32,
    reservedField: i32,
    getIndex: ?UCharIteratorGetIndex,
    move: ?UCharIteratorMove,
    hasNext: ?UCharIteratorHasNext,
    hasPrevious: ?UCharIteratorHasPrevious,
    current: ?UCharIteratorCurrent,
    next: ?UCharIteratorNext,
    previous: ?UCharIteratorPrevious,
    reservedFn: ?UCharIteratorReserved,
    getState: ?UCharIteratorGetState,
    setState: ?UCharIteratorSetState,
}

pub const UCharIteratorGetIndex = fn(iter: *UCharIterator, origin: UCharIteratorOrigin) -> i32
pub const UCharIteratorMove = fn(iter: *UCharIterator, delta: i32, origin: UCharIteratorOrigin) -> i32
pub const UCharIteratorHasNext = fn(iter: *UCharIterator) -> UBool
pub const UCharIteratorHasPrevious = fn(iter: *UCharIterator) -> UBool
pub const UCharIteratorCurrent = fn(iter: *UCharIterator) -> UChar32
pub const UCharIteratorNext = fn(iter: *UCharIterator) -> UChar32
pub const UCharIteratorPrevious = fn(iter: *UCharIterator) -> UChar32
pub const UCharIteratorReserved = fn(iter: *UCharIterator, something: i32) -> i32
pub const UCharIteratorGetState = fn(iter: *const UCharIterator) -> u32
pub const UCharIteratorSetState = fn(iter: *UCharIterator, state: u32, pErrorCode: *UErrorCode) -> void

pub extern("c") fn uiter_current32(iter: *UCharIterator) -> UChar32
pub extern("c") fn uiter_next32(iter: *UCharIterator) -> UChar32
pub extern("c") fn uiter_previous32(iter: *UCharIterator) -> UChar32
pub extern("c") fn uiter_getState(iter: *const UCharIterator) -> u32
pub extern("c") fn uiter_setState(iter: *UCharIterator, state: u32, pErrorCode: *UErrorCode) -> void
pub extern("c") fn uiter_setString(iter: *UCharIterator, s: ?[*]const UChar, length: i32) -> void
pub extern("c") fn uiter_setUTF8(iter: *UCharIterator, s: ?[*]const umachine.c_char, length: i32) -> void
