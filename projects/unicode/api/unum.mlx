// unicode/unum.h
// mlx-unicode: number formats (UNumberFormat): styles, attributes, symbols,
// formatting and parsing.
// Declared only: the library does not implement these functions yet.
const parseerr = @import("./parseerr.mlx")
const ucurr = @import("./ucurr.mlx")
const udisplaycontext = @import("./udisplaycontext.mlx")
const ufieldpositer = @import("./ufieldpositer.mlx")
const uformattable = @import("./uformattable.mlx")
const uloc = @import("./uloc.mlx")
const umachine = @import("./umachine.mlx")
const umisc = @import("./umisc.mlx")
const unumberoptions = @import("./unumberoptions.mlx")
const utypes = @import("./utypes.mlx")

pub const UNumberFormat = *anyopaque

pub const UNumberFormatStyle = enum(i32, nonexhaustive) {
    UNUM_PATTERN_DECIMAL = 0,
    UNUM_DECIMAL = 1,
    UNUM_CURRENCY = 2,
    UNUM_PERCENT = 3,
    UNUM_SCIENTIFIC = 4,
    UNUM_SPELLOUT = 5,
    UNUM_ORDINAL = 6,
    UNUM_DURATION = 7,
    UNUM_NUMBERING_SYSTEM = 8,
    UNUM_PATTERN_RULEBASED = 9,
    UNUM_CURRENCY_ISO = 10,
    UNUM_CURRENCY_PLURAL = 11,
    UNUM_CURRENCY_ACCOUNTING = 12,
    UNUM_CASH_CURRENCY = 13,
    UNUM_DECIMAL_COMPACT_SHORT = 14,
    UNUM_DECIMAL_COMPACT_LONG = 15,
    UNUM_CURRENCY_STANDARD = 16,
    UNUM_FORMAT_STYLE_COUNT = 17,
}
pub const UNUM_DEFAULT: UNumberFormatStyle = UNumberFormatStyle.UNUM_DECIMAL
pub const UNUM_IGNORE: UNumberFormatStyle = UNumberFormatStyle.UNUM_PATTERN_DECIMAL

pub const UNumberFormatPadPosition = enum(i32, nonexhaustive) {
    UNUM_PAD_BEFORE_PREFIX,
    UNUM_PAD_AFTER_PREFIX,
    UNUM_PAD_BEFORE_SUFFIX,
    UNUM_PAD_AFTER_SUFFIX,
}

pub const UNumberCompactStyle = enum(i32, nonexhaustive) {
    UNUM_SHORT,
    UNUM_LONG,
}

pub const UCurrencySpacing = enum(i32, nonexhaustive) {
    UNUM_CURRENCY_MATCH,
    UNUM_CURRENCY_SURROUNDING_MATCH,
    UNUM_CURRENCY_INSERT,
    UNUM_CURRENCY_SPACING_COUNT,
}

pub const UNumberFormatFields = enum(i32, nonexhaustive) {
    UNUM_INTEGER_FIELD,
    UNUM_FRACTION_FIELD,
    UNUM_DECIMAL_SEPARATOR_FIELD,
    UNUM_EXPONENT_SYMBOL_FIELD,
    UNUM_EXPONENT_SIGN_FIELD,
    UNUM_EXPONENT_FIELD,
    UNUM_GROUPING_SEPARATOR_FIELD,
    UNUM_CURRENCY_FIELD,
    UNUM_PERCENT_FIELD,
    UNUM_PERMILL_FIELD,
    UNUM_SIGN_FIELD,
    UNUM_MEASURE_UNIT_FIELD,
    UNUM_COMPACT_FIELD,
    UNUM_APPROXIMATELY_SIGN_FIELD,
    UNUM_FIELD_COUNT,
}

pub const UNumberFormatMinimumGroupingDigits = enum(i32, nonexhaustive) {
    UNUM_MINIMUM_GROUPING_DIGITS_AUTO = -2,
    UNUM_MINIMUM_GROUPING_DIGITS_MIN2 = -3,
}

pub extern("c") fn unum_open(style: UNumberFormatStyle, pattern: [*]const umachine.UChar, patternLength: i32, locale: [*]const umachine.c_char, parseErr: *parseerr.UParseError, status: *utypes.UErrorCode) -> *UNumberFormat
pub extern("c") fn unum_close(fmt: *UNumberFormat) -> void
pub extern("c") fn unum_clone(fmt: *const UNumberFormat, status: *utypes.UErrorCode) -> *UNumberFormat
pub extern("c") fn unum_format(fmt: *const UNumberFormat, number: i32, result: [*]umachine.UChar, resultLength: i32, pos: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_formatInt64(fmt: *const UNumberFormat, number: i64, result: [*]umachine.UChar, resultLength: i32, pos: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_formatDouble(fmt: *const UNumberFormat, number: f64, result: [*]umachine.UChar, resultLength: i32, pos: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_formatDoubleForFields(format: *const UNumberFormat, number: f64, result: [*]umachine.UChar, resultLength: i32, fpositer: *ufieldpositer.UFieldPositionIterator, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_formatDecimal(fmt: *const UNumberFormat, number: [*]const umachine.c_char, length: i32, result: [*]umachine.UChar, resultLength: i32, pos: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_formatDoubleCurrency(fmt: *const UNumberFormat, number: f64, currency: [*]umachine.UChar, result: [*]umachine.UChar, resultLength: i32, pos: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_formatUFormattable(fmt: *const UNumberFormat, number: *const uformattable.UFormattable, result: [*]umachine.UChar, resultLength: i32, pos: *umisc.UFieldPosition, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_parse(fmt: *const UNumberFormat, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_parseInt64(fmt: *const UNumberFormat, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, status: *utypes.UErrorCode) -> i64
pub extern("c") fn unum_parseDouble(fmt: *const UNumberFormat, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, status: *utypes.UErrorCode) -> f64
pub extern("c") fn unum_parseDecimal(fmt: *const UNumberFormat, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, outBuf: [*]umachine.c_char, outBufLength: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_parseDoubleCurrency(fmt: *const UNumberFormat, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, currency: [*]umachine.UChar, status: *utypes.UErrorCode) -> f64
pub extern("c") fn unum_parseToUFormattable(fmt: *const UNumberFormat, result: *uformattable.UFormattable, text: [*]const umachine.UChar, textLength: i32, parsePos: *i32, status: *utypes.UErrorCode) -> *uformattable.UFormattable
pub extern("c") fn unum_applyPattern(format: *UNumberFormat, localized: umachine.UBool, pattern: [*]const umachine.UChar, patternLength: i32, parseError: *parseerr.UParseError, status: *utypes.UErrorCode) -> void
pub extern("c") fn unum_getAvailable(localeIndex: i32) -> [*]const umachine.c_char
pub extern("c") fn unum_countAvailable() -> i32

pub const UNumberFormatAttributeValue = enum(i32, nonexhaustive) {
    UNUM_NO = 0,
    UNUM_YES = 1,
    UNUM_MAYBE = 2,
}

pub const UNumberFormatAttribute = enum(i32, nonexhaustive) {
    UNUM_PARSE_INT_ONLY,
    UNUM_GROUPING_USED,
    UNUM_DECIMAL_ALWAYS_SHOWN,
    UNUM_MAX_INTEGER_DIGITS,
    UNUM_MIN_INTEGER_DIGITS,
    UNUM_INTEGER_DIGITS,
    UNUM_MAX_FRACTION_DIGITS,
    UNUM_MIN_FRACTION_DIGITS,
    UNUM_FRACTION_DIGITS,
    UNUM_MULTIPLIER,
    UNUM_GROUPING_SIZE,
    UNUM_ROUNDING_MODE,
    UNUM_ROUNDING_INCREMENT,
    UNUM_FORMAT_WIDTH,
    UNUM_PADDING_POSITION,
    UNUM_SECONDARY_GROUPING_SIZE,
    UNUM_SIGNIFICANT_DIGITS_USED,
    UNUM_MIN_SIGNIFICANT_DIGITS,
    UNUM_MAX_SIGNIFICANT_DIGITS,
    UNUM_LENIENT_PARSE,
    UNUM_PARSE_ALL_INPUT = 20,
    UNUM_SCALE = 21,
    UNUM_MINIMUM_GROUPING_DIGITS = 22,
    UNUM_CURRENCY_USAGE = 23,
    UNUM_MAX_NONBOOLEAN_ATTRIBUTE = 0x0FFF,
    UNUM_FORMAT_FAIL_IF_MORE_THAN_MAX_DIGITS = 0x1000,
    UNUM_PARSE_NO_EXPONENT = 0x1001,
    UNUM_PARSE_DECIMAL_MARK_REQUIRED = 0x1002,
    UNUM_PARSE_CASE_SENSITIVE = 0x1003,
    UNUM_SIGN_ALWAYS_SHOWN = 0x1004,
    UNUM_LIMIT_BOOLEAN_ATTRIBUTE = 0x1005,
}

pub extern("c") fn unum_hasAttribute(fmt: *const UNumberFormat, attr: UNumberFormatAttribute) -> bool
pub extern("c") fn unum_getAttribute(fmt: *const UNumberFormat, attr: UNumberFormatAttribute) -> i32
pub extern("c") fn unum_setAttribute(fmt: *UNumberFormat, attr: UNumberFormatAttribute, newValue: i32) -> void
pub extern("c") fn unum_getDoubleAttribute(fmt: *const UNumberFormat, attr: UNumberFormatAttribute) -> f64
pub extern("c") fn unum_setDoubleAttribute(fmt: *UNumberFormat, attr: UNumberFormatAttribute, newValue: f64) -> void

pub const UNumberFormatTextAttribute = enum(i32, nonexhaustive) {
    UNUM_POSITIVE_PREFIX,
    UNUM_POSITIVE_SUFFIX,
    UNUM_NEGATIVE_PREFIX,
    UNUM_NEGATIVE_SUFFIX,
    UNUM_PADDING_CHARACTER,
    UNUM_CURRENCY_CODE,
    UNUM_DEFAULT_RULESET,
    UNUM_PUBLIC_RULESETS,
}

pub extern("c") fn unum_getTextAttribute(fmt: *const UNumberFormat, tag: UNumberFormatTextAttribute, result: [*]umachine.UChar, resultLength: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_setTextAttribute(fmt: *UNumberFormat, tag: UNumberFormatTextAttribute, newValue: [*]const umachine.UChar, newValueLength: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn unum_toPattern(fmt: *const UNumberFormat, isPatternLocalized: umachine.UBool, result: [*]umachine.UChar, resultLength: i32, status: *utypes.UErrorCode) -> i32

pub const UNumberFormatSymbol = enum(i32, nonexhaustive) {
    UNUM_DECIMAL_SEPARATOR_SYMBOL = 0,
    UNUM_GROUPING_SEPARATOR_SYMBOL = 1,
    UNUM_PATTERN_SEPARATOR_SYMBOL = 2,
    UNUM_PERCENT_SYMBOL = 3,
    UNUM_ZERO_DIGIT_SYMBOL = 4,
    UNUM_DIGIT_SYMBOL = 5,
    UNUM_MINUS_SIGN_SYMBOL = 6,
    UNUM_PLUS_SIGN_SYMBOL = 7,
    UNUM_CURRENCY_SYMBOL = 8,
    UNUM_INTL_CURRENCY_SYMBOL = 9,
    UNUM_MONETARY_SEPARATOR_SYMBOL = 10,
    UNUM_EXPONENTIAL_SYMBOL = 11,
    UNUM_PERMILL_SYMBOL = 12,
    UNUM_PAD_ESCAPE_SYMBOL = 13,
    UNUM_INFINITY_SYMBOL = 14,
    UNUM_NAN_SYMBOL = 15,
    UNUM_SIGNIFICANT_DIGIT_SYMBOL = 16,
    UNUM_MONETARY_GROUPING_SEPARATOR_SYMBOL = 17,
    UNUM_ONE_DIGIT_SYMBOL = 18,
    UNUM_TWO_DIGIT_SYMBOL = 19,
    UNUM_THREE_DIGIT_SYMBOL = 20,
    UNUM_FOUR_DIGIT_SYMBOL = 21,
    UNUM_FIVE_DIGIT_SYMBOL = 22,
    UNUM_SIX_DIGIT_SYMBOL = 23,
    UNUM_SEVEN_DIGIT_SYMBOL = 24,
    UNUM_EIGHT_DIGIT_SYMBOL = 25,
    UNUM_NINE_DIGIT_SYMBOL = 26,
    UNUM_EXPONENT_MULTIPLICATION_SYMBOL = 27,
    UNUM_APPROXIMATELY_SIGN_SYMBOL = 28,
    UNUM_FORMAT_SYMBOL_COUNT = 29,
}

pub extern("c") fn unum_getSymbol(fmt: *const UNumberFormat, symbol: UNumberFormatSymbol, buffer: [*]umachine.UChar, size: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn unum_setSymbol(fmt: *UNumberFormat, symbol: UNumberFormatSymbol, value: [*]const umachine.UChar, length: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn unum_getLocaleByType(fmt: *const UNumberFormat, type_: uloc.ULocDataLocaleType, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn unum_setContext(fmt: *UNumberFormat, value: udisplaycontext.UDisplayContext, status: *utypes.UErrorCode) -> void
pub extern("c") fn unum_getContext(fmt: *const UNumberFormat, type_: udisplaycontext.UDisplayContextType, status: *utypes.UErrorCode) -> udisplaycontext.UDisplayContext
