// unicode/ulistformatter.h
// mlx-unicode: list formatters ("a, b, and c" in a locale).
const uformattedvalue = @import("./uformattedvalue.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UListFormatter = struct {}

pub const UFormattedList = struct {}

pub const UListFormatterField = enum(i32, nonexhaustive) {
    ULISTFMT_LITERAL_FIELD,
    ULISTFMT_ELEMENT_FIELD,
}

pub const UListFormatterType = enum(i32, nonexhaustive) {
    ULISTFMT_TYPE_AND,
    ULISTFMT_TYPE_OR,
    ULISTFMT_TYPE_UNITS,
}

pub const UListFormatterWidth = enum(i32, nonexhaustive) {
    ULISTFMT_WIDTH_WIDE,
    ULISTFMT_WIDTH_SHORT,
    ULISTFMT_WIDTH_NARROW,
}

pub extern("c") fn ulistfmt_open(locale: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UListFormatter
pub extern("c") fn ulistfmt_openForType(locale: [*]const umachine.c_char, type_: UListFormatterType, width: UListFormatterWidth, status: *utypes.UErrorCode) -> *UListFormatter
pub extern("c") fn ulistfmt_close(listfmt: *UListFormatter) -> void
pub extern("c") fn ulistfmt_openResult(ec: *utypes.UErrorCode) -> *UFormattedList
pub extern("c") fn ulistfmt_resultAsValue(uresult: *const UFormattedList, ec: *utypes.UErrorCode) -> *const uformattedvalue.UFormattedValue
pub extern("c") fn ulistfmt_closeResult(uresult: *UFormattedList) -> void
pub extern("c") fn ulistfmt_format(listfmt: *const UListFormatter, strings: [*]const [*]const umachine.UChar, stringLengths: *const i32, stringCount: i32, result: [*]umachine.UChar, resultCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ulistfmt_formatStringsToResult(listfmt: *const UListFormatter, strings: [*]const [*]const umachine.UChar, stringLengths: *const i32, stringCount: i32, uresult: *UFormattedList, status: *utypes.UErrorCode) -> void
