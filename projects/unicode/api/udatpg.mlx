// unicode/udatpg.h
// mlx-unicode: date-time pattern generators (the best pattern of a
// skeleton for a locale, field display names).
// Declared only: the library does not implement these functions yet.
const udat = @import("./udat.mlx")
const uenum = @import("./uenum.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UDateTimePatternGenerator = *anyopaque

pub const UDateTimePatternField = enum(i32, nonexhaustive) {
    UDATPG_ERA_FIELD,
    UDATPG_YEAR_FIELD,
    UDATPG_QUARTER_FIELD,
    UDATPG_MONTH_FIELD,
    UDATPG_WEEK_OF_YEAR_FIELD,
    UDATPG_WEEK_OF_MONTH_FIELD,
    UDATPG_WEEKDAY_FIELD,
    UDATPG_DAY_OF_YEAR_FIELD,
    UDATPG_DAY_OF_WEEK_IN_MONTH_FIELD,
    UDATPG_DAY_FIELD,
    UDATPG_DAYPERIOD_FIELD,
    UDATPG_HOUR_FIELD,
    UDATPG_MINUTE_FIELD,
    UDATPG_SECOND_FIELD,
    UDATPG_FRACTIONAL_SECOND_FIELD,
    UDATPG_ZONE_FIELD,
    UDATPG_FIELD_COUNT,
}

pub const UDateTimePGDisplayWidth = enum(i32, nonexhaustive) {
    UDATPG_WIDE,
    UDATPG_ABBREVIATED,
    UDATPG_NARROW,
}

pub const UDateTimePatternMatchOptions = enum(i32, nonexhaustive) {
    UDATPG_MATCH_NO_OPTIONS = 0,
    UDATPG_MATCH_HOUR_FIELD_LENGTH = 0x800,
    UDATPG_MATCH_MINUTE_FIELD_LENGTH = 0x1000,
    UDATPG_MATCH_SECOND_FIELD_LENGTH = 0x2000,
    UDATPG_MATCH_ALL_FIELDS_LENGTH = 0xffff,
}

pub const UDateTimePatternConflict = enum(i32, nonexhaustive) {
    UDATPG_NO_CONFLICT,
    UDATPG_BASE_CONFLICT,
    UDATPG_CONFLICT,
    UDATPG_CONFLICT_COUNT,
}

pub extern("c") fn udatpg_open(locale: [*]const umachine.c_char, pErrorCode: *utypes.UErrorCode) -> *UDateTimePatternGenerator
pub extern("c") fn udatpg_openEmpty(pErrorCode: *utypes.UErrorCode) -> *UDateTimePatternGenerator
pub extern("c") fn udatpg_close(dtpg: *UDateTimePatternGenerator) -> void
pub extern("c") fn udatpg_clone(dtpg: *const UDateTimePatternGenerator, pErrorCode: *utypes.UErrorCode) -> *UDateTimePatternGenerator
pub extern("c") fn udatpg_getBestPattern(dtpg: *UDateTimePatternGenerator, skeleton: [*]const umachine.UChar, length: i32, bestPattern: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn udatpg_getBestPatternWithOptions(dtpg: *UDateTimePatternGenerator, skeleton: [*]const umachine.UChar, length: i32, options: UDateTimePatternMatchOptions, bestPattern: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn udatpg_getSkeleton(unusedDtpg: *UDateTimePatternGenerator, pattern: [*]const umachine.UChar, length: i32, skeleton: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn udatpg_getBaseSkeleton(unusedDtpg: *UDateTimePatternGenerator, pattern: [*]const umachine.UChar, length: i32, baseSkeleton: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn udatpg_addPattern(dtpg: *UDateTimePatternGenerator, pattern: [*]const umachine.UChar, patternLength: i32, override: umachine.UBool, conflictingPattern: [*]umachine.UChar, capacity: i32, pLength: *i32, pErrorCode: *utypes.UErrorCode) -> UDateTimePatternConflict
pub extern("c") fn udatpg_setAppendItemFormat(dtpg: *UDateTimePatternGenerator, field: UDateTimePatternField, value: [*]const umachine.UChar, length: i32) -> void
pub extern("c") fn udatpg_getAppendItemFormat(dtpg: *const UDateTimePatternGenerator, field: UDateTimePatternField, pLength: *i32) -> [*]const umachine.UChar
pub extern("c") fn udatpg_setAppendItemName(dtpg: *UDateTimePatternGenerator, field: UDateTimePatternField, value: [*]const umachine.UChar, length: i32) -> void
pub extern("c") fn udatpg_getAppendItemName(dtpg: *const UDateTimePatternGenerator, field: UDateTimePatternField, pLength: *i32) -> [*]const umachine.UChar
pub extern("c") fn udatpg_getFieldDisplayName(dtpg: *const UDateTimePatternGenerator, field: UDateTimePatternField, width: UDateTimePGDisplayWidth, fieldName: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn udatpg_setDateTimeFormat(dtpg: *const UDateTimePatternGenerator, dtFormat: [*]const umachine.UChar, length: i32) -> void
pub extern("c") fn udatpg_getDateTimeFormat(dtpg: *const UDateTimePatternGenerator, pLength: *i32) -> [*]const umachine.UChar
pub extern("c") fn udatpg_setDateTimeFormatForStyle(udtpg: *UDateTimePatternGenerator, style: udat.UDateFormatStyle, dateTimeFormat: [*]const umachine.UChar, length: i32, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn udatpg_getDateTimeFormatForStyle(udtpg: *const UDateTimePatternGenerator, style: udat.UDateFormatStyle, pLength: *i32, pErrorCode: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn udatpg_setDecimal(dtpg: *UDateTimePatternGenerator, decimal: [*]const umachine.UChar, length: i32) -> void
pub extern("c") fn udatpg_getDecimal(dtpg: *const UDateTimePatternGenerator, pLength: *i32) -> [*]const umachine.UChar
pub extern("c") fn udatpg_replaceFieldTypes(dtpg: *UDateTimePatternGenerator, pattern: [*]const umachine.UChar, patternLength: i32, skeleton: [*]const umachine.UChar, skeletonLength: i32, dest: [*]umachine.UChar, destCapacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn udatpg_replaceFieldTypesWithOptions(dtpg: *UDateTimePatternGenerator, pattern: [*]const umachine.UChar, patternLength: i32, skeleton: [*]const umachine.UChar, skeletonLength: i32, options: UDateTimePatternMatchOptions, dest: [*]umachine.UChar, destCapacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn udatpg_openSkeletons(dtpg: *const UDateTimePatternGenerator, pErrorCode: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn udatpg_openBaseSkeletons(dtpg: *const UDateTimePatternGenerator, pErrorCode: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn udatpg_getPatternForSkeleton(dtpg: *const UDateTimePatternGenerator, skeleton: [*]const umachine.UChar, skeletonLength: i32, pLength: *i32) -> [*]const umachine.UChar
pub extern("c") fn udatpg_getDefaultHourCycle(dtpg: *const UDateTimePatternGenerator, pErrorCode: *utypes.UErrorCode) -> udat.UDateFormatHourCycle
