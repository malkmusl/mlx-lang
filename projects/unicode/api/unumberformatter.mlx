// unicode/unumberformatter.h
// mlx-unicode: number formatters made of skeletons (UNumberFormatter)
// and their options.
// Declared only: the library does not implement these functions yet.
const parseerr = @import("./parseerr.mlx")
const uformattednumber = @import("./uformattednumber.mlx")
const umachine = @import("./umachine.mlx")
const unumberoptions = @import("./unumberoptions.mlx")
const utypes = @import("./utypes.mlx")

pub const UNumberRoundingPriority = enum(i32, nonexhaustive) {
    UNUM_ROUNDING_PRIORITY_RELAXED,
    UNUM_ROUNDING_PRIORITY_STRICT,
}

pub const UNumberUnitWidth = enum(i32, nonexhaustive) {
    UNUM_UNIT_WIDTH_NARROW = 0,
    UNUM_UNIT_WIDTH_SHORT = 1,
    UNUM_UNIT_WIDTH_FULL_NAME = 2,
    UNUM_UNIT_WIDTH_ISO_CODE = 3,
    UNUM_UNIT_WIDTH_FORMAL = 4,
    UNUM_UNIT_WIDTH_VARIANT = 5,
    UNUM_UNIT_WIDTH_HIDDEN = 6,
    UNUM_UNIT_WIDTH_COUNT = 7,
}

pub const UNumberSignDisplay = enum(i32, nonexhaustive) {
    UNUM_SIGN_AUTO,
    UNUM_SIGN_ALWAYS,
    UNUM_SIGN_NEVER,
    UNUM_SIGN_ACCOUNTING,
    UNUM_SIGN_ACCOUNTING_ALWAYS,
    UNUM_SIGN_EXCEPT_ZERO,
    UNUM_SIGN_ACCOUNTING_EXCEPT_ZERO,
    UNUM_SIGN_NEGATIVE,
    UNUM_SIGN_ACCOUNTING_NEGATIVE,
    UNUM_SIGN_COUNT = 9,
}

pub const UNumberDecimalSeparatorDisplay = enum(i32, nonexhaustive) {
    UNUM_DECIMAL_SEPARATOR_AUTO,
    UNUM_DECIMAL_SEPARATOR_ALWAYS,
    UNUM_DECIMAL_SEPARATOR_COUNT,
}

pub const UNumberTrailingZeroDisplay = enum(i32, nonexhaustive) {
    UNUM_TRAILING_ZERO_AUTO,
    UNUM_TRAILING_ZERO_HIDE_IF_WHOLE,
}

pub const UNumberFormatter = struct {}

pub extern("c") fn unumf_openForSkeletonAndLocale(skeleton: [*]const umachine.UChar, skeletonLen: i32, locale: [*]const umachine.c_char, ec: *utypes.UErrorCode) -> *UNumberFormatter
pub extern("c") fn unumf_openForSkeletonAndLocaleWithError(skeleton: [*]const umachine.UChar, skeletonLen: i32, locale: [*]const umachine.c_char, perror: *parseerr.UParseError, ec: *utypes.UErrorCode) -> *UNumberFormatter
pub extern("c") fn unumf_formatInt(uformatter: *const UNumberFormatter, value: i64, uresult: *uformattednumber.UFormattedNumber, ec: *utypes.UErrorCode) -> void
pub extern("c") fn unumf_formatDouble(uformatter: *const UNumberFormatter, value: f64, uresult: *uformattednumber.UFormattedNumber, ec: *utypes.UErrorCode) -> void
pub extern("c") fn unumf_formatDecimal(uformatter: *const UNumberFormatter, value: [*]const umachine.c_char, valueLen: i32, uresult: *uformattednumber.UFormattedNumber, ec: *utypes.UErrorCode) -> void
pub extern("c") fn unumf_close(uformatter: *UNumberFormatter) -> void
