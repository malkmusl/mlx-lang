// unicode/uscript.h
// mlx-unicode: scripts (Scripts.txt and ScriptExtensions.txt, and the
// ISO 15924 codes no code point has).
const ugenerated = @import("./ugenerated.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UScriptUsage = enum(i32, nonexhaustive) {
    USCRIPT_USAGE_NOT_ENCODED,
    USCRIPT_USAGE_UNKNOWN,
    USCRIPT_USAGE_EXCLUDED,
    USCRIPT_USAGE_LIMITED_USE,
    USCRIPT_USAGE_ASPIRATIONAL,
    USCRIPT_USAGE_RECOMMENDED,
}

pub extern("c") fn uscript_getCode(nameOrAbbrOrLocale: [*]const umachine.c_char, fillIn: *ugenerated.UScriptCode, capacity: i32, err: *utypes.UErrorCode) -> i32
pub extern("c") fn uscript_getName(scriptCode: ugenerated.UScriptCode) -> [*]const umachine.c_char
pub extern("c") fn uscript_getShortName(scriptCode: ugenerated.UScriptCode) -> [*]const umachine.c_char
pub extern("c") fn uscript_getScript(codepoint: umachine.UChar32, err: *utypes.UErrorCode) -> ugenerated.UScriptCode
pub extern("c") fn uscript_hasScript(c: umachine.UChar32, sc: ugenerated.UScriptCode) -> umachine.UBool
pub extern("c") fn uscript_getScriptExtensions(c: umachine.UChar32, scripts: *ugenerated.UScriptCode, capacity: i32, errorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uscript_getUsage(script: ugenerated.UScriptCode) -> UScriptUsage
pub extern("c") fn uscript_isRightToLeft(script: ugenerated.UScriptCode) -> umachine.UBool
pub extern("c") fn uscript_breaksBetweenLetters(script: ugenerated.UScriptCode) -> umachine.UBool
pub extern("c") fn uscript_isCased(script: ugenerated.UScriptCode) -> umachine.UBool
