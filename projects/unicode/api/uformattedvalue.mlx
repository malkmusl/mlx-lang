// unicode/uformattedvalue.h
// mlx-unicode: the results of the formatters (UFormattedValue) and the
// positions of their fields (UConstrainedFieldPosition).
// Declared only: the library does not implement these functions yet.
const ufieldpositer = @import("./ufieldpositer.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UFieldCategory = enum(i32, nonexhaustive) {
    UFIELD_CATEGORY_UNDEFINED = 0,
    UFIELD_CATEGORY_DATE,
    UFIELD_CATEGORY_NUMBER,
    UFIELD_CATEGORY_LIST,
    UFIELD_CATEGORY_RELATIVE_DATETIME,
    UFIELD_CATEGORY_DATE_INTERVAL,
    UFIELD_CATEGORY_COUNT,
    UFIELD_CATEGORY_LIST_SPAN = 0x1003,
    UFIELD_CATEGORY_DATE_INTERVAL_SPAN = 0x1005,
    UFIELD_CATEGORY_NUMBER_RANGE_SPAN = 0x1002,
}

pub const UConstrainedFieldPosition = struct {}

pub extern("c") fn ucfpos_open(ec: *utypes.UErrorCode) -> *UConstrainedFieldPosition
pub extern("c") fn ucfpos_reset(ucfpos: *UConstrainedFieldPosition, ec: *utypes.UErrorCode) -> void
pub extern("c") fn ucfpos_close(ucfpos: *UConstrainedFieldPosition) -> void
pub extern("c") fn ucfpos_constrainCategory(ucfpos: *UConstrainedFieldPosition, category: i32, ec: *utypes.UErrorCode) -> void
pub extern("c") fn ucfpos_constrainField(ucfpos: *UConstrainedFieldPosition, category: i32, field: i32, ec: *utypes.UErrorCode) -> void
pub extern("c") fn ucfpos_getCategory(ucfpos: *const UConstrainedFieldPosition, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucfpos_getField(ucfpos: *const UConstrainedFieldPosition, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucfpos_getIndexes(ucfpos: *const UConstrainedFieldPosition, pStart: *i32, pLimit: *i32, ec: *utypes.UErrorCode) -> void
pub extern("c") fn ucfpos_getInt64IterationContext(ucfpos: *const UConstrainedFieldPosition, ec: *utypes.UErrorCode) -> i64
pub extern("c") fn ucfpos_setInt64IterationContext(ucfpos: *UConstrainedFieldPosition, context: i64, ec: *utypes.UErrorCode) -> void
pub extern("c") fn ucfpos_matchesField(ucfpos: *const UConstrainedFieldPosition, category: i32, field: i32, ec: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn ucfpos_setState(ucfpos: *UConstrainedFieldPosition, category: i32, field: i32, start: i32, limit: i32, ec: *utypes.UErrorCode) -> void

pub const UFormattedValue = struct {}

pub extern("c") fn ufmtval_getString(ufmtval: *const UFormattedValue, pLength: *i32, ec: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ufmtval_nextPosition(ufmtval: *const UFormattedValue, ucfpos: *UConstrainedFieldPosition, ec: *utypes.UErrorCode) -> umachine.UBool
