// unicode/uldnames.h
// mlx-unicode: display names of locales, languages, scripts, regions and
// keywords in a locale.
// Declared only: the library does not implement these functions yet.
const udisplaycontext = @import("./udisplaycontext.mlx")
const ugenerated = @import("./ugenerated.mlx")
const umachine = @import("./umachine.mlx")
const uscript = @import("./uscript.mlx")
const utypes = @import("./utypes.mlx")

pub const UDialectHandling = enum(i32, nonexhaustive) {
    ULDN_STANDARD_NAMES = 0,
    ULDN_DIALECT_NAMES,
}

pub const ULocaleDisplayNames = struct {}

pub extern("c") fn uldn_open(locale: [*]const umachine.c_char, dialectHandling: UDialectHandling, pErrorCode: *utypes.UErrorCode) -> *ULocaleDisplayNames
pub extern("c") fn uldn_close(ldn: *ULocaleDisplayNames) -> void
pub extern("c") fn uldn_getLocale(ldn: *const ULocaleDisplayNames) -> [*]const umachine.c_char
pub extern("c") fn uldn_getDialectHandling(ldn: *const ULocaleDisplayNames) -> UDialectHandling
pub extern("c") fn uldn_localeDisplayName(ldn: *const ULocaleDisplayNames, locale: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_languageDisplayName(ldn: *const ULocaleDisplayNames, lang: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_scriptDisplayName(ldn: *const ULocaleDisplayNames, script: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_scriptCodeDisplayName(ldn: *const ULocaleDisplayNames, scriptCode: ugenerated.UScriptCode, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_regionDisplayName(ldn: *const ULocaleDisplayNames, region: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_variantDisplayName(ldn: *const ULocaleDisplayNames, variant: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_keyDisplayName(ldn: *const ULocaleDisplayNames, key: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_keyValueDisplayName(ldn: *const ULocaleDisplayNames, key: [*]const umachine.c_char, value: [*]const umachine.c_char, result: [*]umachine.UChar, maxResultSize: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn uldn_openForContext(locale: [*]const umachine.c_char, contexts: *udisplaycontext.UDisplayContext, length: i32, pErrorCode: *utypes.UErrorCode) -> *ULocaleDisplayNames
pub extern("c") fn uldn_getContext(ldn: *const ULocaleDisplayNames, type_: udisplaycontext.UDisplayContextType, pErrorCode: *utypes.UErrorCode) -> udisplaycontext.UDisplayContext
