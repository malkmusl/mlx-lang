// Enumerations of strings (uenum.h): a list kept in C memory, each
// string as a NUL-ended char string and given as UTF-16 on request.
const m = @import("./memory.mlx")

// The enumeration: count, index, the strings' addresses, a UTF-16 buffer
// for uenum_unext, its capacity.
const COUNT: usize = 0
const INDEX: usize = 8
const STRINGS: usize = 16
const UNITS: usize = 24
const UNITS_CAPACITY: usize = 32
const SIZE: usize = 40

// The enumeration of the strings `count` at `strings` (char * each),
// copied.
pub fn ofStrings(strings: usize, count: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const en = m.alloc(SIZE)
    const list = m.alloc(count * 8 + 8)
    if en == 0 || list == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    var index: usize = 0
    while index < count {
        const source = m.getWord(strings + index * 8)
        const length = m.cLength(source)
        const copy = m.alloc(length + 1)
        m.copy(copy, source, length)
        m.putWord(list + index * 8, copy)
        index += 1
    }
    m.putWord(en + COUNT, count)
    m.putWord(en + STRINGS, list)
    return en
}

// The enumeration of the lines of `text` (each ended by a newline).
pub fn ofLines(text: []const u8, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const count = lineCount(text)
    const en = m.alloc(SIZE)
    const list = m.alloc(count * 8 + 8)
    if en == 0 || list == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    var start: usize = 0
    var index: usize = 0
    var at: usize = 0
    while at < text.length {
        if text[at] == 10 {
            const copy = m.alloc(at - start + 1)
            var k: usize = 0
            while k < at - start {
                m.put8(copy + k, text[start + k])
                k += 1
            }
            m.putWord(list + index * 8, copy)
            index += 1
            start = at + 1
        }
        at += 1
    }
    m.putWord(en + COUNT, count)
    m.putWord(en + STRINGS, list)
    return en
}

pub fn lineCount(text: []const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < text.length {
        if text[at] == 10 { count += 1 }
        at += 1
    }
    return count
}

// Line `index` of `text` as a C string kept for the library's life (0
// when there is none).
var kept: [512]usize = undefined
var keptText: [512]usize = undefined
var keptCount: usize = 0

pub fn lineAt(text: []const u8, index: usize) -> usize {
    var line: usize = 0
    var start: usize = 0
    var at: usize = 0
    while at < text.length {
        if text[at] == 10 {
            if line == index {
                const address = @intFromPtr(text.pointer) + start
                var k: usize = 0
                while k < keptCount {
                    if keptText[k] == address { return kept[k] }
                    k += 1
                }
                const copy = m.alloc(at - start + 1)
                m.copy(copy, address, at - start)
                if keptCount < 512 {
                    kept[keptCount] = copy
                    keptText[keptCount] = address
                    keptCount += 1
                }
                return copy
            }
            line += 1
            start = at + 1
        }
        at += 1
    }
    return 0
}

export fn uenum_close(en: usize) -> void {
    if en == 0 { return }
    const list = m.getWord(en + STRINGS)
    var index: usize = 0
    while index < m.getWord(en + COUNT) {
        m.release(m.getWord(list + index * 8))
        index += 1
    }
    m.release(list)
    m.release(m.getWord(en + UNITS))
    m.release(en)
}

export fn uenum_count(en: usize, status: usize) -> i32 {
    if m.failed(status) || en == 0 { return 0 }
    return @intCast(i32, m.getWord(en + COUNT))
}

export fn uenum_next(en: usize, resultLength: usize, status: usize) -> usize {
    if m.failed(status) || en == 0 { return 0 }
    const index = m.getWord(en + INDEX)
    if index >= m.getWord(en + COUNT) {
        if resultLength != 0 { m.putI32(resultLength, 0) }
        return 0
    }
    m.putWord(en + INDEX, index + 1)
    const string = m.getWord(m.getWord(en + STRINGS) + index * 8)
    if resultLength != 0 { m.putI32(resultLength, @intCast(i32, m.cLength(string))) }
    return string
}

export fn uenum_unext(en: usize, resultLength: usize, status: usize) -> usize {
    const string = uenum_next(en, resultLength, status)
    if string == 0 { return 0 }
    const length = m.cLength(string)
    if m.getWord(en + UNITS_CAPACITY) < length + 1 {
        m.release(m.getWord(en + UNITS))
        m.putWord(en + UNITS, m.alloc((length + 1) * 2))
        m.putWord(en + UNITS_CAPACITY, length + 1)
    }
    const units = m.getWord(en + UNITS)
    var index: usize = 0
    while index < length {
        m.put16(units + index * 2, @intCast(u16, m.get8(string + index)))
        index += 1
    }
    m.put16(units + length * 2, 0)
    return units
}

export fn uenum_reset(en: usize, status: usize) -> void {
    if m.failed(status) || en == 0 { return }
    m.putWord(en + INDEX, 0)
}

export fn uenum_openCharStringsEnumeration(strings: usize, count: i32, status: usize) -> usize {
    return ofStrings(strings, if count > 0 { @intCast(usize, count) } else { 0 }, status)
}

export fn uenum_openUCharStringsEnumeration(strings: usize, count: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const n = if count > 0 { @intCast(usize, count) } else { 0 }
    const chars = m.alloc(n * 8 + 8)
    var index: usize = 0
    while index < n {
        const source = m.getWord(strings + index * 8)
        const length = m.units(source, -1)
        const copy = m.alloc(length + 1)
        var k: usize = 0
        while k < length {
            m.put8(copy + k, @intCast(u8, m.get16(source + k * 2) & 255))
            k += 1
        }
        m.putWord(chars + index * 8, copy)
        index += 1
    }
    const en = ofStrings(chars, n, status)
    index = 0
    while index < n {
        m.release(m.getWord(chars + index * 8))
        index += 1
    }
    m.release(chars)
    return en
}
