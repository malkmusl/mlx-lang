// udateintervalformat.h: date interval formats, ICU's DateIntervalFormat
// (dtitvfmt.cpp, dtitvinf.cpp) over CLDR's intervalFormats (the patterns
// of each skeleton by its greatest difference, intervalFormatFallback):
// the skeleton split into date and time, the nearest skeleton of the
// data with its fields widened to the request, the date with a time
// range when only the time differs, the fallback ("{0} – {1}") of two
// whole dates otherwise; the two dates formatted by the parts of the
// pattern, their spans (UFIELD_CATEGORY_DATE_INTERVAL_SPAN, 0 for the
// earlier date's) around the fields.
//
// The skeletons of the data are kept in the order ICU's hash table of
// them has (the order its search for the best one goes by).
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const formatted = @import("./formatted.mlx")
const text = @import("./datetext.mlx")
const symbols = @import("./datesymbols.mlx")
const patterns = @import("./datepatterns.mlx")
const generator = @import("./patterngenerator.mlx")
const sdf = @import("./simpledateformat.mlx")

extern("c") fn ucal_clone(cal: usize, status: usize) -> usize
extern("c") fn ucal_close(cal: usize) -> void
extern("c") fn ucal_setMillis(cal: usize, dateTime: f64, status: usize) -> void
extern("c") fn ucal_get(cal: usize, field: i32, status: usize) -> i32
extern("c") fn ucal_equivalentTo(cal1: usize, cal2: usize) -> u8
extern("c") fn ucal_setTimeZone(cal: usize, zoneID: usize, len: i32, status: usize) -> void

const Text = text.Text

const CATEGORY_DATE: i32 = 1
const CATEGORY_DATE_INTERVAL_SPAN: i32 = 4101

// UCalendarDateFields
const ERA: usize = 0
const YEAR: usize = 1
const MONTH: usize = 2
const DATE: usize = 5
const AM_PM: usize = 9
const HOUR: usize = 10
const MINUTE: usize = 12
const SECOND: usize = 13
const MILLISECOND: usize = 14
const FIELD_COUNT: usize = 24

// The patterns of a skeleton by its largest different field.
const IPI_ERA: usize = 0
const IPI_YEAR: usize = 1
const IPI_MONTH: usize = 2
const IPI_DATE: usize = 3
const IPI_AM_PM: usize = 4
const IPI_HOUR: usize = 5
const IPI_MINUTE: usize = 6
const IPI_SECOND: usize = 7
const IPI_MILLISECOND: usize = 8
const IPI_COUNT: usize = 9

const NONE: usize = 18446744073709551615

fn intervalIndex(field: usize) -> usize {
    if field == ERA { return IPI_ERA }
    if field == YEAR { return IPI_YEAR }
    if field == MONTH { return IPI_MONTH }
    if field == DATE || field == 7 { return IPI_DATE }
    if field == AM_PM { return IPI_AM_PM }
    if field == HOUR || field == 11 { return IPI_HOUR }
    if field == MINUTE { return IPI_MINUTE }
    if field == SECOND { return IPI_SECOND }
    if field == MILLISECOND { return IPI_MILLISECOND }
    return NONE
}

// The pattern letter of a calendar field.
fn fieldLetter(field: usize) -> u16 {
    const letters = "GyMwWdDEFahHmsSz YeugA  "
    if field >= letters.length { return 32 }
    return @intCast(u16, letters[field])
}

// ---------------------------------------------------------------------------
// The data (DateIntervalInfo).

const Skeleton = struct {
    skeleton: Text
    patterns: [9]Text
}

const Info = struct {
    fallback: Text
    laterDateFirst: bool
    // The skeletons, and ICU's hash table of them: their slots.
    skeletons: usize
    count: usize
    capacity: usize
    table: usize
    tableLength: usize
}

fn skeletonAt(info: *Info, index: usize) -> *Skeleton { unsafe { return @ptrFromInt(*Skeleton, info.*.skeletons + index * @sizeOf(Skeleton)) } }

// UnicodeString's hash code (ustr_hashUCharsN).
fn hashOf(t: *const Text) -> i32 {
    var hash: u32 = 0
    const length = t.*.length
    const step = if length >= 32 { (length - 32) / 32 + 1 } else { 1 }
    var k: usize = 0
    while k < length {
        hash = hash *% 37 +% @intCast(u32, text.at(t, k))
        k += step
    }
    var result = @bitCast(i32, hash)
    if result == 0 { result = 1 }
    return result
}

const PRIMES = [12]usize{ 7, 13, 31, 61, 127, 251, 509, 1021, 2039, 4093, 8191, 16381 }

fn tableSlot(info: *Info, index: usize) -> usize { return m.getWord(info.*.table + index * 8) }

// The slot of skeleton S in the table (as _uhash_find takes it), the
// empty slot it would go in when it is not there.
fn findSlot(info: *Info, table: usize, length: usize, s: *const Text, hash: i32) -> usize {
    const code = @intCast(usize, hash & 2147483647)
    const start = (code ^ 67108864) % length
    var index = start
    var jump: usize = 0
    while true {
        const entry = m.getWord(table + index * 8)
        if entry == NONE { return index }
        if text.same(&skeletonAt(info, entry).*.skeleton, s) { return index }
        if jump == 0 { jump = code % (length - 1) + 1 }
        index = (index + jump) % length
        if index == start { return NONE }
    }
    return NONE
}

fn newTable(length: usize) -> usize {
    const table = m.alloc(length * 8)
    var k: usize = 0
    while k < length {
        m.putWord(table + k * 8, NONE)
        k += 1
    }
    return table
}

fn findSkeleton(info: *Info, s: *const Text) -> usize {
    if info.*.table == 0 { return NONE }
    const slot = findSlot(info, info.*.table, info.*.tableLength, s, hashOf(s))
    if slot == NONE { return NONE }
    return tableSlot(info, slot)
}

// A new skeleton put in the table, which grows as ICU's does (when it
// has more than half its length, its entries put again from the last).
fn addSkeleton(info: *Info, s: *const Text) -> usize {
    if info.*.table == 0 {
        info.*.tableLength = PRIMES[4]
        info.*.table = newTable(info.*.tableLength)
    }
    if info.*.count > info.*.tableLength / 2 {
        var prime: usize = 0
        while prime < 11 && PRIMES[prime] <= info.*.tableLength { prime += 1 }
        const length = PRIMES[prime]
        const table = newTable(length)
        var k = info.*.tableLength
        while k > 0 {
            k -= 1
            const entry = tableSlot(info, k)
            if entry != NONE {
                const slot = findSlot(info, table, length, &skeletonAt(info, entry).*.skeleton, hashOf(&skeletonAt(info, entry).*.skeleton))
                m.putWord(table + slot * 8, entry)
            }
        }
        m.release(info.*.table)
        info.*.table = table
        info.*.tableLength = length
    }
    if info.*.count == info.*.capacity {
        const grown = if info.*.capacity < 32 { 32 } else { info.*.capacity * 2 }
        info.*.skeletons = m.grow(info.*.skeletons, grown * @sizeOf(Skeleton))
        info.*.capacity = grown
    }
    const index = info.*.count
    m.zero(info.*.skeletons + index * @sizeOf(Skeleton), @sizeOf(Skeleton))
    skeletonAt(info, index).*.skeleton = text.copy(s)
    info.*.count += 1
    const slot = findSlot(info, info.*.table, info.*.tableLength, s, hashOf(s))
    if slot != NONE { m.putWord(info.*.table + slot * 8, index) }
    return index
}

// The field of a letter of the data's keys (G y M d a B h H m).
fn letterField(key: []const u8) -> usize {
    if key.length != 1 { return FIELD_COUNT }
    const c = key[0]
    if c == 71 { return ERA }
    if c == 121 { return YEAR }
    if c == 77 { return MONTH }
    if c == 100 { return DATE }
    if c == 97 || c == 66 { return AM_PM }
    if c == 104 || c == 72 { return HOUR }
    if c == 109 { return MINUTE }
    return FIELD_COUNT
}

fn loadInfo(info: *Info, data: u32) -> void {
    const prefix = "dates/calendars/gregorian/dateTimeFormats/intervalFormats"
    if !symbols.lookupText(data, "dates/calendars/gregorian/dateTimeFormats/intervalFormats/intervalFormatFallback", &info.*.fallback) {
        text.pushUtf8(&info.*.fallback, "{0} \u{2013} {1}")
    }
    // {1} before {0}: the later date first.
    var zero = text.fromUtf8("{0}")
    var one = text.fromUtf8("{1}")
    const first = text.find(&info.*.fallback, &zero, 0)
    const second = text.find(&info.*.fallback, &one, 0)
    info.*.laterDateFirst = first != text.NOT_FOUND && second != text.NOT_FOUND && first > second
    text.dispose(&zero)
    text.dispose(&one)
    var start: u32 = 0
    var end: u32 = 0
    resources.below(prefix, &start, &end)
    var level = data
    while level != resources.NONE {
        var k = start
        while k < end {
            const value = resources.own(level, k)
            if value != resources.NONE {
                // intervalFormats/SKELETON/LETTER
                const name = resources.keyName(k)
                const skeletonName = resources.childName(k, prefix.length)
                const rest = name[prefix.length + 1 + skeletonName.length..name.length]
                if rest.length > 1 && rest[0] == 47 {
                    const field = letterField(rest[1..rest.length])
                    if field != FIELD_COUNT {
                        var s = text.fromUtf8(skeletonName)
                        var index = findSkeleton(info, &s)
                        if index == NONE { index = addSkeleton(info, &s) }
                        const slot = &skeletonAt(info, index).*.patterns[intervalIndex(field)]
                        if slot.*.length == 0 { text.pushUtf8(slot, resources.string(value)) }
                        text.dispose(&s)
                    }
                }
            }
            k += 1
        }
        level = resources.parent(level)
    }
}

fn disposeInfo(info: *Info) -> void {
    text.dispose(&info.*.fallback)
    var k: usize = 0
    while k < info.*.count {
        var s = skeletonAt(info, k)
        text.dispose(&s.*.skeleton)
        var n: usize = 0
        while n < IPI_COUNT {
            text.dispose(&s.*.patterns[n])
            n += 1
        }
        k += 1
    }
    m.release(info.*.skeletons)
    m.release(info.*.table)
}

fn widths(s: *const Text, into: *[58]i32) -> void {
    var k: usize = 0
    while k < 58 {
        into.*[k] = 0
        k += 1
    }
    k = 0
    while k < s.*.length {
        const c = text.at(s, k)
        if c >= 65 && c < 123 { into.*[@intCast(usize, c - 65)] += 1 }
        k += 1
    }
}

// getBestSkeleton: the nearest skeleton (NONE without any), the kind of
// difference (0 same, 1 lengths, 2 only v/z, h/K, H/k, -1 other fields).
fn bestSkeleton(info: *Info, skeleton: *const Text, difference: *i32) -> usize {
    var input = text.copy(skeleton)
    var replaced = false
    if text.contains(&input, 122) || text.contains(&input, 107) || text.contains(&input, 75) || text.contains(&input, 97) || text.contains(&input, 98) {
        text.replaceAllAscii(&input, "z", "v")
        text.replaceAllAscii(&input, "k", "H")
        text.replaceAllAscii(&input, "K", "h")
        text.replaceAllAscii(&input, "a", "")
        text.replaceAllAscii(&input, "b", "")
        replaced = true
    }
    var inputWidths: [58]i32 = undefined
    widths(&input, &inputWidths)
    text.dispose(&input)
    var bestDistance: i32 = 2147483647
    var best = NONE
    difference.* = 0
    var slot: usize = 0
    while slot < info.*.tableLength {
        const index = tableSlot(info, slot)
        slot += 1
        if index == NONE { continue }
        var candidate: [58]i32 = undefined
        widths(&skeletonAt(info, index).*.skeleton, &candidate)
        var distance: i32 = 0
        var fieldDifference: i32 = 1
        var k: usize = 0
        while k < 58 {
            const a = inputWidths[k]
            const b = candidate[k]
            if a != b {
                if a == 0 || b == 0 {
                    fieldDifference = -1
                    distance += 4096
                } else if k + 65 == 77 && ((a <= 2 && b > 2) || (a > 2 && b <= 2)) {
                    distance += 256
                } else {
                    distance += if a > b { a - b } else { b - a }
                }
            }
            k += 1
        }
        if distance < bestDistance {
            best = index
            bestDistance = distance
            difference.* = fieldDifference
        }
        if distance == 0 {
            difference.* = 0
            break
        }
    }
    if replaced && difference.* != -1 { difference.* = 2 }
    return best
}

// ---------------------------------------------------------------------------
// The format.

const Part = struct {
    first: Text
    second: Text
    laterDateFirst: bool
}

// "DTIV", and the result's kind "DTIR".
const MAGIC: u32 = 1447646276
const RESULT_KIND: u32 = 1380538436

const IntervalFormat = struct {
    magic: u32
    format: usize
    fromCalendar: usize
    toCalendar: usize
    generator: usize
    skeleton: Text
    info: Info
    parts: [9]Part
    datePattern: Text
    hasDatePattern: bool
    timePattern: Text
    hasTimePattern: bool
    dateTimeFormat: Text
    hasDateTimeFormat: bool
    capitalization: i32
    id: symbols.Id
}

fn intervalAt(address: usize) -> *IntervalFormat { unsafe { return @ptrFromInt(*IntervalFormat, address) } }

fn isInterval(address: usize) -> bool { return address != 0 && m.get32(address) == MAGIC }

fn bestPatternOf(f: *IntervalFormat, skeleton: *const Text, out: *Text) -> void {
    _ = generator.bestPattern(generator.of(f.*.generator), skeleton, generator.MATCH_NO_OPTIONS, out)
}

fn setPart(f: *IntervalFormat, field: usize, first: *const Text, hasFirst: bool, second: *const Text, hasSecond: bool, laterDateFirst: bool) -> void {
    const index = intervalIndex(field)
    if index == NONE { return }
    var part = &f.*.parts[index]
    if hasFirst {
        text.dispose(&part.*.first)
        part.*.first = text.copy(first)
    }
    if hasSecond {
        text.dispose(&part.*.second)
        part.*.second = text.copy(second)
    }
    part.*.laterDateFirst = laterDateFirst
}

// The fallback of FIELD: the whole pattern of SKELETON.
fn setFallbackPattern(f: *IntervalFormat, field: usize, skeleton: *const Text) -> void {
    var pattern = text.empty()
    bestPatternOf(f, skeleton, &pattern)
    var none = text.empty()
    setPart(f, field, &none, false, &pattern, true, f.*.info.laterDateFirst)
    text.dispose(&pattern)
}

// Where an interval pattern splits: at the first letter repeated.
fn splitPoint(pattern: *const Text) -> usize {
    var inQuote = false
    var previous: u16 = 0
    var count: usize = 0
    var seen: [58]bool = undefined
    var k: usize = 0
    while k < 58 {
        seen[k] = false
        k += 1
    }
    var foundRepetition = false
    var i: usize = 0
    while i < pattern.*.length {
        const c = text.at(pattern, i)
        if c != previous && count > 0 {
            const slot = @intCast(usize, previous - 65)
            if !seen[slot] {
                seen[slot] = true
            } else {
                foundRepetition = true
                break
            }
            count = 0
        }
        if c == 39 {
            if i + 1 < pattern.*.length && text.at(pattern, i + 1) == 39 {
                i += 1
            } else {
                inQuote = !inQuote
            }
        } else if !inQuote && text.isLetter(c) {
            previous = c
            count += 1
        }
        i += 1
    }
    if count > 0 && !foundRepetition {
        if !seen[@intCast(usize, previous - 65)] { count = 0 }
    }
    return i - count
}

// setIntervalPattern: a pattern of the data (with its latestFirst: or
// earliestFirst: prefix) split into its parts.
fn setIntervalPattern(f: *IntervalFormat, field: usize, pattern: *const Text, laterDateFirst: bool) -> void {
    var order = laterDateFirst
    var real = text.copy(pattern)
    var later = text.fromUtf8("latestFirst:")
    var earlier = text.fromUtf8("earliestFirst:")
    if text.find(&real, &later, 0) == 0 {
        order = true
        text.remove(&real, 0, later.length)
    } else if text.find(&real, &earlier, 0) == 0 {
        order = false
        text.remove(&real, 0, earlier.length)
    }
    text.dispose(&later)
    text.dispose(&earlier)
    const split = splitPoint(&real)
    var first = text.empty()
    var second = text.empty()
    text.pushRange(&first, &real, 0, split)
    if split < real.length { text.pushRange(&second, &real, split, real.length) }
    setPart(f, field, &first, true, &second, true, order)
    text.dispose(&first)
    text.dispose(&second)
    text.dispose(&real)
}

// findReplaceInPattern: OLD replaced by NEW outside quotes.
fn replaceOutsideQuotes(target: *Text, old: []const u8, new: []const u8) -> void {
    var o = text.fromUtf8(old)
    var n = text.fromUtf8(new)
    if !text.contains(target, 39) {
        text.replaceAll(target, &o, &n)
    } else {
        var result = text.empty()
        var source = text.copy(target)
        var quote = text.indexOf(&source, 39)
        while quote != text.NOT_FOUND {
            var close = text.NOT_FOUND
            var k = quote + 1
            while k < source.length {
                if text.at(&source, k) == 39 {
                    close = k
                    break
                }
                k += 1
            }
            if close == text.NOT_FOUND { close = source.length - 1 }
            var unquoted = text.empty()
            text.pushRange(&unquoted, &source, 0, quote)
            text.replaceAll(&unquoted, &o, &n)
            text.pushText(&result, &unquoted)
            text.dispose(&unquoted)
            text.pushRange(&result, &source, quote, close + 1)
            text.remove(&source, 0, close + 1)
            quote = text.indexOf(&source, 39)
        }
        text.replaceAll(&source, &o, &n)
        text.pushText(&result, &source)
        text.dispose(&source)
        text.dispose(target)
        target.* = result
    }
    text.dispose(&o)
    text.dispose(&n)
}

// adjustFieldWidth: the fields of a pattern of the data as wide as the
// request has them.
fn adjustFieldWidth(input: *const Text, best: *const Text, pattern: *const Text, difference: i32, suppressDayPeriod: bool, out: *Text) -> void {
    var adjusted = text.copy(pattern)
    var inputWidths: [58]i32 = undefined
    var bestWidths: [58]i32 = undefined
    widths(input, &inputWidths)
    widths(best, &bestWidths)
    if suppressDayPeriod {
        replaceOutsideQuotes(&adjusted, "\u{a0}a", "")
        replaceOutsideQuotes(&adjusted, "\u{202f}a", "")
        replaceOutsideQuotes(&adjusted, "a\u{a0}", "")
        replaceOutsideQuotes(&adjusted, "a\u{202f}", "")
        replaceOutsideQuotes(&adjusted, "a", "")
        replaceOutsideQuotes(&adjusted, "  ", " ")
        // trim
        while adjusted.length > 0 && text.at(&adjusted, 0) <= 32 { text.remove(&adjusted, 0, 1) }
        while adjusted.length > 0 && text.at(&adjusted, adjusted.length - 1) <= 32 { text.remove(&adjusted, adjusted.length - 1, 1) }
    }
    if difference == 2 {
        if text.contains(input, 122) { replaceOutsideQuotes(&adjusted, "v", "z") }
        if text.contains(input, 75) { replaceOutsideQuotes(&adjusted, "h", "K") }
        if text.contains(input, 107) { replaceOutsideQuotes(&adjusted, "H", "k") }
        if text.contains(input, 98) { replaceOutsideQuotes(&adjusted, "a", "b") }
    }
    if text.contains(&adjusted, 97) && bestWidths[97 - 65] == 0 { bestWidths[97 - 65] = 1 }
    if text.contains(&adjusted, 98) && bestWidths[98 - 65] == 0 { bestWidths[98 - 65] = 1 }
    var inQuote = false
    var previous: u16 = 0
    var count: usize = 0
    var i: usize = 0
    while i < adjusted.length {
        const c = text.at(&adjusted, i)
        if c != previous && count > 0 {
            var skeletonChar = previous
            if skeletonChar == 76 { skeletonChar = 77 }
            const fieldCount = bestWidths[@intCast(usize, skeletonChar - 65)]
            const inputCount = inputWidths[@intCast(usize, skeletonChar - 65)]
            if fieldCount == @intCast(i32, count) && inputCount > fieldCount {
                const extra = @intCast(usize, inputCount - fieldCount)
                var n: usize = 0
                while n < extra {
                    text.insertUnit(&adjusted, i, previous)
                    n += 1
                }
                i += extra
            }
            count = 0
        }
        if c == 39 {
            if i + 1 < adjusted.length && text.at(&adjusted, i + 1) == 39 {
                i += 1
            } else {
                inQuote = !inQuote
            }
        } else if !inQuote && text.isLetter(c) {
            previous = c
            count += 1
        }
        i += 1
    }
    if count > 0 {
        var skeletonChar = previous
        if skeletonChar == 76 { skeletonChar = 77 }
        const fieldCount = bestWidths[@intCast(usize, skeletonChar - 65)]
        const inputCount = inputWidths[@intCast(usize, skeletonChar - 65)]
        if fieldCount == @intCast(i32, count) && inputCount > fieldCount {
            var n: usize = 0
            while n < @intCast(usize, inputCount - fieldCount) {
                text.push(&adjusted, previous)
                n += 1
            }
        }
    }
    text.pushText(out, &adjusted)
    text.dispose(&adjusted)
}

fn intervalPatternOf(info: *Info, skeleton: usize, field: usize, into: *Text) -> void {
    if skeleton == NONE { return }
    const index = intervalIndex(field)
    if index == NONE { return }
    text.pushText(into, &skeletonAt(info, skeleton).*.patterns[index])
}

fn skeletonText(info: *Info, index: usize) -> *Text { return &skeletonAt(info, index).*.skeleton }

fn patternOfName(info: *Info, skeleton: *const Text, field: usize, into: *Text) -> void {
    intervalPatternOf(info, findSkeleton(info, skeleton), field, into)
}

// The skeletons setIntervalPattern works on, as ICU's pointers to them:
// the request, its best skeleton, their extended forms, and a best one
// found for an extended skeleton.
const SLOT_SKELETON: usize = 0
const SLOT_BEST: usize = 1
const SLOT_EXTENDED: usize = 2
const SLOT_EXTENDED_BEST: usize = 3
const SLOT_FOUND: usize = 4

const Slots = struct {
    texts: [5]Text
}

// setIntervalPattern of FIELD from the data (SKELETON and BEST are
// slots); whether its pattern came by an extended skeleton.
fn setFromData(f: *IntervalFormat, field: usize, slots: *Slots, skeleton: usize, bestIn: usize, differenceIn: i32, useExtended: bool) -> bool {
    var best = bestIn
    var difference = differenceIn
    var pattern = text.empty()
    patternOfName(&f.*.info, &slots.*.texts[best], field, &pattern)
    if pattern.length == 0 {
        if patterns.isFieldUnitIgnored(&slots.*.texts[best], field) {
            text.dispose(&pattern)
            return false
        }
        if field == AM_PM {
            patternOfName(&f.*.info, &slots.*.texts[best], HOUR, &pattern)
            if pattern.length > 0 {
                const suppress = text.contains(&f.*.skeleton, 74)
                var adjusted = text.empty()
                adjustFieldWidth(&slots.*.texts[skeleton], &slots.*.texts[best], &pattern, difference, suppress, &adjusted)
                setIntervalPattern(f, field, &adjusted, f.*.info.laterDateFirst)
                text.dispose(&adjusted)
            }
            text.dispose(&pattern)
            return false
        }
        // The pattern of the skeleton with the field's letter added.
        if useExtended {
            const letter = fieldLetter(field)
            var request = text.copy(&slots.*.texts[skeleton])
            var bestCopy = text.copy(&slots.*.texts[best])
            text.dispose(&slots.*.texts[SLOT_EXTENDED])
            slots.*.texts[SLOT_EXTENDED] = request
            text.dispose(&slots.*.texts[SLOT_EXTENDED_BEST])
            slots.*.texts[SLOT_EXTENDED_BEST] = bestCopy
            text.insertUnit(&slots.*.texts[SLOT_EXTENDED], 0, letter)
            text.insertUnit(&slots.*.texts[SLOT_EXTENDED_BEST], 0, letter)
            patternOfName(&f.*.info, &slots.*.texts[SLOT_EXTENDED_BEST], field, &pattern)
            if pattern.length == 0 && difference == 0 {
                const nearer = bestSkeleton(&f.*.info, &slots.*.texts[SLOT_EXTENDED_BEST], &difference)
                if nearer != NONE && difference != -1 {
                    intervalPatternOf(&f.*.info, nearer, field, &pattern)
                    text.dispose(&slots.*.texts[SLOT_FOUND])
                    slots.*.texts[SLOT_FOUND] = text.copy(skeletonText(&f.*.info, nearer))
                    best = SLOT_FOUND
                }
            }
        }
    }
    var fromExtended = false
    if pattern.length > 0 {
        const suppress = text.contains(&f.*.skeleton, 74)
        if difference != 0 || suppress {
            var adjusted = text.empty()
            adjustFieldWidth(&slots.*.texts[skeleton], &slots.*.texts[best], &pattern, difference, suppress, &adjusted)
            setIntervalPattern(f, field, &adjusted, f.*.info.laterDateFirst)
            text.dispose(&adjusted)
        } else {
            setIntervalPattern(f, field, &pattern, f.*.info.laterDateFirst)
        }
        if useExtended && slots.*.texts[SLOT_EXTENDED].length > 0 { fromExtended = true }
    }
    text.dispose(&pattern)
    return fromExtended
}

// setSeparateDateTimePtn: the patterns from the data; false when no
// skeleton of the data fits.
fn setSeparate(f: *IntervalFormat, dateSkeleton: *const Text, timeSkeleton: *const Text) -> bool {
    const request = if timeSkeleton.*.length != 0 { timeSkeleton } else { dateSkeleton }
    var difference: i32 = 0
    const best = bestSkeleton(&f.*.info, request, &difference)
    if best == NONE { return false }
    if dateSkeleton.*.length != 0 {
        text.clear(&f.*.datePattern)
        bestPatternOf(f, dateSkeleton, &f.*.datePattern)
        f.*.hasDatePattern = true
    }
    if timeSkeleton.*.length != 0 {
        text.clear(&f.*.timePattern)
        bestPatternOf(f, timeSkeleton, &f.*.timePattern)
        f.*.hasTimePattern = true
    }
    if difference == -1 { return false }
    var slots: Slots = undefined
    var k: usize = 0
    while k < 5 {
        slots.texts[k] = text.empty()
        k += 1
    }
    text.pushText(&slots.texts[SLOT_SKELETON], request)
    text.pushText(&slots.texts[SLOT_BEST], skeletonText(&f.*.info, best))
    if timeSkeleton.*.length == 0 {
        var skeleton = SLOT_SKELETON
        var bestSlot = SLOT_BEST
        _ = setFromData(f, DATE, &slots, skeleton, bestSlot, difference, true)
        if setFromData(f, MONTH, &slots, skeleton, bestSlot, difference, true) {
            skeleton = SLOT_EXTENDED
            bestSlot = SLOT_EXTENDED_BEST
        }
        _ = setFromData(f, YEAR, &slots, skeleton, bestSlot, difference, true)
        _ = setFromData(f, ERA, &slots, skeleton, bestSlot, difference, true)
    } else {
        _ = setFromData(f, MINUTE, &slots, SLOT_SKELETON, SLOT_BEST, difference, false)
        _ = setFromData(f, HOUR, &slots, SLOT_SKELETON, SLOT_BEST, difference, false)
        _ = setFromData(f, AM_PM, &slots, SLOT_SKELETON, SLOT_BEST, difference, false)
    }
    k = 0
    while k < 5 {
        text.dispose(&slots.texts[k])
        k += 1
    }
    return true
}

// normalizeHourMetacharacters: j, J, C and the hour letters as the
// locale has its hour (and its day period).
fn normalizeHours(f: *IntervalFormat, skeleton: *const Text, out: *Text) -> void {
    text.pushText(out, skeleton)
    var hourChar: u16 = 0
    var periodChar: u16 = 0
    var hourStart: usize = 0
    var hourLength: usize = 0
    var periodStart: usize = 0
    var periodLength: usize = 0
    var i: usize = 0
    while i < out.*.length {
        const c = text.at(out, i)
        if c == 106 || c == 74 || c == 67 || c == 104 || c == 72 || c == 107 || c == 75 {
            if hourChar == 0 {
                hourChar = c
                hourStart = i
            }
            hourLength += 1
        } else if c == 97 || c == 98 || c == 66 {
            if periodChar == 0 {
                periodChar = c
                periodStart = i
            }
            periodLength += 1
        } else if hourChar != 0 && periodChar != 0 {
            break
        }
        i += 1
    }
    if hourChar == 0 { return }
    var hour: u16 = 72
    var request = text.empty()
    text.push(&request, hourChar)
    var converted = text.empty()
    bestPatternOf(f, &request, &converted)
    text.dispose(&request)
    // Literal text out (the 'h' of German 'Uhr').
    var quote = text.indexOf(&converted, 39)
    while quote != text.NOT_FOUND {
        var close = quote
        var k = quote + 1
        while k < converted.length {
            if text.at(&converted, k) == 39 {
                close = k
                break
            }
            k += 1
        }
        text.remove(&converted, quote, close - quote + 1)
        quote = text.indexOf(&converted, 39)
    }
    if text.contains(&converted, 104) {
        hour = 104
    } else if text.contains(&converted, 75) {
        hour = 75
    } else if text.contains(&converted, 107) {
        hour = 107
    }
    if text.contains(&converted, 98) {
        periodChar = 98
    } else if text.contains(&converted, 66) {
        periodChar = 66
    } else if periodChar == 0 {
        periodChar = 97
    }
    text.dispose(&converted)
    var replacement = text.empty()
    text.push(&replacement, hour)
    if hour != 72 && hour != 107 {
        var length: usize = 1
        if periodLength >= 5 || hourLength >= 5 {
            length = 5
        } else if periodLength >= 3 || hourLength >= 3 {
            length = 3
        }
        var n: usize = 0
        while n < length {
            text.push(&replacement, periodChar)
            n += 1
        }
    }
    text.remove(out, hourStart, hourLength)
    text.insert(out, hourStart, &replacement)
    if periodStart > hourStart {
        periodStart = periodStart + replacement.length - hourLength
    }
    if periodLength > 0 { text.remove(out, periodStart, periodLength) }
    text.dispose(&replacement)
}

// getDateTimeSkeleton: the date and time parts of a skeleton, and their
// normalized forms.
fn splitSkeleton(skeleton: *const Text, date: *Text, normalizedDate: *Text, time: *Text, normalizedTime: *Text) -> void {
    var eCount: usize = 0
    var dCount: usize = 0
    var mCount: usize = 0
    var yCount: usize = 0
    var minuteCount: usize = 0
    var vCount: usize = 0
    var zCount: usize = 0
    var hourChar: u16 = 0
    var i: usize = 0
    while i < skeleton.*.length {
        const c = text.at(skeleton, i)
        if c == 69 {
            text.push(date, c)
            eCount += 1
        } else if c == 100 {
            text.push(date, c)
            dCount += 1
        } else if c == 77 {
            text.push(date, c)
            mCount += 1
        } else if c == 121 {
            text.push(date, c)
            yCount += 1
        } else if c == 71 || c == 89 || c == 117 || c == 81 || c == 113 || c == 76 || c == 108 || c == 87 || c == 119 || c == 68 || c == 70 || c == 103 || c == 101 || c == 99 || c == 85 || c == 114 {
            text.push(normalizedDate, c)
            text.push(date, c)
        } else if c == 104 || c == 72 || c == 107 || c == 75 {
            text.push(time, c)
            if hourChar == 0 { hourChar = c }
        } else if c == 109 {
            text.push(time, c)
            minuteCount += 1
        } else if c == 122 {
            zCount += 1
            text.push(time, c)
        } else if c == 118 {
            vCount += 1
            text.push(time, c)
        } else if c == 97 || c == 86 || c == 90 || c == 106 || c == 115 || c == 83 || c == 65 || c == 98 || c == 66 {
            text.push(time, c)
            text.push(normalizedTime, c)
        }
        i += 1
    }
    var n: usize = 0
    while n < yCount {
        text.push(normalizedDate, 121)
        n += 1
    }
    if mCount != 0 {
        if mCount < 3 {
            text.push(normalizedDate, 77)
        } else {
            n = 0
            while n < mCount && n < 5 {
                text.push(normalizedDate, 77)
                n += 1
            }
        }
    }
    if eCount != 0 {
        if eCount <= 3 {
            text.push(normalizedDate, 69)
        } else {
            n = 0
            while n < eCount && n < 5 {
                text.push(normalizedDate, 69)
                n += 1
            }
        }
    }
    if dCount != 0 { text.push(normalizedDate, 100) }
    if hourChar != 0 { text.push(normalizedTime, hourChar) }
    if minuteCount != 0 { text.push(normalizedTime, 109) }
    if zCount != 0 { text.push(normalizedTime, 122) }
    if vCount != 0 { text.push(normalizedTime, 118) }
}

// concatSingleDate2TimeInterval: the date with the time range of FIELD.
fn concatDate(f: *IntervalFormat, datePattern: *const Text, field: usize) -> void {
    const index = intervalIndex(field)
    var part = &f.*.parts[index]
    if part.*.first.length == 0 { return }
    var range = text.copy(&part.*.first)
    text.pushText(&range, &part.*.second)
    var combined = text.empty()
    text.format2(&f.*.dateTimeFormat, &range, datePattern, &combined)
    setIntervalPattern(f, field, &combined, part.*.laterDateFirst)
    text.dispose(&range)
    text.dispose(&combined)
}

const SHORT_DATE_SKELETON: []const u8 = "yMd"

fn initializePattern(f: *IntervalFormat) -> void {
    var k: usize = 0
    while k < IPI_COUNT {
        f.*.parts[k].laterDateFirst = f.*.info.laterDateFirst
        k += 1
    }
    var date = text.empty()
    var time = text.empty()
    var normalizedDate = text.empty()
    var normalizedTime = text.empty()
    var converted = text.empty()
    normalizeHours(f, &f.*.skeleton, &converted)
    splitSkeleton(&converted, &date, &normalizedDate, &time, &normalizedTime)
    text.dispose(&converted)
    if time.length > 0 && date.length > 0 {
        // The glue of date and time (DateTimePatterns' default one).
        const data = symbols.dataLocale(&f.*.id)
        var glue = text.empty()
        if symbols.lookupText(data, "dates/calendars/gregorian/dateTimeFormats/medium", &glue) && glue.length >= 3 {
            f.*.dateTimeFormat = glue
            f.*.hasDateTimeFormat = true
        } else {
            text.dispose(&glue)
        }
    }
    const found = setSeparate(f, &normalizedDate, &normalizedTime)
    if !found || date.length == 0 {
        if time.length != 0 && date.length == 0 {
            // The time with a short date when the dates differ.
            var withDate = text.fromUtf8(SHORT_DATE_SKELETON)
            text.pushText(&withDate, &time)
            var pattern = text.empty()
            bestPatternOf(f, &withDate, &pattern)
            var none = text.empty()
            setPart(f, DATE, &none, false, &pattern, true, f.*.info.laterDateFirst)
            setPart(f, MONTH, &none, false, &pattern, true, f.*.info.laterDateFirst)
            setPart(f, YEAR, &none, false, &pattern, true, f.*.info.laterDateFirst)
            text.insertUnit(&withDate, 0, 71)
            text.clear(&pattern)
            bestPatternOf(f, &withDate, &pattern)
            setPart(f, ERA, &none, false, &pattern, true, f.*.info.laterDateFirst)
            text.dispose(&pattern)
            text.dispose(&withDate)
        }
    } else if time.length != 0 {
        // Date and time: whole dates when a date field differs, the date
        // with a time range otherwise.
        var skeleton = text.copy(&f.*.skeleton)
        if !text.contains(&date, 100) {
            text.insertUnit(&skeleton, 0, 100)
            setFallbackPattern(f, DATE, &skeleton)
        }
        if !text.contains(&date, 77) {
            text.insertUnit(&skeleton, 0, 77)
            setFallbackPattern(f, MONTH, &skeleton)
        }
        if !text.contains(&date, 121) {
            text.insertUnit(&skeleton, 0, 121)
            setFallbackPattern(f, YEAR, &skeleton)
        }
        if !text.contains(&date, 71) {
            text.insertUnit(&skeleton, 0, 71)
            setFallbackPattern(f, ERA, &skeleton)
        }
        text.dispose(&skeleton)
        if f.*.hasDateTimeFormat {
            var datePattern = text.empty()
            bestPatternOf(f, &date, &datePattern)
            concatDate(f, &datePattern, AM_PM)
            concatDate(f, &datePattern, HOUR)
            concatDate(f, &datePattern, MINUTE)
            text.dispose(&datePattern)
        }
    }
    text.dispose(&date)
    text.dispose(&time)
    text.dispose(&normalizedDate)
    text.dispose(&normalizedTime)
}

fn create(id: *const symbols.Id, skeleton: *const Text, zone: usize, zoneLength: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !resources.available() {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const address = m.alloc(@sizeOf(IntervalFormat))
    if address == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    var f = intervalAt(address)
    f.*.magic = MAGIC
    f.*.id = id.*
    f.*.capitalization = 256
    f.*.skeleton = text.copy(skeleton)
    f.*.generator = generator.create(id, false)
    var pattern = text.empty()
    bestPatternOf(f, skeleton, &pattern)
    f.*.format = sdf.create(id, &pattern, zone, zoneLength, status)
    text.dispose(&pattern)
    if f.*.format == 0 {
        destroy(address)
        return 0
    }
    loadInfo(&f.*.info, symbols.dataLocale(id))
    initializePattern(f)
    const cal = sdf.of(f.*.format).*.calendar
    f.*.fromCalendar = ucal_clone(cal, status)
    f.*.toCalendar = ucal_clone(cal, status)
    generator.destroy(f.*.generator)
    f.*.generator = 0
    return address
}

fn destroy(address: usize) -> void {
    if !isInterval(address) { return }
    var f = intervalAt(address)
    sdf.destroy(f.*.format)
    if f.*.fromCalendar != 0 { ucal_close(f.*.fromCalendar) }
    if f.*.toCalendar != 0 { ucal_close(f.*.toCalendar) }
    if f.*.generator != 0 { generator.destroy(f.*.generator) }
    text.dispose(&f.*.skeleton)
    disposeInfo(&f.*.info)
    var k: usize = 0
    while k < IPI_COUNT {
        text.dispose(&f.*.parts[k].first)
        text.dispose(&f.*.parts[k].second)
        k += 1
    }
    text.dispose(&f.*.datePattern)
    text.dispose(&f.*.timePattern)
    text.dispose(&f.*.dateTimeFormat)
    f.*.magic = 0
    m.release(address)
}

// ---------------------------------------------------------------------------
// Formatting.

const Output = struct {
    out: Text
    spans: patterns.Spans
    // The index of the date formatted first (0 the earlier), -1 for a
    // single date.
    firstIndex: i32
}

fn formatWith(f: *IntervalFormat, pattern: *const Text, cal: usize, capitalization: i32, o: *Output) -> i32 {
    var format = sdf.of(f.*.format)
    var saved = text.copy(&format.*.pattern)
    sdf.applyPattern(format, pattern)
    sdf.setCapitalization(format, capitalization)
    const code = sdf.formatCalendar(format, cal, &o.*.out, &o.*.spans)
    sdf.applyPattern(format, &saved)
    text.dispose(&saved)
    return code
}

fn formatSingle(f: *IntervalFormat, cal: usize, capitalization: i32, o: *Output) -> i32 {
    var format = sdf.of(f.*.format)
    sdf.setCapitalization(format, capitalization)
    return sdf.formatCalendar(format, cal, &o.*.out, &o.*.spans)
}

fn fallbackRange(f: *IntervalFormat, pattern: *const Text, from: usize, to: usize, o: *Output) -> i32 {
    var body = text.empty()
    var first: i64 = 0
    var second: i64 = 0
    text.textWithoutArguments(&f.*.info.fallback, &body, &first, &second)
    var code: i32 = 0
    if first < 0 || second < 0 {
        text.dispose(&body)
        return 1
    }
    const a = @intCast(usize, first)
    const b = @intCast(usize, second)
    if a < b {
        o.*.firstIndex = 0
        text.pushRange(&o.*.out, &body, 0, a)
        code = formatWith(f, pattern, from, f.*.capitalization, o)
        text.pushRange(&o.*.out, &body, a, b)
        if code <= 0 { code = formatWith(f, pattern, to, 256, o) }
        text.pushRange(&o.*.out, &body, b, body.length)
    } else {
        o.*.firstIndex = 1
        text.pushRange(&o.*.out, &body, 0, b)
        code = formatWith(f, pattern, to, f.*.capitalization, o)
        text.pushRange(&o.*.out, &body, b, a)
        if code <= 0 { code = formatWith(f, pattern, from, 256, o) }
        text.pushRange(&o.*.out, &body, a, body.length)
    }
    text.dispose(&body)
    return code
}

fn fallbackFormat(f: *IntervalFormat, pattern: *const Text, from: usize, to: usize, sameDay: bool, o: *Output) -> i32 {
    if sameDay && f.*.hasDatePattern && f.*.hasTimePattern {
        var body = text.empty()
        var first: i64 = 0
        var second: i64 = 0
        text.textWithoutArguments(&f.*.dateTimeFormat, &body, &first, &second)
        if first < 0 || second < 0 {
            text.dispose(&body)
            return 1
        }
        const a = @intCast(usize, first)
        const b = @intCast(usize, second)
        var code: i32 = 0
        // {0} the time range, {1} the date.
        if a < b {
            text.pushRange(&o.*.out, &body, 0, a)
            code = fallbackRange(f, &f.*.timePattern, from, to, o)
            text.pushRange(&o.*.out, &body, a, b)
            if code <= 0 { code = formatWith(f, &f.*.datePattern, from, 256, o) }
            text.pushRange(&o.*.out, &body, b, body.length)
        } else {
            text.pushRange(&o.*.out, &body, 0, b)
            code = formatWith(f, &f.*.datePattern, from, f.*.capitalization, o)
            text.pushRange(&o.*.out, &body, b, a)
            if code <= 0 { code = fallbackRange(f, &f.*.timePattern, from, to, o) }
            text.pushRange(&o.*.out, &body, a, body.length)
        }
        text.dispose(&body)
        return code
    }
    return fallbackRange(f, pattern, from, to, o)
}

fn calendarField(cal: usize, field: usize) -> i32 {
    var local: i32 = 0
    return ucal_get(cal, @intCast(i32, field), @intFromPtr(&local))
}

// DateIntervalFormat::formatImpl.
fn formatImpl(f: *IntervalFormat, from: usize, to: usize, o: *Output) -> i32 {
    o.*.firstIndex = -1
    if ucal_equivalentTo(from, to) == 0 { return m.ILLEGAL_ARGUMENT_ERROR }
    const order = [9]usize{ ERA, YEAR, MONTH, DATE, AM_PM, HOUR, MINUTE, SECOND, MILLISECOND }
    var field = FIELD_COUNT
    var k: usize = 0
    while k < 9 {
        if calendarField(from, order[k]) != calendarField(to, order[k]) {
            field = order[k]
            break
        }
        k += 1
    }
    const format = sdf.of(f.*.format)
    if field == FIELD_COUNT { return formatSingle(f, from, f.*.capitalization, o) }
    const sameDay = field == AM_PM || field == HOUR || field == MINUTE || field == SECOND || field == MILLISECOND
    const part = &f.*.parts[intervalIndex(field)]
    if part.*.first.length == 0 && part.*.second.length == 0 {
        if patterns.isFieldUnitIgnored(&format.*.pattern, field) { return formatSingle(f, from, f.*.capitalization, o) }
        var whole = text.copy(&format.*.pattern)
        const code = fallbackFormat(f, &whole, from, to, sameDay, o)
        text.dispose(&whole)
        return code
    }
    if part.*.first.length == 0 {
        // The second part is the whole pattern of the fallback.
        var whole = text.copy(&part.*.second)
        const code = fallbackFormat(f, &whole, from, to, sameDay, o)
        text.dispose(&whole)
        return code
    }
    var firstCalendar = from
    var secondCalendar = to
    o.*.firstIndex = 0
    if part.*.laterDateFirst {
        firstCalendar = to
        secondCalendar = from
        o.*.firstIndex = 1
    }
    var code = formatWith(f, &part.*.first, firstCalendar, f.*.capitalization, o)
    if code <= 0 && part.*.second.length > 0 { code = formatWith(f, &part.*.second, secondCalendar, 256, o) }
    return code
}

// The spans of a range into a result (formatToValue): the fields, then
// the spans of the two dates, sorted as ICU sorts them.
fn fillResult(value: usize, o: *Output) -> void {
    formatted.clear(value)
    formatted.appendUnits(value, o.*.out.address, o.*.out.length)
    var k: usize = 0
    while k < o.*.spans.count {
        const start = patterns.spanStart(&o.*.spans, k)
        const limit = patterns.spanLimit(&o.*.spans, k)
        if start < limit { formatted.addSpan(value, CATEGORY_DATE, patterns.spanField(&o.*.spans, k), @intCast(usize, start), @intCast(usize, limit)) }
        k += 1
    }
    if o.*.firstIndex < 0 { return }
    // addOverlapSpans: the extent of the first and the second of each
    // field that is there twice.
    var s1a: i32 = 2147483647
    var s1b: i32 = 0
    var s2a: i32 = 2147483647
    var s2b: i32 = 0
    const count = formatted.spanCount(value)
    var i: usize = 0
    while i < count {
        const field1 = m.getI32(formatted.spanAddress(value, i) + 4)
        var j = i + 1
        while j < count {
            if m.getI32(formatted.spanAddress(value, j) + 4) == field1 {
                const a = formatted.spanAddress(value, i)
                const b = formatted.spanAddress(value, j)
                if m.getI32(a + 8) < s1a { s1a = m.getI32(a + 8) }
                if m.getI32(a + 12) > s1b { s1b = m.getI32(a + 12) }
                if m.getI32(b + 8) < s2a { s2a = m.getI32(b + 8) }
                if m.getI32(b + 12) > s2b { s2b = m.getI32(b + 12) }
                break
            }
            j += 1
        }
        i += 1
    }
    if s1a != 2147483647 {
        formatted.addSpan(value, CATEGORY_DATE_INTERVAL_SPAN, o.*.firstIndex, @intCast(usize, s1a), @intCast(usize, s1b))
        formatted.addSpan(value, CATEGORY_DATE_INTERVAL_SPAN, 1 - o.*.firstIndex, @intCast(usize, s2a), @intCast(usize, s2b))
    }
    // Bubble sort: by start, the longer first, the lower category first,
    // the lower field first.
    const total = formatted.spanCount(value)
    var sorted = false
    while !sorted {
        sorted = true
        var n: usize = 0
        while n + 1 < total {
            const a = formatted.spanAddress(value, n)
            const b = formatted.spanAddress(value, n + 1)
            var comparison: i64 = 0
            if m.getI32(a + 8) != m.getI32(b + 8) {
                comparison = @intCast(i64, m.getI32(b + 8)) - @intCast(i64, m.getI32(a + 8))
            } else if m.getI32(a + 12) != m.getI32(b + 12) {
                comparison = @intCast(i64, m.getI32(a + 12)) - @intCast(i64, m.getI32(b + 12))
            } else if m.getI32(a) != m.getI32(b) {
                comparison = @intCast(i64, m.getI32(a)) - @intCast(i64, m.getI32(b))
            } else if m.getI32(a + 4) != m.getI32(b + 4) {
                comparison = @intCast(i64, m.getI32(b + 4)) - @intCast(i64, m.getI32(a + 4))
            }
            if comparison < 0 {
                sorted = false
                var saved: [16]u8 = undefined
                m.copy(@intFromPtr(&saved), a, 16)
                m.copy(a, b, 16)
                m.copy(b, @intFromPtr(&saved), 16)
            }
            n += 1
        }
    }
}

fn disposeOutput(o: *Output) -> void {
    text.dispose(&o.*.out)
    patterns.disposeSpans(&o.*.spans)
}

fn output() -> Output { return Output.{ .out = text.empty(), .spans = patterns.spans(), .firstIndex = -1 } }

// ---------------------------------------------------------------------------
// The C API.

export fn udtitvfmt_open(localeId: usize, skeleton: usize, skeletonLength: i32, tzID: usize, tzIDLength: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const id = symbols.idOf(localeId)
    var request = text.fromUnits(skeleton, skeletonLength)
    const address = create(&id, &request, tzID, if tzID != 0 && tzIDLength == 0 { 0 } else { tzIDLength }, status)
    text.dispose(&request)
    return address
}

export fn udtitvfmt_close(formatter: usize) -> void { destroy(formatter) }

export fn udtitvfmt_openResult(ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    const value = formatted.create(RESULT_KIND, 0)
    if value == 0 { m.setError(ec, m.MEMORY_ALLOCATION_ERROR) }
    return value
}

export fn udtitvfmt_resultAsValue(uresult: usize, ec: usize) -> usize {
    if m.failed(ec) { return 0 }
    if !formatted.isKind(uresult, RESULT_KIND) {
        m.setError(ec, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return uresult
}

export fn udtitvfmt_closeResult(uresult: usize) -> void {
    if formatted.isKind(uresult, RESULT_KIND) { formatted.destroy(uresult) }
}

fn checkedFormatter(formatter: usize, status: usize) -> bool {
    if m.failed(status) { return false }
    if !isInterval(formatter) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return false
    }
    return true
}

fn formatDates(f: *IntervalFormat, fromDate: f64, toDate: f64, o: *Output) -> i32 {
    var local: i32 = 0
    ucal_setMillis(f.*.fromCalendar, fromDate, @intFromPtr(&local))
    ucal_setMillis(f.*.toCalendar, toDate, @intFromPtr(&local))
    if local > 0 { return local }
    return formatImpl(f, f.*.fromCalendar, f.*.toCalendar, o)
}

export fn udtitvfmt_format(formatter: usize, fromDate: f64, toDate: f64, result: usize, resultCapacity: i32, position: usize, status: usize) -> i32 {
    if !checkedFormatter(formatter, status) { return -1 }
    if (result == 0 && resultCapacity != 0) || (result != 0 && resultCapacity < 0) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return -1
    }
    var o = output()
    const code = formatDates(intervalAt(formatter), fromDate, toDate, &o)
    if code > 0 {
        m.setError(status, code)
        disposeOutput(&o)
        return -1
    }
    if position != 0 {
        // The first span of the field.
        const field = m.getI32(position)
        var begin: i32 = 0
        var end: i32 = 0
        var k: usize = 0
        while k < o.spans.count {
            if patterns.spanField(&o.spans, k) == field {
                begin = patterns.spanStart(&o.spans, k)
                end = patterns.spanLimit(&o.spans, k)
                break
            }
            k += 1
        }
        m.putI32(position + 4, begin)
        m.putI32(position + 8, end)
    }
    const written = text.give(&o.out, result, resultCapacity, status)
    disposeOutput(&o)
    return written
}

export fn udtitvfmt_formatToResult(formatter: usize, fromDate: f64, toDate: f64, result: usize, status: usize) -> void {
    if !checkedFormatter(formatter, status) { return }
    if !formatted.isKind(result, RESULT_KIND) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    var o = output()
    const code = formatDates(intervalAt(formatter), fromDate, toDate, &o)
    if code > 0 {
        m.setError(status, code)
    } else {
        fillResult(result, &o)
    }
    disposeOutput(&o)
}

export fn udtitvfmt_formatCalendarToResult(formatter: usize, fromCalendar: usize, toCalendar: usize, result: usize, status: usize) -> void {
    if !checkedFormatter(formatter, status) { return }
    if !formatted.isKind(result, RESULT_KIND) || fromCalendar == 0 || toCalendar == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    var o = output()
    const code = formatImpl(intervalAt(formatter), fromCalendar, toCalendar, &o)
    if code > 0 {
        m.setError(status, code)
    } else {
        fillResult(result, &o)
    }
    disposeOutput(&o)
}

export fn udtitvfmt_setContext(formatter: usize, value: i32, status: usize) -> void {
    if !checkedFormatter(formatter, status) { return }
    if (value >> 8) != 1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    intervalAt(formatter).*.capitalization = value
}

export fn udtitvfmt_getContext(formatter: usize, kind: i32, status: usize) -> i32 {
    if !checkedFormatter(formatter, status) { return 0 }
    if kind != 1 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return intervalAt(formatter).*.capitalization
}
