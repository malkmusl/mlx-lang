// Numbering systems (unumsys.h), from CLDR's supplemental
// numberingSystems: a system's ten digits (numeric systems), or its rules
// (algorithmic ones, whose description is ICU's: the rule set's name
// after a '%'); and a locale's system as ICU's NumberingSystem finds it:
// the `numbers` (`nu`) keyword, a name or one of default, native,
// traditional and finance, those looked up in the locale's data
// (numbers/defaultNumberingSystem, numbers/otherNumberingSystems/...)
// with TR35's fallbacks (traditional to native, native and finance to
// default), latn when nothing is found.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const enumeration = @import("./enumeration.mlx")
const locale = @import("./locale.mlx")
const nd = @import("./numberdata.mlx")

pub const NAME_CAPACITY: usize = 16

// The digits of numeric system NAME (UTF-8, ten code points), "" when
// NAME is not a numeric system.
pub fn digitsOf(name: []const u8) -> []const u8 {
    var k = nd.key("numberingSystems/")
    nd.add(&k, name)
    nd.add(&k, "/_digits")
    return nd.supplemental(&k)
}

// Whether NAME is a numbering system of the data.
pub fn exists(name: []const u8) -> bool {
    if name.length == 0 { return false }
    var k = nd.key("numberingSystems/")
    nd.add(&k, name)
    nd.add(&k, "/_type")
    return nd.supplemental(&k).length > 0
}

pub fn isAlgorithmic(name: []const u8) -> bool {
    var k = nd.key("numberingSystems/")
    nd.add(&k, name)
    nd.add(&k, "/_type")
    return m.same(nd.supplemental(&k), "algorithmic")
}

// The rules of algorithmic system NAME as ICU describes them:
// "roman-upper" is "%roman-upper", "ja/SpelloutRules/spellout-cardinal"
// is "ja/SpelloutRules/%spellout-cardinal".
pub fn description(name: []const u8, out: *m.Bytes) -> void {
    if !isAlgorithmic(name) {
        m.pushText(out, digitsOf(name))
        return
    }
    var k = nd.key("numberingSystems/")
    nd.add(&k, name)
    nd.add(&k, "/_rules")
    const rules = nd.supplemental(&k)
    var slash = rules.length
    while slash > 0 && rules[slash - 1] != 47 { slash -= 1 }
    m.pushText(out, rules[0..slash])
    m.pushByte(out, 37)
    m.pushText(out, rules[slash..rules.length])
}

// The keyword value of the numbering system in locale ID (`numbers` or
// `nu`), lower case, into INTO; its length.
fn keywordOf(id: []const u8, into: *[16]u8) -> usize {
    var value = locale.keyword(id, "numbers")
    if value.length == 0 { value = locale.keyword(id, "nu") }
    var length: usize = 0
    for byte in value {
        if length < NAME_CAPACITY - 1 {
            into.*[length] = nd.lower(byte)
            length += 1
        }
    }
    return length
}

// The numbering system of locale ID into INTO (NAME_CAPACITY bytes): its
// length, and in RESULT 0, or U_USING_FALLBACK_WARNING when not even the
// default was found (latn then), or U_UNSUPPORTED_ERROR when the keyword
// names no system.
pub fn forLocale(id: []const u8, into: *[16]u8, result: *i32) -> usize {
    result.* = 0
    var length = keywordOf(id, into)
    var resolved = length > 0
    if resolved {
        const name = into.*[0..length]
        if m.same(name, "default") || m.same(name, "native") || m.same(name, "traditional") || m.same(name, "finance") { resolved = false }
    } else {
        const fallback = "default"
        var index: usize = 0
        while index < fallback.length {
            into.*[index] = fallback[index]
            index += 1
        }
        length = fallback.length
    }
    if !resolved {
        const data = resources.find(id)
        while !resolved {
            var k = nd.key("numbers/")
            const name = into.*[0..length]
            if m.same(name, "default") {
                nd.add(&k, "defaultNumberingSystem")
            } else {
                nd.add(&k, "otherNumberingSystems/")
                nd.add(&k, name)
            }
            const found = nd.get(data, &k)
            if found.length > 0 && found.length < NAME_CAPACITY {
                var index: usize = 0
                while index < found.length {
                    into.*[index] = found[index]
                    index += 1
                }
                length = found.length
                resolved = true
            } else if m.same(name, "native") || m.same(name, "finance") {
                length = setName(into, "default")
            } else if m.same(name, "traditional") {
                length = setName(into, "native")
            } else {
                result.* = -128
                return setName(into, "latn")
            }
        }
    }
    if !exists(into.*[0..length]) {
        result.* = m.UNSUPPORTED_ERROR
    }
    return length
}

fn setName(into: *[16]u8, name: []const u8) -> usize {
    var index: usize = 0
    while index < name.length {
        into.*[index] = name[index]
        index += 1
    }
    return name.length
}

// ---------------------------------------------------------------------------
// UNumberingSystem: "UNSY", the name (C string), radix, whether
// algorithmic, the description (UTF-16, its length).
//     0 u32 magic, i32 radix, 8 name[16], 24 bool algorithmic,
//     32 description address, 40 its length

const MAGIC: u32 = 1431195481
const SIZE: usize = 48

fn make(name: []const u8, status: usize) -> usize {
    const handle = m.alloc(SIZE)
    if handle == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.put32(handle, MAGIC)
    m.putI32(handle + 4, 10)
    var index: usize = 0
    while index < name.length && index < NAME_CAPACITY - 1 {
        m.put8(handle + 8 + index, name[index])
        index += 1
    }
    m.put8(handle + 24, if isAlgorithmic(name) { 1 } else { 0 })
    var text = m.bytesBuffer()
    description(name, &text)
    const copy = nd.utf16Copy(m.bytesText(&text))
    m.disposeBytes(&text)
    m.putWord(handle + 32, copy)
    m.putWord(handle + 40, nd.units16(copy))
    return handle
}

fn handleName(handle: usize) -> []const u8 { return m.cSlice(handle + 8) }

pub fn openByName(name: []const u8, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !resources.available() {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    if !exists(name) || name.length >= NAME_CAPACITY {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return 0
    }
    return make(name, status)
}

export fn unumsys_open(localeId: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const id = if localeId == 0 { locale.defaultLocale() } else { m.cSlice(localeId) }
    var name: [16]u8 = undefined
    var result: i32 = 0
    const length = forLocale(id, &name, &result)
    if result > 0 {
        m.setError(status, result)
        return 0
    }
    const handle = openByName(name[0..length], status)
    if handle != 0 && result < 0 { m.setError(status, result) }
    return handle
}

export fn unumsys_openByName(name: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if name == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return openByName(m.cSlice(name), status)
}

export fn unumsys_close(unumsys: usize) -> void {
    if unumsys == 0 || m.get32(unumsys) != MAGIC { return }
    m.release(m.getWord(unumsys + 32))
    m.put32(unumsys, 0)
    m.release(unumsys)
}

// The names of all systems, in the data's order (alphabetical).
export fn unumsys_openAvailableNames(status: usize) -> usize {
    if m.failed(status) { return 0 }
    var first: u32 = 0
    var end: u32 = 0
    resources.below("numberingSystems", &first, &end)
    var lines = m.bytesBuffer()
    var previous: []const u8 = ""
    var k = first
    while k < end {
        const name = resources.childName(k, 16)
        if !m.same(name, previous) {
            m.pushText(&lines, name)
            m.pushByte(&lines, 10)
            previous = name
        }
        k += 1
    }
    const en = enumeration.ofLines(m.bytesText(&lines), status)
    m.disposeBytes(&lines)
    return en
}

export fn unumsys_getName(unumsys: usize) -> usize {
    if unumsys == 0 { return 0 }
    return unumsys + 8
}

export fn unumsys_isAlgorithmic(unumsys: usize) -> bool {
    if unumsys == 0 { return false }
    return m.get8(unumsys + 24) != 0
}

export fn unumsys_getRadix(unumsys: usize) -> i32 {
    if unumsys == 0 { return 10 }
    return m.getI32(unumsys + 4)
}

export fn unumsys_getDescription(unumsys: usize, result: usize, resultLength: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if unumsys == 0 || (if result == 0 { resultLength != 0 } else { resultLength < 0 }) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    return nd.give16Units(m.getWord(unumsys + 32), m.getWord(unumsys + 40), result, resultLength, status)
}
