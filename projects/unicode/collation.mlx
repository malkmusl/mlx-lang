// Collation (ucol.h, uiter.h): the Unicode Collation Algorithm (UTS #10)
// with its table (DUCET, uca/allkeys.txt). Strings are compared in NFD:
// their collation elements (contractions matched longest first, then the
// unblocked non-starters after them; implicit weights for what the table
// does not list), then level by level.
const tables = @import("./tables.mlx")
const m = @import("./memory.mlx")
const p = @import("./properties.mlx")
const normalize = @import("./normalize.mlx")
const enumeration = @import("./enumeration.mlx")

// UColAttribute
const FRENCH_COLLATION: i32 = 0
const ALTERNATE_HANDLING: i32 = 1
const CASE_FIRST: i32 = 2
const CASE_LEVEL: i32 = 3
const NORMALIZATION_MODE: i32 = 4
const STRENGTH: i32 = 5
const HIRAGANA_QUATERNARY_MODE: i32 = 6
const NUMERIC_COLLATION: i32 = 7

// UColAttributeValue
const DEFAULT: i32 = -1
const PRIMARY: i32 = 0
const SECONDARY: i32 = 1
const TERTIARY: i32 = 2
const QUATERNARY: i32 = 3
const IDENTICAL: i32 = 15
const OFF: i32 = 16
const ON: i32 = 17
const SHIFTED: i32 = 20
const NON_IGNORABLE: i32 = 21
const LOWER_FIRST: i32 = 24
const UPPER_FIRST: i32 = 25

// The collator (C memory): its attributes, by UColAttribute.
const ATTRIBUTES: usize = 8
const LOCALE: usize = 32
const SIZE: usize = 192

fn attribute(coll: usize, which: i32) -> i32 { return m.getI32(coll + @intCast(usize, which) * 4) }
fn setAttributeValue(coll: usize, which: i32, value: i32) -> void { m.putI32(coll + @intCast(usize, which) * 4, value) }

fn defaults(coll: usize) -> void {
    setAttributeValue(coll, FRENCH_COLLATION, OFF)
    setAttributeValue(coll, ALTERNATE_HANDLING, NON_IGNORABLE)
    setAttributeValue(coll, CASE_FIRST, OFF)
    setAttributeValue(coll, CASE_LEVEL, OFF)
    setAttributeValue(coll, NORMALIZATION_MODE, OFF)
    setAttributeValue(coll, STRENGTH, TERTIARY)
    setAttributeValue(coll, HIRAGANA_QUATERNARY_MODE, OFF)
    setAttributeValue(coll, NUMERIC_COLLATION, OFF)
}

// ---------------------------------------------------------------------------
// Collation elements: primary << 16 | secondary << 7 | tertiary << 2 |
// 1 when variable.

fn primaryOf(ce: u32) -> u32 { return ce >> 16 }
fn secondaryOf(ce: u32) -> u32 { return (ce >> 7) & 511 }
fn tertiaryOf(ce: u32) -> u32 { return (ce >> 2) & 31 }
fn variableCE(ce: u32) -> bool { return (ce & 1) != 0 && primaryOf(ce) != 0 }

fn record(c: i32) -> u32 {
    if c < 0 || c > 1114111 { return 4294967295 }
    const code = @intCast(usize, c)
    const block = @intCast(usize, tables.COLLATION_INDEX[code >> 6])
    return tables.COLLATION_RECORDS[@intCast(usize, tables.COLLATION_BLOCKS[(block << 6) + (code & 63)])]
}

fn pushElements(out: *m.Buffer, value: u32) -> void {
    const offset = @intCast(usize, value >> 5)
    var index: usize = 0
    while index < @intCast(usize, value & 31) {
        m.push(out, tables.COLLATION_CES[offset + index])
        index += 1
    }
}

// The implicit weights of a code point the table does not list.
fn pushImplicit(out: *m.Buffer, c: i32) -> void {
    const code = @intCast(u32, if c < 0 { 65533 } else { c })
    var index: usize = 0
    while index < tables.IMPLICIT_FIRST.length {
        if code >= tables.IMPLICIT_FIRST[index] && code <= tables.IMPLICIT_LAST[index] {
            // (Counted from the first range of the same base: Tangut's
            // supplement follows Tangut.)
            const base = tables.IMPLICIT_BASE[index]
            var origin = tables.IMPLICIT_FIRST[index]
            var other: usize = 0
            while other < tables.IMPLICIT_FIRST.length {
                if tables.IMPLICIT_BASE[other] == base && tables.IMPLICIT_FIRST[other] < origin { origin = tables.IMPLICIT_FIRST[other] }
                other += 1
            }
            m.push(out, (base << 16) | (32 << 7) | (2 << 2))
            m.push(out, (((code - origin) | 32768) << 16))
            return
        }
        index += 1
    }
    var base: u32 = 64448
    if p.binary(@intCast(i32, code), 29) {
        base = if (code >= 19968 && code <= 40959) || (code >= 63744 && code <= 64255) { 64320 } else { 64384 }
    }
    m.push(out, ((base + (code >> 15)) << 16) | (32 << 7) | (2 << 2))
    m.push(out, (((code & 32767) | 32768) << 16))
}

// The range of contractions that begin with `c` (first index, count).
fn contractions(c: u32) -> (usize, usize) {
    var low: usize = 0
    var high: usize = tables.CONTRACTION_FIRST.length
    while low < high {
        const middle = (low + high) / 2
        if tables.CONTRACTION_FIRST[middle] < c { low = middle + 1 } else { high = middle }
    }
    var end = low
    while end < tables.CONTRACTION_FIRST.length && tables.CONTRACTION_FIRST[end] == c { end += 1 }
    return -> (low, end - low)
}

fn contractionLength(index: usize) -> usize { return @intCast(usize, tables.CONTRACTION_INFO[index] & 255) }
fn contractionCode(index: usize, at: usize) -> u32 { return tables.CONTRACTION_CODES[@intCast(usize, tables.CONTRACTION_INFO[index] >> 8) + at] }

// The contraction of first code `c` and the rest `rest` (count `count`
// code points in a buffer): its index + 1, or 0.
fn findSequence(c: u32, rest: *m.Buffer) -> usize {
    const range = contractions(c)
    var index = range.0
    while index < range.0 + range.1 {
        if contractionLength(index) == rest.*.length {
            var same = true
            var at: usize = 0
            while at < rest.*.length {
                if contractionCode(index, at) != m.at(rest, at) {
                    same = false
                    break
                }
                at += 1
            }
            if same { return index + 1 }
        }
        index += 1
    }
    return 0
}

// The collation elements of code points `text` (in NFD) into `out`.
fn elements(text: *m.Buffer, out: *m.Buffer) -> void {
    const count = text.*.length
    const consumed = m.alloc(count + 1)
    var rest = m.buffer()
    var i: usize = 0
    while i < count {
        if m.get8(consumed + i) != 0 {
            i += 1
            continue
        }
        const c = m.at(text, i)
        const range = contractions(c)
        if range.1 == 0 {
            const value = record(@intCast(i32, c))
            if value == 4294967295 { pushImplicit(out, @intCast(i32, c)) } else { pushElements(out, value) }
            i += 1
            continue
        }
        // The longest contraction that follows contiguously.
        var best: usize = 0
        var bestLength: usize = 0
        var index = range.0
        while index < range.0 + range.1 {
            const length = contractionLength(index)
            if length > bestLength && i + length < count {
                var same = true
                var at: usize = 0
                while at < length {
                    if m.get8(consumed + i + 1 + at) != 0 || contractionCode(index, at) != m.at(text, i + 1 + at) {
                        same = false
                        break
                    }
                    at += 1
                }
                if same {
                    best = index + 1
                    bestLength = length
                }
            }
            index += 1
        }
        var value = if best != 0 { tables.CONTRACTION_CES[best - 1] } else { record(@intCast(i32, c)) }
        rest.length = 0
        var at: usize = 0
        while at < bestLength {
            m.push(&rest, m.at(text, i + 1 + at))
            at += 1
        }
        // Then the unblocked non-starters that extend it.
        var k = i + 1 + bestLength
        var skipped: u32 = 0
        while k < count {
            if m.get8(consumed + k) != 0 {
                k += 1
                continue
            }
            const ccc = p.combiningClass(@intCast(i32, m.at(text, k)))
            if ccc == 0 { break }
            if ccc > skipped {
                m.push(&rest, m.at(text, k))
                const found = findSequence(c, &rest)
                if found != 0 {
                    value = tables.CONTRACTION_CES[found - 1]
                    m.put8(consumed + k, 1)
                    k += 1
                    continue
                }
                rest.length -= 1
            }
            if ccc > skipped { skipped = ccc }
            k += 1
        }
        if value == 4294967295 { pushImplicit(out, @intCast(i32, c)) } else { pushElements(out, value) }
        i += 1 + bestLength
    }
    m.dispose(&rest)
    m.release(consumed)
}

// Numeric collation: each run of decimal digits as one number, by its
// count of significant digits and then its digits.
fn numericElements(text: *m.Buffer, out: *m.Buffer) -> void {
    var plain = m.buffer()
    const zero = primaryOf(tables.COLLATION_CES[@intCast(usize, record(48) >> 5)])
    var i: usize = 0
    while i < text.*.length {
        const c = @intCast(i32, m.at(text, i))
        if p.category(c) != 9 {
            m.push(&plain, @intCast(u32, c))
            i += 1
            continue
        }
        if plain.length > 0 {
            elements(&plain, out)
            plain.length = 0
        }
        var end = i
        while end < text.*.length && p.category(@intCast(i32, m.at(text, end))) == 9 { end += 1 }
        var start = i
        while start < end && p.digitValue(@intCast(i32, m.at(text, start))) == 0 { start += 1 }
        m.push(out, (zero << 16) | (32 << 7) | (2 << 2))
        m.push(out, ((zero + @intCast(u32, end - start) + 1) << 16) | (32 << 7) | (2 << 2))
        var d = start
        while d < end {
            m.push(out, ((zero + @intCast(u32, p.digitValue(@intCast(i32, m.at(text, d))))) << 16) | (32 << 7) | (2 << 2))
            d += 1
        }
        i = end
    }
    if plain.length > 0 { elements(&plain, out) }
    m.dispose(&plain)
}

// ---------------------------------------------------------------------------
// Comparison

fn upperTertiary(t: u32) -> bool { return t == 8 || t == 9 || t == 10 || t == 11 || t == 12 || t == 14 || t == 17 || t == 18 || t == 29 }

// The weights of one level of elements `ces` into `out`.
const LEVEL_PRIMARY: u32 = 1
const LEVEL_SECONDARY: u32 = 2
const LEVEL_CASE: u32 = 3
const LEVEL_TERTIARY: u32 = 4
const LEVEL_QUATERNARY: u32 = 5

fn level(coll: usize, ces: *m.Buffer, which: u32, out: *m.Buffer) -> void {
    const shifted = attribute(coll, ALTERNATE_HANDLING) == SHIFTED
    const caseFirst = attribute(coll, CASE_FIRST)
    var afterVariable = false
    var index: usize = 0
    while index < ces.*.length {
        const ce = m.at(ces, index)
        index += 1
        var primary = primaryOf(ce)
        var secondary = secondaryOf(ce)
        var tertiary = tertiaryOf(ce)
        var quaternary: u32 = 65535
        if shifted {
            if variableCE(ce) {
                quaternary = primary
                primary = 0
                secondary = 0
                tertiary = 0
                afterVariable = true
            } else if primary == 0 && afterVariable {
                secondary = 0
                tertiary = 0
                quaternary = 0
            } else if primary == 0 && secondary == 0 && tertiary == 0 {
                quaternary = 0
            } else {
                if primary != 0 { afterVariable = false }
                if primary == 0 { quaternary = 65535 }
            }
        }
        if which == LEVEL_PRIMARY {
            if primary != 0 { m.push(out, primary) }
        } else if which == LEVEL_SECONDARY {
            if secondary != 0 { m.push(out, secondary) }
        } else if which == LEVEL_CASE {
            if primary != 0 {
                const upper = upperTertiary(tertiary)
                m.push(out, if (caseFirst == UPPER_FIRST) == upper { 1 } else { 2 })
            }
        } else if which == LEVEL_TERTIARY {
            if tertiary != 0 {
                var weight = tertiary
                if caseFirst == UPPER_FIRST { weight = weight | (if upperTertiary(tertiary) { 0 } else { 32 }) }
                if caseFirst == LOWER_FIRST { weight = weight | (if upperTertiary(tertiary) { 32 } else { 0 }) }
                m.push(out, weight)
            }
        } else {
            if quaternary != 0 { m.push(out, quaternary) }
        }
    }
}

fn compareBuffers(a: *m.Buffer, b: *m.Buffer, backwards: bool) -> i32 {
    var index: usize = 0
    while index < a.*.length && index < b.*.length {
        const x = if backwards { m.at(a, a.*.length - 1 - index) } else { m.at(a, index) }
        const y = if backwards { m.at(b, b.*.length - 1 - index) } else { m.at(b, index) }
        if x != y { return if x < y { -1 } else { 1 } }
        index += 1
    }
    if a.*.length == b.*.length { return 0 }
    return if a.*.length < b.*.length { -1 } else { 1 }
}

fn compareLevel(coll: usize, a: *m.Buffer, b: *m.Buffer, which: u32) -> i32 {
    var x = m.buffer()
    var y = m.buffer()
    level(coll, a, which, &x)
    level(coll, b, which, &y)
    const result = compareBuffers(&x, &y, which == LEVEL_SECONDARY && attribute(coll, FRENCH_COLLATION) == ON)
    m.dispose(&x)
    m.dispose(&y)
    return result
}

// Two strings of code points, compared by the collator.
pub fn compareCodes(coll: usize, first: *m.Buffer, second: *m.Buffer) -> i32 {
    var a = m.buffer()
    var b = m.buffer()
    normalize.normalizeCodes(&a, first, normalize.NFD)
    normalize.normalizeCodes(&b, second, normalize.NFD)
    var ca = m.buffer()
    var cb = m.buffer()
    if attribute(coll, NUMERIC_COLLATION) == ON {
        numericElements(&a, &ca)
        numericElements(&b, &cb)
    } else {
        elements(&a, &ca)
        elements(&b, &cb)
    }
    const strength = attribute(coll, STRENGTH)
    var result = compareLevel(coll, &ca, &cb, LEVEL_PRIMARY)
    if result == 0 && strength >= SECONDARY { result = compareLevel(coll, &ca, &cb, LEVEL_SECONDARY) }
    if result == 0 && attribute(coll, CASE_LEVEL) == ON { result = compareLevel(coll, &ca, &cb, LEVEL_CASE) }
    if result == 0 && strength >= TERTIARY { result = compareLevel(coll, &ca, &cb, LEVEL_TERTIARY) }
    if result == 0 && strength >= QUATERNARY && attribute(coll, ALTERNATE_HANDLING) == SHIFTED { result = compareLevel(coll, &ca, &cb, LEVEL_QUATERNARY) }
    if result == 0 && strength == IDENTICAL {
        result = compareBuffers(&a, &b, false)
        if result == 0 { result = compareBuffers(first, second, false) }
    }
    m.dispose(&a)
    m.dispose(&b)
    m.dispose(&ca)
    m.dispose(&cb)
    return result
}

// ---------------------------------------------------------------------------
// Collators

// The attributes a locale's keywords ask for: `@colNumeric=yes;...` and
// `-u-kn-true` and the like.
fn keywords(coll: usize, locale: []const u8) -> void {
    var index: usize = 0
    while index < locale.length {
        const start = index
        while index < locale.length && locale[index] != 59 && locale[index] != 64 && locale[index] != 45 && locale[index] != 95 { index += 1 }
        const part = locale[start..index]
        index += 1
        if p.looselySame(part, "colnumeric=yes") || p.looselySame(part, "kn") { setAttributeValue(coll, NUMERIC_COLLATION, ON) }
        if p.looselySame(part, "colcasefirst=upper") { setAttributeValue(coll, CASE_FIRST, UPPER_FIRST) }
        if p.looselySame(part, "colcasefirst=lower") { setAttributeValue(coll, CASE_FIRST, LOWER_FIRST) }
        if p.looselySame(part, "colalternate=shifted") { setAttributeValue(coll, ALTERNATE_HANDLING, SHIFTED) }
        if p.looselySame(part, "colbackwards=yes") { setAttributeValue(coll, FRENCH_COLLATION, ON) }
        if p.looselySame(part, "colcaselevel=yes") { setAttributeValue(coll, CASE_LEVEL, ON) }
        if p.looselySame(part, "colstrength=primary") || p.looselySame(part, "colstrength=level1") { setAttributeValue(coll, STRENGTH, PRIMARY) }
        if p.looselySame(part, "colstrength=secondary") || p.looselySame(part, "colstrength=level2") { setAttributeValue(coll, STRENGTH, SECONDARY) }
        if p.looselySame(part, "colstrength=quaternary") || p.looselySame(part, "colstrength=level4") { setAttributeValue(coll, STRENGTH, QUATERNARY) }
        if p.looselySame(part, "colstrength=identical") { setAttributeValue(coll, STRENGTH, IDENTICAL) }
    }
}

export fn ucol_open(locale: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const coll = m.alloc(SIZE)
    if coll == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    defaults(coll)
    if locale != 0 {
        const text = m.cSlice(locale)
        var length = text.length
        if length > SIZE - LOCALE - 1 { length = SIZE - LOCALE - 1 }
        m.copy(coll + LOCALE, locale, length)
        keywords(coll, text)
    }
    return coll
}

export fn ucol_openRules(rules: usize, length: i32, normalizationMode: i32, strength: i32, parseError: usize, status: usize) -> usize {
    // (A program's own tailoring is not read: the root collation, with
    // the strength asked for.)
    const coll = ucol_open(0, status)
    if coll != 0 && strength != DEFAULT { setAttributeValue(coll, STRENGTH, strength) }
    return coll
}

export fn ucol_close(coll: usize) -> void { m.release(coll) }

export fn ucol_clone(coll: usize, status: usize) -> usize {
    if m.failed(status) || coll == 0 { return 0 }
    const copy = m.alloc(SIZE)
    if copy == 0 {
        m.setError(status, m.MEMORY_ALLOCATION_ERROR)
        return 0
    }
    m.copy(copy, coll, SIZE)
    return copy
}

export fn ucol_safeClone(coll: usize, stackBuffer: usize, bufferSize: usize, status: usize) -> usize {
    if bufferSize != 0 && m.getI32(bufferSize) == 0 {
        m.putI32(bufferSize, @intCast(i32, SIZE))
        return 0
    }
    return ucol_clone(coll, status)
}

export fn ucol_setAttribute(coll: usize, which: i32, value: i32, status: usize) -> void {
    if m.failed(status) { return }
    if coll == 0 || which < 0 || which > 7 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return
    }
    if value == DEFAULT {
        const fresh = m.alloc(SIZE)
        defaults(fresh)
        setAttributeValue(coll, which, attribute(fresh, which))
        m.release(fresh)
        return
    }
    setAttributeValue(coll, which, value)
}

export fn ucol_getAttribute(coll: usize, which: i32, status: usize) -> i32 {
    if m.failed(status) { return DEFAULT }
    if coll == 0 || which < 0 || which > 7 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return DEFAULT
    }
    return attribute(coll, which)
}

export fn ucol_setStrength(coll: usize, strength: i32) -> void {
    if coll != 0 { setAttributeValue(coll, STRENGTH, if strength == DEFAULT { TERTIARY } else { strength }) }
}

export fn ucol_getStrength(coll: usize) -> i32 { return if coll == 0 { TERTIARY } else { attribute(coll, STRENGTH) } }

export fn ucol_strcoll(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> i32 {
    var a = m.buffer()
    var b = m.buffer()
    m.decode16(&a, source, if source == 0 { 0 } else { m.units(source, sourceLength) })
    m.decode16(&b, target, if target == 0 { 0 } else { m.units(target, targetLength) })
    const result = compareCodes(coll, &a, &b)
    m.dispose(&a)
    m.dispose(&b)
    return result
}

export fn ucol_equal(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> u8 { return if ucol_strcoll(coll, source, sourceLength, target, targetLength) == 0 { 1 } else { 0 } }
export fn ucol_greater(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> u8 { return if ucol_strcoll(coll, source, sourceLength, target, targetLength) > 0 { 1 } else { 0 } }
export fn ucol_greaterOrEqual(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> u8 { return if ucol_strcoll(coll, source, sourceLength, target, targetLength) >= 0 { 1 } else { 0 } }

// UTF-8 into code points (ill-formed bytes as U+FFFD).
pub fn decode8(out: *m.Buffer, s: usize, length: i32) -> void {
    const count = if s == 0 { 0 } else if length < 0 { m.cLength(s) } else { @intCast(usize, length) }
    var index: usize = 0
    while index < count {
        var used: i32 = 0
        const c = decodeOne(s + index, count - index, &used)
        m.push(out, @intCast(u32, c))
        index += @intCast(usize, used)
    }
}

fn decodeOne(s: usize, available: usize, used: *i32) -> i32 {
    const lead = @intCast(i32, m.get8(s))
    used.* = 1
    if lead < 128 { return lead }
    var need: usize = 0
    var c: i32 = 0
    var low: u8 = 128
    var high: u8 = 191
    if lead >= 194 && lead <= 223 {
        need = 1
        c = lead & 31
    } else if lead >= 224 && lead <= 239 {
        need = 2
        c = lead & 15
        if c == 0 { low = 160 }
        if c == 13 { high = 159 }
    } else if lead >= 240 && lead <= 244 {
        need = 3
        c = lead & 7
        if c == 0 { low = 144 }
        if c == 4 { high = 143 }
    } else {
        return 65533
    }
    var k: usize = 1
    while k <= need {
        if k >= available { return 65533 }
        const t = m.get8(s + k)
        if t < low || t > high { return 65533 }
        low = 128
        high = 191
        c = (c << 6) | @intCast(i32, t & 63)
        used.* = @intCast(i32, k + 1)
        k += 1
    }
    return c
}

export fn ucol_strcollUTF8(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    var a = m.buffer()
    var b = m.buffer()
    decode8(&a, source, sourceLength)
    decode8(&b, target, targetLength)
    const result = compareCodes(coll, &a, &b)
    m.dispose(&a)
    m.dispose(&b)
    return result
}

// ---------------------------------------------------------------------------
// UCharIterator (uiter.h): a C struct of functions; those of strings
// and UTF-8 are these.

const IT_CONTEXT: usize = 0
const IT_LENGTH: usize = 8
const IT_START: usize = 12
const IT_INDEX: usize = 16
const IT_LIMIT: usize = 20
const IT_RESERVED: usize = 24
const IT_GET_INDEX: usize = 32
const IT_MOVE: usize = 40
const IT_HAS_NEXT: usize = 48
const IT_HAS_PREVIOUS: usize = 56
const IT_CURRENT: usize = 64
const IT_NEXT: usize = 72
const IT_PREVIOUS: usize = 80
const IT_GET_STATE: usize = 96
const IT_SET_STATE: usize = 104
const ITERATOR_SIZE: usize = 112

const START: i32 = 0
const CURRENT: i32 = 1
const LIMIT: i32 = 2
const ZERO: i32 = 3
const LENGTH: i32 = 4

const Move = fn(usize, i32, i32) -> i32
const Step = fn(usize) -> i32

// A string's iterator: the UTF-16 units at `context`.
fn stringGetIndex(it: usize, origin: i32) -> i32 {
    if origin == START { return m.getI32(it + IT_START) }
    if origin == LIMIT { return m.getI32(it + IT_LIMIT) }
    if origin == LENGTH { return m.getI32(it + IT_LENGTH) }
    if origin == ZERO { return 0 }
    return m.getI32(it + IT_INDEX)
}

fn stringMove(it: usize, delta: i32, origin: i32) -> i32 {
    var position = delta
    if origin == CURRENT { position += m.getI32(it + IT_INDEX) }
    if origin == LIMIT { position += m.getI32(it + IT_LIMIT) }
    if origin == START { position += m.getI32(it + IT_START) }
    if origin == LENGTH { position += m.getI32(it + IT_LENGTH) }
    if position < m.getI32(it + IT_START) { position = m.getI32(it + IT_START) }
    if position > m.getI32(it + IT_LIMIT) { position = m.getI32(it + IT_LIMIT) }
    m.putI32(it + IT_INDEX, position)
    return position
}

fn stringHasNext(it: usize) -> u8 { return if m.getI32(it + IT_INDEX) < m.getI32(it + IT_LIMIT) { 1 } else { 0 } }
fn stringHasPrevious(it: usize) -> u8 { return if m.getI32(it + IT_INDEX) > m.getI32(it + IT_START) { 1 } else { 0 } }

fn stringCurrent(it: usize) -> i32 {
    const index = m.getI32(it + IT_INDEX)
    if index >= m.getI32(it + IT_LIMIT) { return -1 }
    return @intCast(i32, m.get16(m.getWord(it + IT_CONTEXT) + @intCast(usize, index) * 2))
}

fn stringNext(it: usize) -> i32 {
    const c = stringCurrent(it)
    if c >= 0 { m.putI32(it + IT_INDEX, m.getI32(it + IT_INDEX) + 1) }
    return c
}

fn stringPrevious(it: usize) -> i32 {
    const index = m.getI32(it + IT_INDEX)
    if index <= m.getI32(it + IT_START) { return -1 }
    m.putI32(it + IT_INDEX, index - 1)
    return @intCast(i32, m.get16(m.getWord(it + IT_CONTEXT) + @intCast(usize, index - 1) * 2))
}

fn stringGetState(it: usize) -> u32 { return @intCast(u32, m.getI32(it + IT_INDEX)) }

fn stringSetState(it: usize, state: u32, status: usize) -> void { _ = stringMove(it, @intCast(i32, state), ZERO) }

fn setFunctions(it: usize) -> void {
    m.putWord(it + IT_GET_INDEX, @intFromPtr(stringGetIndex))
    m.putWord(it + IT_MOVE, @intFromPtr(stringMove))
    m.putWord(it + IT_HAS_NEXT, @intFromPtr(stringHasNext))
    m.putWord(it + IT_HAS_PREVIOUS, @intFromPtr(stringHasPrevious))
    m.putWord(it + IT_CURRENT, @intFromPtr(stringCurrent))
    m.putWord(it + IT_NEXT, @intFromPtr(stringNext))
    m.putWord(it + IT_PREVIOUS, @intFromPtr(stringPrevious))
    m.putWord(it + IT_GET_STATE, @intFromPtr(stringGetState))
    m.putWord(it + IT_SET_STATE, @intFromPtr(stringSetState))
}

export fn uiter_setString(it: usize, s: usize, length: i32) -> void {
    if it == 0 { return }
    m.zero(it, ITERATOR_SIZE)
    const count = if s == 0 { 0 } else { m.units(s, length) }
    m.putWord(it + IT_CONTEXT, s)
    m.putI32(it + IT_LENGTH, @intCast(i32, count))
    m.putI32(it + IT_LIMIT, @intCast(i32, count))
    setFunctions(it)
}

// UTF-8: the bytes at `context`; the index counts bytes, and a trail
// surrogate still to give waits in the reserved field.
fn utf8Next(it: usize) -> i32 {
    const pending = m.getI32(it + IT_RESERVED)
    if pending != 0 {
        m.putI32(it + IT_RESERVED, 0)
        return pending
    }
    const index = m.getI32(it + IT_INDEX)
    const limit = m.getI32(it + IT_LIMIT)
    if index >= limit { return -1 }
    var used: i32 = 0
    const c = decodeOne(m.getWord(it + IT_CONTEXT) + @intCast(usize, index), @intCast(usize, limit - index), &used)
    m.putI32(it + IT_INDEX, index + used)
    if c >= 65536 {
        m.putI32(it + IT_RESERVED, (c & 1023) | 56320)
        return (c >> 10) + 55232
    }
    return c
}

fn utf8Move(it: usize, delta: i32, origin: i32) -> i32 {
    // (Only to the start or the end: what reading through needs.)
    m.putI32(it + IT_RESERVED, 0)
    const position = if origin == LIMIT || origin == LENGTH { m.getI32(it + IT_LIMIT) } else { 0 }
    m.putI32(it + IT_INDEX, position)
    return position
}

export fn uiter_setUTF8(it: usize, s: usize, length: i32) -> void {
    if it == 0 { return }
    m.zero(it, ITERATOR_SIZE)
    const count = if s == 0 { 0 } else if length < 0 { m.cLength(s) } else { @intCast(usize, length) }
    m.putWord(it + IT_CONTEXT, s)
    m.putI32(it + IT_LENGTH, -1)
    m.putI32(it + IT_LIMIT, @intCast(i32, count))
    setFunctions(it)
    m.putWord(it + IT_MOVE, @intFromPtr(utf8Move))
    m.putWord(it + IT_NEXT, @intFromPtr(utf8Next))
}

export fn uiter_current32(it: usize) -> i32 {
    const c = callStep(it, IT_CURRENT)
    if c >= 55296 && c <= 56319 {
        _ = callStep(it, IT_NEXT)
        const trail = callStep(it, IT_CURRENT)
        _ = callStep(it, IT_PREVIOUS)
        if trail >= 56320 && trail <= 57343 { return (c << 10) + trail - 56613888 }
    }
    return c
}

export fn uiter_next32(it: usize) -> i32 {
    const c = callStep(it, IT_NEXT)
    if c >= 55296 && c <= 56319 {
        const trail = callStep(it, IT_NEXT)
        if trail >= 56320 && trail <= 57343 { return (c << 10) + trail - 56613888 }
        if trail >= 0 { _ = callStep(it, IT_PREVIOUS) }
    }
    return c
}

export fn uiter_previous32(it: usize) -> i32 {
    const c = callStep(it, IT_PREVIOUS)
    if c >= 56320 && c <= 57343 {
        const lead = callStep(it, IT_PREVIOUS)
        if lead >= 55296 && lead <= 56319 { return (lead << 10) + c - 56613888 }
        if lead >= 0 { _ = callStep(it, IT_NEXT) }
    }
    return c
}

export fn uiter_getState(it: usize) -> u32 {
    const function = m.getWord(it + IT_GET_STATE)
    if function == 0 { return 0 }
    const target: GetState = unsafe { @ptrFromInt(GetState, function) }
    return target(it)
}

export fn uiter_setState(it: usize, state: u32, status: usize) -> void {
    if m.failed(status) { return }
    const function = m.getWord(it + IT_SET_STATE)
    if function == 0 {
        m.setError(status, m.UNSUPPORTED_ERROR)
        return
    }
    const target: SetState = unsafe { @ptrFromInt(SetState, function) }
    target(it, state, status)
}

const GetState = fn(usize) -> u32
const SetState = fn(usize, u32, usize) -> void

fn callStep(it: usize, which: usize) -> i32 {
    const target: Step = unsafe { @ptrFromInt(Step, m.getWord(it + which)) }
    return target(it)
}

// The code units an iterator gives, from its start, as code points.
fn readIterator(it: usize, out: *m.Buffer) -> void {
    if m.getWord(it + IT_NEXT) == @intFromPtr(utf8Next) {
        decode8(out, m.getWord(it + IT_CONTEXT), m.getI32(it + IT_LIMIT))
        return
    }
    if m.getWord(it + IT_NEXT) == @intFromPtr(stringNext) {
        m.decode16(out, m.getWord(it + IT_CONTEXT) + @intCast(usize, m.getI32(it + IT_START)) * 2, @intCast(usize, m.getI32(it + IT_LIMIT) - m.getI32(it + IT_START)))
        return
    }
    const move: Move = unsafe { @ptrFromInt(Move, m.getWord(it + IT_MOVE)) }
    _ = move(it, 0, START)
    var units = m.buffer()
    while true {
        const unit = callStep(it, IT_NEXT)
        if unit < 0 { break }
        m.push(&units, @intCast(u32, unit))
    }
    var index: usize = 0
    while index < units.length {
        var c = m.at(&units, index)
        index += 1
        if c >= 55296 && c <= 56319 && index < units.length {
            const trail = m.at(&units, index)
            if trail >= 56320 && trail <= 57343 {
                c = (c << 10) + trail - 56613888
                index += 1
            }
        }
        m.push(out, c)
    }
    m.dispose(&units)
}

export fn ucol_strcollIter(coll: usize, first: usize, second: usize, status: usize) -> i32 {
    if m.failed(status) { return 0 }
    if coll == 0 || first == 0 || second == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var a = m.buffer()
    var b = m.buffer()
    readIterator(first, &a)
    readIterator(second, &b)
    const result = compareCodes(coll, &a, &b)
    m.dispose(&a)
    m.dispose(&b)
    return result
}

// ---------------------------------------------------------------------------
// Sort keys: the levels' weights, each level ended by 1 (weights are
// written as two bytes, 0 avoided), the whole by 0.

fn appendWeight(key: *m.Buffer, weight: u32) -> void {
    m.push(key, (weight >> 8) + 2)
    m.push(key, (weight & 255) + 2)
}

export fn ucol_getSortKey(coll: usize, source: usize, length: i32, result: usize, capacity: i32) -> i32 {
    var text = m.buffer()
    m.decode16(&text, source, if source == 0 { 0 } else { m.units(source, length) })
    var nfd = m.buffer()
    normalize.normalizeCodes(&nfd, &text, normalize.NFD)
    var ces = m.buffer()
    if attribute(coll, NUMERIC_COLLATION) == ON { numericElements(&nfd, &ces) } else { elements(&nfd, &ces) }
    var key = m.buffer()
    const strength = attribute(coll, STRENGTH)
    var which: u32 = LEVEL_PRIMARY
    while which <= LEVEL_QUATERNARY {
        var include = which == LEVEL_PRIMARY
        if which == LEVEL_SECONDARY { include = strength >= SECONDARY }
        if which == LEVEL_CASE { include = attribute(coll, CASE_LEVEL) == ON }
        if which == LEVEL_TERTIARY { include = strength >= TERTIARY }
        if which == LEVEL_QUATERNARY { include = strength >= QUATERNARY && attribute(coll, ALTERNATE_HANDLING) == SHIFTED }
        if include {
            var weights = m.buffer()
            level(coll, &ces, which, &weights)
            var index: usize = 0
            const backwards = which == LEVEL_SECONDARY && attribute(coll, FRENCH_COLLATION) == ON
            while index < weights.length {
                appendWeight(&key, if backwards { m.at(&weights, weights.length - 1 - index) } else { m.at(&weights, index) })
                index += 1
            }
            m.dispose(&weights)
            m.push(&key, 1)
        }
        which += 1
    }
    if strength == IDENTICAL {
        var index: usize = 0
        while index < nfd.length {
            const c = m.at(&nfd, index)
            m.push(&key, ((c >> 16) & 255) + 2)
            appendWeight(&key, c & 65535)
            index += 1
        }
    }
    m.push(&key, 0)
    const room = if capacity > 0 { @intCast(usize, capacity) } else { 0 }
    var index: usize = 0
    while index < key.length && index < room {
        m.put8(result + index, @intCast(u8, m.at(&key, index) & 255))
        index += 1
    }
    const total = key.length
    m.dispose(&text)
    m.dispose(&nfd)
    m.dispose(&ces)
    m.dispose(&key)
    return @intCast(i32, total)
}

// ---------------------------------------------------------------------------
// What collations there are: the root's, for the languages whose CLDR
// collation is the root's.

const AVAILABLE: []const u8 = "af\nar\nca\nde\nen\nes\net\nfi\nfil\nfr\nga\nhe\nhu\nid\nit\nja\nko\nms\nnl\nnb\npl\npt\nro\nru\nsk\nsv\nsw\nth\ntr\nuk\nvi\nzh\n"

export fn ucol_countAvailable() -> i32 { return @intCast(i32, enumeration.lineCount(AVAILABLE)) }

export fn ucol_getAvailable(index: i32) -> usize {
    if index < 0 { return 0 }
    return enumeration.lineAt(AVAILABLE, @intCast(usize, index))
}

export fn ucol_openAvailableLocales(status: usize) -> usize { return enumeration.ofLines(AVAILABLE, status) }

export fn ucol_getKeywords(status: usize) -> usize { return enumeration.ofLines("collation\n", status) }

export fn ucol_getKeywordValues(keyword: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return enumeration.ofLines("standard\nsearch\n", status)
}

export fn ucol_getKeywordValuesForLocale(key: usize, locale: usize, commonlyUsed: i8, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return enumeration.ofLines("standard\nsearch\n", status)
}

export fn ucol_getLocaleByType(coll: usize, kind: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    return m.literal("root")
}

export fn ucol_getReorderCodes(coll: usize, dest: usize, capacity: i32, status: usize) -> i32 { return 0 }

export fn ucol_setReorderCodes(coll: usize, codes: usize, length: i32, status: usize) -> void {}

export fn ucol_getRules(coll: usize, length: usize) -> usize {
    if length != 0 { m.putI32(length, 0) }
    return @intFromPtr(&emptyRules)
}

var emptyRules: [2]u16 = [2]u16{ 0, 0 }

export fn ucol_getVersion(coll: usize, version: usize) -> void {
    m.put8(version, 16)
    m.put8(version + 1, 0)
    m.put8(version + 2, 0)
    m.put8(version + 3, 0)
}

export fn ucol_getUCAVersion(coll: usize, version: usize) -> void { ucol_getVersion(coll, version) }

export fn ucol_getMaxVariable(coll: usize) -> i32 { return 4097 }
export fn ucol_setMaxVariable(coll: usize, group: i32, status: usize) -> void {}
