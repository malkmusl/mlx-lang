// ures.h: resource bundles over the locale data (resources.mlx). A bundle
// is a locale and a path of keys in ICU's layout; a path is read in
// CLDR's (cldr.dat's) where the two differ:
//     NumberElements/NS/symbols/X   numbers/symbols-numberSystem-NS/X
//     NumberElements/NS/patterns/X  numbers/X-numberSystem-NS/standard
// and as it is elsewhere. Tables are the keys below a path, strings its
// values; a lookup falls back to the locale's parents, as ICU's does.
const m = @import("./memory.mlx")
const resources = @import("./resources.mlx")
const enumeration = @import("./enumeration.mlx")
const formatted = @import("./formatted.mlx")

// "URES"
const MAGIC: u32 = 1431458387

// URES_STRING, URES_TABLE (ures.h's UResType).
const URES_NONE: i32 = -1
const URES_STRING: i32 = 0
const URES_TABLE: i32 = 2

// A bundle:
//     0 u32 magic, u32 the locale's index in the data
//     8 the ICU path (a C string, "" at the top)
//     16 the last key (into the path), 24 a UTF-16 copy of its string
//     32 the iteration's next child, 40 the locale asked for (C string)
//     48 the locale the data is of, in ICU's form (C string)
const SIZE: usize = 56

fn bundle(handle: usize) -> bool { return handle != 0 && m.get32(handle) == MAGIC }

fn copyC(text: []const u8) -> usize {
    const at = m.alloc(text.length + 1)
    m.copy(at, @intFromPtr(text.pointer), text.length)
    return at
}

fn make(locale: u32, path: []const u8, asked: []const u8) -> usize {
    const handle = m.alloc(SIZE)
    if handle == 0 { return 0 }
    m.put32(handle, MAGIC)
    m.put32(handle + 4, locale)
    const p = copyC(path)
    m.putWord(handle + 8, p)
    var last = path.length
    while last > 0 && path[last - 1] != 47 { last -= 1 }
    m.putWord(handle + 16, p + last)
    m.putWord(handle + 40, copyC(asked))
    // de-AT is de_AT, und root.
    const name = resources.localeName(locale)
    const actual = if m.same(name, "und") { copyC("root") } else { copyC(name) }
    var k: usize = 0
    while k < name.length {
        if m.get8(actual + k) == 45 { m.put8(actual + k, 95) }
        k += 1
    }
    m.putWord(handle + 48, actual)
    return handle
}

fn path(handle: usize) -> []const u8 { return m.cSlice(m.getWord(handle + 8)) }

fn segment(text: []const u8, index: usize) -> []const u8 {
    var at: usize = 0
    var start: usize = 0
    var part: usize = 0
    while at <= text.length {
        if at == text.length || text[at] == 47 {
            if part == index { return text[start..at] }
            part += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

fn segments(text: []const u8) -> usize {
    if text.length == 0 { return 0 }
    var count: usize = 1
    for byte in text {
        if byte == 47 { count += 1 }
    }
    return count
}

// The CLDR key of ICU path P into OUT.
fn cldrPath(p: []const u8, out: *m.Bytes) -> void {
    if m.same(segment(p, 0), "NumberElements") && segments(p) >= 3 {
        const ns = segment(p, 1)
        const kind = segment(p, 2)
        if m.same(kind, "symbols") {
            m.pushText(out, "numbers/symbols-numberSystem-")
            m.pushText(out, ns)
            var index: usize = 3
            while index < segments(p) {
                m.pushByte(out, 47)
                m.pushText(out, segment(p, index))
                index += 1
            }
            return
        }
        if m.same(kind, "patterns") && segments(p) >= 4 {
            m.pushText(out, "numbers/")
            m.pushText(out, segment(p, 3))
            m.pushText(out, "-numberSystem-")
            m.pushText(out, ns)
            m.pushText(out, "/standard")
            return
        }
    }
    m.pushText(out, p)
}

// Whether ICU path P names something for LOCALE: a value, or keys below.
fn exists(locale: u32, p: []const u8) -> bool {
    if p.length == 0 { return true }
    // The levels ICU has and CLDR folds into its keys.
    if m.same(p, "NumberElements") { return true }
    if m.same(segment(p, 0), "NumberElements") && segments(p) == 2 {
        var key = m.bytesBuffer()
        m.pushText(&key, "numbers/symbols-numberSystem-")
        m.pushText(&key, segment(p, 1))
        var first: u32 = 0
        var end: u32 = 0
        resources.below(m.bytesText(&key), &first, &end)
        m.disposeBytes(&key)
        return first < end
    }
    if m.same(segment(p, 0), "NumberElements") && segments(p) == 3 && m.same(segment(p, 2), "patterns") { return true }
    var key = m.bytesBuffer()
    cldrPath(p, &key)
    var value: []const u8 = ""
    var found = resources.lookup(locale, m.bytesText(&key), &value)
    if !found {
        var first: u32 = 0
        var end: u32 = 0
        resources.below(m.bytesText(&key), &first, &end)
        var k = first
        while k < end && !found {
            if resources.valueOf(locale, k) != resources.NONE { found = true }
            k += 1
        }
    }
    m.disposeBytes(&key)
    return found
}

// The string at ICU path P for LOCALE, false when there is none.
fn stringAt(locale: u32, p: []const u8, value: *[]const u8) -> bool {
    var key = m.bytesBuffer()
    cldrPath(p, &key)
    const found = resources.lookup(locale, m.bytesText(&key), value)
    m.disposeBytes(&key)
    return found
}

fn joined(handle: usize, key: []const u8, out: *m.Bytes) -> void {
    const p = path(handle)
    m.pushText(out, p)
    if p.length > 0 { m.pushByte(out, 47) }
    m.pushText(out, key)
}

// The UTF-16 copy of TEXT the bundle keeps (until it is closed or asked
// for another), with its length into LEN.
fn utf16(handle: usize, text: []const u8, len: usize) -> usize {
    if m.getWord(handle + 24) != 0 { m.release(m.getWord(handle + 24)) }
    var count: usize = 0
    const copy = formatted.utf16Copy(text, &count)
    m.putWord(handle + 24, copy)
    if len != 0 { m.putI32(len, @intCast(i32, count)) }
    return copy
}

fn openWith(locale: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !resources.available() {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const asked = if locale == 0 { "" } else { m.cSlice(locale) }
    const index = resources.find(asked)
    if index == resources.NONE {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    const handle = make(index, "", asked)
    if handle == 0 { m.setError(status, m.MEMORY_ALLOCATION_ERROR) }
    return handle
}

// Only ICU's own data is here (packageName is null).
export fn ures_open(packageName: usize, locale: usize, status: usize) -> usize {
    if packageName != 0 {
        if !m.failed(status) { m.setError(status, m.MISSING_RESOURCE_ERROR) }
        return 0
    }
    return openWith(locale, status)
}

export fn ures_openDirect(packageName: usize, locale: usize, status: usize) -> usize { return ures_open(packageName, locale, status) }

export fn ures_openU(packageName: usize, locale: usize, status: usize) -> usize { return ures_open(packageName, locale, status) }

export fn ures_close(resourceBundle: usize) -> void {
    if !bundle(resourceBundle) { return }
    m.release(m.getWord(resourceBundle + 8))
    m.release(m.getWord(resourceBundle + 40))
    m.release(m.getWord(resourceBundle + 48))
    if m.getWord(resourceBundle + 24) != 0 { m.release(m.getWord(resourceBundle + 24)) }
    m.put32(resourceBundle, 0)
    m.release(resourceBundle)
}

// CLDR's version (48), as ICU gives its data's.
export fn ures_getVersion(resB: usize, versionInfo: usize) -> void {
    if versionInfo == 0 { return }
    m.zero(versionInfo, 4)
    m.put8(versionInfo, 48)
}

// The locale the data came from (ULOC_ACTUAL_LOCALE, 0), or the one asked
// for (ULOC_VALID_LOCALE, 1), in ICU's form.
export fn ures_getLocaleByType(resourceBundle: usize, type_: i32, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !bundle(resourceBundle) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    if type_ == 1 { return m.getWord(resourceBundle + 40) }
    return m.getWord(resourceBundle + 48)
}

export fn ures_getString(resourceBundle: usize, len: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !bundle(resourceBundle) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var value: []const u8 = ""
    if !stringAt(m.get32(resourceBundle + 4), path(resourceBundle), &value) {
        m.setError(status, m.RESOURCE_TYPE_MISMATCH)
        return 0
    }
    return utf16(resourceBundle, value, len)
}

export fn ures_getUTF8String(resB: usize, dest: usize, length: usize, forceCopy: bool, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !bundle(resB) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var value: []const u8 = ""
    if !stringAt(m.get32(resB + 4), path(resB), &value) {
        m.setError(status, m.RESOURCE_TYPE_MISMATCH)
        return 0
    }
    return utf8Result(value, dest, length, status)
}

// TEXT for C as ures_getUTF8String gives it: into DEST when there is
// one (its capacity in *LENGTH), else the data's own (NUL-terminated).
fn utf8Result(text: []const u8, dest: usize, length: usize, status: usize) -> usize {
    const capacity = if length != 0 { m.getI32(length) } else { 0 }
    if length != 0 { m.putI32(length, @intCast(i32, text.length)) }
    if dest == 0 { return @intFromPtr(text.pointer) }
    const fit = if text.length < @intCast(usize, if capacity > 0 { capacity } else { 0 }) { text.length } else { @intCast(usize, if capacity > 0 { capacity } else { 0 }) }
    m.copy(dest, @intFromPtr(text.pointer), fit)
    _ = m.terminate8(dest, text.length, capacity, status)
    return dest
}

export fn ures_getBinary(resourceBundle: usize, len: usize, status: usize) -> usize {
    if !m.failed(status) { m.setError(status, m.RESOURCE_TYPE_MISMATCH) }
    return 0
}

export fn ures_getIntVector(resourceBundle: usize, len: usize, status: usize) -> usize {
    if !m.failed(status) { m.setError(status, m.RESOURCE_TYPE_MISMATCH) }
    return 0
}

fn integer(resourceBundle: usize, status: usize) -> i64 {
    if m.failed(status) { return 0 }
    var value: []const u8 = ""
    if !bundle(resourceBundle) || !stringAt(m.get32(resourceBundle + 4), path(resourceBundle), &value) {
        m.setError(status, m.RESOURCE_TYPE_MISMATCH)
        return 0
    }
    var negative = false
    var at: usize = 0
    if at < value.length && value[at] == 45 {
        negative = true
        at += 1
    }
    var result: i64 = 0
    while at < value.length && value[at] >= 48 && value[at] <= 57 {
        result = result *% 10 +% @intCast(i64, value[at] - 48)
        at += 1
    }
    if at != value.length || value.length == 0 {
        m.setError(status, m.RESOURCE_TYPE_MISMATCH)
        return 0
    }
    return if negative { -result } else { result }
}

export fn ures_getUInt(resourceBundle: usize, status: usize) -> u32 { return @intCast(u32, @bitCast(u64, integer(resourceBundle, status)) & 4294967295) }
export fn ures_getInt(resourceBundle: usize, status: usize) -> i32 { return @bitCast(i32, @intCast(u32, @bitCast(u64, integer(resourceBundle, status)) & 4294967295)) }

// The children of a table: the distinct names after PATH/ of the keys
// with a value for the locale, in order, through EACH (index, name).
fn children(handle: usize, wanted: usize, name: *[]const u8) -> usize {
    var key = m.bytesBuffer()
    cldrPath(path(handle), &key)
    var first: u32 = 0
    var end: u32 = 0
    if path(handle).length == 0 {
        first = 0
        end = resources.keys()
    } else {
        resources.below(m.bytesText(&key), &first, &end)
    }
    const prefix = if path(handle).length == 0 { 0 } else { m.bytesText(&key).length }
    const locale = m.get32(handle + 4)
    var count: usize = 0
    var previous: []const u8 = ""
    var k = first
    while k < end {
        const child = if prefix == 0 { segment(resources.keyName(k), 0) } else { resources.childName(k, prefix) }
        if (count == 0 || !m.same(child, previous)) && resources.valueOf(locale, k) != resources.NONE {
            if count == wanted { name.* = child }
            previous = child
            count += 1
        }
        k += 1
    }
    m.disposeBytes(&key)
    return count
}

export fn ures_getSize(resourceBundle: usize) -> i32 {
    if !bundle(resourceBundle) { return 0 }
    var value: []const u8 = ""
    if stringAt(m.get32(resourceBundle + 4), path(resourceBundle), &value) { return 1 }
    var name: []const u8 = ""
    return @intCast(i32, children(resourceBundle, 1 << 40, &name))
}

export fn ures_getType(resourceBundle: usize) -> i32 {
    if !bundle(resourceBundle) { return URES_NONE }
    var value: []const u8 = ""
    if stringAt(m.get32(resourceBundle + 4), path(resourceBundle), &value) { return URES_STRING }
    return URES_TABLE
}

export fn ures_getKey(resourceBundle: usize) -> usize {
    if !bundle(resourceBundle) || path(resourceBundle).length == 0 { return 0 }
    return m.getWord(resourceBundle + 16)
}

export fn ures_resetIterator(resourceBundle: usize) -> void {
    if bundle(resourceBundle) { m.putWord(resourceBundle + 32, 0) }
}

export fn ures_hasNext(resourceBundle: usize) -> bool {
    if !bundle(resourceBundle) { return false }
    return m.getWord(resourceBundle + 32) < @intCast(usize, ures_getSize(resourceBundle))
}

// A child of HANDLE by name, as a bundle (FILLIN reused when given).
fn child(handle: usize, key: []const u8, fillIn: usize, status: usize) -> usize {
    var p = m.bytesBuffer()
    joined(handle, key, &p)
    const locale = m.get32(handle + 4)
    if !exists(locale, m.bytesText(&p)) {
        m.disposeBytes(&p)
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return fillIn
    }
    if bundle(fillIn) { ures_close(fillIn) }
    const made = make(locale, m.bytesText(&p), m.cSlice(m.getWord(handle + 40)))
    m.disposeBytes(&p)
    if made == 0 { m.setError(status, m.MEMORY_ALLOCATION_ERROR) }
    return made
}

export fn ures_getNextResource(resourceBundle: usize, fillIn: usize, status: usize) -> usize {
    if m.failed(status) { return fillIn }
    if !bundle(resourceBundle) {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return fillIn
    }
    const next = m.getWord(resourceBundle + 32)
    var name: []const u8 = ""
    if next >= children(resourceBundle, next, &name) {
        m.setError(status, m.INDEX_OUTOFBOUNDS_ERROR)
        return fillIn
    }
    m.putWord(resourceBundle + 32, next + 1)
    return child(resourceBundle, name, fillIn, status)
}

export fn ures_getNextString(resourceBundle: usize, len: usize, key: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    const next = ures_getNextResource(resourceBundle, 0, status)
    if m.failed(status) { return 0 }
    // The key is the parent's to keep: a copy of the last name.
    var value: []const u8 = ""
    const found = stringAt(m.get32(next + 4), path(next), &value)
    const nextPath = path(next)
    var last = nextPath.length
    while last > 0 && nextPath[last - 1] != 47 { last -= 1 }
    const keyName = nextPath[last..nextPath.length]
    ures_close(next)
    if !found {
        m.setError(status, m.RESOURCE_TYPE_MISMATCH)
        return 0
    }
    if key != 0 { m.putWord(key, resources.stringAddressOf(keyName)) }
    return utf16(resourceBundle, value, len)
}

export fn ures_getByIndex(resourceBundle: usize, indexR: i32, fillIn: usize, status: usize) -> usize {
    if m.failed(status) { return fillIn }
    if !bundle(resourceBundle) || indexR < 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return fillIn
    }
    var name: []const u8 = ""
    if @intCast(usize, indexR) >= children(resourceBundle, @intCast(usize, indexR), &name) {
        m.setError(status, m.INDEX_OUTOFBOUNDS_ERROR)
        return fillIn
    }
    return child(resourceBundle, name, fillIn, status)
}

export fn ures_getStringByIndex(resourceBundle: usize, indexS: i32, len: usize, status: usize) -> usize {
    const c = ures_getByIndex(resourceBundle, indexS, 0, status)
    if m.failed(status) { return 0 }
    var value: []const u8 = ""
    const found = stringAt(m.get32(c + 4), path(c), &value)
    ures_close(c)
    if !found {
        m.setError(status, m.RESOURCE_TYPE_MISMATCH)
        return 0
    }
    return utf16(resourceBundle, value, len)
}

export fn ures_getUTF8StringByIndex(resB: usize, stringIndex: i32, dest: usize, pLength: usize, forceCopy: bool, status: usize) -> usize {
    const c = ures_getByIndex(resB, stringIndex, 0, status)
    if m.failed(status) { return 0 }
    var value: []const u8 = ""
    const found = stringAt(m.get32(c + 4), path(c), &value)
    ures_close(c)
    if !found {
        m.setError(status, m.RESOURCE_TYPE_MISMATCH)
        return 0
    }
    return utf8Result(value, dest, pLength, status)
}

export fn ures_getByKey(resourceBundle: usize, key: usize, fillIn: usize, status: usize) -> usize {
    if m.failed(status) { return fillIn }
    if !bundle(resourceBundle) || key == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return fillIn
    }
    return child(resourceBundle, m.cSlice(key), fillIn, status)
}

export fn ures_getStringByKey(resB: usize, key: usize, len: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !bundle(resB) || key == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var p = m.bytesBuffer()
    joined(resB, m.cSlice(key), &p)
    var value: []const u8 = ""
    const found = stringAt(m.get32(resB + 4), m.bytesText(&p), &value)
    m.disposeBytes(&p)
    if !found {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    return utf16(resB, value, len)
}

export fn ures_getUTF8StringByKey(resB: usize, key: usize, dest: usize, pLength: usize, forceCopy: bool, status: usize) -> usize {
    if m.failed(status) { return 0 }
    if !bundle(resB) || key == 0 {
        m.setError(status, m.ILLEGAL_ARGUMENT_ERROR)
        return 0
    }
    var p = m.bytesBuffer()
    joined(resB, m.cSlice(key), &p)
    var value: []const u8 = ""
    const found = stringAt(m.get32(resB + 4), m.bytesText(&p), &value)
    m.disposeBytes(&p)
    if !found {
        m.setError(status, m.MISSING_RESOURCE_ERROR)
        return 0
    }
    return utf8Result(value, dest, pLength, status)
}

// The locales with data, in ICU's form (de_AT), root first.
export fn ures_openAvailableLocales(packageName: usize, status: usize) -> usize {
    if m.failed(status) { return 0 }
    var names = m.bytesBuffer()
    m.pushText(&names, "root\n")
    var index: u32 = 0
    while index < resources.count() {
        const name = resources.localeName(index)
        if name.length > 0 && name[0] != 64 && !m.same(name, "und") {
            for byte in name { m.pushByte(&names, if byte == 45 { 95 } else { byte }) }
            m.pushByte(&names, 10)
        }
        index += 1
    }
    const en = enumeration.ofLines(m.bytesText(&names), status)
    m.disposeBytes(&names)
    return en
}
