// wget's look at this machine's side of the network on brixOS (side.mlx
// is Linux's): the link's record (/devices/net0, std.os.brix), for what
// wget says when a host cannot be reached from here.
const std = @import("std")
const brix = std.os.brix

// What stands in the way on this machine's side, in words: it has no
// network device, its link is down, or it has no address; "" when none
// of them does (or the system does not say).
pub fn trouble() -> []const u8 {
    var link: brix.NetworkLink = undefined
    const read = brix.networkLink(0, &link)
    if read == -brix.Status.not_found { return "this machine has no network device" }
    if read < 0 { return "" }
    if !link.up { return "the network link is down" }
    if link.configured == brix.NetworkLink.NONE { return "this machine has no address" }
    return ""
}

// Why the system said that a host cannot be reached from this machine
// (std.net's ENETUNREACH): what stands in the way here, else the one
// thing left.
pub fn unreachable() -> []const u8 {
    const here = trouble()
    if here.length > 0 { return here }
    return "the host is not on this machine's network, and there is no gateway"
}
