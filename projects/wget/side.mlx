// wget's look at this machine's side of the network, on Linux: not
// asked for here (a connection goes where the system's routes send it).
// side.brixos.mlx reads brixOS's record of the link, which the compiler
// takes for --target=x86_64-brixos.

// What stands in the way on this machine's side, in words; "" when the
// system does not say.
pub fn trouble() -> []const u8 { return "" }

// Why the system said that a host cannot be reached from this machine
// (std.net's ENETUNREACH).
pub fn unreachable() -> []const u8 { return "the network cannot be reached" }
