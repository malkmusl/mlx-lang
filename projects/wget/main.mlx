// wget URL [-O FILE]: the document at URL (http or https; redirects
// followed) saved as FILE (the URL's last path part when none is given,
// "index.html" when it has none), its size said on standard error; 0, or
// 1 when it could not be fetched or written (the reason said: of a host
// that cannot be connected to, whether it refused, did not answer, or
// cannot be reached from this machine as it is, and then what stands in
// the way here: no network device, the link down, no address, no
// gateway). On std.http.client; this machine's side of the network is
// side.mlx's (Linux) or side.brixos.mlx's.
const std = @import("std")
const crash = @import("std.crash")
const net = @import("std.net")
const client = @import("std.http.client")
const side = @import("./side.mlx")

fn say(text: []const u8) -> void { _ = std.linux.write(2, text.pointer, text.length) }

fn sayNumber(value: usize) -> void {
    var buffer: [20]u8 = undefined
    var n = value
    var count: usize = 0
    while true {
        buffer[19 - count] = @intCast(u8, 48 + n % 10)
        count += 1
        n /= 10
        if n == 0 { break }
    }
    say(buffer[20 - count..20])
}

// Why no connection was made, after "cannot connect" (`why`: std.net's
// word, -errno); "" when it does not say more.
fn connectText(why: isize) -> []const u8 {
    if why == net.ENETUNREACH { return side.unreachable() }
    if why == net.ECONNREFUSED { return "the host refused the connection" }
    if why == net.ETIMEDOUT { return "the host did not answer" }
    return ""
}

fn errorText(outcome: client.Error) -> []const u8 {
    if outcome == client.Error.badUrl { return "not an http:// or https:// URL" }
    if outcome == client.Error.resolve { return "the host has no address" }
    if outcome == client.Error.connect { return "cannot connect" }
    if outcome == client.Error.tls { return "the TLS handshake failed" }
    if outcome == client.Error.send { return "cannot send the request" }
    if outcome == client.Error.receive { return "the connection ended before the response was whole" }
    if outcome == client.Error.malformed { return "the response is not HTTP" }
    if outcome == client.Error.tooLarge { return "the body is too large" }
    if outcome == client.Error.tooManyRedirects { return "too many redirects" }
    if outcome == client.Error.noMemory { return "out of memory" }
    return "stopped"
}

// The file name a URL suggests.
fn nameOf(url: []const u8) -> []const u8 {
    var end = url.length
    var k: usize = 0
    while k < url.length {
        if url[k] == 63 || url[k] == 35 {
            end = k
            break
        }
        k += 1
    }
    var start = end
    while start > 0 && url[start - 1] != 47 { start -= 1 }
    // (The host part, when there is no path.)
    if start < 8 || (start == end) { return "index.html" }
    return url[start..end]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const count = std.process.count(arguments)
    var url: []const u8 = ""
    var output: []const u8 = ""
    var k: usize = 1
    while k < count {
        const argument = std.string.asSlice(std.process.argument(arguments, k))
        if argument.length == 2 && argument[0] == 45 && argument[1] == 79 && k + 1 < count {
            k += 1
            output = std.string.asSlice(std.process.argument(arguments, k))
        } else if argument.length > 0 && argument[0] == 45 {
            say("wget: unknown option ")
            say(argument)
            say("\n")
            return 1
        } else {
            url = argument
        }
        k += 1
    }
    if url.length == 0 {
        say("usage: wget URL [-O FILE]\n")
        return 1
    }
    if output.length == 0 { output = nameOf(url) }
    const allocator = std.heap.allocator()
    var session: client.Session = undefined
    client.init(&session, allocator)
    var response: client.Response = undefined
    const outcome = client.get(&session, url, &response)
    if outcome != client.Error.none {
        say("wget: cannot fetch ")
        say(url)
        say(": ")
        say(errorText(outcome))
        // What more there is to say: why the connection was not made;
        // of a name that was not looked up, what stands in the way on
        // this machine's side.
        const more = if outcome == client.Error.connect { connectText(session.connectError) } else if outcome == client.Error.resolve { side.trouble() } else { "" }
        if more.length > 0 {
            say(if outcome == client.Error.connect { ": " } else { " (" })
            say(more)
            if outcome != client.Error.connect { say(")") }
        }
        say("\n")
        client.deinit(&session)
        return 1
    }
    if response.status >= 400 {
        say("wget: ")
        say(url)
        say(": the server answered ")
        sayNumber(@intCast(usize, response.status))
        say("\n")
        client.freeResponse(&session, &response)
        client.deinit(&session)
        return 1
    }
    const body = client.body(&response)
    var path: [4096]u8 = undefined
    if output.length >= 4096 {
        say("wget: the file name is too long\n")
        return 1
    }
    var c: usize = 0
    while c < output.length {
        path[c] = output[c]
        c += 1
    }
    path[output.length] = 0
    const pathPointer: [*]const u8 = &path
    if !std.fs.writeFile(pathPointer, body.pointer, body.length, 420) {
        say("wget: cannot write ")
        say(output)
        say("\n")
        client.freeResponse(&session, &response)
        client.deinit(&session)
        return 1
    }
    say("wget: ")
    say(output)
    say(": ")
    sayNumber(body.length)
    say(" bytes\n")
    client.freeResponse(&session, &response)
    client.deinit(&session)
    return 0
}
