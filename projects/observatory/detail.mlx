// The detail panel (part of main.mlx, split from it).
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const glyphs = @import("std.ui.glyphs")
const controls = @import("std.ui.controls")
const ui = @import("std.ui")
const text_module = @import("std.ui.text")
const index_module = @import("../../tools/codemap/index.mlx")
const analysis_module = @import("../../tools/codemap/analysis.mlx")
const programs_module = @import("../../tools/codemap/programs.mlx")
const structure_module = @import("../../tools/codemap/structure.mlx")
const graph_module = @import("./graph.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const drawing_module = @import("./drawing.mlx")
const actions_module = @import("./actions.mlx")
const demo_module = @import("./demo.mlx")

// ---------------------------------------------------------------------------
// The detail panel

// The doc comment's text (the `//` taken off), paragraphs apart by a
// newline, into out; how long.
pub fn docText(codemap: *app.Codemap, node: u32, out: [*]u8, capacity: usize) -> usize {
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return 0 }
    const index = codemap.*.index
    var start: usize = 0
    var size: usize = 0
    index_module.docRange(index, record.*.symbol, &start, &size)
    if size == 0 { return 0 }
    const source = index_module.sourceOf(index, index_module.symbolAt(index, record.*.symbol).*.file)
    var length: usize = 0
    var at = start
    const end = start + size
    while at < end {
        var line_end = at
        while line_end < end && source[line_end] != 10 { line_end += 1 }
        var from = at
        while from < line_end && (source[from] == 32 || source[from] == 9) { from += 1 }
        if from + 1 < line_end + 1 && from + 1 <= line_end && from < line_end && source[from] == 47 { from += 1 }
        if from < line_end && source[from] == 47 { from += 1 }
        if from < line_end && source[from] == 32 { from += 1 }
        if from >= line_end {
            // An empty comment line: a new paragraph.
            if length > 0 && length < capacity && out[length - 1] != 10 {
                out[length] = 10
                length += 1
            }
        } else {
            // An indented line (code in a comment) keeps its own line.
            const code_line = from < line_end && source[from] == 32
            if length > 0 && length < capacity && out[length - 1] != 10 {
                out[length] = if code_line { 10 } else { 32 }
                length += 1
            }
            var copy = from
            while copy < line_end && length < capacity {
                out[length] = source[copy]
                length += 1
                copy += 1
            }
            if code_line && length < capacity {
                out[length] = 10
                length += 1
            }
        }
        at = line_end + 1
    }
    while length > 0 && (out[length - 1] == 10 || out[length - 1] == 32) { length -= 1 }
    return length
}

// Draws `text` wrapped to `width` from (x, y), paragraphs at newlines, up
// to `most` lines; the height it took.
pub fn drawWrapped(codemap: *app.Codemap, canvas: *app.Canvas, text: []const u8, font: *app.Text, x: i32, y: i32, width: i32, color: u32, most: usize, line_height: i32) -> i32 {
    var lines: usize = 0
    var start: usize = 0
    var bottom = y
    while start < text.length && lines < most {
        // One line: as many words as fit.
        var end = start
        var fit_end = start
        while end < text.length && text[end] != 10 {
            var word_end = end
            while word_end < text.length && text[word_end] == 32 { word_end += 1 }
            while word_end < text.length && text[word_end] != 32 && text[word_end] != 10 { word_end += 1 }
            if text_module.measure(font, text[start..word_end]) > width && fit_end > start { break }
            fit_end = word_end
            end = word_end
            if text_module.measure(font, text[start..word_end]) > width { break }
        }
        if fit_end == start { fit_end = end }
        if fit_end == start && start < text.length { fit_end = start + 1 }
        const shown = text[start..fit_end]
        if bottom + line_height > app.TOOLBAR && bottom < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, font, shown, x, bottom, color, width) }
        bottom += line_height
        lines += 1
        start = fit_end
        while start < text.length && text[start] == 32 { start += 1 }
        if start < text.length && text[start] == 10 { start += 1 }
    }
    return bottom - y
}

pub fn addDetailRow(codemap: *app.Codemap, y: i32, node: u32, kind: u8) -> void {
    if codemap.*.detailRowCount >= app.DETAIL_ROWS { return }
    codemap.*.detailRows[codemap.*.detailRowCount] = node
    codemap.*.detailRowY[codemap.*.detailRowCount] = y
    codemap.*.detailRowKind[codemap.*.detailRowCount] = kind
    codemap.*.detailRowX[codemap.*.detailRowCount] = 0
    codemap.*.detailRowWidth[codemap.*.detailRowCount] = 0
    codemap.*.detailRowCount += 1
}

// A button in the detail panel (one of a row's); its width.
pub fn detailButton(codemap: *app.Codemap, canvas: *app.Canvas, label: []const u8, x: i32, y: i32, value: u32, kind: u8, primary: bool, enabled: bool) -> i32 {
    const width = text_module.measure(access_module.bodyOf(codemap), label) + 24
    const hit = app.HIT_ROW + codemap.*.detailRowCount
    if enabled && codemap.*.detailRowCount < app.DETAIL_ROWS {
        addDetailRow(codemap, y, value, kind)
        codemap.*.detailRowX[codemap.*.detailRowCount - 1] = x
        codemap.*.detailRowWidth[codemap.*.detailRowCount - 1] = width
    }
    if y + app.DETAIL_ROW > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS {
        const clicked = controls.button(access_module.uiOf(codemap), access_module.idOf(hit), ui.rect(x, y - 2, width, 28), label, if primary { controls.BUTTON_PRIMARY } else { controls.BUTTON_NORMAL }, enabled)
    }
    return width
}

// One row: the node's color, name, where it is and how often.
fn drawRelationRow(codemap: *app.Codemap, canvas: *app.Canvas, node: u32, count: u32, x: i32, y: i32, width: i32, accent: u32) -> void { drawRow(codemap, canvas, node, count, false, x, y, width, accent) }

// A row; `percent`: count is a share.
pub fn drawRow(codemap: *app.Codemap, canvas: *app.Canvas, node: u32, count: u32, percent: bool, x: i32, y: i32, width: i32, accent: u32) -> void {
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    var length: usize = 0
    if count > 1 || percent {
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, count))
        length = filters_module.writeText(bytes, length, if percent { "%" } else { "x" })
    }
    drawRowNote(codemap, canvas, node, bytes[0..length], x, y, width, accent)
}

// A row for a node: its dot, name and where it is, and `note` at the
// right (a count, a size).
pub fn drawRowNote(codemap: *app.Codemap, canvas: *app.Canvas, node: u32, note: []const u8, x: i32, y: i32, width: i32, accent: u32) -> void {
    const hit = app.HIT_ROW + codemap.*.detailRowCount
    addDetailRow(codemap, y, node, app.ROW_NODE)
    if y + app.DETAIL_ROW <= app.TOOLBAR || y >= access_module.surfaceHeight(codemap) - app.STATUS { return }
    if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x - 6, y, width + 12, app.DETAIL_ROW, 6, canvas_module.color(255, 48, 52, 64)) }
    glyphs.dot(canvas, x, y + 8, 8, filters_module.canvasColor(access_module.nodeOf(codemap, node).*.color, 255))
    if accent != 0 { canvas_module.fillRect(canvas, x - 6, y + 5, 2, app.DETAIL_ROW - 10, filters_module.canvasColor(accent, 255)) }
    const small = access_module.smallOf(codemap)
    var count_width: i32 = 0
    if note.length > 0 {
        count_width = text_module.measure(small, note)
        text_module.drawText(canvas, small, note, x + width - count_width, y + 5, app.DIM_COLOR, 0)
    }
    const name = access_module.nameOf(codemap, node)
    const name_room = width - 16 - count_width - 8
    text_module.drawText(canvas, access_module.bodyOf(codemap), name, x + 16, y + 4, app.TEXT_COLOR, name_room)
    const name_width = text_module.measure(access_module.bodyOf(codemap), name)
    const where = drawing_module.contextOf(codemap, node)
    const where_x = x + 16 + name_width + 8
    const room = x + width - count_width - 8 - where_x
    if room > 24 && where.length > 0 { text_module.drawText(canvas, small, where, where_x, y + 5, app.DIM_COLOR, room) }
}

// A section: its title and how many, the rows (the first few unless
// opened up), and a row to open it up.
pub fn drawSection(codemap: *app.Codemap, canvas: *app.Canvas, section: usize, title: []const u8, relations: [*]app.Relation, count: usize, kind: i32, accent: u32, x: i32, y: i32, width: i32) -> i32 {
    // Only relations of `kind` (-1: all).
    var total: usize = 0
    var at: usize = 0
    while at < count {
        if kind < 0 || @intCast(i32, relations[at].kind) == kind { total += 1 }
        at += 1
    }
    if total == 0 { return y }
    var row_y = y + 10
    var heading: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &heading) }
    var length = filters_module.writeText(bytes, 0, title)
    length = filters_module.writeText(bytes, length, "  ")
    length = filters_module.writeNumber(codemap, bytes, length, total)
    if row_y > app.TOOLBAR && row_y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x, row_y, if accent != 0 { filters_module.canvasColor(accent, 255) } else { app.DIM_COLOR }, 0) }
    row_y += 20
    const most = if codemap.*.expanded[section] { 400 } else { app.SECTION_ROWS }
    var shown: usize = 0
    at = 0
    while at < count && shown < most {
        if kind < 0 || @intCast(i32, relations[at].kind) == kind {
            drawRelationRow(codemap, canvas, relations[at].node, relations[at].count, x + 6, row_y, width - 6, accent)
            row_y += app.DETAIL_ROW
            shown += 1
        }
        at += 1
    }
    if shown < total {
        const hit = app.HIT_ROW + codemap.*.detailRowCount
        addDetailRow(codemap, row_y, @intCast(u32, section), app.ROW_MORE)
        if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x, row_y, width, app.DETAIL_ROW, 6, canvas_module.color(255, 48, 52, 64)) }
        length = filters_module.writeText(bytes, 0, "+ ")
        length = filters_module.writeNumber(codemap, bytes, length, total - shown)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
        if row_y > app.TOOLBAR && row_y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 22, row_y + 5, app.ACCENT, 0) }
        row_y += app.DETAIL_ROW
    }
    return row_y
}

// The members section: the node's children.
pub fn drawMembers(codemap: *app.Codemap, canvas: *app.Canvas, section: usize, title: []const u8, node: u32, x: i32, y: i32, width: i32) -> i32 {
    const record = access_module.nodeOf(codemap, node)
    if record.*.childCount == 0 { return y }
    var row_y = y + 10
    var heading: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &heading) }
    var length = filters_module.writeText(bytes, 0, title)
    length = filters_module.writeText(bytes, length, "  ")
    length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, record.*.childCount))
    if row_y > app.TOOLBAR && row_y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x, row_y, app.DIM_COLOR, 0) }
    row_y += 20
    const most = if codemap.*.expanded[section] { 400 } else { app.SECTION_ROWS }
    var shown: usize = 0
    var child = record.*.firstChild
    while child != app.NONE && shown < most {
        drawRelationRow(codemap, canvas, child, 0, x + 6, row_y, width - 6, 0)
        row_y += app.DETAIL_ROW
        shown += 1
        child = access_module.nodeOf(codemap, child).*.nextSibling
    }
    if shown < @intCast(usize, record.*.childCount) {
        const hit = app.HIT_ROW + codemap.*.detailRowCount
        addDetailRow(codemap, row_y, @intCast(u32, section), app.ROW_MORE)
        if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x, row_y, width, app.DETAIL_ROW, 6, canvas_module.color(255, 48, 52, 64)) }
        length = filters_module.writeText(bytes, 0, "+ ")
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, record.*.childCount) - shown)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
        if row_y > app.TOOLBAR && row_y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 22, row_y + 5, app.ACCENT, 0) }
        row_y += app.DETAIL_ROW
    }
    return row_y
}

// A group of symbols (copies, names) but `self`: the shown ones as rows.
pub fn drawSymbols(codemap: *app.Codemap, canvas: *app.Canvas, section: usize, title: []const u8, analysis: *analysis_module.Analysis, kind: u8, group: u32, self_symbol: u32, x: i32, y: i32, width: i32) -> i32 {
    if group == app.NONE { return y }
    const members = analysis_module.groupMembers(analysis, kind, @intCast(usize, group))
    var row_y = y + 10
    if row_y > app.TOOLBAR && row_y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), title, x, row_y, filters_module.canvasColor(app.FINDING_COLOR, 255), 0) }
    row_y += 20
    const most: usize = if codemap.*.expanded[section] { 400 } else { app.SECTION_ROWS }
    var shown: usize = 0
    for symbol in members {
        const node = access_module.nodeOfSymbol(codemap, symbol)
        if symbol != self_symbol && node != app.NONE && shown < most {
            drawRow(codemap, canvas, node, analysis_module.usesOf(analysis, symbol), false, x + 6, row_y, width - 6, app.FINDING_COLOR)
            row_y += app.DETAIL_ROW
            shown += 1
        }
    }
    if members.length - 1 > shown && !codemap.*.expanded[section] {
        addDetailRow(codemap, row_y, @intCast(u32, section), app.ROW_MORE)
        var text: [48]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = filters_module.writeText(bytes, 0, "+ ")
        length = filters_module.writeNumber(codemap, bytes, length, members.length - 1 - shown)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
        if row_y > app.TOOLBAR && row_y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 22, row_y + 5, app.ACCENT, 0) }
        row_y += app.DETAIL_ROW
    }
    return row_y
}

pub fn drawCloseButton(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const close_x = access_module.surfaceWidth(codemap) - 38
    // Back and forward (through what was selected), left of it.
    const off = canvas_module.color(255, 80, 84, 96)
    const back_x = access_module.surfaceWidth(codemap) - 104
    const forward_x = access_module.surfaceWidth(codemap) - 72
    if codemap.*.hover == app.HIT_BACK && codemap.*.backCount > 0 { canvas_module.fillRoundedRect(canvas, back_x, app.TOOLBAR + 10, 30, 28, 8, canvas_module.color(255, 60, 64, 78)) }
    if codemap.*.hover == app.HIT_FORWARD && codemap.*.forwardCount > 0 { canvas_module.fillRoundedRect(canvas, forward_x, app.TOOLBAR + 10, 30, 28, 8, canvas_module.color(255, 60, 64, 78)) }
    glyphs.chevron(canvas, back_x + 10, app.TOOLBAR + 17, true, if codemap.*.backCount > 0 { app.TEXT_COLOR } else { off }, 13, 3)
    glyphs.chevron(canvas, forward_x + 11, app.TOOLBAR + 17, false, if codemap.*.forwardCount > 0 { app.TEXT_COLOR } else { off }, 13, 3)
    canvas_module.fillRoundedRect(canvas, close_x, app.TOOLBAR + 10, 28, 28, 14, if codemap.*.hover == app.HIT_CLOSE { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 44, 47, 58) })
    var step: i32 = 0
    while step < 10 {
        canvas_module.fillRect(canvas, close_x + 9 + step, app.TOOLBAR + 19 + step, 2, 2, app.TEXT_COLOR)
        canvas_module.fillRect(canvas, close_x + 18 - step, app.TOOLBAR + 19 + step, 2, 2, app.TEXT_COLOR)
        step += 1
    }
}

// The list of findings: each group's heading (how many, what they have in
// common) and its members; unused declarations one by one.
pub fn drawFindings(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    if codemap.*.finding == app.FINDING_WORKAROUNDS || codemap.*.finding == app.FINDING_CRASHES {
        demo_module.drawKeptFindings(codemap, canvas)
        return
    }
    if codemap.*.finding >= app.FINDING_UNREACHABLE {
        drawMeasuredFindings(codemap, canvas)
        return
    }
    const analysis = access_module.analysisOf(codemap)
    const left = filters_module.detailX(codemap)
    const height = access_module.viewHeight(codemap)
    canvas_module.fillRect(canvas, left, app.TOOLBAR, app.DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, app.TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = app.DETAIL - 40
    var y = app.TOOLBAR + 18 - codemap.*.detailScroll
    const finding = codemap.*.finding
    const title = if finding == app.FINDING_COPIES { access_module.say(codemap, "Copies", "Kopien") } else if finding == app.FINDING_NAMES { access_module.say(codemap, "Written again", "Mehrfach geschrieben") } else { access_module.say(codemap, "Unused", "Ungenutzt") }
    const about = if finding == app.FINDING_COPIES {
        access_module.say(codemap, "Functions with the same body: exact copies, then copies but for names and values (one generic function could serve them). The most to gain first.", "Funktionen mit gleichem Rumpf: exakte Kopien, dann gleiche bis auf Namen und Werte (eine generische Funktion könnte sie ersetzen). Das meiste Einsparpotenzial zuerst.")
    } else if finding == app.FINDING_NAMES {
        access_module.say(codemap, "Functions of the same name in several files: helpers each file wrote again, candidates for one shared version.", "Funktionen gleichen Namens in mehreren Dateien: Helfer, die jede Datei neu geschrieben hat, Kandidaten für eine gemeinsame Version.")
    } else {
        access_module.say(codemap, "Declarations nothing uses (generated code aside).", "Deklarationen, die nichts verwendet (erzeugter Code ausgenommen).")
    }
    y += drawWrapped(codemap, canvas, title, access_module.titleOf(codemap), x, y, width - 100, app.TEXT_COLOR, 1, 22)
    y += 4
    y += drawWrapped(codemap, canvas, about, access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 6, 17)
    y += 8
    const most_groups: usize = if codemap.*.expanded[0] { codemap.*.findingCount } else { 40 }
    var at: usize = 0
    while at < codemap.*.findingCount && at < most_groups {
        const entry = codemap.*.findingOrder[at]
        if finding == app.FINDING_UNUSED {
            const node = access_module.nodeOfSymbol(codemap, entry)
            if node != app.NONE {
                drawRow(codemap, canvas, node, 0, false, x + 6, y, width - 6, 0)
                y += app.DETAIL_ROW
            }
        } else {
            const kind = access_module.findingEntryKind(entry)
            const group = access_module.findingEntryGroup(entry)
            const members = analysis_module.groupMembers(analysis, kind, group)
            var heading: [160]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &heading) }
            var length = filters_module.writeNumber(codemap, bytes, 0, members.length)
            if kind == analysis_module.NAMES {
                length = filters_module.writeText(bytes, length, "x ")
                length = filters_module.writeText(bytes, length, index_module.nameOf(codemap.*.index, members[0]))
            } else {
                length = filters_module.writeText(bytes, length, if kind == analysis_module.COPIES { access_module.say(codemap, " exact copies, ", " exakte Kopien, ") } else { access_module.say(codemap, " alike, ", " gleichartig, ") })
                length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, analysis_module.bodySize(analysis, members[0])))
                length = filters_module.writeText(bytes, length, access_module.say(codemap, " tokens each", " Tokens je"))
            }
            y += 8
            if y > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x, y, filters_module.canvasColor(app.FINDING_COLOR, 255), width) }
            y += 20
            var shown: usize = 0
            for symbol in members {
                const node = access_module.nodeOfSymbol(codemap, symbol)
                if node != app.NONE && !filters_module.isHidden(codemap, node) && shown < 12 {
                    drawRow(codemap, canvas, node, analysis_module.usesOf(analysis, symbol), false, x + 6, y, width - 6, app.FINDING_COLOR)
                    y += app.DETAIL_ROW
                    shown += 1
                }
            }
            if members.length > shown && shown == 12 {
                var more: [48]u8 = undefined
                var more_bytes: [*]u8 = undefined
                unsafe { more_bytes = @ptrCast([*]u8, &more) }
                var more_length = filters_module.writeText(more_bytes, 0, "+ ")
                more_length = filters_module.writeNumber(codemap, more_bytes, more_length, members.length - shown)
                more_length = filters_module.writeText(more_bytes, more_length, access_module.say(codemap, " more", " weitere"))
                if y > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), more_bytes[0..more_length], x + 22, y + 4, app.DIM_COLOR, 0) }
                y += app.DETAIL_ROW
            }
        }
        at += 1
    }
    if at < codemap.*.findingCount {
        addDetailRow(codemap, y, 0, app.ROW_MORE)
        var more: [48]u8 = undefined
        var more_bytes: [*]u8 = undefined
        unsafe { more_bytes = @ptrCast([*]u8, &more) }
        var more_length = filters_module.writeText(more_bytes, 0, "+ ")
        more_length = filters_module.writeNumber(codemap, more_bytes, more_length, codemap.*.findingCount - at)
        more_length = filters_module.writeText(more_bytes, more_length, access_module.say(codemap, " more", " weitere"))
        if y > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), more_bytes[0..more_length], x + 22, y + 5, app.ACCENT, 0) }
        y += app.DETAIL_ROW
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - app.TOOLBAR + 20
    drawCloseButton(codemap, canvas)
}

// The workarounds by what is missing, each with the declarations it is
// written in (the most places first); or the crashes, newest first, with
// the functions each went through.
// What a measured finding is (a slice returned, not assigned: the
// compiler keeps an assigned slice's old length).
fn measuredAbout(codemap: *app.Codemap, finding: u8) -> []const u8 {
    if finding == app.FINDING_UNREACHABLE {
        return access_module.say(codemap, "Functions no program and no check reaches from its main (nor are they in a binary): dead code, however often other dead code uses it. Calls through function pointers set at run time are not seen. Biggest first.", "Funktionen, die kein Programm und kein Check von seinem main aus erreicht (und die in keiner Binary stecken): toter Code, wie oft anderer toter Code sie auch verwendet. Aufrufe über zur Laufzeit gesetzte Funktionszeiger sieht die Karte nicht. Die größten zuerst.")
    } else if finding == app.FINDING_UNTESTED {
        return access_module.say(codemap, "Functions a program reaches and no check does (tests/, check_*.mlx, test blocks, what the check scripts build). The most complex first.", "Funktionen, die ein Programm erreicht, aber kein Check (tests/, check_*.mlx, test-Blöcke, was die Check-Skripte bauen). Die komplexesten zuerst.")
    } else if finding == app.FINDING_COMPLEX {
        return access_module.say(codemap, "Functions hard to follow: 15 branches or more, blocks 6 deep, or 1500 tokens. Candidates for splitting up.", "Schwer zu überblickende Funktionen: 15 Verzweigungen und mehr, 6 Ebenen tief oder 1500 Tokens. Kandidaten zum Aufteilen.")
    } else if finding == app.FINDING_RISKY {
        return access_module.say(codemap, "Functions most likely to break: crashes, workarounds, commits, complexity, copies and missing checks together (tools/codemap/measures.mlx).", "Funktionen, die am ehesten brechen: Abstürze, Workarounds, Commits, Komplexität, Kopien und fehlende Checks zusammen (tools/codemap/measures.mlx).")
    } else if finding == app.FINDING_CHANGED {
        return access_module.say(codemap, "Declarations added (first) and changed since the base (--diff REV; without it HEAD: what is not committed yet), by the files Git names as changed. The ones removed are listed at the end.", "Deklarationen, die seit der Basis hinzugekommen (zuerst) oder geändert sind (--diff REV; ohne das HEAD: was noch nicht committet ist), in den Dateien, die Git als geändert nennt. Die entfernten stehen am Ende.")
    } else if finding == app.FINDING_HOT {
        return access_module.say(codemap, "Where the programs spend their time, from the profiles of mlx-profile (tools/profile): samples in each function with what it calls.", "Wo die Programme ihre Zeit verbringen, aus den Profilen von mlx-profile (tools/profile): Samples je Funktion mit dem, was sie aufruft.")
    } else {
        return access_module.say(codemap, "Files that import each other, round about, and imports the rules forbid (codemap.layers at the root; without it: std imports nothing outside std, the compiler nothing from examples, tools, experiments or tests).", "Dateien, die einander reihum importieren, und Importe, die die Regeln verbieten (codemap.layers im Wurzelordner; ohne sie: std importiert nichts außerhalb von std, der Compiler nichts aus examples, tools, experiments oder tests).")
    }
}

// The findings measured: dead code, untested, complex, risky and hot
// functions (most first, with their measure), and the structure (cycles,
// imports against the rules).
fn drawMeasuredFindings(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const left = filters_module.detailX(codemap)
    const height = access_module.viewHeight(codemap)
    canvas_module.fillRect(canvas, left, app.TOOLBAR, app.DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, app.TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = app.DETAIL - 40
    var y = app.TOOLBAR + 18 - codemap.*.detailScroll
    const finding = codemap.*.finding
    const bottom = access_module.surfaceHeight(codemap) - app.STATUS
    const color = access_module.findingColor(finding)
    const about = measuredAbout(codemap, finding)
    y += drawWrapped(codemap, canvas, drawing_module.findingLabel(codemap, finding), access_module.titleOf(codemap), x, y, width - 100, app.TEXT_COLOR, 1, 22)
    y += 4
    y += drawWrapped(codemap, canvas, about, access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 8, 17)
    y += 8
    if finding == app.FINDING_HOT { y = actions_module.drawProfileBlock(codemap, canvas, x, y, width) }
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const most: usize = if codemap.*.expanded[0] { codemap.*.findingCount } else { 60 }
    var at: usize = 0
    while at < codemap.*.findingCount && at < most {
        const entry = codemap.*.findingOrder[at]
        if finding == app.FINDING_STRUCTURE {
            const structure = access_module.structureOf(codemap)
            if entry & 2147483648 == 0 {
                const members = structure_module.cycleMembers(structure, @intCast(usize, entry))
                var length = filters_module.writeNumber(codemap, bytes, 0, members.length)
                length = filters_module.writeText(bytes, length, access_module.say(codemap, " files import each other", " Dateien importieren einander"))
                y += 8
                if y > app.TOOLBAR && y < bottom { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x, y, filters_module.canvasColor(color, 255), width) }
                y += 20
                for file in members {
                    const node = filters_module.fileNode(codemap, file)
                    if node != app.NONE {
                        drawRowNote(codemap, canvas, node, "", x + 6, y, width - 6, app.STRUCTURE_COLOR)
                        y += app.DETAIL_ROW
                    }
                }
            } else {
                const broken = @intCast(usize, entry & 2147483647)
                const import = @intCast(usize, structure.*.broken[broken])
                const rule = @intCast(usize, structure.*.brokenRule[broken])
                var length = filters_module.writeText(bytes, 0, programs_module.relativePath(codemap.*.index, structure.*.importFrom[import]))
                length = filters_module.writeText(bytes, length, access_module.say(codemap, " imports ", " importiert "))
                length = filters_module.writeText(bytes, length, programs_module.relativePath(codemap.*.index, structure.*.importTo[import]))
                length = filters_module.writeText(bytes, length, " (")
                length = filters_module.writeText(bytes, length, structure_module.ruleFrom(structure, rule))
                length = filters_module.writeText(bytes, length, " !-> ")
                length = filters_module.writeText(bytes, length, structure_module.ruleTo(structure, rule))
                length = filters_module.writeText(bytes, length, ")")
                y += 8
                y += drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.RISKY_COLOR, 255), 3, 17)
                const node = filters_module.fileNode(codemap, structure.*.importFrom[import])
                if node != app.NONE {
                    drawRowNote(codemap, canvas, node, "", x + 6, y, width - 6, app.STRUCTURE_COLOR)
                    y += app.DETAIL_ROW
                }
            }
        } else {
            const node = access_module.nodeOfSymbol(codemap, entry)
            if node != app.NONE {
                const length = demo_module.writeMeasure(codemap, bytes, finding, entry)
                drawRowNote(codemap, canvas, node, bytes[0..length], x + 6, y, width - 6, color)
                y += app.DETAIL_ROW
            }
        }
        at += 1
    }
    if at < codemap.*.findingCount {
        addDetailRow(codemap, y, 0, app.ROW_MORE)
        var length = filters_module.writeText(bytes, 0, "+ ")
        length = filters_module.writeNumber(codemap, bytes, length, codemap.*.findingCount - at)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
        if y > app.TOOLBAR && y < bottom { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 22, y + 5, app.ACCENT, 0) }
        y += app.DETAIL_ROW
    }
    if codemap.*.findingCount == 0 && y > app.TOOLBAR && y < bottom {
        text_module.drawText(canvas, access_module.bodyOf(codemap), access_module.say(codemap, "None in what is shown.", "Keine in dem, was gezeigt ist."), x, y + 4, app.DIM_COLOR, width)
        y += 24
    }
    if finding == app.FINDING_CHANGED { y = drawRemoved(codemap, canvas, x, y, width, bottom) }
    codemap.*.detailHeight = y + codemap.*.detailScroll - app.TOOLBAR + 20
    drawCloseButton(codemap, canvas)
}

// The declarations removed since the base (they have no place on the map):
// "- path:line name".
fn drawRemoved(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32, bottom: i32) -> i32 {
    const diff = access_module.diffOf(codemap)
    if !diff.*.hasBefore || diff.*.removedCount == 0 { return top }
    const before = diff.*.before
    var y = top + 8
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeNumber(codemap, bytes, 0, diff.*.removedCount)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " removed", " entfernt"))
    if y > app.TOOLBAR && y < bottom { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x, y, filters_module.canvasColor(app.CHANGED_COLOR, 255), width) }
    y += 20
    var at: usize = 0
    while at < diff.*.removedCount && at < 40 {
        const symbol = diff.*.removed[at] & 2147483647
        const record = index_module.symbolAt(before, symbol)
        length = filters_module.writeText(bytes, 0, "- ")
        length = filters_module.writeText(bytes, length, index_module.nameOf(before, symbol))
        length = filters_module.writeText(bytes, length, "  ")
        length = filters_module.writeText(bytes, length, programs_module.relativePath(before, record.*.file))
        length = filters_module.writeText(bytes, length, ":")
        length = filters_module.writeNumber(codemap, bytes, length, index_module.lineOf(before, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
        if y > app.TOOLBAR && y < bottom { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 6, y, app.DIM_COLOR, width - 6) }
        y += 18
        at += 1
    }
    return y
}
