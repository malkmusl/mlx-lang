// ---------------------------------------------------------------------------
// Drawing

fn drawButton(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, width: i32, hit: usize) -> void {
    const top = (app.TOOLBAR - app.BUTTON) / 2
    if codemap.*.hover == hit { canvas_module.fillRoundedRect(canvas, x, top, width, app.BUTTON, 8, canvas_module.color(255, 50, 54, 66)) }
}

// A bookmark: a band with a notch at its foot.
fn drawBookmark(canvas: *app.Canvas, x: i32, y: i32, color: u32) -> void {
    canvas_module.fillRect(canvas, x, y, 10, 11, color)
    var step: i32 = 0
    while step < 5 {
        canvas_module.fillRect(canvas, x, y + 11 + step, 5 - step, 1, color)
        canvas_module.fillRect(canvas, x + 5 + step, y + 11 + step, 5 - step, 1, color)
        step += 1
    }
}

pub fn drawDot(canvas: *app.Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, size, size, size / 2, color)
}

pub fn drawToolbar(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const width = access_module.surfaceWidth(codemap)
    canvas_module.fillRect(canvas, app.SIDEBAR, 0, width - app.SIDEBAR, app.TOOLBAR, canvas_module.color(255, 36, 38, 47))
    canvas_module.fillRect(canvas, app.SIDEBAR, app.TOOLBAR - 1, width - app.SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    const top = (app.TOOLBAR - app.BUTTON) / 2
    // What is selected (else what the camera is on); in the editor, the
    // file shown.
    const title_x = app.SIDEBAR + 18
    const shown = if codemap.*.selected != app.NONE { codemap.*.selected } else { codemap.*.focus }
    const title = if codemap.*.view == app.VIEW_EDITOR && tabs_module.hasTab(codemap) { tabs_module.tabRelative(codemap, codemap.*.activeTab) } else if codemap.*.built && shown != app.NONE { access_module.nameOf(codemap, shown) } else { "Observatory" }
    const title_room = project_module.buildX(codemap) - title_x - 12
    project_module.drawBuild(codemap, canvas, top)
    // A path too long for its room loses its first folders ("…/" for them).
    var from: usize = 0
    if codemap.*.view == app.VIEW_EDITOR && canvas_module.measure(access_module.titleOf(codemap), title) > title_room {
        const dots = canvas_module.measure(access_module.titleOf(codemap), "…/")
        var at: usize = 0
        while at < title.length && canvas_module.measure(access_module.titleOf(codemap), title[from..title.length]) + dots > title_room {
            if title[at] == 47 { from = at + 1 }
            at += 1
        }
    }
    if title_room > 20 && from > 0 {
        const dots = canvas_module.measure(access_module.titleOf(codemap), "…/")
        canvas_module.drawText(canvas, access_module.titleOf(codemap), "…/", title_x, (app.TOOLBAR - 17) / 2, app.DIM_COLOR, 0)
        canvas_module.drawText(canvas, access_module.titleOf(codemap), title[from..title.length], title_x + dots, (app.TOOLBAR - 17) / 2, app.TEXT_COLOR, title_room - dots)
    } else if title_room > 20 {
        canvas_module.drawText(canvas, access_module.titleOf(codemap), title, title_x, (app.TOOLBAR - 17) / 2, app.TEXT_COLOR, title_room)
    }
    // The base Changed compares with (a list of commits opens).
    const base_x = input_module.baseX(codemap)
    var base_text: [64]u8 = undefined
    var base_bytes: [*]u8 = undefined
    unsafe { base_bytes = @ptrCast([*]u8, &base_text) }
    const base_length = input_module.writeBaseLabel(codemap, base_bytes)
    const base_lit = codemap.*.hover == app.HIT_BASE || codemap.*.popup == app.POPUP_BASE
    canvas_module.fillRoundedRect(canvas, base_x, top, input_module.baseWidth(codemap), app.BUTTON, 8, if base_lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    drawDot(canvas, base_x + 10, top + 11, 8, filters_module.canvasColor(app.CHANGED_COLOR, 255))
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), base_bytes[0..base_length], base_x + 24, top + 7, app.TEXT_COLOR, 0)
    var pill_text: [32]u8 = undefined
    var pill_bytes: [*]u8 = undefined
    unsafe { pill_bytes = @ptrCast([*]u8, &pill_text) }
    const pill_length = input_module.writeChangesPill(codemap, pill_bytes)
    if pill_length > 0 {
        const pill_x = base_x + 30 + canvas_module.measure(access_module.bodyOf(codemap), base_bytes[0..base_length])
        const pill_width = input_module.changesPillWidth(codemap) - 8
        canvas_module.fillRoundedRect(canvas, pill_x, top + 6, pill_width, app.BUTTON - 12, 8, filters_module.canvasColor(app.TYPE_COLOR, 70))
        canvas_module.drawText(canvas, access_module.smallOf(codemap), pill_bytes[0..pill_length], pill_x + 6, top + 8, app.TEXT_COLOR, 0)
    }
    drawArrow(canvas, base_x + input_module.baseWidth(codemap) - 16, top + 10, true, app.DIM_COLOR)
    // The query builder (a list of words opens) and keeping the query as a
    // view (a bookmark, lit when there is a query to keep).
    const filter_x = input_module.filterX(codemap)
    const filter_lit = codemap.*.hover == app.HIT_FILTER || codemap.*.popup == app.POPUP_FILTER
    canvas_module.fillRoundedRect(canvas, filter_x, top, input_module.filterWidth(codemap), app.BUTTON, 8, if filter_lit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), input_module.filterLabel(codemap), filter_x + 12, top + 7, app.TEXT_COLOR, 0)
    drawArrow(canvas, filter_x + input_module.filterWidth(codemap) - 16, top + 10, true, app.DIM_COLOR)
    const keep_x = input_module.keepX(codemap)
    const can_keep = codemap.*.queryActive && !(access_module.searchText(codemap).length > 0 && access_module.searchText(codemap)[0] == 64)
    if codemap.*.hover == app.HIT_KEEP && can_keep { canvas_module.fillRoundedRect(canvas, keep_x, top, app.BUTTON, app.BUTTON, 8, canvas_module.color(255, 72, 76, 92)) }
    drawBookmark(canvas, keep_x + 10, top + 7, if can_keep { filters_module.canvasColor(app.CHANGED_COLOR, 255) } else { canvas_module.color(255, 80, 84, 96) })
    // The search field.
    const search_x = input_module.searchX(codemap)
    canvas_module.fillRoundedRect(canvas, search_x, top, app.SEARCH_WIDTH, app.BUTTON, 8, canvas_module.color(255, 26, 28, 35))
    if codemap.*.searchFocused { canvas_module.strokeRoundedRect(canvas, search_x - 1, top - 1, app.SEARCH_WIDTH + 2, app.BUTTON + 2, 9, 2, app.ACCENT) }
    canvas_module.drawSearchGlyph(canvas, search_x + 10, top + 8, app.DIM_COLOR)
    const search = access_module.searchText(codemap)
    const text_x = search_x + 32
    if search.length == 0 {
        if !codemap.*.searchFocused { canvas_module.drawText(canvas, access_module.bodyOf(codemap), access_module.say(codemap, "Search code", "Code durchsuchen"), text_x, top + 7, app.DIM_COLOR, 0) }
    } else {
        // A query: how many answer it at the right (red when a word is not
        // understood).
        var note_width: i32 = 0
        if codemap.*.queryActive || codemap.*.queryBad {
            var digits: [24]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &digits) }
            const length = if codemap.*.queryBad { filters_module.writeText(bytes, 0, "?") } else { filters_module.writeNumber(codemap, bytes, 0, codemap.*.queryCount) }
            note_width = canvas_module.measure(access_module.smallOf(codemap), bytes[0..length]) + 10
            canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], search_x + app.SEARCH_WIDTH - note_width, top + 8, if codemap.*.queryBad { filters_module.canvasColor(app.CRASH_COLOR, 255) } else { filters_module.canvasColor(app.CHANGED_COLOR, 255) }, 0)
        }
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), search, text_x, top + 7, if codemap.*.queryBad { filters_module.canvasColor(app.CRASH_COLOR, 255) } else { app.TEXT_COLOR }, app.SEARCH_WIDTH - 40 - note_width)
    }
    if codemap.*.searchFocused {
        const caret_x = text_x + canvas_module.measure(access_module.bodyOf(codemap), search)
        if caret_x < search_x + app.SEARCH_WIDTH - 8 { canvas_module.fillRect(canvas, caret_x + 1, top + 7, 2, 16, app.ACCENT) }
    }
}

// Where `node` is: its file's name, or its group's.
pub fn contextOf(codemap: *app.Codemap, node: u32) -> []const u8 {
    const record = access_module.nodeOf(codemap, node)
    if record.*.parent == app.NONE { return "" }
    if record.*.kind == graph_module.DECLARATION {
        const parent = access_module.nodeOf(codemap, record.*.parent)
        if parent.*.kind == graph_module.DECLARATION { return access_module.nameOf(codemap, record.*.parent) }
        return access_module.nameOf(codemap, record.*.parent)
    }
    return access_module.nameOf(codemap, record.*.parent)
}

pub fn drawResults(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    if !input_module.resultsShown(codemap) { return }
    const slide = fadeIn(codemap, canvas, app.OVERLAY_RESULTS, 1)
    const x = input_module.resultsX(codemap)
    const top = app.TOOLBAR - 4 - slide
    const rows = if codemap.*.resultCount > 0 { @intCast(i32, codemap.*.resultCount) } else { 1 }
    const height = rows * app.RESULT_ROW + 12
    canvas_module.fillRoundedRect(canvas, x + 2, top + 4, input_module.resultsWidth(), height, 10, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, top, input_module.resultsWidth(), height, 10, canvas_module.color(250, 32, 34, 43))
    canvas_module.strokeRoundedRect(canvas, x, top, input_module.resultsWidth(), height, 10, 1, canvas_module.color(255, 58, 62, 76))
    if codemap.*.resultCount == 0 {
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), access_module.say(codemap, "Nothing found", "Nichts gefunden"), x + 16, top + 13, app.DIM_COLOR, 0)
        return
    }
    var at: usize = 0
    while at < codemap.*.resultCount {
        const node = codemap.*.results[at]
        const y = top + 6 + @intCast(i32, at) * app.RESULT_ROW
        if at == codemap.*.resultCursor {
            canvas_module.fillRoundedRect(canvas, x + 6, y, input_module.resultsWidth() - 12, app.RESULT_ROW, 7, canvas_module.color(255, 52, 78, 130))
        } else if codemap.*.hover == app.HIT_RESULT + at {
            canvas_module.fillRoundedRect(canvas, x + 6, y, input_module.resultsWidth() - 12, app.RESULT_ROW, 7, canvas_module.color(255, 46, 49, 60))
        }
        drawDot(canvas, x + 16, y + 10, 10, filters_module.canvasColor(access_module.nodeOf(codemap, node).*.color, 255))
        const name = access_module.nameOf(codemap, node)
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), name, x + 34, y + 7, app.TEXT_COLOR, input_module.resultsWidth() - 200)
        const name_width = canvas_module.measure(access_module.bodyOf(codemap), name)
        const where = if access_module.nodeOf(codemap, node).*.kind == graph_module.DIRECTORY { filters_module.kindLabel(codemap, node) } else { graph_module.pathOf(access_module.graphOf(codemap), node) }
        const where_x = x + 34 + (if name_width < input_module.resultsWidth() - 200 { name_width } else { input_module.resultsWidth() - 200 }) + 12
        const room = x + input_module.resultsWidth() - 14 - where_x
        if room > 30 {
            // The end of a long path (a new slice: assigning one to a
            // slice variable would keep its old length).
            var cut: usize = 0
            while where.length - cut > 4 && canvas_module.measure(access_module.smallOf(codemap), where[cut..where.length]) > room { cut += 1 }
            const tail = where[cut..where.length]
            canvas_module.drawText(canvas, access_module.smallOf(codemap), tail, x + input_module.resultsWidth() - 14 - canvas_module.measure(access_module.smallOf(codemap), tail), y + 8, app.DIM_COLOR, 0)
        }
        at += 1
    }
}

fn isOnPath(codemap: *app.Codemap, node: u32) -> bool {
    const subject = if codemap.*.selected != app.NONE { codemap.*.selected } else { codemap.*.focus }
    if subject == app.NONE { return false }
    return graph_module.isUnder(access_module.graphOf(codemap), subject, node)
}

// The sidebar's groups: the whole, the top-level groups, and the groups
// inside those on the way to what is selected.
fn addSidebarRows(codemap: *app.Codemap, parent: u32, indent: i32) -> void {
    var child = access_module.nodeOf(codemap, parent).*.firstChild
    while child != app.NONE && codemap.*.sidebarCount < app.SIDEBAR_ROWS {
        const record = access_module.nodeOf(codemap, child)
        if record.*.kind == graph_module.DIRECTORY {
            codemap.*.sidebarNodes[codemap.*.sidebarCount] = child
            codemap.*.sidebarIndent[codemap.*.sidebarCount] = indent
            codemap.*.sidebarCount += 1
            if isOnPath(codemap, child) { addSidebarRows(codemap, child, indent + 1) }
        }
        child = record.*.nextSibling
    }
}

// A check box (14 pixels): 0 empty, 1 ticked, 2 in part (a dash), in
// `color` when not empty.
fn drawCheck(canvas: *app.Canvas, x: i32, y: i32, state: u8, color: u32) -> void {
    if state == 0 {
        canvas_module.fillRoundedRect(canvas, x, y, 14, 14, 4, canvas_module.color(255, 96, 101, 118))
        canvas_module.fillRoundedRect(canvas, x + 1, y + 1, 12, 12, 3, canvas_module.color(255, 30, 32, 41))
        return
    }
    canvas_module.fillRoundedRect(canvas, x, y, 14, 14, 4, color)
    const mark = canvas_module.color(255, 255, 255, 255)
    if state == 2 {
        canvas_module.fillRect(canvas, x + 3, y + 6, 8, 2, mark)
        return
    }
    var step: i32 = 0
    while step < 3 {
        canvas_module.fillRect(canvas, x + 3 + step, y + 6 + step, 2, 2, mark)
        step += 1
    }
    step = 0
    while step < 6 {
        canvas_module.fillRect(canvas, x + 5 + step, y + 8 - step, 2, 2, mark)
        step += 1
    }
}

// A view setting: a check box and its name, two to a row.
fn drawToggle(codemap: *app.Codemap, canvas: *app.Canvas, index: usize, label: []const u8, on: bool) -> void {
    const x = 16 + @intCast(i32, index % 2) * 100
    const y = codemap.*.toggleTop + @intCast(i32, index / 2) * 20
    if codemap.*.hover == app.HIT_TOGGLE + index { canvas_module.fillRoundedRect(canvas, x - 4, y - 3, 98, 19, 5, canvas_module.color(255, 42, 45, 56)) }
    drawCheck(canvas, x, y - 1, if on { 1 } else { 0 }, app.ACCENT)
    canvas_module.drawText(canvas, access_module.smallOf(codemap), label, x + 19, y, if on { canvas_module.color(255, 190, 194, 204) } else { app.DIM_COLOR }, 76)
}

// A section's heading at y; the y below it.
// A section's heading: its name and an arrow (down: open, right:
// folded up); a click folds it up or opens it.
fn drawHeading(codemap: *app.Codemap, canvas: *app.Canvas, section: usize, label: []const u8, y: i32) -> i32 {
    codemap.*.headingY[section] = y
    const lit = codemap.*.hover == app.HIT_HEADING + section
    if lit { canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, 20, 6, canvas_module.color(255, 36, 39, 49)) }
    canvas_module.drawText(canvas, access_module.smallOf(codemap), label, 18, y + 4, if lit { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
    drawArrow(canvas, app.SIDEBAR - 28, y + 5, !codemap.*.sectionFolded[section], if lit { app.TEXT_COLOR } else { app.DIM_COLOR })
    return y + 26
}

// A small arrow: down (open) or right.
pub fn drawArrow(canvas: *app.Canvas, x: i32, y: i32, down: bool, color: u32) -> void {
    var step: i32 = 0
    while step < 4 {
        if down {
            canvas_module.fillRect(canvas, x + step, y + 3 + step, 8 - 2 * step, 1, color)
        } else {
            canvas_module.fillRect(canvas, x + 2 + step, y + 2 + step, 1, 8 - 2 * step, color)
        }
        step += 1
    }
}

fn isFolded(codemap: *app.Codemap, section: usize) -> bool { return codemap.*.sectionFolded[section] }

// Folds a section up or opens it (kept in
// $XDG_CONFIG_HOME/mlx/observatory-sections).
pub fn toggleSection(codemap: *app.Codemap, section: usize) -> void {
    codemap.*.sectionFolded[section] = !codemap.*.sectionFolded[section]
    if codemap.*.trace {
        var text: [32]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = lists_module.writeNumberPlain(bytes, 0, section)
        length = filters_module.writeText(bytes, length, if codemap.*.sectionFolded[section] { " folded" } else { " opened" })
        navigation_module.traceLine(codemap, "section ", bytes[0..length])
    }
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    const length = sectionsPath(codemap, bytes)
    if length == 0 { return }
    var text: [8]u8 = undefined
    var at: usize = 0
    while at < app.SECTIONS {
        text[at] = if codemap.*.sectionFolded[at] { 49 } else { 48 }
        at += 1
    }
    const file = std.fs.open(bytes, 577, 420)
    if !std.fs.isValid(file) { return }
    var text_bytes: [*]u8 = undefined
    unsafe { text_bytes = @ptrCast([*]u8, &text) }
    const wrote = std.fs.writeAllBytes(file, text_bytes, app.SECTIONS)
    const closed = std.fs.close(file)
}

// $XDG_CONFIG_HOME/mlx/observatory-sections (else ~/.config/...), the
// directories made; its length (0: no home).
fn sectionsPath(codemap: *app.Codemap, into: [*]u8) -> usize {
    var length: usize = 0
    const config = apps_module.environmentValue(codemap.*.environment, "XDG_CONFIG_HOME")
    if @intFromPtr(config) != 0 && config[0] == 47 {
        length = filters_module.writeText(into, 0, std.text.cString(config))
    } else {
        const home = apps_module.environmentValue(codemap.*.environment, "HOME")
        if @intFromPtr(home) == 0 || home[0] == 0 { return 0 }
        length = filters_module.writeText(into, 0, std.text.cString(home))
        length = filters_module.writeText(into, length, "/.config")
    }
    into[length] = 0
    const made = std.linux.syscall2(83, @intFromPtr(into), 493)
    length = filters_module.writeText(into, length, "/mlx")
    into[length] = 0
    const made_mlx = std.linux.syscall2(83, @intFromPtr(into), 493)
    length = filters_module.writeText(into, length, "/observatory-sections")
    into[length] = 0
    return length
}

pub fn loadSections(codemap: *app.Codemap) -> void {
    var at: usize = 0
    while at < 8 {
        codemap.*.sectionFolded[at] = false
        codemap.*.headingY[at] = app.AWAY
        at += 1
    }
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    if sectionsPath(codemap, bytes) == 0 { return }
    const file = std.fs.open(bytes, 0, 0)
    if !std.fs.isValid(file) { return }
    var text: [8]u8 = undefined
    var text_bytes: [*]u8 = undefined
    unsafe { text_bytes = @ptrCast([*]u8, &text) }
    const got = std.fs.read(file, text_bytes, 8)
    const closed = std.fs.close(file)
    at = 0
    while got > 0 && at < app.SECTIONS && at < @intCast(usize, got) {
        codemap.*.sectionFolded[at] = text[at] == 49
        at += 1
    }
}

// The sidebar, top to bottom (it scrolls when it is taller than the
// window): the groups, the program shown, the findings, what the spheres
// are colored by, the view settings and the kinds.
pub fn drawSidebar(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const height = access_module.surfaceHeight(codemap)
    canvas_module.fillRect(canvas, 0, 0, app.SIDEBAR, height, canvas_module.color(214, 26, 28, 36))
    canvas_module.fillRect(canvas, app.SIDEBAR - 1, 0, 1, height, canvas_module.color(255, 18, 19, 25))
    const small = access_module.smallOf(codemap)
    const body = access_module.bodyOf(codemap)
    if codemap.*.sidebarScroll > codemap.*.sidebarHeight - height { codemap.*.sidebarScroll = codemap.*.sidebarHeight - height }
    if codemap.*.sidebarScroll < 0 { codemap.*.sidebarScroll = 0 }
    var y: i32 = 18 - codemap.*.sidebarScroll
    // What the middle shows: the galaxy or the editor.
    y = drawHeading(codemap, canvas, app.SECTION_VIEW, access_module.say(codemap, "View", "Ansicht"), y)
    codemap.*.viewSwitchY = app.AWAY
    if !isFolded(codemap, app.SECTION_VIEW) {
        drawViewSwitch(codemap, canvas, y)
        y += 34
    }
    y += 2
    y = drawHeading(codemap, canvas, app.SECTION_GROUPS, access_module.say(codemap, "Groups", "Gruppen"), y)
    codemap.*.sidebarCount = 0
    if codemap.*.built {
        const root = access_module.graphOf(codemap).*.root
        codemap.*.sidebarNodes[0] = root
        codemap.*.sidebarIndent[0] = 0
        codemap.*.sidebarCount = 1
        addSidebarRows(codemap, root, 0)
    }
    const subject = if codemap.*.selected != app.NONE { codemap.*.selected } else { codemap.*.focus }
    var index: usize = 0
    if isFolded(codemap, app.SECTION_GROUPS) {
        while index < codemap.*.sidebarCount {
            codemap.*.sidebarRowY[index] = app.AWAY
            index += 1
        }
    }
    while index < codemap.*.sidebarCount {
        const node = codemap.*.sidebarNodes[index]
        const record = access_module.nodeOf(codemap, node)
        codemap.*.sidebarRowY[index] = y
        if node == subject {
            canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.GROUP_ROW, 7, canvas_module.color(255, 58, 63, 78))
        } else if codemap.*.hover == app.HIT_GROUP + index || codemap.*.hover == app.HIT_GROUP_CHECK + index || codemap.*.hover == app.HIT_NEW_FILE + index || codemap.*.hover == app.HIT_NEW_FOLDER + index {
            canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.GROUP_ROW, 7, canvas_module.color(255, 42, 45, 56))
        }
        const indent = codemap.*.sidebarIndent[index] * 14
        const label = if index == 0 { access_module.say(codemap, "Everything", "Alles") } else { access_module.nameOf(codemap, node) }
        const state = filters_module.checkState(codemap, node)
        drawCheck(canvas, 14 + indent, y + 6, state, app.ACCENT)
        if index == 0 {
            drawDot(canvas, 36, y + 8, 10, canvas_module.color(255, 220, 222, 230))
        } else {
            drawDot(canvas, 36 + indent, y + 8, 10, filters_module.canvasColor(record.*.color, if state == 0 { 90 } else { 255 }))
        }
        // How many files, at the right.
        var digits: [24]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &digits) }
        const count_length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, record.*.files))
        var count_width = canvas_module.measure(small, bytes[0..count_length])
        const row_lit = codemap.*.hover == app.HIT_GROUP + index || codemap.*.hover == app.HIT_GROUP_CHECK + index || codemap.*.hover == app.HIT_NEW_FILE + index || codemap.*.hover == app.HIT_NEW_FOLDER + index
        if row_lit {
            // A new file, a new folder in it (in place of the count).
            if codemap.*.hover == app.HIT_NEW_FILE + index { canvas_module.fillRoundedRect(canvas, app.SIDEBAR - 54, y + 3, 20, app.GROUP_ROW - 6, 5, canvas_module.color(255, 70, 76, 96)) }
            if codemap.*.hover == app.HIT_NEW_FOLDER + index { canvas_module.fillRoundedRect(canvas, app.SIDEBAR - 34, y + 3, 20, app.GROUP_ROW - 6, 5, canvas_module.color(255, 70, 76, 96)) }
            project_module.drawNewIcon(canvas, app.SIDEBAR - 51, y + 7, false, app.TEXT_COLOR)
            project_module.drawNewIcon(canvas, app.SIDEBAR - 31, y + 7, true, app.TEXT_COLOR)
            count_width = 40
        } else {
            canvas_module.drawText(canvas, small, bytes[0..count_length], app.SIDEBAR - 18 - count_width, y + 6, app.DIM_COLOR, 0)
        }
        canvas_module.drawText(canvas, body, label, 54 + indent, y + 5, if state == 0 { app.DIM_COLOR } else { app.TEXT_COLOR }, app.SIDEBAR - 54 - indent - count_width - 26)
        y += app.GROUP_ROW
        index += 1
    }
    // The program shown; opened, all of them.
    y += 6
    y = drawHeading(codemap, canvas, app.SECTION_PROGRAM, access_module.say(codemap, "Program", "Programm"), y)
    codemap.*.programTop = app.AWAY
    codemap.*.programRows = 0
    if !isFolded(codemap, app.SECTION_PROGRAM) {
        codemap.*.programTop = y
        drawProgramRow(codemap, canvas, y)
        y += app.GROUP_ROW
    }
    if codemap.*.programsOpen && codemap.*.built && !isFolded(codemap, app.SECTION_PROGRAM) {
        const programs = access_module.programsOf(codemap)
        var row: usize = 0
        while row <= programs.*.count && row < 128 {
            codemap.*.programRowY[row] = y
            drawProgramChoice(codemap, canvas, row, y)
            y += app.SUB_ROW
            row += 1
        }
        codemap.*.programRows = row
        y += 4
    }
    // The findings; under Workarounds (opened) their kinds.
    y += 6
    y = drawHeading(codemap, canvas, app.SECTION_FINDINGS, access_module.say(codemap, "Findings", "Befunde"), y)
    codemap.*.findingTop = y
    var finding: u8 = 0
    codemap.*.patternRows = 0
    if isFolded(codemap, app.SECTION_FINDINGS) {
        while @intCast(usize, finding) < app.FINDINGS {
            codemap.*.findingY[@intCast(usize, finding)] = app.AWAY
            finding += 1
        }
    }
    while @intCast(usize, finding) < app.FINDINGS {
        codemap.*.findingY[@intCast(usize, finding)] = y
        drawFindingRow(codemap, canvas, finding, y)
        y += app.GROUP_ROW
        if finding == app.FINDING_WORKAROUNDS && codemap.*.workaroundsOpen {
            var at: usize = 0
            while at < codemap.*.patternCount {
                codemap.*.patternY[at] = y
                drawPatternRow(codemap, canvas, at, y)
                y += app.SUB_ROW
                at += 1
            }
            codemap.*.patternRows = codemap.*.patternCount
            y += 4
        }
        finding += 1
    }
    // What the spheres are colored by.
    y += 6
    y = drawHeading(codemap, canvas, app.SECTION_COLOR, access_module.say(codemap, "Color by", "Färben nach"), y)
    var metric: usize = 0
    while metric < measures_module.METRICS {
        if isFolded(codemap, app.SECTION_COLOR) {
            codemap.*.metricY[metric] = app.AWAY
        } else {
            codemap.*.metricY[metric] = y
            drawMetricRow(codemap, canvas, @intCast(u8, metric), y)
            y += app.SUB_ROW
        }
        metric += 1
    }
    if codemap.*.metric != measures_module.KIND && !isFolded(codemap, app.SECTION_COLOR) {
        // The scale, cold to hot.
        var step: i32 = 0
        while step < app.SIDEBAR - 36 {
            canvas_module.fillRect(canvas, 18 + step, y + 4, 1, 8, filters_module.canvasColor(access_module.heatColor(m.toFloat(@intCast(i64, step)) / m.toFloat(@intCast(i64, app.SIDEBAR - 36))), 255))
            step += 1
        }
        canvas_module.drawText(canvas, small, access_module.say(codemap, "little", "wenig"), 18, y + 14, app.DIM_COLOR, 0)
        const most = access_module.say(codemap, "much", "viel")
        canvas_module.drawText(canvas, small, most, app.SIDEBAR - 18 - canvas_module.measure(small, most), y + 14, app.DIM_COLOR, 0)
        y += 32
    }
    // The view settings.
    y += 6
    y = drawHeading(codemap, canvas, app.SECTION_SHOW, access_module.say(codemap, "Show", "Anzeigen"), y - 2) - 2
    codemap.*.toggleTop = app.AWAY
    if !isFolded(codemap, app.SECTION_SHOW) {
        codemap.*.toggleTop = y
        drawToggle(codemap, canvas, 0, access_module.say(codemap, "Imports", "Importe"), codemap.*.showImports)
        drawToggle(codemap, canvas, 1, access_module.say(codemap, "Tree", "Baum"), codemap.*.showTree)
        drawToggle(codemap, canvas, 2, access_module.say(codemap, "Names", "Namen"), codemap.*.showLabels)
        y += 2 * 20 + 12
    } else {
        y += 6
    }
    // What the colors mean, each kind shown or not.
    y = drawHeading(codemap, canvas, app.SECTION_KINDS, access_module.say(codemap, "Kinds", "Arten"), y - 4) - 2
    codemap.*.legendTop = app.AWAY
    if !isFolded(codemap, app.SECTION_KINDS) {
        codemap.*.legendTop = y
        drawLegend(codemap, canvas, 0, access_module.say(codemap, "Function", "Funktion"))
        drawLegend(codemap, canvas, 1, "Struct/Union")
        drawLegend(codemap, canvas, 2, "Enum")
        drawLegend(codemap, canvas, 3, access_module.say(codemap, "Constant", "Konstante"))
        drawLegend(codemap, canvas, 4, "Variable")
        drawLegend(codemap, canvas, 5, access_module.say(codemap, "Field", "Feld"))
        drawLegend(codemap, canvas, 6, "Test")
        y += 4 * 20 + 12
    } else {
        y += 6
    }
    // The views kept (codemap.views): a click puts one's query into the
    // search, the x takes one out.
    y = drawHeading(codemap, canvas, app.SECTION_VIEWS, access_module.say(codemap, "Views", "Ansichten"), y)
    const views = access_module.viewsOf(codemap)
    codemap.*.viewRows = 0
    if !isFolded(codemap, app.SECTION_VIEWS) {
        var view: usize = 0
        while view < views.*.count && view < 64 {
            codemap.*.viewY[view] = y
            drawViewRow(codemap, canvas, view, y)
            y += app.SUB_ROW
            view += 1
        }
        codemap.*.viewRows = view
        const hint = if codemap.*.queryActive { access_module.say(codemap, "The bookmark next to the search keeps it as a view", "Das Lesezeichen neben der Suche hält sie als Ansicht fest") } else { access_module.say(codemap, "Filter (top) builds a query to keep", "Filter (oben) baut eine Abfrage zum Festhalten") }
        y += 2
        y += detail_module.drawWrapped(codemap, canvas, hint, small, 18, y + 2, app.SIDEBAR - 36, app.DIM_COLOR, 3, 16)
    }
    y += 12
    codemap.*.sidebarHeight = y + codemap.*.sidebarScroll
}

fn drawViewRow(codemap: *app.Codemap, canvas: *app.Canvas, view: usize, y: i32) -> void {
    const views = access_module.viewsOf(codemap)
    const query = views_module.queryOf(views, view)
    const chosen = codemap.*.queryActive && access_module.sameBytes(navigation_module.searchQuery(codemap), query)
    if chosen {
        canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.SUB_ROW, 6, canvas_module.color(255, 58, 63, 78))
    } else if codemap.*.hover == app.HIT_VIEW_ROW + view {
        canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.SUB_ROW, 6, canvas_module.color(255, 42, 45, 56))
    }
    drawRadio(canvas, 14, y + 4, chosen)
    const name = views_module.nameOf(views, view)
    canvas_module.drawText(canvas, access_module.smallOf(codemap), name, 36, y + 4, app.TEXT_COLOR, 100)
    const name_width = canvas_module.measure(access_module.smallOf(codemap), name)
    const room = app.SIDEBAR - 36 - name_width - 44
    if room > 30 { canvas_module.drawText(canvas, access_module.smallOf(codemap), query, 36 + name_width + 10, y + 4, app.DIM_COLOR, room) }
    // The x that takes it out (lit under the pointer).
    const lit = codemap.*.hover == app.HIT_VIEW_REMOVE + view
    if lit || codemap.*.hover == app.HIT_VIEW_ROW + view {
        const color = if lit { filters_module.canvasColor(app.CRASH_COLOR, 255) } else { app.DIM_COLOR }
        var step: i32 = 0
        while step < 8 {
            canvas_module.fillRect(canvas, app.SIDEBAR - 30 + step, y + 6 + step, 2, 1, color)
            canvas_module.fillRect(canvas, app.SIDEBAR - 30 + 7 - step, y + 6 + step, 2, 1, color)
            step += 1
        }
    }
}

// The program shown (a list opens under it).
fn drawProgramRow(codemap: *app.Codemap, canvas: *app.Canvas, y: i32) -> void {
    if codemap.*.hover == app.HIT_PROGRAMS { canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.GROUP_ROW, 7, canvas_module.color(255, 42, 45, 56)) }
    const label = if codemap.*.built && access_module.programChosen(codemap) { programs_module.nameOf(access_module.programsOf(codemap), codemap.*.program) } else { access_module.say(codemap, "All programs", "Alle Programme") }
    drawDot(canvas, 18, y + 8, 10, if access_module.programChosen(codemap) { app.ACCENT } else { canvas_module.color(255, 120, 124, 140) })
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), label, 36, y + 5, app.TEXT_COLOR, app.SIDEBAR - 36 - 34)
    // The arrow.
    const arrow_x = app.SIDEBAR - 30
    var step: i32 = 0
    while step < 4 {
        if codemap.*.programsOpen {
            canvas_module.fillRect(canvas, arrow_x + step, y + 10 + step, 8 - 2 * step, 1, app.DIM_COLOR)
        } else {
            canvas_module.fillRect(canvas, arrow_x + 2 + step, y + 9 + step, 1, 8 - 2 * step, app.DIM_COLOR)
        }
        step += 1
    }
}

// Row `row` of the programs' list: first "all", then the programs by
// name, with how many declarations each reaches and its machine code.
fn drawProgramChoice(codemap: *app.Codemap, canvas: *app.Canvas, row: usize, y: i32) -> void {
    const programs = access_module.programsOf(codemap)
    const program = if row == 0 { programs.*.count } else { @intCast(usize, codemap.*.programOrder[row - 1]) }
    const chosen = program == codemap.*.program
    if chosen {
        canvas_module.fillRoundedRect(canvas, 26, y, app.SIDEBAR - 34, app.SUB_ROW, 6, canvas_module.color(255, 58, 63, 78))
    } else if codemap.*.hover == app.HIT_PROGRAM + row {
        canvas_module.fillRoundedRect(canvas, 26, y, app.SIDEBAR - 34, app.SUB_ROW, 6, canvas_module.color(255, 42, 45, 56))
    }
    drawRadio(canvas, 34, y + 4, chosen)
    var digits: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    var count_length: usize = 0
    if row > 0 {
        const binary = binaries_module.binaryOf(access_module.binariesOf(codemap), program)
        if binary < access_module.binariesOf(codemap).*.count {
            count_length = filters_module.writeNumber(codemap, bytes, 0, access_module.binariesOf(codemap).*.total[binary] / 1024)
            count_length = filters_module.writeText(bytes, count_length, " KB")
        } else {
            count_length = filters_module.writeNumber(codemap, bytes, 0, programs.*.size[program])
        }
    }
    const count_width = canvas_module.measure(access_module.smallOf(codemap), bytes[0..count_length])
    canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..count_length], app.SIDEBAR - 18 - count_width, y + 4, app.DIM_COLOR, 0)
    const label = if row == 0 { access_module.say(codemap, "All", "Alle") } else { programs_module.nameOf(programs, program) }
    canvas_module.drawText(canvas, access_module.smallOf(codemap), label, 54, y + 4, app.TEXT_COLOR, app.SIDEBAR - 54 - count_width - 24)
}

// A round choice (14 pixels), filled when chosen.
fn drawRadio(canvas: *app.Canvas, x: i32, y: i32, chosen: bool) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, 14, 14, 7, if chosen { app.ACCENT } else { canvas_module.color(255, 96, 101, 118) })
    if !chosen { canvas_module.fillRoundedRect(canvas, x + 1, y + 1, 12, 12, 6, canvas_module.color(255, 30, 32, 41)) }
    if chosen { canvas_module.fillRoundedRect(canvas, x + 4, y + 4, 6, 6, 3, canvas_module.color(255, 255, 255, 255)) }
}

// What the spheres can be colored by, one row each (what cannot be had
// yet says why).
fn drawMetricRow(codemap: *app.Codemap, canvas: *app.Canvas, metric: u8, y: i32) -> void {
    const chosen = codemap.*.metric == metric
    if codemap.*.hover == app.HIT_METRIC + @intCast(usize, metric) { canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.SUB_ROW, 6, canvas_module.color(255, 42, 45, 56)) }
    drawRadio(canvas, 14, y + 4, chosen)
    canvas_module.drawText(canvas, access_module.smallOf(codemap), measures_module.name(metric, codemap.*.german), 36, y + 4, app.TEXT_COLOR, 110)
    const note = metricNote(codemap, metric)
    if note.length > 0 {
        const width = canvas_module.measure(access_module.smallOf(codemap), note)
        canvas_module.drawText(canvas, access_module.smallOf(codemap), note, app.SIDEBAR - 18 - width, y + 4, app.DIM_COLOR, 0)
    }
}

// Why a measure cannot be had yet ("": it can). A slice returned, not
// assigned: the compiler keeps an assigned slice's old length.
fn metricNote(codemap: *app.Codemap, metric: u8) -> []const u8 {
    if !codemap.*.built { return "" }
    if metric == measures_module.SIZE && access_module.binariesOf(codemap).*.count == 0 { return access_module.say(codemap, "not built", "nicht gebaut") }
    if metric == measures_module.CHURN {
        if !git_module.usable(access_module.gitOf(codemap)) { return access_module.say(codemap, "no Git", "kein Git") }
        if !history_module.finished(access_module.historyOf(codemap)) { return access_module.say(codemap, "reading", "wird gelesen") }
    }
    if metric == measures_module.HEAT && access_module.profilesOf(codemap).*.count == 0 { return access_module.say(codemap, "no profile", "kein Profil") }
    return ""
}

fn drawFindingRow(codemap: *app.Codemap, canvas: *app.Canvas, finding: u8, y: i32) -> void {
    const index = @intCast(usize, finding)
    if codemap.*.finding == finding {
        canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.GROUP_ROW, 7, canvas_module.color(255, 58, 63, 78))
    } else if codemap.*.hover == app.HIT_FINDING + index || codemap.*.hover == app.HIT_FINDING_CHECK + index || (finding == app.FINDING_WORKAROUNDS && codemap.*.hover == app.HIT_DROPDOWN) {
        canvas_module.fillRoundedRect(canvas, 8, y, app.SIDEBAR - 16, app.GROUP_ROW, 7, canvas_module.color(255, 42, 45, 56))
    }
    const color = access_module.findingColor(finding)
    drawCheck(canvas, 14, y + 6, if codemap.*.findingOn[index] { 1 } else { 0 }, filters_module.canvasColor(color, 255))
    drawDot(canvas, 36, y + 8, 10, filters_module.canvasColor(color, if finding == app.FINDING_UNUSED { 150 } else { 255 }))
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    const count_length = if codemap.*.built { filters_module.writeNumber(codemap, bytes, 0, filters_module.findingSize(codemap, finding)) } else { 0 }
    const count_width = canvas_module.measure(access_module.smallOf(codemap), bytes[0..count_length])
    canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..count_length], app.SIDEBAR - 18 - count_width, y + 6, app.DIM_COLOR, 0)
    var room = app.SIDEBAR - 54 - count_width - 26
    if finding == app.FINDING_WORKAROUNDS {
        // The arrow that opens the kinds (down when open).
        const arrow_x = app.SIDEBAR - 64
        const arrow_color = if codemap.*.hover == app.HIT_DROPDOWN { app.TEXT_COLOR } else { app.DIM_COLOR }
        var step: i32 = 0
        while step < 4 {
            if codemap.*.workaroundsOpen {
                canvas_module.fillRect(canvas, arrow_x + step, y + 10 + step, 8 - 2 * step, 1, arrow_color)
            } else {
                canvas_module.fillRect(canvas, arrow_x + 2 + step, y + 9 + step, 1, 8 - 2 * step, arrow_color)
            }
            step += 1
        }
        room = arrow_x - 54 - 6
    }
    canvas_module.drawText(canvas, access_module.bodyOf(codemap), findingLabel(codemap, finding), 54, y + 5, app.TEXT_COLOR, room)
}

pub fn findingLabel(codemap: *app.Codemap, finding: u8) -> []const u8 {
    if finding == app.FINDING_UNREACHABLE { return access_module.say(codemap, "Unreachable", "Unerreichbar") }
    if finding == app.FINDING_UNTESTED { return access_module.say(codemap, "Untested", "Ungetestet") }
    if finding == app.FINDING_COMPLEX { return access_module.say(codemap, "Complex", "Komplex") }
    if finding == app.FINDING_STRUCTURE { return access_module.say(codemap, "Cycles and layers", "Zyklen und Schichten") }
    if finding == app.FINDING_RISKY { return access_module.say(codemap, "Risky", "Riskant") }
    if finding == app.FINDING_HOT { return access_module.say(codemap, "Hot", "Heiß") }
    if finding == app.FINDING_CHANGED { return access_module.say(codemap, "Changed", "Geändert") }
    if finding == app.FINDING_COPIES { return access_module.say(codemap, "Copies", "Kopien") }
    if finding == app.FINDING_NAMES { return access_module.say(codemap, "Written again", "Mehrfach geschrieben") }
    if finding == app.FINDING_UNUSED { return access_module.say(codemap, "Unused", "Ungenutzt") }
    if finding == app.FINDING_WORKAROUNDS { return "Workarounds" }
    return access_module.say(codemap, "Crashes", "Abstürze")
}

// A kind of workaround under Workarounds: its check box, name and places.
fn drawPatternRow(codemap: *app.Codemap, canvas: *app.Canvas, row: usize, y: i32) -> void {
    const pattern = codemap.*.patternOrder[row]
    const on = codemap.*.patternOn[@intCast(usize, pattern)]
    if codemap.*.hover == app.HIT_PATTERN + row { canvas_module.fillRoundedRect(canvas, 26, y, app.SIDEBAR - 34, app.SUB_ROW, 6, canvas_module.color(255, 42, 45, 56)) }
    drawCheck(canvas, 34, y + 4, if on { 1 } else { 0 }, filters_module.canvasColor(app.WORKAROUND_COLOR, 255))
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    const count_length = filters_module.writeNumber(codemap, bytes, 0, codemap.*.patternPlaces[@intCast(usize, pattern)])
    const count_width = canvas_module.measure(access_module.smallOf(codemap), bytes[0..count_length])
    canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..count_length], app.SIDEBAR - 18 - count_width, y + 4, app.DIM_COLOR, 0)
    const drawn = drawSparkline(codemap, canvas, pattern, app.SIDEBAR - 24 - count_width - SPARKLINE, y + 3, if on { app.WORKAROUND_COLOR } else { 4284112491 })
    const room = if drawn { app.SIDEBAR - 54 - count_width - SPARKLINE - 30 } else { app.SIDEBAR - 54 - count_width - 24 }
    canvas_module.drawText(canvas, access_module.smallOf(codemap), workarounds_module.shortTitle(pattern, codemap.*.german), 54, y + 4, if on { app.TEXT_COLOR } else { app.DIM_COLOR }, room)
}

const SPARKLINE: i32 = 34

// How a kind of workaround went over the last commits: a bar each (the
// oldest left), between the least and the most; drawn when two commits
// or more are counted.
fn drawSparkline(codemap: *app.Codemap, canvas: *app.Canvas, pattern: u8, x: i32, y: i32, color: u32) -> bool {
    const trend = access_module.trendOf(codemap)
    var known: usize = 0
    var commit: usize = 0
    while commit < trend.*.count {
        if trend_module.isKnown(trend, commit) { known += 1 }
        commit += 1
    }
    if known < 2 { return false }
    const most = trend_module.most(trend, @intCast(usize, pattern))
    const least = trend_module.least(trend, @intCast(usize, pattern))
    const height: i32 = 12
    var width = SPARKLINE / @intCast(i32, known)
    if width < 1 { width = 1 }
    var left = x + SPARKLINE - width * @intCast(i32, known)
    commit = 0
    while commit < trend.*.count {
        if trend_module.isKnown(trend, commit) {
            const value = trend_module.countOf(trend, commit, pattern)
            var bar: i32 = height / 2
            if most > least { bar = 2 + @intCast(i32, (value - least) * @intCast(u32, height - 2) / (most - least)) }
            const gap: i32 = if width > 2 { 1 } else { 0 }
            canvas_module.fillRect(canvas, left, y + height - bar, width - gap, bar, filters_module.canvasColor(color, 200))
            left += width
        }
        commit += 1
    }
    return true
}

// A kind in the legend: a check box in its color, its name.
fn drawLegend(codemap: *app.Codemap, canvas: *app.Canvas, index: usize, label: []const u8) -> void {
    const x = 16 + @intCast(i32, index % 2) * 100
    const y = codemap.*.legendTop + @intCast(i32, index / 2) * 20
    const kind = filters_module.legendKind(index)
    const on = !codemap.*.kindOff[@intCast(usize, kind)]
    if codemap.*.hover == app.HIT_KIND + index { canvas_module.fillRoundedRect(canvas, x - 4, y - 3, 98, 19, 5, canvas_module.color(255, 42, 45, 56)) }
    drawCheck(canvas, x, y - 1, if on { 1 } else { 0 }, filters_module.canvasColor(graph_module.kindColor(kind), 255))
    canvas_module.drawText(canvas, access_module.smallOf(codemap), label, x + 19, y, if on { canvas_module.color(255, 190, 194, 204) } else { app.DIM_COLOR }, 76)
}

// The status bar: where the selection is (its parts to click on), and a
// note, what the pointer is on, or how big the code is.
pub fn drawStatus(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const width = access_module.surfaceWidth(codemap)
    const height = access_module.surfaceHeight(codemap)
    const top = height - app.STATUS
    canvas_module.fillRect(canvas, app.SIDEBAR, top, width - app.SIDEBAR, app.STATUS, canvas_module.color(255, 34, 36, 45))
    canvas_module.fillRect(canvas, app.SIDEBAR, top, width - app.SIDEBAR, 1, canvas_module.color(255, 20, 21, 27))
    if codemap.*.view == app.VIEW_EDITOR && tabs_module.hasTab(codemap) {
        drawEditorStatus(codemap, canvas, top, width)
        return
    }
    const small = access_module.smallOf(codemap)
    codemap.*.crumbCount = 0
    var x = app.SIDEBAR + 12
    const subject = if codemap.*.selected != app.NONE { codemap.*.selected } else { codemap.*.focus }
    if codemap.*.built && subject != app.NONE {
        var chain: [32]u32 = undefined
        var count: usize = 0
        var current = subject
        while current != app.NONE && count < 32 {
            chain[count] = current
            count += 1
            current = access_module.nodeOf(codemap, current).*.parent
        }
        while count > 0 {
            count -= 1
            const node = chain[count]
            const label = access_module.nameOf(codemap, node)
            const w = canvas_module.measure(small, label)
            const index = codemap.*.crumbCount
            codemap.*.crumbX[index] = x
            codemap.*.crumbNodes[index] = node
            codemap.*.crumbCount += 1
            if codemap.*.hover == app.HIT_CRUMB + index { canvas_module.fillRoundedRect(canvas, x - 5, top + 5, w + 10, app.STATUS - 10, 6, canvas_module.color(255, 52, 56, 68)) }
            canvas_module.drawText(canvas, small, label, x, top + 8, if count == 0 { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
            x += w
            if count > 0 { canvas_module.drawChevron(canvas, x + 8, top + 11, false, app.DIM_COLOR, 9, 2) }
            x += 22
        }
    }
    var buffer: [256]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &buffer) }
    var length: usize = 0
    var color = app.DIM_COLOR
    if codemap.*.noteLength > 0 {
        length = filters_module.writeText(text, 0, access_module.noteText(codemap))
        color = canvas_module.color(255, 240, 160, 90)
    } else if codemap.*.built && codemap.*.hoverNode != app.NONE {
        const node = codemap.*.hoverNode
        length = filters_module.writeText(text, 0, filters_module.kindLabel(codemap, node))
        length = filters_module.writeText(text, length, " ")
        length = filters_module.writeText(text, length, access_module.nameOf(codemap, node))
        const path = graph_module.pathOf(access_module.graphOf(codemap), node)
        if path.length > 0 && path.length < 160 {
            length = filters_module.writeText(text, length, "  ")
            length = filters_module.writeText(text, length, path)
        }
    } else if codemap.*.built {
        const graph = access_module.graphOf(codemap)
        const root = access_module.nodeOf(codemap, graph.*.root)
        length = filters_module.writeNumber(codemap, text, 0, @intCast(usize, root.*.files))
        length = filters_module.writeText(text, length, access_module.say(codemap, " files, ", " Dateien, "))
        length = filters_module.writeNumber(codemap, text, length, @intCast(usize, root.*.declarations))
        length = filters_module.writeText(text, length, access_module.say(codemap, " declarations, ", " Deklarationen, "))
        length = filters_module.writeNumber(codemap, text, length, codemap.*.index.*.refCount)
        length = filters_module.writeText(text, length, access_module.say(codemap, " uses", " Verwendungen"))
    }
    const shown = text[0..length]
    const w = canvas_module.measure(small, shown)
    if x + 20 < width - 14 - w { canvas_module.drawText(canvas, small, shown, width - 14 - w, top + 8, color, 0) }
}

// ---------------------------------------------------------------------------
// Overlays fade in (hover, lists, fields): over FADE_MS each shows more of
// itself and slides a few pixels into place, from the moment it shows
// something new (`key`). A demo draws them at once.

// The canvas's opacity for overlay `kind` showing `key`; how many pixels
// it is still above its place.
pub fn fadeIn(codemap: *app.Codemap, canvas: *app.Canvas, kind: usize, key: u64) -> i32 {
    const now = panel_module.milliseconds()
    if codemap.*.overlayKey[kind] != key {
        codemap.*.overlayKey[kind] = key
        codemap.*.overlayAt[kind] = now
    }
    codemap.*.overlayDrawn[kind] = true
    if codemap.*.demoActive {
        canvas_module.setOpacity(canvas, 255)
        return 0
    }
    const passed = now - codemap.*.overlayAt[kind]
    const linear: u32 = if passed >= app.FADE_MS { 255 } else { @intCast(u32, passed * 255 / app.FADE_MS) }
    // Quick at first, gently at the end.
    const eased = 255 - (255 - linear) * (255 - linear) / 255
    if eased < 255 { codemap.*.animating = true }
    canvas_module.setOpacity(canvas, eased)
    return @intCast(i32, (255 - eased) * 8 / 255)
}

pub fn fadeDone(canvas: *app.Canvas) -> void { canvas_module.setOpacity(canvas, 255) }

// A frame starts: nothing drawn yet; one ends: what was not drawn starts
// over when it shows again.
pub fn beginOverlays(codemap: *app.Codemap) -> void {
    codemap.*.animating = false
    var kind: usize = 0
    while kind < app.OVERLAYS {
        codemap.*.overlayDrawn[kind] = false
        kind += 1
    }
}

pub fn endOverlays(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    var kind: usize = 0
    while kind < app.OVERLAYS {
        if !codemap.*.overlayDrawn[kind] { codemap.*.overlayKey[kind] = 0 }
        kind += 1
    }
    fadeDone(canvas)
    // Still fading: the next frame soon (the panel clears `dirty` after a
    // draw, so the tick asks for it).
    if codemap.*.animating {
        const panel = access_module.panelOf(codemap)
        if panel.*.tickInterval != 16 { panel.*.nextTick = 0 }
        panel.*.tickInterval = 16
    }
}

// A bar at the right: where the view is in the file, and the file's
// problems, crashes and changes as ticks.
pub fn drawEditorScrollbar(codemap: *app.Codemap, canvas: *app.Canvas, right: i32, top: i32, bottom: i32) -> void {
    const editor = tabs_module.activeEditor(codemap)
    const tab = codemap.*.activeTab
    const x = right - 10
    const height = bottom - top
    canvas_module.fillRect(canvas, x, top, 10, height, canvas_module.color(255, 24, 26, 33))
    const lines = if editor.*.lineCount > 0 { editor.*.lineCount } else { 1 }
    const rows = editor_view_module.editorRows(codemap)
    const thumb_top = top + @intCast(i32, editor.*.top * @intCast(usize, height) / lines)
    var thumb = @intCast(i32, rows * @intCast(usize, height) / lines)
    if thumb < 20 { thumb = 20 }
    if thumb > height { thumb = height }
    canvas_module.fillRoundedRect(canvas, x + 2, thumb_top, 6, thumb, 3, canvas_module.color(255, 70, 74, 90))
    const marks = tabs_module.marksOf(codemap, tab)
    var line: usize = 0
    while line < editor.*.lineCount && line < codemap.*.tabMarkLines[tab] {
        const mark = marks[line]
        if mark != 0 {
            const y = top + @intCast(i32, line * @intCast(usize, height) / lines)
            var color: u32 = 0
            if mark & (app.MARK_ADDED | app.MARK_CHANGED) != 0 { color = filters_module.canvasColor(app.CHANGED_COLOR, 200) }
            if mark & app.MARK_CRASH != 0 { color = filters_module.canvasColor(app.CRASH_COLOR, 255) }
            if mark & app.MARK_WARNING != 0 { color = filters_module.canvasColor(app.WARNING_COLOR, 255) }
            if mark & app.MARK_ERROR != 0 { color = filters_module.canvasColor(app.ERROR_COLOR, 255) }
            if color != 0 { canvas_module.fillRect(canvas, x + 1, y, 8, 2, color) }
        }
        line += 1
    }
}

// What the name under the pointer is: its signature, doc comment and what
// the map measures of it.
pub fn drawEditorHover(codemap: *app.Codemap, canvas: *app.Canvas, right: i32, bottom: i32) -> void {
    if codemap.*.editorHover == 18446744073709551615 || codemap.*.hover != app.HIT_EDITOR || codemap.*.pressed { return }
    const symbol = tabs_module.symbolAtCursor(codemap, codemap.*.editorHover)
    if symbol == app.NONE { return }
    const slide = fadeIn(codemap, canvas, app.OVERLAY_HOVER, (@intCast(u64, symbol) << 32) | @intCast(u64, codemap.*.editorHover & 4294967295) + 1)
    const index = codemap.*.index
    // As rust-analyzer shows it: where it is (its file, the containers
    // around it), its signature in the code's colors, a value's type and
    // where that is declared, the doc comment set as text, then what the
    // map measures of it.
    const lines = access_module.hoverTextOf(codemap)
    protocol.clear(lines)
    features.owner(lines, index, symbol)
    const owner_length = lines.*.length
    const typed = features.typePlace(lines, index, symbol)
    const owner = protocol.contents(lines)[0..owner_length]
    const type_line = protocol.contents(lines)[owner_length..lines.*.length]
    var signature_start: usize = 0
    var signature_length: usize = 0
    index_module.signatureRange(index, symbol, &signature_start, &signature_length)
    const source = index_module.sourceOf(index, index_module.symbolAt(index, symbol).*.file)
    const plain_signature = if signature_length > 0 { source[signature_start..signature_start + (if signature_length > 400 { 400 } else { signature_length })] } else { index_module.nameOf(index, symbol) }
    // A struct, enum or union: its fields or members under it.
    var shape: [2048]u8 = undefined
    var shape_bytes: [*]u8 = undefined
    unsafe { shape_bytes = @ptrCast([*]u8, &shape) }
    const shape_length = assist_module.writeShape(codemap, shape_bytes, symbol, plain_signature)
    const signature = if shape_length > 0 { shape_bytes[0..shape_length] } else { plain_signature }
    var doc_start: usize = 0
    var doc_length: usize = 0
    index_module.docRange(index, symbol, &doc_start, &doc_length)
    const doc = source[doc_start..doc_start + (if doc_length > 4000 { 4000 } else { doc_length })]
    var lens: [256]u8 = undefined
    var lens_bytes: [*]u8 = undefined
    unsafe { lens_bytes = @ptrCast([*]u8, &lens) }
    const lens_length = editor_view_module.writeLens(codemap, lens_bytes, symbol)
    var width: i32 = 540
    if width > right - app.SIDEBAR - 24 { width = right - app.SIDEBAR - 24 }
    const inner = width - 28
    // Measured first, then drawn.
    const owner_height: i32 = 20
    const signature_height = assist_module.drawCode(codemap, canvas, signature, 0, 0, inner, false)
    const type_height: i32 = if typed { 20 } else { 0 }
    const doc_height = if doc_length > 0 { assist_module.drawDoc(codemap, canvas, doc, 0, 0, inner, 14, false) + 12 } else { 0 }
    const height = 12 + owner_height + signature_height + type_height + doc_height + 12 + 22
    var x = codemap.*.pointerX + 12
    if x + width > right - 12 { x = right - 12 - width }
    var y = codemap.*.pointerY + 18
    if y + height > bottom - 4 { y = codemap.*.pointerY - height - 8 }
    if y < app.TOOLBAR + 4 { y = app.TOOLBAR + 4 }
    y -= slide
    canvas_module.fillRoundedRect(canvas, x + 2, y + 3, width, height, 8, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, y, width, height, 8, canvas_module.color(250, 30, 32, 41))
    canvas_module.strokeRoundedRect(canvas, x, y, width, height, 8, 1, canvas_module.color(255, 64, 68, 84))
    var line_y = y + 12
    canvas_module.drawText(canvas, access_module.smallOf(codemap), owner, x + 14, line_y, app.DIM_COLOR, inner)
    line_y += owner_height
    line_y += assist_module.drawCode(codemap, canvas, signature, x + 14, line_y, inner, true)
    if typed {
        canvas_module.drawText(canvas, access_module.smallOf(codemap), type_line, x + 14, line_y + 3, app.DIM_COLOR, inner)
        line_y += type_height
    }
    if doc_length > 0 {
        canvas_module.fillRect(canvas, x + 1, line_y + 6, width - 2, 1, canvas_module.color(255, 52, 56, 68))
        line_y += 12
        line_y += assist_module.drawDoc(codemap, canvas, doc, x + 14, line_y, inner, 14, true)
    }
    canvas_module.fillRect(canvas, x + 1, line_y + 6, width - 2, 1, canvas_module.color(255, 52, 56, 68))
    line_y += 12
    canvas_module.drawText(canvas, access_module.smallOf(codemap), lens_bytes[0..lens_length], x + 14, line_y + 2, filters_module.canvasColor(app.ACCENT, 255), inner)
}

// The tabs, the file's place, Map (the declaration at the cursor in the
// galaxy) and Save.
pub fn drawTabs(codemap: *app.Codemap, canvas: *app.Canvas, left: i32, right: i32) -> void {
    canvas_module.fillRect(canvas, left, app.TOOLBAR, right - left, app.TAB_BAR, canvas_module.color(255, 30, 32, 40))
    canvas_module.fillRect(canvas, left, app.TOOLBAR + app.TAB_BAR - 1, right - left, 1, canvas_module.color(255, 20, 21, 27))
    var x = left + 6
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = access_module.editorAt(codemap, tab)
        const path = editor_module.pathOf(editor)
        var slash = path.length
        while slash > 0 && path[slash - 1] != 47 { slash -= 1 }
        const name = path[slash..path.length]
        const width = canvas_module.measure(access_module.bodyOf(codemap), name) + 44
        const active = tab == codemap.*.activeTab
        if active {
            canvas_module.fillRect(canvas, x, app.TOOLBAR + 4, width, app.TAB_BAR - 4, app.EDITOR_BACKGROUND)
            canvas_module.fillRect(canvas, x, app.TOOLBAR + 4, width, 2, app.ACCENT)
        } else if codemap.*.hover == app.HIT_TAB + tab || codemap.*.hover == app.HIT_TAB_CLOSE + tab {
            canvas_module.fillRect(canvas, x, app.TOOLBAR + 4, width, app.TAB_BAR - 4, canvas_module.color(255, 38, 41, 51))
        }
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), name, x + 12, app.TOOLBAR + 9, if active { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
        // Edited: a dot; under the pointer: an x that closes.
        const mark_x = x + width - 22
        if codemap.*.hover == app.HIT_TAB_CLOSE + tab || (codemap.*.hover == app.HIT_TAB + tab && !editor_module.isDirty(editor)) {
            var step: i32 = 0
            while step < 8 {
                canvas_module.fillRect(canvas, mark_x + 3 + step, app.TOOLBAR + 12 + step, 2, 1, app.TEXT_COLOR)
                canvas_module.fillRect(canvas, mark_x + 10 - step, app.TOOLBAR + 12 + step, 2, 1, app.TEXT_COLOR)
                step += 1
            }
        } else if editor_module.isDirty(editor) {
            drawDot(canvas, mark_x + 4, app.TOOLBAR + 13, 8, app.TEXT_COLOR)
        }
        codemap.*.tabX[tab] = x
        codemap.*.tabWidth[tab] = width
        x += width + 2
        tab += 1
    }
    // At the right: Save and Map.
    const map_label = access_module.say(codemap, "Show in map", "In der Karte")
    const map_width = canvas_module.measure(access_module.smallOf(codemap), map_label) + 20
    const save_label = access_module.say(codemap, "Save", "Speichern")
    const save_width = canvas_module.measure(access_module.smallOf(codemap), save_label) + 20
    const map_x = right - 10 - map_width
    const save_x = map_x - 6 - save_width
    codemap.*.editorMapX = map_x
    codemap.*.editorSaveX = save_x
    if tabs_module.hasTab(codemap) {
        const dirty = editor_module.isDirty(tabs_module.activeEditor(codemap))
        canvas_module.fillRoundedRect(canvas, save_x, app.TOOLBAR + 5, save_width, app.TAB_BAR - 10, 6, if codemap.*.hover == app.HIT_EDITOR_SAVE && dirty { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 46, 49, 60) })
        canvas_module.drawText(canvas, access_module.smallOf(codemap), save_label, save_x + 10, app.TOOLBAR + 9, if dirty { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
        canvas_module.fillRoundedRect(canvas, map_x, app.TOOLBAR + 5, map_width, app.TAB_BAR - 10, 6, if codemap.*.hover == app.HIT_EDITOR_MAP { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 46, 49, 60) })
        canvas_module.drawText(canvas, access_module.smallOf(codemap), map_label, map_x + 10, app.TOOLBAR + 9, app.TEXT_COLOR, 0)
    }
}

// The status bar in the editor: the file, line and column, edited, the
// problems (the cursor's line's message), and when the index is older.
fn drawEditorStatus(codemap: *app.Codemap, canvas: *app.Canvas, top: i32, width: i32) -> void {
    codemap.*.crumbCount = 0
    const editor = tabs_module.activeEditor(codemap)
    const small = access_module.smallOf(codemap)
    // A note (saved, built, committed) on the right; the rest before it.
    var right = width - 12
    if codemap.*.noteLength > 0 {
        const note = access_module.noteText(codemap)
        const note_width = canvas_module.measure(small, note)
        right = width - 14 - note_width - 20
        canvas_module.drawText(canvas, small, note, width - 14 - note_width, top + 7, canvas_module.color(255, 240, 160, 90), 0)
    }
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const line = editor_module.lineOf(editor, editor.*.cursor)
    var length = filters_module.writeText(bytes, 0, tabs_module.tabRelative(codemap, codemap.*.activeTab))
    length = filters_module.writeText(bytes, length, access_module.say(codemap, "   Ln ", "   Z "))
    length = lists_module.writeNumberPlain(bytes, length, line + 1)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, ", Col ", ", Sp "))
    length = lists_module.writeNumberPlain(bytes, length, editor_module.columnOf(editor, editor.*.cursor) + 1)
    if editor_module.isDirty(editor) { length = filters_module.writeText(bytes, length, access_module.say(codemap, "   edited", "   geändert")) }
    canvas_module.drawText(canvas, small, bytes[0..length], app.SIDEBAR + 12, top + 7, app.DIM_COLOR, 0)
    var x = app.SIDEBAR + 24 + canvas_module.measure(small, bytes[0..length])
    // Problems of the file, and the message on the cursor's line.
    const path = editor_module.pathOf(editor)
    var errors: usize = 0
    var warnings: usize = 0
    var source: usize = 0
    while source < 2 {
        const check = access_module.problemsOf(codemap, source)
        const output = check_module.outputText(check)
        var at: usize = 0
        while at < check.*.count {
            const diagnostic = check_module.diagnosticAt(check, at)
            if tabs_module.diagnosticInFile(codemap, output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength], path) {
                if diagnostic.*.isError { errors += 1 } else { warnings += 1 }
            }
            at += 1
        }
        source += 1
    }
    length = 0
    if errors + warnings > 0 {
        length = lists_module.writeNumberPlain(bytes, 0, errors)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " errors, ", " Fehler, "))
        length = lists_module.writeNumberPlain(bytes, length, warnings)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " warnings", " Warnungen"))
        canvas_module.drawText(canvas, small, bytes[0..length], x, top + 7, filters_module.canvasColor(if errors > 0 { app.ERROR_COLOR } else { app.WARNING_COLOR }, 255), 0)
        x += canvas_module.measure(small, bytes[0..length]) + 14
        const shown = problemOnLine(codemap, line)
        if shown.length > 0 && right - x > 40 { canvas_module.drawText(canvas, small, shown, x, top + 7, app.TEXT_COLOR, right - x) }
    } else if right - x <= 40 {
        // No room left.
    } else if line < codemap.*.tabMarkLines[codemap.*.activeTab] && tabs_module.marksOf(codemap, codemap.*.activeTab)[line] & (app.MARK_CRASH | app.MARK_WORKAROUND) != 0 && codemap.*.built {
        // The cursor's line: its crash or workaround (and its rewrite).
        editor_view_module.buildLineHints(codemap, codemap.*.activeTab, line, tabs_module.marksOf(codemap, codemap.*.activeTab)[line])
        const drawn = editor_view_module.drawChips(codemap, canvas, x, top + 5, right, 255)
    } else if codemap.*.stale {
        const note = access_module.say(codemap, "Saved: the map reads it again when you switch to it", "Gespeichert: die Karte liest neu ein, sobald du zu ihr wechselst")
        canvas_module.drawText(canvas, small, note, x, top + 7, filters_module.canvasColor(app.WARNING_COLOR, 255), right - x)
    } else if access_module.checkOf(codemap).*.running {
        canvas_module.drawText(canvas, small, access_module.say(codemap, "The compiler checks the file ...", "Der Compiler prüft die Datei ..."), x, top + 7, app.DIM_COLOR, right - x)
    }
}

// The compiler's message on `line` of the tab shown ("": none).
fn problemOnLine(codemap: *app.Codemap, line: usize) -> []const u8 {
    const first = problemOnLineFrom(codemap, access_module.checkOf(codemap), line)
    if first.length > 0 { return first }
    return problemOnLineFrom(codemap, access_module.buildOf(codemap), line)
}

fn problemOnLineFrom(codemap: *app.Codemap, check: *check_module.Check, line: usize) -> []const u8 {
    const path = editor_module.pathOf(tabs_module.activeEditor(codemap))
    const output = check_module.outputText(check)
    var at: usize = 0
    while at < check.*.count {
        const diagnostic = check_module.diagnosticAt(check, at)
        if diagnostic.*.line == line + 1 && tabs_module.diagnosticInFile(codemap, output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength], path) {
            return output[diagnostic.*.messageStart..diagnostic.*.messageStart + diagnostic.*.messageLength]
        }
        at += 1
    }
    return ""
}

// The view switch at the top of the sidebar: Map | Editor.
fn drawViewSwitch(codemap: *app.Codemap, canvas: *app.Canvas, y: i32) -> void {
    const half = (app.SIDEBAR - 24) / 2
    canvas_module.fillRoundedRect(canvas, 10, y, app.SIDEBAR - 20, 28, 8, canvas_module.color(255, 20, 22, 28))
    var which: u8 = 0
    while which < 2 {
        const x = 12 + @intCast(i32, which) * half
        const chosen = codemap.*.view == which
        const hit = if which == app.VIEW_MAP { app.HIT_VIEW_MAP } else { app.HIT_VIEW_EDITOR }
        if chosen {
            canvas_module.fillRoundedRect(canvas, x, y + 2, half, 24, 7, canvas_module.color(255, 58, 63, 78))
        } else if codemap.*.hover == hit {
            canvas_module.fillRoundedRect(canvas, x, y + 2, half, 24, 7, canvas_module.color(255, 40, 43, 54))
        }
        var label: [48]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &label) }
        var length = filters_module.writeText(bytes, 0, if which == app.VIEW_MAP { access_module.say(codemap, "Map", "Karte") } else { "Editor" })
        if which == app.VIEW_EDITOR && codemap.*.tabCount > 0 {
            length = filters_module.writeText(bytes, length, " ")
            length = lists_module.writeNumberPlain(bytes, length, codemap.*.tabCount)
        }
        const width = canvas_module.measure(access_module.bodyOf(codemap), bytes[0..length])
        // A small galaxy or lines of text before the name.
        const icon_x = x + (half - width - 16) / 2
        if which == app.VIEW_MAP {
            drawDot(canvas, icon_x, y + 9, 6, filters_module.canvasColor(app.TYPE_COLOR, 255))
            drawDot(canvas, icon_x + 6, y + 14, 4, filters_module.canvasColor(app.KEYWORD_COLOR, 255))
            drawDot(canvas, icon_x + 3, y + 17, 3, filters_module.canvasColor(app.STRING_COLOR, 255))
        } else {
            var step: i32 = 0
            while step < 4 {
                canvas_module.fillRect(canvas, icon_x, y + 8 + step * 4, if step % 2 == 0 { 10 } else { 7 }, 2, if chosen { app.TEXT_COLOR } else { app.DIM_COLOR })
                step += 1
            }
        }
        canvas_module.drawText(canvas, access_module.bodyOf(codemap), bytes[0..length], icon_x + 16, y + 6, if chosen { app.TEXT_COLOR } else { app.DIM_COLOR }, 0)
        which += 1
    }
    codemap.*.viewSwitchY = y
}
