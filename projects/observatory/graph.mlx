// What the 3D view shows, made from the code index (tools/codemap): the
// tree of the code base (folders, files, their declarations, the members
// of structs, enums and unions) as nodes laid out in space, each group
// around its parent on a sphere big enough for what is in it; the imports
// between files; and, asked for one node, what it connects to (calls,
// uses, imports, both ways) and what matches a search.
const std = @import("std")
const math = @import("std.math")
const index_module = @import("../../tools/codemap/index.mlx")
const aggregates = @import("../../tools/codemap/aggregates.mlx")
const m = @import("./math3d.mlx")
const layout_module = @import("./layout.mlx")

pub const Index = index_module.Index
pub const Allocator = std.allocator.Allocator
pub const NONE: u32 = 4294967295

// Node kinds.
pub const DIRECTORY: u8 = 0
pub const FILE: u8 = 1
pub const DECLARATION: u8 = 2

pub const MAX_NODES: usize = 524288
const NAMES: usize = 4194304
const MAX_IMPORTS: usize = 262144
pub const MAX_EDGES: usize = 1048576
pub const MAX_RELATED: usize = 8192

// Relation kinds.
pub const RELATION_CALL: u8 = 0
pub const RELATION_USE: u8 = 1
pub const RELATION_IMPORT: u8 = 2

pub const Node = struct {
    kind: u8
    // The index's kind of its symbol (index_module.STRUCT, ...).
    symbolKind: u8
    symbol: u32
    parent: u32
    firstChild: u32
    lastChild: u32
    nextSibling: u32
    childCount: u32
    depth: u32
    // The top-level group it is in (a child of the root; the root: its
    // own) and that group's place among them (its color).
    group: u32
    groupIndex: u32
    // Folders' and files' names are in the graph's names; declarations'
    // in the index.
    nameStart: u32
    nameLength: u32
    // Files under it, declarations under it, and how often it is used.
    files: u32
    declarations: u32
    uses: u32
    // Its sphere, the sphere its children lie on, all of it (a sphere
    // `extent` big around the node's place moved by the center), and
    // where it is.
    radius: f64
    shell: f64
    extent: f64
    centerX: f64
    centerY: f64
    centerZ: f64
    x: f64
    y: f64
    z: f64
    color: u32
}

pub const Relation = struct {
    node: u32
    count: u32
    kind: u8
}

pub const Graph = struct {
    allocator: Allocator
    // The compiler's arena of temporaries (tools/codemap/aggregates.mlx):
    // taken back after each node is laid out.
    arena: usize
    index: *Index
    nodes: [*]Node
    count: usize
    names: [*]u8
    namesUsed: usize
    root: u32
    rootPath: [*]const u8
    rootLength: usize
    groupCount: u32
    // The node of each index symbol (NONE: not shown).
    nodeOfSymbol: [*]u32
    // Imports between files: node pairs, no duplicates.
    importFrom: [*]u32
    importTo: [*]u32
    importCount: usize
    // Scratch.
    order: [*]u32
    scratch: [*]u32
    keys: [*]u64
    keyScratch: [*]u64
    outgoingCounts: [*]u32
    incomingCounts: [*]u32
    kinds: [*]u8
    ancestors: [*]u8
    // What uses what, weighted: node pairs (the user, the used) and how
    // many uses; by user, and (byTarget) an order by the used.
    edgeFrom: [*]u32
    edgeTo: [*]u32
    edgeWeight: [*]u32
    edgePull: [*]f64
    edgeCount: usize
    byTarget: [*]u32
    edgeKeys: [*]u64
    edgeScratch: [*]u64
    // The galaxy's forces: where each node was packed (relative to its
    // parent), the pull on it, how it moved, its weight (nodes under it).
    anchorX: [*]f64
    anchorY: [*]f64
    anchorZ: [*]f64
    forceX: [*]f64
    forceY: [*]f64
    forceZ: [*]f64
    moveX: [*]f64
    moveY: [*]f64
    moveZ: [*]f64
    mass: [*]f64
    absoluteX: [*]f64
    absoluteY: [*]f64
    absoluteZ: [*]f64
    // Per node while the uses pull: its parent, and the room it may move
    // in (its parent's sphere).
    parentOf: [*]u32
    roomOf: [*]f64
    // How strongly uses pull (0: the packed layout as it is).
    gravity: f64
}

// The relations of one node (relate).
pub const Relations = struct {
    subject: u32
    outgoing: [*]Relation
    outgoingCount: usize
    incoming: [*]Relation
    incomingCount: usize
}

fn allocateBytes(allocator: Allocator, bytes: usize) -> [*]u8 {
    return allocator.alloc(bytes, 16).?
}

pub fn init(graph: *Graph, allocator: Allocator) -> void {
    graph.*.allocator = allocator
    graph.*.arena = aggregates.find()
    unsafe {
        graph.*.nodes = @ptrCast([*]Node, allocateBytes(allocator, MAX_NODES * @sizeOf(Node)))
        graph.*.names = allocateBytes(allocator, NAMES)
        graph.*.nodeOfSymbol = @ptrCast([*]u32, allocateBytes(allocator, index_module.MAX_SYMBOLS * 4))
        graph.*.importFrom = @ptrCast([*]u32, allocateBytes(allocator, MAX_IMPORTS * 4))
        graph.*.importTo = @ptrCast([*]u32, allocateBytes(allocator, MAX_IMPORTS * 4))
        graph.*.order = @ptrCast([*]u32, allocateBytes(allocator, MAX_NODES * 4))
        graph.*.scratch = @ptrCast([*]u32, allocateBytes(allocator, MAX_NODES * 4))
        graph.*.keys = @ptrCast([*]u64, allocateBytes(allocator, MAX_IMPORTS * 8))
        graph.*.keyScratch = @ptrCast([*]u64, allocateBytes(allocator, MAX_IMPORTS * 8))
        graph.*.outgoingCounts = @ptrCast([*]u32, allocateBytes(allocator, MAX_NODES * 4))
        graph.*.incomingCounts = @ptrCast([*]u32, allocateBytes(allocator, MAX_NODES * 4))
        graph.*.kinds = allocateBytes(allocator, MAX_NODES)
        graph.*.ancestors = allocateBytes(allocator, MAX_NODES)
        graph.*.edgeFrom = @ptrCast([*]u32, allocateBytes(allocator, MAX_EDGES * 4))
        graph.*.edgeTo = @ptrCast([*]u32, allocateBytes(allocator, MAX_EDGES * 4))
        graph.*.edgeWeight = @ptrCast([*]u32, allocateBytes(allocator, MAX_EDGES * 4))
        graph.*.edgePull = @ptrCast([*]f64, allocateBytes(allocator, MAX_EDGES * 8))
        graph.*.byTarget = @ptrCast([*]u32, allocateBytes(allocator, MAX_EDGES * 4))
        graph.*.edgeKeys = @ptrCast([*]u64, allocateBytes(allocator, MAX_EDGES * 8))
        graph.*.edgeScratch = @ptrCast([*]u64, allocateBytes(allocator, MAX_EDGES * 8))
        graph.*.anchorX = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.anchorY = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.anchorZ = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.forceX = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.forceY = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.forceZ = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.moveX = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.moveY = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.moveZ = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.mass = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.absoluteX = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.absoluteY = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.absoluteZ = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
        graph.*.parentOf = @ptrCast([*]u32, allocateBytes(allocator, MAX_NODES * 4))
        graph.*.roomOf = @ptrCast([*]f64, allocateBytes(allocator, MAX_NODES * 8))
    }
    graph.*.gravity = 1.0
    graph.*.edgeCount = 0
    var at: usize = 0
    while at < MAX_NODES {
        graph.*.outgoingCounts[at] = 0
        graph.*.incomingCounts[at] = 0
        graph.*.ancestors[at] = 0
        at += 1
    }
    graph.*.count = 0
}

pub fn nodeAt(graph: *Graph, node: u32) -> *Node {
    unsafe { return @ptrFromInt(*Node, @intFromPtr(graph.*.nodes) + @intCast(usize, node) * @sizeOf(Node)) }
}

pub fn nameOf(graph: *Graph, node: u32) -> []const u8 {
    const record = nodeAt(graph, node)
    if record.*.kind == DECLARATION { return index_module.nameOf(graph.*.index, record.*.symbol) }
    return graph.*.names[@intCast(usize, record.*.nameStart)..@intCast(usize, record.*.nameStart + record.*.nameLength)]
}

// A file's or declaration's file path (relative to the root).
pub fn pathOf(graph: *Graph, node: u32) -> []const u8 {
    const record = nodeAt(graph, node)
    if record.*.kind == DIRECTORY { return graph.*.names[0..0] }
    const file = index_module.symbolAt(graph.*.index, record.*.symbol).*.file
    return relative(graph, index_module.pathOf(graph.*.index, file))
}

fn relative(graph: *Graph, path: []const u8) -> []const u8 {
    const root = graph.*.rootPath[0..graph.*.rootLength]
    if path.length > root.length + 1 && index_module.sameBytes(path[0..root.length], root) && path[root.length] == 47 { return path[root.length + 1..path.length] }
    return path
}

fn addName(graph: *Graph, name: []const u8, start: *u32, length: *u32) -> void {
    if graph.*.namesUsed + name.length > NAMES {
        start.* = 0
        length.* = 0
        return
    }
    start.* = @intCast(u32, graph.*.namesUsed)
    length.* = @intCast(u32, name.length)
    for byte in name {
        graph.*.names[graph.*.namesUsed] = byte
        graph.*.namesUsed += 1
    }
}

fn addNode(graph: *Graph, kind: u8, parent: u32, symbol: u32, symbol_kind: u8) -> u32 {
    if graph.*.count >= MAX_NODES { return NONE }
    const node = @intCast(u32, graph.*.count)
    graph.*.count += 1
    const record = nodeAt(graph, node)
    record.*.kind = kind
    record.*.symbolKind = symbol_kind
    record.*.symbol = symbol
    record.*.parent = parent
    record.*.firstChild = NONE
    record.*.lastChild = NONE
    record.*.nextSibling = NONE
    record.*.childCount = 0
    record.*.depth = 0
    record.*.group = node
    record.*.groupIndex = 0
    record.*.nameStart = 0
    record.*.nameLength = 0
    record.*.files = if kind == FILE { 1 } else { 0 }
    record.*.declarations = if kind == DECLARATION { 1 } else { 0 }
    record.*.uses = 0
    record.*.radius = 1.0
    record.*.shell = 0.0
    record.*.extent = 1.0
    record.*.centerX = 0.0
    record.*.centerY = 0.0
    record.*.centerZ = 0.0
    record.*.x = 0.0
    record.*.y = 0.0
    record.*.z = 0.0
    record.*.color = 4294967295
    if parent != NONE {
        const above = nodeAt(graph, parent)
        record.*.depth = above.*.depth + 1
        if above.*.lastChild == NONE {
            above.*.firstChild = node
        } else {
            nodeAt(graph, above.*.lastChild).*.nextSibling = node
        }
        above.*.lastChild = node
        above.*.childCount += 1
    }
    if symbol != NONE { graph.*.nodeOfSymbol[@intCast(usize, symbol)] = node }
    return node
}

// The folder child of `parent` called `name`, made when missing.
fn directory(graph: *Graph, parent: u32, name: []const u8) -> u32 {
    var child = nodeAt(graph, parent).*.firstChild
    while child != NONE {
        const record = nodeAt(graph, child)
        if record.*.kind == DIRECTORY && index_module.sameBytes(nameOf(graph, child), name) { return child }
        child = record.*.nextSibling
    }
    const made = addNode(graph, DIRECTORY, parent, NONE, 0)
    if made == NONE { return parent }
    const record = nodeAt(graph, made)
    var start: u32 = 0
    var length: u32 = 0
    addName(graph, name, &start, &length)
    record.*.nameStart = start
    record.*.nameLength = length
    return made
}

fn isShown(kind: u8) -> bool {
    return kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET || kind == index_module.FUNCTION || kind == index_module.CONST || kind == index_module.VAR || kind == index_module.TEST || kind == index_module.FIELD || kind == index_module.MEMBER
}

pub fn isContainer(kind: u8) -> bool {
    return kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET
}

// A symbol's shown children (and theirs) under `parent`.
fn addDeclarations(graph: *Graph, parent: u32, symbol: u32, depth: u32) -> void {
    const index = graph.*.index
    var child = index_module.symbolAt(index, symbol).*.firstChild
    while child != NONE {
        const record = index_module.symbolAt(index, child)
        if isShown(record.*.kind) {
            const node = addNode(graph, DECLARATION, parent, child, record.*.kind)
            if node != NONE && isContainer(record.*.kind) && depth < 4 { addDeclarations(graph, node, child, depth + 1) }
        }
        child = record.*.nextSibling
    }
}

// Names compared as people read them (case aside).
fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn nameBefore(first: []const u8, second: []const u8) -> bool {
    var at: usize = 0
    while at < first.length && at < second.length {
        const a = lower(first[at])
        const b = lower(second[at])
        if a != b { return a < b }
        at += 1
    }
    return first.length < second.length
}

// Folders first, then files, each by name.
fn childBefore(graph: *Graph, a: u32, b: u32) -> bool {
    const first = nodeAt(graph, a)
    const second = nodeAt(graph, b)
    if first.*.kind != second.*.kind { return first.*.kind < second.*.kind }
    return nameBefore(nameOf(graph, a), nameOf(graph, b))
}

// Sorts a folder's children (insertion: folders hold few).
fn sortChildren(graph: *Graph, node: u32) -> void {
    const record = nodeAt(graph, node)
    var count: usize = 0
    var child = record.*.firstChild
    while child != NONE {
        graph.*.scratch[count] = child
        count += 1
        child = nodeAt(graph, child).*.nextSibling
    }
    var at: usize = 1
    while at < count {
        const value = graph.*.scratch[at]
        var place = at
        while place > 0 && childBefore(graph, value, graph.*.scratch[place - 1]) {
            graph.*.scratch[place] = graph.*.scratch[place - 1]
            place -= 1
        }
        graph.*.scratch[place] = value
        at += 1
    }
    if count == 0 { return }
    record.*.firstChild = graph.*.scratch[0]
    at = 0
    while at < count {
        nodeAt(graph, graph.*.scratch[at]).*.nextSibling = if at + 1 < count { graph.*.scratch[at + 1] } else { NONE }
        at += 1
    }
    record.*.lastChild = graph.*.scratch[count - 1]
}

// ---------------------------------------------------------------------------
// Colors (the sizes and places: layout.mlx)

// The groups' colors, in turn.
pub fn groupColor(index: u32) -> u32 {
    const at = index % 10
    if at == 0 { return 4284131839 }
    if at == 1 { return 4294937180 }
    if at == 2 { return 4286306447 }
    if at == 3 { return 4291269354 }
    if at == 4 { return 4294953835 }
    if at == 5 { return 4283289825 }
    if at == 6 { return 4293947768 }
    if at == 7 { return 4288921228 }
    if at == 8 { return 4291856240 }
    return 4287225343
}

// Declarations by kind.
pub fn kindColor(kind: u8) -> u32 {
    if kind == index_module.FUNCTION { return 4290303999 }
    if kind == index_module.STRUCT || kind == index_module.UNION { return 4282372288 }
    if kind == index_module.ENUM || kind == index_module.ERROR_SET { return 4289760511 }
    if kind == index_module.CONST { return 4294953047 }
    if kind == index_module.VAR { return 4294933099 }
    if kind == index_module.TEST { return 4285257323 }
    return 4287603647
}

fn colors(graph: *Graph) -> void {
    var at: usize = 0
    while at < graph.*.count {
        const node = @intCast(u32, at)
        const record = nodeAt(graph, node)
        if record.*.parent == graph.*.root || record.*.parent == NONE {
            record.*.group = node
        } else {
            record.*.group = nodeAt(graph, record.*.parent).*.group
        }
        record.*.groupIndex = nodeAt(graph, record.*.group).*.groupIndex
        if record.*.kind == DECLARATION {
            record.*.color = kindColor(record.*.symbolKind)
        } else {
            record.*.color = groupColor(record.*.groupIndex)
        }
        at += 1
    }
    nodeAt(graph, graph.*.root).*.color = 4291611852
}

// ---------------------------------------------------------------------------
// Building

// Makes the graph of what `index` holds (built), `root` the tree's root.
pub fn build(graph: *Graph, index: *Index, root: []const u8) -> void {
    graph.*.index = index
    graph.*.count = 0
    graph.*.namesUsed = 0
    graph.*.importCount = 0
    graph.*.rootPath = index.*.root
    graph.*.rootLength = index.*.rootLength
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        graph.*.nodeOfSymbol[symbol] = NONE
        symbol += 1
    }
    // The root folder, named after its last part.
    var last = root.length
    while last > 0 && root[last - 1] != 47 { last -= 1 }
    graph.*.root = addNode(graph, DIRECTORY, NONE, NONE, 0)
    var start: u32 = 0
    var length: u32 = 0
    addName(graph, root[last..root.length], &start, &length)
    nodeAt(graph, graph.*.root).*.nameStart = start
    nodeAt(graph, graph.*.root).*.nameLength = length
    // Folders and files.
    var file: usize = 0
    while file < index.*.fileCount {
        const path = index_module.pathOf(index, @intCast(u32, file))
        const inside = relative(graph, path)
        var parent = graph.*.root
        if inside.length == path.length { parent = directory(graph, parent, "(outside)") }
        var part: usize = 0
        var at: usize = 0
        while at < inside.length {
            if inside[at] == 47 {
                if at > part { parent = directory(graph, parent, inside[part..at]) }
                part = at + 1
            }
            at += 1
        }
        const file_symbol = index_module.fileAt(index, @intCast(u32, file)).*.symbol
        const node = addNode(graph, FILE, parent, file_symbol, index_module.FILE)
        if node != NONE {
            addName(graph, inside[part..inside.length], &start, &length)
            nodeAt(graph, node).*.nameStart = start
            nodeAt(graph, node).*.nameLength = length
        }
        file += 1
    }
    // Folders sorted; the root's children numbered (their colors).
    var at: usize = 0
    const folders = graph.*.count
    while at < folders {
        if nodeAt(graph, @intCast(u32, at)).*.kind == DIRECTORY { sortChildren(graph, @intCast(u32, at)) }
        at += 1
    }
    var group: u32 = 0
    var child = nodeAt(graph, graph.*.root).*.firstChild
    while child != NONE {
        nodeAt(graph, child).*.groupIndex = group
        group += 1
        child = nodeAt(graph, child).*.nextSibling
    }
    graph.*.groupCount = group
    // Each file's declarations.
    at = 0
    while at < folders {
        const record = nodeAt(graph, @intCast(u32, at))
        if record.*.kind == FILE { addDeclarations(graph, @intCast(u32, at), record.*.symbol, 0) }
        at += 1
    }
    countUses(graph)
    collectImports(graph)
    collectEdges(graph)
    layout_module.sizes(graph)
    colors(graph)
    // Then the uses pull (on positions still relative to the parents).
    if graph.*.gravity > 0.0 { layout_module.relax(graph, 36) }
    // Places: from relative to their parents to where they are, parents
    // first.
    at = 0
    while at < graph.*.count {
        const record = nodeAt(graph, @intCast(u32, at))
        if record.*.parent == NONE {
            record.*.x = 0.0
            record.*.y = 0.0
            record.*.z = 0.0
        } else {
            const above = nodeAt(graph, record.*.parent)
            record.*.x = record.*.x + above.*.x
            record.*.y = record.*.y + above.*.y
            record.*.z = record.*.z + above.*.z
        }
        at += 1
    }
}

// The shown node a symbol is in (itself, or the declaration around it).
pub fn nodeAround(graph: *Graph, symbol: u32) -> u32 {
    var current = symbol
    var steps: usize = 0
    while current != NONE && steps < 16 {
        const node = graph.*.nodeOfSymbol[@intCast(usize, current)]
        if node != NONE { return node }
        current = index_module.symbolAt(graph.*.index, current).*.parent
        steps += 1
    }
    return NONE
}

fn countUses(graph: *Graph) -> void {
    const index = graph.*.index
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use != index_module.USE_DECLARATION && value.*.symbol != NONE {
            const node = graph.*.nodeOfSymbol[@intCast(usize, value.*.symbol)]
            if node != NONE { nodeAt(graph, node).*.uses += 1 }
        }
        ref += 1
    }
}

// Sorts keys[0..count] (a merge sort).
fn sortKeys(graph: *Graph, count: usize) -> void {
    var source = graph.*.keys
    var target = graph.*.keyScratch
    var width: usize = 1
    while width < count {
        var low: usize = 0
        while low < count {
            const middle = if low + width < count { low + width } else { count }
            const high = if low + width * 2 < count { low + width * 2 } else { count }
            var left = low
            var right = middle
            var out = low
            while out < high {
                if left < middle && (right >= high || source[left] <= source[right]) {
                    target[out] = source[left]
                    left += 1
                } else {
                    target[out] = source[right]
                    right += 1
                }
                out += 1
            }
            low = high
        }
        const swap = source
        source = target
        target = swap
        width = width * 2
    }
    if @intFromPtr(source) != @intFromPtr(graph.*.keys) {
        var at: usize = 0
        while at < count {
            graph.*.keys[at] = source[at]
            at += 1
        }
    }
}

fn collectImports(graph: *Graph) -> void {
    const index = graph.*.index
    var count: usize = 0
    var ref: usize = 0
    while ref < index.*.refCount && count < MAX_IMPORTS {
        const value = index_module.refAt(index, ref)
        if value.*.use == index_module.USE_IMPORT && value.*.symbol != NONE {
            const from = graph.*.nodeOfSymbol[@intCast(usize, index_module.fileAt(index, value.*.file).*.symbol)]
            const to = graph.*.nodeOfSymbol[@intCast(usize, value.*.symbol)]
            if from != NONE && to != NONE && from != to {
                graph.*.keys[count] = (@intCast(u64, from) << 32) | @intCast(u64, to)
                count += 1
            }
        }
        ref += 1
    }
    sortKeys(graph, count)
    var at: usize = 0
    while at < count {
        if at == 0 || graph.*.keys[at] != graph.*.keys[at - 1] {
            graph.*.importFrom[graph.*.importCount] = @intCast(u32, graph.*.keys[at] >> 32)
            graph.*.importTo[graph.*.importCount] = @intCast(u32, graph.*.keys[at] & 4294967295)
            graph.*.importCount += 1
        }
        at += 1
    }
}

// ---------------------------------------------------------------------------
// Questions

pub fn isUnder(graph: *Graph, node: u32, ancestor: u32) -> bool {
    var current = node
    while current != NONE {
        if current == ancestor { return true }
        current = nodeAt(graph, current).*.parent
    }
    return false
}

// Whether index symbol `symbol` is `ancestor` or declared inside it.
fn symbolInside(graph: *Graph, symbol: u32, ancestor: u32) -> bool {
    var current = symbol
    var steps: usize = 0
    while current != NONE && steps < 24 {
        if current == ancestor { return true }
        current = index_module.symbolAt(graph.*.index, current).*.parent
        steps += 1
    }
    return false
}

fn note(graph: *Graph, counts: [*]u32, touched: [*]u32, touched_count: *usize, node: u32, kind: u8) -> void {
    if node == NONE { return }
    const at = @intCast(usize, node)
    if counts[at] == 0 {
        if touched_count.* >= MAX_RELATED { return }
        touched[touched_count.*] = node
        touched_count.* += 1
        graph.*.kinds[at] = kind
    }
    counts[at] += 1
    // A call wins over a use.
    if kind == RELATION_CALL { graph.*.kinds[at] = RELATION_CALL }
}

// The child of a common ancestor of `subject` (marked in ancestors) that
// `node` is under: what a folder's connection to it is shown as.
fn besideOf(graph: *Graph, node: u32) -> u32 {
    var current = node
    while current != NONE {
        const parent = nodeAt(graph, current).*.parent
        if parent == NONE || graph.*.ancestors[@intCast(usize, parent)] != 0 { return current }
        current = parent
    }
    return node
}

fn markAncestors(graph: *Graph, node: u32, value: u8) -> void {
    var current = node
    while current != NONE {
        graph.*.ancestors[@intCast(usize, current)] = value
        current = nodeAt(graph, current).*.parent
    }
}

// Turns the counted nodes into relations, the most first.
fn gather(graph: *Graph, counts: [*]u32, touched: [*]u32, count: usize, out: [*]Relation) -> usize {
    var at: usize = 0
    while at < count {
        const node = touched[at]
        const record = Relation.{ .node = node, .count = counts[@intCast(usize, node)], .kind = graph.*.kinds[@intCast(usize, node)] }
        counts[@intCast(usize, node)] = 0
        // Insertion by count (the lists are short).
        var place = at
        while place > 0 && out[place - 1].count < record.count {
            out[place] = out[place - 1]
            place -= 1
        }
        out[place] = record
        at += 1
    }
    return count
}

// What `subject` connects to: for a declaration the declarations it
// calls or uses and those calling or using it (its members' uses too);
// for a file the files it imports and those importing it; for a folder
// the same, gathered by the groups beside it.
pub fn relate(graph: *Graph, subject: u32, relations: *Relations) -> void {
    relations.*.subject = subject
    relations.*.outgoingCount = 0
    relations.*.incomingCount = 0
    if subject == NONE { return }
    const index = graph.*.index
    const record = nodeAt(graph, subject)
    var out_count: usize = 0
    var in_count: usize = 0
    const out_touched = graph.*.order
    const in_touched = graph.*.scratch
    if record.*.kind == DECLARATION {
        const symbol = record.*.symbol
        var ref: usize = 0
        while ref < index.*.refCount {
            const value = index_module.refAt(index, ref)
            // What a use means: a module's name alone is left out (its
            // members' uses say more), an alias stands for its type.
            var target = if value.*.use != index_module.USE_DECLARATION && value.*.use != index_module.USE_IMPORT { value.*.symbol } else { NONE }
            if target != NONE {
                const target_kind = index_module.symbolAt(index, target).*.kind
                if target_kind == index_module.IMPORT { target = NONE } else if target_kind == index_module.ALIAS { target = index_module.symbolAt(index, target).*.target }
            }
            if target != NONE {
                const from_inside = value.*.from != NONE && symbolInside(graph, value.*.from, symbol)
                const to_inside = symbolInside(graph, target, symbol)
                const kind = if value.*.use == index_module.USE_CALL { RELATION_CALL } else { RELATION_USE }
                if from_inside && !to_inside {
                    note(graph, graph.*.outgoingCounts, out_touched, &out_count, nodeAround(graph, target), kind)
                } else if to_inside && !from_inside {
                    var from = if value.*.from != NONE { nodeAround(graph, value.*.from) } else { NONE }
                    if from == NONE { from = graph.*.nodeOfSymbol[@intCast(usize, index_module.fileAt(index, value.*.file).*.symbol)] }
                    note(graph, graph.*.incomingCounts, in_touched, &in_count, from, kind)
                }
            }
            ref += 1
        }
    } else {
        // Imports: a file's own, a folder's gathered.
        const folder = record.*.kind == DIRECTORY
        if folder { markAncestors(graph, subject, 1) }
        var at: usize = 0
        while at < graph.*.importCount {
            const from = graph.*.importFrom[at]
            const to = graph.*.importTo[at]
            const from_inside = if folder { isUnder(graph, from, subject) } else { from == subject }
            const to_inside = if folder { isUnder(graph, to, subject) } else { to == subject }
            if from_inside && !to_inside {
                note(graph, graph.*.outgoingCounts, out_touched, &out_count, if folder { besideOf(graph, to) } else { to }, RELATION_IMPORT)
            } else if to_inside && !from_inside {
                note(graph, graph.*.incomingCounts, in_touched, &in_count, if folder { besideOf(graph, from) } else { from }, RELATION_IMPORT)
            }
            at += 1
        }
        if folder { markAncestors(graph, subject, 0) }
    }
    relations.*.outgoingCount = gather(graph, graph.*.outgoingCounts, out_touched, out_count, relations.*.outgoing)
    relations.*.incomingCount = gather(graph, graph.*.incomingCounts, in_touched, in_count, relations.*.incoming)
}

// ---------------------------------------------------------------------------
// Search

// Where `text` is first in `name`, ignoring case (1000000: nowhere). A
// search asks every node's name: the rest is compared only where the
// first letter is.
fn matchAt(name: []const u8, text: []const u8) -> usize {
    if text.length == 0 || text.length > name.length { return 1000000 }
    const first = lower(text[0])
    const last = name.length - text.length
    var start: usize = 0
    while start <= last {
        if lower(name[start]) == first {
            var at: usize = 1
            while at < text.length && lower(name[start + at]) == lower(text[at]) { at += 1 }
            if at == text.length { return start }
        }
        start += 1
    }
    return 1000000
}

// How well a node's name matches (lower: better; NONE: not).
pub fn matchScore(graph: *Graph, node: u32, text: []const u8) -> u32 {
    const name = nameOf(graph, node)
    const found = matchAt(name, text)
    if found == 1000000 { return NONE }
    var score: u32 = if found == 0 { if name.length == text.length { 0 } else { 1000 } } else { 2000 }
    const record = nodeAt(graph, node)
    // Groups, files and types before functions, before the rest.
    if record.*.kind == DIRECTORY {
        score += 0
    } else if record.*.kind == FILE || isContainer(record.*.symbolKind) {
        score += 100
    } else if record.*.symbolKind == index_module.FUNCTION {
        score += 200
    } else {
        score += 300
    }
    score += @intCast(u32, if name.length < 99 { name.length } else { 99 })
    return score
}

// The best `capacity` matches of `text` into results, the best first; how
// many.
pub fn search(graph: *Graph, text: []const u8, results: [*]u32, scores: [*]u32, capacity: usize) -> usize {
    var count: usize = 0
    var node: usize = 1
    while node < graph.*.count {
        const score = matchScore(graph, @intCast(u32, node), text)
        if score != NONE && (count < capacity || score < scores[count - 1]) {
            var place = if count < capacity { count } else { capacity - 1 }
            if count < capacity { count += 1 }
            while place > 0 && scores[place - 1] > score {
                results[place] = results[place - 1]
                scores[place] = scores[place - 1]
                place -= 1
            }
            results[place] = @intCast(u32, node)
            scores[place] = score
        }
        node += 1
    }
    return count
}

// ---------------------------------------------------------------------------
// The galaxy: every use pulls

fn sortEdgeKeys(graph: *Graph, count: usize) -> void {
    var source = graph.*.edgeKeys
    var target = graph.*.edgeScratch
    var width: usize = 1
    while width < count {
        var low: usize = 0
        while low < count {
            const middle = if low + width < count { low + width } else { count }
            const high = if low + width * 2 < count { low + width * 2 } else { count }
            var left = low
            var right = middle
            var out = low
            while out < high {
                if left < middle && (right >= high || source[left] <= source[right]) {
                    target[out] = source[left]
                    left += 1
                } else {
                    target[out] = source[right]
                    right += 1
                }
                out += 1
            }
            low = high
        }
        const swap = source
        source = target
        target = swap
        width = width * 2
    }
    if @intFromPtr(source) != @intFromPtr(graph.*.edgeKeys) {
        var at: usize = 0
        while at < count {
            graph.*.edgeKeys[at] = source[at]
            at += 1
        }
    }
}

// The uses as weighted node pairs: the declaration a use is in (else its
// file) and the declaration used; within one line of descent left out.
fn collectEdges(graph: *Graph) -> void {
    const index = graph.*.index
    var count: usize = 0
    var ref: usize = 0
    while ref < index.*.refCount && count < MAX_EDGES {
        const value = index_module.refAt(index, ref)
        var target = if value.*.use != index_module.USE_DECLARATION && value.*.use != index_module.USE_IMPORT { value.*.symbol } else { NONE }
        if target != NONE {
            const target_kind = index_module.symbolAt(index, target).*.kind
            if target_kind == index_module.IMPORT { target = NONE } else if target_kind == index_module.ALIAS { target = index_module.symbolAt(index, target).*.target }
        }
        if target != NONE {
            const to = nodeAround(graph, target)
            var from = if value.*.from != NONE { nodeAround(graph, value.*.from) } else { NONE }
            if from == NONE { from = graph.*.nodeOfSymbol[@intCast(usize, index_module.fileAt(index, value.*.file).*.symbol)] }
            if from != NONE && to != NONE && from != to && !isUnder(graph, from, to) && !isUnder(graph, to, from) {
                graph.*.edgeKeys[count] = (@intCast(u64, from) << 32) | @intCast(u64, to)
                count += 1
            }
        }
        ref += 1
    }
    sortEdgeKeys(graph, count)
    graph.*.edgeCount = 0
    var at: usize = 0
    while at < count {
        var end = at + 1
        while end < count && graph.*.edgeKeys[end] == graph.*.edgeKeys[at] { end += 1 }
        const edge = graph.*.edgeCount
        graph.*.edgeFrom[edge] = @intCast(u32, graph.*.edgeKeys[at] >> 32)
        graph.*.edgeTo[edge] = @intCast(u32, graph.*.edgeKeys[at] & 4294967295)
        graph.*.edgeWeight[edge] = @intCast(u32, end - at)
        graph.*.edgePull[edge] = math.ln(1.0 + m.toFloat(@intCast(i64, end - at)))
        graph.*.edgeCount += 1
        at = end
    }
    // The order by the used.
    at = 0
    while at < graph.*.edgeCount {
        graph.*.edgeKeys[at] = (@intCast(u64, graph.*.edgeTo[at]) << 32) | at
        at += 1
    }
    sortEdgeKeys(graph, graph.*.edgeCount)
    at = 0
    while at < graph.*.edgeCount {
        graph.*.byTarget[at] = @intCast(u32, graph.*.edgeKeys[at] & 4294967295)
        at += 1
    }
}

// Nodes used much as `node` is using (the same declarations, as a share
// of all either uses), the likest first, into out and shares (percent);
// how many.
pub fn similar(graph: *Graph, node: u32, out: [*]u32, shares: [*]u32, capacity: usize) -> usize {
    if node == NONE || graph.*.edgeCount == 0 { return 0 }
    // Its uses: the edges from it (sorted by user).
    var low: usize = 0
    var high = graph.*.edgeCount
    while low < high {
        const middle = (low + high) / 2
        if graph.*.edgeFrom[middle] < node { low = middle + 1 } else { high = middle }
    }
    const first = low
    var last = first
    while last < graph.*.edgeCount && graph.*.edgeFrom[last] == node { last += 1 }
    const own = last - first
    if own == 0 { return 0 }
    // Who else uses each of them.
    var touched: usize = 0
    const counts = graph.*.outgoingCounts
    const list = graph.*.order
    var edge = first
    while edge < last {
        const target = graph.*.edgeTo[edge]
        var lo: usize = 0
        var hi = graph.*.edgeCount
        while lo < hi {
            const middle = (lo + hi) / 2
            if graph.*.edgeTo[@intCast(usize, graph.*.byTarget[middle])] < target { lo = middle + 1 } else { hi = middle }
        }
        while lo < graph.*.edgeCount && graph.*.edgeTo[@intCast(usize, graph.*.byTarget[lo])] == target {
            const other = graph.*.edgeFrom[@intCast(usize, graph.*.byTarget[lo])]
            if other != node && nodeAt(graph, other).*.kind == nodeAt(graph, node).*.kind {
                if counts[@intCast(usize, other)] == 0 && touched < MAX_RELATED {
                    list[touched] = other
                    touched += 1
                }
                counts[@intCast(usize, other)] += 1
            }
            lo += 1
        }
        edge += 1
    }
    // Their shares (shared / all the two use), best first.
    var found: usize = 0
    var at: usize = 0
    while at < touched {
        const other = list[at]
        const shared = @intCast(usize, counts[@intCast(usize, other)])
        counts[@intCast(usize, other)] = 0
        var lo: usize = 0
        var hi = graph.*.edgeCount
        while lo < hi {
            const middle = (lo + hi) / 2
            if graph.*.edgeFrom[middle] < other { lo = middle + 1 } else { hi = middle }
        }
        var end = lo
        while end < graph.*.edgeCount && graph.*.edgeFrom[end] == other { end += 1 }
        const theirs = end - lo
        const share = @intCast(u32, shared * 100 / (own + theirs - shared))
        if shared >= 2 && share >= 20 {
            var place = if found < capacity { found } else { capacity }
            if place < capacity || share > shares[capacity - 1] {
                if place == capacity { place = capacity - 1 }
                while place > 0 && shares[place - 1] < share {
                    out[place] = out[place - 1]
                    shares[place] = shares[place - 1]
                    place -= 1
                }
                out[place] = other
                shares[place] = share
                if found < capacity { found += 1 }
            }
        }
        at += 1
    }
    return found
}

// How often `node` is used from outside itself (the weights of the edges
// to it).
pub fn weightTo(graph: *Graph, node: u32) -> u32 {
    var lo: usize = 0
    var hi = graph.*.edgeCount
    while lo < hi {
        const middle = (lo + hi) / 2
        if graph.*.edgeTo[@intCast(usize, graph.*.byTarget[middle])] < node { lo = middle + 1 } else { hi = middle }
    }
    var total: u32 = 0
    while lo < graph.*.edgeCount && graph.*.edgeTo[@intCast(usize, graph.*.byTarget[lo])] == node {
        total += graph.*.edgeWeight[@intCast(usize, graph.*.byTarget[lo])]
        lo += 1
    }
    return total
}
