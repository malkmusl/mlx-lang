// Memory under Findings: the programs' memory as std.leaks writes it while
// they run with MLX_LEAK_CHECK (tools/codemap/memory.mlx reads it), read
// again when it changes (about once a second while one runs). At the top
// of the panel the programs that wrote one (running first; a click shows
// that one), a button that runs the program chosen with the watch on, what
// it holds and what its pages waste, its blocks by size class and the
// address space as a strip: each block as full as its pages are, the
// holes between them, and how scattered they are. Below, the declarations
// whose places hold the most, as every finding lists its functions (part
// of main.mlx, split from it).
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const glyphs = @import("std.ui.glyphs")
const ui = @import("std.ui")
const text_module = @import("std.ui.text")
const index_module = @import("../../tools/codemap/index.mlx")
const memory_module = @import("../../tools/codemap/memory.mlx")
const programs_module = @import("../../tools/codemap/programs.mlx")
const binaries_module = @import("../../tools/codemap/binaries.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const detail_module = @import("./detail.mlx")
const lists_module = @import("./lists.mlx")
const navigation_module = @import("./navigation.mlx")
const actions_module = @import("./actions.mlx")

// The snapshots listed at the top, at most.
const SHOWN_SNAPSHOTS: usize = 6

pub fn memoryOf(codemap: *app.Codemap) -> *memory_module.Memory {
    unsafe { return @ptrCast(*memory_module.Memory, &codemap.*.memory) }
}

pub fn init(codemap: *app.Codemap) -> void {
    const allocator = codemap.*.allocator
    memory_module.init(memoryOf(codemap), allocator)
    codemap.*.memoryTime = -1
    codemap.*.memoryPid = 0
    codemap.*.memoryCheckAt = 0
    codemap.*.memoryCapacity = 0
    codemap.*.memoryOutside = 0
    codemap.*.memoryPlaceSymbol = allocator.words(memory_module.MAX_PLACES)
    codemap.*.memoryGpuPlaceSymbol = allocator.words(memory_module.MAX_GPU_PLACES)
    unsafe { codemap.*.memoryOrder = @ptrCast([*]u64, allocator.alloc(memory_module.MAX_BLOCKS * 8, 16).?) }
}

// $XDG_RUNTIME_DIR/mlx/SUBDIRECTORY (the frame timelines' too).
pub fn directoryOf(codemap: *app.Codemap, into: [*]u8, subdirectory: []const u8) -> usize {
    return memory_module.directoryOf(codemap.*.environment, into, subdirectory)
}

// When the snapshots' directory last changed (-1: there is none): a
// snapshot is renamed into place, which changes it.
fn directoryTime(codemap: *app.Codemap) -> isize {
    var path: [4096]u8 = undefined
    const bytes: [*]u8 = &path
    if memory_module.directory(codemap.*.environment, bytes) == 0 { return -1 }
    var status: std.fs.Stat = undefined
    if std.fs.status(bytes, &status) != 0 { return -1 }
    return status.modifiedSeconds * 1000 + status.modifiedNanoseconds / 1000000
}

// Reads the snapshots again when one changed; true when it did.
pub fn refresh(codemap: *app.Codemap) -> bool {
    const time = directoryTime(codemap)
    if time == codemap.*.memoryTime { return false }
    codemap.*.memoryTime = time
    reload(codemap)
    return true
}

// The name of the program chosen as its binary is called (what std.leaks
// names the snapshot by); empty when none is chosen or built.
pub fn chosenName(codemap: *app.Codemap) -> []const u8 {
    if !access_module.programChosen(codemap) { return "" }
    const binaries = access_module.binariesOf(codemap)
    const binary = binaries_module.binaryOf(binaries, codemap.*.program)
    if binary >= binaries.*.count { return "" }
    const path = binaries_module.pathOf(binaries, binary)
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    return path[start..path.length]
}

// The snapshot to show: the one clicked (by its process), else the newest
// of the program chosen, else the newest of a running program, else the
// newest; the count: none.
fn shownSnapshot(codemap: *app.Codemap) -> usize {
    const memory = memoryOf(codemap)
    var which: usize = 0
    while codemap.*.memoryPid != 0 && which < memory.*.count {
        if memory.*.pid[which] == codemap.*.memoryPid { return which }
        which += 1
    }
    codemap.*.memoryPid = 0
    const name = chosenName(codemap)
    if name.length > 0 {
        const newest = memory_module.newestOf(memory, name)
        if newest < memory.*.count { return newest }
    }
    var best = memory.*.count
    which = 0
    while which < memory.*.count {
        if best == memory.*.count || (memory.*.running[which] && !memory.*.running[best]) || (memory.*.running[which] == memory.*.running[best] && memory.*.time[which] > memory.*.time[best]) { best = which }
        which += 1
    }
    return best
}

// The snapshots listed again and the one shown read: its places put on
// their declarations (the pages each holds), its blocks in address order.
pub fn reload(codemap: *app.Codemap) -> void {
    const memory = memoryOf(codemap)
    memory_module.list(memory, codemap.*.environment)
    memory.*.loaded = memory.*.count
    codemap.*.memoryOutside = 0
    const symbols = codemap.*.builtSymbols
    if symbols > codemap.*.memoryCapacity {
        if codemap.*.memoryCapacity > 0 {
            var old: [*]u8 = undefined
            unsafe { old = @ptrCast([*]u8, codemap.*.memoryBytes) }
            codemap.*.allocator.free(old, codemap.*.memoryCapacity * 8, 16)
        }
        const capacity = symbols + 4096
        unsafe { codemap.*.memoryBytes = @ptrCast([*]u64, codemap.*.allocator.alloc(capacity * 8, 16).?) }
        codemap.*.memoryCapacity = capacity
    }
    var symbol: usize = 0
    while symbol < codemap.*.memoryCapacity {
        codemap.*.memoryBytes[symbol] = 0
        symbol += 1
    }
    const which = shownSnapshot(codemap)
    if which >= memory.*.count || !memory_module.load(memory, which) {
        memory.*.loaded = memory.*.count
        return
    }
    var place: usize = 0
    while place < memory.*.placeCount {
        const declaration = memory_module.placeDeclaration(memory, codemap.*.index, place)
        codemap.*.memoryPlaceSymbol[place] = declaration
        if declaration != app.NONE && @intCast(usize, declaration) < codemap.*.memoryCapacity {
            codemap.*.memoryBytes[@intCast(usize, declaration)] += memory.*.placeMapped[place]
        } else {
            codemap.*.memoryOutside += 1
        }
        place += 1
    }
    // The GPU's places on their declarations too (what the device took).
    place = 0
    while place < memory.*.gpuPlaceCount {
        const declaration = memory_module.gpuPlaceDeclaration(memory, codemap.*.index, place)
        codemap.*.memoryGpuPlaceSymbol[place] = declaration
        if declaration != app.NONE && @intCast(usize, declaration) < codemap.*.memoryCapacity {
            codemap.*.memoryBytes[@intCast(usize, declaration)] += memory.*.gpuPlaceSize[place]
        }
        place += 1
    }
    // Address order (the addresses are whole pages: the page number and
    // the block's index make one key).
    var block: usize = 0
    while block < memory.*.blockCount {
        codemap.*.memoryOrder[block] = ((memory.*.blockAddress[block] >> 12) << 16) | @intCast(u64, block)
        block += 1
    }
    std.mem.sortU64(codemap.*.memoryOrder, memory.*.blockCount)
    if codemap.*.trace {
        var text: [200]u8 = undefined
        const bytes: [*]u8 = &text
        var length = filters_module.writeText(bytes, 0, memory_module.nameOf(memory, which))
        length = filters_module.writeText(bytes, length, " pid ")
        length = lists_module.writeNumberPlain(bytes, length, @intCast(usize, memory.*.pid[which]))
        length = filters_module.writeText(bytes, length, ": ")
        length = lists_module.writeNumberPlain(bytes, length, memory.*.placeCount)
        length = filters_module.writeText(bytes, length, " places, ")
        length = lists_module.writeNumberPlain(bytes, length, memory.*.placeCount - codemap.*.memoryOutside)
        length = filters_module.writeText(bytes, length, " on declarations, ")
        length = lists_module.writeNumberPlain(bytes, length, memory.*.blockCount)
        length = filters_module.writeText(bytes, length, " blocks, ")
        length = lists_module.writeNumberPlain(bytes, length, @intCast(usize, memory.*.holes))
        length = filters_module.writeText(bytes, length, " holes")
        if memory.*.gpu {
            length = filters_module.writeText(bytes, length, ", ")
            length = lists_module.writeNumberPlain(bytes, length, memory.*.gpuBlockCount)
            length = filters_module.writeText(bytes, length, " GPU blocks in ")
            length = lists_module.writeNumberPlain(bytes, length, memory.*.gpuPlaceCount)
            length = filters_module.writeText(bytes, length, " places")
        }
        navigation_module.traceLine(codemap, "memory ", bytes[0..length])
    }
}

// Whether a snapshot is shown.
pub fn loaded(codemap: *app.Codemap) -> bool {
    const memory = memoryOf(codemap)
    return memory.*.loaded < memory.*.count
}

// The pages the places of `symbol` hold (0: none), for the finding's list.
pub fn weightOf(codemap: *app.Codemap, symbol: u32) -> u64 {
    if !loaded(codemap) || @intCast(usize, symbol) >= codemap.*.memoryCapacity { return 0 }
    return codemap.*.memoryBytes[@intCast(usize, symbol)]
}

// Shows the snapshot of process `pid` (a row clicked).
pub fn choose(codemap: *app.Codemap, pid: u32) -> void {
    codemap.*.memoryPid = @intCast(u64, pid)
    reload(codemap)
    filters_module.refreshFindings(codemap)
}

// The watch started for the program chosen: its newest snapshot is shown.
pub fn followChosen(codemap: *app.Codemap) -> void {
    codemap.*.memoryPid = 0
    codemap.*.memoryTime = -2
}

// A size: bytes, KiB, or MiB or GiB with a tenth.
fn writeSize(codemap: *app.Codemap, out: [*]u8, at: usize, bytes: u64) -> usize {
    if bytes >= 1073741824 {
        var length = filters_module.writeNumber(codemap, out, at, @intCast(usize, bytes / 1073741824))
        length = filters_module.writeText(out, length, if codemap.*.german { "," } else { "." })
        length = lists_module.writeNumberPlain(out, length, @intCast(usize, bytes % 1073741824 * 10 / 1073741824))
        return filters_module.writeText(out, length, " GiB")
    }
    if bytes >= 1048576 {
        var length = filters_module.writeNumber(codemap, out, at, @intCast(usize, bytes / 1048576))
        length = filters_module.writeText(out, length, if codemap.*.german { "," } else { "." })
        length = lists_module.writeNumberPlain(out, length, @intCast(usize, bytes % 1048576 * 10 / 1048576))
        return filters_module.writeText(out, length, " MiB")
    }
    if bytes >= 10240 {
        const length = filters_module.writeNumber(codemap, out, at, @intCast(usize, bytes / 1024))
        return filters_module.writeText(out, length, " KiB")
    }
    const length = filters_module.writeNumber(codemap, out, at, @intCast(usize, bytes))
    return filters_module.writeText(out, length, " B")
}

// A share in percent ("<1%" for a little but not nothing).
fn writeShare(codemap: *app.Codemap, out: [*]u8, at: usize, part: u64, whole: u64) -> usize {
    const percent = if whole > 0 { part * 100 / whole } else { 0 }
    if percent == 0 && part > 0 { return filters_module.writeText(out, at, "<1%") }
    const length = filters_module.writeNumber(codemap, out, at, @intCast(usize, percent))
    return filters_module.writeText(out, length, "%")
}

// What the places of `symbol` hold: "12 KiB, 3 blocks, 3 new, +2", and
// what of it is the GPU's ("GPU 8 MiB"; only the GPU's: "GPU 8 MiB, 2
// blocks").
pub fn writeMeasure(codemap: *app.Codemap, out: [*]u8, symbol: u32) -> usize {
    const memory = memoryOf(codemap)
    var blocks: u64 = 0
    var fresh: u64 = 0
    var kept: u64 = 0
    var grown: u64 = 0
    var place: usize = 0
    while place < memory.*.placeCount {
        if codemap.*.memoryPlaceSymbol[place] == symbol {
            blocks += memory.*.placeBlocks[place]
            fresh += memory.*.placeFresh[place]
            kept += memory.*.placeKept[place]
            grown += memory.*.placeGrowth[place]
        }
        place += 1
    }
    var gpu_bytes: u64 = 0
    var gpu_blocks: u64 = 0
    place = 0
    while place < memory.*.gpuPlaceCount {
        if codemap.*.memoryGpuPlaceSymbol[place] == symbol {
            gpu_bytes += memory.*.gpuPlaceSize[place]
            gpu_blocks += memory.*.gpuPlaceBlocks[place]
        }
        place += 1
    }
    var length: usize = 0
    if blocks == 0 && gpu_blocks > 0 {
        length = filters_module.writeText(out, 0, "GPU ")
        length = writeSize(codemap, out, length, gpu_bytes)
        blocks = gpu_blocks
        gpu_bytes = 0
    } else {
        length = writeSize(codemap, out, 0, weightOf(codemap, symbol))
    }
    length = filters_module.writeText(out, length, ", ")
    length = filters_module.writeNumber(codemap, out, length, @intCast(usize, blocks))
    length = filters_module.writeText(out, length, if blocks == 1 { access_module.say(codemap, " block", " Block") } else { access_module.say(codemap, " blocks", " Blöcke") })
    if fresh > 0 {
        length = filters_module.writeText(out, length, ", ")
        length = filters_module.writeNumber(codemap, out, length, @intCast(usize, fresh))
        length = filters_module.writeText(out, length, access_module.say(codemap, " new", " neu"))
    }
    if kept > 0 { length = filters_module.writeText(out, length, access_module.say(codemap, ", kept", ", behalten")) }
    if grown > 0 {
        length = filters_module.writeText(out, length, ", +")
        length = filters_module.writeNumber(codemap, out, length, @intCast(usize, grown))
    }
    if gpu_bytes > 0 {
        length = filters_module.writeText(out, length, ", GPU ")
        length = writeSize(codemap, out, length, gpu_bytes)
    }
    return length
}

// What the finding is about.
pub fn about(codemap: *app.Codemap) -> []const u8 {
    return access_module.say(codemap, "What the programs hold, as std.leaks writes it while they run with MLX_LEAK_CHECK=1: what their page blocks waste, how the blocks lie, what they hold on the GPU, and the functions whose blocks hold the most (new: since leaks.mark, +: more blocks than when first looked at, a leak's sign). Read again about once a second.", "Was die Programme belegen, wie std.leaks es schreibt, während sie mit MLX_LEAK_CHECK=1 laufen: was ihre Seitenblöcke verschwenden, wie die Blöcke liegen, was sie auf der GPU belegen, und die Funktionen, deren Blöcke am meisten belegen (neu: seit leaks.mark, +: mehr Blöcke als beim ersten Blick, ein Zeichen für ein Leck). Etwa jede Sekunde neu gelesen.")
}

// How full a block's pages are, as a color: green full, amber half,
// red mostly waste.
fn fillColor(bytes: u64, mapped: u64) -> u32 {
    const share = if mapped > 0 { bytes * 100 / mapped } else { 100 }
    if share >= 85 { return canvas_module.color(255, 92, 190, 128) }
    if share >= 40 { return canvas_module.color(255, 232, 178, 72) }
    return canvas_module.color(255, 230, 96, 92)
}

// A width for `pages` pages: more pages wider, but a thousand times as
// many pages not a thousand times as wide.
fn weight(pages: u64) -> u64 {
    var rest = pages
    var bits: u64 = 0
    while rest > 1 {
        rest = rest >> 1
        bits += 1
    }
    return 2 + bits
}

fn line(codemap: *app.Codemap, canvas: *app.Canvas, text: []const u8, x: i32, y: i32, width: i32, color: u32) -> void {
    if y > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS { text_module.drawText(canvas, access_module.smallOf(codemap), text, x, y, color, width) }
}

fn visible(codemap: *app.Codemap, y: i32, height: i32) -> bool {
    return y + height > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS
}

// The snapshots, running first and newest first: one row each.
fn drawSnapshots(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    const memory = memoryOf(codemap)
    var order: [256]u32 = undefined
    var count: usize = 0
    var which: usize = 0
    while which < memory.*.count {
        var at = count
        while at > 0 {
            const other = @intCast(usize, order[at - 1])
            const before = (memory.*.running[which] && !memory.*.running[other]) || (memory.*.running[which] == memory.*.running[other] && memory.*.time[which] > memory.*.time[other])
            if !before { break }
            order[at] = order[at - 1]
            at -= 1
        }
        order[at] = @intCast(u32, which)
        count += 1
        which += 1
    }
    var y = top
    var text: [200]u8 = undefined
    const bytes: [*]u8 = &text
    var at: usize = 0
    while at < count && at < SHOWN_SNAPSHOTS {
        const snapshot = @intCast(usize, order[at])
        const pid = memory.*.pid[snapshot]
        const area = ui.rect(x - 6, y, width + 12, app.DETAIL_ROW)
        if detail_module.detailRow(codemap, area, @intCast(u32, pid & 4294967295), app.ROW_SNAPSHOT) {
            if snapshot == memory.*.loaded { canvas_module.fillRect(canvas, x - 6, y + 5, 2, app.DETAIL_ROW - 10, filters_module.canvasColor(app.MEMORY_COLOR, 255)) }
            glyphs.dot(canvas, x, y + 8, 8, if memory.*.running[snapshot] { canvas_module.color(255, 92, 190, 128) } else { app.DIM_COLOR })
            text_module.drawText(canvas, access_module.bodyOf(codemap), memory_module.nameOf(memory, snapshot), x + 16, y + 4, app.TEXT_COLOR, width - 150)
            var length = filters_module.writeText(bytes, 0, "pid ")
            length = lists_module.writeNumberPlain(bytes, length, @intCast(usize, pid))
            length = filters_module.writeText(bytes, length, if memory.*.running[snapshot] { access_module.say(codemap, ", running", ", läuft") } else { access_module.say(codemap, ", ended", ", beendet") })
            const note_width = text_module.measure(access_module.smallOf(codemap), bytes[0..length])
            text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + width - note_width, y + 5, app.DIM_COLOR, 0)
        }
        y += app.DETAIL_ROW
        at += 1
    }
    if count > SHOWN_SNAPSHOTS {
        var length = filters_module.writeText(bytes, 0, "+ ")
        length = filters_module.writeNumber(codemap, bytes, length, count - SHOWN_SNAPSHOTS)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " older", " ältere"))
        line(codemap, canvas, bytes[0..length], x + 16, y + 2, width, app.DIM_COLOR)
        y += 20
    }
    return y
}

// The blocks by size class: a bar each, the pages they map with what they
// asked for filled in.
fn drawClasses(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    const memory = memoryOf(codemap)
    const labels: [5][]const u8 = [5][]const u8{ "< 256 B", "< 4 KiB", "< 64 KiB", "< 1 MiB", ">= 1 MiB" }
    var most: u64 = 1
    var class: usize = 0
    while class < memory_module.CLASSES {
        if memory.*.classMapped[class] > most { most = memory.*.classMapped[class] }
        class += 1
    }
    var y = top
    var text: [160]u8 = undefined
    const bytes: [*]u8 = &text
    const bar_x = x + 70
    const bar_width = width - 70
    class = 0
    while class < memory_module.CLASSES {
        if memory.*.classBlocks[class] > 0 {
            line(codemap, canvas, labels[class], x, y, 66, app.DIM_COLOR)
            var length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, memory.*.classBlocks[class]))
            length = filters_module.writeText(bytes, length, " · ")
            length = writeSize(codemap, bytes, length, memory.*.classMapped[class])
            length = filters_module.writeText(bytes, length, " · ")
            length = writeShare(codemap, bytes, length, memory.*.classMapped[class] - memory.*.classBytes[class], memory.*.classMapped[class])
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " wasted", " verschwendet"))
            line(codemap, canvas, bytes[0..length], bar_x, y, bar_width, app.TEXT_COLOR)
            if visible(codemap, y + 17, 6) {
                const mapped_width = @intCast(i32, memory.*.classMapped[class] * @intCast(u64, bar_width) / most)
                const asked_width = @intCast(i32, memory.*.classBytes[class] * @intCast(u64, bar_width) / most)
                canvas_module.fillRoundedRect(canvas, bar_x, y + 17, bar_width, 6, 3, app.SEPARATOR_COLOR)
                if mapped_width > 0 { canvas_module.fillRoundedRect(canvas, bar_x, y + 17, mapped_width, 6, 3, filters_module.canvasColor(app.MEMORY_COLOR, 90)) }
                if asked_width > 0 { canvas_module.fillRoundedRect(canvas, bar_x, y + 17, asked_width, 6, 3, filters_module.canvasColor(app.MEMORY_COLOR, 255)) }
            }
            y += 30
        }
        class += 1
    }
    return y
}

// The GPU's memory: the device, how many allocations against its limit,
// what was asked and what the device took; its heaps as bars (what the
// blocks take of each), and the size classes as the processor's are (what
// the device rounds up).
fn drawGpu(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    const memory = memoryOf(codemap)
    var y = top
    var text: [240]u8 = undefined
    const bytes: [*]u8 = &text
    const color = filters_module.canvasColor(app.GPU_MEMORY_COLOR, 255)
    var length = filters_module.writeText(bytes, 0, "GPU: ")
    length = filters_module.writeText(bytes, length, memory_module.gpuName(memory))
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, color, 2, 17)
    length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, memory.*.gpuLive))
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " allocations", " Allokationen"))
    if memory.*.gpuLimit < 4294967295 {
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " of ", " von "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, memory.*.gpuLimit))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " allowed", " erlaubt"))
    }
    length = filters_module.writeText(bytes, length, ": ")
    length = writeSize(codemap, bytes, length, memory.*.gpuAsked)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " asked, ", " verlangt, "))
    length = writeSize(codemap, bytes, length, memory.*.gpuSize)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " allocated, ", " belegt, "))
    length = writeShare(codemap, bytes, length, memory_module.gpuWasted(memory), memory.*.gpuSize)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " rounded up", " aufgerundet"))
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.TEXT_COLOR, 2, 17)
    y += 6
    const bar_x = x + 70
    const bar_width = width - 70
    var heap: usize = 0
    while heap < memory.*.gpuHeapCount {
        const device = memory.*.gpuHeapFlags[heap] & memory_module.HEAP_DEVICE != 0
        line(codemap, canvas, if device { access_module.say(codemap, "Device", "Gerät") } else { "System" }, x, y, 66, app.DIM_COLOR)
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, memory.*.gpuHeapBlocks[heap]))
        length = filters_module.writeText(bytes, length, " · ")
        length = writeSize(codemap, bytes, length, memory.*.gpuHeapUsed[heap])
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " of ", " von "))
        length = writeSize(codemap, bytes, length, memory.*.gpuHeapSize[heap])
        line(codemap, canvas, bytes[0..length], bar_x, y, bar_width, app.TEXT_COLOR)
        if visible(codemap, y + 17, 6) {
            canvas_module.fillRoundedRect(canvas, bar_x, y + 17, bar_width, 6, 3, app.SEPARATOR_COLOR)
            if memory.*.gpuHeapSize[heap] > 0 && memory.*.gpuHeapUsed[heap] > 0 {
                var used = @intCast(i32, memory.*.gpuHeapUsed[heap] * @intCast(u64, bar_width) / memory.*.gpuHeapSize[heap])
                if used < 6 { used = 6 }
                canvas_module.fillRoundedRect(canvas, bar_x, y + 17, used, 6, 3, color)
            }
        }
        y += 30
        heap += 1
    }
    const labels: [4][]const u8 = [4][]const u8{ "< 64 KiB", "< 1 MiB", "< 16 MiB", ">= 16 MiB" }
    var most: u64 = 1
    var class: usize = 0
    while class < memory_module.GPU_CLASSES {
        if memory.*.gpuClassSize[class] > most { most = memory.*.gpuClassSize[class] }
        class += 1
    }
    class = 0
    while class < memory_module.GPU_CLASSES {
        if memory.*.gpuClassBlocks[class] > 0 {
            line(codemap, canvas, labels[class], x, y, 66, app.DIM_COLOR)
            length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, memory.*.gpuClassBlocks[class]))
            length = filters_module.writeText(bytes, length, " · ")
            length = writeSize(codemap, bytes, length, memory.*.gpuClassSize[class])
            length = filters_module.writeText(bytes, length, " · ")
            length = writeShare(codemap, bytes, length, memory.*.gpuClassSize[class] - memory.*.gpuClassAsked[class], memory.*.gpuClassSize[class])
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " rounded up", " aufgerundet"))
            line(codemap, canvas, bytes[0..length], bar_x, y, bar_width, app.TEXT_COLOR)
            if visible(codemap, y + 17, 6) {
                const size_width = @intCast(i32, memory.*.gpuClassSize[class] * @intCast(u64, bar_width) / most)
                const asked_width = @intCast(i32, memory.*.gpuClassAsked[class] * @intCast(u64, bar_width) / most)
                canvas_module.fillRoundedRect(canvas, bar_x, y + 17, bar_width, 6, 3, app.SEPARATOR_COLOR)
                if size_width > 0 { canvas_module.fillRoundedRect(canvas, bar_x, y + 17, size_width, 6, 3, filters_module.canvasColor(app.GPU_MEMORY_COLOR, 90)) }
                if asked_width > 0 { canvas_module.fillRoundedRect(canvas, bar_x, y + 17, asked_width, 6, 3, color) }
            }
            y += 30
        }
        class += 1
    }
    return y
}

// The tiny pages from the first a block lies on to the last: each page (or
// a few side by side, when there are many) a cell filled as far as its
// tiny pages are taken, so where a small block still fits shows as the
// room above the fill; empty cells are pages left empty.
fn drawTinyStrip(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    const memory = memoryOf(codemap)
    const count = memory.*.blockCount
    const data = @intCast(u64, std.tinypage_allocator.DATA)
    var first: u64 = 18446744073709551615
    var last: u64 = 0
    var at: usize = 0
    while at < count {
        if memory_module.tinyBlock(memory, at) {
            const page = (memory.*.blockAddress[at] - data) / 4096
            if page < first { first = page }
            if page > last { last = page }
        }
        at += 1
    }
    if last < first || !visible(codemap, top, 24) { return top + 26 }
    const pages = last - first + 1
    // A cell 3 pixels wide at least; more pages than that share a cell.
    var cells = pages
    if cells * 3 > @intCast(u64, width) { cells = @intCast(u64, width) / 3 }
    if cells > 512 { cells = 512 }
    var taken: [512]u32 = undefined
    var cell: usize = 0
    while cell < 512 {
        taken[cell] = 0
        cell += 1
    }
    at = 0
    while at < count {
        if memory_module.tinyBlock(memory, at) {
            const page = (memory.*.blockAddress[at] - data) / 4096 - first
            const into = @intCast(usize, page * cells / pages)
            taken[into] = taken[into] + @intCast(u32, memory.*.blockMapped[at] / 64)
        }
        at += 1
    }
    cell = 0
    while @intCast(u64, cell) < cells {
        const left = x + @intCast(i32, @intCast(u64, cell) * @intCast(u64, width) / cells)
        var right = x + @intCast(i32, (@intCast(u64, cell) + 1) * @intCast(u64, width) / cells)
        if right > left + 2 { right -= 1 }
        // The pages this cell stands for.
        const from = @intCast(u64, cell) * pages / cells
        const to = (@intCast(u64, cell) + 1) * pages / cells
        var room: u64 = 64
        if to > from { room = (to - from) * 64 }
        const used = @intCast(u64, taken[cell])
        canvas_module.fillRect(canvas, left, top + 2, right - left, 18, app.SEPARATOR_COLOR)
        if used > 0 {
            const height = @intCast(i32, (used * 18 + room - 1) / room)
            canvas_module.fillRect(canvas, left, top + 20 - height, right - left, height, fillColor(used, room))
        }
        cell += 1
    }
    return top + 26
}

// The address space of the blocks of whole pages, from the lowest to the
// end of the highest: each block a cell as full as its pages are, a gap
// between blocks wider for a larger one: empty where nothing is mapped (a
// hole), gray where other mappings lie (the value arena, libraries,
// memory not from the page allocator); and what the holes come to.
fn drawStrip(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    const memory = memoryOf(codemap)
    var y = top
    const count = memory.*.blockCount
    if count == 0 { return y }
    // The widths summed: the blocks, then the holes between them.
    var total: u64 = 0
    var end: u64 = 0
    var at: usize = 0
    while at < count {
        const block = @intCast(usize, codemap.*.memoryOrder[at] & 65535)
        at += 1
        if memory_module.tinyBlock(memory, block) { continue }
        const address = memory.*.blockAddress[block]
        const mapped = memory.*.blockMapped[block]
        if end > 0 && address > end { total += weight((address - end) / 4096) }
        total += weight(mapped / 4096)
        end = address + mapped
    }
    if total > 0 && visible(codemap, y, 22) {
        canvas_module.fillRect(canvas, x, y + 10, width, 2, app.SEPARATOR_COLOR)
        var position: u64 = 0
        var map: usize = 0
        end = 0
        at = 0
        while at < count {
            const block = @intCast(usize, codemap.*.memoryOrder[at] & 65535)
            at += 1
            if memory_module.tinyBlock(memory, block) { continue }
            const address = memory.*.blockAddress[block]
            const mapped = memory.*.blockMapped[block]
            if end > 0 && address > end {
                const gap = weight((address - end) / 4096)
                // Another mapping in the gap (the maps are in address order).
                while map < memory.*.mapCount && memory.*.mapEnd[map] <= end { map += 1 }
                if map < memory.*.mapCount && memory.*.mapStart[map] < address {
                    const left = x + @intCast(i32, position * @intCast(u64, width) / total)
                    const right = x + @intCast(i32, (position + gap) * @intCast(u64, width) / total)
                    if right > left + 2 { canvas_module.fillRect(canvas, left + 1, y + 7, right - left - 2, 8, app.DISABLED_COLOR) }
                }
                position += gap
            }
            const cell = weight(mapped / 4096)
            const left = x + @intCast(i32, position * @intCast(u64, width) / total)
            var right = x + @intCast(i32, (position + cell) * @intCast(u64, width) / total)
            if right > left + 1 { right -= 1 }
            if right <= left { right = left + 1 }
            canvas_module.fillRect(canvas, left, y + 2, right - left, 18, fillColor(memory.*.blockLength[block], mapped))
            position += cell
            end = address + mapped
        }
    }
    y += 26
    var text: [240]u8 = undefined
    const bytes: [*]u8 = &text
    var length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, memory.*.holes))
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " holes, ", " Lücken, "))
    length = writeSize(codemap, bytes, length, memory.*.holeBytes)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, ", the largest ", ", die größte "))
    length = writeSize(codemap, bytes, length, memory.*.largestHole)
    line(codemap, canvas, bytes[0..length], x, y, width, app.TEXT_COLOR)
    y += 18
    length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Fragmentation 0.", "Fragmentierung 0,"))
    const fragmentation = memory_module.fragmentation(memory)
    if fragmentation < 100 { length = filters_module.writeText(bytes, length, "0") }
    if fragmentation < 10 { length = filters_module.writeText(bytes, length, "0") }
    length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, fragmentation))
    line(codemap, canvas, bytes[0..length], x, y, width, app.TEXT_COLOR)
    y += 18
    y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "Green: pages nearly full, amber: half, red: mostly waste; gray: other mappings between the blocks, empty: holes. Fragmentation 0: one hole or none, near 1: many small ones. Tiny pages: the fill is what is taken, above it small blocks still fit.", "Grün: Seiten fast voll, gelb: halb, rot: meist verschwendet; grau: andere Mappings zwischen den Blöcken, leer: Lücken. Fragmentierung 0: eine Lücke oder keine, nahe 1: viele kleine. Tiny-Pages: die Füllung ist belegt, darüber passen noch kleine Blöcke."), access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 6, 17)
    return y
}

// The top of the panel (see the top of this file).
pub fn drawBlock(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    var y = top
    var text: [240]u8 = undefined
    const bytes: [*]u8 = &text
    const run = actions_module.runOf(codemap)
    const name = chosenName(codemap)
    if run.*.running && run.*.watched {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "The program runs with its memory watched: what it holds shows here about once a second (F5 ends it).", "Das Programm läuft mit beobachtetem Speicher: was es belegt, steht hier etwa jede Sekunde neu (F5 beendet es)."), access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.MEMORY_COLOR, 255), 3, 17)
        y += 8
    } else if name.length > 0 {
        var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Watch memory: ", "Speicher beobachten: "))
        length = filters_module.writeText(bytes, length, programs_module.nameOf(access_module.programsOf(codemap), codemap.*.program))
        const button = detail_module.detailButton(codemap, canvas, bytes[0..length], x, y, 0, app.ROW_MEMORY_WATCH, true, !run.*.running)
        y += app.DETAIL_ROW + 12
    } else {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "Choose a built program under Programs to run it with its memory watched, or start one with MLX_LEAK_CHECK=1.", "Wähle unter Programme ein gebautes Programm, um es mit beobachtetem Speicher laufen zu lassen, oder starte eines mit MLX_LEAK_CHECK=1."), access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 3, 17)
        y += 8
    }
    const memory = memoryOf(codemap)
    if memory.*.count == 0 {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "No program has written its memory yet.", "Noch hat kein Programm seinen Speicher geschrieben."), access_module.bodyOf(codemap), x, y, width, app.DIM_COLOR, 2, 20)
        return y + 8
    }
    y = drawSnapshots(codemap, canvas, x, y, width)
    if !loaded(codemap) { return y + 8 }
    y += 10
    // What it holds and wastes.
    var length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, memory.*.blocks))
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " blocks: ", " Blöcke: "))
    length = writeSize(codemap, bytes, length, memory.*.bytes)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " asked, ", " verlangt, "))
    length = writeSize(codemap, bytes, length, memory.*.mapped)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " in pages, ", " in Seiten, "))
    length = writeShare(codemap, bytes, length, memory_module.wasted(memory), memory.*.mapped)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " wasted", " verschwendet"))
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.TEXT_COLOR, 2, 17)
    y += 1
    length = filters_module.writeText(bytes, 0, access_module.say(codemap, "at most ", "höchstens "))
    length = writeSize(codemap, bytes, length, memory.*.peak)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, ", values ", ", Werte "))
    length = writeSize(codemap, bytes, length, memory.*.values)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, ", resident ", ", im Speicher "))
    length = writeSize(codemap, bytes, length, memory.*.resident * 1024)
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 2, 17)
    // The tiny pages the small blocks share (std.tinypage_allocator).
    if memory.*.tinyPages > 0 {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Tiny pages: ", "Tiny-Pages: "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, memory.*.tinyBlocks))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " blocks on ", " Blöcke auf "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, memory.*.tinyPages))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " pages, ", " Seiten, "))
        length = writeShare(codemap, bytes, length, memory.*.tinyBytes, memory.*.tinyPages * 4096)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " full", " voll"))
        if memory.*.tinyEmpty > 0 {
            length = filters_module.writeText(bytes, length, ", ")
            length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, memory.*.tinyEmpty))
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " empty", " leer"))
        }
        y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.MEMORY_COLOR, 255), 2, 17)
        y = drawTinyStrip(codemap, canvas, x, y + 2, width)
    }
    y += 9
    y = drawClasses(codemap, canvas, x, y, width)
    y += 6
    y = drawStrip(codemap, canvas, x, y, width)
    if codemap.*.memoryOutside > 0 {
        length = filters_module.writeNumber(codemap, bytes, 0, codemap.*.memoryOutside)
        if codemap.*.memoryOutside == 1 {
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " place in code not read here", " Stelle in Code, der hier nicht gelesen ist"))
        } else {
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " places in code not read here", " Stellen in Code, der hier nicht gelesen ist"))
        }
        line(codemap, canvas, bytes[0..length], x, y + 2, width, app.DIM_COLOR)
        y += 20
    }
    if memory.*.gpu { y = drawGpu(codemap, canvas, x, y + 8, width) }
    return y + 10
}
