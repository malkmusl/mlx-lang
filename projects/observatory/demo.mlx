// ---------------------------------------------------------------------------
// The demo: MLX_CODEMAP_DEMO names a script the app plays, a step a line
// ("#" starts a comment), and writes its own frames as pictures (PPM) into
// MLX_CODEMAP_DEMO_OUT. tools/observatory_screenshots.sh makes the README's
// pictures with it.
//
//   wait MS                 go on after MS milliseconds
//   settle                  wait until the camera stands and the history
//                           is read
//   shot NAME               the next frame, as NAME.ppm
//   record NAME N MS        N frames, one each MS: NAME-000.ppm ...
//   spin MILLIRADIANS       turn the view that much a second (0: stop)
//   search TEXT             TEXT into the search (a name or a query)
//   enter, escape           the keys
//   select PATH             select PATH under the root and fly there
//                           (projects/observatory/main.mlx/drawSidebar)
//   finding NAME            open a finding (copies names unused workarounds
//                           crashes unreachable untested complex structure
//                           risky hot changed; none: close)
//   check NAME on|off       a finding's check box
//   metric NAME             color by kind size churn complexity risk heat
//   program NAME|all        the program shown
//   programs open|close     the list of programs
//   workarounds open|close  the kinds of workarounds
//   popup base|filter|run|none  a toolbar list
//   base REV                the base of Changed
//   rewrite PATTERN         the rewrite of dropped or counted (back: close)
//   fold NAME, unfold NAME  a sidebar section (groups program findings
//                           color show kinds views)
//   only PATHS, all         the groups shown
//   scroll N, detail N      the sidebar's, the panel's scroll
//   view map|editor         what the middle shows
//   open PATH [LINE]        a file (relative to the root) in the editor
//   cursor LINE COLUMN      the editor's cursor (select-to: the selection)
//   edit TEXT               typed at the cursor (\n: Enter)
//   undo, save, definition  Ctrl+Z, Ctrl+S, F12
//   hoverat LINE COLUMN     the pointer over that character
//   chip NAME               the first lens chip of a kind (uses crashes
//                           workarounds open rewrite) drawn, clicked
//   references, choose      Shift+F12; Enter in the references list
//   complete, accept        the completion list at the cursor; Enter in it
//   signature               the signature help of the call at the cursor
//   delete-selection        what is selected taken out
//   rename NAME             F2 on the name at the cursor, NAME, Enter
//   renaming                F2 only (the field open)
//   branch-new NAME, branch-switch NAME   git switch -c / git switch
//   branches                the history with its list of branches
//   new-file FOLDER [NAME]  the field for a new file in FOLDER ("." the
//   new-folder FOLDER [NAME] root), with NAME: made
//   fold LINE               fold the block that line opens (again: open)
//   gutterat LINE           the pointer on a line number (its blame)
//   blameat LINE            who wrote the line (the line number's hover)
//   build                   Build (the program of the file shown, else
//                           the one chosen)
//   run, profile, stop      build and start it (under mlx-profile), end it
//   popup commit, message TEXT, commit, commit-push
//                           the commit list, its message, its buttons
//   quit                    end

pub fn startDemo(codemap: *app.Codemap) -> void {
    codemap.*.demoActive = false
    const path = apps_module.environmentValue(codemap.*.environment, "MLX_CODEMAP_DEMO")
    if @intFromPtr(path) == 0 || path[0] == 0 { return }
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return }
    codemap.*.demoText = codemap.*.allocator.alloc(65536, 16).?
    codemap.*.demoLength = 0
    while codemap.*.demoLength + 4096 <= 65536 {
        var chunk: [*]u8 = undefined
        unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(codemap.*.demoText) + codemap.*.demoLength) }
        const got = std.fs.read(file, chunk, 4096)
        if got <= 0 { break }
        codemap.*.demoLength += @intCast(usize, got)
    }
    const closed = std.fs.close(file)
    const out = apps_module.environmentValue(codemap.*.environment, "MLX_CODEMAP_DEMO_OUT")
    codemap.*.demoOutLength = if @intFromPtr(out) != 0 { app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoOut")), 0, std.text.cString(out), 1000) } else { app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoOut")), 0, ".", 1000) }
    codemap.*.demoAt = 0
    codemap.*.demoUntil = 0
    codemap.*.demoSettle = false
    codemap.*.demoShotLength = 0
    codemap.*.demoRecord = 0
    codemap.*.demoSpin = 0.0
    codemap.*.demoClock = panel_module.milliseconds()
    codemap.*.demoSpinAt = codemap.*.demoClock
    codemap.*.demoActive = true
}

fn demoNumber(text: []const u8) -> usize {
    var value: usize = 0
    for byte in text {
        if byte >= 48 && byte <= 57 { value = value * 10 + @intCast(usize, byte - 48) }
    }
    return value
}

fn findingNamed(word: []const u8) -> u8 {
    const names = [12][]const u8{ "copies", "names", "unused", "workarounds", "crashes", "unreachable", "untested", "complex", "structure", "risky", "hot", "changed" }
    var at: usize = 0
    while at < 12 {
        if access_module.sameBytes(names[at], word) { return @intCast(u8, at) }
        at += 1
    }
    return app.FINDING_NONE
}

fn sectionNamed(word: []const u8) -> usize {
    const names = [7][]const u8{ "groups", "program", "findings", "color", "show", "kinds", "views" }
    var at: usize = 0
    while at < 7 {
        if access_module.sameBytes(names[at], word) { return at }
        at += 1
    }
    return app.SECTIONS
}

fn metricNamed(word: []const u8) -> u8 {
    const names = [6][]const u8{ "kind", "size", "churn", "complexity", "risk", "heat" }
    var at: usize = 0
    while at < 6 {
        if access_module.sameBytes(names[at], word) { return @intCast(u8, at) }
        at += 1
    }
    return 255
}

// Plays the demo on: steps until one has to wait.
pub fn runDemo(codemap: *app.Codemap) -> void {
    if !codemap.*.demoActive || !codemap.*.built { return }
    const panel = access_module.panelOf(codemap)
    const now = panel_module.milliseconds()
    // The demo's clock goes with the real one, but for recording (then
    // each frame moves it on).
    const elapsed = if now > codemap.*.demoSpinAt { now - codemap.*.demoSpinAt } else { 0 }
    codemap.*.demoSpinAt = now
    if codemap.*.demoRecord == 0 {
        codemap.*.demoClock += elapsed
        turnDemo(codemap, elapsed)
    }
    // A picture asked for: once a frame after the ask is shown.
    if codemap.*.demoShotLength > 0 {
        // (A flight keeps the panel dirty: a frame drawn after the ask is
        // enough.)
        if panel.*.shownFrames < codemap.*.demoShotFrame {
            panel.*.dirty = true
            return
        }
        writeDemoShot(codemap)
        codemap.*.demoShotLength = 0
    }
    if codemap.*.demoRecord > 0 {
        takeRecordFrame(codemap)
        return
    }
    if now < codemap.*.demoUntil { return }
    if codemap.*.demoSettle {
        if codemap.*.flying || !history_module.finished(access_module.historyOf(codemap)) || codemap.*.historyJob > 0 || access_module.checkOf(codemap).*.running || access_module.buildOf(codemap).*.running || codemap.*.afterBuild != app.ACTION_NONE || actions_module.runOf(codemap).*.running || codemap.*.job != app.JOB_NONE { return }
        codemap.*.demoSettle = false
    }
    const text = codemap.*.demoText[0..codemap.*.demoLength]
    while codemap.*.demoAt < text.length {
        var end = codemap.*.demoAt
        while end < text.length && text[end] != 10 { end += 1 }
        const start = codemap.*.demoAt
        codemap.*.demoAt = end + 1
        var word_end = start
        while word_end < end && text[word_end] != 32 { word_end += 1 }
        const word = text[start..word_end]
        const rest = if word_end < end { text[word_end + 1..end] } else { text[end..end] }
        if word.length == 0 || word[0] == 35 { continue }
        if codemap.*.trace { navigation_module.traceLine(codemap, "demo ", text[start..end]) }
        panel.*.dirty = true
        if demoStep(codemap, word, rest) { return }
    }
    codemap.*.demoActive = false
}

// One step; true when it has to wait.
fn demoStep(codemap: *app.Codemap, word: []const u8, rest: []const u8) -> bool {
    const panel = access_module.panelOf(codemap)
    const now = panel_module.milliseconds()
    if access_module.sameBytes(word, "wait") {
        codemap.*.demoUntil = now + demoNumber(rest)
        return true
    }
    if access_module.sameBytes(word, "settle") {
        codemap.*.demoSettle = true
        codemap.*.demoUntil = now + 100
        return true
    }
    if access_module.sameBytes(word, "shot") {
        codemap.*.demoShotLength = app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoShot")), 0, rest, 120)
        codemap.*.demoShotFrame = panel.*.shownFrames + 1
        return true
    }
    if access_module.sameBytes(word, "record") {
        // NAME N MS
        var name_end: usize = 0
        while name_end < rest.length && rest[name_end] != 32 { name_end += 1 }
        codemap.*.demoShotLength = 0
        const name_length = app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoShot")), 0, rest[0..name_end], 100)
        var count_end = name_end + 1
        while count_end < rest.length && rest[count_end] != 32 { count_end += 1 }
        codemap.*.demoRecord = if name_end + 1 < rest.length { demoNumber(rest[name_end + 1..(if count_end < rest.length { count_end } else { rest.length })]) } else { 0 }
        codemap.*.demoRecordEvery = if count_end < rest.length { demoNumber(rest[count_end..rest.length]) } else { 100 }
        codemap.*.demoRecordIndex = 0
        codemap.*.demoShotFrame = panel.*.shownFrames + 1
        codemap.*.demoShot[name_length] = 0
        codemap.*.demoUntil = now
        return codemap.*.demoRecord > 0
    }
    if access_module.sameBytes(word, "spin") {
        codemap.*.demoSpin = m.toFloat(@intCast(i64, demoNumber(rest))) / 1000.0
        if rest.length > 0 && rest[0] == 45 { codemap.*.demoSpin = -codemap.*.demoSpin }
        codemap.*.demoSpinAt = now
        return false
    }
    if access_module.sameBytes(word, "search") {
        navigation_module.setSearch(codemap, rest)
        codemap.*.searchFocused = true
        return false
    }
    if access_module.sameBytes(word, "enter") {
        lists_module.searchKey(codemap, app.KEY_ENTER)
        return false
    }
    if access_module.sameBytes(word, "escape") {
        input_module.onKey(codemap, app.KEY_ESCAPE)
        return false
    }
    if access_module.sameBytes(word, "select") {
        var key: [1100]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &key) }
        var length = filters_module.writeText(bytes, 0, access_module.nameOf(codemap, access_module.graphOf(codemap).*.root))
        length = filters_module.writeText(bytes, length, "/")
        if rest.length < 1000 { length = filters_module.writeText(bytes, length, rest) }
        if length > 0 && bytes[length - 1] != 47 { length = filters_module.writeText(bytes, length, "/") }
        const node = navigation_module.findKey(codemap, bytes[0..length])
        if node != app.NONE { navigation_module.goTo(codemap, node) } else if codemap.*.trace { navigation_module.traceLine(codemap, "demo: no node ", bytes[0..length]) }
        return false
    }
    if access_module.sameBytes(word, "finding") {
        const finding = findingNamed(rest)
        navigation_module.select(codemap, app.NONE)
        if finding != app.FINDING_NONE { codemap.*.findingOn[@intCast(usize, finding)] = true }
        access_module.openFinding(codemap, finding)
        codemap.*.detailScroll = 0
        return false
    }
    if access_module.sameBytes(word, "check") {
        var name_end: usize = 0
        while name_end < rest.length && rest[name_end] != 32 { name_end += 1 }
        const finding = findingNamed(rest[0..name_end])
        if finding != app.FINDING_NONE {
            codemap.*.findingOn[@intCast(usize, finding)] = name_end + 1 < rest.length && access_module.sameBytes(rest[name_end + 1..rest.length], "on")
            filters_module.refreshFindings(codemap)
        }
        return false
    }
    if access_module.sameBytes(word, "metric") {
        const metric = metricNamed(rest)
        if metric != 255 {
            codemap.*.metric = metric
            access_module.computeMetric(codemap)
        }
        return false
    }
    if access_module.sameBytes(word, "program") {
        const programs = access_module.programsOf(codemap)
        var chosen = programs.*.count
        var program: usize = 0
        while program < programs.*.count {
            if access_module.sameBytes(programs_module.nameOf(programs, program), rest) { chosen = program }
            program += 1
        }
        access_module.chooseProgram(codemap, chosen)
        return false
    }
    if access_module.sameBytes(word, "programs") {
        codemap.*.programsOpen = access_module.sameBytes(rest, "open")
        return false
    }
    if access_module.sameBytes(word, "workarounds") {
        codemap.*.workaroundsOpen = access_module.sameBytes(rest, "open")
        return false
    }
    if access_module.sameBytes(word, "popup") {
        codemap.*.popup = app.POPUP_NONE
        if access_module.sameBytes(rest, "base") { lists_module.openPopup(codemap, app.POPUP_BASE) }
        if access_module.sameBytes(rest, "filter") { lists_module.openPopup(codemap, app.POPUP_FILTER) }
        if access_module.sameBytes(rest, "run") { lists_module.openPopup(codemap, app.POPUP_RUN) }
        if access_module.sameBytes(rest, "commit") { lists_module.openPopup(codemap, app.POPUP_BASE) }
        return false
    }
    if access_module.sameBytes(word, "build") {
        actions_module.startAction(codemap, app.ACTION_BUILD)
        return false
    }
    if access_module.sameBytes(word, "run") || access_module.sameBytes(word, "profile") {
        actions_module.startAction(codemap, if access_module.sameBytes(word, "run") { app.ACTION_RUN } else { app.ACTION_PROFILE })
        return false
    }
    if access_module.sameBytes(word, "stop") {
        run_module.stop(actions_module.runOf(codemap))
        return false
    }
    if access_module.sameBytes(word, "message") {
        codemap.*.commitLength = app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "commitMessage")), 0, rest, 500)
        return false
    }
    if access_module.sameBytes(word, "commit") || access_module.sameBytes(word, "commit-push") {
        project_module.startCommit(codemap, access_module.sameBytes(word, "commit-push"))
        return false
    }
    if access_module.sameBytes(word, "base") {
        codemap.*.popup = app.POPUP_NONE
        lists_module.chooseBase(codemap, rest)
        return false
    }
    if access_module.sameBytes(word, "rewrite") {
        const pattern = rewrite_module.patternNamed(rest)
        if pattern != 255 { actions_module.planRewrite(codemap, pattern) }
        return false
    }
    if access_module.sameBytes(word, "back") {
        codemap.*.rewritePattern = 255
        return false
    }
    if access_module.sameBytes(word, "fold") && tabs_module.hasTab(codemap) && rest.length > 0 && rest[0] >= 48 && rest[0] <= 57 {
        assist_module.toggleFold(codemap, codemap.*.activeTab, demoNumber(rest) - 1)
        return false
    }
    if access_module.sameBytes(word, "fold") || access_module.sameBytes(word, "unfold") {
        const section = sectionNamed(rest)
        if section < app.SECTIONS { codemap.*.sectionFolded[section] = access_module.sameBytes(word, "fold") }
        return false
    }
    if access_module.sameBytes(word, "only") {
        var node: usize = 0
        while node < access_module.graphOf(codemap).*.count {
            codemap.*.off[node] = 0
            node += 1
        }
        app.markOnly(codemap, rest)
        filters_module.refreshVisibility(codemap)
        filters_module.flyToShown(codemap)
        return false
    }
    if access_module.sameBytes(word, "all") {
        var node: usize = 0
        while node < access_module.graphOf(codemap).*.count {
            codemap.*.off[node] = 0
            node += 1
        }
        filters_module.refreshVisibility(codemap)
        return false
    }
    if access_module.sameBytes(word, "scroll") {
        codemap.*.sidebarScroll = @intCast(i32, demoNumber(rest))
        return false
    }
    if access_module.sameBytes(word, "detail") {
        codemap.*.detailScroll = @intCast(i32, demoNumber(rest))
        return false
    }
    if access_module.sameBytes(word, "chip") {
        // uses, crashes, workarounds, open or rewrite: the first such chip
        // drawn.
        const kind = if access_module.sameBytes(rest, "uses") { app.CHIP_USES } else if access_module.sameBytes(rest, "crashes") { app.CHIP_CRASHES } else if access_module.sameBytes(rest, "workarounds") { app.CHIP_WORKAROUNDS } else if access_module.sameBytes(rest, "open") { app.CHIP_OPEN } else { app.CHIP_REWRITE }
        var chip: usize = 0
        while chip < codemap.*.chipCount {
            if codemap.*.chipKind[chip] == kind {
                editor_view_module.pressChip(codemap, chip)
                return false
            }
            chip += 1
        }
        if codemap.*.trace { navigation_module.traceLine(codemap, "no chip ", rest) }
        return false
    }
    if access_module.sameBytes(word, "choose") {
        editor_view_module.openRef(codemap, codemap.*.refsSelected)
        return false
    }
    if access_module.sameBytes(word, "references") && tabs_module.hasTab(codemap) {
        editor_view_module.openRefs(codemap, tabs_module.symbolAtCursor(codemap, tabs_module.activeEditor(codemap).*.cursor), codemap.*.editorLeft, editor_view_module.editorCodeTop() + 40)
        return false
    }
    if access_module.sameBytes(word, "view") {
        input_module.setView(codemap, if access_module.sameBytes(rest, "editor") { app.VIEW_EDITOR } else { app.VIEW_MAP })
        return false
    }
    if access_module.sameBytes(word, "open") {
        // RELATIVE-PATH [LINE]
        var path_end: usize = 0
        while path_end < rest.length && rest[path_end] != 32 { path_end += 1 }
        var path: [1100]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &path) }
        var length = filters_module.writeText(bytes, 0, access_module.rootText(codemap))
        length = filters_module.writeText(bytes, length, "/")
        if path_end < 1000 { length = filters_module.writeText(bytes, length, rest[0..path_end]) }
        const line = if path_end < rest.length { demoNumber(rest[path_end..rest.length]) } else { 1 }
        const opened = tabs_module.openFile(codemap, bytes[0..length], line, 1)
        tabs_module.followCursor(codemap)
        return false
    }
    if access_module.sameBytes(word, "cursor") && tabs_module.hasTab(codemap) {
        // LINE COLUMN (from 1)
        var split: usize = 0
        while split < rest.length && rest[split] != 32 { split += 1 }
        const line = demoNumber(rest[0..split])
        const column = if split < rest.length { demoNumber(rest[split..rest.length]) } else { 1 }
        const editor = tabs_module.activeEditor(codemap)
        editor_module.moveTo(editor, editor_module.offsetAt(editor, if line > 0 { line - 1 } else { 0 }, if column > 0 { column - 1 } else { 0 }), false)
        tabs_module.keepCursorSeen(codemap)
        tabs_module.followCursor(codemap)
        return false
    }
    if access_module.sameBytes(word, "select-to") && tabs_module.hasTab(codemap) {
        var split: usize = 0
        while split < rest.length && rest[split] != 32 { split += 1 }
        const editor = tabs_module.activeEditor(codemap)
        const line = demoNumber(rest[0..split])
        const column = if split < rest.length { demoNumber(rest[split..rest.length]) } else { 1 }
        editor_module.moveTo(editor, editor_module.offsetAt(editor, if line > 0 { line - 1 } else { 0 }, if column > 0 { column - 1 } else { 0 }), true)
        return false
    }
    if access_module.sameBytes(word, "edit") && tabs_module.hasTab(codemap) {
        const editor = tabs_module.activeEditor(codemap)
        const tab = codemap.*.activeTab
        const line_before = editor_module.lineOf(editor, editor_module.selectionStart(editor))
        const lines_before = editor.*.lineCount
        // "\n" in the text: a new line (with the indentation).
        var at: usize = 0
        var start: usize = 0
        while at <= rest.length {
            if at == rest.length || (at + 1 < rest.length && rest[at] == 92 && rest[at + 1] == 110) {
                if at > start { editor_module.insert(editor, rest[start..at]) }
                if at < rest.length { editor_module.newline(editor) }
                start = at + 2
                at += 2
            } else {
                at += 1
            }
        }
        tabs_module.shiftMarks(codemap, tab, line_before, lines_before)
        tabs_module.keepCursorSeen(codemap)
        return false
    }
    if access_module.sameBytes(word, "rename") {
        assist_module.startRename(codemap)
        if codemap.*.renameOpen {
            codemap.*.renameOpen = false
            assist_module.applyRename(codemap, rest)
        }
        return false
    }
    if access_module.sameBytes(word, "new-file") || access_module.sameBytes(word, "new-folder") {
        // FOLDER NAME ("." for the root): the field, then Enter.
        var split: usize = 0
        while split < rest.length && rest[split] != 32 { split += 1 }
        const folder = if split == 1 && rest[0] == 46 { rest[0..0] } else { rest[0..split] }
        project_module.openCreate(codemap, folder, access_module.sameBytes(word, "new-folder"), 200)
        if split + 1 < rest.length { project_module.createNamed(codemap, rest[split + 1..rest.length]) }
        return false
    }
    if access_module.sameBytes(word, "branch-new") || access_module.sameBytes(word, "branch-switch") {
        project_module.switchBranch(codemap, rest, access_module.sameBytes(word, "branch-new"))
        return false
    }
    if access_module.sameBytes(word, "branches") {
        if codemap.*.popup != app.POPUP_BASE { lists_module.openPopup(codemap, app.POPUP_BASE) }
        codemap.*.branchesOpen = true
        return false
    }
    if access_module.sameBytes(word, "renaming") {
        assist_module.startRename(codemap)
        return false
    }
    if access_module.sameBytes(word, "gutterat") && tabs_module.hasTab(codemap) {
        // LINE: the pointer on its number.
        codemap.*.pointerX = app.SIDEBAR + 24
        codemap.*.pointerY = editor_view_module.lineY(codemap, codemap.*.activeTab, demoNumber(rest) - 1) + 4
        const moved = input_module.motion(codemap, codemap.*.pointerX, codemap.*.pointerY)
        return false
    }
    if access_module.sameBytes(word, "blameat") && tabs_module.hasTab(codemap) {
        const text = assist_module.blameLine(codemap, codemap.*.activeTab, demoNumber(rest) - 1)
        if codemap.*.trace { navigation_module.traceLine(codemap, "blame ", text) }
        return false
    }
    if access_module.sameBytes(word, "complete") {
        assist_module.updateCompletion(codemap)
        return false
    }
    if access_module.sameBytes(word, "accept") {
        assist_module.acceptCompletion(codemap)
        return false
    }
    if access_module.sameBytes(word, "signature") && tabs_module.hasTab(codemap) && codemap.*.tabFile[codemap.*.activeTab] != app.NONE {
        codemap.*.signatureActive = true
        const editor = tabs_module.activeEditor(codemap)
        var argument: usize = 0
        const function = features.callAt(codemap.*.index, codemap.*.tabFile[codemap.*.activeTab], editor.*.text[0..editor.*.length], editor.*.cursor, assist_module.offsetInIndex(codemap, codemap.*.activeTab), &argument)
        if codemap.*.trace && function != app.NONE {
            var text: [32]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &text) }
            var length = filters_module.writeText(bytes, 0, ", argument ")
            length = lists_module.writeNumberPlain(bytes, length, argument)
            navigation_module.traceLine(codemap, "signature ", index_module.nameOf(codemap.*.index, function))
            navigation_module.traceLine(codemap, "signature at", bytes[0..length])
        }
        return false
    }
    if access_module.sameBytes(word, "delete-selection") && tabs_module.hasTab(codemap) {
        const editor = tabs_module.activeEditor(codemap)
        const line_before = editor_module.lineOf(editor, editor_module.selectionStart(editor))
        const lines_before = editor.*.lineCount
        editor_module.deleteSelection(editor)
        tabs_module.shiftMarks(codemap, codemap.*.activeTab, line_before, lines_before)
        return false
    }
    if access_module.sameBytes(word, "undo") && tabs_module.hasTab(codemap) {
        editor_module.undo(tabs_module.activeEditor(codemap))
        return false
    }
    if access_module.sameBytes(word, "save") {
        tabs_module.saveTab(codemap)
        return false
    }
    if access_module.sameBytes(word, "definition") && tabs_module.hasTab(codemap) {
        tabs_module.goToDefinition(codemap, tabs_module.activeEditor(codemap).*.cursor)
        return false
    }
    if access_module.sameBytes(word, "hoverat") && tabs_module.hasTab(codemap) {
        // LINE COLUMN: the pointer over that character.
        var split: usize = 0
        while split < rest.length && rest[split] != 32 { split += 1 }
        const line = demoNumber(rest[0..split])
        const column = if split < rest.length { demoNumber(rest[split..rest.length]) } else { 1 }
        const editor = tabs_module.activeEditor(codemap)
        codemap.*.pointerX = codemap.*.editorLeft + @intCast(i32, if column > 0 { column - 1 } else { 0 }) * codemap.*.charWidth + 2
        codemap.*.pointerY = editor_view_module.lineY(codemap, codemap.*.activeTab, if line > 0 { line - 1 } else { 0 }) + 4
        const moved = input_module.motion(codemap, codemap.*.pointerX, codemap.*.pointerY)
        // What the hover says of it: where it belongs, its type.
        const symbol = if codemap.*.editorHover != 18446744073709551615 { tabs_module.symbolAtCursor(codemap, codemap.*.editorHover) } else { app.NONE }
        if codemap.*.trace && symbol != app.NONE {
            const lines = access_module.hoverTextOf(codemap)
            protocol.clear(lines)
            features.place(lines, codemap.*.index, symbol)
            protocol.text(lines, " | ")
            const typed = features.typePlace(lines, codemap.*.index, symbol)
            navigation_module.traceLine(codemap, "hover ", protocol.contents(lines))
        }
        return false
    }
    if access_module.sameBytes(word, "quit") {
        panel.*.running = false
        return true
    }
    return false
}

// Turns the view by the spin asked for, over `elapsed` milliseconds.
fn turnDemo(codemap: *app.Codemap, elapsed: usize) -> void {
    if codemap.*.demoSpin == 0.0 || codemap.*.flying || elapsed == 0 { return }
    const camera = access_module.cameraOf(codemap)
    camera.*.yaw = camera.*.yaw + codemap.*.demoSpin * m.toFloat(@intCast(i64, elapsed)) / 1000.0
    access_module.panelOf(codemap).*.dirty = true
}

fn takeRecordFrame(codemap: *app.Codemap) -> void {
    const panel = access_module.panelOf(codemap)
    // The frame of this moment: drawn first.
    if panel.*.shownFrames < codemap.*.demoShotFrame {
        panel.*.dirty = true
        return
    }
    var name: [140]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &name) }
    var base_length: usize = 0
    while codemap.*.demoShot[base_length] != 0 && base_length < 100 { base_length += 1 }
    var length = filters_module.writeText(bytes, 0, access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoShot"))[0..base_length])
    length = filters_module.writeText(bytes, length, "-")
    const index = codemap.*.demoRecordIndex
    bytes[length] = @intCast(u8, 48 + index / 100 % 10)
    bytes[length + 1] = @intCast(u8, 48 + index / 10 % 10)
    bytes[length + 2] = @intCast(u8, 48 + index % 10)
    length += 3
    codemap.*.demoShotLength = app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoShot")), 0, bytes[0..length], 120)
    writeDemoShot(codemap)
    // The base name back (the next frame's).
    const kept = app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoShot")), 0, bytes[0..base_length], 100)
    codemap.*.demoShot[kept] = 0
    codemap.*.demoShotLength = 0
    codemap.*.demoRecordIndex += 1
    codemap.*.demoRecord -= 1
    // The next frame: the flight and the turn an interval on.
    codemap.*.demoClock += codemap.*.demoRecordEvery
    turnDemo(codemap, codemap.*.demoRecordEvery)
    codemap.*.demoUntil = 0
    codemap.*.demoShotFrame = panel.*.shownFrames + 1
    panel.*.dirty = true
}

// The frame shown last, as OUT/NAME.ppm.
fn writeDemoShot(codemap: *app.Codemap) -> void {
    const panel = access_module.panelOf(codemap)
    const address = panel_module.shownPixels(panel)
    if address == 0 { return }
    var path: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var length = filters_module.writeText(bytes, 0, access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoOut"))[0..codemap.*.demoOutLength])
    length = filters_module.writeText(bytes, length, "/")
    length = filters_module.writeText(bytes, length, access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "demoShot"))[0..codemap.*.demoShotLength])
    length = filters_module.writeText(bytes, length, ".ppm")
    bytes[length] = 0
    const file = std.fs.open(bytes, 577, 420)
    if !std.fs.isValid(file) { return }
    const width = panel.*.width
    const height = panel.*.height
    var header: [64]u8 = undefined
    var header_bytes: [*]u8 = undefined
    unsafe { header_bytes = @ptrCast([*]u8, &header) }
    var header_length = filters_module.writeText(header_bytes, 0, "P6\n")
    header_length = lists_module.writeNumberPlain(header_bytes, header_length, width)
    header_length = filters_module.writeText(header_bytes, header_length, " ")
    header_length = lists_module.writeNumberPlain(header_bytes, header_length, height)
    header_length = filters_module.writeText(header_bytes, header_length, "\n255\n")
    var ok = std.fs.writeAllBytes(file, header_bytes, header_length)
    const row = codemap.*.allocator.alloc(width * 3 + 16, 16).?
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrFromInt([*]u32, address) }
    var y: usize = 0
    while y < height && ok {
        var x: usize = 0
        while x < width {
            const pixel = pixels[y * width + x]
            row[x * 3] = @intCast(u8, (pixel >> 16) & 255)
            row[x * 3 + 1] = @intCast(u8, (pixel >> 8) & 255)
            row[x * 3 + 2] = @intCast(u8, pixel & 255)
            x += 1
        }
        ok = std.fs.writeAllBytes(file, row, width * 3)
        y += 1
    }
    codemap.*.allocator.free(row, width * 3 + 16, 16)
    const closed = std.fs.close(file)
    if codemap.*.trace { navigation_module.traceLine(codemap, "demo shot ", bytes[0..length]) }
}

// The work in the background, looked after each tick.
pub fn watchJobs(codemap: *app.Codemap) -> void {
    if codemap.*.job != app.JOB_NONE && git_module.exited(codemap.*.jobProcess) { project_module.finishJob(codemap) }
    if codemap.*.historyJob > 0 && git_module.exited(codemap.*.historyJob) {
        codemap.*.historyJob = 0
        access_module.loadTrend(codemap)
        access_module.panelOf(codemap).*.dirty = true
    }
}

// What a finding measured of `symbol`, for the right of its row.
pub fn writeMeasure(codemap: *app.Codemap, out: [*]u8, finding: u8, symbol: u32) -> usize {
    if finding == app.FINDING_UNREACHABLE || finding == app.FINDING_UNTESTED {
        const length = filters_module.writeNumber(codemap, out, 0, @intCast(usize, complexity_module.tokensOf(access_module.complexityOf(codemap), symbol)))
        return filters_module.writeText(out, length, " Tokens")
    }
    if finding == app.FINDING_COMPLEX {
        var length = filters_module.writeNumber(codemap, out, 0, @intCast(usize, complexity_module.branchesOf(access_module.complexityOf(codemap), symbol)))
        length = filters_module.writeText(out, length, access_module.say(codemap, " branches, ", " Zweige, "))
        length = filters_module.writeNumber(codemap, out, length, @intCast(usize, complexity_module.depthOf(access_module.complexityOf(codemap), symbol)))
        return filters_module.writeText(out, length, access_module.say(codemap, " deep", " tief"))
    }
    if finding == app.FINDING_RISKY {
        const length = filters_module.writeText(out, 0, access_module.say(codemap, "risk ", "Risiko "))
        return filters_module.writeNumber(codemap, out, length, @intCast(usize, measures_module.risk(access_module.measuresOf(codemap), symbol)))
    }
    if finding == app.FINDING_CHANGED {
        return filters_module.writeText(out, 0, if diff_module.stateOf(access_module.diffOf(codemap), symbol) == diff_module.ADDED { access_module.say(codemap, "new", "neu") } else { access_module.say(codemap, "changed", "geändert") })
    }
    if finding == app.FINDING_HOT {
        const profiles = access_module.profilesOf(codemap)
        const all = if profiles.*.allSamples > 0 { profiles.*.allSamples } else { 1 }
        var length = filters_module.writeNumber(codemap, out, 0, @intCast(usize, @intCast(u64, profiles_module.totalOf(profiles, symbol)) * 100 / all))
        length = filters_module.writeText(out, length, access_module.say(codemap, "% with calls, ", "% mit Aufrufen, "))
        length = filters_module.writeNumber(codemap, out, length, @intCast(usize, @intCast(u64, profiles_module.selfOf(profiles, symbol)) * 100 / all))
        return filters_module.writeText(out, length, access_module.say(codemap, "% itself", "% selbst"))
    }
    return 0
}

pub fn drawKeptFindings(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const left = filters_module.detailX(codemap)
    const height = access_module.viewHeight(codemap)
    canvas_module.fillRect(canvas, left, app.TOOLBAR, app.DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, app.TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = app.DETAIL - 40
    var y = app.TOOLBAR + 18 - codemap.*.detailScroll
    const german = codemap.*.german
    const bottom = access_module.surfaceHeight(codemap) - app.STATUS
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    if codemap.*.finding == app.FINDING_WORKAROUNDS {
        const workarounds = access_module.workaroundsOf(codemap)
        y += detail_module.drawWrapped(codemap, canvas, "Workarounds", access_module.titleOf(codemap), x, y, width - 100, app.TEXT_COLOR, 1, 22)
        y += 4
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "Where the code works around what the language or its compiler does not do yet, by what is missing: every place is one more reason to add it. The most written first.", "Wo der Code umgeht, was Sprache oder Compiler noch nicht können, nach dem, was fehlt: jede Stelle ist ein Grund mehr, es einzubauen. Das am meisten Geschriebene zuerst."), access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 6, 17)
        y += 8
        y = actions_module.drawTrend(codemap, canvas, x, y, width, bottom)
        var at: usize = 0
        while at < codemap.*.findingCount {
            const pattern = @intCast(u8, codemap.*.findingOrder[at])
            var length = filters_module.writeNumber(codemap, bytes, 0, codemap.*.patternPlaces[@intCast(usize, pattern)])
            length = filters_module.writeText(bytes, length, "x ")
            length = filters_module.writeText(bytes, length, workarounds_module.title(pattern, german))
            y += 8
            y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.WORKAROUND_COLOR, 255), 2, 17)
            y += detail_module.drawWrapped(codemap, canvas, workarounds_module.missing(pattern, german), access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 3, 17)
            y += 4
            if rewrite_module.rewritable(pattern) {
                y += 4
                const button = detail_module.detailButton(codemap, canvas, access_module.say(codemap, "Rewrite ...", "Umschreiben ..."), x, y, @intCast(u32, pattern), app.ROW_REWRITE, false, true)
                y += app.DETAIL_ROW + 8
            }
            const count = workarounds_module.declarations(workarounds, pattern, codemap.*.keptSymbols, codemap.*.keptCounts, app.KEPT_ROWS)
            const section = at + 1
            const most: usize = if codemap.*.expanded[section] { 400 } else { app.SECTION_ROWS }
            var shown: usize = 0
            var entry: usize = 0
            while entry < count && shown < most {
                const node = access_module.nodeOfSymbol(codemap, codemap.*.keptSymbols[entry])
                if node != app.NONE && !filters_module.isHidden(codemap, node) {
                    detail_module.drawRow(codemap, canvas, node, codemap.*.keptCounts[entry], false, x + 6, y, width - 6, app.WORKAROUND_COLOR)
                    y += app.DETAIL_ROW
                    shown += 1
                }
                entry += 1
            }
            if count > shown && !codemap.*.expanded[section] {
                detail_module.addDetailRow(codemap, y, @intCast(u32, section), app.ROW_MORE)
                var more_length = filters_module.writeText(bytes, 0, "+ ")
                more_length = filters_module.writeNumber(codemap, bytes, more_length, count - shown)
                more_length = filters_module.writeText(bytes, more_length, access_module.say(codemap, " more", " weitere"))
                if y > app.TOOLBAR && y < bottom { canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..more_length], x + 22, y + 5, app.ACCENT, 0) }
                y += app.DETAIL_ROW
            }
            at += 1
        }
    } else {
        const crashes = access_module.crashesOf(codemap)
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "Crashes", "Abstürze"), access_module.titleOf(codemap), x, y, width - 100, app.TEXT_COLOR, 1, 22)
        y += 4
        var path: [4096]u8 = undefined
        var path_bytes: [*]u8 = undefined
        unsafe { path_bytes = @ptrCast([*]u8, &path) }
        const path_length = access_module.crashLogPath(codemap, path_bytes)
        var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "What the desktop programs kept when they crashed, newest first: where each stopped and the functions that called it. Their nodes carry a red flag. From ", "Was die Desktop-Programme bei einem Absturz festgehalten haben, das Neueste zuerst: wo jeder stehen blieb und die Funktionen, die dorthin riefen. Ihre Knoten tragen eine rote Fahne. Aus "))
        // Under the home: ~/...
        const home = apps_module.environmentValue(codemap.*.environment, "HOME")
        var skip: usize = 0
        if @intFromPtr(home) != 0 {
            const home_text = std.text.cString(home)
            if home_text.length > 1 && path_length > home_text.length && access_module.sameBytes(path_bytes[0..home_text.length], home_text) && path_bytes[home_text.length] == 47 {
                length = filters_module.writeText(bytes, length, "~")
                skip = home_text.length
            }
        }
        const shown_end = if path_length - skip > 200 { skip + 200 } else { path_length }
        length = filters_module.writeText(bytes, length, path_bytes[skip..shown_end])
        y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 8, 17)
        y += 8
        if crashes.*.count == 0 {
            y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "No crashes kept.", "Keine Abstürze festgehalten."), access_module.bodyOf(codemap), x, y, width, app.TEXT_COLOR, 1, 19)
        }
        var now: [2]usize = [2]usize{ 0, 0 }
        const clock_status = std.linux.syscall2(228, 0, @intFromPtr(&now))
        const most: usize = if codemap.*.expanded[0] { codemap.*.findingCount } else { 30 }
        var at: usize = 0
        while at < codemap.*.findingCount && at < most {
            const record = codemap.*.findingOrder[at]
            length = filters_module.writeText(bytes, 0, crashes_module.field(crashes, record, 2))
            length = filters_module.writeText(bytes, length, ", ")
            length = writeAgo(codemap, bytes, length, now[0], @intCast(usize, crashes_module.timeOf(crashes, record)))
            length = filters_module.writeText(bytes, length, ": ")
            const reason = crashes_module.field(crashes, record, 3)
            length = filters_module.writeText(bytes, length, if reason.length > 300 { reason[0..300] } else { reason })
            y += 8
            y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.CRASH_COLOR, 255), 3, 17)
            y += 2
            var frame = crashes_module.firstFrame(crashes, record)
            var shown: usize = 0
            while frame < crashes.*.frameCount && crashes.*.frameRecord[frame] == record && shown < 12 {
                const node = access_module.nodeOfSymbol(codemap, crashes.*.frameSymbol[frame])
                if node != app.NONE && !filters_module.isHidden(codemap, node) {
                    // The line it was on (the compiler's line table).
                    const where = crashes_module.frameWhere(crashes_module.frameText(crashes, frame))
                    var colon = where.length
                    while colon > 0 && where[colon - 1] != 58 { colon -= 1 }
                    var line_length = filters_module.writeText(bytes, 0, if where.length > 0 { access_module.say(codemap, "line ", "Zeile ") } else { "" })
                    if where.length > 0 { line_length = filters_module.writeText(bytes, line_length, where[colon..where.length]) }
                    detail_module.drawRowNote(codemap, canvas, node, bytes[0..line_length], x + 6, y, width - 6, if crashes.*.frameDepth[frame] == 0 { app.CRASH_COLOR } else { 0 })
                } else if y > app.TOOLBAR && y < bottom {
                    canvas_module.drawText(canvas, access_module.smallOf(codemap), crashes_module.frameText(crashes, frame), x + 22, y + 5, app.DIM_COLOR, width - 22)
                }
                y += app.DETAIL_ROW
                shown += 1
                frame += 1
            }
            at += 1
        }
        if at < codemap.*.findingCount {
            detail_module.addDetailRow(codemap, y, 0, app.ROW_MORE)
            length = filters_module.writeText(bytes, 0, "+ ")
            length = filters_module.writeNumber(codemap, bytes, length, codemap.*.findingCount - at)
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
            if y > app.TOOLBAR && y < bottom { canvas_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 22, y + 5, app.ACCENT, 0) }
            y += app.DETAIL_ROW
        }
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - app.TOOLBAR + 20
    detail_module.drawCloseButton(codemap, canvas)
}

// How long ago `then` was (seconds since 1970), as "5 min ago".
fn writeAgo(codemap: *app.Codemap, out: [*]u8, at: usize, now: usize, then: usize) -> usize {
    const seconds = if now > then { now - then } else { 0 }
    var length = filters_module.writeText(out, at, access_module.say(codemap, "", "vor "))
    if seconds < 60 {
        length = filters_module.writeText(out, length, access_module.say(codemap, "just now", "wenigen Sekunden"))
        return length
    }
    if seconds < 3600 {
        length = filters_module.writeNumber(codemap, out, length, seconds / 60)
        length = filters_module.writeText(out, length, " min")
    } else if seconds < 172800 {
        length = filters_module.writeNumber(codemap, out, length, seconds / 3600)
        length = filters_module.writeText(out, length, access_module.say(codemap, " h", " Std."))
    } else {
        length = filters_module.writeNumber(codemap, out, length, seconds / 86400)
        length = filters_module.writeText(out, length, access_module.say(codemap, " days", " Tagen"))
    }
    return filters_module.writeText(out, length, access_module.say(codemap, " ago", ""))
}

// The measures of a declaration: its machine code, the programs that
// reach it (or that none does), its checks, commits, complexity, time
// spent in it and its risk.
fn drawMeasuresOf(codemap: *app.Codemap, canvas: *app.Canvas, symbol: u32, x: i32, y: i32, width: i32) -> i32 {
    var row_y = y
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const programs = access_module.programsOf(codemap)
    var length: usize = 0
    // Programs.
    var reached: usize = 0
    var program: usize = 0
    while program < programs.*.count {
        if programs_module.reaches(programs, program, symbol) { reached += 1 }
        program += 1
    }
    if reached == 0 {
        length = filters_module.writeText(bytes, 0, if programs_module.checked(programs, symbol) { access_module.say(codemap, "Reached by checks only", "Nur von Checks erreicht") } else { access_module.say(codemap, "No program reaches it", "Kein Programm erreicht das") })
    } else {
        length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Reached by ", "Erreicht von "))
        var named: usize = 0
        program = 0
        while program < programs.*.count && named < 4 {
            if programs_module.reaches(programs, program, symbol) {
                if named > 0 { length = filters_module.writeText(bytes, length, ", ") }
                length = filters_module.writeText(bytes, length, programs_module.nameOf(programs, program))
                named += 1
            }
            program += 1
        }
        if reached > named {
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " and ", " und "))
            length = filters_module.writeNumber(codemap, bytes, length, reached - named)
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
        }
        length = filters_module.writeText(bytes, length, if programs_module.checked(programs, symbol) { access_module.say(codemap, "; checked", "; geprüft") } else { access_module.say(codemap, "; no check reaches it", "; kein Check erreicht das") })
    }
    row_y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, row_y, width, app.DIM_COLOR, 3, 17)
    // Machine code, commits, complexity, time, risk: one line.
    length = 0
    const bytes_of = binaries_module.bytesOf(access_module.binariesOf(codemap), symbol)
    if bytes_of > 0 {
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, bytes_of))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " bytes of code", " Bytes Code"))
    }
    const commits = history_module.commitsOf(access_module.historyOf(codemap), symbol)
    if commits > 0 {
        if length > 0 { length = filters_module.writeText(bytes, length, " · ") }
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, commits))
        length = filters_module.writeText(bytes, length, " Commits")
    }
    const branches = complexity_module.branchesOf(access_module.complexityOf(codemap), symbol)
    if branches > 0 {
        if length > 0 { length = filters_module.writeText(bytes, length, " · ") }
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, branches))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " branches, ", " Zweige, "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, complexity_module.depthOf(access_module.complexityOf(codemap), symbol)))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " deep", " tief"))
    }
    const samples = profiles_module.totalOf(access_module.profilesOf(codemap), symbol)
    if samples > 0 {
        const all = if access_module.profilesOf(codemap).*.allSamples > 0 { access_module.profilesOf(codemap).*.allSamples } else { 1 }
        if length > 0 { length = filters_module.writeText(bytes, length, " · ") }
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, @intCast(u64, samples) * 100 / all))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, "% of the time", "% der Zeit"))
    }
    const risk = measures_module.risk(access_module.measuresOf(codemap), symbol)
    if risk > 0 {
        if length > 0 { length = filters_module.writeText(bytes, length, " · ") }
        length = filters_module.writeText(bytes, length, access_module.say(codemap, "risk ", "Risiko "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, risk))
    }
    if length > 0 { row_y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, row_y, width, if risk >= measures_module.RISKY { filters_module.canvasColor(app.RISKY_COLOR, 255) } else { app.DIM_COLOR }, 3, 17) }
    return row_y
}

// What the crashes and the workarounds say of a declaration.
fn drawKeptOf(codemap: *app.Codemap, canvas: *app.Canvas, symbol: u32, x: i32, y: i32, width: i32) -> i32 {
    var row_y = y
    var text: [512]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const crashes = access_module.crashesOf(codemap)
    const latest = crashes_module.latestOf(crashes, symbol)
    if latest != app.NONE {
        const stopped = crashes_module.stoppedIn(crashes, symbol)
        const through = crashes_module.wentThrough(crashes, symbol)
        var length: usize = 0
        if stopped > 0 {
            length = filters_module.writeText(bytes, length, access_module.say(codemap, "Crashed here ", "Hier abgestürzt "))
            length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, stopped))
            length = filters_module.writeText(bytes, length, "x")
            if through > 0 { length = filters_module.writeText(bytes, length, ", ") }
        }
        if through > 0 {
            length = filters_module.writeText(bytes, length, access_module.say(codemap, "on the way of a crash ", "auf dem Weg eines Absturzes "))
            length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, through))
            length = filters_module.writeText(bytes, length, "x")
        }
        length = filters_module.writeText(bytes, length, access_module.say(codemap, ". Last: ", ". Zuletzt: "))
        length = filters_module.writeText(bytes, length, crashes_module.field(crashes, latest, 2))
        length = filters_module.writeText(bytes, length, ", ")
        const reason = crashes_module.field(crashes, latest, 3)
        length = filters_module.writeText(bytes, length, if reason.length > 240 { reason[0..240] } else { reason })
        row_y += 4
        row_y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, row_y, width, filters_module.canvasColor(app.CRASH_COLOR, 255), 4, 17)
    }
    const workarounds = access_module.workaroundsOf(codemap)
    const marks = workarounds_module.marksOf(workarounds, symbol)
    if marks != 0 {
        var pattern: usize = 0
        while pattern < workarounds_module.PATTERNS {
            if marks & (@intCast(u16, 1) << @intCast(u16, pattern)) != 0 {
                const places = workarounds_module.placesIn(workarounds, @intCast(u8, pattern), symbol, codemap.*.keptCounts, app.KEPT_ROWS)
                var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Workaround: ", "Workaround: "))
                length = filters_module.writeText(bytes, length, workarounds_module.title(@intCast(u8, pattern), codemap.*.german))
                if places > 1 {
                    length = filters_module.writeText(bytes, length, " (")
                    length = filters_module.writeNumber(codemap, bytes, length, places)
                    length = filters_module.writeText(bytes, length, "x)")
                }
                length = filters_module.writeText(bytes, length, ". ")
                length = filters_module.writeText(bytes, length, workarounds_module.missing(@intCast(u8, pattern), codemap.*.german))
                row_y += 2
                row_y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, row_y, width, filters_module.canvasColor(app.WORKAROUND_COLOR, 255), 3, 17)
            }
            pattern += 1
        }
    }
    return row_y
}

fn drawDetail(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    codemap.*.detailRowCount = 0
    if !access_module.detailOpen(codemap) { return }
    if codemap.*.rewritePattern != 255 {
        actions_module.drawRewrite(codemap, canvas)
        return
    }
    if codemap.*.selected == app.NONE {
        detail_module.drawFindings(codemap, canvas)
        return
    }
    const node = codemap.*.selected
    const record = access_module.nodeOf(codemap, node)
    const left = filters_module.detailX(codemap)
    const height = access_module.viewHeight(codemap)
    canvas_module.fillRect(canvas, left, app.TOOLBAR, app.DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, app.TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = app.DETAIL - 40
    const top = app.TOOLBAR + 18 - codemap.*.detailScroll
    var y = top
    // The kind, the name, where it is.
    drawing_module.drawDot(canvas, x, y + 3, 10, filters_module.canvasColor(record.*.color, 255))
    canvas_module.drawText(canvas, access_module.smallOf(codemap), filters_module.kindLabel(codemap, node), x + 16, y, app.DIM_COLOR, 0)
    y += 22
    y += detail_module.drawWrapped(codemap, canvas, access_module.nameOf(codemap, node), access_module.titleOf(codemap), x, y, width, app.TEXT_COLOR, 3, 22)
    var place: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &place) }
    var length: usize = 0
    const index = codemap.*.index
    if record.*.kind == graph_module.DIRECTORY {
        length = filters_module.writeNumber(codemap, bytes, 0, @intCast(usize, record.*.files))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " files, ", " Dateien, "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, record.*.declarations))
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " declarations", " Deklarationen"))
    } else {
        length = filters_module.writeText(bytes, 0, graph_module.pathOf(access_module.graphOf(codemap), node))
        if record.*.kind == graph_module.DECLARATION {
            const symbol = index_module.symbolAt(index, record.*.symbol)
            length = filters_module.writeText(bytes, length, ":")
            length = filters_module.writeNumber(codemap, bytes, length, index_module.lineOf(index, symbol.*.file, @intCast(usize, symbol.*.nameStart)) + 1)
        }
    }
    y += 4
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 3, 17)
    // Its weight: how often it is used, from outside itself.
    if record.*.kind != graph_module.DIRECTORY {
        const uses = if record.*.kind == graph_module.DECLARATION { @intCast(usize, analysis_module.usesOf(access_module.analysisOf(codemap), record.*.symbol)) } else { 0 }
        const outside = @intCast(usize, graph_module.weightTo(access_module.graphOf(codemap), node))
        var weight: [96]u8 = undefined
        var weight_bytes: [*]u8 = undefined
        unsafe { weight_bytes = @ptrCast([*]u8, &weight) }
        var weight_length: usize = 0
        if record.*.kind == graph_module.DECLARATION {
            weight_length = filters_module.writeText(weight_bytes, 0, access_module.say(codemap, "Used ", "Verwendet "))
            weight_length = filters_module.writeNumber(codemap, weight_bytes, weight_length, uses)
            weight_length = filters_module.writeText(weight_bytes, weight_length, access_module.say(codemap, "x, from elsewhere ", "x, von anderswo "))
        } else {
            weight_length = filters_module.writeText(weight_bytes, 0, access_module.say(codemap, "Used from elsewhere ", "Von anderswo verwendet "))
        }
        weight_length = filters_module.writeNumber(codemap, weight_bytes, weight_length, outside)
        weight_length = filters_module.writeText(weight_bytes, weight_length, "x")
        if y > app.TOOLBAR { canvas_module.drawText(canvas, access_module.smallOf(codemap), weight_bytes[0..weight_length], x, y + 2, if uses == 0 && record.*.kind == graph_module.DECLARATION { filters_module.canvasColor(app.FINDING_COLOR, 255) } else { app.DIM_COLOR }, 0) }
        y += 20
    }
    if record.*.kind == graph_module.DECLARATION {
        y = drawMeasuresOf(codemap, canvas, record.*.symbol, x, y, width)
        y = drawKeptOf(codemap, canvas, record.*.symbol, x, y, width)
    }
    // Open in the editor.
    if record.*.kind != graph_module.DIRECTORY {
        y += 8
        const label = access_module.say(codemap, "Open in editor", "Im Editor öffnen")
        const button_width = canvas_module.measure(access_module.bodyOf(codemap), label) + 24
        const hit = app.HIT_ROW + codemap.*.detailRowCount
        detail_module.addDetailRow(codemap, y, node, app.ROW_OPEN)
        if y + app.DETAIL_ROW > app.TOOLBAR {
            canvas_module.fillRoundedRect(canvas, x, y - 2, button_width, 28, 8, if codemap.*.hover == hit { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 52, 56, 68) })
            canvas_module.drawText(canvas, access_module.bodyOf(codemap), label, x + 12, y + 4, app.TEXT_COLOR, 0)
        }
        y += 34
    }
    // The signature.
    if record.*.kind == graph_module.DECLARATION {
        var start: usize = 0
        var size: usize = 0
        index_module.signatureRange(index, record.*.symbol, &start, &size)
        if size > 0 {
            const source = index_module.sourceOf(index, index_module.symbolAt(index, record.*.symbol).*.file)
            const signature = source[start..start + (if size > 600 { 600 } else { size })]
            y += 4
            // Its box, sized by drawing it once out of sight first.
            const lines_height = measureWrapped(codemap, signature, access_module.smallOf(codemap), width - 20, 8, 17)
            if y + lines_height + 12 > app.TOOLBAR { canvas_module.fillRoundedRect(canvas, x, y, width, lines_height + 14, 8, canvas_module.color(255, 17, 18, 24)) }
            y += 7
            y += detail_module.drawWrapped(codemap, canvas, signature, access_module.smallOf(codemap), x + 10, y, width - 20, canvas_module.color(255, 190, 210, 255), 8, 17)
            y += 12
        }
    }
    // The doc comment.
    var doc: [4096]u8 = undefined
    var doc_bytes: [*]u8 = undefined
    unsafe { doc_bytes = @ptrCast([*]u8, &doc) }
    const doc_length = detail_module.docText(codemap, node, doc_bytes, 4096)
    if doc_length > 0 {
        y += 6
        y += detail_module.drawWrapped(codemap, canvas, doc_bytes[0..doc_length], access_module.bodyOf(codemap), x, y, width, canvas_module.color(255, 206, 210, 220), 30, 19)
        y += 4
    }
    // What it connects to.
    const relations = access_module.relationsOf(codemap)
    if record.*.kind == graph_module.DECLARATION {
        y = detail_module.drawSection(codemap, canvas, 0, access_module.say(codemap, "Calls", "Ruft auf"), relations.*.outgoing, relations.*.outgoingCount, @intCast(i32, graph_module.RELATION_CALL), app.OUTGOING, x, y, width)
        y = detail_module.drawSection(codemap, canvas, 1, access_module.say(codemap, "Uses", "Verwendet"), relations.*.outgoing, relations.*.outgoingCount, @intCast(i32, graph_module.RELATION_USE), app.OUTGOING, x, y, width)
        y = detail_module.drawSection(codemap, canvas, 2, access_module.say(codemap, "Called by", "Aufgerufen von"), relations.*.incoming, relations.*.incomingCount, @intCast(i32, graph_module.RELATION_CALL), app.INCOMING, x, y, width)
        y = detail_module.drawSection(codemap, canvas, 3, access_module.say(codemap, "Used by", "Verwendet von"), relations.*.incoming, relations.*.incomingCount, @intCast(i32, graph_module.RELATION_USE), app.INCOMING, x, y, width)
        y = detail_module.drawMembers(codemap, canvas, 4, access_module.say(codemap, "Members", "Mitglieder"), node, x, y, width)
        // What the code base as a whole says of it.
        const analysis = access_module.analysisOf(codemap)
        const symbol = record.*.symbol
        y = detail_module.drawSymbols(codemap, canvas, 5, access_module.say(codemap, "Same code", "Gleicher Code"), analysis, analysis_module.COPIES, analysis_module.groupOf(analysis, analysis_module.COPIES, symbol), symbol, x, y, width)
        y = detail_module.drawSymbols(codemap, canvas, 6, access_module.say(codemap, "Same but for names and values", "Gleich bis auf Namen und Werte"), analysis, analysis_module.SHAPES, analysis_module.groupOf(analysis, analysis_module.SHAPES, symbol), symbol, x, y, width)
        y = detail_module.drawSymbols(codemap, canvas, 7, access_module.say(codemap, "Same name elsewhere", "Gleicher Name anderswo"), analysis, analysis_module.NAMES, analysis_module.groupOf(analysis, analysis_module.NAMES, symbol), symbol, x, y, width)
        if codemap.*.similarCount > 0 {
            y += 10
            if y > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS { canvas_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "Used much alike", "Ähnlich verwendet"), x, y, filters_module.canvasColor(app.FINDING_COLOR, 255), 0) }
            y += 20
            var similar: usize = 0
            while similar < codemap.*.similarCount {
                detail_module.drawRow(codemap, canvas, codemap.*.similarNodes[similar], codemap.*.similarShares[similar], true, x + 6, y, width - 6, app.FINDING_COLOR)
                y += app.DETAIL_ROW
                similar += 1
            }
        }
        if relations.*.outgoingCount == 0 && relations.*.incomingCount == 0 && record.*.childCount == 0 {
            y += 10
            canvas_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "Nothing uses it.", "Nichts verwendet das."), x, y, app.DIM_COLOR, 0)
            y += 20
        }
    } else if record.*.kind == graph_module.FILE {
        y = detail_module.drawSection(codemap, canvas, 0, access_module.say(codemap, "Imports", "Importiert"), relations.*.outgoing, relations.*.outgoingCount, -1, app.OUTGOING, x, y, width)
        y = detail_module.drawSection(codemap, canvas, 1, access_module.say(codemap, "Imported by", "Importiert von"), relations.*.incoming, relations.*.incomingCount, -1, app.INCOMING, x, y, width)
        y = detail_module.drawMembers(codemap, canvas, 4, access_module.say(codemap, "Declarations", "Deklarationen"), node, x, y, width)
    } else {
        y = detail_module.drawSection(codemap, canvas, 0, access_module.say(codemap, "Depends on", "Hängt ab von"), relations.*.outgoing, relations.*.outgoingCount, -1, app.OUTGOING, x, y, width)
        y = detail_module.drawSection(codemap, canvas, 1, access_module.say(codemap, "Used by", "Genutzt von"), relations.*.incoming, relations.*.incomingCount, -1, app.INCOMING, x, y, width)
        y = detail_module.drawMembers(codemap, canvas, 4, access_module.say(codemap, "Contains", "Enthält"), node, x, y, width)
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - app.TOOLBAR + 20
    // Closing it (over what scrolls).
    const close_x = access_module.surfaceWidth(codemap) - 38
    canvas_module.fillRoundedRect(canvas, close_x, app.TOOLBAR + 10, 28, 28, 14, if codemap.*.hover == app.HIT_CLOSE { canvas_module.color(255, 72, 76, 92) } else { canvas_module.color(255, 44, 47, 58) })
    var step: i32 = 0
    while step < 10 {
        canvas_module.fillRect(canvas, close_x + 9 + step, app.TOOLBAR + 19 + step, 2, 2, app.TEXT_COLOR)
        canvas_module.fillRect(canvas, close_x + 18 - step, app.TOOLBAR + 19 + step, 2, 2, app.TEXT_COLOR)
        step += 1
    }
    // A thin bar while there is more to scroll to.
    const view = height - 20
    if codemap.*.detailHeight > view {
        var thumb = view * view / codemap.*.detailHeight
        if thumb < 30 { thumb = 30 }
        const most = codemap.*.detailHeight - view
        const bar_y = app.TOOLBAR + 10 + (view - thumb) * codemap.*.detailScroll / (if most > 0 { most } else { 1 })
        canvas_module.fillRoundedRect(canvas, access_module.surfaceWidth(codemap) - 8, bar_y, 5, thumb, 3, canvas_module.color(110, 200, 205, 215))
    }
}

// The height drawWrapped would take.
fn measureWrapped(codemap: *app.Codemap, text: []const u8, font: *app.Text, width: i32, most: usize, line_height: i32) -> i32 {
    var lines: usize = 0
    var start: usize = 0
    while start < text.length && lines < most {
        var end = start
        var fit_end = start
        while end < text.length && text[end] != 10 {
            var word_end = end
            while word_end < text.length && text[word_end] == 32 { word_end += 1 }
            while word_end < text.length && text[word_end] != 32 && text[word_end] != 10 { word_end += 1 }
            if canvas_module.measure(font, text[start..word_end]) > width && fit_end > start { break }
            fit_end = word_end
            end = word_end
            if canvas_module.measure(font, text[start..word_end]) > width { break }
        }
        if fit_end == start { fit_end = end }
        if fit_end == start && start < text.length { fit_end = start + 1 }
        lines += 1
        start = fit_end
        while start < text.length && text[start] == 32 { start += 1 }
        if start < text.length && text[start] == 10 { start += 1 }
    }
    return @intCast(i32, lines) * line_height
}

pub fn draw(context: *anyopaque, canvas: *app.Canvas) -> void {
    const codemap = access_module.codemapOf(context)
    const where = aggregates.mark(codemap.*.graph.arena)
    drawFrame(codemap, canvas)
    aggregates.reset(codemap.*.graph.arena, where)
}

fn drawFrame(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const width = access_module.surfaceWidth(codemap)
    const height = access_module.surfaceHeight(codemap)
    canvas_module.clear(canvas, 0)
    drawing_module.beginOverlays(codemap)
    map_view_module.buildScene(codemap)
    // Without the GPU the scene is drawn here, under the rest.
    if canvas.*.device == 0 { scene_module.drawCpu(access_module.sceneOf(codemap), canvas.*.pixels, canvas.*.width, canvas.*.width, canvas.*.height) }
    if !codemap.*.built {
        const message = access_module.say(codemap, "Reading the code...", "Der Code wird gelesen ...")
        canvas_module.drawText(canvas, access_module.titleOf(codemap), message, app.SIDEBAR + (width - app.SIDEBAR - canvas_module.measure(access_module.titleOf(codemap), message)) / 2, app.TOOLBAR + (height - app.TOOLBAR - app.STATUS) / 2 - 10, app.DIM_COLOR, 0)
        const root = access_module.rootText(codemap)
        canvas_module.drawText(canvas, access_module.smallOf(codemap), root, app.SIDEBAR + (width - app.SIDEBAR - canvas_module.measure(access_module.smallOf(codemap), root)) / 2, app.TOOLBAR + (height - app.TOOLBAR - app.STATUS) / 2 + 20, app.DIM_COLOR, 0)
    }
    if codemap.*.view == app.VIEW_EDITOR {
        editor_view_module.drawEditor(codemap, canvas)
    } else {
        map_view_module.placeLabels(codemap)
        map_view_module.drawLabels(codemap, canvas)
    }
    drawDetail(codemap, canvas)
    drawing_module.drawToolbar(codemap, canvas)
    drawing_module.drawStatus(codemap, canvas)
    drawing_module.drawSidebar(codemap, canvas)
    drawing_module.drawResults(codemap, canvas)
    drawing_module.fadeDone(canvas)
    lists_module.drawPopup(codemap, canvas)
    drawing_module.fadeDone(canvas)
    project_module.drawCreate(codemap, canvas)
    drawing_module.endOverlays(codemap, canvas)
    codemap.*.drawnOnce = true
    // The flight goes on.
    if codemap.*.flying { navigation_module.animate(codemap) }
}

// The scene, drawn by the GPU under what the canvas drew (panel.Scene).
pub fn drawScene(context: *anyopaque, gpu_context: *gpu.Context, target: vk.Buffer, width: u32, height: u32) -> bool {
    const codemap = access_module.codemapOf(context)
    const where = aggregates.mark(codemap.*.graph.arena)
    const rendered = scene_module.render(access_module.sceneOf(codemap), gpu_context, target, width, height)
    aggregates.reset(codemap.*.graph.arena, where)
    return rendered
}
