// Hit testing and input (part of main.mlx, split from it).
const canvas_module = @import("../desktop/shared/canvas.mlx")
const panel_module = @import("../desktop/shared/panel.mlx")
const crash = @import("std.crash")
const index_module = @import("../../tools/codemap/index.mlx")
const aggregates = @import("../../tools/codemap/aggregates.mlx")
const crashes_module = @import("../../tools/codemap/crashes.mlx")
const history_module = @import("../../tools/codemap/history.mlx")
const profiles_module = @import("../../tools/codemap/profiles.mlx")
const measures_module = @import("../../tools/codemap/measures.mlx")
const views_module = @import("../../tools/codemap/views.mlx")
const run_module = @import("./run.mlx")
const editor_module = @import("./editor.mlx")
const m = @import("./math3d.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const lists_module = @import("./lists.mlx")
const map_view_module = @import("./map_view.mlx")
const drawing_module = @import("./drawing.mlx")
const tabs_module = @import("./tabs.mlx")
const editor_view_module = @import("./editor_view.mlx")
const assist_module = @import("./assist.mlx")
const project_module = @import("./project.mlx")
const actions_module = @import("./actions.mlx")
const demo_module = @import("./demo.mlx")

// ---------------------------------------------------------------------------
// Hit testing

fn backX() -> i32 { return app.SIDEBAR + 12 }
fn forwardX() -> i32 { return app.SIDEBAR + 12 + app.BUTTON + 4 }
pub fn searchX(codemap: *app.Codemap) -> i32 { return access_module.surfaceWidth(codemap) - 14 - app.SEARCH_WIDTH }
pub fn keepX(codemap: *app.Codemap) -> i32 { return searchX(codemap) - 6 - app.BUTTON }
pub fn filterWidth(codemap: *app.Codemap) -> i32 { return canvas_module.measure(access_module.bodyOf(codemap), filterLabel(codemap)) + 36 }
pub fn filterX(codemap: *app.Codemap) -> i32 { return keepX(codemap) - 6 - filterWidth(codemap) }
pub fn filterLabel(codemap: *app.Codemap) -> []const u8 { return "Filter" }
pub fn baseWidth(codemap: *app.Codemap) -> i32 {
    var text: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = writeBaseLabel(codemap, bytes)
    return canvas_module.measure(access_module.bodyOf(codemap), bytes[0..length]) + 46 + changesPillWidth(codemap)
}
pub fn baseX(codemap: *app.Codemap) -> i32 { return filterX(codemap) - 8 - baseWidth(codemap) }

// The files changed and not committed, as a small count by the history's
// label (a commit running: "...").
pub fn writeChangesPill(codemap: *app.Codemap, into: [*]u8) -> usize {
    if codemap.*.job != app.JOB_NONE { return filters_module.writeText(into, 0, "...") }
    if codemap.*.changeCount == 0 { return 0 }
    return lists_module.writeNumberPlain(into, 0, codemap.*.changeCount)
}
pub fn changesPillWidth(codemap: *app.Codemap) -> i32 {
    var text: [32]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const length = writeChangesPill(codemap, bytes)
    return if length == 0 { 0 } else { canvas_module.measure(access_module.smallOf(codemap), bytes[0..length]) + 20 }
}

// "Since HEAD" (the base of Changed; a commit by its short name).
pub fn writeBaseLabel(codemap: *app.Codemap, into: [*]u8) -> usize {
    var length = filters_module.writeText(into, 0, access_module.say(codemap, "Since ", "Seit "))
    var base_bytes: [*]u8 = undefined
    unsafe { base_bytes = @ptrCast([*]u8, &codemap.*.diffBase) }
    const base = if codemap.*.diffBaseLength > 0 { base_bytes[0..codemap.*.diffBaseLength] } else { "HEAD" }
    return filters_module.writeText(into, length, if base.length > 12 { base[0..7] } else { base })
}
pub fn resultsX(codemap: *app.Codemap) -> i32 { return searchX(codemap) - 150 }
pub fn resultsWidth() -> i32 { return app.SEARCH_WIDTH + 150 }
pub fn resultsShown(codemap: *app.Codemap) -> bool { return codemap.*.searchFocused && codemap.*.searchLength > 0 }

fn hitAt(codemap: *app.Codemap, x: i32, y: i32) -> usize {
    const width = access_module.surfaceWidth(codemap)
    const height = access_module.surfaceHeight(codemap)
    // An open list lies over the rest (the history: the commit's field and
    // buttons over its rows).
    if codemap.*.popup != app.POPUP_NONE {
        const rows = @intCast(i32, codemap.*.popupRows)
        if filters_module.inside(x, y, codemap.*.popupX, app.TOOLBAR - 4, codemap.*.popupWidth, codemap.*.popupRowTop - app.TOOLBAR + 4 + rows * app.POPUP_ROW + 6) {
            if codemap.*.popup == app.POPUP_BASE && y < app.TOOLBAR - 4 + project_module.BRANCH_BAR {
                if x >= codemap.*.branchButtonX && x < codemap.*.branchButtonX + codemap.*.branchButtonWidth { return app.HIT_BRANCH }
                if x >= codemap.*.newBranchX && x < codemap.*.newBranchX + codemap.*.newBranchWidth { return app.HIT_NEW_BRANCH }
                return app.HIT_POPUP
            }
            if codemap.*.popup == app.POPUP_BASE && codemap.*.changeCount > 0 && y < codemap.*.popupRowTop {
                if y >= codemap.*.commitButtonsY && y < codemap.*.commitButtonsY + 30 {
                    if x >= codemap.*.pushButtonX { return app.HIT_COMMIT_PUSH }
                    if x >= codemap.*.commitButtonX { return app.HIT_COMMIT_DO }
                }
                if y >= codemap.*.commitFieldY && y < codemap.*.commitFieldY + 30 { return app.HIT_COMMIT_FIELD }
            }
            if y >= codemap.*.popupRowTop {
                const row = (y - codemap.*.popupRowTop) / app.POPUP_ROW
                if row >= 0 && row < rows { return app.HIT_POPUP_ROW + @intCast(usize, row) }
            }
            return app.HIT_POPUP
        }
    }
    // The search's results lie over the rest.
    if resultsShown(codemap) {
        const top = app.TOOLBAR - 4
        const rows = if codemap.*.resultCount > 0 { @intCast(i32, codemap.*.resultCount) } else { 1 }
        if filters_module.inside(x, y, resultsX(codemap), top, resultsWidth(), rows * app.RESULT_ROW + 12) {
            const row = (y - top - 6) / app.RESULT_ROW
            if row >= 0 && row < @intCast(i32, codemap.*.resultCount) { return app.HIT_RESULT + @intCast(usize, row) }
            return app.HIT_NONE
        }
    }
    if x < app.SIDEBAR {
        if filters_module.inside(x, y, 12, codemap.*.viewSwitchY, app.SIDEBAR - 24, 28) { return if x < app.SIDEBAR / 2 { app.HIT_VIEW_MAP } else { app.HIT_VIEW_EDITOR } }
        var section: usize = 0
        while section < app.SECTIONS {
            if filters_module.inside(x, y, 8, codemap.*.headingY[section], app.SIDEBAR - 16, 20) { return app.HIT_HEADING + section }
            section += 1
        }
        var index: usize = 0
        while index < codemap.*.sidebarCount {
            if filters_module.inside(x, y, 8, codemap.*.sidebarRowY[index], app.SIDEBAR - 16, app.GROUP_ROW) {
                // The check box (and what is left of it), else the row.
                if x < 32 + codemap.*.sidebarIndent[index] * 14 { return app.HIT_GROUP_CHECK + index }
                // Under the pointer: a new file, a new folder in it.
                if x >= app.SIDEBAR - 54 && x < app.SIDEBAR - 34 { return app.HIT_NEW_FILE + index }
                if x >= app.SIDEBAR - 34 && x < app.SIDEBAR - 12 { return app.HIT_NEW_FOLDER + index }
                return app.HIT_GROUP + index
            }
            index += 1
        }
        index = 0
        while index < app.FINDINGS {
            if index < 3 && filters_module.inside(x, y, 12 + @intCast(i32, index % 2) * 100, codemap.*.toggleTop - 3 + @intCast(i32, index / 2) * 20, 98, 19) { return app.HIT_TOGGLE + index }
            if filters_module.inside(x, y, 8, codemap.*.findingY[index], app.SIDEBAR - 16, app.GROUP_ROW) {
                if x < 32 { return app.HIT_FINDING_CHECK + index }
                if index == @intCast(usize, app.FINDING_WORKAROUNDS) && x >= app.SIDEBAR - 72 && x < app.SIDEBAR - 50 { return app.HIT_DROPDOWN }
                return app.HIT_FINDING + index
            }
            index += 1
        }
        if filters_module.inside(x, y, 8, codemap.*.programTop, app.SIDEBAR - 16, app.GROUP_ROW) { return app.HIT_PROGRAMS }
        index = 0
        while index < codemap.*.programRows {
            if filters_module.inside(x, y, 26, codemap.*.programRowY[index], app.SIDEBAR - 34, app.SUB_ROW) { return app.HIT_PROGRAM + index }
            index += 1
        }
        index = 0
        while index < measures_module.METRICS {
            if filters_module.inside(x, y, 8, codemap.*.metricY[index], app.SIDEBAR - 16, app.SUB_ROW) { return app.HIT_METRIC + index }
            index += 1
        }
        index = 0
        while index < codemap.*.patternRows {
            if filters_module.inside(x, y, 26, codemap.*.patternY[index], app.SIDEBAR - 34, app.SUB_ROW) { return app.HIT_PATTERN + index }
            index += 1
        }
        index = 0
        while index < codemap.*.viewRows {
            if filters_module.inside(x, y, 8, codemap.*.viewY[index], app.SIDEBAR - 16, app.SUB_ROW) { return if x >= app.SIDEBAR - 38 { app.HIT_VIEW_REMOVE + index } else { app.HIT_VIEW_ROW + index } }
            index += 1
        }
        index = 0
        while index < app.LEGEND_KINDS {
            if filters_module.inside(x, y, 12 + @intCast(i32, index % 2) * 100, codemap.*.legendTop - 3 + @intCast(i32, index / 2) * 20, 98, 19) { return app.HIT_KIND + index }
            index += 1
        }
        return app.HIT_SIDEBAR
    }
    if y < app.TOOLBAR {
        const top = (app.TOOLBAR - app.BUTTON) / 2
        if filters_module.inside(x, y, searchX(codemap), top, app.SEARCH_WIDTH, app.BUTTON) { return app.HIT_SEARCH }
        if filters_module.inside(x, y, baseX(codemap), top, baseWidth(codemap), app.BUTTON) { return app.HIT_BASE }
        if filters_module.inside(x, y, project_module.buildX(codemap) + project_module.buildWidth(codemap) - project_module.BUILD_ARROW, top, project_module.BUILD_ARROW, app.BUTTON) { return app.HIT_BUILD_MENU }
        if filters_module.inside(x, y, project_module.buildX(codemap), top, project_module.buildWidth(codemap), app.BUTTON) { return app.HIT_BUILD }
        if filters_module.inside(x, y, filterX(codemap), top, filterWidth(codemap), app.BUTTON) { return app.HIT_FILTER }
        if filters_module.inside(x, y, keepX(codemap), top, app.BUTTON, app.BUTTON) { return app.HIT_KEEP }
        return app.HIT_NONE
    }
    if y >= height - app.STATUS {
        // The editor's status bar: the cursor line's hints (Rewrite).
        if codemap.*.view == app.VIEW_EDITOR {
            var chip: usize = 0
            while chip < codemap.*.chipCount {
                if y >= codemap.*.chipY[chip] && y < codemap.*.chipY[chip] + app.EDITOR_LINE && x >= codemap.*.chipX0[chip] && x < codemap.*.chipX1[chip] { return app.HIT_CHIP + chip }
                chip += 1
            }
        }
        var index: usize = 0
        while index < codemap.*.crumbCount {
            const left = codemap.*.crumbX[index]
            const right = if index + 1 < codemap.*.crumbCount { codemap.*.crumbX[index + 1] } else { left + 160 }
            if x >= left - 5 && x < right - 10 { return app.HIT_CRUMB + index }
            index += 1
        }
        return app.HIT_NONE
    }
    if access_module.detailOpen(codemap) && x >= filters_module.detailX(codemap) {
        if filters_module.inside(x, y, width - 38, app.TOOLBAR + 10, 28, 28) { return app.HIT_CLOSE }
        if filters_module.inside(x, y, width - 104, app.TOOLBAR + 10, 30, 28) { return app.HIT_BACK }
        if filters_module.inside(x, y, width - 72, app.TOOLBAR + 10, 30, 28) { return app.HIT_FORWARD }
        var index: usize = 0
        while index < codemap.*.detailRowCount {
            const row_y = codemap.*.detailRowY[index]
            const row_x = codemap.*.detailRowX[index]
            const row_width = codemap.*.detailRowWidth[index]
            if y >= row_y && y < row_y + app.DETAIL_ROW && row_y >= app.TOOLBAR && (row_width == 0 || (x >= row_x && x < row_x + row_width)) { return app.HIT_ROW + index }
            index += 1
        }
        return app.HIT_DETAIL
    }
    if codemap.*.view == app.VIEW_EDITOR {
        if y < app.TOOLBAR + app.TAB_BAR {
            var tab: usize = 0
            while tab < codemap.*.tabCount {
                if x >= codemap.*.tabX[tab] && x < codemap.*.tabX[tab] + codemap.*.tabWidth[tab] {
                    return if x >= codemap.*.tabX[tab] + codemap.*.tabWidth[tab] - 26 { app.HIT_TAB_CLOSE + tab } else { app.HIT_TAB + tab }
                }
                tab += 1
            }
            if tabs_module.hasTab(codemap) && x >= codemap.*.editorMapX { return app.HIT_EDITOR_MAP }
            if tabs_module.hasTab(codemap) && x >= codemap.*.editorSaveX && x < codemap.*.editorMapX - 6 { return app.HIT_EDITOR_SAVE }
            return app.HIT_NONE
        }
        if x >= editor_view_module.editorRight(codemap) - 10 { return app.HIT_EDITOR_SCROLL }
        const in_refs = editor_view_module.refsHit(codemap, x, y)
        if in_refs != app.HIT_NONE { return in_refs }
        var chip: usize = 0
        while chip < codemap.*.chipCount {
            if y >= codemap.*.chipY[chip] && y < codemap.*.chipY[chip] + app.EDITOR_LINE && x >= codemap.*.chipX0[chip] && x < codemap.*.chipX1[chip] { return app.HIT_CHIP + chip }
            chip += 1
        }
        return app.HIT_EDITOR
    }
    return app.HIT_VIEW
}

// The offset of the editor's text under (x, y).
fn editorOffsetAt(codemap: *app.Codemap, x: i32, y: i32) -> usize {
    const editor = tabs_module.activeEditor(codemap)
    const line = editor_view_module.lineAtY(codemap, codemap.*.activeTab, if y < editor_view_module.editorCodeTop() { editor_view_module.editorCodeTop() } else { y })
    if line >= editor.*.lineCount { return editor.*.length }
    var column: i32 = 0
    if x > codemap.*.editorLeft { column = (x - codemap.*.editorLeft + codemap.*.charWidth / 2) / codemap.*.charWidth }
    return editor_module.offsetAt(editor, line, @intCast(usize, column))
}

pub fn setView(codemap: *app.Codemap, view: u8) -> void {
    if codemap.*.view == view { return }
    codemap.*.view = view
    codemap.*.searchFocused = false
    if view == app.VIEW_EDITOR && tabs_module.hasTab(codemap) { tabs_module.followCursor(codemap) }
    // Files saved in the editor: the map reads them again first.
    if view == app.VIEW_MAP && codemap.*.stale { navigation_module.reload(codemap) }
    if view == app.VIEW_MAP && codemap.*.selected != app.NONE { navigation_module.flyTo(codemap, codemap.*.selected) }
    if codemap.*.trace { navigation_module.traceLine(codemap, "view ", if view == app.VIEW_MAP { "map" } else { "editor" }) }
    access_module.panelOf(codemap).*.dirty = true
}

// A press in the editor: the cursor there (Shift: the selection to it;
// twice: the word; Ctrl: its declaration), and dragging selects.
fn pressEditor(codemap: *app.Codemap) -> void {
    if !tabs_module.hasTab(codemap) { return }
    codemap.*.completeOpen = false
    codemap.*.signatureActive = false
    // The chevrons by the text: fold or open the block.
    if codemap.*.pointerX >= codemap.*.editorLeft - 16 && codemap.*.pointerX < codemap.*.editorLeft - 2 {
        const tab = codemap.*.activeTab
        const line = editor_view_module.lineAtY(codemap, tab, codemap.*.pointerY)
        if line < tabs_module.activeEditor(codemap).*.lineCount && (assist_module.foldEndAt(codemap, tab, line) != 18446744073709551615 || assist_module.braceDepth(editor_module.lineText(tabs_module.activeEditor(codemap), line)) > 0) {
            assist_module.toggleFold(codemap, tab, line)
            return
        }
    }
    const editor = tabs_module.activeEditor(codemap)
    const offset = editorOffsetAt(codemap, codemap.*.pointerX, codemap.*.pointerY)
    const held = access_module.modifiers(codemap)
    const now = panel_module.milliseconds()
    if held & app.CONTROL != 0 {
        tabs_module.goToDefinition(codemap, offset)
        return
    }
    if now < codemap.*.editorClickAt + 400 && offset == codemap.*.editorClickOffset {
        var start: usize = 0
        var end: usize = 0
        editor_module.wordAt(editor, offset, &start, &end)
        editor.*.anchor = start
        editor.*.cursor = end
        codemap.*.editorClickAt = 0
        return
    }
    codemap.*.editorClickAt = now
    codemap.*.editorClickOffset = offset
    editor_module.moveTo(editor, offset, held & app.SHIFT != 0)
    codemap.*.editorDragging = true
    tabs_module.followCursor(codemap)
}

// The keys in the editor; false when it is not the editor's.
fn editorKey(codemap: *app.Codemap, key: u32) -> bool {
    if !tabs_module.hasTab(codemap) { return false }
    const editor = tabs_module.activeEditor(codemap)
    const held = access_module.modifiers(codemap)
    const control = held & app.CONTROL != 0
    const shift = held & app.SHIFT != 0
    const alt = held & app.ALT != 0
    const tab = codemap.*.activeTab
    const line_before = editor_module.lineOf(editor, editor_module.selectionStart(editor))
    const lines_before = editor.*.lineCount
    const version_before = editor.*.version
    const cursor_before = editor.*.cursor
    var typed: u8 = 0
    if alt { return false }
    if key == app.KEY_LEFT {
        editor_module.left(editor, shift, control)
    } else if key == app.KEY_RIGHT {
        editor_module.right(editor, shift, control)
    } else if key == app.KEY_UP {
        editor_module.vertical(editor, -1, shift)
    } else if key == app.KEY_DOWN {
        editor_module.vertical(editor, 1, shift)
    } else if key == app.KEY_PAGE_UP {
        editor_module.vertical(editor, -@intCast(isize, editor_view_module.editorRows(codemap)), shift)
    } else if key == app.KEY_PAGE_DOWN {
        editor_module.vertical(editor, @intCast(isize, editor_view_module.editorRows(codemap)), shift)
    } else if key == app.KEY_HOME {
        if control { editor_module.moveTo(editor, 0, shift) } else { editor_module.home(editor, shift) }
    } else if key == app.KEY_END {
        if control { editor_module.moveTo(editor, editor.*.length, shift) } else { editor_module.end(editor, shift) }
    } else if key == app.KEY_BACKSPACE {
        editor_module.backspace(editor, control)
    } else if key == app.KEY_DELETE {
        editor_module.delete(editor, control)
    } else if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        editor_module.newline(editor)
    } else if key == app.KEY_TAB {
        editor_module.tab(editor)
    } else if key == app.KEY_ESCAPE {
        if !editor_module.hasSelection(editor) { return false }
        editor_module.moveTo(editor, editor.*.cursor, false)
    } else if key == app.KEY_F12 {
        tabs_module.goToDefinition(codemap, editor.*.cursor)
        return true
    } else if control && key == app.KEY_S {
        tabs_module.saveTab(codemap)
        return true
    } else if control && key == app.KEY_Z {
        if shift { editor_module.redo(editor) } else { editor_module.undo(editor) }
    } else if control && key == app.KEY_Y {
        editor_module.redo(editor)
    } else if control && key == app.KEY_A {
        editor_module.selectAll(editor)
    } else if control && key == app.KEY_C {
        editor_module.copy(editor)
        return true
    } else if control && key == app.KEY_X {
        editor_module.cut(editor)
    } else if control && key == app.KEY_V {
        editor_module.paste(editor, editor_module.clipboardText(editor))
    } else if control {
        return false
    } else {
        const panel = access_module.panelOf(codemap)
        if panel.*.textLength == 0 || panel.*.text[0] < 32 { return false }
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrCast([*]const u8, &panel.*.text) }
        editor_module.insert(editor, bytes[0..panel.*.textLength])
        typed = bytes[panel.*.textLength - 1]
    }
    // The clipboard is one for all tabs.
    var other: usize = 0
    while other < codemap.*.tabCount {
        if other != tab {
            access_module.editorAt(codemap, other).*.clipboard = editor.*.clipboard
            access_module.editorAt(codemap, other).*.clipboardLength = editor.*.clipboardLength
        }
        other += 1
    }
    if editor.*.version != version_before { tabs_module.shiftMarks(codemap, tab, line_before, lines_before) }
    tabs_module.keepCursorSeen(codemap)
    if editor.*.cursor != cursor_before { tabs_module.followCursor(codemap) }
    // A name typed (or a dot, an @): what fits; a call opened: its
    // signature.
    if typed != 0 && (assist_module.isNameByte(typed) || typed == 46 || typed == 64) {
        assist_module.updateCompletion(codemap)
    } else if key == app.KEY_BACKSPACE && codemap.*.completeOpen {
        assist_module.updateCompletion(codemap)
    } else {
        codemap.*.completeOpen = false
    }
    if typed == 40 || typed == 44 { codemap.*.signatureActive = true }
    if key == app.KEY_ESCAPE { codemap.*.signatureActive = false }
    return true
}

fn groupTop(index: usize) -> i32 { return 44 + @intCast(i32, index) * app.GROUP_ROW }

// ---------------------------------------------------------------------------
// Input

fn press(codemap: *app.Codemap, hit: usize, button: u32) -> void {
    const now = panel_module.milliseconds()
    codemap.*.pressed = true
    codemap.*.pressButton = button
    codemap.*.pressHit = hit
    codemap.*.moved = false
    if button != app.BUTTON_LEFT { return }
    const was_focused = codemap.*.searchFocused
    codemap.*.searchFocused = hit == app.HIT_SEARCH || (was_focused && hit >= app.HIT_RESULT && hit < app.HIT_RESULT + app.RESULTS)
    // A click anywhere but in it closes the open list.
    const open_popup = codemap.*.popup
    if hit != app.HIT_POPUP && hit != app.HIT_COMMIT_FIELD && hit != app.HIT_COMMIT_DO && hit != app.HIT_COMMIT_PUSH && hit != app.HIT_BRANCH && hit != app.HIT_NEW_BRANCH && !(hit >= app.HIT_POPUP_ROW && hit < app.HIT_POPUP_ROW + 64) { codemap.*.popup = app.POPUP_NONE }
    if hit == app.HIT_BUILD_MENU {
        if open_popup != app.POPUP_RUN { lists_module.openPopup(codemap, app.POPUP_RUN) }
        return
    }
    if hit != app.HIT_REFS && !(hit >= app.HIT_REF_ROW && hit < app.HIT_REF_ROW + 64) && !(hit >= app.HIT_CHIP && hit < app.HIT_CHIP + app.MAX_CHIPS) { codemap.*.refsOpen = false }
    codemap.*.createOpen = false
    if hit >= app.HIT_POPUP_ROW && hit < app.HIT_POPUP_ROW + 64 {
        lists_module.choosePopupRow(codemap, hit - app.HIT_POPUP_ROW)
    } else if hit == app.HIT_BUILD {
        // Running: the button stops it; else it does what was chosen last.
        if actions_module.runOf(codemap).*.running { run_module.stop(actions_module.runOf(codemap)) } else { actions_module.startAction(codemap, codemap.*.runAction) }
    } else if hit == app.HIT_BRANCH {
        codemap.*.branchesOpen = !codemap.*.branchesOpen
        codemap.*.branchNaming = false
    } else if hit == app.HIT_NEW_BRANCH {
        codemap.*.branchesOpen = true
        codemap.*.branchNaming = true
        codemap.*.branchTextLength = 0
    } else if hit == app.HIT_COMMIT_DO {
        project_module.startCommit(codemap, false)
    } else if hit == app.HIT_COMMIT_PUSH {
        project_module.startCommit(codemap, true)
    } else if hit == app.HIT_VIEW_MAP {
        setView(codemap, app.VIEW_MAP)
    } else if hit == app.HIT_VIEW_EDITOR {
        setView(codemap, app.VIEW_EDITOR)
    } else if hit >= app.HIT_CHIP && hit < app.HIT_CHIP + app.MAX_CHIPS {
        editor_view_module.pressChip(codemap, hit - app.HIT_CHIP)
    } else if hit >= app.HIT_REF_ROW && hit < app.HIT_REF_ROW + 64 {
        editor_view_module.openRef(codemap, codemap.*.refsScroll + hit - app.HIT_REF_ROW)
    } else if hit == app.HIT_REFS {
        // In the list: it stays.
    } else if hit == app.HIT_EDITOR {
        pressEditor(codemap)
    } else if hit >= app.HIT_TAB && hit < app.HIT_TAB + app.MAX_TABS {
        codemap.*.activeTab = hit - app.HIT_TAB
        tabs_module.followCursor(codemap)
    } else if hit >= app.HIT_TAB_CLOSE && hit < app.HIT_TAB_CLOSE + app.MAX_TABS {
        const tab = hit - app.HIT_TAB_CLOSE
        if editor_module.isDirty(access_module.editorAt(codemap, tab)) && access_module.modifiers(codemap) & app.SHIFT == 0 {
            access_module.setNote(codemap, access_module.say(codemap, "Not saved: Ctrl+S saves it, Shift+click closes it anyway", "Nicht gespeichert: Strg+S speichert, Umschalt+Klick schließt trotzdem"), "")
        } else {
            tabs_module.closeTab(codemap, tab)
        }
    } else if hit == app.HIT_EDITOR_SAVE {
        tabs_module.saveTab(codemap)
    } else if hit == app.HIT_EDITOR_MAP {
        const editor = tabs_module.activeEditor(codemap)
        const symbol = tabs_module.declarationOnLine(codemap, codemap.*.activeTab, editor_module.lineOf(editor, editor.*.cursor))
        var node = if symbol != app.NONE { access_module.nodeOfSymbol(codemap, symbol) } else { app.NONE }
        if node == app.NONE && codemap.*.tabFile[codemap.*.activeTab] != app.NONE { node = access_module.nodeOfSymbol(codemap, index_module.fileAt(codemap.*.index, codemap.*.tabFile[codemap.*.activeTab]).*.symbol) }
        setView(codemap, app.VIEW_MAP)
        if node != app.NONE { navigation_module.goTo(codemap, node) }
    } else if hit == app.HIT_BASE {
        if open_popup != app.POPUP_BASE { lists_module.openPopup(codemap, app.POPUP_BASE) }
    } else if hit == app.HIT_FILTER {
        if open_popup != app.POPUP_FILTER { lists_module.openPopup(codemap, app.POPUP_FILTER) }
    } else if hit == app.HIT_KEEP {
        lists_module.saveView(codemap)
    } else if hit == app.HIT_BACK {
        navigation_module.goBack(codemap)
    } else if hit == app.HIT_FORWARD {
        navigation_module.goForward(codemap)
    } else if hit == app.HIT_CLOSE {
        if codemap.*.rewritePattern != 255 {
            codemap.*.rewritePattern = 255
        } else if codemap.*.selected != app.NONE {
            navigation_module.select(codemap, app.NONE)
        } else {
            access_module.openFinding(codemap, app.FINDING_NONE)
        }
    } else if hit >= app.HIT_GROUP_CHECK && hit < app.HIT_GROUP_CHECK + app.SIDEBAR_ROWS {
        filters_module.toggleGroup(codemap, codemap.*.sidebarNodes[hit - app.HIT_GROUP_CHECK])
    } else if hit >= app.HIT_FINDING_CHECK && hit < app.HIT_FINDING_CHECK + app.FINDINGS {
        const which = hit - app.HIT_FINDING_CHECK
        codemap.*.findingOn[which] = !codemap.*.findingOn[which]
        filters_module.refreshFindings(codemap)
    } else if hit == app.HIT_DROPDOWN {
        codemap.*.workaroundsOpen = !codemap.*.workaroundsOpen
    } else if hit >= app.HIT_PATTERN && hit < app.HIT_PATTERN + 9 {
        const pattern = @intCast(usize, codemap.*.patternOrder[hit - app.HIT_PATTERN])
        codemap.*.patternOn[pattern] = !codemap.*.patternOn[pattern]
        codemap.*.findingOn[@intCast(usize, app.FINDING_WORKAROUNDS)] = true
        filters_module.refreshFindings(codemap)
    } else if hit == app.HIT_PROGRAMS {
        codemap.*.programsOpen = !codemap.*.programsOpen
    } else if hit >= app.HIT_PROGRAM && hit < app.HIT_PROGRAM + 128 {
        const row = hit - app.HIT_PROGRAM
        access_module.chooseProgram(codemap, if row == 0 { access_module.programsOf(codemap).*.count } else { @intCast(usize, codemap.*.programOrder[row - 1]) })
    } else if hit >= app.HIT_METRIC && hit < app.HIT_METRIC + measures_module.METRICS {
        codemap.*.metric = @intCast(u8, hit - app.HIT_METRIC)
        access_module.computeMetric(codemap)
        if codemap.*.trace { navigation_module.traceLine(codemap, "color by ", measures_module.name(codemap.*.metric, false)) }
    } else if hit >= app.HIT_HEADING && hit < app.HIT_HEADING + app.SECTIONS {
        drawing_module.toggleSection(codemap, hit - app.HIT_HEADING)
    } else if hit >= app.HIT_VIEW_REMOVE && hit < app.HIT_VIEW_REMOVE + 64 {
        const views = access_module.viewsOf(codemap)
        if codemap.*.trace { navigation_module.traceLine(codemap, "view removed ", views_module.nameOf(views, hit - app.HIT_VIEW_REMOVE)) }
        const removed = views_module.remove(views, access_module.rootText(codemap), hit - app.HIT_VIEW_REMOVE)
    } else if hit >= app.HIT_VIEW_ROW && hit < app.HIT_VIEW_ROW + 64 {
        const views = access_module.viewsOf(codemap)
        const query = views_module.queryOf(views, hit - app.HIT_VIEW_ROW)
        // Chosen again: shown no more.
        if codemap.*.queryActive && access_module.sameBytes(navigation_module.searchQuery(codemap), query) { navigation_module.clearSearch(codemap) } else { navigation_module.setSearch(codemap, query) }
        if codemap.*.trace { navigation_module.traceLine(codemap, "view ", views_module.nameOf(views, hit - app.HIT_VIEW_ROW)) }
    } else if hit >= app.HIT_KIND && hit < app.HIT_KIND + app.LEGEND_KINDS {
        filters_module.toggleKind(codemap, hit - app.HIT_KIND)
    } else if hit >= app.HIT_FINDING && hit < app.HIT_FINDING + app.FINDINGS {
        const which = @intCast(u8, hit - app.HIT_FINDING)
        navigation_module.select(codemap, app.NONE)
        access_module.openFinding(codemap, if codemap.*.finding == which { app.FINDING_NONE } else { which })
    } else if hit >= app.HIT_RESULT && hit < app.HIT_RESULT + app.RESULTS {
        lists_module.chooseResult(codemap, hit - app.HIT_RESULT)
    } else if hit >= app.HIT_GROUP && hit < app.HIT_GROUP + app.SIDEBAR_ROWS {
        navigation_module.goTo(codemap, codemap.*.sidebarNodes[hit - app.HIT_GROUP])
    } else if (hit >= app.HIT_NEW_FILE && hit < app.HIT_NEW_FILE + app.SIDEBAR_ROWS) || (hit >= app.HIT_NEW_FOLDER && hit < app.HIT_NEW_FOLDER + app.SIDEBAR_ROWS) {
        const folder_row = if hit >= app.HIT_NEW_FOLDER { hit - app.HIT_NEW_FOLDER } else { hit - app.HIT_NEW_FILE }
        var folder: [1024]u8 = undefined
        var folder_bytes: [*]u8 = undefined
        unsafe { folder_bytes = @ptrCast([*]u8, &folder) }
        const folder_length = project_module.folderOf(codemap, codemap.*.sidebarNodes[folder_row], folder_bytes)
        project_module.openCreate(codemap, folder_bytes[0..folder_length], hit >= app.HIT_NEW_FOLDER, codemap.*.sidebarRowY[folder_row] + app.GROUP_ROW)
    } else if hit >= app.HIT_TOGGLE && hit < app.HIT_TOGGLE + 3 {
        const which = hit - app.HIT_TOGGLE
        if which == 0 { codemap.*.showImports = !codemap.*.showImports }
        if which == 1 { codemap.*.showTree = !codemap.*.showTree }
        if which == 2 { codemap.*.showLabels = !codemap.*.showLabels }
    } else if hit >= app.HIT_CRUMB && hit < app.HIT_CRUMB + 32 {
        navigation_module.goTo(codemap, codemap.*.crumbNodes[hit - app.HIT_CRUMB])
    } else if hit >= app.HIT_ROW && hit < app.HIT_ROW + app.DETAIL_ROWS {
        const row = hit - app.HIT_ROW
        const kind = codemap.*.detailRowKind[row]
        if kind == app.ROW_NODE {
            navigation_module.goTo(codemap, codemap.*.detailRows[row])
        } else if kind == app.ROW_MORE {
            codemap.*.expanded[@intCast(usize, codemap.*.detailRows[row])] = true
        } else if kind == app.ROW_REWRITE {
            actions_module.planRewrite(codemap, @intCast(u8, codemap.*.detailRows[row]))
        } else if kind == app.ROW_APPLY {
            actions_module.applyRewrite(codemap)
        } else if kind == app.ROW_BACK {
            codemap.*.rewritePattern = 255
            codemap.*.detailScroll = 0
        } else if kind == app.ROW_HISTORY {
            actions_module.countHistory(codemap)
        } else if kind == app.ROW_PROFILE {
            actions_module.startProfile(codemap)
        } else {
            lists_module.openInEditor(codemap, codemap.*.selected)
        }
    }
    codemap.*.lastClick = now
}

fn release(codemap: *app.Codemap) -> void {
    const was_pressed = codemap.*.pressed
    codemap.*.pressed = false
    codemap.*.editorDragging = false
    if !was_pressed || codemap.*.pressHit != app.HIT_VIEW || codemap.*.moved || codemap.*.pressButton != app.BUTTON_LEFT { return }
    // A click in the view: selects; twice flies there.
    const node = map_view_module.nodeAt(codemap, codemap.*.pointerX, codemap.*.pointerY)
    const now = panel_module.milliseconds()
    const is_double = now < codemap.*.lastClickHit + 450 && node == codemap.*.lastClickNode
    codemap.*.lastClickHit = if is_double { 0 } else { now }
    codemap.*.lastClickNode = node
    if node == app.NONE {
        if is_double { navigation_module.goUp(codemap) } else { navigation_module.select(codemap, app.NONE) }
        return
    }
    navigation_module.select(codemap, node)
    if is_double { navigation_module.flyTo(codemap, node) }
}

pub fn motion(codemap: *app.Codemap, x: i32, y: i32) -> bool {
    const dx = x - codemap.*.pointerX
    const dy = y - codemap.*.pointerY
    codemap.*.pointerX = x
    codemap.*.pointerY = y
    if codemap.*.editorDragging && tabs_module.hasTab(codemap) {
        const editor = tabs_module.activeEditor(codemap)
        editor_module.moveTo(editor, editorOffsetAt(codemap, x, y), true)
        // Beyond the top or the bottom: it scrolls.
        if y < editor_view_module.editorCodeTop() && editor.*.top > 0 { editor.*.top -= 1 }
        if y > editor_view_module.editorBottom(codemap) && editor.*.top + 1 < editor.*.lineCount { editor.*.top += 1 }
        return true
    }
    if codemap.*.view == app.VIEW_EDITOR && tabs_module.hasTab(codemap) {
        // Over a line number: its blame.
        const gutter_before = codemap.*.gutterHover
        codemap.*.gutterHover = if x >= app.SIDEBAR && x < codemap.*.editorLeft - 8 && y >= editor_view_module.editorCodeTop() && y < editor_view_module.editorBottom(codemap) && hitAt(codemap, x, y) == app.HIT_EDITOR { editor_view_module.lineAtY(codemap, codemap.*.activeTab, y) } else { 18446744073709551615 }
        if gutter_before != codemap.*.gutterHover {
            codemap.*.hover = hitAt(codemap, x, y)
            return true
        }
        const before = codemap.*.editorHover
        codemap.*.editorHover = if hitAt(codemap, x, y) == app.HIT_EDITOR && x >= codemap.*.editorLeft { editorOffsetAt(codemap, x, y) } else { 18446744073709551615 }
        // Only a name: between words none.
        if codemap.*.editorHover != 18446744073709551615 {
            const editor = tabs_module.activeEditor(codemap)
            var start: usize = 0
            var end: usize = 0
            editor_module.wordAt(editor, codemap.*.editorHover, &start, &end)
            codemap.*.editorHover = if end > start { start } else { 18446744073709551615 }
        }
        if before != codemap.*.editorHover {
            const hit = hitAt(codemap, x, y)
            codemap.*.hover = hit
            return true
        }
    }
    if codemap.*.pressed && codemap.*.pressHit == app.HIT_VIEW {
        const far_x = x - codemap.*.pressX
        const far_y = y - codemap.*.pressY
        if !codemap.*.moved && far_x * far_x + far_y * far_y > 16 { codemap.*.moved = true }
        if codemap.*.moved {
            const panning = codemap.*.pressButton != app.BUTTON_LEFT || access_module.modifiers(codemap) & app.SHIFT != 0
            if panning {
                navigation_module.pan(codemap, dx, dy)
            } else {
                navigation_module.orbit(codemap, -m.toFloat(@intCast(i64, dx)) * 0.006, m.toFloat(@intCast(i64, dy)) * 0.006)
            }
            return true
        }
        return false
    }
    var changed = false
    const hit = hitAt(codemap, x, y)
    if hit != codemap.*.hover {
        codemap.*.hover = hit
        changed = true
    }
    const node = if hit == app.HIT_VIEW && codemap.*.built { map_view_module.nodeAt(codemap, x, y) } else { app.NONE }
    if node != codemap.*.hoverNode {
        codemap.*.hoverNode = node
        changed = true
    }
    return changed
}

pub fn onKey(codemap: *app.Codemap, key: u32) -> void {
    const held = access_module.modifiers(codemap)
    const control = held & app.CONTROL != 0
    const alt = held & app.ALT != 0
    if control && key == app.KEY_W {
        // Edits not saved: a second Ctrl+W (within 4 s) closes anyway.
        const now = panel_module.milliseconds()
        if project_module.unsavedTabs(codemap) > 0 && now > codemap.*.closeAskedAt + 4000 {
            codemap.*.closeAskedAt = now
            access_module.setNote(codemap, access_module.say(codemap, "Tabs not saved: Ctrl+S saves, Ctrl+W again closes anyway", "Tabs nicht gespeichert: Strg+S speichert, nochmal Strg+W schließt trotzdem"), "")
            return
        }
        access_module.panelOf(codemap).*.running = false
        return
    }
    // `/` finds on the map (the text, not the key: a German keyboard has `-`
    // there); in the editor it is typed.
    const slash = access_module.panelOf(codemap).*.textLength == 1 && access_module.panelOf(codemap).*.text[0] == 47
    if control && key == app.KEY_F || (!codemap.*.searchFocused && codemap.*.view != app.VIEW_EDITOR && slash && !control && !alt) {
        codemap.*.searchFocused = true
        return
    }
    if !codemap.*.built { return }
    if project_module.createKey(codemap, key) {
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    if project_module.branchKey(codemap, key) {
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    // The history open with something to commit: the keys write its message.
    if codemap.*.popup == app.POPUP_BASE && codemap.*.changeCount > 0 && project_module.commitKey(codemap, key) {
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    if control && key == app.KEY_B {
        actions_module.startAction(codemap, app.ACTION_BUILD)
        return
    }
    // F5 runs (again: stops), Ctrl+F5 profiles.
    if key == app.KEY_F5 {
        if actions_module.runOf(codemap).*.running { run_module.stop(actions_module.runOf(codemap)) } else { actions_module.startAction(codemap, if control { app.ACTION_PROFILE } else { app.ACTION_RUN }) }
        return
    }
    if control && key == app.KEY_K {
        if codemap.*.popup == app.POPUP_BASE { codemap.*.popup = app.POPUP_NONE } else { lists_module.openPopup(codemap, app.POPUP_BASE) }
        return
    }
    if control && key == app.KEY_E {
        setView(codemap, if codemap.*.view == app.VIEW_MAP { app.VIEW_EDITOR } else { app.VIEW_MAP })
        return
    }
    if control && held & app.SHIFT != 0 && key == app.KEY_O {
        lists_module.openExternally(codemap, codemap.*.selected)
        return
    }
    // The references list, then the editor's keys (not while the search or
    // a list has them).
    if codemap.*.view == app.VIEW_EDITOR && (assist_module.renameKey(codemap, key) || editor_view_module.refsKey(codemap, key) || assist_module.completeKey(codemap, key)) {
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == app.VIEW_EDITOR && key == app.KEY_ESCAPE && codemap.*.signatureActive {
        codemap.*.signatureActive = false
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == app.VIEW_EDITOR && control && held & app.SHIFT != 0 && (key == app.KEY_LEFT_BRACE || key == app.KEY_RIGHT_BRACE) {
        if key == app.KEY_LEFT_BRACE { assist_module.foldAtCursor(codemap) } else { assist_module.unfoldAtCursor(codemap) }
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == app.VIEW_EDITOR && control && key == app.KEY_SPACE {
        assist_module.openCompletion(codemap, true)
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == app.VIEW_EDITOR && key == app.KEY_F2 {
        assist_module.startRename(codemap)
        access_module.panelOf(codemap).*.dirty = true
        return
    }
    if codemap.*.view == app.VIEW_EDITOR && key == app.KEY_F12 && held & app.SHIFT != 0 && tabs_module.hasTab(codemap) {
        const editor = tabs_module.activeEditor(codemap)
        const cursor_y = editor_view_module.lineY(codemap, codemap.*.activeTab, editor_module.lineOf(editor, editor.*.cursor))
        editor_view_module.openRefs(codemap, tabs_module.symbolAtCursor(codemap, editor.*.cursor), codemap.*.editorLeft + @intCast(i32, editor_module.columnOf(editor, editor.*.cursor)) * codemap.*.charWidth, cursor_y + app.EDITOR_LINE)
        return
    }
    if codemap.*.view == app.VIEW_EDITOR && !codemap.*.searchFocused && codemap.*.popup == app.POPUP_NONE {
        if editorKey(codemap, key) {
            access_module.panelOf(codemap).*.dirty = true
            return
        }
    }
    if control && key == app.KEY_S {
        lists_module.saveView(codemap)
        return
    }
    if codemap.*.searchFocused && !control && !alt {
        lists_module.searchKey(codemap, key)
        return
    }
    if control && key == app.KEY_R {
        navigation_module.reload(codemap)
    } else if control && key == app.KEY_O {
        lists_module.openInEditor(codemap, codemap.*.selected)
    } else if alt && key == app.KEY_LEFT || key == app.KEY_BACKSPACE {
        navigation_module.goBack(codemap)
    } else if alt && key == app.KEY_RIGHT {
        navigation_module.goForward(codemap)
    } else if alt && key == app.KEY_UP {
        navigation_module.goUp(codemap)
    } else if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        if codemap.*.selected != app.NONE { navigation_module.flyTo(codemap, codemap.*.selected) }
    } else if key == app.KEY_ESCAPE {
        if codemap.*.popup != app.POPUP_NONE {
            codemap.*.popup = app.POPUP_NONE
        } else if codemap.*.searchLength > 0 {
            navigation_module.clearSearch(codemap)
        } else if codemap.*.view == app.VIEW_EDITOR {
            // The editor keeps its file (the map's selection stays).
        } else if codemap.*.selected != app.NONE {
            navigation_module.select(codemap, app.NONE)
        } else if codemap.*.finding != app.FINDING_NONE {
            access_module.openFinding(codemap, app.FINDING_NONE)
        } else {
            navigation_module.goUp(codemap)
        }
    } else if codemap.*.view == app.VIEW_EDITOR {
        // Without a file open, typing finds one; with one, the editor has
        // the keys (a list over it closes first).
        if !control && !alt && !tabs_module.hasTab(codemap) { lists_module.typeInto(codemap) }
    } else if key == app.KEY_HOME {
        navigation_module.goTo(codemap, access_module.graphOf(codemap).*.root)
    } else if key == app.KEY_LEFT {
        navigation_module.orbit(codemap, 0.12, 0.0)
    } else if key == app.KEY_RIGHT {
        navigation_module.orbit(codemap, -0.12, 0.0)
    } else if key == app.KEY_UP {
        navigation_module.orbit(codemap, 0.0, -0.1)
    } else if key == app.KEY_DOWN {
        navigation_module.orbit(codemap, 0.0, 0.1)
    } else if key == app.KEY_EQUAL || key == app.KEY_KP_PLUS || key == app.KEY_PAGE_UP {
        navigation_module.zoom(codemap, 0.8)
    } else if key == app.KEY_MINUS || key == app.KEY_KP_MINUS || key == app.KEY_PAGE_DOWN {
        navigation_module.zoom(codemap, 1.25)
    } else if !control && !alt {
        lists_module.typeInto(codemap)
    }
}

// Events, frames and the scene make only temporaries in the compiler's
// arena (tools/codemap/aggregates.mlx): it is taken back after each.
pub fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const codemap = access_module.codemapOf(context)
    const where = aggregates.mark(codemap.*.graph.arena)
    handleEvent(codemap, kind, a, b)
    aggregates.reset(codemap.*.graph.arena, where)
}

fn handleEvent(codemap: *app.Codemap, kind: u32, a: u32, b: i32) -> void {
    const panel = access_module.panelOf(codemap)
    if kind == panel_module.EVENT_CONFIGURED {
        // Blur behind the translucent sidebar.
        var rects: [4]i32 = [4]i32{ 0, 0, app.SIDEBAR, access_module.surfaceHeight(codemap) }
        unsafe { panel_module.setBlur(panel, @ptrCast([*]const i32, &rects), 1) }
    } else if kind == panel_module.EVENT_MOTION {
        if !motion(codemap, @bitCast(i32, a), b) { return }
    } else if kind == panel_module.EVENT_LEAVE {
        codemap.*.hover = app.HIT_NONE
        codemap.*.hoverNode = app.NONE
    } else if kind == panel_module.EVENT_BUTTON {
        if b == 1 {
            codemap.*.pressX = codemap.*.pointerX
            codemap.*.pressY = codemap.*.pointerY
            press(codemap, hitAt(codemap, codemap.*.pointerX, codemap.*.pointerY), a)
        } else {
            release(codemap)
        }
    } else if kind == panel_module.EVENT_WHEEL {
        if a != 0 { return }
        var pixels = panel.*.wheelPixels
        if pixels == 0 { pixels = b * 15 }
        const hit = hitAt(codemap, codemap.*.pointerX, codemap.*.pointerY)
        if hit == app.HIT_DETAIL || (hit >= app.HIT_ROW && hit < app.HIT_ROW + app.DETAIL_ROWS) || hit == app.HIT_CLOSE {
            codemap.*.detailScroll += pixels * 3
            if codemap.*.detailScroll > codemap.*.detailHeight - (access_module.viewHeight(codemap) - 40) { codemap.*.detailScroll = codemap.*.detailHeight - (access_module.viewHeight(codemap) - 40) }
            if codemap.*.detailScroll < 0 { codemap.*.detailScroll = 0 }
        } else if (hit == app.HIT_EDITOR || hit == app.HIT_EDITOR_SCROLL) && tabs_module.hasTab(codemap) {
            const editor = tabs_module.activeEditor(codemap)
            var lines = @intCast(isize, pixels) / 6
            if lines == 0 { lines = if pixels > 0 { 1 } else { -1 } }
            var top = @intCast(isize, editor.*.top) + lines
            if top < 0 { top = 0 }
            if top >= @intCast(isize, editor.*.lineCount) { top = @intCast(isize, editor.*.lineCount) - 1 }
            editor.*.top = @intCast(usize, top)
            codemap.*.editorHover = 18446744073709551615
        } else if hit == app.HIT_VIEW {
            navigation_module.zoom(codemap, m.exp(m.toFloat(@intCast(i64, pixels)) * 0.012))
        } else if codemap.*.pointerX < app.SIDEBAR {
            codemap.*.sidebarScroll += pixels * 3
        }
    } else if kind == panel_module.EVENT_KEY {
        access_module.trackModifier(codemap, a, b != 0)
        if b == 0 { return }
        onKey(codemap, a)
    } else if kind == panel_module.EVENT_KEYBOARD_LEAVE {
        codemap.*.held = 0
        return
    } else if kind == panel_module.EVENT_TICK {
        tick(codemap)
        return
    }
    panel.*.dirty = true
}

// Every tick: the code read once the window shows, the flight on.
fn tick(codemap: *app.Codemap) -> void {
    const panel = access_module.panelOf(codemap)
    if !codemap.*.built {
        if !codemap.*.drawnOnce { return }
        navigation_module.buildIndex(codemap)
        tabs_module.startView(codemap)
        app.applyStart(codemap)
        panel.*.dirty = true
    }
    if codemap.*.flying || codemap.*.animating { panel.*.dirty = true }
    if codemap.*.noteLength > 0 && panel_module.milliseconds() >= codemap.*.noteUntil {
        codemap.*.noteLength = 0
        panel.*.dirty = true
    }
    demo_module.watchJobs(codemap)
    actions_module.pumpRun(codemap)
    tabs_module.pumpCheck(codemap)
    tabs_module.refreshTabIndex(codemap)
    demo_module.runDemo(codemap)
    // The history (Git) read on, a little each tick.
    if codemap.*.built && !history_module.finished(access_module.historyOf(codemap)) { access_module.stepHistory(codemap) }
    // A crash since the log was read: flag it.
    if codemap.*.built && panel_module.milliseconds() >= codemap.*.crashCheckAt {
        codemap.*.crashCheckAt = panel_module.milliseconds() + app.CRASH_CHECK
        tabs_module.watchDisk(codemap)
        // New profiles (mlx-profile wrote one): read them again.
        const profiles_time = access_module.profilesTime(codemap)
        if profiles_time != codemap.*.profilesTime {
            codemap.*.profilesTime = profiles_time
            profiles_module.load(access_module.profilesOf(codemap), codemap.*.index, codemap.*.environment)
            access_module.computeMetric(codemap)
            filters_module.refreshFindings(codemap)
            panel.*.dirty = true
        }
        const size = access_module.crashLogSize(codemap)
        if size != codemap.*.crashLogSize {
            const before = access_module.crashesOf(codemap).*.count
            access_module.loadCrashes(codemap)
            filters_module.refreshFindings(codemap)
            if access_module.crashesOf(codemap).*.count > before { tabs_module.noteCrash(codemap) }
            if codemap.*.trace && access_module.crashesOf(codemap).*.count > before { navigation_module.traceLine(codemap, "new crash in ", crashes_module.field(access_module.crashesOf(codemap), @intCast(u32, access_module.crashesOf(codemap).*.count - 1), 2)) }
            panel.*.dirty = true
        }
    }
    panel.*.tickInterval = if codemap.*.flying || codemap.*.demoActive || codemap.*.animating { 16 } else if codemap.*.built && !history_module.finished(access_module.historyOf(codemap)) { 30 } else if codemap.*.noteLength > 0 { 250 } else if access_module.checkOf(codemap).*.running || access_module.buildOf(codemap).*.running || actions_module.runOf(codemap).*.running || codemap.*.job != app.JOB_NONE || tabs_module.refreshWanted(codemap) { 100 } else if codemap.*.historyJob > 0 { 500 } else { app.CRASH_CHECK }
}
