// The program explorer at the top of the sidebar, as an IDE has one: the
// program chosen (a row that opens the list of all of them) and the files
// it is made of as a tree, folders first. A folder opens and closes with a
// click; a click on a file selects it (the map flies to it, the editor
// opens it). With all programs the tree holds every file read. Choosing a
// program opens the folders on the way to its main file (part of
// main.mlx, split from it).
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const glyphs = @import("std.ui.glyphs")
const lists = @import("std.ui.lists")
const ui = @import("std.ui")
const text_module = @import("std.ui.text")
const programs_module = @import("../../tools/codemap/programs.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const graph_module = @import("./graph.mlx")

// The rows of the tree, at most.
pub const ROWS: usize = 512
// A level of the tree, indented.
const INDENT: i32 = 12
// Per node: a file of the program, a folder with one under it.
const MARK_FILE: u8 = 1
const MARK_FOLDER: u8 = 2

pub fn init(codemap: *app.Codemap) -> void {
    codemap.*.explorerCapacity = 0
    codemap.*.explorerCount = 0
    codemap.*.explorerProgram = 0
    codemap.*.explorerReady = false
    codemap.*.explorerRowCount = 0
}

fn fileOf(codemap: *app.Codemap, node: u32) -> u32 {
    var at = node
    while at != app.NONE && access_module.nodeOf(codemap, at).*.kind == graph_module.DECLARATION { at = access_module.nodeOf(codemap, at).*.parent }
    return at
}

fn markFile(codemap: *app.Codemap, file: u32) -> void {
    if file == app.NONE || codemap.*.explorerMarks[@intCast(usize, file)] == MARK_FILE { return }
    codemap.*.explorerMarks[@intCast(usize, file)] = MARK_FILE
    var folder = access_module.nodeOf(codemap, file).*.parent
    while folder != app.NONE && codemap.*.explorerMarks[@intCast(usize, folder)] != MARK_FOLDER {
        codemap.*.explorerMarks[@intCast(usize, folder)] = MARK_FOLDER
        folder = access_module.nodeOf(codemap, folder).*.parent
    }
}

// Opens the folders on the way to `node`.
fn openTo(codemap: *app.Codemap, node: u32) -> void {
    if node == app.NONE { return }
    var folder = access_module.nodeOf(codemap, node).*.parent
    while folder != app.NONE {
        codemap.*.explorerOpen[@intCast(usize, folder)] = 1
        folder = access_module.nodeOf(codemap, folder).*.parent
    }
}

// Which files the tree holds, worked out again when the program or the
// map changed.
fn refresh(codemap: *app.Codemap) -> void {
    const graph = access_module.graphOf(codemap)
    const count = graph.*.count
    if codemap.*.explorerReady && codemap.*.explorerProgram == codemap.*.program && codemap.*.explorerCount == count { return }
    const changed_map = codemap.*.explorerCount != count
    if count > codemap.*.explorerCapacity {
        const capacity = count + count / 2 + 256
        if codemap.*.explorerCapacity > 0 {
            var old: [*]u8 = undefined
            unsafe { old = @ptrCast([*]u8, codemap.*.explorerMarks) }
            codemap.*.allocator.free(old, codemap.*.explorerCapacity * 2, 16)
        }
        const memory = codemap.*.allocator.alloc(capacity * 2, 16)
        if memory == null { return }
        codemap.*.explorerMarks = memory.?
        unsafe { codemap.*.explorerOpen = @ptrFromInt([*]u8, @intFromPtr(memory.?) + capacity) }
        codemap.*.explorerCapacity = capacity
    }
    var node: usize = 0
    while node < count {
        codemap.*.explorerMarks[node] = 0
        if changed_map { codemap.*.explorerOpen[node] = 0 }
        node += 1
    }
    const programs = access_module.programsOf(codemap)
    const all = !access_module.programChosen(codemap)
    node = 0
    while node < count {
        const record = graph_module.nodeAt(graph, @intCast(u32, node))
        if record.*.kind == graph_module.FILE && all {
            markFile(codemap, @intCast(u32, node))
        } else if record.*.kind == graph_module.DECLARATION && !all && programs_module.reaches(programs, codemap.*.program, record.*.symbol) {
            markFile(codemap, fileOf(codemap, @intCast(u32, node)))
        }
        node += 1
    }
    // A program chosen anew: the way to its main file opened.
    if !all && (changed_map || codemap.*.explorerProgram != codemap.*.program) {
        openTo(codemap, access_module.nodeOfSymbol(codemap, programs.*.file[codemap.*.program]))
    }
    codemap.*.explorerProgram = codemap.*.program
    codemap.*.explorerCount = count
    codemap.*.explorerReady = true
}

// One row: a folder (its arrow) or a file (its color); its name.
fn drawRow(codemap: *app.Codemap, canvas: *app.Canvas, node: u32, depth: i32, y: i32, subject: u32) -> void {
    if codemap.*.explorerRowCount >= ROWS { return }
    const row = codemap.*.explorerRowCount
    codemap.*.explorerRows[row] = node
    codemap.*.explorerRowCount += 1
    const record = access_module.nodeOf(codemap, node)
    const context = access_module.uiOf(codemap)
    _ = lists.rowBackground(context, access_module.idOf(app.HIT_EXPLORER + row), ui.rect(8, y, app.SIDEBAR - 16, app.SUB_ROW), node == subject, false)
    const x = 18 + depth * INDENT
    if record.*.kind == graph_module.DIRECTORY {
        glyphs.arrow(canvas, x, y + 6, codemap.*.explorerOpen[@intCast(usize, node)] == 1, app.DIM_COLOR)
    } else {
        glyphs.dot(canvas, x + 2, y + 6, 8, filters_module.canvasColor(record.*.color, 255))
    }
    text_module.drawText(canvas, access_module.smallOf(codemap), access_module.nameOf(codemap, node), x + 16, y + 4, if record.*.kind == graph_module.DIRECTORY { app.TEXT_COLOR } else { app.TEXT_COLOR }, app.SIDEBAR - x - 32)
}

// The children of `parent` in the tree, folders first; the y below them.
fn drawChildren(codemap: *app.Codemap, canvas: *app.Canvas, parent: u32, depth: i32, top: i32, subject: u32) -> i32 {
    var y = top
    var pass: usize = 0
    while pass < 2 {
        var child = access_module.nodeOf(codemap, parent).*.firstChild
        while child != app.NONE {
            const record = access_module.nodeOf(codemap, child)
            const mark = codemap.*.explorerMarks[@intCast(usize, child)]
            if pass == 0 && record.*.kind == graph_module.DIRECTORY && mark == MARK_FOLDER {
                drawRow(codemap, canvas, child, depth, y, subject)
                y += app.SUB_ROW
                if codemap.*.explorerOpen[@intCast(usize, child)] == 1 { y = drawChildren(codemap, canvas, child, depth + 1, y, subject) }
            } else if pass == 1 && record.*.kind == graph_module.FILE && mark == MARK_FILE {
                drawRow(codemap, canvas, child, depth, y, subject)
                y += app.SUB_ROW
            }
            child = record.*.nextSibling
        }
        pass += 1
    }
    return y
}

// The tree below the program's row; the y below it.
pub fn draw(codemap: *app.Codemap, canvas: *app.Canvas, top: i32) -> i32 {
    codemap.*.explorerRowCount = 0
    if !codemap.*.built { return top }
    refresh(codemap)
    if !codemap.*.explorerReady { return top }
    const subject = if codemap.*.selected != app.NONE { codemap.*.selected } else { codemap.*.focus }
    return drawChildren(codemap, canvas, access_module.graphOf(codemap).*.root, 0, top, subject) + 4
}

// A row clicked: a folder opens or closes, a file is gone to.
pub fn click(codemap: *app.Codemap, row: usize) -> void {
    if row >= codemap.*.explorerRowCount { return }
    const node = codemap.*.explorerRows[row]
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY {
        const open = codemap.*.explorerOpen[@intCast(usize, node)] == 1
        codemap.*.explorerOpen[@intCast(usize, node)] = if open { 0 } else { 1 }
        if codemap.*.trace { navigation_module.traceLine(codemap, if open { "explorer closed " } else { "explorer opened " }, access_module.nameOf(codemap, node)) }
        return
    }
    if codemap.*.trace { navigation_module.traceLine(codemap, "explorer file ", access_module.nameOf(codemap, node)) }
    navigation_module.goTo(codemap, node)
}

// The tree opened on the way to `node` (a file selected elsewhere shows
// in the tree).
pub fn reveal(codemap: *app.Codemap, node: u32) -> void {
    if !codemap.*.explorerReady || node == app.NONE || @intCast(usize, node) >= codemap.*.explorerCount { return }
    openTo(codemap, fileOf(codemap, node))
}
