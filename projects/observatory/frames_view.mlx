// The frame timeline under Hot: the frames a program drew while it ran
// with MLX_FRAMES (std.diagnostics writes them, tools/codemap/frames.mlx
// reads them), read again when they change (about once a second while
// one runs). How long the program took to its first frame, its usual
// frame, a chart of the frames (the processor's and the GPU's time on
// each, the line a frame of a 60 Hz display, the spikes marked), and the
// slowest (part of main.mlx, split from it).
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const frames_module = @import("../../tools/codemap/frames.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const detail_module = @import("./detail.mlx")
const lists_module = @import("./lists.mlx")
const navigation_module = @import("./navigation.mlx")
const memory_view_module = @import("./memory_view.mlx")

// The chart's height.
const CHART: i32 = 72

pub fn framesOf(codemap: *app.Codemap) -> *frames_module.Frames {
    unsafe { return @ptrCast(*frames_module.Frames, &codemap.*.frames) }
}

pub fn init(codemap: *app.Codemap) -> void {
    frames_module.init(framesOf(codemap), codemap.*.allocator)
    codemap.*.framesTime = -1
    codemap.*.framesCheckAt = 0
}

fn loaded(codemap: *app.Codemap) -> bool {
    const frames = framesOf(codemap)
    return frames.*.loaded < frames.*.count
}

// When the timelines' directory last changed (-1: there is none).
fn directoryTime(codemap: *app.Codemap) -> isize {
    var path: [4096]u8 = undefined
    const bytes: [*]u8 = &path
    if memory_view_module.directoryOf(codemap, bytes, "frames") == 0 { return -1 }
    var status: std.fs.Stat = undefined
    if std.fs.status(bytes, &status) != 0 { return -1 }
    return status.modifiedSeconds * 1000 + status.modifiedNanoseconds / 1000000
}

// Reads the timelines again when one changed; true when it did.
pub fn refresh(codemap: *app.Codemap) -> bool {
    const time = directoryTime(codemap)
    if time == codemap.*.framesTime { return false }
    codemap.*.framesTime = time
    reload(codemap)
    return true
}

// The newest timeline of the program chosen, else the newest (running
// first), read.
pub fn reload(codemap: *app.Codemap) -> void {
    const frames = framesOf(codemap)
    frames_module.list(frames, codemap.*.environment)
    const which = frames_module.newestOf(frames, memory_view_module.chosenName(codemap))
    const shown = if which < frames.*.count { which } else { frames_module.newestOf(frames, "") }
    if shown >= frames.*.count || !frames_module.load(frames, shown) { return }
    if codemap.*.trace {
        var text: [200]u8 = undefined
        const bytes: [*]u8 = &text
        var length = filters_module.writeText(bytes, 0, frames_module.nameOf(frames, shown))
        length = filters_module.writeText(bytes, length, " pid ")
        length = lists_module.writeNumberPlain(bytes, length, frames.*.pid[shown])
        length = filters_module.writeText(bytes, length, ": ")
        length = lists_module.writeNumberPlain(bytes, length, frames.*.frameCount)
        length = filters_module.writeText(bytes, length, " frames, ")
        length = lists_module.writeNumberPlain(bytes, length, frames.*.spikes)
        length = filters_module.writeText(bytes, length, " spikes, ")
        length = lists_module.writeNumberPlain(bytes, length, frames.*.overBudget)
        length = filters_module.writeText(bytes, length, " over budget")
        navigation_module.traceLine(codemap, "frames ", bytes[0..length])
    }
}

// µs as "0.4 ms" (a tenth) or "120 ms".
fn writeTime(codemap: *app.Codemap, out: [*]u8, at: usize, microseconds: u64) -> usize {
    var length = filters_module.writeNumber(codemap, out, at, microseconds / 1000)
    if microseconds < 100000 {
        length = filters_module.writeText(out, length, access_module.say(codemap, ".", ","))
        length = filters_module.writeNumber(codemap, out, length, microseconds / 100 % 10)
    }
    return filters_module.writeText(out, length, " ms")
}

fn visible(codemap: *app.Codemap, y: i32, height: i32) -> bool {
    return y + height > app.TOOLBAR && y < access_module.surfaceHeight(codemap) - app.STATUS
}

// The frames as columns, newest at the right (several side by side share
// a column when there are many: the slowest of them shows), the
// processor's half yellow and the GPU's blue; a line at a 60 Hz frame,
// red marks over the spikes.
fn drawChart(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    const frames = framesOf(codemap)
    const count = frames.*.frameCount
    if count == 0 || !visible(codemap, top, CHART) { return top + CHART + 6 }
    // Up to the slowest frame, but not so far that one far out (a first
    // frame that loads everything) flattens the rest; a 60 Hz frame at
    // least half way up.
    var scale = frames_module.BUDGET * 2
    var top_work = frames.*.mostWork
    if top_work > frames.*.p95Work * 2 { top_work = frames.*.p95Work * 2 }
    if top_work > scale { scale = top_work + top_work / 8 }
    const room = @intCast(u64, CHART - 6)
    canvas_module.fillRoundedRect(canvas, x, top, width, CHART, 4, app.SEPARATOR_COLOR)
    var columns = count
    if columns * 3 > @intCast(usize, width) { columns = @intCast(usize, width) / 3 }
    const hot = filters_module.canvasColor(app.HOT_COLOR, 255)
    const gpu_color = filters_module.canvasColor(app.GPU_MEMORY_COLOR, 255)
    const spike_color = filters_module.canvasColor(app.ERROR_COLOR, 255)
    var column: usize = 0
    while column < columns {
        const from = column * count / columns
        var to = (column + 1) * count / columns
        if to <= from { to = from + 1 }
        var processor: u64 = 0
        var gpu: u64 = 0
        var spiked = false
        var frame = from
        while frame < to && frame < count {
            if frames.*.processor[frame] > processor { processor = frames.*.processor[frame] }
            if frames.*.gpu[frame] > gpu { gpu = frames.*.gpu[frame] }
            if frames_module.spike(frames, frame) { spiked = true }
            frame += 1
        }
        const left = x + @intCast(i32, column * @intCast(usize, width) / columns)
        const right = x + @intCast(i32, (column + 1) * @intCast(usize, width) / columns)
        var cell = right - left - 1
        if cell < 1 { cell = 1 }
        const bottom = top + CHART - 3
        var processor_height = @intCast(i32, (if processor < scale { processor } else { scale }) * room / scale)
        var gpu_height = @intCast(i32, (if gpu < scale { gpu } else { scale }) * room / scale)
        if processor > 0 && processor_height < 1 { processor_height = 1 }
        if gpu > 0 && gpu_height < 1 { gpu_height = 1 }
        if cell >= 4 {
            const half = cell / 2
            canvas_module.fillRect(canvas, left, bottom - processor_height, half, processor_height, hot)
            canvas_module.fillRect(canvas, left + half, bottom - gpu_height, cell - half, gpu_height, gpu_color)
        } else if processor >= gpu {
            canvas_module.fillRect(canvas, left, bottom - processor_height, cell, processor_height, hot)
        } else {
            canvas_module.fillRect(canvas, left, bottom - gpu_height, cell, gpu_height, gpu_color)
        }
        if spiked { canvas_module.fillRect(canvas, left, top + 2, cell, 3, spike_color) }
        column += 1
    }
    // A frame of a 60 Hz display.
    const budget_y = top + CHART - 3 - @intCast(i32, frames_module.BUDGET * room / scale)
    canvas_module.fillRect(canvas, x, budget_y, width, 1, filters_module.canvasColor(app.ERROR_COLOR, 200))
    const label = access_module.say(codemap, "16.7 ms", "16,7 ms")
    const label_width = text_module.measure(access_module.smallOf(codemap), label) + 10
    const label_y = if budget_y - 18 > top { budget_y - 18 } else { budget_y + 2 }
    canvas_module.fillRoundedRect(canvas, x + width - label_width - 4, label_y, label_width, 16, 4, app.PANEL_COLOR)
    text_module.drawText(canvas, access_module.smallOf(codemap), label, x + width - label_width + 1, label_y + 1, app.TEXT_COLOR, label_width)
    return top + CHART + 6
}

// The block under Hot's text: the timeline of the program chosen (else the
// newest).
pub fn drawBlock(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    var y = top
    const frames = framesOf(codemap)
    if !loaded(codemap) {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "No program has written its frames yet: Profile runs it with MLX_FRAMES=1, or start one with MLX_FRAMES=1.", "Noch hat kein Programm seine Frames geschrieben: Profilieren lässt es mit MLX_FRAMES=1 laufen, oder starte eines mit MLX_FRAMES=1."), access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 3, 17)
        return y + 8
    }
    const which = frames.*.loaded
    var text: [240]u8 = undefined
    const bytes: [*]u8 = &text
    var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Frames: ", "Frames: "))
    length = filters_module.writeText(bytes, length, frames_module.nameOf(frames, which))
    length = filters_module.writeText(bytes, length, " (pid ")
    length = lists_module.writeNumberPlain(bytes, length, frames.*.pid[which])
    length = filters_module.writeText(bytes, length, if frames.*.running[which] { access_module.say(codemap, ", running)", ", läuft)") } else { access_module.say(codemap, ", ended)", ", beendet)") })
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.HOT_COLOR, 255), 2, 17)
    length = filters_module.writeNumber(codemap, bytes, 0, frames.*.drawn)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " frames, the first ", " Frames, der erste "))
    length = writeTime(codemap, bytes, length, frames.*.startup)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " after the start; usually ", " nach dem Start; meist "))
    length = writeTime(codemap, bytes, length, frames.*.medianWork)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, ", 95%: ", ", 95 %: "))
    length = writeTime(codemap, bytes, length, frames.*.p95Work)
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.TEXT_COLOR, 2, 17)
    length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Processor ", "Prozessor "))
    length = writeTime(codemap, bytes, length, frames.*.medianProcessor)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " (95%: ", " (95 %: "))
    length = writeTime(codemap, bytes, length, frames.*.p95Processor)
    length = filters_module.writeText(bytes, length, "), GPU ")
    length = writeTime(codemap, bytes, length, frames.*.medianGpu)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " (95%: ", " (95 %: "))
    length = writeTime(codemap, bytes, length, frames.*.p95Gpu)
    length = filters_module.writeText(bytes, length, ")")
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 2, 17)
    y += 6
    y = drawChart(codemap, canvas, x, y, width)
    length = filters_module.writeNumber(codemap, bytes, 0, frames.*.overBudget)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " over 16.7 ms, ", " über 16,7 ms, "))
    length = filters_module.writeNumber(codemap, bytes, length, frames.*.spikes)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " spikes; the slowest: frame ", " Spitzen; der langsamste: Frame "))
    length = filters_module.writeNumber(codemap, bytes, length, frames.*.serial[frames.*.slowest])
    length = filters_module.writeText(bytes, length, ", ")
    length = writeTime(codemap, bytes, length, frames_module.work(frames, frames.*.slowest))
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, if frames.*.overBudget > 0 { filters_module.canvasColor(app.ERROR_COLOR, 255) } else { app.TEXT_COLOR }, 2, 17)
    y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "A column a frame, the newest at the right: yellow the processor's time, blue the GPU's; the line a frame of a 60 Hz display, red marks over the spikes (four times the usual frame, and 4 ms at least).", "Eine Säule je Frame, der neueste rechts: gelb die Zeit des Prozessors, blau die der GPU; die Linie ein Frame eines 60-Hz-Bildschirms, rote Marken über den Spitzen (viermal der übliche Frame und mindestens 4 ms)."), access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 4, 17)
    return y + 10
}
