// The editor's tabs, and their text in the index (part of main.mlx, split from it).
const std = @import("std")
const panel_module = @import("../desktop/shared/panel.mlx")
const crash = @import("std.crash")
const index_module = @import("../../tools/codemap/index.mlx")
const crashes_module = @import("../../tools/codemap/crashes.mlx")
const workarounds_module = @import("../../tools/codemap/workarounds.mlx")
const git_module = @import("../../tools/codemap/git.mlx")
const profiles_module = @import("../../tools/codemap/profiles.mlx")
const query_module = @import("../../tools/codemap/query.mlx")
const check_module = @import("../../tools/mlx-lsp/check.mlx")
const editor_module = @import("./editor.mlx")
const graph_module = @import("./graph.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const lists_module = @import("./lists.mlx")
const editor_view_module = @import("./editor_view.mlx")
const assist_module = @import("./assist.mlx")
const project_module = @import("./project.mlx")

// ---------------------------------------------------------------------------
// The tab's text in the index: a moment after an edit, the file is read
// again from it (index_module.refreshFile), so the hover, the colors, the
// lens rows, completion and the workarounds know the text as it is.

pub fn refreshWanted(codemap: *app.Codemap) -> bool {
    if !codemap.*.built || codemap.*.view != app.VIEW_EDITOR || !hasTab(codemap) { return false }
    const tab = codemap.*.activeTab
    return codemap.*.tabFile[tab] != app.NONE && activeEditor(codemap).*.version != codemap.*.tabIndexed[tab]
}

pub fn refreshTabIndex(codemap: *app.Codemap) -> void {
    if !refreshWanted(codemap) { return }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const now = panel_module.milliseconds()
    // Still typing: wait until it rests.
    if codemap.*.seenTab != tab || codemap.*.seenVersion != editor.*.version {
        codemap.*.seenTab = tab
        codemap.*.seenVersion = editor.*.version
        codemap.*.lastEditAt = now
        return
    }
    if now < codemap.*.lastEditAt + 300 { return }
    // Much read again since the last build: the whole code, once.
    if index_module.memoryUsed(codemap.*.index) > 2684354560 {
        navigation_module.reload(codemap)
        return
    }
    const index = codemap.*.index
    const file = codemap.*.tabFile[tab]
    if !index_module.refreshFile(index, file, editor.*.text[0..editor.*.length]) { return }
    workarounds_module.refreshFile(access_module.workaroundsOf(codemap), index, file)
    codemap.*.tabIndexed[tab] = editor.*.version
    refreshSpans(codemap, tab)
    if codemap.*.trace {
        navigation_module.traceLine(codemap, "index read again ", tabRelative(codemap, tab))
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = lists_module.writeNumberPlain(bytes, 0, panel_module.milliseconds() - now)
        length = filters_module.writeText(bytes, length, " ms, memory ")
        length = lists_module.writeNumberPlain(bytes, length, index_module.memoryUsed(index) / 1048576)
        length = filters_module.writeText(bytes, length, " MB")
        navigation_module.traceLine(codemap, "index read again in ", bytes[0..length])
    }
    access_module.panelOf(codemap).*.dirty = true
}

// A tab's declarations (lens rows, heat) and workaround places from the
// index again; its other marks (changes, crashes, problems) stay as they
// moved with the edits.
fn refreshSpans(codemap: *app.Codemap, tab: usize) -> void {
    const editor = access_module.editorAt(codemap, tab)
    const lines = editor.*.lineCount
    fitMarks(codemap, tab, lines)
    const marks = marksOf(codemap, tab)
    const heat = heatOf(codemap, tab)
    var line: usize = 0
    while line < codemap.*.tabMarkLines[tab] {
        marks[line] = marks[line] & ~(app.MARK_LENS | app.MARK_WORKAROUND)
        heat[line] = 0
        line += 1
    }
    const index = codemap.*.index
    const file = codemap.*.tabFile[tab]
    const workarounds = access_module.workaroundsOf(codemap)
    const places = placesOfTab(codemap, tab)
    codemap.*.tabPlaceCount[tab] = 0
    var place: usize = 0
    while place < workarounds.*.count {
        if workarounds.*.file[place] == file {
            const at = index_module.lineOf(index, file, @intCast(usize, workarounds.*.offset[place]))
            if at < lines { marks[at] = marks[at] | app.MARK_WORKAROUND }
            if codemap.*.tabPlaces[tab] != 0 && codemap.*.tabPlaceCount[tab] < 4096 {
                places[codemap.*.tabPlaceCount[tab] * 2] = @intCast(u32, at)
                places[codemap.*.tabPlaceCount[tab] * 2 + 1] = @intCast(u32, place)
                codemap.*.tabPlaceCount[tab] += 1
            }
        }
        place += 1
    }
    const spans = spansOf(codemap, tab)
    const profiles = access_module.profilesOf(codemap)
    codemap.*.tabSpanCount[tab] = 0
    var hottest: u32 = 1
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        if record.*.file == file && query_module.isDeclaration(record.*.kind) && record.*.kind != index_module.FIELD && record.*.kind != index_module.MEMBER && codemap.*.tabSpanCount[tab] < 65536 {
            const count = codemap.*.tabSpanCount[tab]
            spans[count * 4] = @intCast(u32, index_module.lineOf(index, file, index_module.declarationOffset(index, id)))
            spans[count * 4 + 1] = @intCast(u32, index_module.lineOf(index, file, index_module.declarationEnd(index, id)))
            spans[count * 4 + 2] = @intCast(u32, index_module.lineOf(index, file, @intCast(usize, record.*.nameStart)))
            spans[count * 4 + 3] = id
            codemap.*.tabSpanCount[tab] = count + 1
            if access_module.measured(codemap, id) && profiles_module.totalOf(profiles, id) > hottest { hottest = profiles_module.totalOf(profiles, id) }
        }
        symbol += 1
    }
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        const first_line = @intCast(usize, spans[span * 4])
        if hasLens(index, spans[span * 4 + 3]) && first_line < lines { marks[first_line] = marks[first_line] | app.MARK_LENS }
        const total = if access_module.measured(codemap, spans[span * 4 + 3]) { profiles_module.totalOf(profiles, spans[span * 4 + 3]) } else { 0 }
        if total > 0 {
            const value = @intCast(u8, 40 + total * 215 / hottest)
            var at = first_line
            while at <= @intCast(usize, spans[span * 4 + 1]) && at < lines {
                if value > heat[at] { heat[at] = value }
                at += 1
            }
        }
        span += 1
    }
}

// A file's time (ms; -1: it is not there).
pub fn fileStamp(path: []const u8) -> isize {
    var name: [1100]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &name) }
    if path.length >= 1090 { return -1 }
    const length = filters_module.writeText(bytes, 0, path)
    bytes[length] = 0
    var status: std.fs.Stat = undefined
    if std.fs.status(bytes, &status) != 0 { return -1 }
    return status.modifiedSeconds * 1000 + status.modifiedNanoseconds / 1000000
}

// The newest time of the indexed files and of their folders (a file added
// or taken out changes its folder's), and how many files are there.
pub fn readDiskStamp(codemap: *app.Codemap, count: *usize) -> isize {
    const index = codemap.*.index
    var newest: isize = 0
    count.* = 0
    var last_folder: usize = 0
    var last_file: u32 = app.NONE
    var file: usize = 0
    while file < index.*.fileCount {
        const path = index_module.pathOf(index, @intCast(u32, file))
        const stamp = fileStamp(path)
        if stamp >= 0 {
            count.* += 1
            if stamp > newest { newest = stamp }
        }
        var folder = path.length
        while folder > 0 && path[folder - 1] != 47 { folder -= 1 }
        if folder > 1 && !(last_file != app.NONE && folder == last_folder && access_module.sameBytes(path[0..folder], index_module.pathOf(index, last_file)[0..folder])) {
            const folder_stamp = fileStamp(path[0..folder - 1])
            if folder_stamp > newest { newest = folder_stamp }
            last_folder = folder
            last_file = @intCast(u32, file)
        }
        file += 1
    }
    return newest
}

// Every few seconds: files changed on disk (Git, another editor). Tabs
// without edits read their file again; the map reads the code again (in
// the editor: when it is shown next).
pub fn watchDisk(codemap: *app.Codemap) -> void {
    if !codemap.*.built || codemap.*.demoActive { return }
    watchDiskTabs(codemap)
    var count: usize = 0
    const stamp = readDiskStamp(codemap, &count)
    if stamp == codemap.*.diskSeenStamp && count == codemap.*.diskSeenCount { return }
    codemap.*.diskSeenStamp = stamp
    codemap.*.diskSeenCount = count
    if codemap.*.view == app.VIEW_MAP && codemap.*.popup == app.POPUP_NONE && !codemap.*.pressed {
        navigation_module.reload(codemap)
        access_module.setNote(codemap, access_module.say(codemap, "Files changed: read again", "Dateien geändert: neu eingelesen"), "")
    } else {
        codemap.*.stale = true
    }
    access_module.panelOf(codemap).*.dirty = true
}

// Tabs without edits whose file changed read it again.
pub fn watchDiskTabs(codemap: *app.Codemap) -> void {
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = access_module.editorAt(codemap, tab)
        const stamp = fileStamp(editor_module.pathOf(editor))
        if stamp >= 0 && stamp != codemap.*.tabStamp[tab] && !editor_module.isDirty(editor) {
            var path: [1100]u8 = undefined
            var path_bytes: [*]u8 = undefined
            unsafe { path_bytes = @ptrCast([*]u8, &path) }
            const path_length = filters_module.writeText(path_bytes, 0, editor_module.pathOf(editor))
            const line = editor_module.lineOf(editor, editor.*.cursor)
            const top = editor.*.top
            if editor_module.load(editor, path_bytes[0..path_length]) {
                editor_module.moveTo(editor, editor_module.offsetAt(editor, if line < editor.*.lineCount { line } else { editor.*.lineCount - 1 }, 0), false)
                editor.*.top = if top < editor.*.lineCount { top } else { 0 }
                // The index is older than the text now.
                codemap.*.tabIndexed[tab] = 18446744073709551615
                codemap.*.tabFoldCount[tab] = 0
                computeMarks(codemap, tab)
                requestCheck(codemap, tab)
                if codemap.*.trace { navigation_module.traceLine(codemap, "tab read again ", tabRelative(codemap, tab)) }
            }
            codemap.*.tabStamp[tab] = stamp
            access_module.panelOf(codemap).*.dirty = true
        }
        tab += 1
    }
}

// A note of the newest crash in the status bar.
pub fn noteCrash(codemap: *app.Codemap) -> void {
    const crashes = access_module.crashesOf(codemap)
    if crashes.*.count == 0 { return }
    const record = @intCast(u32, crashes.*.count - 1)
    var text: [160]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeText(bytes, 0, crashes_module.field(crashes, record, 2))
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " crashed: ", " ist abgestürzt: "))
    const reason = crashes_module.field(crashes, record, 3)
    length = filters_module.writeText(bytes, length, if reason.length > 100 { reason[0..100] } else { reason })
    access_module.setNote(codemap, bytes[0..length], "")
}

// The first view: the whole, coming closer.
pub fn startView(codemap: *app.Codemap) -> void {
    const graph = access_module.graphOf(codemap)
    const camera = access_module.cameraOf(codemap)
    const root = graph.*.root
    codemap.*.focus = root
    camera.*.target = navigation_module.middleOf(codemap, root)
    camera.*.distance = navigation_module.extentOf(codemap, root) * 7.0
    camera.*.yaw = -0.9
    camera.*.pitch = 0.55
    navigation_module.flyTo(codemap, root)
    codemap.*.toYaw = -0.4
    codemap.*.toPitch = 0.3
    codemap.*.bump = 0.0
    codemap.*.flyDuration = 1400
}

// ---------------------------------------------------------------------------
// The editor: files open in tabs, what the code map knows on their lines

pub fn activeEditor(codemap: *app.Codemap) -> *editor_module.Editor { return access_module.editorAt(codemap, codemap.*.activeTab) }

pub fn hasTab(codemap: *app.Codemap) -> bool { return codemap.*.tabCount > 0 }

pub fn marksOf(codemap: *app.Codemap, tab: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, codemap.*.tabMarks[tab]) }
}

pub fn heatOf(codemap: *app.Codemap, tab: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, codemap.*.tabHeat[tab]) }
}

pub fn placesOfTab(codemap: *app.Codemap, tab: usize) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, codemap.*.tabPlaces[tab]) }
}

// Functions and types have a lens above them.
pub fn hasLens(index: *index_module.Index, symbol: u32) -> bool {
    const kind = index_module.symbolAt(index, symbol).*.kind
    return kind == index_module.FUNCTION || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET
}

pub fn spansOf(codemap: *app.Codemap, tab: usize) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, codemap.*.tabSpans[tab]) }
}

// Whether the index's offsets fit the tab's text (not edited since).
pub fn tabIndexedNow(codemap: *app.Codemap, tab: usize) -> bool {
    return codemap.*.tabFile[tab] != app.NONE && access_module.editorAt(codemap, tab).*.version == codemap.*.tabIndexed[tab]
}

// The file of `path` in the index (NONE: not there).
pub fn fileOfPath(codemap: *app.Codemap, path: []const u8) -> u32 {
    if !codemap.*.built { return app.NONE }
    return index_module.findFile(codemap.*.index, path)
}

// Shows `path` in the editor (a tab of its own; the oldest tab not edited
// gives way when all are taken), the cursor at `line` and `column` (from
// 1; 0: where it was).
pub fn openFile(codemap: *app.Codemap, path: []const u8, line: usize, column: usize) -> bool {
    var tab = codemap.*.tabCount
    var at: usize = 0
    while at < codemap.*.tabCount {
        if access_module.sameBytes(editor_module.pathOf(access_module.editorAt(codemap, at)), path) { tab = at }
        at += 1
    }
    if tab == codemap.*.tabCount {
        const added = codemap.*.tabCount < app.MAX_TABS
        if added {
            codemap.*.tabCount += 1
        } else {
            // The first tab not edited (the one shown last); none: the
            // edits stay, the file does not open.
            tab = app.MAX_TABS
            at = 0
            while at < codemap.*.tabCount {
                if !editor_module.isDirty(access_module.editorAt(codemap, at)) && at != codemap.*.activeTab {
                    tab = at
                    break
                }
                at += 1
            }
            if tab == app.MAX_TABS && !editor_module.isDirty(access_module.editorAt(codemap, codemap.*.activeTab)) { tab = codemap.*.activeTab }
            if tab == app.MAX_TABS {
                access_module.setNote(codemap, access_module.say(codemap, "All tabs have edits: save or close one first", "Alle Tabs haben Änderungen: erst einen speichern oder schließen"), "")
                return false
            }
        }
        const editor = access_module.editorAt(codemap, tab)
        if !editor_module.load(editor, path) {
            if added { codemap.*.tabCount -= 1 }
            access_module.setNote(codemap, access_module.say(codemap, "Cannot read ", "Kann nicht lesen: "), path)
            return false
        }
        if tab > 0 { editor_module.shareClipboard(editor, access_module.editorAt(codemap, 0)) }
        codemap.*.tabFile[tab] = fileOfPath(codemap, path)
        // The index's offsets fit the text read (not when the file changed
        // since the index read it).
        codemap.*.tabIndexed[tab] = if fileStamp(path) > codemap.*.diskStamp { 18446744073709551615 } else { 0 }
        codemap.*.tabChecked[tab] = 18446744073709551615
        codemap.*.tabStamp[tab] = fileStamp(path)
        codemap.*.tabFoldCount[tab] = 0
        computeMarks(codemap, tab)
        requestCheck(codemap, tab)
    }
    codemap.*.activeTab = tab
    codemap.*.view = app.VIEW_EDITOR
    const editor = access_module.editorAt(codemap, tab)
    if line > 0 {
        editor_module.moveTo(editor, editor_module.offsetAt(editor, line - 1, if column > 0 { column - 1 } else { 0 }), false)
        centerCursor(codemap)
    }
    if codemap.*.trace { navigation_module.traceLine(codemap, "editor open ", path) }
    access_module.panelOf(codemap).*.dirty = true
    return true
}

// Opens the file of a node, at its declaration.
pub fn openNode(codemap: *app.Codemap, node: u32) -> void {
    if node == app.NONE { return }
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return }
    openSymbol(codemap, record.*.symbol)
}

pub fn openSymbol(codemap: *app.Codemap, symbol: u32) -> void {
    if symbol == app.NONE { return }
    const index = codemap.*.index
    const record = index_module.symbolAt(index, symbol)
    const file = record.*.file
    var line: usize = 1
    var column: usize = 1
    if record.*.kind != index_module.FILE {
        const offset = @intCast(usize, record.*.nameStart)
        line = index_module.lineOf(index, file, offset) + 1
        column = index_module.columnOf(index, file, offset) + 1
    }
    const opened = openFile(codemap, index_module.pathOf(index, file), line, column)
}

pub fn closeTab(codemap: *app.Codemap, tab: usize) -> void {
    if tab >= codemap.*.tabCount { return }
    // The tab's parts move down (its buffers go to the end, for another).
    var at = tab
    while at + 1 < codemap.*.tabCount {
        swapTabs(codemap, at, at + 1)
        at += 1
    }
    codemap.*.tabCount -= 1
    access_module.editorAt(codemap, codemap.*.tabCount).*.open = false
    if codemap.*.activeTab >= codemap.*.tabCount && codemap.*.activeTab > 0 { codemap.*.activeTab -= 1 }
    if codemap.*.activeTab > tab { codemap.*.activeTab -= 1 }
    if codemap.*.tabCount == 0 { codemap.*.view = app.VIEW_MAP }
}

fn swapTabs(codemap: *app.Codemap, first: usize, second: usize) -> void {
    const size = @sizeOf(editor_module.Editor)
    var a: [*]u8 = undefined
    var b: [*]u8 = undefined
    unsafe {
        a = @ptrCast([*]u8, access_module.editorAt(codemap, first))
        b = @ptrCast([*]u8, access_module.editorAt(codemap, second))
    }
    var at: usize = 0
    while at < size {
        const byte = a[at]
        a[at] = b[at]
        b[at] = byte
        at += 1
    }
    const file = codemap.*.tabFile[first]
    codemap.*.tabFile[first] = codemap.*.tabFile[second]
    codemap.*.tabFile[second] = file
    const indexed = codemap.*.tabIndexed[first]
    codemap.*.tabIndexed[first] = codemap.*.tabIndexed[second]
    codemap.*.tabIndexed[second] = indexed
    const marks = codemap.*.tabMarks[first]
    codemap.*.tabMarks[first] = codemap.*.tabMarks[second]
    codemap.*.tabMarks[second] = marks
    const heat = codemap.*.tabHeat[first]
    codemap.*.tabHeat[first] = codemap.*.tabHeat[second]
    codemap.*.tabHeat[second] = heat
    const lines = codemap.*.tabMarkLines[first]
    codemap.*.tabMarkLines[first] = codemap.*.tabMarkLines[second]
    codemap.*.tabMarkLines[second] = lines
    const spans = codemap.*.tabSpans[first]
    codemap.*.tabSpans[first] = codemap.*.tabSpans[second]
    codemap.*.tabSpans[second] = spans
    const span_count = codemap.*.tabSpanCount[first]
    codemap.*.tabSpanCount[first] = codemap.*.tabSpanCount[second]
    codemap.*.tabSpanCount[second] = span_count
    const checked = codemap.*.tabChecked[first]
    codemap.*.tabChecked[first] = codemap.*.tabChecked[second]
    codemap.*.tabChecked[second] = checked
    const stamp = codemap.*.tabStamp[first]
    codemap.*.tabStamp[first] = codemap.*.tabStamp[second]
    codemap.*.tabStamp[second] = stamp
    const places = codemap.*.tabPlaces[first]
    codemap.*.tabPlaces[first] = codemap.*.tabPlaces[second]
    codemap.*.tabPlaces[second] = places
    const place_count = codemap.*.tabPlaceCount[first]
    codemap.*.tabPlaceCount[first] = codemap.*.tabPlaceCount[second]
    codemap.*.tabPlaceCount[second] = place_count
    const folds = codemap.*.tabFolds[first]
    codemap.*.tabFolds[first] = codemap.*.tabFolds[second]
    codemap.*.tabFolds[second] = folds
    const fold_count = codemap.*.tabFoldCount[first]
    codemap.*.tabFoldCount[first] = codemap.*.tabFoldCount[second]
    codemap.*.tabFoldCount[second] = fold_count
}

// Room for the marks of `lines` lines.
fn fitMarks(codemap: *app.Codemap, tab: usize, lines: usize) -> void {
    if codemap.*.tabMarks[tab] != 0 && codemap.*.tabMarkLines[tab] >= lines + 1 { return }
    const capacity = lines * 2 + 4096
    unsafe {
        codemap.*.tabMarks[tab] = @intFromPtr(codemap.*.allocator.alloc(capacity, 16).?)
        codemap.*.tabHeat[tab] = @intFromPtr(codemap.*.allocator.alloc(capacity, 16).?)
        if codemap.*.tabSpans[tab] == 0 { codemap.*.tabSpans[tab] = @intFromPtr(codemap.*.allocator.alloc(65536 * 16, 16).?) }
    }
    codemap.*.tabMarkLines[tab] = capacity
}

// The relative path of a tab's file.
pub fn tabRelative(codemap: *app.Codemap, tab: usize) -> []const u8 {
    const path = editor_module.pathOf(access_module.editorAt(codemap, tab))
    const root = access_module.rootText(codemap)
    if path.length > root.length + 1 && access_module.sameBytes(path[0..root.length], root) && path[root.length] == 47 { return path[root.length + 1..path.length] }
    return path
}

// What the code map knows on the lines of a tab: crashes, workarounds,
// changes since the base, the compiler's problems, heat, declarations.
pub fn computeMarks(codemap: *app.Codemap, tab: usize) -> void {
    const editor = access_module.editorAt(codemap, tab)
    const lines = editor.*.lineCount
    fitMarks(codemap, tab, lines)
    const marks = marksOf(codemap, tab)
    const heat = heatOf(codemap, tab)
    var line: usize = 0
    while line < codemap.*.tabMarkLines[tab] {
        marks[line] = 0
        heat[line] = 0
        line += 1
    }
    codemap.*.tabSpanCount[tab] = 0
    const file = codemap.*.tabFile[tab]
    if file != app.NONE && codemap.*.built {
        const index = codemap.*.index
        // Workarounds (and each place's line, for its hint).
        const workarounds = access_module.workaroundsOf(codemap)
        if codemap.*.tabPlaces[tab] == 0 { codemap.*.tabPlaces[tab] = @intFromPtr(codemap.*.allocator.alloc(4096 * 8, 16).?) }
        const places = placesOfTab(codemap, tab)
        codemap.*.tabPlaceCount[tab] = 0
        var place: usize = 0
        while place < workarounds.*.count {
            if workarounds.*.file[place] == file {
                const at = index_module.lineOf(index, file, @intCast(usize, workarounds.*.offset[place]))
                if at < lines { marks[at] = marks[at] | app.MARK_WORKAROUND }
                if codemap.*.tabPlaceCount[tab] < 4096 {
                    places[codemap.*.tabPlaceCount[tab] * 2] = @intCast(u32, at)
                    places[codemap.*.tabPlaceCount[tab] * 2 + 1] = @intCast(u32, place)
                    codemap.*.tabPlaceCount[tab] += 1
                }
            }
            place += 1
        }
        // Declarations, and how hot the functions are.
        const spans = spansOf(codemap, tab)
        const profiles = access_module.profilesOf(codemap)
        var hottest: u32 = 1
        var symbol: usize = 0
        while symbol < index.*.symbolCount {
            const id = @intCast(u32, symbol)
            const record = index_module.symbolAt(index, id)
            if record.*.file == file && query_module.isDeclaration(record.*.kind) && record.*.kind != index_module.FIELD && record.*.kind != index_module.MEMBER && codemap.*.tabSpanCount[tab] < 65536 {
                const count = codemap.*.tabSpanCount[tab]
                spans[count * 4] = @intCast(u32, index_module.lineOf(index, file, index_module.declarationOffset(index, id)))
                spans[count * 4 + 1] = @intCast(u32, index_module.lineOf(index, file, index_module.declarationEnd(index, id)))
                spans[count * 4 + 2] = @intCast(u32, index_module.lineOf(index, file, @intCast(usize, record.*.nameStart)))
                spans[count * 4 + 3] = id
                codemap.*.tabSpanCount[tab] = count + 1
                if access_module.measured(codemap, id) && profiles_module.totalOf(profiles, id) > hottest { hottest = profiles_module.totalOf(profiles, id) }
            }
            symbol += 1
        }
        var span: usize = 0
        while span < codemap.*.tabSpanCount[tab] {
            // A lens above functions and types.
            const first_line = @intCast(usize, spans[span * 4])
            if hasLens(index, spans[span * 4 + 3]) && first_line < lines { marks[first_line] = marks[first_line] | app.MARK_LENS }
            const total = if access_module.measured(codemap, spans[span * 4 + 3]) { profiles_module.totalOf(profiles, spans[span * 4 + 3]) } else { 0 }
            if total > 0 {
                const value = @intCast(u8, 40 + total * 215 / hottest)
                var at = @intCast(usize, spans[span * 4])
                while at <= @intCast(usize, spans[span * 4 + 1]) && at < lines {
                    if value > heat[at] { heat[at] = value }
                    at += 1
                }
            }
            span += 1
        }
    }
    // Crashes: the lines their frames name ("... at path:line").
    const crashes = access_module.crashesOf(codemap)
    const relative = tabRelative(codemap, tab)
    var frame: usize = 0
    while frame < crashes.*.frameCount {
        const where = crashes_module.frameWhere(crashes_module.frameText(crashes, frame))
        var colon = where.length
        while colon > 0 && where[colon - 1] != 58 { colon -= 1 }
        if colon > 1 && access_module.sameBytes(where[0..colon - 1], relative) {
            var number: usize = 0
            for byte in where[colon..where.length] {
                if byte >= 48 && byte <= 57 { number = number * 10 + @intCast(usize, byte - 48) }
            }
            if number > 0 && number <= lines { marks[number - 1] = marks[number - 1] | app.MARK_CRASH }
        }
        frame += 1
    }
    markChanges(codemap, tab)
    markProblems(codemap, tab)
}

// Lines changed since the base of Changed (git diff -U0).
fn markChanges(codemap: *app.Codemap, tab: usize) -> void {
    const git = access_module.gitOf(codemap)
    if !git_module.usable(git) { return }
    const editor = access_module.editorAt(codemap, tab)
    const marks = marksOf(codemap, tab)
    var base_bytes: [*]u8 = undefined
    unsafe { base_bytes = @ptrCast([*]u8, &codemap.*.diffBase) }
    git_module.begin(git)
    git_module.more(git, "diff -U0 ")
    git_module.addQuoted(git, if codemap.*.diffBaseLength > 0 { base_bytes[0..codemap.*.diffBaseLength] } else { "HEAD" })
    git_module.more(git, " -- ")
    git_module.addQuoted(git, editor_module.pathOf(editor))
    const text = git_module.finish(git)
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        // "@@ -a,b +c,d @@"
        if end - at > 4 && text[at] == 64 && text[at + 1] == 64 {
            var cursor = at + 3
            while cursor < end && text[cursor] != 43 { cursor += 1 }
            var removed_count: usize = 1
            var scan = at + 3
            while scan < cursor && text[scan] != 44 { scan += 1 }
            if scan < cursor { removed_count = parseDigits(text, scan + 1) }
            cursor += 1
            const first = parseDigits(text, cursor)
            while cursor < end && text[cursor] >= 48 && text[cursor] <= 57 { cursor += 1 }
            var count: usize = 1
            if cursor < end && text[cursor] == 44 { count = parseDigits(text, cursor + 1) }
            if count == 0 {
                if first < editor.*.lineCount { marks[first] = marks[first] | app.MARK_REMOVED }
            } else {
                var line = first
                while line < first + count && line <= editor.*.lineCount {
                    if line > 0 { marks[line - 1] = marks[line - 1] | (if removed_count == 0 { app.MARK_ADDED } else { app.MARK_CHANGED }) }
                    line += 1
                }
            }
        }
        at = end + 1
    }
}

pub fn parseDigits(text: []const u8, start: usize) -> usize {
    var value: usize = 0
    var at = start
    while at < text.length && text[at] >= 48 && text[at] <= 57 {
        value = value * 10 + @intCast(usize, text[at] - 48)
        at += 1
    }
    return value
}

// The compiler's problems of the tab's file (the last check).
fn markProblems(codemap: *app.Codemap, tab: usize) -> void {
    var source: usize = 0
    while source < 2 {
        markProblemsFrom(codemap, tab, access_module.problemsOf(codemap, source))
        source += 1
    }
}

fn markProblemsFrom(codemap: *app.Codemap, tab: usize, check: *check_module.Check) -> void {
    const marks = marksOf(codemap, tab)
    const editor = access_module.editorAt(codemap, tab)
    const path = editor_module.pathOf(editor)
    var at: usize = 0
    while at < check.*.count {
        const diagnostic = check_module.diagnosticAt(check, at)
        const where = check_module.outputText(check)[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength]
        if diagnosticInFile(codemap, where, path) && diagnostic.*.line > 0 && diagnostic.*.line <= editor.*.lineCount {
            marks[diagnostic.*.line - 1] = marks[diagnostic.*.line - 1] | (if diagnostic.*.isError { app.MARK_ERROR } else { app.MARK_WARNING })
        }
        at += 1
    }
}

// Whether a diagnostic's path (as the compiler wrote it: absolute, or
// relative to the root) is `path`.
pub fn diagnosticInFile(codemap: *app.Codemap, where: []const u8, path: []const u8) -> bool {
    if access_module.sameBytes(where, path) { return true }
    const root = access_module.rootText(codemap)
    return path.length == root.length + 1 + where.length && access_module.sameBytes(path[0..root.length], root) && access_module.sameBytes(path[root.length + 1..path.length], where)
}

// After an edit: the marks and declarations below the edited line move
// with the lines added or taken out.
pub fn shiftMarks(codemap: *app.Codemap, tab: usize, line: usize, before: usize) -> void {
    const editor = access_module.editorAt(codemap, tab)
    const now = editor.*.lineCount
    if now == before { return }
    assist_module.shiftFolds(codemap, tab, line, before, now)
    fitMarks(codemap, tab, now + 4096)
    const marks = marksOf(codemap, tab)
    const heat = heatOf(codemap, tab)
    if now > before {
        const grow = now - before
        var at = now
        while at > line + grow {
            at -= 1
            marks[at] = marks[at - grow]
            heat[at] = heat[at - grow]
        }
        at = line + 1
        while at <= line + grow && at < now {
            marks[at] = app.MARK_ADDED
            heat[at] = heat[line]
            at += 1
        }
    } else {
        const shrink = before - now
        var at = line + 1
        while at + shrink < before {
            marks[at] = marks[at + shrink]
            heat[at] = heat[at + shrink]
            at += 1
        }
    }
    const spans = spansOf(codemap, tab)
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        var part: usize = 0
        while part < 3 {
            const value = @intCast(usize, spans[span * 4 + part])
            if value > line {
                if now > before { spans[span * 4 + part] = @intCast(u32, value + (now - before)) } else if value >= before - now + line { spans[span * 4 + part] = @intCast(u32, value - (before - now)) } else { spans[span * 4 + part] = @intCast(u32, line) }
            }
            part += 1
        }
        span += 1
    }
    // The workaround places' lines move the same way.
    const places = placesOfTab(codemap, tab)
    var place: usize = 0
    while place < codemap.*.tabPlaceCount[tab] {
        const value = @intCast(usize, places[place * 2])
        if value > line {
            if now > before { places[place * 2] = @intCast(u32, value + (now - before)) } else if value >= before - now + line { places[place * 2] = @intCast(u32, value - (before - now)) } else { places[place * 2] = @intCast(u32, line) }
        }
        place += 1
    }
    if marks[line] & (app.MARK_ADDED | app.MARK_CHANGED) == 0 { marks[line] = marks[line] | app.MARK_CHANGED }
}

// The innermost declaration on `line` of a tab (NONE: none).
pub fn declarationOnLine(codemap: *app.Codemap, tab: usize, line: usize) -> u32 {
    const spans = spansOf(codemap, tab)
    var best = app.NONE
    var best_size: usize = 18446744073709551615
    var span: usize = 0
    while span < codemap.*.tabSpanCount[tab] {
        const first = @intCast(usize, spans[span * 4])
        const last = @intCast(usize, spans[span * 4 + 1])
        if first <= line && line <= last && last - first < best_size {
            best = spans[span * 4 + 3]
            best_size = last - first
        }
        span += 1
    }
    return best
}

// The declaration a name at `offset` of the tab shown means: from the
// index when the text is as it read it, else by the name (in this file
// first).
pub fn symbolAtCursor(codemap: *app.Codemap, offset: usize) -> u32 {
    if !hasTab(codemap) || !codemap.*.built { return app.NONE }
    const tab = codemap.*.activeTab
    const editor = activeEditor(codemap)
    const index = codemap.*.index
    const file = codemap.*.tabFile[tab]
    if tabIndexedNow(codemap, tab) {
        const ref = index_module.refAtOffset(index, file, offset)
        if ref != index_module.MAX_REFS { return index_module.refAt(index, ref).*.symbol }
    }
    var start: usize = 0
    var end: usize = 0
    editor_module.wordAt(editor, offset, &start, &end)
    if end <= start { return app.NONE }
    const word = editor.*.text[start..end]
    var found = app.NONE
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        if query_module.isDeclaration(record.*.kind) && access_module.sameBytes(index_module.nameOf(index, id), word) {
            if record.*.file == file { return id }
            if found == app.NONE { found = id }
        }
        symbol += 1
    }
    return found
}

// F12, Ctrl+click: the declaration of the name at the cursor.
pub fn goToDefinition(codemap: *app.Codemap, offset: usize) -> void {
    const symbol = symbolAtCursor(codemap, offset)
    if symbol == app.NONE {
        access_module.setNote(codemap, access_module.say(codemap, "No declaration found here", "Hier keine Deklaration gefunden"), "")
        return
    }
    const node = access_module.nodeOfSymbol(codemap, symbol)
    if node != app.NONE { navigation_module.select(codemap, node) }
    openSymbol(codemap, symbol)
    if codemap.*.trace { navigation_module.traceLine(codemap, "definition ", index_module.nameOf(codemap.*.index, symbol)) }
}

// The cursor moved: what it is in becomes the selection (the panel shows
// it), without flying.
pub fn followCursor(codemap: *app.Codemap) -> void {
    if !hasTab(codemap) || !codemap.*.built { return }
    const editor = activeEditor(codemap)
    const symbol = declarationOnLine(codemap, codemap.*.activeTab, editor_module.lineOf(editor, editor.*.cursor))
    const node = if symbol != app.NONE { access_module.nodeOfSymbol(codemap, symbol) } else { app.NONE }
    if node != app.NONE && node != codemap.*.selected { navigation_module.setSelected(codemap, node) }
}

// Scrolls so the cursor is seen (the middle when it was far).
fn centerCursor(codemap: *app.Codemap) -> void {
    const editor = activeEditor(codemap)
    const tab = codemap.*.activeTab
    const line = editor_module.lineOf(editor, editor.*.cursor)
    // Up from the cursor's line while the rows above fill half the view.
    const half = (editor_view_module.editorBottom(codemap) - editor_view_module.editorCodeTop()) / 2
    var top = line
    var height: i32 = app.EDITOR_LINE + (if editor_view_module.hasLensRow(codemap, tab, line) { app.EDITOR_LINE } else { 0 })
    while top > 0 {
        const up = assist_module.shownLine(codemap, tab, top - 1)
        const above = app.EDITOR_LINE + (if editor_view_module.hasLensRow(codemap, tab, up) { app.EDITOR_LINE } else { 0 })
        if height + above > half { break }
        height += above
        top = up
    }
    editor.*.top = top
}

pub fn keepCursorSeen(codemap: *app.Codemap) -> void {
    const editor = activeEditor(codemap)
    const tab = codemap.*.activeTab
    const line = editor_module.lineOf(editor, editor.*.cursor)
    if line < editor.*.top { editor.*.top = line }
    if line == editor.*.top && editor_view_module.hasLensRow(codemap, tab, line) { return }
    const bottom = editor_view_module.editorBottom(codemap)
    while editor.*.top < line && editor_view_module.lineY(codemap, tab, line) + 2 * app.EDITOR_LINE > bottom { editor.*.top = assist_module.nextShown(codemap, tab, editor.*.top) }
}

// Checks a tab's file with the compiler in the background.
fn requestCheck(codemap: *app.Codemap, tab: usize) -> void {
    const editor = access_module.editorAt(codemap, tab)
    const path = editor_module.pathOf(editor)
    if path.length < 4 || !access_module.sameBytes(path[path.length - 4..path.length], ".mlx") { return }
    check_module.request(access_module.checkOf(codemap), path, panel_module.milliseconds())
    codemap.*.tabChecked[tab] = editor.*.version
}

// Reads what the check wrote so far (without waiting); when it is done,
// the problems go on the lines.
pub fn pumpCheck(codemap: *app.Codemap) -> void {
    if pumpOne(access_module.buildOf(codemap)) { project_module.finishBuild(codemap) }
    const check = access_module.checkOf(codemap)
    if !check.*.running {
        const started = check_module.next(check, panel_module.milliseconds())
        return
    }
    if pumpOne(check) { finishCheck(codemap) }
}

// Reads what a compiler run wrote so far (without waiting); true when it
// is done.
fn pumpOne(check: *check_module.Check) -> bool {
    if !check.*.running { return false }
    var descriptor: [2]i32 = [2]i32{ @intCast(i32, check.*.pipe), 1 }
    var ready: isize = 0
    unsafe { ready = std.linux.syscall3(7, @intFromPtr(&descriptor), 1, 0) }
    var rounds: usize = 0
    while ready > 0 && rounds < 16 {
        if check_module.pump(check) { return true }
        unsafe { ready = std.linux.syscall3(7, @intFromPtr(&descriptor), 1, 0) }
        rounds += 1
    }
    return check_module.stopIfStuck(check, panel_module.milliseconds())
}

fn finishCheck(codemap: *app.Codemap) -> void {
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        computeMarks(codemap, tab)
        tab += 1
    }
    filters_module.refreshFindings(codemap)
    if codemap.*.trace {
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        const length = lists_module.writeNumberPlain(bytes, 0, access_module.checkOf(codemap).*.count)
        navigation_module.traceLine(codemap, "checked, problems ", bytes[0..length])

    }
    access_module.panelOf(codemap).*.dirty = true
}

// Writes the tab shown; the compiler checks it, and the index is older
// than the file now (switching to the map reads it again).
pub fn saveTab(codemap: *app.Codemap) -> void {
    if !hasTab(codemap) { return }
    const editor = activeEditor(codemap)
    if !editor_module.save(editor) {
        access_module.setNote(codemap, access_module.say(codemap, "Cannot write ", "Kann nicht schreiben: "), editor_module.pathOf(editor))
        return
    }
    codemap.*.stale = true
    codemap.*.tabStamp[codemap.*.activeTab] = fileStamp(editor_module.pathOf(editor))
    requestCheck(codemap, codemap.*.activeTab)
    project_module.refreshChanges(codemap)
    access_module.setNote(codemap, access_module.say(codemap, "Saved ", "Gespeichert: "), tabRelative(codemap, codemap.*.activeTab))
    if codemap.*.trace { navigation_module.traceLine(codemap, "saved ", tabRelative(codemap, codemap.*.activeTab)) }
}
