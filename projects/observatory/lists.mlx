// The lists under the toolbar's buttons, and opening in the editor (part of main.mlx, split from it).
const std = @import("std")
const apps_module = @import("../desktop/shared/apps.mlx")
const canvas_module = @import("std.ui.canvas")
const glyphs = @import("std.ui.glyphs")
const text_module = @import("std.ui.text")
const index_module = @import("../../tools/codemap/index.mlx")
const git_module = @import("../../tools/codemap/git.mlx")
const views_module = @import("../../tools/codemap/views.mlx")
const run_module = @import("./run.mlx")
const graph_module = @import("./graph.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const input_module = @import("./input.mlx")
const drawing_module = @import("./drawing.mlx")
const detail_module = @import("./detail.mlx")
const tabs_module = @import("./tabs.mlx")
const project_module = @import("./project.mlx")
const actions_module = @import("./actions.mlx")

// ---------------------------------------------------------------------------
// The lists under the toolbar's buttons

pub fn openPopup(codemap: *app.Codemap, popup: u8) -> void {
    if !codemap.*.built { return }
    codemap.*.searchFocused = false
    codemap.*.popup = popup
    codemap.*.popupRowTop = app.TOOLBAR + 2
    if popup == app.POPUP_BASE {
        // The history: the commit of what changed, then the bases.
        project_module.refreshChanges(codemap)
        loadBases(codemap)
        project_module.loadBranches(codemap)
        codemap.*.branchesOpen = false
        codemap.*.branchNaming = false
        codemap.*.popupWidth = 540
        codemap.*.popupX = input_module.baseX(codemap) + input_module.baseWidth(codemap) - codemap.*.popupWidth
        if codemap.*.popupX < app.SIDEBAR + 8 { codemap.*.popupX = app.SIDEBAR + 8 }
        codemap.*.popupRows = historyRows(codemap)
        codemap.*.popupRowTop = app.TOOLBAR - 4 + project_module.BRANCH_BAR + project_module.commitSectionHeight(codemap) + 26
    } else if popup == app.POPUP_RUN {
        codemap.*.popupWidth = 520
        codemap.*.popupX = project_module.buildX(codemap) + project_module.buildWidth(codemap) - codemap.*.popupWidth
        codemap.*.popupRows = actions_module.runRows(codemap)
    } else {
        codemap.*.popupWidth = 330
        codemap.*.popupX = input_module.filterX(codemap) + input_module.filterWidth(codemap) - codemap.*.popupWidth
        codemap.*.popupRows = filterRows(codemap)
    }
    if codemap.*.popupX + codemap.*.popupWidth > access_module.surfaceWidth(codemap) - 8 { codemap.*.popupX = access_module.surfaceWidth(codemap) - 8 - codemap.*.popupWidth }
}

// The last commits (the bases to choose from).
fn loadBases(codemap: *app.Codemap) -> void {
    codemap.*.baseCount = 0
    codemap.*.baseLogLength = 0
    const git = access_module.gitOf(codemap)
    if !git_module.usable(git) { return }
    // As a graph: the local and remote branches' last commits, their
    // lanes (git's * | / \ _), hash, refs and subject.
    const text = git_module.run(git, "log --graph --branches --remotes --format='%x09%h%x09%D%x09%s' -n 30")
    var commits: usize = 0
    var at: usize = 0
    while at < text.length && codemap.*.baseCount < 44 {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..(if end - at > 300 { at + 300 } else { end })]
        if project_module.graphPart(line, 1).length > 0 { commits += 1 }
        if codemap.*.baseLogLength + line.length < 16384 {
            codemap.*.baseStart[codemap.*.baseCount] = codemap.*.baseLogLength
            for byte in line {
                codemap.*.baseLog[codemap.*.baseLogLength] = byte
                codemap.*.baseLogLength += 1
            }
            codemap.*.baseEnd[codemap.*.baseCount] = codemap.*.baseLogLength
            codemap.*.baseCount += 1
        }
        at = end + 1
    }
    if codemap.*.trace {
        var number: [32]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &number) }
        const length = writeNumberPlain(bytes, 0, commits)
        navigation_module.traceLine(codemap, "history graph, commits ", bytes[0..length])
    }
}

// The history's rows: the branches (and a new one's name), else HEAD and
// the graph; as many as fit under the window's bottom.
fn historyRows(codemap: *app.Codemap) -> usize {
    const wanted = if codemap.*.branchesOpen { codemap.*.branchCount + (if codemap.*.branchNaming { 1 } else { 0 }) } else { 1 + codemap.*.baseCount }
    const room = (access_module.surfaceHeight(codemap) - (app.TOOLBAR - 4 + project_module.BRANCH_BAR + project_module.commitSectionHeight(codemap) + 26) - 16) / app.POPUP_ROW
    const most: usize = if room > 1 { @intCast(usize, room) } else { 1 }
    return if wanted < most { wanted } else { most }
}

fn baseLine(codemap: *app.Codemap, row: usize) -> []const u8 {
    return access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "baseLog"))[codemap.*.baseStart[row]..codemap.*.baseEnd[row]]
}

// Compares with a new base: Changed (opened) and the query follow.
pub fn chooseBase(codemap: *app.Codemap, base: []const u8) -> void {
    codemap.*.diffBaseLength = app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "diffBase")), 0, base, 128)
    access_module.runDiff(codemap)
    codemap.*.findingOn[@intCast(usize, app.FINDING_CHANGED)] = true
    navigation_module.select(codemap, app.NONE)
    filters_module.refreshVisibility(codemap)
    access_module.openFinding(codemap, app.FINDING_CHANGED)
}

// The query builder's rows: first what fits the selection (in its
// group, calls it, called by it, uses it), then the words.
fn filterRows(codemap: *app.Codemap) -> usize { return contextRows(codemap) + app.FILTER_TERMS }

fn contextRows(codemap: *app.Codemap) -> usize {
    const node = codemap.*.selected
    if node == app.NONE { return 0 }
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind == graph_module.DECLARATION { return 4 }
    return if node == access_module.graphOf(codemap).*.root { 0 } else { 1 }
}

// The path of a group or file (relative, a directory's with a / after).
fn groupPath(codemap: *app.Codemap, node: u32, into: [*]u8) -> usize {
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind != graph_module.DIRECTORY { return filters_module.writeText(into, 0, graph_module.pathOf(access_module.graphOf(codemap), node)) }
    var key: [1024]u8 = undefined
    var key_bytes: [*]u8 = undefined
    unsafe { key_bytes = @ptrCast([*]u8, &key) }
    const length = navigation_module.keyOf(codemap, node, key_bytes)
    // Without the root's name.
    var start: usize = 0
    while start < length && key_bytes[start] != 47 { start += 1 }
    return filters_module.writeText(into, 0, key_bytes[(if start < length { start + 1 } else { length })..length])
}

// The word of a row (into `into`) and what it means (into `about`).
fn filterRow(codemap: *app.Codemap, row: usize, into: [*]u8, about: [*]u8) -> usize {
    const context = contextRows(codemap)
    var length: usize = 0
    var about_length: usize = 0
    if row < context {
        const node = codemap.*.selected
        const record = access_module.nodeOf(codemap, node)
        if record.*.kind != graph_module.DECLARATION {
            length = filters_module.writeText(into, 0, "in:")
            var path: [1024]u8 = undefined
            var path_bytes: [*]u8 = undefined
            unsafe { path_bytes = @ptrCast([*]u8, &path) }
            const path_length = groupPath(codemap, node, path_bytes)
            length = filters_module.writeText(into, length, path_bytes[0..path_length])
            about_length = filters_module.writeText(about, 0, access_module.say(codemap, "In what is selected", "Im Gewählten"))
        } else {
            const name = access_module.nameOf(codemap, node)
            const keys = [4][]const u8{ "calls:", "by:", "uses:", "name:" }
            length = filters_module.writeText(into, 0, keys[row])
            length = filters_module.writeText(into, length, name)
            if row == 0 { about_length = filters_module.writeText(about, 0, access_module.say(codemap, "Calls it", "Ruft es auf")) }
            if row == 1 { about_length = filters_module.writeText(about, 0, access_module.say(codemap, "Called by it", "Wird von ihm aufgerufen")) }
            if row == 2 { about_length = filters_module.writeText(about, 0, access_module.say(codemap, "Uses it", "Verwendet es")) }
            if row == 3 { about_length = filters_module.writeText(about, 0, access_module.say(codemap, "Named like it", "Heißt so ähnlich")) }
        }
    } else {
        const term = row - context
        const words = [13][]const u8{ "kind:fn", "kind:struct", "crashed", "workaround", "changed", "added", "untested", "unreachable", "complex", "risky", "hot", "unused", "copy" }
        length = filters_module.writeText(into, 0, words[term])
        const english = [13][]const u8{ "Functions", "Structs", "Crashed", "With a workaround", "Changed since the base", "Added since the base", "Untested", "Unreachable", "Complex", "Risky", "Hot (profiles)", "Unused", "A copy" }
        const german = [13][]const u8{ "Funktionen", "Structs", "Abgestürzt", "Mit Workaround", "Geändert seit der Basis", "Neu seit der Basis", "Ungetestet", "Unerreichbar", "Komplex", "Riskant", "Heiß (Profile)", "Ungenutzt", "Eine Kopie" }
        about_length = filters_module.writeText(about, 0, if codemap.*.german { german[term] } else { english[term] })
    }
    about[about_length] = 0
    return length
}

pub fn choosePopupRow(codemap: *app.Codemap, row: usize) -> void {
    const popup = codemap.*.popup
    codemap.*.popup = app.POPUP_NONE
    if popup == app.POPUP_BASE && codemap.*.branchesOpen {
        // A branch: switched to (the name's field: stays open).
        const first: usize = if codemap.*.branchNaming { 1 } else { 0 }
        if row < first {
            codemap.*.popup = app.POPUP_BASE
            return
        }
        if row - first < codemap.*.branchCount {
            var name: [128]u8 = undefined
            var name_bytes: [*]u8 = undefined
            unsafe { name_bytes = @ptrCast([*]u8, &name) }
            const length = filters_module.writeText(name_bytes, 0, project_module.branchAt(codemap, row - first))
            project_module.switchBranch(codemap, name_bytes[0..length], false)
        }
        return
    }
    if popup == app.POPUP_BASE {
        if row == 0 {
            chooseBase(codemap, "HEAD")
        } else if row - 1 < codemap.*.baseCount {
            const hash = project_module.graphPart(baseLine(codemap, row - 1), 1)
            if hash.length > 0 {
                chooseBase(codemap, hash)
            } else {
                // A line of the graph only: the list stays.
                codemap.*.popup = app.POPUP_BASE
            }
        }
        return
    }
    if popup == app.POPUP_RUN {
        if row == 0 {
            actions_module.startAction(codemap, app.ACTION_BUILD)
        } else if row == 1 {
            if actions_module.runOf(codemap).*.running { run_module.stop(actions_module.runOf(codemap)) } else { actions_module.startAction(codemap, app.ACTION_RUN) }
        } else if row == 2 {
            actions_module.startAction(codemap, app.ACTION_PROFILE)
        } else {
            // The output: the list stays.
            codemap.*.popup = app.POPUP_RUN
        }
        return
    }
    if popup != app.POPUP_FILTER || row >= filterRows(codemap) { return }
    var word: [1100]u8 = undefined
    var about: [256]u8 = undefined
    var word_bytes: [*]u8 = undefined
    var about_bytes: [*]u8 = undefined
    unsafe {
        word_bytes = @ptrCast([*]u8, &word)
        about_bytes = @ptrCast([*]u8, &about)
    }
    const length = filterRow(codemap, row, word_bytes, about_bytes)
    if codemap.*.trace { navigation_module.traceLine(codemap, "filter word ", word_bytes[0..length]) }
    // Added to what the search holds (a plain name there is replaced).
    const text = access_module.searchText(codemap)
    var joined: [512]u8 = undefined
    var joined_bytes: [*]u8 = undefined
    unsafe { joined_bytes = @ptrCast([*]u8, &joined) }
    var joined_length: usize = 0
    if navigation_module.searchQuery(codemap).length > 0 && !(text.length > 0 && text[0] == 64) {
        joined_length = filters_module.writeText(joined_bytes, 0, text)
        if joined_length > 0 && joined_bytes[joined_length - 1] != 32 { joined_length = filters_module.writeText(joined_bytes, joined_length, " ") }
    }
    if joined_length + length < 256 { joined_length = filters_module.writeText(joined_bytes, joined_length, word_bytes[0..length]) }
    navigation_module.setSearch(codemap, joined_bytes[0..joined_length])
    codemap.*.searchFocused = true
}

pub fn drawPopup(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    if codemap.*.popup == app.POPUP_NONE { return }
    const slide = drawing_module.fadeIn(codemap, canvas, app.OVERLAY_POPUP, @intCast(u64, codemap.*.popup))
    const x = codemap.*.popupX
    const width = codemap.*.popupWidth
    const top = app.TOOLBAR - 4 - slide
    if codemap.*.popup == app.POPUP_BASE { codemap.*.popupRows = historyRows(codemap) }
    if codemap.*.popup == app.POPUP_RUN { codemap.*.popupRows = actions_module.runRows(codemap) }
    const rows = @intCast(i32, codemap.*.popupRows)
    const footer: i32 = if codemap.*.popup == app.POPUP_FILTER { 40 } else { 0 }
    // The history: the branch, the commit, then "Compare with" and the
    // graph (or the branches).
    const head: i32 = if codemap.*.popup == app.POPUP_BASE { project_module.BRANCH_BAR + project_module.commitSectionHeight(codemap) + 26 } else { 6 }
    codemap.*.popupRowTop = top + head
    if codemap.*.popup == app.POPUP_BASE { codemap.*.popupRows = historyRows(codemap) }
    const height = head + rows * app.POPUP_ROW + 6 + footer
    canvas_module.fillRoundedRect(canvas, x + 2, top + 4, width, height, 10, canvas_module.color(90, 0, 0, 0))
    canvas_module.fillRoundedRect(canvas, x, top, width, height, 10, canvas_module.color(250, 32, 34, 43))
    canvas_module.strokeRoundedRect(canvas, x, top, width, height, 10, 1, canvas_module.color(255, 58, 62, 76))
    if codemap.*.popup == app.POPUP_BASE {
        project_module.drawBranchBar(codemap, canvas, x, top, width)
        project_module.drawCommitSection(codemap, canvas, x, top + project_module.BRANCH_BAR, width)
        const heading_y = top + head - 22
        canvas_module.fillRect(canvas, x + 12, heading_y - 6, width - 24, 1, canvas_module.color(255, 58, 62, 76))
        text_module.drawText(canvas, access_module.smallOf(codemap), if codemap.*.branchesOpen { access_module.say(codemap, "Branches (a click switches to one)", "Branches (ein Klick wechselt)") } else { access_module.say(codemap, "The graph; Changed compares with the one clicked", "Der Graph; Geändert vergleicht mit dem angeklickten") }, x + 16, heading_y, app.DIM_COLOR, width - 32)
    }
    // The graph's width: its widest row.
    var graph_width: i32 = 0
    if codemap.*.popup == app.POPUP_BASE && !codemap.*.branchesOpen {
        var line_at: usize = 0
        while line_at < codemap.*.baseCount {
            const graph = project_module.graphPart(baseLine(codemap, line_at), 0)
            if @intCast(i32, graph.length) * 7 > graph_width { graph_width = @intCast(i32, graph.length) * 7 }
            line_at += 1
        }
    }
    var word: [1100]u8 = undefined
    var about: [256]u8 = undefined
    var word_bytes: [*]u8 = undefined
    var about_bytes: [*]u8 = undefined
    unsafe {
        word_bytes = @ptrCast([*]u8, &word)
        about_bytes = @ptrCast([*]u8, &about)
    }
    if codemap.*.popup == app.POPUP_RUN {
        actions_module.drawRunRows(codemap, canvas, x, width)
        return
    }
    var row: usize = 0
    while row < codemap.*.popupRows {
        const y = codemap.*.popupRowTop + @intCast(i32, row) * app.POPUP_ROW
        if codemap.*.hover == app.HIT_POPUP_ROW + row { canvas_module.fillRoundedRect(canvas, x + 6, y, width - 12, app.POPUP_ROW, 7, canvas_module.color(255, 52, 78, 130)) }
        if codemap.*.popup == app.POPUP_BASE && codemap.*.branchesOpen {
            const first: usize = if codemap.*.branchNaming { 1 } else { 0 }
            if row < first {
                // The new branch's name.
                canvas_module.fillRoundedRect(canvas, x + 12, y + 1, width - 24, app.POPUP_ROW - 2, 6, canvas_module.color(255, 22, 24, 30))
                canvas_module.strokeRoundedRect(canvas, x + 11, y, width - 22, app.POPUP_ROW, 7, 2, app.ACCENT)
                const name = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "branchText"))[0..codemap.*.branchTextLength]
                text_module.drawText(canvas, access_module.bodyOf(codemap), if name.length > 0 { name } else { access_module.say(codemap, "new branch name (Enter)", "Name des neuen Branches (Enter)") }, x + 22, y + 4, if name.length > 0 { app.TEXT_COLOR } else { app.DIM_COLOR }, width - 44)
                if name.length > 0 { canvas_module.fillRect(canvas, x + 23 + text_module.measure(access_module.bodyOf(codemap), name), y + 5, 2, 16, app.ACCENT) }
            } else if row - first < codemap.*.branchCount {
                const name = project_module.branchAt(codemap, row - first)
                const current = access_module.sameBytes(name, project_module.branchName(codemap))
                project_module.drawBranchGlyph(canvas, x + 18, y + 6, if current { filters_module.canvasColor(app.CHANGED_COLOR, 255) } else { app.DIM_COLOR })
                text_module.drawText(canvas, access_module.bodyOf(codemap), name, x + 36, y + 4, if current { app.TEXT_COLOR } else { filters_module.canvasColor(app.TEXT_COLOR, 210) }, width - 150)
                if current { text_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "checked out", "ausgecheckt"), x + width - 100, y + 6, filters_module.canvasColor(app.CHANGED_COLOR, 255), 90) }
            }
        } else if codemap.*.popup == app.POPUP_BASE {
            if row == 0 {
                glyphs.dot(canvas, x + 16, y + 9, 8, filters_module.canvasColor(app.CHANGED_COLOR, 255))
                text_module.drawText(canvas, access_module.bodyOf(codemap), access_module.say(codemap, "Not committed yet (HEAD)", "Noch nicht committet (HEAD)"), x + 32, y + 5, app.TEXT_COLOR, width - 44)
            } else {
                const line = baseLine(codemap, row - 1)
                project_module.drawGraphRow(canvas, project_module.graphPart(line, 0), x + 16, y, app.POPUP_ROW)
                const hash = project_module.graphPart(line, 1)
                if hash.length > 0 {
                    var at_x = x + 26 + graph_width
                    text_module.drawText(canvas, access_module.monoOf(codemap), hash, at_x, y + 5, filters_module.canvasColor(app.CHANGED_COLOR, 255), 0)
                    at_x += text_module.measure(access_module.monoOf(codemap), hash) + 8
                    // Branches and tags on it, as pills.
                    const refs = project_module.graphPart(line, 2)
                    var start: usize = 0
                    var at: usize = 0
                    while at <= refs.length && at_x < x + width - 120 {
                        if at == refs.length || (refs[at] == 44 && at + 1 < refs.length && refs[at + 1] == 32) {
                            if at > start {
                                const name = refs[start..at]
                                const pill = text_module.measure(access_module.smallOf(codemap), name) + 12
                                const head_ref = name.length > 4 && access_module.sameBytes(name[0..4], "HEAD")
                                canvas_module.fillRoundedRect(canvas, at_x, y + 5, pill, app.POPUP_ROW - 10, 7, if head_ref { filters_module.canvasColor(app.ACCENT, 120) } else { filters_module.canvasColor(app.CHANGED_COLOR, 70) })
                                text_module.drawText(canvas, access_module.smallOf(codemap), name, at_x + 6, y + 6, app.TEXT_COLOR, 0)
                                at_x += pill + 6
                            }
                            start = at + 2
                            at += 1
                        }
                        at += 1
                    }
                    text_module.drawText(canvas, access_module.bodyOf(codemap), project_module.graphPart(line, 3), at_x, y + 5, app.TEXT_COLOR, x + width - 12 - at_x)
                }
            }
        } else {
            const length = filterRow(codemap, row, word_bytes, about_bytes)
            var about_length: usize = 0
            while about_bytes[about_length] != 0 { about_length += 1 }
            text_module.drawText(canvas, access_module.bodyOf(codemap), word_bytes[0..length], x + 16, y + 5, if row < contextRows(codemap) { app.ACCENT } else { app.TEXT_COLOR }, 150)
            text_module.drawText(canvas, access_module.smallOf(codemap), about_bytes[0..about_length], x + 176, y + 7, app.DIM_COLOR, width - 188)
        }
        row += 1
    }
    if footer > 0 {
        const y = codemap.*.popupRowTop + 6 + rows * app.POPUP_ROW
        const hint = access_module.say(codemap, "A click adds the word to the search; - before one turns it around, the bookmark keeps the query.", "Ein Klick fügt das Wort der Suche hinzu; - davor kehrt es um, das Lesezeichen hält die Abfrage fest.")
        const drawn = detail_module.drawWrapped(codemap, canvas, hint, access_module.smallOf(codemap), x + 16, y, width - 32, app.DIM_COLOR, 2, 16)
    }
}

// Ctrl+S: the query in the search, kept as a view in codemap.views.
pub fn saveView(codemap: *app.Codemap) -> void {
    if !codemap.*.queryActive { return }
    const text = access_module.searchText(codemap)
    if text.length > 0 && text[0] == 64 { return }
    const views = access_module.viewsOf(codemap)
    var name: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &name) }
    var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "View ", "Ansicht "))
    length = writeNumberPlain(bytes, length, views.*.count + 1)
    const saved = views_module.add(views, access_module.rootText(codemap), bytes[0..length], text)
    if codemap.*.trace { navigation_module.traceLine(codemap, if saved { "view saved " } else { "view not saved " }, bytes[0..length]) }
    access_module.panelOf(codemap).*.dirty = true
}

pub fn chooseResult(codemap: *app.Codemap, index: usize) -> void {
    if index >= codemap.*.resultCount { return }
    const node = codemap.*.results[index]
    codemap.*.searchFocused = false
    navigation_module.goTo(codemap, node)
}

pub fn searchKey(codemap: *app.Codemap, key: u32) -> void {
    if key == app.KEY_ESCAPE {
        navigation_module.clearSearch(codemap)
        return
    }
    if key == app.KEY_ENTER || key == app.KEY_KP_ENTER {
        if codemap.*.queryActive {
            codemap.*.searchFocused = false
            filters_module.flyToShown(codemap)
            return
        }
        chooseResult(codemap, codemap.*.resultCursor)
        return
    }
    if key == app.KEY_DOWN {
        if codemap.*.resultCursor + 1 < codemap.*.resultCount { codemap.*.resultCursor += 1 }
        return
    }
    if key == app.KEY_UP {
        if codemap.*.resultCursor > 0 { codemap.*.resultCursor -= 1 }
        return
    }
    if key == app.KEY_BACKSPACE {
        if codemap.*.searchLength == 0 { return }
        codemap.*.searchLength -= 1
        while codemap.*.searchLength > 0 && codemap.*.search[codemap.*.searchLength] >= 128 && codemap.*.search[codemap.*.searchLength] < 192 { codemap.*.searchLength -= 1 }
        navigation_module.searchChanged(codemap)
        return
    }
    typeInto(codemap)
}

// What the last key typed, into the search.
pub fn typeInto(codemap: *app.Codemap) -> void {
    const panel = access_module.panelOf(codemap)
    if panel.*.textLength == 0 || access_module.modifiers(codemap) & (app.CONTROL | app.ALT) != 0 || panel.*.text[0] < 32 { return }
    if codemap.*.searchLength + panel.*.textLength > 256 { return }
    var at: usize = 0
    while at < panel.*.textLength {
        codemap.*.search[codemap.*.searchLength] = panel.*.text[at]
        codemap.*.searchLength += 1
        at += 1
    }
    codemap.*.searchFocused = true
    navigation_module.searchChanged(codemap)
}

// ---------------------------------------------------------------------------
// Opening in the editor

fn quoteInto(out: [*]u8, at: usize, text: []const u8) -> usize {
    var length = at
    out[length] = 39
    length += 1
    for byte in text {
        if length > 1900 { return length }
        if byte == 39 {
            length = filters_module.writeText(out, length, "'\\''")
        } else {
            out[length] = byte
            length += 1
        }
    }
    out[length] = 39
    return length + 1
}

// "Open in editor", Ctrl+O: the built-in editor, at the declaration.
pub fn openInEditor(codemap: *app.Codemap, node: u32) -> void {
    if node == app.NONE { return }
    tabs_module.openNode(codemap, node)
}

// Ctrl+Shift+O: another editor (MLX_EDITOR, else VS Code, else
// xdg-open) at the same place.
pub fn openExternally(codemap: *app.Codemap, node: u32) -> void {
    if node == app.NONE { return }
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return }
    const index = codemap.*.index
    const file = index_module.symbolAt(index, record.*.symbol).*.file
    const path = index_module.pathOf(index, file)
    var line: usize = 1
    var column: usize = 1
    if record.*.kind == graph_module.DECLARATION {
        const offset = @intCast(usize, index_module.symbolAt(index, record.*.symbol).*.nameStart)
        line = index_module.lineOf(index, file, offset) + 1
        column = index_module.columnOf(index, file, offset) + 1
    }
    var place: [1200]u8 = undefined
    var place_bytes: [*]u8 = undefined
    unsafe { place_bytes = @ptrCast([*]u8, &place) }
    var place_length = filters_module.writeText(place_bytes, 0, path)
    place_length = filters_module.writeText(place_bytes, place_length, ":")
    place_length = writeNumberPlain(place_bytes, place_length, line)
    place_length = filters_module.writeText(place_bytes, place_length, ":")
    place_length = writeNumberPlain(place_bytes, place_length, column)
    var command: [2048]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &command) }
    var length: usize = 0
    const editor = apps_module.environmentValue(codemap.*.environment, "MLX_EDITOR")
    if @intFromPtr(editor) != 0 && editor[0] != 0 {
        length = filters_module.writeText(bytes, length, "exec ")
        length = filters_module.writeText(bytes, length, std.text.cString(editor))
        length = filters_module.writeText(bytes, length, " ")
        length = quoteInto(bytes, length, place_bytes[0..place_length])
    } else {
        length = filters_module.writeText(bytes, length, "if command -v code > /dev/null 2>&1; then exec code -g ")
        length = quoteInto(bytes, length, place_bytes[0..place_length])
        length = filters_module.writeText(bytes, length, "; else exec xdg-open ")
        length = quoteInto(bytes, length, path)
        length = filters_module.writeText(bytes, length, "; fi")
    }
    bytes[length] = 0
    apps_module.spawn(bytes, codemap.*.environment)
    access_module.setNote(codemap, access_module.say(codemap, "Opening ", "Öffne "), place_bytes[0..place_length])
}

pub fn writeNumberPlain(out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var length = at
    while count > 0 {
        count -= 1
        out[length] = digits[count]
        length += 1
    }
    return length
}
