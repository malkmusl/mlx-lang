// What the sidebar's check boxes leave out; numbers and text (part of main.mlx, split from it).
const std = @import("std")
const canvas_module = @import("std.ui.canvas")
const crash = @import("std.crash")
const index_module = @import("../../tools/codemap/index.mlx")
const analysis_module = @import("../../tools/codemap/analysis.mlx")
const crashes_module = @import("../../tools/codemap/crashes.mlx")
const workarounds_module = @import("../../tools/codemap/workarounds.mlx")
const programs_module = @import("../../tools/codemap/programs.mlx")
const binaries_module = @import("../../tools/codemap/binaries.mlx")
const complexity_module = @import("../../tools/codemap/complexity.mlx")
const structure_module = @import("../../tools/codemap/structure.mlx")
const profiles_module = @import("../../tools/codemap/profiles.mlx")
const measures_module = @import("../../tools/codemap/measures.mlx")
const diff_module = @import("../../tools/codemap/diff.mlx")
const query_module = @import("../../tools/codemap/query.mlx")
const graph_module = @import("./graph.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const navigation_module = @import("./navigation.mlx")
const lists_module = @import("./lists.mlx")

// ---------------------------------------------------------------------------
// What the sidebar's check boxes leave out

pub fn isHidden(codemap: *app.Codemap, node: u32) -> bool {
    return node == app.NONE || hiddenAt(codemap, @intCast(usize, node))
}

// Left out: by a check box or a kind (1), not reached by the program
// shown (4), or not answering the query in the search (8).
pub fn hiddenAt(codemap: *app.Codemap, node: usize) -> bool {
    const state = codemap.*.hidden[node]
    return state == 1 || state == 4 || state == 8
}

// Whether an index symbol's node is shown.
fn symbolShown(codemap: *app.Codemap, symbol: u32) -> bool {
    return !isHidden(codemap, access_module.nodeOfSymbol(codemap, symbol))
}

// Works out what is left out: a node taken out, or inside one, or of a
// kind left out; and what is shown with something inside left out.
pub fn refreshVisibility(codemap: *app.Codemap) -> void {
    const graph = access_module.graphOf(codemap)
    codemap.*.anyOff = false
    var node: usize = 0
    while node < graph.*.count {
        var hidden: u8 = 0
        var current = @intCast(u32, node)
        while current != app.NONE {
            const record = graph_module.nodeAt(graph, current)
            if codemap.*.off[@intCast(usize, current)] != 0 { hidden = 1 }
            if record.*.kind == graph_module.DECLARATION && codemap.*.kindOff[@intCast(usize, record.*.symbolKind)] { hidden = 1 }
            if hidden != 0 { break }
            current = record.*.parent
        }
        codemap.*.hidden[node] = hidden
        if codemap.*.off[node] != 0 { codemap.*.anyOff = true }
        node += 1
    }
    // A program shown: what it does not reach is left out, and what holds
    // nothing it reaches.
    if access_module.programChosen(codemap) {
        const programs = access_module.programsOf(codemap)
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 && !programs_module.reaches(programs, codemap.*.program, record.*.symbol) { codemap.*.hidden[node] = 4 }
            node += 1
        }
        // Mark (3) what holds something shown, then leave out the rest.
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 {
                var parent = record.*.parent
                while parent != app.NONE && codemap.*.hidden[@intCast(usize, parent)] == 0 {
                    codemap.*.hidden[@intCast(usize, parent)] = 3
                    parent = graph_module.nodeAt(graph, parent).*.parent
                }
            }
            node += 1
        }
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind != graph_module.DECLARATION && codemap.*.hidden[node] == 0 && @intCast(u32, node) != graph.*.root { codemap.*.hidden[node] = 4 }
            if codemap.*.hidden[node] == 3 { codemap.*.hidden[node] = 0 }
            node += 1
        }
    }
    // A query: what does not answer it is left out, and what holds
    // nothing that does.
    navigation_module.updateQuery(codemap)
    if codemap.*.queryActive {
        const query = access_module.queryOf(codemap)
        codemap.*.queryCount = 0
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 {
                if query_module.matches(query, record.*.symbol) { codemap.*.queryCount += 1 } else { codemap.*.hidden[node] = 8 }
            }
            node += 1
        }
        // Mark (3) what holds an answer (a struct that does not answer
        // itself is shown for its members that do).
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind == graph_module.DECLARATION && codemap.*.hidden[node] == 0 {
                var parent = record.*.parent
                while parent != app.NONE && (codemap.*.hidden[@intCast(usize, parent)] == 0 || codemap.*.hidden[@intCast(usize, parent)] == 8) {
                    codemap.*.hidden[@intCast(usize, parent)] = 3
                    parent = graph_module.nodeAt(graph, parent).*.parent
                }
            }
            node += 1
        }
        node = 0
        while node < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, node))
            if record.*.kind != graph_module.DECLARATION && codemap.*.hidden[node] == 0 && @intCast(u32, node) != graph.*.root { codemap.*.hidden[node] = 8 }
            if codemap.*.hidden[node] == 3 { codemap.*.hidden[node] = 0 }
            node += 1
        }
        if codemap.*.trace {
            var text: [320]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &text) }
            var length = writeText(bytes, 0, access_module.searchText(codemap))
            length = writeText(bytes, length, ": ")
            length = lists_module.writeNumberPlain(bytes, length, codemap.*.queryCount)
            length = writeText(bytes, length, " declarations")
            navigation_module.traceLine(codemap, "query ", bytes[0..length])
        }
    }
    node = 0
    while node < graph.*.count {
        if codemap.*.off[node] != 0 {
            var parent = graph_module.nodeAt(graph, @intCast(u32, node)).*.parent
            while parent != app.NONE && codemap.*.hidden[@intCast(usize, parent)] == 0 {
                codemap.*.hidden[@intCast(usize, parent)] = 2
                parent = graph_module.nodeAt(graph, parent).*.parent
            }
        }
        node += 1
    }
    refreshFindings(codemap)
    navigation_module.runSearch(codemap)
    access_module.panelOf(codemap).*.dirty = true
    if codemap.*.trace {
        var text: [128]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var shown: usize = 0
        node = 0
        while node < graph.*.count {
            if !hiddenAt(codemap, node) { shown += 1 }
            node += 1
        }
        var length = lists_module.writeNumberPlain(bytes, 0, shown)
        length = writeText(bytes, length, " nodes, findings")
        var finding: usize = 0
        while finding < app.FINDINGS {
            length = writeText(bytes, length, " ")
            length = lists_module.writeNumberPlain(bytes, length, codemap.*.findingCounts[finding])
            finding += 1
        }
        navigation_module.traceLine(codemap, "shown ", bytes[0..length])
    }
}

// A group's check box: 1 shown, 2 shown with something inside left out,
// 0 left out.
pub fn checkState(codemap: *app.Codemap, node: u32) -> u8 {
    if node == access_module.graphOf(codemap).*.root {
        if !codemap.*.anyOff { return 1 }
        var child = access_module.nodeOf(codemap, node).*.firstChild
        while child != app.NONE {
            if codemap.*.hidden[@intCast(usize, child)] != 1 { return 2 }
            child = access_module.nodeOf(codemap, child).*.nextSibling
        }
        return 0
    }
    const hidden = codemap.*.hidden[@intCast(usize, node)]
    if hidden == 1 { return 0 }
    if hidden == 2 { return 2 }
    return 1
}

// Whether `node` is `ancestor` or inside it.
pub fn isInside(codemap: *app.Codemap, node: u32, ancestor: u32) -> bool {
    var current = node
    while current != app.NONE {
        if current == ancestor { return true }
        current = access_module.nodeOf(codemap, current).*.parent
    }
    return false
}

// A click on a group's check box. Everything: all, or (when all is
// shown) nothing. A group left out: shown, and only it where what holds
// it was left out. Shown in part: all of it. Shown: left out.
pub fn toggleGroup(codemap: *app.Codemap, node: u32) -> void {
    const graph = access_module.graphOf(codemap)
    if node == graph.*.root {
        const show_all = codemap.*.anyOff
        var at: usize = 0
        while at < graph.*.count {
            codemap.*.off[at] = 0
            at += 1
        }
        if !show_all {
            var child = access_module.nodeOf(codemap, node).*.firstChild
            while child != app.NONE {
                codemap.*.off[@intCast(usize, child)] = 1
                child = access_module.nodeOf(codemap, child).*.nextSibling
            }
        }
    } else {
        const state = checkState(codemap, node)
        if state == 1 {
            codemap.*.off[@intCast(usize, node)] = 1
        } else if state == 2 {
            var at: usize = 0
            while at < graph.*.count {
                if codemap.*.off[at] != 0 && isInside(codemap, @intCast(u32, at), node) { codemap.*.off[at] = 0 }
                at += 1
            }
        } else {
            // From the top down: what is taken out on the way comes back,
            // with only the way in it.
            var path: [48]u32 = undefined
            var count: usize = 0
            var current = node
            while current != app.NONE && count < 48 {
                path[count] = current
                count += 1
                current = access_module.nodeOf(codemap, current).*.parent
            }
            var at = count
            while at > 0 {
                at -= 1
                const step = path[at]
                if codemap.*.off[@intCast(usize, step)] != 0 {
                    codemap.*.off[@intCast(usize, step)] = 0
                    if at > 0 {
                        var child = access_module.nodeOf(codemap, step).*.firstChild
                        while child != app.NONE {
                            if child != path[at - 1] { codemap.*.off[@intCast(usize, child)] = 1 }
                            child = access_module.nodeOf(codemap, child).*.nextSibling
                        }
                    }
                }
            }
        }
    }
    refreshVisibility(codemap)
    // What was selected and is left out now is not selected any more.
    if codemap.*.selected != app.NONE && isHidden(codemap, codemap.*.selected) { navigation_module.select(codemap, app.NONE) }
    flyToShown(codemap)
}

// The smallest group holding everything shown: down from the top while
// only one group is shown in it.
fn shownGroup(codemap: *app.Codemap) -> u32 {
    var group = access_module.graphOf(codemap).*.root
    while true {
        var only = app.NONE
        var shown: usize = 0
        var child = access_module.nodeOf(codemap, group).*.firstChild
        while child != app.NONE {
            if !isHidden(codemap, child) {
                shown += 1
                only = child
            }
            child = access_module.nodeOf(codemap, child).*.nextSibling
        }
        if shown != 1 || access_module.nodeOf(codemap, only).*.kind != graph_module.DIRECTORY { return group }
        group = only
    }
    return group
}

// After the check boxes changed: the camera flies to what is shown (not
// when nothing is).
pub fn flyToShown(codemap: *app.Codemap) -> void {
    const root = access_module.graphOf(codemap).*.root
    var any = false
    var child = access_module.nodeOf(codemap, root).*.firstChild
    while child != app.NONE && !any {
        if !isHidden(codemap, child) { any = true }
        child = access_module.nodeOf(codemap, child).*.nextSibling
    }
    if !any { return }
    const group = shownGroup(codemap)
    if codemap.*.trace {
        var key: [1024]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &key) }
        const length = navigation_module.keyOf(codemap, group, bytes)
        navigation_module.traceLine(codemap, "flying to ", bytes[0..length])
    }
    navigation_module.flyTo(codemap, group)
}

// The legend's kinds, in the order drawn (Struct/Union is one).
pub fn legendKind(index: usize) -> u8 {
    if index == 0 { return index_module.FUNCTION }
    if index == 1 { return index_module.STRUCT }
    if index == 2 { return index_module.ENUM }
    if index == 3 { return index_module.CONST }
    if index == 4 { return index_module.VAR }
    if index == 5 { return index_module.FIELD }
    return index_module.TEST
}

pub fn toggleKind(codemap: *app.Codemap, index: usize) -> void {
    const kind = @intCast(usize, legendKind(index))
    const off = !codemap.*.kindOff[kind]
    codemap.*.kindOff[kind] = off
    if kind == @intCast(usize, index_module.STRUCT) { codemap.*.kindOff[@intCast(usize, index_module.UNION)] = off }
    refreshVisibility(codemap)
}

// Whether a crash went through something shown (one that names nothing
// here: while nothing is left out).
fn recordShown(codemap: *app.Codemap, record: u32) -> bool {
    const crashes = access_module.crashesOf(codemap)
    var frame = crashes_module.firstFrame(crashes, record)
    var named = false
    while frame < crashes.*.frameCount && crashes.*.frameRecord[frame] == record {
        const node = access_module.nodeOfSymbol(codemap, crashes.*.frameSymbol[frame])
        if node != app.NONE {
            named = true
            if !isHidden(codemap, node) { return true }
        }
        frame += 1
    }
    return !named && !codemap.*.anyOff
}

fn groupShown(codemap: *app.Codemap, kind: u8, group: usize) -> bool {
    for symbol in analysis_module.groupMembers(access_module.analysisOf(codemap), kind, group) {
        if symbolShown(codemap, symbol) { return true }
    }
    return false
}

fn markGroup(codemap: *app.Codemap, kind: u8, group: usize, bit: u16) -> void {
    for symbol in analysis_module.groupMembers(access_module.analysisOf(codemap), kind, group) {
        const node = access_module.nodeOfSymbol(codemap, symbol)
        if node != app.NONE { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | bit }
    }
}

// Counts what each finding shows, marks the nodes of the findings checked
// (a bit each), picks the groups joined in space, and lists the open one.
pub fn refreshFindings(codemap: *app.Codemap) -> void {
    const graph = access_module.graphOf(codemap)
    var at: usize = 0
    while at < graph.*.count {
        codemap.*.findingMark[at] = 0
        at += 1
    }
    codemap.*.findingCount = 0
    codemap.*.lineGroupCount = 0
    at = 0
    while at < app.FINDINGS {
        codemap.*.findingCounts[at] = 0
        at += 1
    }
    if !codemap.*.built { return }
    const analysis = access_module.analysisOf(codemap)
    const ranked = graph.*.order
    // Copies (exact, then by shape) and names, heaviest first.
    var finding: u8 = app.FINDING_COPIES
    while finding <= app.FINDING_NAMES {
        var kinds: [2]u8 = [2]u8{ analysis_module.COPIES, analysis_module.SHAPES }
        if finding == app.FINDING_NAMES {
            kinds[0] = analysis_module.NAMES
            kinds[1] = 255
        }
        const index = @intCast(usize, finding)
        const bit = @intCast(u16, 1) << @intCast(u16, finding)
        for kind in kinds {
            if kind == 255 { continue }
            const count = analysis_module.ranked(analysis, kind, ranked)
            var group: usize = 0
            while group < count {
                const which = @intCast(usize, ranked[group])
                if groupShown(codemap, kind, which) {
                    const entry = (@intCast(u32, kind) << 24) | @intCast(u32, which)
                    codemap.*.findingCounts[index] += 1
                    if codemap.*.findingOn[index] {
                        markGroup(codemap, kind, which, bit)
                        if codemap.*.lineGroupCount < app.LINE_GROUPS {
                            codemap.*.lineGroups[codemap.*.lineGroupCount] = entry
                            codemap.*.lineGroupCount += 1
                        }
                    }
                    if codemap.*.finding == finding {
                        codemap.*.findingOrder[codemap.*.findingCount] = entry
                        codemap.*.findingCount += 1
                    }
                }
                group += 1
            }
        }
        finding += 1
    }
    // Unused declarations.
    at = 0
    while at < analysis.*.unusedCount {
        const symbol = analysis.*.unused[at]
        const node = access_module.nodeOfSymbol(codemap, symbol)
        if node != app.NONE && !isHidden(codemap, node) {
            codemap.*.findingCounts[@intCast(usize, app.FINDING_UNUSED)] += 1
            if codemap.*.findingOn[@intCast(usize, app.FINDING_UNUSED)] { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | 4 }
            if codemap.*.finding == app.FINDING_UNUSED {
                codemap.*.findingOrder[codemap.*.findingCount] = symbol
                codemap.*.findingCount += 1
            }
        }
        at += 1
    }
    // Workarounds: the places of the kinds checked, in what is shown.
    const workarounds = access_module.workaroundsOf(codemap)
    var pattern: usize = 0
    var mask: u16 = 0
    while pattern < workarounds_module.PATTERNS {
        codemap.*.patternPlaces[pattern] = 0
        if codemap.*.patternOn[pattern] { mask = mask | (@intCast(u16, 1) << @intCast(u16, pattern)) }
        pattern += 1
    }
    at = 0
    while at < workarounds.*.count {
        if workarounds.*.symbol[at] != app.NONE && symbolShown(codemap, workarounds.*.symbol[at]) { codemap.*.patternPlaces[@intCast(usize, workarounds.*.pattern[at])] += 1 }
        at += 1
    }
    pattern = 0
    while pattern < workarounds_module.PATTERNS {
        if codemap.*.patternOn[pattern] { codemap.*.findingCounts[@intCast(usize, app.FINDING_WORKAROUNDS)] += codemap.*.patternPlaces[pattern] }
        pattern += 1
    }
    if codemap.*.findingOn[@intCast(usize, app.FINDING_WORKAROUNDS)] {
        at = 0
        while at < graph.*.count {
            const record = graph_module.nodeAt(graph, @intCast(u32, at))
            if record.*.kind == graph_module.DECLARATION && workarounds_module.marksOf(workarounds, record.*.symbol) & mask != 0 { codemap.*.findingMark[at] = codemap.*.findingMark[at] | 8 }
            at += 1
        }
    }
    if codemap.*.finding == app.FINDING_WORKAROUNDS {
        at = 0
        while at < codemap.*.patternCount {
            const kind = codemap.*.patternOrder[at]
            if codemap.*.patternOn[@intCast(usize, kind)] && codemap.*.patternPlaces[@intCast(usize, kind)] > 0 {
                codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, kind)
                codemap.*.findingCount += 1
            }
            at += 1
        }
    }
    // Dead code, untested, complex, risky and hot functions.
    listSymbols(codemap, app.FINDING_UNREACHABLE)
    listSymbols(codemap, app.FINDING_UNTESTED)
    listSymbols(codemap, app.FINDING_COMPLEX)
    listSymbols(codemap, app.FINDING_RISKY)
    listSymbols(codemap, app.FINDING_HOT)
    listSymbols(codemap, app.FINDING_CHANGED)
    listStructure(codemap)
    // Crashes, newest first.
    const crashes = access_module.crashesOf(codemap)
    var record = crashes.*.count
    while record > 0 {
        record -= 1
        if recordShown(codemap, @intCast(u32, record)) {
            codemap.*.findingCounts[@intCast(usize, app.FINDING_CRASHES)] += 1
            if codemap.*.finding == app.FINDING_CRASHES {
                codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, record)
                codemap.*.findingCount += 1
            }
        }
    }
}

// Whether `symbol` is one of the finding's (0: no), and its weight (most
// first; 1 and more).
fn findingWeight(codemap: *app.Codemap, finding: u8, symbol: u32) -> u64 {
    if finding == app.FINDING_UNREACHABLE {
        if !programs_module.isUnreachable(access_module.programsOf(codemap), symbol) || binaries_module.bytesOf(access_module.binariesOf(codemap), symbol) != 0 { return 0 }
        return 1 + @intCast(u64, complexity_module.tokensOf(access_module.complexityOf(codemap), symbol))
    }
    if finding == app.FINDING_UNTESTED {
        if !programs_module.isUntested(access_module.programsOf(codemap), symbol) { return 0 }
        return 1 + @intCast(u64, complexity_module.scoreOf(access_module.complexityOf(codemap), symbol))
    }
    if finding == app.FINDING_COMPLEX {
        if !complexity_module.isComplex(access_module.complexityOf(codemap), symbol) { return 0 }
        return 1 + @intCast(u64, complexity_module.scoreOf(access_module.complexityOf(codemap), symbol))
    }
    if finding == app.FINDING_RISKY {
        const risk = measures_module.risk(access_module.measuresOf(codemap), symbol)
        return if risk >= measures_module.RISKY { risk } else { 0 }
    }
    if finding == app.FINDING_HOT { return @intCast(u64, profiles_module.totalOf(access_module.profilesOf(codemap), symbol)) }
    if finding == app.FINDING_CHANGED {
        const state = diff_module.stateOf(access_module.diffOf(codemap), symbol)
        if state == diff_module.ADDED { return 2 }
        if state == diff_module.CHANGED { return 1 }
    }
    return 0
}

// A finding made of functions: counts the shown, marks them when checked,
// lists them (most first) when open.
fn listSymbols(codemap: *app.Codemap, finding: u8) -> void {
    const index = codemap.*.index
    const on = codemap.*.findingOn[@intCast(usize, finding)]
    const open = codemap.*.finding == finding
    const bit = @intCast(u16, 1) << @intCast(u16, finding)
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const kind = index_module.symbolAt(index, id).*.kind
        if kind == index_module.FUNCTION || (finding == app.FINDING_CHANGED && query_module.isDeclaration(kind)) {
            const weight = findingWeight(codemap, finding, id)
            if weight > 0 {
                const node = access_module.nodeOfSymbol(codemap, id)
                if node != app.NONE && !isHidden(codemap, node) {
                    codemap.*.findingCounts[@intCast(usize, finding)] += 1
                    if on { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | bit }
                    if open {
                        codemap.*.sortKeys[count] = (@intCast(u64, 4294967295 - (if weight > 4294967295 { 4294967295 } else { weight })) << 32) | @intCast(u64, symbol)
                        count += 1
                    }
                }
            }
        }
        symbol += 1
    }
    if !open { return }
    std.mem.sortU64(codemap.*.sortKeys, count)
    var at: usize = 0
    while at < count {
        codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, codemap.*.sortKeys[at] & 4294967295)
        codemap.*.findingCount += 1
        at += 1
    }
}

pub fn fileNode(codemap: *app.Codemap, file: u32) -> u32 {
    return access_module.nodeOfSymbol(codemap, index_module.fileAt(codemap.*.index, file).*.symbol)
}

// Cycles of imports and imports against the rules: an entry each (a
// cycle, or 1 << 31 and the broken import), shown when a file of it is.
fn listStructure(codemap: *app.Codemap) -> void {
    const structure = access_module.structureOf(codemap)
    const on = codemap.*.findingOn[@intCast(usize, app.FINDING_STRUCTURE)]
    const open = codemap.*.finding == app.FINDING_STRUCTURE
    var cycle: usize = 0
    while cycle < structure.*.cycleCount {
        var shown = false
        for file in structure_module.cycleMembers(structure, cycle) {
            const node = fileNode(codemap, file)
            if node != app.NONE && !isHidden(codemap, node) { shown = true }
        }
        if shown {
            codemap.*.findingCounts[@intCast(usize, app.FINDING_STRUCTURE)] += 1
            if on {
                for file in structure_module.cycleMembers(structure, cycle) {
                    const node = fileNode(codemap, file)
                    if node != app.NONE { codemap.*.findingMark[@intCast(usize, node)] = codemap.*.findingMark[@intCast(usize, node)] | 256 }
                }
            }
            if open {
                codemap.*.findingOrder[codemap.*.findingCount] = @intCast(u32, cycle)
                codemap.*.findingCount += 1
            }
        }
        cycle += 1
    }
    var broken: usize = 0
    while broken < structure.*.brokenCount {
        const import = @intCast(usize, structure.*.broken[broken])
        const from = fileNode(codemap, structure.*.importFrom[import])
        if from != app.NONE && !isHidden(codemap, from) {
            codemap.*.findingCounts[@intCast(usize, app.FINDING_STRUCTURE)] += 1
            if on { codemap.*.findingMark[@intCast(usize, from)] = codemap.*.findingMark[@intCast(usize, from)] | 256 }
            if open {
                codemap.*.findingOrder[codemap.*.findingCount] = 2147483648 | @intCast(u32, broken)
                codemap.*.findingCount += 1
            }
        }
        broken += 1
    }
}

pub fn findingSize(codemap: *app.Codemap, finding: u8) -> usize {
    return codemap.*.findingCounts[@intCast(usize, finding)]
}

pub fn detailX(codemap: *app.Codemap) -> i32 { return access_module.surfaceWidth(codemap) - app.DETAIL }

pub fn inside(x: i32, y: i32, left: i32, top: i32, width: i32, height: i32) -> bool {
    return x >= left && x < left + width && y >= top && y < top + height
}

// ---------------------------------------------------------------------------
// Numbers and text

pub fn writeText(out: [*]u8, at: usize, text: []const u8) -> usize {
    var length = at
    for byte in text {
        out[length] = byte
        length += 1
    }
    return length
}

// `value` in digits, thousands apart (German: 1.234, English: 1,234).
pub fn writeNumber(codemap: *app.Codemap, out: [*]u8, at: usize, value: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var length = at
    while count > 0 {
        count -= 1
        out[length] = digits[count]
        length += 1
        if count > 0 && count % 3 == 0 {
            out[length] = if codemap.*.german { 46 } else { 44 }
            length += 1
        }
    }
    return length
}

pub fn kindLabel(codemap: *app.Codemap, node: u32) -> []const u8 {
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { return access_module.say(codemap, "Group", "Gruppe") }
    if record.*.kind == graph_module.FILE { return access_module.say(codemap, "File", "Datei") }
    const kind = record.*.symbolKind
    if kind == index_module.STRUCT { return "Struct" }
    if kind == index_module.ENUM { return "Enum" }
    if kind == index_module.UNION { return "Union" }
    if kind == index_module.ERROR_SET { return access_module.say(codemap, "Error set", "Fehlermenge") }
    if kind == index_module.FIELD { return access_module.say(codemap, "Field", "Feld") }
    if kind == index_module.MEMBER { return access_module.say(codemap, "Member", "Element") }
    if kind == index_module.FUNCTION { return access_module.say(codemap, "Function", "Funktion") }
    if kind == index_module.CONST { return access_module.say(codemap, "Constant", "Konstante") }
    if kind == index_module.VAR { return "Variable" }
    if kind == index_module.TEST { return "Test" }
    return access_module.say(codemap, "Declaration", "Deklaration")
}

// A lighter or darker color (factor in 1/256).
fn shaded(color: u32, factor: u32) -> u32 {
    var red = ((color >> 16) & 255) * factor / 256
    var green = ((color >> 8) & 255) * factor / 256
    var blue = (color & 255) * factor / 256
    if red > 255 { red = 255 }
    if green > 255 { green = 255 }
    if blue > 255 { blue = 255 }
    return (color & 4278190080) | (red << 16) | (green << 8) | blue
}

// `color` (opaque) with alpha `alpha` (straight, for the scene).
pub fn withAlpha(color: u32, alpha: u32) -> u32 { return (color & 16777215) | ((if alpha > 255 { 255 } else { alpha }) << 24) }

// The same, premultiplied (for the canvas).
pub fn canvasColor(color: u32, alpha: u32) -> u32 { return canvas_module.premultiplied(withAlpha(color, alpha)) }
