// The 3D view and its labels (part of main.mlx, split from it).
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const crash = @import("std.crash")
const analysis_module = @import("../../tools/codemap/analysis.mlx")
const crashes_module = @import("../../tools/codemap/crashes.mlx")
const structure_module = @import("../../tools/codemap/structure.mlx")
const graph_module = @import("./graph.mlx")
const scene_module = @import("./scene.mlx")
const m = @import("./math3d.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")

// ---------------------------------------------------------------------------
// The 3D view: what the camera sees, as the scene's spheres, glows and
// lines

fn seenOf(codemap: *app.Codemap, node: u32) -> bool { return codemap.*.seen[@intCast(usize, node)] != 0 }

// The radius a node is drawn at: its own, but groups and files not less
// than a few pixels (so the whole shows from afar).
fn shownRadius(codemap: *app.Codemap, node: u32) -> f64 {
    const record = access_module.nodeOf(codemap, node)
    const radius = codemap.*.seenRadius[@intCast(usize, node)]
    if record.*.kind == graph_module.DIRECTORY { return m.maximum(radius, 3.4) }
    if record.*.kind == graph_module.FILE { return m.maximum(radius, 1.8) }
    if graph_module.isContainer(record.*.symbolKind) { return m.maximum(radius, 1.1) }
    return radius
}

// How opaque a node is drawn (0-255): small declarations fade in as they
// come closer; what a search does not match fades out.
fn opacityOf(codemap: *app.Codemap, node: u32) -> u32 {
    const record = access_module.nodeOf(codemap, node)
    var alpha: f64 = 1.0
    if record.*.kind == graph_module.DECLARATION && !graph_module.isContainer(record.*.symbolKind) {
        const radius = codemap.*.seenRadius[@intCast(usize, node)]
        if radius < 0.45 { return 0 }
        if radius < 1.4 { alpha = (radius - 0.45) / 0.95 }
    }
    if codemap.*.searchFocused && codemap.*.search.length > 0 && codemap.*.matches[@intCast(usize, node)] == 0 && codemap.*.related[@intCast(usize, node)] == 0 && node != codemap.*.selected { alpha = alpha * 0.25 }
    return @intCast(u32, m.toInt(alpha * 255.0))
}

// A line from node a to node b, between the edges of their spheres.
fn nodeLine(codemap: *app.Codemap, a: u32, b: u32, width: f64, near_color: u32, far_color: u32, in_front: bool) -> void {
    if !seenOf(codemap, a) || !seenOf(codemap, b) { return }
    const ax = codemap.*.seenX[@intCast(usize, a)]
    const ay = codemap.*.seenY[@intCast(usize, a)]
    const bx = codemap.*.seenX[@intCast(usize, b)]
    const by = codemap.*.seenY[@intCast(usize, b)]
    const dx = bx - ax
    const dy = by - ay
    const size = m.sqrt(dx * dx + dy * dy)
    const ra = shownRadius(codemap, a)
    const rb = shownRadius(codemap, b)
    if size <= ra + rb + 1.0 { return }
    const ux = dx / size
    const uy = dy / size
    const da = codemap.*.seenDepth[@intCast(usize, a)]
    const db = codemap.*.seenDepth[@intCast(usize, b)]
    // Behind both ends, or (highlighted) in front of them.
    const depth = if in_front { m.minimum(da, db) * 0.999 } else { m.maximum(da, db) * 1.001 }
    scene_module.line(access_module.sceneOf(codemap), ax + ux * ra, ay + uy * ra, bx - ux * rb, by - uy * rb, width, near_color, far_color, depth)
}

fn project(codemap: *app.Codemap) -> void {
    const graph = access_module.graphOf(codemap)
    const camera = access_module.cameraOf(codemap)
    var node: usize = 0
    while node < graph.*.count {
        const record = graph_module.nodeAt(graph, @intCast(u32, node))
        const where = m.project(camera, m.vec(record.*.x, record.*.y, record.*.z))
        codemap.*.seenDepth[node] = where.depth
        if where.depth < 0.05 || filters_module.hiddenAt(codemap, node) {
            codemap.*.seen[node] = 0
        } else {
            codemap.*.seen[node] = 1
            codemap.*.seenX[node] = where.x
            codemap.*.seenY[node] = where.y
            codemap.*.seenRadius[node] = record.*.radius * camera.*.focal / where.depth
        }
        node += 1
    }
}

pub fn buildScene(codemap: *app.Codemap) -> void {
    const scene = access_module.sceneOf(codemap)
    const width = access_module.viewWidth(codemap)
    const height = access_module.viewHeight(codemap)
    scene_module.begin(scene, app.SIDEBAR, app.TOOLBAR, width, height)
    codemap.*.drawnCount = 0
    // In the editor no galaxy is drawn; a flight still ends.
    if codemap.*.view == app.VIEW_EDITOR {
        navigation_module.advance(codemap)
        return
    }
    if !codemap.*.built || width <= 0 || height <= 0 { return }
    const camera = access_module.cameraOf(codemap)
    const open_width = if access_module.detailOpen(codemap) { width - app.DETAIL } else { width }
    camera.*.centerX = m.toFloat(@intCast(i64, open_width)) * 0.5
    camera.*.centerY = m.toFloat(@intCast(i64, height)) * 0.5
    camera.*.focal = m.toFloat(@intCast(i64, height)) * 0.95
    navigation_module.advance(codemap)
    m.update(camera)
    project(codemap)
    const graph = access_module.graphOf(codemap)
    const full_width: f64 = m.toFloat(@intCast(i64, width))
    const full_height: f64 = m.toFloat(@intCast(i64, height))
    const selected = codemap.*.selected
    const quiet = selected != app.NONE
    // The groups: a haze as big as each, and the lines of the tree.
    var node: usize = 0
    while node < graph.*.count {
        const id = @intCast(u32, node)
        if codemap.*.seen[node] != 0 {
            const record = graph_module.nodeAt(graph, id)
            if record.*.kind == graph_module.DIRECTORY && id != graph.*.root {
                const depth = codemap.*.seenDepth[node]
                if depth > record.*.extent {
                    const haze = record.*.extent * camera.*.focal / depth
                    if haze > 6.0 {
                        var alpha: f64 = 22.0
                        if haze > full_height { alpha = alpha * full_height / haze }
                        scene_module.glow(scene, codemap.*.seenX[node], codemap.*.seenY[node], haze, filters_module.withAlpha(record.*.color, @intCast(u32, m.toInt(alpha))), depth + record.*.extent)
                    }
                }
            }
            if codemap.*.showTree && record.*.parent != app.NONE && shownRadius(codemap, id) >= 1.0 {
                const alpha: u32 = if quiet { 30 } else { 52 }
                const fade = opacityOf(codemap, id)
                if fade > 0 {
                    const parent_color = graph_module.nodeAt(graph, record.*.parent).*.color
                    nodeLine(codemap, record.*.parent, id, 1.0, filters_module.withAlpha(parent_color, alpha * fade / 255), filters_module.withAlpha(record.*.color, alpha * fade / 255), false)
                }
            }
        }
        node += 1
    }
    // The imports between files.
    if codemap.*.showImports {
        const alpha: u32 = if quiet { 14 } else { 34 }
        var at: usize = 0
        while at < graph.*.importCount {
            const from = graph.*.importFrom[at]
            const to = graph.*.importTo[at]
            nodeLine(codemap, from, to, 1.0, filters_module.withAlpha(access_module.nodeOf(codemap, from).*.color, alpha), filters_module.withAlpha(access_module.nodeOf(codemap, to).*.color, alpha), false)
            at += 1
        }
    }
    // The spheres.
    node = 0
    while node < graph.*.count {
        const id = @intCast(u32, node)
        if codemap.*.seen[node] != 0 {
            const radius = shownRadius(codemap, id)
            const x = codemap.*.seenX[node]
            const y = codemap.*.seenY[node]
            const on_screen = x + radius > 0.0 && y + radius > 0.0 && x - radius < full_width && y - radius < full_height
            const alpha = opacityOf(codemap, id)
            if on_screen && alpha > 0 && radius >= 0.45 {
                const record = graph_module.nodeAt(graph, id)
                const depth = codemap.*.seenDepth[node]
                scene_module.sphere(scene, x, y, radius, filters_module.withAlpha(access_module.sphereColor(codemap, id), alpha), depth)
                if codemap.*.drawnCount < graph_module.MAX_NODES {
                    codemap.*.drawn[codemap.*.drawnCount] = id
                    codemap.*.drawnCount += 1
                }
                const related = codemap.*.related[node]
                if related != 0 {
                    const color = if related & 1 != 0 { app.OUTGOING } else { app.INCOMING }
                    scene_module.glow(scene, x, y, radius * 2.0 + 7.0, filters_module.withAlpha(color, 120), depth + radius * depth / camera.*.focal)
                } else if codemap.*.search.length > 0 && codemap.*.matches[node] != 0 && codemap.*.matchCount < 4000 {
                    scene_module.glow(scene, x, y, radius * 2.0 + 6.0, filters_module.withAlpha(4294953835, 110), depth + radius * depth / camera.*.focal)
                }
            }
        }
        node += 1
    }
    // The findings checked in the sidebar: their nodes aglow (workarounds
    // amber, the others magenta), the groups of copies and names joined.
    node = 0
    while node < graph.*.count {
        const bits = codemap.*.findingMark[node]
        if bits != 0 && codemap.*.seen[node] != 0 {
            const id = @intCast(u32, node)
            const radius = shownRadius(codemap, id)
            // Close up the node says it (a glow that big costs).
            if radius < 90.0 {
                const depth = codemap.*.seenDepth[node]
                const color = access_module.markColor(bits)
                const alpha: u32 = if bits == 4 { 110 } else { 150 }
                scene_module.glow(scene, codemap.*.seenX[node], codemap.*.seenY[node], radius * 2.4 + 8.0, filters_module.withAlpha(color, alpha), depth + radius * depth / camera.*.focal)
            }
        }
        node += 1
    }
    if codemap.*.lineGroupCount > 0 {
        const analysis = access_module.analysisOf(codemap)
        var at: usize = 0
        while at < codemap.*.lineGroupCount {
            const entry = codemap.*.lineGroups[at]
            const members = analysis_module.groupMembers(analysis, access_module.findingEntryKind(entry), access_module.findingEntryGroup(entry))
            var previous = app.NONE
            for symbol in members {
                const member = access_module.nodeOfSymbol(codemap, symbol)
                if member != app.NONE {
                    if previous != app.NONE { nodeLine(codemap, previous, member, 1.4, filters_module.withAlpha(app.FINDING_COLOR, 170), filters_module.withAlpha(app.FINDING_COLOR, 170), true) }
                    previous = member
                }
            }
            at += 1
        }
    }
    if codemap.*.findingOn[@intCast(usize, app.FINDING_STRUCTURE)] {
        // Cycles round, and the imports against the rules.
        const structure = access_module.structureOf(codemap)
        var cycle: usize = 0
        while cycle < structure.*.cycleCount {
            const members = structure_module.cycleMembers(structure, cycle)
            var at: usize = 0
            while at < members.length {
                const from = filters_module.fileNode(codemap, members[at])
                const to = filters_module.fileNode(codemap, members[(at + 1) % members.length])
                if from != app.NONE && to != app.NONE { nodeLine(codemap, from, to, 1.6, filters_module.withAlpha(app.STRUCTURE_COLOR, 210), filters_module.withAlpha(app.STRUCTURE_COLOR, 210), true) }
                at += 1
            }
            cycle += 1
        }
        var broken: usize = 0
        while broken < structure.*.brokenCount {
            const import = @intCast(usize, structure.*.broken[broken])
            const from = filters_module.fileNode(codemap, structure.*.importFrom[import])
            const to = filters_module.fileNode(codemap, structure.*.importTo[import])
            if from != app.NONE && to != app.NONE { nodeLine(codemap, from, to, 1.6, filters_module.withAlpha(app.STRUCTURE_COLOR, 220), filters_module.withAlpha(app.RISKY_COLOR, 220), true) }
            broken += 1
        }
    }
    const crashes_on = codemap.*.findingOn[@intCast(usize, app.FINDING_CRASHES)]
    if crashes_on {
        // Each crash's calls, from the caller to what it called.
        const crashes = access_module.crashesOf(codemap)
        var record: usize = 0
        while record < crashes.*.count && record < 400 {
            var frame = crashes_module.firstFrame(crashes, @intCast(u32, record))
            var callee = app.NONE
            while frame < crashes.*.frameCount && crashes.*.frameRecord[frame] == @intCast(u32, record) {
                const caller = access_module.nodeOfSymbol(codemap, crashes.*.frameSymbol[frame])
                if caller != app.NONE && callee != app.NONE && caller != callee { nodeLine(codemap, caller, callee, 1.6, filters_module.withAlpha(app.CRASH_COLOR, 200), filters_module.withAlpha(app.CRASH_COLOR, 200), true) }
                if caller != app.NONE { callee = caller }
                frame += 1
            }
            record += 1
        }
    }
    // Crashes: a red flag on what crashed and on what holds it, in front
    // of everything; a glow on where a crash stopped (strong) or went
    // through.
    if crashes_on && codemap.*.crashedCount > 0 {
        node = 0
        while node < graph.*.count {
            const mark = codemap.*.crashMark[node]
            if mark != 0 && codemap.*.seen[node] != 0 {
                const id = @intCast(u32, node)
                const radius = shownRadius(codemap, id)
                const depth = codemap.*.seenDepth[node]
                const x = codemap.*.seenX[node]
                const y = codemap.*.seenY[node]
                if radius >= 0.45 && x + radius > 0.0 && y + radius > 0.0 && x - radius < full_width && y - radius < full_height {
                    // Close up the flag says it (a glow that big costs).
                    if mark == 2 && radius < 60.0 { scene_module.glow(scene, x, y, radius * 2.2 + 7.0, filters_module.withAlpha(app.CRASH_COLOR, 190), depth + radius * depth / camera.*.focal) }
                    if mark == 1 && radius < 60.0 { scene_module.glow(scene, x, y, radius * 1.8 + 5.0, filters_module.withAlpha(app.CRASH_COLOR, 90), depth + radius * depth / camera.*.focal) }
                    // The flag stays in front of everything, as a pin would.
                    var flag = radius * 0.3
                    if flag < 3.5 { flag = 3.5 }
                    if mark == 3 && flag > 5.0 { flag = 5.0 }
                    scene_module.sphere(scene, x + radius * 0.7, y - radius * 0.7, flag, filters_module.withAlpha(app.CRASH_COLOR, 255), 0.001)
                }
            }
            node += 1
        }
    }
    // What is selected: its connections, a halo; what the pointer is on.
    if selected != app.NONE && seenOf(codemap, selected) {
        const relations = access_module.relationsOf(codemap)
        var at: usize = 0
        while at < relations.*.outgoingCount {
            const other = relations.*.outgoing[at].node
            nodeLine(codemap, selected, other, 1.8, filters_module.withAlpha(app.OUTGOING, 230), filters_module.withAlpha(access_module.nodeOf(codemap, other).*.color, 200), true)
            at += 1
        }
        at = 0
        while at < relations.*.incomingCount {
            const other = relations.*.incoming[at].node
            nodeLine(codemap, other, selected, 1.8, filters_module.withAlpha(access_module.nodeOf(codemap, other).*.color, 200), filters_module.withAlpha(app.INCOMING, 230), true)
            at += 1
        }
        const index = @intCast(usize, selected)
        const radius = shownRadius(codemap, selected)
        scene_module.glow(scene, codemap.*.seenX[index], codemap.*.seenY[index], radius * 2.6 + 12.0, filters_module.withAlpha(4294967295, 110), codemap.*.seenDepth[index] + radius * codemap.*.seenDepth[index] / camera.*.focal)
    }
    const hovered = codemap.*.hoverNode
    if hovered != app.NONE && hovered != selected && seenOf(codemap, hovered) {
        const index = @intCast(usize, hovered)
        const radius = shownRadius(codemap, hovered)
        scene_module.glow(scene, codemap.*.seenX[index], codemap.*.seenY[index], radius * 2.2 + 9.0, filters_module.withAlpha(4294967295, 80), codemap.*.seenDepth[index] + radius * codemap.*.seenDepth[index] / camera.*.focal)
    }
}

// The node drawn under (x, y) in the view, the nearest; else NONE.
pub fn nodeAt(codemap: *app.Codemap, x: i32, y: i32) -> u32 {
    const px = m.toFloat(@intCast(i64, x - app.SIDEBAR))
    const py = m.toFloat(@intCast(i64, y - app.TOOLBAR))
    var best = app.NONE
    var best_depth: f64 = 1000000000.0
    var nearest = app.NONE
    var nearest_distance: f64 = 64.0
    var at: usize = 0
    while at < codemap.*.drawnCount {
        const node = codemap.*.drawn[at]
        const index = @intCast(usize, node)
        const dx = codemap.*.seenX[index] - px
        const dy = codemap.*.seenY[index] - py
        const radius = shownRadius(codemap, node)
        const distance = dx * dx + dy * dy
        if distance <= (radius + 1.5) * (radius + 1.5) && codemap.*.seenDepth[index] < best_depth {
            best = node
            best_depth = codemap.*.seenDepth[index]
        }
        if distance < nearest_distance {
            nearest = node
            nearest_distance = distance
        }
        at += 1
    }
    return if best != app.NONE { best } else { nearest }
}

// ---------------------------------------------------------------------------
// Labels

fn labelPriority(codemap: *app.Codemap, node: u32) -> u64 {
    var priority: u64 = @intCast(u64, m.toInt(m.minimum(shownRadius(codemap, node), 5000.0) * 100.0))
    const record = access_module.nodeOf(codemap, node)
    if record.*.kind == graph_module.DIRECTORY { priority += 200000 }
    if node == codemap.*.selected { priority += 4000000 }
    if node == codemap.*.hoverNode { priority += 3000000 }
    if codemap.*.related[@intCast(usize, node)] != 0 { priority += 1000000 }
    if codemap.*.search.length > 0 && codemap.*.matches[@intCast(usize, node)] != 0 { priority += 800000 }
    return priority
}

fn wantsLabel(codemap: *app.Codemap, node: u32) -> bool {
    if node == codemap.*.selected || node == codemap.*.hoverNode { return true }
    if !codemap.*.showLabels { return false }
    const record = access_module.nodeOf(codemap, node)
    const radius = shownRadius(codemap, node)
    if codemap.*.related[@intCast(usize, node)] != 0 && radius >= 1.5 { return true }
    if codemap.*.search.length > 0 && codemap.*.matches[@intCast(usize, node)] != 0 && radius >= 1.5 { return true }
    if record.*.kind == graph_module.DIRECTORY { return true }
    if record.*.kind == graph_module.FILE { return radius >= 4.0 }
    return radius >= 6.0
}

fn sortLabelKeys(codemap: *app.Codemap, count: usize) -> void {
    var source = codemap.*.labelKeys
    var target = codemap.*.labelScratch
    var width: usize = 1
    while width < count {
        var low: usize = 0
        while low < count {
            const middle = if low + width < count { low + width } else { count }
            const high = if low + width * 2 < count { low + width * 2 } else { count }
            var left = low
            var right = middle
            var out = low
            while out < high {
                if left < middle && (right >= high || source[left] >= source[right]) {
                    target[out] = source[left]
                    left += 1
                } else {
                    target[out] = source[right]
                    right += 1
                }
                out += 1
            }
            low = high
        }
        const swap = source
        source = target
        target = swap
        width = width * 2
    }
    if @intFromPtr(source) != @intFromPtr(codemap.*.labelKeys) {
        var at: usize = 0
        while at < count {
            codemap.*.labelKeys[at] = source[at]
            at += 1
        }
    }
}

// Chooses the labels: the most important first, none over another.
pub fn placeLabels(codemap: *app.Codemap) -> void {
    codemap.*.labelCount = 0
    if !codemap.*.built { return }
    var count: usize = 0
    var at: usize = 0
    while at < codemap.*.drawnCount && count < app.LABEL_CANDIDATES {
        const node = codemap.*.drawn[at]
        if wantsLabel(codemap, node) {
            codemap.*.labelKeys[count] = (labelPriority(codemap, node) << 24) | @intCast(u64, node)
            count += 1
        }
        at += 1
    }
    sortLabelKeys(codemap, count)
    const small = access_module.smallOf(codemap)
    const right_edge = if access_module.detailOpen(codemap) { filters_module.detailX(codemap) } else { access_module.surfaceWidth(codemap) }
    const bottom = access_module.surfaceHeight(codemap) - app.STATUS
    at = 0
    while at < count && codemap.*.labelCount < app.MAX_LABELS {
        const node = @intCast(u32, codemap.*.labelKeys[at] & 16777215)
        const index = @intCast(usize, node)
        const radius = shownRadius(codemap, node)
        const x = app.SIDEBAR + @intCast(i32, m.toInt(codemap.*.seenX[index] + radius)) + 5
        const y = app.TOOLBAR + @intCast(i32, m.toInt(codemap.*.seenY[index])) - 8
        const width = text_module.measure(small, access_module.nameOf(codemap, node))
        var fits = x >= app.SIDEBAR && y >= app.TOOLBAR && x + width < right_edge && y + 16 < bottom
        var other: usize = 0
        while fits && other < codemap.*.labelCount {
            const ox = codemap.*.labelX[other]
            const oy = codemap.*.labelY[other]
            if x < ox + codemap.*.labelWidth[other] + 6 && ox < x + width + 6 && y < oy + 16 && oy < y + 16 { fits = false }
            other += 1
        }
        if fits {
            codemap.*.labelNodes[codemap.*.labelCount] = node
            codemap.*.labelX[codemap.*.labelCount] = x
            codemap.*.labelY[codemap.*.labelCount] = y
            codemap.*.labelWidth[codemap.*.labelCount] = width
            codemap.*.labelCount += 1
        }
        at += 1
    }
}

pub fn drawLabels(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const small = access_module.smallOf(codemap)
    var at: usize = 0
    while at < codemap.*.labelCount {
        const node = codemap.*.labelNodes[at]
        const record = access_module.nodeOf(codemap, node)
        const x = codemap.*.labelX[at]
        const y = codemap.*.labelY[at]
        var color = if record.*.kind == graph_module.DECLARATION { canvas_module.color(255, 200, 206, 218) } else { app.TEXT_COLOR }
        if node == codemap.*.selected { color = canvas_module.color(255, 255, 255, 255) }
        const related = codemap.*.related[@intCast(usize, node)]
        if related & 1 != 0 { color = filters_module.canvasColor(app.OUTGOING, 255) } else if related & 2 != 0 { color = filters_module.canvasColor(app.INCOMING, 255) }
        text_module.drawText(canvas, small, access_module.nameOf(codemap, node), x + 1, y + 1, canvas_module.color(170, 0, 0, 0), 0)
        text_module.drawText(canvas, small, access_module.nameOf(codemap, node), x, y, color, 0)
        at += 1
    }
}
