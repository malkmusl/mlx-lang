// Run and Profile, rewriting workarounds, their history, profiling (part of main.mlx, split from it).
const std = @import("std")
const apps_module = @import("../desktop/shared/apps.mlx")
const canvas_module = @import("std.ui.canvas")
const glyphs = @import("std.ui.glyphs")
const popup = @import("std.ui.popup")
const ui = @import("std.ui")
const text_module = @import("std.ui.text")
const panel_module = @import("std.ui.wayland.panel")
const crash = @import("std.crash")
const index_module = @import("../../tools/codemap/index.mlx")
const workarounds_module = @import("../../tools/codemap/workarounds.mlx")
const programs_module = @import("../../tools/codemap/programs.mlx")
const binaries_module = @import("../../tools/codemap/binaries.mlx")
const git_module = @import("../../tools/codemap/git.mlx")
const trend_module = @import("../../tools/codemap/trend.mlx")
const rewrite_module = @import("../../tools/codemap/rewrite.mlx")
const check_module = @import("../../tools/mlx-lsp/check.mlx")
const run_module = @import("./run.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const navigation_module = @import("./navigation.mlx")
const lists_module = @import("./lists.mlx")
const drawing_module = @import("./drawing.mlx")
const detail_module = @import("./detail.mlx")
const project_module = @import("./project.mlx")

// ---------------------------------------------------------------------------
// Run and Profile (run.mlx): the built program started from here

pub fn runOf(codemap: *app.Codemap) -> *run_module.Run {
    unsafe { return @ptrFromInt(*run_module.Run, @intFromPtr(codemap) + @offsetOf(app.Codemap, "run")) }
}

// Build, or build and then run or profile (the button does it next time
// too).
pub fn startAction(codemap: *app.Codemap, action: u8) -> void {
    codemap.*.runAction = action
    if action == app.ACTION_BUILD {
        codemap.*.afterBuild = app.ACTION_NONE
        project_module.startBuild(codemap)
        return
    }
    if runOf(codemap).*.running {
        access_module.setNote(codemap, access_module.say(codemap, "Still running: F5 or the button stops it", "Läuft noch: F5 oder der Knopf beendet es"), "")
        return
    }
    if access_module.buildOf(codemap).*.running {
        codemap.*.afterBuild = action
        return
    }
    codemap.*.afterBuild = action
    project_module.startBuild(codemap)
    if !access_module.buildOf(codemap).*.running { codemap.*.afterBuild = app.ACTION_NONE }
}

// Whether `path` (NUL-terminated) is a program that can run.
fn isProgram(path: [*]const u8) -> bool { return std.linux.syscall2(21, @intFromPtr(path), 1) == 0 }

// mlx-profile: the workspace's mlx-out/bin, next to this program, else on
// the PATH (into `into`, NUL-terminated); its length, 0: none.
fn findProfiler(codemap: *app.Codemap, into: [*]u8) -> usize {
    var length = filters_module.writeText(into, 0, access_module.rootText(codemap))
    length = filters_module.writeText(into, length, "/mlx-out/bin/mlx-profile")
    into[length] = 0
    if isProgram(into) { return length }
    const trend = access_module.trendOf(codemap)
    if trend.*.selfLength > 0 {
        const self = trend.*.self[0..trend.*.selfLength]
        var slash = self.length
        while slash > 0 && self[slash - 1] != 47 { slash -= 1 }
        length = filters_module.writeText(into, 0, self[0..slash])
        length = filters_module.writeText(into, length, "mlx-profile")
        into[length] = 0
        if slash > 0 && isProgram(into) { return length }
    }
    const path_pointer = apps_module.environmentValue(codemap.*.environment, "PATH")
    if @intFromPtr(path_pointer) == 0 { return 0 }
    const path_variable = std.text.cString(path_pointer)
    var start: usize = 0
    var at: usize = 0
    while at <= path_variable.length {
        if at == path_variable.length || path_variable[at] == 58 {
            if at > start {
                length = filters_module.writeText(into, 0, path_variable[start..at])
                length = filters_module.writeText(into, length, "/mlx-profile")
                into[length] = 0
                if isProgram(into) { return length }
            }
            start = at + 1
        }
        at += 1
    }
    return 0
}

// The program just built, started (under mlx-profile for Profile).
pub fn launch(codemap: *app.Codemap, action: u8) -> void {
    const build = access_module.buildOf(codemap)
    const target = check_module.targetPath(build)
    const name = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "buildName"))[0..codemap.*.buildNameLength]
    launchProgram(codemap, target, name, action == app.ACTION_PROFILE)
}

fn launchProgram(codemap: *app.Codemap, target: []const u8, name: []const u8, profiled: bool) -> void {
    var profiler: [1200]u8 = undefined
    var profiler_bytes: [*]u8 = undefined
    unsafe { profiler_bytes = @ptrCast([*]u8, &profiler) }
    profiler_bytes[0] = 0
    if profiled && findProfiler(codemap, profiler_bytes) == 0 {
        access_module.setNote(codemap, access_module.say(codemap, "Profile: no mlx-profile (in mlx-out/bin, next to the Observatory or on the PATH; tools/profile builds it)", "Profilieren: kein mlx-profile (in mlx-out/bin, neben dem Observatory oder im PATH; tools/profile baut es)"), "")
        return
    }
    const program = access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "runTarget"))
    const target_length = filters_module.writeText(program, 0, if target.length < 1190 { target } else { target[0..1190] })
    program[target_length] = 0
    codemap.*.runNameLength = app.copyOption(access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "runName")), 0, name, 120)
    var root: [1100]u8 = undefined
    var root_bytes: [*]u8 = undefined
    unsafe { root_bytes = @ptrCast([*]u8, &root) }
    const root_length = filters_module.writeText(root_bytes, 0, access_module.rootText(codemap))
    root_bytes[root_length] = 0
    if !run_module.start(runOf(codemap), root_bytes, program, profiler_bytes, codemap.*.environment, panel_module.milliseconds()) {
        access_module.setNote(codemap, access_module.say(codemap, "The program did not start: ", "Das Programm startete nicht: "), target)
        return
    }
    if codemap.*.trace { navigation_module.traceLine(codemap, if profiled { "profile " } else { "run " }, name) }
    var text: [200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeText(bytes, 0, name)
    length = filters_module.writeText(bytes, length, if profiled { access_module.say(codemap, " runs under mlx-profile (F5 ends it)", " läuft unter mlx-profile (F5 beendet es)") } else { access_module.say(codemap, " runs (F5 ends it)", " läuft (F5 beendet es)") })
    access_module.setNote(codemap, bytes[0..length], "")
    access_module.panelOf(codemap).*.dirty = true
}

fn runName(codemap: *app.Codemap) -> []const u8 { return access_module.fieldBytes(codemap, @offsetOf(app.Codemap, "runName"))[0..codemap.*.runNameLength] }

// Every tick: what the program wrote; when it ended, how.
pub fn pumpRun(codemap: *app.Codemap) -> void {
    const run = runOf(codemap)
    if !run.*.running { return }
    const before = run.*.outputLength
    const ended = run_module.pump(run, panel_module.milliseconds())
    if run.*.outputLength != before && codemap.*.popup == app.POPUP_RUN { access_module.panelOf(codemap).*.dirty = true }
    if ended { finishRun(codemap) }
}

// The program ended: said in the note (a crash with the handler's line);
// the crash log and the profiles are read again at once.
fn finishRun(codemap: *app.Codemap) -> void {
    const run = runOf(codemap)
    const name = runName(codemap)
    var text: [240]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeText(bytes, 0, name)
    const status = run.*.status
    var detail: []const u8 = ""
    if run.*.stopped {
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " stopped", " beendet"))
    } else if status == 0 {
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " ended", " ist fertig"))
    } else {
        // The crash handler's line, else the last line it wrote.
        var starts: [16]usize = undefined
        var ends: [16]usize = undefined
        const lines = run_module.lastLines(run, 16, &starts, &ends)
        const output = run_module.output(run)
        var crashed_line: usize = 16
        var line: usize = 0
        while line < lines {
            if containsBytes(output[starts[line]..ends[line]], ": crashed: ") { crashed_line = line }
            line += 1
        }
        if crashed_line < 16 {
            detail = output[starts[crashed_line]..ends[crashed_line]]
            length = filters_module.writeText(bytes, 0, "")
        } else {
            length = filters_module.writeText(bytes, length, access_module.say(codemap, " exited with ", " endete mit "))
            length = lists_module.writeNumberPlain(bytes, length, @intCast(usize, status))
            if lines > 0 {
                length = filters_module.writeText(bytes, length, ": ")
                detail = output[starts[lines - 1]..ends[lines - 1]]
            }
        }
    }
    if run.*.profiled && status == 0 { length = filters_module.writeText(bytes, length, access_module.say(codemap, "; its profile is read (Color by Run time)", "; sein Profil wird gelesen (Färben nach Laufzeit)")) }
    access_module.setNote(codemap, bytes[0..length], if detail.length > 160 { detail[0..160] } else { detail })
    if codemap.*.trace {
        var number: [32]u8 = undefined
        var number_bytes: [*]u8 = undefined
        unsafe { number_bytes = @ptrCast([*]u8, &number) }
        const number_length = lists_module.writeNumberPlain(number_bytes, 0, @intCast(usize, status))
        navigation_module.traceLine(codemap, "run ended ", number_bytes[0..number_length])
    }
    codemap.*.profilesTime = -2
    codemap.*.crashCheckAt = 0
    access_module.panelOf(codemap).*.dirty = true
}

fn containsBytes(text: []const u8, part: []const u8) -> bool {
    if part.length > text.length { return false }
    var at: usize = 0
    while at + part.length <= text.length {
        if access_module.sameBytes(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

// Build's list: Build, Run (Stop while running), Profile, then the last
// run's output (a heading and its last lines).
pub fn runRows(codemap: *app.Codemap) -> usize {
    const run = runOf(codemap)
    if codemap.*.runNameLength == 0 { return app.RUN_MENU_ROWS }
    var starts: [16]usize = undefined
    var ends: [16]usize = undefined
    return app.RUN_MENU_ROWS + 1 + run_module.lastLines(run, app.RUN_LINES, &starts, &ends)
}

pub fn drawRunRows(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, width: i32) -> void {
    const run = runOf(codemap)
    const running = run.*.running
    const labels = [3][]const u8{ access_module.say(codemap, "Build", "Bauen"), if running { access_module.say(codemap, "Stop", "Beenden") } else { access_module.say(codemap, "Run", "Starten") }, access_module.say(codemap, "Profile", "Profilieren") }
    const keys = [3][]const u8{ access_module.say(codemap, "Ctrl+B", "Strg+B"), "F5", access_module.say(codemap, "Ctrl+F5", "Strg+F5") }
    const english = [3][]const u8{ "into mlx-out/bin", "build, then start it", "build, then run it under mlx-profile" }
    const german = [3][]const u8{ "nach mlx-out/bin", "bauen, dann starten", "bauen, dann unter mlx-profile starten" }
    var row: usize = 0
    while row < app.RUN_MENU_ROWS {
        const y = codemap.*.popupRowTop + @intCast(i32, row) * app.POPUP_ROW
        const chosen = popup.row(access_module.uiOf(codemap), access_module.idOf(app.HIT_POPUP_ROW + row), ui.rect(x + 6, y, width - 12, app.POPUP_ROW), false)
        if row == 1 && running {
            canvas_module.fillRect(canvas, x + 16, y + 8, 9, 9, filters_module.canvasColor(app.CRASH_COLOR, 255))
        } else {
            project_module.drawPlay(canvas, x + 17, y + 7, @intCast(u8, row))
        }
        text_module.drawText(canvas, access_module.bodyOf(codemap), labels[row], x + 34, y + 5, app.TEXT_COLOR, 110)
        text_module.drawText(canvas, access_module.smallOf(codemap), if codemap.*.german { german[row] } else { english[row] }, x + 146, y + 7, app.DIM_COLOR, width - 250)
        text_module.drawText(canvas, access_module.smallOf(codemap), keys[row], x + width - 16 - text_module.measure(access_module.smallOf(codemap), keys[row]), y + 7, app.DIM_COLOR, 0)
        // What the button does now.
        if @intCast(u8, row) == codemap.*.runAction { glyphs.dot(canvas, x + width - 94, y + 13, 6, app.ACCENT) }
        row += 1
    }
    if codemap.*.runNameLength == 0 { return }
    // The heading: the program and how it is.
    const heading_y = codemap.*.popupRowTop + @intCast(i32, app.RUN_MENU_ROWS) * app.POPUP_ROW
    canvas_module.fillRect(canvas, x + 12, heading_y + 2, width - 24, 1, canvas_module.color(255, 58, 62, 76))
    var text: [200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeText(bytes, 0, runName(codemap))
    if running {
        length = filters_module.writeText(bytes, length, if run.*.profiled { access_module.say(codemap, ": profiling", ": wird profiliert") } else { access_module.say(codemap, ": running", ": läuft") })
    } else if run.*.stopped {
        length = filters_module.writeText(bytes, length, access_module.say(codemap, ": stopped", ": beendet"))
    } else {
        length = filters_module.writeText(bytes, length, access_module.say(codemap, ": ended with ", ": endete mit "))
        length = lists_module.writeNumberPlain(bytes, length, @intCast(usize, if run.*.status < 0 { 0 } else { run.*.status }))
    }
    text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 16, heading_y + 8, if !running && run.*.status != 0 && !run.*.stopped { filters_module.canvasColor(app.CRASH_COLOR, 255) } else { app.DIM_COLOR }, width - 32)
    var starts: [16]usize = undefined
    var ends: [16]usize = undefined
    const lines = run_module.lastLines(run, app.RUN_LINES, &starts, &ends)
    const output = run_module.output(run)
    var line: usize = 0
    while line < lines {
        const y = heading_y + app.POPUP_ROW + @intCast(i32, line) * app.POPUP_ROW
        const shown = output[starts[line]..ends[line]]
        const crashed = containsBytes(shown, ": crashed: ")
        text_module.drawText(canvas, access_module.monoOf(codemap), shown, x + 16, y + 5, if crashed { filters_module.canvasColor(app.CRASH_COLOR, 255) } else { filters_module.canvasColor(app.TEXT_COLOR, 200) }, width - 32)
        line += 1
    }
}

// ---------------------------------------------------------------------------
// Rewriting workarounds away (tools/codemap/rewrite.mlx)

pub fn planRewrite(codemap: *app.Codemap, pattern: u8) -> void {
    if !codemap.*.rewriteReady {
        rewrite_module.init(rewriteEditsOf(codemap), codemap.*.allocator)
        codemap.*.rewriteReady = true
    }
    const edits = rewriteEditsOf(codemap)
    rewrite_module.plan(edits, access_module.workaroundsOf(codemap), codemap.*.index, pattern, "")
    codemap.*.rewriteAccepted = edits.*.count > 0 && rewrite_module.compilerAccepts(access_module.gitOf(codemap), pattern)
    codemap.*.rewritePattern = pattern
    codemap.*.detailScroll = 0
    if codemap.*.trace {
        var text: [96]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = lists_module.writeNumberPlain(bytes, 0, edits.*.count)
        length = filters_module.writeText(bytes, length, " edits, ")
        length = filters_module.writeText(bytes, length, if codemap.*.rewriteAccepted { "accepted" } else { "not accepted" })
        navigation_module.traceLine(codemap, "rewrite planned: ", bytes[0..length])
    }
}

pub fn rewriteEditsOf(codemap: *app.Codemap) -> *rewrite_module.Edits {
    unsafe { return @ptrCast(*rewrite_module.Edits, &codemap.*.rewriteEdits) }
}

// Writes the rewrites and reads the code again.
pub fn applyRewrite(codemap: *app.Codemap) -> void {
    if codemap.*.rewritePattern == 255 || !codemap.*.rewriteAccepted { return }
    const edits = rewriteEditsOf(codemap)
    const count = edits.*.count
    const written = rewrite_module.apply(edits, codemap.*.index)
    codemap.*.rewritePattern = 255
    var text: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = lists_module.writeNumberPlain(bytes, 0, count)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " places rewritten in ", " Stellen umgeschrieben in "))
    length = lists_module.writeNumberPlain(bytes, length, written)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " files", " Dateien"))
    if codemap.*.trace { navigation_module.traceLine(codemap, "rewritten: ", bytes[0..length]) }
    navigation_module.reload(codemap)
    access_module.setNote(codemap, bytes[0..length], "")
}

// The line around bytes start..end of `source` with `instead` in their
// place, from its first non-blank byte on (into `into`).
fn editedLine(source: []const u8, start: usize, end: usize, instead: []const u8, into: [*]u8) -> usize {
    var first = start
    while first > 0 && source[first - 1] != 10 { first -= 1 }
    while first < start && (source[first] == 32 || source[first] == 9) { first += 1 }
    var last = end
    while last < source.length && source[last] != 10 { last += 1 }
    var length = filters_module.writeText(into, 0, source[first..start])
    if length + instead.length < 900 { length = filters_module.writeText(into, length, instead) }
    const rest = source[end..last]
    return filters_module.writeText(into, length, if rest.length > 400 { rest[0..400] } else { rest })
}

// The rewrites of one kind: each line before and after, and whether the
// compiler takes them; Apply writes them.
pub fn drawRewrite(codemap: *app.Codemap, canvas: *app.Canvas) -> void {
    const left = filters_module.detailX(codemap)
    const height = access_module.viewHeight(codemap)
    canvas_module.fillRect(canvas, left, app.TOOLBAR, app.DETAIL, height, canvas_module.color(232, 25, 27, 34))
    canvas_module.fillRect(canvas, left, app.TOOLBAR, 1, height, canvas_module.color(255, 46, 49, 60))
    const x = left + 20
    const width = app.DETAIL - 40
    var y = app.TOOLBAR + 18 - codemap.*.detailScroll
    const bottom = access_module.surfaceHeight(codemap) - app.STATUS
    const pattern = codemap.*.rewritePattern
    const edits = rewriteEditsOf(codemap)
    const index = codemap.*.index
    var text: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Rewrite: ", "Umschreiben: "))
    length = filters_module.writeText(bytes, length, workarounds_module.shortTitle(pattern, codemap.*.german))
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.titleOf(codemap), x, y, width - 100, app.TEXT_COLOR, 2, 22)
    y += 4
    length = filters_module.writeNumber(codemap, bytes, 0, edits.*.count)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " places in ", " Stellen in "))
    length = filters_module.writeNumber(codemap, bytes, length, rewrite_module.fileCount(edits))
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " files. ", " Dateien. "))
    if pattern == workarounds_module.DROPPED { length = filters_module.writeText(bytes, length, access_module.say(codemap, "A constant bound only to drop a result becomes _ = ... ", "Eine Konstante, die nur ein Ergebnis verwirft, wird zu _ = ... ")) }
    if pattern == workarounds_module.COUNTED { length = filters_module.writeText(bytes, length, access_module.say(codemap, "A loop counting a slice's bytes becomes its .length. ", "Eine Schleife, die die Bytes eines Slices zählt, wird zu seiner .length. ")) }
    length = filters_module.writeText(bytes, length, access_module.say(codemap, "compiler/, std/bootstrap/ and tests/ stay as they are.", "compiler/, std/bootstrap/ und tests/ bleiben, wie sie sind."))
    y += detail_module.drawWrapped(codemap, canvas, bytes[0..length], access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 6, 17)
    y += 6
    if codemap.*.rewriteAccepted {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "The compiler takes the result: Apply writes the files and reads the code again.", "Der Compiler nimmt das Ergebnis: Anwenden schreibt die Dateien und liest den Code neu ein."), access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.CHANGED_COLOR, 255), 3, 17)
    } else if edits.*.count > 0 {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "The compiler does not take the result yet: nothing can be written.", "Der Compiler nimmt das Ergebnis noch nicht: es kann nichts geschrieben werden."), access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.CRASH_COLOR, 255), 3, 17)
    }
    y += 10
    const apply_width = detail_module.detailButton(codemap, canvas, access_module.say(codemap, "Apply", "Anwenden"), x, y, 0, app.ROW_APPLY, true, codemap.*.rewriteAccepted)
    const back_width = detail_module.detailButton(codemap, canvas, access_module.say(codemap, "Back", "Zurück"), x + apply_width + 8, y, 0, app.ROW_BACK, false, true)
    y += app.DETAIL_ROW + 14
    var edit: usize = 0
    const most: usize = if codemap.*.expanded[0] { edits.*.count } else { 150 }
    while edit < edits.*.count && edit < most {
        const file = edits.*.file[edit]
        const source = index_module.sourceOf(index, file)
        const start = @intCast(usize, edits.*.start[edit])
        const end = @intCast(usize, edits.*.end[edit])
        if y > app.TOOLBAR - 60 && y < bottom {
            length = filters_module.writeText(bytes, 0, programs_module.relativePath(index, file))
            length = filters_module.writeText(bytes, length, ":")
            length = filters_module.writeNumber(codemap, bytes, length, index_module.lineOf(index, file, start) + 1)
            text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x, y, app.DIM_COLOR, width)
            length = editedLine(source, start, end, source[start..end], bytes)
            text_module.drawText(canvas, access_module.smallOf(codemap), "-", x, y + 17, filters_module.canvasColor(app.CRASH_COLOR, 255), 0)
            text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 12, y + 17, canvas_module.color(255, 200, 150, 150), width - 12)
            length = editedLine(source, start, end, rewrite_module.replacement(edits, edit), bytes)
            text_module.drawText(canvas, access_module.smallOf(codemap), "+", x, y + 34, filters_module.canvasColor(app.CHANGED_COLOR, 255), 0)
            text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 12, y + 34, filters_module.canvasColor(app.CHANGED_COLOR, 255), width - 12)
        }
        y += 58
        edit += 1
    }
    if edit < edits.*.count {
        detail_module.addDetailRow(codemap, y, 0, app.ROW_MORE)
        length = filters_module.writeText(bytes, 0, "+ ")
        length = filters_module.writeNumber(codemap, bytes, length, edits.*.count - edit)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " more", " weitere"))
        if y > app.TOOLBAR && y < bottom { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x + 22, y + 5, app.ACCENT, 0) }
        y += app.DETAIL_ROW
    }
    codemap.*.detailHeight = y + codemap.*.detailScroll - app.TOOLBAR + 20
    detail_module.drawCloseButton(codemap, canvas)
}

// ---------------------------------------------------------------------------
// The workarounds over the last commits, and counting them

// A bar per commit counted (all kinds together), and what is left to
// count (a button starts it; it runs in the background).
pub fn drawTrend(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32, bottom: i32) -> i32 {
    const trend = access_module.trendOf(codemap)
    var y = top
    var text: [160]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var known: usize = 0
    var first_total: u32 = 0
    var last_total: u32 = 0
    var commit: usize = 0
    while commit < trend.*.count {
        if trend_module.isKnown(trend, commit) {
            if known == 0 { first_total = trend_module.totalOf(trend, commit) }
            last_total = trend_module.totalOf(trend, commit)
            known += 1
        }
        commit += 1
    }
    if known >= 2 {
        var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Over the last ", "Über die letzten "))
        length = filters_module.writeNumber(codemap, bytes, length, known)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " commits: ", " Commits: "))
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, first_total))
        length = filters_module.writeText(bytes, length, " -> ")
        length = filters_module.writeNumber(codemap, bytes, length, @intCast(usize, last_total))
        if y > app.TOOLBAR && y < bottom { text_module.drawText(canvas, access_module.smallOf(codemap), bytes[0..length], x, y, app.TEXT_COLOR, width) }
        y += 20
        const most = trend_module.most(trend, workarounds_module.PATTERNS)
        const least = trend_module.least(trend, workarounds_module.PATTERNS)
        const chart: i32 = 44
        var bar = width / @intCast(i32, known)
        if bar > 18 { bar = 18 }
        if bar < 2 { bar = 2 }
        var left = x
        commit = 0
        while commit < trend.*.count {
            if trend_module.isKnown(trend, commit) {
                const value = trend_module.totalOf(trend, commit)
                var high: i32 = chart / 2
                if most > least { high = 4 + @intCast(i32, (value - least) * @intCast(u32, chart - 4) / (most - least)) }
                if y > app.TOOLBAR && y + chart < bottom { canvas_module.fillRect(canvas, left, y + chart - high, bar - (if bar > 3 { 1 } else { 0 }), high, filters_module.canvasColor(app.WORKAROUND_COLOR, 210)) }
                left += bar
            }
            commit += 1
        }
        y += chart + 10
    }
    const missing = trend_module.missing(trend)
    if codemap.*.historyJob > 0 {
        if y > app.TOOLBAR && y < bottom { text_module.drawText(canvas, access_module.smallOf(codemap), access_module.say(codemap, "Counting the commits in the background ...", "Die Commits werden im Hintergrund gezählt ..."), x, y + 4, app.DIM_COLOR, width) }
        y += app.DETAIL_ROW + 6
    } else if missing > 0 && trend.*.count > 1 {
        var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Count the history (", "Verlauf zählen ("))
        length = filters_module.writeNumber(codemap, bytes, length, missing)
        length = filters_module.writeText(bytes, length, access_module.say(codemap, " commits)", " Commits)"))
        const button = detail_module.detailButton(codemap, canvas, bytes[0..length], x, y, 0, app.ROW_HISTORY, false, true)
        y += app.DETAIL_ROW + 10
    }
    return y
}

// Counts the workarounds of the commits not counted yet: this program's
// command line (mlx-codemap -C ROOT history 20) in the background.
pub fn countHistory(codemap: *app.Codemap) -> void {
    if codemap.*.historyJob > 0 { return }
    const trend = access_module.trendOf(codemap)
    if trend.*.selfLength == 0 { return }
    const git = access_module.gitOf(codemap)
    git_module.beginShell(git)
    git_module.more(git, "exec ")
    git_module.addQuoted(git, trend.*.self[0..trend.*.selfLength])
    git_module.more(git, " -C ")
    git_module.addQuoted(git, access_module.rootText(codemap))
    git_module.more(git, " history 20")
    codemap.*.historyJob = git_module.spawn(git)
    if codemap.*.trace { navigation_module.traceLine(codemap, "counting the history", "") }
}

// ---------------------------------------------------------------------------
// Profiling the program shown (mlx-profile, tools/profile)

pub fn drawProfileBlock(codemap: *app.Codemap, canvas: *app.Canvas, x: i32, top: i32, width: i32) -> i32 {
    var y = top
    var text: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    const programs = access_module.programsOf(codemap)
    const binaries = access_module.binariesOf(codemap)
    if runOf(codemap).*.running && runOf(codemap).*.profiled {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "The program runs under mlx-profile: ending it writes its profile, read here then.", "Das Programm läuft unter mlx-profile: wird es beendet, schreibt es sein Profil, das dann hier gelesen wird."), access_module.smallOf(codemap), x, y, width, filters_module.canvasColor(app.HOT_COLOR, 255), 3, 17)
        return y + 10
    }
    if !access_module.programChosen(codemap) || binaries_module.binaryOf(binaries, codemap.*.program) >= binaries.*.count {
        y += detail_module.drawWrapped(codemap, canvas, access_module.say(codemap, "Choose a built program under Program to run it under mlx-profile.", "Wähle unter Programm ein gebautes Programm, um es unter mlx-profile laufen zu lassen."), access_module.smallOf(codemap), x, y, width, app.DIM_COLOR, 3, 17)
        return y + 10
    }
    var length = filters_module.writeText(bytes, 0, access_module.say(codemap, "Profile ", "Profilieren: "))
    length = filters_module.writeText(bytes, length, programs_module.nameOf(programs, codemap.*.program))
    const button = detail_module.detailButton(codemap, canvas, bytes[0..length], x, y, 0, app.ROW_PROFILE, true, true)
    return y + app.DETAIL_ROW + 12
}

// Runs the program shown under mlx-profile (as Profile does, without
// building it first).
pub fn startProfile(codemap: *app.Codemap) -> void {
    if runOf(codemap).*.running || !access_module.programChosen(codemap) { return }
    const binaries = access_module.binariesOf(codemap)
    const binary = binaries_module.binaryOf(binaries, codemap.*.program)
    if binary >= binaries.*.count { return }
    launchProgram(codemap, binaries_module.pathOf(binaries, binary), programs_module.nameOf(access_module.programsOf(codemap), codemap.*.program), true)
}
