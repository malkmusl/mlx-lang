// ---------------------------------------------------------------------------
// Access

pub fn codemapOf(context: *anyopaque) -> *app.Codemap {
    unsafe { return @ptrCast(*app.Codemap, context) }
}

pub fn panelOf(codemap: *app.Codemap) -> *app.Panel {
    unsafe { return @ptrCast(*app.Panel, &codemap.*.panel) }
}

