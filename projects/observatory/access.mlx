    unsafe { return @ptrCast(*scene_module.Scene, &codemap.*.scene) }
}

pub fn cameraOf(codemap: *app.Codemap) -> *m.Camera {
    unsafe { return @ptrCast(*m.Camera, &codemap.*.camera) }
}

pub fn relationsOf(codemap: *app.Codemap) -> *graph_module.Relations {
    unsafe { return @ptrCast(*graph_module.Relations, &codemap.*.relations) }
}

pub fn bodyOf(codemap: *app.Codemap) -> *app.Text {
    unsafe { return @ptrCast(*app.Text, &codemap.*.body) }
}

pub fn smallOf(codemap: *app.Codemap) -> *app.Text {
    unsafe { return @ptrCast(*app.Text, &codemap.*.small) }
}

pub fn monoOf(codemap: *app.Codemap) -> *app.Text {
