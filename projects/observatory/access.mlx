pub fn checkOf(codemap: *app.Codemap) -> *check_module.Check {
    unsafe { return @ptrCast(*check_module.Check, &codemap.*.check) }
}

pub fn buildOf(codemap: *app.Codemap) -> *check_module.Check {
    unsafe { return @ptrCast(*check_module.Check, &codemap.*.build) }
}

// The compiler's problems come from the last check (0) and the last build
// (1).
pub fn problemsOf(codemap: *app.Codemap, source: usize) -> *check_module.Check {
    return if source == 0 { checkOf(codemap) } else { buildOf(codemap) }
}

pub fn editorAt(codemap: *app.Codemap, tab: usize) -> *editor_module.Editor {
    unsafe { return @ptrFromInt(*editor_module.Editor, @intFromPtr(&codemap.*.editors) + tab * @sizeOf(editor_module.Editor)) }
}

pub fn uiOf(codemap: *app.Codemap) -> *view.Ui {
    unsafe { return @ptrCast(*view.Ui, &codemap.*.ui) }
}

pub fn themeOf(codemap: *app.Codemap) -> *theme_module.Theme {
    unsafe { return @ptrCast(*theme_module.Theme, &codemap.*.theme) }
}

pub fn commitOf(codemap: *app.Codemap) -> *field.Field {
    unsafe { return @ptrCast(*field.Field, &codemap.*.commit) }
}

pub fn editorBarOf(codemap: *app.Codemap) -> *scroll.Scroll {
    unsafe { return @ptrCast(*scroll.Scroll, &codemap.*.editorBar) }
}

pub fn searchOf(codemap: *app.Codemap) -> *field.Field {
    unsafe { return @ptrCast(*field.Field, &codemap.*.search) }
}

pub fn newBranchOf(codemap: *app.Codemap) -> *field.Field {
    unsafe { return @ptrCast(*field.Field, &codemap.*.newBranch) }
}

// The modifiers held as std.ui.keys has them.
pub fn uiModifiers(codemap: *app.Codemap) -> u32 {
    const held = modifiers(codemap)
    var result: u32 = 0
    if held & app.SHIFT != 0 { result |= keys.SHIFT }
    if held & app.CONTROL != 0 { result |= keys.CONTROL }
    if held & app.ALT != 0 { result |= keys.ALT }
    return result
}

// What the last key typed.
pub fn typedText(codemap: *app.Codemap) -> []const u8 { return panel_module.textOf(panelOf(codemap)) }

// A key for a text field of the app's.
pub fn fieldKey(codemap: *app.Codemap, text_field: *field.Field, key: u32) -> u8 {
    return field.fieldKey(text_field, key, uiModifiers(codemap), typedText(codemap))
}

// A hit code as a widget id (hit codes start at 0; ids at 1).
pub fn idOf(hit: usize) -> u64 { return if hit == app.HIT_NONE { view.NONE } else { @intCast(u64, hit) + 1 } }

// The hit code a widget id stands for.
pub fn hitOfId(widget: u64) -> usize { return if widget == view.NONE { app.HIT_NONE } else { @intCast(usize, widget - 1) } }

pub fn titleOf(codemap: *app.Codemap) -> *app.Text {
    unsafe { return @ptrCast(*app.Text, &codemap.*.title) }
}

pub fn fieldBytes(codemap: *app.Codemap, field: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(codemap) + field) }
}

pub fn rootText(codemap: *app.Codemap) -> []const u8 { return fieldBytes(codemap, @offsetOf(app.Codemap, "root"))[0..codemap.*.rootLength] }
pub fn searchText(codemap: *app.Codemap) -> []const u8 { return field.text(searchOf(codemap)) }
pub fn noteText(codemap: *app.Codemap) -> []const u8 { return fieldBytes(codemap, @offsetOf(app.Codemap, "note"))[0..codemap.*.noteLength] }

pub fn nodeOf(codemap: *app.Codemap, node: u32) -> *graph_module.Node { return graph_module.nodeAt(graphOf(codemap), node) }
pub fn nameOf(codemap: *app.Codemap, node: u32) -> []const u8 { return graph_module.nameOf(graphOf(codemap), node) }

pub fn say(codemap: *app.Codemap, english: []const u8, german: []const u8) -> []const u8 {
    return if codemap.*.german { german } else { english }
}

pub fn sameBytes(first: []const u8, second: []const u8) -> bool { return index_module.sameBytes(first, second) }

// Held modifiers; not Ctrl and Alt for a key that types its third level
// (AltGr, or Ctrl+Alt standing in for it: @, {, [ on a German keyboard).
pub fn modifiers(codemap: *app.Codemap) -> u32 {
    const panel = panelOf(codemap)
    const held = panel.*.keyboard.depressed | codemap.*.held
    if panel.*.keyboard.levelThree && panel.*.textLength > 0 { return held & ~(app.CONTROL | app.ALT) }
    return held
}

// Modifier keys as they go down and up (a compositor may send their state
// late or not at all to a window that just got the keyboard).
pub fn trackModifier(codemap: *app.Codemap, code: u32, pressed: bool) -> void {
    var bit: u32 = 0
    if code == app.KEY_LEFT_SHIFT || code == app.KEY_RIGHT_SHIFT { bit = app.SHIFT }
    if code == app.KEY_LEFT_CONTROL || code == app.KEY_RIGHT_CONTROL { bit = app.CONTROL }
    if code == app.KEY_LEFT_ALT || code == app.KEY_RIGHT_ALT { bit = app.ALT }
    if bit == 0 { return }
    codemap.*.held = if pressed { codemap.*.held | bit } else { codemap.*.held & ~bit }
}

pub fn setNote(codemap: *app.Codemap, first: []const u8, second: []const u8) -> void {
    codemap.*.noteLength = 0
    for byte in first {
        if codemap.*.noteLength < 160 {
            codemap.*.note[codemap.*.noteLength] = byte
            codemap.*.noteLength += 1
        }
    }
    for byte in second {
        if codemap.*.noteLength < 160 {
            codemap.*.note[codemap.*.noteLength] = byte
            codemap.*.noteLength += 1
        }
    }
    codemap.*.noteUntil = panel_module.milliseconds() + 4000
}

pub fn surfaceWidth(codemap: *app.Codemap) -> i32 { return @intCast(i32, panelOf(codemap).*.width) }
pub fn surfaceHeight(codemap: *app.Codemap) -> i32 { return @intCast(i32, panelOf(codemap).*.height) }
pub fn viewWidth(codemap: *app.Codemap) -> i32 { return surfaceWidth(codemap) - app.SIDEBAR }
pub fn viewHeight(codemap: *app.Codemap) -> i32 { return surfaceHeight(codemap) - app.TOOLBAR - app.STATUS }
pub fn detailOpen(codemap: *app.Codemap) -> bool { return codemap.*.built && (codemap.*.selected != app.NONE || codemap.*.finding != app.FINDING_NONE || codemap.*.rewritePattern != 255) }

pub fn analysisOf(codemap: *app.Codemap) -> *analysis_module.Analysis {
    unsafe { return @ptrCast(*analysis_module.Analysis, &codemap.*.analysis) }
}

pub fn crashesOf(codemap: *app.Codemap) -> *crashes_module.Crashes {
    unsafe { return @ptrCast(*crashes_module.Crashes, &codemap.*.crashes) }
}

pub fn workaroundsOf(codemap: *app.Codemap) -> *workarounds_module.Workarounds {
    unsafe { return @ptrCast(*workarounds_module.Workarounds, &codemap.*.workarounds) }
}

pub fn findingColor(finding: u8) -> u32 {
    if finding == app.FINDING_WORKAROUNDS { return app.WORKAROUND_COLOR }
    if finding == app.FINDING_CRASHES { return app.CRASH_COLOR }
    if finding == app.FINDING_UNREACHABLE { return app.UNREACHABLE_COLOR }
    if finding == app.FINDING_UNTESTED { return app.UNTESTED_COLOR }
    if finding == app.FINDING_COMPLEX { return app.COMPLEX_COLOR }
    if finding == app.FINDING_STRUCTURE { return app.STRUCTURE_COLOR }
    if finding == app.FINDING_RISKY { return app.RISKY_COLOR }
    if finding == app.FINDING_HOT { return app.HOT_COLOR }
    if finding == app.FINDING_CHANGED { return app.CHANGED_COLOR }
    return app.FINDING_COLOR
}

// The glow of a node marked by several findings: the most telling one.
pub fn markColor(bits: u16) -> u32 {
    if bits & 512 != 0 { return app.RISKY_COLOR }
    if bits & 1024 != 0 { return app.HOT_COLOR }
    if bits & 2048 != 0 { return app.CHANGED_COLOR }
    if bits & 128 != 0 { return app.COMPLEX_COLOR }
    if bits & 64 != 0 { return app.UNTESTED_COLOR }
    if bits & 32 != 0 { return app.UNREACHABLE_COLOR }
    if bits & 256 != 0 { return app.STRUCTURE_COLOR }
    if bits & 8 != 0 { return app.WORKAROUND_COLOR }
    return app.FINDING_COLOR
}

