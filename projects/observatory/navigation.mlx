// Reading the code, the camera, selecting and searching (part of main.mlx, split from it).
const std = @import("std")
const panel_module = @import("../desktop/shared/panel.mlx")
const crash = @import("std.crash")
const index_module = @import("../../tools/codemap/index.mlx")
const analysis_module = @import("../../tools/codemap/analysis.mlx")
const workarounds_module = @import("../../tools/codemap/workarounds.mlx")
const query_module = @import("../../tools/codemap/query.mlx")
const views_module = @import("../../tools/codemap/views.mlx")
const editor_module = @import("./editor.mlx")
const graph_module = @import("./graph.mlx")
const m = @import("./math3d.mlx")
const app = @import("./main.mlx")
const access_module = @import("./access.mlx")
const filters_module = @import("./filters.mlx")
const lists_module = @import("./lists.mlx")
const tabs_module = @import("./tabs.mlx")

// ---------------------------------------------------------------------------
// Reading the code

pub fn buildIndex(codemap: *app.Codemap) -> void {
    const started = panel_module.milliseconds()
    const root = access_module.rootText(codemap)
    if !codemap.*.hasIndex {
        codemap.*.index = index_module.create(root)
        codemap.*.hasIndex = true
    } else {
        index_module.reset(codemap.*.index, root)
    }
    index_module.addTree(codemap.*.index, root)
    var disk_count: usize = 0
    codemap.*.diskStamp = tabs_module.readDiskStamp(codemap, &disk_count)
    codemap.*.diskCount = disk_count
    codemap.*.diskSeenStamp = codemap.*.diskStamp
    codemap.*.diskSeenCount = disk_count
    index_module.build(codemap.*.index)
    codemap.*.builtSymbols = codemap.*.index.*.symbolCount
    graph_module.build(access_module.graphOf(codemap), codemap.*.index, root)
    analysis_module.run(access_module.analysisOf(codemap), codemap.*.index)
    workarounds_module.run(access_module.workaroundsOf(codemap), codemap.*.index)
    access_module.loadCrashes(codemap)
    var patterns: [9]u8 = undefined
    var pattern_bytes: [*]u8 = undefined
    unsafe { pattern_bytes = @ptrCast([*]u8, &patterns) }
    codemap.*.patternCount = workarounds_module.ranked(access_module.workaroundsOf(codemap), pattern_bytes)
    var pattern: usize = 0
    while pattern < codemap.*.patternCount {
        codemap.*.patternOrder[pattern] = patterns[pattern]
        pattern += 1
    }
    access_module.measureAll(codemap)
    codemap.*.built = true
    access_module.computeMetric(codemap)
    filters_module.refreshVisibility(codemap)
    codemap.*.buildMilliseconds = panel_module.milliseconds() - started
    if codemap.*.trace {
        var text: [96]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = lists_module.writeNumberPlain(bytes, 0, codemap.*.index.*.fileCount)
        length = filters_module.writeText(bytes, length, " files, ")
        length = lists_module.writeNumberPlain(bytes, length, access_module.graphOf(codemap).*.count)
        length = filters_module.writeText(bytes, length, " nodes, ")
        length = lists_module.writeNumberPlain(bytes, length, access_module.graphOf(codemap).*.importCount)
        length = filters_module.writeText(bytes, length, " imports")
        traceLine(codemap, "read ", bytes[0..length])
    }
    var at: usize = 0
    while at < graph_module.MAX_NODES {
        codemap.*.related[at] = 0
        codemap.*.matches[at] = 0
        at += 1
    }
}

// A node's name for finding it again after the code is read again: its
// path in the tree ("projects/desktop/files/main.mlx/Files/scroll").
pub fn keyOf(codemap: *app.Codemap, node: u32, out: [*]u8) -> usize {
    if node == app.NONE { return 0 }
    var chain: [48]u32 = undefined
    var count: usize = 0
    var current = node
    while current != app.NONE && count < 48 {
        chain[count] = current
        count += 1
        current = access_module.nodeOf(codemap, current).*.parent
    }
    var length: usize = 0
    while count > 0 {
        count -= 1
        const name = access_module.nameOf(codemap, chain[count])
        if length + name.length + 1 < 1024 {
            length = filters_module.writeText(out, length, name)
            out[length] = 47
            length += 1
        }
    }
    return length
}

pub fn findKey(codemap: *app.Codemap, key: []const u8) -> u32 {
    if key.length == 0 { return app.NONE }
    var buffer: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var node: usize = 0
    while node < access_module.graphOf(codemap).*.count {
        const length = keyOf(codemap, @intCast(u32, node), bytes)
        if length == key.length && access_module.sameBytes(bytes[0..length], key) { return @intCast(u32, node) }
        node += 1
    }
    return app.NONE
}

// Reads the code again, keeping what is selected and what the camera is on.
pub fn reload(codemap: *app.Codemap) -> void {
    var selected_key: [1024]u8 = undefined
    var focus_key: [1024]u8 = undefined
    var selected_bytes: [*]u8 = undefined
    var focus_bytes: [*]u8 = undefined
    unsafe {
        selected_bytes = @ptrCast([*]u8, &selected_key)
        focus_bytes = @ptrCast([*]u8, &focus_key)
    }
    const selected_length = keyOf(codemap, codemap.*.selected, selected_bytes)
    const focus_length = keyOf(codemap, codemap.*.focus, focus_bytes)
    // What the sidebar left out, by name (the nodes are made again).
    var off_keys: [16384]u8 = undefined
    var off_bytes: [*]u8 = undefined
    unsafe { off_bytes = @ptrCast([*]u8, &off_keys) }
    var off_starts: [33]usize = undefined
    var off_count: usize = 0
    off_starts[0] = 0
    const graph = access_module.graphOf(codemap)
    var node: usize = 0
    while node < graph.*.count && off_count < 32 {
        if codemap.*.off[node] != 0 {
            var key: [1024]u8 = undefined
            var key_bytes: [*]u8 = undefined
            unsafe { key_bytes = @ptrCast([*]u8, &key) }
            const length = keyOf(codemap, @intCast(u32, node), key_bytes)
            if off_starts[off_count] + length <= 16384 {
                var at: usize = 0
                while at < length {
                    off_bytes[off_starts[off_count] + at] = key_bytes[at]
                    at += 1
                }
                off_starts[off_count + 1] = off_starts[off_count] + length
                off_count += 1
            }
        }
        codemap.*.off[node] = 0
        node += 1
    }
    while node < graph.*.count {
        codemap.*.off[node] = 0
        node += 1
    }
    buildIndex(codemap)
    var restored: usize = 0
    while restored < off_count {
        const found = findKey(codemap, off_bytes[off_starts[restored]..off_starts[restored + 1]])
        if found != app.NONE { codemap.*.off[@intCast(usize, found)] = 1 }
        restored += 1
    }
    if off_count > 0 { filters_module.refreshVisibility(codemap) }
    codemap.*.backCount = 0
    codemap.*.forwardCount = 0
    codemap.*.hoverNode = app.NONE
    codemap.*.focus = findKey(codemap, focus_bytes[0..focus_length])
    if codemap.*.focus == app.NONE { codemap.*.focus = access_module.graphOf(codemap).*.root }
    setSelected(codemap, findKey(codemap, selected_bytes[0..selected_length]))
    runSearch(codemap)
    if codemap.*.trace { traceLine(codemap, "read again", "") }
    // The tabs: their files in the new index (the text of one not edited
    // since it was saved is the index's).
    codemap.*.stale = false
    var tab: usize = 0
    while tab < codemap.*.tabCount {
        const editor = access_module.editorAt(codemap, tab)
        codemap.*.tabFile[tab] = tabs_module.fileOfPath(codemap, editor_module.pathOf(editor))
        tabs_module.computeMarks(codemap, tab)
        // The index read the file as the tab has it (unless it is edited).
        codemap.*.tabIndexed[tab] = if editor_module.isDirty(editor) { 18446744073709551615 } else { editor.*.version }
        tab += 1
    }
    var text: [96]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var length = filters_module.writeNumber(codemap, bytes, 0, codemap.*.index.*.fileCount)
    length = filters_module.writeText(bytes, length, access_module.say(codemap, " files read in ", " Dateien gelesen in "))
    length = filters_module.writeNumber(codemap, bytes, length, codemap.*.buildMilliseconds)
    length = filters_module.writeText(bytes, length, " ms")
    access_module.setNote(codemap, bytes[0..length], "")
}

// ---------------------------------------------------------------------------
// The camera

pub fn extentOf(codemap: *app.Codemap, node: u32) -> f64 {
    const record = access_module.nodeOf(codemap, node)
    return m.maximum(record.*.extent, 1.2)
}

// The middle of what a node holds (where the camera looks at it).
pub fn middleOf(codemap: *app.Codemap, node: u32) -> m.Vec {
    const record = access_module.nodeOf(codemap, node)
    return m.vec(record.*.x + record.*.centerX, record.*.y + record.*.centerY, record.*.z + record.*.centerZ)
}

// The time flights go by: the demo's while one plays (a recorded frame
// moves it on by its interval, so flights are smooth however long a
// frame takes to draw), else the clock's.
fn cameraClock(codemap: *app.Codemap) -> usize {
    if codemap.*.demoActive { return codemap.*.demoClock }
    return panel_module.milliseconds()
}

// Flies to `node`: it and what is around it fill the view.
pub fn flyTo(codemap: *app.Codemap, node: u32) -> void {
    if node == app.NONE || !codemap.*.built { return }
    const camera = access_module.cameraOf(codemap)
    codemap.*.fromTarget = camera.*.target
    codemap.*.fromDistance = camera.*.distance
    codemap.*.fromYaw = camera.*.yaw
    codemap.*.fromPitch = camera.*.pitch
    codemap.*.toTarget = middleOf(codemap, node)
    // Small things with some of what is around them.
    const smallest: f64 = if access_module.nodeOf(codemap, node).*.kind == graph_module.DECLARATION { 5.0 } else { 3.0 }
    codemap.*.toDistance = m.maximum(extentOf(codemap, node), smallest) * 2.4
    codemap.*.toYaw = camera.*.yaw + 0.35
    codemap.*.toPitch = m.clamp(camera.*.pitch, -0.9, 0.9)
    // Far apart: out on the way, like a jump.
    const travel = m.length(m.sub(codemap.*.toTarget, codemap.*.fromTarget))
    codemap.*.bump = m.clamp(travel / (codemap.*.fromDistance + codemap.*.toDistance) * 0.6, 0.0, 2.5)
    codemap.*.flyStart = cameraClock(codemap)
    codemap.*.flyDuration = 950
    codemap.*.flying = true
    codemap.*.focus = node
    animate(codemap)
}

pub fn animate(codemap: *app.Codemap) -> void {
    const panel = access_module.panelOf(codemap)
    // The next tick now, not when the slow tick (the crash log's) was due.
    if panel.*.tickInterval != 16 { panel.*.nextTick = 0 }
    panel.*.tickInterval = 16
    panel.*.dirty = true
}

// Where the flight is now.
pub fn advance(codemap: *app.Codemap) -> void {
    if !codemap.*.flying { return }
    const camera = access_module.cameraOf(codemap)
    const now = cameraClock(codemap)
    var t: f64 = 1.0
    if now < codemap.*.flyStart + codemap.*.flyDuration {
        t = m.toFloat(@intCast(i64, now - codemap.*.flyStart)) / m.toFloat(@intCast(i64, codemap.*.flyDuration))
    } else {
        codemap.*.flying = false
    }
    const e = m.ease(t)
    camera.*.target = m.mix(codemap.*.fromTarget, codemap.*.toTarget, e)
    const log_from = m.ln(m.maximum(codemap.*.fromDistance, 0.01))
    const log_to = m.ln(m.maximum(codemap.*.toDistance, 0.01))
    const arc = 1.0 + codemap.*.bump * 4.0 * e * (1.0 - e)
    camera.*.distance = m.exp(log_from + (log_to - log_from) * e) * arc
    camera.*.yaw = codemap.*.fromYaw + (codemap.*.toYaw - codemap.*.fromYaw) * e
    camera.*.pitch = codemap.*.fromPitch + (codemap.*.toPitch - codemap.*.fromPitch) * e
}

fn stopFlying(codemap: *app.Codemap) -> void { codemap.*.flying = false }

pub fn orbit(codemap: *app.Codemap, yaw: f64, pitch: f64) -> void {
    stopFlying(codemap)
    const camera = access_module.cameraOf(codemap)
    camera.*.yaw = camera.*.yaw + yaw
    camera.*.pitch = m.clamp(camera.*.pitch + pitch, -1.45, 1.45)
}

pub fn zoom(codemap: *app.Codemap, factor: f64) -> void {
    stopFlying(codemap)
    const camera = access_module.cameraOf(codemap)
    camera.*.distance = m.clamp(camera.*.distance * factor, 0.3, 200000.0)
}

// Moves what is looked at by (dx, dy) pixels on the screen.
pub fn pan(codemap: *app.Codemap, dx: i32, dy: i32) -> void {
    stopFlying(codemap)
    const camera = access_module.cameraOf(codemap)
    const scale = camera.*.distance / m.maximum(camera.*.focal, 1.0)
    const across = m.scale(camera.*.right, -m.toFloat(@intCast(i64, dx)) * scale)
    const upward = m.scale(camera.*.up, m.toFloat(@intCast(i64, dy)) * scale)
    camera.*.target = m.add(camera.*.target, m.add(across, upward))
}

// ---------------------------------------------------------------------------
// Selecting

pub fn traceLine(codemap: *app.Codemap, first: []const u8, second: []const u8) -> void {
    if !codemap.*.trace { return }
    var line: [1200]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length = filters_module.writeText(bytes, 0, "codemap: ")
    length = filters_module.writeText(bytes, length, first)
    if length + second.length < 1190 { length = filters_module.writeText(bytes, length, second) }
    bytes[length] = 10
    const written = std.io.writeAll(std.io.stdout(), bytes[0..length + 1])
}

pub fn setSelected(codemap: *app.Codemap, node: u32) -> void {
    if codemap.*.trace {
        var key: [1024]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &key) }
        const length = keyOf(codemap, node, bytes)
        traceLine(codemap, "selected ", bytes[0..length])
    }
    codemap.*.selected = node
    codemap.*.detailScroll = 0
    var at: usize = 0
    while at < 12 {
        codemap.*.expanded[at] = false
        at += 1
    }
    const relations = access_module.relationsOf(codemap)
    // Unmark what was related.
    at = 0
    while at < relations.*.outgoingCount {
        codemap.*.related[@intCast(usize, relations.*.outgoing[at].node)] = 0
        at += 1
    }
    at = 0
    while at < relations.*.incomingCount {
        codemap.*.related[@intCast(usize, relations.*.incoming[at].node)] = 0
        at += 1
    }
    graph_module.relate(access_module.graphOf(codemap), node, relations)
    at = 0
    while at < relations.*.outgoingCount {
        codemap.*.related[@intCast(usize, relations.*.outgoing[at].node)] |= 1
        at += 1
    }
    at = 0
    while at < relations.*.incomingCount {
        codemap.*.related[@intCast(usize, relations.*.incoming[at].node)] |= 2
        at += 1
    }
    codemap.*.similarCount = 0
    if node != app.NONE && access_module.nodeOf(codemap, node).*.kind == graph_module.DECLARATION {
        unsafe { codemap.*.similarCount = graph_module.similar(access_module.graphOf(codemap), node, @ptrCast([*]u32, &codemap.*.similarNodes), @ptrCast([*]u32, &codemap.*.similarShares), 12) }
    }
    if codemap.*.trace && node != app.NONE {
        var text: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length = filters_module.writeText(bytes, 0, "out ")
        length = lists_module.writeNumberPlain(bytes, length, relations.*.outgoingCount)
        length = filters_module.writeText(bytes, length, " in ")
        length = lists_module.writeNumberPlain(bytes, length, relations.*.incomingCount)
        traceLine(codemap, "related ", bytes[0..length])
    }
    access_module.panelOf(codemap).*.dirty = true
}

// Selects `node`, remembered for Back.
pub fn select(codemap: *app.Codemap, node: u32) -> void {
    if node == codemap.*.selected { return }
    if codemap.*.selected != app.NONE {
        if codemap.*.backCount == app.HISTORY {
            var at: usize = 1
            while at < app.HISTORY {
                codemap.*.back[at - 1] = codemap.*.back[at]
                at += 1
            }
            codemap.*.backCount -= 1
        }
        codemap.*.back[codemap.*.backCount] = codemap.*.selected
        codemap.*.backCount += 1
    }
    codemap.*.forwardCount = 0
    setSelected(codemap, node)
}

pub fn goTo(codemap: *app.Codemap, node: u32) -> void {
    select(codemap, node)
    // In the editor: its file, at it (a group: the galaxy flies there).
    showNode(codemap, node)
}

pub fn goBack(codemap: *app.Codemap) -> void {
    if codemap.*.backCount == 0 { return }
    codemap.*.backCount -= 1
    const node = codemap.*.back[codemap.*.backCount]
    if codemap.*.selected != app.NONE && codemap.*.forwardCount < app.HISTORY {
        codemap.*.forward[codemap.*.forwardCount] = codemap.*.selected
        codemap.*.forwardCount += 1
    }
    setSelected(codemap, node)
    showNode(codemap, node)
}

pub fn goForward(codemap: *app.Codemap) -> void {
    if codemap.*.forwardCount == 0 { return }
    codemap.*.forwardCount -= 1
    const node = codemap.*.forward[codemap.*.forwardCount]
    if codemap.*.selected != app.NONE && codemap.*.backCount < app.HISTORY {
        codemap.*.back[codemap.*.backCount] = codemap.*.selected
        codemap.*.backCount += 1
    }
    setSelected(codemap, node)
    showNode(codemap, node)
}

// The map flies to `node`; in the editor, its file opens at it.
fn showNode(codemap: *app.Codemap, node: u32) -> void {
    if codemap.*.view == app.VIEW_EDITOR && node != app.NONE && access_module.nodeOf(codemap, node).*.kind != graph_module.DIRECTORY {
        tabs_module.openNode(codemap, node)
        return
    }
    flyTo(codemap, node)
}

// Up a group: the selection's (or the camera's) parent.
pub fn goUp(codemap: *app.Codemap) -> void {
    const from = if codemap.*.selected != app.NONE { codemap.*.selected } else { codemap.*.focus }
    if from == app.NONE { return }
    const parent = access_module.nodeOf(codemap, from).*.parent
    if parent == app.NONE { return }
    goTo(codemap, parent)
}

// ---------------------------------------------------------------------------
// Searching

// The query the search holds (a view's, for @NAME); "" when it holds a
// plain name.
pub fn searchQuery(codemap: *app.Codemap) -> []const u8 {
    const text = access_module.searchText(codemap)
    if text.length > 1 && text[0] == 64 {
        const views = access_module.viewsOf(codemap)
        const view = views_module.find(views, text[1..text.length])
        if view < views.*.count { return views_module.queryOf(views, view) }
        return ""
    }
    if query_module.isQuery(text) { return text }
    return ""
}

// Reads the query in the search again (and works out what it needs).
pub fn updateQuery(codemap: *app.Codemap) -> void {
    codemap.*.queryActive = false
    codemap.*.queryBad = false
    if !codemap.*.built { return }
    const text = access_module.searchText(codemap)
    const words = searchQuery(codemap)
    if words.length == 0 {
        codemap.*.queryBad = text.length > 1 && text[0] == 64
        return
    }
    const query = access_module.queryOf(codemap)
    if !query_module.parse(query, words) {
        codemap.*.queryBad = true
        return
    }
    query_module.prepare(query, access_module.measuresOf(codemap), @intFromPtr(access_module.diffOf(codemap)))
    codemap.*.queryActive = true
}

// The search changed: a query (then or now) leaves out anew, a name is
// only looked for.
pub fn searchChanged(codemap: *app.Codemap) -> void {
    const text = access_module.searchText(codemap)
    if codemap.*.queryActive || searchQuery(codemap).length > 0 || (text.length > 1 && text[0] == 64) {
        filters_module.refreshVisibility(codemap)
    } else {
        codemap.*.queryBad = false
        runSearch(codemap)
    }
}

pub fn runSearch(codemap: *app.Codemap) -> void {
    const graph = access_module.graphOf(codemap)
    var at: usize = 0
    while at < graph.*.count {
        codemap.*.matches[at] = 0
        at += 1
    }
    codemap.*.matchCount = 0
    codemap.*.resultCount = 0
    codemap.*.resultCursor = 0
    const text = access_module.searchText(codemap)
    if text.length == 0 || !codemap.*.built { return }
    if codemap.*.queryActive || codemap.*.queryBad {
        // The answers are what is shown of the declarations.
        if codemap.*.queryBad { return }
        at = 1
        while at < graph.*.count {
            if graph_module.nodeAt(graph, @intCast(u32, at)).*.kind == graph_module.DECLARATION && !filters_module.hiddenAt(codemap, at) {
                codemap.*.matches[at] = 1
                codemap.*.matchCount += 1
                if codemap.*.resultCount < app.RESULTS {
                    codemap.*.results[codemap.*.resultCount] = @intCast(u32, at)
                    codemap.*.resultScores[codemap.*.resultCount] = 0
                    codemap.*.resultCount += 1
                }
            }
            at += 1
        }
        return
    }
    unsafe {
        codemap.*.resultCount = graph_module.search(graph, text, @ptrCast([*]u32, &codemap.*.results), @ptrCast([*]u32, &codemap.*.resultScores), app.RESULTS)
    }
    // What the sidebar leaves out is not found.
    var kept: usize = 0
    at = 0
    while at < codemap.*.resultCount {
        if !filters_module.isHidden(codemap, codemap.*.results[at]) {
            codemap.*.results[kept] = codemap.*.results[at]
            codemap.*.resultScores[kept] = codemap.*.resultScores[at]
            kept += 1
        }
        at += 1
    }
    codemap.*.resultCount = kept
    at = 1
    while at < graph.*.count {
        if !filters_module.hiddenAt(codemap, at) && graph_module.matchScore(graph, @intCast(u32, at), text) != app.NONE {
            codemap.*.matches[at] = 1
            codemap.*.matchCount += 1
        }
        at += 1
    }
}

pub fn clearSearch(codemap: *app.Codemap) -> void {
    codemap.*.searchLength = 0
    codemap.*.searchFocused = false
    searchChanged(codemap)
}

// Puts `text` into the search (a view chosen, --query).
pub fn setSearch(codemap: *app.Codemap, text: []const u8) -> void {
    codemap.*.searchLength = 0
    for byte in text {
        if codemap.*.searchLength < 256 {
            codemap.*.search[codemap.*.searchLength] = byte
            codemap.*.searchLength += 1
        }
    }
    searchChanged(codemap)
    if codemap.*.queryActive { filters_module.flyToShown(codemap) }
}
