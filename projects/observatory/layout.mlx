// Where the map's nodes go (part of graph.mlx, split from it): each
// node's children packed around it, the biggest first (close for a
// folder's few, on one sphere for a file's many), the sizes summed up the
// tree; then the uses pull for some rounds, springs holding each node near
// where it was packed, and the spheres worked out again.
const index_module = @import("../../tools/codemap/index.mlx")
const aggregates = @import("../../tools/codemap/aggregates.mlx")
const m = @import("./math3d.mlx")
const graph_module = @import("./graph.mlx")

const Graph = graph_module.Graph
const Node = graph_module.Node
const NONE = graph_module.NONE
const DIRECTORY = graph_module.DIRECTORY
const FILE = graph_module.FILE
const DECLARATION = graph_module.DECLARATION

fn nodeAt(graph: *Graph, node: u32) -> *Node { return graph_module.nodeAt(graph, node) }

fn isContainer(kind: u8) -> bool { return graph_module.isContainer(kind) }

// log2 roughly (the exponent and the mantissa's fraction).
fn log2(value: f64) -> f64 {
    if value <= 1.0 { return 0.0 }
    const bits: u64 = @bitCast(u64, value)
    const exponent = @intCast(i64, bits >> 52) - 1023
    const fraction: f64 = @floatFromInt(f64, @intCast(i64, bits & 4503599627370495))
    return m.toFloat(exponent) + fraction / 4503599627370496.0
}

fn countOf(value: u32) -> f64 { return m.toFloat(@intCast(i64, value)) }

fn hash(value: u32) -> u32 {
    var x = (value *% 2654435761) +% 1013904223
    x = x ^ (x >> 15)
    x = x *% 2246822519
    x = x ^ (x >> 13)
    return x
}

fn unit(value: u32) -> f64 { return m.toFloat(@intCast(i64, value & 16777215)) / 16777216.0 }

// A node's own turn (so groups do not all line up): tilted about x, spun
// about y.
const Turn = struct {
    spinCos: f64
    spinSin: f64
    tiltCos: f64
    tiltSin: f64
}

fn turnOf(node: u32) -> Turn {
    const spin = unit(hash(node)) * 6.283185307179586
    const tilt = (unit(hash(node + 7919)) - 0.5) * 2.4
    return Turn.{ .spinCos = m.cos(spin), .spinSin = m.sin(spin), .tiltCos = m.cos(tilt), .tiltSin = m.sin(tilt) }
}

fn turned(turn: Turn, direction: m.Vec) -> m.Vec {
    const ty = direction.y * turn.tiltCos - direction.z * turn.tiltSin
    const tz = direction.y * turn.tiltSin + direction.z * turn.tiltCos
    return m.vec(direction.x * turn.spinCos + tz * turn.spinSin, ty, tz * turn.spinCos - direction.x * turn.spinSin)
}

// Point `at` of `count` spread evenly over the unit sphere, the band it
// lies in `share` of the sphere from `before` on (a Fibonacci sphere,
// weighted).
fn spread(at: usize, before: f64, share: f64) -> m.Vec {
    const z = 1.0 - 2.0 * (before + share * 0.5)
    const ring = m.sqrt(m.maximum(0.0, 1.0 - z * z))
    const angle = m.toFloat(@intCast(i64, at)) * 2.399963229728653
    return m.vec(ring * m.cos(angle), z, ring * m.sin(angle))
}

// The node's children into scratch, the biggest first; how many.
fn gatherChildren(graph: *Graph, node: u32) -> usize {
    var count: usize = 0
    var child = nodeAt(graph, node).*.firstChild
    while child != NONE {
        const size = nodeAt(graph, child).*.extent
        var place = count
        while place > 0 && nodeAt(graph, graph.*.scratch[place - 1]).*.extent < size {
            graph.*.scratch[place] = graph.*.scratch[place - 1]
            place -= 1
        }
        graph.*.scratch[place] = child
        count += 1
        child = nodeAt(graph, child).*.nextSibling
    }
    return count
}

fn gapOf(first: f64, second: f64) -> f64 { return 0.35 + (first + second) * 0.08 }

fn centerOf(record: *Node) -> m.Vec { return m.vec(record.*.centerX, record.*.centerY, record.*.centerZ) }

// Places child `at` (of the scratch list): its group's middle at
// `middle`, the node where that puts it.
fn placeAt(graph: *Graph, at: usize, middle: m.Vec) -> void {
    const below = nodeAt(graph, graph.*.scratch[at])
    below.*.x = middle.x - below.*.centerX
    below.*.y = middle.y - below.*.centerY
    below.*.z = middle.z - below.*.centerZ
}

fn middleOf(graph: *Graph, at: usize) -> m.Vec {
    const below = nodeAt(graph, graph.*.scratch[at])
    return m.vec(below.*.x + below.*.centerX, below.*.y + below.*.centerY, below.*.z + below.*.centerZ)
}

// Grows the sphere (middle, radius) to take in (other, size) too.
fn takeIn(middle: *m.Vec, radius: *f64, other: m.Vec, size: f64) -> void {
    const apart = m.sub(other, middle.*)
    const distance = m.length(apart)
    if distance + size <= radius.* { return }
    if distance < 0.000001 {
        radius.* = size
        return
    }
    if radius.* + distance <= size {
        middle.* = other
        radius.* = size
        return
    }
    const grown = (radius.* + distance + size) * 0.5
    middle.* = m.add(middle.*, m.scale(apart, (grown - radius.*) / distance))
    radius.* = grown
}

// The sphere around the node's and its children's: its middle (relative
// to the node) and radius.
fn enclose(graph: *Graph, node: u32, count: usize) -> void {
    const record = nodeAt(graph, node)
    var middle = middleOf(graph, 0)
    var radius = nodeAt(graph, graph.*.scratch[0]).*.extent
    takeIn(&middle, &radius, m.vec(0.0, 0.0, 0.0), record.*.radius)
    var at: usize = 1
    while at < count {
        takeIn(&middle, &radius, middleOf(graph, at), nodeAt(graph, graph.*.scratch[at]).*.extent)
        at += 1
    }
    record.*.centerX = middle.x
    record.*.centerY = middle.y
    record.*.centerZ = middle.z
    record.*.extent = radius
}

// Many children (a file's declarations, a struct's fields: much the same
// size): on one sphere around the node, each on its share of it.
fn packShell(graph: *Graph, node: u32, count: usize) -> void {
    const record = nodeAt(graph, node)
    var area: f64 = 0.0
    var largest_sphere: f64 = 0.0
    var at: usize = 0
    while at < count {
        const below = nodeAt(graph, graph.*.scratch[at])
        const room = below.*.extent * 1.15 + 0.3
        area = area + room * room
        if below.*.radius > largest_sphere { largest_sphere = below.*.radius }
        at += 1
    }
    var shell = record.*.radius + largest_sphere + 0.6
    const packed_shell = 0.8 * m.sqrt(area)
    if packed_shell > shell { shell = packed_shell }
    record.*.shell = shell
    const turn = turnOf(node)
    var before: f64 = 0.0
    at = 0
    while at < count {
        const below = nodeAt(graph, graph.*.scratch[at])
        const room = below.*.extent * 1.15 + 0.3
        const share = room * room / area
        const direction = turned(turn, spread(at, before, share))
        before = before + share
        placeAt(graph, at, m.scale(direction, shell))
        at += 1
    }
    enclose(graph, node, count)
}

// How far out along the direction (dx, dy, dz) a group's middle must be
// for its node (at minus (ox, oy, oz) from the middle) to be `clear` from
// the origin, from `start`.
fn clearOfNode(dx: f64, dy: f64, dz: f64, ox: f64, oy: f64, oz: f64, clear: f64, start: f64) -> f64 {
    const ax = dx * start - ox
    const ay = dy * start - oy
    const az = dz * start - oz
    if ax * ax + ay * ay + az * az >= clear * clear { return start }
    const along = dx * ox + dy * oy + dz * oz
    const rest = ox * ox + oy * oy + oz * oz - clear * clear
    const room = along * along - rest
    if room <= 0.0 { return start }
    const far = along + m.sqrt(room)
    return if far > start { far } else { start }
}

// Few children of different sizes (a folder's): packed close, the biggest
// first, each where it keeps the whole smallest without touching the
// others (their groups may take the node itself in, not its sphere). The
// tries are many (64 directions, each stepped out past every group placed
// up to 40 times), so the directions are worked out once per node and the
// groups placed are kept as plain numbers: their middles, and per child
// placed against them how close it may come.
fn packClose(graph: *Graph, node: u32, count: usize) -> void {
    const record = nodeAt(graph, node)
    const turn = turnOf(node)
    const tries: usize = 64
    var try_x: [64]f64 = undefined
    var try_y: [64]f64 = undefined
    var try_z: [64]f64 = undefined
    var attempt: usize = 0
    while attempt < tries {
        const share = 1.0 / m.toFloat(@intCast(i64, tries))
        const direction = turned(turn, spread(attempt, m.toFloat(@intCast(i64, attempt)) * share, share))
        try_x[attempt] = direction.x
        try_y[attempt] = direction.y
        try_z[attempt] = direction.z
        attempt += 1
    }
    const first = turned(turn, spread(0, 0.0, 1.0))
    // The groups placed: middles, the square of their distance from the
    // node, and (for the child being placed) its reach to each squared.
    var placed_x: [48]f64 = undefined
    var placed_y: [48]f64 = undefined
    var placed_z: [48]f64 = undefined
    var placed_square: [48]f64 = undefined
    var rest: [48]f64 = undefined
    var at: usize = 0
    while at < count {
        const below = nodeAt(graph, graph.*.scratch[at])
        const size = below.*.extent
        // The node from the group's middle, turned around.
        const ox = below.*.centerX * -1.0
        const oy = below.*.centerY * -1.0
        const oz = below.*.centerZ * -1.0
        const clear = record.*.radius + below.*.radius + 0.6
        var other: usize = 0
        while other < at {
            const placed_size = nodeAt(graph, graph.*.scratch[other]).*.extent
            const reach = size + placed_size + gapOf(size, placed_size)
            rest[other] = placed_square[other] - reach * reach
            other += 1
        }
        var best_distance: f64 = 0.0
        var best_score: f64 = 1000000000000.0
        var best_x: f64 = 0.0
        var best_y: f64 = 1.0
        var best_z: f64 = 0.0
        attempt = 0
        const attempts = if at == 0 { 1 } else { tries }
        while attempt < attempts {
            const dx = if at == 0 { first.x } else { try_x[attempt] }
            const dy = if at == 0 { first.y } else { try_y[attempt] }
            const dz = if at == 0 { first.z } else { try_z[attempt] }
            // Out along it until clear of the node and every group placed.
            var distance = clearOfNode(dx, dy, dz, ox, oy, oz, clear, 0.0)
            var step: usize = 0
            var moved = true
            while moved && step < 40 {
                moved = false
                other = 0
                while other < at {
                    const along = dx * placed_x[other] + dy * placed_y[other] + dz * placed_z[other]
                    const room = along * along - rest[other]
                    if room > 0.0 {
                        const root = m.sqrt(room)
                        if distance > along - root && distance < along + root {
                            distance = along + root + 0.001
                            moved = true
                        }
                    }
                    other += 1
                }
                const cleared = clearOfNode(dx, dy, dz, ox, oy, oz, clear, distance)
                if cleared > distance {
                    distance = cleared
                    moved = true
                }
                step += 1
            }
            const score = distance + size
            if score < best_score {
                best_score = score
                best_distance = distance
                best_x = dx
                best_y = dy
                best_z = dz
            }
            attempt += 1
        }
        placeAt(graph, at, m.vec(best_x * best_distance, best_y * best_distance, best_z * best_distance))
        const middle = middleOf(graph, at)
        placed_x[at] = middle.x
        placed_y[at] = middle.y
        placed_z[at] = middle.z
        placed_square[at] = middle.x * middle.x + middle.y * middle.y + middle.z * middle.z
        at += 1
    }
    record.*.shell = 0.0
    enclose(graph, node, count)
}

pub fn sizes(graph: *Graph) -> void {
    // Children come after their parents: backwards, a node's children are
    // done before it.
    var at = graph.*.count
    while at > 0 {
        at -= 1
        const node = @intCast(u32, at)
        const record = nodeAt(graph, node)
        if record.*.kind == DIRECTORY {
            record.*.radius = 1.3 + 0.35 * log2(2.0 + countOf(record.*.files))
        } else if record.*.kind == FILE {
            record.*.radius = 0.9 + 0.22 * log2(1.0 + countOf(record.*.declarations))
        } else if isContainer(record.*.symbolKind) {
            record.*.radius = 0.5 + 0.08 * log2(1.0 + countOf(record.*.childCount)) + 0.05 * log2(1.0 + countOf(record.*.uses))
        } else if record.*.symbolKind == index_module.FIELD || record.*.symbolKind == index_module.MEMBER {
            record.*.radius = 0.2 + 0.03 * log2(1.0 + countOf(record.*.uses))
        } else {
            record.*.radius = 0.3 + 0.05 * log2(1.0 + countOf(record.*.uses))
        }
        // Its children placed around it (relative to it, for now); the
        // vectors that took are temporaries.
        const where = aggregates.mark(graph.*.arena)
        const count = gatherChildren(graph, node)
        if count == 0 {
            record.*.shell = 0.0
            record.*.extent = record.*.radius
            record.*.centerX = 0.0
            record.*.centerY = 0.0
            record.*.centerZ = 0.0
        } else if count <= 48 && record.*.kind != DECLARATION {
            packClose(graph, node, count)
        } else {
            packShell(graph, node, count)
        }
        aggregates.reset(graph.*.arena, where)
        // Totals up.
        if record.*.parent != NONE {
            const above = nodeAt(graph, record.*.parent)
            if record.*.kind != DECLARATION || above.*.kind != DECLARATION {
                above.*.files += record.*.files
                above.*.declarations += record.*.declarations
            }
        }
    }
}

// Lets the uses pull for `rounds` rounds. Each use pulls the user and the
// used toward each other (the more uses, the harder, as their logarithm);
// what pulls on a node pulls on the group it is in too (summed up the
// tree, so pulls within a group cancel out there): a declaration drifts
// toward the groups that use it, a group toward the groups it depends on.
// A spring holds each node near where it was packed; siblings are kept
// apart. Then each node's sphere is worked out again. The rounds go over
// every node and use many times: the arrays are taken into locals once,
// and each node's parent and room (its parent's sphere, which the rounds
// do not change) are read off the nodes once.
pub fn relax(graph: *Graph, rounds: usize) -> void {
    const count = graph.*.count
    const anchor_x = graph.*.anchorX
    const anchor_y = graph.*.anchorY
    const anchor_z = graph.*.anchorZ
    const force_x = graph.*.forceX
    const force_y = graph.*.forceY
    const force_z = graph.*.forceZ
    const move_x = graph.*.moveX
    const move_y = graph.*.moveY
    const move_z = graph.*.moveZ
    const absolute_x = graph.*.absoluteX
    const absolute_y = graph.*.absoluteY
    const absolute_z = graph.*.absoluteZ
    const mass = graph.*.mass
    const parents = graph.*.parentOf
    const rooms = graph.*.roomOf
    const edge_from = graph.*.edgeFrom
    const edge_to = graph.*.edgeTo
    const edge_pull = graph.*.edgePull
    const edges = graph.*.edgeCount
    const gravity = graph.*.gravity
    // Where they were packed, their parents, and their weights.
    var at: usize = 0
    while at < count {
        const record = nodeAt(graph, @intCast(u32, at))
        anchor_x[at] = record.*.x
        anchor_y[at] = record.*.y
        anchor_z[at] = record.*.z
        parents[at] = record.*.parent
        mass[at] = 1.0
        at += 1
    }
    at = count
    while at > 1 {
        at -= 1
        const parent = parents[at]
        if parent != NONE { mass[@intCast(usize, parent)] = mass[@intCast(usize, parent)] + mass[at] }
    }
    at = 1
    while at < count {
        rooms[at] = m.maximum(nodeAt(graph, parents[at]).*.extent, 1.0)
        at += 1
    }
    var round: usize = 0
    while round < rounds {
        // Where each node is now (from the positions relative to the
        // parents), and no pull on it yet.
        at = 0
        while at < count {
            const record = nodeAt(graph, @intCast(u32, at))
            const parent = parents[at]
            if parent == NONE {
                absolute_x[at] = record.*.x
                absolute_y[at] = record.*.y
                absolute_z[at] = record.*.z
            } else {
                const up = @intCast(usize, parent)
                absolute_x[at] = absolute_x[up] + record.*.x
                absolute_y[at] = absolute_y[up] + record.*.y
                absolute_z[at] = absolute_z[up] + record.*.z
            }
            force_x[at] = 0.0
            force_y[at] = 0.0
            force_z[at] = 0.0
            at += 1
        }
        // The pulls.
        var edge: usize = 0
        while edge < edges {
            const from = @intCast(usize, edge_from[edge])
            const to = @intCast(usize, edge_to[edge])
            const dx = absolute_x[to] - absolute_x[from]
            const dy = absolute_y[to] - absolute_y[from]
            const dz = absolute_z[to] - absolute_z[from]
            const distance = m.sqrt(dx * dx + dy * dy + dz * dz)
            if distance > 0.001 {
                const pull = edge_pull[edge] / distance
                force_x[from] = force_x[from] + dx * pull
                force_y[from] = force_y[from] + dy * pull
                force_z[from] = force_z[from] + dz * pull
                force_x[to] = force_x[to] - dx * pull
                force_y[to] = force_y[to] - dy * pull
                force_z[to] = force_z[to] - dz * pull
            }
            edge += 1
        }
        // Summed up the tree (children after parents: backwards).
        at = count
        while at > 1 {
            at -= 1
            const parent = parents[at]
            if parent != NONE {
                const up = @intCast(usize, parent)
                force_x[up] = force_x[up] + force_x[at]
                force_y[up] = force_y[up] + force_y[at]
                force_z[up] = force_z[up] + force_z[at]
            }
        }
        // Each node moves by the mean pull on what it holds, scaled to the
        // room it has; relative to its parent, less the parent's move.
        move_x[0] = 0.0
        move_y[0] = 0.0
        move_z[0] = 0.0
        at = 1
        while at < count {
            const record = nodeAt(graph, @intCast(u32, at))
            const parent = @intCast(usize, parents[at])
            const room = rooms[at]
            const step = gravity * 0.1 * room / mass[at]
            move_x[at] = force_x[at] * step
            move_y[at] = force_y[at] * step
            move_z[at] = force_z[at] * step
            var nx = record.*.x + move_x[at] - move_x[parent]
            var ny = record.*.y + move_y[at] - move_y[parent]
            var nz = record.*.z + move_z[at] - move_z[parent]
            // The spring back, and no farther than most of the room.
            nx = nx + (anchor_x[at] - nx) * 0.1
            ny = ny + (anchor_y[at] - ny) * 0.1
            nz = nz + (anchor_z[at] - nz) * 0.1
            const ox = nx - anchor_x[at]
            const oy = ny - anchor_y[at]
            const oz = nz - anchor_z[at]
            const off_squared = ox * ox + oy * oy + oz * oz
            const most = room * 0.45
            if off_squared > most * most {
                const cut = most / m.sqrt(off_squared)
                nx = anchor_x[at] + ox * cut
                ny = anchor_y[at] + oy * cut
                nz = anchor_z[at] + oz * cut
            }
            record.*.x = nx
            record.*.y = ny
            record.*.z = nz
            at += 1
        }
        separate(graph)
        round += 1
    }
    // The spheres again, bottom up.
    at = count
    while at > 0 {
        at -= 1
        const node = @intCast(u32, at)
        const where = aggregates.mark(graph.*.arena)
        const children = gatherChildren(graph, node)
        if children > 0 { enclose(graph, node, children) }
        aggregates.reset(graph.*.arena, where)
    }
}

// Siblings (of a folder: few) whose groups overlap are pushed apart.
fn separate(graph: *Graph) -> void {
    var at: usize = 0
    while at < graph.*.count {
        const record = nodeAt(graph, @intCast(u32, at))
        if record.*.kind == DIRECTORY && record.*.childCount >= 2 && record.*.childCount <= 64 {
            var first = record.*.firstChild
            while first != NONE {
                const a = nodeAt(graph, first)
                var second = a.*.nextSibling
                while second != NONE {
                    const b = nodeAt(graph, second)
                    const dx = (b.*.x + b.*.centerX) - (a.*.x + a.*.centerX)
                    const dy = (b.*.y + b.*.centerY) - (a.*.y + a.*.centerY)
                    const dz = (b.*.z + b.*.centerZ) - (a.*.z + a.*.centerZ)
                    const distance = m.sqrt(dx * dx + dy * dy + dz * dz)
                    const reach = (a.*.extent + b.*.extent) * 0.92
                    if distance < reach && distance > 0.001 {
                        // Each goes half, the lighter more.
                        const push = (reach - distance) / distance * 0.5
                        const ma = graph.*.mass[@intCast(usize, first)]
                        const mb = graph.*.mass[@intCast(usize, second)]
                        const share_a = mb / (ma + mb)
                        const share_b = ma / (ma + mb)
                        a.*.x = a.*.x - dx * push * share_a
                        a.*.y = a.*.y - dy * push * share_a
                        a.*.z = a.*.z - dz * push * share_a
                        b.*.x = b.*.x + dx * push * share_b
                        b.*.y = b.*.y + dy * push * share_b
                        b.*.z = b.*.z + dz * push * share_b
                    }
                    second = b.*.nextSibling
                }
                first = a.*.nextSibling
            }
        }
        at += 1
    }
}
