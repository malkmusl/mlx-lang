// Renderer pieces shared by the Wayland and Android Files frontends. The
// responsive geometry lives in ui.mlx; this module paints its chrome and
// common glyphs onto the cross-platform desktop canvas adapter.
const geometry = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const files_ui = @import("./ui.mlx")

const Canvas = canvas_module.Canvas
const Theme = theme_module.Theme

// The chrome is the Mlx look (docs/reference/design.md): the sidebar, the
// toolbar and the status bar are glass (the theme's translucent tint;
// the window stays clear under them, so the compositor can blur what is
// behind it there: the frontends name the areas, std.ui.host.setBlur),
// the content between them opaque in the theme's background.

// The area between the bars (the content, the list header) in the
// theme's background. A drawer overlays already-painted content; a wide
// sidebar keeps the surface clear beneath its tint.
pub fn drawMainBackground(canvas: *Canvas, layout: *const files_ui.Layout, theme: *const Theme) -> void {
    const left = if layout.*.sidebarOverlay { layout.*.safe.x } else { layout.*.toolbar.x }
    const top = if geometry.isEmpty(layout.*.toolbar) { layout.*.safe.y } else { geometry.bottom(layout.*.toolbar) }
    const bottom = if geometry.isEmpty(layout.*.status) { geometry.bottom(layout.*.safe) } else { layout.*.status.y }
    canvas_module.fillRect(canvas, left, top, geometry.right(layout.*.safe) - left, bottom - top, theme.*.background)
}

pub fn drawSidebarBackground(canvas: *Canvas, layout: *const files_ui.Layout, theme: *const Theme) -> void {
    const sidebar = layout.*.sidebar
    if geometry.isEmpty(sidebar) { return }
    canvas_module.fillRect(canvas, sidebar.x, sidebar.y, sidebar.width, sidebar.height, theme.*.glass)
    canvas_module.shadowRightOf(canvas, geometry.right(sidebar), sidebar.y, sidebar.height, theme.*.elevation, theme.*.shadow)
}

pub fn drawToolbarBackground(canvas: *Canvas, layout: *const files_ui.Layout, theme: *const Theme) -> void {
    const toolbar = layout.*.toolbar
    if geometry.isEmpty(toolbar) { return }
    canvas_module.fillRect(canvas, toolbar.x, toolbar.y, toolbar.width, toolbar.height, theme.*.glass)
    canvas_module.shadowBelow(canvas, toolbar.x, geometry.bottom(toolbar), toolbar.width, theme.*.elevation, theme.*.shadow)
}

pub fn drawStatusBackground(canvas: *Canvas, layout: *const files_ui.Layout, theme: *const Theme) -> void {
    const status = layout.*.status
    if geometry.isEmpty(status) { return }
    canvas_module.fillRect(canvas, status.x, status.y, status.width, status.height, theme.*.glass)
}

pub fn drawListHeaderBackground(canvas: *Canvas, layout: *const files_ui.Layout, theme: *const Theme) -> void {
    const header = layout.*.listHeader
    if geometry.isEmpty(header) { return }
    canvas_module.fillRect(canvas, header.x, header.y, header.width, header.height, theme.*.background)
    const scale = layout.*.scale
    canvas_module.fillRect(canvas, header.x + 8 * scale, geometry.bottom(header) - scale, header.width - 16 * scale, scale, theme.*.divider)
}

pub fn drawButtonBackground(canvas: *Canvas, area: geometry.Rect, active: bool, hovered: bool, theme: *const Theme) -> void {
    if !active && !hovered { return }
    const radius = if area.width >= 36 { theme.*.radius } else { theme.*.smallRadius + 3 }
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, if active { theme.*.pressed } else { theme.*.hover })
}

// The glass areas of a layout (for the blur region): x, y, width, height
// into `rects` (room for 12 values); how many.
pub fn glassRects(layout: *const files_ui.Layout, rects: [*]i32) -> usize {
    var count: usize = 0
    if !geometry.isEmpty(layout.*.sidebar) {
        rects[0] = layout.*.sidebar.x
        rects[1] = layout.*.sidebar.y
        rects[2] = layout.*.sidebar.width
        rects[3] = layout.*.sidebar.height
        count += 1
    }
    if !geometry.isEmpty(layout.*.toolbar) {
        rects[count * 4] = layout.*.toolbar.x
        rects[count * 4 + 1] = layout.*.toolbar.y
        rects[count * 4 + 2] = layout.*.toolbar.width
        rects[count * 4 + 3] = layout.*.toolbar.height
        count += 1
    }
    if !geometry.isEmpty(layout.*.status) {
        rects[count * 4] = layout.*.status.x
        rects[count * 4 + 1] = layout.*.status.y
        rects[count * 4 + 2] = layout.*.status.width
        rects[count * 4 + 3] = layout.*.status.height
        count += 1
    }
    return count
}

pub fn drawListRow(canvas: *Canvas, layout: *const files_ui.Layout, y: i32, color: u32) -> void {
    if color == 0 { return }
    const scale = layout.*.scale
    canvas_module.fillRoundedRect(canvas, layout.*.content.x + 8 * scale, y, layout.*.content.width - 16 * scale, layout.*.rowHeight, 6 * scale, color)
}

// Two strokes meeting at a point, `size` rows high (odd).
pub fn drawChevron(canvas: *Canvas, x: i32, y: i32, left: bool, color: u32, size: i32, thickness: i32) -> void {
    const half = size / 2
    var row: i32 = 0
    while row < size {
        const offset = if row < half { half - row } else { row - half }
        const column = if left { x + offset } else { x + half - offset }
        canvas_module.fillRect(canvas, column, y + row, thickness, 1, color)
        row += 1
    }
}

pub fn drawGridGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawGridGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawGridGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, 6 * scale, 6 * scale, 2 * scale, color)
    canvas_module.fillRoundedRect(canvas, x + 8 * scale, y, 6 * scale, 6 * scale, 2 * scale, color)
    canvas_module.fillRoundedRect(canvas, x, y + 8 * scale, 6 * scale, 6 * scale, 2 * scale, color)
    canvas_module.fillRoundedRect(canvas, x + 8 * scale, y + 8 * scale, 6 * scale, 6 * scale, 2 * scale, color)
}

pub fn drawListGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawListGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawListGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    var row: i32 = 0
    while row < 3 {
        canvas_module.fillRoundedRect(canvas, x, y + row * 5 * scale, 3 * scale, 3 * scale, scale, color)
        canvas_module.fillRoundedRect(canvas, x + 5 * scale, y + row * 5 * scale, 11 * scale, 3 * scale, scale, color)
        row += 1
    }
}

// A window split into a narrow navigation column and a content area.
pub fn drawSidebarGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawSidebarGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawSidebarGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 16 * scale, 14 * scale, 3 * scale, 2 * scale, color)
    canvas_module.fillRect(canvas, x + 5 * scale, y + 2 * scale, 2 * scale, 10 * scale, color)
}

// A magnifier: a ring and its handle.
pub fn drawSearchGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawSearchGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawSearchGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 11 * scale, 11 * scale, 5 * scale, 2 * scale, color)
    var step: i32 = 0
    while step < 5 * scale {
        canvas_module.fillRect(canvas, x + 9 * scale + step, y + 9 * scale + step, 2 * scale, 2 * scale, color)
        step += 1
    }
}
