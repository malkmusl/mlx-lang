// Renderer pieces shared by the Wayland and Android Files frontends. The
// responsive geometry lives in ui.mlx; this module paints its chrome and
// common glyphs onto the cross-platform desktop canvas adapter.
const geometry = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const files_ui = @import("./ui.mlx")

const Canvas = canvas_module.Canvas

pub fn drawMainBackground(canvas: *Canvas, layout: *const files_ui.Layout, look: *const files_ui.Look) -> void {
    // A drawer overlays already-painted content. A wide sidebar instead keeps
    // the surface transparent beneath its tint so the desktop compositor can
    // blur the window behind it.
    const left = if layout.*.sidebarOverlay { layout.*.safe.x } else { layout.*.toolbar.x }
    canvas_module.fillRect(canvas, left, layout.*.safe.y, geometry.right(layout.*.safe) - left, layout.*.safe.height, look.*.background)
}

pub fn drawSidebarBackground(canvas: *Canvas, layout: *const files_ui.Layout, look: *const files_ui.Look) -> void {
    const sidebar = layout.*.sidebar
    if geometry.isEmpty(sidebar) { return }
    // std.ui.sidebar's look (the desktop apps' one sidebar).
    const scale = layout.*.scale
    canvas_module.fillRect(canvas, sidebar.x, sidebar.y, sidebar.width, sidebar.height, look.*.sidebarTint)
    canvas_module.fillRect(canvas, geometry.right(sidebar) - scale, sidebar.y, scale, sidebar.height, look.*.sidebarEdge)
}

pub fn drawToolbarBackground(canvas: *Canvas, layout: *const files_ui.Layout, look: *const files_ui.Look) -> void {
    const toolbar = layout.*.toolbar
    if geometry.isEmpty(toolbar) { return }
    canvas_module.fillRect(canvas, toolbar.x, toolbar.y, toolbar.width, toolbar.height, look.*.toolbar)
    canvas_module.fillRect(canvas, toolbar.x, geometry.bottom(toolbar) - 1, toolbar.width, 1, look.*.line)
}

pub fn drawStatusBackground(canvas: *Canvas, layout: *const files_ui.Layout, look: *const files_ui.Look) -> void {
    const status = layout.*.status
    if geometry.isEmpty(status) { return }
    canvas_module.fillRect(canvas, status.x, status.y, status.width, status.height, look.*.status)
    canvas_module.fillRect(canvas, status.x, status.y, status.width, 1, look.*.line)
}

pub fn drawListHeaderBackground(canvas: *Canvas, layout: *const files_ui.Layout, look: *const files_ui.Look) -> void {
    const header = layout.*.listHeader
    if geometry.isEmpty(header) { return }
    canvas_module.fillRect(canvas, header.x, header.y, header.width, header.height, look.*.background)
    const scale = layout.*.scale
    canvas_module.fillRect(canvas, header.x + 8 * scale, geometry.bottom(header) - scale, header.width - 16 * scale, scale, look.*.headerLine)
}

pub fn drawButtonBackground(canvas: *Canvas, area: geometry.Rect, active: bool, hovered: bool, look: *const files_ui.Look) -> void {
    if !active && !hovered { return }
    const radius = if area.width >= 36 { 10 } else { 8 }
    const color = if active { look.*.buttonActive } else { look.*.buttonHover }
    canvas_module.fillRoundedRect(canvas, area.x, area.y, area.width, area.height, radius, color)
}

pub fn drawListRow(canvas: *Canvas, layout: *const files_ui.Layout, y: i32, color: u32) -> void {
    if color == 0 { return }
    const scale = layout.*.scale
    canvas_module.fillRoundedRect(canvas, layout.*.content.x + 8 * scale, y, layout.*.content.width - 16 * scale, layout.*.rowHeight, 6 * scale, color)
}

// Two strokes meeting at a point, `size` rows high (odd).
pub fn drawChevron(canvas: *Canvas, x: i32, y: i32, left: bool, color: u32, size: i32, thickness: i32) -> void {
    const half = size / 2
    var row: i32 = 0
    while row < size {
        const offset = if row < half { half - row } else { row - half }
        const column = if left { x + offset } else { x + half - offset }
        canvas_module.fillRect(canvas, column, y + row, thickness, 1, color)
        row += 1
    }
}

pub fn drawGridGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawGridGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawGridGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.fillRoundedRect(canvas, x, y, 6 * scale, 6 * scale, 2 * scale, color)
    canvas_module.fillRoundedRect(canvas, x + 8 * scale, y, 6 * scale, 6 * scale, 2 * scale, color)
    canvas_module.fillRoundedRect(canvas, x, y + 8 * scale, 6 * scale, 6 * scale, 2 * scale, color)
    canvas_module.fillRoundedRect(canvas, x + 8 * scale, y + 8 * scale, 6 * scale, 6 * scale, 2 * scale, color)
}

pub fn drawListGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawListGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawListGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    var row: i32 = 0
    while row < 3 {
        canvas_module.fillRoundedRect(canvas, x, y + row * 5 * scale, 3 * scale, 3 * scale, scale, color)
        canvas_module.fillRoundedRect(canvas, x + 5 * scale, y + row * 5 * scale, 11 * scale, 3 * scale, scale, color)
        row += 1
    }
}

// A window split into a narrow navigation column and a content area.
pub fn drawSidebarGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawSidebarGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawSidebarGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 16 * scale, 14 * scale, 3 * scale, 2 * scale, color)
    canvas_module.fillRect(canvas, x + 5 * scale, y + 2 * scale, 2 * scale, 10 * scale, color)
}

// A magnifier: a ring and its handle.
pub fn drawSearchGlyph(canvas: *Canvas, x: i32, y: i32, color: u32) -> void {
    drawSearchGlyphScaled(canvas, x, y, color, 1)
}

pub fn drawSearchGlyphScaled(canvas: *Canvas, x: i32, y: i32, color: u32, scale: i32) -> void {
    canvas_module.strokeRoundedRect(canvas, x, y, 11 * scale, 11 * scale, 5 * scale, 2 * scale, color)
    var step: i32 = 0
    while step < 5 * scale {
        canvas_module.fillRect(canvas, x + 9 * scale + step, y + 9 * scale + step, 2 * scale, 2 * scale, color)
        step += 1
    }
}
