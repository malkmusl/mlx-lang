// Responsive geometry shared by the desktop and Android Files frontends.
// Measurements are expressed in logical desktop pixels and multiplied by
// `scale`; breakpoints are evaluated after dividing the safe width by that
// scale, so a high-density phone does not accidentally become a desktop.
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")

// One palette for both renderers. These are opaque logical ARGB colours;
// each platform adapter converts them to its framebuffer representation.
// They are the dark look; lookAt gives the colours for any lightness.
pub const BACKGROUND: u32 = 4280164392
pub const TEXT_COLOR: u32 = 4293652213
pub const DIM_COLOR: u32 = 4287402656
pub const ACCENT: u32 = 4284129535

// What the chrome and the files are drawn in: lookAt(0) is the dark look
// (Android's), lookAt(1024) the light one; between them while the
// desktop's scheme glides (std.ui.host.lightness).
pub const Look = struct {
    background: u32
    text: u32
    dim: u32
    accent: u32
    toolbar: u32
    status: u32
    line: u32
    headerLine: u32
    buttonActive: u32
    buttonHover: u32
    // A list's every other row, the row under a drop, the chosen rows
    // while the search has the keys.
    rowStripe: u32
    rowDrop: u32
    rowSearch: u32
    // A grid cell chosen and under the pointer.
    cellChosen: u32
    cellHover: u32
    // The rename field, its selection; what is cut lies under this.
    field: u32
    selection: u32
    cut: u32
    sidebarTint: u32
    sidebarEdge: u32
    // How light (0 dark to 1024 light): for what is drawn outside these.
    lightness: i32
}

fn between(dark: u32, light: u32, lightness: i32) -> u32 { return theme_module.mix(dark, light, lightness) }

pub fn lookAt(lightness: i32) -> Look {
    return Look.{
        .background = between(BACKGROUND, canvas_module.color(255, 246, 246, 248), lightness),
        .text = between(TEXT_COLOR, canvas_module.color(255, 30, 32, 40), lightness),
        .dim = between(DIM_COLOR, canvas_module.color(255, 104, 108, 120), lightness),
        .accent = ACCENT,
        .toolbar = between(canvas_module.color(255, 36, 38, 47), canvas_module.color(255, 238, 239, 243), lightness),
        .status = between(canvas_module.color(255, 34, 36, 45), canvas_module.color(255, 236, 237, 241), lightness),
        .line = between(canvas_module.color(255, 20, 21, 27), canvas_module.color(255, 214, 216, 222), lightness),
        .headerLine = between(canvas_module.color(255, 52, 56, 66), canvas_module.color(255, 214, 216, 222), lightness),
        .buttonActive = between(canvas_module.color(255, 66, 70, 84), canvas_module.color(255, 208, 211, 220), lightness),
        .buttonHover = between(canvas_module.color(255, 50, 54, 66), canvas_module.color(255, 224, 226, 232), lightness),
        .rowStripe = between(canvas_module.color(255, 35, 37, 46), canvas_module.color(255, 238, 239, 243), lightness),
        .rowDrop = between(canvas_module.color(255, 58, 62, 76), canvas_module.color(255, 214, 218, 228), lightness),
        .rowSearch = between(canvas_module.color(255, 70, 76, 92), canvas_module.color(255, 196, 202, 216), lightness),
        .cellChosen = between(canvas_module.color(255, 58, 62, 76), canvas_module.color(255, 214, 224, 248), lightness),
        .cellHover = between(canvas_module.color(255, 42, 45, 56), canvas_module.color(255, 228, 230, 236), lightness),
        .field = between(canvas_module.color(255, 22, 24, 30), canvas_module.color(255, 255, 255, 255), lightness),
        .selection = between(canvas_module.color(255, 50, 90, 150), canvas_module.color(255, 190, 210, 250), lightness),
        .cut = between(canvas_module.color(150, 30, 32, 40), canvas_module.color(150, 246, 246, 248), lightness),
        .sidebarTint = between(canvas_module.color(214, 26, 28, 36), canvas_module.color(214, 246, 246, 248), lightness),
        .sidebarEdge = between(canvas_module.color(255, 18, 19, 25), canvas_module.color(255, 214, 216, 222), lightness),
        .lightness = lightness,
    }
}

pub const Mode = enum(u8) { phone, compact, wide }

pub const Layout = struct {
    mode: Mode
    scale: i32
    bounds: ui.Rect
    safe: ui.Rect
    sidebar: ui.Rect
    toolbar: ui.Rect
    listHeader: ui.Rect
    content: ui.Rect
    status: ui.Rect
    backButton: ui.Rect
    forwardButton: ui.Rect
    title: ui.Rect
    gridButton: ui.Rect
    listButton: ui.Rect
    sidebarButton: ui.Rect
    search: ui.Rect
    sidebarOpen: bool
    sidebarOverlay: bool
    rowHeight: i32
    listIconSize: i32
    gridIconSize: i32
    gridPadding: i32
    targetCellWidth: i32
    cellHeight: i32
    buttonSize: i32
}

fn positive(value: i32) -> i32 { return if value > 0 { value } else { 0 } }

fn smaller(first: i32, second: i32) -> i32 { return if first < second { first } else { second } }

// Android exposes framebuffer pixels rather than density-independent units.
// The shorter side provides a stable scale across portrait and landscape;
// desktop callers use 1 explicitly.
pub fn density(width: usize, height: usize) -> i32 {
    const shorter = if width < height { width } else { height }
    var scale = @intCast(i32, shorter / 360)
    if scale < 1 { scale = 1 }
    if scale > 3 { scale = 3 }
    return scale
}

pub fn layout(width: i32, height: i32, insets: ui.Insets, list_view: bool, requested_scale: i32) -> Layout {
    return layoutWithSidebar(width, height, insets, list_view, requested_scale, true, false)
}

// `wide_expanded` switches a desktop sidebar between its full width and an
// icon rail. `overlay_open` controls the drawer used by compact and phone
// layouts. Keeping both preferences lets a frontend retain each state while
// a window crosses a responsive breakpoint.
pub fn layoutWithSidebar(width: i32, height: i32, insets: ui.Insets, list_view: bool, requested_scale: i32, wide_expanded: bool, overlay_open: bool) -> Layout {
    const scale = if requested_scale > 0 { requested_scale } else { 1 }
    const bounds = ui.rect(0, 0, positive(width), positive(height))
    const safe = ui.inset(bounds, insets)
    const logical_width = safe.width / scale
    const mode = if logical_width >= 760 { Mode.wide } else if logical_width >= 520 { Mode.compact } else { Mode.phone }

    const toolbar_height = (if mode == Mode.phone { 104 } else { 52 }) * scale
    const controls_height = (if mode == Mode.phone { 56 } else { 52 }) * scale
    const status_height = (if mode == Mode.phone { 36 } else { 30 }) * scale
    const header_height = (if list_view && mode != Mode.phone { 28 } else { 0 }) * scale
    const sidebar_width = (if mode == Mode.wide { if wide_expanded { 200 } else { 56 } } else { 0 }) * scale
    const button_size = (if mode == Mode.phone { 40 } else { 30 }) * scale
    const edge = (if mode == Mode.phone { 12 } else { 14 }) * scale

    var body = safe
    var sidebar = ui.rect(safe.x, safe.y, 0, 0)
    if sidebar_width > 0 { sidebar = ui.takeLeft(&body, sidebar_width) }
    const sidebar_overlay = mode != Mode.wide && overlay_open
    if sidebar_overlay {
        const drawer_width = smaller(280 * scale, positive(safe.width - 64 * scale))
        sidebar = ui.rect(safe.x, safe.y, drawer_width, safe.height)
    }
    const toolbar = ui.takeTop(&body, toolbar_height)
    const status = ui.takeBottom(&body, status_height)
    var list_header = ui.rect(body.x, body.y, 0, 0)
    if header_height > 0 { list_header = ui.takeTop(&body, header_height) }

    const button_top = toolbar.y + positive(controls_height - button_size) / 2
    const navigation_left = toolbar.x + edge - 2 * scale
    var sidebar_button = ui.rect(navigation_left, button_top, button_size, button_size)
    if !ui.isEmpty(sidebar) {
        const inside_sidebar = ui.right(sidebar) - edge - button_size
        sidebar_button.x = if inside_sidebar > sidebar.x { inside_sidebar } else { sidebar.x }
    }
    const back_left = if ui.isEmpty(sidebar) { ui.right(sidebar_button) + 4 * scale } else { navigation_left }
    const back = ui.rect(back_left, button_top, button_size, button_size)
    const forward = ui.rect(ui.right(back) + 4 * scale, button_top, button_size, button_size)
    const right = ui.right(toolbar) - edge
    var search = ui.rect(right, button_top, 0, 0)
    var controls_right = right
    if mode == Mode.phone {
        search = ui.rect(toolbar.x + edge, toolbar.y + 60 * scale, positive(toolbar.width - edge * 2), button_size)
    } else {
        const desired = (if mode == Mode.wide { 190 } else { 150 }) * scale
        const room = positive(right - ui.right(forward) - 160 * scale)
        const search_width = smaller(desired, room)
        search = ui.rect(right - search_width, button_top, search_width, button_size)
        controls_right = search.x - 12 * scale
    }
    const list_button = ui.rect(controls_right - button_size, button_top, button_size, button_size)
    const grid_button = ui.rect(list_button.x - button_size, button_top, button_size, button_size)
    const title_left = ui.right(forward) + 14 * scale
    const title_right = grid_button.x - 12 * scale
    const title = ui.rect(title_left, toolbar.y, positive(title_right - title_left), controls_height)

    return Layout.{
        .mode = mode,
        .scale = scale,
        .bounds = bounds,
        .safe = safe,
        .sidebar = sidebar,
        .toolbar = toolbar,
        .listHeader = list_header,
        .content = body,
        .status = status,
        .backButton = back,
        .forwardButton = forward,
        .title = title,
        .gridButton = grid_button,
        .listButton = list_button,
        .sidebarButton = sidebar_button,
        .search = search,
        .sidebarOpen = if mode == Mode.wide { wide_expanded } else { overlay_open },
        .sidebarOverlay = sidebar_overlay,
        .rowHeight = (if mode == Mode.phone { 52 } else if mode == Mode.compact { 36 } else { 26 }) * scale,
        .listIconSize = (if mode == Mode.phone { 30 } else if mode == Mode.compact { 22 } else { 18 }) * scale,
        .gridIconSize = (if mode == Mode.phone { 60 } else { 56 }) * scale,
        .gridPadding = (if mode == Mode.phone { 12 } else { 14 }) * scale,
        .targetCellWidth = (if mode == Mode.phone { 112 } else { 104 }) * scale,
        .cellHeight = (if mode == Mode.phone { 116 } else { 104 }) * scale,
        .buttonSize = button_size,
    }
}

pub fn columns(value: *const Layout) -> i32 {
    const usable = positive(value.*.content.width - value.*.gridPadding * 2)
    const count = if value.*.targetCellWidth > 0 { usable / value.*.targetCellWidth } else { 1 }
    return if count > 0 { count } else { 1 }
}

pub fn cellWidth(value: *const Layout) -> i32 {
    return positive(value.*.content.width - value.*.gridPadding * 2) / columns(value)
}

pub fn itemRect(value: *const Layout, index: usize, scroll: i32, list_view: bool) -> ui.Rect {
    if list_view {
        return ui.rect(value.*.content.x, value.*.content.y + @intCast(i32, index) * value.*.rowHeight - scroll, value.*.content.width, value.*.rowHeight)
    }
    const count = columns(value)
    const cell = cellWidth(value)
    const position = @intCast(i32, index)
    return ui.rect(
        value.*.content.x + value.*.gridPadding + position % count * cell,
        value.*.content.y + value.*.gridPadding + position / count * value.*.cellHeight - scroll,
        cell,
        value.*.cellHeight,
    )
}
