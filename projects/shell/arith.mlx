// Arithmetic expansion, $(( ... )): integers (64-bit, signed), the C
// operators with their precedence (unary - + ! ~, * / %, + -, << >>, the
// comparisons, == !=, & ^ |, && ||, ?:), parentheses, assignment to a
// variable (= += -= *= /= %=), decimal, 0x hex and 0 octal numbers, and
// variables by name (their value as a number; 0 when it is none).
const std = @import("std")
const state = @import("./state.mlx")

const Shell = state.Shell

pub const Evaluation = struct {
    shell: *Shell
    text: []const u8
    at: usize
    failed: bool
    message: []const u8
}

fn blank(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 10 }

fn skipBlanks(evaluation: *Evaluation) -> void {
    while evaluation.*.at < evaluation.*.text.length && blank(evaluation.*.text[evaluation.*.at]) { evaluation.*.at += 1 }
}

fn peek(evaluation: *Evaluation) -> u8 {
    skipBlanks(evaluation)
    if evaluation.*.at >= evaluation.*.text.length { return 0 }
    return evaluation.*.text[evaluation.*.at]
}

fn peekAt(evaluation: *Evaluation, ahead: usize) -> u8 {
    if evaluation.*.at + ahead >= evaluation.*.text.length { return 0 }
    return evaluation.*.text[evaluation.*.at + ahead]
}

fn fail(evaluation: *Evaluation, message: []const u8) -> void {
    if !evaluation.*.failed {
        evaluation.*.failed = true
        evaluation.*.message = message
    }
}

fn nameStart(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 }
fn nameByte(byte: u8) -> bool { return nameStart(byte) || (byte >= 48 && byte <= 57) }

// A number from text (decimal, 0x..., 0...); 0 for none.
pub fn parseNumber(text: []const u8) -> i64 {
    var index: usize = 0
    while index < text.length && blank(text[index]) { index += 1 }
    var negative = false
    if index < text.length && (text[index] == 45 || text[index] == 43) {
        negative = text[index] == 45
        index += 1
    }
    var base: i64 = 10
    if index + 1 < text.length && text[index] == 48 && (text[index + 1] == 120 || text[index + 1] == 88) {
        base = 16
        index += 2
    } else if index + 1 < text.length && text[index] == 48 {
        base = 8
        index += 1
    }
    var value: i64 = 0
    while index < text.length {
        const byte = text[index]
        var digit: i64 = 99
        if byte >= 48 && byte <= 57 { digit = @intCast(i64, byte - 48) }
        if byte >= 97 && byte <= 102 { digit = @intCast(i64, byte - 87) }
        if byte >= 65 && byte <= 70 { digit = @intCast(i64, byte - 55) }
        if digit >= base { break }
        value = value * base + digit
        index += 1
    }
    return if negative { 0 - value } else { value }
}

fn variableValue(evaluation: *Evaluation, name: []const u8) -> i64 {
    const value = state.getVariable(evaluation.*.shell, name)
    if value == null { return 0 }
    return parseNumber(value.?)
}

fn setVariable(evaluation: *Evaluation, name: []const u8, value: i64) -> void {
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    const length = std.text.appendSigned(bytes, 0, 24, @intCast(isize, value))
    const set = state.setVariable(evaluation.*.shell, name, bytes[0..length], false)
}

// primary := number | name | ( expression ) | unary primary
fn primary(evaluation: *Evaluation) -> i64 {
    const byte = peek(evaluation)
    if byte == 40 {
        evaluation.*.at += 1
        const value = ternary(evaluation)
        if peek(evaluation) != 41 {
            fail(evaluation, "')' was expected")
            return 0
        }
        evaluation.*.at += 1
        return value
    }
    if byte == 45 || byte == 43 || byte == 33 || byte == 126 {
        evaluation.*.at += 1
        const value = primary(evaluation)
        if byte == 45 { return 0 - value }
        if byte == 33 { return if value == 0 { 1 } else { 0 } }
        if byte == 126 { return ~value }
        return value
    }
    if byte >= 48 && byte <= 57 {
        const start = evaluation.*.at
        while evaluation.*.at < evaluation.*.text.length && nameByte(evaluation.*.text[evaluation.*.at]) { evaluation.*.at += 1 }
        return parseNumber(evaluation.*.text[start..evaluation.*.at])
    }
    if nameStart(byte) {
        const start = evaluation.*.at
        while evaluation.*.at < evaluation.*.text.length && nameByte(evaluation.*.text[evaluation.*.at]) { evaluation.*.at += 1 }
        const name = evaluation.*.text[start..evaluation.*.at]
        // An assignment: NAME op= expression.
        const next = peek(evaluation)
        const after = peekAt(evaluation, 1)
        if next == 61 && after != 61 {
            evaluation.*.at += 1
            const value = ternary(evaluation)
            setVariable(evaluation, name, value)
            return value
        }
        if (next == 43 || next == 45 || next == 42 || next == 47 || next == 37) && after == 61 {
            evaluation.*.at += 2
            const current = variableValue(evaluation, name)
            const operand = ternary(evaluation)
            var value: i64 = 0
            if next == 43 { value = current + operand }
            if next == 45 { value = current - operand }
            if next == 42 { value = current * operand }
            if next == 47 {
                if operand == 0 {
                    fail(evaluation, "division by zero")
                    return 0
                }
                value = current / operand
            }
            if next == 37 {
                if operand == 0 {
                    fail(evaluation, "division by zero")
                    return 0
                }
                value = current % operand
            }
            setVariable(evaluation, name, value)
            return value
        }
        return variableValue(evaluation, name)
    }
    if byte == 0 { fail(evaluation, "an operand was expected") } else { fail(evaluation, "unexpected character") }
    return 0
}

fn multiplicative(evaluation: *Evaluation) -> i64 {
    var value = primary(evaluation)
    while !evaluation.*.failed {
        const byte = peek(evaluation)
        if byte == 42 {
            evaluation.*.at += 1
            value = value * primary(evaluation)
        } else if (byte == 47 || byte == 37) && peekAt(evaluation, 1) != 61 {
            evaluation.*.at += 1
            const divisor = primary(evaluation)
            if divisor == 0 {
                fail(evaluation, "division by zero")
                return 0
            }
            value = if byte == 47 { value / divisor } else { value % divisor }
        } else {
            return value
        }
    }
    return value
}

fn additive(evaluation: *Evaluation) -> i64 {
    var value = multiplicative(evaluation)
    while !evaluation.*.failed {
        const byte = peek(evaluation)
        if (byte == 43 || byte == 45) && peekAt(evaluation, 1) != 61 {
            evaluation.*.at += 1
            const operand = multiplicative(evaluation)
            value = if byte == 43 { value + operand } else { value - operand }
        } else {
            return value
        }
    }
    return value
}

fn shifts(evaluation: *Evaluation) -> i64 {
    var value = additive(evaluation)
    while !evaluation.*.failed {
        const byte = peek(evaluation)
        const after = peekAt(evaluation, 1)
        if byte == 60 && after == 60 {
            evaluation.*.at += 2
            value = value << @intCast(u6, additive(evaluation) & 63)
        } else if byte == 62 && after == 62 {
            evaluation.*.at += 2
            value = value >> @intCast(u6, additive(evaluation) & 63)
        } else {
            return value
        }
    }
    return value
}

fn truth(value: bool) -> i64 { return if value { 1 } else { 0 } }

fn comparison(evaluation: *Evaluation) -> i64 {
    var value = shifts(evaluation)
    while !evaluation.*.failed {
        const byte = peek(evaluation)
        const after = peekAt(evaluation, 1)
        if byte == 60 && after == 61 {
            evaluation.*.at += 2
            value = truth(value <= shifts(evaluation))
        } else if byte == 62 && after == 61 {
            evaluation.*.at += 2
            value = truth(value >= shifts(evaluation))
        } else if byte == 60 && after != 60 {
            evaluation.*.at += 1
            value = truth(value < shifts(evaluation))
        } else if byte == 62 && after != 62 {
            evaluation.*.at += 1
            value = truth(value > shifts(evaluation))
        } else {
            return value
        }
    }
    return value
}

fn equality(evaluation: *Evaluation) -> i64 {
    var value = comparison(evaluation)
    while !evaluation.*.failed {
        const byte = peek(evaluation)
        const after = peekAt(evaluation, 1)
        if byte == 61 && after == 61 {
            evaluation.*.at += 2
            value = truth(value == comparison(evaluation))
        } else if byte == 33 && after == 61 {
            evaluation.*.at += 2
            value = truth(value != comparison(evaluation))
        } else {
            return value
        }
    }
    return value
}

fn bitwise(evaluation: *Evaluation) -> i64 {
    var value = equality(evaluation)
    while !evaluation.*.failed {
        const byte = peek(evaluation)
        const after = peekAt(evaluation, 1)
        if byte == 38 && after != 38 {
            evaluation.*.at += 1
            value = value & equality(evaluation)
        } else if byte == 94 {
            evaluation.*.at += 1
            value = value ^ equality(evaluation)
        } else if byte == 124 && after != 124 {
            evaluation.*.at += 1
            value = value | equality(evaluation)
        } else {
            return value
        }
    }
    return value
}

fn logical(evaluation: *Evaluation) -> i64 {
    var value = bitwise(evaluation)
    while !evaluation.*.failed {
        const byte = peek(evaluation)
        const after = peekAt(evaluation, 1)
        if byte == 38 && after == 38 {
            evaluation.*.at += 2
            const right = bitwise(evaluation)
            value = truth(value != 0 && right != 0)
        } else if byte == 124 && after == 124 {
            evaluation.*.at += 2
            const right = bitwise(evaluation)
            value = truth(value != 0 || right != 0)
        } else {
            return value
        }
    }
    return value
}

fn ternary(evaluation: *Evaluation) -> i64 {
    const condition = logical(evaluation)
    if evaluation.*.failed || peek(evaluation) != 63 { return condition }
    evaluation.*.at += 1
    const when_true = ternary(evaluation)
    if peek(evaluation) != 58 {
        fail(evaluation, "':' was expected")
        return 0
    }
    evaluation.*.at += 1
    const when_false = ternary(evaluation)
    return if condition != 0 { when_true } else { when_false }
}

// Evaluates `text`; `ok` says whether it was an expression.
pub fn evaluate(shell: *Shell, text: []const u8, ok: *bool) -> i64 {
    var evaluation = Evaluation.{ .shell = shell, .text = text, .at = 0, .failed = false, .message = "" }
    const value = ternary(&evaluation)
    if !evaluation.failed && peek(&evaluation) != 0 { fail(&evaluation, "unexpected character") }
    if evaluation.failed { state.complainAbout("arithmetic: ", evaluation.message, text) }
    ok.* = !evaluation.failed
    return value
}
