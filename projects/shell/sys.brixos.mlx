// What flux needs beyond std on brixOS (sys.mlx is Linux's): paths given
// as Mlx slices, reads that go on after an upcall, waiting for an event
// (the shell's signals: host.brixos.mlx names them), the working
// directory, the umask, the hostname. Files are std.fs's (brixOS's node
// calls).
const std = @import("std")
const brix = std.os.brix

pub const PATH_CAPACITY: usize = 4096

fn pathPointer(buffer: *const [PATH_CAPACITY]u8) -> [*]u8 {
    const pointer: [*]u8 = unsafe { @ptrCast([*]u8, buffer) }
    return pointer
}

pub fn open(path: []const u8, flags: usize, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.fs.open(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path), flags, mode).descriptor
}

pub fn read(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    const file = std.fs.File.{ .descriptor = descriptor }
    var result = std.fs.read(file, into, capacity)
    while result == -4 { result = std.fs.read(file, into, capacity) }
    return result
}

// Takes one waiting event the shell's signals of `mask` stand for (traps:
// host.brixos.mlx claims their kinds): its signal's number, or 0 when
// none came within `wait_ns` nanoseconds (negative: however long it
// takes). Events of other kinds taken meanwhile are dropped (the shell
// claims none it does not want).
pub fn takeSignal(mask: usize, wait_ns: isize) -> usize {
    const deadline = if wait_ns < 0 { brix.FOREVER } else { brix.clock(brix.Clock.MONOTONIC) + @bitCast(usize, wait_ns) }
    while true {
        var records: [1]brix.EventRecord = undefined
        const taken = brix.take(records[0..1])
        if taken > 0 {
            const signal = signalOf(records[0].kind)
            if signal < 64 && mask & (@intCast(usize, 1) << @intCast(u6, signal - 1)) != 0 { return signal }
            continue
        }
        if wait_ns == 0 { return 0 }
        // Until an event comes (the shell's own process handle says so).
        const self_handle = ownHandle()
        if self_handle == 0 { return 0 }
        var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = self_handle, .want = brix.State.EVENTS, .seen = 0, .reserved = 0 } }
        const waited = brix.wait(items[0..1], deadline)
        if waited == 0 || waited == -brix.Status.timed_out { return 0 }
    }
    return 0
}

var selfHandle: u32 = 0 // (per run)

fn ownHandle() -> u32 {
    if selfHandle != 0 { return selfHandle }
    var record: brix.ProcessRecord = undefined
    var none: [1]u8 = undefined
    if brix.processSelf(&record, none[0..0]) < 0 { return 0 }
    const opened = brix.processOpen(record.pid)
    if opened < 0 { return 0 }
    selfHandle = @intCast(u32, opened)
    return selfHandle
}

fn signalOf(kind: u32) -> usize {
    if kind == brix.Event.HANGUP { return 1 }
    if kind == brix.Event.INTERRUPT { return 2 }
    if kind == brix.Event.QUIT { return 3 }
    if kind == brix.Event.BROKEN { return 13 }
    if kind == brix.Event.TERMINATE { return 15 }
    if kind == brix.Event.CHILD { return 17 }
    if kind == brix.Event.RESUME { return 18 }
    if kind == brix.Event.SUSPEND { return 20 }
    if kind == brix.Event.READ_BEHIND { return 21 }
    if kind == brix.Event.NOTICE { return 28 }
    if kind == brix.Event.USER { return 10 }
    return 64
}

pub fn changeDirectory(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return if std.fs.changeDirectory(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path)) { 0 } else { -2 }
}

pub fn workingDirectory(into: [*]u8, capacity: usize) -> usize {
    const result = std.fs.getWorkingDirectory(into, capacity)
    if result <= 1 { return 0 }
    return @bitCast(usize, result) - 1
}

pub fn umask(mask: usize) -> usize { return std.fs.setUmask(mask) }

pub fn access(path: []const u8, mode: usize) -> bool {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.fs.access(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path), mode)
}

// The machine's name: brixOS's (as its Linux layer says it too).
pub fn hostname(into: [*]u8, capacity: usize) -> usize {
    const name = "brix"
    var length: usize = 0
    while length < name.length && length + 1 < capacity {
        into[length] = name[length]
        length += 1
    }
    return length
}
