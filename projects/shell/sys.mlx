// What mlx-sh needs beyond std.linux: paths given as Mlx slices, reads
// that go on after a signal (the shell takes its signals as they come),
// waiting for a signal, the working directory, the umask, the hostname.
// Descriptors, processes and signal sets are std.linux's; the terminal
// (its modes, size and foreground group) and process groups are
// std.terminal.tty's.
const std = @import("std")

pub const PATH_CAPACITY: usize = 4096

fn pathPointer(buffer: *const [PATH_CAPACITY]u8) -> [*]u8 {
    const pointer: [*]u8 = unsafe { @ptrCast([*]u8, buffer) }
    return pointer
}

pub fn open(path: []const u8, flags: usize, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.open(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path), flags, mode)
}

pub fn read(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    var result = std.linux.read(descriptor, into, capacity)
    while result == std.linux.EINTR { result = std.linux.read(descriptor, into, capacity) }
    return result
}

// Takes one pending signal of `mask`: its number, or 0 when none came
// within `wait_ns` nanoseconds (negative: however long it takes).
pub fn takeSignal(mask: usize, wait_ns: isize) -> usize {
    var wanted: usize = mask
    var info: [128]u8 = undefined
    var timeout: [2]isize = [2]isize{ 0, 0 }
    var timeout_address: usize = 0
    if wait_ns >= 0 {
        timeout[0] = wait_ns / 1000000000
        timeout[1] = wait_ns % 1000000000
        timeout_address = @intFromPtr(&timeout)
    }
    var result = std.linux.syscall4(std.linux.SYS_rt_sigtimedwait, @intFromPtr(&wanted), @intFromPtr(&info), timeout_address, 8)
    while result == std.linux.EINTR { result = std.linux.syscall4(std.linux.SYS_rt_sigtimedwait, @intFromPtr(&wanted), @intFromPtr(&info), timeout_address, 8) }
    if result <= 0 { return 0 }
    return @bitCast(usize, result)
}

pub fn changeDirectory(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.chdir(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path))
}

// The working directory into `into`; its length, or 0.
pub fn workingDirectory(into: [*]u8, capacity: usize) -> usize {
    const result = std.linux.syscall2(std.linux.SYS_getcwd, @intFromPtr(into), capacity)
    if result <= 1 { return 0 }
    return @bitCast(usize, result) - 1
}

pub fn umask(mask: usize) -> usize { return @bitCast(usize, std.linux.syscall1(std.linux.SYS_umask, mask)) }

// Whether `path` exists (mode 0), is executable (1), writable (2), readable (4).
pub fn access(path: []const u8, mode: usize) -> bool {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall2(std.linux.SYS_access, @intFromPtr(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path)), mode) == 0
}

// The hostname, from the kernel.
pub fn hostname(into: [*]u8, capacity: usize) -> usize {
    var system: std.linux.system.UtsName = undefined
    if !std.linux.system.getSystemInfo(&system) { return 0 }
    var length: usize = 0
    while length + 1 < capacity && length < 65 && system.nodeName[length] != 0 {
        into[length] = system.nodeName[length]
        length += 1
    }
    return length
}
