// The system calls mlx-sh needs beyond std: processes, pipes, signals, as
// numbers for x86_64 with thin wrappers. The terminal (its modes, size and
// foreground group) and process groups are std.terminal.tty's.
const std = @import("std")

pub const SYS_read: usize = 0
pub const SYS_write: usize = 1
pub const SYS_open: usize = 2
pub const SYS_close: usize = 3
pub const SYS_stat: usize = 4
pub const SYS_rt_sigaction: usize = 13
pub const SYS_rt_sigprocmask: usize = 14
pub const SYS_access: usize = 21
pub const SYS_pipe: usize = 22
pub const SYS_dup: usize = 32
pub const SYS_dup2: usize = 33
pub const SYS_getpid: usize = 39
pub const SYS_fork: usize = 57
pub const SYS_execve: usize = 59
pub const SYS_exit_group: usize = 231
pub const SYS_wait4: usize = 61
pub const SYS_kill: usize = 62
pub const SYS_uname: usize = 63
pub const SYS_fcntl: usize = 72
pub const SYS_getcwd: usize = 79
pub const SYS_chdir: usize = 80
pub const SYS_umask: usize = 95
pub const SYS_getuid: usize = 102
pub const SYS_getppid: usize = 110
pub const SYS_pipe2: usize = 293
pub const SYS_rt_sigtimedwait: usize = 128

pub const O_RDONLY: usize = 0
pub const O_WRONLY: usize = 1
pub const O_RDWR: usize = 2
pub const O_CREAT: usize = 64
pub const O_EXCL: usize = 128
pub const O_TRUNC: usize = 512
pub const O_APPEND: usize = 1024
pub const O_DIRECTORY: usize = 65536
pub const O_CLOEXEC: usize = 524288

pub const SIGHUP: usize = 1
pub const SIGINT: usize = 2
pub const SIGQUIT: usize = 3
pub const SIGKILL: usize = 9
pub const SIGPIPE: usize = 13
pub const SIGTERM: usize = 15
pub const SIGCHLD: usize = 17
pub const SIGCONT: usize = 18
pub const SIGSTOP: usize = 19
pub const SIGTSTP: usize = 20
pub const SIGTTIN: usize = 21
pub const SIGTTOU: usize = 22

pub const SIG_BLOCK: usize = 0
pub const SIG_UNBLOCK: usize = 1
pub const SIG_SETMASK: usize = 2

pub const WNOHANG: usize = 1
pub const WUNTRACED: usize = 2
pub const WCONTINUED: usize = 8

pub const F_DUPFD_CLOEXEC: usize = 1030

pub const EINTR: isize = -4
pub const EAGAIN: isize = -11
pub const ECHILD: isize = -10

pub const PATH_CAPACITY: usize = 4096

fn pathPointer(buffer: *const [PATH_CAPACITY]u8) -> [*]u8 {
    const pointer: [*]u8 = unsafe { @ptrCast([*]u8, buffer) }
    return pointer
}

pub fn open(path: []const u8, flags: usize, mode: usize) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall3(SYS_open, @intFromPtr(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path)), flags, mode)
}

pub fn close(descriptor: isize) -> void {
    _ = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

pub fn read(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    var result = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), @intFromPtr(into), capacity)
    while result == EINTR { result = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), @intFromPtr(into), capacity) }
    return result
}

pub fn write(descriptor: isize, bytes: [*]const u8, length: usize) -> isize {
    return std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(bytes), length)
}

pub fn writeAll(descriptor: isize, text: []const u8) -> bool {
    const pointer: [*]const u8 = text.pointer
    var done: usize = 0
    while done < text.length {
        const wrote = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(pointer) + done, text.length - done)
        if wrote == EINTR { continue }
        if wrote <= 0 { return false }
        done += @bitCast(usize, wrote)
    }
    return true
}

pub fn dup(descriptor: isize) -> isize { return std.linux.syscall1(SYS_dup, @bitCast(usize, descriptor)) }

pub fn dup2(from: isize, to: isize) -> isize {
    return std.linux.syscall2(SYS_dup2, @bitCast(usize, from), @bitCast(usize, to))
}

// A pipe: its read end and its write end (close-on-exec).
pub fn pipe(read_end: *isize, write_end: *isize) -> bool {
    var raw: [2]i32 = [2]i32{ 0, 0 }
    if std.linux.syscall2(SYS_pipe2, @intFromPtr(&raw), O_CLOEXEC) != 0 { return false }
    read_end.* = @intCast(isize, raw[0])
    write_end.* = @intCast(isize, raw[1])
    return true
}

pub fn fork() -> isize { return std.linux.syscall0(SYS_fork) }

pub fn exit(status: usize) -> void {
    _ = std.linux.syscall1(SYS_exit_group, status)
}

pub fn execute(program: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8) -> isize {
    return std.linux.syscall3(SYS_execve, @intFromPtr(program), @intFromPtr(arguments), @intFromPtr(environment))
}

// Waits for `pid` (-1: any child) with wait4's `flags` (WNOHANG,
// WUNTRACED, WCONTINUED); the pid that changed (0 with WNOHANG and none,
// negative without children), the raw status in `status`.
pub fn waitWith(pid: isize, status: *usize, flags: usize) -> isize {
    var raw: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    var result = std.linux.syscall4(SYS_wait4, @bitCast(usize, pid), @intFromPtr(&raw), flags, 0)
    while result == EINTR { result = std.linux.syscall4(SYS_wait4, @bitCast(usize, pid), @intFromPtr(&raw), flags, 0) }
    status.* = @intCast(usize, raw[0]) | (@intCast(usize, raw[1]) << 8)
    return result
}

// Waits for `pid` to end (-1: any child); the pid that ended (0 with
// `no_hang` and nothing ended, negative without children).
pub fn wait(pid: isize, status: *usize, no_hang: bool) -> isize {
    return waitWith(pid, status, if no_hang { WNOHANG } else { 0 })
}

// The exit code, or 128 plus the signal, from a raw wait status.
pub fn exitStatus(raw: usize) -> usize {
    if raw & 127 == 0 { return (raw >> 8) & 255 }
    return 128 + (raw & 127)
}

// Whether a raw status (with WUNTRACED) says the child stopped, and by
// which signal; whether it went on (WCONTINUED).
pub fn stopped(raw: usize) -> bool { return raw & 255 == 127 }
pub fn stopSignal(raw: usize) -> usize { return (raw >> 8) & 255 }
pub fn continued(raw: usize) -> bool { return raw == 65535 }

// A copy of `descriptor` at `minimum` or above (close-on-exec); negative
// when none is free.
pub fn duplicateAbove(descriptor: isize, minimum: usize) -> isize {
    return std.linux.syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_DUPFD_CLOEXEC, minimum)
}

// Signal sets as a word: bit (signal - 1).
pub fn signalBit(signal: usize) -> usize {
    if signal == 0 || signal > 64 { return 0 }
    var bit: usize = 1
    bit = bit << (signal - 1)
    return bit
}

// Changes the blocked signals (SIG_BLOCK, SIG_UNBLOCK, SIG_SETMASK); the
// set as it was.
pub fn changeSignalMask(how: usize, mask: usize) -> usize {
    var wanted: usize = mask
    var old: usize = 0
    _ = std.linux.syscall4(SYS_rt_sigprocmask, how, @intFromPtr(&wanted), @intFromPtr(&old), 8)
    return old
}

// Takes one pending signal of `mask`: its number, or 0 when none came
// within `wait_ns` nanoseconds (negative: however long it takes).
pub fn takeSignal(mask: usize, wait_ns: isize) -> usize {
    var wanted: usize = mask
    var info: [128]u8 = undefined
    var timeout: [2]isize = [2]isize{ 0, 0 }
    var timeout_address: usize = 0
    if wait_ns >= 0 {
        timeout[0] = wait_ns / 1000000000
        timeout[1] = wait_ns % 1000000000
        timeout_address = @intFromPtr(&timeout)
    }
    var result = std.linux.syscall4(SYS_rt_sigtimedwait, @intFromPtr(&wanted), @intFromPtr(&info), timeout_address, 8)
    while result == EINTR { result = std.linux.syscall4(SYS_rt_sigtimedwait, @intFromPtr(&wanted), @intFromPtr(&info), timeout_address, 8) }
    if result <= 0 { return 0 }
    return @bitCast(usize, result)
}

pub fn kill(pid: isize, signal: usize) -> isize {
    return std.linux.syscall2(SYS_kill, @bitCast(usize, pid), signal)
}

pub fn getPid() -> isize { return std.linux.syscall0(SYS_getpid) }
pub fn getParentPid() -> isize { return std.linux.syscall0(SYS_getppid) }
pub fn getUid() -> usize { return @bitCast(usize, std.linux.syscall0(SYS_getuid)) }

pub fn changeDirectory(path: []const u8) -> isize {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall1(SYS_chdir, @intFromPtr(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path)))
}

// The working directory into `into`; its length, or 0.
pub fn workingDirectory(into: [*]u8, capacity: usize) -> usize {
    const result = std.linux.syscall2(SYS_getcwd, @intFromPtr(into), capacity)
    if result <= 1 { return 0 }
    return @bitCast(usize, result) - 1
}

pub fn umask(mask: usize) -> usize { return @bitCast(usize, std.linux.syscall1(SYS_umask, mask)) }

// Whether `path` exists (mode 0), is executable (1), writable (2), readable (4).
pub fn access(path: []const u8, mode: usize) -> bool {
    var buffer: [PATH_CAPACITY]u8 = undefined
    return std.linux.syscall2(SYS_access, @intFromPtr(std.text.zeroTerminated(pathPointer(&buffer), PATH_CAPACITY, path)), mode) == 0
}

// SIG_IGN (1) or SIG_DFL (0) for `signal`.
pub fn setSignal(signal: usize, handler: usize) -> void {
    // sigaction: handler, flags (SA_RESTORER), restorer, mask.
    var action: [4]usize = [4]usize{ handler, 0, 0, 0 }
    _ = std.linux.syscall4(SYS_rt_sigaction, signal, @intFromPtr(&action), 0, 8)
}

// The hostname, from the kernel.
pub fn hostname(into: [*]u8, capacity: usize) -> usize {
    var record: [390]u8 = undefined
    if std.linux.syscall1(SYS_uname, @intFromPtr(&record)) != 0 { return 0 }
    var length: usize = 0
    while length + 1 < capacity && length < 65 && record[65 + length] != 0 {
        into[length] = record[65 + length]
        length += 1
    }
    return length
}
