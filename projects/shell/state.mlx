// The shell's state: one block of memory holding the source being run
// (and what heredocs and substitutions add to it), the parse tree as
// nodes, the variables, the functions, the positional parameters, a work
// stack for expansions and argument vectors, the history, the options
// and what is going on (the last status, loops being left, an exit asked
// for).
const std = @import("std")
const sys = @import("./sys.mlx")

pub const Allocator = std.allocator.Allocator

pub const TEXT_CAPACITY: usize = 1048576
pub const MAX_NODES: usize = 32768
pub const VARIABLE_CAPACITY: usize = 524288
pub const MAX_VARIABLES: usize = 2048
pub const FUNCTION_CAPACITY: usize = 262144
pub const MAX_FUNCTIONS: usize = 256
pub const WORK_CAPACITY: usize = 8388608
pub const POSITIONAL_CAPACITY: usize = 262144
pub const MAX_POSITIONAL: usize = 4096
pub const HISTORY_CAPACITY: usize = 262144
pub const MAX_HISTORY: usize = 1000
pub const MAX_JOBS: usize = 64
pub const NAME_CAPACITY: usize = 256

// Node kinds.
pub const NONE: u8 = 0
pub const LIST: u8 = 1
pub const ANDOR: u8 = 2
pub const PIPELINE: u8 = 3
pub const SIMPLE: u8 = 4
pub const SUBSHELL: u8 = 5
pub const GROUP: u8 = 6
pub const IF: u8 = 7
pub const FOR: u8 = 8
pub const WHILE: u8 = 9
pub const UNTIL: u8 = 10
pub const CASE: u8 = 11
pub const FUNCTION: u8 = 12
pub const WORD: u8 = 13
pub const REDIRECT: u8 = 14
pub const CLAUSE: u8 = 15
pub const ELSE: u8 = 16
pub const ITEM: u8 = 17
pub const BODY: u8 = 18

// Node flags.
pub const BACKGROUND: u8 = 1
pub const NEGATED: u8 = 2
pub const ASSIGNMENT: u8 = 4
pub const AND_BEFORE: u8 = 8
pub const OR_BEFORE: u8 = 16
pub const NO_EXPAND: u8 = 32
pub const IN_WORDS: u8 = 64

// Redirect operators (Node.number's high byte; the low byte is the fd).
pub const R_INPUT: u16 = 1
pub const R_OUTPUT: u16 = 2
pub const R_APPEND: u16 = 3
pub const R_HEREDOC: u16 = 4
pub const R_DUP_INPUT: u16 = 5
pub const R_DUP_OUTPUT: u16 = 6
pub const R_READ_WRITE: u16 = 7
pub const R_CLOBBER: u16 = 8
pub const R_BOTH: u16 = 9

pub const Node = struct {
    kind: u8
    flags: u8
    number: u16
    // The first child and the next sibling (0: none; node 0 is empty).
    first: u32
    next: u32
    // A word's text in the text arena; a function body's source.
    text: u32
    length: u32
    // A second child list (a loop's body, a case item's body).
    extra: u32
}

pub const Variable = struct {
    name: u32
    nameLength: u32
    value: u32
    valueLength: u32
    exported: bool
    readonly: bool
    used: bool
}

pub const Function = struct {
    name: u32
    nameLength: u32
    body: u32
    bodyLength: u32
    used: bool
}

pub const MAX_LOCALS: usize = 256
pub const LOCAL_CAPACITY: usize = 65536

pub const Local = struct {
    name: u32
    nameLength: u32
    value: u32
    valueLength: u32
    existed: bool
    exported: bool
    depth: usize
}

// exec.mlx's runText, reached through the shell by the modules below it
// (expand.mlx for command substitution, builtins.mlx for eval and source).
pub const RunText = fn(shell: *anyopaque, text: []const u8) -> usize

pub const Shell = struct {
    allocator: Allocator
    runText: RunText
    text: [TEXT_CAPACITY]u8
    textLength: usize
    nodes: [MAX_NODES]Node
    nodeCount: usize
    variables: [MAX_VARIABLES]Variable
    variableCount: usize
    variableBytes: [VARIABLE_CAPACITY]u8
    variableLength: usize
    functions: [MAX_FUNCTIONS]Function
    functionCount: usize
    functionBytes: [FUNCTION_CAPACITY]u8
    functionLength: usize
    work: [WORK_CAPACITY]u8
    workLength: usize
    // The positional parameters: a stack of frames (scripts, functions);
    // the current frame runs from `positionalBase` to `positionalCount`.
    positionalOffsets: [MAX_POSITIONAL]u32
    positionalLengths: [MAX_POSITIONAL]u32
    positionalCount: usize
    positionalBase: usize
    positionalBytes: [POSITIONAL_CAPACITY]u8
    positionalLength: usize
    scriptName: [NAME_CAPACITY]u8
    scriptNameLength: usize
    lastStatus: usize
    lastBackground: isize
    exiting: bool
    exitStatus: usize
    returning: bool
    returnStatus: usize
    // Loops being left: how many levels, by break or continue.
    breaking: usize
    continuing: usize
    loopDepth: usize
    functionDepth: usize
    errexit: bool
    xtrace: bool
    noglob: bool
    interactive: bool
    loginShell: bool
    // Background jobs not waited for yet.
    jobs: [MAX_JOBS]isize
    jobCount: usize
    // The history (the editor's): a ring of lines.
    history: [HISTORY_CAPACITY]u8
    historyLength: usize
    historyOffsets: [MAX_HISTORY]u32
    historyLengths: [MAX_HISTORY]u32
    historyCount: usize
    historyStart: usize
    // The terminal's modes before the editor changed them.
    cooked: sys.Termios
    hasCooked: bool
    // The trap for EXIT (a command string in the function arena; 0: none).
    exitTrap: u32
    exitTrapLength: u32
    // The parse of the current input (the parser's).
    parseStart: usize
    // `local` variables: what to put back when the function returns.
    locals: [MAX_LOCALS]Local
    localCount: usize
    localBytes: [LOCAL_CAPACITY]u8
    localLength: usize
    // Conditions (if, while, the left sides of && and ||) and ! suspend
    // set -e while this is above 0.
    conditionDepth: usize
    // The current working directory, for the prompt and pwd.
    workingDirectory: [4096]u8
    workingDirectoryLength: usize
}

// ---------------------------------------------------------------------------
// Memory

pub fn create(allocator: Allocator) -> ?*Shell {
    const memory = allocator.alloc(@sizeOf(Shell), 16)
    if memory == null { return null }
    var shell: *Shell = undefined
    unsafe { shell = @ptrCast(*Shell, memory.?) }
    shell.*.allocator = allocator
    shell.*.textLength = 0
    shell.*.nodeCount = 1
    shell.*.variableCount = 0
    shell.*.variableLength = 0
    shell.*.functionCount = 0
    shell.*.functionLength = 0
    shell.*.workLength = 0
    shell.*.positionalCount = 0
    shell.*.positionalBase = 0
    shell.*.positionalLength = 0
    shell.*.scriptNameLength = 0
    shell.*.lastStatus = 0
    shell.*.lastBackground = 0
    shell.*.exiting = false
    shell.*.exitStatus = 0
    shell.*.returning = false
    shell.*.returnStatus = 0
    shell.*.breaking = 0
    shell.*.continuing = 0
    shell.*.loopDepth = 0
    shell.*.functionDepth = 0
    shell.*.errexit = false
    shell.*.xtrace = false
    shell.*.noglob = false
    shell.*.interactive = false
    shell.*.loginShell = false
    shell.*.jobCount = 0
    shell.*.historyLength = 0
    shell.*.historyCount = 0
    shell.*.historyStart = 0
    shell.*.hasCooked = false
    shell.*.exitTrap = 0
    shell.*.exitTrapLength = 0
    shell.*.parseStart = 0
    shell.*.localCount = 0
    shell.*.localLength = 0
    shell.*.conditionDepth = 0
    shell.*.workingDirectoryLength = 0
    const root = nodeAt(shell, 0)
    root.*.kind = NONE
    root.*.first = 0
    root.*.next = 0
    return shell
}

pub fn textBytes(shell: *Shell) -> [*]u8 {
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, &shell.*.text) }
    return pointer
}

pub fn textOf(shell: *Shell, offset: u32, length: u32) -> []const u8 {
    const bytes = textBytes(shell)
    const start = @intCast(usize, offset)
    return bytes[start..start + @intCast(usize, length)]
}

// Appends `bytes` to the text arena; its offset, or TEXT_CAPACITY when
// it does not fit.
pub fn appendText(shell: *Shell, bytes: []const u8) -> usize {
    if shell.*.textLength + bytes.length + 1 > TEXT_CAPACITY { return TEXT_CAPACITY }
    const at = shell.*.textLength
    const into = textBytes(shell)
    var index: usize = 0
    for byte in bytes {
        into[at + index] = byte
        index += 1
    }
    shell.*.textLength += bytes.length
    return at
}

pub fn nodeAt(shell: *Shell, index: u32) -> *Node {
    var pointer: *Node = undefined
    const at = @intCast(usize, index)
    unsafe { pointer = @ptrCast(*Node, &shell.*.nodes[at]) }
    return pointer
}

// A new node of `kind`; 0 when the table is full.
pub fn newNode(shell: *Shell, kind: u8) -> u32 {
    if shell.*.nodeCount >= MAX_NODES { return 0 }
    const index = shell.*.nodeCount
    shell.*.nodeCount += 1
    const node = nodeAt(shell, @intCast(u32, index))
    node.*.kind = kind
    node.*.flags = 0
    node.*.number = 0
    node.*.first = 0
    node.*.next = 0
    node.*.text = 0
    node.*.length = 0
    node.*.extra = 0
    return @intCast(u32, index)
}

// Appends `child` to `parent`'s children.
pub fn addChild(shell: *Shell, parent: u32, child: u32) -> void {
    if child == 0 { return }
    const node = nodeAt(shell, parent)
    if node.*.first == 0 {
        node.*.first = child
        return
    }
    var last = node.*.first
    while nodeAt(shell, last).*.next != 0 { last = nodeAt(shell, last).*.next }
    nodeAt(shell, last).*.next = child
}

pub fn wordText(shell: *Shell, node: u32) -> []const u8 {
    const word = nodeAt(shell, node)
    return textOf(shell, word.*.text, word.*.length)
}

// ---------------------------------------------------------------------------
// The work stack

pub fn workBytes(shell: *Shell) -> [*]u8 {
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, &shell.*.work) }
    return pointer
}

pub fn workMark(shell: *Shell) -> usize { return shell.*.workLength }

pub fn workRelease(shell: *Shell, mark: usize) -> void { shell.*.workLength = mark }

// `count` bytes from the work stack (aligned to 8), or null when full.
pub fn workAlloc(shell: *Shell, count: usize) -> ?[*]u8 {
    const at = (shell.*.workLength + 7) & ~@intCast(usize, 7)
    if at + count > WORK_CAPACITY { return null }
    shell.*.workLength = at + count
    return offset(workBytes(shell), at)
}

pub fn offset(bytes: [*]u8, by: usize) -> [*]u8 {
    var result: [*]u8 = undefined
    unsafe { result = @ptrFromInt([*]u8, @intFromPtr(bytes) + by) }
    return result
}

// The pointer array from its `by`-th item on.
pub fn constOffsetItems(items: [*][*]const u8, by: usize) -> [*][*]const u8 {
    var result: [*][*]const u8 = undefined
    unsafe { result = @ptrFromInt([*][*]const u8, @intFromPtr(items) + by * 8) }
    return result
}

pub fn constOffset(bytes: [*]const u8, by: usize) -> [*]const u8 {
    var result: [*]const u8 = undefined
    unsafe { result = @ptrFromInt([*]const u8, @intFromPtr(bytes) + by) }
    return result
}

// Moves the NUL-terminated strings `items[first..count]` (all on the work
// stack above `mark`, in order) down to `mark`, dropping whatever lies
// between them; the stack then ends after the last one.
pub fn compactStrings(shell: *Shell, items: [*][*]const u8, first: usize, count: usize, mark: usize) -> void {
    const bytes = workBytes(shell)
    var at = mark
    var index = first
    while index < count {
        const source = std.text.cString(items[index])
        // Each destination lies at or below its source: copying upwards is safe.
        var byte: usize = 0
        while byte < source.length {
            bytes[at + byte] = source[byte]
            byte += 1
        }
        bytes[at + source.length] = 0
        items[index] = constOffset(bytes, at)
        at += source.length + 1
        index += 1
    }
    shell.*.workLength = at
}

// A copy of `text` on the work stack, NUL-terminated; its pointer.
pub fn workString(shell: *Shell, text: []const u8) -> ?[*]u8 {
    const memory = workAlloc(shell, text.length + 1)
    if memory == null { return null }
    const bytes = memory.?
    var index: usize = 0
    for byte in text {
        bytes[index] = byte
        index += 1
    }
    bytes[text.length] = 0
    return bytes
}

// ---------------------------------------------------------------------------
// Variables

fn variableBytes(shell: *Shell) -> [*]u8 {
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, &shell.*.variableBytes) }
    return pointer
}

pub fn variableAt(shell: *Shell, index: usize) -> *Variable {
    var pointer: *Variable = undefined
    unsafe { pointer = @ptrCast(*Variable, &shell.*.variables[index]) }
    return pointer
}

pub fn variableName(shell: *Shell, variable: *Variable) -> []const u8 {
    const bytes = variableBytes(shell)
    return bytes[variable.*.name..variable.*.name + variable.*.nameLength]
}

pub fn variableValue(shell: *Shell, variable: *Variable) -> []const u8 {
    const bytes = variableBytes(shell)
    return bytes[variable.*.value..variable.*.value + variable.*.valueLength]
}

pub fn findVariable(shell: *Shell, name: []const u8) -> ?*Variable {
    var index: usize = 0
    while index < shell.*.variableCount {
        const variable = variableAt(shell, index)
        if variable.*.used && std.text.same(variableName(shell, variable), name) { return variable }
        index += 1
    }
    return null
}

pub fn getVariable(shell: *Shell, name: []const u8) -> ?[]const u8 {
    const found = findVariable(shell, name)
    if found == null { return null }
    return variableValue(shell, found.?)
}

// Appends `text` to the variable arena; its offset (compacting first when
// the arena is nearly full).
fn keepBytes(shell: *Shell, text: []const u8) -> usize {
    if shell.*.variableLength + text.length > VARIABLE_CAPACITY * 3 / 4 { compact(shell) }
    if shell.*.variableLength + text.length > VARIABLE_CAPACITY { return VARIABLE_CAPACITY }
    const at = shell.*.variableLength
    const bytes = variableBytes(shell)
    var index: usize = 0
    for byte in text {
        bytes[at + index] = byte
        index += 1
    }
    shell.*.variableLength += text.length
    return at
}

// Rewrites the arena with the live variables' names and values only.
fn compact(shell: *Shell) -> void {
    const bytes = variableBytes(shell)
    var used: usize = 0
    var index: usize = 0
    while index < shell.*.variableCount {
        const variable = variableAt(shell, index)
        if variable.*.used {
            const name_length = @intCast(usize, variable.*.nameLength)
            const value_length = @intCast(usize, variable.*.valueLength)
            const name_at = @intCast(usize, variable.*.name)
            const value_at = @intCast(usize, variable.*.value)
            var at: usize = 0
            while at < name_length {
                bytes[used + at] = bytes[name_at + at]
                at += 1
            }
            variable.*.name = @intCast(u32, used)
            used += name_length
            at = 0
            while at < value_length {
                bytes[used + at] = bytes[value_at + at]
                at += 1
            }
            variable.*.value = @intCast(u32, used)
            used += value_length
        }
        index += 1
    }
    shell.*.variableLength = used
}

// Sets `name` to `value` (a new variable is not exported unless `exported`
// asks; a known one keeps its export). False for a readonly variable or a
// full table.
pub fn setVariable(shell: *Shell, name: []const u8, value: []const u8, exported: bool) -> bool {
    const found = findVariable(shell, name)
    if found != null {
        const variable = found.?
        if variable.*.readonly { return false }
        const at = keepBytes(shell, value)
        if at == VARIABLE_CAPACITY { return false }
        // keepBytes may have compacted: the pointer stays, the offsets changed.
        variable.*.value = @intCast(u32, at)
        variable.*.valueLength = @intCast(u32, value.length)
        if exported { variable.*.exported = true }
        return true
    }
    var slot: usize = shell.*.variableCount
    var index: usize = 0
    while index < shell.*.variableCount {
        if !variableAt(shell, index).*.used {
            slot = index
            break
        }
        index += 1
    }
    if slot == shell.*.variableCount {
        if slot >= MAX_VARIABLES { return false }
        shell.*.variableCount += 1
    }
    const name_at = keepBytes(shell, name)
    const value_at = keepBytes(shell, value)
    if name_at == VARIABLE_CAPACITY || value_at == VARIABLE_CAPACITY { return false }
    const variable = variableAt(shell, slot)
    variable.*.name = @intCast(u32, name_at)
    variable.*.nameLength = @intCast(u32, name.length)
    variable.*.value = @intCast(u32, value_at)
    variable.*.valueLength = @intCast(u32, value.length)
    variable.*.exported = exported
    variable.*.readonly = false
    variable.*.used = true
    return true
}

pub fn unsetVariable(shell: *Shell, name: []const u8) -> bool {
    const found = findVariable(shell, name)
    if found == null { return true }
    if found.?.*.readonly { return false }
    found.?.*.used = false
    return true
}

// Marks `name` exported (made empty when unknown).
pub fn exportVariable(shell: *Shell, name: []const u8) -> void {
    const found = findVariable(shell, name)
    if found != null {
        found.?.*.exported = true
        return
    }
    const set = setVariable(shell, name, "", true)
}

// Takes the process environment in as exported variables.
pub fn importEnvironment(shell: *Shell, entries: [*][*]const u8) -> void {
    var index: usize = 0
    while @intFromPtr(entries[index]) != 0 {
        const entry = std.text.cString(entries[index])
        var equals: usize = 0
        while equals < entry.length && entry[equals] != 61 { equals += 1 }
        if equals > 0 && equals < entry.length {
            const set = setVariable(shell, entry[0..equals], entry[equals + 1..entry.length], true)
        }
        index += 1
    }
}

// The exported variables as NAME=VALUE strings on the work stack, for
// execve; null when the stack is full.
pub fn buildEnvironment(shell: *Shell) -> ?[*][*]const u8 {
    var count: usize = 0
    var index: usize = 0
    while index < shell.*.variableCount {
        const variable = variableAt(shell, index)
        if variable.*.used && variable.*.exported { count += 1 }
        index += 1
    }
    const memory = workAlloc(shell, (count + 1) * 8)
    if memory == null { return null }
    var items: [*][*]const u8 = undefined
    unsafe { items = @ptrCast([*][*]const u8, memory.?) }
    var used: usize = 0
    index = 0
    while index < shell.*.variableCount {
        const variable = variableAt(shell, index)
        if variable.*.used && variable.*.exported {
            const name = variableName(shell, variable)
            const value = variableValue(shell, variable)
            const entry = workAlloc(shell, name.length + value.length + 2)
            if entry == null { return null }
            const bytes = entry.?
            var at = std.text.append(bytes, 0, name.length + value.length + 2, name)
            at = std.text.append(bytes, at, name.length + value.length + 2, "=")
            at = std.text.append(bytes, at, name.length + value.length + 2, value)
            bytes[at] = 0
            items[used] = bytes
            used += 1
        }
        index += 1
    }
    unsafe { items[used] = @ptrFromInt([*]const u8, 0) }
    return items
}

// ---------------------------------------------------------------------------
// Functions

fn functionBytes(shell: *Shell) -> [*]u8 {
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, &shell.*.functionBytes) }
    return pointer
}

pub fn functionAt(shell: *Shell, index: usize) -> *Function {
    var pointer: *Function = undefined
    unsafe { pointer = @ptrCast(*Function, &shell.*.functions[index]) }
    return pointer
}

fn functionNameOf(shell: *Shell, function: *Function) -> []const u8 {
    const bytes = functionBytes(shell)
    return bytes[function.*.name..function.*.name + function.*.nameLength]
}

// The body source of function `name`, or null.
pub fn findFunction(shell: *Shell, name: []const u8) -> ?[]const u8 {
    var index: usize = 0
    while index < shell.*.functionCount {
        const function = functionAt(shell, index)
        if function.*.used && std.text.same(functionNameOf(shell, function), name) {
            const bytes = functionBytes(shell)
            return bytes[function.*.body..function.*.body + function.*.bodyLength]
        }
        index += 1
    }
    return null
}

fn keepFunctionBytes(shell: *Shell, text: []const u8) -> usize {
    if shell.*.functionLength + text.length > FUNCTION_CAPACITY { return FUNCTION_CAPACITY }
    const at = shell.*.functionLength
    const bytes = functionBytes(shell)
    var index: usize = 0
    for byte in text {
        bytes[at + index] = byte
        index += 1
    }
    shell.*.functionLength += text.length
    return at
}

// Defines (or redefines) function `name` with `body`, the source of a
// compound command.
pub fn defineFunction(shell: *Shell, name: []const u8, body: []const u8) -> bool {
    var slot: usize = shell.*.functionCount
    var index: usize = 0
    while index < shell.*.functionCount {
        const function = functionAt(shell, index)
        if function.*.used && std.text.same(functionNameOf(shell, function), name) { slot = index }
        if !function.*.used && slot == shell.*.functionCount { slot = index }
        index += 1
    }
    if slot == shell.*.functionCount {
        if slot >= MAX_FUNCTIONS { return false }
        shell.*.functionCount += 1
    }
    const name_at = keepFunctionBytes(shell, name)
    const body_at = keepFunctionBytes(shell, body)
    if name_at == FUNCTION_CAPACITY || body_at == FUNCTION_CAPACITY { return false }
    const function = functionAt(shell, slot)
    function.*.name = @intCast(u32, name_at)
    function.*.nameLength = @intCast(u32, name.length)
    function.*.body = @intCast(u32, body_at)
    function.*.bodyLength = @intCast(u32, body.length)
    function.*.used = true
    return true
}

pub fn undefineFunction(shell: *Shell, name: []const u8) -> void {
    var index: usize = 0
    while index < shell.*.functionCount {
        const function = functionAt(shell, index)
        if function.*.used && std.text.same(functionNameOf(shell, function), name) { function.*.used = false }
        index += 1
    }
}

// Keeps `text` in the function arena (the EXIT trap); its offset.
pub fn keepText(shell: *Shell, text: []const u8) -> usize { return keepFunctionBytes(shell, text) }

pub fn keptText(shell: *Shell, at: usize, length: usize) -> []const u8 {
    const bytes = functionBytes(shell)
    return bytes[at..at + length]
}

// ---------------------------------------------------------------------------
// Positional parameters

fn positionalBytes(shell: *Shell) -> [*]u8 {
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, &shell.*.positionalBytes) }
    return pointer
}

// The parameters of the current frame.
pub fn positionalCount(shell: *Shell) -> usize { return shell.*.positionalCount - shell.*.positionalBase }

pub fn positional(shell: *Shell, number: usize) -> []const u8 {
    // number counts from 1.
    const index = shell.*.positionalBase + number - 1
    if number == 0 || index >= shell.*.positionalCount { return "" }
    const bytes = positionalBytes(shell)
    return bytes[shell.*.positionalOffsets[index]..shell.*.positionalOffsets[index] + shell.*.positionalLengths[index]]
}

// A new frame begins (the old one is restored by popFrame with what this
// returns).
pub const Frame = struct {
    base: usize
    count: usize
    bytes: usize
}

pub fn pushFrame(shell: *Shell) -> Frame {
    const frame = Frame.{ .base = shell.*.positionalBase, .count = shell.*.positionalCount, .bytes = shell.*.positionalLength }
    shell.*.positionalBase = shell.*.positionalCount
    return frame
}

pub fn popFrame(shell: *Shell, frame: Frame) -> void {
    shell.*.positionalBase = frame.base
    shell.*.positionalCount = frame.count
    shell.*.positionalLength = frame.bytes
}

// Adds a parameter to the current frame.
pub fn pushPositional(shell: *Shell, value: []const u8) -> bool {
    if shell.*.positionalCount >= MAX_POSITIONAL || shell.*.positionalLength + value.length > POSITIONAL_CAPACITY { return false }
    const bytes = positionalBytes(shell)
    const at = shell.*.positionalLength
    var index: usize = 0
    for byte in value {
        bytes[at + index] = byte
        index += 1
    }
    shell.*.positionalOffsets[shell.*.positionalCount] = @intCast(u32, at)
    shell.*.positionalLengths[shell.*.positionalCount] = @intCast(u32, value.length)
    shell.*.positionalCount += 1
    shell.*.positionalLength += value.length
    return true
}

// Drops the first `count` parameters of the frame (shift).
pub fn shiftPositional(shell: *Shell, count: usize) -> bool {
    if count > positionalCount(shell) { return false }
    shell.*.positionalBase += count
    return true
}

// Replaces the frame's parameters (set -- ...): the frame's start moves
// to the end and new ones are pushed.
pub fn clearPositional(shell: *Shell) -> void {
    shell.*.positionalBase = shell.*.positionalCount
}

pub fn scriptName(shell: *Shell) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &shell.*.scriptName) }
    return bytes[0..shell.*.scriptNameLength]
}

pub fn setScriptName(shell: *Shell, name: []const u8) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &shell.*.scriptName) }
    shell.*.scriptNameLength = std.text.append(bytes, 0, NAME_CAPACITY, name)
}

// ---------------------------------------------------------------------------
// Messages

pub fn say(text: []const u8) -> void {
    const wrote = sys.writeAll(2, text)
}

// "mlx-sh: FIRST SECOND\n" on stderr.
pub fn complain(first: []const u8, second: []const u8) -> void {
    var line: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length = std.text.append(bytes, 0, 1024, "mlx-sh: ")
    length = std.text.append(bytes, length, 1024, first)
    length = std.text.append(bytes, length, 1024, second)
    length = std.text.append(bytes, length, 1024, "\n")
    const wrote = sys.write(2, bytes, length)
}

// "mlx-sh: FIRST SECOND: THIRD\n".
pub fn complainAbout(first: []const u8, second: []const u8, third: []const u8) -> void {
    var line: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length = std.text.append(bytes, 0, 1024, "mlx-sh: ")
    length = std.text.append(bytes, length, 1024, first)
    length = std.text.append(bytes, length, 1024, second)
    length = std.text.append(bytes, length, 1024, ": ")
    length = std.text.append(bytes, length, 1024, third)
    length = std.text.append(bytes, length, 1024, "\n")
    const wrote = sys.write(2, bytes, length)
}

// ---------------------------------------------------------------------------
// Locals

fn localBytes(shell: *Shell) -> [*]u8 {
    var pointer: [*]u8 = undefined
    unsafe { pointer = @ptrCast([*]u8, &shell.*.localBytes) }
    return pointer
}

fn localAt(shell: *Shell, index: usize) -> *Local {
    var pointer: *Local = undefined
    unsafe { pointer = @ptrCast(*Local, &shell.*.locals[index]) }
    return pointer
}

fn keepLocalBytes(shell: *Shell, text: []const u8) -> usize {
    if shell.*.localLength + text.length > LOCAL_CAPACITY { return LOCAL_CAPACITY }
    const at = shell.*.localLength
    const bytes = localBytes(shell)
    var index: usize = 0
    for byte in text {
        bytes[at + index] = byte
        index += 1
    }
    shell.*.localLength += text.length
    return at
}

// Remembers `name`'s value (or that it had none) for the function at
// `depth`, to be put back by restoreLocals.
pub fn saveLocal(shell: *Shell, name: []const u8, depth: usize) -> bool {
    if shell.*.localCount >= MAX_LOCALS { return false }
    const found = findVariable(shell, name)
    const name_at = keepLocalBytes(shell, name)
    if name_at == LOCAL_CAPACITY { return false }
    const local = localAt(shell, shell.*.localCount)
    local.*.name = @intCast(u32, name_at)
    local.*.nameLength = @intCast(u32, name.length)
    local.*.depth = depth
    local.*.existed = found != null
    local.*.exported = found != null && found.?.*.exported
    local.*.value = 0
    local.*.valueLength = 0
    if found != null {
        const value = variableValue(shell, found.?)
        const value_at = keepLocalBytes(shell, value)
        if value_at == LOCAL_CAPACITY { return false }
        local.*.value = @intCast(u32, value_at)
        local.*.valueLength = @intCast(u32, value.length)
    }
    shell.*.localCount += 1
    return true
}

// Puts back every local saved at `depth` (the function returned).
pub fn restoreLocals(shell: *Shell, depth: usize) -> void {
    const bytes = localBytes(shell)
    while shell.*.localCount > 0 && localAt(shell, shell.*.localCount - 1).*.depth >= depth {
        const local = localAt(shell, shell.*.localCount - 1)
        const name_at = @intCast(usize, local.*.name)
        const name = bytes[name_at..name_at + @intCast(usize, local.*.nameLength)]
        if local.*.existed {
            const value_at = @intCast(usize, local.*.value)
            const value = bytes[value_at..value_at + @intCast(usize, local.*.valueLength)]
            const found = findVariable(shell, name)
            if found != null { found.?.*.readonly = false }
            const set = setVariable(shell, name, value, local.*.exported)
            const again = findVariable(shell, name)
            if again != null { again.?.*.exported = local.*.exported }
        } else {
            const unset = unsetVariable(shell, name)
        }
        shell.*.localCount -= 1
        shell.*.localLength = name_at
    }
}

// The working directory, read from the kernel once per change.
pub fn workingDirectory(shell: *Shell) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &shell.*.workingDirectory) }
    return bytes[0..shell.*.workingDirectoryLength]
}

pub fn refreshWorkingDirectory(shell: *Shell) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &shell.*.workingDirectory) }
    shell.*.workingDirectoryLength = sys.workingDirectory(bytes, 4096)
}
