// Programs: finding them along PATH and running them in a child (also
// the shell's own `exec` and `command`), and reaping background jobs.
// Below exec.mlx and builtins.mlx, which both need these.
const std = @import("std")
const sys = @import("./sys.mlx")
const state = @import("./state.mlx")
const expand = @import("./expand.mlx")

const Shell = state.Shell

// Looks `name` up along PATH into `into` (NUL-terminated); false when it
// is nowhere.
pub fn findInPath(shell: *Shell, name: []const u8, into: [*]u8, capacity: usize) -> bool {
    for byte in name {
        if byte == 47 {
            const length = std.text.append(into, 0, capacity - 1, name)
            into[length] = 0
            return sys.access(name, 1)
        }
    }
    var path: []const u8 = "/usr/local/bin:/usr/bin:/bin"
    const variable = state.getVariable(shell, "PATH")
    if variable != null { path = variable.? }
    var start: usize = 0
    while start <= path.length {
        var end = start
        while end < path.length && path[end] != 58 { end += 1 }
        var length: usize = 0
        if end > start { length = std.text.append(into, 0, capacity - 1, path[start..end]) } else { length = std.text.append(into, 0, capacity - 1, ".") }
        length = std.text.append(into, length, capacity - 1, "/")
        length = std.text.append(into, length, capacity - 1, name)
        into[length] = 0
        if sys.access(into[0..length], 1) { return true }
        start = end + 1
    }
    return false
}

// In a child: runs the program (fields[0]) with the fields as arguments
// and the exported variables as environment; never returns.
pub fn executeProgram(shell: *Shell, fields: *expand.Fields) -> void {
    const name = std.text.cString(fields.*.items[0])
    var path: [4096]u8 = undefined
    var path_bytes: [*]u8 = undefined
    unsafe { path_bytes = @ptrCast([*]u8, &path) }
    if !findInPath(shell, name, path_bytes, 4096) {
        state.complainAbout("", name, "command not found")
        sys.exit(127)
    }
    const environment = state.buildEnvironment(shell)
    if environment == null { sys.exit(126) }
    sys.setSignal(sys.SIGINT, 0)
    sys.setSignal(sys.SIGQUIT, 0)
    sys.setSignal(sys.SIGPIPE, 0)
    var none: [2]usize = [2]usize{ 0, 0 }
    const unblocked = std.linux.syscall4(sys.SYS_rt_sigprocmask, 2, @intFromPtr(&none), 0, 8)
    const result = sys.execute(path_bytes, fields.*.items, environment.?)
    if result == -8 {
        // ENOEXEC: a script without #!: this shell runs it.
        var self_path: [*]const u8 = undefined
        unsafe { self_path = @ptrCast([*]const u8, "/proc/self/exe") }
        var argv: [expand.MAX_FIELDS][*]const u8 = undefined
        var argv_pointer: [*][*]const u8 = undefined
        unsafe { argv_pointer = @ptrCast([*][*]const u8, &argv) }
        argv[0] = self_path
        argv[1] = path_bytes
        var index: usize = 1
        while index < fields.*.count && index + 1 < expand.MAX_FIELDS {
            argv[index + 1] = fields.*.items[index]
            index += 1
        }
        unsafe { argv[index + 1] = @ptrFromInt([*]const u8, 0) }
        const again = sys.execute(self_path, argv_pointer, environment.?)
    }
    state.complainAbout("", name, if result == -13 { "permission denied" } else { "cannot execute" })
    sys.exit(126)
}

// Finished background jobs are reaped (for the prompt).
pub fn reapJobs(shell: *Shell) -> void {
    var index: usize = 0
    while index < shell.*.jobCount {
        var raw: usize = 0
        const done = sys.wait(shell.*.jobs[index], &raw, true)
        if done == shell.*.jobs[index] || done < 0 {
            shell.*.jobs[index] = shell.*.jobs[shell.*.jobCount - 1]
            shell.*.jobCount -= 1
        } else {
            index += 1
        }
    }
}
