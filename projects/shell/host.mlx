// How flux makes and looks after its processes, on the system it runs
// on: Linux's calls here (fork, execve, wait4, setpgid, tcsetpgrp, kill);
// host.brixos.mlx has brixOS's own (branch, replace, process_change,
// group_join, session_front, event_send), which the compiler takes for
// --target=x86_64-brixos. A child is an id (here a pid), a group too
// (here its number); statuses are wait4's words and signals Linux's
// numbers, which the shell speaks (as POSIX's).
const std = @import("std")
const tty = @import("std.terminal.tty")

// fork: 0 in the child, the child's id in the shell, or -errno.
pub fn fork() -> isize { return std.linux.process.fork() }

// execve: returns only when it failed (-errno; -8: no program format it
// knows, a script for this shell).
pub fn execute(path: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8) -> isize {
    return std.linux.process.execute(path, arguments, environment)
}

// The program this shell is, for a script without #!.
pub fn selfPath() -> [*]const u8 { return unsafe { @ptrCast([*]const u8, "/proc/self/exe") } }

// wait4 on `id` (-1: any child): its id with its status word in `raw`, 0
// with WNOHANG while nothing changed, or -errno.
pub fn waitChild(id: isize, raw: *usize, flags: usize) -> isize { return std.linux.process.waitProcess(id, raw, flags) }

// The shell's own group.
pub fn ownGroup() -> isize { return tty.processGroup() }

// The process `id` (0: the caller) into the group `group` (0: a new one,
// numbered as the process): that group's id.
pub fn joinGroup(id: isize, group: isize) -> isize {
    const process = if id == 0 { std.linux.getpid() } else { id }
    const number = if group == 0 { process } else { group }
    _ = tty.setProcessGroup(id, number)
    return number
}

// A group id joinGroup gave that is not kept (nothing to let go here).
pub fn dropGroup(group: isize) -> void {}

// Whether `group` is in front of the terminal `terminal`.
pub fn inFront(terminal: isize, group: isize) -> bool { return tty.foregroundGroup(terminal) == group }

pub fn setFront(terminal: isize, group: isize) -> void { _ = tty.setForegroundGroup(terminal, group) }

// Signal `number` to the process `target` (negative: to the group -target);
// 0 or -errno.
pub fn signal(target: isize, number: usize) -> isize { return std.linux.process.kill(target, number) }

// A pipe whose ends go when a program replaces the child (O_CLOEXEC).
pub fn pipe(read_end: *isize, write_end: *isize) -> bool { return std.linux.pipe(read_end, write_end, std.linux.O_CLOEXEC) }
