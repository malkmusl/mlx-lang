// Traps (`trap ACTION SIGNAL...`): the action of a trapped signal runs
// after the command during which the signal arrived, as it does in dash.
// The shell keeps a trapped signal blocked, so it waits as pending while
// a command runs, and takes the pending ones (rt_sigtimedwait with no
// wait) between the commands of a list, before a prompt and in `wait`;
// an action of nothing ignores the signal; EXIT (slot 0) runs when the
// shell ends. A child of the shell gets the caught signals back at their
// defaults.
const std = @import("std")
const sys = @import("./sys.mlx")
const state = @import("./state.mlx")

const Shell = state.Shell

pub const EXIT: usize = 0

// The number of a signal from its name (with or without SIG, or a
// number); state.MAX_SIGNALS when it is no signal the shell traps.
pub fn signalNumber(name: []const u8) -> usize {
    var text = name
    if text.length > 3 && text[0] == 83 && text[1] == 73 && text[2] == 71 { text = text[3..text.length] }
    if text.length > 0 && text[0] >= 48 && text[0] <= 57 {
        var value: usize = 0
        for byte in text {
            if byte < 48 || byte > 57 { return state.MAX_SIGNALS }
            value = value * 10 + @intCast(usize, byte - 48)
        }
        if value >= state.MAX_SIGNALS { return state.MAX_SIGNALS }
        return value
    }
    if std.text.same(text, "EXIT") { return EXIT }
    if std.text.same(text, "HUP") { return 1 }
    if std.text.same(text, "INT") { return 2 }
    if std.text.same(text, "QUIT") { return 3 }
    if std.text.same(text, "ILL") { return 4 }
    if std.text.same(text, "TRAP") { return 5 }
    if std.text.same(text, "ABRT") { return 6 }
    if std.text.same(text, "BUS") { return 7 }
    if std.text.same(text, "FPE") { return 8 }
    if std.text.same(text, "KILL") { return 9 }
    if std.text.same(text, "USR1") { return 10 }
    if std.text.same(text, "SEGV") { return 11 }
    if std.text.same(text, "USR2") { return 12 }
    if std.text.same(text, "PIPE") { return 13 }
    if std.text.same(text, "ALRM") { return 14 }
    if std.text.same(text, "TERM") { return 15 }
    if std.text.same(text, "CHLD") { return 17 }
    if std.text.same(text, "CONT") { return 18 }
    if std.text.same(text, "STOP") { return 19 }
    if std.text.same(text, "TSTP") { return 20 }
    if std.text.same(text, "TTIN") { return 21 }
    if std.text.same(text, "TTOU") { return 22 }
    if std.text.same(text, "URG") { return 23 }
    if std.text.same(text, "XCPU") { return 24 }
    if std.text.same(text, "XFSZ") { return 25 }
    if std.text.same(text, "VTALRM") { return 26 }
    if std.text.same(text, "PROF") { return 27 }
    if std.text.same(text, "WINCH") { return 28 }
    if std.text.same(text, "IO") { return 29 }
    if std.text.same(text, "PWR") { return 30 }
    if std.text.same(text, "SYS") { return 31 }
    return state.MAX_SIGNALS
}

// The name of signal `number` without SIG (EXIT for 0).
pub fn signalName(number: usize) -> []const u8 {
    if number == 0 { return "EXIT" }
    if number == 1 { return "HUP" }
    if number == 2 { return "INT" }
    if number == 3 { return "QUIT" }
    if number == 4 { return "ILL" }
    if number == 5 { return "TRAP" }
    if number == 6 { return "ABRT" }
    if number == 7 { return "BUS" }
    if number == 8 { return "FPE" }
    if number == 9 { return "KILL" }
    if number == 10 { return "USR1" }
    if number == 11 { return "SEGV" }
    if number == 12 { return "USR2" }
    if number == 13 { return "PIPE" }
    if number == 14 { return "ALRM" }
    if number == 15 { return "TERM" }
    if number == 16 { return "STKFLT" }
    if number == 17 { return "CHLD" }
    if number == 18 { return "CONT" }
    if number == 19 { return "STOP" }
    if number == 20 { return "TSTP" }
    if number == 21 { return "TTIN" }
    if number == 22 { return "TTOU" }
    if number == 23 { return "URG" }
    if number == 24 { return "XCPU" }
    if number == 25 { return "XFSZ" }
    if number == 26 { return "VTALRM" }
    if number == 27 { return "PROF" }
    if number == 28 { return "WINCH" }
    if number == 29 { return "IO" }
    if number == 30 { return "PWR" }
    return "SYS"
}

pub fn isSet(shell: *Shell, signal: usize) -> bool { return shell.*.trapSet[signal] }

// The action of a trap (empty for an ignored signal or none).
pub fn action(shell: *Shell, signal: usize) -> []const u8 {
    if !shell.*.trapSet[signal] { return "" }
    return state.keptText(shell, @intCast(usize, shell.*.trapAt[signal]), @intCast(usize, shell.*.trapLength[signal]))
}

// What a signal does when the shell has no trap for it: an interactive
// shell ignores INT and QUIT, one with job control TSTP, TTIN and TTOU.
fn defaultDisposition(shell: *Shell, signal: usize) -> usize {
    if shell.*.interactive && (signal == sys.SIGINT || signal == sys.SIGQUIT) { return 1 }
    if shell.*.jobControl && (signal == sys.SIGTSTP || signal == sys.SIGTTIN || signal == sys.SIGTTOU) { return 1 }
    return 0
}

fn refreshMask(shell: *Shell) -> void {
    var mask: usize = 0
    var signal: usize = 1
    while signal < state.MAX_SIGNALS {
        if shell.*.trapSet[signal] && shell.*.trapLength[signal] > 0 { mask |= sys.signalBit(signal) }
        signal += 1
    }
    shell.*.trappedMask = mask
}

// Sets the trap of `signal` to `text` (empty: ignore it), or back to the
// default with null. KILL and STOP cannot be trapped; false then, or when
// the arena is full.
pub fn set(shell: *Shell, signal: usize, text: ?[]const u8) -> bool {
    if signal >= state.MAX_SIGNALS || signal == sys.SIGKILL || signal == sys.SIGSTOP { return false }
    if text == null {
        shell.*.trapSet[signal] = false
        shell.*.trapLength[signal] = 0
        if signal > 0 {
            sys.setSignal(signal, defaultDisposition(shell, signal))
            const unblocked = sys.changeSignalMask(sys.SIG_UNBLOCK, sys.signalBit(signal))
        }
        refreshMask(shell)
        return true
    }
    const given = text.?
    var at: usize = 0
    if given.length > 0 {
        at = state.keepText(shell, given)
        if at == state.FUNCTION_CAPACITY { return false }
    }
    shell.*.trapAt[signal] = @intCast(u32, at)
    shell.*.trapLength[signal] = @intCast(u32, given.length)
    shell.*.trapSet[signal] = true
    if signal > 0 {
        if given.length == 0 {
            sys.setSignal(signal, 1)
            const unblocked = sys.changeSignalMask(sys.SIG_UNBLOCK, sys.signalBit(signal))
        } else {
            // Caught: the default action must not happen, so the signal
            // stays blocked and pending until the shell takes it.
            sys.setSignal(signal, 0)
            const blocked = sys.changeSignalMask(sys.SIG_BLOCK, sys.signalBit(signal))
        }
    }
    refreshMask(shell)
    return true
}

// Runs the action of `signal` (nothing for an ignored or untrapped one);
// $? is as it was before.
pub fn run(shell: *Shell, signal: usize) -> void {
    if shell.*.exiting || !shell.*.trapSet[signal] || shell.*.trapLength[signal] == 0 { return }
    const saved = shell.*.lastStatus
    const text = action(shell, signal)
    const ignored = shell.*.runText(@ptrCast(*anyopaque, shell), text)
    shell.*.lastStatus = saved
}

// Runs the actions of the trapped signals that arrived (between commands).
pub fn runPending(shell: *Shell) -> void {
    if shell.*.trappedMask == 0 { return }
    var taken: usize = 0
    while taken < 64 {
        const signal = sys.takeSignal(shell.*.trappedMask, 0)
        if signal == 0 { return }
        run(shell, signal)
        taken += 1
    }
}

// Runs the EXIT trap, once.
pub fn runExit(shell: *Shell) -> void {
    if !shell.*.trapSet[EXIT] || shell.*.trapLength[EXIT] == 0 { return }
    const text = action(shell, EXIT)
    shell.*.trapSet[EXIT] = false
    shell.*.exiting = false
    const ignored = shell.*.runText(@ptrCast(*anyopaque, shell), text)
}

// In a child of the shell: the caught signals go back to their defaults
// (ignored ones stay ignored), nothing stays blocked, and the child owes
// no EXIT trap.
pub fn resetInChild(shell: *Shell) -> void {
    var signal: usize = 1
    while signal < state.MAX_SIGNALS {
        if shell.*.trapSet[signal] && shell.*.trapLength[signal] > 0 {
            sys.setSignal(signal, 0)
            shell.*.trapSet[signal] = false
            shell.*.trapLength[signal] = 0
        }
        signal += 1
    }
    shell.*.trapSet[EXIT] = false
    shell.*.trappedMask = 0
    const cleared = sys.changeSignalMask(sys.SIG_SETMASK, 0)
}
