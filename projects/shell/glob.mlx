// Pathname expansion and pattern matching: * ? [...] (with ranges and
// ! or ^ negation), the pattern's quoted bytes taken literally. patternMatch()
// is also case's and ${#}/${%}'s pattern test.
const std = @import("std")
const state = @import("./state.mlx")

const Shell = state.Shell

// Whether `text` matches `pattern`; `literal[i]` says byte i of the
// pattern stands for itself (it was quoted). A name starting with '.' is
// matched by a pattern starting with '.' only when `hidden_too` is false.
pub fn patternMatch(pattern: []const u8, literal: [*]const u8, text: []const u8) -> bool {
    return matchFrom(pattern, literal, 0, text, 0)
}

fn matchFrom(pattern: []const u8, literal: [*]const u8, pattern_at: usize, text: []const u8, text_at: usize) -> bool {
    var p = pattern_at
    var t = text_at
    while p < pattern.length {
        const byte = pattern[p]
        const special = literal[p] & 1 == 0
        if special && byte == 42 {
            // Several stars are one.
            while p < pattern.length && pattern[p] == 42 && literal[p] & 1 == 0 { p += 1 }
            if p >= pattern.length { return true }
            var try_at = t
            while try_at <= text.length {
                if matchFrom(pattern, literal, p, text, try_at) { return true }
                try_at += 1
            }
            return false
        }
        if t >= text.length { return false }
        if special && byte == 63 {
            p += 1
            t += 1
            continue
        }
        if special && byte == 91 {
            var end = p + 1
            var negate = false
            if end < pattern.length && (pattern[end] == 33 || pattern[end] == 94) {
                negate = true
                end += 1
            }
            // The closing bracket: a ']' right after the opening is literal.
            var close = end
            if close < pattern.length && pattern[close] == 93 { close += 1 }
            while close < pattern.length && (pattern[close] != 93 || literal[close] & 1 != 0) { close += 1 }
            if close >= pattern.length {
                // No closing bracket: a literal '['.
                if byte != text[t] { return false }
                p += 1
                t += 1
                continue
            }
            var matched = false
            var scan = end
            while scan < close {
                if scan + 2 < close && pattern[scan + 1] == 45 {
                    if text[t] >= pattern[scan] && text[t] <= pattern[scan + 2] { matched = true }
                    scan += 3
                } else {
                    if text[t] == pattern[scan] { matched = true }
                    scan += 1
                }
            }
            if matched == negate { return false }
            p = close + 1
            t += 1
            continue
        }
        if byte != text[t] { return false }
        p += 1
        t += 1
    }
    return t == text.length
}

fn hasSpecial(pattern: []const u8, literal: [*]const u8) -> bool {
    var index: usize = 0
    while index < pattern.length {
        if literal[index] & 1 == 0 && (pattern[index] == 42 || pattern[index] == 63 || pattern[index] == 91) { return true }
        index += 1
    }
    return false
}

// Names (sorted) in `directory` ("" for the current one) matching one
// component; each appended to `prefix` and handed to `found`.
pub const MAX_MATCHES: usize = 4096

pub const Matches = struct {
    // Offsets into the work stack, one per path.
    offsets: [MAX_MATCHES]usize
    count: usize
}

fn addMatch(shell: *Shell, matches: *Matches, path: []const u8) -> void {
    if matches.*.count >= MAX_MATCHES { return }
    const copy = state.workString(shell, path)
    if copy == null { return }
    matches.*.offsets[matches.*.count] = @intFromPtr(copy.?) - @intFromPtr(state.workBytes(shell))
    matches.*.count += 1
}

pub fn matchText(shell: *Shell, matches: *Matches, index: usize) -> []const u8 {
    const bytes = state.workBytes(shell)
    const at = matches.*.offsets[index]
    var length: usize = 0
    while bytes[at + length] != 0 { length += 1 }
    return bytes[at..at + length]
}

fn before(left: []const u8, right: []const u8) -> bool {
    var index: usize = 0
    while index < left.length && index < right.length {
        if left[index] != right[index] { return left[index] < right[index] }
        index += 1
    }
    return left.length < right.length
}

// Sorts the matches from `from` on (insertion sort; the lists are short).
fn sortFrom(shell: *Shell, matches: *Matches, from: usize) -> void {
    var index = from + 1
    while index < matches.*.count {
        var at = index
        while at > from && before(matchText(shell, matches, at), matchText(shell, matches, at - 1)) {
            const swapped = matches.*.offsets[at]
            matches.*.offsets[at] = matches.*.offsets[at - 1]
            matches.*.offsets[at - 1] = swapped
            at -= 1
        }
        index += 1
    }
}

// Expands `pattern` (with its `literal` flags) against the file system
// into `matches` (paths on the work stack, sorted per directory). False
// when nothing matched (the caller keeps the word).
pub fn expand(shell: *Shell, pattern: []const u8, literal: [*]const u8, matches: *Matches) -> bool {
    matches.*.count = 0
    if !hasSpecial(pattern, literal) { return false }
    var prefix: [4096]u8 = undefined
    var prefix_bytes: [*]u8 = undefined
    unsafe { prefix_bytes = @ptrCast([*]u8, &prefix) }
    var prefix_length: usize = 0
    var at: usize = 0
    if pattern.length > 0 && pattern[0] == 47 {
        prefix[0] = 47
        prefix_length = 1
        at = 1
    }
    expandFrom(shell, pattern, literal, at, prefix_bytes, prefix_length, matches)
    return matches.*.count > 0
}

// One path component at a time: literal components are appended to the
// prefix, patterns are matched against the directory's entries.
fn expandFrom(shell: *Shell, pattern: []const u8, literal: [*]const u8, from: usize, prefix: [*]u8, prefix_length: usize, matches: *Matches) -> void {
    var end = from
    while end < pattern.length && pattern[end] != 47 { end += 1 }
    const component = pattern[from..end]
    const last = end >= pattern.length
    var component_literal: [*]const u8 = undefined
    unsafe { component_literal = @ptrFromInt([*]const u8, @intFromPtr(literal) + from) }
    if !hasSpecial(component, component_literal) {
        var length = std.text.append(prefix, prefix_length, 4096, component)
        if last {
            if length > 0 && std.fs.exists(nulTerminated(prefix, length)) { addMatch(shell, matches, prefix[0..length]) }
            return
        }
        length = std.text.append(prefix, length, 4096, "/")
        // Collapse several slashes.
        var next = end
        while next < pattern.length && pattern[next] == 47 { next += 1 }
        expandFrom(shell, pattern, literal, next, prefix, length, matches)
        return
    }
    // The directory to read: the prefix so far ("." when empty).
    var directory_path: [4096]u8 = undefined
    var directory_bytes: [*]u8 = undefined
    unsafe { directory_bytes = @ptrCast([*]u8, &directory_path) }
    var directory_length: usize = 0
    if prefix_length == 0 {
        directory_length = std.text.append(directory_bytes, 0, 4096, ".")
    } else {
        directory_length = std.text.append(directory_bytes, 0, 4096, prefix[0..prefix_length])
    }
    const directory = std.fs.open(nulTerminated(directory_bytes, directory_length), 65536, 0)
    if !std.fs.isValid(directory) { return }
    var names: [65536]u8 = undefined
    var names_bytes: [*]u8 = undefined
    unsafe { names_bytes = @ptrCast([*]u8, &names) }
    var reader = std.fs.entries(directory, names_bytes, 65536)
    var entry: std.fs.Entry = undefined
    const first_match = matches.*.count
    const wants_hidden = component.length > 0 && component[0] == 46 && component_literal[0] & 1 != 0 || (component.length > 0 && component[0] == 46)
    while std.fs.nextEntry(&reader, &entry) {
        const name = std.string.asSlice(entry.name)
        if std.text.same(name, ".") || std.text.same(name, "..") { continue }
        if name.length > 0 && name[0] == 46 && !wants_hidden { continue }
        if !patternMatch(component, component_literal, name) { continue }
        var length = std.text.append(prefix, prefix_length, 4096, name)
        if last {
            addMatch(shell, matches, prefix[0..length])
        } else {
            length = std.text.append(prefix, length, 4096, "/")
            var next = end
            while next < pattern.length && pattern[next] == 47 { next += 1 }
            // Only directories go on.
            if std.fs.exists(nulTerminated(prefix, length)) { expandFrom(shell, pattern, literal, next, prefix, length, matches) }
        }
    }
    const closed = std.fs.close(directory)
    sortFrom(shell, matches, first_match)
}

fn nulTerminated(bytes: [*]u8, length: usize) -> [*]const u8 {
    bytes[length] = 0
    return bytes
}
