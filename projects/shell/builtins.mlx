// The builtins: what a shell must do itself (cd, exit, export, set, shift,
// read, eval, exec, source, return, break, continue, local, trap, wait,
// jobs, fg, bg, kill, getopts, alias, unalias, umask, type, command,
// history, hash, :, true, false) and what it does for speed (echo,
// printf, test and [).
const std = @import("std")
const sys = @import("./sys.mlx")
const state = @import("./state.mlx")
const expand = @import("./expand.mlx")
const programs = @import("./programs.mlx")
const arith = @import("./arith.mlx")
const jobs = @import("./jobs.mlx")
const traps = @import("./traps.mlx")

const Shell = state.Shell
const Fields = expand.Fields

pub fn isBuiltin(name: []const u8) -> bool {
    return std.text.same(name, ":") || std.text.same(name, ".") || std.text.same(name, "source") || std.text.same(name, "alias") || std.text.same(name, "unalias") || std.text.same(name, "break") || std.text.same(name, "continue") || std.text.same(name, "cd") || std.text.same(name, "command") || std.text.same(name, "echo") || std.text.same(name, "eval") || std.text.same(name, "exec") || std.text.same(name, "exit") || std.text.same(name, "export") || std.text.same(name, "readonly") || std.text.same(name, "false") || std.text.same(name, "true") || std.text.same(name, "fg") || std.text.same(name, "bg") || std.text.same(name, "getopts") || std.text.same(name, "hash") || std.text.same(name, "help") || std.text.same(name, "history") || std.text.same(name, "jobs") || std.text.same(name, "kill") || std.text.same(name, "local") || std.text.same(name, "printf") || std.text.same(name, "pwd") || std.text.same(name, "read") || std.text.same(name, "return") || std.text.same(name, "set") || std.text.same(name, "shift") || std.text.same(name, "test") || std.text.same(name, "[") || std.text.same(name, "trap") || std.text.same(name, "type") || std.text.same(name, "umask") || std.text.same(name, "unset") || std.text.same(name, "wait")
}

fn arg(fields: *Fields, index: usize) -> []const u8 {
    if index >= fields.*.count { return "" }
    return std.text.cString(fields.*.items[index])
}

fn out(text: []const u8) -> void {
    const wrote = sys.writeAll(1, text)
}

fn outLine(text: []const u8) -> void {
    out(text)
    out("\n")
}

fn number(text: []const u8, value: *isize) -> bool {
    if text.length == 0 { return false }
    var index: usize = 0
    var negative = false
    if text[0] == 45 || text[0] == 43 {
        negative = text[0] == 45
        index = 1
    }
    if index >= text.length { return false }
    var result: isize = 0
    while index < text.length {
        const byte = text[index]
        if byte < 48 || byte > 57 { return false }
        result = result * 10 + @intCast(isize, byte - 48)
        index += 1
    }
    value.* = if negative { 0 - result } else { result }
    return true
}

fn appendOut(into: [*]u8, at: usize, capacity: usize, text: []const u8) -> usize { return std.text.append(into, at, capacity, text) }

// ---------------------------------------------------------------------------
// echo and printf

// One escape after a backslash in echo -e / printf; the bytes it stands
// for appended, the index after the escape returned.
fn escapeInto(text: []const u8, at: usize, into: [*]u8, length: *usize, capacity: usize, stop: *bool) -> usize {
    if at >= text.length {
        if length.* < capacity {
            into[length.*] = 92
            length.* += 1
        }
        return at
    }
    const byte = text[at]
    var value: u8 = 0
    var consumed: usize = 1
    if byte == 110 {
        value = 10
    } else if byte == 116 {
        value = 9
    } else if byte == 92 {
        value = 92
    } else if byte == 97 {
        value = 7
    } else if byte == 98 {
        value = 8
    } else if byte == 101 || byte == 69 {
        value = 27
    } else if byte == 102 {
        value = 12
    } else if byte == 114 {
        value = 13
    } else if byte == 118 {
        value = 11
    } else if byte == 99 {
        stop.* = true
        return at + 1
    } else if byte == 48 || (byte >= 49 && byte <= 55) {
        // \0NNN (echo) or \NNN (printf): up to three octal digits.
        var digits: usize = 0
        var index = if byte == 48 { at + 1 } else { at }
        var octal: usize = 0
        while digits < 3 && index < text.length && text[index] >= 48 && text[index] <= 55 {
            octal = octal * 8 + @intCast(usize, text[index] - 48)
            digits += 1
            index += 1
        }
        value = @intCast(u8, octal & 255)
        consumed = index - at
    } else if byte == 120 {
        var digits: usize = 0
        var index = at + 1
        var hex: usize = 0
        while digits < 2 && index < text.length && std.text.hexValue(text[index]) < 16 {
            hex = hex * 16 + @intCast(usize, std.text.hexValue(text[index]))
            digits += 1
            index += 1
        }
        if digits == 0 {
            if length.* + 1 < capacity {
                into[length.*] = 92
                into[length.* + 1] = 120
                length.* += 2
            }
            return at + 1
        }
        value = @intCast(u8, hex)
        consumed = index - at
    } else {
        if length.* + 1 < capacity {
            into[length.*] = 92
            into[length.* + 1] = byte
            length.* += 2
        }
        return at + 1
    }
    if length.* < capacity {
        into[length.*] = value
        length.* += 1
    }
    return at + consumed
}

// As dash's echo: backslash escapes are interpreted (-E leaves them, -e
// is accepted), -n drops the newline.
fn echo(shell: *Shell, fields: *Fields) -> usize {
    var index: usize = 1
    var newline = true
    var escapes = true
    var options = true
    while options && index < fields.*.count {
        const word = arg(fields, index)
        if word.length < 2 || word[0] != 45 { break }
        var valid = true
        var at: usize = 1
        while at < word.length {
            if word[at] != 110 && word[at] != 101 && word[at] != 69 { valid = false }
            at += 1
        }
        if !valid { break }
        at = 1
        while at < word.length {
            if word[at] == 110 { newline = false }
            if word[at] == 101 { escapes = true }
            if word[at] == 69 { escapes = false }
            at += 1
        }
        index += 1
    }
    var line: [65536]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length: usize = 0
    var stop = false
    var first = true
    while index < fields.*.count && !stop {
        if !first { length = appendOut(bytes, length, 65536, " ") }
        first = false
        const word = arg(fields, index)
        if escapes {
            var at: usize = 0
            while at < word.length && !stop {
                if word[at] == 92 {
                    at = escapeInto(word, at + 1, bytes, &length, 65536, &stop)
                } else {
                    if length < 65536 {
                        line[length] = word[at]
                        length += 1
                    }
                    at += 1
                }
            }
        } else {
            length = appendOut(bytes, length, 65536, word)
        }
        index += 1
    }
    if newline && !stop { length = appendOut(bytes, length, 65536, "\n") }
    const wrote = sys.write(1, bytes, length)
    return 0
}

// A number padded to `width` with spaces (or zeros) on the left, or
// spaces on the right.
fn padInto(into: [*]u8, at: usize, capacity: usize, text: []const u8, width: usize, left: bool, zeros: bool) -> usize {
    var length = at
    if !left {
        var pad = text.length
        while pad < width {
            length = appendOut(into, length, capacity, if zeros { "0" } else { " " })
            pad += 1
        }
    }
    length = appendOut(into, length, capacity, text)
    if left {
        var pad = text.length
        while pad < width {
            length = appendOut(into, length, capacity, " ")
            pad += 1
        }
    }
    return length
}

fn digitsOf(value: usize, base: usize, upper: bool, into: [*]u8, capacity: usize) -> usize {
    var digits: [32]u8 = undefined
    var count: usize = 0
    var rest = value
    if rest == 0 {
        digits[0] = 48
        count = 1
    }
    while rest > 0 {
        const digit = rest % base
        digits[count] = if digit < 10 { @intCast(u8, 48 + digit) } else { @intCast(u8, (if upper { 55 } else { 87 }) + digit) }
        rest /= base
        count += 1
    }
    var length: usize = 0
    while count > 0 && length < capacity {
        count -= 1
        into[length] = digits[count]
        length += 1
    }
    return length
}

fn printf(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count < 2 {
        state.complain("printf: a format is required", "")
        return 1
    }
    const format = arg(fields, 1)
    var line: [65536]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length: usize = 0
    var next_argument: usize = 2
    var status: usize = 0
    var again = true
    while again {
        again = false
        var at: usize = 0
        var used_any = false
        while at < format.length {
            const byte = format[at]
            if byte == 92 {
                var stop = false
                at = escapeInto(format, at + 1, bytes, &length, 65536, &stop)
                continue
            }
            if byte != 37 {
                if length < 65536 {
                    line[length] = byte
                    length += 1
                }
                at += 1
                continue
            }
            at += 1
            if at >= format.length { break }
            if format[at] == 37 {
                if length < 65536 {
                    line[length] = 37
                    length += 1
                }
                at += 1
                continue
            }
            // Flags, width, precision.
            var left = false
            var zeros = false
            var plus = false
            var alternate = false
            while at < format.length && (format[at] == 45 || format[at] == 48 || format[at] == 43 || format[at] == 32 || format[at] == 35) {
                if format[at] == 45 { left = true }
                if format[at] == 48 { zeros = true }
                if format[at] == 43 { plus = true }
                if format[at] == 35 { alternate = true }
                at += 1
            }
            var width: usize = 0
            if at < format.length && format[at] == 42 {
                var given: isize = 0
                if number(arg(fields, next_argument), &given) { width = if given < 0 { @intCast(usize, 0 - given) } else { @intCast(usize, given) } }
                if given < 0 { left = true }
                next_argument += 1
                used_any = true
                at += 1
            }
            while at < format.length && format[at] >= 48 && format[at] <= 57 {
                width = width * 10 + @intCast(usize, format[at] - 48)
                at += 1
            }
            var precision: usize = 0
            var has_precision = false
            if at < format.length && format[at] == 46 {
                has_precision = true
                at += 1
                if at < format.length && format[at] == 42 {
                    var given: isize = 0
                    if number(arg(fields, next_argument), &given) && given >= 0 { precision = @intCast(usize, given) }
                    next_argument += 1
                    used_any = true
                    at += 1
                }
                while at < format.length && format[at] >= 48 && format[at] <= 57 {
                    precision = precision * 10 + @intCast(usize, format[at] - 48)
                    at += 1
                }
            }
            if at >= format.length { break }
            const conversion = format[at]
            at += 1
            const argument = arg(fields, next_argument)
            const has_argument = next_argument < fields.*.count
            if conversion == 115 || conversion == 98 {
                next_argument += 1
                used_any = true
                var text: [*]const u8 = undefined
                var text_length = argument.length
                var escaped: [4096]u8 = undefined
                var escaped_bytes: [*]u8 = undefined
                unsafe {
                    text = @ptrCast([*]const u8, argument)
                    escaped_bytes = @ptrCast([*]u8, &escaped)
                }
                if conversion == 98 {
                    var escaped_length: usize = 0
                    var index: usize = 0
                    var stop = false
                    while index < argument.length && !stop {
                        if argument[index] == 92 {
                            index = escapeInto(argument, index + 1, escaped_bytes, &escaped_length, 4096, &stop)
                        } else {
                            if escaped_length < 4096 {
                                escaped[escaped_length] = argument[index]
                                escaped_length += 1
                            }
                            index += 1
                        }
                    }
                    text = escaped_bytes
                    text_length = escaped_length
                }
                if has_precision && precision < text_length { text_length = precision }
                length = padInto(bytes, length, 65536, text[0..text_length], width, left, false)
            } else if conversion == 99 {
                next_argument += 1
                used_any = true
                length = padInto(bytes, length, 65536, if argument.length > 0 { argument[0..1] } else { "" }, width, left, false)
            } else if conversion == 100 || conversion == 105 || conversion == 117 || conversion == 120 || conversion == 88 || conversion == 111 {
                next_argument += 1
                used_any = true
                var value: isize = 0
                if has_argument && !number(argument, &value) {
                    // A quoted character: its code; else not a number.
                    if argument.length >= 2 && (argument[0] == 39 || argument[0] == 34) {
                        value = @intCast(isize, argument[1])
                    } else {
                        value = @intCast(isize, arith.parseNumber(argument))
                        if value == 0 {
                            state.complainAbout("printf: ", argument, "expected a numeric value")
                            status = 1
                        }
                    }
                }
                var digits: [40]u8 = undefined
                var digits_bytes: [*]u8 = undefined
                unsafe { digits_bytes = @ptrCast([*]u8, &digits) }
                var digits_length: usize = 0
                var negative = false
                if conversion == 100 || conversion == 105 {
                    negative = value < 0
                    const magnitude: usize = if negative { @intCast(usize, 0 - value) } else { @intCast(usize, value) }
                    digits_length = digitsOf(magnitude, 10, false, digits_bytes, 40)
                } else {
                    const unsigned_value = @bitCast(usize, value)
                    const base: usize = if conversion == 117 { 10 } else if conversion == 111 { 8 } else { 16 }
                    digits_length = digitsOf(unsigned_value, base, conversion == 88, digits_bytes, 40)
                }
                var text: [48]u8 = undefined
                var text_bytes: [*]u8 = undefined
                unsafe { text_bytes = @ptrCast([*]u8, &text) }
                var text_length: usize = 0
                if negative {
                    text_length = appendOut(text_bytes, text_length, 48, "-")
                } else if plus && (conversion == 100 || conversion == 105) {
                    text_length = appendOut(text_bytes, text_length, 48, "+")
                }
                if alternate && (conversion == 120 || conversion == 88) && value != 0 { text_length = appendOut(text_bytes, text_length, 48, if conversion == 88 { "0X" } else { "0x" }) }
                if alternate && conversion == 111 { text_length = appendOut(text_bytes, text_length, 48, "0") }
                var pad = digits_length
                while has_precision && pad < precision {
                    text_length = appendOut(text_bytes, text_length, 48, "0")
                    pad += 1
                }
                text_length = appendOut(text_bytes, text_length, 48, digits_bytes[0..digits_length])
                length = padInto(bytes, length, 65536, text_bytes[0..text_length], width, left, zeros && !left && !has_precision)
            } else {
                state.complainAbout("printf: ", format[at - 1..at], "unknown conversion")
                status = 1
            }
        }
        // The format is reused while arguments remain.
        if used_any && next_argument < fields.*.count { again = true }
        if length > 60000 {
            const wrote = sys.write(1, bytes, length)
            length = 0
        }
    }
    const wrote = sys.write(1, bytes, length)
    return status
}

// ---------------------------------------------------------------------------
// test and [

const Test = struct {
    fields: *Fields
    at: usize
    end: usize
    failed: bool
}

fn testArg(check: *Test, index: usize) -> []const u8 { return arg(check.*.fields, index) }

fn isUnary(word: []const u8) -> bool {
    if word.length != 2 || word[0] != 45 { return false }
    const letter = word[1]
    return letter == 101 || letter == 102 || letter == 100 || letter == 114 || letter == 119 || letter == 120 || letter == 115 || letter == 122 || letter == 110 || letter == 76 || letter == 104 || letter == 98 || letter == 99 || letter == 112 || letter == 83 || letter == 116 || letter == 103 || letter == 117 || letter == 107 || letter == 79 || letter == 71
}

fn isBinary(word: []const u8) -> bool {
    return std.text.same(word, "=") || std.text.same(word, "==") || std.text.same(word, "!=") || std.text.same(word, "<") || std.text.same(word, ">") || std.text.same(word, "-eq") || std.text.same(word, "-ne") || std.text.same(word, "-lt") || std.text.same(word, "-le") || std.text.same(word, "-gt") || std.text.same(word, "-ge") || std.text.same(word, "-nt") || std.text.same(word, "-ot") || std.text.same(word, "-ef")
}

fn fileStatus(path: []const u8, follow: bool, result: *std.fs.Stat) -> bool {
    var buffer: [4096]u8 = undefined
    var buffer_bytes: [*]u8 = undefined
    unsafe { buffer_bytes = @ptrCast([*]u8, &buffer) }
    const c_path = sys.cString(buffer_bytes, 4096, path)
    if follow { return std.fs.status(c_path, result) == 0 }
    var current_directory: std.fs.File = undefined
    current_directory.descriptor = -100
    return std.fs.statusFrom(current_directory, c_path, result, true) == 0
}

fn unaryTest(letter: u8, operand: []const u8) -> bool {
    if letter == 122 { return operand.length == 0 }
    if letter == 110 { return operand.length > 0 }
    if letter == 116 {
        var descriptor: isize = 0
        return number(operand, &descriptor) && sys.isTerminal(descriptor)
    }
    if letter == 114 { return sys.access(operand, 4) }
    if letter == 119 { return sys.access(operand, 2) }
    if letter == 120 { return sys.access(operand, 1) }
    var status: std.fs.Stat = undefined
    if letter == 76 || letter == 104 {
        if !fileStatus(operand, false, &status) { return false }
        return status.mode & 61440 == 40960
    }
    if !fileStatus(operand, true, &status) { return false }
    const kind = status.mode & 61440
    if letter == 101 { return true }
    if letter == 102 { return kind == 32768 }
    if letter == 100 { return kind == 16384 }
    if letter == 98 { return kind == 24576 }
    if letter == 99 { return kind == 8192 }
    if letter == 112 { return kind == 4096 }
    if letter == 83 { return kind == 49152 }
    if letter == 115 { return status.size > 0 }
    if letter == 103 { return status.mode & 1024 != 0 }
    if letter == 117 { return status.mode & 2048 != 0 }
    if letter == 107 { return status.mode & 512 != 0 }
    if letter == 79 { return @intCast(usize, status.user) == sys.getUid() }
    if letter == 71 { return true }
    return false
}

fn binaryTest(check: *Test, left: []const u8, operator: []const u8, right: []const u8) -> bool {
    if std.text.same(operator, "=") || std.text.same(operator, "==") { return std.text.same(left, right) }
    if std.text.same(operator, "!=") { return !std.text.same(left, right) }
    if std.text.same(operator, "<") || std.text.same(operator, ">") {
        var index: usize = 0
        var less = false
        var decided = false
        while index < left.length && index < right.length && !decided {
            if left[index] != right[index] {
                less = left[index] < right[index]
                decided = true
            }
            index += 1
        }
        if !decided { less = left.length < right.length }
        return if std.text.same(operator, "<") { less } else { !less && !std.text.same(left, right) }
    }
    if std.text.same(operator, "-nt") || std.text.same(operator, "-ot") || std.text.same(operator, "-ef") {
        var left_status: std.fs.Stat = undefined
        var right_status: std.fs.Stat = undefined
        const has_left = fileStatus(left, true, &left_status)
        const has_right = fileStatus(right, true, &right_status)
        if std.text.same(operator, "-ef") { return has_left && has_right && left_status.device == right_status.device && left_status.inode == right_status.inode }
        if std.text.same(operator, "-nt") { return has_left && (!has_right || left_status.modifiedSeconds > right_status.modifiedSeconds) }
        return has_right && (!has_left || left_status.modifiedSeconds < right_status.modifiedSeconds)
    }
    var a: isize = 0
    var b: isize = 0
    if !number(left, &a) || !number(right, &b) {
        state.complainAbout("test: ", if !number(left, &a) { left } else { right }, "integer expression expected")
        check.*.failed = true
        return false
    }
    if std.text.same(operator, "-eq") { return a == b }
    if std.text.same(operator, "-ne") { return a != b }
    if std.text.same(operator, "-lt") { return a < b }
    if std.text.same(operator, "-le") { return a <= b }
    if std.text.same(operator, "-gt") { return a > b }
    return a >= b
}

// primary := ( or ) | ! primary | unary ARG | ARG binary ARG | ARG
fn testPrimary(check: *Test) -> bool {
    if check.*.at >= check.*.end {
        check.*.failed = true
        return false
    }
    const word = testArg(check, check.*.at)
    const remaining = check.*.end - check.*.at
    if std.text.same(word, "!") {
        check.*.at += 1
        return !testPrimary(check)
    }
    if std.text.same(word, "(") && remaining >= 3 {
        check.*.at += 1
        const value = testOr(check)
        if check.*.at < check.*.end && std.text.same(testArg(check, check.*.at), ")") {
            check.*.at += 1
        } else {
            state.complain("test: ')' expected", "")
            check.*.failed = true
        }
        return value
    }
    if remaining >= 3 && isBinary(testArg(check, check.*.at + 1)) {
        const value = binaryTest(check, word, testArg(check, check.*.at + 1), testArg(check, check.*.at + 2))
        check.*.at += 3
        return value
    }
    if remaining >= 2 && isUnary(word) {
        const value = unaryTest(word[1], testArg(check, check.*.at + 1))
        check.*.at += 2
        return value
    }
    check.*.at += 1
    return word.length > 0
}

fn testAnd(check: *Test) -> bool {
    var value = testPrimary(check)
    while !check.*.failed && check.*.at < check.*.end && std.text.same(testArg(check, check.*.at), "-a") {
        check.*.at += 1
        const right = testPrimary(check)
        value = value && right
    }
    return value
}

fn testOr(check: *Test) -> bool {
    var value = testAnd(check)
    while !check.*.failed && check.*.at < check.*.end && std.text.same(testArg(check, check.*.at), "-o") {
        check.*.at += 1
        const right = testAnd(check)
        value = value || right
    }
    return value
}

fn testCommand(shell: *Shell, fields: *Fields, bracket: bool) -> usize {
    var end = fields.*.count
    if bracket {
        if end < 2 || !std.text.same(arg(fields, end - 1), "]") {
            state.complain("[: missing ']'", "")
            return 2
        }
        end -= 1
    }
    if end <= 1 { return 1 }
    var check = Test.{ .fields = fields, .at = 1, .end = end, .failed = false }
    const value = testOr(&check)
    if check.failed { return 2 }
    if check.at < check.end {
        state.complainAbout("test: ", arg(fields, check.at), "unexpected argument")
        return 2
    }
    return if value { 0 } else { 1 }
}

// ---------------------------------------------------------------------------
// Directories, variables, control

fn cd(shell: *Shell, fields: *Fields) -> usize {
    var index: usize = 1
    while index < fields.*.count && arg(fields, index).length > 1 && arg(fields, index)[0] == 45 && !std.text.same(arg(fields, index), "-") { index += 1 }
    var target: []const u8 = ""
    var print_it = false
    if index >= fields.*.count {
        const home = state.getVariable(shell, "HOME")
        if home == null {
            state.complain("cd: HOME is not set", "")
            return 1
        }
        target = home.?
    } else if std.text.same(arg(fields, index), "-") {
        const old = state.getVariable(shell, "OLDPWD")
        if old == null {
            state.complain("cd: OLDPWD is not set", "")
            return 1
        }
        target = old.?
        print_it = true
    } else {
        target = arg(fields, index)
    }
    const before = state.workingDirectory(shell)
    var before_copy: [4096]u8 = undefined
    var before_bytes: [*]u8 = undefined
    unsafe { before_bytes = @ptrCast([*]u8, &before_copy) }
    const before_length = appendOut(before_bytes, 0, 4096, before)
    if sys.changeDirectory(target) != 0 {
        state.complainAbout("cd: ", target, if sys.access(target, 0) { "not a directory" } else { "no such directory" })
        return 1
    }
    state.refreshWorkingDirectory(shell)
    const set_old = state.setVariable(shell, "OLDPWD", before_bytes[0..before_length], true)
    const set_new = state.setVariable(shell, "PWD", state.workingDirectory(shell), true)
    if print_it { outLine(state.workingDirectory(shell)) }
    return 0
}

fn exportVariables(shell: *Shell, fields: *Fields, readonly: bool) -> usize {
    if fields.*.count == 1 || (fields.*.count == 2 && std.text.same(arg(fields, 1), "-p")) {
        var index: usize = 0
        while index < shell.*.variableCount {
            const variable = state.variableAt(shell, index)
            if variable.*.used && ((readonly && variable.*.readonly) || (!readonly && variable.*.exported)) {
                out(if readonly { "readonly " } else { "export " })
                out(state.variableName(shell, variable))
                out("='")
                out(state.variableValue(shell, variable))
                outLine("'")
            }
            index += 1
        }
        return 0
    }
    var status: usize = 0
    var index: usize = 1
    while index < fields.*.count {
        const word = arg(fields, index)
        if std.text.same(word, "-p") || std.text.same(word, "-n") {
            index += 1
            continue
        }
        var equals: usize = 0
        while equals < word.length && word[equals] != 61 { equals += 1 }
        const name = word[0..equals]
        if equals < word.length {
            if !state.setVariable(shell, name, word[equals + 1..word.length], !readonly) {
                state.complainAbout("", name, "readonly variable")
                status = 1
            }
        } else if !readonly {
            state.exportVariable(shell, name)
        }
        if readonly {
            const found = state.findVariable(shell, name)
            if found == null { const set = state.setVariable(shell, name, "", false) }
            const again = state.findVariable(shell, name)
            if again != null { again.?.*.readonly = true }
        }
        index += 1
    }
    return status
}

fn unset(shell: *Shell, fields: *Fields) -> usize {
    var functions = false
    var status: usize = 0
    var index: usize = 1
    while index < fields.*.count {
        const word = arg(fields, index)
        if std.text.same(word, "-f") {
            functions = true
        } else if std.text.same(word, "-v") {
            functions = false
        } else if functions {
            state.undefineFunction(shell, word)
        } else if !state.unsetVariable(shell, word) {
            state.complainAbout("unset: ", word, "readonly variable")
            status = 1
        }
        index += 1
    }
    return status
}

fn setOptions(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count == 1 {
        var index: usize = 0
        while index < shell.*.variableCount {
            const variable = state.variableAt(shell, index)
            if variable.*.used {
                out(state.variableName(shell, variable))
                out("='")
                out(state.variableValue(shell, variable))
                outLine("'")
            }
            index += 1
        }
        return 0
    }
    var index: usize = 1
    var positional_from: usize = 0
    while index < fields.*.count && positional_from == 0 {
        const word = arg(fields, index)
        if std.text.same(word, "--") {
            positional_from = index + 1
        } else if word.length >= 2 && (word[0] == 45 || word[0] == 43) {
            const on = word[0] == 45
            if std.text.same(word[1..word.length], "o") && index + 1 < fields.*.count {
                const option = arg(fields, index + 1)
                if std.text.same(option, "errexit") { shell.*.errexit = on }
                if std.text.same(option, "xtrace") { shell.*.xtrace = on }
                if std.text.same(option, "noglob") { shell.*.noglob = on }
                if std.text.same(option, "nounset") { shell.*.nounset = on }
                if std.text.same(option, "monitor") { setJobControl(shell, on) }
                index += 1
            } else {
                var at: usize = 1
                while at < word.length {
                    const letter = word[at]
                    if letter == 101 { shell.*.errexit = on }
                    if letter == 120 { shell.*.xtrace = on }
                    if letter == 102 { shell.*.noglob = on }
                    if letter == 117 { shell.*.nounset = on }
                    if letter == 109 { setJobControl(shell, on) }
                    at += 1
                }
            }
            index += 1
        } else {
            positional_from = index
        }
    }
    if positional_from > 0 {
        state.clearPositional(shell)
        var at = positional_from
        while at < fields.*.count {
            const pushed = state.pushPositional(shell, arg(fields, at))
            at += 1
        }
    } else if index < fields.*.count || (fields.*.count >= 2 && std.text.same(arg(fields, fields.*.count - 1), "--")) {
        state.clearPositional(shell)
    }
    return 0
}

// set -m / set +m.
fn setJobControl(shell: *Shell, on: bool) -> void {
    if on {
        if !jobs.setup(shell) { state.complain("set -m: no terminal", "") }
    } else {
        jobs.teardown(shell)
    }
}

// getopts OPTSTRING NAME [ARG...]: the next option letter of the arguments
// (the positional parameters without any) into NAME, its argument into
// OPTARG, OPTIND moved on; 1 when the options are done. An unknown letter
// gives ? (with a message, or with the letter in OPTARG when OPTSTRING
// starts with a colon), a missing argument ? or, silently, : .
fn getopts(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count < 3 {
        state.complain("getopts: an option string and a name are expected", "")
        return 2
    }
    const optstring = arg(fields, 1)
    const name = arg(fields, 2)
    const silent = optstring.length > 0 && optstring[0] == 58
    var argument_count: usize = state.positionalCount(shell)
    var from_fields = false
    if fields.*.count > 3 {
        argument_count = fields.*.count - 3
        from_fields = true
    }
    // OPTIND: where the shell left it, unless the script set it back.
    var optind: usize = 1
    const kept = state.getVariable(shell, "OPTIND")
    if kept != null {
        var value: isize = 0
        if number(kept.?, &value) && value >= 0 { optind = @intCast(usize, value) }
    }
    if optind != shell.*.optLast { shell.*.optOffset = 0 }
    if optind == 0 { optind = 1 }
    var done = false
    var status: usize = 0
    var letter: u8 = 63
    var word: []const u8 = ""
    if optind > argument_count {
        done = true
    } else {
        word = if from_fields { arg(fields, 2 + optind) } else { state.positional(shell, optind) }
        if shell.*.optOffset == 0 {
            if word.length < 2 || word[0] != 45 {
                done = true
            } else if std.text.same(word, "--") {
                done = true
                optind += 1
            } else {
                shell.*.optOffset = 1
            }
        }
    }
    if done {
        const named = state.setVariable(shell, name, "?", false)
        const cleared = state.unsetVariable(shell, "OPTARG")
        status = 1
    } else {
        letter = word[shell.*.optOffset]
        var found: usize = optstring.length
        var at: usize = 0
        while at < optstring.length {
            if optstring[at] == letter && letter != 58 { found = at }
            at += 1
        }
        var letter_text: [1]u8 = [1]u8{ letter }
        var letter_bytes: [*]const u8 = undefined
        unsafe { letter_bytes = @ptrCast([*]const u8, &letter_text) }
        const letter_slice = letter_bytes[0..1]
        const rest = word[shell.*.optOffset + 1..word.length]
        if found == optstring.length {
            const named = state.setVariable(shell, name, "?", false)
            if silent {
                const set = state.setVariable(shell, "OPTARG", letter_slice, false)
            } else {
                const cleared = state.unsetVariable(shell, "OPTARG")
                state.complainAbout("Illegal option -", letter_slice, "")
            }
            if rest.length == 0 {
                optind += 1
                shell.*.optOffset = 0
            } else {
                shell.*.optOffset += 1
            }
        } else if found + 1 < optstring.length && optstring[found + 1] == 58 {
            // The letter takes an argument: the rest of the word, else the
            // next one.
            if rest.length > 0 {
                const named = state.setVariable(shell, name, letter_slice, false)
                const set = state.setVariable(shell, "OPTARG", rest, false)
                optind += 1
            } else if optind < argument_count {
                const named = state.setVariable(shell, name, letter_slice, false)
                const next = if from_fields { arg(fields, 3 + optind) } else { state.positional(shell, optind + 1) }
                const set = state.setVariable(shell, "OPTARG", next, false)
                optind += 2
            } else {
                if silent {
                    const named = state.setVariable(shell, name, ":", false)
                    const set = state.setVariable(shell, "OPTARG", letter_slice, false)
                } else {
                    const named = state.setVariable(shell, name, "?", false)
                    const cleared = state.unsetVariable(shell, "OPTARG")
                    state.complainAbout("No arg for -", letter_slice, " option")
                }
                optind += 1
            }
            shell.*.optOffset = 0
        } else {
            const named = state.setVariable(shell, name, letter_slice, false)
            const cleared = state.unsetVariable(shell, "OPTARG")
            if rest.length == 0 {
                optind += 1
                shell.*.optOffset = 0
            } else {
                shell.*.optOffset += 1
            }
        }
    }
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    const length = std.text.appendUnsigned(digit_bytes, 0, 24, optind)
    const set_index = state.setVariable(shell, "OPTIND", digit_bytes[0..length], false)
    shell.*.optLast = optind
    return status
}

// alias [NAME[=VALUE]...]: defines, or shows (all of them with none).
fn alias(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count == 1 {
        var index: usize = 0
        while index < shell.*.aliasCount {
            const entry = state.aliasAt(shell, index)
            if entry.*.used { showAlias(shell, index) }
            index += 1
        }
        return 0
    }
    var status: usize = 0
    var index: usize = 1
    while index < fields.*.count {
        const word = arg(fields, index)
        var equals: usize = word.length
        var at: usize = 0
        while at < word.length && equals == word.length {
            if word[at] == 61 { equals = at }
            at += 1
        }
        if equals == word.length {
            const slot = state.findAlias(shell, word)
            if slot == state.MAX_ALIASES {
                state.complainAbout("alias: ", word, "not found")
                status = 1
            } else {
                showAlias(shell, slot)
            }
        } else if equals == 0 {
            state.complainAbout("alias: ", word, "a name is expected")
            status = 1
        } else if !state.defineAlias(shell, word[0..equals], word[equals + 1..word.length]) {
            state.complain("alias: too many aliases", "")
            status = 1
        }
        index += 1
    }
    return status
}

// NAME='VALUE' on stdout, as dash shows an alias.
fn showAlias(shell: *Shell, slot: usize) -> void {
    const entry = state.aliasAt(shell, slot)
    out(state.aliasName(shell, entry))
    out("='")
    out(state.aliasValue(shell, entry))
    outLine("'")
}

// unalias NAME... (-a: all of them).
fn unalias(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count > 1 && std.text.same(arg(fields, 1), "-a") {
        var index: usize = 0
        while index < shell.*.aliasCount {
            state.aliasAt(shell, index).*.used = false
            index += 1
        }
        return 0
    }
    var status: usize = 0
    var index: usize = 1
    while index < fields.*.count {
        if !state.undefineAlias(shell, arg(fields, index)) {
            state.complainAbout("unalias: ", arg(fields, index), "not found")
            status = 1
        }
        index += 1
    }
    return status
}

fn shiftParameters(shell: *Shell, fields: *Fields) -> usize {
    var count: isize = 1
    if fields.*.count > 1 && !number(arg(fields, 1), &count) {
        state.complainAbout("shift: ", arg(fields, 1), "not a number")
        return 1
    }
    if count < 0 || !state.shiftPositional(shell, @intCast(usize, count)) {
        state.complain("shift: not that many parameters", "")
        return 1
    }
    return 0
}

fn statusArgument(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count < 2 { return shell.*.lastStatus }
    var value: isize = 0
    if !number(arg(fields, 1), &value) {
        state.complainAbout("", arg(fields, 1), "not a number")
        return 2
    }
    return @bitCast(usize, value) & 255
}

fn readLine(shell: *Shell, fields: *Fields) -> usize {
    var raw = false
    var index: usize = 1
    var prompt: []const u8 = ""
    while index < fields.*.count && arg(fields, index).length > 1 && arg(fields, index)[0] == 45 {
        const word = arg(fields, index)
        if std.text.same(word, "-r") {
            raw = true
        } else if std.text.same(word, "-p") && index + 1 < fields.*.count {
            prompt = arg(fields, index + 1)
            index += 1
        }
        index += 1
    }
    if prompt.length > 0 { const wrote = sys.writeAll(2, prompt) }
    var line: [65536]u8 = undefined
    var length: usize = 0
    var byte: [1]u8 = [1]u8{ 0 }
    var byte_pointer: [*]u8 = undefined
    unsafe { byte_pointer = @ptrCast([*]u8, &byte) }
    var got_any = false
    var reading = true
    var escaped = false
    while reading {
        const got = sys.read(0, byte_pointer, 1)
        if got <= 0 {
            reading = false
            break
        }
        got_any = true
        if escaped {
            escaped = false
            if byte[0] != 10 && length < 65536 {
                line[length] = byte[0]
                length += 1
            }
            continue
        }
        if byte[0] == 92 && !raw {
            escaped = true
            continue
        }
        if byte[0] == 10 { break }
        if length < 65536 {
            line[length] = byte[0]
            length += 1
        }
    }
    if !got_any { return 1 }
    // Split at IFS whitespace into the names, the last getting the rest.
    const names = fields.*.count - index
    var at: usize = 0
    var name_index: usize = 0
    var line_bytes: [*]const u8 = undefined
    unsafe { line_bytes = @ptrCast([*]const u8, &line) }
    if names == 0 {
        const set = state.setVariable(shell, "REPLY", line_bytes[0..length], false)
        return if reading { 0 } else { 1 }
    }
    while name_index < names {
        while at < length && (line[at] == 32 || line[at] == 9) { at += 1 }
        var end = at
        if name_index + 1 == names {
            end = length
            while end > at && (line[end - 1] == 32 || line[end - 1] == 9) { end -= 1 }
        } else {
            while end < length && line[end] != 32 && line[end] != 9 { end += 1 }
        }
        const set = state.setVariable(shell, arg(fields, index + name_index), line_bytes[at..end], false)
        at = end
        name_index += 1
    }
    return if reading { 0 } else { 1 }
}

fn typeOf(shell: *Shell, fields: *Fields, only_path: bool) -> usize {
    var status: usize = 0
    var index: usize = 1
    while index < fields.*.count {
        const name = arg(fields, index)
        const alias_slot = state.findAlias(shell, name)
        if alias_slot != state.MAX_ALIASES {
            const entry = state.aliasAt(shell, alias_slot)
            if only_path {
                showAlias(shell, alias_slot)
            } else {
                out(name)
                out(" is an alias for ")
                outLine(state.aliasValue(shell, entry))
            }
        } else if state.findFunction(shell, name) != null {
            out(name)
            outLine(if only_path { "" } else { " is a shell function" })
        } else if isBuiltin(name) {
            out(name)
            outLine(if only_path { "" } else { " is a shell builtin" })
        } else {
            var path: [4096]u8 = undefined
            var path_bytes: [*]u8 = undefined
            unsafe { path_bytes = @ptrCast([*]u8, &path) }
            if programs.findInPath(shell, name, path_bytes, 4096) {
                if !only_path {
                    out(name)
                    out(" is ")
                }
                outLine(std.text.cString(path_bytes))
            } else {
                // As dash: type says so on stdout, command -v stays quiet.
                if !only_path {
                    out(name)
                    outLine(": not found")
                }
                status = 127
            }
        }
        index += 1
    }
    return status
}

// command [-v] NAME ARGS: the builtin or program, never a function.
fn command(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count < 2 { return 0 }
    if std.text.same(arg(fields, 1), "-v") || std.text.same(arg(fields, 1), "-V") {
        var rest = Fields.{ .items = state.constOffsetItems(fields.*.items, 1), .count = fields.*.count - 1, .capacity = fields.*.capacity }
        return typeOf(shell, &rest, std.text.same(arg(fields, 1), "-v"))
    }
    var rest = Fields.{ .items = state.constOffsetItems(fields.*.items, 1), .count = fields.*.count - 1, .capacity = fields.*.capacity }
    const name = arg(&rest, 0)
    if isBuiltin(name) { return run(shell, &rest) }
    const pid = sys.fork()
    if pid < 0 { return 1 }
    if pid == 0 { programs.executeProgram(shell, &rest) }
    var raw: usize = 0
    const waited = sys.wait(pid, &raw, false)
    return sys.exitStatus(raw)
}

// wait [JOB|PID...]: for every job, or the ones named (a job number with
// %, a process id); the status of the last one named. A trapped signal
// that arrives ends the wait with 128 plus its number after its action.
fn waitJobs(shell: *Shell, fields: *Fields) -> usize {
    // SIGCHLD is blocked while waiting, so that a child's end wakes the
    // wait for signals (a blocked signal is pending, an ignored one lost).
    const chld = sys.signalBit(sys.SIGCHLD)
    const old_mask = sys.changeSignalMask(sys.SIG_BLOCK, chld)
    var status: usize = 0
    var waiting = true
    var interrupted = false
    while waiting && !interrupted {
        jobs.update(shell)
        waiting = false
        if fields.*.count == 1 {
            var index: usize = 0
            while index < shell.*.jobCount {
                const job = state.jobAt(shell, index)
                if job.*.pid != 0 && job.*.state == state.JOB_RUNNING { waiting = true }
                if job.*.pid != 0 && job.*.state == state.JOB_DONE { jobs.forget(shell, index) }
                index += 1
            }
        } else {
            var index: usize = 1
            while index < fields.*.count {
                const spec = arg(fields, index)
                const slot = jobs.find(shell, spec)
                if slot == state.MAX_JOBS {
                    // Not a job: a process of the shell's, perhaps.
                    var pid: isize = 0
                    if spec.length > 0 && spec[0] != 37 && number(spec, &pid) {
                        var raw: usize = 0
                        const waited = sys.waitWith(pid, &raw, sys.WNOHANG)
                        status = if waited == pid { sys.exitStatus(raw) } else { 127 }
                    } else {
                        status = 127
                    }
                } else if jobs.isDone(shell, slot) {
                    status = state.jobAt(shell, slot).*.status
                    if index + 1 == fields.*.count { jobs.forget(shell, slot) }
                } else if state.jobAt(shell, slot).*.state == state.JOB_RUNNING {
                    waiting = true
                }
                index += 1
            }
        }
        if waiting {
            const signal = sys.takeSignal(shell.*.trappedMask | chld, -1)
            if signal != 0 && signal != sys.SIGCHLD {
                traps.run(shell, signal)
                status = 128 + signal
                interrupted = true
            }
            if signal == 0 { interrupted = true }
        }
    }
    // The done jobs named were forgotten; forget the rest that finished.
    if fields.*.count > 1 {
        var index: usize = 1
        while index < fields.*.count {
            const slot = jobs.find(shell, arg(fields, index))
            if slot != state.MAX_JOBS && jobs.isDone(shell, slot) { jobs.forget(shell, slot) }
            index += 1
        }
    }
    const restored = sys.changeSignalMask(sys.SIG_SETMASK, old_mask)
    return status
}

// kill [-s SIGNAL | -SIGNAL] PID|%JOB...; kill -l lists the names.
fn kill(shell: *Shell, fields: *Fields) -> usize {
    var signal: usize = 15
    var index: usize = 1
    if fields.*.count > 1 && std.text.same(arg(fields, 1), "-l") {
        if fields.*.count > 2 {
            var value: isize = 0
            if number(arg(fields, 2), &value) && value > 128 { value -= 128 }
            if value > 0 && value < @intCast(isize, state.MAX_SIGNALS) { outLine(traps.signalName(@intCast(usize, value))) } else { outLine("?") }
            return 0
        }
        outLine("HUP INT QUIT ILL TRAP ABRT BUS FPE KILL USR1 SEGV USR2 PIPE ALRM TERM STKFLT CHLD CONT STOP TSTP TTIN TTOU URG XCPU XFSZ VTALRM PROF WINCH IO PWR SYS")
        return 0
    }
    if index < fields.*.count && std.text.same(arg(fields, index), "-s") && index + 1 < fields.*.count {
        signal = traps.signalNumber(arg(fields, index + 1))
        index += 2
    } else if index < fields.*.count && arg(fields, index).length > 1 && arg(fields, index)[0] == 45 {
        signal = traps.signalNumber(arg(fields, index)[1..arg(fields, index).length])
        index += 1
    }
    if signal >= state.MAX_SIGNALS {
        state.complain("kill: unknown signal", "")
        return 1
    }
    var status: usize = 0
    while index < fields.*.count {
        const spec = arg(fields, index)
        var pid: isize = 0
        if spec.length > 0 && spec[0] == 37 {
            const slot = jobs.find(shell, spec)
            if slot == state.MAX_JOBS {
                state.complainAbout("kill: ", spec, "no such job")
                status = 1
            } else if sys.kill(jobs.signalTarget(shell, slot), signal) != 0 {
                state.complainAbout("kill: ", spec, "no such process")
                status = 1
            }
        } else if !number(spec, &pid) {
            state.complainAbout("kill: ", spec, "not a process id")
            status = 1
        } else if sys.kill(pid, signal) != 0 {
            state.complainAbout("kill: ", spec, "no such process")
            status = 1
        }
        index += 1
    }
    return status
}

fn umask(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count == 1 {
        const current = sys.umask(0)
        const restored = sys.umask(current)
        var text: [8]u8 = undefined
        text[0] = 48
        text[1] = @intCast(u8, 48 + ((current >> 6) & 7))
        text[2] = @intCast(u8, 48 + ((current >> 3) & 7))
        text[3] = @intCast(u8, 48 + (current & 7))
        var text_bytes: [*]const u8 = undefined
        unsafe { text_bytes = @ptrCast([*]const u8, &text) }
        outLine(text_bytes[0..4])
        return 0
    }
    var mask: usize = 0
    for byte in arg(fields, 1) {
        if byte < 48 || byte > 55 {
            state.complainAbout("umask: ", arg(fields, 1), "not an octal mode")
            return 1
        }
        mask = mask * 8 + @intCast(usize, byte - 48)
    }
    const set = sys.umask(mask)
    return 0
}

// trap [ACTION] SIGNAL...: ACTION runs when a SIGNAL comes (after the
// command it came during), '' ignores the signal, - puts it back to its
// default (a bare number as the only operand too); trap alone lists them.
fn trap(shell: *Shell, fields: *Fields) -> usize {
    var first: usize = 1
    if fields.*.count > 1 && std.text.same(arg(fields, 1), "--") { first = 2 }
    if fields.*.count <= first {
        var signal: usize = 0
        while signal < state.MAX_SIGNALS {
            if traps.isSet(shell, signal) {
                out("trap -- '")
                out(traps.action(shell, signal))
                out("' ")
                outLine(traps.signalName(signal))
            }
            signal += 1
        }
        return 0
    }
    const action = arg(fields, first)
    var reset = std.text.same(action, "-")
    var signals_from = first + 1
    if fields.*.count == first + 1 {
        // `trap 2`: the one operand is a signal, reset to its default.
        var value: isize = 0
        if number(action, &value) {
            reset = true
            signals_from = first
        }
    }
    var wanted: ?[]const u8 = null
    if !reset { wanted = action }
    var status: usize = 0
    var index: usize = signals_from
    while index < fields.*.count {
        const which = arg(fields, index)
        const signal = traps.signalNumber(which)
        if signal >= state.MAX_SIGNALS {
            state.complainAbout("trap: ", which, "bad signal")
            status = 1
        } else if !traps.set(shell, signal, wanted) {
            state.complainAbout("trap: ", which, "cannot be trapped")
            status = 1
        }
        index += 1
    }
    return status
}

fn local(shell: *Shell, fields: *Fields) -> usize {
    if shell.*.functionDepth == 0 {
        state.complain("local: not in a function", "")
        return 1
    }
    var index: usize = 1
    while index < fields.*.count {
        const word = arg(fields, index)
        var equals: usize = 0
        while equals < word.length && word[equals] != 61 { equals += 1 }
        const name = word[0..equals]
        const saved = state.saveLocal(shell, name, shell.*.functionDepth)
        const set = state.setVariable(shell, name, if equals < word.length { word[equals + 1..word.length] } else { "" }, false)
        const found = state.findVariable(shell, name)
        if found != null { found.?.*.exported = false }
        index += 1
    }
    return 0
}

fn source(shell: *Shell, fields: *Fields) -> usize {
    if fields.*.count < 2 {
        state.complain(".: a file name is required", "")
        return 2
    }
    const name = arg(fields, 1)
    var path: [4096]u8 = undefined
    var path_bytes: [*]u8 = undefined
    unsafe { path_bytes = @ptrCast([*]u8, &path) }
    var found = false
    for byte in name {
        if byte == 47 { found = true }
    }
    if found {
        const length = appendOut(path_bytes, 0, 4096, name)
        path_bytes[length] = 0
    } else if !programs.findInPath(shell, name, path_bytes, 4096) {
        const length = appendOut(path_bytes, 0, 4096, name)
        path_bytes[length] = 0
    }
    const file = std.fs.open(path_bytes, 0, 0)
    if !std.fs.isValid(file) {
        state.complainAbout(".: ", name, "cannot open")
        return 1
    }
    const contents = std.fs.readToEndAlloc(file, shell.*.allocator)
    const closed = std.fs.close(file)
    var frame: state.Frame = undefined
    const has_arguments = fields.*.count > 2
    if has_arguments {
        frame = state.pushFrame(shell)
        var index: usize = 2
        while index < fields.*.count {
            const pushed = state.pushPositional(shell, arg(fields, index))
            index += 1
        }
    }
    const status = shell.*.runText(@ptrCast(*anyopaque, shell), contents.items[0..contents.length])
    contents.deinit()
    var result = status
    if shell.*.returning {
        shell.*.returning = false
        result = shell.*.returnStatus
    }
    if has_arguments { state.popFrame(shell, frame) }
    return result
}

fn history(shell: *Shell, fields: *Fields) -> usize {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &shell.*.history) }
    var index: usize = 0
    while index < shell.*.historyCount {
        const slot = (shell.*.historyStart + index) % state.MAX_HISTORY
        var line: [32]u8 = undefined
        var line_bytes: [*]u8 = undefined
        unsafe { line_bytes = @ptrCast([*]u8, &line) }
        var length = std.text.appendUnsigned(line_bytes, 0, 32, index + 1)
        length = appendOut(line_bytes, length, 32, "  ")
        out(line_bytes[0..length])
        const at = @intCast(usize, shell.*.historyOffsets[slot])
        outLine(bytes[at..at + @intCast(usize, shell.*.historyLengths[slot])])
        index += 1
    }
    return 0
}

// jobs [-l|-p] [%JOB]: the jobs, their state and command.
fn listJobs(shell: *Shell, fields: *Fields) -> usize {
    jobs.update(shell)
    var long = false
    var pids_only = false
    var only: usize = state.MAX_JOBS
    var index: usize = 1
    while index < fields.*.count {
        const word = arg(fields, index)
        if std.text.same(word, "-l") {
            long = true
        } else if std.text.same(word, "-p") {
            pids_only = true
        } else {
            only = jobs.find(shell, word)
            if only == state.MAX_JOBS {
                state.complainAbout("jobs: ", word, "no such job")
                return 1
            }
        }
        index += 1
    }
    jobs.list(shell, long, pids_only, only)
    return 0
}

// fg [%JOB] and bg [%JOB]: a job in front of the terminal again, or on in
// the background.
fn foregroundOrBackground(shell: *Shell, fields: *Fields, foreground: bool) -> usize {
    const name: []const u8 = if foreground { "fg" } else { "bg" }
    if !shell.*.jobControl {
        state.complainAbout("", name, "no job control")
        return 1
    }
    jobs.update(shell)
    const spec: []const u8 = if fields.*.count > 1 { arg(fields, 1) } else { "" }
    const slot = jobs.find(shell, spec)
    if slot == state.MAX_JOBS {
        if spec.length == 0 { state.complainAbout("", name, "no current job") } else { state.complainAbout("", spec, "no such job") }
        return 1
    }
    return jobs.continueJob(shell, slot, foreground)
}

// Runs builtin fields[0]; its status.
pub fn run(shell: *Shell, fields: *Fields) -> usize {
    const name = arg(fields, 0)
    if std.text.same(name, ":") || std.text.same(name, "true") { return 0 }
    if std.text.same(name, "false") { return 1 }
    if std.text.same(name, "echo") { return echo(shell, fields) }
    if std.text.same(name, "printf") { return printf(shell, fields) }
    if std.text.same(name, "test") { return testCommand(shell, fields, false) }
    if std.text.same(name, "[") { return testCommand(shell, fields, true) }
    if std.text.same(name, "cd") { return cd(shell, fields) }
    if std.text.same(name, "pwd") {
        state.refreshWorkingDirectory(shell)
        outLine(state.workingDirectory(shell))
        return 0
    }
    if std.text.same(name, "exit") {
        // An interactive shell with stopped jobs says so once first.
        if shell.*.interactive && shell.*.jobControl && !shell.*.warnedStopped {
            jobs.update(shell)
            if jobs.hasStopped(shell) {
                shell.*.warnedStopped = true
                state.complain("You have stopped jobs.", "")
                return 1
            }
        }
        shell.*.exitStatus = statusArgument(shell, fields)
        shell.*.exiting = true
        return shell.*.exitStatus
    }
    if std.text.same(name, "return") {
        shell.*.returnStatus = statusArgument(shell, fields)
        shell.*.returning = true
        return shell.*.returnStatus
    }
    if std.text.same(name, "break") || std.text.same(name, "continue") {
        var levels: isize = 1
        if fields.*.count > 1 && (!number(arg(fields, 1), &levels) || levels < 1) {
            state.complainAbout("", name, "a positive number is expected")
            return 1
        }
        if shell.*.loopDepth == 0 { return 0 }
        var count = @intCast(usize, levels)
        if count > shell.*.loopDepth { count = shell.*.loopDepth }
        if std.text.same(name, "break") { shell.*.breaking = count } else { shell.*.continuing = count }
        return 0
    }
    if std.text.same(name, "export") { return exportVariables(shell, fields, false) }
    if std.text.same(name, "readonly") { return exportVariables(shell, fields, true) }
    if std.text.same(name, "unset") { return unset(shell, fields) }
    if std.text.same(name, "set") { return setOptions(shell, fields) }
    if std.text.same(name, "shift") { return shiftParameters(shell, fields) }
    if std.text.same(name, "read") { return readLine(shell, fields) }
    if std.text.same(name, "type") { return typeOf(shell, fields, false) }
    if std.text.same(name, "command") { return command(shell, fields) }
    if std.text.same(name, "wait") { return waitJobs(shell, fields) }
    if std.text.same(name, "kill") { return kill(shell, fields) }
    if std.text.same(name, "umask") { return umask(shell, fields) }
    if std.text.same(name, "trap") { return trap(shell, fields) }
    if std.text.same(name, "local") { return local(shell, fields) }
    if std.text.same(name, ".") || std.text.same(name, "source") { return source(shell, fields) }
    if std.text.same(name, "history") { return history(shell, fields) }
    if std.text.same(name, "jobs") { return listJobs(shell, fields) }
    if std.text.same(name, "fg") { return foregroundOrBackground(shell, fields, true) }
    if std.text.same(name, "bg") { return foregroundOrBackground(shell, fields, false) }
    if std.text.same(name, "getopts") { return getopts(shell, fields) }
    if std.text.same(name, "alias") { return alias(shell, fields) }
    if std.text.same(name, "unalias") { return unalias(shell, fields) }
    if std.text.same(name, "hash") { return 0 }
    if std.text.same(name, "help") {
        outLine(": . source alias bg break cd command continue echo eval exec exit export false fg getopts hash help history jobs kill local printf pwd read readonly return set shift test [ trap true type umask unalias unset wait")
        return 0
    }
    if std.text.same(name, "eval") {
        var text: [65536]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &text) }
        var length: usize = 0
        var index: usize = 1
        while index < fields.*.count {
            if index > 1 { length = appendOut(bytes, length, 65536, " ") }
            length = appendOut(bytes, length, 65536, arg(fields, index))
            index += 1
        }
        return shell.*.runText(@ptrCast(*anyopaque, shell), bytes[0..length])
    }
    if std.text.same(name, "exec") {
        if fields.*.count == 1 { return 0 }
        var rest = Fields.{ .items = state.constOffsetItems(fields.*.items, 1), .count = fields.*.count - 1, .capacity = fields.*.capacity }
        programs.executeProgram(shell, &rest)
        return 126
    }
    state.complainAbout("", name, "not a builtin")
    return 127
}
