// How flux makes and looks after its processes on brixOS (host.mlx is
// Linux's): by brixOS's own calls. A child is a process handle (branch
// gives it; the shell keeps the ones it made, to wait for any of them), a
// group a group handle (group_join), the terminal's front its session's
// (session_front); what becomes of a child is process_change's record,
// which the shell reads as wait4's words, and the shell's signal numbers
// (POSIX's, as it speaks them) are brixOS's events (event_send).
const std = @import("std")
const brix = std.os.brix
const events = @import("std.events")

// The children this shell made and has not seen end (handles), with a
// stop or a going-on taken but not asked for yet.
const MAX_CHILDREN: usize = 64
const NONE: usize = 0xFFFFFFFFFFFFFFFF

var children: [MAX_CHILDREN]u32 = undefined // (per run)
var pending: [MAX_CHILDREN]usize = undefined // (per run)
var count: usize = 0 // (per run)

const WNOHANG: usize = 1
const WUNTRACED: usize = 2
const WCONTINUED: usize = 8

// Linux's errno values the shell checks.
const ECHILD: isize = -10

fn indexOf(handle: u32) -> usize {
    var k: usize = 0
    while k < count {
        if children[k] == handle { return k }
        k += 1
    }
    return count
}

// The child at `k` let go (its handle closed).
fn remove(k: usize) -> void {
    _ = brix.close(children[k])
    count -= 1
    children[k] = children[count]
    pending[k] = pending[count]
}

// branch: 0 in the child (which lets go of the shell's children: they
// are not its own), the child's handle in the shell.
pub fn fork() -> isize {
    const made = brix.branch()
    if made == 0 {
        while count > 0 { remove(count - 1) }
        return 0
    }
    if made < 0 { return -12 }
    const handle = @intCast(u32, made)
    if count < MAX_CHILDREN {
        children[count] = handle
        pending[count] = NONE
        count += 1
    }
    return made
}

// replace: returns only when it failed (-errno; -8: no program, a script
// for this shell).
pub fn execute(path: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8) -> isize {
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    const opened = brix.open(0, path[0..length], brix.Open.READ, 0)
    // (denied: 20)
    if opened < 0 { return if opened == -20 { -13 } else { -2 } }
    const program = @intCast(u32, opened)
    // The program's roles: our 0, 1 and 2, and our session.
    var roles: [4]brix.RoleRecord = undefined
    roles[0] = brix.RoleRecord.{ .role = brix.Role.INPUT, .handle = brix.ofDescriptor(0) }
    roles[1] = brix.RoleRecord.{ .role = brix.Role.OUTPUT, .handle = brix.ofDescriptor(1) }
    roles[2] = brix.RoleRecord.{ .role = brix.Role.ERRORS, .handle = brix.ofDescriptor(2) }
    var count: usize = 3
    const session = brix.handleFor(brix.Role.SESSION)
    if session != 0 {
        roles[3] = brix.RoleRecord.{ .role = brix.Role.SESSION, .handle = session }
        count = 4
    }
    const begin = brix.Start.{ .arguments = @intFromPtr(arguments), .environment = @intFromPtr(environment), .roles = @intFromPtr(&roles), .count = count }
    const replaced = brix.replace(program, &begin)
    _ = brix.close(program)
    if -replaced == brix.Status.wrong_kind { return -8 }
    if -replaced == brix.Status.no_memory { return -12 }
    return -13
}

pub fn selfPath() -> [*]const u8 { return unsafe { @ptrCast([*]const u8, "/system/programs/flux") } }

// What the child at `k` became, as wait4's word in `raw`, when `flags`
// ask for it (a stop or a going-on not asked for is kept); false when
// nothing is there to say. A child that ended is let go.
fn take(k: usize, raw: *usize, flags: usize) -> bool {
    if pending[k] != NONE {
        const word = pending[k]
        if (word == 0xFFFF && flags & WCONTINUED != 0) || (word != 0xFFFF && flags & WUNTRACED != 0) {
            pending[k] = NONE
            raw.* = word
            return true
        }
    }
    var change = brix.Change.{ .what = 0, .value = 0, .detail = 0, .reserved = 0 }
    while true {
        const result = brix.change(children[k], &change)
        if result == -brix.Status.would_block { return false }
        if result < 0 {
            // Not (any more) a child of ours.
            remove(k)
            return false
        }
        if change.what == brix.Change.EXITED {
            raw.* = (@intCast(usize, change.value) & 0xFF) << 8
            remove(k)
            return true
        }
        if change.what == brix.Change.ENDED {
            raw.* = signalFrom(&change) & 0x7F
            remove(k)
            return true
        }
        if change.what == brix.Change.STOPPED {
            const word = (signalFrom(&change) << 8) | 0x7F
            if flags & WUNTRACED != 0 {
                raw.* = word
                return true
            }
            pending[k] = word
        } else {
            if flags & WCONTINUED != 0 {
                raw.* = 0xFFFF
                return true
            }
            pending[k] = NONE
        }
    }
    return false
}

// As wait4 on a child (-1: any): its handle with its word in `raw`, 0
// with WNOHANG while nothing changed, -ECHILD when there is none.
pub fn waitChild(id: isize, raw: *usize, flags: usize) -> isize {
    while true {
        if id == -1 {
            if count == 0 { return ECHILD }
            var k: usize = 0
            while k < count {
                const handle = children[k]
                const before = count
                if take(k, raw, flags) { return @intCast(isize, handle) }
                if count == before { k += 1 }
            }
            if count == 0 { return ECHILD }
        } else {
            const k = indexOf(@intCast(u32, id))
            if k == count { return ECHILD }
            if take(k, raw, flags) { return id }
            if indexOf(@intCast(u32, id)) == count { return ECHILD }
        }
        if flags & WNOHANG != 0 { return 0 }
        var items: [MAX_CHILDREN]brix.WaitItem = undefined
        var n: usize = 0
        var k: usize = 0
        while k < count {
            if id == -1 || children[k] == @intCast(u32, id) {
                items[n] = brix.WaitItem.{ .handle = children[k], .want = brix.State.ENDED | brix.State.CHANGED, .seen = 0, .reserved = 0 }
                n += 1
            }
            k += 1
        }
        _ = brix.wait(items[0..n], brix.FOREVER)
    }
    return ECHILD
}

pub fn ownGroup() -> isize { return brix.joinGroup(0, 0) }

// group_join: the process (0: the caller) into the group (0: a new one);
// a handle to the group.
pub fn joinGroup(id: isize, group: isize) -> isize { return brix.joinGroup(@intCast(u32, id), @intCast(u32, group)) }

pub fn dropGroup(group: isize) -> void { if group > 0 { _ = brix.close(@intCast(u32, group)) } }

pub fn inFront(terminal: isize, group: isize) -> bool {
    var info = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
    if brix.info(@intCast(u32, group), &info) < 0 { return false }
    return info.state & brix.State.FRONT != 0
}

pub fn setFront(terminal: isize, group: isize) -> void { _ = brix.front(brix.ofDescriptor(terminal), @intCast(u32, group)) }

// A signal to a child (or, negative, its group) as its event; to what is
// no handle of ours, the process with that pid.
pub fn signal(target: isize, number: usize) -> isize {
    const handle = if target < 0 { -target } else { target }
    if handle > 0 && handle < 0x100000000 {
        var info = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
        if brix.info(@intCast(u32, handle), &info) >= 0 && (info.kind == brix.Kind.PROCESS || info.kind == brix.Kind.GROUP) {
            if number == 0 { return 0 }
            return if brix.sendEvent(@intCast(u32, handle), kindOf(number)) == 0 { 0 } else { -3 }
        }
    }
    // A pid (a number from elsewhere: $$, ps): the process opened by it
    // (process_open), its event sent.
    if target <= 0 || target >= 0x100000000 { return -3 }
    const opened = brix.processOpen(@intCast(u32, target))
    if opened < 0 { return if opened == -brix.Status.no_right { -1 } else { -3 } }
    const process = @intCast(u32, opened)
    const sent = if number == 0 { @intCast(isize, 0) } else { brix.sendEvent(process, kindOf(number)) }
    _ = brix.close(process)
    return if sent == 0 { 0 } else { -3 }
}

// POSIX's signal numbers (as Linux numbers them, as the shell speaks
// them) and brixOS's events.
fn kindOf(number: usize) -> u32 {
    if number == 1 { return brix.Event.HANGUP }
    if number == 2 { return brix.Event.INTERRUPT }
    if number == 3 { return brix.Event.QUIT }
    if number == 9 { return brix.Event.KILL }
    if number == 13 { return brix.Event.BROKEN }
    if number == 15 { return brix.Event.TERMINATE }
    if number == 17 { return brix.Event.CHILD }
    if number == 18 { return brix.Event.RESUME }
    if number == 19 { return brix.Event.HALT }
    if number == 20 { return brix.Event.SUSPEND }
    if number == 21 || number == 22 { return brix.Event.READ_BEHIND }
    if number == 28 { return brix.Event.NOTICE }
    return brix.Event.USER
}

// The signal a change was for: the number it was sent as (the Linux
// layer's detail), else its event's.
fn signalFrom(change: *const brix.Change) -> usize {
    if change.*.detail & 0x80000000 != 0 { return @intCast(usize, change.*.detail & 0xFF) }
    return signalOf(change.*.value)
}

fn signalOf(kind: u32) -> usize {
    if kind == brix.Event.HANGUP { return 1 }
    if kind == brix.Event.INTERRUPT { return 2 }
    if kind == brix.Event.QUIT { return 3 }
    if kind == brix.Event.KILL { return 9 }
    if kind == brix.Event.FAULT { return 11 }
    if kind == brix.Event.BROKEN { return 13 }
    if kind == brix.Event.TERMINATE { return 15 }
    if kind == brix.Event.CHILD { return 17 }
    if kind == brix.Event.RESUME { return 18 }
    if kind == brix.Event.HALT { return 19 }
    if kind == brix.Event.SUSPEND { return 20 }
    if kind == brix.Event.READ_BEHIND { return 21 }
    if kind == brix.Event.NOTICE { return 28 }
    return 10
}

// stream_pair, its ends going when a program replaces the child; their
// slots are the descriptors.
pub fn pipe(read_end: *isize, write_end: *isize) -> bool {
    var ends: [2]u32 = [2]u32{ 0, 0 }
    if brix.streamPairWith(&ends, brix.CLOSE_ON_REPLACE) < 0 { return false }
    read_end.* = @intCast(isize, (ends[0] & 0xFF) - 1)
    write_end.* = @intCast(isize, (ends[1] & 0xFF) - 1)
    return true
}

// ---------------------------------------------------------------------------
// Descriptors, the process, its signals on brixOS: std.fs's descriptors
// (handles' slots), process_self, and the signals as events claimed: one
// ignored or blocked is a kind the shell claims (its events wait in the
// queue, where sys.takeSignal takes the blocked ones and drops the
// others); one at its default is not claimed (the kernel's default).

pub fn close(descriptor: isize) -> void { _ = std.fs.close(std.fs.File.{ .descriptor = descriptor }) }

pub fn write(descriptor: isize, bytes: [*]const u8, length: usize) -> isize { return std.fs.write(std.fs.File.{ .descriptor = descriptor }, bytes, length) }

pub fn writeAll(descriptor: isize, text: []const u8) -> bool { return std.fs.writeAll(std.fs.File.{ .descriptor = descriptor }, text) }

pub fn exit(code: usize) -> void { brix.exit(code) }

pub fn processId() -> usize {
    var record: brix.ProcessRecord = undefined
    var none: [1]u8 = undefined
    if brix.processSelf(&record, none[0..0]) < 0 { return 0 }
    return @intCast(usize, record.pid)
}

pub fn realUserId() -> usize {
    var record: brix.ProcessRecord = undefined
    var none: [1]u8 = undefined
    if brix.processSelf(&record, none[0..0]) < 0 { return 0 }
    return @intCast(usize, record.user)
}

// handle_duplicate: the copy's slot is its descriptor.
pub fn duplicate(descriptor: isize) -> isize {
    // (Rights 0: the same rights as the original.)
    const copied = brix.duplicate(brix.ofDescriptor(descriptor), 0)
    if copied < 0 { return -9 }
    return @intCast(isize, (@bitCast(usize, copied) & 0xFF) - 1)
}

// A copy at 10 or above (the copies below given back).
pub fn duplicateHigh(descriptor: isize) -> isize {
    var low: [10]isize = undefined
    var count: usize = 0
    var copy = duplicate(descriptor)
    while copy >= 0 && copy < 10 && count < 10 {
        low[count] = copy
        count += 1
        copy = duplicate(descriptor)
    }
    var k: usize = 0
    while k < count {
        close(low[k])
        k += 1
    }
    return copy
}

var ignoredSignals: usize = 0 // (per run)
var blockedSignals: usize = 0 // (per run)

fn signalBit(signal: usize) -> usize { return if signal >= 1 && signal <= 64 { @intCast(usize, 1) << @intCast(u6, signal - 1) } else { 0 } }

// The kinds claimed: those of the signals ignored or blocked.
fn claimSignals() -> void {
    var kinds: u32 = 0
    var signal: usize = 1
    while signal <= 31 {
        if (ignoredSignals | blockedSignals) & signalBit(signal) != 0 && signal != 9 && signal != 19 { kinds |= brix.Event.bit(kindOf(signal)) }
        signal += 1
    }
    // (Beside what std's handlers claim: the crash report's fault.)
    _ = events.queue(kinds)
}

pub fn setSignalHandler(signal: usize, handler: usize) -> bool {
    if handler == 1 { ignoredSignals |= signalBit(signal) } else { ignoredSignals &= ~signalBit(signal) }
    claimSignals()
    return true
}

// how: 0 block, 1 unblock, 2 set (as Linux's SIG_BLOCK, SIG_UNBLOCK,
// SIG_SETMASK).
pub fn changeSignalMask(how: usize, mask: usize) -> usize {
    const before = blockedSignals
    if how == 0 { blockedSignals |= mask } else if how == 1 { blockedSignals &= ~mask } else { blockedSignals = mask }
    claimSignals()
    return before
}
