// GCC's builtins that are instructions: the bit builtins
// (`__builtin_clz`, `__builtin_ctzl`, `__builtin_popcountll`,
// `__builtin_bswap32`, `__builtin_ffs`, ...) as nodes of kind ast.BITOP
// (gen.genBitop: bsr, bsf, popcnt, bswap), and `asm` statements of one
// operand-less instruction (`asm volatile("pause")`, `asm("" ::: "memory")`,
// `int3`, `ud2`, the fences) as nodes of kind ast.ASM (gen.genAsm). The
// builtins that are plain C (`__builtin_memcpy`, `__builtin_expect`,
// `__builtin_isnan`, ...) are macros (main.mlx PREDEFINED).
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const cursor = @import("./cursor.mlx")
const ast = @import("./ast.mlx")
const types = @import("./types.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")

// Node.value of a BITOP.
pub const CLZ: i64 = 1
pub const CTZ: i64 = 2
pub const POPCOUNT: i64 = 3
pub const BSWAP: i64 = 4
pub const FFS: i64 = 5

// Node.value of an ASM: the instruction.
pub const ASM_NOTHING: i64 = 0
pub const ASM_PAUSE: i64 = 1
pub const ASM_INT3: i64 = 2
pub const ASM_NOP: i64 = 3
pub const ASM_MFENCE: i64 = 4
pub const ASM_LFENCE: i64 = 5
pub const ASM_SFENCE: i64 = 6
pub const ASM_UD2: i64 = 7

// The bit builtin `name` stands for (0 for none) and its width in bits.
fn bitOperation(name: u32) -> (i64, i64) {
    const text = base.nameOf(name)
    if text.length < 12 || !base.same(text[0..10], "__builtin_") { return -> (0, 0) }
    var rest = text[10..text.length]
    var width: i64 = 32
    if base.same(rest, "bswap16") { return -> (BSWAP, 16) }
    if base.same(rest, "bswap32") { return -> (BSWAP, 32) }
    if base.same(rest, "bswap64") { return -> (BSWAP, 64) }
    if rest.length > 2 && base.same(rest[rest.length - 2..rest.length], "ll") {
        width = 64
        rest = rest[0..rest.length - 2]
    } else if rest.length > 1 && rest[rest.length - 1] == 'l' {
        width = 64
        rest = rest[0..rest.length - 1]
    }
    if base.same(rest, "clz") { return -> (CLZ, width) }
    if base.same(rest, "ctz") { return -> (CTZ, width) }
    if base.same(rest, "popcount") { return -> (POPCOUNT, width) }
    if base.same(rest, "ffs") { return -> (FFS, width) }
    return -> (0, 0)
}

pub fn isBitBuiltin(name: u32) -> bool {
    return bitOperation(name).0 != 0
}

// `__builtin_clz(x)` at the name: the node.
pub fn bitBuiltin(token: usize) -> usize {
    const op = bitOperation(tokens.name(token))
    cursor.advance()
    cursor.expect(names.P_LPAREN)
    const operand = expr.assign()
    cursor.expect(names.P_RPAREN)
    typing.addType(operand)
    const unsignedType = if op.1 == 64 { types.ulongOf() } else if op.1 == 32 { types.uintOf() } else { types.ushortOf() }
    const n = ast.make(ast.BITOP, token)
    ast.node(n).*.value = op.0
    ast.node(n).*.high = op.1
    ast.node(n).*.lhs = typing.cast(operand, unsignedType)
    ast.node(n).*.ty = if op.0 == BSWAP { unsignedType } else { types.intOf() }
    return n
}

// `asm [volatile] ("text" [: outputs [: inputs [: clobbers]]])` at
// `asm`: the node. Only an instruction without operands is taken (the
// clobbers may say "memory").
pub fn asmExpression(token: usize) -> usize {
    cursor.advance()
    while cursor.consume(names.K_VOLATILE) || cursor.consume(names.K_GNU2_VOLATILE) || cursor.consume(names.K_INLINE) || cursor.consume(names.K_GNU2_INLINE) {}
    cursor.expect(names.P_LPAREN)
    var text: []const u8 = ""
    while tokens.kind(cursor.peek()) == tokens.STRING {
        text = base.join(text, literalText(cursor.peek()))
        cursor.advance()
    }
    // The operands: none may be given (the clobbers are passed over).
    var colons: u32 = 0
    while !cursor.is(names.P_RPAREN) {
        if cursor.isEof() { cursor.fail("unterminated asm") }
        if cursor.consume(names.P_COLON) {
            colons += 1
            continue
        }
        if cursor.consume(names.P_SCOPE) {
            // `::: "memory"`: the `::` of C++ is two colons here.
            colons += 2
            continue
        }
        if colons < 3 { tokens.errorAt(token, "inline assembly with operands is not supported") }
        cursor.advance()
    }
    cursor.expect(names.P_RPAREN)
    const n = ast.make(ast.ASM, token)
    ast.node(n).*.value = instruction(trimmed(text), token)
    ast.node(n).*.ty = types.voidOf()
    return n
}

// The text between the quotes of a string literal token.
fn literalText(token: usize) -> []const u8 {
    const raw = tokens.text(token)
    var first: usize = 0
    while first < raw.length && raw[first] != '"' { first += 1 }
    var last = raw.length
    while last > first + 1 && raw[last - 1] != '"' { last -= 1 }
    if last <= first + 1 { return "" }
    return raw[first + 1..last - 1]
}

// The text without the blanks, newlines and semicolons around it.
fn trimmed(text: []const u8) -> []const u8 {
    var start: usize = 0
    var end = text.length
    while start < end && isBlank(text[start]) { start += 1 }
    while end > start && isBlank(text[end - 1]) { end -= 1 }
    return text[start..end]
}

fn isBlank(c: u8) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == ';' || c == '\\'
}

fn instruction(text: []const u8, token: usize) -> i64 {
    if text.length == 0 { return ASM_NOTHING }
    if base.same(text, "pause") || base.same(text, "rep; nop") || base.same(text, "rep nop") { return ASM_PAUSE }
    if base.same(text, "int3") || base.same(text, "int $3") { return ASM_INT3 }
    if base.same(text, "nop") { return ASM_NOP }
    if base.same(text, "mfence") { return ASM_MFENCE }
    if base.same(text, "lfence") { return ASM_LFENCE }
    if base.same(text, "sfence") { return ASM_SFENCE }
    if base.same(text, "ud2") { return ASM_UD2 }
    tokens.errorAt(token, base.join("inline assembly is not supported: ", text))
    return ASM_NOTHING
}
