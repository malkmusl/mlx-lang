// The atomic builtins of GCC (`__atomic_load_n`, `__atomic_fetch_add`,
// `__atomic_compare_exchange_n`, `__sync_fetch_and_add`, ...), which
// <atomic>, <stdatomic.h> and code like WTF's Atomics.h are written
// with: each a node of kind ast.ATOMIC (gen.genAtomic makes the x86
// instruction: a locked xadd, xchg or cmpxchg, mfence) on an integer
// or pointer of 1, 2, 4 or 8 bytes. The memory orders are taken as
// sequentially consistent (x86 loads and stores are ordered; the
// locked instructions are full barriers).
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const cursor = @import("./cursor.mlx")
const ast = @import("./ast.mlx")
const types = @import("./types.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")

// Node.value: the operation.
pub const LOAD: i64 = 1
pub const STORE: i64 = 2
pub const EXCHANGE: i64 = 3
pub const ADD: i64 = 4
pub const SUB: i64 = 5
pub const AND: i64 = 6
pub const OR: i64 = 7
pub const XOR: i64 = 8
pub const NAND: i64 = 9
pub const CMPXCHG: i64 = 10
pub const FENCE: i64 = 11

// Whether `name` is one of the builtins (`__atomic_...`, `__sync_...`).
pub fn isBuiltin(name: u32) -> bool {
    const text = base.nameOf(name)
    if text.length >= 9 && base.same(text[0..9], "__atomic_") { return true }
    return text.length >= 7 && base.same(text[0..7], "__sync_")
}

// The call of the builtin named at `token` (the cursor at the name).
pub fn builtin(token: usize) -> usize {
    const text = base.nameOf(tokens.name(token))
    cursor.advance()
    cursor.expect(names.P_LPAREN)
    const given = base.alloc(8 * 8)
    const count = expr.argumentList(names.P_RPAREN, given, 8)
    if base.same(text[0..9], "__atomic_") { return atomic(text[9..text.length], given, count, token) }
    return sync(text[7..text.length], given, count, token)
}

fn argument(given: usize, count: usize, index: usize, token: usize) -> usize {
    if index >= count { tokens.errorAt(token, "too few arguments to the atomic builtin") }
    return base.getWord(given + index * 8)
}

// The type the pointer `p` points to: an integer, an enum, a bool or a
// pointer of a size the instructions take.
fn pointee(p: usize, token: usize) -> usize {
    typing.addType(p)
    const pt = ast.typeOf(p)
    if types.kind(pt) != types.PTR { tokens.errorAt(token, "the atomic builtin needs a pointer") }
    const ty = types.unqualified(types.baseOf(pt))
    const size = types.size(ty)
    const k = types.kind(ty)
    const scalar = types.isInteger(ty) || k == types.PTR || k == types.ENUM || k == types.BOOL
    if !scalar || (size != 1 && size != 2 && size != 4 && size != 8) { tokens.errorAt(token, "the atomic builtin takes an integer or a pointer of 1, 2, 4 or 8 bytes") }
    return ty
}

// The node: `op` on the object `p` points to, with the value `v` (0
// for none) and, for a compare-exchange, `expected` (a pointer to the
// value expected, which takes the value seen). `fetchNew`: the result
// is the value after the operation rather than before it.
fn make(op: i64, p: usize, v: usize, expected: usize, fetchNew: bool, token: usize) -> usize {
    const ty = pointee(p, token)
    const n = ast.make(ast.ATOMIC, token)
    const node = ast.node(n)
    node.*.value = op
    node.*.high = if fetchNew { 1 } else { 0 }
    node.*.lhs = p
    if v != 0 {
        typing.addType(v)
        node.*.rhs = typing.cast(v, ty)
    }
    if expected != 0 {
        typing.addType(expected)
        if types.kind(ast.typeOf(expected)) != types.PTR { tokens.errorAt(token, "the expected value is given through a pointer") }
        node.*.cond = expected
    }
    if op == STORE { node.*.ty = types.voidOf() } else if op == CMPXCHG { node.*.ty = types.boolOf() } else { node.*.ty = ty }
    return n
}

fn fence(token: usize) -> usize {
    const n = ast.make(ast.ATOMIC, token)
    ast.node(n).*.value = FENCE
    ast.node(n).*.ty = types.voidOf()
    return n
}

fn deref(p: usize, token: usize) -> usize {
    typing.addType(p)
    if types.kind(ast.typeOf(p)) != types.PTR { tokens.errorAt(token, "the atomic builtin needs a pointer") }
    const n = ast.unary(ast.DEREF, p, token)
    ast.node(n).*.ty = types.baseOf(ast.typeOf(p))
    return n
}

fn assignTo(target: usize, value: usize, token: usize) -> usize {
    const n = ast.binary(ast.ASSIGN, target, value, token)
    typing.addType(n)
    return n
}

fn boolNumber(value: i64, token: usize) -> usize {
    const n = ast.number(value, token)
    ast.node(n).*.ty = types.boolOf()
    return n
}

fn operation(name: []const u8) -> i64 {
    if base.same(name, "add") { return ADD }
    if base.same(name, "sub") { return SUB }
    if base.same(name, "and") { return AND }
    if base.same(name, "or") { return OR }
    if base.same(name, "xor") { return XOR }
    if base.same(name, "nand") { return NAND }
    return 0
}

// `__atomic_<name>(...)`.
fn atomic(name: []const u8, given: usize, count: usize, token: usize) -> usize {
    const p = argument(given, count, 0, token)
    if base.same(name, "load_n") { return make(LOAD, p, 0, 0, false, token) }
    if base.same(name, "load") {
        // `__atomic_load(p, ret, order)`: *ret = *p.
        return assignTo(deref(argument(given, count, 1, token), token), make(LOAD, p, 0, 0, false, token), token)
    }
    if base.same(name, "store_n") { return make(STORE, p, argument(given, count, 1, token), 0, false, token) }
    if base.same(name, "store") { return make(STORE, p, deref(argument(given, count, 1, token), token), 0, false, token) }
    if base.same(name, "exchange_n") { return make(EXCHANGE, p, argument(given, count, 1, token), 0, false, token) }
    if base.same(name, "exchange") {
        // `__atomic_exchange(p, val, ret, order)`.
        const made = make(EXCHANGE, p, deref(argument(given, count, 1, token), token), 0, false, token)
        return assignTo(deref(argument(given, count, 2, token), token), made, token)
    }
    if base.same(name, "compare_exchange_n") { return make(CMPXCHG, p, argument(given, count, 2, token), argument(given, count, 1, token), false, token) }
    if base.same(name, "compare_exchange") { return make(CMPXCHG, p, deref(argument(given, count, 2, token), token), argument(given, count, 1, token), false, token) }
    if name.length > 6 && base.same(name[0..6], "fetch_") {
        const op = operation(name[6..name.length])
        if op != 0 { return make(op, p, argument(given, count, 1, token), 0, false, token) }
    }
    if name.length > 6 && base.same(name[name.length - 6..name.length], "_fetch") {
        const op = operation(name[0..name.length - 6])
        if op != 0 { return make(op, p, argument(given, count, 1, token), 0, true, token) }
    }
    if base.same(name, "thread_fence") { return fence(token) }
    if base.same(name, "signal_fence") {
        const n = ast.make(ast.NULL_EXPR, token)
        ast.node(n).*.ty = types.voidOf()
        return n
    }
    if base.same(name, "test_and_set") {
        // The byte set to 1: whether it was set.
        const made = make(EXCHANGE, p, ast.number(1, token), 0, false, token)
        const zero = ast.number(0, token)
        typing.addType(zero)
        const n = ast.binary(ast.NE, made, zero, token)
        ast.node(n).*.ty = types.boolOf()
        return n
    }
    if base.same(name, "clear") { return make(STORE, p, ast.number(0, token), 0, false, token) }
    if base.same(name, "always_lock_free") || base.same(name, "is_lock_free") { return boolNumber(1, token) }
    tokens.errorAt(token, "unknown atomic builtin")
    return 0
}

// `__sync_<name>(...)`: the older builtins.
fn sync(name: []const u8, given: usize, count: usize, token: usize) -> usize {
    if base.same(name, "synchronize") { return fence(token) }
    const p = argument(given, count, 0, token)
    if name.length > 10 && base.same(name[0..10], "fetch_and_") {
        const op = operation(name[10..name.length])
        if op != 0 { return make(op, p, argument(given, count, 1, token), 0, false, token) }
    }
    if name.length > 10 && base.same(name[name.length - 10..name.length], "_and_fetch") {
        const op = operation(name[0..name.length - 10])
        if op != 0 { return make(op, p, argument(given, count, 1, token), 0, true, token) }
    }
    if base.same(name, "bool_compare_and_swap") || base.same(name, "val_compare_and_swap") {
        // The expected value through a temporary (which takes the value
        // seen: the result of the val form).
        const ty = pointee(p, token)
        const tmp = typing.temporaryOf(ty, token)
        const stored = assignTo(ast.variableNode(tmp, token), typing.cast(argument(given, count, 1, token), ty), token)
        const holder = ast.variableNode(tmp, token)
        typing.addType(holder)
        const address = ast.unary(ast.ADDR, holder, token)
        ast.node(address).*.ty = types.pointerTo(ty)
        const swapped = make(CMPXCHG, p, argument(given, count, 2, token), address, false, token)
        var n = ast.binary(ast.COMMA, stored, swapped, token)
        ast.node(n).*.ty = types.boolOf()
        if base.same(name, "val_compare_and_swap") {
            const seen = ast.variableNode(tmp, token)
            typing.addType(seen)
            n = ast.binary(ast.COMMA, n, seen, token)
            ast.node(n).*.ty = ty
        }
        return n
    }
    if base.same(name, "lock_test_and_set") { return make(EXCHANGE, p, argument(given, count, 1, token), 0, false, token) }
    if base.same(name, "lock_release") { return make(STORE, p, ast.number(0, token), 0, false, token) }
    tokens.errorAt(token, "unknown atomic builtin")
    return 0
}
