// Initializers (C11 6.7.9): brace-enclosed lists with designators
// (`.member =`, `[index] =`, GNU `[first ... last] =`), the braces left
// out around nested aggregates, strings for character arrays, the size
// an array of unknown size gets from its initializer, and the flexible
// array member a static struct may fill. A local's initializer becomes
// a zeroing of the whole object and assignments to its parts; a global's
// is evaluated into its bytes and the addresses in them.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const cursor = @import("./cursor.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")
const eval = @import("./eval.mlx")
const scope = @import("./scope.mlx")
const standard = @import("./standard.mlx")
const extended = @import("./extended.mlx")
const program = @import("./program.mlx")
const wide = @import("./wide.mlx")

// The value given to an object or a part of it: an expression for a
// scalar (or a whole struct), children for the elements and members.
const Init = struct {
    ty: usize
    token: usize
    // An array of unknown size, sized by the initializer.
    flexible: bool
    expression: usize
    // The children's addresses, one word each.
    children: usize
    // The union member given a value (0: the first).
    member: usize
}

fn at(init: usize) -> *Init {
    unsafe { return @ptrFromInt(*Init, init) }
}

fn child(init: usize, index: i64) -> usize {
    return base.getWord(at(init).*.children + @intCast(usize, index) * 8)
}

fn memberCount(ty: usize) -> i64 {
    var count: i64 = 0
    var m = types.at(ty).*.members
    while m != 0 {
        count += 1
        m = types.member(m).*.next
    }
    return count
}

fn newInit(ty: usize, flexible: bool) -> usize {
    const init = base.alloc(@sizeOf(Init))
    at(init).*.ty = ty
    at(init).*.token = cursor.peek()
    const k = types.kind(ty)
    if k == types.ARRAY {
        if flexible && types.at(ty).*.incomplete {
            at(init).*.flexible = true
            return init
        }
        const length = types.at(ty).*.arrayLength
        at(init).*.children = base.alloc(@intCast(usize, length) * 8 + 8)
        var index: i64 = 0
        while index < length {
            base.putWord(at(init).*.children + @intCast(usize, index) * 8, newInit(types.baseOf(ty), false))
            index += 1
        }
        return init
    }
    if k == types.STRUCT || k == types.UNION {
        at(init).*.children = base.alloc(@intCast(usize, memberCount(ty)) * 8 + 8)
        var m = types.at(ty).*.members
        while m != 0 {
            const index = types.member(m).*.index
            var c: usize = 0
            if flexible && types.at(ty).*.flexible && types.member(m).*.next == 0 {
                // The flexible array member of a static struct.
                c = base.alloc(@sizeOf(Init))
                at(c).*.ty = types.member(m).*.ty
                at(c).*.flexible = true
                at(c).*.token = cursor.peek()
            } else {
                c = newInit(types.member(m).*.ty, false)
            }
            base.putWord(at(init).*.children + @intCast(usize, index) * 8, c)
            m = types.member(m).*.next
        }
        return init
    }
    return init
}

// Makes `init` the initializer of an array of `length` elements of its
// element type.
fn resize(init: usize, length: i64) -> void {
    const sized = newInit(types.arrayOf(types.baseOf(at(init).*.ty), length), false)
    base.copy(init, sized, @sizeOf(Init))
}

fn skipExcessElement() -> void {
    if cursor.consume(names.P_LBRACE) {
        skipExcessElement()
        while !cursor.consumeEnd() {
            cursor.expect(names.P_COMMA)
            skipExcessElement()
        }
        return
    }
    const ignored = expr.assign()
}

fn stringInitializer(init: usize) -> void {
    const token = cursor.peek()
    cursor.advance()
    const st = tokens.at(token).*.ty
    const length = types.at(st).*.arrayLength
    if at(init).*.flexible { resize(init, length) }
    const ty = at(init).*.ty
    const element = types.baseOf(ty)
    const unit = types.size(element)
    const sourceUnit = types.size(types.baseOf(st))
    var count = types.at(ty).*.arrayLength
    if length < count { count = length }
    const data = tokens.at(token).*.data
    var index: i64 = 0
    while index < count {
        var v: i64 = 0
        // The literal's last unit is the terminating zero.
        if index < length - 1 {
            const address = data + @intCast(usize, index * sourceUnit)
            if sourceUnit == 1 {
                v = @intCast(i64, base.get8(address))
                if unit == 1 && !types.isUnsigned(element) && v >= 128 { v -= 256 }
            } else if sourceUnit == 2 {
                v = @intCast(i64, base.get8(address)) | (@intCast(i64, base.get8(address + 1)) << 8)
            } else {
                v = @intCast(i64, base.get32(address))
            }
        }
        const n = ast.number(v, token)
        ast.node(n).*.ty = element
        at(child(init, index)).*.expression = n
        index += 1
    }
}

// array-designator: `[` constant `]` or GNU `[` first `...` last `]`; the
// range.
fn arrayDesignator(ty: usize) -> (i64, i64) {
    const start = cursor.peek()
    cursor.expect(names.P_LBRACKET)
    const first = eval.constExpression()
    if first < 0 || first >= types.at(ty).*.arrayLength { tokens.errorAt(start, "array designator index exceeds array bounds") }
    var last = first
    if cursor.consume(names.P_ELLIPSIS) {
        last = eval.constExpression()
        if last >= types.at(ty).*.arrayLength { tokens.errorAt(start, "array designator index exceeds array bounds") }
        if last < first { tokens.errorAt(start, "array designator range is empty") }
    }
    cursor.expect(names.P_RBRACKET)
    return -> (first, last)
}

// struct-designator: `.` member; the member (an anonymous member holding
// it is returned with the cursor left on the `.`).
fn structDesignator(ty: usize) -> usize {
    const start = cursor.peek()
    cursor.expect(names.P_DOT)
    if !cursor.isIdent() { cursor.fail("expected a field designator") }
    const name = tokens.name(cursor.peek())
    var m = types.at(ty).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        if types.member(m).*.name == 0 && (types.kind(mt) == types.STRUCT || types.kind(mt) == types.UNION) {
            if expr.findMember(mt, name) != 0 {
                cursor.restore(start)
                return m
            }
        } else if types.member(m).*.name == name {
            cursor.advance()
            return m
        }
        m = types.member(m).*.next
    }
    cursor.fail("struct has no such member")
    return 0
}

// designation: designators then `=` and the initializer.
fn designation(init: usize) -> void {
    const ty = at(init).*.ty
    if cursor.is(names.P_LBRACKET) {
        if types.kind(ty) != types.ARRAY { cursor.fail("array index in non-array initializer") }
        const range = arrayDesignator(ty)
        const after = cursor.save()
        var index = range.0
        while index <= range.1 {
            cursor.restore(after)
            designation(child(init, index))
            index += 1
        }
        arrayInitializerRest(init, range.0 + 1)
        return
    }
    if cursor.is(names.P_DOT) && types.kind(ty) == types.STRUCT {
        const m = structDesignator(ty)
        designation(child(init, types.member(m).*.index))
        at(init).*.expression = 0
        structInitializerRest(init, types.member(m).*.next, false)
        return
    }
    if cursor.is(names.P_DOT) && types.kind(ty) == types.UNION {
        const m = structDesignator(ty)
        at(init).*.member = m
        designation(child(init, types.member(m).*.index))
        return
    }
    if cursor.is(names.P_DOT) { cursor.fail("field name not in struct or union initializer") }
    const ignored = cursor.consume(names.P_ASSIGN)
    initializer2(init)
}

// The number of elements an initializer list gives an array of unknown
// size (read ahead, then the cursor comes back).
fn countElements(ty: usize) -> i64 {
    const start = cursor.save()
    const dummy = newInit(types.baseOf(ty), true)
    var first = true
    var index: i64 = 0
    var most: i64 = 0
    while !cursor.consumeEnd() {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        if cursor.consume(names.P_LBRACKET) {
            index = eval.constExpression()
            if cursor.consume(names.P_ELLIPSIS) { index = eval.constExpression() }
            cursor.expect(names.P_RBRACKET)
            designation(dummy)
        } else {
            index += packedElements(dummy, 0, 1, true) - 1
        }
        index += 1
        if index > most { most = index }
    }
    cursor.restore(start)
    return most
}

// `{` initializers `}` for an array.
fn arrayInitializerBraced(init: usize) -> void {
    cursor.expect(names.P_LBRACE)
    if at(init).*.flexible { resize(init, countElements(at(init).*.ty)) }
    const length = types.at(at(init).*.ty).*.arrayLength
    var first = true
    var index: i64 = 0
    while !cursor.consumeEnd() {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        if cursor.is(names.P_LBRACKET) {
            const range = arrayDesignator(at(init).*.ty)
            const after = cursor.save()
            var element = range.0
            var reached = after
            while element <= range.1 {
                cursor.restore(after)
                designation(child(init, element))
                reached = cursor.save()
                element += 1
            }
            cursor.restore(reached)
            index = range.1 + 1
        } else {
            index += packedElements(init, index, length, false)
        }
    }
}

// The element at the cursor into the array `init` at `index` (passed
// over when the array is full): the number of elements it made. C++: an
// element followed by `...` is a pack expansion, one element per
// element of the pack (expr.argumentList's way).
fn packedElements(init: usize, index: i64, length: i64, counting: bool) -> i64 {
    const start = cursor.save()
    const seen = scope.packSeen
    scope.packSeen = 0
    if counting { initializer2(init) } else if index < length { initializer2(child(init, index)) } else { skipExcessElement() }
    var made: i64 = 1
    if standard.cpp && cursor.is(names.P_ELLIPSIS) && scope.packIndex < 0 {
        const holder = scope.packSeen
        if holder == 0 { cursor.fail("nothing to expand with ...") }
        const n = types.packCount(holder)
        made = n
        if n == 0 {
            if !counting && index < length { at(child(init, index)).*.expression = 0 }
        } else {
            var element: i64 = 1
            while element < n {
                scope.packIndex = element
                cursor.restore(start)
                if counting { initializer2(init) } else if index + element < length { initializer2(child(init, index + element)) } else { skipExcessElement() }
                scope.packIndex = -1
                element += 1
            }
        }
        cursor.expect(names.P_ELLIPSIS)
        scope.packSeen = seen
    } else if scope.packSeen == 0 {
        scope.packSeen = seen
    }
    return made
}

// The elements of an array without its own braces, from element `from`.
fn arrayInitializerRest(init: usize, from: i64) -> void {
    if at(init).*.flexible { resize(init, countElements(at(init).*.ty)) }
    const length = types.at(at(init).*.ty).*.arrayLength
    var index = from
    while index < length && !cursor.isEnd() {
        const start = cursor.save()
        if index > 0 { cursor.expect(names.P_COMMA) }
        if cursor.is(names.P_LBRACKET) || cursor.is(names.P_DOT) {
            cursor.restore(start)
            return
        }
        initializer2(child(init, index))
        index += 1
    }
}

fn structInitializerBraced(init: usize) -> void {
    cursor.expect(names.P_LBRACE)
    var m = types.at(at(init).*.ty).*.members
    var first = true
    while !cursor.consumeEnd() {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        if cursor.is(names.P_DOT) {
            m = structDesignator(at(init).*.ty)
            designation(child(init, types.member(m).*.index))
            m = types.member(m).*.next
        } else if m != 0 {
            m = packedMembers(init, m)
        } else {
            skipExcessElement()
        }
    }
}

// The element at the cursor into the member `m` of `init` (C++: an
// element followed by `...` into the members from `m` on, one per
// element of the pack): the member after the last one made.
fn packedMembers(init: usize, m: usize) -> usize {
    const start = cursor.save()
    const seen = scope.packSeen
    scope.packSeen = 0
    initializer2(child(init, types.member(m).*.index))
    var next = types.member(m).*.next
    if standard.cpp && cursor.is(names.P_ELLIPSIS) && scope.packIndex < 0 {
        const holder = scope.packSeen
        if holder == 0 { cursor.fail("nothing to expand with ...") }
        const n = types.packCount(holder)
        if n == 0 {
            at(child(init, types.member(m).*.index)).*.expression = 0
            next = m
        } else {
            var element: i64 = 1
            while element < n && next != 0 {
                scope.packIndex = element
                cursor.restore(start)
                initializer2(child(init, types.member(next).*.index))
                scope.packIndex = -1
                next = types.member(next).*.next
                element += 1
            }
        }
        cursor.expect(names.P_ELLIPSIS)
        scope.packSeen = seen
    } else if scope.packSeen == 0 {
        scope.packSeen = seen
    }
    return next
}

// The members of a struct without its own braces, from member `from`;
// `first` when no comma comes before it (after a designator one does).
fn structInitializerRest(init: usize, from: usize, startsList: bool) -> void {
    var first = startsList
    var m = from
    while m != 0 && !cursor.isEnd() {
        const start = cursor.save()
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        if cursor.is(names.P_LBRACKET) || cursor.is(names.P_DOT) {
            cursor.restore(start)
            return
        }
        initializer2(child(init, types.member(m).*.index))
        m = types.member(m).*.next
    }
}

fn unionInitializer(init: usize) -> void {
    const ty = at(init).*.ty
    if cursor.is(names.P_LBRACE) && cursor.isToken(cursor.peekNext(), names.P_DOT) {
        cursor.advance()
        const m = structDesignator(ty)
        at(init).*.member = m
        designation(child(init, types.member(m).*.index))
        const ignored = cursor.consume(names.P_COMMA)
        cursor.expect(names.P_RBRACE)
        return
    }
    const firstMember = types.at(ty).*.members
    if firstMember == 0 {
        // An empty union (GNU).
        if cursor.consume(names.P_LBRACE) { cursor.expect(names.P_RBRACE) }
        return
    }
    at(init).*.member = firstMember
    if cursor.consume(names.P_LBRACE) {
        initializer2(child(init, 0))
        const ignored = cursor.consume(names.P_COMMA)
        cursor.expect(names.P_RBRACE)
    } else {
        initializer2(child(init, 0))
    }
}

fn initializer2(init: usize) -> void {
    const ty = at(init).*.ty
    const k = types.kind(ty)
    if k == types.ARRAY && tokens.kind(cursor.peek()) == tokens.STRING && types.isInteger(types.baseOf(ty)) {
        stringInitializer(init)
        return
    }
    if k == types.ARRAY && cursor.is(names.P_LBRACE) && tokens.kind(cursor.peekNext()) == tokens.STRING && types.isInteger(types.baseOf(ty)) {
        // `char s[] = { "text" }`
        cursor.advance()
        stringInitializer(init)
        const ignored = cursor.consume(names.P_COMMA)
        cursor.expect(names.P_RBRACE)
        return
    }
    if k == types.ARRAY {
        if cursor.is(names.P_LBRACE) { arrayInitializerBraced(init) } else { arrayInitializerRest(init, 0) }
        return
    }
    if k == types.STRUCT {
        if cursor.is(names.P_LBRACE) {
            structInitializerBraced(init)
            return
        }
        // A struct from another struct: `struct T x = y;`.
        const start = cursor.save()
        const e = expr.assign()
        typing.addType(e)
        if types.kind(ast.typeOf(e)) == types.STRUCT {
            at(init).*.expression = e
            return
        }
        cursor.restore(start)
        structInitializerRest(init, types.at(ty).*.members, true)
        return
    }
    if k == types.UNION {
        if !cursor.is(names.P_LBRACE) {
            const start = cursor.save()
            const e = expr.assign()
            typing.addType(e)
            if types.kind(ast.typeOf(e)) == types.UNION {
                at(init).*.expression = e
                return
            }
            cursor.restore(start)
        }
        unionInitializer(init)
        return
    }
    if cursor.consume(names.P_LBRACE) {
        // A scalar in braces: `int x = {3};`; `{}` (C23) leaves it zero.
        if cursor.consume(names.P_RBRACE) { return }
        initializer2(init)
        const ignored = cursor.consume(names.P_COMMA)
        cursor.expect(names.P_RBRACE)
        return
    }
    at(init).*.expression = expr.assign()
}

// Reads the initializer of an object of type `ty`; the initializer and
// the object's type, completed (an array's size, a flexible member).
fn initializer(ty: usize) -> (usize, usize) {
    const init = newInit(ty, true)
    initializer2(init)
    const k = types.kind(ty)
    if (k == types.STRUCT || k == types.UNION) && types.at(ty).*.flexible {
        // The struct with its flexible array member given a size.
        const copied = types.copy(ty)
        var head: usize = 0
        var tail: usize = 0
        var m = types.at(ty).*.members
        while m != 0 {
            const c = base.alloc(@sizeOf(types.Member))
            base.copy(c, m, @sizeOf(types.Member))
            types.member(c).*.next = 0
            if head == 0 { head = c } else { types.member(tail).*.next = c }
            tail = c
            m = types.member(m).*.next
        }
        types.at(copied).*.members = head
        const last = at(child(init, types.member(tail).*.index)).*.ty
        types.member(tail).*.ty = last
        types.at(copied).*.size = types.size(copied) + types.size(last)
        return -> (init, copied)
    }
    return -> (init, at(init).*.ty)
}

// ---------------------------------------------------------------------------
// Locals

// A designator path to a part of a local: the variable, or an element or
// member of the part before.
const Path = struct {
    up: usize
    index: i64
    member: usize
    variable: usize
}

fn pathAt(p: usize) -> *Path {
    unsafe { return @ptrFromInt(*Path, p) }
}

fn newPath(up: usize, index: i64, m: usize, variable: usize) -> usize {
    const p = base.alloc(@sizeOf(Path))
    pathAt(p).*.up = up
    pathAt(p).*.index = index
    pathAt(p).*.member = m
    pathAt(p).*.variable = variable
    return p
}

fn pathExpression(p: usize, token: usize) -> usize {
    const path = pathAt(p)
    if path.*.variable != 0 { return ast.variableNode(path.*.variable, token) }
    if path.*.member != 0 {
        const n = ast.unary(ast.MEMBER, pathExpression(path.*.up, token), token)
        ast.node(n).*.member = path.*.member
        return n
    }
    const lhs = pathExpression(path.*.up, token)
    const rhs = ast.number(path.*.index, token)
    return ast.unary(ast.DEREF, expr.newAdd(lhs, rhs, token), token)
}

fn localAssignments(init: usize, ty: usize, p: usize, token: usize) -> usize {
    const k = types.kind(ty)
    if k == types.ARRAY {
        var n = ast.make(ast.NULL_EXPR, token)
        var index: i64 = 0
        while index < types.at(ty).*.arrayLength {
            const rhs = localAssignments(child(init, index), types.baseOf(ty), newPath(p, index, 0, 0), token)
            n = ast.binary(ast.COMMA, n, rhs, token)
            index += 1
        }
        return n
    }
    if k == types.STRUCT && at(init).*.expression == 0 {
        var n = ast.make(ast.NULL_EXPR, token)
        var m = types.at(ty).*.members
        while m != 0 {
            const rhs = localAssignments(child(init, types.member(m).*.index), types.member(m).*.ty, newPath(p, 0, m, 0), token)
            n = ast.binary(ast.COMMA, n, rhs, token)
            m = types.member(m).*.next
        }
        return n
    }
    if k == types.UNION && at(init).*.expression == 0 {
        var m = at(init).*.member
        if m == 0 { m = types.at(ty).*.members }
        if m == 0 { return ast.make(ast.NULL_EXPR, token) }
        return localAssignments(child(init, types.member(m).*.index), types.member(m).*.ty, newPath(p, 0, m, 0), token)
    }
    if at(init).*.expression == 0 { return ast.make(ast.NULL_EXPR, token) }
    return ast.binary(ast.ASSIGN, pathExpression(p, token), at(init).*.expression, token)
}

// The initializer of the local `variable`, after its `=`: an expression
// that zeroes it and assigns the values given.
pub fn localInitializer(variable: usize) -> usize {
    const token = cursor.peek()
    const read = initializer(ast.obj(variable).*.ty)
    ast.obj(variable).*.ty = read.1
    const zero = ast.make(ast.MEMZERO, token)
    ast.node(zero).*.variable = variable
    const assignments = localAssignments(read.0, read.1, newPath(0, 0, 0, variable), token)
    return ast.binary(ast.COMMA, zero, assignments, token)
}

// ---------------------------------------------------------------------------
// Globals

fn readBytes(at_address: usize, size: i64) -> u64 {
    var v: u64 = 0
    var index: i64 = size - 1
    while index >= 0 {
        v = (v << 8) | @intCast(u64, base.get8(at_address + @intCast(usize, index)))
        index -= 1
    }
    return v
}

fn writeBytes(at_address: usize, v: u64, size: i64) -> void {
    var index: i64 = 0
    var rest = v
    while index < size {
        base.put8(at_address + @intCast(usize, index), @intCast(u8, rest & 255))
        rest = rest >> 8
        index += 1
    }
}

// Writes the value `init` gives a `ty` at `buffer` + `offset`; addresses
// become relocations of `variable`.
fn writeData(variable: usize, init: usize, ty: usize, buffer: usize, offset: i64) -> void {
    const k = types.kind(ty)
    if k == types.ARRAY {
        const element = types.size(types.baseOf(ty))
        var index: i64 = 0
        while index < types.at(ty).*.arrayLength {
            writeData(variable, child(init, index), types.baseOf(ty), buffer, offset + element * index)
            index += 1
        }
        return
    }
    if k == types.STRUCT && at(init).*.expression == 0 {
        var m = types.at(ty).*.members
        while m != 0 {
            const c = child(init, types.member(m).*.index)
            const width = types.member(m).*.bitWidth
            if width > 0 {
                const e = at(c).*.expression
                if e != 0 {
                    const location = buffer + @intCast(usize, offset + types.member(m).*.offset)
                    const unit = types.size(types.member(m).*.ty)
                    const old = readBytes(location, unit)
                    const v = @bitCast(u64, eval.evaluate(e))
                    const mask = if width >= 64 { ~zero() } else { (one() << @intCast(u6, width)) -% 1 }
                    const shifted = (v & mask) << @intCast(u6, types.member(m).*.bitOffset)
                    const cleared = old & ~(mask << @intCast(u6, types.member(m).*.bitOffset))
                    writeBytes(location, cleared | shifted, unit)
                }
            } else if width == 0 {
                writeData(variable, c, types.member(m).*.ty, buffer, offset + types.member(m).*.offset)
            }
            m = types.member(m).*.next
        }
        return
    }
    if k == types.UNION && at(init).*.expression == 0 {
        const m = at(init).*.member
        if m == 0 { return }
        writeData(variable, child(init, types.member(m).*.index), types.member(m).*.ty, buffer, offset)
        return
    }
    const e = at(init).*.expression
    if e == 0 { return }
    const location = buffer + @intCast(usize, offset)
    if standard.cpp && offset == 0 && ast.obj(variable).*.ty == ty && k != types.WIDE && k != types.LDOUBLE && !foldable(e, k) {
        // C++: a global whose value is no constant (`int g = f();`,
        // a constexpr function the compiler cannot fold) is assigned
        // when the program starts.
        const target = ast.variableNode(variable, ast.tokenOf(e))
        typing.addType(target)
        const assigned = ast.binary(ast.ASSIGN, target, typing.cast(e, ty), ast.tokenOf(e))
        typing.addType(assigned)
        program.addGlobalInit(assigned)
        return
    }
    if k == types.WIDE {
        writeWide(variable, e, ty, location, offset)
        return
    }
    if k == types.FLOAT {
        const f = @floatCast(f32, eval.floatValue(e))
        base.put32(location, @bitCast(u32, f))
        return
    }
    if k == types.DOUBLE {
        base.put64(location, @bitCast(u64, eval.floatValue(e)))
        return
    }
    if k == types.LDOUBLE {
        // A constant's exact 80 bits (negated through a minus), else
        // the double the expression folds to.
        var inner = e
        var negative = false
        while ast.kindOf(inner) == ast.CAST && types.kind(ast.typeOf(inner)) == types.LDOUBLE { inner = ast.node(inner).*.lhs }
        if ast.kindOf(inner) == ast.NEG {
            negative = true
            inner = ast.node(inner).*.lhs
            while ast.kindOf(inner) == ast.CAST && types.kind(ast.typeOf(inner)) == types.LDOUBLE { inner = ast.node(inner).*.lhs }
        }
        if ast.kindOf(inner) == ast.NUM && ast.node(inner).*.extra != 0 {
            const exact = extended.load(ast.node(inner).*.extra)
            const signed = if negative { extended.negated(exact.0, exact.1) } else { exact }
            extended.store(location, signed.0, signed.1)
            return
        }
        if ast.kindOf(inner) == ast.NUM || (ast.kindOf(inner) == ast.CAST && ast.kindOf(ast.node(inner).*.lhs) == ast.NUM && types.isInteger(ast.typeOf(ast.node(inner).*.lhs))) {
            const widened = extended.fromDouble(@bitCast(u64, eval.floatValue(e)))
            extended.store(location, widened.0, widened.1)
            return
        }
        // Any other constant expression (1.0L / 3.0L) is computed in x87
        // arithmetic when the program starts, by __mlxcc_init.
        const folded = eval.floatValue(e)
        program.addLateInitializer(variable, offset, e)
        return
    }
    if (k == types.STRUCT || k == types.UNION) && standard.cpp {
        // C++: an element made by an expression (`CachedPower { ... }`,
        // `std::array<int, 12> { ... }` in an array's braces): copied in
        // when the program starts.
        const token = ast.tokenOf(e)
        const base_ = ast.unary(ast.ADDR, ast.variableNode(variable, token), token)
        typing.addType(base_)
        const bytes = typing.cast(base_, types.pointerTo(types.charOf()))
        const offsetNode = ast.number(offset, token)
        ast.node(offsetNode).*.ty = types.longOf()
        const at_ = typing.cast(expr.newAdd(bytes, offsetNode, token), types.pointerTo(types.unqualified(ty)))
        const target = ast.unary(ast.DEREF, at_, token)
        typing.addType(target)
        const assigned = ast.binary(ast.ASSIGN, target, e, token)
        typing.addType(assigned)
        program.addGlobalInit(assigned)
        return
    }
    if k == types.STRUCT || k == types.UNION {
        // A whole struct from a constant object is not a constant
        // expression in C.
        ast.errorAt(e, "initializer element is not constant")
    }
    const found = eval.evaluateAddress(e)
    if found.1 == 0 {
        writeBytes(location, @bitCast(u64, found.0), types.size(ty))
        return
    }
    const r = base.alloc(@sizeOf(ast.Relocation))
    ast.relocation(r).*.offset = offset
    ast.relocation(r).*.target = found.1
    ast.relocation(r).*.addend = found.0
    ast.relocation(r).*.next = ast.obj(variable).*.relocations
    ast.obj(variable).*.relocations = r
    ast.obj(found.1).*.isReferenced = true
}

fn one() -> u64 { return 1 }
fn zero() -> u64 { return 0 }

fn stripWideCasts(e: usize) -> usize {
    var inner = e
    while ast.kindOf(inner) == ast.CAST && types.isWide(ast.typeOf(inner)) { inner = ast.node(inner).*.lhs }
    return inner
}

// A wide integer's (_BitInt over 64 bits) initializer: a constant's
// limbs (negated through a minus), a 64-bit constant expression
// extended, else computed when the program starts (__mlxcc_init).
fn writeWide(variable: usize, e: usize, ty: usize, location: usize, offset: i64) -> void {
    typing.addType(e)
    var inner = stripWideCasts(e)
    var negative = false
    if ast.kindOf(inner) == ast.NEG && types.isWide(ast.typeOf(inner)) {
        negative = true
        inner = stripWideCasts(ast.node(inner).*.lhs)
    }
    const it = ast.typeOf(inner)
    if ast.kindOf(inner) == ast.NUM && types.isWide(it) {
        if ast.node(inner).*.extra != 0 {
            wide.convert(location, ty, ast.node(inner).*.extra, it)
        } else {
            wide.from64(location, @bitCast(u64, ast.node(inner).*.value), !types.isUnsigned(it), ty)
        }
    } else if !types.isWide(it) && (types.isInteger(it) || types.kind(it) == types.PTR) && eval.isConstant(inner) {
        const signed = !types.isUnsigned(it) && types.kind(it) != types.BOOL && types.kind(it) != types.PTR
        wide.from64(location, @bitCast(u64, eval.evaluate(inner)), signed, ty)
    } else {
        program.addLateInitializer(variable, offset, e)
        return
    }
    if negative { wide.negate(location, ty) }
}

// The initializer of the global `variable`, after its `=`: its bytes and
// relocations.
pub fn globalInitializer(variable: usize) -> void {
    const declared = ast.obj(variable).*.ty
    const read = initializer(declared)
    // (`constexpr char t[] = {...}`: the length the initializer gives,
    // the declaration's constness kept.)
    ast.obj(variable).*.ty = if types.isConst(declared) && !types.isConst(read.1) { types.constOf(read.1) } else { read.1 }
    const size = types.size(read.1)
    const buffer = base.alloc(@intCast(usize, size) + 8)
    writeData(variable, read.0, read.1, buffer, 0)
    ast.obj(variable).*.initData = buffer
}

// Whether the scalar initializer `e` folds to a constant (an address
// plus a number for a pointer).
fn foldable(e: usize, k: u8) -> bool {
    eval.softFailures = true
    eval.failed = false
    if k == types.FLOAT || k == types.DOUBLE {
        const f = eval.floatValue(e)
    } else {
        const a = eval.evaluateAddress(e)
    }
    eval.softFailures = false
    return !eval.failed
}
