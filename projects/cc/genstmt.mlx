// Code generation for statements and function definitions: the frame
// (locals below rbp, parameters passed in memory above it), the
// parameters stored from their registers, the register save area of a
// variadic function, and struct results returned in registers or through
// the caller's buffer.
const base = @import("./base.mlx")
const tokens = @import("./tokens.mlx")
const interp = @import("./interp.mlx")
const names = @import("./names.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const x86 = @import("./x86.mlx")
const gen = @import("./gen.mlx")

var function: usize = 0
var returnLabel: u32 = 0

pub fn currentFunction() -> usize { return function }

// A value kept in memory, whose address the expression's code leaves in
// rax: a struct, a union, a wide integer.
fn isStructLike(ty: usize) -> bool {
    const k = types.kind(ty)
    return k == types.STRUCT || k == types.UNION || k == types.WIDE
}

// A struct result into rax/rdx and xmm0/xmm1 (16 bytes at most), from
// the struct whose address is in rax.
fn copyStructToRegisters(ty: usize) -> void {
    const size = types.size(ty)
    var gp: i64 = 0
    var fp: u8 = 0
    x86.move(x86.RDI, x86.RAX)
    if gen.hasFloat(ty, 0, 8, 0) {
        x86.loadFloat(0, x86.RDI, 0, size != 4)
        fp += 1
    } else {
        x86.moveImmediate(x86.RAX, 0)
        var index: i64 = if size < 8 { size - 1 } else { 7 }
        while index >= 0 {
            x86.shiftImmediate(x86.RAX, 8, true, false)
            x86.load(x86.RCX, x86.RDI, index, 1, false)
            x86.orRegisters(x86.RAX, x86.RCX)
            index -= 1
        }
        gp += 1
    }
    if size > 8 {
        if gen.hasFloat(ty, 8, 16, 0) {
            x86.loadFloat(fp, x86.RDI, 8, size != 12)
        } else {
            const r = if gp == 0 { x86.RAX } else { x86.RDX }
            x86.moveImmediate(r, 0)
            var index: i64 = if size < 16 { size - 1 } else { 15 }
            while index >= 8 {
                x86.shiftImmediate(r, 8, true, false)
                x86.load(x86.RCX, x86.RDI, index, 1, false)
                x86.orRegisters(r, x86.RCX)
                index -= 1
            }
        }
    }
}

// A struct result over 16 bytes into the caller's buffer, whose address
// came as the hidden first parameter (and goes back in rax).
fn copyStructToMemory(ty: usize) -> void {
    if ast.obj(function).*.params == 0 { tokens.errorAt(ast.obj(function).*.token, base.join("internal error: no result buffer in ", base.nameOf(ast.obj(function).*.name))) }
    const hidden = base.getWord(ast.obj(function).*.params)
    x86.load(x86.RDI, x86.RBP, ast.obj(hidden).*.offset, 8, false)
    const size = types.size(ty)
    var at: i64 = 0
    while at < size {
        x86.load(x86.RDX, x86.RAX, at, 1, false)
        x86.store(x86.RDI, at, x86.RDX, 1)
        at += 1
    }
    x86.move(x86.RAX, x86.RDI)
}

pub fn genStatement(n: usize) -> void {
    const node = ast.node(n)
    const k = node.*.kind
    if k == ast.IF {
        const otherwise = gen.newLabel()
        const done = gen.newLabel()
        gen.genExpression(node.*.cond)
        gen.compareZero(ast.typeOf(node.*.cond))
        x86.jumpIf(x86.CC_E, otherwise)
        genStatement(node.*.then)
        x86.jump(done)
        x86.defineLabel(otherwise)
        if node.*.els != 0 { genStatement(node.*.els) }
        x86.defineLabel(done)
        return
    }
    if k == ast.FOR {
        const begin = gen.newLabel()
        if node.*.init != 0 { genStatement(node.*.init) }
        x86.defineLabel(begin)
        if node.*.cond != 0 {
            gen.genExpression(node.*.cond)
            gen.compareZero(ast.typeOf(node.*.cond))
            x86.jumpIf(x86.CC_E, node.*.breakLabel)
        }
        genStatement(node.*.then)
        x86.defineLabel(node.*.continueLabel)
        if node.*.inc != 0 {
            gen.genExpression(node.*.inc)
            gen.discard(ast.typeOf(node.*.inc))
        }
        x86.jump(begin)
        x86.defineLabel(node.*.breakLabel)
        return
    }
    if k == ast.DO {
        const begin = gen.newLabel()
        x86.defineLabel(begin)
        genStatement(node.*.then)
        x86.defineLabel(node.*.continueLabel)
        gen.genExpression(node.*.cond)
        gen.compareZero(ast.typeOf(node.*.cond))
        x86.jumpIf(x86.CC_NE, begin)
        x86.defineLabel(node.*.breakLabel)
        return
    }
    if k == ast.SWITCH {
        gen.genExpression(node.*.cond)
        // A wide integer: its low 64 bits decide.
        if types.isWide(ast.typeOf(node.*.cond)) { x86.load(x86.RAX, x86.RAX, 0, 8, false) }
        var c = node.*.cases
        while c != 0 {
            const low = ast.node(c).*.value
            const high = ast.node(c).*.high
            if low == high {
                x86.moveImmediate(x86.RDI, low)
                x86.compare(x86.RAX, x86.RDI)
                x86.jumpIf(x86.CC_E, ast.node(c).*.label)
            } else {
                // low <= value <= high as one unsigned comparison.
                x86.move(x86.RDI, x86.RAX)
                x86.moveImmediate(x86.RDX, low)
                x86.sub(x86.RDI, x86.RDX)
                x86.moveImmediate(x86.RDX, high -% low)
                x86.compare(x86.RDI, x86.RDX)
                x86.jumpIf(x86.CC_BE, ast.node(c).*.label)
            }
            c = ast.node(c).*.caseNext
        }
        if node.*.defaultCase != 0 { x86.jump(ast.node(node.*.defaultCase).*.label) }
        x86.jump(node.*.breakLabel)
        genStatement(node.*.then)
        x86.defineLabel(node.*.breakLabel)
        return
    }
    if k == ast.CASE || k == ast.LABEL {
        x86.defineLabel(node.*.label)
        genStatement(node.*.lhs)
        return
    }
    if k == ast.BLOCK {
        var s = node.*.body
        while s != 0 {
            genStatement(s)
            s = ast.node(s).*.next
        }
        return
    }
    if k == ast.GOTO && node.*.lhs != 0 {
        gen.genExpression(node.*.lhs)
        x86.jumpRegister(x86.RAX)
        return
    }
    if k == ast.GOTO || k == ast.JUMP {
        x86.jump(node.*.label)
        return
    }
    if k == ast.RETURN {
        if node.*.lhs != 0 {
            gen.genExpression(node.*.lhs)
            const ty = ast.typeOf(node.*.lhs)
            if isStructLike(ty) {
                if !types.inMemory(ty) { copyStructToRegisters(ty) } else { copyStructToMemory(ty) }
            }
        }
        x86.jump(returnLabel)
        return
    }
    if k == ast.EXPR_STMT {
        gen.genExpression(node.*.lhs)
        gen.discard(ast.typeOf(node.*.lhs))
        return
    }
    ast.errorAt(n, "invalid statement")
}

// ---------------------------------------------------------------------------
// Functions

fn paramObj(cell: usize) -> usize { return base.getWord(cell) }
fn paramNext(cell: usize) -> usize { return base.getWord(cell + 8) }

// Gives the parameters passed in memory their place above rbp and every
// other local its place below; returns the bytes of named parameters in
// memory (a variadic function's first unnamed one is after them).
fn assignOffsets(fn_obj: usize) -> i64 {
    var top: i64 = 16
    var bottom: i64 = 0
    var gp: i64 = 0
    var fp: i64 = 0
    var cell = ast.obj(fn_obj).*.params
    while cell != 0 {
        const p = paramObj(cell)
        const ty = ast.obj(p).*.ty
        var inRegisters = false
        if isStructLike(ty) {
            const size = types.size(ty)
            if !types.inMemory(ty) {
                const fp1: i64 = if gen.hasFloat(ty, 0, 8, 0) { 1 } else { 0 }
                const fp2: i64 = if size > 8 && gen.hasFloat(ty, 8, 16, 0) { 1 } else { 0 }
                const gp1: i64 = 1 - fp1
                const gp2: i64 = if size > 8 { 1 - fp2 } else { 0 }
                if fp + fp1 + fp2 <= 8 && gp + gp1 + gp2 <= 6 {
                    fp += fp1 + fp2
                    gp += gp1 + gp2
                    inRegisters = true
                }
            }
        } else if gen.isLongDouble(ty) {
            // Always in memory.
        } else if gen.isFloat(ty) {
            if fp < 8 { inRegisters = true }
            fp += 1
        } else {
            if gp < 6 { inRegisters = true }
            gp += 1
        }
        if !inRegisters {
            var alignment = types.alignOf(ty)
            if alignment < 8 { alignment = 8 }
            top = types.alignTo(top, alignment)
            ast.obj(p).*.offset = top
            top += types.size(ty)
        }
        cell = paramNext(cell)
    }
    overAligned = 0
    var local = ast.obj(fn_obj).*.locals
    while local != 0 {
        if ast.obj(local).*.offset == 0 && ast.obj(local).*.alignment > 16 && ast.obj(local).*.storedAt == 0 {
            // Aligned beyond the frame's 16: room to align it in, its
            // address computed at entry into a word it is reached by.
            const alignment = ast.obj(local).*.alignment
            bottom = types.alignTo(bottom, 16) + types.size(ast.obj(local).*.ty) + alignment - 16
            bottom = types.alignTo(bottom, 16)
            const room = 0 - bottom
            bottom += 8
            const word = ast.newObj(0, types.pointerTo(types.charOf()), ast.obj(local).*.token)
            ast.obj(word).*.isLocal = true
            ast.obj(word).*.offset = 0 - bottom
            ast.obj(local).*.storedAt = word
            ast.obj(local).*.offset = room
            const cell = base.alloc(24)
            base.putWord(cell, local)
            base.putWord(cell + 8, word)
            base.putWord(cell + 16, overAligned)
            overAligned = cell
        }
        if ast.obj(local).*.offset == 0 {
            const ty = ast.obj(local).*.ty
            var alignment = ast.obj(local).*.alignment
            if alignment < 1 { alignment = 1 }
            // Arrays of 16 bytes and more are 16-byte aligned (System V).
            if types.kind(ty) == types.ARRAY && types.size(ty) >= 16 && alignment < 16 { alignment = 16 }
            bottom += types.size(ty)
            bottom = types.alignTo(bottom, alignment)
            ast.obj(local).*.offset = 0 - bottom
        }
        local = ast.obj(local).*.next
    }
    ast.obj(fn_obj).*.stackSize = types.alignTo(bottom, 16)
    return types.alignTo(top, 8) - 16
}

// Stores the low `size` bytes of register `r` at rbp + `offset`.
fn storeRegister(r: u8, offset: i64, size: i64) -> void {
    if size == 1 || size == 2 || size == 4 || size == 8 {
        x86.store(x86.RBP, offset, r, size)
        return
    }
    var index: i64 = 0
    while index < size {
        x86.store(x86.RBP, offset + index, r, 1)
        x86.shiftImmediate(r, 8, false, false)
        index += 1
    }
}

fn storeParameters(fn_obj: usize) -> void {
    var gp: i64 = 0
    var fp: u8 = 0
    var cell = ast.obj(fn_obj).*.params
    while cell != 0 {
        const p = paramObj(cell)
        const ty = ast.obj(p).*.ty
        const offset = ast.obj(p).*.offset
        if offset < 0 {
            if isStructLike(ty) {
                const size = types.size(ty)
                if gen.hasFloat(ty, 0, 8, 0) {
                    x86.storeFloat(x86.RBP, offset, fp, size >= 8)
                    fp += 1
                } else {
                    storeRegister(gen.argumentRegister(gp), offset, if size < 8 { size } else { 8 })
                    gp += 1
                }
                if size > 8 {
                    if gen.hasFloat(ty, 8, 16, 0) {
                        x86.storeFloat(x86.RBP, offset + 8, fp, size - 8 == 8)
                        fp += 1
                    } else {
                        storeRegister(gen.argumentRegister(gp), offset + 8, size - 8)
                        gp += 1
                    }
                }
            } else if gen.isFloat(ty) {
                x86.storeFloat(x86.RBP, offset, fp, gen.isDouble(ty))
                fp += 1
            } else {
                storeRegister(gen.argumentRegister(gp), offset, types.size(ty))
                gp += 1
            }
        }
        cell = paramNext(cell)
    }
}

// The va_list header and register save area of a variadic function:
// gp_offset, fp_offset, overflow_arg_area, reg_save_area, then rdi..r9
// and xmm0..xmm7 (16 bytes each), as the System V ABI lays them out.
fn saveVariadicRegisters(fn_obj: usize, namedInMemory: i64) -> void {
    var gp: i64 = 0
    var fp: i64 = 0
    var cell = ast.obj(fn_obj).*.params
    while cell != 0 {
        const ty = ast.obj(paramObj(cell)).*.ty
        if gen.isLongDouble(ty) {
            // In memory: no register.
        } else if gen.isFloat(ty) {
            fp += 1
        } else {
            gp += 1
        }
        cell = paramNext(cell)
    }
    if gp > 6 { gp = 6 }
    if fp > 8 { fp = 8 }
    const area = ast.obj(ast.obj(fn_obj).*.vaArea).*.offset
    x86.storeImmediate32(area, gp * 8)
    x86.storeImmediate32(area + 4, 48 + fp * 16)
    x86.leaFrame(x86.RAX, 16 + namedInMemory)
    x86.store(x86.RBP, area + 8, x86.RAX, 8)
    x86.leaFrame(x86.RAX, area + 24)
    x86.store(x86.RBP, area + 16, x86.RAX, 8)
    var index: i64 = 0
    while index < 6 {
        x86.store(x86.RBP, area + 24 + index * 8, gen.argumentRegister(index), 8)
        index += 1
    }
    var x: u8 = 0
    while x < 8 {
        x86.storeFloat(x86.RBP, area + 72 + @intCast(i64, x) * 16, x, true)
        x += 1
    }
}

// The locals aligned beyond 16 of the function being generated: cells
// of the local, the word holding its address, the next.
var overAligned: usize = 0

pub fn genFunction(fn_obj: usize) -> void {
    function = fn_obj
    if interp.trace { tokens.warnAt(ast.obj(fn_obj).*.token, base.join("generating ", base.nameOf(if ast.obj(fn_obj).*.linkName != 0 { ast.obj(fn_obj).*.linkName } else { ast.obj(fn_obj).*.name }))) }
    returnLabel = gen.newLabel()
    gen.resetDepth()
    const namedInMemory = assignOffsets(fn_obj)
    const symbol = ast.obj(fn_obj).*.symbol
    // (At 16: a function's address is even, which a pointer to a
    // virtual member function, odd, is told apart from.)
    while x86.position() % 16 != 0 { x86.int3() }
    x86.defineSymbol(base.nameAddress(symbol), base.nameOf(symbol).length)
    x86.prologue()
    if ast.obj(fn_obj).*.stackSize > 0 { x86.subtractStack(ast.obj(fn_obj).*.stackSize) }
    var cell = overAligned
    while cell != 0 {
        // word = (room + alignment - 1) & -alignment
        const local = base.getWord(cell)
        const alignment = ast.obj(local).*.alignment
        x86.leaFrame(x86.RAX, ast.obj(local).*.offset)
        x86.immediate(0, x86.RAX, alignment - 1)
        x86.immediate(4, x86.RAX, 0 - alignment)
        x86.store(x86.RBP, ast.obj(base.getWord(cell + 8)).*.offset, x86.RAX, 8)
        cell = base.getWord(cell + 16)
    }
    if ast.obj(fn_obj).*.vaArea != 0 { saveVariadicRegisters(fn_obj, namedInMemory) }
    storeParameters(fn_obj)
    genStatement(ast.obj(fn_obj).*.body)
    if gen.currentDepth() != 0 { ast.errorAt(ast.obj(fn_obj).*.body, "internal error: unbalanced stack") }
    // main returns 0 when it ends without a return (C11 5.1.2.2.3).
    if ast.obj(fn_obj).*.name == names.D_MAIN { x86.moveImmediate(x86.RAX, 0) }
    x86.defineLabel(returnLabel)
    x86.epilogue()
}
