// C's types (C11 6.2.5) on x86_64 Linux (LP64): their kinds, sizes and
// alignments, pointers, arrays, functions with their parameters, structs
// and unions with their members, and the conversions between arithmetic
// types (C11 6.3.1). A type lives in the arena and is known by its
// address; the basic types are made once.
const base = @import("./base.mlx")

pub const VOID: u8 = 1
pub const BOOL: u8 = 2
pub const CHAR: u8 = 3
pub const SHORT: u8 = 4
pub const INT: u8 = 5
pub const LONG: u8 = 6
pub const FLOAT: u8 = 7
pub const DOUBLE: u8 = 8
pub const LDOUBLE: u8 = 9
pub const ENUM: u8 = 10
pub const PTR: u8 = 11
pub const FUNC: u8 = 12
pub const ARRAY: u8 = 13
pub const STRUCT: u8 = 14
pub const UNION: u8 = 15
// A bit-precise integer wider than 64 bits (_BitInt(N), N above 64):
// (N + 63) / 64 limbs of 64 bits in memory, the lowest first (gen.mlx
// computes with them through the C runtime of include/__mlxcc_wide.c).
pub const WIDE: u8 = 16

// The widest _BitInt (64 limbs).
pub const MAX_BITINT: i64 = 4096

pub const Type = struct {
    kind: u8
    unsigned: bool
    // A struct, union or array whose size is not known yet; a struct
    // whose last member is an array of unknown size.
    incomplete: bool
    flexible: bool
    variadic: bool
    size: i64
    alignment: i64
    // A pointer's or array's element type; a function's return type.
    base: usize
    arrayLength: i64
    // A struct's or union's members (Member).
    members: usize
    // A function's parameters (Param); with no prototype (`int f()`)
    // `oldStyle` is set.
    params: usize
    oldStyle: bool
    // The type this one was copied from (a typedef's original keeps a
    // struct's identity when it is completed later).
    origin: usize
    // A bit-precise integer's width (_BitInt(N), C23); 0 for the others.
    bits: i64
}

pub const Member = struct {
    ty: usize
    name: u32
    token: usize
    offset: i64
    next: usize
    // A bit-field's width and first bit (width 0: not a bit-field, below
    // 0: a zero-width one).
    bitWidth: i64
    bitOffset: i64
    // Its place among the members, and its alignment (_Alignas, isPacked).
    index: i64
    alignment: i64
}

pub const Param = struct {
    ty: usize
    name: u32
    token: usize
    next: usize
}

var voidType: usize = 0
var boolType: usize = 0
var charType: usize = 0
var shortType: usize = 0
var intType: usize = 0
var longType: usize = 0
var ucharType: usize = 0
var ushortType: usize = 0
var uintType: usize = 0
var ulongType: usize = 0
var floatType: usize = 0
var doubleType: usize = 0
var ldoubleType: usize = 0

pub fn at(ty: usize) -> *Type {
    unsafe { return @ptrFromInt(*Type, ty) }
}

pub fn member(address: usize) -> *Member {
    unsafe { return @ptrFromInt(*Member, address) }
}

pub fn param(address: usize) -> *Param {
    unsafe { return @ptrFromInt(*Param, address) }
}

pub fn make(kind: u8, size: i64, alignment: i64) -> usize {
    const ty = base.alloc(@sizeOf(Type))
    at(ty).*.kind = kind
    at(ty).*.size = size
    at(ty).*.alignment = alignment
    return ty
}

fn unsignedOf(kind: u8, size: i64) -> usize {
    const ty = make(kind, size, size)
    at(ty).*.unsigned = true
    return ty
}

pub fn init() -> void {
    voidType = make(VOID, 1, 1)
    boolType = make(BOOL, 1, 1)
    charType = make(CHAR, 1, 1)
    shortType = make(SHORT, 2, 2)
    intType = make(INT, 4, 4)
    longType = make(LONG, 8, 8)
    ucharType = unsignedOf(CHAR, 1)
    ushortType = unsignedOf(SHORT, 2)
    uintType = unsignedOf(INT, 4)
    ulongType = unsignedOf(LONG, 8)
    floatType = make(FLOAT, 4, 4)
    doubleType = make(DOUBLE, 8, 8)
    // long double: the x87 extended format, 80 bits in 16.
    ldoubleType = make(LDOUBLE, 16, 16)
}

var wideSeen = false

// Whether a _BitInt wider than 64 bits was used (its runtime is compiled
// into the program then).
pub fn wideUsed() -> bool { return wideSeen }

pub fn resetWideUsed() -> void { wideSeen = false }

// _BitInt(N) (C23 6.2.5), N up to 64: the smallest standard size that
// holds it, canonical to N bits in registers; above 64 a WIDE type of
// (N + 63) / 64 limbs, aligned to 8 as the x86_64 ABI has it.
pub fn bitIntOf(width: i64, isUnsigned: bool) -> usize {
    if width > 64 {
        wideSeen = true
        const wide = make(WIDE, (width + 63) / 64 * 8, 8)
        at(wide).*.unsigned = isUnsigned
        at(wide).*.bits = width
        return wide
    }
    var byteSize: i64 = 8
    var k: u8 = LONG
    if width <= 8 {
        byteSize = 1
        k = CHAR
    } else if width <= 16 {
        byteSize = 2
        k = SHORT
    } else if width <= 32 {
        byteSize = 4
        k = INT
    }
    const ty = make(k, byteSize, byteSize)
    at(ty).*.unsigned = isUnsigned
    at(ty).*.bits = width
    return ty
}

pub fn isBitPrecise(ty: usize) -> bool { return at(ty).*.bits != 0 }

pub fn isWide(ty: usize) -> bool { return at(ty).*.kind == WIDE }

// A wide integer's limbs.
pub fn limbs(ty: usize) -> i64 { return (at(ty).*.bits + 63) / 64 }

// An integer's width in bits: N for _BitInt(N), the size's for the rest.
pub fn width(ty: usize) -> i64 {
    if at(ty).*.bits != 0 { return at(ty).*.bits }
    return at(ty).*.size * 8
}

pub fn voidOf() -> usize { return voidType }
pub fn boolOf() -> usize { return boolType }
pub fn charOf() -> usize { return charType }
pub fn shortOf() -> usize { return shortType }
pub fn intOf() -> usize { return intType }
pub fn longOf() -> usize { return longType }
pub fn ucharOf() -> usize { return ucharType }
pub fn ushortOf() -> usize { return ushortType }
pub fn uintOf() -> usize { return uintType }
pub fn ulongOf() -> usize { return ulongType }
pub fn floatOf() -> usize { return floatType }
pub fn doubleOf() -> usize { return doubleType }
pub fn ldoubleOf() -> usize { return ldoubleType }

pub fn kind(ty: usize) -> u8 { return at(ty).*.kind }
pub fn size(ty: usize) -> i64 { return at(ty).*.size }
pub fn alignOf(ty: usize) -> i64 { return at(ty).*.alignment }
pub fn baseOf(ty: usize) -> usize { return at(ty).*.base }
pub fn isUnsigned(ty: usize) -> bool { return at(ty).*.unsigned }

pub fn isInteger(ty: usize) -> bool {
    const k = kind(ty)
    return k == BOOL || k == CHAR || k == SHORT || k == INT || k == LONG || k == ENUM || k == WIDE
}

pub fn isFloat(ty: usize) -> bool {
    const k = kind(ty)
    return k == FLOAT || k == DOUBLE || k == LDOUBLE
}

pub fn isNumeric(ty: usize) -> bool { return isInteger(ty) || isFloat(ty) }

pub fn isPointerLike(ty: usize) -> bool {
    const k = kind(ty)
    return k == PTR || k == ARRAY
}

pub fn isAggregate(ty: usize) -> bool {
    const k = kind(ty)
    return k == STRUCT || k == UNION || k == ARRAY
}

pub fn isScalar(ty: usize) -> bool { return isNumeric(ty) || kind(ty) == PTR }

// A copy of `type` (a typedef with qualifiers, a parameter's adjusted
// type).
pub fn copy(ty: usize) -> usize {
    const result = base.alloc(@sizeOf(Type))
    base.copy(result, ty, @sizeOf(Type))
    at(result).*.origin = ty
    return result
}

pub fn pointerTo(target: usize) -> usize {
    const ty = make(PTR, 8, 8)
    at(ty).*.base = target
    at(ty).*.unsigned = true
    return ty
}

pub fn arrayOf(element: usize, length: i64) -> usize {
    const ty = make(ARRAY, size(element) * length, alignOf(element))
    at(ty).*.base = element
    at(ty).*.arrayLength = length
    if length < 0 {
        at(ty).*.size = 0
        at(ty).*.incomplete = true
    }
    return ty
}

pub fn functionReturning(result: usize) -> usize {
    // A function has no size; 1 keeps pointer arithmetic on function
    // pointers working as GNU C has it.
    const ty = make(FUNC, 1, 1)
    at(ty).*.base = result
    return ty
}

pub fn enumType() -> usize {
    return make(ENUM, 4, 4)
}

pub fn structType() -> usize {
    const ty = make(STRUCT, 0, 1)
    at(ty).*.incomplete = true
    return ty
}

pub fn newParam(ty: usize, name: u32, token: usize) -> usize {
    const p = base.alloc(@sizeOf(Param))
    param(p).*.ty = ty
    param(p).*.name = name
    param(p).*.token = token
    return p
}

pub fn newMember(ty: usize, name: u32, token: usize) -> usize {
    const m = base.alloc(@sizeOf(Member))
    member(m).*.ty = ty
    member(m).*.name = name
    member(m).*.token = token
    return m
}

// The member named `name` of a struct or union, searching anonymous
// members too; 0 when there is none. The offset of the found member from
// the start of `type` goes to `offset`.
pub fn findMember(ty: usize, name: u32) -> (usize, i64) {
    var m = at(ty).*.members
    while m != 0 {
        if member(m).*.name == name { return -> (m, member(m).*.offset) }
        if member(m).*.name == 0 && (kind(member(m).*.ty) == STRUCT || kind(member(m).*.ty) == UNION) {
            const inner = findMember(member(m).*.ty, name)
            if inner.0 != 0 { return -> (inner.0, member(m).*.offset + inner.1) }
        }
        m = member(m).*.next
    }
    return -> (0, 0)
}

// Whether a long double is in the type (an x87 class: such a struct is
// passed and returned in memory).
pub fn hasLongDouble(ty: usize) -> bool {
    const k = kind(ty)
    if k == LDOUBLE { return true }
    if k == ARRAY { return hasLongDouble(baseOf(ty)) }
    if k == STRUCT || k == UNION {
        var m = at(ty).*.members
        while m != 0 {
            if hasLongDouble(member(m).*.ty) { return true }
            m = member(m).*.next
        }
    }
    return false
}

// Whether a struct or union is passed and returned in memory (System V:
// over 16 bytes, or holding a long double).
pub fn inMemory(ty: usize) -> bool {
    return size(ty) > 16 || hasLongDouble(ty)
}

pub fn alignTo(value: i64, alignment: i64) -> i64 {
    if alignment <= 1 { return value }
    return (value + alignment - 1) / alignment * alignment
}

// The integer promotions (C11 6.3.1.1): types narrower than int become
// int.
pub fn promoted(ty: usize) -> usize {
    // A bit-precise integer is not promoted (C23 6.3.1.1).
    if at(ty).*.bits != 0 { return ty }
    if isInteger(ty) && size(ty) < 4 { return intType }
    if kind(ty) == ENUM {
        // An enum with a fixed underlying type (C23) keeps its width.
        if size(ty) > 4 { return if isUnsigned(ty) { ulongType } else { longType } }
        return if isUnsigned(ty) { uintType } else { intType }
    }
    return ty
}

// The usual arithmetic conversions (C11 6.3.1.8): the type both operands
// are converted to.
pub fn common(first: usize, second: usize) -> usize {
    if kind(first) == PTR || kind(first) == ARRAY { return pointerTo(baseOf(first)) }
    if kind(first) == FUNC { return pointerTo(first) }
    if kind(second) == FUNC { return pointerTo(second) }
    if kind(first) == LDOUBLE || kind(second) == LDOUBLE { return ldoubleType }
    if kind(first) == DOUBLE || kind(second) == DOUBLE { return doubleType }
    if kind(first) == FLOAT || kind(second) == FLOAT { return floatType }
    const a = promoted(first)
    const b = promoted(second)
    if at(a).*.bits != 0 || at(b).*.bits != 0 {
        // Bit-precise integers rank by width; at the same width a
        // standard type ranks higher, and unsigned wins as ever.
        if width(a) != width(b) { return if width(a) < width(b) { b } else { a } }
        if isUnsigned(a) != isUnsigned(b) { return if isUnsigned(a) { a } else { b } }
        return if at(a).*.bits == 0 { a } else { b }
    }
    if size(a) != size(b) { return if size(a) < size(b) { b } else { a } }
    if isUnsigned(b) { return b }
    return a
}

// Whether two types are compatible enough for C11's checks here (same
// kind and shape).
pub fn compatible(first: usize, second: usize) -> bool {
    if first == second { return true }
    if at(first).*.origin != 0 { return compatible(at(first).*.origin, second) }
    if at(second).*.origin != 0 { return compatible(first, at(second).*.origin) }
    if kind(first) != kind(second) { return false }
    const k = kind(first)
    if k == CHAR || k == SHORT || k == INT || k == LONG { return isUnsigned(first) == isUnsigned(second) }
    if k == WIDE { return isUnsigned(first) == isUnsigned(second) && at(first).*.bits == at(second).*.bits }
    if k == FLOAT || k == DOUBLE || k == LDOUBLE || k == VOID || k == BOOL { return true }
    if k == PTR { return compatible(baseOf(first), baseOf(second)) }
    if k == ARRAY {
        if !compatible(baseOf(first), baseOf(second)) { return false }
        return at(first).*.arrayLength < 0 || at(second).*.arrayLength < 0 || at(first).*.arrayLength == at(second).*.arrayLength
    }
    if k == FUNC { return compatible(baseOf(first), baseOf(second)) }
    return false
}

// A member's alignment: its own (_Alignas), else 1 in a isPacked struct,
// else its type's.
fn memberAlignment(m: usize, isPacked: bool) -> i64 {
    if member(m).*.alignment > 0 { return member(m).*.alignment }
    if isPacked { return 1 }
    return alignOf(member(m).*.ty)
}

// Lays a struct's members out (C's rules: each member at its alignment,
// the size a multiple of the largest); bit-fields isPacked into their
// type's units.
pub fn layoutStruct(ty: usize, isPacked: bool) -> void {
    var bits: i64 = 0
    var alignment: i64 = 1
    var m = at(ty).*.members
    while m != 0 {
        const mt = member(m).*.ty
        const width = member(m).*.bitWidth
        if width > 0 {
            // A bit-field goes into the unit of its type it starts in, or
            // the next one when it would cross into it.
            const unit = size(mt) * 8
            if bits / unit != (bits + width - 1) / unit { bits = alignTo(bits, unit) }
            member(m).*.offset = (bits / unit) * size(mt)
            member(m).*.bitOffset = bits % unit
            bits += width
        } else if width < 0 {
            // A zero-width bit-field: the next member starts a new unit.
            bits = alignTo(bits, size(mt) * 8)
        } else {
            const a = memberAlignment(m, isPacked)
            bits = alignTo(bits, a * 8)
            member(m).*.offset = bits / 8
            bits += size(mt) * 8
        }
        if memberAlignment(m, isPacked) > alignment { alignment = memberAlignment(m, isPacked) }
        m = member(m).*.next
    }
    at(ty).*.size = alignTo(bits, alignment * 8) / 8
    at(ty).*.alignment = alignment
    at(ty).*.incomplete = false
}

pub fn layoutUnion(ty: usize) -> void {
    var largest: i64 = 0
    var alignment: i64 = 1
    var m = at(ty).*.members
    while m != 0 {
        const mt = member(m).*.ty
        member(m).*.offset = 0
        if size(mt) > largest { largest = size(mt) }
        if memberAlignment(m, false) > alignment { alignment = memberAlignment(m, false) }
        m = member(m).*.next
    }
    at(ty).*.size = alignTo(largest, alignment)
    at(ty).*.alignment = alignment
    at(ty).*.incomplete = false
}
