// C's types (C11 6.2.5) on x86_64 Linux (LP64): their kinds, sizes and
// alignments, pointers, arrays, functions with their parameters, structs
// and unions with their members, and the conversions between arithmetic
// types (C11 6.3.1). A type lives in the arena and is known by its
// address; the basic types are made once.
const base = @import("./base.mlx")

pub const VOID: u8 = 1
pub const BOOL: u8 = 2
pub const CHAR: u8 = 3
pub const SHORT: u8 = 4
pub const INT: u8 = 5
pub const LONG: u8 = 6
pub const FLOAT: u8 = 7
pub const DOUBLE: u8 = 8
pub const LDOUBLE: u8 = 9
pub const ENUM: u8 = 10
pub const PTR: u8 = 11
pub const FUNC: u8 = 12
pub const ARRAY: u8 = 13
pub const STRUCT: u8 = 14
pub const UNION: u8 = 15
// A bit-precise integer wider than 64 bits (_BitInt(N), N above 64):
// (N + 63) / 64 limbs of 64 bits in memory, the lowest first (gen.mlx
// computes with them through the C runtime of include/__mlxcc_wide.c).
pub const WIDE: u8 = 16

// A C++ reference: a pointer the program reads through on every use.
pub const REF: u8 = 17
// A C++ template parameter standing in a function template's signature
// (template.mlx): `arrayLength` is its index; -1 for a dependent type a
// class template makes of one.
pub const TPARAM: u8 = 18

// The widest _BitInt (64 limbs).
pub const MAX_BITINT: i64 = 4096

pub const Type = struct {
    kind: u8
    unsigned: bool
    // `long long`: a LONG that is a type of its own for C++ (overloads,
    // mangling: x, y); the same 8 bytes.
    longLong: bool
    // An enum with a fixed underlying type (`enum class E`, `enum E : T`).
    fixedEnum: bool
    // `signed char`: a CHAR that is a type of its own for C++ (mangled a).
    signedChar: bool
    // wchar_t (1), char16_t (2), char32_t (3), char8_t (4): an int, an
    // unsigned short, an unsigned int, an unsigned char that is a type of
    // its own for C++ (mangled w, Ds, Di, Du).
    charKind: u8
    // A struct, union or array whose size is not known yet; a struct
    // whose last member is an array of unknown size.
    incomplete: bool
    flexible: bool
    variadic: bool
    size: i64
    alignment: i64
    // A pointer's or array's element type; a function's return type.
    base: usize
    arrayLength: i64
    // A struct's or union's members (Member).
    members: usize
    // A function's parameters (Param); with no prototype (`int f()`)
    // `oldStyle` is set.
    params: usize
    oldStyle: bool
    // The type this one was copied from (a typedef's original keeps a
    // struct's identity when it is completed later).
    origin: usize
    // A bit-precise integer's width (_BitInt(N), C23); 0 for the others.
    bits: i64
    // A struct's, union's or enum's name (its tag, or its typedef's
    // name when it has no tag), qualified by its namespace (C++); for
    // the mangled names.
    name: u32
    // A C++ class's description (cpp.mlx's Class; 0 for a plain struct).
    info: usize
    // A C++ member function declared const (`int get() const`): an
    // overload of its own.
    constMethod: bool
    // C++: a const-qualified type (a copy of the type with `origin` the
    // unqualified one, so the two are compatible); `const char *` and
    // `char *` are overloads of their own and `K` in mangled names.
    isConst: bool
    // A class: its const version (one copy, kept up to date when the
    // class is completed), 0 until it is asked for.
    constVersion: usize
    // A template parameter that is a pack (`typename... Args`).
    isPack: bool
    // A reference: an rvalue one (`T &&`).
    isRvalueRef: bool
    // An enum's enumerators: cells of (name, value, next), for `using enum`.
    enumerators: usize
    // A function: the names of its parameter packs expanded to nothing
    // (cells of name, next), still names in the body (`args...`).
    emptyPacks: usize
    // C++: a pointer to a member of this class (`R C::*`): a LONG of 8
    // bytes whose `base` is the member's type, a data member's offset
    // plus one (0: the null one), a member function's address.
    memberClass: usize
    // C++'s std::nullptr_t: a void pointer (as code) of a type of its
    // own (overloads, deduction, `Dn` in mangled names).
    isNullptr: bool
    // A braced list's marker (cpp.bracedArgument): its second element's
    // type, 0 when not known.
    bracedSecond: usize
}

pub const Member = struct {
    ty: usize
    name: u32
    token: usize
    offset: i64
    next: usize
    // A bit-field's width and first bit (width 0: not a bit-field, below
    // 0: a zero-width one).
    bitWidth: i64
    bitOffset: i64
    // Its place among the members, and its alignment (_Alignas, isPacked).
    index: i64
    alignment: i64
    // C++: the member's default initializer (`int x = 0;` in the class;
    // an expression, 0 for none), and whether it is a base class.
    init: usize
    isBase: bool
    // C++: declared mutable (not const in a const object).
    isMutable: bool
    // The scope the initializer is read in (its class's prefix).
    initPrefix: u32
}

pub const Param = struct {
    ty: usize
    name: u32
    token: usize
    next: usize
    // C++: the argument's default (an expression node; 0 for none); a
    // function parameter pack (`Args &&... args`), and, for a parameter
    // an expanded pack made, the pack's name (`args`).
    defaultValue: usize
    isPack: bool
    packName: u32
}

var voidType: usize = 0
var boolType: usize = 0
var charType: usize = 0
var shortType: usize = 0
var intType: usize = 0
var longType: usize = 0
var ucharType: usize = 0
var ushortType: usize = 0
var uintType: usize = 0
var ulongType: usize = 0
var longLongType: usize = 0
var scharType: usize = 0
var wcharType: usize = 0
var char16Type: usize = 0
var char32Type: usize = 0
var char8Type: usize = 0
var ulongLongType: usize = 0
var floatType: usize = 0
var doubleType: usize = 0
var ldoubleType: usize = 0

pub fn at(ty: usize) -> *Type {
    unsafe { return @ptrFromInt(*Type, ty) }
}

pub fn member(address: usize) -> *Member {
    unsafe { return @ptrFromInt(*Member, address) }
}

pub fn param(address: usize) -> *Param {
    unsafe { return @ptrFromInt(*Param, address) }
}

pub fn make(kind: u8, size: i64, alignment: i64) -> usize {
    const ty = base.alloc(@sizeOf(Type))
    base.count(base.STAT_TYPES, @sizeOf(Type))
    at(ty).*.kind = kind
    at(ty).*.size = size
    at(ty).*.alignment = alignment
    return ty
}

fn unsignedOf(kind: u8, size: i64) -> usize {
    const ty = make(kind, size, size)
    at(ty).*.unsigned = true
    return ty
}

pub fn init() -> void {
    voidType = make(VOID, 1, 1)
    boolType = make(BOOL, 1, 1)
    charType = make(CHAR, 1, 1)
    shortType = make(SHORT, 2, 2)
    intType = make(INT, 4, 4)
    longType = make(LONG, 8, 8)
    ucharType = unsignedOf(CHAR, 1)
    ushortType = unsignedOf(SHORT, 2)
    uintType = unsignedOf(INT, 4)
    ulongType = unsignedOf(LONG, 8)
    wcharType = make(INT, 4, 4)
    at(wcharType).*.charKind = 1
    char16Type = unsignedOf(SHORT, 2)
    at(char16Type).*.charKind = 2
    char32Type = unsignedOf(INT, 4)
    at(char32Type).*.charKind = 3
    char8Type = unsignedOf(CHAR, 1)
    at(char8Type).*.charKind = 4
    scharType = make(CHAR, 1, 1)
    at(scharType).*.signedChar = true
    longLongType = make(LONG, 8, 8)
    at(longLongType).*.longLong = true
    ulongLongType = unsignedOf(LONG, 8)
    at(ulongLongType).*.longLong = true
    floatType = make(FLOAT, 4, 4)
    doubleType = make(DOUBLE, 8, 8)
    // long double: the x87 extended format, 80 bits in 16.
    ldoubleType = make(LDOUBLE, 16, 16)
}

var wideSeen = false

// Whether a _BitInt wider than 64 bits was used (its runtime is compiled
// into the program then).
pub fn wideUsed() -> bool { return wideSeen }

pub fn resetWideUsed() -> void { wideSeen = false }

// _BitInt(N) (C23 6.2.5), N up to 64: the smallest standard size that
// holds it, canonical to N bits in registers; above 64 a WIDE type of
// (N + 63) / 64 limbs, aligned to 8 as the x86_64 ABI has it.
pub fn bitIntOf(width: i64, isUnsigned: bool) -> usize {
    if width > 64 {
        wideSeen = true
        const wide = make(WIDE, (width + 63) / 64 * 8, 8)
        at(wide).*.unsigned = isUnsigned
        at(wide).*.bits = width
        return wide
    }
    var byteSize: i64 = 8
    var k: u8 = LONG
    if width <= 8 {
        byteSize = 1
        k = CHAR
    } else if width <= 16 {
        byteSize = 2
        k = SHORT
    } else if width <= 32 {
        byteSize = 4
        k = INT
    }
    const ty = make(k, byteSize, byteSize)
    at(ty).*.unsigned = isUnsigned
    at(ty).*.bits = width
    return ty
}

// GCC's __int128 (unsigned __int128): the wide _BitInt(128), aligned to
// 16 as the x86_64 ABI has __int128.
pub fn int128Of(isUnsigned: bool) -> usize {
    const ty = bitIntOf(128, isUnsigned)
    at(ty).*.alignment = 16
    return ty
}

pub fn isBitPrecise(ty: usize) -> bool { return at(ty).*.bits != 0 }

pub fn isWide(ty: usize) -> bool { return at(ty).*.kind == WIDE }

// A wide integer's limbs.
pub fn limbs(ty: usize) -> i64 { return (at(ty).*.bits + 63) / 64 }

// An integer's width in bits: N for _BitInt(N), the size's for the rest.
pub fn width(ty: usize) -> i64 {
    if at(ty).*.bits != 0 { return at(ty).*.bits }
    return at(ty).*.size * 8
}

pub fn voidOf() -> usize { return voidType }
pub fn boolOf() -> usize { return boolType }
pub fn charOf() -> usize { return charType }
pub fn shortOf() -> usize { return shortType }
pub fn intOf() -> usize { return intType }
pub fn longOf() -> usize { return longType }
pub fn ucharOf() -> usize { return ucharType }
pub fn ushortOf() -> usize { return ushortType }
pub fn uintOf() -> usize { return uintType }
pub fn ulongOf() -> usize { return ulongType }
pub fn longLongOf() -> usize { return longLongType }
pub fn scharOf() -> usize { return scharType }
pub fn wcharOf() -> usize { return wcharType }
pub fn char16Of() -> usize { return char16Type }
pub fn char32Of() -> usize { return char32Type }
pub fn char8Of() -> usize { return char8Type }
pub fn ulongLongOf() -> usize { return ulongLongType }
pub fn floatOf() -> usize { return floatType }
pub fn doubleOf() -> usize { return doubleType }
pub fn ldoubleOf() -> usize { return ldoubleType }

pub fn kind(ty: usize) -> u8 { return at(ty).*.kind }
pub fn size(ty: usize) -> i64 { return at(ty).*.size }
pub fn alignOf(ty: usize) -> i64 { return at(ty).*.alignment }
pub fn baseOf(ty: usize) -> usize { return at(ty).*.base }
pub fn isUnsigned(ty: usize) -> bool { return at(ty).*.unsigned }

// Whether a bit-field of this type reads back zero-extended: unsigned
// types and bool, and (as GCC has it) an enum without a fixed signed
// underlying type whose enumerators are none of them negative.
pub fn bitFieldUnsigned(ty: usize) -> bool {
    if at(ty).*.unsigned || kind(ty) == BOOL { return true }
    if kind(ty) != ENUM || at(ty).*.fixedEnum { return false }
    var cell = at(ty).*.enumerators
    if cell == 0 { return false }
    while cell != 0 {
        if @bitCast(i64, base.get64(cell + 8)) < 0 { return false }
        cell = base.getWord(cell + 16)
    }
    return true
}

// The integer type of an enum's size and sign (`__underlying_type`);
// an integer type itself.
pub fn underlyingOf(ty: usize) -> usize {
    if kind(ty) != ENUM { return ty }
    const s = size(ty)
    if at(ty).*.unsigned {
        if s == 1 { return ucharOf() }
        if s == 2 { return ushortOf() }
        if s == 4 { return uintOf() }
        return ulongOf()
    }
    if s == 1 { return charOf() }
    if s == 2 { return shortOf() }
    if s == 4 { return intOf() }
    return longOf()
}

pub fn isInteger(ty: usize) -> bool {
    const k = kind(ty)
    return k == BOOL || k == CHAR || k == SHORT || k == INT || k == LONG || k == ENUM || k == WIDE
}

pub fn isFloat(ty: usize) -> bool {
    const k = kind(ty)
    return k == FLOAT || k == DOUBLE || k == LDOUBLE
}

pub fn isNumeric(ty: usize) -> bool { return isInteger(ty) || isFloat(ty) }

pub fn isPointerLike(ty: usize) -> bool {
    const k = kind(ty)
    return k == PTR || k == ARRAY
}

pub fn isAggregate(ty: usize) -> bool {
    const k = kind(ty)
    return k == STRUCT || k == UNION || k == ARRAY
}

pub fn isScalar(ty: usize) -> bool { return isNumeric(ty) || kind(ty) == PTR }

// A copy of `type` (a typedef with qualifiers, a parameter's adjusted
// type).
pub fn copy(ty: usize) -> usize {
    const result = base.alloc(@sizeOf(Type))
    base.count(base.STAT_TYPES, @sizeOf(Type))
    base.copy(result, ty, @sizeOf(Type))
    at(result).*.origin = ty
    return result
}

var nullptrType: usize = 0
pub fn nullptrOf() -> usize {
    if nullptrType == 0 {
        nullptrType = pointerTo(voidType)
        at(nullptrType).*.isNullptr = true
    }
    return nullptrType
}
pub fn isNullptr(ty: usize) -> bool { return ty != 0 && at(ty).*.isNullptr }

pub fn pointerTo(target: usize) -> usize {
    const ty = make(PTR, 8, 8)
    at(ty).*.base = target
    at(ty).*.unsigned = true
    return ty
}

// A C++ reference to `target` (a pointer in the object, the value on use).
pub fn referenceTo(target: usize) -> usize {
    // A reference to a reference collapses: an lvalue one to anything
    // is an lvalue one.
    if kind(target) == REF {
        if !at(target).*.isRvalueRef { return target }
        return referenceTo(baseOf(target))
    }
    const ty = make(REF, 8, 8)
    at(ty).*.base = target
    at(ty).*.unsigned = true
    return ty
}

// An rvalue reference `T &&` (to a reference: that reference).
pub fn rvalueReferenceTo(target: usize) -> usize {
    if kind(target) == REF { return target }
    const ty = referenceTo(target)
    at(ty).*.isRvalueRef = true
    return ty
}

// `R C::*`: a pointer to a member of type `target` of the class `cls`.
pub fn memberPointerTo(cls: usize, target: usize) -> usize {
    const ty = make(LONG, 8, 8)
    at(ty).*.memberClass = cls
    at(ty).*.base = target
    return ty
}

pub fn isMemberPointer(ty: usize) -> bool { return ty != 0 && at(ty).*.kind == LONG && at(ty).*.memberClass != 0 }
pub fn memberClassOf(ty: usize) -> usize { return at(ty).*.memberClass }

pub fn isRvalueReference(ty: usize) -> bool { return kind(ty) == REF && at(ty).*.isRvalueRef }

pub fn isReference(ty: usize) -> bool { return at(ty).*.kind == REF }

// The type with const (itself when it has it).
pub fn constOf(ty: usize) -> usize {
    if at(ty).*.isConst { return ty }
    const k = kind(ty)
    if k == STRUCT || k == UNION {
        // A class has one const version, brought up to date when the
        // class is completed (syncConst), as its copy would miss that.
        if at(ty).*.constVersion == 0 {
            const twin = copy(ty)
            at(twin).*.isConst = true
            at(ty).*.constVersion = twin
        }
        return at(ty).*.constVersion
    }
    // A const array is an array of const elements (`const A &` of `A =
    // S[2]` is `const S (&)[2]`, whose elements deduce `const T (&)[N]`).
    if k == ARRAY && at(ty).*.arrayLength >= 0 { return arrayOf(constOf(baseOf(ty)), at(ty).*.arrayLength) }
    const result = copy(ty)
    at(result).*.isConst = true
    return result
}

// The class `ty` was completed (or changed): its const version, if
// any, follows it.
pub fn syncConst(ty: usize) -> void {
    const twin = at(ty).*.constVersion
    if twin == 0 { return }
    base.copy(twin, ty, @sizeOf(Type))
    at(twin).*.origin = ty
    at(twin).*.isConst = true
    at(twin).*.constVersion = 0
}

pub fn isConst(ty: usize) -> bool { return at(ty).*.isConst }

// The type without its top-level const.
pub fn unqualified(ty: usize) -> usize {
    if at(ty).*.isConst && at(ty).*.origin != 0 { return at(ty).*.origin }
    return ty
}

// Whether two types are the same, const included at every level (the
// C++ signature test: `f(const char *)` and `f(char *)` differ).
pub fn sameType(first: usize, second: usize) -> bool {
    if !compatible(first, second) { return false }
    const k = kind(first)
    if k == LONG && at(first).*.longLong != at(second).*.longLong { return false }
    if k == CHAR && at(first).*.signedChar != at(second).*.signedChar { return false }
    if (k == INT || k == SHORT || k == CHAR) && at(first).*.charKind != at(second).*.charKind { return false }
    if k == REF && at(first).*.isRvalueRef != at(second).*.isRvalueRef { return false }
    if k == PTR && at(first).*.isNullptr != at(second).*.isNullptr { return false }
    if k == PTR || k == REF || k == ARRAY {
        if isConst(baseOf(first)) != isConst(baseOf(second)) { return false }
        return sameType(baseOf(first), baseOf(second))
    }
    if k == FUNC {
        // (Function types are the same by their parameters too:
        // `void (*)(void *)` and `void (*)(void *, const Stats &)` are
        // two overloads' parameters.)
        if !sameType(baseOf(first), baseOf(second)) { return false }
        if at(first).*.variadic != at(second).*.variadic { return false }
        var p = at(first).*.params
        var q = at(second).*.params
        while p != 0 && q != 0 {
            if !sameType(unqualified(param(p).*.ty), unqualified(param(q).*.ty)) { return false }
            p = param(p).*.next
            q = param(q).*.next
        }
        return p == 0 && q == 0
    }
    return true
}

// A template parameter placeholder (index `index`; -1: dependent).
pub fn templateParameter(index: i64) -> usize {
    const ty = make(TPARAM, 8, 8)
    at(ty).*.arrayLength = index
    return ty
}

// A parameter pack's placeholder (`typename... Args` at `index`).
pub fn packParameter(index: i64) -> usize {
    const ty = templateParameter(index)
    at(ty).*.isPack = true
    return ty
}

// A pack bound to its arguments (template.mlx's holder: a cell of the
// count, the argument cells and the variables), as a type: `Args` in
// an instance, expanded by `...`.
pub fn boundPack(holder: usize) -> usize {
    const ty = templateParameter(-2)
    at(ty).*.members = holder
    at(ty).*.isPack = true
    return ty
}

pub fn isBoundPack(ty: usize) -> bool { return kind(ty) == TPARAM && at(ty).*.arrayLength == -2 }

// A dependent member type in a template's pattern (`typename
// remove_reference<T>::type`, `T::iterator`): not deduced, resolved in
// an instance. `params` holds the type before the `::`, `members` the
// member's name.
pub fn dependentMember(owner: usize, name: u32) -> usize {
    const ty = templateParameter(-3)
    at(ty).*.params = owner
    at(ty).*.members = @intCast(usize, name)
    return ty
}
pub fn isDependentMember(ty: usize) -> bool { return kind(ty) == TPARAM && at(ty).*.arrayLength == -3 }

// The holder of the bound pack inside `ty` (under pointers, references,
// arrays and const), 0 for none.
pub fn boundPackIn(ty: usize) -> usize {
    var t = ty
    while true {
        const k = kind(t)
        if k == TPARAM && at(t).*.arrayLength == -2 { return at(t).*.members }
        if k == PTR || k == REF || k == ARRAY { t = baseOf(t) } else { return 0 }
    }
    return 0
}

// `ty` with the bound pack inside it replaced by `element`.
pub fn substitutePack(ty: usize, element: usize) -> usize {
    const k = kind(ty)
    var result: usize = 0
    if k == TPARAM && at(ty).*.arrayLength == -2 {
        result = element
    } else if k == PTR {
        result = pointerTo(substitutePack(baseOf(ty), element))
    } else if k == REF {
        // (`Args &&` keeps its kind; references collapse.)
        result = if at(ty).*.isRvalueRef { rvalueReferenceTo(substitutePack(baseOf(ty), element)) } else { referenceTo(substitutePack(baseOf(ty), element)) }
    } else if k == ARRAY {
        result = arrayOf(substitutePack(baseOf(ty), element), at(ty).*.arrayLength)
    } else {
        return ty
    }
    if at(ty).*.isConst { result = constOf(result) }
    return result
}

// A pack's holder: (count, the argument cells of (isType, type, value,
// next), the variable cells of (object, next)).
pub fn newPackHolder() -> usize { return base.alloc(24) }
pub fn packCount(holder: usize) -> i64 { return @bitCast(i64, base.getWord(holder)) }
pub fn packArguments(holder: usize) -> usize { return base.getWord(holder + 8) }
pub fn packVariables(holder: usize) -> usize { return base.getWord(holder + 16) }
pub fn packTypeAt(holder: usize, index: i64) -> usize {
    var c = base.getWord(holder + 8)
    var i: i64 = 0
    while c != 0 && i < index {
        c = base.getWord(c + 24)
        i += 1
    }
    if c == 0 { return 0 }
    return base.getWord(c + 8)
}
pub fn packVariableAt(holder: usize, index: i64) -> usize {
    var c = base.getWord(holder + 16)
    var i: i64 = 0
    while c != 0 && i < index {
        c = base.getWord(c + 8)
        i += 1
    }
    if c == 0 { return 0 }
    return base.getWord(c)
}
// Adds an argument cell to the holder (at the end).
pub fn addPackArgument(holder: usize, cell: usize) -> void {
    base.putWord(cell + 24, 0)
    var c = base.getWord(holder + 8)
    if c == 0 { base.putWord(holder + 8, cell) } else {
        while base.getWord(c + 24) != 0 { c = base.getWord(c + 24) }
        base.putWord(c + 24, cell)
    }
    base.putWord(holder, base.getWord(holder) + 1)
}
pub fn addPackType(holder: usize, ty: usize) -> void {
    const cell = base.alloc(32)
    base.putWord(cell, 1)
    base.putWord(cell + 8, ty)
    addPackArgument(holder, cell)
}
pub fn addPackVariable(holder: usize, obj: usize) -> void {
    const cell = base.alloc(16)
    base.putWord(cell, obj)
    var c = base.getWord(holder + 16)
    if c == 0 { base.putWord(holder + 16, cell) } else {
        while base.getWord(c + 8) != 0 { c = base.getWord(c + 8) }
        base.putWord(c + 8, cell)
    }
}

// The result type of a lambda to be taken from its first return
// (void when there is none).
var autoResultType: usize = 0

pub fn autoResult() -> usize {
    if autoResultType == 0 { autoResultType = templateParameter(-2) }
    return autoResultType
}

pub fn isAutoResult(ty: usize) -> bool { return ty != 0 && (ty == autoResultType || ty == decltypeAutoType) }

// Whether the result type `ty` is deduced from the returns: `auto`, or
// `auto` under references, pointers and const (`const auto &`).
pub fn hasAutoResult(ty: usize) -> bool {
    var t = ty
    while t != 0 {
        if isAutoResult(t) || isAutoResult(unqualified(t)) { return true }
        if kind(t) != REF && kind(t) != PTR { return false }
        t = baseOf(t)
    }
    return false
}

// The pattern `const auto *` (no reference) matched against the type
// `ty`: auto replaced by what it stands for.
pub fn matchAuto(pattern: usize, ty: usize) -> usize {
    if isAutoResult(pattern) { return ty }
    if isConst(pattern) && unqualified(pattern) != pattern { return constOf(matchAuto(unqualified(pattern), unqualified(ty))) }
    if kind(pattern) == PTR { return pointerTo(matchAuto(baseOf(pattern), if kind(ty) == PTR { baseOf(ty) } else { ty })) }
    return pattern
}

// `decltype(auto)` as a function's result: deduced as auto is, keeping
// a returned reference (stmt.mlx).
var decltypeAutoType: usize = 0
pub fn decltypeAutoResult() -> usize {
    if decltypeAutoType == 0 { decltypeAutoType = templateParameter(-2) }
    return decltypeAutoType
}
pub fn isDecltypeAuto(ty: usize) -> bool { return ty != 0 && ty == decltypeAutoType }

// The type a reference refers to; another type itself.
pub fn referenced(ty: usize) -> usize {
    if at(ty).*.kind == REF { return at(ty).*.base }
    return ty
}

pub fn arrayOf(element: usize, length: i64) -> usize {
    const ty = make(ARRAY, size(element) * length, alignOf(element))
    at(ty).*.base = element
    at(ty).*.arrayLength = length
    if length < 0 {
        at(ty).*.size = 0
        at(ty).*.incomplete = true
    }
    return ty
}

pub fn functionReturning(result: usize) -> usize {
    // A function has no size; 1 keeps pointer arithmetic on function
    // pointers working as GNU C has it.
    const ty = make(FUNC, 1, 1)
    at(ty).*.base = result
    return ty
}

pub fn enumType() -> usize {
    return make(ENUM, 4, 4)
}

pub fn structType() -> usize {
    const ty = make(STRUCT, 0, 1)
    at(ty).*.incomplete = true
    return ty
}

pub fn newParam(ty: usize, name: u32, token: usize) -> usize {
    const p = base.alloc(@sizeOf(Param))
    param(p).*.ty = ty
    param(p).*.name = name
    param(p).*.token = token
    return p
}

pub fn newMember(ty: usize, name: u32, token: usize) -> usize {
    const m = base.alloc(@sizeOf(Member))
    base.count(base.STAT_MEMBERS, @sizeOf(Member))
    member(m).*.ty = ty
    member(m).*.name = name
    member(m).*.token = token
    return m
}

// The member named `name` of a struct or union, searching anonymous
// members too; 0 when there is none. The offset of the found member from
// the start of `type` goes to `offset`.
pub fn findMember(ty: usize, name: u32) -> (usize, i64) {
    // The class's own members (an anonymous struct's or union's among
    // them) first, then its bases': a member hides a base's of its name
    // (Structure::m_blob, JSCell's in an anonymous union).
    var pass: u32 = 0
    while pass < 2 {
        var m = at(ty).*.members
        while m != 0 {
            if member(m).*.isBase == (pass == 1) {
                if member(m).*.name == name { return -> (m, member(m).*.offset) }
                if member(m).*.name == 0 && (kind(member(m).*.ty) == STRUCT || kind(member(m).*.ty) == UNION) {
                    const inner = findMember(member(m).*.ty, name)
                    if inner.0 != 0 { return -> (inner.0, member(m).*.offset + inner.1) }
                }
            }
            m = member(m).*.next
        }
        pass += 1
    }
    return -> (0, 0)
}

// Whether a long double is in the type (an x87 class: such a struct is
// passed and returned in memory).
pub fn hasLongDouble(ty: usize) -> bool {
    const k = kind(ty)
    if k == LDOUBLE { return true }
    if k == ARRAY { return hasLongDouble(baseOf(ty)) }
    if k == STRUCT || k == UNION {
        var m = at(ty).*.members
        while m != 0 {
            if hasLongDouble(member(m).*.ty) { return true }
            m = member(m).*.next
        }
    }
    return false
}

// Whether a struct or union is passed and returned in memory (System V:
// over 16 bytes, or holding a long double).
pub fn inMemory(ty: usize) -> bool {
    return size(ty) > 16 || hasLongDouble(ty)
}

pub fn alignTo(value: i64, alignment: i64) -> i64 {
    if alignment <= 1 { return value }
    return (value + alignment - 1) / alignment * alignment
}

// The integer promotions (C11 6.3.1.1): types narrower than int become
// int.
pub fn promoted(ty: usize) -> usize {
    // A bit-precise integer is not promoted (C23 6.3.1.1).
    if at(ty).*.bits != 0 { return ty }
    if isInteger(ty) && size(ty) < 4 { return intType }
    if kind(ty) == ENUM {
        // An enum with a fixed underlying type (C23) keeps its width.
        if size(ty) > 4 { return if isUnsigned(ty) { ulongType } else { longType } }
        return if isUnsigned(ty) { uintType } else { intType }
    }
    return ty
}

// The usual arithmetic conversions (C11 6.3.1.8): the type both operands
// are converted to.
pub fn common(first: usize, second: usize) -> usize {
    if kind(first) == PTR || kind(first) == ARRAY { return pointerTo(baseOf(first)) }
    if kind(first) == FUNC { return pointerTo(first) }
    if kind(second) == FUNC { return pointerTo(second) }
    if kind(first) == LDOUBLE || kind(second) == LDOUBLE { return ldoubleType }
    if kind(first) == DOUBLE || kind(second) == DOUBLE { return doubleType }
    if kind(first) == FLOAT || kind(second) == FLOAT { return floatType }
    const a = promoted(first)
    const b = promoted(second)
    if at(a).*.bits != 0 || at(b).*.bits != 0 {
        // Bit-precise integers rank by width; at the same width a
        // standard type ranks higher, and unsigned wins as ever.
        if width(a) != width(b) { return if width(a) < width(b) { b } else { a } }
        if isUnsigned(a) != isUnsigned(b) { return if isUnsigned(a) { a } else { b } }
        return if at(a).*.bits == 0 { a } else { b }
    }
    if size(a) != size(b) { return if size(a) < size(b) { b } else { a } }
    if isUnsigned(b) { return b }
    return a
}

// Whether two types are compatible enough for C11's checks here (same
// kind and shape).
pub fn compatible(first: usize, second: usize) -> bool {
    if first == second { return true }
    if at(first).*.origin != 0 { return compatible(at(first).*.origin, second) }
    if at(second).*.origin != 0 { return compatible(first, at(second).*.origin) }
    if kind(first) != kind(second) { return false }
    const k = kind(first)
    if k == LONG && (at(first).*.memberClass != 0 || at(second).*.memberClass != 0) {
        if at(first).*.memberClass == 0 || at(second).*.memberClass == 0 { return false }
        return compatible(at(first).*.memberClass, at(second).*.memberClass) && compatible(baseOf(first), baseOf(second))
    }
    if k == CHAR || k == SHORT || k == INT || k == LONG { return isUnsigned(first) == isUnsigned(second) }
    if k == WIDE { return isUnsigned(first) == isUnsigned(second) && at(first).*.bits == at(second).*.bits }
    if k == FLOAT || k == DOUBLE || k == LDOUBLE || k == VOID || k == BOOL { return true }
    if k == PTR || k == REF { return compatible(baseOf(first), baseOf(second)) }
    if k == ARRAY {
        if !compatible(baseOf(first), baseOf(second)) { return false }
        return at(first).*.arrayLength < 0 || at(second).*.arrayLength < 0 || at(first).*.arrayLength == at(second).*.arrayLength
    }
    if k == FUNC { return compatible(baseOf(first), baseOf(second)) }
    return false
}

// A member's alignment: its own (_Alignas), else 1 in a isPacked struct,
// else its type's.
fn memberAlignment(m: usize, isPacked: bool) -> i64 {
    if member(m).*.alignment > 0 { return member(m).*.alignment }
    if isPacked { return 1 }
    return alignOf(member(m).*.ty)
}

// Lays a struct's members out (C's rules: each member at its alignment,
// the size a multiple of the largest); bit-fields isPacked into their
// type's units.
// A C++ class without data: no members but empty bases, one byte.
pub fn emptyClass(ty: usize) -> bool {
    if kind(ty) != STRUCT || at(ty).*.size != 1 { return false }
    var m = at(ty).*.members
    while m != 0 {
        if !member(m).*.isBase || !emptyClass(member(m).*.ty) { return false }
        m = member(m).*.next
    }
    return true
}

pub fn layoutStruct(ty: usize, isPacked: bool) -> void {
    var bits: i64 = 0
    var alignment: i64 = 1
    var m = at(ty).*.members
    while m != 0 {
        const mt = member(m).*.ty
        const width = member(m).*.bitWidth
        if width > 0 {
            // A bit-field goes into the unit of its type it starts in, or
            // the next one when it would cross into it.
            const unit = size(mt) * 8
            if bits / unit != (bits + width - 1) / unit { bits = alignTo(bits, unit) }
            member(m).*.offset = (bits / unit) * size(mt)
            member(m).*.bitOffset = bits % unit
            bits += width
        } else if width < 0 {
            // A zero-width bit-field: the next member starts a new unit.
            bits = alignTo(bits, size(mt) * 8)
        } else if member(m).*.isBase && emptyClass(mt) {
            // An empty base takes no room (C++'s empty base
            // optimization).
            member(m).*.offset = bits / 8
        } else {
            const a = memberAlignment(m, isPacked)
            bits = alignTo(bits, a * 8)
            member(m).*.offset = bits / 8
            bits += size(mt) * 8
        }
        if memberAlignment(m, isPacked) > alignment { alignment = memberAlignment(m, isPacked) }
        m = member(m).*.next
    }
    // (A C++ class of empty bases only is still one byte.)
    if bits == 0 && at(ty).*.members != 0 { bits = 8 }
    at(ty).*.size = alignTo(bits, alignment * 8) / 8
    at(ty).*.alignment = alignment
    at(ty).*.incomplete = false
    syncConst(ty)
}

pub fn layoutUnion(ty: usize) -> void {
    var largest: i64 = 0
    var alignment: i64 = 1
    var m = at(ty).*.members
    while m != 0 {
        const mt = member(m).*.ty
        member(m).*.offset = 0
        if size(mt) > largest { largest = size(mt) }
        if memberAlignment(m, false) > alignment { alignment = memberAlignment(m, false) }
        m = member(m).*.next
    }
    at(ty).*.size = alignTo(largest, alignment)
    at(ty).*.alignment = alignment
    at(ty).*.incomplete = false
    syncConst(ty)
}
