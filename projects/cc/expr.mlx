// Expressions (C11 6.5), by precedence from the comma operator down to
// the primary expressions. Pointer arithmetic is scaled here; compound
// assignments and increments become plain assignments through a
// temporary pointer, so code generation knows only `=`.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const decl = @import("./decl.mlx")
const stmt = @import("./stmt.mlx")
const eval = @import("./eval.mlx")
const initializer = @import("./initializer.mlx")
const standard = @import("./standard.mlx")
const cpp = @import("./cpp.mlx")
const template = @import("./template.mlx")
const lambda = @import("./lambda.mlx")
const atomics = @import("./atomics.mlx")
const builtins = @import("./builtins.mlx")
const interp = @import("./interp.mlx")
const mangle = @import("./mangle.mlx")

// C++: in a template argument list a `>` (and `>>`) ends the argument
// rather than comparing (template.mlx sets it; parentheses lift it).
pub var inTemplateArguments = false

// The value of the variable `o`: a C++ reference's is the object it
// refers to.
pub fn variableValue(o: usize, token: usize) -> usize {
    const n = ast.variableNode(o, token)
    if types.isReference(ast.obj(o).*.ty) {
        ast.node(n).*.ty = ast.obj(o).*.ty
        return typing.dereferenced(n)
    }
    return n
}

// C++: the rank of converting an argument of type `from` to a parameter
// of type `to` (0: impossible; higher is better) for choosing among
// overloads.
pub fn conversionRank(from: usize, to: usize) -> i64 {
    const target = types.referenced(to)
    if standard.cpp && cpp.isBracedMarker(from) {
        // A braced list: into a class (or a scalar, of one element at
        // most), as a conversion.
        const plain = types.unqualified(target)
        const count = cpp.bracedCount(from)
        const element = cpp.bracedElement(from)
        // (A non-const `T &` binds no temporary the list makes; `const
        // T (&)[N]` is const by its elements.)
        const constTarget = types.isConst(target) || (types.kind(target) == types.ARRAY && types.isConst(types.baseOf(target)))
        if types.kind(to) == types.REF && !types.isRvalueReference(to) && !constTarget { return 0 }
        if cpp.isClassType(plain) {
            if !cpp.bracedMayConstructWith(plain, count, element, types.at(from).*.bracedSecond) { return 0 }
            return 2
        }
        var elementTarget = plain
        if types.kind(plain) == types.ARRAY {
            // `T (&&)[N]`: at most N elements, each a T.
            if types.at(plain).*.arrayLength >= 0 && count > types.at(plain).*.arrayLength { return 0 }
            elementTarget = types.baseOf(plain)
            if element == 0 { return 2 }
        } else if !types.isScalar(plain) || count > 1 {
            return 0
        }
        if element != 0 && ((count == 1 && cpp.narrows(element, elementTarget, cpp.bracedConstant(from))) || conversionRank(element, elementTarget) == 0) { return 0 }
        return 2
    }
    // nullptr to a pointer converts; nothing else to std::nullptr_t.
    if standard.cpp && types.isNullptr(target) && !types.isNullptr(types.referenced(from)) { return 0 }
    if standard.cpp && types.isNullptr(from) && !types.isNullptr(target) && types.kind(target) == types.PTR { return 2 }
    if types.compatible(from, target) {
        // The same type; through a pointer or reference, one losing const
        // does not convert, one gaining it ranks under the exact match.
        if types.isReference(to) && types.isConst(from) && !types.isConst(target) { return 0 }
        // `long` and `long long` are the same 8 bytes but types of their
        // own (C++): one converts to the other.
        if standard.cpp && types.kind(from) == types.LONG && types.kind(target) == types.LONG && types.at(from).*.longLong != types.at(target).*.longLong {
            // (A const or rvalue reference binds to a converted temporary.)
            if types.isReference(to) && !types.isConst(target) && !types.isRvalueReference(to) { return 0 }
            return 2
        }
        if standard.cpp && types.kind(from) == types.CHAR && types.kind(target) == types.CHAR && types.at(from).*.signedChar != types.at(target).*.signedChar {
            // (A const or rvalue reference binds to a converted temporary.)
            if types.isReference(to) && !types.isConst(target) && !types.isRvalueReference(to) { return 0 }
            return 2
        }
        if standard.cpp && types.isInteger(from) && types.at(from).*.charKind != types.at(target).*.charKind {
            // (A const or rvalue reference binds to a converted temporary.)
            if types.isReference(to) && !types.isConst(target) && !types.isRvalueReference(to) { return 0 }
            // char32_t to unsigned int is its promotion ([conv.prom]).
            if types.kind(target) == types.INT && types.at(target).*.charKind == 0 && types.size(from) == 4 { return 3 }
            return 2
        }
        const fk0 = types.kind(from)
        if (fk0 == types.PTR || fk0 == types.ARRAY) && types.kind(target) == types.PTR {
            // (C++: a pointer to one integer type is none to another of
            // the same size: `const uint32_t *` to `const char32_t *`.)
            if standard.cpp && !sameIntegerType(types.baseOf(from), types.baseOf(target)) { return 0 }
            if types.isConst(types.baseOf(from)) && !types.isConst(types.baseOf(target)) { return 0 }
            if !types.isConst(types.baseOf(from)) && types.isConst(types.baseOf(target)) { return 3 }
        }
        return 4
    }
    if cpp.isClassType(target) {
        // A derived class to its base; another type through a
        // converting constructor.
        if cpp.isBaseOf(target, from) { return 2 }
        if cpp.isClassType(from) && cpp.implicitConversionTo(from, target) != 0 { return 1 }
        if cpp.convertible(from, target) { return 1 }
        return 0
    }
    if cpp.isClassType(from) {
        // A class to a scalar through its conversion operator (a const
        // or rvalue reference binding the value made: a lambda to `const
        // Callback &`, std::pair's constructor of WTF's message handlers).
        if types.isReference(to) && !types.isConst(target) && !types.isRvalueReference(to) { return 0 }
        if cpp.implicitConversionTo(from, target) != 0 { return 1 }
        return 0
    }
    const fk = types.kind(from)
    const tk = types.kind(target)
    // An array (or a pointer converted: a derived class's to its
    // base's) binds to a const (or rvalue) reference to a pointer
    // through a temporary, as a pointer conversion below.
    const arrayToPointer = (fk == types.ARRAY || fk == types.FUNC || fk == types.PTR) && tk == types.PTR && (types.isConst(target) || types.isRvalueReference(to))
    if types.isReference(to) && !types.compatible(from, target) && !arrayToPointer {
        // A reference binds to the same type (a const one to a temporary
        // of a convertible one).
        if types.isNumeric(from) && types.isNumeric(target) { return 1 }
        return 0
    }
    // C++: nothing converts to an enum by itself.
    if standard.cpp && tk == types.ENUM { return 0 }
    if types.isInteger(from) && types.isInteger(target) {
        // Integral promotions ([conv.prom]): a type narrower than int to
        // int; char32_t to unsigned int, wchar_t to int (the first of
        // int, unsigned int that holds all its values).
        if tk == types.INT && types.at(target).*.charKind == 0 {
            if types.size(from) < 4 && (!standard.cpp || !types.isUnsigned(target)) { return 3 }
            if standard.cpp && types.at(from).*.charKind != 0 && types.size(from) == 4 && types.isUnsigned(from) == types.isUnsigned(target) { return 3 }
        }
        return 2
    }
    if types.isNumeric(from) && types.isNumeric(target) {
        if fk == types.FLOAT && tk == types.DOUBLE { return 3 }
        return 1
    }
    if (fk == types.PTR || fk == types.ARRAY) && tk == types.PTR {
        if types.isConst(types.baseOf(from)) && !types.isConst(types.baseOf(target)) && types.kind(types.baseOf(target)) != types.VOID { return 0 }
        if types.kind(types.baseOf(target)) == types.VOID || types.kind(types.baseOf(from)) == types.VOID { return 2 }
        if types.compatible(types.baseOf(from), types.baseOf(target)) {
            // An array to a pointer to its elements (one gaining const
            // ranks under one keeping it: `f(char *)` for a char[]).
            if !types.isConst(types.baseOf(from)) && types.isConst(types.baseOf(target)) { return 3 }
            return 4
        }
        // A pointer to a derived class to one to its base.
        if cpp.isBaseOf(types.baseOf(target), types.baseOf(from)) { return 2 }
        return 0
    }
    if fk == types.FUNC && tk == types.PTR {
        // A function to a pointer to a function of its type, or to void *.
        const pointee = types.baseOf(target)
        if types.kind(pointee) == types.FUNC && types.compatible(from, pointee) && decl.sameSignature(from, pointee) { return 4 }
        if types.kind(pointee) == types.VOID { return 2 }
        return 0
    }
    if tk == types.BOOL && (fk == types.PTR || fk == types.ARRAY) { return 1 }
    return 0
}

// Whether the integer types `a` and `b` (as compatible ones) are the
// same C++ type: not `long` and `long long`, `char` and `signed char`,
// `char32_t` and `unsigned`.
fn sameIntegerType(a: usize, b: usize) -> bool {
    if !types.isInteger(a) || !types.isInteger(b) { return true }
    if types.kind(a) != types.kind(b) { return true }
    if types.at(a).*.charKind != types.at(b).*.charKind { return false }
    if types.kind(a) == types.LONG && types.at(a).*.longLong != types.at(b).*.longLong { return false }
    if types.kind(a) == types.CHAR && types.at(a).*.signedChar != types.at(b).*.signedChar { return false }
    return true
}

// The overload of `first` (the chain of functions of one name) that
// takes the `count` arguments in `args` best; `first` when none does
// (the error comes from the parameter check).
// How well the function `candidate` takes the arguments: the sum of
// the conversion ranks, -1 when it cannot take them.
pub fn overloadScore(candidate: usize, args: usize, count: usize) -> i64 {
    const fnType = ast.obj(candidate).*.ty
    if standard.cpp && ast.obj(candidate).*.isConstructor && copiesOtherType(fnType, args, count) { return -1 }
    return scoreFrom(fnType, types.at(fnType).*.params, args, count, constructs(candidate))
}

// Whether the constructor of type `fnType` is its class's copy or move
// constructor and the one argument (after the object) is of another
// type: it would take it by a user-defined conversion to the class,
// constructing the class to construct it (not viable, C++ [over.best.ics]).
fn copiesOtherType(fnType: usize, args: usize, count: usize) -> bool {
    if count != 2 { return false }
    const first = types.at(fnType).*.params
    if first == 0 || types.param(first).*.name != names.K_THIS { return false }
    const own = types.baseOf(types.param(first).*.ty)
    const second = types.param(first).*.next
    if second == 0 || types.param(second).*.next != 0 || !types.isReference(types.param(second).*.ty) { return false }
    if !cpp.isClassType(own) || !cpp.sameClassPublic(types.unqualified(types.referenced(types.param(second).*.ty)), own) { return false }
    const argType = ast.typeOf(base.getWord(args + 8))
    if cpp.isBracedMarker(argType) { return false }
    return !(cpp.isClassType(argType) && (cpp.sameClassPublic(argType, own) || cpp.isBaseOf(own, argType)))
}

// Constructors and destructors are called on const objects too.
fn constructs(candidate: usize) -> bool {
    return ast.obj(candidate).*.isConstructor || ast.obj(candidate).*.isDestructor
}

// The same for the arguments without the object: a member function's
// `this` parameter is passed over (a template instance's, deduced from
// the arguments alone).
pub fn argumentScore(candidate: usize, args: usize, count: usize) -> i64 {
    const fnType = ast.obj(candidate).*.ty
    var p = types.at(fnType).*.params
    if p != 0 && types.param(p).*.name == names.K_THIS { p = types.param(p).*.next }
    return scoreFrom(fnType, p, args, count, true)
}

// The arguments' score for the function type `fnType` (a call through
// a pointer: a surrogate's, cpp.callOperator).
pub fn typeScore(fnType: usize, args: usize, count: usize) -> i64 {
    return scoreFrom(fnType, types.at(fnType).*.params, args, count, true)
}

// Set while the instances of function templates are weighed against
// each other (template.mlx): a parameter by value then takes an rvalue
// no better than `const T &` does, and the more specialized template
// decides (`Checked(const Checked<U, H> &)` over `Checked(U)`).
pub var betweenTemplates = false

fn scoreFrom(fnType: usize, first: usize, args: usize, count: usize, onConst: bool) -> i64 {
    // (The overloads weighed while converting the arguments are weighed
    // as any are.)
    const between = betweenTemplates
    betweenTemplates = false
    const score = scoreWith(fnType, first, args, count, onConst, !between)
    betweenTemplates = between
    return score
}

fn scoreWith(fnType: usize, first: usize, args: usize, count: usize, onConst: bool, valueBonus: bool) -> i64 {
    var score: i64 = 0
    var p = first
    var index: usize = 0
    if standard.cpp && p != 0 && count > 0 && types.param(p).*.name == names.K_THIS {
        // The object: a const one calls const member functions only
        // (and constructors and destructors); its type is the class's.
        const object = ast.typeOf(base.getWord(args))
        if types.kind(object) == types.PTR && types.isConst(types.baseOf(object)) && !types.at(fnType).*.constMethod && !onConst { return -1 }
        // (`begin()` in a const member function: `this` is const there.)
        if !types.at(fnType).*.constMethod && !onConst && cpp.isConstThis(base.getWord(args)) { return -1 }
        score += 4
        p = types.param(p).*.next
        index += 1
    }
    while index < count {
        if p == 0 {
            if !types.at(fnType).*.variadic && !types.at(fnType).*.oldStyle { return -1 }
            return score
        }
        const arg = base.getWord(args + index * 8)
        var rank = conversionRank(ast.typeOf(arg), types.param(p).*.ty)
        // (An overloaded function's name: the overload that converts.)
        if rank == 0 && standard.cpp {
            const chosen = overloadFor(arg, types.param(p).*.ty)
            if chosen != 0 { rank = conversionRank(ast.obj(chosen).*.ty, types.param(p).*.ty) }
        }
        // A null pointer constant (`0`) is a pointer of any type.
        if rank == 0 && standard.cpp && types.kind(types.param(p).*.ty) == types.PTR && isNullConstant(arg) { rank = 1 }
        if standard.cpp && types.isRvalueReference(types.param(p).*.ty) {
            // `T &&` binds rvalues only (a converted value, as an array
            // to a pointer, is a temporary), and before `const T &` does.
            const target = types.referenced(types.param(p).*.ty)
            // (One made by a conversion, a converting constructor's
            // `Ref<T>` from a `T &` included, is a temporary.)
            const argType = ast.typeOf(arg)
            const related = cpp.isClassType(argType) && cpp.isClassType(target) && (cpp.sameClassPublic(argType, target) || cpp.isBaseOf(target, argType))
            // (A derived class's pointer to its base's: a new pointer.)
            const pointerConverted = types.kind(argType) == types.PTR && types.kind(target) == types.PTR && cpp.isClassType(types.baseOf(argType)) && cpp.isClassType(types.baseOf(target)) && !cpp.sameClassPublic(types.baseOf(argType), types.baseOf(target))
            const converted = (!types.compatible(argType, target) && !related) || pointerConverted
            if !isRvalueArgument(arg) && !converted { return -1 }
            if rank > 0 { rank += 1 }
        } else if standard.cpp && rank > 0 && valueBonus && !types.isReference(types.param(p).*.ty) && !cpp.isBracedMarker(ast.typeOf(arg)) && isRvalueArgument(arg) {
            // A parameter by value takes an rvalue as well as `T &&`
            // does (then a function beats a template's instance: `F(int)`
            // over `template <class C> F(C &&)` for `F(5)`).
            rank += 1
        } else if standard.cpp && types.kind(types.param(p).*.ty) == types.REF && !types.isConst(types.referenced(types.param(p).*.ty)) {
            // A non-const `T &` binds no temporary of its class (`f(make())`
            // takes no `T &`).
            const target = types.referenced(types.param(p).*.ty)
            const argType = ast.typeOf(arg)
            if cpp.isClassType(argType) && cpp.isClassType(target) && (cpp.sameClassPublic(argType, target) || cpp.isBaseOf(target, argType)) && isRvalueArgument(arg) { return -1 }
        }
        if rank == 0 { return -1 }
        score += rank
        p = types.param(p).*.next
        index += 1
    }
    // The parameters left must have defaults.
    while p != 0 {
        if types.param(p).*.defaultValue == 0 { return -1 }
        p = types.param(p).*.next
    }
    // Of a const and a non-const member function alike otherwise, the
    // non-const one (the object's constness is not known here).
    if types.at(fnType).*.constMethod && score > 0 { score -= 1 }
    return score
}

// Of the functions an overloaded name `arg` names, the first that
// converts to the parameter type `pt` (a pointer to a function of its
// signature, or a class made from one); 0 for none.
pub fn overloadFor(arg: usize, pt: usize) -> usize {
    // (`f` or `&C::f`, a static member's.)
    var v = arg
    if ast.kindOf(v) == ast.ADDR { v = ast.node(v).*.lhs }
    if ast.kindOf(v) != ast.VAR { return 0 }
    const first = ast.node(v).*.variable
    if !ast.obj(first).*.isFunction || ast.obj(first).*.nextOverload == 0 { return 0 }
    if ast.obj(first).*.classType != 0 && !ast.obj(first).*.isStaticMember { return 0 }
    // The one of the pointer's very signature first.
    const target = if types.kind(pt) == types.PTR { types.baseOf(pt) } else { pt }
    if types.kind(target) == types.FUNC {
        var e = first
        while e != 0 {
            if ast.obj(e).*.template == 0 && decl.sameSignature(ast.obj(e).*.ty, target) { return e }
            e = ast.obj(e).*.nextOverload
        }
    }
    var f = ast.obj(first).*.nextOverload
    while f != 0 {
        if ast.obj(f).*.template == 0 && conversionRank(ast.obj(f).*.ty, pt) > 0 { return f }
        f = ast.obj(f).*.nextOverload
    }
    return 0
}

// The instance of the function template `n` names (`&C::visitOutputConstraints`
// of `template <class Visitor> static void visitOutputConstraints(JSCell *,
// Visitor &)`) that a pointer of type `pt` points to, its arguments
// deduced from the pointer's parameters; 0 for none.
pub fn templateForPointer(n: usize, pt: usize) -> usize {
    var v = n
    if ast.kindOf(v) == ast.ADDR { v = ast.node(v).*.lhs }
    if ast.kindOf(v) != ast.VAR { return 0 }
    const o = ast.node(v).*.variable
    if ast.obj(o).*.template == 0 { return 0 }
    if types.kind(pt) != types.PTR || types.kind(types.baseOf(pt)) != types.FUNC { return 0 }
    const fnType = types.baseOf(pt)
    const token = ast.tokenOf(n)
    // An argument of each parameter's type (an lvalue of the referred
    // type for a reference).
    var count: usize = 0
    var p = types.at(fnType).*.params
    while p != 0 {
        count += 1
        p = types.param(p).*.next
    }
    const given = base.alloc(count * 8 + 8)
    var index: usize = 0
    p = types.at(fnType).*.params
    while p != 0 {
        const pty = types.param(p).*.ty
        const object = types.referenced(pty)
        const pointer = typing.cast(ast.number(0, token), types.pointerTo(object))
        const arg = ast.unary(ast.DEREF, pointer, token)
        ast.node(arg).*.ty = object
        if types.isRvalueReference(pty) { ast.node(arg).*.xvalue = true }
        base.putWord(given + index * 8, arg)
        index += 1
        p = types.param(p).*.next
    }
    const instance = template.candidateInstance(ast.obj(o).*.template, given, count, ast.obj(o).*.templateArgs)
    if instance == 0 { return 0 }
    var ity = ast.obj(instance).*.ty
    if !decl.sameSignature(ity, fnType) { return 0 }
    ast.obj(instance).*.isReferenced = true
    ast.obj(instance).*.addressTaken = true
    template.useInstance(instance)
    return instance
}

// Whether `n` names a function template (`&C::f` of a member template).
pub fn namesTemplate(n: usize) -> bool {
    var v = n
    if ast.kindOf(v) == ast.ADDR { v = ast.node(v).*.lhs }
    return ast.kindOf(v) == ast.VAR && ast.obj(ast.node(v).*.variable).*.template != 0
}

// Whether `n` names an overloaded function (`f`, `&C::f`).
pub fn namesOverloads(n: usize) -> bool {
    var v = n
    if ast.kindOf(v) == ast.ADDR { v = ast.node(v).*.lhs }
    if ast.kindOf(v) != ast.VAR { return false }
    const o = ast.node(v).*.variable
    return ast.obj(o).*.isFunction && ast.obj(o).*.nextOverload != 0
}

// Whether `n` is the integer constant 0 (C++'s null pointer constant).
fn isNullConstant(n: usize) -> bool {
    const ty = ast.typeOf(n)
    if !types.isInteger(ty) || cpp.isClassType(ty) { return false }
    if !eval.isConstant(n) { return false }
    return eval.evaluate(n) == 0
}

// The function of the chain `first` that takes the arguments best, 0
// when none does.
pub fn bestOverload(first: usize, args: usize, count: usize) -> usize {
    var best: usize = 0
    var bestScore: i64 = -1
    var bestDistance: i64 = 0
    var candidate = first
    while candidate != 0 {
        const score = overloadScore(candidate, args, count)
        if score > bestScore || (score >= 0 && score == bestScore && baseDistance(candidate, args, count) < bestDistance) {
            best = candidate
            bestScore = score
            bestDistance = baseDistance(candidate, args, count)
        }
        candidate = ast.obj(candidate).*.nextOverload
    }
    return best
}

// How far the arguments' classes are from the parameters' bases they
// convert to (a derived class to a base, a pointer to a derived class to
// one to a base), summed: of candidates alike otherwise, the nearer base
// is the better conversion (C++ [over.ics.rank]; `AtomString(SymbolImpl *)`
// takes `UniquedStringImpl *` over `StringImpl *`).
pub fn baseDistance(candidate: usize, args: usize, count: usize) -> i64 {
    var p = types.at(ast.obj(candidate).*.ty).*.params
    var index: usize = 0
    var total: i64 = 0
    while index < count && p != 0 {
        var from = types.unqualified(types.referenced(ast.typeOf(base.getWord(args + index * 8))))
        var to = types.unqualified(types.referenced(types.param(p).*.ty))
        if types.kind(from) == types.PTR && types.kind(to) == types.PTR {
            from = types.unqualified(types.baseOf(from))
            to = types.unqualified(types.baseOf(to))
            // (A pointer to a class to `void *`: after one to any base.)
            if cpp.isClassType(from) && types.kind(to) == types.VOID { total += 100 }
        }
        if cpp.isClassType(from) && cpp.isClassType(to) && !cpp.sameClassPublic(from, to) && cpp.isBaseOf(to, from) {
            total += depthTo(from, to, 0)
        }
        p = types.param(p).*.next
        index += 1
    }
    return total
}

// The fewest derivation steps from the class `from` to its base `to`.
fn depthTo(from: usize, to: usize, level: i64) -> i64 {
    if cpp.sameClassPublic(from, to) { return 0 }
    if level > 32 { return 64 }
    var best: i64 = 64
    var m = types.at(from).*.members
    while m != 0 {
        if types.member(m).*.isBase {
            const d = 1 + depthTo(types.member(m).*.ty, to, level + 1)
            if d < best { best = d }
        }
        m = types.member(m).*.next
    }
    return best
}

fn chooseOverload(first: usize, args: usize, count: usize) -> usize {
    const best = bestOverload(first, args, count)
    if best == 0 { return first }
    return best
}

// Whether the pack holder holds values (a template's value pack), not
// types; an empty one is taken as values in an expression.
fn valuePack(holder: usize) -> bool {
    const first = types.packArguments(holder)
    return first == 0 || base.getWord(first) == 0
}

fn longNumber(value: i64, token: usize) -> usize {
    const n = ast.number(value, token)
    ast.node(n).*.ty = types.longOf()
    return n
}

fn ulongNumber(value: i64, token: usize) -> usize {
    const n = ast.number(value, token)
    ast.node(n).*.ty = types.ulongOf()
    return n
}

fn isPointer(n: usize) -> bool {
    return types.baseOf(ast.typeOf(n)) != 0 && types.kind(ast.typeOf(n)) != types.FUNC
}

// `lhs + rhs` with pointer arithmetic: an integer added to a pointer
// counts elements.
pub fn newAdd(lhs: usize, rhs: usize, token: usize) -> usize {
    typing.addType(lhs)
    typing.addType(rhs)
    const lp = isPointer(lhs)
    const rp = isPointer(rhs)
    if !lp && !rp { return ast.binary(ast.ADD, lhs, rhs, token) }
    if lp && rp { tokens.errorAt(token, "invalid operands") }
    var pointer = lhs
    var count = rhs
    if !lp {
        pointer = rhs
        count = lhs
    }
    if types.isWide(ast.typeOf(count)) { count = typing.cast(count, types.longOf()) }
    if standard.cpp { const ignored = cpp.completeIfNeeded(types.baseOf(ast.typeOf(pointer))) }
    const element = types.size(types.baseOf(ast.typeOf(pointer)))
    const scaled = ast.binary(ast.MUL, count, longNumber(element, token), token)
    return ast.binary(ast.ADD, pointer, scaled, token)
}

pub fn newSub(lhs: usize, rhs: usize, token: usize) -> usize {
    typing.addType(lhs)
    typing.addType(rhs)
    const lp = isPointer(lhs)
    const rp = isPointer(rhs)
    if !lp && !rp { return ast.binary(ast.SUB, lhs, rhs, token) }
    if lp && !rp {
        if standard.cpp { const ignoredSub = cpp.completeIfNeeded(types.baseOf(ast.typeOf(lhs))) }
        const element = types.size(types.baseOf(ast.typeOf(lhs)))
        const count = if types.isWide(ast.typeOf(rhs)) { typing.cast(rhs, types.longOf()) } else { rhs }
        const scaled = ast.binary(ast.MUL, count, longNumber(element, token), token)
        typing.addType(scaled)
        const n = ast.binary(ast.SUB, lhs, scaled, token)
        ast.node(n).*.ty = ast.typeOf(lhs)
        return n
    }
    if lp && rp {
        // The distance in elements.
        const difference = ast.binary(ast.SUB, lhs, rhs, token)
        ast.node(difference).*.ty = types.longOf()
        const element = types.size(types.baseOf(ast.typeOf(lhs)))
        return ast.binary(ast.DIV, difference, longNumber(if element == 0 { 1 } else { element }, token), token)
    }
    tokens.errorAt(token, "invalid operands")
    return 0
}

// A temporary local (no name) of type `ty`.
fn temporary(ty: usize, token: usize) -> usize {
    return typing.temporaryOf(ty, token)
}

// `lhs op rhs`: in C++ the operator function of a class operand, if
// there is one.
pub fn binaryNode(kind: u8, op: []const u8, lhs: usize, rhs: usize, token: usize) -> usize {
    if standard.cpp {
        const call = cpp.binaryOperator(op, lhs, rhs, token)
        if call != 0 { return call }
        if kind == ast.LT || kind == ast.LE {
            const rewritten = rewrittenRelational(op, lhs, rhs, token)
            if rewritten != 0 { return rewritten }
        }
        if (kind == ast.EQ || kind == ast.NE) && (cpp.isClassType(ast.typeOf(lhs)) || cpp.isClassType(ast.typeOf(rhs))) {
            // C++20's rewritten candidates: `b == a` for `a == b`, and
            // `!(a == b)` (or `!(b == a)`) for `a != b`.
            var equal: usize = 0
            if kind == ast.NE { equal = cpp.binaryOperator("==", lhs, rhs, token) }
            if equal == 0 { equal = cpp.binaryOperator("==", rhs, lhs, token) }
            if equal != 0 {
                if kind == ast.EQ { return equal }
                const n = ast.unary(ast.NOT, cpp.toCondition(equal), token)
                ast.node(n).*.ty = types.boolOf()
                return n
            }
        }
        if kind == ast.LOGAND || kind == ast.LOGOR { return ast.binary(kind, cpp.toCondition(lhs), cpp.toCondition(rhs), token) }
        if cpp.isClassType(ast.typeOf(lhs)) || cpp.isClassType(ast.typeOf(rhs)) {
            // The built-in operator on what the class converts to
            // implicitly (`(divot() - n) & ~0xFFFF`, JSTextPosition's
            // `operator int()`).
            const left = if cpp.isClassType(ast.typeOf(lhs)) { cpp.scalarConversion(lhs) } else { lhs }
            const right = if cpp.isClassType(ast.typeOf(rhs)) { cpp.scalarConversion(rhs) } else { rhs }
            if left != 0 && right != 0 { return ast.binary(kind, left, right, token) }
            if decl.sfinae { return softFailure(token) }
            tokens.errorAt(token, base.join(base.join("no operator", op), " for these operands"))
        }
    }
    return ast.binary(kind, lhs, rhs, token)
}

// `op operand` (or `operand op` when postfix) on a class operand.
fn unaryNode(kind: u8, op: []const u8, operand: usize, token: usize) -> usize {
    if standard.cpp {
        const call = cpp.unaryOperator(op, operand, false, token)
        if call != 0 { return call }
        if kind == ast.NOT { return ast.unary(kind, cpp.toCondition(operand), token) }
        if kind == ast.DEREF {
            // `*scope` of a class with no operator* but a conversion to a
            // pointer (GCOwnedDataScope<AtomStringImpl *>): through it.
            const converted = cpp.pointerConversion(operand)
            if converted != 0 { return ast.unary(kind, converted, token) }
        }
    }
    return ast.unary(kind, operand, token)
}

// `A op= B` as `tmp = &A, *tmp = *tmp op B` (for a member: `tmp = &S,
// tmp->m = tmp->m op B`, so a bit-field stays one).
pub fn toAssign(binary: usize) -> usize {
    const b = ast.node(binary)
    typing.addType(b.*.lhs)
    typing.addType(b.*.rhs)
    const token = b.*.token
    const lhs = b.*.lhs
    if ast.kindOf(lhs) == ast.MEMBER {
        const holder = ast.node(lhs).*.lhs
        const tmp = temporary(types.pointerTo(ast.typeOf(holder)), token)
        const first = ast.binary(ast.ASSIGN, ast.variableNode(tmp, token), ast.unary(ast.ADDR, holder, token), token)
        const target = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, ast.variableNode(tmp, token), token), token)
        ast.node(target).*.member = ast.node(lhs).*.member
        const source = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, ast.variableNode(tmp, token), token), token)
        ast.node(source).*.member = ast.node(lhs).*.member
        const second = ast.binary(ast.ASSIGN, target, ast.binary(b.*.kind, source, b.*.rhs, token), token)
        return ast.binary(ast.COMMA, first, second, token)
    }
    const tmp = temporary(types.pointerTo(ast.typeOf(lhs)), token)
    const first = ast.binary(ast.ASSIGN, ast.variableNode(tmp, token), ast.unary(ast.ADDR, lhs, token), token)
    const target = ast.unary(ast.DEREF, ast.variableNode(tmp, token), token)
    const source = ast.unary(ast.DEREF, ast.variableNode(tmp, token), token)
    const second = ast.binary(ast.ASSIGN, target, ast.binary(b.*.kind, source, b.*.rhs, token), token)
    return ast.binary(ast.COMMA, first, second, token)
}

// `A++` as `(typeof A)((A += 1) - 1)`.
fn incrementAfter(n: usize, addend: i64, token: usize) -> usize {
    typing.addType(n)
    const ty = ast.typeOf(n)
    const assigned = toAssign(newAdd(n, ast.number(addend, token), token))
    return typing.cast(newAdd(assigned, ast.number(0 - addend, token), token), ty)
}

pub fn expression() -> usize {
    const n = assign()
    if cursor.is(names.P_COMMA) {
        const token = cursor.peek()
        cursor.advance()
        return ast.binary(ast.COMMA, n, expression(), token)
    }
    return n
}

// `lhs op= rhs`: in C++ the operator function of a class operand first.
fn compound(kind: u8, op: []const u8, lhs: usize, token: usize) -> usize {
    const rhs = assign()
    if standard.cpp {
        const call = cpp.compoundAssign(op, lhs, rhs, token)
        if call != 0 { return call }
        // A class without the operator (`requires { it += n; }` of a
        // set's iterator does not hold).
        typing.addType(lhs)
        if cpp.isClassType(types.unqualified(types.referenced(ast.typeOf(lhs)))) {
            if decl.sfinae { return softFailure(token) }
            tokens.errorAt(token, base.join(base.join("no operator", op), " for these operands"))
        }
    }
    if kind == ast.ADD { return toAssign(newAdd(lhs, rhs, token)) }
    if kind == ast.SUB { return toAssign(newSub(lhs, rhs, token)) }
    return toAssign(ast.binary(kind, lhs, rhs, token))
}

// An expression read ahead (`auto x = value`'s value, read for its type):
// where it starts, the expression and where it ends; the next read from
// there takes it.
var keptStart: usize = 0
var keptExpression: usize = 0
var keptEnd: usize = 0
pub fn keepParsed(start: usize, e: usize, end: usize) -> void {
    keptStart = start
    keptExpression = e
    keptEnd = end
}

pub fn assign() -> usize {
    if keptStart != 0 && cursor.save() == keptStart {
        keptStart = 0
        cursor.restore(keptEnd)
        return keptExpression
    }
    const n = conditional()
    const token = cursor.peek()
    if cursor.consume(names.P_ASSIGN) {
        var rhs: usize = 0
        if standard.cpp && cursor.is(names.P_LBRACE) {
            // `x = {a, b}`: a temporary of x's type made by the braces.
            typing.addType(n)
            var target = types.unqualified(types.referenced(ast.typeOf(n)))
            if cpp.isClassType(target) { target = cpp.braceAssignedType(target, cursor.peek()) }
            rhs = cpp.bracedTemporary(target, token)
        } else {
            rhs = assign()
        }
        if standard.cpp {
            const call = cpp.assignOperator(n, rhs, token)
            if call != 0 { return call }
            typing.addType(rhs)
            if cpp.isClassType(ast.typeOf(rhs)) { return ast.binary(ast.ASSIGN, n, cpp.consumed(rhs), token) }
        }
        return ast.binary(ast.ASSIGN, n, rhs, token)
    }
    if cursor.consume(names.P_ADD_ASSIGN) { return compound(ast.ADD, "+=", n, token) }
    if cursor.consume(names.P_SUB_ASSIGN) { return compound(ast.SUB, "-=", n, token) }
    if cursor.consume(names.P_MUL_ASSIGN) { return compound(ast.MUL, "*=", n, token) }
    if cursor.consume(names.P_DIV_ASSIGN) { return compound(ast.DIV, "/=", n, token) }
    if cursor.consume(names.P_MOD_ASSIGN) { return compound(ast.MOD, "%=", n, token) }
    if cursor.consume(names.P_AND_ASSIGN) { return compound(ast.BITAND, "&=", n, token) }
    if cursor.consume(names.P_OR_ASSIGN) { return compound(ast.BITOR, "|=", n, token) }
    if cursor.consume(names.P_XOR_ASSIGN) { return compound(ast.BITXOR, "^=", n, token) }
    if cursor.consume(names.P_SHL_ASSIGN) { return compound(ast.SHL, "<<=", n, token) }
    if cursor.consume(names.P_SHR_ASSIGN) { return compound(ast.SHR, ">>=", n, token) }
    return n
}

pub fn conditional() -> usize {
    const condition = logicalOr()
    const token = cursor.peek()
    if !cursor.consume(names.P_QUESTION) { return condition }
    if cursor.consume(names.P_COLON) {
        // GNU `a ?: b`: `(tmp = a) ? tmp : b`.
        typing.addType(condition)
        const tmp = temporary(ast.typeOf(condition), token)
        const n = ast.make(ast.COND, token)
        ast.node(n).*.cond = ast.binary(ast.ASSIGN, ast.variableNode(tmp, token), condition, token)
        ast.node(n).*.then = ast.variableNode(tmp, token)
        ast.node(n).*.els = conditional()
        return n
    }
    const n = ast.make(ast.COND, token)
    ast.node(n).*.cond = if standard.cpp { cpp.toCondition(condition) } else { condition }
    var outer = state.takeTemporaries()
    const thenValue = expression()
    const thenMoves = cpp.movableTemporary(thenValue)
    var thenHeld: usize = 0
    if thenMoves {
        const moved = cpp.movedBranch(thenValue, outer)
        ast.node(n).*.then = moved.0
        thenHeld = moved.1
    } else {
        ast.node(n).*.then = branch(thenValue, outer)
    }
    cursor.expect(names.P_COLON)
    outer = state.takeTemporaries()
    var elsValue = conditional()
    if standard.cpp {
        // A class on one side, another type on the other: that one
        // converted to the class (`c ? slot.getValue() :
        // slot.getterSetter()`, a JSValue made from the pointer).
        typing.addType(thenValue)
        typing.addType(elsValue)
        const tt = types.unqualified(types.referenced(ast.typeOf(thenValue)))
        const et = types.unqualified(types.referenced(ast.typeOf(elsValue)))
        if cpp.isClassType(tt) && !cpp.isClassType(et) && types.kind(et) != types.VOID {
            elsValue = cpp.temporaryObject(tt, cpp.argumentList(elsValue, 0), 1, token)
        }
        if !thenMoves && cpp.isClassType(et) && !cpp.isClassType(tt) && types.kind(tt) != types.VOID && cpp.hasDestructor(et) {
            return cpp.convertedConditional(n, elsValue, outer, et, token)
        }
        // Two classes, one made from the other (`u ? std::nullopt :
        // std::optional<int>(4)`): that one, the result made from either.
        if cpp.isClassType(tt) && cpp.isClassType(et) && !cpp.sameClassPublic(tt, et) && !cpp.isBaseOf(tt, et) && !cpp.isBaseOf(et, tt) {
            if cpp.convertible(tt, et) && !cpp.convertible(et, tt) { return cpp.convertedConditional(n, elsValue, outer, et, token) }
            if cpp.convertible(et, tt) && !cpp.convertible(tt, et) { elsValue = cpp.temporaryObject(tt, cpp.argumentList(elsValue, 0), 1, token) }
        }
    }
    if standard.cpp && !thenMoves && cpp.movableTemporary(elsValue) && cpp.isClassType(ast.typeOf(thenValue)) && typing.isLvalue(thenValue) && cpp.sameClassPublic(ast.typeOf(thenValue), ast.typeOf(elsValue)) {
        // `c ? std::move(a) : T()` (or `c ? a : T()`): a prvalue, made
        // from the object by its move (or copy) constructor, moved from
        // the other branch's temporary.
        return cpp.convertedConditional(n, elsValue, outer, types.unqualified(ast.typeOf(thenValue)), token)
    }
    if standard.cpp && thenMoves && !cpp.movableTemporary(elsValue) && typing.isLvalue(elsValue) && cpp.sameClassPublic(ast.typeOf(thenValue), ast.typeOf(elsValue)) {
        // (The other way round: `c ? T() : std::move(a)`.)
        return cpp.movedThenConditional(n, elsValue, outer, types.unqualified(ast.typeOf(thenValue)), token)
    }
    if thenMoves && cpp.movableTemporary(elsValue) && cpp.sameClassPublic(ast.typeOf(thenValue), ast.typeOf(elsValue)) {
        // `c ? RefPtr<L>(x) : RefPtr<L>()`: one result the expression
        // destroys, whichever branch made it.
        const moved = cpp.movedBranch(elsValue, outer)
        ast.node(n).*.els = moved.0
        return cpp.movedConditional(n, types.unqualified(ast.typeOf(thenValue)), token)
    }
    ast.node(n).*.els = branch(elsValue, outer)
    if thenMoves { cpp.undoMovedBranch(thenHeld) }
    if standard.cpp {
        // (The other way round: the then side converted to the class.)
        typing.addType(ast.node(n).*.then)
        typing.addType(ast.node(n).*.els)
        const tt = types.unqualified(types.referenced(ast.typeOf(ast.node(n).*.then)))
        const et = types.unqualified(types.referenced(ast.typeOf(ast.node(n).*.els)))
        // (Made after the branch was read: only of a class without a
        // destructor, whose temporary needs no end.)
        if cpp.isClassType(et) && !cpp.isClassType(tt) && types.kind(tt) != types.VOID && !cpp.hasDestructor(et) {
            ast.node(n).*.then = cpp.temporaryObject(et, cpp.argumentList(ast.node(n).*.then, 0), 1, token)
        }
    }
    if standard.cpp {
        // Lvalues of one class on both sides: an lvalue, `*(c ? &x : &y)`
        // (a `T &` binds to it: `Ref { c ? *a : *b }`).
        const then = ast.node(n).*.then
        const els = ast.node(n).*.els
        typing.addType(then)
        typing.addType(els)
        const tt = ast.typeOf(then)
        const et = ast.typeOf(els)
        // (Temporaries on both sides, `c ? RefPtr<L>(x) : RefPtr<L>()`:
        // a prvalue.)
        const temporaries = isRvalueArgument(then) && isRvalueArgument(els)
        if cpp.isClassType(tt) && typing.isLvalue(then) && typing.isLvalue(els) && !temporaries && cpp.sameClassPublic(tt, et) && types.isConst(tt) == types.isConst(et) {
            ast.node(n).*.then = ast.unary(ast.ADDR, then, token)
            ast.node(n).*.els = ast.unary(ast.ADDR, els, token)
            typing.addType(n)
            const object = ast.unary(ast.DEREF, n, token)
            typing.addType(object)
            return object
        }
    }
    return n
}

// An operand that may not be evaluated (the right one of && and ||, a
// branch of ?:): in C++ the temporaries it makes are destroyed within
// it, since the end of the expression may never see them made.
fn branch(n: usize, outer: usize) -> usize {
    if !standard.cpp { return n }
    const kept = cpp.flushTemporaries(n, true, ast.tokenOf(n))
    state.setTemporaries(outer)
    // A class value the branch yields is destroyed by the expression.
    const held = cpp.takeKeptTemporary()
    if held != 0 { state.addTemporary(held) }
    return kept
}

fn logicalOr() -> usize {
    var n = logicalAnd()
    while cursor.is(names.P_OROR) {
        const token = cursor.peek()
        cursor.advance()
        const outer = state.takeTemporaries()
        const rhs = branch(logicalAnd(), outer)
        n = binaryNode(ast.LOGOR, "||", n, rhs, token)
    }
    return n
}

fn logicalAnd() -> usize {
    var n = bitOr()
    while cursor.is(names.P_ANDAND) {
        const token = cursor.peek()
        cursor.advance()
        const outer = state.takeTemporaries()
        const rhs = branch(bitOr(), outer)
        n = binaryNode(ast.LOGAND, "&&", n, rhs, token)
    }
    return n
}

fn bitOr() -> usize {
    var n = bitXor()
    while cursor.is(names.P_PIPE) {
        const token = cursor.peek()
        cursor.advance()
        n = binaryNode(ast.BITOR, "|", n, bitXor(), token)
    }
    return n
}

fn bitXor() -> usize {
    var n = bitAnd()
    while cursor.is(names.P_CARET) {
        const token = cursor.peek()
        cursor.advance()
        n = binaryNode(ast.BITXOR, "^", n, bitAnd(), token)
    }
    return n
}

fn bitAnd() -> usize {
    var n = equality()
    while cursor.is(names.P_AMP) {
        const token = cursor.peek()
        cursor.advance()
        n = binaryNode(ast.BITAND, "&", n, equality(), token)
    }
    return n
}

fn equality() -> usize {
    var n = relational()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_EQ) {
            n = binaryNode(ast.EQ, "==", n, relational(), token)
        } else if cursor.consume(names.P_NE) {
            n = binaryNode(ast.NE, "!=", n, relational(), token)
        } else {
            return n
        }
    }
    return n
}

fn relational() -> usize {
    var n = threeWay()
    while true {
        const token = cursor.peek()
        // (In template arguments `>` closes the list; `>=` compares:
        // `bool B = sizeof(T) >= sizeof(S)`.)
        if inTemplateArguments && cursor.is(names.P_GT) { return n }
        if cursor.consume(names.P_LT) {
            n = binaryNode(ast.LT, "<", n, threeWay(), token)
        } else if cursor.consume(names.P_LE) {
            n = binaryNode(ast.LE, "<=", n, threeWay(), token)
        } else if cursor.consume(names.P_GT) {
            n = swapped(ast.LT, ">", n, threeWay(), token)
        } else if cursor.consume(names.P_GE) {
            n = swapped(ast.LE, ">=", n, threeWay(), token)
        } else {
            return n
        }
    }
    return n
}

// `a <=> b` (C++20), between the shifts and the relational operators.
fn threeWay() -> usize {
    var n = shift()
    while standard.cpp && cursor.is(names.P_SPACESHIP) {
        const token = cursor.peek()
        cursor.advance()
        n = spaceship(n, shift(), token)
    }
    return n
}

// `lhs <=> rhs`: the operator function of a class; between numbers or
// pointers a std::strong_ordering (std::partial_ordering for floating
// point) from <compare>'s std::__mlxcc_compare3 (and ...3p).
fn spaceship(lhs: usize, rhs: usize, token: usize) -> usize {
    typing.addType(lhs)
    typing.addType(rhs)
    const call = cpp.binaryOperator("<=>", lhs, rhs, token)
    if call != 0 { return call }
    if cpp.isClassType(ast.typeOf(lhs)) || cpp.isClassType(ast.typeOf(rhs)) {
        if decl.sfinae { return softFailure(token) }
        tokens.errorAt(token, "no operator<=> for these operands")
    }
    var lt = ast.typeOf(lhs)
    var rt = ast.typeOf(rhs)
    var a = lhs
    var b = rhs
    if types.isNumeric(lt) && types.isNumeric(rt) {
        const common = types.common(types.promoted(lt), types.promoted(rt))
        a = typing.cast(lhs, common)
        b = typing.cast(rhs, common)
        lt = common
    }
    const floating = types.isFloat(lt)
    const std = scope.findKind(base.intern("std"), scope.NAMESPACE)
    var binding: usize = 0
    if std != 0 { binding = scope.findQualified(@intCast(u32, scope.at(std).*.value), base.intern(if floating { "__mlxcc_compare3p" } else { "__mlxcc_compare3" }), false) }
    if binding == 0 { tokens.errorAt(token, "<=> needs <compare>") }
    const given = base.alloc(16)
    base.putWord(given, a)
    base.putWord(given + 8, b)
    return buildCall(cpp.callableFor(binding, token), given, 2, token)
}

// `a < b` of a class with operator<=> only (C++20's rewritten
// candidates): `(a <=> b) < 0`, or `0 < (b <=> a)` reversed; 0 when it
// has none.
fn rewrittenRelational(op: []const u8, lhs: usize, rhs: usize, token: usize) -> usize {
    if !cpp.isClassType(ast.typeOf(lhs)) && !cpp.isClassType(ast.typeOf(rhs)) { return 0 }
    const order = cpp.binaryOperator("<=>", lhs, rhs, token)
    if order == 0 { return 0 }
    const zero = ast.number(0, token)
    typing.addType(zero)
    return cpp.binaryOperator(op, order, zero, token)
}

// `lhs > rhs` as `rhs < lhs` (an operator function keeps its order).
fn swapped(kind: u8, op: []const u8, lhs: usize, rhs: usize, token: usize) -> usize {
    if standard.cpp {
        const call = cpp.binaryOperator(op, lhs, rhs, token)
        if call != 0 { return call }
        const rewritten = rewrittenRelational(op, lhs, rhs, token)
        if rewritten != 0 { return rewritten }
    }
    return ast.binary(kind, rhs, lhs, token)
}

fn shift() -> usize {
    var n = additive()
    while true {
        const token = cursor.peek()
        if inTemplateArguments && cursor.is(names.P_SHR) { return n }
        if cursor.consume(names.P_SHL) {
            n = binaryNode(ast.SHL, "<<", n, additive(), token)
        } else if cursor.consume(names.P_SHR) {
            n = binaryNode(ast.SHR, ">>", n, additive(), token)
        } else {
            return n
        }
    }
    return n
}

fn additive() -> usize {
    var n = multiplicative()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_PLUS) {
            n = added(true, n, multiplicative(), token)
        } else if cursor.consume(names.P_MINUS) {
            n = added(false, n, multiplicative(), token)
        } else {
            return n
        }
    }
    return n
}

// A class operand of + or - by its conversion to a scalar or a
// pointer; 0 for none.
fn classOperand(value: usize) -> usize {
    const scalar = cpp.scalarConversion(value)
    if scalar != 0 { return scalar }
    return cpp.pointerConversion(value)
}

fn added(isAdd: bool, lhs: usize, rhs: usize, token: usize) -> usize {
    if standard.cpp {
        const call = cpp.binaryOperator(if isAdd { "+" } else { "-" }, lhs, rhs, token)
        if call != 0 { return call }
        // The built-in operator on what a class converts to implicitly
        // (`offset - divot()`, JSTextPosition's `operator int()`).
        if cpp.isClassType(ast.typeOf(lhs)) || cpp.isClassType(ast.typeOf(rhs)) {
            const left = if cpp.isClassType(ast.typeOf(lhs)) { classOperand(lhs) } else { lhs }
            const right = if cpp.isClassType(ast.typeOf(rhs)) { classOperand(rhs) } else { rhs }
            if left == 0 || right == 0 {
                if decl.sfinae { return softFailure(token) }
                tokens.errorAt(token, if isAdd { "no operator+ for these operands" } else { "no operator- for these operands" })
            }
            if isAdd { return newAdd(left, right, token) }
            return newSub(left, right, token)
        }
    }
    if isAdd { return newAdd(lhs, rhs, token) }
    return newSub(lhs, rhs, token)
}

// C++'s `.*` and `->*` (pointers to members), over cast expressions.
fn pmExpression() -> usize {
    var n = castExpression()
    while standard.cpp && (cursor.is(names.P_DOT_STAR) || cursor.is(names.P_ARROW_STAR)) {
        const token = cursor.peek()
        const arrow = cursor.is(names.P_ARROW_STAR)
        cursor.advance()
        n = cpp.memberThrough(n, arrow, castExpression(), token)
    }
    return n
}

fn multiplicative() -> usize {
    var n = pmExpression()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_STAR) {
            n = binaryNode(ast.MUL, "*", n, pmExpression(), token)
        } else if cursor.consume(names.P_SLASH) {
            n = binaryNode(ast.DIV, "/", n, pmExpression(), token)
        } else if cursor.consume(names.P_PERCENT) {
            n = binaryNode(ast.MOD, "%", n, pmExpression(), token)
        } else {
            return n
        }
    }
    return n
}

// `(bool(*this))`: the type name followed by `(` and what is no
// declarator (`(*)`, `(&)`, `()`): a functional cast in parentheses.
fn functionalCastInParentheses() -> bool {
    const t = cursor.peekNext()
    // (`(__typeof__(*p))`: what follows these is an operand.)
    if tokens.isWord(t, names.K_GNU2_TYPEOF) || tokens.isWord(t, names.K_TYPEOF) || tokens.isWord(t, names.K_TYPEOF_UNQUAL) || tokens.isWord(t, names.K_DECLTYPE) || tokens.isWord(t, names.K_BITINT) || tokens.isWord(t, names.K_ATOMIC) || tokens.isWord(t, names.K_UNDERLYING_TYPE) { return false }
    const open = tokens.next(t)
    if !tokens.is(open, names.P_LPAREN) { return false }
    const first = tokens.next(open)
    if tokens.is(first, names.P_RPAREN) { return false }
    if tokens.is(first, names.P_STAR) || tokens.is(first, names.P_AMP) || tokens.is(first, names.P_ANDAND) || tokens.is(first, names.P_CARET) {
        const second = tokens.next(first)
        // `(*)`, `(*)[N]`, `(&)`: an abstract declarator (it names nothing).
        if tokens.is(second, names.P_RPAREN) || tokens.is(second, names.P_LBRACKET) { return false }
        if tokens.isWord(second, names.K_CONST) || tokens.isWord(second, names.K_VOLATILE) { return false }
        return true
    }
    return false
}

pub fn castExpression() -> usize {
    if standard.cpp && cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) && functionalCastInParentheses() { return unary() }
    if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) {
        const start = cursor.save()
        cursor.advance()
        const ty = decl.typeName()
        if standard.cpp && (!cursor.is(names.P_RPAREN) || types.kind(ty) == types.FUNC) {
            // `(T(x))`, `(T{x})`, `(T())`: a parenthesized functional
            // cast (a cast to a function type is none).
            cursor.restore(start)
            return unary()
        }
        cursor.expect(names.P_RPAREN)
        if cursor.is(names.P_LBRACE) {
            // A compound literal.
            cursor.restore(start)
            return unary()
        }
        const n = castTo(castExpression(), ty)
        ast.node(n).*.token = start
        return n
    }
    return unary()
}

// A cast to `ty`; to a reference type (`(T &)x`, `const_cast<T &>(x)`)
// the object it then refers to.
fn castTo(operand: usize, ty: usize) -> usize {
    const n = typing.cast(operand, ty)
    if types.isReference(ty) {
        const object = typing.dereferenced(n)
        if types.isRvalueReference(ty) { ast.node(object).*.xvalue = true }
        return object
    }
    return n
}

// Whether the argument `n` is an rvalue to overload resolution: a
// temporary, a call's result, a value, or an object named through an
// rvalue reference.
pub fn isRvalueArgument(n: usize) -> bool {
    if ast.node(n).*.xvalue { return true }
    var holder = n
    if ast.kindOf(holder) == ast.COMMA { holder = ast.node(holder).*.rhs }
    if ast.kindOf(holder) == ast.VAR && state.isPendingTemporary(ast.node(holder).*.variable) { return true }
    // `T{...}`, `T(args)` of a class without a destructor: the
    // temporary made.
    if ast.kindOf(holder) == ast.VAR && ast.obj(ast.node(holder).*.variable).*.isMadeTemporary { return true }
    if ast.kindOf(holder) == ast.FUNCALL { return true }
    return !typing.isLvalue(n)
}

// The global holding the value of the constant `binding` (a constexpr
// integer variable, kept as its value), made once.
var constantObjects: usize = 0
fn constantObject(binding: usize, token: usize) -> usize {
    var c = constantObjects
    while c != 0 {
        if base.getWord(c) == binding { return base.getWord(c + 8) }
        c = base.getWord(c + 16)
    }
    const ty = types.constOf(scope.at(binding).*.ty)
    const o = decl.newAnonymousGlobal(ty, token)
    const size = types.size(ty)
    const data = base.alloc(@intCast(usize, if size > 0 { size } else { 1 }))
    var i: i64 = 0
    const value = @bitCast(u64, scope.at(binding).*.value)
    while i < size {
        base.put8(data + @intCast(usize, i), @intCast(u8, (value >> @intCast(u6, i * 8)) & 255))
        i += 1
    }
    ast.obj(o).*.initData = data
    const cell = base.alloc(24)
    base.putWord(cell, binding)
    base.putWord(cell + 8, o)
    base.putWord(cell + 16, constantObjects)
    constantObjects = cell
    return o
}

// Expressions being read for their type only (decltype, sizeof,
// noexcept): nothing in them is called.
pub var unevaluated: u32 = 0

fn unary() -> usize {
    const token = cursor.peek()
    if standard.cpp {
        if cursor.consume(names.K_NEW) { return cpp.newExpression(token) }
        if cursor.consume(names.K_DELETE) { return cpp.deleteExpression(token) }
        if cursor.is(names.P_SCOPE) && (cursor.isToken(cursor.peekNext(), names.K_NEW) || cursor.isToken(cursor.peekNext(), names.K_DELETE)) {
            cursor.advance()
            return unary()
        }
        if cursor.consume(names.K_THROW) { tokens.errorAt(token, "exceptions are not supported") }
    }
    if cursor.consume(names.P_PLUS) { return castExpression() }
    if cursor.consume(names.P_MINUS) { return unaryNode(ast.NEG, "-", castExpression(), token) }
    if cursor.is(names.P_ANDAND) && tokens.kind(cursor.peekNext()) == tokens.IDENT {
        // GNU C's `&&label`: the label's address, a `void *` (`goto *p`
        // jumps to it).
        cursor.advance()
        const n = ast.make(ast.LABEL_ADDR, token)
        ast.node(n).*.name = tokens.name(cursor.expectIdent())
        ast.node(n).*.ty = types.pointerTo(types.voidOf())
        state.addGoto(n)
        return n
    }
    if cursor.consume(names.P_AMP) {
        if standard.cpp {
            // `&C::member`: a pointer to the member.
            const pm = cpp.memberPointerConstant()
            if pm != 0 { return pm }
        }
        const operandToken = cursor.peek()
        const operand = castExpression()
        typing.addType(operand)
        if ast.kindOf(operand) == ast.MEMBER && types.member(ast.node(operand).*.member).*.bitWidth != 0 {
            tokens.errorAt(token, "cannot take the address of a bit-field")
        }
        // `&empty` of `static constexpr char8_t empty = 0;` (kept as its
        // value): a constant object holding it.
        if standard.cpp && ast.kindOf(operand) == ast.NUM && tokens.kind(operandToken) == tokens.IDENT {
            const binding = scope.find(tokens.name(operandToken))
            if binding != 0 && scope.at(binding).*.kind == scope.ENUM_CONSTANT && types.kind(scope.at(binding).*.ty) != types.ENUM {
                return ast.unary(ast.ADDR, ast.variableNode(constantObject(binding, token), token), token)
            }
        }
        if ast.kindOf(operand) == ast.VAR && ast.obj(ast.node(operand).*.variable).*.isFunction && ast.obj(ast.node(operand).*.variable).*.nextOverload == 0 && unevaluated == 0 { ast.obj(ast.node(operand).*.variable).*.addressTaken = true }
        return ast.unary(ast.ADDR, operand, token)
    }
    if cursor.consume(names.P_STAR) {
        // `*f` of a function is the function (C11 6.5.3.2).
        const operand = castExpression()
        typing.addType(operand)
        if types.kind(ast.typeOf(operand)) == types.FUNC { return operand }
        if standard.cpp && decl.sfinae {
            // `*x` of what is no pointer (a pattern's dependent value, a
            // candidate's argument): not viable, no error.
            const ot = ast.typeOf(operand)
            const ok = types.kind(ot) == types.PTR || types.kind(ot) == types.ARRAY || cpp.isClassType(ot) || (types.isReference(ot) && cpp.isClassType(types.referenced(ot)))
            if !ok { return softFailure(token) }
        }
        return unaryNode(ast.DEREF, "*", operand, token)
    }
    if cursor.consume(names.P_BANG) { return unaryNode(ast.NOT, "!", castExpression(), token) }
    if cursor.consume(names.P_TILDE) { return unaryNode(ast.BITNOT, "~", castExpression(), token) }
    if cursor.consume(names.P_INC) {
        const operand = unary()
        if standard.cpp {
            const call = cpp.unaryOperator("++", operand, false, token)
            if call != 0 { return call }
        }
        return toAssign(newAdd(operand, ast.number(1, token), token))
    }
    if cursor.consume(names.P_DEC) {
        const operand = unary()
        if standard.cpp {
            const call = cpp.unaryOperator("--", operand, false, token)
            if call != 0 { return call }
        }
        return toAssign(newSub(operand, ast.number(1, token), token))
    }
    if cursor.consume(names.K_GNU2_EXTENSION) { return castExpression() }
    return postfix()
}

// The member `name` of a struct or union type, searching anonymous
// members: the member found at this level (an anonymous one holds it).
// (The class's own members, an anonymous union's among them, before
// its bases': a member hides a base's of the name, as Structure's
// `m_blob` does JSCell's.)
pub fn findMember(ty: usize, name: u32) -> usize {
    var m = types.at(ty).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        if types.member(m).*.isBase {
            // (Below.)
        } else if types.member(m).*.name == 0 && (types.kind(mt) == types.STRUCT || types.kind(mt) == types.UNION) {
            if findMember(mt, name) != 0 { return m }
        } else if types.member(m).*.name == name {
            return m
        }
        m = types.member(m).*.next
    }
    m = types.at(ty).*.members
    while m != 0 {
        if types.member(m).*.isBase && findMember(types.member(m).*.ty, name) != 0 { return m }
        m = types.member(m).*.next
    }
    return 0
}

// Whether `binding` (a namespace scope's) is bound under a prefix inside
// the current member function's class (a member template's own
// parameter, `template <size_t length> C(const char (&)[length])`
// beside a member `length()`): it comes before the class's members.
fn boundInsideClass(binding: usize) -> bool {
    if binding == 0 { return false }
    const classTy = state.currentClass()
    if classTy == 0 { return false }
    const classPrefix = types.at(classTy).*.name
    const own = scope.parentOf(scope.at(binding).*.name)
    if own == 0 || own == classPrefix { return false }
    var p = scope.parentOf(own)
    var steps: u32 = 0
    while p != 0 && steps < 64 {
        if p == classPrefix { return true }
        p = scope.parentOf(p)
        steps += 1
    }
    return false
}

// SFINAE: an expression that cannot be read (in a requires
// expression, a constraint, an instance's signature) marks the
// candidate as not viable and stands as 0.
fn softFailure(token: usize) -> usize {
    decl.sfinaeFailed = true
    return ast.number(0, token)
}

fn skipFailedArguments() -> void {
    const after = template.endOfArguments(cursor.peek())
    if after != 0 { cursor.restore(after) }
}

// Whether `object` is const: of a const type, or `*this` in a const
// member function (whose `this` is not typed so).
fn constObject(object: usize) -> bool {
    if types.isConst(ast.typeOf(object)) { return true }
    if ast.kindOf(object) != ast.DEREF { return false }
    const pointer = ast.node(object).*.lhs
    if ast.kindOf(pointer) != ast.VAR || ast.obj(ast.node(pointer).*.variable).*.name != names.K_THIS { return false }
    const f = state.currentFunction()
    return f != 0 && types.at(ast.obj(f).*.ty).*.constMethod
}

pub fn structReference(operand: usize, nameToken: usize) -> usize {
    typing.addType(operand)
    var ty = ast.typeOf(operand)
    if standard.cpp { cpp.completeIfNeeded(ty) }
    if types.kind(ty) != types.STRUCT && types.kind(ty) != types.UNION {
        if decl.sfinae { return softFailure(nameToken) }
        tokens.errorAt(nameToken, "not a struct nor a union")
    }
    if types.at(ty).*.incomplete {
        if decl.sfinae { return softFailure(nameToken) }
        tokens.errorAt(nameToken, "incomplete struct or union")
    }
    var n = operand
    while true {
        var m = findMember(ty, tokens.name(nameToken))
        // (A base's data member hidden by the class's own member function,
        // `error` beside `error()`.)
        if m != 0 && standard.cpp && types.member(m).*.isBase && cpp.declaresOwn(ty, tokens.name(nameToken)) { m = 0 }
        if m == 0 && standard.cpp && n == operand {
            // A member function or a static member (C++).
            const member = cpp.memberReference(operand, nameToken)
            if member != 0 { return member }
        }
        if m == 0 && decl.sfinae { return softFailure(nameToken) }
        if m == 0 { tokens.errorAt(nameToken, "no such member") }
        n = ast.unary(ast.MEMBER, n, nameToken)
        ast.node(n).*.member = m
        if types.member(m).*.name != 0 { break }
        ty = types.member(m).*.ty
    }
    if types.isReference(types.member(ast.node(n).*.member).*.ty) {
        ast.node(n).*.ty = types.member(ast.node(n).*.member).*.ty
        return typing.dereferenced(n)
    }
    // A member of an rvalue is one (`std::forward<A>(a).value` moves).
    if standard.cpp && isRvalueArgument(operand) { ast.node(n).*.xvalue = true }
    // A member of a const object, not mutable, is const: an array's
    // elements, a class's object (`std::span { bits }` in a const member
    // function is a span<const W, N>).
    const member = types.member(ast.node(n).*.member)
    const memberTy = member.*.ty
    if standard.cpp && !member.*.isMutable && !member.*.isBase && constObject(operand) {
        if types.kind(memberTy) == types.ARRAY && !types.isConst(types.baseOf(memberTy)) {
            ast.node(n).*.ty = types.arrayOf(types.constOf(types.baseOf(memberTy)), types.at(memberTy).*.arrayLength)
        } else if cpp.isClassType(memberTy) && !types.isConst(memberTy) {
            ast.node(n).*.ty = types.constOf(memberTy)
        }
    }
    return n
}

fn compoundLiteral(ty: usize, token: usize) -> usize {
    if scope.isFileScope() {
        const o = decl.newAnonymousGlobal(ty, token)
        initializer.globalInitializer(o)
        return ast.variableNode(o, token)
    }
    const local = decl.newLocal(0, ty, token)
    const init = initializer.localInitializer(local)
    return ast.binary(ast.COMMA, init, ast.variableNode(local, token), token)
}

// C++: whether the cursor's `(` opens a parenthesized functional cast
// (`(T(x))`) rather than a type in parentheses.
fn startsFunctionalCast() -> bool {
    if !standard.cpp { return false }
    if functionalCastInParentheses() { return true }
    const start = cursor.save()
    cursor.advance()
    const ty = decl.typeName()
    const result = !cursor.is(names.P_RPAREN) || types.kind(ty) == types.FUNC
    cursor.restore(start)
    return result
}

fn postfix() -> usize {
    var n: usize = 0
    if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) && !startsFunctionalCast() {
        const token = cursor.peek()
        cursor.advance()
        const ty = decl.typeName()
        cursor.expect(names.P_RPAREN)
        n = compoundLiteral(ty, token)
    } else {
        n = primary()
    }
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_LPAREN) {
            n = functionCall(n, token)
        } else if cursor.consume(names.P_LBRACKET) {
            const index = expression()
            cursor.expect(names.P_RBRACKET)
            var call: usize = 0
            if standard.cpp { call = cpp.indexOperator(n, index, token) }
            if call != 0 {
                n = call
            } else {
                n = ast.unary(ast.DEREF, newAdd(n, index, token), token)
            }
        } else if cursor.consume(names.P_DOT) {
            // `x.template get<T>()`: the keyword passed over.
            const markedDot = standard.cpp && cursor.consume(names.K_TEMPLATE)
            // `x.T::~T()`: the destructor named with its class.
            if standard.cpp && cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && tokens.is(tokens.next(cursor.peekNext()), names.P_TILDE) {
                cursor.advance()
                cursor.advance()
            }
            if standard.cpp && cursor.is(names.P_TILDE) {
                n = cpp.explicitDestructor(ast.unary(ast.ADDR, n, token), token)
            } else if standard.cpp && cursor.is(names.K_OPERATOR) {
                // `rhs.operator*(lhs)`: the operator function by its name.
                n = structReference(n, cpp.operatorNameToken())
            } else {
                if standard.cpp && qualifiedMemberAhead() {
                    // `object.Base::member`: the member of that base part.
                    const read = decl.qualifier()
                    const part = cpp.baseObject(n, read.0, token)
                    if part == 0 { tokens.errorAt(cursor.peek(), "not a base of the object's class") }
                    n = part
                }
                n = structReference(n, cursor.expectIdent())
                // (`x.template get<0>()` naming nothing, in SFINAE: its
                // arguments passed over.)
                if markedDot && decl.sfinaeFailed && cursor.is(names.P_LT) { skipFailedArguments() }
            }
        } else if cursor.consume(names.P_ARROW) {
            typing.addType(n)
            if standard.cpp && cpp.isClassType(ast.typeOf(n)) { n = cpp.arrowOperator(n, token) }
            const markedArrow = standard.cpp && cursor.consume(names.K_TEMPLATE)
            if standard.cpp && cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && tokens.is(tokens.next(cursor.peekNext()), names.P_TILDE) {
                cursor.advance()
                cursor.advance()
            }
            if standard.cpp && cursor.is(names.P_TILDE) {
                n = cpp.explicitDestructor(n, token)
            } else if standard.cpp && cursor.is(names.K_OPERATOR) {
                n = structReference(ast.unary(ast.DEREF, n, token), cpp.operatorNameToken())
            } else {
                n = ast.unary(ast.DEREF, n, token)
                if standard.cpp && qualifiedMemberAhead() {
                    // `p->Base::member`, `p->C<Parent>::member`
                    const read = decl.qualifier()
                    const part = cpp.baseObject(n, read.0, token)
                    if part == 0 { tokens.errorAt(cursor.peek(), "not a base of the object's class") }
                    n = part
                }
                n = structReference(n, cursor.expectIdent())
                if markedArrow && decl.sfinaeFailed && cursor.is(names.P_LT) { skipFailedArguments() }
            }
        } else if cursor.consume(names.P_INC) {
            var call: usize = 0
            if standard.cpp { call = cpp.unaryOperator("++", n, true, token) }
            n = if call != 0 { call } else { incrementAfter(n, 1, token) }
        } else if cursor.consume(names.P_DEC) {
            var call: usize = 0
            if standard.cpp { call = cpp.unaryOperator("--", n, true, token) }
            n = if call != 0 { call } else { incrementAfter(n, -1, token) }
        } else {
            return n
        }
    }
    return n
}

// A call of `callee`, after its `(`. In C++ the arguments choose among
// the overloads of a function's name, and the parameters left without
// an argument take their defaults.
// The callee an unqualified name made last (functionCall joins the
// functions argument-dependent lookup finds).
var unqualifiedCallee: usize = 0

fn functionCall(callee: usize, token: usize) -> usize {
    const unqualified = callee != 0 && callee == unqualifiedCallee
    unqualifiedCallee = 0
    // The arguments, read first.
    const MAX_ARGS: usize = 256
    const mark = base.scratchMark()
    const read = base.scratch(MAX_ARGS * 8)
    const count = argumentList(names.P_RPAREN, read, MAX_ARGS)
    const given = base.keptWords(read, count)
    base.releaseScratch(mark)
    if standard.cpp && unqualified { cpp.withArgumentDependent(callee, given, count) }
    if standard.cpp && ast.kindOf(callee) == ast.CAST && ast.node(callee).*.name == cpp.boundMemberName() && ast.node(callee).*.rhs != 0 {
        // `(obj.*pmf)(args)`: the object's address first.
        const withObject = base.alloc((count + 1) * 8)
        base.putWord(withObject, ast.node(callee).*.rhs)
        var i: usize = 0
        while i < count {
            base.putWord(withObject + (i + 1) * 8, base.getWord(given + i * 8))
            i += 1
        }
        ast.node(callee).*.rhs = 0
        return buildCall(callee, withObject, count + 1, token)
    }
    return buildCall(callee, given, count, token)
}

// The type trait builtins (`__is_enum(T)`, `__is_base_of(B, D)`, ...):
// a bool constant from the types given.
fn isTypeTrait(name: u32) -> bool {
    const text = base.nameOf(name)
    if text.length < 6 { return false }
    return base.same(text[0..5], "__is_") || base.same(text[0..6], "__has_")
}

fn typeTrait(token: usize) -> usize {
    const text = base.nameOf(tokens.name(token))
    cursor.advance()
    cursor.expect(names.P_LPAREN)
    const given = base.alloc(32 * 8)
    var count: usize = 0
    while !cursor.consume(names.P_RPAREN) {
        if count > 0 { cursor.expect(names.P_COMMA) }
        if count >= 32 { cursor.fail("too many types") }
        const start = cursor.save()
        const outerPlaceholders = scope.packPlaceholders
        scope.packPlaceholders = true
        var ty = decl.typeName()
        scope.packPlaceholders = outerPlaceholders
        if cursor.consume(names.P_ELLIPSIS) {
            // A pack's elements, one type each.
            if !types.isBoundPack(ty) { tokens.errorAt(start, "only a parameter pack expands with ...") }
            const holder = types.at(ty).*.members
            var index: i64 = 0
            while index < types.packCount(holder) {
                base.putWord(given + count * 8, types.packTypeAt(holder, index))
                count += 1
                index += 1
            }
            continue
        }
        base.putWord(given + count * 8, ty)
        count += 1
    }
    const first = base.getWord(given)
    const second: usize = if count > 1 { base.getWord(given + 8) } else { 0 }
    var result = false
    // (What a trait tries is not evaluated: no function body is made.)
    unevaluated += 1
    if base.same(text, "__is_enum") {
        result = types.kind(first) == types.ENUM
    } else if base.same(text, "__is_class") {
        result = types.kind(first) == types.STRUCT && cpp.isClassType(first)
    } else if base.same(text, "__is_union") {
        result = types.kind(first) == types.UNION
    } else if base.same(text, "__is_empty") {
        result = cpp.isEmptyClass(first)
    } else if base.same(text, "__is_polymorphic") {
        result = cpp.isPolymorphic(first)
    } else if base.same(text, "__is_abstract") {
        result = cpp.isAbstract(first)
    } else if base.same(text, "__is_final") {
        result = cpp.isFinal(first)
    } else if base.same(text, "__is_literal_type") {
        result = true
    } else if base.same(text, "__is_base_of") {
        result = second != 0 && (cpp.isBaseOf(first, second) || (cpp.isClassType(first) && types.compatible(first, second)))
    } else if base.same(text, "__is_same") || base.same(text, "__is_same_as") {
        result = second != 0 && types.sameType(first, second) && types.isConst(first) == types.isConst(second) && (types.kind(first) != types.REF || types.at(first).*.isRvalueRef == types.at(second).*.isRvalueRef)
    } else if base.same(text, "__is_function") {
        result = types.kind(first) == types.FUNC
    } else if base.same(text, "__is_trivially_copyable") {
        result = cpp.isTriviallyCopyable(first)
    } else if base.same(text, "__is_standard_layout") {
        result = cpp.isStandardLayout(first)
    } else if base.same(text, "__has_unique_object_representations") {
        result = cpp.uniqueRepresentation(first)
    } else if base.same(text, "__is_trivial") {
        result = cpp.isTrivial(first)
    } else if base.same(text, "__is_pod") {
        result = cpp.isTrivial(first) && cpp.isStandardLayout(first)
    } else if base.same(text, "__has_trivial_destructor") || base.same(text, "__is_trivially_destructible") {
        result = !cpp.hasDestructor(first)
    } else if base.same(text, "__is_destructible") || base.same(text, "__is_nothrow_destructible") {
        result = types.kind(first) != types.VOID && types.kind(first) != types.FUNC && !types.at(first).*.incomplete
    } else if base.same(text, "__is_constructible") || base.same(text, "__is_nothrow_constructible") || base.same(text, "__is_trivially_constructible") {
        result = cpp.isConstructible(first, given + 8, count - 1, token)
        // (Made from nothing: trivial without code to run, no default
        // member initializer, vtable pointer or constructor anywhere.)
        if result && base.same(text, "__is_trivially_constructible") { result = !cpp.needsSpecialCopy(first) && !cpp.isPolymorphic(first) && !cpp.hasDestructor(first) && (count > 1 || !cpp.needsConstruction(first)) }
    } else if base.same(text, "__is_assignable") || base.same(text, "__is_nothrow_assignable") || base.same(text, "__is_trivially_assignable") {
        result = second != 0 && cpp.isAssignable(first, second, token)
        if result && base.same(text, "__is_trivially_assignable") { result = !cpp.needsSpecialCopy(types.referenced(first)) && !cpp.isPolymorphic(types.referenced(first)) }
    } else if base.same(text, "__is_convertible_to") || base.same(text, "__is_convertible") || base.same(text, "__is_nothrow_convertible") {
        result = second != 0 && cpp.isConvertible(first, second, token)
    } else if base.same(text, "__is_aggregate") {
        result = types.kind(first) == types.ARRAY || cpp.isAggregateClass(first)
    } else if base.same(text, "__has_virtual_destructor") {
        result = cpp.isPolymorphic(first) && cpp.hasDestructor(first)
    } else {
        tokens.errorAt(token, base.join("unknown type trait ", text))
    }
    unevaluated -= 1
    const n = ast.number(if result { 1 } else { 0 }, token)
    ast.node(n).*.ty = types.boolOf()
    return n
}

// A constraint (a requires clause or a concept's expression) at the
// cursor: its value (0 or 1), read with decl.sfinae on by the caller.
pub fn constraintValue() -> i64 {
    const n = logicalOr()
    if decl.sfinaeFailed { return 0 }
    if !eval.isConstant(n) { return 0 }
    return if eval.evaluate(n) != 0 { 1 } else { 0 }
}

// Whether the `requires` at the cursor starts a requires-expression
// (`requires { ... }`, `requires (T x) { ... }`) rather than a nested
// requirement.
fn requiresExpressionAhead() -> bool {
    const next = cursor.peekNext()
    if tokens.is(next, names.P_LBRACE) { return true }
    if !tokens.is(next, names.P_LPAREN) { return false }
    var t = tokens.next(next)
    var level: i64 = 1
    while !tokens.isEof(t) && level > 0 {
        if tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_RPAREN) { level -= 1 }
        t = tokens.next(t)
    }
    return tokens.is(t, names.P_LBRACE)
}

// `requires (T t) { t.f(); typename T::type; { t.g() } -> C<int>; }`
// at `requires`: true when every requirement is met (an expression
// that reads, a type that exists), false otherwise; read with the
// soft errors of decl.sfinae.
fn requiresExpression(token: usize) -> usize {
    cursor.expect(names.K_REQUIRES)
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    scope.enter()
    if cursor.consume(names.P_LPAREN) {
        // The parameters: locals of their types, read as a function's
        // (`Args &&...args` of a bound pack: one each, the pack's name
        // standing for them, an empty one too).
        const fnType = decl.functionParameters(types.voidOf())
        var p = types.at(fnType).*.params
        while p != 0 {
            if types.param(p).*.name != 0 {
                const o = ast.newObj(types.param(p).*.name, types.param(p).*.ty, types.param(p).*.token)
                ast.obj(o).*.isLocal = true
                const bound = scope.bindVariable(types.param(p).*.name, o)
                if types.param(p).*.packName != 0 {
                    const packBinding = scope.findHere(types.param(p).*.packName)
                    var holder: usize = 0
                    if packBinding != 0 && scope.at(packBinding).*.kind == scope.PACK {
                        holder = scope.at(packBinding).*.obj
                    } else {
                        holder = types.newPackHolder()
                        const packBound = scope.bindPack(types.param(p).*.packName, 0, holder)
                    }
                    types.addPackVariable(holder, o)
                    types.addPackType(holder, types.param(p).*.ty)
                }
            }
            p = types.param(p).*.next
        }
        var emptyPack = types.at(fnType).*.emptyPacks
        while emptyPack != 0 {
            const emptyBound = scope.bindPack(@intCast(u32, base.getWord(emptyPack)), 0, types.newPackHolder())
            emptyPack = base.getWord(emptyPack + 8)
        }
    }
    cursor.expect(names.P_LBRACE)
    unevaluated += 1
    while !cursor.consume(names.P_RBRACE) {
        if cursor.isEof() { cursor.fail("unterminated requires expression") }
        if cursor.consume(names.K_TYPENAME) {
            // A type that must exist (named, a class template's instance
            // not made: `typename StringTypeAdapter<T>;`).
            if decl.isTypename(cursor.peek()) {
                template.deferInstances += 1
                const ignored = decl.typeName()
                template.deferInstances -= 1
            } else {
                decl.sfinaeFailed = true
                while !cursor.is(names.P_SEMI) && !cursor.isEof() { cursor.advance() }
            }
            cursor.expect(names.P_SEMI)
        } else if cursor.consume(names.P_LBRACE) {
            // `{ e } -> C;` or `{ e } noexcept;`: e must read.
            const e = expression()
            typing.addType(e)
            cursor.expect(names.P_RBRACE)
            const ignored = cursor.consume(names.K_NOEXCEPT)
            if cursor.consume(names.P_ARROW) {
                // The type constraint: passed over (its concept is
                // taken to hold).
                while !cursor.is(names.P_SEMI) && !cursor.isEof() { cursor.advance() }
            }
            cursor.expect(names.P_SEMI)
        } else if cursor.is(names.K_REQUIRES) && !requiresExpressionAhead() {
            // A nested requirement, `requires std::equality_comparable<T>;`:
            // the constraint must hold.
            cursor.advance()
            const nestedFailed = decl.sfinaeFailed
            decl.sfinaeFailed = false
            const v = constraintValue()
            if v == 0 || decl.sfinaeFailed { decl.sfinaeFailed = true } else { decl.sfinaeFailed = nestedFailed }
            cursor.expect(names.P_SEMI)
        } else if cursor.is(names.K_REQUIRES) {
            const inner = requiresExpression(cursor.peek())
            if ast.node(inner).*.value == 0 { decl.sfinaeFailed = true }
            cursor.expect(names.P_SEMI)
        } else {
            const e = expression()
            typing.addType(e)
            cursor.expect(names.P_SEMI)
        }
    }
    unevaluated -= 1
    scope.leave()
    const met = !decl.sfinaeFailed
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    const n = ast.number(if met { 1 } else { 0 }, token)
    ast.node(n).*.ty = types.boolOf()
    return n
}

// Whether the parenthesis at the cursor holds a fold expression: a
// `...` of its own level (`(args + ...)`, `(... && f(args))`,
// `(x + ... + args)`), not a sizeof's.
fn foldAhead() -> bool {
    var t = cursor.peekNext()
    var level: i64 = 0
    var previous: usize = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) {
            level += 1
        } else if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) {
            if level == 0 { return false }
            level -= 1
        } else if tokens.is(t, names.P_ELLIPSIS) && level == 0 {
            // A fold's `...` stands next to its operator (`(... + e)`,
            // `(e + ...)`); `X<Ts...>` in parentheses is no fold.
            if previous == 0 { return true }
            return tokens.kind(previous) == tokens.PUNCT && !tokens.is(previous, names.P_RPAREN) && !tokens.is(previous, names.P_RBRACKET) && !tokens.is(previous, names.P_RBRACE) && !tokens.is(previous, names.P_GT)
        } else if tokens.is(t, names.P_SEMI) {
            return false
        }
        previous = t
        t = tokens.next(t)
    }
    return false
}

// Whether a member access names its member with the class it is of:
// `Base::m`, `C<Parent>::m`.
fn qualifiedMemberAhead() -> bool {
    if !cursor.isIdent() { return false }
    const next = cursor.peekNext()
    if tokens.is(next, names.P_SCOPE) { return true }
    if tokens.is(next, names.P_LT) {
        const end = template.endOfArguments(next)
        return end != 0 && tokens.is(end, names.P_SCOPE)
    }
    return false
}

// A fold expression at its `(`: the pack's elements, read once each
// (as argumentList does), joined by the operator from the left
// (`(... op E)`, `(I op ... op E)`) or the right (`(E op ...)`,
// `(E op ... op I)`).
fn foldExpression(open: usize) -> usize {
    cursor.advance()
    const first = cursor.peek()
    // The `...`, the operator before it and the token after it.
    var ellipsis: usize = 0
    var before: usize = 0
    var t = first
    var level: i64 = 0
    var previous: usize = 0
    while ellipsis == 0 {
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) { level -= 1 }
        if tokens.is(t, names.P_ELLIPSIS) && level == 0 {
            ellipsis = t
            before = previous
        }
        previous = t
        t = tokens.next(t)
    }
    const after = tokens.next(ellipsis)
    const elements = base.alloc(256 * 8)
    var count: usize = 0
    var result: usize = 0
    var op: usize = 0
    if before == 0 {
        // `(... op E)`: E the pack, folded from the left.
        op = after
        cursor.restore(tokens.next(op))
        count = packElements(elements, 256)
        cursor.expect(names.P_RPAREN)
        if count == 0 { return emptyFold(op) }
        result = base.getWord(elements)
        var index: usize = 1
        while index < count {
            result = foldStep(op, result, base.getWord(elements + index * 8))
            index += 1
        }
        return result
    }
    op = before
    // The left side, up to the operator (made to end the expression).
    const savedName = tokens.at(op).*.name
    tokens.at(op).*.name = names.P_RPAREN
    cursor.restore(first)
    const seen = scope.packSeen
    scope.packSeen = 0
    const leftStart = cursor.save()
    // (Whether it names a pack, by a reading that may fail: an empty
    // pack's `Traits::zero` names nothing.)
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    var left = assign()
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    const leftIsPack = scope.packSeen != 0
    cursor.restore(leftStart)
    if leftIsPack {
        count = packElements(elements, 256)
    } else {
        left = assign()
    }
    scope.packSeen = seen
    cursor.expect(names.P_RPAREN)
    tokens.at(op).*.name = savedName
    if tokens.is(after, names.P_RPAREN) {
        // `(E op ...)`: folded from the right.
        if !leftIsPack { tokens.errorAt(first, "a fold needs a parameter pack") }
        cursor.restore(tokens.next(after))
        if count == 0 { return emptyFold(op) }
        result = base.getWord(elements + (count - 1) * 8)
        var index = count - 1
        while index > 0 {
            index -= 1
            result = foldStep(op, base.getWord(elements + index * 8), result)
        }
        return result
    }
    if tokens.name(after) != savedName { tokens.errorAt(after, "the fold's operators differ") }
    cursor.restore(tokens.next(after))
    if leftIsPack {
        // `(E op ... op I)`: I then the elements, from the right.
        result = assign()
        cursor.expect(names.P_RPAREN)
        var index = count
        while index > 0 {
            index -= 1
            result = foldStep(op, base.getWord(elements + index * 8), result)
        }
        return result
    }
    // `(I op ... op E)`: I then the elements, from the left.
    result = left
    count = packElements(elements, 256)
    cursor.expect(names.P_RPAREN)
    var index: usize = 0
    while index < count {
        result = foldStep(op, result, base.getWord(elements + index * 8))
        index += 1
    }
    return result
}

// The elements of the pack expression at the cursor (ending at `)`,
// left there), into `elements`: their number.
fn packElements(elements: usize, most: usize) -> usize {
    const start = cursor.save()
    const seen = scope.packSeen
    scope.packSeen = 0
    const temporaries = state.takeTemporaries()
    state.setTemporaries(temporaries)
    // (The pack found first, by a reading that may fail: of an empty
    // pack, `Traits::zero` names no element.)
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    const probe = assign()
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    const holder = scope.packSeen
    scope.packSeen = seen
    if holder == 0 { tokens.errorAt(start, "a fold needs a parameter pack") }
    const n = types.packCount(holder)
    state.setTemporaries(temporaries)
    if n == 0 { return 0 }
    cursor.restore(start)
    scope.packIndex = 0
    var node = assign()
    scope.packIndex = -1
    typing.addType(node)
    base.putWord(elements, node)
    var index: i64 = 1
    while index < n {
        if @intCast(usize, index) >= most { cursor.fail("too many elements in a fold") }
        scope.packIndex = index
        cursor.restore(start)
        node = assign()
        scope.packIndex = -1
        typing.addType(node)
        base.putWord(elements + @intCast(usize, index) * 8, node)
        index += 1
    }
    return @intCast(usize, n)
}

// A fold of no elements: true for &&, false for ||, nothing for `,`.
fn emptyFold(op: usize) -> usize {
    if tokens.is(op, names.P_ANDAND) || tokens.is(op, names.P_OROR) {
        const n = ast.number(if tokens.is(op, names.P_ANDAND) { 1 } else { 0 }, op)
        ast.node(n).*.ty = types.boolOf()
        return n
    }
    if tokens.is(op, names.P_COMMA) { return typing.cast(ast.number(0, op), types.voidOf()) }
    tokens.errorAt(op, "a fold of nothing needs &&, || or ,")
    return 0
}

// `lhs op rhs` for the fold's operator token.
fn foldStep(op: usize, lhs: usize, rhs: usize) -> usize {
    const name = tokens.name(op)
    if name == names.P_PLUS { return added(true, lhs, rhs, op) }
    if name == names.P_MINUS { return added(false, lhs, rhs, op) }
    if name == names.P_STAR { return binaryNode(ast.MUL, "*", lhs, rhs, op) }
    if name == names.P_SLASH { return binaryNode(ast.DIV, "/", lhs, rhs, op) }
    if name == names.P_PERCENT { return binaryNode(ast.MOD, "%", lhs, rhs, op) }
    if name == names.P_AMP { return binaryNode(ast.BITAND, "&", lhs, rhs, op) }
    if name == names.P_PIPE { return binaryNode(ast.BITOR, "|", lhs, rhs, op) }
    if name == names.P_CARET { return binaryNode(ast.BITXOR, "^", lhs, rhs, op) }
    if name == names.P_SHL { return binaryNode(ast.SHL, "<<", lhs, rhs, op) }
    if name == names.P_SHR { return binaryNode(ast.SHR, ">>", lhs, rhs, op) }
    if name == names.P_ANDAND { return binaryNode(ast.LOGAND, "&&", lhs, rhs, op) }
    if name == names.P_OROR { return binaryNode(ast.LOGOR, "||", lhs, rhs, op) }
    if name == names.P_EQ { return binaryNode(ast.EQ, "==", lhs, rhs, op) }
    if name == names.P_NE { return binaryNode(ast.NE, "!=", lhs, rhs, op) }
    if name == names.P_LT { return binaryNode(ast.LT, "<", lhs, rhs, op) }
    if name == names.P_LE { return binaryNode(ast.LE, "<=", lhs, rhs, op) }
    if name == names.P_GT { return swapped(ast.LT, ">", lhs, rhs, op) }
    if name == names.P_GE { return swapped(ast.LE, ">=", lhs, rhs, op) }
    if name == names.P_COMMA { return ast.binary(ast.COMMA, lhs, rhs, op) }
    tokens.errorAt(op, "this operator does not fold")
    return 0
}

// The arguments up to `closer` (consumed) into `given`: their number.
// C++: an argument followed by `...` is a pack expansion, read once per
// element of the pack it names (`f(args...)`, `g(h(args))...`): the
// first reading notes the pack (scope.packSeen) and stands for its
// first element, the others are read again with scope.packIndex set.
pub fn argumentList(closer: u32, given: usize, maxArgs: usize) -> usize {
    var count: usize = 0
    // (The places read: an expansion of an empty pack is one, `f(values...,
    // "\n")`, though it gives no argument.)
    var places: usize = 0
    while !cursor.consume(closer) {
        if places > 0 { cursor.expect(names.P_COMMA) }
        places += 1
        // (A braced list may end with a comma: `T { a, b, }`.)
        if places > 1 && closer == names.P_RBRACE && cursor.consume(closer) { break }
        if count >= maxArgs { cursor.fail("too many arguments") }
        const start = cursor.save()
        const outerSeen = scope.packSeen
        scope.packSeen = 0
        const temporaries = state.takeTemporaries()
        state.setTemporaries(temporaries)
        // An expansion's first reading may name what an empty pack
        // has not (`forward<Args>(args)...` with no element): read
        // softly, and again for its errors when the pack has elements.
        const expands = standard.cpp && scope.packIndex < 0 && expansionAhead(closer)
        const outerSfinae = decl.sfinae
        const outerFailed = decl.sfinaeFailed
        if expands {
            decl.sfinae = true
            decl.sfinaeFailed = false
        }
        var argument: usize = 0
        if standard.cpp && cursor.is(names.P_LBRACE) {
            // `f({a, b})`: kept as its tokens for the parameter chosen.
            argument = cpp.bracedArgument(cursor.peek())
        } else {
            argument = assign()
        }
        const softFailed = expands && decl.sfinaeFailed
        if expands {
            decl.sfinae = outerSfinae
            decl.sfinaeFailed = outerFailed
        }
        if standard.cpp && cursor.is(names.P_ELLIPSIS) && scope.packIndex < 0 {
            const holder = scope.packSeen
            if holder == 0 && decl.sfinae {
                // `forward<Args>(args)...` in a template's pattern: not
                // an expression yet.
                decl.sfinaeFailed = true
                cursor.expect(names.P_ELLIPSIS)
                scope.packSeen = outerSeen
                state.setTemporaries(temporaries)
                continue
            }
            if holder == 0 { cursor.fail("nothing to expand with ...") }
            const n = types.packCount(holder)
            if n == 0 {
                // Nothing: the reading is dropped.
                state.setTemporaries(temporaries)
            } else {
                if softFailed {
                    // Its errors are real: read again to report them.
                    cursor.restore(start)
                    state.setTemporaries(temporaries)
                    argument = assign()
                }
                typing.addType(argument)
                base.putWord(given + count * 8, argument)
                count += 1
                var index: i64 = 1
                while index < n {
                    if count >= maxArgs { cursor.fail("too many arguments") }
                    scope.packIndex = index
                    cursor.restore(start)
                    argument = assign()
                    scope.packIndex = -1
                    typing.addType(argument)
                    base.putWord(given + count * 8, argument)
                    count += 1
                    index += 1
                }
            }
            cursor.expect(names.P_ELLIPSIS)
            scope.packSeen = outerSeen
        } else {
            // A pack named here may be expanded by an enclosing
            // expression (`g(f(args))...`): noted on.
            typing.addType(argument)
            base.putWord(given + count * 8, argument)
            count += 1
            if scope.packSeen == 0 { scope.packSeen = outerSeen }
        }
    }
    return count
}

// Whether the argument at the cursor ends with `...` (before the `,`
// or `closer` at its level).
fn expansionAhead(closer: u32) -> bool {
    var t = cursor.peek()
    var level: i64 = 0
    var previous: usize = 0
    while !tokens.isEof(t) {
        if level == 0 && (tokens.is(t, names.P_COMMA) || tokens.is(t, closer)) { break }
        if tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE) { return false }
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) { level -= 1 }
        if level < 0 { break }
        previous = t
        t = tokens.next(t)
    }
    return previous != 0 && tokens.is(previous, names.P_ELLIPSIS)
}

// The call of `callee` with the `count` arguments in `given`. In C++
// a member function's callee carries its object's address (lhs; the
// current `this` when none), passed first; the arguments choose among
// the overloads of a function's name; a virtual function is called
// through the object's vtable unless the callee was named with its
// class (lhs's value 1); a class argument converts through a
// constructor; the parameters left without an argument take their
// defaults.
pub fn buildCall(callee: usize, givenArgs: usize, givenCount: usize, token: usize) -> usize {
    typing.addType(callee)
    var typedCount: usize = 0
    while typedCount < givenCount {
        typing.addType(base.getWord(givenArgs + typedCount * 8))
        typedCount += 1
    }
    var fnType = ast.typeOf(callee)
    if types.kind(fnType) == types.PTR && types.kind(types.baseOf(fnType)) == types.FUNC { fnType = types.baseOf(fnType) }
    if types.kind(fnType) != types.FUNC {
        if standard.cpp && cpp.isClassType(fnType) { return cpp.callOperator(callee, givenArgs, givenCount, token) }
        if decl.sfinae { return softFailure(token) }
        tokens.errorAt(token, "not a function")
    }
    var given = givenArgs
    var count = givenCount
    var call = callee
    if standard.cpp && ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.template != 0 {
        // A function template: the instance the arguments deduce, or a
        // function of the name (its overloads) when that fits better
        // (or as well: a function wins over a template).
        const holder = ast.obj(ast.node(callee).*.variable)
        // (A member template called on a const object: its const
        // overloads only.)
        const object = ast.node(callee).*.lhs
        const outerConst = template.objectConstness
        template.objectConstness = 0
        if object != 0 {
            typing.addType(object)
            const ot = ast.typeOf(object)
            if types.kind(ot) == types.PTR { template.objectConstness = if types.isConst(types.baseOf(ot)) { 2 } else { 1 } }
        }
        const instance = template.candidateInstance(holder.*.template, givenArgs, givenCount, holder.*.templateArgs)
        template.objectConstness = outerConst
        var chosen = instance
        var score: i64 = if instance != 0 { argumentScore(instance, givenArgs, givenCount) } else { -1 }
        // A member function's object is not among the arguments.
        var plain: usize = 0
        var plainScore: i64 = -1
        var candidate = holder.*.nextOverload
        while candidate != 0 {
            const s = if ast.obj(candidate).*.classType != 0 && !ast.obj(candidate).*.isStaticMember { argumentScore(candidate, givenArgs, givenCount) } else { overloadScore(candidate, givenArgs, givenCount) }
            if s > plainScore {
                plain = candidate
                plainScore = s
            }
            candidate = ast.obj(candidate).*.nextOverload
        }
        if plain != 0 && plainScore >= score { chosen = plain }
        // (No instance, no function weighed as fitting here: the
        // functions of the name, chosen among below with every
        // conversion, `set->add(this)` to a base's pointer.)
        if chosen == 0 && holder.*.nextOverload != 0 { chosen = holder.*.nextOverload }
        if chosen == 0 && decl.sfinae { return softFailure(token) }
        if chosen == 0 && interp.trace {
            var shown: usize = 0
            while shown < givenCount {
                tokens.warnAt(token, base.join("argument type ", mangle.typeCode(ast.typeOf(base.getWord(givenArgs + shown * 8)))))
                shown += 1
            }
            tokens.warnAt(token, base.join("pattern ", mangle.typeCode(template.patternOf(holder.*.template))))
        }
        if chosen == 0 { tokens.errorAt(token, base.join(base.join("no instance of the function template '", base.nameOf(holder.*.name)), "' takes these arguments")) }
        ast.node(callee).*.variable = chosen
        ast.node(callee).*.ty = ast.obj(chosen).*.ty
        // (A static member's instance named through an object: no object.)
        if ast.obj(chosen).*.isStaticMember && ast.obj(chosen).*.classType != 0 { ast.node(callee).*.lhs = 0 }
    }
    if standard.cpp && ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.isFunction {
        const first = ast.node(callee).*.variable
        // Static and non-static members of one name (`void Normalize()`
        // beside `static DiyFp Normalize(const DiyFp &)`): each weighed
        // with the arguments it takes (the object first for a non-static
        // one), the chosen one's kept.
        var mixed = false
        if ast.obj(first).*.classType != 0 {
            var c = first
            while c != 0 {
                if ast.obj(c).*.isStaticMember != ast.obj(first).*.isStaticMember { mixed = true }
                c = ast.obj(c).*.nextOverload
            }
        }
        var chosenFirst = first
        if mixed {
            var object = ast.node(callee).*.lhs
            if object == 0 { object = lambda.thisKeyword(token) }
            if object == 0 { object = cpp.thisForWeighing(ast.obj(first).*.classType, token) }
            const withObject = base.alloc((count + 1) * 8)
            base.putWord(withObject, object)
            var copied: usize = 0
            while copied < count {
                base.putWord(withObject + (copied + 1) * 8, base.getWord(givenArgs + copied * 8))
                copied += 1
            }
            var bestScore: i64 = -1
            var c = first
            while c != 0 {
                const score = if ast.obj(c).*.isStaticMember { overloadScore(c, givenArgs, count) } else { overloadScore(c, withObject, count + 1) }
                if score > bestScore {
                    bestScore = score
                    chosenFirst = c
                }
                c = ast.obj(c).*.nextOverload
            }
        }
        if ast.obj(chosenFirst).*.classType != 0 && !ast.obj(chosenFirst).*.isStaticMember {
            var object = ast.node(callee).*.lhs
            // (In a lambda's body: the object of the class around, the
            // captured `this`, not the closure.)
            if object == 0 { object = lambda.thisKeyword(token) }
            if object == 0 { object = cpp.thisOrNull(ast.obj(chosenFirst).*.classType, token) }
            given = base.alloc((count + 1) * 8)
            base.putWord(given, object)
            var copy: usize = 0
            while copy < count {
                base.putWord(given + (copy + 1) * 8, base.getWord(givenArgs + copy * 8))
                copy += 1
            }
            count += 1
        }
        var chosen = if mixed { chosenFirst } else { chooseOverload(first, given, count) }
        // (A base's function joined by `using Base::f;`: that function.)
        if ast.obj(chosen).*.usingOf != 0 { chosen = ast.obj(chosen).*.usingOf }
        // (A static member chosen through an object: no object.)
        if mixed && ast.obj(chosen).*.isStaticMember { ast.node(callee).*.lhs = 0 }
        ast.node(callee).*.variable = chosen
        if unevaluated == 0 { ast.obj(chosen).*.isReferenced = true }
        // Not evaluated: the body is made only when the result type is to
        // be deduced from it.
        if unevaluated == 0 || types.hasAutoResult(types.baseOf(ast.obj(chosen).*.ty)) { template.ensureDefined(chosen) }
        fnType = ast.obj(chosen).*.ty
        ast.node(callee).*.ty = fnType
        if ast.obj(chosen).*.isVirtual && ast.node(callee).*.value == 0 {
            call = cpp.virtualCallee(chosen, given, token)
        }
    }
    var p = types.at(fnType).*.params
    var head: usize = 0
    var tail: usize = 0
    var index: usize = 0
    while index < count || (p != 0 && types.param(p).*.defaultValue != 0) {
        var argument: usize = 0
        if index < count {
            argument = base.getWord(given + index * 8)
        } else {
            argument = types.param(p).*.defaultValue
            if ast.kindOf(argument) == ast.DEFAULT_ARG { argument = cpp.defaultArgument(argument) }
            typing.addType(argument)
        }
        index += 1
        if p != 0 && ast.kindOf(argument) == ast.BRACED { argument = cpp.bracedValue(argument, types.param(p).*.ty) }
        if p != 0 && standard.cpp && conversionRank(ast.typeOf(argument), types.param(p).*.ty) == 0 {
            // (`FunctionPtr(f)`, f overloaded: the overload it takes.)
            const chosen = overloadFor(argument, types.param(p).*.ty)
            if chosen != 0 {
                ast.obj(chosen).*.isReferenced = true
                argument = variableValue(chosen, ast.tokenOf(argument))
            }
        }
        const at = ast.typeOf(argument)
        if p != 0 {
            const pt = types.param(p).*.ty
            if standard.cpp && cpp.isClassType(types.referenced(pt)) {
                argument = cpp.convertValue(argument, pt)
                if types.kind(pt) == types.STRUCT || types.kind(pt) == types.UNION {
                    argument = cpp.consumed(argument)
                    // (One that cannot move by its bytes: its address.)
                    if cpp.passesIndirectly(pt) { argument = cpp.indirectArgument(argument, pt, token) }
                }
            }
            if types.kind(pt) != types.STRUCT && types.kind(pt) != types.UNION { argument = typing.cast(argument, pt) }
            p = types.param(p).*.next
        } else {
            // The default argument promotions (C11 6.5.2.2): float to
            // double, narrow integers to int; arrays and functions decay.
            if types.kind(at) == types.FLOAT {
                argument = typing.cast(argument, types.doubleOf())
            } else if types.isInteger(at) && types.size(at) < 4 {
                argument = typing.cast(argument, types.intOf())
            } else if types.kind(at) == types.ARRAY {
                argument = typing.cast(argument, types.pointerTo(types.baseOf(at)))
            } else if types.kind(at) == types.FUNC {
                argument = typing.cast(argument, types.pointerTo(at))
            }
        }
        if head == 0 { head = argument } else { ast.node(tail).*.next = argument }
        tail = argument
    }
    if p != 0 && decl.sfinae { return softFailure(token) }
    if p != 0 { tokens.errorAt(token, "too few arguments") }
    // (A class result is complete at the call: a template's instance
    // the declaration left as named only, `Ref<RegisteredSymbolImpl>`.)
    if standard.cpp && !types.isReference(types.baseOf(fnType)) { const ignoredResult = cpp.completeIfNeeded(types.baseOf(fnType)) }
    const n = ast.make(ast.FUNCALL, token)
    ast.node(n).*.lhs = call
    ast.node(n).*.funcType = fnType
    ast.node(n).*.ty = types.baseOf(fnType)
    ast.node(n).*.args = head
    // A struct, union or wide integer result comes back through a
    // buffer of the caller's.
    const rt = types.baseOf(fnType)
    if types.kind(rt) == types.STRUCT || types.kind(rt) == types.UNION || types.isWide(rt) {
        ast.node(n).*.returnBuffer = temporary(rt, token)
        if standard.cpp { cpp.noteCall(n) }
    }
    // A reference result is the object it refers to (an rvalue one's
    // an rvalue to overloads).
    if types.isReference(rt) {
        const object = typing.dereferenced(n)
        if types.isRvalueReference(rt) { ast.node(object).*.xvalue = true }
        return object
    }
    return n
}

// `__builtin_add_overflow(a, b, &r)` (and sub, mul): computed exactly
// in a 130-bit integer, stored into *r as its type keeps it; whether it
// did not fit. Read as the statement expression
// `({ T *p = &r; _BitInt(130) w = (_BitInt(130))a op (_BitInt(130))b;
// *p = (T)w; w != *p; })` made of the arguments' tokens.
// An overflow builtin's operation (`add`, `sub`, `mul`) and, for the
// typed ones (`__builtin_sadd_overflow`, `__builtin_umulll_overflow`),
// the operands' type ("" for the generic ones); "" for no such builtin.
fn typedOverflow(text: []const u8) -> ([]const u8, []const u8) {
    if !base.startsWith(text, "__builtin_") || text.length < 22 { return -> ("", "") }
    const tail = text[text.length - 9..text.length]
    if !base.same(tail, "_overflow") { return -> ("", "") }
    var name = text[10..text.length - 9]
    if base.same(name, "add") || base.same(name, "sub") || base.same(name, "mul") { return -> (name, "") }
    var unsigned = false
    if name[0] == 'u' { unsigned = true } else if name[0] != 's' { return -> ("", "") }
    const op = name[1..4]
    if !base.same(op, "add") && !base.same(op, "sub") && !base.same(op, "mul") { return -> ("", "") }
    const width = name[4..name.length]
    var ty: []const u8 = ""
    if width.length == 0 { ty = "int" } else if base.same(width, "l") { ty = "long" } else if base.same(width, "ll") { ty = "long long" } else { return -> ("", "") }
    if unsigned { ty = base.join("unsigned ", ty) }
    return -> (op, ty)
}

// An integer, enum, pointer, float or double (not long double).
fn isBitScalar(ty: usize) -> bool {
    const k = types.kind(ty)
    if k == types.LDOUBLE || types.isWide(ty) { return false }
    return types.isInteger(ty) || k == types.PTR || k == types.FLOAT || k == types.DOUBLE || k == types.ENUM
}

fn isOverflowBuiltin(text: []const u8) -> bool {
    const typed = typedOverflow(text)
    const operation = typed.0
    return operation.length != 0
}

fn overflowBuiltin(token: usize) -> usize {
    const text = tokens.text(token)
    const typed = typedOverflow(text)
    const operation = typed.0
    const op = if base.same(operation, "add") { "+" } else if base.same(operation, "sub") { "-" } else { "*" }
    cursor.advance()
    const open = cursor.peek()
    // The three arguments' token ranges.
    // (Each argument's first token and the `,` or `)` after it.)
    const starts = base.alloc(4 * 8)
    const ends = base.alloc(4 * 8)
    var count: usize = 0
    var t = tokens.next(open)
    base.putWord(starts, t)
    var level: i64 = 0
    while !tokens.isEof(t) {
        if level == 0 && (tokens.is(t, names.P_COMMA) || tokens.is(t, names.P_RPAREN)) {
            if count < 3 { base.putWord(ends + count * 8, t) }
            count += 1
            if tokens.is(t, names.P_RPAREN) { break }
            if count >= 3 { tokens.errorAt(token, "the overflow builtins take three arguments") }
            base.putWord(starts + count * 8, tokens.next(t))
        }
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) { level -= 1 }
        t = tokens.next(t)
    }
    if count != 3 { tokens.errorAt(token, "the overflow builtins take three arguments") }
    const close = t
    var a = tokensText(base.getWord(starts), base.getWord(ends))
    var b = tokensText(base.getWord(starts + 8), base.getWord(ends + 8))
    const operandType = typed.1
    if operandType.length != 0 {
        // `__builtin_uaddll_overflow`: the operands as its type first.
        a = base.join(base.join(base.join("( ", operandType), " ) ( "), base.join(a, ")"))
        b = base.join(base.join(base.join("( ", operandType), " ) ( "), base.join(b, ")"))
    }
    const r = tokensText(base.getWord(starts + 16), close)
    var made = base.join("( { __typeof__ ( * ( ", base.join(r, ") ) * __mlxcc_ovp = ( "))
    made = base.join(made, base.join(r, ") ; _BitInt ( 130 ) __mlxcc_ovw = ( _BitInt ( 130 ) ) ( "))
    made = base.join(made, base.join(a, base.join(") ", base.join(op, " ( _BitInt ( 130 ) ) ( "))))
    made = base.join(made, base.join(b, ") ; * __mlxcc_ovp = ( __typeof__ ( * __mlxcc_ovp ) ) __mlxcc_ovw ; __mlxcc_ovw != ( _BitInt ( 130 ) ) * __mlxcc_ovp ; } )"))
    const list = cpp.generatedTokens(made)
    // The list's end joined to what follows the call.
    var last = list
    while !tokens.isEof(tokens.next(last)) { last = tokens.next(last) }
    tokens.at(last).*.next = tokens.next(close)
    cursor.restore(list)
    return castExpression()
}

// The tokens from `first` up to `end` (not included) as text.
fn tokensText(first: usize, end: usize) -> []const u8 {
    var text: []const u8 = ""
    var t = first
    while t != 0 && t != end && !tokens.isEof(t) {
        text = base.join(text, base.join(tokens.text(t), " "))
        t = tokens.next(t)
    }
    return text
}

fn genericSelection(start: usize) -> usize {
    cursor.expect(names.P_LPAREN)
    const control = assign()
    typing.addType(control)
    var t1 = ast.typeOf(control)
    if types.kind(t1) == types.FUNC { t1 = types.pointerTo(t1) }
    if types.kind(t1) == types.ARRAY { t1 = types.pointerTo(types.baseOf(t1)) }
    var chosen: usize = 0
    var fallback: usize = 0
    while !cursor.consume(names.P_RPAREN) {
        cursor.expect(names.P_COMMA)
        if cursor.consume(names.K_DEFAULT) {
            cursor.expect(names.P_COLON)
            fallback = assign()
        } else {
            const t2 = decl.typeName()
            cursor.expect(names.P_COLON)
            const n = assign()
            if types.compatible(t1, t2) && chosen == 0 { chosen = n }
        }
    }
    if chosen == 0 { chosen = fallback }
    if chosen == 0 { tokens.errorAt(start, "controlling expression type not compatible with any generic association type") }
    return chosen
}

// __builtin_offsetof(type, member.member[index]...)
fn offsetOf(token: usize) -> usize {
    cursor.expect(names.P_LPAREN)
    var ty = decl.typeName()
    cursor.expect(names.P_COMMA)
    var offset: i64 = 0
    var expectName = true
    while !cursor.consume(names.P_RPAREN) {
        if expectName || cursor.consume(names.P_DOT) {
            expectName = false
            const nameToken = cursor.expectIdent()
            if standard.cpp { cpp.completeIfNeeded(ty) }
            const found = types.findMember(ty, tokens.name(nameToken))
            if found.0 == 0 { tokens.errorAt(nameToken, "no such member") }
            offset += found.1
            ty = types.member(found.0).*.ty
        } else {
            cursor.expect(names.P_LBRACKET)
            const index = eval.constExpression()
            cursor.expect(names.P_RBRACKET)
            offset += index * types.size(types.baseOf(ty))
            ty = types.baseOf(ty)
        }
    }
    return ulongNumber(offset, token)
}

fn sizeOfType(ty: usize, token: usize) -> usize {
    const t = types.referenced(ty)
    if standard.cpp { cpp.completeIfNeeded(t) }
    if types.at(t).*.incomplete {
        // (SFINAE: `void_t<decltype(sizeof(T))>` for an incomplete T.)
        if decl.sfinae { return softFailure(token) }
        tokens.errorAt(token, "invalid application of sizeof to an incomplete type")
    }
    return ulongNumber(types.size(t), token)
}

fn primary() -> usize {
    const token = cursor.peek()
    const kind = tokens.kind(token)
    if cursor.is(names.P_LPAREN) && cursor.isToken(cursor.peekNext(), names.P_LBRACE) {
        // A GNU statement expression.
        cursor.advance()
        cursor.advance()
        const n = ast.make(ast.STMT_EXPR, token)
        const block = stmt.compoundStatement()
        ast.node(n).*.body = ast.node(block).*.body
        cursor.expect(names.P_RPAREN)
        return n
    }
    if standard.cpp && cursor.is(names.P_LPAREN) && foldAhead() { return foldExpression(token) }
    if cursor.consume(names.P_LPAREN) {
        const outer = inTemplateArguments
        inTemplateArguments = false
        const n = expression()
        inTemplateArguments = outer
        cursor.expect(names.P_RPAREN)
        return n
    }
    if cursor.consume(names.K_SIZEOF) {
        if standard.cpp && cursor.consume(names.P_ELLIPSIS) {
            // `sizeof...(Args)`: the number of elements of the pack.
            cursor.expect(names.P_LPAREN)
            const packName = cursor.expectIdent()
            cursor.expect(names.P_RPAREN)
            var binding = scope.find(tokens.name(packName))
            // (A function parameter pack in a constraint: its type's.)
            if binding == 0 || scope.at(binding).*.kind != scope.PACK { binding = template.constraintParameterPack(tokens.name(packName)) }
            if binding == 0 || scope.at(binding).*.kind != scope.PACK { tokens.errorAt(packName, "not a parameter pack") }
            return ulongNumber(types.packCount(scope.at(binding).*.obj), token)
        }
        if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) {
            const start = cursor.save()
            cursor.advance()
            const ty = decl.typeName()
            cursor.expect(names.P_RPAREN)
            if !cursor.is(names.P_LBRACE) { return sizeOfType(ty, token) }
            cursor.restore(start)
        }
        unevaluated += 1
        const n = unary()
        typing.addType(n)
        unevaluated -= 1
        return sizeOfType(ast.typeOf(n), token)
    }
    if cursor.consume(names.K_ALIGNOF) || cursor.consume(names.K_GNU2_ALIGNOF) {
        if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) {
            cursor.advance()
            const ty = decl.typeName()
            cursor.expect(names.P_RPAREN)
            return ulongNumber(types.alignOf(ty), token)
        }
        const n = unary()
        typing.addType(n)
        return ulongNumber(types.alignOf(ast.typeOf(n)), token)
    }
    if cursor.consume(names.K_NULLPTR) {
        // C23's nullptr: a null pointer of type void *; C++'s, of type
        // std::nullptr_t.
        const zero = ast.number(0, token)
        ast.node(zero).*.ty = types.intOf()
        return typing.cast(zero, if standard.cpp { types.nullptrOf() } else { types.pointerTo(types.voidOf()) })
    }
    if cursor.consume(names.K_TRUE) || cursor.consume(names.K_FALSE) {
        // C23's true and false, of type bool.
        const n = ast.number(if tokens.name(token) == names.K_TRUE { 1 } else { 0 }, token)
        ast.node(n).*.ty = types.boolOf()
        return n
    }
    if cursor.consume(names.K_GENERIC) { return genericSelection(token) }
    if standard.cpp {
        if cursor.is(names.P_LBRACKET) { return lambda.expression(token) }
        if cursor.consume(names.K_THIS) {
            const captured = lambda.thisKeyword(token)
            if captured != 0 { return captured }
            return cpp.thisPointer(token)
        }
        if cursor.is(names.K_STATIC_CAST) || cursor.is(names.K_REINTERPRET_CAST) || cursor.is(names.K_CONST_CAST) || cursor.is(names.K_DYNAMIC_CAST) {
            // `static_cast<T>(e)` and the others: a cast.
            cursor.advance()
            cursor.expect(names.P_LT)
            const ty = decl.typeName()
            cursor.expect(names.P_GT)
            cursor.expect(names.P_LPAREN)
            const operand = expression()
            cursor.expect(names.P_RPAREN)
            return castTo(operand, ty)
        }
        if cursor.is(names.K_TYPEID) { tokens.errorAt(token, "typeid is not supported") }
        if cursor.is(names.K_REQUIRES) { return requiresExpression(token) }
        if cursor.consume(names.K_NOEXCEPT) {
            // `noexcept(e)`: true (nothing throws here).
            cursor.expect(names.P_LPAREN)
            unevaluated += 1
            const ignored = expression()
            unevaluated -= 1
            cursor.expect(names.P_RPAREN)
            const n = ast.number(1, token)
            ast.node(n).*.ty = types.boolOf()
            return n
        }
        if (kind == tokens.KEYWORD || kind == tokens.IDENT || cursor.is(names.P_SCOPE)) && decl.isTypename(token) && !decl.decltypeQualifies() && !cursor.is(names.K_STRUCT) && !cursor.is(names.K_CLASS) && !cursor.is(names.K_UNION) && !cursor.is(names.K_ENUM) {
            // `T(args)`, `T{args}`: a temporary of a class, a conversion.
            const start = cursor.save()
            var ty = decl.declspec(0)
            // `std::span { first, last }`: the class from the deduction
            // guides.
            if ty == cpp.deducedMarker() && (cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACE)) { ty = cpp.deducedClass(token) }
            // `T{a, {b}}`: as `T x{a, {b}}` makes it (nested braces,
            // initializer lists, aggregates).
            if cursor.is(names.P_LBRACE) && cpp.isClassType(ty) { return cpp.bracedTemporary(ty, token) }
            if cursor.is(names.P_LPAREN) || (cursor.is(names.P_LBRACE) && (cpp.isClassType(ty) || types.isScalar(ty))) {
                const closer: u32 = if cursor.is(names.P_LPAREN) { names.P_RPAREN } else { names.P_RBRACE }
                cursor.advance()
                const args = cpp.readArguments(closer)
                return cpp.functionalCast(ty, args.0, args.1, token)
            }
            cursor.restore(start)
        }
    }
    if cursor.consume(names.K_GNU_BUILTIN_OFFSETOF) { return offsetOf(token) }
    if cursor.consume(names.K_GNU_BUILTIN_VA_START) {
        cursor.expect(names.P_LPAREN)
        const list = assign()
        cursor.expect(names.P_COMMA)
        const last = assign()
        cursor.expect(names.P_RPAREN)
        typing.addType(list)
        const n = ast.unary(ast.VA_START, list, token)
        ast.node(n).*.ty = types.voidOf()
        return n
    }
    if cursor.consume(names.K_GNU_BUILTIN_VA_END) {
        cursor.expect(names.P_LPAREN)
        const list = assign()
        cursor.expect(names.P_RPAREN)
        return typing.cast(list, types.voidOf())
    }
    if cursor.consume(names.K_GNU_BUILTIN_VA_ARG) {
        cursor.expect(names.P_LPAREN)
        const list = assign()
        cursor.expect(names.P_COMMA)
        const ty = decl.typeName()
        cursor.expect(names.P_RPAREN)
        // The argument's address, read through.
        typing.addType(list)
        const n = ast.unary(ast.VA_ARG, list, token)
        ast.node(n).*.ty = types.pointerTo(ty)
        return ast.unary(ast.DEREF, n, token)
    }
    if cursor.consume(names.K_GNU_BUILTIN_VA_COPY) {
        cursor.expect(names.P_LPAREN)
        const target = assign()
        cursor.expect(names.P_COMMA)
        const source = assign()
        cursor.expect(names.P_RPAREN)
        return ast.binary(ast.ASSIGN, ast.unary(ast.DEREF, target, token), ast.unary(ast.DEREF, source, token), token)
    }
    if standard.cpp && kind == tokens.IDENT && isTypeTrait(tokens.name(token)) && cursor.isToken(cursor.peekNext(), names.P_LPAREN) {
        return typeTrait(token)
    }
    if kind == tokens.IDENT && cursor.isToken(cursor.peekNext(), names.P_LPAREN) && atomics.isBuiltin(tokens.name(token)) && scope.find(tokens.name(token)) == 0 {
        return atomics.builtin(token)
    }
    if kind == tokens.IDENT && cursor.isToken(cursor.peekNext(), names.P_LPAREN) && builtins.isBitBuiltin(tokens.name(token)) && scope.find(tokens.name(token)) == 0 {
        return builtins.bitBuiltin(token)
    }
    if cursor.is(names.K_ASM) || cursor.is(names.K_GNU2_ASM) { return builtins.asmExpression(token) }
    if standard.cpp && kind == tokens.IDENT && base.same(tokens.text(token), "__mlxcc_defaulted") { return cpp.defaultedComparison(token) }
    if standard.cpp && kind == tokens.IDENT && base.same(tokens.text(token), "__mlxcc_memberwise_assign") {
        cursor.advance()
        return cpp.memberwiseAssignment(token)
    }
    if kind == tokens.IDENT && cursor.isToken(cursor.peekNext(), names.P_LPAREN) && base.same(tokens.text(token), "__builtin_bit_cast") {
        cursor.advance()
        cursor.advance()
        const to = decl.typeName()
        cursor.expect(names.P_COMMA)
        const operand = assign()
        cursor.expect(names.P_RPAREN)
        typing.addType(operand)
        const from = types.unqualified(types.referenced(ast.typeOf(operand)))
        if types.size(to) != types.size(from) { tokens.errorAt(token, "__builtin_bit_cast needs types of one size") }
        if !isBitScalar(to) || !isBitScalar(from) { tokens.errorAt(token, "__builtin_bit_cast of a class or an array is not supported") }
        const n = ast.unary(ast.BITCAST, operand, token)
        ast.node(n).*.ty = types.unqualified(to)
        return n
    }
    if kind == tokens.IDENT && cursor.isToken(cursor.peekNext(), names.P_LPAREN) && scope.find(tokens.name(token)) == 0 && isOverflowBuiltin(tokens.text(token)) {
        return overflowBuiltin(token)
    }
    if kind == tokens.IDENT || (standard.cpp && (cursor.is(names.P_SCOPE) || cursor.is(names.K_OPERATOR) || decl.decltypeQualifies())) {
        var binding: usize = 0
        var nameToken = token
        if standard.cpp && decl.startsQualified() {
            // A qualified name: N::x, ::x, N::operator+, vector<int>::npos.
            const read = decl.qualifier()
            // `X<U>::template f<T>(...)`: the keyword says f is a template.
            const marked = cursor.consume(names.K_TEMPLATE)
            nameToken = if cursor.is(names.K_OPERATOR) { cpp.operatorNameToken() } else { cursor.expectIdent() }
            // (Unqualified after all: `E::X`, E an unscoped enum in sight.)
            binding = if read.1 { scope.findQualified(read.0, tokens.name(nameToken), false) } else { scope.find(tokens.name(nameToken)) }
            if binding == 0 && read.1 && cpp.classWithPrefix(read.0) != 0 {
                // (A class instance not completed yet: `HT::f(...)` in a
                // member of an iterator defined late.)
                const completed = cpp.completeIfNeeded(cpp.classWithPrefix(read.0))
                binding = scope.findQualified(read.0, tokens.name(nameToken), false)
            }
            if binding == 0 { binding = cpp.findInherited(read.0, tokens.name(nameToken), false) }
            if binding == 0 && cpp.classWithPrefix(read.0) != 0 && findMember(cpp.classWithPrefix(read.0), tokens.name(nameToken)) != 0 {
                // `sizeof(C::member)`: a data member named by its class
                // where nothing is evaluated; `base::s` in a member
                // function: this object's (as a base's).
                const classTy = cpp.classWithPrefix(read.0)
                const thisBinding = scope.find(names.K_THIS)
                if thisBinding != 0 && scope.at(thisBinding).*.kind == scope.VARIABLE && unevaluated == 0 {
                    const self = cpp.thisPointer(nameToken)
                    return structReference(ast.unary(ast.DEREF, typing.cast(self, types.pointerTo(classTy)), nameToken), nameToken)
                }
                if unevaluated > 0 { return structReference(cpp.nullObject(classTy, nameToken), nameToken) }
            }
            if binding == 0 && (!read.1 || read.0 == 0) {
                const implicit = cpp.implicitAllocation(tokens.name(nameToken), nameToken)
                if implicit != 0 { return implicit }
            }
            if binding == 0 && decl.sfinae {
                // Not there: the instance being read is not viable.
                decl.sfinaeFailed = true
                return ast.number(0, nameToken)
            }
            if binding == 0 { tokens.errorAt(nameToken, "no such name in the namespace") }
        } else if standard.cpp && cursor.is(names.K_OPERATOR) {
            // `operator new(n)`: the operator function by its name.
            nameToken = cpp.operatorNameToken()
            binding = scope.find(tokens.name(nameToken))
            if binding == 0 {
                const implicit = cpp.implicitAllocation(tokens.name(nameToken), nameToken)
                if implicit != 0 { return implicit }
            }
        } else {
            cursor.advance()
            binding = scope.find(tokens.name(token))
        }
        if standard.cpp && (binding == 0 || scope.at(binding).*.depth == 0) && nameToken == token && !boundInsideClass(binding) {
            // In a member function the class's members come before the
            // names of the namespaces around; in a lambda the function's
            // locals and the enclosing class's members are captured.
            const member = cpp.memberAccess(nameToken)
            if member != 0 { return member }
            const captured = lambda.captured(nameToken)
            if captured != 0 { return captured }
            // A static member or enumerator of a base of a class around
            // (`s_refCountFlagIsStaticString` of StringImpl in a nested
            // class of SymbolImpl).
            if binding == 0 { binding = cpp.inheritedValue(tokens.name(nameToken)) }
        }
        if standard.cpp && binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isFunction && cursor.is(names.P_LT) {
            // `f<int>(...)` where functions named f were declared after
            // the template f: the template (only it takes arguments).
            var b = scope.at(binding).*.hidden
            while b != 0 && scope.at(b).*.depth == scope.at(binding).*.depth && scope.at(b).*.name == scope.at(binding).*.name {
                if scope.at(b).*.kind == scope.TEMPLATE && template.isFunctionTemplate(b) {
                    binding = b
                    break
                }
                b = scope.at(b).*.hidden
            }
        }
        if binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE {
            // A function template: with its arguments given, the instance;
            // else the call's arguments choose it (among the functions of
            // the name too).
            if template.isVariableTemplate(binding) {
                cursor.restore(nameToken)
                return template.variableInstance(binding, nameToken)
            }
            if !template.isFunctionTemplate(binding) && interp.trace {
                const plainB = scope.find(tokens.name(nameToken))
                tokens.warnAt(nameToken, base.join(if plainB == 0 { "no plain binding" } else if scope.at(plainB).*.kind == scope.TEMPLATE { "plain is a template" } else { "plain is another kind" }, if template.guidesOf(scope.findKind(tokens.name(nameToken), scope.TEMPLATE)) != 0 { ", guides" } else { ", no guides" }))
            }
            if !template.isFunctionTemplate(binding) { tokens.errorAt(nameToken, "a class template is not a value") }
            if cursor.is(names.P_LT) {
                // `f<int>(...)`: the rest of the arguments deduced by the
                // call; `f<int>` alone: the instance. (The `<` as the
                // cursor has it: the name may be a copy, without a next.)
                const after = template.endOfArguments(cursor.peek())
                if after != 0 && tokens.is(after, names.P_LPAREN) {
                    return ast.variableNode(template.explicitPlaceholder(binding), nameToken)
                }
                const instance = template.explicitFunction(binding)
                return variableValue(instance, nameToken)
            }
            const callable = cpp.callableFor(binding, nameToken)
            // (`B::f(...)`: B's f itself, not through the vtable.)
            if nameToken != token && callable != 0 && ast.kindOf(callable) == ast.VAR { ast.node(callable).*.value = 1 }
            if nameToken == token { unqualifiedCallee = callable }
            return callable
        }
        if binding != 0 && scope.at(binding).*.kind == scope.PACK && scope.at(binding).*.ty != 0 && valuePack(scope.at(binding).*.obj) {
            // A pack of values (`Is` of `size_t... Is`): the element being
            // expanded, or the first (noted, for the expansion to come).
            const holder = scope.at(binding).*.obj
            var index = scope.packIndex
            if index < 0 {
                scope.packSeen = holder
                index = 0
            }
            if types.packCount(holder) == 0 { return ast.number(0, token) }
            var cell = types.packArguments(holder)
            var i: i64 = 0
            while cell != 0 && i < index {
                cell = base.getWord(cell + 24)
                i += 1
            }
            if cell == 0 { tokens.errorAt(nameToken, "the pack has no such element") }
            return longNumber(@bitCast(i64, base.getWord(cell + 16)), nameToken)
        }
        if binding != 0 && scope.at(binding).*.kind == scope.PACK && scope.at(binding).*.ty == 0 {
            // A pack of parameters (`args`): the element being expanded,
            // or the first (noted, for the expansion to come).
            const holder = scope.at(binding).*.obj
            var index = scope.packIndex
            if index < 0 {
                scope.packSeen = holder
                index = 0
            }
            if types.packCount(holder) == 0 { return ast.number(0, token) }
            const element = types.packVariableAt(holder, index)
            if element == 0 { tokens.errorAt(nameToken, "the pack has no such element") }
            ast.obj(element).*.isReferenced = true
            return variableValue(element, nameToken)
        }
        if binding != 0 {
            const b = scope.at(binding)
            if b.*.kind == scope.VARIABLE {
                ast.obj(b.*.obj).*.isReferenced = true
                // (`C::f(...)` with a member template f beside a
                // non-static f: the template's too.)
                if standard.cpp && ast.obj(b.*.obj).*.isFunction && (nameToken == token || ast.obj(b.*.obj).*.classType == 0 || ast.obj(b.*.obj).*.isStaticMember || cpp.hasTemplateOfName(binding)) {
                    // The functions and templates of the name together
                    // (`std::to_chars(...)` too).
                    const callable = cpp.callableFor(binding, nameToken)
                    if callable != 0 && nameToken != token && ast.kindOf(callable) == ast.VAR && ast.obj(b.*.obj).*.classType != 0 { ast.node(callable).*.value = 1 }
                    if nameToken == token { unqualifiedCallee = callable }
                    if callable != 0 { return callable }
                }
                const n = variableValue(b.*.obj, nameToken)
                // `S::f(...)` calls f itself, not through the vtable.
                if nameToken != token && ast.kindOf(n) == ast.VAR { ast.node(n).*.value = 1 }
                return n
            }
            if b.*.kind == scope.ENUM_CONSTANT {
                // An enumerator is an int in C, of its enum in C++; a
                // constexpr integer (C23) keeps its declared type.
                const n = ast.number(b.*.value, token)
                ast.node(n).*.ty = if types.kind(b.*.ty) == types.ENUM && !standard.cpp { types.intOf() } else { b.*.ty }
                return n
            }
        }
        if cursor.is(names.P_LPAREN) && nameToken == token {
            // `__builtin_sqrt(x)` and its kind: libm's function.
            const math = builtins.mathBuiltin(tokens.name(token), token)
            if math != 0 { return math }
        }
        if standard.cpp && cursor.is(names.P_LPAREN) && nameToken == token {
            // C++: a function the arguments' namespaces hold (argument-
            // dependent lookup: `is_eq(ordering)` is std's).
            cursor.advance()
            const MAX_ARGS: usize = 256
            const mark = base.scratchMark()
            const read = base.scratch(MAX_ARGS * 8)
            const count = argumentList(names.P_RPAREN, read, MAX_ARGS)
            const given = base.keptWords(read, count)
            base.releaseScratch(mark)
            const callee = cpp.argumentDependent(tokens.name(token), given, count, token)
            if callee == 0 {
                if decl.sfinae { return softFailure(token) }
                tokens.errorAt(token, base.join(base.join("undeclared function '", base.nameOf(tokens.name(token))), "'"))
            }
            return buildCall(callee, given, count, token)
        }
        if cursor.is(names.P_LPAREN) {
            // An implicit declaration (C89): `int name()`.
            tokens.warnAt(token, base.join(base.join("implicit declaration of function '", base.nameOf(tokens.name(token))), "'"))
            const fnType = types.functionReturning(types.intOf())
            types.at(fnType).*.oldStyle = true
            const o = ast.newObj(tokens.name(token), fnType, token)
            ast.obj(o).*.isFunction = true
            ast.obj(o).*.isReferenced = true
            state.addGlobal(o)
            const bound = scope.bindVariable(tokens.name(token), o)
            return ast.variableNode(o, token)
        }
        if standard.cpp && unevaluated > 0 && nameToken == token {
            // A data member of the class being read, named for its type
            // (`sizeof(m_bits)` in a static member's initializer).
            var m = decl.partialMembers
            while m != 0 {
                if types.member(m).*.name == tokens.name(token) {
                    const stand = ast.newObj(tokens.name(token), types.member(m).*.ty, token)
                    return ast.variableNode(stand, token)
                }
                m = types.member(m).*.next
            }
        }
        tokens.errorAt(nameToken, base.join(base.join("undeclared identifier '", base.nameOf(tokens.name(nameToken))), "'"))
    }
    if kind == tokens.STRING {
        cursor.advance()
        const o = decl.stringLiteral(token)
        return ast.variableNode(o, token)
    }
    if kind == tokens.INTEGER || kind == tokens.FLOATING {
        cursor.advance()
        const n = ast.number(@bitCast(i64, tokens.at(token).*.value), token)
        ast.node(n).*.ty = tokens.at(token).*.ty
        ast.node(n).*.extra = tokens.at(token).*.data
        return n
    }
    tokens.errorAt(token, "expected an expression")
    return 0
}
