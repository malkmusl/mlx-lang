// Expressions (C11 6.5), by precedence from the comma operator down to
// the primary expressions. Pointer arithmetic is scaled here; compound
// assignments and increments become plain assignments through a
// temporary pointer, so code generation knows only `=`.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const decl = @import("./decl.mlx")
const stmt = @import("./stmt.mlx")
const eval = @import("./eval.mlx")
const initializer = @import("./initializer.mlx")

fn longNumber(value: i64, token: usize) -> usize {
    const n = ast.number(value, token)
    ast.node(n).*.ty = types.longOf()
    return n
}

fn ulongNumber(value: i64, token: usize) -> usize {
    const n = ast.number(value, token)
    ast.node(n).*.ty = types.ulongOf()
    return n
}

fn isPointer(n: usize) -> bool {
    return types.baseOf(ast.typeOf(n)) != 0 && types.kind(ast.typeOf(n)) != types.FUNC
}

// `lhs + rhs` with pointer arithmetic: an integer added to a pointer
// counts elements.
pub fn newAdd(lhs: usize, rhs: usize, token: usize) -> usize {
    typing.addType(lhs)
    typing.addType(rhs)
    const lp = isPointer(lhs)
    const rp = isPointer(rhs)
    if !lp && !rp { return ast.binary(ast.ADD, lhs, rhs, token) }
    if lp && rp { tokens.errorAt(token, "invalid operands") }
    var pointer = lhs
    var count = rhs
    if !lp {
        pointer = rhs
        count = lhs
    }
    if types.isWide(ast.typeOf(count)) { count = typing.cast(count, types.longOf()) }
    const element = types.size(types.baseOf(ast.typeOf(pointer)))
    const scaled = ast.binary(ast.MUL, count, longNumber(element, token), token)
    return ast.binary(ast.ADD, pointer, scaled, token)
}

pub fn newSub(lhs: usize, rhs: usize, token: usize) -> usize {
    typing.addType(lhs)
    typing.addType(rhs)
    const lp = isPointer(lhs)
    const rp = isPointer(rhs)
    if !lp && !rp { return ast.binary(ast.SUB, lhs, rhs, token) }
    if lp && !rp {
        const element = types.size(types.baseOf(ast.typeOf(lhs)))
        const count = if types.isWide(ast.typeOf(rhs)) { typing.cast(rhs, types.longOf()) } else { rhs }
        const scaled = ast.binary(ast.MUL, count, longNumber(element, token), token)
        typing.addType(scaled)
        const n = ast.binary(ast.SUB, lhs, scaled, token)
        ast.node(n).*.ty = ast.typeOf(lhs)
        return n
    }
    if lp && rp {
        // The distance in elements.
        const difference = ast.binary(ast.SUB, lhs, rhs, token)
        ast.node(difference).*.ty = types.longOf()
        const element = types.size(types.baseOf(ast.typeOf(lhs)))
        return ast.binary(ast.DIV, difference, longNumber(if element == 0 { 1 } else { element }, token), token)
    }
    tokens.errorAt(token, "invalid operands")
    return 0
}

// A temporary local (no name) of type `ty`.
fn temporary(ty: usize, token: usize) -> usize {
    return decl.newLocal(0, ty, token)
}

// `A op= B` as `tmp = &A, *tmp = *tmp op B` (for a member: `tmp = &S,
// tmp->m = tmp->m op B`, so a bit-field stays one).
pub fn toAssign(binary: usize) -> usize {
    const b = ast.node(binary)
    typing.addType(b.*.lhs)
    typing.addType(b.*.rhs)
    const token = b.*.token
    const lhs = b.*.lhs
    if ast.kindOf(lhs) == ast.MEMBER {
        const holder = ast.node(lhs).*.lhs
        const tmp = temporary(types.pointerTo(ast.typeOf(holder)), token)
        const first = ast.binary(ast.ASSIGN, ast.variableNode(tmp, token), ast.unary(ast.ADDR, holder, token), token)
        const target = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, ast.variableNode(tmp, token), token), token)
        ast.node(target).*.member = ast.node(lhs).*.member
        const source = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, ast.variableNode(tmp, token), token), token)
        ast.node(source).*.member = ast.node(lhs).*.member
        const second = ast.binary(ast.ASSIGN, target, ast.binary(b.*.kind, source, b.*.rhs, token), token)
        return ast.binary(ast.COMMA, first, second, token)
    }
    const tmp = temporary(types.pointerTo(ast.typeOf(lhs)), token)
    const first = ast.binary(ast.ASSIGN, ast.variableNode(tmp, token), ast.unary(ast.ADDR, lhs, token), token)
    const target = ast.unary(ast.DEREF, ast.variableNode(tmp, token), token)
    const source = ast.unary(ast.DEREF, ast.variableNode(tmp, token), token)
    const second = ast.binary(ast.ASSIGN, target, ast.binary(b.*.kind, source, b.*.rhs, token), token)
    return ast.binary(ast.COMMA, first, second, token)
}

// `A++` as `(typeof A)((A += 1) - 1)`.
fn incrementAfter(n: usize, addend: i64, token: usize) -> usize {
    typing.addType(n)
    const ty = ast.typeOf(n)
    const assigned = toAssign(newAdd(n, ast.number(addend, token), token))
    return typing.cast(newAdd(assigned, ast.number(0 - addend, token), token), ty)
}

pub fn expression() -> usize {
    const n = assign()
    if cursor.is(names.P_COMMA) {
        const token = cursor.peek()
        cursor.advance()
        return ast.binary(ast.COMMA, n, expression(), token)
    }
    return n
}

pub fn assign() -> usize {
    const n = conditional()
    const token = cursor.peek()
    if cursor.consume(names.P_ASSIGN) { return ast.binary(ast.ASSIGN, n, assign(), token) }
    if cursor.consume(names.P_ADD_ASSIGN) { return toAssign(newAdd(n, assign(), token)) }
    if cursor.consume(names.P_SUB_ASSIGN) { return toAssign(newSub(n, assign(), token)) }
    if cursor.consume(names.P_MUL_ASSIGN) { return toAssign(ast.binary(ast.MUL, n, assign(), token)) }
    if cursor.consume(names.P_DIV_ASSIGN) { return toAssign(ast.binary(ast.DIV, n, assign(), token)) }
    if cursor.consume(names.P_MOD_ASSIGN) { return toAssign(ast.binary(ast.MOD, n, assign(), token)) }
    if cursor.consume(names.P_AND_ASSIGN) { return toAssign(ast.binary(ast.BITAND, n, assign(), token)) }
    if cursor.consume(names.P_OR_ASSIGN) { return toAssign(ast.binary(ast.BITOR, n, assign(), token)) }
    if cursor.consume(names.P_XOR_ASSIGN) { return toAssign(ast.binary(ast.BITXOR, n, assign(), token)) }
    if cursor.consume(names.P_SHL_ASSIGN) { return toAssign(ast.binary(ast.SHL, n, assign(), token)) }
    if cursor.consume(names.P_SHR_ASSIGN) { return toAssign(ast.binary(ast.SHR, n, assign(), token)) }
    return n
}

pub fn conditional() -> usize {
    const condition = logicalOr()
    const token = cursor.peek()
    if !cursor.consume(names.P_QUESTION) { return condition }
    if cursor.consume(names.P_COLON) {
        // GNU `a ?: b`: `(tmp = a) ? tmp : b`.
        typing.addType(condition)
        const tmp = temporary(ast.typeOf(condition), token)
        const n = ast.make(ast.COND, token)
        ast.node(n).*.cond = ast.binary(ast.ASSIGN, ast.variableNode(tmp, token), condition, token)
        ast.node(n).*.then = ast.variableNode(tmp, token)
        ast.node(n).*.els = conditional()
        return n
    }
    const n = ast.make(ast.COND, token)
    ast.node(n).*.cond = condition
    ast.node(n).*.then = expression()
    cursor.expect(names.P_COLON)
    ast.node(n).*.els = conditional()
    return n
}

fn logicalOr() -> usize {
    var n = logicalAnd()
    while cursor.is(names.P_OROR) {
        const token = cursor.peek()
        cursor.advance()
        n = ast.binary(ast.LOGOR, n, logicalAnd(), token)
    }
    return n
}

fn logicalAnd() -> usize {
    var n = bitOr()
    while cursor.is(names.P_ANDAND) {
        const token = cursor.peek()
        cursor.advance()
        n = ast.binary(ast.LOGAND, n, bitOr(), token)
    }
    return n
}

fn bitOr() -> usize {
    var n = bitXor()
    while cursor.is(names.P_PIPE) {
        const token = cursor.peek()
        cursor.advance()
        n = ast.binary(ast.BITOR, n, bitXor(), token)
    }
    return n
}

fn bitXor() -> usize {
    var n = bitAnd()
    while cursor.is(names.P_CARET) {
        const token = cursor.peek()
        cursor.advance()
        n = ast.binary(ast.BITXOR, n, bitAnd(), token)
    }
    return n
}

fn bitAnd() -> usize {
    var n = equality()
    while cursor.is(names.P_AMP) {
        const token = cursor.peek()
        cursor.advance()
        n = ast.binary(ast.BITAND, n, equality(), token)
    }
    return n
}

fn equality() -> usize {
    var n = relational()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_EQ) {
            n = ast.binary(ast.EQ, n, relational(), token)
        } else if cursor.consume(names.P_NE) {
            n = ast.binary(ast.NE, n, relational(), token)
        } else {
            return n
        }
    }
    return n
}

fn relational() -> usize {
    var n = shift()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_LT) {
            n = ast.binary(ast.LT, n, shift(), token)
        } else if cursor.consume(names.P_LE) {
            n = ast.binary(ast.LE, n, shift(), token)
        } else if cursor.consume(names.P_GT) {
            n = ast.binary(ast.LT, shift(), n, token)
        } else if cursor.consume(names.P_GE) {
            n = ast.binary(ast.LE, shift(), n, token)
        } else {
            return n
        }
    }
    return n
}

fn shift() -> usize {
    var n = additive()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_SHL) {
            n = ast.binary(ast.SHL, n, additive(), token)
        } else if cursor.consume(names.P_SHR) {
            n = ast.binary(ast.SHR, n, additive(), token)
        } else {
            return n
        }
    }
    return n
}

fn additive() -> usize {
    var n = multiplicative()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_PLUS) {
            n = newAdd(n, multiplicative(), token)
        } else if cursor.consume(names.P_MINUS) {
            n = newSub(n, multiplicative(), token)
        } else {
            return n
        }
    }
    return n
}

fn multiplicative() -> usize {
    var n = castExpression()
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_STAR) {
            n = ast.binary(ast.MUL, n, castExpression(), token)
        } else if cursor.consume(names.P_SLASH) {
            n = ast.binary(ast.DIV, n, castExpression(), token)
        } else if cursor.consume(names.P_PERCENT) {
            n = ast.binary(ast.MOD, n, castExpression(), token)
        } else {
            return n
        }
    }
    return n
}

pub fn castExpression() -> usize {
    if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) {
        const start = cursor.save()
        cursor.advance()
        const ty = decl.typeName()
        cursor.expect(names.P_RPAREN)
        if cursor.is(names.P_LBRACE) {
            // A compound literal.
            cursor.restore(start)
            return unary()
        }
        const n = typing.cast(castExpression(), ty)
        ast.node(n).*.token = start
        return n
    }
    return unary()
}

fn unary() -> usize {
    const token = cursor.peek()
    if cursor.consume(names.P_PLUS) { return castExpression() }
    if cursor.consume(names.P_MINUS) { return ast.unary(ast.NEG, castExpression(), token) }
    if cursor.consume(names.P_AMP) {
        const operand = castExpression()
        typing.addType(operand)
        if ast.kindOf(operand) == ast.MEMBER && types.member(ast.node(operand).*.member).*.bitWidth != 0 {
            tokens.errorAt(token, "cannot take the address of a bit-field")
        }
        return ast.unary(ast.ADDR, operand, token)
    }
    if cursor.consume(names.P_STAR) {
        // `*f` of a function is the function (C11 6.5.3.2).
        const operand = castExpression()
        typing.addType(operand)
        if types.kind(ast.typeOf(operand)) == types.FUNC { return operand }
        return ast.unary(ast.DEREF, operand, token)
    }
    if cursor.consume(names.P_BANG) { return ast.unary(ast.NOT, castExpression(), token) }
    if cursor.consume(names.P_TILDE) { return ast.unary(ast.BITNOT, castExpression(), token) }
    if cursor.consume(names.P_INC) { return toAssign(newAdd(unary(), ast.number(1, token), token)) }
    if cursor.consume(names.P_DEC) { return toAssign(newSub(unary(), ast.number(1, token), token)) }
    if cursor.consume(names.K_GNU2_EXTENSION) { return castExpression() }
    return postfix()
}

// The member `name` of a struct or union type, searching anonymous
// members: the member found at this level (an anonymous one holds it).
pub fn findMember(ty: usize, name: u32) -> usize {
    var m = types.at(ty).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        if types.member(m).*.name == 0 && (types.kind(mt) == types.STRUCT || types.kind(mt) == types.UNION) {
            if findMember(mt, name) != 0 { return m }
        } else if types.member(m).*.name == name {
            return m
        }
        m = types.member(m).*.next
    }
    return 0
}

fn structReference(operand: usize, nameToken: usize) -> usize {
    typing.addType(operand)
    var ty = ast.typeOf(operand)
    if types.kind(ty) != types.STRUCT && types.kind(ty) != types.UNION { tokens.errorAt(nameToken, "not a struct nor a union") }
    if types.at(ty).*.incomplete { tokens.errorAt(nameToken, "incomplete struct or union") }
    var n = operand
    while true {
        const m = findMember(ty, tokens.name(nameToken))
        if m == 0 { tokens.errorAt(nameToken, "no such member") }
        n = ast.unary(ast.MEMBER, n, nameToken)
        ast.node(n).*.member = m
        if types.member(m).*.name != 0 { break }
        ty = types.member(m).*.ty
    }
    return n
}

fn compoundLiteral(ty: usize, token: usize) -> usize {
    if scope.isFileScope() {
        const o = decl.newAnonymousGlobal(ty, token)
        initializer.globalInitializer(o)
        return ast.variableNode(o, token)
    }
    const local = decl.newLocal(0, ty, token)
    const init = initializer.localInitializer(local)
    return ast.binary(ast.COMMA, init, ast.variableNode(local, token), token)
}

fn postfix() -> usize {
    var n: usize = 0
    if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) {
        const token = cursor.peek()
        cursor.advance()
        const ty = decl.typeName()
        cursor.expect(names.P_RPAREN)
        n = compoundLiteral(ty, token)
    } else {
        n = primary()
    }
    while true {
        const token = cursor.peek()
        if cursor.consume(names.P_LPAREN) {
            n = functionCall(n, token)
        } else if cursor.consume(names.P_LBRACKET) {
            const index = expression()
            cursor.expect(names.P_RBRACKET)
            n = ast.unary(ast.DEREF, newAdd(n, index, token), token)
        } else if cursor.consume(names.P_DOT) {
            n = structReference(n, cursor.expectIdent())
        } else if cursor.consume(names.P_ARROW) {
            n = structReference(ast.unary(ast.DEREF, n, token), cursor.expectIdent())
        } else if cursor.consume(names.P_INC) {
            n = incrementAfter(n, 1, token)
        } else if cursor.consume(names.P_DEC) {
            n = incrementAfter(n, -1, token)
        } else {
            return n
        }
    }
    return n
}

// A call of `callee`, after its `(`.
fn functionCall(callee: usize, token: usize) -> usize {
    typing.addType(callee)
    var fnType = ast.typeOf(callee)
    if types.kind(fnType) == types.PTR && types.kind(types.baseOf(fnType)) == types.FUNC { fnType = types.baseOf(fnType) }
    if types.kind(fnType) != types.FUNC { tokens.errorAt(token, "not a function") }
    var p = types.at(fnType).*.params
    var head: usize = 0
    var tail: usize = 0
    var first = true
    while !cursor.consume(names.P_RPAREN) {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        var argument = assign()
        typing.addType(argument)
        const at = ast.typeOf(argument)
        if p != 0 {
            const pt = types.param(p).*.ty
            if types.kind(pt) != types.STRUCT && types.kind(pt) != types.UNION { argument = typing.cast(argument, pt) }
            p = types.param(p).*.next
        } else {
            // The default argument promotions (C11 6.5.2.2): float to
            // double, narrow integers to int; arrays and functions decay.
            if types.kind(at) == types.FLOAT {
                argument = typing.cast(argument, types.doubleOf())
            } else if types.isInteger(at) && types.size(at) < 4 {
                argument = typing.cast(argument, types.intOf())
            } else if types.kind(at) == types.ARRAY {
                argument = typing.cast(argument, types.pointerTo(types.baseOf(at)))
            } else if types.kind(at) == types.FUNC {
                argument = typing.cast(argument, types.pointerTo(at))
            }
        }
        if head == 0 { head = argument } else { ast.node(tail).*.next = argument }
        tail = argument
    }
    if p != 0 { tokens.errorAt(token, "too few arguments") }
    const n = ast.make(ast.FUNCALL, token)
    ast.node(n).*.lhs = callee
    ast.node(n).*.funcType = fnType
    ast.node(n).*.ty = types.baseOf(fnType)
    ast.node(n).*.args = head
    // A struct, union or wide integer result comes back through a
    // buffer of the caller's.
    const rt = types.baseOf(fnType)
    if (types.kind(rt) == types.STRUCT || types.kind(rt) == types.UNION || types.isWide(rt)) && state.currentFunction() != 0 {
        ast.node(n).*.returnBuffer = temporary(rt, token)
    }
    return n
}

fn genericSelection(start: usize) -> usize {
    cursor.expect(names.P_LPAREN)
    const control = assign()
    typing.addType(control)
    var t1 = ast.typeOf(control)
    if types.kind(t1) == types.FUNC { t1 = types.pointerTo(t1) }
    if types.kind(t1) == types.ARRAY { t1 = types.pointerTo(types.baseOf(t1)) }
    var chosen: usize = 0
    var fallback: usize = 0
    while !cursor.consume(names.P_RPAREN) {
        cursor.expect(names.P_COMMA)
        if cursor.consume(names.K_DEFAULT) {
            cursor.expect(names.P_COLON)
            fallback = assign()
        } else {
            const t2 = decl.typeName()
            cursor.expect(names.P_COLON)
            const n = assign()
            if types.compatible(t1, t2) && chosen == 0 { chosen = n }
        }
    }
    if chosen == 0 { chosen = fallback }
    if chosen == 0 { tokens.errorAt(start, "controlling expression type not compatible with any generic association type") }
    return chosen
}

// __builtin_offsetof(type, member.member[index]...)
fn offsetOf(token: usize) -> usize {
    cursor.expect(names.P_LPAREN)
    var ty = decl.typeName()
    cursor.expect(names.P_COMMA)
    var offset: i64 = 0
    var expectName = true
    while !cursor.consume(names.P_RPAREN) {
        if expectName || cursor.consume(names.P_DOT) {
            expectName = false
            const nameToken = cursor.expectIdent()
            const found = types.findMember(ty, tokens.name(nameToken))
            if found.0 == 0 { tokens.errorAt(nameToken, "no such member") }
            offset += found.1
            ty = types.member(found.0).*.ty
        } else {
            cursor.expect(names.P_LBRACKET)
            const index = eval.constExpression()
            cursor.expect(names.P_RBRACKET)
            offset += index * types.size(types.baseOf(ty))
            ty = types.baseOf(ty)
        }
    }
    return ulongNumber(offset, token)
}

fn sizeOfType(ty: usize, token: usize) -> usize {
    if types.at(ty).*.incomplete { tokens.errorAt(token, "invalid application of sizeof to an incomplete type") }
    return ulongNumber(types.size(ty), token)
}

fn primary() -> usize {
    const token = cursor.peek()
    const kind = tokens.kind(token)
    if cursor.is(names.P_LPAREN) && cursor.isToken(cursor.peekNext(), names.P_LBRACE) {
        // A GNU statement expression.
        cursor.advance()
        cursor.advance()
        const n = ast.make(ast.STMT_EXPR, token)
        const block = stmt.compoundStatement()
        ast.node(n).*.body = ast.node(block).*.body
        cursor.expect(names.P_RPAREN)
        return n
    }
    if cursor.consume(names.P_LPAREN) {
        const n = expression()
        cursor.expect(names.P_RPAREN)
        return n
    }
    if cursor.consume(names.K_SIZEOF) {
        if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) {
            const start = cursor.save()
            cursor.advance()
            const ty = decl.typeName()
            cursor.expect(names.P_RPAREN)
            if !cursor.is(names.P_LBRACE) { return sizeOfType(ty, token) }
            cursor.restore(start)
        }
        const n = unary()
        typing.addType(n)
        return sizeOfType(ast.typeOf(n), token)
    }
    if cursor.consume(names.K_ALIGNOF) || cursor.consume(names.K_GNU2_ALIGNOF) {
        if cursor.is(names.P_LPAREN) && decl.isTypename(cursor.peekNext()) {
            cursor.advance()
            const ty = decl.typeName()
            cursor.expect(names.P_RPAREN)
            return ulongNumber(types.alignOf(ty), token)
        }
        const n = unary()
        typing.addType(n)
        return ulongNumber(types.alignOf(ast.typeOf(n)), token)
    }
    if cursor.consume(names.K_NULLPTR) {
        // C23's nullptr: a null pointer of type void *.
        const zero = ast.number(0, token)
        ast.node(zero).*.ty = types.intOf()
        return typing.cast(zero, types.pointerTo(types.voidOf()))
    }
    if cursor.consume(names.K_TRUE) || cursor.consume(names.K_FALSE) {
        // C23's true and false, of type bool.
        const n = ast.number(if tokens.name(token) == names.K_TRUE { 1 } else { 0 }, token)
        ast.node(n).*.ty = types.boolOf()
        return n
    }
    if cursor.consume(names.K_GENERIC) { return genericSelection(token) }
    if cursor.consume(names.K_GNU_BUILTIN_OFFSETOF) { return offsetOf(token) }
    if cursor.consume(names.K_GNU_BUILTIN_VA_START) {
        cursor.expect(names.P_LPAREN)
        const list = assign()
        cursor.expect(names.P_COMMA)
        const last = assign()
        cursor.expect(names.P_RPAREN)
        typing.addType(list)
        const n = ast.unary(ast.VA_START, list, token)
        ast.node(n).*.ty = types.voidOf()
        return n
    }
    if cursor.consume(names.K_GNU_BUILTIN_VA_END) {
        cursor.expect(names.P_LPAREN)
        const list = assign()
        cursor.expect(names.P_RPAREN)
        return typing.cast(list, types.voidOf())
    }
    if cursor.consume(names.K_GNU_BUILTIN_VA_ARG) {
        cursor.expect(names.P_LPAREN)
        const list = assign()
        cursor.expect(names.P_COMMA)
        const ty = decl.typeName()
        cursor.expect(names.P_RPAREN)
        // The argument's address, read through.
        typing.addType(list)
        const n = ast.unary(ast.VA_ARG, list, token)
        ast.node(n).*.ty = types.pointerTo(ty)
        return ast.unary(ast.DEREF, n, token)
    }
    if cursor.consume(names.K_GNU_BUILTIN_VA_COPY) {
        cursor.expect(names.P_LPAREN)
        const target = assign()
        cursor.expect(names.P_COMMA)
        const source = assign()
        cursor.expect(names.P_RPAREN)
        return ast.binary(ast.ASSIGN, ast.unary(ast.DEREF, target, token), ast.unary(ast.DEREF, source, token), token)
    }
    if kind == tokens.IDENT {
        cursor.advance()
        const binding = scope.find(tokens.name(token))
        if binding != 0 {
            const b = scope.at(binding)
            if b.*.kind == scope.VARIABLE {
                ast.obj(b.*.obj).*.isReferenced = true
                return ast.variableNode(b.*.obj, token)
            }
            if b.*.kind == scope.ENUM_CONSTANT {
                // An enumerator is an int; a constexpr integer (C23)
                // keeps its declared type.
                const n = ast.number(b.*.value, token)
                ast.node(n).*.ty = if types.kind(b.*.ty) == types.ENUM { types.intOf() } else { b.*.ty }
                return n
            }
        }
        if cursor.is(names.P_LPAREN) {
            // An implicit declaration (C89): `int name()`.
            tokens.warnAt(token, base.join(base.join("implicit declaration of function '", base.nameOf(tokens.name(token))), "'"))
            const fnType = types.functionReturning(types.intOf())
            types.at(fnType).*.oldStyle = true
            const o = ast.newObj(tokens.name(token), fnType, token)
            ast.obj(o).*.isFunction = true
            ast.obj(o).*.isReferenced = true
            state.addGlobal(o)
            const bound = scope.bindVariable(tokens.name(token), o)
            return ast.variableNode(o, token)
        }
        tokens.errorAt(token, base.join(base.join("undeclared identifier '", base.nameOf(tokens.name(token))), "'"))
    }
    if kind == tokens.STRING {
        cursor.advance()
        const o = decl.stringLiteral(token)
        return ast.variableNode(o, token)
    }
    if kind == tokens.INTEGER || kind == tokens.FLOATING {
        cursor.advance()
        const n = ast.number(@bitCast(i64, tokens.at(token).*.value), token)
        ast.node(n).*.ty = tokens.at(token).*.ty
        ast.node(n).*.extra = tokens.at(token).*.data
        return n
    }
    tokens.errorAt(token, "expected an expression")
    return 0
}
