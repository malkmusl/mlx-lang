// The preprocessor (C11 6.10): the directives and the macro expansion of
// what is not a directive, over the token list of a file. #include splices
// the included file's tokens in where the directive was; a group whose
// condition is false is skipped to its #elif, #else or #endif.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const lexer = @import("./lexer.mlx")
const macros = @import("./macros.mlx")
const ppexpr = @import("./ppexpr.mlx")
const paths = @import("./paths.mlx")

// An open conditional: where it began, whether a branch of it was taken,
// and whether #else came.
const Condition = struct {
    token: usize
    taken: bool
    sawElse: bool
    next: usize
}

// Includes in all (a file that includes itself without a guard ends here).
const MAX_DEPTH: u32 = 100000

// #embed's parameters.
var limitName: u32 = 0
var limitName2: u32 = 0
var prefixName: u32 = 0
var prefixName2: u32 = 0
var suffixName: u32 = 0
var suffixName2: u32 = 0
var ifEmptyName: u32 = 0
var ifEmptyName2: u32 = 0
var commaText: usize = 0

var conditions: usize = 0
// The files #pragma once marked (their names), a list of u32 in the arena.
var onceFiles: usize = 0
var onceCount: usize = 0
var includeDepth: u32 = 0

pub fn init() -> void {
    paths.init()
    limitName = base.intern("limit")
    limitName2 = base.intern("__limit__")
    prefixName = base.intern("prefix")
    prefixName2 = base.intern("__prefix__")
    suffixName = base.intern("suffix")
    suffixName2 = base.intern("__suffix__")
    ifEmptyName = base.intern("if_empty")
    ifEmptyName2 = base.intern("__if_empty__")
    commaText = base.keep(",")
    onceFiles = base.alloc(base.MAX_FILES * 4)
    startUnit()
}

// A translation unit starts with no macros but the built-in ones and no
// file marked #pragma once.
pub fn startUnit() -> void {
    macros.init()
    conditions = 0
    onceCount = 0
    includeDepth = 0
    macros.defineBuiltin(names.D_FILE_MACRO, macros.BUILTIN_FILE)
    macros.defineBuiltin(names.D_LINE_MACRO, macros.BUILTIN_LINE)
    macros.defineBuiltin(names.D_COUNTER, macros.BUILTIN_COUNTER)
    macros.defineBuiltin(names.D_DATE, macros.BUILTIN_DATE)
    macros.defineBuiltin(names.D_TIME, macros.BUILTIN_TIME)
    macros.defineBuiltin(names.D_BASE_FILE, macros.BUILTIN_FILE)
}

fn conditionAt(address: usize) -> *Condition {
    unsafe { return @ptrFromInt(*Condition, address) }
}

// The first token of the line after `token`'s.
fn skipLine(token: usize) -> usize {
    var at = token
    while !tokens.atLineStart(at) { at = tokens.next(at) }
    return at
}

// The rest of `token`'s line as a list ending in EOF, and the first token
// of the next line.
fn lineOf(token: usize) -> (usize, usize) {
    var head: usize = 0
    var tail: usize = 0
    var at = token
    while !tokens.atLineStart(at) {
        const copy = tokens.copy(at)
        if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
        tail = copy
        at = tokens.next(at)
    }
    const end = tokens.eof(@intCast(u32, tokens.at(token).*.file), tokens.at(token).*.line)
    if head == 0 { return -> (end, at) }
    tokens.at(tail).*.next = end
    return -> (head, at)
}

// Warns about extra tokens before the end of the line; the next line.
fn endOfLine(token: usize) -> usize {
    if !tokens.atLineStart(token) { tokens.warnAt(token, "extra tokens at the end of the directive") }
    return skipLine(token)
}

fn isDirective(token: usize) -> bool {
    return tokens.is(token, names.P_HASH) && tokens.atLineStart(token)
}

// Skips a false group: the token that ends it (the # of its #elif, #else
// or #endif at this depth).
fn skipGroup(token: usize) -> usize {
    var at = token
    var depth: usize = 0
    while !tokens.isEof(at) {
        if isDirective(at) {
            const word = tokens.next(at)
            if tokens.is(word, names.K_IF) || tokens.is(word, names.D_IFDEF) || tokens.is(word, names.D_IFNDEF) {
                depth += 1
            } else if tokens.is(word, names.D_ENDIF) {
                if depth == 0 { return at }
                depth -= 1
            } else if depth == 0 && (tokens.is(word, names.D_ELIF) || tokens.is(word, names.D_ELIFDEF) || tokens.is(word, names.D_ELIFNDEF) || tokens.is(word, names.K_ELSE)) {
                return at
            }
        }
        at = tokens.next(at)
    }
    return at
}

fn pushCondition(token: usize, taken: bool) -> void {
    const condition = base.alloc(@sizeOf(Condition))
    conditionAt(condition).*.token = token
    conditionAt(condition).*.taken = taken
    conditionAt(condition).*.next = conditions
    conditions = condition
}

// #include's operand on `token`'s line: the name, whether it was quoted,
// and the next line.
// includeName's other results: whether the name was quoted, and the
// first token of the next line. (A three-part tuple holding a slice came
// back with its last part lost: a gap of the Mlx compiler.)
var includeQuoted = false
var includeRest: usize = 0

fn includeName(token: usize) -> []const u8 {
    if tokens.kind(token) == tokens.STRING && !tokens.atLineStart(token) {
        const text = tokens.text(token)
        includeQuoted = true
        includeRest = endOfLine(tokens.next(token))
        return text[1..text.length - 1]
    }
    if tokens.is(token, names.P_LT) && !tokens.atLineStart(token) {
        var at = tokens.next(token)
        const start = tokens.at(at).*.start
        var stop = start
        while !tokens.is(at, names.P_GT) {
            if tokens.atLineStart(at) { tokens.errorAt(token, "expected '>' after the file name") }
            stop = tokens.at(at).*.start + @intCast(usize, tokens.at(at).*.length)
            at = tokens.next(at)
        }
        includeQuoted = false
        includeRest = endOfLine(tokens.next(at))
        return base.bytes(start, stop - start)
    }
    // A computed include: the macros of the line, then one of the forms.
    const line = lineOf(token)
    const expanded = macros.expandAll(line.0)
    if tokens.kind(expanded) == tokens.STRING {
        const text = tokens.text(expanded)
        includeQuoted = true
        includeRest = line.1
        return text[1..text.length - 1]
    }
    if tokens.is(expanded, names.P_LT) {
        var length: usize = 0
        var at = tokens.next(expanded)
        while !tokens.is(at, names.P_GT) && !tokens.isEof(at) {
            length += @intCast(usize, tokens.at(at).*.length)
            at = tokens.next(at)
        }
        const text = base.alloc(length + 1)
        var written: usize = 0
        at = tokens.next(expanded)
        while !tokens.is(at, names.P_GT) && !tokens.isEof(at) {
            base.putText(text + written, tokens.text(at))
            written += @intCast(usize, tokens.at(at).*.length)
            at = tokens.next(at)
        }
        includeQuoted = false
        includeRest = line.1
        return base.bytes(text, written)
    }
    tokens.errorAt(token, "expected \"file\" or <file>")
    includeQuoted = false
    includeRest = line.1
    return ""
}

fn markedOnce(name: u32) -> bool {
    var index: usize = 0
    while index < onceCount {
        if base.get32(onceFiles + index * 4) == name { return true }
        index += 1
    }
    return false
}

// The tokens of the file `path` (0 when it was marked #pragma once),
// followed by `rest`.
fn includeFile(directive: usize, path: []const u8, rest: usize) -> usize {
    if markedOnce(base.intern(path)) { return rest }
    if includeDepth > MAX_DEPTH { tokens.errorAt(directive, "too many #include (a file including itself?)") }
    const file = base.readFile(path)
    if file == 0 { tokens.errorAt(directive, "cannot read the included file") }
    const list = lexer.tokenize(file)
    return macros.append(list, rest)
}

// #embed's resource at `token`: "file" or <file>; the name, with
// includeQuoted set, and includeRest the token after it (the parameters).
fn embedName(token: usize) -> []const u8 {
    if tokens.kind(token) == tokens.STRING && !tokens.atLineStart(token) {
        const text = tokens.text(token)
        includeQuoted = true
        includeRest = tokens.next(token)
        return text[1..text.length - 1]
    }
    if tokens.is(token, names.P_LT) && !tokens.atLineStart(token) {
        var at = tokens.next(token)
        const start = tokens.at(at).*.start
        var stop = start
        while !tokens.is(at, names.P_GT) {
            if tokens.atLineStart(at) { tokens.errorAt(token, "expected '>' after the file name") }
            stop = tokens.at(at).*.start + @intCast(usize, tokens.at(at).*.length)
            at = tokens.next(at)
        }
        includeQuoted = false
        includeRest = tokens.next(at)
        return base.bytes(start, stop - start)
    }
    tokens.errorAt(token, "expected \"file\" or <file> after #embed")
    return ""
}

// Appends plain copies of `list` (ending in EOF) to the list `head`/`tail`
// (addresses of the two variables); the new tail.
fn appendCopies(list: usize, head: *usize, tail: *usize) -> void {
    var at = list
    while !tokens.isEof(at) {
        const copy = tokens.copy(at)
        if head.* == 0 { head.* = copy } else { tokens.at(tail.*).*.next = copy }
        tail.* = copy
        at = tokens.next(at)
    }
}

fn appendOne(token: usize, head: *usize, tail: *usize) -> void {
    if head.* == 0 { head.* = token } else { tokens.at(tail.*).*.next = token }
    tail.* = token
}

// #embed (C23 6.10.3.2): the bytes of the resource as integer constants
// separated by commas, with its parameters limit(N), prefix(...),
// suffix(...) and if_empty(...); where preprocessing goes on.
fn embedResource(hash: usize, rest: usize) -> usize {
    const file = @intCast(u32, tokens.at(hash).*.file)
    const line = tokens.at(hash).*.line
    const name = embedName(rest)
    const quoted = includeQuoted
    var at = includeRest
    var limit: i64 = -1
    var prefix: usize = 0
    var suffix: usize = 0
    var ifEmpty: usize = 0
    while !tokens.atLineStart(at) {
        if tokens.kind(at) != tokens.IDENT { tokens.errorAt(at, "expected an #embed parameter (limit, prefix, suffix, if_empty)") }
        const parameter = tokens.name(at)
        at = tokens.next(at)
        if !tokens.is(at, names.P_LPAREN) || tokens.atLineStart(at) { tokens.errorAt(at, "expected '(' after the #embed parameter") }
        at = tokens.next(at)
        var head: usize = 0
        var tail: usize = 0
        var level: u32 = 1
        while true {
            if tokens.atLineStart(at) { tokens.errorAt(hash, "unterminated #embed parameter") }
            if tokens.is(at, names.P_LPAREN) { level += 1 }
            if tokens.is(at, names.P_RPAREN) {
                level -= 1
                if level == 0 { break }
            }
            appendOne(tokens.copy(at), &head, &tail)
            at = tokens.next(at)
        }
        at = tokens.next(at)
        appendOne(tokens.eof(file, line), &head, &tail)
        if parameter == limitName || parameter == limitName2 {
            limit = ppexpr.evaluate(head)
            if limit < 0 { tokens.errorAt(hash, "#embed limit must not be negative") }
        } else if parameter == prefixName || parameter == prefixName2 {
            prefix = head
        } else if parameter == suffixName || parameter == suffixName2 {
            suffix = head
        } else if parameter == ifEmptyName || parameter == ifEmptyName2 {
            ifEmpty = head
        } else {
            tokens.errorAt(hash, "unknown #embed parameter")
        }
    }
    const from = base.nameOf(base.fileName(file))
    const path = paths.find(name, quoted, from, 0)
    if path.length == 0 {
        base.say(base.nameOf(base.fileName(file)))
        base.say(": cannot find ")
        base.say(name)
        base.say("\n")
        tokens.errorAt(hash, "#embed failed")
    }
    const resource = base.readFile(path)
    if resource == 0 { tokens.errorAt(hash, "cannot read the embedded file") }
    const data = base.fileData(resource)
    var length = base.fileLength(resource)
    if limit >= 0 && @intCast(usize, limit) < length { length = @intCast(usize, limit) }
    var head: usize = 0
    var tail: usize = 0
    if length == 0 {
        if ifEmpty != 0 { appendCopies(ifEmpty, &head, &tail) }
    } else {
        if prefix != 0 { appendCopies(prefix, &head, &tail) }
        var index: usize = 0
        while index < length {
            if index > 0 {
                const comma = tokens.make(tokens.PUNCT, file, line, commaText, 1)
                tokens.at(comma).*.name = names.P_COMMA
                appendOne(comma, &head, &tail)
            }
            const digits = base.decimal(@intCast(u64, base.get8(data + index)))
            const number = tokens.make(tokens.NUMBER, file, line, base.keep(digits), digits.length)
            tokens.at(number).*.flags = tokens.SPACE_BEFORE
            appendOne(number, &head, &tail)
            index += 1
        }
        if suffix != 0 { appendCopies(suffix, &head, &tail) }
    }
    if head == 0 { return at }
    tokens.at(tail).*.next = at
    return head
}

// #define on `token` (the macro's name); the next line.
fn defineMacro(token: usize) -> usize {
    if tokens.kind(token) != tokens.IDENT || tokens.atLineStart(token) { tokens.errorAt(token, "#define needs a macro name") }
    const name = tokens.name(token)
    var at = tokens.next(token)
    // A function-like macro has its ( right after the name.
    const functionLike = tokens.is(at, names.P_LPAREN) && !tokens.atLineStart(at) && tokens.at(at).*.flags & tokens.SPACE_BEFORE == 0
    const macro = macros.define(name, functionLike)
    if functionLike {
        at = tokens.next(at)
        const params = base.alloc(256 * 4)
        var count: u32 = 0
        var variadic = false
        while !tokens.is(at, names.P_RPAREN) {
            if count > 0 {
                if !tokens.is(at, names.P_COMMA) { tokens.errorAt(at, "expected ',' between macro parameters") }
                at = tokens.next(at)
            }
            if tokens.is(at, names.P_ELLIPSIS) {
                base.put32(params + @intCast(usize, count) * 4, names.D_VA_ARGS)
                count += 1
                variadic = true
                at = tokens.next(at)
                if !tokens.is(at, names.P_RPAREN) { tokens.errorAt(at, "'...' must be the last macro parameter") }
                break
            }
            if tokens.kind(at) != tokens.IDENT || tokens.atLineStart(at) { tokens.errorAt(at, "expected a macro parameter") }
            base.put32(params + @intCast(usize, count) * 4, tokens.name(at))
            count += 1
            at = tokens.next(at)
            // GNU's named variadic parameter: args...
            if tokens.is(at, names.P_ELLIPSIS) {
                variadic = true
                at = tokens.next(at)
                if !tokens.is(at, names.P_RPAREN) { tokens.errorAt(at, "'...' must be the last macro parameter") }
            }
        }
        at = tokens.next(at)
        macros.setParams(macro, params, count, variadic)
    }
    const body = lineOf(at)
    macros.setBody(macro, body.0)
    return body.1
}

// Runs the preprocessor over `list` (ending in EOF): the tokens left.
pub fn run(list: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var at = list
    while !tokens.isEof(at) {
        const expanded = macros.expand(at)
        if expanded != 0 {
            at = expanded
            continue
        }
        if !isDirective(at) {
            if head == 0 { head = at } else { tokens.at(tail).*.next = at }
            tail = at
            at = tokens.next(at)
            continue
        }
        at = directive(at)
    }
    if conditions != 0 { tokens.errorAt(conditionAt(conditions).*.token, "unterminated conditional directive") }
    if head == 0 { return at }
    tokens.at(tail).*.next = at
    return head
}

// The directive whose # is `hash`; where preprocessing goes on.
fn directive(hash: usize) -> usize {
    const word = tokens.next(hash)
    // The null directive: a # alone on its line.
    if tokens.atLineStart(word) { return word }
    const rest = tokens.next(word)
    if tokens.is(word, names.D_INCLUDE) || tokens.is(word, names.D_INCLUDE_NEXT) {
        const operandName = includeName(rest)
        const operandQuoted = includeQuoted
        const operandRest = includeRest
        const from = base.nameOf(base.fileName(@intCast(u32, tokens.at(hash).*.file)))
        var after: usize = 0
        if tokens.is(word, names.D_INCLUDE_NEXT) { after = paths.dirIndexOf(from) }
        const path = paths.find(operandName, operandQuoted, from, after)
        if path.length == 0 {
            base.say(base.nameOf(base.fileName(@intCast(u32, tokens.at(hash).*.file))))
            base.say(": cannot find ")
            base.say(operandName)
            base.say("\n")
            tokens.errorAt(hash, "#include failed")
        }
        includeDepth += 1
        return includeFile(hash, path, operandRest)
    }
    if tokens.is(word, names.D_EMBED) { return embedResource(hash, rest) }
    if tokens.is(word, names.D_DEFINE) { return defineMacro(rest) }
    if tokens.is(word, names.D_UNDEF) {
        if tokens.kind(rest) != tokens.IDENT || tokens.atLineStart(rest) { tokens.errorAt(word, "#undef needs a macro name") }
        macros.undefine(tokens.name(rest))
        return endOfLine(tokens.next(rest))
    }
    if tokens.is(word, names.K_IF) {
        const line = lineOf(rest)
        const value = ppexpr.evaluate(line.0)
        pushCondition(hash, value != 0)
        if value == 0 { return skipGroup(line.1) }
        return line.1
    }
    if tokens.is(word, names.D_IFDEF) || tokens.is(word, names.D_IFNDEF) {
        if tokens.kind(rest) != tokens.IDENT || tokens.atLineStart(rest) { tokens.errorAt(word, "expected a macro name") }
        var defined = macros.isDefined(tokens.name(rest))
        if tokens.is(word, names.D_IFNDEF) { defined = !defined }
        pushCondition(hash, defined)
        const next = endOfLine(tokens.next(rest))
        if !defined { return skipGroup(next) }
        return next
    }
    if tokens.is(word, names.D_ELIF) {
        if conditions == 0 || conditionAt(conditions).*.sawElse { tokens.errorAt(hash, "#elif without #if") }
        const c = conditionAt(conditions)
        const line = lineOf(rest)
        if c.*.taken { return skipGroup(line.1) }
        const value = ppexpr.evaluate(line.0)
        if value == 0 { return skipGroup(line.1) }
        c.*.taken = true
        return line.1
    }
    if tokens.is(word, names.D_ELIFDEF) || tokens.is(word, names.D_ELIFNDEF) {
        // #elifdef and #elifndef (C23).
        if conditions == 0 || conditionAt(conditions).*.sawElse { tokens.errorAt(hash, "#elifdef without #if") }
        const c = conditionAt(conditions)
        if tokens.kind(rest) != tokens.IDENT || tokens.atLineStart(rest) { tokens.errorAt(word, "expected a macro name") }
        const next = endOfLine(tokens.next(rest))
        if c.*.taken { return skipGroup(next) }
        var defined = macros.isDefined(tokens.name(rest))
        if tokens.is(word, names.D_ELIFNDEF) { defined = !defined }
        if !defined { return skipGroup(next) }
        c.*.taken = true
        return next
    }
    if tokens.is(word, names.K_ELSE) {
        if conditions == 0 || conditionAt(conditions).*.sawElse { tokens.errorAt(hash, "#else without #if") }
        const c = conditionAt(conditions)
        c.*.sawElse = true
        const next = endOfLine(rest)
        if c.*.taken { return skipGroup(next) }
        c.*.taken = true
        return next
    }
    if tokens.is(word, names.D_ENDIF) {
        if conditions == 0 { tokens.errorAt(hash, "#endif without #if") }
        conditions = conditionAt(conditions).*.next
        return endOfLine(rest)
    }
    if tokens.is(word, names.D_ERROR) {
        tokens.errorAt(hash, "#error")
    }
    if tokens.is(word, names.D_WARNING) {
        tokens.warnAt(hash, "#warning")
        return skipLine(rest)
    }
    if tokens.is(word, names.D_PRAGMA) {
        if tokens.is(rest, names.D_ONCE) {
            if onceCount < base.MAX_FILES {
                base.put32(onceFiles + onceCount * 4, base.fileName(@intCast(u32, tokens.at(hash).*.file)))
                onceCount += 1
            }
        }
        return skipLine(rest)
    }
    if tokens.is(word, names.D_LINE) || tokens.kind(word) == tokens.NUMBER {
        return skipLine(rest)
    }
    // GNU's #ident and #sccs and the like carry nothing for us.
    tokens.errorAt(word, "unknown preprocessing directive")
    return rest
}

// Defines the macros of a text (`#define` lines): the predefined macros
// and the command line's -D and -U.
pub fn defineFrom(name: []const u8, text: []const u8) -> void {
    const file = base.textFile(name, text)
    const left = run(lexer.tokenize(file))
    if !tokens.isEof(left) { tokens.errorAt(left, "the predefined text left tokens") }
}

// The preprocessed tokens of `file`.
pub fn processFile(file: u32) -> usize {
    return run(lexer.tokenize(file))
}
