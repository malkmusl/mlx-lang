// C++ lambdas: `[captures](params) -> R { body }` is an object of a
// closure class the compiler makes (`__lambda#N_HASH`, HASH the file's,
// in the current namespace) whose data members are the captures and whose
// `operator()` is the body, read as a member function while the
// function around is put aside (template.beginContext). A capture by
// copy is a member of the variable's type, made from the variable
// where the lambda is written; a capture by reference is a reference
// member (read as the variable itself); a
// captured `this` is the pointer `__this`, through which the names of
// the enclosing class resolve. `[=]` and `[&]` capture what the body
// uses, as it uses it. The result type is the `-> R` given, else the
// first return's type, else void.
//
// A generic lambda (`auto` parameters) has a member template as its
// operator(). Not here: a lambda converting to a function pointer,
// init-captures (`[x = 1]`), nested lambdas
// capturing through an enclosing one, `mutable` (ignored: nothing is
// const).
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")
const decl = @import("./decl.mlx")
const cpp = @import("./cpp.mlx")
const template = @import("./template.mlx")

// A lambda being read: its closure class, how it captures what the
// body names (0 none, 1 by copy, 2 by reference), its captures (cells
// of (local object, member, byReference, next)), the captured `this`
// (the enclosing function's, a local) and its member, the one around.
const Lambda = struct {
    ty: usize
    mode: u8
    captures: usize
    capturesTail: usize
    enclosingThis: usize
    thisMember: usize
    capturesThis: bool
    outer: usize
    // The lambdas made, in a chain (ofClass).
    made: usize
}

fn at(l: usize) -> *Lambda {
    unsafe { return @ptrFromInt(*Lambda, l) }
}

pub var current: usize = 0
var count: u32 = 0
var allMade: usize = 0

// The lambda whose closure class is `classTy` (0: none): its call
// operator's body (a generic one's instance too) is read in it.
pub fn ofClass(classTy: usize) -> usize {
    if classTy == 0 { return 0 }
    var l = allMade
    while l != 0 {
        if at(l).*.ty == classTy { return l }
        l = at(l).*.made
    }
    return 0
}
var thisName: u32 = 0
var callName: u32 = 0
var invokeName: u32 = 0
var conversionName: u32 = 0

pub fn init() -> void {
    thisName = base.intern("__this")
    callName = base.intern("operator()")
    invokeName = base.intern("__mlxcc_invoke")
    conversionName = base.intern("operator@__mlxcc_fp")
}

fn newCell(o: usize, m: usize, byReference: bool) -> usize {
    const c = base.alloc(32)
    base.putWord(c, o)
    base.putWord(c + 8, m)
    base.putWord(c + 16, if byReference { 1 } else { 0 })
    return c
}

fn addCapture(l: usize, o: usize, m: usize, byReference: bool) -> void {
    const c = newCell(o, m, byReference)
    if at(l).*.captures == 0 { at(l).*.captures = c } else { base.putWord(at(l).*.capturesTail + 24, c) }
    at(l).*.capturesTail = c
}

// Captures the local `o` (found as a binding of the function around):
// the member, made now.
fn capture(l: usize, o: usize, byReference: bool, token: usize) -> usize {
    return captureNamed(l, o, ast.obj(o).*.name, byReference, token)
}

fn captureNamed(l: usize, o: usize, name: u32, byReference: bool, token: usize) -> usize {
    var found = at(l).*.captures
    while found != 0 {
        if base.getWord(found) == o { return base.getWord(found + 8) }
        found = base.getWord(found + 24)
    }
    var ty = ast.obj(o).*.ty
    // A reference parameter is captured as the object it refers to.
    if types.isReference(ty) { ty = types.baseOf(ty) }
    const memberTy = if byReference { types.referenceTo(ty) } else { ty }
    const m = cpp.addMember(at(l).*.ty, name, memberTy, token)
    addCapture(l, o, m, byReference)
    return m
}

fn capturesObject(l: usize, o: usize) -> bool {
    var c = at(l).*.captures
    while c != 0 {
        if base.getWord(c) == o && base.getWord(c + 16) < 2 { return true }
        c = base.getWord(c + 24)
    }
    return false
}

fn captureThis(l: usize, token: usize) -> usize {
    if at(l).*.thisMember != 0 { return at(l).*.thisMember }
    if at(l).*.enclosingThis == 0 { tokens.errorAt(token, "no 'this' to capture here") }
    at(l).*.thisMember = cpp.addMember(at(l).*.ty, thisName, ast.obj(at(l).*.enclosingThis).*.ty, token)
    return at(l).*.thisMember
}

// The class's `this` in lambda `l`'s body (its own closure's at
// `closure`): its captured one, or, in a lambda in a lambda, the outer
// closure's through the captured pointer to it.
fn classThisVia(l: usize, closure: usize, token: usize) -> usize {
    const m = captureThis(l, token)
    const n = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, closure, token), token)
    ast.node(n).*.member = m
    typing.addType(n)
    if inLambdaBody(l) { return classThisVia(at(l).*.outer, n, token) }
    return n
}

// Whether lambda `l` is in the body of another that has a `this` to
// give (its own `this` is that closure's).
fn inLambdaBody(l: usize) -> bool {
    return at(l).*.outer != 0 && at(at(l).*.outer).*.enclosingThis != 0
}

// The `this` of the member function around the lambdas `l` is in.
fn rootThis(l: usize) -> usize {
    var x = l
    while inLambdaBody(x) { x = at(x).*.outer }
    return at(x).*.enclosingThis
}

// `this->member` in the closure's operator() (a reference member as
// the variable it refers to).
fn ownMember(m: usize, token: usize) -> usize {
    const n = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, cpp.thisPointer(token), token), token)
    ast.node(n).*.member = m
    typing.addType(n)
    if types.isReference(types.member(m).*.ty) { return typing.dereferenced(n) }
    return n
}

// A name the body of the lambda being read uses that is no name of
// its own: a local of the function around (captured now when the
// lambda captures implicitly), or a member of the enclosing class
// through the captured `this`; 0 for none.
pub fn captured(nameToken: usize) -> usize {
    if current == 0 { return instanceCaptured(nameToken) }
    const l = current
    const name = tokens.name(nameToken)
    // An init-capture's name: its member.
    var ic = at(l).*.captures
    while ic != 0 {
        if base.getWord(ic + 16) >= 2 && types.member(base.getWord(ic + 8)).*.name == name { return ownMember(base.getWord(ic + 8), nameToken) }
        ic = base.getWord(ic + 24)
    }
    const binding = scope.findSuspended(name)
    if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && !ast.obj(scope.at(binding).*.obj).*.isFunction {
        const o = scope.at(binding).*.obj
        if !ast.obj(o).*.isLocal { return expr.variableValue(o, nameToken) }
        // (A const local, `constexpr double minLoadRatio`, is read
        // without a capture: copied in.)
        const readOnly = types.isConst(ast.obj(o).*.ty) && !types.isReference(ast.obj(o).*.ty)
        if at(l).*.mode == 0 && !capturesObject(l, o) && !readOnly { tokens.errorAt(nameToken, "the lambda does not capture this variable") }
        const m = capture(l, o, at(l).*.mode == 2, nameToken)
        return ownMember(m, nameToken)
    }
    if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE { return expr.variableValue(scope.at(binding).*.obj, nameToken) }
    if binding != 0 && scope.at(binding).*.kind == scope.PACK && scope.at(binding).*.ty == 0 {
        // A parameter pack of the function around (`values...` in the
        // body): the element being expanded, captured as a member of
        // its own (`values#1`), or the first (noted for the expansion).
        const holder = scope.at(binding).*.obj
        var index = scope.packIndex
        if index < 0 {
            scope.packSeen = holder
            index = 0
        }
        if types.packCount(holder) == 0 { return ast.number(0, nameToken) }
        const element = types.packVariableAt(holder, index)
        if element == 0 { tokens.errorAt(nameToken, "the pack has no such element") }
        if at(l).*.mode == 0 { tokens.errorAt(nameToken, "the lambda does not capture this pack") }
        const memberName = base.intern(base.join(base.join(base.nameOf(name), "#"), base.decimal(@intCast(u64, index))))
        const m = captureNamed(l, element, memberName, at(l).*.mode == 2, nameToken)
        return ownMember(m, nameToken)
    }
    // The enclosing class's member, through this (in a lambda in a
    // lambda, the outer's).
    if at(l).*.enclosingThis != 0 && (at(l).*.mode != 0 || at(l).*.capturesThis) {
        var classTy = types.baseOf(ast.obj(rootThis(l)).*.ty)
        if expr.findMember(classTy, name) != 0 {
            return expr.structReference(ast.unary(ast.DEREF, classThis(l, nameToken), nameToken), nameToken)
        }
        // (A lambda in a generic lambda's operator() instance: `this`
        // there is the closure's; the class's is its captured one.)
        const capturedThis = expr.findMember(classTy, thisName)
        // (A template parameter of the instance around, `needsDestruction`
        // of `[&]<bool needsDestruction>()`, comes first.)
        const visible = scope.find(name)
        const parameterLike = visible != 0 && (scope.at(visible).*.kind == scope.ENUM_CONSTANT || scope.at(visible).*.kind == scope.PACK || scope.at(visible).*.kind == scope.TYPEDEF)
        if ofClass(classTy) != 0 && capturedThis != 0 && !parameterLike {
            const viaClosure = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, classThis(l, nameToken), nameToken), nameToken)
            ast.node(viaClosure).*.member = capturedThis
            typing.addType(viaClosure)
            classTy = types.baseOf(types.member(capturedThis).*.ty)
            if expr.findMember(classTy, name) != 0 { return expr.structReference(ast.unary(ast.DEREF, viaClosure, nameToken), nameToken) }
            const f = cpp.memberOf(classTy, name)
            if f != 0 {
                // (`append<hasGap>(value)` beside a plain `append`: the
                // member template, its arguments given.)
                if ast.obj(f).*.isFunction {
                    const chosen = cpp.explicitMemberTemplate(classTy, name, if ast.obj(f).*.isStaticMember { 0 } else { viaClosure }, nameToken)
                    if chosen != 0 { return chosen }
                }
                if ast.obj(f).*.isFunction && !ast.obj(f).*.isStaticMember {
                    const n = ast.variableNode(f, nameToken)
                    ast.node(n).*.lhs = viaClosure
                    return n
                }
                return expr.variableValue(f, nameToken)
            }
            return 0
        }
        const o = cpp.memberOf(classTy, name)
        if o != 0 {
            if ast.obj(o).*.isFunction {
                const chosen = cpp.explicitMemberTemplate(classTy, name, if ast.obj(o).*.isStaticMember { 0 } else { classThis(l, nameToken) }, nameToken)
                if chosen != 0 { return chosen }
            }
            if ast.obj(o).*.isFunction && !ast.obj(o).*.isStaticMember {
                const n = ast.variableNode(o, nameToken)
                ast.node(n).*.lhs = classThis(l, nameToken)
                return n
            }
            return expr.variableValue(o, nameToken)
        }
    }
    return 0
}

// A name in a generic lambda's operator() read for its instance (the
// function around gone): a member of the class whose `this` the closure
// captured; 0 for none.
fn instanceCaptured(nameToken: usize) -> usize {
    const f = state.currentFunction()
    if f == 0 || ast.obj(f).*.classType == 0 { return 0 }
    const m = expr.findMember(ast.obj(f).*.classType, thisName)
    if m == 0 { return 0 }
    var object = ownMember(m, nameToken)
    var classTy = types.baseOf(types.member(m).*.ty)
    const name = tokens.name(nameToken)
    // (A lambda in a generic lambda's instance: the closure it captured,
    // then, through that one's captured `this`, the class.)
    var steps: u32 = 0
    while steps < 16 {
        if expr.findMember(classTy, name) != 0 {
            return expr.structReference(ast.unary(ast.DEREF, object, nameToken), nameToken)
        }
        const o = cpp.memberOf(classTy, name)
        if o != 0 {
            if ast.obj(o).*.isFunction {
                const chosen = cpp.explicitMemberTemplate(classTy, name, if ast.obj(o).*.isStaticMember { 0 } else { object }, nameToken)
                if chosen != 0 { return chosen }
            }
            if ast.obj(o).*.isFunction && !ast.obj(o).*.isStaticMember {
                const n = ast.variableNode(o, nameToken)
                ast.node(n).*.lhs = object
                return n
            }
            return expr.variableValue(o, nameToken)
        }
        const next = closureThis(classTy)
        if next == 0 { return 0 }
        const step = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, object, nameToken), nameToken)
        ast.node(step).*.member = next
        typing.addType(step)
        object = step
        classTy = types.baseOf(types.member(next).*.ty)
        steps += 1
    }
    return 0
}

// The captured `this` member of a closure class (0: none, or no closure).
fn closureThis(classTy: usize) -> usize {
    if ofClass(classTy) == 0 { return 0 }
    return expr.findMember(classTy, thisName)
}

// `this` in a lambda's body: the captured one; 0 outside a lambda.
pub fn thisKeyword(token: usize) -> usize {
    if current == 0 {
        // A generic lambda's operator() read for its instance (the
        // function around gone): its closure's captured `this`.
        const f = state.currentFunction()
        if f == 0 || ast.obj(f).*.classType == 0 { return 0 }
        const m = expr.findMember(ast.obj(f).*.classType, thisName)
        if m == 0 { return 0 }
        // (Through closures that captured closures, to the class's.)
        var object = ownMember(m, token)
        var next = closureThis(types.baseOf(types.member(m).*.ty))
        var steps: u32 = 0
        while next != 0 && steps < 16 {
            const step = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, object, token), token)
            ast.node(step).*.member = next
            typing.addType(step)
            object = step
            next = closureThis(types.baseOf(types.member(next).*.ty))
            steps += 1
        }
        return object
    }
    if at(current).*.enclosingThis == 0 { return 0 }
    // (A lambda in a generic lambda's instance: its `this` is a closure's;
    // the class's is through that one's captured `this`.)
    var object = classThis(current, token)
    typing.addType(object)
    var next = closureThis(types.baseOf(ast.typeOf(object)))
    var steps: u32 = 0
    while next != 0 && steps < 16 {
        const step = ast.unary(ast.MEMBER, ast.unary(ast.DEREF, object, token), token)
        ast.node(step).*.member = next
        typing.addType(step)
        object = step
        next = closureThis(types.baseOf(types.member(next).*.ty))
        steps += 1
    }
    return object
}

// The class's `this` in lambda `l`'s body.
fn classThis(l: usize, token: usize) -> usize {
    if inLambdaBody(l) { return classThisVia(l, cpp.thisPointer(token), token) }
    return ownMember(captureThis(l, token), token)
}

// `[...]` at the `[`: the closure object.
pub fn expression(token: usize) -> usize {
    cursor.expect(names.P_LBRACKET)
    count += 1
    // (Numbered in the file, and named apart from another file's: two
    // files' `__lambda#26` of a class would make one the other's in the
    // templates instantiated with them, which are linked once.)
    var classText = base.join("__lambda#", base.decimal(@intCast(u64, count)))
    if decl.unitHash != 0 { classText = base.join(classText, base.join("_", base.decimal(decl.unitHash))) }
    const className = base.intern(classText)
    const l = base.alloc(@sizeOf(Lambda))
    at(l).*.outer = current
    // The enclosing `this` (a member function's), while its scope is here.
    const thisBinding = scope.find(names.K_THIS)
    if thisBinding != 0 && scope.at(thisBinding).*.kind == scope.VARIABLE { at(l).*.enclosingThis = scope.at(thisBinding).*.obj }
    // Explicit captures are looked up before the scopes are put aside:
    // cells of (local, byReference) to capture once the class exists.
    var explicit: usize = 0
    var explicitTail: usize = 0
    while !cursor.consume(names.P_RBRACKET) {
        if explicit != 0 || at(l).*.mode != 0 || at(l).*.capturesThis { cursor.expect(names.P_COMMA) }
        if cursor.consume(names.P_ASSIGN) {
            at(l).*.mode = 1
        } else if cursor.consume(names.P_AMP) {
            if cursor.isIdent() && initCaptureAhead() {
                const c = initCapture(true)
                if explicit == 0 { explicit = c } else { base.putWord(explicitTail + 24, c) }
                explicitTail = c
            } else if cursor.isIdent() {
                const c = namedCapture(cursor.expectIdent(), true)
                if explicit == 0 { explicit = c } else { base.putWord(explicitTail + 24, c) }
                explicitTail = c
            } else {
                at(l).*.mode = 2
            }
        } else if cursor.consume(names.K_THIS) {
            at(l).*.capturesThis = true
        } else if cursor.isIdent() && initCaptureAhead() {
            const c = initCapture(false)
            if explicit == 0 { explicit = c } else { base.putWord(explicitTail + 24, c) }
            explicitTail = c
        } else {
            const c = namedCapture(cursor.expectIdent(), false)
            if explicit == 0 { explicit = c } else { base.putWord(explicitTail + 24, c) }
            explicitTail = c
        }
    }
    // In a lambda's body, `[=]`/`[&]`: what the body names of the outer
    // lambda's captures, captured as init-captures.
    if current != 0 && at(l).*.mode != 0 {
        const more = outerCaptures(l, explicit)
        if more != 0 {
            if explicit == 0 { explicit = more } else { base.putWord(explicitTail + 24, more) }
        }
    }
    // The closure class and its operator(): declared at file scope.
    const context = template.beginContext()
    const ty = cpp.newClass(className)
    at(l).*.ty = ty
    at(l).*.made = allMade
    allMade = l
    var c = explicit
    while c != 0 {
        if base.getWord(c + 16) >= 2 {
            // `name = e` (`&name = e`): a member of e's type (decayed),
            // made from e by the closure object.
            const e = base.getWord(c)
            var memberTy = types.unqualified(types.referenced(ast.typeOf(e)))
            if types.kind(memberTy) == types.ARRAY { memberTy = types.pointerTo(types.baseOf(memberTy)) }
            if types.kind(memberTy) == types.FUNC { memberTy = types.pointerTo(memberTy) }
            if base.getWord(c + 16) == 3 { memberTy = types.referenceTo(types.referenced(ast.typeOf(e))) }
            const m = cpp.addMember(at(l).*.ty, @intCast(u32, base.getWord(c + 8)), memberTy, token)
            addCapture(l, e, m, false)
            base.putWord(at(l).*.capturesTail + 16, base.getWord(c + 16))
        } else {
            const m = capture(l, base.getWord(c), base.getWord(c + 16) != 0, token)
        }
        c = base.getWord(c + 24)
    }
    if at(l).*.capturesThis { const m = captureThis(l, token) }
    if cursor.is(names.P_LT) {
        // `[]<class... T>(...)`: a template's parameters of its own.
        const explicitLt = cursor.peek()
        const after = template.endOfArguments(explicitLt)
        if after == 0 || !tokens.is(after, names.P_LPAREN) { cursor.fail("expected the lambda's parameters after its template parameters") }
        cursor.restore(after)
        return generic(l, ty, token, context, explicitLt)
    }
    if cursor.is(names.P_LPAREN) && template.genericLambda(cursor.peek()) {
        return generic(l, ty, token, context, 0)
    }
    var fnType: usize = 0
    const paramsOpen = if cursor.is(names.P_LPAREN) { cursor.peek() } else { 0 }
    if cursor.consume(names.P_LPAREN) {
        fnType = decl.functionParameters(types.autoResult())
    } else {
        fnType = types.functionReturning(types.autoResult())
    }
    // (`[&](T x) ALWAYS_INLINE_LAMBDA { }`: attributes after the
    // parameters, passed over.)
    while true {
        if cursor.consume(names.K_MUTABLE) || cursor.consume(names.K_NOEXCEPT) || cursor.consume(names.K_CONSTEXPR) { continue }
        const attributesRead = decl.attributes()
        decl.stdAttributes()
        if !cursor.is(names.K_MUTABLE) && !cursor.is(names.K_NOEXCEPT) && !cursor.is(names.K_CONSTEXPR) && !cursor.is(names.K_GNU2_ATTRIBUTE) { break }
    }
    if cursor.consume(names.P_ARROW) { types.at(fnType).*.base = decl.typeName() }
    if !cursor.is(names.P_LBRACE) { cursor.fail("expected the lambda's body") }
    scope.enterPrefix(types.at(ty).*.name)
    cpp.pendBodies = true
    const hadBody = cpp.memberFunction(ty, fnType, token, callName, false, false, false, false)
    cpp.pendBodies = false
    scope.leaveNamespace()
    // The body, read now (the captures it adds are members too: the
    // class is laid out again after).
    cpp.finishClass(ty)
    const call = cpp.memberOf(ty, callName)
    // C++17: a lambda's operator() is constexpr when it can be.
    ast.obj(call).*.isConstexpr = true
    current = l
    const body = ast.obj(call).*.pendingBody
    ast.obj(call).*.pendingBody = 0
    cursor.restore(body)
    decl.defineFunction(call, ty)
    current = at(l).*.outer
    if types.isAutoResult(types.baseOf(ast.obj(call).*.ty)) { types.at(ast.obj(call).*.ty).*.base = types.voidOf() }
    // Without captures: a conversion to a pointer to a function of the
    // call's signature (`bool (*)(char16_t)` from `[](char16_t c) {...}`),
    // which gives a static member read from the same tokens.
    if at(l).*.captures == 0 && at(l).*.thisMember == 0 && at(l).*.mode == 0 && !at(l).*.capturesThis { functionPointerConversion(l, ty, paramsOpen, body, types.baseOf(ast.obj(call).*.ty), token) }
    cpp.finishClass(ty)
    const after = cursor.save()
    template.endContext(context)
    cursor.restore(after)
    // The closure object, its captures made from the variables here.
    return closure(l, token)
}

// The captureless lambda `l`'s static invoker (its parameters at
// `paramsOpen`, 0 for none, its body at `body`, its result `result`) and
// its conversion operator to a pointer to it.
fn functionPointerConversion(l: usize, ty: usize, paramsOpen: usize, body: usize, result: usize, token: usize) -> void {
    const saved = cursor.save()
    var invokeType: usize = 0
    if paramsOpen != 0 {
        cursor.restore(tokens.next(paramsOpen))
        invokeType = decl.functionParameters(result)
    } else {
        invokeType = types.functionReturning(result)
    }
    cursor.restore(body)
    scope.enterPrefix(types.at(ty).*.name)
    cpp.pendBodies = true
    const madeInvoke = cpp.memberFunction(ty, invokeType, token, invokeName, true, false, false, false)
    cpp.pendBodies = false
    const invoke = cpp.memberOf(ty, invokeName)
    if invoke != 0 && ast.obj(invoke).*.pendingBody != 0 {
        current = l
        const invokeBody = ast.obj(invoke).*.pendingBody
        ast.obj(invoke).*.pendingBody = 0
        cursor.restore(invokeBody)
        decl.defineFunction(invoke, ty)
        current = at(l).*.outer
    }
    const conversionType = types.functionReturning(types.pointerTo(invokeType))
    cursor.restore(cpp.generatedTokens("const { return __mlxcc_invoke ; }"))
    cpp.pendBodies = true
    const madeConversion = cpp.memberFunction(ty, conversionType, token, conversionName, false, false, false, false)
    cpp.pendBodies = false
    const conversion = cpp.memberOf(ty, conversionName)
    if conversion != 0 && ast.obj(conversion).*.pendingBody != 0 {
        const conversionBody = ast.obj(conversion).*.pendingBody
        ast.obj(conversion).*.pendingBody = 0
        cursor.restore(conversionBody)
        decl.defineFunction(conversion, ty)
    }
    scope.leaveNamespace()
    cursor.restore(saved)
}

// A generic lambda (`[](auto &x) { ... }`), at its `(`: its call
// operator is a member template, read per instance once the function
// around is gone, so what it captures implicitly is what its body names
// of the function's locals (by their tokens); the closure object.
fn generic(l: usize, ty: usize, token: usize, context: usize, explicitLt: usize) -> usize {
    const open = cursor.peek()
    // The body: the first `{` after the parameters.
    var body = tokens.next(open)
    var level: i64 = 1
    while !tokens.isEof(body) && level > 0 {
        if tokens.is(body, names.P_LPAREN) { level += 1 }
        if tokens.is(body, names.P_RPAREN) { level -= 1 }
        body = tokens.next(body)
    }
    while !tokens.isEof(body) && !tokens.is(body, names.P_LBRACE) { body = tokens.next(body) }
    // What follows the lambda (the member template reader would take a
    // `;` there as its own).
    var afterBody = tokens.next(body)
    var braces: i64 = 1
    while !tokens.isEof(afterBody) && braces > 0 {
        if tokens.is(afterBody, names.P_LBRACE) { braces += 1 }
        if tokens.is(afterBody, names.P_RBRACE) { braces -= 1 }
        afterBody = tokens.next(afterBody)
    }
    if at(l).*.mode != 0 {
        var t = tokens.next(body)
        var depth: i64 = 1
        var previous = body
        while !tokens.isEof(t) && depth > 0 {
            if tokens.is(t, names.P_LBRACE) { depth += 1 }
            if tokens.is(t, names.P_RBRACE) { depth -= 1 }
            if tokens.kind(t) == tokens.IDENT && !tokens.is(previous, names.P_DOT) && !tokens.is(previous, names.P_ARROW) && !tokens.is(previous, names.P_SCOPE) {
                const binding = scope.findSuspended(tokens.name(t))
                const isLocal = binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isLocal && !ast.obj(scope.at(binding).*.obj).*.isFunction
                if isLocal {
                    const m = capture(l, scope.at(binding).*.obj, at(l).*.mode == 2, t)
                } else if at(l).*.enclosingThis != 0 {
                    // A member of the enclosing class (a member function
                    // template too, bound in the class): `this` captured.
                    // (In a generic lambda's instance the enclosing `this`
                    // is a closure's: its members, then its class's.)
                    var classTy = types.baseOf(ast.obj(rootThis(l)).*.ty)
                    var steps: u32 = 0
                    while classTy != 0 && steps < 16 {
                        if expr.findMember(classTy, tokens.name(t)) != 0 || cpp.memberOf(classTy, tokens.name(t)) != 0 || cpp.memberTemplateOf(classTy, tokens.name(t)) != 0 {
                            const m = captureThis(l, t)
                            break
                        }
                        const next = closureThis(classTy)
                        classTy = if next != 0 { types.baseOf(types.member(next).*.ty) } else { 0 }
                        steps += 1
                    }
                }
            }
            if tokens.isWord(t, names.K_THIS) && at(l).*.enclosingThis != 0 { const m = captureThis(l, t) }
            previous = t
            t = tokens.next(t)
        }
    }
    const header = template.genericCallOperator(open, explicitLt, afterBody)
    cursor.restore(header)
    scope.enterPrefix(types.at(ty).*.name)
    template.memberTemplate(ty)
    scope.leaveNamespace()
    cpp.finishClass(ty)
    template.endContext(context)
    cursor.restore(afterBody)
    return closure(l, token)
}

// Whether an init-capture starts at the cursor (`name = e`, `name{e}`).
fn initCaptureAhead() -> bool {
    const next = cursor.peekNext()
    return tokens.is(next, names.P_ASSIGN) || tokens.is(next, names.P_LBRACE)
}

// `name = e` (after any `&`): a cell of (the initializer, the name, 2
// by copy or 3 by reference, next).
fn initCapture(byReference: bool) -> usize {
    const nameToken = cursor.expectIdent()
    var e: usize = 0
    if cursor.consume(names.P_ASSIGN) {
        e = expr.assign()
    } else {
        cursor.expect(names.P_LBRACE)
        e = expr.assign()
        cursor.expect(names.P_RBRACE)
    }
    typing.addType(e)
    const c = base.alloc(32)
    base.putWord(c, e)
    base.putWord(c + 8, @intCast(usize, tokens.name(nameToken)))
    base.putWord(c + 16, if byReference { 3 } else { 2 })
    return c
}

// `name` or `&name` in a capture list: a local of the function
// around, or, in a lambda's body, what the name is there (the outer
// lambda's capture, as an init-capture `name = name`).
fn namedCapture(nameToken: usize, byReference: bool) -> usize {
    const binding = scope.find(tokens.name(nameToken))
    // (What is no local here, a function named as the outer lambda's
    // capture among them (`[&main]` of a local `main` in main()), does
    // not hide that capture.)
    const local = binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isLocal
    if !local && current == 0 {
        // In a generic lambda's instance: a capture of the closure's
        // (`[&s]` of the outer lambda's `s`), captured as what it is.
        var e = cpp.memberAccess(nameToken)
        if e == 0 { e = captured(nameToken) }
        if e != 0 {
            typing.addType(e)
            const c = base.alloc(32)
            base.putWord(c, e)
            base.putWord(c + 8, @intCast(usize, tokens.name(nameToken)))
            base.putWord(c + 16, if byReference { 3 } else { 2 })
            return c
        }
    }
    if !local && current != 0 {
        const e = captured(nameToken)
        if e != 0 {
            typing.addType(e)
            const c = base.alloc(32)
            base.putWord(c, e)
            base.putWord(c + 8, @intCast(usize, tokens.name(nameToken)))
            base.putWord(c + 16, if byReference { 3 } else { 2 })
            return c
        }
    }
    return newCell(localNamed(nameToken), 0, byReference)
}

// The outer lambda's captures the body of lambda `l` (at the cursor:
// its parameters or body) names, as init-capture cells (past those in
// `explicit`); 0 for none.
fn outerCaptures(l: usize, explicit: usize) -> usize {
    const outer = current
    var first: usize = 0
    var last: usize = 0
    var t = cursor.peek()
    while !tokens.isEof(t) && !tokens.is(t, names.P_LBRACE) { t = tokens.next(t) }
    var previous = t
    t = tokens.next(t)
    var depth: i64 = 1
    while !tokens.isEof(t) && depth > 0 {
        if tokens.is(t, names.P_LBRACE) { depth += 1 }
        if tokens.is(t, names.P_RBRACE) { depth -= 1 }
        if tokens.kind(t) == tokens.IDENT && !tokens.is(previous, names.P_DOT) && !tokens.is(previous, names.P_ARROW) && !tokens.is(previous, names.P_SCOPE) && outerCaptureNamed(outer, tokens.name(t)) && !cellNamed(explicit, tokens.name(t)) && !cellNamed(first, tokens.name(t)) {
            const e = captured(t)
            if e != 0 {
                typing.addType(e)
                const c = base.alloc(32)
                base.putWord(c, e)
                base.putWord(c + 8, @intCast(usize, tokens.name(t)))
                base.putWord(c + 16, if at(l).*.mode == 2 { 3 } else { 2 })
                if first == 0 { first = c } else { base.putWord(last + 24, c) }
                last = c
            }
        }
        previous = t
        t = tokens.next(t)
    }
    return first
}

// Whether `name` in the body of lambda `outer` is (or becomes) one of
// its captures: not a name of the body's own.
fn outerCaptureNamed(outer: usize, name: u32) -> bool {
    // (A name of the body's own hides it; one of a namespace does not:
    // `auto equal = [&] ...` beside WTF::equal.)
    const own = scope.find(name)
    if own != 0 && scope.at(own).*.depth > 0 { return false }
    var c = at(outer).*.captures
    while c != 0 {
        if types.member(base.getWord(c + 8)).*.name == name { return true }
        c = base.getWord(c + 24)
    }
    if at(outer).*.mode == 0 { return false }
    const binding = scope.findSuspended(name)
    return binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isLocal && !ast.obj(scope.at(binding).*.obj).*.isFunction
}

// Whether a capture cell of the chain is an init-capture named `name`.
fn cellNamed(chain: usize, name: u32) -> bool {
    var c = chain
    while c != 0 {
        if base.getWord(c + 16) >= 2 && @intCast(u32, base.getWord(c + 8)) == name { return true }
        c = base.getWord(c + 24)
    }
    return false
}

// The local named by the token, in the function around.
fn localNamed(nameToken: usize) -> usize {
    const binding = scope.find(tokens.name(nameToken))
    if binding == 0 || scope.at(binding).*.kind != scope.VARIABLE || !ast.obj(scope.at(binding).*.obj).*.isLocal { tokens.errorAt(nameToken, "not a local variable to capture") }
    return scope.at(binding).*.obj
}

// The closure object as an expression: a temporary whose members are
// made from the captured variables.
fn closure(l: usize, token: usize) -> usize {
    const ty = at(l).*.ty
    const tmp = typing.temporaryOf(ty, token)
    // (A prvalue: `f([]{ ... })` binds `C &&`.)
    ast.obj(tmp).*.isMadeTemporary = true
    var n: usize = 0
    var c = at(l).*.captures
    while c != 0 {
        const o = base.getWord(c)
        const m = base.getWord(c + 8)
        const kind = base.getWord(c + 16)
        const byReference = kind == 1 || kind == 3
        const target = ast.unary(ast.MEMBER, ast.variableNode(tmp, token), token)
        ast.node(target).*.member = m
        typing.addType(target)
        // (An init-capture's initializer itself, else the variable.)
        var source = if kind >= 2 { o } else { expr.variableValue(o, token) }
        var made: usize = 0
        if byReference {
            // The reference member bound to the variable.
            made = ast.binary(ast.ASSIGN, target, source, token)
            typing.addType(made)
        } else {
            const address = ast.unary(ast.ADDR, target, token)
            typing.addType(address)
            const args = base.alloc(8)
            base.putWord(args, source)
            made = cpp.construct(address, types.member(m).*.ty, args, 1, token)
        }
        n = if n == 0 { made } else { ast.binary(ast.COMMA, n, made, token) }
        c = base.getWord(c + 24)
    }
    if at(l).*.thisMember != 0 {
        const target = ast.unary(ast.MEMBER, ast.variableNode(tmp, token), token)
        ast.node(target).*.member = at(l).*.thisMember
        typing.addType(target)
        const made = ast.binary(ast.ASSIGN, target, expr.variableValue(at(l).*.enclosingThis, token), token)
        typing.addType(made)
        n = if n == 0 { made } else { ast.binary(ast.COMMA, n, made, token) }
    }
    if cpp.hasDestructor(ty) { state.addTemporary(tmp) }
    const result = ast.variableNode(tmp, token)
    typing.addType(result)
    if n == 0 { return result }
    typing.addType(n)
    const whole = ast.binary(ast.COMMA, n, result, token)
    ast.node(whole).*.ty = ty
    return whole
}
