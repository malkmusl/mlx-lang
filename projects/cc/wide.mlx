// Wide integers (_BitInt(N), N above 64) at compile time: the limbs of a
// constant as they lie in memory, (N + 63) / 64 words of 64 bits, the
// lowest first, the top word's bits above N sign- or zero-extended
// (canonical), as include/__mlxcc_wide.c keeps them at run time. The
// parser's constants and the initializers of globals are made here; the
// arithmetic of a program runs in that C runtime.
const base = @import("./base.mlx")
const types = @import("./types.mlx")

fn word(address: usize) -> u64 { return @intCast(u64, base.getWord(address)) }
fn setWord(address: usize, v: u64) -> void { base.putWord(address, @intCast(usize, v)) }

// The limbs of `ty` (a WIDE type) at `address` made canonical.
pub fn canon(address: usize, ty: usize) -> void {
    const bits = types.at(ty).*.bits
    const count = types.limbs(ty)
    const used = bits - (count - 1) * 64
    if used == 64 { return }
    const top = address + @intCast(usize, (count - 1) * 8)
    const mask = (@intCast(u64, 1) << @intCast(u6, used)) - 1
    var v = word(top) & mask
    if !types.isUnsigned(ty) && (v >> @intCast(u6, used - 1)) & 1 != 0 { v |= ~mask }
    setWord(top, v)
}

// The limbs of `ty` at `address` = the 64-bit value `v`, sign-extended
// when `signed`.
pub fn from64(address: usize, v: u64, signed: bool, ty: usize) -> void {
    const count = types.limbs(ty)
    const fill: u64 = if signed && (v >> 63) != 0 { ~@intCast(u64, 0) } else { 0 }
    setWord(address, v)
    var index: i64 = 1
    while index < count {
        setWord(address + @intCast(usize, index * 8), fill)
        index += 1
    }
    canon(address, ty)
}

// The limbs of `to` at `address` = the limbs of `from` at `source`:
// extended by the source's sign, or truncated.
pub fn convert(address: usize, to: usize, source: usize, from: usize) -> void {
    const fromCount = types.limbs(from)
    const toCount = types.limbs(to)
    const topWord = word(source + @intCast(usize, (fromCount - 1) * 8))
    const fill: u64 = if !types.isUnsigned(from) && (topWord >> 63) != 0 { ~@intCast(u64, 0) } else { 0 }
    const buffer = base.alloc(@intCast(usize, toCount * 8))
    var index: i64 = 0
    while index < toCount {
        const v = if index < fromCount { word(source + @intCast(usize, index * 8)) } else { fill }
        setWord(buffer + @intCast(usize, index * 8), v)
        index += 1
    }
    base.copy(address, buffer, @intCast(usize, toCount * 8))
    canon(address, to)
}

// The limbs of `ty` at `address` negated in place.
pub fn negate(address: usize, ty: usize) -> void {
    const count = types.limbs(ty)
    var carry: u64 = 1
    var index: i64 = 0
    while index < count {
        const at = address + @intCast(usize, index * 8)
        const v = ~word(at) +% carry
        carry = if v < carry { 1 } else { 0 }
        setWord(at, v)
        index += 1
    }
    canon(address, ty)
}

// The limbs of `ty` with the 64-bit value `v` of the (narrow) type
// `from`, in the arena.
pub fn payloadFrom64(v: u64, from: usize, ty: usize) -> usize {
    const payload = base.alloc(@intCast(usize, types.limbs(ty) * 8))
    const signed = !types.isUnsigned(from) && types.kind(from) != types.BOOL && types.kind(from) != types.PTR
    from64(payload, v, signed, ty)
    return payload
}
