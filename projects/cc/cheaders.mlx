// mlx-cheaders: C headers made from Mlx. A library written in Mlx for C
// and C++ programs declares its interface once, in Mlx modules, and this
// program writes the headers C includes:
//
//     mlx-cheaders OUT-DIRECTORY MODULE.mlx...
//
// A module's first line names its header (`// unicode/uchar.h` is written
// to OUT-DIRECTORY/unicode/uchar.h); the comment lines after it describe
// the header. It is read with the Mlx compiler's own parser, and each
// public declaration becomes C:
//
//   const x = @import("./y.mlx")        #include <the header of y.mlx>
//   pub const T = enum(i32...) { ... }  typedef enum T { ... } T;
//   pub const T = struct { ... }        typedef struct T { ... } T;
//                                       (no fields: an incomplete struct)
//   pub const T = fn(...) -> R          typedef R T(...);
//   pub const T = other type            typedef ... T;
//   pub const NAME: T = value           #define NAME value (`((char)value)`
//                                       for a `c_char`)
//   pub extern("c") fn f(...) -> R      R f(...);  (extern "C" in C++)
//   pub fn NAME(...)  (upper case)      a macro: of an expression when the
//                                       body is one `return`, else of
//                                       statements; a parameter `p: *T` is
//                                       an lvalue the macro reads and
//                                       writes (`p.*`)
//   pub fn name(...)                    a static inline function
//
// The comment lines before a declaration go with it. Types: the integer
// types as <stdint.h> has them, `bool`, `f32`/`f64`, `anyopaque` (void),
// the C names `c_char`, `c_int`, `c_long`... as themselves, and `char16`:
// char16_t in C++, uint16_t in C. Pointers (`*T`, `[*]T`, `?*T`) and
// `const` as written; `[N]T` an array.
const std = @import("std")
const page_allocator = @import("../../std/bootstrap/page_allocator.mlx")
const source_module = @import("../../compiler/selfhost/source.mlx")
const lexer = @import("../../compiler/selfhost/lexer.mlx")
const parser_module = @import("../../compiler/selfhost/parser.mlx")
const node_module = @import("../../compiler/selfhost/ast/node.mlx")

const Tag = node_module.Tag
const Kind = lexer.Kind
const NONE = node_module.NONE

// ---------------------------------------------------------------------------
// Memory and text

const SYS_open: usize = 2
const SYS_write: usize = 1
const SYS_close: usize = 3
const SYS_mkdir: usize = 83
const SYS_exit_group: usize = 231

var arenaNext: usize = 0
var arenaEnd: usize = 0

fn alloc(size: usize) -> usize {
    if arenaNext == 0 {
        const reserved = std.linux.syscall6(9, 0, 4294967296, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
        if reserved < 0 { fail("no memory") }
        arenaNext = @bitCast(usize, reserved)
        arenaEnd = arenaNext + 4294967296
    }
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fail("out of memory") }
    arenaNext = at + size
    return at
}

fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }

fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fail(message: []const u8) -> void {
    say("mlx-cheaders: ")
    say(message)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool { return text.length >= prefix.length && same(text[0..prefix.length], prefix) }

fn join(a: []const u8, b: []const u8) -> []const u8 {
    const at = alloc(a.length + b.length + 1)
    var index: usize = 0
    while index < a.length {
        put8(at + index, a[index])
        index += 1
    }
    index = 0
    while index < b.length {
        put8(at + a.length + index, b[index])
        index += 1
    }
    return bytes(at, a.length + b.length)
}

fn join3(a: []const u8, b: []const u8, c: []const u8) -> []const u8 { return join(join(a, b), c) }

fn decimal(value: usize) -> []const u8 {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    return join(view[24 - count..24], "")
}

// The output: one header built at a time.
const OUT_SIZE: usize = 67108864
var outBase: usize = 0
var outTop: usize = 0

fn out(text: []const u8) -> void {
    if outBase == 0 { outBase = alloc(OUT_SIZE) }
    if outTop + text.length > OUT_SIZE { fail("a header is too large") }
    var index: usize = 0
    while index < text.length {
        put8(outBase + outTop + index, text[index])
        index += 1
    }
    outTop += text.length
}

fn writeFile(path: []const u8, text: []const u8) -> void {
    const name = join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), 577, 420)
    if descriptor < 0 { fail(join("cannot write ", path)) }
    var done: usize = 0
    while done < text.length {
        const count = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(text.pointer) + done, text.length - done)
        if count <= 0 { fail(join("cannot write ", path)) }
        done += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

// Every directory of `path` up to its last slash.
fn makeDirectories(path: []const u8) -> void {
    var index: usize = 1
    while index < path.length {
        if path[index] == 47 {
            const name = join(path[0..index], "")
            const ignored = std.linux.syscall2(SYS_mkdir, @intFromPtr(name.pointer), 493)
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// The module being read

var allocator: page_allocator.Allocator = undefined
var sourceBase: usize = 0
var sourceLength: usize = 0
var tokens: lexer.Buffer = undefined
var nodes: parser_module.Store = undefined
var directoryBase: usize = 0
var directoryLength: usize = 0

fn source() -> []const u8 { return bytes(sourceBase, sourceLength) }

fn node(index: usize) -> parser_module.Node { return parser_module.nodeAt(&nodes, index) }

fn tokenText(index: usize) -> []const u8 {
    const t = lexer.tokenAt(tokens, index)
    return source()[t.start..t.start + t.length]
}

fn tokenStart(index: usize) -> usize { return lexer.tokenAt(tokens, index).start }

fn readFile(path: []const u8) -> []const u8 {
    const name = join(path, "")
    const file = source_module.load(allocator, name.pointer, path.length)
    if !file.valid { fail(join("cannot read ", path)) }
    return file.bytes[0..file.length]
}

fn parse(path: []const u8) -> usize {
    const text = readFile(path)
    sourceBase = @intFromPtr(text.pointer)
    sourceLength = text.length
    tokens = lexer.scanAll(allocator, text)
    nodes = parser_module.initStore(allocator, tokens.length * 2 + 16)
    var parser = parser_module.init(text, tokens, &nodes)
    const root = parser_module.parse(&parser)
    if parser.errorCount != 0 {
        const t = lexer.tokenAt(tokens, parser.firstErrorToken)
        fail(join3(path, ": does not parse at byte ", decimal(t.start)))
    }
    return root
}

// The header a module names on its first line (`// unicode/uchar.h`).
fn headerOf(text: []const u8, path: []const u8) -> []const u8 {
    if !startsWith(text, "// ") { fail(join(path, ": the first line names no header")) }
    var end: usize = 3
    while end < text.length && text[end] != 10 { end += 1 }
    return text[3..end]
}

// ---------------------------------------------------------------------------
// Comments

// The comment lines right before the line of byte `at`, as C comment text
// (`/* ... */`, "" when there are none), indented by `indent`.
fn commentBefore(at: usize, indent: []const u8) -> []const u8 {
    const text = source()
    var lineStart = at
    while lineStart > 0 && text[lineStart - 1] != 10 { lineStart -= 1 }
    // Back over the comment lines.
    var first = lineStart
    while first > 0 {
        var previous = first - 1
        while previous > 0 && text[previous - 1] != 10 { previous -= 1 }
        var content = previous
        while content < first && (text[content] == 32 || text[content] == 9) { content += 1 }
        if content + 1 < first && text[content] == 47 && text[content + 1] == 47 {
            first = previous
        } else {
            break
        }
    }
    if first == lineStart { return "" }
    var result = join(indent, "/*")
    var line = first
    var count: usize = 0
    while line < lineStart {
        var end = line
        while text[end] != 10 { end += 1 }
        var content = line
        while text[content] == 32 || text[content] == 9 { content += 1 }
        content += 2
        if content < end && text[content] == 32 { content += 1 }
        if count > 0 { result = join3(result, "\n", indent) }
        result = join3(result, if count == 0 { " " } else { "   " }, text[content..end])
        count += 1
        line = end + 1
    }
    return join(result, " */\n")
}

// The comment of the module: the comment lines after the first, up to
// the first line that is not one.
fn moduleComment() -> []const u8 {
    const text = source()
    var line: usize = 0
    while line < text.length && text[line] != 10 { line += 1 }
    line += 1
    var result: []const u8 = ""
    var count: usize = 0
    while line < text.length && startsWith(text[line..text.length], "//") {
        var end = line
        while end < text.length && text[end] != 10 { end += 1 }
        var content = line + 2
        if content < end && text[content] == 32 { content += 1 }
        result = join3(result, if count == 0 { "/* " } else { "\n   " }, text[content..end])
        count += 1
        line = end + 1
    }
    if count == 0 { return "" }
    return join(result, " */\n\n")
}

// ---------------------------------------------------------------------------
// Types

fn cScalar(name: []const u8) -> []const u8 {
    if same(name, "i8") { return "int8_t" }
    if same(name, "u8") { return "uint8_t" }
    if same(name, "i16") { return "int16_t" }
    if same(name, "u16") { return "uint16_t" }
    if same(name, "i32") { return "int32_t" }
    if same(name, "u32") { return "uint32_t" }
    if same(name, "i64") { return "int64_t" }
    if same(name, "u64") { return "uint64_t" }
    if same(name, "isize") { return "ptrdiff_t" }
    if same(name, "usize") { return "size_t" }
    if same(name, "f32") { return "float" }
    if same(name, "f64") { return "double" }
    if same(name, "bool") { return "bool" }
    if same(name, "void") || same(name, "anyopaque") { return "void" }
    if same(name, "char16") { return "__MLX_CHAR16" }
    if same(name, "c_char") { return "char" }
    if same(name, "c_short") { return "short" }
    if same(name, "c_ushort") { return "unsigned short" }
    if same(name, "c_int") { return "int" }
    if same(name, "c_uint") { return "unsigned int" }
    if same(name, "c_long") { return "long" }
    if same(name, "c_ulong") { return "unsigned long" }
    if same(name, "c_longlong") { return "long long" }
    if same(name, "c_ulonglong") { return "unsigned long long" }
    if same(name, "c_double") { return "double" }
    if same(name, "c_size") { return "size_t" }
    // (Narrow integers, u1 to u7: as a byte.)
    if name.length == 2 && (name[0] == 117 || name[0] == 105) && name[1] >= 49 && name[1] <= 55 { return if name[0] == 117 { "uint8_t" } else { "int8_t" } }
    return name
}

// The name a type node names (the last part of `module.Name`).
fn typeName(index: usize) -> []const u8 {
    const n = node(index)
    if n.tag == Tag.named_type || n.tag == Tag.identifier { return cScalar(tokenText(n.mainToken)) }
    if n.tag == Tag.field_expression { return cScalar(tokenText(n.mainToken)) }
    fail(join("not a type name at byte ", decimal(tokenStart(n.mainToken))))
    return ""
}

fn isPointer(index: usize) -> bool {
    if index == NONE { return false }
    const n = node(index)
    if n.tag == Tag.optional_type { return isPointer(n.lhs) }
    return n.tag == Tag.pointer_type || n.tag == Tag.many_pointer_type
}

// The names of function types (`pub const F = fn(...) -> R`) in the
// modules: in Mlx a value of one is the function, in C a pointer to it.
var functionTypes: [256]usize = undefined
var functionTypeLengths: [256]usize = undefined
var functionTypeCount: usize = 0

fn isFunctionType(name: []const u8) -> bool {
    var index: usize = 0
    while index < functionTypeCount {
        if same(bytes(functionTypes[index], functionTypeLengths[index]), name) { return true }
        index += 1
    }
    return false
}

fn collectFunctionTypes(path: []const u8) -> void {
    const root = parse(path)
    var d = node(root).lhs
    while d != NONE {
        const n = node(d)
        if n.tag == Tag.constant_declaration && n.rhs != NONE && node(n.rhs).tag == Tag.function_type && functionTypeCount < 256 {
            const name = tokenText(n.mainToken)
            functionTypes[functionTypeCount] = @intFromPtr(name.pointer)
            functionTypeLengths[functionTypeCount] = name.length
            functionTypeCount += 1
        }
        d = n.next
    }
}

// `type name` as C declares a `name` of the type node.
fn declaration(index: usize, name: []const u8) -> []const u8 {
    if index == NONE { return join("void", if name.length > 0 { join(" ", name) } else { "" }) }
    const n = node(index)
    if n.tag == Tag.optional_type { return declaration(n.lhs, name) }
    if n.tag == Tag.pointer_type || n.tag == Tag.many_pointer_type {
        const constant = (n.extra & 1) != 0
        if isPointer(n.lhs) { return declaration(n.lhs, join(if constant { "const *" } else { "*" }, name)) }
        return join(if constant { "const " } else { "" }, declaration(n.lhs, join("*", name)))
    }
    if n.tag == Tag.array_type { return declaration(n.rhs, join3(name, "[", join(expression(n.lhs, false), "]"))) }
    if n.tag == Tag.function_type {
        var parameters: []const u8 = ""
        var parameter = n.lhs
        var count: usize = 0
        while parameter != NONE {
            if count > 0 { parameters = join(parameters, ", ") }
            parameters = join(parameters, declaration(parameter, ""))
            parameter = node(parameter).next
            count += 1
        }
        if count == 0 { parameters = "void" }
        return declaration(n.extra, join3(name, "(", join(parameters, ")")))
    }
    const base = typeName(index)
    if isFunctionType(base) { return join3(base, " *", name) }
    if name.length == 0 { return base }
    if name[0] == 42 || name[0] == 40 { return join3(base, " ", name) }
    return join3(base, " ", name)
}

// ---------------------------------------------------------------------------
// Expressions and statements, for macros (`macro`: parameters are the
// macro's arguments, the locals named apart) and inline functions.

var parameterNames: [32]usize = undefined
var parameterLengths: [32]usize = undefined
var parameterPointers: [32]bool = undefined
var parameterCount: usize = 0

fn parameterIndex(name: []const u8) -> usize {
    var index: usize = 0
    while index < parameterCount {
        if same(bytes(parameterNames[index], parameterLengths[index]), name) { return index }
        index += 1
    }
    return 99
}

// (A macro's locals are named after it too: a macro used in another one
// must not hide the other's.)
var macroBase: usize = 0
var macroLength: usize = 0

fn localName(name: []const u8, macro: bool) -> []const u8 {
    if !macro { return name }
    return join3("__mlx_", bytes(macroBase, macroLength), join("_", name))
}

// A local of the current macro or function (declared by var or const in
// it): their names.
var localNames: [64]usize = undefined
var localLengths: [64]usize = undefined
var localCount: usize = 0

fn isLocal(name: []const u8) -> bool {
    var index: usize = 0
    while index < localCount {
        if same(bytes(localNames[index], localLengths[index]), name) { return true }
        index += 1
    }
    return false
}

fn identifier(name: []const u8, macro: bool) -> []const u8 {
    const parameter = parameterIndex(name)
    if parameter != 99 {
        if macro { return join3("(", name, ")") }
        return name
    }
    if isLocal(name) { return localName(name, macro) }
    return name
}

// The C spelling of an operator token (Mlx's wrapping and saturating
// forms are C's plain ones).
fn operatorText(index: usize) -> []const u8 {
    const text = tokenText(index)
    if same(text, "+%") || same(text, "+|") { return "+" }
    if same(text, "-%") || same(text, "-|") { return "-" }
    if same(text, "*%") || same(text, "*|") { return "*" }
    if same(text, "<<%") || same(text, "<<|") { return "<<" }
    if same(text, "+%=") { return "+=" }
    if same(text, "-%=") { return "-=" }
    if same(text, "*%=") { return "*=" }
    return text
}

// The arguments of a call (to a macro: `&x` is the lvalue x, which the
// macro writes).
fn arguments(first: usize, macro: bool, toMacro: bool) -> []const u8 {
    var result: []const u8 = ""
    var argument = first
    var count: usize = 0
    while argument != NONE {
        if count > 0 { result = join(result, ", ") }
        const a = node(argument)
        if toMacro && a.tag == Tag.unary_expression && same(tokenText(a.mainToken), "&") {
            result = join(result, expression(a.lhs, macro))
        } else {
            result = join(result, expression(argument, macro))
        }
        argument = node(argument).next
        count += 1
    }
    return result
}

fn integerText(text: []const u8) -> []const u8 {
    var result: []const u8 = ""
    var index: usize = 0
    while index < text.length {
        if text[index] != 95 { result = join(result, text[index..index + 1]) }
        index += 1
    }
    return result
}

fn expression(index: usize, macro: bool) -> []const u8 {
    if index == NONE { return "" }
    const n = node(index)
    const tag = n.tag
    if tag == Tag.integer_literal { return integerText(tokenText(n.mainToken)) }
    if tag == Tag.float_literal { return tokenText(n.mainToken) }
    if tag == Tag.string_literal || tag == Tag.character_literal { return tokenText(n.mainToken) }
    if tag == Tag.boolean_literal { return tokenText(n.mainToken) }
    if tag == Tag.null_literal { return "0" }
    if tag == Tag.identifier || tag == Tag.named_type { return identifier(tokenText(n.mainToken), macro) }
    if tag == Tag.binary_expression {
        const op = operatorText(n.mainToken)
        const assignment = op.length > 0 && op[op.length - 1] == 61 && !same(op, "==") && !same(op, "!=") && !same(op, "<=") && !same(op, ">=")
        if assignment {
            if node(n.lhs).tag == Tag.identifier && same(tokenText(node(n.lhs).mainToken), "_") { return join3("(void)(", expression(n.rhs, macro), ")") }
            return join3(expression(n.lhs, macro), join3(" ", op, " "), expression(n.rhs, macro))
        }
        return join3("(", join3(expression(n.lhs, macro), join3(" ", op, " "), expression(n.rhs, macro)), ")")
    }
    if tag == Tag.unary_expression {
        const op = tokenText(n.mainToken)
        if same(op, ".*") {
            const operand = node(n.lhs)
            if macro && operand.tag == Tag.identifier && parameterIndex(tokenText(operand.mainToken)) != 99 { return expression(n.lhs, macro) }
            return join3("(*", expression(n.lhs, macro), ")")
        }
        if same(op, ".?") { return expression(n.lhs, macro) }
        return join3("(", op, join(expression(n.lhs, macro), ")"))
    }
    if tag == Tag.call_expression {
        const callee = calleeName(n.lhs, macro)
        return join3(callee, "(", join(arguments(n.rhs, macro, isUpperName(callee)), ")"))
    }
    if tag == Tag.index_expression { return join3(expression(n.lhs, macro), "[", join(expression(n.rhs, macro), "]")) }
    if tag == Tag.field_expression {
        if n.lhs == NONE { return tokenText(n.mainToken) }
        const base = node(n.lhs)
        // `Enum.member`, `module.NAME`: the name alone.
        if base.tag == Tag.identifier && !isLocal(tokenText(base.mainToken)) && parameterIndex(tokenText(base.mainToken)) == 99 { return tokenText(n.mainToken) }
        if base.tag == Tag.field_expression || base.tag == Tag.named_type { return tokenText(n.mainToken) }
        return join3(expression(n.lhs, macro), ".", tokenText(n.mainToken))
    }
    if tag == Tag.if_statement { return join3("(", join3(expression(n.lhs, macro), " ? ", expression(n.rhs, macro)), join3(" : ", expression(n.extra, macro), ")")) }
    if tag == Tag.builtin_call { return builtin(n, macro) }
    if tag == Tag.aggregate_literal || tag == Tag.tuple_literal || tag == Tag.array_literal {
        var result: []const u8 = "{ "
        var field = if tag == Tag.aggregate_literal { n.rhs } else { n.lhs }
        var count: usize = 0
        while field != NONE {
            if count > 0 { result = join(result, ", ") }
            const f = node(field)
            result = join(result, expression(if tag == Tag.aggregate_literal { f.rhs } else { field }, macro))
            field = f.next
            count += 1
        }
        return join(result, " }")
    }
    if tag == Tag.unsafe_expression { return expression(n.lhs, macro) }
    fail(join("an expression C has no form for at byte ", decimal(tokenStart(n.mainToken))))
    return ""
}

fn calleeName(index: usize, macro: bool) -> []const u8 {
    const n = node(index)
    if n.tag == Tag.field_expression { return tokenText(n.mainToken) }
    return expression(index, macro)
}

// The builtins C has a form for: casts, sizes, enum values.
fn builtin(n: parser_module.Node, macro: bool) -> []const u8 {
    const name = tokenText(n.mainToken)
    const first = n.lhs
    if same(name, "intCast") || same(name, "truncate") || same(name, "bitCast") || same(name, "floatCast") || same(name, "intFromFloat") || same(name, "floatFromInt") || same(name, "ptrCast") || same(name, "ptrFromInt") {
        const value = node(first).next
        return join3("((", declaration(first, ""), join3(")(", expression(value, macro), "))"))
    }
    if same(name, "intFromEnum") || same(name, "enumFromInt") || same(name, "intFromBool") || same(name, "intFromPtr") {
        return join3("(", expression(if same(name, "enumFromInt") { node(first).next } else { first }, macro), ")")
    }
    if same(name, "sizeOf") { return join3("sizeof(", declaration(first, ""), ")") }
    fail(join("a builtin C has no form for: @", name))
    return ""
}

// The statements of a block, each on a line of its own (`indent`),
// ended by `end` (" \\" in a macro).
fn statements(block: usize, macro: bool, indent: []const u8, end: []const u8) -> []const u8 {
    var result: []const u8 = ""
    var statement = node(block).lhs
    while statement != NONE {
        result = join(result, statementText(statement, macro, indent, end))
        statement = node(statement).next
    }
    return result
}

fn statementText(index: usize, macro: bool, indent: []const u8, end: []const u8) -> []const u8 {
    const n = node(index)
    const deeper = join(indent, "    ")
    if n.tag == Tag.variable_declaration || n.tag == Tag.constant_declaration {
        const name = tokenText(n.mainToken)
        if n.lhs == NONE { fail(join("a local without a type: ", name)) }
        if localCount < 64 {
            localNames[localCount] = @intFromPtr(name.pointer)
            localLengths[localCount] = name.length
            localCount += 1
        }
        const initializer = if n.rhs != NONE && node(n.rhs).tag != Tag.undefined_literal { join(" = ", expression(n.rhs, macro)) } else { "" }
        return join3(indent, join3(declaration(n.lhs, localName(name, macro)), initializer, ";"), join(end, "\n"))
    }
    if n.tag == Tag.if_statement {
        var result = join3(indent, join3("if (", expression(n.lhs, macro), ") {"), join(end, "\n"))
        result = join(result, statements(n.rhs, macro, deeper, end))
        var otherwise = n.extra
        while otherwise != NONE {
            const o = node(otherwise)
            if o.tag == Tag.if_statement {
                result = join3(result, join3(indent, join3("} else if (", expression(o.lhs, macro), ") {"), end), "\n")
                result = join(result, statements(o.rhs, macro, deeper, end))
                otherwise = o.extra
            } else {
                result = join3(result, join3(indent, "} else {", end), "\n")
                result = join(result, statements(otherwise, macro, deeper, end))
                otherwise = NONE
            }
        }
        return join3(result, join3(indent, "}", end), "\n")
    }
    if n.tag == Tag.while_statement {
        var result: []const u8 = ""
        if n.extra != NONE {
            result = join3(indent, join3("for (; ", expression(n.lhs, macro), join3("; ", expression(n.extra, macro), ") {")), join(end, "\n"))
        } else {
            result = join3(indent, join3("while (", expression(n.lhs, macro), ") {"), join(end, "\n"))
        }
        result = join(result, statements(n.rhs, macro, deeper, end))
        return join3(result, join3(indent, "}", end), "\n")
    }
    if n.tag == Tag.block {
        var result = join3(indent, "{", join(end, "\n"))
        result = join(result, statements(index, macro, deeper, end))
        return join3(result, join3(indent, "}", end), "\n")
    }
    if n.tag == Tag.return_statement {
        if n.rhs == NONE { return join3(indent, "return;", join(end, "\n")) }
        return join3(indent, join3("return ", expression(n.rhs, macro), ";"), join(end, "\n"))
    }
    if n.tag == Tag.break_statement { return join3(indent, "break;", join(end, "\n")) }
    if n.tag == Tag.continue_statement { return join3(indent, "continue;", join(end, "\n")) }
    if n.tag == Tag.unsafe_block { return statements(n.lhs, macro, indent, end) }
    return join3(indent, join(expression(index, macro), ";"), join(end, "\n"))
}

// ---------------------------------------------------------------------------
// Declarations

fn isUpperName(name: []const u8) -> bool {
    var index: usize = 0
    while index < name.length {
        const c = name[index]
        if !((c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) { return false }
        index += 1
    }
    return true
}

fn setParameters(first: usize) -> void {
    parameterCount = 0
    localCount = 0
    var parameter = first
    while parameter != NONE {
        const p = node(parameter)
        const name = tokenText(p.mainToken)
        parameterNames[parameterCount] = @intFromPtr(name.pointer)
        parameterLengths[parameterCount] = name.length
        parameterPointers[parameterCount] = p.lhs != NONE && node(p.lhs).tag == Tag.pointer_type
        parameterCount += 1
        parameter = p.next
    }
}

// A macro of an Mlx function: of an expression (its body is one return)
// or of statements.
fn macroOf(n: parser_module.Node) -> void {
    const name = tokenText(n.mainToken)
    macroBase = @intFromPtr(name.pointer)
    macroLength = name.length
    setParameters(n.lhs)
    var parameters: []const u8 = ""
    var index: usize = 0
    while index < parameterCount {
        if index > 0 { parameters = join(parameters, ", ") }
        parameters = join(parameters, bytes(parameterNames[index], parameterLengths[index]))
        index += 1
    }
    const body = node(n.rhs)
    const first = body.lhs
    if first != NONE && node(first).next == NONE && node(first).tag == Tag.return_statement {
        out(join3("#define ", name, join3("(", parameters, ") ")))
        out(expression(node(first).rhs, true))
        out("\n")
        return
    }
    out(join3("#define ", name, join3("(", parameters, ") do { \\\n")))
    out(statements(n.rhs, true, "    ", " \\"))
    out("} while (0)\n")
}

fn inlineFunctionOf(n: parser_module.Node) -> void {
    const name = tokenText(n.mainToken)
    setParameters(n.lhs)
    var parameters: []const u8 = ""
    var parameter = n.lhs
    var count: usize = 0
    while parameter != NONE {
        const p = node(parameter)
        if count > 0 { parameters = join(parameters, ", ") }
        parameters = join(parameters, declaration(p.lhs, tokenText(p.mainToken)))
        parameter = p.next
        count += 1
    }
    if count == 0 { parameters = "void" }
    const returnType = n.extra
    out(join("static inline ", declaration(returnType, join3(name, "(", join(parameters, ")")))))
    out("\n{\n")
    out(statements(n.rhs, false, "    ", ""))
    out("}\n")
}

fn prototypeOf(n: parser_module.Node) -> void {
    const name = tokenText(n.mainToken)
    var parameters: []const u8 = ""
    var parameter = n.lhs
    var count: usize = 0
    while parameter != NONE {
        const p = node(parameter)
        if count > 0 { parameters = join(parameters, ", ") }
        parameters = join(parameters, declaration(p.lhs, tokenText(p.mainToken)))
        parameter = p.next
        count += 1
    }
    if count == 0 { parameters = "void" }
    out(join(declaration(n.extra, join3(name, "(", join(parameters, ")"))), ";\n"))
}

fn enumOf(name: []const u8, n: parser_module.Node) -> void {
    out(join3("typedef enum ", name, " {\n"))
    var member = n.lhs
    while member != NONE {
        const m = node(member)
        out(commentBefore(tokenStart(m.mainToken), "    "))
        out(join("    ", tokenText(m.mainToken)))
        if m.rhs != NONE { out(join(" = ", expression(m.rhs, false))) }
        out(if m.next != NONE { ",\n" } else { "\n" })
        member = m.next
    }
    out(join3("} ", name, ";\n"))
}

// (Every structure of the header is declared first, `typedef struct T
// T;`, so that one may point to another declared after it.)
fn structOf(name: []const u8, n: parser_module.Node) -> void {
    if n.lhs == NONE { return }
    out(join3("struct ", name, " {\n"))
    var field = n.lhs
    while field != NONE {
        const f = node(field)
        if f.tag == Tag.field_declaration {
            out(commentBefore(tokenStart(f.mainToken), "    "))
            out(join3("    ", declaration(f.lhs, tokenText(f.mainToken)), ";\n"))
        }
        field = f.next
    }
    out("};\n")
}

// The header of the module `path`, with its includes from `imports`.
var linkageOpen = false

fn openLinkage() -> void {
    if linkageOpen { return }
    out("#ifdef __cplusplus\nextern \"C\" {\n#endif\n")
    linkageOpen = true
}

fn closeLinkage() -> void {
    if !linkageOpen { return }
    out("#ifdef __cplusplus\n}\n#endif\n")
    linkageOpen = false
}

fn guardOf(header: []const u8) -> []const u8 {
    var result: []const u8 = "MLX_"
    var index: usize = 0
    while index < header.length {
        var c = header[index]
        if c >= 97 && c <= 122 { c -= 32 }
        if !((c >= 65 && c <= 90) || (c >= 48 && c <= 57)) { c = 95 }
        const one: [1]u8 = [1]u8{ c }
        result = join(result, join(one[0..1], ""))
        index += 1
    }
    return result
}

fn directoryOf(path: []const u8) -> []const u8 {
    var end = path.length
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    return path[0..end]
}

fn header(path: []const u8, outputDirectory: []const u8) -> void {
    const root = parse(path)
    const name = headerOf(source(), path)
    outTop = 0
    linkageOpen = false
    out(join3("/* ", name, ": made by mlx-cheaders from "))
    out(join(path, "; do not edit. */\n"))
    out(moduleComment())
    const guard = guardOf(name)
    out(join3("#ifndef ", guard, join3("\n#define ", guard, "\n\n")))
    out("#include <stddef.h>\n#include <stdint.h>\n#include <stdbool.h>\n")
    out("#ifndef __MLX_CHAR16\n#ifdef __cplusplus\n#define __MLX_CHAR16 char16_t\n#else\n#define __MLX_CHAR16 uint16_t\n#endif\n#endif\n")
    // The includes first (the parse is redone for each imported module:
    // the module's own nodes are read again after).
    var declaration_index = node(root).lhs
    var includes: []const u8 = ""
    while declaration_index != NONE {
        const d = node(declaration_index)
        if d.tag == Tag.constant_declaration && d.rhs != NONE && node(d.rhs).tag == Tag.builtin_call && same(tokenText(node(d.rhs).mainToken), "import") {
            const target = tokenText(node(node(d.rhs).lhs).mainToken)
            const relative = target[1..target.length - 1]
            if startsWith(relative, "./") || startsWith(relative, "../") {
                includes = join3(includes, "\n", join(directoryOf(path), relative))
            }
        }
        declaration_index = d.next
    }
    // (Parsing an import replaces the module being read: its name only.)
    var at: usize = 0
    var included: []const u8 = ""
    while at < includes.length {
        at += 1
        var end = at
        while end < includes.length && includes[end] != 10 { end += 1 }
        const imported = includes[at..end]
        included = join3(included, "#include <", join(headerOf(readFile(imported), imported), ">\n"))
        at = end
    }
    out(included)
    out("\n")
    const again = parse(path)
    declaration_index = node(again).lhs
    var forward: []const u8 = ""
    while declaration_index != NONE {
        const d = node(declaration_index)
        if d.tag == Tag.constant_declaration && (d.extra & 1) != 0 && d.rhs != NONE && node(d.rhs).tag == Tag.struct_type {
            const struct_name = tokenText(d.mainToken)
            forward = join(forward, join3("typedef struct ", struct_name, join3(" ", struct_name, ";\n")))
        }
        declaration_index = d.next
    }
    if forward.length > 0 { out(join(forward, "\n")) }
    // C's order: the types, then the structures (whose fields name the
    // types), then the rest.
    var pass: usize = 0
    while pass < 3 {
        emitDeclarations(node(again).lhs, pass)
        pass += 1
    }
    closeLinkage()
    out(join3("#endif /* ", guard, " */\n"))
    const target = join3(outputDirectory, "/", name)
    makeDirectories(target)
    writeFile(target, bytes(outBase, outTop))
}

// The module's declarations of one kind: 0 types (enums, aliases,
// function types), 1 structures, 2 the rest (constants, macros, inline
// functions, functions).
fn emitDeclarations(first: usize, pass: usize) -> void {
    var declaration_index = first
    while declaration_index != NONE {
        const d = node(declaration_index)
        declaration_index = d.next
        if d.tag == Tag.function_declaration {
            if pass != 2 { continue }
            const flags = d.endToken >> 32
            const name_text = tokenText(d.mainToken)
            if (flags & 1) == 0 { continue }
            out(commentBefore(tokenStart(d.mainToken), ""))
            if (flags & 16) != 0 {
                openLinkage()
                prototypeOf(d)
            } else if isUpperName(name_text) {
                closeLinkage()
                macroOf(d)
            } else {
                closeLinkage()
                inlineFunctionOf(d)
            }
            out("\n")
            continue
        }
        if d.tag != Tag.constant_declaration { continue }
        if (d.extra & 1) == 0 { continue }
        const constant = tokenText(d.mainToken)
        const value = d.rhs
        if value == NONE { continue }
        const v = node(value)
        if v.tag == Tag.builtin_call { continue }
        const isType = d.lhs == NONE && (v.tag == Tag.enum_type || v.tag == Tag.function_type || v.tag == Tag.identifier || v.tag == Tag.named_type || v.tag == Tag.pointer_type || v.tag == Tag.many_pointer_type || v.tag == Tag.array_type || v.tag == Tag.optional_type || v.tag == Tag.field_expression)
        const kind: usize = if v.tag == Tag.struct_type { 1 } else if isType { 0 } else { 2 }
        if kind != pass { continue }
        if v.tag == Tag.struct_type && v.lhs == NONE { continue }
        if v.tag == Tag.field_expression && same(tokenText(v.mainToken), constant) { continue }
        if isType && v.tag != Tag.enum_type && v.tag != Tag.function_type && !same(cScalar(constant), constant) { continue }
        closeLinkage()
        out(commentBefore(tokenStart(d.mainToken), ""))
        if v.tag == Tag.enum_type {
            enumOf(constant, v)
        } else if v.tag == Tag.struct_type {
            structOf(constant, v)
        } else if isType {
            out(join3("typedef ", declaration(value, constant), ";\n"))
        } else {
            // (A `c_char` constant is a char in C, as `'@'` is in C++.)
            const typed = d.lhs != NONE && (node(d.lhs).tag == Tag.identifier || node(d.lhs).tag == Tag.field_expression) && same(tokenText(node(d.lhs).mainToken), "c_char")
            const text = if typed { join3("((char)", expression(value, false), ")") } else { expression(value, false) }
            out(join3("#define ", constant, join3(" ", text, "\n")))
        }
        out("\n")
    }
}

fn cString(pointer: [*]const u8) -> []const u8 {
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

pub fn main(arguments_: [][*]const u8) -> u8 {
    if arguments_.length < 3 {
        say("usage: mlx-cheaders OUT-DIRECTORY MODULE.mlx...\n")
        return 2
    }
    allocator = page_allocator.init()
    const outputDirectory = cString(arguments_[1])
    var index: usize = 2
    while index < arguments_.length {
        collectFunctionTypes(cString(arguments_[index]))
        index += 1
    }
    index = 2
    while index < arguments_.length {
        header(cString(arguments_[index]), outputDirectory)
        index += 1
    }
    return 0
}
