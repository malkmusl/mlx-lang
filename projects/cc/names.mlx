fn fixed(text: []const u8, id: u32) -> void {
    if base.intern(text) != id { base.fatal("the fixed names are out of order") }
}

// Interns the fixed names; first thing after base.init.
pub fn init() -> void {
    fixed("...", P_ELLIPSIS)
    fixed("<<=", P_SHL_ASSIGN)
    fixed(">>=", P_SHR_ASSIGN)
    fixed("==", P_EQ)
    fixed("!=", P_NE)
    fixed("<=", P_LE)
    fixed(">=", P_GE)
    fixed("->", P_ARROW)
    fixed("++", P_INC)
    fixed("--", P_DEC)
    fixed("<<", P_SHL)
    fixed(">>", P_SHR)
    fixed("&&", P_ANDAND)
    fixed("||", P_OROR)
    fixed("+=", P_ADD_ASSIGN)
    fixed("-=", P_SUB_ASSIGN)
    fixed("*=", P_MUL_ASSIGN)
    fixed("/=", P_DIV_ASSIGN)
    fixed("%=", P_MOD_ASSIGN)
    fixed("&=", P_AND_ASSIGN)
    fixed("|=", P_OR_ASSIGN)
    fixed("^=", P_XOR_ASSIGN)
    fixed("##", P_HASHHASH)
    fixed("(", P_LPAREN)
    fixed(")", P_RPAREN)
    fixed("{", P_LBRACE)
    fixed("}", P_RBRACE)
    fixed("[", P_LBRACKET)
    fixed("]", P_RBRACKET)
    fixed(";", P_SEMI)
    fixed(",", P_COMMA)
    fixed(".", P_DOT)
    fixed("+", P_PLUS)
    fixed("-", P_MINUS)
    fixed("*", P_STAR)
    fixed("/", P_SLASH)
    fixed("%", P_PERCENT)
    fixed("&", P_AMP)
    fixed("|", P_PIPE)
    fixed("^", P_CARET)
    fixed("~", P_TILDE)
    fixed("!", P_BANG)
    fixed("?", P_QUESTION)
    fixed(":", P_COLON)
    fixed("=", P_ASSIGN)
    fixed("<", P_LT)
    fixed(">", P_GT)
    fixed("#", P_HASH)
    fixed("auto", K_AUTO)
    fixed("break", K_BREAK)
    fixed("case", K_CASE)
    fixed("char", K_CHAR)
    fixed("const", K_CONST)
    fixed("continue", K_CONTINUE)
    fixed("default", K_DEFAULT)
    fixed("do", K_DO)
    fixed("double", K_DOUBLE)
    fixed("else", K_ELSE)
    fixed("enum", K_ENUM)
    fixed("extern", K_EXTERN)
    fixed("float", K_FLOAT)
    fixed("for", K_FOR)
    fixed("goto", K_GOTO)
    fixed("if", K_IF)
    fixed("inline", K_INLINE)
    fixed("int", K_INT)
    fixed("long", K_LONG)
    fixed("register", K_REGISTER)
    fixed("restrict", K_RESTRICT)
    fixed("return", K_RETURN)
    fixed("short", K_SHORT)
    fixed("signed", K_SIGNED)
    fixed("sizeof", K_SIZEOF)
    fixed("static", K_STATIC)
    fixed("struct", K_STRUCT)
    fixed("switch", K_SWITCH)
    fixed("typedef", K_TYPEDEF)
    fixed("union", K_UNION)
    fixed("unsigned", K_UNSIGNED)
    fixed("void", K_VOID)
    fixed("volatile", K_VOLATILE)
    fixed("while", K_WHILE)
    fixed("_Bool", K_BOOL)
    fixed("_Alignas", K_ALIGNAS)
    fixed("_Alignof", K_ALIGNOF)
    fixed("_Atomic", K_ATOMIC)
    fixed("_Generic", K_GENERIC)
    fixed("_Noreturn", K_NORETURN)
    fixed("_Static_assert", K_STATIC_ASSERT)
    fixed("_Thread_local", K_THREAD_LOCAL)
    fixed("__attribute__", K_GNU2_ATTRIBUTE)
    fixed("__restrict", K_GNU_RESTRICT)
    fixed("__restrict__", K_GNU2_RESTRICT)
    fixed("__inline", K_GNU_INLINE)
    fixed("__inline__", K_GNU2_INLINE)
    fixed("__const", K_GNU_CONST)
    fixed("__volatile__", K_GNU2_VOLATILE)
    fixed("__extension__", K_GNU2_EXTENSION)
    fixed("__asm__", K_GNU2_ASM)
    fixed("asm", K_ASM)
    fixed("__typeof__", K_GNU2_TYPEOF)
    fixed("typeof", K_TYPEOF)
    fixed("__signed__", K_GNU2_SIGNED)
    fixed("__builtin_va_list", K_GNU_BUILTIN_VA_LIST)
    fixed("__builtin_va_start", K_GNU_BUILTIN_VA_START)
    fixed("__builtin_va_end", K_GNU_BUILTIN_VA_END)
    fixed("__builtin_va_arg", K_GNU_BUILTIN_VA_ARG)
    fixed("__builtin_va_copy", K_GNU_BUILTIN_VA_COPY)
    fixed("__builtin_offsetof", K_GNU_BUILTIN_OFFSETOF)
    fixed("__alignof__", K_GNU2_ALIGNOF)
    fixed("__thread", K_GNU_THREAD)
    fixed("bool", K_C23_BOOL)
    fixed("true", K_TRUE)
    fixed("false", K_FALSE)
    fixed("nullptr", K_NULLPTR)
    fixed("static_assert", K_C23_STATIC_ASSERT)
    fixed("alignas", K_C23_ALIGNAS)
    fixed("alignof", K_C23_ALIGNOF)
    fixed("thread_local", K_C23_THREAD_LOCAL)
    fixed("typeof_unqual", K_TYPEOF_UNQUAL)
    fixed("constexpr", K_CONSTEXPR)
    fixed("include", D_INCLUDE)
    fixed("include_next", D_INCLUDE_NEXT)
    fixed("define", D_DEFINE)
    fixed("undef", D_UNDEF)
    fixed("ifdef", D_IFDEF)
    fixed("ifndef", D_IFNDEF)
    fixed("elif", D_ELIF)
    fixed("elifdef", D_ELIFDEF)
    fixed("elifndef", D_ELIFNDEF)
    fixed("endif", D_ENDIF)
    fixed("error", D_ERROR)
    fixed("warning", D_WARNING)
    fixed("pragma", D_PRAGMA)
    fixed("line", D_LINE)
    fixed("defined", D_DEFINED)
    fixed("__VA_ARGS__", D_VA_ARGS)
    fixed("once", D_ONCE)
    fixed("__FILE__", D_FILE_MACRO)
    fixed("__LINE__", D_LINE_MACRO)
    fixed("__COUNTER__", D_COUNTER)
    fixed("__DATE__", D_DATE)
    fixed("__TIME__", D_TIME)
    fixed("__has_include", D_HAS_INCLUDE)
    fixed("__has_include_next", D_HAS_INCLUDE_NEXT)
    fixed("__BASE_FILE__", D_BASE_FILE)
    fixed("__VA_OPT__", D_VA_OPT)
    fixed("main", D_MAIN)
    fixed("_start", D_START)
    fixed("exit", D_EXIT)
    fixed("__mlxcc_init", D_MLXCC_INIT)
}
