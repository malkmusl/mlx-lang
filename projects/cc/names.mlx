// The names mlx-cc interns first, in this order, so each has a constant
// id: the punctuators (P_*), the keywords (K_*) and the preprocessor's
// words (D_*; "if", "else" and the like are the keywords' ids).
// Written by tools/cc/gen_names.py; do not edit by hand.
const base = @import("./base.mlx")

