// <algorithm>: over pointers as iterators (std::vector's, std::string's,
// arrays): min, max, swap, fill, count, find, reverse, copy, sort
// (insertion sort for short ranges, quicksort above), unique, equal.
#ifndef __MLXCC_ALGORITHM
#define __MLXCC_ALGORITHM
#include <stddef.h>
#include <utility>
#include <initializer_list>
#include <iterator>

namespace std {

template <typename T> constexpr const T &min(const T &a, const T &b) { return b < a ? b : a; }
template <typename T> constexpr const T &max(const T &a, const T &b) { return a < b ? b : a; }

template <typename I, typename T> void fill(I first, I last, const T &value) {
    for (; first != last; ++first) *first = value;
}

template <typename I, typename T> long count(I first, I last, const T &value) {
    long n = 0;
    for (; first != last; ++first)
        if (*first == value) n++;
    return n;
}

template <typename I, typename T> I find(I first, I last, const T &value) {
    for (; first != last; ++first)
        if (*first == value) return first;
    return last;
}

template <typename I> void reverse(I first, I last) {
    while (first != last && first != --last) {
        swap(*first, *last);
        ++first;
    }
}

template <typename I, typename O> O copy(I first, I last, O out) {
    for (; first != last; ++first, ++out) *out = *first;
    return out;
}

template <typename I> bool equal(I first, I last, I other) {
    for (; first != last; ++first, ++other)
        if (!(*first == *other)) return false;
    return true;
}

template <typename I, typename C> void sort(I first, I last, C less) {
    long n = last - first;
    if (n < 2) return;
    if (n < 16) {
        for (I i = first + 1; i != last; ++i) {
            I j = i;
            while (j != first && less(*i, *(j - 1))) --j;
            if (j != i) {
                I k = i;
                while (k != j) {
                    swap(*k, *(k - 1));
                    --k;
                }
            }
        }
        return;
    }
    I pivot = first + n / 2;
    swap(*pivot, *(last - 1));
    I store = first;
    for (I i = first; i != last - 1; ++i) {
        if (less(*i, *(last - 1))) {
            swap(*i, *store);
            ++store;
        }
    }
    swap(*store, *(last - 1));
    sort(first, store, less);
    sort(store + 1, last, less);
}

template <typename I, typename P> I find_if(I first, I last, P test) {
    for (; first != last; ++first)
        if (test(*first)) return first;
    return last;
}

template <typename I, typename P> long count_if(I first, I last, P test) {
    long n = 0;
    for (; first != last; ++first)
        if (test(*first)) n++;
    return n;
}

template <typename I, typename F> F for_each(I first, I last, F action) {
    for (; first != last; ++first) action(*first);
    return action;
}

template <typename I, typename O, typename F> O transform(I first, I last, O out, F mapping) {
    for (; first != last; ++first, ++out) *out = mapping(*first);
    return out;
}

template <typename I, typename P> I remove_if(I first, I last, P test) {
    I out = first;
    for (; first != last; ++first)
        if (!test(*first)) {
            *out = *first;
            ++out;
        }
    return out;
}

template <typename I> void sort(I first, I last) {
    long n = last - first;
    if (n < 2) return;
    if (n < 16) {
        for (I i = first + 1; i != last; ++i) {
            I j = i;
            while (j != first && *i < *(j - 1)) --j;
            if (j != i) {
                I k = i;
                while (k != j) {
                    swap(*k, *(k - 1));
                    --k;
                }
            }
        }
        return;
    }
    I pivot = first + n / 2;
    swap(*pivot, *(last - 1));
    I store = first;
    for (I i = first; i != last - 1; ++i) {
        if (*i < *(last - 1)) {
            swap(*i, *store);
            ++store;
        }
    }
    swap(*store, *(last - 1));
    sort(first, store);
    sort(store + 1, last);
}

template <typename I> I unique(I first, I last) {
    if (first == last) return last;
    I out = first;
    for (I i = first + 1; i != last; ++i)
        if (!(*i == *out)) {
            ++out;
            *out = *i;
        }
    return out + 1;
}


// Searching sorted ranges, by < or by a comparison.
template <typename I, typename T, typename C> I lower_bound(I first, I last, const T &value, C less) {
    long n = last - first;
    while (n > 0) {
        long half = n / 2;
        I middle = first + half;
        if (less(*middle, value)) { first = middle + 1; n -= half + 1; } else n = half;
    }
    return first;
}
template <typename I, typename T> I lower_bound(I first, I last, const T &value) {
    return lower_bound(first, last, value, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename T, typename C> I upper_bound(I first, I last, const T &value, C less) {
    long n = last - first;
    while (n > 0) {
        long half = n / 2;
        I middle = first + half;
        if (!less(value, *middle)) { first = middle + 1; n -= half + 1; } else n = half;
    }
    return first;
}
template <typename I, typename T> I upper_bound(I first, I last, const T &value) {
    return upper_bound(first, last, value, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename T, typename C> bool binary_search(I first, I last, const T &value, C less) {
    I at = lower_bound(first, last, value, less);
    return at != last && !less(value, *at);
}
template <typename I, typename T> bool binary_search(I first, I last, const T &value) {
    I at = lower_bound(first, last, value);
    return at != last && !(value < *at);
}
template <typename I, typename T> pair<I, I> equal_range(I first, I last, const T &value) {
    return pair<I, I>(lower_bound(first, last, value), upper_bound(first, last, value));
}
template <typename I, typename C> bool is_sorted(I first, I last, C less) {
    if (first == last) return true;
    for (I next = first + 1; next != last; ++first, ++next)
        if (less(*next, *first)) return false;
    return true;
}
template <typename I> bool is_sorted(I first, I last) {
    return is_sorted(first, last, [](const auto &a, const auto &b) { return a < b; });
}

// Extremes.
template <typename T, typename C> constexpr const T &min(const T &a, const T &b, C less) { return less(b, a) ? b : a; }
template <typename T, typename C> constexpr const T &max(const T &a, const T &b, C less) { return less(a, b) ? b : a; }
template <typename T> constexpr T min(initializer_list<T> list) {
    const T *at = list.begin();
    T best = *at;
    for (++at; at != list.end(); ++at)
        if (*at < best) best = *at;
    return best;
}
template <typename T> constexpr T max(initializer_list<T> list) {
    const T *at = list.begin();
    T best = *at;
    for (++at; at != list.end(); ++at)
        if (best < *at) best = *at;
    return best;
}
template <typename T> constexpr pair<const T &, const T &> minmax(const T &a, const T &b) {
    return b < a ? pair<const T &, const T &>(b, a) : pair<const T &, const T &>(a, b);
}
template <typename T> constexpr const T &clamp(const T &v, const T &low, const T &high) { return v < low ? low : high < v ? high : v; }
template <typename I, typename C> I min_element(I first, I last, C less) {
    if (first == last) return last;
    I best = first;
    for (++first; first != last; ++first)
        if (less(*first, *best)) best = first;
    return best;
}
template <typename I> I min_element(I first, I last) { return min_element(first, last, [](const auto &a, const auto &b) { return a < b; }); }
template <typename I, typename C> I max_element(I first, I last, C less) {
    if (first == last) return last;
    I best = first;
    for (++first; first != last; ++first)
        if (less(*best, *first)) best = first;
    return best;
}
template <typename I> I max_element(I first, I last) { return max_element(first, last, [](const auto &a, const auto &b) { return a < b; }); }

// Predicates over ranges.
template <typename I, typename P> bool any_of(I first, I last, P test) {
    for (; first != last; ++first)
        if (test(*first)) return true;
    return false;
}
template <typename I, typename P> bool all_of(I first, I last, P test) {
    for (; first != last; ++first)
        if (!test(*first)) return false;
    return true;
}
template <typename I, typename P> bool none_of(I first, I last, P test) { return !any_of(first, last, test); }
template <typename I, typename P> I find_if_not(I first, I last, P test) {
    for (; first != last; ++first)
        if (!test(*first)) return first;
    return last;
}
template <typename I> I adjacent_find(I first, I last) {
    if (first == last) return last;
    for (I next = first + 1; next != last; ++first, ++next)
        if (*first == *next) return first;
    return last;
}
template <typename I, typename J> pair<I, J> mismatch(I first, I last, J other) {
    while (first != last && *first == *other) { ++first; ++other; }
    return pair<I, J>(first, other);
}
template <typename I, typename J> bool lexicographical_compare(I first, I last, J first2, J last2) {
    for (; first != last && first2 != last2; ++first, ++first2) {
        if (*first < *first2) return true;
        if (*first2 < *first) return false;
    }
    return first == last && first2 != last2;
}

// Copies, moves and fills.
template <typename I, typename N, typename O> O copy_n(I first, N n, O out) {
    for (N i = 0; i < n; ++i, ++first, ++out) *out = *first;
    return out;
}
template <typename I, typename O, typename P> O copy_if(I first, I last, O out, P test) {
    for (; first != last; ++first)
        if (test(*first)) { *out = *first; ++out; }
    return out;
}
template <typename I, typename O> O copy_backward(I first, I last, O out) {
    while (first != last) *--out = *--last;
    return out;
}
template <typename I, typename O> O move(I first, I last, O out) {
    for (; first != last; ++first, ++out) *out = std::move(*first);
    return out;
}
template <typename I, typename O> O move_backward(I first, I last, O out) {
    while (first != last) *--out = std::move(*--last);
    return out;
}
template <typename O, typename N, typename T> O fill_n(O out, N n, const T &value) {
    for (N i = 0; i < n; ++i, ++out) *out = value;
    return out;
}
template <typename I, typename G> void generate(I first, I last, G make) {
    for (; first != last; ++first) *first = make();
}
template <typename I, typename T> void replace(I first, I last, const T &old, const T &value) {
    for (; first != last; ++first)
        if (*first == old) *first = value;
}
template <typename I, typename T> I remove(I first, I last, const T &value) {
    I out = first;
    for (; first != last; ++first)
        if (!(*first == value)) { *out = std::move(*first); ++out; }
    return out;
}
template <typename I> void iter_swap(I a, I b) { swap(*a, *b); }
template <typename I> I rotate(I first, I middle, I last) {
    if (first == middle) return last;
    if (middle == last) return first;
    reverse(first, middle);
    reverse(middle, last);
    reverse(first, last);
    return first + (last - middle);
}
template <typename I, typename C> void stable_sort(I first, I last, C less) {
    for (I i = first; i != last; ++i)
        for (I j = i; j != first && less(*j, *(j - 1)); --j) swap(*j, *(j - 1));
}
template <typename I> void stable_sort(I first, I last) { stable_sort(first, last, [](const auto &a, const auto &b) { return a < b; }); }

// C++20's ranges, over a range's begin and end (the common ones).
namespace ranges {
template <typename R> auto begin(R &&r) { return std::begin(r); }
template <typename R> auto end(R &&r) { return std::end(r); }
template <typename R> auto size(R &&r) { return std::size(r); }
template <typename R> void sort(R &&r) { std::sort(std::begin(r), std::end(r)); }
template <typename R, typename C> void sort(R &&r, C less) { std::sort(std::begin(r), std::end(r), less); }
// (With a projection: `ranges::sort(nodes, { }, &Node::cell)`, the
// comparison of the elements' projections; `{ }` for `<`.)
struct __less_any { template <class A, class B> constexpr bool operator()(const A &a, const B &b) const { return a < b; } };
template <class P, class X> constexpr auto __project(const P &p, X &x) { return p(x); }
template <class M, class C, class X> constexpr const M &__project(M C::*pm, X &x) { return x.*pm; }
template <typename R, typename C = __less_any, typename P> void sort(R &&r, C less, P proj) { std::sort(std::begin(r), std::end(r), [&](const auto &a, const auto &b) { return less(__project(proj, a), __project(proj, b)); }); }
template <typename R> void reverse(R &&r) { std::reverse(std::begin(r), std::end(r)); }
template <typename R, typename T> void fill(R &&r, const T &value) { std::fill(std::begin(r), std::end(r), value); }
template <typename R, typename T> auto find(R &&r, const T &value) { return std::find(std::begin(r), std::end(r), value); }
template <typename R, typename P> auto find_if(R &&r, P test) { return std::find_if(std::begin(r), std::end(r), test); }
template <typename R, typename T> long count(R &&r, const T &value) { return std::count(std::begin(r), std::end(r), value); }
template <typename R, typename P> bool all_of(R &&r, P test) { return std::all_of(std::begin(r), std::end(r), test); }
template <typename R, typename P> bool any_of(R &&r, P test) { return std::any_of(std::begin(r), std::end(r), test); }
template <typename R, typename P> bool none_of(R &&r, P test) { return std::none_of(std::begin(r), std::end(r), test); }
template <typename R, typename T> auto lower_bound(R &&r, const T &value) { return std::lower_bound(std::begin(r), std::end(r), value); }
// (With a comparison and a projection: the first element whose
// projection is not less than the value.)
template <typename I, typename T, typename C, typename P> I lower_bound(I first, I last, const T &value, C less, P proj) {
    auto count = std::distance(first, last);
    while (count > 0) {
        auto step = count / 2;
        I mid = first;
        std::advance(mid, step);
        if (less(__project(proj, *mid), value)) {
            first = ++mid;
            count -= step + 1;
        } else
            count = step;
    }
    return first;
}
template <typename R, typename T, typename C> auto lower_bound(R &&r, const T &value, C less) { return std::lower_bound(std::begin(r), std::end(r), value, less); }
template <typename R, typename T, typename C, typename P> auto lower_bound(R &&r, const T &value, C less, P proj) { return ranges::lower_bound(std::begin(r), std::end(r), value, less, proj); }
template <typename R, typename T> bool binary_search(R &&r, const T &value) { return std::binary_search(std::begin(r), std::end(r), value); }
}

}
#endif
