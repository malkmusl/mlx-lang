// <optional>: std::optional (a value in place or none), nullopt,
// make_optional.
#ifndef __MLXCC_OPTIONAL
#define __MLXCC_OPTIONAL
#include <new>
#include <utility>
#include <type_traits>

namespace std {

struct nullopt_t { explicit constexpr nullopt_t(int) {} };
constexpr nullopt_t nullopt = nullopt_t(0);

template <class T> class optional {
public:
    typedef T value_type;
    optional() noexcept : _present(false) {}
    optional(nullopt_t) noexcept : _present(false) {}
    optional(const T &value) : _present(true) { new (storage()) T(value); }
    optional(T &&value) : _present(true) { new (storage()) T(move(value)); }
    template <class... Args> explicit optional(in_place_t, Args &&... args) : _present(true) { new (storage()) T(forward<Args>(args)...); }
    optional(const optional &other) : _present(other._present) { if (_present) new (storage()) T(*other.storage()); }
    optional(optional &&other) : _present(other._present) { if (_present) new (storage()) T(move(*other.storage())); }
    template <class U> optional(const optional<U> &other) : _present(other.has_value()) { if (_present) new (storage()) T(*other); }
    // A value T is made from (`optional<uint64_t>` from a Checked<uint64_t>).
    template <class U, class = typename enable_if<!is_same<typename decay<U>::type, optional>::value && !is_same<typename decay<U>::type, T>::value && !is_same<typename decay<U>::type, in_place_t>::value && !is_same<typename decay<U>::type, nullopt_t>::value && is_constructible<T, U &&>::value>::type> optional(U &&value) : _present(true) { new (storage()) T(forward<U>(value)); }
    ~optional() { reset(); }
    optional &operator=(nullopt_t) noexcept { reset(); return *this; }
    optional &operator=(const optional &other) {
        if (this != &other) {
            if (_present && other._present) *storage() = *other.storage();
            else { reset(); if (other._present) { new (storage()) T(*other.storage()); _present = true; } }
        }
        return *this;
    }
    optional &operator=(optional &&other) {
        if (this != &other) {
            if (_present && other._present) *storage() = move(*other.storage());
            else { reset(); if (other._present) { new (storage()) T(move(*other.storage())); _present = true; } }
        }
        return *this;
    }
    template <class U> optional &operator=(U &&value) {
        if (_present) *storage() = forward<U>(value);
        else { new (storage()) T(forward<U>(value)); _present = true; }
        return *this;
    }
    template <class... Args> T &emplace(Args &&... args) {
        reset();
        new (storage()) T(forward<Args>(args)...);
        _present = true;
        return *storage();
    }
    void reset() noexcept { if (_present) { storage()->~T(); _present = false; } }
    void swap(optional &other) {
        if (_present && other._present) std::swap(*storage(), *other.storage());
        else if (_present) { other.emplace(move(*storage())); reset(); }
        else if (other._present) { emplace(move(*other.storage())); other.reset(); }
    }
    constexpr bool has_value() const noexcept { return _present; }
    constexpr explicit operator bool() const noexcept { return _present; }
    T &value() & { return *storage(); }
    const T &value() const & { return *storage(); }
    T &&value() && { return move(*storage()); }
    T &operator*() & { return *storage(); }
    const T &operator*() const & { return *storage(); }
    T &&operator*() && { return move(*storage()); }
    T *operator->() { return storage(); }
    const T *operator->() const { return storage(); }
    template <class U> T value_or(U &&fallback) const & { return _present ? *storage() : T(forward<U>(fallback)); }
    template <class U> T value_or(U &&fallback) && { return _present ? move(*storage()) : T(forward<U>(fallback)); }
private:
    T *storage() { return reinterpret_cast<T *>(_storage); }
    const T *storage() const { return reinterpret_cast<const T *>(_storage); }
    alignas(T) unsigned char _storage[sizeof(T)];
    bool _present;
};

template <class T> bool operator==(const optional<T> &a, const optional<T> &b) {
    if (a.has_value() != b.has_value()) return false;
    return !a.has_value() || *a == *b;
}
template <class T> bool operator!=(const optional<T> &a, const optional<T> &b) { return !(a == b); }
template <class T> bool operator==(const optional<T> &a, nullopt_t) noexcept { return !a.has_value(); }
template <class T> bool operator==(nullopt_t, const optional<T> &a) noexcept { return !a.has_value(); }
template <class T> bool operator!=(const optional<T> &a, nullopt_t) noexcept { return a.has_value(); }
template <class T> bool operator!=(nullopt_t, const optional<T> &a) noexcept { return a.has_value(); }
template <class T, class U> bool operator==(const optional<T> &a, const U &b) { return a.has_value() && *a == b; }
template <class T, class U> bool operator!=(const optional<T> &a, const U &b) { return !a.has_value() || !(*a == b); }
template <class T> optional<typename decay<T>::type> make_optional(T &&value) { return optional<typename decay<T>::type>(forward<T>(value)); }
template <class T, class... Args> optional<T> make_optional(Args &&... args) { return optional<T>(in_place, forward<Args>(args)...); }


template <class T> optional(T) -> optional<T>;
}
#endif
