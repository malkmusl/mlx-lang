// <memory>: std::unique_ptr (one owner; a copy takes the pointer over,
// as a move would: mlx-cc does not tell && from &, and std::move is
// the identity), std::shared_ptr (counted owners), make_unique and
// make_shared for one argument or none.
#ifndef __MLXCC_MEMORY
#define __MLXCC_MEMORY
#include <stddef.h>
#include <utility>

namespace std {

template <typename T> class unique_ptr {
public:
    typedef T element_type;
    unique_ptr() : held(0) {}
    unique_ptr(T *p) : held(p) {}
    unique_ptr(unique_ptr &other) : held(other.release()) {}
    unique_ptr(const unique_ptr &other) : held(const_cast<unique_ptr &>(other).release()) {}
    ~unique_ptr() { delete held; }
    unique_ptr &operator=(unique_ptr &other) { reset(other.release()); return *this; }
    unique_ptr &operator=(const unique_ptr &other) { reset(const_cast<unique_ptr &>(other).release()); return *this; }
    T *get() const { return held; }
    T *release() { T *p = held; held = 0; return p; }
    void reset(T *p = 0) { T *old = held; held = p; delete old; }
    void swap(unique_ptr &other) { T *p = held; held = other.held; other.held = p; }
    T &operator*() const { return *held; }
    T *operator->() const { return held; }
    operator bool() const { return held != 0; }
private:
    T *held;
};

template <typename T> bool operator==(const unique_ptr<T> &a, const unique_ptr<T> &b) { return a.get() == b.get(); }
template <typename T> bool operator!=(const unique_ptr<T> &a, const unique_ptr<T> &b) { return a.get() != b.get(); }

template <typename T> unique_ptr<T> make_unique() { return unique_ptr<T>(new T()); }
template <typename T, typename A> unique_ptr<T> make_unique(const A &a) { return unique_ptr<T>(new T(a)); }
template <typename T, typename A, typename B> unique_ptr<T> make_unique(const A &a, const B &b) { return unique_ptr<T>(new T(a, b)); }

template <typename T> class shared_ptr {
public:
    typedef T element_type;
    shared_ptr() : held(0), owners(0) {}
    shared_ptr(T *p) : held(p), owners(p ? new long(1) : 0) {}
    shared_ptr(const shared_ptr &other) : held(other.held), owners(other.owners) { if (owners) ++*owners; }
    ~shared_ptr() { drop(); }
    shared_ptr &operator=(const shared_ptr &other) {
        if (this != &other) {
            if (other.owners) ++*other.owners;
            drop();
            held = other.held;
            owners = other.owners;
        }
        return *this;
    }
    T *get() const { return held; }
    long use_count() const { return owners ? *owners : 0; }
    bool unique() const { return use_count() == 1; }
    void reset() { drop(); held = 0; owners = 0; }
    void reset(T *p) { drop(); held = p; owners = p ? new long(1) : 0; }
    void swap(shared_ptr &other) {
        T *p = held; held = other.held; other.held = p;
        long *o = owners; owners = other.owners; other.owners = o;
    }
    T &operator*() const { return *held; }
    T *operator->() const { return held; }
    operator bool() const { return held != 0; }
private:
    T *held;
    long *owners;
    void drop() {
        if (owners && --*owners == 0) {
            delete held;
            delete owners;
        }
    }
};

template <typename T> bool operator==(const shared_ptr<T> &a, const shared_ptr<T> &b) { return a.get() == b.get(); }
template <typename T> bool operator!=(const shared_ptr<T> &a, const shared_ptr<T> &b) { return a.get() != b.get(); }

template <typename T> shared_ptr<T> make_shared() { return shared_ptr<T>(new T()); }
template <typename T, typename A> shared_ptr<T> make_shared(const A &a) { return shared_ptr<T>(new T(a)); }
template <typename T, typename A, typename B> shared_ptr<T> make_shared(const A &a, const B &b) { return shared_ptr<T>(new T(a, b)); }

}
#endif
