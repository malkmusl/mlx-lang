// <memory>: std::unique_ptr (one owner; a copy takes the pointer over,
// as a move would: mlx-cc does not tell && from &, and std::move is
// the identity), std::shared_ptr (counted owners), make_unique and
// make_shared for one argument or none.
#ifndef __MLXCC_MEMORY
#define __MLXCC_MEMORY
#include <stddef.h>
#include <new>
#include <utility>
#include <type_traits>

namespace std {

template <class T> T *addressof(T &t) noexcept { return &t; }
template <class T, class... Args> T *construct_at(T *p, Args &&... args) { return new (p) T(forward<Args>(args)...); }
template <class T> void destroy_at(T *p) { p->~T(); }
template <class It> void destroy(It first, It last) { for (; first != last; ++first) destroy_at(&*first); }
template <class It, class N> It destroy_n(It first, N n) { for (; n > 0; ++first, --n) destroy_at(&*first); return first; }

// The uninitialized algorithms: objects made in raw memory at `d`, as
// placement new (the element type is the destination's).
template <class It> using __uninit_value = typename remove_cv<typename remove_reference<decltype(*declval<It &>())>::type>::type;
template <class I, class O> O uninitialized_copy(I first, I last, O d) {
    for (; first != last; ++first, ++d) ::new (static_cast<void *>(&*d)) __uninit_value<O>(*first);
    return d;
}
template <class I, class N, class O> O uninitialized_copy_n(I first, N n, O d) {
    for (; n > 0; ++first, ++d, --n) ::new (static_cast<void *>(&*d)) __uninit_value<O>(*first);
    return d;
}
template <class I, class O> O uninitialized_move(I first, I last, O d) {
    for (; first != last; ++first, ++d) ::new (static_cast<void *>(&*d)) __uninit_value<O>(std::move(*first));
    return d;
}
template <class I, class N, class O> pair<I, O> uninitialized_move_n(I first, N n, O d) {
    for (; n > 0; ++first, ++d, --n) ::new (static_cast<void *>(&*d)) __uninit_value<O>(std::move(*first));
    return pair<I, O>(first, d);
}
template <class O, class T> void uninitialized_fill(O first, O last, const T &value) {
    for (; first != last; ++first) ::new (static_cast<void *>(&*first)) __uninit_value<O>(value);
}
template <class O, class N, class T> O uninitialized_fill_n(O first, N n, const T &value) {
    for (; n > 0; ++first, --n) ::new (static_cast<void *>(&*first)) __uninit_value<O>(value);
    return first;
}
template <class O> void uninitialized_default_construct(O first, O last) {
    for (; first != last; ++first) ::new (static_cast<void *>(&*first)) __uninit_value<O>;
}
template <class O, class N> O uninitialized_default_construct_n(O first, N n) {
    for (; n > 0; ++first, --n) ::new (static_cast<void *>(&*first)) __uninit_value<O>;
    return first;
}
template <class O> void uninitialized_value_construct(O first, O last) {
    for (; first != last; ++first) ::new (static_cast<void *>(&*first)) __uninit_value<O>();
}
template <class O, class N> O uninitialized_value_construct_n(O first, N n) {
    for (; n > 0; ++first, --n) ::new (static_cast<void *>(&*first)) __uninit_value<O>();
    return first;
}

template <class T> T *launder(T *p) noexcept { return p; }
template <class T> T *to_address(T *p) noexcept { return p; }
template <class P> auto to_address(const P &p) noexcept -> decltype(p.get()) { return p.get(); }

template <class T> struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class U> default_delete(const default_delete<U> &) noexcept {}
    void operator()(T *p) const { delete p; }
};
template <class T> struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;
    void operator()(T *p) const { delete[] p; }
};

// The deleter a unique_ptr holds: an empty one as a base (no room
// taken), any other as a member.
template <class D, bool = __is_empty(D) && !__is_final(D)> struct __deleter_box : D {
    __deleter_box() {}
    __deleter_box(const D &d) : D(d) {}
    D &deleter() { return *this; }
    const D &deleter() const { return *this; }
};
template <class D> struct __deleter_box<D, false> {
    D held_deleter;
    __deleter_box() : held_deleter() {}
    __deleter_box(const D &d) : held_deleter(d) {}
    D &deleter() { return held_deleter; }
    const D &deleter() const { return held_deleter; }
};

template <typename T, class D = default_delete<T> > class unique_ptr : private __deleter_box<D> {
    typedef __deleter_box<D> box_;
public:
    typedef T element_type;
    typedef T *pointer;
    typedef D deleter_type;
    unique_ptr() : held(0) {}
    unique_ptr(nullptr_t) : held(0) {}
    explicit unique_ptr(T *p) : held(p) {}
    unique_ptr(T *p, const D &d) : box_(d), held(p) {}
    unique_ptr(unique_ptr &&other) : box_(other.get_deleter()), held(other.release()) {}
    template <class U, class E> unique_ptr(unique_ptr<U, E> &&other) : box_(D(other.get_deleter())), held(other.release()) {}
    unique_ptr(const unique_ptr &) = delete;
    ~unique_ptr() { if (held) get_deleter()(held); }
    unique_ptr &operator=(unique_ptr &&other) { reset(other.release()); get_deleter() = other.get_deleter(); return *this; }
    template <class U, class E> unique_ptr &operator=(unique_ptr<U, E> &&other) { reset(other.release()); get_deleter() = D(other.get_deleter()); return *this; }
    unique_ptr &operator=(nullptr_t) { reset(); return *this; }
    unique_ptr &operator=(const unique_ptr &) = delete;
    D &get_deleter() { return box_::deleter(); }
    const D &get_deleter() const { return box_::deleter(); }
    T *get() const { return held; }
    T *release() { T *p = held; held = 0; return p; }
    void reset(T *p = 0) { T *old = held; held = p; if (old) get_deleter()(old); }
    void swap(unique_ptr &other) { T *p = held; held = other.held; other.held = p; D d = get_deleter(); get_deleter() = other.get_deleter(); other.get_deleter() = d; }
    T &operator*() const { return *held; }
    T *operator->() const { return held; }
    operator bool() const { return held != 0; }
private:
    T *held;
};

// An array's owner: `unique_ptr<T[]>`, `p[i]`, deleted by `delete[]`.
template <typename T, class D> class unique_ptr<T[], D> : private __deleter_box<D> {
    typedef __deleter_box<D> box_;
public:
    typedef T element_type;
    typedef T *pointer;
    typedef D deleter_type;
    unique_ptr() : held(0) {}
    unique_ptr(nullptr_t) : held(0) {}
    explicit unique_ptr(T *p) : held(p) {}
    unique_ptr(T *p, const D &d) : box_(d), held(p) {}
    unique_ptr(unique_ptr &&other) : box_(other.get_deleter()), held(other.release()) {}
    unique_ptr(const unique_ptr &) = delete;
    ~unique_ptr() { if (held) get_deleter()(held); }
    unique_ptr &operator=(unique_ptr &&other) { reset(other.release()); get_deleter() = other.get_deleter(); return *this; }
    unique_ptr &operator=(nullptr_t) { reset(); return *this; }
    unique_ptr &operator=(const unique_ptr &) = delete;
    D &get_deleter() { return box_::deleter(); }
    const D &get_deleter() const { return box_::deleter(); }
    T *get() const { return held; }
    T *release() { T *p = held; held = 0; return p; }
    void reset(T *p = 0) { T *old = held; held = p; if (old) get_deleter()(old); }
    void swap(unique_ptr &other) { T *p = held; held = other.held; other.held = p; D d = get_deleter(); get_deleter() = other.get_deleter(); other.get_deleter() = d; }
    T &operator[](size_t i) const { return held[i]; }
    operator bool() const { return held != 0; }
private:
    T *held;
};

template <typename T> bool operator==(const unique_ptr<T> &a, const unique_ptr<T> &b) { return a.get() == b.get(); }
template <typename T> bool operator!=(const unique_ptr<T> &a, const unique_ptr<T> &b) { return a.get() != b.get(); }

template <typename T, class... Args> unique_ptr<T> make_unique(Args &&... args) requires (!is_array_v<T>) { return unique_ptr<T>(new T(forward<Args>(args)...)); }
template <typename T> unique_ptr<T> make_unique(size_t n) requires is_array_v<T> { return unique_ptr<T>(new remove_extent_t<T>[n]()); }
template <typename T> bool operator==(const unique_ptr<T> &a, nullptr_t) { return a.get() == 0; }
template <typename T> bool operator!=(const unique_ptr<T> &a, nullptr_t) { return a.get() != 0; }

template <typename T> class shared_ptr {
public:
    typedef T element_type;
    shared_ptr() : held(0), owners(0) {}
    shared_ptr(T *p) : held(p), owners(p ? new long(1) : 0) {}
    shared_ptr(const shared_ptr &other) : held(other.held), owners(other.owners) { if (owners) ++*owners; }
    shared_ptr(shared_ptr &&other) : held(other.held), owners(other.owners) { other.held = 0; other.owners = 0; }
    template <class U> shared_ptr(const shared_ptr<U> &other) : held(other.get()), owners(other.ownersCell()) { if (owners) ++*owners; }
    long *ownersCell() const { return owners; }
    ~shared_ptr() { drop(); }
    shared_ptr &operator=(const shared_ptr &other) {
        if (this != &other) {
            if (other.owners) ++*other.owners;
            drop();
            held = other.held;
            owners = other.owners;
        }
        return *this;
    }
    T *get() const { return held; }
    long use_count() const { return owners ? *owners : 0; }
    bool unique() const { return use_count() == 1; }
    void reset() { drop(); held = 0; owners = 0; }
    void reset(T *p) { drop(); held = p; owners = p ? new long(1) : 0; }
    void swap(shared_ptr &other) {
        T *p = held; held = other.held; other.held = p;
        long *o = owners; owners = other.owners; other.owners = o;
    }
    T &operator*() const { return *held; }
    T *operator->() const { return held; }
    operator bool() const { return held != 0; }
private:
    T *held;
    long *owners;
    void drop() {
        if (owners && --*owners == 0) {
            delete held;
            delete owners;
        }
    }
};

template <typename T> bool operator==(const shared_ptr<T> &a, const shared_ptr<T> &b) { return a.get() == b.get(); }
template <typename T> bool operator!=(const shared_ptr<T> &a, const shared_ptr<T> &b) { return a.get() != b.get(); }

template <typename T, class... Args> shared_ptr<T> make_shared(Args &&... args) { return shared_ptr<T>(new T(forward<Args>(args)...)); }

}
#endif
