// <set>: std::set, keys sorted in a vector (found by binary search,
// inserted in place), with pointers to the keys as iterators. As with
// <map>, an insertion or erasure moves the keys after it. Keys compare
// with <.
#ifndef __MLXCC_SET
#define __MLXCC_SET
#include <stddef.h>
#include <utility>
#include <vector>

namespace std {

template <typename K> class set {
public:
    typedef K key_type;
    typedef K value_type;
    typedef const K *iterator;
    typedef const K *const_iterator;

    set() {}
    set(const set &other) : items(other.items) {}
    set &operator=(const set &other) { items = other.items; return *this; }

    size_t size() const { return items.size(); }
    bool empty() const { return items.empty(); }
    iterator begin() const { return items.begin(); }
    iterator end() const { return items.end(); }
    void clear() { items.clear(); }

    iterator lower_bound(const K &key) const {
        size_t low = 0, high = items.size();
        while (low < high) {
            size_t mid = (low + high) / 2;
            if (items[mid] < key) low = mid + 1; else high = mid;
        }
        return items.begin() + low;
    }
    iterator find(const K &key) const {
        iterator it = lower_bound(key);
        if (it != end() && !(key < *it)) return it;
        return end();
    }
    size_t count(const K &key) const { return find(key) == end() ? 0 : 1; }
    pair<iterator, bool> insert(const K &key) {
        size_t index = lower_bound(key) - begin();
        if (index < items.size() && !(key < items[index])) return pair<iterator, bool>(begin() + index, false);
        items.insert(items.begin() + index, key);
        return pair<iterator, bool>(begin() + index, true);
    }
    size_t erase(const K &key) {
        iterator it = find(key);
        if (it == end()) return 0;
        items.erase(items.begin() + (it - begin()));
        return 1;
    }
    iterator erase(iterator it) {
        size_t index = it - begin();
        items.erase(items.begin() + index);
        return begin() + index;
    }
    void swap(set &other) { items.swap(other.items); }

private:
    vector<K> items;
};

}
#endif
