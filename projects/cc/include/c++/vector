// <vector>: std::vector, a growing array of T (grown by doubling), with
// pointers as iterators. Elements are made and unmade as C++ asks: a
// pushed element is copied in, pop_back and clear destroy them, erase
// shifts the ones after. No allocator parameter.
#ifndef __MLXCC_VECTOR
#define __MLXCC_VECTOR
#include <stddef.h>
#include <new>

namespace std {

template <typename T> class vector {
public:
    typedef T value_type;
    typedef T *iterator;
    typedef const T *const_iterator;
    typedef size_t size_type;

    vector() : items(0), count(0), room(0) {}
    vector(size_t n) : items(0), count(0), room(0) { resize(n); }
    vector(size_t n, const T &value) : items(0), count(0), room(0) { assign(n, value); }
    vector(const vector &other) : items(0), count(0), room(0) {
        reserve(other.count);
        for (size_t i = 0; i < other.count; i++) push_back(other.items[i]);
    }
    ~vector() {
        clear();
        operator delete(items);
    }
    vector &operator=(const vector &other) {
        if (this != &other) {
            clear();
            reserve(other.count);
            for (size_t i = 0; i < other.count; i++) push_back(other.items[i]);
        }
        return *this;
    }

    size_t size() const { return count; }
    size_t capacity() const { return room; }
    bool empty() const { return count == 0; }
    T &operator[](size_t index) { return items[index]; }
    const T &operator[](size_t index) const { return items[index]; }
    T &at(size_t index) { return items[index]; }
    const T &at(size_t index) const { return items[index]; }
    T &front() { return items[0]; }
    T &back() { return items[count - 1]; }
    const T &front() const { return items[0]; }
    const T &back() const { return items[count - 1]; }
    T *data() { return items; }
    const T *data() const { return items; }
    T *begin() { return items; }
    T *end() { return items + count; }
    const T *begin() const { return items; }
    const T *end() const { return items + count; }

    void reserve(size_t wanted) {
        if (wanted <= room) return;
        T *more = (T *)operator new(wanted * sizeof(T));
        for (size_t i = 0; i < count; i++) {
            new (more + i) T(items[i]);
            items[i].~T();
        }
        operator delete(items);
        items = more;
        room = wanted;
    }
    void push_back(const T &value) {
        if (count == room) reserve(room ? room * 2 : 4);
        new (items + count) T(value);
        count++;
    }
    void pop_back() {
        count--;
        items[count].~T();
    }
    void clear() {
        // First to last, as libstdc++ does.
        for (size_t i = 0; i < count; i++) items[i].~T();
        count = 0;
    }
    void resize(size_t wanted) {
        while (count > wanted) pop_back();
        if (wanted > count) {
            reserve(wanted);
            while (count < wanted) {
                new (items + count) T();
                count++;
            }
        }
    }
    void resize(size_t wanted, const T &value) {
        while (count > wanted) pop_back();
        if (wanted > count) {
            reserve(wanted);
            while (count < wanted) push_back(value);
        }
    }
    void assign(size_t n, const T &value) {
        clear();
        reserve(n);
        while (count < n) push_back(value);
    }
    T *insert(T *where, const T &value) {
        size_t index = where - items;
        push_back(value);
        for (size_t i = count - 1; i > index; i--) {
            T moved(items[i - 1]);
            items[i] = moved;
        }
        items[index] = value;
        return items + index;
    }
    T *erase(T *where) {
        size_t index = where - items;
        for (size_t i = index + 1; i < count; i++) items[i - 1] = items[i];
        pop_back();
        return items + index;
    }
    T *erase(T *from, T *to) {
        size_t index = from - items;
        size_t n = to - from;
        for (size_t i = index + n; i < count; i++) items[i - n] = items[i];
        while (n-- > 0) pop_back();
        return items + index;
    }
    void swap(vector &other) {
        T *i = items; items = other.items; other.items = i;
        size_t c = count; count = other.count; other.count = c;
        size_t r = room; room = other.room; other.room = r;
    }

private:
    T *items;
    size_t count;
    size_t room;
};

template <typename T> bool operator==(const vector<T> &a, const vector<T> &b) {
    if (a.size() != b.size()) return false;
    for (size_t i = 0; i < a.size(); i++)
        if (!(a[i] == b[i])) return false;
    return true;
}

template <typename T> bool operator!=(const vector<T> &a, const vector<T> &b) { return !(a == b); }

}
#endif
