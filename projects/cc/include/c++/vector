// <vector>: std::vector, a growing array of T (grown by doubling), with
// pointers as iterators. Elements are made and unmade as C++ asks: a
// pushed element is copied or moved in, a reallocation moves them, pop_back
// and clear destroy them, erase shifts the ones after. The allocator
// parameter is taken (and given back by get_allocator) but the elements
// live in memory of operator new (<__allocator>).
#ifndef __MLXCC_VECTOR
#define __MLXCC_VECTOR
#include <stddef.h>
#include <new>
#include <initializer_list>
#include <type_traits>
#include <utility>
#include <iterator>
#include <__allocator>

namespace std {

template <typename T, typename Alloc = allocator<T> > class vector {
public:
    typedef T value_type;
    typedef Alloc allocator_type;
    typedef T &reference;
    typedef const T &const_reference;
    typedef T *pointer;
    typedef const T *const_pointer;
    typedef T *iterator;
    typedef const T *const_iterator;
    typedef std::reverse_iterator<T *> reverse_iterator;
    typedef std::reverse_iterator<const T *> const_reverse_iterator;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;

    vector() noexcept : items(0), count(0), room(0) {}
    explicit vector(const Alloc &) noexcept : items(0), count(0), room(0) {}
    explicit vector(size_t n, const Alloc & = Alloc()) : items(0), count(0), room(0) { resize(n); }
    vector(size_t n, const T &value, const Alloc & = Alloc()) : items(0), count(0), room(0) { assign(n, value); }
    vector(initializer_list<T> list, const Alloc & = Alloc()) : items(0), count(0), room(0) {
        reserve(list.size());
        for (const T *at = list.begin(); at != list.end(); ++at) push_back(*at);
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> vector(It first, It last, const Alloc & = Alloc()) : items(0), count(0), room(0) {
        for (; first != last; ++first) emplace_back(*first);
    }
    vector(const vector &other) : items(0), count(0), room(0) {
        reserve(other.count);
        for (size_t i = 0; i < other.count; i++) push_back(other.items[i]);
    }
    vector(const vector &other, const Alloc &) : vector(other) {}
    vector(vector &&other) noexcept : items(other.items), count(other.count), room(other.room) {
        other.items = 0;
        other.count = 0;
        other.room = 0;
    }
    vector(vector &&other, const Alloc &) noexcept : vector(static_cast<vector &&>(other)) {}
    ~vector() {
        clear();
        ::operator delete(items);
    }
    vector &operator=(const vector &other) {
        if (this != &other) {
            clear();
            reserve(other.count);
            for (size_t i = 0; i < other.count; i++) push_back(other.items[i]);
        }
        return *this;
    }
    vector &operator=(vector &&other) noexcept {
        if (this != &other) {
            clear();
            ::operator delete(items);
            items = other.items;
            count = other.count;
            room = other.room;
            other.items = 0;
            other.count = 0;
            other.room = 0;
        }
        return *this;
    }
    vector &operator=(initializer_list<T> list) {
        assign(list);
        return *this;
    }
    allocator_type get_allocator() const noexcept { return allocator_type(); }

    size_t size() const noexcept { return count; }
    size_t capacity() const noexcept { return room; }
    size_t max_size() const noexcept { return size_t(-1) / sizeof(T); }
    bool empty() const noexcept { return count == 0; }
    T &operator[](size_t index) { return items[index]; }
    const T &operator[](size_t index) const { return items[index]; }
    T &at(size_t index) { return items[index]; }
    const T &at(size_t index) const { return items[index]; }
    T &front() { return items[0]; }
    T &back() { return items[count - 1]; }
    const T &front() const { return items[0]; }
    const T &back() const { return items[count - 1]; }
    T *data() noexcept { return items; }
    const T *data() const noexcept { return items; }
    T *begin() noexcept { return items; }
    T *end() noexcept { return items + count; }
    const T *begin() const noexcept { return items; }
    const T *end() const noexcept { return items + count; }
    const T *cbegin() const noexcept { return items; }
    const T *cend() const noexcept { return items + count; }
    reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
    reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
    const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
    const_reverse_iterator rend() const noexcept { return const_reverse_iterator(begin()); }
    const_reverse_iterator crbegin() const noexcept { return const_reverse_iterator(end()); }
    const_reverse_iterator crend() const noexcept { return const_reverse_iterator(begin()); }

    void reserve(size_t wanted) {
        if (wanted <= room) return;
        T *more = static_cast<T *>(::operator new(wanted * sizeof(T)));
        relocate(more);
        room = wanted;
    }
    void shrink_to_fit() {
        if (count == room) return;
        T *fewer = count ? static_cast<T *>(::operator new(count * sizeof(T))) : 0;
        relocate(fewer);
        room = count;
    }
    void push_back(const T &value) {
        if (count == room) {
            // (The value may be one of the elements: made before they move.)
            size_t wanted = room ? room * 2 : 4;
            T *more = static_cast<T *>(::operator new(wanted * sizeof(T)));
            ::new ((void *)(more + count)) T(value);
            relocate(more);
            room = wanted;
        } else {
            ::new ((void *)(items + count)) T(value);
        }
        count++;
    }
    void push_back(T &&value) { emplace_back(static_cast<T &&>(value)); }
    template <class... A> T &emplace_back(A &&... args) {
        if (count == room) {
            size_t wanted = room ? room * 2 : 4;
            T *more = static_cast<T *>(::operator new(wanted * sizeof(T)));
            ::new ((void *)(more + count)) T(std::forward<A>(args)...);
            relocate(more);
            room = wanted;
        } else {
            ::new ((void *)(items + count)) T(std::forward<A>(args)...);
        }
        count++;
        return items[count - 1];
    }
    void pop_back() {
        count--;
        items[count].~T();
    }
    void clear() noexcept {
        // First to last, as libstdc++ does.
        for (size_t i = 0; i < count; i++) items[i].~T();
        count = 0;
    }
    void resize(size_t wanted) {
        while (count > wanted) pop_back();
        if (wanted > count) {
            reserve(wanted);
            while (count < wanted) {
                ::new ((void *)(items + count)) T();
                count++;
            }
        }
    }
    void resize(size_t wanted, const T &value) {
        while (count > wanted) pop_back();
        if (wanted > count) {
            T copy(value);
            reserve(wanted);
            while (count < wanted) push_back(copy);
        }
    }
    void assign(size_t n, const T &value) {
        T copy(value);
        clear();
        reserve(n);
        while (count < n) push_back(copy);
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> void assign(It first, It last) {
        vector made(first, last);
        swap(made);
    }
    void assign(initializer_list<T> list) {
        clear();
        reserve(list.size());
        for (const T *at = list.begin(); at != list.end(); ++at) push_back(*at);
    }

    template <class... A> T *emplace(const T *where, A &&... args) {
        size_t index = where - items;
        if (index == count) {
            emplace_back(std::forward<A>(args)...);
            return items + index;
        }
        T made(std::forward<A>(args)...);
        size_t old = open(index, 1);
        put(index, old, static_cast<T &&>(made));
        return items + index;
    }
    T *insert(const T *where, const T &value) {
        size_t index = where - items;
        if (index == count) {
            push_back(value);
            return items + index;
        }
        T copy(value);
        size_t old = open(index, 1);
        put(index, old, static_cast<T &&>(copy));
        return items + index;
    }
    T *insert(const T *where, T &&value) { return emplace(where, static_cast<T &&>(value)); }
    T *insert(const T *where, size_t n, const T &value) {
        size_t index = where - items;
        if (n == 0) return items + index;
        T copy(value);
        size_t old = open(index, n);
        for (size_t i = 0; i < n; i++) put(index + i, old, copy);
        return items + index;
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> T *insert(const T *where, It first, It last) {
        size_t index = where - items;
        vector added(first, last);
        if (added.count == 0) return items + index;
        size_t old = open(index, added.count);
        for (size_t i = 0; i < added.count; i++) put(index + i, old, static_cast<T &&>(added.items[i]));
        return items + index;
    }
    T *insert(const T *where, initializer_list<T> list) { return insert(where, list.begin(), list.end()); }
    T *erase(const T *where) {
        size_t index = where - items;
        for (size_t i = index + 1; i < count; i++) items[i - 1] = static_cast<T &&>(items[i]);
        pop_back();
        return items + index;
    }
    T *erase(const T *from, const T *to) {
        size_t index = from - items;
        size_t n = to - from;
        if (n == 0) return items + index;
        for (size_t i = index + n; i < count; i++) items[i - n] = static_cast<T &&>(items[i]);
        while (n-- > 0) pop_back();
        return items + index;
    }
    void swap(vector &other) noexcept {
        T *i = items; items = other.items; other.items = i;
        size_t c = count; count = other.count; other.count = c;
        size_t r = room; room = other.room; other.room = r;
    }

private:
    T *items;
    size_t count;
    size_t room;

    // The elements moved into MORE (room enough), the old array freed.
    void relocate(T *more) {
        for (size_t i = 0; i < count; i++) {
            ::new ((void *)(more + i)) T(static_cast<T &&>(items[i]));
            items[i].~T();
        }
        ::operator delete(items);
        items = more;
    }
    // N places opened at INDEX (count grows by N): the elements from
    // INDEX on move N up. Returns the count before: the opened places
    // below it hold moved-from elements (assigned to), those from it on
    // are raw memory (constructed in) — what put() does.
    size_t open(size_t index, size_t n) {
        if (count + n > room) {
            size_t wanted = room ? room * 2 : 4;
            if (wanted < count + n) wanted = count + n;
            reserve(wanted);
        }
        size_t old = count;
        for (size_t i = old + n; i-- > old;) {
            if (i >= index + n) ::new ((void *)(items + i)) T(static_cast<T &&>(items[i - n]));
        }
        if (old > index + n) {
            for (size_t i = old; i-- > index + n;) items[i] = static_cast<T &&>(items[i - n]);
        }
        count = old + n;
        return old;
    }
    template <class V> void put(size_t at, size_t old, V &&value) {
        if (at < old) items[at] = std::forward<V>(value);
        else ::new ((void *)(items + at)) T(std::forward<V>(value));
    }
};

template <typename T, typename A> bool operator==(const vector<T, A> &a, const vector<T, A> &b) {
    if (a.size() != b.size()) return false;
    for (size_t i = 0; i < a.size(); i++)
        if (!(a[i] == b[i])) return false;
    return true;
}
template <typename T, typename A> bool operator!=(const vector<T, A> &a, const vector<T, A> &b) { return !(a == b); }
template <typename T, typename A> bool operator<(const vector<T, A> &a, const vector<T, A> &b) {
    size_t n = a.size() < b.size() ? a.size() : b.size();
    for (size_t i = 0; i < n; i++) {
        if (a[i] < b[i]) return true;
        if (b[i] < a[i]) return false;
    }
    return a.size() < b.size();
}
template <typename T, typename A> bool operator>(const vector<T, A> &a, const vector<T, A> &b) { return b < a; }
template <typename T, typename A> bool operator<=(const vector<T, A> &a, const vector<T, A> &b) { return !(b < a); }
template <typename T, typename A> bool operator>=(const vector<T, A> &a, const vector<T, A> &b) { return !(a < b); }
template <typename T, typename A> void swap(vector<T, A> &a, vector<T, A> &b) noexcept { a.swap(b); }
template <typename T, typename A, class U> size_t erase(vector<T, A> &v, const U &value) {
    size_t before = v.size();
    size_t kept = 0;
    for (size_t i = 0; i < before; i++) {
        if (!(v[i] == value)) {
            if (kept != i) v[kept] = static_cast<T &&>(v[i]);
            kept++;
        }
    }
    v.erase(v.begin() + kept, v.end());
    return before - kept;
}
template <typename T, typename A, class P> size_t erase_if(vector<T, A> &v, P predicate) {
    size_t before = v.size();
    size_t kept = 0;
    for (size_t i = 0; i < before; i++) {
        if (!predicate(v[i])) {
            if (kept != i) v[kept] = static_cast<T &&>(v[i]);
            kept++;
        }
    }
    v.erase(v.begin() + kept, v.end());
    return before - kept;
}

}
#endif
