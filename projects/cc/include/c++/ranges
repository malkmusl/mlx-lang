// <ranges>: the range concepts over begin() and end(), range_value_t
// and the other aliases (the views are not here).
#ifndef __MLXCC_RANGES
#define __MLXCC_RANGES
#include <iterator>
#include <concepts>

namespace std {
namespace ranges {

template <class R> concept range = requires(R &r) { begin(r); end(r); };
template <class R> concept input_range = range<R>;
template <class R> concept forward_range = range<R>;
template <class R> concept bidirectional_range = range<R>;
template <class R> concept random_access_range = range<R>;
template <class R> concept contiguous_range = range<R> && requires(R &r) { data(r); };
template <class R> concept sized_range = range<R> && requires(R &r) { size(r); };
template <class R> concept borrowed_range = range<R>;
template <class R> concept view = range<R>;
template <class R> using iterator_t = decltype(begin(declval<R &>()));
template <class R> using sentinel_t = decltype(end(declval<R &>()));
template <class R> using range_value_t = typename iterator_traits<iterator_t<R> >::value_type;
template <class R> using range_reference_t = decltype(*begin(declval<R &>()));
template <class R> using range_difference_t = typename iterator_traits<iterator_t<R> >::difference_type;
template <class R> using range_size_t = decltype(size(declval<R &>()));

using std::begin;
using std::end;
using std::size;
using std::data;
using std::empty;
using std::distance;

}
}
#endif
