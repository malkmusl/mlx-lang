// <cstddef>: C's <stddef.h> in namespace std, with nullptr_t and byte.
#ifndef __MLXCC_CSTDDEF
#define __MLXCC_CSTDDEF
#include <stddef.h>
namespace std {
using ::size_t;
using ::ptrdiff_t;
using ::max_align_t;
typedef decltype(nullptr) nullptr_t;
enum class byte : unsigned char {};
template <class I> constexpr byte operator<<(byte b, I shift) noexcept { return byte(static_cast<unsigned char>(static_cast<unsigned>(b) << shift)); }
template <class I> constexpr byte operator>>(byte b, I shift) noexcept { return byte(static_cast<unsigned char>(static_cast<unsigned>(b) >> shift)); }
constexpr byte operator|(byte a, byte b) noexcept { return byte(static_cast<unsigned char>(static_cast<unsigned>(a) | static_cast<unsigned>(b))); }
constexpr byte operator&(byte a, byte b) noexcept { return byte(static_cast<unsigned char>(static_cast<unsigned>(a) & static_cast<unsigned>(b))); }
constexpr byte operator^(byte a, byte b) noexcept { return byte(static_cast<unsigned char>(static_cast<unsigned>(a) ^ static_cast<unsigned>(b))); }
constexpr byte operator~(byte b) noexcept { return byte(static_cast<unsigned char>(~static_cast<unsigned>(b))); }
inline byte &operator|=(byte &a, byte b) noexcept { return a = a | b; }
inline byte &operator&=(byte &a, byte b) noexcept { return a = a & b; }
inline byte &operator^=(byte &a, byte b) noexcept { return a = a ^ b; }
template <class I> constexpr I to_integer(byte b) noexcept { return I(static_cast<unsigned char>(b)); }
}
#endif
