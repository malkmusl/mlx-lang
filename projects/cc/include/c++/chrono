constexpr chrono::minutes operator""min(unsigned long long v) { return chrono::minutes((long long)v); }
constexpr chrono::seconds operator""s(unsigned long long v) { return chrono::seconds((long long)v); }
constexpr chrono::milliseconds operator""ms(unsigned long long v) { return chrono::milliseconds((long long)v); }
constexpr chrono::microseconds operator""us(unsigned long long v) { return chrono::microseconds((long long)v); }
constexpr chrono::nanoseconds operator""ns(unsigned long long v) { return chrono::nanoseconds((long long)v); }
}
