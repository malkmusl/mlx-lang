// <chrono>: durations (a count of ticks of a period), time points, the
// clocks (system_clock, steady_clock, high_resolution_clock, file_clock
// over clock_gettime), duration_cast, time_point_cast and the literals
// (10ms, 2s).
#ifndef __MLXCC_CHRONO
#define __MLXCC_CHRONO
#include <time.h>
#include <ctime>
#include <stdint.h>
#include <ratio>
#include <type_traits>
#include <limits>

namespace std {
namespace chrono {

template <class Rep, class Period = ratio<1> > class duration;

template <class To, class Rep, class Period> constexpr To duration_cast(const duration<Rep, Period> &d) {
    typedef ratio_divide<Period, typename To::period> factor;
    typedef typename To::rep ToRep;
    return To((ToRep)((long double)d.count() * factor::num / factor::den));
}

template <class Rep, class Period> class duration {
public:
    typedef Rep rep;
    typedef typename Period::type period;
    constexpr duration() : _count() {}
    template <class Rep2> constexpr explicit duration(const Rep2 &count) : _count((Rep)count) {}
    template <class Rep2, class Period2> constexpr duration(const duration<Rep2, Period2> &other) : _count(duration_cast<duration>(other).count()) {}
    constexpr Rep count() const { return _count; }
    static constexpr duration zero() { return duration(0); }
    static constexpr duration min() { return duration(numeric_limits<Rep>::lowest()); }
    static constexpr duration max() { return duration(numeric_limits<Rep>::max()); }
    constexpr duration operator+() const { return *this; }
    constexpr duration operator-() const { return duration(-_count); }
    duration &operator++() { ++_count; return *this; }
    duration operator++(int) { duration before = *this; ++_count; return before; }
    duration &operator--() { --_count; return *this; }
    duration operator--(int) { duration before = *this; --_count; return before; }
    duration &operator+=(const duration &d) { _count += d.count(); return *this; }
    duration &operator-=(const duration &d) { _count -= d.count(); return *this; }
    duration &operator*=(const Rep &r) { _count *= r; return *this; }
    duration &operator/=(const Rep &r) { _count /= r; return *this; }
private:
    Rep _count;
};

typedef duration<long long, nano> nanoseconds;
typedef duration<long long, micro> microseconds;
typedef duration<long long, milli> milliseconds;
typedef duration<long long> seconds;
typedef duration<long long, ratio<60> > minutes;
typedef duration<long long, ratio<3600> > hours;
typedef duration<long long, ratio<86400> > days;
typedef duration<long long, ratio<604800> > weeks;

// Arithmetic and comparison in the finer of the two periods.
template <class R1, class P1, class R2, class P2> struct __duration_common {
    typedef duration<typename common_type<R1, R2>::type, ratio<__ratio_gcd(P1::num, P2::num), (P1::den / __ratio_gcd(P1::den, P2::den)) * P2::den> > type;
};
template <class R1, class P1, class R2, class P2>
constexpr typename __duration_common<R1, P1, R2, P2>::type operator+(const duration<R1, P1> &a, const duration<R2, P2> &b) {
    typedef typename __duration_common<R1, P1, R2, P2>::type C;
    return C(C(a).count() + C(b).count());
}
template <class R1, class P1, class R2, class P2>
constexpr typename __duration_common<R1, P1, R2, P2>::type operator-(const duration<R1, P1> &a, const duration<R2, P2> &b) {
    typedef typename __duration_common<R1, P1, R2, P2>::type C;
    return C(C(a).count() - C(b).count());
}
template <class R1, class P1, class R2> constexpr duration<R1, P1> operator*(const duration<R1, P1> &d, const R2 &r) { return duration<R1, P1>(d.count() * r); }
template <class R1, class P1, class R2> constexpr duration<R1, P1> operator*(const R2 &r, const duration<R1, P1> &d) { return duration<R1, P1>(d.count() * r); }
template <class R1, class P1, class R2> constexpr duration<R1, P1> operator/(const duration<R1, P1> &d, const R2 &r) { return duration<R1, P1>(d.count() / r); }
template <class R1, class P1, class R2, class P2> constexpr bool operator==(const duration<R1, P1> &a, const duration<R2, P2> &b) {
    typedef typename __duration_common<R1, P1, R2, P2>::type C;
    return C(a).count() == C(b).count();
}
template <class R1, class P1, class R2, class P2> constexpr bool operator!=(const duration<R1, P1> &a, const duration<R2, P2> &b) { return !(a == b); }
template <class R1, class P1, class R2, class P2> constexpr bool operator<(const duration<R1, P1> &a, const duration<R2, P2> &b) {
    typedef typename __duration_common<R1, P1, R2, P2>::type C;
    return C(a).count() < C(b).count();
}
template <class R1, class P1, class R2, class P2> constexpr bool operator>(const duration<R1, P1> &a, const duration<R2, P2> &b) { return b < a; }
template <class R1, class P1, class R2, class P2> constexpr bool operator<=(const duration<R1, P1> &a, const duration<R2, P2> &b) { return !(b < a); }
template <class R1, class P1, class R2, class P2> constexpr bool operator>=(const duration<R1, P1> &a, const duration<R2, P2> &b) { return !(a < b); }

template <class Clock, class Duration = typename Clock::duration> class time_point {
public:
    typedef Clock clock;
    typedef Duration duration;
    typedef typename Duration::rep rep;
    typedef typename Duration::period period;
    constexpr time_point() : _since() {}
    constexpr explicit time_point(const Duration &d) : _since(d) {}
    template <class D2> constexpr time_point(const time_point<Clock, D2> &other) : _since(other.time_since_epoch()) {}
    constexpr Duration time_since_epoch() const { return _since; }
    time_point &operator+=(const Duration &d) { _since += d; return *this; }
    time_point &operator-=(const Duration &d) { _since -= d; return *this; }
    static constexpr time_point min() { return time_point(Duration::min()); }
    static constexpr time_point max() { return time_point(Duration::max()); }
private:
    Duration _since;
};

template <class To, class Clock, class D> constexpr time_point<Clock, To> time_point_cast(const time_point<Clock, D> &t) {
    return time_point<Clock, To>(duration_cast<To>(t.time_since_epoch()));
}
template <class C, class D, class R2, class P2> constexpr time_point<C, D> operator+(const time_point<C, D> &t, const duration<R2, P2> &d) { return time_point<C, D>(t.time_since_epoch() + D(d)); }
template <class R1, class P1, class C, class D> constexpr time_point<C, D> operator+(const duration<R1, P1> &d, const time_point<C, D> &t) { return t + d; }
template <class C, class D, class R2, class P2> constexpr time_point<C, D> operator-(const time_point<C, D> &t, const duration<R2, P2> &d) { return time_point<C, D>(t.time_since_epoch() - D(d)); }
template <class C, class D1, class D2> constexpr D1 operator-(const time_point<C, D1> &a, const time_point<C, D2> &b) { return a.time_since_epoch() - D1(b.time_since_epoch()); }
template <class C, class D1, class D2> constexpr bool operator==(const time_point<C, D1> &a, const time_point<C, D2> &b) { return a.time_since_epoch() == b.time_since_epoch(); }
template <class C, class D1, class D2> constexpr bool operator!=(const time_point<C, D1> &a, const time_point<C, D2> &b) { return !(a == b); }
template <class C, class D1, class D2> constexpr bool operator<(const time_point<C, D1> &a, const time_point<C, D2> &b) { return a.time_since_epoch() < b.time_since_epoch(); }
template <class C, class D1, class D2> constexpr bool operator>(const time_point<C, D1> &a, const time_point<C, D2> &b) { return b < a; }
template <class C, class D1, class D2> constexpr bool operator<=(const time_point<C, D1> &a, const time_point<C, D2> &b) { return !(b < a); }
template <class C, class D1, class D2> constexpr bool operator>=(const time_point<C, D1> &a, const time_point<C, D2> &b) { return !(a < b); }

inline long long __clock_now(int which) {
    struct timespec ts;
    clock_gettime(which, &ts);
    return (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

struct system_clock {
    typedef nanoseconds duration;
    typedef duration::rep rep;
    typedef duration::period period;
    typedef chrono::time_point<system_clock> time_point;
    static constexpr bool is_steady = false;
    static time_point now() noexcept { return time_point(duration(__clock_now(CLOCK_REALTIME))); }
    static time_t to_time_t(const time_point &t) noexcept { return (time_t)(t.time_since_epoch().count() / 1000000000LL); }
    static time_point from_time_t(time_t t) noexcept { return time_point(duration((long long)t * 1000000000LL)); }
};

struct steady_clock {
    typedef nanoseconds duration;
    typedef duration::rep rep;
    typedef duration::period period;
    typedef chrono::time_point<steady_clock> time_point;
    static constexpr bool is_steady = true;
    static time_point now() noexcept { return time_point(duration(__clock_now(CLOCK_MONOTONIC))); }
};

typedef steady_clock high_resolution_clock;

// The clock of file times: the system clock's.
struct file_clock {
    typedef nanoseconds duration;
    typedef duration::rep rep;
    typedef duration::period period;
    typedef chrono::time_point<file_clock> time_point;
    static constexpr bool is_steady = false;
    static time_point now() noexcept { return time_point(duration(__clock_now(CLOCK_REALTIME))); }
    template <class D> static chrono::time_point<system_clock, D> to_sys(const chrono::time_point<file_clock, D> &t) { return chrono::time_point<system_clock, D>(t.time_since_epoch()); }
    template <class D> static chrono::time_point<file_clock, D> from_sys(const chrono::time_point<system_clock, D> &t) { return chrono::time_point<file_clock, D>(t.time_since_epoch()); }
};
template <class D> using sys_time = time_point<system_clock, D>;
typedef sys_time<seconds> sys_seconds;

template <class Rep> struct treat_as_floating_point : is_floating_point<Rep> {};

}

