// <map>: std::map, pairs sorted by key in a vector (found by binary
// search, inserted in place), with pointers to the pairs as iterators:
// `it->first`, `it->second`. An insertion or erasure moves the pairs
// after it, so iterators do not survive them (a tree's would). No
// comparator or allocator parameter: keys compare with <.
#ifndef __MLXCC_MAP
#define __MLXCC_MAP
#include <stddef.h>
#include <utility>
#include <vector>

namespace std {

template <typename K, typename V> class map {
public:
    typedef K key_type;
    typedef V mapped_type;
    typedef pair<K, V> value_type;
    typedef pair<K, V> *iterator;
    typedef const pair<K, V> *const_iterator;

    map() {}
    map(const map &other) : items(other.items) {}
    map &operator=(const map &other) { items = other.items; return *this; }

    size_t size() const { return items.size(); }
    bool empty() const { return items.empty(); }
    iterator begin() { return items.begin(); }
    iterator end() { return items.end(); }
    const_iterator begin() const { return items.begin(); }
    const_iterator end() const { return items.end(); }
    void clear() { items.clear(); }

    // The first pair whose key is not less than `key`.
    iterator lower_bound(const K &key) {
        size_t low = 0, high = items.size();
        while (low < high) {
            size_t mid = (low + high) / 2;
            if (items[mid].first < key) low = mid + 1; else high = mid;
        }
        return items.begin() + low;
    }
    iterator upper_bound(const K &key) {
        size_t low = 0, high = items.size();
        while (low < high) {
            size_t mid = (low + high) / 2;
            if (key < items[mid].first) high = mid; else low = mid + 1;
        }
        return items.begin() + low;
    }
    iterator find(const K &key) {
        iterator it = lower_bound(key);
        if (it != end() && !(key < it->first)) return it;
        return end();
    }
    const_iterator find(const K &key) const {
        map &self = const_cast<map &>(*this);
        iterator it = self.find(key);
        return it;
    }
    size_t count(const K &key) const { return find(key) == end() ? 0 : 1; }
    pair<iterator, bool> insert(const value_type &value) {
        iterator it = lower_bound(value.first);
        if (it != end() && !(value.first < it->first)) return pair<iterator, bool>(it, false);
        iterator placed = items.insert(it, value);
        return pair<iterator, bool>(placed, true);
    }
    V &operator[](const K &key) {
        iterator it = lower_bound(key);
        if (it != end() && !(key < it->first)) return it->second;
        iterator placed = items.insert(it, value_type(key, V()));
        return placed->second;
    }
    V &at(const K &key) { return find(key)->second; }
    size_t erase(const K &key) {
        iterator it = find(key);
        if (it == end()) return 0;
        items.erase(it);
        return 1;
    }
    iterator erase(iterator it) { return items.erase(it); }
    void swap(map &other) { items.swap(other.items); }

private:
    vector<value_type> items;
};

template <typename K, typename V> bool operator==(const map<K, V> &a, const map<K, V> &b) {
    if (a.size() != b.size()) return false;
    const pair<K, V> *x = a.begin();
    const pair<K, V> *y = b.begin();
    for (; x != a.end(); ++x, ++y)
        if (!(x->first == y->first) || !(x->second == y->second)) return false;
    return true;
}

}
#endif
