// <map>: std::map and std::multimap, pairs (key const) in a red-black
// tree ordered by the comparator over the keys (<__rb_tree>):
// `it->first`, `it->second`. Iterators survive insertions and the
// erasure of other elements. The allocator parameter is taken and not
// used (nodes come from operator new).
#ifndef __MLXCC_MAP
#define __MLXCC_MAP
#include <stddef.h>
#include <stdlib.h>
#include <utility>
#include <__rb_tree>

namespace std {

template <class K, class V> struct __map_key_of { static const K &key(const pair<const K, V> &p) { return p.first; } };

template <class K, class V, class Compare, bool Multi> class __map_base {
protected:
    typedef __rb_tree<K, pair<const K, V>, __map_key_of<K, V>, Compare, Multi> tree_type;
    tree_type tree;

public:
    typedef K key_type;
    typedef V mapped_type;
    typedef pair<const K, V> value_type;
    typedef Compare key_compare;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef value_type &reference;
    typedef const value_type &const_reference;
    typedef typename tree_type::iterator iterator;
    typedef typename tree_type::const_iterator const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    __map_base() {}
    explicit __map_base(const Compare &c) : tree(c) {}

    iterator begin() { return tree.begin(); }
    iterator end() { return tree.end(); }
    const_iterator begin() const { return tree.begin(); }
    const_iterator end() const { return tree.end(); }
    const_iterator cbegin() const { return tree.begin(); }
    const_iterator cend() const { return tree.end(); }
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }

    size_t size() const { return tree.size(); }
    bool empty() const { return tree.empty(); }
    size_t max_size() const { return ((size_t)-1) / 64; }
    void clear() { tree.clear(); }
    key_compare key_comp() const { return tree.key_comp(); }

    iterator find(const K &key) { return tree.find(key); }
    const_iterator find(const K &key) const { return tree.find(key); }
    size_t count(const K &key) const { return tree.countOf(key); }
    bool contains(const K &key) const { return tree.find(key) != tree.end(); }
    iterator lower_bound(const K &key) { return tree.lower_bound(key); }
    const_iterator lower_bound(const K &key) const { return tree.lower_bound(key); }
    iterator upper_bound(const K &key) { return tree.upper_bound(key); }
    const_iterator upper_bound(const K &key) const { return tree.upper_bound(key); }
    pair<iterator, iterator> equal_range(const K &key) { return pair<iterator, iterator>(lower_bound(key), upper_bound(key)); }
    pair<const_iterator, const_iterator> equal_range(const K &key) const { return pair<const_iterator, const_iterator>(lower_bound(key), upper_bound(key)); }

    iterator erase(const_iterator it) { return tree.erase(it); }
    iterator erase(iterator it) { return tree.erase(const_iterator(it)); }
    iterator erase(const_iterator first, const_iterator last) { return tree.erase(first, last); }
    size_t erase(const K &key) { return tree.eraseKey(key); }
    template <class P> size_t erase_if_(P predicate) {
        size_t removed = 0;
        for (iterator it = begin(); it != end();) {
            if (predicate(*it)) { it = erase(it); ++removed; } else ++it;
        }
        return removed;
    }
};

template <class K, class V, class Compare = less<K>, class Alloc = void> class map : public __map_base<K, V, Compare, false> {
    typedef __map_base<K, V, Compare, false> base_;

public:
    typedef typename base_::iterator iterator;
    typedef typename base_::const_iterator const_iterator;
    typedef typename base_::value_type value_type;

    map() {}
    explicit map(const Compare &c) : base_(c) {}
    map(initializer_list<value_type> values) { for (const value_type &v : values) insert(v); }
    template <class I, class = decltype(*declval<I &>()), class = decltype(++declval<I &>())>
    map(I first, I last) { for (; first != last; ++first) insert(*first); }
    map(const map &other) : base_(other) {}
    map(map &&other) : base_(std::move(other)) {}
    map &operator=(const map &other) { this->tree = other.tree; return *this; }
    map &operator=(map &&other) { this->tree = std::move(other.tree); return *this; }
    map &operator=(initializer_list<value_type> values) { this->clear(); for (const value_type &v : values) insert(v); return *this; }

    pair<iterator, bool> insert(const value_type &value) { return this->tree.emplace(value); }
    pair<iterator, bool> insert(value_type &&value) { return this->tree.emplace(std::move(value)); }
    template <class P, class = decltype(value_type(declval<P &&>()))> pair<iterator, bool> insert(P &&value) { return this->tree.emplace(std::forward<P>(value)); }
    iterator insert(const_iterator, const value_type &value) { return insert(value).first; }
    template <class I> void insert(I first, I last) { for (; first != last; ++first) insert(*first); }
    void insert(initializer_list<value_type> values) { for (const value_type &v : values) insert(v); }
    template <class... A> pair<iterator, bool> emplace(A &&... args) { return this->tree.emplace(std::forward<A>(args)...); }
    template <class... A> iterator emplace_hint(const_iterator, A &&... args) { return emplace(std::forward<A>(args)...).first; }
    template <class... A> pair<iterator, bool> try_emplace(const K &key, A &&... args) {
        iterator it = this->find(key);
        if (it != this->end()) return pair<iterator, bool>(it, false);
        return this->tree.emplace(key, V(std::forward<A>(args)...));
    }
    template <class... A> pair<iterator, bool> try_emplace(K &&key, A &&... args) {
        iterator it = this->find(key);
        if (it != this->end()) return pair<iterator, bool>(it, false);
        return this->tree.emplace(std::move(key), V(std::forward<A>(args)...));
    }
    template <class M> pair<iterator, bool> insert_or_assign(const K &key, M &&value) {
        iterator it = this->find(key);
        if (it != this->end()) {
            it->second = std::forward<M>(value);
            return pair<iterator, bool>(it, false);
        }
        return this->tree.emplace(key, std::forward<M>(value));
    }

    V &operator[](const K &key) {
        iterator it = this->find(key);
        if (it != this->end()) return it->second;
        return this->tree.emplace(key, V()).first->second;
    }
    V &operator[](K &&key) {
        iterator it = this->find(key);
        if (it != this->end()) return it->second;
        return this->tree.emplace(std::move(key), V()).first->second;
    }
    // (No exceptions: a key not there ends the program.)
    V &at(const K &key) {
        iterator it = this->find(key);
        if (it == this->end()) abort();
        return it->second;
    }
    const V &at(const K &key) const {
        const_iterator it = this->find(key);
        if (it == this->end()) abort();
        return it->second;
    }
    void swap(map &other) { this->tree.swap(other.tree); }
};

template <class K, class V, class Compare = less<K>, class Alloc = void> class multimap : public __map_base<K, V, Compare, true> {
    typedef __map_base<K, V, Compare, true> base_;

public:
    typedef typename base_::iterator iterator;
    typedef typename base_::const_iterator const_iterator;
    typedef typename base_::value_type value_type;

    multimap() {}
    explicit multimap(const Compare &c) : base_(c) {}
    multimap(initializer_list<value_type> values) { for (const value_type &v : values) insert(v); }
    template <class I, class = decltype(*declval<I &>()), class = decltype(++declval<I &>())>
    multimap(I first, I last) { for (; first != last; ++first) insert(*first); }
    multimap(const multimap &other) : base_(other) {}
    multimap(multimap &&other) : base_(std::move(other)) {}
    multimap &operator=(const multimap &other) { this->tree = other.tree; return *this; }
    multimap &operator=(multimap &&other) { this->tree = std::move(other.tree); return *this; }

    iterator insert(const value_type &value) { return this->tree.emplace(value).first; }
    iterator insert(value_type &&value) { return this->tree.emplace(std::move(value)).first; }
    template <class P, class = decltype(value_type(declval<P &&>()))> iterator insert(P &&value) { return this->tree.emplace(std::forward<P>(value)).first; }
    template <class I> void insert(I first, I last) { for (; first != last; ++first) insert(*first); }
    template <class... A> iterator emplace(A &&... args) { return this->tree.emplace(std::forward<A>(args)...).first; }
    void swap(multimap &other) { this->tree.swap(other.tree); }
};

template <class K, class V, class C, class A> bool operator==(const map<K, V, C, A> &a, const map<K, V, C, A> &b) {
    if (a.size() != b.size()) return false;
    auto x = a.begin();
    auto y = b.begin();
    for (; x != a.end(); ++x, ++y)
        if (!(x->first == y->first) || !(x->second == y->second)) return false;
    return true;
}
template <class K, class V, class C, class A> bool operator!=(const map<K, V, C, A> &a, const map<K, V, C, A> &b) { return !(a == b); }
template <class K, class V, class C, class A> void swap(map<K, V, C, A> &a, map<K, V, C, A> &b) { a.swap(b); }
template <class K, class V, class C, class A, class P> size_t erase_if(map<K, V, C, A> &m, P predicate) { return m.erase_if_(predicate); }
template <class K, class V, class C, class A, class P> size_t erase_if(multimap<K, V, C, A> &m, P predicate) { return m.erase_if_(predicate); }

}
#endif
