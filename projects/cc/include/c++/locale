// <locale>: std::locale (the classic one alone, in <iostream>) and the
// character classes of <cctype> taking a locale.
#ifndef __MLXCC_LOCALE
#define __MLXCC_LOCALE
#include <iostream>
#include <ctype.h>

namespace std {
inline bool isspace(char c, const locale &) { return ::isspace((unsigned char)c) != 0; }
inline bool isdigit(char c, const locale &) { return ::isdigit((unsigned char)c) != 0; }
inline bool isalpha(char c, const locale &) { return ::isalpha((unsigned char)c) != 0; }
inline bool isalnum(char c, const locale &) { return ::isalnum((unsigned char)c) != 0; }
inline bool isupper(char c, const locale &) { return ::isupper((unsigned char)c) != 0; }
inline bool islower(char c, const locale &) { return ::islower((unsigned char)c) != 0; }
inline char toupper(char c, const locale &) { return (char)::toupper((unsigned char)c); }
inline char tolower(char c, const locale &) { return (char)::tolower((unsigned char)c); }
}
#endif
