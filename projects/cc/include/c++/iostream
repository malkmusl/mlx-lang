// <iostream>: std::ostream over a C stream (cout, cerr, clog) with << for
// the built-in types and std::string, the manipulators endl and flush,
// and std::istream (cin) with >> and getline. Implemented in
// projects/libcpp/iostream.cpp. Not here: formatting flags beyond
// precision (setw, hex, fixed), wide streams, string streams, file
// streams.
#ifndef __MLXCC_IOSTREAM
#define __MLXCC_IOSTREAM
#include <stddef.h>
#include <string>

namespace std {

class ostream {
public:
    // The C stream: 1 stdout, 2 stderr (an aggregate: no constructor to
    // run before the program's own globals are made).
    int which;
    int digits;
    bool failed;

    ostream &write(const char *bytes, size_t count);
    ostream &put(char c);
    ostream &flush();
    int precision() const { return digits; }
    int precision(int wanted) { int before = digits; digits = wanted; return before; }
    bool good() const { return !failed; }
    bool fail() const { return failed; }
    operator bool() const { return !failed; }

    ostream &operator<<(const char *text);
    ostream &operator<<(char c);
    ostream &operator<<(unsigned char c) { return *this << (char)c; }
    ostream &operator<<(bool value);
    ostream &operator<<(short value) { return *this << (int)value; }
    ostream &operator<<(unsigned short value) { return *this << (unsigned)value; }
    ostream &operator<<(int value);
    ostream &operator<<(unsigned value);
    ostream &operator<<(long value);
    ostream &operator<<(unsigned long value);
    ostream &operator<<(double value);
    ostream &operator<<(float value) { return *this << (double)value; }
    ostream &operator<<(const void *pointer);
    ostream &operator<<(ostream &(*manipulator)(ostream &)) { return manipulator(*this); }
};

ostream &operator<<(ostream &out, const string &text);
ostream &endl(ostream &out);
ostream &flush(ostream &out);
ostream &ends(ostream &out);

class istream {
public:
    // The C stream: 0 stdin.
    int which;
    bool failed;
    bool ended;

    int get();
    istream &get(char &c);
    int peek();
    istream &unget();
    istream &ignore(size_t count = 1, int delimiter = -1);
    istream &getline(char *buffer, size_t size, char delimiter = '\n');
    istream &read(char *buffer, size_t count);
    bool good() const { return !failed && !ended; }
    bool fail() const { return failed; }
    bool eof() const { return ended; }
    void clear() { failed = false; ended = false; }
    operator bool() const { return !failed; }

    istream &operator>>(char &c);
    istream &operator>>(unsigned char &c) { return *this >> (char &)c; }
    istream &operator>>(bool &value);
    istream &operator>>(short &value);
    istream &operator>>(unsigned short &value);
    istream &operator>>(int &value);
    istream &operator>>(unsigned &value);
    istream &operator>>(long &value);
    istream &operator>>(unsigned long &value);
    istream &operator>>(double &value);
    istream &operator>>(float &value);
    istream &operator>>(char *word);
};

istream &operator>>(istream &in, string &word);
istream &getline(istream &in, string &line, char delimiter = '\n');

extern ostream cout;
extern ostream cerr;
extern ostream clog;
extern istream cin;

}
#endif
