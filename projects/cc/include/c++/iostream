// <iostream>: std::ostream over a C stream (cout, cerr, clog) with << for
// the built-in types and std::string, the manipulators endl and flush,
// and std::istream (cin) with >> and getline; the formatting flags of
// std::ios_base (hex, oct, showbase, uppercase, width and fill with
// left, right and internal adjustment, fixed and scientific,
// boolalpha), the manipulators of <iomanip>. Implemented in
// projects/libcpp/iostream.cpp. Not here: wide streams, file streams.
#ifndef __MLXCC_IOSTREAM
#define __MLXCC_IOSTREAM
#include <stddef.h>
#include <string>

namespace std {

// The formatting state's flags and names (std::ios_base, std::ios).
class ios_base {
public:
    typedef unsigned fmtflags;
    typedef unsigned iostate;
    typedef unsigned openmode;
    static constexpr fmtflags boolalpha = 1;
    static constexpr fmtflags dec = 2;
    static constexpr fmtflags fixed = 4;
    static constexpr fmtflags hex = 8;
    static constexpr fmtflags internal = 16;
    static constexpr fmtflags left = 32;
    static constexpr fmtflags oct = 64;
    static constexpr fmtflags right = 128;
    static constexpr fmtflags scientific = 256;
    static constexpr fmtflags showbase = 512;
    static constexpr fmtflags showpoint = 1024;
    static constexpr fmtflags showpos = 2048;
    static constexpr fmtflags skipws = 4096;
    static constexpr fmtflags unitbuf = 8192;
    static constexpr fmtflags uppercase = 16384;
    static constexpr fmtflags adjustfield = 32 | 128 | 16;
    static constexpr fmtflags basefield = 2 | 64 | 8;
    static constexpr fmtflags floatfield = 4 | 256;
    static constexpr iostate goodbit = 0;
    static constexpr iostate badbit = 1;
    static constexpr iostate eofbit = 2;
    static constexpr iostate failbit = 4;
    static constexpr openmode app = 1;
    static constexpr openmode ate = 2;
    static constexpr openmode binary = 4;
    static constexpr openmode in = 8;
    static constexpr openmode out = 16;
    static constexpr openmode trunc = 32;
};
typedef ios_base ios;
typedef long streamsize;

// The locale: the classic "C" one alone (what imbue takes and getloc
// gives).
class locale {
public:
    locale() noexcept {}
    explicit locale(const char *) {}
    static locale classic() { return locale(); }
    static locale global(const locale &) { return locale(); }
    string name() const { return "C"; }
    bool operator==(const locale &) const { return true; }
    bool operator!=(const locale &) const { return false; }
};

class ostream {
public:
    // The C stream: 1 stdout, 2 stderr, 0 the string `sink` (an
    // aggregate: no constructor to run before the program's own globals
    // are made); the formatting state: precision, flags (0 is dec),
    // width (for the next output only) and fill (0 is a space).
    int which;
    int digits;
    bool failed;
    unsigned format;
    long fieldWidth;
    char fillChar;
    string *sink;

    ostream &write(const char *bytes, size_t count);
    ostream &put(char c);
    ostream &flush();
    int precision() const { return digits; }
    int precision(int wanted) { int before = digits; digits = wanted; return before; }
    ios_base::fmtflags flags() const { return format; }
    ios_base::fmtflags flags(ios_base::fmtflags wanted) { unsigned before = format; format = wanted; return before; }
    ios_base::fmtflags setf(ios_base::fmtflags wanted) { unsigned before = format; format |= wanted; return before; }
    ios_base::fmtflags setf(ios_base::fmtflags wanted, ios_base::fmtflags mask) { unsigned before = format; format = (format & ~mask) | (wanted & mask); return before; }
    void unsetf(ios_base::fmtflags mask) { format &= ~mask; }
    streamsize width() const { return fieldWidth; }
    streamsize width(streamsize wanted) { long before = fieldWidth; fieldWidth = wanted; return before; }
    char fill() const { return fillChar ? fillChar : ' '; }
    char fill(char wanted) { char before = fill(); fillChar = wanted; return before; }
    locale imbue(const locale &) { return locale(); }
    locale getloc() const { return locale(); }
    bool good() const { return !failed; }
    bool fail() const { return failed; }
    bool bad() const { return false; }
    void clear() { failed = false; }
    operator bool() const { return !failed; }
    bool operator!() const { return failed; }

    ostream &operator<<(const char *text);
    ostream &operator<<(char c);
    ostream &operator<<(signed char c) { return *this << (char)c; }
    ostream &operator<<(unsigned char c) { return *this << (char)c; }
    ostream &operator<<(bool value);
    ostream &operator<<(short value) { return *this << (long)value; }
    ostream &operator<<(unsigned short value) { return *this << (unsigned long)value; }
    ostream &operator<<(int value) { return *this << (long)value; }
    ostream &operator<<(unsigned value) { return *this << (unsigned long)value; }
    ostream &operator<<(long value);
    ostream &operator<<(unsigned long value);
    ostream &operator<<(long long value) { return *this << (long)value; }
    ostream &operator<<(unsigned long long value) { return *this << (unsigned long)value; }
    ostream &operator<<(double value);
    ostream &operator<<(float value) { return *this << (double)value; }
    ostream &operator<<(long double value) { return *this << (double)value; }
    ostream &operator<<(const void *pointer);
    ostream &operator<<(decltype(nullptr)) { return *this << "nullptr"; }
    ostream &operator<<(ostream &(*manipulator)(ostream &)) { return manipulator(*this); }

    // The text, padded to the width as the flags say (the width is then
    // 0 again); `prefix` characters of it (a sign, 0x) come before an
    // internal padding.
    ostream &padded(const char *text, size_t count, size_t prefix);
};

ostream &operator<<(ostream &out, const string &text);
ostream &endl(ostream &out);
ostream &flush(ostream &out);
ostream &ends(ostream &out);

// The manipulators of the formatting flags.
inline ostream &dec(ostream &out) { out.setf(ios_base::dec, ios_base::basefield); return out; }
inline ostream &hex(ostream &out) { out.setf(ios_base::hex, ios_base::basefield); return out; }
inline ostream &oct(ostream &out) { out.setf(ios_base::oct, ios_base::basefield); return out; }
inline ostream &showbase(ostream &out) { out.setf(ios_base::showbase); return out; }
inline ostream &noshowbase(ostream &out) { out.unsetf(ios_base::showbase); return out; }
inline ostream &showpos(ostream &out) { out.setf(ios_base::showpos); return out; }
inline ostream &noshowpos(ostream &out) { out.unsetf(ios_base::showpos); return out; }
inline ostream &showpoint(ostream &out) { out.setf(ios_base::showpoint); return out; }
inline ostream &noshowpoint(ostream &out) { out.unsetf(ios_base::showpoint); return out; }
inline ostream &uppercase(ostream &out) { out.setf(ios_base::uppercase); return out; }
inline ostream &nouppercase(ostream &out) { out.unsetf(ios_base::uppercase); return out; }
inline ostream &boolalpha(ostream &out) { out.setf(ios_base::boolalpha); return out; }
inline ostream &noboolalpha(ostream &out) { out.unsetf(ios_base::boolalpha); return out; }
inline ostream &left(ostream &out) { out.setf(ios_base::left, ios_base::adjustfield); return out; }
inline ostream &right(ostream &out) { out.setf(ios_base::right, ios_base::adjustfield); return out; }
inline ostream &internal(ostream &out) { out.setf(ios_base::internal, ios_base::adjustfield); return out; }
inline ostream &fixed(ostream &out) { out.setf(ios_base::fixed, ios_base::floatfield); return out; }
inline ostream &scientific(ostream &out) { out.setf(ios_base::scientific, ios_base::floatfield); return out; }
inline ostream &defaultfloat(ostream &out) { out.unsetf(ios_base::floatfield); return out; }

class istream {
public:
    // The C stream: 0 stdin.
    int which;
    bool failed;
    bool ended;

    int get();
    istream &get(char &c);
    int peek();
    istream &unget();
    istream &ignore(size_t count = 1, int delimiter = -1);
    istream &getline(char *buffer, size_t size, char delimiter = '\n');
    istream &read(char *buffer, size_t count);
    locale imbue(const locale &) { return locale(); }
    locale getloc() const { return locale(); }
    bool good() const { return !failed && !ended; }
    bool fail() const { return failed; }
    bool eof() const { return ended; }
    void clear() { failed = false; ended = false; }
    operator bool() const { return !failed; }

    istream &operator>>(char &c);
    istream &operator>>(unsigned char &c) { return *this >> (char &)c; }
    istream &operator>>(bool &value);
    istream &operator>>(short &value);
    istream &operator>>(unsigned short &value);
    istream &operator>>(int &value);
    istream &operator>>(unsigned &value);
    istream &operator>>(long &value);
    istream &operator>>(unsigned long &value);
    istream &operator>>(double &value);
    istream &operator>>(float &value);
    istream &operator>>(char *word);
};

istream &operator>>(istream &in, string &word);
istream &getline(istream &in, string &line, char delimiter = '\n');

extern ostream cout;
extern ostream cerr;
extern ostream clog;
extern istream cin;

}
#endif
