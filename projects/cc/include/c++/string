// <string>: std::string, a sequence of chars that owns its bytes (always
// NUL-ended, so c_str() is free), and the conversions to_string, stoi and
// the others. Implemented in projects/libcpp/string.cpp.
#ifndef __MLXCC_STRING
#define __MLXCC_STRING
#include <stddef.h>
#include <utility>
#include <string_view>
#include <initializer_list>
#include <iterator>
#include <type_traits>
#include <__allocator>
#include <cwchar>
#include <cstdio>
#include <stdlib.h>

namespace std {

class string {
public:
    static constexpr size_t npos = (size_t)-1;

    string();
    string(const char *text);
    string(const char *text, size_t count);
    string(size_t count, char fill);
    string(const string &other);
    // A move takes the bytes; the source is left empty (a buffer of its
    // own, as the default constructor makes).
    string(string &&other) noexcept : chars(other.chars), count(other.count), room(other.room) {
        other.chars = static_cast<char *>(malloc(16));
        other.chars[0] = 0;
        other.count = 0;
        other.room = 16;
    }
    explicit string(string_view view) : string(view.data(), view.size()) {}
    string(initializer_list<char> list) : string(list.begin(), list.size()) {}
    ~string();
    string &operator=(const string &other);
    string &operator=(string &&other) noexcept {
        if (this != &other) {
            swap(other);
            other.clear();
        }
        return *this;
    }
    string &operator=(const char *text);
    string &operator=(char c);

    operator string_view() const noexcept { return string_view(chars, count); }
    const char *c_str() const { return chars; }
    const char *data() const { return chars; }
    size_t size() const { return count; }
    size_t length() const { return count; }
    size_t capacity() const { return room; }
    bool empty() const { return count == 0; }
    char &operator[](size_t index) { return chars[index]; }
    char operator[](size_t index) const { return chars[index]; }
    char &at(size_t index);
    char &front() { return chars[0]; }
    char &back() { return chars[count - 1]; }
    char *begin() { return chars; }
    char *end() { return chars + count; }
    const char *begin() const { return chars; }
    const char *end() const { return chars + count; }

    void clear();
    void reserve(size_t wanted);
    void resize(size_t wanted, char fill = 0);
    void push_back(char c);
    void pop_back();
    string &append(const char *text);
    string &append(const char *text, size_t n);
    string &append(const string &other);
    string &append(size_t n, char c);
    string &operator+=(const char *text) { return append(text); }
    string &operator+=(const string &other) { return append(other); }
    string &operator+=(char c) { push_back(c); return *this; }
    string &assign(const char *text, size_t n);
    string &insert(size_t position, const char *text);
    string &insert(size_t position, const string &other);
    string &erase(size_t position = 0, size_t n = npos);
    string &replace(size_t position, size_t n, const char *text);
    string &replace(size_t position, size_t n, const string &other);
    string substr(size_t position = 0, size_t n = npos) const;
    size_t find(const char *text, size_t from = 0) const;
    size_t find(const string &other, size_t from = 0) const;
    size_t find(char c, size_t from = 0) const;
    size_t rfind(char c, size_t from = npos) const;
    size_t rfind(const char *text, size_t from = npos) const;
    size_t find_first_of(const char *set, size_t from = 0) const;
    size_t find_first_not_of(const char *set, size_t from = 0) const;
    size_t find_last_of(const char *set, size_t from = npos) const;
    size_t find_last_not_of(const char *set, size_t from = npos) const;
    int compare(const string &other) const;
    int compare(const char *text) const;
    void swap(string &other);

    // The rest of the interface, over the members above.
    typedef char value_type;
    typedef char_traits<char> traits_type;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef char &reference;
    typedef const char &const_reference;
    typedef char *pointer;
    typedef const char *const_pointer;
    typedef char *iterator;
    typedef const char *const_iterator;
    typedef std::reverse_iterator<char *> reverse_iterator;
    typedef std::reverse_iterator<const char *> const_reverse_iterator;

    string(const string &other, size_t position, size_t n = npos) : string(other.substr(position, n)) {}
    string(const char *text, size_t position, size_t n) : string(text + position, n) {}
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> string(It first, It last) : string() {
        for (; first != last; ++first) push_back(*first);
    }
    string(decltype(nullptr)) = delete;

    char *data() noexcept { return chars; }
    const char &front() const { return chars[0]; }
    const char &back() const { return chars[count - 1]; }
    const char &at(size_t index) const { return chars[index]; }
    const char *cbegin() const { return chars; }
    const char *cend() const { return chars + count; }
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }
    const_reverse_iterator crbegin() const { return const_reverse_iterator(end()); }
    const_reverse_iterator crend() const { return const_reverse_iterator(begin()); }
    size_t max_size() const noexcept { return npos / 2; }
    void shrink_to_fit() {}

    string &append(string_view view) { return append(view.data(), view.size()); }
    string &append(const string &other, size_t position, size_t n = npos) { return append(other.substr(position, n)); }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> string &append(It first, It last) {
        for (; first != last; ++first) push_back(*first);
        return *this;
    }
    string &append(initializer_list<char> list) { return append(list.begin(), list.size()); }
    string &operator+=(string_view view) { return append(view.data(), view.size()); }
    string &operator+=(initializer_list<char> list) { return append(list.begin(), list.size()); }
    string &operator=(string_view view) { return assign(view.data(), view.size()); }
    string &operator=(initializer_list<char> list) { return assign(list.begin(), list.size()); }
    string &operator=(decltype(nullptr)) = delete;
    string &assign(const string &other) { return *this = other; }
    string &assign(string &&other) { return *this = static_cast<string &&>(other); }
    string &assign(const char *text) { return *this = text; }
    string &assign(size_t n, char c) {
        clear();
        return append(n, c);
    }
    string &assign(string_view view) { return assign(view.data(), view.size()); }
    string &assign(const string &other, size_t position, size_t n = npos) { return *this = other.substr(position, n); }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> string &assign(It first, It last) {
        string made(first, last);
        swap(made);
        return *this;
    }

    string &insert(size_t position, size_t n, char c) { return insert(position, string(n, c)); }
    string &insert(size_t position, const char *text, size_t n) { return insert(position, string(text, n)); }
    string &insert(size_t position, string_view view) { return insert(position, string(view.data(), view.size())); }
    char *insert(const char *where, char c) {
        size_t index = where - chars;
        insert(index, string(1, c));
        return chars + index;
    }
    char *insert(const char *where, size_t n, char c) {
        size_t index = where - chars;
        insert(index, string(n, c));
        return chars + index;
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> char *insert(const char *where, It first, It last) {
        size_t index = where - chars;
        insert(index, string(first, last));
        return chars + index;
    }
    char *erase(const char *where) {
        size_t index = where - chars;
        erase(index, 1);
        return chars + index;
    }
    char *erase(const char *first, const char *last) {
        size_t index = first - chars;
        erase(index, last - first);
        return chars + index;
    }
    string &replace(size_t position, size_t n, const char *text, size_t n2) { return replace(position, n, string(text, n2)); }
    string &replace(size_t position, size_t n, size_t n2, char c) { return replace(position, n, string(n2, c)); }
    string &replace(size_t position, size_t n, string_view view) { return replace(position, n, string(view.data(), view.size())); }
    string &replace(const char *first, const char *last, const string &other) { return replace(first - chars, last - first, other); }
    string &replace(const char *first, const char *last, const char *text) { return replace(first - chars, last - first, string(text)); }
    string &replace(const char *first, const char *last, string_view view) { return replace(first - chars, last - first, string(view.data(), view.size())); }

    size_t find(string_view view, size_t from = 0) const noexcept { return string_view(chars, count).find(view, from); }
    size_t find(const char *text, size_t from, size_t n) const { return string_view(chars, count).find(string_view(text, n), from); }
    size_t rfind(const string &other, size_t from = npos) const { return string_view(chars, count).rfind(string_view(other.chars, other.count), from); }
    size_t rfind(string_view view, size_t from = npos) const noexcept { return string_view(chars, count).rfind(view, from); }
    size_t rfind(const char *text, size_t from, size_t n) const { return string_view(chars, count).rfind(string_view(text, n), from); }
    size_t find_first_of(const string &set, size_t from = 0) const { return string_view(chars, count).find_first_of(string_view(set.chars, set.count), from); }
    size_t find_first_of(string_view set, size_t from = 0) const { return string_view(chars, count).find_first_of(set, from); }
    size_t find_first_of(char c, size_t from = 0) const { return find(c, from); }
    size_t find_first_not_of(const string &set, size_t from = 0) const { return string_view(chars, count).find_first_not_of(string_view(set.chars, set.count), from); }
    size_t find_first_not_of(string_view set, size_t from = 0) const { return string_view(chars, count).find_first_not_of(set, from); }
    size_t find_first_not_of(char c, size_t from = 0) const { return string_view(chars, count).find_first_not_of(string_view(&c, 1), from); }
    size_t find_last_of(const string &set, size_t from = npos) const { return string_view(chars, count).find_last_of(string_view(set.chars, set.count), from); }
    size_t find_last_of(string_view set, size_t from = npos) const { return string_view(chars, count).find_last_of(set, from); }
    size_t find_last_of(char c, size_t from = npos) const { return rfind(c, from); }
    size_t find_last_not_of(const string &set, size_t from = npos) const { return string_view(chars, count).find_last_not_of(string_view(set.chars, set.count), from); }
    size_t find_last_not_of(string_view set, size_t from = npos) const { return string_view(chars, count).find_last_not_of(set, from); }
    size_t find_last_not_of(char c, size_t from = npos) const { return string_view(chars, count).find_last_not_of(string_view(&c, 1), from); }
    int compare(string_view view) const noexcept { return string_view(chars, count).compare(view); }
    int compare(size_t position, size_t n, const string &other) const { return substr(position, n).compare(other); }
    int compare(size_t position, size_t n, const char *text) const { return substr(position, n).compare(text); }
    int compare(size_t position, size_t n, string_view view) const { return string_view(chars, count).substr(position, n).compare(view); }
    bool starts_with(string_view view) const noexcept { return string_view(chars, count).starts_with(view); }
    bool starts_with(char c) const noexcept { return count > 0 && chars[0] == c; }
    bool starts_with(const char *text) const { return starts_with(string_view(text)); }
    bool ends_with(string_view view) const noexcept { return string_view(chars, count).ends_with(view); }
    bool ends_with(char c) const noexcept { return count > 0 && chars[count - 1] == c; }
    bool ends_with(const char *text) const { return ends_with(string_view(text)); }
    bool contains(string_view view) const noexcept { return find(view) != npos; }
    bool contains(char c) const noexcept { return find(c) != npos; }
    bool contains(const char *text) const { return find(text) != npos; }
    size_t copy(char *to, size_t n, size_t position = 0) const {
        if (position > count) position = count;
        if (n > count - position) n = count - position;
        for (size_t i = 0; i < n; i++) to[i] = chars[position + i];
        return n;
    }

private:
    char *chars;
    size_t count;
    size_t room;
    void grow(size_t needed);
};

string operator+(const string &a, const string &b);
string operator+(const string &a, const char *b);
string operator+(const char *a, const string &b);
string operator+(const string &a, char b);
string operator+(char a, const string &b);
bool operator==(const string &a, const string &b);
bool operator==(const string &a, const char *b);
bool operator==(const char *a, const string &b);
bool operator!=(const string &a, const string &b);
bool operator!=(const string &a, const char *b);
bool operator!=(const char *a, const string &b);
bool operator<(const string &a, const string &b);
bool operator<=(const string &a, const string &b);
bool operator>(const string &a, const string &b);
bool operator>=(const string &a, const string &b);
inline bool operator==(const string &a, string_view b) { return string_view(a) == b; }
inline bool operator==(string_view a, const string &b) { return a == string_view(b); }
inline bool operator!=(const string &a, string_view b) { return !(string_view(a) == b); }
inline bool operator!=(string_view a, const string &b) { return !(a == string_view(b)); }
inline bool operator<(const string &a, const char *b) { return a.compare(b) < 0; }
inline bool operator<(const char *a, const string &b) { return b.compare(a) > 0; }
inline string operator+(const string &a, string_view b) {
    string result(a);
    result.append(b);
    return result;
}
inline string operator+(string_view a, const string &b) {
    string result(a);
    result.append(b);
    return result;
}

// basic_string over char with another allocator (or the default one):
// a std::string (the allocator is not used); what returns a string here
// returns this type. Other character types are not here.
template <class C, class Traits = char_traits<C>, class Alloc = allocator<C> > class basic_string;
template <class Traits, class Alloc> class basic_string<char, Traits, Alloc> : public string {
public:
    typedef Traits traits_type;
    typedef Alloc allocator_type;

    basic_string() {}
    explicit basic_string(const Alloc &) {}
    basic_string(const basic_string &other) : string(other) {}
    basic_string(basic_string &&other) noexcept : string(static_cast<string &&>(other)) {}
    basic_string(const string &other) : string(other) {}
    basic_string(string &&other) noexcept : string(static_cast<string &&>(other)) {}
    basic_string(const char *text, const Alloc & = Alloc()) : string(text) {}
    basic_string(const char *text, size_t n, const Alloc & = Alloc()) : string(text, n) {}
    basic_string(size_t n, char c, const Alloc & = Alloc()) : string(n, c) {}
    basic_string(const string &other, size_t position, size_t n = npos) : string(other, position, n) {}
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> basic_string(It first, It last, const Alloc & = Alloc()) : string(first, last) {}
    explicit basic_string(string_view view, const Alloc & = Alloc()) : string(view) {}
    basic_string(initializer_list<char> list, const Alloc & = Alloc()) : string(list) {}
    basic_string &operator=(const basic_string &other) { string::operator=(other); return *this; }
    basic_string &operator=(basic_string &&other) noexcept { string::operator=(static_cast<string &&>(other)); return *this; }
    basic_string &operator=(const string &other) { string::operator=(other); return *this; }
    basic_string &operator=(string &&other) noexcept { string::operator=(static_cast<string &&>(other)); return *this; }
    basic_string &operator=(const char *text) { string::operator=(text); return *this; }
    basic_string &operator=(char c) { string::operator=(c); return *this; }
    basic_string &operator=(string_view view) { string::operator=(view); return *this; }
    allocator_type get_allocator() const noexcept { return allocator_type(); }
    basic_string substr(size_t position = 0, size_t n = npos) const { return basic_string(string::substr(position, n)); }
};

template <class T> struct hash;
template <> struct hash<string_view> {
    size_t operator()(string_view text) const noexcept {
        // FNV-1a.
        size_t h = 14695981039346656037UL;
        for (size_t i = 0; i < text.size(); i++) {
            h ^= (unsigned char)text[i];
            h *= 1099511628211UL;
        }
        return h;
    }
};
template <> struct hash<string> {
    size_t operator()(const string &text) const noexcept { return hash<string_view>()(string_view(text)); }
};

