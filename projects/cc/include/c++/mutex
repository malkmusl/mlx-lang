// <mutex>: mutex, recursive_mutex, lock_guard, unique_lock, scoped_lock,
// once_flag and call_once over pthreads.
#ifndef __MLXCC_MUTEX
#define __MLXCC_MUTEX
#include <pthread.h>

namespace std {

class mutex {
public:
    typedef pthread_mutex_t *native_handle_type;
    mutex() noexcept { pthread_mutex_init(&_handle, 0); }
    ~mutex() { pthread_mutex_destroy(&_handle); }
    mutex(const mutex &) = delete;
    mutex &operator=(const mutex &) = delete;
    void lock() { pthread_mutex_lock(&_handle); }
    bool try_lock() { return pthread_mutex_trylock(&_handle) == 0; }
    void unlock() { pthread_mutex_unlock(&_handle); }
    native_handle_type native_handle() { return &_handle; }
private:
    pthread_mutex_t _handle;
};

class recursive_mutex {
public:
    recursive_mutex() noexcept {
        pthread_mutexattr_t attr;
        pthread_mutexattr_init(&attr);
        pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
        pthread_mutex_init(&_handle, &attr);
        pthread_mutexattr_destroy(&attr);
    }
    ~recursive_mutex() { pthread_mutex_destroy(&_handle); }
    recursive_mutex(const recursive_mutex &) = delete;
    recursive_mutex &operator=(const recursive_mutex &) = delete;
    void lock() { pthread_mutex_lock(&_handle); }
    bool try_lock() { return pthread_mutex_trylock(&_handle) == 0; }
    void unlock() { pthread_mutex_unlock(&_handle); }
private:
    pthread_mutex_t _handle;
};

struct defer_lock_t { explicit defer_lock_t() = default; };
struct try_to_lock_t { explicit try_to_lock_t() = default; };
struct adopt_lock_t { explicit adopt_lock_t() = default; };
constexpr defer_lock_t defer_lock = defer_lock_t();
constexpr try_to_lock_t try_to_lock = try_to_lock_t();
constexpr adopt_lock_t adopt_lock = adopt_lock_t();

template <class M> class lock_guard {
public:
    typedef M mutex_type;
    explicit lock_guard(M &m) : _mutex(m) { _mutex.lock(); }
    lock_guard(M &m, adopt_lock_t) : _mutex(m) {}
    ~lock_guard() { _mutex.unlock(); }
    lock_guard(const lock_guard &) = delete;
    lock_guard &operator=(const lock_guard &) = delete;
private:
    M &_mutex;
};

template <class M> class unique_lock {
public:
    typedef M mutex_type;
    unique_lock() noexcept : _mutex(0), _owns(false) {}
    explicit unique_lock(M &m) : _mutex(&m), _owns(true) { m.lock(); }
    unique_lock(M &m, defer_lock_t) noexcept : _mutex(&m), _owns(false) {}
    unique_lock(M &m, try_to_lock_t) : _mutex(&m), _owns(m.try_lock()) {}
    unique_lock(M &m, adopt_lock_t) : _mutex(&m), _owns(true) {}
    unique_lock(unique_lock &&other) noexcept : _mutex(other._mutex), _owns(other._owns) { other._mutex = 0; other._owns = false; }
    ~unique_lock() { if (_owns) _mutex->unlock(); }
    unique_lock(const unique_lock &) = delete;
    unique_lock &operator=(const unique_lock &) = delete;
    unique_lock &operator=(unique_lock &&other) noexcept {
        if (_owns) _mutex->unlock();
        _mutex = other._mutex; _owns = other._owns;
        other._mutex = 0; other._owns = false;
        return *this;
    }
    void lock() { _mutex->lock(); _owns = true; }
    bool try_lock() { _owns = _mutex->try_lock(); return _owns; }
    void unlock() { _mutex->unlock(); _owns = false; }
    bool owns_lock() const noexcept { return _owns; }
    explicit operator bool() const noexcept { return _owns; }
    M *mutex() const noexcept { return _mutex; }
    M *release() noexcept { M *m = _mutex; _mutex = 0; _owns = false; return m; }
private:
    M *_mutex;
    bool _owns;
};

template <class M> class scoped_lock {
public:
    explicit scoped_lock(M &m) : _mutex(m) { _mutex.lock(); }
    scoped_lock(adopt_lock_t, M &m) : _mutex(m) {}
    ~scoped_lock() { _mutex.unlock(); }
    scoped_lock(const scoped_lock &) = delete;
    scoped_lock &operator=(const scoped_lock &) = delete;
private:
    M &_mutex;
};

struct once_flag {
    constexpr once_flag() noexcept : _done(0) {}
    once_flag(const once_flag &) = delete;
    once_flag &operator=(const once_flag &) = delete;
    int _done;
};
template <class F, class... Args> void call_once(once_flag &flag, F &&f, Args &&... args) {
    if (__atomic_exchange_n(&flag._done, 1, 5) == 0) f(args...);
}

}
#endif
