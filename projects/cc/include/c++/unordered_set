// <unordered_set>: std::unordered_set over <unordered_map>'s hash table
// of chained nodes.
#ifndef __MLXCC_UNORDERED_SET
#define __MLXCC_UNORDERED_SET
#include <unordered_map>

namespace std {

template <class K> struct __set_key_of { static const K &key(const K &k) { return k; } };

template <class K, class Hash = hash<K>, class KeyEqual = equal_to<K>, class Alloc = void>
class unordered_set {
public:
    typedef K key_type;
    typedef K value_type;
    typedef size_t size_type;
    typedef __hash_table<K, K, __set_key_of<K>, Hash, KeyEqual> table_type;
    typedef __hash_iterator<table_type, const K> iterator;
    typedef __hash_iterator<table_type, const K> const_iterator;

    unordered_set() {}
    explicit unordered_set(size_t buckets) { table.rehash(buckets); }
    unordered_set(initializer_list<K> list) { for (const K &v : list) insert(v); }
    unordered_set(const unordered_set &other) { for (const K &v : other) insert(v); }
    unordered_set(unordered_set &&other) noexcept { swap(other); }
    template <class It> unordered_set(It first, It last) { for (; first != last; ++first) insert(*first); }
    unordered_set &operator=(const unordered_set &other) {
        if (this != &other) { clear(); for (const K &v : other) insert(v); }
        return *this;
    }
    unordered_set &operator=(unordered_set &&other) noexcept {
        if (this != &other) { clear(); swap(other); }
        return *this;
    }

    size_t size() const { return table.count; }
    bool empty() const { return table.count == 0; }
    size_t bucket_count() const { return table.bucketCount; }
    void reserve(size_t n) { table.rehash(n); }
    void rehash(size_t n) { table.rehash(n); }
    void clear() { table.clear(); }

    iterator begin() const { return iterator(&table, table.first()); }
    iterator end() const { return iterator(&table, 0); }
    iterator cbegin() const { return begin(); }
    iterator cend() const { return end(); }

    iterator find(const K &key) const { return iterator(&table, table.find(key)); }
    size_t count(const K &key) const { return table.find(key) ? 1 : 0; }
    bool contains(const K &key) const { return table.find(key) != 0; }

    pair<iterator, bool> insert(const K &v) {
        typename table_type::node *n = table.find(v);
        if (n) return pair<iterator, bool>(iterator(&table, n), false);
        return pair<iterator, bool>(iterator(&table, table.link(new typename table_type::node(table.hasher(v), v))), true);
    }
    pair<iterator, bool> insert(K &&v) {
        typename table_type::node *n = table.find(v);
        if (n) return pair<iterator, bool>(iterator(&table, n), false);
        size_t h = table.hasher(v);
        return pair<iterator, bool>(iterator(&table, table.link(new typename table_type::node(h, move(v)))), true);
    }
    template <class... Args> pair<iterator, bool> emplace(Args &&... args) { return insert(K(forward<Args>(args)...)); }

    size_t erase(const K &key) {
        typename table_type::node *n = table.find(key);
        return n && table.unlink(n) ? 1 : 0;
    }
    iterator erase(iterator position) {
        typename table_type::node *next = table.after(position.at);
        table.unlink(position.at);
        return iterator(&table, next);
    }

    void swap(unordered_set &other) noexcept {
        std::swap(table.buckets, other.table.buckets);
        std::swap(table.bucketCount, other.table.bucketCount);
        std::swap(table.count, other.table.count);
    }

private:
    table_type table;
};

}
#endif
