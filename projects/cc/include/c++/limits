// <limits>: numeric_limits for the built-in types.
#ifndef __MLXCC_LIMITS
#define __MLXCC_LIMITS
#include <limits.h>
#include <float.h>

namespace std {

enum float_round_style { round_indeterminate = -1, round_toward_zero = 0, round_to_nearest = 1, round_toward_infinity = 2, round_toward_neg_infinity = 3 };

template <class T> struct numeric_limits {
    static constexpr bool is_specialized = false;
    static constexpr bool traps = false;
    static constexpr bool tinyness_before = false;
    static constexpr bool is_signed = false;
    static constexpr bool is_integer = false;
    static constexpr bool is_exact = false;
    static constexpr int digits = 0;
    static constexpr int digits10 = 0;
    static constexpr int radix = 0;
    static constexpr T min() noexcept { return T(); }
    static constexpr T max() noexcept { return T(); }
    static constexpr T lowest() noexcept { return T(); }
};

#define __MLXCC_INTEGER_LIMITS(T, LOW, HIGH, SIGNED, DIGITS) \
    template <> struct numeric_limits<T> { \
        static constexpr bool is_specialized = true; \
        static constexpr bool traps = true; \
        static constexpr bool tinyness_before = false; \
        static constexpr bool is_signed = SIGNED; \
        static constexpr bool is_integer = true; \
        static constexpr bool is_exact = true; \
        static constexpr bool has_infinity = false; \
        static constexpr bool has_quiet_NaN = false; \
        static constexpr bool is_bounded = true; \
        static constexpr bool is_modulo = !SIGNED; \
        static constexpr int digits = DIGITS; \
        static constexpr int digits10 = DIGITS * 3 / 10; \
        static constexpr int radix = 2; \
        static constexpr T min() noexcept { return LOW; } \
        static constexpr T max() noexcept { return HIGH; } \
        static constexpr T lowest() noexcept { return LOW; } \
        static constexpr T epsilon() noexcept { return 0; } \
        static constexpr T round_error() noexcept { return 0; } \
        static constexpr T infinity() noexcept { return 0; } \
        static constexpr T quiet_NaN() noexcept { return 0; } \
        static constexpr bool has_signaling_NaN = false; \
        static constexpr T signaling_NaN() noexcept { return 0; } \
        static constexpr T denorm_min() noexcept { return 0; } \
    };
__MLXCC_INTEGER_LIMITS(bool, false, true, false, 1)
__MLXCC_INTEGER_LIMITS(char, CHAR_MIN, CHAR_MAX, true, 7)
__MLXCC_INTEGER_LIMITS(unsigned char, 0, UCHAR_MAX, false, 8)
__MLXCC_INTEGER_LIMITS(short, SHRT_MIN, SHRT_MAX, true, 15)
__MLXCC_INTEGER_LIMITS(unsigned short, 0, USHRT_MAX, false, 16)
__MLXCC_INTEGER_LIMITS(int, INT_MIN, INT_MAX, true, 31)
__MLXCC_INTEGER_LIMITS(unsigned int, 0U, UINT_MAX, false, 32)
__MLXCC_INTEGER_LIMITS(long, LONG_MIN, LONG_MAX, true, 63)
__MLXCC_INTEGER_LIMITS(unsigned long, 0UL, ULONG_MAX, false, 64)
__MLXCC_INTEGER_LIMITS(signed char, SCHAR_MIN, SCHAR_MAX, true, 7)
__MLXCC_INTEGER_LIMITS(long long, LLONG_MIN, LLONG_MAX, true, 63)
__MLXCC_INTEGER_LIMITS(unsigned long long, 0ULL, ULLONG_MAX, false, 64)
__MLXCC_INTEGER_LIMITS(wchar_t, (wchar_t)INT_MIN, (wchar_t)INT_MAX, true, 31)
#if __cplusplus >= 202002L
__MLXCC_INTEGER_LIMITS(char8_t, (char8_t)0, (char8_t)UCHAR_MAX, false, 8)
#endif
__MLXCC_INTEGER_LIMITS(char16_t, (char16_t)0, (char16_t)USHRT_MAX, false, 16)
__MLXCC_INTEGER_LIMITS(char32_t, (char32_t)0, (char32_t)UINT_MAX, false, 32)
#undef __MLXCC_INTEGER_LIMITS

#define __MLXCC_FLOAT_LIMITS(T, P, LOW, HIGH, EPS, DIGITS, DIGITS10, MINVAL, INF, NAN_, SNAN) \
    template <> struct numeric_limits<T> { \
        static constexpr bool is_specialized = true; \
        static constexpr bool traps = false; \
        static constexpr bool tinyness_before = false; \
        static constexpr bool is_signed = true; \
        static constexpr bool is_integer = false; \
        static constexpr bool is_exact = false; \
        static constexpr bool has_infinity = true; \
        static constexpr bool has_quiet_NaN = true; \
        static constexpr bool is_bounded = true; \
        static constexpr bool is_modulo = false; \
        static constexpr bool is_iec559 = true; \
        static constexpr int digits = DIGITS; \
        static constexpr int digits10 = DIGITS10; \
        static constexpr int radix = 2; \
        static constexpr int min_exponent = P##_MIN_EXP; \
        static constexpr int max_exponent = P##_MAX_EXP; \
        static constexpr int min_exponent10 = P##_MIN_10_EXP; \
        static constexpr int max_exponent10 = P##_MAX_10_EXP; \
        static constexpr float_round_style round_style = round_to_nearest; \
        static constexpr T min() noexcept { return MINVAL; } \
        static constexpr T max() noexcept { return HIGH; } \
        static constexpr T lowest() noexcept { return LOW; } \
        static constexpr T epsilon() noexcept { return EPS; } \
        static constexpr T round_error() noexcept { return 0.5; } \
        static constexpr T infinity() noexcept { return INF; } \
        static constexpr T quiet_NaN() noexcept { return NAN_; } \
        static constexpr bool has_signaling_NaN = true; \
        static constexpr T signaling_NaN() noexcept { return SNAN; } \
        static constexpr T denorm_min() noexcept { return MINVAL; } \
    };
// (The NaNs as GCC's builtins make them: positive, the quiet bit set or
// not; inf - inf would be x86's negative default NaN.)
__MLXCC_FLOAT_LIMITS(float, FLT, -FLT_MAX, FLT_MAX, FLT_EPSILON, FLT_MANT_DIG, FLT_DIG, FLT_MIN, (float)(1.0e300 * 1.0e300), __builtin_bit_cast(float, 0x7fc00000U), __builtin_bit_cast(float, 0x7fa00000U))
__MLXCC_FLOAT_LIMITS(double, DBL, -DBL_MAX, DBL_MAX, DBL_EPSILON, DBL_MANT_DIG, DBL_DIG, DBL_MIN, 1.0e300 * 1.0e300, __builtin_bit_cast(double, 0x7ff8000000000000ULL), __builtin_bit_cast(double, 0x7ff4000000000000ULL))
__MLXCC_FLOAT_LIMITS(long double, LDBL, -LDBL_MAX, LDBL_MAX, LDBL_EPSILON, LDBL_MANT_DIG, LDBL_DIG, LDBL_MIN, (long double)(1.0e300 * 1.0e300), -(long double)(1.0e300 * 1.0e300 - 1.0e300 * 1.0e300), -(long double)(1.0e300 * 1.0e300 - 1.0e300 * 1.0e300))
#undef __MLXCC_FLOAT_LIMITS

}
#endif
