// <numeric>: accumulate, inner_product, partial_sum, adjacent_difference,
// iota, reduce, midpoint, gcd, lcm.
#ifndef __MLXCC_NUMERIC
#define __MLXCC_NUMERIC

#include <type_traits>

namespace std {

template <typename I, typename T> T accumulate(I first, I last, T sum) {
    for (; first != last; ++first) sum = sum + *first;
    return sum;
}
template <typename I, typename T, typename F> T accumulate(I first, I last, T sum, F f) {
    for (; first != last; ++first) sum = f(sum, *first);
    return sum;
}
template <typename I, typename T> T reduce(I first, I last, T sum) { return accumulate(first, last, sum); }
template <typename I1, typename I2, typename T> T inner_product(I1 first, I1 last, I2 other, T sum) {
    for (; first != last; ++first, ++other) sum = sum + *first * *other;
    return sum;
}
// Values counting up from `value`.
template <typename I, typename T> constexpr void iota(I first, I last, T value) {
    for (; first != last; ++first, ++value) *first = value;
}
template <typename I, typename O> O partial_sum(I first, I last, O out) {
    if (first == last) return out;
    auto sum = *first;
    *out = sum;
    for (++first, ++out; first != last; ++first, ++out) { sum = sum + *first; *out = sum; }
    return out;
}
template <typename I, typename O> O adjacent_difference(I first, I last, O out) {
    if (first == last) return out;
    auto previous = *first;
    *out = previous;
    for (++first, ++out; first != last; ++first, ++out) { auto value = *first; *out = value - previous; previous = value; }
    return out;
}

// midpoint: (a + b) / 2 without overflow, rounded towards a (integers);
// of two pointers into one array, the element between them.
template <class T> constexpr typename enable_if<is_integral<T>::value && !is_same<T, bool>::value, T>::type midpoint(T a, T b) noexcept {
    typedef typename make_unsigned<T>::type U;
    if (a > b) return a - static_cast<T>(static_cast<U>(static_cast<U>(a) - static_cast<U>(b)) / 2);
    return a + static_cast<T>(static_cast<U>(static_cast<U>(b) - static_cast<U>(a)) / 2);
}
template <class T> constexpr typename enable_if<is_floating_point<T>::value, T>::type midpoint(T a, T b) noexcept { return a / 2 + b / 2; }
template <class T> constexpr T *midpoint(T *a, T *b) { return a + (b - a) / 2; }

// gcd and lcm of two integers.
template <class M, class N> constexpr typename common_type<M, N>::type gcd(M m, N n) {
    typedef typename common_type<M, N>::type C;
    C a = m < 0 ? C(-m) : C(m), b = n < 0 ? C(-n) : C(n);
    while (b != 0) { C t = a % b; a = b; b = t; }
    return a;
}
template <class M, class N> constexpr typename common_type<M, N>::type lcm(M m, N n) {
    typedef typename common_type<M, N>::type C;
    if (m == 0 || n == 0) return 0;
    C g = gcd(m, n);
    C a = m < 0 ? C(-m) : C(m), b = n < 0 ? C(-n) : C(n);
    return a / g * b;
}

}
#endif
