// <numeric>: accumulate, midpoint, gcd, lcm.
#ifndef __MLXCC_NUMERIC
#define __MLXCC_NUMERIC

#include <type_traits>

namespace std {

template <typename I, typename T> T accumulate(I first, I last, T sum) {
    for (; first != last; ++first) sum = sum + *first;
    return sum;
}

// midpoint: (a + b) / 2 without overflow, rounded towards a (integers);
// of two pointers into one array, the element between them.
template <class T> constexpr typename enable_if<is_integral<T>::value && !is_same<T, bool>::value, T>::type midpoint(T a, T b) noexcept {
    typedef typename make_unsigned<T>::type U;
    if (a > b) return a - static_cast<T>(static_cast<U>(static_cast<U>(a) - static_cast<U>(b)) / 2);
    return a + static_cast<T>(static_cast<U>(static_cast<U>(b) - static_cast<U>(a)) / 2);
}
template <class T> constexpr typename enable_if<is_floating_point<T>::value, T>::type midpoint(T a, T b) noexcept { return a / 2 + b / 2; }
template <class T> constexpr T *midpoint(T *a, T *b) { return a + (b - a) / 2; }

// gcd and lcm of two integers.
template <class M, class N> constexpr typename common_type<M, N>::type gcd(M m, N n) {
    typedef typename common_type<M, N>::type C;
    C a = m < 0 ? C(-m) : C(m), b = n < 0 ? C(-n) : C(n);
    while (b != 0) { C t = a % b; a = b; b = t; }
    return a;
}
template <class M, class N> constexpr typename common_type<M, N>::type lcm(M m, N n) {
    typedef typename common_type<M, N>::type C;
    if (m == 0 || n == 0) return 0;
    C g = gcd(m, n);
    C a = m < 0 ? C(-m) : C(m), b = n < 0 ? C(-n) : C(n);
    return a / g * b;
}

}
#endif
