// <sstream>: std::ostringstream, an ostream writing into a string of
// its own (all of ostream's << and formatting, passed as an ostream &), and
// std::istringstream, reading a string with >>. stringstream is the
// former with str(); neither shares code with the FILE streams.
#ifndef __MLXCC_SSTREAM
#define __MLXCC_SSTREAM
#include <stddef.h>
#include <string>
#include <iostream>
#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

namespace std {

class ostringstream : public ostream {
public:
    ostringstream() { init(); }
    ostringstream(const string &initial) : buffer(initial) { init(); }
    ostringstream(const ostringstream &) = delete;
    string str() const { return buffer; }
    void str(const string &text) { buffer = text; }
private:
    string buffer;
    void init() {
        which = 0;
        digits = 6;
        failed = false;
        format = 0;
        fieldWidth = 0;
        fillChar = 0;
        sink = &buffer;
    }
};

typedef ostringstream stringstream;

class istringstream {
public:
    istringstream() : at(0), failed(false) {}
    istringstream(const string &text) : source(text), at(0), failed(false) {}
    void str(const string &text) { source = text; at = 0; failed = false; }
    string str() const { return source; }
    bool fail() const { return failed; }
    bool eof() const { return at >= source.size(); }
    bool good() const { return !failed && at < source.size(); }
    void clear() { failed = false; }
    operator bool() const { return !failed; }
    int get() { if (at >= source.size()) { failed = true; return -1; } return (unsigned char)source[at++]; }
    int peek() const { return at < source.size() ? (unsigned char)source[at] : -1; }
    istringstream &operator>>(string &word) {
        skipSpace();
        size_t start = at;
        while (at < source.size() && !isspace(source[at])) at++;
        if (at == start) failed = true; else word = source.substr(start, at - start);
        return *this;
    }
    istringstream &operator>>(char &c) {
        skipSpace();
        if (at >= source.size()) failed = true; else c = source[at++];
        return *this;
    }
    istringstream &operator>>(long &value) {
        string word;
        *this >> word;
        if (failed) return *this;
        char *stop;
        long read = strtol(word.c_str(), &stop, 10);
        if (stop == word.c_str()) failed = true; else value = read;
        return *this;
    }
    istringstream &operator>>(unsigned long &value) { long v = 0; *this >> v; if (!failed) value = (unsigned long)v; return *this; }
    istringstream &operator>>(int &value) { long v = 0; *this >> v; if (!failed) value = (int)v; return *this; }
    istringstream &operator>>(unsigned &value) { long v = 0; *this >> v; if (!failed) value = (unsigned)v; return *this; }
    istringstream &operator>>(short &value) { long v = 0; *this >> v; if (!failed) value = (short)v; return *this; }
    istringstream &operator>>(bool &value) { long v = 0; *this >> v; if (!failed) value = v != 0; return *this; }
    istringstream &operator>>(double &value) {
        string word;
        *this >> word;
        if (failed) return *this;
        char *stop;
        double read = strtod(word.c_str(), &stop);
        if (stop == word.c_str()) failed = true; else value = read;
        return *this;
    }
    istringstream &operator>>(float &value) { double v = 0; *this >> v; if (!failed) value = (float)v; return *this; }
private:
    string source;
    size_t at;
    bool failed;
    void skipSpace() { while (at < source.size() && isspace(source[at])) at++; }
};

inline istringstream &getline(istringstream &in, string &line, char delimiter = '\n') {
    line.clear();
    if (in.eof()) { in.clear(); int c = in.get(); return in; }
    while (true) {
        int c = in.get();
        if (c < 0) { if (line.empty()) {} else in.clear(); break; }
        if (c == delimiter) break;
        line.push_back((char)c);
    }
    return in;
}

}
#endif
