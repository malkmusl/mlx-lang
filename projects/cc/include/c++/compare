// <compare>: the ordering types of C++20's three-way comparison `<=>`
// (strong_ordering, weak_ordering, partial_ordering: a small value,
// -1 less, 0 equal, 1 greater, 2 unordered), their comparisons with
// the literal 0, the conversions from the stronger to the weaker, and
// the helpers mlx-cc calls for `<=>` between numbers and pointers.
#ifndef __MLXCC_COMPARE
#define __MLXCC_COMPARE

namespace std {

class partial_ordering {
public:
    signed char __value;
    static const partial_ordering less;
    static const partial_ordering equivalent;
    static const partial_ordering greater;
    static const partial_ordering unordered;
};
__attribute__((weak)) const partial_ordering partial_ordering::less = {-1};
__attribute__((weak)) const partial_ordering partial_ordering::equivalent = {0};
__attribute__((weak)) const partial_ordering partial_ordering::greater = {1};
__attribute__((weak)) const partial_ordering partial_ordering::unordered = {2};

class weak_ordering {
public:
    signed char __value;
    static const weak_ordering less;
    static const weak_ordering equivalent;
    static const weak_ordering greater;
    constexpr operator partial_ordering() const noexcept { return partial_ordering{__value}; }
};
__attribute__((weak)) const weak_ordering weak_ordering::less = {-1};
__attribute__((weak)) const weak_ordering weak_ordering::equivalent = {0};
__attribute__((weak)) const weak_ordering weak_ordering::greater = {1};

class strong_ordering {
public:
    signed char __value;
    static const strong_ordering less;
    static const strong_ordering equal;
    static const strong_ordering equivalent;
    static const strong_ordering greater;
    constexpr operator partial_ordering() const noexcept { return partial_ordering{__value}; }
    constexpr operator weak_ordering() const noexcept { return weak_ordering{__value}; }
};
__attribute__((weak)) const strong_ordering strong_ordering::less = {-1};
__attribute__((weak)) const strong_ordering strong_ordering::equal = {0};
__attribute__((weak)) const strong_ordering strong_ordering::equivalent = {0};
__attribute__((weak)) const strong_ordering strong_ordering::greater = {1};

#define __MLXCC_ORDERING_OPERATORS(T) \
    constexpr bool operator==(T a, T b) noexcept { return a.__value == b.__value; } \
    constexpr bool operator!=(T a, T b) noexcept { return a.__value != b.__value; } \
    constexpr bool operator==(T a, int) noexcept { return a.__value == 0; } \
    constexpr bool operator!=(T a, int) noexcept { return a.__value != 0; } \
    constexpr bool operator<(T a, int) noexcept { return a.__value == -1; } \
    constexpr bool operator<=(T a, int) noexcept { return a.__value == -1 || a.__value == 0; } \
    constexpr bool operator>(T a, int) noexcept { return a.__value == 1; } \
    constexpr bool operator>=(T a, int) noexcept { return a.__value == 1 || a.__value == 0; } \
    constexpr bool operator==(int, T a) noexcept { return a.__value == 0; } \
    constexpr bool operator!=(int, T a) noexcept { return a.__value != 0; } \
    constexpr bool operator<(int, T a) noexcept { return a.__value == 1; } \
    constexpr bool operator<=(int, T a) noexcept { return a.__value == 1 || a.__value == 0; } \
    constexpr bool operator>(int, T a) noexcept { return a.__value == -1; } \
    constexpr bool operator>=(int, T a) noexcept { return a.__value == -1 || a.__value == 0; } \
    constexpr bool is_eq(T a) noexcept { return a.__value == 0; } \
    constexpr bool is_neq(T a) noexcept { return a.__value != 0; } \
    constexpr bool is_lt(T a) noexcept { return a.__value == -1; } \
    constexpr bool is_lteq(T a) noexcept { return a.__value == -1 || a.__value == 0; } \
    constexpr bool is_gt(T a) noexcept { return a.__value == 1; } \
    constexpr bool is_gteq(T a) noexcept { return a.__value == 1 || a.__value == 0; }
__MLXCC_ORDERING_OPERATORS(partial_ordering)
__MLXCC_ORDERING_OPERATORS(weak_ordering)
__MLXCC_ORDERING_OPERATORS(strong_ordering)
#undef __MLXCC_ORDERING_OPERATORS

// `a <=> b` between numbers or pointers (mlx-cc converts the operands
// to their common type first).
template <class T> constexpr strong_ordering __mlxcc_compare3(T a, T b) noexcept {
    return a < b ? strong_ordering::less : b < a ? strong_ordering::greater : strong_ordering::equal;
}
template <class T> constexpr partial_ordering __mlxcc_compare3p(T a, T b) noexcept {
    return a < b ? partial_ordering::less : b < a ? partial_ordering::greater : a == b ? partial_ordering::equivalent : partial_ordering::unordered;
}

template <class T> constexpr strong_ordering compare_three_way_result_helper(const T &a, const T &b) { return a <=> b; }
struct compare_three_way {
    template <class T, class U> constexpr auto operator()(const T &a, const U &b) const { return a <=> b; }
};

template <class... Ts> struct common_comparison_category { typedef strong_ordering type; };
template <class... Ts> using common_comparison_category_t = typename common_comparison_category<Ts...>::type;

}
#endif
