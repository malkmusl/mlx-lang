// <compare>: the ordering types of <=> (the operator itself is not
// in mlx-cc yet: what names the types compiles).
#ifndef __MLXCC_COMPARE
#define __MLXCC_COMPARE
namespace std {
struct strong_ordering {
    int value;
    static const strong_ordering less;
    static const strong_ordering equal;
    static const strong_ordering equivalent;
    static const strong_ordering greater;
};
struct weak_ordering { int value; };
struct partial_ordering { int value; };
inline bool operator==(strong_ordering a, strong_ordering b) { return a.value == b.value; }
inline bool operator!=(strong_ordering a, strong_ordering b) { return a.value != b.value; }
inline bool is_eq(strong_ordering o) { return o.value == 0; }
inline bool is_neq(strong_ordering o) { return o.value != 0; }
inline bool is_lt(strong_ordering o) { return o.value < 0; }
inline bool is_gt(strong_ordering o) { return o.value > 0; }
inline bool is_lteq(strong_ordering o) { return o.value <= 0; }
inline bool is_gteq(strong_ordering o) { return o.value >= 0; }
}
#endif
