// <utility>: move, forward, swap, exchange, declval, pair and
// make_pair, integer_sequence, in_place, piecewise_construct.
#ifndef __MLXCC_UTILITY
#define __MLXCC_UTILITY
#include <stddef.h>
#include <type_traits>
#include <compare>

namespace std {

template <class T> constexpr typename remove_reference<T>::type &&move(T &&x) noexcept { return static_cast<typename remove_reference<T>::type &&>(x); }
template <class T> constexpr T &&forward(typename remove_reference<T>::type &x) noexcept { return static_cast<T &&>(x); }
template <class T> constexpr T &&forward(typename remove_reference<T>::type &&x) noexcept { return static_cast<T &&>(x); }
template <class T> constexpr const T &as_const(T &x) noexcept { return x; }

template <class T> void swap(T &a, T &b) {
    T held(move(a));
    a = move(b);
    b = move(held);
}
template <class T, size_t N> void swap(T (&a)[N], T (&b)[N]) {
    for (size_t i = 0; i < N; i++) swap(a[i], b[i]);
}
template <class T, class U> T exchange(T &object, U &&value) {
    T old(move(object));
    object = forward<U>(value);
    return old;
}

template <class A, class B> struct pair {
    typedef A first_type;
    typedef B second_type;
    A first;
    B second;
    pair() : first(), second() {}
    pair(const A &a, const B &b) : first(a), second(b) {}
    template <class U, class V> pair(U &&a, V &&b) : first(forward<U>(a)), second(forward<V>(b)) {}
    pair(const pair &other) : first(other.first), second(other.second) {}
    pair(pair &&other) : first(move(other.first)), second(move(other.second)) {}
    template <class U, class V> pair(const pair<U, V> &other) : first(other.first), second(other.second) {}
    pair &operator=(const pair &other) {
        first = other.first;
        second = other.second;
        return *this;
    }
    pair &operator=(pair &&other) {
        first = move(other.first);
        second = move(other.second);
        return *this;
    }
    void swap(pair &other) {
        std::swap(first, other.first);
        std::swap(second, other.second);
    }
};

template <class A, class B> pair<typename decay<A>::type, typename decay<B>::type> make_pair(A &&a, B &&b) {
    return pair<typename decay<A>::type, typename decay<B>::type>(forward<A>(a), forward<B>(b));
}

template <class A, class B> bool operator==(const pair<A, B> &x, const pair<A, B> &y) { return x.first == y.first && x.second == y.second; }
template <class A, class B> bool operator!=(const pair<A, B> &x, const pair<A, B> &y) { return !(x == y); }
template <class A, class B> bool operator<(const pair<A, B> &x, const pair<A, B> &y) {
    if (x.first < y.first) return true;
    if (y.first < x.first) return false;
    return x.second < y.second;
}
template <class A, class B> bool operator>(const pair<A, B> &x, const pair<A, B> &y) { return y < x; }
template <class A, class B> bool operator<=(const pair<A, B> &x, const pair<A, B> &y) { return !(y < x); }
template <class A, class B> bool operator>=(const pair<A, B> &x, const pair<A, B> &y) { return !(x < y); }

template <size_t I, class T> struct tuple_element;
template <class T> struct tuple_size;
template <class A, class B> struct tuple_size<pair<A, B> > : integral_constant<size_t, 2> {};
template <class A, class B> struct tuple_element<0, pair<A, B> > { typedef A type; };
template <class A, class B> struct tuple_element<1, pair<A, B> > { typedef B type; };
template <size_t I, class T> using tuple_element_t = typename tuple_element<I, T>::type;
template <class T> constexpr size_t tuple_size_v = tuple_size<T>::value;

template <size_t I, class A, class B> struct __pair_get;
template <class A, class B> struct __pair_get<0, A, B> {
    static A &get(pair<A, B> &p) { return p.first; }
    static const A &get(const pair<A, B> &p) { return p.first; }
};
template <class A, class B> struct __pair_get<1, A, B> {
    static B &get(pair<A, B> &p) { return p.second; }
    static const B &get(const pair<A, B> &p) { return p.second; }
};
template <size_t I, class A, class B> typename tuple_element<I, pair<A, B> >::type &get(pair<A, B> &p) { return __pair_get<I, A, B>::get(p); }
template <size_t I, class A, class B> const typename tuple_element<I, pair<A, B> >::type &get(const pair<A, B> &p) { return __pair_get<I, A, B>::get(p); }

template <class T, T... Is> struct integer_sequence {
    typedef T value_type;
    static constexpr size_t size() noexcept { return sizeof...(Is); }
};
template <size_t... Is> using index_sequence = integer_sequence<size_t, Is...>;
template <class T, T N, T... Is> struct __make_integer_sequence : __make_integer_sequence<T, N - 1, N - 1, Is...> {};
template <class T, T... Is> struct __make_integer_sequence<T, 0, Is...> { typedef integer_sequence<T, Is...> type; };
template <class T, T N> using make_integer_sequence = typename __make_integer_sequence<T, N>::type;
template <size_t N> using make_index_sequence = make_integer_sequence<size_t, N>;
template <class... T> using index_sequence_for = make_index_sequence<sizeof...(T)>;

struct in_place_t { explicit in_place_t() = default; };
constexpr in_place_t in_place = in_place_t();
template <class T> struct in_place_type_t { explicit in_place_type_t() = default; };
template <size_t I> struct in_place_index_t { explicit in_place_index_t() = default; };
struct piecewise_construct_t { explicit piecewise_construct_t() = default; };
constexpr piecewise_construct_t piecewise_construct = piecewise_construct_t();


template <class A, class B> pair(A, B) -> pair<A, B>;
}
#endif
