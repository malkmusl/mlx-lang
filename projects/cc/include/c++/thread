// <thread>: std::thread over pthreads (a callable with its arguments,
// copied, called on the new thread), thread::id, this_thread (get_id,
// yield, sleep_for, sleep_until), hardware_concurrency.
#ifndef __MLXCC_THREAD
#define __MLXCC_THREAD
#include <pthread.h>
#include <sched.h>
#include <time.h>
#include <unistd.h>
#include <stddef.h>
#include <tuple>
#include <utility>
#include <type_traits>
#include <chrono>
#include <functional>

namespace std {

struct __thread_state {
    virtual ~__thread_state() {}
    virtual void run() = 0;
};

template <class F, class... Args> struct __thread_call : __thread_state {
    F f;
    tuple<Args...> args;
    template <class G, class... A> __thread_call(G &&g, A &&... a) : f(std::forward<G>(g)), args(std::forward<A>(a)...) {}
    template <size_t... Is> void call(index_sequence<Is...>) { std::__invoke(f, std::move(std::get<Is>(args))...); }
    void run() { call(make_index_sequence<sizeof...(Args)>()); }
};

extern "C" inline void *__thread_start(void *state) {
    __thread_state *s = static_cast<__thread_state *>(state);
    s->run();
    delete s;
    return 0;
}

class thread {
public:
    class id {
    public:
        id() noexcept : _handle(0) {}
        explicit id(pthread_t h) noexcept : _handle(h) {}
        pthread_t __handle() const { return _handle; }
    private:
        pthread_t _handle;
    };
    typedef pthread_t native_handle_type;

    thread() noexcept : _handle(0) {}
    template <class F, class... Args, class = typename enable_if<!is_same<typename decay<F>::type, thread>::value>::type>
    explicit thread(F &&f, Args &&... args) : _handle(0) {
        __thread_state *state = new __thread_call<typename decay<F>::type, typename decay<Args>::type...>(std::forward<F>(f), std::forward<Args>(args)...);
        if (pthread_create(&_handle, 0, __thread_start, state) != 0) {
            delete state;
            _handle = 0;
        }
    }
    thread(thread &&other) noexcept : _handle(other._handle) { other._handle = 0; }
    thread &operator=(thread &&other) noexcept { _handle = other._handle; other._handle = 0; return *this; }
    thread(const thread &) = delete;
    thread &operator=(const thread &) = delete;
    ~thread() {}
    bool joinable() const noexcept { return _handle != 0; }
    void join() { if (_handle) pthread_join(_handle, 0); _handle = 0; }
    void detach() { if (_handle) pthread_detach(_handle); _handle = 0; }
    id get_id() const noexcept { return id(_handle); }
    native_handle_type native_handle() { return _handle; }
    void swap(thread &other) noexcept { pthread_t h = _handle; _handle = other._handle; other._handle = h; }
    static unsigned hardware_concurrency() noexcept { long n = sysconf(_SC_NPROCESSORS_ONLN); return n > 0 ? (unsigned)n : 0; }
private:
    pthread_t _handle;
};

inline bool operator==(thread::id a, thread::id b) noexcept { return a.__handle() == b.__handle(); }
inline bool operator!=(thread::id a, thread::id b) noexcept { return a.__handle() != b.__handle(); }
inline bool operator<(thread::id a, thread::id b) noexcept { return a.__handle() < b.__handle(); }

template <class T> struct hash;
template <> struct hash<thread::id> { size_t operator()(thread::id i) const noexcept { return (size_t)i.__handle(); } };

namespace this_thread {
inline thread::id get_id() noexcept { return thread::id(pthread_self()); }
inline void yield() noexcept { sched_yield(); }
template <class Rep, class Period> void sleep_for(const chrono::duration<Rep, Period> &d) {
    long long ns = chrono::duration_cast<chrono::nanoseconds>(d).count();
    if (ns <= 0) return;
    struct timespec ts;
    ts.tv_sec = (time_t)(ns / 1000000000LL);
    ts.tv_nsec = (long)(ns % 1000000000LL);
    while (nanosleep(&ts, &ts) != 0) {}
}
template <class Clock, class Duration> void sleep_until(const chrono::time_point<Clock, Duration> &when) {
    sleep_for(when - Clock::now());
}
}

}
#endif
