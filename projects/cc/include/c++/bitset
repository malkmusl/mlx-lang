// <bitset>: std::bitset, N bits in an array of unsigned longs (bit I in
// word I / 64), the bits past N always zero.
#ifndef __MLXCC_BITSET
#define __MLXCC_BITSET
#include <stddef.h>
#include <string>

namespace std {

template <size_t N> class bitset {
    static constexpr size_t _bits = 8 * sizeof(unsigned long);
    static constexpr size_t _count = N == 0 ? 1 : (N + _bits - 1) / _bits;
    unsigned long _words[_count];

    constexpr void _trim() noexcept {
        if (N % _bits != 0) _words[_count - 1] &= (1UL << (N % _bits)) - 1;
        if (N == 0) _words[0] = 0;
    }

public:
    class reference {
        friend class bitset;
        bitset *_set;
        size_t _at;
        constexpr reference(bitset *set, size_t at) noexcept : _set(set), _at(at) {}
    public:
        constexpr reference &operator=(bool value) noexcept { _set->set(_at, value); return *this; }
        constexpr reference &operator=(const reference &other) noexcept { _set->set(_at, bool(other)); return *this; }
        constexpr operator bool() const noexcept { return _set->test(_at); }
        constexpr bool operator~() const noexcept { return !_set->test(_at); }
        constexpr reference &flip() noexcept { _set->flip(_at); return *this; }
    };

    constexpr bitset() noexcept : _words() {}
    constexpr bitset(unsigned long long value) noexcept : _words() {
        _words[0] = (unsigned long)value;
        _trim();
    }
    explicit bitset(const string &text, size_t position = 0, size_t length = string::npos, char zero = '0', char one = '1') : _words() {
        size_t end = text.size();
        if (length != string::npos && position + length < end) end = position + length;
        size_t n = end > position ? end - position : 0;
        if (n > N) n = N;
        for (size_t i = 0; i < n; i++) {
            if (text[position + i] == one) set(n - 1 - i);
        }
        (void)zero;
    }
    explicit bitset(const char *text, size_t length = (size_t)-1, char zero = '0', char one = '1') : _words() {
        size_t n = 0;
        while ((length == (size_t)-1 || n < length) && text[n]) n++;
        size_t used = n > N ? N : n;
        for (size_t i = 0; i < used; i++) {
            if (text[i] == one) set(used - 1 - i);
        }
        (void)zero;
    }

    constexpr bool operator[](size_t at) const { return test(at); }
    constexpr reference operator[](size_t at) { return reference(this, at); }
    constexpr bool test(size_t at) const { return (_words[at / _bits] >> (at % _bits)) & 1; }
    constexpr bool all() const noexcept { return count() == N; }
    constexpr bool any() const noexcept {
        for (size_t i = 0; i < _count; i++) if (_words[i]) return true;
        return false;
    }
    constexpr bool none() const noexcept { return !any(); }
    constexpr size_t count() const noexcept {
        size_t n = 0;
        for (size_t i = 0; i < _count; i++) n += __builtin_popcountl(_words[i]);
        return n;
    }
    constexpr size_t size() const noexcept { return N; }

    constexpr bitset &set() noexcept {
        for (size_t i = 0; i < _count; i++) _words[i] = ~0UL;
        _trim();
        return *this;
    }
    constexpr bitset &set(size_t at, bool value = true) {
        if (value) _words[at / _bits] |= 1UL << (at % _bits);
        else _words[at / _bits] &= ~(1UL << (at % _bits));
        return *this;
    }
    constexpr bitset &reset() noexcept {
        for (size_t i = 0; i < _count; i++) _words[i] = 0;
        return *this;
    }
    constexpr bitset &reset(size_t at) { return set(at, false); }
    constexpr bitset &flip() noexcept {
        for (size_t i = 0; i < _count; i++) _words[i] = ~_words[i];
        _trim();
        return *this;
    }
    constexpr bitset &flip(size_t at) { return set(at, !test(at)); }

    constexpr bitset &operator&=(const bitset &other) noexcept {
        for (size_t i = 0; i < _count; i++) _words[i] &= other._words[i];
        return *this;
    }
    constexpr bitset &operator|=(const bitset &other) noexcept {
        for (size_t i = 0; i < _count; i++) _words[i] |= other._words[i];
        return *this;
    }
    constexpr bitset &operator^=(const bitset &other) noexcept {
        for (size_t i = 0; i < _count; i++) _words[i] ^= other._words[i];
        return *this;
    }
    constexpr bitset operator~() const noexcept {
        bitset made(*this);
        return made.flip();
    }
    constexpr bitset &operator<<=(size_t shift) noexcept {
        for (size_t i = N; i-- > 0;) set(i, i >= shift && test(i - shift));
        return *this;
    }
    constexpr bitset &operator>>=(size_t shift) noexcept {
        for (size_t i = 0; i < N; i++) set(i, i + shift < N && test(i + shift));
        return *this;
    }
    constexpr bitset operator<<(size_t shift) const noexcept { bitset made(*this); made <<= shift; return made; }
    constexpr bitset operator>>(size_t shift) const noexcept { bitset made(*this); made >>= shift; return made; }
    constexpr bool operator==(const bitset &other) const noexcept {
        for (size_t i = 0; i < _count; i++) if (_words[i] != other._words[i]) return false;
        return true;
    }
    constexpr bool operator!=(const bitset &other) const noexcept { return !(*this == other); }

    constexpr unsigned long to_ulong() const { return _words[0]; }
    constexpr unsigned long long to_ullong() const { return _words[0]; }
    string to_string(char zero = '0', char one = '1') const {
        string text;
        for (size_t i = N; i-- > 0;) text.push_back(test(i) ? one : zero);
        return text;
    }
};

template <size_t N> constexpr bitset<N> operator&(const bitset<N> &a, const bitset<N> &b) noexcept { bitset<N> made(a); made &= b; return made; }
template <size_t N> constexpr bitset<N> operator|(const bitset<N> &a, const bitset<N> &b) noexcept { bitset<N> made(a); made |= b; return made; }
template <size_t N> constexpr bitset<N> operator^(const bitset<N> &a, const bitset<N> &b) noexcept { bitset<N> made(a); made ^= b; return made; }

}
#endif
