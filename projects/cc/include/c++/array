// <array>: std::array, a C array with the container's members.
#ifndef __MLXCC_ARRAY
#define __MLXCC_ARRAY
#include <stddef.h>
#include <utility>
#include <type_traits>
#include <initializer_list>

namespace std {

template <class T, size_t N> struct array {
    typedef T value_type;
    typedef T *iterator;
    typedef const T *const_iterator;
    typedef size_t size_type;
    T _elements[N];
    constexpr T &operator[](size_t i) { return _elements[i]; }
    constexpr const T &operator[](size_t i) const { return _elements[i]; }
    constexpr T &at(size_t i) { return _elements[i]; }
    constexpr const T &at(size_t i) const { return _elements[i]; }
    constexpr T &front() { return _elements[0]; }
    constexpr const T &front() const { return _elements[0]; }
    constexpr T &back() { return _elements[N - 1]; }
    constexpr const T &back() const { return _elements[N - 1]; }
    constexpr T *data() noexcept { return _elements; }
    constexpr const T *data() const noexcept { return _elements; }
    constexpr T *begin() noexcept { return _elements; }
    constexpr const T *begin() const noexcept { return _elements; }
    constexpr const T *cbegin() const noexcept { return _elements; }
    constexpr T *end() noexcept { return _elements + N; }
    constexpr const T *end() const noexcept { return _elements + N; }
    constexpr const T *cend() const noexcept { return _elements + N; }
    constexpr size_t size() const noexcept { return N; }
    constexpr size_t max_size() const noexcept { return N; }
    constexpr bool empty() const noexcept { return N == 0; }
    void fill(const T &value) { for (size_t i = 0; i < N; i++) _elements[i] = value; }
    void swap(array &other) { for (size_t i = 0; i < N; i++) std::swap(_elements[i], other._elements[i]); }
};

template <class T, size_t N> bool operator==(const array<T, N> &a, const array<T, N> &b) {
    for (size_t i = 0; i < N; i++) if (!(a[i] == b[i])) return false;
    return true;
}
template <class T, size_t N> bool operator!=(const array<T, N> &a, const array<T, N> &b) { return !(a == b); }
template <size_t I, class T, size_t N> T &get(array<T, N> &a) noexcept { return a._elements[I]; }
template <size_t I, class T, size_t N> const T &get(const array<T, N> &a) noexcept { return a._elements[I]; }
template <class T, size_t N> struct tuple_size<array<T, N> > : integral_constant<size_t, N> {};
template <size_t I, class T, size_t N> struct tuple_element<I, array<T, N> > { typedef T type; };
template <class T, size_t N> T *begin(array<T, N> &a) { return a.begin(); }
template <class T, size_t N> T *end(array<T, N> &a) { return a.end(); }


template <class T, class... U> array(T, U...) -> array<T, 1 + sizeof...(U)>;

// C++20's to_array: a built-in array's elements copied (or moved) into
// an array.
template <class T, size_t N> constexpr array<remove_cv_t<T>, N> to_array(T (&a)[N]) {
    array<remove_cv_t<T>, N> made {};
    for (size_t i = 0; i < N; i++) made[i] = a[i];
    return made;
}
template <class T, size_t N> constexpr array<remove_cv_t<T>, N> to_array(T (&&a)[N]) {
    array<remove_cv_t<T>, N> made {};
    for (size_t i = 0; i < N; i++) made[i] = std::move(a[i]);
    return made;
}
}
#endif
