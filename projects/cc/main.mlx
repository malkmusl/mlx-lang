// mlx-cc: a C compiler written in Mlx, for MLX/Linux without GNU. It
// preprocesses, parses and compiles C into an x86_64 ELF program itself,
// with the Mlx compiler's encoder and object writer: no assembler, no
// linker. The programs call the C library through libc.so.6 (mlxlibc on
// MLX/Linux, glibc elsewhere).
//
//     mlx-cc [-o OUTPUT] [-std=VARIANT] [-I DIR] [-D NAME[=VALUE]] [-U NAME]
//            [-lNAME] [--dynamic-linker PATH] [-E] FILE.c...
//
// -std= names the C variant (standard.mlx): c89, c99, c11, c17, c23 and
// gnu89 ... gnu23 (gnu17, gcc's default, is the default here too); -ansi
// is c89.
// -E writes the preprocessed tokens to stdout instead. The system headers
// are mlx-cc's own (projects/cc/include): $MLX_CC_INCLUDE, else the
// `include` directory next to the program, else
// /usr/local/lib/mlx-cc/include.
const std = @import("std")
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const preprocess = @import("./preprocess.mlx")
const paths = @import("./paths.mlx")
const types = @import("./types.mlx")
const scope = @import("./scope.mlx")
const state = @import("./state.mlx")
const literal = @import("./literal.mlx")
const decl = @import("./decl.mlx")
const x86 = @import("./x86.mlx")
const program = @import("./program.mlx")
const standard = @import("./standard.mlx")

const SYS_readlink: usize = 89

const PREDEFINED: []const u8 = "#define __STDC__ 1\n#define __STDC_HOSTED__ 1\n#define __x86_64__ 1\n#define __x86_64 1\n#define __amd64__ 1\n#define __linux__ 1\n#define __linux 1\n#define __unix__ 1\n#define __unix 1\n#define __LP64__ 1\n#define _LP64 1\n#define __ELF__ 1\n#define __CHAR_BIT__ 8\n#define __SIZEOF_INT__ 4\n#define __SIZEOF_LONG__ 8\n#define __SIZEOF_LONG_LONG__ 8\n#define __SIZEOF_POINTER__ 8\n#define __SIZEOF_SHORT__ 2\n#define __SIZEOF_SIZE_T__ 8\n#define __SIZE_TYPE__ unsigned long\n#define __PTRDIFF_TYPE__ long\n#define __WCHAR_TYPE__ int\n#define __INTMAX_TYPE__ long\n#define __UINTMAX_TYPE__ unsigned long\n#define __BYTE_ORDER__ 1234\n#define __ORDER_LITTLE_ENDIAN__ 1234\n#define __ORDER_BIG_ENDIAN__ 4321\n#define __mlxcc__ 1\n#define __STDC_NO_ATOMICS__ 1\n#define __STDC_NO_COMPLEX__ 1\n#define __STDC_NO_THREADS__ 1\n#define __STDC_NO_VLA__ 1\n#define __STDC_UTF_16__ 1\n#define __STDC_UTF_32__ 1\n#define __STDC_IEC_559__ 1\n#define __SIZEOF_FLOAT__ 4\n#define __SIZEOF_DOUBLE__ 8\n#define __SIZEOF_LONG_DOUBLE__ 8\n#define __SIZEOF_WCHAR_T__ 4\n#define __CHAR16_TYPE__ unsigned short\n#define __CHAR32_TYPE__ unsigned int\n#define __WINT_TYPE__ unsigned int\n#define __SCHAR_MAX__ 127\n#define __SHRT_MAX__ 32767\n#define __INT_MAX__ 2147483647\n#define __LONG_MAX__ 9223372036854775807L\n#define __LONG_LONG_MAX__ 9223372036854775807LL\n#define __USER_LABEL_PREFIX__\n#define __signed signed\n#define __volatile volatile\n#define __builtin_expect(x, y) (x)\n#define __builtin_unreachable() ((void)0)\n#define __builtin_assume_aligned(p, a) (p)\n#define __has_attribute(x) 0\n#define __has_builtin(x) 0\n#define __has_feature(x) 0\n#define __has_extension(x) 0\n#define __has_c_attribute(x) 0\n"

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

// -D NAME or NAME=VALUE as a #define line.
fn defineLine(text: []const u8) -> []const u8 {
    const line = base.alloc(text.length + 16)
    base.putText(line, "#define ")
    var written: usize = 8
    var index: usize = 0
    var valued = false
    while index < text.length {
        if text[index] == 61 && !valued {
            base.put8(line + written, 32)
            valued = true
        } else {
            base.put8(line + written, text[index])
        }
        written += 1
        index += 1
    }
    if !valued {
        base.putText(line + written, " 1")
        written += 2
    }
    base.put8(line + written, 10)
    return base.bytes(line, written + 1)
}

// The system headers' directory.
fn systemInclude(environment: [*][*]const u8) -> void {
    var index: usize = 0
    while @intFromPtr(environment[index]) != 0 {
        const entry = cString(environment[index])
        if entry.length > 15 && base.same(entry[0..15], "MLX_CC_INCLUDE=") {
            paths.add(entry[15..entry.length], true)
            return
        }
        index += 1
    }
    var buffer: [4096]u8 = undefined
    const length = std.linux.syscall3(SYS_readlink, @intFromPtr("/proc/self/exe"), @intFromPtr(&buffer), 4095)
    if length > 0 {
        var view: [*]const u8 = undefined
        unsafe { view = @ptrCast([*]const u8, &buffer) }
        const exe = view[0..@intCast(usize, length)]
        const next_to = paths.join(paths.directoryOf(exe), "include")
        if paths.exists(next_to) {
            paths.add(next_to, true)
            return
        }
    }
    paths.add("/usr/local/lib/mlx-cc/include", true)
}

// -E: the tokens as text, a line break where a line began.
fn printTokens(list: usize) -> void {
    var at = list
    var first = true
    while !tokens.isEof(at) {
        if !first {
            if tokens.atLineStart(at) {
                const ignored = std.io.writeAll(std.io.stdout(), "\n")
            } else if tokens.at(at).*.flags & tokens.SPACE_BEFORE != 0 {
                const ignored = std.io.writeAll(std.io.stdout(), " ")
            }
        }
        first = false
        const written = std.io.writeAll(std.io.stdout(), tokens.text(at))
        at = tokens.next(at)
    }
    const ignored = std.io.writeAll(std.io.stdout(), "\n")
}

// The predefined macros, then -D and -U in their order.
fn commandLineMacros(defines: usize, defineCount: usize) -> void {
    preprocess.defineFrom("<built-in>", PREDEFINED)
    preprocess.defineFrom("<built-in>", standard.predefined())
    var defineIndex: usize = 0
    while defineIndex < defineCount {
        const text = base.getWord(defines + defineIndex * 16)
        const word = base.getWord(defines + defineIndex * 16 + 8)
        const length = word & 9223372036854775807
        if word == length {
            preprocess.defineFrom("<command line>", defineLine(base.bytes(text, length)))
        } else {
            const line = base.alloc(length + 10)
            base.putText(line, "#undef ")
            base.copy(line + 7, text, length)
            base.put8(line + 7 + length, 10)
            preprocess.defineFrom("<command line>", base.bytes(line, length + 8))
        }
        defineIndex += 1
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    if !base.init() { base.fatal("cannot reserve memory") }
    names.init()
    preprocess.init()
    types.init()
    scope.init()
    decl.init()
    x86.init()
    program.init()
    const environment = std.process.environmentEntries(arguments)
    var output: []const u8 = "a.out"
    var onlyPreprocess = false
    const files = base.alloc(arguments.length * 8)
    var fileCount: usize = 0
    var defines: usize = base.alloc(arguments.length * 16)
    var defineCount: usize = 0
    var index: usize = 1
    while index < arguments.length {
        const argument = cString(arguments[index])
        if base.same(argument, "-o") && index + 1 < arguments.length {
            index += 1
            output = cString(arguments[index])
        } else if base.same(argument, "-E") {
            onlyPreprocess = true
        } else if argument.length >= 2 && argument[0] == 45 && argument[1] == 73 {
            if argument.length > 2 {
                paths.add(argument[2..argument.length], false)
            } else if index + 1 < arguments.length {
                index += 1
                paths.add(cString(arguments[index]), false)
            }
        } else if argument.length >= 2 && argument[0] == 45 && (argument[1] == 68 || argument[1] == 85) {
            var value = argument[2..argument.length]
            if value.length == 0 && index + 1 < arguments.length {
                index += 1
                value = cString(arguments[index])
            }
            base.putWord(defines + defineCount * 16, base.keep(value))
            base.putWord(defines + defineCount * 16 + 8, if argument[1] == 68 { value.length } else { value.length | 9223372036854775808 })
            defineCount += 1
        } else if argument.length >= 2 && argument[0] == 45 && argument[1] == 108 {
            // -lNAME: a library the program needs besides libc.
            if argument.length > 2 {
                program.addLibrary(argument[2..argument.length])
            } else if index + 1 < arguments.length {
                index += 1
                program.addLibrary(cString(arguments[index]))
            }
        } else if base.same(argument, "--dynamic-linker") || base.same(argument, "-dynamic-linker") {
            if index + 1 < arguments.length {
                index += 1
                program.setInterpreter(cString(arguments[index]))
            }
        } else if argument.length > 17 && base.same(argument[0..17], "--dynamic-linker=") {
            program.setInterpreter(argument[17..argument.length])
        } else if argument.length > 21 && base.same(argument[0..21], "-Wl,--dynamic-linker=") {
            program.setInterpreter(argument[21..argument.length])
        } else if argument.length > 20 && base.same(argument[0..20], "-Wl,-dynamic-linker,") {
            program.setInterpreter(argument[20..argument.length])
        } else if base.same(argument, "-c") || base.same(argument, "-S") || base.same(argument, "-shared") {
            base.fatal("mlx-cc compiles whole programs: give it every .c file of the program at once")
        } else if argument.length > 5 && base.same(argument[0..5], "-std=") {
            if !standard.set(argument[5..argument.length]) {
                base.say("mlx-cc: unknown standard ")
                base.say(argument)
                base.say(" (c89, c99, c11, c17, c23, gnu89, gnu99, gnu11, gnu17, gnu23)\n")
                base.exit(1)
            }
        } else if base.same(argument, "-ansi") {
            const ok = standard.set("c89")
        } else if base.same(argument, "--version") || base.same(argument, "-v") {
            base.say("mlx-cc 0.2: a C compiler written in Mlx (x86_64 Linux); -std=c89 to c23 and gnu89 to gnu23, gnu17 by default\n")
            base.exit(0)
        } else if argument.length > 0 && argument[0] == 45 {
            // Options of other compilers that change nothing here.
            const c = if argument.length > 1 { argument[1] } else { 0 }
            const quiet = c == 79 || c == 103 || c == 87 || c == 119 || c == 102 || c == 109 || c == 76 || base.same(argument, "-pthread") || base.same(argument, "-pipe") || base.same(argument, "-pedantic")
            if !quiet {
                base.say("mlx-cc: ignoring ")
                base.say(argument)
                base.say("\n")
            }
        } else {
            base.putWord(files + fileCount * 8, base.keep(argument))
            fileCount += 1
        }
        index += 1
    }
    if fileCount == 0 { base.fatal("no input files") }
    systemInclude(environment)
    var fileIndex: usize = 0
    while fileIndex < fileCount {
        const address = base.getWord(files + fileIndex * 8)
        const path = base.bytes(address, base.cLength(address))
        const file = base.readFile(path)
        if file == 0 {
            base.say("mlx-cc: cannot read ")
            base.say(path)
            base.say("\n")
            base.exit(1)
        }
        // Each file is a translation unit of its own: the predefined
        // macros and the command line's, and nothing of the file before.
        if fileIndex > 0 { preprocess.startUnit() }
        commandLineMacros(defines, defineCount)
        const list = preprocess.processFile(file)
        if onlyPreprocess {
            printTokens(list)
        } else {
            literal.convert(list)
            state.startFile(file)
            decl.translationUnit(list)
            program.addUnit(state.globals())
            scope.reset()
        }
        fileIndex += 1
    }
    // (A bare return from this function would end with status 1: a gap
    // of the Mlx compiler, task-recorded; the run ends by exit instead.)
    if !onlyPreprocess { program.write(output) }
    base.exit(0)
}
