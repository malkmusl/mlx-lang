// mlx-cc: a C compiler written in Mlx, for MLX/Linux without GNU. It
// preprocesses, parses and compiles C into an x86_64 ELF program itself,
// with the Mlx compiler's encoder and object writer: no assembler, no
// linker. The programs call the C library through libc.so.6 (mlxlibc on
// MLX/Linux, glibc elsewhere).
//
//     mlx-cc [-o OUTPUT] [-std=VARIANT] [-I DIR] [-D NAME[=VALUE]] [-U NAME]
//            [-L DIR] [-lNAME] [--dynamic-linker PATH] [-E] [-c]
//            FILE.c... [FILE.o...] [LIBRARY.a...]
//
// The .c files given together are one translation unit's worth of
// program: their names are linked by name, and the whole is one
// relocatable object, which -c writes (FILE.o next to the working
// directory, or -o's name) and which is otherwise linked with the .o
// and .a files given (an archive's members as needed) into the program
// (program.mlx, the compiler's linker). -lNAME takes libNAME.a from a
// -L directory when there is one, else the shared libNAME.so.
// -std= names the C variant (standard.mlx): c89, c99, c11, c17, c23 and
// gnu89 ... gnu23 (gnu17, gcc's default, is the default here too); -ansi
// is c89.
// -E writes the preprocessed tokens to stdout instead. The system headers
// are mlx-cc's own (projects/cc/include): $MLX_CC_INCLUDE, else the
// `include` directory next to the program, else
// /usr/local/lib/mlx-cc/include.
const std = @import("std")
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const preprocess = @import("./preprocess.mlx")
const paths = @import("./paths.mlx")
const types = @import("./types.mlx")
const scope = @import("./scope.mlx")
const state = @import("./state.mlx")
const literal = @import("./literal.mlx")
const decl = @import("./decl.mlx")
const cpp = @import("./cpp.mlx")
const lambda = @import("./lambda.mlx")
const x86 = @import("./x86.mlx")
const program = @import("./program.mlx")
const standard = @import("./standard.mlx")
const ast = @import("./ast.mlx")

const SYS_readlink: usize = 89

const PREDEFINED: []const u8 = "#define __STDC__ 1\n#define __STDC_HOSTED__ 1\n#define __x86_64__ 1\n#define __x86_64 1\n#define __amd64__ 1\n#define __linux__ 1\n#define __linux 1\n#define __unix__ 1\n#define __unix 1\n#define __LP64__ 1\n#define _LP64 1\n#define __ELF__ 1\n#define __CHAR_BIT__ 8\n#define __SIZEOF_INT__ 4\n#define __SIZEOF_LONG__ 8\n#define __SIZEOF_LONG_LONG__ 8\n#define __SIZEOF_POINTER__ 8\n#define __SIZEOF_SHORT__ 2\n#define __SIZEOF_SIZE_T__ 8\n#define __SIZE_TYPE__ unsigned long\n#define __PTRDIFF_TYPE__ long\n#define __WCHAR_TYPE__ int\n#define __INTMAX_TYPE__ long\n#define __UINTMAX_TYPE__ unsigned long\n#define __BYTE_ORDER__ 1234\n#define __ORDER_LITTLE_ENDIAN__ 1234\n#define __ORDER_BIG_ENDIAN__ 4321\n#define __mlxcc__ 1\n#define __STDC_NO_ATOMICS__ 1\n#define __STDC_NO_COMPLEX__ 1\n#define __STDC_NO_THREADS__ 1\n#define __STDC_NO_VLA__ 1\n#define __STDC_UTF_16__ 1\n#define __STDC_UTF_32__ 1\n#define __STDC_IEC_559__ 1\n#define __SIZEOF_FLOAT__ 4\n#define __SIZEOF_DOUBLE__ 8\n#define __SIZEOF_LONG_DOUBLE__ 16\n#define __SIZEOF_WCHAR_T__ 4\n#define __CHAR16_TYPE__ unsigned short\n#define __CHAR32_TYPE__ unsigned int\n#define __WINT_TYPE__ unsigned int\n#define __SCHAR_MAX__ 127\n#define __SHRT_MAX__ 32767\n#define __INT_MAX__ 2147483647\n#define __LONG_MAX__ 9223372036854775807L\n#define __LONG_LONG_MAX__ 9223372036854775807LL\n#define __USER_LABEL_PREFIX__\n#define __signed signed\n#define __volatile volatile\n#define __attribute __attribute__\n#define __builtin_memcpy memcpy\n#define __builtin_memmove memmove\n#define __builtin_memset memset\n#define __builtin_memcmp memcmp\n#define __builtin_strlen strlen\n#define __builtin_strcmp strcmp\n#define __builtin_constant_p(x) 0\n#define __builtin_prefetch(...) ((void)0)\n#define __builtin_trap() __asm__(\"ud2\")\n#define __builtin_debugtrap() __asm__(\"int3\")\n#define __builtin_expect_with_probability(x, y, p) (x)\n#define __builtin_unpredictable(x) (x)\n#define __builtin_assume(x) ((void)0)\n#define __builtin_object_size(p, t) ((t) < 2 ? (unsigned long)-1 : 0UL)\n#define __builtin_frame_address(n) ((void *)0)\n#define __builtin_return_address(n) ((void *)0)\n#define __builtin_launder(p) (p)\n#define __builtin_addressof(x) (&(x))\n#define __builtin_fabs(x) ((x) < 0 ? -(x) : (x))\n#define __builtin_fabsf(x) ((x) < 0 ? -(x) : (x))\n#define __builtin_fabsl(x) ((x) < 0 ? -(x) : (x))\n#define __builtin_huge_val() (1e308 * 10.0)\n#define __builtin_huge_valf() ((float)(1e308 * 10.0))\n#define __builtin_inf() (1e308 * 10.0)\n#define __builtin_inff() ((float)(1e308 * 10.0))\n#define __builtin_nan(s) (0.0 / 0.0)\n#define __builtin_nanf(s) (0.0f / 0.0f)\n#define __builtin_isnan(x) ((x) != (x))\n#define __builtin_isinf(x) ((x) == (1e308 * 10.0) || (x) == -(1e308 * 10.0))\n#define __builtin_isfinite(x) (!__builtin_isnan(x) && !__builtin_isinf(x))\n#define __builtin_isinf_sign(x) ((x) == (1e308 * 10.0) ? 1 : (x) == -(1e308 * 10.0) ? -1 : 0)\n#define __builtin_LINE() __LINE__\n#define __builtin_FILE() __FILE__\n#define __builtin_FUNCTION() \"\"\n#define __builtin_is_constant_evaluated() 0\n#define __builtin_expect(x, y) (x)\n#define __builtin_unreachable() ((void)0)\n#define __builtin_assume_aligned(p, a) (p)\n#define __has_attribute(x) 0\n#define __has_cpp_attribute(x) 0\n#define __has_builtin(x) __mlxcc_has_builtin_##x\n#define __mlxcc_has_builtin___type_pack_element 1\n#define __mlxcc_has_builtin___builtin_expect 1\n#define __mlxcc_has_builtin___builtin_clz 1\n#define __mlxcc_has_builtin___builtin_ctz 1\n#define __mlxcc_has_builtin___builtin_popcount 1\n#define __mlxcc_has_builtin___builtin_bswap32 1\n#define __mlxcc_has_builtin___builtin_bswap64 1\n#define __mlxcc_has_builtin___builtin_unreachable 1\n#define __mlxcc_has_builtin___builtin_add_overflow 1\n#define __mlxcc_has_builtin___builtin_sub_overflow 1\n#define __mlxcc_has_builtin___builtin_mul_overflow 1\n#define __has_feature(x) 0\n#define __has_extension(x) 0\n#define __has_c_attribute(x) 0\n#define __STDC_EMBED_NOT_FOUND__ 0\n#define __STDC_EMBED_FOUND__ 1\n#define __STDC_EMBED_EMPTY__ 2\n#define __BITINT_MAXWIDTH__ 4096\n#define __ATOMIC_RELAXED 0\n#define __ATOMIC_CONSUME 1\n#define __ATOMIC_ACQUIRE 2\n#define __ATOMIC_RELEASE 3\n#define __ATOMIC_ACQ_REL 4\n#define __ATOMIC_SEQ_CST 5\n"

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

// -D NAME or NAME=VALUE as a #define line.
fn defineLine(text: []const u8) -> []const u8 {
    const line = base.alloc(text.length + 16)
    base.putText(line, "#define ")
    var written: usize = 8
    var index: usize = 0
    var valued = false
    while index < text.length {
        if text[index] == 61 && !valued {
            base.put8(line + written, 32)
            valued = true
        } else {
            base.put8(line + written, text[index])
        }
        written += 1
        index += 1
    }
    if !valued {
        base.putText(line + written, " 1")
        written += 2
    }
    base.put8(line + written, 10)
    return base.bytes(line, written + 1)
}

// The system headers' directory; for C++ its `c++` subdirectory first
// (the C++ headers, and C headers they include; the C ones are read as
// extern "C").
fn addSystemDirectory(directory: []const u8, cpp: bool) -> void {
    if cpp { paths.add(paths.join(directory, "c++"), true) }
    paths.add(directory, true)
}

fn systemInclude(environment: [*][*]const u8, cpp: bool) -> void {
    var index: usize = 0
    while @intFromPtr(environment[index]) != 0 {
        const entry = cString(environment[index])
        if entry.length > 15 && base.same(entry[0..15], "MLX_CC_INCLUDE=") {
            addSystemDirectory(entry[15..entry.length], cpp)
            return
        }
        index += 1
    }
    var buffer: [4096]u8 = undefined
    const length = std.linux.syscall3(SYS_readlink, @intFromPtr("/proc/self/exe"), @intFromPtr(&buffer), 4095)
    if length > 0 {
        var view: [*]const u8 = undefined
        unsafe { view = @ptrCast([*]const u8, &buffer) }
        const exe = view[0..@intCast(usize, length)]
        const next_to = paths.join(paths.directoryOf(exe), "include")
        if paths.exists(next_to) {
            addSystemDirectory(next_to, cpp)
            return
        }
    }
    addSystemDirectory("/usr/local/lib/mlx-cc/include", cpp)
}

// The C++ standard library (mlxlibcpp, tools/build_mlxlibcpp.sh) as
// libmlxcpp.a: in $MLX_CC_LIB, next to the compiler as lib/, or in
// /usr/local/lib/mlx-cc/lib; empty when it is nowhere (a program with
// its own operator new links without it).
fn systemLibrary(environment: [*][*]const u8) -> []const u8 {
    const name: []const u8 = "libmlxcpp.a"
    var index: usize = 0
    while @intFromPtr(environment[index]) != 0 {
        const entry = cString(environment[index])
        if entry.length > 11 && base.same(entry[0..11], "MLX_CC_LIB=") {
            const candidate = paths.join(entry[11..entry.length], name)
            if paths.exists(candidate) { return candidate }
            return ""
        }
        index += 1
    }
    var buffer: [4096]u8 = undefined
    const length = std.linux.syscall3(SYS_readlink, @intFromPtr("/proc/self/exe"), @intFromPtr(&buffer), 4095)
    if length > 0 {
        var view: [*]const u8 = undefined
        unsafe { view = @ptrCast([*]const u8, &buffer) }
        const exe = view[0..@intCast(usize, length)]
        const next_to = paths.join(paths.join(paths.directoryOf(exe), "lib"), name)
        if paths.exists(next_to) { return next_to }
    }
    const installed: []const u8 = "/usr/local/lib/mlx-cc/lib/libmlxcpp.a"
    if paths.exists(installed) { return installed }
    return ""
}

// What a C++ program links besides the C library: mlxlibcpp when it is
// found, and the math library.
fn addCppLibraries(environment: [*][*]const u8) -> void {
    const library = systemLibrary(environment)
    if library.length > 0 { program.addInput(library) }
    program.addLibrary("m")
}

// -E: the tokens as text, a line break where a line began.
fn printTokens(list: usize) -> void {
    var at = list
    var first = true
    while !tokens.isEof(at) {
        if !first {
            if tokens.atLineStart(at) {
                const ignored = std.io.writeAll(std.io.stdout(), "\n")
            } else if tokens.at(at).*.flags & tokens.SPACE_BEFORE != 0 {
                const ignored = std.io.writeAll(std.io.stdout(), " ")
            }
        }
        first = false
        const written = std.io.writeAll(std.io.stdout(), tokens.text(at))
        at = tokens.next(at)
    }
    const ignored = std.io.writeAll(std.io.stdout(), "\n")
}

// The token list `first` then `second` (0: none yet).
fn joined(first: usize, second: usize) -> usize {
    if first == 0 || tokens.isEof(first) { return second }
    var last = first
    while !tokens.isEof(tokens.next(last)) { last = tokens.next(last) }
    tokens.at(last).*.next = second
    return first
}

// The predefined macros, then -D and -U in their order.
fn commandLineMacros(defines: usize, defineCount: usize) -> void {
    preprocess.defineFrom("<built-in>", PREDEFINED)
    preprocess.defineFrom("<built-in>", standard.predefined())
    var defineIndex: usize = 0
    while defineIndex < defineCount {
        const text = base.getWord(defines + defineIndex * 16)
        const word = base.getWord(defines + defineIndex * 16 + 8)
        const length = word & 9223372036854775807
        if word == length {
            preprocess.defineFrom("<command line>", defineLine(base.bytes(text, length)))
        } else {
            const line = base.alloc(length + 10)
            base.putText(line, "#undef ")
            base.copy(line + 7, text, length)
            base.put8(line + 7 + length, 10)
            preprocess.defineFrom("<command line>", base.bytes(line, length + 8))
        }
        defineIndex += 1
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    if !base.init() { base.fatal("cannot reserve memory") }
    names.init()
    preprocess.init()
    types.init()
    scope.init()
    decl.init()
    cpp.init()
    lambda.init()
    x86.init()
    program.init()
    const environment = std.process.environmentEntries(arguments)
    var output: []const u8 = "a.out"
    var outputGiven = false
    var onlyPreprocess = false
    var compileOnly = false
    // -nostdlib++, -nostdlib: the C++ library is not linked by itself.
    var noStdlib = false
    // -std= as given (reapplied per file: a .c and a .cpp file differ),
    // -x c or -x c++ (0: by the file's name).
    var stdText: []const u8 = ""
    var language: u8 = 0
    const files = base.alloc(arguments.length * 8)
    var fileCount: usize = 0
    // -L directories (libNAME.a is looked for there).
    const libraryDirs = base.alloc(arguments.length * 8)
    var libraryDirCount: usize = 0
    var defines: usize = base.alloc(arguments.length * 16)
    var defineCount: usize = 0
    // -include FILE: read before each source file, as if its first line
    // included it.
    const forced = base.alloc(arguments.length * 8)
    var forcedCount: usize = 0
    var index: usize = 1
    while index < arguments.length {
        const argument = cString(arguments[index])
        if base.same(argument, "-o") && index + 1 < arguments.length {
            index += 1
            output = cString(arguments[index])
            outputGiven = true
        } else if base.same(argument, "-E") {
            onlyPreprocess = true
        } else if base.same(argument, "-c") {
            compileOnly = true
        } else if base.same(argument, "-nostdlib++") || base.same(argument, "-nostdlib") || base.same(argument, "-nodefaultlibs") {
            noStdlib = true
        } else if argument.length >= 2 && argument[0] == 45 && argument[1] == 76 {
            // -L DIR
            var dir = argument[2..argument.length]
            if dir.length == 0 && index + 1 < arguments.length {
                index += 1
                dir = cString(arguments[index])
            }
            base.putWord(libraryDirs + libraryDirCount * 8, base.keep(dir))
            libraryDirCount += 1
        } else if base.same(argument, "-include") && index + 1 < arguments.length {
            index += 1
            base.putWord(forced + forcedCount * 8, base.keep(cString(arguments[index])))
            forcedCount += 1
        } else if base.same(argument, "-isystem") && index + 1 < arguments.length {
            // (Searched as -I's directories are.)
            index += 1
            paths.add(cString(arguments[index]), false)
        } else if argument.length >= 2 && argument[0] == 45 && argument[1] == 73 {
            if argument.length > 2 {
                paths.add(argument[2..argument.length], false)
            } else if index + 1 < arguments.length {
                index += 1
                paths.add(cString(arguments[index]), false)
            }
        } else if argument.length >= 2 && argument[0] == 45 && (argument[1] == 68 || argument[1] == 85) {
            var value = argument[2..argument.length]
            if value.length == 0 && index + 1 < arguments.length {
                index += 1
                value = cString(arguments[index])
            }
            base.putWord(defines + defineCount * 16, base.keep(value))
            base.putWord(defines + defineCount * 16 + 8, if argument[1] == 68 { value.length } else { value.length | 9223372036854775808 })
            defineCount += 1
        } else if argument.length >= 2 && argument[0] == 45 && argument[1] == 108 {
            // -lNAME: libNAME.a in a -L directory, else a library the
            // program needs besides libc.
            var name = argument[2..argument.length]
            if name.length == 0 && index + 1 < arguments.length {
                index += 1
                name = cString(arguments[index])
            }
            var found = false
            var dirIndex: usize = 0
            while dirIndex < libraryDirCount && !found {
                const dir = base.getWord(libraryDirs + dirIndex * 8)
                const candidate = paths.join(base.bytes(dir, base.cLength(dir)), base.join(base.join("lib", name), ".a"))
                if paths.exists(candidate) {
                    program.addInput(candidate)
                    found = true
                }
                dirIndex += 1
            }
            if !found && base.same(name, "mlxcpp") {
                // The C++ library, wherever it is.
                const library = systemLibrary(environment)
                if library.length == 0 { base.fatal("libmlxcpp.a is nowhere (MLX_CC_LIB, tools/build_mlxlibcpp.sh)") }
                program.addInput(library)
                found = true
            }
            if !found { program.addLibrary(name) }
        } else if base.same(argument, "--dynamic-linker") || base.same(argument, "-dynamic-linker") {
            if index + 1 < arguments.length {
                index += 1
                program.setInterpreter(cString(arguments[index]))
            }
        } else if argument.length > 17 && base.same(argument[0..17], "--dynamic-linker=") {
            program.setInterpreter(argument[17..argument.length])
        } else if argument.length > 21 && base.same(argument[0..21], "-Wl,--dynamic-linker=") {
            program.setInterpreter(argument[21..argument.length])
        } else if argument.length > 20 && base.same(argument[0..20], "-Wl,-dynamic-linker,") {
            program.setInterpreter(argument[20..argument.length])
        } else if base.same(argument, "-S") || base.same(argument, "-shared") {
            base.fatal("mlx-cc does not write assembly or shared objects yet")
        } else if argument.length > 5 && base.same(argument[0..5], "-std=") {
            stdText = argument[5..argument.length]
            if !standard.set(stdText) {
                base.say("mlx-cc: unknown standard ")
                base.say(argument)
                base.say(" (c89, c99, c11, c17, c23, gnu89, gnu99, gnu11, gnu17, gnu23, c++11 to c++23, gnu++11 to gnu++23)\n")
                base.exit(1)
            }
        } else if base.same(argument, "-ansi") {
            stdText = "c89"
            const ok = standard.set("c89")
        } else if base.same(argument, "-x") || base.same(argument, "-xc") || base.same(argument, "-xc++") {
            var which = argument[2..argument.length]
            if which.length == 0 && index + 1 < arguments.length {
                index += 1
                which = cString(arguments[index])
            }
            if base.same(which, "c++") {
                language = 2
            } else if base.same(which, "c") {
                language = 1
            } else {
                base.fatal("-x takes c or c++")
            }
        } else if base.same(argument, "--version") || base.same(argument, "-v") {
            base.say("mlx-cc 0.2: a C compiler written in Mlx (x86_64 Linux); -std=c89 to c23 and gnu89 to gnu23, gnu17 by default\n")
            base.exit(0)
        } else if argument.length > 0 && argument[0] == 45 {
            // Options of other compilers that change nothing here.
            const c = if argument.length > 1 { argument[1] } else { 0 }
            const quiet = c == 79 || c == 103 || c == 87 || c == 119 || c == 102 || c == 109 || c == 76 || base.same(argument, "-pthread") || base.same(argument, "-pipe") || base.same(argument, "-pedantic")
            if !quiet {
                base.say("mlx-cc: ignoring ")
                base.say(argument)
                base.say("\n")
            }
        } else if isObjectName(argument) {
            program.addInput(argument)
        } else {
            base.putWord(files + fileCount * 8, base.keep(argument))
            fileCount += 1
        }
        index += 1
    }
    if fileCount == 0 && !(compileOnly || onlyPreprocess) && program.hasInputs() {
        // Objects and archives alone: linked (as a C++ program with -x c++).
        if language == 2 && !noStdlib { addCppLibraries(environment) }
        program.write(output)
        base.exit(0)
    }
    if fileCount == 0 { base.fatal("no input files") }
    if compileOnly && outputGiven && fileCount > 1 { base.fatal("-c with -o takes one .c file") }
    var anyCpp = language == 2
    var fileIndex: usize = 0
    while fileIndex < fileCount && language == 0 {
        const address = base.getWord(files + fileIndex * 8)
        if isCppName(base.bytes(address, base.cLength(address))) { anyCpp = true }
        fileIndex += 1
    }
    systemInclude(environment, anyCpp)
    if anyCpp && !compileOnly && !onlyPreprocess && !noStdlib { addCppLibraries(environment) }
    fileIndex = 0
    while fileIndex < fileCount {
        const address = base.getWord(files + fileIndex * 8)
        const path = base.bytes(address, base.cLength(address))
        // The language of this file: -x, else its name.
        const isCpp = language == 2 || (language == 0 && isCppName(path))
        applyStandard(stdText, isCpp)
        const file = base.readFile(path)
        if file == 0 {
            base.say("mlx-cc: cannot read ")
            base.say(path)
            base.say("\n")
            base.exit(1)
        }
        // Each file is a translation unit of its own: the predefined
        // macros and the command line's, and nothing of the file before.
        if fileIndex > 0 { preprocess.startUnit() }
        commandLineMacros(defines, defineCount)
        var list: usize = 0
        var forcedIndex: usize = 0
        while forcedIndex < forcedCount {
            const forcedAddress = base.getWord(forced + forcedIndex * 8)
            const forcedPath = base.bytes(forcedAddress, base.cLength(forcedAddress))
            const included = base.readFile(forcedPath)
            if included == 0 {
                base.say("mlx-cc: cannot read ")
                base.say(forcedPath)
                base.say(" (-include)\n")
                base.exit(1)
            }
            list = joined(list, preprocess.processFile(included))
            forcedIndex += 1
        }
        list = joined(list, preprocess.processFile(file))
        if onlyPreprocess {
            printTokens(list)
        } else {
            literal.convert(list)
            state.startFile(file)
            cpp.reset()
            decl.translationUnit(list)
            program.addUnit(state.globals())
            scope.reset()
            if compileOnly {
                // Each .c file an object of its own.
                wideRuntime(defines, defineCount)
                program.writeObject(if outputGiven { output } else { objectName(path) })
                program.resetUnits()
                x86.init()
                types.resetWideUsed()
            }
        }
        fileIndex += 1
    }
    if !onlyPreprocess && !compileOnly {
        wideRuntime(defines, defineCount)
        program.write(output)
    }
    // (A bare return from this function would end with status 1: a gap
    // of the Mlx compiler, task-recorded; the run ends by exit instead.)
    base.exit(0)
}

// The arithmetic of _BitInt over 64 bits (include/__mlxcc_wide.c),
// compiled into an object that uses such a type, its functions weak:
// one copy is linked when several objects carry it.
fn wideRuntime(defines: usize, defineCount: usize) -> void {
    if !types.wideUsed() { return }
    const path = paths.find("__mlxcc_wide.c", false, "", 0)
    if path.length == 0 { base.fatal("cannot find __mlxcc_wide.c among the system headers") }
    const file = base.readFile(path)
    if file == 0 { base.fatal("cannot read __mlxcc_wide.c") }
    preprocess.startUnit()
    const savedYear = standard.year
    const savedGnu = standard.gnu
    const savedCpp = standard.cpp
    const savedCppYear = standard.cppYear
    const ok = standard.set("gnu17")
    commandLineMacros(defines, defineCount)
    const list = preprocess.processFile(file)
    literal.convert(list)
    state.startFile(file)
    cpp.reset()
    decl.translationUnit(list)
    var o = state.globals()
    while o != 0 {
        if ast.obj(o).*.isFunction && ast.obj(o).*.isDefinition { ast.obj(o).*.isWeak = true }
        o = ast.obj(o).*.next
    }
    program.addUnit(state.globals())
    scope.reset()
    standard.year = savedYear
    standard.gnu = savedGnu
    standard.cpp = savedCpp
    standard.cppYear = savedCppYear
}

// Whether the file's name says C++ (.cpp, .cc, .cxx, .C, .c++).
fn isCppName(path: []const u8) -> bool {
    var dot: usize = path.length
    var index: usize = 0
    while index < path.length {
        if path[index] == 46 { dot = index }
        if path[index] == 47 { dot = path.length }
        index += 1
    }
    if dot >= path.length { return false }
    const extension = path[dot + 1..path.length]
    return base.same(extension, "cpp") || base.same(extension, "cc") || base.same(extension, "cxx") || base.same(extension, "C") || base.same(extension, "c++") || base.same(extension, "hpp")
}

// The variant for the next file: -std= when it fits the language, else
// the language's default (gnu17, gnu++17).
fn applyStandard(stdText: []const u8, isCpp: bool) -> void {
    if stdText.length > 0 && standard.isCppStandard(stdText) == isCpp {
        const ok = standard.set(stdText)
        return
    }
    if isCpp { standard.setCpp(true, 2017) } else { const ok = standard.set("gnu17") }
}

// Whether a command line argument names an object or an archive.
fn isObjectName(argument: []const u8) -> bool {
    if argument.length < 3 { return false }
    const tail = argument[argument.length - 2..argument.length]
    return base.same(tail, ".o") || base.same(tail, ".a")
}

// FILE.c as FILE.o in the working directory.
fn objectName(path: []const u8) -> []const u8 {
    var start: usize = 0
    var end = path.length
    var index: usize = 0
    while index < path.length {
        if path[index] == 47 { start = index + 1 }
        index += 1
    }
    if end >= 2 && path[end - 2] == 46 { end -= 2 }
    return base.join(path[start..end], ".o")
}
