// The C variant being compiled (-std=, -ansi): which year of the
// standard, and whether GNU's extensions are in (gnu89 ... gnu23) or the
// strict standard is (c89 ... c23). It decides the predefined macros
// (__STDC_VERSION__, __STRICT_ANSI__, `linux` and `unix`), which words
// are keywords (`inline` and `restrict` from C99, `typeof` in GNU C and
// C23, `bool`, `true`, `false`, `nullptr`, `static_assert`, `alignas`,
// `alignof`, `thread_local`, `typeof_unqual` and `constexpr` in C23),
// digit separators (C23) and whether `//` comments are allowed (not in
// ISO C90). gcc's default, gnu17, is the default here too.
const base = @import("./base.mlx")
const names = @import("./names.mlx")

pub const C89: u32 = 1989
pub const C99: u32 = 1999
pub const C11: u32 = 2011
pub const C17: u32 = 2017
pub const C23: u32 = 2023

pub var year: u32 = 2017
pub var gnu: bool = true

// Sets the variant from the text after -std= (c89, c90, c99, c9x, c11,
// c1x, c17, c18, c23, c2x, their gnu* spellings, iso9899:1990,
// iso9899:199409, iso9899:1999, iso9899:2011, iso9899:2017,
// iso9899:2018); false when the text names no variant.
pub fn set(text: []const u8) -> bool {
    var rest = text
    var isGnu = false
    if rest.length > 3 && base.same(rest[0..3], "gnu") {
        isGnu = true
        rest = rest[3..rest.length]
    } else if rest.length > 1 && rest[0] == 99 {
        rest = rest[1..rest.length]
    } else if rest.length > 8 && base.same(rest[0..8], "iso9899:") {
        rest = rest[8..rest.length]
    } else {
        return false
    }
    var found: u32 = 0
    if base.same(rest, "89") || base.same(rest, "90") || base.same(rest, "1990") || base.same(rest, "199409") {
        found = C89
    } else if base.same(rest, "99") || base.same(rest, "9x") || base.same(rest, "1999") {
        found = C99
    } else if base.same(rest, "11") || base.same(rest, "1x") || base.same(rest, "2011") {
        found = C11
    } else if base.same(rest, "17") || base.same(rest, "18") || base.same(rest, "2017") || base.same(rest, "2018") {
        found = C17
    } else if base.same(rest, "23") || base.same(rest, "2x") || base.same(rest, "2023") {
        found = C23
    } else {
        return false
    }
    year = found
    gnu = isGnu
    return true
}

pub fn atLeast(wanted: u32) -> bool { return year >= wanted }

// The macros the variant predefines, as #define lines.
pub fn predefined() -> []const u8 {
    var text: []const u8 = ""
    if year == C99 {
        text = "#define __STDC_VERSION__ 199901L\n"
    } else if year == C11 {
        text = "#define __STDC_VERSION__ 201112L\n"
    } else if year == C17 {
        text = "#define __STDC_VERSION__ 201710L\n"
    } else if year == C23 {
        text = "#define __STDC_VERSION__ 202311L\n"
    }
    if gnu {
        text = base.join(text, "#define linux 1\n#define unix 1\n")
    } else {
        text = base.join(text, "#define __STRICT_ANSI__ 1\n")
    }
    return text
}

// Whether the keyword `id` is one in this variant.
pub fn isKeyword(id: u32) -> bool {
    if id == names.K_INLINE { return gnu || year >= C99 }
    if id == names.K_RESTRICT { return year >= C99 }
    if id == names.K_ASM { return gnu }
    if id == names.K_TYPEOF { return gnu || year >= C23 }
    if id >= names.K_C23_BOOL && id <= names.K_CONSTEXPR { return year >= C23 }
    return true
}

// The keyword C23's spelling stands for: `bool` is `_Bool`,
// `static_assert` is `_Static_assert` and so on.
pub fn canonical(id: u32) -> u32 {
    if id == names.K_C23_BOOL { return names.K_BOOL }
    if id == names.K_C23_STATIC_ASSERT { return names.K_STATIC_ASSERT }
    if id == names.K_C23_ALIGNAS { return names.K_ALIGNAS }
    if id == names.K_C23_ALIGNOF { return names.K_ALIGNOF }
    if id == names.K_C23_THREAD_LOCAL { return names.K_THREAD_LOCAL }
    return id
}

// Digit separators (1'000'000) are C23's.
pub fn digitSeparators() -> bool { return year >= C23 }

// `//` comments came with C99; ISO C90 refuses them, GNU C90 takes them.
pub fn lineComments() -> bool { return gnu || year >= C99 }

// `true` and `false` are 1 and 0 in #if from C23 on.
pub fn booleanConstants() -> bool { return year >= C23 }

// The name of the variant, for --version.
pub fn describe() -> []const u8 {
    var text: []const u8 = if gnu { "gnu" } else { "c" }
    if year == C89 { return base.join(text, "89") }
    if year == C99 { return base.join(text, "99") }
    if year == C11 { return base.join(text, "11") }
    if year == C17 { return base.join(text, "17") }
    return base.join(text, "23")
}
