// The syntax tree: nodes for expressions and statements, objects for
// variables and functions, and the relocations of global initializers
// (an address a global holds). They live in the arena and are known by
// their address.
const base = @import("./base.mlx")
const tokens = @import("./tokens.mlx")

// Node kinds.
pub const ADD: u8 = 1
pub const SUB: u8 = 2
pub const MUL: u8 = 3
pub const DIV: u8 = 4
pub const MOD: u8 = 5
pub const BITAND: u8 = 6
pub const BITOR: u8 = 7
pub const BITXOR: u8 = 8
pub const SHL: u8 = 9
pub const SHR: u8 = 10
pub const EQ: u8 = 11
pub const NE: u8 = 12
pub const LT: u8 = 13
pub const LE: u8 = 14
pub const ASSIGN: u8 = 15
pub const COND: u8 = 16
pub const COMMA: u8 = 17
pub const MEMBER: u8 = 18
pub const ADDR: u8 = 19
pub const DEREF: u8 = 20
pub const NOT: u8 = 21
pub const BITNOT: u8 = 22
pub const LOGAND: u8 = 23
pub const LOGOR: u8 = 24
pub const RETURN: u8 = 25
pub const IF: u8 = 26
pub const FOR: u8 = 27
pub const DO: u8 = 28
pub const SWITCH: u8 = 29
pub const CASE: u8 = 30
pub const BLOCK: u8 = 31
pub const GOTO: u8 = 32
pub const LABEL: u8 = 33
pub const FUNCALL: u8 = 34
pub const EXPR_STMT: u8 = 35
pub const STMT_EXPR: u8 = 36
pub const VAR: u8 = 37
pub const NUM: u8 = 38
pub const CAST: u8 = 39
pub const MEMZERO: u8 = 40
pub const NULL_EXPR: u8 = 41
pub const NEG: u8 = 42
// A jump to a loop's or switch's own label (break, continue).
pub const JUMP: u8 = 43
pub const VA_START: u8 = 44
pub const VA_ARG: u8 = 45
pub const VA_COPY: u8 = 46

pub const Node = struct {
    kind: u8
    // The name of a GOTO or LABEL; a function call's callee name.
    name: u32
    ty: usize
    token: usize
    next: usize
    lhs: usize
    rhs: usize
    // if, for, while, do, ?:
    cond: usize
    then: usize
    els: usize
    init: usize
    inc: usize
    // A block's or statement expression's statements; a loop's body.
    body: usize
    // A member access's member.
    member: usize
    // A function call's type and arguments.
    funcType: usize
    args: usize
    // A variable.
    variable: usize
    // A number; a case's low and high values.
    value: i64
    high: i64
    // Labels: a loop's or switch's break and continue labels, a case's
    // label, a jump's target.
    breakLabel: u32
    continueLabel: u32
    label: u32
    // A switch's cases (linked through caseNext) and default.
    cases: usize
    caseNext: usize
    defaultCase: usize
    // A call argument passed on the stack; a call's buffer for a struct
    // it returns in memory.
    passByStack: bool
    returnBuffer: usize
}

pub const Obj = struct {
    name: u32
    // The symbol it has in the program (a static's name made unique).
    symbol: u32
    ty: usize
    token: usize
    next: usize
    isLocal: bool
    isFunction: bool
    isDefinition: bool
    isStatic: bool
    isExtern: bool
    isTentative: bool
    isInline: bool
    // A local's place below the frame pointer.
    offset: i64
    alignment: i64
    // A global's initial bytes and the addresses in them.
    initData: usize
    relocations: usize
    // A function's parameters and locals (Obj lists), body, frame size,
    // and the register save area of a variadic one.
    params: usize
    locals: usize
    body: usize
    stackSize: i64
    vaArea: usize
    // A string literal's object; a static local (its symbol is made
    // unique); the file a static belongs to.
    isLiteral: bool
    file: u32
    // Where code generation put it: a global's offset in the data area,
    // a function's or global's resolved definition (the one object of the
    // program its name stands for).
    placed: bool
    dataOffset: usize
    definition: usize
    // Whether the program refers to it (an unused static function is
    // left out).
    isReferenced: bool
}

// An address in a global's initial bytes: `offset` holds the address of
// the object `target` (an Obj) plus `addend`.
pub const Relocation = struct {
    offset: i64
    target: usize
    addend: i64
    next: usize
}

pub fn node(address: usize) -> *Node {
    unsafe { return @ptrFromInt(*Node, address) }
}

pub fn obj(address: usize) -> *Obj {
    unsafe { return @ptrFromInt(*Obj, address) }
}

pub fn relocation(address: usize) -> *Relocation {
    unsafe { return @ptrFromInt(*Relocation, address) }
}

pub fn make(kind: u8, token: usize) -> usize {
    const n = base.alloc(@sizeOf(Node))
    node(n).*.kind = kind
    node(n).*.token = token
    return n
}

pub fn binary(kind: u8, lhs: usize, rhs: usize, token: usize) -> usize {
    const n = make(kind, token)
    node(n).*.lhs = lhs
    node(n).*.rhs = rhs
    return n
}

pub fn unary(kind: u8, operand: usize, token: usize) -> usize {
    const n = make(kind, token)
    node(n).*.lhs = operand
    return n
}

pub fn number(value: i64, token: usize) -> usize {
    const n = make(NUM, token)
    node(n).*.value = value
    return n
}

pub fn variableNode(variable: usize, token: usize) -> usize {
    const n = make(VAR, token)
    node(n).*.variable = variable
    return n
}

pub fn newObj(name: u32, ty: usize, token: usize) -> usize {
    const o = base.alloc(@sizeOf(Obj))
    obj(o).*.name = name
    obj(o).*.symbol = name
    obj(o).*.ty = ty
    obj(o).*.token = token
    return o
}

pub fn kindOf(n: usize) -> u8 { return node(n).*.kind }
pub fn typeOf(n: usize) -> usize { return node(n).*.ty }
pub fn tokenOf(n: usize) -> usize { return node(n).*.token }

pub fn errorAt(n: usize, message: []const u8) -> void {
    tokens.errorAt(node(n).*.token, message)
}
