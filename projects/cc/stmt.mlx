// Statements (C11 6.8): blocks with their declarations, the selection,
// iteration and jump statements, labels and GNU case ranges. Loops and
// switches get their break and continue labels here; gotos are resolved
// to their labels when the function ends.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const decl = @import("./decl.mlx")
const expr = @import("./expr.mlx")
const eval = @import("./eval.mlx")
const standard = @import("./standard.mlx")
const cpp = @import("./cpp.mlx")

// A block, after its `{`.
pub fn compoundStatement() -> usize {
    const n = ast.make(ast.BLOCK, cursor.peek())
    var head: usize = 0
    var tail: usize = 0
    scope.enter()
    const height = state.cleanupCount()
    while !cursor.consume(names.P_RBRACE) {
        if cursor.isEof() { cursor.fail("unterminated block") }
        decl.stdAttributes()
        var item: usize = 0
        if isDeclaration() {
            item = declaration()
        } else if cursor.is(names.K_STATIC_ASSERT) {
            decl.staticAssert()
        } else if cursor.is(names.K_USING) {
            decl.usingDeclaration()
        } else {
            item = statement()
        }
        if item != 0 {
            typing.addType(item)
            if head == 0 { head = item } else { ast.node(tail).*.next = item }
            tail = item
        }
    }
    if standard.cpp {
        // The block's objects are destroyed as it ends.
        const item = cpp.leaveScope(height, cursor.peek())
        if item != 0 {
            typing.addType(item)
            if head == 0 { head = item } else { ast.node(tail).*.next = item }
            tail = item
        }
    }
    scope.leave()
    ast.node(n).*.body = head
    return n
}

// Whether a declaration starts here (a label is `name:`).
fn isDeclaration() -> bool {
    return decl.isTypename(cursor.peek()) && !cursor.isToken(cursor.peekNext(), names.P_COLON)
}

// A declaration in a block: the BLOCK of its initializers (0 for a
// typedef).
fn declaration() -> usize {
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    if decl.attrAt(attr).*.isTypedef {
        decl.parseTypedef(baseType)
        return 0
    }
    return decl.localDeclaration(baseType, attr)
}

// Passes a statement without reading it: a block to its `}`, else to
// the `;` ending it (an `if` without braces and its `else` are one).
fn skipStatement() -> void {
    if cursor.consume(names.P_LBRACE) {
        var level: u32 = 1
        while level > 0 {
            if cursor.isEof() { cursor.fail("unterminated block") }
            if cursor.is(names.P_LBRACE) { level += 1 }
            if cursor.is(names.P_RBRACE) { level -= 1 }
            cursor.advance()
        }
        return
    }
    const startsIf = cursor.is(names.K_IF)
    var level: i64 = 0
    while true {
        if cursor.isEof() { cursor.fail("unterminated statement") }
        if level == 0 && cursor.is(names.P_LBRACE) {
            // A block inside (`if (c) { ... }`): the statement's end.
            skipStatement()
            break
        }
        if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) { level += 1 }
        if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) { level -= 1 }
        if level == 0 && cursor.consume(names.P_SEMI) { break }
        cursor.advance()
    }
    if startsIf && cursor.consume(names.K_ELSE) { skipStatement() }
}

fn expressionStatement() -> usize {
    const token = cursor.peek()
    if cursor.consume(names.P_SEMI) { return ast.make(ast.BLOCK, token) }
    const n = ast.unary(ast.EXPR_STMT, fullExpression(false), token)
    cursor.expect(names.P_SEMI)
    return n
}

// An expression and, in C++, the destruction of its temporaries after
// it (its value kept when `keepValue`).
fn fullExpression(keepValue: bool) -> usize {
    const token = cursor.peek()
    var n = expr.expression()
    if !standard.cpp { return n }
    // A condition (its value is kept) of a class converts to bool.
    if keepValue { n = cpp.toCondition(n) }
    return cpp.flushTemporaries(n, keepValue, token)
}

fn jump(label: u32, token: usize, what: []const u8) -> usize {
    if label == 0 { tokens.errorAt(token, what) }
    const n = ast.make(ast.JUMP, token)
    ast.node(n).*.label = label
    if standard.cpp { return cpp.jumpStatement(n) }
    return n
}

// The value of a case label converted to the switch's type.
fn caseValue(switchNode: usize) -> i64 {
    const v = eval.constExpression()
    const ty = ast.typeOf(ast.node(switchNode).*.cond)
    const bits = @bitCast(u64, v)
    if types.size(ty) == 4 {
        if types.isUnsigned(ty) { return @bitCast(i64, bits & 4294967295) }
        return @bitCast(i64, (bits & 4294967295) ^ 2147483648) -% 2147483648
    }
    return v
}

pub fn statement() -> usize {
    const token = cursor.peek()
    if cursor.is(names.P_LBRACKET) && cursor.isToken(cursor.peekNext(), names.P_LBRACKET) {
        // C23's [[attributes]] on a statement; `[[fallthrough]];` is an
        // empty one.
        decl.stdAttributes()
        if cursor.consume(names.P_SEMI) { return ast.make(ast.BLOCK, token) }
        return statement()
    }
    if cursor.consume(names.K_RETURN) {
        const n = ast.make(ast.RETURN, token)
        if cursor.consume(names.P_SEMI) {
            if standard.cpp { return cpp.returnStatement(n) }
            return n
        }
        var value = expr.expression()
        cursor.expect(names.P_SEMI)
        typing.addType(value)
        const fnType = ast.obj(state.currentFunction()).*.ty
        if types.isAutoResult(types.baseOf(fnType)) {
            // A lambda's result: the first return's type.
            var deduced = ast.typeOf(value)
            if types.kind(deduced) == types.ARRAY { deduced = types.pointerTo(types.baseOf(deduced)) }
            if types.kind(deduced) == types.FUNC { deduced = types.pointerTo(deduced) }
            types.at(fnType).*.base = deduced
        }
        const rt = types.baseOf(fnType)
        if types.kind(rt) == types.VOID {
            ast.node(n).*.lhs = value
        } else if types.isReference(rt) {
            if standard.cpp { value = cpp.convertValue(value, rt) }
            ast.node(n).*.lhs = typing.toReference(value, rt)
        } else if types.kind(rt) != types.STRUCT && types.kind(rt) != types.UNION {
            ast.node(n).*.lhs = typing.cast(value, rt)
        } else {
            // A class returned by value: moved out of a temporary, copied
            // out of an object.
            if standard.cpp { value = cpp.returnValue(value, rt) }
            ast.node(n).*.lhs = value
        }
        if standard.cpp { return cpp.returnStatement(n) }
        return n
    }
    if cursor.consume(names.K_IF) {
        if standard.cpp && cursor.consume(names.K_CONSTEXPR) {
            // `if constexpr (c)`: the branch not taken is not read.
            cursor.expect(names.P_LPAREN)
            const taken = eval.constExpression() != 0
            cursor.expect(names.P_RPAREN)
            var result: usize = 0
            if taken { result = statement() } else { skipStatement() }
            if cursor.consume(names.K_ELSE) {
                if taken { skipStatement() } else { result = statement() }
            }
            if result == 0 { result = ast.make(ast.BLOCK, token) }
            return result
        }
        const n = ast.make(ast.IF, token)
        cursor.expect(names.P_LPAREN)
        ast.node(n).*.cond = fullExpression(true)
        cursor.expect(names.P_RPAREN)
        ast.node(n).*.then = statement()
        if cursor.consume(names.K_ELSE) { ast.node(n).*.els = statement() }
        return n
    }
    if cursor.consume(names.K_SWITCH) {
        const n = ast.make(ast.SWITCH, token)
        cursor.expect(names.P_LPAREN)
        const condition = fullExpression(true)
        typing.addType(condition)
        if !types.isInteger(ast.typeOf(condition)) { tokens.errorAt(token, "switch quantity is not an integer") }
        ast.node(n).*.cond = typing.cast(condition, types.promoted(ast.typeOf(condition)))
        typing.addType(ast.node(n).*.cond)
        cursor.expect(names.P_RPAREN)
        const outerSwitch = state.switchNode()
        const outerBreak = state.breakTarget()
        const outerCleanups = state.loopCleanups()
        state.setSwitchNode(n)
        ast.node(n).*.breakLabel = state.newLabel()
        state.setBreakTarget(ast.node(n).*.breakLabel)
        state.setLoopCleanups(state.cleanupCount())
        ast.node(n).*.then = statement()
        state.setSwitchNode(outerSwitch)
        state.setBreakTarget(outerBreak)
        state.setLoopCleanups(outerCleanups)
        return n
    }
    if cursor.consume(names.K_CASE) {
        const sw = state.switchNode()
        if sw == 0 { tokens.errorAt(token, "stray case") }
        const n = ast.make(ast.CASE, token)
        const low = caseValue(sw)
        var high = low
        if cursor.consume(names.P_ELLIPSIS) {
            high = caseValue(sw)
            if high < low { tokens.errorAt(token, "empty case range specified") }
        }
        cursor.expect(names.P_COLON)
        ast.node(n).*.label = state.newLabel()
        ast.node(n).*.value = low
        ast.node(n).*.high = high
        ast.node(n).*.caseNext = ast.node(sw).*.cases
        ast.node(sw).*.cases = n
        ast.node(n).*.lhs = caseBody()
        return n
    }
    if cursor.consume(names.K_DEFAULT) {
        const sw = state.switchNode()
        if sw == 0 { tokens.errorAt(token, "stray default") }
        cursor.expect(names.P_COLON)
        const n = ast.make(ast.CASE, token)
        ast.node(n).*.label = state.newLabel()
        ast.node(sw).*.defaultCase = n
        ast.node(n).*.lhs = caseBody()
        return n
    }
    if cursor.consume(names.K_FOR) {
        const n = ast.make(ast.FOR, token)
        cursor.expect(names.P_LPAREN)
        scope.enter()
        const height = state.cleanupCount()
        const outerBreak = state.breakTarget()
        const outerContinue = state.continueTarget()
        const outerCleanups = state.loopCleanups()
        ast.node(n).*.breakLabel = state.newLabel()
        ast.node(n).*.continueLabel = state.newLabel()
        state.setBreakTarget(ast.node(n).*.breakLabel)
        state.setContinueTarget(ast.node(n).*.continueLabel)
        if standard.cpp && cpp.startsRangeFor() {
            // `for (T x : range)`: over the range's begin() and end().
            const loop = cpp.rangeFor(n, token)
            state.setBreakTarget(outerBreak)
            state.setContinueTarget(outerContinue)
            state.setLoopCleanups(outerCleanups)
            var result = loop
            const ending = cpp.leaveScope(height, cursor.peek())
            if ending != 0 {
                result = ast.make(ast.BLOCK, token)
                ast.node(result).*.body = loop
                ast.node(loop).*.next = ending
            }
            scope.leave()
            return result
        }
        if decl.isTypename(cursor.peek()) {
            const attr = decl.newAttr()
            const baseType = decl.declspec(attr)
            ast.node(n).*.init = decl.localDeclaration(baseType, attr)
        } else {
            ast.node(n).*.init = expressionStatement()
        }
        state.setLoopCleanups(state.cleanupCount())
        if !cursor.is(names.P_SEMI) { ast.node(n).*.cond = fullExpression(true) }
        cursor.expect(names.P_SEMI)
        if !cursor.is(names.P_RPAREN) { ast.node(n).*.inc = fullExpression(false) }
        cursor.expect(names.P_RPAREN)
        ast.node(n).*.then = statement()
        state.setBreakTarget(outerBreak)
        state.setContinueTarget(outerContinue)
        state.setLoopCleanups(outerCleanups)
        var result = n
        if standard.cpp {
            // The objects declared in the for's head are destroyed after
            // the loop.
            const ending = cpp.leaveScope(height, cursor.peek())
            if ending != 0 {
                result = ast.make(ast.BLOCK, token)
                ast.node(result).*.body = n
                ast.node(n).*.next = ending
            }
        }
        scope.leave()
        return result
    }
    if cursor.consume(names.K_WHILE) {
        const n = ast.make(ast.FOR, token)
        cursor.expect(names.P_LPAREN)
        ast.node(n).*.cond = fullExpression(true)
        cursor.expect(names.P_RPAREN)
        const outerBreak = state.breakTarget()
        const outerContinue = state.continueTarget()
        const outerCleanups = state.loopCleanups()
        ast.node(n).*.breakLabel = state.newLabel()
        ast.node(n).*.continueLabel = state.newLabel()
        state.setBreakTarget(ast.node(n).*.breakLabel)
        state.setContinueTarget(ast.node(n).*.continueLabel)
        state.setLoopCleanups(state.cleanupCount())
        ast.node(n).*.then = statement()
        state.setBreakTarget(outerBreak)
        state.setContinueTarget(outerContinue)
        state.setLoopCleanups(outerCleanups)
        return n
    }
    if cursor.consume(names.K_DO) {
        const n = ast.make(ast.DO, token)
        const outerBreak = state.breakTarget()
        const outerContinue = state.continueTarget()
        const outerCleanups = state.loopCleanups()
        ast.node(n).*.breakLabel = state.newLabel()
        ast.node(n).*.continueLabel = state.newLabel()
        state.setBreakTarget(ast.node(n).*.breakLabel)
        state.setContinueTarget(ast.node(n).*.continueLabel)
        state.setLoopCleanups(state.cleanupCount())
        ast.node(n).*.then = statement()
        state.setBreakTarget(outerBreak)
        state.setContinueTarget(outerContinue)
        state.setLoopCleanups(outerCleanups)
        cursor.expect(names.K_WHILE)
        cursor.expect(names.P_LPAREN)
        ast.node(n).*.cond = fullExpression(true)
        cursor.expect(names.P_RPAREN)
        cursor.expect(names.P_SEMI)
        return n
    }
    if cursor.is(names.K_ASM) || cursor.is(names.K_GNU2_ASM) {
        tokens.errorAt(token, "inline assembly is not supported")
    }
    if standard.cpp && (cursor.is(names.K_TRY) || cursor.is(names.K_THROW)) {
        tokens.errorAt(token, "exceptions are not supported")
    }
    if cursor.consume(names.K_GOTO) {
        if cursor.is(names.P_STAR) { tokens.errorAt(token, "computed goto is not supported") }
        const n = ast.make(ast.GOTO, token)
        ast.node(n).*.name = tokens.name(cursor.expectIdent())
        cursor.expect(names.P_SEMI)
        state.addGoto(n)
        return n
    }
    if cursor.consume(names.K_BREAK) {
        cursor.expect(names.P_SEMI)
        return jump(state.breakTarget(), token, "stray break")
    }
    if cursor.consume(names.K_CONTINUE) {
        cursor.expect(names.P_SEMI)
        return jump(state.continueTarget(), token, "stray continue")
    }
    if cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_COLON) {
        const n = ast.make(ast.LABEL, token)
        ast.node(n).*.name = tokens.name(token)
        ast.node(n).*.label = state.newLabel()
        cursor.advance()
        cursor.advance()
        decl.stdAttributes()
        const ignored = decl.attributes()
        ast.node(n).*.lhs = caseBody()
        state.addLabel(n)
        return n
    }
    if cursor.consume(names.P_LBRACE) { return compoundStatement() }
    return expressionStatement()
}

// The statement after a label (C23 allows a declaration or the end of a
// block there; an empty statement stands in).
fn caseBody() -> usize {
    if cursor.is(names.P_RBRACE) { return ast.make(ast.BLOCK, cursor.peek()) }
    if isDeclaration() {
        const item = declaration()
        if item == 0 { return ast.make(ast.BLOCK, cursor.peek()) }
        return item
    }
    return statement()
}

// Points every goto of the function at its label.
pub fn resolveGotos() -> void {
    var g = state.gotos()
    while g != 0 {
        const n = state.cellNode(g)
        var l = state.labels()
        var found: u32 = 0
        while l != 0 {
            if ast.node(state.cellNode(l)).*.name == ast.node(n).*.name {
                found = ast.node(state.cellNode(l)).*.label
                break
            }
            l = state.cellNext(l)
        }
        if found == 0 { ast.errorAt(n, "use of undeclared label") }
        ast.node(n).*.label = found
        g = state.cellNext(g)
    }
}
