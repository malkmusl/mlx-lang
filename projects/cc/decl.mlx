// Declarations (C11 6.7): the declaration specifiers (storage class,
// type specifiers and qualifiers, struct, union and enum specifiers,
// typedef names), declarators (pointers, arrays, functions, the
// parenthesized ones read inside out), type names, and the declarations
// of a translation unit and of a block: typedefs, functions with their
// definitions, global, static and local variables. GNU attributes are
// read for `packed` and `aligned` and otherwise passed over; C23's
// [[attributes]] are passed over wherever they may stand.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")
const stmt = @import("./stmt.mlx")
const eval = @import("./eval.mlx")
const initializer = @import("./initializer.mlx")
const standard = @import("./standard.mlx")
const mangle = @import("./mangle.mlx")
const cpp = @import("./cpp.mlx")
const template = @import("./template.mlx")

// What the declaration specifiers said besides the type.
pub const Attr = struct {
    isTypedef: bool
    isStatic: bool
    isExtern: bool
    isInline: bool
    isThreadLocal: bool
    // C23: `constexpr`, `auto` (the type inferred when none was given).
    isConstexpr: bool
    isAuto: bool
    hasType: bool
    alignment: i64
    // C++: `virtual` (a member function).
    isVirtual: bool
    isMutable: bool
    // `__attribute__((weak))`.
    isWeak: bool
}

// Type specifier counts (C11 6.7.2's multisets), one bit field each.
const S_VOID: u32 = 1
const S_BOOL: u32 = 4
const S_CHAR: u32 = 16
const S_SHORT: u32 = 64
const S_INT: u32 = 256
const S_LONG: u32 = 1024
const S_FLOAT: u32 = 4096
const S_DOUBLE: u32 = 16384
const S_OTHER: u32 = 65536
const S_SIGNED: u32 = 131072
const S_UNSIGNED: u32 = 262144
const S_BITINT: u32 = 1048576

// The width of the _BitInt being read.
var bitIntWidth: i64 = 0
// C++: how deep in `extern "C"` the declarations are (C linkage), and
// the namespace a qualified declarator named (`void N::f()`; 0: none).
var externC: u32 = 0
var declaratorPrefix: u32 = 0
// The token after the (qualified) type name qualifiedTypedef read last.
var typedefEnd: usize = 0

// The declaration state put aside while a template is instantiated
// (template.mlx), and brought back.
pub fn suspendDeclarations() -> usize {
    const saved = @intCast(usize, declaratorPrefix) | (@intCast(usize, externC) << 32)
    declaratorPrefix = 0
    externC = 0
    return saved
}

pub fn resumeDeclarations(saved: usize) -> void {
    declaratorPrefix = @intCast(u32, saved & 4294967295)
    externC = @intCast(u32, saved >> 32)
}

var packedName: u32 = 0
var packedName2: u32 = 0
var alignedName: u32 = 0
var alignedName2: u32 = 0
var weakName: u32 = 0
var weakName2: u32 = 0
// Whether the last attributes() read said `weak`.
var sawWeak = false
var funcName: u32 = 0
var functionName: u32 = 0
var prettyFunctionName: u32 = 0
var vaAreaName: u32 = 0
var vaListType: usize = 0

pub fn init() -> void {
    packedName = base.intern("packed")
    packedName2 = base.intern("__packed__")
    alignedName = base.intern("aligned")
    alignedName2 = base.intern("__aligned__")
    weakName = base.intern("weak")
    weakName2 = base.intern("__weak__")
    funcName = base.intern("__func__")
    functionName = base.intern("__FUNCTION__")
    prettyFunctionName = base.intern("__PRETTY_FUNCTION__")
    vaAreaName = base.intern("__va_area__")
    // __builtin_va_list: one element of { unsigned gp_offset, fp_offset;
    // void *overflow_arg_area, *reg_save_area; } (System V AMD64 ABI).
    const element = types.structType()
    types.at(element).*.size = 24
    types.at(element).*.alignment = 8
    types.at(element).*.incomplete = false
    vaListType = types.arrayOf(element, 1)
}

pub fn attrAt(attr: usize) -> *Attr {
    unsafe { return @ptrFromInt(*Attr, attr) }
}

pub fn newAttr() -> usize { return base.alloc(@sizeOf(Attr)) }

fn isStorageClass(id: u32) -> bool {
    return id == names.K_TYPEDEF || id == names.K_STATIC || id == names.K_EXTERN || id == names.K_INLINE || id == names.K_GNU_INLINE || id == names.K_GNU2_INLINE || id == names.K_THREAD_LOCAL || id == names.K_GNU_THREAD
}

fn isIgnoredQualifier(id: u32) -> bool {
    return id == names.K_CONST || id == names.K_GNU_CONST || id == names.K_VOLATILE || id == names.K_GNU2_VOLATILE || id == names.K_AUTO || id == names.K_REGISTER || id == names.K_RESTRICT || id == names.K_GNU_RESTRICT || id == names.K_GNU2_RESTRICT || id == names.K_NORETURN || id == names.K_GNU2_EXTENSION || id == names.K_CONSTEXPR
}

fn isTypeKeyword(id: u32) -> bool {
    if isStorageClass(id) || isIgnoredQualifier(id) { return true }
    if id == names.K_CLASS || id == names.K_WCHAR_T || id == names.K_CHAR16_T || id == names.K_CHAR32_T || id == names.K_DECLTYPE || id == names.K_UNDERLYING_TYPE || id == names.K_EXPLICIT || id == names.K_VIRTUAL || id == names.K_MUTABLE || id == names.K_FRIEND || id == names.K_TYPENAME { return true }
    return id == names.K_VOID || id == names.K_BOOL || id == names.K_CHAR || id == names.K_SHORT || id == names.K_INT || id == names.K_LONG || id == names.K_FLOAT || id == names.K_DOUBLE || id == names.K_SIGNED || id == names.K_GNU2_SIGNED || id == names.K_UNSIGNED || id == names.K_STRUCT || id == names.K_UNION || id == names.K_ENUM || id == names.K_ALIGNAS || id == names.K_ATOMIC || id == names.K_GNU2_ATTRIBUTE || id == names.K_TYPEOF || id == names.K_GNU2_TYPEOF || id == names.K_TYPEOF_UNQUAL || id == names.K_GNU_BUILTIN_VA_LIST || id == names.K_BITINT
}

// Whether `token` starts a type name (a declaration); in C++ a
// qualified one (`std::size_t`) too.
pub fn isTypename(token: usize) -> bool {
    const kind = tokens.kind(token)
    if kind == tokens.KEYWORD { return isTypeKeyword(tokens.name(token)) }
    if kind == tokens.IDENT {
        if standard.cpp { return qualifiedTypedef(token) != 0 }
        return scope.typedefOf(tokens.name(token)) != 0
    }
    if standard.cpp && tokens.is(token, names.P_SCOPE) { return qualifiedTypedef(token) != 0 }
    return false
}

// The template `name` names: in sight, or (C++) a member template of a
// base of a class around (`CodeRef<tag>`, JITCode's member alias
// template, in a class derived from it).
pub fn templateNamed(name: u32) -> usize {
    const found = scope.findKind(name, scope.TEMPLATE)
    if found != 0 || !standard.cpp { return found }
    const inherited = cpp.inheritedBinding(name)
    if inherited != 0 && scope.at(inherited).*.kind == scope.TEMPLATE { return inherited }
    return 0
}

// Whether the name at `token` (followed by `<`) is a class template's,
// so `X<A>(...)` there would be a type's construction, not a call.
pub fn isTypenameStart(token: usize) -> bool {
    const binding = templateNamed(tokens.name(token))
    return template.isClassTemplate(binding)
}

// SFINAE: while a function template instance's signature is read for
// a call (template.instantiateFunction), a qualified name that does not
// exist (`enable_if<false, int>::type`) does not end the compilation
// but marks the instance as not viable.
pub var sfinae = false
pub var sfinaeFailed = false

// The class template whose arguments a declaration deduces (the type
// read is cpp.deducedMarker()).
pub var deducedTemplate: usize = 0

// C++: the typedef the (qualified) name at `token` stands for, 0 for
// none: `T`, `N::T`, `::T`. The cursor is not moved.
// `T::A::B` in a pattern: each further `::name` after typedefEnd is a
// member of the dependent type so far.
fn dependentChain(first: usize) -> usize {
    var ty = first
    while tokens.is(typedefEnd, names.P_SCOPE) && tokens.kind(tokens.next(typedefEnd)) == tokens.IDENT && !tokens.is(tokens.next(tokens.next(typedefEnd)), names.P_LT) {
        ty = types.dependentMember(ty, tokens.name(tokens.next(typedefEnd)))
        typedefEnd = tokens.next(tokens.next(typedefEnd))
    }
    return ty
}

fn qualifiedTypedef(token: usize) -> usize {
    var at = token
    var prefix: u32 = 0
    var qualified = false
    if tokens.is(at, names.P_SCOPE) {
        qualified = true
        at = tokens.next(at)
    }
    while true {
        // `TT::template TableType<...>`: a member template named so.
        if qualified && tokens.isWord(at, names.K_TEMPLATE) && tokens.kind(tokens.next(at)) == tokens.IDENT { at = tokens.next(at) }
        if tokens.kind(at) != tokens.IDENT { return 0 }
        const name = tokens.name(at)
        typedefEnd = tokens.next(at)
        var binding = if qualified { scope.findQualified(prefix, name, false) } else { scope.find(name) }
        if !qualified && tokens.is(tokens.next(at), names.P_LT) { binding = templateNamed(name) }
        // (`V::ValueTraits::TraitType`, ValueTraits a base's member type.)
        if qualified && binding == 0 && tokens.is(tokens.next(at), names.P_SCOPE) { binding = cpp.findInherited(prefix, name, false) }
        // (`FT<F>::template ArgumentType<0>`, the alias template a base's.)
        if qualified && binding == 0 && tokens.is(tokens.next(at), names.P_LT) { binding = cpp.findInherited(prefix, name, false) }
        if tokens.is(tokens.next(at), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.PACK && cpp.isClassType(scope.packTypeOf(binding)) && tokens.kind(tokens.next(tokens.next(at))) == tokens.IDENT {
            // `typename Others::TraitType...`: the pack element's type.
            const element = scope.packTypeOf(binding)
            const completedElement = cpp.completeIfNeeded(element)
            prefix = types.at(types.unqualified(element)).*.name
            qualified = true
            at = tokens.next(tokens.next(at))
            continue
        }
        if tokens.is(tokens.next(at), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && cpp.isClassType(scope.at(binding).*.ty) && (tokens.kind(tokens.next(tokens.next(at))) == tokens.IDENT || tokens.isWord(tokens.next(tokens.next(at)), names.K_TEMPLATE)) {
            // `B::type`, B a typedef of a class.
            const completed = cpp.completeIfNeeded(scope.at(binding).*.ty)
            prefix = types.at(types.unqualified(scope.at(binding).*.ty)).*.name
            qualified = true
            at = tokens.next(tokens.next(at))
            continue
        }
        if sfinae && tokens.is(tokens.next(at), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && !cpp.isClassType(scope.at(binding).*.ty) && types.kind(scope.at(binding).*.ty) != types.TPARAM && tokens.kind(tokens.next(tokens.next(at))) == tokens.IDENT {
            // `typename U::rep` with U not a class: the candidate whose
            // signature this is is not viable.
            sfinaeFailed = true
            typedefEnd = tokens.next(tokens.next(tokens.next(at)))
            return types.intOf()
        }
        const parameterType = binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && types.kind(scope.at(binding).*.ty) == types.TPARAM
        if !qualified && tokens.is(tokens.next(at), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind != scope.NAMESPACE && !parameterType { binding = scope.findKind(name, scope.NAMESPACE) }
        if template.isClassTemplate(binding) && tokens.is(tokens.next(at), names.P_LT) {
            // `vector<int>`, `vector<int>::iterator`: the instance, read
            // here when the name is at the cursor (1 stands for a type
            // name elsewhere, where the arguments cannot be read).
            if token != cursor.peek() { return 1 }
            const saved = cursor.save()
            cursor.restore(at)
            const ty = template.classTypeHere(binding)
            const after = cursor.peek()
            cursor.restore(saved)
            if tokens.is(after, names.P_SCOPE) && types.kind(ty) != types.TPARAM {
                const completedHere = cpp.completeIfNeeded(ty)
                prefix = types.at(ty).*.name
                qualified = true
                at = tokens.next(after)
                continue
            }
            if tokens.is(after, names.P_SCOPE) && types.kind(ty) == types.TPARAM && tokens.kind(tokens.next(after)) == tokens.IDENT {
                // `remove_reference<T>::type` in a pattern: resolved in
                // the instance.
                typedefEnd = tokens.next(tokens.next(after))
                return dependentChain(types.dependentMember(ty, tokens.name(tokens.next(after))))
            }
            typedefEnd = after
            return ty
        }
        if tokens.is(tokens.next(at), names.P_SCOPE) && !qualified && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && types.kind(scope.at(binding).*.ty) == types.TPARAM && tokens.kind(tokens.next(tokens.next(at))) == tokens.IDENT {
            // `T::iterator` in a pattern: resolved in the instance.
            typedefEnd = tokens.next(tokens.next(tokens.next(at)))
            return dependentChain(types.dependentMember(scope.at(binding).*.ty, tokens.name(tokens.next(tokens.next(at)))))
        }
        if tokens.is(tokens.next(at), names.P_SCOPE) {
            if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE { return 0 }
            prefix = @intCast(u32, scope.at(binding).*.value)
            template.completeNestedScope(prefix)
            qualified = true
            at = tokens.next(tokens.next(at))
            continue
        }
        if qualified {
            if binding == 0 { binding = cpp.findInherited(prefix, name, false) }
            if binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF { return scope.at(binding).*.ty }
            // A class instance's pack, named in a member alias's
            // expansion (`::base<..>::Ts`).
            if binding != 0 && scope.packTypeOf(binding) != 0 { return scope.packTypeOf(binding) }
            // `std::span { first, last }`: deduced (see below).
            if !tokens.is(tokens.next(at), names.P_LT) && template.guidesOf(binding) != 0 {
                deducedTemplate = binding
                return cpp.deducedMarker()
            }
            // A struct, class or enum of the namespace is a type name too
            // (unless a function or variable hides it: `::stat(...)`).
            if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && !ast.obj(scope.at(binding).*.obj).*.isConstructor { return 0 }
            var tag = scope.findQualified(prefix, name, true)
            if tag == 0 { tag = cpp.findInherited(prefix, name, true) }
            if tag != 0 { return scope.at(tag).*.ty }
            if sfinae && binding == 0 {
                sfinaeFailed = true
                typedefEnd = tokens.next(at)
                return types.intOf()
            }
            return 0
        }
        // The class's own name inside it names the class.
        const injected = cpp.injectedClass(name)
        if injected != 0 { return injected }
        // C++17: a class template's name without arguments, deduction
        // guides declared for it (`Locker locker { lock };`): the
        // arguments come from the initializer (cpp.deducedClass).
        // (Not when a nearer name hides the template: `typedef
        // time_point<C> time_point;` in a class.)
        const plain = scope.find(name)
        if !tokens.is(tokens.next(at), names.P_LT) && (plain == 0 || scope.at(plain).*.kind == scope.TEMPLATE) {
            const named = scope.findKind(name, scope.TEMPLATE)
            // (No initializer to deduce from and every parameter
            // defaulted: the defaults' instance.)
            const after = tokens.next(at)
            if tokens.kind(after) == tokens.IDENT && (tokens.is(tokens.next(after), names.P_SEMI) || tokens.is(tokens.next(after), names.P_COMMA)) {
                const defaulted = template.defaultedInstance(named)
                if defaulted != 0 {
                    typedefEnd = after
                    return defaulted
                }
            }
            if template.guidesOf(named) != 0 {
                deducedTemplate = named
                return cpp.deducedMarker()
            }
        }
        const typedef_type = scope.typedefOf(name)
        if typedef_type != 0 { return typedef_type }
        // A base's member type, in its derived class.
        if binding == 0 && scope.findTag(name) == 0 {
            const inherited = cpp.inheritedType(name)
            if inherited != 0 { return inherited }
        }
        // In C++ a struct's, class's or enum's name is a type name by
        // itself, unless a variable or function hides it (a class's
        // constructor, named like the class, does not).
        if binding != 0 && scope.at(binding).*.kind != scope.NAMESPACE {
            const b = scope.at(binding)
            if !(b.*.kind == scope.VARIABLE && ast.obj(b.*.obj).*.isConstructor) { return 0 }
        }
        const tag = scope.findTag(name)
        if tag != 0 { return scope.at(tag).*.ty }
        return 0
    }
    return 0
}

// C++: whether a qualified name starts here: `::x`, `N::x`,
// `vector<int>::x`.
pub fn startsQualified() -> bool {
    if cursor.is(names.P_SCOPE) { return true }
    if decltypeQualifies() { return true }
    if !cursor.isIdent() { return false }
    if cursor.isToken(cursor.peekNext(), names.P_SCOPE) { return true }
    if cursor.isToken(cursor.peekNext(), names.P_LT) && template.isClassTemplate(templateNamed(tokens.name(cursor.peek()))) {
        const after = template.endOfArguments(cursor.peekNext())
        return after != 0 && tokens.is(after, names.P_SCOPE)
    }
    return false
}

// `decltype(e)::` here: a qualifier naming the class of e's type.
pub fn decltypeQualifies() -> bool {
    if !standard.cpp || !cursor.is(names.K_DECLTYPE) || !cursor.isToken(cursor.peekNext(), names.P_LPAREN) { return false }
    var t = tokens.next(cursor.peekNext())
    var level: i64 = 1
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_RPAREN) {
            level -= 1
            if level == 0 { return tokens.is(tokens.next(t), names.P_SCOPE) }
        }
        t = tokens.next(t)
    }
    return false
}

// C++: reads a qualifier `N::M::`, `vector<int>::` (or a leading `::`)
// here, if any: the prefix it names (0 for the global namespace), and
// whether one was read.
pub fn qualifier() -> (u32, bool) {
    var prefix: u32 = 0
    var qualified = false
    if cursor.is(names.P_SCOPE) {
        cursor.advance()
        qualified = true
    } else if decltypeQualifies() {
        // `decltype(fileTime)::clock::now()`: the class of the type.
        cursor.advance()
        const ty = types.unqualified(types.referenced(typeofSpecifier()))
        cursor.expect(names.P_SCOPE)
        if !cpp.isClassType(ty) {
            if sfinae {
                sfinaeFailed = true
                return -> (0, true)
            }
            cursor.fail("decltype names no class before '::'")
        }
        cpp.completeIfNeeded(ty)
        prefix = types.at(ty).*.name
        qualified = true
    }
    while cursor.isIdent() {
        const name = tokens.name(cursor.peek())
        var binding = if qualified { scope.findQualified(prefix, name, false) } else { scope.find(name) }
        if !qualified && cursor.isToken(cursor.peekNext(), names.P_LT) { binding = templateNamed(name) }
        // `endianness::NATIVE` of an unscoped enum: its enumerators are in
        // the scope around it (the enum's name passed over).
        // (Not past a typedef of a class: a member `using HashTableType =
        // HashTable;` hides an enum of the name around.)
        const typedefClass = binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && cpp.isClassType(scope.at(binding).*.ty)
        if standard.cpp && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && (binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE) && !typedefClass {
            const tag = if qualified { scope.findQualified(prefix, name, true) } else { scope.findTag(name) }
            if tag != 0 && types.kind(scope.at(tag).*.ty) == types.ENUM {
                // (`FieldID::InstPC` where a type InstPC is in sight too:
                // the enumerator, by the enum's own names.)
                const enumPrefix = types.at(scope.at(tag).*.ty).*.name
                const after = tokens.next(cursor.peekNext())
                if enumPrefix != 0 && tokens.kind(after) == tokens.IDENT && scope.findQualified(enumPrefix, tokens.name(after), false) != 0 {
                    prefix = enumPrefix
                    qualified = true
                }
                cursor.advance()
                cursor.advance()
                continue
            }
        }
        // (`ValueTraits::KeyTraits::f()`, KeyTraits a base's member type;
        // `Type::Serial`, Type a base's enum, in a member.)
        if qualified && binding == 0 && cursor.isToken(cursor.peekNext(), names.P_SCOPE) { binding = cpp.findInherited(prefix, name, false) }
        if standard.cpp && qualified && (binding == 0 || scope.at(binding).*.kind == scope.VARIABLE) && prefix != 0 && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && scope.qualify(scope.parentOf(prefix), name) == prefix {
            // `PropertySlot::PropertySlot::X`: the class's injected name
            // (not its constructor), the class itself.
            cursor.advance()
            cursor.advance()
            continue
        }
        if !qualified && binding == 0 && standard.cpp && cursor.isToken(cursor.peekNext(), names.P_SCOPE) { binding = cpp.inheritedBinding(name) }
        if cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && types.kind(scope.at(binding).*.ty) == types.ENUM && types.at(scope.at(binding).*.ty).*.name == 0 {
            // `C::k` of `typedef enum { k } C;`: the enumerators are the
            // scope's around it.
            cursor.advance()
            cursor.advance()
            continue
        }
        if cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && types.kind(scope.at(binding).*.ty) == types.ENUM && types.at(scope.at(binding).*.ty).*.name != 0 {
            // `SP::Realtime`, SP an alias of a scoped enum: its enumerators
            // (bound under the enum's name; an unnamed enum's, of
            // `typedef enum { k } C;`, are the scope's around it).
            const enumPrefix = types.at(scope.at(binding).*.ty).*.name
            const after = tokens.next(cursor.peekNext())
            if tokens.kind(after) != tokens.IDENT || scope.findQualified(enumPrefix, tokens.name(after), false) != 0 {
                prefix = enumPrefix
                qualified = true
            }
            cursor.advance()
            cursor.advance()
            continue
        }
        if cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.PACK && cpp.isClassType(scope.packTypeOf(binding)) {
            // `Traits::value` of a type pack (in its expansion: the
            // element's).
            const element = scope.packTypeOf(binding)
            cpp.completeIfNeeded(element)
            prefix = types.at(types.unqualified(element)).*.name
            qualified = true
            cursor.advance()
            cursor.advance()
            continue
        }
        if cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding != 0 && (scope.at(binding).*.kind == scope.TYPEDEF || scope.at(binding).*.kind == scope.TAG) && cpp.isClassType(scope.at(binding).*.ty) {
            // `B::value`, B a typedef of a class (a template parameter),
            // or a class's tag (`class MonotonicTime;` seen nearer).
            cpp.completeIfNeeded(scope.at(binding).*.ty)
            prefix = types.at(types.unqualified(scope.at(binding).*.ty)).*.name
            qualified = true
            cursor.advance()
            cursor.advance()
            continue
        }
        if standard.cpp && !qualified && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && (binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE) {
            // `CP::make(...)` in the class template CP's instance: the
            // injected class name, the instance.
            const injected = cpp.injectedClass(name)
            if injected != 0 && cpp.isClassType(injected) {
                cpp.completeIfNeeded(injected)
                prefix = types.at(types.unqualified(injected)).*.name
                qualified = true
                cursor.advance()
                cursor.advance()
                continue
            }
        }
        if !qualified && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding == 0 {
            // (A class known by its tag only: `MonotonicTime::now()`.)
            const tag = scope.findTag(name)
            if tag != 0 && cpp.isClassType(scope.at(tag).*.ty) {
                cpp.completeIfNeeded(scope.at(tag).*.ty)
                prefix = types.at(types.unqualified(scope.at(tag).*.ty)).*.name
                qualified = true
                cursor.advance()
                cursor.advance()
                continue
            }
        }
        if !qualified && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind != scope.NAMESPACE { binding = scope.findKind(name, scope.NAMESPACE) }
        if cursor.isToken(cursor.peekNext(), names.P_LT) && template.isClassTemplate(binding) {
            const after = template.endOfArguments(cursor.peekNext())
            if after == 0 || !tokens.is(after, names.P_SCOPE) { break }
            const ty = template.classTypeHere(binding)
            if types.kind(ty) == types.TPARAM && sfinae {
                // (A parameter not deduced: the candidate is not viable.)
                sfinaeFailed = true
                cursor.expect(names.P_SCOPE)
                qualified = true
                prefix = 0
                continue
            }
            if types.kind(ty) == types.TPARAM { cursor.fail("a dependent qualified name is not supported here") }
            const completed = cpp.completeIfNeeded(ty)
            cursor.expect(names.P_SCOPE)
            prefix = types.at(ty).*.name
            qualified = true
            continue
        }
        if !cursor.isToken(cursor.peekNext(), names.P_SCOPE) { break }
        if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE {
            if sfinae {
                sfinaeFailed = true
                qualified = true
                cursor.advance()
                cursor.advance()
                continue
            }
            cursor.fail("not a namespace")
        }
        prefix = @intCast(u32, scope.at(binding).*.value)
        if standard.cpp { template.completeNestedScope(prefix) }
        qualified = true
        cursor.advance()
        cursor.advance()
    }
    return -> (prefix, qualified)
}

// Passes balanced parentheses starting at the `(` here.
pub fn skipParentheses() -> void {
    cursor.expect(names.P_LPAREN)
    var level: u32 = 1
    while level > 0 {
        if cursor.isEof() { cursor.fail("unterminated parenthesis") }
        if cursor.is(names.P_LPAREN) { level += 1 }
        if cursor.is(names.P_RPAREN) { level -= 1 }
        cursor.advance()
    }
}

// GNU attributes here (any number of them): whether one said `packed`,
// and the alignment one asked for (0: none).
pub fn attributes() -> (bool, i64) {
    var isPacked = false
    var alignment: i64 = 0
    sawWeak = false
    while cursor.is(names.K_GNU2_ATTRIBUTE) {
        cursor.advance()
        cursor.expect(names.P_LPAREN)
        cursor.expect(names.P_LPAREN)
        while !cursor.consume(names.P_RPAREN) {
            if cursor.isEof() { cursor.fail("unterminated attribute") }
            if !cursor.consume(names.P_COMMA) {
                const name = tokens.name(cursor.peek())
                cursor.advance()
                if name == packedName || name == packedName2 {
                    isPacked = true
                } else if name == weakName || name == weakName2 {
                    sawWeak = true
                } else if base.same(base.nameOf(name), "vector_size") || base.same(base.nameOf(name), "__vector_size__") {
                    // GCC's vector types: ignoring the attribute would
                    // make a scalar of what is meant as a vector.
                    cursor.fail("GCC vector types (vector_size) are not supported")
                } else if name == alignedName || name == alignedName2 {
                    if cursor.consume(names.P_LPAREN) {
                        alignment = eval.constExpression()
                        cursor.expect(names.P_RPAREN)
                    } else {
                        alignment = 16
                    }
                } else if cursor.is(names.P_LPAREN) {
                    skipParentheses()
                }
            }
        }
        cursor.expect(names.P_RPAREN)
    }
    return -> (isPacked, alignment)
}

// Passes C23's [[attributes]] here (any number of them).
pub fn stdAttributes() -> void {
    while cursor.is(names.P_LBRACKET) && cursor.isToken(cursor.peekNext(), names.P_LBRACKET) {
        cursor.advance()
        cursor.advance()
        var level: u32 = 2
        while level > 0 {
            if cursor.isEof() { cursor.fail("unterminated attribute") }
            if cursor.is(names.P_LBRACKET) { level += 1 }
            if cursor.is(names.P_RBRACKET) { level -= 1 }
            cursor.advance()
        }
    }
}

// Passes attributes and an asm label (`__asm__("name")`) after a
// declarator.
fn afterDeclarator() -> void {
    const ignored = attributes()
    if cursor.is(names.K_ASM) || cursor.is(names.K_GNU2_ASM) {
        cursor.advance()
        skipParentheses()
    }
    const more = attributes()
    stdAttributes()
}

fn typeOfCounter(counter: u32) -> usize {
    if counter & S_BITINT != 0 {
        if counter & ~(S_BITINT | S_SIGNED | S_UNSIGNED) != 0 { return 0 }
        return types.bitIntOf(bitIntWidth, counter & S_UNSIGNED != 0)
    }
    if counter == S_VOID { return types.voidOf() }
    if counter == S_BOOL { return types.boolOf() }
    if counter == S_CHAR { return types.charOf() }
    if counter == S_SIGNED + S_CHAR { return types.scharOf() }
    if counter == S_UNSIGNED + S_CHAR { return types.ucharOf() }
    if counter == S_SHORT || counter == S_SHORT + S_INT || counter == S_SIGNED + S_SHORT || counter == S_SIGNED + S_SHORT + S_INT { return types.shortOf() }
    if counter == S_UNSIGNED + S_SHORT || counter == S_UNSIGNED + S_SHORT + S_INT { return types.ushortOf() }
    if counter == S_INT || counter == S_SIGNED || counter == S_SIGNED + S_INT { return types.intOf() }
    if counter == S_UNSIGNED || counter == S_UNSIGNED + S_INT { return types.uintOf() }
    if counter == S_LONG || counter == S_LONG + S_INT { return types.longOf() }
    if counter == S_LONG + S_LONG || counter == S_LONG + S_LONG + S_INT { return types.longLongOf() }
    if counter == S_SIGNED + S_LONG || counter == S_SIGNED + S_LONG + S_INT { return types.longOf() }
    if counter == S_SIGNED + S_LONG + S_LONG || counter == S_SIGNED + S_LONG + S_LONG + S_INT { return types.longLongOf() }
    if counter == S_UNSIGNED + S_LONG || counter == S_UNSIGNED + S_LONG + S_INT { return types.ulongOf() }
    if counter == S_UNSIGNED + S_LONG + S_LONG || counter == S_UNSIGNED + S_LONG + S_LONG + S_INT { return types.ulongLongOf() }
    if counter == S_FLOAT { return types.floatOf() }
    if counter == S_DOUBLE { return types.doubleOf() }
    if counter == S_LONG + S_DOUBLE { return types.ldoubleOf() }
    return 0
}

fn specifierBit(id: u32) -> u32 {
    if id == names.K_VOID { return S_VOID }
    if id == names.K_BOOL { return S_BOOL }
    if id == names.K_CHAR { return S_CHAR }
    if id == names.K_SHORT { return S_SHORT }
    if id == names.K_INT { return S_INT }
    if id == names.K_LONG { return S_LONG }
    if id == names.K_FLOAT { return S_FLOAT }
    if id == names.K_DOUBLE { return S_DOUBLE }
    if id == names.K_SIGNED || id == names.K_GNU2_SIGNED { return S_SIGNED }
    if id == names.K_UNSIGNED { return S_UNSIGNED }
    return 0
}

// declaration-specifiers: the type they make; the storage class and
// alignment go to `attr` (0 where none is allowed).
pub fn declspec(attr: usize) -> usize {
    typedefSpecifiers = false
    var sawAuto = false
    var sawDecltypeAuto = false
    var ty = types.intOf()
    var counter: u32 = 0
    var isConst = false
    while isTypename(cursor.peek()) {
        const token = cursor.peek()
        const id = tokens.name(token)
        const keyword = tokens.kind(token) == tokens.KEYWORD
        // (`auto iterator = ...` where `iterator` names a type: after
        // `auto` a name is the declarator's.)
        if standard.cpp && sawAuto && !keyword && tokens.kind(token) == tokens.IDENT { break }
        if keyword && (id == names.K_CONST || id == names.K_GNU_CONST) { isConst = true }
        if keyword && isStorageClass(id) {
            if attr == 0 { cursor.fail("storage class specifier is not allowed in this context") }
            const a = attrAt(attr)
            if id == names.K_TYPEDEF {
                a.*.isTypedef = true
                typedefSpecifiers = true
            }
            if id == names.K_STATIC { a.*.isStatic = true }
            if id == names.K_EXTERN { a.*.isExtern = true }
            if id == names.K_INLINE || id == names.K_GNU_INLINE || id == names.K_GNU2_INLINE { a.*.isInline = true }
            if id == names.K_THREAD_LOCAL || id == names.K_GNU_THREAD { a.*.isThreadLocal = true }
            if a.*.isTypedef && (a.*.isStatic || a.*.isExtern || a.*.isInline || a.*.isThreadLocal) {
                cursor.fail("typedef may not be used together with static, extern, inline, __thread or _Thread_local")
            }
            cursor.advance()
        } else if keyword && id == names.K_DECLTYPE && standard.cpp && tokens.is(cursor.peekNext(), names.P_LPAREN) && tokens.isWord(tokens.next(cursor.peekNext()), names.K_AUTO) && tokens.is(tokens.next(tokens.next(cursor.peekNext())), names.P_RPAREN) {
            // `decltype(auto)`: deduced as `auto` is.
            if attr != 0 { attrAt(attr).*.isAuto = true }
            sawAuto = true
            sawDecltypeAuto = true
            cursor.advance()
            cursor.advance()
            cursor.advance()
            cursor.advance()
        } else if keyword && (id == names.K_CONSTEXPR || id == names.K_AUTO) {
            if attr != 0 {
                if id == names.K_CONSTEXPR { attrAt(attr).*.isConstexpr = true } else { attrAt(attr).*.isAuto = true }
            }
            if id == names.K_AUTO { sawAuto = true }
            cursor.advance()
        } else if keyword && isIgnoredQualifier(id) {
            cursor.advance()
        } else if keyword && id == names.K_ATOMIC {
            cursor.advance()
            if cursor.consume(names.P_LPAREN) {
                ty = typeName()
                cursor.expect(names.P_RPAREN)
                counter += S_OTHER
            }
        } else if keyword && id == names.K_GNU2_ATTRIBUTE {
            const found = attributes()
            if attr != 0 && found.1 > 0 { attrAt(attr).*.alignment = found.1 }
            if attr != 0 && sawWeak { attrAt(attr).*.isWeak = true }
        } else if keyword && id == names.K_ALIGNAS {
            if attr == 0 { cursor.fail("_Alignas is not allowed in this context") }
            cursor.advance()
            cursor.expect(names.P_LPAREN)
            if isTypename(cursor.peek()) {
                attrAt(attr).*.alignment = types.alignOf(typeName())
            } else {
                attrAt(attr).*.alignment = eval.constExpression()
            }
            cursor.expect(names.P_RPAREN)
        } else if keyword && (id == names.K_EXPLICIT || id == names.K_VIRTUAL || id == names.K_MUTABLE || id == names.K_FRIEND || id == names.K_TYPENAME) {
            if id == names.K_VIRTUAL && attr != 0 { attrAt(attr).*.isVirtual = true }
            if id == names.K_MUTABLE && attr != 0 { attrAt(attr).*.isMutable = true }
            if id == names.K_EXPLICIT { cpp.pendingExplicit = true }
            cursor.advance()
        } else {
            var defined: usize = 0
            const qualified = standard.cpp && (tokens.is(token, names.P_SCOPE) || (!keyword && cursor.isToken(cursor.peekNext(), names.P_SCOPE)))
            if !keyword && !qualified { defined = if standard.cpp { qualifiedTypedef(token) } else { scope.typedefOf(id) } }
            if qualified { defined = qualifiedTypedef(token) }
            if defined == 1 { cursor.fail("internal error: a template type name away from the cursor") }
            const user = defined != 0 || id == names.K_STRUCT || id == names.K_CLASS || id == names.K_UNION || id == names.K_ENUM || id == names.K_TYPEOF || id == names.K_GNU2_TYPEOF || id == names.K_TYPEOF_UNQUAL || id == names.K_GNU_BUILTIN_VA_LIST || id == names.K_WCHAR_T || id == names.K_CHAR16_T || id == names.K_CHAR32_T || id == names.K_DECLTYPE || id == names.K_UNDERLYING_TYPE
            if user {
                // `int T` where T is a typedef name declares T.
                if counter != 0 { break }
                if standard.cpp && defined != 0 {
                    // The whole (qualified, template) name.
                    cursor.restore(typedefEnd)
                } else {
                    cursor.advance()
                }
                if id == names.K_STRUCT || id == names.K_CLASS {
                    ty = structUnionDeclaration(false)
                } else if id == names.K_UNION {
                    ty = structUnionDeclaration(true)
                } else if id == names.K_ENUM {
                    ty = enumSpecifier()
                } else if id == names.K_TYPEOF || id == names.K_GNU2_TYPEOF || id == names.K_TYPEOF_UNQUAL {
                    isOldTypeof = true
                    ty = typeofSpecifier()
                    isOldTypeof = false
                } else if id == names.K_GNU_BUILTIN_VA_LIST {
                    ty = vaListType
                } else if id == names.K_WCHAR_T || id == names.K_CHAR32_T {
                    ty = if id == names.K_WCHAR_T { types.wcharOf() } else { types.char32Of() }
                } else if id == names.K_CHAR16_T {
                    ty = types.char16Of()
                } else if id == names.K_DECLTYPE {
                    ty = typeofSpecifier()
                    ty = decltypeMembers(ty)
                } else if id == names.K_UNDERLYING_TYPE {
                    ty = underlyingTypeSpecifier()
                } else {
                    ty = defined
                }
                counter += S_OTHER
            } else {
                var bit = specifierBit(id)
                if id == names.K_BITINT {
                    // _BitInt(N), N a constant from 1 (unsigned) or 2 to
                    // BITINT_MAXWIDTH (above 64: limbs in memory).
                    cursor.advance()
                    cursor.expect(names.P_LPAREN)
                    bitIntWidth = eval.constExpression()
                    if bitIntWidth < 1 || bitIntWidth > types.MAX_BITINT { cursor.fail("_BitInt widths from 1 to 4096 are supported") }
                    bit = S_BITINT
                    counter += bit
                    ty = typeOfCounter(counter)
                    if ty == 0 { cursor.fail("invalid type") }
                    cursor.expect(names.P_RPAREN)
                    continue
                }
                if bit == 0 { break }
                counter += bit
                ty = typeOfCounter(counter)
                if ty == 0 { cursor.fail("invalid type") }
                cursor.advance()
            }
        }
    }
    if attr != 0 { attrAt(attr).*.hasType = counter != 0 }
    // C++'s `auto` without a type: a placeholder, taken from the
    // initializer (localDeclaration), the trailing return type
    // (`auto f() -> T`) or the first return (`auto f() { ... }`).
    if sawAuto && counter == 0 && standard.cpp { ty = if sawDecltypeAuto { types.decltypeAutoResult() } else { types.autoResult() } }
    if isConst && standard.cpp { ty = types.constOf(ty) }
    return ty
}

pub fn vaList() -> usize { return vaListType }

// C23's `auto x = value`: the type of the initializer after the `=`
// here (arrays and functions decayed); the cursor stays at the `=`.
fn inferredType() -> usize {
    if !cursor.is(names.P_ASSIGN) { cursor.fail("auto needs an initializer to take its type from") }
    const start = cursor.save()
    cursor.advance()
    const valueStart = cursor.save()
    const e = expr.assign()
    typing.addType(e)
    // Read once: the declaration's initializer is this expression (a
    // lambda in it is one closure).
    expr.keepParsed(valueStart, e, cursor.save())
    cursor.restore(start)
    var ty = ast.typeOf(e)
    if types.kind(ty) == types.ARRAY { ty = types.pointerTo(types.baseOf(ty)) }
    if types.kind(ty) == types.FUNC { ty = types.pointerTo(ty) }
    return ty
}

// C23's `constexpr int N = value`: an integer constant, bound like an
// enumerator with its declared type; whether this declaration was one.
pub fn constexprConstant(ty: usize, token: usize) -> bool {
    if !types.isInteger(ty) || types.isWide(ty) || !(cursor.is(names.P_ASSIGN) || cursor.is(names.P_LBRACE)) { return false }
    // (Declared `extern const size_t N;` before, in a header: a variable
    // other files read, defined here.)
    if standard.cpp && declaratorPrefix == 0 {
        const known = scope.findHere(tokens.name(token))
        if known != 0 && scope.at(known).*.kind == scope.VARIABLE && !ast.obj(scope.at(known).*.obj).*.isFunction && !ast.obj(scope.at(known).*.obj).*.isLocal { return false }
    }
    const start = cursor.save()
    if cursor.consume(names.P_LBRACE) {
        // `constexpr uint64_t K { 1ULL << 49 };` (`{}`: zero).
        var braced: i64 = 0
        if !cursor.is(names.P_RBRACE) {
            const outerSoft = eval.softFailures
            const outerFailed = eval.failed
            eval.softFailures = true
            eval.failed = false
            braced = eval.constExpression()
            const failedHere = eval.failed
            eval.softFailures = outerSoft
            eval.failed = outerFailed
            if failedHere || !cursor.is(names.P_RBRACE) {
                cursor.restore(start)
                return false
            }
        }
        cursor.expect(names.P_RBRACE)
        const boundBraced = scope.bindEnumConstant(tokens.name(token), types.constOf(ty), braced)
        return true
    }
    cursor.advance()
    // (What the evaluator cannot compute, `std::min` over references,
    // makes a const variable set when the program runs.)
    const outerSoft = eval.softFailures
    const outerFailed = eval.failed
    eval.softFailures = true
    eval.failed = false
    const value = eval.constExpression()
    const failed = eval.failed
    eval.softFailures = outerSoft
    eval.failed = outerFailed
    if failed {
        cursor.restore(start)
        return false
    }
    const bound = scope.bindEnumConstant(tokens.name(token), types.constOf(ty), value)
    return true
}

// C++'s `constexpr int N { value }` (a static member's too): as
// constexprConstant; whether this declaration was one.
pub fn constexprBracedConstant(ty: usize, token: usize) -> bool {
    if !types.isInteger(ty) || !cursor.is(names.P_LBRACE) { return false }
    cursor.advance()
    const value = eval.constExpression()
    cursor.expect(names.P_RBRACE)
    const bound = scope.bindEnumConstant(tokens.name(token), types.constOf(ty), value)
    return true
}

// `__underlying_type(E)`: the integer type the enum E is stored as.
fn underlyingTypeSpecifier() -> usize {
    cursor.expect(names.P_LPAREN)
    const ty = typeName()
    cursor.expect(names.P_RPAREN)
    return types.underlyingOf(ty)
}

// `decltype(e)::type::other`: the member types named after the
// decltype's type (dependent ones in a pattern).
fn decltypeMembers(first: usize) -> usize {
    var ty = first
    while standard.cpp && cursor.is(names.P_SCOPE) && tokens.kind(cursor.peekNext()) == tokens.IDENT {
        const name = tokens.name(cursor.peekNext())
        const owner = types.unqualified(types.referenced(ty))
        if types.kind(owner) == types.TPARAM {
            cursor.advance()
            cursor.advance()
            ty = types.dependentMember(owner, name)
            continue
        }
        if !cpp.isClassType(owner) { return ty }
        cpp.completeIfNeeded(owner)
        const prefix = types.at(owner).*.name
        var binding = scope.findQualified(prefix, name, false)
        if binding == 0 { binding = cpp.findInherited(prefix, name, false) }
        if binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF {
            ty = scope.at(binding).*.ty
        } else {
            var tag = scope.findQualified(prefix, name, true)
            if tag == 0 { tag = cpp.findInherited(prefix, name, true) }
            if tag == 0 { return ty }
            ty = scope.at(tag).*.ty
        }
        cursor.advance()
        cursor.advance()
    }
    return ty
}

// Passes a default argument: to the `,` or `)` after it (a template's
// arguments held whole: `= Vector<int, 2>()`).
fn skipDefaultArgument() -> void {
    var depth: i64 = 0
    var previous: usize = 0
    while !cursor.isEof() {
        if depth == 0 && (cursor.is(names.P_COMMA) || cursor.is(names.P_RPAREN)) { return }
        if cursor.is(names.P_LT) && previous != 0 && tokens.kind(previous) == tokens.IDENT && template.isClassTemplate(scope.findKind(tokens.name(previous), scope.TEMPLATE)) || (cursor.is(names.P_LT) && previous != 0 && tokens.kind(previous) == tokens.IDENT && template.isFunctionTemplate(scope.findKind(tokens.name(previous), scope.TEMPLATE))) {
            const after = template.endOfArguments(cursor.peek())
            if after != 0 {
                previous = cursor.peek()
                cursor.restore(after)
                continue
            }
        }
        if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) || cursor.is(names.P_LBRACE) { depth += 1 }
        if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) || cursor.is(names.P_RBRACE) { depth -= 1 }
        previous = cursor.peek()
        cursor.advance()
    }
}

// GNU typeof (an expression's type as C has it), not C++'s decltype.
var isOldTypeof = false

fn typeofSpecifier() -> usize {
    cursor.expect(names.P_LPAREN)
    var ty: usize = 0
    if standard.cpp && template.inPattern() && template.parenthesizedDependsOnParameter() {
        // `decltype(f(declval<T>()))` in a pattern: known per instance
        // only (and read then); nothing is instantiated for it now.
        var level: i64 = 0
        while !cursor.isEof() {
            if cursor.is(names.P_RPAREN) {
                if level == 0 { break }
                level -= 1
            }
            if cursor.is(names.P_LPAREN) { level += 1 }
            cursor.advance()
        }
        cursor.expect(names.P_RPAREN)
        return types.templateParameter(-3)
    }
    const start = cursor.save()
    var readAsType = false
    if isTypename(cursor.peek()) && !(standard.cpp && namesOnly(cursor.peek(), names.P_RPAREN)) {
        ty = typeName()
        // `decltype(T{})`, `decltype(T(args).f())`: an expression after all.
        readAsType = !standard.cpp || cursor.is(names.P_RPAREN)
        if !readAsType { cursor.restore(start) }
    }
    if !readAsType {
        // The expression is not evaluated: what it calls need not exist.
        const named = standard.cpp && namesOnly(cursor.peek(), names.P_RPAREN)
        expr.unevaluated += 1
        const n = expr.expression()
        typing.addType(n)
        expr.unevaluated -= 1
        ty = if standard.cpp && !isOldTypeof { typing.decltypeOf(n, named) } else { ast.typeOf(n) }
        if named && ast.kindOf(n) == ast.VAR && ast.obj(ast.node(n).*.variable).*.asPointer { ty = types.pointerTo(ty) }
    }
    cursor.expect(names.P_RPAREN)
    return ty
}

// Whether the tokens from `start` to the `end` punctuator are a name or
// a member access (`x`, `N::x`, `a.b`, `p->m`, `this->m`): decltype
// gives what was declared for it, not the expression's category.
pub fn namesOnly(start: usize, end: u32) -> bool {
    var t = start
    var count: u32 = 0
    while !tokens.isEof(t) && !tokens.is(t, end) {
        if !(tokens.kind(t) == tokens.IDENT || tokens.is(t, names.P_SCOPE) || tokens.is(t, names.P_DOT) || tokens.is(t, names.P_ARROW) || tokens.isWord(t, names.K_THIS)) { return false }
        count += 1
        t = tokens.next(t)
    }
    return count > 0 && tokens.is(t, end)
}

// Pointers with their qualifiers; in C++ a reference after them.
fn pointers(start: usize) -> usize {
    var ty = pointersOnly(start)
    if standard.cpp && cursor.consume(names.P_AMP) {
        ty = types.referenceTo(ty)
        while cursor.consume(names.K_CONST) || cursor.consume(names.K_VOLATILE) {}
    } else if standard.cpp && cursor.consume(names.P_ANDAND) {
        ty = types.rvalueReferenceTo(ty)
        while cursor.consume(names.K_CONST) || cursor.consume(names.K_VOLATILE) {}
    }
    return ty
}

// C++: whether the tokens from `token` are a member pointer's start
// (`C::*`, `ns::C<int>::*`, `T::*`).
fn memberPointerAt(token: usize) -> bool {
    var t = token
    if tokens.is(t, names.P_SCOPE) { t = tokens.next(t) }
    var count: usize = 0
    while tokens.kind(t) == tokens.IDENT && count < 16 {
        t = tokens.next(t)
        if tokens.is(t, names.P_LT) {
            t = template.endOfArguments(t)
            if t == 0 { return false }
        }
        if !tokens.is(t, names.P_SCOPE) { return false }
        t = tokens.next(t)
        if tokens.is(t, names.P_STAR) { return true }
        count += 1
    }
    return false
}

// `C::*` at the cursor: the class (the cursor after the `*`); its name
// may be qualified by namespaces, a template's instance or a template
// parameter.
fn memberPointerClass() -> usize {
    var prefix: u32 = 0
    var qualified = false
    if cursor.consume(names.P_SCOPE) { qualified = true }
    var ty: usize = 0
    while true {
        const nameToken = cursor.expectIdent()
        const name = tokens.name(nameToken)
        if cursor.is(names.P_SCOPE) && !cursor.isToken(cursor.peekNext(), names.P_STAR) {
            // A namespace on the way.
            const binding = if qualified { scope.findQualified(prefix, name, false) } else { scope.findKind(name, scope.NAMESPACE) }
            if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE { tokens.errorAt(nameToken, "not a namespace") }
            prefix = @intCast(u32, scope.at(binding).*.value)
            qualified = true
            cursor.advance()
            continue
        }
        if cursor.is(names.P_LT) {
            const binding = if qualified { scope.findQualified(prefix, name, false) } else { templateNamed(name) }
            if !template.isClassTemplate(binding) { tokens.errorAt(nameToken, "not a class template") }
            cursor.restore(nameToken)
            ty = template.classTypeHere(binding)
        } else {
            const binding = if qualified { scope.findQualified(prefix, name, false) } else { scope.find(name) }
            if binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF {
                ty = scope.at(binding).*.ty
            } else {
                const tag = if qualified { scope.findQualified(prefix, name, true) } else { scope.findTag(name) }
                if tag != 0 { ty = scope.at(tag).*.ty }
                if ty == 0 && !qualified { ty = cpp.injectedClass(name) }
            }
            if ty == 0 { tokens.errorAt(nameToken, "expected a class before ::*") }
        }
        break
    }
    cursor.expect(names.P_SCOPE)
    cursor.expect(names.P_STAR)
    return ty
}

pub fn pointersOnly(start: usize) -> usize {
    var ty = start
    while cursor.is(names.P_STAR) || (standard.cpp && memberPointerAt(cursor.peek())) {
        if cursor.consume(names.P_STAR) {
            ty = types.pointerTo(ty)
        } else {
            ty = types.memberPointerTo(memberPointerClass(), ty)
        }
        while true {
            const id = tokens.name(cursor.peek())
            if tokens.kind(cursor.peek()) != tokens.KEYWORD { break }
            if id == names.K_CONST || id == names.K_GNU_CONST || id == names.K_VOLATILE || id == names.K_GNU2_VOLATILE || id == names.K_RESTRICT || id == names.K_GNU_RESTRICT || id == names.K_GNU2_RESTRICT || id == names.K_ATOMIC {
                if standard.cpp && (id == names.K_CONST || id == names.K_GNU_CONST) { ty = types.constOf(ty) }
                cursor.advance()
            } else if id == names.K_GNU2_ATTRIBUTE {
                const ignored = attributes()
            } else {
                break
            }
        }
    }
    return ty
}

// Whether the `(` here opens a parameter list rather than a nested
// declarator (in an abstract declarator: `int (int)`, `int ()`).
fn opensParameters() -> bool {
    const next = cursor.peekNext()
    if standard.cpp && memberPointerAt(next) { return false }
    const seen = scope.packSeen
    const startsType = isTypename(next)
    scope.packSeen = seen
    if cursor.isToken(next, names.P_RPAREN) { return true }
    if !startsType { return false }
    // C++: each of the list's items must start a declaration too, else
    // it is an initializer's arguments (`SymbolTableEntry e(VarOffset(o),
    // static_cast<unsigned>(f))`).
    if standard.cpp { return itemsStartDeclarations(next) }
    return true
}

// Whether every item of the parenthesized list whose first item starts
// at `first` may start a parameter declaration.
fn itemsStartDeclarations(first: usize) -> bool {
    var t = first
    var level: i64 = 0
    var itemStart = true
    // (The token after an item's leading type name.)
    var itemTypeEnd: usize = 0
    while !tokens.isEof(t) {
        if itemStart {
            itemStart = false
            itemTypeEnd = 0
            if !tokens.is(t, names.P_ELLIPSIS) && !tokens.is(t, names.P_LBRACKET) {
                const seen = scope.packSeen
                const typed = isTypename(t)
                scope.packSeen = seen
                if !typed { return false }
                // `String s(std::span(p, n))`: a class template's name
                // without arguments, then `(`, makes an object (its
                // arguments deduced), no parameter.
                if standard.cpp && (tokens.kind(t) == tokens.IDENT || tokens.is(t, names.P_SCOPE)) {
                    const outerEnd = typedefEnd
                    const outerDeduced = deducedTemplate
                    const named = qualifiedTypedef(t)
                    const deducing = named == cpp.deducedMarker() && (tokens.is(typedefEnd, names.P_LPAREN) || tokens.is(typedefEnd, names.P_LBRACE))
                    if named > 1 { itemTypeEnd = typedefEnd }
                    typedefEnd = outerEnd
                    deducedTemplate = outerDeduced
                    if deducing { return false }
                }
            }
        }
        if level == 0 && tokens.is(t, names.P_LPAREN) && t == itemTypeEnd {
            // `URL(dir, "x"_s)`: a name no type followed by `,` or a
            // literal inside a type's parentheses is an argument (`T(a)`
            // names a parameter a, `T(int, char)` is a function type).
            const inner = tokens.next(t)
            const k = tokens.kind(inner)
            if k == tokens.NUMBER || k == tokens.STRING || k == tokens.CHAR { return false }
            // (`T(a->f())`, `T(a + 1)`: an expression; `T(a)`, `T(a[2])`,
            // `T(f(int))` stay declarators.)
            const follows = tokens.next(inner)
            if k == tokens.IDENT && !tokens.is(follows, names.P_RPAREN) && !tokens.is(follows, names.P_LBRACKET) && !tokens.is(follows, names.P_LPAREN) && !tokens.is(follows, names.P_SCOPE) && !tokens.is(follows, names.P_LT) && !isTypename(inner) { return false }
        }
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) || tokens.is(t, names.P_LT) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) || tokens.is(t, names.P_GT) {
            if level == 0 { return true }
            level -= 1
        }
        if tokens.is(t, names.P_SHR) { level -= 2 }
        if level == 0 && tokens.is(t, names.P_COMMA) { itemStart = true }
        t = tokens.next(t)
    }
    return true
}

// A declarator for a value of type `start`: its type and its name token
// (0 for an abstract one).
// Whether the specifiers being read are a typedef's (`typedef T<A>
// X;`): a class template named there is not instantiated
// (template.declaredInstance).
pub var typedefSpecifiers = false

pub fn declarator(start: usize) -> (usize, usize) {
    typedefSpecifiers = false
    var ty = pointers(start)
    if cursor.is(names.P_LPAREN) && !opensParameters() {
        // `T (D) suffix`: the suffix applies before D does.
        cursor.advance()
        const inner = cursor.save()
        const skipped = declarator(types.intOf())
        cursor.expect(names.P_RPAREN)
        ty = typeSuffix(ty)
        const after = cursor.save()
        cursor.restore(inner)
        const result = declarator(ty)
        cursor.restore(after)
        return -> (result.0, result.1)
    }
    var name: usize = 0
    var prefix: u32 = 0
    if standard.cpp && startsQualified() {
        // `N::f`, `vector<T>::f`: declared in that namespace (or class).
        const read = qualifier()
        prefix = read.0
    }
    if cursor.isIdent() {
        name = cursor.peek()
        cursor.advance()
    } else if standard.cpp && cursor.is(names.K_OPERATOR) {
        name = cpp.operatorNameToken()
        const conversion = cpp.takeConversionType()
        if conversion != 0 {
            // `operator T()`: a function returning T.
            ty = typeSuffix(ty)
            if types.kind(ty) != types.FUNC { tokens.errorAt(name, "a conversion operator takes a parameter list") }
            types.at(ty).*.base = conversion
            declaratorPrefix = prefix
            return -> (ty, name)
        }
    } else if standard.cpp && cursor.is(names.P_TILDE) && tokens.kind(cursor.peekNext()) == tokens.IDENT {
        // `S::~S`: the destructor's name.
        const tilde = cursor.peek()
        cursor.advance()
        name = tokens.copy(cursor.peek())
        tokens.at(name).*.name = base.intern(base.join("~", base.nameOf(tokens.name(cursor.peek()))))
        cursor.advance()
    }
    // `S::f(Mode m)`: the parameters see the class's names (unless
    // they do already: a member template instance's are bound below
    // the class).
    const entered = prefix != 0 && !scope.isWithin(prefix)
    if entered { scope.enterPrefix(prefix) }
    ty = typeSuffix(ty)
    if entered { scope.leaveNamespace() }
    // After the suffix: the parameters' declarators set it too.
    declaratorPrefix = prefix
    return -> (ty, name)
}

// C++: whether the `(` here opens a nested abstract declarator
// (`(*)(int)`, `(&)[3]`) rather than a functional cast's arguments
// (`void(0)`, `T(x)`), which end the type.
fn opensNestedDeclarator() -> bool {
    if !standard.cpp { return true }
    const next = cursor.peekNext()
    if memberPointerAt(next) { return true }
    return cursor.isToken(next, names.P_STAR) || cursor.isToken(next, names.P_AMP) || cursor.isToken(next, names.P_ANDAND) || cursor.isToken(next, names.P_LPAREN) || cursor.isToken(next, names.P_LBRACKET)
}

pub fn abstractDeclarator(start: usize) -> usize {
    typedefSpecifiers = false
    var ty = pointers(start)
    if cursor.is(names.P_LPAREN) && !opensParameters() && !opensNestedDeclarator() { return ty }
    if cursor.is(names.P_LPAREN) && !opensParameters() {
        cursor.advance()
        const inner = cursor.save()
        const skipped = abstractDeclarator(types.intOf())
        cursor.expect(names.P_RPAREN)
        ty = typeSuffix(ty)
        const after = cursor.save()
        cursor.restore(inner)
        const result = abstractDeclarator(ty)
        cursor.restore(after)
        return result
    }
    return typeSuffix(ty)
}

pub fn typeName() -> usize {
    return abstractDeclarator(declspec(0))
}

fn typeSuffix(ty: usize) -> usize {
    if standard.cpp && cursor.is(names.P_LPAREN) {
        // `T x(args)` is an initializer, not a function, when the
        // parenthesis holds an expression (a look ahead: a pack named
        // there is not an expansion's).
        const next = cursor.peekNext()
        const seen = scope.packSeen
        // (`[[maybe_unused]] int a`: a parameter's attributes.)
        const startsType = isTypename(next) || (tokens.is(next, names.P_LBRACKET) && tokens.is(tokens.next(next), names.P_LBRACKET))
        scope.packSeen = seen
        if !cursor.isToken(next, names.P_RPAREN) && !cursor.isToken(next, names.P_ELLIPSIS) && !startsType { return ty }
        if startsType && holdsExpression() { return ty }
        // (`E e(VarOffset(o), static_cast<unsigned>(f))`: an item that
        // starts no declaration makes them all arguments.)
        if startsType && !itemsStartDeclarations(next) { return ty }
    }
    if cursor.consume(names.P_LPAREN) { return functionParameters(ty) }
    if cursor.consume(names.P_LBRACKET) { return arrayDimensions(ty) }
    return ty
}

// Whether the parenthesis at the cursor holds an initializer rather
// than parameters: `(Tag(), 3)` has an item that starts with a
// literal, or with a name that is no type (`(Tag(), v)`).
fn holdsExpression() -> bool {
    var t = tokens.next(cursor.peek())
    var level: i64 = 0
    var itemStart = true
    while !tokens.isEof(t) {
        if level == 0 && tokens.is(t, names.P_RPAREN) { return false }
        if tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE) { return false }
        if itemStart {
            const kind = tokens.kind(t)
            if kind == tokens.NUMBER || kind == tokens.CHAR || kind == tokens.STRING || kind == tokens.INTEGER || kind == tokens.FLOATING { return true }
            if kind == tokens.IDENT && !tokens.is(tokens.next(t), names.P_SCOPE) {
                const seen = scope.packSeen
                const named = isTypename(t)
                scope.packSeen = seen
                if !named { return true }
            }
            // `T<args>("x")`, `T("x")`: a type followed by a parenthesized
            // literal is a functional cast, not a parameter.
            var after = t
            while tokens.is(after, names.P_SCOPE) || tokens.kind(after) == tokens.IDENT || tokens.kind(after) == tokens.KEYWORD {
                after = tokens.next(after)
                if tokens.is(after, names.P_LT) {
                    after = template.endOfArguments(after)
                    if after == 0 { return false }
                }
            }
            if tokens.is(after, names.P_LPAREN) {
                const inner = tokens.kind(tokens.next(after))
                if inner == tokens.NUMBER || inner == tokens.CHAR || inner == tokens.STRING || inner == tokens.INTEGER || inner == tokens.FLOATING { return true }
            }
            // `T{...}`: a temporary made by braces, not a parameter.
            if after != t && tokens.is(after, names.P_LBRACE) { return true }
        }
        itemStart = level == 0 && tokens.is(t, names.P_COMMA)
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LT) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_GT) { level -= 1 }
        t = tokens.next(t)
    }
    return false
}

pub fn functionParameters(result: usize) -> usize {
    const fnType = types.functionReturning(result)
    if cursor.is(names.K_VOID) && cursor.isToken(cursor.peekNext(), names.P_RPAREN) {
        cursor.advance()
        cursor.advance()
        if standard.cpp { finishParameters(fnType) }
        return fnType
    }
    if cursor.consume(names.P_RPAREN) {
        // C++'s `f()` takes nothing; C's is an old-style declaration.
        if !standard.cpp { types.at(fnType).*.oldStyle = true }
        if standard.cpp { finishParameters(fnType) }
        return fnType
    }
    var head: usize = 0
    var tail: usize = 0
    // A pack's name stands for the pack itself here (`Args &&... args`
    // expanded below), not an element.
    const outerPlaceholders = scope.packPlaceholders
    scope.packPlaceholders = standard.cpp
    while true {
        if cursor.consume(names.P_ELLIPSIS) {
            types.at(fnType).*.variadic = true
            cursor.expect(names.P_RPAREN)
            break
        }
        stdAttributes()
        const start = cursor.peek()
        const found = declarator(declspec(0))
        const ignored = attributes()
        var pty = found.0
        // Arrays and functions as parameters are pointers (C11 6.7.6.3).
        if types.kind(pty) == types.ARRAY { pty = types.pointerTo(types.baseOf(pty)) }
        if types.kind(pty) == types.FUNC { pty = types.pointerTo(pty) }
        const name: u32 = if found.1 != 0 { tokens.name(found.1) } else { 0 }
        const p = types.newParam(pty, name, if found.1 != 0 { found.1 } else { start })
        // C++: `Args &&... args`, a parameter pack (the `...` may also
        // come after the name).
        var packHolder: usize = 0
        if standard.cpp && cursor.consume(names.P_ELLIPSIS) {
            types.param(p).*.isPack = true
            if found.1 == 0 && cursor.isIdent() {
                types.param(p).*.name = tokens.name(cursor.peek())
                types.param(p).*.token = cursor.peek()
                cursor.advance()
            }
            packHolder = types.boundPackIn(pty)
        }
        if standard.cpp && cursor.consume(names.P_ASSIGN) {
            // A default argument (C++): read when a call needs it, in the
            // calling function (`unsigned start = MaxLength` in a class,
            // declared later; `ASCIILiteral comma = ", "_s`, whose
            // temporary is the caller's).
            if !cursor.is(names.P_LBRACE) {
                const n = ast.make(ast.DEFAULT_ARG, cursor.peek())
                ast.node(n).*.value = @intCast(i64, cursor.save())
                ast.node(n).*.high = @intCast(i64, scope.currentNamespace())
                skipDefaultArgument()
                types.param(p).*.defaultValue = n
            } else {
                types.param(p).*.defaultValue = cpp.bracedArgument(cursor.peek())
            }
        }
        if packHolder != 0 {
            // `Args &&... args` in an instance: a parameter per element
            // of the pack, named `args#0`, `args#1`, ... and known
            // together as `args` (functionDefinition).
            if types.packCount(packHolder) == 0 && types.param(p).*.name != 0 {
                const e = base.alloc(16)
                base.putWord(e, @intCast(usize, types.param(p).*.name))
                base.putWord(e + 8, types.at(fnType).*.emptyPacks)
                types.at(fnType).*.emptyPacks = e
            }
            var index: i64 = 0
            while index < types.packCount(packHolder) {
                const element = types.packTypeAt(packHolder, index)
                const name = base.intern(base.join(base.join(base.nameOf(types.param(p).*.name), "#"), base.decimal(@intCast(u64, index))))
                const q = types.newParam(types.substitutePack(pty, element), name, types.param(p).*.token)
                types.param(q).*.packName = types.param(p).*.name
                if head == 0 { head = q } else { types.param(tail).*.next = q }
                tail = q
                index += 1
            }
        } else {
            if head == 0 { head = p } else { types.param(tail).*.next = p }
            tail = p
        }
        if cursor.consume(names.P_RPAREN) { break }
        cursor.expect(names.P_COMMA)
    }
    scope.packPlaceholders = outerPlaceholders
    types.at(fnType).*.params = head
    if standard.cpp { finishParameters(fnType) }
    return fnType
}

// C++: what follows a parameter list: the qualifiers (`const`,
// `noexcept`, `override`), a trailing return type (`auto f() -> T`),
// a requires clause (kept for the template, template.mlx).
fn finishParameters(fnType: usize) -> void {
    if cpp.trailingQualifiers() { types.at(fnType).*.constMethod = true }
    if cursor.is(names.P_ARROW) && template.inPattern() {
        cursor.advance()
        // In a template's pattern the trailing return type is read
        // again per instance: passed over here (to the body, the `;`,
        // `= default`, a requires clause or the end of a parameter).
        var depth: i64 = 0
        // Template arguments' angle brackets, outside parentheses.
        var angles: i64 = 0
        while !cursor.isEof() {
            if depth == 0 && angles <= 0 && (cursor.is(names.P_LBRACE) || cursor.is(names.P_SEMI) || cursor.is(names.P_ASSIGN) || cursor.is(names.K_REQUIRES) || cursor.is(names.P_COMMA) || cursor.is(names.P_RPAREN) || cursor.is(names.P_COLON)) { break }
            if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) || cursor.is(names.P_LBRACE) { depth += 1 }
            if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) || cursor.is(names.P_RBRACE) { depth -= 1 }
            if depth == 0 && cursor.is(names.P_LT) { angles += 1 }
            if depth == 0 && cursor.is(names.P_GT) { angles -= 1 }
            if depth == 0 && cursor.is(names.P_SHR) { angles -= 2 }
            cursor.advance()
        }
        types.at(fnType).*.base = types.templateParameter(-3)
    } else if cursor.is(names.P_ARROW) {
        cursor.advance()
        // The trailing return type may name the parameters
        // (`-> decltype(x / 2)`): bound meanwhile.
        scope.enter()
        var p = types.at(fnType).*.params
        while p != 0 {
            if types.param(p).*.name != 0 {
                const o = ast.newObj(types.param(p).*.name, types.param(p).*.ty, types.param(p).*.token)
                ast.obj(o).*.isLocal = true
                const bound = scope.bindVariable(types.param(p).*.name, o)
                if types.param(p).*.packName != 0 {
                    // One of an expanded pack's (`as...` in the type).
                    const packBinding = scope.findHere(types.param(p).*.packName)
                    var holder: usize = 0
                    if packBinding != 0 && scope.at(packBinding).*.kind == scope.PACK {
                        holder = scope.at(packBinding).*.obj
                    } else {
                        holder = types.newPackHolder()
                        const packBound = scope.bindPack(types.param(p).*.packName, 0, holder)
                    }
                    types.addPackVariable(holder, o)
                    types.addPackType(holder, types.param(p).*.ty)
                }
            }
            p = types.param(p).*.next
        }
        var emptyPack = types.at(fnType).*.emptyPacks
        while emptyPack != 0 {
            const emptyBound = scope.bindPack(@intCast(u32, base.getWord(emptyPack)), 0, types.newPackHolder())
            emptyPack = base.getWord(emptyPack + 8)
        }
        // In a template's pattern a dependent expression (`c.begin()`
        // on a placeholder) is no error: the type is read again on
        // instantiation.
        const outerSfinae = sfinae
        const outerFailed = sfinaeFailed
        if template.inPattern() { sfinae = true }
        types.at(fnType).*.base = typeName()
        if template.inPattern() {
            sfinae = outerSfinae
            sfinaeFailed = outerFailed
        }
        scope.leave()
        if cpp.trailingQualifiers() { types.at(fnType).*.constMethod = true }
    }
    if cursor.is(names.K_REQUIRES) { template.trailingRequires() }
}

// Whether two function types declare the same function (the same
// parameters: a C++ overload differs in them).
pub fn sameSignature(first: usize, second: usize) -> bool {
    if types.at(first).*.variadic != types.at(second).*.variadic { return false }
    if types.at(first).*.constMethod != types.at(second).*.constMethod { return false }
    var p = types.at(first).*.params
    var q = types.at(second).*.params
    while p != 0 && q != 0 {
        if !types.compatible(types.param(p).*.ty, types.param(q).*.ty) { return false }
        if standard.cpp && !types.sameType(types.unqualified(types.param(p).*.ty), types.unqualified(types.param(q).*.ty)) { return false }
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
    return p == 0 && q == 0
}

fn arrayDimensions(element: usize) -> usize {
    // An array's size is its element's: a class template's instance
    // named without being instantiated is completed first.
    if standard.cpp { const ignored = cpp.completeIfNeeded(element) }
    while cursor.consume(names.K_STATIC) || cursor.consume(names.K_RESTRICT) || cursor.consume(names.K_GNU_RESTRICT) || cursor.consume(names.K_CONST) || cursor.consume(names.K_VOLATILE) {}
    if cursor.consume(names.P_RBRACKET) {
        return types.arrayOf(typeSuffix(element), -1)
    }
    // C++: `T[N]` in a template's pattern, N one of its parameters.
    const bound = if standard.cpp { template.patternArrayBound() } else { 0 }
    if bound != 0 {
        cursor.advance()
        cursor.expect(names.P_RBRACKET)
        return types.arrayOf(typeSuffix(element), bound)
    }
    const length = eval.constExpression()
    if length < 0 { cursor.fail("size of array is negative") }
    cursor.expect(names.P_RBRACKET)
    return types.arrayOf(typeSuffix(element), length)
}

// Whether the last struct, union or class specifier read had a tag: a
// member declaration of one without a declarator is then a nested
// class (C++) rather than an anonymous struct or union.
var lastSpecifierTagged = false

// struct-or-union-specifier, after the keyword.
fn structUnionDeclaration(isUnion: bool) -> usize {
    const ty = structUnionSpecifier(isUnion)
    lastSpecifierTagged = types.at(ty).*.name != 0 && !cpp.isAnonymousClass(ty)
    return ty
}

fn structUnionSpecifier(isUnion: bool) -> usize {
    const leading = attributes()
    stdAttributes()
    var isPacked = leading.0
    var alignment = leading.1
    // C++'s `struct alignas(N) Storage { ... }`: the class's alignment.
    while standard.cpp && cursor.is(names.K_ALIGNAS) {
        cursor.advance()
        cursor.expect(names.P_LPAREN)
        var asked: i64 = 0
        if isTypename(cursor.peek()) { asked = types.alignOf(typeName()) } else { asked = eval.constExpression() }
        cursor.expect(names.P_RPAREN)
        if asked > alignment { alignment = asked }
        stdAttributes()
    }
    // C++'s `struct Outer::Inner { ... }`: the class declared in Outer,
    // defined here as if in Outer's scope.
    if standard.cpp && cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && !template.hasTagOverride() {
        var prefix: u32 = 0
        var qualified = false
        while cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_SCOPE) {
            const outer = if qualified { scope.findQualified(prefix, tokens.name(cursor.peek()), false) } else { scope.findKind(tokens.name(cursor.peek()), scope.NAMESPACE) }
            if outer == 0 || scope.at(outer).*.kind != scope.NAMESPACE { cursor.fail("not a namespace or class") }
            prefix = @intCast(u32, scope.at(outer).*.value)
            qualified = true
            cursor.advance()
            cursor.advance()
        }
        scope.enterPrefix(prefix)
        const made = structUnionRest(isUnion, isPacked, alignment)
        scope.leaveNamespace()
        return made
    }
    return structUnionRest(isUnion, isPacked, alignment)
}

fn structUnionRest(isUnion: bool, packedIn: bool, alignedIn: i64) -> usize {
    var isPacked = packedIn
    var alignment = alignedIn
    var tag: usize = 0
    var tagName: u32 = 0
    if cursor.isIdent() {
        tag = cursor.peek()
        tagName = tokens.name(tag)
        cursor.advance()
    }
    // A class template's instance is named by its arguments (template.mlx).
    var target: usize = 0
    var instanceClass = false
    if standard.cpp && tag != 0 {
        const override = template.takeTagOverride()
        if override != 0 {
            tagName = override
            target = template.takeCompletionTarget()
            instanceClass = true
        }
    }
    // C++'s `class X final { ... }`, `class X final : Base`.
    var isFinal = false
    if standard.cpp && tag != 0 && cursor.isIdent() && base.same(tokens.text(cursor.peek()), "final") && (cursor.isToken(cursor.peekNext(), names.P_LBRACE) || cursor.isToken(cursor.peekNext(), names.P_COLON)) {
        cursor.advance()
        isFinal = true
    }
    const kind = if isUnion { types.UNION } else { types.STRUCT }
    if tag != 0 && !cursor.is(names.P_LBRACE) && !(standard.cpp && cursor.is(names.P_COLON)) {
        // (C++: `class X;` alone declares X here, even with another X
        // in sight: `namespace DOMJIT { class GetterSetter; }` in JSC.)
        const found = if standard.cpp && cursor.is(names.P_SEMI) { scope.findTagHere(tagName) } else { scope.findTag(tagName) }
        if found != 0 {
            const known = scope.at(found).*.ty
            if types.kind(known) != kind { tokens.errorAt(tag, "tag used with the wrong kind of type") }
            return known
        }
        const declared = types.structType()
        types.at(declared).*.kind = kind
        types.at(declared).*.name = scope.qualify(scope.currentNamespace(), tagName)
        const bound = scope.bindTag(tagName, declared)
        return declared
    }
    var ty: usize = 0
    if standard.cpp && tag != 0 {
        // A C++ class: the one declared before (`class S;`) is completed
        // in place; a new one is bound before its members, which may
        // name it.
        const here = if target != 0 { 0 } else { scope.findTagHere(tagName) }
        if target != 0 {
            ty = target
        } else if here != 0 {
            ty = scope.at(here).*.ty
            if types.kind(ty) != kind { tokens.errorAt(tag, "tag used with the wrong kind of type") }
            if !types.at(ty).*.incomplete { tokens.errorAt(tag, "redefinition of a class") }
        } else {
            ty = types.structType()
            types.at(ty).*.kind = kind
            types.at(ty).*.name = scope.qualify(scope.currentNamespace(), tagName)
            const bound = scope.bindTag(tagName, ty)
        }
    } else {
        ty = types.structType()
        types.at(ty).*.kind = kind
        if tag != 0 { types.at(ty).*.name = scope.qualify(scope.currentNamespace(), tagName) }
    }
    // C++: a class defined in a class template's instance is made when
    // something needs it whole, as C++ instantiates member classes
    // (NativePromise's AllPromiseProducer names the next level's
    // promise: made eagerly, the levels never end).
    if standard.cpp && tag != 0 && !instanceClass && template.defersNestedClasses() {
        template.deferNestedClass(ty, cursor.save(), tagName, tokens.name(tag), isUnion, isPacked, alignment, isFinal)
        const known = scope.findHere(tagName)
        if known == 0 || scope.at(known).*.kind != scope.NAMESPACE { const boundScope = scope.bindNamespace(tagName, types.at(ty).*.name) }
        skipClassBody()
        return ty
    }
    return classBody(ty, tag != 0, tagName, if tag != 0 { tokens.name(tag) } else { 0 }, isUnion, isPacked, alignment, isFinal)
}

// Passes over a class's base clause and body (from the `:` or `{`).
fn skipClassBody() -> void {
    while !cursor.is(names.P_LBRACE) {
        if cursor.isEof() { cursor.fail("unterminated class") }
        if cursor.is(names.P_LPAREN) {
            skipParentheses()
            continue
        }
        cursor.advance()
    }
    var level: u32 = 0
    while true {
        if cursor.isEof() { cursor.fail("unterminated class") }
        if cursor.is(names.P_LBRACE) { level += 1 }
        if cursor.is(names.P_RBRACE) {
            level -= 1
            if level == 0 {
                cursor.advance()
                return
            }
        }
        cursor.advance()
    }
}

// The rest of a class's definition, from its base clause or `{`: its
// members read, the type made whole.
pub fn classBody(ty: usize, hasTag: bool, tagName: u32, written: u32, isUnion: bool, packedIn: bool, alignedIn: i64, isFinal: bool) -> usize {
    var isPacked = packedIn
    var alignment = alignedIn
    const kind = if isUnion { types.UNION } else { types.STRUCT }
    if standard.cpp { cpp.beginClass(ty, if hasTag { tagName } else { 0 }, if hasTag { written } else { 0 }, cursor.peek()) }
    cursor.expect(names.P_LBRACE)
    structMembers(ty)
    if standard.cpp { cpp.finishMembers(ty) }
    if isFinal { cpp.markFinal(ty) }
    const trailing = attributes()
    isPacked = isPacked || trailing.0
    if trailing.1 > alignment { alignment = trailing.1 }
    if isUnion { types.layoutUnion(ty) } else { types.layoutStruct(ty, isPacked) }
    if alignment > types.alignOf(ty) {
        types.at(ty).*.alignment = alignment
        types.at(ty).*.size = types.alignTo(types.size(ty), alignment)
    }
    types.at(ty).*.incomplete = false
    if standard.cpp {
        // An empty class has a size (1), as C++ says.
        if types.size(ty) == 0 { types.at(ty).*.size = 1 }
        types.syncConst(ty)
        cpp.completeClass(ty)
        return ty
    }
    if hasTag {
        const here = scope.findTagHere(tagName)
        if here != 0 {
            // The struct declared before (`struct S;`, or `struct S *` in
            // its own members) becomes this one, so every type naming it
            // sees it complete.
            const earlier = scope.at(here).*.ty
            if types.kind(earlier) != kind { tokens.errorAt(cursor.peek(), "tag used with the wrong kind of type") }
            if !types.at(earlier).*.incomplete { tokens.errorAt(cursor.peek(), "redefinition of a struct or union") }
            const twin = types.at(earlier).*.constVersion
            base.copy(earlier, ty, @sizeOf(types.Type))
            types.at(earlier).*.constVersion = twin
            types.syncConst(earlier)
            return earlier
        }
        const bound = scope.bindTag(tagName, ty)
    }
    return ty
}

// C++: the members of the class being read, so far (a static member's
// initializer may name one in `sizeof`): expr.mlx looks there.
pub var partialMembers: usize = 0

fn structMembers(ty: usize) -> void {
    var head: usize = 0
    var tail: usize = 0
    var index: i64 = 0
    const outerPartial = partialMembers
    if standard.cpp {
        // The base class is the first member.
        head = cpp.baseMember(ty, cursor.peek())
        if head != 0 {
            tail = head
            index = 1
            while types.member(tail).*.next != 0 {
                tail = types.member(tail).*.next
                index += 1
            }
        }
    }
    while !cursor.consume(names.P_RBRACE) {
        if cursor.isEof() { cursor.fail("unterminated struct or union") }
        partialMembers = head
        stdAttributes()
        if standard.cpp { cpp.pendingExplicit = false }
        if standard.cpp && cpp.specialMember(ty) {
            // An access specifier, a constructor, a destructor, a friend.
        } else if cursor.is(names.K_STATIC_ASSERT) {
            staticAssert()
        } else if !cursor.consume(names.P_SEMI) {
            const attr = newAttr()
            const memberBase = declspec(attr)
            const bk = types.kind(memberBase)
            if standard.cpp && attrAt(attr).*.isTypedef {
                // A typedef of the class's scope.
                parseTypedef(memberBase)
            } else if (bk == types.STRUCT || bk == types.UNION) && lastSpecifierTagged && cursor.consume(names.P_SEMI) {
                // A nested class, or a struct declared in the class: a
                // type of its scope, not a member.
            } else if (bk == types.STRUCT || bk == types.UNION) && cursor.consume(names.P_SEMI) {
                // An anonymous struct or union: its members are this
                // one's (C11 6.7.2.1).
                const m = types.newMember(memberBase, 0, cursor.peek())
                types.member(m).*.index = index
                types.member(m).*.alignment = attrAt(attr).*.alignment
                index += 1
                if head == 0 { head = m } else { types.member(tail).*.next = m }
                tail = m
            } else {
                var first = true
                while !cursor.consume(names.P_SEMI) {
                    if !first { cursor.expect(names.P_COMMA) }
                    first = false
                    const start = cursor.peek()
                    const isVirtual = attrAt(attr).*.isVirtual
                    const found = declarator(memberBase)
                    if standard.cpp && types.kind(found.0) == types.FUNC {
                        // A member function; its body, if any, ends the
                        // declaration.
                        if found.1 == 0 { tokens.errorAt(start, "member function name omitted") }
                        cpp.declaringConstexpr = attrAt(attr).*.isConstexpr
                        cpp.pendingInline = attrAt(attr).*.isInline || attrAt(attr).*.isConstexpr
                        const hadBody = cpp.memberFunction(ty, found.0, found.1, tokens.name(found.1), attrAt(attr).*.isStatic, isVirtual, false, false)
                        cpp.declaringConstexpr = false
                        if hadBody { break }
                        continue
                    }
                    if standard.cpp && attrAt(attr).*.isStatic {
                        // A static data member: a global.
                        if found.1 == 0 { tokens.errorAt(start, "static member name omitted") }
                        cpp.staticMember(ty, found.0, found.1, attr)
                        continue
                    }
                    const name: u32 = if found.1 != 0 { tokens.name(found.1) } else { 0 }
                    if standard.cpp { cpp.completeIfNeeded(found.0) }
                    const m = types.newMember(found.0, name, if found.1 != 0 { found.1 } else { start })
                    types.member(m).*.index = index
                    types.member(m).*.alignment = attrAt(attr).*.alignment
                    types.member(m).*.isMutable = attrAt(attr).*.isMutable
                    index += 1
                    if cursor.consume(names.P_COLON) {
                        const width = eval.constExpression()
                        if width < 0 || width > types.size(found.0) * 8 { tokens.errorAt(start, "invalid bit-field width") }
                        if width == 0 && name != 0 { tokens.errorAt(start, "named bit-field with zero width") }
                        types.member(m).*.bitWidth = if width == 0 { -1 } else { width }
                    }
                    const after = attributes()
                    if after.1 > types.member(m).*.alignment { types.member(m).*.alignment = after.1 }
                    if standard.cpp { cpp.memberInitializerTokens(m) }
                    if head == 0 { head = m } else { types.member(tail).*.next = m }
                    tail = m
                }
            }
        }
    }
    // A last member of array type without a size is a flexible array
    // member (C11 6.7.2.1).
    if tail != 0 {
        const last = types.member(tail).*.ty
        if types.kind(last) == types.ARRAY && types.at(last).*.arrayLength < 0 {
            types.member(tail).*.ty = types.arrayOf(types.baseOf(last), 0)
            types.at(ty).*.flexible = true
        }
    }
    partialMembers = outerPartial
    types.at(ty).*.members = head
}

// enum-specifier, after the keyword.
fn enumSpecifier() -> usize {
    const ty = types.enumType()
    const leading = attributes()
    stdAttributes()
    // `enum class E` (C++): the enumerators are E::A, E::B.
    const scoped = standard.cpp && (cursor.consume(names.K_CLASS) || cursor.consume(names.K_STRUCT))
    // `enum class Outer::Inner { ... }`: the enum declared in Outer,
    // defined here as if in Outer's scope.
    if standard.cpp && cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_SCOPE) {
        var prefix: u32 = 0
        var qualified = false
        while cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_SCOPE) {
            const outer = if qualified { scope.findQualified(prefix, tokens.name(cursor.peek()), false) } else { scope.findKind(tokens.name(cursor.peek()), scope.NAMESPACE) }
            if outer == 0 || scope.at(outer).*.kind != scope.NAMESPACE { cursor.fail("not a namespace or class") }
            prefix = @intCast(u32, scope.at(outer).*.value)
            qualified = true
            cursor.advance()
            cursor.advance()
        }
        scope.enterPrefix(prefix)
        const made = enumRest(ty, scoped)
        scope.leaveNamespace()
        return made
    }
    return enumRest(ty, scoped)
}

fn enumRest(enumTy: usize, scoped: bool) -> usize {
    var ty = enumTy
    var tag: usize = 0
    if cursor.isIdent() {
        tag = cursor.peek()
        cursor.advance()
    }
    if tag != 0 { types.at(ty).*.name = scope.qualify(scope.currentNamespace(), tokens.name(tag)) }
    if cursor.consume(names.P_COLON) {
        // A fixed underlying type (C23): `enum E : unsigned char`.
        const underlying = typeName()
        if !types.isInteger(underlying) || types.kind(underlying) == types.ENUM { cursor.fail("the underlying type of an enum must be an integer type") }
        types.at(ty).*.size = types.size(underlying)
        types.at(ty).*.alignment = types.alignOf(underlying)
        types.at(ty).*.unsigned = types.isUnsigned(underlying)
    }
    if tag != 0 && !cursor.is(names.P_LBRACE) {
        const found = scope.findTag(tokens.name(tag))
        if found == 0 {
            // A forward declaration (GNU): an enum to be completed.
            const bound = scope.bindTag(tokens.name(tag), ty)
            return ty
        }
        const known = scope.at(found).*.ty
        if types.kind(known) != types.ENUM { tokens.errorAt(tag, "not an enum tag") }
        return known
    }
    cursor.expect(names.P_LBRACE)
    if tag != 0 {
        // `enum class E : T;` then `enum class E : T { ... }`: the
        // declared type completed, its enumerators of that type.
        const here = scope.findTagHere(tokens.name(tag))
        if here != 0 && types.kind(scope.at(here).*.ty) == types.ENUM && types.at(scope.at(here).*.ty).*.enumerators == 0 {
            const declared = scope.at(here).*.ty
            types.at(declared).*.size = types.at(ty).*.size
            types.at(declared).*.alignment = types.at(ty).*.alignment
            types.at(declared).*.unsigned = types.at(ty).*.unsigned
            ty = declared
        }
    }
    var value: i64 = 0
    var first = true
    // (In a function: the enumerators bound below it, apart from the
    // other functions', as a local class's members are.)
    const local = scoped && tag != 0 && standard.cpp && state.currentFunction() != 0
    if scoped && tag != 0 {
        var prefix = scope.qualify(scope.currentNamespace(), tokens.name(tag))
        if local {
            const owner = base.join(base.nameOf(ast.obj(state.currentFunction()).*.name), "#local")
            prefix = scope.qualify(scope.qualify(scope.currentNamespace(), base.intern(owner)), tokens.name(tag))
        }
        if scope.findHere(tokens.name(tag)) == 0 { const named = scope.bindNamespace(tokens.name(tag), prefix) }
        scope.enterPrefix(prefix)
        if local { scope.beginQualified() }
    }
    while !cursor.consumeEnd() {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        const name = cursor.expectIdent()
        stdAttributes()
        const ignored = attributes()
        if cursor.consume(names.P_ASSIGN) { value = eval.constExpression() }
        const bound = scope.bindEnumConstant(tokens.name(name), ty, value)
        if standard.cpp && !scoped && tag != 0 && state.currentFunction() == 0 {
            // C++11: an unscoped enum's enumerators named through it too
            // (`RegisterID::InvalidGPRReg`).
            const own = scope.qualify(scope.currentNamespace(), tokens.name(tag))
            if scope.findHere(tokens.name(tag)) == 0 { const named = scope.bindNamespace(tokens.name(tag), own) }
            scope.enterPrefix(own)
            const alsoBound = scope.bindEnumConstant(tokens.name(name), ty, value)
            scope.leaveNamespace()
        }
        const cell = base.alloc(24)
        base.putWord(cell, @intCast(usize, tokens.name(name)))
        base.putWord(cell + 8, @bitCast(u64, value))
        base.putWord(cell + 16, types.at(ty).*.enumerators)
        types.at(ty).*.enumerators = cell
        value = value +% 1
    }
    if local { scope.endQualified() }
    if scoped && tag != 0 { scope.leaveNamespace() }
    const trailing = attributes()
    if tag != 0 {
        const here = scope.findTagHere(tokens.name(tag))
        if here != 0 && types.kind(scope.at(here).*.ty) == types.ENUM { return scope.at(here).*.ty }
        const bound = scope.bindTag(tokens.name(tag), ty)
    }
    return ty
}

pub fn staticAssert() -> void {
    cursor.expect(names.K_STATIC_ASSERT)
    cursor.expect(names.P_LPAREN)
    const start = cursor.peek()
    const value = eval.constExpression()
    if cursor.consume(names.P_COMMA) {
        if tokens.kind(cursor.peek()) != tokens.STRING { cursor.fail("expected a string literal") }
        cursor.advance()
    }
    cursor.expect(names.P_RPAREN)
    cursor.expect(names.P_SEMI)
    if value == 0 { tokens.errorAt(start, "static assertion failed") }
}

pub fn parseTypedef(baseType: usize) -> void {
    var first = true
    while !cursor.consume(names.P_SEMI) {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        if standard.cpp && (cursor.is(names.K_WCHAR_T) || cursor.is(names.K_CHAR16_T) || cursor.is(names.K_CHAR32_T)) {
            // A C header's `typedef int wchar_t;`: a keyword in C++.
            cursor.advance()
            continue
        }
        const found = declarator(baseType)
        if found.1 == 0 { cursor.fail("typedef name omitted") }
        afterDeclarator()
        const bound = scope.bindTypedef(tokens.name(found.1), found.0)
        // The typedef names an anonymous struct or enum (for C++'s
        // mangled names).
        const k = types.kind(found.0)
        if (k == types.STRUCT || k == types.UNION || k == types.ENUM) && types.at(found.0).*.name == 0 {
            types.at(found.0).*.name = scope.qualify(scope.currentNamespace(), tokens.name(found.1))
        }
    }
}

// ---------------------------------------------------------------------------
// Objects

pub fn newLocal(name: u32, ty: usize, token: usize) -> usize {
    const o = ast.newObj(name, ty, token)
    ast.obj(o).*.isLocal = true
    ast.obj(o).*.alignment = types.alignOf(ty)
    state.addLocal(o)
    if name != 0 { const bound = scope.bindVariable(name, o) }
    return o
}

// A global without a name of its own (a string literal, a compound
// literal at file scope, a static local's storage).
pub fn newAnonymousGlobal(ty: usize, token: usize) -> usize {
    const o = ast.newObj(0, ty, token)
    ast.obj(o).*.isStatic = true
    ast.obj(o).*.isDefinition = true
    ast.obj(o).*.alignment = types.alignOf(ty)
    state.addGlobal(o)
    return o
}

pub fn stringLiteral(token: usize) -> usize {
    const o = newAnonymousGlobal(tokens.at(token).*.ty, token)
    ast.obj(o).*.isLiteral = true
    ast.obj(o).*.initData = tokens.at(token).*.data
    return o
}

// Declares the function `token` names with type `ty`; an earlier
// declaration of it is the same object. In C++ a function of the same
// name with other parameters is an overload (chained to the first), and
// the symbol is mangled unless the linkage is C's (extern "C", main).
pub fn declareFunction(ty: usize, token: usize, attr: usize) -> usize {
    const name = tokens.name(token)
    const a = attrAt(attr)
    const prefix = declaratorPrefix
    const qualified = standard.cpp && prefix != 0
    const cLinkage = !standard.cpp || externC > 0 || name == names.D_MAIN
    // At file scope the function declared before is one of this
    // namespace (a C++ `std::abs` is not the global `abs`).
    var binding: usize = 0
    if qualified {
        binding = scope.findQualified(prefix, name, false)
    } else if standard.cpp && scope.isFileScope() {
        binding = scope.findHere(name)
    } else {
        binding = scope.find(name)
    }
    if standard.cpp && binding != 0 && !(scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isFunction) {
        // A function template of the name declared since (`operator!=`
        // of pair between two headers' operators): the functions under it.
        var b = scope.at(binding).*.hidden
        while b != 0 && scope.at(b).*.depth == scope.at(binding).*.depth && scope.at(b).*.name == scope.at(binding).*.name {
            if scope.at(b).*.kind == scope.VARIABLE && ast.obj(scope.at(b).*.obj).*.isFunction {
                binding = b
                break
            }
            b = scope.at(b).*.hidden
        }
    }
    if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isFunction {
        var known = scope.at(binding).*.obj
        if qualified && ast.obj(known).*.classType != 0 {
            // `void S::f(int) { }`: the member declared in the class.
            const method = cpp.matchMember(known, ty)
            if method == 0 { tokens.errorAt(token, "no member function with these parameters") }
            // (Inline by the definition or by the class's declaration,
            // `inline void *data();`, as constexpr is.)
            if a.*.isInline || a.*.isConstexpr || ast.obj(method).*.isInline || ast.obj(method).*.isConstexpr {
                ast.obj(method).*.isInline = true
                ast.obj(method).*.isWeak = true
            }
            // (A class template's member, made in every file that uses
            // it: `template <class T> void M<T>::prune() { }`.)
            if template.instantiating() { ast.obj(method).*.isWeak = true }
            return method
        }
        // (A C function of another signature, C++'s declaration: an
        // overload, `float sin(float)` beside math.h's `sin`.)
        var found = cLinkage || (ast.obj(known).*.externC && (!standard.cpp || sameSignature(ast.obj(known).*.ty, ty)))
        if !found {
            // The overload with these parameters, if declared before.
            var candidate = known
            while candidate != 0 && !found {
                if sameSignature(ast.obj(candidate).*.ty, ty) {
                    known = candidate
                    found = true
                } else if ast.obj(candidate).*.nextOverload == 0 {
                    // A new overload, after the last.
                    const o = newFunction(name, ty, a, if qualified { prefix } else { scope.currentNamespace() }, cLinkage)
                    ast.obj(candidate).*.nextOverload = o
                    return o
                }
                candidate = ast.obj(candidate).*.nextOverload
            }
        }
        // A prototype tells more than an old-style declaration.
        if types.at(ast.obj(known).*.ty).*.oldStyle && !types.at(ty).*.oldStyle { ast.obj(known).*.ty = ty }
        if a.*.isStatic { ast.obj(known).*.isStatic = true }
        if a.*.isInline { ast.obj(known).*.isInline = true }
        if a.*.isConstexpr { ast.obj(known).*.isConstexpr = true }
        if (a.*.isInline || a.*.isConstexpr) && standard.cpp && !a.*.isStatic && !ast.obj(known).*.isStatic {
            ast.obj(known).*.isInline = true
            ast.obj(known).*.isWeak = true
        }
        if !qualified && scope.at(binding).*.depth != scope.currentDepth() { const bound = scope.bindVariable(name, known) }
        return known
    }
    if qualified { tokens.errorAt(token, "no such function in the namespace") }
    const o = newFunction(name, ty, a, scope.currentNamespace(), cLinkage)
    const bound = scope.bindVariable(name, o)
    return o
}

fn newFunction(name: u32, ty: usize, a: *Attr, prefix: u32, cLinkage: bool) -> usize {
    const o = ast.newObj(name, ty, 0)
    ast.obj(o).*.isFunction = true
    ast.obj(o).*.isStatic = a.*.isStatic || (a.*.isInline && !a.*.isExtern && !standard.cpp)
    // A C++ inline function is defined in every file that uses it: weak.
    ast.obj(o).*.isWeak = (standard.cpp && a.*.isInline && !a.*.isStatic) || a.*.isWeak
    ast.obj(o).*.isInline = a.*.isInline
    ast.obj(o).*.isConstexpr = a.*.isConstexpr
    // A C++ constexpr function is inline.
    if standard.cpp && a.*.isConstexpr && !a.*.isStatic {
        ast.obj(o).*.isInline = true
        ast.obj(o).*.isWeak = true
    }
    ast.obj(o).*.externC = cLinkage
    if !cLinkage {
        ast.obj(o).*.linkName = mangle.functionSymbol(prefix, name, ty, "")
        ast.obj(o).*.symbol = ast.obj(o).*.linkName
    }
    state.addGlobal(o)
    return o
}

// A member function's (or a friend's) body, read after its class
// `classTy` (cpp.mlx), whose names it sees.
pub fn defineFunction(fnObj: usize, classTy: usize) -> void {
    declaratorPrefix = if classTy != 0 { types.at(classTy).*.name } else { 0 }
    functionDefinition(fnObj, ast.obj(fnObj).*.ty)
}

// The same, the body seeing the names under `prefix` (a member
// template instance's parameters, bound below its class).
pub fn defineFunctionIn(fnObj: usize, prefix: u32) -> void {
    declaratorPrefix = prefix
    functionDefinition(fnObj, ast.obj(fnObj).*.ty)
}

// The same, the body using the parameter names of `declaredType` (the
// definition's, read apart from the declaration that made `fnObj`).
pub fn defineFunctionAs(fnObj: usize, prefix: u32, declaredType: usize) -> void {
    declaratorPrefix = prefix
    functionDefinition(fnObj, declaredType)
}

// The definition's parameter names (`void S::f(int n)`) become the
// member function's, whose type has its `this`.
fn parameterNames(fnObj: usize, declaredType: usize) -> void {
    const ty = ast.obj(fnObj).*.ty
    if ty == declaredType { return }
    var p = types.at(ty).*.params
    if p != 0 && types.param(p).*.name == names.K_THIS { p = types.param(p).*.next }
    var q = types.at(declaredType).*.params
    while p != 0 && q != 0 {
        types.param(p).*.name = types.param(q).*.name
        types.param(p).*.token = types.param(q).*.token
        // (An expanded pack's elements: the definition's pack name.)
        types.param(p).*.packName = types.param(q).*.packName
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
}

// C++: the default arguments an earlier declaration gave (`void f(int,
// T = T::Malloc);` then `void f(int, T) { }`) kept for the definition's
// parameters.
fn inheritDefaults(declared: usize, defined: usize) -> void {
    if !standard.cpp || types.kind(declared) != types.FUNC { return }
    var p = types.at(declared).*.params
    var q = types.at(defined).*.params
    while p != 0 && q != 0 {
        if types.param(q).*.defaultValue == 0 { types.param(q).*.defaultValue = types.param(p).*.defaultValue }
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
}

// The default arguments of an out-of-class member definition's
// parameters (`defined`, without `this`) given to the member's type
// (`declared`, with it) where it has none.
fn definitionDefaults(declared: usize, defined: usize) -> void {
    if !standard.cpp || types.kind(declared) != types.FUNC || types.kind(defined) != types.FUNC { return }
    var p = types.at(declared).*.params
    if p != 0 && types.param(p).*.name == names.K_THIS { p = types.param(p).*.next }
    var q = types.at(defined).*.params
    if q != 0 && types.param(q).*.name == names.K_THIS { q = types.param(q).*.next }
    while p != 0 && q != 0 {
        if types.param(p).*.defaultValue == 0 { types.param(p).*.defaultValue = types.param(q).*.defaultValue }
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
}

fn functionDefinition(fnObj: usize, declaredType: usize) -> void {
    template.memberRequires = 0
    const o = ast.obj(fnObj)
    // (A class template instance's member given its definition again,
    // read for the instances made before it: the same body, passed over.)
    if o.*.isDefinition && template.instantiating() && o.*.classType != 0 {
        cpp.skipBody()
        return
    }
    if o.*.isDefinition { tokens.errorAt(o.*.token, "redefinition of a function") }
    o.*.isDefinition = true
    // A member function's type has its `this`; the definition's
    // parameter names are the ones its body uses.
    const ty = if o.*.classType != 0 { o.*.ty } else { declaredType }
    parameterNames(fnObj, declaredType)
    if ty != o.*.ty { inheritDefaults(o.*.ty, ty) }
    // (A member defined outside its class may add default arguments:
    // `void D::dump(PrintStream &, P *, unsigned depth = 0)`.)
    if ty == o.*.ty && declaredType != ty { definitionDefaults(ty, declaredType) }
    o.*.ty = ty
    // `void N::f() { }`: the body sees N's names; a member function's
    // body sees its class's.
    var prefix = declaratorPrefix
    if o.*.classType != 0 && prefix == 0 { prefix = types.at(o.*.classType).*.name }
    if prefix != 0 { scope.enterPrefix(prefix) }
    state.startFunction(fnObj)
    state.setCurrentClass(o.*.classType)
    const outerClasses = if standard.cpp { cpp.enterBody() } else { 0 }
    scope.enter()
    // The parameters, in order, as cells (obj, next).
    var head: usize = 0
    var tail: usize = 0
    // A struct or union result over 16 bytes goes to the caller's buffer,
    // whose address comes as a hidden first parameter.
    const rt = types.baseOf(ty)
    const resultInMemory = (types.kind(rt) == types.STRUCT || types.kind(rt) == types.UNION || types.isWide(rt)) && types.inMemory(rt)
    if resultInMemory {
        const hidden = newLocal(0, types.pointerTo(rt), o.*.token)
        head = base.alloc(16)
        base.putWord(head, hidden)
        tail = head
    }
    var p = types.at(ty).*.params
    while p != 0 {
        // An unnamed parameter is C23's (`int f(int) { }`).
        if types.param(p).*.name == 0 && !standard.atLeast(standard.C23) { tokens.errorAt(types.param(p).*.token, "parameter name omitted") }
        const local = newLocal(types.param(p).*.name, types.param(p).*.ty, types.param(p).*.token)
        // A class passed by value is destroyed by the function.
        if standard.cpp && cpp.hasDestructor(types.param(p).*.ty) { state.pushCleanup(local) }
        const c = base.alloc(16)
        base.putWord(c, local)
        if head == 0 { head = c } else { base.putWord(tail + 8, c) }
        tail = c
        if types.param(p).*.packName != 0 {
            // One of an expanded pack's: the pack's name holds them all
            // (`args...` expands to them).
            const packBinding = scope.findHere(types.param(p).*.packName)
            var holder: usize = 0
            if packBinding != 0 && scope.at(packBinding).*.kind == scope.PACK {
                holder = scope.at(packBinding).*.obj
            } else {
                holder = types.newPackHolder()
                const bound = scope.bindPack(types.param(p).*.packName, 0, holder)
            }
            types.addPackVariable(holder, local)
            types.addPackType(holder, types.param(p).*.ty)
        }
        p = types.param(p).*.next
    }
    // An expanded pack with no element is still a name (`args...` empty).
    var emptyPack = types.at(ty).*.emptyPacks
    while emptyPack != 0 {
        const bound = scope.bindPack(@intCast(u32, base.getWord(emptyPack)), 0, types.newPackHolder())
        emptyPack = base.getWord(emptyPack + 8)
    }
    o.*.params = head
    if types.at(ty).*.variadic {
        o.*.vaArea = newLocal(0, types.arrayOf(types.charOf(), 200), o.*.token)
    }
    var prologue: usize = 0
    if standard.cpp && o.*.isConstructor { prologue = cpp.constructorPrologue(fnObj) }
    const bodyToken = cursor.peek()
    cursor.expect(names.P_LBRACE)
    // __func__ (C11 6.4.2.2) and GNU's __FUNCTION__.
    const text = base.nameOf(o.*.name)
    const data = base.keep(text)
    const literal = newAnonymousGlobal(types.arrayOf(types.charOf(), @intCast(i64, text.length) + 1), o.*.token)
    ast.obj(literal).*.isLiteral = true
    ast.obj(literal).*.initData = data
    const bound = scope.bindVariable(funcName, literal)
    const bound2 = scope.bindVariable(functionName, literal)
    const bound3 = scope.bindVariable(prettyFunctionName, literal)
    o.*.body = stmt.compoundStatement()
    if standard.cpp { o.*.body = cpp.functionBody(fnObj, prologue, o.*.body, bodyToken) }
    // `auto f()` deduced to a struct over 16 bytes (`std::array<...>`):
    // the caller's buffer comes first after all.
    const deducedResult = types.baseOf(o.*.ty)
    if !resultInMemory && (types.kind(deducedResult) == types.STRUCT || types.kind(deducedResult) == types.UNION || types.isWide(deducedResult)) && types.inMemory(deducedResult) {
        const hidden = newLocal(0, types.pointerTo(deducedResult), o.*.token)
        const c = base.alloc(16)
        base.putWord(c, hidden)
        base.putWord(c + 8, o.*.params)
        o.*.params = c
    }
    if standard.cpp { cpp.leaveBody(outerClasses) }
    o.*.locals = state.locals()
    state.endFunction()
    scope.leave()
    if prefix != 0 { scope.leaveNamespace() }
    stmt.resolveGotos()
}

fn globalVariable(ty: usize, token: usize, attr: usize) -> void {
    if standard.cpp { cpp.completeIfNeeded(ty) }
    const name = tokens.name(token)
    const a = attrAt(attr)
    var o: usize = 0
    const binding = if standard.cpp && declaratorPrefix != 0 { scope.findQualified(declaratorPrefix, name, false) } else { scope.findHere(name) }
    if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE {
        const known = scope.at(binding).*.obj
        if !ast.obj(known).*.isFunction && !ast.obj(known).*.isLocal { o = known }
    }
    // (`constexpr bool numeric_limits<X>::is_signed;`: the old
    // out-of-class definition of a constant member, which is its own.)
    if o == 0 && standard.cpp && declaratorPrefix != 0 && binding != 0 && scope.at(binding).*.kind == scope.ENUM_CONSTANT && cursor.is(names.P_SEMI) { return }
    if o == 0 && standard.cpp && declaratorPrefix != 0 { tokens.errorAt(token, "no such member") }
    if o == 0 {
        o = ast.newObj(name, ty, token)
        // C++: a const namespace-scope variable has internal linkage
        // (one per file), unless declared extern or inline.
        ast.obj(o).*.isStatic = a.*.isStatic || (standard.cpp && (types.isConst(ty) || a.*.isConstexpr) && !a.*.isExtern && !a.*.isInline)
        if standard.cpp && externC == 0 && scope.currentNamespace() != 0 {
            ast.obj(o).*.linkName = mangle.variableSymbol(scope.currentNamespace(), name)
            ast.obj(o).*.symbol = ast.obj(o).*.linkName
        }
        state.addGlobal(o)
        const bound = scope.bindVariable(name, o)
    } else if types.at(ast.obj(o).*.ty).*.incomplete && !types.at(ty).*.incomplete {
        // `extern int a[]; int a[10];`
        ast.obj(o).*.ty = ty
    }
    ast.obj(o).*.alignment = if a.*.alignment > 0 { a.*.alignment } else { types.alignOf(ast.obj(o).*.ty) }
    if a.*.isConstexpr { ast.obj(o).*.isConstexpr = true }
    // (An inline object of a class, `inline constexpr ASCIILiteral e {
    // "..."_s };` in a header, and a class template instance's static
    // data member, made in every file that uses it: weak too.)
    if standard.cpp && !a.*.isExtern && (a.*.isInline || (template.instantiating() && declaratorPrefix != 0)) {
        ast.obj(o).*.isWeak = true
        ast.obj(o).*.isStatic = false
    }
    if standard.cpp && !a.*.isExtern && (cpp.isObjectType(ast.obj(o).*.ty) || (cpp.isClassType(ast.obj(o).*.ty) && cursor.is(names.P_ASSIGN) && !cursor.isToken(cursor.peekNext(), names.P_LBRACE))) {
        // An object of a class: made when the program starts (a plain
        // class from an expression too: `in_place_t in_place = in_place_t();`).
        if declaratorPrefix != 0 { scope.enterPrefix(declaratorPrefix) }
        cpp.globalObject(o, token)
        if declaratorPrefix != 0 { scope.leaveNamespace() }
        return
    }
    if !a.*.isExtern {
        ast.obj(o).*.isDefinition = true
        if ast.obj(o).*.initData == 0 { ast.obj(o).*.isTentative = true }
        // `__attribute__((weak))`, C++17's `inline` variable: one
        // definition kept among every file's.
        if a.*.isWeak || (standard.cpp && a.*.isInline) {
            ast.obj(o).*.isWeak = true
            ast.obj(o).*.isStatic = false
        }
    }
    // C++'s `int x{5};`, `G g{1, 2};`: as `= {...}`.
    const braced = standard.cpp && cursor.is(names.P_LBRACE)
    if braced || cursor.consume(names.P_ASSIGN) {
        if ast.obj(o).*.initData != 0 && !ast.obj(o).*.isTentative { tokens.errorAt(token, "redefinition of a variable") }
        // (`const Info B::s_info = { &Base::s_info };`: the initializer
        // sees the class's names, as the definition's scope.)
        const within = standard.cpp && declaratorPrefix != 0
        if within { scope.enterPrefix(declaratorPrefix) }
        initializer.globalInitializer(o)
        if within { scope.leaveNamespace() }
        ast.obj(o).*.isDefinition = true
        ast.obj(o).*.isTentative = false
    }
}

// The declarations after the specifiers at file scope.
pub fn globalDeclaration(baseType: usize, attr: usize) -> void {
    var first = true
    while !cursor.consume(names.P_SEMI) {
        if !first { cursor.expect(names.P_COMMA) }
        const found = declarator(baseType)
        if found.1 == 0 { cursor.fail("variable name omitted") }
        afterDeclarator()
        var ty = found.0
        if standard.cpp && types.unqualified(ty) == cpp.deducedMarker() {
            // `static constexpr std::array table { ... };`: the class
            // from the guides.
            const deduced = cpp.deducedClass(found.1)
            ty = if types.isConst(ty) { types.constOf(deduced) } else { deduced }
        }
        if attrAt(attr).*.isAuto && !attrAt(attr).*.hasType && standard.atLeast(standard.C23) && types.kind(ty) != types.FUNC { ty = inferredType() }
        if attrAt(attr).*.isConstexpr && constexprConstant(ty, found.1) {
            first = false
            continue
        }
        // A constexpr variable is const (its value a constant).
        if standard.cpp && attrAt(attr).*.isConstexpr && types.kind(ty) != types.FUNC && !types.isConst(ty) && !cpp.isClassType(ty) { ty = types.constOf(ty) }
        if types.kind(ty) == types.FUNC {
            if standard.cpp && template.memberRequires != 0 && declaratorPrefix != 0 && cpp.classWithPrefix(declaratorPrefix) != 0 && !template.memberConstraintHolds() {
                // `R C<T, Mode>::f() requires (Mode == Disabled) { ... }`
                // for an instance where it does not hold: no such member;
                // the definition passed over.
                if cursor.is(names.P_LBRACE) {
                    var level: i64 = 0
                    while !cursor.isEof() {
                        if cursor.is(names.P_LBRACE) { level += 1 }
                        if cursor.is(names.P_RBRACE) {
                            level -= 1
                            if level == 0 {
                                cursor.advance()
                                break
                            }
                        }
                        cursor.advance()
                    }
                } else {
                    while !cursor.is(names.P_SEMI) && !cursor.isEof() { cursor.advance() }
                    cursor.expect(names.P_SEMI)
                }
                return
            }
            template.memberRequires = 0
            const fnObj = declareFunction(ty, found.1, attr)
            if ast.obj(fnObj).*.token == 0 { ast.obj(fnObj).*.token = found.1 }
            // `X::X() = default;`, `X::~X() = default;` outside the class:
            // as an empty body (the bases and members made or destroyed
            // around it).
            // `X::X(const X &) = default;`, `X &X::operator=(X &&) =
            // default;`: member by member.
            const copying = ast.obj(fnObj).*.isConstructor && types.at(ty).*.params != 0
            const assigning = ast.obj(fnObj).*.name == cpp.operatorFunction("=")
            if first && standard.cpp && cursor.is(names.P_ASSIGN) && cursor.isToken(cursor.peekNext(), names.K_DEFAULT) && ast.obj(fnObj).*.classType != 0 && (ast.obj(fnObj).*.isDestructor || ast.obj(fnObj).*.isConstructor || assigning) {
                cursor.advance()
                cursor.advance()
                const after = cursor.save()
                cursor.restore(cpp.generatedTokens(if assigning { "{ __mlxcc_memberwise_assign ( ) ; return * this ; }" } else { "{ }" }))
                cpp.memberwiseCopy = copying
                if template.instantiating() && !ast.obj(fnObj).*.isVirtual {
                    parameterNames(fnObj, ty)
                    template.notePendingOuter(fnObj)
                    cpp.pendBody(fnObj, ast.obj(fnObj).*.classType)
                } else {
                    functionDefinition(fnObj, ty)
                }
                cursor.restore(after)
                cursor.expect(names.P_SEMI)
                return
            }
            // A definition: its body, or a constructor's initializer list.
            if first && (cursor.is(names.P_LBRACE) || (standard.cpp && ast.obj(fnObj).*.isConstructor && cursor.is(names.P_COLON))) {
                if standard.cpp && template.instantiating() && ast.obj(fnObj).*.classType != 0 && !ast.obj(fnObj).*.isVirtual {
                    // A class template instance's member defined outside
                    // the class: its body waits for a call.
                    parameterNames(fnObj, ty)
                    template.notePendingOuter(fnObj)
                    cpp.pendBody(fnObj, ast.obj(fnObj).*.classType)
                    return
                }
                functionDefinition(fnObj, ty)
                return
            }
        } else {
            globalVariable(ty, found.1, attr)
        }
        first = false
    }
}

// A declaration in a block: a BLOCK of the assignments its initializers
// make.
// `T x = e` as an if's condition (stmt.withDeclaration), before the
// `)`: x declared as localDeclaration declares it; its name token. The
// statement making it is kept for takeConditionStatement.
var conditionStatement: usize = 0
pub fn conditionDeclaration(baseType: usize, attr: usize) -> usize {
    stopAtParen = true
    const nameToken = cursor.peek()
    var name = nameToken
    // The name: the identifier before the `=` or `{`.
    var t = nameToken
    while !tokens.is(t, names.P_ASSIGN) && !tokens.is(t, names.P_LBRACE) {
        if tokens.kind(t) == tokens.IDENT { name = t }
        t = tokens.next(t)
    }
    conditionStatement = localDeclaration(baseType, attr)
    stopAtParen = false
    return name
}
pub fn takeConditionStatement() -> usize {
    const s = conditionStatement
    conditionStatement = 0
    return s
}
var stopAtParen = false

pub fn localDeclaration(baseType: usize, attr: usize) -> usize {
    // (The condition's own declaration only: not those of the instances
    // its initializer makes.)
    const stopHere = stopAtParen
    stopAtParen = false
    const a = attrAt(attr)
    const block = ast.make(ast.BLOCK, cursor.peek())
    var head: usize = 0
    var tail: usize = 0
    var first = true
    if standard.cpp && a.*.isAuto && !a.*.hasType && cpp.structuredAhead() {
        // `auto [a, b] = e;` (C++17's structured bindings).
        const token = cursor.peek()
        const found = cpp.structuredNames()
        var value: usize = 0
        if cursor.consume(names.P_ASSIGN) {
            value = expr.assign()
        } else if cursor.consume(names.P_LBRACE) {
            value = expr.assign()
            cursor.expect(names.P_RBRACE)
        } else {
            cursor.expect(names.P_LPAREN)
            value = expr.assign()
            cursor.expect(names.P_RPAREN)
        }
        if !stopHere { cursor.expect(names.P_SEMI) }
        cpp.bindStructured(block, baseType, found.0, found.1, found.2, value, token)
        return block
    }
    while !cursor.consume(names.P_SEMI) {
        if stopHere && !first { break }
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        const found = declarator(baseType)
        if found.1 == 0 { cursor.fail("variable name omitted") }
        afterDeclarator()
        var ty = found.0
        const token = found.1
        const name = tokens.name(token)
        if standard.cpp && types.unqualified(ty) == cpp.deducedMarker() {
            // `Locker locker { lock };`: the class from the guides.
            const deduced = cpp.deducedClass(token)
            ty = if types.isConst(ty) { types.constOf(deduced) } else { deduced }
        }
        // C++'s `auto x = e` (and `auto &r = e`, `auto *p = e`): the
        // initializer, read once, gives the type.
        var autoValue: usize = 0
        const initStart = cursor.save()
        if a.*.isAuto && !a.*.hasType && standard.cpp && types.kind(ty) != types.FUNC {
            if cursor.consume(names.P_LBRACE) {
                // `auto x{e}`: as `auto x = e`.
                autoValue = expr.assign()
                cursor.expect(names.P_RBRACE)
            } else if cursor.consume(names.P_LPAREN) {
                // `auto x(e)`: as `auto x = e`.
                autoValue = expr.assign()
                cursor.expect(names.P_RPAREN)
            } else {
                if !cursor.consume(names.P_ASSIGN) { cursor.fail("auto needs an initializer to take its type from") }
                autoValue = expr.assign()
            }
            typing.addType(autoValue)
            var inferred = ast.typeOf(autoValue)
            if types.kind(inferred) == types.ARRAY { inferred = types.pointerTo(types.baseOf(inferred)) }
            if types.kind(inferred) == types.FUNC { inferred = types.pointerTo(inferred) }
            if types.isReference(ty) {
                // (`const auto &r = e`: const whatever e is.)
                if types.isConst(types.baseOf(ty)) { inferred = types.constOf(inferred) }
                ty = types.referenceTo(inferred)
            } else {
                // `auto x = e` takes e's type without its own const
                // (`auto dist = r + small / 2`, small constexpr); `auto
                // const x` is const.
                const declaredConst = types.isConst(ty)
                ty = if types.kind(inferred) == types.STRUCT || types.kind(inferred) == types.UNION || types.isScalar(inferred) { types.unqualified(inferred) } else { inferred }
                if declaredConst { ty = types.constOf(ty) }
            }
        } else if a.*.isAuto && !a.*.hasType && standard.atLeast(standard.C23) {
            ty = inferredType()
        }
        if a.*.isConstexpr && constexprConstant(ty, token) { continue }
        if a.*.isConstexpr && autoValue != 0 && types.isInteger(ty) {
            // `constexpr auto tag = P::tag;`: a constant as with its type
            // written (the initializer read again for its value).
            const after = cursor.save()
            cursor.restore(initStart)
            if cursor.is(names.P_LBRACE) && constexprBracedConstant(ty, token) { continue }
            if cursor.is(names.P_ASSIGN) && constexprConstant(ty, token) { continue }
            cursor.restore(after)
        }
        // A constexpr local is const (a lambda reads it uncaptured).
        if standard.cpp && a.*.isConstexpr && types.kind(ty) != types.FUNC && !types.isReference(ty) && !types.isConst(ty) && !cpp.isClassType(ty) { ty = types.constOf(ty) }
        if types.kind(ty) == types.FUNC {
            const declared = declareFunction(ty, token, attr)
            if ast.obj(declared).*.token == 0 { ast.obj(declared).*.token = token }
        } else if types.isReference(ty) {
            // `T &r = object`: the local holds the object's address.
            if a.*.isStatic || a.*.isExtern { tokens.errorAt(token, "a static reference is not supported") }
            const local = newLocal(name, ty, token)
            // (`T &r = e`, `T &r(e)`, `T &r{e}`.)
            var given = autoValue
            if given == 0 {
                if cursor.consume(names.P_ASSIGN) {
                    given = expr.assign()
                } else if standard.cpp && cursor.consume(names.P_LPAREN) {
                    given = expr.assign()
                    cursor.expect(names.P_RPAREN)
                } else if standard.cpp && cursor.consume(names.P_LBRACE) {
                    given = expr.assign()
                    cursor.expect(names.P_RBRACE)
                } else {
                    tokens.errorAt(token, "a reference needs an initializer")
                }
            }
            const bound = typing.toReference(given, ty)
            const target = ast.variableNode(local, token)
            ast.node(target).*.ty = ty
            const init = ast.binary(ast.ASSIGN, target, bound, token)
            ast.node(init).*.ty = ty
            const statement = ast.unary(ast.EXPR_STMT, cpp.flushTemporaries(init, false, token), token)
            if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
            tail = statement
        } else if a.*.isExtern {
            // The global the name stands for, defined elsewhere.
            const o = ast.newObj(name, ty, token)
            ast.obj(o).*.alignment = types.alignOf(ty)
            state.addGlobal(o)
            const bound = scope.bindVariable(name, o)
        } else if a.*.isStatic {
            if types.kind(ty) == types.VOID { tokens.errorAt(token, "variable declared void") }
            const o = newAnonymousGlobal(ty, token)
            ast.obj(o).*.name = name
            if a.*.alignment > 0 { ast.obj(o).*.alignment = a.*.alignment }
            const bound = scope.bindVariable(name, o)
            if standard.cpp { cpp.completeIfNeeded(ty) }
            if standard.cpp && cpp.isObjectType(ty) {
                // Made the first time the declaration runs.
                const statement = cpp.staticLocalObject(o, token)
                if statement != 0 {
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            } else if cursor.consume(names.P_ASSIGN) || (standard.cpp && cursor.is(names.P_LBRACE)) {
                // (`static W w { 1, 2 };`: as `= { 1, 2 }`.)
                initializer.globalInitializer(o)
            }
        } else {
            if types.kind(ty) == types.VOID { tokens.errorAt(token, "variable declared void") }
            const local = newLocal(name, ty, token)
            if a.*.alignment > 0 { ast.obj(local).*.alignment = a.*.alignment }
            if autoValue != 0 {
                const statement = cpp.localObjectFrom(local, autoValue, token)
                if statement != 0 {
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            } else if standard.cpp && (cpp.completeIfNeeded(ty) || cpp.isObjectType(ty) || cursor.is(names.P_LBRACE)) {
                const statement = cpp.localObject(local, token)
                if statement != 0 {
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            } else if cursor.consume(names.P_ASSIGN) {
                // C++: a const integer local with a constant value is one.
                if standard.cpp && types.isConst(ty) && types.isInteger(ty) && !types.isWide(ty) {
                    const start = cursor.save()
                    const e = expr.assign()
                    if eval.isConstant(e) {
                        ast.obj(local).*.hasConstValue = true
                        ast.obj(local).*.constValue = eval.evaluate(e)
                    }
                    cursor.restore(start)
                }
                var init = initializer.localInitializer(local)
                if standard.cpp { init = cpp.flushTemporaries(init, false, token) }
                const statement = ast.unary(ast.EXPR_STMT, init, token)
                if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                tail = statement
            } else if standard.cpp && cursor.consume(names.P_LPAREN) {
                // `int x(5);` (`T v(args...)` with one element, or none:
                // then nothing).
                const given = base.alloc(2 * 8)
                const count = expr.argumentList(names.P_RPAREN, given, 2)
                if count > 1 { tokens.errorAt(token, "too many initializers") }
                if count == 1 {
                    const init = ast.binary(ast.ASSIGN, ast.variableNode(local, token), base.getWord(given), token)
                    const statement = ast.unary(ast.EXPR_STMT, cpp.flushTemporaries(init, false, token), token)
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            }
            const lt = ast.obj(local).*.ty
            // (`auto it = std::rbegin(a)`: a class instance only declared
            // so far is made whole.)
            if standard.cpp && types.at(lt).*.incomplete && cpp.isClassType(lt) { cpp.completeIfNeeded(lt) }
            if types.at(lt).*.incomplete { tokens.errorAt(token, "variable has incomplete type") }
        }
    }
    ast.node(block).*.body = head
    return block
}

// A translation unit (C11 6.9): its objects go to the state's globals.
pub fn translationUnit(list: usize) -> void {
    cursor.restore(list)
    externC = 0
    declarationList(false)
    if standard.cpp { template.finish() }
}

// The declarations here: to the end of the file, or to the `}` closing
// a namespace or an extern "C" block (consumed).
fn declarationList(inBraces: bool) -> void {
    while !cursor.isEof() {
        if inBraces && cursor.consume(names.P_RBRACE) { return }
        stdAttributes()
        if cursor.consume(names.P_SEMI) {
            // An empty declaration.
        } else if cursor.is(names.K_STATIC_ASSERT) {
            staticAssert()
        } else if cursor.is(names.K_ASM) || cursor.is(names.K_GNU2_ASM) {
            cursor.advance()
            skipParentheses()
            cursor.expect(names.P_SEMI)
        } else if standard.cpp && cursor.is(names.K_INLINE) && cursor.isToken(cursor.peekNext(), names.K_NAMESPACE) {
            // `inline namespace N { ... }`: its names are the enclosing
            // namespace's too.
            cursor.advance()
            cursor.advance()
            const inlined = namespaceDeclaration(true)
        } else if standard.cpp && cursor.consume(names.K_NAMESPACE) {
            const ignored = namespaceDeclaration(false)
        } else if standard.cpp && cursor.is(names.K_USING) {
            usingDeclaration()
        } else if standard.cpp && cursor.is(names.K_EXTERN) && tokens.kind(cursor.peekNext()) == tokens.STRING {
            // extern "C" declaration, or extern "C" { ... } (`extern
            // "C++"` gives C++ linkage back, in a C header).
            cursor.advance()
            const outer = externC
            externC = if base.same(tokens.text(cursor.peek()), "\"C++\"") { 0 } else { externC + 1 }
            cursor.advance()
            if cursor.consume(names.P_LBRACE) {
                declarationList(true)
            } else if cursor.is(names.K_TEMPLATE) {
                template.declaration()
            } else {
                const attr = newAttr()
                const baseType = declspec(attr)
                // (`extern "C" Slot g_config[];` declares, as `extern`
                // does: C++ [dcl.link].)
                attrAt(attr).*.isExtern = true
                if attrAt(attr).*.isTypedef { parseTypedef(baseType) } else { globalDeclaration(baseType, attr) }
            }
            externC = outer
        } else if standard.cpp && cursor.is(names.K_EXTERN) && cursor.isToken(cursor.peekNext(), names.K_TEMPLATE) {
            // `extern template class X<A>;`: an explicit instantiation
            // made in another file; nothing here.
            while !cursor.is(names.P_SEMI) && !cursor.isEof() { cursor.advance() }
            cursor.expect(names.P_SEMI)
        } else if standard.cpp && cursor.is(names.K_TEMPLATE) {
            template.declaration()
        } else if standard.cpp && template.guideAhead() {
            // `X(Lock &) -> X<Lock>;`: a deduction guide, read as the
            // function declaration it is rewritten to.
            cursor.restore(template.rewriteGuide())
        } else if standard.cpp && !cursor.is(names.K_TYPEDEF) && !cursor.is(names.K_FRIEND) && !cursor.is(names.K_STATIC_ASSERT) && template.abbreviatedHeader(cursor.peek()) != 0 {
            // `void f(const auto &x)`: a function template (the header
            // made for it now precedes the declaration).
            cursor.restore(template.lastAbbreviatedHeader())
            template.declaration()
        } else {
            const attr = newAttr()
            const baseType = declspec(attr)
            if attrAt(attr).*.isTypedef {
                parseTypedef(baseType)
            } else {
                globalDeclaration(baseType, attr)
            }
        }
    }
    if inBraces { cursor.fail("unterminated namespace or extern block") }
}

// `namespace N { ... }`, `namespace { ... }` (its names global), or
// `namespace N = M;`.
// `inline namespace N { ... }` read: its names are the enclosing
// namespace's too.
// The namespace's prefix (0 for an unnamed one or an alias). An inline
// one's names are its parent's from its start (`lib::forward` inside
// `lib`'s inline namespace).
// The name of the translation unit's unnamed namespace (`_GLOBAL__N_`
// and a hash of the file's path): its names are the file's own, apart
// from another file's of the same spelling (unified sources, a header's
// `namespace { }` in every file).
var unnamedNamespace: u32 = 0
pub fn startUnit(path: []const u8) -> void {
    var hash: u64 = 14695981039346656037
    var index: usize = 0
    while index < path.length {
        hash = (hash ^ @intCast(u64, path[index])) *% 1099511628211
        index += 1
    }
    unnamedNamespace = base.intern(base.join("_GLOBAL__N_", base.decimal(hash)))
}

fn namespaceDeclaration(isInline: bool) -> u32 {
    const ignored = attributes()
    if cursor.consume(names.P_LBRACE) {
        if unnamedNamespace == 0 { startUnit("unit") }
        // `namespace { }`: a namespace of the file's own, its names
        // seen around it (as an inline namespace's are).
        const prefix = scope.qualify(scope.currentNamespace(), unnamedNamespace)
        if !scope.isInlineNamespace(scope.currentNamespace(), prefix) { scope.addInlineNamespace(scope.currentNamespace(), prefix) }
        scope.enterPrefix(prefix)
        declarationList(true)
        scope.leaveNamespace()
        return 0
    }
    const token = cursor.expectIdent()
    const name = tokens.name(token)
    if cursor.consume(names.P_ASSIGN) {
        // An alias of another namespace.
        const read = qualifier()
        const target = cursor.expectIdent()
        const binding = if read.1 { scope.findQualified(read.0, tokens.name(target), false) } else { scope.find(tokens.name(target)) }
        if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE { tokens.errorAt(target, "not a namespace") }
        const bound = scope.bindNamespace(name, @intCast(u32, scope.at(binding).*.value))
        cursor.expect(names.P_SEMI)
        return 0
    }
    const prefix = scope.qualify(scope.currentNamespace(), name)
    const known = scope.findHere(name)
    if known == 0 || scope.at(known).*.kind != scope.NAMESPACE { const bound = scope.bindNamespace(name, prefix) }
    if cursor.consume(names.P_SCOPE) {
        // C++17's `namespace A::B { }` (`A::inline B` too): B in A.
        if isInline && !scope.isInlineNamespace(scope.currentNamespace(), prefix) { scope.addInlineNamespace(scope.currentNamespace(), prefix) }
        scope.enterPrefix(prefix)
        const innerInline = cursor.consume(names.K_INLINE)
        const inner = namespaceDeclaration(innerInline)
        scope.leaveNamespace()
        return prefix
    }
    cursor.expect(names.P_LBRACE)
    if isInline && !scope.isInlineNamespace(scope.currentNamespace(), prefix) { scope.addInlineNamespace(scope.currentNamespace(), prefix) }
    scope.enterPrefix(prefix)
    declarationList(true)
    scope.leaveNamespace()
    return prefix
}

// `using namespace N;` or `using N::name;` (the name usable here).
pub fn usingDeclaration() -> void {
    cursor.expect(names.K_USING)
    if cursor.consume(names.K_NAMESPACE) {
        const read = qualifier()
        const token = cursor.expectIdent()
        const binding = if read.1 { scope.findQualified(read.0, tokens.name(token), false) } else { scope.find(tokens.name(token)) }
        if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE { tokens.errorAt(token, "not a namespace") }
        scope.usingNamespace(@intCast(u32, scope.at(binding).*.value))
        if scope.currentDepth() == 0 && scope.currentNamespace() != 0 { scope.addDirective(scope.currentNamespace(), @intCast(u32, scope.at(binding).*.value)) }
        cursor.expect(names.P_SEMI)
        return
    }
    if cursor.consume(names.K_ENUM) {
        // `using enum E;`: E's enumerators usable here by their names.
        const read = qualifier()
        const token = cursor.expectIdent()
        const name = tokens.name(token)
        var ty: usize = 0
        const tag = if read.1 { scope.findQualified(read.0, name, true) } else { scope.findTag(name) }
        if tag != 0 { ty = scope.at(tag).*.ty } else {
            const alias = if read.1 { scope.findQualified(read.0, name, false) } else { scope.find(name) }
            if alias != 0 && scope.at(alias).*.kind == scope.TYPEDEF { ty = scope.at(alias).*.ty }
        }
        if ty == 0 || types.kind(ty) != types.ENUM { tokens.errorAt(token, "not an enum") }
        var cell = types.at(ty).*.enumerators
        while cell != 0 {
            const bound = scope.bindEnumConstant(@intCast(u32, base.getWord(cell)), ty, @bitCast(i64, base.getWord(cell + 8)))
            cell = base.getWord(cell + 16)
        }
        cursor.expect(names.P_SEMI)
        return
    }
    // (`using T [[maybe_unused]] = int;`: attributes after the name.)
    var attributed = false
    if cursor.isIdent() && !cursor.isToken(cursor.peekNext(), names.P_ASSIGN) && !cursor.isToken(cursor.peekNext(), names.P_SCOPE) {
        const saved = cursor.save()
        cursor.advance()
        stdAttributes()
        const ignored = attributes()
        attributed = cursor.is(names.P_ASSIGN)
        cursor.restore(saved)
    }
    if cursor.isIdent() && (attributed || cursor.isToken(cursor.peekNext(), names.P_ASSIGN)) {
        // `using T = type;`: a typedef (a class template named here is
        // not instantiated).
        const alias = cursor.expectIdent()
        stdAttributes()
        const ignoredAttributes = attributes()
        cursor.expect(names.P_ASSIGN)
        template.deferInstances += 1
        const ty = typeName()
        template.deferInstances -= 1
        cursor.expect(names.P_SEMI)
        const bound = scope.bindTypedef(tokens.name(alias), ty)
        return
    }
    const read = qualifier()
    const token = cursor.expectIdent()
    const name = tokens.name(token)
    var binding = if read.1 { scope.findQualified(read.0, name, false) } else { scope.find(name) }
    if binding == 0 {
        binding = if read.1 { scope.findQualified(read.0, name, true) } else { scope.findTag(name) }
        if binding == 0 { tokens.errorAt(token, "no such name") }
        const bound = scope.bindTag(name, scope.at(binding).*.ty)
    } else {
        const b = scope.at(binding)
        // A class of the name too (`using W::P;` names the class, not
        // its constructors).
        const tag = if read.1 { scope.findQualified(read.0, name, true) } else { scope.findTag(name) }
        if tag != 0 { const boundTag = scope.bindTag(name, scope.at(tag).*.ty) }
        // (`using std::exp;`: every function and function template of
        // the name, the older ones first.)
        var older = b.*.hidden
        var olderCount: usize = 0
        while older != 0 && scope.at(older).*.name == b.*.name && scope.at(older).*.depth == b.*.depth && olderCount < 64 {
            olderCount += 1
            older = scope.at(older).*.hidden
        }
        while olderCount > 0 {
            var o = b.*.hidden
            var steps: usize = 1
            while steps < olderCount {
                o = scope.at(o).*.hidden
                steps += 1
            }
            olderCount -= 1
            const ob = scope.at(o)
            if ob.*.kind == scope.VARIABLE && ast.obj(ob.*.obj).*.isFunction && !ast.obj(ob.*.obj).*.isConstructor {
                const boundOlder = scope.bindVariable(name, ob.*.obj)
            } else if ob.*.kind == scope.TEMPLATE && template.isFunctionTemplate(o) {
                const boundOlder = scope.bindTemplate(name, ob.*.obj)
            }
        }
        if b.*.kind == scope.VARIABLE {
            if !(tag != 0 && ast.obj(b.*.obj).*.isConstructor) { const bound = scope.bindVariable(name, b.*.obj) }
        } else if b.*.kind == scope.TYPEDEF {
            const bound = scope.bindTypedef(name, b.*.ty)
        } else if b.*.kind == scope.ENUM_CONSTANT {
            const bound = scope.bindEnumConstant(name, b.*.ty, b.*.value)
        } else if b.*.kind == scope.NAMESPACE {
            const bound = scope.bindNamespace(name, @intCast(u32, b.*.value))
        } else if b.*.kind == scope.TEMPLATE {
            // `using WTF::Variant;`: the (alias or class) template.
            const bound = scope.bindTemplate(name, b.*.obj)
        }
    }
    cursor.expect(names.P_SEMI)
}
