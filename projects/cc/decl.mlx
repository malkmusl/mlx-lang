// Declarations (C11 6.7): the declaration specifiers (storage class,
// type specifiers and qualifiers, struct, union and enum specifiers,
// typedef names), declarators (pointers, arrays, functions, the
// parenthesized ones read inside out), type names, and the declarations
// of a translation unit and of a block: typedefs, functions with their
// definitions, global, static and local variables. GNU attributes are
// read for `packed` and `aligned` and otherwise passed over; C23's
// [[attributes]] are passed over wherever they may stand.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")
const stmt = @import("./stmt.mlx")
const eval = @import("./eval.mlx")
const initializer = @import("./initializer.mlx")
const standard = @import("./standard.mlx")
const mangle = @import("./mangle.mlx")
const cpp = @import("./cpp.mlx")
const template = @import("./template.mlx")

// What the declaration specifiers said besides the type.
pub const Attr = struct {
    isTypedef: bool
    isStatic: bool
    isExtern: bool
    isInline: bool
    isThreadLocal: bool
    // C23: `constexpr`, `auto` (the type inferred when none was given).
    isConstexpr: bool
    isAuto: bool
    hasType: bool
    alignment: i64
    // C++: `virtual` (a member function).
    isVirtual: bool
}

// Type specifier counts (C11 6.7.2's multisets), one bit field each.
const S_VOID: u32 = 1
const S_BOOL: u32 = 4
const S_CHAR: u32 = 16
const S_SHORT: u32 = 64
const S_INT: u32 = 256
const S_LONG: u32 = 1024
const S_FLOAT: u32 = 4096
const S_DOUBLE: u32 = 16384
const S_OTHER: u32 = 65536
const S_SIGNED: u32 = 131072
const S_UNSIGNED: u32 = 262144
const S_BITINT: u32 = 1048576

// The width of the _BitInt being read.
var bitIntWidth: i64 = 0
// C++: how deep in `extern "C"` the declarations are (C linkage), and
// the namespace a qualified declarator named (`void N::f()`; 0: none).
var externC: u32 = 0
var declaratorPrefix: u32 = 0
// The token after the (qualified) type name qualifiedTypedef read last.
var typedefEnd: usize = 0

// The declaration state put aside while a template is instantiated
// (template.mlx), and brought back.
pub fn suspendDeclarations() -> usize {
    const saved = @intCast(usize, declaratorPrefix) | (@intCast(usize, externC) << 32)
    declaratorPrefix = 0
    externC = 0
    return saved
}

pub fn resumeDeclarations(saved: usize) -> void {
    declaratorPrefix = @intCast(u32, saved & 4294967295)
    externC = @intCast(u32, saved >> 32)
}

var packedName: u32 = 0
var packedName2: u32 = 0
var alignedName: u32 = 0
var alignedName2: u32 = 0
var funcName: u32 = 0
var functionName: u32 = 0
var vaAreaName: u32 = 0
var vaListType: usize = 0

pub fn init() -> void {
    packedName = base.intern("packed")
    packedName2 = base.intern("__packed__")
    alignedName = base.intern("aligned")
    alignedName2 = base.intern("__aligned__")
    funcName = base.intern("__func__")
    functionName = base.intern("__FUNCTION__")
    vaAreaName = base.intern("__va_area__")
    // __builtin_va_list: one element of { unsigned gp_offset, fp_offset;
    // void *overflow_arg_area, *reg_save_area; } (System V AMD64 ABI).
    const element = types.structType()
    types.at(element).*.size = 24
    types.at(element).*.alignment = 8
    types.at(element).*.incomplete = false
    vaListType = types.arrayOf(element, 1)
}

pub fn attrAt(attr: usize) -> *Attr {
    unsafe { return @ptrFromInt(*Attr, attr) }
}

pub fn newAttr() -> usize { return base.alloc(@sizeOf(Attr)) }

fn isStorageClass(id: u32) -> bool {
    return id == names.K_TYPEDEF || id == names.K_STATIC || id == names.K_EXTERN || id == names.K_INLINE || id == names.K_GNU_INLINE || id == names.K_GNU2_INLINE || id == names.K_THREAD_LOCAL || id == names.K_GNU_THREAD
}

fn isIgnoredQualifier(id: u32) -> bool {
    return id == names.K_CONST || id == names.K_GNU_CONST || id == names.K_VOLATILE || id == names.K_GNU2_VOLATILE || id == names.K_AUTO || id == names.K_REGISTER || id == names.K_RESTRICT || id == names.K_GNU_RESTRICT || id == names.K_GNU2_RESTRICT || id == names.K_NORETURN || id == names.K_GNU2_EXTENSION || id == names.K_CONSTEXPR
}

fn isTypeKeyword(id: u32) -> bool {
    if isStorageClass(id) || isIgnoredQualifier(id) { return true }
    if id == names.K_CLASS || id == names.K_WCHAR_T || id == names.K_CHAR16_T || id == names.K_CHAR32_T || id == names.K_DECLTYPE || id == names.K_UNDERLYING_TYPE || id == names.K_EXPLICIT || id == names.K_VIRTUAL || id == names.K_MUTABLE || id == names.K_FRIEND || id == names.K_TYPENAME { return true }
    return id == names.K_VOID || id == names.K_BOOL || id == names.K_CHAR || id == names.K_SHORT || id == names.K_INT || id == names.K_LONG || id == names.K_FLOAT || id == names.K_DOUBLE || id == names.K_SIGNED || id == names.K_GNU2_SIGNED || id == names.K_UNSIGNED || id == names.K_STRUCT || id == names.K_UNION || id == names.K_ENUM || id == names.K_ALIGNAS || id == names.K_ATOMIC || id == names.K_GNU2_ATTRIBUTE || id == names.K_TYPEOF || id == names.K_GNU2_TYPEOF || id == names.K_TYPEOF_UNQUAL || id == names.K_GNU_BUILTIN_VA_LIST || id == names.K_BITINT
}

// Whether `token` starts a type name (a declaration); in C++ a
// qualified one (`std::size_t`) too.
pub fn isTypename(token: usize) -> bool {
    const kind = tokens.kind(token)
    if kind == tokens.KEYWORD { return isTypeKeyword(tokens.name(token)) }
    if kind == tokens.IDENT {
        if standard.cpp { return qualifiedTypedef(token) != 0 }
        return scope.typedefOf(tokens.name(token)) != 0
    }
    if standard.cpp && tokens.is(token, names.P_SCOPE) { return qualifiedTypedef(token) != 0 }
    return false
}

// SFINAE: while a function template instance's signature is read for
// a call (template.instantiateFunction), a qualified name that does not
// exist (`enable_if<false, int>::type`) does not end the compilation
// but marks the instance as not viable.
pub var sfinae = false
pub var sfinaeFailed = false

// C++: the typedef the (qualified) name at `token` stands for, 0 for
// none: `T`, `N::T`, `::T`. The cursor is not moved.
fn qualifiedTypedef(token: usize) -> usize {
    var at = token
    var prefix: u32 = 0
    var qualified = false
    if tokens.is(at, names.P_SCOPE) {
        qualified = true
        at = tokens.next(at)
    }
    while true {
        if tokens.kind(at) != tokens.IDENT { return 0 }
        const name = tokens.name(at)
        typedefEnd = tokens.next(at)
        var binding = if qualified { scope.findQualified(prefix, name, false) } else { scope.find(name) }
        if !qualified && tokens.is(tokens.next(at), names.P_LT) { binding = scope.findKind(name, scope.TEMPLATE) }
        if tokens.is(tokens.next(at), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && cpp.isClassType(scope.at(binding).*.ty) && tokens.kind(tokens.next(tokens.next(at))) == tokens.IDENT {
            // `B::type`, B a typedef of a class.
            prefix = types.at(types.unqualified(scope.at(binding).*.ty)).*.name
            qualified = true
            at = tokens.next(tokens.next(at))
            continue
        }
        if !qualified && tokens.is(tokens.next(at), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind != scope.NAMESPACE { binding = scope.findKind(name, scope.NAMESPACE) }
        if template.isClassTemplate(binding) && tokens.is(tokens.next(at), names.P_LT) {
            // `vector<int>`, `vector<int>::iterator`: the instance, read
            // here when the name is at the cursor (1 stands for a type
            // name elsewhere, where the arguments cannot be read).
            if token != cursor.peek() { return 1 }
            const saved = cursor.save()
            cursor.restore(at)
            const ty = template.classTypeHere(binding)
            const after = cursor.peek()
            cursor.restore(saved)
            if tokens.is(after, names.P_SCOPE) && types.kind(ty) != types.TPARAM {
                prefix = types.at(ty).*.name
                qualified = true
                at = tokens.next(after)
                continue
            }
            if tokens.is(after, names.P_SCOPE) && types.kind(ty) == types.TPARAM && tokens.kind(tokens.next(after)) == tokens.IDENT {
                // `remove_reference<T>::type` in a pattern: resolved in
                // the instance.
                typedefEnd = tokens.next(tokens.next(after))
                return types.dependentMember(ty, tokens.name(tokens.next(after)))
            }
            typedefEnd = after
            return ty
        }
        if tokens.is(tokens.next(at), names.P_SCOPE) && !qualified && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && types.kind(scope.at(binding).*.ty) == types.TPARAM && tokens.kind(tokens.next(tokens.next(at))) == tokens.IDENT {
            // `T::iterator` in a pattern: resolved in the instance.
            typedefEnd = tokens.next(tokens.next(tokens.next(at)))
            return types.dependentMember(scope.at(binding).*.ty, tokens.name(tokens.next(tokens.next(at))))
        }
        if tokens.is(tokens.next(at), names.P_SCOPE) {
            if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE { return 0 }
            prefix = @intCast(u32, scope.at(binding).*.value)
            qualified = true
            at = tokens.next(tokens.next(at))
            continue
        }
        if qualified {
            if binding == 0 { binding = cpp.findInherited(prefix, name, false) }
            if binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF { return scope.at(binding).*.ty }
            // A struct, class or enum of the namespace is a type name too.
            var tag = scope.findQualified(prefix, name, true)
            if tag == 0 { tag = cpp.findInherited(prefix, name, true) }
            if tag != 0 { return scope.at(tag).*.ty }
            if sfinae && binding == 0 {
                sfinaeFailed = true
                typedefEnd = tokens.next(at)
                return types.intOf()
            }
            return 0
        }
        // The class's own name inside it names the class.
        const injected = cpp.injectedClass(name)
        if injected != 0 { return injected }
        const typedef_type = scope.typedefOf(name)
        if typedef_type != 0 { return typedef_type }
        // In C++ a struct's, class's or enum's name is a type name by
        // itself, unless a variable or function hides it (a class's
        // constructor, named like the class, does not).
        if binding != 0 && scope.at(binding).*.kind != scope.NAMESPACE {
            const b = scope.at(binding)
            if !(b.*.kind == scope.VARIABLE && ast.obj(b.*.obj).*.isConstructor) { return 0 }
        }
        const tag = scope.findTag(name)
        if tag != 0 { return scope.at(tag).*.ty }
        return 0
    }
    return 0
}

// C++: whether a qualified name starts here: `::x`, `N::x`,
// `vector<int>::x`.
pub fn startsQualified() -> bool {
    if cursor.is(names.P_SCOPE) { return true }
    if !cursor.isIdent() { return false }
    if cursor.isToken(cursor.peekNext(), names.P_SCOPE) { return true }
    if cursor.isToken(cursor.peekNext(), names.P_LT) && template.isClassTemplate(scope.findKind(tokens.name(cursor.peek()), scope.TEMPLATE)) {
        const after = template.endOfArguments(cursor.peekNext())
        return after != 0 && tokens.is(after, names.P_SCOPE)
    }
    return false
}

// C++: reads a qualifier `N::M::`, `vector<int>::` (or a leading `::`)
// here, if any: the prefix it names (0 for the global namespace), and
// whether one was read.
pub fn qualifier() -> (u32, bool) {
    var prefix: u32 = 0
    var qualified = false
    if cursor.is(names.P_SCOPE) {
        cursor.advance()
        qualified = true
    }
    while cursor.isIdent() {
        const name = tokens.name(cursor.peek())
        var binding = if qualified { scope.findQualified(prefix, name, false) } else { scope.find(name) }
        if !qualified && cursor.isToken(cursor.peekNext(), names.P_LT) { binding = scope.findKind(name, scope.TEMPLATE) }
        if cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind == scope.TYPEDEF && cpp.isClassType(scope.at(binding).*.ty) {
            // `B::value`, B a typedef of a class (a template parameter).
            prefix = types.at(types.unqualified(scope.at(binding).*.ty)).*.name
            qualified = true
            cursor.advance()
            cursor.advance()
            continue
        }
        if !qualified && cursor.isToken(cursor.peekNext(), names.P_SCOPE) && binding != 0 && scope.at(binding).*.kind != scope.NAMESPACE { binding = scope.findKind(name, scope.NAMESPACE) }
        if cursor.isToken(cursor.peekNext(), names.P_LT) && template.isClassTemplate(binding) {
            const after = template.endOfArguments(cursor.peekNext())
            if after == 0 || !tokens.is(after, names.P_SCOPE) { break }
            const ty = template.classTypeHere(binding)
            if types.kind(ty) == types.TPARAM { cursor.fail("a dependent qualified name is not supported here") }
            cursor.expect(names.P_SCOPE)
            prefix = types.at(ty).*.name
            qualified = true
            continue
        }
        if !cursor.isToken(cursor.peekNext(), names.P_SCOPE) { break }
        if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE {
            if sfinae {
                sfinaeFailed = true
                qualified = true
                cursor.advance()
                cursor.advance()
                continue
            }
            cursor.fail("not a namespace")
        }
        prefix = @intCast(u32, scope.at(binding).*.value)
        qualified = true
        cursor.advance()
        cursor.advance()
    }
    return -> (prefix, qualified)
}

// Passes balanced parentheses starting at the `(` here.
pub fn skipParentheses() -> void {
    cursor.expect(names.P_LPAREN)
    var level: u32 = 1
    while level > 0 {
        if cursor.isEof() { cursor.fail("unterminated parenthesis") }
        if cursor.is(names.P_LPAREN) { level += 1 }
        if cursor.is(names.P_RPAREN) { level -= 1 }
        cursor.advance()
    }
}

// GNU attributes here (any number of them): whether one said `packed`,
// and the alignment one asked for (0: none).
pub fn attributes() -> (bool, i64) {
    var isPacked = false
    var alignment: i64 = 0
    while cursor.is(names.K_GNU2_ATTRIBUTE) {
        cursor.advance()
        cursor.expect(names.P_LPAREN)
        cursor.expect(names.P_LPAREN)
        while !cursor.consume(names.P_RPAREN) {
            if cursor.isEof() { cursor.fail("unterminated attribute") }
            if !cursor.consume(names.P_COMMA) {
                const name = tokens.name(cursor.peek())
                cursor.advance()
                if name == packedName || name == packedName2 {
                    isPacked = true
                } else if name == alignedName || name == alignedName2 {
                    if cursor.consume(names.P_LPAREN) {
                        alignment = eval.constExpression()
                        cursor.expect(names.P_RPAREN)
                    } else {
                        alignment = 16
                    }
                } else if cursor.is(names.P_LPAREN) {
                    skipParentheses()
                }
            }
        }
        cursor.expect(names.P_RPAREN)
    }
    return -> (isPacked, alignment)
}

// Passes C23's [[attributes]] here (any number of them).
pub fn stdAttributes() -> void {
    while cursor.is(names.P_LBRACKET) && cursor.isToken(cursor.peekNext(), names.P_LBRACKET) {
        cursor.advance()
        cursor.advance()
        var level: u32 = 2
        while level > 0 {
            if cursor.isEof() { cursor.fail("unterminated attribute") }
            if cursor.is(names.P_LBRACKET) { level += 1 }
            if cursor.is(names.P_RBRACKET) { level -= 1 }
            cursor.advance()
        }
    }
}

// Passes attributes and an asm label (`__asm__("name")`) after a
// declarator.
fn afterDeclarator() -> void {
    const ignored = attributes()
    if cursor.is(names.K_ASM) || cursor.is(names.K_GNU2_ASM) {
        cursor.advance()
        skipParentheses()
    }
    const more = attributes()
    stdAttributes()
}

fn typeOfCounter(counter: u32) -> usize {
    if counter & S_BITINT != 0 {
        if counter & ~(S_BITINT | S_SIGNED | S_UNSIGNED) != 0 { return 0 }
        return types.bitIntOf(bitIntWidth, counter & S_UNSIGNED != 0)
    }
    if counter == S_VOID { return types.voidOf() }
    if counter == S_BOOL { return types.boolOf() }
    if counter == S_CHAR || counter == S_SIGNED + S_CHAR { return types.charOf() }
    if counter == S_UNSIGNED + S_CHAR { return types.ucharOf() }
    if counter == S_SHORT || counter == S_SHORT + S_INT || counter == S_SIGNED + S_SHORT || counter == S_SIGNED + S_SHORT + S_INT { return types.shortOf() }
    if counter == S_UNSIGNED + S_SHORT || counter == S_UNSIGNED + S_SHORT + S_INT { return types.ushortOf() }
    if counter == S_INT || counter == S_SIGNED || counter == S_SIGNED + S_INT { return types.intOf() }
    if counter == S_UNSIGNED || counter == S_UNSIGNED + S_INT { return types.uintOf() }
    if counter == S_LONG || counter == S_LONG + S_INT || counter == S_LONG + S_LONG || counter == S_LONG + S_LONG + S_INT { return types.longOf() }
    if counter == S_SIGNED + S_LONG || counter == S_SIGNED + S_LONG + S_INT || counter == S_SIGNED + S_LONG + S_LONG || counter == S_SIGNED + S_LONG + S_LONG + S_INT { return types.longOf() }
    if counter == S_UNSIGNED + S_LONG || counter == S_UNSIGNED + S_LONG + S_INT || counter == S_UNSIGNED + S_LONG + S_LONG || counter == S_UNSIGNED + S_LONG + S_LONG + S_INT { return types.ulongOf() }
    if counter == S_FLOAT { return types.floatOf() }
    if counter == S_DOUBLE { return types.doubleOf() }
    if counter == S_LONG + S_DOUBLE { return types.ldoubleOf() }
    return 0
}

fn specifierBit(id: u32) -> u32 {
    if id == names.K_VOID { return S_VOID }
    if id == names.K_BOOL { return S_BOOL }
    if id == names.K_CHAR { return S_CHAR }
    if id == names.K_SHORT { return S_SHORT }
    if id == names.K_INT { return S_INT }
    if id == names.K_LONG { return S_LONG }
    if id == names.K_FLOAT { return S_FLOAT }
    if id == names.K_DOUBLE { return S_DOUBLE }
    if id == names.K_SIGNED || id == names.K_GNU2_SIGNED { return S_SIGNED }
    if id == names.K_UNSIGNED { return S_UNSIGNED }
    return 0
}

// declaration-specifiers: the type they make; the storage class and
// alignment go to `attr` (0 where none is allowed).
pub fn declspec(attr: usize) -> usize {
    var sawAuto = false
    var ty = types.intOf()
    var counter: u32 = 0
    var isConst = false
    while isTypename(cursor.peek()) {
        const token = cursor.peek()
        const id = tokens.name(token)
        const keyword = tokens.kind(token) == tokens.KEYWORD
        if keyword && (id == names.K_CONST || id == names.K_GNU_CONST) { isConst = true }
        if keyword && isStorageClass(id) {
            if attr == 0 { cursor.fail("storage class specifier is not allowed in this context") }
            const a = attrAt(attr)
            if id == names.K_TYPEDEF { a.*.isTypedef = true }
            if id == names.K_STATIC { a.*.isStatic = true }
            if id == names.K_EXTERN { a.*.isExtern = true }
            if id == names.K_INLINE || id == names.K_GNU_INLINE || id == names.K_GNU2_INLINE { a.*.isInline = true }
            if id == names.K_THREAD_LOCAL || id == names.K_GNU_THREAD { a.*.isThreadLocal = true }
            if a.*.isTypedef && (a.*.isStatic || a.*.isExtern || a.*.isInline || a.*.isThreadLocal) {
                cursor.fail("typedef may not be used together with static, extern, inline, __thread or _Thread_local")
            }
            cursor.advance()
        } else if keyword && (id == names.K_CONSTEXPR || id == names.K_AUTO) {
            if attr != 0 {
                if id == names.K_CONSTEXPR { attrAt(attr).*.isConstexpr = true } else { attrAt(attr).*.isAuto = true }
            }
            if id == names.K_AUTO { sawAuto = true }
            cursor.advance()
        } else if keyword && isIgnoredQualifier(id) {
            cursor.advance()
        } else if keyword && id == names.K_ATOMIC {
            cursor.advance()
            if cursor.consume(names.P_LPAREN) {
                ty = typeName()
                cursor.expect(names.P_RPAREN)
                counter += S_OTHER
            }
        } else if keyword && id == names.K_GNU2_ATTRIBUTE {
            const found = attributes()
            if attr != 0 && found.1 > 0 { attrAt(attr).*.alignment = found.1 }
        } else if keyword && id == names.K_ALIGNAS {
            if attr == 0 { cursor.fail("_Alignas is not allowed in this context") }
            cursor.advance()
            cursor.expect(names.P_LPAREN)
            if isTypename(cursor.peek()) {
                attrAt(attr).*.alignment = types.alignOf(typeName())
            } else {
                attrAt(attr).*.alignment = eval.constExpression()
            }
            cursor.expect(names.P_RPAREN)
        } else if keyword && (id == names.K_EXPLICIT || id == names.K_VIRTUAL || id == names.K_MUTABLE || id == names.K_FRIEND || id == names.K_TYPENAME) {
            if id == names.K_VIRTUAL && attr != 0 { attrAt(attr).*.isVirtual = true }
            cursor.advance()
        } else {
            var defined: usize = 0
            const qualified = standard.cpp && (tokens.is(token, names.P_SCOPE) || (!keyword && cursor.isToken(cursor.peekNext(), names.P_SCOPE)))
            if !keyword && !qualified { defined = if standard.cpp { qualifiedTypedef(token) } else { scope.typedefOf(id) } }
            if qualified { defined = qualifiedTypedef(token) }
            if defined == 1 { cursor.fail("internal error: a template type name away from the cursor") }
            const user = defined != 0 || id == names.K_STRUCT || id == names.K_CLASS || id == names.K_UNION || id == names.K_ENUM || id == names.K_TYPEOF || id == names.K_GNU2_TYPEOF || id == names.K_TYPEOF_UNQUAL || id == names.K_GNU_BUILTIN_VA_LIST || id == names.K_WCHAR_T || id == names.K_CHAR16_T || id == names.K_CHAR32_T || id == names.K_DECLTYPE || id == names.K_UNDERLYING_TYPE
            if user {
                // `int T` where T is a typedef name declares T.
                if counter != 0 { break }
                if standard.cpp && defined != 0 {
                    // The whole (qualified, template) name.
                    cursor.restore(typedefEnd)
                } else {
                    cursor.advance()
                }
                if id == names.K_STRUCT || id == names.K_CLASS {
                    ty = structUnionDeclaration(false)
                } else if id == names.K_UNION {
                    ty = structUnionDeclaration(true)
                } else if id == names.K_ENUM {
                    ty = enumSpecifier()
                } else if id == names.K_TYPEOF || id == names.K_GNU2_TYPEOF || id == names.K_TYPEOF_UNQUAL {
                    ty = typeofSpecifier()
                } else if id == names.K_GNU_BUILTIN_VA_LIST {
                    ty = vaListType
                } else if id == names.K_WCHAR_T || id == names.K_CHAR32_T {
                    ty = if id == names.K_WCHAR_T { types.intOf() } else { types.uintOf() }
                } else if id == names.K_CHAR16_T {
                    ty = types.ushortOf()
                } else if id == names.K_DECLTYPE {
                    ty = typeofSpecifier()
                } else if id == names.K_UNDERLYING_TYPE {
                    ty = underlyingTypeSpecifier()
                } else {
                    ty = defined
                }
                counter += S_OTHER
            } else {
                var bit = specifierBit(id)
                if id == names.K_BITINT {
                    // _BitInt(N), N a constant from 1 (unsigned) or 2 to
                    // BITINT_MAXWIDTH (above 64: limbs in memory).
                    cursor.advance()
                    cursor.expect(names.P_LPAREN)
                    bitIntWidth = eval.constExpression()
                    if bitIntWidth < 1 || bitIntWidth > types.MAX_BITINT { cursor.fail("_BitInt widths from 1 to 4096 are supported") }
                    bit = S_BITINT
                    counter += bit
                    ty = typeOfCounter(counter)
                    if ty == 0 { cursor.fail("invalid type") }
                    cursor.expect(names.P_RPAREN)
                    continue
                }
                if bit == 0 { break }
                counter += bit
                ty = typeOfCounter(counter)
                if ty == 0 { cursor.fail("invalid type") }
                cursor.advance()
            }
        }
    }
    if attr != 0 { attrAt(attr).*.hasType = counter != 0 }
    // C++'s `auto` without a type: a placeholder, taken from the
    // initializer (localDeclaration), the trailing return type
    // (`auto f() -> T`) or the first return (`auto f() { ... }`).
    if sawAuto && counter == 0 && standard.cpp { ty = types.autoResult() }
    if isConst && standard.cpp { ty = types.constOf(ty) }
    return ty
}

pub fn vaList() -> usize { return vaListType }

// C23's `auto x = value`: the type of the initializer after the `=`
// here (arrays and functions decayed); the cursor stays at the `=`.
fn inferredType() -> usize {
    if !cursor.is(names.P_ASSIGN) { cursor.fail("auto needs an initializer to take its type from") }
    const start = cursor.save()
    cursor.advance()
    const e = expr.assign()
    typing.addType(e)
    cursor.restore(start)
    var ty = ast.typeOf(e)
    if types.kind(ty) == types.ARRAY { ty = types.pointerTo(types.baseOf(ty)) }
    if types.kind(ty) == types.FUNC { ty = types.pointerTo(ty) }
    return ty
}

// C23's `constexpr int N = value`: an integer constant, bound like an
// enumerator with its declared type; whether this declaration was one.
pub fn constexprConstant(ty: usize, token: usize) -> bool {
    if !types.isInteger(ty) || !cursor.consume(names.P_ASSIGN) { return false }
    const value = eval.constExpression()
    const bound = scope.bindEnumConstant(tokens.name(token), ty, value)
    return true
}

// `__underlying_type(E)`: the integer type the enum E is stored as.
fn underlyingTypeSpecifier() -> usize {
    cursor.expect(names.P_LPAREN)
    const ty = typeName()
    cursor.expect(names.P_RPAREN)
    return types.underlyingOf(ty)
}

fn typeofSpecifier() -> usize {
    cursor.expect(names.P_LPAREN)
    var ty: usize = 0
    if isTypename(cursor.peek()) {
        ty = typeName()
    } else {
        // The expression is not evaluated: what it calls need not exist.
        expr.unevaluated += 1
        const n = expr.expression()
        typing.addType(n)
        expr.unevaluated -= 1
        ty = ast.typeOf(n)
    }
    cursor.expect(names.P_RPAREN)
    return ty
}

// Pointers with their qualifiers; in C++ a reference after them.
fn pointers(start: usize) -> usize {
    var ty = pointersOnly(start)
    if standard.cpp && cursor.consume(names.P_AMP) {
        ty = types.referenceTo(ty)
        while cursor.consume(names.K_CONST) || cursor.consume(names.K_VOLATILE) {}
    } else if standard.cpp && cursor.consume(names.P_ANDAND) {
        ty = types.rvalueReferenceTo(ty)
        while cursor.consume(names.K_CONST) || cursor.consume(names.K_VOLATILE) {}
    }
    return ty
}

pub fn pointersOnly(start: usize) -> usize {
    var ty = start
    while cursor.consume(names.P_STAR) {
        ty = types.pointerTo(ty)
        while true {
            const id = tokens.name(cursor.peek())
            if tokens.kind(cursor.peek()) != tokens.KEYWORD { break }
            if id == names.K_CONST || id == names.K_GNU_CONST || id == names.K_VOLATILE || id == names.K_GNU2_VOLATILE || id == names.K_RESTRICT || id == names.K_GNU_RESTRICT || id == names.K_GNU2_RESTRICT || id == names.K_ATOMIC {
                if standard.cpp && (id == names.K_CONST || id == names.K_GNU_CONST) { ty = types.constOf(ty) }
                cursor.advance()
            } else if id == names.K_GNU2_ATTRIBUTE {
                const ignored = attributes()
            } else {
                break
            }
        }
    }
    return ty
}

// Whether the `(` here opens a parameter list rather than a nested
// declarator (in an abstract declarator: `int (int)`, `int ()`).
fn opensParameters() -> bool {
    const next = cursor.peekNext()
    const seen = scope.packSeen
    const startsType = isTypename(next)
    scope.packSeen = seen
    return startsType || cursor.isToken(next, names.P_RPAREN)
}

// A declarator for a value of type `start`: its type and its name token
// (0 for an abstract one).
pub fn declarator(start: usize) -> (usize, usize) {
    var ty = pointers(start)
    if cursor.is(names.P_LPAREN) && !opensParameters() {
        // `T (D) suffix`: the suffix applies before D does.
        cursor.advance()
        const inner = cursor.save()
        const skipped = declarator(types.intOf())
        cursor.expect(names.P_RPAREN)
        ty = typeSuffix(ty)
        const after = cursor.save()
        cursor.restore(inner)
        const result = declarator(ty)
        cursor.restore(after)
        return -> (result.0, result.1)
    }
    var name: usize = 0
    var prefix: u32 = 0
    if standard.cpp && startsQualified() {
        // `N::f`, `vector<T>::f`: declared in that namespace (or class).
        const read = qualifier()
        prefix = read.0
    }
    if cursor.isIdent() {
        name = cursor.peek()
        cursor.advance()
    } else if standard.cpp && cursor.is(names.K_OPERATOR) {
        name = cpp.operatorNameToken()
        const conversion = cpp.takeConversionType()
        if conversion != 0 {
            // `operator T()`: a function returning T.
            ty = typeSuffix(ty)
            if types.kind(ty) != types.FUNC { tokens.errorAt(name, "a conversion operator takes a parameter list") }
            types.at(ty).*.base = conversion
            declaratorPrefix = prefix
            return -> (ty, name)
        }
    } else if standard.cpp && cursor.is(names.P_TILDE) && tokens.kind(cursor.peekNext()) == tokens.IDENT {
        // `S::~S`: the destructor's name.
        const tilde = cursor.peek()
        cursor.advance()
        name = tokens.copy(cursor.peek())
        tokens.at(name).*.name = base.intern(base.join("~", base.nameOf(tokens.name(cursor.peek()))))
        cursor.advance()
    }
    // `S::f(Mode m)`: the parameters see the class's names (unless
    // they do already: a member template instance's are bound below
    // the class).
    const entered = prefix != 0 && !scope.isWithin(prefix)
    if entered { scope.enterPrefix(prefix) }
    ty = typeSuffix(ty)
    if entered { scope.leaveNamespace() }
    // After the suffix: the parameters' declarators set it too.
    declaratorPrefix = prefix
    return -> (ty, name)
}

// C++: whether the `(` here opens a nested abstract declarator
// (`(*)(int)`, `(&)[3]`) rather than a functional cast's arguments
// (`void(0)`, `T(x)`), which end the type.
fn opensNestedDeclarator() -> bool {
    if !standard.cpp { return true }
    const next = cursor.peekNext()
    return cursor.isToken(next, names.P_STAR) || cursor.isToken(next, names.P_AMP) || cursor.isToken(next, names.P_ANDAND) || cursor.isToken(next, names.P_LPAREN) || cursor.isToken(next, names.P_LBRACKET)
}

pub fn abstractDeclarator(start: usize) -> usize {
    var ty = pointers(start)
    if cursor.is(names.P_LPAREN) && !opensParameters() && !opensNestedDeclarator() { return ty }
    if cursor.is(names.P_LPAREN) && !opensParameters() {
        cursor.advance()
        const inner = cursor.save()
        const skipped = abstractDeclarator(types.intOf())
        cursor.expect(names.P_RPAREN)
        ty = typeSuffix(ty)
        const after = cursor.save()
        cursor.restore(inner)
        const result = abstractDeclarator(ty)
        cursor.restore(after)
        return result
    }
    return typeSuffix(ty)
}

pub fn typeName() -> usize {
    return abstractDeclarator(declspec(0))
}

fn typeSuffix(ty: usize) -> usize {
    if standard.cpp && cursor.is(names.P_LPAREN) {
        // `T x(args)` is an initializer, not a function, when the
        // parenthesis holds an expression (a look ahead: a pack named
        // there is not an expansion's).
        const next = cursor.peekNext()
        const seen = scope.packSeen
        const startsType = isTypename(next)
        scope.packSeen = seen
        if !cursor.isToken(next, names.P_RPAREN) && !cursor.isToken(next, names.P_ELLIPSIS) && !startsType { return ty }
        if startsType && holdsExpression() { return ty }
    }
    if cursor.consume(names.P_LPAREN) { return functionParameters(ty) }
    if cursor.consume(names.P_LBRACKET) { return arrayDimensions(ty) }
    return ty
}

// Whether the parenthesis at the cursor holds an initializer rather
// than parameters: `(Tag(), 3)` has an item that starts with a
// literal, or with a name that is no type (`(Tag(), v)`).
fn holdsExpression() -> bool {
    var t = tokens.next(cursor.peek())
    var level: i64 = 0
    var itemStart = true
    while !tokens.isEof(t) {
        if level == 0 && tokens.is(t, names.P_RPAREN) { return false }
        if tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE) { return false }
        if itemStart {
            const kind = tokens.kind(t)
            if kind == tokens.NUMBER || kind == tokens.CHAR || kind == tokens.STRING || kind == tokens.INTEGER || kind == tokens.FLOATING { return true }
            if kind == tokens.IDENT && !tokens.is(tokens.next(t), names.P_SCOPE) {
                const seen = scope.packSeen
                const named = isTypename(t)
                scope.packSeen = seen
                if !named { return true }
            }
            // `T<args>("x")`, `T("x")`: a type followed by a parenthesized
            // literal is a functional cast, not a parameter.
            var after = t
            while tokens.is(after, names.P_SCOPE) || tokens.kind(after) == tokens.IDENT || tokens.kind(after) == tokens.KEYWORD {
                after = tokens.next(after)
                if tokens.is(after, names.P_LT) {
                    after = template.endOfArguments(after)
                    if after == 0 { return false }
                }
            }
            if tokens.is(after, names.P_LPAREN) {
                const inner = tokens.kind(tokens.next(after))
                if inner == tokens.NUMBER || inner == tokens.CHAR || inner == tokens.STRING || inner == tokens.INTEGER || inner == tokens.FLOATING { return true }
            }
        }
        itemStart = level == 0 && tokens.is(t, names.P_COMMA)
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LT) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_GT) { level -= 1 }
        t = tokens.next(t)
    }
    return false
}

pub fn functionParameters(result: usize) -> usize {
    const fnType = types.functionReturning(result)
    if cursor.is(names.K_VOID) && cursor.isToken(cursor.peekNext(), names.P_RPAREN) {
        cursor.advance()
        cursor.advance()
        if standard.cpp { finishParameters(fnType) }
        return fnType
    }
    if cursor.consume(names.P_RPAREN) {
        // C++'s `f()` takes nothing; C's is an old-style declaration.
        if !standard.cpp { types.at(fnType).*.oldStyle = true }
        if standard.cpp { finishParameters(fnType) }
        return fnType
    }
    var head: usize = 0
    var tail: usize = 0
    // A pack's name stands for the pack itself here (`Args &&... args`
    // expanded below), not an element.
    const outerPlaceholders = scope.packPlaceholders
    scope.packPlaceholders = standard.cpp
    while true {
        if cursor.consume(names.P_ELLIPSIS) {
            types.at(fnType).*.variadic = true
            cursor.expect(names.P_RPAREN)
            break
        }
        stdAttributes()
        const start = cursor.peek()
        const found = declarator(declspec(0))
        const ignored = attributes()
        var pty = found.0
        // Arrays and functions as parameters are pointers (C11 6.7.6.3).
        if types.kind(pty) == types.ARRAY { pty = types.pointerTo(types.baseOf(pty)) }
        if types.kind(pty) == types.FUNC { pty = types.pointerTo(pty) }
        const name: u32 = if found.1 != 0 { tokens.name(found.1) } else { 0 }
        const p = types.newParam(pty, name, if found.1 != 0 { found.1 } else { start })
        // C++: `Args &&... args`, a parameter pack (the `...` may also
        // come after the name).
        var packHolder: usize = 0
        if standard.cpp && cursor.consume(names.P_ELLIPSIS) {
            types.param(p).*.isPack = true
            if found.1 == 0 && cursor.isIdent() {
                types.param(p).*.name = tokens.name(cursor.peek())
                types.param(p).*.token = cursor.peek()
                cursor.advance()
            }
            packHolder = types.boundPackIn(pty)
        }
        if standard.cpp && cursor.consume(names.P_ASSIGN) {
            // A default argument (C++).
            types.param(p).*.defaultValue = expr.assign()
        }
        if packHolder != 0 {
            // `Args &&... args` in an instance: a parameter per element
            // of the pack, named `args#0`, `args#1`, ... and known
            // together as `args` (functionDefinition).
            if types.packCount(packHolder) == 0 && types.param(p).*.name != 0 {
                const e = base.alloc(16)
                base.putWord(e, @intCast(usize, types.param(p).*.name))
                base.putWord(e + 8, types.at(fnType).*.emptyPacks)
                types.at(fnType).*.emptyPacks = e
            }
            var index: i64 = 0
            while index < types.packCount(packHolder) {
                const element = types.packTypeAt(packHolder, index)
                const name = base.intern(base.join(base.join(base.nameOf(types.param(p).*.name), "#"), base.decimal(@intCast(u64, index))))
                const q = types.newParam(types.substitutePack(pty, element), name, types.param(p).*.token)
                types.param(q).*.packName = types.param(p).*.name
                if head == 0 { head = q } else { types.param(tail).*.next = q }
                tail = q
                index += 1
            }
        } else {
            if head == 0 { head = p } else { types.param(tail).*.next = p }
            tail = p
        }
        if cursor.consume(names.P_RPAREN) { break }
        cursor.expect(names.P_COMMA)
    }
    scope.packPlaceholders = outerPlaceholders
    types.at(fnType).*.params = head
    if standard.cpp { finishParameters(fnType) }
    return fnType
}

// C++: what follows a parameter list: the qualifiers (`const`,
// `noexcept`, `override`), a trailing return type (`auto f() -> T`),
// a requires clause (kept for the template, template.mlx).
fn finishParameters(fnType: usize) -> void {
    if cpp.trailingQualifiers() { types.at(fnType).*.constMethod = true }
    if cursor.consume(names.P_ARROW) {
        // The trailing return type may name the parameters
        // (`-> decltype(x / 2)`): bound meanwhile.
        scope.enter()
        var p = types.at(fnType).*.params
        while p != 0 {
            if types.param(p).*.name != 0 {
                const o = ast.newObj(types.param(p).*.name, types.param(p).*.ty, types.param(p).*.token)
                ast.obj(o).*.isLocal = true
                const bound = scope.bindVariable(types.param(p).*.name, o)
            }
            p = types.param(p).*.next
        }
        // In a template's pattern a dependent expression (`c.begin()`
        // on a placeholder) is no error: the type is read again on
        // instantiation.
        const outerSfinae = sfinae
        const outerFailed = sfinaeFailed
        if template.inPattern() { sfinae = true }
        types.at(fnType).*.base = typeName()
        if template.inPattern() {
            sfinae = outerSfinae
            sfinaeFailed = outerFailed
        }
        scope.leave()
        if cpp.trailingQualifiers() { types.at(fnType).*.constMethod = true }
    }
    if cursor.is(names.K_REQUIRES) { template.trailingRequires() }
}

// Whether two function types declare the same function (the same
// parameters: a C++ overload differs in them).
pub fn sameSignature(first: usize, second: usize) -> bool {
    if types.at(first).*.variadic != types.at(second).*.variadic { return false }
    if types.at(first).*.constMethod != types.at(second).*.constMethod { return false }
    var p = types.at(first).*.params
    var q = types.at(second).*.params
    while p != 0 && q != 0 {
        if !types.compatible(types.param(p).*.ty, types.param(q).*.ty) { return false }
        if standard.cpp && !types.sameType(types.unqualified(types.param(p).*.ty), types.unqualified(types.param(q).*.ty)) { return false }
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
    return p == 0 && q == 0
}

fn arrayDimensions(element: usize) -> usize {
    while cursor.consume(names.K_STATIC) || cursor.consume(names.K_RESTRICT) || cursor.consume(names.K_GNU_RESTRICT) || cursor.consume(names.K_CONST) || cursor.consume(names.K_VOLATILE) {}
    if cursor.consume(names.P_RBRACKET) {
        return types.arrayOf(typeSuffix(element), -1)
    }
    // C++: `T[N]` in a template's pattern, N one of its parameters.
    const bound = if standard.cpp { template.patternArrayBound() } else { 0 }
    if bound != 0 {
        cursor.advance()
        cursor.expect(names.P_RBRACKET)
        return types.arrayOf(typeSuffix(element), bound)
    }
    const length = eval.constExpression()
    if length < 0 { cursor.fail("size of array is negative") }
    cursor.expect(names.P_RBRACKET)
    return types.arrayOf(typeSuffix(element), length)
}

// Whether the last struct, union or class specifier read had a tag: a
// member declaration of one without a declarator is then a nested
// class (C++) rather than an anonymous struct or union.
var lastSpecifierTagged = false

// struct-or-union-specifier, after the keyword.
fn structUnionDeclaration(isUnion: bool) -> usize {
    const ty = structUnionSpecifier(isUnion)
    lastSpecifierTagged = types.at(ty).*.name != 0 && !cpp.isAnonymousClass(ty)
    return ty
}

fn structUnionSpecifier(isUnion: bool) -> usize {
    const leading = attributes()
    stdAttributes()
    var isPacked = leading.0
    var alignment = leading.1
    var tag: usize = 0
    var tagName: u32 = 0
    if cursor.isIdent() {
        tag = cursor.peek()
        tagName = tokens.name(tag)
        cursor.advance()
    }
    // A class template's instance is named by its arguments (template.mlx).
    if standard.cpp && tag != 0 {
        const override = template.takeTagOverride()
        if override != 0 { tagName = override }
    }
    const kind = if isUnion { types.UNION } else { types.STRUCT }
    if tag != 0 && !cursor.is(names.P_LBRACE) && !(standard.cpp && cursor.is(names.P_COLON)) {
        const found = scope.findTag(tagName)
        if found != 0 {
            const known = scope.at(found).*.ty
            if types.kind(known) != kind { tokens.errorAt(tag, "tag used with the wrong kind of type") }
            return known
        }
        const declared = types.structType()
        types.at(declared).*.kind = kind
        types.at(declared).*.name = scope.qualify(scope.currentNamespace(), tagName)
        const bound = scope.bindTag(tagName, declared)
        return declared
    }
    var ty: usize = 0
    if standard.cpp && tag != 0 {
        // A C++ class: the one declared before (`class S;`) is completed
        // in place; a new one is bound before its members, which may
        // name it.
        const here = scope.findTagHere(tagName)
        if here != 0 {
            ty = scope.at(here).*.ty
            if types.kind(ty) != kind { tokens.errorAt(tag, "tag used with the wrong kind of type") }
            if !types.at(ty).*.incomplete { tokens.errorAt(tag, "redefinition of a class") }
        } else {
            ty = types.structType()
            types.at(ty).*.kind = kind
            types.at(ty).*.name = scope.qualify(scope.currentNamespace(), tagName)
            const bound = scope.bindTag(tagName, ty)
        }
    } else {
        ty = types.structType()
        types.at(ty).*.kind = kind
        if tag != 0 { types.at(ty).*.name = scope.qualify(scope.currentNamespace(), tagName) }
    }
    if standard.cpp { cpp.beginClass(ty, if tag != 0 { tagName } else { 0 }, if tag != 0 { tokens.name(tag) } else { 0 }, cursor.peek()) }
    cursor.expect(names.P_LBRACE)
    structMembers(ty)
    if standard.cpp { cpp.finishMembers(ty) }
    const trailing = attributes()
    isPacked = isPacked || trailing.0
    if trailing.1 > alignment { alignment = trailing.1 }
    if isUnion { types.layoutUnion(ty) } else { types.layoutStruct(ty, isPacked) }
    if alignment > types.alignOf(ty) {
        types.at(ty).*.alignment = alignment
        types.at(ty).*.size = types.alignTo(types.size(ty), alignment)
    }
    types.at(ty).*.incomplete = false
    if standard.cpp {
        // An empty class has a size (1), as C++ says.
        if types.size(ty) == 0 { types.at(ty).*.size = 1 }
        types.syncConst(ty)
        cpp.completeClass(ty)
        return ty
    }
    if tag != 0 {
        const here = scope.findTagHere(tagName)
        if here != 0 {
            // The struct declared before (`struct S;`, or `struct S *` in
            // its own members) becomes this one, so every type naming it
            // sees it complete.
            const earlier = scope.at(here).*.ty
            if types.kind(earlier) != kind { tokens.errorAt(tag, "tag used with the wrong kind of type") }
            if !types.at(earlier).*.incomplete { tokens.errorAt(tag, "redefinition of a struct or union") }
            const twin = types.at(earlier).*.constVersion
            base.copy(earlier, ty, @sizeOf(types.Type))
            types.at(earlier).*.constVersion = twin
            types.syncConst(earlier)
            return earlier
        }
        const bound = scope.bindTag(tagName, ty)
    }
    return ty
}

fn structMembers(ty: usize) -> void {
    var head: usize = 0
    var tail: usize = 0
    var index: i64 = 0
    if standard.cpp {
        // The base class is the first member.
        head = cpp.baseMember(ty, cursor.peek())
        if head != 0 {
            tail = head
            index = 1
        }
    }
    while !cursor.consume(names.P_RBRACE) {
        if cursor.isEof() { cursor.fail("unterminated struct or union") }
        stdAttributes()
        if standard.cpp && cpp.specialMember(ty) {
            // An access specifier, a constructor, a destructor, a friend.
        } else if cursor.is(names.K_STATIC_ASSERT) {
            staticAssert()
        } else if !cursor.consume(names.P_SEMI) {
            const attr = newAttr()
            const memberBase = declspec(attr)
            const bk = types.kind(memberBase)
            if standard.cpp && attrAt(attr).*.isTypedef {
                // A typedef of the class's scope.
                parseTypedef(memberBase)
            } else if (bk == types.STRUCT || bk == types.UNION) && lastSpecifierTagged && cursor.consume(names.P_SEMI) {
                // A nested class, or a struct declared in the class: a
                // type of its scope, not a member.
            } else if (bk == types.STRUCT || bk == types.UNION) && cursor.consume(names.P_SEMI) {
                // An anonymous struct or union: its members are this
                // one's (C11 6.7.2.1).
                const m = types.newMember(memberBase, 0, cursor.peek())
                types.member(m).*.index = index
                types.member(m).*.alignment = attrAt(attr).*.alignment
                index += 1
                if head == 0 { head = m } else { types.member(tail).*.next = m }
                tail = m
            } else {
                var first = true
                while !cursor.consume(names.P_SEMI) {
                    if !first { cursor.expect(names.P_COMMA) }
                    first = false
                    const start = cursor.peek()
                    const isVirtual = attrAt(attr).*.isVirtual
                    const found = declarator(memberBase)
                    if standard.cpp && types.kind(found.0) == types.FUNC {
                        // A member function; its body, if any, ends the
                        // declaration.
                        if found.1 == 0 { tokens.errorAt(start, "member function name omitted") }
                        cpp.declaringConstexpr = attrAt(attr).*.isConstexpr
                        const hadBody = cpp.memberFunction(ty, found.0, found.1, tokens.name(found.1), attrAt(attr).*.isStatic, isVirtual, false, false)
                        cpp.declaringConstexpr = false
                        if hadBody { break }
                        continue
                    }
                    if standard.cpp && attrAt(attr).*.isStatic {
                        // A static data member: a global.
                        if found.1 == 0 { tokens.errorAt(start, "static member name omitted") }
                        cpp.staticMember(ty, found.0, found.1, attr)
                        continue
                    }
                    const name: u32 = if found.1 != 0 { tokens.name(found.1) } else { 0 }
                    const m = types.newMember(found.0, name, if found.1 != 0 { found.1 } else { start })
                    types.member(m).*.index = index
                    types.member(m).*.alignment = attrAt(attr).*.alignment
                    index += 1
                    if cursor.consume(names.P_COLON) {
                        const width = eval.constExpression()
                        if width < 0 || width > types.size(found.0) * 8 { tokens.errorAt(start, "invalid bit-field width") }
                        if width == 0 && name != 0 { tokens.errorAt(start, "named bit-field with zero width") }
                        types.member(m).*.bitWidth = if width == 0 { -1 } else { width }
                    }
                    const after = attributes()
                    if after.1 > types.member(m).*.alignment { types.member(m).*.alignment = after.1 }
                    if standard.cpp { cpp.memberInitializerTokens(m) }
                    if head == 0 { head = m } else { types.member(tail).*.next = m }
                    tail = m
                }
            }
        }
    }
    // A last member of array type without a size is a flexible array
    // member (C11 6.7.2.1).
    if tail != 0 {
        const last = types.member(tail).*.ty
        if types.kind(last) == types.ARRAY && types.at(last).*.arrayLength < 0 {
            types.member(tail).*.ty = types.arrayOf(types.baseOf(last), 0)
            types.at(ty).*.flexible = true
        }
    }
    types.at(ty).*.members = head
}

// enum-specifier, after the keyword.
fn enumSpecifier() -> usize {
    const ty = types.enumType()
    const leading = attributes()
    stdAttributes()
    // `enum class E` (C++): the enumerators are E::A, E::B.
    const scoped = standard.cpp && (cursor.consume(names.K_CLASS) || cursor.consume(names.K_STRUCT))
    var tag: usize = 0
    if cursor.isIdent() {
        tag = cursor.peek()
        cursor.advance()
    }
    if tag != 0 { types.at(ty).*.name = scope.qualify(scope.currentNamespace(), tokens.name(tag)) }
    if cursor.consume(names.P_COLON) {
        // A fixed underlying type (C23): `enum E : unsigned char`.
        const underlying = typeName()
        if !types.isInteger(underlying) || types.kind(underlying) == types.ENUM { cursor.fail("the underlying type of an enum must be an integer type") }
        types.at(ty).*.size = types.size(underlying)
        types.at(ty).*.alignment = types.alignOf(underlying)
        types.at(ty).*.unsigned = types.isUnsigned(underlying)
    }
    if tag != 0 && !cursor.is(names.P_LBRACE) {
        const found = scope.findTag(tokens.name(tag))
        if found == 0 {
            // A forward declaration (GNU): an enum to be completed.
            const bound = scope.bindTag(tokens.name(tag), ty)
            return ty
        }
        const known = scope.at(found).*.ty
        if types.kind(known) != types.ENUM { tokens.errorAt(tag, "not an enum tag") }
        return known
    }
    cursor.expect(names.P_LBRACE)
    var value: i64 = 0
    var first = true
    if scoped && tag != 0 {
        const prefix = scope.qualify(scope.currentNamespace(), tokens.name(tag))
        if scope.findHere(tokens.name(tag)) == 0 { const named = scope.bindNamespace(tokens.name(tag), prefix) }
        scope.enterPrefix(prefix)
    }
    while !cursor.consumeEnd() {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        const name = cursor.expectIdent()
        stdAttributes()
        const ignored = attributes()
        if cursor.consume(names.P_ASSIGN) { value = eval.constExpression() }
        const bound = scope.bindEnumConstant(tokens.name(name), ty, value)
        value = value +% 1
    }
    if scoped && tag != 0 { scope.leaveNamespace() }
    const trailing = attributes()
    if tag != 0 {
        const here = scope.findTagHere(tokens.name(tag))
        if here != 0 && types.kind(scope.at(here).*.ty) == types.ENUM { return scope.at(here).*.ty }
        const bound = scope.bindTag(tokens.name(tag), ty)
    }
    return ty
}

pub fn staticAssert() -> void {
    cursor.expect(names.K_STATIC_ASSERT)
    cursor.expect(names.P_LPAREN)
    const start = cursor.peek()
    const value = eval.constExpression()
    if cursor.consume(names.P_COMMA) {
        if tokens.kind(cursor.peek()) != tokens.STRING { cursor.fail("expected a string literal") }
        cursor.advance()
    }
    cursor.expect(names.P_RPAREN)
    cursor.expect(names.P_SEMI)
    if value == 0 { tokens.errorAt(start, "static assertion failed") }
}

pub fn parseTypedef(baseType: usize) -> void {
    var first = true
    while !cursor.consume(names.P_SEMI) {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        if standard.cpp && (cursor.is(names.K_WCHAR_T) || cursor.is(names.K_CHAR16_T) || cursor.is(names.K_CHAR32_T)) {
            // A C header's `typedef int wchar_t;`: a keyword in C++.
            cursor.advance()
            continue
        }
        const found = declarator(baseType)
        if found.1 == 0 { cursor.fail("typedef name omitted") }
        afterDeclarator()
        const bound = scope.bindTypedef(tokens.name(found.1), found.0)
        // The typedef names an anonymous struct or enum (for C++'s
        // mangled names).
        const k = types.kind(found.0)
        if (k == types.STRUCT || k == types.UNION || k == types.ENUM) && types.at(found.0).*.name == 0 {
            types.at(found.0).*.name = scope.qualify(scope.currentNamespace(), tokens.name(found.1))
        }
    }
}

// ---------------------------------------------------------------------------
// Objects

pub fn newLocal(name: u32, ty: usize, token: usize) -> usize {
    const o = ast.newObj(name, ty, token)
    ast.obj(o).*.isLocal = true
    ast.obj(o).*.alignment = types.alignOf(ty)
    state.addLocal(o)
    if name != 0 { const bound = scope.bindVariable(name, o) }
    return o
}

// A global without a name of its own (a string literal, a compound
// literal at file scope, a static local's storage).
pub fn newAnonymousGlobal(ty: usize, token: usize) -> usize {
    const o = ast.newObj(0, ty, token)
    ast.obj(o).*.isStatic = true
    ast.obj(o).*.isDefinition = true
    ast.obj(o).*.alignment = types.alignOf(ty)
    state.addGlobal(o)
    return o
}

pub fn stringLiteral(token: usize) -> usize {
    const o = newAnonymousGlobal(tokens.at(token).*.ty, token)
    ast.obj(o).*.isLiteral = true
    ast.obj(o).*.initData = tokens.at(token).*.data
    return o
}

// Declares the function `token` names with type `ty`; an earlier
// declaration of it is the same object. In C++ a function of the same
// name with other parameters is an overload (chained to the first), and
// the symbol is mangled unless the linkage is C's (extern "C", main).
pub fn declareFunction(ty: usize, token: usize, attr: usize) -> usize {
    const name = tokens.name(token)
    const a = attrAt(attr)
    const prefix = declaratorPrefix
    const qualified = standard.cpp && prefix != 0
    const cLinkage = !standard.cpp || externC > 0 || name == names.D_MAIN
    // At file scope the function declared before is one of this
    // namespace (a C++ `std::abs` is not the global `abs`).
    var binding: usize = 0
    if qualified {
        binding = scope.findQualified(prefix, name, false)
    } else if standard.cpp && scope.isFileScope() {
        binding = scope.findHere(name)
    } else {
        binding = scope.find(name)
    }
    if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isFunction {
        var known = scope.at(binding).*.obj
        if qualified && ast.obj(known).*.classType != 0 {
            // `void S::f(int) { }`: the member declared in the class.
            const method = cpp.matchMember(known, ty)
            if method == 0 { tokens.errorAt(token, "no member function with these parameters") }
            if a.*.isInline { ast.obj(method).*.isWeak = true }
            return method
        }
        var found = cLinkage || ast.obj(known).*.externC
        if !found {
            // The overload with these parameters, if declared before.
            var candidate = known
            while candidate != 0 && !found {
                if sameSignature(ast.obj(candidate).*.ty, ty) {
                    known = candidate
                    found = true
                } else if ast.obj(candidate).*.nextOverload == 0 {
                    // A new overload, after the last.
                    const o = newFunction(name, ty, a, if qualified { prefix } else { scope.currentNamespace() }, cLinkage)
                    ast.obj(candidate).*.nextOverload = o
                    return o
                }
                candidate = ast.obj(candidate).*.nextOverload
            }
        }
        // A prototype tells more than an old-style declaration.
        if types.at(ast.obj(known).*.ty).*.oldStyle && !types.at(ty).*.oldStyle { ast.obj(known).*.ty = ty }
        if a.*.isStatic { ast.obj(known).*.isStatic = true }
        if a.*.isInline { ast.obj(known).*.isInline = true }
        if a.*.isConstexpr { ast.obj(known).*.isConstexpr = true }
        if a.*.isInline && standard.cpp && !a.*.isStatic { ast.obj(known).*.isWeak = true }
        if !qualified && scope.at(binding).*.depth != scope.currentDepth() { const bound = scope.bindVariable(name, known) }
        return known
    }
    if qualified { tokens.errorAt(token, "no such function in the namespace") }
    const o = newFunction(name, ty, a, scope.currentNamespace(), cLinkage)
    const bound = scope.bindVariable(name, o)
    return o
}

fn newFunction(name: u32, ty: usize, a: *Attr, prefix: u32, cLinkage: bool) -> usize {
    const o = ast.newObj(name, ty, 0)
    ast.obj(o).*.isFunction = true
    ast.obj(o).*.isStatic = a.*.isStatic || (a.*.isInline && !a.*.isExtern && !standard.cpp)
    // A C++ inline function is defined in every file that uses it: weak.
    ast.obj(o).*.isWeak = standard.cpp && a.*.isInline && !a.*.isStatic
    ast.obj(o).*.isInline = a.*.isInline
    ast.obj(o).*.isConstexpr = a.*.isConstexpr
    // A C++ constexpr function is inline.
    if standard.cpp && a.*.isConstexpr && !a.*.isStatic {
        ast.obj(o).*.isInline = true
        ast.obj(o).*.isWeak = true
    }
    ast.obj(o).*.externC = cLinkage
    if !cLinkage {
        ast.obj(o).*.linkName = mangle.functionSymbol(prefix, name, ty, "")
        ast.obj(o).*.symbol = ast.obj(o).*.linkName
    }
    state.addGlobal(o)
    return o
}

// A member function's (or a friend's) body, read after its class
// `classTy` (cpp.mlx), whose names it sees.
pub fn defineFunction(fnObj: usize, classTy: usize) -> void {
    declaratorPrefix = if classTy != 0 { types.at(classTy).*.name } else { 0 }
    functionDefinition(fnObj, ast.obj(fnObj).*.ty)
}

// The same, the body seeing the names under `prefix` (a member
// template instance's parameters, bound below its class).
pub fn defineFunctionIn(fnObj: usize, prefix: u32) -> void {
    declaratorPrefix = prefix
    functionDefinition(fnObj, ast.obj(fnObj).*.ty)
}

// The same, the body using the parameter names of `declaredType` (the
// definition's, read apart from the declaration that made `fnObj`).
pub fn defineFunctionAs(fnObj: usize, prefix: u32, declaredType: usize) -> void {
    declaratorPrefix = prefix
    functionDefinition(fnObj, declaredType)
}

// The definition's parameter names (`void S::f(int n)`) become the
// member function's, whose type has its `this`.
fn parameterNames(fnObj: usize, declaredType: usize) -> void {
    const ty = ast.obj(fnObj).*.ty
    if ty == declaredType { return }
    var p = types.at(ty).*.params
    if p != 0 && types.param(p).*.name == names.K_THIS { p = types.param(p).*.next }
    var q = types.at(declaredType).*.params
    while p != 0 && q != 0 {
        types.param(p).*.name = types.param(q).*.name
        types.param(p).*.token = types.param(q).*.token
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
}

fn functionDefinition(fnObj: usize, declaredType: usize) -> void {
    const o = ast.obj(fnObj)
    if o.*.isDefinition { tokens.errorAt(o.*.token, "redefinition of a function") }
    o.*.isDefinition = true
    // A member function's type has its `this`; the definition's
    // parameter names are the ones its body uses.
    const ty = if o.*.classType != 0 { o.*.ty } else { declaredType }
    parameterNames(fnObj, declaredType)
    o.*.ty = ty
    // `void N::f() { }`: the body sees N's names; a member function's
    // body sees its class's.
    var prefix = declaratorPrefix
    if o.*.classType != 0 && prefix == 0 { prefix = types.at(o.*.classType).*.name }
    if prefix != 0 { scope.enterPrefix(prefix) }
    state.startFunction(fnObj)
    state.setCurrentClass(o.*.classType)
    scope.enter()
    // The parameters, in order, as cells (obj, next).
    var head: usize = 0
    var tail: usize = 0
    // A struct or union result over 16 bytes goes to the caller's buffer,
    // whose address comes as a hidden first parameter.
    const rt = types.baseOf(ty)
    if (types.kind(rt) == types.STRUCT || types.kind(rt) == types.UNION || types.isWide(rt)) && types.inMemory(rt) {
        const hidden = newLocal(0, types.pointerTo(rt), o.*.token)
        head = base.alloc(16)
        base.putWord(head, hidden)
        tail = head
    }
    var p = types.at(ty).*.params
    while p != 0 {
        // An unnamed parameter is C23's (`int f(int) { }`).
        if types.param(p).*.name == 0 && !standard.atLeast(standard.C23) { tokens.errorAt(types.param(p).*.token, "parameter name omitted") }
        const local = newLocal(types.param(p).*.name, types.param(p).*.ty, types.param(p).*.token)
        // A class passed by value is destroyed by the function.
        if standard.cpp && cpp.hasDestructor(types.param(p).*.ty) { state.pushCleanup(local) }
        const c = base.alloc(16)
        base.putWord(c, local)
        if head == 0 { head = c } else { base.putWord(tail + 8, c) }
        tail = c
        if types.param(p).*.packName != 0 {
            // One of an expanded pack's: the pack's name holds them all
            // (`args...` expands to them).
            const packBinding = scope.findHere(types.param(p).*.packName)
            var holder: usize = 0
            if packBinding != 0 && scope.at(packBinding).*.kind == scope.PACK {
                holder = scope.at(packBinding).*.obj
            } else {
                holder = types.newPackHolder()
                const bound = scope.bindPack(types.param(p).*.packName, 0, holder)
            }
            types.addPackVariable(holder, local)
            types.addPackType(holder, types.param(p).*.ty)
        }
        p = types.param(p).*.next
    }
    // An expanded pack with no element is still a name (`args...` empty).
    var emptyPack = types.at(ty).*.emptyPacks
    while emptyPack != 0 {
        const bound = scope.bindPack(@intCast(u32, base.getWord(emptyPack)), 0, types.newPackHolder())
        emptyPack = base.getWord(emptyPack + 8)
    }
    o.*.params = head
    if types.at(ty).*.variadic {
        o.*.vaArea = newLocal(0, types.arrayOf(types.charOf(), 200), o.*.token)
    }
    var prologue: usize = 0
    if standard.cpp && o.*.isConstructor { prologue = cpp.constructorPrologue(fnObj) }
    const bodyToken = cursor.peek()
    cursor.expect(names.P_LBRACE)
    // __func__ (C11 6.4.2.2) and GNU's __FUNCTION__.
    const text = base.nameOf(o.*.name)
    const data = base.keep(text)
    const literal = newAnonymousGlobal(types.arrayOf(types.charOf(), @intCast(i64, text.length) + 1), o.*.token)
    ast.obj(literal).*.isLiteral = true
    ast.obj(literal).*.initData = data
    const bound = scope.bindVariable(funcName, literal)
    const bound2 = scope.bindVariable(functionName, literal)
    o.*.body = stmt.compoundStatement()
    if standard.cpp { o.*.body = cpp.functionBody(fnObj, prologue, o.*.body, bodyToken) }
    o.*.locals = state.locals()
    state.endFunction()
    scope.leave()
    if prefix != 0 { scope.leaveNamespace() }
    stmt.resolveGotos()
}

fn globalVariable(ty: usize, token: usize, attr: usize) -> void {
    const name = tokens.name(token)
    const a = attrAt(attr)
    var o: usize = 0
    const binding = if standard.cpp && declaratorPrefix != 0 { scope.findQualified(declaratorPrefix, name, false) } else { scope.findHere(name) }
    if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE {
        const known = scope.at(binding).*.obj
        if !ast.obj(known).*.isFunction && !ast.obj(known).*.isLocal { o = known }
    }
    if o == 0 && standard.cpp && declaratorPrefix != 0 { tokens.errorAt(token, "no such member") }
    if o == 0 {
        o = ast.newObj(name, ty, token)
        // C++: a const namespace-scope variable has internal linkage
        // (one per file), unless declared extern or inline.
        ast.obj(o).*.isStatic = a.*.isStatic || (standard.cpp && (types.isConst(ty) || a.*.isConstexpr) && !a.*.isExtern && !a.*.isInline)
        if standard.cpp && externC == 0 && scope.currentNamespace() != 0 {
            ast.obj(o).*.linkName = mangle.variableSymbol(scope.currentNamespace(), name)
            ast.obj(o).*.symbol = ast.obj(o).*.linkName
        }
        state.addGlobal(o)
        const bound = scope.bindVariable(name, o)
    } else if types.at(ast.obj(o).*.ty).*.incomplete && !types.at(ty).*.incomplete {
        // `extern int a[]; int a[10];`
        ast.obj(o).*.ty = ty
    }
    ast.obj(o).*.alignment = if a.*.alignment > 0 { a.*.alignment } else { types.alignOf(ast.obj(o).*.ty) }
    if standard.cpp && !a.*.isExtern && (cpp.isObjectType(ast.obj(o).*.ty) || (cpp.isClassType(ast.obj(o).*.ty) && cursor.is(names.P_ASSIGN) && !cursor.isToken(cursor.peekNext(), names.P_LBRACE))) {
        // An object of a class: made when the program starts (a plain
        // class from an expression too: `in_place_t in_place = in_place_t();`).
        cpp.globalObject(o, token)
        return
    }
    if !a.*.isExtern {
        ast.obj(o).*.isDefinition = true
        if ast.obj(o).*.initData == 0 { ast.obj(o).*.isTentative = true }
    }
    if cursor.consume(names.P_ASSIGN) {
        if ast.obj(o).*.initData != 0 && !ast.obj(o).*.isTentative { tokens.errorAt(token, "redefinition of a variable") }
        initializer.globalInitializer(o)
        ast.obj(o).*.isDefinition = true
        ast.obj(o).*.isTentative = false
    }
}

// The declarations after the specifiers at file scope.
pub fn globalDeclaration(baseType: usize, attr: usize) -> void {
    var first = true
    while !cursor.consume(names.P_SEMI) {
        if !first { cursor.expect(names.P_COMMA) }
        const found = declarator(baseType)
        if found.1 == 0 { cursor.fail("variable name omitted") }
        afterDeclarator()
        var ty = found.0
        if attrAt(attr).*.isAuto && !attrAt(attr).*.hasType && standard.atLeast(standard.C23) && types.kind(ty) != types.FUNC { ty = inferredType() }
        if attrAt(attr).*.isConstexpr && constexprConstant(ty, found.1) {
            first = false
            continue
        }
        if types.kind(ty) == types.FUNC {
            const fnObj = declareFunction(ty, found.1, attr)
            if ast.obj(fnObj).*.token == 0 { ast.obj(fnObj).*.token = found.1 }
            // A definition: its body, or a constructor's initializer list.
            if first && (cursor.is(names.P_LBRACE) || (standard.cpp && ast.obj(fnObj).*.isConstructor && cursor.is(names.P_COLON))) {
                if standard.cpp && template.instantiating() && ast.obj(fnObj).*.classType != 0 && !ast.obj(fnObj).*.isVirtual {
                    // A class template instance's member defined outside
                    // the class: its body waits for a call.
                    parameterNames(fnObj, ty)
                    cpp.pendBody(fnObj, ast.obj(fnObj).*.classType)
                    return
                }
                functionDefinition(fnObj, ty)
                return
            }
        } else {
            globalVariable(ty, found.1, attr)
        }
        first = false
    }
}

// A declaration in a block: a BLOCK of the assignments its initializers
// make.
pub fn localDeclaration(baseType: usize, attr: usize) -> usize {
    const a = attrAt(attr)
    const block = ast.make(ast.BLOCK, cursor.peek())
    var head: usize = 0
    var tail: usize = 0
    var first = true
    while !cursor.consume(names.P_SEMI) {
        if !first { cursor.expect(names.P_COMMA) }
        first = false
        const found = declarator(baseType)
        if found.1 == 0 { cursor.fail("variable name omitted") }
        afterDeclarator()
        var ty = found.0
        const token = found.1
        const name = tokens.name(token)
        // C++'s `auto x = e` (and `auto &r = e`, `auto *p = e`): the
        // initializer, read once, gives the type.
        var autoValue: usize = 0
        if a.*.isAuto && !a.*.hasType && standard.cpp && types.kind(ty) != types.FUNC {
            if !cursor.consume(names.P_ASSIGN) { cursor.fail("auto needs an initializer to take its type from") }
            autoValue = expr.assign()
            typing.addType(autoValue)
            var inferred = ast.typeOf(autoValue)
            if types.kind(inferred) == types.ARRAY { inferred = types.pointerTo(types.baseOf(inferred)) }
            if types.kind(inferred) == types.FUNC { inferred = types.pointerTo(inferred) }
            ty = if types.isReference(ty) { types.referenceTo(inferred) } else { inferred }
        } else if a.*.isAuto && !a.*.hasType && standard.atLeast(standard.C23) {
            ty = inferredType()
        }
        if a.*.isConstexpr && constexprConstant(ty, token) { continue }
        if types.kind(ty) == types.FUNC {
            const declared = declareFunction(ty, token, attr)
            if ast.obj(declared).*.token == 0 { ast.obj(declared).*.token = token }
        } else if types.isReference(ty) {
            // `T &r = object`: the local holds the object's address.
            if a.*.isStatic || a.*.isExtern { tokens.errorAt(token, "a static reference is not supported") }
            const local = newLocal(name, ty, token)
            if autoValue == 0 && !cursor.consume(names.P_ASSIGN) { tokens.errorAt(token, "a reference needs an initializer") }
            const bound = typing.toReference(if autoValue != 0 { autoValue } else { expr.assign() }, ty)
            const target = ast.variableNode(local, token)
            ast.node(target).*.ty = ty
            const init = ast.binary(ast.ASSIGN, target, bound, token)
            ast.node(init).*.ty = ty
            const statement = ast.unary(ast.EXPR_STMT, cpp.flushTemporaries(init, false, token), token)
            if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
            tail = statement
        } else if a.*.isExtern {
            // The global the name stands for, defined elsewhere.
            const o = ast.newObj(name, ty, token)
            ast.obj(o).*.alignment = types.alignOf(ty)
            state.addGlobal(o)
            const bound = scope.bindVariable(name, o)
        } else if a.*.isStatic {
            if types.kind(ty) == types.VOID { tokens.errorAt(token, "variable declared void") }
            const o = newAnonymousGlobal(ty, token)
            ast.obj(o).*.name = name
            if a.*.alignment > 0 { ast.obj(o).*.alignment = a.*.alignment }
            const bound = scope.bindVariable(name, o)
            if standard.cpp && cpp.isObjectType(ty) {
                // Made the first time the declaration runs.
                const statement = cpp.staticLocalObject(o, token)
                if statement != 0 {
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            } else if cursor.consume(names.P_ASSIGN) {
                initializer.globalInitializer(o)
            }
        } else {
            if types.kind(ty) == types.VOID { tokens.errorAt(token, "variable declared void") }
            const local = newLocal(name, ty, token)
            if a.*.alignment > 0 { ast.obj(local).*.alignment = a.*.alignment }
            if autoValue != 0 {
                const statement = cpp.localObjectFrom(local, autoValue, token)
                if statement != 0 {
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            } else if standard.cpp && cpp.isObjectType(ty) {
                const statement = cpp.localObject(local, token)
                if statement != 0 {
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            } else if cursor.consume(names.P_ASSIGN) {
                // C++: a const integer local with a constant value is one.
                if standard.cpp && types.isConst(ty) && types.isInteger(ty) && !types.isWide(ty) {
                    const start = cursor.save()
                    const e = expr.assign()
                    if eval.isConstant(e) {
                        ast.obj(local).*.hasConstValue = true
                        ast.obj(local).*.constValue = eval.evaluate(e)
                    }
                    cursor.restore(start)
                }
                var init = initializer.localInitializer(local)
                if standard.cpp { init = cpp.flushTemporaries(init, false, token) }
                const statement = ast.unary(ast.EXPR_STMT, init, token)
                if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                tail = statement
            } else if standard.cpp && cursor.consume(names.P_LPAREN) {
                // `int x(5);` (`T v(args...)` with one element, or none:
                // then nothing).
                const given = base.alloc(2 * 8)
                const count = expr.argumentList(names.P_RPAREN, given, 2)
                if count > 1 { tokens.errorAt(token, "too many initializers") }
                if count == 1 {
                    const init = ast.binary(ast.ASSIGN, ast.variableNode(local, token), base.getWord(given), token)
                    const statement = ast.unary(ast.EXPR_STMT, cpp.flushTemporaries(init, false, token), token)
                    if head == 0 { head = statement } else { ast.node(tail).*.next = statement }
                    tail = statement
                }
            }
            const lt = ast.obj(local).*.ty
            if types.at(lt).*.incomplete { tokens.errorAt(token, "variable has incomplete type") }
        }
    }
    ast.node(block).*.body = head
    return block
}

// A translation unit (C11 6.9): its objects go to the state's globals.
pub fn translationUnit(list: usize) -> void {
    cursor.restore(list)
    externC = 0
    declarationList(false)
    if standard.cpp { template.finish() }
}

// The declarations here: to the end of the file, or to the `}` closing
// a namespace or an extern "C" block (consumed).
fn declarationList(inBraces: bool) -> void {
    while !cursor.isEof() {
        if inBraces && cursor.consume(names.P_RBRACE) { return }
        stdAttributes()
        if cursor.consume(names.P_SEMI) {
            // An empty declaration.
        } else if cursor.is(names.K_STATIC_ASSERT) {
            staticAssert()
        } else if cursor.is(names.K_ASM) || cursor.is(names.K_GNU2_ASM) {
            cursor.advance()
            skipParentheses()
            cursor.expect(names.P_SEMI)
        } else if standard.cpp && cursor.is(names.K_INLINE) && cursor.isToken(cursor.peekNext(), names.K_NAMESPACE) {
            // `inline namespace N { ... }`: its names are the enclosing
            // namespace's too.
            cursor.advance()
            cursor.advance()
            inlineNamespace(namespaceDeclaration())
        } else if standard.cpp && cursor.consume(names.K_NAMESPACE) {
            const ignored = namespaceDeclaration()
        } else if standard.cpp && cursor.is(names.K_USING) {
            usingDeclaration()
        } else if standard.cpp && cursor.is(names.K_EXTERN) && tokens.kind(cursor.peekNext()) == tokens.STRING {
            // extern "C" declaration, or extern "C" { ... }
            cursor.advance()
            cursor.advance()
            externC += 1
            if cursor.consume(names.P_LBRACE) {
                declarationList(true)
            } else {
                const attr = newAttr()
                const baseType = declspec(attr)
                if attrAt(attr).*.isTypedef { parseTypedef(baseType) } else { globalDeclaration(baseType, attr) }
            }
            externC -= 1
        } else if standard.cpp && cursor.is(names.K_TEMPLATE) {
            template.declaration()
        } else {
            const attr = newAttr()
            const baseType = declspec(attr)
            if attrAt(attr).*.isTypedef {
                parseTypedef(baseType)
            } else {
                globalDeclaration(baseType, attr)
            }
        }
    }
    if inBraces { cursor.fail("unterminated namespace or extern block") }
}

// `namespace N { ... }`, `namespace { ... }` (its names global), or
// `namespace N = M;`.
// `inline namespace N { ... }` read: its names are the enclosing
// namespace's too.
fn inlineNamespace(prefix: u32) -> void {
    if prefix != 0 { scope.addInlineNamespace(scope.currentNamespace(), prefix) }
}

// The namespace's prefix (0 for an unnamed one or an alias).
fn namespaceDeclaration() -> u32 {
    const ignored = attributes()
    if cursor.consume(names.P_LBRACE) {
        declarationList(true)
        return 0
    }
    const token = cursor.expectIdent()
    const name = tokens.name(token)
    if cursor.consume(names.P_ASSIGN) {
        // An alias of another namespace.
        const read = qualifier()
        const target = cursor.expectIdent()
        const binding = if read.1 { scope.findQualified(read.0, tokens.name(target), false) } else { scope.find(tokens.name(target)) }
        if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE { tokens.errorAt(target, "not a namespace") }
        const bound = scope.bindNamespace(name, @intCast(u32, scope.at(binding).*.value))
        cursor.expect(names.P_SEMI)
        return 0
    }
    const prefix = scope.qualify(scope.currentNamespace(), name)
    const known = scope.findHere(name)
    if known == 0 || scope.at(known).*.kind != scope.NAMESPACE { const bound = scope.bindNamespace(name, prefix) }
    cursor.expect(names.P_LBRACE)
    scope.enterPrefix(prefix)
    declarationList(true)
    scope.leaveNamespace()
    return prefix
}

// `using namespace N;` or `using N::name;` (the name usable here).
pub fn usingDeclaration() -> void {
    cursor.expect(names.K_USING)
    if cursor.consume(names.K_NAMESPACE) {
        const read = qualifier()
        const token = cursor.expectIdent()
        const binding = if read.1 { scope.findQualified(read.0, tokens.name(token), false) } else { scope.find(tokens.name(token)) }
        if binding == 0 || scope.at(binding).*.kind != scope.NAMESPACE { tokens.errorAt(token, "not a namespace") }
        scope.usingNamespace(@intCast(u32, scope.at(binding).*.value))
        cursor.expect(names.P_SEMI)
        return
    }
    if cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_ASSIGN) {
        // `using T = type;`: a typedef.
        const alias = cursor.expectIdent()
        cursor.advance()
        const ty = typeName()
        cursor.expect(names.P_SEMI)
        const bound = scope.bindTypedef(tokens.name(alias), ty)
        return
    }
    const read = qualifier()
    const token = cursor.expectIdent()
    const name = tokens.name(token)
    var binding = if read.1 { scope.findQualified(read.0, name, false) } else { scope.find(name) }
    if binding == 0 {
        binding = if read.1 { scope.findQualified(read.0, name, true) } else { scope.findTag(name) }
        if binding == 0 { tokens.errorAt(token, "no such name") }
        const bound = scope.bindTag(name, scope.at(binding).*.ty)
    } else {
        const b = scope.at(binding)
        if b.*.kind == scope.VARIABLE {
            const bound = scope.bindVariable(name, b.*.obj)
        } else if b.*.kind == scope.TYPEDEF {
            const bound = scope.bindTypedef(name, b.*.ty)
        } else if b.*.kind == scope.ENUM_CONSTANT {
            const bound = scope.bindEnumConstant(name, b.*.ty, b.*.value)
        } else if b.*.kind == scope.NAMESPACE {
            const bound = scope.bindNamespace(name, @intCast(u32, b.*.value))
        }
    }
    cursor.expect(names.P_SEMI)
}
