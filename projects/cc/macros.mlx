// Macros: the table (by name), and their expansion as C11 6.10.3 has it,
// with hide sets: every token carries the set of macros it came out of,
// and a name is not expanded again inside its own expansion. An
// object-like macro's tokens get the name's set plus the name; a
// function-like one's get the intersection of the sets of the name and
// of its closing parenthesis, plus the name. Arguments are fully expanded
// before they are put in, unless `#` or `##` stands next to them.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const lexer = @import("./lexer.mlx")

// Built-in macros, computed where they are used.
pub const BUILTIN_NONE: u8 = 0
pub const BUILTIN_FILE: u8 = 1
pub const BUILTIN_LINE: u8 = 2
pub const BUILTIN_COUNTER: u8 = 3
pub const BUILTIN_DATE: u8 = 4
pub const BUILTIN_TIME: u8 = 5

pub const Macro = struct {
    name: u32
    functionLike: bool
    variadic: bool
    builtin: u8
    paramCount: u32
    // The parameters' names (u32 each); __VA_ARGS__ last when variadic.
    params: usize
    // The replacement list, ending in EOF.
    body: usize
}

// A hide set: a list of macro names.
const Hide = struct {
    name: u32
    next: usize
}

// An argument: its tokens as given and, when needed, fully expanded.
const Argument = struct {
    name: u32
    given: usize
    expanded: usize
}

var table: usize = 0
var counter: u64 = 0

pub fn init() -> void {
    table = base.alloc(base.MAX_NAMES * 8)
}

fn macroAt(address: usize) -> *Macro {
    unsafe { return @ptrFromInt(*Macro, address) }
}

fn hideAt(address: usize) -> *Hide {
    unsafe { return @ptrFromInt(*Hide, address) }
}

fn argumentAt(address: usize) -> *Argument {
    unsafe { return @ptrFromInt(*Argument, address) }
}

// The macro named `name`, 0 when there is none.
pub fn find(name: u32) -> usize {
    return base.getWord(table + @intCast(usize, name) * 8)
}

pub fn isDefined(name: u32) -> bool { return find(name) != 0 }

pub fn undefine(name: u32) -> void {
    base.putWord(table + @intCast(usize, name) * 8, 0)
}

// A new macro named `name` (it replaces any before it).
pub fn define(name: u32, functionLike: bool) -> usize {
    const macro = base.alloc(@sizeOf(Macro))
    macroAt(macro).*.name = name
    macroAt(macro).*.functionLike = functionLike
    base.putWord(table + @intCast(usize, name) * 8, macro)
    return macro
}

pub fn setBody(macro: usize, body: usize) -> void { macroAt(macro).*.body = body }

pub fn setParams(macro: usize, params: usize, count: u32, variadic: bool) -> void {
    macroAt(macro).*.params = params
    macroAt(macro).*.paramCount = count
    macroAt(macro).*.variadic = variadic
}

pub fn defineBuiltin(name: u32, builtin: u8) -> void {
    const macro = define(name, false)
    macroAt(macro).*.builtin = builtin
}

// ---------------------------------------------------------------------------
// Hide sets

fn contains(set: usize, name: u32) -> bool {
    var at = set
    while at != 0 {
        if hideAt(at).*.name == name { return true }
        at = hideAt(at).*.next
    }
    return false
}

fn single(name: u32) -> usize {
    const node = base.alloc(@sizeOf(Hide))
    hideAt(node).*.name = name
    return node
}

// first ∪ second (new nodes for first's names, second shared).
fn unite(first: usize, second: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var at = first
    while at != 0 {
        if !contains(second, hideAt(at).*.name) {
            const node = single(hideAt(at).*.name)
            if head == 0 { head = node } else { hideAt(tail).*.next = node }
            tail = node
        }
        at = hideAt(at).*.next
    }
    if head == 0 { return second }
    hideAt(tail).*.next = second
    return head
}

fn intersect(first: usize, second: usize) -> usize {
    var head: usize = 0
    var at = first
    while at != 0 {
        if contains(second, hideAt(at).*.name) {
            const node = single(hideAt(at).*.name)
            hideAt(node).*.next = head
            head = node
        }
        at = hideAt(at).*.next
    }
    return head
}

// ---------------------------------------------------------------------------
// Token lists

// Copies of the list's tokens (without its EOF), each with `set` added to
// its hide set and the position of `site`, followed by `rest`.
fn copied(list: usize, set: usize, site: usize, rest: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var at = list
    while !tokens.isEof(at) {
        const token = tokens.copy(at)
        tokens.at(token).*.hide = unite(tokens.at(at).*.hide, set)
        if site != 0 {
            tokens.at(token).*.file = tokens.at(site).*.file
            tokens.at(token).*.line = tokens.at(site).*.line
        }
        if head == 0 { head = token } else { tokens.at(tail).*.next = token }
        tail = token
        at = tokens.next(at)
    }
    if head == 0 { return rest }
    tokens.at(tail).*.next = rest
    return head
}

// Plain copies of the list's tokens followed by `rest`.
pub fn append(list: usize, rest: usize) -> usize {
    return copied(list, 0, 0, rest)
}

// ---------------------------------------------------------------------------
// Expansion

// The tokens of `list` with every macro in it expanded (an argument's
// pre-expansion; there are no directives in it).
pub fn expandAll(list: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var at = list
    while !tokens.isEof(at) {
        const expanded = expand(at)
        if expanded != 0 {
            at = expanded
            continue
        }
        if head == 0 { head = at } else { tokens.at(tail).*.next = at }
        tail = at
        at = tokens.next(at)
    }
    if head == 0 { return at }
    tokens.at(tail).*.next = at
    return head
}

// When `token` names a macro to expand here: its expansion followed by
// the tokens after the call, else 0.
pub fn expand(token: usize) -> usize {
    if tokens.kind(token) != tokens.IDENT { return 0 }
    const name = tokens.name(token)
    if contains(tokens.at(token).*.hide, name) { return 0 }
    const macro = find(name)
    if macro == 0 { return 0 }
    const m = macroAt(macro)
    var result: usize = 0
    if m.*.builtin != BUILTIN_NONE {
        result = builtinToken(m.*.builtin, token)
        tokens.at(result).*.next = tokens.next(token)
    } else if !m.*.functionLike {
        const set = unite(tokens.at(token).*.hide, single(name))
        result = copied(m.*.body, set, token, tokens.next(token))
    } else {
        const open = tokens.next(token)
        if !tokens.is(open, names.P_LPAREN) { return 0 }
        const call = arguments(macro, token)
        const close = call.0
        const set = unite(intersect(tokens.at(token).*.hide, tokens.at(close).*.hide), single(name))
        const body = substitute(macro, call.1)
        result = copied(body, set, token, tokens.next(close))
    }
    // The expansion takes the place of the name: its first token starts
    // the line, and has the space, the name had.
    if result != tokens.next(token) {
        const flags = tokens.at(token).*.flags
        tokens.at(result).*.flags = (tokens.at(result).*.flags & 252) | (flags & 3)
    }
    return result
}

// Reads the arguments of a call to `macro` whose name is `token`; the
// closing parenthesis and the arguments (an array of Argument, one per
// parameter).
fn arguments(macro: usize, token: usize) -> (usize, usize) {
    const m = macroAt(macro)
    const count = @intCast(usize, m.*.paramCount)
    const list = base.alloc((count + 1) * @sizeOf(Argument))
    var at = tokens.next(tokens.next(token))
    var index: usize = 0
    // A macro with no parameters is called with nothing between the
    // parentheses.
    if count == 0 {
        if !tokens.is(at, names.P_RPAREN) { tokens.errorAt(at, "too many arguments to the macro") }
        return -> (at, list)
    }
    while true {
        const variadic = m.*.variadic && index == count - 1
        const argument = argumentAt(list + index * @sizeOf(Argument))
        argument.*.name = base.get32(m.*.params + index * 4)
        var head: usize = 0
        var tail: usize = 0
        var depth: usize = 0
        while true {
            if tokens.isEof(at) { tokens.errorAt(token, "unterminated call to the macro") }
            if depth == 0 && tokens.is(at, names.P_RPAREN) { break }
            if depth == 0 && !variadic && tokens.is(at, names.P_COMMA) { break }
            if tokens.is(at, names.P_LPAREN) { depth += 1 }
            if tokens.is(at, names.P_RPAREN) { depth -= 1 }
            const piece = tokens.copy(at)
            if head == 0 { head = piece } else { tokens.at(tail).*.next = piece }
            tail = piece
            at = tokens.next(at)
        }
        const end = tokens.eof(@intCast(u32, tokens.at(at).*.file), tokens.at(at).*.line)
        if head == 0 { head = end } else { tokens.at(tail).*.next = end }
        argument.*.given = head
        index += 1
        if tokens.is(at, names.P_RPAREN) { break }
        at = tokens.next(at)
        if index == count { tokens.errorAt(token, "too many arguments to the macro") }
    }
    // A variadic macro may be given nothing for its `...`.
    if index == count - 1 && m.*.variadic {
        const argument = argumentAt(list + index * @sizeOf(Argument))
        argument.*.name = base.get32(m.*.params + index * 4)
        argument.*.given = tokens.eof(@intCast(u32, tokens.at(at).*.file), tokens.at(at).*.line)
        index += 1
    }
    if index != count { tokens.errorAt(token, "too few arguments to the macro") }
    return -> (at, list)
}

// The argument named by `token` in `list`, 0 when `token` is no
// parameter.
fn argumentFor(macro: usize, list: usize, token: usize) -> usize {
    if tokens.kind(token) != tokens.IDENT { return 0 }
    const m = macroAt(macro)
    var index: usize = 0
    while index < @intCast(usize, m.*.paramCount) {
        const argument = list + index * @sizeOf(Argument)
        if argumentAt(argument).*.name == tokens.name(token) { return argument }
        index += 1
    }
    return 0
}

fn expandedOf(argument: usize) -> usize {
    const a = argumentAt(argument)
    if a.*.expanded == 0 { a.*.expanded = expandAll(append(a.*.given, tokens.eof(0, 0))) }
    return a.*.expanded
}

// The macro's body with its parameters replaced (C11 6.10.3.1-3).
fn substitute(macro: usize, list: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var at = macroAt(macro).*.body
    while !tokens.isEof(at) {
        // # parameter: the argument as a string literal.
        if tokens.is(at, names.P_HASH) {
            const argument = argumentFor(macro, list, tokens.next(at))
            if argument == 0 { tokens.errorAt(at, "'#' is not followed by a macro parameter") }
            const made = stringize(at, argumentAt(argument).*.given)
            if head == 0 { head = made } else { tokens.at(tail).*.next = made }
            tail = made
            at = tokens.next(tokens.next(at))
            continue
        }
        // x ## y: glue the last token so far to what follows.
        if tokens.is(at, names.P_HASHHASH) {
            if head == 0 { tokens.errorAt(at, "'##' cannot start a macro") }
            const right = tokens.next(at)
            if tokens.isEof(right) { tokens.errorAt(at, "'##' cannot end a macro") }
            const argument = argumentFor(macro, list, right)
            var first = right
            var more: usize = 0
            if argument != 0 {
                first = argumentAt(argument).*.given
                if tokens.isEof(first) {
                    at = tokens.next(right)
                    continue
                }
                more = tokens.next(first)
            }
            const pasted = paste(tail, first)
            // Replace the tail by the pasted token.
            if head == tail {
                head = pasted
            } else {
                var before = head
                while tokens.next(before) != tail { before = tokens.next(before) }
                tokens.at(before).*.next = pasted
            }
            tail = pasted
            while more != 0 && !tokens.isEof(more) {
                const piece = tokens.copy(more)
                tokens.at(tail).*.next = piece
                tail = piece
                more = tokens.next(more)
            }
            at = tokens.next(right)
            continue
        }
        const argument = argumentFor(macro, list, at)
        if argument != 0 && tokens.is(tokens.next(at), names.P_HASHHASH) {
            // An argument before ## goes in as given.
            var piece = argumentAt(argument).*.given
            while !tokens.isEof(piece) {
                const copy = tokens.copy(piece)
                if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
                tail = copy
                piece = tokens.next(piece)
            }
            if head == 0 {
                // Nothing before ##: the right side goes in alone.
                at = tokens.next(tokens.next(at))
                const right = argumentFor(macro, list, at)
                if right != 0 {
                    var given = argumentAt(right).*.given
                    while !tokens.isEof(given) {
                        const copy = tokens.copy(given)
                        if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
                        tail = copy
                        given = tokens.next(given)
                    }
                } else if !tokens.isEof(at) {
                    const copy = tokens.copy(at)
                    head = copy
                    tail = copy
                }
                if !tokens.isEof(at) { at = tokens.next(at) }
                continue
            }
            at = tokens.next(at)
            continue
        }
        if argument != 0 {
            var piece = expandedOf(argument)
            while !tokens.isEof(piece) {
                const copy = tokens.copy(piece)
                if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
                tail = copy
                piece = tokens.next(piece)
            }
            at = tokens.next(at)
            continue
        }
        const copy = tokens.copy(at)
        if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
        tail = copy
        at = tokens.next(at)
    }
    const end = tokens.eof(0, 0)
    if head == 0 { return end }
    tokens.at(tail).*.next = end
    return head
}

// The argument `list` as a string literal (C11 6.10.3.2): its tokens'
// texts, one space where there was whitespace, quotes and backslashes in
// strings and character constants escaped.
fn stringize(hash: usize, list: usize) -> usize {
    var length: usize = 2
    var at = list
    while !tokens.isEof(at) {
        length += 2 * @intCast(usize, tokens.at(at).*.length) + 1
        at = tokens.next(at)
    }
    const text = base.alloc(length + 1)
    var written: usize = 0
    base.put8(text, 34)
    written = 1
    at = list
    var first = true
    while !tokens.isEof(at) {
        if !first && tokens.at(at).*.flags & tokens.SPACE_BEFORE != 0 {
            base.put8(text + written, 32)
            written += 1
        }
        first = false
        const quoted = tokens.kind(at) == tokens.STRING || tokens.kind(at) == tokens.CHAR
        const piece = tokens.text(at)
        var index: usize = 0
        while index < piece.length {
            const c = piece[index]
            if quoted && (c == 34 || c == 92) {
                base.put8(text + written, 92)
                written += 1
            }
            base.put8(text + written, c)
            written += 1
            index += 1
        }
        at = tokens.next(at)
    }
    base.put8(text + written, 34)
    written += 1
    const token = tokens.make(tokens.STRING, @intCast(u32, tokens.at(hash).*.file), tokens.at(hash).*.line, text, written)
    tokens.at(token).*.flags = tokens.at(hash).*.flags
    return token
}

// The token made of `left` and `right` glued together.
fn paste(left: usize, right: usize) -> usize {
    const first = tokens.text(left)
    const second = tokens.text(right)
    const text = base.alloc(first.length + second.length + 1)
    base.copy(text, tokens.at(left).*.start, first.length)
    base.copy(text + first.length, tokens.at(right).*.start, second.length)
    const file = base.textFile("<paste>", base.bytes(text, first.length + second.length))
    const made = lexer.tokenize(file)
    if !tokens.isEof(tokens.next(made)) { tokens.errorAt(left, "pasting does not give one token") }
    tokens.at(made).*.file = tokens.at(left).*.file
    tokens.at(made).*.line = tokens.at(left).*.line
    tokens.at(made).*.flags = tokens.at(left).*.flags
    tokens.at(made).*.hide = tokens.at(left).*.hide
    tokens.at(made).*.next = 0
    return made
}

// ---------------------------------------------------------------------------
// Built-in macros

fn numberToken(value: u64, site: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    const text = base.keep(view[24 - count..24])
    return tokens.make(tokens.NUMBER, @intCast(u32, tokens.at(site).*.file), tokens.at(site).*.line, text, count)
}

fn stringToken(value: []const u8, site: usize) -> usize {
    const text = base.alloc(value.length * 2 + 3)
    var written: usize = 1
    base.put8(text, 34)
    var index: usize = 0
    while index < value.length {
        if value[index] == 34 || value[index] == 92 {
            base.put8(text + written, 92)
            written += 1
        }
        base.put8(text + written, value[index])
        written += 1
        index += 1
    }
    base.put8(text + written, 34)
    written += 1
    return tokens.make(tokens.STRING, @intCast(u32, tokens.at(site).*.file), tokens.at(site).*.line, text, written)
}

fn builtinToken(builtin: u8, site: usize) -> usize {
    var made: usize = 0
    if builtin == BUILTIN_FILE {
        made = stringToken(base.nameOf(base.fileName(@intCast(u32, tokens.at(site).*.file))), site)
    } else if builtin == BUILTIN_LINE {
        made = numberToken(@intCast(u64, tokens.at(site).*.line), site)
    } else if builtin == BUILTIN_COUNTER {
        made = numberToken(counter, site)
        counter += 1
    } else if builtin == BUILTIN_DATE {
        made = stringToken("Jan  1 2026", site)
    } else {
        made = stringToken("00:00:00", site)
    }
    tokens.at(made).*.flags = tokens.at(site).*.flags
    return made
}
