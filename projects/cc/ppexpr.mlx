// The constant expressions of #if and #elif (C11 6.10.1): the line's
// tokens with `defined NAME` and `defined(NAME)` (and __has_include)
// replaced by 1 or 0, then macro-expanded, every identifier left over
// taken as 0, and the result evaluated as intmax_t (unsigned when an
// operand is).
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const macros = @import("./macros.mlx")
const paths = @import("./paths.mlx")
const standard = @import("./standard.mlx")

// Evaluation state: the token at hand, and whether the value so far is
// unsigned.
const Reader = struct {
    at: usize
}

fn readerAt(address: usize) -> *Reader {
    unsafe { return @ptrFromInt(*Reader, address) }
}

fn current(reader: usize) -> usize { return readerAt(reader).*.at }

fn advance(reader: usize) -> void { readerAt(reader).*.at = tokens.next(readerAt(reader).*.at) }

fn accept(reader: usize, id: u32) -> bool {
    if tokens.is(current(reader), id) {
        advance(reader)
        return true
    }
    return false
}

fn expect(reader: usize, id: u32, message: []const u8) -> void {
    if !accept(reader, id) { tokens.errorAt(current(reader), message) }
}

fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }

// The value of an integer constant's text (its suffix ignored).
pub fn integerValue(token: usize) -> u64 {
    const text = tokens.text(token)
    var index: usize = 0
    var radix: u64 = 10
    if text.length > 1 && text[0] == 48 && (text[1] == 120 || text[1] == 88) {
        radix = 16
        index = 2
    } else if text.length > 1 && text[0] == 48 && (text[1] == 98 || text[1] == 66) {
        radix = 2
        index = 2
    } else if text.length > 1 && text[0] == 48 {
        radix = 8
        index = 1
    }
    var value: u64 = 0
    while index < text.length {
        const c = text[index]
        if c == 39 {
            // A digit separator (C23).
            index += 1
            continue
        }
        var digit: u64 = 99
        if isDigit(c) {
            digit = @intCast(u64, c - 48)
        } else if c >= 97 && c <= 102 {
            digit = @intCast(u64, c - 97 + 10)
        } else if c >= 65 && c <= 70 {
            digit = @intCast(u64, c - 65 + 10)
        }
        if digit >= radix { break }
        value = value * radix + digit
        index += 1
    }
    return value
}

fn primary(reader: usize) -> i64 {
    const token = current(reader)
    if accept(reader, names.P_LPAREN) {
        const value = conditional(reader)
        expect(reader, names.P_RPAREN, "expected ')' in #if")
        return value
    }
    if tokens.kind(token) == tokens.NUMBER {
        advance(reader)
        return @bitCast(i64, integerValue(token))
    }
    if tokens.kind(token) == tokens.CHAR {
        advance(reader)
        return @bitCast(i64, tokens.at(token).*.value)
    }
    if tokens.kind(token) == tokens.IDENT {
        advance(reader)
        // `true` is 1 in C23 (`false` and every other name are 0).
        if standard.booleanConstants() && tokens.name(token) == names.K_TRUE { return 1 }
        return 0
    }
    tokens.errorAt(token, "this does not belong in #if")
    return 0
}

fn unary(reader: usize) -> i64 {
    if accept(reader, names.P_PLUS) { return unary(reader) }
    if accept(reader, names.P_MINUS) { return 0 - unary(reader) }
    if accept(reader, names.P_BANG) { return if unary(reader) == 0 { 1 } else { 0 } }
    if accept(reader, names.P_TILDE) { return -1 - unary(reader) }
    return primary(reader)
}

fn multiplicative(reader: usize) -> i64 {
    var value = unary(reader)
    while true {
        const token = current(reader)
        if accept(reader, names.P_STAR) {
            value = value * unary(reader)
        } else if accept(reader, names.P_SLASH) {
            const divisor = unary(reader)
            if divisor == 0 { tokens.errorAt(token, "division by zero in #if") }
            value = value / divisor
        } else if accept(reader, names.P_PERCENT) {
            const divisor = unary(reader)
            if divisor == 0 { tokens.errorAt(token, "division by zero in #if") }
            value = value % divisor
        } else {
            break
        }
    }
    return value
}

fn additive(reader: usize) -> i64 {
    var value = multiplicative(reader)
    while true {
        if accept(reader, names.P_PLUS) {
            value = value + multiplicative(reader)
        } else if accept(reader, names.P_MINUS) {
            value = value - multiplicative(reader)
        } else {
            break
        }
    }
    return value
}

fn shift(reader: usize) -> i64 {
    var value = additive(reader)
    while true {
        if accept(reader, names.P_SHL) {
            value = value << @intCast(u6, additive(reader) & 63)
        } else if accept(reader, names.P_SHR) {
            value = value >> @intCast(u6, additive(reader) & 63)
        } else {
            break
        }
    }
    return value
}

fn relational(reader: usize) -> i64 {
    var value = shift(reader)
    while true {
        if accept(reader, names.P_LT) {
            value = if value < shift(reader) { 1 } else { 0 }
        } else if accept(reader, names.P_LE) {
            value = if value <= shift(reader) { 1 } else { 0 }
        } else if accept(reader, names.P_GT) {
            value = if value > shift(reader) { 1 } else { 0 }
        } else if accept(reader, names.P_GE) {
            value = if value >= shift(reader) { 1 } else { 0 }
        } else {
            break
        }
    }
    return value
}

fn equality(reader: usize) -> i64 {
    var value = relational(reader)
    while true {
        if accept(reader, names.P_EQ) {
            value = if value == relational(reader) { 1 } else { 0 }
        } else if accept(reader, names.P_NE) {
            value = if value != relational(reader) { 1 } else { 0 }
        } else {
            break
        }
    }
    return value
}

fn bitAnd(reader: usize) -> i64 {
    var value = equality(reader)
    while accept(reader, names.P_AMP) { value = value & equality(reader) }
    return value
}

fn bitXor(reader: usize) -> i64 {
    var value = bitAnd(reader)
    while accept(reader, names.P_CARET) { value = value ^ bitAnd(reader) }
    return value
}

fn bitOr(reader: usize) -> i64 {
    var value = bitXor(reader)
    while accept(reader, names.P_PIPE) { value = value | bitXor(reader) }
    return value
}

fn logicalAnd(reader: usize) -> i64 {
    var value = bitOr(reader)
    while accept(reader, names.P_ANDAND) {
        const right = bitOr(reader)
        value = if value != 0 && right != 0 { 1 } else { 0 }
    }
    return value
}

fn logicalOr(reader: usize) -> i64 {
    var value = logicalAnd(reader)
    while accept(reader, names.P_OROR) {
        const right = logicalAnd(reader)
        value = if value != 0 || right != 0 { 1 } else { 0 }
    }
    return value
}

fn conditional(reader: usize) -> i64 {
    const condition = logicalOr(reader)
    if !accept(reader, names.P_QUESTION) { return condition }
    const yes = conditional(reader)
    expect(reader, names.P_COLON, "expected ':' in #if")
    const no = conditional(reader)
    return if condition != 0 { yes } else { no }
}

// `defined` resolved in the line `list` (ending in EOF): a new list.
fn resolveDefined(list: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var at = list
    while !tokens.isEof(at) {
        var made: usize = 0
        if tokens.is(at, names.D_DEFINED) {
            const start = at
            at = tokens.next(at)
            const parenthesized = tokens.is(at, names.P_LPAREN)
            if parenthesized { at = tokens.next(at) }
            if tokens.kind(at) != tokens.IDENT { tokens.errorAt(start, "defined needs a macro name") }
            const value: u64 = if macros.isDefined(tokens.name(at)) { 1 } else { 0 }
            at = tokens.next(at)
            if parenthesized {
                if !tokens.is(at, names.P_RPAREN) { tokens.errorAt(start, "expected ')' after defined") }
                at = tokens.next(at)
            }
            made = oneToken(start, value)
        } else if tokens.is(at, names.D_HAS_INCLUDE) || tokens.is(at, names.D_HAS_INCLUDE_NEXT) {
            const start = at
            const found = askInclude(at)
            at = found.0
            made = oneToken(start, found.1)
        } else if tokens.is(at, names.D_HAS_EMBED) {
            const start = at
            const found = askEmbed(at)
            at = found.0
            made = valueToken(start, found.1)
        } else {
            made = tokens.copy(at)
            at = tokens.next(at)
        }
        if head == 0 { head = made } else { tokens.at(tail).*.next = made }
        tail = made
    }
    if head == 0 { return at }
    tokens.at(tail).*.next = at
    return head
}

// A number token at `site`'s place with `value`'s digits.
fn valueToken(site: usize, value: u64) -> usize {
    const digits = base.decimal(value)
    return tokens.make(tokens.NUMBER, @intCast(u32, tokens.at(site).*.file), tokens.at(site).*.line, base.keep(digits), digits.length)
}

// __has_embed("name" ...) or (<name> ...) at `at`: the token after it,
// and 0 (not found), 1 (found) or 2 (found, but empty), as
// __STDC_EMBED_NOT_FOUND__, __STDC_EMBED_FOUND__ and
// __STDC_EMBED_EMPTY__ say. The parameters are passed over.
fn askEmbed(at: usize) -> (usize, u64) {
    var token = tokens.next(at)
    if !tokens.is(token, names.P_LPAREN) { tokens.errorAt(at, "expected '(' after __has_embed") }
    token = tokens.next(token)
    var path: []const u8 = ""
    const from = base.nameOf(base.fileName(@intCast(u32, tokens.at(at).*.file)))
    if tokens.kind(token) == tokens.STRING {
        const text = tokens.text(token)
        path = paths.find(text[1..text.length - 1], true, from, 0)
        token = tokens.next(token)
    } else if tokens.is(token, names.P_LT) {
        token = tokens.next(token)
        const start = tokens.at(token).*.start
        var stop = start
        while !tokens.is(token, names.P_GT) {
            if tokens.isEof(token) { tokens.errorAt(at, "expected '>' in __has_embed") }
            stop = tokens.at(token).*.start + @intCast(usize, tokens.at(token).*.length)
            token = tokens.next(token)
        }
        path = paths.find(base.bytes(start, stop - start), false, from, 0)
        token = tokens.next(token)
    }
    var level: u32 = 1
    while level > 0 {
        if tokens.isEof(token) { tokens.errorAt(at, "expected ')' after __has_embed") }
        if tokens.is(token, names.P_LPAREN) { level += 1 }
        if tokens.is(token, names.P_RPAREN) { level -= 1 }
        token = tokens.next(token)
    }
    if path.length == 0 { return -> (token, 0) }
    const resource = base.readFile(path)
    if resource == 0 { return -> (token, 0) }
    return -> (token, if base.fileLength(resource) == 0 { 2 } else { 1 })
}

fn oneToken(site: usize, value: u64) -> usize {
    const text = base.keep(if value != 0 { "1" } else { "0" })
    return tokens.make(tokens.NUMBER, @intCast(u32, tokens.at(site).*.file), tokens.at(site).*.line, text, 1)
}

// __has_include("name") or (<name>) at `at`: the token after it and
// whether the file is there.
fn askInclude(at: usize) -> (usize, u64) {
    var token = tokens.next(at)
    if !tokens.is(token, names.P_LPAREN) { tokens.errorAt(at, "expected '(' after __has_include") }
    token = tokens.next(token)
    var found = false
    const from = base.nameOf(base.fileName(@intCast(u32, tokens.at(at).*.file)))
    if tokens.kind(token) == tokens.STRING {
        const text = tokens.text(token)
        found = paths.find(text[1..text.length - 1], true, from, 0).length > 0
        token = tokens.next(token)
    } else if tokens.is(token, names.P_LT) {
        token = tokens.next(token)
        const start = tokens.at(token).*.start
        var stop = start
        while !tokens.is(token, names.P_GT) {
            if tokens.isEof(token) { tokens.errorAt(at, "expected '>' in __has_include") }
            stop = tokens.at(token).*.start + @intCast(usize, tokens.at(token).*.length)
            token = tokens.next(token)
        }
        found = paths.find(base.bytes(start, stop - start), false, from, 0).length > 0
        token = tokens.next(token)
    }
    if !tokens.is(token, names.P_RPAREN) { tokens.errorAt(at, "expected ')' after __has_include") }
    return -> (tokens.next(token), if found { 1 } else { 0 })
}

// The value of the #if line `list` (ending in EOF), not 0 for true.
pub fn evaluate(list: usize) -> i64 {
    const expanded = macros.expandAll(resolveDefined(list))
    const reader = base.alloc(@sizeOf(Reader))
    readerAt(reader).*.at = expanded
    const value = conditional(reader)
    if !tokens.isEof(current(reader)) { tokens.errorAt(current(reader), "extra tokens in #if") }
    return value
}
