x = 3;
y = x * 4 + 2;
print "x", x, "y", y, x < y, x == 3, "ab" + "cd" + 5;
def square(n) { n * n; }
def fact(n) { if n <= 1 { 1; } else { n * fact(n - 1); } }
print square(7), fact(10), len("hello"), str(2.5) + "!";
i = 0; total = 0;
while i < 10 { total = total + i; i = i + 1; }
print "total", total, "rounds", i;
s = "";
k = 0;
while k < 5 { if k % 2 == 0 { s = s + "e"; } else { s = s + "o"; } k = k + 1; }
print s, len(s);
def greet(who) { "hi " + who; }
print greet("there"), greet(42);
if x > 10 { print "big"; } else if x > 2 { print "medium"; } else { print "small"; }
print 7 / 2, 7 % 2, -x, (1 + 2) * 3, 1 and 0, 0 or "yes";
