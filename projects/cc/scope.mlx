// Scopes (C11 6.2.1): what an identifier names where it is used (a
// variable or function, a typedef, an enumeration constant), and the
// tags of structs, unions and enums, which have their own name space.
// Each name has a chain of bindings, the innermost first; leaving a scope
// pops the bindings it made.
const base = @import("./base.mlx")

pub const VARIABLE: u8 = 1
pub const TYPEDEF: u8 = 2
pub const ENUM_CONSTANT: u8 = 3
pub const TAG: u8 = 4

pub const Binding = struct {
    kind: u8
    name: u32
    depth: u32
    // A variable's or function's object; a typedef's, enum constant's or
    // tag's type.
    obj: usize
    ty: usize
    value: i64
    // The binding of the same name it hides, and the next one made in the
    // same scope.
    hidden: usize
    sibling: usize
}

const MAX_DEPTH: usize = 4096

var variableHeads: usize = 0
var tagHeads: usize = 0
// Per depth: the bindings made there (ordinary names, tags).
var madeVariables: usize = 0
var madeTags: usize = 0
var depth: u32 = 0

pub fn at(binding: usize) -> *Binding {
    unsafe { return @ptrFromInt(*Binding, binding) }
}

pub fn init() -> void {
    variableHeads = base.alloc(base.MAX_NAMES * 8)
    tagHeads = base.alloc(base.MAX_NAMES * 8)
    madeVariables = base.alloc(MAX_DEPTH * 8)
    madeTags = base.alloc(MAX_DEPTH * 8)
    depth = 0
}

pub fn currentDepth() -> u32 { return depth }

pub fn isFileScope() -> bool { return depth == 0 }

pub fn enter() -> void {
    if @intCast(usize, depth) + 1 >= MAX_DEPTH { base.fatal("blocks nested too deeply") }
    depth += 1
    base.putWord(madeVariables + @intCast(usize, depth) * 8, 0)
    base.putWord(madeTags + @intCast(usize, depth) * 8, 0)
}

pub fn leave() -> void {
    var binding = base.getWord(madeVariables + @intCast(usize, depth) * 8)
    while binding != 0 {
        base.putWord(variableHeads + @intCast(usize, at(binding).*.name) * 8, at(binding).*.hidden)
        binding = at(binding).*.sibling
    }
    binding = base.getWord(madeTags + @intCast(usize, depth) * 8)
    while binding != 0 {
        base.putWord(tagHeads + @intCast(usize, at(binding).*.name) * 8, at(binding).*.hidden)
        binding = at(binding).*.sibling
    }
    depth -= 1
}

// Leaves every scope down to the file's and forgets the file's own
// bindings (the next translation unit starts empty).
pub fn reset() -> void {
    while depth > 0 { leave() }
    var binding = base.getWord(madeVariables)
    while binding != 0 {
        base.putWord(variableHeads + @intCast(usize, at(binding).*.name) * 8, 0)
        binding = at(binding).*.sibling
    }
    binding = base.getWord(madeTags)
    while binding != 0 {
        base.putWord(tagHeads + @intCast(usize, at(binding).*.name) * 8, 0)
        binding = at(binding).*.sibling
    }
    base.putWord(madeVariables, 0)
    base.putWord(madeTags, 0)
}

fn bind(heads: usize, made: usize, kind: u8, name: u32) -> usize {
    const binding = base.alloc(@sizeOf(Binding))
    const b = at(binding)
    b.*.kind = kind
    b.*.name = name
    b.*.depth = depth
    b.*.hidden = base.getWord(heads + @intCast(usize, name) * 8)
    b.*.sibling = base.getWord(made + @intCast(usize, depth) * 8)
    base.putWord(heads + @intCast(usize, name) * 8, binding)
    base.putWord(made + @intCast(usize, depth) * 8, binding)
    return binding
}

pub fn bindVariable(name: u32, obj: usize) -> usize {
    const binding = bind(variableHeads, madeVariables, VARIABLE, name)
    at(binding).*.obj = obj
    return binding
}

pub fn bindTypedef(name: u32, ty: usize) -> usize {
    const binding = bind(variableHeads, madeVariables, TYPEDEF, name)
    at(binding).*.ty = ty
    return binding
}

pub fn bindEnumConstant(name: u32, ty: usize, value: i64) -> usize {
    const binding = bind(variableHeads, madeVariables, ENUM_CONSTANT, name)
    at(binding).*.ty = ty
    at(binding).*.value = value
    return binding
}

pub fn bindTag(name: u32, ty: usize) -> usize {
    const binding = bind(tagHeads, madeTags, TAG, name)
    at(binding).*.ty = ty
    return binding
}

// The innermost binding of `name`, 0 when there is none.
pub fn find(name: u32) -> usize {
    return base.getWord(variableHeads + @intCast(usize, name) * 8)
}

pub fn findTag(name: u32) -> usize {
    return base.getWord(tagHeads + @intCast(usize, name) * 8)
}

// The binding of `name` made in the current scope itself, 0 when none.
pub fn findHere(name: u32) -> usize {
    const binding = find(name)
    if binding != 0 && at(binding).*.depth == depth { return binding }
    return 0
}

pub fn findTagHere(name: u32) -> usize {
    const binding = findTag(name)
    if binding != 0 && at(binding).*.depth == depth { return binding }
    return 0
}

// The typedef `name` stands for, 0 when it names no type here.
pub fn typedefOf(name: u32) -> usize {
    const binding = find(name)
    if binding != 0 && at(binding).*.kind == TYPEDEF { return at(binding).*.ty }
    return 0
}
