// Tokens. A token lives in the arena and is known by its address; tokens
// form singly linked lists through `next`, ending in an EOF token. The
// preprocessor copies them as it expands macros (each copy carries the
// hide set of the macros it came out of), so a token is never shared
// between two lists.
const base = @import("./base.mlx")
const names = @import("./names.mlx")

pub const IDENT: u8 = 1
pub const PUNCT: u8 = 2
// A preprocessing number: its text, read as a constant by the parser.
pub const NUMBER: u8 = 3
// A character constant: its value.
pub const CHAR: u8 = 4
// A string literal: its text with the quotes (and any prefix), decoded
// by the parser.
pub const STRING: u8 = 5
pub const EOF: u8 = 6
// After preprocessing: a keyword, and a number read as an integer or a
// floating constant (its value's bits).
pub const KEYWORD: u8 = 7
pub const INTEGER: u8 = 8
pub const FLOATING: u8 = 9

// Flags: the first token of a line, whitespace before it.
pub const AT_LINE_START: u8 = 1
pub const SPACE_BEFORE: u8 = 2
// A macro's name met inside that macro's own expansion: never expanded
// again (wherever the token goes).
pub const PAINTED: u8 = 4

pub const Token = struct {
    kind: u8
    flags: u8
    file: u16
    line: u32
    // An identifier's or a punctuator's name.
    name: u32
    length: u32
    // Where its text is.
    start: usize
    value: u64
    // The hide set (preprocess.mlx), 0 when empty.
    hide: usize
    next: usize
    // After preprocessing (literal.mlx): a constant's or string's C type
    // and a string's decoded bytes.
    ty: usize
    data: usize
}

pub fn at(token: usize) -> *Token {
    unsafe { return @ptrFromInt(*Token, token) }
}

pub fn make(kind: u8, file: u32, line: u32, start: usize, length: usize) -> usize {
    const token = base.alloc(@sizeOf(Token))
    base.count(base.STAT_TOKENS, @sizeOf(Token))
    const t = at(token)
    t.*.kind = kind
    t.*.file = @intCast(u16, file)
    t.*.line = line
    t.*.start = start
    t.*.length = @intCast(u32, length)
    return token
}

// A copy of `token` with no next.
pub fn copy(token: usize) -> usize {
    const result = base.alloc(@sizeOf(Token))
    base.count(base.STAT_TOKENS, @sizeOf(Token))
    base.copy(result, token, @sizeOf(Token))
    at(result).*.next = 0
    return result
}

pub fn eof(file: u32, line: u32) -> usize {
    return make(EOF, file, line, 0, 0)
}

pub fn text(token: usize) -> []const u8 {
    return base.bytes(at(token).*.start, @intCast(usize, at(token).*.length))
}

pub fn kind(token: usize) -> u8 { return at(token).*.kind }
pub fn next(token: usize) -> usize { return at(token).*.next }
pub fn name(token: usize) -> u32 { return at(token).*.name }

// Whether `token` is the punctuator or identifier `id`.
pub fn is(token: usize, id: u32) -> bool {
    const t = at(token)
    return (t.*.kind == PUNCT || t.*.kind == IDENT) && t.*.name == id
}

// Whether `token` is the keyword `id`.
pub fn isWord(token: usize, id: u32) -> bool {
    const t = at(token)
    return t.*.kind == KEYWORD && t.*.name == id
}

pub fn isEof(token: usize) -> bool { return at(token).*.kind == EOF }

pub fn atLineStart(token: usize) -> bool { return at(token).*.flags & AT_LINE_START != 0 }

pub fn errorAt(token: usize, message: []const u8) -> void {
    base.errorAt(@intCast(u32, at(token).*.file), at(token).*.line, message)
}

pub fn warnAt(token: usize, message: []const u8) -> void {
    base.warnAt(@intCast(u32, at(token).*.file), at(token).*.line, message)
}

// Says `token`'s text (for -E and the messages).
pub fn say(token: usize) -> void {
    base.say(text(token))
}
