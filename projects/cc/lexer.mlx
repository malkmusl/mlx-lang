// The lexer: a source file into a list of preprocessing tokens (C11 6.4).
// Before that the file's lines are spliced (a backslash before a newline
// joins the two lines; the newline is put back at the end of the joined
// line, so the line numbers stay right) and CR LF becomes LF. Comments
// become whitespace. Each token knows its file and line, whether it starts
// a line (the preprocessor's directives) and whether whitespace came
// before it (stringizing keeps one space there).
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")

fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }

fn isIdentStart(c: u8) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c == 36 || c >= 128
}

fn isIdentRest(c: u8) -> bool { return isIdentStart(c) || isDigit(c) }

fn isHex(c: u8) -> bool { return isDigit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

fn hexValue(c: u8) -> u64 {
    if isDigit(c) { return @intCast(u64, c - 48) }
    if c >= 97 { return @intCast(u64, c - 97 + 10) }
    return @intCast(u64, c - 65 + 10)
}

// The file's text with its lines spliced; its address (NUL-ended) and
// length.
fn splice(file: u32) -> (usize, usize) {
    const data = base.fileData(file)
    const length = base.fileLength(file)
    const out = base.alloc(length + 2)
    var read: usize = 0
    var written: usize = 0
    var pending: usize = 0
    while read < length {
        const c = base.get8(data + read)
        if c == 92 && read + 1 < length && base.get8(data + read + 1) == 10 {
            read += 2
            pending += 1
        } else if c == 92 && read + 2 < length && base.get8(data + read + 1) == 13 && base.get8(data + read + 2) == 10 {
            read += 3
            pending += 1
        } else if c == 13 && read + 1 < length && base.get8(data + read + 1) == 10 {
            read += 1
        } else if c == 10 {
            base.put8(out + written, 10)
            written += 1
            read += 1
            while pending > 0 {
                base.put8(out + written, 10)
                written += 1
                pending -= 1
            }
        } else {
            base.put8(out + written, c)
            written += 1
            read += 1
        }
    }
    // A file that does not end its last line gets a newline.
    if written == 0 || base.get8(out + written - 1) != 10 {
        base.put8(out + written, 10)
        written += 1
    }
    base.put8(out + written, 0)
    return -> (out, written)
}

// The value of the escape sequence after the backslash at `at`; the value
// and where the text goes on.
pub fn escape(at: usize) -> (u64, usize) {
    const c = base.get8(at)
    if c >= 48 && c <= 55 {
        var value: u64 = 0
        var index: usize = 0
        while index < 3 && base.get8(at + index) >= 48 && base.get8(at + index) <= 55 {
            value = value * 8 + @intCast(u64, base.get8(at + index) - 48)
            index += 1
        }
        return -> (value, at + index)
    }
    if c == 120 {
        var value: u64 = 0
        var index: usize = 1
        while isHex(base.get8(at + index)) {
            value = value * 16 + hexValue(base.get8(at + index))
            index += 1
        }
        return -> (value, at + index)
    }
    if c == 117 || c == 85 {
        // A universal character name: \uXXXX or \UXXXXXXXX.
        const digits: usize = if c == 117 { 4 } else { 8 }
        var value: u64 = 0
        var index: usize = 1
        while index <= digits && isHex(base.get8(at + index)) {
            value = value * 16 + hexValue(base.get8(at + index))
            index += 1
        }
        return -> (value, at + index)
    }
    const value: u64 = match c {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        101 => 27,
        else => @intCast(u64, c),
    }
    return -> (value, at + 1)
}

// The length of the punctuator at `at` and its id (0: none).
fn punctuator(at: usize) -> (usize, u32) {
    const a = base.get8(at)
    const b = base.get8(at + 1)
    const c = base.get8(at + 2)
    if a == 46 && b == 46 && c == 46 { return -> (3, names.P_ELLIPSIS) }
    if a == 60 && b == 60 && c == 61 { return -> (3, names.P_SHL_ASSIGN) }
    if a == 62 && b == 62 && c == 61 { return -> (3, names.P_SHR_ASSIGN) }
    if b == 61 {
        if a == 61 { return -> (2, names.P_EQ) }
        if a == 33 { return -> (2, names.P_NE) }
        if a == 60 { return -> (2, names.P_LE) }
        if a == 62 { return -> (2, names.P_GE) }
        if a == 43 { return -> (2, names.P_ADD_ASSIGN) }
        if a == 45 { return -> (2, names.P_SUB_ASSIGN) }
        if a == 42 { return -> (2, names.P_MUL_ASSIGN) }
        if a == 47 { return -> (2, names.P_DIV_ASSIGN) }
        if a == 37 { return -> (2, names.P_MOD_ASSIGN) }
        if a == 38 { return -> (2, names.P_AND_ASSIGN) }
        if a == 124 { return -> (2, names.P_OR_ASSIGN) }
        if a == 94 { return -> (2, names.P_XOR_ASSIGN) }
    }
    if a == 45 && b == 62 { return -> (2, names.P_ARROW) }
    if a == 43 && b == 43 { return -> (2, names.P_INC) }
    if a == 45 && b == 45 { return -> (2, names.P_DEC) }
    if a == 60 && b == 60 { return -> (2, names.P_SHL) }
    if a == 62 && b == 62 { return -> (2, names.P_SHR) }
    if a == 38 && b == 38 { return -> (2, names.P_ANDAND) }
    if a == 124 && b == 124 { return -> (2, names.P_OROR) }
    if a == 35 && b == 35 { return -> (2, names.P_HASHHASH) }
    const single: u32 = match a {
        40 => names.P_LPAREN,
        41 => names.P_RPAREN,
        123 => names.P_LBRACE,
        125 => names.P_RBRACE,
        91 => names.P_LBRACKET,
        93 => names.P_RBRACKET,
        59 => names.P_SEMI,
        44 => names.P_COMMA,
        46 => names.P_DOT,
        43 => names.P_PLUS,
        45 => names.P_MINUS,
        42 => names.P_STAR,
        47 => names.P_SLASH,
        37 => names.P_PERCENT,
        38 => names.P_AMP,
        124 => names.P_PIPE,
        94 => names.P_CARET,
        126 => names.P_TILDE,
        33 => names.P_BANG,
        63 => names.P_QUESTION,
        58 => names.P_COLON,
        61 => names.P_ASSIGN,
        60 => names.P_LT,
        62 => names.P_GT,
        35 => names.P_HASH,
        else => 0,
    }
    if single == 0 { return -> (0, 0) }
    return -> (1, single)
}

// The end of the quoted text starting at `at` (the quote `quote`), after
// its closing quote.
fn quotedEnd(file: u32, line: u32, at: usize, quote: u8) -> usize {
    var index = at + 1
    while true {
        const c = base.get8(index)
        if c == quote { return index + 1 }
        if c == 10 || c == 0 { base.errorAt(file, line, if quote == 34 { "unterminated string literal" } else { "unterminated character constant" }) }
        if c == 92 { index += 2 } else { index += 1 }
    }
    return index
}

// The length of a string or character prefix at `at` (u8, u, U, L)
// followed by `quote`, 0 when there is none.
fn prefixed(at: usize, quote: u8) -> usize {
    const a = base.get8(at)
    if (a == 76 || a == 85) && base.get8(at + 1) == quote { return 1 }
    if a == 117 {
        if base.get8(at + 1) == quote { return 1 }
        if base.get8(at + 1) == 56 && base.get8(at + 2) == quote { return 2 }
    }
    return 0
}

// The tokens of `file`, ending in EOF; the first one's address.
pub fn tokenize(file: u32) -> usize {
    const spliced = splice(file)
    const text = spliced.0
    const end = text + spliced.1
    var head: usize = 0
    var tail: usize = 0
    var at = text
    var line: u32 = 1
    var lineStart = true
    var space = false
    while at < end {
        const c = base.get8(at)
        if c == 10 {
            line += 1
            at += 1
            lineStart = true
            space = false
            continue
        }
        if c == 32 || c == 9 || c == 12 || c == 11 || c == 13 {
            at += 1
            space = true
            continue
        }
        if c == 47 && base.get8(at + 1) == 47 {
            while at < end && base.get8(at) != 10 { at += 1 }
            space = true
            continue
        }
        if c == 47 && base.get8(at + 1) == 42 {
            const opened = line
            at += 2
            while true {
                if at >= end { base.errorAt(file, opened, "unterminated comment") }
                if base.get8(at) == 42 && base.get8(at + 1) == 47 { break }
                if base.get8(at) == 10 { line += 1 }
                at += 1
            }
            at += 2
            space = true
            continue
        }
        var token: usize = 0
        const string_prefix = prefixed(at, 34)
        const char_prefix = prefixed(at, 39)
        if c == 34 || string_prefix > 0 {
            const stop = quotedEnd(file, line, at + string_prefix, 34)
            token = tokens.make(tokens.STRING, file, line, at, stop - at)
            at = stop
        } else if c == 39 || char_prefix > 0 {
            const quote = at + char_prefix
            const stop = quotedEnd(file, line, quote, 39)
            token = tokens.make(tokens.CHAR, file, line, at, stop - at)
            var value: u64 = @intCast(u64, base.get8(quote + 1))
            if base.get8(quote + 1) == 92 {
                const escaped = escape(quote + 2)
                value = escaped.0
            } else if value >= 128 && char_prefix > 0 {
                value = utf8Value(quote + 1)
            }
            // A plain char is signed: '\xff' is -1.
            if char_prefix == 0 && value >= 128 && value < 256 { value = value | 18446744073709551360 }
            tokens.at(token).*.value = value
            at = stop
        } else if isDigit(c) || (c == 46 && isDigit(base.get8(at + 1))) {
            var stop = at + 1
            while true {
                const d = base.get8(stop)
                const previous = base.get8(stop - 1)
                if (d == 43 || d == 45) && (previous == 101 || previous == 69 || previous == 112 || previous == 80) {
                    stop += 1
                } else if isIdentRest(d) || d == 46 {
                    stop += 1
                } else {
                    break
                }
            }
            token = tokens.make(tokens.NUMBER, file, line, at, stop - at)
            at = stop
        } else if isIdentStart(c) {
            var stop = at + 1
            while isIdentRest(base.get8(stop)) { stop += 1 }
            token = tokens.make(tokens.IDENT, file, line, at, stop - at)
            tokens.at(token).*.name = base.intern(base.bytes(at, stop - at))
            at = stop
        } else {
            const found = punctuator(at)
            if found.0 == 0 {
                // Any other character is a token of its own (C11 6.4.1):
                // the preprocessor may stringize it; the parser refuses it.
                token = tokens.make(tokens.PUNCT, file, line, at, 1)
                tokens.at(token).*.name = base.intern(base.bytes(at, 1))
                at += 1
            } else {
                token = tokens.make(tokens.PUNCT, file, line, at, found.0)
                tokens.at(token).*.name = found.1
                at += found.0
            }
        }
        var flags: u8 = 0
        if lineStart { flags = flags | tokens.AT_LINE_START }
        if space { flags = flags | tokens.SPACE_BEFORE }
        tokens.at(token).*.flags = flags
        lineStart = false
        space = false
        if head == 0 { head = token } else { tokens.at(tail).*.next = token }
        tail = token
    }
    const last = tokens.eof(file, line)
    tokens.at(last).*.flags = tokens.AT_LINE_START
    if head == 0 { return last }
    tokens.at(tail).*.next = last
    return head
}

// The code point of the UTF-8 sequence at `at`.
fn utf8Value(at: usize) -> u64 {
    const c = base.get8(at)
    if c < 128 { return @intCast(u64, c) }
    var count: usize = 1
    var value: u64 = 0
    if c >= 240 {
        count = 4
        value = @intCast(u64, c & 7)
    } else if c >= 224 {
        count = 3
        value = @intCast(u64, c & 15)
    } else {
        count = 2
        value = @intCast(u64, c & 31)
    }
    var index: usize = 1
    while index < count {
        value = (value << 6) | @intCast(u64, base.get8(at + index) & 63)
        index += 1
    }
    return value
}
