// What every part of mlx-cc stands on: one arena of memory that is never
// freed (a compiler run is short), the bytes in it by address, the names
// table (every identifier, keyword and punctuator interned once, so they
// compare as numbers), the source files read whole, and the messages: an
// error says the file and the line and ends the run.
const std = @import("std")

const SYS_read: usize = 0
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231
const O_RDONLY: usize = 0
const O_CLOEXEC: usize = 524288

// The arena: 8 GiB of address space, reserved without committing it
// (MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE): only what is touched
// counts, and fresh pages are zero.
const ARENA_SIZE: usize = 8589934592

var arenaNext: usize = 0
var arenaEnd: usize = 0

// The names: an open-addressed table of ids and, by id, where each name's
// bytes are.
const NAME_SLOTS: usize = 1048576
pub const MAX_NAMES: usize = 524288

var nameSlots: usize = 0
var nameEntries: usize = 0
var nameCount: u32 = 0

// The source files, by id: their path (a name) and their bytes.
pub const MAX_FILES: usize = 4096
var fileEntries: usize = 0
var fileCount: u32 = 0

pub fn init() -> bool {
    const base = std.linux.syscall6(SYS_mmap, 0, ARENA_SIZE, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
    if base < 0 { return false }
    arenaNext = @bitCast(usize, base)
    arenaEnd = arenaNext + ARENA_SIZE
    nameSlots = alloc(NAME_SLOTS * 4)
    nameEntries = alloc(MAX_NAMES * 16)
    nameCount = 1
    fileEntries = alloc(MAX_FILES * 24)
    fileCount = 1
    return true
}

// `size` bytes of zeroed memory, 16-byte aligned; its address.
pub fn alloc(size: usize) -> usize {
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fatal("out of memory") }
    arenaNext = at + size
    return at
}

// ---------------------------------------------------------------------------
// Bytes by address

pub fn get8(address: usize) -> u8 {
    unsafe { return @ptrFromInt(*u8, address).* }
}

pub fn put8(address: usize, value: u8) -> void {
    unsafe { @ptrFromInt(*u8, address).* = value }
}

pub fn get32(address: usize) -> u32 {
    unsafe { return @ptrFromInt(*u32, address).* }
}

pub fn put32(address: usize, value: u32) -> void {
    unsafe { @ptrFromInt(*u32, address).* = value }
}

pub fn get64(address: usize) -> u64 {
    unsafe { return @ptrFromInt(*u64, address).* }
}

pub fn put64(address: usize, value: u64) -> void {
    unsafe { @ptrFromInt(*u64, address).* = value }
}

// A word that holds an address or a size.
pub fn getWord(address: usize) -> usize {
    unsafe { return @ptrFromInt(*usize, address).* }
}

pub fn putWord(address: usize, value: usize) -> void {
    unsafe { @ptrFromInt(*usize, address).* = value }
}

pub fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

pub fn pointer(address: usize) -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, address) }
}

pub fn copy(target: usize, source: usize, length: usize) -> void {
    var index: usize = 0
    while index < length {
        put8(target + index, get8(source + index))
        index += 1
    }
}

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// Writes `text` at `address`.
pub fn putText(address: usize, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        put8(address + index, text[index])
        index += 1
    }
}

// A copy of `text` in the arena with a NUL after it; its address.
pub fn keep(text: []const u8) -> usize {
    const at = alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        put8(at + index, text[index])
        index += 1
    }
    return at
}

// `first` followed by `second`, kept in the arena (messages).
pub fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    putText(at, first)
    putText(at + first.length, second)
    return bytes(at, first.length + second.length)
}

// The decimal digits of `value`, kept in the arena.
pub fn decimal(value: u64) -> []const u8 {
    const at = alloc(24)
    var count: usize = 0
    var rest = value
    while true {
        put8(at + 23 - count, @intCast(u8, 48 + rest % 10))
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    return bytes(at + 24 - count, count)
}

// The length of the NUL-ended text at `address`.
pub fn cLength(address: usize) -> usize {
    var length: usize = 0
    while get8(address + length) != 0 { length += 1 }
    return length
}

// ---------------------------------------------------------------------------
// Names

fn hashOf(text: []const u8) -> u32 {
    var hash: u64 = 2166136261
    var index: usize = 0
    while index < text.length {
        hash = ((hash ^ @intCast(u64, text[index])) * 16777619) & 4294967295
        index += 1
    }
    return @intCast(u32, hash)
}

fn entryAddress(id: u32) -> usize { return nameEntries + @intCast(usize, id) * 16 }

// The id of `text`, interned on first sight (the text is kept).
pub fn intern(text: []const u8) -> u32 {
    const hash = hashOf(text)
    var slot = @intCast(usize, hash) & (NAME_SLOTS - 1)
    while true {
        const found = get32(nameSlots + slot * 4)
        if found == 0 { break }
        const at = entryAddress(found)
        if get32(at + 12) == hash && same(bytes(getWord(at), @intCast(usize, get32(at + 8))), text) { return found }
        slot = (slot + 1) & (NAME_SLOTS - 1)
    }
    if @intCast(usize, nameCount) >= MAX_NAMES { fatal("too many names") }
    const id = nameCount
    nameCount += 1
    const entry = entryAddress(id)
    putWord(entry, keep(text))
    put32(entry + 8, @intCast(u32, text.length))
    put32(entry + 12, hash)
    put32(nameSlots + slot * 4, id)
    return id
}

pub fn nameOf(id: u32) -> []const u8 {
    const entry = entryAddress(id)
    return bytes(getWord(entry), @intCast(usize, get32(entry + 8)))
}

// The name's NUL-ended text (for the object writer).
pub fn nameAddress(id: u32) -> usize { return getWord(entryAddress(id)) }

pub fn names() -> u32 { return nameCount }

// ---------------------------------------------------------------------------
// Files

fn fileAddress(id: u32) -> usize { return fileEntries + @intCast(usize, id) * 24 }

pub fn fileName(id: u32) -> u32 { return get32(fileAddress(id)) }
pub fn fileData(id: u32) -> usize { return getWord(fileAddress(id) + 8) }
pub fn fileLength(id: u32) -> usize { return getWord(fileAddress(id) + 16) }

// Reads the file at `path` whole; its id, 0 when it cannot be read. A NUL
// follows its bytes.
pub fn readFile(path: []const u8) -> u32 {
    if @intCast(usize, fileCount) >= MAX_FILES { fatal("too many files") }
    const name = keep(path)
    const descriptor = std.linux.syscall3(SYS_open, name, O_RDONLY | O_CLOEXEC, 0)
    if descriptor < 0 { return 0 }
    var capacity: usize = 65536
    var data = alloc(capacity + 1)
    var length: usize = 0
    while true {
        if length == capacity {
            const larger = alloc(capacity * 2 + 1)
            copy(larger, data, length)
            data = larger
            capacity = capacity * 2
        }
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    put8(data + length, 0)
    const id = fileCount
    fileCount += 1
    put32(fileAddress(id), intern(path))
    putWord(fileAddress(id) + 8, data)
    putWord(fileAddress(id) + 16, length)
    return id
}

// A file made of `text` (the predefined macros, the command line's -D).
pub fn textFile(name: []const u8, text: []const u8) -> u32 {
    const id = fileCount
    fileCount += 1
    put32(fileAddress(id), intern(name))
    putWord(fileAddress(id) + 8, keep(text))
    putWord(fileAddress(id) + 16, text.length)
    return id
}

// ---------------------------------------------------------------------------
// Messages

pub fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

pub fn sayNumber(value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    say(view[24 - count..24])
}

pub fn exit(status: usize) -> void {
    const ignored = std.linux.syscall1(SYS_exit_group, status)
}

pub fn fatal(message: []const u8) -> void {
    say("mlx-cc: ")
    say(message)
    say("\n")
    exit(1)
}

// "file:line: error: message" and the end of the run.
pub fn errorAt(file: u32, line: u32, message: []const u8) -> void {
    if file != 0 { say(nameOf(fileName(file))) } else { say("mlx-cc") }
    say(":")
    sayNumber(@intCast(u64, line))
    say(": error: ")
    say(message)
    say("\n")
    exit(1)
}

pub fn warnAt(file: u32, line: u32, message: []const u8) -> void {
    if file != 0 { say(nameOf(fileName(file))) } else { say("mlx-cc") }
    say(":")
    sayNumber(@intCast(u64, line))
    say(": warning: ")
    say(message)
    say("\n")
}
