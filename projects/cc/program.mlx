// The whole program: the translation units' objects linked by name (a
// name with external linkage stands for one definition; the ones no file
// defines come from the C library), the globals placed in the data area,
// the code of every function, the entry point and the run-time
// relocation of addresses held by globals, written as one dynamically
// linked ELF executable. There is no assembler or linker in between.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const x86 = @import("./x86.mlx")
const gen = @import("./gen.mlx")
const genstmt = @import("./genstmt.mlx")
const encoder = @import("../../compiler/selfhost/backend/x86_64/encoder.mlx")
const elf64_dynamic = @import("../../compiler/selfhost/object/elf64_dynamic.mlx")

const MAX_UNITS: usize = 4096

var units: usize = 0
var unitCount: usize = 0
// By name id: the object a name with external linkage stands for.
var definitions: usize = 0
var initName: u32 = 0

pub fn init() -> void {
    units = base.alloc(MAX_UNITS * 8)
    definitions = base.alloc(base.MAX_NAMES * 8)
    initName = base.intern("__mlxcc_init")
}

pub fn addUnit(globals: usize) -> void {
    if unitCount >= MAX_UNITS { base.fatal("too many files") }
    base.putWord(units + unitCount * 8, globals)
    unitCount += 1
}

fn definitionOf(name: u32) -> usize { return base.getWord(definitions + @intCast(usize, name) * 8) }

fn setDefinition(name: u32, o: usize) -> void { base.putWord(definitions + @intCast(usize, name) * 8, o) }

fn isInitialized(o: usize) -> bool {
    return ast.obj(o).*.initData != 0 && !ast.obj(o).*.isTentative
}

// Chooses the definition of every name with external linkage.
fn link() -> void {
    var unit: usize = 0
    while unit < unitCount {
        var o = base.getWord(units + unit * 8)
        while o != 0 {
            const obj = ast.obj(o)
            if !obj.*.isStatic && obj.*.name != 0 && obj.*.isDefinition {
                const known = definitionOf(obj.*.name)
                if known == 0 {
                    setDefinition(obj.*.name, o)
                } else if known != o {
                    if obj.*.isFunction != ast.obj(known).*.isFunction {
                        base.fatal(base.join("a function and a variable share the name ", base.nameOf(obj.*.name)))
                    }
                    if obj.*.isFunction || (isInitialized(o) && isInitialized(known)) {
                        base.fatal(base.join("multiple definitions of ", base.nameOf(obj.*.name)))
                    }
                    // An initialized definition wins over tentative ones; of
                    // tentative ones the larger.
                    if isInitialized(o) || (!isInitialized(known) && types.size(obj.*.ty) > types.size(ast.obj(known).*.ty)) {
                        setDefinition(obj.*.name, o)
                    }
                }
            }
            o = obj.*.next
        }
        unit += 1
    }
    unit = 0
    while unit < unitCount {
        var o = base.getWord(units + unit * 8)
        while o != 0 {
            const obj = ast.obj(o)
            if obj.*.isStatic || obj.*.name == 0 {
                obj.*.definition = if obj.*.isDefinition { o } else { 0 }
                if obj.*.isFunction && obj.*.isDefinition && obj.*.name != 0 {
                    // A static function's symbol, unique among the files.
                    const unique = base.join(base.join(base.nameOf(obj.*.name), "."), base.decimal(@intCast(u64, unit)))
                    obj.*.symbol = base.intern(unique)
                }
            } else {
                obj.*.definition = definitionOf(obj.*.name)
            }
            o = obj.*.next
        }
        unit += 1
    }
}

// Places every defined variable in the data area.
fn placeData() -> void {
    var unit: usize = 0
    while unit < unitCount {
        var o = base.getWord(units + unit * 8)
        while o != 0 {
            const obj = ast.obj(o)
            if !obj.*.isFunction && obj.*.isDefinition && obj.*.definition == o && !obj.*.placed {
                var size = types.size(obj.*.ty)
                if types.at(obj.*.ty).*.incomplete {
                    // `int a[];` never completed: one element (C11 6.9.2).
                    if types.kind(obj.*.ty) != types.ARRAY { base.errorAt(obj.*.file, 0, "a variable has an incomplete type") }
                    size = types.size(types.baseOf(obj.*.ty))
                }
                if size == 0 { size = 1 }
                var alignment = obj.*.alignment
                if alignment < 1 { alignment = types.alignOf(obj.*.ty) }
                if alignment < 1 { alignment = 1 }
                const count: usize = if obj.*.initData != 0 { @intCast(usize, size) } else { 0 }
                obj.*.dataOffset = x86.reserve(@intCast(usize, size), @intCast(usize, alignment), obj.*.initData, count)
                obj.*.placed = true
            }
            o = obj.*.next
        }
        unit += 1
    }
}

// The entry point: run the relocations, call main(argc, argv, envp),
// exit with its result.
fn genStart() -> void {
    const main = definitionOf(names.D_MAIN)
    if main == 0 || !ast.obj(main).*.isFunction { base.fatal("the program has no main function") }
    const start = base.nameOf(names.D_START)
    x86.defineSymbol(base.nameAddress(names.D_START), start.length)
    x86.moveImmediate(x86.RBP, 0)
    x86.callSymbol(base.nameAddress(initName), base.nameOf(initName).length)
    x86.load(x86.RDI, x86.RSP, 0, 8, false)
    x86.leaOffset(x86.RSI, x86.RSP, 8)
    x86.move(x86.RDX, x86.RDI)
    x86.shiftImmediate(x86.RDX, 3, true, false)
    x86.add(x86.RDX, x86.RSI)
    x86.leaOffset(x86.RDX, x86.RDX, 8)
    const symbol = ast.obj(main).*.symbol
    x86.moveImmediate(x86.RAX, 0)
    x86.callSymbol(base.nameAddress(symbol), base.nameOf(symbol).length)
    x86.move(x86.RDI, x86.RAX)
    const exitName = base.nameOf(names.D_EXIT)
    x86.callImport(base.nameAddress(names.D_EXIT), exitName.length, 0)
}

// __mlxcc_init: writes the addresses globals hold (they are only known
// once the program is loaded).
fn genInit() -> void {
    x86.defineSymbol(base.nameAddress(initName), base.nameOf(initName).length)
    var unit: usize = 0
    while unit < unitCount {
        var o = base.getWord(units + unit * 8)
        while o != 0 {
            const obj = ast.obj(o)
            if obj.*.placed {
                var r = obj.*.relocations
                while r != 0 {
                    const rel = ast.relocation(r)
                    x86.dataAddress(x86.RDI, obj.*.dataOffset + @intCast(usize, rel.*.offset))
                    gen.globalAddress(x86.RAX, rel.*.target)
                    if rel.*.addend != 0 {
                        x86.moveImmediate(x86.RDX, rel.*.addend)
                        x86.add(x86.RAX, x86.RDX)
                    }
                    x86.store(x86.RDI, 0, x86.RAX, 8)
                    r = rel.*.next
                }
            }
            o = obj.*.next
        }
        unit += 1
    }
    x86.byte(195)
}

fn genFunctions() -> void {
    var unit: usize = 0
    while unit < unitCount {
        var o = base.getWord(units + unit * 8)
        while o != 0 {
            const obj = ast.obj(o)
            if obj.*.isFunction && obj.*.isDefinition && obj.*.definition == o {
                // Static functions nothing refers to are left out (the
                // inline functions of headers).
                if !obj.*.isStatic || obj.*.isReferenced {
                    genstmt.genFunction(o)
                }
            }
            o = obj.*.next
        }
        unit += 1
    }
}

// Generates the program and writes it to `output`.
pub fn write(output: []const u8) -> void {
    link()
    placeData()
    genStart()
    genInit()
    genFunctions()
    const enc = x86.enc()
    if !encoder.applyFixups(enc) {
        const length = encoder.unresolvedFixupLength(enc)
        var missing: []const u8 = "?"
        if length > 0 {
            const at = base.alloc(length + 1)
            var view: [*]const u8 = encoder.unresolvedFixupPointer(enc)
            var index: usize = 0
            while index < length {
                base.put8(at + index, view[index])
                index += 1
            }
            missing = base.bytes(at, length)
        }
        base.fatal(base.join("undefined symbol: ", missing))
    }
    var needed: [1][*]const u8 = undefined
    unsafe { needed[0] = @ptrCast([*]const u8, "libc.so.6") }
    var list: [*]const [*]const u8 = undefined
    unsafe { list = @ptrCast([*]const [*]const u8, &needed) }
    const path = base.keep(output)
    if !elf64_dynamic.writeExecutable(enc.*.allocator, enc, list, 1, base.pointer(path)) {
        base.fatal(base.join("cannot write ", output))
    }
}
