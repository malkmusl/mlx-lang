// Gives every expression node its type (C11 6.5), inserting the
// conversions the operators imply: the usual arithmetic conversions of
// binary operators, the integer promotions of unary ones, the conversion
// of an assigned value to the object's type. Nodes made by the parser
// already typed (constants, calls, casts) keep their type.
const base = @import("./base.mlx")
const ast = @import("./ast.mlx")
const types = @import("./types.mlx")
const state = @import("./state.mlx")
const standard = @import("./standard.mlx")
const cpp = @import("./cpp.mlx")
const expr = @import("./expr.mlx")

// A wide integer (_BitInt over 64 bits) lives in memory: the result of
// an operation on one gets a temporary of the function's (of
// __mlxcc_init's at file scope), whose address the generated code
// hands around (gen.mlx).
fn wideTemporary(n: usize) -> void {
    const node = ast.node(n)
    if !types.isWide(node.*.ty) { return }
    const o = ast.newObj(0, node.*.ty, node.*.token)
    ast.obj(o).*.isLocal = true
    ast.obj(o).*.alignment = 8
    if state.currentFunction() != 0 { state.addLocal(o) } else { state.addInitLocal(o) }
    node.*.returnBuffer = o
}

// Whether the expression names an object (its address can be taken).
pub fn isLvalue(n: usize) -> bool {
    const k = ast.kindOf(n)
    if k == ast.VAR { return !ast.obj(ast.node(n).*.variable).*.isFunction }
    if k == ast.DEREF { return true }
    if k == ast.MEMBER { return types.member(ast.node(n).*.member).*.bitWidth == 0 }
    if k == ast.COMMA { return isLvalue(ast.node(n).*.rhs) }
    return false
}

// C++'s decltype of the expression `n`: for a name or a member access
// (`named`) the type it was declared with, else by its category: T&& of
// an xvalue, T& of an lvalue, T of a prvalue.
pub fn decltypeOf(n: usize, named: bool) -> usize {
    addType(n)
    const ty = ast.typeOf(n)
    const k = ast.kindOf(n)
    if named {
        if k == ast.VAR { return ast.obj(ast.node(n).*.variable).*.ty }
        if k == ast.MEMBER { return types.member(ast.node(n).*.member).*.ty }
        if k == ast.DEREF {
            // A reference variable or member, read through.
            const inner = ast.node(n).*.lhs
            if ast.kindOf(inner) == ast.VAR && types.isReference(ast.obj(ast.node(inner).*.variable).*.ty) { return ast.obj(ast.node(inner).*.variable).*.ty }
            if ast.kindOf(inner) == ast.MEMBER && types.isReference(types.member(ast.node(inner).*.member).*.ty) { return types.member(ast.node(inner).*.member).*.ty }
        }
        return ty
    }
    if types.kind(ty) == types.FUNC || types.kind(ty) == types.VOID { return ty }
    if ast.node(n).*.xvalue { return types.rvalueReferenceTo(ty) }
    if expr.isRvalueArgument(n) { return ty }
    if isLvalue(n) { return types.referenceTo(ty) }
    return ty
}

// A temporary of type `ty` in the function (or in __mlxcc_init).
pub fn temporaryOf(ty: usize, token: usize) -> usize {
    const o = ast.newObj(0, ty, token)
    ast.obj(o).*.isLocal = true
    ast.obj(o).*.alignment = types.alignOf(ty)
    if state.currentFunction() != 0 { state.addLocal(o) } else { state.addInitLocal(o) }
    return o
}

// `expression` bound to a C++ reference of type `ref`: its address (an
// object), or a temporary's holding its value.
pub fn toReference(expression: usize, ref: usize) -> usize {
    addType(expression)
    const token = ast.tokenOf(expression)
    const base_type = types.baseOf(ref)
    if standard.cpp {
        // Another class's object through its conversion operator.
        const converted = cpp.classConversion(expression, base_type)
        if converted != 0 { return toReference(converted, ref) }
    }
    // An object of the type (or of a class: a derived one binds to a
    // base's reference), or a call's result; an object of another type
    // (an array for a pointer, an int for a long) goes through a
    // temporary of the type.
    const sameObject = types.compatible(ast.typeOf(expression), base_type) || cpp.isClassType(base_type) || cpp.isClassType(ast.typeOf(expression)) || types.kind(base_type) == types.VOID
    // A function binds to a reference to a function by its address.
    const function = types.kind(base_type) == types.FUNC && types.kind(ast.typeOf(expression)) == types.FUNC
    if function || (isLvalue(expression) && sameObject) || (ast.kindOf(expression) == ast.FUNCALL && ast.node(expression).*.returnBuffer != 0) {
        // An object, or a call's result in the caller's buffer (the
        // reference binds to the buffer: a move constructor empties it).
        const n = ast.unary(ast.ADDR, expression, token)
        ast.node(n).*.ty = ref
        if standard.cpp && cpp.isClassType(base_type) && cpp.isClassType(ast.typeOf(expression)) && !cpp.sameClassPublic(ast.typeOf(expression), base_type) {
            // A derived object bound to a reference to a later base.
            return cpp.adjustedAddress(n, types.unqualified(ast.typeOf(expression)), types.unqualified(base_type), ref, false)
        }
        return n
    }
    if ast.kindOf(expression) == ast.COND && isLvalue(ast.node(expression).*.then) && isLvalue(ast.node(expression).*.els) {
        // `c ? a : b` of two objects: the address of the one chosen.
        const n = ast.make(ast.COND, token)
        ast.node(n).*.cond = ast.node(expression).*.cond
        ast.node(n).*.then = toReference(ast.node(expression).*.then, ref)
        ast.node(n).*.els = toReference(ast.node(expression).*.els, ref)
        ast.node(n).*.ty = ref
        return n
    }
    const tmp = temporaryOf(base_type, token)
    const stored = ast.binary(ast.ASSIGN, ast.variableNode(tmp, token), expression, token)
    addType(stored)
    const holder = ast.variableNode(tmp, token)
    ast.node(holder).*.ty = base_type
    const address = ast.unary(ast.ADDR, holder, token)
    ast.node(address).*.ty = ref
    const n = ast.binary(ast.COMMA, stored, address, token)
    ast.node(n).*.ty = ref
    return n
}

// The value a reference-typed expression (a parameter, a call's result)
// stands for: the object it refers to.
pub fn dereferenced(expression: usize) -> usize {
    const ref = ast.typeOf(expression)
    ast.node(expression).*.ty = types.pointerTo(types.baseOf(ref))
    const n = ast.unary(ast.DEREF, expression, ast.tokenOf(expression))
    ast.node(n).*.ty = types.baseOf(ref)
    return n
}

pub fn cast(expression: usize, ty: usize) -> usize {
    addType(expression)
    if types.isReference(ty) { return toReference(expression, ty) }
    if standard.cpp && cpp.isClassType(ast.typeOf(expression)) && !cpp.isClassType(ty) && types.kind(ty) != types.VOID {
        // A class to a scalar: through its conversion operator.
        const converted = cpp.convertFrom(expression, ty)
        if converted != 0 { return cast(converted, ty) }
    }
    if standard.cpp && types.kind(ty) == types.PTR && types.kind(ast.typeOf(expression)) == types.PTR {
        // A pointer to a class to one to a base after its first (or
        // back): moved by the base's offset.
        const from = types.unqualified(types.baseOf(ast.typeOf(expression)))
        const to = types.unqualified(types.baseOf(ty))
        if cpp.isClassType(from) && cpp.isClassType(to) && !cpp.sameClassPublic(from, to) {
            const adjusted = cpp.adjustedAddress(expression, from, to, ty, true)
            if adjusted != expression { return adjusted }
        }
    }
    const n = ast.make(ast.CAST, ast.tokenOf(expression))
    ast.node(n).*.lhs = expression
    ast.node(n).*.ty = ty
    // To a wide integer from anything but the same wide type.
    if types.isWide(ty) && !types.compatible(ast.typeOf(expression), ty) { wideTemporary(n) }
    return n
}

// A shift count is a 64-bit value even when the shifted value is wide.
fn shiftCount(n: usize) -> usize {
    const ty = ast.typeOf(n)
    if types.isWide(ty) { return cast(n, types.longOf()) }
    return cast(n, types.promoted(ty))
}

// Converts both operands of `n` to their common type.
fn usualArithmetic(n: usize) -> void {
    const lhs = ast.node(n).*.lhs
    const rhs = ast.node(n).*.rhs
    const ty = types.common(ast.typeOf(lhs), ast.typeOf(rhs))
    ast.node(n).*.lhs = cast(lhs, ty)
    ast.node(n).*.rhs = cast(rhs, ty)
}

fn typeList(first: usize) -> void {
    var n = first
    while n != 0 {
        addType(n)
        n = ast.node(n).*.next
    }
}

fn isStructLike(ty: usize) -> bool {
    const k = types.kind(ty)
    return k == types.STRUCT || k == types.UNION
}

pub fn addType(n: usize) -> void {
    if n == 0 { return }
    const node = ast.node(n)
    if node.*.ty != 0 { return }
    addType(node.*.lhs)
    addType(node.*.rhs)
    addType(node.*.cond)
    addType(node.*.then)
    addType(node.*.els)
    addType(node.*.init)
    addType(node.*.inc)
    typeList(node.*.body)
    typeList(node.*.args)
    const k = node.*.kind
    if k == ast.NUM {
        node.*.ty = types.intOf()
    } else if k == ast.ADD || k == ast.SUB || k == ast.MUL || k == ast.DIV || k == ast.MOD || k == ast.BITAND || k == ast.BITOR || k == ast.BITXOR {
        usualArithmetic(n)
        node.*.ty = ast.typeOf(node.*.lhs)
        wideTemporary(n)
    } else if k == ast.NEG {
        const ty = types.common(types.intOf(), ast.typeOf(node.*.lhs))
        node.*.lhs = cast(node.*.lhs, ty)
        node.*.ty = ty
        wideTemporary(n)
    } else if k == ast.ASSIGN {
        const lt = ast.typeOf(node.*.lhs)
        if types.kind(lt) == types.ARRAY { ast.errorAt(node.*.lhs, "not an lvalue") }
        if !isStructLike(lt) { node.*.rhs = cast(node.*.rhs, lt) }
        node.*.ty = lt
    } else if k == ast.EQ || k == ast.NE || k == ast.LT || k == ast.LE {
        usualArithmetic(n)
        node.*.ty = types.intOf()
    } else if k == ast.NOT || k == ast.LOGOR || k == ast.LOGAND {
        node.*.ty = types.intOf()
    } else if k == ast.BITNOT || k == ast.SHL || k == ast.SHR {
        const ty = types.promoted(ast.typeOf(node.*.lhs))
        node.*.lhs = cast(node.*.lhs, ty)
        if k != ast.BITNOT { node.*.rhs = if types.isWide(ty) { cast(node.*.rhs, types.longOf()) } else { shiftCount(node.*.rhs) } }
        node.*.ty = ty
        wideTemporary(n)
    } else if k == ast.VAR {
        node.*.ty = ast.obj(node.*.variable).*.ty
    } else if k == ast.COND {
        const tt = ast.typeOf(node.*.then)
        const et = ast.typeOf(node.*.els)
        if types.kind(tt) == types.VOID || types.kind(et) == types.VOID {
            node.*.ty = types.voidOf()
        } else if isStructLike(tt) {
            node.*.ty = tt
        } else if isLvalue(node.*.then) && isLvalue(node.*.els) && types.compatible(tt, et) {
            // Two objects of one type: the result is the one chosen (an
            // object itself in C++: a reference can bind to it).
            node.*.ty = tt
        } else {
            const ty = types.common(tt, et)
            node.*.then = cast(node.*.then, ty)
            node.*.els = cast(node.*.els, ty)
            node.*.ty = ty
        }
    } else if k == ast.COMMA {
        node.*.ty = ast.typeOf(node.*.rhs)
    } else if k == ast.MEMBER {
        node.*.ty = types.member(node.*.member).*.ty
    } else if k == ast.ADDR {
        const lt = ast.typeOf(node.*.lhs)
        if types.kind(lt) == types.ARRAY {
            node.*.ty = types.pointerTo(types.baseOf(lt))
        } else {
            node.*.ty = types.pointerTo(lt)
        }
    } else if k == ast.DEREF {
        const lt = ast.typeOf(node.*.lhs)
        if types.baseOf(lt) == 0 || (types.kind(lt) != types.PTR && types.kind(lt) != types.ARRAY) { ast.errorAt(n, "invalid pointer dereference") }
        if types.kind(types.baseOf(lt)) == types.VOID { ast.errorAt(n, "dereferencing a void pointer") }
        node.*.ty = types.baseOf(lt)
    } else if k == ast.STMT_EXPR {
        // The value of the last statement, when it is an expression.
        var last = node.*.body
        while last != 0 && ast.node(last).*.next != 0 { last = ast.node(last).*.next }
        if last != 0 && ast.kindOf(last) == ast.EXPR_STMT {
            node.*.ty = ast.typeOf(ast.node(last).*.lhs)
        } else {
            node.*.ty = types.voidOf()
        }
    } else if k == ast.VA_ARG {
        // Typed by the parser.
        node.*.ty = types.voidOf()
    } else {
        node.*.ty = types.voidOf()
    }
}
