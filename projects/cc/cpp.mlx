// C++ classes: member functions with their hidden `this`, constructors
// and destructors (called where an object is made and where its scope
// ends), member initializers, static members, operator functions,
// temporaries destroyed at the end of their expression, new and delete,
// single inheritance (the base class is the first member) and virtual
// functions called through a vtable whose pointer is the object's first
// word. The parser (decl.mlx, expr.mlx, stmt.mlx) calls in here at the
// points where C++ differs from C.
//
// What a class knows (Class, hung on its Type): its qualified name,
// which is the prefix its members are bound under in the scope (`S::f`),
// its base, its constructors and destructor, its member functions and
// the slots of the virtual ones. Member function bodies written in the
// class are read after the class is complete (their tokens are skipped
// and come back to).
//
// Objects of a class with a destructor are kept on a cleanup stack while
// their scope is read: leaving the scope, returning, breaking and
// continuing destroy them. A temporary (a constructor call in an
// expression, a call returning such a class) is destroyed at the end of
// the full expression, unless it is moved into a new object (an
// initializer, a returned value, an argument passed by value): then the
// new object owns it. An argument passed by value is destroyed by the
// function that received it.
//
// Not here: multiple inheritance, a polymorphic class over a base
// without a vtable (the base must be first), conversion operators,
// exceptions, templates, destruction of globals at exit.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")
const decl = @import("./decl.mlx")
const initializer = @import("./initializer.mlx")
const mangle = @import("./mangle.mlx")
const program = @import("./program.mlx")
const standard = @import("./standard.mlx")
const stmt = @import("./stmt.mlx")
const lexer = @import("./lexer.mlx")
const eval = @import("./eval.mlx")
const literal = @import("./literal.mlx")
const template = @import("./template.mlx")

pub const Class = struct {
    ty: usize
    // The qualified name (the members' prefix), the plain one (an
    // instance's key, `vector<i>`), and the one written in the source
    // (`vector`: what its constructors and destructor are called).
    prefix: u32
    name: u32
    written: u32
    // Declared without a tag (`struct { ... } x;`); declared in a function.
    anonymous: bool
    isLocal: bool
    baseClass: usize
    // The first constructor (the others follow by nextOverload) and the
    // destructor; `= default` for the default and the copy constructor.
    constructors: usize
    destructor: usize
    defaultedDefault: bool
    defaultedCopy: bool
    // The member functions in order (cells of object and next).
    methods: usize
    methodsTail: usize
    // The virtual functions by slot (cells), their number, the vtable.
    virtuals: usize
    virtualCount: i64
    hasVirtual: bool
    vtable: usize
    complete: bool
    // The conversion operators (`operator bool()`): cells of (function,
    // target type, next).
    conversions: usize
    // The constructor templates (template.mlx records, chained).
    ctorTemplates: usize
    // An instance of a class template: the template's record and the
    // arguments (template.mlx), for deducing through `vector<T>`.
    templateRecord: usize
    templateArgs: usize
}

fn at(c: usize) -> *Class {
    unsafe { return @ptrFromInt(*Class, c) }
}

// The class of a type, 0 for a type that is no class.
pub fn info(ty: usize) -> usize {
    if ty == 0 { return 0 }
    const k = types.kind(ty)
    if k != types.STRUCT && k != types.UNION { return 0 }
    return types.at(types.unqualified(ty)).*.info
}

pub fn isClassType(ty: usize) -> bool { return info(ty) != 0 }

// The class being read or whose member is being read, when `name` is
// its own name as written (the injected class name: `vector` inside
// `vector<T>`); 0 otherwise.
pub fn writtenName(ty: usize) -> u32 { return at(info(ty)).*.written }

pub fn addConstructorTemplate(classTy: usize, t: usize) -> void {
    const c = info(classTy)
    at(c).*.ctorTemplates = template.chained(at(c).*.ctorTemplates, t)
}

pub fn injectedClass(name: u32) -> usize {
    var index = scope.prefixCount()
    while index > 0 {
        index -= 1
        // The prefix entered and the ones around it (an instance's or a
        // default's prefix below its class's).
        var prefix = scope.prefixAt(index)
        var steps: u32 = 0
        while prefix != 0 && steps < 4 {
            const ty = classWithPrefix(prefix)
            if ty != 0 && at(info(ty)).*.written == name { return ty }
            prefix = scope.parentOf(prefix)
            steps += 1
        }
    }
    return 0
}

// Class types by their prefix.
var classByPrefix: usize = 0
// The member function bodies to read after their class: cells of four
// words (function, first token, class type, next).
var deferred: usize = 0
var deferredTail: usize = 0
var classDepth: u32 = 0
var anonymousCount: u32 = 0
var overrideName: u32 = 0
var finalName: u32 = 0
// The target type of the conversion operator whose name was read last.
var conversionType: usize = 0
// Member function bodies are kept for later (a lambda's, lambda.mlx).
pub var pendBodies = false

// The conversion operator's target type, taken once after its name
// (decl.declarator makes it the function's result).
pub fn takeConversionType() -> usize {
    const ty = conversionType
    conversionType = 0
    return ty
}
// The allocation functions, declared on first use.
var newFunction: usize = 0
var newArrayFunction: usize = 0
var deleteFunction: usize = 0
var deleteArrayFunction: usize = 0

pub fn init() -> void {
    classByPrefix = base.alloc(base.MAX_NAMES * 8)
    overrideName = base.intern("override")
    finalName = base.intern("final")
    char8Name = base.intern("char8_t")
}

// C++20's char8_t: a type of its own, named as a typedef is.
var char8Name: u32 = 0

// The next translation unit.
pub fn reset() -> void {
    deferred = 0
    deferredTail = 0
    classDepth = 0
    newFunction = 0
    newArrayFunction = 0
    deleteFunction = 0
    deleteArrayFunction = 0
    if standard.cpp { const bound = scope.bindTypedef(char8Name, types.char8Of()) }
}

// The class whose members have the qualified `prefix`, 0 for none.
pub fn classWithPrefix(prefix: u32) -> usize {
    return base.getWord(classByPrefix + @intCast(usize, prefix) * 8)
}

fn cell(first: usize, next: usize) -> usize {
    const c = base.alloc(16)
    base.putWord(c, first)
    base.putWord(c + 8, next)
    return c
}

// ---------------------------------------------------------------------------
// Expression helpers

fn typed(n: usize) -> usize {
    typing.addType(n)
    return n
}

fn addressOf(e: usize, token: usize) -> usize {
    return typed(ast.unary(ast.ADDR, e, token))
}

fn deref(e: usize, token: usize) -> usize {
    return typed(ast.unary(ast.DEREF, e, token))
}

fn number(value: i64, ty: usize, token: usize) -> usize {
    const n = ast.number(value, token)
    ast.node(n).*.ty = ty
    return n
}

fn nothing(token: usize) -> usize {
    return ast.make(ast.NULL_EXPR, token)
}

fn isNothing(n: usize) -> bool {
    return n == 0 || ast.kindOf(n) == ast.NULL_EXPR
}

// `a, b` with the void type (either may be nothing).
fn sequence(a: usize, b: usize, token: usize) -> usize {
    if isNothing(a) { return b }
    if isNothing(b) { return a }
    typing.addType(a)
    typing.addType(b)
    const n = ast.binary(ast.COMMA, a, b, token)
    ast.node(n).*.ty = types.voidOf()
    return n
}

fn statementOf(e: usize, token: usize) -> usize {
    if isNothing(e) { return 0 }
    typing.addType(e)
    return ast.unary(ast.EXPR_STMT, e, token)
}

// A block of statements, built in order.
fn appendStatement(block: usize, s: usize) -> void {
    if s == 0 { return }
    const b = ast.node(block)
    if b.*.body == 0 {
        b.*.body = s
    } else {
        var last = b.*.body
        while ast.node(last).*.next != 0 { last = ast.node(last).*.next }
        ast.node(last).*.next = s
    }
}

fn newTemp(ty: usize, token: usize) -> usize {
    return typing.temporaryOf(ty, token)
}

fn variable(o: usize, token: usize) -> usize {
    return typed(ast.variableNode(o, token))
}

// A member function as a callee: `address` the object's address (0: the
// current `this`).
fn methodNode(o: usize, address: usize, token: usize) -> usize {
    const n = ast.variableNode(o, token)
    ast.node(n).*.lhs = address
    ast.obj(o).*.isReferenced = true
    return n
}

// The address of the member `m` of the object at `address`.
fn memberAddress(address: usize, m: usize, token: usize) -> usize {
    const n = ast.unary(ast.MEMBER, deref(address, token), token)
    ast.node(n).*.member = m
    return addressOf(n, token)
}

// The address of element `index` of the array at `address`.
fn elementAddress(address: usize, element: usize, index: usize, token: usize) -> usize {
    return typed(expr.newAdd(typing.cast(address, types.pointerTo(element)), index, token))
}

// `for (i = 0; i < limit; i++)` with its body to be set: the loop and
// the index variable.
fn countedLoop(limit: usize, token: usize) -> (usize, usize) {
    const i = newTemp(types.longOf(), token)
    const n = ast.make(ast.FOR, token)
    ast.node(n).*.init = ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(i, token), number(0, types.longOf(), token), token)), token)
    ast.node(n).*.cond = typed(ast.binary(ast.LT, variable(i, token), limit, token))
    ast.node(n).*.inc = typed(ast.binary(ast.ASSIGN, variable(i, token), typed(ast.binary(ast.ADD, variable(i, token), number(1, types.longOf(), token), token)), token))
    ast.node(n).*.breakLabel = state.newLabel()
    ast.node(n).*.continueLabel = state.newLabel()
    return -> (n, i)
}

// `for (i = limit; i > 0; i--)` with its body to be set, which reads
// element i - 1: the loop and the index variable (objects are destroyed
// in the reverse order of their making).
fn countedLoopDown(limit: usize, token: usize) -> (usize, usize) {
    const i = newTemp(types.longOf(), token)
    const n = ast.make(ast.FOR, token)
    ast.node(n).*.init = ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(i, token), limit, token)), token)
    ast.node(n).*.cond = typed(ast.binary(ast.LT, number(0, types.longOf(), token), variable(i, token), token))
    ast.node(n).*.inc = typed(ast.binary(ast.ASSIGN, variable(i, token), typed(ast.binary(ast.SUB, variable(i, token), number(1, types.longOf(), token), token)), token))
    ast.node(n).*.breakLabel = state.newLabel()
    ast.node(n).*.continueLabel = state.newLabel()
    return -> (n, i)
}

fn lastIndex(i: usize, token: usize) -> usize {
    return typed(ast.binary(ast.SUB, variable(i, token), number(1, types.longOf(), token), token))
}

// A statement as an expression of type void.
fn statementExpression(s: usize, token: usize) -> usize {
    const n = ast.make(ast.STMT_EXPR, token)
    ast.node(n).*.body = s
    ast.node(n).*.ty = types.voidOf()
    return n
}

// An array of `count` arguments.
fn argumentList(first: usize, second: usize) -> usize {
    const a = base.alloc(16)
    base.putWord(a, first)
    base.putWord(a + 8, second)
    return a
}

fn argumentsWith(first: usize, args: usize, count: usize) -> usize {
    const a = base.alloc((count + 1) * 8)
    base.putWord(a, first)
    var index: usize = 0
    while index < count {
        base.putWord(a + (index + 1) * 8, base.getWord(args + index * 8))
        index += 1
    }
    return a
}

// ---------------------------------------------------------------------------
// What a class needs

// Whether the class `derived` has `b` as its base, directly or further up.
pub fn isBaseOf(b: usize, derived: usize) -> bool {
    const target = info(b)
    if target == 0 { return false }
    var c = info(derived)
    while c != 0 {
        if c == target { return true }
        c = info(at(c).*.baseClass)
    }
    return false
}

// Whether making an object of the type takes code (a constructor, a
// member with one or a default initializer, a vtable pointer).
pub fn needsConstruction(ty: usize) -> bool {
    if types.kind(ty) == types.ARRAY { return needsConstruction(types.baseOf(ty)) }
    const c = info(ty)
    if c == 0 { return false }
    if at(c).*.constructors != 0 || at(c).*.ctorTemplates != 0 || at(c).*.hasVirtual { return true }
    var m = types.at(ty).*.members
    while m != 0 {
        if types.member(m).*.init != 0 || needsConstruction(types.member(m).*.ty) { return true }
        m = types.member(m).*.next
    }
    return false
}

pub fn hasDestructor(ty: usize) -> bool {
    if types.kind(ty) == types.ARRAY { return hasDestructor(types.baseOf(ty)) }
    const c = info(ty)
    if c == 0 { return false }
    if at(c).*.destructor != 0 { return true }
    var m = types.at(ty).*.members
    while m != 0 {
        if hasDestructor(types.member(m).*.ty) { return true }
        m = types.member(m).*.next
    }
    return false
}

// Whether copying an object of the type is more than copying its bytes
// (it or a member has constructors).
pub fn needsSpecialCopy(ty: usize) -> bool {
    if types.kind(ty) == types.ARRAY { return needsSpecialCopy(types.baseOf(ty)) }
    const c = info(ty)
    if c == 0 { return false }
    if at(c).*.constructors != 0 { return true }
    var m = types.at(ty).*.members
    while m != 0 {
        if needsSpecialCopy(types.member(m).*.ty) { return true }
        m = types.member(m).*.next
    }
    return false
}

// The binding of `name` (a tag with `isTag`) under the class `prefix`
// or its base classes (`Derived::value`, `Derived::type` inherited):
// 0 for none, or when `prefix` is no class.
pub fn findInherited(prefix: u32, name: u32, isTag: bool) -> usize {
    const classTy = classWithPrefix(prefix)
    if classTy == 0 { return 0 }
    var c = info(at(info(classTy)).*.baseClass)
    while c != 0 {
        const found = scope.findQualified(at(c).*.prefix, name, isTag)
        if found != 0 { return found }
        c = info(at(c).*.baseClass)
    }
    return 0
}

// ---------------------------------------------------------------------------
// Type traits (the __is_... builtins of <type_traits>)

pub fn isEmptyClass(ty: usize) -> bool {
    const c = info(ty)
    if c == 0 || types.kind(ty) != types.STRUCT { return false }
    if at(c).*.hasVirtual { return false }
    var m = types.at(ty).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        if types.member(m).*.name != 0 || !isClassType(mt) || !isEmptyClass(mt) { return false }
        m = types.member(m).*.next
    }
    return true
}

pub fn isPolymorphic(ty: usize) -> bool {
    const c = info(ty)
    return c != 0 && at(c).*.hasVirtual
}

pub fn isAbstract(ty: usize) -> bool {
    const c = info(ty)
    if c == 0 { return false }
    var s = at(c).*.virtuals
    while s != 0 {
        if ast.obj(state.cellNode(s)).*.isPure { return true }
        s = state.cellNext(s)
    }
    return false
}

// Copied by its bytes, and unmade by nothing: no constructor,
// destructor or virtual function of its own or its members'.
pub fn isTriviallyCopyable(ty: usize) -> bool {
    if types.kind(ty) == types.ARRAY { return isTriviallyCopyable(types.baseOf(ty)) }
    const c = info(ty)
    if c == 0 { return true }
    if at(c).*.hasVirtual || at(c).*.destructor != 0 { return false }
    // A constructor other than the default one copies otherwise.
    var ctor = at(c).*.constructors
    while ctor != 0 {
        const p = types.at(ast.obj(ctor).*.ty).*.params
        if p != 0 && types.param(p).*.next != 0 { return false }
        ctor = ast.obj(ctor).*.nextOverload
    }
    var m = types.at(ty).*.members
    while m != 0 {
        if !isTriviallyCopyable(types.member(m).*.ty) { return false }
        m = types.member(m).*.next
    }
    return true
}

pub fn isTrivial(ty: usize) -> bool {
    const c = info(ty)
    if c == 0 { return true }
    return isTriviallyCopyable(ty) && at(c).*.constructors == 0
}

// A synthetic argument of type `ty` for trying overloads: an lvalue
// for an lvalue reference type, an rvalue otherwise.
fn syntheticArgument(ty: usize, token: usize) -> usize {
    if types.kind(ty) == types.REF && !types.at(ty).*.isRvalueRef {
        const o = ast.newObj(0, types.baseOf(ty), token)
        ast.obj(o).*.isLocal = true
        return variable(o, token)
    }
    const n = ast.number(0, token)
    ast.node(n).*.ty = types.referenced(ty)
    if types.kind(ty) == types.REF { ast.node(n).*.xvalue = true }
    return n
}

// Whether an object of type `ty` can be made from arguments of the
// types in `argTypes` (`count` of them): __is_constructible.
pub fn isConstructible(ty: usize, argTypes: usize, count: usize, token: usize) -> bool {
    if types.kind(ty) == types.VOID || types.kind(ty) == types.FUNC { return false }
    if types.kind(ty) == types.REF {
        if count != 1 { return false }
        return expr.conversionRank(types.referenced(base.getWord(argTypes)), ty) > 0 || types.compatible(types.baseOf(ty), types.referenced(base.getWord(argTypes)))
    }
    if types.kind(ty) == types.ARRAY { return count == 0 && isConstructible(types.baseOf(ty), argTypes, 0, token) }
    const c = info(ty)
    if c == 0 {
        if count == 0 { return !types.at(ty).*.incomplete }
        if count != 1 { return false }
        const from = types.referenced(base.getWord(argTypes))
        return expr.conversionRank(from, ty) > 0 || types.compatible(from, ty)
    }
    if types.at(ty).*.incomplete { return false }
    if at(c).*.constructors == 0 {
        if count == 0 { return !isAbstract(ty) }
        if count != 1 { return false }
        return sameClass(types.referenced(base.getWord(argTypes)), ty)
    }
    const given = base.alloc((count + 1) * 8)
    const o = ast.newObj(0, ty, token)
    ast.obj(o).*.isLocal = true
    base.putWord(given, addressOf(variable(o, token), token))
    var index: usize = 0
    while index < count {
        base.putWord(given + (index + 1) * 8, syntheticArgument(base.getWord(argTypes + index * 8), token))
        index += 1
    }
    if expr.bestOverload(at(c).*.constructors, given, count + 1) != 0 { return !isAbstract(ty) }
    if count == 0 && at(c).*.defaultedDefault { return !isAbstract(ty) }
    if count == 1 && sameClass(types.referenced(base.getWord(argTypes)), ty) { return !isAbstract(ty) }
    return false
}

// Whether `to = from` is possible: __is_assignable.
pub fn isAssignable(to: usize, from: usize, token: usize) -> bool {
    const target = types.referenced(to)
    if types.kind(target) == types.ARRAY || types.kind(target) == types.FUNC || types.kind(target) == types.VOID { return false }
    if types.isConst(target) { return false }
    if !isClassType(target) {
        const source = types.referenced(from)
        return expr.conversionRank(source, target) > 0 || types.compatible(source, target)
    }
    const lhs = syntheticArgument(types.referenceTo(target), token)
    const rhs = syntheticArgument(from, token)
    const call = binaryOperator("=", lhs, rhs, token)
    if call != 0 { return true }
    // The implicit copy assignment, member by member.
    return sameClass(types.referenced(from), target)
}

// Whether a value of type `from` converts to `to` implicitly.
pub fn isConvertible(from: usize, to: usize, token: usize) -> bool {
    if types.kind(to) == types.VOID { return types.kind(from) == types.VOID }
    if types.kind(from) == types.VOID { return false }
    const source = types.referenced(from)
    if types.kind(to) == types.REF {
        if !types.at(to).*.isRvalueRef && !types.isConst(types.baseOf(to)) && types.kind(from) != types.REF { return false }
        return types.compatible(source, types.baseOf(to)) || expr.conversionRank(source, to) > 0
    }
    if types.compatible(source, to) && !(isClassType(to) && !isConstructible(to, argumentTypes(from), 1, token)) { return true }
    return expr.conversionRank(source, to) > 0
}

fn argumentTypes(ty: usize) -> usize {
    const cell = base.alloc(8)
    base.putWord(cell, ty)
    return cell
}

// Whether a local or global of the type is made and unmade here rather
// than by C's initializers.
pub fn isObjectType(ty: usize) -> bool {
    return isClassType(if types.kind(ty) == types.ARRAY { types.baseOf(ty) } else { ty }) && (needsConstruction(ty) || hasDestructor(ty) || needsSpecialCopy(ty))
}

fn sameClass(first: usize, second: usize) -> bool {
    return info(first) != 0 && info(first) == info(second)
}

// Whether a value of type `from` converts to the class `ty` through a
// constructor taking one argument (the copy constructor aside).
pub fn convertible(from: usize, ty: usize) -> bool {
    const c = info(ty)
    if c == 0 { return false }
    var ctor = at(c).*.constructors
    while ctor != 0 {
        const thisParam = types.at(ast.obj(ctor).*.ty).*.params
        if thisParam != 0 {
            const p = types.param(thisParam).*.next
            if p != 0 && (types.param(p).*.next == 0 || types.param(types.param(p).*.next).*.defaultValue != 0) {
                const target = types.referenced(types.param(p).*.ty)
                if !sameClass(target, ty) && expr.conversionRank(from, types.param(p).*.ty) > 0 { return true }
            }
        }
        ctor = ast.obj(ctor).*.nextOverload
    }
    return false
}

// `value` as a value of the class `ty`: converted through a constructor
// when it is of another type.
pub fn convertValue(value: usize, ty: usize) -> usize {
    typing.addType(value)
    const target = types.referenced(ty)
    if !isClassType(target) { return value }
    const from = ast.typeOf(value)
    if sameClass(from, target) || isBaseOf(target, from) { return value }
    // Through the value's own conversion operator (`operator const P &()`).
    const converted = classConversion(value, target)
    if converted != 0 { return converted }
    const args = argumentList(value, 0)
    return temporaryObject(target, args, 1, ast.tokenOf(value))
}

// ---------------------------------------------------------------------------
// Making and unmaking objects

// The member named `name` of the class or its bases that is a function
// or a static member: its object, 0 for none.
pub fn memberOf(classTy: usize, name: u32) -> usize {
    var c = info(classTy)
    while c != 0 {
        const binding = scope.findQualified(at(c).*.prefix, name, false)
        if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE { return scope.at(binding).*.obj }
        if binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE {
            // A member function template declared after the functions of
            // the name: the functions under it.
            const functions = boundFunctions(binding).0
            if functions != 0 { return functions }
        }
        c = info(at(c).*.baseClass)
    }
    return 0
}

// The callee for the member function `name` of the class called on the
// object at `address`: with a member function template of the name, its
// placeholder with the functions `o` as its overloads (the arguments
// choose among them all); else the function.
fn memberCallee(classTy: usize, o: usize, address: usize, nameToken: usize) -> usize {
    return memberCalleeNamed(classTy, tokens.name(nameToken), o, address, nameToken)
}

fn memberCalleeNamed(classTy: usize, name: u32, o: usize, address: usize, nameToken: usize) -> usize {
    const record = memberTemplateOf(classTy, name)
    if record == 0 || (o != 0 && ast.obj(o).*.isStaticMember) { return methodNode(o, address, nameToken) }
    const holder = template.placeholderFor(record)
    ast.obj(holder).*.nextOverload = o
    if o != 0 { ast.obj(o).*.isReferenced = true }
    const n = ast.variableNode(holder, nameToken)
    ast.node(n).*.lhs = address
    return n
}

// The member function template `name` of the class (or of a base),
// 0 for none.
fn memberTemplateOf(classTy: usize, name: u32) -> usize {
    var c = info(classTy)
    while c != 0 {
        var b = scope.findQualified(at(c).*.prefix, name, false)
        const first = b
        while b != 0 && scope.at(b).*.name == scope.at(first).*.name {
            if scope.at(b).*.kind == scope.TEMPLATE && template.isFunctionTemplate(b) { return scope.at(b).*.obj }
            b = scope.at(b).*.hidden
        }
        c = info(at(c).*.baseClass)
    }
    return 0
}

fn findMethod(classTy: usize, name: u32) -> usize {
    const o = memberOf(classTy, name)
    if o != 0 && ast.obj(o).*.isFunction { return o }
    return 0
}

// The current member function's `this`.
pub fn thisPointer(token: usize) -> usize {
    const binding = scope.find(names.K_THIS)
    if binding == 0 || scope.at(binding).*.kind != scope.VARIABLE { tokens.errorAt(token, "'this' outside a member function") }
    return variable(scope.at(binding).*.obj, token)
}

// `*(void ***)address = vtable`.
fn setVptr(address: usize, c: usize, token: usize) -> usize {
    const vt = at(c).*.vtable
    if vt == 0 { return nothing(token) }
    ast.obj(vt).*.isReferenced = true
    const slotType = types.pointerTo(types.pointerTo(types.voidOf()))
    const target = deref(typing.cast(address, types.pointerTo(slotType)), token)
    return typed(ast.binary(ast.ASSIGN, target, typing.cast(variable(vt, token), slotType), token))
}

// The default initializer of a member (`int x = 0;` in the class), read
// where it is used.
// The member `m` at `where` made by its default initializer (`= v`,
// `{v}`, `{a, b}`, `{ }`).
fn initializeMember(where: usize, m: usize, token: usize) -> usize {
    const mt = types.member(m).*.ty
    if tokens.is(types.member(m).*.init, names.P_LBRACE) {
        const saved = cursor.save()
        cursor.restore(types.member(m).*.init)
        const made = braceInitializer(where, mt, token)
        cursor.restore(saved)
        return made
    }
    return construct(where, mt, argumentList(memberInitializer(m), 0), 1, token)
}

fn memberInitializer(m: usize) -> usize {
    const saved = cursor.save()
    cursor.restore(types.member(m).*.init)
    var e: usize = 0
    if cursor.consume(names.P_LBRACE) {
        // `int x{0};` or `= {0}`: one value.
        e = expr.assign()
        cursor.expect(names.P_RBRACE)
    } else {
        e = expr.assign()
    }
    cursor.restore(saved)
    return e
}

// Makes the object of type `ty` at `address` from `args`: the expression
// (nothing when no code is needed).
pub fn construct(address: usize, ty: usize, args: usize, count: usize, token: usize) -> usize {
    completeIfNeeded(ty)
    var typedCount: usize = 0
    while typedCount < count {
        typing.addType(base.getWord(args + typedCount * 8))
        typedCount += 1
    }
    const k = types.kind(ty)
    if k == types.ARRAY {
        const element = types.baseOf(ty)
        if count == 1 {
            // A copy of an array (a member of a copied object): element
            // by element.
            const source = base.getWord(args)
            typing.addType(source)
            if !types.compatible(ast.typeOf(source), ty) { tokens.errorAt(token, "an array cannot be constructed from arguments") }
            const loop = countedLoop(number(types.at(ty).*.arrayLength, types.longOf(), token), token)
            const from = deref(elementAddress(addressOf(source, token), element, variable(loop.1, token), token), token)
            ast.node(loop.0).*.then = ast.unary(ast.EXPR_STMT, construct(elementAddress(address, element, variable(loop.1, token), token), element, argumentList(from, 0), 1, token), token)
            return statementExpression(loop.0, token)
        }
        if count != 0 { tokens.errorAt(token, "an array cannot be constructed from arguments") }
        if !needsConstruction(element) { return nothing(token) }
        const loop = countedLoop(number(types.at(ty).*.arrayLength, types.longOf(), token), token)
        ast.node(loop.0).*.then = ast.unary(ast.EXPR_STMT, construct(elementAddress(address, element, variable(loop.1, token), token), element, 0, 0, token), token)
        return statementExpression(loop.0, token)
    }
    const c = info(ty)
    if c != 0 && (at(c).*.constructors != 0 || at(c).*.ctorTemplates != 0) {
        const full = argumentsWith(address, args, count)
        var plain: usize = 0
        var plainScore: i64 = -1
        if at(c).*.constructors != 0 {
            plain = expr.bestOverload(at(c).*.constructors, full, count + 1)
            if plain != 0 { plainScore = expr.overloadScore(plain, full, count + 1) - 4 }
            // An object of the class is copied by a copy (or move)
            // constructor, else member by member: not through a
            // converting constructor taking what its conversion operator
            // makes of it (`C(E)` and `explicit operator bool`).
            if count == 1 && plainScore < 4 && sameClass(ast.typeOf(base.getWord(args)), ty) {
                plain = 0
                plainScore = -1
            }
        }
        // A constructor template's instance, when it fits better.
        var instance: usize = 0
        var instanceScore: i64 = -1
        // (Never for an object of the class: a template is no copy
        // constructor.)
        if at(c).*.ctorTemplates != 0 && !(count == 1 && sameClass(ast.typeOf(base.getWord(args)), ty)) {
            instance = template.callInstance(at(c).*.ctorTemplates, args, count, 0)
            if instance != 0 { instanceScore = expr.argumentScore(instance, args, count) }
        }
        if instance != 0 && instanceScore > plainScore {
            const callee = methodNode(instance, address, token)
            ast.node(callee).*.value = 1
            return expr.buildCall(callee, args, count, token)
        }
        if plain != 0 {
            const callee = methodNode(at(c).*.constructors, address, token)
            ast.node(callee).*.value = 1
            return expr.buildCall(callee, args, count, token)
        }
        // No constructor takes the arguments: the default and the copy
        // constructor the class has implicitly (or `= default`) are made
        // member by member below.
        var memberwise = false
        if count == 0 && at(c).*.defaultedDefault { memberwise = true }
        if count == 1 {
            const value = base.getWord(args)
            typing.addType(value)
            if sameClass(ast.typeOf(value), ty) { memberwise = true }
            // An object of another class with a conversion operator to
            // this one (`string_view v = str;`): converted, then copied.
            if !memberwise {
                const converted = classConversion(value, ty)
                if converted != 0 { return copyConstruct(address, ty, converted, token) }
            }
        }
        if !memberwise && decl.sfinae {
            decl.sfinaeFailed = true
            return nothing(token)
        }
        if !memberwise { tokens.errorAt(token, base.join("no matching constructor for ", base.nameOf(types.at(ty).*.name))) }
    }
    if k == types.STRUCT || k == types.UNION {
        if count == 0 { return defaultConstruct(address, ty, token) }
        if count == 1 {
            const value = base.getWord(args)
            typing.addType(value)
            if sameClass(ast.typeOf(value), ty) || info(ty) == 0 { return copyConstruct(address, ty, value, token) }
            if convertible(ast.typeOf(value), ty) { return copyConstruct(address, ty, convertValue(value, ty), token) }
        }
        if isAggregate(ty) { return aggregateConstruct(address, ty, args, count, token) }
        if decl.sfinae {
            decl.sfinaeFailed = true
            return nothing(token)
        }
        tokens.errorAt(token, base.join("no matching constructor for ", base.nameOf(types.at(ty).*.name)))
    }
    // A scalar or a reference: its value (`x()` in an initializer list
    // makes it zero).
    const target = deref(address, token)
    if count == 0 {
        if types.isReference(ty) { tokens.errorAt(token, "a reference member needs an initializer") }
        return typed(ast.binary(ast.ASSIGN, target, number(0, types.intOf(), token), token))
    }
    if count == 1 { return typed(ast.binary(ast.ASSIGN, target, base.getWord(args), token)) }
    tokens.errorAt(token, "too many initializers")
    return 0
}

// Whether the class is an aggregate: no constructors, no virtual
// functions, no base (`T{a, b}` sets its members in order).
fn isAggregate(ty: usize) -> bool {
    const c = info(ty)
    if c == 0 { return true }
    return at(c).*.constructors == 0 && at(c).*.ctorTemplates == 0 && !at(c).*.hasVirtual && at(c).*.baseClass == 0
}

// `T{a, b}` of an aggregate: its members from the arguments in order,
// the ones left as made without arguments.
fn aggregateConstruct(address: usize, ty: usize, args: usize, count: usize, token: usize) -> usize {
    var n = nothing(token)
    var m = types.at(ty).*.members
    var index: usize = 0
    while m != 0 {
        const mt = types.member(m).*.ty
        const where = memberAddress(address, m, token)
        var elided = false
        if index < count && types.kind(mt) == types.ARRAY && types.at(mt).*.arrayLength > 0 {
            const given = base.getWord(args + index * 8)
            typing.addType(given)
            elided = types.kind(types.referenced(ast.typeOf(given))) != types.ARRAY
        }
        if elided {
            // Brace elision: `V{a, b, c, d}` for `union { T values[4]; }`.
            const element = types.baseOf(mt)
            var e: i64 = 0
            while e < types.at(mt).*.arrayLength {
                const at_ = elementAddress(where, element, number(e, types.longOf(), token), token)
                if index < count {
                    n = sequence(n, construct(at_, element, args + index * 8, 1, token), token)
                    index += 1
                } else {
                    n = sequence(n, construct(at_, element, 0, 0, token), token)
                }
                e += 1
            }
        } else {
            if index < count {
                n = sequence(n, construct(where, mt, args + index * 8, 1, token), token)
            } else if types.member(m).*.init != 0 {
                n = sequence(n, initializeMember(where, m, token), token)
            } else if types.kind(mt) == types.ARRAY && !needsConstruction(mt) {
                n = sequence(n, zeroAt(where, types.size(mt), token), token)
            } else {
                n = sequence(n, construct(where, mt, 0, 0, token), token)
            }
            index += 1
        }
        if types.kind(ty) == types.UNION { break }
        m = types.member(m).*.next
    }
    if index < count { tokens.errorAt(token, "too many initializers") }
    return n
}

// Makes the object without arguments: its base, its vtable pointer, its
// members with constructors or default initializers.
fn defaultConstruct(address: usize, ty: usize, token: usize) -> usize {
    const c = info(ty)
    var n = nothing(token)
    if c != 0 && at(c).*.hasVirtual && at(c).*.baseClass == 0 { n = setVptr(address, c, token) }
    var m = types.at(ty).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        const where = memberAddress(address, m, token)
        if types.member(m).*.isBase {
            n = sequence(n, construct(where, mt, 0, 0, token), token)
            if at(c).*.hasVirtual { n = sequence(n, setVptr(address, c, token), token) }
        } else if types.member(m).*.init != 0 {
            n = sequence(n, initializeMember(where, m, token), token)
        } else if needsConstruction(mt) {
            n = sequence(n, construct(where, mt, 0, 0, token), token)
        }
        m = types.member(m).*.next
    }
    return n
}

// Whether a member of the class is more than its bytes to copy.
fn membersNeedSpecialCopy(ty: usize) -> bool {
    var m = types.at(ty).*.members
    while m != 0 {
        if needsSpecialCopy(types.member(m).*.ty) { return true }
        m = types.member(m).*.next
    }
    return false
}

// Makes the object as a copy of `source` (an object of its type) when
// the class has no copy constructor: the bytes, or member by member
// when a member has constructors.
fn copyConstruct(address: usize, ty: usize, source: usize, token: usize) -> usize {
    typing.addType(source)
    if !membersNeedSpecialCopy(ty) {
        // The bytes; a temporary source is moved.
        const moved = markMoved(source)
        return typed(ast.binary(ast.ASSIGN, deref(address, token), source, token))
    }
    // The source by its address, taken once.
    const ptr = newTemp(types.pointerTo(ty), token)
    var n = typed(ast.binary(ast.ASSIGN, variable(ptr, token), addressOf(source, token), token))
    var m = types.at(ty).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        const part = ast.unary(ast.MEMBER, deref(variable(ptr, token), token), token)
        ast.node(part).*.member = m
        typing.addType(part)
        n = sequence(n, construct(memberAddress(address, m, token), mt, argumentList(part, 0), 1, token), token)
        m = types.member(m).*.next
    }
    return n
}

// Unmakes the object of type `ty` at `address`: its destructor (called
// through the vtable unless `direct`), else its members' in reverse.
pub fn destroy(address: usize, ty: usize, direct: bool, token: usize) -> usize {
    const k = types.kind(ty)
    if k == types.ARRAY {
        const element = types.baseOf(ty)
        if !hasDestructor(element) { return nothing(token) }
        const loop = countedLoopDown(number(types.at(ty).*.arrayLength, types.longOf(), token), token)
        ast.node(loop.0).*.then = ast.unary(ast.EXPR_STMT, destroy(elementAddress(address, element, lastIndex(loop.1, token), token), element, true, token), token)
        return statementExpression(loop.0, token)
    }
    const c = info(ty)
    if c == 0 { return nothing(token) }
    if at(c).*.destructor != 0 {
        const callee = methodNode(at(c).*.destructor, address, token)
        if direct { ast.node(callee).*.value = 1 }
        return expr.buildCall(callee, 0, 0, token)
    }
    // The members, last first.
    var count: usize = 0
    var m = types.at(ty).*.members
    while m != 0 {
        count += 1
        m = types.member(m).*.next
    }
    const list = base.alloc(count * 8 + 8)
    var index: usize = 0
    m = types.at(ty).*.members
    while m != 0 {
        base.putWord(list + index * 8, m)
        index += 1
        m = types.member(m).*.next
    }
    var n = nothing(token)
    while index > 0 {
        index -= 1
        const member = base.getWord(list + index * 8)
        if hasDestructor(types.member(member).*.ty) {
            n = sequence(n, destroy(memberAddress(address, member, token), types.member(member).*.ty, true, token), token)
        }
    }
    return n
}

// A temporary object of type `ty` made from `args`: destroyed at the end
// of the expression unless moved on.
pub fn temporaryObject(ty: usize, args: usize, count: usize, token: usize) -> usize {
    const tmp = newTemp(ty, token)
    const init = construct(addressOf(variable(tmp, token), token), ty, args, count, token)
    if hasDestructor(ty) { state.addTemporary(tmp) }
    const result = variable(tmp, token)
    if isNothing(init) { return result }
    const n = ast.binary(ast.COMMA, init, result, token)
    ast.node(n).*.ty = ty
    return n
}

// `{a, b}` where a value of type `ty` is wanted (`return {a, b};`, an
// element of an initializer list): a temporary made by the braces.
pub fn bracedTemporary(ty: usize, token: usize) -> usize {
    const tmp = newTemp(ty, token)
    const init = braceInitializer(addressOf(variable(tmp, token), token), ty, token)
    if hasDestructor(ty) { state.addTemporary(tmp) }
    const result = variable(tmp, token)
    if isNothing(init) { return result }
    const n = ast.binary(ast.COMMA, init, result, token)
    ast.node(n).*.ty = ty
    return n
}

// A temporary of the class `ty` made from `value` by one of its
// constructors; 0 when none takes it.
fn convertedObject(value: usize, ty: usize, token: usize) -> usize {
    const c = info(ty)
    if c == 0 || (at(c).*.constructors == 0 && at(c).*.ctorTemplates == 0) { return 0 }
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    const pending = state.takeTemporaries()
    const made = temporaryObject(ty, argumentList(value, 0), 1, token)
    const failed = decl.sfinaeFailed
    const madeTemporaries = state.takeTemporaries()
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    state.setTemporaries(pending)
    if failed { return 0 }
    // (The temporaries the construction made stay pending, before the
    // ones made earlier.)
    if madeTemporaries != 0 {
        var tail = madeTemporaries
        while base.getWord(tail + 8) != 0 { tail = base.getWord(tail + 8) }
        base.putWord(tail + 8, pending)
        state.setTemporaries(madeTemporaries)
    }
    return made
}

// A braced list as a call's argument (`f({a, b})`), at its `{`: a
// BRACED node of the marker type, the tokens passed over.
// (Two marker types: a list of at most one element, which a scalar
// takes too, and a longer one, which only a class takes.)
var bracedType: usize = 0
var bracedManyType: usize = 0
pub fn bracedMarker() -> usize {
    if bracedType == 0 {
        bracedType = types.structType()
        types.at(bracedType).*.name = base.intern("__mlxcc_braced_list")
        types.at(bracedType).*.incomplete = true
    }
    return bracedType
}
pub fn bracedManyMarker() -> usize {
    if bracedManyType == 0 {
        bracedManyType = types.structType()
        types.at(bracedManyType).*.name = base.intern("__mlxcc_braced_list_of_many")
        types.at(bracedManyType).*.incomplete = true
    }
    return bracedManyType
}
pub fn isBracedMarker(ty: usize) -> bool { return ty != 0 && (ty == bracedType || ty == bracedManyType) }

pub fn bracedArgument(open: usize) -> usize {
    const n = ast.make(ast.BRACED, open)
    ast.node(n).*.value = @intCast(i64, open)
    ast.node(n).*.ty = bracedMarker()
    // Its elements counted (a scalar takes at most one).
    var count: i64 = 0
    var level: i64 = 0
    var t = tokens.next(open)
    if !tokens.is(t, names.P_RBRACE) { count = 1 }
    while !tokens.isEof(t) {
        if level == 0 && tokens.is(t, names.P_RBRACE) { break }
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) { level -= 1 }
        if level == 0 && tokens.is(t, names.P_COMMA) { count += 1 }
        t = tokens.next(t)
    }
    ast.node(n).*.high = count
    if count > 1 { ast.node(n).*.ty = bracedManyMarker() }
    skipBraces()
    return n
}

// The BRACED argument `n` made into a value of the parameter type `ty`
// (a reference's referred type as a temporary).
pub fn bracedValue(n: usize, ty: usize) -> usize {
    const saved = cursor.save()
    cursor.restore(@intCast(usize, ast.node(n).*.value))
    const made = bracedTemporary(types.unqualified(types.referenced(ty)), ast.tokenOf(n))
    cursor.restore(saved)
    typing.addType(made)
    return made
}

// `T(args)`: a temporary of a class, a conversion of a scalar.
pub fn functionalCast(ty: usize, args: usize, count: usize, token: usize) -> usize {
    if isClassType(ty) { return temporaryObject(ty, args, count, token) }
    if count == 0 { return typing.cast(number(0, types.intOf(), token), ty) }
    if count > 1 { tokens.errorAt(token, "too many arguments for a conversion") }
    return typing.cast(base.getWord(args), ty)
}

// A class value about to be moved into a new object: a temporary is not
// destroyed any more (the new object owns it); an object that cannot be
// copied by its bytes is copied into a temporary first.
// Marks the temporary `value` is (a call's result, a constructed
// temporary) as moved on: not destroyed at the end of the expression.
// False when it is no temporary.
fn markMoved(value: usize) -> bool {
    const k = ast.kindOf(value)
    if k == ast.FUNCALL && ast.node(value).*.returnBuffer != 0 {
        ast.obj(ast.node(value).*.returnBuffer).*.noDestroy = true
        return true
    }
    var holder = value
    if k == ast.COMMA { holder = ast.node(value).*.rhs }
    if ast.kindOf(holder) == ast.VAR && state.isPendingTemporary(ast.node(holder).*.variable) {
        ast.obj(ast.node(holder).*.variable).*.noDestroy = true
        return true
    }
    return false
}

pub fn consumed(value: usize) -> usize {
    typing.addType(value)
    const ty = ast.typeOf(value)
    if !isClassType(ty) { return value }
    if markMoved(value) { return value }
    // An object (or `c ? a : b` of two objects) is copied; `c ? a : b`
    // of an object and a temporary has each branch consumed.
    var isObject = typing.isLvalue(value)
    const k = ast.kindOf(value)
    if k == ast.COND {
        const bothObjects = typing.isLvalue(ast.node(value).*.then) && typing.isLvalue(ast.node(value).*.els)
        if bothObjects {
            isObject = true
        } else {
            ast.node(value).*.then = consumed(ast.node(value).*.then)
            ast.node(value).*.els = consumed(ast.node(value).*.els)
            return value
        }
    }
    if needsSpecialCopy(ty) && isObject {
        const token = ast.tokenOf(value)
        const tmp = newTemp(ty, token)
        const init = construct(addressOf(variable(tmp, token), token), ty, argumentList(value, 0), 1, token)
        const n = ast.binary(ast.COMMA, init, variable(tmp, token), token)
        ast.node(n).*.ty = ty
        return n
    }
    return value
}

// A call made: its result, when a class with a destructor, is a
// temporary.
pub fn noteCall(n: usize) -> void {
    const buffer = ast.node(n).*.returnBuffer
    if buffer != 0 && hasDestructor(ast.typeOf(n)) { state.addTemporary(buffer) }
}

// The destruction of the temporaries made so far (the ones not moved
// on), as a statement; 0 when there is none.
pub fn flushStatement(token: usize) -> usize {
    const e = destroyTemporaries(token)
    return statementOf(e, token)
}

fn destroyTemporaries(token: usize) -> usize {
    var c = state.takeTemporaries()
    var n = nothing(token)
    while c != 0 {
        const o = state.cellNode(c)
        if !ast.obj(o).*.noDestroy {
            n = sequence(n, destroy(addressOf(variable(o, token), token), ast.obj(o).*.ty, true, token), token)
        }
        c = state.cellNext(c)
    }
    return n
}

// A class value kept past a flush (a branch's result): the temporary
// holding it, to be destroyed by the expression around; 0 for none.
var keptTemporary: usize = 0

pub fn takeKeptTemporary() -> usize {
    const o = keptTemporary
    keptTemporary = 0
    return o
}

// The expression `e`, a full one, followed by the destruction of its
// temporaries; its value kept when `keepValue` (a class value is moved
// into a temporary of the expression around: takeKeptTemporary).
pub fn flushTemporaries(e: usize, keepValue: bool, token: usize) -> usize {
    keptTemporary = 0
    if keepValue && e != 0 {
        typing.addType(e)
        if isClassType(ast.typeOf(e)) {
            // Moved out before its own temporaries go.
            const moved = markMoved(e)
        }
    }
    const destroys = destroyTemporaries(token)
    if isNothing(destroys) { return e }
    if e == 0 { return destroys }
    typing.addType(e)
    const ty = ast.typeOf(e)
    if !keepValue || types.kind(ty) == types.VOID { return sequence(e, destroys, token) }
    const tmp = newTemp(ty, token)
    if isClassType(ty) && hasDestructor(ty) { keptTemporary = tmp }
    const saved = typed(ast.binary(ast.ASSIGN, variable(tmp, token), e, token))
    const n = ast.binary(ast.COMMA, sequence(saved, destroys, token), variable(tmp, token), token)
    ast.node(n).*.ty = ty
    return n
}

// ---------------------------------------------------------------------------
// Scopes

// The destruction of the objects on the cleanup stack above `height`,
// innermost first, as a block; 0 when there is none.
pub fn destroyFrom(height: usize, token: usize) -> usize {
    return destroyAbove(height, 0, token)
}

// The same, leaving out the object `skip` (one moved out by a return).
fn destroyAbove(height: usize, skip: usize, token: usize) -> usize {
    var index = state.cleanupCount()
    if index <= height { return 0 }
    const block = ast.make(ast.BLOCK, token)
    while index > height {
        index -= 1
        const o = state.cleanupAt(index)
        if o == skip { continue }
        appendStatement(block, statementOf(destroy(addressOf(variable(o, token), token), ast.obj(o).*.ty, true, token), token))
    }
    if ast.node(block).*.body == 0 { return 0 }
    return block
}

// Leaves a scope: the destruction of its objects (0 for none), which are
// popped.
pub fn leaveScope(height: usize, token: usize) -> usize {
    const s = destroyFrom(height, token)
    state.popCleanups(height)
    return s
}

// A break or continue (the JUMP `n`) destroys the objects of the scopes
// it leaves.
pub fn jumpStatement(n: usize) -> usize {
    const s = destroyFrom(state.loopCleanups(), ast.tokenOf(n))
    if s == 0 { return n }
    appendStatement(s, n)
    return s
}

// A class value about to be returned: a local of the function (on the
// cleanup stack) is moved out, its destruction left out of the return;
// anything else is consumed (copied when an object, moved when a
// temporary).
var movedOut: usize = 0

pub fn returnValue(value: usize, ty: usize) -> usize {
    const converted = convertValue(value, ty)
    movedOut = 0
    if ast.kindOf(converted) == ast.VAR {
        const o = ast.node(converted).*.variable
        var index = state.cleanupCount()
        while index > 0 {
            index -= 1
            if state.cleanupAt(index) == o {
                movedOut = o
                return converted
            }
        }
    }
    return consumed(converted)
}

// A return (the RETURN `n`, its value read): the value is kept, the
// temporaries and every object of the function are destroyed, then the
// function returns.
pub fn returnStatement(n: usize) -> usize {
    const token = ast.tokenOf(n)
    const value = ast.node(n).*.lhs
    const skip = movedOut
    movedOut = 0
    if state.cleanupCount() == 0 && !state.hasTemporaries() { return n }
    const block = ast.make(ast.BLOCK, token)
    if value != 0 {
        typing.addType(value)
        var ty = ast.typeOf(value)
        if types.kind(ty) != types.VOID {
            // A reference result is an address.
            const isRef = types.isReference(ty)
            if isRef {
                ty = types.pointerTo(types.baseOf(ty))
                ast.node(value).*.ty = ty
            }
            const tmp = newTemp(ty, token)
            appendStatement(block, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(tmp, token), value, token)), token))
            const kept = variable(tmp, token)
            if isRef { ast.node(kept).*.ty = ast.typeOf(value) }
            ast.node(n).*.lhs = kept
        } else {
            appendStatement(block, ast.unary(ast.EXPR_STMT, value, token))
            ast.node(n).*.lhs = 0
        }
    }
    appendStatement(block, flushStatement(token))
    appendStatement(block, destroyAbove(0, skip, token))
    appendStatement(block, n)
    return block
}

// ---------------------------------------------------------------------------
// Declaring a class

// A class's body begins (its tag `tag`, 0 for none): the class is set
// up, its base clause read, its scope entered.
// Whether the class was declared without a tag (`struct { ... } x;`).
pub fn isAnonymousClass(ty: usize) -> bool {
    const c = info(ty)
    if c == 0 { return false }
    return at(c).*.anonymous
}

pub fn beginClass(ty: usize, tag: u32, written: u32, token: usize) -> void {
    const c = base.alloc(@sizeOf(Class))
    at(c).*.ty = ty
    var name = tag
    if name != 0 && state.currentFunction() != 0 {
        // A local class: named below its function, apart from the
        // local classes of the other functions.
        const owner = base.join(base.nameOf(ast.obj(state.currentFunction()).*.name), "#local")
        types.at(ty).*.name = scope.qualify(scope.qualify(scope.currentNamespace(), base.intern(owner)), tag)
    }
    if name == 0 {
        anonymousCount += 1
        name = base.intern(base.join("__anon", base.decimal(@intCast(u64, anonymousCount))))
        types.at(ty).*.name = scope.qualify(scope.currentNamespace(), name)
        at(c).*.anonymous = true
    }
    at(c).*.name = name
    at(c).*.written = if written != 0 { written } else { name }
    at(c).*.prefix = types.at(ty).*.name
    types.at(ty).*.info = c
    base.putWord(classByPrefix + @intCast(usize, at(c).*.prefix) * 8, ty)
    // The class's name names its scope (`S::f`).
    if tag != 0 {
        const known = scope.findHere(tag)
        if known == 0 || scope.at(known).*.kind != scope.NAMESPACE { const bound = scope.bindNamespace(tag, at(c).*.prefix) }
    }
    // The base clause sees the class's scope: a template instance's
    // parameters are bound there (`struct is_enum : bc<__is_enum(T)>`).
    scope.enterPrefix(at(c).*.prefix)
    if cursor.consume(names.P_COLON) {
        while true {
            while cursor.consume(names.K_PUBLIC) || cursor.consume(names.K_PRIVATE) || cursor.consume(names.K_PROTECTED) || cursor.consume(names.K_VIRTUAL) {}
            const start = cursor.peek()
            const b = decl.declspec(0)
            completeIfNeeded(b)
            if info(b) == 0 || types.at(b).*.incomplete {
                const named = if types.kind(b) == types.STRUCT && types.at(b).*.name != 0 { base.join(": ", base.nameOf(types.at(b).*.name)) } else { "" }
                tokens.errorAt(start, base.join("the base is not a complete class", named))
            }
            if at(c).*.baseClass != 0 { tokens.errorAt(start, "multiple inheritance is not supported") }
            at(c).*.baseClass = b
            if !cursor.consume(names.P_COMMA) { break }
        }
    }
    classDepth += 1
    if state.currentFunction() != 0 {
        at(c).*.isLocal = true
        scope.beginQualified()
    }
}

// A class made by the compiler (a lambda's closure, lambda.mlx) named
// `name` in the current namespace: its type, with its class record and
// its scope's name bound, no members yet.
// The record of a class declared but not defined (a class template's
// instance named in a typedef: template.declaredInstance), so that its
// template and arguments can be kept (setTemplateOrigin) until it is
// completed (beginClass makes the record of the definition).
pub fn forwardInfo(ty: usize, name: u32, written: u32) -> void {
    const c = base.alloc(@sizeOf(Class))
    at(c).*.ty = ty
    at(c).*.name = name
    at(c).*.written = written
    at(c).*.prefix = types.at(ty).*.name
    types.at(ty).*.info = c
    base.putWord(classByPrefix + @intCast(usize, at(c).*.prefix) * 8, ty)
}

pub fn newClass(name: u32) -> usize {
    const ty = types.structType()
    types.at(ty).*.kind = types.STRUCT
    types.at(ty).*.name = scope.qualify(scope.currentNamespace(), name)
    const c = base.alloc(@sizeOf(Class))
    at(c).*.ty = ty
    at(c).*.name = name
    at(c).*.written = name
    at(c).*.prefix = types.at(ty).*.name
    types.at(ty).*.info = c
    base.putWord(classByPrefix + @intCast(usize, at(c).*.prefix) * 8, ty)
    const bound = scope.bindNamespace(name, at(c).*.prefix)
    const tag = scope.bindTag(name, ty)
    return ty
}

// Adds a data member to such a class (laid out by finishClass).
pub fn addMember(ty: usize, name: u32, memberTy: usize, token: usize) -> usize {
    const ignored = completeIfNeeded(memberTy)
    const m = types.newMember(memberTy, name, token)
    var index: i64 = 0
    var last: usize = 0
    var at_member = types.at(ty).*.members
    while at_member != 0 {
        index += 1
        last = at_member
        at_member = types.member(at_member).*.next
    }
    types.member(m).*.index = index
    if last == 0 { types.at(ty).*.members = m } else { types.member(last).*.next = m }
    return m
}

// Lays such a class out and completes it.
pub fn finishClass(ty: usize) -> void {
    types.layoutStruct(ty, false)
    if types.size(ty) == 0 { types.at(ty).*.size = 1 }
    types.at(ty).*.incomplete = false
    types.syncConst(ty)
    at(info(ty)).*.complete = true
}

// Marks the class as the instance of the template `record` with `args`.
pub fn setTemplateOrigin(ty: usize, record: usize, args: usize) -> void {
    const c = info(ty)
    if c == 0 { return }
    at(c).*.templateRecord = record
    at(c).*.templateArgs = args
}

// Completes `ty` when it is a class template's instance named without
// being instantiated (template.complete), for what needs it whole: a
// member, its size, an object of it, a base class, a qualified name.
pub fn completeIfNeeded(ty: usize) -> bool {
    var t = ty
    while types.kind(t) == types.ARRAY || types.kind(t) == types.REF { t = types.baseOf(t) }
    const u = types.unqualified(t)
    if (types.kind(u) == types.STRUCT || types.kind(u) == types.UNION) && types.at(u).*.incomplete { template.complete(u) }
    return false
}

pub fn templateRecordOf(ty: usize) -> usize {
    const c = info(ty)
    if c == 0 { return 0 }
    return at(c).*.templateRecord
}

pub fn templateArgsOf(ty: usize) -> usize {
    const c = info(ty)
    if c == 0 { return 0 }
    return at(c).*.templateArgs
}

// The base class as the class's first member, 0 when there is none.
pub fn baseMember(ty: usize, token: usize) -> usize {
    const c = info(ty)
    if c == 0 || at(c).*.baseClass == 0 { return 0 }
    const m = types.newMember(at(c).*.baseClass, 0, token)
    types.member(m).*.isBase = true
    return m
}

// A member declaration that is not a data member: an access specifier,
// a constructor, a destructor, a friend, a using-declaration. True when
// one was read.
pub fn specialMember(ty: usize) -> bool {
    const c = info(ty)
    if cursor.is(names.K_PUBLIC) || cursor.is(names.K_PRIVATE) || cursor.is(names.K_PROTECTED) {
        cursor.advance()
        cursor.expect(names.P_COLON)
        return true
    }
    if cursor.consume(names.K_FRIEND) {
        friendDeclaration(ty)
        return true
    }
    if cursor.is(names.K_USING) && tokens.kind(cursor.peekNext()) == tokens.IDENT && tokens.is(tokens.next(cursor.peekNext()), names.P_ASSIGN) {
        // `using T = type;`: a typedef of the class's scope.
        decl.usingDeclaration()
        return true
    }
    if cursor.is(names.K_USING) && tokens.isWord(cursor.peekNext(), names.K_ENUM) {
        decl.usingDeclaration()
        return true
    }
    if cursor.consume(names.K_USING) {
        while !cursor.consume(names.P_SEMI) {
            if cursor.isEof() { cursor.fail("unterminated using-declaration") }
            cursor.advance()
        }
        return true
    }
    if cursor.is(names.K_TEMPLATE) {
        template.memberTemplate(ty)
        return true
    }
    if !cursor.is(names.K_TYPEDEF) && !cursor.is(names.K_STATIC_ASSERT) && template.abbreviatedHeader(cursor.peek()) != 0 {
        // `void f(auto x)` in a class: a member template.
        cursor.restore(template.lastAbbreviatedHeader())
        template.memberTemplate(ty)
        return true
    }
    // A constructor `S(`, `explicit S(`, `inline S(`; a destructor `~S(`,
    // `virtual ~S(`.
    const start = cursor.save()
    var isVirtual = false
    // Attributes before the specifiers (`__attribute__((visibility("default"))) explicit X(int);`).
    const leadingAttributes = decl.attributes()
    decl.stdAttributes()
    while cursor.is(names.K_EXPLICIT) || cursor.is(names.K_INLINE) || cursor.is(names.K_VIRTUAL) || cursor.is(names.K_CONSTEXPR) {
        if cursor.is(names.K_VIRTUAL) { isVirtual = true }
        cursor.advance()
    }
    if cursor.isIdent() && tokens.name(cursor.peek()) == at(c).*.written && cursor.isToken(cursor.peekNext(), names.P_LPAREN) {
        const token = cursor.peek()
        cursor.advance()
        cursor.advance()
        const fnType = decl.functionParameters(types.voidOf())
        const hadBody = memberFunction(ty, fnType, token, at(c).*.written, false, false, true, false)
        if !hadBody { cursor.expect(names.P_SEMI) }
        return true
    }
    if cursor.consume(names.P_TILDE) {
        const token = cursor.expectIdent()
        if tokens.name(token) != at(c).*.written { tokens.errorAt(token, "the destructor's name is not the class's") }
        cursor.expect(names.P_LPAREN)
        const fnType = decl.functionParameters(types.voidOf())
        const name = base.intern(base.join("~", base.nameOf(at(c).*.written)))
        const hadBody = memberFunction(ty, fnType, token, name, false, isVirtual, false, true)
        if !hadBody { cursor.expect(names.P_SEMI) }
        return true
    }
    cursor.restore(start)
    return false
}

// Whether the friend declaration at the cursor names a function
// template's instance (`friend R f<A, B...>(P);`): a name followed by
// `<...>(` before any `{` or `;`.
fn friendSpecializationAhead() -> bool {
    var t = cursor.peek()
    var count: usize = 0
    while !tokens.isEof(t) && count < 200 {
        count += 1
        if tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE) || tokens.is(t, names.P_LPAREN) { return false }
        if tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_LT) {
            const after = template.endOfArguments(tokens.next(t))
            if after != 0 && tokens.is(after, names.P_LPAREN) && !decl.isTypenameStart(t) { return true }
            if after != 0 { t = after } else { return false }
            continue
        }
        t = tokens.next(t)
    }
    return false
}

// `friend class X;` is nothing; `friend f(...)` declares f in the
// namespace around the class (its body, if any, read after the class).
fn friendDeclaration(ty: usize) -> void {
    // `friend class X;`, `friend class N::X;`, `friend class X<T>;`,
    // `friend T;`: no parenthesis before the `;` (access is not
    // checked: nothing to declare).
    var t = cursor.peek()
    while !tokens.isEof(t) && !tokens.is(t, names.P_SEMI) && !tokens.is(t, names.P_LPAREN) && !tokens.is(t, names.P_LBRACE) { t = tokens.next(t) }
    if tokens.is(t, names.P_SEMI) {
        cursor.restore(tokens.next(t))
        return
    }
    const c = info(ty)
    if friendSpecializationAhead() {
        // `friend R f<A>(...);`: friendship to a template's instance
        // (access is not checked): nothing to declare.
        var depth: i64 = 0
        while !cursor.isEof() {
            if depth == 0 && cursor.is(names.P_SEMI) { break }
            if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACE) { depth += 1 }
            if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACE) { depth -= 1 }
            cursor.advance()
        }
        cursor.expect(names.P_SEMI)
        return
    }
    // The type is read in the class (a class template's own name is its
    // instance there: `friend bool operator==(const V &, const V &)`),
    // the function declared in the namespace around it.
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    const found = decl.declarator(baseType)
    if found.1 == 0 || types.kind(found.0) != types.FUNC { cursor.fail("expected a friend function") }
    scope.leaveNamespace()
    const kind = if cursor.is(names.P_ASSIGN) && cursor.isToken(cursor.peekNext(), names.K_DEFAULT) { comparisonKind(tokens.name(found.1)) } else { -1 }
    if kind >= 0 {
        // `friend bool operator==(X, X) = default;`: a body made for it
        // (and an == for a <=>).
        cursor.advance()
        cursor.advance()
        cursor.expect(names.P_SEMI)
        defaultedFriend(found.0, found.1, attr, kind, ty)
        if kind == 2 {
            const eqType = types.functionReturning(types.boolOf())
            types.at(eqType).*.params = types.at(found.0).*.params
            const eqToken = tokens.copy(found.1)
            tokens.at(eqToken).*.name = operatorFunction("==")
            defaultedFriend(eqType, eqToken, attr, 0, ty)
        }
        scope.enterPrefix(at(c).*.prefix)
        return
    }
    const fnObj = decl.declareFunction(found.0, found.1, attr)
    if ast.obj(fnObj).*.token == 0 { ast.obj(fnObj).*.token = found.1 }
    if cursor.is(names.P_LBRACE) {
        // Its body sees the class's names.
        ast.obj(fnObj).*.isWeak = true
        ast.obj(fnObj).*.isInline = true
        deferBody(fnObj, ty)
    } else {
        cursor.expect(names.P_SEMI)
    }
    scope.enterPrefix(at(c).*.prefix)
}

// A defaulted friend comparison declared (in the namespace around the
// class `classTy`) with its body made.
fn defaultedFriend(fnType: usize, nameToken: usize, attr: usize, kind: i64, classTy: usize) -> void {
    const first = types.at(fnType).*.params
    if first == 0 || types.param(first).*.next == 0 { tokens.errorAt(nameToken, "a defaulted comparison takes two objects") }
    const second = types.param(first).*.next
    if types.param(first).*.name == 0 { types.param(first).*.name = base.intern("__mlxcc_lhs") }
    if types.param(second).*.name == 0 { types.param(second).*.name = base.intern("__mlxcc_rhs") }
    const fnObj = decl.declareFunction(fnType, nameToken, attr)
    if ast.obj(fnObj).*.token == 0 { ast.obj(fnObj).*.token = nameToken }
    if ast.obj(fnObj).*.isDefinition { return }
    ast.obj(fnObj).*.isWeak = true
    ast.obj(fnObj).*.isInline = true
    const text = base.join(base.join(base.join(base.join(base.join(base.join("{ return __mlxcc_defaulted(", base.decimal(@intCast(u64, kind))), ", "), base.nameOf(types.param(first).*.name)), ", "), base.nameOf(types.param(second).*.name)), "); }")
    const after = cursor.save()
    cursor.restore(generatedTokens(text))
    deferBody(fnObj, classTy)
    cursor.restore(after)
}

pub fn withThisPublic(classTy: usize, fnType: usize) -> usize { return withThis(classTy, fnType) }

// The function type with `this` (a pointer to the class) first.
fn withThis(classTy: usize, fnType: usize) -> usize {
    const t = types.functionReturning(types.baseOf(fnType))
    types.at(t).*.variadic = types.at(fnType).*.variadic
    types.at(t).*.constMethod = types.at(fnType).*.constMethod
    types.at(t).*.emptyPacks = types.at(fnType).*.emptyPacks
    const p = types.newParam(types.pointerTo(classTy), names.K_THIS, 0)
    types.param(p).*.next = types.at(fnType).*.params
    types.at(t).*.params = p
    return t
}

// The qualifiers after a member function's parameters: const, volatile,
// &, &&, noexcept, throw(), override, final, attributes. Whether const
// was among them.
pub fn trailingQualifiers() -> bool {
    var isConst = false
    while true {
        if cursor.consume(names.K_CONST) {
            isConst = true
        } else if cursor.consume(names.K_VOLATILE) || cursor.consume(names.P_AMP) || cursor.consume(names.P_ANDAND) {
        } else if cursor.consume(names.K_NOEXCEPT) {
            if cursor.is(names.P_LPAREN) { decl.skipParentheses() }
        } else if cursor.consume(names.K_THROW) {
            decl.skipParentheses()
        } else if cursor.isIdent() && (tokens.name(cursor.peek()) == overrideName || tokens.name(cursor.peek()) == finalName) {
            cursor.advance()
        } else if cursor.is(names.K_GNU2_ATTRIBUTE) {
            const ignored = decl.attributes()
        } else {
            return isConst
        }
    }
    return isConst
}

// Declares the member function `name` of the class with type `fnType`
// (without `this`), reading what follows its parameters: qualifiers,
// `= 0`, `= default`, `= delete`, or a body (skipped, read after the
// class). True when a body was there.
// The member function being declared is constexpr (set by the class
// reader before memberFunction).
pub var declaringConstexpr = false

pub fn memberFunction(classTy: usize, fnType: usize, nameToken: usize, name: u32, declaredStatic: bool, isVirtual: bool, isCtor: bool, isDtor: bool) -> bool {
    const c = info(classTy)
    // A class's operator new and delete are static members.
    const text0 = base.nameOf(name)
    const isStatic = declaredStatic || base.same(text0, "operatornew") || base.same(text0, "operatornew[]") || base.same(text0, "operatordelete") || base.same(text0, "operatordelete[]")
    if trailingQualifiers() { types.at(fnType).*.constMethod = true }
    var isPure = false
    var defaulted = false
    var deleted = false
    if cursor.consume(names.P_ASSIGN) {
        if cursor.consume(names.K_DEFAULT) {
            defaulted = true
        } else if cursor.consume(names.K_DELETE) {
            deleted = true
        } else {
            const zero = cursor.peek()
            if tokens.kind(zero) != tokens.INTEGER || tokens.at(zero).*.value != 0 { cursor.fail("expected 0, default or delete") }
            cursor.advance()
            isPure = true
        }
    }
    var generatedBody: usize = 0
    if defaulted && !isCtor && !isDtor && comparisonKind(name) >= 0 {
        // `bool operator==(const X &) const = default;`: a body made
        // for it (defaultedComparison reads it once the class is whole).
        const p = types.at(fnType).*.params
        if p == 0 { cursor.fail("a defaulted comparison takes the other object") }
        if types.param(p).*.name == 0 { types.param(p).*.name = base.intern("__mlxcc_rhs") }
        generatedBody = generatedTokens(base.join(base.join(base.join(base.join("{ return __mlxcc_defaulted(", base.decimal(@intCast(u64, comparisonKind(name)))), ", *this, "), base.nameOf(types.param(p).*.name)), "); }"))
        defaulted = false
    }
    if defaulted || deleted {
        if isCtor && defaulted {
            if types.at(fnType).*.params == 0 { at(c).*.defaultedDefault = true } else { at(c).*.defaultedCopy = true }
        }
        return false
    }
    const symbol = mangle.functionSymbol(at(c).*.prefix, name, fnType, base.nameOf(at(c).*.written))
    if isStatic { types.at(fnType).*.constMethod = false }
    const ty = if isStatic { fnType } else { withThis(classTy, fnType) }
    var o: usize = 0
    const binding = scope.findQualified(at(c).*.prefix, name, false)
    if binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isFunction {
        var candidate = scope.at(binding).*.obj
        while true {
            if decl.sameSignature(ast.obj(candidate).*.ty, ty) {
                o = candidate
                break
            }
            if ast.obj(candidate).*.nextOverload == 0 {
                o = newMethod(classTy, name, nameToken, ty, symbol)
                ast.obj(candidate).*.nextOverload = o
                break
            }
            candidate = ast.obj(candidate).*.nextOverload
        }
    } else {
        o = newMethod(classTy, name, nameToken, ty, symbol)
        const bound = scope.bindVariable(name, o)
    }
    const obj = ast.obj(o)
    obj.*.isConstexpr = declaringConstexpr
    obj.*.isStaticMember = isStatic
    obj.*.isConstructor = isCtor
    obj.*.isDestructor = isDtor
    if isVirtual { obj.*.isVirtual = true }
    if isPure {
        obj.*.isVirtual = true
        obj.*.isPure = true
    }
    if isCtor && at(c).*.constructors == 0 { at(c).*.constructors = o }
    if isDtor { at(c).*.destructor = o }
    const text = base.nameOf(name)
    if text.length > 9 && base.same(text[0..9], "operator@") {
        const conversion = base.alloc(24)
        base.putWord(conversion, o)
        base.putWord(conversion + 8, types.baseOf(fnType))
        base.putWord(conversion + 16, at(c).*.conversions)
        at(c).*.conversions = conversion
    }
    if generatedBody != 0 {
        obj.*.isWeak = true
        obj.*.isInline = true
        const after = cursor.save()
        cursor.restore(generatedBody)
        if (template.instantiating() || pendBodies) && !obj.*.isVirtual { pendBody(o, classTy) } else { deferBody(o, classTy) }
        cursor.restore(after)
        const ended = cursor.consume(names.P_SEMI)
        if comparisonKind(name) == 2 && memberOf(classTy, operatorFunction("==")) == 0 {
            // A defaulted <=> brings a defaulted == with it.
            const eqType = types.functionReturning(types.boolOf())
            types.at(eqType).*.params = types.at(fnType).*.params
            types.at(eqType).*.constMethod = types.at(fnType).*.constMethod
            const outer = cursor.save()
            cursor.restore(generatedTokens("= default;"))
            const madeEq = memberFunction(classTy, eqType, nameToken, operatorFunction("=="), false, false, false, false)
            cursor.restore(outer)
        }
        return true
    }
    if cursor.is(names.P_LBRACE) || (isCtor && cursor.is(names.P_COLON)) {
        obj.*.isWeak = true
        obj.*.isInline = true
        if (template.instantiating() || pendBodies) && !obj.*.isVirtual {
            // A class template's instance: the body waits for a call.
            pendBody(o, classTy)
        } else {
            deferBody(o, classTy)
        }
        return true
    }
    return false
}

// ---------------------------------------------------------------------------
// Defaulted comparisons

// The comparison an operator function's name is: 0 ==, 1 !=, 2 <=>,
// 3 <, 4 >, 5 <=, 6 >=; -1 for none.
fn comparisonKind(name: u32) -> i64 {
    const text = base.nameOf(name)
    if base.same(text, "operator==") { return 0 }
    if base.same(text, "operator!=") { return 1 }
    if base.same(text, "operator<=>") { return 2 }
    if base.same(text, "operator<") { return 3 }
    if base.same(text, "operator>") { return 4 }
    if base.same(text, "operator<=") { return 5 }
    if base.same(text, "operator>=") { return 6 }
    return -1
}

// The tokens of a piece of C++ the compiler writes (ending in EOF).
var generatedCount: u64 = 0
pub fn generatedTokens(text: []const u8) -> usize {
    generatedCount += 1
    const file = base.textFile(base.join("<generated ", base.join(base.decimal(generatedCount), ">")), text)
    const list = lexer.tokenize(file)
    literal.convert(list)
    return list
}

// The data members' names of the class `ty`, its bases' first, as
// `prefix.name` joined by `separator`... (appended to `names` with
// their count); whether one is floating.
var comparedNames: usize = 0
var comparedCount: usize = 0
var comparedFloating = false

fn collectCompared(ty: usize) -> void {
    var m = types.at(ty).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        if types.member(m).*.isBase {
            collectCompared(types.unqualified(mt))
        } else if types.member(m).*.name != 0 && comparedCount < 256 {
            base.putWord(comparedNames + comparedCount * 8, @intCast(usize, types.member(m).*.name))
            comparedCount += 1
            const k = types.kind(types.unqualified(mt))
            if k == types.FLOAT || k == types.DOUBLE || k == types.LDOUBLE { comparedFloating = true }
        }
        m = types.member(m).*.next
    }
}

var defaultedCount: u64 = 0

// `__mlxcc_defaulted(kind, a, b)`, the body of a defaulted comparison,
// at its name: a and b compared member by member (== and the
// three-way comparison; != and the relational operators through them).
pub fn defaultedComparison(token: usize) -> usize {
    cursor.advance()
    cursor.expect(names.P_LPAREN)
    const kind = eval.constExpression()
    cursor.expect(names.P_COMMA)
    const lhs = expr.assign()
    cursor.expect(names.P_COMMA)
    const rhs = expr.assign()
    cursor.expect(names.P_RPAREN)
    typing.addType(lhs)
    typing.addType(rhs)
    defaultedCount += 1
    const l = base.join("__mlxcc_l", base.decimal(defaultedCount))
    const r = base.join("__mlxcc_r", base.decimal(defaultedCount))
    const ty = types.unqualified(types.referenced(ast.typeOf(lhs)))
    completeIfNeeded(ty)
    var bound = bindReference(base.intern(l), lhs, token)
    bound = sequence(bound, bindReference(base.intern(r), rhs, token), token)
    var text: []const u8 = ""
    if kind == 1 {
        text = base.join(base.join(base.join(base.join("!(", l), " == "), r), ")")
    } else if kind >= 3 {
        const op = if kind == 3 { "<" } else if kind == 4 { ">" } else if kind == 5 { "<=" } else { ">=" }
        text = base.join(base.join(base.join(base.join(base.join(base.join("((", l), " <=> "), r), ") "), op), " 0)")
    } else {
        comparedNames = base.alloc(256 * 8)
        comparedCount = 0
        comparedFloating = false
        collectCompared(ty)
        if kind == 0 {
            text = "(true"
            var i: usize = 0
            while i < comparedCount {
                const name = base.nameOf(@intCast(u32, base.getWord(comparedNames + i * 8)))
                text = base.join(text, base.join(base.join(base.join(base.join(base.join(base.join(" && ", l), "."), name), " == "), r), base.join(".", name)))
                i += 1
            }
            text = base.join(text, ")")
        } else {
            const category = if comparedFloating { "std::partial_ordering" } else { "std::strong_ordering" }
            const equal = if comparedFloating { "::equivalent" } else { "::equal" }
            text = base.join(category, equal)
            var i = comparedCount
            while i > 0 {
                i -= 1
                const name = base.nameOf(@intCast(u32, base.getWord(comparedNames + i * 8)))
                const a = base.join(base.join(l, "."), name)
                const b = base.join(base.join(r, "."), name)
                // (a == b) ? rest : (a < b) ? less : greater
                text = base.join(base.join(base.join(base.join(base.join(base.join(base.join(base.join("((", a), " == "), b), ") ? ("), text), ") : (("), a), base.join(base.join(" < ", b), base.join(base.join(") ? ", category), base.join(base.join("::less : ", category), "::greater))"))))
            }
        }
    }
    const generated = generatedTokens(text)
    const saved = cursor.save()
    cursor.restore(generated)
    const compared = expr.assign()
    cursor.restore(saved)
    typing.addType(compared)
    const n = ast.binary(ast.COMMA, bound, compared, token)
    ast.node(n).*.ty = ast.typeOf(compared)
    return n
}

// A reference local named `name` bound to `value`: the binding.
fn bindReference(name: u32, value: usize, token: usize) -> usize {
    const refTy = types.referenceTo(ast.typeOf(value))
    const local = decl.newLocal(name, refTy, token)
    const target = ast.variableNode(local, token)
    ast.node(target).*.ty = refTy
    const made = ast.binary(ast.ASSIGN, target, typing.toReference(value, refTy), token)
    ast.node(made).*.ty = refTy
    return made
}

// Keeps a member function's body (at the cursor: `{`, or a
// constructor's `:`) for when the function is first called, and passes
// it.
pub fn pendBody(fnObj: usize, classTy: usize) -> void {
    ast.obj(fnObj).*.pendingBody = cursor.save()
    ast.obj(fnObj).*.pendingClass = classTy
    skipBody()
}

// The member function among `first`'s overloads whose parameters are
// `fnType`'s (without `this`): for `void S::f(int) { }`; 0 for none.
pub fn matchMember(first: usize, fnType: usize) -> usize {
    const withThisType = withThis(ast.obj(first).*.classType, fnType)
    var candidate = first
    while candidate != 0 {
        const ty = ast.obj(candidate).*.ty
        if ast.obj(candidate).*.isStaticMember {
            if decl.sameSignature(ty, fnType) { return candidate }
        } else if decl.sameSignature(ty, withThisType) {
            return candidate
        }
        candidate = ast.obj(candidate).*.nextOverload
    }
    return 0
}

fn newMethod(classTy: usize, name: u32, token: usize, ty: usize, symbol: u32) -> usize {
    const c = info(classTy)
    const o = ast.newObj(name, ty, token)
    const obj = ast.obj(o)
    obj.*.isFunction = true
    obj.*.classType = classTy
    obj.*.linkName = symbol
    obj.*.symbol = symbol
    state.addGlobal(o)
    const m = cell(o, 0)
    if at(c).*.methods == 0 { at(c).*.methods = m } else { base.putWord(at(c).*.methodsTail + 8, m) }
    at(c).*.methodsTail = m
    return o
}

// A static data member: a global of the class's scope, defined here
// when it has an initializer (`static int S::count` elsewhere else).
pub fn staticMember(classTy: usize, ty: usize, nameToken: usize, attr: usize) -> void {
    const c = info(classTy)
    const name = tokens.name(nameToken)
    if decl.attrAt(attr).*.isConstexpr && cursor.is(names.P_ASSIGN) && decl.constexprConstant(ty, nameToken) { return }
    if decl.attrAt(attr).*.isConstexpr && cursor.is(names.P_LBRACE) && decl.constexprBracedConstant(ty, nameToken) { return }
    const o = ast.newObj(name, ty, nameToken)
    const obj = ast.obj(o)
    obj.*.linkName = mangle.variableSymbol(at(c).*.prefix, name)
    obj.*.symbol = obj.*.linkName
    obj.*.alignment = types.alignOf(ty)
    state.addGlobal(o)
    const bound = scope.bindVariable(name, o)
    if cursor.consume(names.P_ASSIGN) || cursor.is(names.P_LBRACE) {
        initializer.globalInitializer(o)
        obj.*.isDefinition = true
        obj.*.isWeak = true
    }
}

// A data member's default initializer `= expr` or `{expr}`: kept as its
// tokens, read in each constructor.
pub fn memberInitializerTokens(m: usize) -> void {
    if cursor.consume(names.P_ASSIGN) {
        types.member(m).*.init = cursor.peek()
    } else if cursor.is(names.P_LBRACE) {
        types.member(m).*.init = cursor.peek()
    } else {
        return
    }
    // To the `,` or `;` ending the declarator.
    var level: u32 = 0
    while true {
        if cursor.isEof() { cursor.fail("unterminated member initializer") }
        if level == 0 && (cursor.is(names.P_COMMA) || cursor.is(names.P_SEMI)) { return }
        if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) || cursor.is(names.P_LBRACE) { level += 1 }
        if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) || cursor.is(names.P_RBRACE) {
            if level == 0 { cursor.fail("a member initializer without its `;`") }
            level -= 1
        }
        cursor.advance()
    }
}

// Remembers a function body to read after the class, and passes it.
fn deferBody(fnObj: usize, classTy: usize) -> void {
    const c = base.alloc(32)
    base.putWord(c, fnObj)
    base.putWord(c + 8, cursor.save())
    base.putWord(c + 16, classTy)
    if deferred == 0 { deferred = c } else { base.putWord(deferredTail + 24, c) }
    deferredTail = c
    skipBody()
}

// Passes a function body here, with a constructor's initializer list
// before it.
fn skipBody() -> void {
    if cursor.is(names.P_COLON) {
        // The initializer list, to the body's `{` (a `{` right after a
        // name is a brace initializer, skipped).
        var level: u32 = 0
        while true {
            if cursor.isEof() { cursor.fail("unterminated constructor") }
            if level == 0 && cursor.is(names.P_LBRACE) { break }
            if level == 0 && cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_LBRACE) {
                cursor.advance()
                skipBraces()
                continue
            }
            if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACE) { level += 1 }
            if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACE) { level -= 1 }
            cursor.advance()
        }
    }
    skipBraces()
}

fn skipBraces() -> void {
    cursor.expect(names.P_LBRACE)
    var level: u32 = 1
    while level > 0 {
        if cursor.isEof() { cursor.fail("unterminated function body") }
        if cursor.is(names.P_LBRACE) { level += 1 }
        if cursor.is(names.P_RBRACE) { level -= 1 }
        cursor.advance()
    }
}

// The members are read: the vtable pointer is added when the class has
// virtual functions of its own (a polymorphic base has one already).
pub fn finishMembers(ty: usize) -> void {
    const c = info(ty)
    buildVirtuals(c)
    if !at(c).*.hasVirtual { return }
    const b = at(c).*.baseClass
    if b != 0 {
        if !at(info(b)).*.hasVirtual { tokens.errorAt(cursor.peek(), "a class with virtual functions over a base without any is not supported") }
        return
    }
    const vptr = types.newMember(types.pointerTo(types.pointerTo(types.voidOf())), 0, cursor.peek())
    types.member(vptr).*.next = types.at(ty).*.members
    types.at(ty).*.members = vptr
    var index: i64 = 0
    var m = vptr
    while m != 0 {
        types.member(m).*.index = index
        index += 1
        m = types.member(m).*.next
    }
}

// Whether two member function types take the same parameters after
// `this`.
fn sameParameters(first: usize, second: usize) -> bool {
    var p = types.at(first).*.params
    var q = types.at(second).*.params
    if p != 0 { p = types.param(p).*.next }
    if q != 0 { q = types.param(q).*.next }
    while p != 0 && q != 0 {
        if !types.compatible(types.param(p).*.ty, types.param(q).*.ty) { return false }
        if !types.sameType(types.unqualified(types.param(p).*.ty), types.unqualified(types.param(q).*.ty)) { return false }
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
    return p == 0 && q == 0
}

// The virtual functions by slot: the base's, overridden where a member
// function has the same name and parameters, then the new ones.
fn buildVirtuals(c: usize) -> void {
    var head: usize = 0
    var tail: usize = 0
    var count: i64 = 0
    const b = at(c).*.baseClass
    if b != 0 {
        var inherited = at(info(b)).*.virtuals
        while inherited != 0 {
            const copy = cell(state.cellNode(inherited), 0)
            if head == 0 { head = copy } else { base.putWord(tail + 8, copy) }
            tail = copy
            count += 1
            inherited = state.cellNext(inherited)
        }
    }
    var m = at(c).*.methods
    while m != 0 {
        const o = state.cellNode(m)
        const obj = ast.obj(o)
        var slot: usize = 0
        var index: i64 = 0
        var s = head
        while s != 0 {
            const known = ast.obj(state.cellNode(s))
            if known.*.name == obj.*.name && sameParameters(known.*.ty, obj.*.ty) {
                slot = s
                break
            }
            if obj.*.isDestructor && known.*.isDestructor {
                slot = s
                break
            }
            index += 1
            s = state.cellNext(s)
        }
        if slot != 0 {
            base.putWord(slot, o)
            obj.*.isVirtual = true
            obj.*.slot = index
        } else if obj.*.isVirtual {
            const made = cell(o, 0)
            if head == 0 { head = made } else { base.putWord(tail + 8, made) }
            tail = made
            obj.*.slot = count
            count += 1
        }
        m = state.cellNext(m)
    }
    at(c).*.virtuals = head
    at(c).*.virtualCount = count
    at(c).*.hasVirtual = count > 0
}

// The class is laid out: its vtable is made and its member function
// bodies are read (once the outermost class is done).
pub fn completeClass(ty: usize) -> void {
    const c = info(ty)
    at(c).*.complete = true
    scope.leaveNamespace()
    if at(c).*.isLocal { scope.endQualified() }
    if at(c).*.hasVirtual {
        // The vtable needs every virtual function defined (one that
        // overrides without saying `virtual` may be pending); it exists
        // before their bodies are read (one may make an object of the
        // class, whose constructor stores the vtable's address).
        declareVtable(c)
        var s = at(c).*.virtuals
        while s != 0 {
            template.ensureDefined(state.cellNode(s))
            s = state.cellNext(s)
        }
        fillVtable(c)
    }
    classDepth -= 1
    if classDepth == 0 { readDeferred() }
}

// The vtable: a global array of the virtual functions' addresses, named
// _ZTV<class>, weak (every file that sees the class has one).
fn declareVtable(c: usize) -> void {
    const count = at(c).*.virtualCount
    const o = ast.newObj(mangle.vtableSymbol(at(c).*.prefix), types.arrayOf(types.pointerTo(types.voidOf()), count), 0)
    const obj = ast.obj(o)
    obj.*.linkName = obj.*.name
    obj.*.symbol = obj.*.name
    obj.*.isDefinition = true
    obj.*.isWeak = true
    obj.*.alignment = 8
    obj.*.initData = base.alloc(@intCast(usize, count) * 8)
    state.addGlobal(o)
    at(c).*.vtable = o
}

fn fillVtable(c: usize) -> void {
    const obj = ast.obj(at(c).*.vtable)
    var head: usize = 0
    var index: i64 = 0
    var s = at(c).*.virtuals
    while s != 0 {
        const fnObj = state.cellNode(s)
        if !ast.obj(fnObj).*.isPure {
            ast.obj(fnObj).*.isReferenced = true
            const r = base.alloc(@sizeOf(ast.Relocation))
            ast.relocation(r).*.offset = index * 8
            ast.relocation(r).*.target = fnObj
            ast.relocation(r).*.next = head
            head = r
        }
        index += 1
        s = state.cellNext(s)
    }
    obj.*.relocations = head
}

fn readDeferred() -> void {
    const saved = cursor.save()
    var c = deferred
    deferred = 0
    deferredTail = 0
    while c != 0 {
        cursor.restore(base.getWord(c + 8))
        if state.currentFunction() != 0 {
            // A local class's member: read apart from the function it is
            // in (whose locals it may not use).
            const context = template.beginContext()
            decl.defineFunction(base.getWord(c), base.getWord(c + 16))
            template.endContext(context)
        } else {
            decl.defineFunction(base.getWord(c), base.getWord(c + 16))
        }
        c = base.getWord(c + 24)
    }
    cursor.restore(saved)
}

// ---------------------------------------------------------------------------
// Constructor and destructor bodies

// The arguments `(a, b)` or `{a, b}` after their opener: the array and
// the count.
pub fn readArguments(closer: u32) -> (usize, usize) {
    const MAX_ARGS: usize = 256
    const given = base.alloc(MAX_ARGS * 8)
    const count = expr.argumentList(closer, given, MAX_ARGS)
    return -> (given, count)
}

// A constructor's start, before its `{`: the initializer list is read,
// and the base, the vtable pointer and the members are made in order;
// a block of statements (0 for none).
pub fn constructorPrologue(fnObj: usize) -> usize {
    const classTy = ast.obj(fnObj).*.classType
    const c = info(classTy)
    const token = cursor.peek()
    const self = thisPointer(token)
    // The initializers given: cells of (member or 0 for the base, args,
    // count, next).
    var inits: usize = 0
    if cursor.consume(names.P_COLON) {
        while true {
            var m: usize = 0
            var inner: usize = 0
            var isBase = false
            if cursor.isIdent() && tokens.name(cursor.peek()) == at(c).*.written && cursor.isToken(cursor.peekNext(), names.P_LPAREN) {
                // A delegating constructor: the other one makes the object.
                cursor.advance()
                cursor.advance()
                const args = readArguments(names.P_RPAREN)
                // (Made as any object is: a defaulted constructor too.)
                const delegated = construct(self, at(c).*.ty, args.0, args.1, token)
                if cursor.consume(names.P_COMMA) { cursor.fail("a delegating constructor has no other initializers") }
                const s = statementOf(flushTemporaries(delegated, false, token), token)
                const block = ast.make(ast.BLOCK, token)
                ast.node(block).*.body = s
                return block
            }
            if at(c).*.baseClass != 0 && decl.isTypename(cursor.peek()) {
                // The base, by its name (`Base`, `Base<T>`, a typedef).
                const named = decl.declspec(0)
                if info(named) != at(c).*.baseClass && !isBaseOf(named, at(c).*.baseClass) && info(named) != info(at(c).*.baseClass) { cursor.fail("not the base class") }
                isBase = true
            } else {
                const read = decl.qualifier()
                const nameToken = cursor.expectIdent()
                const name = tokens.name(nameToken)
                m = expr.findMember(classTy, name)
                if m != 0 && types.member(m).*.name != name {
                    // A member of an anonymous union or struct: the
                    // outer member, and the inner one below.
                    inner = expr.findMember(types.member(m).*.ty, name)
                }
                if m == 0 || (types.member(m).*.name != name && inner == 0) { tokens.errorAt(nameToken, "no such member") }
            }
            if !cursor.is(names.P_LPAREN) && !cursor.is(names.P_LBRACE) { cursor.fail("expected '(' or '{'") }
            const closer: u32 = if cursor.is(names.P_LPAREN) { names.P_RPAREN } else { names.P_RBRACE }
            cursor.advance()
            const args = readArguments(closer)
            const entry = base.alloc(40)
            base.putWord(entry, m)
            base.putWord(entry + 8, args.0)
            base.putWord(entry + 16, args.1)
            base.putWord(entry + 24, inits)
            base.putWord(entry + 32, inner)
            inits = entry
            if !cursor.consume(names.P_COMMA) { break }
        }
    }
    var n = nothing(token)
    if at(c).*.hasVirtual && at(c).*.baseClass == 0 { n = setVptr(self, c, token) }
    var m = types.at(classTy).*.members
    while m != 0 {
        const mt = types.member(m).*.ty
        const where = memberAddress(self, m, token)
        var given = inits
        while given != 0 && base.getWord(given) != m { given = base.getWord(given + 24) }
        if types.member(m).*.isBase {
            // The base's initializer is the entry without a member.
            given = inits
            while given != 0 && base.getWord(given) != 0 { given = base.getWord(given + 24) }
            if given != 0 {
                n = sequence(n, construct(where, mt, base.getWord(given + 8), base.getWord(given + 16), token), token)
            } else {
                n = sequence(n, construct(where, mt, 0, 0, token), token)
            }
            if at(c).*.hasVirtual { n = sequence(n, setVptr(self, c, token), token) }
        } else if types.member(m).*.name == 0 && (types.kind(mt) == types.UNION || types.kind(mt) == types.STRUCT) && !isClassType(mt) {
            // An anonymous union or struct: the member the list names,
            // else the default initializers of its members (a union's
            // first that has one).
            if given != 0 && base.getWord(given + 32) != 0 {
                const inner = base.getWord(given + 32)
                n = sequence(n, construct(memberAddress(where, inner, token), types.member(inner).*.ty, base.getWord(given + 8), base.getWord(given + 16), token), token)
            } else {
                var im = types.at(mt).*.members
                while im != 0 {
                    if types.member(im).*.init != 0 {
                        n = sequence(n, initializeMember(memberAddress(where, im, token), im, token), token)
                        if types.kind(mt) == types.UNION { break }
                    }
                    im = types.member(im).*.next
                }
            }
        } else if types.member(m).*.name == 0 && !isClassType(mt) {
            // The vtable pointer.
        } else if given != 0 {
            n = sequence(n, construct(where, mt, base.getWord(given + 8), base.getWord(given + 16), token), token)
        } else if types.member(m).*.init != 0 {
            n = sequence(n, initializeMember(where, m, token), token)
        } else if needsConstruction(mt) {
            n = sequence(n, construct(where, mt, 0, 0, token), token)
        }
        m = types.member(m).*.next
    }
    const s = statementOf(flushTemporaries(n, false, token), token)
    if s == 0 { return 0 }
    const block = ast.make(ast.BLOCK, token)
    ast.node(block).*.body = s
    return block
}

// A destructor's end: the members with destructors are destroyed, last
// first, then the base; a block (0 for none).
pub fn destructorEpilogue(fnObj: usize, token: usize) -> usize {
    const classTy = ast.obj(fnObj).*.classType
    const self = thisPointer(token)
    var count: usize = 0
    var m = types.at(classTy).*.members
    while m != 0 {
        count += 1
        m = types.member(m).*.next
    }
    const list = base.alloc(count * 8 + 8)
    var index: usize = 0
    m = types.at(classTy).*.members
    while m != 0 {
        base.putWord(list + index * 8, m)
        index += 1
        m = types.member(m).*.next
    }
    var n = nothing(token)
    while index > 0 {
        index -= 1
        const member = base.getWord(list + index * 8)
        if hasDestructor(types.member(member).*.ty) {
            n = sequence(n, destroy(memberAddress(self, member, token), types.member(member).*.ty, true, token), token)
        }
    }
    const s = statementOf(n, token)
    if s == 0 { return 0 }
    const block = ast.make(ast.BLOCK, token)
    ast.node(block).*.body = s
    return block
}

// The body of a function with what C++ adds around it: the constructor's
// prologue, the destructor's epilogue, the destruction of the parameters
// passed by value.
pub fn functionBody(fnObj: usize, prologue: usize, body: usize, token: usize) -> usize {
    var epilogue: usize = 0
    if ast.obj(fnObj).*.isDestructor { epilogue = destructorEpilogue(fnObj, token) }
    const cleanups = leaveScope(0, token)
    if prologue == 0 && epilogue == 0 && cleanups == 0 { return body }
    const block = ast.make(ast.BLOCK, token)
    appendStatement(block, prologue)
    appendStatement(block, body)
    appendStatement(block, epilogue)
    appendStatement(block, cleanups)
    return block
}

// ---------------------------------------------------------------------------
// Objects declared

// The elements a brace initializer of an array of unknown size gave.
var braceCount: i64 = 0

// `{ ... }` making the object of type `ty` at `address`, at the `{`: an
// array's elements, a class's constructor arguments, an aggregate's
// members (nested braces for nested ones), a scalar's value. What the
// braces leave out is made without arguments.
var initializerListName: u32 = 0

// The `std::initializer_list<E>` a constructor of the class takes as
// its one parameter (the others defaulted); 0 for none.
fn initializerListParameter(ty: usize) -> usize {
    const c = info(ty)
    if c == 0 { return 0 }
    if initializerListName == 0 { initializerListName = base.intern("initializer_list") }
    var ctor = at(c).*.constructors
    while ctor != 0 {
        var p = types.at(ast.obj(ctor).*.ty).*.params
        if p != 0 && types.param(p).*.name == names.K_THIS { p = types.param(p).*.next }
        if p != 0 && (types.param(p).*.next == 0 || types.param(types.param(p).*.next).*.defaultValue != 0) {
            const pt = types.unqualified(types.referenced(types.param(p).*.ty))
            if isClassType(pt) {
                const record = templateRecordOf(pt)
                if record != 0 && template.recordName(record) == initializerListName { return pt }
            }
        }
        ctor = ast.obj(ctor).*.nextOverload
    }
    return 0
}

// `{a, b, c}` (after its `{`) made into the initializer_list `listType`
// for the class's constructor taking one.
fn listConstruct(address: usize, ty: usize, listType: usize, token: usize) -> usize {
    const args = templateArgsOf(listType)
    if args == 0 || base.getWord(args) != 1 { tokens.errorAt(token, "an initializer_list of what?") }
    const element = base.getWord(args + 8)
    const values = base.alloc(1024 * 8)
    var count: usize = 0
    while !cursor.consumeEnd() {
        if count > 0 {
            cursor.expect(names.P_COMMA)
            if cursor.consumeEnd() { break }
        }
        if count >= 1024 { cursor.fail("too many elements in an initializer list") }
        // (`{ {1, 2}, {3, 4} }`: an element made by its braces.)
        const value = if cursor.is(names.P_LBRACE) { bracedTemporary(element, token) } else { expr.assign() }
        base.putWord(values + count * 8, typed(value))
        count += 1
    }
    const array = newTemp(types.arrayOf(element, @intCast(i64, count)), token)
    var n = nothing(token)
    var i: usize = 0
    while i < count {
        const where = elementAddress(addressOf(variable(array, token), token), element, number(@intCast(i64, i), types.longOf(), token), token)
        n = sequence(n, construct(where, element, argumentList(base.getWord(values + i * 8), 0), 1, token), token)
        i += 1
    }
    const first = typing.cast(addressOf(variable(array, token), token), types.pointerTo(types.constOf(element)))
    const list = temporaryObject(listType, argumentList(first, number(@intCast(i64, count), types.ulongOf(), token)), 2, token)
    return sequence(n, construct(address, ty, argumentList(list, 0), 1, token), token)
}

// `size` bytes at `address` zeroed (what braces leave out of a C++
// aggregate is value-initialized).
fn zeroAt(address: usize, size: i64, token: usize) -> usize {
    if size <= 0 { return nothing(token) }
    const n = ast.make(ast.MEMZERO, token)
    ast.node(n).*.lhs = address
    ast.node(n).*.value = size
    ast.node(n).*.ty = types.voidOf()
    return n
}

// The array member `ty` at `address` made from the initializers at the
// cursor without its own braces: as many as it has elements (the rest
// zero).
fn elidedArray(address: usize, ty: usize, token: usize) -> usize {
    const element = types.baseOf(ty)
    var n = nothing(token)
    var index: i64 = 0
    while index < types.at(ty).*.arrayLength {
        const where = elementAddress(address, element, number(index, types.longOf(), token), token)
        var given = index == 0 && !cursor.isEnd()
        if index > 0 && cursor.is(names.P_COMMA) && !cursor.isToken(cursor.peekNext(), names.P_RBRACE) {
            cursor.advance()
            given = true
        }
        if given {
            if cursor.is(names.P_LBRACE) {
                n = sequence(n, braceInitializer(where, element, token), token)
            } else {
                n = sequence(n, construct(where, element, argumentList(typed(expr.assign()), 0), 1, token), token)
            }
        } else {
            n = sequence(n, construct(where, element, 0, 0, token), token)
        }
        index += 1
    }
    return n
}

fn braceInitializer(address: usize, ty: usize, token: usize) -> usize {
    cursor.expect(names.P_LBRACE)
    const k = types.kind(ty)
    var n = nothing(token)
    if k == types.ARRAY {
        const element = types.baseOf(ty)
        var index: i64 = 0
        while !cursor.consumeEnd() {
            if index > 0 { cursor.expect(names.P_COMMA) }
            if types.at(ty).*.arrayLength >= 0 && index >= types.at(ty).*.arrayLength { cursor.fail("too many initializers") }
            const where = elementAddress(address, element, number(index, types.longOf(), token), token)
            if cursor.is(names.P_LBRACE) {
                n = sequence(n, braceInitializer(where, element, token), token)
            } else {
                n = sequence(n, construct(where, element, argumentList(typed(expr.assign()), 0), 1, token), token)
            }
            index += 1
        }
        braceCount = index
        if types.at(ty).*.arrayLength > index && !needsConstruction(element) {
            // The elements left out: zero.
            const rest = elementAddress(address, element, number(index, types.longOf(), token), token)
            n = sequence(n, zeroAt(rest, (types.at(ty).*.arrayLength - index) * types.size(element), token), token)
        }
        while types.at(ty).*.arrayLength >= 0 && index < types.at(ty).*.arrayLength {
            if !needsConstruction(element) { break }
            n = sequence(n, construct(elementAddress(address, element, number(index, types.longOf(), token), token), element, 0, 0, token), token)
            index += 1
        }
        return n
    }
    if hasConstructors(ty) {
        // `T x{a, b}` of a class with an initializer_list constructor:
        // the elements in an array the list points at (`{}` is the
        // default constructor's).
        const listType = initializerListParameter(ty)
        if listType != 0 && !cursor.is(names.P_RBRACE) { return listConstruct(address, ty, listType, token) }
        const args = readArguments(names.P_RBRACE)
        return construct(address, ty, args.0, args.1, token)
    }
    if k == types.STRUCT || k == types.UNION {
        const c = info(ty)
        if c != 0 && at(c).*.hasVirtual { n = setVptr(address, c, token) }
        var m = types.at(ty).*.members
        var first = true
        while m != 0 {
            const mt = types.member(m).*.ty
            const where = memberAddress(address, m, token)
            if types.member(m).*.isBase || (types.member(m).*.name == 0 && types.kind(mt) == types.PTR) || cursor.isEnd() {
                // A base, the vtable pointer, or a member the braces leave
                // out.
                if !types.member(m).*.isBase && types.member(m).*.name == 0 && types.kind(mt) == types.PTR {
                } else if types.member(m).*.init != 0 {
                    n = sequence(n, initializeMember(where, m, token), token)
                } else if needsConstruction(mt) {
                    n = sequence(n, construct(where, mt, 0, 0, token), token)
                } else if !types.member(m).*.isBase && types.member(m).*.bitWidth == 0 {
                    // Left out of the braces: zero.
                    n = sequence(n, zeroAt(where, types.size(mt), token), token)
                }
            } else {
                if !first { cursor.expect(names.P_COMMA) }
                first = false
                if cursor.is(names.P_LBRACE) {
                    n = sequence(n, braceInitializer(where, mt, token), token)
                } else if types.kind(mt) == types.ARRAY && types.at(mt).*.arrayLength > 0 {
                    // Brace elision: `{1, 2, 3}` for `struct { int v[3]; }`
                    // (SIMDe's vector unions).
                    n = sequence(n, elidedArray(where, mt, token), token)
                } else {
                    n = sequence(n, construct(where, mt, argumentList(typed(expr.assign()), 0), 1, token), token)
                }
            }
            if k == types.UNION { break }
            m = types.member(m).*.next
        }
        if !cursor.consumeEnd() { cursor.fail("too many initializers") }
        return n
    }
    // A scalar: `{}` is zero, `{v}` is v.
    if cursor.consumeEnd() { return construct(address, ty, 0, 0, token) }
    const value = expr.assign()
    if !cursor.consumeEnd() { cursor.fail("expected '}'") }
    return construct(address, ty, argumentList(value, 0), 1, token)
}

// A local of a class type, after its declarator: its initializer `(args)`,
// `= value`, `{...}` or none makes it; the statement (0 for none). The
// local is put on the cleanup stack when it has a destructor.
pub fn localObject(local: usize, token: usize) -> usize {
    var ty = ast.obj(local).*.ty
    const address = addressOf(variable(local, token), token)
    var init: usize = 0
    if cursor.consume(names.P_LPAREN) {
        const args = readArguments(names.P_RPAREN)
        init = construct(address, ty, args.0, args.1, token)
    } else if cursor.is(names.P_LBRACE) || (cursor.is(names.P_ASSIGN) && cursor.isToken(cursor.peekNext(), names.P_LBRACE)) {
        const ignored = cursor.consume(names.P_ASSIGN)
        init = braceInitializer(address, ty, token)
        if types.kind(ty) == types.ARRAY && types.at(ty).*.arrayLength < 0 {
            // `T a[] = {...}`: as many as given.
            ty = types.arrayOf(types.baseOf(ty), braceCount)
            ast.obj(local).*.ty = ty
        }
    } else if cursor.consume(names.P_ASSIGN) {
        init = initializeFrom(local, address, ty, expr.assign(), token)
    } else {
        init = construct(address, ty, 0, 0, token)
    }
    if hasDestructor(ty) { state.pushCleanup(local) }
    return statementOf(flushTemporaries(init, false, token), token)
}

// `auto x = value`, the value read already: the statement making x
// (0 for none); x on the cleanup stack when it has a destructor.
pub fn localObjectFrom(local: usize, value: usize, token: usize) -> usize {
    const ty = ast.obj(local).*.ty
    var init: usize = 0
    if isObjectType(ty) {
        init = initializeFrom(local, addressOf(variable(local, token), token), ty, value, token)
        if hasDestructor(ty) { state.pushCleanup(local) }
    } else {
        init = typed(ast.binary(ast.ASSIGN, variable(local, token), value, token))
    }
    return statementOf(flushTemporaries(init, false, token), token)
}

fn hasConstructors(ty: usize) -> bool {
    const c = info(ty)
    return c != 0 && at(c).*.constructors != 0
}

// `T x = value`: the value moved in when it is a temporary of the type
// (a call's result is written to x directly), copied when an object,
// converted through a constructor otherwise.
fn initializeFrom(local: usize, address: usize, ty: usize, value: usize, token: usize) -> usize {
    typing.addType(value)
    const vt = ast.typeOf(value)
    if sameClass(vt, ty) && ast.kindOf(value) == ast.FUNCALL && ast.node(value).*.returnBuffer != 0 {
        ast.obj(ast.node(value).*.returnBuffer).*.noDestroy = true
        ast.node(value).*.returnBuffer = local
        return value
    }
    return construct(address, ty, argumentList(value, 0), 1, token)
}

// A static local of a class type, after its declarator: made the first
// time its declaration runs (a flag beside it says so); the statement.
pub fn staticLocalObject(o: usize, token: usize) -> usize {
    const ty = ast.obj(o).*.ty
    ast.obj(o).*.isDefinition = true
    ast.obj(o).*.isTentative = false
    if ast.obj(o).*.initData == 0 {
        const size = types.size(ty)
        ast.obj(o).*.initData = base.alloc(@intCast(usize, if size > 0 { size } else { 1 }))
    }
    const flag = decl.newAnonymousGlobal(types.boolOf(), token)
    ast.obj(flag).*.initData = base.alloc(1)
    const address = addressOf(variable(o, token), token)
    var init: usize = 0
    if cursor.consume(names.P_LPAREN) {
        const args = readArguments(names.P_RPAREN)
        init = construct(address, ty, args.0, args.1, token)
    } else if cursor.is(names.P_LBRACE) || (cursor.is(names.P_ASSIGN) && cursor.isToken(cursor.peekNext(), names.P_LBRACE)) {
        const ignored = cursor.consume(names.P_ASSIGN)
        init = braceInitializer(address, ty, token)
    } else if cursor.consume(names.P_ASSIGN) {
        init = construct(address, ty, argumentList(expr.assign(), 0), 1, token)
    } else {
        init = construct(address, ty, 0, 0, token)
    }
    init = flushTemporaries(init, false, token)
    if isNothing(init) { return 0 }
    const guard = ast.make(ast.IF, token)
    guard_cond(guard, flag, token)
    const then = ast.make(ast.BLOCK, token)
    appendStatement(then, statementOf(init, token))
    appendStatement(then, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(flag, token), number(1, types.boolOf(), token), token)), token))
    ast.node(guard).*.then = then
    return guard
}

fn guard_cond(guard: usize, flag: usize, token: usize) -> void {
    ast.node(guard).*.cond = typed(ast.unary(ast.NOT, variable(flag, token), token))
}

// A global of a class type, after its declarator: made when the program
// starts.
pub fn globalObject(o: usize, token: usize) -> void {
    const ty = ast.obj(o).*.ty
    ast.obj(o).*.isDefinition = true
    ast.obj(o).*.isTentative = false
    if ast.obj(o).*.initData == 0 {
        // Zero bytes to start from.
        const size = types.size(ty)
        ast.obj(o).*.initData = base.alloc(@intCast(usize, if size > 0 { size } else { 1 }))
    }
    const address = addressOf(variable(o, token), token)
    var init: usize = 0
    if cursor.consume(names.P_LPAREN) {
        const args = readArguments(names.P_RPAREN)
        init = construct(address, ty, args.0, args.1, token)
    } else if cursor.is(names.P_LBRACE) || (cursor.is(names.P_ASSIGN) && cursor.isToken(cursor.peekNext(), names.P_LBRACE)) {
        const ignored = cursor.consume(names.P_ASSIGN)
        init = braceInitializer(address, ty, token)
        if types.kind(ty) == types.ARRAY && types.at(ty).*.arrayLength < 0 {
            ast.obj(o).*.ty = types.arrayOf(types.baseOf(ty), braceCount)
        }
    } else if cursor.consume(names.P_ASSIGN) {
        const value = expr.assign()
        init = construct(address, ty, argumentList(value, 0), 1, token)
    } else {
        init = construct(address, ty, 0, 0, token)
    }
    init = flushTemporaries(init, false, token)
    if !isNothing(init) {
        typing.addType(init)
        program.addGlobalInit(init)
    }
}

// ---------------------------------------------------------------------------
// The range-based for

// Whether `for (` is followed by `T x :` (a range-based for).
pub fn startsRangeFor() -> bool {
    if !decl.isTypename(cursor.peek()) { return false }
    const saved = cursor.save()
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    if structuredAhead() {
        // `auto &[k, v] : map`
        const ignored = structuredNames()
        const structured = cursor.is(names.P_COLON)
        cursor.restore(saved)
        return structured
    }
    const found = decl.declarator(baseType)
    const result = found.1 != 0 && cursor.is(names.P_COLON)
    cursor.restore(saved)
    return result
}

// The functions `name` of the namespace of the class `classTy` (past
// enclosing classes) as a callee, 0 for none.
fn namespaceFunction(classTy: usize, name: u32, token: usize) -> usize {
    const c = info(classTy)
    if c == 0 { return 0 }
    var ns = scope.parentOf(at(c).*.prefix)
    var found = scope.findQualified(ns, name, false)
    while found == 0 && ns != 0 {
        ns = scope.parentOf(ns)
        found = scope.findQualified(ns, name, false)
    }
    if found == 0 { return 0 }
    const nameToken = tokens.copy(token)
    tokens.at(nameToken).*.kind = tokens.IDENT
    tokens.at(nameToken).*.name = name
    return callableFor(found, nameToken)
}

// The functions `name` of the namespaces of the arguments' classes and
// enums (argument-dependent lookup) as a callee; 0 for none.
pub fn argumentDependent(name: u32, given: usize, count: usize, token: usize) -> usize {
    var i: usize = 0
    while i < count {
        const arg = base.getWord(given + i * 8)
        typing.addType(arg)
        var ty = types.unqualified(types.referenced(ast.typeOf(arg)))
        if types.kind(ty) == types.PTR { ty = types.unqualified(types.baseOf(ty)) }
        var prefix: u32 = 0
        if isClassType(ty) {
            const c = info(ty)
            if c != 0 { prefix = at(c).*.prefix }
        } else if types.kind(ty) == types.ENUM {
            prefix = types.at(ty).*.name
        }
        if prefix != 0 {
            var ns = scope.parentOf(prefix)
            var found = scope.findQualified(ns, name, false)
            while found == 0 && ns != 0 {
                ns = scope.parentOf(ns)
                found = scope.findQualified(ns, name, false)
            }
            if found != 0 {
                const nameToken = tokens.copy(token)
                tokens.at(nameToken).*.kind = tokens.IDENT
                tokens.at(nameToken).*.name = name
                const callee = callableFor(found, nameToken)
                if callee != 0 { return callee }
            }
        }
        i += 1
    }
    return 0
}

// `for (T x : range) body`, after `for (`, the FOR node `n` made with
// its labels and the for's scope entered: the range is kept by its
// address, the loop runs from its begin() to its end() (or over an
// array), and each round makes x from *iterator. The statement.
pub fn rangeFor(n: usize, token: usize) -> usize {
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    // `auto &[k, v] : map`: the names bound to each element's parts.
    var structured = false
    var bindsByReference = false
    var bindingNames: usize = 0
    var bindingNameCount: usize = 0
    var declaredTy: usize = 0
    var nameToken: usize = 0
    if structuredAhead() {
        const s = structuredNames()
        structured = true
        bindsByReference = s.0
        bindingNames = s.1
        bindingNameCount = s.2
    } else {
        const found = decl.declarator(baseType)
        declaredTy = found.0
        nameToken = found.1
    }
    cursor.expect(names.P_COLON)
    var range = expr.expression()
    cursor.expect(names.P_RPAREN)
    typing.addType(range)
    const rangeTy = ast.typeOf(range)
    // The range by its address (a temporary is kept for the loop).
    if !typing.isLvalue(range) && isClassType(rangeTy) {
        const held = newTemp(rangeTy, token)
        const made = construct(addressOf(variable(held, token), token), rangeTy, argumentList(consumed(range), 0), 1, token)
        if hasDestructor(rangeTy) { state.pushCleanup(held) }
        range = ast.binary(ast.COMMA, made, variable(held, token), token)
        ast.node(range).*.ty = rangeTy
    }
    const holder = newTemp(types.pointerTo(rangeTy), token)
    const keep = typed(ast.binary(ast.ASSIGN, variable(holder, token), addressOf(range, token), token))
    var first: usize = 0
    var last: usize = 0
    if types.kind(rangeTy) == types.ARRAY {
        const element = types.baseOf(rangeTy)
        first = typing.cast(variable(holder, token), types.pointerTo(element))
        last = typed(expr.newAdd(typing.cast(variable(holder, token), types.pointerTo(element)), number(types.at(rangeTy).*.arrayLength, types.longOf(), token), token))
    } else {
        const object = deref(variable(holder, token), token)
        const beginFn = findMethod(rangeTy, base.intern("begin"))
        const endFn = findMethod(rangeTy, base.intern("end"))
        if beginFn != 0 && endFn != 0 {
            first = expr.buildCall(methodNode(beginFn, addressOf(object, token), token), 0, 0, token)
            last = expr.buildCall(methodNode(endFn, addressOf(object, token), token), 0, 0, token)
        } else {
            // begin(range) and end(range) of the class's namespace
            // (filesystem::directory_iterator's).
            const beginFree = namespaceFunction(rangeTy, base.intern("begin"), token)
            const endFree = namespaceFunction(rangeTy, base.intern("end"), token)
            if beginFree == 0 || endFree == 0 { tokens.errorAt(token, "the range has no begin() and end()") }
            first = expr.buildCall(beginFree, argumentList(object, 0), 1, token)
            last = expr.buildCall(endFree, argumentList(deref(variable(holder, token), token), 0), 1, token)
        }
    }
    typing.addType(first)
    const iteratorTy = ast.typeOf(first)
    const it = newTemp(iteratorTy, token)
    const stop = newTemp(iteratorTy, token)
    const init = ast.make(ast.BLOCK, token)
    appendStatement(init, ast.unary(ast.EXPR_STMT, keep, token))
    if isClassType(iteratorTy) {
        // Iterators of a class: made from begin() and end() (copied by
        // their constructors, destroyed after the loop).
        // (One flush for both: the temporaries of end()'s call are
        // pending already while begin()'s result is made.)
        const madeFirst = initializeFrom(it, addressOf(variable(it, token), token), iteratorTy, first, token)
        const madeLast = initializeFrom(stop, addressOf(variable(stop, token), token), iteratorTy, last, token)
        const both = typed(ast.binary(ast.COMMA, madeFirst, madeLast, token))
        appendStatement(init, ast.unary(ast.EXPR_STMT, flushTemporaries(both, false, token), token))
        if hasDestructor(iteratorTy) {
            state.pushCleanup(it)
            state.pushCleanup(stop)
        }
    } else {
        appendStatement(init, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(it, token), first, token)), token))
        appendStatement(init, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(stop, token), last, token)), token))
    }
    ast.node(n).*.init = init
    var differs = binaryOperator("!=", variable(it, token), variable(stop, token), token)
    if differs == 0 { differs = typed(ast.binary(ast.NE, variable(it, token), variable(stop, token), token)) }
    ast.node(n).*.cond = differs
    var step = unaryOperator("++", variable(it, token), false, token)
    if step == 0 { step = expr.toAssign(expr.newAdd(variable(it, token), number(1, types.intOf(), token), token)) }
    typing.addType(step)
    ast.node(n).*.inc = step
    // The body: x from *it, then the statement, then x unmade.
    var current = unaryOperator("*", variable(it, token), false, token)
    if current == 0 { current = deref(variable(it, token), token) }
    typing.addType(current)
    var elementTy = declaredTy
    if !structured && decl.attrAt(attr).*.isAuto && !decl.attrAt(attr).*.hasType {
        var inferred = ast.typeOf(current)
        if types.kind(inferred) == types.ARRAY { inferred = types.pointerTo(types.baseOf(inferred)) }
        elementTy = if types.isReference(declaredTy) { types.referenceTo(inferred) } else { inferred }
    }
    scope.enter()
    const height = state.cleanupCount()
    state.setLoopCleanups(height)
    const body = ast.make(ast.BLOCK, token)
    if structured {
        bindStructured(body, baseType, bindsByReference, bindingNames, bindingNameCount, current, token)
        const statement = stmt.statement()
        typing.addType(statement)
        appendStatement(body, statement)
        appendStatement(body, leaveScope(height, token))
        scope.leave()
        ast.node(n).*.then = body
        return n
    }
    const local = decl.newLocal(tokens.name(nameToken), elementTy, nameToken)
    var made: usize = 0
    if types.isReference(elementTy) {
        const target = ast.variableNode(local, token)
        ast.node(target).*.ty = elementTy
        made = ast.binary(ast.ASSIGN, target, typing.toReference(current, elementTy), token)
        ast.node(made).*.ty = elementTy
    } else if isObjectType(elementTy) {
        made = construct(addressOf(variable(local, token), token), elementTy, argumentList(current, 0), 1, token)
        if hasDestructor(elementTy) { state.pushCleanup(local) }
    } else {
        made = typed(ast.binary(ast.ASSIGN, variable(local, token), current, token))
    }
    appendStatement(body, statementOf(flushTemporaries(made, false, token), token))
    const statement = stmt.statement()
    typing.addType(statement)
    appendStatement(body, statement)
    appendStatement(body, leaveScope(height, token))
    scope.leave()
    ast.node(n).*.then = body
    return n
}

// ---------------------------------------------------------------------------
// Class template argument deduction

var deducedType: usize = 0

// The type a declaration's specifiers stand for when they name a class
// template without its arguments (decl.deducedTemplate).
pub fn deducedMarker() -> usize {
    if deducedType == 0 {
        deducedType = types.structType()
        types.at(deducedType).*.name = base.intern("__mlxcc_deduced")
        types.at(deducedType).*.incomplete = true
    }
    return deducedType
}

// The class the initializer after the declarator `token` deduces
// (`(args)`, `{args}`, `= value`): the result of the deduction guide
// those arguments call. The cursor is not moved.
pub fn deducedClass(token: usize) -> usize {
    const named = decl.deducedTemplate
    const guides = template.guidesOf(named)
    if guides == 0 { tokens.errorAt(token, "no deduction guide for the class template") }
    const saved = cursor.save()
    // (Nothing read here runs: the temporaries it makes are dropped.)
    const pending = state.takeTemporaries()
    expr.unevaluated += 1
    var args: usize = 0
    var count: usize = 0
    if cursor.consume(names.P_LPAREN) {
        const read = readArguments(names.P_RPAREN)
        args = read.0
        count = read.1
    } else if cursor.consume(names.P_LBRACE) {
        const read = readArguments(names.P_RBRACE)
        args = read.0
        count = read.1
    } else if cursor.consume(names.P_ASSIGN) {
        args = argumentList(expr.assign(), 0)
        count = 1
    } else {
        tokens.errorAt(token, "the class template's arguments cannot be deduced without an initializer")
    }
    const nameToken = tokens.copy(token)
    tokens.at(nameToken).*.kind = tokens.IDENT
    tokens.at(nameToken).*.name = scope.at(guides).*.name
    const call = expr.buildCall(callableFor(guides, nameToken), args, count, token)
    typing.addType(call)
    expr.unevaluated -= 1
    const dropped = state.takeTemporaries()
    state.setTemporaries(pending)
    cursor.restore(saved)
    return types.unqualified(types.referenced(ast.typeOf(call)))
}

// ---------------------------------------------------------------------------
// Structured bindings

// C++17's `auto [a, b] = e;` and `for (auto &[k, v] : map)`: at the
// declarator after `auto` (an `&` or `&&` may come first), whether one
// is here.
pub fn structuredAhead() -> bool {
    var t = cursor.peek()
    if tokens.is(t, names.P_AMP) || tokens.is(t, names.P_ANDAND) { t = tokens.next(t) }
    return tokens.is(t, names.P_LBRACKET) && tokens.kind(tokens.next(t)) == tokens.IDENT
}

// `&[a, b]`, consumed: whether it binds by reference, the names'
// tokens (an array of words) and their count.
pub fn structuredNames() -> (bool, usize, usize) {
    var isRef = false
    if cursor.consume(names.P_AMP) || cursor.consume(names.P_ANDAND) { isRef = true }
    cursor.expect(names.P_LBRACKET)
    const list = base.alloc(32 * 8)
    var count: usize = 0
    while !cursor.isEof() {
        if count == 32 { cursor.fail("too many names in a structured binding") }
        base.putWord(list + count * 8, cursor.expectIdent())
        count += 1
        if !cursor.consume(names.P_COMMA) { break }
    }
    cursor.expect(names.P_RBRACKET)
    return -> (isRef, list, count)
}

var bindingCount: u64 = 0

// Tokens made for a binding's part (`__b.first`, `std::get<1>(__b)`),
// chained after `tail`; the last one.
fn madeIdent(tail: usize, name: u32) -> usize {
    const t = template.madeToken(tail, tokens.IDENT, base.nameOf(name), name)
    tokens.at(tail).*.next = t
    return t
}

fn madePunct(tail: usize, text: []const u8, id: u32) -> usize {
    const t = template.madeToken(tail, tokens.PUNCT, text, id)
    tokens.at(tail).*.next = t
    return t
}

fn madeInteger(tail: usize, value: usize) -> usize {
    const t = template.madeToken(tail, tokens.INTEGER, base.decimal(@intCast(u64, value)), 0)
    tokens.at(t).*.value = @intCast(u64, value)
    tokens.at(t).*.ty = types.ulongOf()
    tokens.at(tail).*.next = t
    return t
}

// The expression the tokens after `start` (to the `;` made after
// `tail`) read as.
fn partExpression(start: usize, tail: usize) -> usize {
    const semi = madePunct(tail, ";", names.P_SEMI)
    tokens.at(semi).*.next = tokens.eof(@intCast(u32, tokens.at(semi).*.file), tokens.at(semi).*.line)
    const saved = cursor.save()
    cursor.restore(tokens.next(start))
    const e = expr.assign()
    cursor.restore(saved)
    typing.addType(e)
    return e
}

// Whether the class is std::tuple's or std::array's instance (read
// through std::get<i>).
fn tupleLike(ty: usize) -> bool {
    const c = info(ty)
    if c == 0 || at(c).*.templateRecord == 0 { return false }
    const name = template.recordName(at(c).*.templateRecord)
    return name == base.intern("tuple") || name == base.intern("array")
}

// Binds the names to the parts of `value` (`baseType` the declaration's
// specifiers, `isRef` whether it said `&` or `&&`): a hidden variable
// holds the value (or refers to it), each name refers to its part (an
// array's element, std::get<i> of a tuple, a data member otherwise).
// The statements go to `block`.
pub fn bindStructured(block: usize, baseType: usize, isRef: bool, list: usize, count: usize, value: usize, token: usize) -> void {
    typing.addType(value)
    var valueTy = types.unqualified(types.referenced(ast.typeOf(value)))
    if types.isConst(types.referenced(ast.typeOf(value))) || types.isConst(baseType) { valueTy = types.constOf(valueTy) }
    bindingCount += 1
    const hiddenName = base.intern(base.join("__mlxcc_binding_", base.decimal(bindingCount)))
    const plain = types.unqualified(valueTy)
    completeIfNeeded(plain)
    if (isRef || types.kind(plain) == types.ARRAY) && typing.isLvalue(value) {
        // (An array by value: a copy made element by element from the
        // one referred to.)
        const copied = !isRef && types.kind(plain) == types.ARRAY
        const referName = if copied { base.intern(base.join(base.nameOf(hiddenName), "_source")) } else { hiddenName }
        const refTy = types.referenceTo(valueTy)
        const hidden = decl.newLocal(referName, refTy, token)
        const target = ast.variableNode(hidden, token)
        ast.node(target).*.ty = refTy
        const made = ast.binary(ast.ASSIGN, target, typing.toReference(value, refTy), token)
        ast.node(made).*.ty = refTy
        appendStatement(block, statementOf(flushTemporaries(made, false, token), token))
        if copied {
            const copy = decl.newLocal(hiddenName, plain, token)
            var e: i64 = 0
            while e < types.at(plain).*.arrayLength {
                const start = tokens.copy(token)
                var tail = madeIdent(start, hiddenName)
                tail = madePunct(tail, "[", names.P_LBRACKET)
                tail = madeInteger(tail, @intCast(usize, e))
                tail = madePunct(tail, "]", names.P_RBRACKET)
                tail = madePunct(tail, "=", names.P_ASSIGN)
                tail = madeIdent(tail, referName)
                tail = madePunct(tail, "[", names.P_LBRACKET)
                tail = madeInteger(tail, @intCast(usize, e))
                tail = madePunct(tail, "]", names.P_RBRACKET)
                appendStatement(block, statementOf(flushTemporaries(partExpression(start, tail), false, token), token))
                e += 1
            }
        }
    } else {
        const hidden = decl.newLocal(hiddenName, valueTy, token)
        appendStatement(block, localObjectFrom(hidden, value, token))
    }
    var member: usize = if types.kind(plain) == types.STRUCT { types.at(plain).*.members } else { 0 }
    const tuple = isClassType(plain) && tupleLike(plain)
    if types.kind(plain) == types.ARRAY && types.at(plain).*.arrayLength != @intCast(i64, count) { tokens.errorAt(token, "the structured binding's names do not match the array's length") }
    var i: usize = 0
    while i < count {
        const nameToken = base.getWord(list + i * 8)
        const start = tokens.copy(nameToken)
        var tail = start
        if types.kind(plain) == types.ARRAY {
            tail = madeIdent(tail, hiddenName)
            tail = madePunct(tail, "[", names.P_LBRACKET)
            tail = madeInteger(tail, i)
            tail = madePunct(tail, "]", names.P_RBRACKET)
        } else if tuple {
            tail = madeIdent(tail, base.intern("std"))
            tail = madePunct(tail, "::", names.P_SCOPE)
            tail = madeIdent(tail, base.intern("get"))
            tail = madePunct(tail, "<", names.P_LT)
            tail = madeInteger(tail, i)
            tail = madePunct(tail, ">", names.P_GT)
            tail = madePunct(tail, "(", names.P_LPAREN)
            tail = madeIdent(tail, hiddenName)
            tail = madePunct(tail, ")", names.P_RPAREN)
        } else {
            // The next named, non-static data member (bases' are not
            // counted: WTF's bindings name a class's own members).
            while member != 0 && (types.member(member).*.isBase || types.member(member).*.name == 0) { member = types.member(member).*.next }
            if member == 0 { tokens.errorAt(nameToken, "more names in the structured binding than the class has members") }
            tail = madeIdent(tail, hiddenName)
            tail = madePunct(tail, ".", names.P_DOT)
            tail = madeIdent(tail, types.member(member).*.name)
            member = types.member(member).*.next
        }
        const part = partExpression(start, tail)
        const refTy = types.referenceTo(types.referenced(ast.typeOf(part)))
        const local = decl.newLocal(tokens.name(nameToken), refTy, nameToken)
        const target = ast.variableNode(local, nameToken)
        ast.node(target).*.ty = refTy
        const made = ast.binary(ast.ASSIGN, target, typing.toReference(part, refTy), nameToken)
        ast.node(made).*.ty = refTy
        appendStatement(block, statementOf(flushTemporaries(made, false, nameToken), nameToken))
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Member access in expressions

// A name used in a member function that is a member of the class (or
// its bases): `this->name`, or the member function or static member;
// 0 when it is no member.
pub fn memberAccess(nameToken: usize) -> usize {
    const classTy = state.currentClass()
    if classTy == 0 { return 0 }
    const binding = scope.find(names.K_THIS)
    const name = tokens.name(nameToken)
    const o = memberOf(classTy, name)
    if o != 0 {
        if ast.obj(o).*.isFunction {
            if binding == 0 || ast.obj(o).*.isStaticMember { return methodNode(o, 0, nameToken) }
            if cursor.is(names.P_LT) { return methodNode(o, thisPointer(nameToken), nameToken) }
            return memberCallee(classTy, o, thisPointer(nameToken), nameToken)
        }
        ast.obj(o).*.isReferenced = true
        return expr.variableValue(o, nameToken)
    }
    if binding == 0 { return 0 }
    if expr.findMember(classTy, name) == 0 { return 0 }
    return expr.structReference(deref(thisPointer(nameToken), nameToken), nameToken)
}

// `object.name` where name is no data member: the member function (the
// callee, with the object's address) or the static member; 0 for none.
pub fn memberReference(object: usize, nameToken: usize) -> usize {
    typing.addType(object)
    const o = memberOf(ast.typeOf(object), tokens.name(nameToken))
    if o == 0 {
        // A member template: `obj.f<args>(...)` or `obj.f(...)`.
        var c = info(ast.typeOf(object))
        while c != 0 {
            const binding = scope.findQualified(at(c).*.prefix, tokens.name(nameToken), false)
            if template.isFunctionTemplate(binding) {
                var holder: usize = 0
                if cursor.is(names.P_LT) {
                    cursor.restore(nameToken)
                    holder = template.explicitPlaceholder(binding)
                } else {
                    holder = template.placeholder(binding)
                    ast.obj(holder).*.nextOverload = 0
                }
                const n = ast.variableNode(holder, nameToken)
                ast.node(n).*.lhs = addressOf(object, nameToken)
                return n
            }
            c = info(at(c).*.baseClass)
        }
        return 0
    }
    if ast.obj(o).*.isFunction {
        if ast.obj(o).*.isStaticMember { return methodNode(o, 0, nameToken) }
        if cursor.is(names.P_LT) { return methodNode(o, addressOf(object, nameToken), nameToken) }
        return memberCallee(ast.typeOf(object), o, addressOf(object, nameToken), nameToken)
    }
    ast.obj(o).*.isReferenced = true
    return expr.variableValue(o, nameToken)
}

// ---------------------------------------------------------------------------
// Pointers to members

// The name marking a callee made by `obj.*pmf` (its object's address
// in `rhs`, passed first by the call).
var boundName: u32 = 0
pub fn boundMemberName() -> u32 {
    if boundName == 0 { boundName = base.intern("__mlxcc_bound_member") }
    return boundName
}

// The function type without its `this`.
fn withoutThis(fnType: usize) -> usize {
    const t = types.functionReturning(types.baseOf(fnType))
    types.at(t).*.variadic = types.at(fnType).*.variadic
    types.at(t).*.constMethod = types.at(fnType).*.constMethod
    var p = types.at(fnType).*.params
    if p != 0 && types.param(p).*.name == names.K_THIS { p = types.param(p).*.next }
    types.at(t).*.params = p
    return t
}

// `&C::m` after the `&`: a pointer to the member (a data member's
// offset plus one, a member function's address; a virtual one is
// called as the class's own), 0 with the cursor unmoved when the name is
// no non-static member of a class.
pub fn memberPointerConstant() -> usize {
    if !decl.startsQualified() { return 0 }
    const start = cursor.save()
    const read = decl.qualifier()
    if !cursor.isIdent() || cursor.isToken(cursor.peekNext(), names.P_LPAREN) || cursor.isToken(cursor.peekNext(), names.P_SCOPE) {
        cursor.restore(start)
        return 0
    }
    const classTy = classWithPrefix(read.0)
    if classTy == 0 {
        cursor.restore(start)
        return 0
    }
    const completed = completeIfNeeded(classTy)
    const nameToken = cursor.peek()
    const name = tokens.name(nameToken)
    const m = expr.findMember(classTy, name)
    if m != 0 && types.member(m).*.name == name {
        cursor.advance()
        const n = ast.number(types.member(m).*.offset + 1, nameToken)
        ast.node(n).*.ty = types.memberPointerTo(classTy, types.member(m).*.ty)
        return n
    }
    const o = memberOf(classTy, name)
    if o != 0 && ast.obj(o).*.isFunction && !ast.obj(o).*.isStaticMember {
        cursor.advance()
        ast.obj(o).*.isReferenced = true
        template.ensureDefined(o)
        const n = ast.unary(ast.ADDR, ast.variableNode(o, nameToken), nameToken)
        ast.node(n).*.ty = types.memberPointerTo(classTy, withoutThis(ast.obj(o).*.ty))
        return n
    }
    cursor.restore(start)
    return 0
}

// `object.*pm` (`object->*pm` with `arrow`): the member; for a member
// function, a callee carrying the object's address.
pub fn memberThrough(given: usize, arrow: bool, pm: usize, token: usize) -> usize {
    typing.addType(given)
    typing.addType(pm)
    const pmTy = ast.typeOf(pm)
    if !types.isMemberPointer(pmTy) { tokens.errorAt(token, "not a pointer to a member") }
    const object = if arrow { deref(given, token) } else { given }
    const target = types.baseOf(pmTy)
    const classTy = types.memberClassOf(pmTy)
    if types.kind(target) == types.FUNC {
        const n = ast.make(ast.CAST, token)
        ast.node(n).*.lhs = pm
        ast.node(n).*.ty = types.pointerTo(withThis(classTy, target))
        ast.node(n).*.rhs = addressOf(object, token)
        ast.node(n).*.name = boundMemberName()
        return n
    }
    // *(T *)((char *)&object + pm - 1)
    const bytes = typing.cast(addressOf(object, token), types.pointerTo(types.charOf()))
    const offset = typed(ast.binary(ast.SUB, typing.cast(pm, types.longOf()), number(1, types.longOf(), token), token))
    return deref(typing.cast(expr.newAdd(bytes, offset, token), types.pointerTo(target)), token)
}

// `p->~T()` or `obj.~T()`, at the `~`: the destructor of the object at
// `address`, called.
pub fn explicitDestructor(address: usize, token: usize) -> usize {
    cursor.expect(names.P_TILDE)
    const name = cursor.expectIdent()
    cursor.expect(names.P_LPAREN)
    cursor.expect(names.P_RPAREN)
    typing.addType(address)
    const ty = types.baseOf(ast.typeOf(address))
    const c = info(ty)
    // The class's own name, or a typedef of the type (`p->~T()` in a
    // template; of a scalar it does nothing).
    var fits = c != 0 && at(c).*.written == tokens.name(name)
    if !fits {
        const named = scope.typedefOf(tokens.name(name))
        if named != 0 && (types.compatible(named, ty) || (info(named) != 0 && info(named) == c)) { fits = true }
    }
    if !fits { tokens.errorAt(name, "not the destructor of this class") }
    const call = if c != 0 { destroy(address, ty, false, token) } else { nothing(token) }
    if isNothing(call) { return typing.cast(number(0, types.intOf(), token), types.voidOf()) }
    return call
}

// The functions and the function template bound under one name in one
// scope (the binding's and the ones it hides there: a function and a
// template of the same name are overloads of each other): the chain's
// first function, and the template's record; either 0.
fn boundFunctions(binding: usize) -> (usize, usize) {
    var functions: usize = 0
    var record: usize = 0
    var b = binding
    while b != 0 && scope.at(b).*.depth == scope.at(binding).*.depth && scope.at(b).*.name == scope.at(binding).*.name {
        const kind = scope.at(b).*.kind
        // Every chain of functions of the name (a friend declared in an
        // instance starts one of its own): joined.
        if kind == scope.VARIABLE && ast.obj(scope.at(b).*.obj).*.isFunction {
            if functions == 0 { functions = scope.at(b).*.obj } else if scope.at(b).*.obj != functions { functions = appendOverloads(functions, scope.at(b).*.obj) }
        }
        if kind == scope.TEMPLATE && record == 0 && template.isFunctionTemplate(b) { record = scope.at(b).*.obj }
        b = scope.at(b).*.hidden
    }
    return -> (functions, record)
}

// Appends the chain `candidates` to the overloads of `first` (those
// not among them yet); the chain's first.
fn appendOverloads(first: usize, candidates: usize) -> usize {
    if first == 0 { return candidates }
    var candidate = candidates
    while candidate != 0 {
        var known = first
        var last: usize = 0
        var present = false
        while known != 0 {
            if known == candidate { present = true }
            last = known
            known = ast.obj(known).*.nextOverload
        }
        const next = ast.obj(candidate).*.nextOverload
        if !present {
            ast.obj(candidate).*.nextOverload = 0
            ast.obj(last).*.nextOverload = candidate
        }
        candidate = next
    }
    return first
}

// What a call by the unqualified `name`, found as `binding`, may call:
// the functions of that name in the binding's scope and those the
// using-directives in force bring in (`using namespace std` next to
// C's getline: std::getline is a candidate too), and a function
// template of that name, whose instances the arguments choose. The
// callee node: the template's placeholder with the functions as its
// overloads, else the first function.
pub fn callableFor(binding: usize, nameToken: usize) -> usize {
    const name = tokens.name(nameToken)
    const found = boundFunctions(binding)
    var functions = found.0
    var record = found.1
    if scope.at(binding).*.depth == 0 {
        var d = scope.currentDepth() + 1
        while d > 0 {
            d -= 1
            var c = scope.usingsAt(d)
            while c != 0 {
                const other = scope.findQualified(@intCast(u32, base.getWord(c)), name, false)
                if other != 0 {
                    const more = boundFunctions(other)
                    functions = appendOverloads(functions, more.0)
                    if record == 0 { record = more.1 }
                }
                c = base.getWord(c + 8)
            }
        }
    }
    if record != 0 {
        const o = template.placeholderFor(record)
        ast.obj(o).*.nextOverload = functions
        return ast.variableNode(o, nameToken)
    }
    if functions == 0 { return 0 }
    ast.obj(functions).*.isReferenced = true
    return expr.variableValue(functions, nameToken)
}

// The conversion operator of the class (or a base) to `target`: the
// one to that type, else one to an arithmetic type or a pointer when
// `target` is one; 0 for none.
pub fn conversionTo(classTy: usize, target: usize) -> usize {
    var c = info(classTy)
    var fallback: usize = 0
    while c != 0 {
        var cell = at(c).*.conversions
        while cell != 0 {
            const to = types.referenced(base.getWord(cell + 8))
            if types.compatible(to, types.referenced(target)) { return base.getWord(cell) }
            // Nothing converts to an enum but to that enum.
            if fallback == 0 && types.kind(target) != types.ENUM && ((types.isScalar(to) && types.isScalar(target)) || (types.kind(to) == types.BOOL && types.isNumeric(target))) { fallback = base.getWord(cell) }
            cell = base.getWord(cell + 16)
        }
        c = info(at(c).*.baseClass)
    }
    return fallback
}

// `value` of a class converted to the non-class `target` through its
// conversion operator; 0 when it has none that fits.
pub fn convertFrom(value: usize, target: usize) -> usize {
    typing.addType(value)
    const ty = ast.typeOf(value)
    if !isClassType(ty) || isClassType(types.referenced(target)) { return 0 }
    const o = conversionTo(ty, target)
    if o == 0 { return 0 }
    return expr.buildCall(methodNode(o, addressOf(value, ast.tokenOf(value)), ast.tokenOf(value)), 0, 0, ast.tokenOf(value))
}

// `value` of a class converted to another class `target` (not one of
// its bases) through its conversion operator (`operator const P &()`);
// 0 when it has none.
pub fn classConversion(value: usize, target: usize) -> usize {
    typing.addType(value)
    const ty = ast.typeOf(value)
    const wanted = types.referenced(target)
    if !isClassType(ty) || !isClassType(wanted) || sameClass(ty, wanted) || isBaseOf(wanted, ty) { return 0 }
    const o = conversionTo(ty, wanted)
    if o == 0 { return 0 }
    const token = ast.tokenOf(value)
    return expr.buildCall(methodNode(o, addressOf(value, token), token), 0, 0, token)
}

// A condition: a class value is converted to bool (operator bool, or
// another conversion operator).
pub fn toCondition(e: usize) -> usize {
    typing.addType(e)
    if !isClassType(ast.typeOf(e)) { return e }
    const converted = convertFrom(e, types.boolOf())
    if converted == 0 { tokens.errorAt(ast.tokenOf(e), "the class has no conversion to bool") }
    return converted
}

// `obj->name` where obj is a class: `obj.operator->()->name`.
pub fn arrowOperator(object: usize, token: usize) -> usize {
    const call = unaryOperator("->", object, false, token)
    if call == 0 { tokens.errorAt(token, "no operator-> for this class") }
    return call
}

// The callee of a virtual call: the function in the object's vtable at
// the method's slot. `args` holds `this` first; it is evaluated once,
// into a temporary the callee reads.
pub fn virtualCallee(method: usize, args: usize, token: usize) -> usize {
    const self = base.getWord(args)
    typing.addType(self)
    const tmp = newTemp(ast.typeOf(self), token)
    const kept = ast.binary(ast.COMMA, typed(ast.binary(ast.ASSIGN, variable(tmp, token), self, token)), variable(tmp, token), token)
    ast.node(kept).*.ty = ast.typeOf(self)
    base.putWord(args, kept)
    const fnPointer = types.pointerTo(ast.obj(method).*.ty)
    const table = deref(typing.cast(variable(tmp, token), types.pointerTo(types.pointerTo(fnPointer))), token)
    const slot = typed(expr.newAdd(table, number(ast.obj(method).*.slot, types.longOf(), token), token))
    return deref(slot, token)
}

// ---------------------------------------------------------------------------
// Operators

fn operatorFunction(op: []const u8) -> u32 {
    return base.intern(base.join("operator", op))
}

// The best of the functions in the chains `first` and `second` (either
// may be 0) for the arguments; 0 when none fits.
fn bestOf(first: usize, second: usize, args: usize, count: usize) -> usize {
    return bestOfThree(first, second, 0, args, count)
}

fn bestOfThree(first: usize, second: usize, third: usize, args: usize, count: usize) -> usize {
    var best: usize = 0
    var bestScore: i64 = -1
    var chain = first
    var pass: u32 = 0
    while pass < 3 {
        var candidate = chain
        while candidate != 0 {
            const score = expr.overloadScore(candidate, args, count)
            if score > bestScore {
                best = candidate
                bestScore = score
            }
            candidate = ast.obj(candidate).*.nextOverload
        }
        chain = if pass == 0 { second } else { third }
        pass += 1
    }
    return best
}

// The free functions named `name` seen from here and from the
// namespaces of the class arguments (argument-dependent lookup), and
// the instance a function template of that name makes for the
// arguments (0 for none): three chains for bestOfThree.
var templateInstance: usize = 0

fn freeFunctions(name: u32, lhs: usize, rhs: usize) -> (usize, usize) {
    var first: usize = 0
    var record: usize = 0
    templateInstance = 0
    const binding = scope.find(name)
    if binding != 0 {
        const found = boundFunctions(binding)
        first = found.0
        record = found.1
    }
    var second: usize = 0
    var otherRecord: usize = 0
    var side: u32 = 0
    // Both operands' namespaces (`v | views::reverse`: std's and
    // std::views').
    while side < 2 {
        const operand = if side == 0 { lhs } else { rhs }
        side += 1
        if operand == 0 { continue }
        const c = info(ast.typeOf(operand))
        if c == 0 { continue }
        // The class's namespace (past enclosing classes: thread::id's
        // operators are std's).
        var ns = scope.parentOf(at(c).*.prefix)
        var found = scope.findQualified(ns, name, false)
        while found == 0 && ns != 0 {
            ns = scope.parentOf(ns)
            found = scope.findQualified(ns, name, false)
        }
        if found != 0 {
            const more = boundFunctions(found)
            if more.0 != first && more.0 != 0 { second = if second == 0 { more.0 } else { appendOverloads(second, more.0) } }
            if more.1 != 0 && more.1 != record {
                if record == 0 { record = more.1 } else if otherRecord == 0 { otherRecord = more.1 }
            }
        }
    }
    const args = if rhs != 0 { argumentList(lhs, rhs) } else { argumentList(lhs, 0) }
    const argCount: usize = if rhs != 0 { 2 } else { 1 }
    if record != 0 { templateInstance = template.callInstance(record, args, argCount, 0) }
    if otherRecord != 0 {
        // The other namespace's templates: the better instance.
        const other = template.callInstance(otherRecord, args, argCount, 0)
        if other != 0 && (templateInstance == 0 || expr.argumentScore(other, args, argCount) > expr.argumentScore(templateInstance, args, argCount)) { templateInstance = other }
    }
    return -> (first, second)
}

// `lhs op rhs` with a class operand: the call of the operator function
// (a member of lhs's class, or a free one), 0 when there is none.
pub fn binaryOperator(op: []const u8, lhs: usize, rhs: usize, token: usize) -> usize {
    typing.addType(lhs)
    typing.addType(rhs)
    const lt = ast.typeOf(lhs)
    const rt = ast.typeOf(rhs)
    if !isClassType(lt) && !isClassType(rt) { return 0 }
    const name = operatorFunction(op)
    // `a << b`, `a >> b`, `a = b`, `a op= b` evaluate a before b (C++17):
    // an object a is taken by its address first (arguments are
    // evaluated last to first).
    var sequenced = base.same(op, "<<") || base.same(op, ">>") || base.same(op, "=")
    if op.length >= 2 && op[op.length - 1] == 61 && !base.same(op, "==") && !base.same(op, "!=") && !base.same(op, "<=") && !base.same(op, ">=") { sequenced = true }
    var left = lhs
    var before: usize = 0
    if sequenced && typing.isLvalue(lhs) {
        const holder = newTemp(types.pointerTo(lt), token)
        before = typed(ast.binary(ast.ASSIGN, variable(holder, token), addressOf(lhs, token), token))
        left = deref(variable(holder, token), token)
    }
    var call: usize = 0
    if isClassType(lt) {
        const m = findMethod(lt, name)
        var chosen: usize = 0
        var chosenScore: i64 = -1
        if m != 0 {
            const full = argumentList(addressOf(left, token), rhs)
            chosen = bestOf(m, 0, full, 2)
            if chosen != 0 { chosenScore = expr.argumentScore(chosen, argumentList(rhs, 0), 1) }
        }
        // A member template of the operator (`template <class U>
        // variant &operator=(U &&)`), when it fits better.
        const record = memberTemplateOf(lt, name)
        if record != 0 {
            const instance = template.callInstance(record, argumentList(rhs, 0), 1, 0)
            if instance != 0 && expr.argumentScore(instance, argumentList(rhs, 0), 1) > chosenScore {
                call = expr.buildCall(methodNode(instance, addressOf(left, token), token), argumentList(rhs, 0), 1, token)
            }
        }
        if call == 0 && chosen != 0 {
            const address = addressOf(left, token)
            call = expr.buildCall(methodNode(m, address, token), argumentList(rhs, 0), 1, token)
        }
    }
    if call == 0 {
        const free = freeFunctions(name, lhs, rhs)
        const full = argumentList(left, rhs)
        const chosen = bestOfThree(free.0, free.1, templateInstance, full, 2)
        if chosen != 0 { call = expr.buildCall(methodNode(chosen, 0, token), full, 2, token) }
    }
    if call == 0 || before == 0 { return call }
    typing.addType(call)
    const n = ast.binary(ast.COMMA, before, call, token)
    ast.node(n).*.ty = ast.typeOf(call)
    return n
}

// `op operand` or `operand op` (postfix: the int argument 0) with a
// class operand; 0 when there is no operator function.
pub fn unaryOperator(op: []const u8, operand: usize, isPostfix: bool, token: usize) -> usize {
    typing.addType(operand)
    const ty = ast.typeOf(operand)
    if !isClassType(ty) { return 0 }
    const name = operatorFunction(op)
    const zero = number(0, types.intOf(), token)
    const m = findMethod(ty, name)
    if m != 0 {
        const address = addressOf(operand, token)
        const full = if isPostfix { argumentList(address, zero) } else { argumentList(address, 0) }
        const count: usize = if isPostfix { 2 } else { 1 }
        if bestOf(m, 0, full, count) != 0 {
            return expr.buildCall(methodNode(m, address, token), argumentList(zero, 0), count - 1, token)
        }
    }
    const free = freeFunctions(name, operand, 0)
    const full = if isPostfix { argumentList(operand, zero) } else { argumentList(operand, 0) }
    const count: usize = if isPostfix { 2 } else { 1 }
    const chosen = bestOfThree(free.0, free.1, templateInstance, full, count)
    if chosen != 0 { return expr.buildCall(methodNode(chosen, 0, token), full, count, token) }
    return 0
}

// `object(args)`: operator().
pub fn callOperator(object: usize, args: usize, count: usize, token: usize) -> usize {
    typing.addType(object)
    const ty = ast.typeOf(object)
    const name = operatorFunction("()")
    const m = findMethod(ty, name)
    // A member template `operator()` too (a generic callable).
    if m == 0 && memberTemplateOf(ty, name) == 0 { tokens.errorAt(token, "the object is not callable") }
    return expr.buildCall(memberCalleeNamed(ty, name, m, addressOf(object, token), token), args, count, token)
}

// `object[index]`: operator[]; 0 when the class has none.
pub fn indexOperator(object: usize, index: usize, token: usize) -> usize {
    typing.addType(object)
    const m = findMethod(ast.typeOf(object), operatorFunction("[]"))
    if m == 0 { return 0 }
    return expr.buildCall(methodNode(m, addressOf(object, token), token), argumentList(index, 0), 1, token)
}

// `lhs = rhs` with a class lhs: operator=, else the members one by one
// when one has an operator= or constructors, else 0 (the bytes).
pub fn assignOperator(lhs: usize, rhs: usize, token: usize) -> usize {
    typing.addType(lhs)
    typing.addType(rhs)
    const ty = ast.typeOf(lhs)
    if !isClassType(ty) { return 0 }
    const m = findMethod(ty, operatorFunction("="))
    var chosen: usize = 0
    var chosenScore: i64 = -1
    if m != 0 {
        chosen = bestOf(m, 0, argumentList(addressOf(lhs, token), rhs), 2)
        if chosen != 0 { chosenScore = expr.argumentScore(chosen, argumentList(rhs, 0), 1) }
    }
    // `template <class U> T &operator=(U &&)`, when it fits better.
    const record = memberTemplateOf(ty, operatorFunction("="))
    if record != 0 && !(chosen != 0 && sameClass(ast.typeOf(rhs), ty)) {
        const instance = template.callInstance(record, argumentList(rhs, 0), 1, 0)
        if instance != 0 && expr.argumentScore(instance, argumentList(rhs, 0), 1) > chosenScore {
            return expr.buildCall(methodNode(instance, addressOf(lhs, token), token), argumentList(rhs, 0), 1, token)
        }
    }
    if chosen != 0 {
        const address = addressOf(lhs, token)
        return expr.buildCall(methodNode(m, address, token), argumentList(rhs, 0), 1, token)
    }
    if !sameClass(ast.typeOf(rhs), ty) && !isBaseOf(ty, ast.typeOf(rhs)) {
        // A value of another type: a temporary of the class made from
        // it by a constructor (a template's too: span<T> to span<const
        // T>), then assigned.
        const converted = convertedObject(rhs, types.unqualified(ty), token)
        if converted != 0 { return assignOperator(lhs, converted, token) }
    }
    if !needsSpecialCopy(ty) && record == 0 { return 0 }
    if !needsSpecialCopy(ty) { tokens.errorAt(token, "no operator= for these operands") }
    if !sameClass(ast.typeOf(rhs), ty) {
        if !convertible(ast.typeOf(rhs), ty) { tokens.errorAt(token, "no operator= for these operands") }
        return assignOperator(lhs, convertValue(rhs, ty), token)
    }
    // Member by member, the source by its address.
    const ptr = newTemp(types.pointerTo(ty), token)
    const target = newTemp(types.pointerTo(ty), token)
    var n = sequence(typed(ast.binary(ast.ASSIGN, variable(ptr, token), addressOf(rhs, token), token)), typed(ast.binary(ast.ASSIGN, variable(target, token), addressOf(lhs, token), token)), token)
    var member = types.at(ty).*.members
    while member != 0 {
        const to = ast.unary(ast.MEMBER, deref(variable(target, token), token), token)
        ast.node(to).*.member = member
        const from = ast.unary(ast.MEMBER, deref(variable(ptr, token), token), token)
        ast.node(from).*.member = member
        typing.addType(to)
        typing.addType(from)
        var e = assignOperator(to, from, token)
        if e == 0 { e = typed(ast.binary(ast.ASSIGN, to, from, token)) }
        n = sequence(n, e, token)
        member = types.member(member).*.next
    }
    const result = deref(variable(target, token), token)
    const whole = ast.binary(ast.COMMA, n, result, token)
    ast.node(whole).*.ty = ty
    return whole
}

// `lhs op= rhs` with a class operand: operator op=; 0 for none.
pub fn compoundAssign(op: []const u8, lhs: usize, rhs: usize, token: usize) -> usize {
    return binaryOperator(op, lhs, rhs, token)
}

// `operator` and the operator after it, as an identifier token named
// `operator+` and the like.
pub fn operatorNameToken() -> usize {
    const start = cursor.peek()
    cursor.advance()
    var text: []const u8 = ""
    if cursor.consume(names.P_LPAREN) {
        cursor.expect(names.P_RPAREN)
        text = "()"
    } else if cursor.consume(names.P_LBRACKET) {
        cursor.expect(names.P_RBRACKET)
        text = "[]"
    } else if cursor.consume(names.K_NEW) {
        text = "new"
        if cursor.consume(names.P_LBRACKET) {
            cursor.expect(names.P_RBRACKET)
            text = "new[]"
        }
    } else if cursor.consume(names.K_DELETE) {
        text = "delete"
        if cursor.consume(names.P_LBRACKET) {
            cursor.expect(names.P_RBRACKET)
            text = "delete[]"
        }
    } else if tokens.kind(cursor.peek()) == tokens.PUNCT {
        text = tokens.text(cursor.peek())
        cursor.advance()
    } else {
        // A conversion operator, named by its target type's code.
        var ty = decl.pointersOnly(decl.declspec(0))
        // `operator const T &()`: a reference to T.
        if cursor.consume(names.P_AMP) {
            ty = types.referenceTo(ty)
        } else if cursor.consume(names.P_ANDAND) {
            ty = types.rvalueReferenceTo(ty)
        }
        conversionType = ty
        text = base.join("@", mangle.typeCode(ty))
    }
    const t = tokens.copy(start)
    tokens.at(t).*.kind = tokens.IDENT
    tokens.at(t).*.name = base.intern(base.join("operator", text))
    return t
}

// ---------------------------------------------------------------------------
// new and delete

// An allocation function the program may not have declared: declared
// here by its mangled name, with C++ linkage.
fn runtimeFunction(text: []const u8, symbol: []const u8, parameter: usize, result: usize) -> usize {
    const fnType = types.functionReturning(result)
    types.at(fnType).*.params = types.newParam(parameter, 0, 0)
    const o = ast.newObj(base.intern(text), fnType, 0)
    const obj = ast.obj(o)
    obj.*.isFunction = true
    obj.*.linkName = base.intern(symbol)
    obj.*.symbol = obj.*.linkName
    obj.*.isReferenced = true
    state.addGlobal(o)
    return o
}

fn allocator(isArray: bool) -> usize {
    const voidPointer = types.pointerTo(types.voidOf())
    if isArray {
        if newArrayFunction == 0 { newArrayFunction = runtimeFunction("operator new[]", "_Znam", types.ulongOf(), voidPointer) }
        return newArrayFunction
    }
    if newFunction == 0 { newFunction = runtimeFunction("operator new", "_Znwm", types.ulongOf(), voidPointer) }
    return newFunction
}

fn deallocator(isArray: bool) -> usize {
    const voidPointer = types.pointerTo(types.voidOf())
    if isArray {
        if deleteArrayFunction == 0 { deleteArrayFunction = runtimeFunction("operator delete[]", "_ZdaPv", voidPointer, types.voidOf()) }
        return deleteArrayFunction
    }
    if deleteFunction == 0 { deleteFunction = runtimeFunction("operator delete", "_ZdlPv", voidPointer, types.voidOf()) }
    return deleteFunction
}

fn callRuntime(fnObj: usize, argument: usize, token: usize) -> usize {
    return expr.buildCall(methodNode(fnObj, 0, token), argumentList(argument, 0), 1, token)
}

// `new T`, `new T(args)`, `new T{args}`, `new T[n]`, `new (where) T(args)`,
// after `new`.
pub fn newExpression(token: usize) -> usize {
    var placement: usize = 0
    var placementArgs: usize = 0
    var placementCount: usize = 0
    if cursor.is(names.P_LPAREN) && !decl.isTypename(cursor.peekNext()) {
        cursor.advance()
        const read = readArguments(names.P_RPAREN)
        if read.1 == 1 {
            placement = base.getWord(read.0)
        } else {
            // `new (NotNull, where) T`: the operator new taking them.
            placementArgs = read.0
            placementCount = read.1
        }
    }
    var ty: usize = 0
    if cursor.consume(names.P_LPAREN) {
        ty = decl.typeName()
        cursor.expect(names.P_RPAREN)
    } else {
        ty = decl.pointersOnly(decl.declspec(0))
    }
    const ignored = completeIfNeeded(ty)
    var count: usize = 0
    if cursor.consume(names.P_LBRACKET) {
        count = expr.expression()
        cursor.expect(names.P_RBRACKET)
        while cursor.consume(names.P_LBRACKET) {
            // `new T[n][m]`: elements of array type.
            const length = expr.expression()
            typing.addType(length)
            if ast.kindOf(length) != ast.NUM { tokens.errorAt(token, "the inner dimensions must be constant") }
            ty = types.arrayOf(ty, ast.node(length).*.value)
            cursor.expect(names.P_RBRACKET)
        }
    }
    var argList: usize = 0
    var argCount: usize = 0
    if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACE) {
        const closer: u32 = if cursor.is(names.P_LPAREN) { names.P_RPAREN } else { names.P_RBRACE }
        cursor.advance()
        const read = readArguments(closer)
        argList = read.0
        argCount = read.1
    }
    const ptrType = types.pointerTo(ty)
    const result = newTemp(ptrType, token)
    if placementCount > 1 {
        // The class's own operator new, else the global one (C++ does
        // not look in enclosing classes).
        const newName = base.intern("operatornew")
        var binding: usize = 0
        const c = info(ty)
        if c != 0 { binding = scope.findQualified(at(c).*.prefix, newName, false) }
        if binding == 0 { binding = scope.findQualified(0, newName, false) }
        if binding == 0 { tokens.errorAt(token, "no operator new takes these placement arguments") }
        const given = base.alloc((placementCount + 1) * 8)
        base.putWord(given, number(types.size(ty), types.ulongOf(), token))
        var i: usize = 0
        while i < placementCount {
            base.putWord(given + (i + 1) * 8, base.getWord(placementArgs + i * 8))
            i += 1
        }
        const nameToken = tokens.copy(token)
        tokens.at(nameToken).*.kind = tokens.IDENT
        tokens.at(nameToken).*.name = scope.at(binding).*.name
        placement = expr.buildCall(callableFor(binding, nameToken), given, placementCount + 1, token)
    }
    if placement != 0 {
        const placed = typed(ast.binary(ast.ASSIGN, variable(result, token), typing.cast(placement, ptrType), token))
        const made = construct(variable(result, token), ty, argList, argCount, token)
        const n = ast.binary(ast.COMMA, sequence(placed, made, token), variable(result, token), token)
        ast.node(n).*.ty = ptrType
        return n
    }
    if count == 0 {
        const size = number(types.size(ty), types.ulongOf(), token)
        const allocated = typed(ast.binary(ast.ASSIGN, variable(result, token), typing.cast(callRuntime(allocator(false), size, token), ptrType), token))
        const made = construct(variable(result, token), ty, argList, argCount, token)
        const n = ast.binary(ast.COMMA, sequence(allocated, made, token), variable(result, token), token)
        ast.node(n).*.ty = ptrType
        return n
    }
    // An array: its element count before it when the elements have
    // destructors (delete[] reads it).
    if argCount != 0 { tokens.errorAt(token, "an array cannot be constructed from arguments") }
    const block = ast.make(ast.BLOCK, token)
    const n = newTemp(types.longOf(), token)
    appendStatement(block, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(n, token), count, token)), token))
    const elementSize = number(types.size(ty), types.longOf(), token)
    var bytes = typed(ast.binary(ast.MUL, variable(n, token), elementSize, token))
    const cookie = hasDestructor(ty)
    if cookie { bytes = typed(ast.binary(ast.ADD, bytes, number(8, types.longOf(), token), token)) }
    const charPointer = types.pointerTo(types.charOf())
    const raw = newTemp(charPointer, token)
    appendStatement(block, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(raw, token), typing.cast(callRuntime(allocator(true), typing.cast(bytes, types.ulongOf()), token), charPointer), token)), token))
    if cookie {
        const header = deref(typing.cast(variable(raw, token), types.pointerTo(types.longOf())), token)
        appendStatement(block, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, header, variable(n, token), token)), token))
        appendStatement(block, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(result, token), typing.cast(expr.newAdd(variable(raw, token), number(8, types.longOf(), token), token), ptrType), token)), token))
    } else {
        appendStatement(block, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(result, token), typing.cast(variable(raw, token), ptrType), token)), token))
    }
    if needsConstruction(ty) {
        const loop = countedLoop(variable(n, token), token)
        ast.node(loop.0).*.then = ast.unary(ast.EXPR_STMT, construct(typed(expr.newAdd(variable(result, token), variable(loop.1, token), token)), ty, 0, 0, token), token)
        appendStatement(block, loop.0)
    }
    appendStatement(block, ast.unary(ast.EXPR_STMT, variable(result, token), token))
    const e = ast.make(ast.STMT_EXPR, token)
    ast.node(e).*.body = ast.node(block).*.body
    ast.node(e).*.ty = ptrType
    return e
}

// `delete p`, `delete[] p`, after `delete`.
pub fn deleteExpression(token: usize) -> usize {
    var isArray = false
    if cursor.consume(names.P_LBRACKET) {
        cursor.expect(names.P_RBRACKET)
        isArray = true
    }
    const p = expr.castExpression()
    typing.addType(p)
    const pt = ast.typeOf(p)
    if types.kind(pt) != types.PTR { tokens.errorAt(token, "delete of a non-pointer") }
    const ty = types.baseOf(pt)
    const voidPointer = types.pointerTo(types.voidOf())
    const tmp = newTemp(pt, token)
    const block = ast.make(ast.BLOCK, token)
    appendStatement(block, ast.unary(ast.EXPR_STMT, typed(ast.binary(ast.ASSIGN, variable(tmp, token), p, token)), token))
    const guard = ast.make(ast.IF, token)
    ast.node(guard).*.cond = variable(tmp, token)
    const then = ast.make(ast.BLOCK, token)
    if !isArray {
        if hasDestructor(ty) { appendStatement(then, ast.unary(ast.EXPR_STMT, destroy(variable(tmp, token), ty, false, token), token)) }
        appendStatement(then, ast.unary(ast.EXPR_STMT, callRuntime(deallocator(false), typing.cast(variable(tmp, token), voidPointer), token), token))
    } else if hasDestructor(ty) {
        const charPointer = types.pointerTo(types.charOf())
        const start = typed(expr.newSub(typing.cast(variable(tmp, token), charPointer), number(8, types.longOf(), token), token))
        const count = deref(typing.cast(start, types.pointerTo(types.longOf())), token)
        const loop = countedLoopDown(count, token)
        ast.node(loop.0).*.then = ast.unary(ast.EXPR_STMT, destroy(typed(expr.newAdd(variable(tmp, token), lastIndex(loop.1, token), token)), ty, true, token), token)
        appendStatement(then, loop.0)
        const again = typed(expr.newSub(typing.cast(variable(tmp, token), charPointer), number(8, types.longOf(), token), token))
        appendStatement(then, ast.unary(ast.EXPR_STMT, callRuntime(deallocator(true), typing.cast(again, voidPointer), token), token))
    } else {
        appendStatement(then, ast.unary(ast.EXPR_STMT, callRuntime(deallocator(true), typing.cast(variable(tmp, token), voidPointer), token), token))
    }
    ast.node(guard).*.then = then
    appendStatement(block, guard)
    const e = ast.make(ast.STMT_EXPR, token)
    ast.node(e).*.body = ast.node(block).*.body
    ast.node(e).*.ty = types.voidOf()
    return e
}
