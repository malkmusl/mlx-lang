// What the parser keeps while it reads a translation unit: the file, its
// globals (functions, variables, string literals, in order), the function
// being defined with its locals, the goto labels, the jump targets of the
// loop or switch around, and the counters that make labels and the
// symbols of statics unique in the program.
const base = @import("./base.mlx")
const ast = @import("./ast.mlx")

var fileId: u32 = 0
var globalsHead: usize = 0
var globalsTail: usize = 0
var function: usize = 0
var localsHead: usize = 0
// Cells of two words (node, next): the function's gotos and labels.
var gotoCells: usize = 0
var labelCells: usize = 0
var breakLabel: u32 = 0
var continueLabel: u32 = 0
var currentSwitch: usize = 0
var labelCounter: u32 = 0
var staticCounter: u32 = 0

pub fn startFile(file: u32) -> void {
    fileId = file
    globalsHead = 0
    globalsTail = 0
}

pub fn file() -> u32 { return fileId }
pub fn globals() -> usize { return globalsHead }

// Adds a global object to the file's list.
pub fn addGlobal(obj: usize) -> void {
    ast.obj(obj).*.file = fileId
    if globalsHead == 0 { globalsHead = obj } else { ast.obj(globalsTail).*.next = obj }
    globalsTail = obj
}

pub fn startFunction(fn_obj: usize) -> void {
    function = fn_obj
    localsHead = 0
    gotoCells = 0
    labelCells = 0
    breakLabel = 0
    continueLabel = 0
    currentSwitch = 0
}

pub fn currentFunction() -> usize { return function }
pub fn locals() -> usize { return localsHead }

pub fn addLocal(obj: usize) -> void {
    ast.obj(obj).*.next = localsHead
    localsHead = obj
}

fn cell(node: usize, next: usize) -> usize {
    const c = base.alloc(16)
    base.putWord(c, node)
    base.putWord(c + 8, next)
    return c
}

pub fn addGoto(node: usize) -> void { gotoCells = cell(node, gotoCells) }
pub fn addLabel(node: usize) -> void { labelCells = cell(node, labelCells) }
pub fn gotos() -> usize { return gotoCells }
pub fn labels() -> usize { return labelCells }

pub fn cellNode(c: usize) -> usize { return base.getWord(c) }
pub fn cellNext(c: usize) -> usize { return base.getWord(c + 8) }

pub fn breakTarget() -> u32 { return breakLabel }
pub fn continueTarget() -> u32 { return continueLabel }
pub fn setBreakTarget(label: u32) -> void { breakLabel = label }
pub fn setContinueTarget(label: u32) -> void { continueLabel = label }

pub fn switchNode() -> usize { return currentSwitch }
pub fn setSwitchNode(node: usize) -> void { currentSwitch = node }

// A label number unique in the program (code generation names it .L<n>).
pub fn newLabel() -> u32 {
    labelCounter += 1
    return labelCounter
}

// A number for the symbol of a static (a static local, a literal, a
// static function's or variable's symbol made unique among files).
pub fn newStatic() -> u32 {
    staticCounter += 1
    return staticCounter
}
