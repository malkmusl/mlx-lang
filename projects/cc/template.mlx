// C++ templates: a class or function template is kept as its tokens,
// and an instance (`vector<int>`, `max<double>`, `max(1, 2)` by
// deduction) is read from them again with the template's parameters
// bound as typedefs (and non-type ones as constants) under the
// instance's own prefix (`std::vector<i>`), whose name is the template's
// with the arguments' codes. The instance class is bound in the
// template's namespace as a class of that name; its member functions
// are weak, as inline functions are. A function template's signature is
// read once, with placeholders for its parameters, so a call can deduce
// them from its arguments.
//
// An instance made in the middle of a function (`vector<int> v;` in
// main) belongs to the file: the function's state and the block scopes
// are put aside while it is read (state.save, scope.suspend).
//
// An explicit specialization (`template <> struct X<int> {...}`,
// `template <> int f(int)`) is read as the instance it names, bound
// under its key before any use. Not here: partial specializations,
// member templates, variadic templates, template
// template parameters, dependent qualified names in function template
// signatures (`typename T::iterator` as a parameter type).
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")
const decl = @import("./decl.mlx")
const eval = @import("./eval.mlx")
const cpp = @import("./cpp.mlx")
const mangle = @import("./mangle.mlx")

pub const Template = struct {
    name: u32
    isClass: bool
    // `template <...> using X = type;`: an alias, `start` at the type.
    isAlias: bool
    // A class template's partial specializations (`struct X<T *>`):
    // cells of (their record, the pattern arguments, the class keyword
    // token or 0 when declared only, next, the tag token).
    partials: usize
    // The parameters: cells of six words (name, isType, the type of a
    // non-type one, next, the default argument's first token or 0, 1
    // for a parameter pack), and their number.
    params: usize
    paramCount: usize
    // The namespace it is declared in, its declaration's first token
    // (after the parameter list; 0 for a forward declaration), the
    // out-of-line definitions of a class template's members (cells of
    // the `template` token and next).
    namespace: u32
    start: usize
    memberDefs: usize
    memberDefsTail: usize
    // A function template: its signature with placeholders, the prefix
    // the placeholders are bound under, the object standing for it in
    // calls.
    pattern: usize
    patternPrefix: u32
    placeholder: usize
    // The instances: cells of (key name id, type or object, next).
    instances: usize
    // Another template of the same name (overloaded function templates).
    next: usize
    // A member template: the class it belongs to (its instances are
    // member functions of it), its declaration in the class when the
    // definition comes later (then `start` is 0 until it does), and the
    // instances waiting for that definition: cells of (object, prefix,
    // arguments, next).
    owner: usize
    declaration: usize
    waiting: usize
}

fn at(t: usize) -> *Template {
    unsafe { return @ptrFromInt(*Template, t) }
}

var patternCount: u32 = 0
var defaultCount: u32 = 0
// A function template's signature is being read with placeholders: a
// class template named in it with a value argument is dependent (the
// value is a parameter's, unknown yet).
var patternDepth: u32 = 0
var unnamedCount: u32 = 0
// The function template whose signature is being read as a pattern.
var patternTemplate: usize = 0
// How many class template instances are being read (their members'
// bodies wait for a call).
var instancesOpen: u32 = 0

pub fn instantiating() -> bool { return instancesOpen > 0 }

// Reads the body of the member function `o` of a class template's
// instance now, if it is still pending.
pub fn ensureDefined(o: usize) -> void {
    const body = ast.obj(o).*.pendingBody
    if body == 0 { return }
    ast.obj(o).*.pendingBody = 0
    const context = beginInstance()
    cursor.restore(body)
    decl.defineFunction(o, ast.obj(o).*.pendingClass)
    endInstance(context)
}
// The tag the class being read gets (an instance's key name), 0 for none.
var tagOverride: u32 = 0

// The name the class declaration read next is bound under, taken once.
pub fn takeTagOverride() -> u32 {
    const name = tagOverride
    tagOverride = 0
    return name
}

pub fn isClassTemplate(binding: usize) -> bool {
    return binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE && at(scope.at(binding).*.obj).*.isClass
}

pub fn isFunctionTemplate(binding: usize) -> bool {
    return binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE && !at(scope.at(binding).*.obj).*.isClass
}

// The token after the `>` matching the `<` at `open`; 0 when there is
// none (`>>` closes two).
pub fn endOfArguments(open: usize) -> usize {
    var level: i64 = 1
    var t = tokens.next(open)
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LT) { level += 1 }
        if tokens.is(t, names.P_GT) { level -= 1 }
        if tokens.is(t, names.P_SHR) { level -= 2 }
        if tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE) { return 0 }
        t = tokens.next(t)
        if level <= 0 { return t }
    }
    return 0
}

// ---------------------------------------------------------------------------
// Declarations

// `template <...> declaration`, at `template`.
pub fn declaration() -> void {
    const header = cursor.peek()
    cursor.expect(names.K_TEMPLATE)
    if cursor.is(names.P_LT) && cursor.isToken(cursor.peekNext(), names.P_GT) {
        cursor.advance()
        cursor.advance()
        specialization()
        return
    }
    const t = base.alloc(@sizeOf(Template))
    at(t).*.namespace = scope.currentNamespace()
    parameters(t)
    at(t).*.start = cursor.save()
    if cursor.is(names.K_CLASS) || cursor.is(names.K_STRUCT) {
        classTemplate(t, header)
        return
    }
    if cursor.consume(names.K_USING) {
        // An alias template: an instance is the type it names.
        at(t).*.isClass = true
        at(t).*.isAlias = true
        at(t).*.name = tokens.name(cursor.expectIdent())
        cursor.expect(names.P_ASSIGN)
        at(t).*.start = cursor.save()
        skipDeclaration()
        const bound = scope.bindTemplate(at(t).*.name, t)
        return
    }
    if cursor.is(names.K_TEMPLATE) { cursor.fail("a template of a template is not supported") }
    // A member template of a plain class defined outside it
    // (`R Class::f(...)`): the template declared in the class gets the
    // definition's tokens.
    const member = memberTemplateDefined(at(t).*.start)
    if member != 0 {
        at(member).*.start = at(t).*.start
        at(member).*.params = at(t).*.params
        at(member).*.paramCount = at(t).*.paramCount
        skipDeclaration()
        defineWaiting(member)
        return
    }
    // A member of a class template defined outside it (`R vector<T>::f`),
    // else a function template.
    const owner = memberOf(at(t).*.start)
    if owner != 0 {
        const c = base.alloc(16)
        base.putWord(c, header)
        if at(owner).*.memberDefs == 0 { at(owner).*.memberDefs = c } else { base.putWord(at(owner).*.memberDefsTail + 8, c) }
        at(owner).*.memberDefsTail = c
        skipDeclaration()
        return
    }
    functionTemplate(t)
}

// `template <>` and the declaration of one instance: a class
// `struct X<args> { ... };` read as that instance, or a function
// `R f<args>(params) { ... }` or `R f(params) { ... }` (the arguments
// deduced from the parameters) defined as that instance.
fn specialization() -> void {
    if cursor.is(names.K_CLASS) || cursor.is(names.K_STRUCT) {
        const keyword = cursor.peek()
        cursor.advance()
        const tag = cursor.expectIdent()
        const binding = scope.findKind(tokens.name(tag), scope.TEMPLATE)
        if !isClassTemplate(binding) { tokens.errorAt(tag, "not a class template") }
        const t = scope.at(binding).*.obj
        const read = parseArguments(t)
        const key = instanceKey(t, read.0)
        const known = cached(t, key)
        if known != 0 && !types.at(known).*.incomplete { tokens.errorAt(tag, "the instance exists already") }
        // The class, read as the instance named by the key (a declared
        // one, `template <> struct X<A>;`, is completed in place).
        const context = beginInstance()
        scope.enterPrefix(at(t).*.namespace)
        const prefix = scope.qualify(at(t).*.namespace, key)
        bindParameters(at(t).*.params, read.0, prefix)
        tagOverride = key
        cursor.restore(keyword)
        // The tag's tokens: the keyword, the tag, then the arguments,
        // which the class reader must not see: the tag token is made to
        // follow the keyword and lead to the body.
        const tagCopy = tokens.copy(tag)
        tokens.at(tagCopy).*.next = endOfArguments(tokens.next(tag))
        tokens.at(keyword).*.next = tagCopy
        const attr = decl.newAttr()
        const ty = decl.declspec(attr)
        tagOverride = 0
        cursor.expect(names.P_SEMI)
        cache(t, key, ty)
        scope.leaveNamespace()
        const end = cursor.save()
        endInstance(context)
        cursor.restore(end)
        return
    }
    // A function: its signature says which template and arguments.
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    const start = cursor.save()
    // The name, past the pointers and references before it; its
    // `<args>`, if any, read now and taken out of the declarator's way.
    var nameToken = cursor.peek()
    while tokens.is(nameToken, names.P_STAR) || tokens.is(nameToken, names.P_AMP) || tokens.is(nameToken, names.K_CONST) { nameToken = tokens.next(nameToken) }
    if tokens.kind(nameToken) != tokens.IDENT { cursor.fail("expected a function specialization") }
    const name = tokens.name(nameToken)
    const binding = scope.findKind(name, scope.TEMPLATE)
    if !isFunctionTemplate(binding) { tokens.errorAt(nameToken, "not a function template") }
    var t = scope.at(binding).*.obj
    var args: usize = 0
    if tokens.is(tokens.next(nameToken), names.P_LT) {
        cursor.restore(tokens.next(nameToken))
        const read = parseArguments(t)
        args = read.0
        tokens.at(nameToken).*.next = cursor.peek()
        cursor.restore(start)
    }
    const found = decl.declarator(baseType)
    if found.1 == 0 || types.kind(found.0) != types.FUNC { cursor.fail("expected a function specialization") }
    // The arguments not given are deduced from the parameters (the
    // first template whose pattern fits).
    if args == 0 {
        while t != 0 {
            const bindings = base.alloc(at(t).*.paramCount * 8 + 8)
            var fits = true
            var p = types.at(at(t).*.pattern).*.params
            var q = types.at(found.0).*.params
            while p != 0 && q != 0 && fits {
                fits = deduce(types.param(p).*.ty, types.param(q).*.ty, bindings, false)
                p = types.param(p).*.next
                q = types.param(q).*.next
            }
            if p != 0 || q != 0 { fits = false }
            var index: usize = 0
            while fits && index < at(t).*.paramCount {
                if base.getWord(bindings + index * 8) == 0 { fits = false }
                index += 1
            }
            if fits {
                args = boundArguments(t, bindings)
                break
            }
            t = at(t).*.next
        }
        if t == 0 { tokens.errorAt(found.1, "no function template matches the specialization") }
    }
    const key = instanceKey(t, args)
    if cached(t, key) != 0 { tokens.errorAt(found.1, "the instance exists already") }
    const o = ast.newObj(name, found.0, found.1)
    const obj = ast.obj(o)
    obj.*.isFunction = true
    obj.*.isReferenced = true
    obj.*.linkName = mangle.templateFunctionSymbol(at(t).*.namespace, name, argumentCodes(args), found.0)
    obj.*.symbol = obj.*.linkName
    state.addGlobal(o)
    cache(t, key, o)
    if cursor.is(names.P_LBRACE) {
        decl.defineFunction(o, 0)
    } else {
        cursor.expect(names.P_SEMI)
    }
}

// The parameter list `<typename T, int N>`.
fn parameters(t: usize) -> void {
    cursor.expect(names.P_LT)
    var tail: usize = 0
    // The parameters before one may name its type (`typename Key, Key v`).
    scope.enter()
    var index: i64 = 0
    while !cursor.consume(names.P_GT) {
        if at(t).*.paramCount > 0 { cursor.expect(names.P_COMMA) }
        const c = base.alloc(48)
        var isType = false
        var ty: usize = 0
        if cursor.consume(names.K_TYPENAME) || cursor.consume(names.K_CLASS) {
            isType = true
        } else {
            ty = decl.declspec(0)
            if !types.isInteger(ty) && types.kind(ty) != types.TPARAM { cursor.fail("a non-type template parameter must be an integer") }
        }
        // `typename... Args`: a parameter pack.
        if cursor.consume(names.P_ELLIPSIS) { base.putWord(c + 40, 1) }
        // `template <typename> struct X;`: a parameter without a name.
        var name: u32 = 0
        if cursor.isIdent() {
            name = tokens.name(cursor.peek())
            cursor.advance()
        } else {
            unnamedCount += 1
            name = base.intern(base.join("__unnamed", base.decimal(@intCast(u64, unnamedCount))))
        }
        base.putWord(c, @intCast(usize, name))
        if isType {
            base.putWord(c + 8, 1)
            const bound = scope.bindTypedef(name, types.templateParameter(index))
        } else {
            base.putWord(c + 16, ty)
        }
        index += 1
        if cursor.consume(names.P_ASSIGN) {
            // A default argument: its tokens, read when it is needed.
            base.putWord(c + 32, cursor.save())
            var level: i64 = 0
            while true {
                if cursor.isEof() { cursor.fail("unterminated template parameter list") }
                if cursor.is(names.P_SHR) && level <= 1 { splitShr() }
                if level == 0 && (cursor.is(names.P_COMMA) || cursor.is(names.P_GT)) { break }
                if cursor.is(names.P_LT) { level += 1 }
                if cursor.is(names.P_GT) { level -= 1 }
                if cursor.is(names.P_SHR) { level -= 2 }
                cursor.advance()
            }
        }
        if at(t).*.params == 0 { at(t).*.params = c } else { base.putWord(tail + 24, c) }
        tail = c
        at(t).*.paramCount += 1
    }
    scope.leave()
}

// Passes the declaration here: to the `;` ending it, or past the body
// that does.
fn skipDeclaration() -> void {
    var level: u32 = 0
    while true {
        if cursor.isEof() { cursor.fail("unterminated template") }
        if cursor.is(names.P_LBRACE) { level += 1 }
        if cursor.is(names.P_RBRACE) {
            level -= 1
            cursor.advance()
            if level == 0 {
                const ignored = cursor.consume(names.P_SEMI)
                return
            }
            continue
        }
        if level == 0 && cursor.consume(names.P_SEMI) { return }
        cursor.advance()
    }
}

// `template<...> class X { ... };` or `template<...> class X;`.
fn classTemplate(t: usize, header: usize) -> void {
    const keyword = cursor.peek()
    cursor.advance()
    const tag = cursor.expectIdent()
    at(t).*.isClass = true
    at(t).*.name = tokens.name(tag)
    const known = scope.findHere(at(t).*.name)
    var record = t
    if known != 0 && scope.at(known).*.kind == scope.TEMPLATE && at(scope.at(known).*.obj).*.isClass {
        // Declared before: the one record.
        record = scope.at(known).*.obj
        if cursor.is(names.P_LT) {
            partialSpecialization(record, t, keyword)
            return
        }
        if cursor.is(names.P_SEMI) {
            cursor.advance()
            return
        }
        if at(record).*.start != 0 { tokens.errorAt(tag, "redefinition of a class template") }
        at(record).*.start = at(t).*.start
        at(record).*.params = at(t).*.params
        at(record).*.paramCount = at(t).*.paramCount
    } else {
        if cursor.consume(names.P_SEMI) {
            at(t).*.start = 0
        }
        const bound = scope.bindTemplate(at(t).*.name, t)
        if at(t).*.start == 0 { return }
    }
    skipDeclaration()
}

// `template <class T> struct X<T *> { ... };` at the `<`: a partial
// specialization of `record`, its arguments read as patterns (the
// parameters of `t` as placeholders) for instances to match.
fn partialSpecialization(record: usize, t: usize, keyword: usize) -> void {
    patternCount += 1
    const prefix = scope.qualify(at(record).*.namespace, base.intern(base.join("partial#", base.decimal(@intCast(u64, patternCount)))))
    scope.enterPrefix(prefix)
    var p = at(t).*.params
    var index: i64 = 0
    while p != 0 {
        const name = @intCast(u32, base.getWord(p))
        if base.getWord(p + 8) != 0 {
            const bound = scope.bindTypedef(name, types.templateParameter(index))
        } else {
            const bound = scope.bindEnumConstant(name, base.getWord(p + 16), 0)
        }
        index += 1
        p = base.getWord(p + 24)
    }
    patternDepth += 1
    const outerPattern = patternTemplate
    patternTemplate = t
    const read = parseArguments(record)
    patternTemplate = outerPattern
    patternDepth -= 1
    scope.leaveNamespace()
    const c = base.alloc(40)
    base.putWord(c, t)
    base.putWord(c + 8, read.0)
    base.putWord(c + 16, if cursor.is(names.P_SEMI) { 0 } else { keyword })
    base.putWord(c + 24, at(record).*.partials)
    base.putWord(c + 32, tokens.next(keyword))
    at(record).*.partials = c
    skipDeclaration()
}

// How much a pattern type says: nothing for a bare parameter, more
// for each pointer, reference, const or class template around one, most
// for a type with no parameter in it.
fn specificity(pattern: usize) -> i64 {
    const k = types.kind(pattern)
    var score: i64 = if types.isConst(pattern) { 1 } else { 0 }
    if k == types.TPARAM {
        if types.at(pattern).*.arrayLength >= 0 { return score }
        score += 1
        var m = types.at(pattern).*.members
        while m != 0 {
            if base.getWord(m) == 1 { score += specificity(base.getWord(m + 8)) }
            if base.getWord(m) == 0 { score += 2 }
            m = base.getWord(m + 24)
        }
        return score
    }
    if k == types.PTR || k == types.REF || k == types.ARRAY { return score + 1 + specificity(types.baseOf(pattern)) }
    return score + 2
}

// The partial specialization of `t` fitting `args` best (the one with
// the most arguments that are not bare parameters), and the bindings
// of its parameters: 0 for none.
fn matchingPartial(t: usize, args: usize) -> (usize, usize) {
    var best: usize = 0
    var bestBindings: usize = 0
    var bestScore: i64 = -1
    var c = at(t).*.partials
    while c != 0 {
        const partial = base.getWord(c)
        if base.getWord(c + 16) != 0 {
            const bindings = base.alloc(at(partial).*.paramCount * 8 + 8)
            var fits = true
            var score: i64 = 0
            var p = base.getWord(c + 8)
            var a = args
            while fits && p != 0 && a != 0 {
                if base.getWord(p) == 2 {
                    // A value parameter of the specialization.
                    if base.getWord(a) != 0 { fits = false } else {
                        const slot = bindings + base.getWord(p + 16) * 8
                        if base.getWord(slot) == 0 {
                            base.putWord(slot, a + 16)
                        } else if base.getWord(base.getWord(slot)) != base.getWord(a + 16) {
                            fits = false
                        }
                    }
                } else if base.getWord(p) != base.getWord(a) {
                    fits = false
                } else if base.getWord(p) != 0 {
                    const pattern = base.getWord(p + 8)
                    fits = deduceArgument(pattern, base.getWord(a + 8), bindings)
                    score += specificity(pattern)
                } else {
                    if base.getWord(p + 16) != base.getWord(a + 16) { fits = false }
                    score += 1
                }
                p = base.getWord(p + 24)
                a = base.getWord(a + 24)
            }
            if p != 0 || a != 0 { fits = false }
            var index: usize = 0
            while fits && index < at(partial).*.paramCount {
                if base.getWord(bindings + index * 8) == 0 { fits = false }
                index += 1
            }
            if fits && score > bestScore {
                best = c
                bestBindings = bindings
                bestScore = score
            }
        }
        c = base.getWord(c + 24)
    }
    return -> (best, bestBindings)
}

// The member template `Class::f` the declaration starting at `start`
// defines (`R Class::f(...)`, Class a plain class): its record, 0 for
// none.
fn memberTemplateDefined(start: usize) -> usize {
    var t = start
    var level: u32 = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LBRACE) || tokens.is(t, names.P_SEMI) { return 0 }
        if tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_RPAREN) { level -= 1 }
        if level == 0 && tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_SCOPE) && tokens.kind(tokens.next(tokens.next(t))) == tokens.IDENT {
            const owner = scope.findKind(tokens.name(t), scope.NAMESPACE)
            if owner != 0 {
                const classTy = cpp.classWithPrefix(@intCast(u32, scope.at(owner).*.value))
                if classTy != 0 {
                    const binding = scope.findQualified(@intCast(u32, scope.at(owner).*.value), tokens.name(tokens.next(tokens.next(t))), false)
                    if isFunctionTemplate(binding) && at(scope.at(binding).*.obj).*.owner == classTy { return scope.at(binding).*.obj }
                }
            }
        }
        t = tokens.next(t)
    }
    return 0
}

// `template <...> R f(params);` or `{ body }` inside the class `classTy`
// (cpp.specialMember): a member template, bound in the class's scope.
pub fn memberTemplate(classTy: usize) -> void {
    cursor.expect(names.K_TEMPLATE)
    const t = base.alloc(@sizeOf(Template))
    at(t).*.namespace = types.at(classTy).*.name
    at(t).*.owner = classTy
    parameters(t)
    at(t).*.start = cursor.save()
    at(t).*.declaration = at(t).*.start
    if cursor.is(names.K_CLASS) || cursor.is(names.K_STRUCT) || cursor.is(names.K_TEMPLATE) { cursor.fail("only member function templates are supported") }
    functionTemplate(t)
}

// Defines the instances of the member template `t` that waited for
// its definition (read now).
fn defineWaiting(t: usize) -> void {
    var c = at(t).*.waiting
    at(t).*.waiting = 0
    while c != 0 {
        const o = base.getWord(c)
        const prefix = @intCast(u32, base.getWord(c + 8))
        const context = beginInstance()
        // The definition's parameter names may differ from the
        // declaration's: bound again, under the same prefix.
        bindParameters(at(t).*.params, base.getWord(c + 16), prefix)
        scope.enterPrefix(prefix)
        cursor.restore(at(t).*.start)
        const attr = decl.newAttr()
        const baseType = decl.declspec(attr)
        const found = decl.declarator(baseType)
        if found.1 == 0 || types.kind(found.0) != types.FUNC { cursor.fail("expected a function template") }
        decl.defineFunctionAs(o, prefix, found.0)
        scope.leaveNamespace()
        endInstance(context)
        c = base.getWord(c + 24)
    }
}

// At the end of the unit: an instance still waiting for its member
// template's definition is an error.
pub fn finish() -> void {
    var c = waitingTemplates
    while c != 0 {
        const t = base.getWord(c)
        if at(t).*.waiting != 0 {
            const o = base.getWord(at(t).*.waiting)
            tokens.errorAt(ast.obj(o).*.token, base.join("the member template is not defined: ", base.nameOf(at(t).*.name)))
        }
        c = base.getWord(c + 8)
    }
}

// The member templates with instances waiting: cells of (template, next).
var waitingTemplates: usize = 0

// The class template whose member the declaration starting at `start`
// defines (`R vector<T>::f(...)`): 0 for none.
fn memberOf(start: usize) -> usize {
    var t = start
    var level: u32 = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LBRACE) || tokens.is(t, names.P_SEMI) { return 0 }
        if tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_RPAREN) { level -= 1 }
        if level == 0 && tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_LT) {
            const binding = scope.findKind(tokens.name(t), scope.TEMPLATE)
            if isClassTemplate(binding) {
                const after = endOfArguments(tokens.next(t))
                if after != 0 && tokens.is(after, names.P_SCOPE) { return scope.at(binding).*.obj }
            }
        }
        t = tokens.next(t)
    }
    return 0
}

// A function template: its signature is read with placeholders.
fn functionTemplate(t: usize) -> void {
    patternCount += 1
    at(t).*.patternPrefix = scope.qualify(at(t).*.namespace, base.intern(base.join("template#", base.decimal(@intCast(u64, patternCount)))))
    scope.enterPrefix(at(t).*.patternPrefix)
    var p = at(t).*.params
    var index: i64 = 0
    while p != 0 {
        const name = @intCast(u32, base.getWord(p))
        if base.getWord(p + 8) != 0 {
            const bound = scope.bindTypedef(name, types.templateParameter(index))
        } else {
            const bound = scope.bindEnumConstant(name, base.getWord(p + 16), 0)
        }
        index += 1
        p = base.getWord(p + 24)
    }
    const attr = decl.newAttr()
    patternDepth += 1
    const outerPattern = patternTemplate
    patternTemplate = t
    const baseType = decl.declspec(attr)
    const found = decl.declarator(baseType)
    patternTemplate = outerPattern
    patternDepth -= 1
    scope.leaveNamespace()
    if found.1 == 0 || types.kind(found.0) != types.FUNC { cursor.fail("expected a function template") }
    at(t).*.name = tokens.name(found.1)
    at(t).*.pattern = found.0
    if cursor.consume(names.P_SEMI) {
        // A member template declared only: its definition comes outside
        // the class; a function template declared only: its definition
        // is another template of the name (passed over in calls).
        at(t).*.start = 0
    } else {
        if !cursor.is(names.P_LBRACE) { tokens.errorAt(found.1, "a function template needs its body here") }
        skipDeclaration()
    }
    // Bound after any template of the same name.
    const known = scope.findHere(at(t).*.name)
    if known != 0 && scope.at(known).*.kind == scope.TEMPLATE {
        var last = scope.at(known).*.obj
        while at(last).*.next != 0 { last = at(last).*.next }
        at(last).*.next = t
    } else {
        const bound = scope.bindTemplate(at(t).*.name, t)
    }
}

// ---------------------------------------------------------------------------
// Arguments and keys

// `<args>` at the `<`: cells of (isType, type, value, next) and their
// number. With `partial`, the parameters left without an argument or a
// default are left to deduction.
fn parseArguments(t: usize) -> (usize, usize) {
    return readArguments(t, false)
}

fn readArguments(t: usize, partial: bool) -> (usize, usize) {
    cursor.expect(names.P_LT)
    var head: usize = 0
    var tail: usize = 0
    var count: usize = 0
    var p = at(t).*.params
    while true {
        if count > 0 && !cursor.consume(names.P_COMMA) { break }
        if p == 0 { cursor.fail("too many template arguments") }
        const c = base.alloc(32)
        if base.getWord(p + 8) != 0 {
            if !decl.isTypename(cursor.peek()) { cursor.fail("expected a type as the template argument") }
            base.putWord(c, 1)
            base.putWord(c + 8, decl.typeName())
        } else if patternDepth > 0 && patternValueParameter() >= 0 {
            // `MemPool<N>` in a function template's signature, N one of
            // its parameters: deduced from the argument's instance.
            base.putWord(c, 2)
            base.putWord(c + 16, @intCast(usize, patternValueParameter()))
            cursor.advance()
        } else {
            const outer = expr.inTemplateArguments
            expr.inTemplateArguments = true
            base.putWord(c + 16, @bitCast(u64, eval.constExpression()))
            expr.inTemplateArguments = outer
        }
        if head == 0 { head = c } else { base.putWord(tail + 24, c) }
        tail = c
        count += 1
        p = base.getWord(p + 24)
        if cursor.is(names.P_SHR) { splitShr() }
    }
    cursor.expect(names.P_GT)
    // The parameters left take their defaults, which may name the
    // parameters before them.
    const after = cursor.save()
    while p != 0 {
        const start = base.getWord(p + 32)
        if start == 0 && partial { break }
        if start == 0 { cursor.fail("too few template arguments") }
        defaultCount += 1
        const prefix = scope.qualify(at(t).*.namespace, base.intern(base.join("defaults#", base.decimal(@intCast(u64, defaultCount)))))
        bindParameters(at(t).*.params, head, prefix)
        scope.enterPrefix(prefix)
        cursor.restore(start)
        const c = base.alloc(32)
        if base.getWord(p + 8) != 0 {
            base.putWord(c, 1)
            base.putWord(c + 8, decl.typeName())
        } else {
            const outer = expr.inTemplateArguments
            expr.inTemplateArguments = true
            base.putWord(c + 16, @bitCast(u64, eval.constExpression()))
            expr.inTemplateArguments = outer
        }
        scope.leaveNamespace()
        if head == 0 { head = c } else { base.putWord(tail + 24, c) }
        tail = c
        count += 1
        p = base.getWord(p + 24)
    }
    cursor.restore(after)
    return -> (head, count)
}

// The index of the pattern template's value parameter the cursor names
// (an argument of its own: `<N>`, `<N,`), -1 for none.
fn patternValueParameter() -> i64 {
    if patternTemplate == 0 || !cursor.isIdent() { return -1 }
    const next = cursor.peekNext()
    if !cursor.isToken(next, names.P_COMMA) && !cursor.isToken(next, names.P_GT) && !cursor.isToken(next, names.P_SHR) { return -1 }
    const name = tokens.name(cursor.peek())
    var p = at(patternTemplate).*.params
    var index: i64 = 0
    while p != 0 {
        if @intCast(u32, base.getWord(p)) == name { return if base.getWord(p + 8) == 0 { index } else { -1 } }
        index += 1
        p = base.getWord(p + 24)
    }
    return -1
}

// `vector<vector<int>>`: the `>>` at the cursor closes twice, made two
// `>` tokens.
fn splitShr() -> void {
    const first = cursor.peek()
    const second = tokens.copy(first)
    tokens.at(second).*.name = names.P_GT
    tokens.at(second).*.length = 1
    tokens.at(second).*.start = tokens.at(first).*.start + 1
    tokens.at(second).*.next = tokens.at(first).*.next
    tokens.at(first).*.name = names.P_GT
    tokens.at(first).*.length = 1
    tokens.at(first).*.next = second
}

// The arguments' codes, `i,3` for <int, 3>.
fn argumentCodes(args: usize) -> []const u8 {
    var text: []const u8 = ""
    var c = args
    while c != 0 {
        if c != args { text = base.join(text, ",") }
        if base.getWord(c) != 0 {
            text = base.join(text, mangle.typeCode(base.getWord(c + 8)))
        } else {
            const value = @bitCast(i64, base.getWord(c + 16))
            if value < 0 { text = base.join(base.join(text, "n"), base.decimal(@intCast(u64, 0 - value))) } else { text = base.join(text, base.decimal(@intCast(u64, value))) }
        }
        c = base.getWord(c + 24)
    }
    return text
}

fn instanceKey(t: usize, args: usize) -> u32 {
    return base.intern(base.join(base.join(base.join(base.nameOf(at(t).*.name), "<"), argumentCodes(args)), ">"))
}

fn cached(t: usize, key: u32) -> usize {
    var c = at(t).*.instances
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == key { return base.getWord(c + 8) }
        c = base.getWord(c + 16)
    }
    return 0
}

fn cache(t: usize, key: u32, result: usize) -> void {
    const c = base.alloc(24)
    base.putWord(c, @intCast(usize, key))
    base.putWord(c + 8, result)
    base.putWord(c + 16, at(t).*.instances)
    at(t).*.instances = c
}

fn dependent(args: usize) -> bool {
    var c = args
    while c != 0 {
        if base.getWord(c) == 2 { return true }
        if base.getWord(c) != 0 && types.kind(base.getWord(c + 8)) == types.TPARAM { return true }
        c = base.getWord(c + 24)
    }
    return false
}

// Binds the parameters `params` (cells as Template.params) to `args`
// under `prefix`.
fn bindParameters(params: usize, args: usize, prefix: u32) -> void {
    scope.enterPrefix(prefix)
    var p = params
    var a = args
    while p != 0 && a != 0 {
        const name = @intCast(u32, base.getWord(p))
        if base.getWord(p + 8) != 0 {
            if base.getWord(a) == 0 { cursor.fail("a type was expected as the template argument") }
            const bound = scope.bindTypedef(name, base.getWord(a + 8))
        } else {
            if base.getWord(a) != 0 { cursor.fail("a value was expected as the template argument") }
            const bound = scope.bindEnumConstant(name, base.getWord(p + 16), @bitCast(i64, base.getWord(a + 16)))
        }
        p = base.getWord(p + 24)
        a = base.getWord(a + 24)
    }
    scope.leaveNamespace()
}

// ---------------------------------------------------------------------------
// Instantiation

// What is put aside while an instance is read: the cursor, the function
// being read, the block scopes, the declaration state.
const Context = struct {
    cursor: usize
    state: usize
    declaration: usize
    inArguments: bool
    open: u32
}

fn contextAt(c: usize) -> *Context {
    unsafe { return @ptrFromInt(*Context, c) }
}

// The same for a lambda's body (lambda.mlx), read as a member function
// of its closure class while the function around is put aside.
pub fn beginContext() -> usize { return beginInstance() }
pub fn endContext(c: usize) -> void { endInstance(c) }

fn beginInstance() -> usize {
    const c = base.alloc(@sizeOf(Context))
    contextAt(c).*.cursor = cursor.save()
    contextAt(c).*.state = state.save()
    contextAt(c).*.declaration = decl.suspendDeclarations()
    contextAt(c).*.inArguments = expr.inTemplateArguments
    contextAt(c).*.open = instancesOpen
    expr.inTemplateArguments = false
    instancesOpen = 0
    scope.suspend()
    state.startFunction(0)
    return c
}

fn endInstance(c: usize) -> void {
    scope.resume()
    decl.resumeDeclarations(contextAt(c).*.declaration)
    state.restore(contextAt(c).*.state)
    cursor.restore(contextAt(c).*.cursor)
    expr.inTemplateArguments = contextAt(c).*.inArguments
    instancesOpen = contextAt(c).*.open
}

// The instances being read: cells of (key, next).
var openInstances: usize = 0
fn isOpen(key: u32) -> bool {
    var c = openInstances
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == key { return true }
        c = base.getWord(c + 8)
    }
    return false
}

// `name<args>` of the class template `t`, at the name: its instance
// (read now when new), or a dependent placeholder when an argument is
// a function template's parameter.
pub fn classTypeHere(binding: usize) -> usize {
    const t = scope.at(binding).*.obj
    cursor.advance()
    const read = parseArguments(t)
    const args = read.0
    var valueArgument = false
    var a = args
    while a != 0 {
        if base.getWord(a) == 0 { valueArgument = true }
        a = base.getWord(a + 24)
    }
    if dependent(args) || (patternDepth > 0 && valueArgument) {
        // A pattern `vector<T>`: the template and its arguments, for
        // deduction against an instance.
        const ty = types.templateParameter(-1)
        types.at(ty).*.params = t
        types.at(ty).*.members = args
        return ty
    }
    return instantiateClass(t, args)
}

fn instantiateClass(t: usize, args: usize) -> usize {
    const key = instanceKey(t, args)
    const known = cached(t, key)
    // Known: unless declared only (`template <class T> class X;` used
    // as a type) and the template is defined since, which completes
    // it in place now; being read (the class names itself): itself.
    if known != 0 && (!types.at(known).*.incomplete || isOpen(key)) { return known }
    const partial = matchingPartial(t, args)
    if known != 0 && partial.0 == 0 && at(t).*.start == 0 { return known }
    if partial.0 != 0 { return instantiatePartial(t, key, args, partial.0, partial.1) }
    if at(t).*.start == 0 {
        // Declared only: an incomplete class, completed when the
        // template is defined and the instance named again.
        const declared = types.structType()
        types.at(declared).*.name = scope.qualify(at(t).*.namespace, key)
        scope.enterPrefix(at(t).*.namespace)
        scope.beginQualified()
        const bound = scope.bindTag(key, declared)
        scope.endQualified()
        scope.leaveNamespace()
        cache(t, key, declared)
        cpp.setTemplateOrigin(declared, t, args)
        return declared
    }
    const open = base.alloc(16)
    base.putWord(open, @intCast(usize, key))
    base.putWord(open + 8, openInstances)
    openInstances = open
    const context = beginInstance()
    const prefix = scope.qualify(at(t).*.namespace, key)
    bindParameters(at(t).*.params, args, prefix)
    if at(t).*.isAlias {
        scope.enterPrefix(prefix)
        cursor.restore(at(t).*.start)
        const aliased = decl.typeName()
        cursor.expect(names.P_SEMI)
        cache(t, key, aliased)
        scope.leaveNamespace()
        endInstance(context)
        return aliased
    }
    scope.enterPrefix(at(t).*.namespace)
    tagOverride = key
    cursor.restore(at(t).*.start)
    instancesOpen += 1
    const attr = decl.newAttr()
    const ty = decl.declspec(attr)
    tagOverride = 0
    cursor.expect(names.P_SEMI)
    openInstances = base.getWord(openInstances + 8)
    cache(t, key, ty)
    cpp.setTemplateOrigin(ty, t, args)
    // The members defined outside the class, under the instance's prefix
    // (their own parameter names bound to the arguments too).
    var m = at(t).*.memberDefs
    while m != 0 {
        cursor.restore(base.getWord(m))
        cursor.expect(names.K_TEMPLATE)
        const own = base.alloc(@sizeOf(Template))
        parameters(own)
        if at(own).*.paramCount != at(t).*.paramCount { cursor.fail("the member definition's template parameters differ from the class's") }
        bindParameters(at(own).*.params, args, prefix)
        scope.enterPrefix(prefix)
        const memberAttr = decl.newAttr()
        const memberBase = decl.declspec(memberAttr)
        decl.globalDeclaration(memberBase, memberAttr)
        scope.leaveNamespace()
        m = base.getWord(m + 8)
    }
    instancesOpen -= 1
    scope.leaveNamespace()
    endInstance(context)
    return ty
}

// The instance `key` of `t` read from the partial specialization
// `cell` (matchingPartial) with its parameters bound to `bindings`.
fn instantiatePartial(t: usize, key: u32, args: usize, cell: usize, bindings: usize) -> usize {
    const partial = base.getWord(cell)
    const keyword = base.getWord(cell + 16)
    const context = beginInstance()
    const prefix = scope.qualify(at(t).*.namespace, key)
    bindParameters(at(partial).*.params, boundArguments(partial, bindings), prefix)
    scope.enterPrefix(at(t).*.namespace)
    tagOverride = key
    cursor.restore(keyword)
    // The tag's tokens: the keyword, the tag, then the pattern
    // arguments, which the class reader must not see.
    const tag = base.getWord(cell + 32)
    const tagCopy = tokens.copy(tag)
    tokens.at(tagCopy).*.next = endOfArguments(tokens.next(tag))
    tokens.at(keyword).*.next = tagCopy
    instancesOpen += 1
    const attr = decl.newAttr()
    const ty = decl.declspec(attr)
    tagOverride = 0
    cursor.expect(names.P_SEMI)
    cache(t, key, ty)
    cpp.setTemplateOrigin(ty, t, args)
    instancesOpen -= 1
    scope.leaveNamespace()
    endInstance(context)
    return ty
}

// The object standing for the function template in a call: the
// instance is chosen by the arguments (expr.buildCall).
pub fn placeholder(binding: usize) -> usize {
    return placeholderFor(scope.at(binding).*.obj)
}

pub fn placeholderFor(t: usize) -> usize {
    if at(t).*.placeholder == 0 {
        const o = ast.newObj(at(t).*.name, at(t).*.pattern, 0)
        ast.obj(o).*.isFunction = true
        ast.obj(o).*.template = t
        at(t).*.placeholder = o
    }
    return at(t).*.placeholder
}

// `name<args>` of a function template, at the name: the instance.
pub fn explicitFunction(binding: usize) -> usize {
    const t = scope.at(binding).*.obj
    cursor.advance()
    const read = parseArguments(t)
    return instantiateFunction(t, read.0)
}

// `name<args>(...)`, at the name: an object standing for the templates
// of the name with the arguments given, the rest deduced by the call.
pub fn explicitPlaceholder(binding: usize) -> usize {
    const t = scope.at(binding).*.obj
    cursor.advance()
    const read = readArguments(t, true)
    const o = ast.newObj(at(t).*.name, at(t).*.pattern, 0)
    ast.obj(o).*.isFunction = true
    ast.obj(o).*.template = t
    ast.obj(o).*.templateArgs = read.0
    return o
}

// Type arguments as cells (as parseArguments makes them).
// The arguments bound by deduction: a word per parameter, a type for a
// type parameter, the address of the value for a value parameter.
fn boundArguments(t: usize, bindings: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var index: usize = 0
    var p = at(t).*.params
    while p != 0 {
        const c = base.alloc(32)
        if base.getWord(p + 8) != 0 {
            base.putWord(c, 1)
            base.putWord(c + 8, base.getWord(bindings + index * 8))
        } else {
            base.putWord(c + 16, base.getWord(base.getWord(bindings + index * 8)))
        }
        if head == 0 { head = c } else { base.putWord(tail + 24, c) }
        tail = c
        index += 1
        p = base.getWord(p + 24)
    }
    return head
}

// A template argument against a pattern argument: a reference pattern
// (`X<T &>`) takes a reference only (a parameter's reference binds to
// anything, deduce).
fn deduceArgument(pattern: usize, arg: usize, bindings: usize) -> bool {
    if types.isConst(pattern) && !types.isConst(arg) { return false }
    if types.kind(pattern) == types.REF {
        if types.kind(arg) != types.REF { return false }
        return deduceArgument(types.baseOf(pattern), types.baseOf(arg), bindings)
    }
    return deduce(pattern, arg, bindings, false)
}

// Deduces the template parameters in `pattern` from the argument type
// `arg` into `bindings` (one word per parameter); false when they do
// not fit.
fn deduce(pattern: usize, arg: usize, bindings: usize, byValue: bool) -> bool {
    const k = types.kind(pattern)
    if k == types.TPARAM {
        const index = types.at(pattern).*.arrayLength
        if index < 0 {
            // `vector<T>` against an instance of the same template: its
            // arguments deduce T.
            const record = types.at(pattern).*.params
            if record == 0 || cpp.templateRecordOf(arg) != record { return false }
            var p = types.at(pattern).*.members
            var a = cpp.templateArgsOf(arg)
            while p != 0 && a != 0 {
                if base.getWord(p) == 2 {
                    // A value parameter: the instance's value binds it.
                    if base.getWord(a) != 0 { return false }
                    const slot = bindings + base.getWord(p + 16) * 8
                    if base.getWord(slot) == 0 {
                        base.putWord(slot, a + 16)
                    } else if base.getWord(base.getWord(slot)) != base.getWord(a + 16) {
                        return false
                    }
                } else if base.getWord(p) != base.getWord(a) {
                    return false
                } else if base.getWord(p) != 0 {
                    if !deduceArgument(base.getWord(p + 8), base.getWord(a + 8), bindings) { return false }
                }
                // A value argument of the pattern is not checked: it may be
                // a parameter's (given explicitly then).
                p = base.getWord(p + 24)
                a = base.getWord(a + 24)
            }
            return p == 0 && a == 0
        }
        var value = arg
        if byValue {
            if types.kind(arg) == types.ARRAY { value = types.pointerTo(types.baseOf(arg)) }
            if types.kind(arg) == types.FUNC { value = types.pointerTo(arg) }
        }
        if byValue || types.isConst(pattern) { value = types.unqualified(value) }
        const known = base.getWord(bindings + @intCast(usize, index) * 8)
        if known == 0 {
            base.putWord(bindings + @intCast(usize, index) * 8, value)
            return true
        }
        return types.compatible(known, value)
    }
    if k == types.REF { return deduce(types.baseOf(pattern), arg, bindings, false) }
    if k == types.PTR {
        if types.kind(arg) != types.PTR && types.kind(arg) != types.ARRAY { return false }
        // `const T *` takes a pointer to const only (T without the const).
        if types.isConst(types.baseOf(pattern)) && !types.isConst(types.baseOf(arg)) { return false }
        return deduce(types.baseOf(pattern), types.baseOf(arg), bindings, false)
    }
    if k == types.ARRAY {
        if types.kind(arg) != types.ARRAY { return false }
        return deduce(types.baseOf(pattern), types.baseOf(arg), bindings, false)
    }
    return true
}

// The instance of one of the function templates `first` (and the others
// of its name) that takes the `count` arguments in `given` best, made
// by deduction (after the template arguments `explicit`, cells, when
// given); 0 when none fits.
pub fn callInstance(first: usize, given: usize, count: usize, explicit: usize) -> usize {
    var best: usize = 0
    var bestScore: i64 = -1
    var t = first
    while t != 0 {
        const bindings = base.alloc(at(t).*.paramCount * 8 + 8)
        // A template declared only (`template <...> R f(...);`) has
        // nothing to instantiate.
        var fits = at(t).*.start != 0 || at(t).*.declaration != 0
        // The explicit arguments first (types only).
        var e = explicit
        var slot: usize = 0
        while e != 0 && fits {
            if slot >= at(t).*.paramCount {
                fits = false
            } else if base.getWord(e) == 0 {
                base.putWord(bindings + slot * 8, e + 16)
            } else {
                base.putWord(bindings + slot * 8, base.getWord(e + 8))
            }
            slot += 1
            e = base.getWord(e + 24)
        }
        var p = types.at(at(t).*.pattern).*.params
        var index: usize = 0
        while index < count && fits {
            if p == 0 {
                fits = types.at(at(t).*.pattern).*.variadic
                break
            }
            typing.addType(base.getWord(given + index * 8))
            fits = deduce(types.param(p).*.ty, ast.typeOf(base.getWord(given + index * 8)), bindings, true)
            p = types.param(p).*.next
            index += 1
        }
        // The parameters left take their defaults.
        while p != 0 && types.param(p).*.defaultValue != 0 { p = types.param(p).*.next }
        if p != 0 { fits = false }
        index = 0
        while fits && index < at(t).*.paramCount {
            if base.getWord(bindings + index * 8) == 0 { fits = false }
            index += 1
        }
        if fits {
            const instance = instantiateFunction(t, boundArguments(t, bindings))
            const score = expr.argumentScore(instance, given, count)
            if score > bestScore {
                best = instance
                bestScore = score
            }
        }
        t = at(t).*.next
    }
    return best
}

fn instantiateFunction(t: usize, args: usize) -> usize {
    const key = instanceKey(t, args)
    const known = cached(t, key)
    if known != 0 { return known }
    // A member template declared in its class and defined later: the
    // instance gets its signature from the declaration, its body when
    // the definition is read.
    const waits = at(t).*.start == 0
    if waits && at(t).*.declaration == 0 { cursor.fail(base.join("the member template is not defined: ", base.nameOf(at(t).*.name))) }
    const context = beginInstance()
    // A member template's instance is a member function of its class:
    // its parameters are bound under a prefix below the class's.
    const prefix = scope.qualify(at(t).*.namespace, key)
    bindParameters(at(t).*.params, args, prefix)
    scope.enterPrefix(prefix)
    cursor.restore(if waits { at(t).*.declaration } else { at(t).*.start })
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    const found = decl.declarator(baseType)
    if found.1 == 0 || types.kind(found.0) != types.FUNC { cursor.fail("expected a function template") }
    const o = ast.newObj(at(t).*.name, found.0, found.1)
    const obj = ast.obj(o)
    obj.*.isFunction = true
    obj.*.isWeak = true
    obj.*.isInline = true
    obj.*.isReferenced = true
    obj.*.linkName = mangle.templateFunctionSymbol(at(t).*.namespace, at(t).*.name, argumentCodes(args), found.0)
    obj.*.symbol = obj.*.linkName
    if at(t).*.owner != 0 {
        obj.*.classType = at(t).*.owner
        obj.*.isStaticMember = decl.attrAt(attr).*.isStatic
        if !obj.*.isStaticMember { obj.*.ty = cpp.withThisPublic(at(t).*.owner, found.0) }
    }
    state.addGlobal(o)
    cache(t, key, o)
    if waits {
        const c = base.alloc(32)
        base.putWord(c, o)
        base.putWord(c + 8, @intCast(usize, prefix))
        base.putWord(c + 16, args)
        base.putWord(c + 24, at(t).*.waiting)
        if at(t).*.waiting == 0 {
            const w = base.alloc(16)
            base.putWord(w, t)
            base.putWord(w + 8, waitingTemplates)
            waitingTemplates = w
        }
        at(t).*.waiting = c
    } else {
        decl.defineFunctionIn(o, prefix)
    }
    scope.leaveNamespace()
    endInstance(context)
    return o
}
