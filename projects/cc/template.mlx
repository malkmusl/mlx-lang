// C++ templates: a class or function template is kept as its tokens,
// and an instance (`vector<int>`, `max<double>`, `max(1, 2)` by
// deduction) is read from them again with the template's parameters
// bound as typedefs (and non-type ones as constants) under the
// instance's own prefix (`std::vector<i>`), whose name is the template's
// with the arguments' codes. The instance class is bound in the
// template's namespace as a class of that name; its member functions
// are weak, as inline functions are. A function template's signature is
// read once, with placeholders for its parameters, so a call can deduce
// them from its arguments.
//
// An instance made in the middle of a function (`vector<int> v;` in
// main) belongs to the file: the function's state and the block scopes
// are put aside while it is read (state.save, scope.suspend).
//
// An explicit specialization (`template <> struct X<int> {...}`,
// `template <> int f(int)`) is read as the instance it names, bound
// under its key before any use. Not here: partial specializations,
// member templates, variadic templates, template
// template parameters, dependent qualified names in function template
// signatures (`typename T::iterator` as a parameter type).
const base = @import("./base.mlx")
const lambda = @import("./lambda.mlx")
const interp = @import("./interp.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const ast = @import("./ast.mlx")
const scope = @import("./scope.mlx")
const cursor = @import("./cursor.mlx")
const state = @import("./state.mlx")
const typing = @import("./typing.mlx")
const expr = @import("./expr.mlx")
const decl = @import("./decl.mlx")
const eval = @import("./eval.mlx")
const cpp = @import("./cpp.mlx")
const mangle = @import("./mangle.mlx")

pub const Template = struct {
    name: u32
    isClass: bool
    // `template <...> using X = type;`: an alias, `start` at the type.
    isAlias: bool
    // `template <class T> constexpr bool v = ...;`: a variable template
    // (its instances are globals or constants named by the key).
    isVariable: bool
    // A class template's partial specializations (`struct X<T *>`):
    // cells of (their record, the pattern arguments, the class keyword
    // token or 0 when declared only, next, the tag token).
    partials: usize
    // The parameters: cells of six words (name, isType, the type of a
    // non-type one, next, the default argument's first token or 0, 1
    // for a parameter pack), and their number.
    params: usize
    paramCount: usize
    // The namespace it is declared in, its declaration's first token
    // (after the parameter list; 0 for a forward declaration), the
    // out-of-line definitions of a class template's members (cells of
    // the `template` token and next).
    namespace: u32
    start: usize
    // `= delete`: no call takes it (an explicit specialization may name it).
    isDeleted: bool
    memberDefs: usize
    memberDefsTail: usize
    // A function template: its signature with placeholders, the prefix
    // the placeholders are bound under, the object standing for it in
    // calls.
    pattern: usize
    patternPrefix: u32
    placeholder: usize
    // The instances: cells of (key name id, type or object, next).
    instances: usize
    // Another template of the same name (overloaded function templates).
    next: usize
    // A member template declared `static` in its class.
    isStaticMember: bool
    // A constructor template (`template <class U> pair(U &&a)`): its
    // instances are constructors, tried by cpp.construct.
    isConstructor: bool
    // `template <class T> concept C = expr;`: a concept (a bool for
    // each set of arguments); `requires expr` after a parameter list
    // or a function's parameters: the constraint's first token (0 for
    // none), checked with the arguments before an instance is made.
    isConcept: bool
    // A template template parameter's stand-in (`template <class...>
    // class B`): the parameter's index + 1; 0 for a real template.
    standsFor: i64
    constraint: usize
    // A member template: the class it belongs to (its instances are
    // member functions of it), its declaration in the class when the
    // definition comes later (then `start` is 0 until it does), and the
    // instances waiting for that definition: cells of (object, prefix,
    // arguments, next).
    owner: usize
    declaration: usize
    waiting: usize
    // A class template's implicit deduction guides (from its
    // constructors) are made (implicitGuides).
    implicitGuides: bool
    // A member template of a class template's instance defined outside
    // the class (`template <class T, class V> template <class U> ...`):
    // the outer header's parameters and the instance's arguments, bound
    // again with the instance's own (another definition may name the
    // class's parameters otherwise).
    outerParams: usize
    outerArgs: usize
    // A member template given its definition outside the class.
    definedOutside: bool
}

// A function template's parameters (and an out-of-class member
// template's outer ones) bound to `args` under `prefix`.
// Whether the template parameter `p` is `auto V` (its type the
// argument's).
fn isAutoParameter(p: usize) -> bool {
    return p != 0 && base.getWord(p + 8) == 0 && tokens.isWord(base.getWord(p + 48), names.K_AUTO)
}

// A value argument read into the cell `c` (for the parameter `p`, 0 when
// not known): its value, and for an `auto` parameter its type too
// (`enumName<Kind::C>`: decltype(V) is the enum).
fn readValueArgument(c: usize, p: usize) -> void {
    if !isAutoParameter(p) {
        base.putWord(c + 16, @bitCast(u64, eval.constExpression()))
        return
    }
    const e = expr.conditional()
    typing.addType(e)
    base.putWord(c + 16, @bitCast(u64, eval.evaluate(e)))
    base.putWord(c + 8, types.unqualified(types.referenced(ast.typeOf(e))))
}

fn bindFunctionParameters(t: usize, args: usize, prefix: u32) -> void {
    if at(t).*.outerParams != 0 { bindParameters(at(t).*.outerParams, at(t).*.outerArgs, prefix) }
    bindParameters(at(t).*.params, args, prefix)
}

// The member definition being read for a class template's instance:
// its outer parameters and the instance's arguments.
var memberDefParams: usize = 0
var memberDefArgs: usize = 0

fn at(t: usize) -> *Template {
    unsafe { return @ptrFromInt(*Template, t) }
}

var patternCount: u32 = 0
var defaultCount: u32 = 0
// A function template's signature is being read with placeholders: a
// class template named in it with a value argument is dependent (the
// value is a parameter's, unknown yet).
var patternDepth: u32 = 0

// Whether a template's pattern (its signature read with placeholders)
// is being read.
pub fn inPattern() -> bool { return patternDepth > 0 }
var initializerListId: u32 = 0
fn initializerListName() -> u32 {
    if initializerListId == 0 { initializerListId = base.intern("initializer_list") }
    return initializerListId
}

// A token of the template `t` (its declaration's), for nodes made for it.
pub fn recordToken(t: usize) -> usize { return if at(t).*.start != 0 { at(t).*.start } else { at(t).*.declaration } }
// A template's name (for `std::initializer_list` among instances).
pub fn recordName(record: usize) -> u32 { return at(record).*.name }
pub fn recordNamespace(record: usize) -> u32 { return at(record).*.namespace }

// The binding of the deduction guides of the class template `binding`,
// 0 for none.
pub fn guidesOf(binding: usize) -> usize {
    if !isClassTemplate(binding) { return 0 }
    const t = scope.at(binding).*.obj
    implicitGuides(t)
    return scope.findQualified(at(t).*.namespace, guideName(at(t).*.name), false)
}

// The tokens from `first` up to `end` (not included) as text.
fn tokensText(first: usize, end: usize) -> []const u8 {
    var text: []const u8 = ""
    var t = first
    while t != 0 && t != end && !tokens.isEof(t) {
        text = base.join(text, base.join(tokens.text(t), " "))
        t = tokens.next(t)
    }
    return text
}

// C++17's implicit deduction guides of the class template `t`, made
// once: one per constructor whose parameters name only the template's
// parameters (and the constructor template's own) and what the
// template's namespace sees, `template <params> X(ctor params) ->
// X<params>;`, read as the explicit guides are.
fn implicitGuides(t: usize) -> void {
    if at(t).*.implicitGuides || at(t).*.start == 0 || !at(t).*.isClass || at(t).*.isAlias || at(t).*.standsFor != 0 { return }
    at(t).*.implicitGuides = true
    // The header (with the defaults) and the result.
    var header: []const u8 = "template < "
    var result: []const u8 = base.join(base.nameOf(at(t).*.name), " < ")
    var p = at(t).*.params
    var first = true
    while p != 0 {
        if base.getWord(p + 48) == 0 || base.getWord(p + 56) == 0 { return }
        // (An unnamed parameter cannot be named by the result.)
        if base.startsWith(base.nameOf(@intCast(u32, base.getWord(p))), "__unnamed") { return }
        if !first {
            header = base.join(header, " , ")
            result = base.join(result, " , ")
        }
        first = false
        header = base.join(header, tokensText(base.getWord(p + 48), base.getWord(p + 56)))
        if base.getWord(p + 32) != 0 {
            if base.getWord(p + 64) == 0 { return }
            header = base.join(header, base.join(" = ", tokensText(base.getWord(p + 32), base.getWord(p + 64))))
        }
        result = base.join(result, base.nameOf(@intCast(u32, base.getWord(p))))
        if base.getWord(p + 40) != 0 { result = base.join(result, " ... ") }
        p = base.getWord(p + 24)
    }
    result = base.join(result, " > ")
    // The class's body.
    var b = at(t).*.start
    while !tokens.isEof(b) && !tokens.is(b, names.P_LBRACE) && !tokens.is(b, names.P_SEMI) { b = tokens.next(b) }
    if !tokens.is(b, names.P_LBRACE) { return }
    guideAliases = memberAliases(b)
    const context = beginInstance()
    scope.enterPrefix(at(t).*.namespace)
    var depth: i64 = 1
    var previous = b
    var ctorHeader: usize = 0
    var x = tokens.next(b)
    while !tokens.isEof(x) && depth > 0 {
        if depth == 1 && tokens.isWord(x, names.K_TEMPLATE) && tokens.is(tokens.next(x), names.P_LT) {
            ctorHeader = tokens.next(x)
            const after = endOfArguments(ctorHeader)
            if after == 0 { break }
            // (The header's `>` before the constructor's name.)
            var gt = ctorHeader
            while tokens.next(gt) != after { gt = tokens.next(gt) }
            previous = gt
            x = after
            continue
        }
        if tokens.is(x, names.P_LBRACE) { depth += 1 }
        if tokens.is(x, names.P_RBRACE) {
            depth -= 1
            if depth == 1 { ctorHeader = 0 }
        }
        if depth == 1 && tokens.is(x, names.P_SEMI) { ctorHeader = 0 }
        if depth == 1 && tokens.kind(x) == tokens.IDENT && tokens.name(x) == at(t).*.name && tokens.is(tokens.next(x), names.P_LPAREN) && startsMember(previous) {
            const open = tokens.next(x)
            const close = afterGroup(open)
            if close != 0 {
                var closing = open
                while tokens.next(closing) != close { closing = tokens.next(closing) }
                const guide = implicitGuide(t, header, result, ctorHeader, open, closing)
                if guide != 0 {
                    const saved = cursor.save()
                    cursor.restore(guide)
                    declaration()
                    cursor.restore(saved)
                }
                previous = closing
                x = close
                continue
            }
        }
        previous = x
        x = tokens.next(x)
    }
    // The copy deduction candidate, `template <params> X(X<params>) ->
    // X<params>;` (`RefPtr r = makeRefPtr();` deduces the RefPtr's own
    // arguments), with the other guides.
    if scope.findQualified(at(t).*.namespace, guideName(at(t).*.name), false) != 0 {
        const text = base.join(header, base.join(" > ", base.join(base.nameOf(at(t).*.name), base.join(" ( ", base.join(result, base.join(" ) -> ", base.join(result, " ;\n")))))))
        const saved = cursor.save()
        cursor.restore(cpp.generatedTokens(text))
        declaration()
        cursor.restore(saved)
    }
    scope.leaveNamespace()
    endInstance(context)
}

// The default arguments of the parameters `declared` (a declaration's)
// given to the parameters `defined` (its definition's) that have none.
fn mergeDefaults(declared: usize, defined: usize) -> void {
    var before = declared
    var now = defined
    while before != 0 && now != 0 {
        if base.getWord(now + 32) == 0 {
            base.putWord(now + 32, base.getWord(before + 32))
            base.putWord(now + 64, base.getWord(before + 64))
        }
        before = base.getWord(before + 24)
        now = base.getWord(now + 24)
    }
}

// Whether `name` is declared in the namespace `ns` or one around it.
fn visibleFrom(ns: u32, name: u32) -> bool {
    var prefix = ns
    var steps: u32 = 0
    while steps < 64 {
        if scope.findQualified(prefix, name, false) != 0 || scope.findQualified(prefix, name, true) != 0 { return true }
        if prefix == 0 { return false }
        prefix = scope.parentOf(prefix)
        steps += 1
    }
    return false
}

// Whether a member declaration may start after `previous` (a
// constructor's name there declares one).
fn startsMember(previous: usize) -> bool {
    if tokens.is(previous, names.P_SEMI) || tokens.is(previous, names.P_LBRACE) || tokens.is(previous, names.P_RBRACE) || tokens.is(previous, names.P_COLON) || tokens.is(previous, names.P_GT) || tokens.is(previous, names.P_RPAREN) || tokens.is(previous, names.P_RBRACKET) { return true }
    return tokens.isWord(previous, names.K_EXPLICIT) || tokens.isWord(previous, names.K_CONSTEXPR) || tokens.isWord(previous, names.K_INLINE)
}

// The class's member aliases (`using CharacterType = T;`, `typedef T
// Value;`) from its body at `open`: cells of (name, first token, end
// token, next), for the implicit guides (whose parameters may name them).
var guideAliases: usize = 0
fn memberAliases(open: usize) -> usize {
    var list: usize = 0
    var depth: i64 = 1
    var x = tokens.next(open)
    var previous = open
    while !tokens.isEof(x) && depth > 0 {
        if tokens.is(x, names.P_LBRACE) { depth += 1 }
        if tokens.is(x, names.P_RBRACE) { depth -= 1 }
        const starts = tokens.is(previous, names.P_SEMI) || tokens.is(previous, names.P_LBRACE) || tokens.is(previous, names.P_RBRACE) || tokens.is(previous, names.P_COLON)
        if depth == 1 && starts && tokens.isWord(x, names.K_USING) && tokens.kind(tokens.next(x)) == tokens.IDENT && tokens.is(tokens.next(tokens.next(x)), names.P_ASSIGN) {
            const first = tokens.next(tokens.next(tokens.next(x)))
            var end = first
            while !tokens.isEof(end) && !tokens.is(end, names.P_SEMI) { end = tokens.next(end) }
            const c = base.alloc(32)
            base.putWord(c, @intCast(usize, tokens.name(tokens.next(x))))
            base.putWord(c + 8, first)
            base.putWord(c + 16, end)
            base.putWord(c + 24, list)
            list = c
        }
        if depth == 1 && starts && tokens.isWord(x, names.K_TYPEDEF) {
            var last = x
            var end = x
            while !tokens.isEof(end) && !tokens.is(end, names.P_SEMI) {
                last = end
                end = tokens.next(end)
            }
            if tokens.kind(last) == tokens.IDENT && tokens.next(x) != last {
                const c = base.alloc(32)
                base.putWord(c, @intCast(usize, tokens.name(last)))
                base.putWord(c + 8, tokens.next(x))
                base.putWord(c + 16, last)
                base.putWord(c + 24, list)
                list = c
            }
        }
        previous = x
        x = tokens.next(x)
    }
    return list
}

fn guideAlias(name: u32) -> usize {
    var c = guideAliases
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == name { return c }
        c = base.getWord(c + 24)
    }
    return 0
}

// The tokens from `first` up to `end` as text, the class's member
// aliases spelled out (`std::span<const CharacterType>` as
// `std::span<const T>`).
fn guideText(first: usize, end: usize) -> []const u8 { return guideTextAt(first, end, 0) }

fn guideTextAt(first: usize, end: usize, level: u32) -> []const u8 {
    var text: []const u8 = ""
    var t = first
    var before: usize = 0
    while t != 0 && t != end && !tokens.isEof(t) {
        const alias = if level < 8 && tokens.kind(t) == tokens.IDENT && (before == 0 || !tokens.is(before, names.P_SCOPE)) { guideAlias(tokens.name(t)) } else { 0 }
        if alias != 0 {
            text = base.join(text, guideTextAt(base.getWord(alias + 8), base.getWord(alias + 16), level + 1))
        } else {
            text = base.join(text, base.join(tokens.text(t), " "))
        }
        before = t
        t = tokens.next(t)
    }
    return text
}

// The guide's tokens for the constructor whose parameters are between
// `open` and `closing` (the parentheses), 0 when none is made for it.
fn implicitGuide(t: usize, header: []const u8, result: []const u8, ctorHeader: usize, open: usize, closing: usize) -> usize {
    if tokens.next(open) == closing { return 0 }
    if tokens.isWord(tokens.next(open), names.K_VOID) && tokens.next(tokens.next(open)) == closing { return 0 }
    // `= delete`d: no guide.
    if tokens.is(tokens.next(closing), names.P_ASSIGN) && tokens.isWord(tokens.next(tokens.next(closing)), names.K_DELETE) { return 0 }
    // The constructor template's parameters' names.
    var ownEnd: usize = 0
    if ctorHeader != 0 { ownEnd = endOfArguments(ctorHeader) }
    var u = tokens.next(open)
    var before = open
    var nesting: i64 = 0
    while u != closing {
        if tokens.is(u, names.P_LT) || tokens.is(u, names.P_LPAREN) || tokens.is(u, names.P_LBRACKET) { nesting += 1 }
        if tokens.is(u, names.P_GT) || tokens.is(u, names.P_RPAREN) || tokens.is(u, names.P_RBRACKET) { nesting -= 1 }
        if tokens.is(u, names.P_SHR) { nesting -= 2 }
        if tokens.kind(u) == tokens.IDENT && !tokens.is(before, names.P_SCOPE) && !tokens.is(before, names.P_DOT) && !tokens.is(before, names.P_ARROW) {
            const name = tokens.name(u)
            if name == at(t).*.name { return 0 }
            var known = visibleFrom(at(t).*.namespace, name) || guideAlias(name) != 0
            var p = at(t).*.params
            while p != 0 && !known {
                if @intCast(u32, base.getWord(p)) == name { known = true }
                p = base.getWord(p + 24)
            }
            if !known && ctorHeader != 0 {
                var h = tokens.next(ctorHeader)
                while h != 0 && h != ownEnd && !known {
                    if tokens.kind(h) == tokens.IDENT && tokens.name(h) == name { known = true }
                    h = tokens.next(h)
                }
            }
            // (A parameter's own name after its type is fine.)
            const next = tokens.next(u)
            const startsParameter = tokens.is(before, names.P_COMMA) || before == open
            if !known && nesting == 0 && !startsParameter && (next == closing || tokens.is(next, names.P_COMMA) || tokens.is(next, names.P_ASSIGN) || tokens.is(next, names.P_LBRACKET)) { known = true }
            if !known { return 0 }
        }
        before = u
        u = tokens.next(u)
    }
    var text = header
    if ctorHeader != 0 {
        var gt = ctorHeader
        while tokens.next(gt) != ownEnd { gt = tokens.next(gt) }
        if tokens.next(ctorHeader) != gt { text = base.join(text, base.join(" , ", tokensText(tokens.next(ctorHeader), gt))) }
    }
    text = base.join(text, base.join(" > ", base.join(base.nameOf(at(t).*.name), base.join(" ( ", base.join(guideText(tokens.next(open), closing), base.join(" ) -> ", base.join(result, " ;\n")))))))
    return cpp.generatedTokens(text)
}
var unnamedCount: u32 = 0
// The function template whose signature is being read as a pattern.
var patternTemplate: usize = 0
// How many class template instances are being read (their members'
// bodies wait for a call).
var instancesOpen: u32 = 0

pub fn instantiating() -> bool { return instancesOpen > 0 }

// Reads the body of the member function `o` of a class template's
// instance now, if it is still pending.
// Whether the instance `o` called here needs its body now: evaluated,
// or its result type is deduced from the body.
fn needsBody(o: usize) -> bool {
    if o == 0 { return false }
    if expr.unevaluated == 0 { return true }
    return types.hasAutoResult(types.baseOf(ast.obj(o).*.ty))
}

pub fn ensureDefined(o: usize) -> void {
    if o == 0 { return }
    // (Made at the end of the unit, as C++'s point of instantiation is:
    // a specialization declared after the call is seen. Not a constexpr
    // function, computed now, nor one whose result type the body says.)
    if !finishing && !ast.obj(o).*.isConstexpr && !types.hasAutoResult(types.baseOf(ast.obj(o).*.ty)) {
        if ast.obj(o).*.pendingBody != 0 || isPendingInstance(o) {
            const c = base.alloc(16)
            base.putWord(c, o)
            base.putWord(c + 8, lateBodies)
            lateBodies = c
        }
        return
    }
    ensureDefinedNow(o)
}

// The instances whose bodies are made at the end of the unit: cells of
// (object, next); being made.
var lateBodies: usize = 0
var finishing = false

fn isPendingInstance(o: usize) -> bool {
    var link = pendingBodies
    while link != 0 {
        if base.getWord(base.getWord(link)) == o { return true }
        link = base.getWord(link + 8)
    }
    return false
}

fn ensureDefinedNow(o: usize) -> void {
    definePendingInstance(o)
    const body = ast.obj(o).*.pendingBody
    if body == 0 { return }
    ast.obj(o).*.pendingBody = 0
    const context = beginInstance()
    base.nameTrace(if ast.obj(o).*.linkName != 0 { ast.obj(o).*.linkName } else { ast.obj(o).*.name })
    cursor.restore(body)
    const outer = pendingOuterOf(o)
    if outer != 0 && ast.obj(o).*.pendingClass != 0 {
        // A class template instance's member defined outside the class:
        // the class's parameters by the definition's names, below it.
        outerCount += 1
        const prefix = scope.qualify(types.at(ast.obj(o).*.pendingClass).*.name, base.intern(base.join("outer#", base.decimal(@intCast(u64, outerCount)))))
        bindParameters(base.getWord(outer + 8), base.getWord(outer + 16), prefix)
        decl.defineFunctionIn(o, prefix)
    } else {
        decl.defineFunction(o, ast.obj(o).*.pendingClass)
    }
    endInstance(context)
}

// The members of class template instances defined outside the class
// whose bodies wait: cells of (object, the definition's outer
// parameters, the instance's arguments, next).
var pendingOuters: usize = 0
var outerCount: u32 = 0

// Notes the outer parameters of the member definition being read for
// `o`, whose body waits (cpp.pendBody).
pub fn notePendingOuter(o: usize) -> void {
    if memberDefParams == 0 { return }
    const c = base.alloc(32)
    base.putWord(c, o)
    base.putWord(c + 8, memberDefParams)
    base.putWord(c + 16, memberDefArgs)
    base.putWord(c + 24, pendingOuters)
    pendingOuters = c
}

fn pendingOuterOf(o: usize) -> usize {
    var c = pendingOuters
    while c != 0 {
        if base.getWord(c) == o { return c }
        c = base.getWord(c + 24)
    }
    return 0
}
// The tag the class being read gets (an instance's key name), 0 for none.
var tagOverride: u32 = 0

// The name the class declaration read next is bound under, taken once.
// The incomplete instance (declaredInstance) the class being read
// completes in place, 0 for none (decl.structOrUnion takes it).
var completionTarget: usize = 0
pub fn takeCompletionTarget() -> usize {
    const t = completionTarget
    completionTarget = 0
    return t
}

pub fn hasTagOverride() -> bool { return tagOverride != 0 }

pub fn takeTagOverride() -> u32 {
    const name = tagOverride
    tagOverride = 0
    return name
}

pub fn isClassTemplate(binding: usize) -> bool {
    return binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE && at(scope.at(binding).*.obj).*.isClass
}

pub fn isFunctionTemplate(binding: usize) -> bool {
    return binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE && !at(scope.at(binding).*.obj).*.isClass
}

// The token after the `>` matching the `<` at `open`; 0 when there is
// none (`>>` closes two).
pub fn endOfArguments(open: usize) -> usize {
    var level: i64 = 1
    // (`<` and `>` inside parentheses or brackets are operators:
    // `step_at<(Base + I < N ? Base + I : 0)>`.)
    var nested: i64 = 0
    var t = tokens.next(open)
    // (A list of copied tokens may end without an EOF.)
    while t != 0 && !tokens.isEof(t) {
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) { nested += 1 }
        if (tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET)) && nested > 0 { nested -= 1 }
        if nested == 0 {
            if tokens.is(t, names.P_LT) { level += 1 }
            if tokens.is(t, names.P_GT) { level -= 1 }
            if tokens.is(t, names.P_SHR) { level -= 2 }
        }
        if tokens.is(t, names.P_SEMI) || (nested == 0 && tokens.is(t, names.P_LBRACE)) { return 0 }
        t = tokens.next(t)
        if level <= 0 { return t }
    }
    return 0
}

// ---------------------------------------------------------------------------
// Declarations

// ---------------------------------------------------------------------------
// Abbreviated function templates: `auto` parameters

// A token like `like` (its file and line) with the text and name given.
pub fn madeToken(like: usize, kind: u8, text: []const u8, name: u32) -> usize {
    const t = tokens.make(kind, @intCast(u32, tokens.at(like).*.file), tokens.at(like).*.line, base.keep(text), text.length)
    tokens.at(t).*.name = name
    tokens.at(t).*.flags = tokens.SPACE_BEFORE
    return t
}

// C++17 deduction guides: `Name(params) -> Result;` (with a template
// header, or `explicit`) is read as the declaration of a function
// `Result __mlxcc_guide_Name(params);`, made of copies of the guide's
// tokens; class template argument deduction calls it (cpp.deducedClass).
pub fn guideName(name: u32) -> u32 {
    return base.intern(base.join("__mlxcc_guide_", base.nameOf(name)))
}

// At the cursor: whether a deduction guide starts here.
pub fn guideAhead() -> bool {
    var t = cursor.peek()
    if tokens.isWord(t, names.K_EXPLICIT) { t = tokens.next(t) }
    if tokens.kind(t) != tokens.IDENT || !tokens.is(tokens.next(t), names.P_LPAREN) { return false }
    if !isClassTemplate(scope.findKind(tokens.name(t), scope.TEMPLATE)) { return false }
    const after = afterGroup(tokens.next(t))
    return after != 0 && tokens.is(after, names.P_ARROW)
}

// The guide at the cursor rewritten (see guideAhead): the first token
// of the function declaration made.
pub fn rewriteGuide() -> usize {
    var t = cursor.peek()
    if tokens.isWord(t, names.K_EXPLICIT) { t = tokens.next(t) }
    const nameToken = t
    const open = tokens.next(t)
    const arrow = afterGroup(open)
    // The result's tokens up to the `;`.
    var semi = tokens.next(arrow)
    while !tokens.isEof(semi) && !tokens.is(semi, names.P_SEMI) { semi = tokens.next(semi) }
    const name = guideName(tokens.name(nameToken))
    const named = madeToken(nameToken, tokens.IDENT, base.nameOf(name), name)
    // named ( params ) ;
    const params = copyRange(open, arrow)
    tokens.at(named).*.next = params
    var last = params
    while tokens.next(last) != arrow { last = tokens.next(last) }
    const end = madeToken(semi, tokens.PUNCT, ";", names.P_SEMI)
    tokens.at(last).*.next = end
    tokens.at(end).*.next = tokens.next(semi)
    // Result named ( params ) ;
    const result = copyRange(tokens.next(arrow), semi)
    var resultLast = result
    while tokens.next(resultLast) != semi { resultLast = tokens.next(resultLast) }
    tokens.at(resultLast).*.next = named
    return result
}

// The token after the balanced group opened at `open` (`(`, `[`, `{`).
fn afterGroup(open: usize) -> usize {
    var level: i64 = 0
    var t = open
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) {
            level -= 1
            if level == 0 { return tokens.next(t) }
        }
        t = tokens.next(t)
    }
    return t
}

// The `(` opening the parameters of the function the declaration at
// `start` declares; 0 when it declares none (a `;`, `{` or `=` first).
fn functionParameterList(start: usize) -> usize {
    var t = start
    var previous: usize = 0
    var angles: i64 = 0
    var count: usize = 0
    while !tokens.isEof(t) && count < 400 {
        count += 1
        if angles <= 0 && (tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE) || tokens.is(t, names.P_ASSIGN) || tokens.is(t, names.P_COLON)) { return 0 }
        if tokens.is(t, names.P_LT) { angles += 1 }
        if tokens.is(t, names.P_GT) { angles -= 1 }
        if tokens.is(t, names.P_SHR) { angles -= 2 }
        if tokens.is(t, names.P_LBRACKET) {
            previous = t
            t = afterGroup(t)
            continue
        }
        if tokens.is(t, names.P_LPAREN) {
            if angles <= 0 && previous != 0 && tokens.isWord(previous, names.K_OPERATOR) && tokens.is(tokens.next(t), names.P_RPAREN) {
                // `operator()(`: the name's parentheses.
                previous = tokens.next(t)
                t = tokens.next(previous)
                continue
            }
            if angles <= 0 && previous != 0 && (tokens.kind(previous) == tokens.IDENT || tokens.is(previous, names.P_GT)) { return t }
            previous = t
            t = afterGroup(t)
            continue
        }
        previous = t
        t = tokens.next(t)
    }
    return 0
}

// The `auto` of a parameter of the list opened at `open`, at its own
// level (not `decltype(auto)`); 0 for none.
fn autoParameterAhead(open: usize) -> bool {
    var t = tokens.next(open)
    var level: i64 = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) {
            if level == 0 { return false }
            level -= 1
        }
        if level == 0 && tokens.isWord(t, names.K_AUTO) && !tokens.is(tokens.next(t), names.P_LPAREN) { return true }
        t = tokens.next(t)
    }
    return false
}

// Copies of the tokens from `first` up to `end` (not included), the
// last copy followed by `end` itself: a rewrite of the copies leaves the
// tokens a template body is read again from as they were. The first
// copy; `end` when the range is empty.
fn copyRange(first: usize, end: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var t = first
    while t != end && !tokens.isEof(t) {
        const c = tokens.copy(t)
        if head == 0 { head = c } else { tokens.at(tail).*.next = c }
        tail = c
        t = tokens.next(t)
    }
    if head == 0 { return end }
    tokens.at(tail).*.next = end
    return head
}

// The token after the function declaration whose parameters open at
// `open`: past its `;`, or its body (a constructor's brace
// initializers passed over).
fn declarationEnd(open: usize) -> usize {
    var t = afterGroup(open)
    var previous: usize = 0
    var count: usize = 0
    while !tokens.isEof(t) && count < 100000 {
        count += 1
        if tokens.is(t, names.P_SEMI) { return tokens.next(t) }
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) {
            previous = t
            t = afterGroup(t)
            continue
        }
        if tokens.is(t, names.P_LBRACE) {
            if previous != 0 && (tokens.kind(previous) == tokens.IDENT || tokens.is(previous, names.P_GT)) {
                // `: value{ true }`: a member's brace initializer.
                previous = t
                t = afterGroup(t)
                continue
            }
            return afterGroup(t)
        }
        previous = t
        t = tokens.next(t)
    }
    return t
}

var inventedCount: u64 = 0

// Rewrites each `auto` parameter of the list opened at `open` (`auto
// &x`, `const C<A> auto &x`, `auto... xs`) to name an invented type
// parameter (its constraint dropped); the invented parameters' header
// tokens (`, typename A0, typename... A1`, the first comma included),
// as (first, last), (0, 0) for none.
fn rewriteAutoParameters(open: usize) -> (usize, usize) {
    // (Numbered per declaration: a member's declaration in its class and
    // its definition outside name them alike.)
    inventedCount = 0
    var first: usize = 0
    var last: usize = 0
    var segmentBefore = open
    var t = tokens.next(open)
    var level: i64 = 0
    var angles: i64 = 0
    // The token after which the parameter's constraint would start (the
    // `(` or `,` before it, or a cv-qualifier at its start).
    var beforeType = open
    var atStart = true
    while !tokens.isEof(t) {
        if level == 0 && angles <= 0 && (tokens.is(t, names.P_COMMA) || tokens.is(t, names.P_RPAREN)) {
            if tokens.is(t, names.P_RPAREN) { break }
            segmentBefore = t
            beforeType = t
            atStart = true
            t = tokens.next(t)
            continue
        }
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) { level -= 1 }
        if level == 0 && tokens.is(t, names.P_LT) { angles += 1 }
        if level == 0 && tokens.is(t, names.P_GT) { angles -= 1 }
        if level == 0 && tokens.is(t, names.P_SHR) { angles -= 2 }
        if atStart && level == 0 && (tokens.isWord(t, names.K_CONST) || tokens.isWord(t, names.K_VOLATILE)) {
            beforeType = t
            t = tokens.next(t)
            continue
        }
        atStart = false
        if level == 0 && angles <= 0 && tokens.isWord(t, names.K_AUTO) && !tokens.is(tokens.next(t), names.P_LPAREN) {
            // The constraint before it, if any (`const Dumpable auto &`),
            // goes to the invented parameter (`Dumpable __mlxcc_auto_1`).
            const constraintStart = tokens.next(beforeType)
            const constraint = if constraintStart != t { copyRange(constraintStart, t) } else { 0 }
            tokens.at(beforeType).*.next = t
            inventedCount += 1
            const name = base.intern(base.join("__mlxcc_auto_", base.decimal(inventedCount)))
            tokens.at(t).*.kind = tokens.IDENT
            tokens.at(t).*.name = name
            // A pack when `...` follows (after &, &&, *, const).
            var after = tokens.next(t)
            while tokens.is(after, names.P_AMP) || tokens.is(after, names.P_ANDAND) || tokens.is(after, names.P_STAR) || tokens.isWord(after, names.K_CONST) { after = tokens.next(after) }
            const isPack = tokens.is(after, names.P_ELLIPSIS)
            const comma = madeToken(t, tokens.PUNCT, ",", names.P_COMMA)
            var keyword = madeToken(t, tokens.KEYWORD, "typename", names.K_TYPENAME)
            const named = madeToken(t, tokens.IDENT, base.nameOf(name), name)
            if constraint != 0 {
                tokens.at(comma).*.next = constraint
                keyword = constraint
                while tokens.next(keyword) != t { keyword = tokens.next(keyword) }
            } else {
                tokens.at(comma).*.next = keyword
            }
            if isPack {
                const dots = madeToken(t, tokens.PUNCT, "...", names.P_ELLIPSIS)
                tokens.at(keyword).*.next = dots
                tokens.at(dots).*.next = named
            } else {
                tokens.at(keyword).*.next = named
            }
            if first == 0 { first = comma } else { tokens.at(last).*.next = comma }
            last = named
        }
        t = tokens.next(t)
    }
    return -> (first, last)
}

// `template <...>` at `header` declaring a function with `auto`
// parameters: a copy of the declaration with the invented parameters
// appended to its list (the token to read from), 0 for none.
fn abbreviateTemplate(header: usize) -> usize {
    const lt0 = tokens.next(header)
    if !tokens.is(lt0, names.P_LT) || tokens.is(tokens.next(lt0), names.P_GT) { return 0 }
    const after0 = endOfArguments(lt0)
    if after0 == 0 { return 0 }
    const open0 = functionParameterList(after0)
    if open0 == 0 || !autoParameterAhead(open0) { return 0 }
    const copied = copyRange(header, declarationEnd(open0))
    var lt = tokens.next(copied)
    var after = endOfArguments(lt)
    // `template <...> template <class R> R C<T>::map(auto &)`: the
    // innermost header gets the invented parameters.
    while tokens.isWord(after, names.K_TEMPLATE) && tokens.is(tokens.next(after), names.P_LT) {
        lt = tokens.next(after)
        after = endOfArguments(lt)
    }
    var gt = lt
    while tokens.next(gt) != after { gt = tokens.next(gt) }
    if tokens.is(gt, names.P_SHR) {
        // `template <class T, size_t N = stride<T>>`: the `>>` split, the
        // second `>` closing the header.
        const second = madeToken(gt, tokens.PUNCT, ">", names.P_GT)
        tokens.at(gt).*.name = names.P_GT
        tokens.at(gt).*.length = 1
        tokens.at(second).*.next = tokens.next(gt)
        tokens.at(gt).*.next = second
        gt = second
    }
    const open = functionParameterList(after)
    const ownerOfMember = if lt == tokens.next(copied) { memberOf(after) } else { 0 }
    const invented = rewriteAutoParameters(open)
    if invented.0 == 0 { return 0 }
    if ownerOfMember != 0 {
        // `template <class T> bool Vector<T>::containsIf(const C auto &)`
        // defined outside the class: the invented parameters are the
        // member template's own, `template <class T> template <C A>`.
        const keyword = madeToken(gt, tokens.KEYWORD, "template", names.K_TEMPLATE)
        const open2 = madeToken(gt, tokens.PUNCT, "<", names.P_LT)
        const close2 = madeToken(gt, tokens.PUNCT, ">", names.P_GT)
        tokens.at(keyword).*.next = open2
        tokens.at(open2).*.next = tokens.next(invented.0)
        tokens.at(invented.1).*.next = close2
        tokens.at(close2).*.next = after
        tokens.at(gt).*.next = keyword
        return copied
    }
    var previous = lt
    while tokens.next(previous) != gt { previous = tokens.next(previous) }
    tokens.at(previous).*.next = invented.0
    tokens.at(invented.1).*.next = gt
    return copied
}

// A declaration at `start` (no template header) of a function with
// `auto` parameters: a `template <...>` header made for it (the token
// to read from), 0 for none.
// A generic lambda's parameters opened at `open`: whether any is
// `auto`.
pub fn genericLambda(open: usize) -> bool { return autoParameterAhead(open) }

// The `>` closing the template arguments opened at `lt`.
fn endOfArgumentsBefore(lt: usize) -> usize {
    const after = endOfArguments(lt)
    var gt = lt
    while tokens.next(gt) != after { gt = tokens.next(gt) }
    return gt
}

// The generic lambda whose parameters open at `open`: its call operator
// as a member template's tokens, `template <invented> auto
// operator()(params) body`, read from the `template` returned (the
// lambda's own tokens after the parameters, `mutable` left out).
pub fn genericCallOperator(originalOpen: usize, originalLt: usize, end: usize) -> usize {
    // On copies: a lambda in a template is read again per instance.
    const copied = copyRange(if originalLt != 0 { originalLt } else { originalOpen }, end)
    var explicitLt: usize = 0
    var open = copied
    if originalLt != 0 {
        explicitLt = copied
        open = tokens.next(endOfArgumentsBefore(copied))
    }
    const invented = rewriteAutoParameters(open)
    const keyword = madeToken(open, tokens.KEYWORD, "template", names.K_TEMPLATE)
    const result = madeToken(open, tokens.KEYWORD, "auto", names.K_AUTO)
    const op = madeToken(open, tokens.KEYWORD, "operator", names.K_OPERATOR)
    const lp = madeToken(open, tokens.PUNCT, "(", names.P_LPAREN)
    const rp = madeToken(open, tokens.PUNCT, ")", names.P_RPAREN)
    if explicitLt != 0 {
        // `[]<class T>(T x, auto y)`: its own parameters, then the
        // invented ones.
        var gt = explicitLt
        while tokens.next(gt) != open { gt = tokens.next(gt) }
        tokens.at(keyword).*.next = explicitLt
        if invented.0 != 0 {
            var previous = explicitLt
            while tokens.next(previous) != gt { previous = tokens.next(previous) }
            tokens.at(previous).*.next = invented.0
            tokens.at(invented.1).*.next = gt
        }
        tokens.at(gt).*.next = result
    } else {
        const lt = madeToken(open, tokens.PUNCT, "<", names.P_LT)
        const gt = madeToken(open, tokens.PUNCT, ">", names.P_GT)
        tokens.at(keyword).*.next = lt
        tokens.at(lt).*.next = tokens.next(invented.0)
        tokens.at(invented.1).*.next = gt
        tokens.at(gt).*.next = result
    }
    tokens.at(result).*.next = op
    tokens.at(op).*.next = lp
    tokens.at(lp).*.next = rp
    tokens.at(rp).*.next = open
    // `mutable` after the parameters is nothing here.
    const close = afterGroup(open)
    var before = close
    var t = close
    var count: usize = 0
    var isMutable = false
    while !tokens.isEof(t) && !tokens.is(t, names.P_LBRACE) && count < 64 {
        if tokens.isWord(t, names.K_MUTABLE) {
            isMutable = true
            var previous = open
            while tokens.next(previous) != t { previous = tokens.next(previous) }
            tokens.at(previous).*.next = tokens.next(t)
        }
        t = tokens.next(t)
        count += 1
    }
    // A lambda's call operator is const unless the lambda is `mutable`.
    if !isMutable && close != 0 {
        var closing = open
        while tokens.next(closing) != close { closing = tokens.next(closing) }
        const constant = madeToken(open, tokens.KEYWORD, "const", names.K_CONST)
        tokens.at(constant).*.next = close
        tokens.at(closing).*.next = constant
    }
    return keyword
}

var abbreviated: usize = 0
pub fn lastAbbreviatedHeader() -> usize { return abbreviated }

pub fn abbreviatedHeader(original: usize) -> usize {
    abbreviated = 0
    const open0 = functionParameterList(original)
    if open0 == 0 || !autoParameterAhead(open0) { return 0 }
    const start = copyRange(original, declarationEnd(open0))
    const open = functionParameterList(start)
    const invented = rewriteAutoParameters(open)
    if invented.0 == 0 { return 0 }
    const keyword = madeToken(start, tokens.KEYWORD, "template", names.K_TEMPLATE)
    const lt = madeToken(start, tokens.PUNCT, "<", names.P_LT)
    const gt = madeToken(start, tokens.PUNCT, ">", names.P_GT)
    tokens.at(keyword).*.next = lt
    // The invented list without its first comma.
    tokens.at(lt).*.next = tokens.next(invented.0)
    tokens.at(invented.1).*.next = gt
    tokens.at(gt).*.next = start
    abbreviated = keyword
    return keyword
}

// `template <...> declaration`, at `template`.
// `template class X<A>;` (after `template`): the instance made and all
// its member functions defined (other files' `extern template` use
// them); `template R f<A>(...);`: the function's instance defined.
fn explicitInstantiation() -> void {
    if cursor.is(names.K_CLASS) || cursor.is(names.K_STRUCT) || cursor.is(names.K_UNION) {
        cursor.advance()
        const ty = decl.typeName()
        cursor.expect(names.P_SEMI)
        cpp.completeIfNeeded(ty)
        cpp.defineAllMethods(ty)
        return
    }
    // (A function's: its instance is made where it is called.)
    while !cursor.is(names.P_SEMI) && !cursor.isEof() { cursor.advance() }
    cursor.expect(names.P_SEMI)
}

pub fn declaration() -> void {
    const abbreviatedCopy = abbreviateTemplate(cursor.peek())
    if abbreviatedCopy != 0 { cursor.restore(abbreviatedCopy) }
    const header = cursor.peek()
    cursor.expect(names.K_TEMPLATE)
    if !cursor.is(names.P_LT) {
        explicitInstantiation()
        return
    }
    if cursor.is(names.P_LT) && cursor.isToken(cursor.peekNext(), names.P_GT) {
        cursor.advance()
        cursor.advance()
        specialization()
        return
    }
    const t = base.alloc(@sizeOf(Template))
    at(t).*.namespace = scope.currentNamespace()
    parameters(t)
    if cursor.is(names.K_REQUIRES) {
        // `template <class T> requires C<T> ...`: the constraint.
        cursor.advance()
        requiresClause(t)
    }
    // `[[nodiscard]]` before the declaration.
    decl.stdAttributes()
    // `template <class T> X(T *) -> X<T>;`: a deduction guide, as a
    // function template.
    if guideAhead() { cursor.restore(rewriteGuide()) }
    at(t).*.start = cursor.save()
    if cursor.consume(names.K_CONCEPT) {
        // `concept C = expr;`: a bool per set of arguments.
        at(t).*.isConcept = true
        at(t).*.isVariable = true
        at(t).*.name = tokens.name(cursor.expectIdent())
        cursor.expect(names.P_ASSIGN)
        at(t).*.start = cursor.save()
        // To its `;` (requires expressions and lambdas hold braces).
        var depth: i64 = 0
        while !cursor.isEof() {
            if depth == 0 && cursor.is(names.P_SEMI) { break }
            if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) || cursor.is(names.P_LBRACE) { depth += 1 }
            if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) || cursor.is(names.P_RBRACE) { depth -= 1 }
            cursor.advance()
        }
        cursor.expect(names.P_SEMI)
        const bound = scope.bindTemplate(at(t).*.name, t)
        return
    }
    if cursor.is(names.K_CLASS) || cursor.is(names.K_STRUCT) {
        classTemplate(t, header)
        return
    }
    if cursor.consume(names.K_USING) {
        // An alias template: an instance is the type it names.
        at(t).*.isClass = true
        at(t).*.isAlias = true
        at(t).*.name = tokens.name(cursor.expectIdent())
        cursor.expect(names.P_ASSIGN)
        at(t).*.start = cursor.save()
        skipDeclaration()
        // Declared again (`AtomicObjectIdentifier` in Forward.h with its
        // default, then in ObjectIdentifier.h without): the defaults
        // given before kept.
        const known = scope.findHere(at(t).*.name)
        if known != 0 && scope.at(known).*.kind == scope.TEMPLATE && at(scope.at(known).*.obj).*.isAlias {
            var before = at(scope.at(known).*.obj).*.params
            var again = at(t).*.params
            while before != 0 && again != 0 {
                if base.getWord(again + 32) == 0 && base.getWord(before + 32) != 0 {
                    base.putWord(again + 32, base.getWord(before + 32))
                    base.putWord(again + 64, base.getWord(before + 64))
                }
                before = base.getWord(before + 24)
                again = base.getWord(again + 24)
            }
        }
        const bound = scope.bindTemplate(at(t).*.name, t)
        return
    }
    if cursor.is(names.K_TEMPLATE) {
        // `template <class T> template <class U> R C<T>::f(U)`: a member
        // template of a class template defined outside it, read per
        // instance of the class (the inner header then defines the
        // instance's member template).
        const inner = tokens.next(cursor.peek())
        const declarationStart = if tokens.is(inner, names.P_LT) { endOfArguments(inner) } else { 0 }
        const owner = if declarationStart != 0 { memberOf(declarationStart) } else { 0 }
        if owner == 0 { cursor.fail("a template of a template is supported for a class template's member only") }
        const c = base.alloc(16)
        base.putWord(c, header)
        const partialOwner = partialDefined(owner, t, declarationStart)
        const holder = if partialOwner != 0 { partialOwner } else { owner }
        if at(holder).*.memberDefs == 0 { at(holder).*.memberDefs = c } else { base.putWord(at(holder).*.memberDefsTail + 8, c) }
        at(holder).*.memberDefsTail = c
        cursor.restore(declarationStart)
        skipDeclaration()
        const after = cursor.save()
        if partialOwner == 0 { applyToEarlierInstances(owner, c) }
        cursor.restore(after)
        return
    }
    // A member template of a plain class defined outside it
    // (`R Class::f(...)`): the template declared in the class gets the
    // definition's tokens.
    const member = memberTemplateDefined(at(t).*.start, t)
    if member != 0 {
        at(member).*.start = if at(member).*.isConstructor { inClassConstructor(at(t).*.start) } else { at(t).*.start }
        at(member).*.definedOutside = true
        // (The declaration's defaults hold for the definition:
        // `typename Converter = DefaultConverter`.)
        mergeDefaults(at(member).*.params, at(t).*.params)
        at(member).*.params = at(t).*.params
        at(member).*.paramCount = at(t).*.paramCount
        at(member).*.outerParams = memberDefParams
        at(member).*.outerArgs = memberDefArgs
        // (The definition's constraint, written over its own parameters'
        // names: `T &&key` for the declaration's `auto &&key`.)
        if at(t).*.constraint != 0 { at(member).*.constraint = at(t).*.constraint }
        skipDeclaration()
        defineWaiting(member)
        return
    }
    // A variable template: `template <class T> constexpr bool v = ...;`
    // (an `=` or `;` before any parenthesis).
    if startsVariable(at(t).*.start) {
        at(t).*.isVariable = true
        at(t).*.name = variableName(at(t).*.start)
        // `template <class T> constexpr bool v<T, void_t<...>> = true;`:
        // a partial specialization of the variable template v.
        const nameAt = variableNameAt(at(t).*.start, at(t).*.name)
        const primary = scope.findKind(at(t).*.name, scope.TEMPLATE)
        if nameAt != 0 && tokens.is(tokens.next(nameAt), names.P_LT) && isVariableTemplate(primary) {
            variablePartial(scope.at(primary).*.obj, t, nameAt)
            return
        }
        skipDeclaration()
        const bound = scope.bindTemplate(at(t).*.name, t)
        return
    }
    // A member of a class template defined outside it (`R vector<T>::f`),
    // else a function template.
    const owner = memberOf(at(t).*.start)
    if owner != 0 {
        const c = base.alloc(16)
        base.putWord(c, header)
        // (`R C<T, Unknown>::f()`: a member of the partial specialization
        // the arguments are written as.)
        const partialOwner = partialDefined(owner, t, at(t).*.start)
        const holder = if partialOwner != 0 { partialOwner } else { owner }
        if at(holder).*.memberDefs == 0 { at(holder).*.memberDefs = c } else { base.putWord(at(holder).*.memberDefsTail + 8, c) }
        at(holder).*.memberDefsTail = c
        skipDeclaration()
        return
    }
    functionTemplate(t)
}

// `template <>` and the declaration of one instance: a class
// `struct X<args> { ... };` read as that instance, or a function
// `R f<args>(params) { ... }` or `R f(params) { ... }` (the arguments
// deduced from the parameters) defined as that instance.
fn specialization() -> void {
    if cursor.is(names.K_TEMPLATE) {
        // `template <> template <bool B> R Lexer<char16_t>::f(...)`: the
        // member template of that one instance, defined (its own
        // definition, not the template's).
        declaration()
        return
    }
    if cursor.is(names.K_CLASS) || cursor.is(names.K_STRUCT) {
        const keyword = cursor.peek()
        cursor.advance()
        // (`template <> struct JS_EXPORT_PRIVATE BindingTraits<X>`: the
        // attributes passed over.)
        decl.stdAttributes()
        const attributesRead = decl.attributes()
        decl.stdAttributes()
        // (`template <> struct Encoder::Salt<bool>`: a member template of
        // a class, named by it.)
        var qualifiedBy: u32 = 0
        var isQualified = false
        if decl.startsQualified() {
            const read = decl.qualifier()
            qualifiedBy = read.0
            isQualified = read.1
        }
        const tag = cursor.expectIdent()
        const binding = if isQualified { scope.findQualified(qualifiedBy, tokens.name(tag), false) } else { scope.findKind(tokens.name(tag), scope.TEMPLATE) }
        if !isClassTemplate(binding) { tokens.errorAt(tag, "not a class template") }
        const t = scope.at(binding).*.obj
        const read = parseArguments(t)
        const key = instanceKey(t, read.0)
        const known = cached(t, key)
        if known != 0 && !types.at(known).*.incomplete { tokens.errorAt(tag, "the instance exists already") }
        // The class, read as the instance named by the key (a declared
        // one, `template <> struct X<A>;`, is completed in place).
        const context = beginInstance()
        scope.enterPrefix(at(t).*.namespace)
        const prefix = scope.qualify(at(t).*.namespace, key)
        bindParameters(at(t).*.params, read.0, prefix)
        tagOverride = key
        // The tag's tokens: the keyword, the tag, then the arguments,
        // which the class reader must not see: copies of the keyword and
        // the tag lead to the body.
        const tagCopy = tokens.copy(tag)
        tokens.at(tagCopy).*.next = endOfArguments(tokens.next(tag))
        const keywordCopy = tokens.copy(keyword)
        tokens.at(keywordCopy).*.next = tagCopy
        cursor.restore(keywordCopy)
        const attr = decl.newAttr()
        const ty = decl.declspec(attr)
        tagOverride = 0
        cursor.expect(names.P_SEMI)
        cache(t, key, ty)
        // (An instance of the template as any: `tuple<>` matches
        // `tuple<B...>`.)
        cpp.setTemplateOrigin(ty, t, read.0)
        // Declared only: its definition comes later, the template does not
        // make it meanwhile (complete).
        if types.at(ty).*.incomplete {
            const c = base.alloc(16)
            base.putWord(c, ty)
            base.putWord(c + 8, declaredSpecializations)
            declaredSpecializations = c
        }
        scope.leaveNamespace()
        const end = cursor.save()
        endInstance(context)
        cursor.restore(end)
        return
    }
    // A variable template's instance: `template <> constexpr int v<int> = 1;`
    if startsVariable(cursor.save()) {
        variableSpecialization()
        return
    }
    // A function: its signature says which template and arguments.
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    const start = cursor.save()
    // The name, past the pointers and references before it; its
    // `<args>`, if any, read now and taken out of the declarator's way.
    var nameToken = cursor.peek()
    while tokens.is(nameToken, names.P_STAR) || tokens.is(nameToken, names.P_AMP) || tokens.isWord(nameToken, names.K_CONST) { nameToken = tokens.next(nameToken) }
    if tokens.kind(nameToken) != tokens.IDENT { cursor.fail("expected a function specialization") }
    // `template <> R C<X>::f(...)`: a member of one instance of a class
    // template, defined for it as any member is out of its class.
    var prefix: u32 = 0
    var qualified = false
    if tokens.is(tokens.next(nameToken), names.P_LT) && isClassTemplate(scope.findKind(tokens.name(nameToken), scope.TEMPLATE)) && tokens.is(endOfArguments(tokens.next(nameToken)), names.P_SCOPE) {
        // `template <> template <> R C<X>::f(...)`: a member template f
        // of the instance C<X>, specialized (as `template <> R C::f`).
        const member = tokens.next(endOfArguments(tokens.next(nameToken)))
        var instanceMember = false
        if tokens.kind(member) == tokens.IDENT && tokens.is(tokens.next(member), names.P_LPAREN) {
            const saved = cursor.save()
            cursor.restore(nameToken)
            const classTy = classTypeHere(scope.findKind(tokens.name(nameToken), scope.TEMPLATE))
            cursor.restore(saved)
            if cpp.isClassType(classTy) {
                const completed = cpp.completeIfNeeded(classTy)
                const found = scope.findQualified(types.at(classTy).*.name, tokens.name(member), false)
                var b = found
                while b != 0 && !isFunctionTemplate(b) && scope.at(b).*.name == scope.at(found).*.name && scope.at(b).*.depth == scope.at(found).*.depth { b = scope.at(b).*.hidden }
                if b != 0 && isFunctionTemplate(b) {
                    prefix = types.at(classTy).*.name
                    qualified = true
                    nameToken = member
                    instanceMember = true
                }
            }
        }
        if !instanceMember {
            cursor.restore(start)
            decl.globalDeclaration(baseType, attr)
            return
        }
    }
    // `template <> R C::f<X>(...)`: a member template of the class C
    // (or a function template of the namespace).
    while tokens.kind(nameToken) == tokens.IDENT && tokens.is(tokens.next(nameToken), names.P_SCOPE) && tokens.kind(tokens.next(tokens.next(nameToken))) == tokens.IDENT {
        const outer = if qualified { scope.findQualified(prefix, tokens.name(nameToken), false) } else { scope.findKind(tokens.name(nameToken), scope.NAMESPACE) }
        if outer == 0 || scope.at(outer).*.kind != scope.NAMESPACE { tokens.errorAt(nameToken, "not a namespace or class") }
        prefix = @intCast(u32, scope.at(outer).*.value)
        qualified = true
        nameToken = tokens.next(tokens.next(nameToken))
    }
    const name = tokens.name(nameToken)
    var binding = if qualified { scope.findQualified(prefix, name, false) } else { scope.findKind(name, scope.TEMPLATE) }
    if qualified && tokens.is(tokens.next(nameToken), names.P_LT) && isClassTemplate(binding) && tokens.is(endOfArguments(tokens.next(nameToken)), names.P_SCOPE) {
        // `template <> void C::Builder<X>::expand();`: a member of an
        // instance of a member class template, declared for it (its
        // definition is another file's); defined here, as any member is.
        var t = cursor.peek()
        var depth: i64 = 0
        while !tokens.isEof(t) && !(depth == 0 && (tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE))) {
            if tokens.is(t, names.P_LPAREN) { depth += 1 }
            if tokens.is(t, names.P_RPAREN) { depth -= 1 }
            t = tokens.next(t)
        }
        if tokens.is(t, names.P_SEMI) {
            cursor.restore(tokens.next(t))
            return
        }
        cursor.restore(start)
        decl.globalDeclaration(baseType, attr)
        return
    }
    if qualified {
        // (Past the plain functions of the name.)
        var b = binding
        while b != 0 && !isFunctionTemplate(b) && scope.at(b).*.name == scope.at(binding).*.name && scope.at(b).*.depth == scope.at(binding).*.depth { b = scope.at(b).*.hidden }
        if b != 0 { binding = b }
    }
    if !isFunctionTemplate(binding) { tokens.errorAt(nameToken, "not a function template") }
    var t = scope.at(binding).*.obj
    var args: usize = 0
    if tokens.is(tokens.next(nameToken), names.P_LT) {
        cursor.restore(tokens.next(nameToken))
        const read = parseArguments(t)
        args = read.0
        tokens.at(nameToken).*.next = cursor.peek()
        cursor.restore(start)
    }
    const found = decl.declarator(baseType)
    if found.1 == 0 || types.kind(found.0) != types.FUNC { cursor.fail("expected a function specialization") }
    if args != 0 && at(t).*.next != 0 {
        // (Arguments given, templates of the name overloaded:
        // `argumentPointer<1>(mcontext_t &)` beside `argumentPointer<1>(
        // PlatformRegisters &)`: the one whose parameters fit.)
        var candidate = t
        while candidate != 0 {
            const bindings = base.alloc(at(candidate).*.paramCount * 8 + 8)
            var fits = at(candidate).*.pattern != 0
            var p = if fits { types.at(at(candidate).*.pattern).*.params } else { 0 }
            var q = types.at(found.0).*.params
            while p != 0 && q != 0 && fits {
                fits = deduceDeclared(types.param(p).*.ty, types.param(q).*.ty, bindings)
                // (A parameter naming no template parameter: its type.)
                if fits && !dependentType(types.param(p).*.ty) { fits = types.sameType(types.param(p).*.ty, types.param(q).*.ty) }
                p = types.param(p).*.next
                q = types.param(q).*.next
            }
            if p != 0 || q != 0 { fits = false }
            if fits {
                t = candidate
                break
            }
            candidate = at(candidate).*.next
        }
    }
    // The arguments not given are deduced from the parameters (the
    // first template whose pattern fits).
    if args == 0 {
        while t != 0 {
            const bindings = base.alloc(at(t).*.paramCount * 8 + 8)
            var fits = true
            var p = types.at(at(t).*.pattern).*.params
            var q = types.at(found.0).*.params
            while p != 0 && q != 0 && fits {
                fits = deduceDeclared(types.param(p).*.ty, types.param(q).*.ty, bindings)
                p = types.param(p).*.next
                q = types.param(q).*.next
            }
            if p != 0 || q != 0 { fits = false }
            // (A parameter only the result names: `template <> float
            // minimum()` of `template <class T> T minimum()`.)
            if fits { const fromResult = deduce(types.baseOf(at(t).*.pattern), types.baseOf(found.0), bindings, false) }
            var index: usize = 0
            while fits && index < at(t).*.paramCount {
                if base.getWord(bindings + index * 8) == 0 { fits = false }
                index += 1
            }
            if fits {
                args = boundArguments(t, bindings)
                break
            }
            t = at(t).*.next
        }
        if t == 0 { tokens.errorAt(found.1, "no function template matches the specialization") }
    }
    const key = instanceKey(t, args)
    const known = cached(t, key)
    if interp.trace { tokens.warnAt(found.1, base.join("explicit specialization ", base.nameOf(key))) }
    if known != 0 && ast.obj(known).*.isFunction && !ast.obj(known).*.isDefinition {
        // Declared before (`template <> uint8_t f<uint8_t>();` in a
        // header): this one defines it, by its parameters' names.
        if !cursor.is(names.P_LBRACE) {
            cursor.expect(names.P_SEMI)
            return
        }
        if at(t).*.owner == 0 || ast.obj(known).*.isStaticMember { ast.obj(known).*.ty = found.0 } else { ast.obj(known).*.ty = cpp.withThisPublic(at(t).*.owner, found.0) }
        if inlineSpecialization(attr) {
            ast.obj(known).*.isInline = true
            ast.obj(known).*.isWeak = true
        }
        decl.defineFunction(known, at(t).*.owner)
        return
    }
    if known != 0 { tokens.errorAt(found.1, "the instance exists already") }
    const o = ast.newObj(name, found.0, found.1)
    const obj = ast.obj(o)
    obj.*.isFunction = true
    obj.*.isReferenced = true
    obj.*.linkName = mangle.templateFunctionSymbol(at(t).*.namespace, name, argumentCodes(args), found.0)
    obj.*.symbol = obj.*.linkName
    // (An inline or constexpr one, in a header, is defined in every file
    // that includes it: weak.)
    if inlineSpecialization(attr) {
        obj.*.isInline = true
        obj.*.isWeak = true
    }
    if at(t).*.owner != 0 {
        // A member template's specialization is a member function.
        obj.*.classType = at(t).*.owner
        obj.*.isStaticMember = decl.attrAt(attr).*.isStatic || at(t).*.isStaticMember
        if !obj.*.isStaticMember { obj.*.ty = cpp.withThisPublic(at(t).*.owner, found.0) }
    }
    state.addGlobal(o)
    cache(t, key, o)
    if cursor.is(names.P_LBRACE) {
        decl.defineFunction(o, at(t).*.owner)
    } else {
        cursor.expect(names.P_SEMI)
    }
}

// Whether an explicit specialization is declared inline (or constexpr).
fn inlineSpecialization(attr: usize) -> bool {
    if attr == 0 { return false }
    return decl.attrAt(attr).*.isInline || decl.attrAt(attr).*.isConstexpr
}

// The parameter list `<typename T, int N>`.
// Whether the identifier at the cursor names a concept (a constrained
// parameter follows: `template <Concept U>`).
fn isConceptName() -> bool {
    var binding: usize = 0
    if decl.startsQualified() {
        // `std::integral T`: looked up without moving on.
        const start = cursor.save()
        const read = decl.qualifier()
        if cursor.isIdent() { binding = scope.findQualified(read.0, tokens.name(cursor.peek()), false) }
        cursor.restore(start)
    } else if cursor.isIdent() {
        binding = scope.findKind(tokens.name(cursor.peek()), scope.TEMPLATE)
    }
    return binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE && at(scope.at(binding).*.obj).*.isConcept
}

// Passes over a name, qualified or not (`::`, `std::integral`).
fn skipQualifiedName() -> void {
    while true {
        if cursor.is(names.P_SCOPE) {
            cursor.advance()
            continue
        }
        if !cursor.isIdent() { return }
        cursor.advance()
        if !cursor.is(names.P_SCOPE) { return }
    }
}

// `Concept<Param>` as a token list (ending in EOF): the concept token
// copied (with its own arguments, if any, before `Param`).
fn constraintTokens(conceptToken: usize, param: u32) -> usize {
    // The name's tokens (`std`, `::`, `integral`) copied.
    const head = tokens.copy(conceptToken)
    var tail = head
    var at = tokens.next(conceptToken)
    while tokens.is(tail, names.P_SCOPE) || tokens.is(at, names.P_SCOPE) {
        const copy = tokens.copy(at)
        tokens.at(tail).*.next = copy
        tail = copy
        at = tokens.next(at)
    }
    const lt = tokens.copy(conceptToken)
    tokens.at(lt).*.name = names.P_LT
    tokens.at(lt).*.length = 1
    tokens.at(lt).*.kind = tokens.PUNCT
    tokens.at(tail).*.next = lt
    tail = lt
    const paramToken = tokens.copy(conceptToken)
    tokens.at(paramToken).*.name = param
    tokens.at(paramToken).*.kind = tokens.IDENT
    if tokens.is(at, names.P_LT) {
        // `Concept<A, B> U` is `Concept<U, A, B>`.
        const after = endOfArguments(at)
        var inner = tokens.next(at)
        tokens.at(tail).*.next = paramToken
        tail = paramToken
        // (`Concept<> U` is `Concept<U>`: no comma.)
        if !tokens.is(inner, names.P_GT) {
            const comma = tokens.copy(conceptToken)
            tokens.at(comma).*.name = names.P_COMMA
            tokens.at(comma).*.length = 1
            tokens.at(comma).*.kind = tokens.PUNCT
            tokens.at(tail).*.next = comma
            tail = comma
        }
        while inner != after {
            const copy = tokens.copy(inner)
            tokens.at(tail).*.next = copy
            tail = copy
            inner = tokens.next(inner)
        }
        // The copied `>` ends it (the last copied token is the `>`).
        tokens.at(tail).*.next = tokens.eof(@intCast(u32, tokens.at(conceptToken).*.file), tokens.at(conceptToken).*.line)
        return head
    }
    tokens.at(tail).*.next = paramToken
    tail = paramToken
    const gt = tokens.copy(conceptToken)
    tokens.at(gt).*.name = names.P_GT
    tokens.at(gt).*.length = 1
    tokens.at(gt).*.kind = tokens.PUNCT
    tokens.at(tail).*.next = gt
    tokens.at(gt).*.next = tokens.eof(@intCast(u32, tokens.at(conceptToken).*.file), tokens.at(conceptToken).*.line)
    return head
}

// The requires clause at the cursor, the template `t`'s constraint;
// after constrained parameters' (`template <std::integral C> requires
// (sizeof(C) == 2)`), both, the clause's tokens copied in parentheses.
fn requiresClause(t: usize) -> void {
    const start = cursor.save()
    skipConstraint()
    if at(t).*.constraint == 0 {
        at(t).*.constraint = start
        return
    }
    const end = cursor.save()
    const open = tokens.copy(start)
    tokens.at(open).*.name = names.P_LPAREN
    tokens.at(open).*.length = 1
    tokens.at(open).*.kind = tokens.PUNCT
    var tail = open
    var walk = start
    while walk != end && !tokens.isEof(walk) {
        const copy = tokens.copy(walk)
        tokens.at(tail).*.next = copy
        tail = copy
        walk = tokens.next(walk)
    }
    const close = tokens.copy(start)
    tokens.at(close).*.name = names.P_RPAREN
    tokens.at(close).*.length = 1
    tokens.at(close).*.kind = tokens.PUNCT
    tokens.at(tail).*.next = close
    tokens.at(close).*.next = tokens.eof(@intCast(u32, tokens.at(start).*.file), tokens.at(start).*.line)
    at(t).*.constraint = joinConstraints(at(t).*.constraint, open)
}

// `a && b` as a token list from the lists `a` (ending in EOF) and `b`.
fn joinConstraints(a: usize, b: usize) -> usize {
    var tail = a
    while !tokens.isEof(tokens.next(tail)) { tail = tokens.next(tail) }
    const op = tokens.copy(tail)
    tokens.at(op).*.name = names.P_ANDAND
    tokens.at(op).*.length = 2
    tokens.at(op).*.kind = tokens.PUNCT
    tokens.at(tail).*.next = op
    tokens.at(op).*.next = b
    return a
}

// The name a function pointer parameter's declarator gave.
var declaratorName: u32 = 0

pub fn isFunctionPointer(ty: usize) -> bool {
    return ty != 0 && types.kind(ty) == types.PTR && types.kind(types.baseOf(ty)) == types.FUNC
}

fn parameters(t: usize) -> void {
    cursor.expect(names.P_LT)
    var tail: usize = 0
    var constrained: usize = 0
    // The parameters before one may name its type (`typename Key, Key v`).
    scope.enter()
    var index: i64 = 0
    while !cursor.consume(names.P_GT) {
        if at(t).*.paramCount > 0 { cursor.expect(names.P_COMMA) }
        // (+48: the parameter's first token, +56: the token after its
        // name, +64: the token after its default: implicitGuides.)
        const c = base.alloc(72)
        base.putWord(c + 48, cursor.save())
        var isType = false
        var ty: usize = 0
        var isTemplate = false
        // (`typename std::underlying_type<E>::type constant`: a value of
        // a dependent type, not a type parameter.)
        const typenameQualified = cursor.is(names.K_TYPENAME) && (tokens.is(cursor.peekNext(), names.P_SCOPE) || (tokens.kind(cursor.peekNext()) == tokens.IDENT && (tokens.is(tokens.next(cursor.peekNext()), names.P_SCOPE) || tokens.is(tokens.next(cursor.peekNext()), names.P_LT))))
        if !typenameQualified && (cursor.consume(names.K_TYPENAME) || cursor.consume(names.K_CLASS)) {
            isType = true
        } else if cursor.is(names.K_TEMPLATE) {
            // `template <class...> class B`: a template template
            // parameter (its own parameters are not checked).
            cursor.advance()
            cursor.expect(names.P_LT)
            var level: i64 = 1
            while level > 0 {
                if cursor.isEof() { cursor.fail("unterminated template template parameter") }
                if cursor.is(names.P_LT) { level += 1 }
                if cursor.is(names.P_GT) { level -= 1 }
                if cursor.is(names.P_SHR) { level -= 2 }
                cursor.advance()
            }
            if !cursor.consume(names.K_CLASS) && !cursor.consume(names.K_TYPENAME) { cursor.fail("expected class after the template template parameter's parameters") }
            isType = true
            isTemplate = true
        } else if (cursor.isIdent() || cursor.is(names.P_SCOPE)) && isConceptName() {
            // `template <SmartPtr U>`: a type parameter constrained by
            // the concept: `requires SmartPtr<U>`, kept as such.
            const conceptToken = cursor.peek()
            skipQualifiedName()
            if cursor.is(names.P_LT) {
                const after = endOfArguments(cursor.peek())
                if after == 0 { cursor.fail("unterminated template arguments") }
                cursor.restore(after)
            }
            isType = true
            constrained = conceptToken
        } else {
            // (Its type may name the parameters before it: `enable_if_t<
            // !is_same<Decayed, X>::value, int> = 0`, read as a pattern.)
            patternDepth += 1
            ty = decl.declspec(0)
            patternDepth -= 1
            if cursor.is(names.P_LPAREN) || cursor.is(names.P_STAR) || (cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_LPAREN)) {
                // `void (*f)(T *)`, `void (f)(T *)`, `bool f(char16_t)`: a pointer to a
                // function (its argument is the function).
                const found = decl.declarator(ty)
                ty = found.0
                if types.kind(ty) == types.FUNC { ty = types.pointerTo(ty) }
                if found.1 != 0 { declaratorName = tokens.name(found.1) }
            }
            // (A class type, C++20's structural `template <Options o>`:
            // declared; an instance needs its argument folded, which is
            // not supported.)
            if !types.isInteger(ty) && types.kind(ty) != types.TPARAM && !isFunctionPointer(ty) && !typenameQualified && !cpp.isClassType(ty) { cursor.fail("a non-type template parameter must be an integer") }
        }
        // `typename... Args`: a parameter pack.
        if cursor.consume(names.P_ELLIPSIS) { base.putWord(c + 40, 1) }
        // `template <typename> struct X;`: a parameter without a name.
        var name: u32 = 0
        if declaratorName != 0 {
            name = declaratorName
            declaratorName = 0
        } else if cursor.isIdent() {
            name = tokens.name(cursor.peek())
            cursor.advance()
        } else {
            unnamedCount += 1
            name = base.intern(base.join("__unnamed", base.decimal(@intCast(u64, unnamedCount))))
        }
        base.putWord(c, @intCast(usize, name))
        base.putWord(c + 56, cursor.save())
        if constrained != 0 {
            // The constraint `Concept<Param>` as tokens of their own,
            // joined with any requires clause by &&.
            const made = constraintTokens(constrained, name)
            if at(t).*.constraint == 0 { at(t).*.constraint = made } else { at(t).*.constraint = joinConstraints(at(t).*.constraint, made) }
            constrained = 0
        }
        if isTemplate {
            base.putWord(c + 8, 2)
            const bound = scope.bindTemplate(name, placeholderTemplate(name, index))
        } else if isType {
            base.putWord(c + 8, 1)
            const bound = scope.bindTypedef(name, if base.getWord(c + 40) != 0 { types.packParameter(index) } else { types.templateParameter(index) })
        } else {
            base.putWord(c + 16, ty)
        }
        index += 1
        if cursor.consume(names.P_ASSIGN) {
            // A default argument: its tokens, read when it is needed.
            base.putWord(c + 32, cursor.save())
            var level: i64 = 0
            // Parentheses hold commas and comparisons of their own
            // (`class = decltype(a, b < c)`).
            var parens: i64 = 0
            while true {
                if cursor.isEof() { cursor.fail("unterminated template parameter list") }
                if parens == 0 && cursor.is(names.P_SHR) && level <= 1 { splitShr() }
                if parens == 0 && level == 0 && (cursor.is(names.P_COMMA) || cursor.is(names.P_GT)) { break }
                if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) { parens += 1 }
                if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) { parens -= 1 }
                if parens == 0 && cursor.is(names.P_LT) { level += 1 }
                if parens == 0 && cursor.is(names.P_GT) { level -= 1 }
                if parens == 0 && cursor.is(names.P_SHR) { level -= 2 }
                cursor.advance()
            }
            base.putWord(c + 64, cursor.save())
        }
        if at(t).*.params == 0 { at(t).*.params = c } else { base.putWord(tail + 24, c) }
        tail = c
        at(t).*.paramCount += 1
    }
    scope.leave()
}

// The placeholder standing for the template template parameter `name`
// (the `index`th parameter): a class template taking any arguments,
// whose "instances" are patterns (classTypeHere) deduced against the
// instances of real templates.
fn placeholderTemplate(name: u32, index: i64) -> usize {
    const t = base.alloc(@sizeOf(Template))
    at(t).*.isClass = true
    at(t).*.name = name
    at(t).*.standsFor = index + 1
    at(t).*.namespace = scope.currentNamespace()
    const c = base.alloc(48)
    base.putWord(c, @intCast(usize, base.intern("__arguments")))
    base.putWord(c + 8, 1)
    base.putWord(c + 40, 1)
    at(t).*.params = c
    at(t).*.paramCount = 1
    return t
}

// Binds the parameters of `t` as placeholders (a pattern's reading).
fn bindPlaceholders(t: usize) -> void {
    var p = at(t).*.params
    var index: i64 = 0
    while p != 0 {
        const name = @intCast(u32, base.getWord(p))
        if base.getWord(p + 8) == 2 {
            const bound = scope.bindTemplate(name, placeholderTemplate(name, index))
        } else if base.getWord(p + 8) != 0 {
            const bound = scope.bindTypedef(name, if base.getWord(p + 40) != 0 { types.packParameter(index) } else { types.templateParameter(index) })
        } else {
            const bound = scope.bindEnumConstant(name, base.getWord(p + 16), 0)
        }
        index += 1
        p = base.getWord(p + 24)
    }
}

// Passes the declaration here: to the `;` ending it, or past the body
// that does.
fn skipDeclaration() -> void {
    var level: u32 = 0
    // Braces inside parentheses (`decltype(f(T{}))` in a base clause,
    // a default argument `= {}`) are no body.
    var parens: i64 = 0
    // A constructor's initializer list (`) : value{ true } {`): a `{`
    // after a name (or `>`) there is a member's brace initializer.
    var initializers = false
    var previous: usize = 0
    while true {
        if cursor.isEof() { cursor.fail("unterminated template") }
        if level == 0 && parens == 0 && cursor.is(names.P_COLON) && (previous == 0 || tokens.is(previous, names.P_RPAREN) || tokens.isWord(previous, names.K_NOEXCEPT) || tokens.isWord(previous, names.K_CONST)) { initializers = true }
        if initializers && level == 0 && parens == 0 && cursor.is(names.P_LBRACE) && previous != 0 && (tokens.kind(previous) == tokens.IDENT || tokens.is(previous, names.P_GT)) {
            previous = cursor.peek()
            skipBraces()
            continue
        }
        if initializers && level == 0 && parens == 0 && cursor.is(names.P_LBRACE) { initializers = false }
        previous = cursor.peek()
        if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) { parens += 1 }
        if cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) { parens -= 1 }
        if parens == 0 && cursor.is(names.P_LBRACE) { level += 1 }
        if parens == 0 && cursor.is(names.P_RBRACE) {
            level -= 1
            cursor.advance()
            if level == 0 {
                const ignored = cursor.consume(names.P_SEMI)
                return
            }
            continue
        }
        if level == 0 && parens == 0 && cursor.consume(names.P_SEMI) { return }
        cursor.advance()
    }
}

// `template<...> class X { ... };` or `template<...> class X;`.
fn classTemplate(t: usize, header: usize) -> void {
    const keyword = cursor.peek()
    cursor.advance()
    // `class [[nodiscard]] Locker`, `struct __attribute__((packed)) X`.
    decl.stdAttributes()
    const attributesRead = decl.attributes()
    // `class alignas(64) Lexer`: the alignment is the instances' (read
    // with the class).
    while cursor.is(names.K_ALIGNAS) {
        cursor.advance()
        cursor.expect(names.P_LPAREN)
        var depth: i64 = 1
        while depth > 0 && !cursor.isEof() {
            if cursor.is(names.P_LPAREN) { depth += 1 }
            if cursor.is(names.P_RPAREN) { depth -= 1 }
            cursor.advance()
        }
        decl.stdAttributes()
    }
    const tag = cursor.expectIdent()
    if cursor.is(names.P_SCOPE) {
        outOfClassTemplate(t, keyword, tag)
        return
    }
    at(t).*.isClass = true
    at(t).*.name = tokens.name(tag)
    const known = scope.findHere(at(t).*.name)
    var record = t
    if known != 0 && scope.at(known).*.kind == scope.TEMPLATE && at(scope.at(known).*.obj).*.isClass {
        // Declared before: the one record.
        record = scope.at(known).*.obj
        if cursor.is(names.P_LT) {
            partialSpecialization(record, t, keyword)
            return
        }
        if cursor.is(names.P_SEMI) {
            cursor.advance()
            // A declaration again may add default arguments (`template
            // <class T, class Traits = Select<T>> class Base;` after one
            // without): kept for the template.
            var before = at(record).*.params
            var again = at(t).*.params
            while before != 0 && again != 0 {
                if base.getWord(before + 32) == 0 && base.getWord(again + 32) != 0 {
                    base.putWord(before + 32, base.getWord(again + 32))
                    base.putWord(before + 64, base.getWord(again + 64))
                }
                before = base.getWord(before + 24)
                again = base.getWord(again + 24)
            }
            return
        }
        if at(record).*.start != 0 { tokens.errorAt(tag, "redefinition of a class template") }
        at(record).*.start = at(t).*.start
        // The declaration's default arguments hold for the definition.
        var declared = at(record).*.params
        var defined = at(t).*.params
        while declared != 0 && defined != 0 {
            if base.getWord(defined + 32) == 0 {
                base.putWord(defined + 32, base.getWord(declared + 32))
                base.putWord(defined + 64, base.getWord(declared + 64))
            }
            declared = base.getWord(declared + 24)
            defined = base.getWord(defined + 24)
        }
        at(record).*.params = at(t).*.params
        at(record).*.paramCount = at(t).*.paramCount
    } else {
        if cursor.consume(names.P_SEMI) {
            at(t).*.start = 0
        }
        const bound = scope.bindTemplate(at(t).*.name, t)
        if at(t).*.start == 0 { return }
    }
    skipDeclaration()
}

// Whether the declaration at `start` is a variable's: `=`, `{` or `;`
// before any `(` at its own level.
fn startsVariable(start: usize) -> bool {
    var t = start
    var level: i64 = 0
    var previous: usize = 0
    while !tokens.isEof(t) {
        // An operator's template is a function's (`operator>>` is no
        // closing bracket).
        if tokens.isWord(t, names.K_OPERATOR) { return false }
        if level == 0 && (tokens.is(t, names.P_ASSIGN) || tokens.is(t, names.P_SEMI)) { return true }
        // `constexpr X<T> v { };`: a brace initializer after the name.
        if level == 0 && tokens.is(t, names.P_LBRACE) && previous != 0 && tokens.kind(previous) == tokens.IDENT { return true }
        if level == 0 && (tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACE)) { return false }
        previous = t
        if tokens.is(t, names.P_LT) { level += 1 }
        if tokens.is(t, names.P_GT) { level -= 1 }
        if tokens.is(t, names.P_SHR) { level -= 2 }
        t = tokens.next(t)
    }
    return false
}

// Whether the variable declared at `start` is named `C<args>::name`, C
// a class template.
fn memberOfInstance(start: usize) -> bool {
    var t = start
    while !tokens.isEof(t) && !tokens.is(t, names.P_SEMI) && !tokens.is(t, names.P_ASSIGN) && !tokens.is(t, names.P_LBRACE) {
        if tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_LT) {
            const after = endOfArguments(tokens.next(t))
            if after != 0 && tokens.is(after, names.P_SCOPE) && isClassTemplate(scope.findKind(tokens.name(t), scope.TEMPLATE)) { return true }
            if after == 0 { return false }
            t = after
        } else if tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_SCOPE) && tokens.kind(tokens.next(tokens.next(t))) == tokens.IDENT {
            // (`template <> const ClassInfo JSInt8ArrayConstructor::s_info`,
            // the name a typedef of an instance.)
            const named = scope.find(tokens.name(t))
            if named != 0 && scope.at(named).*.kind == scope.TYPEDEF && cpp.isClassType(scope.at(named).*.ty) && cpp.templateArgsOf(scope.at(named).*.ty) != 0 { return true }
            t = tokens.next(t)
        } else {
            t = tokens.next(t)
        }
    }
    return false
}

// The name declared at `start`: the identifier before `=`, `{` or `;`.
fn variableName(start: usize) -> u32 {
    var t = start
    var name: u32 = 0
    var level: i64 = 0
    while !tokens.isEof(t) {
        if level == 0 && (tokens.is(t, names.P_ASSIGN) || tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_LBRACE)) { return name }
        if tokens.is(t, names.P_LT) { level += 1 }
        if tokens.is(t, names.P_GT) { level -= 1 }
        if tokens.is(t, names.P_SHR) { level -= 2 }
        if level == 0 && tokens.kind(t) == tokens.IDENT { name = tokens.name(t) }
        t = tokens.next(t)
    }
    return name
}

// `v<args>` of the variable template `t` (binding), at the name: the
// instance's value (a constant or a global).
pub fn variableInstance(binding: usize, nameToken: usize) -> usize {
    const t = scope.at(binding).*.obj
    cursor.advance()
    const read = parseArguments(t)
    if decl.sfinae && decl.sfinaeFailed {
        // An argument that names nothing (`Elem<int>`): no instance, and
        // the constraint does not hold.
        const failed = ast.number(0, nameToken)
        ast.node(failed).*.ty = types.boolOf()
        return failed
    }
    const args = read.0
    const key = instanceKey(t, args)
    var known = cached(t, key)
    if at(t).*.isConcept {
        // The concept's expression with the arguments: a bool (false
        // when it names what does not exist).
        if known == 0 {
            const context = beginInstance()
            const prefix = scope.qualify(at(t).*.namespace, key)
            bindParameters(at(t).*.params, args, prefix)
            scope.enterPrefix(prefix)
            const outerSfinae = decl.sfinae
            const outerFailed = decl.sfinaeFailed
            decl.sfinae = true
            decl.sfinaeFailed = false
            cursor.restore(at(t).*.start)
            var value = expr.constraintValue()
            if decl.sfinaeFailed { value = 0 }
            decl.sfinae = outerSfinae
            decl.sfinaeFailed = outerFailed
            scope.leaveNamespace()
            endInstance(context)
            known = base.alloc(8)
            base.putWord(known, @bitCast(u64, value))
            cache(t, key, known)
        }
        const n = ast.number(@bitCast(i64, base.getWord(known)), nameToken)
        ast.node(n).*.ty = types.boolOf()
        return n
    }
    if known == 0 {
        const partial = matchingPartial(t, args)
        const context = beginInstance()
        base.nameTrace(key)
        // The declaration is read under the instance's prefix, where
        // its parameters are bound: the variable is `ns::v<i>::v<i>`.
        const prefix = scope.qualify(at(t).*.namespace, key)
        var from = t
        if partial.0 != 0 {
            // A partial specialization's declaration, its parameters
            // bound to what the arguments deduce.
            from = base.getWord(partial.0)
            bindParameters(at(from).*.params, boundArguments(from, partial.1), prefix)
        } else {
            bindParameters(at(t).*.params, args, prefix)
        }
        scope.enterPrefix(prefix)
        cursor.restore(at(from).*.start)
        // The declaration, its name made the key's (a partial
        // specialization's pattern arguments taken out of the way).
        var nameAt = at(from).*.start
        var level: i64 = 0
        while true {
            if tokens.is(nameAt, names.P_LT) { level += 1 }
            if tokens.is(nameAt, names.P_GT) { level -= 1 }
            if level == 0 && tokens.kind(nameAt) == tokens.IDENT && tokens.name(nameAt) == at(t).*.name { break }
            nameAt = tokens.next(nameAt)
        }
        const savedName = tokens.at(nameAt).*.name
        const savedNext = tokens.at(nameAt).*.next
        tokens.at(nameAt).*.name = key
        if partial.0 != 0 { tokens.at(nameAt).*.next = endOfArguments(tokens.next(nameAt)) }
        const attr = decl.newAttr()
        const baseType = decl.declspec(attr)
        decl.globalDeclaration(baseType, attr)
        tokens.at(nameAt).*.name = savedName
        tokens.at(nameAt).*.next = savedNext
        known = scope.findQualified(prefix, key, false)
        if known == 0 { tokens.errorAt(nameToken, "the variable template made no variable") }
        cache(t, key, known)
        scope.leaveNamespace()
        endInstance(context)
    }
    const b = scope.at(known)
    if b.*.kind == scope.ENUM_CONSTANT {
        const n = ast.number(b.*.value, nameToken)
        ast.node(n).*.ty = b.*.ty
        return n
    }
    if b.*.kind != scope.VARIABLE { tokens.errorAt(nameToken, "not a variable template") }
    ast.obj(b.*.obj).*.isReferenced = true
    return expr.variableValue(b.*.obj, nameToken)
}

// `template <> constexpr int v<int> = 1;` after the `<>`: the instance
// of the variable template v for those arguments, declared under the
// instance's key.
fn variableSpecialization() -> void {
    const start = cursor.save()
    if memberOfInstance(start) {
        // `template <> const ClassInfo C<X>::s_info = { ... };`: the
        // static data member of one instance of a class template,
        // defined as any is out of its class (declared only, with `;`:
        // its definition is another file's).
        var t = start
        var level: i64 = 0
        while !tokens.isEof(t) && !(level == 0 && (tokens.is(t, names.P_SEMI) || tokens.is(t, names.P_ASSIGN) || tokens.is(t, names.P_LBRACE))) {
            if tokens.is(t, names.P_LT) { level += 1 }
            if tokens.is(t, names.P_GT) { level -= 1 }
            if tokens.is(t, names.P_SHR) { level -= 2 }
            t = tokens.next(t)
        }
        if tokens.is(t, names.P_SEMI) {
            cursor.restore(tokens.next(t))
            return
        }
        const attr = decl.newAttr()
        const baseType = decl.declspec(attr)
        decl.globalDeclaration(baseType, attr)
        return
    }
    const name = variableName(start)
    const binding = scope.findKind(name, scope.TEMPLATE)
    if !isVariableTemplate(binding) { cursor.fail("not a variable template") }
    const t = scope.at(binding).*.obj
    // The name token and its arguments.
    var nameAt = start
    while !(tokens.kind(nameAt) == tokens.IDENT && tokens.name(nameAt) == name && tokens.is(tokens.next(nameAt), names.P_LT)) { nameAt = tokens.next(nameAt) }
    cursor.restore(tokens.next(nameAt))
    const read = parseArguments(t)
    const key = instanceKey(t, read.0)
    if cached(t, key) != 0 { tokens.errorAt(nameAt, "the instance exists already") }
    // The declaration with the name made the key's and the arguments
    // taken out of the declarator's way.
    const after = cursor.peek()
    const savedName = tokens.at(nameAt).*.name
    const savedNext = tokens.at(nameAt).*.next
    tokens.at(nameAt).*.name = key
    tokens.at(nameAt).*.next = after
    cursor.restore(start)
    const prefix = scope.qualify(at(t).*.namespace, key)
    scope.enterPrefix(prefix)
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    decl.globalDeclaration(baseType, attr)
    scope.leaveNamespace()
    tokens.at(nameAt).*.name = savedName
    tokens.at(nameAt).*.next = savedNext
    const known = scope.findQualified(prefix, key, false)
    if known == 0 { tokens.errorAt(nameAt, "the specialization made no variable") }
    cache(t, key, known)
}

// The token naming the variable `name` in the declaration at `start`
// (at its own level), 0 for none.
fn variableNameAt(start: usize, name: u32) -> usize {
    var t = start
    var level: i64 = 0
    while !tokens.isEof(t) && !tokens.is(t, names.P_SEMI) {
        if level == 0 && tokens.kind(t) == tokens.IDENT && tokens.name(t) == name { return t }
        if tokens.is(t, names.P_LT) { level += 1 }
        if tokens.is(t, names.P_GT) { level -= 1 }
        if tokens.is(t, names.P_SHR) { level -= 2 }
        if level == 0 && tokens.is(t, names.P_ASSIGN) { return 0 }
        t = tokens.next(t)
    }
    return 0
}

// The partial specialization `t` of the variable template `record`,
// its name at `nameAt` (the pattern arguments after it): kept as a
// class template's partial specializations are (matchingPartial).
fn variablePartial(record: usize, t: usize, nameAt: usize) -> void {
    patternCount += 1
    const prefix = scope.qualify(at(record).*.namespace, base.intern(base.join("partial#", base.decimal(@intCast(u64, patternCount)))))
    scope.enterPrefix(prefix)
    bindPlaceholders(t)
    patternDepth += 1
    const outerPattern = patternTemplate
    patternTemplate = t
    cursor.restore(tokens.next(nameAt))
    const read = parseArguments(record)
    patternTemplate = outerPattern
    patternDepth -= 1
    scope.leaveNamespace()
    const c = base.alloc(40)
    base.putWord(c, t)
    base.putWord(c + 8, read.0)
    base.putWord(c + 16, nameAt)
    base.putWord(c + 24, at(record).*.partials)
    base.putWord(c + 32, nameAt)
    at(record).*.partials = c
    cursor.restore(at(t).*.start)
    skipDeclaration()
}

pub fn isVariableTemplate(binding: usize) -> bool {
    return binding != 0 && scope.at(binding).*.kind == scope.TEMPLATE && at(scope.at(binding).*.obj).*.isVariable
}

// `template <class T> struct X<T *> { ... };` at the `<`: a partial
// specialization of `record`, its arguments read as patterns (the
// parameters of `t` as placeholders) for instances to match.
fn partialSpecialization(record: usize, t: usize, keyword: usize) -> void {
    // (`X<R(Args...) noexcept>`: function types here carry no noexcept,
    // so such a pattern would take the plain one's types; left out.)
    const close = endOfArguments(cursor.peek())
    var scan = cursor.peek()
    while scan != 0 && scan != close && !tokens.isEof(scan) {
        if tokens.isWord(scan, names.K_NOEXCEPT) {
            skipDeclaration()
            return
        }
        scan = tokens.next(scan)
    }
    patternCount += 1
    const prefix = scope.qualify(at(record).*.namespace, base.intern(base.join("partial#", base.decimal(@intCast(u64, patternCount)))))
    scope.enterPrefix(prefix)
    bindPlaceholders(t)
    patternDepth += 1
    const outerPattern = patternTemplate
    patternTemplate = t
    const read = parseArguments(record)
    patternTemplate = outerPattern
    patternDepth -= 1
    scope.leaveNamespace()
    const c = base.alloc(40)
    base.putWord(c, t)
    base.putWord(c + 8, read.0)
    base.putWord(c + 16, if cursor.is(names.P_SEMI) { 0 } else { keyword })
    base.putWord(c + 24, at(record).*.partials)
    base.putWord(c + 32, tokens.next(keyword))
    at(record).*.partials = c
    skipDeclaration()
}

// How much a pattern type says: nothing for a bare parameter, more
// for each pointer, reference, const or class template around one, most
// for a type with no parameter in it.
fn specificity(pattern: usize) -> i64 {
    const k = types.kind(pattern)
    var score: i64 = if types.isConst(pattern) { 1 } else { 0 }
    if k == types.TPARAM {
        if types.at(pattern).*.arrayLength >= 0 { return score }
        score += 1
        // A dependent member (`voider<...>::type`) holds a name, no
        // arguments.
        if types.at(pattern).*.arrayLength == -3 { return score }
        var m = types.at(pattern).*.members
        while m != 0 {
            if base.getWord(m) == 1 { score += specificity(base.getWord(m + 8)) }
            if base.getWord(m) == 0 { score += 2 }
            if base.getWord(m) == 3 { score += specificity(types.boundPack(base.getWord(m + 8))) }
            m = base.getWord(m + 24)
        }
        return score
    }
    if k == types.ARRAY && types.at(pattern).*.arrayLength != -1 { score += 1 }
    if k == types.PTR || k == types.REF || k == types.ARRAY { return score + 1 + specificity(types.baseOf(pattern)) }
    return score + 2
}

// The partial specialization of `t` fitting `args` best (the one with
// the most arguments that are not bare parameters), and the bindings
// of its parameters: 0 for none.
// Whether the pattern type is one deduction passes over (a dependent
// member, a decltype, an instance over a value not known).
fn needsRecheck(ty: usize) -> bool {
    if ty == 0 { return false }
    const k = types.kind(ty)
    if k == types.PTR || k == types.REF || k == types.ARRAY { return needsRecheck(types.baseOf(ty)) }
    if k != types.TPARAM { return false }
    const index = types.at(ty).*.arrayLength
    if index == -3 { return true }
    if index == -1 {
        var cell = types.at(ty).*.members
        while cell != 0 {
            if base.getWord(cell) == 6 { return true }
            if base.getWord(cell) == 1 && needsRecheck(base.getWord(cell + 8)) { return true }
            cell = base.getWord(cell + 24)
        }
    }
    return false
}

var recheckCount: u64 = 0

// The pattern argument `p` of the partial specialization read again
// with its parameters bound as `bindings` says: true when it names a
// type and that type is `given`.
fn recheckArgument(partial: usize, bindings: usize, p: usize, given: usize) -> bool {
    recheckCount += 1
    const context = beginInstance()
    const prefix = scope.qualify(at(partial).*.namespace, base.intern(base.join("partial#check", base.decimal(recheckCount))))
    bindParameters(at(partial).*.params, boundArguments(partial, bindings), prefix)
    scope.enterPrefix(prefix)
    cursor.restore(base.getWord(p + 32))
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    const ty = decl.typeName()
    const failed = decl.sfinaeFailed || cursor.save() != base.getWord(p + 40)
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    scope.leaveNamespace()
    endInstance(context)
    return !failed && types.sameType(ty, given)
}

fn partialConstraintHolds(partial: usize, bindings: usize) -> bool {
    recheckCount += 1
    const context = beginInstance()
    const prefix = scope.qualify(at(partial).*.namespace, base.intern(base.join("partial#check", base.decimal(recheckCount))))
    bindParameters(at(partial).*.params, boundArguments(partial, bindings), prefix)
    const holds = constraintHolds(partial, prefix)
    endInstance(context)
    return holds
}

fn matchingPartial(t: usize, args: usize) -> (usize, usize) {
    var best: usize = 0
    var bestBindings: usize = 0
    var bestScore: i64 = -1
    var c = at(t).*.partials
    while c != 0 {
        const partial = base.getWord(c)
        if base.getWord(c + 16) != 0 {
            const bindings = base.alloc(at(partial).*.paramCount * 8 + 8)
            var fits = true
            var score: i64 = 0
            var p = base.getWord(c + 8)
            var a = flatten(args)
            while fits && p != 0 && a != 0 {
                if base.getWord(p) == 4 || base.getWord(p) == 5 {
                    // `Rest...`: the arguments left (a specialization
                    // without a pack is the more specific one).
                    a = bindPackSlot(packSlotOf(p), a, bindings)
                    p = base.getWord(p + 24)
                    score -= 2
                    continue
                }
                score += 2
                if base.getWord(p) == 9 {
                    // A template template parameter: the template given.
                    if base.getWord(a) != 8 { fits = false } else {
                        const slot = bindings + base.getWord(p + 16) * 8
                        if base.getWord(slot) == 0 { base.putWord(slot, base.getWord(a + 8)) } else if base.getWord(slot) != base.getWord(a + 8) { fits = false }
                    }
                } else if base.getWord(p) == 6 {
                    // A value not known before the instance: not matched.
                    if base.getWord(a) != 0 { fits = false }
                } else if base.getWord(p) == 2 {
                    // A value parameter of the specialization.
                    if base.getWord(a) != 0 { fits = false } else {
                        const slot = bindings + base.getWord(p + 16) * 8
                        if base.getWord(slot) == 0 {
                            base.putWord(slot, a + 16)
                        } else if base.getWord(base.getWord(slot)) != base.getWord(a + 16) {
                            fits = false
                        }
                    }
                } else if base.getWord(p) != base.getWord(a) {
                    fits = false
                } else if base.getWord(p) != 0 {
                    const pattern = base.getWord(p + 8)
                    fits = deduceArgument(pattern, base.getWord(a + 8), bindings)
                    // (Doubled: a constraint weighs less than any form,
                    // `DefaultHash<pair<T, U>>` over `requires H<T>
                    // DefaultHash<T>`.)
                    score += 2 * specificity(pattern)
                } else {
                    if base.getWord(p + 16) != base.getWord(a + 16) { fits = false }
                    score += 2
                }
                p = base.getWord(p + 24)
                a = base.getWord(a + 24)
            }
            if p != 0 && (base.getWord(p) == 4 || base.getWord(p) == 5) && a == 0 {
                // An empty rest.
                a = bindPackSlot(packSlotOf(p), 0, bindings)
                p = base.getWord(p + 24)
                score -= 2
            }
            if p != 0 || a != 0 { fits = false }
            var index: usize = 0
            while fits && index < at(partial).*.paramCount {
                if base.getWord(bindings + index * 8) == 0 { fits = false }
                index += 1
            }
            // The arguments not deduced from (`void_t<decltype(...)>`),
            // read again with the parameters deduced: they must name
            // something, and what was given.
            p = base.getWord(c + 8)
            a = flatten(args)
            while fits && p != 0 && a != 0 && base.getWord(p) != 4 && base.getWord(p) != 5 {
                if base.getWord(p) == 1 && base.getWord(a) == 1 && base.getWord(p + 32) != 0 && needsRecheck(base.getWord(p + 8)) {
                    fits = recheckArgument(partial, bindings, p, base.getWord(a + 8))
                }
                p = base.getWord(p + 24)
                a = base.getWord(a + 24)
            }
            // `template <class F, class S> requires (...) struct M<F, S>`:
            // its constraint holds for the arguments deduced (and makes it
            // the more specialized).
            if fits && at(partial).*.constraint != 0 {
                fits = partialConstraintHolds(partial, bindings)
                score += 1
            }
            if fits && score > bestScore {
                best = c
                bestBindings = bindings
                bestScore = score
            }
        }
        c = base.getWord(c + 24)
    }
    return -> (best, bestBindings)
}

// The member template `Class::f` the declaration starting at `start`
// defines (`R Class::f(...)`, Class a plain class): its record, 0 for
// none.
// The member's name at `t` (after `C<T>::`): an identifier, or an
// operator's (`operator=`, `operator()`); 0 for none.
fn memberNameAt(t: usize) -> u32 {
    if tokens.kind(t) == tokens.IDENT { return tokens.name(t) }
    if !tokens.isWord(t, names.K_OPERATOR) { return 0 }
    const first = tokens.next(t)
    if tokens.kind(first) != tokens.PUNCT { return 0 }
    var text = tokens.text(first)
    const second = tokens.next(first)
    if (tokens.is(first, names.P_LPAREN) && tokens.is(second, names.P_RPAREN)) || (tokens.is(first, names.P_LBRACKET) && tokens.is(second, names.P_RBRACKET)) { text = base.join(text, tokens.text(second)) }
    return base.intern(base.join("operator", text))
}

// A constructor template's definition outside its class template
// (`inline C<T>::C(params) ...` at `start`) as it would be written in
// the class (`inline C(params) ...`): a copy of the tokens before the
// name, linked to the parameters.
fn inClassConstructor(start: usize) -> usize {
    var t = start
    while !tokens.isEof(t) {
        if tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_LT) {
            const after = endOfArguments(tokens.next(t))
            if after != 0 && tokens.is(after, names.P_SCOPE) && tokens.kind(tokens.next(after)) == tokens.IDENT && tokens.is(tokens.next(tokens.next(after)), names.P_LPAREN) {
                const open = tokens.next(tokens.next(after))
                const copied = copyRange(start, tokens.next(t))
                var last = copied
                while tokens.next(last) != tokens.next(t) { last = tokens.next(last) }
                tokens.at(last).*.next = open
                return copied
            }
        }
        // `C::C(`, C a plain class: as `C(` in the class.
        if tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_SCOPE) && tokens.kind(tokens.next(tokens.next(t))) == tokens.IDENT && tokens.name(tokens.next(tokens.next(t))) == tokens.name(t) && tokens.is(tokens.next(tokens.next(tokens.next(t))), names.P_LPAREN) {
            const open = tokens.next(tokens.next(tokens.next(t)))
            const copied = copyRange(start, tokens.next(t))
            var last = copied
            while tokens.next(last) != tokens.next(t) { last = tokens.next(last) }
            tokens.at(last).*.next = open
            return copied
        }
        if tokens.is(t, names.P_LPAREN) { return start }
        t = tokens.next(t)
    }
    return start
}

// The class or namespace `A::B::` before the name at `t` (from
// `start`) names: its prefix, 0 for none.
fn prefixBefore(start: usize, t: usize) -> u32 {
    // The qualifier's first name: the start of the `X ::` run ending at t.
    var first: usize = 0
    var u = start
    var runStart: usize = 0
    while u != t && !tokens.isEof(u) {
        if tokens.kind(u) == tokens.IDENT && tokens.is(tokens.next(u), names.P_SCOPE) {
            if runStart == 0 { runStart = u }
            u = tokens.next(tokens.next(u))
            continue
        }
        runStart = 0
        u = tokens.next(u)
    }
    first = runStart
    if first == 0 { return 0 }
    var prefix: u32 = 0
    var qualified = false
    u = first
    while u != t {
        var outer: usize = 0
        if qualified { outer = scope.findQualified(prefix, tokens.name(u), false) } else { outer = scope.findKind(tokens.name(u), scope.NAMESPACE) }
        if outer == 0 || scope.at(outer).*.kind != scope.NAMESPACE { return 0 }
        prefix = @intCast(u32, scope.at(outer).*.value)
        qualified = true
        u = tokens.next(tokens.next(u))
    }
    return prefix
}

// `template <size_t N> class StringView::Upconverted { ... }` (the
// qualified name at `first`): the member class template declared in its
// class, defined here; read as `class Upconverted ...` in its scope.
fn outOfClassTemplate(t: usize, keyword: usize, first: usize) -> void {
    var prefix: u32 = 0
    var qualified = false
    cursor.restore(first)
    while cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_SCOPE) {
        var outer: usize = 0
        if qualified { outer = scope.findQualified(prefix, tokens.name(cursor.peek()), false) } else { outer = scope.findKind(tokens.name(cursor.peek()), scope.NAMESPACE) }
        if outer == 0 || scope.at(outer).*.kind != scope.NAMESPACE { cursor.fail("not a namespace or class") }
        prefix = @intCast(u32, scope.at(outer).*.value)
        qualified = true
        cursor.advance()
        cursor.advance()
    }
    const nameToken = cursor.expectIdent()
    const declared = scope.findQualified(prefix, tokens.name(nameToken), false)
    if declared == 0 || !isClassTemplate(declared) { tokens.errorAt(nameToken, "no such member class template") }
    const record = scope.at(declared).*.obj
    const keywordCopy = tokens.copy(keyword)
    tokens.at(keywordCopy).*.next = nameToken
    mergeDefaults(at(record).*.params, at(t).*.params)
    at(record).*.start = keywordCopy
    at(record).*.params = at(t).*.params
    at(record).*.paramCount = at(t).*.paramCount
    skipDeclaration()
}

// Whether a token from `from` up to `end` names one of t's parameters.
fn namesParameterOf(t: usize, from: usize, end: usize) -> bool {
    var at_ = from
    while at_ != end && !tokens.isEof(at_) {
        if tokens.kind(at_) == tokens.IDENT {
            var p = at(t).*.params
            while p != 0 {
                if @intCast(u32, base.getWord(p)) == tokens.name(at_) { return true }
                p = base.getWord(p + 24)
            }
        }
        at_ = tokens.next(at_)
    }
    return false
}

fn memberTemplateDefined(start: usize, t0: usize) -> usize {
    var t = start
    var level: u32 = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LBRACE) || tokens.is(t, names.P_SEMI) { return 0 }
        if tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_RPAREN) { level -= 1 }
        if level == 0 && tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_LT) {
            // `C<T>::f` in a class template's instance: the instance's
            // member template.
            const classBinding = scope.findKind(tokens.name(t), scope.TEMPLATE)
            const after = endOfArguments(tokens.next(t))
            // (`typename A<T>::type f()`, T the declaration's own
            // parameter, is a return type, not a member's definition.)
            if isClassTemplate(classBinding) && after != 0 && tokens.is(after, names.P_SCOPE) && !namesParameterOf(t0, tokens.next(t), after) {
                const memberName = memberNameAt(tokens.next(after))
                if memberName != 0 {
                    const saved = cursor.save()
                    cursor.restore(t)
                    const classTy = classTypeHere(classBinding)
                    cursor.restore(saved)
                    if cpp.isClassType(classTy) {
                        const completed = cpp.completeIfNeeded(classTy)
                        var binding = scope.findQualified(types.at(classTy).*.name, memberName, false)
                        // (Past the plain functions of the name: `void
                        // removeLast()` beside `bool removeLast(const auto &)`.)
                        var b = binding
                        while b != 0 && !isFunctionTemplate(b) && scope.at(b).*.name == scope.at(binding).*.name && scope.at(b).*.depth == scope.at(binding).*.depth { b = scope.at(b).*.hidden }
                        if b != 0 && isFunctionTemplate(b) { binding = b }
                        if isFunctionTemplate(binding) { return overloadDefined(scope.at(binding).*.obj, t0, tokens.next(after)) }
                        // `C<T>::C(...)`: one of the instance's constructor
                        // templates (as many parameters, declared only).
                        if memberName == tokens.name(t) { return constructorDefined(cpp.constructorTemplatesOf(classTy), t0, tokens.next(after)) }
                    }
                }
            }
        }
        if level == 0 && tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_SCOPE) && tokens.kind(tokens.next(tokens.next(t))) == tokens.IDENT {
            var owner = scope.findKind(tokens.name(t), scope.NAMESPACE)
            // `A::B::f`: the class B of A (a nested class's member).
            while owner != 0 && tokens.is(tokens.next(tokens.next(tokens.next(t))), names.P_SCOPE) && tokens.kind(tokens.next(tokens.next(tokens.next(tokens.next(t))))) == tokens.IDENT {
                const inner = scope.findQualified(@intCast(u32, scope.at(owner).*.value), tokens.name(tokens.next(tokens.next(t))), false)
                if inner == 0 || scope.at(inner).*.kind != scope.NAMESPACE { break }
                owner = inner
                t = tokens.next(tokens.next(t))
            }
            if owner != 0 {
                const classTy = cpp.classWithPrefix(@intCast(u32, scope.at(owner).*.value))
                if classTy != 0 {
                    var binding = scope.findQualified(@intCast(u32, scope.at(owner).*.value), tokens.name(tokens.next(tokens.next(t))), false)
                    // (Past functions of the name declared after it.)
                    var b = binding
                    while b != 0 && !isFunctionTemplate(b) && scope.at(b).*.name == scope.at(binding).*.name && scope.at(b).*.depth == scope.at(binding).*.depth { b = scope.at(b).*.hidden }
                    if b != 0 && isFunctionTemplate(b) { binding = b }
                    if isFunctionTemplate(binding) && at(scope.at(binding).*.obj).*.owner == classTy { return overloadDefined(scope.at(binding).*.obj, t0, tokens.next(tokens.next(t))) }
                    // `C::C(...)`: one of the class's constructor templates
                    // (as many parameters, declared only).
                    if tokens.name(tokens.next(tokens.next(t))) == tokens.name(t) { return constructorDefined(cpp.constructorTemplatesOf(classTy), t0, tokens.next(tokens.next(t))) }
                }
            }
        }
        t = tokens.next(t)
    }
    return 0
}

// Of a class's constructor templates `first`, the one the definition
// of `t0` (its name at `nameToken`) defines: as many template
// parameters, declared only, the same parameters (`S(MallocSpan<
// Latin1Character, M>)` beside `S(MallocSpan<char16_t, M>)`); 0 for
// none.
fn constructorDefined(first: usize, t0: usize, nameToken: usize) -> usize {
    const name = tokens.name(nameToken)
    const shape = parameterShape(t0, nameToken, name)
    var fallback: usize = 0
    var c = first
    while c != 0 {
        if at(c).*.paramCount == at(t0).*.paramCount && !at(c).*.definedOutside {
            if fallback == 0 { fallback = c }
            const declared = if at(c).*.declaration != 0 { at(c).*.declaration } else { at(c).*.start }
            if declared != 0 && base.same(parameterShape(c, declared, name), shape) { return c }
        }
        c = at(c).*.next
    }
    if fallback != 0 { return fallback }
    c = first
    while c != 0 {
        if at(c).*.paramCount == at(t0).*.paramCount { return c }
        c = at(c).*.next
    }
    return 0
}

// Of the overloaded member templates `first` (chained by `next`), the
// one the definition of `t0` (its name at `nameToken`) defines: as many
// template parameters and function parameters (`expand(size_t)` beside
// `expand(size_t, T *)`); `first` when none tells.
fn overloadDefined(first: usize, t0: usize, nameToken: usize) -> usize {
    if at(first).*.next == 0 { return first }
    const name = memberNameAt(nameToken)
    const count = parameterCountAfter(nameToken, name)
    if count < 0 { return first }
    var c = first
    while c != 0 {
        const declared = if at(c).*.declaration != 0 { at(c).*.declaration } else { at(c).*.start }
        if at(c).*.paramCount == at(t0).*.paramCount && sameParameterKinds(c, t0) && declared != 0 && parameterCountAfter(declared, name) == count && base.same(parameterShape(c, declared, name), parameterShape(t0, nameToken, name)) { return c }
        c = at(c).*.next
    }
    // (Shapes written differently: by the counts alone.)
    c = first
    while c != 0 {
        const declared = if at(c).*.declaration != 0 { at(c).*.declaration } else { at(c).*.start }
        if at(c).*.paramCount == at(t0).*.paramCount && sameParameterKinds(c, t0) && declared != 0 && parameterCountAfter(declared, name) == count { return c }
        c = at(c).*.next
    }
    return first
}

// The parameter list after the name `name` from `start` as text: each
// parameter's tokens without its name or default, the template `t`'s
// own parameters by their places (`const KeyType &` and `KeyType &&`
// told apart, `V` and `T` alike).
fn parameterShape(t: usize, start: usize, name: u32) -> []const u8 {
    var x = start
    while !tokens.isEof(x) && !tokens.is(x, names.P_SEMI) && !tokens.is(x, names.P_LBRACE) {
        if memberNameAt(x) == name && tokens.is(tokens.next(x), names.P_LPAREN) { break }
        x = tokens.next(x)
    }
    if !tokens.is(tokens.next(x), names.P_LPAREN) { return "" }
    var shape: []const u8 = ""
    var item: []const u8 = ""
    var last: usize = 0
    var lastText: []const u8 = ""
    var count: u32 = 0
    var level: i64 = 0
    var inDefault = false
    var u = tokens.next(tokens.next(x))
    while !tokens.isEof(u) {
        const closes = level == 0 && tokens.is(u, names.P_RPAREN)
        if closes || (level == 0 && tokens.is(u, names.P_COMMA)) {
            // The parameter's own name (a last identifier after a type).
            if count > 1 && last != 0 && tokens.kind(last) == tokens.IDENT && parameterIndex(t, tokens.name(last)) < 0 { item = base.join(item, "") } else { item = base.join(item, lastText) }
            shape = base.join(shape, base.join(item, ","))
            item = ""
            last = 0
            lastText = ""
            count = 0
            inDefault = false
            if closes {
                // (`find(const T &) const` beside `find(const T &)`.)
                if tokens.isWord(tokens.next(u), names.K_CONST) { shape = base.join(shape, " const") }
                break
            }
            u = tokens.next(u)
            continue
        }
        if tokens.is(u, names.P_LPAREN) || tokens.is(u, names.P_LBRACKET) || tokens.is(u, names.P_LBRACE) || tokens.is(u, names.P_LT) { level += 1 }
        if tokens.is(u, names.P_RPAREN) || tokens.is(u, names.P_RBRACKET) || tokens.is(u, names.P_RBRACE) || tokens.is(u, names.P_GT) { level -= 1 }
        if level == 0 && tokens.is(u, names.P_ASSIGN) { inDefault = true }
        if !inDefault {
            item = base.join(item, lastText)
            const index = if tokens.kind(u) == tokens.IDENT { parameterIndex(t, tokens.name(u)) } else { -1 }
            lastText = if index >= 0 { base.join("#", base.join(base.decimal(@intCast(u64, index)), " ")) } else { base.join(tokens.text(u), " ") }
            last = u
            count += 1
        }
        u = tokens.next(u)
    }
    return shape
}

// Whether the templates `a` and `b` have parameters of the same kinds
// (type, value, template; packs alike), in order.
fn sameParameterKinds(a: usize, b: usize) -> bool {
    var p = at(a).*.params
    var q = at(b).*.params
    while p != 0 && q != 0 {
        if base.getWord(p + 8) != base.getWord(q + 8) || (base.getWord(p + 40) != 0) != (base.getWord(q + 40) != 0) { return false }
        p = base.getWord(p + 24)
        q = base.getWord(q + 24)
    }
    return p == 0 && q == 0
}

// The function parameters of the declarator from `start` whose name is
// `name` (the parameter list after it), -1 when it is not found.
fn parameterCountAfter(start: usize, name: u32) -> i64 {
    var t = start
    while !tokens.isEof(t) && !tokens.is(t, names.P_SEMI) && !tokens.is(t, names.P_LBRACE) {
        if memberNameAt(t) == name {
            var open = tokens.next(t)
            if tokens.isWord(t, names.K_OPERATOR) {
                while !tokens.isEof(open) && !tokens.is(open, names.P_LPAREN) { open = tokens.next(open) }
                if tokens.is(tokens.next(open), names.P_RPAREN) && tokens.is(tokens.next(tokens.next(open)), names.P_LPAREN) { open = tokens.next(tokens.next(open)) }
            }
            if tokens.is(open, names.P_LPAREN) { return listCount(open) }
        }
        t = tokens.next(t)
    }
    return -1
}

// The items of the parenthesized list at `open` (`()` and `(void)`
// none).
fn listCount(open: usize) -> i64 {
    var t = tokens.next(open)
    if tokens.is(t, names.P_RPAREN) { return 0 }
    if tokens.isWord(t, names.K_VOID) && tokens.is(tokens.next(t), names.P_RPAREN) { return 0 }
    var count: i64 = 1
    var level: i64 = 0
    var angle: i64 = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) {
            if level == 0 { return count }
            level -= 1
        }
        if level == 0 && tokens.is(t, names.P_LT) { angle += 1 }
        if level == 0 && tokens.is(t, names.P_GT) && angle > 0 { angle -= 1 }
        if level == 0 && tokens.is(t, names.P_SHR) { angle = if angle > 2 { angle - 2 } else { 0 } }
        if level == 0 && angle == 0 && tokens.is(t, names.P_COMMA) { count += 1 }
        t = tokens.next(t)
    }
    return count
}

// `template <...> R f(params);` or `{ body }` inside the class `classTy`
// (cpp.specialMember): a member template, bound in the class's scope.
pub fn memberTemplate(classTy: usize) -> void {
    const abbreviatedCopy = abbreviateTemplate(cursor.peek())
    if abbreviatedCopy != 0 { cursor.restore(abbreviatedCopy) }
    cursor.expect(names.K_TEMPLATE)
    const t = base.alloc(@sizeOf(Template))
    at(t).*.namespace = types.at(classTy).*.name
    at(t).*.owner = classTy
    parameters(t)
    if cursor.is(names.K_REQUIRES) {
        cursor.advance()
        requiresClause(t)
    }
    decl.stdAttributes()
    at(t).*.start = cursor.save()
    at(t).*.declaration = at(t).*.start
    // `static` here holds for a definition outside the class too (which
    // does not repeat it).
    var t0 = cursor.peek()
    while !tokens.isEof(t0) && !tokens.is(t0, names.P_LPAREN) && !tokens.is(t0, names.P_SEMI) && !tokens.is(t0, names.P_LBRACE) {
        if tokens.isWord(t0, names.K_STATIC) { at(t).*.isStaticMember = true }
        // (`operator new`, `operator delete`: static members.)
        if (tokens.isWord(t0, names.K_OPERATOR) || (tokens.kind(t0) == tokens.IDENT && tokens.name(t0) == names.K_OPERATOR)) && (tokens.isWord(tokens.next(t0), names.K_NEW) || tokens.isWord(tokens.next(t0), names.K_DELETE)) { at(t).*.isStaticMember = true }
        if (tokens.isWord(t0, names.K_GNU2_ATTRIBUTE) || tokens.isWord(t0, names.K_DECLTYPE)) && tokens.is(tokens.next(t0), names.P_LPAREN) {
            // (`ALWAYS_INLINE static`: past the attribute's parentheses.)
            var depth: i64 = 0
            t0 = tokens.next(t0)
            while !tokens.isEof(t0) {
                if tokens.is(t0, names.P_LPAREN) { depth += 1 }
                if tokens.is(t0, names.P_RPAREN) {
                    depth -= 1
                    if depth == 0 { break }
                }
                t0 = tokens.next(t0)
            }
        }
        t0 = tokens.next(t0)
    }
    if cursor.is(names.K_FRIEND) {
        // `template <typename> friend class X;`, a friend function
        // template declared only: access is not checked, nothing to
        // declare.
        var f = cursor.peek()
        while !tokens.isEof(f) && !tokens.is(f, names.P_SEMI) && !tokens.is(f, names.P_LBRACE) { f = tokens.next(f) }
        if tokens.is(f, names.P_SEMI) {
            cursor.restore(tokens.next(f))
            return
        }
        // `template <class... T> friend uint32_t computeHash(...) { ... }`:
        // a function template of the namespace around the class (its
        // declaration there gets this body), its names read in the
        // class's scope.
        cursor.advance()
        const ns = scope.parentOf(types.at(classTy).*.name)
        at(t).*.owner = 0
        at(t).*.isStaticMember = false
        at(t).*.start = cursor.save()
        at(t).*.declaration = at(t).*.start
        scope.enterPrefix(ns)
        functionTemplate(t)
        scope.leaveNamespace()
        const binding = scope.findQualified(ns, at(t).*.name, false)
        var b = binding
        while b != 0 && scope.at(b).*.name == scope.at(binding).*.name {
            if scope.at(b).*.kind == scope.TEMPLATE {
                var declared = scope.at(b).*.obj
                while declared != 0 {
                    if at(declared).*.start == at(t).*.start { at(declared).*.namespace = at(t).*.namespace }
                    declared = at(declared).*.next
                }
            }
            b = scope.at(b).*.hidden
        }
        return
    }
    if cursor.is(names.K_CLASS) || cursor.is(names.K_STRUCT) {
        // A member class template: a class template in the class's
        // scope (its instances see the class's names).
        at(t).*.owner = 0
        at(t).*.declaration = 0
        classTemplate(t, at(t).*.start)
        return
    }
    if cursor.consume(names.K_USING) {
        // A member alias template: in the class's scope.
        at(t).*.owner = 0
        at(t).*.declaration = 0
        at(t).*.isClass = true
        at(t).*.isAlias = true
        at(t).*.name = tokens.name(cursor.expectIdent())
        cursor.expect(names.P_ASSIGN)
        at(t).*.start = cursor.save()
        skipDeclaration()
        const bound = scope.bindTemplate(at(t).*.name, t)
        return
    }
    if cursor.is(names.K_TEMPLATE) { cursor.fail("only member function and class templates are supported") }
    functionTemplate(t)
}

// A `requires` clause after a function's parameters (decl
// .finishParameters): the constraint of the template whose pattern is
// being read, passed over here.
pub fn trailingRequires() -> void {
    cursor.expect(names.K_REQUIRES)
    if patternTemplate != 0 && at(patternTemplate).*.constraint == 0 { at(patternTemplate).*.constraint = cursor.save() }
    // (A member of a class template's instance: weighed when it is
    // declared, memberConstraintHolds.)
    if patternTemplate == 0 { memberRequires = cursor.save() }
    skipConstraint()
}

// The `requires` clause after the parameters of the member function
// being declared (not a template's), 0 for none.
pub var memberRequires: usize = 0

// Whether the member function being declared in a class template's
// instance exists there: its `requires (reviverMode == Disabled)` holds
// for the instance's arguments.
pub fn memberConstraintHolds() -> bool {
    const at0 = memberRequires
    memberRequires = 0
    if at0 == 0 { return true }
    const saved = cursor.save()
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    cursor.restore(at0)
    const value = expr.constraintValue()
    const holds = value != 0 && !decl.sfinaeFailed
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    cursor.restore(saved)
    return holds
}

// Passes a constraint: primary expressions (a name with its template
// arguments, a parenthesis, a requires expression) joined by && and
// ||, with `!` before them.
fn skipConstraint() -> void {
    while true {
        while cursor.consume(names.P_BANG) {}
        if cursor.is(names.P_LPAREN) {
            decl.skipParentheses()
        } else if cursor.consume(names.K_REQUIRES) {
            if cursor.is(names.P_LPAREN) { decl.skipParentheses() }
            skipBraces()
        } else {
            // A (qualified) name with template arguments, `C<T>::value`.
            const ignored = cursor.consume(names.P_SCOPE)
            while cursor.isIdent() {
                cursor.advance()
                if cursor.is(names.P_LT) {
                    const after = endOfArguments(cursor.peek())
                    if after == 0 { cursor.fail("unterminated template arguments in a constraint") }
                    cursor.restore(after)
                }
                if !cursor.consume(names.P_SCOPE) { break }
            }
        }
        if !cursor.consume(names.P_ANDAND) && !cursor.consume(names.P_OROR) { return }
    }
}

fn skipBraces() -> void {
    cursor.expect(names.P_LBRACE)
    var level: u32 = 1
    while level > 0 {
        if cursor.isEof() { cursor.fail("unterminated requires expression") }
        if cursor.is(names.P_LBRACE) { level += 1 }
        if cursor.is(names.P_RBRACE) { level -= 1 }
        cursor.advance()
    }
}

// Whether the template `t`'s constraint holds for `args` (its
// parameters bound under `prefix` already): true without one; false
// when it is false or names what does not exist.
// The template whose constraint is being weighed (a function parameter
// pack named there, `sizeof...(captures)`, is its type's pack).
var constraintTemplate: usize = 0

// The bound template parameter pack a function parameter pack `name`
// of the template whose constraint is weighed expands; 0 for none.
pub fn constraintParameterPack(name: u32) -> usize {
    const t = constraintTemplate
    if t == 0 || at(t).*.pattern == 0 { return 0 }
    var p = types.at(at(t).*.pattern).*.params
    while p != 0 {
        if types.param(p).*.name == name && types.param(p).*.isPack {
            const slot = packIndexIn(types.param(p).*.ty)
            if slot < 0 { return 0 }
            const binding = scope.find(@intCast(u32, base.getWord(parameterCell(t, @intCast(usize, slot)))))
            if binding != 0 && scope.at(binding).*.kind == scope.PACK { return binding }
            return 0
        }
        p = types.param(p).*.next
    }
    return 0
}

fn constraintHolds(t: usize, prefix: u32) -> bool {
    if at(t).*.constraint == 0 { return true }
    const outerTemplate = constraintTemplate
    constraintTemplate = t
    const holds = constraintHoldsFor(t, prefix)
    constraintTemplate = outerTemplate
    return holds
}

fn constraintHoldsFor(t: usize, prefix: u32) -> bool {
    const saved = cursor.save()
    scope.enterPrefix(prefix)
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    cursor.restore(at(t).*.constraint)
    const value = expr.constraintValue()
    const holds = value != 0 && !decl.sfinaeFailed
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    scope.leaveNamespace()
    cursor.restore(saved)
    return holds
}

// Defines the instances of the member template `t` that waited for
// its definition (read now).
fn defineWaiting(t: usize) -> void {
    var c = at(t).*.waiting
    at(t).*.waiting = 0
    while c != 0 {
        const o = base.getWord(c)
        const next = base.getWord(c + 24)
        // (Made at the end of the unit, as ensureDefined's are, unless
        // computed or its result type deduced.)
        if !finishing && !ast.obj(o).*.isConstexpr && !types.hasAutoResult(types.baseOf(ast.obj(o).*.ty)) {
            const late = base.alloc(24)
            base.putWord(late, t)
            base.putWord(late + 8, c)
            base.putWord(late + 16, lateWaiting)
            lateWaiting = late
        } else {
            defineWaitingOne(t, c)
        }
        c = next
    }
}

// The waiting instances whose definitions are made at the end of the
// unit: cells of (template, waiting cell, next).
var lateWaiting: usize = 0

fn defineWaitingOne(t: usize, c: usize) -> void {
    {
        const o = base.getWord(c)
        const prefix = @intCast(u32, base.getWord(c + 8))
        const context = beginInstance()
        // The definition's parameter names may differ from the
        // declaration's: bound again, under the same prefix.
        bindFunctionParameters(t, base.getWord(c + 16), prefix)
        scope.enterPrefix(prefix)
        cursor.restore(at(t).*.start)
        const attr = decl.newAttr()
        const baseType = decl.declspec(attr)
        const found = decl.declarator(baseType)
        memberRequires = 0
        if at(t).*.isConstructor && types.kind(found.0) == types.FUNC {
            // (`C::C(...)` read as the class's name and parameters.)
            types.at(found.0).*.base = types.voidOf()
        } else if found.1 == 0 || types.kind(found.0) != types.FUNC {
            cursor.fail("expected a function template")
        }
        decl.defineFunctionAs(o, prefix, found.0)
        scope.leaveNamespace()
        endInstance(context)
    }
}

// At the end of the unit: the bodies left for it.
pub fn finish() -> void {
    // The bodies the calls asked for, and those they ask for in turn.
    finishing = true
    // (Only the instances a call took: one made while choosing among
    // overloads and not taken is not defined, its body may not compile,
    // `x.sign()` for an int. The bodies made may take more of them.)
    var unused: usize = 0
    var progress = true
    while progress {
        progress = false
        while lateWaiting != 0 {
            const late = lateWaiting
            lateWaiting = base.getWord(late + 16)
            const o = base.getWord(base.getWord(late + 8))
            if !ast.obj(o).*.isReferenced {
                base.putWord(late + 16, unused)
                unused = late
                continue
            }
            defineWaitingOne(base.getWord(late), base.getWord(late + 8))
            progress = true
        }
        while lateBodies != 0 {
            const o = base.getWord(lateBodies)
            lateBodies = base.getWord(lateBodies + 8)
            ensureDefinedNow(o)
            progress = true
        }
        // Those not taken yet, looked at again.
        lateWaiting = unused
        unused = 0
        if !progress { lateWaiting = 0 }
    }
    // (An instance still waiting for its template's definition is
    // another file's: `template bool JSObject::f<Int32Shape>(...);`
    // there. It stays declared, for the linker.)
}

// The class template whose member the declaration starting at `start`
// defines (`R vector<T>::f(...)`): 0 for none.
fn memberOf(start: usize) -> usize {
    var t = start
    var level: u32 = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LBRACE) || tokens.is(t, names.P_SEMI) { return 0 }
        if tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_RPAREN) { level -= 1 }
        if level == 0 && tokens.kind(t) == tokens.IDENT && tokens.is(tokens.next(t), names.P_LT) {
            var binding = scope.findKind(tokens.name(t), scope.TEMPLATE)
            // `SV::Up<N>::Up(`: a member class template of SV.
            if prefixBefore(start, t) != 0 { binding = scope.findQualified(prefixBefore(start, t), tokens.name(t), false) }
            if isClassTemplate(binding) {
                const after = endOfArguments(tokens.next(t))
                // `vector<T>::f(`, `vector<T>::~vector(`, `vector<T>::operator=(`,
                // `vector<T>::npos =`: a member; `remove_reference<T>::type f(`
                // names a type.
                if after != 0 && tokens.is(after, names.P_SCOPE) && definesMember(tokens.next(after)) { return scope.at(binding).*.obj }
            }
        }
        t = tokens.next(t)
    }
    return 0
}

// The partial specialization of `owner` whose member the declaration
// at `start` (under the header of `t`) defines: its arguments written
// as the specialization's pattern is (`HandleConverter<Base, Unknown>`
// for `template <class Base> struct HandleConverter<Base, Unknown>`);
// 0 for the primary template.
fn partialDefined(owner: usize, t: usize, start: usize) -> usize {
    var name = start
    while !tokens.isEof(name) && !(tokens.kind(name) == tokens.IDENT && tokens.name(name) == at(owner).*.name && tokens.is(tokens.next(name), names.P_LT)) {
        if tokens.is(name, names.P_LBRACE) || tokens.is(name, names.P_SEMI) { return 0 }
        name = tokens.next(name)
    }
    if tokens.isEof(name) { return 0 }
    var c = at(owner).*.partials
    while c != 0 {
        const partial = base.getWord(c)
        if at(partial).*.paramCount == at(t).*.paramCount && samePattern(t, tokens.next(name), partial, tokens.next(base.getWord(c + 32))) { return partial }
        c = base.getWord(c + 24)
    }
    return 0
}

// Whether the arguments at `x` (`<...>`, under the parameters of `a`)
// and at `y` (under `b`'s) are written alike, the parameters by
// position.
fn samePattern(a: usize, x: usize, b: usize, y: usize) -> bool {
    if !tokens.is(x, names.P_LT) || !tokens.is(y, names.P_LT) { return false }
    const lastX = endOfArguments(x)
    const lastY = endOfArguments(y)
    var p = x
    var q = y
    while p != lastX && q != lastY {
        if tokens.isEof(p) || tokens.isEof(q) { return false }
        const pp = if tokens.kind(p) == tokens.IDENT { parameterIndex(a, tokens.name(p)) } else { -1 }
        const pq = if tokens.kind(q) == tokens.IDENT { parameterIndex(b, tokens.name(q)) } else { -1 }
        if pp != pq { return false }
        if pp < 0 && !base.same(tokens.text(p), tokens.text(q)) { return false }
        p = tokens.next(p)
        q = tokens.next(q)
    }
    return p == lastX && q == lastY
}

// Whether the tokens after `Class<T>::` declare a member of it: a
// name (a destructor's, an operator's) followed by `(`, `=`, `;` or
// `<`, not a type naming the result of a function.
fn definesMember(t: usize) -> bool {
    var at = t
    // (`C<T>::Nested::f(`: a member of a class nested in it.)
    while tokens.kind(at) == tokens.IDENT && tokens.is(tokens.next(at), names.P_SCOPE) { at = tokens.next(tokens.next(at)) }
    if tokens.is(at, names.P_TILDE) { return true }
    if tokens.isWord(at, names.K_OPERATOR) { return true }
    if tokens.kind(at) != tokens.IDENT { return false }
    at = tokens.next(at)
    return tokens.is(at, names.P_LPAREN) || tokens.is(at, names.P_ASSIGN) || tokens.is(at, names.P_SEMI) || tokens.is(at, names.P_LT) || tokens.is(at, names.P_LBRACE)
}

// A function template: its signature is read with placeholders.
fn functionTemplate(t: usize) -> void {
    patternCount += 1
    at(t).*.patternPrefix = scope.qualify(at(t).*.namespace, base.intern(base.join("template#", base.decimal(@intCast(u64, patternCount)))))
    scope.enterPrefix(at(t).*.patternPrefix)
    bindPlaceholders(t)
    const attr = decl.newAttr()
    patternDepth += 1
    const outerPattern = patternTemplate
    patternTemplate = t
    const baseType = decl.declspec(attr)
    const found = decl.declarator(baseType)
    patternTemplate = outerPattern
    patternDepth -= 1
    scope.leaveNamespace()
    if found.1 == 0 && types.kind(found.0) == types.FUNC && at(t).*.owner != 0 && cpp.isClassType(baseType) && types.unqualified(baseType) == types.unqualified(at(t).*.owner) {
        // A constructor template: `template <class U> pair(U &&a)`.
        at(t).*.isConstructor = true
        at(t).*.name = cpp.writtenName(at(t).*.owner)
        types.at(found.0).*.base = types.voidOf()
        at(t).*.pattern = found.0
        if cursor.is(names.P_SEMI) {
            // Declared only (`template <class C> X(Decoder &, const
            // Cached<C> &);`): its instances wait for the definition
            // outside the class.
            if at(t).*.declaration == 0 { at(t).*.declaration = at(t).*.start }
            at(t).*.start = 0
        }
        skipDeclaration()
        cpp.addConstructorTemplate(at(t).*.owner, t)
        return
    }
    if found.1 == 0 || types.kind(found.0) != types.FUNC { cursor.fail("expected a function template") }
    at(t).*.name = tokens.name(found.1)
    at(t).*.pattern = found.0
    if cursor.is(names.P_ASSIGN) && cursor.isToken(cursor.peekNext(), names.K_DELETE) {
        // `= delete`: a candidate no call may take (bound for the
        // explicit specializations naming it).
        cursor.advance()
        cursor.advance()
        at(t).*.isDeleted = true
        at(t).*.declaration = at(t).*.start
        at(t).*.start = 0
        cursor.expect(names.P_SEMI)
    } else if cursor.consume(names.P_SEMI) {
        // A member template declared only: its definition comes outside
        // the class; a function template declared only: its definition
        // is another template of the name (passed over in calls), or
        // none (called where nothing is evaluated: decltype(declval<T>())).
        if at(t).*.declaration == 0 { at(t).*.declaration = at(t).*.start }
        at(t).*.start = 0
    } else {
        if !cursor.is(names.P_LBRACE) { tokens.errorAt(found.1, "a function template needs its body here") }
        skipDeclaration()
    }
    // Bound after any template of the same name (functions of the name
    // declared since may be bound over it: compare's operator== between
    // vector's and pair's).
    var known = scope.findHere(at(t).*.name)
    var b = known
    while b != 0 && scope.at(b).*.depth == scope.at(known).*.depth && scope.at(b).*.name == scope.at(known).*.name {
        if scope.at(b).*.kind == scope.TEMPLATE {
            known = b
            break
        }
        b = scope.at(b).*.hidden
    }
    if known != 0 && scope.at(known).*.kind == scope.TEMPLATE {
        // The definition of a template declared before (as many
        // parameters, the same signature): that one gets the body, and
        // its instances made meanwhile are defined now.
        if at(t).*.start != 0 {
            var declared = scope.at(known).*.obj
            while declared != 0 {
                if at(declared).*.start == 0 && !at(declared).*.isDeleted && at(declared).*.declaration != 0 && at(declared).*.owner == 0 && at(declared).*.paramCount == at(t).*.paramCount && at(declared).*.pattern != 0 && samePatternSignature(at(declared).*.pattern, at(t).*.pattern) && sameConstraint(declared, t) {
                    // The declaration's default arguments hold for the
                    // definition (`adoptRef`'s `PtrTraits = RawPtrTraits<T>`).
                    mergeDefaults(at(declared).*.params, at(t).*.params)
                    at(declared).*.start = at(t).*.start
                    // The declaration's default arguments (`uint8_t base
                    // = 10`) hold for the definition's parameters.
                    var dp = types.at(at(declared).*.pattern).*.params
                    var np = types.at(at(t).*.pattern).*.params
                    while dp != 0 && np != 0 {
                        if types.param(np).*.defaultValue == 0 { types.param(np).*.defaultValue = types.param(dp).*.defaultValue }
                        dp = types.param(dp).*.next
                        np = types.param(np).*.next
                    }
                    at(declared).*.params = at(t).*.params
                    if at(t).*.constraint != 0 { at(declared).*.constraint = at(t).*.constraint }
                    at(declared).*.pattern = at(t).*.pattern
                    defineWaiting(declared)
                    return
                }
                declared = at(declared).*.next
            }
        }
        var last = scope.at(known).*.obj
        while at(last).*.next != 0 { last = at(last).*.next }
        at(last).*.next = t
    } else {
        const bound = scope.bindTemplate(at(t).*.name, t)
    }
}

// Whether the templates `a` and `b` have the same constraint (none, or
// the same tokens, their own parameters' names alike by position):
// `template <signed_integral S> S f(S, S);` declares no `template
// <unsigned_integral U> U f(U, U)`.
fn sameConstraint(a: usize, b: usize) -> bool {
    var x = at(a).*.constraint
    var y = at(b).*.constraint
    if (x == 0) != (y == 0) { return false }
    if x == 0 { return true }
    const lastX = constraintEnd(x)
    const lastY = constraintEnd(y)
    var count: u32 = 0
    while count < 64 {
        const endX = x == lastX || tokens.isEof(x)
        const endY = y == lastY || tokens.isEof(y)
        if endX || endY { return endX == endY }
        const px = if tokens.kind(x) == tokens.IDENT { parameterIndex(a, tokens.name(x)) } else { -1 }
        const py = if tokens.kind(y) == tokens.IDENT { parameterIndex(b, tokens.name(y)) } else { -1 }
        if px != py { return false }
        if px < 0 && !base.same(tokens.text(x), tokens.text(y)) { return false }
        x = tokens.next(x)
        y = tokens.next(y)
        count += 1
    }
    return true
}

// The token after the constraint at `start`.
fn constraintEnd(start: usize) -> usize {
    const saved = cursor.save()
    cursor.restore(start)
    skipConstraint()
    const end = cursor.peek()
    cursor.restore(saved)
    return end
}

// The position of the template `t`'s parameter named `name`, -1 for none.
fn parameterIndex(t: usize, name: u32) -> i64 {
    var p = at(t).*.params
    var i: i64 = 0
    while p != 0 {
        if @intCast(u32, base.getWord(p)) == name { return i }
        p = base.getWord(p + 24)
        i += 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// Arguments and keys

// `<args>` at the `<`: cells of (isType, type, value, next) and their
// number. With `partial`, the parameters left without an argument or a
// default are left to deduction.
fn parseArguments(t: usize) -> (usize, usize) {
    return readArguments(t, false)
}

fn readArguments(t: usize, partial: bool) -> (usize, usize) {
    cursor.expect(names.P_LT)
    var head: usize = 0
    var tail: usize = 0
    var count: usize = 0
    var p = at(t).*.params
    // A parameter pack takes the arguments from its place on, in one
    // holder cell (in a pattern they stay as they are, `Rest...` one
    // cell).
    var holder: usize = 0
    var packIsType = false
    if p != 0 && base.getWord(p + 40) != 0 && patternDepth == 0 {
        holder = types.newPackHolder()
        packIsType = base.getWord(p + 8) != 0
        const c = base.alloc(32)
        base.putWord(c, 3)
        base.putWord(c + 8, holder)
        head = c
        tail = c
        count += 1
        p = base.getWord(p + 24)
    }
    // (The arguments read: an expansion of an empty pack is one too,
    // `tuple<A..., int>`.)
    var read: usize = 0
    while true {
        if read > 0 && !cursor.consume(names.P_COMMA) { break }
        read += 1
        if cursor.is(names.P_GT) || cursor.is(names.P_SHR) { break }
        if p == 0 && holder == 0 { cursor.fail("too few template parameters for the arguments") }
        var isType = if p != 0 { base.getWord(p + 8) != 0 } else { packIsType }
        const isTemplate = p != 0 && base.getWord(p + 8) == 2
        // Function templates of one name may differ in the kind of a
        // parameter (`f<size_t N>` and `f<typename T>`): the argument
        // says which kind it is (callInstance passes over the templates
        // whose parameters are of the other kind).
        if patternDepth == 0 && !cursor.is(names.P_ELLIPSIS) && !isTemplate && !(cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_ELLIPSIS)) {
            const first = cursor.peek()
            const k0 = tokens.kind(first)
            var looksValue = k0 == tokens.NUMBER || k0 == tokens.CHAR || k0 == tokens.STRING || k0 == tokens.INTEGER || k0 == tokens.FLOATING || cursor.is(names.P_LPAREN) || cursor.is(names.P_MINUS) || cursor.is(names.P_BANG) || cursor.is(names.P_TILDE) || cursor.is(names.K_SIZEOF) || cursor.is(names.K_ALIGNOF) || cursor.is(names.K_GNU2_ALIGNOF) || cursor.is(names.K_C23_ALIGNOF) || cursor.is(names.K_TRUE) || cursor.is(names.K_FALSE)
            if !looksValue && k0 == tokens.IDENT && !cursor.isToken(cursor.peekNext(), names.P_SCOPE) {
                const b = scope.find(tokens.name(first))
                looksValue = b != 0 && (scope.at(b).*.kind == scope.VARIABLE || scope.at(b).*.kind == scope.ENUM_CONSTANT)
                // A bound pack of values (`Is` of `size_t... Is`).
                if b != 0 && scope.at(b).*.kind == scope.PACK {
                    const values = types.packArguments(scope.at(b).*.obj)
                    if values != 0 && base.getWord(values) == 0 { looksValue = true }
                }
                if looksValue {
                    // A class's name names the class, not its constructor.
                    const seen = scope.packSeen
                    if decl.isTypename(first) { looksValue = false }
                    scope.packSeen = seen
                }
            }
            if isType && looksValue { isType = false }
            if !isType && !looksValue {
                const seen = scope.packSeen
                const startsType = decl.isTypename(first)
                scope.packSeen = seen
                if startsType && !startsValueExpression() { isType = true }
            }
        }
        // (A pattern argument keeps its tokens at +32 and +40: a partial
        // specialization checks the ones not deduced from again.)
        var c = base.alloc(48)
        var expanded: usize = 0
        if isTemplate {
            // A template as the argument (`wrap<L, std::vector>`): its
            // record; a placeholder's (in a pattern) stands for the
            // template deduced.
            var binding: usize = 0
            if decl.startsQualified() {
                const read = decl.qualifier()
                binding = scope.findQualified(read.0, tokens.name(cursor.expectIdent()), false)
            } else {
                binding = scope.findKind(tokens.name(cursor.expectIdent()), scope.TEMPLATE)
            }
            if binding == 0 || scope.at(binding).*.kind != scope.TEMPLATE || !at(scope.at(binding).*.obj).*.isClass { cursor.fail("expected a class template as the template argument") }
            const record = scope.at(binding).*.obj
            if at(record).*.standsFor != 0 {
                base.putWord(c, 9)
                base.putWord(c + 16, @intCast(usize, at(record).*.standsFor - 1))
            } else {
                base.putWord(c, 8)
                base.putWord(c + 8, record)
            }
        } else if patternDepth == 0 && scope.packIndex < 0 && argumentEndsWithEllipsis() && !(cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_ELLIPSIS)) {
            // `decay<Ts>::type...`, `(Is * 2)...`: a pattern over a
            // bound pack, read once per element.
            expanded = expandedArguments(isType)
            c = 0
        } else if isType {
            // `Args...`: the pack's name stands for the pack itself.
            const outerPlaceholders = scope.packPlaceholders
            // (Expanded by its own `...`, not by a fold's element around
            // it: `(0 + ... + A<W<Js>, Ls...>{}())`.)
            const outerIndex = scope.packIndex
            if argumentEndsWithEllipsis() {
                scope.packPlaceholders = true
                scope.packIndex = -1
            }
            if !decl.isTypename(cursor.peek()) { cursor.fail("expected a type as the template argument") }
            base.putWord(c + 32, cursor.save())
            var ty: usize = 0
            if patternDepth > 0 && cursor.is(names.K_DECLTYPE) && argumentDependsOnParameter() {
                // `decltype(f(declval<Args>()...))` in a pattern: known
                // in the instance only (not deduced from).
                skipArgument()
                ty = types.templateParameter(-3)
            } else {
                ty = decl.typeName()
            }
            base.putWord(c + 40, cursor.save())
            scope.packPlaceholders = outerPlaceholders
            scope.packIndex = outerIndex
            base.putWord(c, 1)
            base.putWord(c + 8, ty)
            if cursor.consume(names.P_ELLIPSIS) {
                if types.isBoundPack(ty) {
                    // `Args...`: the pack's elements, one argument each.
                    expanded = types.packArguments(types.at(ty).*.members)
                    c = 0
                } else if types.kind(ty) == types.TPARAM && types.at(ty).*.isPack {
                    // A pattern: `Rest...` takes the arguments left.
                    base.putWord(c, 4)
                } else if patternDepth > 0 {
                    // `decay<Ts>::type...` in a pattern: a dependent
                    // type over a pack; not deduced from.
                    base.putWord(c, 7)
                } else {
                    cursor.fail("only a parameter pack expands with ...")
                }
            }
        } else if patternDepth > 0 && argumentDependsOnParameter() {
            // `is_integral<T>::value` in a pattern: a value that is not
            // known before the instance; not deduced from.
            base.putWord(c, 6)
            base.putWord(c + 8, cursor.save())
            skipArgument()
            base.putWord(c + 16, cursor.save())
        } else if patternDepth > 0 && patternValueParameter() >= 0 {
            // `MemPool<N>` in a function template's signature, N one of
            // its parameters: deduced from the argument's instance;
            // `Is...` in a pattern: a value pack taking the rest.
            base.putWord(c, 2)
            base.putWord(c + 16, @intCast(usize, patternValueParameter()))
            cursor.advance()
            if cursor.consume(names.P_ELLIPSIS) { base.putWord(c, 5) }
        } else if cursor.isIdent() && cursor.isToken(cursor.peekNext(), names.P_ELLIPSIS) && valuePackHere() != 0 {
            // `Is...`: a bound value pack's elements, one argument each.
            expanded = types.packArguments(valuePackHere())
            c = 0
            cursor.advance()
            cursor.advance()
        } else if p != 0 && (isFunctionPointer(base.getWord(p + 16)) || functionArgumentAhead(base.getWord(p + 16))) {
            // A function as the argument (`&isLessThan<T>`, `f`; for an
            // `auto` parameter too): kind 10, the function at +8.
            const outer = expr.inTemplateArguments
            expr.inTemplateArguments = true
            const e = expr.conditional()
            expr.inTemplateArguments = outer
            base.putWord(c, 10)
            base.putWord(c + 8, functionNamed(e, base.getWord(p + 16)))
        } else {
            const outer = expr.inTemplateArguments
            expr.inTemplateArguments = true
            readValueArgument(c, p)
            expr.inTemplateArguments = outer
        }
        // The cells made (one, or an expansion's), each to the pack's
        // holder once it is reached, else to a parameter of its own.
        var made = if c != 0 { c } else { expanded }
        while made != 0 {
            const next = base.getWord(made + 24)
            const cell = if c != 0 { made } else { copyCell(made) }
            if holder != 0 {
                types.addPackArgument(holder, cell)
            } else {
                base.putWord(cell + 24, 0)
                if head == 0 { head = cell } else { base.putWord(tail + 24, cell) }
                tail = cell
                count += 1
                // In a pattern a pack parameter takes every argument
                // from its place on (`Tuple<T, Rest...>`), as cells; a
                // pack argument (`Pair<Args...>`) stands for the
                // parameters from its place on.
                if base.getWord(cell) == 4 || base.getWord(cell) == 5 || base.getWord(cell) == 7 { p = 0 } else if p != 0 && !(patternDepth > 0 && base.getWord(p + 40) != 0) { p = base.getWord(p + 24) }
                if p != 0 && base.getWord(p + 40) != 0 && patternDepth == 0 {
                    holder = types.newPackHolder()
                    packIsType = base.getWord(p + 8) != 0
                    const h = base.alloc(32)
                    base.putWord(h, 3)
                    base.putWord(h + 8, holder)
                    base.putWord(tail + 24, h)
                    tail = h
                    count += 1
                    p = base.getWord(p + 24)
                } else if p == 0 && next != 0 && c == 0 {
                    cursor.fail("too many template arguments")
                }
            }
            if c != 0 { made = 0 } else { made = next }
        }
        if cursor.is(names.P_SHR) { splitShr() }
    }
    // `list<>>`: no argument before the `>>`.
    if cursor.is(names.P_SHR) { splitShr() }
    cursor.expect(names.P_GT)
    // The parameters left take their defaults, which may name the
    // parameters before them.
    const after = cursor.save()
    while p != 0 {
        const start = base.getWord(p + 32)
        if base.getWord(p + 40) != 0 {
            // A pack (in a pattern) has taken what there was.
            p = base.getWord(p + 24)
            continue
        }
        if start == 0 && partial { break }
        if start == 0 { cursor.fail("too few template arguments") }
        defaultCount += 1
        const prefix = scope.qualify(at(t).*.namespace, base.intern(base.join("defaults#", base.decimal(@intCast(u64, defaultCount)))))
        // (Bound by their qualified names: in a function's body plain
        // ones would hide the function's own `T` after.)
        scope.beginQualified()
        bindParameters(at(t).*.params, head, prefix)
        scope.endQualified()
        scope.enterPrefix(prefix)
        cursor.restore(start)
        const c = base.alloc(32)
        if base.getWord(p + 8) != 0 {
            base.putWord(c, 1)
            base.putWord(c + 8, decl.typeName())
        } else if isFunctionPointer(base.getWord(p + 16)) || functionArgumentAhead(base.getWord(p + 16)) {
            const outer = expr.inTemplateArguments
            expr.inTemplateArguments = true
            const e = expr.conditional()
            expr.inTemplateArguments = outer
            base.putWord(c, 10)
            base.putWord(c + 8, functionNamed(e, base.getWord(p + 16)))
        } else {
            const outer = expr.inTemplateArguments
            expr.inTemplateArguments = true
            readValueArgument(c, p)
            expr.inTemplateArguments = outer
        }
        scope.leaveNamespace()
        if head == 0 { head = c } else { base.putWord(tail + 24, c) }
        tail = c
        count += 1
        p = base.getWord(p + 24)
    }
    cursor.restore(after)
    return -> (head, count)
}

// `T[N]` in a pattern, the cursor at N, one of the pattern template's
// value parameters: the array length standing for it (-10 - its index,
// deduced from an argument's length), 0 for none.
pub fn patternArrayBound() -> i64 {
    if patternDepth == 0 || patternTemplate == 0 || !cursor.isIdent() || !cursor.isToken(cursor.peekNext(), names.P_RBRACKET) { return 0 }
    const index = valueParameterIndex(tokens.name(cursor.peek()))
    if index < 0 { return 0 }
    return -10 - index
}

// The index of the pattern template's value parameter the cursor names
// (an argument of its own: `<N>`, `<N,`), -1 for none.
fn patternValueParameter() -> i64 {
    if patternTemplate == 0 || !cursor.isIdent() { return -1 }
    const next = cursor.peekNext()
    if !cursor.isToken(next, names.P_COMMA) && !cursor.isToken(next, names.P_GT) && !cursor.isToken(next, names.P_SHR) && !cursor.isToken(next, names.P_ELLIPSIS) { return -1 }
    return valueParameterIndex(tokens.name(cursor.peek()))
}

// The holder of the value pack the identifier at the cursor names, 0
// for none.
fn valuePackHere() -> usize {
    const binding = scope.find(tokens.name(cursor.peek()))
    if binding == 0 || scope.at(binding).*.kind != scope.PACK { return 0 }
    return scope.at(binding).*.obj
}

fn valueParameterIndex(name: u32) -> i64 {
    var p = at(patternTemplate).*.params
    var index: i64 = 0
    while p != 0 {
        if @intCast(u32, base.getWord(p)) == name { return if base.getWord(p + 8) == 0 { index } else { -1 } }
        index += 1
        p = base.getWord(p + 24)
    }
    return -1
}


// Whether the template argument at the cursor (a value) names a
// template parameter: a type parameter (`sizeof(T)`), a pack, or a
// value parameter in an expression (`N + 1`); a bare value parameter
// is deduced instead (patternValueParameter).
fn argumentDependsOnParameter() -> bool {
    if patternValueParameter() >= 0 { return false }
    var t = cursor.peek()
    var level: i64 = 0
    // (`<` and `>` inside parentheses are operators: `Z<(8 > 4)>`.)
    var nested: i64 = 0
    while !tokens.isEof(t) {
        if level == 0 && nested == 0 && (tokens.is(t, names.P_COMMA) || tokens.is(t, names.P_GT) || tokens.is(t, names.P_SHR)) { break }
        if tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { nested += 1 }
        if (tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE)) && nested > 0 { nested -= 1 }
        if nested == 0 && tokens.is(t, names.P_LT) { level += 1 }
        if nested == 0 && tokens.is(t, names.P_GT) { level -= 1 }
        if nested == 0 && tokens.is(t, names.P_SHR) { level -= 2 }
        if tokens.is(t, names.P_SEMI) { return false }
        if tokens.kind(t) == tokens.IDENT {
            const name = tokens.name(t)
            const binding = scope.find(name)
            if binding != 0 {
                const b = scope.at(binding)
                if b.*.kind == scope.PACK { return true }
                if b.*.kind == scope.TYPEDEF && types.kind(b.*.ty) == types.TPARAM { return true }
            }
            if patternTemplate != 0 && valueParameterIndex(name) >= 0 { return true }
        }
        t = tokens.next(t)
    }
    return false
}

// Whether the parenthesized tokens after the cursor's `(` (the cursor
// past it) name a template parameter of the pattern being read; the
// cursor unmoved.
pub fn parenthesizedDependsOnParameter() -> bool {
    var t = cursor.peek()
    var level: i64 = 0
    while !tokens.isEof(t) {
        if tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_RPAREN) {
            if level == 0 { return false }
            level -= 1
        }
        if tokens.kind(t) == tokens.IDENT {
            const name = tokens.name(t)
            const binding = scope.find(name)
            if binding != 0 {
                const b = scope.at(binding)
                if b.*.kind == scope.PACK { return true }
                if b.*.kind == scope.TYPEDEF && types.kind(b.*.ty) == types.TPARAM { return true }
                if b.*.kind == scope.VARIABLE && types.kind(ast.obj(b.*.obj).*.ty) == types.TPARAM { return true }
            }
            if patternTemplate != 0 && valueParameterIndex(name) >= 0 { return true }
        }
        t = tokens.next(t)
    }
    return false
}

// Whether two function templates' patterns take the same parameters
// (each template's parameters as alike placeholders).
fn samePatternSignature(first: usize, second: usize) -> bool {
    var p = types.at(first).*.params
    var q = types.at(second).*.params
    while p != 0 && q != 0 {
        if !sameShape(types.param(p).*.ty, types.param(q).*.ty) { return false }
        p = types.param(p).*.next
        q = types.param(q).*.next
    }
    return p == 0 && q == 0
}

fn sameShape(a: usize, b: usize) -> bool {
    const ka = types.kind(a)
    const kb = types.kind(b)
    if ka == types.TPARAM && kb == types.TPARAM { return true }
    if ka != kb { return false }
    if ka == types.PTR || ka == types.REF || ka == types.ARRAY { return sameShape(types.baseOf(a), types.baseOf(b)) }
    return types.sameType(types.unqualified(a), types.unqualified(b))
}

// Passes the template argument at the cursor (to its `,` or `>`).
fn skipArgument() -> void {
    var level: i64 = 0
    // (`<` and `>` inside parentheses are operators: `Z<(N > 4)>`.)
    var nested: i64 = 0
    while !cursor.isEof() {
        if level == 0 && nested == 0 && (cursor.is(names.P_COMMA) || cursor.is(names.P_GT) || cursor.is(names.P_SHR)) { return }
        if cursor.is(names.P_LPAREN) || cursor.is(names.P_LBRACKET) || cursor.is(names.P_LBRACE) { nested += 1 }
        if (cursor.is(names.P_RPAREN) || cursor.is(names.P_RBRACKET) || cursor.is(names.P_RBRACE)) && nested > 0 { nested -= 1 }
        if nested == 0 {
            if cursor.is(names.P_LT) { level += 1 }
            // (`is_same_v<C, X>>`: the `>>` closes the argument's list
            // and the one around it, made two `>`.)
            if cursor.is(names.P_SHR) && level == 1 { splitShr() }
            if cursor.is(names.P_GT) { level -= 1 }
            if cursor.is(names.P_SHR) { level -= 2 }
        }
        cursor.advance()
    }
}

// The template argument pattern at the cursor (`decay<Ts>::type...`,
// `(Is * 2)...`) over a bound pack: its elements as a chain of cells,
// 0 when the pack is empty. The first reading notes the pack
// (scope.packSeen) and stands for its first element, the others are
// read again with scope.packIndex set.
fn expandedArguments(isType: bool) -> usize {
    const start = cursor.save()
    // A pattern over an empty pack (`typename Others::TraitType...` with
    // no Others) names nothing that could be read: passed over.
    var t = cursor.peek()
    var level: i64 = 0
    var empty = false
    while !tokens.isEof(t) {
        if level == 0 && tokens.is(t, names.P_ELLIPSIS) { break }
        if tokens.is(t, names.P_LT) || tokens.is(t, names.P_LPAREN) { level += 1 }
        if tokens.is(t, names.P_GT) || tokens.is(t, names.P_RPAREN) { level -= 1 }
        if level < 0 { break }
        if tokens.kind(t) == tokens.IDENT {
            const b = scope.find(tokens.name(t))
            if b != 0 && scope.at(b).*.kind == scope.PACK && scope.at(b).*.ty != 0 && types.packCount(scope.at(b).*.obj) == 0 && !scope.packPlaceholders { empty = true }
        }
        t = tokens.next(t)
    }
    if empty && tokens.is(t, names.P_ELLIPSIS) {
        cursor.restore(tokens.next(t))
        return 0
    }
    const outerSeen = scope.packSeen
    scope.packSeen = 0
    var head: usize = 0
    var tail: usize = 0
    var index: i64 = 0
    var n: i64 = 1
    while index < n {
        if index > 0 {
            cursor.restore(start)
            scope.packIndex = index
        }
        const c = base.alloc(32)
        if isType {
            if !decl.isTypename(cursor.peek()) { cursor.fail("expected a type as the template argument") }
            base.putWord(c, 1)
            base.putWord(c + 8, decl.typeName())
        } else {
            const outer = expr.inTemplateArguments
            expr.inTemplateArguments = true
            readValueArgument(c, 0)
            expr.inTemplateArguments = outer
        }
        scope.packIndex = -1
        cursor.expect(names.P_ELLIPSIS)
        if index == 0 {
            const holder = scope.packSeen
            if holder == 0 { tokens.errorAt(start, "only a parameter pack expands with ...") }
            n = types.packCount(holder)
            if n == 0 { break }
        }
        if head == 0 { head = c } else { base.putWord(tail + 24, c) }
        tail = c
        index += 1
    }
    scope.packSeen = outerSeen
    return head
}

// Whether the type name at the cursor goes on as an expression
// (`sizeof(T)`, `N::value * 2`, `T::size()`): a name followed by an
// operator, not by `,` or `>` (or `>>`), is a value.
fn startsValueExpression() -> bool {
    const start = cursor.save()
    const ignored = decl.typeName()
    const value = !(cursor.is(names.P_COMMA) || cursor.is(names.P_GT) || cursor.is(names.P_SHR) || cursor.is(names.P_ELLIPSIS))
    cursor.restore(start)
    return value
}

// Whether the template argument at the cursor ends with `...`.
fn argumentEndsWithEllipsis() -> bool {
    var t = cursor.peek()
    var level: i64 = 0
    var previous: usize = 0
    while !tokens.isEof(t) {
        if level == 0 && (tokens.is(t, names.P_COMMA) || tokens.is(t, names.P_GT) || tokens.is(t, names.P_SHR)) { break }
        if tokens.is(t, names.P_LT) || tokens.is(t, names.P_LPAREN) || tokens.is(t, names.P_LBRACKET) || tokens.is(t, names.P_LBRACE) { level += 1 }
        if tokens.is(t, names.P_GT) || tokens.is(t, names.P_RPAREN) || tokens.is(t, names.P_RBRACKET) || tokens.is(t, names.P_RBRACE) { level -= 1 }
        if tokens.is(t, names.P_SHR) { level -= 2 }
        if tokens.is(t, names.P_SEMI) { return false }
        previous = t
        t = tokens.next(t)
    }
    return previous != 0 && tokens.is(previous, names.P_ELLIPSIS)
}

// `vector<vector<int>>`: the `>>` at the cursor closes twice, made two
// `>` tokens.
fn splitShr() -> void {
    const first = cursor.peek()
    const second = tokens.copy(first)
    tokens.at(second).*.name = names.P_GT
    tokens.at(second).*.length = 1
    tokens.at(second).*.start = tokens.at(first).*.start + 1
    tokens.at(second).*.next = tokens.at(first).*.next
    tokens.at(first).*.name = names.P_GT
    tokens.at(first).*.length = 1
    tokens.at(first).*.next = second
}

// The arguments' codes, `i,3` for <int, 3>.
fn argumentCodes(args: usize) -> []const u8 {
    const mark = base.buildMark()
    emitArguments(args)
    return base.keepBuilt(mark)
}

// The arguments' codes appended to the text being built.
fn emitArguments(args: usize) -> void {
    var c = args
    while c != 0 {
        if c != args { base.append(",") }
        const kind = base.getWord(c)
        if kind == 3 {
            base.append("(")
            emitArguments(types.packArguments(base.getWord(c + 8)))
            base.append(")")
        } else if kind == 4 || kind == 7 {
            mangle.emitType(base.getWord(c + 8))
            base.append("...")
        } else if kind == 5 {
            base.append("v...")
        } else if kind == 6 {
            // A value not known before the instance: its tokens
            // (`enable_if<!is_integral_v<T>, int>` is not
            // `enable_if<is_integral_v<T>, int>`).
            base.append("?(")
            emitDependentText(base.getWord(c + 8), base.getWord(c + 16))
            base.append(")")
        } else if kind == 9 {
            base.append("?")
        } else if kind == 8 {
            base.append("#")
            base.append(base.nameOf(at(base.getWord(c + 8)).*.name))
        } else if kind == 10 {
            const fn0 = base.getWord(c + 8)
            const symbol = if ast.obj(fn0).*.linkName != 0 { ast.obj(fn0).*.linkName } else { ast.obj(fn0).*.name }
            base.append("&")
            base.append(base.nameOf(symbol))
        } else if kind != 0 {
            mangle.emitType(base.getWord(c + 8))
        } else {
            // (A value of a type of its own, an `auto` parameter's: the
            // type first, `enumName<Kind::C>` apart from `<2>`.)
            if base.getWord(c + 8) != 0 {
                base.append("L")
                mangle.emitType(base.getWord(c + 8))
            }
            const value = @bitCast(i64, base.getWord(c + 16))
            if value < 0 {
                base.append("n")
                base.appendDecimal(@intCast(u64, 0 - value))
            } else {
                base.appendDecimal(@intCast(u64, value))
            }
        }
        c = base.getWord(c + 24)
    }
}

// Whether the argument at the cursor is a function (`f`, `&f`) for a
// parameter of type `ty` that is no integer (`template <auto fn>`).
fn functionArgumentAhead(ty: usize) -> bool {
    if ty == 0 || types.isInteger(ty) || types.kind(ty) == types.ENUM { return false }
    var t = cursor.peek()
    if tokens.is(t, names.P_AMP) { t = tokens.next(t) }
    if tokens.kind(t) != tokens.IDENT { return false }
    const after = tokens.next(t)
    if !(tokens.is(after, names.P_COMMA) || tokens.is(after, names.P_GT) || tokens.is(after, names.P_SHR)) { return false }
    const binding = scope.find(tokens.name(t))
    return binding != 0 && scope.at(binding).*.kind == scope.VARIABLE && ast.obj(scope.at(binding).*.obj).*.isFunction
}

// The function the template argument `e` names (`&f`, `f`, an overload
// of the parameter's type `ty`).
fn functionNamed(e: usize, ty: usize) -> usize {
    var n = e
    while ast.kindOf(n) == ast.ADDR || ast.kindOf(n) == ast.CAST { n = ast.node(n).*.lhs }
    if ast.kindOf(n) != ast.VAR || !ast.obj(ast.node(n).*.variable).*.isFunction { ast.errorAt(e, "expected a function as the template argument") }
    var o = ast.node(n).*.variable
    // Of overloads, the one of the parameter's type.
    var candidate = if isFunctionPointer(ty) { o } else { 0 }
    while candidate != 0 {
        if decl.sameSignature(ast.obj(candidate).*.ty, types.baseOf(ty)) {
            o = candidate
            break
        }
        candidate = ast.obj(candidate).*.nextOverload
    }
    ast.obj(o).*.isReferenced = true
    return o
}

// The text of the tokens from `start` up to `end` (cursor positions),
// appended to the text being built.
fn emitDependentText(start: usize, end: usize) -> void {
    const saved = cursor.save()
    cursor.restore(start)
    var count: usize = 0
    while cursor.save() != end && count < 200 && !tokens.isEof(cursor.peek()) {
        base.append(tokens.text(cursor.peek()))
        base.append(" ")
        cursor.advance()
        count += 1
    }
    cursor.restore(saved)
}

fn instanceKey(t: usize, args: usize) -> u32 {
    const mark = base.buildMark()
    base.append(base.nameOf(at(t).*.name))
    base.append("<")
    emitArguments(args)
    base.append(">")
    return base.internBuilt(mark)
}

fn cached(t: usize, key: u32) -> usize {
    var c = at(t).*.instances
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == key { return base.getWord(c + 8) }
        c = base.getWord(c + 16)
    }
    return 0
}

fn cache(t: usize, key: u32, result: usize) -> void {
    const c = base.alloc(24)
    base.putWord(c, @intCast(usize, key))
    base.putWord(c + 8, result)
    base.putWord(c + 16, at(t).*.instances)
    at(t).*.instances = c
}

fn dependent(args: usize) -> bool {
    var c = args
    while c != 0 {
        if base.getWord(c) == 2 || base.getWord(c) == 4 || base.getWord(c) == 5 || base.getWord(c) == 6 || base.getWord(c) == 7 || base.getWord(c) == 9 { return true }
        if base.getWord(c) == 3 && dependent(types.packArguments(base.getWord(c + 8))) { return true }
        if base.getWord(c) == 1 && dependentType(base.getWord(c + 8)) { return true }
        c = base.getWord(c + 24)
    }
    return false
}

// Whether a type is a template parameter's, or made of one (`T *`,
// `const T &`, `T[4]`).
fn dependentType(ty: usize) -> bool {
    var t = ty
    var steps: u32 = 0
    while t != 0 && steps < 64 {
        const k = types.kind(t)
        if k == types.TPARAM { return true }
        if k != types.PTR && k != types.REF && k != types.ARRAY { return false }
        t = types.baseOf(t)
        steps += 1
    }
    return false
}

// Whether the function type `f`'s result or parameters are made of a
// template parameter.
fn functionTypeDependent(f: usize) -> bool {
    if dependentType(types.baseOf(f)) { return true }
    var p = types.at(f).*.params
    while p != 0 {
        if dependentType(types.param(p).*.ty) { return true }
        p = types.param(p).*.next
    }
    return false
}

// Binds the parameters `params` (cells as Template.params) to `args`
// under `prefix`.
fn bindParameters(params: usize, args: usize, prefix: u32) -> void {
    scope.enterPrefix(prefix)
    var p = params
    var a = args
    while p != 0 && a != 0 {
        const name = @intCast(u32, base.getWord(p))
        if base.getWord(p + 40) != 0 {
            if base.getWord(a) != 3 { cursor.fail("a pack was expected as the template argument") }
            const bound = scope.bindPack(name, types.boundPack(base.getWord(a + 8)), base.getWord(a + 8))
        } else if base.getWord(p + 8) == 2 {
            if base.getWord(a) != 8 { cursor.fail("a template was expected as the template argument") }
            const bound = scope.bindTemplate(name, base.getWord(a + 8))
        } else if base.getWord(p + 8) != 0 {
            if base.getWord(a) != 1 { cursor.fail("a type was expected as the template argument") }
            const bound = scope.bindTypedef(name, base.getWord(a + 8))
        } else if base.getWord(a) == 10 && !isFunctionPointer(base.getWord(p + 16)) {
            // An `auto` parameter given a function: a pointer to it
            // (`decltype(fn)`), calls going to the function.
            const f = base.getWord(a + 8)
            const alias = base.alloc(@sizeOf(ast.Obj))
            base.copy(alias, f, @sizeOf(ast.Obj))
            ast.obj(alias).*.nextOverload = 0
            ast.obj(alias).*.isDefinition = false
            ast.obj(alias).*.usingOf = f
            ast.obj(alias).*.asPointer = true
            const bound = scope.bindVariable(name, alias)
        } else if base.getWord(a) == 10 {
            // A function pointer parameter: the function itself.
            const bound = scope.bindVariable(name, base.getWord(a + 8))
        } else if base.getWord(a) == 2 || base.getWord(a) == 6 {
            // A pattern's value (a partial specialization's parameter,
            // a dependent one): nothing known to bind (a default after
            // it is read without it).
        } else {
            if base.getWord(a) != 0 { cursor.fail("a value was expected as the template argument") }
            const valueType = if isAutoParameter(p) && base.getWord(a + 8) != 0 { base.getWord(a + 8) } else { base.getWord(p + 16) }
            const bound = scope.bindEnumConstant(name, valueType, @bitCast(i64, base.getWord(a + 16)))
        }
        p = base.getWord(p + 24)
        a = base.getWord(a + 24)
    }
    scope.leaveNamespace()
}

// ---------------------------------------------------------------------------
// Instantiation

// What is put aside while an instance is read: the cursor, the function
// being read, the block scopes, the declaration state.
const Context = struct {
    cursor: usize
    state: usize
    declaration: usize
    inArguments: bool
    open: u32
    // The pack expansion being read where the instance is needed (its
    // element index): none inside the instance.
    packIndex: i64
    // The class whose member's default initializer is being read (its
    // members named alone): none inside the instance.
    initOwner: usize
    exposeSuspended: bool
    lambdaCurrent: usize
    patternTemplate: usize
    packSeen: usize
    packPlaceholders: bool
    unevaluated: u32
    // The prefixes entered around the instance (an injected class name
    // is looked for above them only).
    prefixFloor: usize
    // A template's pattern being read where the instance is needed (an
    // instance is no pattern: its value arguments are known).
    patternDepth: u32
}

fn contextAt(c: usize) -> *Context {
    unsafe { return @ptrFromInt(*Context, c) }
}

// The same for a lambda's body (lambda.mlx), read as a member function
// of its closure class while the function around is put aside.
// (A lambda's or a local class's: the classes around stay in sight, their
// bases' names too.)
pub fn beginContext() -> usize {
    const floor = scope.prefixFloor
    const c = beginInstance()
    scope.prefixFloor = floor
    scope.exposeSuspended = true
    return c
}
pub fn endContext(c: usize) -> void { endInstance(c) }

// How deep instances are being made in one another (GCC's limit is 900).
var instanceDepth: u32 = 0

fn beginInstance() -> usize {
    const where = cursor.peek()
    base.pushTrace(@intCast(u32, tokens.at(where).*.file), tokens.at(where).*.line)
    instanceDepth += 1
    if instanceDepth > 300 { tokens.errorAt(where, "template instances nest too deeply (an instance that needs itself?)") }
    const c = base.alloc(@sizeOf(Context))
    contextAt(c).*.cursor = cursor.save()
    contextAt(c).*.state = state.save()
    contextAt(c).*.declaration = decl.suspendDeclarations()
    contextAt(c).*.inArguments = expr.inTemplateArguments
    contextAt(c).*.open = instancesOpen
    contextAt(c).*.packIndex = scope.packIndex
    contextAt(c).*.packSeen = scope.packSeen
    contextAt(c).*.packPlaceholders = scope.packPlaceholders
    contextAt(c).*.unevaluated = expr.unevaluated
    contextAt(c).*.prefixFloor = scope.prefixFloor
    contextAt(c).*.patternDepth = patternDepth
    contextAt(c).*.initOwner = cpp.initOwnerClass
    cpp.initOwnerClass = 0
    contextAt(c).*.exposeSuspended = scope.exposeSuspended
    scope.exposeSuspended = false
    // (An instance made inside a lambda's body is not in that lambda.)
    contextAt(c).*.lambdaCurrent = lambda.current
    lambda.current = 0
    // (A `requires` after a member's parameters in the instance is not
    // the constraint of a template whose signature asked for it.)
    contextAt(c).*.patternTemplate = patternTemplate
    patternTemplate = 0
    patternDepth = 0
    scope.prefixFloor = scope.prefixCount()
    scope.packIndex = -1
    scope.packSeen = 0
    scope.packPlaceholders = false
    expr.unevaluated = 0
    expr.inTemplateArguments = false
    instancesOpen = 0
    scope.suspend()
    state.startFunction(0)
    return c
}

fn endInstance(c: usize) -> void {
    base.popTrace()
    instanceDepth -= 1
    scope.resume()
    decl.resumeDeclarations(contextAt(c).*.declaration)
    state.restore(contextAt(c).*.state)
    cursor.restore(contextAt(c).*.cursor)
    expr.inTemplateArguments = contextAt(c).*.inArguments
    instancesOpen = contextAt(c).*.open
    scope.packIndex = contextAt(c).*.packIndex
    scope.packSeen = contextAt(c).*.packSeen
    scope.packPlaceholders = contextAt(c).*.packPlaceholders
    expr.unevaluated = contextAt(c).*.unevaluated
    scope.prefixFloor = contextAt(c).*.prefixFloor
    patternDepth = contextAt(c).*.patternDepth
    cpp.initOwnerClass = contextAt(c).*.initOwner
    scope.exposeSuspended = contextAt(c).*.exposeSuspended
    lambda.current = contextAt(c).*.lambdaCurrent
    patternTemplate = contextAt(c).*.patternTemplate
}

// The instances being read: cells of (key, next, template).
var openInstances: usize = 0

// How many instances of the template `t` are being read.
fn openCount(t: usize) -> u32 {
    var count: u32 = 0
    var c = openInstances
    while c != 0 {
        if base.getWord(c + 16) == t { count += 1 }
        c = base.getWord(c + 8)
    }
    return count
}

fn isOpen(key: u32) -> bool {
    var c = openInstances
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == key { return true }
        c = base.getWord(c + 8)
    }
    return false
}

// `name<args>` of the class template `t`, at the name: its instance
// (read now when new), or a dependent placeholder when an argument is
// a function template's parameter.
pub fn classTypeHere(binding: usize) -> usize {
    const t = scope.at(binding).*.obj
    cursor.advance()
    // The arguments' declarators reset decl.typedefSpecifiers.
    const inTypedef = decl.typedefSpecifiers
    const argumentsStart = cursor.peek()
    const read = parseArguments(t)
    if at(t).*.isAlias && patternDepth > 0 && at(t).*.start != 0 && aliasDropsDependent(t, read.0) {
        // `void_t<decltype(f(declval<T>()))>`: what the alias names says
        // nothing of its argument, which must be valid; the pattern is
        // read again with the deduced parameters (recheckArgument).
        decl.typedefSpecifiers = inTypedef
        return types.templateParameter(-3)
    }
    if at(t).*.isAlias && patternDepth > 0 && at(t).*.start != 0 {
        // An alias in a pattern (`index_sequence<Is...>`): what it names,
        // its parameters replaced by the arguments' tokens, so that the
        // pattern is the class template's (deduced against instances).
        const after = cursor.save()
        const expanded = aliasTokens(t, argumentsStart, after)
        if expanded != 0 {
            cursor.restore(expanded)
            // The alias's names are its namespace's.
            const ty = decl.typeName()
            cursor.restore(after)
            decl.typedefSpecifiers = inTypedef
            return ty
        }
    }
    decl.typedefSpecifiers = inTypedef
    // `T<A>::member`: the instance is needed whole, typedef or not.
    namedForMember = cursor.is(names.P_SCOPE)
    const args = read.0
    var valueArgument = false
    var a = args
    while a != 0 {
        if base.getWord(a) == 0 { valueArgument = true }
        a = base.getWord(a + 24)
    }
    if dependent(args) || (patternDepth > 0 && valueArgument) || at(t).*.standsFor != 0 {
        // A pattern `vector<T>`: the template and its arguments, for
        // deduction against an instance.
        const ty = types.templateParameter(-1)
        types.at(ty).*.params = t
        types.at(ty).*.members = args
        return ty
    }
    return instantiateClass(t, if patternDepth > 0 { packedArguments(t, args) } else { args })
}

// A pattern's arguments known whole (`tl<Ts...>`, Ts the enclosing
// class's bound pack) are cells one per argument: those from the pack
// parameter's place on go into one holder (kind 3), as an instance's.
fn packedArguments(t: usize, args: usize) -> usize {
    var p = at(t).*.params
    var a = args
    var last: usize = 0
    while p != 0 && base.getWord(p + 40) == 0 && a != 0 {
        last = a
        p = base.getWord(p + 24)
        a = base.getWord(a + 24)
    }
    if p == 0 || base.getWord(p + 40) == 0 { return args }
    if a != 0 && base.getWord(a) == 3 { return args }
    const holder = types.newPackHolder()
    while a != 0 {
        const next = base.getWord(a + 24)
        types.addPackArgument(holder, copyCell(a))
        a = next
    }
    const h = base.alloc(48)
    base.putWord(h, 3)
    base.putWord(h + 8, holder)
    if last == 0 { return h }
    base.putWord(last + 24, h)
    return args
}

// Whether the alias template `t` given the pattern arguments `args`
// drops one that depends on a parameter in a way not deduced (a
// decltype, a dependent value): its definition does not name the
// alias's parameter for it.
fn aliasDropsDependent(t: usize, args: usize) -> bool {
    var p = at(t).*.params
    var a = args
    while p != 0 && a != 0 {
        const k = base.getWord(a)
        var dependentHere = k == 6 || k == 7 || (k == 1 && needsRecheck(base.getWord(a + 8)))
        if k == 3 {
            var e = types.packArguments(base.getWord(a + 8))
            while e != 0 {
                if base.getWord(e) == 6 || base.getWord(e) == 7 || (base.getWord(e) == 1 && needsRecheck(base.getWord(e + 8))) { dependentHere = true }
                e = base.getWord(e + 24)
            }
        }
        if dependentHere {
            // Named in the definition?
            const name = @intCast(u32, base.getWord(p))
            var d = at(t).*.start
            var named = false
            while !tokens.isEof(d) && !tokens.is(d, names.P_SEMI) {
                if tokens.kind(d) == tokens.IDENT && tokens.name(d) == name { named = true }
                d = tokens.next(d)
            }
            if !named { return true }
        }
        if base.getWord(p + 40) == 0 { p = base.getWord(p + 24) }
        a = base.getWord(a + 24)
    }
    return false
}

// The tokens of what the alias template `t` names (its definition to
// the `;`), each of its parameters replaced by the tokens of the
// argument given for it between `open` (the `<`) and `end` (after the
// `>`): a pack parameter by the arguments left (an argument's own `...`
// left out: the definition expands the pack itself). 0 when the
// arguments do not split.
fn aliasTokens(t: usize, open: usize, end: usize) -> usize {
    // The arguments' token ranges (first, last), at most 32; the last
    // token before `end` is the closing `>`.
    const ranges = base.alloc(32 * 16)
    var count: usize = 0
    var scan = tokens.next(open)
    var first = scan
    var last: usize = 0
    var level: i64 = 0
    // (`<` and `>` inside parentheses are operators: `conditional_t<(N
    // > 4), A, B>`.)
    var nested: i64 = 0
    while scan != end && !tokens.isEof(scan) {
        const closing = tokens.next(scan) == end
        if closing || (level == 0 && nested == 0 && tokens.is(scan, names.P_COMMA)) {
            if first != scan {
                if count >= 32 { return 0 }
                base.putWord(ranges + count * 16, first)
                base.putWord(ranges + count * 16 + 8, last)
                count += 1
            }
            first = tokens.next(scan)
        } else {
            if tokens.is(scan, names.P_LPAREN) || tokens.is(scan, names.P_LBRACKET) { nested += 1 }
            if (tokens.is(scan, names.P_RPAREN) || tokens.is(scan, names.P_RBRACKET)) && nested > 0 { nested -= 1 }
            if nested == 0 && tokens.is(scan, names.P_LT) { level += 1 }
            if nested == 0 && tokens.is(scan, names.P_GT) { level -= 1 }
            if nested == 0 && tokens.is(scan, names.P_SHR) { level -= 2 }
            last = scan
        }
        scan = tokens.next(scan)
    }
    // The definition's tokens, copied with the substitutions.
    var head: usize = 0
    var tail: usize = 0
    var d = at(t).*.start
    while !tokens.isEof(d) && !tokens.is(d, names.P_SEMI) {
        var index: usize = 0
        var p = at(t).*.params
        var found: usize = 0
        var isPack = false
        while p != 0 {
            if tokens.kind(d) == tokens.IDENT && @intCast(u32, base.getWord(p)) == tokens.name(d) {
                found = p
                isPack = base.getWord(p + 40) != 0
                break
            }
            index += 1
            p = base.getWord(p + 24)
        }
        if found == 0 {
            // A name of the alias's namespace, qualified (`::std::name`):
            // the expansion is read where the alias is used.
            const ns = at(t).*.namespace
            if ns != 0 && tokens.kind(d) == tokens.IDENT && !(tail != 0 && (tokens.is(tail, names.P_SCOPE) || tokens.is(tail, names.P_DOT) || tokens.is(tail, names.P_ARROW))) && (scope.findQualified(ns, tokens.name(d), false) != 0 || scope.findQualified(ns, tokens.name(d), true) != 0) {
                const path = base.nameOf(ns)
                var from: usize = 0
                var k: usize = 0
                while k <= path.length {
                    if k == path.length || (k + 1 < path.length && path[k] == 58 && path[k + 1] == 58) {
                        const colons = tokens.copy(d)
                        tokens.at(colons).*.kind = tokens.PUNCT
                        tokens.at(colons).*.name = names.P_SCOPE
                        if head == 0 { head = colons } else { tokens.at(tail).*.next = colons }
                        tail = colons
                        const part = tokens.copy(d)
                        tokens.at(part).*.name = base.intern(path[from..k])
                        tokens.at(tail).*.next = part
                        tail = part
                        from = k + 2
                        k += 2
                        continue
                    }
                    k += 1
                }
                const colons = tokens.copy(d)
                tokens.at(colons).*.kind = tokens.PUNCT
                tokens.at(colons).*.name = names.P_SCOPE
                tokens.at(tail).*.next = colons
                tail = colons
            }
            const copy = tokens.copy(d)
            if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
            tail = copy
        } else if !isPack && index >= count && base.getWord(found + 32) != 0 {
            // Not given: the parameter's default (`enable_if_t<B>`'s
            // `void`), its tokens as written.
            var u = base.getWord(found + 32)
            var level: i64 = 0
            while !tokens.isEof(u) {
                if level == 0 && (tokens.is(u, names.P_COMMA) || tokens.is(u, names.P_GT) || tokens.is(u, names.P_SHR)) { break }
                if tokens.is(u, names.P_LT) || tokens.is(u, names.P_LPAREN) || tokens.is(u, names.P_LBRACKET) { level += 1 }
                if tokens.is(u, names.P_GT) || tokens.is(u, names.P_RPAREN) || tokens.is(u, names.P_RBRACKET) { level -= 1 }
                if tokens.is(u, names.P_SHR) { level -= 2 }
                const copy = tokens.copy(u)
                if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
                tail = copy
                u = tokens.next(u)
            }
        } else {
            var arg = index
            const lastArg = if isPack { count } else { index + 1 }
            if !isPack && index >= count { return 0 }
            while arg < lastArg {
                if arg > index {
                    const comma = tokens.copy(d)
                    tokens.at(comma).*.kind = tokens.PUNCT
                    tokens.at(comma).*.name = names.P_COMMA
                    if head == 0 { head = comma } else { tokens.at(tail).*.next = comma }
                    tail = comma
                }
                var u = base.getWord(ranges + arg * 16)
                const last = base.getWord(ranges + arg * 16 + 8)
                while u != 0 {
                    const ellipsisAtEnd = isPack && u == last && tokens.is(u, names.P_ELLIPSIS)
                    if !ellipsisAtEnd {
                        const copy = tokens.copy(u)
                        if head == 0 { head = copy } else { tokens.at(tail).*.next = copy }
                        tail = copy
                    }
                    if u == last { break }
                    u = tokens.next(u)
                }
                arg += 1
            }
        }
        d = tokens.next(d)
    }
    if head == 0 { return 0 }
    tokens.at(tail).*.next = tokens.eof(@intCast(u32, tokens.at(open).*.file), tokens.at(open).*.line)
    return head
}

// Named where no instance is needed (a typedef, an alias): the
// instances stay incomplete until something needs them whole.
pub var deferInstances: u32 = 0
var namedForMember = false

fn declaredInstance(t: usize, key: u32, args: usize) -> usize {
    const declared = types.structType()
    types.at(declared).*.name = scope.qualify(at(t).*.namespace, key)
    scope.enterPrefix(at(t).*.namespace)
    scope.beginQualified()
    const bound = scope.bindTag(key, declared)
    scope.endQualified()
    scope.leaveNamespace()
    cache(t, key, declared)
    cpp.forwardInfo(declared, key, at(t).*.name)
    cpp.setTemplateOrigin(declared, t, args)
    return declared
}

// The classes defined in class template instances, not read yet:
// cells of (type, the `:` or `{` after the name, the prefix around it,
// the tag, the name as written, flags (1 union, 2 packed, 4 final), the
// alignment, next).
var deferredClasses: usize = 0
var readingDeferred: u32 = 0

// Whether a class defined here waits until something needs it whole:
// in a class template's instance (or such a class) being read, not in a
// function.
pub fn defersNestedClasses() -> bool {
    return (instancesOpen > 0 || readingDeferred > 0) && cpp.readingClass()
}

pub fn deferNestedClass(ty: usize, at_: usize, tagName: u32, written: u32, isUnion: bool, isPacked: bool, alignment: i64, isFinal: bool) -> void {
    const c = base.alloc(64)
    base.putWord(c, ty)
    base.putWord(c + 8, at_)
    base.putWord(c + 16, @intCast(usize, scope.currentNamespace()))
    base.putWord(c + 24, @intCast(usize, tagName))
    base.putWord(c + 32, @intCast(usize, written))
    var flags: usize = 0
    if isUnion { flags = flags | 1 }
    if isPacked { flags = flags | 2 }
    if isFinal { flags = flags | 4 }
    base.putWord(c + 40, flags)
    base.putWord(c + 48, @bitCast(usize, alignment))
    base.putWord(c + 56, deferredClasses)
    deferredClasses = c
}

pub fn isDeferredClass(ty: usize) -> bool {
    var c = deferredClasses
    while c != 0 {
        if base.getWord(c) == ty { return true }
        c = base.getWord(c + 56)
    }
    return false
}

// Reads the deferred class `ty` now (true when it was one).
fn completeDeferred(ty: usize) -> bool {
    var c = deferredClasses
    var previous: usize = 0
    while c != 0 {
        if base.getWord(c) == ty { break }
        previous = c
        c = base.getWord(c + 56)
    }
    if c == 0 { return false }
    if previous == 0 { deferredClasses = base.getWord(c + 56) } else { base.putWord(previous + 56, base.getWord(c + 56)) }
    const context = beginInstance()
    base.nameTrace(types.at(ty).*.name)
    scope.enterPrefix(@intCast(u32, base.getWord(c + 16)))
    cursor.restore(base.getWord(c + 8))
    const flags = base.getWord(c + 40)
    // (Read as an instance's member: its functions' bodies wait for a
    // call, as the instance's own do.)
    readingDeferred += 1
    instancesOpen += 1
    const made = decl.classBody(ty, true, @intCast(u32, base.getWord(c + 24)), @intCast(u32, base.getWord(c + 32)), flags & 1 != 0, flags & 2 != 0, @bitCast(i64, base.getWord(c + 48)), flags & 4 != 0)
    instancesOpen -= 1
    readingDeferred -= 1
    scope.leaveNamespace()
    endInstance(context)
    return true
}

// The deferred class whose scope is `prefix` (`Outer::Inner::x` named):
// read now.
pub fn completeNestedScope(prefix: u32) -> void {
    var c = deferredClasses
    while c != 0 {
        if types.at(base.getWord(c)).*.name == prefix {
            const done = completeDeferred(base.getWord(c))
            return
        }
        c = base.getWord(c + 56)
    }
}

// Completes the incomplete instance `ty` of a class template (made by
// declaredInstance) now that something needs it whole.
pub fn complete(ty: usize) -> void {
    if !types.at(ty).*.incomplete { return }
    if deferredClasses != 0 && completeDeferred(ty) { return }
    if isDeclaredSpecialization(ty) { return }
    const record = cpp.templateRecordOf(ty)
    if record == 0 { return }
    const args = cpp.templateArgsOf(ty)
    // (A primary declared only, `template <class> class Function;`, made
    // by its partial specialization `Function<Out(In...)>`.)
    if at(record).*.start == 0 && matchingPartial(record, args).0 == 0 { return }
    if isOpen(instanceKey(record, args)) { return }
    const outer = deferInstances
    deferInstances = 0
    const outerTypedef = decl.typedefSpecifiers
    decl.typedefSpecifiers = false
    completing = true
    const made = instantiateClass(record, args)
    completing = false
    decl.typedefSpecifiers = outerTypedef
    deferInstances = outer
}

var classDepth: u32 = 0

// The explicit specializations declared and not defined yet
// (`template <> struct DefaultHash<P>;`): cells of (type, next).
var declaredSpecializations: usize = 0

fn isDeclaredSpecialization(ty: usize) -> bool {
    if !types.at(ty).*.incomplete { return false }
    var d = declaredSpecializations
    while d != 0 {
        if base.getWord(d) == ty { return true }
        d = base.getWord(d + 8)
    }
    return false
}

// Set by complete: the instance asked for is made now.
var completing = false

// Whether one of the arguments is a class declared but not defined.
fn incompleteArgument(args: usize) -> bool {
    var c = args
    while c != 0 {
        if base.getWord(c) == 1 {
            const ty = types.unqualified(base.getWord(c + 8))
            if (types.kind(ty) == types.STRUCT || types.kind(ty) == types.UNION) && types.at(ty).*.incomplete && cpp.templateRecordOf(ty) == 0 { return true }
        }
        if base.getWord(c) == 3 && incompleteArgument(types.packArguments(base.getWord(c + 8))) { return true }
        c = base.getWord(c + 24)
    }
    return false
}

// The class template `binding`'s instance of its default arguments
// (`PreciseSum sum;` of `template <class T = Small> class
// PreciseSum`), 0 when a parameter has none.
pub fn defaultedInstance(binding: usize) -> usize {
    if !isClassTemplate(binding) { return 0 }
    const t = scope.at(binding).*.obj
    if at(t).*.isAlias || at(t).*.start == 0 { return 0 }
    var p = at(t).*.params
    if p == 0 { return 0 }
    while p != 0 {
        if base.getWord(p + 32) == 0 && base.getWord(p + 40) == 0 { return 0 }
        p = base.getWord(p + 24)
    }
    const saved = cursor.save()
    cursor.restore(cpp.generatedTokens(base.join(base.nameOf(at(t).*.name), " < > ;")))
    const ty = classTypeHere(binding)
    cursor.restore(saved)
    return ty
}

// `std::initializer_list<element>`, 0 when <initializer_list> is not
// included.
pub fn initializerListOf(element: usize) -> usize {
    const std = scope.findQualified(0, base.intern("std"), false)
    if std == 0 || scope.at(std).*.kind != scope.NAMESPACE { return 0 }
    const binding = scope.findQualified(@intCast(u32, scope.at(std).*.value), initializerListName(), false)
    if !isClassTemplate(binding) { return 0 }
    const c = base.alloc(32)
    base.putWord(c, 1)
    base.putWord(c + 8, element)
    return instantiateClass(scope.at(binding).*.obj, c)
}

fn instantiateClass(t: usize, args: usize) -> usize {
    classDepth += 1
    const made = instantiateClassAt(t, args)
    classDepth -= 1
    return made
}

fn instantiateClassAt(t: usize, args: usize) -> usize {
    const key = instanceKey(t, args)
    // (A class needing itself through other instances without end.)
    if classDepth > 400 { cursor.fail(base.join("class template instances nested too deep: ", base.nameOf(key))) }
    const known = cached(t, key)
    // Known: unless declared only (`template <class T> class X;` used
    // as a type) and the template is defined since, which completes
    // it in place now; being read (the class names itself): itself.
    if known != 0 && (!types.at(known).*.incomplete || isOpen(key) || isDeclaredSpecialization(known)) { return known }
    if known == 0 && isOpen(key) {
        // Being read, and named by a member read meanwhile (a virtual
        // function's body, completeClass): its tag is bound already.
        const tag = scope.findQualified(at(t).*.namespace, key, true)
        if tag != 0 { return scope.at(tag).*.ty }
    }
    const partial = matchingPartial(t, args)
    if known != 0 && partial.0 == 0 && at(t).*.start == 0 { return known }
    // An alias is never deferred: it is the type it names.
    // (Over a class not complete yet, as `Expected<CString, E>` in a
    // function's declaration: made when something needs it whole.)
    const forced = completing
    completing = false
    // (Named, not needed whole, inside instances of the same template
    // already: FastBitVectorImpl<W>'s `operator~` returns
    // FastBitVectorImpl<FastBitVectorNotWords<W>>, which has its own.)
    const nested = !forced && openCount(t) >= 4
    const deferred = (deferInstances > 0 || decl.typedefSpecifiers || nested || (!forced && incompleteArgument(args))) && !namedForMember && !at(t).*.isAlias
    namedForMember = false
    if deferred && known != 0 { return known }
    // (A partial specialization's instance too: `using AllPromiseType =
    // NativePromise<Vector<R>, ...>` in NativePromise names one per level.)
    if deferred { return declaredInstance(t, key, args) }
    // Completed in place: the type already named keeps its identity.
    if known != 0 && types.at(known).*.incomplete && !at(t).*.isAlias { completionTarget = known }
    if partial.0 != 0 { return instantiatePartial(t, key, args, partial.0, partial.1) }
    if at(t).*.start == 0 {
        // Declared only, or named where no instance is needed (`using X
        // = T<A>;`): an incomplete class, completed when the template is
        // defined and the instance named again, or when something needs
        // it whole (complete).
        return declaredInstance(t, key, args)
    }
    const open = base.alloc(24)
    base.putWord(open, @intCast(usize, key))
    base.putWord(open + 8, openInstances)
    base.putWord(open + 16, t)
    openInstances = open
    const context = beginInstance()
    base.nameTrace(key)
    const prefix = scope.qualify(at(t).*.namespace, key)
    bindParameters(at(t).*.params, args, prefix)
    if at(t).*.isAlias {
        scope.enterPrefix(prefix)
        cursor.restore(at(t).*.start)
        // What an alias names is made whole (its instance is the type
        // the alias is used for).
        const outerDefer = deferInstances
        const outerTypedef = decl.typedefSpecifiers
        deferInstances = 0
        decl.typedefSpecifiers = false
        const failedBefore = decl.sfinaeFailed
        decl.sfinaeFailed = false
        const aliased = decl.typeName()
        const failedHere = decl.sfinaeFailed
        decl.sfinaeFailed = failedBefore || failedHere
        deferInstances = outerDefer
        decl.typedefSpecifiers = outerTypedef
        // (A name that does not exist stops the type early: the rest of
        // it passed over.)
        if failedHere { while !cursor.is(names.P_SEMI) && !cursor.isEof() { cursor.advance() } }
        cursor.expect(names.P_SEMI)
        openInstances = base.getWord(openInstances + 8)
        // A name that does not exist for these arguments (`enable_if<
        // false>::type`) fails the candidate reading it; nothing kept.
        if !failedHere { cache(t, key, aliased) }
        scope.leaveNamespace()
        endInstance(context)
        return aliased
    }
    scope.enterPrefix(at(t).*.namespace)
    tagOverride = key
    cursor.restore(at(t).*.start)
    instancesOpen += 1
    const attr = decl.newAttr()
    const ty = decl.declspec(attr)
    tagOverride = 0
    cursor.expect(names.P_SEMI)
    openInstances = base.getWord(openInstances + 8)
    cache(t, key, ty)
    cpp.setTemplateOrigin(ty, t, args)
    // The members defined outside the class, under the instance's prefix
    // (their own parameter names bound to the arguments too).
    var m = at(t).*.memberDefs
    while m != 0 {
        applyMemberDef(t, m, args, prefix)
        m = base.getWord(m + 8)
    }
    instancesOpen -= 1
    scope.leaveNamespace()
    endInstance(context)
    return ty
}

// The member definition `m` (a cell of memberDefs) read for the
// instance of `t` with the arguments `args` under `prefix`.
fn applyMemberDef(t: usize, m: usize, args: usize, prefix: u32) -> void {
    cursor.restore(base.getWord(m))
    cursor.expect(names.K_TEMPLATE)
    const own = base.alloc(@sizeOf(Template))
    parameters(own)
    if at(own).*.paramCount != at(t).*.paramCount { cursor.fail(base.join(base.join(base.join("the member definition's template parameters differ from the class's: ", base.nameOf(at(t).*.name)), " "), base.decimal(at(own).*.paramCount))) }
    bindParameters(at(own).*.params, args, prefix)
    scope.enterPrefix(prefix)
    if cursor.is(names.K_TEMPLATE) {
        // A member template's definition: the instance's.
        const outerParams = memberDefParams
        const outerArgs = memberDefArgs
        memberDefParams = at(own).*.params
        memberDefArgs = args
        declaration()
        memberDefParams = outerParams
        memberDefArgs = outerArgs
    } else {
        const outerParams = memberDefParams
        const outerArgs = memberDefArgs
        memberDefParams = at(own).*.params
        memberDefArgs = args
        const memberAttr = decl.newAttr()
        const memberBase = decl.declspec(memberAttr)
        decl.globalDeclaration(memberBase, memberAttr)
        memberDefParams = outerParams
        memberDefArgs = outerArgs
    }
    scope.leaveNamespace()
}

// The member definition `m` of the class template `t`, read for the
// instances made before it (a member template's: its instances wait
// for it).
fn applyToEarlierInstances(t: usize, m: usize) -> void {
    var c = at(t).*.instances
    while c != 0 {
        const ty = base.getWord(c + 8)
        if ty != 0 && cpp.isClassType(ty) && !types.at(ty).*.incomplete && cpp.templateArgsOf(ty) != 0 && types.at(ty).*.name == scope.qualify(at(t).*.namespace, @intCast(u32, base.getWord(c))) {
            const key = @intCast(u32, base.getWord(c))
            const context = beginInstance()
            const prefix = scope.qualify(at(t).*.namespace, key)
            scope.enterPrefix(at(t).*.namespace)
            instancesOpen += 1
            applyMemberDef(t, m, cpp.templateArgsOf(ty), prefix)
            instancesOpen -= 1
            scope.leaveNamespace()
            endInstance(context)
        }
        c = base.getWord(c + 16)
    }
}

// The instance `key` of `t` read from the partial specialization
// `cell` (matchingPartial) with its parameters bound to `bindings`.
fn instantiatePartial(t: usize, key: u32, args: usize, cell: usize, bindings: usize) -> usize {
    const partial = base.getWord(cell)
    const keyword = base.getWord(cell + 16)
    const context = beginInstance()
    base.nameTrace(key)
    const prefix = scope.qualify(at(t).*.namespace, key)
    bindParameters(at(partial).*.params, boundArguments(partial, bindings), prefix)
    scope.enterPrefix(at(t).*.namespace)
    tagOverride = key
    // The tag's tokens: the keyword, the tag, then the pattern
    // arguments, which the class reader must not see (copies: the
    // pattern is read again in another instance of an enclosing class).
    const tag = base.getWord(cell + 32)
    const tagCopy = tokens.copy(tag)
    tokens.at(tagCopy).*.next = endOfArguments(tokens.next(tag))
    const keywordCopy = tokens.copy(keyword)
    tokens.at(keywordCopy).*.next = tagCopy
    cursor.restore(keywordCopy)
    instancesOpen += 1
    // Being read: the class naming itself (`Locker<T>` in a constrained
    // specialization's body) is this instance (instantiateClass).
    const open = base.alloc(24)
    base.putWord(open, @intCast(usize, key))
    base.putWord(open + 8, openInstances)
    base.putWord(open + 16, t)
    openInstances = open
    const attr = decl.newAttr()
    const ty = decl.declspec(attr)
    openInstances = base.getWord(open + 8)
    tagOverride = 0
    cursor.expect(names.P_SEMI)
    cache(t, key, ty)
    cpp.setTemplateOrigin(ty, t, args)
    // The specialization's members defined outside it.
    var m = at(partial).*.memberDefs
    while m != 0 {
        applyMemberDef(partial, m, boundArguments(partial, bindings), prefix)
        m = base.getWord(m + 8)
    }
    instancesOpen -= 1
    scope.leaveNamespace()
    endInstance(context)
    return ty
}

// The object standing for the function template in a call: the
// instance is chosen by the arguments (expr.buildCall).
pub fn patternOf(t: usize) -> usize { return at(t).*.pattern }

pub fn placeholder(binding: usize) -> usize {
    return placeholderFor(scope.at(binding).*.obj)
}

pub fn placeholderFor(t: usize) -> usize {
    if at(t).*.placeholder == 0 {
        const o = ast.newObj(at(t).*.name, at(t).*.pattern, 0)
        ast.obj(o).*.isFunction = true
        ast.obj(o).*.template = t
        at(t).*.placeholder = o
    }
    return at(t).*.placeholder
}

// `name<args>` of a function template, at the name: the instance.
pub fn explicitFunction(binding: usize) -> usize {
    const t = scope.at(binding).*.obj
    if !cursor.is(names.P_LT) { cursor.advance() }
    const read = parseArguments(t)
    const instance = instantiateFunction(t, read.0)
    if instance == 0 { cursor.fail("no instance of the function template takes these arguments") }
    return instance
}

// Whether the arguments `<...>` at `open` fit the kinds of the template
// `t`'s parameters (a type where a type is taken, a value where a value
// is): told by each argument's first token.
fn argumentKindsFit(t: usize, open: usize) -> bool {
    const end = endOfArguments(open)
    if end == 0 { return true }
    var p = at(t).*.params
    var x = tokens.next(open)
    var level: i64 = 0
    var first = true
    while x != 0 && !tokens.isEof(x) {
        if level == 0 && first {
            // (The `>` closing the list ends it.)
            if tokens.next(x) == end && (tokens.is(x, names.P_GT) || tokens.is(x, names.P_SHR)) { return true }
            if p == 0 { return false }
            const kind = base.getWord(p + 8)
            const here = argumentKindAt(x)
            if kind == 1 && here == 0 { return false }
            if kind == 0 && here == 1 { return false }
            first = false
            if base.getWord(p + 40) == 0 { p = base.getWord(p + 24) }
        }
        if tokens.next(x) == end { return true }
        if tokens.is(x, names.P_LPAREN) || tokens.is(x, names.P_LBRACKET) || tokens.is(x, names.P_LT) { level += 1 }
        if tokens.is(x, names.P_RPAREN) || tokens.is(x, names.P_RBRACKET) || tokens.is(x, names.P_GT) { level -= 1 }
        if tokens.is(x, names.P_SHR) { level -= 2 }
        if level == 0 && tokens.is(x, names.P_COMMA) { first = true }
        x = tokens.next(x)
    }
    return true
}

// What the template argument starting at `x` is: 1 a type, 0 a value,
// -1 not told by its start (`X<T>::value`, `C::member`).
fn argumentKindAt(x: usize) -> i64 {
    const k = tokens.kind(x)
    if k == tokens.NUMBER || k == tokens.CHAR || k == tokens.STRING || k == tokens.INTEGER || k == tokens.FLOATING { return 0 }
    if tokens.isWord(x, names.K_SIZEOF) || tokens.isWord(x, names.K_TRUE) || tokens.isWord(x, names.K_FALSE) || tokens.is(x, names.P_MINUS) || tokens.is(x, names.P_BANG) { return 0 }
    if k == tokens.KEYWORD { return if decl.isTypename(x) { 1 } else { -1 } }
    if k != tokens.IDENT { return -1 }
    const next = tokens.next(x)
    if tokens.is(next, names.P_SCOPE) {
        // `E::value` of an enum E: a value.
        const ty = scope.typedefOf(tokens.name(x))
        if ty != 0 && types.kind(ty) == types.ENUM { return 0 }
        const tag = scope.findTag(tokens.name(x))
        if tag != 0 && types.kind(scope.at(tag).*.ty) == types.ENUM { return 0 }
        // `T::atomSize`, T a class: what the class's member is.
        const member = tokens.next(next)
        const classTy = if ty != 0 { ty } else if tag != 0 { scope.at(tag).*.ty } else { 0 }
        if classTy != 0 && cpp.isClassType(classTy) && tokens.kind(member) == tokens.IDENT && !tokens.is(tokens.next(member), names.P_SCOPE) && !tokens.is(tokens.next(member), names.P_LT) {
            const prefix = types.at(types.unqualified(classTy)).*.name
            var found = scope.findQualified(prefix, tokens.name(member), false)
            if found == 0 { found = cpp.findInherited(prefix, tokens.name(member), false) }
            if found != 0 && (scope.at(found).*.kind == scope.VARIABLE || scope.at(found).*.kind == scope.ENUM_CONSTANT) { return 0 }
            if found != 0 && scope.at(found).*.kind == scope.TYPEDEF { return 1 }
        }
        return -1
    }
    if tokens.is(next, names.P_LT) { return -1 }
    return if decl.isTypename(x) { 1 } else { 0 }
}

// `name<args>(...)`, at the name: an object standing for the templates
// of the name with the arguments given, the rest deduced by the call.
pub fn explicitPlaceholder(binding: usize) -> usize {
    const t = scope.at(binding).*.obj
    // (At the name, or at its `<` already.)
    if !cursor.is(names.P_LT) { cursor.advance() }
    // (Read as the first template of the name whose parameters' kinds
    // fit them: `append<FailureAction::Crash, U>` beside `append<U>`.)
    var reader = t
    while reader != 0 && !argumentKindsFit(reader, cursor.peek()) { reader = at(reader).*.next }
    if reader == 0 { reader = t }
    const read = readArguments(reader, true)
    const o = ast.newObj(at(t).*.name, at(t).*.pattern, 0)
    ast.obj(o).*.isFunction = true
    ast.obj(o).*.template = t
    ast.obj(o).*.templateArgs = read.0
    return o
}

// Type arguments as cells (as parseArguments makes them).
// The type an argument deduces with: for a forwarding reference
// (`T &&`, T a parameter) an lvalue argument's type as a reference, so
// T is `int &` and the parameter `int &` (references collapsing).
fn argumentTypeFor(pattern: usize, arg: usize) -> usize {
    const ty = ast.typeOf(arg)
    if types.isRvalueReference(pattern) && types.kind(types.baseOf(pattern)) == types.TPARAM && !types.isConst(types.baseOf(pattern)) && !expr.isRvalueArgument(arg) {
        return types.referenceTo(ty)
    }
    return ty
}

// The template's parameter cell at `index`.
// The default of the `slot`th parameter of the function template `t`,
// the parameters before it bound as `bindings` says: a type, or the
// address of a value; 0 when it names what does not exist.
fn defaultFor(t: usize, slot: usize, bindings: usize) -> usize {
    const p = parameterCell(t, slot)
    const start = base.getWord(p + 32)
    if start == 0 { return 0 }
    var head: usize = 0
    var tail: usize = 0
    var q = at(t).*.params
    var i: usize = 0
    while i < slot {
        const c = base.alloc(32)
        const bound = base.getWord(bindings + i * 8)
        // (A parameter before it not deduced: no default can be read.)
        if bound == 0 && base.getWord(q + 40) == 0 { return 0 }
        if base.getWord(q + 40) != 0 {
            base.putWord(c, 3)
            base.putWord(c + 8, if bound != 0 { bound } else { types.newPackHolder() })
        } else if base.getWord(q + 8) == 2 {
            base.putWord(c, 8)
            base.putWord(c + 8, bound)
        } else if base.getWord(q + 8) != 0 {
            base.putWord(c, 1)
            base.putWord(c + 8, bound)
        } else {
            base.putWord(c + 16, if bound != 0 { base.getWord(bound) } else { 0 })
        }
        if head == 0 { head = c } else { base.putWord(tail + 24, c) }
        tail = c
        i += 1
        q = base.getWord(q + 24)
    }
    defaultCount += 1
    const prefix = scope.qualify(at(t).*.namespace, base.intern(base.join("defaults#", base.decimal(@intCast(u64, defaultCount)))))
    const context = beginInstance()
    bindParameters(at(t).*.params, head, prefix)
    scope.enterPrefix(prefix)
    cursor.restore(start)
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    var result: usize = 0
    if base.getWord(p + 8) == 1 {
        const ty = decl.typeName()
        if !decl.sfinaeFailed { result = ty }
    } else if base.getWord(p + 8) == 0 {
        const outer = expr.inTemplateArguments
        expr.inTemplateArguments = true
        const value = eval.constExpression()
        expr.inTemplateArguments = outer
        if !decl.sfinaeFailed {
            result = base.alloc(8)
            base.putWord(result, @bitCast(u64, value))
        }
    }
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    scope.leaveNamespace()
    endInstance(context)
    return result
}

fn parameterCell(t: usize, index: usize) -> usize {
    var p = at(t).*.params
    var i: usize = 0
    while p != 0 && i < index {
        p = base.getWord(p + 24)
        i += 1
    }
    return p
}

// The index of the template parameter pack inside `ty` (`Args &&`), -1
// for none.
fn packIndexIn(ty: usize) -> i64 {
    var t = ty
    while true {
        const k = types.kind(t)
        if k == types.TPARAM { return if types.at(t).*.isPack && types.at(t).*.arrayLength >= 0 { types.at(t).*.arrayLength } else { -1 } }
        if k == types.PTR || k == types.REF || k == types.ARRAY { t = types.baseOf(t) } else { return -1 }
    }
    return -1
}

fn copyCell(c: usize) -> usize {
    const made = base.alloc(32)
    base.copy(made, c, 32)
    base.putWord(made + 24, 0)
    return made
}

// Chains the template `t` after `first` (a class's constructor
// templates): the chain's head.
pub fn chained(first: usize, t: usize) -> usize {
    if first == 0 { return t }
    var last = first
    while at(last).*.next != 0 { last = at(last).*.next }
    at(last).*.next = t
    return first
}

// The arguments bound by deduction: a word per parameter, a type for a
// type parameter, the address of the value for a value parameter, the
// holder of a pack.
fn boundArguments(t: usize, bindings: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var index: usize = 0
    var p = at(t).*.params
    while p != 0 {
        const c = base.alloc(32)
        if base.getWord(p + 40) != 0 {
            base.putWord(c, 3)
            base.putWord(c + 8, base.getWord(bindings + index * 8))
        } else if base.getWord(p + 8) == 2 {
            base.putWord(c, 8)
            base.putWord(c + 8, base.getWord(bindings + index * 8))
        } else if base.getWord(p + 8) != 0 {
            base.putWord(c, 1)
            base.putWord(c + 8, base.getWord(bindings + index * 8))
        } else if isFunctionPointer(base.getWord(p + 16)) {
            base.putWord(c, 10)
            base.putWord(c + 8, base.getWord(base.getWord(bindings + index * 8)))
        } else {
            const valueAt = base.getWord(bindings + index * 8)
            base.putWord(c + 16, base.getWord(valueAt))
            // (An `auto` parameter's: the type beside the value.)
            if isAutoParameter(p) { base.putWord(c + 8, base.getWord(valueAt - 8)) }
        }
        if head == 0 { head = c } else { base.putWord(tail + 24, c) }
        tail = c
        index += 1
        p = base.getWord(p + 24)
    }
    return head
}

// The argument cells with each pack's holder replaced by its elements.
fn flatten(args: usize) -> usize {
    var head: usize = 0
    var tail: usize = 0
    var c = args
    while c != 0 {
        if base.getWord(c) == 3 {
            var e = types.packArguments(base.getWord(c + 8))
            while e != 0 {
                const cell = copyCell(e)
                if head == 0 { head = cell } else { base.putWord(tail + 24, cell) }
                tail = cell
                e = base.getWord(e + 24)
            }
        } else {
            const cell = copyCell(c)
            if head == 0 { head = cell } else { base.putWord(tail + 24, cell) }
            tail = cell
        }
        c = base.getWord(c + 24)
    }
    return head
}

// `Rest...` (the pack parameter `pattern`) against the argument cells
// `rest`: all of them, bound as its pack; 0 (none left).
// The parameter slot a pack pattern cell (4: a type pack, 5: a value
// pack) binds.
fn packSlotOf(cell: usize) -> usize {
    if base.getWord(cell) == 5 { return base.getWord(cell + 16) }
    return @intCast(usize, types.at(base.getWord(cell + 8)).*.arrayLength)
}

fn bindPackSlot(index: usize, rest: usize, bindings: usize) -> usize {
    const holder = types.newPackHolder()
    var a = rest
    while a != 0 {
        types.addPackArgument(holder, copyCell(a))
        a = base.getWord(a + 24)
    }
    base.putWord(bindings + index * 8, holder)
    return 0
}

// A template argument against a pattern argument: a reference pattern
// (`X<T &>`) takes a reference of its kind only (a parameter's reference binds to
// anything, deduce).
fn deduceArgument(pattern: usize, arg: usize, bindings: usize) -> bool {
    if types.isConst(pattern) && !types.isConst(arg) { return false }
    if types.kind(pattern) == types.REF {
        if types.kind(arg) != types.REF { return false }
        // (`X<T &&>` takes an rvalue reference only, `X<T &>` an lvalue one.)
        if types.isRvalueReference(pattern) != types.isRvalueReference(arg) { return false }
        return deduceArgument(types.baseOf(pattern), types.baseOf(arg), bindings)
    }
    // A type without a parameter in a pattern (`expected<void, E>`)
    // must be the argument's; in a function's parameters (deduce, from
    // callInstance) a conversion may take it.
    matchingPattern += 1
    const fits = deduce(pattern, arg, bindings, false)
    matchingPattern -= 1
    return fits
}
var matchingPattern: u32 = 0

// Deduces the template parameters in `pattern` from the argument type
// `arg` into `bindings` (one word per parameter); false when they do
// not fit.
// A declared parameter's type against a template's (an explicit
// specialization's `double &` against `T &`: T is double).
fn deduceDeclared(pattern: usize, given: usize, bindings: usize) -> bool {
    if types.kind(pattern) == types.REF && types.kind(given) == types.REF && types.isRvalueReference(pattern) == types.isRvalueReference(given) {
        return deduce(types.baseOf(pattern), types.baseOf(given), bindings, false)
    }
    return deduce(pattern, given, bindings, false)
}

fn deduce(pattern: usize, given: usize, bindings: usize, byValue: bool) -> bool {
    var arg = given
    // A braced list deduces nothing (it is made into the parameter's
    // type after), but an array's length and element: `T (&&)[N]` from
    // `{0, 1, 5}` (toArray<uint16_t>({...})).
    if cpp.isBracedMarker(arg) {
        const array = if types.kind(pattern) == types.REF { types.baseOf(pattern) } else { pattern }
        if types.kind(array) == types.ARRAY && types.at(array).*.arrayLength <= -10 {
            const slot = bindings + @intCast(usize, 0 - types.at(array).*.arrayLength - 10) * 8
            if base.getWord(slot) == 0 {
                const cell = base.alloc(8)
                base.putWord(cell, @bitCast(u64, cpp.bracedCount(arg)))
                base.putWord(slot, cell)
            }
            const element = cpp.bracedElement(arg)
            // (T from the elements unless given: `toArray<uint16_t>({0, 1})`.)
            const elementType = types.baseOf(array)
            if element != 0 && types.kind(elementType) == types.TPARAM && types.at(elementType).*.arrayLength >= 0 && base.getWord(bindings + @intCast(usize, types.at(elementType).*.arrayLength) * 8) == 0 { return deduce(elementType, element, bindings, true) }
        }
        // `initializer_list<T>` from `{3, 8, 2}`: T from the elements.
        const list = types.unqualified(array)
        if types.kind(list) == types.TPARAM && types.at(list).*.arrayLength < 0 && types.at(list).*.params != 0 && at(types.at(list).*.params).*.name == initializerListName() && types.at(list).*.members != 0 && cpp.bracedElement(arg) != 0 {
            return deduce(base.getWord(types.at(list).*.members + 8), cpp.bracedElement(arg), bindings, true)
        }
        return true
    }
    if types.isMemberPointer(pattern) {
        // `R T::*` against a pointer to a member: the class and the
        // member's type.
        if !types.isMemberPointer(arg) { return false }
        if !deduce(types.memberClassOf(pattern), types.memberClassOf(arg), bindings, false) { return false }
        return deduce(types.baseOf(pattern), types.baseOf(arg), bindings, false)
    }
    const k = types.kind(pattern)
    if k == types.TPARAM {
        const index = types.at(pattern).*.arrayLength
        // A dependent member type (`remove_reference<T>::type`) is not
        // deduced from.
        if index == -3 { return true }
        if index < 0 {
            // `vector<T>` against an instance of the same template: its
            // arguments deduce T.
            const record = types.at(pattern).*.params
            if record == 0 { return false }
            if at(record).*.standsFor != 0 {
                // `B<T...>`, B a template template parameter: the
                // instance's template binds it.
                const actual = cpp.templateRecordOf(arg)
                if actual == 0 { return false }
                const slot = bindings + @intCast(usize, at(record).*.standsFor - 1) * 8
                if base.getWord(slot) == 0 { base.putWord(slot, actual) } else if base.getWord(slot) != actual { return false }
            } else if cpp.templateRecordOf(arg) != record {
                // A function's parameter `const B<T> &` takes a class
                // derived from an instance of B: deduced from that base.
                const instanceBase = if matchingPattern == 0 { cpp.baseInstanceOf(arg, record) } else { 0 }
                if instanceBase == 0 { return false }
                arg = instanceBase
            }
            var p = types.at(pattern).*.members
            var a = flatten(cpp.templateArgsOf(arg))
            while p != 0 && a != 0 {
                if base.getWord(p) == 4 || base.getWord(p) == 5 {
                    a = bindPackSlot(packSlotOf(p), a, bindings)
                    p = base.getWord(p + 24)
                    continue
                }
                if base.getWord(p) == 9 {
                    // A template template parameter: the template given.
                    if base.getWord(a) != 8 { return false }
                    const slot = bindings + base.getWord(p + 16) * 8
                    if base.getWord(slot) == 0 { base.putWord(slot, base.getWord(a + 8)) } else if base.getWord(slot) != base.getWord(a + 8) { return false }
                } else if base.getWord(p) == 6 {
                    if base.getWord(a) != 0 { return false }
                } else if base.getWord(p) == 2 {
                    // A value parameter: the instance's value binds it.
                    if base.getWord(a) != 0 { return false }
                    const slot = bindings + base.getWord(p + 16) * 8
                    if base.getWord(slot) == 0 {
                        base.putWord(slot, a + 16)
                    } else if base.getWord(base.getWord(slot)) != base.getWord(a + 16) {
                        return false
                    }
                } else if base.getWord(p) != base.getWord(a) {
                    return false
                } else if base.getWord(p) != 0 {
                    if !deduceArgument(base.getWord(p + 8), base.getWord(a + 8), bindings) { return false }
                }
                // A value argument of the pattern is not checked: it may be
                // a parameter's (given explicitly then).
                p = base.getWord(p + 24)
                a = base.getWord(a + 24)
            }
            if p != 0 && (base.getWord(p) == 4 || base.getWord(p) == 5) && a == 0 {
                a = bindPackSlot(packSlotOf(p), 0, bindings)
                p = base.getWord(p + 24)
            }
            return p == 0 && a == 0
        }
        var value = arg
        if byValue {
            if types.kind(arg) == types.ARRAY { value = types.pointerTo(types.baseOf(arg)) }
            if types.kind(arg) == types.FUNC { value = types.pointerTo(arg) }
        }
        if byValue || types.isConst(pattern) { value = types.unqualified(value) }
        const known = base.getWord(bindings + @intCast(usize, index) * 8)
        if known == 0 {
            base.putWord(bindings + @intCast(usize, index) * 8, value)
            return true
        }
        if types.isReference(known) && !types.isReference(value) {
            // Given as a reference (`f<int &>(x)` for `T &`): the type
            // it refers to.
            const target = types.referenced(known)
            return types.sameType(target, value) && types.isConst(target) == types.isConst(value)
        }
        return types.sameType(known, value) && types.isConst(known) == types.isConst(value)
    }
    if k == types.REF { return deduce(types.baseOf(pattern), arg, bindings, false) }
    if k == types.PTR {
        // A function's name for `R (*)(Args...)`: its address (a call's
        // argument; a function type is no pointer's in `X<R (*)(A)>`).
        if byValue && types.kind(arg) == types.FUNC && types.kind(types.baseOf(pattern)) == types.FUNC { return deduce(types.baseOf(pattern), arg, bindings, false) }
        // A class (a lambda) for `bool (*)(char16_t)`, naming no parameter:
        // nothing deduced, its conversion is weighed after.
        if cpp.isClassType(arg) && types.kind(types.baseOf(pattern)) == types.FUNC && !functionTypeDependent(types.baseOf(pattern)) { return true }
        if types.kind(arg) != types.PTR && types.kind(arg) != types.ARRAY { return false }
        // (nullptr deduces no T of `T *`; a std::nullptr_t parameter
        // takes it.)
        if types.isNullptr(arg) { return types.isNullptr(pattern) || !dependentType(types.baseOf(pattern)) }
        // `const T *` takes a pointer to const and, in a call, by a
        // qualification conversion one to non-const too (T without the
        // const; the ranks prefer `T *` for it); a pattern (`Kind<const
        // T *>`) only the first.
        if matchingPattern > 0 && types.isConst(types.baseOf(pattern)) && !types.isConst(types.baseOf(arg)) { return false }
        return deduce(types.baseOf(pattern), types.baseOf(arg), bindings, false)
    }
    if k == types.ARRAY {
        if types.kind(arg) != types.ARRAY { return false }
        const bound = types.at(pattern).*.arrayLength
        if bound <= -10 {
            // `T[N]`: N from the argument's length.
            if types.at(arg).*.arrayLength < 0 { return false }
            const slot = bindings + @intCast(usize, 0 - bound - 10) * 8
            if base.getWord(slot) == 0 {
                const cell = base.alloc(8)
                base.putWord(cell, @bitCast(u64, types.at(arg).*.arrayLength))
                base.putWord(slot, cell)
            } else if @bitCast(i64, base.getWord(base.getWord(slot))) != types.at(arg).*.arrayLength {
                return false
            }
        } else if bound >= 0 && bound != types.at(arg).*.arrayLength {
            return false
        }
        return deduce(types.baseOf(pattern), types.baseOf(arg), bindings, false)
    }
    if k == types.FUNC {
        // `R(Args...)` against a function type: the result, then the
        // parameters (a pack taking those left).
        if types.kind(arg) != types.FUNC { return false }
        if !deduce(types.baseOf(pattern), types.baseOf(arg), bindings, false) { return false }
        var p = types.at(pattern).*.params
        var a = types.at(arg).*.params
        while p != 0 {
            if types.param(p).*.isPack {
                const slot = packIndexIn(types.param(p).*.ty)
                if slot < 0 { return false }
                const holder = types.newPackHolder()
                while a != 0 {
                    types.addPackType(holder, types.param(a).*.ty)
                    a = types.param(a).*.next
                }
                base.putWord(bindings + @intCast(usize, slot) * 8, holder)
                p = types.param(p).*.next
                continue
            }
            if a == 0 { return false }
            if !deduce(types.param(p).*.ty, types.param(a).*.ty, bindings, false) { return false }
            p = types.param(p).*.next
            a = types.param(a).*.next
        }
        return a == 0 && types.at(pattern).*.variadic == types.at(arg).*.variadic
    }
    return matchingPattern == 0 || types.compatible(pattern, arg)
}

// The instance of one of the function templates `first` (and the others
// of its name) that takes the `count` arguments in `given` best, made
// by deduction (after the template arguments `explicit`, cells, when
// given); 0 when none fits.
// For an implicit conversion: an instance of one of the constructor
// templates `first` that are not `explicit` taking the arguments, 0 for
// none.
// How many function parameters the template `t`'s pattern takes at
// most (a pack or `...`: many); -1 when it is not known.
pub fn patternParamCount(t: usize) -> i64 {
    const pattern = at(t).*.pattern
    if pattern == 0 { return -1 }
    if types.at(pattern).*.variadic { return 1000 }
    var n: i64 = 0
    var p = types.at(pattern).*.params
    while p != 0 {
        if types.param(p).*.isPack { return 1000 }
        if types.param(p).*.name != names.K_THIS { n += 1 }
        p = types.param(p).*.next
    }
    return n
}

// The next function template of the name after `t` (0: none).
pub fn nextTemplate(t: usize) -> usize { return at(t).*.next }

pub fn implicitConstructorInstance(first: usize, given: usize, count: usize) -> usize {
    var t = first
    while t != 0 {
        const next = at(t).*.next
        if !declaredExplicit(t) {
            at(t).*.next = 0
            const instance = callInstance(t, given, count, 0)
            at(t).*.next = next
            if instance != 0 { return instance }
        }
        t = next
    }
    return 0
}

// Whether the template `t`'s declaration says `explicit` before its
// parameters.
fn declaredExplicit(t: usize) -> bool {
    var x = if at(t).*.declaration != 0 { at(t).*.declaration } else { at(t).*.start }
    var steps: u32 = 0
    while x != 0 && !tokens.isEof(x) && !tokens.is(x, names.P_LPAREN) && steps < 32 {
        if tokens.isWord(x, names.K_EXPLICIT) { return true }
        x = tokens.next(x)
        steps += 1
    }
    return false
}

// The object a member template is called on: 0 not known (or none), 1
// a non-const one, 2 a const one.
pub var objectConstness: u8 = 0

pub fn callInstance(first: usize, given: usize, count: usize, explicit: usize) -> usize {
    // (Taken for this choice only: the bodies it makes choose anew.)
    const constness = objectConstness
    objectConstness = 0
    const outerDefer = deferBodies
    deferBodies = true
    const best = chooseInstance(first, given, count, explicit, constness)
    deferBodies = outerDefer
    if !deferBodies && needsBody(best) { ensureDefined(best) }
    return best
}

// The same, its body not made yet: for a choice that may still take a
// function of the name instead (useInstance then).
pub fn candidateInstance(first: usize, given: usize, count: usize, explicit: usize) -> usize {
    const constness = objectConstness
    objectConstness = 0
    const outerDefer = deferBodies
    deferBodies = true
    const best = chooseInstance(first, given, count, explicit, constness)
    deferBodies = outerDefer
    return best
}

// The instance `o` (candidateInstance) chosen: its body is made.
pub fn useInstance(o: usize) -> void {
    if o != 0 && !deferBodies && needsBody(o) { ensureDefined(o) }
}

fn chooseInstance(first: usize, given: usize, count: usize, explicit: usize, constness: u8) -> usize {
    var best: usize = 0
    var bestScore: i64 = -1
    var bestSpecial: i64 = 0
    var t = first
    while t != 0 {
        const bindings = base.alloc(at(t).*.paramCount * 8 + 8)
        // A template declared only (`template <...> R f(...);`) has
        // nothing to instantiate (but where nothing is evaluated, its
        // signature is enough).
        // (A free one declared before its definition, `template <class
        // T> unsigned ctz(T);` then MathExtras.h's: its instance waits
        // for the body, see functionTemplate.)
        var fits = at(t).*.isDeleted || at(t).*.start != 0 || at(t).*.declaration != 0
        // The explicit arguments first (types only).
        var e = explicit
        var slot: usize = 0
        while e != 0 && fits {
            if slot >= at(t).*.paramCount && base.getWord(e) == 3 && types.packCount(base.getWord(e + 8)) == 0 && base.getWord(e + 24) == 0 {
                // (An empty pack read with another template's parameters:
                // nothing given.)
                break
            } else if slot >= at(t).*.paramCount {
                fits = false
            } else if base.getWord(parameterCell(t, slot) + 40) != 0 {
                // A pack: its holder (`f<int, long>`: the arguments
                // from its place on, read into one by readArguments),
                // or this and the rest of the explicit arguments.
                if base.getWord(e) == 3 {
                    // (A copy: deduction adds to it, and the next template
                    // of the name starts from the arguments given.)
                    const copied = types.newPackHolder()
                    var given_ = types.packArguments(base.getWord(e + 8))
                    while given_ != 0 {
                        types.addPackArgument(copied, copyCell(given_))
                        given_ = base.getWord(given_ + 24)
                    }
                    base.putWord(bindings + slot * 8, copied)
                } else {
                    // (A value for a type pack, or a type for a value
                    // pack: another template of the name,
                    // `constructAndAppend<FailureAction::Crash>(...)`.)
                    const typePack = base.getWord(parameterCell(t, slot) + 8) != 0
                    const holder = types.newPackHolder()
                    while e != 0 {
                        const kind = base.getWord(e)
                        if typePack && (kind == 0 || kind == 10) { fits = false }
                        if !typePack && kind == 1 { fits = false }
                        types.addPackArgument(holder, copyCell(e))
                        e = base.getWord(e + 24)
                    }
                    base.putWord(bindings + slot * 8, holder)
                }
            } else if base.getWord(e) == 0 || base.getWord(e) == 10 {
                // A value for a type parameter: another template of the name.
                if base.getWord(parameterCell(t, slot) + 8) != 0 { fits = false }
                // (A function's binding is where the cell holds it.)
                if (base.getWord(e) == 10) != isFunctionPointer(base.getWord(parameterCell(t, slot) + 16)) { fits = false }
                base.putWord(bindings + slot * 8, if base.getWord(e) == 10 { e + 8 } else { e + 16 })
            } else {
                if base.getWord(parameterCell(t, slot) + 8) == 0 { fits = false }
                base.putWord(bindings + slot * 8, base.getWord(e + 8))
            }
            slot += 1
            if e != 0 { e = base.getWord(e + 24) }
        }
        // The parameters given explicitly (the first `slot` ones): an
        // argument for a function parameter of their types alone only
        // converts (`f<unsigned char>('A')`), it deduces nothing.
        const explicitSlots = slot
        var p = types.at(at(t).*.pattern).*.params
        var index: usize = 0
        while fits && (index < count || (p != 0 && types.param(p).*.isPack)) {
            if p == 0 {
                fits = types.at(at(t).*.pattern).*.variadic
                break
            }
            if types.param(p).*.isPack {
                // `Args... args` takes the arguments left, each deducing
                // an element of the pack (after any given explicitly).
                const packSlot = packIndexIn(types.param(p).*.ty)
                if packSlot < 0 { cursor.fail("a parameter pack needs a template parameter pack") }
                var holder = base.getWord(bindings + @intCast(usize, packSlot) * 8)
                if holder == 0 { holder = types.newPackHolder() }
                // The elements given explicitly (`f<int>(1, 2)`) take
                // the first arguments; the rest deduce more.
                var explicitLeft = types.packCount(holder)
                while index < count && fits {
                    if explicitLeft > 0 {
                        explicitLeft -= 1
                        index += 1
                        continue
                    }
                    base.putWord(bindings + @intCast(usize, packSlot) * 8, 0)
                    typing.addType(base.getWord(given + index * 8))
                    fits = deduce(types.param(p).*.ty, argumentTypeFor(types.param(p).*.ty, base.getWord(given + index * 8)), bindings, true)
                    const element = base.getWord(bindings + @intCast(usize, packSlot) * 8)
                    if element == 0 { fits = false }
                    if fits { types.addPackType(holder, element) }
                    index += 1
                }
                base.putWord(bindings + @intCast(usize, packSlot) * 8, holder)
                p = types.param(p).*.next
                continue
            }
            typing.addType(base.getWord(given + index * 8))
            if explicitSlots == 0 || !onlyExplicit(types.param(p).*.ty, explicitSlots) {
                fits = deduce(types.param(p).*.ty, argumentTypeFor(types.param(p).*.ty, base.getWord(given + index * 8)), bindings, true)
            }
            p = types.param(p).*.next
            index += 1
        }
        // The parameters left take their defaults.
        while p != 0 && types.param(p).*.defaultValue != 0 { p = types.param(p).*.next }
        if p != 0 { fits = false }
        // A template parameter pack no function parameter uses is empty.
        slot = 0
        while fits && slot < at(t).*.paramCount {
            if base.getWord(bindings + slot * 8) == 0 && base.getWord(parameterCell(t, slot) + 40) != 0 { base.putWord(bindings + slot * 8, types.newPackHolder()) }
            slot += 1
        }
        // The parameters left take their defaults (`class =
        // enable_if_t<...>`: one that names what does not exist makes
        // the template not viable).
        slot = 0
        while fits && slot < at(t).*.paramCount {
            if base.getWord(bindings + slot * 8) == 0 && base.getWord(parameterCell(t, slot) + 32) != 0 {
                const value = defaultFor(t, slot, bindings)
                if value == 0 { fits = false } else { base.putWord(bindings + slot * 8, value) }
            }
            slot += 1
        }
        index = 0
        while fits && index < at(t).*.paramCount {
            if base.getWord(bindings + index * 8) == 0 { fits = false }
            index += 1
        }
        if fits {
            // A deleted template: only its explicit specializations.
            const instance = if at(t).*.isDeleted { cached(t, instanceKey(t, boundArguments(t, bindings))) } else { instantiateFunction(t, boundArguments(t, bindings)) }
            var score: i64 = if instance != 0 { expr.argumentScore(instance, given, count) } else { -1 }
            if interp.trace && score < 0 { tokens.warnAt(cursor.peek(), if instance == 0 { "no instance made" } else { base.join("instance type ", mangle.typeCode(ast.obj(instance).*.ty)) }) }
            // On a const object a non-const member function does not
            // fit; on another the non-const one of a pair wins.
            if score >= 0 && constness != 0 && ast.obj(instance).*.classType != 0 && !ast.obj(instance).*.isStaticMember && !ast.obj(instance).*.isConstructor {
                const isConstMethod = types.at(ast.obj(instance).*.ty).*.constMethod
                if constness == 2 && !isConstMethod { score = -1 }
                if constness == 1 && isConstMethod && score > 0 { score -= 1 }
            }
            // As good a fit: the more specialized template (its
            // parameters' patterns say more: `const duration<R, P> &`
            // over `const R &`).
            const special = if score >= 0 && score == bestScore { functionSpecificity(at(t).*.pattern) } else { 0 }
            if score > bestScore || (score >= 0 && score == bestScore && special > bestSpecial) {
                best = instance
                bestScore = score
                bestSpecial = functionSpecificity(at(t).*.pattern)
            }
        }
        if interp.trace && best == 0 {
            var line = base.join("candidate ", if fits { "fits" } else { "does not fit" })
            if at(t).*.start == 0 { line = base.join(line, ", no body") }
            if at(t).*.declaration == 0 { line = base.join(line, ", no declaration") }
            tokens.warnAt(cursor.peek(), base.join(line, base.join(" ", mangle.typeCode(at(t).*.pattern))))
        }
        t = at(t).*.next
    }
    return best
}

// Whether the parameter type pattern names template parameters only
// among the first `explicitSlots` (and through pointers, references and
// arrays at most): nothing in it is left to deduce.
fn onlyExplicit(ty: usize, explicitSlots: usize) -> bool {
    var t = ty
    var steps: u32 = 0
    while t != 0 && steps < 64 {
        const k = types.kind(t)
        if k == types.TPARAM {
            const index = types.at(t).*.arrayLength
            // `typename U::rep`: known once U is.
            if index == -3 { return types.at(t).*.params != 0 && onlyExplicit(types.at(t).*.params, explicitSlots) }
            // `It<C>`, C given: the instance is known, an argument
            // converts to it (`isAtLocalhost<Latin1Character>(span)`).
            if index < 0 && types.at(t).*.params != 0 && at(types.at(t).*.params).*.standsFor == 0 { return instanceOnlyExplicit(t, explicitSlots) }
            return index >= 0 && @intCast(usize, index) < explicitSlots && !types.at(t).*.isPack
        }
        if k != types.PTR && k != types.REF && k != types.ARRAY { return false }
        // `T (&&)[N]`: N is deduced unless given.
        if k == types.ARRAY && types.at(t).*.arrayLength <= -10 && @intCast(usize, 0 - types.at(t).*.arrayLength - 10) >= explicitSlots { return false }
        t = types.baseOf(t)
        steps += 1
    }
    return false
}

// Whether the arguments of the instance pattern `t` (`It<C>`) name
// template parameters among the first `explicitSlots` only.
fn instanceOnlyExplicit(t: usize, explicitSlots: usize) -> bool {
    var c = types.at(t).*.members
    while c != 0 {
        const kind = base.getWord(c)
        if kind == 1 {
            const ty = base.getWord(c + 8)
            if types.kind(ty) == types.TPARAM || types.kind(ty) == types.PTR || types.kind(ty) == types.REF || types.kind(ty) == types.ARRAY {
                if !onlyExplicit(ty, explicitSlots) { return false }
            } else if types.kind(ty) == types.FUNC {
                return false
            }
        } else if kind == 2 {
            if base.getWord(c + 16) >= explicitSlots { return false }
        } else if kind != 0 {
            return false
        }
        c = base.getWord(c + 24)
    }
    return true
}

// How much the parameters of the function pattern `fnType` fix of
// their arguments: a bare template parameter nothing, a template's
// instance or a concrete type more, a pointer to one more again.
fn functionSpecificity(fnType: usize) -> i64 {
    var total: i64 = 0
    var p = types.at(fnType).*.params
    while p != 0 {
        total += typeSpecificity(types.param(p).*.ty)
        // (A function parameter pack says less: `f(U &&)` over
        // `f(U &&, Items &&...)` for one argument.)
        if types.param(p).*.isPack { total -= 1 }
        p = types.param(p).*.next
    }
    return total
}

fn typeSpecificity(ty: usize) -> i64 {
    if ty == 0 { return 0 }
    if types.isReference(ty) { return typeSpecificity(types.referenced(ty)) }
    const k = types.kind(ty)
    if k == types.TPARAM {
        const index = types.at(ty).*.arrayLength
        if index >= 0 || index == -3 { return 0 }
        return 2
    }
    if k == types.PTR || k == types.ARRAY { return 1 + typeSpecificity(types.baseOf(ty)) }
    return 1
}

fn instantiateFunction(t: usize, args: usize) -> usize {
    const key = instanceKey(t, args)
    const known = cached(t, key)
    if interp.trace && known == 0 { tokens.warnAt(cursor.peek(), base.join("function instance ", base.nameOf(key))) }
    if known != 0 {
        if !deferBodies && needsBody(known) { ensureDefined(known) }
        return known
    }
    // A member template declared in its class and defined later: the
    // instance gets its signature from the declaration, its body when
    // the definition is read.
    const waits = at(t).*.start == 0
    if waits && at(t).*.declaration == 0 { cursor.fail(base.join("the member template is not defined: ", base.nameOf(at(t).*.name))) }
    const context = beginInstance()
    base.nameTrace(key)
    // A member template's instance is a member function of its class:
    // its parameters are bound under a prefix below the class's.
    const prefix = scope.qualify(at(t).*.namespace, key)
    bindFunctionParameters(t, args, prefix)
    scope.enterPrefix(prefix)
    if !constraintHolds(t, prefix) {
        if interp.trace { tokens.warnAt(cursor.peek(), "the instance's constraint does not hold") }
        scope.leaveNamespace()
        endInstance(context)
        return 0
    }
    cursor.restore(if waits { at(t).*.declaration } else { at(t).*.start })
    // The signature: a name in it that does not exist for these
    // arguments (`enable_if<false, int>::type`) makes no instance.
    const outerSfinae = decl.sfinae
    const outerFailed = decl.sfinaeFailed
    decl.sfinae = true
    decl.sfinaeFailed = false
    const attr = decl.newAttr()
    const baseType = decl.declspec(attr)
    const found = decl.declarator(baseType)
    // (A requires clause of the instance's signature is no member's.)
    memberRequires = 0
    const notViable = decl.sfinaeFailed
    decl.sfinae = outerSfinae
    decl.sfinaeFailed = outerFailed
    if notViable {
        if interp.trace { tokens.warnAt(cursor.peek(), "the instance's signature is not viable here") }
        scope.leaveNamespace()
        endInstance(context)
        return 0
    }
    if at(t).*.isConstructor {
        if types.kind(found.0) != types.FUNC { cursor.fail("expected a constructor template") }
        types.at(found.0).*.base = types.voidOf()
    } else if found.1 == 0 || types.kind(found.0) != types.FUNC {
        cursor.fail("expected a function template")
    }
    if !waits && at(t).*.declaration != 0 && at(t).*.declaration != at(t).*.start && types.kind(found.0) == types.FUNC { declarationDefaults(t, found.0) }
    const o = ast.newObj(at(t).*.name, found.0, if found.1 != 0 { found.1 } else { at(t).*.start })
    const obj = ast.obj(o)
    obj.*.isFunction = true
    obj.*.isWeak = true
    obj.*.isInline = true
    obj.*.isConstructor = at(t).*.isConstructor
    // One waiting for its definition is referenced by a call that is
    // evaluated (buildCall), not by decltype(declval<T>()).
    obj.*.isReferenced = !waits
    obj.*.isConstexpr = decl.attrAt(attr).*.isConstexpr
    obj.*.linkName = mangle.templateFunctionSymbol(at(t).*.namespace, at(t).*.name, argumentCodes(args), found.0)
    obj.*.symbol = obj.*.linkName
    if at(t).*.owner != 0 {
        obj.*.classType = at(t).*.owner
        obj.*.isStaticMember = decl.attrAt(attr).*.isStatic || at(t).*.isStaticMember
        if !obj.*.isStaticMember { obj.*.ty = cpp.withThisPublic(at(t).*.owner, found.0) }
    }
    state.addGlobal(o)
    cache(t, key, o)
    if waits {
        const c = base.alloc(32)
        base.putWord(c, o)
        base.putWord(c + 8, @intCast(usize, prefix))
        base.putWord(c + 16, args)
        base.putWord(c + 24, at(t).*.waiting)
        at(t).*.waiting = c
    } else if deferBodies {
        // A candidate of a call: its body is read once it is chosen
        // (a static_assert in an overload not taken stays silent).
        const c = base.alloc(40)
        base.putWord(c, o)
        base.putWord(c + 8, t)
        base.putWord(c + 16, @intCast(usize, prefix))
        base.putWord(c + 24, args)
        base.putWord(c + 32, cursor.save())
        const link = base.alloc(16)
        base.putWord(link, c)
        base.putWord(link + 8, pendingBodies)
        pendingBodies = link
    } else {
        decl.defineFunctionIn(o, prefix)
    }
    scope.leaveNamespace()
    endInstance(context)
    return o
}

// The default arguments of the template `t`'s declaration (`int base =
// 10` in `template <class I> I parse(const char *, int base = 10);`,
// kept in its pattern) given to the parameters of the definition's
// signature `fnType` that have none.
fn declarationDefaults(t: usize, fnType: usize) -> void {
    if at(t).*.pattern == 0 { return }
    var dp = types.at(at(t).*.pattern).*.params
    var np = types.at(fnType).*.params
    if np != 0 && types.param(np).*.name == names.K_THIS { np = types.param(np).*.next }
    while dp != 0 && np != 0 {
        if types.param(np).*.defaultValue == 0 { types.param(np).*.defaultValue = types.param(dp).*.defaultValue }
        dp = types.param(dp).*.next
        np = types.param(np).*.next
    }
}

// Whether instances made now are candidates whose bodies wait
// (callInstance), and the instances waiting so: cells of (instance,
// template, prefix, arguments, the body's position).
var deferBodies = false
var pendingBodies: usize = 0

// Reads the body of the function template instance `o` if it is still
// waiting.
fn definePendingInstance(o: usize) -> void {
    if o == 0 || pendingBodies == 0 { return }
    var link = pendingBodies
    var previous: usize = 0
    while link != 0 {
        const c = base.getWord(link)
        if base.getWord(c) == o {
            if previous == 0 { pendingBodies = base.getWord(link + 8) } else { base.putWord(previous + 8, base.getWord(link + 8)) }
            const t = base.getWord(c + 8)
            const prefix = @intCast(u32, base.getWord(c + 16))
            const context = beginInstance()
            base.nameTrace(ast.obj(o).*.linkName)
            bindFunctionParameters(t, base.getWord(c + 24), prefix)
            scope.enterPrefix(prefix)
            cursor.restore(base.getWord(c + 32))
            decl.defineFunctionIn(o, prefix)
            scope.leaveNamespace()
            endInstance(context)
            return
        }
        previous = link
        link = base.getWord(link + 8)
    }
}
