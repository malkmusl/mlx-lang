// Quarks (gquark.h), interned strings and GError (gerror.h). A quark
// is the number of a string in the table of the program's life: an open
// hash of the strings with their numbers, the strings by number.
// A GError: the domain, the code, the message (from g_malloc).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const varargs = @import("./varargs.mlx")

var quarkLock: u32 = 0
// The strings by quark (quark 0 is none) and the hash of (string, quark).
var quarkStrings: usize = 0
var quarkCount: usize = 0
var quarkCapacity: usize = 0
var hashSlots: usize = 0
var hashCapacity: usize = 0

pub fn hashBytes(text: usize) -> u32 {
    // GLib's g_str_hash: h = h * 33 + c, from 5381.
    var h: u32 = 5381
    var index: usize = 0
    while true {
        const c = m.get8(text + index)
        if c == 0 { break }
        h = (h << 5) +% h +% @intCast(u32, c)
        index += 1
    }
    return h
}

fn findSlot(text: usize, h: u32) -> usize {
    var slot = @intCast(usize, h) & (hashCapacity - 1)
    while true {
        const quark = m.get32(hashSlots + slot * 4)
        if quark == 0 { return slot }
        if m.cEqual(m.getWord(quarkStrings + @intCast(usize, quark) * 8), text) { return slot }
        slot = (slot + 1) & (hashCapacity - 1)
    }
    return 0
}

fn growTables() -> void {
    if quarkCount + 2 >= quarkCapacity {
        const larger = if quarkCapacity == 0 { 512 } else { quarkCapacity * 2 }
        quarkStrings = m.grow(quarkStrings, larger * 8)
        quarkCapacity = larger
    }
    if (quarkCount + 1) * 2 >= hashCapacity {
        const larger = if hashCapacity == 0 { 1024 } else { hashCapacity * 2 }
        const old = hashSlots
        const oldCapacity = hashCapacity
        hashSlots = m.alloc(larger * 4)
        hashCapacity = larger
        var index: usize = 0
        while index < oldCapacity {
            const quark = m.get32(old + index * 4)
            if quark != 0 {
                const text = m.getWord(quarkStrings + @intCast(usize, quark) * 8)
                m.put32(hashSlots + findSlot(text, hashBytes(text)) * 4, quark)
            }
            index += 1
        }
        m.release(old)
    }
}

// The quark of `text` (copied when `copy` and it is new); 0 for NULL.
pub fn quarkOf(text: usize, copy: bool, create: bool) -> u32 {
    if text == 0 { return 0 }
    threads.lock(@intFromPtr(&quarkLock))
    growTables()
    const slot = findSlot(text, hashBytes(text))
    var quark = m.get32(hashSlots + slot * 4)
    if quark == 0 && create {
        quarkCount += 1
        quark = @intCast(u32, quarkCount)
        m.putWord(quarkStrings + quarkCount * 8, if copy { m.dup(text) } else { text })
        m.put32(hashSlots + slot * 4, quark)
    }
    threads.unlock(@intFromPtr(&quarkLock))
    return quark
}

pub fn quarkString(quark: u32) -> usize {
    if quark == 0 { return 0 }
    threads.lock(@intFromPtr(&quarkLock))
    var result: usize = 0
    if @intCast(usize, quark) <= quarkCount { result = m.getWord(quarkStrings + @intCast(usize, quark) * 8) }
    threads.unlock(@intFromPtr(&quarkLock))
    return result
}

// The quark of a literal (static) string.
pub fn quarkLiteral(text: []const u8) -> u32 { return quarkOf(m.literal(text), false, true) }

pub fn intern(text: usize) -> usize { return quarkString(quarkOf(text, true, true)) }

export fn g_quark_try_string(text: usize) -> u32 { return quarkOf(text, false, false) }
export fn g_quark_from_static_string(text: usize) -> u32 { return quarkOf(text, false, true) }
export fn g_quark_from_string(text: usize) -> u32 { return quarkOf(text, true, true) }
export fn g_quark_to_string(quark: u32) -> usize { return quarkString(quark) }
export fn g_intern_string(text: usize) -> usize { return quarkString(quarkOf(text, true, true)) }
export fn g_intern_static_string(text: usize) -> usize { return quarkString(quarkOf(text, false, true)) }

// ---------------------------------------------------------------------------
// The error domains of the library.

export fn g_file_error_quark() -> u32 { return quarkLiteral("g-file-error-quark") }
export fn g_convert_error_quark() -> u32 { return quarkLiteral("g_convert_error") }
export fn g_thread_error_quark() -> u32 { return quarkLiteral("g_thread_error") }
export fn g_shell_error_quark() -> u32 { return quarkLiteral("g-shell-error-quark") }
export fn g_spawn_error_quark() -> u32 { return quarkLiteral("g-exec-error-quark") }
export fn g_spawn_exit_error_quark() -> u32 { return quarkLiteral("g-spawn-exit-error-quark") }
export fn g_key_file_error_quark() -> u32 { return quarkLiteral("g-key-file-error-quark") }
export fn g_markup_error_quark() -> u32 { return quarkLiteral("g-markup-error-quark") }
export fn g_uri_error_quark() -> u32 { return quarkLiteral("g-uri-quark") }
export fn g_variant_parse_error_quark() -> u32 { return quarkLiteral("g-variant-parse-error-quark") }
export fn g_unix_error_quark() -> u32 { return quarkLiteral("g-unix-error-quark") }
export fn g_io_error_quark() -> u32 { return quarkLiteral("g-io-error-quark") }
export fn g_resource_error_quark() -> u32 { return quarkLiteral("g-resource-error-quark") }
export fn g_dbus_error_quark() -> u32 { return quarkLiteral("g-dbus-error-quark") }

// ---------------------------------------------------------------------------
// GError

const DOMAIN: usize = 0
const CODE: usize = 4
const MESSAGE: usize = 8
const SIZE: usize = 16

pub fn newError(domain: u32, code: i32, message: usize) -> usize {
    const e = m.alloc(SIZE)
    m.put32(e + DOMAIN, domain)
    m.putI32(e + CODE, code)
    m.putWord(e + MESSAGE, message)
    return e
}

// A new error of a message to copy (a C string).
pub fn errorLiteral(domain: u32, code: i32, message: usize) -> usize { return newError(domain, code, m.dup(if message == 0 { m.literal("") } else { message })) }

// A new error of a literal message.
pub fn errorOf(domain: u32, code: i32, message: []const u8) -> usize { return newError(domain, code, m.dupSlice(message)) }

// Sets `*err` (an GError **, which may be NULL) to `e`, or frees `e`
// when there is no place for it. (GLib warns when `*err` is set
// already, and keeps the first.)
pub fn report(err: usize, e: usize) -> void {
    if err == 0 {
        freeError(e)
        return
    }
    if m.getWord(err) != 0 {
        warnOverwrite(e)
        freeError(e)
        return
    }
    m.putWord(err, e)
}

extern("c") fn write(fd: i32, buffer: usize, count: usize) -> isize

fn warnOverwrite(e: usize) -> void {
    var t = m.text()
    m.pushText(&t, "\n(process): GLib-WARNING **: GError set over the top of a previous GError or uninitialized memory.\nThis indicates a bug in someone's code. You must ensure an error is NULL before it's set.\nThe overwriting error message was: ")
    m.pushC(&t, m.getWord(e + MESSAGE))
    m.pushText(&t, "\n")
    _ = write(2, t.address, t.length)
    m.dispose(&t)
}

// Reports an error of a literal message.
pub fn set(err: usize, domain: u32, code: i32, message: []const u8) -> void {
    if err == 0 { return }
    report(err, errorOf(domain, code, message))
}

// Reports an error of the message `prefix` then the C string `detail`.
pub fn setDetail(err: usize, domain: u32, code: i32, prefix: []const u8, detail: usize, suffix: []const u8) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, prefix)
    m.pushC(&t, detail)
    m.pushText(&t, suffix)
    report(err, newError(domain, code, m.finish(&t)))
}

pub fn freeError(e: usize) -> void {
    if e == 0 { return }
    m.release(m.getWord(e + MESSAGE))
    m.release(e)
}

pub fn message(e: usize) -> usize { return m.getWord(e + MESSAGE) }
pub fn code(e: usize) -> i32 { return m.getI32(e + CODE) }
pub fn domainOf(e: usize) -> u32 { return m.get32(e + DOMAIN) }

pub fn matches(e: usize, domain: u32, code_: i32) -> bool {
    return e != 0 && m.get32(e + DOMAIN) == domain && m.getI32(e + CODE) == code_
}

export fn g_error_new_literal(domain: u32, code_: i32, message_: usize) -> usize { return errorLiteral(domain, code_, message_) }

export fn g_error_new_valist(domain: u32, code_: i32, format: usize, args: usize) -> usize {
    return newError(domain, code_, varargs.formatted(format, args))
}

export fn g_error_new(domain: u32, code_: i32, format: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ @intCast(usize, domain), @intCast(usize, @bitCast(u32, code_)), format, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 3, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return newError(domain, code_, varargs.formatted(format, list))
}

export fn g_error_free(e: usize) -> void { freeError(e) }

export fn g_error_copy(e: usize) -> usize { return newError(m.get32(e + DOMAIN), m.getI32(e + CODE), m.dup(m.getWord(e + MESSAGE))) }

export fn g_error_matches(e: usize, domain: u32, code_: i32) -> i32 { return if matches(e, domain, code_) { 1 } else { 0 } }

export fn g_set_error(err: usize, domain: u32, code_: i32, format: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    if err == 0 { return }
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ err, @intCast(usize, domain), @intCast(usize, @bitCast(u32, code_)), format, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 4, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    report(err, newError(domain, code_, varargs.formatted(format, list)))
}

export fn g_set_error_literal(err: usize, domain: u32, code_: i32, message_: usize) -> void {
    if err == 0 { return }
    report(err, errorLiteral(domain, code_, message_))
}

export fn g_propagate_error(dest: usize, src: usize) -> void {
    if src == 0 { return }
    report(dest, src)
}

export fn g_clear_error(err: usize) -> void {
    if err == 0 { return }
    freeError(m.getWord(err))
    m.putWord(err, 0)
}

fn prefixed(e: usize, prefix: usize) -> void {
    var t = m.text()
    m.pushC(&t, prefix)
    m.pushC(&t, m.getWord(e + MESSAGE))
    m.release(m.getWord(e + MESSAGE))
    m.putWord(e + MESSAGE, m.finish(&t))
}

export fn g_prefix_error_literal(err: usize, prefix: usize) -> void {
    if err == 0 || m.getWord(err) == 0 { return }
    prefixed(m.getWord(err), prefix)
}

export fn g_prefix_error(err: usize, format: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    if err == 0 || m.getWord(err) == 0 { return }
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ err, format, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 2, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    const prefix = varargs.formatted(format, list)
    prefixed(m.getWord(err), prefix)
    m.release(prefix)
}

export fn g_propagate_prefixed_error(dest: usize, src: usize, format: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    if src == 0 { return }
    if dest == 0 {
        freeError(src)
        return
    }
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ dest, src, format, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 3, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    const prefix = varargs.formatted(format, list)
    prefixed(src, prefix)
    m.release(prefix)
    report(dest, src)
}

// The error of an errno value for GLib's file functions (GFileError).
pub fn fileErrorOf(errnum: i32) -> i32 {
    if errnum == 17 { return 0 }
    if errnum == 21 { return 1 }
    if errnum == 13 { return 2 }
    if errnum == 36 { return 3 }
    if errnum == 2 { return 4 }
    if errnum == 20 { return 5 }
    if errnum == 6 { return 6 }
    if errnum == 19 { return 7 }
    if errnum == 30 { return 8 }
    if errnum == 26 { return 9 }
    if errnum == 14 { return 10 }
    if errnum == 40 { return 11 }
    if errnum == 28 { return 12 }
    if errnum == 12 { return 13 }
    if errnum == 24 { return 14 }
    if errnum == 23 { return 15 }
    if errnum == 9 { return 16 }
    if errnum == 22 { return 17 }
    if errnum == 32 { return 18 }
    if errnum == 11 { return 19 }
    if errnum == 4 { return 20 }
    if errnum == 5 { return 21 }
    if errnum == 1 { return 22 }
    if errnum == 38 { return 23 }
    return 24
}

export fn g_file_error_from_errno(err_no: i32) -> i32 { return fileErrorOf(err_no) }

extern("c") fn strerror(errnum: i32) -> usize

// strerror's text of `errnum` (the C library's, which GLib's g_strerror
// gives too).
pub fn errnoText(errnum: i32) -> usize { return strerror(errnum) }
