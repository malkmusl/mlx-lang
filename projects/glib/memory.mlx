// What mlx-glib needs of the C world it is loaded into: memory it hands
// to C or C hands back comes from C's allocator (so g_free and free are
// the same); the rest is memory by address, as the unicode library reads
// it.
extern("c") fn malloc(size: usize) -> usize
extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn realloc(address: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void
extern("c") fn abort() -> void

// `size` zeroed bytes; the program aborts when there is no memory, as
// GLib's g_malloc0 does.
pub fn alloc(size: usize) -> usize {
    const address = calloc(1, if size == 0 { 1 } else { size })
    if address == 0 { outOfMemory(size) }
    return address
}

// `size` bytes, not cleared; 0 when there is no memory.
pub fn tryRaw(size: usize) -> usize { return malloc(if size == 0 { 1 } else { size }) }

pub fn tryZeroed(size: usize) -> usize { return calloc(1, if size == 0 { 1 } else { size }) }

pub fn tryGrow(address: usize, size: usize) -> usize { return realloc(address, if size == 0 { 1 } else { size }) }

pub fn raw(size: usize) -> usize {
    const address = tryRaw(size)
    if address == 0 { outOfMemory(size) }
    return address
}

pub fn grow(address: usize, size: usize) -> usize {
    const result = tryGrow(address, size)
    if result == 0 { outOfMemory(size) }
    return result
}

pub fn release(address: usize) -> void {
    if address != 0 { free(address) }
}

extern("c") fn write(fd: i32, buffer: usize, count: usize) -> isize

pub fn outOfMemory(size: usize) -> void {
    const text = "GLib: failed to allocate memory\n"
    _ = write(2, @intFromPtr(text.pointer), text.length)
    abort()
}

pub fn fatal() -> void { abort() }

pub fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
pub fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
pub fn get16(address: usize) -> u16 { unsafe { return @ptrFromInt(*u16, address).* } }
pub fn put16(address: usize, value: u16) -> void { unsafe { @ptrFromInt(*u16, address).* = value } }
pub fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
pub fn put32(address: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, address).* = value } }
pub fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
pub fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
pub fn getI32(address: usize) -> i32 { return @bitCast(i32, get32(address)) }
pub fn putI32(address: usize, value: i32) -> void { put32(address, @bitCast(u32, value)) }
pub fn getI64(address: usize) -> i64 { return @bitCast(i64, get64(address)) }
pub fn putI64(address: usize, value: i64) -> void { put64(address, @bitCast(u64, value)) }
pub fn getF64(address: usize) -> f64 { return @bitCast(f64, get64(address)) }
pub fn putF64(address: usize, value: f64) -> void { put64(address, @bitCast(u64, value)) }
pub fn getF32(address: usize) -> f32 { return @bitCast(f32, get32(address)) }
pub fn putF32(address: usize, value: f32) -> void { put32(address, @bitCast(u32, value)) }

// The word at `address` as an atomic one (references, flags).
pub fn word32(address: usize) -> *u32 { unsafe { return @ptrFromInt(*u32, address) } }
pub fn word64(address: usize) -> *u64 { unsafe { return @ptrFromInt(*u64, address) } }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if target == source || count == 0 { return }
    if target < source || target >= source + count {
        var index: usize = 0
        // (Words while both are aligned alike, then bytes.)
        if (target & 7) == 0 && (source & 7) == 0 {
            while index + 8 <= count {
                put64(target + index, get64(source + index))
                index += 8
            }
        }
        while index < count {
            put8(target + index, get8(source + index))
            index += 1
        }
    } else {
        var index = count
        while index > 0 {
            index -= 1
            put8(target + index, get8(source + index))
        }
    }
}

pub fn zero(target: usize, count: usize) -> void {
    var index: usize = 0
    if (target & 7) == 0 {
        while index + 8 <= count {
            put64(target + index, 0)
            index += 8
        }
    }
    while index < count {
        put8(target + index, 0)
        index += 1
    }
}

pub fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

// The address of a literal's bytes (a NUL follows them), for C.
pub fn literal(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// A C string's length (0 for NULL).
pub fn cLength(text: usize) -> usize {
    if text == 0 { return 0 }
    var count: usize = 0
    while get8(text + count) != 0 { count += 1 }
    return count
}

pub fn cSlice(text: usize) -> []const u8 { return bytes(text, cLength(text)) }

// Whether C strings `a` and `b` hold the same bytes (NULL only as NULL).
pub fn cEqual(a: usize, b: usize) -> bool {
    if a == b { return true }
    if a == 0 || b == 0 { return false }
    var index: usize = 0
    while true {
        const x = get8(a + index)
        if x != get8(b + index) { return false }
        if x == 0 { return true }
        index += 1
    }
    return true
}

// Whether the C string `text` is the bytes of `word`.
pub fn cIs(text: usize, word: []const u8) -> bool {
    if text == 0 { return false }
    var index: usize = 0
    while index < word.length {
        if get8(text + index) != word[index] { return false }
        index += 1
    }
    return get8(text + word.length) == 0
}

pub fn cCompare(a: usize, b: usize) -> i32 {
    var index: usize = 0
    while true {
        const x = get8(a + index)
        const y = get8(b + index)
        if x != y { return if x < y { -1 } else { 1 } }
        if x == 0 { return 0 }
        index += 1
    }
    return 0
}

// A copy of `length` bytes at `text` in C memory, NUL-ended.
pub fn dupBytes(text: usize, length: usize) -> usize {
    const copied = raw(length + 1)
    copy(copied, text, length)
    put8(copied + length, 0)
    return copied
}

// A copy of the C string `text` (0 for NULL).
pub fn dup(text: usize) -> usize {
    if text == 0 { return 0 }
    return dupBytes(text, cLength(text))
}

pub fn dupSlice(text: []const u8) -> usize { return dupBytes(@intFromPtr(text.pointer), text.length) }

// ---------------------------------------------------------------------------
// Text built up byte by byte in C memory (NUL-ended as it grows).

pub const Text = struct {
    address: usize
    length: usize
    capacity: usize
}

pub fn text() -> Text { return Text.{ .address = 0, .length = 0, .capacity = 0 } }

pub fn reserve(t: *Text, more: usize) -> void {
    if t.*.length + more + 1 <= t.*.capacity { return }
    var larger = if t.*.capacity == 0 { 64 } else { t.*.capacity * 2 }
    while larger < t.*.length + more + 1 { larger = larger * 2 }
    t.*.address = grow(t.*.address, larger)
    t.*.capacity = larger
}

pub fn pushByte(t: *Text, value: u8) -> void {
    reserve(t, 1)
    put8(t.*.address + t.*.length, value)
    t.*.length += 1
    put8(t.*.address + t.*.length, 0)
}

pub fn pushBytes(t: *Text, address: usize, length: usize) -> void {
    reserve(t, length)
    copy(t.*.address + t.*.length, address, length)
    t.*.length += length
    put8(t.*.address + t.*.length, 0)
}

pub fn pushText(t: *Text, value: []const u8) -> void { pushBytes(t, @intFromPtr(value.pointer), value.length) }

pub fn pushC(t: *Text, value: usize) -> void { pushBytes(t, value, cLength(value)) }

pub fn pushDecimal(t: *Text, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var index: usize = 24 - count
    while index < 24 {
        pushByte(t, digits[index])
        index += 1
    }
}

pub fn pushSigned(t: *Text, value: i64) -> void {
    if value < 0 {
        pushByte(t, 45)
        pushDecimal(t, @bitCast(u64, 0 -% value))
    } else {
        pushDecimal(t, @bitCast(u64, value))
    }
}

pub fn pushHex(t: *Text, value: u8) -> void {
    const digits = "0123456789abcdef"
    pushByte(t, digits[@intCast(usize, value >> 4)])
    pushByte(t, digits[@intCast(usize, value & 15)])
}

// The text as a C string the caller owns ("" when nothing was pushed).
pub fn finish(t: *Text) -> usize {
    if t.*.address == 0 { return dupBytes(0, 0) }
    return t.*.address
}

pub fn dispose(t: *Text) -> void {
    release(t.*.address)
    t.*.address = 0
    t.*.length = 0
    t.*.capacity = 0
}

// ---------------------------------------------------------------------------
// Growing arrays of words in C memory.

pub const Words = struct {
    address: usize
    length: usize
    capacity: usize
}

pub fn words() -> Words { return Words.{ .address = 0, .length = 0, .capacity = 0 } }

pub fn pushWord(w: *Words, value: usize) -> void {
    if w.*.length == w.*.capacity {
        const larger = if w.*.capacity == 0 { 8 } else { w.*.capacity * 2 }
        w.*.address = grow(w.*.address, larger * 8)
        w.*.capacity = larger
    }
    putWord(w.*.address + w.*.length * 8, value)
    w.*.length += 1
}

pub fn wordAt(w: *Words, index: usize) -> usize { return getWord(w.*.address + index * 8) }

pub fn disposeWords(w: *Words) -> void {
    release(w.*.address)
    w.*.address = 0
    w.*.length = 0
    w.*.capacity = 0
}

// A NULL-ended array of the words of `w` the caller owns (a strv).
pub fn finishWords(w: *Words) -> usize {
    pushWord(w, 0)
    return w.*.address
}

// ASCII's classes of a byte.
pub fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }
pub fn isAlpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
pub fn isAlnum(c: u8) -> bool { return isDigit(c) || isAlpha(c) }
pub fn isSpace(c: u8) -> bool { return c == 32 || (c >= 9 && c <= 13) }
pub fn isHex(c: u8) -> bool { return isDigit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }
pub fn hexValue(c: u8) -> u8 {
    if isDigit(c) { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0
}
pub fn lower(c: u8) -> u8 { return if c >= 65 && c <= 90 { c + 32 } else { c } }
pub fn upper(c: u8) -> u8 { return if c >= 97 && c <= 122 { c - 32 } else { c } }
