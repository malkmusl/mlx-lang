// Hash tables (ghash.h): open addressing with linear probing over a
// power of two of buckets, a bucket's state its key's hash (0 empty, 1
// removed, 2 and up a key there), counted references. The hash and
// equality functions are C's (NULL: the pointers themselves).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const lists = @import("./lists.mlx")

const REFS: usize = 0
const COUNT: usize = 8
const USED: usize = 16
const CAPACITY: usize = 24
const HASH_FUNC: usize = 32
const EQUAL_FUNC: usize = 40
const KEY_DESTROY: usize = 48
const VALUE_DESTROY: usize = 56
const HASHES: usize = 64
const KEYS: usize = 72
const VALUES: usize = 80
const SIZE: usize = 88

pub const HashFunc = fn(usize) -> u32
pub const EqualFunc = fn(usize, usize) -> i32
pub const Notify = fn(usize) -> void
pub const HFunc = fn(usize, usize, usize) -> void
pub const HRFunc = fn(usize, usize, usize) -> i32

fn capacity(t: usize) -> usize { return m.getWord(t + CAPACITY) }
fn stateAt(t: usize, index: usize) -> u32 { return m.get32(m.getWord(t + HASHES) + index * 4) }
fn keyAt(t: usize, index: usize) -> usize { return m.getWord(m.getWord(t + KEYS) + index * 8) }
fn valueAt(t: usize, index: usize) -> usize { return m.getWord(m.getWord(t + VALUES) + index * 8) }

fn hashOf(t: usize, key: usize) -> u32 {
    const f = m.getWord(t + HASH_FUNC)
    var h: u32 = 0
    if f == 0 {
        h = @intCast(u32, key & 0xffffffff)
    } else {
        const call: HashFunc = unsafe { @ptrFromInt(HashFunc, f) }
        h = call(key)
    }
    // (0 and 1 are the states of empty and removed buckets.)
    return if h < 2 { h + 2 } else { h }
}

fn equal(t: usize, a: usize, b: usize) -> bool {
    const f = m.getWord(t + EQUAL_FUNC)
    if f == 0 { return a == b }
    const call: EqualFunc = unsafe { @ptrFromInt(EqualFunc, f) }
    return call(a, b) != 0
}

fn notify(f: usize, value: usize) -> void {
    if f == 0 { return }
    const call: Notify = unsafe { @ptrFromInt(Notify, f) }
    call(value)
}

pub fn newTable(hash_func: usize, key_equal_func: usize, key_destroy: usize, value_destroy: usize) -> usize {
    const t = m.alloc(SIZE)
    m.put32(t + REFS, 1)
    m.putWord(t + HASH_FUNC, hash_func)
    m.putWord(t + EQUAL_FUNC, key_equal_func)
    m.putWord(t + KEY_DESTROY, key_destroy)
    m.putWord(t + VALUE_DESTROY, value_destroy)
    allocate(t, 8)
    return t
}

fn allocate(t: usize, buckets: usize) -> void {
    m.putWord(t + CAPACITY, buckets)
    m.putWord(t + HASHES, m.alloc(buckets * 4))
    m.putWord(t + KEYS, m.alloc(buckets * 8))
    m.putWord(t + VALUES, m.alloc(buckets * 8))
    m.putWord(t + USED, 0)
}

// The bucket of `key`, or of where it would go (found tells which).
fn lookupBucket(t: usize, key: usize, h: u32, found: *bool) -> usize {
    const mask = capacity(t) - 1
    var index = @intCast(usize, h) & mask
    var firstRemoved: usize = 18446744073709551615
    while true {
        const state = stateAt(t, index)
        if state == 0 {
            found.* = false
            return if firstRemoved != 18446744073709551615 { firstRemoved } else { index }
        }
        if state == 1 {
            if firstRemoved == 18446744073709551615 { firstRemoved = index }
        } else if state == h && equal(t, keyAt(t, index), key) {
            found.* = true
            return index
        }
        index = (index + 1) & mask
    }
    return 0
}

fn resize(t: usize) -> void {
    const used = m.getWord(t + USED)
    const count = m.getWord(t + COUNT)
    const old = capacity(t)
    if (used + 1) * 4 < old * 3 && !(old > 8 && count * 8 < old) { return }
    var buckets: usize = 8
    while buckets * 3 <= (count + 1) * 4 * 2 { buckets = buckets * 2 }
    const hashes = m.getWord(t + HASHES)
    const keys = m.getWord(t + KEYS)
    const values = m.getWord(t + VALUES)
    allocate(t, buckets)
    var index: usize = 0
    while index < old {
        const state = m.get32(hashes + index * 4)
        if state >= 2 {
            var slot = @intCast(usize, state) & (buckets - 1)
            while stateAt(t, slot) != 0 { slot = (slot + 1) & (buckets - 1) }
            m.put32(m.getWord(t + HASHES) + slot * 4, state)
            m.putWord(m.getWord(t + KEYS) + slot * 8, m.getWord(keys + index * 8))
            m.putWord(m.getWord(t + VALUES) + slot * 8, m.getWord(values + index * 8))
            m.putWord(t + USED, m.getWord(t + USED) + 1)
        }
        index += 1
    }
    m.release(hashes)
    m.release(keys)
    m.release(values)
}

// Inserts or replaces; `keepKey`: an existing key stays (g_hash_table_insert).
pub fn insert(t: usize, key: usize, value: usize, keepKey: bool) -> bool {
    resize(t)
    const h = hashOf(t, key)
    var found = false
    const index = lookupBucket(t, key, h, &found)
    if found {
        const oldValue = valueAt(t, index)
        if keepKey {
            notify(m.getWord(t + KEY_DESTROY), key)
        } else {
            const oldKey = keyAt(t, index)
            m.putWord(m.getWord(t + KEYS) + index * 8, key)
            notify(m.getWord(t + KEY_DESTROY), oldKey)
        }
        m.putWord(m.getWord(t + VALUES) + index * 8, value)
        notify(m.getWord(t + VALUE_DESTROY), oldValue)
        return false
    }
    if stateAt(t, index) == 0 { m.putWord(t + USED, m.getWord(t + USED) + 1) }
    m.put32(m.getWord(t + HASHES) + index * 4, h)
    m.putWord(m.getWord(t + KEYS) + index * 8, key)
    m.putWord(m.getWord(t + VALUES) + index * 8, value)
    m.putWord(t + COUNT, m.getWord(t + COUNT) + 1)
    return true
}

pub fn find(t: usize, key: usize) -> isize {
    var found = false
    const index = lookupBucket(t, key, hashOf(t, key), &found)
    return if found { @intCast(isize, index) } else { -1 }
}

pub fn lookup(t: usize, key: usize) -> usize {
    const index = find(t, key)
    return if index < 0 { 0 } else { valueAt(t, @intCast(usize, index)) }
}

fn clearBucket(t: usize, index: usize, destroy: bool) -> void {
    const key = keyAt(t, index)
    const value = valueAt(t, index)
    m.put32(m.getWord(t + HASHES) + index * 4, 1)
    m.putWord(m.getWord(t + KEYS) + index * 8, 0)
    m.putWord(m.getWord(t + VALUES) + index * 8, 0)
    m.putWord(t + COUNT, m.getWord(t + COUNT) - 1)
    if destroy {
        notify(m.getWord(t + KEY_DESTROY), key)
        notify(m.getWord(t + VALUE_DESTROY), value)
    }
}

pub fn remove(t: usize, key: usize, destroy: bool) -> bool {
    const index = find(t, key)
    if index < 0 { return false }
    clearBucket(t, @intCast(usize, index), destroy)
    return true
}

pub fn removeAll(t: usize, destroy: bool) -> void {
    var index: usize = 0
    while index < capacity(t) {
        if stateAt(t, index) >= 2 { clearBucket(t, index, destroy) }
        index += 1
    }
    // (Every bucket empty again.)
    m.zero(m.getWord(t + HASHES), capacity(t) * 4)
    m.putWord(t + USED, 0)
}

pub fn size(t: usize) -> usize { return m.getWord(t + COUNT) }

pub fn unref(t: usize) -> void {
    if threads.refDec(t + REFS) {
        removeAll(t, true)
        m.release(m.getWord(t + HASHES))
        m.release(m.getWord(t + KEYS))
        m.release(m.getWord(t + VALUES))
        m.release(t)
    }
}

// The bucket after `index` holding a key (from -1 on), or -1.
pub fn nextUsed(t: usize, index: isize) -> isize {
    var at = index + 1
    while at < @intCast(isize, capacity(t)) {
        if stateAt(t, @intCast(usize, at)) >= 2 { return at }
        at += 1
    }
    return -1
}

pub fn keyAtBucket(t: usize, index: isize) -> usize { return keyAt(t, @intCast(usize, index)) }
pub fn valueAtBucket(t: usize, index: isize) -> usize { return valueAt(t, @intCast(usize, index)) }

export fn g_hash_table_new(hash_func: usize, key_equal_func: usize) -> usize { return newTable(hash_func, key_equal_func, 0, 0) }
export fn g_hash_table_new_full(hash_func: usize, key_equal_func: usize, key_destroy_func: usize, value_destroy_func: usize) -> usize { return newTable(hash_func, key_equal_func, key_destroy_func, value_destroy_func) }
export fn g_hash_table_new_similar(other: usize) -> usize { return newTable(m.getWord(other + HASH_FUNC), m.getWord(other + EQUAL_FUNC), m.getWord(other + KEY_DESTROY), m.getWord(other + VALUE_DESTROY)) }

export fn g_hash_table_destroy(t: usize) -> void {
    removeAll(t, true)
    unref(t)
}

export fn g_hash_table_insert(t: usize, key: usize, value: usize) -> i32 { return if insert(t, key, value, true) { 1 } else { 0 } }
export fn g_hash_table_replace(t: usize, key: usize, value: usize) -> i32 { return if insert(t, key, value, false) { 1 } else { 0 } }
export fn g_hash_table_add(t: usize, key: usize) -> i32 { return if insert(t, key, key, false) { 1 } else { 0 } }
export fn g_hash_table_remove(t: usize, key: usize) -> i32 { return if remove(t, key, true) { 1 } else { 0 } }
export fn g_hash_table_remove_all(t: usize) -> void { removeAll(t, true) }
export fn g_hash_table_steal(t: usize, key: usize) -> i32 { return if remove(t, key, false) { 1 } else { 0 } }
export fn g_hash_table_steal_all(t: usize) -> void { removeAll(t, false) }

export fn g_hash_table_steal_extended(t: usize, key: usize, stolen_key: usize, stolen_value: usize) -> i32 {
    const index = find(t, key)
    if index < 0 {
        if stolen_key != 0 { m.putWord(stolen_key, 0) }
        if stolen_value != 0 { m.putWord(stolen_value, 0) }
        return 0
    }
    if stolen_key != 0 { m.putWord(stolen_key, keyAt(t, @intCast(usize, index))) }
    if stolen_value != 0 { m.putWord(stolen_value, valueAt(t, @intCast(usize, index))) }
    clearBucket(t, @intCast(usize, index), false)
    return 1
}

export fn g_hash_table_lookup(t: usize, key: usize) -> usize { return lookup(t, key) }
export fn g_hash_table_contains(t: usize, key: usize) -> i32 { return if find(t, key) >= 0 { 1 } else { 0 } }

export fn g_hash_table_lookup_extended(t: usize, key: usize, orig_key: usize, value: usize) -> i32 {
    const index = find(t, key)
    if index < 0 { return 0 }
    if orig_key != 0 { m.putWord(orig_key, keyAt(t, @intCast(usize, index))) }
    if value != 0 { m.putWord(value, valueAt(t, @intCast(usize, index))) }
    return 1
}

export fn g_hash_table_foreach(t: usize, func: usize, user_data: usize) -> void {
    const call: HFunc = unsafe { @ptrFromInt(HFunc, func) }
    var index = nextUsed(t, -1)
    while index >= 0 {
        call(keyAt(t, @intCast(usize, index)), valueAt(t, @intCast(usize, index)), user_data)
        index = nextUsed(t, index)
    }
}

export fn g_hash_table_find(t: usize, predicate: usize, user_data: usize) -> usize {
    const call: HRFunc = unsafe { @ptrFromInt(HRFunc, predicate) }
    var index = nextUsed(t, -1)
    while index >= 0 {
        if call(keyAt(t, @intCast(usize, index)), valueAt(t, @intCast(usize, index)), user_data) != 0 { return valueAt(t, @intCast(usize, index)) }
        index = nextUsed(t, index)
    }
    return 0
}

fn foreachRemove(t: usize, func: usize, user_data: usize, destroy: bool) -> u32 {
    const call: HRFunc = unsafe { @ptrFromInt(HRFunc, func) }
    var count: u32 = 0
    var index = nextUsed(t, -1)
    while index >= 0 {
        if call(keyAt(t, @intCast(usize, index)), valueAt(t, @intCast(usize, index)), user_data) != 0 {
            clearBucket(t, @intCast(usize, index), destroy)
            count += 1
        }
        index = nextUsed(t, index)
    }
    return count
}

export fn g_hash_table_foreach_remove(t: usize, func: usize, user_data: usize) -> u32 { return foreachRemove(t, func, user_data, true) }
export fn g_hash_table_foreach_steal(t: usize, func: usize, user_data: usize) -> u32 { return foreachRemove(t, func, user_data, false) }
export fn g_hash_table_size(t: usize) -> u32 { return @intCast(u32, size(t)) }

export fn g_hash_table_get_keys(t: usize) -> usize {
    var list: usize = 0
    var index = nextUsed(t, -1)
    while index >= 0 {
        list = lists.listPrepend(list, keyAt(t, @intCast(usize, index)))
        index = nextUsed(t, index)
    }
    return list
}

export fn g_hash_table_get_values(t: usize) -> usize {
    var list: usize = 0
    var index = nextUsed(t, -1)
    while index >= 0 {
        list = lists.listPrepend(list, valueAt(t, @intCast(usize, index)))
        index = nextUsed(t, index)
    }
    return list
}

export fn g_hash_table_get_keys_as_array(t: usize, length: usize) -> usize {
    const result = m.alloc((size(t) + 1) * 8)
    var count: usize = 0
    var index = nextUsed(t, -1)
    while index >= 0 {
        m.putWord(result + count * 8, keyAt(t, @intCast(usize, index)))
        count += 1
        index = nextUsed(t, index)
    }
    if length != 0 { m.put32(length, @intCast(u32, count)) }
    return result
}

// An iterator: the table, then its bucket.
export fn g_hash_table_iter_init(iter: usize, t: usize) -> void {
    m.putWord(iter, t)
    m.putWord(iter + 8, 0)
    m.putI64(iter + 16, -1)
}

export fn g_hash_table_iter_next(iter: usize, key: usize, value: usize) -> i32 {
    const t = m.getWord(iter)
    const index = nextUsed(t, @intCast(isize, m.getI64(iter + 16)))
    m.putI64(iter + 16, @intCast(i64, index))
    if index < 0 { return 0 }
    if key != 0 { m.putWord(key, keyAt(t, @intCast(usize, index))) }
    if value != 0 { m.putWord(value, valueAt(t, @intCast(usize, index))) }
    return 1
}

export fn g_hash_table_iter_get_hash_table(iter: usize) -> usize { return m.getWord(iter) }
export fn g_hash_table_iter_remove(iter: usize) -> void { clearBucket(m.getWord(iter), @intCast(usize, m.getI64(iter + 16)), true) }
export fn g_hash_table_iter_steal(iter: usize) -> void { clearBucket(m.getWord(iter), @intCast(usize, m.getI64(iter + 16)), false) }

export fn g_hash_table_iter_replace(iter: usize, value: usize) -> void {
    const t = m.getWord(iter)
    const index = @intCast(usize, m.getI64(iter + 16))
    const old = valueAt(t, index)
    m.putWord(m.getWord(t + VALUES) + index * 8, value)
    notify(m.getWord(t + VALUE_DESTROY), old)
}

export fn g_hash_table_ref(t: usize) -> usize {
    threads.refInc(t + REFS)
    return t
}

export fn g_hash_table_unref(t: usize) -> void { unref(t) }

export fn g_str_equal(v1: usize, v2: usize) -> i32 { return if m.cEqual(v1, v2) { 1 } else { 0 } }
export fn g_str_hash(v: usize) -> u32 { return errors.hashBytes(v) }
export fn g_int_equal(v1: usize, v2: usize) -> i32 { return if m.getI32(v1) == m.getI32(v2) { 1 } else { 0 } }
export fn g_int_hash(v: usize) -> u32 { return m.get32(v) }
export fn g_int64_equal(v1: usize, v2: usize) -> i32 { return if m.get64(v1) == m.get64(v2) { 1 } else { 0 } }
export fn g_int64_hash(v: usize) -> u32 {
    const value = m.get64(v)
    return @intCast(u32, (value ^ (value >> 32)) & 0xffffffff)
}
export fn g_double_equal(v1: usize, v2: usize) -> i32 { return if m.getF64(v1) == m.getF64(v2) { 1 } else { 0 } }
export fn g_double_hash(v: usize) -> u32 {
    const value = m.getF64(v)
    if value < 0.0 || value >= 4294967296.0 { return 0 }
    return @intFromFloat(u32, value)
}
export fn g_direct_hash(v: usize) -> u32 { return @intCast(u32, v & 0xffffffff) }
export fn g_direct_equal(v1: usize, v2: usize) -> i32 { return if v1 == v2 { 1 } else { 0 } }
