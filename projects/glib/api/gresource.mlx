// gio/gresource.h
// mlx-glib: resource bundles (the GVDB files glib-compile-resources
// writes), loaded or mapped, registered for lookups by path.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gbytes = @import("./gbytes.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gsize = gtypes.gsize
const guint32 = gtypes.guint32
const GError = gerror.GError
const GResource = giotypes.GResource
const GBytes = gbytes.GBytes
const GResourceLookupFlags = gioenums.GResourceLookupFlags

pub const _GStaticResource = struct {
    data: [*]const gtypes.guint8
    data_len: gsize
    resource: ?*GResource
    next: ?*GStaticResource
    padding: gtypes.gpointer
}
pub const GStaticResource = _GStaticResource

pub const G_RESOURCE_ERROR: gquark.GQuark = g_resource_error_quark()

pub extern("c") fn g_resource_error_quark() -> gquark.GQuark
pub extern("c") fn g_resource_get_type() -> gtype.GType
pub extern("c") fn g_resource_new_from_data(data: *GBytes, error_: ?**GError) -> ?*GResource
pub extern("c") fn g_resource_ref(resource: *GResource) -> *GResource
pub extern("c") fn g_resource_unref(resource: *GResource) -> void
pub extern("c") fn g_resource_load(filename: [*]const gchar, error_: ?**GError) -> ?*GResource
pub extern("c") fn g_resource_lookup_data(resource: *GResource, path: [*]const c_char, lookup_flags: GResourceLookupFlags, error_: ?**GError) -> ?*GBytes
pub extern("c") fn g_resource_enumerate_children(resource: *GResource, path: [*]const c_char, lookup_flags: GResourceLookupFlags, error_: ?**GError) -> ?[*][*]c_char
pub extern("c") fn g_resource_get_info(resource: *GResource, path: [*]const c_char, lookup_flags: GResourceLookupFlags, size: ?*gsize, flags: ?*guint32, error_: ?**GError) -> gboolean
pub extern("c") fn g_resources_register(resource: *GResource) -> void
pub extern("c") fn g_resources_unregister(resource: *GResource) -> void
pub extern("c") fn g_resources_lookup_data(path: [*]const c_char, lookup_flags: GResourceLookupFlags, error_: ?**GError) -> ?*GBytes
pub extern("c") fn g_resources_enumerate_children(path: [*]const c_char, lookup_flags: GResourceLookupFlags, error_: ?**GError) -> ?[*][*]c_char
pub extern("c") fn g_resources_get_info(path: [*]const c_char, lookup_flags: GResourceLookupFlags, size: ?*gsize, flags: ?*guint32, error_: ?**GError) -> gboolean
pub extern("c") fn g_static_resource_init(static_resource: *GStaticResource) -> void
pub extern("c") fn g_static_resource_fini(static_resource: *GStaticResource) -> void
pub extern("c") fn g_static_resource_get_resource(static_resource: *GStaticResource) -> *GResource

pub const G_TYPE_RESOURCE: gtype.GType = g_resource_get_type()
