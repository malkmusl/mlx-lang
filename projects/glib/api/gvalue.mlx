// gobject/gvalue.h
// mlx-glib: GValue, a value of any type the type system knows (its type
// and two words), and the values of the fundamental types (gvaluetypes.h
// in GLib).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gvariant = @import("./gvariant.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gint = gtypes.gint
const guint = gtypes.guint
const glong = gtypes.glong
const gulong = gtypes.gulong
const gint64 = gtypes.gint64
const guint64 = gtypes.guint64
const gfloat = gtypes.gfloat
const gdouble = gtypes.gdouble
const guchar = gtypes.guchar
const gpointer = gtypes.gpointer
const GType = gtype.GType

pub const _GValue = struct {
    g_type: GType
    data: [2]union {
        v_int: gint
        v_uint: guint
        v_long: glong
        v_ulong: gulong
        v_int64: gint64
        v_uint64: guint64
        v_float: gfloat
        v_double: gdouble
        v_pointer: gpointer
    }
}
pub const GValue = _GValue

// A GValue not yet initialized (all zero).
pub const G_VALUE_INIT: GValue = GValue.{ .g_type = 0, .data = .{ .{ 0 } } }

pub const GValueTransform = fn(src_value: *const GValue, dest_value: *GValue) -> void

pub const G_VALUE_NOCOPY_CONTENTS: c_int = 1 << 27
pub const G_VALUE_INTERNED_STRING: c_int = 1 << 28

pub extern("c") fn g_value_init(value: *GValue, g_type: GType) -> *GValue
pub extern("c") fn g_value_copy(src_value: *const GValue, dest_value: *GValue) -> void
pub extern("c") fn g_value_reset(value: *GValue) -> *GValue
pub extern("c") fn g_value_unset(value: *GValue) -> void
pub extern("c") fn g_value_set_instance(value: *GValue, instance: gpointer) -> void
pub extern("c") fn g_value_init_from_instance(value: *GValue, instance: gpointer) -> void
pub extern("c") fn g_value_fits_pointer(value: *const GValue) -> gboolean
pub extern("c") fn g_value_peek_pointer(value: *const GValue) -> gpointer
pub extern("c") fn g_value_type_compatible(src_type: GType, dest_type: GType) -> gboolean
pub extern("c") fn g_value_type_transformable(src_type: GType, dest_type: GType) -> gboolean
pub extern("c") fn g_value_transform(src_value: *const GValue, dest_value: *GValue) -> gboolean
pub extern("c") fn g_value_register_transform_func(src_type: GType, dest_type: GType, transform_func: GValueTransform) -> void

pub extern("c") fn g_value_set_char(value: *GValue, v_char: gchar) -> void
pub extern("c") fn g_value_get_char(value: *const GValue) -> gchar
pub extern("c") fn g_value_set_schar(value: *GValue, v_char: gtypes.gint8) -> void
pub extern("c") fn g_value_get_schar(value: *const GValue) -> gtypes.gint8
pub extern("c") fn g_value_set_uchar(value: *GValue, v_uchar: guchar) -> void
pub extern("c") fn g_value_get_uchar(value: *const GValue) -> guchar
pub extern("c") fn g_value_set_boolean(value: *GValue, v_boolean: gboolean) -> void
pub extern("c") fn g_value_get_boolean(value: *const GValue) -> gboolean
pub extern("c") fn g_value_set_int(value: *GValue, v_int: gint) -> void
pub extern("c") fn g_value_get_int(value: *const GValue) -> gint
pub extern("c") fn g_value_set_uint(value: *GValue, v_uint: guint) -> void
pub extern("c") fn g_value_get_uint(value: *const GValue) -> guint
pub extern("c") fn g_value_set_long(value: *GValue, v_long: glong) -> void
pub extern("c") fn g_value_get_long(value: *const GValue) -> glong
pub extern("c") fn g_value_set_ulong(value: *GValue, v_ulong: gulong) -> void
pub extern("c") fn g_value_get_ulong(value: *const GValue) -> gulong
pub extern("c") fn g_value_set_int64(value: *GValue, v_int64: gint64) -> void
pub extern("c") fn g_value_get_int64(value: *const GValue) -> gint64
pub extern("c") fn g_value_set_uint64(value: *GValue, v_uint64: guint64) -> void
pub extern("c") fn g_value_get_uint64(value: *const GValue) -> guint64
pub extern("c") fn g_value_set_float(value: *GValue, v_float: gfloat) -> void
pub extern("c") fn g_value_get_float(value: *const GValue) -> gfloat
pub extern("c") fn g_value_set_double(value: *GValue, v_double: gdouble) -> void
pub extern("c") fn g_value_get_double(value: *const GValue) -> gdouble
pub extern("c") fn g_value_set_string(value: *GValue, v_string: ?[*]const gchar) -> void
pub extern("c") fn g_value_set_static_string(value: *GValue, v_string: ?[*]const gchar) -> void
pub extern("c") fn g_value_set_interned_string(value: *GValue, v_string: ?[*]const gchar) -> void
pub extern("c") fn g_value_get_string(value: *const GValue) -> ?[*]const gchar
pub extern("c") fn g_value_dup_string(value: *const GValue) -> ?[*]gchar
pub extern("c") fn g_value_take_string(value: *GValue, v_string: ?[*]gchar) -> void
pub extern("c") fn g_value_steal_string(value: *GValue) -> ?[*]gchar
pub extern("c") fn g_value_set_pointer(value: *GValue, v_pointer: gpointer) -> void
pub extern("c") fn g_value_get_pointer(value: *const GValue) -> gpointer
pub extern("c") fn g_value_set_gtype(value: *GValue, v_gtype: GType) -> void
pub extern("c") fn g_value_get_gtype(value: *const GValue) -> GType
pub extern("c") fn g_value_set_variant(value: *GValue, variant: ?*gvariant.GVariant) -> void
pub extern("c") fn g_value_take_variant(value: *GValue, variant: ?*gvariant.GVariant) -> void
pub extern("c") fn g_value_get_variant(value: *const GValue) -> ?*gvariant.GVariant
pub extern("c") fn g_value_dup_variant(value: *const GValue) -> ?*gvariant.GVariant
pub extern("c") fn g_pointer_type_register_static(name: [*]const gchar) -> GType
pub extern("c") fn g_strdup_value_contents(value: *const GValue) -> [*]gchar
pub extern("c") fn g_gtype_get_type() -> GType

pub const G_TYPE_GTYPE: GType = g_gtype_get_type()

pub fn G_VALUE_TYPE(value: anytype) -> GType { return @ptrCast(*const GValue, value).*.g_type }
pub fn G_VALUE_TYPE_NAME(value: anytype) -> [*]const gchar { return gtype.g_type_name(G_VALUE_TYPE(value)) }
pub fn G_VALUE_HOLDS(value: anytype, g_type: GType) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, g_type) }
pub fn G_IS_VALUE(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE(value) }
pub fn G_VALUE_HOLDS_CHAR(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_CHAR) }
pub fn G_VALUE_HOLDS_UCHAR(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_UCHAR) }
pub fn G_VALUE_HOLDS_BOOLEAN(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_BOOLEAN) }
pub fn G_VALUE_HOLDS_INT(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_INT) }
pub fn G_VALUE_HOLDS_UINT(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_UINT) }
pub fn G_VALUE_HOLDS_LONG(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_LONG) }
pub fn G_VALUE_HOLDS_ULONG(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_ULONG) }
pub fn G_VALUE_HOLDS_INT64(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_INT64) }
pub fn G_VALUE_HOLDS_UINT64(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_UINT64) }
pub fn G_VALUE_HOLDS_FLOAT(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_FLOAT) }
pub fn G_VALUE_HOLDS_DOUBLE(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_DOUBLE) }
pub fn G_VALUE_HOLDS_STRING(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_STRING) }
pub fn G_VALUE_HOLDS_POINTER(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_POINTER) }
pub fn G_VALUE_HOLDS_VARIANT(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_VARIANT) }
pub fn G_VALUE_HOLDS_GTYPE(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, G_TYPE_GTYPE) }
