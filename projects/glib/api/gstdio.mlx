// glib/gstdio.h
// mlx-glib: the C library's file functions under GLib's names (on Linux
// they are the same functions).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const gboolean = gtypes.gboolean

pub extern("c") fn g_access(filename: [*]const gchar, mode: c_int) -> c_int
pub extern("c") fn g_chdir(path: [*]const gchar) -> c_int
pub extern("c") fn g_unlink(filename: [*]const gchar) -> c_int
pub extern("c") fn g_rmdir(filename: [*]const gchar) -> c_int
pub extern("c") fn g_remove(filename: [*]const gchar) -> c_int
pub extern("c") fn g_rename(oldfilename: [*]const gchar, newfilename: [*]const gchar) -> c_int
pub extern("c") fn g_mkdir(filename: [*]const gchar, mode: c_int) -> c_int
pub extern("c") fn g_chmod(filename: [*]const gchar, mode: c_int) -> c_int
pub extern("c") fn g_open(filename: [*]const gchar, flags: c_int, mode: c_int) -> c_int
pub extern("c") fn g_creat(filename: [*]const gchar, mode: c_int) -> c_int
pub extern("c") fn g_close(fd: gint, error_: ?**gerror.GError) -> gboolean
pub extern("c") fn g_fsync(fd: gint) -> gint
