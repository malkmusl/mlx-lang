// glib/ghostutils.h
// mlx-glib: host names: IP addresses and the ASCII forms of names.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean

pub extern("c") fn g_hostname_is_ip_address(hostname: [*]const gchar) -> gboolean
pub extern("c") fn g_hostname_is_non_ascii(hostname: [*]const gchar) -> gboolean
pub extern("c") fn g_hostname_is_ascii_encoded(hostname: [*]const gchar) -> gboolean
