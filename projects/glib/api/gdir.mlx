// glib/gdir.h
// mlx-glib: reading the names of a directory.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar

pub const _GDir = struct {}
pub const GDir = _GDir

pub extern("c") fn g_dir_open(path: [*]const gchar, flags: gtypes.guint, error_: ?**gerror.GError) -> ?*GDir
pub extern("c") fn g_dir_read_name(dir: *GDir) -> ?[*]const gchar
pub extern("c") fn g_dir_rewind(dir: *GDir) -> void
pub extern("c") fn g_dir_close(dir: *GDir) -> void
pub extern("c") fn g_dir_ref(dir: *GDir) -> *GDir
pub extern("c") fn g_dir_unref(dir: *GDir) -> void
