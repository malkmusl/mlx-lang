pub extern("c") fn g_variant_iter_next(iter: *GVariantIter, format_string: [*]const gchar, args: gtypes.c_varargs) -> gboolean
pub extern("c") fn g_variant_iter_loop(iter: *GVariantIter, format_string: [*]const gchar, args: gtypes.c_varargs) -> gboolean

pub extern("c") fn g_variant_parse_error_quark() -> gquark.GQuark
pub extern("c") fn g_variant_parse(type_: ?*const GVariantType, text: [*]const gchar, limit: ?[*]const gchar, endptr: ?*[*]const gchar, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_variant_new_parsed(format: [*]const gchar, args: gtypes.c_varargs) -> *GVariant

