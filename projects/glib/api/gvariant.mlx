// glib/gvariant.h
// mlx-glib: GVariant, typed values in GVariant's serialization format
// (what D-Bus and WebKit's messages carry): made of C values or of
// serialized data, read back, built and iterated, counted references with
// a floating first one.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gstring = @import("./gstring.mlx")
const gbytes = @import("./gbytes.mlx")
const gvarianttype = @import("./gvarianttype.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const guint = gtypes.guint
const gint = gtypes.gint
const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const guchar = gtypes.guchar
const gint16 = gtypes.gint16
const guint16 = gtypes.guint16
const gint32 = gtypes.gint32
const guint32 = gtypes.guint32
const gint64 = gtypes.gint64
const guint64 = gtypes.guint64
const gdouble = gtypes.gdouble
const GVariantType = gvarianttype.GVariantType
const GError = gerror.GError

pub const _GVariant = struct {}
pub const GVariant = _GVariant

pub const GVariantClass = enum(c_int) {
    G_VARIANT_CLASS_BOOLEAN = 'b',
    G_VARIANT_CLASS_BYTE = 'y',
    G_VARIANT_CLASS_INT16 = 'n',
    G_VARIANT_CLASS_UINT16 = 'q',
    G_VARIANT_CLASS_INT32 = 'i',
    G_VARIANT_CLASS_UINT32 = 'u',
    G_VARIANT_CLASS_INT64 = 'x',
    G_VARIANT_CLASS_UINT64 = 't',
    G_VARIANT_CLASS_HANDLE = 'h',
    G_VARIANT_CLASS_DOUBLE = 'd',
    G_VARIANT_CLASS_STRING = 's',
    G_VARIANT_CLASS_OBJECT_PATH = 'o',
    G_VARIANT_CLASS_SIGNATURE = 'g',
    G_VARIANT_CLASS_VARIANT = 'v',
    G_VARIANT_CLASS_MAYBE = 'm',
    G_VARIANT_CLASS_ARRAY = 'a',
    G_VARIANT_CLASS_TUPLE = '(',
    G_VARIANT_CLASS_DICT_ENTRY = '{',
}

pub const GVariantParseError = enum(c_int) {
    G_VARIANT_PARSE_ERROR_FAILED,
    G_VARIANT_PARSE_ERROR_BASIC_TYPE_EXPECTED,
    G_VARIANT_PARSE_ERROR_CANNOT_INFER_TYPE,
    G_VARIANT_PARSE_ERROR_DEFINITE_TYPE_EXPECTED,
    G_VARIANT_PARSE_ERROR_INPUT_NOT_AT_END,
    G_VARIANT_PARSE_ERROR_INVALID_CHARACTER,
    G_VARIANT_PARSE_ERROR_INVALID_FORMAT_STRING,
    G_VARIANT_PARSE_ERROR_INVALID_OBJECT_PATH,
    G_VARIANT_PARSE_ERROR_INVALID_SIGNATURE,
    G_VARIANT_PARSE_ERROR_INVALID_TYPE_STRING,
    G_VARIANT_PARSE_ERROR_NO_COMMON_TYPE,
    G_VARIANT_PARSE_ERROR_NUMBER_OUT_OF_RANGE,
    G_VARIANT_PARSE_ERROR_NUMBER_TOO_BIG,
    G_VARIANT_PARSE_ERROR_TYPE_ERROR,
    G_VARIANT_PARSE_ERROR_UNEXPECTED_TOKEN,
    G_VARIANT_PARSE_ERROR_UNKNOWN_KEYWORD,
    G_VARIANT_PARSE_ERROR_UNTERMINATED_STRING_CONSTANT,
    G_VARIANT_PARSE_ERROR_VALUE_EXPECTED,
    G_VARIANT_PARSE_ERROR_RECURSION,
}

pub const G_VARIANT_PARSE_ERROR: gquark.GQuark = g_variant_parse_error_quark()

// An iterator over a container (its words are the library's own).
pub const _GVariantIter = struct {
    x: [16]gsize
}
pub const GVariantIter = _GVariantIter

pub const _GVariantBuilder = struct {
    u: union {
        s: struct { partial_magic: gsize, type_: *const GVariantType, y: [14]gsize }
        x: [16]gsize
    }
}
pub const GVariantBuilder = _GVariantBuilder

pub const _GVariantDict = struct {
    u: union {
        s: struct { asv: *GVariant, partial_magic: gsize, y: [14]gsize }
        x: [16]gsize
    }
}
pub const GVariantDict = _GVariantDict

pub extern("c") fn g_variant_unref(value: *GVariant) -> void
pub extern("c") fn g_variant_ref(value: *GVariant) -> *GVariant
pub extern("c") fn g_variant_ref_sink(value: *GVariant) -> *GVariant
pub extern("c") fn g_variant_is_floating(value: *GVariant) -> gboolean
pub extern("c") fn g_variant_take_ref(value: *GVariant) -> *GVariant
pub extern("c") fn g_variant_get_type(value: *GVariant) -> *const GVariantType
pub extern("c") fn g_variant_get_type_string(value: *GVariant) -> [*]const gchar
pub extern("c") fn g_variant_is_of_type(value: *GVariant, type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_is_container(value: *GVariant) -> gboolean
pub extern("c") fn g_variant_classify(value: *GVariant) -> GVariantClass

pub extern("c") fn g_variant_new_boolean(value: gboolean) -> *GVariant
pub extern("c") fn g_variant_new_byte(value: guchar) -> *GVariant
pub extern("c") fn g_variant_new_int16(value: gint16) -> *GVariant
pub extern("c") fn g_variant_new_uint16(value: guint16) -> *GVariant
pub extern("c") fn g_variant_new_int32(value: gint32) -> *GVariant
pub extern("c") fn g_variant_new_uint32(value: guint32) -> *GVariant
pub extern("c") fn g_variant_new_int64(value: gint64) -> *GVariant
pub extern("c") fn g_variant_new_uint64(value: guint64) -> *GVariant
pub extern("c") fn g_variant_new_handle(value: gint32) -> *GVariant
pub extern("c") fn g_variant_new_double(value: gdouble) -> *GVariant
pub extern("c") fn g_variant_new_string(text: [*]const gchar) -> *GVariant
pub extern("c") fn g_variant_new_take_string(text: [*]gchar) -> *GVariant
pub extern("c") fn g_variant_new_printf(format_string: [*]const gchar, args: gtypes.c_varargs) -> *GVariant
pub extern("c") fn g_variant_new_object_path(object_path: [*]const gchar) -> *GVariant
pub extern("c") fn g_variant_is_object_path(text: [*]const gchar) -> gboolean
pub extern("c") fn g_variant_new_signature(signature: [*]const gchar) -> *GVariant
pub extern("c") fn g_variant_is_signature(text: [*]const gchar) -> gboolean
pub extern("c") fn g_variant_new_variant(value: *GVariant) -> *GVariant
pub extern("c") fn g_variant_new_strv(strv: [*]const [*]const gchar, length: gssize) -> *GVariant
pub extern("c") fn g_variant_new_objv(strv: [*]const [*]const gchar, length: gssize) -> *GVariant
pub extern("c") fn g_variant_new_bytestring(text: [*]const gchar) -> *GVariant
pub extern("c") fn g_variant_new_bytestring_array(strv: [*]const [*]const gchar, length: gssize) -> *GVariant
pub extern("c") fn g_variant_new_fixed_array(element_type: *const GVariantType, elements: gconstpointer, n_elements: gsize, element_size: gsize) -> *GVariant

pub extern("c") fn g_variant_get_boolean(value: *GVariant) -> gboolean
pub extern("c") fn g_variant_get_byte(value: *GVariant) -> guchar
pub extern("c") fn g_variant_get_int16(value: *GVariant) -> gint16
pub extern("c") fn g_variant_get_uint16(value: *GVariant) -> guint16
pub extern("c") fn g_variant_get_int32(value: *GVariant) -> gint32
pub extern("c") fn g_variant_get_uint32(value: *GVariant) -> guint32
pub extern("c") fn g_variant_get_int64(value: *GVariant) -> gint64
pub extern("c") fn g_variant_get_uint64(value: *GVariant) -> guint64
pub extern("c") fn g_variant_get_handle(value: *GVariant) -> gint32
pub extern("c") fn g_variant_get_double(value: *GVariant) -> gdouble
pub extern("c") fn g_variant_get_variant(value: *GVariant) -> *GVariant
pub extern("c") fn g_variant_get_string(value: *GVariant, length: ?*gsize) -> [*]const gchar
pub extern("c") fn g_variant_dup_string(value: *GVariant, length: ?*gsize) -> [*]gchar
pub extern("c") fn g_variant_get_strv(value: *GVariant, length: ?*gsize) -> [*][*]const gchar
pub extern("c") fn g_variant_dup_strv(value: *GVariant, length: ?*gsize) -> [*][*]gchar
pub extern("c") fn g_variant_get_objv(value: *GVariant, length: ?*gsize) -> [*][*]const gchar
pub extern("c") fn g_variant_dup_objv(value: *GVariant, length: ?*gsize) -> [*][*]gchar
pub extern("c") fn g_variant_get_bytestring(value: *GVariant) -> [*]const gchar
pub extern("c") fn g_variant_dup_bytestring(value: *GVariant, length: ?*gsize) -> [*]gchar
pub extern("c") fn g_variant_get_bytestring_array(value: *GVariant, length: ?*gsize) -> [*][*]const gchar
pub extern("c") fn g_variant_dup_bytestring_array(value: *GVariant, length: ?*gsize) -> [*][*]gchar

pub extern("c") fn g_variant_new_maybe(child_type: ?*const GVariantType, child: ?*GVariant) -> *GVariant
pub extern("c") fn g_variant_new_array(child_type: ?*const GVariantType, children: ?[*]const *GVariant, n_children: gsize) -> *GVariant
pub extern("c") fn g_variant_new_tuple(children: ?[*]const *GVariant, n_children: gsize) -> *GVariant
pub extern("c") fn g_variant_new_dict_entry(key: *GVariant, value: *GVariant) -> *GVariant
pub extern("c") fn g_variant_get_maybe(value: *GVariant) -> ?*GVariant
pub extern("c") fn g_variant_n_children(value: *GVariant) -> gsize
pub extern("c") fn g_variant_get_child(value: *GVariant, index_: gsize, format_string: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_variant_get_child_value(value: *GVariant, index_: gsize) -> *GVariant
pub extern("c") fn g_variant_lookup(dictionary: *GVariant, key: [*]const gchar, format_string: [*]const gchar, args: gtypes.c_varargs) -> gboolean
pub extern("c") fn g_variant_lookup_value(dictionary: *GVariant, key: [*]const gchar, expected_type: ?*const GVariantType) -> ?*GVariant
pub extern("c") fn g_variant_get_fixed_array(value: *GVariant, n_elements: *gsize, element_size: gsize) -> gconstpointer

pub extern("c") fn g_variant_get_size(value: *GVariant) -> gsize
pub extern("c") fn g_variant_get_data(value: *GVariant) -> gconstpointer
pub extern("c") fn g_variant_get_data_as_bytes(value: *GVariant) -> *gbytes.GBytes
