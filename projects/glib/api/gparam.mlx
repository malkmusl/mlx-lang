// gobject/gparam.h
// mlx-glib: GParamSpec, the description of a property (its name, value
// type, flags and limits), and the parameter specifications of the
// fundamental types (gparamspecs.h in GLib).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gtype = @import("./gtype.mlx")
const gvalue = @import("./gvalue.mlx")
const gvarianttype = @import("./gvarianttype.mlx")
const gvariant = @import("./gvariant.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gint = gtypes.gint
const guint = gtypes.guint
const glong = gtypes.glong
const gulong = gtypes.gulong
const gint8 = gtypes.gint8
const guint8 = gtypes.guint8
const gint64 = gtypes.gint64
const guint64 = gtypes.guint64
const gfloat = gtypes.gfloat
const gdouble = gtypes.gdouble
const gpointer = gtypes.gpointer
const GType = gtype.GType
const GValue = gvalue.GValue
const GQuark = gquark.GQuark

pub const GParamFlags = enum(c_int) {
    G_PARAM_READABLE = 1,
    G_PARAM_WRITABLE = 2,
    G_PARAM_READWRITE = 3,
    G_PARAM_CONSTRUCT = 4,
    G_PARAM_CONSTRUCT_ONLY = 8,
    G_PARAM_LAX_VALIDATION = 16,
    G_PARAM_STATIC_NAME = 32,
    G_PARAM_STATIC_NICK = 64,
    G_PARAM_STATIC_BLURB = 128,
    G_PARAM_EXPLICIT_NOTIFY = 1073741824,
    G_PARAM_DEPRECATED = -2147483648,
}

pub const G_PARAM_PRIVATE: c_int = 32
pub const G_PARAM_STATIC_STRINGS: c_int = 224
pub const G_PARAM_MASK: c_int = 255
pub const G_PARAM_USER_SHIFT: c_int = 8

pub const _GParamSpec = struct {
    g_type_instance: gtype.GTypeInstance
    name: [*]const gchar
    flags: GParamFlags
    value_type: GType
    owner_type: GType
    _nick: [*]gchar
    _blurb: [*]gchar
    qdata: gpointer
    ref_count: guint
    param_id: guint
}
pub const GParamSpec = _GParamSpec

pub const _GParamSpecClass = struct {
    g_type_class: gtype.GTypeClass
    value_type: GType
    finalize: fn(pspec: *GParamSpec) -> void
    value_set_default: fn(pspec: *GParamSpec, value: *GValue) -> void
    value_validate: fn(pspec: *GParamSpec, value: *GValue) -> gboolean
    values_cmp: fn(pspec: *GParamSpec, value1: *const GValue, value2: *const GValue) -> gint
    value_is_valid: fn(pspec: *GParamSpec, value: *const GValue) -> gboolean
    dummy: [3]gpointer
}
pub const GParamSpecClass = _GParamSpecClass

pub const _GParameter = struct {
    name: [*]const gchar
    value: GValue
}
pub const GParameter = _GParameter

pub const _GParamSpecChar = struct { parent_instance: GParamSpec, minimum: gint8, maximum: gint8, default_value: gint8 }
pub const GParamSpecChar = _GParamSpecChar
pub const _GParamSpecUChar = struct { parent_instance: GParamSpec, minimum: guint8, maximum: guint8, default_value: guint8 }
pub const GParamSpecUChar = _GParamSpecUChar
pub const _GParamSpecBoolean = struct { parent_instance: GParamSpec, default_value: gboolean }
pub const GParamSpecBoolean = _GParamSpecBoolean
pub const _GParamSpecInt = struct { parent_instance: GParamSpec, minimum: gint, maximum: gint, default_value: gint }
pub const GParamSpecInt = _GParamSpecInt
pub const _GParamSpecUInt = struct { parent_instance: GParamSpec, minimum: guint, maximum: guint, default_value: guint }
pub const GParamSpecUInt = _GParamSpecUInt
pub const _GParamSpecLong = struct { parent_instance: GParamSpec, minimum: glong, maximum: glong, default_value: glong }
pub const GParamSpecLong = _GParamSpecLong
pub const _GParamSpecULong = struct { parent_instance: GParamSpec, minimum: gulong, maximum: gulong, default_value: gulong }
pub const GParamSpecULong = _GParamSpecULong
pub const _GParamSpecInt64 = struct { parent_instance: GParamSpec, minimum: gint64, maximum: gint64, default_value: gint64 }
pub const GParamSpecInt64 = _GParamSpecInt64
pub const _GParamSpecUInt64 = struct { parent_instance: GParamSpec, minimum: guint64, maximum: guint64, default_value: guint64 }
pub const GParamSpecUInt64 = _GParamSpecUInt64
pub const _GParamSpecFloat = struct { parent_instance: GParamSpec, minimum: gfloat, maximum: gfloat, default_value: gfloat, epsilon: gfloat }
pub const GParamSpecFloat = _GParamSpecFloat
pub const _GParamSpecDouble = struct { parent_instance: GParamSpec, minimum: gdouble, maximum: gdouble, default_value: gdouble, epsilon: gdouble }
pub const GParamSpecDouble = _GParamSpecDouble
pub const _GParamSpecEnum = struct { parent_instance: GParamSpec, enum_class: gpointer, default_value: gint }
pub const GParamSpecEnum = _GParamSpecEnum
pub const _GParamSpecFlags = struct { parent_instance: GParamSpec, flags_class: gpointer, default_value: guint }
pub const GParamSpecFlags = _GParamSpecFlags
pub const _GParamSpecString = struct { parent_instance: GParamSpec, default_value: [*]gchar, cset_first: [*]gchar, cset_nth: [*]gchar, substitutor: gchar, flags: guint }
pub const GParamSpecString = _GParamSpecString
pub const _GParamSpecPointer = struct { parent_instance: GParamSpec }
pub const GParamSpecPointer = _GParamSpecPointer
pub const _GParamSpecBoxed = struct { parent_instance: GParamSpec }
pub const GParamSpecBoxed = _GParamSpecBoxed
pub const _GParamSpecObject = struct { parent_instance: GParamSpec }
pub const GParamSpecObject = _GParamSpecObject
pub const _GParamSpecParam = struct { parent_instance: GParamSpec }
pub const GParamSpecParam = _GParamSpecParam
pub const _GParamSpecGType = struct { parent_instance: GParamSpec, is_a_type: GType }
pub const GParamSpecGType = _GParamSpecGType
pub const _GParamSpecVariant = struct { parent_instance: GParamSpec, type_: *gvarianttype.GVariantType, default_value: *gvariant.GVariant, padding: [4]gpointer }
pub const GParamSpecVariant = _GParamSpecVariant

pub extern("c") fn g_param_spec_ref(pspec: *GParamSpec) -> *GParamSpec
pub extern("c") fn g_param_spec_unref(pspec: *GParamSpec) -> void
pub extern("c") fn g_param_spec_sink(pspec: *GParamSpec) -> void
pub extern("c") fn g_param_spec_ref_sink(pspec: *GParamSpec) -> *GParamSpec
pub extern("c") fn g_param_spec_get_qdata(pspec: *GParamSpec, quark: GQuark) -> gpointer
pub extern("c") fn g_param_spec_set_qdata(pspec: *GParamSpec, quark: GQuark, data: gpointer) -> void
pub extern("c") fn g_param_spec_steal_qdata(pspec: *GParamSpec, quark: GQuark) -> gpointer
pub extern("c") fn g_param_spec_get_redirect_target(pspec: *GParamSpec) -> ?*GParamSpec
pub extern("c") fn g_param_spec_get_name(pspec: *GParamSpec) -> [*]const gchar
pub extern("c") fn g_param_spec_get_nick(pspec: *GParamSpec) -> [*]const gchar
pub extern("c") fn g_param_spec_get_blurb(pspec: *GParamSpec) -> ?[*]const gchar
pub extern("c") fn g_param_spec_get_name_quark(pspec: *GParamSpec) -> GQuark
pub extern("c") fn g_param_spec_get_default_value(pspec: *GParamSpec) -> *const GValue
pub extern("c") fn g_param_spec_is_valid_name(name: [*]const gchar) -> gboolean
pub extern("c") fn g_param_spec_internal(param_type: GType, name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, flags: GParamFlags) -> gpointer
pub extern("c") fn g_param_value_set_default(pspec: *GParamSpec, value: *GValue) -> void
pub extern("c") fn g_param_value_defaults(pspec: *GParamSpec, value: *const GValue) -> gboolean
pub extern("c") fn g_param_value_validate(pspec: *GParamSpec, value: *GValue) -> gboolean
pub extern("c") fn g_param_value_is_valid(pspec: *GParamSpec, value: *const GValue) -> gboolean
pub extern("c") fn g_param_value_convert(pspec: *GParamSpec, src_value: *const GValue, dest_value: *GValue, strict_validation: gboolean) -> gboolean
pub extern("c") fn g_param_values_cmp(pspec: *GParamSpec, value1: *const GValue, value2: *const GValue) -> gint
pub extern("c") fn g_value_set_param(value: *GValue, param: ?*GParamSpec) -> void
pub extern("c") fn g_value_get_param(value: *const GValue) -> ?*GParamSpec
pub extern("c") fn g_value_dup_param(value: *const GValue) -> ?*GParamSpec
pub extern("c") fn g_value_take_param(value: *GValue, param: ?*GParamSpec) -> void

pub extern("c") fn g_param_spec_char(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: gint8, maximum: gint8, default_value: gint8, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_uchar(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: guint8, maximum: guint8, default_value: guint8, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_boolean(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, default_value: gboolean, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_int(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: gint, maximum: gint, default_value: gint, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_uint(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: guint, maximum: guint, default_value: guint, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_long(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: glong, maximum: glong, default_value: glong, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_ulong(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: gulong, maximum: gulong, default_value: gulong, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_int64(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: gint64, maximum: gint64, default_value: gint64, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_uint64(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: guint64, maximum: guint64, default_value: guint64, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_enum(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, enum_type: GType, default_value: gint, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_flags(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, flags_type: GType, default_value: guint, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_float(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: gfloat, maximum: gfloat, default_value: gfloat, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_double(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, minimum: gdouble, maximum: gdouble, default_value: gdouble, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_string(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, default_value: ?[*]const gchar, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_param(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, param_type: GType, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_boxed(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, boxed_type: GType, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_pointer(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_object(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, object_type: GType, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_gtype(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, is_a_type: GType, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_variant(name: [*]const gchar, nick: ?[*]const gchar, blurb: ?[*]const gchar, type_: *const gvarianttype.GVariantType, default_value: ?*gvariant.GVariant, flags: GParamFlags) -> *GParamSpec
pub extern("c") fn g_param_spec_override(name: [*]const gchar, overridden: *GParamSpec) -> *GParamSpec

// The types of the parameter specifications ("GParamInt" and the rest).
pub extern("c") fn g_param_spec_type_of(index_: guint) -> GType

pub const G_TYPE_PARAM_CHAR: GType = g_param_spec_type_of(0)
pub const G_TYPE_PARAM_UCHAR: GType = g_param_spec_type_of(1)
pub const G_TYPE_PARAM_BOOLEAN: GType = g_param_spec_type_of(2)
pub const G_TYPE_PARAM_INT: GType = g_param_spec_type_of(3)
pub const G_TYPE_PARAM_UINT: GType = g_param_spec_type_of(4)
pub const G_TYPE_PARAM_LONG: GType = g_param_spec_type_of(5)
pub const G_TYPE_PARAM_ULONG: GType = g_param_spec_type_of(6)
pub const G_TYPE_PARAM_INT64: GType = g_param_spec_type_of(7)
pub const G_TYPE_PARAM_UINT64: GType = g_param_spec_type_of(8)
pub const G_TYPE_PARAM_UNICHAR: GType = g_param_spec_type_of(9)
pub const G_TYPE_PARAM_ENUM: GType = g_param_spec_type_of(10)
pub const G_TYPE_PARAM_FLAGS: GType = g_param_spec_type_of(11)
pub const G_TYPE_PARAM_FLOAT: GType = g_param_spec_type_of(12)
pub const G_TYPE_PARAM_DOUBLE: GType = g_param_spec_type_of(13)
pub const G_TYPE_PARAM_STRING: GType = g_param_spec_type_of(14)
pub const G_TYPE_PARAM_PARAM: GType = g_param_spec_type_of(15)
pub const G_TYPE_PARAM_BOXED: GType = g_param_spec_type_of(16)
pub const G_TYPE_PARAM_POINTER: GType = g_param_spec_type_of(17)
pub const G_TYPE_PARAM_VALUE_ARRAY: GType = g_param_spec_type_of(18)
pub const G_TYPE_PARAM_OBJECT: GType = g_param_spec_type_of(19)
pub const G_TYPE_PARAM_OVERRIDE: GType = g_param_spec_type_of(20)
pub const G_TYPE_PARAM_GTYPE: GType = g_param_spec_type_of(21)
pub const G_TYPE_PARAM_VARIANT: GType = g_param_spec_type_of(22)

pub fn G_TYPE_IS_PARAM(type_: GType) -> bool { return gtype.G_TYPE_FUNDAMENTAL(type_) == gtype.G_TYPE_PARAM }
pub fn G_PARAM_SPEC(pspec: anytype) -> *GParamSpec { return gtype.G_TYPE_CHECK_INSTANCE_CAST(pspec, gtype.G_TYPE_PARAM, GParamSpec) }
pub fn G_IS_PARAM_SPEC(pspec: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_FUNDAMENTAL_TYPE(pspec, gtype.G_TYPE_PARAM) }
pub fn G_PARAM_SPEC_CLASS(pclass: anytype) -> *GParamSpecClass { return gtype.G_TYPE_CHECK_CLASS_CAST(pclass, gtype.G_TYPE_PARAM, GParamSpecClass) }
pub fn G_PARAM_SPEC_GET_CLASS(pspec: anytype) -> *GParamSpecClass { return gtype.G_TYPE_INSTANCE_GET_CLASS(pspec, gtype.G_TYPE_PARAM, GParamSpecClass) }
pub fn G_PARAM_SPEC_TYPE(pspec: anytype) -> GType { return gtype.G_TYPE_FROM_INSTANCE(pspec) }
pub fn G_PARAM_SPEC_TYPE_NAME(pspec: anytype) -> [*]const gchar { return gtype.g_type_name(G_PARAM_SPEC_TYPE(pspec)) }
pub fn G_PARAM_SPEC_VALUE_TYPE(pspec: anytype) -> GType { return G_PARAM_SPEC(pspec).*.value_type }
pub fn G_VALUE_HOLDS_PARAM(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_PARAM) }
pub fn G_PARAM_SPEC_INT(pspec: anytype) -> *GParamSpecInt { return gtype.G_TYPE_CHECK_INSTANCE_CAST(pspec, G_TYPE_PARAM_INT, GParamSpecInt) }
pub fn G_PARAM_SPEC_UINT(pspec: anytype) -> *GParamSpecUInt { return gtype.G_TYPE_CHECK_INSTANCE_CAST(pspec, G_TYPE_PARAM_UINT, GParamSpecUInt) }
pub fn G_PARAM_SPEC_BOOLEAN(pspec: anytype) -> *GParamSpecBoolean { return gtype.G_TYPE_CHECK_INSTANCE_CAST(pspec, G_TYPE_PARAM_BOOLEAN, GParamSpecBoolean) }
pub fn G_PARAM_SPEC_STRING(pspec: anytype) -> *GParamSpecString { return gtype.G_TYPE_CHECK_INSTANCE_CAST(pspec, G_TYPE_PARAM_STRING, GParamSpecString) }
pub fn G_PARAM_SPEC_DOUBLE(pspec: anytype) -> *GParamSpecDouble { return gtype.G_TYPE_CHECK_INSTANCE_CAST(pspec, G_TYPE_PARAM_DOUBLE, GParamSpecDouble) }
pub fn G_IS_PARAM_SPEC_INT(pspec: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(pspec, G_TYPE_PARAM_INT) }
pub fn G_IS_PARAM_SPEC_STRING(pspec: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(pspec, G_TYPE_PARAM_STRING) }
pub fn G_IS_PARAM_SPEC_BOOLEAN(pspec: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(pspec, G_TYPE_PARAM_BOOLEAN) }
pub fn G_IS_PARAM_SPEC_OBJECT(pspec: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(pspec, G_TYPE_PARAM_OBJECT) }
