// glib/gbytes.h
// mlx-glib: immutable counted runs of bytes.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gconstpointer = gtypes.gconstpointer
const gpointer = gtypes.gpointer
const gsize = gtypes.gsize

pub const _GBytes = struct {}
pub const GBytes = _GBytes

pub extern("c") fn g_bytes_new(data: gconstpointer, size: gsize) -> *GBytes
pub extern("c") fn g_bytes_new_take(data: gpointer, size: gsize) -> *GBytes
pub extern("c") fn g_bytes_new_static(data: gconstpointer, size: gsize) -> *GBytes
pub extern("c") fn g_bytes_new_with_free_func(data: gconstpointer, size: gsize, free_func: gtypes.GDestroyNotify, user_data: gpointer) -> *GBytes
pub extern("c") fn g_bytes_new_from_bytes(bytes: *GBytes, offset: gsize, length: gsize) -> *GBytes
pub extern("c") fn g_bytes_get_data(bytes: *GBytes, size: ?*gsize) -> gconstpointer
pub extern("c") fn g_bytes_get_size(bytes: *GBytes) -> gsize
pub extern("c") fn g_bytes_ref(bytes: *GBytes) -> *GBytes
pub extern("c") fn g_bytes_unref(bytes: ?*GBytes) -> void
pub extern("c") fn g_bytes_unref_to_data(bytes: *GBytes, size: *gsize) -> gpointer
pub extern("c") fn g_bytes_hash(bytes: gconstpointer) -> gtypes.guint
pub extern("c") fn g_bytes_equal(bytes1: gconstpointer, bytes2: gconstpointer) -> gtypes.gboolean
pub extern("c") fn g_bytes_compare(bytes1: gconstpointer, bytes2: gconstpointer) -> gtypes.gint
pub extern("c") fn g_bytes_get_region(bytes: *GBytes, element_size: gsize, offset: gsize, n_elements: gsize) -> gconstpointer
