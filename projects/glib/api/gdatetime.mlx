// glib/gdatetime.h
// mlx-glib: points in time on the proleptic Gregorian calendar, in UTC
// or at a fixed offset (the local time is UTC's unless TZ names a fixed
// offset such as "UTC+02:00"; time zone rules are mlx-unicode's part).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gint = gtypes.gint
const gint64 = gtypes.gint64
const gdouble = gtypes.gdouble
const gboolean = gtypes.gboolean
const gchar = gtypes.gchar

pub const _GDateTime = struct {}
pub const GDateTime = _GDateTime
pub const _GTimeZone = struct {}
pub const GTimeZone = _GTimeZone

pub const GTimeSpan = gint64

pub const G_TIME_SPAN_DAY: gint64 = @intCast(gint64, 86400000000)
pub const G_TIME_SPAN_HOUR: gint64 = @intCast(gint64, 3600000000)
pub const G_TIME_SPAN_MINUTE: gint64 = @intCast(gint64, 60000000)
pub const G_TIME_SPAN_SECOND: gint64 = @intCast(gint64, 1000000)
pub const G_TIME_SPAN_MILLISECOND: gint64 = @intCast(gint64, 1000)

pub extern("c") fn g_time_zone_new_utc() -> *GTimeZone
pub extern("c") fn g_time_zone_new_local() -> *GTimeZone
pub extern("c") fn g_time_zone_new_offset(seconds: gtypes.gint32) -> *GTimeZone
pub extern("c") fn g_time_zone_new_identifier(identifier: ?[*]const gchar) -> ?*GTimeZone
pub extern("c") fn g_time_zone_ref(tz: *GTimeZone) -> *GTimeZone
pub extern("c") fn g_time_zone_unref(tz: *GTimeZone) -> void
pub extern("c") fn g_time_zone_get_identifier(tz: *GTimeZone) -> [*]const gchar

pub extern("c") fn g_date_time_unref(datetime: *GDateTime) -> void
pub extern("c") fn g_date_time_ref(datetime: *GDateTime) -> *GDateTime
pub extern("c") fn g_date_time_new_now(tz: *GTimeZone) -> ?*GDateTime
pub extern("c") fn g_date_time_new_now_local() -> ?*GDateTime
pub extern("c") fn g_date_time_new_now_utc() -> ?*GDateTime
pub extern("c") fn g_date_time_new_from_unix_local(t: gint64) -> ?*GDateTime
pub extern("c") fn g_date_time_new_from_unix_utc(t: gint64) -> ?*GDateTime
pub extern("c") fn g_date_time_new_from_unix_local_usec(usecs: gint64) -> ?*GDateTime
pub extern("c") fn g_date_time_new_from_unix_utc_usec(usecs: gint64) -> ?*GDateTime
pub extern("c") fn g_date_time_new(tz: *GTimeZone, year: gint, month: gint, day: gint, hour: gint, minute: gint, seconds: gdouble) -> ?*GDateTime
pub extern("c") fn g_date_time_new_utc(year: gint, month: gint, day: gint, hour: gint, minute: gint, seconds: gdouble) -> ?*GDateTime
pub extern("c") fn g_date_time_new_local(year: gint, month: gint, day: gint, hour: gint, minute: gint, seconds: gdouble) -> ?*GDateTime
pub extern("c") fn g_date_time_add(datetime: *GDateTime, timespan: GTimeSpan) -> ?*GDateTime
pub extern("c") fn g_date_time_add_seconds(datetime: *GDateTime, seconds: gdouble) -> ?*GDateTime
pub extern("c") fn g_date_time_difference(end: *GDateTime, begin: *GDateTime) -> GTimeSpan
pub extern("c") fn g_date_time_compare(dt1: gtypes.gconstpointer, dt2: gtypes.gconstpointer) -> gint
pub extern("c") fn g_date_time_equal(dt1: gtypes.gconstpointer, dt2: gtypes.gconstpointer) -> gboolean
pub extern("c") fn g_date_time_hash(datetime: gtypes.gconstpointer) -> gtypes.guint
pub extern("c") fn g_date_time_to_unix(datetime: *GDateTime) -> gint64
pub extern("c") fn g_date_time_to_unix_usec(datetime: *GDateTime) -> gint64
pub extern("c") fn g_date_time_to_utc(datetime: *GDateTime) -> ?*GDateTime
pub extern("c") fn g_date_time_to_local(datetime: *GDateTime) -> ?*GDateTime
pub extern("c") fn g_date_time_get_utc_offset(datetime: *GDateTime) -> GTimeSpan
pub extern("c") fn g_date_time_get_year(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_month(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_day_of_month(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_day_of_week(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_day_of_year(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_hour(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_minute(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_second(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_microsecond(datetime: *GDateTime) -> gint
pub extern("c") fn g_date_time_get_seconds(datetime: *GDateTime) -> gdouble
pub extern("c") fn g_date_time_format_iso8601(datetime: *GDateTime) -> [*]gchar
