// libmlxglib.so: GLib, GObject and GIO for C and C++ programs, in Mlx,
// with GLib's C API (2.80, declared by the modules of api/, whose C
// headers mlx-cheaders makes), first what WebKit's base library (WTF)
// asks of them for the WPE port.
//
//     ./mlx build glib
//
// The parts: memory.mlx, sys.mlx and varargs.mlx (what the others stand
// on), alloc.mlx (gmem.h), threads.mlx (gthread.h, gatomic.h),
// errors.mlx (gquark.h, gerror.h), messages.mlx (gmessages.h), utils.mlx
// (gutils.h, the environment), strings.mlx (gstrfuncs.h, gstring.h,
// UTF-8, Base64), lists.mlx (glist.h, gslist.h), hash.mlx (ghash.h),
// arrays.mlx (garray.h, gbytes.h), files.mlx (gfileutils.h, gstdio.h,
// gdir.h, gmappedfile.h, file names, host names), checksum.mlx
// (gchecksum.h), misc.mlx (gpattern.h, gtimer.h, gkeyfile.h, gshell.h),
// main.mlx (gmain.h, gmain-unix: the main loop and its sources),
// variant.mlx (gvariant.h, gvarianttype.h), uri.mlx (guri.h),
// datetime.mlx (gdatetime.h, gtimezone.h); GObject:
// types.mlx (gtype.h), values.mlx (gvalue.h, gboxed.h, genums.h,
// gvaluearray.h), params.mlx (gparam.h), closures.mlx (gclosure.h),
// signals.mlx (gsignal.h), objects.mlx (gobject.h).
const alloc = @import("./alloc.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const utils = @import("./utils.mlx")
const strings = @import("./strings.mlx")
const lists = @import("./lists.mlx")
const hash = @import("./hash.mlx")
const arrays = @import("./arrays.mlx")
const files = @import("./files.mlx")
const checksum = @import("./checksum.mlx")
const misc = @import("./misc.mlx")
const main = @import("./main.mlx")
const variant = @import("./variant.mlx")
const uri = @import("./uri.mlx")
const datetime = @import("./datetime.mlx")
const types = @import("./types.mlx")
const values = @import("./values.mlx")
const params = @import("./params.mlx")
const closures = @import("./closures.mlx")
const signals = @import("./signals.mlx")
const objects = @import("./objects.mlx")
