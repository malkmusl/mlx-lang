// Checksums (gchecksum.h): MD5 here, SHA-1 and the SHA-2 family from
// the standard library (std.sha1, std.sha2; SHA-384 is SHA-512 from its
// own initial state, cut to 48 bytes). A GChecksum: its type, its
// hashing state, its digest as text once it is asked for.
const m = @import("./memory.mlx")
const sha1 = @import("std.sha1")
const sha2 = @import("std.sha2")

const MD5: i32 = 0
const SHA1: i32 = 1
const SHA256: i32 = 2
const SHA512: i32 = 3
const SHA384: i32 = 4

const C_TYPE: usize = 0
const C_STATE: usize = 8
const C_TEXT: usize = 16
const C_DIGEST: usize = 24
const C_SIZE: usize = 32
const STATE_SIZE: usize = 512

fn digestLength(t: i32) -> usize {
    if t == MD5 { return 16 }
    if t == SHA1 { return 20 }
    if t == SHA256 { return 32 }
    if t == SHA512 { return 64 }
    if t == SHA384 { return 48 }
    return 0
}

// ---------------------------------------------------------------------------
// MD5 (RFC 1321): the state (four words), the block, its fill, the total.

const MD5_A: usize = 0
const MD5_BLOCK: usize = 16
const MD5_FILLED: usize = 80
const MD5_TOTAL: usize = 88

fn md5Init(s: usize) -> void {
    m.put32(s, 0x67452301)
    m.put32(s + 4, 0xefcdab89)
    m.put32(s + 8, 0x98badcfe)
    m.put32(s + 12, 0x10325476)
    m.putWord(s + MD5_FILLED, 0)
    m.put64(s + MD5_TOTAL, 0)
}

fn rotl(x: u32, c: u32) -> u32 { return (x << @intCast(u5, c)) | (x >> @intCast(u5, (32 - c) & 31)) }

fn md5Block(s: usize, block: usize) -> void {
    const shifts = [64]u32{ 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21 }
    const constants = [64]u32{ 0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391 }
    var a = m.get32(s)
    var b = m.get32(s + 4)
    var c = m.get32(s + 8)
    var d = m.get32(s + 12)
    var i: usize = 0
    while i < 64 {
        var f: u32 = 0
        var g: usize = 0
        if i < 16 {
            f = (b & c) | (~b & d)
            g = i
        } else if i < 32 {
            f = (d & b) | (~d & c)
            g = (5 * i + 1) % 16
        } else if i < 48 {
            f = b ^ c ^ d
            g = (3 * i + 5) % 16
        } else {
            f = c ^ (b | ~d)
            g = (7 * i) % 16
        }
        const word = m.get32(block + g * 4)
        const sum = a +% f +% constants[i] +% word
        a = d
        d = c
        c = b
        b = b +% rotl(sum, shifts[i])
        i += 1
    }
    m.put32(s, m.get32(s) +% a)
    m.put32(s + 4, m.get32(s + 4) +% b)
    m.put32(s + 8, m.get32(s + 8) +% c)
    m.put32(s + 12, m.get32(s + 12) +% d)
}

fn md5Update(s: usize, data: usize, length: usize) -> void {
    var at: usize = 0
    m.put64(s + MD5_TOTAL, m.get64(s + MD5_TOTAL) + @intCast(u64, length))
    while at < length {
        const filled = m.getWord(s + MD5_FILLED)
        m.put8(s + MD5_BLOCK + filled, m.get8(data + at))
        at += 1
        if filled + 1 == 64 {
            md5Block(s, s + MD5_BLOCK)
            m.putWord(s + MD5_FILLED, 0)
        } else {
            m.putWord(s + MD5_FILLED, filled + 1)
        }
    }
}

fn md5Final(s: usize, digest: usize) -> void {
    const bits = m.get64(s + MD5_TOTAL) * 8
    var padding: u64 = 0x80
    md5Update(s, @intFromPtr(&padding), 1)
    var zero: u64 = 0
    while m.getWord(s + MD5_FILLED) != 56 { md5Update(s, @intFromPtr(&zero), 1) }
    var length = bits
    md5Update(s, @intFromPtr(&length), 8)
    m.copy(digest, s, 16)
}

// ---------------------------------------------------------------------------

fn sha256State(s: usize) -> *sha2.Sha256 { unsafe { return @ptrFromInt(*sha2.Sha256, s) } }
fn sha512State(s: usize) -> *sha2.Sha512 { unsafe { return @ptrFromInt(*sha2.Sha512, s) } }
fn sha1State(s: usize) -> *sha1.Sha1 { unsafe { return @ptrFromInt(*sha1.Sha1, s) } }

fn reset(c: usize) -> void {
    const t = m.getI32(c + C_TYPE)
    const s = m.getWord(c + C_STATE)
    m.zero(s, STATE_SIZE)
    if t == MD5 { md5Init(s) }
    if t == SHA1 { sha1.sha1Init(sha1State(s)) }
    if t == SHA256 { sha2.sha256Init(sha256State(s)) }
    if t == SHA512 || t == SHA384 { sha2.sha512Init(sha512State(s)) }
    if t == SHA384 {
        const initial = [8]u64{ 0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939, 0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4 }
        var index: usize = 0
        while index < 8 {
            sha512State(s).*.state[index] = initial[index]
            index += 1
        }
    }
    m.release(m.getWord(c + C_TEXT))
    m.putWord(c + C_TEXT, 0)
}

pub fn newChecksum(t: i32) -> usize {
    if digestLength(t) == 0 { return 0 }
    const c = m.alloc(C_SIZE)
    m.putI32(c + C_TYPE, t)
    m.putWord(c + C_STATE, m.alloc(STATE_SIZE))
    m.putWord(c + C_DIGEST, m.alloc(64))
    reset(c)
    return c
}

pub fn update(c: usize, data: usize, length: usize) -> void {
    if m.getWord(c + C_TEXT) != 0 { return }
    const t = m.getI32(c + C_TYPE)
    const s = m.getWord(c + C_STATE)
    if t == MD5 { md5Update(s, data, length) }
    if t == SHA1 { sha1.sha1Update(sha1State(s), m.bytes(data, length)) }
    if t == SHA256 { sha2.sha256Update(sha256State(s), m.bytes(data, length)) }
    if t == SHA512 || t == SHA384 { sha2.sha512Update(sha512State(s), m.bytes(data, length)) }
}

// The digest finished (once) and its text.
fn finish(c: usize) -> usize {
    if m.getWord(c + C_TEXT) != 0 { return m.getWord(c + C_TEXT) }
    const t = m.getI32(c + C_TYPE)
    const s = m.getWord(c + C_STATE)
    const digest = m.getWord(c + C_DIGEST)
    if t == MD5 { md5Final(s, digest) }
    if t == SHA1 {
        unsafe { sha1.sha1Final(sha1State(s), @ptrFromInt(*[20]u8, digest)) }
    }
    if t == SHA256 {
        unsafe { sha2.sha256Final(sha256State(s), @ptrFromInt(*[32]u8, digest)) }
    }
    if t == SHA512 || t == SHA384 {
        unsafe { sha2.sha512Final(sha512State(s), @ptrFromInt(*[64]u8, digest)) }
    }
    var text = m.text()
    var index: usize = 0
    while index < digestLength(t) {
        m.pushHex(&text, m.get8(digest + index))
        index += 1
    }
    m.putWord(c + C_TEXT, m.finish(&text))
    return m.getWord(c + C_TEXT)
}

pub fn freeChecksum(c: usize) -> void {
    m.release(m.getWord(c + C_STATE))
    m.release(m.getWord(c + C_TEXT))
    m.release(m.getWord(c + C_DIGEST))
    m.release(c)
}

// The text of the checksum of `length` bytes at `data`.
pub fn compute(t: i32, data: usize, length: usize) -> usize {
    const c = newChecksum(t)
    if c == 0 { return 0 }
    update(c, data, length)
    const text = m.dup(finish(c))
    freeChecksum(c)
    return text
}

export fn g_checksum_type_get_length(checksum_type: i32) -> i64 {
    const length = digestLength(checksum_type)
    return if length == 0 { -1 } else { @intCast(i64, length) }
}

export fn g_checksum_new(checksum_type: i32) -> usize { return newChecksum(checksum_type) }
export fn g_checksum_reset(c: usize) -> void { reset(c) }

export fn g_checksum_copy(c: usize) -> usize {
    const copied = newChecksum(m.getI32(c + C_TYPE))
    m.copy(m.getWord(copied + C_STATE), m.getWord(c + C_STATE), STATE_SIZE)
    m.copy(m.getWord(copied + C_DIGEST), m.getWord(c + C_DIGEST), 64)
    if m.getWord(c + C_TEXT) != 0 { m.putWord(copied + C_TEXT, m.dup(m.getWord(c + C_TEXT))) }
    return copied
}

export fn g_checksum_free(c: usize) -> void { freeChecksum(c) }

export fn g_checksum_update(c: usize, data: usize, length: i64) -> void { update(c, data, if length < 0 { m.cLength(data) } else { @intCast(usize, length) }) }

export fn g_checksum_get_string(c: usize) -> usize { return finish(c) }

export fn g_checksum_get_digest(c: usize, buffer: usize, digest_len: usize) -> void {
    _ = finish(c)
    const length = digestLength(m.getI32(c + C_TYPE))
    if m.getWord(digest_len) < length { return }
    m.copy(buffer, m.getWord(c + C_DIGEST), length)
    m.putWord(digest_len, length)
}

export fn g_compute_checksum_for_data(checksum_type: i32, data: usize, length: usize) -> usize { return compute(checksum_type, data, length) }
export fn g_compute_checksum_for_string(checksum_type: i32, text: usize, length: i64) -> usize { return compute(checksum_type, text, if length < 0 { m.cLength(text) } else { @intCast(usize, length) }) }

export fn g_compute_checksum_for_bytes(checksum_type: i32, data: usize) -> usize {
    return compute(checksum_type, m.getWord(data), m.getWord(data + 8))
}
