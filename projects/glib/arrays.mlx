// Arrays that grow (garray.h) and GBytes (gbytes.h). A GArray (and a
// GByteArray, an array of bytes) is its public words (data, length)
// then the room allocated, the element size, whether it is kept
// NUL-ended and cleared, its references and the function clearing an
// element; a GPtrArray its (pdata, length), the room, the references,
// the function freeing an element and whether it is kept NULL-ended.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")

pub const Notify = fn(usize) -> void
pub const Compare = fn(usize, usize) -> i32
pub const Func = fn(usize, usize) -> void
pub const Copy = fn(usize, usize) -> usize
pub const Equal = fn(usize, usize) -> i32

const DATA: usize = 0
const LEN: usize = 8
const ROOM: usize = 16
const ELEMENT: usize = 24
const ZERO_TERMINATED: usize = 28
const CLEAR: usize = 32
const REFS: usize = 36
const CLEAR_FUNC: usize = 40
const ARRAY_SIZE: usize = 48

fn element(a: usize) -> usize { return @intCast(usize, m.get32(a + ELEMENT)) }
fn length(a: usize) -> usize { return @intCast(usize, m.get32(a + LEN)) }

// Room for `needed` elements (and the terminating one).
fn arrayReserve(a: usize, needed: usize) -> void {
    const total = needed + (if m.get32(a + ZERO_TERMINATED) != 0 { 1 } else { 0 })
    var room = m.getWord(a + ROOM)
    if total <= room && m.getWord(a + DATA) != 0 { return }
    if room < 16 { room = 16 }
    while room < total { room = room * 2 }
    const old = m.getWord(a + ROOM)
    const data = m.grow(m.getWord(a + DATA), room * element(a))
    m.zero(data + old * element(a), (room - old) * element(a))
    m.putWord(a + DATA, data)
    m.putWord(a + ROOM, room)
}

fn terminate(a: usize) -> void {
    if m.get32(a + ZERO_TERMINATED) != 0 { m.zero(m.getWord(a + DATA) + length(a) * element(a), element(a)) }
}

pub fn newArray(zero_terminated: bool, clear_: bool, element_size: u32, reserved: u32) -> usize {
    const a = m.alloc(ARRAY_SIZE)
    m.put32(a + ELEMENT, element_size)
    m.put32(a + ZERO_TERMINATED, if zero_terminated { 1 } else { 0 })
    m.put32(a + CLEAR, if clear_ { 1 } else { 0 })
    m.put32(a + REFS, 1)
    arrayReserve(a, @intCast(usize, reserved))
    terminate(a)
    return a
}

fn clearElements(a: usize, from: usize, count: usize) -> void {
    const f = m.getWord(a + CLEAR_FUNC)
    if f == 0 { return }
    const call: Notify = unsafe { @ptrFromInt(Notify, f) }
    var index: usize = 0
    while index < count {
        call(m.getWord(a + DATA) + (from + index) * element(a))
        index += 1
    }
}

// Frees the array; its data when `freeSegment` (else returned).
fn arrayFree(a: usize, freeSegment: bool) -> usize {
    const data = m.getWord(a + DATA)
    if freeSegment {
        clearElements(a, 0, length(a))
        m.release(data)
        m.release(a)
        return 0
    }
    m.release(a)
    return data
}

pub fn arrayInsert(a: usize, index: usize, data: usize, count: usize) -> void {
    const size = element(a)
    const current = length(a)
    arrayReserve(a, current + count)
    const base = m.getWord(a + DATA)
    m.copy(base + (index + count) * size, base + index * size, (current - index) * size)
    if data != 0 { m.copy(base + index * size, data, count * size) } else { m.zero(base + index * size, count * size) }
    m.put32(a + LEN, @intCast(u32, current + count))
    terminate(a)
}

export fn g_array_new(zero_terminated: i32, clear_: i32, element_size: u32) -> usize { return newArray(zero_terminated != 0, clear_ != 0, element_size, 0) }
export fn g_array_sized_new(zero_terminated: i32, clear_: i32, element_size: u32, reserved_size: u32) -> usize { return newArray(zero_terminated != 0, clear_ != 0, element_size, reserved_size) }

export fn g_array_copy(a: usize) -> usize {
    const copied = newArray(m.get32(a + ZERO_TERMINATED) != 0, m.get32(a + CLEAR) != 0, m.get32(a + ELEMENT), m.get32(a + LEN))
    arrayInsert(copied, 0, m.getWord(a + DATA), length(a))
    m.putWord(copied + CLEAR_FUNC, m.getWord(a + CLEAR_FUNC))
    return copied
}

export fn g_array_free(a: usize, free_segment: i32) -> usize { return arrayFree(a, free_segment != 0) }

export fn g_array_steal(a: usize, len: usize) -> usize {
    const data = m.getWord(a + DATA)
    if len != 0 { m.putWord(len, length(a)) }
    m.putWord(a + DATA, 0)
    m.putWord(a + ROOM, 0)
    m.put32(a + LEN, 0)
    arrayReserve(a, 0)
    terminate(a)
    return data
}

export fn g_array_ref(a: usize) -> usize {
    threads.refInc(a + REFS)
    return a
}

export fn g_array_unref(a: usize) -> void {
    if threads.refDec(a + REFS) { _ = arrayFree(a, true) }
}

export fn g_array_get_element_size(a: usize) -> u32 { return m.get32(a + ELEMENT) }
export fn g_array_set_clear_func(a: usize, clear_func: usize) -> void { m.putWord(a + CLEAR_FUNC, clear_func) }

export fn g_array_append_vals(a: usize, data: usize, len: u32) -> usize {
    arrayInsert(a, length(a), data, @intCast(usize, len))
    return a
}

export fn g_array_prepend_vals(a: usize, data: usize, len: u32) -> usize {
    arrayInsert(a, 0, data, @intCast(usize, len))
    return a
}

export fn g_array_insert_vals(a: usize, index_: u32, data: usize, len: u32) -> usize {
    const at = @intCast(usize, index_)
    if at > length(a) {
        // (Past the end: the gap is zeroed.)
        arrayInsert(a, length(a), 0, at - length(a))
    }
    arrayInsert(a, at, data, @intCast(usize, len))
    return a
}

export fn g_array_set_size(a: usize, len: u32) -> usize {
    const wanted = @intCast(usize, len)
    if wanted > length(a) {
        arrayReserve(a, wanted)
        m.zero(m.getWord(a + DATA) + length(a) * element(a), (wanted - length(a)) * element(a))
    } else {
        clearElements(a, wanted, length(a) - wanted)
    }
    m.put32(a + LEN, len)
    terminate(a)
    return a
}

export fn g_array_remove_range(a: usize, index_: u32, len: u32) -> usize {
    const at = @intCast(usize, index_)
    const count = @intCast(usize, len)
    clearElements(a, at, count)
    const size = element(a)
    const base = m.getWord(a + DATA)
    m.copy(base + at * size, base + (at + count) * size, (length(a) - at - count) * size)
    m.put32(a + LEN, @intCast(u32, length(a) - count))
    terminate(a)
    return a
}

export fn g_array_remove_index(a: usize, index_: u32) -> usize { return g_array_remove_range(a, index_, 1) }

export fn g_array_remove_index_fast(a: usize, index_: u32) -> usize {
    const at = @intCast(usize, index_)
    clearElements(a, at, 1)
    const size = element(a)
    const last = length(a) - 1
    if at != last { m.copy(m.getWord(a + DATA) + at * size, m.getWord(a + DATA) + last * size, size) }
    m.put32(a + LEN, @intCast(u32, last))
    terminate(a)
    return a
}

// An insertion sort of `count` elements of `size` at `base` (stable, as
// GLib's g_array_sort is in practice).
fn sortElements(base: usize, count: usize, size: usize, compare: usize) -> void {
    const call: Compare = unsafe { @ptrFromInt(Compare, compare) }
    const held = m.raw(size)
    var index: usize = 1
    while index < count {
        m.copy(held, base + index * size, size)
        var at = index
        while at > 0 && call(base + (at - 1) * size, held) > 0 {
            m.copy(base + at * size, base + (at - 1) * size, size)
            at -= 1
        }
        m.copy(base + at * size, held, size)
        index += 1
    }
    m.release(held)
}

export fn g_array_sort(a: usize, compare_func: usize) -> void { sortElements(m.getWord(a + DATA), length(a), element(a), compare_func) }

// ---------------------------------------------------------------------------
// GByteArray: a GArray of bytes.

export fn g_byte_array_new() -> usize { return newArray(false, false, 1, 0) }
export fn g_byte_array_sized_new(reserved_size: u32) -> usize { return newArray(false, false, 1, reserved_size) }

export fn g_byte_array_new_take(data: usize, len: usize) -> usize {
    const a = newArray(false, false, 1, 0)
    m.release(m.getWord(a + DATA))
    m.putWord(a + DATA, data)
    m.putWord(a + ROOM, len)
    m.put32(a + LEN, @intCast(u32, len))
    return a
}

export fn g_byte_array_free(a: usize, free_segment: i32) -> usize { return arrayFree(a, free_segment != 0) }
export fn g_byte_array_steal(a: usize, len: usize) -> usize { return g_array_steal(a, len) }
export fn g_byte_array_ref(a: usize) -> usize { return g_array_ref(a) }
export fn g_byte_array_unref(a: usize) -> void { g_array_unref(a) }
export fn g_byte_array_append(a: usize, data: usize, len: u32) -> usize { return g_array_append_vals(a, data, len) }
export fn g_byte_array_prepend(a: usize, data: usize, len: u32) -> usize { return g_array_prepend_vals(a, data, len) }
export fn g_byte_array_set_size(a: usize, len: u32) -> usize { return g_array_set_size(a, len) }
export fn g_byte_array_remove_index(a: usize, index_: u32) -> usize { return g_array_remove_index(a, index_) }
export fn g_byte_array_remove_range(a: usize, index_: u32, len: u32) -> usize { return g_array_remove_range(a, index_, len) }

export fn g_byte_array_free_to_bytes(a: usize) -> usize {
    const len = length(a)
    const data = arrayFree(a, false)
    return newBytes(data, len, @intFromPtr(__mlx_glib_free), data)
}

// ---------------------------------------------------------------------------
// GPtrArray

const P_DATA: usize = 0
const P_LEN: usize = 8
const P_ROOM: usize = 12
const P_REFS: usize = 16
const P_NULL_TERMINATED: usize = 20
const P_FREE_FUNC: usize = 24
const P_SIZE: usize = 32

fn plen(a: usize) -> usize { return @intCast(usize, m.get32(a + P_LEN)) }

fn ptrReserve(a: usize, needed: usize) -> void {
    const total = needed + (if m.get32(a + P_NULL_TERMINATED) != 0 { 1 } else { 0 })
    var room = @intCast(usize, m.get32(a + P_ROOM))
    if total <= room && m.getWord(a + P_DATA) != 0 { return }
    if room < 16 { room = 16 }
    while room < total { room = room * 2 }
    m.putWord(a + P_DATA, m.grow(m.getWord(a + P_DATA), room * 8))
    m.put32(a + P_ROOM, @intCast(u32, room))
}

fn ptrTerminate(a: usize) -> void {
    if m.get32(a + P_NULL_TERMINATED) != 0 { m.putWord(m.getWord(a + P_DATA) + plen(a) * 8, 0) }
}

pub fn newPtrArray(reserved: usize, free_func: usize, null_terminated: bool) -> usize {
    const a = m.alloc(P_SIZE)
    m.put32(a + P_REFS, 1)
    m.putWord(a + P_FREE_FUNC, free_func)
    m.put32(a + P_NULL_TERMINATED, if null_terminated { 1 } else { 0 })
    if reserved > 0 || null_terminated {
        ptrReserve(a, reserved)
        ptrTerminate(a)
    }
    return a
}

fn freeElement(a: usize, value: usize) -> void {
    const f = m.getWord(a + P_FREE_FUNC)
    if f == 0 { return }
    const call: Notify = unsafe { @ptrFromInt(Notify, f) }
    call(value)
}

pub fn ptrAdd(a: usize, value: usize) -> void {
    ptrReserve(a, plen(a) + 1)
    m.putWord(m.getWord(a + P_DATA) + plen(a) * 8, value)
    m.put32(a + P_LEN, m.get32(a + P_LEN) + 1)
    ptrTerminate(a)
}

pub fn ptrAt(a: usize, index: usize) -> usize { return m.getWord(m.getWord(a + P_DATA) + index * 8) }
pub fn ptrLength(a: usize) -> usize { return plen(a) }

fn ptrFree(a: usize, freeSegment: bool) -> usize {
    const data = m.getWord(a + P_DATA)
    if freeSegment {
        var index: usize = 0
        while index < plen(a) {
            freeElement(a, m.getWord(data + index * 8))
            index += 1
        }
        m.release(data)
        m.release(a)
        return 0
    }
    m.release(a)
    return data
}

export fn g_ptr_array_new() -> usize { return newPtrArray(0, 0, false) }
export fn g_ptr_array_new_with_free_func(element_free_func: usize) -> usize { return newPtrArray(0, element_free_func, false) }
export fn g_ptr_array_new_full(reserved_size: u32, element_free_func: usize) -> usize { return newPtrArray(@intCast(usize, reserved_size), element_free_func, false) }
export fn g_ptr_array_new_null_terminated(reserved_size: u32, element_free_func: usize, null_terminated: i32) -> usize { return newPtrArray(@intCast(usize, reserved_size), element_free_func, null_terminated != 0) }
export fn g_ptr_array_sized_new(reserved_size: u32) -> usize { return newPtrArray(@intCast(usize, reserved_size), 0, false) }

export fn g_ptr_array_copy(a: usize, func: usize, user_data: usize) -> usize {
    const copied = newPtrArray(plen(a), m.getWord(a + P_FREE_FUNC), m.get32(a + P_NULL_TERMINATED) != 0)
    var index: usize = 0
    while index < plen(a) {
        var value = ptrAt(a, index)
        if func != 0 {
            const call: Copy = unsafe { @ptrFromInt(Copy, func) }
            value = call(value, user_data)
        }
        ptrAdd(copied, value)
        index += 1
    }
    return copied
}

export fn g_ptr_array_free(a: usize, free_seg: i32) -> usize { return ptrFree(a, free_seg != 0) }

export fn g_ptr_array_steal(a: usize, len: usize) -> usize {
    const data = m.getWord(a + P_DATA)
    if len != 0 { m.putWord(len, plen(a)) }
    m.putWord(a + P_DATA, 0)
    m.put32(a + P_ROOM, 0)
    m.put32(a + P_LEN, 0)
    return data
}

export fn g_ptr_array_ref(a: usize) -> usize {
    threads.refInc(a + P_REFS)
    return a
}

export fn g_ptr_array_unref(a: usize) -> void {
    if threads.refDec(a + P_REFS) { _ = ptrFree(a, true) }
}

export fn g_ptr_array_set_free_func(a: usize, element_free_func: usize) -> void { m.putWord(a + P_FREE_FUNC, element_free_func) }

export fn g_ptr_array_set_size(a: usize, len: i32) -> void {
    const wanted = @intCast(usize, len)
    if wanted > plen(a) {
        ptrReserve(a, wanted)
        m.zero(m.getWord(a + P_DATA) + plen(a) * 8, (wanted - plen(a)) * 8)
    } else {
        var index = wanted
        while index < plen(a) {
            freeElement(a, ptrAt(a, index))
            index += 1
        }
    }
    m.put32(a + P_LEN, @intCast(u32, wanted))
    ptrTerminate(a)
}

fn ptrRemove(a: usize, index: usize, fast: bool, free: bool) -> usize {
    const data = m.getWord(a + P_DATA)
    const value = m.getWord(data + index * 8)
    const last = plen(a) - 1
    if fast {
        m.putWord(data + index * 8, m.getWord(data + last * 8))
    } else {
        m.copy(data + index * 8, data + (index + 1) * 8, (last - index) * 8)
    }
    m.put32(a + P_LEN, @intCast(u32, last))
    ptrTerminate(a)
    if free { freeElement(a, value) }
    return value
}

export fn g_ptr_array_remove_index(a: usize, index_: u32) -> usize { return ptrRemove(a, @intCast(usize, index_), false, true) }
export fn g_ptr_array_remove_index_fast(a: usize, index_: u32) -> usize { return ptrRemove(a, @intCast(usize, index_), true, true) }
export fn g_ptr_array_steal_index(a: usize, index_: u32) -> usize { return ptrRemove(a, @intCast(usize, index_), false, false) }

fn ptrIndex(a: usize, value: usize) -> isize {
    var index: usize = 0
    while index < plen(a) {
        if ptrAt(a, index) == value { return @intCast(isize, index) }
        index += 1
    }
    return -1
}

export fn g_ptr_array_remove(a: usize, value: usize) -> i32 {
    const index = ptrIndex(a, value)
    if index < 0 { return 0 }
    _ = ptrRemove(a, @intCast(usize, index), false, true)
    return 1
}

export fn g_ptr_array_remove_fast(a: usize, value: usize) -> i32 {
    const index = ptrIndex(a, value)
    if index < 0 { return 0 }
    _ = ptrRemove(a, @intCast(usize, index), true, true)
    return 1
}

export fn g_ptr_array_remove_range(a: usize, index_: u32, len: u32) -> usize {
    var k: u32 = 0
    while k < len {
        _ = ptrRemove(a, @intCast(usize, index_), false, true)
        k += 1
    }
    return a
}

export fn g_ptr_array_add(a: usize, value: usize) -> void { ptrAdd(a, value) }

export fn g_ptr_array_extend(target: usize, a: usize, func: usize, user_data: usize) -> void {
    var index: usize = 0
    const count = plen(a)
    while index < count {
        var value = ptrAt(a, index)
        if func != 0 {
            const call: Copy = unsafe { @ptrFromInt(Copy, func) }
            value = call(value, user_data)
        }
        ptrAdd(target, value)
        index += 1
    }
}

export fn g_ptr_array_insert(a: usize, index_: i32, value: usize) -> void {
    const at = if index_ < 0 { plen(a) } else { @intCast(usize, index_) }
    ptrReserve(a, plen(a) + 1)
    const data = m.getWord(a + P_DATA)
    m.copy(data + (at + 1) * 8, data + at * 8, (plen(a) - at) * 8)
    m.putWord(data + at * 8, value)
    m.put32(a + P_LEN, m.get32(a + P_LEN) + 1)
    ptrTerminate(a)
}

export fn g_ptr_array_sort(a: usize, compare_func: usize) -> void {
    if m.getWord(a + P_DATA) != 0 { sortElements(m.getWord(a + P_DATA), plen(a), 8, compare_func) }
}

export fn g_ptr_array_foreach(a: usize, func: usize, user_data: usize) -> void {
    const call: Func = unsafe { @ptrFromInt(Func, func) }
    var index: usize = 0
    while index < plen(a) {
        call(ptrAt(a, index), user_data)
        index += 1
    }
}

export fn g_ptr_array_find(a: usize, needle: usize, index_: usize) -> i32 {
    const found = ptrIndex(a, needle)
    if found < 0 { return 0 }
    if index_ != 0 { m.put32(index_, @intCast(u32, found)) }
    return 1
}

export fn g_ptr_array_find_with_equal_func(a: usize, needle: usize, equal_func: usize, index_: usize) -> i32 {
    if equal_func == 0 { return g_ptr_array_find(a, needle, index_) }
    const call: Equal = unsafe { @ptrFromInt(Equal, equal_func) }
    var index: usize = 0
    while index < plen(a) {
        if call(ptrAt(a, index), needle) != 0 {
            if index_ != 0 { m.put32(index_, @intCast(u32, index)) }
            return 1
        }
        index += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// GBytes: the data, its size, the references, the function freeing the
// data and its argument.

const B_DATA: usize = 0
const B_SIZE: usize = 8
const B_REFS: usize = 16
const B_FREE: usize = 24
const B_USER: usize = 32
const B_RECORD: usize = 40

export fn __mlx_glib_free(address: usize) -> void { m.release(address) }

export fn __mlx_glib_bytes_unref(bytes: usize) -> void { bytesUnref(bytes) }

pub fn newBytes(data: usize, size: usize, free_func: usize, user_data: usize) -> usize {
    const b = m.alloc(B_RECORD)
    m.putWord(b + B_DATA, data)
    m.putWord(b + B_SIZE, size)
    m.put32(b + B_REFS, 1)
    m.putWord(b + B_FREE, free_func)
    m.putWord(b + B_USER, user_data)
    return b
}

// A copy of `size` bytes at `data`.
pub fn bytesCopy(data: usize, size: usize) -> usize {
    const copied = m.raw(if size == 0 { 1 } else { size })
    m.copy(copied, data, size)
    return newBytes(copied, size, @intFromPtr(__mlx_glib_free), copied)
}

pub fn bytesData(b: usize) -> usize { return m.getWord(b + B_DATA) }
pub fn bytesSize(b: usize) -> usize { return m.getWord(b + B_SIZE) }

pub fn bytesRef(b: usize) -> usize {
    threads.refInc(b + B_REFS)
    return b
}

pub fn bytesUnref(b: usize) -> void {
    if b == 0 { return }
    if threads.refDec(b + B_REFS) {
        const f = m.getWord(b + B_FREE)
        if f != 0 {
            const call: Notify = unsafe { @ptrFromInt(Notify, f) }
            call(m.getWord(b + B_USER))
        }
        m.release(b)
    }
}

export fn g_bytes_new(data: usize, size: usize) -> usize { return bytesCopy(data, size) }

export fn g_bytes_new_take(data: usize, size: usize) -> usize { return newBytes(data, size, @intFromPtr(__mlx_glib_free), data) }
export fn g_bytes_new_static(data: usize, size: usize) -> usize { return newBytes(data, size, 0, 0) }
export fn g_bytes_new_with_free_func(data: usize, size: usize, free_func: usize, user_data: usize) -> usize { return newBytes(data, size, free_func, user_data) }

export fn g_bytes_new_from_bytes(bytes: usize, offset: usize, len: usize) -> usize {
    if offset == 0 && len == bytesSize(bytes) { return bytesRef(bytes) }
    return newBytes(bytesData(bytes) + offset, len, @intFromPtr(__mlx_glib_bytes_unref), bytesRef(bytes))
}

export fn g_bytes_get_data(b: usize, size: usize) -> usize {
    if size != 0 { m.putWord(size, bytesSize(b)) }
    return if bytesSize(b) == 0 { 0 } else { bytesData(b) }
}

export fn g_bytes_get_size(b: usize) -> usize { return bytesSize(b) }
export fn g_bytes_ref(b: usize) -> usize { return bytesRef(b) }
export fn g_bytes_unref(b: usize) -> void { bytesUnref(b) }

export fn g_bytes_unref_to_data(b: usize, size: usize) -> usize {
    const copied = m.raw(if bytesSize(b) == 0 { 1 } else { bytesSize(b) })
    m.copy(copied, bytesData(b), bytesSize(b))
    m.putWord(size, bytesSize(b))
    bytesUnref(b)
    return copied
}

export fn g_bytes_hash(b: usize) -> u32 {
    var h: u32 = 5381
    var index: usize = 0
    while index < bytesSize(b) {
        h = (h << 5) +% h +% @intCast(u32, m.get8(bytesData(b) + index))
        index += 1
    }
    return h
}

export fn g_bytes_compare(b1: usize, b2: usize) -> i32 {
    const s1 = bytesSize(b1)
    const s2 = bytesSize(b2)
    const n = if s1 < s2 { s1 } else { s2 }
    var index: usize = 0
    while index < n {
        const x = m.get8(bytesData(b1) + index)
        const y = m.get8(bytesData(b2) + index)
        if x != y { return if x < y { -1 } else { 1 } }
        index += 1
    }
    if s1 == s2 { return 0 }
    return if s1 < s2 { -1 } else { 1 }
}

export fn g_bytes_equal(b1: usize, b2: usize) -> i32 { return if bytesSize(b1) == bytesSize(b2) && g_bytes_compare(b1, b2) == 0 { 1 } else { 0 } }

export fn g_bytes_get_region(b: usize, element_size: usize, offset: usize, n_elements: usize) -> usize {
    if offset + element_size * n_elements > bytesSize(b) { return 0 }
    return bytesData(b) + offset
}
