// Khronos' Vulkan conformance suite (VK-GL-CTS vulkan-cts-1.3.10.0) as
// deqp-vk, built by `./mlx build cts` with this repository's own
// toolchain alone: mlx-cc compiles every C and C++ file of the suite, of
// glslang and of the port, mlx-ld links them on mlxlibc with mlxlibcpp,
// and our Vulkan driver over the host card is a library of Mlx linked in
// (README.md):
//
//     ./mlx build cts-headers   what the port's sources include that is made
//     ./mlx build libmlxcts-driver.so    mlx-out/lib/libmlxcts-driver.so
//     ./mlx build cts           mlx-out/cts/bin/deqp-vk
//
// The sources are not in the repository: tools/fetch_cts.sh fetches them
// at the commits UPSTREAM.md records into CTS_SOURCES (by default
// mlx-out/cts/sources), and they are never edited; what the port needs
// around them is port/. Without them the steps are left out. The objects
// go to mlx-out/cts/obj, what is made to mlx-out/cts/gen.
const std = @import("std")
const Build = @import("std.build")
const webkit = @import("../webkit/build.mlx")

const OBJECTS: []const u8 = "mlx-out/cts/obj/"
const GENERATED: []const u8 = "mlx-out/cts/gen/"
const PROGRAM: []const u8 = "mlx-out/cts/bin/deqp-vk"
const DRIVER: []const u8 = "libmlxcts-driver.so"

// The suite's module directories, each on the include path:
// vktTestPackage.cpp names every group's header.
const MODULE_DIRECTORIES = [50][]const u8{
    "amber", "api", "binding_model", "clipping", "compute", "conditional_rendering", "descriptor_indexing",
    "device_generated_commands", "device_group", "draw", "dynamic_state", "fragment_ops", "fragment_shader_interlock",
    "fragment_shading_barycentric", "fragment_shading_rate", "geometry", "image", "imageless_framebuffer", "memory",
    "memory_model", "mesh_shader", "modifiers", "multiview", "pipeline", "postmortem", "protected_memory", "query_pool",
    "rasterization", "ray_query", "ray_tracing", "reconvergence", "renderpass", "robustness", "sc", "shader_object",
    "shaderexecutor", "shaderrender", "sparse_resources", "spirv_assembly", "ssbo", "subgroups", "synchronization",
    "tessellation", "texture", "transform_feedback", "ubo", "util", "video", "wsi", "ycbcr",
}

// The framework's include directories, under the suite's tree.
const FRAMEWORK_DIRECTORIES = [17][]const u8{
    "framework/delibs/debase", "framework/delibs/depool", "framework/delibs/dethread", "framework/delibs/deutil",
    "framework/delibs/decpp", "framework/delibs/destream", "framework/qphelper", "framework/common", "framework/xexml",
    "framework/opengl", "framework/opengl/simplereference", "framework/opengl/wrapper", "framework/referencerenderer",
    "framework/randomshaders", "external/vulkancts/framework/vulkan", "external/vulkancts/framework/vulkan/generated/vulkan",
    "external/vulkancts/modules/vulkan",
}

// The port's own sources (port/): the platform, the groups put
// together, and what stands for the parts not built (README.md).
const PORT_SOURCES = [6][]const u8{
    "tcuMlxPlatform.cpp", "vktMlxGroups.cpp", "spirv_tools.cpp", "vktAmberAbsent.cpp", "vkShaderObjectCreate.cpp",
    "gluWithoutGL.cpp",
}

// The suite's definitions, as its CMake build gives them for a Linux
// target without X11 or Wayland (DEQP_TARGET_NAME our platform's).
const DEFINES: []const u8 = " -DDE_ASSERT_FAILURE_CALLBACK -D_XOPEN_SOURCE=600 -D_GNU_SOURCE -DDEQP_TARGET_NAME=\\\"Mlx\\\" -DCTS_USES_VULKAN -DDISABLE_SHADERCACHE_IPC -DENABLE_HLSL -DDEQP_SUPPORT_DRM=0"

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

// Where the fetched sources are (tools/fetch_cts.sh).
fn sources(b: *Build.Builder) -> []const u8 {
    const given = Build.environment(b, "CTS_SOURCES")
    if given.length > 0 { return given }
    return "mlx-out/cts/sources"
}

// A source path as the object's name: its directories joined by `_`,
// the C sources' with a `-c` (deCommandLine.c beside deCommandLine.cpp).
fn objectName(b: *Build.Builder, path: []const u8) -> []const u8 {
    var name = ""
    var start: usize = 0
    var at: usize = 0
    while at <= path.length {
        if at == path.length || path[at] == 47 {
            const part = path[start..at]
            if part.length > 0 { name = if name.length == 0 { part } else { join3(b, name, "_", part) } }
            start = at + 1
        }
        at += 1
    }
    if name.length > 2 && name[name.length - 2] == 46 && name[name.length - 1] == 99 { return Build.concat(b, name[0..name.length - 2], "-c") }
    var dot = name.length
    while dot > 0 && name[dot - 1] != 46 { dot -= 1 }
    return if dot > 0 { name[0..dot - 1] } else { name }
}

fn endsWith(text: []const u8, tail: []const u8) -> bool {
    return text.length >= tail.length && std.text.same(text[text.length - tail.length..text.length], tail)
}

// The template's placeholders, in the order of the version's fields.
const PLACEHOLDERS = [4][]const u8{ "@major@", "@minor@", "@patch@", "@flavor@" }

// glslang's build_info.h from its template and CHANGES.md (the first
// `## X.Y.Z` heading), as glslang's build_info.py makes it.
fn glslangBuildInfo(b: *Build.Builder, glslang: []const u8) -> bool {
    const changes = Build.readText(b, Build.concat(b, glslang, "/CHANGES.md"))
    const template = Build.readText(b, Build.concat(b, glslang, "/build_info.h.tmpl"))
    if changes.length == 0 || template.length == 0 { return false }
    var at: usize = 0
    var version = ""
    while at < changes.length {
        const line = Build.nextLine(changes, &at)
        if line.length > 3 && line[0] == 35 && line[1] == 35 && line[2] == 32 {
            var end: usize = 3
            while end < line.length && line[end] != 32 { end += 1 }
            version = line[3..end]
            break
        }
    }
    // MAJOR.MINOR.PATCH[-FLAVOR]
    var fields = [4][]const u8{ "", "", "", "" }
    var field: usize = 0
    var start: usize = 0
    var i: usize = 0
    while i <= version.length {
        const ends = i == version.length || (field < 2 && version[i] == 46) || (field == 2 && version[i] == 45)
        if ends {
            fields[field] = version[start..i]
            field += 1
            start = i + 1
            if field == 3 && i < version.length { fields[3] = version[start..version.length] }
            if field >= 3 { break }
        }
        i += 1
    }
    if fields[0].length == 0 || fields[1].length == 0 || fields[2].length == 0 { return false }
    var text = ""
    var from: usize = 0
    var k: usize = 0
    while k < template.length {
        var replaced = ""
        var length: usize = 0
        if template[k] == 64 {
            const rest = template[k..template.length]
            var which: usize = 0
            while which < 4 {
                const placeholder = PLACEHOLDERS[which]
                if length == 0 && rest.length >= placeholder.length && std.text.same(rest[0..placeholder.length], placeholder) {
                    replaced = fields[which]
                    length = placeholder.length
                }
                which += 1
            }
        }
        if length > 0 {
            text = join3(b, text, template[from..k], replaced)
            k += length
            from = k
        } else {
            k += 1
        }
    }
    text = Build.concat(b, text, template[from..template.length])
    return Build.writeText(b, Build.concat(b, GENERATED, "glslang/build_info.h"), text)
}

// The value of the record's line `    NAME: VALUE` in UPSTREAM.md ("" when
// it has none).
fn recorded(record: []const u8, name: []const u8) -> []const u8 {
    var at: usize = 0
    while at < record.length {
        const line = Build.nextLine(record, &at)
        if line.length > name.length + 6 && std.text.same(line[0..4], "    ") && std.text.same(line[4..4 + name.length], name) && std.text.same(line[4 + name.length..6 + name.length], ": ") {
            return line[6 + name.length..line.length]
        }
    }
    return ""
}

// What deqp-vk says of its release in every result file and in
// dEQP-VK.info.build (qpInfo.c's qpReleaseInfo.inl): the tag, the first
// eight digits of its commit and glslang's commit, as the suite's
// gen_release_info.py makes them from its checkout, here from
// UPSTREAM.md's record of the fetched sources. Without it every run
// calls itself "unknown", 0xcafebabe.
fn releaseInfo(b: *Build.Builder) -> bool {
    const record = Build.readText(b, "projects/cts/UPSTREAM.md")
    const tag = recorded(record, "vk-gl-cts.tag")
    const commit = recorded(record, "vk-gl-cts.commit")
    const glslang = recorded(record, "glslang.commit")
    const tools = recorded(record, "spirv-tools.commit")
    if tag.length == 0 || commit.length < 8 || glslang.length == 0 || tools.length == 0 { return false }
    var text = "/* What deqp-vk says of its release (qpInfo.c), made by projects/cts/build.mlx\n * from projects/cts/UPSTREAM.md as the suite's gen_release_info.py makes it. */\n"
    text = join3(b, text, "#define DEQP_RELEASE_NAME \"", Build.concat(b, tag, "\"\n"))
    text = join3(b, text, "#define DEQP_RELEASE_ID 0x", Build.concat(b, commit[0..8], "\n"))
    text = join3(b, text, "#define DEQP_RELEASE_GLSL_NAME \"git-", Build.concat(b, glslang, "\"\n"))
    text = join3(b, text, "#define DEQP_RELEASE_SPIRV_TOOLS_NAME \"git-", Build.concat(b, tools, " (its headers; the library is not built)\"\n"))
    text = Build.concat(b, text, "#define DEQP_RELEASE_SPIRV_HEADERS_NAME \"not used\"\n")
    return Build.writeText(b, Build.concat(b, GENERATED, "qpReleaseInfo.inl"), text)
}

// The objects of deqp-vk: their group (`cts-objects`) of groups of a
// hundred at most (a step's dependencies are counted), the one filled
// now, and the link's list of them.
const Objects = struct {
    all: Build.Step
    chunk: Build.Step
    inChunk: usize
    chunks: usize
    list: []const u8
}

fn decimal(b: *Build.Builder, value: usize) -> []const u8 {
    if value < 10 { return Build.concat(b, "", "0123456789"[value..value + 1]) }
    return Build.concat(b, decimal(b, value / 10), "0123456789"[value % 10..value % 10 + 1])
}

// The object of SOURCE compiled by mlx-cc with FLAGS, into SET.
fn compile(b: *Build.Builder, tc: webkit.Toolchain, set: *Objects, headers: Build.Step, source: []const u8, name: []const u8, flags: []const u8) -> void {
    if set.*.inChunk >= 100 {
        set.*.chunks += 1
        const chunk = Build.group(b, Build.concat(b, "cts-objects-", decimal(b, set.*.chunks)), "")
        Build.add(b, set.*.all, chunk)
        set.*.chunk = chunk
        set.*.inChunk = 0
    }
    set.*.inChunk += 1
    const object = join3(b, OBJECTS, objectName(b, name), ".o")
    const depfile = Build.concat(b, object, ".d")
    const line = join3(b, join3(b, tc.cc, " -MD -MF ", depfile), flags, join3(b, " -c ", source, Build.concat(b, " -o ", object)))
    const step = Build.command(b, Build.concat(b, "cts/", objectName(b, name)), object, line)
    Build.depfile(b, step, depfile)
    Build.input(b, step, source)
    Build.programEpoch(b, step, tc.epochFile)
    Build.memory(b, step, 1024)
    Build.dependOn(b, step, tc.compiler)
    Build.dependOn(b, step, tc.epoch)
    Build.dependOn(b, step, tc.headers)
    Build.dependOn(b, step, headers)
    Build.add(b, set.*.chunk, step)
    set.*.list = join3(b, set.*.list, " ", object)
}

pub fn cts(b: *Build.Builder, tc: webkit.Toolchain) -> Build.Step {
    const group = Build.group(b, "cts", "deqp-vk, the Vulkan conformance suite, by mlx-cc over our driver (projects/cts)")
    const root = sources(b)
    const suite = Build.concat(b, root, "/vk-gl-cts")
    const glslang = Build.concat(b, root, "/glslang")
    if !Build.exists(b, Build.concat(b, suite, "/external/vulkancts/modules/vulkan/vktTestPackage.cpp")) {
        _ = std.io.writeAll(std.io.stderr(), "mlx build: no conformance suite sources (tools/fetch_cts.sh): the cts steps are left out\n")
        return group
    }
    // What the sources include that is made: the driver's C header (from
    // its Mlx module, by mlx-cheaders), glslang's build_info.h and the
    // suite's qpReleaseInfo.inl.
    const api = "projects/cts/port/api/MlxCtsDriver.mlx"
    const headers = Build.command(b, "cts-headers", Build.concat(b, GENERATED, "port/MlxCtsDriver.h"), join3(b, "mlx-out/bin/mlx-cheaders ", Build.concat(b, GENERATED, "port"), Build.concat(b, " ", api)))
    Build.describe(b, headers, "the conformance suite port's made headers (MlxCtsDriver.h)")
    Build.input(b, headers, api)
    Build.input(b, headers, "mlx-out/bin/mlx-cheaders")
    Build.dependOn(b, headers, Build.step(b, "mlx-cheaders"))
    if !glslangBuildInfo(b, glslang) { Build.fail(b, "cannot make glslang's build_info.h from its CHANGES.md", glslang) }
    if !releaseInfo(b) { Build.fail(b, "cannot make the suite's release information from the record", "projects/cts/UPSTREAM.md") }
    // The driver over the host card, a library of Mlx (port/cts_driver.mlx).
    const driver = Build.plugin(b, DRIVER, "projects/cts/port/cts_driver.mlx")
    Build.option(b, driver, Build.concat(b, "--soname=", DRIVER))
    Build.add(b, group, driver)
    // The include path and the flags.
    var include = ""
    for directory in FRAMEWORK_DIRECTORIES { include = join3(b, include, " -I", Build.concat(b, Build.concat(b, suite, "/"), directory)) }
    for directory in MODULE_DIRECTORIES { include = join3(b, include, " -I", join3(b, suite, "/external/vulkancts/modules/vulkan/", directory)) }
    include = join3(b, include, " -I", glslang)
    include = join3(b, include, " -I", Build.concat(b, root, "/spirv-tools/include"))
    include = join3(b, include, " -I", Build.concat(b, GENERATED, " -I"))
    include = join3(b, include, GENERATED, "port -Iprojects/cts/port")
    const cFlags = join3(b, " -std=c11", include, DEFINES)
    const cppFlags = join3(b, " -std=c++17 -fexceptions", include, DEFINES)
    const glslangFlags = join3(b, " -std=c++17 -fexceptions -I", glslang, join3(b, " -I", GENERATED, " -DENABLE_HLSL -DGLSLANG_OSINCLUDE_UNIX"))
    const objects = Build.group(b, "cts-objects", "the objects of deqp-vk")
    var set = Objects.{ .all = objects, .chunk = objects, .inChunk = 100, .chunks = 0, .list = "" }
    for source in SUITE_SOURCES {
        const path = join3(b, suite, "/", source)
        var flags = if endsWith(source, ".c") { cFlags } else { cppFlags }
        // (qpInfo.c takes the release from releaseInfo's file.)
        if std.text.same(source, "framework/qphelper/qpInfo.c") { flags = Build.concat(b, flags, " -DDEQP_USE_RELEASE_INFO_FILE") }
        compile(b, tc, &set, headers, path, source, flags)
    }
    for source in GLSLANG_SOURCES { compile(b, tc, &set, headers, join3(b, glslang, "/", source), Build.concat(b, "glslang/", source), glslangFlags) }
    for source in PORT_SOURCES { compile(b, tc, &set, headers, Build.concat(b, "projects/cts/port/", source), Build.concat(b, "port/", source), cppFlags) }
    const list = set.list
    // deqp-vk on mlxlibc as loader and C library, the driver beside it in
    // mlx-out/lib, mlxlibcpp, the math library.
    const checkout = Build.environment(b, "PWD")
    var line = join3(b, tc.cc, " -o ", PROGRAM)
    line = Build.concat(b, line, list)
    line = join3(b, line, " mlx-out/lib/", DRIVER)
    line = join3(b, line, " --dynamic-linker=", Build.concat(b, checkout, "/mlx-out/libc/libmlxc.so.1"))
    line = Build.concat(b, line, " -Lmlx-out/lib -lmlxcpp -lm")
    const program = Build.command(b, "cts-deqp-vk", PROGRAM, line)
    Build.describe(b, program, "mlx-out/cts/bin/deqp-vk")
    Build.dependOn(b, program, objects)
    Build.dependOn(b, program, driver)
    Build.dependOn(b, program, Build.step(b, "libc"))
    Build.dependOn(b, program, tc.library)
    Build.dependOn(b, program, tc.linker)
    Build.input(b, program, tc.ld)
    Build.input(b, program, Build.concat(b, "mlx-out/lib/", DRIVER))
    // What is linked in: every object (more than a step's inputs can name
    // one by one, so their directory) and mlxlibcpp. Without them a source
    // compiled again leaves the program as it was.
    Build.inputTree(b, program, OBJECTS[0..OBJECTS.length - 1], ".o")
    Build.input(b, program, "mlx-out/lib/libmlxcpp.a")
    Build.add(b, group, program)
    return group
}

