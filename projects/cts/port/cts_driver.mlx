// libmlxcts-driver.so: the exports through which the conformance suite
// calls our Vulkan driver over the host card (driver.mlx says why each
// command is given one of the entries below: 128, alike but for their
// numbers, as driver.ENTRIES says).
//
//     ./mlx build libmlxcts-driver.so
const driver = @import("./driver.mlx")

export fn mlxcts_vk_get_instance_proc_addr(instance: usize, name: usize) -> usize { return driver.instanceProcAddr(instance, name) }
export fn mlxcts_vk_get_device_proc_addr(device: usize, name: usize) -> usize { return driver.deviceProcAddr(device, name) }
export fn mlxcts_entries_used() -> usize { return driver.entriesUsed() }
export fn mlxcts_entry_0(a: usize, b: usize, c: usize, d: usize, e: usize, f: usize, g: usize, h: usize, i: usize, j: usize, k: usize, l: usize) -> usize { return driver.call(0, a, b, c, d, e, f, g, h, i, j, k, l) }
