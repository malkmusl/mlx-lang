// Our Vulkan driver (projects/brix/vulkan) over the host card
// (card_host.mlx) as the conformance suite reaches it: libmlxcts-driver.so,
// linked into deqp-vk, whose platform (port/tcuMlxPlatform.cpp) takes
// vkGetInstanceProcAddr from mlxcts_vk_get_instance_proc_addr below. The
// suite is the loader here: it asks the driver for every command by name
// and calls what it is given.
//
// The card is the user's RX 580 as the host card serves it with one
// compute ring (card_host.rx580(1)): what a kernel whose calls 80 to 85
// run on a compute ring will describe. The driver is negotiated with as a
// loader would (std.vulkan.icd, interface version 5) before its first
// command.
//
// Why every command goes through an export of this module: the driver's
// functions are Mlx functions, which find their aggregate arena in
// r14/r15 (docs/reference/abi.md, "C boundary"); C++ calling one of them
// directly would hand it whatever its own code keeps there. So the suite
// is never given a driver function itself: each command the driver has is
// given one of the entries of cts_driver.mlx (exports, which map an arena
// of their own, found by their names), the entry calls the driver's
// function with the arguments as they came (twelve words: no command of
// the driver takes more, or takes a structure by value), and gives back
// what it gives. A command the entries cannot carry (a float comes in
// another register) or one for which no entry is left is given as 0, as a
// command the driver does not have, and the error output names it and
// says why (tools/run_cts.sh's summary repeats it).
const std = @import("std")
const card_host = @import("../../brix/vulkan/card_host.mlx")
const record = @import("../../brix/kernel/gpu_record.mlx")
const driver = @import("../../brix/vulkan/driver.mlx")
const pipeline = @import("../../brix/vulkan/pipeline.mlx")
const shader = @import("../../brix/vulkan/shader.mlx")
const ir = @import("../../brix/vulkan/shader_ir.mlx")

// How many entries cts_driver.mlx has (mlxcts_entry_0 ...).
pub const ENTRIES: usize = 128

extern("c") fn strcmp(first: usize, second: usize) -> i32
extern("c") fn dlsym(handle: usize, name: usize) -> usize

const ProcAddr = fn(usize, usize) -> usize
const Command = fn(usize, usize, usize, usize, usize, usize, usize, usize, usize, usize, usize, usize) -> usize

// The card the host card serves, and whether the driver uses it yet.
var facts: record.Facts = undefined
var ready = false
// The driver's vkGetDeviceProcAddr (its own function), once asked for.
var driverDeviceProcAddr: usize = 0
// What each entry calls: the driver's functions, in the order the suite
// asked for them (an entry for each).
var targets: [ENTRIES]usize = undefined
var addresses: [ENTRIES]usize = undefined
var targetCount: usize = 0
// When an entry was not to be had: the suite is given 0 for it, as for a
// command the driver does not have, and this says so.
var exhausted = false

// The commands with a float parameter by value in the registry
// (std/registry/vulkan/vk.xml): the entries pass words alone, so none of
// them is given to the suite.
const FLOAT_COMMANDS = [5][]const u8{ "vkCmdSetLineWidth", "vkCmdSetDepthBias", "vkCmdSetDepthBounds", "vkCmdSetExtraPrimitiveOverestimationSizeEXT", "vkSetDeviceMemoryPriorityEXT" }

// The command `name` (a C string) not given to the suite, and why, on the
// error output.
fn refused(name: usize, why: []const u8) -> usize {
    _ = std.io.eprint("mlxcts: the driver's ")
    _ = std.io.eprint(std.text.cString(unsafe { @ptrFromInt([*]const u8, name) }))
    _ = std.io.eprint(" is not given to the suite: ")
    _ = std.io.eprintln(why)
    return 0
}

fn start() -> void {
    if ready { return }
    card_host.reset()
    facts = card_host.rx580(1)
    _ = card_host.add(&facts)
    driver.use(card_host.interface())
    var version: u32 = 5
    _ = driver.negotiate(&version)
    ready = true
}

fn same(name: usize, text: []const u8) -> bool {
    var c: [64]u8 = undefined
    if text.length >= 63 { return false }
    var index: usize = 0
    while index < text.length {
        c[index] = text[index]
        index += 1
    }
    c[text.length] = 0
    return strcmp(name, @intFromPtr(&c)) == 0
}

// (An export's name with no number after it.)
const NO_NUMBER: usize = 0xFFFFFFFFFFFFFFFF

// The address of the export named `text` then `number` (none for
// NO_NUMBER).
fn exported(text: []const u8, number: usize) -> usize {
    var c: [64]u8 = undefined
    var at: usize = 0
    while at < text.length {
        c[at] = text[at]
        at += 1
    }
    if number != NO_NUMBER {
        var digits: [20]u8 = undefined
        var count: usize = 0
        var rest = number
        while true {
            digits[count] = @intCast(u8, 48 + rest % 10)
            count += 1
            rest = rest / 10
            if rest == 0 { break }
        }
        while count > 0 {
            count -= 1
            c[at] = digits[count]
            at += 1
        }
    }
    c[at] = 0
    return dlsym(0, @intFromPtr(&c))
}

// The entry the suite is given for the driver's function `target`, the
// command `name` (0 for none).
fn entryFor(name: usize, target: usize) -> usize {
    if target == 0 { return 0 }
    for float in FLOAT_COMMANDS {
        if same(name, float) { return refused(name, "it takes a float by value, which the library's entries do not carry") }
    }
    var index: usize = 0
    while index < targetCount {
        if targets[index] == target { return addresses[index] }
        index += 1
    }
    if targetCount >= ENTRIES {
        exhausted = true
        return refused(name, "every one of the library's entries is given out (driver.ENTRIES, cts_driver.mlx)")
    }
    const address = exported("mlxcts_entry_", targetCount)
    if address == 0 { return 0 }
    targets[targetCount] = target
    addresses[targetCount] = address
    targetCount += 1
    return address
}

pub fn instanceProcAddr(instance: usize, name: usize) -> usize {
    start()
    if name == 0 { return 0 }
    if same(name, "vkGetInstanceProcAddr") { return exported("mlxcts_vk_get_instance_proc_addr", NO_NUMBER) }
    const ask = unsafe { @ptrFromInt(ProcAddr, driver.instanceProcAddr()) }
    const target = ask(instance, name)
    if same(name, "vkGetDeviceProcAddr") {
        if target == 0 { return 0 }
        driverDeviceProcAddr = target
        return exported("mlxcts_vk_get_device_proc_addr", NO_NUMBER)
    }
    return entryFor(name, target)
}

pub fn deviceProcAddr(device: usize, name: usize) -> usize {
    start()
    if name == 0 || driverDeviceProcAddr == 0 { return 0 }
    if same(name, "vkGetDeviceProcAddr") { return exported("mlxcts_vk_get_device_proc_addr", NO_NUMBER) }
    const ask = unsafe { @ptrFromInt(ProcAddr, driverDeviceProcAddr) }
    return entryFor(name, ask(device, name))
}

// Entry `index` called with the twelve words it was given.
pub fn call(index: usize, a: usize, b: usize, c: usize, d: usize, e: usize, f: usize, g: usize, h: usize, i: usize, j: usize, k: usize, l: usize) -> usize {
    if index >= targetCount { return 0 }
    const command = unsafe { @ptrFromInt(Command, targets[index]) }
    const result = command(a, b, c, d, e, f, g, h, i, j, k, l)
    if result & 0xFFFFFFFF == ERROR_UNKNOWN { tellRefusal() }
    return result
}

// VK_ERROR_UNKNOWN, as the low half of the word a command gives back.
const ERROR_UNKNOWN: usize = 0xFFFFFFF3

// Why the driver's compiler refused a shader, when that is why a command
// answered VK_ERROR_UNKNOWN (vkCreateComputePipelines: pipeline.mlx keeps
// it): on the suite's error output, beside the case's failure, which says
// only the code. Said once a refusal.
fn tellRefusal() -> void {
    if pipeline.lastFailure.kind == ir.Failure.none { return }
    _ = std.io.eprint("mlxcts: the driver's compiler refused the shader: ")
    _ = std.io.eprint(shader.failureText(pipeline.lastFailure.kind))
    if pipeline.lastFailure.opcode != 0 {
        _ = std.io.eprint(" (SPIR-V opcode ")
        tellNumber(@intCast(usize, pipeline.lastFailure.opcode))
        _ = std.io.eprint(" at word ")
        tellNumber(pipeline.lastFailure.offset)
        _ = std.io.eprint(")")
    }
    _ = std.io.eprintln("")
    pipeline.lastFailure.kind = ir.Failure.none
}

fn tellNumber(value: usize) -> void {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[19 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    _ = std.io.eprint(digits[20 - count..20])
}

// How many of the entries are given out, and whether one was lacking.
pub fn entriesUsed() -> usize { return targetCount }
pub fn entriesExhausted() -> bool { return exhausted }
