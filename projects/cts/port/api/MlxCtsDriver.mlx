// MlxCtsDriver.h
// Our Vulkan driver over the host card as the conformance suite's
// platform (port/tcuMlxPlatform.cpp) reaches it: the exports of
// libmlxcts-driver.so (projects/cts/port/cts_driver.mlx), with the C ABI.

// The driver's vkGetInstanceProcAddr: what it gives for a command is an
// export of the library that calls the driver's function (0 for a
// command the driver does not have). The first call makes the host card
// (the user's RX 580 with one compute ring) and negotiates with the
// driver.
pub extern("c") fn mlxcts_vk_get_instance_proc_addr(instance: ?*anyopaque, name: ?*const c_char) -> ?*anyopaque
// The driver's vkGetDeviceProcAddr, likewise.
pub extern("c") fn mlxcts_vk_get_device_proc_addr(device: ?*anyopaque, name: ?*const c_char) -> ?*anyopaque
// How many of the library's entries are given out (each one stands for a
// command of the driver).
pub extern("c") fn mlxcts_entries_used() -> usize
