// deflate: compression into raw deflate data (RFC 1951), a zlib stream
// (RFC 1950) or a gzip member (RFC 1952).
//
// The matcher is zlib's: a sliding window of twice the window size, hash
// chains of three-byte strings (head and prev), the longest match along a
// chain bounded by the level's configuration (good, lazy, nice, chain),
// the fast strategy for levels 1 to 3 and lazy matching for 4 to 9,
// stored blocks for level 0, and the Huffman-only and run-length
// strategies; the flushes, the headers and trailers, and the return codes
// are zlib's, so the same calls give the same bytes and the same results.
const c = @import("./common.mlx")
const checksum = @import("./checksum.mlx")
const trees = @import("./trees.mlx")

const DeflateState = trees.DeflateState
const MIN_MATCH = trees.MIN_MATCH
const MAX_MATCH = trees.MAX_MATCH
const MIN_LOOKAHEAD: usize = 262
const WIN_INIT: usize = 258
const MAX_STORED: usize = 65535
const TOO_FAR: usize = 4096
const PRESET_DICT: usize = 0x20

const INIT_STATE: usize = 42
const GZIP_STATE: usize = 57
const EXTRA_STATE: usize = 69
const NAME_STATE: usize = 73
const COMMENT_STATE: usize = 91
const HCRC_STATE: usize = 103
const BUSY_STATE: usize = 113
const FINISH_STATE: usize = 666

// What a compression function leaves: more input or output wanted, a
// flush done, the end begun (more output wanted), the end written.
const NEED_MORE: usize = 0
const BLOCK_DONE: usize = 1
const FINISH_STARTED: usize = 2
const FINISH_DONE: usize = 3

// The levels: reduce the search above a match of `good`, do not search
// lazily above `lazy`, stop above `nice`, follow at most `chain` links;
// with deflate_stored (0), deflate_fast (1) or deflate_slow (2).
var GOOD: [10]usize = [10]usize{ 0, 4, 4, 4, 4, 8, 8, 8, 32, 32 }
var LAZY: [10]usize = [10]usize{ 0, 4, 5, 6, 4, 16, 16, 32, 128, 258 }
var NICE: [10]usize = [10]usize{ 0, 8, 16, 32, 16, 32, 128, 128, 258, 258 }
var CHAIN: [10]usize = [10]usize{ 0, 4, 8, 32, 16, 32, 128, 256, 1024, 4096 }
var FUNC: [10]usize = [10]usize{ 0, 1, 1, 1, 2, 2, 2, 2, 2, 2 }

fn stateOf(strm: *c.ZStream) -> *DeflateState { return unsafe { @ptrFromInt(*DeflateState, strm.*.state) } }

inline fn maxDist(s: *DeflateState) -> usize { return s.*.w_size - MIN_LOOKAHEAD }

inline fn updateHash(s: *DeflateState, h: usize, byte: usize) -> usize {
    return ((h << @intCast(u6, s.*.hash_shift)) ^ byte) & s.*.hash_mask
}

// Inserts the string at STR in the hash chains; the previous head of its
// chain.
inline fn insertString(s: *DeflateState, str: usize) -> usize {
    s.*.ins_h = updateHash(s, s.*.ins_h, @intCast(usize, s.*.window[str + MIN_MATCH - 1]))
    const head = s.*.head[s.*.ins_h]
    s.*.prev[str & s.*.w_mask] = head
    s.*.head[s.*.ins_h] = @intCast(u16, str & 0xffff)
    return @intCast(usize, head)
}

fn clearHash(s: *DeflateState) -> void {
    c.zero(@intFromPtr(s.*.head), s.*.hash_size * 2)
}

// Moves the hash chains down with the window.
fn slideHash(s: *DeflateState) -> void {
    const wsize = s.*.w_size
    var n = s.*.hash_size
    const head = s.*.head
    while n != 0 {
        n -= 1
        const m = @intCast(usize, head[n])
        head[n] = if m >= wsize { @intCast(u16, m - wsize) } else { 0 }
    }
    n = wsize
    const prev = s.*.prev
    while n != 0 {
        n -= 1
        const m = @intCast(usize, prev[n])
        prev[n] = if m >= wsize { @intCast(u16, m - wsize) } else { 0 }
    }
}

// Takes up to SIZE bytes of input into BUF, updating the check value and
// the count; how many.
fn readBuf(strm: *c.ZStream, buf: usize, size: usize) -> usize {
    var len = @intCast(usize, strm.*.avail_in)
    if len > size { len = size }
    if len == 0 { return 0 }
    strm.*.avail_in = @intCast(u32, @intCast(usize, strm.*.avail_in) - len)
    c.copy(buf, strm.*.next_in, len)
    const s = stateOf(strm)
    if s.*.wrap == 1 {
        strm.*.adler = checksum.adler32Update(strm.*.adler, buf, len)
    } else if s.*.wrap == 2 {
        strm.*.adler = checksum.crc32Update(strm.*.adler, buf, len)
    }
    strm.*.next_in += len
    strm.*.total_in +%= @intCast(u64, len)
    return len
}

// Fills the window with input while the lookahead is short, sliding it
// down when it is nearly full.
fn fillWindow(s: *DeflateState) -> void {
    const wsize = s.*.w_size
    const window = @intFromPtr(s.*.window)
    while true {
        var more = s.*.window_size - s.*.lookahead - s.*.strstart
        if s.*.strstart >= wsize + maxDist(s) {
            c.copy(window, window + wsize, wsize - more)
            s.*.match_start -%= wsize
            s.*.strstart -= wsize
            s.*.block_start -= @intCast(i64, wsize)
            if s.*.insert > s.*.strstart { s.*.insert = s.*.strstart }
            slideHash(s)
            more += wsize
        }
        if s.*.strm.*.avail_in == 0 { break }
        const n = readBuf(s.*.strm, window + s.*.strstart + s.*.lookahead, more)
        s.*.lookahead += n
        if s.*.lookahead + s.*.insert >= MIN_MATCH {
            var str = s.*.strstart - s.*.insert
            s.*.ins_h = @intCast(usize, s.*.window[str])
            s.*.ins_h = updateHash(s, s.*.ins_h, @intCast(usize, s.*.window[str + 1]))
            while s.*.insert != 0 {
                s.*.ins_h = updateHash(s, s.*.ins_h, @intCast(usize, s.*.window[str + MIN_MATCH - 1]))
                s.*.prev[str & s.*.w_mask] = s.*.head[s.*.ins_h]
                s.*.head[s.*.ins_h] = @intCast(u16, str & 0xffff)
                str += 1
                s.*.insert -= 1
                if s.*.lookahead + s.*.insert < MIN_MATCH { break }
            }
        }
        if !(s.*.lookahead < MIN_LOOKAHEAD && s.*.strm.*.avail_in != 0) { break }
    }
    // The bytes after the data that the matcher may read are zeroed once.
    if s.*.high_water < s.*.window_size {
        const curr = s.*.strstart + s.*.lookahead
        if s.*.high_water < curr {
            var init = s.*.window_size - curr
            if init > WIN_INIT { init = WIN_INIT }
            c.zero(window + curr, init)
            s.*.high_water = curr + init
        } else if s.*.high_water < curr + WIN_INIT {
            var init = curr + WIN_INIT - s.*.high_water
            if init > s.*.window_size - s.*.high_water { init = s.*.window_size - s.*.high_water }
            c.zero(window + s.*.high_water, init)
            s.*.high_water += init
        }
    }
}

// ---------------------------------------------------------------------------
// Setting up

pub fn init2(strmAddress: usize, level0: i32, method: i32, windowBits0: i32, memLevel: i32, strategy: i32, version: usize, streamSize: i32) -> i32 {
    if !c.versionMatches(version, streamSize) { return c.Z_VERSION_ERROR }
    if strmAddress == 0 { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    strm.*.msg = 0
    c.defaultAllocators(strm)
    var level = level0
    if level == -1 { level = 6 }
    var windowBits = windowBits0
    var wrap: i64 = 1
    if windowBits < 0 {
        wrap = 0
        if windowBits < -15 { return c.Z_STREAM_ERROR }
        windowBits = -windowBits
    } else if windowBits > 15 {
        wrap = 2
        windowBits -= 16
    }
    if memLevel < 1 || memLevel > 9 || method != c.Z_DEFLATED || windowBits < 8 || windowBits > 15 || level < 0 || level > 9 || strategy < 0 || strategy > c.Z_FIXED || (windowBits == 8 && wrap != 1) {
        return c.Z_STREAM_ERROR
    }
    if windowBits == 8 { windowBits = 9 }
    const address = c.zalloc(strm, 1, @sizeOf(DeflateState))
    if address == 0 { return c.Z_MEM_ERROR }
    strm.*.state = address
    const s: *DeflateState = unsafe { @ptrFromInt(*DeflateState, address) }
    s.*.strm = strm
    s.*.status = INIT_STATE
    s.*.wrap = wrap
    s.*.gzhead = 0
    s.*.w_bits = @intCast(usize, windowBits)
    s.*.w_size = @intCast(usize, 1) << @intCast(u6, s.*.w_bits)
    s.*.w_mask = s.*.w_size - 1
    s.*.hash_bits = @intCast(usize, memLevel) + 7
    s.*.hash_size = @intCast(usize, 1) << @intCast(u6, s.*.hash_bits)
    s.*.hash_mask = s.*.hash_size - 1
    s.*.hash_shift = (s.*.hash_bits + MIN_MATCH - 1) / MIN_MATCH
    s.*.window = c.bytes(c.zalloc(strm, s.*.w_size, 2))
    s.*.prev = c.shorts(c.zalloc(strm, s.*.w_size, 2))
    s.*.head = c.shorts(c.zalloc(strm, s.*.hash_size, 2))
    s.*.high_water = 0
    s.*.lit_bufsize = @intCast(usize, 1) << @intCast(u6, memLevel + 6)
    // The symbols of a block share the pending buffer with the output,
    // starting a quarter of the way in (zlib's overlay: the output cannot
    // catch up with the symbols not yet written).
    s.*.pending_buf = c.bytes(c.zalloc(strm, s.*.lit_bufsize, 4))
    s.*.pending_buf_size = s.*.lit_bufsize * 4
    if @intFromPtr(s.*.window) == 0 || @intFromPtr(s.*.prev) == 0 || @intFromPtr(s.*.head) == 0 || @intFromPtr(s.*.pending_buf) == 0 {
        s.*.status = FINISH_STATE
        strm.*.msg = c.errorMessage(c.Z_MEM_ERROR)
        _ = end(strmAddress)
        return c.Z_MEM_ERROR
    }
    s.*.sym_buf = c.bytes(@intFromPtr(s.*.pending_buf) + s.*.lit_bufsize)
    s.*.sym_end = (s.*.lit_bufsize - 1) * 3
    s.*.level = @intCast(usize, level)
    s.*.strategy = @intCast(usize, strategy)
    s.*.method = @intCast(usize, method)
    return reset(strmAddress)
}

// Whether the stream is not one deflate set up.
fn stateCheck(strmAddress: usize) -> bool {
    if strmAddress == 0 { return true }
    const strm = c.stream(strmAddress)
    if strm.*.zalloc == 0 || strm.*.zfree == 0 || strm.*.state == 0 { return true }
    const s = stateOf(strm)
    if @intFromPtr(s.*.strm) != strmAddress { return true }
    const status = s.*.status
    return status != INIT_STATE && status != GZIP_STATE && status != EXTRA_STATE && status != NAME_STATE && status != COMMENT_STATE && status != HCRC_STATE && status != BUSY_STATE && status != FINISH_STATE
}

pub fn setDictionary(strmAddress: usize, dictionary0: usize, dictLength0: usize) -> i32 {
    if stateCheck(strmAddress) || dictionary0 == 0 { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    const s = stateOf(strm)
    var dictionary = dictionary0
    var dictLength = dictLength0
    const wrap = s.*.wrap
    if wrap == 2 || (wrap == 1 && s.*.status != INIT_STATE) || s.*.lookahead != 0 { return c.Z_STREAM_ERROR }
    if wrap == 1 { strm.*.adler = checksum.adler32Update(strm.*.adler, dictionary, dictLength) }
    s.*.wrap = 0
    if dictLength >= s.*.w_size {
        if wrap == 0 {
            clearHash(s)
            s.*.strstart = 0
            s.*.block_start = 0
            s.*.insert = 0
        }
        dictionary += dictLength - s.*.w_size
        dictLength = s.*.w_size
    }
    const avail = strm.*.avail_in
    const next = strm.*.next_in
    strm.*.avail_in = @intCast(u32, dictLength)
    strm.*.next_in = dictionary
    fillWindow(s)
    while s.*.lookahead >= MIN_MATCH {
        var str = s.*.strstart
        var n = s.*.lookahead - (MIN_MATCH - 1)
        while true {
            s.*.ins_h = updateHash(s, s.*.ins_h, @intCast(usize, s.*.window[str + MIN_MATCH - 1]))
            s.*.prev[str & s.*.w_mask] = s.*.head[s.*.ins_h]
            s.*.head[s.*.ins_h] = @intCast(u16, str & 0xffff)
            str += 1
            n -= 1
            if n == 0 { break }
        }
        s.*.strstart = str
        s.*.lookahead = MIN_MATCH - 1
        fillWindow(s)
    }
    s.*.strstart += s.*.lookahead
    s.*.block_start = @intCast(i64, s.*.strstart)
    s.*.insert = s.*.lookahead
    s.*.lookahead = 0
    s.*.match_length = MIN_MATCH - 1
    s.*.prev_length = MIN_MATCH - 1
    s.*.match_available = 0
    strm.*.next_in = next
    strm.*.avail_in = avail
    s.*.wrap = wrap
    return c.Z_OK
}

pub fn getDictionary(strmAddress: usize, dictionary: usize, dictLength: usize) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const s = stateOf(c.stream(strmAddress))
    var len = s.*.strstart + s.*.lookahead
    if len > s.*.w_size { len = s.*.w_size }
    if dictionary != 0 && len != 0 { c.copy(dictionary, @intFromPtr(s.*.window) + s.*.strstart + s.*.lookahead - len, len) }
    if dictLength != 0 { c.put32(dictLength, len) }
    return c.Z_OK
}

pub fn resetKeep(strmAddress: usize) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    strm.*.total_in = 0
    strm.*.total_out = 0
    strm.*.msg = 0
    strm.*.data_type = c.Z_UNKNOWN
    const s = stateOf(strm)
    s.*.pending = 0
    s.*.pending_out = @intFromPtr(s.*.pending_buf)
    if s.*.wrap < 0 { s.*.wrap = -s.*.wrap }
    s.*.status = if s.*.wrap == 2 { GZIP_STATE } else { INIT_STATE }
    strm.*.adler = if s.*.wrap == 2 { checksum.crc32Update(0, 0, 0) } else { checksum.adler32Update(0, 0, 0) }
    s.*.last_flush = -2
    trees.trInit(s)
    return c.Z_OK
}

fn configure(s: *DeflateState, level: usize) -> void {
    s.*.max_lazy_match = LAZY[level]
    s.*.good_match = GOOD[level]
    s.*.nice_match = NICE[level]
    s.*.max_chain_length = CHAIN[level]
}

fn lmInit(s: *DeflateState) -> void {
    s.*.window_size = 2 * s.*.w_size
    clearHash(s)
    configure(s, s.*.level)
    s.*.strstart = 0
    s.*.block_start = 0
    s.*.lookahead = 0
    s.*.insert = 0
    s.*.match_length = MIN_MATCH - 1
    s.*.prev_length = MIN_MATCH - 1
    s.*.match_available = 0
    s.*.ins_h = 0
}

pub fn reset(strmAddress: usize) -> i32 {
    const result = resetKeep(strmAddress)
    if result == c.Z_OK { lmInit(stateOf(c.stream(strmAddress))) }
    return result
}

pub fn setHeader(strmAddress: usize, head: usize) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const s = stateOf(c.stream(strmAddress))
    if s.*.wrap != 2 { return c.Z_STREAM_ERROR }
    s.*.gzhead = head
    return c.Z_OK
}

pub fn pending(strmAddress: usize, pendingOut: usize, bits: usize) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const s = stateOf(c.stream(strmAddress))
    if pendingOut != 0 { c.put32(pendingOut, s.*.pending) }
    if bits != 0 { c.putI32(bits, @intCast(i32, s.*.bi_valid)) }
    return c.Z_OK
}

pub fn prime(strmAddress: usize, bits0: i32, value0: i32) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const s = stateOf(c.stream(strmAddress))
    if bits0 < 0 || bits0 > 16 || @intFromPtr(s.*.sym_buf) < s.*.pending_out + 2 { return c.Z_BUF_ERROR }
    var bits = @intCast(usize, bits0)
    var value = @bitCast(u64, @intCast(i64, value0))
    while true {
        var put = 16 - s.*.bi_valid
        if put > bits { put = bits }
        s.*.bi_buf = (s.*.bi_buf | ((value & ((@intCast(u64, 1) << @intCast(u6, put)) - 1)) << @intCast(u6, s.*.bi_valid))) & 0xffff
        s.*.bi_valid += put
        trees.trFlushBits(s)
        // (An int's arithmetic shift.)
        value = @bitCast(u64, @bitCast(i64, value) >> @intCast(u6, put))
        bits -= put
        if bits == 0 { break }
    }
    return c.Z_OK
}

pub fn params(strmAddress: usize, level0: i32, strategy: i32) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    const s = stateOf(strm)
    var level = level0
    if level == -1 { level = 6 }
    if level < 0 || level > 9 || strategy < 0 || strategy > c.Z_FIXED { return c.Z_STREAM_ERROR }
    const newLevel = @intCast(usize, level)
    const newStrategy = @intCast(usize, strategy)
    if (newStrategy != s.*.strategy || FUNC[s.*.level] != FUNC[newLevel]) && s.*.last_flush != -2 {
        const err = run(strmAddress, c.Z_BLOCK)
        if err == c.Z_STREAM_ERROR { return err }
        if strm.*.avail_in != 0 || @intCast(i64, s.*.strstart) - s.*.block_start + @intCast(i64, s.*.lookahead) != 0 { return c.Z_BUF_ERROR }
    }
    if s.*.level != newLevel {
        if s.*.level == 0 && s.*.matches != 0 {
            if s.*.matches == 1 {
                slideHash(s)
            } else {
                clearHash(s)
            }
            s.*.matches = 0
        }
        s.*.level = newLevel
        configure(s, newLevel)
    }
    s.*.strategy = newStrategy
    return c.Z_OK
}

pub fn tune(strmAddress: usize, goodLength: i32, maxLazy: i32, niceLength: i32, maxChain: i32) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const s = stateOf(c.stream(strmAddress))
    s.*.good_match = @intCast(usize, @bitCast(u32, goodLength))
    s.*.max_lazy_match = @intCast(usize, @bitCast(u32, maxLazy))
    s.*.nice_match = @intCast(usize, @bitCast(u32, niceLength))
    s.*.max_chain_length = @intCast(usize, @bitCast(u32, maxChain))
    return c.Z_OK
}

pub fn bound(strmAddress: usize, sourceLen: u64) -> u64 {
    const fixedlen = sourceLen + (sourceLen >> 3) + (sourceLen >> 8) + (sourceLen >> 9) + 4
    const storelen = sourceLen + (sourceLen >> 5) + (sourceLen >> 7) + (sourceLen >> 11) + 7
    if stateCheck(strmAddress) { return (if fixedlen > storelen { fixedlen } else { storelen }) + 6 }
    const s = stateOf(c.stream(strmAddress))
    var wraplen: u64 = 6
    if s.*.wrap == 0 {
        wraplen = 0
    } else if s.*.wrap == 1 {
        wraplen = 6 + (if s.*.strstart != 0 { 4 } else { 0 })
    } else if s.*.wrap == 2 {
        wraplen = 18
        if s.*.gzhead != 0 {
            const head = c.header(s.*.gzhead)
            if head.*.extra != 0 { wraplen += 2 + @intCast(u64, head.*.extra_len) }
            var str = head.*.name
            if str != 0 {
                while true {
                    wraplen += 1
                    const byte = c.get8(str)
                    str += 1
                    if byte == 0 { break }
                }
            }
            str = head.*.comment
            if str != 0 {
                while true {
                    wraplen += 1
                    const byte = c.get8(str)
                    str += 1
                    if byte == 0 { break }
                }
            }
            if head.*.hcrc != 0 { wraplen += 2 }
        }
    }
    if s.*.w_bits != 15 || s.*.hash_bits != 8 + 7 {
        return (if s.*.w_bits <= s.*.hash_bits && s.*.level != 0 { fixedlen } else { storelen }) + wraplen
    }
    return sourceLen + (sourceLen >> 12) + (sourceLen >> 14) + (sourceLen >> 25) + 13 - 6 + wraplen
}

fn putShortMSB(s: *DeflateState, b: usize) -> void {
    trees.putByte(s, (b >> 8) & 255)
    trees.putByte(s, b & 255)
}

// Writes as much pending output as next_out takes.
fn flushPending(strm: *c.ZStream) -> void {
    const s = stateOf(strm)
    trees.trFlushBits(s)
    var len = s.*.pending
    if len > @intCast(usize, strm.*.avail_out) { len = @intCast(usize, strm.*.avail_out) }
    if len == 0 { return }
    c.copy(strm.*.next_out, s.*.pending_out, len)
    strm.*.next_out += len
    s.*.pending_out += len
    strm.*.total_out +%= @intCast(u64, len)
    strm.*.avail_out = @intCast(u32, @intCast(usize, strm.*.avail_out) - len)
    s.*.pending -= len
    if s.*.pending == 0 { s.*.pending_out = @intFromPtr(s.*.pending_buf) }
}

// The header's CRC over the pending bytes from BEG on, when it has one.
fn hcrcUpdate(strm: *c.ZStream, s: *DeflateState, beg: usize) -> void {
    if c.header(s.*.gzhead).*.hcrc != 0 && s.*.pending > beg {
        strm.*.adler = checksum.crc32Update(strm.*.adler, @intFromPtr(s.*.pending_buf) + beg, s.*.pending - beg)
    }
}

fn rank(flush: i64) -> i64 { return flush * 2 - (if flush > 4 { 9 } else { 0 }) }

fn errorReturn(strm: *c.ZStream, code: i32) -> i32 {
    strm.*.msg = c.errorMessage(code)
    return code
}

pub fn run(strmAddress: usize, flush: i32) -> i32 {
    if stateCheck(strmAddress) || flush > c.Z_BLOCK || flush < 0 { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    const s = stateOf(strm)
    if strm.*.next_out == 0 || (strm.*.avail_in != 0 && strm.*.next_in == 0) || (s.*.status == FINISH_STATE && flush != c.Z_FINISH) {
        return errorReturn(strm, c.Z_STREAM_ERROR)
    }
    if strm.*.avail_out == 0 { return errorReturn(strm, c.Z_BUF_ERROR) }
    const oldFlush = s.*.last_flush
    s.*.last_flush = @intCast(i64, flush)
    if s.*.pending != 0 {
        flushPending(strm)
        if strm.*.avail_out == 0 {
            s.*.last_flush = -1
            return c.Z_OK
        }
    } else if strm.*.avail_in == 0 && rank(@intCast(i64, flush)) <= rank(oldFlush) && flush != c.Z_FINISH {
        return errorReturn(strm, c.Z_BUF_ERROR)
    }
    if s.*.status == FINISH_STATE && strm.*.avail_in != 0 { return errorReturn(strm, c.Z_BUF_ERROR) }
    if s.*.status == INIT_STATE && s.*.wrap == 0 { s.*.status = BUSY_STATE }
    if s.*.status == INIT_STATE {
        // The zlib header.
        var header: usize = (8 + ((s.*.w_bits - 8) << 4)) << 8
        var levelFlags: usize = 3
        if s.*.strategy >= 2 || s.*.level < 2 {
            levelFlags = 0
        } else if s.*.level < 6 {
            levelFlags = 1
        } else if s.*.level == 6 {
            levelFlags = 2
        }
        header |= levelFlags << 6
        if s.*.strstart != 0 { header |= PRESET_DICT }
        header += 31 - (header % 31)
        putShortMSB(s, header)
        if s.*.strstart != 0 {
            putShortMSB(s, @intCast(usize, (strm.*.adler >> 16) & 0xffff))
            putShortMSB(s, @intCast(usize, strm.*.adler & 0xffff))
        }
        strm.*.adler = checksum.adler32Update(0, 0, 0)
        s.*.status = BUSY_STATE
        flushPending(strm)
        if s.*.pending != 0 {
            s.*.last_flush = -1
            return c.Z_OK
        }
    }
    if s.*.status == GZIP_STATE {
        // The gzip header.
        strm.*.adler = checksum.crc32Update(0, 0, 0)
        trees.putByte(s, 31)
        trees.putByte(s, 139)
        trees.putByte(s, 8)
        const xfl: usize = if s.*.level == 9 { 2 } else if s.*.strategy >= 2 || s.*.level < 2 { 4 } else { 0 }
        if s.*.gzhead == 0 {
            trees.putByte(s, 0)
            trees.putByte(s, 0)
            trees.putByte(s, 0)
            trees.putByte(s, 0)
            trees.putByte(s, 0)
            trees.putByte(s, xfl)
            trees.putByte(s, c.OS_CODE)
            s.*.status = BUSY_STATE
            flushPending(strm)
            if s.*.pending != 0 {
                s.*.last_flush = -1
                return c.Z_OK
            }
        } else {
            const head = c.header(s.*.gzhead)
            var flags: usize = 0
            if head.*.text != 0 { flags += 1 }
            if head.*.hcrc != 0 { flags += 2 }
            if head.*.extra != 0 { flags += 4 }
            if head.*.name != 0 { flags += 8 }
            if head.*.comment != 0 { flags += 16 }
            trees.putByte(s, flags)
            const time = @intCast(usize, head.*.time)
            trees.putByte(s, time & 255)
            trees.putByte(s, (time >> 8) & 255)
            trees.putByte(s, (time >> 16) & 255)
            trees.putByte(s, (time >> 24) & 255)
            trees.putByte(s, xfl)
            trees.putByte(s, @intCast(usize, @bitCast(u32, head.*.os)) & 255)
            if head.*.extra != 0 {
                trees.putByte(s, @intCast(usize, head.*.extra_len) & 255)
                trees.putByte(s, (@intCast(usize, head.*.extra_len) >> 8) & 255)
            }
            if head.*.hcrc != 0 { strm.*.adler = checksum.crc32Update(strm.*.adler, @intFromPtr(s.*.pending_buf), s.*.pending) }
            s.*.gzindex = 0
            s.*.status = EXTRA_STATE
        }
    }
    if s.*.status == EXTRA_STATE {
        const head = c.header(s.*.gzhead)
        if head.*.extra != 0 {
            var beg = s.*.pending
            var left = (@intCast(usize, head.*.extra_len) & 0xffff) - s.*.gzindex
            while s.*.pending + left > s.*.pending_buf_size {
                const copy = s.*.pending_buf_size - s.*.pending
                c.copy(@intFromPtr(s.*.pending_buf) + s.*.pending, head.*.extra + s.*.gzindex, copy)
                s.*.pending = s.*.pending_buf_size
                hcrcUpdate(strm, s, beg)
                s.*.gzindex += copy
                flushPending(strm)
                if s.*.pending != 0 {
                    s.*.last_flush = -1
                    return c.Z_OK
                }
                beg = 0
                left -= copy
            }
            c.copy(@intFromPtr(s.*.pending_buf) + s.*.pending, head.*.extra + s.*.gzindex, left)
            s.*.pending += left
            hcrcUpdate(strm, s, beg)
            s.*.gzindex = 0
        }
        s.*.status = NAME_STATE
    }
    if s.*.status == NAME_STATE {
        const head = c.header(s.*.gzhead)
        if head.*.name != 0 {
            var beg = s.*.pending
            while true {
                if s.*.pending == s.*.pending_buf_size {
                    hcrcUpdate(strm, s, beg)
                    flushPending(strm)
                    if s.*.pending != 0 {
                        s.*.last_flush = -1
                        return c.Z_OK
                    }
                    beg = 0
                }
                const val = @intCast(usize, c.get8(head.*.name + s.*.gzindex))
                s.*.gzindex += 1
                trees.putByte(s, val)
                if val == 0 { break }
            }
            hcrcUpdate(strm, s, beg)
            s.*.gzindex = 0
        }
        s.*.status = COMMENT_STATE
    }
    if s.*.status == COMMENT_STATE {
        const head = c.header(s.*.gzhead)
        if head.*.comment != 0 {
            var beg = s.*.pending
            while true {
                if s.*.pending == s.*.pending_buf_size {
                    hcrcUpdate(strm, s, beg)
                    flushPending(strm)
                    if s.*.pending != 0 {
                        s.*.last_flush = -1
                        return c.Z_OK
                    }
                    beg = 0
                }
                const val = @intCast(usize, c.get8(head.*.comment + s.*.gzindex))
                s.*.gzindex += 1
                trees.putByte(s, val)
                if val == 0 { break }
            }
            hcrcUpdate(strm, s, beg)
        }
        s.*.status = HCRC_STATE
    }
    if s.*.status == HCRC_STATE {
        if c.header(s.*.gzhead).*.hcrc != 0 {
            if s.*.pending + 2 > s.*.pending_buf_size {
                flushPending(strm)
                if s.*.pending != 0 {
                    s.*.last_flush = -1
                    return c.Z_OK
                }
            }
            trees.putByte(s, @intCast(usize, strm.*.adler & 255))
            trees.putByte(s, @intCast(usize, (strm.*.adler >> 8) & 255))
            strm.*.adler = checksum.crc32Update(0, 0, 0)
        }
        s.*.status = BUSY_STATE
        flushPending(strm)
        if s.*.pending != 0 {
            s.*.last_flush = -1
            return c.Z_OK
        }
    }
    // A new block, or the current one continued.
    if strm.*.avail_in != 0 || s.*.lookahead != 0 || (flush != c.Z_NO_FLUSH && s.*.status != FINISH_STATE) {
        var bstate: usize = 0
        if s.*.level == 0 {
            bstate = deflateStored(s, flush)
        } else if s.*.strategy == 2 {
            bstate = deflateHuff(s, flush)
        } else if s.*.strategy == 3 {
            bstate = deflateRle(s, flush)
        } else if FUNC[s.*.level] == 1 {
            bstate = deflateFast(s, flush)
        } else {
            bstate = deflateSlow(s, flush)
        }
        if bstate == FINISH_STARTED || bstate == FINISH_DONE { s.*.status = FINISH_STATE }
        if bstate == NEED_MORE || bstate == FINISH_STARTED {
            if strm.*.avail_out == 0 { s.*.last_flush = -1 }
            return c.Z_OK
        }
        if bstate == BLOCK_DONE {
            if flush == c.Z_PARTIAL_FLUSH {
                trees.trAlign(s)
            } else if flush != c.Z_BLOCK {
                trees.trStoredBlock(s, 0, 0, 0)
                if flush == c.Z_FULL_FLUSH {
                    clearHash(s)
                    if s.*.lookahead == 0 {
                        s.*.strstart = 0
                        s.*.block_start = 0
                        s.*.insert = 0
                    }
                }
            }
            flushPending(strm)
            if strm.*.avail_out == 0 {
                s.*.last_flush = -1
                return c.Z_OK
            }
        }
    }
    if flush != c.Z_FINISH { return c.Z_OK }
    if s.*.wrap <= 0 { return c.Z_STREAM_END }
    // The trailer.
    if s.*.wrap == 2 {
        const check = @intCast(usize, strm.*.adler & 0xffffffff)
        trees.putByte(s, check & 255)
        trees.putByte(s, (check >> 8) & 255)
        trees.putByte(s, (check >> 16) & 255)
        trees.putByte(s, (check >> 24) & 255)
        const total = @intCast(usize, strm.*.total_in & 0xffffffff)
        trees.putByte(s, total & 255)
        trees.putByte(s, (total >> 8) & 255)
        trees.putByte(s, (total >> 16) & 255)
        trees.putByte(s, (total >> 24) & 255)
    } else {
        putShortMSB(s, @intCast(usize, (strm.*.adler >> 16) & 0xffff))
        putShortMSB(s, @intCast(usize, strm.*.adler & 0xffff))
    }
    flushPending(strm)
    if s.*.wrap > 0 { s.*.wrap = -s.*.wrap }
    return if s.*.pending != 0 { c.Z_OK } else { c.Z_STREAM_END }
}

pub fn end(strmAddress: usize) -> i32 {
    if stateCheck(strmAddress) { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    const s = stateOf(strm)
    const status = s.*.status
    if @intFromPtr(s.*.pending_buf) != 0 { c.zfree(strm, @intFromPtr(s.*.pending_buf)) }
    if @intFromPtr(s.*.head) != 0 { c.zfree(strm, @intFromPtr(s.*.head)) }
    if @intFromPtr(s.*.prev) != 0 { c.zfree(strm, @intFromPtr(s.*.prev)) }
    if @intFromPtr(s.*.window) != 0 { c.zfree(strm, @intFromPtr(s.*.window)) }
    c.zfree(strm, strm.*.state)
    strm.*.state = 0
    return if status == BUSY_STATE { c.Z_DATA_ERROR } else { c.Z_OK }
}

pub fn copyStream(destAddress: usize, sourceAddress: usize) -> i32 {
    if stateCheck(sourceAddress) || destAddress == 0 { return c.Z_STREAM_ERROR }
    const source = c.stream(sourceAddress)
    const dest = c.stream(destAddress)
    const ss = stateOf(source)
    c.copy(destAddress, sourceAddress, @sizeOf(c.ZStream))
    const address = c.zalloc(dest, 1, @sizeOf(DeflateState))
    if address == 0 { return c.Z_MEM_ERROR }
    dest.*.state = address
    c.copy(address, source.*.state, @sizeOf(DeflateState))
    const ds: *DeflateState = unsafe { @ptrFromInt(*DeflateState, address) }
    ds.*.strm = dest
    ds.*.window = c.bytes(c.zalloc(dest, ds.*.w_size, 2))
    ds.*.prev = c.shorts(c.zalloc(dest, ds.*.w_size, 2))
    ds.*.head = c.shorts(c.zalloc(dest, ds.*.hash_size, 2))
    ds.*.pending_buf = c.bytes(c.zalloc(dest, ds.*.lit_bufsize, 4))
    if @intFromPtr(ds.*.window) == 0 || @intFromPtr(ds.*.prev) == 0 || @intFromPtr(ds.*.head) == 0 || @intFromPtr(ds.*.pending_buf) == 0 {
        _ = end(destAddress)
        return c.Z_MEM_ERROR
    }
    c.copy(@intFromPtr(ds.*.window), @intFromPtr(ss.*.window), ds.*.w_size * 2)
    c.copy(@intFromPtr(ds.*.prev), @intFromPtr(ss.*.prev), ds.*.w_size * 2)
    c.copy(@intFromPtr(ds.*.head), @intFromPtr(ss.*.head), ds.*.hash_size * 2)
    c.copy(@intFromPtr(ds.*.pending_buf), @intFromPtr(ss.*.pending_buf), ds.*.lit_bufsize * 4)
    ds.*.pending_out = @intFromPtr(ds.*.pending_buf) + (ss.*.pending_out - @intFromPtr(ss.*.pending_buf))
    ds.*.sym_buf = c.bytes(@intFromPtr(ds.*.pending_buf) + ds.*.lit_bufsize)
    return c.Z_OK
}

// ---------------------------------------------------------------------------
// Matching

// The longest match at strstart along the chain from CUR_MATCH, longer
// than prev_length (match_start is set to it); its length, at most the
// lookahead.
fn longestMatch(s: *DeflateState, curMatch0: usize) -> usize {
    var curMatch = curMatch0
    var chainLength = s.*.max_chain_length
    const window = s.*.window
    const strstart = s.*.strstart
    var bestLen = s.*.prev_length
    var niceMatch = s.*.nice_match
    const distance = maxDist(s)
    const limit = if strstart > distance { strstart - distance } else { 0 }
    const prev = s.*.prev
    const wmask = s.*.w_mask
    const strend = strstart + MAX_MATCH
    var scanEnd1 = window[strstart + bestLen - 1]
    var scanEnd = window[strstart + bestLen]
    const scan0 = window[strstart]
    const scan1 = window[strstart + 1]
    if s.*.prev_length >= s.*.good_match { chainLength >>= 2 }
    if niceMatch > s.*.lookahead { niceMatch = s.*.lookahead }
    while true {
        const candidate = curMatch
        if window[candidate + bestLen] == scanEnd && window[candidate + bestLen - 1] == scanEnd1 && window[candidate] == scan0 && window[candidate + 1] == scan1 {
            // (The third bytes are equal: their hashes are.)
            var scan = strstart + 3
            var other = candidate + 3
            while scan < strend && window[scan] == window[other] {
                scan += 1
                other += 1
            }
            const len = scan - strstart
            if len > bestLen {
                s.*.match_start = curMatch
                bestLen = len
                if len >= niceMatch { break }
                scanEnd1 = window[strstart + bestLen - 1]
                scanEnd = window[strstart + bestLen]
            }
        }
        curMatch = @intCast(usize, prev[curMatch & wmask])
        if curMatch <= limit { break }
        chainLength -= 1
        if chainLength == 0 { break }
    }
    if bestLen <= s.*.lookahead { return bestLen }
    return s.*.lookahead
}

// Ends the block (the window's bytes from block_start, when they are
// still there) and writes what is pending.
fn flushBlockOnly(s: *DeflateState, last: usize) -> void {
    const buf: usize = if s.*.block_start >= 0 { @intFromPtr(s.*.window) + @intCast(usize, s.*.block_start) } else { 0 }
    trees.trFlushBlock(s, buf, @intCast(usize, @intCast(i64, s.*.strstart) - s.*.block_start), last)
    s.*.block_start = @intCast(i64, s.*.strstart)
    flushPending(s.*.strm)
}

// Level 0: stored blocks, copied straight from next_in to next_out when
// both have room for a worthwhile block.
fn deflateStored(s: *DeflateState, flush: i32) -> usize {
    const strm = s.*.strm
    var minBlock = s.*.pending_buf_size - 5
    if minBlock > s.*.w_size { minBlock = s.*.w_size }
    var len: usize = 0
    var left: usize = 0
    var have: usize = 0
    var last: usize = 0
    var used = @intCast(usize, strm.*.avail_in)
    while true {
        len = MAX_STORED
        have = (s.*.bi_valid + 42) >> 3
        if @intCast(usize, strm.*.avail_out) < have { break }
        have = @intCast(usize, strm.*.avail_out) - have
        left = @intCast(usize, @intCast(i64, s.*.strstart) - s.*.block_start)
        const availIn = @intCast(usize, strm.*.avail_in)
        if len > left + availIn { len = left + availIn }
        if len > have { len = have }
        if len < minBlock && ((len == 0 && flush != c.Z_FINISH) || flush == c.Z_NO_FLUSH || len != left + availIn) { break }
        last = if flush == c.Z_FINISH && len == left + availIn { 1 } else { 0 }
        trees.trStoredBlock(s, 0, 0, last)
        s.*.pending_buf[s.*.pending - 4] = @intCast(u8, len & 255)
        s.*.pending_buf[s.*.pending - 3] = @intCast(u8, (len >> 8) & 255)
        s.*.pending_buf[s.*.pending - 2] = @intCast(u8, (len ^ 0xffff) & 255)
        s.*.pending_buf[s.*.pending - 1] = @intCast(u8, ((len ^ 0xffff) >> 8) & 255)
        flushPending(strm)
        if left != 0 {
            if left > len { left = len }
            c.copy(strm.*.next_out, @intFromPtr(s.*.window) + @intCast(usize, s.*.block_start), left)
            strm.*.next_out += left
            strm.*.avail_out = @intCast(u32, @intCast(usize, strm.*.avail_out) - left)
            strm.*.total_out +%= @intCast(u64, left)
            s.*.block_start += @intCast(i64, left)
            len -= left
        }
        if len != 0 {
            _ = readBuf(strm, strm.*.next_out, len)
            strm.*.next_out += len
            strm.*.avail_out = @intCast(u32, @intCast(usize, strm.*.avail_out) - len)
            strm.*.total_out +%= @intCast(u64, len)
        }
        if last != 0 { break }
    }
    used -= @intCast(usize, strm.*.avail_in)
    if used != 0 {
        if used >= s.*.w_size {
            s.*.matches = 2
            c.copy(@intFromPtr(s.*.window), strm.*.next_in - s.*.w_size, s.*.w_size)
            s.*.strstart = s.*.w_size
            s.*.insert = s.*.strstart
        } else {
            if s.*.window_size - s.*.strstart <= used {
                s.*.strstart -= s.*.w_size
                c.copy(@intFromPtr(s.*.window), @intFromPtr(s.*.window) + s.*.w_size, s.*.strstart)
                if s.*.matches < 2 { s.*.matches += 1 }
                if s.*.insert > s.*.strstart { s.*.insert = s.*.strstart }
            }
            c.copy(@intFromPtr(s.*.window) + s.*.strstart, strm.*.next_in - used, used)
            s.*.strstart += used
            const room = s.*.w_size - s.*.insert
            s.*.insert += if used < room { used } else { room }
        }
        s.*.block_start = @intCast(i64, s.*.strstart)
    }
    if s.*.high_water < s.*.strstart { s.*.high_water = s.*.strstart }
    if last != 0 { return FINISH_DONE }
    if flush != c.Z_NO_FLUSH && flush != c.Z_FINISH && strm.*.avail_in == 0 && @intCast(i64, s.*.strstart) == s.*.block_start { return BLOCK_DONE }
    // The rest of the input into the window.
    have = s.*.window_size - s.*.strstart
    if @intCast(usize, strm.*.avail_in) > have && s.*.block_start >= @intCast(i64, s.*.w_size) {
        s.*.block_start -= @intCast(i64, s.*.w_size)
        s.*.strstart -= s.*.w_size
        c.copy(@intFromPtr(s.*.window), @intFromPtr(s.*.window) + s.*.w_size, s.*.strstart)
        if s.*.matches < 2 { s.*.matches += 1 }
        have += s.*.w_size
        if s.*.insert > s.*.strstart { s.*.insert = s.*.strstart }
    }
    if have > @intCast(usize, strm.*.avail_in) { have = @intCast(usize, strm.*.avail_in) }
    if have != 0 {
        _ = readBuf(strm, @intFromPtr(s.*.window) + s.*.strstart, have)
        s.*.strstart += have
        const room = s.*.w_size - s.*.insert
        s.*.insert += if have < room { have } else { room }
    }
    if s.*.high_water < s.*.strstart { s.*.high_water = s.*.strstart }
    // A stored block into the pending buffer when there is enough for a
    // worthwhile one, or when flushing and the rest fits.
    have = (s.*.bi_valid + 42) >> 3
    have = s.*.pending_buf_size - have
    if have > MAX_STORED { have = MAX_STORED }
    minBlock = if have < s.*.w_size { have } else { s.*.w_size }
    left = @intCast(usize, @intCast(i64, s.*.strstart) - s.*.block_start)
    if left >= minBlock || ((left != 0 || flush == c.Z_FINISH) && flush != c.Z_NO_FLUSH && strm.*.avail_in == 0 && left <= have) {
        len = if left < have { left } else { have }
        last = if flush == c.Z_FINISH && strm.*.avail_in == 0 && len == left { 1 } else { 0 }
        trees.trStoredBlock(s, @intFromPtr(s.*.window) + @intCast(usize, s.*.block_start), len, last)
        s.*.block_start += @intCast(i64, len)
        flushPending(strm)
    }
    return if last != 0 { FINISH_STARTED } else { NEED_MORE }
}

// What the end of a compression function returns once the input runs
// out with FLUSH.
fn finishBlocks(s: *DeflateState, flush: i32) -> usize {
    if flush == c.Z_FINISH {
        flushBlockOnly(s, 1)
        if s.*.strm.*.avail_out == 0 { return FINISH_STARTED }
        return FINISH_DONE
    }
    if s.*.sym_next != 0 {
        flushBlockOnly(s, 0)
        if s.*.strm.*.avail_out == 0 { return NEED_MORE }
    }
    return BLOCK_DONE
}

// Levels 1 to 3: the longest match is taken at once; the strings of a
// short match are inserted in the hash chains.
fn deflateFast(s: *DeflateState, flush: i32) -> usize {
    while true {
        if s.*.lookahead < MIN_LOOKAHEAD {
            fillWindow(s)
            if s.*.lookahead < MIN_LOOKAHEAD && flush == c.Z_NO_FLUSH { return NEED_MORE }
            if s.*.lookahead == 0 { break }
        }
        var hashHead: usize = 0
        if s.*.lookahead >= MIN_MATCH { hashHead = insertString(s, s.*.strstart) }
        if hashHead != 0 && s.*.strstart -% hashHead <= maxDist(s) {
            s.*.match_length = longestMatch(s, hashHead)
        }
        var bflush = false
        if s.*.match_length >= MIN_MATCH {
            bflush = trees.tallyDist(s, s.*.strstart - s.*.match_start, s.*.match_length - MIN_MATCH)
            s.*.lookahead -= s.*.match_length
            if s.*.match_length <= s.*.max_lazy_match && s.*.lookahead >= MIN_MATCH {
                s.*.match_length -= 1
                while true {
                    s.*.strstart += 1
                    _ = insertString(s, s.*.strstart)
                    s.*.match_length -= 1
                    if s.*.match_length == 0 { break }
                }
                s.*.strstart += 1
            } else {
                s.*.strstart += s.*.match_length
                s.*.match_length = 0
                s.*.ins_h = @intCast(usize, s.*.window[s.*.strstart])
                s.*.ins_h = updateHash(s, s.*.ins_h, @intCast(usize, s.*.window[s.*.strstart + 1]))
            }
        } else {
            bflush = trees.tallyLit(s, @intCast(usize, s.*.window[s.*.strstart]))
            s.*.lookahead -= 1
            s.*.strstart += 1
        }
        if bflush {
            flushBlockOnly(s, 0)
            if s.*.strm.*.avail_out == 0 { return NEED_MORE }
        }
    }
    s.*.insert = if s.*.strstart < MIN_MATCH - 1 { s.*.strstart } else { MIN_MATCH - 1 }
    return finishBlocks(s, flush)
}

// Levels 4 to 9: lazy matching, a match is taken only when the next
// position has no longer one.
fn deflateSlow(s: *DeflateState, flush: i32) -> usize {
    while true {
        if s.*.lookahead < MIN_LOOKAHEAD {
            fillWindow(s)
            if s.*.lookahead < MIN_LOOKAHEAD && flush == c.Z_NO_FLUSH { return NEED_MORE }
            if s.*.lookahead == 0 { break }
        }
        var hashHead: usize = 0
        if s.*.lookahead >= MIN_MATCH { hashHead = insertString(s, s.*.strstart) }
        s.*.prev_length = s.*.match_length
        s.*.prev_match = s.*.match_start
        s.*.match_length = MIN_MATCH - 1
        if hashHead != 0 && s.*.prev_length < s.*.max_lazy_match && s.*.strstart - hashHead <= maxDist(s) {
            s.*.match_length = longestMatch(s, hashHead)
            if s.*.match_length <= 5 && (s.*.strategy == 1 || (s.*.match_length == MIN_MATCH && s.*.strstart -% s.*.match_start > TOO_FAR)) {
                s.*.match_length = MIN_MATCH - 1
            }
        }
        if s.*.prev_length >= MIN_MATCH && s.*.match_length <= s.*.prev_length {
            const maxInsert = s.*.strstart + s.*.lookahead - MIN_MATCH
            const bflush = trees.tallyDist(s, s.*.strstart - 1 - s.*.prev_match, s.*.prev_length - MIN_MATCH)
            s.*.lookahead -= s.*.prev_length - 1
            s.*.prev_length -= 2
            while true {
                s.*.strstart += 1
                if s.*.strstart <= maxInsert { _ = insertString(s, s.*.strstart) }
                s.*.prev_length -= 1
                if s.*.prev_length == 0 { break }
            }
            s.*.match_available = 0
            s.*.match_length = MIN_MATCH - 1
            s.*.strstart += 1
            if bflush {
                flushBlockOnly(s, 0)
                if s.*.strm.*.avail_out == 0 { return NEED_MORE }
            }
        } else if s.*.match_available != 0 {
            const bflush = trees.tallyLit(s, @intCast(usize, s.*.window[s.*.strstart - 1]))
            if bflush { flushBlockOnly(s, 0) }
            s.*.strstart += 1
            s.*.lookahead -= 1
            if s.*.strm.*.avail_out == 0 { return NEED_MORE }
        } else {
            s.*.match_available = 1
            s.*.strstart += 1
            s.*.lookahead -= 1
        }
    }
    if s.*.match_available != 0 {
        _ = trees.tallyLit(s, @intCast(usize, s.*.window[s.*.strstart - 1]))
        s.*.match_available = 0
    }
    s.*.insert = if s.*.strstart < MIN_MATCH - 1 { s.*.strstart } else { MIN_MATCH - 1 }
    return finishBlocks(s, flush)
}

// Z_RLE: matches of distance one only, the runs of a byte.
fn deflateRle(s: *DeflateState, flush: i32) -> usize {
    const window = s.*.window
    while true {
        if s.*.lookahead <= MAX_MATCH {
            fillWindow(s)
            if s.*.lookahead <= MAX_MATCH && flush == c.Z_NO_FLUSH { return NEED_MORE }
            if s.*.lookahead == 0 { break }
        }
        s.*.match_length = 0
        if s.*.lookahead >= MIN_MATCH && s.*.strstart > 0 {
            var scan = s.*.strstart - 1
            const prev = window[scan]
            if prev == window[scan + 1] && prev == window[scan + 2] && prev == window[scan + 3] {
                scan += 3
                const strend = s.*.strstart + MAX_MATCH
                while true {
                    scan += 1
                    if prev != window[scan] || scan >= strend { break }
                }
                s.*.match_length = MAX_MATCH - (strend - scan)
                if s.*.match_length > s.*.lookahead { s.*.match_length = s.*.lookahead }
            }
        }
        var bflush = false
        if s.*.match_length >= MIN_MATCH {
            bflush = trees.tallyDist(s, 1, s.*.match_length - MIN_MATCH)
            s.*.lookahead -= s.*.match_length
            s.*.strstart += s.*.match_length
            s.*.match_length = 0
        } else {
            bflush = trees.tallyLit(s, @intCast(usize, window[s.*.strstart]))
            s.*.lookahead -= 1
            s.*.strstart += 1
        }
        if bflush {
            flushBlockOnly(s, 0)
            if s.*.strm.*.avail_out == 0 { return NEED_MORE }
        }
    }
    s.*.insert = 0
    return finishBlocks(s, flush)
}

// Z_HUFFMAN_ONLY: literals only.
fn deflateHuff(s: *DeflateState, flush: i32) -> usize {
    while true {
        if s.*.lookahead == 0 {
            fillWindow(s)
            if s.*.lookahead == 0 {
                if flush == c.Z_NO_FLUSH { return NEED_MORE }
                break
            }
        }
        s.*.match_length = 0
        const bflush = trees.tallyLit(s, @intCast(usize, s.*.window[s.*.strstart]))
        s.*.lookahead -= 1
        s.*.strstart += 1
        if bflush {
            flushBlockOnly(s, 0)
            if s.*.strm.*.avail_out == 0 { return NEED_MORE }
        }
    }
    s.*.insert = 0
    return finishBlocks(s, flush)
}

// ---------------------------------------------------------------------------

export fn deflateInit_(strm: usize, level: i32, version: usize, stream_size: i32) -> i32 {
    return init2(strm, level, c.Z_DEFLATED, c.MAX_WBITS, c.DEF_MEM_LEVEL, c.Z_DEFAULT_STRATEGY, version, stream_size)
}
export fn deflateInit2_(strm: usize, level: i32, method: i32, windowBits: i32, memLevel: i32, strategy: i32, version: usize, stream_size: i32) -> i32 {
    return init2(strm, level, method, windowBits, memLevel, strategy, version, stream_size)
}
export fn deflate(strm: usize, flush: i32) -> i32 { return run(strm, flush) }
export fn deflateEnd(strm: usize) -> i32 { return end(strm) }
export fn deflateReset(strm: usize) -> i32 { return reset(strm) }
export fn deflateResetKeep(strm: usize) -> i32 { return resetKeep(strm) }
export fn deflateSetDictionary(strm: usize, dictionary: usize, dictLength: u32) -> i32 { return setDictionary(strm, dictionary, @intCast(usize, dictLength)) }
export fn deflateGetDictionary(strm: usize, dictionary: usize, dictLength: usize) -> i32 { return getDictionary(strm, dictionary, dictLength) }
export fn deflateCopy(dest: usize, source: usize) -> i32 { return copyStream(dest, source) }
export fn deflateParams(strm: usize, level: i32, strategy: i32) -> i32 { return params(strm, level, strategy) }
export fn deflateTune(strm: usize, good_length: i32, max_lazy: i32, nice_length: i32, max_chain: i32) -> i32 { return tune(strm, good_length, max_lazy, nice_length, max_chain) }
export fn deflateBound(strm: usize, sourceLen: u64) -> u64 { return bound(strm, sourceLen) }
export fn deflatePending(strm: usize, pending_: usize, bits: usize) -> i32 { return pending(strm, pending_, bits) }
export fn deflatePrime(strm: usize, bits: i32, value: i32) -> i32 { return prime(strm, bits, value) }
export fn deflateSetHeader(strm: usize, head: usize) -> i32 { return setHeader(strm, head) }
