// libmlxz.so: zlib for C and C++ programs, in Mlx, with zlib's C API
// (1.3.1, declared by the modules of api/, whose C headers mlx-cheaders
// makes): deflate and inflate streams, compress and uncompress, the
// check values, the gzip files.
//
//     ./mlx build zlib
//
// The parts: common.mlx (z_stream, gz_header, the codes and messages,
// the allocator), checksum.mlx (Adler-32, CRC-32), trees.mlx and
// deflate.mlx (compression), inflate.mlx (decompression), utility.mlx
// (compress, uncompress, inflateBack, zError), gzip.mlx and varargs.mlx
// (the gzip files).
const common = @import("./common.mlx")
const checksum = @import("./checksum.mlx")
const deflate = @import("./deflate.mlx")
const inflate = @import("./inflate.mlx")
const utility = @import("./utility.mlx")
const gzip = @import("./gzip.mlx")
