// Skia (Source/ThirdParty/skia), WebKit's 2D graphics library, as
// WebKit's CMake builds it for the WPE port (Source/ThirdParty/skia/
// CMakeLists.txt): one static archive, libSkia.a, of the sources in
// lists/skia.txt, in the order CMake archives them, with Skia's
// configuration (the Ganesh renderer over OpenGL ES, FreeType fonts, the
// SVG module, PNG decoding, HarfBuzz shaping).
//
// mlx-cc has no vector registers, so Skia takes its portable paths by its
// own configuration macros: SkVx's arrays (SKVX_DISABLE_SIMD), the
// scalar raster pipeline (SKRP_CPU_SCALAR), skcms's portable transforms
// (SKCMS_PORTABLE, which also leaves out the AVX2 and AVX-512 ones).
// The reference build's defines that no Skia source reads (WebKit's
// BUILDING_*, HAVE_CONFIG_H, GETTEXT_PACKAGE, JSC_GLIB_API_ENABLED,
// PAS_BMALLOC, _GLIBCXX_ASSERTIONS) are left out.
const std = @import("std")
const Build = @import("std.build")

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

// The defines of WebKit's CMakeLists.txt (PUBLIC and PRIVATE alike).
const DEFINES: []const u8 = "-DSKIA_IMPLEMENTATION=1 -DSK_ASSUME_GL=0 -DSK_ASSUME_GL_ES=1 -DSK_ASSUME_WEBGL=0 -DSK_CODEC_DECODES_PNG -DSK_DISABLE_LEGACY_GL_MAKE_NATIVE_INTERFACE -DSK_DISABLE_LEGACY_IMAGE_READBUFFER -DSK_DISABLE_LEGACY_INIT_DECODERS -DSK_DISABLE_LEGACY_PNG_WRITEBUFFER -DSK_DISABLE_LEGACY_SKSHAPER_FUNCTIONS -DSK_DISABLE_TRACING -DSK_DISABLE_WEBGL_INTERFACE -DSK_ENABLE_AVX512_OPTS -DSK_ENABLE_PRECOMPILE -DSK_ENABLE_SVG -DSK_GAMMA_APPLY_TO_A8 -DSK_GANESH -DSK_GL -DSK_R32_SHIFT=16 -DSK_RELEASE -DSK_SHAPER_HARFBUZZ_AVAILABLE -DSK_SHAPER_PRIMITIVE_AVAILABLE -DSK_TYPEFACE_FACTORY_FREETYPE -DHAVE_HB_FEATURES_H -DNDEBUG"

// Skia's portable paths (see above).
const PORTABLE: []const u8 = "-DSKVX_DISABLE_SIMD -DSKRP_CPU_SCALAR -DSKCMS_PORTABLE"

// The flags of Skia's sources (ROOT is Source/ThirdParty/skia; FREETYPE
// and ZLIB the directories of mlx-freetype's and mlx-zlib's headers, in
// place of the system's). WebKitSkiaConfig.h, the user configuration, is
// named in angle brackets: the build's command lines keep no quotes in a
// word.
pub fn flags(b: *Build.Builder, root: []const u8, freetype: []const u8, zlib: []const u8) -> []const u8 {
    var line = join3(b, DEFINES, " ", PORTABLE)
    line = Build.concat(b, line, " -DSK_USER_CONFIG_HEADER=<WebKitSkiaConfig.h> -std=c++23")
    line = join3(b, line, " -I", root)
    line = join3(b, line, " -I", freetype)
    line = join3(b, line, " -I", zlib)
    return line
}

// The sources of Skia's processor-dependent routines: the dispatchers
// choosing them by the processor's features (cpuid) and the versions
// for SSSE3, AVX, AVX2 and AVX-512, which redefine SK_CPU_X64_LEVEL and
// use the intrinsics of those instruction sets (SkOpts_SetTarget.h).
// Compiled with Skia's SK_ENABLE_OPTIMIZE_SIZE, which leaves those
// versions out and the dispatchers on the portable ones, consistently
// in all of these files (and in no other: elsewhere it would drop
// features).
const CPU_DISPATCH = [15][]const u8{
    "src/core/SkBitmapProcState_opts.cpp", "src/core/SkBitmapProcState_opts_ssse3.cpp",
    "src/core/SkBlitMask_opts.cpp", "src/core/SkBlitMask_opts_ssse3.cpp",
    "src/core/SkBlitRow_opts.cpp", "src/core/SkBlitRow_opts_ml3.cpp",
    "src/core/SkMemset_opts.cpp", "src/core/SkMemset_opts_avx.cpp", "src/core/SkMemset_opts_erms.cpp",
    "src/core/SkSwizzler_opts.cpp", "src/core/SkSwizzler_opts_ml3.cpp", "src/core/SkSwizzler_opts_ssse3.cpp",
    "src/core/SkOpts.cpp", "src/opts/SkOpts_ml3.cpp", "src/opts/SkOpts_ml4.cpp",
}

// The flags the source PATH adds to flags(): " -DSK_ENABLE_OPTIMIZE_SIZE"
// for the processor-dependent routines, "" for the others.
pub fn sourceFlags(path: []const u8) -> []const u8 {
    for source in CPU_DISPATCH {
        if std.text.same(source, path) { return " -DSK_ENABLE_OPTIMIZE_SIZE" }
    }
    return ""
}

// Whether SKIPPED (lists/skia-skipped.txt: `PATH REASON...` a line, `#`
// lines comments) names PATH.
pub fn isSkipped(skipped: []const u8, path: []const u8) -> bool {
    var at: usize = 0
    while at < skipped.length {
        const line = Build.nextLine(skipped, &at)
        if line.length <= path.length { continue }
        if line[path.length] == 32 && std.text.same(line[0..path.length], path) { return true }
    }
    return false
}
