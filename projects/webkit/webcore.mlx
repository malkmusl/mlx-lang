// What WebCore's build generates for a port, made by WebKit's generators
// ported to Mlx (projects/webkit/generators), as WebKit's CMake build makes
// its WebCore/DerivedSources: for the WPE port into
// mlx-out/webkit/generated/WebCore, for the Mlx port (PORT.md) into
// mlx-out/webkit/mlx/generated/WebCore/DerivedSources:
//
//     ./mlx build webkit-webcore-derived
//     ./mlx build webkit-mlx-webcore-derived
//
// The steps run the generators as WebCore's CMake files run the Perl,
// Python and Ruby scripts (WebCoreMacros.cmake, CMakeLists.txt,
// PlatformWPE.cmake), with the same arguments but for where the files
// are; gperf, which the scripts run themselves, is a step of its own after
// them. What differs between the ports is the feature defines (config.mlx)
// and the source lists; the IDL files are the same (CMake lists them
// whatever the options: their [Conditional]s become #if in what is
// generated). The copies of the source lists and the unified sources
// (generate-unified-source-bundles.py's, see unified.mlx) are made while
// the steps are declared.
const std = @import("std")
const Build = @import("std.build")
const config = @import("./config.mlx")
const unified = @import("./unified.mlx")

// Where the WPE port's files go (WebCore's DerivedSources).
pub const DERIVED: []const u8 = "mlx-out/webkit/generated/WebCore"

// What one port's WebCore build generates and from what.
pub const Derived = struct {
    // Where the files go (WebCore's DerivedSources).
    directory: []const u8
    // The list the bindings generator reads its IDL files from (its
    // --idlFilesList, --idlFileNamesList and --ppIDLFilesList: WebKit's
    // build writes three, the same, beside the generated sources, not
    // among them).
    idlList: []const u8
    // The port's feature defines (config.mlx).
    defines: []const u8
    // The group's name and what it says; what the steps' names start with.
    name: []const u8
    description: []const u8
    prefix: []const u8
    // The source lists the unified sources are made of, a line each: paths
    // under Source/WebCore (WebKit's) or of this checkout (projects/...,
    // the port's own); and the list of the sources of those lists the port
    // does not compile (`PATH REASON` a line, `#` lines comments; "" for
    // none).
    lists: []const u8
    skipped: []const u8
    // Whether the AT-SPI interfaces are made (gdbus-codegen's).
    atspi: bool
    // The dense bundles of the unified sources (unified.Options's
    // denseFilters).
    dense: []const u8
    // The port's own settings, read by webkit-settings after WebKit's
    // preferences (a setting named again replaces WebKit's); "" for none.
    settings: []const u8
}

// The WPE port's: its feature defines, Sources.txt, SourcesWPE.txt and the
// platform/Sources*.txt PlatformWPE.cmake takes.
pub fn wpe() -> Derived {
    return Derived.{
        .directory = DERIVED,
        .idlList = "mlx-out/webkit/generated/WebCore-idl-files.txt",
        .defines = config.WPE_FEATURE_DEFINES,
        .name = "webkit-webcore-derived",
        .description = "the sources WebCore's build generates (WPE), made by its generators in Mlx",
        .prefix = "webcore/",
        .lists = "Sources.txt\nplatform/SourcesAdwaita.txt\nplatform/SourcesGCrypt.txt\nplatform/SourcesSkia.txt\nplatform/SourcesSoup.txt\nSourcesWPE.txt\nplatform/SourcesGLib.txt\n",
        .skipped = "",
        .atspi = true,
        .dense = "JS*=JSBindings\nbindings/*=JSBindings\n",
        .settings = "",
    }
}

// The Mlx port's (PORT.md): its feature defines; Sources.txt, the Skia and
// Adwaita lists of platform/ but what lists/webcore-mlx-skipped.txt names,
// WebKit's sources other ports' CMake files add that fit
// (lists/webcore-mlx-sources.txt, as PlatformHaiku.cmake's) and the port's
// own (projects/webkit/port/SourcesMlx.txt).
pub fn mlx() -> Derived {
    return Derived.{
        .directory = "mlx-out/webkit/mlx/generated/WebCore/DerivedSources",
        .idlList = "mlx-out/webkit/mlx/generated/WebCore-idl-files.txt",
        .defines = config.MLX_FEATURE_DEFINES,
        .name = "webkit-mlx-webcore-derived",
        .description = "the sources WebCore's build generates (Mlx), made by its generators in Mlx",
        .prefix = "mlx-webcore-derived/",
        .lists = "Sources.txt\nplatform/SourcesAdwaita.txt\nplatform/SourcesSkia.txt\nprojects/webkit/lists/webcore-mlx-sources.txt\nprojects/webkit/port/SourcesMlx.txt\n",
        .skipped = "projects/webkit/lists/webcore-mlx-skipped.txt",
        .atspi = false,
        // (bindings/js in bundles of 8, of their directory: their dense
        // bundle, 64 sources, takes mlx-cc beyond its 8 GB arena.)
        .dense = "JS*=JSBindings\n",
        .settings = "projects/webkit/port/MlxSettings.yaml",
    }
}

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

// The generated file NAME.
fn derived(b: *Build.Builder, c: Context, name: []const u8) -> []const u8 { return join3(b, c.d.directory, "/", name) }

// The generated files NAMES (separated by spaces), a path a line.
fn derivedLines(b: *Build.Builder, c: Context, names: []const u8) -> []const u8 {
    var text = ""
    var start: usize = 0
    while start < names.length {
        var end = start
        while end < names.length && names[end] != 32 { end += 1 }
        if end > start { text = join3(b, text, derived(b, c, names[start..end]), "\n") }
        start = end + 1
    }
    return text
}

// The last part of PATH.
fn baseName(path: []const u8) -> []const u8 {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    return path[start..path.length]
}

// The paths of the list LIST (lines of paths under DIRECTORY), joined by
// SEPARATOR, each with SEPARATOR before it. (Put together in a buffer:
// the list of the IDL files joined a path at a time would fill the
// build's text with its copies.)
fn listed(b: *Build.Builder, list: []const u8, directory: []const u8, separator: []const u8) -> []const u8 {
    const listing = Build.readText(b, Build.concat(b, "projects/webkit/lists/", list))
    if listing.length == 0 { Build.fail(b, "an empty or missing list", list) }
    var buffer: [524288]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &buffer) }
    var length: usize = 0
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        if length + separator.length + directory.length + path.length + 1 > 524288 {
            Build.fail(b, "a list too long to be put together", list)
            break
        }
        length = std.text.append(bytes, length, 524288, separator)
        length = std.text.append(bytes, length, 524288, directory)
        length = std.text.append(bytes, length, 524288, "/")
        length = std.text.append(bytes, length, 524288, path)
    }
    return Build.concat(b, bytes[0..length], "")
}

// The port's generated sources, the generators and where WebCore's sources
// are.
const Context = struct {
    d: Derived
    group: Build.Step
    // Whether the generators are declared here (the first port's steps) or
    // were already (the others').
    declare: bool
    // Source/WebCore of the tree.
    webcore: []const u8
    source: []const u8
}

// The program mlx-out/bin/NAME of projects/webkit/generators/ROOT.
fn generator(b: *Build.Builder, c: Context, name: []const u8, root: []const u8) -> Build.Step {
    const step = if c.declare { Build.program(b, name, Build.concat(b, "projects/webkit/generators/", root)) } else { Build.step(b, name) }
    Build.add(b, c.group, step)
    return step
}

// A step running the program NAME (made by PROGRAM) with ARGUMENTS, making
// the files OUTPUTS (a path a line; the first stands for the step) of the
// files INPUTS (likewise, at most fifteen).
fn run(b: *Build.Builder, c: Context, program: Build.Step, name: []const u8, arguments: []const u8, outputs: []const u8, inputs: []const u8) -> Build.Step {
    const path = Build.concat(b, "mlx-out/bin/", name)
    var at: usize = 0
    const first = Build.nextLine(outputs, &at)
    const step = Build.command(b, Build.concat(b, c.d.prefix, baseName(first)), first, join3(b, path, " ", arguments))
    at = 0
    while at < inputs.length {
        const input = Build.nextLine(inputs, &at)
        if input.length > 0 { Build.input(b, step, input) }
    }
    Build.input(b, step, path)
    Build.dependOn(b, step, program)
    Build.add(b, c.group, step)
    return step
}

// gperf on the generated NAME.gperf with OPTIONS, run in the port's
// generated sources as the scripts run it (the command line its output
// repeats names the files from there), after the step that writes it.
fn gperf(b: *Build.Builder, c: Context, program: Build.Step, writer: Build.Step, name: []const u8, options: []const u8) -> void {
    const input = derived(b, c, Build.concat(b, name, ".gperf"))
    var line = join3(b, "--program-name=/usr/bin/gperf --directory=", c.d.directory, " --key-positions=* ")
    line = join3(b, line, options, join3(b, " --output-file=", name, ".cpp "))
    line = join3(b, line, name, ".gperf")
    const step = run(b, c, program, "webkit-gperf", line, derived(b, c, Build.concat(b, name, ".cpp")), input)
    Build.dependOn(b, step, writer)
}

// CSS: the properties, the value keywords and the pseudo-selectors (and
// gperf's lookups of them), the user agent's style sheets and scripts as
// arrays, the XML viewer's style sheet and script made small.
fn css(b: *Build.Builder, c: Context, gperfProgram: Build.Step) -> Build.Step {
    const w = c.webcore
    const defines = c.d.defines
    const properties = generator(b, c, "webkit-css-properties", "cssproperties.mlx")
    const json = Build.concat(b, w, "/css/CSSProperties.json")
    var outputs = derivedLines(b, c, "CSSPropertyNames.gperf CSSProperties.json CSSPropertyInitialValuesGeneratedInlines.h CSSPropertyNames.h CSSPropertyParsing.h CSSPropertyParsing.cpp")
    outputs = Build.concat(b, outputs, derivedLines(b, c, "CSSStyleProperties+PropertyNames.idl StyleBuilderGenerated.cpp StyleChangedAnimatablePropertiesGenerated.cpp StyleComputedStyleProperties.h StyleComputedStyleProperties.cpp"))
    outputs = Build.concat(b, outputs, derivedLines(b, c, "StyleExtractorGenerated.cpp StyleInterpolationWrapperMap.h StyleInterpolationWrapperMap.cpp StylePropertyShorthandFunctions.h StylePropertyShorthandFunctions.cpp"))
    const propertiesStep = run(b, c, properties, "webkit-css-properties", join3(b, join3(b, "--defines \"", defines, " \" "), c.d.directory, Build.concat(b, " ", json)), outputs, json)
    gperf(b, c, gperfProgram, propertiesStep, "CSSPropertyNames", "-D -n -s 2")

    const values = generator(b, c, "webkit-css-values", "cssvalues.mlx")
    const keywords = join3(b, w, "/css/CSSValueKeywords.in ", Build.concat(b, w, "/css/SVGCSSValueKeywords.in"))
    var line = join3(b, join3(b, "--defines \"", defines, " \" "), c.d.directory, Build.concat(b, " ", keywords))
    const inputs = join3(b, w, "/css/CSSValueKeywords.in\n", Build.concat(b, w, "/css/SVGCSSValueKeywords.in"))
    const valuesStep = run(b, c, values, "webkit-css-values", line, derivedLines(b, c, "CSSValueKeywords.gperf CSSValueKeywords.in CSSValueKeywords.h"), inputs)
    gperf(b, c, gperfProgram, valuesStep, "CSSValueKeywords", "-D -n -s 2")

    const selectors = generator(b, c, "webkit-css-pseudo-selectors", "cssselectors.mlx")
    const selectorsJson = Build.concat(b, w, "/css/CSSPseudoSelectors.json")
    line = join3(b, join3(b, "--defines \"", defines, "\" "), c.d.directory, Build.concat(b, " ", selectorsJson))
    outputs = derivedLines(b, c, "SelectorPseudoElementMap.gperf SelectorPseudoClassAndCompatibilityElementMap.gperf CSSPseudoSelectors.json CSSSelectorEnums.h CSSSelectorInlines.h UserAgentParts.cpp UserAgentParts.h")
    const selectorsStep = run(b, c, selectors, "webkit-css-pseudo-selectors", line, outputs, selectorsJson)
    gperf(b, c, gperfProgram, selectorsStep, "SelectorPseudoClassAndCompatibilityElementMap", "-m 10 -s 2")
    gperf(b, c, gperfProgram, selectorsStep, "SelectorPseudoElementMap", "-m 10 -s 2")

    // The media controls' style sheets and scripts put together (CMake's
    // `cmake -E cat`).
    const cat = generator(b, c, "webkit-cat", "csscat.mlx")
    const controls = Build.concat(b, w, "/Modules/modern-media-controls")
    const controlsCss = derived(b, c, "ModernMediaControls.css")
    const catCss = run(b, c, cat, "webkit-cat", Build.concat(b, controlsCss, listed(b, "webcore-media-controls-css.txt", w, " ")), controlsCss, "")
    Build.inputTree(b, catCss, controls, ".css")
    const controlsJs = derived(b, c, "ModernMediaControls.js")
    const catJs = run(b, c, cat, "webkit-cat", Build.concat(b, controlsJs, listed(b, "webcore-media-controls-js.txt", w, " ")), controlsJs, "")
    Build.inputTree(b, catJs, controls, ".js")

    const arrays = generator(b, c, "webkit-css-file-arrays", "cssarrays.mlx")
    line = join3(b, "--defines \"", defines, "\" ")
    line = join3(b, line, derived(b, c, "UserAgentStyleSheets.h "), derived(b, c, "UserAgentStyleSheetsData.cpp"))
    line = join3(b, line, listed(b, "webcore-user-agent-style-sheets.txt", w, " "), Build.concat(b, " ", controlsCss))
    const sheets = run(b, c, arrays, "webkit-css-file-arrays", line, derivedLines(b, c, "UserAgentStyleSheetsData.cpp UserAgentStyleSheets.h"), controlsCss)
    Build.inputTree(b, sheets, Build.concat(b, w, "/css"), ".css")
    Build.inputTree(b, sheets, Build.concat(b, w, "/html/shadow"), ".css")
    Build.dependOn(b, sheets, catCss)
    const scriptArrays = generator(b, c, "webkit-js-file-arrays", "cssjsarrays.mlx")
    line = join3(b, "--fail-if-non-ascii -n WebCore ", derived(b, c, "UserAgentScripts.h "), derived(b, c, "UserAgentScriptsData.cpp "))
    const scripts = run(b, c, scriptArrays, "webkit-js-file-arrays", Build.concat(b, line, controlsJs), derivedLines(b, c, "UserAgentScriptsData.cpp UserAgentScripts.h"), controlsJs)
    Build.dependOn(b, scripts, catJs)

    const xxd = generator(b, c, "webkit-xxd", "cssxxd.mlx")
    const cssmin = generator(b, c, "webkit-cssmin", "cssmin.mlx")
    const viewerCss = Build.concat(b, w, "/xml/XMLViewer.css")
    const minCss = derived(b, c, "XMLViewer.min.css")
    const smallCss = run(b, c, cssmin, "webkit-cssmin", join3(b, viewerCss, " ", minCss), minCss, viewerCss)
    const cssArray = run(b, c, xxd, "webkit-xxd", join3(b, "XMLViewer_css ", minCss, Build.concat(b, " ", derived(b, c, "XMLViewerCSS.h"))), derived(b, c, "XMLViewerCSS.h"), minCss)
    Build.dependOn(b, cssArray, smallCss)
    const jsmin = generator(b, c, "webkit-jsmin", "cssjsmin.mlx")
    const viewerJs = Build.concat(b, w, "/xml/XMLViewer.js")
    const minJs = derived(b, c, "XMLViewer.min.js")
    const smallJs = run(b, c, jsmin, "webkit-jsmin", join3(b, viewerJs, " ", minJs), minJs, viewerJs)
    const jsArray = run(b, c, xxd, "webkit-xxd", join3(b, "XMLViewer_js ", minJs, Build.concat(b, " ", derived(b, c, "XMLViewerJS.h"))), derived(b, c, "XMLViewerJS.h"), minJs)
    Build.dependOn(b, jsArray, smallJs)
    return propertiesStep
}

// The names of elements, attributes and fonts (make_names.pl), of events
// and their factories, of HTTP headers, the HTML entities, the colors.
fn names(b: *Build.Builder, c: Context, gperfProgram: Build.Step) -> void {
    const w = c.webcore
    const program = generator(b, c, "webkit-make-names", "names.mlx")
    const namespaces = [3][]const u8{ "HTML", "MathML", "SVG" }
    const tags = [3][]const u8{ "/html/HTMLTagNames.in", "/mathml/mathtags.in", "/svg/svgtags.in" }
    const attributes = [3][]const u8{ "/html/HTMLAttributeNames.in", "/mathml/mathattrs.in", "/svg/svgattrs.in" }
    var index: usize = 0
    while index < 3 {
        const attrs = Build.concat(b, w, attributes[index])
        const elements = Build.concat(b, w, tags[index])
        var line = join3(b, join3(b, "--outputDir ", c.d.directory, " --attrs "), attrs, join3(b, " --elements ", elements, " --factory --wrapperFactory"))
        const n = namespaces[index]
        var outputs = derived(b, c, Build.concat(b, n, "Names.cpp\n"))
        const others = [6][]const u8{ "Names.h", "ElementFactory.cpp", "ElementFactory.h", "ElementTypeHelpers.h", "ElementWrapperFactory.cpp", "ElementWrapperFactory.h" }
        var k: usize = 0
        for other in others {
            const name = if k >= 4 { join3(b, "JS", n, other) } else { Build.concat(b, n, other) }
            outputs = join3(b, outputs, derived(b, c, name), "\n")
            k += 1
        }
        _ = run(b, c, program, "webkit-make-names", line, outputs, join3(b, attrs, "\n", elements))
        index += 1
    }
    const fonts = Build.concat(b, w, "/css/WebKitFontFamilyNames.in")
    _ = run(b, c, program, "webkit-make-names", join3(b, join3(b, "--outputDir ", c.d.directory, " --fonts "), fonts, ""), derivedLines(b, c, "WebKitFontFamilyNames.cpp WebKitFontFamilyNames.h"), fonts)
    const attributeOnly = [3][]const u8{ "/svg/xlinkattrs.in", "/xml/xmlnsattrs.in", "/xml/xmlattrs.in" }
    const attributeNamespaces = [3][]const u8{ "XLink", "XMLNS", "XML" }
    index = 0
    while index < 3 {
        const attrs = Build.concat(b, w, attributeOnly[index])
        const n = attributeNamespaces[index]
        const outputs = join3(b, derived(b, c, Build.concat(b, n, "Names.cpp\n")), derived(b, c, Build.concat(b, n, "Names.h\n")), derived(b, c, Build.concat(b, n, "ElementTypeHelpers.h")))
        _ = run(b, c, program, "webkit-make-names", join3(b, join3(b, "--outputDir ", c.d.directory, " --attrs "), attrs, ""), outputs, attrs)
        index += 1
    }
    // The enumerations of every namespace's names.
    var all = ""
    var inputs = ""
    const elementFiles = [3][]const u8{ "/html/HTMLTagNames.in", "/svg/svgtags.in", "/mathml/mathtags.in" }
    for file in elementFiles {
        all = join3(b, all, " --elements ", Build.concat(b, w, file))
        inputs = join3(b, inputs, Build.concat(b, w, file), "\n")
    }
    const attributeFiles = [6][]const u8{ "/html/HTMLAttributeNames.in", "/mathml/mathattrs.in", "/svg/svgattrs.in", "/svg/xlinkattrs.in", "/xml/xmlattrs.in", "/xml/xmlnsattrs.in" }
    for file in attributeFiles {
        all = join3(b, all, " --attrs ", Build.concat(b, w, file))
        inputs = join3(b, inputs, Build.concat(b, w, file), "\n")
    }
    const enums = [3][]const u8{ "TagName", "NodeName", "Namespace" }
    for e in enums {
        const line = join3(b, join3(b, "--outputDir ", c.d.directory, " --enum "), e, all)
        _ = run(b, c, program, "webkit-make-names", line, join3(b, derived(b, c, Build.concat(b, e, ".cpp\n")), derived(b, c, Build.concat(b, e, ".h")), ""), inputs)
    }

    const events = generator(b, c, "webkit-event-names", "events.mlx")
    const eventNames = Build.concat(b, w, "/dom/EventNames.json")
    _ = run(b, c, events, "webkit-event-names", join3(b, "--event-names ", eventNames, Build.concat(b, " ", c.d.directory)), derivedLines(b, c, "EventNames.cpp EventNames.h"), eventNames)
    const factory = generator(b, c, "webkit-event-factory", "eventsfactory.mlx")
    const factories = [2][]const u8{ "EventInterfaces", "EventTargetFactory" }
    const prefixes = [2][]const u8{ "Event", "EventTarget" }
    index = 0
    while index < 2 {
        const input = join3(b, w, "/dom/", Build.concat(b, factories[index], ".in"))
        const p = prefixes[index]
        const outputs = join3(b, derived(b, c, Build.concat(b, p, "Factory.cpp\n")), derived(b, c, Build.concat(b, p, "Interfaces.h\n")), derived(b, c, Build.concat(b, p, "Headers.h")))
        _ = run(b, c, factory, "webkit-event-factory", join3(b, join3(b, "--input ", input, " --outputDir "), c.d.directory, ""), outputs, input)
        index += 1
    }

    const headers = generator(b, c, "webkit-http-header-names", "httpheaders.mlx")
    const headerNames = Build.concat(b, w, "/platform/network/HTTPHeaderNames.in")
    const headerStep = run(b, c, headers, "webkit-http-header-names", join3(b, headerNames, " ", c.d.directory), derivedLines(b, c, "HTTPHeaderNames.gperf HTTPHeaderNames.h HTTPHeaderNames.serialization.in"), headerNames)
    gperf(b, c, gperfProgram, headerStep, "HTTPHeaderNames", "-D -n -s 2")

    const entities = generator(b, c, "webkit-html-entity-table", "entities.mlx")
    const entityNames = Build.concat(b, w, "/html/parser/HTMLEntityNames.in")
    _ = run(b, c, entities, "webkit-html-entity-table", join3(b, "-o ", derived(b, c, "HTMLEntityTable.cpp "), entityNames), derived(b, c, "HTMLEntityTable.cpp"), entityNames)

    // make-hash-tools.pl's gperf: the colors, its output named as given
    // (the command line in its header shows the path).
    const colors = Build.concat(b, w, "/platform/ColorData.gperf")
    const colorData = derived(b, c, "ColorData.cpp")
    var line = join3(b, "--program-name=/usr/bin/gperf --key-positions=* -D -s 2 --output-file=", colorData, Build.concat(b, " ", colors))
    _ = run(b, c, gperfProgram, "webkit-gperf", line, colorData, colors)
}

// The settings, the log messages, the data kept in sync between
// processes, DOMJIT's abstract heaps, the AT-SPI interfaces.
fn various(b: *Build.Builder, c: Context) -> void {
    const w = c.webcore
    const settings = generator(b, c, "webkit-settings", "webcoresettings.mlx")
    const templates = Build.concat(b, w, "/Scripts/SettingsTemplates/")
    var line = Build.concat(b, "--outputDir ", c.d.directory)
    var inputs = ""
    const names = [5][]const u8{ "InternalSettingsGenerated.cpp.erb", "InternalSettingsGenerated.idl.erb", "InternalSettingsGenerated.h.erb", "Settings.cpp.erb", "Settings.h.erb" }
    for name in names {
        line = join3(b, line, " --template ", Build.concat(b, templates, name))
        inputs = join3(b, inputs, Build.concat(b, templates, name), "\n")
    }
    const preferences = Build.concat(b, c.source, "/WTF/Scripts/Preferences/UnifiedWebPreferences.yaml")
    const pageSettings = Build.concat(b, w, "/page/Settings.yaml")
    line = join3(b, line, " ", join3(b, preferences, " ", pageSettings))
    inputs = join3(b, inputs, preferences, join3(b, "\n", pageSettings, "\n"))
    if c.d.settings.length > 0 {
        line = join3(b, line, " ", c.d.settings)
        inputs = join3(b, inputs, c.d.settings, "\n")
    }
    _ = run(b, c, settings, "webkit-settings", line, derivedLines(b, c, "Settings.h Settings.cpp InternalSettingsGenerated.h InternalSettingsGenerated.cpp InternalSettingsGenerated.idl"), inputs)

    const log = generator(b, c, "webkit-log-declarations", "webcorelog.mlx")
    const messages = Build.concat(b, w, "/platform/LogMessages.in")
    line = join3(b, messages, " ", join3(b, derived(b, c, "WebCoreLogDefinitions.h"), " ", derived(b, c, "WebCoreVirtualLogFunctions.h")))
    _ = run(b, c, log, "webkit-log-declarations", line, derivedLines(b, c, "WebCoreLogDefinitions.h WebCoreVirtualLogFunctions.h"), messages)

    const sync = generator(b, c, "webkit-process-sync-data", "webcoresync.mlx")
    const prefixes = [2][]const u8{ "Document", "FrameTree" }
    for prefix in prefixes {
        const description = join3(b, w, "/page/", Build.concat(b, prefix, "SyncData.in"))
        var outputs = ""
        const suffixes = [5][]const u8{ "SyncData.cpp", "SyncData.h", "SyncClient.cpp", "SyncClient.h", "SyncData.serialization.in" }
        for suffix in suffixes { outputs = join3(b, outputs, derived(b, c, Build.concat(b, prefix, suffix)), "\n") }
        _ = run(b, c, sync, "webkit-process-sync-data", join3(b, prefix, " ", join3(b, description, " ", c.d.directory)), outputs, description)
    }

    const domjit = generator(b, c, "webkit-domjit-abstract-heap", "webcoredomjit.mlx")
    const heaps = Build.concat(b, w, "/domjit/DOMJITAbstractHeapRepository.yaml")
    const repository = derived(b, c, "DOMJITAbstractHeapRepository.h")
    _ = run(b, c, domjit, "webkit-domjit-abstract-heap", join3(b, heaps, " ", repository), repository, heaps)

    // gdbus-codegen, as the build runs it twice: the header, the body.
    if !c.d.atspi { return }
    const codegen = generator(b, c, "webkit-gdbus-codegen", "webcoreatspi.mlx")
    const interfaces = listed(b, "webcore-atspi.txt", w, " ")
    const xml = Build.concat(b, w, "/accessibility/atspi/xml")
    const header = derived(b, c, "AccessibilityAtspiInterfaces.h")
    line = join3(b, "--interface-prefix=org.a11y.atspi --c-namespace=webkit --pragma-once --interface-info-header --output=", header, interfaces)
    const headerStep = run(b, c, codegen, "webkit-gdbus-codegen", line, header, "")
    Build.inputTree(b, headerStep, xml, ".xml")
    const body = derived(b, c, "AccessibilityAtspiInterfaces.c")
    line = join3(b, "--interface-prefix=org.a11y.atspi --c-namespace=webkit --interface-info-body --output=", body, interfaces)
    const bodyStep = run(b, c, codegen, "webkit-gdbus-codegen", line, body, "")
    Build.inputTree(b, bodyStep, xml, ".xml")
}

// The JavaScript builtins of WebCore (generate-js-builtins.py): each
// object's own files, then the wrappers of them all. BUILTINS is the
// program, declared with JavaScriptCore's.
fn builtins(b: *Build.Builder, c: Context, program: Build.Step) -> void {
    const w = c.webcore
    const files = listed(b, "webcore-builtins.txt", w, "\n")
    var at: usize = 0
    while at < files.length {
        const file = Build.nextLine(files, &at)
        if file.length == 0 { continue }
        var stem = baseName(file)
        stem = stem[0..stem.length - 3]
        const outputs = join3(b, derived(b, c, Build.concat(b, stem, "Builtins.cpp\n")), derived(b, c, Build.concat(b, stem, "Builtins.h")), "")
        _ = run(b, c, program, "webkit-builtins", join3(b, join3(b, "--framework WebCore --output-directory ", c.d.directory, " "), file, ""), outputs, file)
    }
    var line = join3(b, "--wrappers-only --framework WebCore --output-directory ", c.d.directory, listed(b, "webcore-builtins.txt", w, " "))
    const step = run(b, c, program, "webkit-builtins", line, derivedLines(b, c, "WebCoreJSBuiltins.cpp WebCoreJSBuiltinInternals.cpp WebCoreJSBuiltins.h WebCoreJSBuiltinInternals.h"), "")
    const directories = [4][]const u8{ "/Modules", "/dom", "/bindings/js", "/inspector" }
    for directory in directories { Build.inputTree(b, step, Build.concat(b, w, directory), ".js") }
}

// The JavaScript bindings of the IDL files (generate-bindings-all.pl):
// lists/webcore-idl.txt's, then CSSStyleProperties+PropertyNames.idl,
// which PROPERTIES makes. The global objects' constructors and the
// IsoSubspace headers are preprocess-idls.pl's (--ppExtraArgs).
fn bindings(b: *Build.Builder, c: Context, properties: Build.Step) -> void {
    const w = c.webcore
    const program = generator(b, c, "webkit-generate-bindings", "bindings.mlx")
    const generatedIdl = derived(b, c, "CSSStyleProperties+PropertyNames.idl")
    const idlFiles = listed(b, "webcore-idl.txt", w, "\n")
    if idlFiles.length == 0 { return }
    _ = Build.writeText(b, c.d.idlList, join3(b, idlFiles[1..idlFiles.length], "\n", Build.concat(b, generatedIdl, "\n")))
    const attributes = Build.concat(b, w, "/bindings/scripts/IDLAttributes.json")
    var line = join3(b, "--defines \"LANGUAGE_JAVASCRIPT ", c.d.defines, "\" --generator JS --outputDir ")
    line = join3(b, line, c.d.directory, join3(b, " --idlFilesList ", c.d.idlList, join3(b, " --idlFileNamesList ", c.d.idlList, " --ppIDLFilesList ")))
    line = join3(b, line, c.d.idlList, join3(b, " --idlAttributesFile ", attributes, " --ignoreStandaloneConstructorAttributes --supplementalDependencyFile "))
    // Four jobs, as the build ran it: the IDL files are generated in that
    // many batches, and what one learns of the others shows in its text.
    line = join3(b, line, derived(b, c, "supplemental_dependency.tmp"), " --numOfJobs 4")
    const extraOutputs = [10][]const u8{ "DOMIsoSubspaces.h", "DOMClientIsoSubspaces.h", "DOMConstructors.h", "DOMWindowConstructors.idl", "WorkerGlobalScopeConstructors.idl",
        "ShadowRealmGlobalScopeConstructors.idl", "DedicatedWorkerGlobalScopeConstructors.idl", "", "", "" }
    for name in extraOutputs {
        if name.length > 0 { line = join3(b, line, " --ppExtraOutput ", derived(b, c, name)) }
    }
    const options = [13][]const u8{ "isoSubspacesHeaderFile", "clientISOSubspacesHeaderFile", "constructorsHeaderFile", "windowConstructorsFile", "workerGlobalScopeConstructorsFile",
        "shadowRealmGlobalScopeConstructorsFile", "dedicatedWorkerGlobalScopeConstructorsFile", "serviceWorkerGlobalScopeConstructorsFile", "sharedWorkerGlobalScopeConstructorsFile",
        "workletGlobalScopeConstructorsFile", "paintWorkletGlobalScopeConstructorsFile", "audioWorkletGlobalScopeConstructorsFile", "" }
    const files = [13][]const u8{ "DOMIsoSubspaces.h", "DOMClientIsoSubspaces.h", "DOMConstructors.h", "DOMWindowConstructors.idl", "WorkerGlobalScopeConstructors.idl",
        "ShadowRealmGlobalScopeConstructors.idl", "DedicatedWorkerGlobalScopeConstructors.idl", "ServiceWorkerGlobalScopeConstructors.idl", "SharedWorkerGlobalScopeConstructors.idl",
        "WorkletGlobalScopeConstructors.idl", "PaintWorkletGlobalScopeConstructors.idl", "AudioWorkletGlobalScopeConstructors.idl", "" }
    var index: usize = 0
    while index < 13 {
        if options[index].length > 0 { line = join3(b, line, join3(b, " --ppExtraArgs --", options[index], " --ppExtraArgs "), derived(b, c, files[index])) }
        index += 1
    }
    const step = run(b, c, program, "webkit-generate-bindings", line, derived(b, c, "supplemental_dependency.tmp"), join3(b, c.d.idlList, "\n", join3(b, attributes, "\n", generatedIdl)))
    Build.inputTree(b, step, w, ".idl")
    Build.dependOn(b, step, properties)
    // What CMake touches when the bindings are made (made here with the
    // steps, as it holds nothing).
    _ = Build.writeText(b, derived(b, c, "WebCoreBindings.stamp"), "")
}

// Whether SKIPPED (`PATH REASON` lines) names PATH.
fn isSkipped(skipped: []const u8, path: []const u8) -> bool {
    var at: usize = 0
    while at < skipped.length {
        const line = Build.nextLine(skipped, &at)
        if line.length <= path.length { continue }
        if line[path.length] == 32 && std.text.same(line[0..path.length], path) { return true }
    }
    return false
}

// The source list TEXT (Sources.txt's form: a path and its attributes a
// line, `//` comments) without the sources SKIPPED names. (Put together in
// a buffer, as `listed`.)
fn withoutSkipped(b: *Build.Builder, text: []const u8, skipped: []const u8) -> []const u8 {
    if skipped.length == 0 { return text }
    var buffer: [524288]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &buffer) }
    var length: usize = 0
    var at: usize = 0
    while at < text.length {
        const line = Build.nextLine(text, &at)
        var end: usize = 0
        while end < line.length && line[end] != 32 && line[end] != 9 { end += 1 }
        if end > 0 && isSkipped(skipped, line[0..end]) { continue }
        if length + line.length + 1 > 524288 {
            Build.fail(b, "a source list too long to be put together", line)
            break
        }
        length = std.text.append(bytes, length, 524288, line)
        length = std.text.append(bytes, length, 524288, "\n")
    }
    return Build.concat(b, bytes[0..length], "")
}

// The port's source lists (D.lists; WEBCORE is Source/WebCore of the
// tree), copied as CMake copies them (without what D.skipped names), and
// their unified sources (the bindings' JS*.cpp, among the generated
// sources, in the dense JSBindings bundles): what to compile, a path a
// line (unified.bundle's), which build.mlx's WebCore steps compile. A list
// of the checkout's (projects/...) is copied under its file's name.
pub fn unifiedSources(b: *Build.Builder, d: Derived, webcore: []const u8) -> []const u8 {
    const skipped = if d.skipped.length > 0 { Build.readText(b, d.skipped) } else { "" }
    var copies = ""
    var at: usize = 0
    while at < d.lists.length {
        const list = Build.nextLine(d.lists, &at)
        if list.length == 0 { continue }
        const ours = list.length > 9 && std.text.same(list[0..9], "projects/")
        const copy = join3(b, d.directory, "/", if ours { baseName(list) } else { list })
        const text = Build.readText(b, if ours { list } else { join3(b, webcore, "/", list) })
        if text.length == 0 { Build.fail(b, "an empty or missing source list", list) }
        _ = Build.writeText(b, copy, withoutSkipped(b, text, skipped))
        copies = join3(b, copies, copy, "\n")
    }
    const options = unified.Options.{ .maxBundleSize = 8, .enforceCost = false, .denseFilters = d.dense }
    return unified.bundle(b, copies, join3(b, d.directory, "/", "unified-sources"), webcore, d.directory, options)
}

// What WebCore's build generates for the port D (SOURCE is Source/ of the
// tree). The first port's steps (DECLARE) declare the generators, the
// others' run them too.
pub fn webcoreDerived(b: *Build.Builder, d: Derived, source: []const u8, declare: bool) -> Build.Step {
    const group = Build.group(b, d.name, d.description)
    const c = Context.{ .d = d, .group = group, .declare = declare, .webcore = Build.concat(b, source, "/WebCore"), .source = source }
    _ = unifiedSources(b, d, c.webcore)
    const gperfProgram = generator(b, c, "webkit-gperf", "gperf.mlx")
    const properties = css(b, c, gperfProgram)
    names(b, c, gperfProgram)
    various(b, c)
    const builtinsProgram = Build.step(b, "webkit-builtins")
    Build.add(b, group, builtinsProgram)
    builtins(b, c, builtinsProgram)
    bindings(b, c, properties)
    return group
}
