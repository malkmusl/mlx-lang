// The files of file: URLs (the loader strategy of the port's embedding,
// MlxPlatformStrategies.cpp): a file read whole with std.fs into the C
// library's heap, which the C++ side gives to WebCore's ResourceLoader as
// the response's data.
const std = @import("std")

extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void

// What read answers besides the file: the file is not there (or is no
// regular file), or it could not be read (permissions, memory).
pub const NOT_FOUND: u32 = 1
pub const NOT_READ: u32 = 2

// A file read: its bytes on the C heap and their count.
const Contents = struct {
    bytes: usize
    length: usize
}

fn contentsAt(address: usize) -> *Contents { return unsafe { @ptrFromInt(*Contents, address) } }

const S_IFMT: u32 = 0o170000
const S_IFREG: u32 = 0o100000
const ENOENT: isize = -2
const ENOTDIR: isize = -20

// The file at PATH (a C string) read whole; 0 when it cannot be, with why
// in REASON (NOT_FOUND or NOT_READ).
pub fn read(path: usize, reason: *u32) -> usize {
    reason.* = NOT_READ
    if path == 0 { return 0 }
    const name: [*]const u8 = unsafe { @ptrFromInt([*]const u8, path) }
    const file = std.fs.open(name, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) {
        if file.descriptor == ENOENT || file.descriptor == ENOTDIR { reason.* = NOT_FOUND }
        return 0
    }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(file, &status) != 0 || (status.mode & S_IFMT) != S_IFREG {
        _ = std.fs.close(file)
        reason.* = NOT_FOUND
        return 0
    }
    const size = @intCast(usize, status.size)
    const bytes = malloc(if size == 0 { 1 } else { size })
    const address = malloc(@sizeOf(Contents))
    if bytes == 0 || address == 0 {
        if bytes != 0 { free(bytes) }
        if address != 0 { free(address) }
        _ = std.fs.close(file)
        return 0
    }
    var done: usize = 0
    var ok = true
    while done < size {
        const count = std.fs.read(file, unsafe { @ptrFromInt([*]u8, bytes + done) }, size - done)
        if count < 0 {
            ok = false
            break
        }
        if count == 0 { break }
        done += @intCast(usize, count)
    }
    _ = std.fs.close(file)
    if !ok {
        free(bytes)
        free(address)
        return 0
    }
    contentsAt(address).*.bytes = bytes
    contentsAt(address).*.length = done
    reason.* = 0
    return address
}

pub fn bytes(contents: usize) -> usize { return if contents == 0 { 0 } else { contentsAt(contents).*.bytes } }
pub fn length(contents: usize) -> usize { return if contents == 0 { 0 } else { contentsAt(contents).*.length } }

pub fn release(contents: usize) -> void {
    if contents == 0 { return }
    free(contentsAt(contents).*.bytes)
    free(contents)
}
