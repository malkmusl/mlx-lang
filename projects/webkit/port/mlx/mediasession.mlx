// Voyager as a media player on MLXIPC, for the desktop's media controls
// (the top bar's play/pause button, "Title – Artist", the popup with
// previous/next and the track's position): the MPRIS interfaces
// org.mpris.MediaPlayer2 and org.mpris.MediaPlayer2.Player at
// /org/mpris/MediaPlayer2 under the name org.mpris.MediaPlayer2.voyager,
// spoken to the bus in MLXIPC's own format (std.ipc; the bus carries
// them to its D-Bus clients). The port's C++ (MediaSessionMlx) tells
// what plays (sessionUpdate, from WebCore's now-playing information)
// and polls the bus from its main thread (sessionPoll): the calls that
// came are answered, and the commands they carry (play, pause, next,
// seek, raise) are handed back for WebCore's media session (Raise:
// Voyager shows the tab that plays). The track's cover is written as a
// PNG file for the controls (sessionCover).
const std = @import("std")
const ipc = @import("std.ipc")
const environment_module = @import("./environment.mlx")
const png = @import("std.png")
extern("c") fn malloc(size: usize) -> usize
extern("c") fn getpid() -> i32
extern("c") fn free(address: usize) -> void

pub const STOPPED: u32 = 0
pub const PLAYING: u32 = 1
pub const PAUSED: u32 = 2

pub const COMMAND_NONE: u32 = 0
pub const COMMAND_PLAY: u32 = 1
pub const COMMAND_PAUSE: u32 = 2
pub const COMMAND_PLAY_PAUSE: u32 = 3
pub const COMMAND_STOP: u32 = 4
pub const COMMAND_NEXT: u32 = 5
pub const COMMAND_PREVIOUS: u32 = 6
pub const COMMAND_SEEK_TO: u32 = 7
pub const COMMAND_SEEK_BY: u32 = 8
pub const COMMAND_RAISE: u32 = 9

const NAME: []const u8 = "org.mpris.MediaPlayer2.voyager"
const PATH: []const u8 = "/org/mpris/MediaPlayer2"
const ROOT: []const u8 = "org.mpris.MediaPlayer2"
const PLAYER: []const u8 = "org.mpris.MediaPlayer2.Player"
const PROPERTIES: []const u8 = "org.freedesktop.DBus.Properties"
const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const TEXT: usize = 1024
const OUT: usize = 16384
const COMMANDS: usize = 8
// 1.0 as a double's bits.
const ONE: u64 = 4607182418800017408

const Session = struct {
    client: ipc.Client
    environment: environment_module.Vector
    out: [*]u8
    status: u32
    title: [TEXT]u8
    titleLength: usize
    artist: [TEXT]u8
    artistLength: usize
    album: [TEXT]u8
    albumLength: usize
    artUrl: [TEXT]u8
    artUrlLength: usize
    url: [TEXT]u8
    urlLength: usize
    // Microseconds.
    length: i64
    position: i64
    canSeek: bool
    canNext: bool
    canPrevious: bool
    // The cover written for the controls (sessionCover): its path, and
    // how many were written (each under a name of its own).
    coverPath: [TEXT]u8
    coverPathLength: usize
    coverCount: u32
    // Changes when the track does (mpris:trackid).
    track: u32
    commandKinds: [COMMANDS]u32
    commandTimes: [COMMANDS]i64
    commandCount: usize
}

fn sessionAt(address: usize) -> *Session { return unsafe { @ptrFromInt(*Session, address) } }

fn allocator() -> std.allocator.Allocator { return std.heap.allocator() }

fn same(first: []const u8, second: []const u8) -> bool { return ipc.same(first, second) }

fn textOf(bytes: [*]const u8, length: usize) -> []const u8 { return bytes[0..length] }

// Copies `length` bytes of `source` (at most TEXT) into `target`; true
// when they differ from what was there.
fn setText(target: [*]u8, targetLength: *usize, source: usize, length: usize) -> bool {
    var count = length
    if source == 0 { count = 0 }
    if count > TEXT { count = TEXT }
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, source) }
    var changed = count != targetLength.*
    var index: usize = 0
    while index < count {
        if !changed && target[index] != bytes[index] { changed = true }
        target[index] = bytes[index]
        index += 1
    }
    targetLength.* = count
    return changed
}

// Connects to the session bus and takes the player's name: a handle, 0
// without a bus (or the name taken by another Voyager).
pub fn sessionOpen() -> usize {
    const address = malloc(@sizeOf(Session))
    if address == 0 { return 0 }
    const s = sessionAt(address)
    s.*.out = unsafe { @ptrFromInt([*]u8, 0) }
    if !environment_module.read(&s.*.environment) {
        free(address)
        return 0
    }
    const out = malloc(OUT)
    if out == 0 {
        environment_module.release(&s.*.environment)
        free(address)
        return 0
    }
    s.*.out = unsafe { @ptrFromInt([*]u8, out) }
    if !ipc.connectSession(&s.*.client, allocator(), environment_module.entries(&s.*.environment)) {
        free(out)
        environment_module.release(&s.*.environment)
        free(address)
        return 0
    }
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, s.*.out, OUT)
    ipc.putString(&writing, NAME)
    // DO_NOT_QUEUE.
    ipc.putU32(&writing, 4)
    const serial = ipc.call(&s.*.client, BUS, BUS_PATH, BUS, "RequestName", "su", s.*.out, writing.length)
    var reply: ipc.Message = undefined
    var owned = false
    if serial != 0 && ipc.waitReply(&s.*.client, serial, &reply, 5000) && reply.kind == ipc.REPLY {
        var reading = ipc.reader(ipc.bodyOf(&s.*.client, &reply), reply.bodyLength)
        owned = ipc.readU32(&reading) == 1
    }
    if !owned {
        ipc.disconnect(&s.*.client, allocator())
        free(out)
        environment_module.release(&s.*.environment)
        free(address)
        return 0
    }
    s.*.status = STOPPED
    s.*.titleLength = 0
    s.*.artistLength = 0
    s.*.albumLength = 0
    s.*.artUrlLength = 0
    s.*.urlLength = 0
    s.*.length = 0
    s.*.position = 0
    s.*.canSeek = false
    s.*.canNext = false
    s.*.canPrevious = false
    s.*.coverPathLength = 0
    s.*.coverCount = 0
    s.*.track = 1
    s.*.commandCount = 0
    return address
}

pub fn sessionClose(address: usize) -> void {
    if address == 0 { return }
    const s = sessionAt(address)
    dropCover(s)
    ipc.disconnect(&s.*.client, allocator())
    free(@intFromPtr(s.*.out))
    environment_module.release(&s.*.environment)
    free(address)
}

// ---- The cover ----

// The directory for the cover: XDG_RUNTIME_DIR, else /tmp.
fn runtimeDir(s: *Session) -> []const u8 {
    const entries = environment_module.entries(&s.*.environment)
    const key: []const u8 = "XDG_RUNTIME_DIR="
    var index: usize = 0
    while entries[index] != unsafe { @ptrFromInt([*]const u8, 0) } {
        const entry = entries[index]
        var length: usize = 0
        while entry[length] != 0 { length += 1 }
        if length > key.length && same(entry[0..key.length], key) { return entry[key.length..length] }
        index += 1
    }
    return "/tmp"
}

fn appendText(target: [*]u8, length: *usize, text: []const u8) -> void {
    for byte in text {
        if length.* + 1 >= TEXT { return }
        target[length.*] = byte
        length.* += 1
    }
}

fn appendUnsigned(target: [*]u8, length: *usize, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest /= 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        if length.* + 1 >= TEXT { return }
        target[length.*] = digits[count]
        length.* += 1
    }
}

// Deletes the cover written last.
fn dropCover(s: *Session) -> void {
    if s.*.coverPathLength == 0 { return }
    s.*.coverPath[s.*.coverPathLength] = 0
    _ = std.fs.delete(&s.*.coverPath)
    s.*.coverPathLength = 0
}

// Writes the track's cover (`pixels`: premultiplied 0xAARRGGBB, rows
// `stride` words apart) as a PNG for the controls, which show a
// file:// one (the top bar loads a PNG once per path, so each cover
// gets a name of its own: $XDG_RUNTIME_DIR/voyager-cover-PID-N.png;
// the one before is deleted, the last on close). Writes its file://
// URL to `url` (`capacity` bytes) and returns the length, 0 when it
// could not be written.
pub fn sessionCover(address: usize, pixels: usize, width: usize, height: usize, stride: usize, url: usize, capacity: usize) -> usize {
    if address == 0 || pixels == 0 || width == 0 || height == 0 || width > 4096 || height > 4096 { return 0 }
    const s = sessionAt(address)
    var path: [TEXT]u8 = undefined
    var length: usize = 0
    appendText(&path, &length, runtimeDir(s))
    appendText(&path, &length, "/voyager-cover-")
    appendUnsigned(&path, &length, @intCast(u64, @intCast(u32, getpid())))
    appendText(&path, &length, "-")
    s.*.coverCount += 1
    appendUnsigned(&path, &length, @intCast(u64, s.*.coverCount))
    appendText(&path, &length, ".png")
    path[length] = 0
    const words: [*]const u32 = unsafe { @ptrFromInt([*]const u32, pixels) }
    if !png.saveFile(&path, words, width, height, stride, false, allocator()) { return 0 }
    dropCover(s)
    var index: usize = 0
    while index < length {
        s.*.coverPath[index] = path[index]
        index += 1
    }
    s.*.coverPathLength = length
    const prefix: []const u8 = "file://"
    if url == 0 || capacity < prefix.length + length + 1 { return 0 }
    const out: [*]u8 = unsafe { @ptrFromInt([*]u8, url) }
    var written: usize = 0
    for byte in prefix {
        out[written] = byte
        written += 1
    }
    index = 0
    while index < length {
        out[written] = path[index]
        written += 1
        index += 1
    }
    out[written] = 0
    return written
}

// ---- The properties ----

fn statusText(s: *Session) -> []const u8 {
    if s.*.status == PLAYING { return "Playing" }
    if s.*.status == PAUSED { return "Paused" }
    return "Stopped"
}

fn putVariantBool(writing: *ipc.Writer, value: bool) -> void { ipc.putVariantBool(writing, value) }

fn putVariantDoubleOne(writing: *ipc.Writer) -> void {
    ipc.putSignature(writing, "d")
    ipc.putU64(writing, ONE)
}

fn putVariantI64(writing: *ipc.Writer, value: i64) -> void {
    ipc.putSignature(writing, "x")
    ipc.putI64(writing, value)
}

fn putVariantStrings(writing: *ipc.Writer, text: []const u8) -> void {
    ipc.putSignature(writing, "as")
    const at = ipc.beginArray(writing)
    var count: usize = 0
    if text.length > 0 {
        ipc.putString(writing, text)
        count = 1
    }
    ipc.endArray(writing, at, count)
}

fn putEntryString(writing: *ipc.Writer, key: []const u8, value: []const u8) -> void {
    ipc.putString(writing, key)
    ipc.putVariantString(writing, value)
}

// Metadata (a{sv}) as a variant.
fn putMetadata(s: *Session, writing: *ipc.Writer) -> void {
    ipc.putSignature(writing, "a{sv}")
    const at = ipc.beginArray(writing)
    var count: usize = 0
    var track: [64]u8 = undefined
    var trackLength: usize = 0
    for byte in "/org/mlx/voyager/track/" {
        track[trackLength] = byte
        trackLength += 1
    }
    var digits: [12]u8 = undefined
    var digitCount: usize = 0
    var value = s.*.track
    while true {
        digits[digitCount] = @intCast(u8, 48 + value % 10)
        digitCount += 1
        value = value / 10
        if value == 0 { break }
    }
    while digitCount > 0 {
        digitCount -= 1
        track[trackLength] = digits[digitCount]
        trackLength += 1
    }
    const trackBytes: [*]const u8 = &track
    ipc.putString(writing, "mpris:trackid")
    ipc.putSignature(writing, "o")
    ipc.putString(writing, trackBytes[0..trackLength])
    count += 1
    if s.*.length > 0 {
        ipc.putString(writing, "mpris:length")
        putVariantI64(writing, s.*.length)
        count += 1
    }
    if s.*.titleLength > 0 {
        putEntryString(writing, "xesam:title", textOf(&s.*.title, s.*.titleLength))
        count += 1
    }
    if s.*.artistLength > 0 {
        ipc.putString(writing, "xesam:artist")
        putVariantStrings(writing, textOf(&s.*.artist, s.*.artistLength))
        count += 1
    }
    if s.*.albumLength > 0 {
        putEntryString(writing, "xesam:album", textOf(&s.*.album, s.*.albumLength))
        count += 1
    }
    if s.*.artUrlLength > 0 {
        putEntryString(writing, "mpris:artUrl", textOf(&s.*.artUrl, s.*.artUrlLength))
        count += 1
    }
    if s.*.urlLength > 0 {
        putEntryString(writing, "xesam:url", textOf(&s.*.url, s.*.urlLength))
        count += 1
    }
    ipc.endArray(writing, at, count)
}

// One property as a variant; false when there is no such property.
fn putProperty(s: *Session, writing: *ipc.Writer, interface: []const u8, name: []const u8) -> bool {
    if same(interface, ROOT) {
        if same(name, "CanQuit") { putVariantBool(writing, false) } else if same(name, "CanRaise") { putVariantBool(writing, true) } else if same(name, "HasTrackList") { putVariantBool(writing, false) } else if same(name, "Fullscreen") { putVariantBool(writing, false) } else if same(name, "CanSetFullscreen") { putVariantBool(writing, false) } else if same(name, "Identity") { ipc.putVariantString(writing, "Voyager") } else if same(name, "DesktopEntry") { ipc.putVariantString(writing, "org.mlx.voyager") } else if same(name, "SupportedUriSchemes") { putVariantStrings(writing, "") } else if same(name, "SupportedMimeTypes") { putVariantStrings(writing, "") } else { return false }
        return true
    }
    if same(interface, PLAYER) {
        if same(name, "PlaybackStatus") { ipc.putVariantString(writing, statusText(s)) } else if same(name, "LoopStatus") { ipc.putVariantString(writing, "None") } else if same(name, "Rate") { putVariantDoubleOne(writing) } else if same(name, "MinimumRate") { putVariantDoubleOne(writing) } else if same(name, "MaximumRate") { putVariantDoubleOne(writing) } else if same(name, "Volume") { putVariantDoubleOne(writing) } else if same(name, "Shuffle") { putVariantBool(writing, false) } else if same(name, "Metadata") { putMetadata(s, writing) } else if same(name, "Position") { putVariantI64(writing, s.*.position) } else if same(name, "CanGoNext") { putVariantBool(writing, s.*.canNext) } else if same(name, "CanGoPrevious") { putVariantBool(writing, s.*.canPrevious) } else if same(name, "CanPlay") { putVariantBool(writing, s.*.status != STOPPED) } else if same(name, "CanPause") { putVariantBool(writing, s.*.status != STOPPED) } else if same(name, "CanSeek") { putVariantBool(writing, s.*.canSeek) } else if same(name, "CanControl") { putVariantBool(writing, true) } else { return false }
        return true
    }
    return false
}

const ROOT_COUNT: usize = 9
const PLAYER_COUNT: usize = 15
// The properties a change of the playing state or the track changes.
const CHANGED_COUNT: usize = 7

fn rootProperty(index: usize) -> []const u8 {
    if index == 0 { return "CanQuit" }
    if index == 1 { return "CanRaise" }
    if index == 2 { return "HasTrackList" }
    if index == 3 { return "Fullscreen" }
    if index == 4 { return "CanSetFullscreen" }
    if index == 5 { return "Identity" }
    if index == 6 { return "DesktopEntry" }
    if index == 7 { return "SupportedUriSchemes" }
    return "SupportedMimeTypes"
}

fn playerProperty(index: usize) -> []const u8 {
    if index == 0 { return "PlaybackStatus" }
    if index == 1 { return "LoopStatus" }
    if index == 2 { return "Rate" }
    if index == 3 { return "MinimumRate" }
    if index == 4 { return "MaximumRate" }
    if index == 5 { return "Volume" }
    if index == 6 { return "Shuffle" }
    if index == 7 { return "Metadata" }
    if index == 8 { return "Position" }
    if index == 9 { return "CanGoNext" }
    if index == 10 { return "CanGoPrevious" }
    if index == 11 { return "CanPlay" }
    if index == 12 { return "CanPause" }
    if index == 13 { return "CanSeek" }
    return "CanControl"
}

fn changedProperty(index: usize) -> []const u8 {
    if index == 0 { return "PlaybackStatus" }
    if index == 1 { return "Metadata" }
    if index == 2 { return "CanGoNext" }
    if index == 3 { return "CanGoPrevious" }
    if index == 4 { return "CanPlay" }
    if index == 5 { return "CanPause" }
    return "CanSeek"
}

// All of an interface's properties as a{sv} (the array alone, no
// variant); false for an interface without any.
fn putAll(s: *Session, writing: *ipc.Writer, interface: []const u8) -> bool {
    const at = ipc.beginArray(writing)
    var count: usize = 0
    if same(interface, ROOT) {
        while count < ROOT_COUNT {
            const name = rootProperty(count)
            ipc.putString(writing, name)
            _ = putProperty(s, writing, interface, name)
            count += 1
        }
    } else if same(interface, PLAYER) {
        while count < PLAYER_COUNT {
            const name = playerProperty(count)
            ipc.putString(writing, name)
            _ = putProperty(s, writing, interface, name)
            count += 1
        }
    } else {
        ipc.endArray(writing, at, 0)
        return false
    }
    ipc.endArray(writing, at, count)
    return true
}

// PropertiesChanged(PLAYER, {the properties that changed}, []).
fn announce(s: *Session) -> void {
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, s.*.out, OUT)
    ipc.putString(&writing, PLAYER)
    const at = ipc.beginArray(&writing)
    var count: usize = 0
    while count < CHANGED_COUNT {
        const name = changedProperty(count)
        ipc.putString(&writing, name)
        _ = putProperty(s, &writing, PLAYER, name)
        count += 1
    }
    ipc.endArray(&writing, at, count)
    const none = ipc.beginArray(&writing)
    ipc.endArray(&writing, none, 0)
    _ = ipc.signal(&s.*.client, PATH, PROPERTIES, "PropertiesChanged", "sa{sv}as", s.*.out, writing.length)
}

// What plays now: the state, the track (strings as pointer and length;
// 0 for none), its length and position in microseconds, what the player
// can do. A change is announced on the bus; `seeked` says the position
// jumped (a seek), which is announced as such.
pub fn sessionUpdate(address: usize, status: u32, title: usize, titleLength: usize, artist: usize, artistLength: usize, album: usize, albumLength: usize, artUrl: usize, artUrlLength: usize, url: usize, urlLength: usize, length: i64, position: i64, canSeek: u32, canNext: u32, canPrevious: u32, seeked: u32) -> void {
    if address == 0 { return }
    const s = sessionAt(address)
    var changed = false
    var trackChanged = false
    if setText(&s.*.title, &s.*.titleLength, title, titleLength) { trackChanged = true }
    if setText(&s.*.artist, &s.*.artistLength, artist, artistLength) { trackChanged = true }
    if setText(&s.*.album, &s.*.albumLength, album, albumLength) { trackChanged = true }
    if setText(&s.*.artUrl, &s.*.artUrlLength, artUrl, artUrlLength) { trackChanged = true }
    if setText(&s.*.url, &s.*.urlLength, url, urlLength) { trackChanged = true }
    if s.*.length != length {
        s.*.length = length
        changed = true
    }
    if s.*.status != status {
        s.*.status = status
        changed = true
    }
    const seek = canSeek != 0
    const next = canNext != 0
    const previous = canPrevious != 0
    if s.*.canSeek != seek || s.*.canNext != next || s.*.canPrevious != previous {
        s.*.canSeek = seek
        s.*.canNext = next
        s.*.canPrevious = previous
        changed = true
    }
    if trackChanged {
        s.*.track += 1
        changed = true
    }
    s.*.position = position
    if changed { announce(s) }
    if seeked != 0 && !changed {
        var writing: ipc.Writer = undefined
        ipc.begin(&writing, s.*.out, OUT)
        ipc.putI64(&writing, position)
        _ = ipc.signal(&s.*.client, PATH, PLAYER, "Seeked", "x", s.*.out, writing.length)
    }
}

// ---- The calls ----

fn queue(s: *Session, kind: u32, time: i64) -> void {
    if s.*.commandCount >= COMMANDS { return }
    s.*.commandKinds[s.*.commandCount] = kind
    s.*.commandTimes[s.*.commandCount] = time
    s.*.commandCount += 1
}

fn replyEmpty(s: *Session, message: *const ipc.Message) -> void {
    if message.*.flags & ipc.NO_REPLY_EXPECTED != 0 { return }
    var nothing: [1]isize = [1]isize{ 0 }
    _ = ipc.reply(&s.*.client, message, "", s.*.out, 0, &nothing, 0)
}

fn replyBody(s: *Session, message: *const ipc.Message, signature: []const u8, length: usize) -> void {
    if message.*.flags & ipc.NO_REPLY_EXPECTED != 0 { return }
    var nothing: [1]isize = [1]isize{ 0 }
    _ = ipc.reply(&s.*.client, message, signature, s.*.out, length, &nothing, 0)
}

fn refuse(s: *Session, message: *const ipc.Message, name: []const u8, text: []const u8) -> void {
    if message.*.flags & ipc.NO_REPLY_EXPECTED != 0 { return }
    _ = ipc.replyError(&s.*.client, message, name, text)
}

const INTROSPECTION: []const u8 = "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\" \"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">\n<node><interface name=\"org.mpris.MediaPlayer2\"><method name=\"Raise\"/><method name=\"Quit\"/><property name=\"CanQuit\" type=\"b\" access=\"read\"/><property name=\"CanRaise\" type=\"b\" access=\"read\"/><property name=\"HasTrackList\" type=\"b\" access=\"read\"/><property name=\"Identity\" type=\"s\" access=\"read\"/><property name=\"DesktopEntry\" type=\"s\" access=\"read\"/><property name=\"SupportedUriSchemes\" type=\"as\" access=\"read\"/><property name=\"SupportedMimeTypes\" type=\"as\" access=\"read\"/></interface><interface name=\"org.mpris.MediaPlayer2.Player\"><method name=\"Next\"/><method name=\"Previous\"/><method name=\"Pause\"/><method name=\"PlayPause\"/><method name=\"Stop\"/><method name=\"Play\"/><method name=\"Seek\"><arg name=\"Offset\" type=\"x\" direction=\"in\"/></method><method name=\"SetPosition\"><arg name=\"TrackId\" type=\"o\" direction=\"in\"/><arg name=\"Position\" type=\"x\" direction=\"in\"/></method><method name=\"OpenUri\"><arg name=\"Uri\" type=\"s\" direction=\"in\"/></method><signal name=\"Seeked\"><arg name=\"Position\" type=\"x\"/></signal><property name=\"PlaybackStatus\" type=\"s\" access=\"read\"/><property name=\"LoopStatus\" type=\"s\" access=\"readwrite\"/><property name=\"Rate\" type=\"d\" access=\"readwrite\"/><property name=\"Shuffle\" type=\"b\" access=\"readwrite\"/><property name=\"Metadata\" type=\"a{sv}\" access=\"read\"/><property name=\"Volume\" type=\"d\" access=\"readwrite\"/><property name=\"Position\" type=\"x\" access=\"read\"/><property name=\"MinimumRate\" type=\"d\" access=\"read\"/><property name=\"MaximumRate\" type=\"d\" access=\"read\"/><property name=\"CanGoNext\" type=\"b\" access=\"read\"/><property name=\"CanGoPrevious\" type=\"b\" access=\"read\"/><property name=\"CanPlay\" type=\"b\" access=\"read\"/><property name=\"CanPause\" type=\"b\" access=\"read\"/><property name=\"CanSeek\" type=\"b\" access=\"read\"/><property name=\"CanControl\" type=\"b\" access=\"read\"/></interface><interface name=\"org.freedesktop.DBus.Properties\"><method name=\"Get\"><arg type=\"s\" direction=\"in\"/><arg type=\"s\" direction=\"in\"/><arg type=\"v\" direction=\"out\"/></method><method name=\"GetAll\"><arg type=\"s\" direction=\"in\"/><arg type=\"a{sv}\" direction=\"out\"/></method><method name=\"Set\"><arg type=\"s\" direction=\"in\"/><arg type=\"s\" direction=\"in\"/><arg type=\"v\" direction=\"in\"/></method><signal name=\"PropertiesChanged\"><arg type=\"s\"/><arg type=\"a{sv}\"/><arg type=\"as\"/></signal></interface></node>\n"

fn handle(s: *Session, message: *const ipc.Message) -> void {
    var reading = ipc.reader(ipc.bodyOf(&s.*.client, message), message.*.bodyLength)
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, s.*.out, OUT)
    const member = message.*.member
    if same(message.*.interface, PROPERTIES) {
        if same(member, "Get") && same(message.*.signature, "ss") {
            const interface = ipc.readString(&reading)
            const name = ipc.readString(&reading)
            if !putProperty(s, &writing, interface, name) {
                refuse(s, message, "org.freedesktop.DBus.Error.InvalidArgs", "no such property")
                return
            }
            replyBody(s, message, "v", writing.length)
            return
        }
        if same(member, "GetAll") && same(message.*.signature, "s") {
            const interface = ipc.readString(&reading)
            if !putAll(s, &writing, interface) {
                refuse(s, message, "org.freedesktop.DBus.Error.InvalidArgs", "no such interface")
                return
            }
            replyBody(s, message, "a{sv}", writing.length)
            return
        }
        if same(member, "Set") {
            // Volume, Rate, LoopStatus, Shuffle: taken without effect.
            replyEmpty(s, message)
            return
        }
    } else if same(message.*.interface, ROOT) {
        if same(member, "Raise") {
            queue(s, COMMAND_RAISE, 0)
            replyEmpty(s, message)
            return
        }
        if same(member, "Quit") {
            replyEmpty(s, message)
            return
        }
    } else if same(message.*.interface, PLAYER) {
        var kind = COMMAND_NONE
        var time: i64 = 0
        if same(member, "Play") { kind = COMMAND_PLAY } else if same(member, "Pause") { kind = COMMAND_PAUSE } else if same(member, "PlayPause") { kind = COMMAND_PLAY_PAUSE } else if same(member, "Stop") { kind = COMMAND_STOP } else if same(member, "Next") { kind = COMMAND_NEXT } else if same(member, "Previous") { kind = COMMAND_PREVIOUS } else if same(member, "Seek") && same(message.*.signature, "x") {
            kind = COMMAND_SEEK_BY
            time = ipc.readI64(&reading)
        } else if same(member, "SetPosition") && same(message.*.signature, "ox") {
            _ = ipc.readString(&reading)
            kind = COMMAND_SEEK_TO
            time = ipc.readI64(&reading)
        } else if same(member, "OpenUri") {
            replyEmpty(s, message)
            return
        }
        if kind != COMMAND_NONE {
            queue(s, kind, time)
            replyEmpty(s, message)
            return
        }
    } else if same(message.*.interface, "org.freedesktop.DBus.Peer") && same(member, "Ping") {
        replyEmpty(s, message)
        return
    } else if same(message.*.interface, "org.freedesktop.DBus.Introspectable") && same(member, "Introspect") {
        ipc.putString(&writing, INTROSPECTION)
        replyBody(s, message, "s", writing.length)
        return
    }
    refuse(s, message, "org.freedesktop.DBus.Error.UnknownMethod", "no such method")
}

// Answers what came from the bus and gives one command the controls
// sent (1, with its kind and time in microseconds stored), else 0.
// From the main thread, now and then.
pub fn sessionPoll(address: usize, kind: usize, time: usize) -> u32 {
    if address == 0 { return 0 }
    const s = sessionAt(address)
    var message: ipc.Message = undefined
    var taken: usize = 0
    while taken < 64 && ipc.next(&s.*.client, &message, 0) {
        if message.kind == ipc.CALL && same(message.path, PATH) { handle(s, &message) } else if message.kind == ipc.CALL && message.flags & ipc.NO_REPLY_EXPECTED == 0 { refuse(s, &message, "org.freedesktop.DBus.Error.UnknownObject", "no such object") }
        taken += 1
    }
    if s.*.commandCount == 0 { return 0 }
    const first = s.*.commandKinds[0]
    const firstTime = s.*.commandTimes[0]
    var index: usize = 1
    while index < s.*.commandCount {
        s.*.commandKinds[index - 1] = s.*.commandKinds[index]
        s.*.commandTimes[index - 1] = s.*.commandTimes[index]
        index += 1
    }
    s.*.commandCount -= 1
    if kind != 0 { unsafe { @ptrFromInt(*u32, kind).* = first } }
    if time != 0 { unsafe { @ptrFromInt(*i64, time).* = firstTime } }
    return 1
}

// Whether the bus connection still stands (the bus went: nothing more
// to do until it comes again).
pub fn sessionConnected(address: usize) -> u32 {
    if address == 0 { return 0 }
    return if sessionAt(address).*.client.closed { 0 } else { 1 }
}
