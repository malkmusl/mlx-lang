// Media for the port's MediaPlayerPrivateMlx (port/platform/graphics/mlx):
// MP4 files and MSE segments read by std.mp4, AAC decoded by std.aac,
// H.264 access units kept in order by std.h264 (parameter sets, picture
// order, the decoded picture buffer; the pictures' decoding is the GPU's
// through std.vulkan's video extensions, or none yet), and sound played
// through std.audio (MLX Audio). Every object lives on the C library's
// heap; a handle is its address.
const std = @import("std")
const mp4 = @import("std.mp4")
const aac = @import("std.aac")
const h264 = @import("std.h264")
const audio = @import("std.audio")
extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void
extern("c") fn getenv(name: [*]const u8) -> usize

// Statuses, as MlxWebPort.h numbers them.
pub const OK: u32 = 0
pub const NEED_MORE: u32 = 1
pub const CORRUPT: u32 = 2
pub const UNSUPPORTED: u32 = 3
pub const NO_MEMORY: u32 = 4

fn allocator() -> std.allocator.Allocator { return std.heap.allocator() }

// ---- The demuxer ----

const Demuxer = struct {
    movie: mp4.Movie
    samples: mp4.Samples
}

fn demuxerAt(address: usize) -> *Demuxer { return unsafe { @ptrFromInt(*Demuxer, address) } }

pub fn demuxerCreate() -> usize {
    const address = malloc(@sizeOf(Demuxer))
    if address == 0 { return 0 }
    const d = demuxerAt(address)
    mp4.init(&d.*.movie, allocator())
    mp4.initSamples(&d.*.samples, allocator())
    return address
}

pub fn demuxerDestroy(address: usize) -> void {
    if address == 0 { return }
    const d = demuxerAt(address)
    mp4.deinitSamples(&d.*.samples)
    mp4.deinit(&d.*.movie)
    free(address)
}

fn statusCode(status: mp4.Status) -> u32 {
    if status == mp4.Status.ok { return OK }
    if status == mp4.Status.needMore { return NEED_MORE }
    if status == mp4.Status.corrupt { return CORRUPT }
    if status == mp4.Status.unsupported { return UNSUPPORTED }
    return NO_MEMORY
}

// Parses bytes (a whole file, an initialization segment, or media
// segments): the status, and how many bytes were whole boxes in `used`.
// A fragment's samples are listed (sampleCount, sampleAt) until
// clearSamples.
pub fn demuxerParse(address: usize, bytes: usize, length: usize, used: usize) -> u32 {
    if address == 0 || bytes == 0 { return CORRUPT }
    const d = demuxerAt(address)
    const data: [*]const u8 = unsafe { @ptrFromInt([*]const u8, bytes) }
    var consumed: usize = 0
    const status = mp4.parse(&d.*.movie, data, length, &d.*.samples, &consumed)
    if used != 0 { unsafe { @ptrFromInt(*usize, used).* = consumed } }
    return statusCode(status)
}

pub fn trackCount(address: usize) -> usize {
    if address == 0 { return 0 }
    return demuxerAt(address).*.movie.trackCount
}

fn trackOf(address: usize, index: usize) -> ?*mp4.Track {
    if address == 0 { return null }
    const d = demuxerAt(address)
    if index >= d.*.movie.trackCount { return null }
    return mp4.track(&d.*.movie, index)
}

pub fn trackKind(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return @intCast(u32, track.?.*.kind)
}

pub fn trackCodec(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return @intCast(u32, track.?.*.codec)
}

pub fn trackTimescale(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return track.?.*.timescale
}

pub fn trackDuration(address: usize, index: usize) -> u64 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return track.?.*.duration
}

pub fn trackWidth(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return track.?.*.width
}

pub fn trackHeight(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return track.?.*.height
}

pub fn trackChannels(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return track.?.*.channels
}

pub fn trackRate(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return track.?.*.rate
}

pub fn trackEditMediaTime(address: usize, index: usize) -> u64 {
    const track = trackOf(address, index)
    if track == null { return 0 }
    return track.?.*.editMediaTime
}

pub fn trackNalLengthSize(address: usize, index: usize) -> u32 {
    const track = trackOf(address, index)
    if track == null { return 4 }
    return @intCast(u32, track.?.*.nalLengthSize)
}

// The codec configuration's bytes (avcC, AudioSpecificConfig, ...): the
// address, its length in `length`.
pub fn trackConfig(address: usize, index: usize, length: usize) -> usize {
    const track = trackOf(address, index)
    if track == null { return 0 }
    if length != 0 { unsafe { @ptrFromInt(*usize, length).* = track.?.*.configLength } }
    return @intFromPtr(&track.?.*.config)
}

// Parameter set `set` of an AVC/HEVC track: its address and length, 0
// when there is none.
pub fn trackParameterSet(address: usize, index: usize, set: usize, length: usize) -> usize {
    const track = trackOf(address, index)
    if track == null { return 0 }
    var bytes: []const u8 = undefined
    if !mp4.parameterSet(track.?, set, &bytes) { return 0 }
    if length != 0 { unsafe { @ptrFromInt(*usize, length).* = bytes.length } }
    return @intFromPtr(bytes.pointer)
}

// A sample as MlxWebPort.h lays it out.
pub const Sample = struct {
    offset: u64
    size: u64
    dts: u64
    pts: i64
    duration: u32
    track: u32
    sync: u32
    reserved: u32
}

fn storeSample(out: usize, sample: *const mp4.Sample) -> void {
    const target = unsafe { @ptrFromInt(*Sample, out) }
    target.*.offset = @intCast(u64, sample.*.offset)
    target.*.size = @intCast(u64, sample.*.size)
    target.*.dts = sample.*.dts
    target.*.pts = sample.*.pts
    target.*.duration = sample.*.duration
    target.*.track = @intCast(u32, sample.*.track)
    target.*.sync = if sample.*.sync { 1 } else { 0 }
    target.*.reserved = 0
}

// The next sample of a plain file's track into `out`; 0 at the end.
pub fn nextSample(address: usize, index: usize, out: usize) -> u32 {
    if address == 0 || out == 0 { return 0 }
    const d = demuxerAt(address)
    var sample: mp4.Sample = undefined
    if !mp4.nextSample(&d.*.movie, index, &sample) { return 0 }
    storeSample(out, &sample)
    return 1
}

pub fn seek(address: usize, index: usize, time: u64) -> void {
    if address == 0 { return }
    mp4.seek(&demuxerAt(address).*.movie, index, time)
}

pub fn sampleCount(address: usize) -> usize {
    if address == 0 { return 0 }
    return demuxerAt(address).*.samples.count
}

pub fn sampleAt(address: usize, index: usize, out: usize) -> u32 {
    if address == 0 || out == 0 { return 0 }
    const d = demuxerAt(address)
    if index >= d.*.samples.count { return 0 }
    storeSample(out, &d.*.samples.items[index])
    return 1
}

pub fn clearSamples(address: usize) -> void {
    if address == 0 { return }
    mp4.clearSamples(&demuxerAt(address).*.samples)
}

// A length-prefixed AVC/HEVC sample in Annex B form into `out`
// (capacity bytes): the bytes written, 0 when it does not fit or is
// damaged.
pub fn annexB(address: usize, index: usize, sample: usize, length: usize, out: usize, capacity: usize) -> usize {
    const track = trackOf(address, index)
    if track == null || sample == 0 || out == 0 { return 0 }
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, sample) }
    const target: [*]u8 = unsafe { @ptrFromInt([*]u8, out) }
    return mp4.annexB(track.?, bytes, length, target, capacity)
}

pub fn annexBSize(address: usize, index: usize, sample: usize, length: usize) -> usize {
    const track = trackOf(address, index)
    if track == null || sample == 0 { return 0 }
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, sample) }
    return mp4.annexBSize(track.?, bytes, length)
}

// ---- AAC ----

pub fn aacCreate(config: usize, length: usize) -> usize {
    const decoder = aac.create(allocator())
    if decoder == null { return 0 }
    const d = decoder.?
    if config != 0 && length != 0 {
        const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, config) }
        if aac.configure(d, bytes, length) != aac.Status.ok {
            aac.destroy(d)
            return 0
        }
    }
    return @intFromPtr(d)
}

pub fn aacDestroy(address: usize) -> void {
    if address == 0 { return }
    aac.destroy(unsafe { @ptrFromInt(*aac.Decoder, address) })
}

pub fn aacRate(address: usize) -> u32 {
    if address == 0 { return 0 }
    return unsafe { @ptrFromInt(*aac.Decoder, address) }.*.rate
}

pub fn aacReset(address: usize) -> void {
    if address == 0 { return }
    aac.reset(unsafe { @ptrFromInt(*aac.Decoder, address) })
}

// Decodes one block into `out` (room for 8 * 1024 floats, interleaved):
// the channels, 0 when the block is damaged.
pub fn aacDecode(address: usize, bytes: usize, length: usize, out: usize) -> u32 {
    if address == 0 || bytes == 0 || out == 0 { return 0 }
    const d = unsafe { @ptrFromInt(*aac.Decoder, address) }
    const data: [*]const u8 = unsafe { @ptrFromInt([*]const u8, bytes) }
    const samples: [*]f32 = unsafe { @ptrFromInt([*]f32, out) }
    if aac.decode(d, data, length, samples) != aac.Status.ok { return 0 }
    return @intCast(u32, d.*.channels)
}

// ---- H.264 ----

fn h264Status(status: h264.Status) -> u32 {
    if status == h264.Status.ok { return OK }
    if status == h264.Status.empty { return NEED_MORE }
    if status == h264.Status.corrupt { return CORRUPT }
    if status == h264.Status.unsupported { return UNSUPPORTED }
    return NO_MEMORY
}

pub fn h264Create() -> usize {
    const decoder = h264.create(allocator())
    if decoder == null { return 0 }
    return @intFromPtr(decoder.?)
}

pub fn h264Destroy(address: usize) -> void {
    if address == 0 { return }
    h264.destroy(unsafe { @ptrFromInt(*h264.Decoder, address) })
}

fn h264At(address: usize) -> *h264.Decoder { return unsafe { @ptrFromInt(*h264.Decoder, address) } }

pub fn h264ParameterSet(address: usize, bytes: usize, length: usize) -> u32 {
    if address == 0 || bytes == 0 { return CORRUPT }
    const data: [*]const u8 = unsafe { @ptrFromInt([*]const u8, bytes) }
    return h264Status(h264.parameterSet(h264At(address), data, length))
}

pub fn h264AccessUnit(address: usize, bytes: usize, length: usize, prefix: usize) -> u32 {
    if address == 0 || bytes == 0 { return CORRUPT }
    const data: [*]const u8 = unsafe { @ptrFromInt([*]const u8, bytes) }
    return h264Status(h264.accessUnit(h264At(address), data, length, prefix))
}

pub fn h264PictureSlot(address: usize) -> u32 {
    if address == 0 { return 0 }
    return @intCast(u32, h264At(address).*.picture.slot)
}

pub fn h264PicturePoc(address: usize) -> i32 {
    if address == 0 { return 0 }
    return h264At(address).*.picture.poc
}

pub fn h264PictureWidth(address: usize) -> u32 {
    if address == 0 { return 0 }
    return h264At(address).*.picture.width
}

pub fn h264PictureHeight(address: usize) -> u32 {
    if address == 0 { return 0 }
    return h264At(address).*.picture.height
}

pub fn h264FinishPicture(address: usize) -> void {
    if address == 0 { return }
    h264.finishPicture(h264At(address))
}

// The next picture to present: 1 with its slot and POC stored, 0 when
// none is due.
pub fn h264NextOutput(address: usize, slot: usize, poc: usize) -> u32 {
    if address == 0 { return 0 }
    var outSlot: usize = 0
    var outPoc: i32 = 0
    if !h264.nextOutput(h264At(address), &outSlot, &outPoc) { return 0 }
    if slot != 0 { unsafe { @ptrFromInt(*u32, slot).* = @intCast(u32, outSlot) } }
    if poc != 0 { unsafe { @ptrFromInt(*i32, poc).* = outPoc } }
    return 1
}

pub fn h264Flush(address: usize) -> void {
    if address == 0 { return }
    h264.flush(h264At(address))
}

// ---- Sound ----

const Output = struct {
    connection: audio.Audio
    stream: u32
    rate: u32
    channels: u32
    // Frames written so far.
    written: u64
    // "NAME=value" entries for the session bus, and their array.
    entries: [4]usize
    environment: [5]usize
}

fn outputAt(address: usize) -> *Output { return unsafe { @ptrFromInt(*Output, address) } }

// A "NAME=value" C string on the heap from the variable NAME; 0 when
// unset.
fn entry(name: []const u8) -> usize {
    var cname: [64]u8 = undefined
    var index: usize = 0
    while index < name.length && index < 63 {
        cname[index] = name[index]
        index += 1
    }
    cname[index] = 0
    const value = getenv(&cname)
    if value == 0 { return 0 }
    const valueBytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, value) }
    var valueLength: usize = 0
    while valueBytes[valueLength] != 0 { valueLength += 1 }
    const address = malloc(name.length + 1 + valueLength + 1)
    if address == 0 { return 0 }
    const out: [*]u8 = unsafe { @ptrFromInt([*]u8, address) }
    index = 0
    while index < name.length {
        out[index] = name[index]
        index += 1
    }
    out[index] = 61
    index += 1
    var j: usize = 0
    while j < valueLength {
        out[index + j] = valueBytes[j]
        j += 1
    }
    out[index + valueLength] = 0
    return address
}

// Opens a playback stream of 32-bit float frames at `rate` Hz with
// `channels` channels on MLX Audio: a handle, 0 when there is no sound
// server (or it refused).
pub fn audioOpen(rate: u32, channels: u32, latency: u32) -> usize {
    if rate == 0 || channels == 0 || channels > 8 { return 0 }
    const address = malloc(@sizeOf(Output))
    if address == 0 { return 0 }
    const o = outputAt(address)
    o.*.entries[0] = entry("DBUS_SESSION_BUS_ADDRESS")
    o.*.entries[1] = entry("XDG_RUNTIME_DIR")
    o.*.entries[2] = entry("HOME")
    o.*.entries[3] = 0
    var count: usize = 0
    var index: usize = 0
    while index < 3 {
        if o.*.entries[index] != 0 {
            o.*.environment[count] = o.*.entries[index]
            count += 1
        }
        index += 1
    }
    o.*.environment[count] = 0
    const environment: [*][*]const u8 = unsafe { @ptrCast([*][*]const u8, &o.*.environment) }
    if audio.connect(&o.*.connection, allocator(), environment) != audio.OK {
        audioClose(address)
        return 0
    }
    o.*.stream = audio.openStream(&o.*.connection, audio.PLAY, audio.F32, channels, rate, latency, "Voyager")
    if o.*.stream == 0 || audio.refusal(&o.*.connection, o.*.stream) != 0 {
        audioClose(address)
        return 0
    }
    o.*.rate = rate
    o.*.channels = channels
    o.*.written = 0
    return address
}

pub fn audioClose(address: usize) -> void {
    if address == 0 { return }
    const o = outputAt(address)
    if o.*.connection.connected {
        if o.*.stream != 0 { audio.closeStream(&o.*.connection, o.*.stream) }
        audio.disconnect(&o.*.connection)
    }
    var index: usize = 0
    while index < 3 {
        if o.*.entries[index] != 0 { free(o.*.entries[index]) }
        index += 1
    }
    free(address)
}

// Plays `frames` frames of interleaved floats, as fast as the server
// takes them (it paces the caller: a thread of its own); 0 when the
// server went.
pub fn audioWrite(address: usize, samples: usize, frames: usize) -> u32 {
    if address == 0 || samples == 0 { return 0 }
    const o = outputAt(address)
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, samples) }
    if !audio.write(&o.*.connection, o.*.stream, bytes, frames * @intCast(usize, o.*.channels) * 4) { return 0 }
    o.*.written += @intCast(u64, frames)
    return 1
}

// Frames handed to the server so far (its own buffer holds `latency`
// milliseconds of them at most).
pub fn audioWritten(address: usize) -> u64 {
    if address == 0 { return 0 }
    return outputAt(address).*.written
}

pub fn audioDrain(address: usize) -> void {
    if address == 0 { return }
    const o = outputAt(address)
    _ = audio.drain(&o.*.connection, o.*.stream)
}

// Volume in 1/65536 (65536: as is).
pub fn audioSetVolume(address: usize, volume: u32) -> void {
    if address == 0 { return }
    const o = outputAt(address)
    _ = audio.setVolume(&o.*.connection, o.*.stream, volume)
}

// The device's rate (0 before the stream opened).
pub fn audioDeviceRate(address: usize) -> u32 {
    if address == 0 { return 0 }
    const o = outputAt(address)
    return audio.deviceRate(&o.*.connection, o.*.stream)
}
