export fn mlxweb_video_close(decoder: usize) -> void { media.videoClose(decoder) }
export fn mlxweb_video_decode(decoder: usize, h264: usize, bytes: usize) -> u32 { return media.videoDecode(decoder, h264, bytes) }
export fn mlxweb_video_width(decoder: usize) -> u32 { return media.videoWidth(decoder) }
export fn mlxweb_video_height(decoder: usize) -> u32 { return media.videoHeight(decoder) }
