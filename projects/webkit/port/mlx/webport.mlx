// The Mlx side of PlatformMlx (PORT.md, "The Mlx side"): libmlxwebport.so,
// what the port's C++ reaches of std, in the shapes it needs, through
// functions with the C ABI that port/MlxWebPort.h declares extern "C".
// Each export is a wrapper of a pub fn of the module that does
// the work (an export cannot be called from Mlx); state lives on the C
// library's heap, never in an export's stack arena.
//
//     ./mlx build webkit-mlx-port       mlx-out/lib/libmlxwebport.so
//
// The parts: digest.mlx (PAL's digests: std.sha1, std.sha2), image.mlx
// (the image decoders: std.png, std.jpeg, std.webp), font.mlx (finding
// fonts: std.fontconfig), psl.mlx (public suffixes: std.http.psl), file.mlx
// (file: URLs' files: std.fs). The C header of these functions,
// port/MlxWebPort.h, is made of api/MlxWebPort.mlx by mlx-cheaders.
const digest = @import("./digest.mlx")
const image = @import("./image.mlx")
const font = @import("./font.mlx")
const psl = @import("./psl.mlx")
const file = @import("./file.mlx")

export fn mlxweb_digest_create(algorithm: u32) -> usize { return digest.create(algorithm) }
export fn mlxweb_digest_update(state: usize, bytes: usize, length: usize) -> void { digest.update(state, bytes, length) }
export fn mlxweb_digest_finish(state: usize, out: usize) -> usize { return digest.finish(state, out) }
export fn mlxweb_digest_destroy(state: usize) -> void { digest.destroy(state) }

export fn mlxweb_image_decode(kind: u32, bytes: usize, length: usize) -> usize { return image.decode(kind, bytes, length) }
export fn mlxweb_image_width(decoded: usize) -> usize { return image.width(decoded) }
export fn mlxweb_image_height(decoded: usize) -> usize { return image.height(decoded) }
export fn mlxweb_image_pixels(decoded: usize) -> usize { return image.pixels(decoded) }
export fn mlxweb_image_orientation(decoded: usize) -> u32 { return image.orientation(decoded) }
export fn mlxweb_image_destroy(decoded: usize) -> void { image.destroy(decoded) }
export fn mlxweb_image_write_png(path: usize, pixels: usize, width: usize, height: usize, stride: usize, alpha: u32) -> u32 { return if image.writePng(path, pixels, width, height, stride, alpha != 0) { 1 } else { 0 } }

export fn mlxweb_font_match(family: usize, weight: i32, width: i32, slant: i32) -> usize { return font.matchFamily(family, @intCast(i64, weight), @intCast(i64, width), @intCast(i64, slant)) }
export fn mlxweb_font_fallback(character: u32, locale: usize, weight: i32, width: i32, slant: i32) -> usize { return font.fallback(character, locale, @intCast(i64, weight), @intCast(i64, width), @intCast(i64, slant)) }
export fn mlxweb_font_path(found: usize) -> usize { return font.fontPath(found) }
export fn mlxweb_font_index(found: usize) -> i32 { return @intCast(i32, font.fontIndex(found)) }
export fn mlxweb_font_release(found: usize) -> void { font.release(found) }
export fn mlxweb_font_add_file(path: usize) -> u32 { return if font.addFile(path) { 1 } else { 0 } }

export fn mlxweb_psl_is_public_suffix(domain: usize, length: usize) -> u32 { return if psl.isPublicSuffix(domain, length) { 1 } else { 0 } }
export fn mlxweb_psl_base_domain(host: usize, length: usize) -> i64 { return psl.baseDomain(host, length) }

export fn mlxweb_file_read(path: usize, reason: usize) -> usize { return file.read(path, unsafe { @ptrFromInt(*u32, reason) }) }
export fn mlxweb_file_bytes(contents: usize) -> usize { return file.bytes(contents) }
export fn mlxweb_file_length(contents: usize) -> usize { return file.length(contents) }
export fn mlxweb_file_release(contents: usize) -> void { file.release(contents) }
