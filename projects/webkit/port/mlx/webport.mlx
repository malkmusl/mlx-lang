export fn mlxweb_media_sample_at(demuxer: usize, index: usize, out: usize) -> u32 { return media.sampleAt(demuxer, index, out) }
export fn mlxweb_media_clear_samples(demuxer: usize) -> void { media.clearSamples(demuxer) }
export fn mlxweb_media_annexb_size(demuxer: usize, track: usize, sample: usize, length: usize) -> usize { return media.annexBSize(demuxer, track, sample, length) }
export fn mlxweb_media_annexb(demuxer: usize, track: usize, sample: usize, length: usize, out: usize, capacity: usize) -> usize { return media.annexB(demuxer, track, sample, length, out, capacity) }

export fn mlxweb_media_aac_create(config: usize, length: usize) -> usize { return media.aacCreate(config, length) }
export fn mlxweb_media_aac_destroy(decoder: usize) -> void { media.aacDestroy(decoder) }
export fn mlxweb_media_aac_rate(decoder: usize) -> u32 { return media.aacRate(decoder) }
export fn mlxweb_media_aac_reset(decoder: usize) -> void { media.aacReset(decoder) }
export fn mlxweb_media_aac_decode(decoder: usize, bytes: usize, length: usize, out: usize) -> u32 { return media.aacDecode(decoder, bytes, length, out) }

