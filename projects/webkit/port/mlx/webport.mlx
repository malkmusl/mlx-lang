// The Mlx side of PlatformMlx (PORT.md, "The Mlx side"): libmlxwebport.so,
// what the port's C++ reaches of std, in the shapes it needs, through
// functions with the C ABI that port/MlxWebPort.h declares extern "C".
// Each export is a wrapper of a pub fn of the module that does
// the work (an export cannot be called from Mlx); state lives on the C
// library's heap, never in an export's stack arena.
//
//     ./mlx build webkit-mlx-port       mlx-out/lib/libmlxwebport.so
//
// The parts: digest.mlx (PAL's digests: std.sha1, std.sha2), image.mlx
// (the image decoders: std.png, std.jpeg, std.webp), font.mlx (finding
// fonts: std.fontconfig), psl.mlx (public suffixes: std.http.psl), file.mlx
// (file: URLs' files: std.fs), http.mlx (http: and https: with std.http,
// the profile's HTTP cache, httpcache.mlx, and cookie database,
// cookies.mlx: std.sql), theme.mlx (the theme's colours:
// std.ui.theme), crypto.mlx (WebCrypto: std.crypto, std.aes, std.asn1,
// std.random), download.mlx (downloads' files: std.fs), media.mlx (MP4,
// AAC, H.264 and sound for the media player: std.mp4, std.aac, std.h264,
// std.audio). The C header of these functions,
// port/MlxWebPort.h, is made of api/MlxWebPort.mlx by mlx-cheaders.
const digest = @import("./digest.mlx")
const image = @import("./image.mlx")
const font = @import("./font.mlx")
const psl = @import("./psl.mlx")
const file = @import("./file.mlx")
const http = @import("./http.mlx")
const websocket = @import("./websocket.mlx")
const theme = @import("./theme.mlx")
const crypto = @import("./crypto.mlx")
const download = @import("./download.mlx")
const media = @import("./media.mlx")
const mediasession = @import("./mediasession.mlx")

export fn mlxweb_digest_create(algorithm: u32) -> usize { return digest.create(algorithm) }
export fn mlxweb_digest_update(state: usize, bytes: usize, length: usize) -> void { digest.update(state, bytes, length) }
export fn mlxweb_digest_finish(state: usize, out: usize) -> usize { return digest.finish(state, out) }
export fn mlxweb_digest_destroy(state: usize) -> void { digest.destroy(state) }

export fn mlxweb_image_decode(kind: u32, bytes: usize, length: usize) -> usize { return image.decode(kind, bytes, length) }
export fn mlxweb_image_width(decoded: usize) -> usize { return image.width(decoded) }
export fn mlxweb_image_height(decoded: usize) -> usize { return image.height(decoded) }
export fn mlxweb_image_pixels(decoded: usize) -> usize { return image.pixels(decoded) }
export fn mlxweb_image_orientation(decoded: usize) -> u32 { return image.orientation(decoded) }
export fn mlxweb_image_destroy(decoded: usize) -> void { image.destroy(decoded) }
export fn mlxweb_image_write_png(path: usize, pixels: usize, width: usize, height: usize, stride: usize, alpha: u32) -> u32 { return if image.writePng(path, pixels, width, height, stride, alpha != 0) { 1 } else { 0 } }

export fn mlxweb_font_match(family: usize, weight: i32, width: i32, slant: i32) -> usize { return font.matchFamily(family, @intCast(i64, weight), @intCast(i64, width), @intCast(i64, slant)) }
export fn mlxweb_font_fallback(character: u32, locale: usize, weight: i32, width: i32, slant: i32) -> usize { return font.fallback(character, locale, @intCast(i64, weight), @intCast(i64, width), @intCast(i64, slant)) }
export fn mlxweb_font_path(found: usize) -> usize { return font.fontPath(found) }
export fn mlxweb_font_index(found: usize) -> i32 { return @intCast(i32, font.fontIndex(found)) }
export fn mlxweb_font_release(found: usize) -> void { font.release(found) }
export fn mlxweb_font_add_file(path: usize) -> u32 { return if font.addFile(path) { 1 } else { 0 } }

export fn mlxweb_psl_is_public_suffix(domain: usize, length: usize) -> u32 { return if psl.isPublicSuffix(domain, length) { 1 } else { 0 } }
export fn mlxweb_psl_base_domain(host: usize, length: usize) -> i64 { return psl.baseDomain(host, length) }

export fn mlxweb_file_read(path: usize, reason: usize) -> usize { return file.read(path, unsafe { @ptrFromInt(*u32, reason) }) }
export fn mlxweb_file_bytes(contents: usize) -> usize { return file.bytes(contents) }
export fn mlxweb_file_length(contents: usize) -> usize { return file.length(contents) }
export fn mlxweb_file_release(contents: usize) -> void { file.release(contents) }

export fn mlxweb_http_request(method: usize, url: usize, headerLines: usize, body: usize, bodyLength: usize, hasBody: u32, cacheMode: u32) -> usize { return http.request(method, url, headerLines, body, bodyLength, hasBody != 0, cacheMode, false) }
export fn mlxweb_http_request_streamed(method: usize, url: usize, headerLines: usize, body: usize, bodyLength: usize, hasBody: u32, cacheMode: u32) -> usize { return http.request(method, url, headerLines, body, bodyLength, hasBody != 0, cacheMode, true) }
export fn mlxweb_http_has_stream(answer: usize) -> u32 { return flag(http.hasStream(answer)) }
export fn mlxweb_http_stream_length(answer: usize) -> i64 { return http.streamLength(answer) }
export fn mlxweb_http_stream_read(answer: usize, callback: usize, context: usize) -> u32 { return http.streamRead(answer, callback, context) }
export fn mlxweb_http_source(answer: usize) -> u32 { return http.source(answer) }
export fn mlxweb_profile_open(cookies: usize, cache: usize) -> void { http.openProfile(cookies, cache) }
export fn mlxweb_profile_close() -> void { http.closeProfile() }
export fn mlxweb_http_error(answer: usize) -> u32 { return http.failure(answer) }
export fn mlxweb_http_status(answer: usize) -> u32 { return http.status(answer) }
export fn mlxweb_http_head(answer: usize) -> usize { return http.head(answer) }
export fn mlxweb_http_head_length(answer: usize) -> usize { return http.headLength(answer) }
export fn mlxweb_http_body(answer: usize) -> usize { return http.body(answer) }
export fn mlxweb_http_body_length(answer: usize) -> usize { return http.bodyLength(answer) }
export fn mlxweb_http_release(answer: usize) -> void { http.release(answer) }
export fn mlxweb_cookies_for(url: usize, forHttp: u32) -> usize { return http.cookiesFor(url, forHttp != 0) }
export fn mlxweb_cookie_set(url: usize, line: usize) -> void { http.setCookie(url, line) }
export fn mlxweb_text_release(text: usize) -> void { http.releaseText(text) }

export fn mlxweb_ws_connect(url: usize, protocols: usize) -> usize { return websocket.connect(url, protocols) }
export fn mlxweb_ws_protocol(socket: usize) -> usize { return websocket.protocol(socket) }
export fn mlxweb_ws_extensions(socket: usize) -> usize { return websocket.extensions(socket) }
export fn mlxweb_ws_send(socket: usize, binary: u32, bytes: usize, length: usize) -> u32 { return if websocket.send(socket, binary != 0, bytes, length) { 1 } else { 0 } }
export fn mlxweb_ws_close(socket: usize, code: u32, reason: usize) -> void { websocket.close(socket, code, reason) }
export fn mlxweb_ws_receive(socket: usize) -> usize { return websocket.receive(socket) }
export fn mlxweb_ws_message_kind(m: usize) -> u32 { return websocket.messageKind(m) }
export fn mlxweb_ws_message_code(m: usize) -> u32 { return websocket.messageCode(m) }
export fn mlxweb_ws_message_bytes(m: usize) -> usize { return websocket.messageBytes(m) }
export fn mlxweb_ws_message_length(m: usize) -> usize { return websocket.messageLength(m) }
export fn mlxweb_ws_message_release(m: usize) -> void { websocket.releaseMessage(m) }
export fn mlxweb_ws_shutdown(socket: usize) -> void { websocket.shutdown(socket) }
export fn mlxweb_ws_release(socket: usize) -> void { websocket.release(socket) }

export fn mlxweb_theme_color(dark: u32, which: u32) -> u32 { return theme.color(dark != 0, which) }

fn flag(value: bool) -> u32 { return if value { 1 } else { 0 } }

export fn mlxweb_crypto_random(out: usize, length: usize) -> u32 { return flag(crypto.randomBytes(out, length)) }
export fn mlxweb_crypto_digest(algorithm: u32, data: usize, length: usize, out: usize) -> usize { return crypto.digest(algorithm, data, length, out) }
export fn mlxweb_crypto_hmac(algorithm: u32, key: usize, keyLength: usize, data: usize, length: usize, out: usize) -> usize { return crypto.hmac(algorithm, key, keyLength, data, length, out) }
export fn mlxweb_crypto_hkdf(algorithm: u32, key: usize, keyLength: usize, salt: usize, saltLength: usize, info: usize, infoLength: usize, out: usize, length: usize) -> u32 { return flag(crypto.hkdf(algorithm, key, keyLength, salt, saltLength, info, infoLength, out, length)) }
export fn mlxweb_crypto_pbkdf2(algorithm: u32, password: usize, passwordLength: usize, salt: usize, saltLength: usize, iterations: u64, out: usize, length: usize) -> u32 { return flag(crypto.pbkdf2(algorithm, password, passwordLength, salt, saltLength, iterations, out, length)) }
export fn mlxweb_crypto_aes_cbc(encrypt: u32, padding: u32, key: usize, keyLength: usize, iv: usize, data: usize, length: usize, out: usize, written: usize) -> u32 { return flag(crypto.aesCbc(encrypt != 0, padding != 0, key, keyLength, iv, data, length, out, unsafe { @ptrFromInt(*usize, written) })) }
export fn mlxweb_crypto_aes_cfb8(encrypt: u32, key: usize, keyLength: usize, iv: usize, data: usize, length: usize, out: usize) -> u32 { return flag(crypto.aesCfb8(encrypt != 0, key, keyLength, iv, data, length, out)) }
export fn mlxweb_crypto_aes_ctr(key: usize, keyLength: usize, counter: usize, counterBits: usize, data: usize, length: usize, out: usize) -> u32 { return flag(crypto.aesCtr(key, keyLength, counter, counterBits, data, length, out)) }
export fn mlxweb_crypto_aes_gcm(encrypt: u32, key: usize, keyLength: usize, iv: usize, ivLength: usize, aad: usize, aadLength: usize, tagLength: usize, data: usize, length: usize, out: usize) -> u32 { return flag(crypto.aesGcm(encrypt != 0, key, keyLength, iv, ivLength, aad, aadLength, tagLength, data, length, out)) }
export fn mlxweb_crypto_aes_kw(wrap: u32, key: usize, keyLength: usize, data: usize, length: usize, out: usize) -> u32 { return flag(crypto.aesKw(wrap != 0, key, keyLength, data, length, out)) }
export fn mlxweb_crypto_ec_size(curve: u32) -> usize { return crypto.ecSize(curve) }
export fn mlxweb_crypto_ec_generate(curve: u32, scalar: usize, point: usize) -> u32 { return flag(crypto.ecGenerate(curve, scalar, point)) }
export fn mlxweb_crypto_ec_public(curve: u32, scalar: usize, point: usize) -> u32 { return flag(crypto.ecPublic(curve, scalar, point)) }
export fn mlxweb_crypto_ec_point(curve: u32, point: usize, length: usize, out: usize) -> u32 { return flag(crypto.ecPoint(curve, point, length, out)) }
export fn mlxweb_crypto_ecdsa_sign(curve: u32, algorithm: u32, scalar: usize, data: usize, length: usize, out: usize) -> u32 { return flag(crypto.ecdsaSign(curve, algorithm, scalar, data, length, out)) }
export fn mlxweb_crypto_ecdsa_verify(curve: u32, algorithm: u32, point: usize, pointLength: usize, data: usize, length: usize, signature: usize, signatureLength: usize) -> u32 { return flag(crypto.ecdsaVerify(curve, algorithm, point, pointLength, data, length, signature, signatureLength)) }
export fn mlxweb_crypto_ecdh(curve: u32, scalar: usize, point: usize, pointLength: usize, out: usize) -> u32 { return flag(crypto.ecdh(curve, scalar, point, pointLength, out)) }
export fn mlxweb_crypto_ed25519_public(seed: usize, out: usize) -> void { crypto.ed25519Public(seed, out) }
export fn mlxweb_crypto_ed25519_sign(seed: usize, data: usize, length: usize, out: usize) -> void { crypto.ed25519Sign(seed, data, length, out) }
export fn mlxweb_crypto_ed25519_verify(key: usize, data: usize, length: usize, signature: usize, signatureLength: usize) -> u32 { return flag(crypto.ed25519Verify(key, data, length, signature, signatureLength)) }
export fn mlxweb_crypto_x25519(scalar: usize, u: usize, out: usize) -> u32 { return flag(crypto.x25519(scalar, u, out)) }
export fn mlxweb_crypto_rsa_key(parts: usize) -> usize { return crypto.rsaKey(parts) }
export fn mlxweb_crypto_rsa_release(key: usize) -> void { crypto.rsaRelease(key) }
export fn mlxweb_crypto_rsa_bits(key: usize) -> usize { return crypto.rsaBits(key) }
export fn mlxweb_crypto_rsa_generate(bits: usize, exponent: usize, exponentLength: usize) -> usize { return crypto.rsaGenerate(bits, exponent, exponentLength) }
export fn mlxweb_crypto_rsa_sign(key: usize, scheme: u32, algorithm: u32, saltLength: usize, data: usize, length: usize, out: usize) -> usize { return crypto.rsaSign(key, scheme, algorithm, saltLength, data, length, out) }
export fn mlxweb_crypto_rsa_verify(key: usize, scheme: u32, algorithm: u32, saltLength: usize, data: usize, length: usize, signature: usize, signatureLength: usize) -> u32 { return flag(crypto.rsaVerify(key, scheme, algorithm, saltLength, data, length, signature, signatureLength)) }
export fn mlxweb_crypto_rsa_oaep(encrypt: u32, key: usize, algorithm: u32, label: usize, labelLength: usize, data: usize, length: usize, out: usize, written: usize) -> u32 { return flag(crypto.rsaOaep(encrypt != 0, key, algorithm, label, labelLength, data, length, out, unsafe { @ptrFromInt(*usize, written) })) }
export fn mlxweb_crypto_spki_read(der: usize, length: usize) -> usize { return crypto.spkiRead(der, length) }
export fn mlxweb_crypto_pkcs8_read(der: usize, length: usize) -> usize { return crypto.pkcs8Read(der, length) }
export fn mlxweb_crypto_spki_write(kind: u32, curve: u32, key: usize) -> usize { return crypto.spkiWrite(@intCast(u8, kind & 255), curve, key) }
export fn mlxweb_crypto_pkcs8_write(kind: u32, curve: u32, key: usize) -> usize { return crypto.pkcs8Write(@intCast(u8, kind & 255), curve, key) }
export fn mlxweb_crypto_parts_create() -> usize { return crypto.partsCreate() }
export fn mlxweb_crypto_parts_add(parts: usize, bytes: usize, length: usize) -> void { crypto.partsAdd(parts, bytes, length) }
export fn mlxweb_crypto_parts_count(parts: usize) -> usize { return crypto.partsCount(parts) }
export fn mlxweb_crypto_parts_at(parts: usize, index: usize, length: usize) -> usize { return crypto.partsPart(parts, index, unsafe { @ptrFromInt(*usize, length) }) }
export fn mlxweb_crypto_parts_release(parts: usize) -> void { crypto.partsRelease(parts) }

export fn mlxweb_download_create(directory: usize, name: usize) -> usize { return download.create(directory, name) }
export fn mlxweb_download_reopen(partial: usize, final: usize, keep: u32) -> usize { return download.reopen(partial, final, keep != 0) }
export fn mlxweb_download_size(path: usize) -> i64 { return download.sizeOf(path) }
export fn mlxweb_download_write(file: usize, bytes: usize, length: usize) -> u32 { return flag(download.write(file, bytes, length)) }
export fn mlxweb_download_partial_path(file: usize) -> usize { return download.partialPath(file) }
export fn mlxweb_download_path(file: usize) -> usize { return download.finalPath(file) }
export fn mlxweb_download_finish(file: usize, keep: u32) -> u32 { return flag(download.finish(file, keep)) }
export fn mlxweb_download_release(file: usize) -> void { download.release(file) }
export fn mlxweb_download_remove(path: usize) -> u32 { return flag(download.remove(path)) }

export fn mlxweb_media_demuxer_create() -> usize { return media.demuxerCreate() }
export fn mlxweb_media_demuxer_destroy(demuxer: usize) -> void { media.demuxerDestroy(demuxer) }
export fn mlxweb_media_demuxer_parse(demuxer: usize, bytes: usize, length: usize, used: usize) -> u32 { return media.demuxerParse(demuxer, bytes, length, used) }
export fn mlxweb_media_track_count(demuxer: usize) -> usize { return media.trackCount(demuxer) }
export fn mlxweb_media_track_kind(demuxer: usize, track: usize) -> u32 { return media.trackKind(demuxer, track) }
export fn mlxweb_media_track_codec(demuxer: usize, track: usize) -> u32 { return media.trackCodec(demuxer, track) }
export fn mlxweb_media_track_timescale(demuxer: usize, track: usize) -> u32 { return media.trackTimescale(demuxer, track) }
export fn mlxweb_media_track_duration(demuxer: usize, track: usize) -> u64 { return media.trackDuration(demuxer, track) }
export fn mlxweb_media_track_width(demuxer: usize, track: usize) -> u32 { return media.trackWidth(demuxer, track) }
export fn mlxweb_media_track_height(demuxer: usize, track: usize) -> u32 { return media.trackHeight(demuxer, track) }
export fn mlxweb_media_track_channels(demuxer: usize, track: usize) -> u32 { return media.trackChannels(demuxer, track) }
export fn mlxweb_media_track_rate(demuxer: usize, track: usize) -> u32 { return media.trackRate(demuxer, track) }
export fn mlxweb_media_track_edit_media_time(demuxer: usize, track: usize) -> u64 { return media.trackEditMediaTime(demuxer, track) }
export fn mlxweb_media_track_nal_length_size(demuxer: usize, track: usize) -> u32 { return media.trackNalLengthSize(demuxer, track) }
export fn mlxweb_media_track_config(demuxer: usize, track: usize, length: usize) -> usize { return media.trackConfig(demuxer, track, length) }
export fn mlxweb_media_track_parameter_set(demuxer: usize, track: usize, set: usize, length: usize) -> usize { return media.trackParameterSet(demuxer, track, set, length) }
