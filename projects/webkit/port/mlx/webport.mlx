export fn mlxweb_media_session_update(session: usize, status: u32, title: usize, title_length: usize, artist: usize, artist_length: usize, album: usize, album_length: usize, art_url: usize, art_url_length: usize, url: usize, url_length: usize, length: i64, position: i64, can_seek: u32, can_next: u32, can_previous: u32, seeked: u32) -> void { mediasession.sessionUpdate(session, status, title, title_length, artist, artist_length, album, album_length, art_url, art_url_length, url, url_length, length, position, can_seek, can_next, can_previous, seeked) }
