export fn mlxweb_media_h264_destroy(decoder: usize) -> void { media.h264Destroy(decoder) }
export fn mlxweb_media_h264_parameter_set(decoder: usize, bytes: usize, length: usize) -> u32 { return media.h264ParameterSet(decoder, bytes, length) }
export fn mlxweb_media_h264_access_unit(decoder: usize, bytes: usize, length: usize, prefix: usize) -> u32 { return media.h264AccessUnit(decoder, bytes, length, prefix) }
export fn mlxweb_media_h264_picture_slot(decoder: usize) -> u32 { return media.h264PictureSlot(decoder) }
export fn mlxweb_media_h264_picture_poc(decoder: usize) -> i32 { return media.h264PicturePoc(decoder) }
export fn mlxweb_media_h264_picture_width(decoder: usize) -> u32 { return media.h264PictureWidth(decoder) }
export fn mlxweb_media_h264_picture_height(decoder: usize) -> u32 { return media.h264PictureHeight(decoder) }
export fn mlxweb_media_h264_finish_picture(decoder: usize) -> void { media.h264FinishPicture(decoder) }
export fn mlxweb_media_h264_next_output(decoder: usize, slot: usize, poc: usize) -> u32 { return media.h264NextOutput(decoder, slot, poc) }
