// WebCore's public suffixes (PublicSuffixStoreMlx.cpp) by the Public
// Suffix List of std.http.psl, as mlx-soup's soup_tld functions answer
// them for the WPE port: whether a domain is a public suffix (without the
// implicit "*" rule), and where a host's base domain (its registrable
// domain) starts. Names are lower case ASCII or UTF-8, given by address
// and length.
const psl = @import("std.http.psl")

// What baseDomain answers when there is no base domain: the host's
// longest suffix is not on the list, or the host is itself a public
// suffix (soup's NO_BASE_DOMAIN, NOT_ENOUGH_DOMAINS).
pub const NO_BASE_DOMAIN: i64 = -1
pub const NOT_ENOUGH_DOMAINS: i64 = -2

fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

pub fn isPublicSuffix(address: usize, length: usize) -> bool {
    if length == 0 { return false }
    return psl.isPublicSuffix(bytes(address, length), true)
}

// Where the base domain of the host starts, or one of the answers above.
pub fn baseDomain(address: usize, length: usize) -> i64 {
    if length == 0 { return NOT_ENOUGH_DOMAINS }
    const text = bytes(address, length)
    const suffix = psl.suffixStart(text)
    if !psl.isPublicSuffix(text[suffix..text.length], true) { return NO_BASE_DOMAIN }
    const registrable = psl.registrableStart(text)
    if registrable == text.length { return NOT_ENOUGH_DOMAINS }
    return @intCast(i64, registrable)
}
