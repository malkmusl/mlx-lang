// PAL's digests (CryptoDigestMlx.cpp) over std.sha1 and std.sha2: a
// hashing state on the C library's heap, fed and finished by the port's
// C++ through webport.mlx's exports.
const sha1 = @import("std.sha1")
const sha2 = @import("std.sha2")

extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void

// The algorithms, as MlxWebPort.h numbers them (their digests' bits; 1
// for SHA-1).
pub const SHA1: u32 = 1
pub const SHA224: u32 = 224
pub const SHA256: u32 = 256
pub const SHA384: u32 = 384
pub const SHA512: u32 = 512

const Digest = struct {
    algorithm: u32
    one: sha1.Sha1
    small: sha2.Sha256
    large: sha2.Sha512
}

fn digestAt(address: usize) -> *Digest { return unsafe { @ptrFromInt(*Digest, address) } }

// A new hashing state for ALGORITHM; 0 for an algorithm not known or no
// memory.
pub fn create(algorithm: u32) -> usize {
    if algorithm != SHA1 && algorithm != SHA224 && algorithm != SHA256 && algorithm != SHA384 && algorithm != SHA512 { return 0 }
    const address = malloc(@sizeOf(Digest))
    if address == 0 { return 0 }
    const digest = digestAt(address)
    digest.*.algorithm = algorithm
    if algorithm == SHA1 { sha1.sha1Init(&digest.*.one) }
    if algorithm == SHA224 { sha2.sha224Init(&digest.*.small) }
    if algorithm == SHA256 { sha2.sha256Init(&digest.*.small) }
    if algorithm == SHA384 { sha2.sha384Init(&digest.*.large) }
    if algorithm == SHA512 { sha2.sha512Init(&digest.*.large) }
    return address
}

// LENGTH bytes at BYTES added to the hashed data.
pub fn update(address: usize, bytes: usize, length: usize) -> void {
    if address == 0 || length == 0 { return }
    const digest = digestAt(address)
    const data: [*]const u8 = unsafe { @ptrFromInt([*]const u8, bytes) }
    const algorithm = digest.*.algorithm
    if algorithm == SHA1 { sha1.sha1Absorb(&digest.*.one, data, length) }
    if algorithm == SHA224 || algorithm == SHA256 { sha2.sha256Absorb(&digest.*.small, data, length) }
    if algorithm == SHA384 || algorithm == SHA512 { sha2.sha512Absorb(&digest.*.large, data, length) }
}

// The digest written at OUT (room for 64 bytes); its length.
pub fn finish(address: usize, out: usize) -> usize {
    if address == 0 { return 0 }
    const digest = digestAt(address)
    const algorithm = digest.*.algorithm
    if algorithm == SHA1 {
        sha1.sha1Final(&digest.*.one, unsafe { @ptrFromInt(*[20]u8, out) })
        return 20
    }
    if algorithm == SHA224 {
        sha2.sha224Final(&digest.*.small, unsafe { @ptrFromInt(*[28]u8, out) })
        return 28
    }
    if algorithm == SHA256 {
        sha2.sha256Final(&digest.*.small, unsafe { @ptrFromInt(*[32]u8, out) })
        return 32
    }
    if algorithm == SHA384 {
        sha2.sha384Final(&digest.*.large, unsafe { @ptrFromInt(*[48]u8, out) })
        return 48
    }
    sha2.sha512Final(&digest.*.large, unsafe { @ptrFromInt(*[64]u8, out) })
    return 64
}

pub fn destroy(address: usize) -> void {
    if address != 0 { free(address) }
}
