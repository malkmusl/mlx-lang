// Downloads' files (the embedding's MlxDownloads.cpp, PORT.md
// "Downloads"), as Safari keeps them: while the bytes come they go into
// "NAME.EXT.download" beside where the file will be (written as they
// come, on the thread that reads the body), and once all came that file
// is renamed NAME.EXT. The name is the one the response or the page
// suggests, kept apart from what is there: NAME.EXT, then "NAME (1).EXT",
// "NAME (2).EXT", ... whichever has neither the file nor its partial one
// (made with O_EXCL, renamed with RENAME_NOREPLACE: nothing is ever
// written over). A download paused keeps its partial file (closed), and
// is opened again to go on at its end, or from the start; one cancelled
// or failed leaves nothing.
const std = @import("std")

const O_EXCL: usize = 128
const RENAME_NOREPLACE: usize = 1
const PATH_CAPACITY: usize = 4096
// Names tried before giving up: NAME and NAME (1) to NAME (999).
const ATTEMPTS: usize = 1000
const PARTIAL: []const u8 = ".download"

const Saved = @noncopy(struct) {
    file: std.fs.File
    // The partial file's path and the final one's, NUL-terminated.
    partial: std.ArrayList(u8)
    final: std.ArrayList(u8)
    failed: bool

    pub fn init() -> Self {
        return Self.{ .file = std.fs.File.{ .descriptor = -1 }, .partial = std.ArrayList(u8).init(std.heap.allocator()), .final = std.ArrayList(u8).init(std.heap.allocator()), .failed = false }
    }

    pub fn deinit(self: *Self) -> void {
        self.*.partial.deinit()
        self.*.final.deinit()
    }
}

fn fileAt(address: usize) -> *Saved { return unsafe { @ptrFromInt(*Saved, address) } }

fn cText(address: usize) -> []const u8 {
    if address == 0 { return "" }
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address) }
    var length: usize = 0
    while bytes[length] != 0 { length += 1 }
    return bytes[0..length]
}

// Where the name's extension starts (its last dot, not the first byte),
// or its length for none.
fn extensionAt(name: []const u8) -> usize {
    var at = name.length
    while at > 1 {
        at -= 1
        if name[at] == 46 { return at }
    }
    return name.length
}

fn appendDecimal(list: *std.ArrayList(u8), value: usize) -> bool {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[19 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    return list.appendSlice(digits[20 - count..20])
}

// DIRECTORY/NAME, or with " (N)" before the extension, NUL-terminated;
// PARTIAL's suffix after it when SUFFIX.
fn pathOf(list: *std.ArrayList(u8), directory: []const u8, name: []const u8, attempt: usize, suffix: bool) -> bool {
    list.clearRetainingCapacity()
    var ok = list.appendSlice(directory) && list.append(47)
    const dot = extensionAt(name)
    ok = ok && list.appendSlice(name[0..dot])
    if attempt > 0 { ok = ok && list.appendSlice(" (") && appendDecimal(list, attempt) && list.append(41) }
    ok = ok && list.appendSlice(name[dot..name.length])
    if suffix { ok = ok && list.appendSlice(PARTIAL) }
    ok = ok && list.append(0)
    return ok && list.count() <= PATH_CAPACITY
}

// A name safe as one file's: no slash, no NUL, not "." or ".." (nor
// starting with a dot: no hidden file), "download" for none.
fn safeName(name: []const u8, into: *std.ArrayList(u8)) -> bool {
    var ok = true
    for c in name {
        if into.count() == 0 && (c == 46 || c == 32) { continue }
        ok = ok && into.append(if c == 47 || c == 0 || c == 92 || c < 32 { 95 } else { c })
    }
    if into.count() == 0 { ok = ok && into.appendSlice("download") }
    return ok
}

fn handed(memory: [*]u8) -> usize { return @intFromPtr(memory) }

fn newSaved() -> usize {
    const memory = std.heap.allocator().alloc(@sizeOf(Saved), 16)
    if memory == null { return 0 }
    const made: *Saved = unsafe { @ptrCast(*Saved, memory.?) }
    made.* = Saved.init()
    return handed(memory.?)
}

fn freeSaved(handle: usize) -> void {
    fileAt(handle).*.deinit()
    std.heap.allocator().free(unsafe { @ptrFromInt([*]u8, handle) }, @sizeOf(Saved), 16)
}

// A new download in DIRECTORY (a C string; made with its parents when
// missing) named after NAME (a C string): its partial file made (empty),
// a handle, 0 when none could be made.
pub fn create(directory: usize, name: usize) -> usize {
    const folder = cText(directory)
    if folder.length == 0 { return 0 }
    _ = std.fs.makeDirectories(folder, 0o755)
    var safe = std.ArrayList(u8).init(std.heap.allocator())
    defer safe.deinit()
    if !safeName(cText(name), &safe) { return 0 }
    const handle = newSaved()
    if handle == 0 { return 0 }
    const made = fileAt(handle)
    var attempt: usize = 0
    while attempt < ATTEMPTS {
        if !pathOf(&made.*.final, folder, safe.items(), attempt, false) || !pathOf(&made.*.partial, folder, safe.items(), attempt, true) { break }
        if !std.fs.exists(made.*.final.items().pointer) {
            const opened = std.fs.open(made.*.partial.items().pointer, std.fs.WRITE_ONLY | std.fs.CREATE | O_EXCL, 0o644)
            if std.fs.isValid(opened) {
                made.*.file = opened
                return handle
            }
            // (Only a name taken leads to the next one.)
            if !std.fs.exists(made.*.partial.items().pointer) { break }
        }
        attempt += 1
    }
    freeSaved(handle)
    return 0
}

// The partial file PARTIAL (a C string) of a download to be FINAL,
// opened again to go on: at its end when KEEP, else emptied. A handle, 0
// when it cannot be opened (made again when gone and not KEEP).
pub fn reopen(partial: usize, final: usize, keep: bool) -> usize {
    const handle = newSaved()
    if handle == 0 { return 0 }
    const made = fileAt(handle)
    const ok = made.*.partial.appendSlice(cText(partial)) && made.*.partial.append(0) && made.*.final.appendSlice(cText(final)) && made.*.final.append(0)
    if ok {
        const flags = if keep { std.fs.WRITE_ONLY | std.fs.APPEND } else { std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE }
        const opened = std.fs.open(made.*.partial.items().pointer, flags, 0o644)
        if std.fs.isValid(opened) {
            made.*.file = opened
            return handle
        }
    }
    freeSaved(handle)
    return 0
}

// The size of the file a path names (a C string), -1 when there is none.
pub fn sizeOf(path: usize) -> i64 {
    var stat: std.fs.Stat = undefined
    if std.fs.status(unsafe { @ptrFromInt([*]const u8, path) }, &stat) != 0 { return -1 }
    return @intCast(i64, stat.size)
}

// LENGTH bytes at BYTES added to the partial file; false when they could
// not be written (the download then fails).
pub fn write(handle: usize, bytes: usize, length: usize) -> bool {
    if handle == 0 { return false }
    const made = fileAt(handle)
    if made.*.failed { return false }
    if length == 0 { return true }
    if !std.fs.writeAllBytes(made.*.file, unsafe { @ptrFromInt([*]const u8, bytes) }, length) { made.*.failed = true }
    return !made.*.failed
}

// The partial file's path and the final one's (C strings, the handle's).
pub fn partialPath(handle: usize) -> usize { return if handle == 0 { 0 } else { @intFromPtr(fileAt(handle).*.partial.items().pointer) } }
pub fn finalPath(handle: usize) -> usize { return if handle == 0 { 0 } else { @intFromPtr(fileAt(handle).*.final.items().pointer) } }

// Closes the partial file and ends the handle: KEEP 0 removes the file
// (cancelled, failed), 1 keeps it (paused), 2 renames it to its final
// name (done; another free name of the folder when that one was taken
// meanwhile, finalPath then that one). Whether the file was kept or
// renamed as asked (a write that failed: removed, false).
pub fn finish(handle: usize, keep: u32) -> bool {
    if handle == 0 { return false }
    const made = fileAt(handle)
    const closed = std.fs.close(made.*.file)
    var kept = keep != 0 && closed && !made.*.failed
    if kept && keep == 2 { kept = rename(made) }
    if !kept { _ = std.fs.delete(made.*.partial.items().pointer) }
    return kept
}

// Frees the handle (after finish, its paths read).
pub fn release(handle: usize) -> void {
    if handle != 0 { freeSaved(handle) }
}

// The partial file renamed to its final name, or to "NAME (N).EXT" of the
// same folder when that was taken.
fn rename(made: *Saved) -> bool {
    if std.fs.renameWithFlags(made.*.partial.items().pointer, made.*.final.items().pointer, RENAME_NOREPLACE) { return true }
    // The folder and the name, from the final path.
    var whole = std.ArrayList(u8).init(std.heap.allocator())
    defer whole.deinit()
    const final = made.*.final.items()
    if !whole.appendSlice(final[0..final.length - 1]) { return false }
    const path = whole.items()
    var slash = path.length
    while slash > 0 && path[slash - 1] != 47 { slash -= 1 }
    if slash == 0 { return false }
    var attempt: usize = 1
    while attempt < ATTEMPTS {
        if !pathOf(&made.*.final, path[0..slash - 1], path[slash..path.length], attempt, false) { return false }
        if std.fs.renameWithFlags(made.*.partial.items().pointer, made.*.final.items().pointer, RENAME_NOREPLACE) { return true }
        if !std.fs.exists(made.*.final.items().pointer) { return false }
        attempt += 1
    }
    return false
}

// Removes the file a path names (a C string): a paused download's
// partial file when it is cancelled.
pub fn remove(path: usize) -> bool {
    if path == 0 { return false }
    return std.fs.delete(unsafe { @ptrFromInt([*]const u8, path) })
}
