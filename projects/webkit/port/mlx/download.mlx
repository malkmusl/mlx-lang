// Downloads' files (the embedding's MlxDownloads.cpp, PORT.md
// "Downloads"): a file made in the downloads directory under the name the
// response or the page suggests, kept apart from what is there (NAME,
// then "NAME (1).EXT", "NAME (2).EXT", ...: made with O_EXCL, so that no
// file is ever written over), written as the bytes come, and kept or
// removed at the end (a download that failed leaves nothing).
const std = @import("std")

const O_EXCL: usize = 128
const PATH_CAPACITY: usize = 4096
// Names tried before giving up: NAME and NAME (1) to NAME (999).
const ATTEMPTS: usize = 1000

const Saved = @noncopy(struct) {
    file: std.fs.File
    // The file's path, NUL-terminated.
    path: std.ArrayList(u8)
    failed: bool

    pub fn deinit(self: *Self) -> void {
        self.*.path.deinit()
    }
}

fn fileAt(address: usize) -> *Saved { return unsafe { @ptrFromInt(*Saved, address) } }

fn cText(address: usize) -> []const u8 {
    if address == 0 { return "" }
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address) }
    var length: usize = 0
    while bytes[length] != 0 { length += 1 }
    return bytes[0..length]
}

// Where the name's extension starts (its last dot, not the first byte),
// or its length for none.
fn extensionAt(name: []const u8) -> usize {
    var at = name.length
    while at > 1 {
        at -= 1
        if name[at] == 46 { return at }
    }
    return name.length
}

fn appendDecimal(list: *std.ArrayList(u8), value: usize) -> bool {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[19 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    return list.appendSlice(digits[20 - count..20])
}

// DIRECTORY/NAME, or with " (N)" before the extension, NUL-terminated.
fn pathOf(list: *std.ArrayList(u8), directory: []const u8, name: []const u8, attempt: usize) -> bool {
    list.clearRetainingCapacity()
    var ok = list.appendSlice(directory) && list.append(47)
    const dot = extensionAt(name)
    ok = ok && list.appendSlice(name[0..dot])
    if attempt > 0 { ok = ok && list.appendSlice(" (") && appendDecimal(list, attempt) && list.append(41) }
    ok = ok && list.appendSlice(name[dot..name.length]) && list.append(0)
    return ok && list.count() <= PATH_CAPACITY
}

// A name safe as one file's: no slash, no NUL, not "." or ".." (nor
// starting with a dot: no hidden file), "download" for none.
fn safeName(name: []const u8, into: *std.ArrayList(u8)) -> bool {
    var ok = true
    for c in name {
        if into.count() == 0 && (c == 46 || c == 32) { continue }
        ok = ok && into.append(if c == 47 || c == 0 || c == 92 || c < 32 { 95 } else { c })
    }
    if into.count() == 0 { ok = ok && into.appendSlice("download") }
    return ok
}

// A new file for a download in DIRECTORY (a C string; made with its
// parents when missing) named after NAME (a C string): a handle, 0 when
// none could be made.
pub fn create(directory: usize, name: usize) -> usize {
    const folder = cText(directory)
    if folder.length == 0 { return 0 }
    _ = std.fs.makeDirectories(folder, 0o755)
    var safe = std.ArrayList(u8).init(std.heap.allocator())
    defer safe.deinit()
    if !safeName(cText(name), &safe) { return 0 }
    const memory = std.heap.allocator().alloc(@sizeOf(Saved), 16)
    if memory == null { return 0 }
    const made: *Saved = unsafe { @ptrCast(*Saved, memory.?) }
    made.* = Saved.{ .file = std.fs.File.{ .descriptor = -1 }, .path = std.ArrayList(u8).init(std.heap.allocator()), .failed = false }
    var attempt: usize = 0
    while attempt < ATTEMPTS {
        if !pathOf(&made.*.path, folder, safe.items(), attempt) { break }
        const opened = std.fs.open(made.*.path.items().pointer, std.fs.WRITE_ONLY | std.fs.CREATE | O_EXCL, 0o644)
        if std.fs.isValid(opened) {
            made.*.file = opened
            return @intFromPtr(made)
        }
        // (Only a name taken leads to the next one.)
        if !std.fs.exists(made.*.path.items().pointer) { break }
        attempt += 1
    }
    made.*.deinit()
    std.heap.allocator().free(memory.?, @sizeOf(Saved), 16)
    return 0
}

// LENGTH bytes at BYTES added to the file; false when they could not be
// written (the download then fails).
pub fn write(handle: usize, bytes: usize, length: usize) -> bool {
    if handle == 0 { return false }
    const made = fileAt(handle)
    if made.*.failed { return false }
    if length == 0 { return true }
    if !std.fs.writeAllBytes(made.*.file, unsafe { @ptrFromInt([*]const u8, bytes) }, length) { made.*.failed = true }
    return !made.*.failed
}

// The file's path (a C string, the handle's until finish).
pub fn path(handle: usize) -> usize { return if handle == 0 { 0 } else { @intFromPtr(fileAt(handle).*.path.items().pointer) } }

// Closes the file, kept when KEEP and every write went in, else removed;
// whether it was kept.
pub fn finish(handle: usize, keep: bool) -> bool {
    if handle == 0 { return false }
    const made = fileAt(handle)
    const closed = std.fs.close(made.*.file)
    const kept = keep && closed && !made.*.failed
    if !kept { _ = std.fs.delete(made.*.path.items().pointer) }
    made.*.deinit()
    std.heap.allocator().free(unsafe { @ptrFromInt([*]u8, handle) }, @sizeOf(Saved), 16)
    return kept
}
