// std.ui.theme's palettes for the port's theme (RenderThemeMlx.cpp,
// ControlFactoryMlx.cpp): the page's system colours, form controls and
// selection drawn in the desktop's colours, light and dark.
const theme_module = @import("std.ui.theme")

// The colour WHICH (MLXWEB_THEME_* of api/MlxWebPort.mlx: std.ui.theme's
// Theme's colours in their order) of the dark palette (DARK) or the
// light one, as 0xAARRGGBB not premultiplied; 0 for another WHICH.
pub fn color(dark: bool, which: u32) -> u32 {
    const theme = if dark { theme_module.dark() } else { theme_module.light() }
    if which >= 29 { return 0 }
    const colors = [29]u32{ theme.background, theme.panel, theme.raised, theme.field, theme.hover, theme.pressed, theme.selected, theme.divider, theme.border, theme.text, theme.dim, theme.disabled, theme.onAccent, theme.accent, theme.danger, theme.control, theme.controlInner, theme.button, theme.buttonHover, theme.primary, theme.primaryHover, theme.switchOff, theme.switchOffHover, theme.knob, theme.track, theme.thumb, theme.indicator, theme.selection, theme.caret }
    return unpremultiplied(colors[@intCast(usize, which)])
}

fn unpremultiplied(value: u32) -> u32 {
    const alpha = value >> 24
    if alpha == 0 || alpha == 255 { return value }
    const red = ((value >> 16) & 255) * 255 / alpha
    const green = ((value >> 8) & 255) * 255 / alpha
    const blue = (value & 255) * 255 / alpha
    return (alpha << 24) | ((if red > 255 { 255 } else { red }) << 16) | ((if green > 255 { 255 } else { green }) << 8) | (if blue > 255 { 255 } else { blue })
}
