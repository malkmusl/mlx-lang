// The fonts of the port's font manager and FontCache (FontCacheMlx.cpp,
// SkFontMgrMlx.cpp): std.fontconfig's matching (Fontconfig 2.15's, with
// fonts.conf's rules) of a family and a style, and the fallback font of a
// character, as a file and an index in it for Skia's FreeType typefaces.
const fc = @import("std.fontconfig")

extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void

// A font found: its file's path (a C string on the C library's heap) and
// its index in the file.
const Found = struct {
    path: usize
    index: i64
}

fn foundAt(address: usize) -> *Found { return unsafe { @ptrFromInt(*Found, address) } }

fn byteAt(address: usize, offset: usize) -> u8 { return unsafe { @ptrFromInt([*]const u8, address)[offset] } }

fn lengthOf(text: usize) -> usize {
    var length: usize = 0
    while byteAt(text, length) != 0 { length += 1 }
    return length
}

fn lowered(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// Whether the C strings A and B are the same but for ASCII's case.
fn sameIgnoringCase(a: usize, b: usize) -> bool {
    var at: usize = 0
    while true {
        const x = lowered(byteAt(a, at))
        const y = lowered(byteAt(b, at))
        if x != y { return false }
        if x == 0 { return true }
        at += 1
    }
    return false
}

// The font FONT (a pattern) as a Found; 0 without a file or memory.
fn foundOf(font: usize) -> usize {
    const path = fc.pattern.firstString(font, fc.objects.FILE)
    if path == 0 { return 0 }
    var index: i64 = 0
    if fc.pattern.getInteger(font, fc.objects.INDEX, 0, &index) != fc.pattern.RESULT_MATCH { index = 0 }
    const length = lengthOf(path)
    const copy = malloc(length + 1)
    if copy == 0 { return 0 }
    const to: [*]u8 = unsafe { @ptrFromInt([*]u8, copy) }
    var at: usize = 0
    while at <= length {
        to[at] = byteAt(path, at)
        at += 1
    }
    const address = malloc(@sizeOf(Found))
    if address == 0 {
        free(copy)
        return 0
    }
    foundAt(address).*.path = copy
    foundAt(address).*.index = index
    return address
}

// The pattern of a family (a C string, or 0 for any) and a style: the
// weight as OpenType's (100 to 900), the width and slant as Fontconfig's
// (FC_WIDTH_NORMAL 100, FC_SLANT_ITALIC 100...), with the configuration's
// substitutions and the defaults.
fn query(config: usize, family: usize, weight: i64, width: i64, slant: i64) -> usize {
    const p = fc.pattern.create()
    if p == 0 { return 0 }
    if family != 0 { _ = fc.pattern.addString(p, fc.objects.FAMILY, family) }
    _ = fc.pattern.addDouble(p, fc.objects.WEIGHT, fc.objects.weightFromOpenType(@floatFromInt(f64, weight)))
    _ = fc.pattern.addInteger(p, fc.objects.WIDTH, width)
    _ = fc.pattern.addInteger(p, fc.objects.SLANT, slant)
    _ = fc.config.substitute(config, p, fc.config.MATCH_PATTERN)
    fc.config.defaultSubstitute(p)
    return p
}

// Whether FAMILY (a C string) names a font by what it is, not its name:
// Fontconfig's aliases, which any font matching them answers.
fn isGeneric(family: usize) -> bool {
    const generics = [7][]const u8{ "serif", "sans-serif", "monospace", "cursive", "fantasy", "math", "system-ui" }
    for name in generics {
        var same = true
        var at: usize = 0
        while at < name.length {
            if lowered(byteAt(family, at)) != name[at] {
                same = false
                break
            }
            at += 1
        }
        if same && byteAt(family, name.length) == 0 { return true }
    }
    return false
}

// Whether the font FONT has the family FAMILY among its names.
fn hasFamily(font: usize, family: usize) -> bool {
    var id: i64 = 0
    while true {
        var name: usize = 0
        if fc.pattern.getString(font, fc.objects.FAMILY, id, &name) != fc.pattern.RESULT_MATCH { return false }
        if sameIgnoringCase(name, family) { return true }
        id += 1
    }
    return false
}

// The font of FAMILY nearest to the style; 0 when there is no such family
// (a family not installed is no font, as Skia's Fontconfig manager answers:
// CSS goes on to the next family), the nearest font of all for no family
// or a generic one. A family the configuration replaces by another (an
// alias assigned, as WebKit's test configuration makes "Times" "Liberation
// Serif") is that other's: the font is taken when it has the family the
// query has first after the configuration's substitutions, as WebKit's
// FreeType font cache compares the family after configuration with the
// family matched.
pub fn matchFamily(family: usize, weight: i64, width: i64, slant: i64) -> usize {
    const config = fc.load.current()
    if config == 0 { return 0 }
    const p = query(config, family, weight, width, slant)
    if p == 0 { return 0 }
    var result: i64 = 0
    const font = fc.matching.fontMatch(config, p, &result)
    if font == 0 {
        fc.pattern.destroy(p)
        return 0
    }
    var found: usize = 0
    const configured = fc.pattern.firstString(p, fc.objects.FAMILY)
    if family == 0 || isGeneric(family) || hasFamily(font, family) || (configured != 0 && hasFamily(font, configured)) { found = foundOf(font) }
    fc.pattern.destroy(p)
    fc.pattern.destroy(font)
    return found
}

// The fonts of the file PATH (a C string) added to those the matching
// finds, as an application's own (FcConfigAppFontAddFile): a test's fonts,
// as WebKit's test runners add theirs. False when it has no font.
pub fn addFile(path: usize) -> bool {
    const config = fc.load.current()
    if config == 0 || path == 0 { return false }
    return fc.load.appFontAddFile(config, path)
}

// The font nearest to the style that has CHARACTER, for the language
// LOCALE (a C string such as "ja", or 0); 0 when no font has it.
pub fn fallback(character: u32, locale: usize, weight: i64, width: i64, slant: i64) -> usize {
    const config = fc.load.current()
    if config == 0 { return 0 }
    const p = query(config, 0, weight, width, slant)
    if p == 0 { return 0 }
    if locale != 0 && byteAt(locale, 0) != 0 { _ = fc.pattern.addString(p, fc.objects.LANG, locale) }
    var result: i64 = 0
    const sorted = fc.matching.fontSort(config, p, false, 0, &result)
    fc.pattern.destroy(p)
    if sorted == 0 { return 0 }
    var found: usize = 0
    var index: usize = 0
    while index < fc.pattern.fontSetCount(sorted) {
        const font = fc.pattern.fontSetFont(sorted, index)
        var charset: usize = 0
        if fc.pattern.getPointer(font, fc.objects.CHARSET, 0, fc.objects.TYPE_CHARSET, &charset) == fc.pattern.RESULT_MATCH && fc.charset.hasChar(charset, @intCast(u64, character)) {
            found = foundOf(font)
            break
        }
        index += 1
    }
    fc.pattern.fontSetDestroy(sorted)
    return found
}

pub fn fontPath(found: usize) -> usize { return if found == 0 { 0 } else { foundAt(found).*.path } }
pub fn fontIndex(found: usize) -> i64 { return if found == 0 { 0 } else { foundAt(found).*.index } }

pub fn release(found: usize) -> void {
    if found == 0 { return }
    free(foundAt(found).*.path)
    free(found)
}
