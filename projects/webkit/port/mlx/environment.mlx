// The process's environment for the Mlx side's clients of the session
// bus and the Vulkan loader, which read their variables from a
// program's argument vector (std.process.environmentEntries: the
// entries after the arguments' NUL): the library has no main, so the
// entries come from /proc/self/environ, laid out as a vector of one
// argument ("voyager"), its NUL, the entries and their NUL.
const std = @import("std")
const fs = @import("../../../../std/bootstrap/fs.mlx")
extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void

pub const Vector = struct {
    vector: [*][*]const u8
    count: usize
    file: ?fs.ArrayList
}

// Reads the environment; false without memory (the vector is then not
// to be used).
pub fn read(v: *Vector) -> bool {
    v.*.file = fs.readFileAlloc("/proc/self/environ\x00".pointer, std.heap.allocator())
    v.*.count = 0
    var entries: usize = 0
    var bytes: [*]u8 = undefined
    var length: usize = 0
    if v.*.file != null {
        bytes = unsafe { @ptrCast([*]u8, v.*.file.?.items) }
        length = v.*.file.?.length
        var at: usize = 0
        while at < length {
            if bytes[at] == 0 { entries += 1 }
            at += 1
        }
    }
    const count = entries + 3
    const memory = malloc(count * @sizeOf([*]const u8))
    if memory == 0 { return false }
    const vector: [*][*]const u8 = unsafe { @ptrFromInt([*][*]const u8, memory) }
    vector[0] = "voyager\x00".pointer
    vector[1] = unsafe { @ptrFromInt([*]const u8, 0) }
    var index: usize = 2
    var start: usize = 0
    var at: usize = 0
    while at < length {
        if bytes[at] == 0 {
            vector[index] = &bytes[start]
            index += 1
            start = at + 1
        }
        at += 1
    }
    vector[index] = unsafe { @ptrFromInt([*]const u8, 0) }
    v.*.vector = vector
    v.*.count = count
    return true
}

// The vector as a program's arguments (one argument; the environment
// follows, as std.process finds it).
pub fn arguments(v: *Vector) -> [][*]const u8 {
    unsafe { return @ptrCast([*][*]const u8, v.*.vector)[0 .. 1] }
}

// The environment's entries, NUL-terminated, for the bus clients.
pub fn entries(v: *Vector) -> [*][*]const u8 {
    unsafe { return @ptrFromInt([*][*]const u8, @intFromPtr(v.*.vector) + 2 * @sizeOf([*]const u8)) }
}

pub fn release(v: *Vector) -> void {
    if v.*.count != 0 { free(@intFromPtr(v.*.vector)) }
    v.*.count = 0
    if v.*.file != null { fs.ArrayList.deinit(v.*.file.?) }
    v.*.file = null
}
