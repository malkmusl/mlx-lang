// The image decoders of the port's PNGImageDecoder, JPEGImageDecoder and
// WEBPImageDecoder (port/platform/image-decoders): std.png, std.jpeg and
// std.webp decode a whole file held in memory into 8-bit RGBA, kept on
// the C library's heap for the C++ side to copy into its frame.
const std = @import("std")
const png = @import("std.png")
const jpeg = @import("std.jpeg")
const webp = @import("std.webp")

extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void

// The formats, as MlxWebPort.h numbers them.
pub const PNG: u32 = 1
pub const JPEG: u32 = 2
pub const WEBP: u32 = 3

// A decoded image: `width` x `height` pixels of R, G, B, A (not
// premultiplied), and the EXIF orientation (1 to 8; 1 for none).
const Decoded = struct {
    width: usize
    height: usize
    pixels: usize
    orientation: u32
}

fn decodedAt(address: usize) -> *Decoded { return unsafe { @ptrFromInt(*Decoded, address) } }

// A copy of COUNT bytes at FROM on the C heap; 0 without memory.
fn copied(from: [*]const u8, count: usize) -> usize {
    const address = malloc(if count == 0 { 1 } else { count })
    if address == 0 { return 0 }
    const to: [*]u8 = unsafe { @ptrFromInt([*]u8, address) }
    var index: usize = 0
    while index < count {
        to[index] = from[index]
        index += 1
    }
    return address
}

// The image made of RGBA PIXELS, WIDTH x HEIGHT; 0 without memory.
fn made(pixels: [*]const u8, width: usize, height: usize, orientation: u32) -> usize {
    const address = malloc(@sizeOf(Decoded))
    if address == 0 { return 0 }
    const copy = copied(pixels, width * height * 4)
    if copy == 0 {
        free(address)
        return 0
    }
    const decoded = decodedAt(address)
    decoded.*.width = width
    decoded.*.height = height
    decoded.*.pixels = copy
    decoded.*.orientation = orientation
    return address
}

// The image of the LENGTH bytes at BYTES in the format KIND; 0 when they
// are not a whole image of that format (damaged, cut short, unsupported).
pub fn decode(kind: u32, bytes: usize, length: usize) -> usize {
    if bytes == 0 || length == 0 { return 0 }
    const data: [*]const u8 = unsafe { @ptrFromInt([*]const u8, bytes) }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if kind == PNG {
        var picture: png.Picture = undefined
        if png.decodeRgba(&picture, data, length, allocator) != png.Status.ok { return 0 }
        const result = made(picture.pixels, picture.width, picture.height, 1)
        png.deinitPicture(&picture)
        return result
    }
    if kind == JPEG {
        var picture: jpeg.Picture = undefined
        if jpeg.decodeRgba(&picture, data, length, allocator) != jpeg.Status.ok { return 0 }
        const result = made(picture.pixels, picture.width, picture.height, picture.orientation)
        jpeg.deinitPicture(&picture)
        return result
    }
    if kind == WEBP {
        var picture: webp.Picture = undefined
        if webp.decodeRgba(&picture, data, length, allocator) != webp.Status.ok { return 0 }
        const result = made(picture.pixels, picture.width, picture.height, 1)
        webp.deinitPicture(&picture)
        return result
    }
    return 0
}

pub fn width(image: usize) -> usize { return if image == 0 { 0 } else { decodedAt(image).*.width } }
pub fn height(image: usize) -> usize { return if image == 0 { 0 } else { decodedAt(image).*.height } }
pub fn pixels(image: usize) -> usize { return if image == 0 { 0 } else { decodedAt(image).*.pixels } }
pub fn orientation(image: usize) -> u32 { return if image == 0 { 1 } else { decodedAt(image).*.orientation } }

pub fn destroy(image: usize) -> void {
    if image == 0 { return }
    free(decodedAt(image).*.pixels)
    free(image)
}

// Writes WIDTH x HEIGHT pixels at PIXELS (premultiplied 0xAARRGGBB
// words, rows STRIDE words apart) as a PNG at PATH, a C string.
pub fn writePng(path: usize, pixels: usize, width: usize, height: usize, stride: usize, alpha: bool) -> bool {
    if path == 0 || pixels == 0 { return false }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    return png.saveFile(unsafe { @ptrFromInt([*]const u8, path) }, unsafe { @ptrFromInt([*]const u32, pixels) }, width, height, stride, alpha, allocator)
}
