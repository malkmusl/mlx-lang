// port/MlxWebPort.h
// The Mlx side of PlatformMlx as the port's C++ sees it: the functions of
// libmlxwebport.so (projects/webkit/port/mlx/webport.mlx), with the C ABI.
// Handles are addresses of state the Mlx side keeps on the C library's
// heap; a function given a null handle does nothing.

// Digests (std.sha1, std.sha2) for PAL's CryptoDigest. The algorithm is
// the digest's length in bits, 1 for SHA-1; create gives 0 for another.
pub const MLXWEB_DIGEST_SHA1: u32 = 1
pub const MLXWEB_DIGEST_SHA224: u32 = 224
pub const MLXWEB_DIGEST_SHA256: u32 = 256
pub const MLXWEB_DIGEST_SHA384: u32 = 384
pub const MLXWEB_DIGEST_SHA512: u32 = 512
pub extern("c") fn mlxweb_digest_create(algorithm: u32) -> usize
pub extern("c") fn mlxweb_digest_update(digest: usize, bytes: ?*const anyopaque, length: usize) -> void
// Writes the digest (at most 64 bytes) and gives its length.
pub extern("c") fn mlxweb_digest_finish(digest: usize, out: *u8) -> usize
pub extern("c") fn mlxweb_digest_destroy(digest: usize) -> void

// Image decoding (std.png, std.jpeg, std.webp) for the port's image
// decoders: a whole file in memory to 8-bit RGBA rows, not premultiplied;
// decode gives 0 for data that is not a whole image of the format.
pub const MLXWEB_IMAGE_PNG: u32 = 1
pub const MLXWEB_IMAGE_JPEG: u32 = 2
pub const MLXWEB_IMAGE_WEBP: u32 = 3
pub extern("c") fn mlxweb_image_decode(format: u32, bytes: ?*const anyopaque, length: usize) -> usize
pub extern("c") fn mlxweb_image_width(image: usize) -> usize
pub extern("c") fn mlxweb_image_height(image: usize) -> usize
pub extern("c") fn mlxweb_image_pixels(image: usize) -> ?*const u8
// The EXIF orientation, 1 to 8 (1: as stored).
pub extern("c") fn mlxweb_image_orientation(image: usize) -> u32
pub extern("c") fn mlxweb_image_destroy(image: usize) -> void
// A PNG file (std.png) of WIDTH x HEIGHT pixels, each a 32-bit word
// 0xAARRGGBB premultiplied (Skia's N32 on a little-endian machine), rows
// STRIDE pixels apart; written opaque (RGB) unless ALPHA. 1 when written.
pub extern("c") fn mlxweb_image_write_png(path: ?*const c_char, pixels: ?*const anyopaque, width: usize, height: usize, stride: usize, alpha: u32) -> u32

// Fonts (std.fontconfig, with fonts.conf's rules) for the port's font
// manager: the font of a family (a UTF-8 C string, or null for any)
// nearest to a style, or 0 when no font has that family (a generic family,
// "serif", "monospace"..., always has one; a family the configuration
// assigns another for is that other's); the font nearest to a style that
// has a character, for a language (BCP 47, or null). The weight is
// OpenType's (100 to 900); the width and slant Fontconfig's (FC_WIDTH_*:
// 50 to 200, 100 normal; FC_SLANT_*: 0 roman, 100 italic, 110 oblique).
pub extern("c") fn mlxweb_font_match(family: ?*const c_char, weight: i32, width: i32, slant: i32) -> usize
pub extern("c") fn mlxweb_font_fallback(character: u32, locale: ?*const c_char, weight: i32, width: i32, slant: i32) -> usize
// The font's file and its index in the file (a collection's).
pub extern("c") fn mlxweb_font_path(font: usize) -> ?*const c_char
pub extern("c") fn mlxweb_font_index(font: usize) -> i32
pub extern("c") fn mlxweb_font_release(font: usize) -> void
// The fonts of a file added to those matched, as an application's own
// (a test runner's test fonts); 0 when the file has no font.
pub extern("c") fn mlxweb_font_add_file(path: ?*const c_char) -> u32

// Public suffixes (std.http.psl) for PublicSuffixStore: whether a lower
// case domain is a public suffix (without the implicit "*" rule), and
// where a host's base domain starts in it, or MLXWEB_PSL_NO_BASE_DOMAIN
// (its suffix is not listed), MLXWEB_PSL_NOT_ENOUGH_DOMAINS (it is itself
// a public suffix).
pub const MLXWEB_PSL_NO_BASE_DOMAIN: i64 = -1
pub const MLXWEB_PSL_NOT_ENOUGH_DOMAINS: i64 = -2
pub extern("c") fn mlxweb_psl_is_public_suffix(domain: ?*const c_char, length: usize) -> u32
pub extern("c") fn mlxweb_psl_base_domain(host: ?*const c_char, length: usize) -> i64

// Files (std.fs) for file: URLs: a regular file read whole, or 0 with the
// reason in REASON (MLXWEB_FILE_NOT_FOUND: no such file, or no regular
// file; MLXWEB_FILE_NOT_READ: it could not be read).
pub const MLXWEB_FILE_NOT_FOUND: u32 = 1
pub const MLXWEB_FILE_NOT_READ: u32 = 2
pub extern("c") fn mlxweb_file_read(path: ?*const c_char, reason: *u32) -> usize
pub extern("c") fn mlxweb_file_bytes(contents: usize) -> ?*const u8
pub extern("c") fn mlxweb_file_length(contents: usize) -> usize
pub extern("c") fn mlxweb_file_release(contents: usize) -> void

// http: and https: (std.http's client, std.tls, the cookie jar of
// std.http.cookiejar) for the port's loader, called from one thread: a
// request runs whole (redirects not followed: a 3xx comes back) and gives
// an answer, 0 without memory. HEADERS are "Name: value\r\n" lines.
pub const MLXWEB_HTTP_BAD_URL: u32 = 1
pub const MLXWEB_HTTP_CONNECT: u32 = 2
pub const MLXWEB_HTTP_TLS: u32 = 3
pub const MLXWEB_HTTP_RECEIVE: u32 = 4
pub const MLXWEB_HTTP_OTHER: u32 = 5
// (MLXWEB_CACHE_ONLY's request when the cache has no entry for it.)
pub const MLXWEB_HTTP_NOT_CACHED: u32 = 6
// The HTTP cache's modes (WebCore's ResourceRequestCachePolicy): DEFAULT
// answers from a fresh entry, revalidates a stale one and stores what may
// be; RELOAD loads and stores; PREFER answers from any entry, else loads;
// ONLY answers from any entry, else MLXWEB_HTTP_NOT_CACHED; BYPASS neither
// reads nor stores; REVALIDATE revalidates even a fresh entry.
pub const MLXWEB_CACHE_DEFAULT: u32 = 0
pub const MLXWEB_CACHE_RELOAD: u32 = 1
pub const MLXWEB_CACHE_PREFER: u32 = 2
pub const MLXWEB_CACHE_ONLY: u32 = 3
pub const MLXWEB_CACHE_BYPASS: u32 = 4
pub const MLXWEB_CACHE_REVALIDATE: u32 = 5
pub extern("c") fn mlxweb_http_request(method: ?*const c_char, url: ?*const c_char, headers: ?*const c_char, body: ?*const anyopaque, bodyLength: usize, hasBody: u32, cacheMode: u32) -> usize
// 0, or why there is no response (MLXWEB_HTTP_*).
pub extern("c") fn mlxweb_http_error(answer: usize) -> u32
pub extern("c") fn mlxweb_http_status(answer: usize) -> u32
// The head as it came: the status line and the header lines.
pub extern("c") fn mlxweb_http_head(answer: usize) -> ?*const c_char
pub extern("c") fn mlxweb_http_head_length(answer: usize) -> usize
// The body, its content coding (gzip, deflate) undone.
pub extern("c") fn mlxweb_http_body(answer: usize) -> ?*const u8
pub extern("c") fn mlxweb_http_body_length(answer: usize) -> usize
pub extern("c") fn mlxweb_http_release(answer: usize) -> void
// A request whose body, when long or of no known length, is left on its
// connection (has_stream 1) once the head is in: read on any one thread
// with stream_read, which calls PIECE(CONTEXT, bytes, length) with each
// piece (0 from it stops: 1 back; 2 when the connection failed, 0 when
// all came). stream_length is the length the head gave (-1: none). Such
// a body is not stored in the HTTP cache.
pub extern("c") fn mlxweb_http_request_streamed(method: ?*const c_char, url: ?*const c_char, headers: ?*const c_char, body: ?*const anyopaque, bodyLength: usize, hasBody: u32, cacheMode: u32) -> usize
pub extern("c") fn mlxweb_http_has_stream(answer: usize) -> u32
pub extern("c") fn mlxweb_http_stream_length(answer: usize) -> i64
pub extern("c") fn mlxweb_http_stream_read(answer: usize, piece: usize, context: usize) -> u32
// Where the answer came from: the network (0), the HTTP cache with no
// request sent (1), the cache after the server's 304 (2).
pub const MLXWEB_SOURCE_NETWORK: u32 = 0
pub const MLXWEB_SOURCE_CACHE: u32 = 1
pub const MLXWEB_SOURCE_REVALIDATED: u32 = 2
pub extern("c") fn mlxweb_http_source(answer: usize) -> u32
// The profile (MlxProfile.cpp), on the network's thread: the cookie
// database COOKIES (its cookies read into the jar, which writes each change
// back) and the HTTP cache's directory CACHE; an empty path: none.
pub extern("c") fn mlxweb_profile_open(cookies: ?*const c_char, cache: ?*const c_char) -> void
pub extern("c") fn mlxweb_profile_close() -> void
// The cookies for a URL as a Cookie header lists them (FOR_HTTP 0: those a
// script may read), a C string freed with mlxweb_text_release, or null.
pub extern("c") fn mlxweb_cookies_for(url: ?*const c_char, forHttp: u32) -> ?*c_char
// A cookie a script of URL sets (document.cookie = LINE).
pub extern("c") fn mlxweb_cookie_set(url: ?*const c_char, line: ?*const c_char) -> void
pub extern("c") fn mlxweb_text_release(text: ?*c_char) -> void

// WebSockets (ws:) for the port's socket provider: connect runs the
// opening handshake (0: none); one thread receives (blocking until a whole
// message, the server's close, or the end), others send and close;
// shutdown wakes a blocked receive, release ends the socket after.
pub const MLXWEB_WS_ERROR: u32 = 0
pub const MLXWEB_WS_TEXT: u32 = 1
pub const MLXWEB_WS_BINARY: u32 = 2
pub const MLXWEB_WS_CLOSE: u32 = 8
pub extern("c") fn mlxweb_ws_connect(url: ?*const c_char, protocols: ?*const c_char) -> usize
// The server's subprotocol and extensions (C strings the socket keeps).
pub extern("c") fn mlxweb_ws_protocol(socket: usize) -> ?*const c_char
pub extern("c") fn mlxweb_ws_extensions(socket: usize) -> ?*const c_char
pub extern("c") fn mlxweb_ws_send(socket: usize, binary: u32, bytes: ?*const anyopaque, length: usize) -> u32
pub extern("c") fn mlxweb_ws_close(socket: usize, code: u32, reason: ?*const c_char) -> void
pub extern("c") fn mlxweb_ws_receive(socket: usize) -> usize
pub extern("c") fn mlxweb_ws_message_kind(message: usize) -> u32
// A close's code (1006: the connection ended without one).
pub extern("c") fn mlxweb_ws_message_code(message: usize) -> u32
pub extern("c") fn mlxweb_ws_message_bytes(message: usize) -> ?*const u8
pub extern("c") fn mlxweb_ws_message_length(message: usize) -> usize
pub extern("c") fn mlxweb_ws_message_release(message: usize) -> void
pub extern("c") fn mlxweb_ws_shutdown(socket: usize) -> void
pub extern("c") fn mlxweb_ws_release(socket: usize) -> void

// std.ui.theme's palettes for the port's theme (RenderThemeMlx.cpp,
// ControlFactoryMlx.cpp): the colour WHICH of the dark palette (DARK 1) or
// the light one, 0xAARRGGBB not premultiplied (0 for another WHICH).
pub const MLXWEB_THEME_BACKGROUND: u32 = 0
pub const MLXWEB_THEME_PANEL: u32 = 1
pub const MLXWEB_THEME_RAISED: u32 = 2
pub const MLXWEB_THEME_FIELD: u32 = 3
pub const MLXWEB_THEME_HOVER: u32 = 4
pub const MLXWEB_THEME_PRESSED: u32 = 5
pub const MLXWEB_THEME_SELECTED: u32 = 6
pub const MLXWEB_THEME_DIVIDER: u32 = 7
pub const MLXWEB_THEME_BORDER: u32 = 8
pub const MLXWEB_THEME_TEXT: u32 = 9
pub const MLXWEB_THEME_DIM: u32 = 10
pub const MLXWEB_THEME_DISABLED: u32 = 11
pub const MLXWEB_THEME_ON_ACCENT: u32 = 12
pub const MLXWEB_THEME_ACCENT: u32 = 13
pub const MLXWEB_THEME_DANGER: u32 = 14
pub const MLXWEB_THEME_CONTROL: u32 = 15
pub const MLXWEB_THEME_CONTROL_INNER: u32 = 16
pub const MLXWEB_THEME_BUTTON: u32 = 17
pub const MLXWEB_THEME_BUTTON_HOVER: u32 = 18
pub const MLXWEB_THEME_PRIMARY: u32 = 19
pub const MLXWEB_THEME_PRIMARY_HOVER: u32 = 20
pub const MLXWEB_THEME_SWITCH_OFF: u32 = 21
pub const MLXWEB_THEME_SWITCH_OFF_HOVER: u32 = 22
pub const MLXWEB_THEME_KNOB: u32 = 23
pub const MLXWEB_THEME_TRACK: u32 = 24
pub const MLXWEB_THEME_THUMB: u32 = 25
pub const MLXWEB_THEME_INDICATOR: u32 = 26
pub const MLXWEB_THEME_SELECTION: u32 = 27
pub const MLXWEB_THEME_CARET: u32 = 28
pub extern("c") fn mlxweb_theme_color(dark: u32, which: u32) -> u32

// WebCrypto (port/crypto/mlx over std.crypto, std.aes, std.asn1,
// std.random: crypto.mlx). Hashes are numbered as the digests above;
// curves by their bits (256, 384, 521). Functions answering u32 give 1
// for done, 0 for refused (a bad key, a tag or padding that does not
// check, a point off the curve). Byte strings of no size known
// beforehand come as parts: count them, read each (its bytes stay the
// parts' until released), release them.
pub const MLXWEB_CRYPTO_KIND_RSA: u32 = 1
pub const MLXWEB_CRYPTO_KIND_EC: u32 = 2
pub const MLXWEB_CRYPTO_KIND_ED25519: u32 = 3
pub const MLXWEB_CRYPTO_KIND_X25519: u32 = 4
// (Read only: an EC key under id-ecDH, for ECDH alone.)
pub const MLXWEB_CRYPTO_KIND_ECDH: u32 = 5
pub const MLXWEB_CRYPTO_RSA_PKCS1: u32 = 1
pub const MLXWEB_CRYPTO_RSA_PSS: u32 = 2
// The kernel's random bytes (getrandom).
pub extern("c") fn mlxweb_crypto_random(out: ?*anyopaque, length: usize) -> u32
// A digest, an HMAC (at most 64 bytes written): its length, 0 for an
// unknown hash.
pub extern("c") fn mlxweb_crypto_digest(algorithm: u32, data: ?*const anyopaque, length: usize, out: ?*u8) -> usize
pub extern("c") fn mlxweb_crypto_hmac(algorithm: u32, key: ?*const anyopaque, keyLength: usize, data: ?*const anyopaque, length: usize, out: ?*u8) -> usize
pub extern("c") fn mlxweb_crypto_hkdf(algorithm: u32, key: ?*const anyopaque, keyLength: usize, salt: ?*const anyopaque, saltLength: usize, info: ?*const anyopaque, infoLength: usize, out: ?*u8, length: usize) -> u32
pub extern("c") fn mlxweb_crypto_pbkdf2(algorithm: u32, password: ?*const anyopaque, passwordLength: usize, salt: ?*const anyopaque, saltLength: usize, iterations: u64, out: ?*u8, length: usize) -> u32
// AES-CBC (PKCS #7 padding when PADDING; OUT has room for LENGTH + 16,
// WRITTEN gets the result's length), CFB-8, CTR (the counter block's
// last COUNTERBITS bits count), GCM (the tag after the ciphertext both
// ways), KW (8 bytes more or fewer).
pub extern("c") fn mlxweb_crypto_aes_cbc(encrypt: u32, padding: u32, key: ?*const anyopaque, keyLength: usize, iv: ?*const anyopaque, data: ?*const anyopaque, length: usize, out: ?*u8, written: *usize) -> u32
pub extern("c") fn mlxweb_crypto_aes_cfb8(encrypt: u32, key: ?*const anyopaque, keyLength: usize, iv: ?*const anyopaque, data: ?*const anyopaque, length: usize, out: ?*u8) -> u32
pub extern("c") fn mlxweb_crypto_aes_ctr(key: ?*const anyopaque, keyLength: usize, counter: ?*const anyopaque, counterBits: usize, data: ?*const anyopaque, length: usize, out: ?*u8) -> u32
pub extern("c") fn mlxweb_crypto_aes_gcm(encrypt: u32, key: ?*const anyopaque, keyLength: usize, iv: ?*const anyopaque, ivLength: usize, aad: ?*const anyopaque, aadLength: usize, tagLength: usize, data: ?*const anyopaque, length: usize, out: ?*u8) -> u32
pub extern("c") fn mlxweb_crypto_aes_kw(wrap: u32, key: ?*const anyopaque, keyLength: usize, data: ?*const anyopaque, length: usize, out: ?*u8) -> u32
// The NIST curves: a scalar is ec_size bytes, a point 1 + 2 * ec_size
// (uncompressed); a signature r | s.
pub extern("c") fn mlxweb_crypto_ec_size(curve: u32) -> usize
pub extern("c") fn mlxweb_crypto_ec_generate(curve: u32, scalar: ?*u8, point: ?*u8) -> u32
pub extern("c") fn mlxweb_crypto_ec_public(curve: u32, scalar: ?*const anyopaque, point: ?*u8) -> u32
// A point (compressed or not) checked to be on the curve, uncompressed.
pub extern("c") fn mlxweb_crypto_ec_point(curve: u32, point: ?*const anyopaque, length: usize, out: ?*u8) -> u32
pub extern("c") fn mlxweb_crypto_ecdsa_sign(curve: u32, algorithm: u32, scalar: ?*const anyopaque, data: ?*const anyopaque, length: usize, out: ?*u8) -> u32
pub extern("c") fn mlxweb_crypto_ecdsa_verify(curve: u32, algorithm: u32, point: ?*const anyopaque, pointLength: usize, data: ?*const anyopaque, length: usize, signature: ?*const anyopaque, signatureLength: usize) -> u32
pub extern("c") fn mlxweb_crypto_ecdh(curve: u32, scalar: ?*const anyopaque, point: ?*const anyopaque, pointLength: usize, out: ?*u8) -> u32
// Ed25519 (a 32-byte seed, a 32-byte key, 64-byte signatures) and X25519
// (U null: the base point; 0 for an all-zero result).
pub extern("c") fn mlxweb_crypto_ed25519_public(seed: ?*const anyopaque, out: ?*u8) -> void
pub extern("c") fn mlxweb_crypto_ed25519_sign(seed: ?*const anyopaque, data: ?*const anyopaque, length: usize, out: ?*u8) -> void
pub extern("c") fn mlxweb_crypto_ed25519_verify(key: ?*const anyopaque, data: ?*const anyopaque, length: usize, signature: ?*const anyopaque, signatureLength: usize) -> u32
pub extern("c") fn mlxweb_crypto_x25519(scalar: ?*const anyopaque, u: ?*const anyopaque, out: ?*u8) -> u32
// RSA: a key from parts n, e (public) or n, e, d, p, q (private; then
// the other primes of a multi-prime key), 0 when they make none (up to
// 16384 bits); generate (slow: off the main thread) gives parts n, e, d,
// p, q, dp, dq, qi.
pub extern("c") fn mlxweb_crypto_rsa_key(parts: usize) -> usize
pub extern("c") fn mlxweb_crypto_rsa_release(key: usize) -> void
pub extern("c") fn mlxweb_crypto_rsa_bits(key: usize) -> usize
pub extern("c") fn mlxweb_crypto_rsa_generate(bits: usize, exponent: ?*const anyopaque, exponentLength: usize) -> usize
// A signature (the modulus's bytes): its length, 0 when refused.
pub extern("c") fn mlxweb_crypto_rsa_sign(key: usize, scheme: u32, algorithm: u32, saltLength: usize, data: ?*const anyopaque, length: usize, out: ?*u8) -> usize
pub extern("c") fn mlxweb_crypto_rsa_verify(key: usize, scheme: u32, algorithm: u32, saltLength: usize, data: ?*const anyopaque, length: usize, signature: ?*const anyopaque, signatureLength: usize) -> u32
pub extern("c") fn mlxweb_crypto_rsa_oaep(encrypt: u32, key: usize, algorithm: u32, label: ?*const anyopaque, labelLength: usize, data: ?*const anyopaque, length: usize, out: ?*u8, written: *usize) -> u32
// Keys as DER: read gives parts [kind, curve's two bytes] then the
// key's numbers or bytes; write takes the key's parts and gives one.
pub extern("c") fn mlxweb_crypto_spki_read(der: ?*const anyopaque, length: usize) -> usize
pub extern("c") fn mlxweb_crypto_pkcs8_read(der: ?*const anyopaque, length: usize) -> usize
pub extern("c") fn mlxweb_crypto_spki_write(kind: u32, curve: u32, key: usize) -> usize
pub extern("c") fn mlxweb_crypto_pkcs8_write(kind: u32, curve: u32, key: usize) -> usize
pub extern("c") fn mlxweb_crypto_parts_create() -> usize
pub extern("c") fn mlxweb_crypto_parts_add(parts: usize, bytes: ?*const anyopaque, length: usize) -> void
pub extern("c") fn mlxweb_crypto_parts_count(parts: usize) -> usize
pub extern("c") fn mlxweb_crypto_parts_at(parts: usize, index: usize, length: *usize) -> ?*const u8
pub extern("c") fn mlxweb_crypto_parts_release(parts: usize) -> void

// A download's files (port/mlx/download.mlx): create makes the partial
// file "NAME.EXT.download" in DIRECTORY for a final NAME.EXT free there
// (else "NAME (N).EXT"); reopen opens a partial file again to go on (KEEP
// 1: at its end; 0: emptied); write adds bytes (on any one thread);
// finish closes it, KEEP 0 removing it, 1 keeping it (paused), 2
// renaming it to its final name (path is then the name it took); release
// frees the handle; size is a file's (-1: none); remove removes one.
pub extern("c") fn mlxweb_download_create(directory: ?*const c_char, name: ?*const c_char) -> usize
pub extern("c") fn mlxweb_download_reopen(partial: ?*const c_char, final: ?*const c_char, keep: u32) -> usize
pub extern("c") fn mlxweb_download_size(path: ?*const c_char) -> i64
pub extern("c") fn mlxweb_download_write(file: usize, bytes: ?*const anyopaque, length: usize) -> u32
pub extern("c") fn mlxweb_download_partial_path(file: usize) -> ?*const c_char
pub extern("c") fn mlxweb_download_path(file: usize) -> ?*const c_char
pub extern("c") fn mlxweb_download_finish(file: usize, keep: u32) -> u32
pub extern("c") fn mlxweb_download_release(file: usize) -> void
pub extern("c") fn mlxweb_download_remove(path: ?*const c_char) -> u32

// Media (std.mp4, std.aac, std.h264, std.audio) for the port's
// MediaPlayerPrivateMlx. Statuses: 0 ok, 1 needs more bytes (or, of an
// access unit, no slice), 2 damaged, 3 unsupported, 4 out of memory.
pub const MLXWEB_MEDIA_OK: u32 = 0
pub const MLXWEB_MEDIA_NEED_MORE: u32 = 1
pub const MLXWEB_MEDIA_CORRUPT: u32 = 2
pub const MLXWEB_MEDIA_UNSUPPORTED: u32 = 3
pub const MLXWEB_MEDIA_NO_MEMORY: u32 = 4
// Track kinds and codecs (std.mp4's).
pub const MLXWEB_MEDIA_VIDEO: u32 = 1
pub const MLXWEB_MEDIA_AUDIO: u32 = 2
pub const MLXWEB_MEDIA_H264: u32 = 1
pub const MLXWEB_MEDIA_H265: u32 = 2
pub const MLXWEB_MEDIA_VP9: u32 = 3
pub const MLXWEB_MEDIA_AV1: u32 = 4
pub const MLXWEB_MEDIA_AAC: u32 = 16
pub const MLXWEB_MEDIA_OPUS: u32 = 17
// A sample: where its bytes are in what was parsed (a file offset for a
// plain file, an offset into the segment given to parse), its times in
// the track's timescale.
pub const mlxweb_media_sample = struct {
    offset: u64
    size: u64
    dts: u64
    pts: i64
    duration: u32
    track: u32
    sync: u32
    reserved: u32
}
// An MP4 demuxer: parse takes a whole file, an initialization segment or
// media segments (whole top-level boxes are consumed: `used`); a
// fragment's samples are listed until clear_samples; a plain file's
// samples come from next_sample per track.
pub extern("c") fn mlxweb_media_demuxer_create() -> usize
pub extern("c") fn mlxweb_media_demuxer_destroy(demuxer: usize) -> void
pub extern("c") fn mlxweb_media_demuxer_parse(demuxer: usize, bytes: ?*const anyopaque, length: usize, used: ?*usize) -> u32
pub extern("c") fn mlxweb_media_track_count(demuxer: usize) -> usize
pub extern("c") fn mlxweb_media_track_kind(demuxer: usize, track: usize) -> u32
pub extern("c") fn mlxweb_media_track_codec(demuxer: usize, track: usize) -> u32
pub extern("c") fn mlxweb_media_track_timescale(demuxer: usize, track: usize) -> u32
pub extern("c") fn mlxweb_media_track_duration(demuxer: usize, track: usize) -> u64
pub extern("c") fn mlxweb_media_track_width(demuxer: usize, track: usize) -> u32
pub extern("c") fn mlxweb_media_track_height(demuxer: usize, track: usize) -> u32
