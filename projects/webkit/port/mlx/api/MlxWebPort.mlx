pub extern("c") fn mlxweb_media_track_nal_length_size(demuxer: usize, track: usize) -> u32
// The codec configuration (avcC, hvcC, AudioSpecificConfig, ...), kept
// by the demuxer: its bytes, the length stored.
pub extern("c") fn mlxweb_media_track_config(demuxer: usize, track: usize, length: ?*usize) -> ?*const u8
// Parameter set `set` (SPSs then PPSs) of an AVC track, without a start
// code; null when there is none.
pub extern("c") fn mlxweb_media_track_parameter_set(demuxer: usize, track: usize, set: usize, length: ?*usize) -> ?*const u8
pub extern("c") fn mlxweb_media_next_sample(demuxer: usize, track: usize, out: ?*mlxweb_media_sample) -> u32
pub extern("c") fn mlxweb_media_seek(demuxer: usize, track: usize, time: u64) -> void
pub extern("c") fn mlxweb_media_sample_count(demuxer: usize) -> usize
pub extern("c") fn mlxweb_media_sample_at(demuxer: usize, index: usize, out: ?*mlxweb_media_sample) -> u32
pub extern("c") fn mlxweb_media_clear_samples(demuxer: usize) -> void
// A length-prefixed AVC sample in Annex B form: the size needed, and
// the bytes written into out (0: damaged or too small).
pub extern("c") fn mlxweb_media_annexb_size(demuxer: usize, track: usize, sample: ?*const anyopaque, length: usize) -> usize
pub extern("c") fn mlxweb_media_annexb(demuxer: usize, track: usize, sample: ?*const anyopaque, length: usize, out: ?*u8, capacity: usize) -> usize
// AAC-LC: a decoder configured by an AudioSpecificConfig; decode gives
// 1024 interleaved float samples per channel (room for 8 channels) and
// the channels, 0 for a damaged block.
pub extern("c") fn mlxweb_media_aac_create(config: ?*const anyopaque, length: usize) -> usize
pub extern("c") fn mlxweb_media_aac_destroy(decoder: usize) -> void
pub extern("c") fn mlxweb_media_aac_rate(decoder: usize) -> u32
pub extern("c") fn mlxweb_media_aac_reset(decoder: usize) -> void
pub extern("c") fn mlxweb_media_aac_decode(decoder: usize, bytes: ?*const anyopaque, length: usize, out: ?*f32) -> u32
// H.264: the pictures of a stream in decoding and output order (the
// slots of the decoded picture buffer); the pictures' decoding is the
// caller's.
pub extern("c") fn mlxweb_media_h264_create() -> usize
pub extern("c") fn mlxweb_media_h264_destroy(decoder: usize) -> void
pub extern("c") fn mlxweb_media_h264_parameter_set(decoder: usize, bytes: ?*const anyopaque, length: usize) -> u32
pub extern("c") fn mlxweb_media_h264_access_unit(decoder: usize, bytes: ?*const anyopaque, length: usize, prefix: usize) -> u32
pub extern("c") fn mlxweb_media_h264_picture_slot(decoder: usize) -> u32
pub extern("c") fn mlxweb_media_h264_picture_poc(decoder: usize) -> i32
pub extern("c") fn mlxweb_media_h264_picture_width(decoder: usize) -> u32
pub extern("c") fn mlxweb_media_h264_picture_height(decoder: usize) -> u32
pub extern("c") fn mlxweb_media_h264_finish_picture(decoder: usize) -> void
pub extern("c") fn mlxweb_media_h264_next_output(decoder: usize, slot: ?*u32, poc: ?*i32) -> u32
pub extern("c") fn mlxweb_media_h264_flush(decoder: usize) -> void
// The GPU's H.264 decoder (std.gpu.video over Vulkan video): open gives
// 0 when no device decodes H.264. decode takes the picture an H.264
// decoder's access_unit just read (the same bytes, before
// finish_picture); read_frame the frame of a slot next_output gave,
// as BGRA rows STRIDE bytes apart, width x height pixels (1 when read):
// before the next access_unit, which may reuse the slot.
pub extern("c") fn mlxweb_video_open() -> usize
pub extern("c") fn mlxweb_video_close(decoder: usize) -> void
pub extern("c") fn mlxweb_video_decode(decoder: usize, h264: usize, bytes: ?*const anyopaque) -> u32
pub extern("c") fn mlxweb_video_width(decoder: usize) -> u32
pub extern("c") fn mlxweb_video_height(decoder: usize) -> u32
pub extern("c") fn mlxweb_video_read_frame(decoder: usize, slot: u32, out: ?*anyopaque, stride: usize) -> u32
// The desktop's media controls: Voyager as an MPRIS player on MLXIPC
// (org.mpris.MediaPlayer2.voyager). open takes the name (0 without a
// bus); update tells what plays (the status, the track's strings as
// pointer and length, its length and position in microseconds, what the
// player can do; SEEKED when the position jumped) and announces changes;
// poll, from the main thread now and then, answers the bus and gives one
// command (1, with its kind and, for the seeks, its microseconds).
pub const MLXWEB_MEDIA_STOPPED: u32 = 0
pub const MLXWEB_MEDIA_PLAYING: u32 = 1
pub const MLXWEB_MEDIA_PAUSED: u32 = 2
pub const MLXWEB_MEDIA_COMMAND_PLAY: u32 = 1
pub const MLXWEB_MEDIA_COMMAND_PAUSE: u32 = 2
pub const MLXWEB_MEDIA_COMMAND_PLAY_PAUSE: u32 = 3
pub const MLXWEB_MEDIA_COMMAND_STOP: u32 = 4
pub const MLXWEB_MEDIA_COMMAND_NEXT: u32 = 5
pub const MLXWEB_MEDIA_COMMAND_PREVIOUS: u32 = 6
pub const MLXWEB_MEDIA_COMMAND_SEEK_TO: u32 = 7
pub const MLXWEB_MEDIA_COMMAND_SEEK_BY: u32 = 8
pub const MLXWEB_MEDIA_COMMAND_RAISE: u32 = 9
pub extern("c") fn mlxweb_media_session_open() -> usize
pub extern("c") fn mlxweb_media_session_close(session: usize) -> void
pub extern("c") fn mlxweb_media_session_update(session: usize, status: u32, title: ?*const c_char, title_length: usize, artist: ?*const c_char, artist_length: usize, album: ?*const c_char, album_length: usize, art_url: ?*const c_char, art_url_length: usize, url: ?*const c_char, url_length: usize, length: i64, position: i64, can_seek: u32, can_next: u32, can_previous: u32, seeked: u32) -> void
// The track's cover (premultiplied BGRA words, rows `stride` words apart) written as a PNG for the controls: its file:// URL into `url` (`capacity` bytes), the length, 0 when not written.
pub extern("c") fn mlxweb_media_session_cover(session: usize, pixels: ?*const u32, width: usize, height: usize, stride: usize, url: ?*c_char, capacity: usize) -> usize
pub extern("c") fn mlxweb_media_session_poll(session: usize, kind: ?*u32, time: ?*i64) -> u32
pub extern("c") fn mlxweb_media_session_connected(session: usize) -> u32
// Sound through MLX Audio: a playback stream of interleaved 32-bit
// floats; write blocks as the server takes the frames (call it from a
// thread of its own); written counts the frames handed over.
pub extern("c") fn mlxweb_audio_open(rate: u32, channels: u32, latency_milliseconds: u32) -> usize
pub extern("c") fn mlxweb_audio_close(output: usize) -> void
pub extern("c") fn mlxweb_audio_write(output: usize, samples: ?*const f32, frames: usize) -> u32
pub extern("c") fn mlxweb_audio_written(output: usize) -> u64
pub extern("c") fn mlxweb_audio_drain(output: usize) -> void
pub extern("c") fn mlxweb_audio_set_volume(output: usize, volume: u32) -> void
pub extern("c") fn mlxweb_audio_device_rate(output: usize) -> u32
