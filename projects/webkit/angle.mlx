// ANGLE (Source/ThirdParty/ANGLE), the OpenGL ES implementation WPE's
// WebGL runs on, as WebKit's CMake builds it for the WPE port: the
// configuration (ANGLE.cmake's defines and include directories, the GL
// backend over EGL, the ESSL and GLSL translators), and the headers it
// gives WebCore (ANGLE/Headers, made as adjust-angle-include-paths.py
// makes them). The sources are lists/angle.txt (libANGLE.a, CMake's
// ANGLE target: common, the translator, libANGLE with its GL renderer,
// image_util, gpu_info_util, xxhash, zlib's wrapper) and
// lists/angle-glesv2.txt (libGLESv2.a: the entry points), in the order
// WebKit's build archives them. ANGLE ships its generated sources
// (the *_autogen files, WebKit/ANGLEShaderProgramVersion.h): nothing
// is generated to build it.
const std = @import("std")
const Build = @import("std.build")

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

// The flags of ANGLE's sources (ROOT is Source/ThirdParty/ANGLE), C and
// C++ alike, for the library IMPLEMENTATION defines
// (LIBANGLE_IMPLEMENTATION, LIBGLESV2_IMPLEMENTATION). The reference
// build's defines that no ANGLE source reads (WebKit's BUILDING_*,
// HAVE_CONFIG_H, GETTEXT_PACKAGE, JSC_GLIB_API_ENABLED, PAS_BMALLOC,
// _GLIBCXX_ASSERTIONS) are left out.
pub fn flags(b: *Build.Builder, root: []const u8, implementation: []const u8) -> []const u8 {
    var line = "-DANGLE_ENABLE_ESSL -DANGLE_ENABLE_GLSL -DANGLE_ENABLE_OPENGL -DANGLE_PLATFORM_LINUX -DEGL_EGL_PROTOTYPES=0 -DEGL_NO_PLATFORM_SPECIFIC_TYPES -DGL_GLES_PROTOTYPES=0 -DUSE_SYSTEM_EGL -DNDEBUG"
    line = join3(b, line, " -D", implementation)
    const directories = [7][]const u8{ "/WebKit", "/include", "/include/KHR", "/src", "/src/common/base", "/src/common/third_party/xxhash", "/third_party/zlib/google" }
    for directory in directories { line = join3(b, line, " -I", Build.concat(b, root, directory)) }
    return line
}

// The flags a C++ source adds: the language, and ANGLEPrefix.h (CMake's
// precompiled header of both targets) included first.
pub fn cppFlags(b: *Build.Builder, root: []const u8) -> []const u8 {
    return join3(b, " -std=c++23 -include ", root, "/ANGLEPrefix.h")
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && std.text.same(text[0..prefix.length], prefix)
}

// adjust-angle-include-paths.py's replacement of one line: `#include
// <EGL/egl.h>` (or GLES*, KHR, any `../` before) as `#include
// <ANGLE/egl.h>`, the ANGLE headers named alone likewise; "" when the
// line stays.
fn adjusted(b: *Build.Builder, line: []const u8) -> []const u8 {
    if !startsWith(line, "#include ") || line.length < 11 { return "" }
    const open = line[9]
    if open != 60 && open != 34 { return "" }
    // (`.*` then `[>"]`: up to the line's last `>` or `"`.)
    var close = line.length
    while close > 10 && line[close - 1] != 62 && line[close - 1] != 34 { close -= 1 }
    if close <= 10 { return "" }
    var header = line[10..close - 1]
    var rest = header
    while startsWith(rest, "../") { rest = rest[3..rest.length] }
    const groups = [5][]const u8{ "EGL/", "GLES/", "GLES2/", "GLES3/", "KHR/" }
    for group in groups {
        if startsWith(rest, group) { return join3(b, "#include <ANGLE/", rest[group.length..rest.length], ">\n") }
    }
    const named = [3][]const u8{ "eglext_angle.h", "gl2ext_angle.h", "ShaderVars.h" }
    for name in named {
        if startsWith(header, name) { return join3(b, "#include <ANGLE/", name, ">\n") }
    }
    if std.text.same(header, "export.h") { return "#include <ANGLE/export.h>\n" }
    return ""
}

// The text of a header with its includes adjusted.
fn adjustedText(b: *Build.Builder, text: []const u8) -> []const u8 {
    var out: []const u8 = ""
    var kept: usize = 0
    var at: usize = 0
    while at < text.length {
        const start = at
        const line = Build.nextLine(text, &at)
        const replacement = adjusted(b, line)
        if replacement.length > 0 {
            out = join3(b, out, text[kept..start], replacement)
            kept = at
        }
    }
    return Build.concat(b, out, text[kept..text.length])
}

// ANGLE/Headers in GENERATED: the headers lists/angle-headers.txt names
// (`DESTINATION SOURCE` a line, the source under ROOT), copied, those in
// ANGLE/Headers/ANGLE with their includes adjusted.
pub fn headers(b: *Build.Builder, root: []const u8, generated: []const u8) -> void {
    const listing = Build.readText(b, "projects/webkit/lists/angle-headers.txt")
    var at: usize = 0
    while at < listing.length {
        const line = Build.nextLine(listing, &at)
        var space: usize = 0
        while space < line.length && line[space] != 32 { space += 1 }
        if space >= line.length { continue }
        const destination = line[0..space]
        const source = join3(b, root, "/", line[space + 1..line.length])
        const text = Build.readText(b, source)
        if text.length == 0 { Build.fail(b, "cannot read ANGLE's header", source) }
        const made = if startsWith(destination, "ANGLE/Headers/ANGLE/") { adjustedText(b, text) } else { text }
        _ = Build.writeText(b, Build.concat(b, generated, destination), made)
    }
}
