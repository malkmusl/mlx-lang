// ANGLE (Source/ThirdParty/ANGLE), the OpenGL ES implementation WebGL
// runs on, as WebKit's CMake builds it for the WPE port but for its
// backend: ANGLE.cmake's defines and include directories, the ESSL and
// GLSL translators, and the Vulkan backend with the SPIR-V translator as
// ANGLE's GN build has them for Linux instead of the GL backend over the
// system's EGL; and the headers it gives WebCore (ANGLE/Headers, made as
// adjust-angle-include-paths.py makes them). The sources are
// lists/angle.txt (libANGLE.a, CMake's ANGLE target: common, the
// translator, libANGLE, image_util, gpu_info_util, xxhash, zlib's
// wrapper), lists/angle-vulkan.txt (the Vulkan backend with its Linux
// offscreen display, the SPIR-V translator, common/spirv, common/vulkan),
// the port's own OWN_SOURCES, and lists/angle-glesv2.txt (libGLESv2.a:
// the entry points). ANGLE ships its generated sources (the *_autogen
// files, the Vulkan backend's shaders, WebKit/ANGLEShaderProgramVersion.h):
// nothing is generated to build it.
const std = @import("std")
const Build = @import("std.build")

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

// The flags of ANGLE's sources (ROOT is Source/ThirdParty/ANGLE), C and
// C++ alike, for the library IMPLEMENTATION defines
// (LIBANGLE_IMPLEMENTATION, LIBGLESV2_IMPLEMENTATION). The reference
// build's defines that no ANGLE source reads (WebKit's BUILDING_*,
// HAVE_CONFIG_H, GETTEXT_PACKAGE, JSC_GLIB_API_ENABLED, PAS_BMALLOC,
// _GLIBCXX_ASSERTIONS) are left out.
// The backend is Vulkan's (ANGLE_ENABLE_VULKAN, as ANGLE's GN build
// configures it for Linux), not the GL backend over the system's EGL that
// WebKit's CMake builds for WPE: the port loads no GL or EGL library.
// Vulkan comes from mlx-vulkan (libmlxvulkan.so, vulkan/vulkan.h from
// mlx-cheaders; ANGLE calls the API directly, ANGLE_SHARED_LIBVULKAN off),
// SPIR-V's headers from mlx-spirv. (ANGLE_VK_MOCK_ICD_JSON is the GN
// build's, for the mock driver ANGLE's tests ask for.) The share
// context lock and the context mutexes, as ANGLE's GN build has them
// outside Chromium: the port's contexts of one share group are current
// on several threads at once (the compositor's, the GPU painting threads',
// the main thread's for Skia and WebGL), and without them ANGLE's share
// group state (its buffer pools) is not locked; WebKit's CMake leaves
// them out, as WPE's ANGLE has WebGL's contexts only.
pub fn flags(b: *Build.Builder, root: []const u8, implementation: []const u8) -> []const u8 {
    var line = "-DANGLE_ENABLE_ESSL -DANGLE_ENABLE_GLSL -DANGLE_ENABLE_VULKAN -DANGLE_PLATFORM_LINUX -DANGLE_ENABLE_SHARE_CONTEXT_LOCK=1 -DANGLE_ENABLE_CONTEXT_MUTEX=1 -DEGL_EGL_PROTOTYPES=0 -DEGL_NO_PLATFORM_SPECIFIC_TYPES -DGL_GLES_PROTOTYPES=0 -DNDEBUG -DANGLE_VK_MOCK_ICD_JSON=\\\"angledata/VkICD_mock_icd.json\\\""
    line = join3(b, line, " -D", implementation)
    const directories = [7][]const u8{ "/WebKit", "/include", "/include/KHR", "/src", "/src/common/base", "/src/common/third_party/xxhash", "/third_party/zlib/google" }
    for directory in directories { line = join3(b, line, " -I", Build.concat(b, root, directory)) }
    // zlib.h and zconf.h: mlx-zlib's (./mlx build zlib-headers);
    // vulkan/vulkan.h mlx-vulkan's, spirv/unified1/spirv.hpp mlx-spirv's.
    return Build.concat(b, line, " -Imlx-out/include/mlx-zlib -Imlx-out/include/mlx-vulkan -Imlx-out/include/mlx-spirv")
}

// The port's own sources of libANGLE.a (projects/webkit/port/angle): what
// ANGLE's build takes from third-party libraries WebKit's copy of ANGLE
// does not have: the Vulkan Memory Allocator behind vma:: (each
// allocation its own device memory), SPIRV-Tools behind
// angle::spirv::Validate and Print, and Khronos's loader behind
// angle::vk::OpenLibVulkan (libmlxvulkan.so, linked already); and the
// kind of ANGLE's Vulkan device the port asks for (vulkan_device_type.cpp:
// a CPU's composes on the CPU by default).
pub const OWN_SOURCES = [4][]const u8{ "vk_mem_alloc_wrapper.cpp", "angle_spirv_utils.cpp", "libvulkan_loader.cpp", "vulkan_device_type.cpp" }

// What one of ANGLE's sources is compiled with besides `flags`: for
// vk_helpers.cpp the port's VkHelpersMlx.h first (a call WebKit's changes
// left to an overload WebKit's ANGLE does not have; see the header).
pub fn sourceFlags(b: *Build.Builder, path: []const u8) -> []const u8 {
    if std.text.same(path, "src/libANGLE/renderer/vulkan/vk_helpers.cpp") { return " -include projects/webkit/port/angle/VkHelpersMlx.h" }
    return ""
}

// The flags a C++ source adds: the language, and ANGLEPrefix.h (CMake's
// precompiled header of both targets) included first.
pub fn cppFlags(b: *Build.Builder, root: []const u8) -> []const u8 {
    return join3(b, " -std=c++23 -include ", root, "/ANGLEPrefix.h")
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && std.text.same(text[0..prefix.length], prefix)
}

// adjust-angle-include-paths.py's replacement of one line: `#include
// <EGL/egl.h>` (or GLES*, KHR, any `../` before) as `#include
// <ANGLE/egl.h>`, the ANGLE headers named alone likewise; "" when the
// line stays.
fn adjusted(b: *Build.Builder, line: []const u8) -> []const u8 {
    if !startsWith(line, "#include ") || line.length < 11 { return "" }
    const open = line[9]
    if open != 60 && open != 34 { return "" }
    // (`.*` then `[>"]`: up to the line's last `>` or `"`.)
    var close = line.length
    while close > 10 && line[close - 1] != 62 && line[close - 1] != 34 { close -= 1 }
    if close <= 10 { return "" }
    var header = line[10..close - 1]
    var rest = header
    while startsWith(rest, "../") { rest = rest[3..rest.length] }
    const groups = [5][]const u8{ "EGL/", "GLES/", "GLES2/", "GLES3/", "KHR/" }
    for group in groups {
        if startsWith(rest, group) { return join3(b, "#include <ANGLE/", rest[group.length..rest.length], ">\n") }
    }
    const named = [3][]const u8{ "eglext_angle.h", "gl2ext_angle.h", "ShaderVars.h" }
    for name in named {
        if startsWith(header, name) { return join3(b, "#include <ANGLE/", name, ">\n") }
    }
    if std.text.same(header, "export.h") { return "#include <ANGLE/export.h>\n" }
    return ""
}

// The text of a header with its includes adjusted.
fn adjustedText(b: *Build.Builder, text: []const u8) -> []const u8 {
    var out: []const u8 = ""
    var kept: usize = 0
    var at: usize = 0
    while at < text.length {
        const start = at
        const line = Build.nextLine(text, &at)
        const replacement = adjusted(b, line)
        if replacement.length > 0 {
            out = join3(b, out, text[kept..start], replacement)
            kept = at
        }
    }
    return Build.concat(b, out, text[kept..text.length])
}

// ANGLE/Headers in GENERATED: the headers lists/angle-headers.txt names
// (`DESTINATION SOURCE` a line, the source under ROOT), copied, those in
// ANGLE/Headers/ANGLE with their includes adjusted.
pub fn headers(b: *Build.Builder, root: []const u8, generated: []const u8) -> void {
    const listing = Build.readText(b, "projects/webkit/lists/angle-headers.txt")
    var at: usize = 0
    while at < listing.length {
        const line = Build.nextLine(listing, &at)
        var space: usize = 0
        while space < line.length && line[space] != 32 { space += 1 }
        if space >= line.length { continue }
        const destination = line[0..space]
        const source = join3(b, root, "/", line[space + 1..line.length])
        const text = Build.readText(b, source)
        if text.length == 0 { Build.fail(b, "cannot read ANGLE's header", source) }
        const made = if startsWith(destination, "ANGLE/Headers/ANGLE/") { adjustedText(b, text) } else { text }
        _ = Build.writeText(b, Build.concat(b, generated, destination), made)
    }
}
