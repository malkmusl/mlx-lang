// WPE WebKit and the libraries it needs, built by `./mlx build webkit`
// with this repository's own toolchain alone: mlx-cc compiles every C and
// C++ file, mlx-ar makes the archives, mlxlibcpp and mlxlibc are the
// libraries the programs run on. What WebKit's build generates (its
// unified sources, its configuration header) is made here in Mlx while
// the steps are declared.
//
//     ./mlx build webkit-bmalloc      one library (--list names them)
//     ./mlx build webkit-wtf
//     ./mlx build webkit-jsc-derived  what JavaScriptCore's build generates
//     ./mlx build webkit-webcore-derived  what WebCore's build generates (WPE)
//     ./mlx build webkit-jsc
//     ./mlx build webkit-jsc-shell     mlx-out/webkit/bin/jsc
//     ./mlx build webkit-angle        ANGLE (libANGLE.a, libGLESv2.a)
//     ./mlx build webkit-skia         Skia (libSkia.a)
//     ./mlx build webkit              all of it
//
// Where the sources are: WEBKIT_SOURCE (WPE WebKit's tree, the one with
// Source/), defaulting to /home/user/csrc. Nothing else is taken from
// outside: what WebKit asks of other libraries (ICU's Unicode API and the
// rest) is implemented in this repository.
// Objects go to mlx-out/webkit/obj, archives to mlx-out/webkit/lib.
const std = @import("std")
const Build = @import("std.build")
const config = @import("./config.mlx")
const unified = @import("./unified.mlx")
const webcore = @import("./webcore.mlx")
const angleModule = @import("./angle.mlx")
const skiaModule = @import("./skia.mlx")

pub const Toolchain = struct {
    // mlx-cc, its headers and mlxlibcpp; mlx-ar.
    compiler: Build.Step
    headers: Build.Step
    library: Build.Step
    archiver: Build.Step
    cc: []const u8
    ar: []const u8
}

const OBJ: []const u8 = "mlx-out/webkit/obj/"
const LIB: []const u8 = "mlx-out/webkit/lib/"
// What the build makes for the compilers: the configuration header, the
// headers of bmalloc as <bmalloc/...>.
const GENERATED: []const u8 = "mlx-out/webkit/generated/"
// Where mlx-unicode's headers are made (build.mlx's UNICODE_HEADERS).
const UNICODE_HEADERS: []const u8 = "mlx-out/include/mlx-unicode"
// Where mlx-freetype's headers are made (build.mlx's FREETYPE_HEADERS).
const FREETYPE_HEADERS: []const u8 = "mlx-out/include/mlx-freetype"
// Where mlx-zlib's headers are made (build.mlx's ZLIB_HEADERS).
const ZLIB_HEADERS: []const u8 = "mlx-out/include/mlx-zlib"

fn webkitSource(b: *Build.Builder) -> []const u8 {
    const given = Build.environment(b, "WEBKIT_SOURCE")
    if given.length > 0 { return given }
    return "/home/user/csrc/wpe/wpewebkit-2.54.1"
}

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

fn decimal(b: *Build.Builder, value: usize) -> []const u8 {
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &digits) }
    const length = std.text.appendUnsigned(bytes, 0, 24, value)
    return Build.concat(b, bytes[0..length], "")
}

fn endsWith(text: []const u8, suffix: []const u8) -> bool {
    return text.length >= suffix.length && std.text.same(text[text.length - suffix.length..text.length], suffix)
}

// A library's objects: its compile steps gathered under groups of at most
// 100 (a step names at most 128 others), its objects a line in `list`
// (those of the last group first in `chunkList`: as every concatenation
// is kept in the build graph's text, a list grown by a line at a time
// would take the square of its length).
const Objects = struct {
    name: []const u8
    all: Build.Step
    chunk: Build.Step
    inChunk: usize
    chunks: usize
    list: []const u8
    chunkList: []const u8
    count: usize
}

fn objects(b: *Build.Builder, name: []const u8) -> Objects {
    const all = Build.group(b, Build.concat(b, name, "-objects"), Build.concat(b, "the objects of ", name))
    return Objects.{ .name = name, .all = all, .chunk = all, .inChunk = 100, .chunks = 0, .list = "", .chunkList = "", .count = 0 }
}

// SET's list with the objects of its last group.
fn flushList(b: *Build.Builder, set: *Objects) -> void {
    if set.*.chunkList.length == 0 { return }
    set.*.list = Build.concat(b, set.*.list, set.*.chunkList)
    set.*.chunkList = ""
}

fn collect(b: *Build.Builder, set: *Objects, step: Build.Step, object: []const u8) -> void {
    if set.*.inChunk >= 100 {
        flushList(b, set)
        set.*.chunks += 1
        const chunk = Build.group(b, join3(b, set.*.name, "-objects-", decimal(b, set.*.chunks)), "")
        Build.add(b, set.*.all, chunk)
        set.*.chunk = chunk
        set.*.inChunk = 0
    }
    Build.add(b, set.*.chunk, step)
    set.*.inChunk += 1
    set.*.chunkList = join3(b, set.*.chunkList, object, "\n")
    set.*.count += 1
}

// The object of SOURCE (a path under ROOT) compiled with FLAGS into
// mlx-out/webkit/obj/LIBRARY/PATH.o, gathered into SET.
fn compile(b: *Build.Builder, tc: Toolchain, set: *Objects, root: []const u8, path: []const u8, flags: []const u8) -> void {
    _ = compileAs(b, tc, set, join3(b, root, "/", path), path, flags)
}

// The object of the file SOURCE compiled with FLAGS into
// mlx-out/webkit/obj/LIBRARY/NAME.o, gathered into SET.
fn compileAs(b: *Build.Builder, tc: Toolchain, set: *Objects, source: []const u8, name: []const u8, flags: []const u8) -> Build.Step {
    const object = join3(b, join3(b, OBJ, set.*.name, "/"), name, ".o")
    const depfile = Build.concat(b, object, ".d")
    var line = join3(b, tc.cc, " -MD -MF ", depfile)
    line = join3(b, line, " ", flags)
    line = join3(b, line, " -c ", source)
    line = join3(b, line, " -o ", object)
    const step = Build.command(b, join3(b, set.*.name, "/", name), object, line)
    Build.depfile(b, step, depfile)
    Build.input(b, step, tc.cc)
    Build.dependOn(b, step, tc.compiler)
    Build.dependOn(b, step, tc.headers)
    collect(b, set, step, object)
    return step
}

// The archive mlx-out/webkit/lib/OUTPUT of SET's objects (made again when
// one of them is: the object list, written beside it, is its depfile).
fn archive(b: *Build.Builder, tc: Toolchain, set: *Objects, output: []const u8) -> Build.Step {
    flushList(b, set)
    const path = Build.concat(b, LIB, output)
    const listPath = Build.concat(b, path, ".objects")
    _ = Build.writeText(b, listPath, set.*.list)
    var line = join3(b, tc.ar, " rcs ", path)
    // (The objects a hundred at a time, as the list above.)
    var words: []const u8 = ""
    var inWords: usize = 0
    var at: usize = 0
    while at < set.*.list.length {
        const object = Build.nextLine(set.*.list, &at)
        if object.length == 0 { continue }
        words = join3(b, words, " ", object)
        inWords += 1
        if inWords == 100 {
            line = Build.concat(b, line, words)
            words = ""
            inWords = 0
        }
    }
    line = Build.concat(b, line, words)
    const step = Build.command(b, output, path, line)
    Build.depfile(b, step, listPath)
    Build.input(b, step, tc.ar)
    Build.dependOn(b, step, tc.archiver)
    Build.dependOn(b, step, set.*.all)
    return step
}

// bmalloc: libpas (C) and bmalloc (C++), as WPE builds them.
fn bmalloc(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit-bmalloc", "bmalloc and libpas, WebKit's allocator")
    const root = Build.concat(b, webkitSource(b), "/Source")
    const s = root
    var flags = "-DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WPE__=1 -DBUILDING_bmalloc -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -D_GNU_SOURCE -DNDEBUG"
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc"))
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc/bmalloc"))
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc/libpas/src/libpas"))
    var set = objects(b, "bmalloc")
    const listing = Build.readText(b, "projects/webkit/lists/bmalloc.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        compile(b, tc, &set, root, path, if endsWith(path, ".cpp") { Build.concat(b, flags, " -std=c++23") } else { flags })
    }
    Build.add(b, group, archive(b, tc, &set, "libbmalloc.a"))
    return group
}

// The configuration header (cmakeconfig.h) of LINES (NAME VALUE each).
fn configHeader(b: *Build.Builder, lines: []const u8) -> []const u8 {
    var text = "/* cmakeconfig.h: WebKit's configuration, made by ./mlx build from projects/webkit/config.mlx. */\n#ifndef CMAKECONFIG_H\n#define CMAKECONFIG_H\n"
    var at: usize = 0
    while at < lines.length {
        const line = Build.nextLine(lines, &at)
        if line.length > 0 { text = join3(b, text, "#define ", Build.concat(b, line, "\n")) }
    }
    return Build.concat(b, text, "#endif\n")
}

// <bmalloc/NAME.h> for each header of bmalloc and libpas, as WebKit's
// build copies them: a header including the one in the tree.
fn bmallocHeaders(b: *Build.Builder, source: []const u8) -> void {
    const directories = [2][]const u8{ "/bmalloc/bmalloc", "/bmalloc/libpas/src/libpas" }
    for directory in directories {
        const path = Build.concat(b, source, directory)
        const names = Build.filesIn(b, path, ".h")
        var at: usize = 0
        while at < names.length {
            const name = Build.nextLine(names, &at)
            if name.length == 0 { continue }
            const text = join3(b, "#include \"", join3(b, path, "/", name), "\"\n")
            _ = Build.writeText(b, join3(b, GENERATED, "bmalloc/", name), text)
        }
    }
}

// WTF, WebKit's base library, configured for the JSCOnly port, against
// mlx-unicode for what it asks of ICU.
fn wtf(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit-wtf", "WTF, WebKit's base library (JSCOnly), on mlx-unicode")
    const root = Build.concat(b, webkitSource(b), "/Source")
    _ = Build.writeText(b, Build.concat(b, GENERATED, "cmakeconfig.h"), configHeader(b, config.JSC_ONLY))
    bmallocHeaders(b, root)
    const w = Build.concat(b, root, "/WTF")
    var flags = "-DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WTF -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -DSTATICALLY_LINKED_WITH_bmalloc -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS -std=c++23"
    // mlx-cc has no vector registers: SIMDe emulates them with arrays,
    // simdutf takes its portable implementation.
    flags = Build.concat(b, flags, " -DSIMDE_NO_VECTOR -DSIMDUTF_IMPLEMENTATION_ICELAKE=0 -DSIMDUTF_IMPLEMENTATION_HASWELL=0 -DSIMDUTF_IMPLEMENTATION_WESTMERE=0")
    // The generated headers; bmalloc's also by their own names, as the
    // headers among them include each other.
    flags = join3(b, flags, " -I", GENERATED)
    flags = join3(b, flags, " -I", Build.concat(b, GENERATED, "bmalloc"))
    flags = join3(b, flags, " -I", w)
    const subdirectories = [10][]const u8{ "/wtf", "/wtf/dtoa", "/wtf/fast_float", "/wtf/persistence", "/wtf/simdutf", "/wtf/text", "/wtf/text/icu", "/wtf/threads", "/wtf/unicode", "" }
    for sub in subdirectories {
        if sub.length > 0 { flags = join3(b, flags, " -I", Build.concat(b, w, sub)) }
    }
    flags = join3(b, flags, " -I", UNICODE_HEADERS)
    const unicodeHeaders = Build.step(b, "unicode-headers")
    var set = objects(b, "wtf")
    const listing = Build.readText(b, "projects/webkit/lists/wtf.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        compile(b, tc, &set, root, path, flags)
    }
    Build.dependOn(b, set.all, unicodeHeaders)
    Build.add(b, group, archive(b, tc, &set, "libWTF.a"))
    return group
}

// What JavaScriptCore's build generates, made by WebKit's generators
// ported to Mlx (projects/webkit/generators), into JSC_DERIVED.
const JSC_DERIVED: []const u8 = "mlx-out/webkit/generated/JavaScriptCore/"

// The name of a source's file without its directory and extension.
fn stem(path: []const u8) -> []const u8 {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    var end = path.length
    while end > start && path[end - 1] != 46 { end -= 1 }
    return if end > start { path[start..end - 1] } else { path[start..path.length] }
}

// The static hash tables (NAME.lut.h) of the sources in lists/jsc-lut.txt,
// by webkit-hash-table (create_hash_table's port); parser/Keywords.table
// makes Lexer.lut.h.
fn jscHashTables(b: *Build.Builder, source: []const u8) -> Build.Step {
    const group = Build.group(b, "webkit-jsc-lut", "JavaScriptCore's static hash tables (.lut.h), by webkit-hash-table")
    const generator = Build.program(b, "webkit-hash-table", "projects/webkit/generators/hashtable.mlx")
    Build.add(b, group, generator)
    const listing = Build.readText(b, "projects/webkit/lists/jsc-lut.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        const name = if std.text.same(stem(path), "Keywords") { "Lexer" } else { stem(path) }
        const input = join3(b, source, "/JavaScriptCore/", path)
        const output = join3(b, JSC_DERIVED, name, ".lut.h")
        const step = Build.command(b, join3(b, "jsc/", name, ".lut.h"), output, join3(b, "mlx-out/bin/webkit-hash-table ", input, Build.concat(b, " ", output)))
        Build.input(b, step, input)
        Build.input(b, step, "mlx-out/bin/webkit-hash-table")
        Build.dependOn(b, step, generator)
        Build.add(b, group, step)
    }
    return group
}

// A generator of WebKit's in Mlx: the program mlx-out/bin/NAME made of
// projects/webkit/generators/ROOT, in GROUP.
fn generator(b: *Build.Builder, group: Build.Step, name: []const u8, root: []const u8) -> Build.Step {
    const step = Build.program(b, name, Build.concat(b, "projects/webkit/generators/", root))
    Build.add(b, group, step)
    return step
}

// A step of GROUP running GENERATOR (mlx-out/bin/NAME) with ARGUMENTS,
// making OUTPUTS (paths, a line each) of INPUTS (likewise).
fn generate(b: *Build.Builder, group: Build.Step, generatorStep: Build.Step, name: []const u8, arguments: []const u8, outputs: []const u8, inputs: []const u8) -> Build.Step {
    const program = Build.concat(b, "mlx-out/bin/", name)
    var at: usize = 0
    const first = Build.nextLine(outputs, &at)
    const step = Build.command(b, Build.concat(b, "jsc/", baseName(first)), first, join3(b, program, " ", arguments))
    while at < outputs.length {
        const other = Build.nextLine(outputs, &at)
        if other.length > 0 { Build.output(b, step, other) }
    }
    at = 0
    while at < inputs.length {
        const input = Build.nextLine(inputs, &at)
        if input.length > 0 { Build.input(b, step, input) }
    }
    Build.input(b, step, program)
    Build.dependOn(b, step, generatorStep)
    Build.add(b, group, step)
    return step
}

// The bytecodes (Bytecodes.h and the rest), of bytecode/BytecodeList.rb,
// by webkit-bytecodes (generator/main.rb's port).
fn jscBytecodes(b: *Build.Builder, group: Build.Step, jsc: []const u8) -> void {
    const program = generator(b, group, "webkit-bytecodes", "bytecodes.mlx")
    const list = Build.concat(b, jsc, "/bytecode/BytecodeList.rb")
    const wasm = Build.concat(b, jsc, "/wasm/wasm.json")
    const d = JSC_DERIVED
    var arguments = join3(b, "--bytecodes_h ", d, "Bytecodes.h")
    arguments = join3(b, arguments, " --init_bytecodes_asm ", Build.concat(b, d, "InitBytecodes.asm"))
    arguments = join3(b, arguments, " --bytecode_structs_h ", Build.concat(b, d, "BytecodeStructs.h"))
    arguments = join3(b, arguments, " --bytecode_indices_h ", Build.concat(b, d, "BytecodeIndices.h"))
    arguments = join3(b, arguments, " --wasm_json ", wasm)
    arguments = join3(b, arguments, " --bytecode_dumper ", Build.concat(b, d, "BytecodeDumperGenerated.cpp"))
    arguments = join3(b, arguments, " ", list)
    var outputs = join3(b, d, "Bytecodes.h\n", d)
    outputs = join3(b, outputs, "InitBytecodes.asm\n", d)
    outputs = join3(b, outputs, "BytecodeStructs.h\n", d)
    outputs = join3(b, outputs, "BytecodeIndices.h\n", d)
    outputs = Build.concat(b, outputs, "BytecodeDumperGenerated.cpp\n")
    _ = generate(b, group, program, "webkit-bytecodes", arguments, outputs, join3(b, list, "\n", wasm))
}

// WasmOps.h and WasmOMGIRGeneratorInlines.h of wasm/wasm.json, the Air
// opcodes of b3/air/AirOpcode.opcodes.
fn jscWasmAndAir(b: *Build.Builder, group: Build.Step, jsc: []const u8) -> void {
    const wasm = Build.concat(b, jsc, "/wasm/wasm.json")
    const ops = generator(b, group, "webkit-wasm-ops", "wasmops.mlx")
    _ = generate(b, group, ops, "webkit-wasm-ops", join3(b, wasm, " ", Build.concat(b, JSC_DERIVED, "WasmOps.h")), Build.concat(b, JSC_DERIVED, "WasmOps.h"), wasm)
    const omg = generator(b, group, "webkit-wasm-omg", "wasmomg.mlx")
    const inlines = Build.concat(b, JSC_DERIVED, "WasmOMGIRGeneratorInlines.h")
    _ = generate(b, group, omg, "webkit-wasm-omg", join3(b, wasm, " ", inlines), inlines, wasm)
    const opcodes = Build.concat(b, jsc, "/b3/air/AirOpcode.opcodes")
    const air = generator(b, group, "webkit-air-opcodes", "airopcodes.mlx")
    var outputs = join3(b, JSC_DERIVED, "AirOpcode.h\n", JSC_DERIVED)
    outputs = join3(b, outputs, "AirOpcodeUtils.h\n", JSC_DERIVED)
    outputs = Build.concat(b, outputs, "AirOpcodeGenerated.h\n")
    _ = generate(b, group, air, "webkit-air-opcodes", join3(b, opcodes, " ", JSC_DERIVED), outputs, opcodes)
}

// The lexer's and yarr's tables: KeywordLookup.h of parser/Keywords.table,
// the lexer's Unicode properties and yarr's of ucd/, yarr's character
// class tables (built into their generator).
fn jscLexerAndYarr(b: *Build.Builder, group: Build.Step, jsc: []const u8) -> void {
    const d = JSC_DERIVED
    const keywords = Build.concat(b, jsc, "/parser/Keywords.table")
    const lookup = generator(b, group, "webkit-keyword-lookup", "keywordlookup.mlx")
    _ = generate(b, group, lookup, "webkit-keyword-lookup", join3(b, keywords, " ", Build.concat(b, d, "KeywordLookup.h")), Build.concat(b, d, "KeywordLookup.h"), keywords)
    const unicodeData = Build.concat(b, jsc, "/ucd/UnicodeData.txt")
    const lexer = generator(b, group, "webkit-lexer-unicode-tables", "lexerunicode.mlx")
    const lexerTables = Build.concat(b, d, "LexerUnicodePropertyTables.h")
    _ = generate(b, group, lexer, "webkit-lexer-unicode-tables", join3(b, unicodeData, " ", lexerTables), lexerTables, unicodeData)
    const regex = generator(b, group, "webkit-regex-tables", "regextables.mlx")
    const jitTables = Build.concat(b, d, "yarr/RegExpJitTables.h")
    _ = generate(b, group, regex, "webkit-regex-tables", jitTables, jitTables, "")
    const caseFolding = Build.concat(b, jsc, "/ucd/CaseFolding.txt")
    const canonicalize = generator(b, group, "webkit-yarr-canonicalize", "yarrcanonicalize.mlx")
    const canonical = Build.concat(b, d, "yarr/YarrCanonicalizeUnicode.cpp")
    _ = generate(b, group, canonicalize, "webkit-yarr-canonicalize", join3(b, caseFolding, " ", canonical), canonical, caseFolding)
    const ucd = Build.concat(b, jsc, "/ucd")
    const properties = generator(b, group, "webkit-yarr-unicode-tables", "yarrunicode.mlx")
    const patternTables = Build.concat(b, d, "yarr/UnicodePatternTables.h")
    const step = generate(b, group, properties, "webkit-yarr-unicode-tables", join3(b, ucd, " ", patternTables), patternTables, "")
    Build.inputTree(b, step, ucd, ".txt")
}

// JSCBuiltins.h and .cpp of the JavaScript in lists/jsc-builtins.txt, and
// JSCWebPreferenceOptions.h of WTF's UnifiedWebPreferences.yaml.
fn jscBuiltinsAndPreferences(b: *Build.Builder, group: Build.Step, source: []const u8, jsc: []const u8) -> void {
    const d = JSC_DERIVED
    const builtins = generator(b, group, "webkit-builtins", "builtins.mlx")
    var arguments = join3(b, "--framework JavaScriptCore --output-directory ", d, " --combined")
    const listing = Build.readText(b, "projects/webkit/lists/jsc-builtins.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        const file = join3(b, jsc, "/", path)
        arguments = join3(b, arguments, " ", file)
    }
    // (More than a step's inputs: builtins/ as a tree.)
    const step = generate(b, group, builtins, "webkit-builtins", arguments, join3(b, join3(b, d, "JSCBuiltins.h\n", d), "JSCBuiltins.cpp", "\n"), Build.concat(b, jsc, "/inspector/InjectedScriptSource.js"))
    Build.inputTree(b, step, Build.concat(b, jsc, "/builtins"), ".js")
    const preferences = generator(b, group, "webkit-preferences", "preferences.mlx")
    const template = Build.concat(b, jsc, "/Scripts/PreferencesTemplates/JSCWebPreferenceOptions.h.erb")
    const yaml = Build.concat(b, source, "/WTF/Scripts/Preferences/UnifiedWebPreferences.yaml")
    var line = join3(b, "--frontend JavaScriptCore --outputDir ", d, " --template ")
    line = join3(b, line, template, Build.concat(b, " ", yaml))
    _ = generate(b, group, preferences, "webkit-preferences", line, Build.concat(b, d, "JSCWebPreferenceOptions.h"), join3(b, template, "\n", yaml))
}

// The inspector's protocol: CombinedDomains.json of inspector/protocol's
// domains (lists/jsc-inspector.txt), then its C++ and JavaScript.
fn jscInspector(b: *Build.Builder, group: Build.Step, jsc: []const u8) -> void {
    const d = JSC_DERIVED
    const combined = Build.concat(b, d, "CombinedDomains.json")
    const combiner = generator(b, group, "webkit-combined-inspector-json", "inspectorjson.mlx")
    var arguments = combined
    const listing = Build.readText(b, "projects/webkit/lists/jsc-inspector.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length > 0 { arguments = join3(b, arguments, " ", join3(b, jsc, "/", path)) }
    }
    arguments = join3(b, arguments, " \"", Build.concat(b, config.JSC_ONLY_FEATURE_DEFINES, "\""))
    const step = generate(b, group, combiner, "webkit-combined-inspector-json", arguments, combined, "")
    Build.inputTree(b, step, Build.concat(b, jsc, "/inspector/protocol"), ".json")
    const bindings = generator(b, group, "webkit-inspector-protocol-bindings", "inspector.mlx")
    const directory = Build.concat(b, d, "inspector")
    var outputs = ""
    const names = [8][]const u8{ "InspectorAlternateBackendDispatchers.h", "InspectorBackendCommands.js", "InspectorBackendDispatchers.cpp",
        "InspectorBackendDispatchers.h", "InspectorFrontendDispatchers.cpp", "InspectorFrontendDispatchers.h", "InspectorProtocolObjects.cpp", "InspectorProtocolObjects.h" }
    for name in names { outputs = join3(b, outputs, join3(b, directory, "/", name), "\n") }
    const made = generate(b, group, bindings, "webkit-inspector-protocol-bindings", join3(b, join3(b, "--outputDir ", directory, " --framework JavaScriptCore "), combined, ""), outputs, combined)
    Build.dependOn(b, made, step)
}

// The interpreter's headers, by offlineasm's port (webkit-offlineasm) of
// llint/LowLevelInterpreter.asm: the settings it asks of the compiler
// (LLIntDesiredSettings.h), which LLIntSettingsExtractor.cpp shows in
// its object; the offsets of the structures it reads
// (LLIntDesiredOffsets.h), which LLIntOffsetsExtractor.cpp's object
// shows as mlx-cc lays them out; then the interpreter, as C++ for the
// C_LOOP (LLIntAssembly.h). GENERATED is every other generated source
// (the extractors include them).
fn jscInterpreter(b: *Build.Builder, tc: Toolchain, group: Build.Step, generated: Build.Step, root: []const u8, jsc: []const u8) -> void {
    const d = JSC_DERIVED
    const program = generator(b, group, "webkit-offlineasm", "offlineasm/offlineasm.mlx")
    const asm = Build.concat(b, jsc, "/llint/LowLevelInterpreter.asm")
    const prefix = join3(b, Build.concat(b, jsc, "/offlineasm -I"), d, Build.concat(b, " ", asm))
    var inputs = ""
    const sources = [5][]const u8{ "LowLevelInterpreter.asm", "LowLevelInterpreter64.asm", "LowLevelInterpreter32_64.asm", "InPlaceInterpreter.asm", "InPlaceInterpreter64.asm" }
    for name in sources { inputs = join3(b, inputs, join3(b, jsc, "/llint/", name), "\n") }
    inputs = join3(b, inputs, d, "InitBytecodes.asm\n")
    const settingsHeader = Build.concat(b, d, "LLIntDesiredSettings.h")
    const settings = generate(b, group, program, "webkit-offlineasm", join3(b, "settings ", prefix, join3(b, " ", settingsHeader, " C_LOOP")), settingsHeader, inputs)
    Build.dependOn(b, settings, generated)
    const flags = Build.concat(b, jscFlags(b, root, jsc), " -std=c++23")
    var tools = objects(b, "jsc-tools")
    const settingsObject = Build.concat(b, OBJ, "jsc-tools/LLIntSettingsExtractor.cpp.o")
    const settingsExtractor = compileAs(b, tc, &tools, Build.concat(b, jsc, "/llint/LLIntSettingsExtractor.cpp"), "LLIntSettingsExtractor.cpp", flags)
    Build.dependOn(b, settingsExtractor, settings)
    const offsetsHeader = Build.concat(b, d, "LLIntDesiredOffsets.h")
    var line = join3(b, "offsets ", prefix, Build.concat(b, " ", settingsObject))
    line = join3(b, line, " ", Build.concat(b, offsetsHeader, " C_LOOP normal"))
    const offsets = generate(b, group, program, "webkit-offlineasm", line, offsetsHeader, join3(b, inputs, settingsObject, "\n"))
    Build.dependOn(b, offsets, settingsExtractor)
    const offsetsObject = Build.concat(b, OBJ, "jsc-tools/LLIntOffsetsExtractor.cpp.o")
    const offsetsExtractor = compileAs(b, tc, &tools, Build.concat(b, jsc, "/llint/LLIntOffsetsExtractor.cpp"), "LLIntOffsetsExtractor.cpp", flags)
    Build.dependOn(b, offsetsExtractor, offsets)
    const assemblyHeader = Build.concat(b, d, "LLIntAssembly.h")
    line = join3(b, "assembly ", prefix, Build.concat(b, " ", offsetsObject))
    line = join3(b, line, " ", Build.concat(b, assemblyHeader, " normal --binary-format=ELF"))
    const assembly = generate(b, group, program, "webkit-offlineasm", line, assemblyHeader, join3(b, inputs, offsetsObject, "\n"))
    Build.dependOn(b, assembly, offsetsExtractor)
    Build.dependOn(b, tools.all, Build.step(b, "unicode-headers"))
}

fn jscDerived(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const all = Build.group(b, "webkit-jsc-derived", "the sources JavaScriptCore's build generates, made by its generators in Mlx")
    const group = Build.group(b, "webkit-jsc-generated", "what JavaScriptCore's build generates but the interpreter")
    Build.add(b, all, group)
    const source = Build.concat(b, webkitSource(b), "/Source")
    Build.add(b, group, jscHashTables(b, source))
    const jsc = Build.concat(b, source, "/JavaScriptCore")
    jscBytecodes(b, group, jsc)
    jscWasmAndAir(b, group, jsc)
    jscLexerAndYarr(b, group, jsc)
    jscBuiltinsAndPreferences(b, group, source, jsc)
    jscInspector(b, group, jsc)
    jscHeaders(b, jsc)
    const llint = Build.group(b, "webkit-jsc-llint", "the interpreter's headers, by webkit-offlineasm and the extractors")
    Build.add(b, all, llint)
    jscInterpreter(b, tc, llint, group, source, jsc)
    return all
}

// The last part of PATH.
fn baseName(path: []const u8) -> []const u8 {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    return path[start..path.length]
}

// <JavaScriptCore/NAME.h> for the headers lists/jsc-headers.txt names, as
// WebKit's build links them: in JSC_DERIVED's PrivateHeaders/JavaScriptCore
// (and Headers/JavaScriptCore for the public API), a header including the
// one in the tree, or the generated one.
fn jscHeaders(b: *Build.Builder, jsc: []const u8) -> void {
    const listing = Build.readText(b, "projects/webkit/lists/jsc-headers.txt")
    var at: usize = 0
    while at < listing.length {
        const line = Build.nextLine(listing, &at)
        var space: usize = 0
        while space < line.length && line[space] != 32 { space += 1 }
        if space >= line.length { continue }
        const kind = line[0..space]
        const path = line[space + 1..line.length]
        const name = baseName(path)
        // From PrivateHeaders/JavaScriptCore, the generated ones are two up.
        const target = if std.text.same(kind, "private-derived") { Build.concat(b, "../../", path) } else { join3(b, jsc, "/", path) }
        const text = join3(b, "#include \"", target, "\"\n")
        const directory = if std.text.same(kind, "public") { "Headers/JavaScriptCore/" } else { "PrivateHeaders/JavaScriptCore/" }
        _ = Build.writeText(b, join3(b, JSC_DERIVED, directory, name), text)
    }
}

// JavaScriptCore (JSCOnly, the C_LOOP interpreter), its unified sources
// bundled here as WebKit bundles them, on WTF, bmalloc and mlx-unicode.
// The flags JavaScriptCore's sources compile with (its includes and
// defines, without those of the library itself).
fn jscFlags(b: *Build.Builder, root: []const u8, jsc: []const u8) -> []const u8 {
    var common = "-DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS"
    common = Build.concat(b, common, " -DSIMDE_NO_VECTOR -DSIMDUTF_IMPLEMENTATION_ICELAKE=0 -DSIMDUTF_IMPLEMENTATION_HASWELL=0 -DSIMDUTF_IMPLEMENTATION_WESTMERE=0")
    common = join3(b, common, " -I", Build.concat(b, JSC_DERIVED, "Headers"))
    common = join3(b, common, " -I", Build.concat(b, JSC_DERIVED, "PrivateHeaders"))
    common = join3(b, common, " -I", GENERATED)
    common = join3(b, common, " -I", Build.concat(b, JSC_DERIVED, "PrivateHeaders/JavaScriptCore"))
    common = join3(b, common, " -I", jsc)
    const subdirectories = [37][]const u8{ "API", "assembler", "b3", "b3/air", "bindings", "builtins", "bytecode", "bytecompiler", "dfg", "disassembler",
        "disassembler/ARM64", "disassembler/zydis", "domjit", "ftl", "fuzzilli", "heap", "debugger", "inspector", "inspector/agents", "inspector/augmentable",
        "inspector/remote", "interpreter", "jit", "llint", "lol", "parser", "profiler", "runtime", "runtime/temporal/core", "tools", "wasm", "wasm/debugger",
        "wasm/js", "yarr", "", "", "" }
    for sub in subdirectories {
        if sub.length > 0 { common = join3(b, common, " -I", join3(b, jsc, "/", sub)) }
    }
    const derivedDirectories = [4][]const u8{ "", "inspector", "runtime", "yarr" }
    for sub in derivedDirectories { common = join3(b, common, " -I", Build.concat(b, JSC_DERIVED, sub)) }
    common = join3(b, common, " -I", Build.concat(b, root, "/WTF"))
    common = join3(b, common, " -I", Build.concat(b, GENERATED, "bmalloc"))
    common = join3(b, common, " -I", UNICODE_HEADERS)
    return common
}

fn javaScriptCore(b: *Build.Builder, tc: Toolchain, derived: Build.Step) -> Build.Step {
    const group = Build.group(b, "webkit-jsc", "JavaScriptCore (JSCOnly, C_LOOP), on WTF and mlx-unicode")
    const root = Build.concat(b, webkitSource(b), "/Source")
    const jsc = Build.concat(b, root, "/JavaScriptCore")
    const common = jscFlags(b, root, jsc)
    const library = Build.concat(b, common, " -DBUILDING_JavaScriptCore -DJavaScriptCore_EXPORTS -DSTATICALLY_LINKED_WITH_WTF -DSTATICALLY_LINKED_WITH_bmalloc")
    const cpp = join3(b, library, " -std=c++23 -include ", Build.concat(b, jsc, "/JavaScriptCorePrefix.h"))
    var set = objects(b, "jsc")
    const options = unified.Options.{ .maxBundleSize = 8, .enforceCost = false, .denseFilters = "" }
    const sources = unified.bundle(b, Build.concat(b, jsc, "/Sources.txt\n"), Build.concat(b, JSC_DERIVED, "unified-sources"), jsc, Build.concat(b, JSC_DERIVED, "."), options)
    var at: usize = 0
    while at < sources.length {
        const path = Build.nextLine(sources, &at)
        if path.length == 0 { continue }
        // (Headers in the list are only listed.)
        if endsWith(path, ".c") { _ = compileAs(b, tc, &set, path, baseName(path), library) }
        if endsWith(path, ".cpp") { _ = compileAs(b, tc, &set, path, baseName(path), cpp) }
    }
    _ = compileAs(b, tc, &set, Build.concat(b, JSC_DERIVED, "JSCBuiltins.cpp"), "JSCBuiltins.cpp", cpp)
    // The interpreter, apart (WebKit's LowLevelInterpreterLib).
    _ = compileAs(b, tc, &set, Build.concat(b, jsc, "/llint/LowLevelInterpreter.cpp"), "LowLevelInterpreter.cpp", Build.concat(b, common, " -std=c++23"))
    Build.dependOn(b, set.all, Build.step(b, "unicode-headers"))
    Build.dependOn(b, set.all, derived)
    Build.add(b, group, archive(b, tc, &set, "libJavaScriptCore.a"))
    return group
}

// jsc, JavaScriptCore's shell (WebKit's Source/JavaScriptCore/jsc.cpp),
// linked with JavaScriptCore, WTF, bmalloc and mlx-unicode into
// mlx-out/webkit/bin/jsc.
fn jscShell(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit-jsc-shell", "jsc, JavaScriptCore's shell")
    const root = Build.concat(b, webkitSource(b), "/Source")
    const jsc = Build.concat(b, root, "/JavaScriptCore")
    var set = objects(b, "jsc-shell")
    const flags = Build.concat(b, jscFlags(b, root, jsc), " -DBUILDING_jsc -std=c++23")
    const compiled = compileAs(b, tc, &set, Build.concat(b, jsc, "/jsc.cpp"), "jsc.cpp", flags)
    Build.dependOn(b, compiled, Build.step(b, "webkit-jsc-derived"))
    Build.dependOn(b, compiled, Build.step(b, "unicode-headers"))
    const program = "mlx-out/webkit/bin/jsc"
    var line = join3(b, tc.cc, " -o ", program)
    line = join3(b, line, " ", Build.concat(b, OBJ, "jsc-shell/jsc.cpp.o"))
    const libraries = [3][]const u8{ "libJavaScriptCore.a", "libWTF.a", "libbmalloc.a" }
    for library in libraries { line = join3(b, line, " ", Build.concat(b, LIB, library)) }
    // mlx-unicode; mlxlibcpp (mlx-cc adds it by itself only when it
    // compiles C++ sources); the math library.
    line = Build.concat(b, line, " mlx-out/lib/libmlxunicode.so -Lmlx-out/lib -lmlxcpp -lm")
    const step = Build.command(b, "jsc", program, line)
    Build.input(b, step, Build.concat(b, OBJ, "jsc-shell/jsc.cpp.o"))
    for library in libraries {
        Build.input(b, step, Build.concat(b, LIB, library))
        Build.dependOn(b, step, Build.step(b, library))
    }
    Build.input(b, step, "mlx-out/lib/libmlxunicode.so")
    Build.dependOn(b, step, Build.step(b, "unicode"))
    Build.dependOn(b, step, set.all)
    Build.dependOn(b, step, tc.library)
    Build.add(b, group, step)
    return group
}

// ANGLE (angle.mlx): libANGLE.a and libGLESv2.a, as WebKit's CMake
// builds and archives them for WPE, and the headers it gives WebCore
// (mlx-out/webkit/generated/ANGLE/Headers).
fn angle(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit-angle", "ANGLE, WebGL's OpenGL ES (libANGLE.a, libGLESv2.a)")
    const root = Build.concat(b, webkitSource(b), "/Source/ThirdParty/ANGLE")
    angleModule.headers(b, root, GENERATED)
    const lists = [2][]const u8{ "angle", "angle-glesv2" }
    const archives = [2][]const u8{ "libANGLE.a", "libGLESv2.a" }
    const implementations = [2][]const u8{ "LIBANGLE_IMPLEMENTATION", "LIBGLESV2_IMPLEMENTATION" }
    // (The sources that use zlib include mlx-zlib's headers.)
    const zlibHeaders = Build.step(b, "zlib-headers")
    var index: usize = 0
    while index < 2 {
        const flags = angleModule.flags(b, root, implementations[index])
        const cpp = Build.concat(b, flags, angleModule.cppFlags(b, root))
        var set = objects(b, lists[index])
        const listing = Build.readText(b, join3(b, "projects/webkit/lists/", lists[index], ".txt"))
        var at: usize = 0
        while at < listing.length {
            const path = Build.nextLine(listing, &at)
            if path.length == 0 { continue }
            const step = compileAs(b, tc, &set, join3(b, root, "/", path), path, if endsWith(path, ".c") { flags } else { cpp })
            Build.dependOn(b, step, zlibHeaders)
        }
        Build.add(b, group, archive(b, tc, &set, archives[index]))
        index += 1
    }
    return group
}

// Skia (skia.mlx): libSkia.a, as WebKit's CMake builds it for WPE, of
// the sources in lists/skia.txt but those lists/skia-skipped.txt names
// (with the reason: what they need that is not there yet).
fn skia(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit-skia", "Skia, WebKit's 2D graphics (libSkia.a)")
    const root = Build.concat(b, webkitSource(b), "/Source/ThirdParty/skia")
    const flags = skiaModule.flags(b, root, FREETYPE_HEADERS, ZLIB_HEADERS)
    const skipped = Build.readText(b, "projects/webkit/lists/skia-skipped.txt")
    var set = objects(b, "skia")
    const listing = Build.readText(b, "projects/webkit/lists/skia.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 || skiaModule.isSkipped(skipped, path) { continue }
        compile(b, tc, &set, root, path, flags)
    }
    Build.dependOn(b, set.all, Build.step(b, "freetype-headers"))
    Build.dependOn(b, set.all, Build.step(b, "zlib-headers"))
    Build.add(b, group, archive(b, tc, &set, "libSkia.a"))
    return group
}

pub fn webkit(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit", "WPE WebKit and its libraries, by mlx-cc (projects/webkit)")
    Build.add(b, group, bmalloc(b, tc))
    Build.add(b, group, wtf(b, tc))
    const derived = jscDerived(b, tc)
    Build.add(b, group, derived)
    // (After JavaScriptCore's: WebCore's builtins are made by its program.)
    Build.add(b, group, webcore.webcoreDerived(b, Build.concat(b, webkitSource(b), "/Source")))
    Build.add(b, group, javaScriptCore(b, tc, derived))
    Build.add(b, group, jscShell(b, tc))
    Build.add(b, group, angle(b, tc))
    Build.add(b, group, skia(b, tc))
    return group
}
