// WPE WebKit and the libraries it needs, built by `./mlx build webkit`
// with this repository's own toolchain alone: mlx-cc compiles every C and
// C++ file, mlx-ar makes the archives, mlxlibcpp and mlxlibc are the
// libraries the programs run on. What WebKit's build generates (its
// unified sources, its configuration header) is made here in Mlx while
// the steps are declared.
//
//     ./mlx build webkit-bmalloc      one library (--list names them)
//     ./mlx build webkit              all of it
//
// Where the sources are: WEBKIT_SOURCE (WPE WebKit's tree, the one with
// Source/), defaulting to /home/user/csrc. Nothing else is taken from
// outside: what WebKit asks of other libraries (ICU's Unicode API and the
// rest) is implemented in this repository.
// Objects go to mlx-out/webkit/obj, archives to mlx-out/webkit/lib.
const std = @import("std")
const Build = @import("std.build")

pub const Toolchain = struct {
    // mlx-cc, its headers and mlxlibcpp; mlx-ar.
    compiler: Build.Step
    headers: Build.Step
    library: Build.Step
    archiver: Build.Step
    cc: []const u8
    ar: []const u8
}

const OBJ: []const u8 = "mlx-out/webkit/obj/"
const LIB: []const u8 = "mlx-out/webkit/lib/"

fn webkitSource(b: *Build.Builder) -> []const u8 {
    const given = Build.environment(b, "WEBKIT_SOURCE")
    if given.length > 0 { return given }
    return "/home/user/csrc/wpe/wpewebkit-2.54.1"
}

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

fn decimal(b: *Build.Builder, value: usize) -> []const u8 {
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &digits) }
    const length = std.text.appendUnsigned(bytes, 0, 24, value)
    return Build.concat(b, bytes[0..length], "")
}

fn endsWith(text: []const u8, suffix: []const u8) -> bool {
    return text.length >= suffix.length && std.text.same(text[text.length - suffix.length..text.length], suffix)
}

// A library's objects: its compile steps gathered under groups of at most
// 100 (a step names at most 128 others), its objects a line in `list`.
const Objects = struct {
    name: []const u8
    all: Build.Step
    chunk: Build.Step
    inChunk: usize
    chunks: usize
    list: []const u8
    count: usize
}

fn objects(b: *Build.Builder, name: []const u8) -> Objects {
    const all = Build.group(b, Build.concat(b, name, "-objects"), Build.concat(b, "the objects of ", name))
    return Objects.{ .name = name, .all = all, .chunk = all, .inChunk = 100, .chunks = 0, .list = "", .count = 0 }
}

fn collect(b: *Build.Builder, set: *Objects, step: Build.Step, object: []const u8) -> void {
    if set.*.inChunk >= 100 {
        set.*.chunks += 1
        const chunk = Build.group(b, join3(b, set.*.name, "-objects-", decimal(b, set.*.chunks)), "")
        Build.add(b, set.*.all, chunk)
        set.*.chunk = chunk
        set.*.inChunk = 0
    }
    Build.add(b, set.*.chunk, step)
    set.*.inChunk += 1
    set.*.list = join3(b, set.*.list, object, "\n")
    set.*.count += 1
}

// The object of SOURCE (a path under ROOT) compiled with FLAGS into
// mlx-out/webkit/obj/LIBRARY/PATH.o, gathered into SET.
fn compile(b: *Build.Builder, tc: Toolchain, set: *Objects, root: []const u8, path: []const u8, flags: []const u8) -> void {
    const object = join3(b, join3(b, OBJ, set.*.name, "/"), path, ".o")
    const depfile = Build.concat(b, object, ".d")
    var line = join3(b, tc.cc, " -MD -MF ", depfile)
    line = join3(b, line, " ", flags)
    line = join3(b, line, " -c ", join3(b, root, "/", path))
    line = join3(b, line, " -o ", object)
    const step = Build.command(b, join3(b, set.*.name, "/", path), object, line)
    Build.depfile(b, step, depfile)
    Build.input(b, step, tc.cc)
    Build.dependOn(b, step, tc.compiler)
    Build.dependOn(b, step, tc.headers)
    collect(b, set, step, object)
}

// The archive mlx-out/webkit/lib/OUTPUT of SET's objects (made again when
// one of them is: the object list, written beside it, is its depfile).
fn archive(b: *Build.Builder, tc: Toolchain, set: *Objects, output: []const u8) -> Build.Step {
    const path = Build.concat(b, LIB, output)
    const listPath = Build.concat(b, path, ".objects")
    _ = Build.writeText(b, listPath, set.*.list)
    var line = join3(b, tc.ar, " rcs ", path)
    var at: usize = 0
    while at < set.*.list.length {
        const object = Build.nextLine(set.*.list, &at)
        if object.length > 0 { line = join3(b, line, " ", object) }
    }
    const step = Build.command(b, output, path, line)
    Build.depfile(b, step, listPath)
    Build.input(b, step, tc.ar)
    Build.dependOn(b, step, tc.archiver)
    Build.dependOn(b, step, set.*.all)
    return step
}

// bmalloc: libpas (C) and bmalloc (C++), as WPE builds them.
fn bmalloc(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit-bmalloc", "bmalloc and libpas, WebKit's allocator")
    const root = Build.concat(b, webkitSource(b), "/Source")
    const s = root
    var flags = "-DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WPE__=1 -DBUILDING_bmalloc -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -D_GNU_SOURCE -DNDEBUG"
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc"))
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc/bmalloc"))
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc/libpas/src/libpas"))
    var set = objects(b, "bmalloc")
    const listing = Build.readText(b, "projects/webkit/lists/bmalloc.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        compile(b, tc, &set, root, path, if endsWith(path, ".cpp") { Build.concat(b, flags, " -std=c++23") } else { flags })
    }
    Build.add(b, group, archive(b, tc, &set, "libbmalloc.a"))
    return group
}

pub fn webkit(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit", "WPE WebKit and its libraries, by mlx-cc (projects/webkit)")
    Build.add(b, group, bmalloc(b, tc))
    return group
}
