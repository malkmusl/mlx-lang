// WPE WebKit and the libraries it needs, built by `./mlx build webkit`
// with this repository's own toolchain alone: mlx-cc compiles every C and
// C++ file, mlx-ar makes the archives, mlxlibcpp and mlxlibc are the
// libraries the programs run on. What WebKit's build generates (its
// unified sources, its configuration header) is made here in Mlx while
// the steps are declared.
//
// Two ports are built, from the same functions and a description of each
// (Port, below): JSCOnly, JavaScriptCore alone on the generic event loop,
// and WPE, whose lower layers (bmalloc, WTF, JavaScriptCore) stand on
// GLib (mlx-glib):
//
//     ./mlx build webkit-bmalloc      one library (--list names them)
//     ./mlx build webkit-wtf
//     ./mlx build webkit-jsc-derived  what JavaScriptCore's build generates
//     ./mlx build webkit-webcore-derived  what WebCore's build generates (WPE)
//     ./mlx build webkit-jsc
//     ./mlx build webkit-jsc-shell     mlx-out/webkit/bin/jsc
//     ./mlx build webkit-angle        ANGLE (libANGLE.a, libGLESv2.a)
//     ./mlx build webkit-skia         Skia (libSkia.a)
//     ./mlx build webkit-wpe-bmalloc   the WPE port's: likewise
//     ./mlx build webkit-wpe-wtf
//     ./mlx build webkit-wpe-jsc-derived
//     ./mlx build webkit-wpe-wtf-test  mlx-out/webkit/wpe/bin/wtf-test
//     ./mlx build webkit-mlx-pal      the Mlx port's (PORT.md): PAL, WebCore,
//     ./mlx build webkit-mlx-webcore  its Mlx side (webkit-mlx-port) and the
//     ./mlx build webkit-mlx-webcore-test  program linking them all
//     ./mlx build webkit-mlx-webcore-dump  a page's render tree (M3)
//     ./mlx build webkit              all of it
//
// Where the sources are: WEBKIT_SOURCE (WPE WebKit's tree, the one with
// Source/), by default projects/webkit/upstream, WPE WebKit 2.54.1 as
// released and never modified (UPSTREAM.md,
// tools/check_webkit_upstream.sh). Nothing else is taken from outside:
// what WebKit asks of other libraries (ICU's Unicode API, GLib and the
// rest) is implemented in this repository.
// The JSCOnly port's objects go to mlx-out/webkit/obj, its archives to
// mlx-out/webkit/lib; the WPE port's to mlx-out/webkit/wpe/obj and
// mlx-out/webkit/wpe/lib; the Mlx port's to mlx-out/webkit/mlx/.
const std = @import("std")
const Build = @import("std.build")
const git = @import("std.git")
const config = @import("./config.mlx")
const unified = @import("./unified.mlx")
const webcore = @import("./webcore.mlx")
const angleModule = @import("./angle.mlx")
const skiaModule = @import("./skia.mlx")

pub const Toolchain = struct {
    // mlx-cc, its headers and mlxlibcpp; mlx-ld, which mlx-cc runs for a
    // link (a link step names it as an input, an object step does not);
    // mlx-ar.
    compiler: Build.Step
    // `mlx-cc-epoch`: mlx-cc's code generation epoch (epochFile), which
    // the objects are keyed by instead of mlx-cc's bytes.
    epoch: Build.Step
    linker: Build.Step
    headers: Build.Step
    library: Build.Step
    archiver: Build.Step
    cc: []const u8
    epochFile: []const u8
    ld: []const u8
    ar: []const u8
}

// Where mlx-unicode's headers are made (build.mlx's UNICODE_HEADERS).
const UNICODE_HEADERS: []const u8 = "mlx-out/include/mlx-unicode"
// Where mlx-freetype's headers are made (build.mlx's FREETYPE_HEADERS).
const FREETYPE_HEADERS: []const u8 = "mlx-out/include/mlx-freetype"
// Where mlx-zlib's headers are made (build.mlx's ZLIB_HEADERS).
const ZLIB_HEADERS: []const u8 = "mlx-out/include/mlx-zlib"
// Where mlx-harfbuzz's headers are made (build.mlx's HARFBUZZ_HEADERS).
const HARFBUZZ_HEADERS: []const u8 = "mlx-out/include/mlx-harfbuzz"
// Where the image libraries' headers are made (build.mlx's PNG_HEADERS,
// JPEG_HEADERS, WEBP_HEADERS).
const PNG_HEADERS: []const u8 = "mlx-out/include/mlx-png"
const JPEG_HEADERS: []const u8 = "mlx-out/include/mlx-jpeg"
const WEBP_HEADERS: []const u8 = "mlx-out/include/mlx-webp"
// Where Little CMS's header is made (build.mlx's LCMS2_HEADERS): the
// image decoders' colour management (USE_LCMS).
const LCMS2_HEADERS: []const u8 = "mlx-out/include/mlx-lcms2"
// Where libxml2's headers are made (build.mlx's XML2_HEADERS): the XML
// document parser's <libxml/parser.h>.
const XML2_HEADERS: []const u8 = "mlx-out/include/mlx-xml2"
// Where mlx-soup's headers are made (build.mlx's SOUP_HEADERS).
const SOUP_HEADERS: []const u8 = "mlx-out/include/mlx-soup"
// Where mlxlibc's loader and math library are (build.mlx's
// MLXLIBC_DIRECTORY).
const MLXLIBC_DIRECTORY: []const u8 = "mlx-out/libc"
// Where mlxlibc's headers beyond mlx-cc's own are made (build.mlx's
// LIBC_HEADERS: iconv.h, libintl.h).
const LIBC_HEADERS: []const u8 = "mlx-out/include/mlxlibc"

// A port of WebKit's: what its CMake build takes from Options<PORT>.cmake
// and the Platform<PORT>.cmake files of each library.
pub const Port = struct {
    // Its name, as the steps' descriptions give it.
    name: []const u8
    // What its steps' names start with: "webkit-" then this for its groups
    // (webkit-wpe-wtf), this for the others (wpe-libWTF.a); "" for JSCOnly.
    tag: []const u8
    // The configuration header's lines (NAME VALUE each) and the feature
    // defines the generators take (config.mlx).
    configuration: []const u8
    featureDefines: []const u8
    // Where what it generates goes (its cmakeconfig.h, the headers of
    // bmalloc as <bmalloc/...>, JavaScriptCore/ for JavaScriptCore's
    // DerivedSources and its forwarding headers), its objects (a directory
    // a library), its archives, its programs.
    generated: []const u8
    objects: []const u8
    libraries: []const u8
    programs: []const u8
    // The defines bmalloc's, WTF's and JavaScriptCore's sources compile
    // with (CMake's, in its order, then the build type's), those of WTF
    // with the language standard.
    bmallocDefines: []const u8
    wtfDefines: []const u8
    jscDefines: []const u8
    // Those JavaScriptCore's library adds.
    jscLibraryDefines: []const u8
    // The lists of bmalloc's and WTF's sources (paths under Source/).
    bmallocSources: []const u8
    wtfSources: []const u8
    // The lists JavaScriptCore's unified sources are made of (paths under
    // Source/JavaScriptCore, a line each), and those of its forwarding
    // headers (files of projects/webkit/lists, a line each).
    jscSourceLists: []const u8
    jscHeaderLists: []const u8
    // A list of JavaScriptCore's sources compiled apart from the unified
    // ones (paths under Source/JavaScriptCore; "" for none).
    jscSources: []const u8
    // The include directories beyond every port's, of WTF's sources and of
    // JavaScriptCore's (a line each: source:PATH under Source/,
    // generated:PATH under `generated`, or a path as it is).
    wtfIncludes: []const u8
    jscIncludes: []const u8
    // JavaScriptCore's GLib API (its GLib.cmake): the port's name as
    // generate-api-header.py takes it ("" for no such API), the symbols
    // its headers are made with, the version they carry.
    glibApi: []const u8
    glibApiDefines: []const u8
    glibApiVersion: []const u8
    // The steps that make those (names, a line each), and the libraries
    // programs link with beyond WebKit's, mlx-unicode and mlxlibcpp.
    needs: []const u8
    links: []const u8
    // Whether its programs start on mlxlibc's loader (MLXLIBC_DIRECTORY),
    // with mlxlibc as their C library and no glibc in the process, rather
    // than on the system's C library.
    mlxlibc: bool
}

// The JSCOnly port (config.JSC_ONLY).
pub fn jscOnlyPort() -> Port {
    return Port.{
        .name = "JSCOnly",
        .tag = "",
        .configuration = config.JSC_ONLY,
        .featureDefines = config.JSC_ONLY_FEATURE_DEFINES,
        .generated = "mlx-out/webkit/generated/",
        .objects = "mlx-out/webkit/obj/",
        .libraries = "mlx-out/webkit/lib/",
        .programs = "mlx-out/webkit/bin/",
        // (USE_SYSTEM_MALLOC, as cmakeconfig.h has it for WTF: bmalloc reads
        // no cmakeconfig.h, so it is told here; libpas is still built, for
        // nothing calls it then. PORT.md "Memory": mlx-cc builds libpas's
        // heap configuration on the stack at every call.)
        .bmallocDefines = "-DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WPE__=1 -DBUILDING_bmalloc -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -DUSE_SYSTEM_MALLOC=1 -D_GNU_SOURCE -DNDEBUG",
        .wtfDefines = "-DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WTF -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -DSTATICALLY_LINKED_WITH_bmalloc -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS -std=c++23",
        .jscDefines = "-DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS",
        .jscLibraryDefines = " -DBUILDING_JavaScriptCore -DJavaScriptCore_EXPORTS -DSTATICALLY_LINKED_WITH_WTF -DSTATICALLY_LINKED_WITH_bmalloc",
        .bmallocSources = "projects/webkit/lists/bmalloc.txt",
        .wtfSources = "projects/webkit/lists/wtf.txt",
        .jscSourceLists = "Sources.txt\n",
        .jscHeaderLists = "projects/webkit/lists/jsc-headers.txt\n",
        .jscSources = "",
        .wtfIncludes = "",
        .jscIncludes = "",
        .glibApi = "",
        .glibApiDefines = "",
        .glibApiVersion = "",
        .needs = "",
        .links = "",
        .mlxlibc = true,
    }
}

// The WPE port (config.WPE): WTF with PlatformWPE.cmake's sources (GLib's
// event loop, its files, sockets and resources), JavaScriptCore with the
// remote inspector's GLib sources, all on mlx-glib.
pub fn wpePort() -> Port {
    return Port.{
        .name = "WPE",
        .tag = "wpe-",
        .configuration = config.WPE,
        .featureDefines = config.WPE_FEATURE_DEFINES,
        .generated = "mlx-out/webkit/wpe/generated/",
        .objects = "mlx-out/webkit/wpe/obj/",
        .libraries = "mlx-out/webkit/wpe/lib/",
        .programs = "mlx-out/webkit/wpe/bin/",
        .bmallocDefines = "-DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WPE__=1 -DBUILDING_bmalloc -DGETTEXT_PACKAGE=\\\"WPE\\\" -DHAVE_CONFIG_H=1 -DJSC_GLIB_API_ENABLED -DPAS_BMALLOC=1 -D_GLIBCXX_ASSERTIONS=1 -D_GNU_SOURCE -DNDEBUG",
        .wtfDefines = "-DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WPE__=1 -DBUILDING_WTF -DGETTEXT_PACKAGE=\\\"WPE\\\" -DHAVE_CONFIG_H=1 -DJSC_GLIB_API_ENABLED -DPAS_BMALLOC=1 -DPKGDATADIR=\\\"/usr/local/share/wpe-webkit-2.0\\\" -DSTATICALLY_LINKED_WITH_bmalloc -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS -std=c++23",
        .jscDefines = "-DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WPE__=1 -DGETTEXT_PACKAGE=\\\"WPE\\\" -DHAVE_CONFIG_H=1 -DJSC_GLIB_API_ENABLED -DPAS_BMALLOC=1 -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS",
        .jscLibraryDefines = " -DBUILDING_JavaScriptCore -DPKGLIBDIR=\\\"/usr/local/lib/wpe-webkit-2.0\\\" -DSTATICALLY_LINKED_WITH_WTF -DSTATICALLY_LINKED_WITH_bmalloc",
        .bmallocSources = "projects/webkit/lists/bmalloc.txt",
        .wtfSources = "projects/webkit/lists/wtf-wpe.txt",
        .jscSourceLists = "Sources.txt\ninspector/remote/SourcesGLib.txt\n",
        .jscHeaderLists = "projects/webkit/lists/jsc-headers.txt\nprojects/webkit/lists/jsc-headers-glib.txt\n",
        .jscSources = "projects/webkit/lists/jsc-glib-sources.txt",
        .wtfIncludes = "mlx-out/include/mlx-glib\n",
        .jscIncludes = "source:JavaScriptCore/API/glib\ngenerated:JavaScriptCoreGLib/DerivedSources\ngenerated:JavaScriptCoreGLib/DerivedSources/jsc\ngenerated:JavaScriptCoreGLib/Headers\nsource:JavaScriptCore/inspector/remote/glib\nmlx-out/include/mlx-glib\n",
        .glibApi = "WPE",
        .glibApiDefines = "-DENABLE_2022_GLIB_API=1",
        .glibApiVersion = "PROJECT_VERSION_MAJOR=2 PROJECT_VERSION_MINOR=54 PROJECT_VERSION_MICRO=1",
        .needs = "glib-headers\nlibmlxglib.so\n",
        .links = " mlx-out/lib/libmlxglib.so",
        .mlxlibc = false,
    }
}

// The checkout's directory, absolute (`./mlx build` runs in it).
fn checkoutRoot(b: *Build.Builder) -> []const u8 {
    const root = Build.environment(b, "PWD")
    if root.length == 0 || root[0] != 47 { Build.fail(b, "PWD is not the checkout's absolute directory", root) }
    return root
}

// WebKit's tree: WEBKIT_SOURCE, else the one in the checkout
// (projects/webkit/upstream, WPE WebKit as released: UPSTREAM.md). By
// its path in the checkout, so that the compiles' command lines, and
// with them the result cache's entries, are the same in every checkout
// (the main one and the agents' worktrees); the files that name it from
// elsewhere (the forwarding headers, the links) go up to the checkout
// first (fromDirectory).
fn webkitSource(b: *Build.Builder) -> []const u8 {
    const given = Build.environment(b, "WEBKIT_SOURCE")
    if given.length > 0 { return given }
    return "projects/webkit/upstream"
}

// PATH (absolute, or in the checkout) as a file in DIRECTORY (in the
// checkout) names it: as it is when absolute, else from DIRECTORY up to
// the checkout, as many directories up as DIRECTORY is deep.
fn fromDirectory(b: *Build.Builder, directory: []const u8, path: []const u8) -> []const u8 {
    if path.length > 0 && path[0] == 47 { return path }
    var up = ""
    var start: usize = 0
    var at: usize = 0
    while at <= directory.length {
        if at == directory.length || directory[at] == 47 {
            const part = directory[start..at]
            if part.length > 0 && !std.text.same(part, ".") { up = Build.concat(b, up, "../") }
            start = at + 1
        }
        at += 1
    }
    return Build.concat(b, up, path)
}

fn join3(b: *Build.Builder, a: []const u8, c: []const u8, d: []const u8) -> []const u8 { return Build.concat(b, Build.concat(b, a, c), d) }

fn decimal(b: *Build.Builder, value: usize) -> []const u8 {
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &digits) }
    const length = std.text.appendUnsigned(bytes, 0, 24, value)
    return Build.concat(b, bytes[0..length], "")
}

fn endsWith(text: []const u8, suffix: []const u8) -> bool {
    return text.length >= suffix.length && std.text.same(text[text.length - suffix.length..text.length], suffix)
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && std.text.same(text[0..prefix.length], prefix)
}

// The name of the port's group NAME (webkit-NAME, webkit-wpe-NAME).
fn groupName(b: *Build.Builder, port: Port, name: []const u8) -> []const u8 { return join3(b, "webkit-", port.tag, name) }

// " -IDIRECTORY" for each line of LINES (a Port's includes), under SOURCE
// (Source/ of the tree) or the port's generated files as they say.
fn includes(b: *Build.Builder, port: Port, source: []const u8, lines: []const u8) -> []const u8 {
    var text = ""
    var at: usize = 0
    while at < lines.length {
        const line = Build.nextLine(lines, &at)
        if line.length == 0 { continue }
        var directory = line
        if startsWith(line, "source:") { directory = join3(b, source, "/", line[7..line.length]) }
        if startsWith(line, "generated:") { directory = Build.concat(b, port.generated, line[10..line.length]) }
        text = join3(b, text, " -I", directory)
    }
    return text
}

// STEP after the steps NAMES (a name a line).
fn dependOnAll(b: *Build.Builder, step: Build.Step, names: []const u8) -> void {
    var at: usize = 0
    while at < names.length {
        const name = Build.nextLine(names, &at)
        if name.length > 0 { Build.dependOn(b, step, Build.step(b, name)) }
    }
}

// What the sources of WTF and those above it need made before they
// compile: mlx-unicode's headers, the port's other libraries' (a step
// name a line).
fn sourceNeeds(b: *Build.Builder, port: Port) -> []const u8 { return Build.concat(b, "unicode-headers\n", port.needs) }

// A library's objects: its compile steps gathered under groups of at most
// 100 (a step names at most 128 others), its objects a line in `list`
// (those of the last group first in `chunkList`: as every concatenation
// is kept in the build graph's text, a list grown by a line at a time
// would take the square of its length). The steps are named NAME/...,
// the objects go to DIRECTORY; each step comes after the steps NEEDS
// names (a name a line).
const Objects = struct {
    name: []const u8
    directory: []const u8
    needs: []const u8
    all: Build.Step
    chunk: Build.Step
    inChunk: usize
    chunks: usize
    list: []const u8
    chunkList: []const u8
    count: usize
    // The prefix snapshot of the sources compiled with prefixFlags (the
    // same text: its address and length), its path ("" for none) and step.
    prefixFlags: []const u8
    prefixPath: []const u8
    prefixStep: Build.Step
}

// The objects of the port's library LIBRARY (bmalloc, wtf, jsc...): in
// its objects' directory LIBRARY/, its steps' names starting with its tag,
// each after the steps NEEDS names.
fn objects(b: *Build.Builder, port: Port, library: []const u8, needs: []const u8) -> Objects {
    const name = Build.concat(b, port.tag, library)
    const all = Build.group(b, Build.concat(b, name, "-objects"), Build.concat(b, "the objects of ", name))
    const directory = join3(b, port.objects, library, "/")
    return Objects.{ .name = name, .directory = directory, .needs = needs, .all = all, .chunk = all, .inChunk = 100, .chunks = 0, .list = "", .chunkList = "", .count = 0, .prefixFlags = "", .prefixPath = "", .prefixStep = all }
}

// SET's list with the objects of its last group.
fn flushList(b: *Build.Builder, set: *Objects) -> void {
    if set.*.chunkList.length == 0 { return }
    set.*.list = Build.concat(b, set.*.list, set.*.chunkList)
    set.*.chunkList = ""
}

fn collect(b: *Build.Builder, set: *Objects, step: Build.Step, object: []const u8) -> void {
    if set.*.inChunk >= 100 {
        flushList(b, set)
        set.*.chunks += 1
        const chunk = Build.group(b, join3(b, set.*.name, "-objects-", decimal(b, set.*.chunks)), "")
        Build.add(b, set.*.all, chunk)
        set.*.chunk = chunk
        set.*.inChunk = 0
    }
    Build.add(b, set.*.chunk, step)
    set.*.inChunk += 1
    set.*.chunkList = join3(b, set.*.chunkList, object, "\n")
    set.*.count += 1
}

// The object of SOURCE (a path under ROOT) compiled with FLAGS into
// SET's directory as PATH.o, gathered into SET.
fn compile(b: *Build.Builder, tc: Toolchain, set: *Objects, root: []const u8, path: []const u8, flags: []const u8) -> void {
    _ = compileAs(b, tc, set, join3(b, root, "/", path), path, flags)
}

// The memory (MB) a unit of the library NAME is expected to take at its
// peak until a build of it says (std/src/build/memory.mlx keeps what
// each one took): WebCore's 2.5-4 GB, JavaScriptCore's 1-2 GB, the
// others' under 1 GB (docs/internals/build-time-notes.md).
fn unitMemory(name: []const u8) -> usize {
    if contains(name, "webcore") { return 4096 }
    if contains(name, "jsc") { return 2048 }
    return 1024
}

fn contains(text: []const u8, part: []const u8) -> bool {
    var at: usize = 0
    while at + part.length <= text.length {
        if std.text.same(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

// The object of the file SOURCE compiled with FLAGS into SET's directory
// as NAME.o, gathered into SET.
fn compileAs(b: *Build.Builder, tc: Toolchain, set: *Objects, source: []const u8, name: []const u8, flags: []const u8) -> Build.Step {
    const object = join3(b, set.*.directory, name, ".o")
    const depfile = Build.concat(b, object, ".d")
    // (The flags, tens of kilobytes for WebCore, copied once: every
    // concatenation stays in the build graph's text.)
    var head = join3(b, join3(b, tc.cc, " -MD -MF ", depfile), " ", "")
    const prefixed = set.*.prefixPath.length > 0 && flags.length == set.*.prefixFlags.length && @intFromPtr(flags.pointer) == @intFromPtr(set.*.prefixFlags.pointer)
    if prefixed { head = join3(b, head, "--prefix-snapshot ", Build.concat(b, set.*.prefixPath, " ")) }
    const tail = join3(b, join3(b, " -c ", source, " -o "), object, "")
    const line = join3(b, head, flags, tail)
    const step = Build.command(b, join3(b, set.*.name, "/", name), object, line)
    Build.depfile(b, step, depfile)
    if prefixed { Build.dependOn(b, step, set.*.prefixStep) }
    Build.programEpoch(b, step, tc.epochFile)
    Build.memory(b, step, unitMemory(set.*.name))
    Build.dependOn(b, step, tc.compiler)
    Build.dependOn(b, step, tc.epoch)
    Build.dependOn(b, step, tc.headers)
    dependOnAll(b, step, set.*.needs)
    collect(b, set, step, object)
    return step
}

// SET's sources compiled with FLAGS (the same text, as compileAs is given
// it) start from a prefix snapshot: mlx-cc's state after FLAGS' -include
// files (compiler/cc/snapshot.mlx), written once by a step of its own and
// mapped by each of them instead of reading the prefix again. An object
// made with it is the object made without it, so it is in no object's
// key (the step is ordered before them, and out of the result cache); a
// compiler or a header of the prefix changed makes it again (the
// compiler is its input, the headers are in its depfile), and a unit
// whose state would differ (a header changed since) reads the prefix
// itself.
fn usePrefixSnapshot(b: *Build.Builder, tc: Toolchain, set: *Objects, flags: []const u8) -> void {
    const path = Build.concat(b, set.*.directory, "prefix.snapshot")
    const depfile = Build.concat(b, path, ".d")
    const head = join3(b, join3(b, tc.cc, " --write-prefix-snapshot ", path), " -MD -MF ", Build.concat(b, depfile, " "))
    const line = join3(b, head, flags, " -x c++")
    const step = Build.command(b, Build.concat(b, set.*.name, "/prefix-snapshot"), path, line)
    Build.describe(b, step, Build.concat(b, "the prefix snapshot of ", set.*.name))
    Build.depfile(b, step, depfile)
    Build.uncached(b, step)
    Build.memory(b, step, unitMemory(set.*.name))
    Build.input(b, step, tc.cc)
    Build.dependOn(b, step, tc.compiler)
    Build.dependOn(b, step, tc.headers)
    dependOnAll(b, step, set.*.needs)
    set.*.prefixFlags = flags
    set.*.prefixPath = path
    set.*.prefixStep = step
}

// The archive OUTPUT of SET's objects in the port's libraries (made again
// when one of them is: the object list, written beside it, is its
// depfile); the step is named the port's tag then OUTPUT.
fn archive(b: *Build.Builder, tc: Toolchain, port: Port, set: *Objects, output: []const u8) -> Build.Step {
    flushList(b, set)
    const path = Build.concat(b, port.libraries, output)
    const listPath = Build.concat(b, path, ".objects")
    _ = Build.writeText(b, listPath, set.*.list)
    var line = join3(b, tc.ar, " rcs ", path)
    // (The objects a hundred at a time, as the list above.)
    var words: []const u8 = ""
    var inWords: usize = 0
    var at: usize = 0
    while at < set.*.list.length {
        const object = Build.nextLine(set.*.list, &at)
        if object.length == 0 { continue }
        words = join3(b, words, " ", object)
        inWords += 1
        if inWords == 100 {
            line = Build.concat(b, line, words)
            words = ""
            inWords = 0
        }
    }
    line = Build.concat(b, line, words)
    const step = Build.command(b, Build.concat(b, port.tag, output), path, line)
    Build.depfile(b, step, listPath)
    Build.input(b, step, tc.ar)
    Build.dependOn(b, step, tc.archiver)
    Build.dependOn(b, step, set.*.all)
    return step
}

// bmalloc: libpas (C) and bmalloc (C++), as WPE builds them.
fn bmalloc(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, groupName(b, port, "bmalloc"), join3(b, "bmalloc and libpas, WebKit's allocator (", port.name, ")"))
    const root = Build.concat(b, webkitSource(b), "/Source")
    const s = root
    var flags = port.bmallocDefines
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc"))
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc/bmalloc"))
    flags = join3(b, flags, " -I", Build.concat(b, s, "/bmalloc/libpas/src/libpas"))
    var set = objects(b, port, "bmalloc", "")
    const listing = Build.readText(b, port.bmallocSources)
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        compile(b, tc, &set, root, path, if endsWith(path, ".cpp") { Build.concat(b, flags, " -std=c++23") } else { flags })
    }
    Build.add(b, group, archive(b, tc, port, &set, "libbmalloc.a"))
    return group
}

// The configuration header (cmakeconfig.h) of LINES (NAME VALUE each).
fn configHeader(b: *Build.Builder, lines: []const u8) -> []const u8 {
    var text = "/* cmakeconfig.h: WebKit's configuration, made by ./mlx build from projects/webkit/config.mlx. */\n#ifndef CMAKECONFIG_H\n#define CMAKECONFIG_H\n"
    var at: usize = 0
    while at < lines.length {
        const line = Build.nextLine(lines, &at)
        if line.length > 0 { text = join3(b, text, "#define ", Build.concat(b, line, "\n")) }
    }
    return Build.concat(b, text, "#endif\n")
}

// <bmalloc/NAME.h> for each header of bmalloc and libpas, as WebKit's
// build copies them: a header including the one in the tree, in the
// port's generated files.
fn bmallocHeaders(b: *Build.Builder, port: Port, source: []const u8) -> void {
    const directories = [2][]const u8{ "/bmalloc/bmalloc", "/bmalloc/libpas/src/libpas" }
    for directory in directories {
        const path = Build.concat(b, source, directory)
        const names = Build.filesIn(b, path, ".h")
        var at: usize = 0
        while at < names.length {
            const name = Build.nextLine(names, &at)
            if name.length == 0 { continue }
            const text = join3(b, "#include \"", fromDirectory(b, Build.concat(b, port.generated, "bmalloc/"), join3(b, path, "/", name)), "\"\n")
            _ = Build.writeText(b, join3(b, port.generated, "bmalloc/", name), text)
        }
    }
}

// The flags WTF's sources compile with for the port: its defines, its
// configuration header and bmalloc's headers, WTF's directories,
// mlx-unicode's headers for what WTF asks of ICU, the port's own.
fn wtfFlags(b: *Build.Builder, port: Port, root: []const u8) -> []const u8 {
    const w = Build.concat(b, root, "/WTF")
    var flags = port.wtfDefines
    // mlx-cc has no vector registers nor GCC's vector types: SIMDe
    // emulates them with arrays, its x86 intrinsics native (SSE2, x86-64's
    // baseline, as every x86-64 compiler has them and WebKit's
    // SIMDHelpers.h takes them on x86-64: mlx-cc's <emmintrin.h>, PORT.md
    // "The toolchain, not WebKit"); simdutf takes its portable
    // implementation.
    flags = Build.concat(b, flags, " -DSIMDE_NO_VECTOR -DSIMDE_X86_SSE2_NATIVE -DSIMDUTF_IMPLEMENTATION_ICELAKE=0 -DSIMDUTF_IMPLEMENTATION_HASWELL=0 -DSIMDUTF_IMPLEMENTATION_WESTMERE=0")
    // The generated headers; bmalloc's also by their own names, as the
    // headers among them include each other.
    flags = join3(b, flags, " -I", port.generated)
    flags = join3(b, flags, " -I", Build.concat(b, port.generated, "bmalloc"))
    flags = join3(b, flags, " -I", w)
    const subdirectories = [10][]const u8{ "/wtf", "/wtf/dtoa", "/wtf/fast_float", "/wtf/persistence", "/wtf/simdutf", "/wtf/text", "/wtf/text/icu", "/wtf/threads", "/wtf/unicode", "" }
    for sub in subdirectories {
        if sub.length > 0 { flags = join3(b, flags, " -I", Build.concat(b, w, sub)) }
    }
    flags = join3(b, flags, " -I", UNICODE_HEADERS)
    return Build.concat(b, flags, includes(b, port, root, port.wtfIncludes))
}

// WTF, WebKit's base library, configured for the port, against
// mlx-unicode for what it asks of ICU (and mlx-glib for GLib, WPE).
fn wtf(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const description = if port.needs.length > 0 { " on mlx-unicode and mlx-glib" } else { " on mlx-unicode" }
    const group = Build.group(b, groupName(b, port, "wtf"), join3(b, join3(b, "WTF, WebKit's base library (", port.name, "),"), description, ""))
    const root = Build.concat(b, webkitSource(b), "/Source")
    _ = Build.writeText(b, Build.concat(b, port.generated, "cmakeconfig.h"), configHeader(b, port.configuration))
    bmallocHeaders(b, port, root)
    const flags = wtfFlags(b, port, root)
    var set = objects(b, port, "wtf", sourceNeeds(b, port))
    const listing = Build.readText(b, port.wtfSources)
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        // (`port/...`: a port's own file in WebKit's place, under
        // projects/webkit: port/wtf/RunLoopGenericMlx.cpp.)
        if path.length > 5 && std.text.same(path[0..5], "port/") {
            _ = compileAs(b, tc, &set, Build.concat(b, "projects/webkit/", path), path, flags)
            continue
        }
        compile(b, tc, &set, root, path, flags)
    }
    Build.add(b, group, archive(b, tc, port, &set, "libWTF.a"))
    return group
}

// What JavaScriptCore's build generates for the port, made by WebKit's
// generators ported to Mlx (projects/webkit/generators), into its
// JavaScriptCore/ (CMake's JavaScriptCore/DerivedSources).
fn jscDerivedDirectory(b: *Build.Builder, port: Port) -> []const u8 { return Build.concat(b, port.generated, "JavaScriptCore/") }

// The name of a source's file without its directory and extension.
fn stem(path: []const u8) -> []const u8 {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    var end = path.length
    while end > start && path[end - 1] != 46 { end -= 1 }
    return if end > start { path[start..end - 1] } else { path[start..path.length] }
}

// WebKit's generators in Mlx, the programs mlx-out/bin/NAME of
// projects/webkit/generators/ROOT: declared once, every port's steps run
// them.
fn declareGenerators(b: *Build.Builder) -> void {
    declare(b, "webkit-hash-table", "hashtable.mlx")
    declare(b, "webkit-bytecodes", "bytecodes.mlx")
    declare(b, "webkit-wasm-ops", "wasmops.mlx")
    declare(b, "webkit-wasm-omg", "wasmomg.mlx")
    declare(b, "webkit-air-opcodes", "airopcodes.mlx")
    declare(b, "webkit-keyword-lookup", "keywordlookup.mlx")
    declare(b, "webkit-lexer-unicode-tables", "lexerunicode.mlx")
    declare(b, "webkit-regex-tables", "regextables.mlx")
    declare(b, "webkit-yarr-canonicalize", "yarrcanonicalize.mlx")
    declare(b, "webkit-yarr-unicode-tables", "yarrunicode.mlx")
    declare(b, "webkit-builtins", "builtins.mlx")
    declare(b, "webkit-preferences", "preferences.mlx")
    declare(b, "webkit-combined-inspector-json", "inspectorjson.mlx")
    declare(b, "webkit-inspector-protocol-bindings", "inspector.mlx")
    declare(b, "webkit-offlineasm", "offlineasm/offlineasm.mlx")
    declare(b, "webkit-glib-api", "glibapi.mlx")
}

fn declare(b: *Build.Builder, name: []const u8, root: []const u8) -> void {
    _ = Build.program(b, name, Build.concat(b, "projects/webkit/generators/", root))
}

// The generator NAME (declareGenerators), in GROUP.
fn generator(b: *Build.Builder, group: Build.Step, name: []const u8) -> Build.Step {
    const step = Build.step(b, name)
    Build.add(b, group, step)
    return step
}

// The static hash tables (NAME.lut.h) of the sources in lists/jsc-lut.txt,
// by webkit-hash-table (create_hash_table's port); parser/Keywords.table
// makes Lexer.lut.h.
fn jscHashTables(b: *Build.Builder, port: Port, source: []const u8) -> Build.Step {
    const group = Build.group(b, groupName(b, port, "jsc-lut"), join3(b, "JavaScriptCore's static hash tables (.lut.h, ", port.name, "), by webkit-hash-table"))
    const program = generator(b, group, "webkit-hash-table")
    const d = jscDerivedDirectory(b, port)
    const listing = Build.readText(b, "projects/webkit/lists/jsc-lut.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        const name = if std.text.same(stem(path), "Keywords") { "Lexer" } else { stem(path) }
        const input = join3(b, source, "/JavaScriptCore/", path)
        const output = join3(b, d, name, ".lut.h")
        const step = Build.command(b, join3(b, Build.concat(b, port.tag, "jsc/"), name, ".lut.h"), output, join3(b, "mlx-out/bin/webkit-hash-table ", input, Build.concat(b, " ", output)))
        Build.input(b, step, input)
        Build.input(b, step, "mlx-out/bin/webkit-hash-table")
        Build.dependOn(b, step, program)
        Build.add(b, group, step)
    }
    return group
}

// A step of GROUP running GENERATOR (mlx-out/bin/NAME) with ARGUMENTS,
// making OUTPUTS (paths, a line each) of INPUTS (likewise).
fn generate(b: *Build.Builder, port: Port, group: Build.Step, generatorStep: Build.Step, name: []const u8, arguments: []const u8, outputs: []const u8, inputs: []const u8) -> Build.Step {
    const program = Build.concat(b, "mlx-out/bin/", name)
    var at: usize = 0
    const first = Build.nextLine(outputs, &at)
    const step = Build.command(b, join3(b, port.tag, "jsc/", baseName(first)), first, join3(b, program, " ", arguments))
    while at < outputs.length {
        const other = Build.nextLine(outputs, &at)
        if other.length > 0 { Build.output(b, step, other) }
    }
    at = 0
    while at < inputs.length {
        const input = Build.nextLine(inputs, &at)
        if input.length > 0 { Build.input(b, step, input) }
    }
    Build.input(b, step, program)
    Build.dependOn(b, step, generatorStep)
    Build.add(b, group, step)
    return step
}

// The bytecodes (Bytecodes.h and the rest), of bytecode/BytecodeList.rb,
// by webkit-bytecodes (generator/main.rb's port).
fn jscBytecodes(b: *Build.Builder, port: Port, group: Build.Step, jsc: []const u8) -> void {
    const program = generator(b, group, "webkit-bytecodes")
    const list = Build.concat(b, jsc, "/bytecode/BytecodeList.rb")
    const wasm = Build.concat(b, jsc, "/wasm/wasm.json")
    const d = jscDerivedDirectory(b, port)
    var arguments = join3(b, "--bytecodes_h ", d, "Bytecodes.h")
    arguments = join3(b, arguments, " --init_bytecodes_asm ", Build.concat(b, d, "InitBytecodes.asm"))
    arguments = join3(b, arguments, " --bytecode_structs_h ", Build.concat(b, d, "BytecodeStructs.h"))
    arguments = join3(b, arguments, " --bytecode_indices_h ", Build.concat(b, d, "BytecodeIndices.h"))
    arguments = join3(b, arguments, " --wasm_json ", wasm)
    arguments = join3(b, arguments, " --bytecode_dumper ", Build.concat(b, d, "BytecodeDumperGenerated.cpp"))
    arguments = join3(b, arguments, " ", list)
    var outputs = join3(b, d, "Bytecodes.h\n", d)
    outputs = join3(b, outputs, "InitBytecodes.asm\n", d)
    outputs = join3(b, outputs, "BytecodeStructs.h\n", d)
    outputs = join3(b, outputs, "BytecodeIndices.h\n", d)
    outputs = Build.concat(b, outputs, "BytecodeDumperGenerated.cpp\n")
    _ = generate(b, port, group, program, "webkit-bytecodes", arguments, outputs, join3(b, list, "\n", wasm))
}

// WasmOps.h and WasmOMGIRGeneratorInlines.h of wasm/wasm.json, the Air
// opcodes of b3/air/AirOpcode.opcodes.
fn jscWasmAndAir(b: *Build.Builder, port: Port, group: Build.Step, jsc: []const u8) -> void {
    const d = jscDerivedDirectory(b, port)
    const wasm = Build.concat(b, jsc, "/wasm/wasm.json")
    const ops = generator(b, group, "webkit-wasm-ops")
    _ = generate(b, port, group, ops, "webkit-wasm-ops", join3(b, wasm, " ", Build.concat(b, d, "WasmOps.h")), Build.concat(b, d, "WasmOps.h"), wasm)
    const omg = generator(b, group, "webkit-wasm-omg")
    const inlines = Build.concat(b, d, "WasmOMGIRGeneratorInlines.h")
    _ = generate(b, port, group, omg, "webkit-wasm-omg", join3(b, wasm, " ", inlines), inlines, wasm)
    const opcodes = Build.concat(b, jsc, "/b3/air/AirOpcode.opcodes")
    const air = generator(b, group, "webkit-air-opcodes")
    var outputs = join3(b, d, "AirOpcode.h\n", d)
    outputs = join3(b, outputs, "AirOpcodeUtils.h\n", d)
    outputs = Build.concat(b, outputs, "AirOpcodeGenerated.h\n")
    _ = generate(b, port, group, air, "webkit-air-opcodes", join3(b, opcodes, " ", d), outputs, opcodes)
}

// The lexer's and yarr's tables: KeywordLookup.h of parser/Keywords.table,
// the lexer's Unicode properties and yarr's of ucd/, yarr's character
// class tables (built into their generator).
fn jscLexerAndYarr(b: *Build.Builder, port: Port, group: Build.Step, jsc: []const u8) -> void {
    const d = jscDerivedDirectory(b, port)
    const keywords = Build.concat(b, jsc, "/parser/Keywords.table")
    const lookup = generator(b, group, "webkit-keyword-lookup")
    _ = generate(b, port, group, lookup, "webkit-keyword-lookup", join3(b, keywords, " ", Build.concat(b, d, "KeywordLookup.h")), Build.concat(b, d, "KeywordLookup.h"), keywords)
    const unicodeData = Build.concat(b, jsc, "/ucd/UnicodeData.txt")
    const lexer = generator(b, group, "webkit-lexer-unicode-tables")
    const lexerTables = Build.concat(b, d, "LexerUnicodePropertyTables.h")
    _ = generate(b, port, group, lexer, "webkit-lexer-unicode-tables", join3(b, unicodeData, " ", lexerTables), lexerTables, unicodeData)
    const regex = generator(b, group, "webkit-regex-tables")
    const jitTables = Build.concat(b, d, "yarr/RegExpJitTables.h")
    _ = generate(b, port, group, regex, "webkit-regex-tables", jitTables, jitTables, "")
    const caseFolding = Build.concat(b, jsc, "/ucd/CaseFolding.txt")
    const canonicalize = generator(b, group, "webkit-yarr-canonicalize")
    const canonical = Build.concat(b, d, "yarr/YarrCanonicalizeUnicode.cpp")
    _ = generate(b, port, group, canonicalize, "webkit-yarr-canonicalize", join3(b, caseFolding, " ", canonical), canonical, caseFolding)
    const ucd = Build.concat(b, jsc, "/ucd")
    const properties = generator(b, group, "webkit-yarr-unicode-tables")
    const patternTables = Build.concat(b, d, "yarr/UnicodePatternTables.h")
    const step = generate(b, port, group, properties, "webkit-yarr-unicode-tables", join3(b, ucd, " ", patternTables), patternTables, "")
    Build.inputTree(b, step, ucd, ".txt")
}

// JSCBuiltins.h and .cpp of the JavaScript in lists/jsc-builtins.txt, and
// JSCWebPreferenceOptions.h of WTF's UnifiedWebPreferences.yaml.
fn jscBuiltinsAndPreferences(b: *Build.Builder, port: Port, group: Build.Step, source: []const u8, jsc: []const u8) -> void {
    const d = jscDerivedDirectory(b, port)
    const builtins = generator(b, group, "webkit-builtins")
    var arguments = join3(b, "--framework JavaScriptCore --output-directory ", d, " --combined")
    const listing = Build.readText(b, "projects/webkit/lists/jsc-builtins.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 { continue }
        const file = join3(b, jsc, "/", path)
        arguments = join3(b, arguments, " ", file)
    }
    // (More than a step's inputs: builtins/ as a tree.)
    const step = generate(b, port, group, builtins, "webkit-builtins", arguments, join3(b, join3(b, d, "JSCBuiltins.h\n", d), "JSCBuiltins.cpp", "\n"), Build.concat(b, jsc, "/inspector/InjectedScriptSource.js"))
    Build.inputTree(b, step, Build.concat(b, jsc, "/builtins"), ".js")
    const preferences = generator(b, group, "webkit-preferences")
    const template = Build.concat(b, jsc, "/Scripts/PreferencesTemplates/JSCWebPreferenceOptions.h.erb")
    const yaml = Build.concat(b, source, "/WTF/Scripts/Preferences/UnifiedWebPreferences.yaml")
    var line = join3(b, "--frontend JavaScriptCore --outputDir ", d, " --template ")
    line = join3(b, line, template, Build.concat(b, " ", yaml))
    _ = generate(b, port, group, preferences, "webkit-preferences", line, Build.concat(b, d, "JSCWebPreferenceOptions.h"), join3(b, template, "\n", yaml))
}

// The inspector's protocol: CombinedDomains.json of inspector/protocol's
// domains (lists/jsc-inspector.txt), filtered by the port's feature
// defines, then its C++ and JavaScript.
fn jscInspector(b: *Build.Builder, port: Port, group: Build.Step, jsc: []const u8) -> void {
    const d = jscDerivedDirectory(b, port)
    const combined = Build.concat(b, d, "CombinedDomains.json")
    const combiner = generator(b, group, "webkit-combined-inspector-json")
    var arguments = combined
    const listing = Build.readText(b, "projects/webkit/lists/jsc-inspector.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length > 0 { arguments = join3(b, arguments, " ", join3(b, jsc, "/", path)) }
    }
    arguments = join3(b, arguments, " \"", Build.concat(b, port.featureDefines, "\""))
    const step = generate(b, port, group, combiner, "webkit-combined-inspector-json", arguments, combined, "")
    Build.inputTree(b, step, Build.concat(b, jsc, "/inspector/protocol"), ".json")
    const bindings = generator(b, group, "webkit-inspector-protocol-bindings")
    const directory = Build.concat(b, d, "inspector")
    var outputs = ""
    const names = [8][]const u8{ "InspectorAlternateBackendDispatchers.h", "InspectorBackendCommands.js", "InspectorBackendDispatchers.cpp",
        "InspectorBackendDispatchers.h", "InspectorFrontendDispatchers.cpp", "InspectorFrontendDispatchers.h", "InspectorProtocolObjects.cpp", "InspectorProtocolObjects.h" }
    for name in names { outputs = join3(b, outputs, join3(b, directory, "/", name), "\n") }
    const made = generate(b, port, group, bindings, "webkit-inspector-protocol-bindings", join3(b, join3(b, "--outputDir ", directory, " --framework JavaScriptCore "), combined, ""), outputs, combined)
    Build.dependOn(b, made, step)
}

// The LLInt's backend: x86-64 assembly (offlineasm's X86_64), unless the
// port's configuration has the C loop (C_LOOP: the interpreter as C++).
fn interpreterBackend(port: Port) -> []const u8 {
    if contains(port.configuration, "ENABLE_C_LOOP 1") { return "C_LOOP" }
    return "X86_64"
}

// The interpreter's headers, by offlineasm's port (webkit-offlineasm) of
// llint/LowLevelInterpreter.asm: the settings it asks of the compiler
// (LLIntDesiredSettings.h), which LLIntSettingsExtractor.cpp shows in
// its object; the offsets of the structures it reads
// (LLIntDesiredOffsets.h), which LLIntOffsetsExtractor.cpp's object
// shows as mlx-cc lays them out (with the port's configuration); then the
// interpreter (LLIntAssembly.h): x86-64 assembly, which mlx-cc assembles
// from LowLevelInterpreter.cpp's top-level asm statement, or C++ for the
// C_LOOP. GENERATED is
// every other generated source (the extractors include them).
fn jscInterpreter(b: *Build.Builder, tc: Toolchain, port: Port, group: Build.Step, generated: Build.Step, root: []const u8, jsc: []const u8) -> void {
    const d = jscDerivedDirectory(b, port)
    const program = generator(b, group, "webkit-offlineasm")
    const asm = Build.concat(b, jsc, "/llint/LowLevelInterpreter.asm")
    const prefix = join3(b, Build.concat(b, jsc, "/offlineasm -I"), d, Build.concat(b, " ", asm))
    var inputs = ""
    const sources = [5][]const u8{ "LowLevelInterpreter.asm", "LowLevelInterpreter64.asm", "LowLevelInterpreter32_64.asm", "InPlaceInterpreter.asm", "InPlaceInterpreter64.asm" }
    for name in sources { inputs = join3(b, inputs, join3(b, jsc, "/llint/", name), "\n") }
    inputs = join3(b, inputs, d, "InitBytecodes.asm\n")
    const settingsHeader = Build.concat(b, d, "LLIntDesiredSettings.h")
    const backend = interpreterBackend(port)
    const settings = generate(b, port, group, program, "webkit-offlineasm", join3(b, "settings ", prefix, join3(b, " ", settingsHeader, Build.concat(b, " ", backend))), settingsHeader, inputs)
    Build.dependOn(b, settings, generated)
    // (With JavaScriptCore's prefix header, as its sources have it: with
    // the JIT, InlineCacheCompiler.h names CCallHelpers::Jump of a class
    // it only declares, defined by a header the prefix includes.)
    const flags = join3(b, jscFlags(b, port, root, jsc), " -std=c++23 -include ", Build.concat(b, jsc, "/JavaScriptCorePrefix.h"))
    var tools = objects(b, port, "jsc-tools", sourceNeeds(b, port))
    const settingsObject = Build.concat(b, tools.directory, "LLIntSettingsExtractor.cpp.o")
    const settingsExtractor = compileAs(b, tc, &tools, Build.concat(b, jsc, "/llint/LLIntSettingsExtractor.cpp"), "LLIntSettingsExtractor.cpp", flags)
    Build.dependOn(b, settingsExtractor, settings)
    const offsetsHeader = Build.concat(b, d, "LLIntDesiredOffsets.h")
    var line = join3(b, "offsets ", prefix, Build.concat(b, " ", settingsObject))
    line = join3(b, line, " ", join3(b, offsetsHeader, " ", Build.concat(b, backend, " normal")))
    const offsets = generate(b, port, group, program, "webkit-offlineasm", line, offsetsHeader, join3(b, inputs, settingsObject, "\n"))
    Build.dependOn(b, offsets, settingsExtractor)
    const offsetsObject = Build.concat(b, tools.directory, "LLIntOffsetsExtractor.cpp.o")
    const offsetsExtractor = compileAs(b, tc, &tools, Build.concat(b, jsc, "/llint/LLIntOffsetsExtractor.cpp"), "LLIntOffsetsExtractor.cpp", flags)
    Build.dependOn(b, offsetsExtractor, offsets)
    const assemblyHeader = Build.concat(b, d, "LLIntAssembly.h")
    line = join3(b, "assembly ", prefix, Build.concat(b, " ", offsetsObject))
    line = join3(b, line, " ", Build.concat(b, assemblyHeader, " normal --binary-format=ELF"))
    const assembly = generate(b, port, group, program, "webkit-offlineasm", line, assemblyHeader, join3(b, inputs, offsetsObject, "\n"))
    Build.dependOn(b, assembly, offsetsExtractor)
}

// JavaScriptCore's GLib API headers (JavaScriptCoreGLib/), as its
// GLib.cmake makes them: jsc/NAME.h of API/glib/NAME.h.in (the list
// lists/jsc-glib-api.txt) by webkit-glib-api (generate-api-header.py and
// unifdef), jsc/JSCVersion.h configured with the version, and
// Headers/jsc a link to API/glib (for <jsc/jsc.h>).
fn jscGLibApi(b: *Build.Builder, port: Port, group: Build.Step, jsc: []const u8) -> void {
    const d = Build.concat(b, port.generated, "JavaScriptCoreGLib/")
    const program = generator(b, group, "webkit-glib-api")
    const glib = Build.concat(b, jsc, "/API/glib/")
    const listing = Build.readText(b, "projects/webkit/lists/jsc-glib-api.txt")
    var at: usize = 0
    while at < listing.length {
        const name = Build.nextLine(listing, &at)
        if name.length == 0 { continue }
        const input = join3(b, glib, name, ".in")
        const output = join3(b, d, "DerivedSources/jsc/", name)
        var arguments = join3(b, "header ", port.glibApi, " ")
        arguments = join3(b, arguments, input, " ")
        arguments = join3(b, arguments, output, Build.concat(b, " ", port.glibApiDefines))
        _ = generate(b, port, group, program, "webkit-glib-api", arguments, output, input)
    }
    const versionInput = Build.concat(b, glib, "JSCVersion.h.in")
    const version = Build.concat(b, d, "DerivedSources/jsc/JSCVersion.h")
    _ = generate(b, port, group, program, "webkit-glib-api", join3(b, join3(b, "configure ", versionInput, " "), version, Build.concat(b, " ", port.glibApiVersion)), version, versionInput)
    const headers = Build.link(b, Build.concat(b, port.tag, "jsc-glib-headers"), fromDirectory(b, Build.concat(b, d, "Headers"), Build.concat(b, jsc, "/API/glib")))
    Build.output(b, headers, Build.concat(b, d, "Headers/jsc"))
    Build.add(b, group, headers)
}

fn jscDerived(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const all = Build.group(b, groupName(b, port, "jsc-derived"), join3(b, "the sources JavaScriptCore's build generates (", port.name, "), made by its generators in Mlx"))
    const group = Build.group(b, groupName(b, port, "jsc-generated"), join3(b, "what JavaScriptCore's build generates (", port.name, ") but the interpreter"))
    Build.add(b, all, group)
    const source = Build.concat(b, webkitSource(b), "/Source")
    Build.add(b, group, jscHashTables(b, port, source))
    const jsc = Build.concat(b, source, "/JavaScriptCore")
    jscBytecodes(b, port, group, jsc)
    jscWasmAndAir(b, port, group, jsc)
    jscLexerAndYarr(b, port, group, jsc)
    jscBuiltinsAndPreferences(b, port, group, source, jsc)
    jscInspector(b, port, group, jsc)
    if port.glibApi.length > 0 { jscGLibApi(b, port, group, jsc) }
    jscHeaders(b, port, jsc)
    _ = jscUnifiedSources(b, port, jsc)
    const llint = Build.group(b, groupName(b, port, "jsc-llint"), join3(b, "the interpreter's headers (", port.name, "), by webkit-offlineasm and the extractors"))
    Build.add(b, all, llint)
    jscInterpreter(b, tc, port, llint, group, source, jsc)
    return all
}

// The last part of PATH.
fn baseName(path: []const u8) -> []const u8 {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    return path[start..path.length]
}

// <JavaScriptCore/NAME.h> for the headers the port's lists name
// (lists/jsc-headers.txt and the like), as WebKit's build links them: in
// its JavaScriptCore/PrivateHeaders/JavaScriptCore (and
// Headers/JavaScriptCore for the public API), a header including the one
// in the tree, or the generated one.
fn jscHeaders(b: *Build.Builder, port: Port, jsc: []const u8) -> void {
    const d = jscDerivedDirectory(b, port)
    var listAt: usize = 0
    while listAt < port.jscHeaderLists.length {
        const list = Build.nextLine(port.jscHeaderLists, &listAt)
        if list.length == 0 { continue }
        const listing = Build.readText(b, list)
        var at: usize = 0
        while at < listing.length {
            const line = Build.nextLine(listing, &at)
            var space: usize = 0
            while space < line.length && line[space] != 32 { space += 1 }
            if space >= line.length { continue }
            const kind = line[0..space]
            const path = line[space + 1..line.length]
            const name = baseName(path)
            // From PrivateHeaders/JavaScriptCore, the generated ones are two up.
            const directory = if std.text.same(kind, "public") { "Headers/JavaScriptCore/" } else { "PrivateHeaders/JavaScriptCore/" }
            const target = if std.text.same(kind, "private-derived") { Build.concat(b, "../../", path) } else { fromDirectory(b, Build.concat(b, d, directory), join3(b, jsc, "/", path)) }
            const text = join3(b, "#include \"", target, "\"\n")
            _ = Build.writeText(b, join3(b, d, directory, name), text)
        }
    }
}

// The flags JavaScriptCore's sources compile with for the port (its
// includes and defines, without those of the library itself).
fn jscFlags(b: *Build.Builder, port: Port, root: []const u8, jsc: []const u8) -> []const u8 {
    const d = jscDerivedDirectory(b, port)
    var common = port.jscDefines
    common = Build.concat(b, common, " -DSIMDE_NO_VECTOR -DSIMDE_X86_SSE2_NATIVE -DSIMDUTF_IMPLEMENTATION_ICELAKE=0 -DSIMDUTF_IMPLEMENTATION_HASWELL=0 -DSIMDUTF_IMPLEMENTATION_WESTMERE=0")
    common = join3(b, common, " -I", Build.concat(b, d, "Headers"))
    common = join3(b, common, " -I", Build.concat(b, d, "PrivateHeaders"))
    common = join3(b, common, " -I", port.generated)
    common = join3(b, common, " -I", Build.concat(b, d, "PrivateHeaders/JavaScriptCore"))
    common = join3(b, common, " -I", jsc)
    const subdirectories = [37][]const u8{ "API", "assembler", "b3", "b3/air", "bindings", "builtins", "bytecode", "bytecompiler", "dfg", "disassembler",
        "disassembler/ARM64", "disassembler/zydis", "domjit", "ftl", "fuzzilli", "heap", "debugger", "inspector", "inspector/agents", "inspector/augmentable",
        "inspector/remote", "interpreter", "jit", "llint", "lol", "parser", "profiler", "runtime", "runtime/temporal/core", "tools", "wasm", "wasm/debugger",
        "wasm/js", "yarr", "", "", "" }
    for sub in subdirectories {
        if sub.length > 0 { common = join3(b, common, " -I", join3(b, jsc, "/", sub)) }
    }
    const derivedDirectories = [4][]const u8{ "", "inspector", "runtime", "yarr" }
    for sub in derivedDirectories { common = join3(b, common, " -I", Build.concat(b, d, sub)) }
    common = join3(b, common, " -I", Build.concat(b, root, "/WTF"))
    common = join3(b, common, " -I", Build.concat(b, port.generated, "bmalloc"))
    common = join3(b, common, " -I", UNICODE_HEADERS)
    return Build.concat(b, common, includes(b, port, root, port.jscIncludes))
}

// JavaScriptCore (the LLInt in assembly and the JIT, or the C_LOOP: the
// port's configuration says), its unified sources bundled here as WebKit
// bundles them (of the port's lists, copied among the generated sources
// as WebKit's build copies them), on WTF, bmalloc and mlx-unicode.
fn javaScriptCore(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, groupName(b, port, "jsc"), join3(b, "JavaScriptCore (", port.name, join3(b, ", ", interpreterBackend(port), "), on WTF and mlx-unicode")))
    const root = Build.concat(b, webkitSource(b), "/Source")
    const jsc = Build.concat(b, root, "/JavaScriptCore")
    const d = jscDerivedDirectory(b, port)
    const common = jscFlags(b, port, root, jsc)
    const library = Build.concat(b, common, port.jscLibraryDefines)
    // (Then the port's own: projects/webkit/port/JavaScriptCoreMlxPrefix.h.)
    const prefixed = join3(b, library, " -std=c++23 -include ", Build.concat(b, jsc, "/JavaScriptCorePrefix.h"))
    const cpp = Build.concat(b, prefixed, " -include projects/webkit/port/JavaScriptCoreMlxPrefix.h")
    var set = objects(b, port, "jsc", join3(b, sourceNeeds(b, port), groupName(b, port, "jsc-derived"), "\n"))
    usePrefixSnapshot(b, tc, &set, cpp)
    const sources = jscUnifiedSources(b, port, jsc)
    var at: usize = 0
    while at < sources.length {
        const path = Build.nextLine(sources, &at)
        if path.length == 0 { continue }
        // (Headers in the list are only listed.)
        if endsWith(path, ".c") { _ = compileAs(b, tc, &set, path, baseName(path), library) }
        if endsWith(path, ".cpp") { _ = compileAs(b, tc, &set, path, baseName(path), cpp) }
    }
    _ = compileAs(b, tc, &set, Build.concat(b, d, "JSCBuiltins.cpp"), "JSCBuiltins.cpp", cpp)
    // The port's sources apart (WPE: the GLib API's).
    if port.jscSources.length > 0 {
        const listing = Build.readText(b, port.jscSources)
        at = 0
        while at < listing.length {
            const path = Build.nextLine(listing, &at)
            if path.length > 0 { compile(b, tc, &set, jsc, path, cpp) }
        }
    }
    // The interpreter, apart (WebKit's LowLevelInterpreterLib).
    _ = compileAs(b, tc, &set, Build.concat(b, jsc, "/llint/LowLevelInterpreter.cpp"), "LowLevelInterpreter.cpp", Build.concat(b, common, " -std=c++23"))
    Build.add(b, group, archive(b, tc, port, &set, "libJavaScriptCore.a"))
    return group
}

// JavaScriptCore's unified sources for the port: its source lists
// (Sources.txt and the like) copied among its generated sources, as
// WebKit's build copies them, and bundled into unified-sources/ there.
// What to compile, a path a line.
fn jscUnifiedSources(b: *Build.Builder, port: Port, jsc: []const u8) -> []const u8 {
    const d = jscDerivedDirectory(b, port)
    var copies = ""
    var at: usize = 0
    while at < port.jscSourceLists.length {
        const list = Build.nextLine(port.jscSourceLists, &at)
        if list.length == 0 { continue }
        const copy = Build.concat(b, d, list)
        _ = Build.writeText(b, copy, Build.readText(b, join3(b, jsc, "/", list)))
        copies = join3(b, copies, copy, "\n")
    }
    const options = unified.Options.{ .maxBundleSize = 8, .enforceCost = false, .denseFilters = "" }
    return unified.bundle(b, copies, Build.concat(b, d, "unified-sources"), jsc, Build.concat(b, d, "."), options)
}

// The program PROGRAM of OBJECT (made by COMPILED) linked with the port's
// libraries LIBRARIES (archive names, a line each), mlx-unicode, the
// port's other libraries, mlxlibcpp and the math library.
//
// A port on mlxlibc (Port.mlxlibc) has its programs start on mlxlibc's
// loader: the program names it as its interpreter and mlx-unicode by
// its path (both absolute, in this checkout: a program of the build tree,
// as an installed one would name /lib/mlx/libmlxc.so.1); libc.so.6 is the
// loader itself and libm.so.6 the one beside it. Nothing of glibc is in
// the process, and the program needs no LD_LIBRARY_PATH.
fn linkProgram(b: *Build.Builder, tc: Toolchain, port: Port, name: []const u8, program: []const u8, object: []const u8, compiled: Build.Step, libraries: []const u8) -> Build.Step {
    var line = join3(b, tc.cc, " -o ", program)
    line = join3(b, line, " ", object)
    var at: usize = 0
    while at < libraries.length {
        const library = Build.nextLine(libraries, &at)
        if library.length > 0 { line = join3(b, line, " ", Build.concat(b, port.libraries, library)) }
    }
    // mlx-unicode; the port's; mlxlibcpp (mlx-cc adds it by itself only
    // when it compiles C++ sources); the math library.
    if port.mlxlibc {
        const root = checkoutRoot(b)
        line = join3(b, line, " --dynamic-linker=", join3(b, root, "/", Build.concat(b, MLXLIBC_DIRECTORY, "/libmlxc.so.1")))
        line = join3(b, line, " -l:", Build.concat(b, root, "/mlx-out/lib/libmlxunicode.so"))
        line = Build.concat(b, line, port.links)
    } else {
        line = join3(b, line, " mlx-out/lib/libmlxunicode.so", port.links)
    }
    line = Build.concat(b, line, " -Lmlx-out/lib -lmlxcpp -lm")
    const step = Build.command(b, name, program, line)
    if port.mlxlibc { Build.dependOn(b, step, Build.step(b, "libc")) }
    Build.input(b, step, object)
    at = 0
    while at < libraries.length {
        const library = Build.nextLine(libraries, &at)
        if library.length == 0 { continue }
        Build.input(b, step, Build.concat(b, port.libraries, library))
        Build.dependOn(b, step, Build.step(b, Build.concat(b, port.tag, library)))
    }
    Build.input(b, step, "mlx-out/lib/libmlxunicode.so")
    Build.dependOn(b, step, Build.step(b, "unicode"))
    dependOnAll(b, step, port.needs)
    Build.dependOn(b, step, compiled)
    Build.dependOn(b, step, tc.library)
    Build.input(b, step, tc.ld)
    Build.dependOn(b, step, tc.linker)
    return step
}

// jsc, JavaScriptCore's shell (WebKit's Source/JavaScriptCore/jsc.cpp),
// linked with JavaScriptCore, WTF, bmalloc and mlx-unicode (and mlx-glib,
// WPE) into the port's programs (mlx-out/webkit/bin/jsc,
// mlx-out/webkit/wpe/bin/jsc).
fn jscShell(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, groupName(b, port, "jsc-shell"), "jsc, JavaScriptCore's shell")
    const root = Build.concat(b, webkitSource(b), "/Source")
    const jsc = Build.concat(b, root, "/JavaScriptCore")
    var set = objects(b, port, "jsc-shell", join3(b, sourceNeeds(b, port), groupName(b, port, "jsc-derived"), "\n"))
    // (With JavaScriptCore's prefix header, as the extractors: with the
    // JIT, InlineCacheCompiler.h names CCallHelpers::Jump of a class it
    // only declares.)
    const flags = join3(b, jscFlags(b, port, root, jsc), " -DBUILDING_jsc -std=c++23 -include ", Build.concat(b, jsc, "/JavaScriptCorePrefix.h"))
    const compiled = compileAs(b, tc, &set, Build.concat(b, jsc, "/jsc.cpp"), "jsc.cpp", flags)
    const step = linkProgram(b, tc, port, Build.concat(b, port.tag, "jsc"), Build.concat(b, port.programs, "jsc"), Build.concat(b, set.directory, "jsc.cpp.o"),
        set.all, "libJavaScriptCore.a\nlibWTF.a\nlibbmalloc.a\n")
    Build.add(b, group, step)
    return group
}

// The generic run loop's timers at work (projects/webkit/tests/
// wtf-runloop.cpp, JSCOnly's WTF): linked with WTF, bmalloc and
// mlx-unicode into mlx-out/webkit/bin/wtf-runloop
// (tools/check_jsc_mlxlibc.sh runs it).
fn wtfRunLoopTest(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, groupName(b, port, "wtf-runloop"), "a program of WTF's generic run loop: timers started, stopped, destroyed and fired")
    const root = Build.concat(b, webkitSource(b), "/Source")
    var set = objects(b, port, "wtf-runloop", sourceNeeds(b, port))
    const compiled = compileAs(b, tc, &set, "projects/webkit/tests/wtf-runloop.cpp", "wtf-runloop.cpp", Build.concat(b, wtfFlags(b, port, root), " -DSTATICALLY_LINKED_WITH_WTF"))
    const step = linkProgram(b, tc, port, Build.concat(b, port.tag, "wtf-runloop"), Build.concat(b, port.programs, "wtf-runloop"), Build.concat(b, set.directory, "wtf-runloop.cpp.o"), set.all, "libWTF.a\nlibbmalloc.a\n")
    Build.add(b, group, step)
    return group
}

// The WPE port's WTF at work (projects/webkit/tests/wtf-wpe.cpp): its
// main run loop on GLib with timers, a work queue's thread, strings and
// URLs; linked with WTF, bmalloc, mlx-glib and mlx-unicode into
// mlx-out/webkit/wpe/bin/wtf-test (tools/check_wpe_wtf.sh runs it).
fn wtfTest(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, groupName(b, port, "wtf-test"), join3(b, "a program of WTF's (", port.name, "): run loop, timers, work queues, strings, URLs"))
    const root = Build.concat(b, webkitSource(b), "/Source")
    var set = objects(b, port, "wtf-test", sourceNeeds(b, port))
    const compiled = compileAs(b, tc, &set, "projects/webkit/tests/wtf-wpe.cpp", "wtf-wpe.cpp", Build.concat(b, wtfFlags(b, port, root), " -DSTATICALLY_LINKED_WITH_WTF"))
    const program = Build.concat(b, port.programs, "wtf-test")
    const step = linkProgram(b, tc, port, Build.concat(b, port.tag, "wtf-test"), program, Build.concat(b, set.directory, "wtf-wpe.cpp.o"), set.all, "libWTF.a\nlibbmalloc.a\n")
    Build.add(b, group, step)
    return group
}

// JavaScriptCore of the WPE port through its GLib API
// (projects/webkit/tests/jsc-glib.c, C, <jsc/jsc.h>): scripts, values,
// C functions and classes, exceptions; linked with JavaScriptCore, WTF,
// bmalloc, mlx-glib and mlx-unicode into mlx-out/webkit/wpe/bin/jsc-glib
// (tools/check_wpe_jsc.sh runs it).
fn jscGLibTest(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, groupName(b, port, "jsc-glib-test"), join3(b, "a program of JavaScriptCore's GLib API (", port.name, ")"))
    var set = objects(b, port, "jsc-glib-test", join3(b, sourceNeeds(b, port), groupName(b, port, "jsc-derived"), "\n"))
    var flags = Build.concat(b, port.generated, "JavaScriptCoreGLib/DerivedSources")
    flags = join3(b, Build.concat(b, "-I", flags), " -I", Build.concat(b, port.generated, "JavaScriptCoreGLib/Headers"))
    flags = Build.concat(b, flags, includes(b, port, Build.concat(b, webkitSource(b), "/Source"), port.wtfIncludes))
    _ = compileAs(b, tc, &set, "projects/webkit/tests/jsc-glib.c", "jsc-glib.c", flags)
    const step = linkProgram(b, tc, port, Build.concat(b, port.tag, "jsc-glib"), Build.concat(b, port.programs, "jsc-glib"), Build.concat(b, set.directory, "jsc-glib.c.o"),
        set.all, "libJavaScriptCore.a\nlibWTF.a\nlibbmalloc.a\n")
    Build.add(b, group, step)
    return group
}

// ANGLE (angle.mlx): libANGLE.a and libGLESv2.a, as WebKit's CMake
// builds and archives them for WPE, and the headers it gives WebCore
// (mlx-out/webkit/generated/ANGLE/Headers).
// (In the JSCOnly port's directories: ANGLE is the same for every port.)
fn angle(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, "webkit-angle", "ANGLE, WebGL's OpenGL ES (libANGLE.a, libGLESv2.a)")
    const root = Build.concat(b, webkitSource(b), "/Source/ThirdParty/ANGLE")
    angleModule.headers(b, root, port.generated)
    const lists = [2][]const u8{ "angle", "angle-glesv2" }
    const archives = [2][]const u8{ "libANGLE.a", "libGLESv2.a" }
    const implementations = [2][]const u8{ "LIBANGLE_IMPLEMENTATION", "LIBGLESV2_IMPLEMENTATION" }
    var index: usize = 0
    while index < 2 {
        const flags = angleModule.flags(b, root, implementations[index])
        const cpp = Build.concat(b, flags, angleModule.cppFlags(b, root))
        // (Sources include mlx-zlib's, mlx-vulkan's and mlx-spirv's headers.)
        var set = objects(b, port, lists[index], "zlib-headers\nvulkan-headers\nspirv-headers\n")
        // libANGLE.a: lists/angle.txt, then its Vulkan backend and SPIR-V
        // translator (lists/angle-vulkan.txt), then the port's own files
        // (projects/webkit/port/angle) for what WebKit's ANGLE leaves to
        // third-party libraries (angle.mlx's angleOwnSources).
        var listing = Build.readText(b, join3(b, "projects/webkit/lists/", lists[index], ".txt"))
        if index == 0 { listing = Build.concat(b, listing, Build.readText(b, "projects/webkit/lists/angle-vulkan.txt")) }
        var at: usize = 0
        while at < listing.length {
            const path = Build.nextLine(listing, &at)
            if path.length == 0 { continue }
            const extra = angleModule.sourceFlags(b, path)
            const used = if endsWith(path, ".c") { flags } else { cpp }
            _ = compileAs(b, tc, &set, join3(b, root, "/", path), path, if extra.length > 0 { Build.concat(b, used, extra) } else { used })
        }
        if index == 0 {
            for own in angleModule.OWN_SOURCES {
                _ = compileAs(b, tc, &set, Build.concat(b, "projects/webkit/port/angle/", own), Build.concat(b, "port/", own), cpp)
            }
        }
        Build.add(b, group, archive(b, tc, port, &set, archives[index]))
        index += 1
    }
    return group
}

// Skia (skia.mlx): libSkia.a, as WebKit's CMake builds it for WPE, of
// the sources in lists/skia.txt but those lists/skia-skipped.txt names
// (with the reason: what they need that is not there yet). In the
// JSCOnly port's directories, as ANGLE; each source compiles after
// mlx-freetype's and mlx-zlib's headers are made.
fn skia(b: *Build.Builder, tc: Toolchain, port: Port) -> Build.Step {
    const group = Build.group(b, "webkit-skia", "Skia, WebKit's 2D graphics (libSkia.a)")
    const root = Build.concat(b, webkitSource(b), "/Source/ThirdParty/skia")
    const flags = join3(b, join3(b, join3(b, skiaModule.flags(b, root, FREETYPE_HEADERS, ZLIB_HEADERS), " -I", PNG_HEADERS), " -I", JPEG_HEADERS), " -I", WEBP_HEADERS)
    const skipped = Build.readText(b, "projects/webkit/lists/skia-skipped.txt")
    var set = objects(b, port, "skia", "freetype-headers\nzlib-headers\npng-headers\njpeg-headers\nwebp-headers\n")
    const listing = Build.readText(b, "projects/webkit/lists/skia.txt")
    var at: usize = 0
    while at < listing.length {
        const path = Build.nextLine(listing, &at)
        if path.length == 0 || skiaModule.isSkipped(skipped, path) { continue }
        compile(b, tc, &set, root, path, Build.concat(b, flags, skiaModule.sourceFlags(path)))
    }
    Build.dependOn(b, set.all, Build.step(b, "freetype-headers"))
    Build.dependOn(b, set.all, Build.step(b, "zlib-headers"))
    Build.dependOn(b, set.all, Build.step(b, "png-headers"))
    Build.dependOn(b, set.all, Build.step(b, "jpeg-headers"))
    Build.dependOn(b, set.all, Build.step(b, "webp-headers"))
    Build.add(b, group, archive(b, tc, port, &set, "libSkia.a"))
    return group
}

// The defines WebCore's sources compile with in the WPE port (the reference
// build's, Skia's public ones among them, with Skia's portable paths as
// libSkia.a has them: its headers lay out their types by them), and those
// mlx-cc needs as JavaScriptCore's sources do.
const WEBCORE_DEFINES: []const u8 = "-DBITMAP_TEXTURE_POOL_MAX_SIZE_IN_MB=80 -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WPE__=1 -DBUILDING_WebCore -DGETTEXT_PACKAGE=\\\"WPE\\\" -DHAVE_CONFIG_H=1 -DJSC_GLIB_API_ENABLED -DPAS_BMALLOC=1 -DSK_ASSUME_GL=0 -DSK_ASSUME_GL_ES=1 -DSK_ASSUME_WEBGL=0 -DSK_DISABLE_LEGACY_GL_MAKE_NATIVE_INTERFACE -DSK_DISABLE_LEGACY_IMAGE_READBUFFER -DSK_DISABLE_LEGACY_INIT_DECODERS -DSK_DISABLE_LEGACY_PNG_WRITEBUFFER -DSK_DISABLE_TRACING -DSK_DISABLE_WEBGL_INTERFACE -DSK_ENABLE_PRECOMPILE -DSK_R32_SHIFT=16 -DSK_RELEASE -DSTATICALLY_LINKED_WITH_JavaScriptCore -DSTATICALLY_LINKED_WITH_PAL -DSTATICALLY_LINKED_WITH_WTF -DSTATICALLY_LINKED_WITH_bmalloc -DUSE_SYSTEM_EGL -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS -DHAVE_HB_FEATURES_H -DSIMDE_NO_VECTOR -DSIMDE_X86_SSE2_NATIVE -DSIMDUTF_IMPLEMENTATION_ICELAKE=0 -DSIMDUTF_IMPLEMENTATION_HASWELL=0 -DSIMDUTF_IMPLEMENTATION_WESTMERE=0"

// What a port's PAL and WebCore are built with beyond its Port: what its
// WebCore CMake files (Platform<PORT>.cmake, the Options) add.
pub const WebCorePort = struct {
    // The port, and the one whose bmalloc, WTF and JavaScriptCore it
    // stands on (the same for WPE; JSCOnly's for the Mlx port).
    port: Port
    lower: Port
    // What WebCore's build generates for it (webcore.mlx).
    derived: webcore.Derived
    // From WebCore/PrivateHeaders/WebCore, where the generated sources are
    // (for <WebCore/NAME.h> of a generated header).
    derivedFromHeaders: []const u8
    // The defines of WebCore's sources and of PAL's.
    defines: []const u8
    palDefines: []const u8
    // The lists of the include directories (under Source/WebCore, or of the
    // checkout: projects/...), of the forwarding headers (`source PATH`,
    // `derived NAME`, `checkout PATH`) and of the sources compiled apart
    // (`source PATH`, `derived NAME`; "" for none).
    includes: []const u8
    headers: []const u8
    sources: []const u8
    // The include directories after the list's and before Skia's (a line
    // each, as a Port's includes), and the libraries' headers at the end.
    moreIncludes: []const u8
    libraryIncludes: []const u8
    // PAL's source lists (under Source/WebCore/PAL/pal, or of the checkout);
    // "" for no PAL of its own (WPE's is not built yet).
    palLists: []const u8
    // Whether ANGLE's headers are on the include path (WebGL's).
    angle: bool
    // The port's prefix header, included after WebCorePrefix.h ("" for
    // none).
    prefix: []const u8
    // The steps WebCore's sources compile after (a name a line), beyond
    // what is generated.
    needs: []const u8
}

// WPE's WebCore (WEBCORE.md): the reference build's defines, include
// directories, forwarding headers and sources apart, on mlx-glib, mlx-soup
// and the other C API layers.
fn wpeWebCore() -> WebCorePort {
    const wpe = wpePort()
    return WebCorePort.{
        .port = wpe,
        .lower = wpe,
        .derived = webcore.wpe(),
        .derivedFromHeaders = "../../../../../generated/WebCore/",
        .defines = WEBCORE_DEFINES,
        .palDefines = "",
        .includes = "projects/webkit/lists/webcore-includes.txt",
        .headers = "projects/webkit/lists/webcore-headers.txt",
        .sources = "projects/webkit/lists/webcore-sources.txt",
        .moreIncludes = "source:ThirdParty/xdgmime/src\n",
        .libraryIncludes = "mlx-out/include/mlx-glib\nmlx-out/include/mlx-soup\nmlx-out/include/mlx-harfbuzz\nmlx-out/include/mlx-freetype\nmlx-out/include/mlx-zlib\nmlx-out/include/mlx-png\nmlx-out/include/mlx-jpeg\nmlx-out/include/mlx-webp\nmlx-out/include/mlx-lcms2\nmlx-out/include/mlx-xml2\nmlx-out/include/mlxlibc\n",
        .palLists = "",
        .angle = true,
        .prefix = "",
        .needs = "soup-headers\nharfbuzz-headers\nfreetype-headers\nzlib-headers\npng-headers\njpeg-headers\nwebp-headers\nlcms2-headers\nxml2-headers\nlibc-headers\n",
    }
}

// The Mlx port (PORT.md): JSCOnly's bmalloc, WTF and JavaScriptCore, with
// PAL and WebCore configured by config.MLX in its own directories
// (mlx-out/webkit/mlx/...). Its programs run on mlxlibc, as JSCOnly's.
pub fn mlxPort() -> Port {
    var port = jscOnlyPort()
    port.name = "Mlx"
    port.tag = "mlx-"
    port.configuration = config.MLX
    port.featureDefines = config.MLX_FEATURE_DEFINES
    port.generated = "mlx-out/webkit/mlx/generated/"
    port.objects = "mlx-out/webkit/mlx/obj/"
    port.libraries = "mlx-out/webkit/mlx/lib/"
    port.programs = "mlx-out/webkit/mlx/bin/"
    // (The header of the port's Mlx side, port/MlxWebPort.h, is made in
    // its generated directory before the port's sources compile.)
    port.needs = "webkit-mlx-port-headers\n"
    return port
}

// The defines of the Mlx port's WebCore sources: JSCOnly's, as a CMake
// port's WebCore has them (BUILDING_WebCore, linked statically with
// JavaScriptCore, PAL, WTF and bmalloc), Skia's public ones as libSkia.a
// has them, and those mlx-cc needs (as JavaScriptCore's sources).
const MLX_WEBCORE_DEFINES: []const u8 = "-DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_WebCore -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -DSK_ASSUME_GL=0 -DSK_ASSUME_GL_ES=1 -DSK_ASSUME_WEBGL=0 -DSK_DISABLE_LEGACY_GL_MAKE_NATIVE_INTERFACE -DSK_DISABLE_LEGACY_IMAGE_READBUFFER -DSK_DISABLE_LEGACY_INIT_DECODERS -DSK_DISABLE_LEGACY_PNG_WRITEBUFFER -DSK_DISABLE_TRACING -DSK_DISABLE_WEBGL_INTERFACE -DSK_ENABLE_PRECOMPILE -DSK_R32_SHIFT=16 -DSK_RELEASE -DSTATICALLY_LINKED_WITH_JavaScriptCore -DSTATICALLY_LINKED_WITH_PAL -DSTATICALLY_LINKED_WITH_WTF -DSTATICALLY_LINKED_WITH_bmalloc -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS -DHAVE_HB_FEATURES_H -DSIMDE_NO_VECTOR -DSIMDE_X86_SSE2_NATIVE -DSIMDUTF_IMPLEMENTATION_ICELAKE=0 -DSIMDUTF_IMPLEMENTATION_HASWELL=0 -DSIMDUTF_IMPLEMENTATION_WESTMERE=0"

// Those of its PAL sources (PAL's CMake: BUILDING_PAL, on WTF and bmalloc).
const MLX_PAL_DEFINES: []const u8 = "-DBUILDING_JSCONLY__ -DBUILDING_WEBKIT=1 -DBUILDING_WITH_CMAKE=1 -DBUILDING_PAL -DHAVE_CONFIG_H=1 -DPAS_BMALLOC=1 -DSTATICALLY_LINKED_WITH_WTF -DSTATICALLY_LINKED_WITH_bmalloc -D_GLIBCXX_ASSERTIONS=1 -DNDEBUG -DRELEASE_WITHOUT_OPTIMIZATIONS -DSIMDE_NO_VECTOR -DSIMDE_X86_SSE2_NATIVE -DSIMDUTF_IMPLEMENTATION_ICELAKE=0 -DSIMDUTF_IMPLEMENTATION_HASWELL=0 -DSIMDUTF_IMPLEMENTATION_WESTMERE=0"

// The Mlx port's WebCore: Sources.txt and the lists webcore.mlx() names
// (Skia's and Adwaita's platform lists, WebKit's sources of other ports
// that fit, the port's own in projects/webkit/port), the include
// directories of lists/webcore-mlx-includes.txt (the port's headers among
// them: platform/network/mlx's ResourceRequest.h and the others, the image
// decoders of the same names as WebKit's), on mlx-unicode, mlx-harfbuzz and
// mlx-freetype (Skia's text), mlx-zlib, mlx-sqlite3, mlx-xml2 (PORT.md's
// exceptions) and mlxlibc's headers.
fn mlxWebCore() -> WebCorePort {
    return WebCorePort.{
        .port = mlxPort(),
        .lower = jscOnlyPort(),
        .derived = webcore.mlx(),
        .derivedFromHeaders = "../../DerivedSources/",
        .defines = MLX_WEBCORE_DEFINES,
        .palDefines = MLX_PAL_DEFINES,
        .includes = "projects/webkit/lists/webcore-mlx-includes.txt",
        .headers = "projects/webkit/lists/webcore-mlx-headers.txt",
        .sources = "projects/webkit/lists/webcore-mlx-sources-apart.txt",
        // (Khronos's EGL and GLES headers, ANGLE's copy: the types of
        // GLContext.h, BitmapTexture.h and Skia's GL half, which the Skia
        // sources include; no GL library is linked.)
        .moreIncludes = "source:ThirdParty/ANGLE/include\n",
        .libraryIncludes = "mlx-out/include/mlx-harfbuzz\nmlx-out/include/mlx-freetype\nmlx-out/include/mlx-zlib\nmlx-out/include/mlx-sqlite3\nmlx-out/include/mlx-xml2\nmlx-out/include/mlxlibc\nprojects/webkit\n",
        .palLists = "Sources.txt\nprojects/webkit/port/pal/SourcesMlx.txt\n",
        .angle = true,
        .prefix = "projects/webkit/port/MlxPrefix.h",
        .needs = "harfbuzz-headers\nfreetype-headers\nzlib-headers\nsqlite3-headers\nxml2-headers\nlibc-headers\n",
    }
}

// <WebCore/NAME.h> for the headers the port's list names (WebCore's
// Headers.cmake, as the reference build links them): in the port's
// WebCore/PrivateHeaders/WebCore, a header including the one in the tree
// (`source PATH`, under Source/WebCore), the generated one (`derived
// NAME`, where WC.derivedFromHeaders says) or the port's (`checkout PATH`).
fn webcoreHeaders(b: *Build.Builder, wc: WebCorePort, webcoreRoot: []const u8) -> void {
    const directory = Build.concat(b, wc.port.generated, "WebCore/PrivateHeaders/WebCore/")
    const listing = Build.readText(b, wc.headers)
    // (The checkout, from the directory: as many directories up as it is
    // deep.)
    var root = ""
    for byte in directory {
        if byte == 47 { root = Build.concat(b, root, "../") }
    }
    var at: usize = 0
    while at < listing.length {
        const line = Build.nextLine(listing, &at)
        var space: usize = 0
        while space < line.length && line[space] != 32 { space += 1 }
        if space >= line.length { continue }
        const kind = line[0..space]
        const path = line[space + 1..line.length]
        var target = fromDirectory(b, directory, join3(b, webcoreRoot, "/", path))
        if std.text.same(kind, "derived") { target = Build.concat(b, wc.derivedFromHeaders, path) }
        if std.text.same(kind, "checkout") { target = Build.concat(b, root, path) }
        _ = Build.writeText(b, Build.concat(b, directory, baseName(path)), join3(b, "#include \"", target, "\"\n"))
    }
}

// The flags WebCore's sources compile with for the port (C++ adds the
// language standard and WebCorePrefix.h, as CMake's precompiled header):
// its defines, then its include directories in CMake's order: the
// configuration header, WebCore's own headers as <WebCore/...>, its
// generated sources, Source/WebCore and the directories its list names
// (lists/webcore-includes.txt for WPE), the port's others, Skia's
// (Headers/top/skia and Headers/mod/skia/modules/svg are links to its
// include directories, as the reference build makes them),
// JavaScriptCore's (of the port it stands on) and its GLib API's, WTF,
// bmalloc, PAL, ANGLE's (WPE); then the headers of the libraries in Mlx
// it stands on (mlx-unicode, and for WPE mlx-glib, mlx-soup,
// mlx-harfbuzz...) and mlxlibc's headers beyond mlx-cc's own (iconv.h,
// libintl.h).
fn webcoreFlags(b: *Build.Builder, wc: WebCorePort, root: []const u8) -> []const u8 {
    const port = wc.port
    const w = Build.concat(b, root, "/WebCore")
    const jsc = jscDerivedDirectory(b, wc.lower)
    var flags = join3(b, wc.defines, " ", skiaModule.PORTABLE)
    flags = join3(b, flags, " -I", port.generated)
    flags = join3(b, flags, " -I", Build.concat(b, port.generated, "WebCore/PrivateHeaders"))
    flags = join3(b, flags, " -I", wc.derived.directory)
    flags = join3(b, flags, " -I", w)
    const listing = Build.readText(b, wc.includes)
    var at: usize = 0
    while at < listing.length {
        const directory = Build.nextLine(listing, &at)
        if directory.length == 0 { continue }
        // (The port's own directories are the checkout's.)
        flags = join3(b, flags, " -I", if startsWith(directory, "projects/") { directory } else { join3(b, w, "/", directory) })
    }
    flags = Build.concat(b, flags, includes(b, port, root, wc.moreIncludes))
    flags = join3(b, flags, " -I", Build.concat(b, root, "/ThirdParty/skia"))
    flags = join3(b, flags, " -I", Build.concat(b, port.generated, "Skia/Headers/top"))
    flags = join3(b, flags, " -I", Build.concat(b, port.generated, "Skia/Headers/mod"))
    flags = join3(b, flags, " -I", Build.concat(b, jsc, "Headers"))
    flags = join3(b, flags, " -I", Build.concat(b, jsc, "PrivateHeaders"))
    if wc.lower.glibApi.length > 0 {
        flags = join3(b, flags, " -I", Build.concat(b, wc.lower.generated, "JavaScriptCoreGLib/Headers"))
        flags = join3(b, flags, " -I", Build.concat(b, wc.lower.generated, "JavaScriptCoreGLib/DerivedSources"))
    }
    flags = join3(b, flags, " -I", Build.concat(b, root, "/WTF"))
    flags = join3(b, flags, " -I", Build.concat(b, port.generated, "bmalloc"))
    flags = join3(b, flags, " -I", Build.concat(b, w, "/PAL"))
    if wc.angle {
        // (ANGLE's headers are the same for every port: in JSCOnly's
        // directory.)
        const angleHeaders = Build.concat(b, jscOnlyPort().generated, "ANGLE/Headers")
        flags = join3(b, flags, " -I", angleHeaders)
        flags = join3(b, flags, " -I", Build.concat(b, angleHeaders, "/ANGLE"))
    }
    flags = join3(b, flags, " -I", UNICODE_HEADERS)
    return Build.concat(b, flags, includes(b, port, root, wc.libraryIncludes))
}

// The flags of PAL's sources (PAL's CMake: its include directories, then
// WTF's, bmalloc's and ICU's headers as frameworks), with PALPrefix.h first
// as its precompiled header: the configuration header, PAL's directories,
// WTF, bmalloc's headers, mlx-unicode's, the checkout (for the port's
// sources and headers).
fn palFlags(b: *Build.Builder, wc: WebCorePort, root: []const u8) -> []const u8 {
    const pal = Build.concat(b, root, "/WebCore/PAL")
    var flags = wc.palDefines
    flags = join3(b, flags, " -I", wc.port.generated)
    flags = join3(b, flags, " -I", pal)
    const subdirectories = [4][]const u8{ "/pal", "/pal/crypto", "/pal/system", "/pal/text" }
    for sub in subdirectories { flags = join3(b, flags, " -I", Build.concat(b, pal, sub)) }
    flags = join3(b, flags, " -I", Build.concat(b, root, "/WTF"))
    flags = join3(b, flags, " -I", Build.concat(b, wc.port.generated, "bmalloc"))
    flags = join3(b, flags, " -I", UNICODE_HEADERS)
    flags = join3(b, flags, " -I", "projects/webkit")
    return join3(b, flags, " -std=c++23 -include ", Build.concat(b, pal, "/pal/PALPrefix.h"))
}

// PAL, WebCore's platform abstraction library, for the port (WC.palLists:
// PAL's Sources.txt and the port's list, whose sources are WebKit's
// generic ones other ports' CMake files add and the port's own,
// projects/webkit/port/pal): its unified sources, bundled as WebKit
// bundles them into the port's PAL/unified-sources, into libPAL.a.
fn pal(b: *Build.Builder, tc: Toolchain, wc: WebCorePort) -> Build.Step {
    const port = wc.port
    const group = Build.group(b, groupName(b, port, "pal"), join3(b, "PAL, WebCore's platform abstraction library (", port.name, ")"))
    const root = Build.concat(b, webkitSource(b), "/Source")
    const palRoot = Build.concat(b, root, "/WebCore/PAL/pal")
    _ = Build.writeText(b, Build.concat(b, port.generated, "cmakeconfig.h"), configHeader(b, port.configuration))
    bmallocHeaders(b, port, root)
    const directory = Build.concat(b, port.generated, "PAL")
    var copies = ""
    var at: usize = 0
    while at < wc.palLists.length {
        const list = Build.nextLine(wc.palLists, &at)
        if list.length == 0 { continue }
        const ours = startsWith(list, "projects/")
        const copy = join3(b, directory, "/", if ours { baseName(list) } else { list })
        _ = Build.writeText(b, copy, Build.readText(b, if ours { list } else { join3(b, palRoot, "/", list) }))
        copies = join3(b, copies, copy, "\n")
    }
    const options = unified.Options.{ .maxBundleSize = 8, .enforceCost = false, .denseFilters = "" }
    const sources = unified.bundle(b, copies, Build.concat(b, directory, "/unified-sources"), palRoot, directory, options)
    const flags = palFlags(b, wc, root)
    var set = objects(b, port, "pal", sourceNeeds(b, port))
    usePrefixSnapshot(b, tc, &set, flags)
    at = 0
    while at < sources.length {
        const path = Build.nextLine(sources, &at)
        if path.length > 0 && endsWith(path, ".cpp") { _ = compileAs(b, tc, &set, path, baseName(path), flags) }
    }
    Build.add(b, group, archive(b, tc, port, &set, "libPAL.a"))
    return group
}

// The flags of WebCore's C++ sources, of its C sources' (C): C++23,
// WebCorePrefix.h (under W, Source/WebCore) as WebKit's CMake gives it as
// the precompiled header, then the port's prefix header.
fn webcoreCppFlags(b: *Build.Builder, wc: WebCorePort, c: []const u8, w: []const u8) -> []const u8 {
    const cpp = join3(b, c, " -std=c++23 -include ", Build.concat(b, w, "/WebCorePrefix.h"))
    return if wc.prefix.length > 0 { join3(b, cpp, " -include ", wc.prefix) } else { cpp }
}

// WebCore for the port (WPE, Mlx): its unified sources
// (webcore.unifiedSources, of the port's source lists) and the sources its
// CMake files list apart (lists/webcore-sources.txt for WPE: `source PATH`
// under Source/WebCore, `derived NAME` among its generated sources), on
// JavaScriptCore, WTF, bmalloc, Skia (ANGLE for WPE) and the libraries in
// Mlx. Its sources compile after what WebCore's and JavaScriptCore's
// builds generate; the objects are named by their paths under
// Source/WebCore or the generated sources (WEBCORE.md says how far they
// compile).
fn webCore(b: *Build.Builder, tc: Toolchain, wc: WebCorePort) -> Build.Step {
    const port = wc.port
    const group = Build.group(b, groupName(b, port, "webcore"), join3(b, "WebCore (", port.name, "), on JavaScriptCore and Skia"))
    const root = Build.concat(b, webkitSource(b), "/Source")
    const w = Build.concat(b, root, "/WebCore")
    _ = Build.writeText(b, Build.concat(b, port.generated, "cmakeconfig.h"), configHeader(b, port.configuration))
    bmallocHeaders(b, port, root)
    webcoreHeaders(b, wc, w)
    const top = Build.link(b, Build.concat(b, port.tag, "skia-headers"), fromDirectory(b, Build.concat(b, port.generated, "Skia/Headers/top"), Build.concat(b, root, "/ThirdParty/skia/include")))
    Build.output(b, top, Build.concat(b, port.generated, "Skia/Headers/top/skia"))
    const svg = Build.link(b, Build.concat(b, port.tag, "skia-svg-headers"), fromDirectory(b, Build.concat(b, port.generated, "Skia/Headers/mod/skia/modules"), Build.concat(b, root, "/ThirdParty/skia/modules/svg/include")))
    Build.output(b, svg, Build.concat(b, port.generated, "Skia/Headers/mod/skia/modules/svg"))
    var needs = join3(b, sourceNeeds(b, port), wc.needs, Build.concat(b, wc.derived.name, "\n"))
    needs = join3(b, needs, groupName(b, wc.lower, "jsc-generated"), "\n")
    needs = join3(b, needs, Build.concat(b, port.tag, "skia-headers"), "\n")
    needs = join3(b, needs, Build.concat(b, port.tag, "skia-svg-headers"), "\n")
    const c = webcoreFlags(b, wc, root)
    const cpp = webcoreCppFlags(b, wc, c, w)
    var set = objects(b, port, "webcore", needs)
    usePrefixSnapshot(b, tc, &set, cpp)
    const sources = webcore.unifiedSources(b, wc.derived, w)
    var at: usize = 0
    while at < sources.length {
        const path = Build.nextLine(sources, &at)
        if path.length == 0 { continue }
        const name = if startsWith(path, w) { path[w.length + 1..path.length] } else { baseName(path) }
        // (Headers in the lists are only listed.)
        if endsWith(path, ".c") { _ = compileAs(b, tc, &set, path, name, c) }
        if endsWith(path, ".cpp") { _ = compileAs(b, tc, &set, path, name, cpp) }
    }
    const listing = if wc.sources.length > 0 { Build.readText(b, wc.sources) } else { "" }
    at = 0
    while at < listing.length {
        const line = Build.nextLine(listing, &at)
        var space: usize = 0
        while space < line.length && line[space] != 32 { space += 1 }
        if space >= line.length { continue }
        const path = line[space + 1..line.length]
        const source = if std.text.same(line[0..space], "derived") { join3(b, wc.derived.directory, "/", path) } else { join3(b, w, "/", path) }
        _ = compileAs(b, tc, &set, source, path, if endsWith(path, ".c") { c } else { cpp })
    }
    Build.add(b, group, archive(b, tc, port, &set, "libWebCore.a"))
    return group
}

// The Mlx port's Mlx side (PORT.md): libmlxwebport.so of
// projects/webkit/port/mlx/webport.mlx, std's functions with the C ABI the
// port's C++ calls, and their header, port/MlxWebPort.h in the port's
// generated directory (on its sources' include path), made by mlx-cheaders
// of projects/webkit/port/mlx/api/MlxWebPort.mlx.
fn mlxPortLibrary(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "webkit-mlx-port", "libmlxwebport.so: the Mlx side of the Mlx port, std for its C++")
    const generated = mlxPort().generated
    const api = "projects/webkit/port/mlx/api/MlxWebPort.mlx"
    const headers = Build.command(b, "webkit-mlx-port-headers", Build.concat(b, generated, "port/MlxWebPort.h"), join3(b, "mlx-out/bin/mlx-cheaders ", generated, Build.concat(b, " ", api)))
    Build.input(b, headers, api)
    Build.input(b, headers, "mlx-out/bin/mlx-cheaders")
    Build.dependOn(b, headers, Build.step(b, "mlx-cheaders"))
    Build.add(b, group, headers)
    // (Each export's arena is mapped for its call, not --stack-arena's 64
    // KB of the caller's stack: the first font match reads std.fontconfig's
    // fonts and cache in one call, with more aggregates than that holds.)
    const library = Build.plugin(b, "libmlxwebport.so", "projects/webkit/port/mlx/webport.mlx")
    Build.option(b, library, "--soname=libmlxwebport.so")
    Build.add(b, group, library)
    return group
}

// The Mlx port's WebCore linked whole (PORT.md, M2): the program of
// projects/webkit/tests/webcore-mlx.cpp (a Page with the empty clients)
// with libWebCore.a and libPAL.a of the port, JSCOnly's JavaScriptCore,
// WTF, bmalloc and Skia (the same for the port: they do not depend on
// WebCore's configuration), on mlxlibc's loader with mlxlibcpp and the
// libraries in Mlx (mlx-out/webkit/mlx/bin/webcore-test).
// tools/check_webkit_mlx_port.sh checks that nothing it needs is left
// undefined and runs it. The same for webcore-dump (PORT.md, M3), the
// program of projects/webkit/tests/webcore-dump.cpp: a page loaded, laid
// out and its render tree printed (tools/check_webkit_mlx_layout.sh).
fn webcoreTest(b: *Build.Builder, tc: Toolchain, wc: WebCorePort) -> Build.Step {
    return webcoreProgram(b, tc, wc, "webcore-test", "webcore-mlx.cpp", "a WebCore Page of the Mlx port, linked whole")
}

fn webcoreDump(b: *Build.Builder, tc: Toolchain, wc: WebCorePort) -> Build.Step {
    return webcoreProgram(b, tc, wc, "webcore-dump", "webcore-dump.cpp", "a page loaded and laid out headless, its render tree printed")
}

// Voyager (PORT.md, M5): the engine of projects/voyager/engine.cpp (WebCore
// in the process, as webcore-dump has it) linked with libvoyager.so, its
// window on the compositor (projects/voyager/voyager.mlx: std.ui.host),
// mlx-out/webkit/mlx/bin/voyager (tools/check_voyager.sh).
fn voyager(b: *Build.Builder, tc: Toolchain, wc: WebCorePort) -> Build.Step {
    _ = Build.writeText(b, Build.concat(b, wc.port.generated, "voyager/VoyagerBuild.h"), voyagerBuildHeader(b))
    const window = Build.group(b, "voyager-window", "libvoyager.so: Voyager's window (std.ui.host) for its engine")
    const library = Build.plugin(b, "libvoyager.so", "projects/voyager/library.mlx")
    Build.option(b, library, "--soname=libvoyager.so")
    Build.add(b, window, library)
    const program = webcoreProgramOf(b, tc, wc, "voyager", "projects/voyager/", "engine.cpp", "Voyager: a page in a window on the compositor", "libvoyager.so", "voyager-window")
    return program
}

// voyager/VoyagerBuild.h of the port's generated files: what the build
// knows that Voyager's version page (voyager://version, engine.cpp) shows
// and its icon (voyager://about/icon.png): Voyager's version, MAJOR.MINOR
// of projects/voyager/VERSION and the build, the commits since that file
// last changed, with HEAD's commit, read from .git by std.git
// (docs/reference/build-system.md, "Versions and build numbers"; "dev"
// and no commit without .git), mlx-cc's code generation epoch
// (compiler/cc/epoch.mlx) and the bytes of
// projects/voyager/org.mlx.voyager.png. Written only when it changes, so
// engine.cpp is compiled again only then.
fn voyagerBuildHeader(b: *Build.Builder) -> []const u8 {
    var text = std.ArrayList(u8).init(std.heap.allocator())
    _ = text.appendSlice("/* VoyagerBuild.h: made by ./mlx build (projects/webkit/build.mlx, voyagerBuildHeader). */\n#pragma once\n#define VOYAGER_VERSION \"")
    var number: git.BuildNumber = undefined
    const status = git.buildNumberOf(".", "projects/voyager/VERSION", &number)
    _ = text.appendSlice(number.version())
    _ = text.appendSlice("\"\n#define VOYAGER_BUILD \"")
    _ = text.appendSlice(if status == git.Status.ok { decimal(b, number.build) } else { "dev" })
    _ = text.appendSlice("\"\n#define VOYAGER_GIT_COMMIT \"")
    if status == git.Status.ok {
        var hex: [40]u8 = undefined
        const digits: [*]u8 = &hex
        git.writeHex(&number.commit, digits)
        _ = text.appendSlice(digits[0..40])
    }
    _ = text.appendSlice("\"\n#define VOYAGER_CODEGEN_EPOCH \"")
    const epoch = Build.readText(b, "compiler/cc/epoch.mlx")
    const marker = "pub const CODEGEN_EPOCH: u64 = "
    var at: usize = 0
    while at + marker.length <= epoch.length {
        if std.text.same(epoch[at..at + marker.length], marker) {
            var digit = at + marker.length
            while digit < epoch.length && epoch[digit] >= 48 && epoch[digit] <= 57 {
                _ = text.append(epoch[digit])
                digit += 1
            }
            break
        }
        at += 1
    }
    _ = text.appendSlice("\"\nstatic const unsigned char voyagerIcon[] = {")
    const icon = Build.readText(b, "projects/voyager/org.mlx.voyager.png")
    const digits = "0123456789abcdef"
    var index: usize = 0
    while index < icon.length {
        if index % 24 == 0 { _ = text.appendSlice("\n    ") }
        _ = text.appendSlice("0x")
        _ = text.append(digits[@intCast(usize, icon[index]) / 16])
        _ = text.append(digits[@intCast(usize, icon[index]) % 16])
        _ = text.append(44)
        index += 1
    }
    _ = text.appendSlice("\n};\n")
    return Build.concat(b, text.items(), "")
}

// The program NAME (mlx-out/webkit/mlx/bin/NAME, the step group
// webkit-mlx-NAME) of projects/webkit/tests/SOURCE, linked whole.
fn webcoreProgram(b: *Build.Builder, tc: Toolchain, wc: WebCorePort, name: []const u8, source: []const u8, description: []const u8) -> Build.Step {
    return webcoreProgramOf(b, tc, wc, name, "projects/webkit/tests/", source, description, "", "")
}

// The same of DIRECTORY's SOURCE, also linked with the Mlx library
// mlx-out/lib/LIBRARY of the group GROUP (none: "").
fn webcoreProgramOf(b: *Build.Builder, tc: Toolchain, wc: WebCorePort, name: []const u8, directory: []const u8, source: []const u8, description: []const u8, library: []const u8, libraryGroup: []const u8) -> Build.Step {
    const port = wc.port
    const group = Build.group(b, groupName(b, port, name), description)
    const w = Build.concat(b, webkitSource(b), "/Source/WebCore")
    const root = Build.concat(b, webkitSource(b), "/Source")
    // (Compiled once WebCore is: all it generates is there.)
    var set = objects(b, port, name, Build.concat(b, port.tag, "libWebCore.a\n"))
    const compiled = compileAs(b, tc, &set, Build.concat(b, directory, source), source, webcoreCppFlags(b, wc, webcoreFlags(b, wc, root), w))
    const program = Build.concat(b, port.programs, name)
    const object = join3(b, set.directory, source, ".o")
    const lower = wc.lower
    // The archives (the linker takes from each archive the members any
    // object needs, whatever their order) and the step of each.
    // (ANGLE's, WebGL's, with the lower layers: JSCOnly's directories.)
    const archives = [8][]const u8{ "libWebCore.a", "libPAL.a", "libJavaScriptCore.a", "libWTF.a", "libbmalloc.a", "libSkia.a", "libGLESv2.a", "libANGLE.a" }
    const ours = [8]bool{ true, true, false, false, false, false, false, false }
    // The libraries in Mlx: mlx-unicode, mlx-zlib, mlx-xml2, mlx-sqlite3,
    // mlx-harfbuzz, mlx-freetype, the port's own and mlx-vulkan (ANGLE's
    // Vulkan) (its group's names).
    const shared = [8][]const u8{ "libmlxunicode.so", "libmlxz.so", "libmlxxml2.so", "libmlxsqlite3.so", "libmlxharfbuzz.so", "libmlxfreetype.so", "libmlxwebport.so", "libmlxvulkan.so" }
    const groups = [8][]const u8{ "unicode", "zlib", "xml2", "sqlite3", "harfbuzz", "freetype", "webkit-mlx-port", "vulkan" }
    const checkout = checkoutRoot(b)
    var line = join3(b, tc.cc, " -o ", program)
    line = join3(b, line, " ", object)
    var index: usize = 0
    while index < 8 {
        const library = Build.concat(b, if ours[index] { port.libraries } else { lower.libraries }, archives[index])
        line = join3(b, line, " ", library)
        index += 1
    }
    line = join3(b, line, " --dynamic-linker=", join3(b, checkout, "/", Build.concat(b, MLXLIBC_DIRECTORY, "/libmlxc.so.1")))
    index = 0
    while index < 8 {
        line = join3(b, line, " -l:", join3(b, checkout, "/mlx-out/lib/", shared[index]))
        index += 1
    }
    if library.length > 0 { line = join3(b, line, " -l:", join3(b, checkout, "/mlx-out/lib/", library)) }
    line = Build.concat(b, line, " -Lmlx-out/lib -lmlxcpp -lm")
    const step = Build.command(b, Build.concat(b, port.tag, name), program, line)
    if library.length > 0 {
        Build.input(b, step, Build.concat(b, "mlx-out/lib/", library))
        Build.dependOn(b, step, Build.step(b, libraryGroup))
    }
    Build.input(b, step, object)
    Build.dependOn(b, step, compiled)
    index = 0
    while index < 8 {
        const tag = if ours[index] { port.tag } else { lower.tag }
        Build.input(b, step, Build.concat(b, if ours[index] { port.libraries } else { lower.libraries }, archives[index]))
        Build.dependOn(b, step, Build.step(b, Build.concat(b, tag, archives[index])))
        index += 1
    }
    index = 0
    while index < 8 {
        Build.input(b, step, Build.concat(b, "mlx-out/lib/", shared[index]))
        Build.dependOn(b, step, Build.step(b, groups[index]))
        index += 1
    }
    Build.dependOn(b, step, Build.step(b, "libc"))
    Build.dependOn(b, step, tc.library)
    Build.input(b, step, tc.ld)
    Build.dependOn(b, step, tc.linker)
    Build.add(b, group, step)
    return group
}

pub fn webkit(b: *Build.Builder, tc: Toolchain) -> Build.Step {
    const group = Build.group(b, "webkit", "WPE WebKit and its libraries, by mlx-cc (projects/webkit)")
    declareGenerators(b)
    const jscOnly = jscOnlyPort()
    Build.add(b, group, bmalloc(b, tc, jscOnly))
    Build.add(b, group, wtf(b, tc, jscOnly))
    Build.add(b, group, jscDerived(b, tc, jscOnly))
    Build.add(b, group, webcore.webcoreDerived(b, webcore.wpe(), Build.concat(b, webkitSource(b), "/Source"), true))
    Build.add(b, group, javaScriptCore(b, tc, jscOnly))
    Build.add(b, group, jscShell(b, tc, jscOnly))
    Build.add(b, group, wtfRunLoopTest(b, tc, jscOnly))
    Build.add(b, group, angle(b, tc, jscOnly))
    Build.add(b, group, skia(b, tc, jscOnly))
    // The WPE port's lower layers.
    const wpe = wpePort()
    Build.add(b, group, bmalloc(b, tc, wpe))
    Build.add(b, group, wtf(b, tc, wpe))
    Build.add(b, group, jscDerived(b, tc, wpe))
    Build.add(b, group, javaScriptCore(b, tc, wpe))
    Build.add(b, group, jscShell(b, tc, wpe))
    Build.add(b, group, wtfTest(b, tc, wpe))
    Build.add(b, group, jscGLibTest(b, tc, wpe))
    // WebCore, declared but not yet part of the whole: not all of its
    // sources compile yet (WEBCORE.md).
    _ = webCore(b, tc, wpeWebCore())
    // The Mlx port (PORT.md), on JSCOnly's lower layers: what its WebCore
    // build generates, PAL, WebCore, the port's Mlx side and the program
    // that links them; not yet part of the whole either.
    const mlx = mlxWebCore()
    _ = webcore.webcoreDerived(b, mlx.derived, Build.concat(b, webkitSource(b), "/Source"), false)
    _ = mlxPortLibrary(b)
    _ = pal(b, tc, mlx)
    _ = webCore(b, tc, mlx)
    _ = webcoreTest(b, tc, mlx)
    _ = webcoreDump(b, tc, mlx)
    _ = voyager(b, tc, mlx)
    return group
}
