// The built-in character classes of JavaScriptCore's regular expressions
// (yarr/RegExpJitTables.h), made as WebKit's yarr/create_regex_tables
// (Python) makes them, from the classes that script holds:
//
//     webkit-regex-tables [--no-tables] OUTPUT
//
// Each class is a list of characters and ranges (split where they cross
// from Latin-1 to beyond, then sorted); a function creates it, and the
// classes marked for it also get a table of 65536 flags, one per 16-bit
// character, which their inverse classes share. --no-tables leaves the
// tables out.
const std = @import("std")
const s = @import("./support.mlx")
const u = @import("./ucdsupport.mlx")

const ENTRIES_PER_LINE: u64 = 50
const TABLE_SIZE: u64 = 65536
const MAX_RANGES: usize = 64

// The ranges of the class being made.
var lows: [*]u64 = undefined
var highs: [*]u64 = undefined
var rangeCount: usize = 0

fn add(low: u64, high: u64) -> void {
    if rangeCount + 2 > MAX_RANGES { s.fail("create_regex_tables: too many ranges") }
    var from = low
    if high > 255 && from <= 255 {
        lows[rangeCount] = from
        highs[rangeCount] = 255
        rangeCount += 1
        from = 256
    }
    lows[rangeCount] = from
    highs[rangeCount] = high
    rangeCount += 1
}

fn one(character: u64) -> void {
    lows[rangeCount] = character
    highs[rangeCount] = character
    rangeCount += 1
}

// The classes, in the order of the script's dictionary.
const CLASS_COUNT: usize = 9

fn className(which: usize) -> []const u8 {
    if which == 0 { return "wordchar" }
    if which == 1 { return "wordUnicodeIgnoreCaseChar" }
    if which == 2 { return "nonwordchar" }
    if which == 3 { return "nonwordUnicodeIgnoreCaseChar" }
    if which == 4 { return "newline" }
    if which == 5 { return "spaces" }
    if which == 6 { return "nonspaces" }
    if which == 7 { return "digits" }
    return "nondigits"
}

fn usesTable(which: usize) -> bool { return which == 0 || which == 2 || which == 5 || which == 6 }

// The class whose table an inverse class shares, or "" when not one.
fn inverseOf(which: usize) -> []const u8 {
    if which == 2 { return "wordchar" }
    if which == 3 { return "wordUnicodeIgnoreCaseChar" }
    if which == 6 { return "spaces" }
    if which == 8 { return "digits" }
    return ""
}

fn classData(which: usize) -> void {
    if which == 0 {
        one('_')
        add('0', '9')
        add('A', 'Z')
        add('a', 'z')
    } else if which == 1 {
        one('_')
        add('0', '9')
        add('A', 'Z')
        add('a', 'z')
        one(383)
        one(8490)
    } else if which == 2 {
        one('`')
        add(0, '0' - 1)
        add('9' + 1, 'A' - 1)
        add('Z' + 1, '_' - 1)
        add('z' + 1, 1114111)
    } else if which == 3 {
        one('`')
        add(0, '0' - 1)
        add('9' + 1, 'A' - 1)
        add('Z' + 1, '_' - 1)
        add('z' + 1, 382)
        add(384, 8489)
        add(8491, 1114111)
    } else if which == 4 {
        one('\n')
        one('\r')
        add(8232, 8233)
    } else if which == 5 {
        one(' ')
        add('\t', '\r')
        one(160)
        one(5760)
        one(8239)
        one(8287)
        one(12288)
        add(8192, 8202)
        add(8232, 8233)
        one(65279)
    } else if which == 6 {
        add(0, '\t' - 1)
        add('\r' + 1, ' ' - 1)
        add(' ' + 1, 159)
        add(161, 5759)
        add(5761, 8191)
        add(8203, 8231)
        add(8234, 8238)
        add(8240, 8286)
        add(8288, 12287)
        add(12289, 65278)
        add(65280, 1114111)
    } else if which == 7 {
        add('0', '9')
    } else {
        add(0, '0' - 1)
        add('9' + 1, 1114111)
    }
}

// Python's sort of (low, high) pairs.
fn sortRanges() -> void {
    var index: usize = 1
    while index < rangeCount {
        const low = lows[index]
        const high = highs[index]
        var at = index
        while at > 0 && (lows[at - 1] > low || (lows[at - 1] == low && highs[at - 1] > high)) {
            lows[at] = lows[at - 1]
            highs[at] = highs[at - 1]
            at -= 1
        }
        lows[at] = low
        highs[at] = high
        index += 1
    }
}

// The script's table loop, kept as it is (a last entry without a comma).
fn table(name: []const u8) -> void {
    s.out("static constinit const char _")
    s.out(name)
    s.out("Data[CharacterClass::tableSize] = {\n")
    var i: u64 = 0
    var index: usize = 0
    while index < rangeCount {
        while i < lows[index] {
            i += 1
            s.out("0,")
            if i % ENTRIES_PER_LINE == 0 { s.out("\n") }
        }
        while i <= highs[index] {
            i += 1
            s.out(if i == TABLE_SIZE { "1" } else { "1," })
            if i % ENTRIES_PER_LINE == 0 { s.out("\n") }
        }
        index += 1
    }
    while i < 65535 {
        s.out("0,")
        i += 1
        if i % ENTRIES_PER_LINE == 0 { s.out("\n") }
    }
    if i == 65535 { s.out("0") }
    s.out("\n};\n\n")
}

fn function(which: usize, emitTables: bool, functions: *[]const u8) -> void {
    const name = className(which)
    var text = s.join3("std::unique_ptr<CharacterClass> ", name, "Create()\n{\n")
    const inverse = inverseOf(which)
    if emitTables && usesTable(which) {
        if inverse.length > 0 {
            text = s.join(text, s.join3("    auto characterClass = makeUnique<CharacterClass>(_", inverse, "Data, true);\n"))
        } else {
            text = s.join(text, s.join3("    auto characterClass = makeUnique<CharacterClass>(_", name, "Data, false);\n"))
        }
    } else {
        text = s.join(text, "    auto characterClass = makeUnique<CharacterClass>();\n")
    }
    var hasBMP = false
    var hasNonBMP = false
    var index: usize = 0
    while index < rangeCount {
        const low = lows[index]
        const high = highs[index]
        index += 1
        if low < 65536 { hasBMP = true }
        if high >= 65536 { hasNonBMP = true }
        if low == high {
            if low > 255 {
                text = s.join(text, s.join3("    characterClass->m_matches32.append(0x", u.hex(low, 4, false), ");\n"))
            } else {
                text = s.join(text, s.join3("    characterClass->m_matches8.append(0x", u.hex(low, 2, false), ");\n"))
            }
            continue
        }
        const wide = low > 255 || high > 255
        text = s.join(text, if wide { "    characterClass->m_ranges32.append(CharacterRange(0x" } else { "    characterClass->m_ranges8.append(CharacterRange(0x" })
        text = s.join(text, s.join3(u.hex(low, if wide { 4 } else { 2 }, false), ", 0x", u.hex(high, if wide { 4 } else { 2 }, false)))
        text = s.join(text, "));\n")
    }
    const widths = if hasNonBMP && hasBMP { "HasBothBMPAndNonBMP" } else if hasNonBMP { "HasNonBMPChars" } else if hasBMP { "HasBMPChars" } else { "Unknown" }
    text = s.join(text, s.join3("    characterClass->m_characterWidths = CharacterClassWidths::", widths, ";\n"))
    text = s.join(text, "    return characterClass;\n}\n\n")
    functions.* = s.join(functions.*, text)
}

fn generate(emitTables: bool, outputPath: []const u8) -> void {
    unsafe {
        lows = @ptrFromInt([*]u64, s.alloc(MAX_RANGES * 8))
        highs = @ptrFromInt([*]u64, s.alloc(MAX_RANGES * 8))
    }
    // The tables come first, all of them, then the functions.
    var functions: []const u8 = ""
    var which: usize = 0
    while which < CLASS_COUNT {
        rangeCount = 0
        classData(which)
        sortRanges()
        if emitTables && usesTable(which) && inverseOf(which).length == 0 { table(className(which)) }
        function(which, emitTables, &functions)
        which += 1
    }
    s.out(functions)
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length == 2 {
        generate(true, s.cString(arguments[1]))
        return 0
    }
    if arguments.length == 3 && std.text.same(s.cString(arguments[1]), "--no-tables") {
        generate(false, s.cString(arguments[2]))
        return 0
    }
    s.say("usage: webkit-regex-tables [--no-tables] OUTPUT\n")
    return 2
}
