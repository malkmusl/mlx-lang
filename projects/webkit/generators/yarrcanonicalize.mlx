// The case-insensitive canonicalization tables of JavaScriptCore's
// regular expressions in Unicode mode (yarr/YarrCanonicalizeUnicode.cpp),
// made as WebKit's yarr/generateYarrCanonicalizeUnicode (Python) makes
// them, from the common and simple foldings of CaseFolding.txt:
//
//     webkit-yarr-canonicalize CASE_FOLDING OUTPUT
//
// The characters folding to one character make a group (a character not
// folded is its own fold). A group of one is unique, of two either an
// alternating pair or a pair some distance apart, of more a set, listed
// on its own. The table is the runs of characters of one kind, over all
// of Unicode.
const std = @import("std")
const s = @import("./support.mlx")
const u = @import("./ucdsupport.mlx")

const HEADER = "/*\n* Copyright (C) 2016 Apple Inc. All rights reserved.\n*\n* Redistribution and use in source and binary forms, with or without\n* modification, are permitted provided that the following conditions\n* are met:\n*\n* 1.  Redistributions of source code must retain the above copyright\n*     notice, this list of conditions and the following disclaimer. \n* 2.  Redistributions in binary form must reproduce the above copyright\n*     notice, this list of conditions and the following disclaimer in the\n*     documentation and/or other materials provided with the distribution. \n*\n* THIS SOFTWARE IS PROVIDED BY APPLE AND ITS CONTRIBUTORS \"AS IS\" AND ANY\n* EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL APPLE OR ITS CONTRIBUTORS BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF\n* THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n// DO NO EDIT! - This file was generated by generateYarrCanonicalizeUnicode\n\n#include \"config.h\"\n#include \"YarrCanonicalize.h\"\n\nnamespace JSC { namespace Yarr {\n\n"

const FOOTER = "} } // JSC::Yarr\n"

const MAX_UNICODE: usize = 1114111
const CODES: usize = 1114112
// Room for the foldings of the file, past one pair for each character.
const MAX_PAIRS: usize = 1114112 + 65536

// The kinds of character, as the table names them.
const NONE: u8 = 0
const UNIQUE: u8 = 1
const SET: u8 = 2
const ALTERNATING_UNALIGNED: u8 = 3
const ALTERNATING_ALIGNED: u8 = 4
const RANGE_LO: u8 = 5
const RANGE_HI: u8 = 6

fn kindName(kind: u8) -> []const u8 {
    if kind == UNIQUE { return "CanonicalizeUnique" }
    if kind == SET { return "CanonicalizeSet" }
    if kind == ALTERNATING_UNALIGNED { return "CanonicalizeAlternatingUnaligned" }
    if kind == ALTERNATING_ALIGNED { return "CanonicalizeAlternatingAligned" }
    if kind == RANGE_LO { return "CanonicalizeRangeLo" }
    return "CanonicalizeRangeHi"
}

// The (character, fold) pairs: the file's, then every character the file
// does not fold, folding to itself.
var pairCodes: [*]u32 = undefined
var pairMappings: [*]u32 = undefined
var pairCount: usize = 0

fn addMapping(code: u64, mapping: u64) -> void {
    if pairCount == MAX_PAIRS || code > 1114111 || mapping > 1114111 { s.fail("generateYarrCanonicalizeUnicode: bad folding") }
    pairCodes[pairCount] = @intCast(u32, code)
    pairMappings[pairCount] = @intCast(u32, mapping)
    pairCount += 1
}

// A run of hexadecimal digits of LINE from AT on; AT moves past it.
fn hexRun(line: []const u8, at: *usize) -> usize {
    const start = at.*
    while at.* < line.length && u.isHexDigit(line[at.*]) { at.* += 1 }
    return at.* - start
}

fn skipSpace(line: []const u8, at: *usize) -> void {
    while at.* < line.length && s.isSpace(line[at.*]) { at.* += 1 }
}

// Reads "CODE; C|S; MAPPING" at the start of LINE, as the script's
// regular expression does (any case).
fn readFolding(line: []const u8, seen: [*]bool) -> void {
    var at: usize = 0
    if hexRun(line, &at) == 0 { return }
    const code = line[0..at]
    skipSpace(line, &at)
    if at == line.length || line[at] != 59 { return }
    at += 1
    skipSpace(line, &at)
    if at == line.length { return }
    const status = line[at]
    if status != 67 && status != 83 && status != 99 && status != 115 { return }
    at += 1
    skipSpace(line, &at)
    if at == line.length || line[at] != 59 { return }
    at += 1
    skipSpace(line, &at)
    const start = at
    if hexRun(line, &at) == 0 { return }
    const value = u.parseHex(code)
    addMapping(value, u.parseHex(line[start..at]))
    seen[value] = true
}

fn generate(foldingPath: []const u8, outputPath: []const u8) -> void {
    var seen: [*]bool = undefined
    var kinds: [*]u8 = undefined
    var values: [*]u32 = undefined
    var starts: [*]u32 = undefined
    var groups: [*]u32 = undefined
    unsafe {
        pairCodes = @ptrFromInt([*]u32, s.alloc(MAX_PAIRS * 4))
        pairMappings = @ptrFromInt([*]u32, s.alloc(MAX_PAIRS * 4))
        seen = @ptrFromInt([*]bool, s.alloc(CODES))
        kinds = @ptrFromInt([*]u8, s.alloc(CODES))
        values = @ptrFromInt([*]u32, s.alloc(CODES * 4))
        starts = @ptrFromInt([*]u32, s.alloc((CODES + 1) * 4))
        groups = @ptrFromInt([*]u32, s.alloc(MAX_PAIRS * 4))
    }
    var code: usize = 0
    while code < CODES {
        seen[code] = false
        kinds[code] = NONE
        values[code] = 0
        code += 1
    }
    const text = s.readWhole(foldingPath)
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length > 0 { readFolding(line, seen) }
    }
    code = 0
    while code < CODES {
        if !seen[code] { addMapping(@intCast(u64, code), @intCast(u64, code)) }
        code += 1
    }

    // The groups, by fold: where each begins in GROUPS, then filled.
    code = 0
    while code <= CODES {
        starts[code] = 0
        code += 1
    }
    var index: usize = 0
    while index < pairCount {
        starts[pairMappings[index] + 1] += 1
        index += 1
    }
    code = 0
    while code < CODES {
        starts[code + 1] += starts[code]
        code += 1
    }
    var filled: [*]u32 = undefined
    unsafe { filled = @ptrFromInt([*]u32, s.alloc(CODES * 4)) }
    code = 0
    while code < CODES {
        filled[code] = starts[code]
        code += 1
    }
    index = 0
    while index < pairCount {
        const mapping = pairMappings[index]
        groups[filled[mapping]] = pairCodes[index]
        filled[mapping] += 1
        index += 1
    }

    // The kinds of the characters, the groups taken by fold in order.
    var setCount: u32 = 0
    var setBegins: [*]u32 = undefined
    var setEnds: [*]u32 = undefined
    unsafe {
        setBegins = @ptrFromInt([*]u32, s.alloc(CODES * 4))
        setEnds = @ptrFromInt([*]u32, s.alloc(CODES * 4))
    }
    var mapping: usize = 0
    while mapping < CODES {
        const begin = @intCast(usize, starts[mapping])
        const end = @intCast(usize, starts[mapping + 1])
        mapping += 1
        if end == begin { continue }
        if end - begin == 1 {
            kinds[groups[begin]] = UNIQUE
            values[groups[begin]] = 0
            continue
        }
        // Sorted (a few characters each).
        var i = begin + 1
        while i < end {
            const moving = groups[i]
            var j = i
            while j > begin && groups[j - 1] > moving {
                groups[j] = groups[j - 1]
                j -= 1
            }
            groups[j] = moving
            i += 1
        }
        if end - begin > 2 {
            i = begin
            while i < end {
                kinds[groups[i]] = SET
                values[groups[i]] = setCount
                i += 1
            }
            setBegins[setCount] = @intCast(u32, begin)
            setEnds[setCount] = @intCast(u32, end)
            setCount += 1
        } else {
            const low = groups[begin]
            const high = groups[begin + 1]
            const delta = high - low
            if delta == 1 {
                const kind = if (low & 1) != 0 { ALTERNATING_UNALIGNED } else { ALTERNATING_ALIGNED }
                kinds[low] = kind
                values[low] = 0
                kinds[high] = kind
                values[high] = 0
            } else {
                kinds[low] = RANGE_LO
                values[low] = delta
                kinds[high] = RANGE_HI
                values[high] = delta
            }
        }
    }

    s.out(HEADER)
    var set: u32 = 0
    while set < setCount {
        s.out("constexpr char32_t unicodeCharacterSet")
        s.outUnsigned(@intCast(u64, set))
        s.out("[] = { ")
        var i = @intCast(usize, setBegins[set])
        while i < @intCast(usize, setEnds[set]) {
            s.out("0x")
            u.outHex(@intCast(u64, groups[i]), 4, false)
            s.out(", ")
            i += 1
        }
        s.out("0 };\n")
        set += 1
    }
    s.out("\n")
    s.out("constexpr size_t UNICODE_CANONICALIZATION_SETS = ")
    s.outUnsigned(@intCast(u64, setCount))
    s.out(";\n")
    s.out("constexpr const char32_t* unicodeCharacterSetInfo[UNICODE_CANONICALIZATION_SETS] = {\n")
    set = 0
    while set < setCount {
        s.out("    unicodeCharacterSet")
        s.outUnsigned(@intCast(u64, set))
        s.out(",\n")
        set += 1
    }
    s.out("};\n")
    s.out("\n")

    // The runs of one kind and value.
    var runCount: u64 = 0
    var runs: [*]u32 = undefined
    unsafe { runs = @ptrFromInt([*]u32, s.alloc(CODES * 8)) }
    var end: usize = 0
    while end <= MAX_UNICODE {
        const begin = end
        while end < MAX_UNICODE && kinds[end + 1] == kinds[begin] && values[end + 1] == values[begin] { end += 1 }
        if kinds[begin] == NONE { s.fail("generateYarrCanonicalizeUnicode: a character without a kind") }
        runs[runCount * 2] = @intCast(u32, begin)
        runs[runCount * 2 + 1] = @intCast(u32, end)
        runCount += 1
        end += 1
    }
    s.out("constexpr size_t UNICODE_CANONICALIZATION_RANGES = ")
    s.outUnsigned(runCount)
    s.out(";\n")
    s.out("constexpr CanonicalizationRange unicodeRangeInfo[UNICODE_CANONICALIZATION_RANGES] = {\n")
    var run: u64 = 0
    while run < runCount {
        const begin = @intCast(u64, runs[run * 2])
        s.out("    { 0x")
        u.outHex(begin, 4, false)
        s.out(", 0x")
        u.outHex(@intCast(u64, runs[run * 2 + 1]), 4, false)
        s.out(", 0x")
        u.outHex(@intCast(u64, values[begin]), 4, false)
        s.out(", ")
        s.out(kindName(kinds[begin]))
        s.out(" },\n")
        run += 1
    }
    s.out("};\n")
    s.out("\n")
    s.out(FOOTER)
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-yarr-canonicalize CASE_FOLDING OUTPUT\n")
        return 2
    }
    generate(std.text.cString(arguments[1]), std.text.cString(arguments[2]))
    return 0
}
