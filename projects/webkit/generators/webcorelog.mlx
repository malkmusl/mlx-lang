// The log message declarations of WebCore and WebKit, as
// Source/WebCore/Scripts/generate-log-declarations.py makes them from a
// LogMessages.in:
//
//     webkit-log-declarations LogMessages.in DECLARATIONS.h [VIRTUAL_FUNCTIONS.h]
//
// Each line of the input that is not a comment (#) or empty is a message:
// "Identifier, format string, (parameter types), log type, category",
// read with the script's regular expression (or the run fails). The
// declarations file defines for each message MESSAGE_<identifier>, its
// format, and MESSAGE_WITHOUT_PUBLIC_STRING_MODIFIER_<identifier>, the
// format with %" PUBLIC_LOG_STRING " made %s. The virtual functions file
// (WebCore's) declares the class LogClient with an empty virtual function
// per message, taking the message's parameter types.
const std = @import("std")
const s = @import("./support.mlx")
const re = @import("./pyregex.mlx")

// The script's pattern, its named groups numbered: 1 the identifier,
// 2 the format string, 8 the parameter list.
const MESSAGE_PATTERN = "([A-Z_a-z0-9]*)\\s*,\\s*((((\\\"[\\w:;%~\\'\\-\\[\\]=,\\.\\(\\)\\{\\} ]*\\\")\\s*(PRI[A-Za-z0-9]+|PUBLIC_LOG_STRING|PRIVATE_LOG_STRING)?)(\\s*))+)\\s*,\\s*\\((.*)\\)\\s*,\\s*(DEFAULT|INFO|ERROR|FAULT)\\s*,\\s*([\\w]*)"

const VIRTUAL_FUNCTIONS_HEAD = "\n/* Copyright (C) 2024 Apple Inc. All rights reserved.\n *\n * Redistribution and use in source and binary forms, with or without\n * modification, are permitted provided that the following conditions\n * are met:\n * 1.  Redistributions of source code must retain the above copyright\n *     notice, this list of conditions and the following disclaimer.\n * 2.  Redistributions in binary form must reproduce the above copyright\n *     notice, this list of conditions and the following disclaimer in the\n *     documentation and/or other materials provided with the distribution.\n *\n * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS'' AND\n * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n * WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n * DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS BE LIABLE FOR\n * ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL\n * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR\n * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER\n * CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,\n * OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n */\n\n#pragma once\n\n#include <os/log.h>\n#include <wtf/ThreadSafeRefCounted.h>\n\nnamespace WebCore {\n\nclass LogClient {\n    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(LogClient);\npublic:\n    LogClient() = default;\n    virtual ~LogClient() { }\n\n    virtual void log(std::span<const uint8_t> logChannel, std::span<const uint8_t> logCategory, std::span<const uint8_t> logString, os_log_type_t) = 0;\n    virtual bool isWebKitLogClient() const { return false; }\n\n"

const VIRTUAL_FUNCTIONS_TAIL = "\n    };\n\nWEBCORE_EXPORT std::unique_ptr<LogClient>& logClient();\n\n}\n\n"

const MAX_MESSAGES: usize = 65536

var names: [*][]const u8 = undefined
var formats: [*][]const u8 = undefined
var parameterLists: [*][]const u8 = undefined
var messageCount: usize = 0

fn readMessages(path: []const u8) -> void {
    const pattern = re.compile(MESSAGE_PATTERN, 0)
    const text = s.readWhole(path)
    var at: usize = 0
    while at < text.length {
        // A line with its newline, as Python's readlines gives it.
        const start = at
        while at < text.length && text[at] != 10 { at += 1 }
        if at < text.length { at += 1 }
        const line = text[start..at]
        const m = re.search(pattern, line, 0)
        if m.found {
            if messageCount == MAX_MESSAGES { s.fail("webkit-log-declarations: too many messages") }
            names[messageCount] = re.group(m, line, 1)
            formats[messageCount] = re.group(m, line, 2)
            parameterLists[messageCount] = re.group(m, line, 8)
            messageCount += 1
        } else if line[0] != 35 && line[0] != 10 {
            const ignored = std.io.writeAll(std.io.stdout(), s.join3("Unable to match log message ", line, "\n"))
            const exited = std.linux.syscall1(231, 1)
        }
    }
}

// The parameter types of a message (the words of its list), ", "
// between them, a CString taken as CString&&.
fn parameterTypes(list: []const u8) -> []const u8 {
    var result: []const u8 = ""
    var first = true
    var at: usize = 0
    while at < list.length {
        if !re.isWord(list[at]) {
            at += 1
            continue
        }
        const start = at
        while at < list.length && re.isWord(list[at]) { at += 1 }
        var word = list[start..at]
        if s.same(word, "CString") { word = "CString&&" }
        if !first { result = s.join(result, ", ") }
        first = false
        result = s.join(result, word)
    }
    return result
}

fn declarations() -> void {
    s.out("#pragma once\n\n")
    var index: usize = 0
    while index < messageCount {
        s.out("#define MESSAGE_")
        s.out(names[index])
        s.out(" ")
        s.out(formats[index])
        s.out("\n#define MESSAGE_WITHOUT_PUBLIC_STRING_MODIFIER_")
        s.out(names[index])
        s.out(" ")
        s.out(re.replaceAll(formats[index], "%\" PUBLIC_LOG_STRING \"", "%s"))
        s.out("\n")
        index += 1
    }
}

fn virtualFunctions() -> void {
    s.out(VIRTUAL_FUNCTIONS_HEAD)
    var index: usize = 0
    while index < messageCount {
        s.out("    virtual void ")
        s.out(names[index])
        s.out("(")
        s.out(parameterTypes(parameterLists[index]))
        s.out(") { }\n")
        index += 1
    }
    s.out(VIRTUAL_FUNCTIONS_TAIL)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 3 {
        s.say("usage: webkit-log-declarations LogMessages.in DECLARATIONS.h [VIRTUAL_FUNCTIONS.h]\n")
        return 1
    }
    unsafe {
        names = @ptrFromInt([*][]const u8, s.alloc(MAX_MESSAGES * 16))
        formats = @ptrFromInt([*][]const u8, s.alloc(MAX_MESSAGES * 16))
        parameterLists = @ptrFromInt([*][]const u8, s.alloc(MAX_MESSAGES * 16))
    }
    readMessages(s.cString(arguments[1]))
    declarations()
    s.writeOutput(s.cString(arguments[2]))
    if arguments.length > 3 {
        const from = s.output().length
        virtualFunctions()
        const all = s.output()
        s.writeWhole(s.cString(arguments[3]), all[from..all.length])
    }
    return 0
}
