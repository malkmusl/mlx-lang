// The inspector protocol as WebKit's generate-inspector-protocol-bindings.py
// models it (its codegen/models.py), with what its generators share
// (codegen/generator.py and cpp_generator.py): the frameworks and their
// settings, the domains read from the specification files, their types
// resolved, the numbers given to enum values, the types needing shape
// assertions, and the names the generated C++ and JavaScript use for all
// of them.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const json = @import("./inspectorjsonvalue.mlx")

// ---------------------------------------------------------------------------
// Frameworks.

pub const Framework = struct {
    name: []const u8
    cppProtocolGroup: []const u8
    // "" when the framework has none.
    exportMacro: []const u8
    alternateDispatchers: bool
    legacyAsyncCallbacks: bool
    enumInvalidValueErrorCode: []const u8
}

pub fn isFrameworkName(name: []const u8) -> bool {
    return std.text.same(name, "JavaScriptCore") || std.text.same(name, "WebInspector") || std.text.same(name, "WebInspectorUI") || std.text.same(name, "WebKit") || std.text.same(name, "WebDriverBidi") || std.text.same(name, "Test")
}

pub fn framework(name: []const u8) -> Framework {
    var f = Framework.{ .name = name, .cppProtocolGroup = "", .exportMacro = "", .alternateDispatchers = false, .legacyAsyncCallbacks = false, .enumInvalidValueErrorCode = "ServerError" }
    if std.text.same(name, "JavaScriptCore") {
        f.cppProtocolGroup = "Inspector"
        f.exportMacro = "JS_EXPORT_PRIVATE"
        f.alternateDispatchers = true
        f.legacyAsyncCallbacks = true
    } else if std.text.same(name, "WebKit") {
        f.cppProtocolGroup = "Automation"
    } else if std.text.same(name, "WebDriverBidi") {
        f.cppProtocolGroup = "WebDriverBidi"
        f.enumInvalidValueErrorCode = "InvalidParams"
    } else if std.text.same(name, "Test") {
        f.alternateDispatchers = true
        f.cppProtocolGroup = "Test"
        f.enumInvalidValueErrorCode = "InvalidParams"
    } else if !std.text.same(name, "WebInspector") && !std.text.same(name, "WebInspectorUI") && !std.text.same(name, "Global") {
        s.fail(s.join("Unknown framework: ", name))
    }
    return f
}

// ---------------------------------------------------------------------------
// The model.

// A type as a specification writes it: a primitive "type", a "$ref", the
// values of an "enum", the "items" of an array ("" or none for those absent).
pub const TypeRef = struct {
    kind: []const u8
    ref: []const u8
    values: t.List
    hasValues: bool
    items: ?*TypeRef
}

pub const PRIMITIVE: u8 = 0
pub const ALIASED: u8 = 1
pub const ENUM: u8 = 2
pub const ARRAY: u8 = 3
pub const OBJECT: u8 = 4

pub const Type = struct {
    kind: u8
    // Its raw name: "(anonymous)" for an anonymous enum, "" (None) for an
    // anonymous array.
    name: []const u8
    domain: *Domain
    declaration: ?*Declaration
    // What an alias, an array's elements or an enum's values are.
    ref: ?*TypeRef
    resolved: ?*Type
    values: t.List
    anonymous: bool
}

// A property of an object type, a parameter of a command or an event.
pub const Member = struct {
    name: []const u8
    ref: *TypeRef
    optional: bool
    nullable: bool
    description: []const u8
    ty: *Type
}

pub const Declaration = struct {
    name: []const u8
    ref: *TypeRef
    description: []const u8
    condition: []const u8
    members: [*]Member
    memberCount: usize
    ty: *Type
}

pub const Command = struct {
    name: []const u8
    // json.dumps of its "targetTypes" ("null" when it has none).
    targetTypes: []const u8
    parameters: [*]Member
    parameterCount: usize
    returns: [*]Member
    returnCount: usize
    description: []const u8
    condition: []const u8
    async: bool
}

pub const Event = struct {
    name: []const u8
    targetTypes: []const u8
    parameters: [*]Member
    parameterCount: usize
    description: []const u8
    condition: []const u8
}

pub const Domain = struct {
    name: []const u8
    exposedAs: []const u8
    description: []const u8
    condition: []const u8
    // json.dumps of its "debuggableTypes" and "targetTypes".
    debuggableTypes: []const u8
    targetTypes: []const u8
    supplemental: bool
    hasVersion: bool
    version: i64
    declarations: [*]Declaration
    declarationCount: usize
    commands: [*]Command
    commandCount: usize
    events: [*]Event
    eventCount: usize
}

pub const Protocol = struct {
    framework: Framework
    domains: [*]*Domain
    domainCount: usize
    domainCapacity: usize
    conditionFlags: []const u8
    // The named types, by qualified name.
    typeNames: t.List
    types: [*]*Type
    typeCapacity: usize
    globalDomain: *Domain
    // What the generators share, worked out once: the enum values in the
    // order they are numbered, the qualified names of the types needing
    // shape assertions.
    enumValues: t.List
    enumValuesKnown: bool
    shapeTypes: t.List
    shapeTypesKnown: bool
    // The specification the generated files say they come from.
    inputFilename: []const u8
}

fn newDomain(name: []const u8) -> *Domain {
    const domain: *Domain = unsafe { @ptrFromInt(*Domain, s.alloc(@sizeOf(Domain))) }
    domain.*.name = name
    domain.*.exposedAs = name
    domain.*.description = ""
    domain.*.condition = ""
    domain.*.debuggableTypes = "null"
    domain.*.targetTypes = "null"
    domain.*.supplemental = false
    domain.*.hasVersion = false
    domain.*.version = 0
    domain.*.declarationCount = 0
    domain.*.commandCount = 0
    domain.*.eventCount = 0
    return domain
}

pub fn newProtocol(frameworkName: []const u8) -> *Protocol {
    const p: *Protocol = unsafe { @ptrFromInt(*Protocol, s.alloc(@sizeOf(Protocol))) }
    p.*.framework = framework(frameworkName)
    p.*.domainCapacity = 256
    p.*.domains = unsafe { @ptrFromInt([*]*Domain, s.alloc(256 * 8)) }
    p.*.domainCount = 0
    p.*.conditionFlags = ""
    p.*.typeNames = t.list()
    p.*.typeCapacity = 65536
    p.*.types = unsafe { @ptrFromInt([*]*Type, s.alloc(65536 * 8)) }
    const global = newDomain("")
    global.*.description = "The global domain, in which primitive types are implicitly declared."
    p.*.globalDomain = global
    p.*.enumValues = t.list()
    p.*.enumValuesKnown = false
    p.*.shapeTypes = t.list()
    p.*.shapeTypesKnown = false
    p.*.inputFilename = ""
    return p
}

// ---------------------------------------------------------------------------
// Reading a specification.

fn parseFail(message: []const u8) -> void { s.fail(s.join("ParseException: ", message)) }
fn typecheckFail(message: []const u8) -> void { s.fail(s.join("TypecheckException: ", message)) }

fn requireProperty(object: *json.Value, property: []const u8, what: []const u8) -> void {
    if !json.has(object, property) { parseFail(t.c4("When parsing ", what, ", required property missing: ", property)) }
}

fn isArray(value: ?*json.Value) -> bool { return value != null && value.?.*.kind == json.ARRAY }

fn stringList(value: ?*json.Value) -> t.List {
    var result = t.list()
    if !isArray(value) { return result }
    const array = value.?
    var index: usize = 0
    while index < array.*.count {
        t.push(&result, array.*.items[index].*.text)
        index += 1
    }
    return result
}

const PRIMITIVE_KINDS = "integer number string boolean enum object array any"
const DEBUGGABLE_TYPES = "itml javascript service-worker web-page wasm-debugger"
const TARGET_TYPES = "itml javascript page service-worker web-page wasm-debugger frame worker"

// Whether WORD is one of the space-separated WORDS.
pub fn wordIn(words: []const u8, word: []const u8) -> bool {
    var start: usize = 0
    var index: usize = 0
    while index <= words.length {
        if index == words.length || words[index] == 32 {
            if std.text.same(words[start..index], word) { return true }
            start = index + 1
        }
        index += 1
    }
    return false
}

fn newTypeRef(kind: []const u8, ref: []const u8, values: ?*json.Value, items: ?*json.Value) -> *TypeRef {
    const r: *TypeRef = unsafe { @ptrFromInt(*TypeRef, s.alloc(@sizeOf(TypeRef))) }
    r.*.kind = kind
    r.*.ref = ref
    r.*.hasValues = values != null && values.?.*.kind != json.NULL
    r.*.values = stringList(values)
    r.*.items = null
    if items != null && items.?.*.kind != json.NULL {
        const i = items.?
        r.*.items = newTypeRef(json.stringAt(i, "type", ""), json.stringAt(i, "$ref", ""), json.get(i, "enum"), json.get(i, "items"))
    }
    if kind.length > 0 && ref.length > 0 { parseFail("Type reference cannot have both 'type' and '$ref' keys.") }
    if kind.length > 0 && !wordIn(PRIMITIVE_KINDS, kind) {
        parseFail(t.c3("Type reference '", kind, "' is not a primitive type. Allowed values: integer, number, string, boolean, enum, object, array, any"))
    }
    if std.text.same(kind, "array") && r.*.items == null { parseFail("Type reference with type 'array' must have key 'items' to define array element type.") }
    if r.*.hasValues && r.*.values.count == 0 { parseFail("Type reference with enum values must have at least one enum value.") }
    return r
}

fn refOf(object: *json.Value) -> *TypeRef {
    return newTypeRef(json.stringAt(object, "type", ""), json.stringAt(object, "$ref", ""), json.get(object, "enum"), json.get(object, "items"))
}

fn checkOptional(object: *json.Value, what: []const u8) -> bool {
    const value = json.get(object, "optional")
    if value == null { return false }
    if value.?.*.kind != json.TRUE && value.?.*.kind != json.FALSE { parseFail(t.c3("The 'optional' flag for a ", what, " must be a boolean literal.")) }
    return value.?.*.kind == json.TRUE
}

fn parseMembers(array: *json.Value, what: []const u8, owner: []const u8, members: *[*]Member) -> usize {
    const count = array.*.count
    members.* = unsafe { @ptrFromInt([*]Member, s.alloc((count + 1) * @sizeOf(Member))) }
    var index: usize = 0
    while index < count {
        const item = array.*.items[index]
        requireProperty(item, "name", if std.text.same(what, "type member") { "type member" } else { "parameter" })
        members.*[index] = Member.{
            .name = json.stringAt(item, "name", ""),
            .ref = refOf(item),
            .optional = checkOptional(item, if std.text.same(what, "type member") { "type member" } else { "parameter" }),
            .nullable = std.text.same(what, "type member") && json.boolAt(item, "nullable", false),
            .description = json.stringAt(item, "description", ""),
            .ty = undefined,
        }
        var other: usize = 0
        while other < index {
            if std.text.same(members.*[other].name, members.*[index].name) { parseFail(t.c2(owner, " has duplicate names")) }
            other += 1
        }
        index += 1
    }
    return count
}

// Whether every one of TARGETS is allowed by one of DEBUGGABLES (models.py's validate_target_types).
fn validTargets(debuggables: t.List, targets: t.List) -> bool {
    var index: usize = 0
    while index < targets.count {
        const target = targets.items[index]
        var needed = ""
        if std.text.same(target, "itml") || std.text.same(target, "javascript") || std.text.same(target, "service-worker") || std.text.same(target, "wasm-debugger") {
            needed = target
        } else if std.text.same(target, "web-page") || std.text.same(target, "page") || std.text.same(target, "frame") || std.text.same(target, "worker") {
            needed = "web-page"
        }
        if needed.length > 0 && !t.contains(debuggables, needed) { return false }
        index += 1
    }
    return true
}

fn checkTargets(object: *json.Value, what: []const u8, name: []const u8, debuggables: t.List, hasDebuggables: bool) -> []const u8 {
    const value = json.get(object, "targetTypes")
    if value == null { return "null" }
    if !isArray(value) { parseFail(t.c4("Malformed domain specification: targetTypes for ", what, " ", s.join(name, " is not an array"))) }
    const targets = stringList(value)
    var index: usize = 0
    while index < targets.count {
        if !wordIn(TARGET_TYPES, targets.items[index]) { parseFail(t.c5("Malformed domain specification: targetTypes for ", what, " ", name, " is an unsupported string.")) }
        var other: usize = 0
        while other < index {
            if std.text.same(targets.items[other], targets.items[index]) && !std.text.same(what, "domain") { parseFail(t.c5("Malformed domain specification: targetTypes list for ", what, " ", name, " has duplicate items")) }
            other += 1
        }
        index += 1
    }
    if hasDebuggables && debuggables.count > 0 && !validTargets(debuggables, targets) {
        parseFail(t.c5("Malformed domain specification: ", what, " ", name, " has an item in targetTypes that is not supported by any value in debuggableTypes."))
    }
    return json.dumps(value.?)
}

fn parseDeclaration(object: *json.Value) -> Declaration {
    requireProperty(object, "id", "type")
    requireProperty(object, "type", "type")
    const name = json.stringAt(object, "id", "")
    var members: [*]Member = undefined
    var count: usize = 0
    const properties = json.get(object, "properties")
    if properties != null {
        if !isArray(properties) { parseFail("Malformed type specification: properties is not an array") }
        count = parseMembers(properties.?, "type member", s.join("Malformed domain specification: type declaration for ", name), &members)
    } else {
        members = unsafe { @ptrFromInt([*]Member, s.alloc(@sizeOf(Member))) }
    }
    const ref = refOf(object)
    if !std.text.same(name, t.upperFirst(name)) { parseFail("Types must begin with an uppercase character.") }
    return Declaration.{ .name = name, .ref = ref, .description = json.stringAt(object, "description", ""), .condition = json.stringAt(object, "condition", ""), .members = members, .memberCount = count, .ty = undefined }
}

fn parseCommand(object: *json.Value, debuggables: t.List, hasDebuggables: bool) -> Command {
    requireProperty(object, "name", "command")
    const name = json.stringAt(object, "name", "")
    const targets = checkTargets(object, "command", name, debuggables, hasDebuggables)
    var parameters: [*]Member = unsafe { @ptrFromInt([*]Member, s.alloc(@sizeOf(Member))) }
    var parameterCount: usize = 0
    var returns: [*]Member = unsafe { @ptrFromInt([*]Member, s.alloc(@sizeOf(Member))) }
    var returnCount: usize = 0
    const given = json.get(object, "parameters")
    if given != null {
        if !isArray(given) { parseFail("Malformed command specification: parameters is not an array") }
        parameterCount = parseMembers(given.?, "parameter", s.join("Malformed domain specification: call parameter list for command ", name), &parameters)
    }
    const returned = json.get(object, "returns")
    if returned != null {
        if !isArray(returned) { parseFail("Malformed command specification: returns is not an array") }
        returnCount = parseMembers(returned.?, "parameter", s.join("Malformed domain specification: return parameter list for command ", name), &returns)
    }
    return Command.{ .name = name, .targetTypes = targets, .parameters = parameters, .parameterCount = parameterCount, .returns = returns, .returnCount = returnCount,
        .description = json.stringAt(object, "description", ""), .condition = json.stringAt(object, "condition", ""), .async = json.boolAt(object, "async", false) }
}

fn parseEvent(object: *json.Value, debuggables: t.List, hasDebuggables: bool) -> Event {
    requireProperty(object, "name", "event")
    const name = json.stringAt(object, "name", "")
    const targets = checkTargets(object, "event", name, debuggables, hasDebuggables)
    var parameters: [*]Member = unsafe { @ptrFromInt([*]Member, s.alloc(@sizeOf(Member))) }
    var parameterCount: usize = 0
    const given = json.get(object, "parameters")
    if given != null {
        if !isArray(given) { parseFail("Malformed event specification: parameters is not an array") }
        parameterCount = parseMembers(given.?, "parameter", s.join("Malformed domain specification: parameter list for event ", name), &parameters)
    }
    return Event.{ .name = name, .targetTypes = targets, .parameters = parameters, .parameterCount = parameterCount,
        .description = json.stringAt(object, "description", ""), .condition = json.stringAt(object, "condition", "") }
}

fn parseDomain(p: *Protocol, object: *json.Value, supplemental: bool) -> void {
    requireProperty(object, "domain", "domain")
    const name = json.stringAt(object, "domain", "")
    const domain = newDomain(name)
    domain.*.supplemental = supplemental
    domain.*.exposedAs = json.stringAt(object, "exposedAs", name)
    domain.*.description = json.stringAt(object, "description", "")
    domain.*.condition = json.stringAt(object, "condition", "")

    var debuggables = t.list()
    const debuggableValue = json.get(object, "debuggableTypes")
    const hasDebuggables = debuggableValue != null
    if hasDebuggables {
        if !isArray(debuggableValue) { parseFail(t.c3("Malformed domain specification: debuggableTypes for domain ", name, " is not an array")) }
        debuggables = stringList(debuggableValue)
        var index: usize = 0
        while index < debuggables.count {
            if !wordIn(DEBUGGABLE_TYPES, debuggables.items[index]) { parseFail(t.c3("Malformed domain specification: debuggableTypes for domain ", name, " is an unsupported string.")) }
            index += 1
        }
        domain.*.debuggableTypes = json.dumps(debuggableValue.?)
    }
    domain.*.targetTypes = checkTargets(object, "domain", name, debuggables, hasDebuggables)

    const version = json.get(object, "version")
    if version != null {
        if version.?.*.kind != json.NUMBER || !version.?.*.integer { parseFail("Malformed domain specification: version is not a number or string") }
        domain.*.hasVersion = true
        domain.*.version = json.integerOf(version.?)
    }

    const types = json.get(object, "types")
    if types != null {
        if !isArray(types) { parseFail("Malformed domain specification: types is not an array") }
        const array = types.?
        domain.*.declarations = unsafe { @ptrFromInt([*]Declaration, s.alloc((array.*.count + 1) * @sizeOf(Declaration))) }
        var index: usize = 0
        while index < array.*.count {
            domain.*.declarations[index] = parseDeclaration(array.*.items[index])
            index += 1
        }
        domain.*.declarationCount = array.*.count
    }
    const commands = json.get(object, "commands")
    if commands != null {
        if !isArray(commands) { parseFail("Malformed domain specification: commands is not an array") }
        const array = commands.?
        domain.*.commands = unsafe { @ptrFromInt([*]Command, s.alloc((array.*.count + 1) * @sizeOf(Command))) }
        var index: usize = 0
        while index < array.*.count {
            domain.*.commands[index] = parseCommand(array.*.items[index], debuggables, hasDebuggables)
            index += 1
        }
        domain.*.commandCount = array.*.count
    }
    const events = json.get(object, "events")
    if events != null {
        if !isArray(events) { parseFail("Malformed domain specification: events is not an array") }
        const array = events.?
        domain.*.events = unsafe { @ptrFromInt([*]Event, s.alloc((array.*.count + 1) * @sizeOf(Event))) }
        var index: usize = 0
        while index < array.*.count {
            domain.*.events[index] = parseEvent(array.*.items[index], debuggables, hasDebuggables)
            index += 1
        }
        domain.*.eventCount = array.*.count
    }
    if p.*.domainCount == p.*.domainCapacity { s.fail("too many domains") }
    p.*.domains[p.*.domainCount] = domain
    p.*.domainCount += 1
}

// The domains of the specification file at PATH added (with
// SUPPLEMENTAL, those only referred to, not generated).
pub fn loadSpecification(p: *Protocol, path: []const u8, supplemental: bool) -> void {
    const text = json.withoutComments(s.readWhole(path))
    const document = json.parse(text, path)
    var domains = document
    var flags: ?*json.Value = null
    if document.*.kind == json.OBJECT {
        const listed = json.get(document, "domains")
        if listed != null { domains = listed.? }
        flags = json.get(document, "conditionFlags")
    }
    if domains.*.kind == json.ARRAY {
        var index: usize = 0
        while index < domains.*.count {
            parseDomain(p, domains.*.items[index], supplemental)
            index += 1
        }
    } else {
        parseDomain(p, domains, supplemental)
    }
    if flags != null && flags.?.*.kind == json.STRING { p.*.conditionFlags = flags.?.*.text }
}

// ---------------------------------------------------------------------------
// Types.

fn newType(kind: u8, name: []const u8, domain: *Domain) -> *Type {
    const ty: *Type = unsafe { @ptrFromInt(*Type, s.alloc(@sizeOf(Type))) }
    ty.*.kind = kind
    ty.*.name = name
    ty.*.domain = domain
    ty.*.declaration = null
    ty.*.ref = null
    ty.*.resolved = null
    ty.*.values = t.list()
    ty.*.anonymous = false
    return ty
}

pub fn qualifiedName(ty: *Type) -> []const u8 {
    if ty.*.kind == PRIMITIVE { return ty.*.name }
    if ty.*.kind == ARRAY { return s.join("array.", qualifiedName(ty.*.resolved.?)) }
    return t.c3(ty.*.domain.*.name, ".", ty.*.name)
}

fn findType(p: *Protocol, name: []const u8) -> ?*Type {
    var index: usize = 0
    while index < p.*.typeNames.count {
        if std.text.same(p.*.typeNames.items[index], name) { return p.*.types[index] }
        index += 1
    }
    return null
}

fn addType(p: *Protocol, name: []const u8, ty: *Type) -> void {
    var index: usize = 0
    while index < p.*.typeNames.count {
        if std.text.same(p.*.typeNames.items[index], name) {
            p.*.types[index] = ty
            return
        }
        index += 1
    }
    if p.*.typeNames.count == p.*.typeCapacity { s.fail("too many types") }
    p.*.types[p.*.typeNames.count] = ty
    t.push(&p.*.typeNames, name)
}

fn primitiveRef(kind: []const u8) -> *TypeRef {
    const r: *TypeRef = unsafe { @ptrFromInt(*TypeRef, s.alloc(@sizeOf(TypeRef))) }
    r.*.kind = kind
    r.*.ref = ""
    r.*.values = t.list()
    r.*.hasValues = false
    r.*.items = null
    return r
}

fn resolveType(p: *Protocol, ty: *Type) -> void {
    if ty.*.resolved != null { return }
    if ty.*.kind == ALIASED || ty.*.kind == ARRAY {
        ty.*.resolved = lookupTypeReference(p, ty.*.ref.?, ty.*.domain)
    } else if ty.*.kind == ENUM {
        ty.*.resolved = lookupTypeReference(p, ty.*.ref.?, p.*.globalDomain)
    }
}

pub fn lookupTypeReference(p: *Protocol, ref: *TypeRef, domain: *Domain) -> *Type {
    // Anonymous arrays and enums are made afresh.
    if std.text.same(ref.*.kind, "array") {
        const array = newType(ARRAY, "", domain)
        array.*.ref = ref.*.items
        resolveType(p, array)
        return array
    }
    if ref.*.hasValues {
        const anonymous = newType(ENUM, "(anonymous)", domain)
        anonymous.*.values = ref.*.values
        anonymous.*.ref = primitiveRef(ref.*.kind)
        anonymous.*.anonymous = true
        resolveType(p, anonymous)
        return anonymous
    }
    const name = if ref.*.ref.length > 0 { ref.*.ref } else { ref.*.kind }
    // A type of the same domain needs no prefix.
    const local = findType(p, t.c3(domain.*.name, ".", name))
    if local != null {
        resolveType(p, local.?)
        return local.?
    }
    // Primitive types, and types of other domains named in full.
    const found = findType(p, name)
    if found != null {
        resolveType(p, found.?)
        return found.?
    }
    typecheckFail(t.c5("Lookup failed for type reference: ", name, " (referenced from domain: ", domain.*.name, ")"))
    return found.?
}

pub fn resolveTypes(p: *Protocol) -> void {
    addType(p, "string", newType(PRIMITIVE, "string", p.*.globalDomain))
    addType(p, "boolean", newType(PRIMITIVE, "boolean", p.*.globalDomain))
    addType(p, "integer", newType(PRIMITIVE, "integer", p.*.globalDomain))
    addType(p, "number", newType(PRIMITIVE, "number", p.*.globalDomain))
    addType(p, "any", newType(PRIMITIVE, "any", p.*.globalDomain))
    addType(p, "object", newType(PRIMITIVE, "object", p.*.globalDomain))

    var declared = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        const domain = p.*.domains[index]
        var at: usize = 0
        while at < domain.*.declarationCount {
            const declaration = &domain.*.declarations[at]
            if declaration.*.ref.*.ref.length > 0 { typecheckFail("Type declarations must name a base type, not a type reference.") }
            const qualified = t.c3(domain.*.name, ".", declaration.*.name)
            if wordIn("boolean string integer number enum array object any", qualified) || t.contains(declared, qualified) {
                typecheckFail(s.join("Duplicate type declaration: ", qualified))
            }
            t.push(&declared, qualified)
            const kind = declaration.*.ref.*.kind
            var ty: *Type = undefined
            if declaration.*.ref.*.hasValues {
                ty = newType(ENUM, declaration.*.name, domain)
                ty.*.values = declaration.*.ref.*.values
                ty.*.ref = primitiveRef(kind)
            } else if std.text.same(kind, "array") {
                ty = newType(ARRAY, declaration.*.name, domain)
                ty.*.ref = declaration.*.ref.*.items
            } else if std.text.same(kind, "object") {
                ty = newType(OBJECT, declaration.*.name, domain)
            } else {
                ty = newType(ALIASED, declaration.*.name, domain)
                ty.*.ref = declaration.*.ref
            }
            ty.*.declaration = declaration
            addType(p, qualified, ty)
            at += 1
        }
        index += 1
    }

    // Every reference, resolved recursively.
    index = 0
    while index < p.*.domainCount {
        const domain = p.*.domains[index]
        var at: usize = 0
        while at < domain.*.declarationCount {
            const declaration = &domain.*.declarations[at]
            const found = findType(p, t.c3(domain.*.name, ".", declaration.*.name))
            if found == null { typecheckFail(t.c5("Lookup failed for type declaration: ", declaration.*.name, " (referenced from domain: ", domain.*.name, ")")) }
            resolveType(p, found.?)
            declaration.*.ty = found.?
            var member: usize = 0
            while member < declaration.*.memberCount {
                declaration.*.members[member].ty = lookupTypeReference(p, declaration.*.members[member].ref, domain)
                member += 1
            }
            at += 1
        }
        at = 0
        while at < domain.*.commandCount {
            const command = &domain.*.commands[at]
            var parameter: usize = 0
            while parameter < command.*.parameterCount {
                command.*.parameters[parameter].ty = lookupTypeReference(p, command.*.parameters[parameter].ref, domain)
                parameter += 1
            }
            parameter = 0
            while parameter < command.*.returnCount {
                command.*.returns[parameter].ty = lookupTypeReference(p, command.*.returns[parameter].ref, domain)
                parameter += 1
            }
            at += 1
        }
        at = 0
        while at < domain.*.eventCount {
            const event = &domain.*.events[at]
            var parameter: usize = 0
            while parameter < event.*.parameterCount {
                event.*.parameters[parameter].ty = lookupTypeReference(p, event.*.parameters[parameter].ref, domain)
                parameter += 1
            }
            at += 1
        }
        index += 1
    }
}

pub fn isEnum(ty: *Type) -> bool {
    if ty.*.kind == ALIASED { return isEnum(ty.*.resolved.?) }
    return ty.*.kind == ENUM
}

pub fn isAnonymousEnum(ty: *Type) -> bool { return ty.*.kind == ENUM && ty.*.anonymous }

// The type an alias stands for (other types as they are).
pub fn unaliased(ty: *Type) -> *Type {
    if ty.*.kind == ALIASED { return ty.*.resolved.? }
    return ty
}

// An enum's primitive type (other types as they are).
pub fn unenumerated(ty: *Type) -> *Type {
    if ty.*.kind == ENUM { return ty.*.resolved.? }
    return ty
}

// ---------------------------------------------------------------------------
// What the generators share.

// The domains to generate: those not supplemental.
pub fn generated(p: *Protocol, index: usize) -> bool { return !p.*.domains[index].*.supplemental }

fn numberEnumValues(p: *Protocol, ty: *Type) -> void {
    if ty.*.kind != ENUM { return }
    var index: usize = 0
    while index < ty.*.values.count {
        const value = ty.*.values.items[index]
        if !t.contains(p.*.enumValues, value) { t.push(&p.*.enumValues, value) }
        index += 1
    }
}

// The enum values in the order they are numbered (generator.py's
// _traverse_and_assign_enum_values): those of the declarations and their
// members, then of the events' parameters, then of the commands'.
pub fn enumValues(p: *Protocol) -> t.List {
    if p.*.enumValuesKnown { return p.*.enumValues }
    p.*.enumValuesKnown = true
    var index: usize = 0
    while index < p.*.domainCount {
        if generated(p, index) {
            const domain = p.*.domains[index]
            var at: usize = 0
            while at < domain.*.declarationCount {
                const declaration = &domain.*.declarations[at]
                numberEnumValues(p, declaration.*.ty)
                var member: usize = 0
                while member < declaration.*.memberCount {
                    numberEnumValues(p, declaration.*.members[member].ty)
                    member += 1
                }
                at += 1
            }
        }
        index += 1
    }
    index = 0
    while index < p.*.domainCount {
        if generated(p, index) {
            const domain = p.*.domains[index]
            var at: usize = 0
            while at < domain.*.eventCount {
                var parameter: usize = 0
                while parameter < domain.*.events[at].parameterCount {
                    numberEnumValues(p, domain.*.events[at].parameters[parameter].ty)
                    parameter += 1
                }
                at += 1
            }
        }
        index += 1
    }
    index = 0
    while index < p.*.domainCount {
        if generated(p, index) {
            const domain = p.*.domains[index]
            var at: usize = 0
            while at < domain.*.commandCount {
                const command = &domain.*.commands[at]
                var parameter: usize = 0
                while parameter < command.*.parameterCount {
                    numberEnumValues(p, command.*.parameters[parameter].ty)
                    parameter += 1
                }
                parameter = 0
                while parameter < command.*.returnCount {
                    numberEnumValues(p, command.*.returns[parameter].ty)
                    parameter += 1
                }
                at += 1
            }
        }
        index += 1
    }
    return p.*.enumValues
}

pub fn encodingFor(p: *Protocol, value: []const u8) -> []const u8 {
    const values = enumValues(p)
    var index: usize = 0
    while index < values.count {
        if std.text.same(values.items[index], value) { return s.decimal(@intCast(u64, index)) }
        index += 1
    }
    s.fail(s.join("KeyError: ", value))
    return ""
}

// The types built by hand whose shapes are checked at run time
// (generator.py's _TYPES_NEEDING_RUNTIME_CASTS).
pub fn needsRuntimeCasts(ty: *Type) -> bool {
    const name = qualifiedName(ty)
    return std.text.same(name, "Runtime.ObjectPreview") || std.text.same(name, "Runtime.RemoteObject") || std.text.same(name, "Runtime.PropertyDescriptor") ||
        std.text.same(name, "Runtime.InternalPropertyDescriptor") || std.text.same(name, "Runtime.CollectionEntry") || std.text.same(name, "Debugger.FunctionDetails") ||
        std.text.same(name, "Debugger.CallFrame") || std.text.same(name, "Timeline.TimelineEvent") || std.text.same(name, "Test.TypeNeedingCast")
}

// The types whose objects may carry more fields than they declare
// (_TYPES_WITH_OPEN_FIELDS).
pub fn hasOpenFields(ty: *Type) -> bool {
    const name = qualifiedName(ty)
    return std.text.same(name, "Timeline.TimelineEvent") || std.text.same(name, "CSS.CSSProperty") || std.text.same(name, "Network.Response") || std.text.same(name, "Test.OpenParameters")
}

fn gatherShapeTypes(p: *Protocol, ty: *Type) -> void {
    if ty.*.kind == ARRAY {
        gatherShapeTypes(p, ty.*.resolved.?)
        return
    }
    if ty.*.kind == ALIASED {
        gatherShapeTypes(p, ty.*.resolved.?)
        return
    }
    if ty.*.kind != OBJECT && ty.*.kind != ENUM { return }
    const name = qualifiedName(ty)
    if t.contains(p.*.shapeTypes, name) { return }
    t.push(&p.*.shapeTypes, name)
    if ty.*.kind == OBJECT {
        const declaration = ty.*.declaration.?
        var member: usize = 0
        while member < declaration.*.memberCount {
            gatherShapeTypes(p, declaration.*.members[member].ty)
            member += 1
        }
    }
}

// Whether the type needs shape assertions: whether it is reached from one
// needing runtime casts in the domains generated.
pub fn needsShapeAssertions(p: *Protocol, ty: *Type) -> bool {
    if !p.*.shapeTypesKnown {
        p.*.shapeTypesKnown = true
        var index: usize = 0
        while index < p.*.domainCount {
            if generated(p, index) {
                const domain = p.*.domains[index]
                var at: usize = 0
                while at < domain.*.declarationCount {
                    if needsRuntimeCasts(domain.*.declarations[at].ty) { gatherShapeTypes(p, domain.*.declarations[at].ty) }
                    at += 1
                }
            }
            index += 1
        }
    }
    return t.contains(p.*.shapeTypes, qualifiedName(ty))
}

// ---------------------------------------------------------------------------
// Text.

// TEXT with its first letter capital, "webkit" being "WebKit" (generator.py's ucfirst).
pub fn ucfirst(text: []const u8) -> []const u8 {
    if std.text.same(text, "webkit") { return "WebKit" }
    return t.upperFirst(text)
}

// TEXT between "#if CONDITION" and "#endif // CONDITION", when there is a condition.
pub fn guarded(condition: []const u8, text: []const u8) -> []const u8 {
    if condition.length == 0 { return text }
    return t.c6("#if ", condition, "\n", text, "\n#endif // ", condition)
}

pub fn license(p: *Protocol) -> []const u8 {
    return t.c3("/*
 * Copyright (C) 2013 Google Inc. All rights reserved.
 * Copyright (C) 2013-2016 Apple Inc. All rights reserved.
 * Copyright (C) 2014 University of Washington. All rights reserved.
 *
 * Redistribution and use in source and binary forms, with or without
 * modification, are permitted provided that the following conditions
 * are met:
 * 1. Redistributions of source code must retain the above copyright
 *    notice, this list of conditions and the following disclaimer.
 * 2. Redistributions in binary form must reproduce the above copyright
 *    notice, this list of conditions and the following disclaimer in the
 *    documentation and/or other materials provided with the distribution.
 *
 * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
 * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
 * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
 * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
 * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
 * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
 * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
 * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
 * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
 * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
 * THE POSSIBILITY OF SUCH DAMAGE.
 */

// DO NOT EDIT THIS FILE. It is automatically generated from ", p.*.inputFilename, " by the script: Source/JavaScriptCore/inspector/scripts/generate-inspector-protocol-bindings.py")
}

// An include added to INCLUDES, when the framework is one of ALLOWED (or
// Test): <HEADER> of WTF and std, <FRAMEWORK/name> of another framework
// (or a system header of JavaScriptCore's), "name" of its own.
pub fn addInclude(p: *Protocol, includes: *t.List, allowed: []const u8, frameworkName: []const u8, header: []const u8, system: bool) -> void {
    const own = p.*.framework.name
    if !wordIn(allowed, own) && !std.text.same(own, "Test") { return }
    var line: []const u8 = ""
    if std.text.same(frameworkName, "WTF") || std.text.same(frameworkName, "std") {
        line = t.c3("#include <", header, ">")
    } else if (system && std.text.same(frameworkName, "JavaScriptCore")) || !std.text.same(own, frameworkName) {
        line = t.c5("#include <", frameworkName, "/", s.baseName(header), ">")
    } else {
        line = t.c3("#include \"", s.baseName(header), "\"")
    }
    if !t.contains(includes.*, line) { t.push(includes, line) }
}

// The protocol's C++ namespace for helpers.
pub fn helpersNamespace(p: *Protocol) -> []const u8 {
    if std.text.same(p.*.framework.cppProtocolGroup, "Inspector") { return "Helpers" }
    return s.join(p.*.framework.cppProtocolGroup, "Helpers")
}

// The words of enum values always written in these capitals.
const SPECIAL_CASED = "2D API CSS DOM HTML JIT SRGB XHR XML IOS MacOS JavaScript ServiceWorker"

fn renamedEnumValue(value: []const u8) -> []const u8 {
    if std.text.same(value, "canvas-bitmaprenderer") { return "CanvasBitmapRenderer" }
    if std.text.same(value, "offscreen-canvas-bitmaprenderer") { return "OffscreenCanvasBitmapRenderer" }
    if std.text.same(value, "canvas-webgl") { return "CanvasWebGL" }
    if std.text.same(value, "offscreen-canvas-webgl") { return "OffscreenCanvasWebGL" }
    if std.text.same(value, "canvas-webgl2") { return "CanvasWebGL2" }
    if std.text.same(value, "offscreen-canvas-webgl2") { return "OffscreenCanvasWebGL2" }
    if std.text.same(value, "bitmaprenderer") { return "BitmapRenderer" }
    if std.text.same(value, "offscreen-bitmaprenderer") { return "OffscreenBitmapRenderer" }
    if std.text.same(value, "webgl") { return "WebGL" }
    if std.text.same(value, "offscreen-webgl") { return "OffscreenWebGL" }
    if std.text.same(value, "webgl2") { return "WebGL2" }
    if std.text.same(value, "offscreen-webgl2") { return "OffscreenWebGL2" }
    if std.text.same(value, "webgpu") { return "WebGPU" }
    if std.text.same(value, "mediasource") { return "MediaSource" }
    if std.text.same(value, "webrtc") { return "WebRTC" }
    if std.text.same(value, "itp-debug") { return "ITPDebug" }
    return value
}

// Whether WORD is at AT of TEXT, letters in any case.
fn atIgnoringCase(text: []const u8, at: usize, word: []const u8) -> bool {
    if at + word.length > text.length { return false }
    var index: usize = 0
    while index < word.length {
        if t.lowerByte(text[at + index]) != t.lowerByte(word[index]) { return false }
        index += 1
    }
    return true
}

// The C++ and JavaScript name of an enum value: its words (between
// hyphens) capitalized and run together, the special words in their
// capitals (generator.py's stylized_name_for_enum_value).
pub fn stylizedEnumName(value: []const u8) -> []const u8 {
    const renamed = renamedEnumValue(value)
    var words = t.list()
    var start: usize = 0
    var index: usize = 0
    while index <= renamed.length {
        if index == renamed.length || renamed[index] == 45 {
            t.push(&words, ucfirst(renamed[start..index]))
            start = index + 1
        }
        index += 1
    }
    const joined = t.joined(words, "")
    var specials = t.list()
    start = 0
    index = 0
    while index <= SPECIAL_CASED.length {
        if index == SPECIAL_CASED.length || SPECIAL_CASED[index] == 32 {
            t.push(&specials, SPECIAL_CASED[start..index])
            start = index + 1
        }
        index += 1
    }
    var parts = t.list()
    start = 0
    index = 0
    while index < joined.length {
        var found = false
        var special: usize = 0
        while special < specials.count {
            const word = specials.items[special]
            if atIgnoringCase(joined, index, word) {
                t.push(&parts, joined[start..index])
                t.push(&parts, word)
                index += word.length
                start = index
                found = true
                break
            }
            special += 1
        }
        if !found { index += 1 }
    }
    t.push(&parts, joined[start..joined.length])
    return t.joined(parts, "")
}

// "object", "number", "string" or "boolean": a parameter's type to the
// JavaScript backend commands.
pub fn jsNameForParameterType(ty: *Type) -> []const u8 {
    const plain = unenumerated(unaliased(ty))
    if plain.*.kind == ARRAY || plain.*.kind == OBJECT { return "object" }
    const name = qualifiedName(plain)
    if std.text.same(name, "object") || std.text.same(name, "any") { return "object" }
    if std.text.same(name, "integer") || std.text.same(name, "number") { return "number" }
    return name
}

// ---------------------------------------------------------------------------
// C++ names (cpp_generator.py).

pub fn cppNameForPrimitive(ty: *Type) -> []const u8 {
    const name = ty.*.name
    if std.text.same(name, "boolean") { return "bool" }
    if std.text.same(name, "integer") { return "int" }
    if std.text.same(name, "number") { return "double" }
    if std.text.same(name, "string") { return "String" }
    if std.text.same(name, "object") { return "JSON::Object" }
    if std.text.same(name, "array") { return "JSON::Array" }
    if std.text.same(name, "any") { return "JSON::Value" }
    return "None"
}

fn methodSuffix(ty: *Type) -> []const u8 {
    const plain = unenumerated(unaliased(ty))
    if plain.*.kind == OBJECT || std.text.same(qualifiedName(plain), "object") { return "Object" }
    if plain.*.kind == ARRAY || std.text.same(qualifiedName(plain), "array") { return "Array" }
    if plain.*.kind == PRIMITIVE {
        if std.text.same(plain.*.name, "number") { return "Double" }
        if std.text.same(plain.*.name, "any") { return "Value" }
        return ucfirst(plain.*.name)
    }
    s.fail("unknown type")
    return ""
}

pub fn cppGetterMethod(ty: *Type) -> []const u8 { return s.join("get", methodSuffix(ty)) }
pub fn cppSetterMethod(ty: *Type) -> []const u8 { return s.join("set", methodSuffix(ty)) }

fn domainQualified(ty: *Type) -> []const u8 { return t.c4("Protocol::", ty.*.domain.*.name, "::", ty.*.name) }

pub fn cppProtocolType(given: *Type) -> []const u8 {
    const ty = unaliased(given)
    if ty.*.kind == ARRAY && ty.*.name.length == 0 { return t.c3("JSON::ArrayOf<", cppProtocolType(ty.*.resolved.?), ">") }
    if ty.*.kind == OBJECT || ty.*.kind == ENUM || ty.*.kind == ARRAY { return domainQualified(ty) }
    return cppNameForPrimitive(ty)
}

pub fn cppTypeForTypeMemberArgument(given: *Type, name: []const u8) -> []const u8 {
    const ty = unaliased(given)
    if ty.*.kind == ARRAY || ty.*.kind == OBJECT { return t.c3("Ref<", cppProtocolType(ty), ">&&") }
    const qualified = qualifiedName(ty)
    if std.text.same(qualified, "object") { return "Ref<JSON::Object>&&" }
    if std.text.same(qualified, "array") { return "Ref<JSON::Array>&&" }
    if std.text.same(qualified, "any") { return "Ref<JSON::Value>&&" }
    if std.text.same(qualified, "string") { return "const String&" }
    if ty.*.kind == ENUM {
        if ty.*.anonymous { return ucfirst(name) }
        return domainQualified(ty)
    }
    return cppNameForPrimitive(ty)
}

// The C++ type of a command's parameter (In), of what it returns as declared
// (ReturnDeclaration), as passed back (ReturnArgument, also an event's
// parameter), optional or not.
pub const PARAMETER: u8 = 0
pub const RETURN_DECLARATION: u8 = 1
pub const RETURN_ARGUMENT: u8 = 2

pub fn cppType(given: *Type, optional: bool, use: u8) -> []const u8 {
    var ty = unaliased(given)
    if isAnonymousEnum(ty) { ty = ty.*.resolved.? }
    const reference = if use == RETURN_DECLARATION { "" } else { "&&" }
    const pointer = if optional { "RefPtr<" } else { "Ref<" }
    const qualified = qualifiedName(ty)
    if use == PARAMETER {
        if ty.*.kind == OBJECT || std.text.same(qualified, "object") { return t.c3(pointer, "JSON::Object>", reference) }
        if ty.*.kind == ARRAY || std.text.same(qualified, "array") { return t.c3(pointer, "JSON::Array>", reference) }
    } else {
        if ty.*.kind == ARRAY || ty.*.kind == OBJECT { return t.c4(pointer, cppProtocolType(ty), ">", reference) }
        if std.text.same(qualified, "object") { return t.c3(pointer, "JSON::Object>", reference) }
        if std.text.same(qualified, "array") { return t.c3(pointer, "JSON::Array>", reference) }
    }
    if std.text.same(qualified, "any") { return t.c3(pointer, "JSON::Value>", reference) }
    if std.text.same(qualified, "string") { return if use == RETURN_DECLARATION { "String" } else { "const String&" } }
    var name: []const u8 = ""
    if ty.*.kind == ENUM {
        name = domainQualified(ty)
    } else if ty.*.kind == PRIMITIVE {
        name = cppNameForPrimitive(ty)
    } else {
        s.fail("unknown type")
    }
    if optional { return t.c4("std::optional<", name, ">", reference) }
    return name
}

pub fn cppTypeForEnum(ty: *Type, name: []const u8) -> []const u8 {
    if ty.*.anonymous { return t.c4("Protocol::", ty.*.domain.*.name, "::", ucfirst(name)) }
    return domainQualified(ty)
}

fn isNumeric(name: []const u8) -> bool { return std.text.same(name, "boolean") || std.text.same(name, "integer") || std.text.same(name, "number") }

pub fn shouldMoveArgument(given: *Type, optional: bool) -> bool {
    const ty = unenumerated(unaliased(given))
    if ty.*.kind != ARRAY && std.text.same(ty.*.name, "string") { return false }
    return optional == (ty.*.kind != ARRAY && isNumeric(ty.*.name))
}

pub fn shouldReleaseArgument(given: *Type, optional: bool) -> bool {
    const ty = unenumerated(unaliased(given))
    if std.text.same(ty.*.name, "string") { return false }
    if isNumeric(ty.*.name) { return false }
    return optional
}

pub fn shouldDereferenceArgument(given: *Type, optional: bool) -> bool {
    const ty = unenumerated(unaliased(given))
    if std.text.same(ty.*.name, "string") { return false }
    if !isNumeric(ty.*.name) { return false }
    return optional
}

// The type the dispatchers work with: an alias's, an anonymous enum's
// primitive type.
pub fn dispatched(given: *Type) -> *Type {
    const ty = unaliased(given)
    if isAnonymousEnum(ty) { return ty.*.resolved.? }
    return ty
}

// What a value of TYPE (an argument named NAME, TYPE as dispatched)
// becomes when it is set on a JSON object: its enum's string, the pointer
// released, dereferenced or moved (as the dispatchers pass return values
// and event parameters).
pub fn setterValue(p: *Protocol, ty: *Type, optional: bool, name: []const u8) -> []const u8 {
    if isEnum(ty) {
        const value = if optional { s.join("*", name) } else { name }
        return t.c5("Protocol::", helpersNamespace(p), "::getEnumConstantValue(", value, ")")
    }
    if shouldReleaseArgument(ty, optional) { return s.join(name, ".releaseNonNull()") }
    if shouldDereferenceArgument(ty, optional) { return s.join("*", name) }
    if shouldMoveArgument(ty, optional) { return t.c3("WTF::move(", name, ")") }
    return name
}
