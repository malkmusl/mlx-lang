// JSON for the inspector protocol generators: a document read into values
// that keep the order of their keys (as Python's dictionaries do, a key
// given twice keeping its first place and its last value), and values
// written back as Python's json.dumps writes them by default (", " and
// ": " between items, everything not ASCII escaped).
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")

pub const NULL: u8 = 0
pub const FALSE: u8 = 1
pub const TRUE: u8 = 2
pub const NUMBER: u8 = 3
pub const STRING: u8 = 4
pub const ARRAY: u8 = 5
pub const OBJECT: u8 = 6

pub const Value = struct {
    kind: u8
    // A string's text, decoded; a number as it is written.
    text: []const u8
    // Whether a number has neither a fraction nor an exponent (an int to Python).
    integer: bool
    // An array's items; an object's values.
    items: [*]*Value
    // An object's keys.
    keys: [*][]const u8
    count: usize
}

// ---------------------------------------------------------------------------
// Reading.

var source: [*]const u8 = undefined
var sourceLength: usize = 0
var position: usize = 0
var sourceName: [*]const u8 = undefined
var sourceNameLength: usize = 0

fn newValue(kind: u8) -> *Value {
    const value: *Value = unsafe { @ptrFromInt(*Value, s.alloc(@sizeOf(Value))) }
    value.*.kind = kind
    value.*.text = ""
    value.*.integer = false
    value.*.count = 0
    return value
}

fn bad(message: []const u8) -> void {
    // The line and column of the position, as Python reports them.
    var line: usize = 1
    var column: usize = 1
    var index: usize = 0
    while index < position && index < sourceLength {
        if source[index] == 10 {
            line += 1
            column = 1
        } else {
            column += 1
        }
        index += 1
    }
    s.fail(t.c9("Parse error trying to decode JSON!\nerror: ", message, " at ", sourceName[0..sourceNameLength], ":", s.decimal(@intCast(u64, line)), ":", s.decimal(@intCast(u64, column)), ""))
}

fn skipSpace() -> void {
    while position < sourceLength {
        const byte = source[position]
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
            position += 1
        } else {
            break
        }
    }
}

fn hexDigit(byte: u8) -> i64 {
    if byte >= 48 && byte <= 57 { return @intCast(i64, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(i64, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(i64, byte - 55) }
    return -1
}

fn hex4() -> u32 {
    if position + 4 > sourceLength { bad("Invalid \\uXXXX escape") }
    var value: u32 = 0
    var index: usize = 0
    while index < 4 {
        const digit = hexDigit(source[position + index])
        if digit < 0 { bad("Invalid \\uXXXX escape") }
        value = value * 16 + @intCast(u32, digit)
        index += 1
    }
    position += 4
    return value
}

// CODE as UTF-8 at ADDRESS; how many bytes it took.
fn putUtf8(address: usize, code: u32) -> usize {
    if code < 128 {
        s.put8(address, @intCast(u8, code))
        return 1
    }
    if code < 2048 {
        s.put8(address, @intCast(u8, 192 | (code >> 6)))
        s.put8(address + 1, @intCast(u8, 128 | (code & 63)))
        return 2
    }
    if code < 65536 {
        s.put8(address, @intCast(u8, 224 | (code >> 12)))
        s.put8(address + 1, @intCast(u8, 128 | ((code >> 6) & 63)))
        s.put8(address + 2, @intCast(u8, 128 | (code & 63)))
        return 3
    }
    s.put8(address, @intCast(u8, 240 | (code >> 18)))
    s.put8(address + 1, @intCast(u8, 128 | ((code >> 12) & 63)))
    s.put8(address + 2, @intCast(u8, 128 | ((code >> 6) & 63)))
    s.put8(address + 3, @intCast(u8, 128 | (code & 63)))
    return 4
}

// The string whose opening quote is at the position, decoded.
fn readString() -> []const u8 {
    position += 1
    const start = position
    // Without escapes the text is the source's own bytes.
    while position < sourceLength && source[position] != 34 && source[position] != 92 {
        if source[position] < 32 { bad("Invalid control character") }
        position += 1
    }
    if position >= sourceLength { bad("Unterminated string starting") }
    if source[position] == 34 {
        position += 1
        return source[start..position - 1]
    }
    // Escapes never make the text longer than the source.
    var end = position
    while end < sourceLength && source[end] != 34 {
        if source[end] == 92 { end += 1 }
        end += 1
    }
    const at = s.alloc(end - start + 1)
    var length = position - start
    t.copyInto(at, source[start..position])
    while true {
        if position >= sourceLength { bad("Unterminated string starting") }
        const byte = source[position]
        if byte == 34 {
            position += 1
            break
        }
        if byte != 92 {
            if byte < 32 { bad("Invalid control character") }
            s.put8(at + length, byte)
            length += 1
            position += 1
            continue
        }
        position += 1
        if position >= sourceLength { bad("Unterminated string starting") }
        const escaped = source[position]
        position += 1
        var plain: u8 = 0
        if escaped == 34 || escaped == 92 || escaped == 47 {
            plain = escaped
        } else if escaped == 98 {
            plain = 8
        } else if escaped == 102 {
            plain = 12
        } else if escaped == 110 {
            plain = 10
        } else if escaped == 114 {
            plain = 13
        } else if escaped == 116 {
            plain = 9
        } else if escaped == 117 {
            var code = hex4()
            if code >= 55296 && code <= 56319 && position + 6 <= sourceLength && source[position] == 92 && source[position + 1] == 117 {
                const saved = position
                position += 2
                const low = hex4()
                if low >= 56320 && low <= 57343 {
                    code = 65536 + ((code - 55296) << 10) + (low - 56320)
                } else {
                    position = saved
                }
            }
            length += putUtf8(at + length, code)
            continue
        } else {
            bad("Invalid \\escape")
        }
        s.put8(at + length, plain)
        length += 1
    }
    s.put8(at + length, 0)
    return s.bytes(at, length)
}

fn readNumber() -> *Value {
    const start = position
    const value = newValue(NUMBER)
    value.*.integer = true
    if source[position] == 45 { position += 1 }
    const digits = position
    while position < sourceLength && std.ascii.isDigit(source[position]) { position += 1 }
    if position == digits { bad("Expecting value") }
    if source[digits] == 48 && position > digits + 1 { position = digits + 1 }
    if position < sourceLength && source[position] == 46 && position + 1 < sourceLength && std.ascii.isDigit(source[position + 1]) {
        value.*.integer = false
        position += 1
        while position < sourceLength && std.ascii.isDigit(source[position]) { position += 1 }
    }
    if position < sourceLength && (source[position] == 101 || source[position] == 69) {
        var after = position + 1
        if after < sourceLength && (source[after] == 43 || source[after] == 45) { after += 1 }
        if after < sourceLength && std.ascii.isDigit(source[after]) {
            value.*.integer = false
            position = after
            while position < sourceLength && std.ascii.isDigit(source[position]) { position += 1 }
        }
    }
    value.*.text = source[start..position]
    return value
}

// A growing list of values while an array or object is read.
const Gather = struct {
    items: [*]*Value
    keys: [*][]const u8
    count: usize
    capacity: usize
}

fn gather() -> Gather {
    return Gather.{
        .items = unsafe { @ptrFromInt([*]*Value, s.alloc(8 * 8)) },
        .keys = unsafe { @ptrFromInt([*][]const u8, s.alloc(8 * @sizeOf([]const u8))) },
        .count = 0,
        .capacity = 8,
    }
}

fn add(g: *Gather, key: []const u8, value: *Value) -> void {
    if g.*.count == g.*.capacity {
        const capacity = g.*.capacity * 2
        const items: [*]*Value = unsafe { @ptrFromInt([*]*Value, s.alloc(capacity * 8)) }
        const keys: [*][]const u8 = unsafe { @ptrFromInt([*][]const u8, s.alloc(capacity * @sizeOf([]const u8))) }
        var index: usize = 0
        while index < g.*.count {
            items[index] = g.*.items[index]
            keys[index] = g.*.keys[index]
            index += 1
        }
        g.*.items = items
        g.*.keys = keys
        g.*.capacity = capacity
    }
    g.*.items[g.*.count] = value
    g.*.keys[g.*.count] = key
    g.*.count += 1
}

fn literal(word: []const u8) -> bool {
    if position + word.length > sourceLength { return false }
    if !std.text.same(source[position..position + word.length], word) { return false }
    position += word.length
    return true
}

fn readValue(depth: usize) -> *Value {
    if depth > 900 { bad("maximum recursion depth exceeded") }
    skipSpace()
    if position >= sourceLength { bad("Expecting value") }
    const byte = source[position]
    if byte == 34 {
        const value = newValue(STRING)
        value.*.text = readString()
        return value
    }
    if byte == 123 {
        position += 1
        var g = gather()
        skipSpace()
        if position < sourceLength && source[position] == 125 {
            position += 1
        } else {
            while true {
                skipSpace()
                if position >= sourceLength || source[position] != 34 { bad("Expecting property name enclosed in double quotes") }
                const key = readString()
                skipSpace()
                if position >= sourceLength || source[position] != 58 { bad("Expecting ':' delimiter") }
                position += 1
                const item = readValue(depth + 1)
                var index: usize = 0
                var replaced = false
                while index < g.count {
                    if std.text.same(g.keys[index], key) {
                        g.items[index] = item
                        replaced = true
                    }
                    index += 1
                }
                if !replaced { add(&g, key, item) }
                skipSpace()
                if position < sourceLength && source[position] == 44 {
                    position += 1
                    continue
                }
                if position < sourceLength && source[position] == 125 {
                    position += 1
                    break
                }
                bad("Expecting ',' delimiter")
            }
        }
        const value = newValue(OBJECT)
        value.*.items = g.items
        value.*.keys = g.keys
        value.*.count = g.count
        return value
    }
    if byte == 91 {
        position += 1
        var g = gather()
        skipSpace()
        if position < sourceLength && source[position] == 93 {
            position += 1
        } else {
            while true {
                add(&g, "", readValue(depth + 1))
                skipSpace()
                if position < sourceLength && source[position] == 44 {
                    position += 1
                    continue
                }
                if position < sourceLength && source[position] == 93 {
                    position += 1
                    break
                }
                bad("Expecting ',' delimiter")
            }
        }
        const value = newValue(ARRAY)
        value.*.items = g.items
        value.*.keys = g.keys
        value.*.count = g.count
        return value
    }
    if byte == 45 || std.ascii.isDigit(byte) { return readNumber() }
    if literal("true") { return newValue(TRUE) }
    if literal("false") { return newValue(FALSE) }
    if literal("null") { return newValue(NULL) }
    bad("Expecting value")
    return newValue(NULL)
}

// The value of TEXT, which must be one JSON document (NAME is for errors).
pub fn parse(text: []const u8, name: []const u8) -> *Value {
    source = text.pointer
    sourceLength = text.length
    sourceName = name.pointer
    sourceNameLength = name.length
    position = 0
    const value = readValue(0)
    skipSpace()
    if position < sourceLength { bad("Extra data") }
    return value
}

// TEXT without its /* ... */ comments, wherever they are (as the
// generators' re.sub(r"\/\*.*?\*\/", "", text, re.DOTALL) has it).
pub fn withoutComments(text: []const u8) -> []const u8 {
    if !std.text.contains(text, "/*") { return text }
    const at = s.alloc(text.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < text.length {
        if text[index] == 47 && index + 1 < text.length && text[index + 1] == 42 {
            // The comment ends at the first "*/" after its opening.
            var end = index + 2
            var closed = false
            while end + 1 < text.length {
                if text[end] == 42 && text[end + 1] == 47 {
                    closed = true
                    break
                }
                end += 1
            }
            if closed {
                index = end + 2
                continue
            }
        }
        s.put8(at + length, text[index])
        length += 1
        index += 1
    }
    s.put8(at + length, 0)
    return s.bytes(at, length)
}

// ---------------------------------------------------------------------------
// Looking at values.

// The value at KEY of OBJECT, or null (OBJECT not being an object, or
// having no such key).
pub fn get(object: *Value, key: []const u8) -> ?*Value {
    if object.*.kind != OBJECT { return null }
    var index: usize = 0
    while index < object.*.count {
        if std.text.same(object.*.keys[index], key) { return object.*.items[index] }
        index += 1
    }
    return null
}

pub fn has(object: *Value, key: []const u8) -> bool { return get(object, key) != null }

// The string at KEY of OBJECT, or OTHERWISE when there is none (or not a string).
pub fn stringAt(object: *Value, key: []const u8, otherwise: []const u8) -> []const u8 {
    const value = get(object, key)
    if value == null { return otherwise }
    if value.?.*.kind != STRING { return otherwise }
    return value.?.*.text
}

// Whether the value at KEY of OBJECT is true (OTHERWISE when absent).
pub fn boolAt(object: *Value, key: []const u8, otherwise: bool) -> bool {
    const value = get(object, key)
    if value == null { return otherwise }
    return value.?.*.kind == TRUE
}

pub fn item(array: *Value, index: usize) -> *Value { return array.*.items[index] }

// The integer of a number written without fraction or exponent.
pub fn integerOf(value: *Value) -> i64 {
    var result: i64 = 0
    var index: usize = 0
    var negative = false
    if value.*.text.length > 0 && value.*.text[0] == 45 {
        negative = true
        index = 1
    }
    while index < value.*.text.length {
        result = result * 10 + @intCast(i64, value.*.text[index] - 48)
        index += 1
    }
    return if negative { -result } else { result }
}

// ---------------------------------------------------------------------------
// Writing (Python's json.dumps with its default settings).

fn hex4Text(code: u32) -> []const u8 {
    const digits = "0123456789abcdef"
    var text: [6]u8 = undefined
    text[0] = 92
    text[1] = 117
    text[2] = digits[@intCast(usize, (code >> 12) & 15)]
    text[3] = digits[@intCast(usize, (code >> 8) & 15)]
    text[4] = digits[@intCast(usize, (code >> 4) & 15)]
    text[5] = digits[@intCast(usize, code & 15)]
    return s.join(text[0..6], "")
}

pub fn quoted(text: []const u8) -> []const u8 {
    var parts = t.list()
    t.push(&parts, "\"")
    var start: usize = 0
    var index: usize = 0
    while index < text.length {
        const byte = text[index]
        var escape: []const u8 = ""
        var width: usize = 1
        if byte == 34 {
            escape = "\\\""
        } else if byte == 92 {
            escape = "\\\\"
        } else if byte == 10 {
            escape = "\\n"
        } else if byte == 13 {
            escape = "\\r"
        } else if byte == 9 {
            escape = "\\t"
        } else if byte == 8 {
            escape = "\\b"
        } else if byte == 12 {
            escape = "\\f"
        } else if byte < 32 {
            escape = hex4Text(@intCast(u32, byte))
        } else if byte >= 128 {
            // A UTF-8 sequence: its code point, as a surrogate pair above 0xFFFF.
            var code: u32 = 0
            if byte >= 240 && index + 3 < text.length {
                code = ((@intCast(u32, byte) & 7) << 18) | ((@intCast(u32, text[index + 1]) & 63) << 12) | ((@intCast(u32, text[index + 2]) & 63) << 6) | (@intCast(u32, text[index + 3]) & 63)
                width = 4
            } else if byte >= 224 && index + 2 < text.length {
                code = ((@intCast(u32, byte) & 15) << 12) | ((@intCast(u32, text[index + 1]) & 63) << 6) | (@intCast(u32, text[index + 2]) & 63)
                width = 3
            } else if byte >= 192 && index + 1 < text.length {
                code = ((@intCast(u32, byte) & 31) << 6) | (@intCast(u32, text[index + 1]) & 63)
                width = 2
            } else {
                code = @intCast(u32, byte)
            }
            if code >= 65536 {
                const rest = code - 65536
                escape = s.join(hex4Text(55296 + (rest >> 10)), hex4Text(56320 + (rest & 1023)))
            } else {
                escape = hex4Text(code)
            }
        }
        if escape.length > 0 {
            t.push(&parts, text[start..index])
            t.push(&parts, escape)
            index += width
            start = index
        } else {
            index += 1
        }
    }
    t.push(&parts, text[start..text.length])
    t.push(&parts, "\"")
    return t.joined(parts, "")
}

pub fn dumps(value: *Value) -> []const u8 {
    const kind = value.*.kind
    if kind == NULL { return "null" }
    if kind == TRUE { return "true" }
    if kind == FALSE { return "false" }
    if kind == NUMBER {
        if value.*.integer { return s.signedDecimal(integerOf(value)) }
        return value.*.text
    }
    if kind == STRING { return quoted(value.*.text) }
    var parts = t.list()
    var index: usize = 0
    while index < value.*.count {
        if kind == OBJECT {
            t.push(&parts, t.c3(quoted(value.*.keys[index]), ": ", dumps(value.*.items[index])))
        } else {
            t.push(&parts, dumps(value.*.items[index]))
        }
        index += 1
    }
    if kind == OBJECT { return t.c3("{", t.joined(parts, ", "), "}") }
    return t.c3("[", t.joined(parts, ", "), "]")
}

// json.dumps of the value at KEY of OBJECT, "null" when there is none.
pub fn dumpsAt(object: *Value, key: []const u8) -> []const u8 {
    const value = get(object, key)
    if value == null { return "null" }
    return dumps(value.?)
}
