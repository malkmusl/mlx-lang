// process-css-properties.py's GenerateStyleBuilderGenerated
// (StyleBuilderGenerated.cpp), GenerateStyleExtractorGenerated
// (StyleExtractorGenerated.cpp) and GenerateStylePropertyShorthandFunctions
// (StylePropertyShorthandFunctions.h and .cpp).
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")
const g = @import("./csspropsterms.mlx")
const m = @import("./csspropsmodel.mlx")
const x = @import("./csspropsgen.mlx")

// ---------------------------------------------------------------------------
// The coordinated value list properties' names.

fn coordinatedKind(p: *m.Property) -> usize {
    const name = p.*.name
    if s.contains(name, "animation-") { return 0 }
    if s.contains(name, "transition-") { return 1 }
    if s.contains(name, "background-") { return 2 }
    if s.contains(name, "mask-") { return 3 }
    if s.contains(name, "scroll-timeline-") { return 4 }
    if s.contains(name, "timeline-trigger-") { return 5 }
    if s.contains(name, "view-timeline-") { return 6 }
    s.fail(t.c3("Unrecognized coordinated list value property name: '", name, ""))
    return 0
}

const LIST_TYPES = "Animations Transitions BackgroundLayers MaskLayers ScrollTimelines TimelineTriggers ViewTimelines"

pub fn listTypeName(p: *m.Property) -> []const u8 { return c.splitByte(LIST_TYPES, 32).items[coordinatedKind(p)] }
pub fn listEnsure(p: *m.Property) -> []const u8 { return s.join("ensure", listTypeName(p)) }
pub fn listGet(p: *m.Property) -> []const u8 { return g.lowerFirst(listTypeName(p)) }
pub fn listSet(p: *m.Property) -> []const u8 { return s.join("set", listTypeName(p)) }
pub fn listInitial(p: *m.Property) -> []const u8 { return s.join("initial", listTypeName(p)) }

// ---------------------------------------------------------------------------
// StyleBuilderGenerated.cpp

fn convertedValue(p: *m.Property, extra: []const u8) -> []const u8 {
    return t.c4("toStyleFromCSSValue<", m.cgShown(p, "computed-style-type"), ">(builderState, value", s.join(extra, ")"))
}

fn fontSetter(p: *m.Property) -> []const u8 {
    const setter = m.cgText(p, "font-description-setter")
    const at = s.find(setter, "set")
    if at == setter.length { return setter }
    return t.c3(setter[0..at], "setFontDescription", setter[at + 3..setter.length])
}

fn explicitlySet(w: *c.Writer, p: *m.Property, authorOrigin: []const u8, allBorderRadius: []const u8, valueOnly: []const u8) -> void {
    const policy = m.cgText(p, "computed-style-has-explicitly-set-policy")
    const methods = m.cgText(p, "computed-style-name-for-methods")
    if s.same(policy, "all-author-origin") && authorOrigin.length > 0 { c.write(w, t.c5("builderState.style().setHasExplicitlySet", methods, "(", authorOrigin, ");")) }
    if s.same(policy, "all-border-radius") && allBorderRadius.length > 0 { c.write(w, t.c5("builderState.style().setHasExplicitlySet", methods, "(", allBorderRadius, ");")) }
    if s.same(policy, "value-only") && valueOnly.length > 0 { c.write(w, t.c5("builderState.style().setHasExplicitlySet", methods, "(", valueOnly, ");")) }
    if m.cgOn(p, "fast-path-inherited") { c.write(w, "builderState.style().setDisallowsFastPathInheritance();") }
}

fn initialSetter(w: *c.Writer, p: *m.Property) -> void {
    c.write(w, t.c3("static void applyInitial", p.*.id, "(BuilderState& builderState)"))
    c.write(w, "{")
    c.indent(w)
    const initial = m.cgText(p, "computed-style-initial")
    const setter = m.cgText(p, "computed-style-setter")
    if m.cgOn(p, "visited-link-color-support") {
        const function = s.join("Style::ComputedStyle::", initial)
        c.write(w, "if (builderState.applyPropertyToRegularStyle())")
        c.write(w, t.c5("    builderState.style().", setter, "(", function, "());"))
        c.write(w, "if (builderState.applyPropertyToVisitedLinkStyle())")
        c.write(w, t.c5("    builderState.style().setVisitedLink", m.cgText(p, "computed-style-name-for-methods"), "(", function, "());"))
    } else if m.cgOn(p, "coordinated-value-list-property") {
        c.write(w, t.c7("applyInitialCoordinatedValueListProperty<", m.idOrCascadeAliasId(p), ", &ComputedStyle::", listEnsure(p), ", ", listTypeName(p), ">(builderState);"))
    } else if m.cgOn(p, "font-property") {
        c.write(w, t.c5("builderState.", fontSetter(p), "(Style::ComputedStyle::", initial, "());"))
    } else {
        c.write(w, t.c5("builderState.style().", setter, "(Style::ComputedStyle::", initial, "());"))
    }
    explicitlySet(w, p, "builderState.isAuthorOrigin()", "false", "")
    c.outdent(w)
    c.write(w, "}")
}

fn inheritSetter(w: *c.Writer, p: *m.Property) -> void {
    c.write(w, t.c3("static void applyInherit", p.*.id, "(BuilderState& builderState)"))
    c.write(w, "{")
    c.indent(w)
    const getter = m.cgText(p, "computed-style-getter")
    const setter = m.cgText(p, "computed-style-setter")
    const methods = m.cgText(p, "computed-style-name-for-methods")
    if m.cgOn(p, "visited-link-color-support") {
        c.write(w, "if (builderState.applyPropertyToRegularStyle())")
        c.write(w, t.c5("    builderState.style().", setter, "(forwardInheritedValue(builderState.parentStyle().", getter, "()));"))
        c.write(w, "if (builderState.applyPropertyToVisitedLinkStyle())")
        c.write(w, t.c5("    builderState.style().setVisitedLink", methods, "(forwardInheritedValue(builderState.parentStyle().", getter, "()));"))
    } else if m.cgOn(p, "coordinated-value-list-property") {
        c.write(w, t.c9("applyInheritCoordinatedValueListProperty<", m.idOrCascadeAliasId(p), ", &ComputedStyle::", listEnsure(p), ", &ComputedStyle::", listGet(p), ", ", listTypeName(p), ">(builderState);"))
    } else if m.cgOn(p, "font-property") {
        c.write(w, t.c3("auto inheritedValue = builderState.parentStyle().", getter, "();"))
        c.write(w, t.c3("builderState.", fontSetter(p), "(WTF::move(inheritedValue));"))
    } else {
        c.write(w, t.c5("builderState.style().", setter, "(forwardInheritedValue(builderState.parentStyle().", getter, "()));"))
    }
    explicitlySet(w, p, "builderState.isAuthorOrigin()", t.c3("builderState.parentStyle().hasExplicitlySet", methods, "()"), "")
    c.outdent(w)
    c.write(w, "}")
}

fn valueSetter(w: *c.Writer, p: *m.Property) -> void {
    c.write(w, t.c3("static void applyValue", p.*.id, "(BuilderState& builderState, CSSValue& value)"))
    c.write(w, "{")
    c.indent(w)
    const font = m.named(m.styleProperties, "font").?
    if g.has(font.*.longhands, @intFromPtr(p)) && !t.contains(p.*.styleBuilderCustom, "Initial") && m.cgOn(p, "style-builder-requires-system-font-shorthand-check") {
        c.write(w, "if (CSSPropertyParserHelpers::isSystemFontShorthand(valueID(value))) {")
        c.indent(w)
        c.write(w, t.c3("applyInitial", p.*.id, "(builderState);"))
        c.write(w, "return;")
        c.outdent(w)
        c.write(w, "}")
    }
    const setter = m.cgText(p, "computed-style-setter")
    if m.cgOn(p, "visited-link-color-support") {
        c.write(w, "if (builderState.applyPropertyToRegularStyle())")
        c.write(w, t.c5("    builderState.style().", setter, "(", convertedValue(p, ", ForVisitedLink::No"), ");"))
        c.write(w, "if (builderState.applyPropertyToVisitedLinkStyle())")
        c.write(w, t.c5("    builderState.style().setVisitedLink", m.cgText(p, "computed-style-name-for-methods"), "(", convertedValue(p, ", ForVisitedLink::Yes"), ");"))
    } else if m.cgOn(p, "coordinated-value-list-property") {
        c.write(w, t.c9("applyValueCoordinatedValueListProperty<", m.idOrCascadeAliasId(p), ", &ComputedStyle::", listEnsure(p), ", WebCore::", m.cgShown(p, "coordinated-value-list-property-item-type"), ", ", listTypeName(p), ">(builderState, value);"))
    } else if m.cgOn(p, "font-property") {
        c.write(w, t.c5("builderState.", fontSetter(p), "(", convertedValue(p, ""), ");"))
    } else {
        c.write(w, t.c5("builderState.style().", setter, "(", convertedValue(p, ""), ");"))
    }
    explicitlySet(w, p, "builderState.isAuthorOrigin()", "true", "true")
    c.outdent(w)
    c.write(w, "}")
}

fn scopeFor(p: *m.Property, function: []const u8) -> []const u8 {
    if t.contains(p.*.styleBuilderCustom, function) { return "BuilderCustom" }
    return "BuilderFunctions"
}

pub fn builderGenerated() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.cppRequiredIncludes(w, "StyleBuilderGenerated.h")
    x.includesOf(w, "CSSProperty.h StyleBuilderCustom.h StyleBuilderState.h StyleComputedStyle+GettersInlines.h StyleComputedStyle+InitialInlines.h StyleComputedStyle+SettersInlines.h StyleKeyword+Mappings.h StylePropertyShorthand.h", "")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    c.write(w, "class BuilderFunctions {")
    c.write(w, "public:")
    c.indent(w)
    var index: usize = 0
    while index < m.styleAll.count {
        const p = m.propertyAt(m.styleAll, index)
        index += 1
        if p.*.hasLonghands || m.cgOn(p, "skip-style-builder") { continue }
        if m.isLogical(p) { s.fail(t.c3("Property '", p.*.name, "' is logical but doesn't have skip-style-builder.")) }
        if !t.contains(p.*.styleBuilderCustom, "Initial") { initialSetter(w, p) }
        if !t.contains(p.*.styleBuilderCustom, "Inherit") { inheritSetter(w, p) }
        if !t.contains(p.*.styleBuilderCustom, "Value") { valueSetter(w, p) }
    }
    c.outdent(w)
    c.write(w, "};")
    c.block(w, "
            void BuilderGenerated::applyProperty(CSSPropertyID id, BuilderState& builderState, CSSValue& value, ApplyValueType valueType)
            {
                switch (id) {
                case CSSPropertyID::CSSPropertyInvalid:
                    break;
                case CSSPropertyID::CSSPropertyCustom:
                    ASSERT_NOT_REACHED();
                    break;")
    c.indent(w)
    const unique = m.allUnique()
    index = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        index += 1
        c.write(w, t.c3("case ", m.fullId(p), ":"))
        c.indent(w)
        if p.*.isDescriptor {
            c.write(w, "break;")
            c.outdent(w)
            continue
        }
        if p.*.hasLonghands {
            c.write(w, "ASSERT(isShorthand(id));")
            c.write(w, "ASSERT_NOT_REACHED();")
        } else if !m.cgOn(p, "skip-style-builder") {
            c.write(w, "switch (valueType) {")
            c.write(w, "case ApplyValueType::Initial:")
            c.indent(w)
            c.write(w, t.c4(scopeFor(p, "Initial"), "::applyInitial", p.*.id, "(builderState);"))
            c.write(w, "break;")
            c.outdent(w)
            c.write(w, "case ApplyValueType::Inherit:")
            c.indent(w)
            c.write(w, t.c4(scopeFor(p, "Inherit"), "::applyInherit", p.*.id, "(builderState);"))
            c.write(w, "break;")
            c.outdent(w)
            c.write(w, "case ApplyValueType::Value:")
            c.indent(w)
            c.write(w, t.c4(scopeFor(p, "Value"), "::applyValue", p.*.id, "(builderState, value);"))
            c.write(w, "break;")
            c.outdent(w)
            c.write(w, "}")
        }
        c.write(w, "break;")
        c.outdent(w)
    }
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

// ---------------------------------------------------------------------------
// StyleExtractorGenerated.cpp

fn converter(value: []const u8) -> []const u8 { return t.c3("createCSSValue(extractorState.pool, extractorState.style, ", value, ")") }
fn serializer(value: []const u8) -> []const u8 { return t.c3("serializationForCSS(builder, context, extractorState.style, ", value, ")") }

fn styleGetterCall(p: *m.Property) -> []const u8 { return t.c3("extractorState.style.", m.cgText(p, "computed-style-getter"), "()") }

fn extractorFunctions(w: *c.Writer) -> void {
    c.write(w, "class ExtractorFunctions {")
    c.write(w, "public:")
    c.indent(w)
    const unique = m.allUnique()
    var index: usize = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        index += 1
        if p.*.isDescriptor || m.cgOn(p, "internal-only") || m.cgOn(p, "skip-style-extractor") || m.cgOn(p, "style-extractor-custom") || m.isLogical(p) { continue }
        const lower = g.lowerFirst(p.*.id)
        if p.*.hasLonghands {
            if !m.cgOn(p, "shorthand-style-extractor-pattern") { continue }
            const pattern = m.cgText(p, "shorthand-style-extractor-pattern")
            c.write(w, t.c3("static RefPtr<CSSValue> extract", p.*.id, "Shorthand(ExtractorState& extractorState)"))
            c.write(w, "{")
            c.indent(w)
            c.write(w, t.c5("return extract", pattern, "Shorthand(extractorState, ", lower, "Shorthand());"))
            c.outdent(w)
            c.write(w, "}")
            c.write(w, t.c3("static void extract", p.*.id, "ShorthandSerialization(ExtractorState& extractorState, StringBuilder& builder, const CSS::SerializationContext& context)"))
            c.write(w, "{")
            c.indent(w)
            c.write(w, t.c5("extract", pattern, "ShorthandSerialization(extractorState, builder, context, ", lower, "Shorthand());"))
            c.outdent(w)
            c.write(w, "}")
            continue
        }
        const methods = m.cgText(p, "computed-style-name-for-methods")
        c.write(w, t.c3("static RefPtr<CSSValue> extract", p.*.id, "(ExtractorState& extractorState)"))
        c.write(w, "{")
        c.indent(w)
        if m.cgOn(p, "visited-link-color-support") {
            c.write(w, "if (extractorState.allowVisitedStyle) {")
            c.indent(w)
            c.write(w, t.c3("return extractorState.pool.createColorValue(extractorState.style.visitedDependent", methods, "());"))
            c.outdent(w)
            c.write(w, "}")
            c.write(w, t.c3("return ", converter(styleGetterCall(p)), ";"))
        } else if m.cgOn(p, "coordinated-value-list-property") {
            c.write(w, t.c3("auto mapper = [](auto& extractorState, const auto& value, const std::optional<", listTypeName(p), "::value_type>&, const auto&) -> Ref<CSSValue> {"))
            c.indent(w)
            c.write(w, t.c3("return ", converter("value"), ";"))
            c.outdent(w)
            c.write(w, "};")
            c.write(w, t.c5("return extractCoordinatedValueListValue<", m.idOrCascadeAliasId(p), ">(extractorState, extractorState.style.", listGet(p), "(), mapper);"))
        } else {
            c.write(w, t.c3("return ", converter(styleGetterCall(p)), ";"))
        }
        c.outdent(w)
        c.write(w, "}")
        c.write(w, t.c3("static void extract", p.*.id, "Serialization(ExtractorState& extractorState, StringBuilder& builder, const CSS::SerializationContext& context)"))
        c.write(w, "{")
        c.indent(w)
        if m.cgOn(p, "visited-link-color-support") {
            c.write(w, "if (extractorState.allowVisitedStyle) {")
            c.indent(w)
            c.write(w, t.c3("builder.append(WebCore::serializationForCSS(extractorState.style.visitedDependent", methods, "()));"))
            c.write(w, "return;")
            c.outdent(w)
            c.write(w, "}")
            c.write(w, s.join(serializer(styleGetterCall(p)), ";"))
        } else if m.cgOn(p, "coordinated-value-list-property") {
            c.write(w, t.c3("auto mapper = [](auto& extractorState, auto& builder, const auto& context, const auto& value, const std::optional<", listTypeName(p), "::value_type>&, const auto&) {"))
            c.indent(w)
            c.write(w, s.join(serializer("value"), ";"))
            c.outdent(w)
            c.write(w, "};")
            c.write(w, t.c5("extractCoordinatedValueListSerialization<", m.idOrCascadeAliasId(p), ">(extractorState, builder, context, extractorState.style.", listGet(p), "(), mapper);"))
        } else {
            c.write(w, s.join(serializer(styleGetterCall(p)), ";"))
        }
        c.outdent(w)
        c.write(w, "}")
    }
    c.outdent(w)
    c.write(w, "};")
}

fn extractorScope(p: *m.Property) -> []const u8 {
    if m.cgOn(p, "style-extractor-custom") { return "ExtractorCustom" }
    if p.*.hasLonghands && !m.cgOn(p, "shorthand-style-extractor-pattern") { return "ExtractorCustom" }
    return "ExtractorFunctions"
}

fn extractDispatch(w: *c.Writer, serialization: bool) -> void {
    if serialization {
        c.block(w, "
            void ExtractorGenerated::extractValueSerialization(ExtractorState& extractorState, StringBuilder& builder, const CSS::SerializationContext& context, CSSPropertyID id)
            {
                switch (id) {
                case CSSPropertyID::CSSPropertyInvalid:
                    break;
                case CSSPropertyID::CSSPropertyCustom:
                    ASSERT_NOT_REACHED();
                    break;")
    } else {
        c.block(w, "
            RefPtr<CSSValue> ExtractorGenerated::extractValue(ExtractorState& extractorState, CSSPropertyID id)
            {
                switch (id) {
                case CSSPropertyID::CSSPropertyInvalid:
                    break;
                case CSSPropertyID::CSSPropertyCustom:
                    ASSERT_NOT_REACHED();
                    break;")
    }
    c.indent(w)
    const done = if serialization { "return;" } else { "return nullptr;" }
    const unique = m.allUnique()
    var index: usize = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        index += 1
        c.write(w, t.c3("case ", m.fullId(p), ":"))
        c.indent(w)
        if p.*.isDescriptor {
            c.write(w, "// Skipped - Descriptor-only property")
            c.write(w, done)
        } else if m.cgOn(p, "internal-only") {
            c.write(w, "// Skipped - Internal only")
            c.write(w, done)
        } else if m.cgOn(p, "skip-style-extractor") {
            c.write(w, "// Skipped - Not computable")
            c.write(w, done)
        } else if m.isLogical(p) && !m.cgOn(p, "style-extractor-custom") {
            c.write(w, "// Logical properties are handled by recursing using the direction resolved property.")
            if serialization {
                c.write(w, "extractValueSerialization(extractorState, builder, context, CSSProperty::resolveDirectionAwareProperty(id, extractorState.style.writingMode()));")
                c.write(w, "return;")
            } else {
                c.write(w, "return extractValue(extractorState, CSSProperty::resolveDirectionAwareProperty(id, extractorState.style.writingMode()));")
            }
        } else if p.*.hasLonghands {
            c.write(w, "ASSERT(isShorthand(id));")
            if serialization {
                c.write(w, t.c4(extractorScope(p), "::extract", p.*.id, "ShorthandSerialization(extractorState, builder, context);"))
                c.write(w, "return;")
            } else {
                c.write(w, t.c5("return ", extractorScope(p), "::extract", p.*.id, "Shorthand(extractorState);"))
            }
        } else {
            if serialization {
                c.write(w, t.c4(extractorScope(p), "::extract", p.*.id, "Serialization(extractorState, builder, context);"))
                c.write(w, "return;")
            } else {
                c.write(w, t.c5("return ", extractorScope(p), "::extract", p.*.id, "(extractorState);"))
            }
        }
        c.outdent(w)
    }
    c.write(w, "}")
    c.write(w, "ASSERT_NOT_REACHED();")
    if !serialization { c.write(w, "return nullptr;") }
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

pub fn extractorGenerated() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.cppRequiredIncludes(w, "StyleExtractorGenerated.h")
    x.includesOf(w, "CSSProperty.h ColorSerialization.h StyleComputedStyle.h StyleExtractorCustom.h StyleExtractorState.h StyleKeyword+Mappings.h StylePropertyShorthand.h", "")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    extractorFunctions(w)
    extractDispatch(w, false)
    extractDispatch(w, true)
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

// ---------------------------------------------------------------------------
// StylePropertyShorthandFunctions.h and .cpp

pub fn shorthandFunctionsHeader() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.pragmaOnce(w)
    x.openNamespace(w, "WebCore")
    x.forwardDeclarations(w, t.list(), x.one("StylePropertyShorthand"))
    const shorthands = m.allShorthands()
    var index: usize = 0
    while index < shorthands.count {
        c.write(w, t.c3("StylePropertyShorthand ", g.lowerFirst(m.propertyAt(shorthands, index).*.id), "Shorthand();"))
        index += 1
    }
    c.newline(w)
    x.closeNamespace(w, "WebCore")
    return c.written(w)
}

// For the preferred order of shorthands: the longhand count of each shorthand.
var countKeys: g.Refs = undefined
var countValues: g.Refs = undefined

fn longhandCount(p: *m.Property) -> usize {
    var index: usize = 0
    while index < countKeys.count {
        if countKeys.items[index] == @intFromPtr(p) { return countValues.items[index] }
        index += 1
    }
    return 0
}

// preferred_order_for_shorthands: (-count, prefixed, not -webkit-, name).
fn comparePreferred(a: *m.Property, b: *m.Property) -> i32 {
    const countA = longhandCount(a)
    const countB = longhandCount(b)
    if countA != countB { return if countA > countB { -1 } else { 1 } }
    const prefixedA = s.startsWith(a.*.name, "-")
    const prefixedB = s.startsWith(b.*.name, "-")
    if prefixedA != prefixedB { return if prefixedB { -1 } else { 1 } }
    const notWebKitA = !s.startsWith(a.*.name, "-webkit-")
    const notWebKitB = !s.startsWith(b.*.name, "-webkit-")
    if notWebKitA != notWebKitB { return if notWebKitB { -1 } else { 1 } }
    return m.compareName(a, b)
}

pub fn shorthandFunctions() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.cppRequiredIncludes(w, "StylePropertyShorthandFunctions.h")
    x.includesOf(w, "StylePropertyShorthand.h", "")
    x.openNamespace(w, "WebCore")
    // Longhands to their shorthands (keys in order of first use).
    var longhandKeys = g.refs()
    var longhandShorthands = g.refs()
    countKeys = g.refs()
    countValues = g.refs()
    const shorthands = m.allShorthands()
    const nonShorthands = m.allNonShorthands()
    var index: usize = 0
    while index < shorthands.count {
        const p = m.propertyAt(shorthands, index)
        index += 1
        const lower = g.lowerFirst(p.*.id)
        c.write(w, t.c3("StylePropertyShorthand ", lower, "Shorthand()"))
        c.write(w, "{")
        c.indent(w)
        c.write(w, t.c3("static const CSSPropertyID ", lower, "Properties[] = {"))
        c.indent(w)
        var count: usize = 0
        var at: usize = 0
        while at < p.*.longhands.count {
            const longhand = m.propertyAt(p.*.longhands, at)
            at += 1
            var members = g.refs()
            if s.same(longhand.*.name, "all") {
                var k: usize = 0
                while k < nonShorthands.count {
                    const inner = m.propertyAt(nonShorthands, k)
                    if !s.same(inner.*.name, "direction") && !s.same(inner.*.name, "unicode-bidi") { g.push(&members, nonShorthands.items[k]) }
                    k += 1
                }
            } else {
                g.push(&members, @intFromPtr(longhand))
            }
            var k: usize = 0
            while k < members.count {
                const member = members.items[k]
                var slot: usize = 0
                while slot < longhandKeys.count && longhandKeys.items[slot] != member { slot += 1 }
                if slot == longhandKeys.count {
                    g.push(&longhandKeys, member)
                    const list: *g.Refs = unsafe { @ptrFromInt(*g.Refs, s.alloc(@sizeOf(g.Refs))) }
                    list.* = g.refs()
                    g.push(&longhandShorthands, @intFromPtr(list))
                }
                g.push(m.refsOf(longhandShorthands.items[slot]), @intFromPtr(p))
                count += 1
                c.write(w, s.join(m.fullId(m.propertyOf(member)), ","))
                k += 1
            }
        }
        g.push(&countKeys, @intFromPtr(p))
        g.push(&countValues, count)
        c.outdent(w)
        c.write(w, "};")
        c.write(w, t.c5("return StylePropertyShorthand(", m.fullId(p), ", std::span { ", lower, "Properties });"))
        c.outdent(w)
        c.write(w, "}")
        c.newline(w)
    }
    var mappings = t.list()
    index = 0
    while index < shorthands.count {
        t.push(&mappings, t.c3("return ", g.lowerFirst(m.propertyAt(shorthands, index).*.id), "Shorthand();"))
        index += 1
    }
    x.switchFunction(w, "StylePropertyShorthand shorthandForProperty(CSSPropertyID id)", x.idsOf(shorthands), mappings, "return { };", "", "")
    c.write(w, "StylePropertyShorthandVector matchingShorthandsForLonghand(CSSPropertyID id)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "switch (id) {")
    // The longhands by name; each one's vector of shorthands.
    var order = g.refs()
    index = 0
    while index < longhandKeys.count {
        g.push(&order, index)
        index += 1
    }
    var byName = g.refs()
    index = 0
    while index < longhandKeys.count {
        g.push(&byName, longhandKeys.items[index])
        index += 1
    }
    byName = m.sorted(byName, m.compareName)
    var vectors = t.list()
    var vectorLonghands = g.refs()
    index = 0
    while index < byName.count {
        const longhand = byName.items[index]
        index += 1
        var slot: usize = 0
        while longhandKeys.items[slot] != longhand { slot += 1 }
        const preferred = m.sorted(m.refsOf(longhandShorthands.items[slot]).*, comparePreferred)
        var calls = t.list()
        var at: usize = 0
        while at < preferred.count {
            t.push(&calls, s.join(g.lowerFirst(m.propertyAt(preferred, at).*.id), "Shorthand()"))
            at += 1
        }
        const vector = t.c3("StylePropertyShorthandVector{", t.joined(calls, ", "), "}")
        var v: usize = 0
        while v < vectors.count && !s.same(vectors.items[v], vector) { v += 1 }
        if v == vectors.count {
            t.push(&vectors, vector)
            const list: *g.Refs = unsafe { @ptrFromInt(*g.Refs, s.alloc(@sizeOf(g.Refs))) }
            list.* = g.refs()
            g.push(&vectorLonghands, @intFromPtr(list))
        }
        g.push(m.refsOf(vectorLonghands.items[v]), longhand)
    }
    // The vectors sorted (their longhands alongside).
    var sortedVectors = t.list()
    t.extend(&sortedVectors, vectors)
    t.sort(&sortedVectors)
    index = 0
    while index < sortedVectors.count {
        var v: usize = 0
        while !s.same(vectors.items[v], sortedVectors.items[index]) { v += 1 }
        const longhands = m.refsOf(vectorLonghands.items[v]).*
        var at: usize = 0
        while at < longhands.count {
            c.write(w, t.c3("case ", m.fullId(m.propertyAt(longhands, at)), ":"))
            at += 1
        }
        c.indent(w)
        c.write(w, t.c3("return ", sortedVectors.items[index], ";"))
        c.outdent(w)
        index += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
    x.closeNamespace(w, "WebCore")
    return c.written(w)
}
