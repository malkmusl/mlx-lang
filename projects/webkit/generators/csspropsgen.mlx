// What process-css-properties.py's generators share (its
// GenerationContext): the heading, includes, namespaces, forward
// declarations, and the switch functions and bit sets over property IDs.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")
const g = @import("./csspropsterms.mlx")
const m = @import("./csspropsmodel.mlx")

pub fn heading(w: *c.Writer) -> void {
    c.write(w, "// This file is automatically generated from CSSProperties.json by the process-css-properties.py script. Do not edit it.")
    c.newline(w)
}

pub fn pragmaOnce(w: *c.Writer) -> void {
    c.write(w, "#pragma once")
    c.newline(w)
}

// The namespaces opened; "" for an anonymous one.
pub fn openNamespaces(w: *c.Writer, namespaces: t.List) -> void {
    var index: usize = 0
    while index < namespaces.count {
        if namespaces.items[index].length == 0 {
            c.write(w, "namespace {")
        } else {
            c.write(w, t.c3("namespace ", namespaces.items[index], " {"))
        }
        index += 1
    }
    c.newline(w)
}

pub fn closeNamespaces(w: *c.Writer, namespaces: t.List) -> void {
    var index: usize = 0
    while index < namespaces.count {
        if namespaces.items[index].length == 0 {
            c.write(w, "} // namespace (anonymous)")
        } else {
            c.write(w, s.join("} // namespace ", namespaces.items[index]))
        }
        index += 1
    }
    c.newline(w)
}

pub fn one(text: []const u8) -> t.List {
    var l = t.list()
    t.push(&l, text)
    return l
}

pub fn words(text: []const u8) -> t.List {
    if text.length == 0 { return t.list() }
    return c.splitByte(text, 32)
}

pub fn openNamespace(w: *c.Writer, namespace: []const u8) -> void { openNamespaces(w, one(namespace)) }
pub fn closeNamespace(w: *c.Writer, namespace: []const u8) -> void { closeNamespaces(w, one(namespace)) }

pub fn usingNamespaces(w: *c.Writer, namespaces: t.List) -> void {
    var index: usize = 0
    while index < namespaces.count {
        c.write(w, t.c3("using namespace ", namespaces.items[index], ";"))
        index += 1
    }
    c.newline(w)
}

// The headers sorted, then the system headers sorted.
pub fn includes(w: *c.Writer, headers: t.List, systemHeaders: t.List) -> void {
    var sortedHeaders = t.list()
    t.extend(&sortedHeaders, headers)
    t.sort(&sortedHeaders)
    var index: usize = 0
    while index < sortedHeaders.count {
        c.write(w, t.c3("#include \"", sortedHeaders.items[index], "\""))
        index += 1
    }
    var sortedSystem = t.list()
    t.extend(&sortedSystem, systemHeaders)
    t.sort(&sortedSystem)
    index = 0
    while index < sortedSystem.count {
        c.write(w, s.join("#include ", sortedSystem.items[index]))
        index += 1
    }
    c.newline(w)
}

// Lists of headers given as text, separated by spaces.
pub fn includesOf(w: *c.Writer, headers: []const u8, systemHeaders: []const u8) -> void { includes(w, words(headers), words(systemHeaders)) }

pub fn cppRequiredIncludes(w: *c.Writer, header: []const u8) -> void {
    c.write(w, "#include \"config.h\"")
    includes(w, one(header), t.list())
}

pub fn forwardDeclarations(w: *c.Writer, structs: t.List, classes: t.List) -> void {
    var sortedStructs = t.list()
    t.extend(&sortedStructs, structs)
    t.sort(&sortedStructs)
    var index: usize = 0
    while index < sortedStructs.count {
        c.write(w, t.c3("struct ", sortedStructs.items[index], ";"))
        index += 1
    }
    var sortedClasses = t.list()
    t.extend(&sortedClasses, classes)
    t.sort(&sortedClasses)
    index = 0
    while index < sortedClasses.count {
        c.write(w, t.c3("class ", sortedClasses.items[index], ";"))
        index += 1
    }
    c.newline(w)
}

// generate_function_declaration.
pub fn functionDeclaration(w: *c.Writer, specifiers: t.List, returnType: []const u8, name: []const u8, argumentTypes: t.List, qualifiers: t.List) -> void {
    var b = c.buf()
    var index: usize = 0
    while index < specifiers.count {
        c.add(&b, specifiers.items[index])
        c.add(&b, " ")
        index += 1
    }
    c.add(&b, returnType)
    c.add(&b, " ")
    c.add(&b, name)
    c.add(&b, "(")
    c.add(&b, t.joined(argumentTypes, ", "))
    c.add(&b, ")")
    index = 0
    while index < qualifiers.count {
        c.add(&b, " ")
        c.add(&b, qualifiers.items[index])
        index += 1
    }
    c.add(&b, ";")
    c.write(w, c.contents(&b))
}

// generate_property_id_switch_function: a case for each of IDS returning
// the matching item of MAPPINGS.
pub fn switchFunction(w: *c.Writer, signature: []const u8, ids: t.List, mappings: t.List, otherwise: []const u8, prologue: []const u8, epilogue: []const u8) -> void {
    c.write(w, signature)
    c.write(w, "{")
    c.indent(w)
    if prologue.length > 0 { c.write(w, prologue) }
    c.write(w, "switch (id) {")
    var index: usize = 0
    while index < ids.count {
        c.write(w, t.c3("case ", ids.items[index], ":"))
        c.indent(w)
        c.write(w, mappings.items[index])
        c.outdent(w)
        index += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, otherwise)
    c.outdent(w)
    c.write(w, "}")
    if epilogue.length > 0 { c.write(w, epilogue) }
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

pub fn switchFunctionBool(w: *c.Writer, signature: []const u8, ids: t.List) -> void {
    c.write(w, signature)
    c.write(w, "{")
    c.indent(w)
    c.write(w, "switch (id) {")
    var index: usize = 0
    while index < ids.count {
        c.write(w, t.c3("case ", ids.items[index], ":"))
        index += 1
    }
    c.indent(w)
    c.write(w, "return true;")
    c.outdent(w)
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return false;")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

pub fn bitSet(w: *c.Writer, name: []const u8, ids: t.List) -> void {
    c.write(w, t.c3("const WTF::BitSet<cssPropertyIDEnumValueCount> ", name, " = ([]() -> WTF::BitSet<cssPropertyIDEnumValueCount> {"))
    c.indent(w)
    c.write(w, "WTF::BitSet<cssPropertyIDEnumValueCount> result;")
    var index: usize = 0
    while index < ids.count {
        c.write(w, t.c3("result.set(", ids.items[index], ");"))
        index += 1
    }
    c.write(w, "return result;")
    c.outdent(w)
    c.write(w, "})();")
    c.newline(w)
}

// The full IDs of the properties of L.
pub fn idsOf(l: g.Refs) -> t.List {
    var result = t.list()
    var index: usize = 0
    while index < l.count {
        t.push(&result, m.fullId(m.propertyAt(l, index)))
        index += 1
    }
    return result
}

// The properties of L with codegen attribute KEY set (truthy).
pub fn withCg(l: g.Refs, key: []const u8) -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < l.count {
        if m.cgOn(m.propertyAt(l, index), key) { g.push(&result, l.items[index]) }
        index += 1
    }
    return result
}

pub fn quoteList(l: t.List, mark: []const u8, suffix: []const u8) -> t.List {
    var result = t.list()
    var index: usize = 0
    while index < l.count {
        t.push(&result, t.c4(mark, l.items[index], mark, suffix))
        index += 1
    }
    return result
}
