// The frontend dispatchers of the inspector protocol's C++ bindings, as
// WebKit's codegen makes them (generate_cpp_frontend_dispatcher_header.py
// and _implementation.py): for each domain with events, a class whose
// methods send them to the frontend as JSON messages.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const m = @import("./inspectormodel.mlx")

const ALL_CPP_FRAMEWORKS = "JavaScriptCore WebKit WebDriverBidi"

fn classAndExportMacro(p: *m.Protocol) -> []const u8 {
    if p.*.framework.exportMacro.length > 0 { return s.join("class ", p.*.framework.exportMacro) }
    return "class"
}

fn optionalName(member: *m.Member) -> []const u8 {
    if member.*.optional { return s.join("opt_", member.*.name) }
    return member.*.name
}

// The domains generated that have events.
fn hasEvents(p: *m.Protocol, index: usize) -> bool { return m.generated(p, index) && p.*.domains[index].*.eventCount > 0 }

// ---------------------------------------------------------------------------
// InspectorFrontendDispatchers.h

fn anonymousEnumForParameter(p: *m.Protocol, parameter: *m.Member, event: *m.Event) -> []const u8 {
    const name = m.ucfirst(parameter.*.name)
    var lines = t.list()
    t.push(&lines, t.c5("        // Named after parameter '", parameter.*.name, "' while generating command/event ", event.*.name, "."))
    t.push(&lines, t.c3("        enum class ", name, " {"))
    var index: usize = 0
    while index < parameter.*.ty.*.values.count {
        const value = parameter.*.ty.*.values.items[index]
        t.push(&lines, t.c5("            ", m.stylizedEnumName(value), " = ", m.encodingFor(p, value), ","))
        index += 1
    }
    t.push(&lines, s.join("        }; // enum class ", name))
    return t.joined(lines, "\n")
}

fn dispatcherDeclarationForEvent(p: *m.Protocol, event: *m.Event, usedEnumNames: *t.List) -> []const u8 {
    var formalParameters = t.list()
    var lines = t.list()
    var index: usize = 0
    while index < event.*.parameterCount {
        const parameter = &event.*.parameters[index]
        t.push(&formalParameters, t.c3(m.cppType(parameter.*.ty, parameter.*.optional, m.RETURN_ARGUMENT), " ", optionalName(parameter)))
        if m.isAnonymousEnum(parameter.*.ty) && !t.contains(usedEnumNames.*, parameter.*.name) {
            t.push(&lines, anonymousEnumForParameter(p, parameter, event))
            t.push(usedEnumNames, parameter.*.name)
        }
        index += 1
    }
    t.push(&lines, t.c5("    void ", event.*.name, "(", t.joined(formalParameters, ", "), ");"))
    return m.guarded(event.*.condition, t.joined(lines, "\n"))
}

fn dispatcherDeclarationsForDomain(p: *m.Protocol, domain: *m.Domain) -> []const u8 {
    var usedEnumNames = t.list()
    var declarations = t.list()
    var index: usize = 0
    while index < domain.*.eventCount {
        t.push(&declarations, dispatcherDeclarationForEvent(p, &domain.*.events[index], &usedEnumNames))
        index += 1
    }
    const name = domain.*.name
    var text = t.list()
    t.push(&text, t.c5(classAndExportMacro(p), " ", name, "FrontendDispatcher {\n    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(", name))
    t.push(&text, t.c5("FrontendDispatcher);\npublic:\n    ", name, "FrontendDispatcher(FrontendRouter&);\n    ~", name, "FrontendDispatcher();\n"))
    t.push(&text, t.c5("    WTF_MAKE_NONCOPYABLE(", name, "FrontendDispatcher);\n    WTF_MAKE_NONMOVABLE(", name, "FrontendDispatcher);\n"))
    t.push(&text, t.joined(declarations, "\n"))
    t.push(&text, "\nprivate:\n    const CheckedRef<FrontendRouter> m_frontendRouter;\n};")
    return m.guarded(domain.*.condition, t.joined(text, ""))
}

pub fn generateHeader(p: *m.Protocol) -> []const u8 {
    var includes = t.list()
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, p.*.framework.name, s.join(p.*.framework.cppProtocolGroup, "ProtocolObjects.h"), true)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/CheckedRef.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/Noncopyable.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/Nonmovable.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/JSONValues.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/text/WTFString.h", false)
    t.sort(&includes)

    var sections = t.list()
    t.push(&sections, m.license(p))
    t.push(&sections, t.c3("#pragma once\n\n", t.joined(includes, "\n"), "\n\nnamespace Inspector {\n\nclass FrontendRouter;"))
    var index: usize = 0
    while index < p.*.domainCount {
        if hasEvents(p, index) { t.push(&sections, dispatcherDeclarationsForDomain(p, p.*.domains[index])) }
        index += 1
    }
    t.push(&sections, "} // namespace Inspector")
    return t.joined(sections, "\n\n")
}

// ---------------------------------------------------------------------------
// InspectorFrontendDispatchers.cpp

fn dispatcherImplementationForEvent(p: *m.Protocol, event: *m.Event, domain: *m.Domain) -> []const u8 {
    var assignments = t.list()
    var formalParameters = t.list()
    var index: usize = 0
    while index < event.*.parameterCount {
        const parameter = &event.*.parameters[index]
        const name = optionalName(parameter)
        const ty = m.dispatched(parameter.*.ty)
        const value = m.setterValue(p, ty, parameter.*.optional, name)
        const setter = m.cppSetterMethod(ty)
        if parameter.*.optional {
            t.push(&assignments, t.c3("    if (!!", name, ")"))
            t.push(&assignments, t.c7("        protocol_paramsObject->", setter, "(\"", parameter.*.name, "\"_s, ", value, ");"))
        } else {
            t.push(&assignments, t.c7("    protocol_paramsObject->", setter, "(\"", parameter.*.name, "\"_s, ", value, ");"))
        }
        t.push(&formalParameters, t.c3(m.cppType(ty, parameter.*.optional, m.RETURN_ARGUMENT), " ", name))
        index += 1
    }
    var lines = t.list()
    t.push(&lines, t.c7("void ", domain.*.name, "FrontendDispatcher::", event.*.name, "(", t.joined(formalParameters, ", "), ")"))
    t.push(&lines, "{")
    t.push(&lines, "    auto protocol_jsonMessage = JSON::Object::create();")
    t.push(&lines, t.c5("    protocol_jsonMessage->setString(\"method\"_s, \"", domain.*.exposedAs, ".", event.*.name, "\"_s);"))
    if assignments.count > 0 {
        t.push(&lines, "    auto protocol_paramsObject = JSON::Object::create();")
        t.extend(&lines, assignments)
        t.push(&lines, "    protocol_jsonMessage->setObject(\"params\"_s, WTF::move(protocol_paramsObject));")
    }
    t.push(&lines, "")
    t.push(&lines, "    m_frontendRouter->sendEvent(protocol_jsonMessage->toJSONString());")
    t.push(&lines, "}")
    return m.guarded(event.*.condition, t.joined(lines, "\n"))
}

fn dispatcherImplementationsForDomain(p: *m.Protocol, domain: *m.Domain) -> []const u8 {
    const name = domain.*.name
    var implementations = t.list()
    t.push(&implementations, t.c5(name, "FrontendDispatcher::", name, "FrontendDispatcher(FrontendRouter& frontendRouter) : m_frontendRouter(frontendRouter) { }", ""))
    t.push(&implementations, t.c5(name, "FrontendDispatcher::~", name, "FrontendDispatcher() = default;", ""))
    var index: usize = 0
    while index < domain.*.eventCount {
        t.push(&implementations, dispatcherImplementationForEvent(p, &domain.*.events[index], domain))
        index += 1
    }
    return m.guarded(domain.*.condition, t.joined(implementations, "\n\n"))
}

pub fn generateImplementation(p: *m.Protocol) -> []const u8 {
    var includes = t.list()
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "JavaScriptCore", "inspector/InspectorFrontendRouter.h", false)
    t.sort(&includes)
    var sections = t.list()
    t.push(&sections, m.license(p))
    t.push(&sections, t.c5("#include \"config.h\"\n#include \"", p.*.framework.cppProtocolGroup, "FrontendDispatchers.h\"\n\n", t.joined(includes, "\n"), "\n\nnamespace Inspector {"))
    var index: usize = 0
    while index < p.*.domainCount {
        if hasEvents(p, index) { t.push(&sections, dispatcherImplementationsForDomain(p, p.*.domains[index])) }
        index += 1
    }
    t.push(&sections, "} // namespace Inspector\n")
    return t.joined(sections, "\n\n")
}
