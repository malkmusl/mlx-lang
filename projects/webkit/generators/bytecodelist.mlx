// A reader for JavaScriptCore's bytecode/BytecodeList.rb: the Ruby DSL
// that generator/main.rb evaluates. It is not a Ruby interpreter; it
// knows the calls the list makes, as generator/DSL.rb defines them:
//
//     types [ :Name, ... ]              types used by name later
//     templates [ :Name, ... ]          types taking others: Name[Type]
//     begin_section :Name, key: value, ...
//     op :name, args: { ... }, metadata: { ... }, ...
//     op_group :Name, [ :name, ... ], args: { ... }, ...
//     end_section :Name
//
// and the values they take: symbols, strings, nil, true and false, types
// (Name, Template[Type, ...], Type.* for a pointer), hashes with
// `key:` labels and arrays. Newlines do not matter: a call's arguments
// go on while a comma follows one. What it reads becomes sections of
// opcodes, each section ordered at its end as DSL.rb orders it, every
// opcode numbered in the order the sections end.
const std = @import("std")
const s = @import("./support.mlx")

pub const NONE: usize = 18446744073709551615

// What a value is.
pub const SYMBOL: u8 = 1
pub const STRING: u8 = 2
pub const NIL: u8 = 3
pub const TRUE: u8 = 4
pub const FALSE: u8 = 5
pub const TYPE: u8 = 6
pub const HASH: u8 = 7
pub const ARRAY: u8 = 8
pub const INTEGER: u8 = 9

pub const Value = struct {
    kind: u8
    // A symbol's name, a string, a type's name as C++ writes it.
    text: []const u8
    // The key it is under, in a hash ("" elsewhere).
    key: []const u8
    // A hash's or an array's items: kids[first .. first + count].
    first: usize
    count: usize
}

pub const Section = struct {
    name: []const u8
    // Its options (a hash).
    config: usize
    // Its opcodes, in their final order: order[first .. first + count].
    first: usize
    count: usize
}

pub const Opcode = struct {
    section: usize
    // As given, without the section's op_prefix.
    name: []const u8
    // Hashes, or NONE when not given (or nil).
    args: usize
    metadata: usize
    initializers: usize
    tmps: usize
    checkpoints: usize
    // Its number, in the order the opcodes were ordered.
    id: usize
}

const MAX_VALUES: usize = 262144
const MAX_OPCODES: usize = 4096
const MAX_SECTIONS: usize = 64
const MAX_NAMES: usize = 1024
const MAX_ITEMS: usize = 512

var values: [*]Value = undefined
var valueCount: usize = 0
var kids: [*]usize = undefined
var kidCount: usize = 0
var opcodes: [*]Opcode = undefined
var opcodeCount: usize = 0
var sections: [*]Section = undefined
var sectionCount: usize = 0
// Opcodes by section, each section in its final order.
var order: [*]usize = undefined
var orderCount: usize = 0
// The opcodes of the section being read, as they came.
var pending: [*]usize = undefined
var pendingCount: usize = 0
var inSection: bool = false
var currentSection: usize = 0

// The types and templates named so far (with a flag: a template).
var typeNames: [*][]const u8 = undefined
var typeIsTemplate: [*]bool = undefined
var typeCount: usize = 0

// ---------------------------------------------------------------------------
// What was read.

pub fn value(index: usize) -> Value { return values[index] }
pub fn item(index: usize, at: usize) -> usize { return kids[values[index].first + at] }
pub fn sectionTotal() -> usize { return sectionCount }
pub fn section(index: usize) -> Section { return sections[index] }
pub fn opcode(index: usize) -> Opcode { return opcodes[index] }
// The opcode at AT in section INDEX's order.
pub fn sectionOpcode(index: usize, at: usize) -> usize { return order[sections[index].first + at] }
pub fn opcodeTotal() -> usize { return orderCount }

// The value under KEY in hash INDEX, or NONE (as for a nil value).
pub fn lookUp(index: usize, key: []const u8) -> usize {
    if index == NONE { return NONE }
    var at: usize = 0
    while at < values[index].count {
        const entry = item(index, at)
        if s.same(values[entry].key, key) {
            if values[entry].kind == NIL { return NONE }
            return entry
        }
        at += 1
    }
    return NONE
}

// Whether the section's option KEY is there and neither nil nor false.
pub fn option(index: usize, key: []const u8) -> bool {
    const found = lookUp(sections[index].config, key)
    return found != NONE && values[found].kind != FALSE
}

// A value as Ruby's to_s writes it: a symbol's name, a string, a type.
pub fn text(index: usize) -> []const u8 {
    if index == NONE { return "" }
    const kind = values[index].kind
    if kind == TRUE { return "true" }
    if kind == FALSE { return "false" }
    return values[index].text
}

pub fn optionText(index: usize, key: []const u8) -> []const u8 { return text(lookUp(sections[index].config, key)) }

// ---------------------------------------------------------------------------
// Tokens.

const T_END: u8 = 0
const T_IDENT: u8 = 1
const T_LABEL: u8 = 2
const T_SYMBOL: u8 = 3
const T_STRING: u8 = 4
const T_INTEGER: u8 = 5
const T_COMMA: u8 = 6
const T_LBRACKET: u8 = 7
const T_RBRACKET: u8 = 8
const T_LBRACE: u8 = 9
const T_RBRACE: u8 = 10
const T_DOTSTAR: u8 = 11
const T_OTHER: u8 = 12

var source: [*]const u8 = undefined
var sourceLength: usize = 0
var sourcePath: [*]const u8 = undefined
var sourcePathLength: usize = 0
var position: usize = 0
// The token at hand: its kind and where its text is.
var token: u8 = T_END
var tokenStart: usize = 0
var tokenEnd: usize = 0

fn tokenText() -> []const u8 { return source[tokenStart..tokenEnd] }

fn isIdentifier(byte: u8) -> bool { return s.isWord(byte) }

fn byteAt(at: usize) -> u8 { return if at < sourceLength { source[at] } else { 0 } }

fn lineOf(at: usize) -> u64 {
    var line: u64 = 1
    var index: usize = 0
    while index < at && index < sourceLength {
        if source[index] == 10 { line += 1 }
        index += 1
    }
    return line
}

// Stops the run, saying where in the list.
pub fn complain(message: []const u8) -> void {
    s.fail(s.join(s.join3(sourcePath[0..sourcePathLength], ":", s.decimal(lineOf(tokenStart))), s.join(": ", message)))
}

fn advance() -> void {
    // Space, newlines and comments.
    while position < sourceLength {
        const byte = source[position]
        if s.isSpace(byte) {
            position += 1
        } else if byte == 35 {
            while position < sourceLength && source[position] != 10 { position += 1 }
        } else {
            break
        }
    }
    tokenStart = position
    if position >= sourceLength {
        token = T_END
        tokenEnd = position
        return
    }
    const byte = source[position]
    if isIdentifier(byte) && !s.isDigit(byte) {
        while position < sourceLength && isIdentifier(source[position]) { position += 1 }
        tokenEnd = position
        token = T_IDENT
        // `name:` and `name?:` are a hash's keys (but `A::B` is not).
        var after = position
        if byteAt(after) == 63 || byteAt(after) == 33 { after += 1 }
        if byteAt(after) == 58 && byteAt(after + 1) != 58 {
            token = T_LABEL
            tokenEnd = after
            position = after + 1
        }
        return
    }
    if s.isDigit(byte) {
        while position < sourceLength && s.isDigit(source[position]) { position += 1 }
        tokenEnd = position
        token = T_INTEGER
        return
    }
    if byte == 58 && isIdentifier(byteAt(position + 1)) {
        position += 1
        tokenStart = position
        while position < sourceLength && isIdentifier(source[position]) { position += 1 }
        if byteAt(position) == 63 || byteAt(position) == 33 { position += 1 }
        tokenEnd = position
        token = T_SYMBOL
        return
    }
    if byte == 34 {
        position += 1
        tokenStart = position
        while position < sourceLength && source[position] != 34 {
            if source[position] == 92 { position += 1 }
            position += 1
        }
        tokenEnd = position
        if position >= sourceLength { complain("unterminated string") }
        position += 1
        token = T_STRING
        return
    }
    position += 1
    tokenEnd = position
    if byte == 44 {
        token = T_COMMA
    } else if byte == 91 {
        token = T_LBRACKET
    } else if byte == 93 {
        token = T_RBRACKET
    } else if byte == 123 {
        token = T_LBRACE
    } else if byte == 125 {
        token = T_RBRACE
    } else if byte == 46 && byteAt(position) == 42 {
        position += 1
        tokenEnd = position
        token = T_DOTSTAR
    } else {
        token = T_OTHER
    }
}

fn expect(kind: u8, what: []const u8) -> void {
    if token != kind { complain(s.join3("expected ", what, s.join3(", found `", tokenText(), "`"))) }
    advance()
}

// ---------------------------------------------------------------------------
// Values.

fn newValue(kind: u8, text: []const u8) -> usize {
    if valueCount == MAX_VALUES { s.fail("BytecodeList.rb: too many values") }
    values[valueCount] = Value.{ .kind = kind, .text = text, .key = "", .first = 0, .count = 0 }
    valueCount += 1
    return valueCount - 1
}

// A hash or an array of the COUNT items in ITEMS.
fn newList(kind: u8, items: [*]usize, count: usize) -> usize {
    const index = newValue(kind, "")
    values[index].first = kidCount
    values[index].count = count
    var at: usize = 0
    while at < count {
        kids[kidCount] = items[at]
        kidCount += 1
        at += 1
    }
    return index
}

fn typeIndex(name: []const u8) -> usize {
    var at: usize = 0
    while at < typeCount {
        if s.same(typeNames[at], name) { return at }
        at += 1
    }
    return NONE
}

fn declare(name: []const u8, template: bool) -> void {
    if typeCount == MAX_NAMES { s.fail("BytecodeList.rb: too many types") }
    typeNames[typeCount] = name
    typeIsTemplate[typeCount] = template
    typeCount += 1
}

// An entry KEY: VALUE added to a hash's items: a key given twice keeps
// its first place and takes the last value, as in Ruby.
fn addEntry(items: [*]usize, count: *usize, key: []const u8, entry: usize) -> void {
    values[entry].key = key
    var at: usize = 0
    while at < count.* {
        if s.same(values[items[at]].key, key) {
            items[at] = entry
            return
        }
        at += 1
    }
    if count.* == MAX_ITEMS { complain("too many items") }
    items[count.*] = entry
    count.* += 1
}

fn parseValue() -> usize {
    if token == T_SYMBOL {
        const index = newValue(SYMBOL, tokenText())
        advance()
        return index
    }
    if token == T_STRING {
        const index = newValue(STRING, tokenText())
        advance()
        return index
    }
    if token == T_INTEGER {
        const index = newValue(INTEGER, tokenText())
        advance()
        return index
    }
    if token == T_LBRACE {
        advance()
        var items: [512]usize = undefined
        var count: usize = 0
        while token != T_RBRACE {
            if token != T_LABEL { complain(s.join3("expected a key, found `", tokenText(), "`")) }
            const key = tokenText()
            advance()
            addEntry(&items, &count, key, parseValue())
            if token != T_COMMA { break }
            advance()
        }
        expect(T_RBRACE, "`}`")
        return newList(HASH, &items, count)
    }
    if token == T_LBRACKET {
        advance()
        var items: [512]usize = undefined
        var count: usize = 0
        while token != T_RBRACKET {
            if count == MAX_ITEMS { complain("too many items") }
            items[count] = parseValue()
            count += 1
            if token != T_COMMA { break }
            advance()
        }
        expect(T_RBRACKET, "`]`")
        return newList(ARRAY, &items, count)
    }
    if token != T_IDENT { complain(s.join3("unexpected `", tokenText(), "`")) }
    const name = tokenText()
    advance()
    if s.same(name, "nil") { return newValue(NIL, "") }
    if s.same(name, "true") { return newValue(TRUE, "") }
    if s.same(name, "false") { return newValue(FALSE, "") }
    const known = typeIndex(name)
    if known == NONE { complain(s.join3("undefined local variable or method `", name, "'")) }
    var typeName = name
    // Template[Type, ...]: "Template<Type,...>".
    if token == T_LBRACKET && typeIsTemplate[known] {
        advance()
        typeName = s.join(typeName, "<")
        var first = true
        while token != T_RBRACKET {
            if !first { typeName = s.join(typeName, ",") }
            typeName = s.join(typeName, text(parseValue()))
            first = false
            if token != T_COMMA { break }
            advance()
        }
        expect(T_RBRACKET, "`]`")
        typeName = s.join(typeName, ">")
    }
    // Type.*: a pointer to it.
    while token == T_DOTSTAR {
        advance()
        typeName = s.join(typeName, "*")
    }
    return newValue(TYPE, typeName)
}

// ---------------------------------------------------------------------------
// The calls.

fn addOpcode(name: []const u8, config: usize) -> void {
    if opcodeCount == MAX_OPCODES { s.fail("BytecodeList.rb: too many opcodes") }
    const checkpoints = lookUp(config, "checkpoints")
    opcodes[opcodeCount] = Opcode.{ .section = currentSection, .name = name, .args = lookUp(config, "args"),
        .metadata = lookUp(config, "metadata"), .initializers = lookUp(config, "metadata_initializers"),
        .tmps = lookUp(config, "tmps"), .checkpoints = checkpoints, .id = 0 }
    pending[pendingCount] = opcodeCount
    pendingCount += 1
    opcodeCount += 1
}

// The name an opcode goes by: with its section's op_prefix.
pub fn opcodeName(index: usize) -> []const u8 {
    return s.join(optionText(opcodes[index].section, "op_prefix"), opcodes[index].name)
}

const SIMD = "simd"

fn hasSimd(name: []const u8) -> bool {
    var at: usize = 0
    while at + 4 <= name.length {
        var matches = true
        var index: usize = 0
        while index < 4 {
            var byte = name[at + index]
            if byte >= 65 && byte <= 90 { byte += 32 }
            if byte != SIMD[index] { matches = false }
            index += 1
        }
        if matches { return true }
        at += 1
    }
    return false
}

// Section#validate: with preserve_order, the list itself must have the
// opcodes with checkpoints first, then those with metadata, simd last.
fn validate() -> void {
    const name = sections[currentSection].name
    var firstNonCheckpoint: usize = NONE
    var firstNonMetadata: usize = NONE
    var lastSimd: usize = NONE
    var at: usize = 0
    while at < pendingCount {
        const op = pending[at]
        if opcodes[op].checkpoints == NONE {
            if firstNonCheckpoint == NONE { firstNonCheckpoint = op }
        } else if firstNonCheckpoint != NONE {
            s.fail(s.join(s.join3("invalid order of bytecodes in section '", name, "': found opcode '"),
                s.join3(opcodeName(op), "' with checkpoints after '", s.join(opcodeName(firstNonCheckpoint), "', which doesn't contain checkpoints"))))
        }
        if opcodes[op].metadata == NONE {
            if firstNonMetadata == NONE { firstNonMetadata = op }
        } else if firstNonMetadata != NONE {
            s.fail(s.join(s.join3("invalid order of bytecodes in section '", name, "': found opcode '"),
                s.join3(opcodeName(op), "' with metadata after '", s.join(opcodeName(firstNonMetadata), "', which doesn't contain metadata"))))
        }
        if hasSimd(opcodeName(op)) {
            lastSimd = op
        } else if lastSimd != NONE {
            s.fail(s.join(s.join3("invalid order of bytecodes in section '", name, "': found non-simd opcode '"),
                s.join3(opcodeName(op), "' after '", s.join(opcodeName(lastSimd), "'"))))
        }
        at += 1
    }
}

// Section#sort!'s order as ranks: checkpoints first, then metadata, then
// the rest, simd opcodes last. The sort keeps equal ranks as they came.
fn rank(op: usize) -> u8 {
    if opcodes[op].checkpoints != NONE {
        if opcodes[op].metadata == NONE { s.fail(s.join("Bytecodes with checkpoints should have metadata: ", opcodeName(op))) }
        return 0
    }
    if hasSimd(opcodeName(op)) { return 3 }
    return if opcodes[op].metadata != NONE { 1 } else { 2 }
}

fn sortPending() -> void {
    var at: usize = 1
    while at < pendingCount {
        const op = pending[at]
        const key = rank(op)
        var index = at
        while index > 0 && rank(pending[index - 1]) > key {
            pending[index] = pending[index - 1]
            index -= 1
        }
        pending[index] = op
        at += 1
    }
}

fn symbolArgument(arguments: [*]usize, count: usize, at: usize, call: []const u8) -> []const u8 {
    if at >= count || values[arguments[at]].kind != SYMBOL { complain(s.join(call, ": expected a symbol")) }
    return values[arguments[at]].text
}

fn statement() -> void {
    if token != T_IDENT { complain(s.join3("unexpected `", tokenText(), "`")) }
    const call = tokenText()
    advance()
    // The arguments: values, then `key: value` pairs, which make one hash.
    var arguments: [8]usize = undefined
    var count: usize = 0
    var items: [512]usize = undefined
    var itemCount: usize = 0
    var more = true
    while more {
        if token == T_LABEL {
            const key = tokenText()
            advance()
            addEntry(&items, &itemCount, key, parseValue())
        } else {
            if itemCount > 0 { complain("a value after a hash's entries") }
            if count == 8 { complain("too many arguments") }
            arguments[count] = parseValue()
            count += 1
        }
        more = token == T_COMMA
        if more { advance() }
    }
    const config = newList(HASH, &items, itemCount)

    if s.same(call, "types") || s.same(call, "templates") {
        if count != 1 || values[arguments[0]].kind != ARRAY { complain(s.join(call, ": expected an array")) }
        var at: usize = 0
        while at < values[arguments[0]].count {
            const name = item(arguments[0], at)
            if values[name].kind != SYMBOL { complain(s.join(call, ": expected symbols")) }
            declare(values[name].text, s.same(call, "templates"))
            at += 1
        }
    } else if s.same(call, "begin_section") {
        if inSection { complain("must call `end_section` before beginning a new section") }
        if sectionCount == MAX_SECTIONS { complain("too many sections") }
        sections[sectionCount] = Section.{ .name = symbolArgument(&arguments, count, 0, call), .config = config, .first = 0, .count = 0 }
        currentSection = sectionCount
        sectionCount += 1
        inSection = true
        pendingCount = 0
    } else if s.same(call, "op") {
        if !inSection { complain("`op` can only be called in between `begin_section` and `end_section`") }
        addOpcode(symbolArgument(&arguments, count, 0, call), if itemCount > 0 { config } else { NONE })
    } else if s.same(call, "op_group") {
        if !inSection { complain("`op_group` can only be called in between `begin_section` and `end_section`") }
        if count != 2 || values[arguments[1]].kind != ARRAY { complain("op_group: expected a name, an array and options") }
        var at: usize = 0
        while at < values[arguments[1]].count {
            const name = item(arguments[1], at)
            if values[name].kind != SYMBOL { complain("op_group: expected symbols") }
            addOpcode(values[name].text, config)
            at += 1
        }
    } else if s.same(call, "end_section") {
        const name = symbolArgument(&arguments, count, 0, call)
        if !inSection || !s.same(sections[currentSection].name, name) {
            complain(s.join3("end_section called with `", name, "`, which is not the current section"))
        }
        if option(currentSection, "preserve_order") { validate() } else { sortPending() }
        // create_ids!: numbered on from the sections before.
        sections[currentSection].first = orderCount
        sections[currentSection].count = pendingCount
        var at: usize = 0
        while at < pendingCount {
            opcodes[pending[at]].id = orderCount
            order[orderCount] = pending[at]
            orderCount += 1
            at += 1
        }
        inSection = false
    } else {
        complain(s.join3("`", call, "` is not a call this reader knows"))
    }
}

// Reads the list at PATH (main.rb first names bool, int, unsigned,
// uintptr_t and uint8_t as types).
pub fn read(path: []const u8, contents: []const u8) -> void {
    unsafe {
        values = @ptrFromInt([*]Value, s.alloc(MAX_VALUES * @sizeOf(Value)))
        kids = @ptrFromInt([*]usize, s.alloc(MAX_VALUES * 8))
        opcodes = @ptrFromInt([*]Opcode, s.alloc(MAX_OPCODES * @sizeOf(Opcode)))
        sections = @ptrFromInt([*]Section, s.alloc(MAX_SECTIONS * @sizeOf(Section)))
        order = @ptrFromInt([*]usize, s.alloc(MAX_OPCODES * 8))
        pending = @ptrFromInt([*]usize, s.alloc(MAX_OPCODES * 8))
        typeNames = @ptrFromInt([*][]const u8, s.alloc(MAX_NAMES * @sizeOf([]const u8)))
        typeIsTemplate = @ptrFromInt([*]bool, s.alloc(MAX_NAMES))
    }
    sourcePath = path.pointer
    sourcePathLength = path.length
    source = contents.pointer
    sourceLength = contents.length
    declare("bool", false)
    declare("int", false)
    declare("unsigned", false)
    declare("uintptr_t", false)
    declare("uint8_t", false)
    position = 0
    advance()
    while token != T_END { statement() }
    if inSection { complain("must end last section") }
}
