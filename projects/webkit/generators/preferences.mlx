// The files WebKit makes from its preferences, as WTF's
// GeneratePreferences.rb makes them with its ERB templates, from the YAML
// files of the preferences:
//
//     webkit-preferences --frontend FRONTEND --outputDir DIR --template TEMPLATE.erb [--template ...] PREFERENCES.yaml...
//
// Each file's preferences (their names in sorted order, or the run
// fails) are checked as the script checks them, and those of the
// frontend kept: for JavaScriptCore those naming a JSC option
// (jscOptionName), for the others those with a default for it. Each
// template gives the file of its name without .erb, in the output
// directory. The templates' logic is written out here, their text kept
// to the byte; JSCWebPreferenceOptions.h.erb (JavaScriptCore's feature
// flags) is the one made so far.
const std = @import("std")
const s = @import("./support.mlx")
const yaml = @import("./preferencesyaml.mlx")

const Preference = struct {
    name: []const u8
    options: usize
    valueType: []const u8
    refinedType: []const u8
    status: []const u8
    category: []const u8
    defaultsOverridable: bool
    // Quoted (unless it starts with WebKitAdditions).
    humanReadableName: []const u8
    humanReadableDescription: []const u8
    getter: []const u8
    webcoreBinding: []const u8
    webcoreName: []const u8
    condition: []const u8
    hidden: bool
    // The frontend's defaults (the WebKit ones for a JSC option without
    // its own), a mapping of conditions to values.
    defaultValues: usize
    exposed: bool
    sharedPreferenceForWebProcess: bool
    richJavaScript: bool
    mediaPlaybackRelated: bool
    inspectorOverride: bool
    jscOptionName: []const u8
    hasJscOptionName: bool
}

const MAX_PREFERENCES: usize = 8192

var preferences: [*]Preference = undefined
var preferenceCount: usize = 0
var frontendPointer: [*]const u8 = undefined
var frontendLength: usize = 0
var failed: bool = false

fn frontend() -> []const u8 { return frontendPointer[0..frontendLength] }

const WARNING = "THIS FILE WAS AUTOMATICALLY GENERATED, DO NOT EDIT."

fn exitWith(status: usize) -> void { const ignored = std.linux.syscall1(231, status) }

fn oneOf(value: []const u8, words: []const u8) -> bool {
    var from: usize = 0
    var at: usize = 0
    while at <= words.length {
        if at == words.length || words[at] == 32 {
            if std.text.same(value, words[from..at]) { return true }
            from = at + 1
        }
        at += 1
    }
    return false
}

// Features which should appear in UI presented to end users.
fn experimental(p: *const Preference) -> bool { return oneOf(p.*.status, "developer testable preview stable") }

// Whether FIRST sorts before SECOND, byte by byte (as Ruby compares
// strings).
fn less(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

fn quotedUnlessAdditions(value: []const u8) -> []const u8 {
    if std.text.startsWith(value, "WebKitAdditions") { return value }
    return s.join3("\"", value, "\"")
}

fn textOr(node: usize, otherwise: []const u8) -> []const u8 {
    if !yaml.truthy(node) { return otherwise }
    return yaml.textOf(node)
}

fn newPreference(name: []const u8, options: usize) -> Preference {
    const defaults = yaml.get(options, "defaultValue")
    var defaultValues = yaml.get(defaults, frontend())
    const jscOptionName = yaml.get(options, "jscOptionName")
    if !yaml.truthy(defaultValues) && yaml.truthy(jscOptionName) { defaultValues = yaml.get(defaults, "WebKit") }
    const exposed = yaml.get(options, "exposed")
    return Preference.{ .name = name, .options = options, .valueType = yaml.textOf(yaml.get(options, "type")),
        .refinedType = yaml.textOf(yaml.get(options, "refinedType")), .status = yaml.textOf(yaml.get(options, "status")),
        .category = textOr(yaml.get(options, "category"), "none"),
        .defaultsOverridable = yaml.truthy(yaml.get(options, "defaultsOverridable")),
        .humanReadableName = quotedUnlessAdditions(textOr(yaml.get(options, "humanReadableName"), "")),
        .humanReadableDescription = quotedUnlessAdditions(textOr(yaml.get(options, "humanReadableDescription"), "")),
        .getter = yaml.textOf(yaml.get(options, "getter")), .webcoreBinding = yaml.textOf(yaml.get(options, "webcoreBinding")),
        .webcoreName = yaml.textOf(yaml.get(options, "webcoreName")), .condition = yaml.textOf(yaml.get(options, "condition")),
        .hidden = yaml.truthy(yaml.get(options, "hidden")), .defaultValues = defaultValues,
        .exposed = !yaml.truthy(exposed) || yaml.includes(exposed, frontend()),
        .sharedPreferenceForWebProcess = yaml.truthy(yaml.get(options, "sharedPreferenceForWebProcess")),
        .richJavaScript = yaml.truthy(yaml.get(options, "richJavaScript")),
        .mediaPlaybackRelated = yaml.truthy(yaml.get(options, "mediaPlaybackRelated")),
        .inspectorOverride = yaml.isTrue(yaml.get(options, "inspectorOverride")),
        .jscOptionName = yaml.textOf(jscOptionName), .hasJscOptionName = yaml.truthy(jscOptionName) }
}

// ---------------------------------------------------------------------------
// The preference files.

fn reject(message: []const u8) -> void {
    s.say(s.join3("error: ", message, "\n"))
    failed = true
}

// The categories of WebFeatureCategory.
const CATEGORIES = "animation css dom extensions html javascript media networking privacy security"
const CATEGORIES_AS_RUBY = "[\"animation\", \"css\", \"dom\", \"extensions\", \"html\", \"javascript\", \"media\", \"networking\", \"privacy\", \"security\"]"

fn sortedCheck(path: []const u8, top: usize) -> void {
    if yaml.nodes[top].kind != yaml.MAPPING { return }
    var previous = yaml.NONE
    var entry = yaml.nodes[top].first
    while entry != yaml.NONE {
        if previous != yaml.NONE && less(yaml.nodes[entry].key, yaml.nodes[previous].key) {
            s.say(s.join3(s.join3("error: Input file ", path, " is not sorted. First out of order name found is '"), yaml.nodes[entry].key, "'.\n"))
            exitWith(1)
        }
        previous = entry
        entry = yaml.nodes[entry].next
    }
}

// The keys of MAPPING are exactly the one KEY.
fn onlyKey(mapping: usize, key: []const u8) -> bool {
    if mapping == yaml.NONE || yaml.nodes[mapping].kind != yaml.MAPPING { return false }
    const first = yaml.nodes[mapping].first
    return first != yaml.NONE && yaml.nodes[first].next == yaml.NONE && std.text.same(yaml.nodes[first].key, key)
}

fn readFile(path: []const u8) -> void {
    const top = yaml.load(path)
    sortedCheck(path, top)
    if yaml.nodes[top].kind != yaml.MAPPING { return }
    var entry = yaml.nodes[top].first
    while entry != yaml.NONE {
        const options = entry
        const name = yaml.nodes[entry].key
        entry = yaml.nodes[entry].next
        const defaults = yaml.get(options, "defaultValue")
        const webcoreSettingOnly = !yaml.truthy(yaml.get(options, "webcoreBinding")) && onlyKey(defaults, "WebCore")
        const status = yaml.textOf(yaml.get(options, "status"))
        const jscOptionName = yaml.get(options, "jscOptionName")

        if yaml.truthy(jscOptionName) {
            if !yaml.truthy(yaml.get(options, "sharedPreferenceForWebProcess")) {
                reject(s.join3("Preference ", name, " has jscOptionName, so it must set sharedPreferenceForWebProcess: true."))
            }
            if !yaml.truthy(yaml.get(defaults, "WebKit")) {
                reject(s.join3("Preference ", name, " has jscOptionName, so it must specify a WebKit default value."))
            }
            if failed { continue }
        }

        if oneOf(status, "unstable internal developer testable preview stable") {
            if !yaml.truthy(yaml.get(options, "humanReadableName")) {
                reject(s.join3("Preference ", name, " has no humanReadableName, which is required."))
            }
            if webcoreSettingOnly {
                reject(s.join3("Preference ", name, " is visible in client UI and has a default value bound to WebCore::Settings, so it must have default values for all frontends"))
            }
            if failed { continue }
        } else if webcoreSettingOnly && !std.text.same(frontend(), "WebCore") {
            continue
        }

        if oneOf(status, "developer testable preview stable") {
            if !yaml.truthy(yaml.get(options, "category")) {
                reject(s.join3("Preference ", name, " has no category, which is required."))
            }
            if failed { continue }
            const category = yaml.textOf(yaml.get(options, "category"))
            if !oneOf(category, CATEGORIES) {
                reject(s.join3(s.join3("Preference ", name, "'s category \""), category, s.join("\" is not one of the known categories: ", CATEGORIES_AS_RUBY)))
                continue
            }
        }

        // JavaScriptCore takes the preferences backing a JSC option; the
        // other frontends those with a default group of their own.
        const included = if std.text.same(frontend(), "JavaScriptCore") { !yaml.isNull(jscOptionName) } else { yaml.has(defaults, frontend()) }
        if included {
            if preferenceCount == MAX_PREFERENCES { s.fail("webkit-preferences: too many preferences") }
            preferences[preferenceCount] = newPreference(name, options)
            preferenceCount += 1
        }
    }
    if failed { exitWith(1) }
}

// The preferences in INDEXES sorted by KEY (stably).
fn sortBy(indexes: [*]usize, count: usize, byOption: bool) -> void {
    var index: usize = 1
    while index < count {
        const item = indexes[index]
        const key = if byOption { preferences[item].jscOptionName } else { preferences[item].humanReadableName }
        var at = index
        while at > 0 {
            const other = indexes[at - 1]
            const otherKey = if byOption { preferences[other].jscOptionName } else { preferences[other].humanReadableName }
            if !less(key, otherKey) { break }
            indexes[at] = other
            at -= 1
        }
        indexes[at] = item
        index += 1
    }
}

// The preferences backing JSC options, by option name.
fn jscOptions(count: *usize) -> [*]usize {
    var indexes: [*]usize = undefined
    unsafe { indexes = @ptrFromInt([*]usize, s.alloc((preferenceCount + 1) * 8)) }
    var total: usize = 0
    var index: usize = 0
    while index < preferenceCount {
        if preferences[index].hasJscOptionName {
            indexes[total] = index
            total += 1
        }
        index += 1
    }
    sortBy(indexes, total, true)
    count.* = total
    return indexes
}

// ---------------------------------------------------------------------------
// JSCWebPreferenceOptions.h.erb

const JSC_OPTIONS_HEAD = "/*\n * THIS FILE WAS AUTOMATICALLY GENERATED, DO NOT EDIT.\n *\n * Copyright (C) 2026 Apple Inc. All rights reserved.\n *\n * Redistribution and use in source and binary forms, with or without\n * modification, are permitted provided that the following conditions\n * are met:\n * 1. Redistributions of source code must retain the above copyright\n *    notice, this list of conditions and the following disclaimer.\n * 2. Redistributions in binary form must reproduce the above copyright\n *    notice, this list of conditions and the following disclaimer in the\n *    documentation and/or other materials provided with the distribution.\n *\n * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''\n * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,\n * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR\n * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS\n * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF\n * THE POSSIBILITY OF SUCH DAMAGE.\n */\n\n#pragma once\n\n// JSC feature-flag options whose source of truth is\n// Source/WTF/Scripts/Preferences/UnifiedWebPreferences.yaml. This macro is\n// spliced into FOR_EACH_JSC_OPTION() in runtime/OptionsList.h so these options\n// are declared exactly as if written there directly. Feature flags are always\n// Normal availability.\n\n#define FOR_EACH_JSC_WEB_PREFERENCE_OPTION(v) \\\n"

const JSC_OPTIONS_MIDDLE = "\n\n// The subset of the above whose feature status is \"experimental\" (developer/testable/preview/\n// stable)\n#define FOR_EACH_JSC_EXPERIMENTAL_WEB_PREFERENCE_OPTION(v) \\\n"

fn jscWebPreferenceOptions() -> void {
    var count: usize = 0
    const options = jscOptions(&count)
    s.out(JSC_OPTIONS_HEAD)
    var index: usize = 0
    while index < count {
        const p = &preferences[options[index]]
        const value = yaml.get(p.*.defaultValues, "default")
        if p.*.defaultValues == yaml.NONE { s.fail("NoMethodError: undefined method '[]' for nil (defaultValues)") }
        const jscDefault = yaml.rubyText(value)
        const description = p.*.humanReadableDescription
        const jscDescription = if description.length == 0 || std.text.same(description, "\"\"") { "nullptr" } else { s.join(description, "_s") }
        s.out("    v(Bool, ")
        s.out(p.*.jscOptionName)
        s.out(", ")
        s.out(jscDefault)
        s.out(", Normal, ")
        s.out(jscDescription)
        s.out(") \\\n")
        index += 1
    }
    s.out(JSC_OPTIONS_MIDDLE)
    index = 0
    while index < count {
        const p = &preferences[options[index]]
        if experimental(p) {
            s.out("    v(")
            s.out(p.*.jscOptionName)
            s.out(") \\\n")
        }
        index += 1
    }
    s.out("\n")
}

// ---------------------------------------------------------------------------
// The run.

const MAX_FILES: usize = 256

fn makeDirectories(path: []const u8) -> void {
    var at: usize = 1
    while at <= path.length {
        if at == path.length || path[at] == 47 {
            const prefix = s.join(path[0..at], "")
            const ignored = std.linux.syscall2(83, @intFromPtr(prefix.pointer), 493)
        }
        at += 1
    }
}

fn usage() -> void {
    s.say("Usage: webkit-preferences --frontend <frontend> [--outputDir <output>] --template <file> [--template <file>...] <preferences> [<preferences>...]\n")
    exitWith(1)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var templates: [*][]const u8 = undefined
    var files: [*][]const u8 = undefined
    unsafe {
        templates = @ptrFromInt([*][]const u8, s.alloc(MAX_FILES * 16))
        files = @ptrFromInt([*][]const u8, s.alloc(MAX_FILES * 16))
        preferences = @ptrFromInt([*]Preference, s.alloc(MAX_PREFERENCES * @sizeOf(Preference)))
    }
    var templateCount: usize = 0
    var fileCount: usize = 0
    var outputDirectory: []const u8 = "."
    var frontendName: []const u8 = ""
    var index: usize = 1
    while index < arguments.length {
        const argument = std.text.cString(arguments[index])
        index += 1
        var name = argument
        var value: []const u8 = ""
        var hasValue = false
        if std.text.startsWith(argument, "--") && std.text.contains(argument, "=") {
            const equals = std.text.find(argument, "=")
            name = argument[0..equals]
            value = argument[equals + 1..argument.length]
            hasValue = true
        }
        const takesValue = std.text.same(name, "--frontend") || std.text.same(name, "--template") || std.text.same(name, "--outputDir")
        if takesValue && !hasValue {
            if index >= arguments.length { usage() }
            value = std.text.cString(arguments[index])
            index += 1
        }
        if std.text.same(name, "--frontend") {
            frontendName = value
        } else if std.text.same(name, "--template") {
            if templateCount == MAX_FILES { s.fail("webkit-preferences: too many templates") }
            templates[templateCount] = value
            templateCount += 1
        } else if std.text.same(name, "--outputDir") {
            outputDirectory = value
        } else if std.text.startsWith(argument, "-") && argument.length > 1 {
            usage()
        } else {
            if fileCount == MAX_FILES { s.fail("webkit-preferences: too many preference files") }
            files[fileCount] = argument
            fileCount += 1
        }
    }
    if fileCount == 0 { usage() }
    frontendPointer = frontendName.pointer
    frontendLength = frontendName.length
    makeDirectories(outputDirectory)

    index = 0
    while index < fileCount {
        readFile(files[index])
        index += 1
    }

    index = 0
    while index < templateCount {
        const template = templates[index]
        var name = s.baseName(template)
        if std.text.endsWith(name, ".erb") { name = name[0..name.length - 4] }
        const from = s.output().length
        if std.text.same(name, "JSCWebPreferenceOptions.h") {
            jscWebPreferenceOptions()
        } else {
            s.fail(s.join("webkit-preferences: the template is not made yet: ", template))
        }
        const all = s.output()
        const path = if std.text.endsWith(outputDirectory, "/") { s.join(outputDirectory, name) } else { s.join3(outputDirectory, "/", name) }
        s.writeWhole(path, all[from..all.length])
        index += 1
    }
    return 0
}
