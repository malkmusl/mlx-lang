// WebCore's JavaScript bindings, made as WebKit's generate-bindings-all.pl
// makes them: preprocess-idls.pl first (which IDL files supplement which,
// the global objects' constructor attributes, the IsoSubspace and
// constructor headers), then for each IDL file the generator of
// CodeGeneratorJS.pm (JS<Name>.h and JS<Name>.cpp, and JS<Name>.dep
// when the bindings depend on other IDL files):
//
//     webkit-generate-bindings --defines DEFINES --generator JS
//         --outputDir DIRECTORY --idlFilesList LIST
//         [--idlFileNamesList LIST] [--ppIDLFilesList LIST]
//         --idlAttributesFile IDLAttributes.json
//         [--supplementalDependencyFile FILE] [--numOfJobs N]
//         [--ignoreStandaloneConstructorAttributes]
//         [--ppExtraArgs ARGUMENT]... [--ppExtraOutput FILE]...
//         [--generatorDependency FILE]...
//
// The --ppExtraArgs are preprocess-idls.pl's own options
// (--isoSubspacesHeaderFile FILE, --windowConstructorsFile FILE ...).
// As the Perl does, the IDL files are split into --numOfJobs batches,
// each generated in a process of its own: what the generator learns of
// other IDL files (their interfaces, dictionaries, typedefs) is kept
// within a batch, and the text it makes can depend on it.
const std = @import("std")
const r = @import("./bindingsrt.mlx")
const pre = @import("./bindingspre.mlx")
const gen = @import("./bindingsgen.mlx")
const Str = r.Str

fn readList(path: Str) -> r.StrList {
    var result = r.strList()
    const text = r.readWhole(path)
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        var line = text[at..end]
        if line.length > 0 && line[line.length - 1] == 13 { line = line[0..line.length - 1] }
        r.spush(&result, line)
        at = end + 1
    }
    return result
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var defines: Str = ""
    var outputDirectory = r.undef()
    var idlFilesList = r.undef()
    var ppIDLFilesList = r.undef()
    var idlFileNamesList = r.undef()
    var idlAttributesFile = r.undef()
    var supplementalDependencyFile = r.undef()
    var numOfJobs: usize = 4
    var ignoreStandaloneConstructorAttributes = false
    var ppExtraArgs = r.strList()
    var index: usize = 1
    while index < arguments.length {
        var name = r.cString(arguments[index])
        index += 1
        var v: Str = ""
        var hasValue = false
        const equals = r.findByte(name, 61)
        if equals < name.length {
            v = name[equals + 1..name.length]
            name = name[0..equals]
            hasValue = true
        }
        if std.text.same(name, "--ignoreStandaloneConstructorAttributes") {
            ignoreStandaloneConstructorAttributes = true
            continue
        }
        if std.text.same(name, "--showProgress") { continue }
        if !hasValue {
            if index >= arguments.length { r.die(r.c2("Option needs a value: ", name)) }
            v = r.cString(arguments[index])
            index += 1
        }
        if std.text.same(name, "--defines") {
            defines = v
        } else if std.text.same(name, "--outputDir") {
            outputDirectory = v
        } else if std.text.same(name, "--idlFilesList") {
            idlFilesList = v
        } else if std.text.same(name, "--ppIDLFilesList") {
            ppIDLFilesList = v
        } else if std.text.same(name, "--idlFileNamesList") {
            idlFileNamesList = v
        } else if std.text.same(name, "--idlAttributesFile") {
            idlAttributesFile = v
        } else if std.text.same(name, "--supplementalDependencyFile") {
            supplementalDependencyFile = v
        } else if std.text.same(name, "--numOfJobs") {
            numOfJobs = @intCast(usize, r.numberOf(v))
        } else if std.text.same(name, "--ppExtraArgs") {
            r.spush(&ppExtraArgs, v)
        } else if std.text.same(name, "--generator") {
            if !std.text.same(v, "JS") { r.die("Only the JS generator is supported") }
        } else if std.text.same(name, "--generatorDependency") || std.text.same(name, "--ppExtraOutput") || std.text.same(name, "--exclude") {
            // Dependencies for the build only.
        } else {
            r.die(r.c2("Unknown option: ", name))
        }
    }
    if !r.isDef(outputDirectory) || !r.isDef(idlFilesList) || !r.isDef(idlAttributesFile) { r.die("Must specify --outputDir, --idlFilesList and --idlAttributesFile") }
    if !r.isDef(idlFileNamesList) { idlFileNamesList = idlFilesList }
    const idlFiles = readList(idlFilesList)

    if r.isDef(supplementalDependencyFile) && r.isDef(ppIDLFilesList) {
        var o = pre.emptyOptions()
        o.defines = defines
        o.idlFileNamesList = ppIDLFilesList
        o.supplementalDependencyFile = supplementalDependencyFile
        var a: usize = 0
        while a + 1 < ppExtraArgs.count {
            const option = ppExtraArgs.items[a]
            const v = ppExtraArgs.items[a + 1]
            a += 2
            if std.text.same(option, "--isoSubspacesHeaderFile") {
                o.isoSubspacesHeaderFile = v
            } else if std.text.same(option, "--clientISOSubspacesHeaderFile") {
                o.clientISOSubspacesHeaderFile = v
            } else if std.text.same(option, "--constructorsHeaderFile") {
                o.constructorsHeaderFile = v
            } else {
                var found = false
                var g: usize = 0
                while g < 9 {
                    if std.text.same(option, pre.globalScopeOptions[g]) {
                        o.constructorsFiles[g] = v
                        found = true
                    }
                    g += 1
                }
                if !found { r.die(r.c2("Unknown preprocess-idls option: ", option)) }
            }
        }
        pre.run(o)
    }

    var g = gen.Generation.{ .defines = defines, .outputDirectory = outputDirectory, .idlFileNamesList = idlFileNamesList, .idlAttributesFile = idlAttributesFile, .supplementalDependencyFile = supplementalDependencyFile, .ignoreStandaloneConstructorAttributes = ignoreStandaloneConstructorAttributes }
    gen.prepare(&g)

    // The batches, one process each, as many at a time as there are jobs.
    if numOfJobs == 0 { numOfJobs = 1 }
    const total = idlFiles.count
    var batch = (total + numOfJobs - 1) / numOfJobs
    if batch == 0 { batch = 1 }
    var start: usize = 0
    var running: usize = 0
    var failed = false
    while start < total || running > 0 {
        if start < total && running < numOfJobs && !failed {
            var end = start + batch
            if end > total { end = total }
            const pid = r.fork()
            if pid == 0 {
                var f = start
                while f < end {
                    gen.generate(&g, idlFiles.items[f])
                    f += 1
                }
                r.exit(0)
            }
            if pid < 0 { failed = true }
            running += 1
            start = end
            continue
        }
        if running == 0 { break }
        const status = r.waitChild()
        if status < 0 { break }
        if status != 0 { failed = true }
        running -= 1
    }
    return if failed { 1 } else { 0 }
}
