// WebCore's names of events (EventNames.h and EventNames.cpp), made as
// dom/make-event-names.py (Python) makes them, from dom/EventNames.json,
// in OUTPUT_DIRECTORY:
//
//     webkit-event-names --event-names INPUT OUTPUT_DIRECTORY
//
// The input maps each event name to its categories, the condition it is
// built under and whether it has a default event handler. The names go in
// sorted order: an EventType enumerator, an AtomString member of
// EventNames and an entry in its map of type information each; the
// categories, sorted, are the bits of EventCategory.
const std = @import("std")
const s = @import("./support.mlx")
const n = @import("./namestext.mlx")

const Event = struct {
    name: []const u8
    conditional: []const u8
    defaultEventHandler: bool
    // The categories, as a list.
    categories: n.List
}

const MAX_EVENTS: usize = 8192

var events: [*]Event = undefined
var eventCount: usize = 0

// ---------------------------------------------------------------------------
// The JSON (what of it EventNames.json uses: objects, arrays, strings,
// true, false, null and numbers).

var source: [*]const u8 = undefined
var sourceLength: usize = 0
var cursor: usize = 0

fn fail(message: []const u8) -> void {
    s.fail(s.join3("make-event-names: ", message, s.join(" at byte ", s.decimal(@intCast(u64, cursor)))))
}

fn skipSpace() -> void {
    while cursor < sourceLength && (source[cursor] == 32 || source[cursor] == 9 || source[cursor] == 10 || source[cursor] == 13) { cursor += 1 }
}

fn expect(byte: u8) -> void {
    skipSpace()
    if cursor >= sourceLength || source[cursor] != byte { fail(s.join3("expected '", s.bytes(@intFromPtr(&byte), 1), "'")) }
    cursor += 1
}

fn peek() -> u8 {
    skipSpace()
    if cursor >= sourceLength { return 0 }
    return source[cursor]
}

fn hexDigit(byte: u8) -> u32 {
    if byte >= 48 && byte <= 57 { return @intCast(u32, byte - 48) }
    if byte >= 65 && byte <= 70 { return @intCast(u32, byte - 55) }
    if byte >= 97 && byte <= 102 { return @intCast(u32, byte - 87) }
    fail("a bad \\u escape")
    return 0
}

fn utf8(code: u32) -> []const u8 {
    const at = s.alloc(5)
    if code < 128 {
        s.put8(at, @intCast(u8, code))
        return s.bytes(at, 1)
    }
    if code < 2048 {
        s.put8(at, @intCast(u8, 192 | (code >> 6)))
        s.put8(at + 1, @intCast(u8, 128 | (code & 63)))
        return s.bytes(at, 2)
    }
    if code < 65536 {
        s.put8(at, @intCast(u8, 224 | (code >> 12)))
        s.put8(at + 1, @intCast(u8, 128 | ((code >> 6) & 63)))
        s.put8(at + 2, @intCast(u8, 128 | (code & 63)))
        return s.bytes(at, 3)
    }
    s.put8(at, @intCast(u8, 240 | (code >> 18)))
    s.put8(at + 1, @intCast(u8, 128 | ((code >> 12) & 63)))
    s.put8(at + 2, @intCast(u8, 128 | ((code >> 6) & 63)))
    s.put8(at + 3, @intCast(u8, 128 | (code & 63)))
    return s.bytes(at, 4)
}

fn parseString() -> []const u8 {
    expect(34)
    var text: []const u8 = ""
    var start = cursor
    while true {
        if cursor >= sourceLength { fail("an unterminated string") }
        const byte = source[cursor]
        if byte == 34 { break }
        if byte == 92 {
            text = s.join(text, source[start..cursor])
            cursor += 1
            if cursor >= sourceLength { fail("an unterminated string") }
            const escaped = source[cursor]
            cursor += 1
            if escaped == 110 {
                text = s.join(text, "\n")
            } else if escaped == 116 {
                text = s.join(text, "\t")
            } else if escaped == 114 {
                text = s.join(text, "\r")
            } else if escaped == 98 {
                text = s.join(text, "\x08")
            } else if escaped == 102 {
                text = s.join(text, "\x0c")
            } else if escaped == 117 {
                if cursor + 4 > sourceLength { fail("a bad \\u escape") }
                var code: u32 = 0
                var i: usize = 0
                while i < 4 {
                    code = code * 16 + hexDigit(source[cursor + i])
                    i += 1
                }
                cursor += 4
                // A surrogate pair is one character.
                if code >= 55296 && code < 56320 && cursor + 6 <= sourceLength && source[cursor] == 92 && source[cursor + 1] == 117 {
                    var low: u32 = 0
                    i = 0
                    while i < 4 {
                        low = low * 16 + hexDigit(source[cursor + 2 + i])
                        i += 1
                    }
                    if low >= 56320 && low < 57344 {
                        code = 65536 + ((code - 55296) << 10) + (low - 56320)
                        cursor += 6
                    }
                }
                text = s.join(text, utf8(code))
            } else {
                text = s.join(text, source[cursor - 1..cursor])
            }
            start = cursor
            continue
        }
        cursor += 1
    }
    text = s.join(text, source[start..cursor])
    cursor += 1
    return text
}

// A word (true, false, null) or a number, as written.
fn parseAtom() -> []const u8 {
    skipSpace()
    const start = cursor
    while cursor < sourceLength {
        const byte = source[cursor]
        if byte == 44 || byte == 125 || byte == 93 || byte == 32 || byte == 9 || byte == 10 || byte == 13 { break }
        cursor += 1
    }
    if cursor == start { fail("a value expected") }
    return source[start..cursor]
}

// A value of no interest, passed over.
fn skipValue() -> void {
    const byte = peek()
    if byte == 34 {
        const ignored = parseString()
    } else if byte == 123 {
        expect(123)
        if peek() == 125 {
            cursor += 1
            return
        }
        while true {
            const ignored = parseString()
            expect(58)
            skipValue()
            if peek() == 44 {
                cursor += 1
                continue
            }
            expect(125)
            break
        }
    } else if byte == 91 {
        expect(91)
        if peek() == 93 {
            cursor += 1
            return
        }
        while true {
            skipValue()
            if peek() == 44 {
                cursor += 1
                continue
            }
            expect(93)
            break
        }
    } else {
        const ignored = parseAtom()
    }
}

// Whether the value next is true as Python takes it (only true, a
// non-zero number or non-empty text or container is used here).
fn parseTruth() -> bool {
    const byte = peek()
    if byte == 34 { return parseString().length > 0 }
    if byte == 123 || byte == 91 {
        const start = cursor
        skipValue()
        const text = source[start..cursor]
        var inner: usize = 1
        while inner + 1 < text.length {
            if !(text[inner] == 32 || text[inner] == 9 || text[inner] == 10 || text[inner] == 13) { return true }
            inner += 1
        }
        return false
    }
    const atom = parseAtom()
    if std.text.same(atom, "true") { return true }
    if std.text.same(atom, "false") || std.text.same(atom, "null") { return false }
    for digit in atom {
        if digit >= 49 && digit <= 57 { return true }
    }
    return false
}

fn eventNamed(name: []const u8) -> *Event {
    var index: usize = 0
    while index < eventCount {
        if std.text.same(events[index].name, name) { return &events[index] }
        index += 1
    }
    if eventCount == MAX_EVENTS { s.fail("make-event-names: too many events") }
    events[eventCount] = Event.{ .name = name, .conditional = "", .defaultEventHandler = false, .categories = n.list() }
    eventCount += 1
    return &events[eventCount - 1]
}

fn parseEvents(text: []const u8) -> void {
    source = text.pointer
    sourceLength = text.length
    cursor = 0
    expect(123)
    if peek() == 125 { return }
    while true {
        const name = parseString()
        expect(58)
        const e = eventNamed(name)
        // A name given again starts over (Python keeps the last value).
        e.*.conditional = ""
        e.*.defaultEventHandler = false
        e.*.categories = n.list()
        expect(123)
        if peek() == 125 {
            cursor += 1
        } else {
            while true {
                const key = parseString()
                expect(58)
                if std.text.same(key, "categories") {
                    var categories = n.list()
                    expect(91)
                    if peek() == 93 {
                        cursor += 1
                    } else {
                        while true {
                            n.push(&categories, parseString())
                            if peek() == 44 {
                                cursor += 1
                                continue
                            }
                            expect(93)
                            break
                        }
                    }
                    e.*.categories = categories
                } else if std.text.same(key, "conditional") {
                    if peek() == 34 {
                        e.*.conditional = parseString()
                    } else {
                        const atom = parseAtom()
                        if !std.text.same(atom, "null") { fail("a conditional that is not a string") }
                        e.*.conditional = ""
                    }
                } else if std.text.same(key, "defaultEventHandler") {
                    e.*.defaultEventHandler = parseTruth()
                } else {
                    skipValue()
                }
                if peek() == 44 {
                    cursor += 1
                    continue
                }
                expect(125)
                break
            }
        }
        if peek() == 44 {
            cursor += 1
            continue
        }
        expect(125)
        break
    }
}

// ---------------------------------------------------------------------------
// The files.

fn byName(first: usize, second: usize) -> i32 { return n.compare(events[first].name, events[second].name) }

fn ifConditional(e: Event) -> void {
    if e.conditional.length > 0 { n.o3("#if ", e.conditional, "\n") }
}

fn endConditional(e: Event) -> void {
    if e.conditional.length > 0 { n.o("#endif\n") }
}

fn generate(inputPath: []const u8, outputDirectory: []const u8) -> void {
    unsafe { events = @ptrFromInt([*]Event, s.alloc(MAX_EVENTS * @sizeOf(Event))) }
    parseEvents(s.readWhole(inputPath))
    const order = n.indexes(eventCount)
    n.sortBy(order, eventCount, byName)

    n.o(HEADER_HEAD)
    n.o("\n")
    // The categories, and the events of each, in the order of the events.
    var categories = n.list()
    var position: usize = 0
    while position < eventCount {
        const e = events[order[position]]
        var c: usize = 0
        while c < e.categories.count {
            n.add(&categories, e.categories.items[c])
            c += 1
        }
        ifConditional(e)
        n.o3("    ", e.name, ",\n")
        endConditional(e)
        position += 1
    }
    n.o(HEADER_CATEGORIES)
    n.o("\n")
    n.sortList(&categories)
    var c: usize = 0
    while c < categories.count {
        n.o3("    ", categories.items[c], " = 1u << ")
        n.on(@intCast(u64, c))
        n.o(",\n")
        c += 1
    }
    n.o(HEADER_CLASSES)
    n.o("\n")
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        ifConditional(e)
        n.o3("    const AtomString ", e.name, "Event;\n")
        endConditional(e)
        position += 1
    }
    n.o(HEADER_FUNCTIONS)
    n.o("\n")
    n.o("    std::array<const AtomString, ")
    n.on(@intCast(u64, eventCount))
    n.o("> allEventNames() const;\n")
    n.o("    WTF::HashSet<AtomString> allEventHandlerNames() const;\n\n")
    n.o("    static constexpr std::array timedEvents {\n")
    var timed = false
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        if n.has(e.categories, "EventTimingEligible") {
            timed = true
            ifConditional(e)
            n.o3("        EventType::", e.name, ",\n")
            endConditional(e)
        }
        position += 1
    }
    if !timed { s.fail("make-event-names: KeyError: 'EventTimingEligible'") }
    n.o("    };\n\n")
    n.o("    const AtomString& eventNameFromEventType(EventType) const;\n")
    n.o(HEADER_TAIL)
    n.o("\n")
    n.save(n.path(outputDirectory, "EventNames.h"))

    n.o(SOURCE_HEAD)
    n.o("\n")
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        ifConditional(e)
        n.o5("static constexpr StringImpl::StaticStringImpl ", e.name, "Data(\"", e.name, "\", StringImpl::StringAtom);\n")
        endConditional(e)
        position += 1
    }
    n.o("\nEventNames::EventNames()\n")
    var delimiter = ":"
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        ifConditional(e)
        n.o5("    ", delimiter, " ", e.name, "Event(")
        n.o3(e.name, "Data)\n", "")
        delimiter = ","
        endConditional(e)
        position += 1
    }
    n.o3("    ", delimiter, " m_typeInfoMap({\n")
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        ifConditional(e)
        n.o5("        { \"", e.name, "\"_s, { EventType::", e.name, ", { ")
        var k: usize = 0
        while k < e.categories.count {
            n.o3("EventCategory::", e.categories.items[k], if k + 1 < e.categories.count { ", " } else { " " })
            k += 1
        }
        n.o("}, ")
        n.o(if e.defaultEventHandler { "EventTypeInfo::DefaultEventHandler::Yes" } else { "EventTypeInfo::DefaultEventHandler::No" })
        n.o(" } },\n")
        endConditional(e)
        position += 1
    }
    n.o("    })\n{ }\n\n")
    n.o("std::array<const AtomString, ")
    n.on(@intCast(u64, eventCount))
    n.o("> EventNames::allEventNames() const\n{\n    return { {\n")
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        ifConditional(e)
        n.o3("        ", e.name, "Event,\n")
        endConditional(e)
        position += 1
    }
    n.o(SOURCE_ALL_END)
    n.o("\n}\n\n")
    n.o("WTF::HashSet<AtomString> EventNames::allEventHandlerNames() const\n{\n    WTF::HashSet<AtomString> set;\n")
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        ifConditional(e)
        n.o3("    set.add(\"on", n.lower(e.name), "\"_s);\n")
        endConditional(e)
        position += 1
    }
    n.o("    return set;\n}\n\n")
    n.o("static constexpr std::array<const AtomString EventNames::*, ")
    n.on(@intCast(u64, eventCount))
    n.o("> eventStringInEventNames {\n")
    position = 0
    while position < eventCount {
        const e = events[order[position]]
        ifConditional(e)
        n.o3("    &EventNames::", e.name, "Event,\n")
        endConditional(e)
        position += 1
    }
    n.o("};\n")
    n.o(SOURCE_TAIL)
    n.o("\n")
    n.save(n.path(outputDirectory, "EventNames.cpp"))
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 4 || !std.text.same(std.text.cString(arguments[1]), "--event-names") {
        s.say("usage: webkit-event-names --event-names INPUT OUTPUT_DIRECTORY\n")
        return 2
    }
    generate(std.text.cString(arguments[2]), std.text.cString(arguments[3]))
    return 0
}

