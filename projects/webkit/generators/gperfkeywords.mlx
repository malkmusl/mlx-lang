// gperf's keywords (its KeywordExt) and the linked lists of them it
// reorders (its KeywordExt_List): nodes in arrays, a link of -1 ending a
// list, sorted by gperf's own (unstable) merge sort, so that keywords of
// one hash value come out in the same order.
const s = @import("./support.mlx")
const pos = @import("./gperfpositions.mlx")

pub const Keyword = struct {
    // The keyword (it may hold NUL bytes) and what follows it on its line.
    chars: []const u8
    rest: []const u8
    lineno: i64
    // The selected characters for the hash function (see initSelchars).
    sel: [*]usize
    selLength: usize
    // The next keyword with the same selected characters (-1 for none).
    duplicateLink: i64
    hashValue: i64
    finalIndex: i64
}

const MAX_KEYWORDS: usize = 4194304
pub var keywords: [*]Keyword = undefined
pub var keywordCount: usize = 0

var nodeNext: [*]i64 = undefined
var nodeKeyword: [*]usize = undefined
var nodeCount: usize = 0
var nodeCapacity: usize = 0

pub fn initialize() -> void {
    unsafe { keywords = @ptrFromInt([*]Keyword, s.alloc(MAX_KEYWORDS * @sizeOf(Keyword))) }
    nodeCapacity = 16777216
    unsafe {
        nodeNext = @ptrFromInt([*]i64, s.alloc(nodeCapacity * 8))
        nodeKeyword = @ptrFromInt([*]usize, s.alloc(nodeCapacity * 8))
    }
}

pub fn addKeyword(chars: []const u8, rest: []const u8, lineno: i64) -> usize {
    if keywordCount == MAX_KEYWORDS { s.fail("gperf: too many keywords") }
    // Room for every position of the keyword and its last character.
    var capacity = chars.length + 1
    if capacity > 256 { capacity = 256 }
    var sel: [*]usize = undefined
    unsafe { sel = @ptrFromInt([*]usize, s.alloc(capacity * 8)) }
    keywords[keywordCount] = Keyword.{ .chars = chars, .rest = rest, .lineno = lineno, .sel = sel, .selLength = 0,
        .duplicateLink = -1, .hashValue = 0, .finalIndex = -1 }
    keywordCount += 1
    return keywordCount - 1
}

// ---------------------------------------------------------------------------
// Lists.

pub fn node(keyword: usize) -> i64 {
    if nodeCount == nodeCapacity { s.fail("gperf: out of list nodes") }
    nodeNext[nodeCount] = -1
    nodeKeyword[nodeCount] = keyword
    nodeCount += 1
    return @intCast(i64, nodeCount - 1)
}

pub fn next(list: i64) -> i64 { return nodeNext[@intCast(usize, list)] }
pub fn setNext(list: i64, rest: i64) -> void { nodeNext[@intCast(usize, list)] = rest }
pub fn first(list: i64) -> usize { return nodeKeyword[@intCast(usize, list)] }
pub fn at(list: i64) -> *Keyword { return &keywords[nodeKeyword[@intCast(usize, list)]] }

pub fn copyList(list: i64) -> i64 {
    var result: i64 = -1
    var last: i64 = -1
    var walk = list
    while walk >= 0 {
        const copy = node(first(walk))
        if last < 0 { result = copy } else { setNext(last, copy) }
        last = copy
        walk = next(walk)
    }
    return result
}

pub fn length(list: i64) -> usize {
    var count: usize = 0
    var walk = list
    while walk >= 0 {
        count += 1
        walk = next(walk)
    }
    return count
}

fn lessByHashValue(first: i64, second: i64) -> bool { return at(first).*.hashValue < at(second).*.hashValue }

// gperf's merge: on taking from the second list the two lists change
// places, which is what makes its sort unstable.
fn merge(firstList: i64, secondList: i64) -> i64 {
    var list1 = firstList
    var list2 = secondList
    var result: i64 = -1
    var last: i64 = -1
    while true {
        if list1 < 0 {
            if last < 0 { result = list2 } else { setNext(last, list2) }
            break
        }
        if list2 < 0 {
            if last < 0 { result = list1 } else { setNext(last, list1) }
            break
        }
        if lessByHashValue(list2, list1) {
            if last < 0 { result = list2 } else { setNext(last, list2) }
            last = list2
            const rest = next(list2)
            list2 = list1
            list1 = rest
        } else {
            if last < 0 { result = list1 } else { setNext(last, list1) }
            last = list1
            list1 = next(list1)
        }
    }
    return result
}

pub fn sortByHashValue(list: i64) -> i64 {
    if list < 0 || next(list) < 0 { return list }
    var middle = list
    var walk = next(list)
    while true {
        walk = next(walk)
        if walk < 0 { break }
        walk = next(walk)
        middle = next(middle)
        if walk < 0 { break }
    }
    const rightHalf = next(middle)
    setNext(middle, -1)
    return merge(sortByHashValue(list), sortByHashValue(rightHalf))
}

// ---------------------------------------------------------------------------
// Selected characters.

// The selected characters of KEYWORD for POSITIONS: its byte at each
// position (plus ALPHA_INC's increment there, with INCREMENTS), unified by
// ALPHA_UNIFY (with UNIFY), sorted when MULTISET.
pub fn initSelchars(keyword: *Keyword, positions: *pos.Positions, unify: bool, alphaUnify: [*]usize,
        increments: bool, alphaInc: [*]i64, multiset: bool) -> void {
    const chars = keyword.*.chars
    const length = @intCast(i64, chars.length)
    var index = pos.start(positions, length)
    var count: usize = 0
    while index < positions.*.size {
        const i = positions.*.p[index]
        var c: usize = 0
        if i == pos.LASTCHAR {
            c = @intCast(usize, chars[chars.length - 1])
        } else {
            c = @intCast(usize, chars[@intCast(usize, i)])
            if increments { c += @intCast(usize, alphaInc[@intCast(usize, i)]) }
        }
        if unify { c = alphaUnify[c] }
        keyword.*.sel[count] = c
        count += 1
        index += 1
    }
    keyword.*.selLength = count
    if multiset {
        var j: usize = 1
        while j < count {
            var k = j
            const value = keyword.*.sel[k]
            while k > 0 && value < keyword.*.sel[k - 1] {
                keyword.*.sel[k] = keyword.*.sel[k - 1]
                k -= 1
            }
            keyword.*.sel[k] = value
            j += 1
        }
    }
}
