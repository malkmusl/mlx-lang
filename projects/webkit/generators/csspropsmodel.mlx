// The properties and descriptors of process-css-properties.py, read from
// CSSProperties.json as its from_json functions read them: each
// property's codegen-properties completed with the defaults the script
// computes (kept as the JSON object, which the script also mutates and
// reads its attributes from), its grammar parsed and fixed up, its
// values, initial value, longhands, cascade alias and logical property
// group; the sorted sets the generators walk; and the storage tree of
// Style::ComputedStyle.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const j = @import("./inspectorjsonvalue.mlx")
const c = @import("./csstext.mlx")
const g = @import("./csspropsterms.mlx")

// ---------------------------------------------------------------------------
// JSON objects changed in place.

pub fn newValue(kind: u8, text: []const u8) -> *j.Value {
    const value: *j.Value = unsafe { @ptrFromInt(*j.Value, s.alloc(@sizeOf(j.Value))) }
    value.*.kind = kind
    value.*.text = text
    value.*.integer = false
    value.*.count = 0
    return value
}

pub fn newString(text: []const u8) -> *j.Value { return newValue(j.STRING, text) }
pub fn newBool(on: bool) -> *j.Value { return newValue(if on { j.TRUE } else { j.FALSE }, "") }

pub fn newObject() -> *j.Value {
    const value = newValue(j.OBJECT, "")
    value.*.items = unsafe { @ptrFromInt([*]*j.Value, s.alloc(8)) }
    value.*.keys = unsafe { @ptrFromInt([*][]const u8, s.alloc(16)) }
    return value
}

// OBJECT[KEY] = VALUE (a new key goes last).
pub fn set(object: *j.Value, key: []const u8, value: *j.Value) -> void {
    var index: usize = 0
    while index < object.*.count {
        if std.text.same(object.*.keys[index], key) {
            object.*.items[index] = value
            return
        }
        index += 1
    }
    const count = object.*.count
    const items: [*]*j.Value = unsafe { @ptrFromInt([*]*j.Value, s.alloc((count + 1) * 8)) }
    const keys: [*][]const u8 = unsafe { @ptrFromInt([*][]const u8, s.alloc((count + 1) * @sizeOf([]const u8))) }
    index = 0
    while index < count {
        items[index] = object.*.items[index]
        keys[index] = object.*.keys[index]
        index += 1
    }
    items[count] = value
    keys[count] = key
    object.*.items = items
    object.*.keys = keys
    object.*.count = count + 1
}

pub fn remove(object: *j.Value, key: []const u8) -> void {
    var index: usize = 0
    var kept: usize = 0
    while index < object.*.count {
        if !std.text.same(object.*.keys[index], key) {
            object.*.items[kept] = object.*.items[index]
            object.*.keys[kept] = object.*.keys[index]
            kept += 1
        }
        index += 1
    }
    object.*.count = kept
}

// Python's truth of a JSON value.
pub fn truthy(value: ?*j.Value) -> bool {
    if value == null { return false }
    const v = value.?
    if v.*.kind == j.TRUE { return true }
    if v.*.kind == j.STRING { return v.*.text.length > 0 }
    if v.*.kind == j.ARRAY || v.*.kind == j.OBJECT { return v.*.count > 0 }
    if v.*.kind == j.NUMBER { return !std.text.same(v.*.text, "0") }
    return false
}

pub fn textOf(value: ?*j.Value) -> []const u8 {
    if value == null { return "" }
    if value.?.*.kind != j.STRING { return "" }
    return value.?.*.text
}

pub fn stringList(value: ?*j.Value) -> t.List {
    var result = t.list()
    if value == null { return result }
    var index: usize = 0
    while index < value.?.*.count {
        t.push(&result, value.?.*.items[index].*.text)
        index += 1
    }
    return result
}

// ---------------------------------------------------------------------------
// Defines.

var conditionals: t.List = undefined

pub fn setDefines(defines: []const u8) -> void { conditionals = c.splitSpaces(defines) }

pub fn isEnabled(conditional: []const u8) -> bool {
    if conditional.length > 0 && conditional[0] == 33 { return !t.contains(conditionals, conditional[1..conditional.length]) }
    return t.contains(conditionals, conditional)
}

fn selectEnabledVariant(variants: *j.Value, label: []const u8) -> *j.Value {
    var index: usize = 0
    while index < variants.*.count {
        const variant = variants.*.items[index]
        if !j.has(variant, "enable-if") { s.fail(t.c3("Invalid conditional definition for '", label, "'. No 'enable-if' property found.")) }
        if isEnabled(j.stringAt(variant, "enable-if", "")) { return variant }
        index += 1
    }
    s.fail(t.c3("Invalid conditional definition for '", label, "'. No 'enable-if' property matched the active set."))
    return variants
}

// ---------------------------------------------------------------------------
// The model.

pub const LogicalGroup = struct {
    name: []const u8
    resolver: []const u8
    kind: []const u8
    logic: []const u8
}

// One element of an initial value: KEYWORD, NUMERIC (digits and unit) or SPECIAL.
pub const I_KEYWORD: u8 = 1
pub const I_NUMERIC: u8 = 2
pub const I_SPECIAL: u8 = 3

pub const InitialElement = struct {
    kind: u8
    name: []const u8
    digits: []const u8
    unit: []const u8
}

pub const Initial = struct {
    text: []const u8
    elements: g.Refs
}

pub fn elementAt(l: g.Refs, index: usize) -> *InitialElement { return unsafe { @ptrFromInt(*InitialElement, l.items[index]) } }

pub const Value = struct {
    value: []const u8
    settingsFlag: []const u8
    status: []const u8
    comment: []const u8
    keywordTerm: *g.Term
}

pub fn valueAt(l: g.Refs, index: usize) -> *Value { return unsafe { @ptrFromInt(*Value, l.items[index]) } }

pub const Property = struct {
    name: []const u8
    id: []const u8
    isDescriptor: bool
    descriptorSet: []const u8
    // The property's JSON object and its completed codegen-properties.
    json: *j.Value
    codegen: *j.Value
    hasLonghands: bool
    longhandNames: t.List
    longhands: g.Refs
    cascadeAlias: ?*Property
    logicalGroup: ?*LogicalGroup
    grammar: ?*g.Grammar
    grammarUnused: ?*g.Grammar
    styleBuilderCustom: t.List
    initial: ?*Initial
    hasValues: bool
    values: g.Refs
    aliases: t.List
}

pub fn propertyAt(l: g.Refs, index: usize) -> *Property { return unsafe { @ptrFromInt(*Property, l.items[index]) } }
pub fn propertyOf(address: usize) -> *Property { return unsafe { @ptrFromInt(*Property, address) } }

// The codegen attribute KEY (null for none, as getattr gives None or the default).
pub fn cg(p: *Property, key: []const u8) -> ?*j.Value { return j.get(p.*.codegen, key) }

pub fn cgOn(p: *Property, key: []const u8) -> bool { return truthy(cg(p, key)) }

// A boolean attribute whose default is true.
pub fn cgOnByDefault(p: *Property, key: []const u8) -> bool {
    const value = cg(p, key)
    if value == null { return true }
    return truthy(value)
}

pub fn cgText(p: *Property, key: []const u8) -> []const u8 { return textOf(cg(p, key)) }

// A text attribute as f"{...}" writes it: "None" when absent.
pub fn cgShown(p: *Property, key: []const u8) -> []const u8 {
    const value = cg(p, key)
    if value == null { return "None" }
    if value.?.*.kind == j.NULL { return "None" }
    if value.?.*.kind == j.TRUE { return "True" }
    if value.?.*.kind == j.FALSE { return "False" }
    return value.?.*.text
}

pub fn cgList(p: *Property, key: []const u8) -> t.List { return stringList(cg(p, key)) }

pub fn hasCg(p: *Property, key: []const u8) -> bool { return j.has(p.*.codegen, key) }

// The containers, 'data' unless given.
pub fn cgContainer(p: *Property, key: []const u8) -> []const u8 {
    const value = cg(p, key)
    if value == null { return "data" }
    return textOf(value)
}

pub fn idWithoutScope(p: *Property) -> []const u8 { return s.join("CSSProperty", p.*.id) }
pub fn fullId(p: *Property) -> []const u8 { return s.join("CSSPropertyID::CSSProperty", p.*.id) }
pub fn nameForMethods(p: *Property) -> []const u8 { return t.replaceAll(p.*.id, "Webkit", "") }

pub fn idOrCascadeAliasId(p: *Property) -> []const u8 {
    if p.*.cascadeAlias != null { return fullId(p.*.cascadeAlias.?) }
    return fullId(p)
}

pub fn nameForParsingMethods(p: *Property) -> []const u8 {
    if p.*.isDescriptor { return s.join(g.nameToId(p.*.descriptorSet[1..p.*.descriptorSet.length]), p.*.id) }
    return p.*.id
}

pub fn isLogical(p: *Property) -> bool {
    if p.*.logicalGroup == null { return false }
    return isLogicalResolver(p.*.logicalGroup.?.*.resolver)
}

pub fn animationType(p: *Property) -> []const u8 { return j.stringAt(p.*.json, "animation-type", "") }

pub fn isAnimatable(p: *Property) -> bool {
    const kind = animationType(p)
    return !(std.text.same(kind, "not animatable") || std.text.same(kind, "not animatable (needs triage)") || std.text.same(kind, "not animatable (legacy)") || std.text.same(kind, "not animatable (internal)"))
}

pub fn inherited(p: *Property) -> bool { return !p.*.isDescriptor && j.boolAt(p.*.json, "inherited", false) }

pub fn isSkippedFromComputedStyle(p: *Property) -> bool {
    if cgOn(p, "internal-only") { return true }
    if cgOn(p, "skip-style-extractor") { return true }
    if cgOn(p, "skip-style-builder") && !isLogical(p) && p.*.cascadeAlias == null { return true }
    if p.*.hasLonghands {
        var index: usize = 0
        while index < p.*.longhands.count {
            if !isSkippedFromComputedStyle(propertyAt(p.*.longhands, index)) { return true }
            index += 1
        }
    }
    return false
}

// ---------------------------------------------------------------------------
// Logical property groups.

pub const LOGICAL_AXIS = "inline block"
pub const LOGICAL_SIDE = "block-start inline-end block-end inline-start"
pub const LOGICAL_CORNER = "start-start start-end end-start end-end"
pub const PHYSICAL_AXIS = "horizontal vertical"
pub const PHYSICAL_SIDE = "top right bottom left"
pub const PHYSICAL_CORNER = "top-left top-right bottom-left bottom-right"

// LogicalPropertyGroup.logical_property_group_resolvers[logic][kind].
pub fn resolvers(logic: []const u8, kind: []const u8) -> t.List {
    const logical = std.text.same(logic, "logical")
    if std.text.same(kind, "axis") { return c.splitByte(if logical { LOGICAL_AXIS } else { PHYSICAL_AXIS }, 32) }
    if std.text.same(kind, "side") { return c.splitByte(if logical { LOGICAL_SIDE } else { PHYSICAL_SIDE }, 32) }
    return c.splitByte(if logical { LOGICAL_CORNER } else { PHYSICAL_CORNER }, 32)
}

fn isLogicalResolver(resolver: []const u8) -> bool {
    return t.contains(c.splitByte(LOGICAL_AXIS, 32), resolver) || t.contains(c.splitByte(LOGICAL_SIDE, 32), resolver) || t.contains(c.splitByte(LOGICAL_CORNER, 32), resolver)
}

fn newLogicalGroup(value: *j.Value, path: []const u8) -> *LogicalGroup {
    const group: *LogicalGroup = unsafe { @ptrFromInt(*LogicalGroup, s.alloc(@sizeOf(LogicalGroup))) }
    group.*.name = j.stringAt(value, "name", "")
    group.*.resolver = j.stringAt(value, "resolver", "")
    const logics = [_][]const u8{ "logical", "physical" }
    const kinds = [_][]const u8{ "axis", "side", "corner" }
    for logic in logics {
        for kind in kinds {
            if t.contains(resolvers(logic, kind), group.*.resolver) {
                group.*.kind = kind
                group.*.logic = logic
                return group
            }
        }
    }
    s.fail(t.c3("Unrecognized resolver \"", group.*.resolver, "\""))
    return group
}

// A logical property group's properties: for "logical" and "physical",
// each resolver's property.
pub const Group = struct {
    name: []const u8
    kind: []const u8
    logicalResolvers: t.List
    logical: g.Refs
    physicalResolvers: t.List
    physical: g.Refs
}

pub fn groupAt(l: g.Refs, index: usize) -> *Group { return unsafe { @ptrFromInt(*Group, l.items[index]) } }

// The property of RESOLVER among those of LOGIC in GROUP.
pub fn groupProperty(group: *Group, logic: []const u8, resolver: []const u8) -> *Property {
    const logical = std.text.same(logic, "logical")
    const names = if logical { group.*.logicalResolvers } else { group.*.physicalResolvers }
    const properties = if logical { group.*.logical } else { group.*.physical }
    var index: usize = 0
    while index < names.count {
        if std.text.same(names.items[index], resolver) { return propertyAt(properties, index) }
        index += 1
    }
    s.fail(t.c5("No ", resolver, " property in logical property group ", group.*.name, ""))
    return propertyAt(properties, 0)
}

// ---------------------------------------------------------------------------
// Reading.

fn completeNameFamily(object: *j.Value, family: []const u8, nameForMethodsText: []const u8) -> void {
    const methodsKey = s.join(family, "-name-for-methods")
    if !j.has(object, methodsKey) { set(object, methodsKey, newString(nameForMethodsText)) }
    const methods = j.stringAt(object, methodsKey, "")
    const getterKey = s.join(family, "-getter")
    if !j.has(object, getterKey) { set(object, getterKey, newString(g.lowerFirst(methods))) }
    const setterKey = s.join(family, "-setter")
    if !j.has(object, setterKey) { set(object, setterKey, newString(s.join("set", methods))) }
    const initialKey = s.join(family, "-initial")
    if !j.has(object, initialKey) { set(object, initialKey, newString(s.join("initial", methods))) }
}

fn checkContainer(object: *j.Value, key: []const u8, getterKey: []const u8, setterKey: []const u8, path: []const u8) -> void {
    if !j.has(object, key) { return }
    const container = j.stringAt(object, key, "")
    if !(std.text.same(container, "data") || std.text.same(container, "struct") || std.text.same(container, "physical-group") || std.text.same(container, "opaque")) { s.fail(s.join(path, " must be either 'data', 'struct', 'physical-group' or 'opaque'.")) }
    if std.text.same(container, "opaque") {
        set(object, getterKey, newBool(true))
        set(object, setterKey, newBool(true))
    }
}

fn defaultFrom(object: *j.Value, key: []const u8, from: []const u8) -> void {
    if !j.has(object, key) { set(object, key, j.get(object, from).?) }
}

// The longhands kept by their enable-if (Longhand.from_json).
fn readLonghands(p: *Property, value: *j.Value) -> void {
    p.*.longhandNames = t.list()
    var index: usize = 0
    while index < value.*.count {
        const item = value.*.items[index]
        if item.*.kind == j.STRING {
            t.push(&p.*.longhandNames, item.*.text)
        } else {
            const condition = j.stringAt(item, "enable-if", "")
            if !j.has(item, "enable-if") || isEnabled(condition) { t.push(&p.*.longhandNames, j.stringAt(item, "value", "")) }
        }
        index += 1
    }
}

// The grammar of TEXT, fixed up with the shared rules.
fn grammarOf(name: []const u8, text: []const u8) -> *g.Grammar {
    const grammar = g.grammarFromString(name, text)
    grammar.*.root = g.fixups(grammar.*.root, null)
    return grammar
}

fn readGrammars(p: *Property, object: *j.Value) -> void {
    p.*.grammar = null
    p.*.grammarUnused = null
    if truthy(j.get(object, "parser-grammar")) { p.*.grammar = grammarOf(p.*.name, j.stringAt(object, "parser-grammar", "")) }
    if truthy(j.get(object, "parser-grammar-unused")) {
        if !j.has(object, "parser-grammar-unused-reason") { s.fail(t.c3("'", p.*.name, "' must have 'parser-grammar-unused-reason' specified when using 'parser-grammar-unused'.")) }
        p.*.grammarUnused = grammarOf(p.*.name, j.stringAt(object, "parser-grammar-unused", ""))
    }
}

fn newProperty(name: []const u8, json: *j.Value) -> *Property {
    const p: *Property = unsafe { @ptrFromInt(*Property, s.alloc(@sizeOf(Property))) }
    p.*.name = name
    p.*.id = g.nameToId(name)
    p.*.isDescriptor = false
    p.*.descriptorSet = ""
    p.*.json = json
    p.*.hasLonghands = false
    p.*.longhandNames = t.list()
    p.*.longhands = g.refs()
    p.*.cascadeAlias = null
    p.*.logicalGroup = null
    p.*.grammar = null
    p.*.grammarUnused = null
    p.*.styleBuilderCustom = t.list()
    p.*.initial = null
    p.*.hasValues = false
    p.*.values = g.refs()
    p.*.aliases = t.list()
    return p
}

fn codegenObject(json: *j.Value, path: []const u8) -> *j.Value {
    var object = j.get(json, "codegen-properties")
    if object == null { return newObject() }
    if object.?.*.kind == j.ARRAY { return selectEnabledVariant(object.?, s.join(path, ".codegen-properties")) }
    return object.?
}

// StylePropertyCodeGenProperties.from_json.
fn readStyleCodegen(p: *Property, object: *j.Value, path: []const u8) -> void {
    const methods = nameForMethods(p)
    completeNameFamily(object, "computed-style", methods)
    if j.has(object, "font-property") { completeNameFamily(object, "font-description", methods) }
    if j.has(object, "coordinated-value-list-property") { completeNameFamily(object, "coordinated-value-list-property", methods) }
    if j.has(object, "animation-wrapper-acceleration") {
        const acceleration = j.stringAt(object, "animation-wrapper-acceleration", "")
        if !std.text.same(acceleration, "always") && !std.text.same(acceleration, "threaded-only") { s.fail(s.join(path, " must be either 'always' or 'threaded-only'.")) }
        if std.text.same(acceleration, "threaded-only") && !isEnabled("ENABLE_THREADED_ANIMATIONS") { set(object, "animation-wrapper-acceleration", newValue(j.NULL, "")) }
    }
    if j.has(object, "computed-style-storage-kind") {
        const kind = j.stringAt(object, "computed-style-storage-kind", "")
        if !(std.text.same(kind, "reference") || std.text.same(kind, "value") || std.text.same(kind, "enum") || std.text.same(kind, "raw")) { s.fail(s.join(path, " must be either 'reference', 'value', 'enum' or 'raw'.")) }
        if !j.has(object, "computed-style-initial-constexpr") && (std.text.same(kind, "enum") || std.text.same(kind, "raw")) { set(object, "computed-style-initial-constexpr", newBool(true)) }
    }
    checkContainer(object, "computed-style-storage-container", "computed-style-getter-custom", "computed-style-setter-custom", path)
    checkContainer(object, "computed-style-visited-link-storage-container", "computed-style-visited-link-getter-custom", "computed-style-visited-link-setter-custom", path)
    checkContainer(object, "computed-style-has-explicitly-set-storage-container", "computed-style-has-explicitly-set-getter-custom", "computed-style-has-explicitly-set-setter-custom", path)
    defaultFrom(object, "computed-style-storage-name", "computed-style-getter")
    const methodsName = j.stringAt(object, "computed-style-name-for-methods", "")
    if !j.has(object, "computed-style-visited-link-storage-name") { set(object, "computed-style-visited-link-storage-name", newString(s.join("visitedLink", methodsName))) }
    if !j.has(object, "computed-style-has-explicitly-set-storage-name") { set(object, "computed-style-has-explicitly-set-storage-name", newString(s.join("hasExplicitlySet", methodsName))) }
    if j.has(object, "skip-computed-style") {
        defaultFrom(object, "skip-computed-style-getter", "skip-computed-style")
        defaultFrom(object, "skip-computed-style-initial", "skip-computed-style")
        defaultFrom(object, "skip-computed-style-setter", "skip-computed-style")
        defaultFrom(object, "skip-render-style", "skip-computed-style")
    }
    if j.has(object, "skip-render-style") {
        defaultFrom(object, "skip-render-style-getter", "skip-render-style")
        // (The script sets the setter only when it is already given.)
        if j.has(object, "skip-render-style-setter") { set(object, "skip-render-style-setter", j.get(object, "skip-render-style").?) }
    }
    if j.has(object, "skip-computed-style-getter") { defaultFrom(object, "skip-render-style-getter", "skip-computed-style-getter") }
    if j.has(object, "skip-computed-style-setter") { defaultFrom(object, "skip-render-style-setter", "skip-computed-style-setter") }
    var custom = j.stringAt(object, "style-builder-custom", "")
    if std.text.same(custom, "All") { custom = "Initial|Inherit|Value" }
    p.*.styleBuilderCustom = c.splitByte(custom, 124)
    if j.has(object, "shorthand-pattern") {
        if j.has(object, "shorthand-parser-pattern") { s.fail(s.join(path, " can't specify both 'shorthand-pattern' and 'shorthand-parser-pattern'.")) }
        if j.has(object, "shorthand-style-extractor-pattern") { s.fail(s.join(path, " can't specify both 'shorthand-pattern' and 'shorthand-style-extractor-pattern'.")) }
        set(object, "shorthand-parser-pattern", j.get(object, "shorthand-pattern").?)
        set(object, "shorthand-style-extractor-pattern", j.get(object, "shorthand-pattern").?)
    }
    const group = j.get(object, "logical-property-group")
    if group != null {
        if truthy(j.get(object, "longhands")) { s.fail(s.join(path, " is a shorthand, but belongs to a logical property group.")) }
        p.*.logicalGroup = newLogicalGroup(group.?, path)
    }
    const longhands = j.get(object, "longhands")
    if longhands != null {
        readLonghands(p, longhands.?)
        if p.*.longhandNames.count == 0 {
            remove(object, "longhands")
        } else {
            p.*.hasLonghands = true
            if !j.has(object, "parser-shorthand") { set(object, "parser-shorthand", newString(s.join(g.lowerFirst(p.*.id), "Shorthand"))) }
        }
    }
    if truthy(j.get(object, "top-priority")) && !j.has(object, "top-priority-reason") { s.fail(s.join(path, " has top priority, but no reason justifying it.")) }
    if truthy(j.get(object, "cascade-alias")) && std.text.same(j.stringAt(object, "cascade-alias", ""), p.*.name) { s.fail(s.join(path, " can't have itself as a cascade alias property.")) }
    readGrammars(p, object)
}

fn readInitial(text: []const u8) -> *Initial {
    const initial: *Initial = unsafe { @ptrFromInt(*Initial, s.alloc(@sizeOf(Initial))) }
    initial.*.text = text
    initial.*.elements = g.refs()
    // re.split(r",?\s+", text)
    var parts = t.list()
    var start: usize = 0
    var index: usize = 0
    while index < text.length {
        var end = index
        if text[end] == 44 { end += 1 }
        if end < text.length && s.isSpace(text[end]) {
            while end < text.length && s.isSpace(text[end]) { end += 1 }
            t.push(&parts, text[start..index])
            start = end
            index = end
        } else {
            index += 1
        }
    }
    t.push(&parts, text[start..text.length])
    index = 0
    while index < parts.count {
        const part = parts.items[index]
        const element: *InitialElement = unsafe { @ptrFromInt(*InitialElement, s.alloc(@sizeOf(InitialElement))) }
        element.*.name = part
        element.*.digits = ""
        element.*.unit = ""
        if part.length > 0 && s.isDigit(part[0]) {
            var digits: usize = 0
            while digits < part.length && s.isDigit(part[digits]) { digits += 1 }
            element.*.kind = I_NUMERIC
            element.*.digits = part[0..digits]
            element.*.unit = part[digits..part.length]
        } else if part.length > 0 && part[0] == 64 {
            element.*.kind = I_SPECIAL
        } else {
            element.*.kind = I_KEYWORD
        }
        g.push(&initial.*.elements, @intFromPtr(element))
        index += 1
    }
    return initial
}

// Value.from_json for each item of ITEMS (null for the skipped ones).
fn readValues(p: *Property, items: *j.Value) -> void {
    p.*.hasValues = true
    p.*.values = g.refs()
    var index: usize = 0
    while index < items.*.count {
        var item = items.*.items[index]
        if item.*.kind == j.STRING {
            const object = newObject()
            set(object, "value", item)
            item = object
        }
        const status = j.stringAt(item, "status", "")
        var skip = false
        if j.has(item, "enable-if") && !isEnabled(j.stringAt(item, "enable-if", "")) { skip = true }
        if std.text.same(status, "unimplemented") || std.text.same(status, "removed") || std.text.same(status, "not considering") { skip = true }
        if !skip {
            const value: *Value = unsafe { @ptrFromInt(*Value, s.alloc(@sizeOf(Value))) }
            value.*.value = j.stringAt(item, "value", "")
            value.*.settingsFlag = j.stringAt(item, "settings-flag", "")
            value.*.status = status
            value.*.comment = j.stringAt(item, "comment", "")
            if !std.text.same(status, "internal") && std.text.startsWith(value.*.value, "-internal-") { s.fail(t.c3("Value \"", value.*.value, "\" starts with \"-internal-\" but does not have \"status\": \"internal\" set.")) }
            const keyword = g.newKeyword(value.*.value, null)
            keyword.*.comment = value.*.comment
            keyword.*.settingsFlag = value.*.settingsFlag
            keyword.*.status = status
            value.*.keywordTerm = keyword
            g.push(&p.*.values, @intFromPtr(value))
        }
        index += 1
    }
    var keywords = g.refs()
    index = 0
    while index < p.*.values.count {
        g.push(&keywords, @intFromPtr(valueAt(p.*.values, index).*.keywordTerm))
        index += 1
    }
    if p.*.grammar != null {
        p.*.grammar.?.*.root = g.fixups(p.*.grammar.?.*.root, &keywords)
    } else if p.*.grammarUnused != null {
        p.*.grammarUnused.?.*.root = g.fixups(p.*.grammarUnused.?.*.root, &keywords)
    }
}

const ANIMATION_TYPES = "discrete|by computed value|repeatable list|see prose|not animatable|not animatable (needs triage)|not animatable (legacy)|not animatable (internal)"

// StyleProperty.from_json; null when the property is skipped.
fn readStyleProperty(name: []const u8, json: *j.Value) -> ?*Property {
    const path = s.join("properties.", name)
    const p = newProperty(name, json)
    p.*.codegen = codegenObject(json, path)
    readStyleCodegen(p, p.*.codegen, path)
    p.*.aliases = cgList(p, "aliases")
    if j.has(p.*.codegen, "enable-if") && !isEnabled(cgText(p, "enable-if")) { return null }
    if cgOn(p, "skip-codegen") { return null }
    if j.has(json, "animation-type") {
        if !t.contains(c.splitByte(ANIMATION_TYPES, 124), j.stringAt(json, "animation-type", "")) { s.fail(t.c3("'", name, "' specified invalid animation type.")) }
    } else if !(isLogical(p) || p.*.hasLonghands) {
        s.fail(t.c3("'", name, "' must specify an 'animation-type'."))
    }
    if j.has(json, "initial") {
        p.*.initial = readInitial(j.stringAt(json, "initial", ""))
    } else if !(isLogical(p) || p.*.hasLonghands || cgOn(p, "cascade-alias") || cgOn(p, "skip-style-builder")) {
        s.fail(t.c3("'", name, "' must specify 'initial'."))
    }
    const values = j.get(json, "values")
    if values != null { readValues(p, values.?) }
    return p
}

// Descriptor.from_json; null when the descriptor is skipped.
fn readDescriptor(name: []const u8, json: *j.Value, setName: []const u8) -> ?*Property {
    const path = t.c4("descriptors.", setName, ".", name)
    const p = newProperty(name, json)
    p.*.isDescriptor = true
    p.*.descriptorSet = setName
    p.*.codegen = codegenObject(json, path)
    const longhands = j.get(p.*.codegen, "longhands")
    if longhands != null {
        readLonghands(p, longhands.?)
        if p.*.longhandNames.count == 0 {
            remove(p.*.codegen, "longhands")
        } else {
            p.*.hasLonghands = true
        }
    }
    readGrammars(p, p.*.codegen)
    p.*.aliases = cgList(p, "aliases")
    if j.has(p.*.codegen, "enable-if") && !isEnabled(cgText(p, "enable-if")) { return null }
    if cgOn(p, "skip-codegen") { return null }
    const values = j.get(json, "values")
    if values != null { readValues(p, values.?) }
    return p
}

// ---------------------------------------------------------------------------
// The sets.

pub var styleProperties: g.Refs = undefined
// Sorted by descending priority and name.
pub var styleAll: g.Refs = undefined
pub var descriptorSetNames: t.List = undefined
// Each descriptor set's descriptors in order (Refs of Refs addresses).
pub var descriptorSets: g.Refs = undefined
pub var descriptorSetsSorted: g.Refs = undefined
pub var groups: g.Refs = undefined
// Shorthand by longhand (parallel lists).
var shorthandKeys: g.Refs = undefined
var shorthandValues: g.Refs = undefined

pub fn refsOf(address: usize) -> *g.Refs { return unsafe { @ptrFromInt(*g.Refs, address) } }

fn newRefs() -> *g.Refs {
    const l: *g.Refs = unsafe { @ptrFromInt(*g.Refs, s.alloc(@sizeOf(g.Refs))) }
    l.* = g.refs()
    return l
}

pub fn named(l: g.Refs, name: []const u8) -> ?*Property {
    var index: usize = 0
    while index < l.count {
        if std.text.same(propertyAt(l, index).*.name, name) { return propertyAt(l, index) }
        index += 1
    }
    return null
}

fn bothOn(a: bool, b: bool) -> i32 {
    if a && !b { return 1 }
    if !a && b { return -1 }
    return 0
}

fn logicIs(p: *Property, logic: []const u8) -> bool { return p.*.logicalGroup != null && std.text.same(p.*.logicalGroup.?.*.logic, logic) }

// StyleProperties._sort_with_prefixed_properties_last.
pub fn comparePrefixedLast(a: []const u8, b: []const u8) -> i32 {
    const aPrefixed = a[0] == 45
    const bPrefixed = b[0] == 45
    if aPrefixed && !bPrefixed { return 1 }
    if !aPrefixed && bPrefixed { return -1 }
    if t.before(a, b) { return -1 }
    if t.before(b, a) { return 1 }
    return 0
}

// StyleProperties._sort_by_descending_priority_and_name.
pub fn comparePriority(a: *Property, b: *Property) -> i32 {
    var order = bothOn(a.*.hasLonghands, b.*.hasLonghands)
    if order != 0 { return order }
    order = -bothOn(cgOn(a, "top-priority"), cgOn(b, "top-priority"))
    if order != 0 { return order }
    order = -bothOn(cgOn(a, "high-priority"), cgOn(b, "high-priority"))
    if order != 0 { return order }
    order = -bothOn(cgOn(a, "medium-priority"), cgOn(b, "medium-priority"))
    if order != 0 { return order }
    order = bothOn(logicIs(a, "logical"), logicIs(b, "logical"))
    if order != 0 { return order }
    order = bothOn(logicIs(a, "physical"), logicIs(b, "physical"))
    if order != 0 { return order }
    order = bothOn(cgOn(a, "sink-priority"), cgOn(b, "sink-priority"))
    if order != 0 { return order }
    return comparePrefixedLast(a.*.name, b.*.name)
}

// L sorted (stably) by COMPARE.
pub fn sorted(l: g.Refs, compare: fn(*Property, *Property) -> i32) -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < l.count {
        g.push(&result, l.items[index])
        index += 1
    }
    // A merge sort, stable as Python's.
    var scratch: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc((result.count + 1) * 8)) }
    var width: usize = 1
    while width < result.count {
        var low: usize = 0
        while low < result.count {
            var middle = low + width
            if middle > result.count { middle = result.count }
            var high = low + 2 * width
            if high > result.count { high = result.count }
            var left = low
            var right = middle
            var out = low
            while out < high {
                if left < middle && (right >= high || compare(propertyOf(result.items[right]), propertyOf(result.items[left])) >= 0) {
                    scratch[out] = result.items[left]
                    left += 1
                } else {
                    scratch[out] = result.items[right]
                    right += 1
                }
                out += 1
            }
            low = high
        }
        index = 0
        while index < result.count {
            result.items[index] = scratch[index]
            index += 1
        }
        width *= 2
    }
    return result
}

pub fn compareName(a: *Property, b: *Property) -> i32 {
    if t.before(a.*.name, b.*.name) { return -1 }
    if t.before(b.*.name, a.*.name) { return 1 }
    return 0
}

pub fn compareId(a: *Property, b: *Property) -> i32 {
    const x = fullId(a)
    const y = fullId(b)
    if t.before(x, y) { return -1 }
    if t.before(y, x) { return 1 }
    return 0
}

pub fn compareNamesPrefixedLast(a: *Property, b: *Property) -> i32 { return comparePrefixedLast(a.*.name, b.*.name) }

fn groupNamed(name: []const u8) -> *Group {
    var index: usize = 0
    while index < groups.count {
        if std.text.same(groupAt(groups, index).*.name, name) { return groupAt(groups, index) }
        index += 1
    }
    const group: *Group = unsafe { @ptrFromInt(*Group, s.alloc(@sizeOf(Group))) }
    group.*.name = name
    group.*.kind = ""
    group.*.logicalResolvers = t.list()
    group.*.logical = g.refs()
    group.*.physicalResolvers = t.list()
    group.*.physical = g.refs()
    g.push(&groups, @intFromPtr(group))
    return group
}

// The fixups of the style properties: longhands, cascade aliases, logical groups.
fn fixupProperties() -> void {
    groups = g.refs()
    var index: usize = 0
    while index < styleProperties.count {
        const p = propertyAt(styleProperties, index)
        if p.*.hasLonghands {
            var at: usize = 0
            while at < p.*.longhandNames.count {
                const longhand = named(styleProperties, p.*.longhandNames.items[at])
                if longhand == null { s.fail(t.c4("Unknown longhand ", p.*.longhandNames.items[at], " of ", p.*.name)) }
                g.push(&p.*.longhands, @intFromPtr(longhand.?))
                at += 1
            }
        }
        if cgOn(p, "cascade-alias") {
            const alias = named(styleProperties, cgText(p, "cascade-alias"))
            if alias == null { s.fail(t.c5("Property ", p.*.name, " is a cascade alias for an unknown property: ", cgText(p, "cascade-alias"), ".")) }
            if !cgOn(p, "skip-style-builder") { s.fail(t.c3("Property ", p.*.name, " is a cascade alias and should also set 'skip-style-builder'.")) }
            p.*.cascadeAlias = alias
        }
        if p.*.logicalGroup != null {
            const logical = p.*.logicalGroup.?
            const group = groupNamed(logical.*.name)
            if group.*.kind.length > 0 && !std.text.same(group.*.kind, logical.*.kind) { s.fail(t.c3("Logical property group \"", logical.*.name, "\" has resolvers of different kinds.")) }
            group.*.kind = logical.*.kind
            if std.text.same(logical.*.logic, "logical") {
                if t.contains(group.*.logicalResolvers, logical.*.resolver) { s.fail(t.c5("Logical property group \"", logical.*.name, "\" has multiple \"", logical.*.resolver, "\" properties.")) }
                t.push(&group.*.logicalResolvers, logical.*.resolver)
                g.push(&group.*.logical, @intFromPtr(p))
            } else {
                if t.contains(group.*.physicalResolvers, logical.*.resolver) { s.fail(t.c5("Logical property group \"", logical.*.name, "\" has multiple \"", logical.*.resolver, "\" properties.")) }
                t.push(&group.*.physicalResolvers, logical.*.resolver)
                g.push(&group.*.physical, @intFromPtr(p))
            }
        }
        index += 1
    }
}

fn fixupDescriptors(members: *g.Refs) -> void {
    var index: usize = 0
    while index < members.*.count {
        const p = propertyAt(members.*, index)
        if p.*.hasLonghands {
            var at: usize = 0
            while at < p.*.longhandNames.count {
                const longhand = named(members.*, p.*.longhandNames.items[at])
                if longhand == null { s.fail(t.c4("Unknown longhand ", p.*.longhandNames.items[at], " of ", p.*.name)) }
                g.push(&p.*.longhands, @intFromPtr(longhand.?))
                at += 1
            }
        }
        index += 1
    }
}

pub fn shorthandOf(longhand: *Property) -> ?*Property {
    var index: usize = 0
    while index < shorthandKeys.count {
        if shorthandKeys.items[index] == @intFromPtr(longhand) { return propertyAt(shorthandValues, index) }
        index += 1
    }
    return null
}

// The groups sorted by name.
pub fn sortedGroups() -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < groups.count {
        g.push(&result, groups.items[index])
        index += 1
    }
    index = 1
    while index < result.count {
        const item = result.items[index]
        var at = index
        while at > 0 && t.before(groupAt0(item).*.name, groupAt0(result.items[at - 1]).*.name) {
            result.items[at] = result.items[at - 1]
            at -= 1
        }
        result.items[at] = item
        index += 1
    }
    return result
}

fn groupAt0(address: usize) -> *Group { return unsafe { @ptrFromInt(*Group, address) } }

// ---------------------------------------------------------------------------
// The whole: CSSProperties.json read.

pub fn read(text: []const u8, path: []const u8) -> void {
    const root = j.parse(text, path)
    // The shared grammar rules first.
    const shared = j.get(root, "shared-grammar-rules").?
    var names = t.list()
    var grammars = t.list()
    var unused = t.list()
    var functions = t.list()
    var exported = t.list()
    var index: usize = 0
    while index < shared.*.count {
        const rule = shared.*.items[index]
        t.push(&names, shared.*.keys[index])
        t.push(&grammars, if truthy(j.get(rule, "grammar")) { j.stringAt(rule, "grammar", "") } else { "" })
        t.push(&unused, if truthy(j.get(rule, "grammar-unused")) { j.stringAt(rule, "grammar-unused", "") } else { "" })
        t.push(&functions, if truthy(j.get(rule, "grammar-function")) { j.stringAt(rule, "grammar-function", "") } else { "" })
        t.push(&exported, if j.boolAt(rule, "exported", false) { "yes" } else { "" })
        index += 1
    }
    g.readRules(names, grammars, unused, functions, exported)
    // The style properties.
    const properties = j.get(root, "properties").?
    styleProperties = g.refs()
    index = 0
    while index < properties.*.count {
        const p = readStyleProperty(properties.*.keys[index], properties.*.items[index])
        if p != null { g.push(&styleProperties, @intFromPtr(p.?)) }
        index += 1
    }
    fixupProperties()
    styleAll = sorted(styleProperties, comparePriority)
    shorthandKeys = g.refs()
    shorthandValues = g.refs()
    index = 0
    while index < styleAll.count {
        const shorthand = propertyAt(styleAll, index)
        if shorthand.*.hasLonghands {
            var at: usize = 0
            while at < shorthand.*.longhands.count {
                const longhand = shorthand.*.longhands.items[at]
                var found = false
                var k: usize = 0
                while k < shorthandKeys.count {
                    if shorthandKeys.items[k] == longhand {
                        shorthandValues.items[k] = @intFromPtr(shorthand)
                        found = true
                    }
                    k += 1
                }
                if !found {
                    g.push(&shorthandKeys, longhand)
                    g.push(&shorthandValues, @intFromPtr(shorthand))
                }
                at += 1
            }
        }
        index += 1
    }
    // The descriptors.
    const descriptors = j.get(root, "descriptors").?
    descriptorSetNames = t.list()
    descriptorSets = g.refs()
    descriptorSetsSorted = g.refs()
    index = 0
    while index < descriptors.*.count {
        const setName = descriptors.*.keys[index]
        const items = descriptors.*.items[index]
        const members = newRefs()
        var at: usize = 0
        while at < items.*.count {
            const p = readDescriptor(items.*.keys[at], items.*.items[at], setName)
            if p != null { g.push(members, @intFromPtr(p.?)) }
            at += 1
        }
        fixupDescriptors(members)
        t.push(&descriptorSetNames, setName)
        g.push(&descriptorSets, @intFromPtr(members))
        const sortedSet = newRefs()
        sortedSet.* = sorted(members.*, comparePriority)
        g.push(&descriptorSetsSorted, @intFromPtr(sortedSet))
        index += 1
    }
}

// Descriptors.all: each set's sorted descriptors, the sets in order.
pub fn allDescriptors() -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < descriptorSetsSorted.count {
        const set = refsOf(descriptorSetsSorted.items[index])
        var at: usize = 0
        while at < set.*.count {
            g.push(&result, set.*.items[at])
            at += 1
        }
        index += 1
    }
    return result
}

// all_properties_and_descriptors.
pub fn allPropertiesAndDescriptors() -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < styleAll.count {
        g.push(&result, styleAll.items[index])
        index += 1
    }
    const descriptors = allDescriptors()
    index = 0
    while index < descriptors.count {
        g.push(&result, descriptors.items[index])
        index += 1
    }
    return result
}

var uniqueMemo: ?*g.Refs = null

// all_unique: the style properties and the descriptors of other names, sorted.
pub fn allUnique() -> g.Refs {
    if uniqueMemo != null { return uniqueMemo.?.* }
    var result = g.refs()
    var names = t.list()
    var index: usize = 0
    while index < styleAll.count {
        g.push(&result, styleAll.items[index])
        index += 1
    }
    index = 0
    while index < styleProperties.count {
        t.push(&names, propertyAt(styleProperties, index).*.name)
        index += 1
    }
    const descriptors = allDescriptors()
    index = 0
    while index < descriptors.count {
        const descriptor = propertyAt(descriptors, index)
        if !t.contains(names, descriptor.*.name) {
            g.push(&result, descriptors.items[index])
            t.push(&names, descriptor.*.name)
        }
        index += 1
    }
    const memo = newRefs()
    memo.* = sorted(result, comparePriority)
    uniqueMemo = memo
    return memo.*
}

// all_by_name[NAME]: every property and descriptor of that name.
pub fn allNamed(name: []const u8) -> g.Refs {
    var result = g.refs()
    const all = allPropertiesAndDescriptors()
    var index: usize = 0
    while index < all.count {
        if std.text.same(propertyAt(all, index).*.name, name) { g.push(&result, all.items[index]) }
        index += 1
    }
    return result
}

// all_unique_with_settings_flag.
pub fn allUniqueWithSettingsFlag() -> g.Refs {
    var result = g.refs()
    const unique = allUnique()
    var index: usize = 0
    while index < unique.count {
        const group = allNamed(propertyAt(unique, index).*.name)
        var all = true
        var at: usize = 0
        while at < group.count {
            if !cgOn(propertyAt(group, at), "settings-flag") { all = false }
            at += 1
        }
        if all { g.push(&result, group.items[0]) }
        index += 1
    }
    return result
}

pub fn allDescriptorOnly() -> g.Refs {
    var result = g.refs()
    const descriptors = allDescriptors()
    var index: usize = 0
    while index < descriptors.count {
        if named(styleProperties, propertyAt(descriptors, index).*.name) == null { g.push(&result, descriptors.items[index]) }
        index += 1
    }
    return result
}

// settings_flags: unique and sorted.
pub fn settingsFlags() -> t.List {
    var result = t.list()
    const all = allPropertiesAndDescriptors()
    var index: usize = 0
    while index < all.count {
        const flag = cgText(propertyAt(all, index), "settings-flag")
        if flag.length > 0 && !t.contains(result, flag) { t.push(&result, flag) }
        index += 1
    }
    t.sort(&result)
    return result
}

var computedMemo: ?*g.Refs = null

// all_computed: the properties not skipped from computed style, prefixed ones last.
pub fn allComputed() -> g.Refs {
    if computedMemo != null { return computedMemo.?.* }
    var result = g.refs()
    var index: usize = 0
    while index < styleAll.count {
        if !isSkippedFromComputedStyle(propertyAt(styleAll, index)) { g.push(&result, styleAll.items[index]) }
        index += 1
    }
    const memo = newRefs()
    memo.* = sorted(result, compareNamesPrefixedLast)
    computedMemo = memo
    return memo.*
}

pub fn allShorthands() -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < styleAll.count {
        if propertyAt(styleAll, index).*.hasLonghands { g.push(&result, styleAll.items[index]) }
        index += 1
    }
    return result
}

pub fn allNonShorthands() -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < styleAll.count {
        if !propertyAt(styleAll, index).*.hasLonghands { g.push(&result, styleAll.items[index]) }
        index += 1
    }
    return result
}

// all_direction_aware_properties: each group's logical properties by name.
pub fn allDirectionAware() -> g.Refs {
    var result = g.refs()
    const sortedList = sortedGroups()
    var index: usize = 0
    while index < sortedList.count {
        const group = groupAt(sortedList, index)
        const logical = sorted(group.*.logical, compareName)
        var at: usize = 0
        while at < logical.count {
            g.push(&result, logical.items[at])
            at += 1
        }
        index += 1
    }
    return result
}

// all_in_logical_property_group: each group's logical, then physical properties by name.
pub fn allInLogicalPropertyGroup() -> g.Refs {
    var result = g.refs()
    const sortedList = sortedGroups()
    var index: usize = 0
    while index < sortedList.count {
        const group = groupAt(sortedList, index)
        const logical = sorted(group.*.logical, compareName)
        var at: usize = 0
        while at < logical.count {
            g.push(&result, logical.items[at])
            at += 1
        }
        const physical = sorted(group.*.physical, compareName)
        at = 0
        while at < physical.count {
            g.push(&result, physical.items[at])
            at += 1
        }
        index += 1
    }
    return result
}

pub fn allNonInternalOnly() -> g.Refs {
    var result = g.refs()
    var index: usize = 0
    while index < styleAll.count {
        if !cgOn(propertyAt(styleAll, index), "internal-only") { g.push(&result, styleAll.items[index]) }
        index += 1
    }
    return result
}

// ---------------------------------------------------------------------------
// The storage of Style::ComputedStyle (ComputedStyleStorageTreeNode).

pub const StorageNode = struct {
    name: []const u8
    kind: []const u8
    children: g.Refs
    properties: g.Refs
    visitedLinkProperties: g.Refs
}

pub fn storageAt(l: g.Refs, index: usize) -> *StorageNode { return unsafe { @ptrFromInt(*StorageNode, l.items[index]) } }

fn newStorageNode(name: []const u8) -> *StorageNode {
    const n: *StorageNode = unsafe { @ptrFromInt(*StorageNode, s.alloc(@sizeOf(StorageNode))) }
    n.*.name = name
    n.*.kind = "data"
    n.*.children = g.refs()
    n.*.properties = g.refs()
    n.*.visitedLinkProperties = g.refs()
    return n
}

fn storageChild(n: *StorageNode, name: []const u8) -> *StorageNode {
    var index: usize = 0
    while index < n.*.children.count {
        if std.text.same(storageAt(n.*.children, index).*.name, name) { return storageAt(n.*.children, index) }
        index += 1
    }
    const child = newStorageNode(name)
    g.push(&n.*.children, @intFromPtr(child))
    return child
}

var storageMemo: ?*StorageNode = null

pub fn storageModel() -> *StorageNode {
    if storageMemo != null { return storageMemo.? }
    const root = newStorageNode("ComputedStyle")
    var index: usize = 0
    while index < styleAll.count {
        const p = propertyAt(styleAll, index)
        index += 1
        if cgOn(p, "skip-computed-style") || isLogical(p) || p.*.hasLonghands || cgOn(p, "cascade-alias") { continue }
        const path = cgList(p, "computed-style-storage-path")
        if path.count == 0 { s.fail(t.c3("Missing ComputedStyle storage path for property ", fullId(p), ".")) }
        var n = root
        var at: usize = 0
        while at < path.count {
            n = storageChild(n, path.items[at])
            at += 1
        }
        const container = cgContainer(p, "computed-style-storage-container")
        if !std.text.same(n.*.kind, "data") && !std.text.same(n.*.kind, container) { s.fail(t.c3("Storage container '", t.joined(path, "/"), "' has multiple container kinds specified.")) }
        n.*.kind = container
        g.push(&n.*.properties, @intFromPtr(p))
        const visited = cgList(p, "computed-style-visited-link-storage-path")
        if visited.count > 0 {
            n = root
            at = 0
            while at < visited.count {
                n = storageChild(n, visited.items[at])
                at += 1
            }
            const visitedContainer = cgContainer(p, "computed-style-visited-link-storage-container")
            if !std.text.same(n.*.kind, "data") && !std.text.same(n.*.kind, visitedContainer) { s.fail(t.c3("Storage container '", t.joined(visited, "/"), "' has multiple container kinds specified.")) }
            n.*.kind = visitedContainer
            g.push(&n.*.visitedLinkProperties, @intFromPtr(p))
        }
    }
    storageMemo = root
    return root
}
