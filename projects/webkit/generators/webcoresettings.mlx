// WebCore's Settings class and the InternalSettings bindings made from the
// preferences, as Source/WebCore/Scripts/GenerateSettings.rb makes them
// with its ERB templates (Source/WebCore/Scripts/SettingsTemplates):
//
//     webkit-settings [--outputDir DIR] --template TEMPLATE.erb [--template ...] SETTINGS.yaml...
//
// The YAML files (UnifiedWebPreferences.yaml, then WebCore's
// page/Settings.yaml) must have their names in sorted order. A preference
// without a webcoreBinding is a setting of WebCore::Settings; one bound
// to DeprecatedGlobalSettings only counts for the global unstable
// features. A name met again in a later file replaces the earlier
// setting, in its place. Each template gives the file of its name without
// .erb in the output directory: Settings.h, Settings.cpp,
// InternalSettingsGenerated.h, .cpp and .idl. The templates' logic is
// written out here, their text kept to the byte.
const std = @import("std")
const s = @import("./support.mlx")
const yaml = @import("./preferencesyaml.mlx")

const Setting = struct {
    // The name as the YAML file has it, and as WebCore names it.
    key: []const u8
    name: []const u8
    options: usize
    // refinedType, or else type.
    valueType: []const u8
    status: []const u8
    hasStatus: bool
    // The WebCore defaults: a mapping of conditions to values.
    defaultValues: usize
    excludeFromInternalSettings: bool
    disableInLockdownMode: bool
    condition: []const u8
    hasCondition: bool
    onChange: []const u8
    hasOnChange: bool
    getter: []const u8
    hasGetter: bool
    inspectorOverride: bool
    customImplementation: bool
}

const MAX_SETTINGS: usize = 8192

// The settings of WebCore::Settings and the global ones, in the order the
// files first name them.
var settings: [*]Setting = undefined
var settingCount: usize = 0
var globals: [*]Setting = undefined
var globalCount: usize = 0
// The settings by name (indexes into settings).
var sorted: [*]usize = undefined
// The conditions, sorted, without repeats.
var conditions: [*][]const u8 = undefined
var conditionCount: usize = 0

fn exitWith(status: usize) -> void { const ignored = std.linux.syscall1(231, status) }

fn oneOf(value: []const u8, words: []const u8) -> bool {
    var from: usize = 0
    var at: usize = 0
    while at <= words.length {
        if at == words.length || words[at] == 32 {
            if std.text.same(value, words[from..at]) { return true }
            from = at + 1
        }
        at += 1
    }
    return false
}

// Whether FIRST sorts before SECOND, byte by byte (as Ruby compares
// strings).
fn less(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

// TEXT with its first COUNT letters made small (Ruby downcase on name[0..n]).
fn lowered(text: []const u8, count: usize) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        var byte = text[index]
        if index < count && byte >= 65 && byte <= 90 { byte += 32 }
        s.put8(at + index, byte)
        index += 1
    }
    return s.bytes(at, text.length)
}

// TEXT with its first COUNT letters made capital.
fn raised(text: []const u8, count: usize) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        var byte = text[index]
        if index < count && byte >= 97 && byte <= 122 { byte -= 32 }
        s.put8(at + index, byte)
        index += 1
    }
    return s.bytes(at, text.length)
}

// Whether TEXT starts with one of the space-separated PREFIXES.
fn startsWithAny(text: []const u8, prefixes: []const u8) -> bool {
    var from: usize = 0
    var at: usize = 0
    while at <= prefixes.length {
        if at == prefixes.length || prefixes[at] == 32 {
            if std.text.startsWith(text, prefixes[from..at]) { return true }
            from = at + 1
        }
        at += 1
    }
    return false
}

// The name WebCore gives a preference: its webcoreName, or the name with
// its first letter, or its leading acronym, made small.
fn webcoreName(name: []const u8, options: usize) -> []const u8 {
    const given = yaml.get(options, "webcoreName")
    if yaml.truthy(given) { return yaml.textOf(given) }
    if std.text.startsWith(name, "VP") { return lowered(name, 2) }
    if startsWithAny(name, "CSSOM HTTPS") { return name }
    if startsWithAny(name, "URL CSS XSS FTP DOM DNS PDF ICE HDR RTC SVG") { return lowered(name, 3) }
    if startsWithAny(name, "HTTP HTML") { return lowered(name, 4) }
    return lowered(name, 1)
}

fn newSetting(key: []const u8, options: usize) -> Setting {
    var valueType = yaml.get(options, "refinedType")
    if !yaml.truthy(valueType) { valueType = yaml.get(options, "type") }
    const status = yaml.get(options, "status")
    const condition = yaml.get(options, "condition")
    const onChange = yaml.get(options, "webcoreOnChange")
    const getter = yaml.get(options, "webcoreGetter")
    return Setting.{ .key = key, .name = webcoreName(key, options), .options = options,
        .valueType = yaml.rubyText(valueType), .status = yaml.textOf(status), .hasStatus = yaml.truthy(status),
        .defaultValues = yaml.get(yaml.get(options, "defaultValue"), "WebCore"),
        .excludeFromInternalSettings = yaml.truthy(yaml.get(options, "webcoreExcludeFromInternalSettings")),
        .disableInLockdownMode = yaml.truthy(yaml.get(options, "disableInLockdownMode")),
        .condition = yaml.textOf(condition), .hasCondition = yaml.truthy(condition),
        .onChange = yaml.textOf(onChange), .hasOnChange = !yaml.isNull(onChange),
        .getter = yaml.textOf(getter), .hasGetter = yaml.truthy(getter),
        .inspectorOverride = yaml.isTrue(yaml.get(options, "inspectorOverride")),
        .customImplementation = std.text.same(yaml.textOf(yaml.get(options, "webcoreImplementation")), "custom") }
}

fn isValueType(p: *const Setting) -> bool { return !std.text.same(p.*.valueType, "String") && !std.text.same(p.*.valueType, "URL") }

// The IDL type of the setting, or "" when it has none.
fn idlType(p: *const Setting) -> []const u8 {
    if std.text.same(p.*.valueType, "uint32_t") { return "unsigned long" }
    if std.text.same(p.*.valueType, "double") { return "double" }
    if std.text.same(p.*.valueType, "String") { return "DOMString" }
    if std.text.same(p.*.valueType, "bool") { return "boolean" }
    return ""
}

fn parameterType(p: *const Setting) -> []const u8 {
    if isValueType(p) { return p.*.valueType }
    return s.join3("const ", p.*.valueType, "&")
}

fn hasComplexSetter(p: *const Setting) -> bool { return p.*.hasOnChange }
fn hasComplexGetter(p: *const Setting) -> bool { return p.*.inspectorOverride }

fn setterFunctionName(p: *const Setting) -> []const u8 {
    const name = p.*.name
    if std.text.startsWith(name, "html") { return s.join("set", raised(name, 4)) }
    if startsWithAny(name, "url css xss ftp dom dns ice hdr pdf rtc svg") { return s.join("set", raised(name, 3)) }
    if std.text.startsWith(name, "vp") { return s.join("set", raised(name, 2)) }
    return s.join("set", raised(name, 1))
}

fn getterFunctionName(p: *const Setting) -> []const u8 {
    if p.*.hasGetter { return p.*.getter }
    return p.*.name
}

fn stableFeature(p: *const Setting) -> bool { return !p.*.hasStatus || oneOf(p.*.status, "embedder internal stable mature") }

// In the InternalSettings bindings.
fn internal(p: *const Setting) -> bool { return !p.*.excludeFromInternalSettings && idlType(p).length != 0 }

// ---------------------------------------------------------------------------
// The settings files.

// Where the setting named KEY is in LIST, or COUNT.
fn indexOf(list: [*]Setting, count: usize, key: []const u8) -> usize {
    var index: usize = 0
    while index < count {
        if std.text.same(list[index].key, key) { return index }
        index += 1
    }
    return count
}

fn readFile(path: []const u8) -> void {
    const top = yaml.load(path)
    if yaml.nodes[top].kind != yaml.MAPPING { s.fail(s.join("webkit-settings: not a mapping: ", path)) }
    var previous = yaml.NONE
    var entry = yaml.nodes[top].first
    while entry != yaml.NONE {
        if previous != yaml.NONE && less(yaml.nodes[entry].key, yaml.nodes[previous].key) {
            s.say(s.join3(s.join3("ERROR: Input file ", path, " is not sorted. First out of order name found is '"), yaml.nodes[entry].key, "'.\n"))
            exitWith(255)
        }
        previous = entry
        entry = yaml.nodes[entry].next
    }
    entry = yaml.nodes[top].first
    while entry != yaml.NONE {
        const key = yaml.nodes[entry].key
        const binding = yaml.get(entry, "webcoreBinding")
        if !yaml.truthy(binding) {
            const at = indexOf(settings, settingCount, key)
            if at == settingCount {
                if settingCount == MAX_SETTINGS { s.fail("webkit-settings: too many settings") }
                settingCount += 1
            }
            settings[at] = newSetting(key, entry)
        } else if std.text.same(yaml.textOf(binding), "DeprecatedGlobalSettings") {
            const at = indexOf(globals, globalCount, key)
            if at == globalCount {
                if globalCount == MAX_SETTINGS { s.fail("webkit-settings: too many settings") }
                globalCount += 1
            }
            globals[at] = newSetting(key, entry)
        }
        entry = yaml.nodes[entry].next
    }
}

// The settings sorted by name, and their conditions.
fn organize() -> void {
    unsafe {
        sorted = @ptrFromInt([*]usize, s.alloc((settingCount + 1) * 8))
        conditions = @ptrFromInt([*][]const u8, s.alloc((settingCount + 1) * 16))
    }
    var index: usize = 0
    while index < settingCount {
        var at = index
        while at > 0 && less(settings[index].name, settings[sorted[at - 1]].name) {
            sorted[at] = sorted[at - 1]
            at -= 1
        }
        sorted[at] = index
        index += 1
    }
    index = 0
    while index < settingCount {
        const p = &settings[index]
        index += 1
        if !p.*.hasCondition { continue }
        var known = false
        var c: usize = 0
        while c < conditionCount {
            if std.text.same(conditions[c], p.*.condition) { known = true }
            c += 1
        }
        if known { continue }
        var at = conditionCount
        while at > 0 && less(p.*.condition, conditions[at - 1]) {
            conditions[at] = conditions[at - 1]
            at -= 1
        }
        conditions[at] = p.*.condition
        conditionCount += 1
    }
}

// The settings of condition group GROUP, in name order: group 0 holds
// those without a condition, group N those of the Nth condition.
fn inGroup(p: *const Setting, group: usize) -> bool {
    if group == 0 { return !p.*.hasCondition }
    return p.*.hasCondition && std.text.same(p.*.condition, conditions[group - 1])
}

// What a group's list (as the templates name them) keeps.
const ALL: u8 = 0
const BOOL: u8 = 1
const NON_BOOL: u8 = 2
const COMPLEX_GETTER: u8 = 3
const COMPLEX_SETTER: u8 = 4

fn kept(p: *const Setting, kind: u8, needingImplementation: bool) -> bool {
    if needingImplementation && p.*.customImplementation { return false }
    if kind == BOOL { return std.text.same(p.*.valueType, "bool") }
    if kind == NON_BOOL { return !std.text.same(p.*.valueType, "bool") }
    if kind == COMPLEX_GETTER { return hasComplexGetter(p) }
    if kind == COMPLEX_SETTER { return hasComplexSetter(p) }
    return true
}

fn groupHas(group: usize, kind: u8, needingImplementation: bool) -> bool {
    var index: usize = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        if inGroup(p, group) && kept(p, kind, needingImplementation) { return true }
        index += 1
    }
    return false
}

fn groupCount() -> usize { return conditionCount + 1 }

fn groupCondition(group: usize) -> []const u8 {
    if group == 0 { return "" }
    return conditions[group - 1]
}

// ---------------------------------------------------------------------------
// Writing.

fn o(text: []const u8) -> void { s.out(text) }

fn ifCondition(group: usize) -> void {
    if group != 0 {
        o("#if ")
        o(conditions[group - 1])
        o("\n")
    }
}

fn endCondition(group: usize) -> void { if group != 0 { o("#endif\n") } }

fn ifSetting(p: *const Setting) -> void {
    if p.*.hasCondition {
        o("#if ")
        o(p.*.condition)
        o("\n")
    }
}

fn endSetting(p: *const Setting) -> void { if p.*.hasCondition { o("#endif\n") } }

const LICENSE = "/*\n * THIS FILE WAS AUTOMATICALLY GENERATED, DO NOT EDIT.\n *\n * Copyright (C) 2017-2020 Apple Inc. All rights reserved.\n *\n * Redistribution and use in source and binary forms, with or without\n * modification, are permitted provided that the following conditions\n * are met:\n * 1. Redistributions of source code must retain the above copyright\n *    notice, this list of conditions and the following disclaimer.\n * 2. Redistributions in binary form must reproduce the above copyright\n *    notice, this list of conditions and the following disclaimer in the\n *    documentation and/or other materials provided with the distribution.\n *\n * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''\n * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,\n * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR\n * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS\n * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\n * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\n * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF\n * THE POSSIBILITY OF SUCH DAMAGE.\n */\n\n"

// For each group with KIND settings: its condition, then for each one
// PREFIX name INFIX name SUFFIX.
fn eachInGroups(kind: u8, prefix: []const u8, infix: []const u8, suffix: []const u8, withType: bool) -> void {
    var group: usize = 0
    while group < groupCount() {
        if groupHas(group, kind, true) {
            ifCondition(group)
            var index: usize = 0
            while index < settingCount {
                const p = &settings[sorted[index]]
                index += 1
                if !inGroup(p, group) || !kept(p, kind, true) { continue }
                o(prefix)
                if withType {
                    o(p.*.valueType)
                    o(" ")
                }
                o(p.*.name)
                if infix.length != 0 {
                    o(infix)
                    o(p.*.name)
                }
                o(suffix)
            }
            endCondition(group)
        }
        group += 1
    }
}

// ---------------------------------------------------------------------------
// Settings.h.erb

fn settingsHeader() -> void {
    o(LICENSE)
    o("#pragma once\n\n#include <WebCore/SettingsBase.h>\n#include <wtf/RefCounted.h>\n\nnamespace WebCore {\n\nclass Page;\n\nstruct SettingsValues {\n    void initialize();\n    SettingsValues isolatedCopy() const;\n\n")
    var index: usize = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !p.*.inspectorOverride { continue }
        o("    std::optional<")
        o(p.*.valueType)
        o("> ")
        o(p.*.name)
        o("InspectorOverride;\n")
    }
    o("\n    FontGenericFamilies fontGenericFamilies;\n")
    eachInGroups(NON_BOOL, "    ", "", ";\n", true)
    var group: usize = 0
    while group < groupCount() {
        if groupHas(group, ALL, true) {
            ifCondition(group)
            index = 0
            while index < settingCount {
                const p = &settings[sorted[index]]
                index += 1
                if !inGroup(p, group) || !kept(p, BOOL, true) { continue }
                o("    ")
                o(p.*.valueType)
                o(" ")
                o(p.*.name)
                o(" : 1;\n")
            }
            endCondition(group)
        }
        group += 1
    }
    o("};\n\nclass Settings : public SettingsBase, public RefCounted<Settings> {\n    WTF_MAKE_NONCOPYABLE(Settings);\n    WTF_MAKE_TZONE_ALLOCATED(Settings);\npublic:\n    WEBCORE_EXPORT static Ref<Settings> create(Page*);\n    WEBCORE_EXPORT virtual ~Settings();\n\n    void ref() const final { RefCounted::ref(); }\n    void deref() const final { RefCounted::deref(); }\n\n    WEBCORE_EXPORT void disableUnstableFeaturesForModernWebKit();\n    WEBCORE_EXPORT static void disableGlobalUnstableFeaturesForModernWebKit();\n    WEBCORE_EXPORT void disableFeaturesForLockdownMode();\n\n")
    group = 0
    while group < groupCount() {
        ifCondition(group)
        index = 0
        while index < settingCount {
            const p = &settings[sorted[index]]
            index += 1
            if !inGroup(p, group) || !kept(p, ALL, true) { continue }
            const parameter = parameterType(p)
            if hasComplexGetter(p) {
                o("    WEBCORE_EXPORT ")
                o(parameter)
                o(" ")
                o(getterFunctionName(p))
                o("() const;\n")
            } else {
                o("    ")
                o(parameter)
                o(" ")
                o(getterFunctionName(p))
                o("() const { return m_values.")
                o(p.*.name)
                o("; }\n")
            }
            if hasComplexSetter(p) {
                o("    WEBCORE_EXPORT void ")
                o(setterFunctionName(p))
                o("(")
                o(parameter)
                o(");\n")
            } else {
                o("    void ")
                o(setterFunctionName(p))
                o("(")
                o(parameter)
                o(" ")
                o(p.*.name)
                o(") { m_values.")
                o(p.*.name)
                o(" = ")
                o(p.*.name)
                o("; }\n")
            }
        }
        endCondition(group)
        group += 1
    }
    o("\n")
    index = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !p.*.inspectorOverride { continue }
        if hasComplexSetter(p) {
            o("    WEBCORE_EXPORT void ")
            o(setterFunctionName(p))
            o("InspectorOverride(std::optional<")
            o(parameterType(p))
            o(">);\n")
        } else {
            o("    void ")
            o(setterFunctionName(p))
            o("InspectorOverride(std::optional<")
            o(parameterType(p))
            o("> ")
            o(p.*.name)
            o("InspectorOverride) { m_values.")
            o(p.*.name)
            o("InspectorOverride = ")
            o(p.*.name)
            o("InspectorOverride; }\n")
        }
    }
    o("    FontGenericFamilies& fontGenericFamilies() final { return m_values.fontGenericFamilies; }\n    const FontGenericFamilies& fontGenericFamilies() const final { return m_values.fontGenericFamilies; }\n\n    const SettingsValues& values() const { return m_values; }\n\nprivate:\n    WEBCORE_EXPORT explicit Settings(Page*);\n\n    SettingsValues m_values;\n};\n\n}\n\n")
}

// ---------------------------------------------------------------------------
// Settings.cpp.erb

fn entryCount(mapping: usize) -> usize {
    if mapping == yaml.NONE || yaml.nodes[mapping].kind != yaml.MAPPING { return 0 }
    var count: usize = 0
    var entry = yaml.nodes[mapping].first
    while entry != yaml.NONE {
        count += 1
        entry = yaml.nodes[entry].next
    }
    return count
}

fn defaultValue(p: *const Setting) -> void {
    const values = p.*.defaultValues
    if p.*.defaultValues == yaml.NONE { s.fail(s.join("webkit-settings: no WebCore default for ", p.*.key)) }
    const count = entryCount(values)
    if count == 1 {
        const value = yaml.rubyText(yaml.get(values, "default"))
        o("#define SETTING_DEFAULT_VALUE_FOR_")
        o(p.*.name)
        o(" ")
        o(value)
        if std.text.same(p.*.valueType, "String") && std.text.endsWith(value, "\"") { o("_s") }
        o("\n")
        return
    }
    var index: usize = 0
    var entry = yaml.nodes[values].first
    while entry != yaml.NONE {
        if index == 0 {
            o("#if ")
            o(yaml.nodes[entry].key)
            o("\n")
        } else if index != count - 1 {
            o("#elif ")
            o(yaml.nodes[entry].key)
            o("\n")
        } else {
            o("#else\n")
        }
        o("#define SETTING_DEFAULT_VALUE_FOR_")
        o(p.*.name)
        o(" ")
        o(yaml.rubyText(entry))
        o("\n")
        index += 1
        entry = yaml.nodes[entry].next
    }
    o("#endif\n")
}

fn settingsImplementation() -> void {
    o(LICENSE)
    o("#include \"config.h\"\n#include \"Settings.h\"\n\n#include \"DeprecatedGlobalSettings.h\"\n#include \"InspectorInstrumentation.h\"\n#include \"Page.h\"\n\n// Default values.\n\n")
    var index: usize = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        ifSetting(p)
        defaultValue(p)
        endSetting(p)
    }
    o("\nnamespace WebCore {\n\nWTF_MAKE_TZONE_ALLOCATED_IMPL(Settings);\n\nRef<Settings> Settings::create(Page* page)\n{\n    return adoptRef(*new Settings(page));\n}\n\nSettings::Settings(Page* page)\n    : SettingsBase(page)\n{\n    m_values.initialize();\n\n    m_page = nullptr; // Page is not yet fully initialized when constructing Settings, so keeping m_page null over initializeDefaultFontFamilies() call.\n    initializeDefaultFontFamilies();\n    m_page = page;\n}\n\nvoid SettingsValues::initialize()\n{\n")
    eachInGroups(NON_BOOL, "    ", " = SETTING_DEFAULT_VALUE_FOR_", ";\n", false)
    eachInGroups(BOOL, "    ", " = SETTING_DEFAULT_VALUE_FOR_", ";\n", false)
    o("}\n\nSettingsValues SettingsValues::isolatedCopy() const\n{\n    return {\n")
    index = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !p.*.inspectorOverride { continue }
        o("        crossThreadCopy(")
        o(p.*.name)
        o("InspectorOverride),\n")
    }
    o("        crossThreadCopy(fontGenericFamilies),\n")
    eachInGroups(NON_BOOL, "        crossThreadCopy(", "", "),\n", false)
    eachInGroups(BOOL, "        crossThreadCopy(", "", "),\n", false)
    o("    };\n}\n\nSettings::~Settings() = default;\n\nvoid Settings::disableUnstableFeaturesForModernWebKit()\n{\n")
    index = 0
    while index < settingCount {
        const p = &settings[index]
        index += 1
        if stableFeature(p) { continue }
        ifSetting(p)
        o("    ")
        o(setterFunctionName(p))
        o("(false);\n")
        endSetting(p)
    }
    o("}\n\nvoid Settings::disableGlobalUnstableFeaturesForModernWebKit()\n{\n")
    index = 0
    while index < globalCount {
        const p = &globals[index]
        index += 1
        if stableFeature(p) { continue }
        ifSetting(p)
        o("    ")
        o(yaml.textOf(yaml.get(p.*.options, "webcoreBinding")))
        o("::")
        o(setterFunctionName(p))
        o("(false);\n")
        endSetting(p)
    }
    o("}\n\nvoid Settings::disableFeaturesForLockdownMode()\n{\n")
    index = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !p.*.disableInLockdownMode { continue }
        ifSetting(p)
        o("    ")
        o(setterFunctionName(p))
        o("(false);\n")
        endSetting(p)
    }
    o("}\n\n")
    var group: usize = 0
    while group < groupCount() {
        if groupHas(group, COMPLEX_GETTER, true) || groupHas(group, COMPLEX_SETTER, true) {
            ifCondition(group)
            index = 0
            while index < settingCount {
                const p = &settings[sorted[index]]
                index += 1
                if !inGroup(p, group) || !kept(p, COMPLEX_GETTER, true) { continue }
                o(parameterType(p))
                o(" Settings::")
                o(getterFunctionName(p))
                o("() const\n{\n")
                if p.*.inspectorOverride {
                    o("    if (m_values.")
                    o(p.*.name)
                    o("InspectorOverride) [[unlikely]] {\n        ASSERT(InspectorInstrumentation::hasFrontends());\n        return m_values.")
                    o(p.*.name)
                    o("InspectorOverride.value();\n    }\n")
                }
                o("    return m_values.")
                o(p.*.name)
                o(";\n}\n")
            }
            o("\n")
            index = 0
            while index < settingCount {
                const p = &settings[sorted[index]]
                index += 1
                if !inGroup(p, group) || !kept(p, COMPLEX_SETTER, true) { continue }
                o("void Settings::")
                o(setterFunctionName(p))
                o("(")
                o(parameterType(p))
                o(" ")
                o(p.*.name)
                o(")\n{\n    if (m_values.")
                o(p.*.name)
                o(" == ")
                o(p.*.name)
                o(")\n        return;\n    m_values.")
                o(p.*.name)
                o(" = ")
                o(p.*.name)
                o(";\n    ")
                o(p.*.onChange)
                o("();\n}\n")
            }
            endCondition(group)
        }
        group += 1
    }
    o("\n")
    // The template closes the condition here when the last group of the
    // loop before (the last condition) has one.
    const lastHasCondition = groupCount() > 1
    index = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !p.*.inspectorOverride || !hasComplexSetter(p) { continue }
        o("void Settings::")
        o(setterFunctionName(p))
        o("InspectorOverride(std::optional<")
        o(parameterType(p))
        o("> ")
        o(p.*.name)
        o("InspectorOverride)\n{\n    if (m_values.")
        o(p.*.name)
        o("InspectorOverride == ")
        o(p.*.name)
        o("InspectorOverride)\n        return;\n    m_values.")
        o(p.*.name)
        o("InspectorOverride = ")
        o(p.*.name)
        o("InspectorOverride;\n")
        ifSetting(p)
        o("    ")
        o(p.*.onChange)
        o("();\n")
        if p.*.hasCondition && lastHasCondition { o("#endif\n") }
        o("}\n\n")
    }
    o("}\n")
}

// ---------------------------------------------------------------------------
// InternalSettingsGenerated.h.erb, .cpp.erb and .idl.erb

fn internalHeader() -> void {
    o(LICENSE)
    o("#pragma once\n\n#include <wtf/RefCounted.h>\n#include <wtf/WeakPtr.h>\n#include <wtf/text/WTFString.h>\n\nnamespace WebCore {\n\nclass Page;\n\nclass InternalSettingsGenerated : public RefCounted<InternalSettingsGenerated> {\npublic:\n    explicit InternalSettingsGenerated(Page*);\n    virtual ~InternalSettingsGenerated();\n\n    void resetToConsistentState();\n    virtual bool isInternalSettings() const { return false; }\n\n")
    var index: usize = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !internal(p) { continue }
        o("    void ")
        o(setterFunctionName(p))
        o("(")
        o(parameterType(p))
        o(" ")
        o(p.*.name)
        o(");\n")
    }
    o("\nprivate:\n    WeakPtr<Page> m_page;\n\n")
    index = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !internal(p) { continue }
        ifSetting(p)
        o("    ")
        o(p.*.valueType)
        o(" m_")
        o(p.*.name)
        o(";\n")
        endSetting(p)
    }
    o("};\n\n} // namespace WebCore\n")
}

fn internalImplementation() -> void {
    o(LICENSE)
    o("#include \"config.h\"\n#include \"InternalSettingsGenerated.h\"\n\n#include \"Page.h\"\n#include \"Settings.h\"\n\nnamespace WebCore {\n\nInternalSettingsGenerated::InternalSettingsGenerated(Page* page)\n    : m_page(page)\n")
    var index: usize = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !internal(p) { continue }
        ifSetting(p)
        o("    , m_")
        o(p.*.name)
        o("(page->settings().")
        o(getterFunctionName(p))
        o("())\n")
        endSetting(p)
    }
    o("{\n}\n\nInternalSettingsGenerated::~InternalSettingsGenerated()\n{\n}\n\nvoid InternalSettingsGenerated::resetToConsistentState()\n{\n")
    index = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !internal(p) { continue }
        ifSetting(p)
        o("    m_page->settings().")
        o(setterFunctionName(p))
        o("(m_")
        o(p.*.name)
        o(");\n")
        endSetting(p)
    }
    o("}\n\n")
    index = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !internal(p) { continue }
        o("void InternalSettingsGenerated::")
        o(setterFunctionName(p))
        o("(")
        o(parameterType(p))
        o(" ")
        o(p.*.name)
        o(")\n{\n")
        if p.*.hasCondition {
            o("#if ")
            o(p.*.condition)
            o("\n    m_page->settings().")
            o(setterFunctionName(p))
            o("(")
            o(p.*.name)
            o(");\n#else\n    UNUSED_PARAM(")
            o(p.*.name)
            o(");\n#endif\n")
        } else {
            o("    m_page->settings().")
            o(setterFunctionName(p))
            o("(")
            o(p.*.name)
            o(");\n")
        }
        o("}\n\n")
    }
    o("} // namespace WebCore\n")
}

fn internalInterface() -> void {
    o(LICENSE)
    o("[\n    LegacyNoInterfaceObject,\n    ExportMacro=WEBCORE_TESTSUPPORT_EXPORT,\n] interface InternalSettingsGenerated {\n")
    var index: usize = 0
    while index < settingCount {
        const p = &settings[sorted[index]]
        index += 1
        if !internal(p) { continue }
        o("    undefined ")
        o(setterFunctionName(p))
        o("(")
        o(idlType(p))
        o(" ")
        o(p.*.name)
        o(");\n")
    }
    o("};\n")
}

// ---------------------------------------------------------------------------
// The run.

const MAX_FILES: usize = 256

fn makeDirectories(path: []const u8) -> void {
    var at: usize = 1
    while at <= path.length {
        if at == path.length || path[at] == 47 {
            const prefix = s.join(path[0..at], "")
            const ignored = std.linux.syscall2(83, @intFromPtr(prefix.pointer), 493)
        }
        at += 1
    }
}

fn usage() -> void {
    s.say("Usage: webkit-settings [--outputDir <output>] --template <input> [--template <file>...] <settings> [<settings>...]\n")
    exitWith(1)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var templates: [*][]const u8 = undefined
    var files: [*][]const u8 = undefined
    unsafe {
        templates = @ptrFromInt([*][]const u8, s.alloc(MAX_FILES * 16))
        files = @ptrFromInt([*][]const u8, s.alloc(MAX_FILES * 16))
        settings = @ptrFromInt([*]Setting, s.alloc(MAX_SETTINGS * @sizeOf(Setting)))
        globals = @ptrFromInt([*]Setting, s.alloc(MAX_SETTINGS * @sizeOf(Setting)))
    }
    var templateCount: usize = 0
    var fileCount: usize = 0
    var outputDirectory: []const u8 = "."
    var index: usize = 1
    while index < arguments.length {
        const argument = std.text.cString(arguments[index])
        index += 1
        var name = argument
        var value: []const u8 = ""
        var hasValue = false
        if std.text.startsWith(argument, "--") && std.text.contains(argument, "=") {
            const equals = std.text.find(argument, "=")
            name = argument[0..equals]
            value = argument[equals + 1..argument.length]
            hasValue = true
        }
        const takesValue = std.text.same(name, "--template") || std.text.same(name, "--outputDir")
        if takesValue && !hasValue {
            if index >= arguments.length { usage() }
            value = std.text.cString(arguments[index])
            index += 1
        }
        if std.text.same(name, "--template") {
            if templateCount == MAX_FILES { s.fail("webkit-settings: too many templates") }
            templates[templateCount] = value
            templateCount += 1
        } else if std.text.same(name, "--outputDir") {
            outputDirectory = value
        } else if std.text.startsWith(argument, "-") && argument.length > 1 {
            usage()
        } else {
            if fileCount == MAX_FILES { s.fail("webkit-settings: too many settings files") }
            files[fileCount] = argument
            fileCount += 1
        }
    }
    if fileCount == 0 { usage() }
    makeDirectories(outputDirectory)

    index = 0
    while index < fileCount {
        readFile(files[index])
        index += 1
    }
    organize()

    index = 0
    while index < templateCount {
        const template = templates[index]
        var name = s.baseName(template)
        if std.text.endsWith(name, ".erb") { name = name[0..name.length - 4] }
        const from = s.output().length
        if std.text.same(name, "Settings.h") {
            settingsHeader()
        } else if std.text.same(name, "Settings.cpp") {
            settingsImplementation()
        } else if std.text.same(name, "InternalSettingsGenerated.h") {
            internalHeader()
        } else if std.text.same(name, "InternalSettingsGenerated.cpp") {
            internalImplementation()
        } else if std.text.same(name, "InternalSettingsGenerated.idl") {
            internalInterface()
        } else {
            s.fail(s.join("webkit-settings: unknown template: ", template))
        }
        const all = s.output()
        const path = if std.text.endsWith(outputDirectory, "/") { s.join(outputDirectory, name) } else { s.join3(outputDirectory, "/", name) }
        s.writeWhole(path, all[from..all.length])
        index += 1
    }
    return 0
}
