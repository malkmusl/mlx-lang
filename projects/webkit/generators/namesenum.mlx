// The files make_names.pl writes with --enum, of the names of every
// namespace at once: TagName.h/.cpp (an enumerator for each tag name, the
// same in every namespace that has it), NodeName.h/.cpp (one for each
// element and attribute of each namespace) and Namespace.h/.cpp. Each
// file's license comes first, written by the caller.
const s = @import("./support.mlx")
const n = @import("./namestext.mlx")
const m = @import("./namesmodel.mlx")

fn element(position: usize, order: [*]usize) -> m.Element { return m.elements[order[position]] }

// The namespaces of the elements, sorted.
fn elementNamespaces() -> n.List {
    var names = n.list()
    var index: usize = 0
    while index < m.elementCount {
        n.add(&names, m.elements[index].namespace)
        index += 1
    }
    n.sortList(&names)
    return names
}

fn attributeNamespaces() -> n.List {
    var names = n.list()
    var index: usize = 0
    while index < m.attributeCount {
        n.add(&names, m.attributes[index].namespace)
        index += 1
    }
    n.sortList(&names)
    return names
}

// The namespaces having elements whose tag names need adjusting, sorted.
fn adjustedNamespaces() -> n.List {
    var names = n.list()
    var index: usize = 0
    while index < m.elementCount {
        if m.elements[index].unadjustedTagEnumValue.length > 0 { n.add(&names, m.elements[index].namespace) }
        index += 1
    }
    n.sortList(&names)
    return names
}

// ---------------------------------------------------------------------------
// TagName.

pub fn printTagNameHeaderFile(filePath: []const u8) -> void {
    const order = m.sortedElements(m.elementsByName)
    n.o("#pragma once\n\n#include <wtf/EnumeratedArray.h>\n#include <wtf/NeverDestroyed.h>\n#include <wtf/text/AtomString.h>\n\nnamespace WebCore {\n\nclass QualifiedName;\n\n")
    n.o("enum class TagName : uint16_t {\n    Unknown,\n")
    var handled = n.list()
    var previousCppNamespace: []const u8 = ""
    var seenMultiNamespaceTags = false
    var position: usize = 0
    while position < m.elementCount {
        const e = element(position, order)
        position += 1
        if n.has(handled, e.identifier) { continue }
        if e.count > 1 && !seenMultiNamespaceTags {
            n.o("\n    // Tags in multiple namespaces\n")
        } else if !s.same(e.cppNamespace, previousCppNamespace) {
            n.o3("\n    // ", e.cppNamespace, "\n")
        }
        n.o3("    ", e.tagEnumValue, ",")
        if e.count > 1 {
            n.o(" // ")
            const namespaces = m.elementNamespaces(e.localName)
            var i: usize = 0
            while i < namespaces.count {
                if i > 0 { n.o(", ") }
                n.o(namespaces.items[i])
                i += 1
            }
        }
        n.o("\n")
        if e.count > 1 { seenMultiNamespaceTags = true }
        previousCppNamespace = e.cppNamespace
        n.push(&handled, e.identifier)
    }
    n.o("\n    // Foreign namespace tag names requiring adjustment\n")
    var last: []const u8 = ""
    position = 0
    while position < m.elementCount {
        const e = element(position, order)
        position += 1
        if e.unadjustedTagEnumValue.length == 0 { continue }
        n.o3("    ", e.unadjustedTagEnumValue, ",\n")
        last = e.unadjustedTagEnumValue
    }
    n.o("};\n\n")
    n.o3("inline constexpr auto lastTagNameEnumValue = TagName::", last, ";\n")
    n.o("inline LazyNeverDestroyed<EnumeratedArray<TagName, AtomString, lastTagNameEnumValue>> tagNameStrings;\n\n")
    n.o("WEBCORE_EXPORT void initializeTagNameStrings();\nTagName findTagName(std::span<const char16_t>);\n#if ASSERT_ENABLED\nTagName findTagName(const String&);\n#endif\n")
    const adjusted = adjustedNamespaces()
    var a: usize = 0
    while a < adjusted.count {
        n.o3("TagName adjust", adjusted.items[a], "TagName(TagName);\n")
        a += 1
    }
    n.o("\ninline const AtomString& tagNameAsString(TagName tagName)\n{\n    return tagNameStrings.get()[tagName];\n}\n\n")
    a = 0
    while a < adjusted.count {
        const namespace = adjusted.items[a]
        a += 1
        n.o3("inline TagName adjust", namespace, "TagName(TagName tagName)\n{\n    switch (tagName) {\n")
        position = 0
        while position < m.elementCount {
            const e = element(position, order)
            position += 1
            if !s.same(e.namespace, namespace) || e.unadjustedTagEnumValue.length == 0 { continue }
            n.o3("    case TagName::", e.unadjustedTagEnumValue, ":\n")
            n.o3("        return TagName::", e.tagEnumValue, ";\n")
        }
        n.o("    default:\n        return tagName;\n    }\n}\n\n")
    }
    n.o("} // namespace WebCore\n")
    n.save(filePath)
}

fn printNamespaceIncludes() -> void {
    const namespaces = m.sortedCppNamespaces()
    var index: usize = 0
    while index < namespaces.count {
        n.o3("#include \"", namespaces.items[index], "Names.h\"\n")
        index += 1
    }
}

pub fn printTagNameCppFile(filePath: []const u8) -> void {
    const order = m.sortedElements(m.elementsByName)
    n.o("#include \"config.h\"\n#include \"TagName.h\"\n\n")
    printNamespaceIncludes()
    n.o("#include <wtf/text/FastCharacterComparison.h>\n\nnamespace WebCore {\n\n")
    n.o("void initializeTagNameStrings() {\n    static bool initialized = false;\n    if (std::exchange(initialized, true))\n        return;\n\n")
    n.o("    tagNameStrings.construct();\n    auto& strings = tagNameStrings.get();\n\n")
    n.o("    // Initialize tag name strings from QualifiedName objects\n")
    var handled = n.list()
    var position: usize = 0
    while position < m.elementCount {
        const e = element(position, order)
        position += 1
        if n.has(handled, e.identifier) { continue }
        n.push(&handled, e.identifier)
        n.o5("    strings[TagName::", e.tagEnumValue, "] = ", e.cppNamespace, "Names::")
        n.o3(e.identifier, "Tag->localName();\n", "")
    }
    n.o("\n    // Initialize unadjusted tag names\n")
    position = 0
    while position < m.elementCount {
        const e = element(position, order)
        position += 1
        if e.unadjustedTagEnumValue.length == 0 { continue }
        n.o5("    strings[TagName::", e.unadjustedTagEnumValue, "] = \"", e.parsedTagName, "\"_s;\n")
    }
    n.o("}\n\n")
    n.o("template <typename characterType>\nstatic inline TagName findTagFromBuffer(std::span<const characterType> buffer)\n{\n")
    m.startCandidates(m.elementCount)
    position = 0
    while position < m.elementCount {
        const e = element(position, order)
        m.addCandidate(e.parsedTagName, e.parsedTagEnumValue)
        position += 1
    }
    m.findBody("TagName")
    n.o("}\n\n")
    n.o("TagName findTagName(std::span<const char16_t> buffer)\n{\n    return findTagFromBuffer(buffer);\n}\n\n")
    n.o("#if ASSERT_ENABLED\nTagName findTagName(const String& name)\n{\n    if (name.is8Bit())\n        return findTagFromBuffer(name.span8());\n    return findTagFromBuffer(name.span16());\n}\n#endif\n\n")
    n.o("} // namespace WebCore\n\n")
    n.save(filePath)
}

// ---------------------------------------------------------------------------
// NodeName.

pub fn printNodeNameHeaderFile(filePath: []const u8) -> void {
    const order = m.sortedElements(m.elementsByName)
    const attributeOrder = m.sortedAttributes(m.attributesByName)
    n.o("#pragma once\n\n#include <WebCore/Namespace.h>\n#include <WebCore/TagName.h>\n#include <wtf/EnumTraits.h>\n#include <wtf/Forward.h>\n\nnamespace WebCore {\n\nclass QualifiedName;\n\n")
    n.o("enum class NodeName : uint16_t {\n    Unknown,\n\n    // Elements\n")
    var position: usize = 0
    while position < m.elementCount {
        n.o3("    ", element(position, order).nodeNameEnumValue, ",\n")
        position += 1
    }
    n.o("\n    // Attributes\n")
    var handled = n.list()
    position = 0
    while position < m.attributeCount {
        const value = m.attributes[attributeOrder[position]].nodeNameEnumValue
        position += 1
        if n.has(handled, value) { continue }
        n.push(&handled, value)
        n.o3("    ", value, ",\n")
    }
    n.o("};\n\nusing ElementName = NodeName;\n\nnamespace ElementNames {\n")
    const namespaces = elementNamespaces()
    var i: usize = 0
    while i < namespaces.count {
        const namespace = namespaces.items[i]
        i += 1
        n.o3("namespace ", namespace, " {\n")
        position = 0
        while position < m.elementCount {
            const e = element(position, order)
            position += 1
            if !s.same(e.namespace, namespace) { continue }
            n.o5("inline constexpr auto ", e.tagEnumValue, " = ElementName::", e.nodeNameEnumValue, ";\n")
        }
        n.o3("} // namespace ", namespace, "\n\n")
    }
    n.o("} // namespace ElementNames\n\nnamespace AttributeNames {\n")
    handled = n.list()
    const attributeSpaces = attributeNamespaces()
    i = 0
    while i < attributeSpaces.count {
        const namespace = attributeSpaces.items[i]
        i += 1
        if namespace.length > 0 { n.o3("namespace ", namespace, " {\n") }
        position = 0
        while position < m.attributeCount {
            const a = m.attributes[attributeOrder[position]]
            position += 1
            if !s.same(a.namespace, namespace) { continue }
            if !n.has(handled, a.nodeNameEnumValue) {
                n.o5("inline constexpr auto ", a.tagEnumValue, " = NodeName::", a.nodeNameEnumValue, ";\n")
            }
            n.add(&handled, a.nodeNameEnumValue)
        }
        if namespace.length == 0 {
            n.o("\n")
        } else {
            n.o3("} // namespace ", namespace, "\n\n")
        }
    }
    n.o("} // namespace AttributeNames\n\n")
    n.o("NodeName findNodeName(Namespace, const String&);\n")
    n.o("ElementName findHTMLElementName(std::span<const Latin1Character>);\n")
    n.o("ElementName findHTMLElementName(std::span<const char16_t>);\n")
    n.o("ElementName findHTMLElementName(const String&);\n")
    n.o("ElementName findSVGElementName(const String&);\n")
    n.o("ElementName findMathMLElementName(const String&);\n")
    n.o("TagName tagNameForElementName(ElementName);\n")
    n.o("ElementName elementNameForTag(Namespace, TagName);\n")
    n.o("const QualifiedName& qualifiedNameForNodeName(NodeName);\n\n")

    var lastUnique: []const u8 = ""
    position = 0
    while position < m.elementCount {
        const e = element(position, order)
        position += 1
        if e.count == 1 { lastUnique = e.tagEnumValue }
    }
    n.o("inline TagName tagNameForElementName(ElementName elementName)\n{\n")
    n.o3("    constexpr auto s_lastUniqueTagName = TagName::", lastUnique, ";\n\n")
    n.o("    if (std::to_underlying(elementName) <= std::to_underlying(s_lastUniqueTagName)) [[likely]]\n        return static_cast<TagName>(elementName);\n\n")
    n.o("    switch (elementName) {\n")
    position = 0
    while position < m.elementCount {
        const e = element(position, order)
        position += 1
        if e.count == 1 { continue }
        n.o3("    case ElementName::", e.nodeNameEnumValue, ":\n")
        n.o3("        return TagName::", e.tagEnumValue, ";\n")
    }
    n.o("    default:\n        break;\n    }\n\n    return TagName::Unknown;\n}\n\n")
    n.o("inline ElementName elementNameForTag(Namespace ns, TagName tagName)\n{\n")
    const cppNamespaces = m.sortedCppNamespaces()
    i = 0
    while i < cppNamespaces.count {
        const namespace = cppNamespaces.items[i]
        i += 1
        var any = false
        var firstUnique: []const u8 = ""
        var lastUniqueHere: []const u8 = ""
        position = 0
        while position < m.elementCount {
            const e = element(position, order)
            position += 1
            if s.same(e.cppNamespace, namespace) { any = true }
            if e.count == 1 && s.same(e.namespace, namespace) {
                if firstUnique.length == 0 { firstUnique = e.tagEnumValue }
                lastUniqueHere = e.tagEnumValue
            }
        }
        if !any { continue }
        n.o3("    if (ns == Namespace::", namespace, ") {\n")
        n.o5("        constexpr auto s_firstUnique", namespace, "TagName = TagName::", firstUnique, ";\n")
        n.o5("        constexpr auto s_lastUnique", namespace, "TagName = TagName::", lastUniqueHere, ";\n\n")
        n.o3("        if (tagName < s_firstUnique", namespace, "TagName) [[unlikely]]\n            return ElementName::Unknown;\n\n")
        n.o3("        if (tagName <= s_lastUnique", namespace, "TagName) [[likely]]\n            return static_cast<ElementName>(tagName);\n\n")
        var nonUnique = false
        position = 0
        while position < m.elementCount {
            const e = element(position, order)
            position += 1
            if e.count > 1 && s.same(e.namespace, namespace) {
                if !nonUnique { n.o("        switch (tagName) {\n") }
                nonUnique = true
                n.o3("        case TagName::", e.tagEnumValue, ":\n")
                n.o3("            return ElementName::", e.nodeNameEnumValue, ";\n")
            }
        }
        if nonUnique { n.o("        default:\n            break;\n        }\n") }
        n.o("        return ElementName::Unknown;\n    }\n\n")
    }
    n.o("    return ElementName::Unknown;\n}\n\n} // namespace WebCore\n")
    n.save(filePath)
}

// The Perl's byElementThenAttrNameOrder, on the nodes of one namespace: a
// key that is an element's goes before one that is not, elements by their
// order, attributes by theirs.
var nodeElements: [*]i64 = undefined
var nodeAttributes: [*]i64 = undefined

fn nodesByName(first: usize, second: usize) -> i32 {
    const firstElement = nodeElements[first]
    const secondElement = nodeElements[second]
    if firstElement >= 0 && secondElement < 0 { return -1 }
    if firstElement < 0 && secondElement >= 0 { return 1 }
    if firstElement >= 0 { return m.elementsByName(@intCast(usize, firstElement), @intCast(usize, secondElement)) }
    return m.attributesByName(@intCast(usize, nodeAttributes[first]), @intCast(usize, nodeAttributes[second]))
}

fn printFindNodeName(namespace: []const u8) -> void {
    const identifier = if namespace.length == 0 { "NoNamespace" } else { namespace }
    n.o3("template <typename characterType>\nstatic inline NodeName find", identifier, "NodeName(std::span<const characterType> buffer)\n{\n")
    // The nodes of the namespace, by key: the elements, then the
    // attributes (one of the same key taking the element's place).
    const capacity = m.elementCount + m.attributeCount
    var keys = n.list()
    var strings = n.list()
    var values = n.list()
    unsafe {
        nodeElements = @ptrFromInt([*]i64, s.alloc((capacity + 1) * 8))
        nodeAttributes = @ptrFromInt([*]i64, s.alloc((capacity + 1) * 8))
    }
    var index: usize = 0
    while index < m.elementCount {
        const e = m.elements[index]
        if s.same(e.namespace, namespace) {
            n.push(&keys, e.key)
            n.push(&strings, e.localName)
            n.push(&values, e.nodeNameEnumValue)
        }
        index += 1
    }
    index = 0
    while index < m.attributeCount {
        const a = m.attributes[index]
        if s.same(a.namespace, namespace) {
            var at: usize = 0
            while at < keys.count && !s.same(keys.items[at], a.key) { at += 1 }
            if at == keys.count {
                n.push(&keys, a.key)
                n.push(&strings, a.localName)
                n.push(&values, a.nodeNameEnumValue)
            } else {
                strings.items[at] = a.localName
                values.items[at] = a.nodeNameEnumValue
            }
        }
        index += 1
    }
    index = 0
    while index < keys.count {
        nodeElements[index] = m.findElement(keys.items[index])
        nodeAttributes[index] = m.findAttribute(keys.items[index])
        index += 1
    }
    const order = n.indexes(keys.count)
    n.sortBy(order, keys.count, nodesByName)
    m.startCandidates(keys.count)
    index = 0
    while index < keys.count {
        m.addCandidate(strings.items[order[index]], values.items[order[index]])
        index += 1
    }
    m.findBody("NodeName")
    n.o("}\n\n")
}

pub fn printNodeNameCppFile(filePath: []const u8) -> void {
    n.o("#include \"config.h\"\n#include \"NodeName.h\"\n\n")
    printNamespaceIncludes()
    n.o("#include \"Namespace.h\"\n#include <wtf/text/FastCharacterComparison.h>\n\nnamespace WebCore {\n\n")
    // The namespaces of the elements and of the attributes, sorted together.
    var all = n.list()
    const elementSpaces = elementNamespaces()
    const attributeSpaces = attributeNamespaces()
    var i: usize = 0
    while i < elementSpaces.count {
        n.push(&all, elementSpaces.items[i])
        i += 1
    }
    i = 0
    while i < attributeSpaces.count {
        n.push(&all, attributeSpaces.items[i])
        i += 1
    }
    n.sortList(&all)
    i = 0
    while i < all.count {
        printFindNodeName(all.items[i])
        i += 1
    }
    n.o("template <typename characterType>\nstatic inline NodeName findNodeNameFromBuffer(Namespace ns, std::span<const characterType> buffer)\n{\n    switch (ns) {\n")
    i = 0
    while i < all.count {
        const namespace = all.items[i]
        i += 1
        n.o3("    case Namespace::", if namespace.length == 0 { "None" } else { namespace }, ":\n")
        n.o3("        return find", if namespace.length == 0 { "NoNamespace" } else { namespace }, "NodeName(buffer);\n")
    }
    n.o("    default:\n        return NodeName::Unknown;\n    }\n}\n\n")
    n.o("NodeName findNodeName(Namespace ns, const String& name)\n{\n    if (name.is8Bit())\n        return findNodeNameFromBuffer(ns, name.span8());\n    return findNodeNameFromBuffer(ns, name.span16());\n}\n\n")
    n.o("ElementName findHTMLElementName(std::span<const Latin1Character> buffer)\n{\n    return findHTMLNodeName(buffer);\n}\n\n")
    n.o("ElementName findHTMLElementName(std::span<const char16_t> buffer)\n{\n    return findHTMLNodeName(buffer);\n}\n\n")
    n.o("ElementName findHTMLElementName(const String& name)\n{\n    if (name.is8Bit())\n        return findHTMLNodeName(name.span8());\n    return findHTMLNodeName(name.span16());\n}\n\n")
    n.o("ElementName findSVGElementName(const String& name)\n{\n    if (name.is8Bit())\n        return findSVGNodeName(name.span8());\n    return findSVGNodeName(name.span16());\n}\n\n")
    n.o("ElementName findMathMLElementName(const String& name)\n{\n    if (name.is8Bit())\n        return findMathMLNodeName(name.span8());\n    return findMathMLNodeName(name.span16());\n}\n\n")
    n.o("const QualifiedName& qualifiedNameForNodeName(NodeName nodeName)\n{\n    ASSERT(nodeName != NodeName::Unknown);\n    switch (nodeName) {\n    case NodeName::Unknown:\n        break;\n")
    const order = m.sortedElements(m.elementsByName)
    var position: usize = 0
    while position < m.elementCount {
        const e = element(position, order)
        position += 1
        n.o3("    case NodeName::", e.nodeNameEnumValue, ":\n")
        n.o5("        return ", e.cppNamespace, "Names::", e.identifier, "Tag;\n")
    }
    const attributeOrder = m.sortedAttributes(m.attributesByName)
    var handled = n.list()
    position = 0
    while position < m.attributeCount {
        const a = m.attributes[attributeOrder[position]]
        position += 1
        if n.has(handled, a.nodeNameEnumValue) { continue }
        n.o3("    case NodeName::", a.nodeNameEnumValue, ":\n")
        n.o5("        return ", a.cppNamespace, "Names::", a.identifier, "Attr;\n")
        n.push(&handled, a.nodeNameEnumValue)
    }
    n.o("    }\n    return nullQName();\n}\n\n} // namespace WebCore\n\n")
    n.save(filePath)
}

// ---------------------------------------------------------------------------
// Namespace.

pub fn printNamespaceHeaderFile(filePath: []const u8) -> void {
    n.o("#pragma once\n\n#include <wtf/Forward.h>\n\nnamespace WebCore {\n\nenum class Namespace : uint8_t {\n    Unknown,\n    None,\n")
    const namespaces = m.sortedCppNamespaces()
    var index: usize = 0
    while index < namespaces.count {
        n.o3("    ", namespaces.items[index], ",\n")
        index += 1
    }
    n.o("};\n\nNamespace findNamespace(const AtomString&);\n\n} // namespace WebCore\n")
    n.save(filePath)
}

pub fn printNamespaceCppFile(filePath: []const u8) -> void {
    n.o("#include \"config.h\"\n#include \"Namespace.h\"\n\n#include <wtf/text/AtomString.h>\n\n")
    printNamespaceIncludes()
    n.o("\nnamespace WebCore {\n\nNamespace findNamespace(const AtomString& namespaceURI)\n{\n    if (namespaceURI.isEmpty())\n        return Namespace::None;\n")
    const namespaces = m.sortedCppNamespaces()
    var index: usize = 0
    while index < namespaces.count {
        const namespace = namespaces.items[index]
        index += 1
        n.o5("    if (namespaceURI == ", namespace, "Names::", n.lower(m.cppNamespacePrefix(namespace)), "NamespaceURI)\n")
        n.o3("        return Namespace::", namespace, ";\n")
    }
    n.o("    return Namespace::Unknown;\n}\n\n} // namespace WebCore\n")
    n.save(filePath)
}
