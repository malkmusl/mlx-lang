// gperf's options: those of its command line (read as GNU getopt_long
// reads them, abbreviated long options and the permutation that puts the
// non-options last included) and those the declarations of its input set.
// The command line is printed back in the output's header comment.
const s = @import("./support.mlx")
const io = @import("./gperfio.mlx")
const pos = @import("./gperfpositions.mlx")

// The boolean options (gperf's Option_Type).
pub const TYPE: u64 = 1
pub const UPPERLOWER: u64 = 2
pub const KRC: u64 = 4
pub const C: u64 = 8
pub const ANSIC: u64 = 16
pub const CPLUSPLUS: u64 = 32
pub const SEVENBIT: u64 = 64
pub const LENTABLE: u64 = 128
pub const COMP: u64 = 256
pub const CONST: u64 = 512
pub const ENUM: u64 = 1024
pub const INCLUDE: u64 = 2048
pub const GLOBAL: u64 = 4096
pub const NULLSTRINGS: u64 = 8192
pub const SHAREDLIB: u64 = 16384
pub const SWITCH: u64 = 32768
pub const NOTYPE: u64 = 65536
pub const POSITIONS: u64 = 131072
pub const DUP: u64 = 262144
pub const NOLENGTH: u64 = 524288
pub const RANDOM: u64 = 1048576
pub const DEBUG: u64 = 2097152

pub const Options = struct {
    word: u64
    programName: []const u8
    inputFileName: []const u8
    hasInputFile: bool
    outputFileName: []const u8
    hasOutputFile: bool
    languageSet: bool
    jump: i64
    initialAssoValue: i64
    assoIterations: i64
    totalSwitches: i64
    sizeMultiple: f32
    functionName: []const u8
    functionNameSet: bool
    slotName: []const u8
    slotNameSet: bool
    initializerSuffix: []const u8
    initializerSuffixSet: bool
    className: []const u8
    classNameSet: bool
    hashName: []const u8
    hashNameSet: bool
    wordlistName: []const u8
    wordlistNameSet: bool
    lengthtableName: []const u8
    lengthtableNameSet: bool
    stringpoolName: []const u8
    stringpoolNameSet: bool
    constantsPrefix: []const u8
    constantsPrefixSet: bool
    delimiters: []const u8
    delimitersSet: bool
    keyPositions: pos.Positions
}

pub var o: *Options = undefined
// The command line as getopt leaves it (options first).
var argumentVector: [*][]const u8 = undefined
var argumentCount: usize = 0

pub fn has(bit: u64) -> bool { return (o.*.word & bit) != 0 }
pub fn set(bit: u64) -> void { o.*.word |= bit }

fn byteAt(text: []const u8, index: usize) -> u8 {
    if index < text.length { return text[index] }
    return 0
}

fn isLetter(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }

pub fn shortUsage() -> void {
    s.say(s.join3("Try '", o.*.programName, " --help' for more information.\n"))
}

fn usageError() -> void {
    shortUsage()
    io.exit(1)
}

// VALUE as printf's "%g" writes it (6 significant digits).
fn formatG(value: f64) -> []const u8 {
    if value != value { return "nan" }
    var v = value
    var sign: []const u8 = ""
    if v < 0.0 {
        sign = "-"
        v = 0.0 - v
    }
    if v == 0.0 { return s.join(sign, "0") }
    if v > 1.0e308 { return s.join(sign, "inf") }
    // V = DIGITS * 10^(EXPONENT - 5), DIGITS of 6 digits.
    var exponent: i64 = 0
    while v >= 10.0 {
        v = v / 10.0
        exponent += 1
    }
    while v < 1.0 {
        v = v * 10.0
        exponent -= 1
    }
    var digits = @intFromFloat(i64, v * 100000.0 + 0.5)
    if digits >= 1000000 {
        digits = digits / 10
        exponent += 1
    }
    var text = s.decimal(@intCast(u64, digits))
    if exponent >= -4 && exponent < 6 {
        var result: []const u8 = ""
        if exponent >= 0 {
            const whole = @intCast(usize, exponent) + 1
            result = s.join3(text[0..whole], ".", text[whole..6])
        } else {
            var zeros: []const u8 = "0."
            var k: i64 = -1
            while k > exponent {
                zeros = s.join(zeros, "0")
                k -= 1
            }
            result = s.join(zeros, text)
        }
        var end = result.length
        while end > 0 && result[end - 1] == 48 { end -= 1 }
        if end > 0 && result[end - 1] == 46 { end -= 1 }
        return s.join(sign, result[0..end])
    }
    var mantissa = s.join3(text[0..1], ".", text[1..6])
    var end = mantissa.length
    while end > 0 && mantissa[end - 1] == 48 { end -= 1 }
    if end > 0 && mantissa[end - 1] == 46 { end -= 1 }
    const magnitude: i64 = if exponent < 0 { 0 - exponent } else { exponent }
    const exponentText = if magnitude < 10 { s.join("0", s.signedDecimal(magnitude)) } else { s.signedDecimal(magnitude) }
    return s.join3(sign, mantissa[0..end], s.join(if exponent < 0 { "e-" } else { "e+" }, exponentText))
}

// The setters the declarations of the input use: each sets its option
// unless the command line did.
pub fn setLanguage(language: []const u8) -> void {
    if o.*.languageSet { return }
    o.*.languageSet = true
    o.*.word &= ~(KRC | C | ANSIC | CPLUSPLUS)
    if s.same(language, "KR-C") {
        o.*.word |= KRC
    } else if s.same(language, "C") {
        o.*.word |= C
    } else if s.same(language, "ANSI-C") {
        o.*.word |= ANSIC
    } else if s.same(language, "C++") {
        o.*.word |= CPLUSPLUS
    } else {
        s.say(s.join3("unsupported language option ", language, ", defaulting to ANSI-C\n"))
        o.*.word |= ANSIC
    }
}

pub fn setTotalSwitches(count: i64) -> void {
    if !has(SWITCH) {
        o.*.word |= SWITCH
        o.*.totalSwitches = count
    }
}

pub fn setFunctionName(name: []const u8) -> void {
    if !o.*.functionNameSet {
        o.*.functionName = name
        o.*.functionNameSet = true
    }
}

pub fn setSlotName(name: []const u8) -> void {
    if !o.*.slotNameSet {
        o.*.slotName = name
        o.*.slotNameSet = true
    }
}

pub fn setInitializerSuffix(suffix: []const u8) -> void {
    if !o.*.initializerSuffixSet {
        o.*.initializerSuffix = suffix
        o.*.initializerSuffixSet = true
    }
}

pub fn setClassName(name: []const u8) -> void {
    if !o.*.classNameSet {
        o.*.className = name
        o.*.classNameSet = true
    }
}

pub fn setHashName(name: []const u8) -> void {
    if !o.*.hashNameSet {
        o.*.hashName = name
        o.*.hashNameSet = true
    }
}

pub fn setWordlistName(name: []const u8) -> void {
    if !o.*.wordlistNameSet {
        o.*.wordlistName = name
        o.*.wordlistNameSet = true
    }
}

pub fn setLengthtableName(name: []const u8) -> void {
    if !o.*.lengthtableNameSet {
        o.*.lengthtableName = name
        o.*.lengthtableNameSet = true
    }
}

pub fn setStringpoolName(name: []const u8) -> void {
    if !o.*.stringpoolNameSet {
        o.*.stringpoolName = name
        o.*.stringpoolNameSet = true
    }
}

pub fn setConstantsPrefix(prefix: []const u8) -> void {
    if !o.*.constantsPrefixSet {
        o.*.constantsPrefix = prefix
        o.*.constantsPrefixSet = true
    }
}

pub fn setDelimiters(delimiters: []const u8) -> void {
    if !o.*.delimitersSet {
        o.*.delimiters = delimiters
        o.*.delimitersSet = true
    }
}

// C's atoi: blanks, a sign, digits.
pub fn atoi(text: []const u8) -> i64 {
    var at: usize = 0
    while at < text.length && (text[at] == 32 || (text[at] >= 9 && text[at] <= 13)) { at += 1 }
    var negative = false
    if at < text.length && (text[at] == 43 || text[at] == 45) {
        negative = text[at] == 45
        at += 1
    }
    var value: i64 = 0
    while at < text.length && s.isDigit(text[at]) {
        if value < 1000000000000 { value = value * 10 + @intCast(i64, text[at] - 48) }
        at += 1
    }
    return if negative { 0 - value } else { value }
}

// C's strtod for decimal numbers: the value of the number at the start of
// TEXT and where it ends (0 when there is none).
fn strtod(text: []const u8, end: *usize) -> f64 {
    var at: usize = 0
    while at < text.length && (text[at] == 32 || (text[at] >= 9 && text[at] <= 13)) { at += 1 }
    var negative = false
    if at < text.length && (text[at] == 43 || text[at] == 45) {
        negative = text[at] == 45
        at += 1
    }
    var mantissa: u64 = 0
    var digits: usize = 0
    var exponent: i64 = 0
    while at < text.length && s.isDigit(text[at]) {
        if mantissa < 100000000000000000 {
            mantissa = mantissa * 10 + @intCast(u64, text[at] - 48)
        } else {
            exponent += 1
        }
        digits += 1
        at += 1
    }
    if at < text.length && text[at] == 46 {
        at += 1
        while at < text.length && s.isDigit(text[at]) {
            if mantissa < 100000000000000000 {
                mantissa = mantissa * 10 + @intCast(u64, text[at] - 48)
                exponent -= 1
            }
            digits += 1
            at += 1
        }
    }
    if digits == 0 {
        end.* = 0
        return 0.0
    }
    if at < text.length && (text[at] == 101 || text[at] == 69) {
        var look = at + 1
        var exponentNegative = false
        if look < text.length && (text[look] == 43 || text[look] == 45) {
            exponentNegative = text[look] == 45
            look += 1
        }
        if look < text.length && s.isDigit(text[look]) {
            var given: i64 = 0
            while look < text.length && s.isDigit(text[look]) {
                if given < 100000 { given = given * 10 + @intCast(i64, text[look] - 48) }
                look += 1
            }
            exponent += if exponentNegative { 0 - given } else { given }
            at = look
        }
    }
    end.* = at
    var value = @floatFromInt(f64, mantissa)
    var power: f64 = 1.0
    var left: i64 = if exponent < 0 { 0 - exponent } else { exponent }
    while left > 0 {
        power = power * 10.0
        left -= 1
    }
    value = if exponent < 0 { value / power } else { value * power }
    return if negative { 0.0 - value } else { value }
}

// -k: the key positions, "*" or a list like "1,3-5,$".
fn readKeyPositions(text: []const u8) -> void {
    o.*.word |= POSITIONS
    const BAD: i64 = -3
    if byteAt(text, 0) == 42 {
        pos.setUseall(&o.*.keyPositions, true)
        return
    }
    pos.setUseall(&o.*.keyPositions, false)
    var count: usize = 0
    var at: usize = 0
    var inRange = false
    var upper: i64 = 0
    var current: i64 = 0
    while true {
        var value: i64 = pos.EOS
        if inRange {
            current += 1
            if current >= upper { inRange = false }
            value = current
        } else {
            while at < text.length && text[at] != 0 {
                const byte = text[at]
                if byte == 44 {
                    at += 1
                    continue
                }
                if byte == 36 {
                    at += 1
                    value = pos.LASTCHAR
                    break
                }
                if s.isDigit(byte) {
                    var given: i64 = 0
                    while at < text.length && s.isDigit(text[at]) {
                        if given < 1000000 { given = given * 10 + @intCast(i64, text[at] - 48) }
                        at += 1
                    }
                    if at < text.length && text[at] == 45 {
                        at += 1
                        inRange = true
                        upper = 0
                        while at < text.length && s.isDigit(text[at]) {
                            if upper < 1000000 { upper = upper * 10 + @intCast(i64, text[at] - 48) }
                            at += 1
                        }
                        if !(upper > given && upper <= pos.MAX_KEY_POS) {
                            value = BAD
                            break
                        }
                        current = given
                    }
                    value = if given >= 1 && given <= pos.MAX_KEY_POS { given } else { BAD }
                    break
                }
                value = BAD
                break
            }
        }
        if value == pos.EOS { break }
        if value == BAD {
            s.say("Invalid position value or range, use 1,2,3-255,'$' or '*'.\n")
            usageError()
        }
        if count == pos.MAX_SIZE {
            s.say("Duplicate key positions selected\n")
            usageError()
        }
        o.*.keyPositions.p[count] = if value != pos.LASTCHAR { value - 1 } else { value }
        count += 1
    }
    if count == 0 {
        s.say("No key positions selected.\n")
        usageError()
    }
    o.*.keyPositions.size = count
    if !pos.sort(&o.*.keyPositions) {
        s.say("Duplicate key positions selected\n")
        usageError()
    }
}

// -s: a number, a fraction "N/D", or "-N" for 1/N.
fn readSizeMultiple(text: []const u8) -> void {
    var end: usize = 0
    var invalid = false
    const numerator = @floatCast(f32, strtod(text, &end))
    var denominator: f32 = 1.0
    if end == 0 {
        invalid = true
    } else if end < text.length {
        if text[end] == 47 {
            const rest = text[end + 1..text.length]
            var denominatorEnd: usize = 0
            denominator = @floatCast(f32, strtod(rest, &denominatorEnd))
            if denominatorEnd == 0 || denominatorEnd < rest.length { invalid = true }
        } else {
            invalid = true
        }
    }
    if invalid {
        s.say("Invalid value for option -s.\n")
        usageError()
    }
    var multiple: f32 = numerator / denominator
    const zero: f32 = 0.0
    const one: f32 = 1.0
    if multiple < zero { multiple = one / (zero - multiple) }
    if multiple == zero { multiple = one }
    const excessive: f32 = 50.0
    const small: f32 = 0.01
    if multiple > excessive {
        s.say(s.join3(s.join3("Size multiple ", formatG(@floatCast(f64, multiple)), " is excessive, did you really mean this?! (try '"), o.*.programName, " --help' for help)\n"))
    } else if multiple < small {
        s.say(s.join3(s.join3("Size multiple ", formatG(@floatCast(f64, multiple)), " is extremely small, did you really mean this?! (try '"), o.*.programName, " --help' for help)\n"))
    }
    o.*.sizeMultiple = multiple
}

fn longUsage() -> void {
    io.out("GNU 'gperf' generates perfect hash functions.\n")
    io.out("\n")
    io.out("Usage: ")
    io.out(o.*.programName)
    io.out(" ")
    io.out("[OPTION]... [INPUT-FILE]\n")
    io.out("\n")
    io.out("If a long option shows an argument as mandatory, then it is mandatory\n")
    io.out("for the equivalent short option also.\n")
    io.out("\n")
    io.out("Output file location:\n")
    io.out("      --output-file=FILE Write output to specified file.\n")
    io.out("The results are written to standard output if no output file is specified\n")
    io.out("or if it is -.\n")
    io.out("\n")
    io.out("Input file interpretation:\n")
    io.out("  -e, --delimiters=DELIMITER-LIST\n")
    io.out("                         Allow user to provide a string containing delimiters\n")
    io.out("                         used to separate keywords from their attributes.\n")
    io.out("                         Default is \",\".\n")
    io.out("  -t, --struct-type      Allows the user to include a structured type\n")
    io.out("                         declaration for generated code. Any text before %%\n")
    io.out("                         is considered part of the type declaration. Key\n")
    io.out("                         words and additional fields may follow this, one\n")
    io.out("                         group of fields per line.\n")
    io.out("      --ignore-case      Consider upper and lower case ASCII characters as\n")
    io.out("                         equivalent. Note that locale dependent case mappings\n")
    io.out("                         are ignored.\n")
    io.out("\n")
    io.out("Language for the output code:\n")
    io.out("  -L, --language=LANGUAGE-NAME\n")
    io.out("                         Generates code in the specified language. Languages\n")
    io.out("                         handled are currently C++, ANSI-C, C, and KR-C. The\n")
    io.out("                         default is ANSI-C.\n")
    io.out("\n")
    io.out("Details in the output code:\n")
    io.out("  -K, --slot-name=NAME   Select name of the keyword component in the keyword\n")
    io.out("                         structure.\n")
    io.out("  -F, --initializer-suffix=INITIALIZERS\n")
    io.out("                         Initializers for additional components in the keyword\n")
    io.out("                         structure.\n")
    io.out("  -H, --hash-function-name=NAME\n")
    io.out("                         Specify name of generated hash function. Default is\n")
    io.out("                         'hash'.\n")
    io.out("  -N, --lookup-function-name=NAME\n")
    io.out("                         Specify name of generated lookup function. Default\n")
    io.out("                         name is 'in_word_set'.\n")
    io.out("  -Z, --class-name=NAME  Specify name of generated C++ class. Default name is\n")
    io.out("                         'Perfect_Hash'.\n")
    io.out("  -7, --seven-bit        Assume 7-bit characters.\n")
    io.out("  -l, --compare-lengths  Compare key lengths before trying a string\n")
    io.out("                         comparison. This is necessary if the keywords\n")
    io.out("                         contain NUL bytes. It also helps cut down on the\n")
    io.out("                         number of string comparisons made during the lookup.\n")
    io.out("  -c, --compare-strncmp  Generate comparison code using strncmp rather than\n")
    io.out("                         strcmp.\n")
    io.out("  -C, --readonly-tables  Make the contents of generated lookup tables\n")
    io.out("                         constant, i.e., readonly.\n")
    io.out("  -E, --enum             Define constant values using an enum local to the\n")
    io.out("                         lookup function rather than with defines.\n")
    io.out("  -I, --includes         Include the necessary system include file <string.h>\n")
    io.out("                         at the beginning of the code.\n")
    io.out("  -G, --global-table     Generate the static table of keywords as a static\n")
    io.out("                         global variable, rather than hiding it inside of the\n")
    io.out("                         lookup function (which is the default behavior).\n")
    io.out("  -P, --pic              Optimize the generated table for inclusion in shared\n")
    io.out("                         libraries.  This reduces the startup time of programs\n")
    io.out("                         using a shared library containing the generated code.\n")
    io.out("  -Q, --string-pool-name=NAME\n")
    io.out("                         Specify name of string pool generated by option --pic.\n")
    io.out("                         Default name is 'stringpool'.\n")
    io.out("      --null-strings     Use NULL strings instead of empty strings for empty\n")
    io.out("                         keyword table entries.\n")
    io.out("      --constants-prefix=PREFIX\n")
    io.out("                         Specify prefix for the constants like TOTAL_KEYWORDS.\n")
    io.out("  -W, --word-array-name=NAME\n")
    io.out("                         Specify name of word list array. Default name is\n")
    io.out("                         'wordlist'.\n")
    io.out("      --length-table-name=NAME\n")
    io.out("                         Specify name of length table array. Default name is\n")
    io.out("                         'lengthtable'.\n")
    io.out("  -S, --switch=COUNT     Causes the generated C code to use a switch\n")
    io.out("                         statement scheme, rather than an array lookup table.\n")
    io.out("                         This can lead to a reduction in both time and space\n")
    io.out("                         requirements for some keyfiles. The COUNT argument\n")
    io.out("                         determines how many switch statements are generated.\n")
    io.out("                         A value of 1 generates 1 switch containing all the\n")
    io.out("                         elements, a value of 2 generates 2 tables with 1/2\n")
    io.out("                         the elements in each table, etc. If COUNT is very\n")
    io.out("                         large, say 1000000, the generated C code does a\n")
    io.out("                         binary search.\n")
    io.out("  -T, --omit-struct-type\n")
    io.out("                         Prevents the transfer of the type declaration to the\n")
    io.out("                         output file. Use this option if the type is already\n")
    io.out("                         defined elsewhere.\n")
    io.out("\n")
    io.out("Algorithm employed by gperf:\n")
    io.out("  -k, --key-positions=KEYS\n")
    io.out("                         Select the key positions used in the hash function.\n")
    io.out("                         The allowable choices range between 1-255, inclusive.\n")
    io.out("                         The positions are separated by commas, ranges may be\n")
    io.out("                         used, and key positions may occur in any order.\n")
    io.out("                         Also, the meta-character '*' causes the generated\n")
    io.out("                         hash function to consider ALL key positions, and $\n")
    io.out("                         indicates the \"final character\" of a key, e.g.,\n")
    io.out("                         $,1,2,4,6-10.\n")
    io.out("  -D, --duplicates       Handle keywords that hash to duplicate values. This\n")
    io.out("                         is useful for certain highly redundant keyword sets.\n")
    io.out("  -m, --multiple-iterations=ITERATIONS\n")
    io.out("                         Perform multiple choices of the -i and -j values,\n")
    io.out("                         and choose the best results. This increases the\n")
    io.out("                         running time by a factor of ITERATIONS but does a\n")
    io.out("                         good job minimizing the generated table size.\n")
    io.out("  -i, --initial-asso=N   Provide an initial value for the associate values\n")
    io.out("                         array. Default is 0. Setting this value larger helps\n")
    io.out("                         inflate the size of the final table.\n")
    io.out("  -j, --jump=JUMP-VALUE  Affects the \"jump value\", i.e., how far to advance\n")
    io.out("                         the associated character value upon collisions. Must\n")
    io.out("                         be an odd number, default is 5.\n")
    io.out("  -n, --no-strlen        Do not include the length of the keyword when\n")
    io.out("                         computing the hash function.\n")
    io.out("  -r, --random           Utilizes randomness to initialize the associated\n")
    io.out("                         values table.\n")
    io.out("  -s, --size-multiple=N  Affects the size of the generated hash table. The\n")
    io.out("                         numeric argument N indicates \"how many times larger\n")
    io.out("                         or smaller\" the associated value range should be,\n")
    io.out("                         in relationship to the number of keys, e.g. a value\n")
    io.out("                         of 3 means \"allow the maximum associated value to\n")
    io.out("                         be about 3 times larger than the number of input\n")
    io.out("                         keys\". Conversely, a value of 1/3 means \"make the\n")
    io.out("                         maximum associated value about 3 times smaller than\n")
    io.out("                         the number of input keys\". A larger table should\n")
    io.out("                         decrease the time required for an unsuccessful\n")
    io.out("                         search, at the expense of extra table space. Default\n")
    io.out("                         value is 1.\n")
    io.out("\n")
    io.out("Informative output:\n")
    io.out("  -h, --help             Print this message.\n")
    io.out("  -v, --version          Print the gperf version number.\n")
    io.out("  -d, --debug            Enables the debugging option (produces verbose\n")
    io.out("                         output to the standard error).\n")
    io.out("\n")
    io.out("Report bugs to <bug-gperf@gnu.org>.\n")
}

fn version() -> void {
    io.out("GNU gperf 3.1\nCopyright (C) 1989-2017 Free Software Foundation, Inc.\n")
    io.out("License GPLv3+: GNU GPL version 3 or later <http://gnu.org/licenses/gpl.html>\n")
    io.out("This is free software: you are free to change and redistribute it.\n")
    io.out("There is NO WARRANTY, to the extent permitted by law.\n")
    io.out("Written by Douglas C. Schmidt and Bruno Haible.\n")
}

// Codes of the long options without a short one (CHAR_MAX + 1 ...).
const OUTPUT_FILE: u64 = 128
const IGNORE_CASE: u64 = 129
const NULL_STRINGS: u64 = 130
const LENGTH_TABLE_NAME: u64 = 131
const CONSTANTS_PREFIX: u64 = 132
const LONG_COUNT: usize = 43

// The long option at INDEX: its name, its code and whether it takes an
// argument.
const LongOption = struct {
    name: []const u8
    code: u64
    takesArgument: bool
}

fn longOption(index: usize) -> LongOption {
    return match index {
        0 => LongOption.{ .name = "output-file", .code = OUTPUT_FILE, .takesArgument = true }
        1 => LongOption.{ .name = "ignore-case", .code = IGNORE_CASE, .takesArgument = false }
        2 => LongOption.{ .name = "delimiters", .code = 'e', .takesArgument = true }
        3 => LongOption.{ .name = "struct-type", .code = 't', .takesArgument = false }
        4 => LongOption.{ .name = "language", .code = 'L', .takesArgument = true }
        5 => LongOption.{ .name = "slot-name", .code = 'K', .takesArgument = true }
        6 => LongOption.{ .name = "initializer-suffix", .code = 'F', .takesArgument = true }
        7 => LongOption.{ .name = "hash-fn-name", .code = 'H', .takesArgument = true }
        8 => LongOption.{ .name = "hash-function-name", .code = 'H', .takesArgument = true }
        9 => LongOption.{ .name = "lookup-fn-name", .code = 'N', .takesArgument = true }
        10 => LongOption.{ .name = "lookup-function-name", .code = 'N', .takesArgument = true }
        11 => LongOption.{ .name = "class-name", .code = 'Z', .takesArgument = true }
        12 => LongOption.{ .name = "seven-bit", .code = '7', .takesArgument = false }
        13 => LongOption.{ .name = "compare-strncmp", .code = 'c', .takesArgument = false }
        14 => LongOption.{ .name = "readonly-tables", .code = 'C', .takesArgument = false }
        15 => LongOption.{ .name = "enum", .code = 'E', .takesArgument = false }
        16 => LongOption.{ .name = "includes", .code = 'I', .takesArgument = false }
        17 => LongOption.{ .name = "global-table", .code = 'G', .takesArgument = false }
        18 => LongOption.{ .name = "constants-prefix", .code = CONSTANTS_PREFIX, .takesArgument = true }
        19 => LongOption.{ .name = "word-array-name", .code = 'W', .takesArgument = true }
        20 => LongOption.{ .name = "length-table-name", .code = LENGTH_TABLE_NAME, .takesArgument = true }
        21 => LongOption.{ .name = "switch", .code = 'S', .takesArgument = true }
        22 => LongOption.{ .name = "omit-struct-type", .code = 'T', .takesArgument = false }
        23 => LongOption.{ .name = "key-positions", .code = 'k', .takesArgument = true }
        24 => LongOption.{ .name = "compare-strlen", .code = 'l', .takesArgument = false }
        25 => LongOption.{ .name = "compare-lengths", .code = 'l', .takesArgument = false }
        26 => LongOption.{ .name = "duplicates", .code = 'D', .takesArgument = false }
        27 => LongOption.{ .name = "fast", .code = 'f', .takesArgument = true }
        28 => LongOption.{ .name = "initial-asso", .code = 'i', .takesArgument = true }
        29 => LongOption.{ .name = "jump", .code = 'j', .takesArgument = true }
        30 => LongOption.{ .name = "multiple-iterations", .code = 'm', .takesArgument = true }
        31 => LongOption.{ .name = "no-strlen", .code = 'n', .takesArgument = false }
        32 => LongOption.{ .name = "occurrence-sort", .code = 'o', .takesArgument = false }
        33 => LongOption.{ .name = "optimized-collision-resolution", .code = 'O', .takesArgument = false }
        34 => LongOption.{ .name = "pic", .code = 'P', .takesArgument = false }
        35 => LongOption.{ .name = "string-pool-name", .code = 'Q', .takesArgument = true }
        36 => LongOption.{ .name = "null-strings", .code = NULL_STRINGS, .takesArgument = false }
        37 => LongOption.{ .name = "random", .code = 'r', .takesArgument = false }
        38 => LongOption.{ .name = "size-multiple", .code = 's', .takesArgument = true }
        39 => LongOption.{ .name = "help", .code = 'h', .takesArgument = false }
        40 => LongOption.{ .name = "version", .code = 'v', .takesArgument = false }
        41 => LongOption.{ .name = "debug", .code = 'd', .takesArgument = false }
        else => LongOption.{ .name = "", .code = 0, .takesArgument = false }
    }
}

const SHORT_OPTIONS = "acCdDe:Ef:F:gGhH:i:Ij:k:K:lL:m:nN:oOpPQ:rs:S:tTvW:Z:7"

// Whether BYTE is a short option (TAKES_ARGUMENT tells whether it takes an
// argument).
fn shortOption(byte: u8, takesArgument: *bool) -> bool {
    const options = SHORT_OPTIONS
    var at: usize = 0
    while at < options.length {
        if options[at] == byte && byte != 58 {
            takesArgument.* = at + 1 < options.length && options[at + 1] == 58
            return true
        }
        at += 1
    }
    return false
}

// One option, as gperf's switch over getopt's results handles it.
fn handle(code: u64, argument: []const u8) -> void {
    if code == 'a' || code == 'f' || code == 'g' || code == 'o' || code == 'O' || code == 'p' {
        // Defaults now, or no longer needed.
    } else if code == 'c' {
        o.*.word |= COMP
    } else if code == 'C' {
        o.*.word |= CONST
    } else if code == 'd' {
        o.*.word |= DEBUG
        s.say(s.join3("Starting program ", o.*.programName, ", version 3.1, with debugging on.\n"))
    } else if code == 'D' {
        o.*.word |= DUP
    } else if code == 'e' {
        o.*.delimiters = argument
        o.*.delimitersSet = true
    } else if code == 'E' {
        o.*.word |= ENUM
    } else if code == 'F' {
        o.*.initializerSuffix = argument
        o.*.initializerSuffixSet = true
    } else if code == 'G' {
        o.*.word |= GLOBAL
    } else if code == 'h' {
        longUsage()
        const written = io.writeTo("", true)
        io.exit(0)
    } else if code == 'H' {
        o.*.hashName = argument
        o.*.hashNameSet = true
    } else if code == 'i' {
        o.*.initialAssoValue = atoi(argument)
        if o.*.initialAssoValue < 0 {
            s.say(s.join3("Initial value ", s.signedDecimal(o.*.initialAssoValue), " should be non-zero, ignoring and continuing.\n"))
        }
        if has(RANDOM) { s.say("warning, -r option superceeds -i, ignoring -i option and continuing\n") }
    } else if code == 'I' {
        o.*.word |= INCLUDE
    } else if code == 'j' {
        o.*.jump = atoi(argument)
        if o.*.jump < 0 {
            s.say(s.join3("Jump value ", s.signedDecimal(o.*.jump), " must be a positive number.\n"))
            usageError()
        } else if o.*.jump != 0 && o.*.jump % 2 == 0 {
            s.say(s.join3("Jump value ", s.signedDecimal(o.*.jump), " should be odd, adding 1 and continuing...\n"))
            o.*.jump += 1
        }
    } else if code == 'k' {
        readKeyPositions(argument)
    } else if code == 'K' {
        o.*.slotName = argument
        o.*.slotNameSet = true
    } else if code == 'l' {
        o.*.word |= LENTABLE
    } else if code == 'L' {
        o.*.languageSet = false
        setLanguage(argument)
    } else if code == 'm' {
        o.*.assoIterations = atoi(argument)
        if o.*.assoIterations < 0 {
            s.say("asso_iterations value must not be negative, assuming 0\n")
            o.*.assoIterations = 0
        }
    } else if code == 'n' {
        o.*.word |= NOLENGTH
    } else if code == 'N' {
        o.*.functionName = argument
        o.*.functionNameSet = true
    } else if code == 'P' {
        o.*.word |= SHAREDLIB
    } else if code == 'Q' {
        o.*.stringpoolName = argument
        o.*.stringpoolNameSet = true
    } else if code == 'r' {
        o.*.word |= RANDOM
        if o.*.initialAssoValue != 0 { s.say("warning, -r option supersedes -i, disabling -i option and continuing\n") }
    } else if code == 's' {
        readSizeMultiple(argument)
    } else if code == 'S' {
        o.*.word |= SWITCH
        o.*.totalSwitches = atoi(argument)
        if o.*.totalSwitches <= 0 {
            s.say(s.join3("number of switches ", argument, " must be a positive number\n"))
            usageError()
        }
    } else if code == 't' {
        o.*.word |= TYPE
    } else if code == 'T' {
        o.*.word |= NOTYPE
    } else if code == 'v' {
        version()
        const written = io.writeTo("", true)
        io.exit(0)
    } else if code == 'W' {
        o.*.wordlistName = argument
        o.*.wordlistNameSet = true
    } else if code == 'Z' {
        o.*.className = argument
        o.*.classNameSet = true
    } else if code == '7' {
        o.*.word |= SEVENBIT
    } else if code == OUTPUT_FILE {
        o.*.outputFileName = argument
        o.*.hasOutputFile = true
    } else if code == IGNORE_CASE {
        o.*.word |= UPPERLOWER
    } else if code == NULL_STRINGS {
        o.*.word |= NULLSTRINGS
    } else if code == LENGTH_TABLE_NAME {
        o.*.lengthtableName = argument
        o.*.lengthtableNameSet = true
    } else if code == CONSTANTS_PREFIX {
        o.*.constantsPrefix = argument
        o.*.constantsPrefixSet = true
    }
}

fn initialize(programName: []const u8) -> void {
    unsafe { o = @ptrFromInt(*Options, s.alloc(@sizeOf(Options))) }
    o.*.word = ANSIC
    o.*.programName = programName
    o.*.inputFileName = ""
    o.*.hasInputFile = false
    o.*.outputFileName = ""
    o.*.hasOutputFile = false
    o.*.languageSet = false
    o.*.jump = 5
    o.*.initialAssoValue = 0
    o.*.assoIterations = 0
    o.*.totalSwitches = 1
    o.*.sizeMultiple = 1.0
    o.*.functionName = "in_word_set"
    o.*.functionNameSet = false
    o.*.slotName = "name"
    o.*.slotNameSet = false
    o.*.initializerSuffix = ""
    o.*.initializerSuffixSet = false
    o.*.className = "Perfect_Hash"
    o.*.classNameSet = false
    o.*.hashName = "hash"
    o.*.hashNameSet = false
    o.*.wordlistName = "wordlist"
    o.*.wordlistNameSet = false
    o.*.lengthtableName = "lengthtable"
    o.*.lengthtableNameSet = false
    o.*.stringpoolName = "stringpool"
    o.*.stringpoolNameSet = false
    o.*.constantsPrefix = ""
    o.*.constantsPrefixSet = false
    o.*.delimiters = ","
    o.*.delimitersSet = false
    o.*.keyPositions.useall = false
    o.*.keyPositions.size = 0
}

// Reads the command line ARGUMENTS[0..COUNT] (ARGUMENTS[0] the program's
// name, as the header comment shows it).
pub fn parse(arguments: [*][]const u8, count: usize) -> void {
    initialize(arguments[0])
    unsafe { argumentVector = @ptrFromInt([*][]const u8, s.alloc((count + 1) * @sizeOf([]const u8))) }
    var optionIndices: [*]usize = undefined
    var otherIndices: [*]usize = undefined
    unsafe {
        optionIndices = @ptrFromInt([*]usize, s.alloc((count + 1) * 8))
        otherIndices = @ptrFromInt([*]usize, s.alloc((count + 1) * 8))
    }
    var options: usize = 0
    var others: usize = 0
    var index: usize = 1
    while index < count {
        const argument = arguments[index]
        if s.same(argument, "--") {
            // The rest are not options; "--" itself goes with the options.
            optionIndices[options] = index
            options += 1
            index += 1
            while index < count {
                otherIndices[others] = index
                others += 1
                index += 1
            }
            break
        }
        if argument.length >= 2 && argument[0] == 45 && argument[1] == 45 {
            optionIndices[options] = index
            options += 1
            const body = argument[2..argument.length]
            var nameEnd: usize = 0
            while nameEnd < body.length && body[nameEnd] != 61 { nameEnd += 1 }
            const name = body[0..nameEnd]
            var found: usize = LONG_COUNT
            var ambiguous = false
            var candidate: usize = 0
            while candidate < LONG_COUNT {
                const entry = longOption(candidate)
                if entry.name.length > 0 && s.startsWith(entry.name, name) {
                    if entry.name.length == name.length {
                        found = candidate
                        ambiguous = false
                        break
                    }
                    if found == LONG_COUNT {
                        found = candidate
                    } else {
                        const first = longOption(found)
                        if first.code != entry.code || first.takesArgument != entry.takesArgument { ambiguous = true }
                    }
                }
                candidate += 1
            }
            if ambiguous {
                s.say(s.join3(o.*.programName, ": option '", s.join3("--", name, "' is ambiguous\n")))
                usageError()
            }
            if found == LONG_COUNT {
                s.say(s.join3(o.*.programName, ": unrecognized option '", s.join(argument, "'\n")))
                usageError()
            }
            const entry = longOption(found)
            var value: []const u8 = ""
            if entry.takesArgument {
                if nameEnd < body.length {
                    value = body[nameEnd + 1..body.length]
                } else if index + 1 < count {
                    index += 1
                    value = arguments[index]
                    optionIndices[options] = index
                    options += 1
                } else {
                    s.say(s.join3(o.*.programName, ": option '", s.join3("--", entry.name, "' requires an argument\n")))
                    usageError()
                }
            } else if nameEnd < body.length {
                s.say(s.join3(o.*.programName, ": option '", s.join3("--", entry.name, "' doesn't allow an argument\n")))
                usageError()
            }
            handle(entry.code, value)
        } else if argument.length >= 2 && argument[0] == 45 {
            optionIndices[options] = index
            options += 1
            var at: usize = 1
            while at < argument.length {
                const byte = argument[at]
                var takesArgument = false
                if !shortOption(byte, &takesArgument) {
                    s.say(s.join3(o.*.programName, ": invalid option -- '", s.join(argument[at..at + 1], "'\n")))
                    usageError()
                }
                if takesArgument {
                    var value: []const u8 = ""
                    if at + 1 < argument.length {
                        value = argument[at + 1..argument.length]
                    } else if index + 1 < count {
                        index += 1
                        value = arguments[index]
                        optionIndices[options] = index
                        options += 1
                    } else {
                        s.say(s.join3(o.*.programName, ": option requires an argument -- '", s.join(argument[at..at + 1], "'\n")))
                        usageError()
                    }
                    handle(@intCast(u64, byte), value)
                    break
                }
                handle(@intCast(u64, byte), "")
                at += 1
            }
        } else {
            otherIndices[others] = index
            others += 1
        }
        index += 1
    }
    // getopt's permutation: the program, the options, then the rest.
    argumentVector[0] = arguments[0]
    argumentCount = 1
    var k: usize = 0
    while k < options {
        argumentVector[argumentCount] = arguments[optionIndices[k]]
        argumentCount += 1
        k += 1
    }
    k = 0
    while k < others {
        argumentVector[argumentCount] = arguments[otherIndices[k]]
        argumentCount += 1
        k += 1
    }
    if others > 0 {
        o.*.inputFileName = arguments[otherIndices[0]]
        o.*.hasInputFile = true
    }
    if others > 1 {
        s.say(s.join3("Extra trailing arguments to ", o.*.programName, ".\n"))
        usageError()
    }
}

fn isShellSpecial(byte: u8) -> bool {
    for special in "\t\n !\"#$&'()*;<>?[\\]`{|}~" {
        if byte == special { return true }
    }
    return false
}

// "/* Command-line: ... */", each argument quoted for a shell if need be.
pub fn printOptions() -> void {
    io.out("/* Command-line: ")
    var index: usize = 0
    while index < argumentCount {
        const argument = argumentVector[index]
        var at: usize = 0
        if byteAt(argument, 0) == 45 {
            io.outByte(45)
            at = 1
            if isLetter(byteAt(argument, at)) {
                io.outByte(argument[at])
                at += 1
            } else if byteAt(argument, at) == 45 {
                while true {
                    io.outByte(argument[at])
                    at += 1
                    const next = byteAt(argument, at)
                    if !(isLetter(next) || next == 45) { break }
                }
                if byteAt(argument, at) == 61 {
                    io.outByte(61)
                    at += 1
                }
            }
        }
        const rest = argument[at..argument.length]
        var special = false
        var quote = false
        for byte in rest {
            if isShellSpecial(byte) {
                special = true
            }
            if byte == 39 { quote = true }
        }
        if special {
            if quote {
                io.outByte(34)
                for byte in rest {
                    if byte == 34 || byte == 92 || byte == 36 || byte == 96 { io.outByte(92) }
                    io.outByte(byte)
                }
                io.outByte(34)
            } else {
                io.outByte(39)
                for byte in rest {
                    if byte == 92 { io.outByte(92) }
                    io.outByte(byte)
                }
                io.outByte(39)
            }
        } else {
            io.out(rest)
        }
        io.out(" ")
        index += 1
    }
    io.out(" */")
}
