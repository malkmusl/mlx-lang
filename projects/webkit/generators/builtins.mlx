// The C++ of the JavaScript builtins of JavaScriptCore and WebCore, made
// as WebKit's generate-js-builtins.py makes them, from the builtins'
// JavaScript files:
//
//     webkit-builtins --framework JavaScriptCore|WebCore --output-directory DIR [--combined | --wrappers-only] FILE.js...
//
// Each file is an object, each function of it a builtin: its source
// embedded in a .cpp with how it may be called, and named in the macros
// of a .h. Three modes, as the script's:
//   --combined       one NAMESPACEBuiltins.h and .cpp for all the objects,
//                    the sources in one array of characters, each function
//                    an offset into it (JavaScriptCore's JSCBuiltins);
//   (neither)        for each object OBJECTBuiltins.h and .cpp, its sources
//                    string literals, and for WebCore the object's wrapper
//                    class (and its functions' holder when it is internal);
//   --wrappers-only  WebCore's JSBuiltins.h/.cpp, which hold every
//                    object's wrapper, and JSBuiltinInternals.h/.cpp, which
//                    hold the internal objects' functions.
// The license block gathers the copyright lines of every file. The model
// (builtinsmodel.mlx) reads the files as the script does, with the
// script's regular expressions; the text here is the script's
// generators', to the byte.
const std = @import("std")
const s = @import("./support.mlx")
const re = @import("./pyregex.mlx")
const model = @import("./builtinsmodel.mlx")

// ---------------------------------------------------------------------------
// Names.

fn namespaceName() -> []const u8 { return if model.framework == model.JAVASCRIPTCORE { "JSC" } else { "WebCore" } }
fn macroPrefix() -> []const u8 { return if model.framework == model.JAVASCRIPTCORE { "JSC" } else { "WEBCORE" } }
fn frameworkName() -> []const u8 { return if model.framework == model.JAVASCRIPTCORE { "JavaScriptCore" } else { "WebCore" } }

fn copyOf(text: []const u8) -> usize {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        s.put8(at + index, text[index])
        index += 1
    }
    s.put8(at + text.length, 0)
    return at
}

fn isLetter(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }
fn upper(byte: u8) -> u8 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }
fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// NAME with each "." and the letter after it made that letter, capital.
fn camel(name: []const u8) -> []const u8 {
    if !std.text.contains(name, ".") { return name }
    const at = s.alloc(name.length + 1)
    var written: usize = 0
    var index: usize = 0
    while index < name.length {
        if name[index] == 46 && index + 1 < name.length && isLetter(name[index + 1]) {
            s.put8(at + written, upper(name[index + 1]))
            index += 2
        } else {
            s.put8(at + written, name[index])
            index += 1
        }
        written += 1
    }
    return s.bytes(at, written)
}

fn withFirst(text: []const u8, byte: u8) -> []const u8 {
    if text.length == 0 { return text }
    const at = copyOf(text)
    s.put8(at, byte)
    return s.bytes(at, text.length)
}

// WK_ucfirst and WK_lcfirst of the script (CodeGenerator.pm's).
fn ucfirst(text: []const u8) -> []const u8 {
    if text.length == 0 { return text }
    var result = withFirst(text, upper(text[0]))
    result = re.replaceAll(result, "Xml", "XML")
    return re.replaceAll(result, "Svg", "SVG")
}

fn lcfirst(text: []const u8) -> []const u8 {
    if text.length == 0 { return text }
    var result = withFirst(text, lower(text[0]))
    result = re.replaceAll(result, "dOM", "dom")
    result = re.replaceAll(result, "uRL", "url")
    result = re.replaceAll(result, "jS", "js")
    result = re.replaceAll(result, "xML", "xml")
    result = re.replaceAll(result, "xSLT", "xslt")
    result = re.replaceAll(result, "cSS", "css")
    return re.replaceAll(result, "rTC", "rtc")
}

fn mangledObjectName(object: usize) -> []const u8 { return camel(model.objects[object].name) }

fn mangledFunctionName(f: *const model.Function) -> []const u8 {
    var name = camel(ucfirst(f.*.name))
    if f.*.isConstructor { name = s.join(name, "Constructor") }
    return lcfirst(s.join(mangledObjectName(f.*.object), name))
}

// The object's name without dots, capital.
fn objectMacro(object: usize) -> []const u8 {
    const name = model.objects[object].name
    const at = s.alloc(name.length + 1)
    var written: usize = 0
    for byte in name {
        if byte != 46 {
            s.put8(at + written, upper(byte))
            written += 1
        }
    }
    return s.bytes(at, written)
}

// ---------------------------------------------------------------------------
// What the generators share.

const LICENSE_TEXT = "Redistribution and use in source and binary forms, with or without\nmodification, are permitted provided that the following conditions\nare met:\n1. Redistributions of source code must retain the above copyright\n   notice, this list of conditions and the following disclaimer.\n2. Redistributions in binary form must reproduce the above copyright\n   notice, this list of conditions and the following disclaimer in the\n   documentation and/or other materials provided with the distribution.\n\nTHIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''\nAND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,\nTHE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR\nPURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS\nBE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR\nCONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF\nSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\nINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\nCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\nARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF\nTHE POSSIBILITY OF SUCH DAMAGE.\n"

const DO_NOT_EDIT_WARNING = "// DO NOT EDIT THIS FILE. It is automatically generated from JavaScript files for\n// builtins by the script: Source/JavaScriptCore/Scripts/generate-js-builtins.py"

// Sections of a file are separated by an empty line.
var sectionCount: usize = 0

fn section(text: []const u8) -> void {
    if sectionCount > 0 { s.out("\n\n") }
    s.out(text)
    sectionCount += 1
}

// The start of a section given in pieces with s.out.
fn sectionStart() -> void {
    if sectionCount > 0 { s.out("\n\n") }
    sectionCount += 1
}

fn license() -> void {
    sectionStart()
    var count: usize = 0
    const copyrights = model.copyrights(&count)
    s.out("/*")
    var index: usize = 0
    while index < count {
        s.out("\n * Copyright (c) ")
        s.out(copyrights[index])
        index += 1
    }
    if count > 0 { s.out("\n * ") }
    var at: usize = 0
    var lineStart: usize = 0
    while at <= LICENSE_TEXT.length {
        if at == LICENSE_TEXT.length || LICENSE_TEXT[at] == 10 {
            s.out("\n * ")
            s.out(LICENSE_TEXT[lineStart..at])
            lineStart = at + 1
        }
        at += 1
    }
    s.out("\n */")
}

// The includes of ENTRIES that the framework takes: each entry
// "FRAMEWORKS|FRAMEWORK|PATH", FRAMEWORKS comma separated. Sorted, each
// once.
fn includes(entries: [*][]const u8, count: usize) -> void {
    var lines: [*][]const u8 = undefined
    unsafe { lines = @ptrFromInt([*][]const u8, s.alloc((count + 1) * 16)) }
    var lineCount: usize = 0
    var index: usize = 0
    while index < count {
        const entry = entries[index]
        const bar = std.text.find(entry, "|")
        const allowed = entry[0..bar]
        const rest = entry[bar + 1..entry.length]
        const second = std.text.find(rest, "|")
        const owner = rest[0..second]
        const path = rest[second + 1..rest.length]
        var taken = false
        var from: usize = 0
        var at: usize = 0
        while at <= allowed.length {
            if at == allowed.length || allowed[at] == 44 {
                if std.text.same(allowed[from..at], frameworkName()) { taken = true }
                from = at + 1
            }
            at += 1
        }
        if taken {
            var line: []const u8 = ""
            if !std.text.same(owner, frameworkName()) {
                line = s.join3(s.join3("#include <", owner, "/"), s.baseName(path), ">")
            } else {
                line = s.join3("#include \"", s.baseName(path), "\"")
            }
            var known = false
            var other: usize = 0
            while other < lineCount {
                if std.text.same(lines[other], line) { known = true }
                other += 1
            }
            if !known {
                lines[lineCount] = line
                lineCount += 1
            }
        }
        index += 1
    }
    model.sortTexts(lines, lineCount)
    sectionStart()
    index = 0
    while index < lineCount {
        if index > 0 { s.out("\n") }
        s.out(lines[index])
        index += 1
    }
}

// The number of characters of UTF-8 TEXT (as Python counts a str).
fn characterCount(text: []const u8) -> usize {
    var count: usize = 0
    for byte in text {
        if byte < 128 || byte >= 192 { count += 1 }
    }
    return count
}

// The characters of UTF-8 TEXT as numbers, ", " between them.
fn outCharacters(text: []const u8, first: bool) -> void {
    var index: usize = 0
    var separate = !first
    while index < text.length {
        const byte = text[index]
        var value = @intCast(u64, byte)
        var extra: usize = 0
        if byte >= 240 {
            value = @intCast(u64, byte & 7)
            extra = 3
        } else if byte >= 224 {
            value = @intCast(u64, byte & 15)
            extra = 2
        } else if byte >= 192 {
            value = @intCast(u64, byte & 31)
            extra = 1
        } else if byte >= 128 {
            s.fail("UnicodeDecodeError: the builtins are not UTF-8")
        }
        index += 1
        while extra > 0 {
            if index >= text.length || text[index] < 128 || text[index] >= 192 { s.fail("UnicodeDecodeError: the builtins are not UTF-8") }
            value = (value << 6) | @intCast(u64, text[index] & 63)
            index += 1
            extra -= 1
        }
        if separate { s.out(", ") }
        separate = true
        s.outUnsigned(value)
    }
}

// The source of a builtin as embedded: wrapped in parentheses, as an
// expression, from its parameters on.
fn embeddedText(f: *const model.Function) -> []const u8 {
    const source = f.*.source
    const parenthesis = std.text.find(source, "(")
    if parenthesis == source.length { s.fail("ValueError: substring not found") }
    const head = if f.*.isAsync { "(async function " } else { "(function " }
    return s.join3(head, source[parenthesis..source.length], ")")
}

fn codeSection(f: *const model.Function, length: usize, embeddedSource: []const u8) -> void {
    const code = s.join(mangledFunctionName(f), "Code")
    sectionStart()
    s.out("constinit const JSC::ConstructAbility s_")
    s.out(code)
    s.out(if f.*.isConstructor { "ConstructAbility = JSC::ConstructAbility::CanConstruct;\n" } else { "ConstructAbility = JSC::ConstructAbility::CannotConstruct;\n" })
    s.out("constinit const JSC::ConstructorKind s_")
    s.out(code)
    s.out(if f.*.isNakedConstructor { "ConstructorKind = JSC::ConstructorKind::Naked;\n" } else { "ConstructorKind = JSC::ConstructorKind::None;\n" })
    s.out("constinit const JSC::ImplementationVisibility s_")
    s.out(code)
    s.out("ImplementationVisibility = JSC::ImplementationVisibility::")
    s.out(f.*.visibility)
    s.out(";\nconstinit const JSC::InlineAttribute s_")
    s.out(code)
    s.out(if f.*.isAlwaysInline { "InlineAttribute = JSC::InlineAttribute::Always;\n" } else { "InlineAttribute = JSC::InlineAttribute::None;\n" })
    s.out("constinit const int s_")
    s.out(code)
    s.out("Length = ")
    s.outUnsigned(@intCast(u64, length))
    s.out(";\nstatic constinit const JSC::Intrinsic s_")
    s.out(code)
    s.out("Intrinsic = JSC::")
    s.out(f.*.intrinsic)
    s.out(";\nconstinit const char* const s_")
    s.out(code)
    s.out(" =\n")
    s.out(embeddedSource)
    s.out("\n;")
}

// Whether the file at PATH holds TEXT exactly.
fn holds(path: []const u8, text: []const u8) -> bool {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(2, @intFromPtr(name.pointer), 0, 0)
    if descriptor < 0 { return false }
    const data = s.alloc(text.length + 1)
    var length: usize = 0
    while length < text.length + 1 {
        const count = std.linux.syscall3(0, @bitCast(usize, descriptor), data + length, text.length + 1 - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(3, @bitCast(usize, descriptor))
    return length == text.length && std.text.same(s.bytes(data, length), text)
}

var force: bool = false

// Writes what was made since FROM in the output buffer to DIRECTORY/NAME,
// its trailing space made one newline, unless the file holds it already
// (the script's LazyFileWriter).
fn writeFile(directory: []const u8, name: []const u8, from: usize) -> void {
    const all = s.output()
    const text = all[from..all.length]
    var end = text.length
    while end > 0 && re.isSpace(text[end - 1]) { end -= 1 }
    const path = if directory.length == 0 || std.text.endsWith(directory, "/") { s.join(directory, name) } else { s.join3(directory, "/", name) }
    const contents = s.join(text[0..end], "\n")
    if !force && holds(path, contents) { return }
    s.writeWhole(path, contents)
}

// ---------------------------------------------------------------------------
// The combined header: every builtin of the framework declared.

fn combinedHeader() -> void {
    const ns = namespaceName()
    const prefix = macroPrefix()
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    section("#pragma once")
    section("#include <cstdint>")
    section("namespace JSC {\nclass FunctionExecutable;\nclass VM;\n\nenum class ConstructAbility : uint8_t;\nenum class ConstructorKind : uint8_t;\nenum class ImplementationVisibility : uint8_t;\nenum class InlineAttribute : uint8_t;\n}")
    section(s.join3("namespace ", ns, " {"))
    section(s.join3("extern const char s_", ns, "CombinedCode[];"))
    section(s.join3("extern const unsigned s_", ns, "CombinedCodeLength;"))
    var object: usize = 0
    while object < model.objectCount {
        const o = model.objects[object]
        sectionStart()
        s.out("/* ")
        s.out(o.name)
        s.out(" */\n")
        var index = o.firstFunction
        while index < o.firstFunction + o.functionCount {
            const code = s.join(mangledFunctionName(&model.functions[index]), "Code")
            s.out("extern constinit const char* const s_")
            s.out(code)
            s.out(";\nextern constinit const int s_")
            s.out(code)
            s.out("Length;\nextern constinit const JSC::ConstructAbility s_")
            s.out(code)
            s.out("ConstructAbility;\nextern constinit const JSC::ConstructorKind s_")
            s.out(code)
            s.out("ConstructorKind;\nextern constinit const JSC::ImplementationVisibility s_")
            s.out(code)
            s.out("ImplementationVisibility;\nextern constinit const JSC::InlineAttribute s_")
            s.out(code)
            s.out("InlineAttribute;\n")
            index += 1
        }
        s.out("\n#define ")
        s.out(prefix)
        s.out("_FOREACH_")
        s.out(objectMacro(object))
        s.out("_BUILTIN_DATA(macro) \\")
        index = o.firstFunction
        while index < o.firstFunction + o.functionCount {
            const f = &model.functions[index]
            s.out("\n    macro(")
            s.out(f.*.name)
            s.out(", ")
            s.out(mangledFunctionName(f))
            s.out(", ")
            s.outUnsigned(@intCast(u64, f.*.parameterCount))
            s.out(") \\")
            index += 1
        }
        object += 1
    }

    var count: usize = 0
    const sorted = model.sortedFunctions(false, &count)
    sectionStart()
    s.out("#define ")
    s.out(prefix)
    s.out("_FOREACH_BUILTIN_CODE(macro) \\")
    var index: usize = 0
    while index < count {
        const f = &model.functions[sorted[index]]
        const code = s.join(mangledFunctionName(f), "Code")
        s.out("\n    macro(")
        s.out(code)
        s.out(", ")
        s.out(f.*.name)
        s.out(", ")
        s.out(f.*.overriddenName)
        s.out(", s_")
        s.out(code)
        s.out("Length) \\")
        index += 1
    }

    var internalCount: usize = 0
    const internal = model.sortedFunctions(true, &internalCount)
    index = 1
    while index < internalCount {
        if std.text.same(model.functions[internal[index]].name, model.functions[internal[index - 1]].name) {
            s.say("ERROR: There are several internal functions with the same name. Private identifiers may clash.\n")
            break
        }
        index += 1
    }

    sectionStart()
    s.out("#define ")
    s.out(prefix)
    s.out("_FOREACH_BUILTIN_FUNCTION_NAME(macro) \\")
    index = 0
    while index < count {
        const name = model.functions[sorted[index]].name
        if index == 0 || !std.text.same(name, model.functions[sorted[index - 1]].name) {
            s.out("\n    macro(")
            s.out(name)
            s.out(") \\")
        }
        index += 1
    }

    sectionStart()
    s.out("#define ")
    s.out(prefix)
    s.out("_FOREACH_BUILTIN_LINK_TIME_CONSTANT(macro) \\")
    index = 0
    while index < count {
        const f = &model.functions[sorted[index]]
        if f.*.isLinkTimeConstant {
            s.out("\n    macro(")
            s.out(f.*.name)
            s.out(", ")
            s.out(mangledFunctionName(f))
            s.out(") \\")
        }
        index += 1
    }

    sectionStart()
    s.out("#define DECLARE_BUILTIN_GENERATOR(codeName, functionName, overriddenName, argumentCount) \\\n    JSC::FunctionExecutable* codeName##Generator(JSC::VM&);\n\n")
    s.out(prefix)
    s.out("_FOREACH_BUILTIN_CODE(DECLARE_BUILTIN_GENERATOR)\n#undef DECLARE_BUILTIN_GENERATOR")
    section(s.join3("} // namespace ", ns, ""))
}

// ---------------------------------------------------------------------------
// The combined implementation: the sources in one array, and each
// builtin's data.

fn combinedImplementation() -> void {
    const ns = namespaceName()
    const prefix = macroPrefix()
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    section(s.join3("#include \"config.h\"\n#include \"", ns, "Builtins.h\""))
    var entries: [8][]const u8 = undefined
    entries[0] = "JavaScriptCore|JavaScriptCore|builtins/BuiltinExecutables.h"
    entries[1] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/UnlinkedFunctionExecutable.h"
    entries[2] = "JavaScriptCore|JavaScriptCore|runtime/JSCellInlines.h"
    entries[3] = "WebCore|JavaScriptCore|runtime/JSObjectInlines.h"
    entries[4] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/VM.h"
    entries[5] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/IdentifierInlines.h"
    entries[6] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/ImplementationVisibility.h"
    entries[7] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/Intrinsic.h"
    includes(&entries, 8)
    section(s.join3("namespace ", ns, " {"))

    var count: usize = 0
    const sorted = model.sortedFunctions(false, &count)
    sectionStart()
    s.out("constinit const char s_")
    s.out(ns)
    s.out("CombinedCode[] = { ")
    var total: usize = 0
    var index: usize = 0
    while index < count {
        const text = embeddedText(&model.functions[sorted[index]])
        outCharacters(text, index == 0)
        if total > 0 || text.length > 0 { s.out(", ") }
        s.out("10")
        total += characterCount(text) + 1
        index += 1
    }
    s.out(" };")
    sectionStart()
    s.out("constinit const unsigned s_")
    s.out(ns)
    s.out("CombinedCodeLength = ")
    s.outUnsigned(@intCast(u64, total))
    s.out(";")

    var offset: usize = 0
    index = 0
    while index < count {
        const f = &model.functions[sorted[index]]
        const length = characterCount(embeddedText(f)) + 1
        codeSection(f, length, s.join3(s.join3("s_", ns, "CombinedCode + "), s.decimal(@intCast(u64, offset)), ""))
        offset += length
        index += 1
    }

    if model.framework == model.JAVASCRIPTCORE {
        sectionStart()
        s.out("\n#define DEFINE_BUILTIN_GENERATOR(codeName, functionName, overriddenName, argumentCount) \\\nJSC::FunctionExecutable* codeName##Generator(JSC::VM& vm) \\\n{\\\n    return vm.builtinExecutables()->codeName##Executable()->link(vm, nullptr, vm.builtinExecutables()->codeName##Source(), std::nullopt, s_##codeName##Intrinsic); }\n")
        s.out(prefix)
        s.out("_FOREACH_BUILTIN_CODE(DEFINE_BUILTIN_GENERATOR)\n#undef DEFINE_BUILTIN_GENERATOR\n")
    } else {
        // The script's template for it wants a name it is not given.
        s.fail("KeyError: 'objectNameLC'")
    }
    section(s.join3("} // namespace ", ns, ""))
}

// ---------------------------------------------------------------------------
// The separate files of WebCore: for each object a .h and a .cpp, its
// sources embedded as string literals.

// The templates of the script (builtins_templates.py), ${name} standing
// for the object's names.
const SEPARATE_HEADER_STATIC_MACROS = "#define DECLARE_BUILTIN_GENERATOR(codeName, functionName, overriddenName, argumentCount) \\\n    JSC::FunctionExecutable* codeName##Generator(JSC::VM&);\n\n${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(DECLARE_BUILTIN_GENERATOR)\n#undef DECLARE_BUILTIN_GENERATOR"
const SEPARATE_WEBCORE_IMPLEMENTATION_STATIC_MACROS = "\n#define DEFINE_BUILTIN_GENERATOR(codeName, functionName, overriddenName, argumentCount) \\\nJSC::FunctionExecutable* codeName##Generator(JSC::VM& vm) \\\n{\\\n    JSVMClientData* clientData = downcast<JSVMClientData>(vm.clientData); \\\n    return clientData->builtinFunctions().${objectNameLC}Builtins().codeName##Executable()->link(vm, nullptr, clientData->builtinFunctions().${objectNameLC}Builtins().codeName##Source(), std::nullopt, s_##codeName##Intrinsic); \\\n}\n${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(DEFINE_BUILTIN_GENERATOR)\n#undef DEFINE_BUILTIN_GENERATOR\n"
const SEPARATE_JSC_IMPLEMENTATION_STATIC_MACROS = "\n#define DEFINE_BUILTIN_GENERATOR(codeName, functionName, overriddenName, argumentCount) \\\nJSC::FunctionExecutable* codeName##Generator(JSC::VM& vm) \\\n{\\\n    return vm.builtinExecutables()->codeName##Executable()->link(vm, nullptr, vm.builtinExecutables()->codeName##Source(), std::nullopt, s_##codeName##Intrinsic); }\n${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(DEFINE_BUILTIN_GENERATOR)\n#undef DEFINE_BUILTIN_GENERATOR\n"
const SEPARATE_HEADER_WRAPPER_BOILERPLATE = "class ${objectName}BuiltinsWrapper : private JSC::WeakHandleOwner {\npublic:\n    explicit ${objectName}BuiltinsWrapper(JSC::VM& vm)\n        : m_vm(vm)\n        ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_FUNCTION_NAME(INITIALIZE_BUILTIN_NAMES)\n#define INITIALIZE_BUILTIN_SOURCE_MEMBERS(name, functionName, overriddenName, length) , m_##name##Source(JSC::makeSource(StringImpl::createWithoutCopying(unsafeMakeSpan(s_##name, static_cast<size_t>(length))), { }, JSC::SourceTaintedOrigin::Untainted))\n        ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(INITIALIZE_BUILTIN_SOURCE_MEMBERS)\n#undef INITIALIZE_BUILTIN_SOURCE_MEMBERS\n    {\n    }\n\n#define EXPOSE_BUILTIN_EXECUTABLES(name, functionName, overriddenName, length) \\\n    JSC::UnlinkedFunctionExecutable* name##Executable(); \\\n    const JSC::SourceCode& name##Source() const { return m_##name##Source; }\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(EXPOSE_BUILTIN_EXECUTABLES)\n#undef EXPOSE_BUILTIN_EXECUTABLES\n\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_FUNCTION_NAME(DECLARE_BUILTIN_IDENTIFIER_ACCESSOR)\n\n    void exportNames();\n\nprivate:\n    JSC::VM& m_vm;\n\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_FUNCTION_NAME(DECLARE_BUILTIN_NAMES)\n\n#define DECLARE_BUILTIN_SOURCE_MEMBERS(name, functionName, overriddenName, length) \\\n    JSC::SourceCode m_##name##Source;\\\n    JSC::Weak<JSC::UnlinkedFunctionExecutable> m_##name##Executable;\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(DECLARE_BUILTIN_SOURCE_MEMBERS)\n#undef DECLARE_BUILTIN_SOURCE_MEMBERS\n\n};\n\n#define DEFINE_BUILTIN_EXECUTABLES(name, functionName, overriddenName, length) \\\ninline JSC::UnlinkedFunctionExecutable* ${objectName}BuiltinsWrapper::name##Executable() \\\n{\\\n    if (!m_##name##Executable) {\\\n        JSC::Identifier executableName = functionName##PublicName();\\\n        if (overriddenName)\\\n            executableName = JSC::Identifier::fromString(m_vm, overriddenName);\\\n        m_##name##Executable = JSC::Weak<JSC::UnlinkedFunctionExecutable>(JSC::createBuiltinExecutable(m_vm, m_##name##Source, executableName, s_##name##ImplementationVisibility, s_##name##ConstructorKind, s_##name##ConstructAbility, s_##name##InlineAttribute), this, &m_##name##Executable);\\\n    }\\\n    return m_##name##Executable.get();\\\n}\n${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(DEFINE_BUILTIN_EXECUTABLES)\n#undef DEFINE_BUILTIN_EXECUTABLES\n\ninline void ${objectName}BuiltinsWrapper::exportNames()\n{\n#define EXPORT_FUNCTION_NAME(name) m_vm.propertyNames->appendExternalName(name##PublicName(), name##PrivateName());\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_FUNCTION_NAME(EXPORT_FUNCTION_NAME)\n#undef EXPORT_FUNCTION_NAME\n}"
const SEPARATE_HEADER_INTERNAL_FUNCTIONS_BOILERPLATE = "class ${objectName}BuiltinFunctions {\npublic:\n    explicit ${objectName}BuiltinFunctions(JSC::VM& vm) : m_vm(vm) { }\n\n    void init(JSC::JSGlobalObject&);\n    template<typename Visitor> void visit(Visitor&);\n\npublic:\n    JSC::VM& m_vm;\n\n#define DECLARE_BUILTIN_SOURCE_MEMBERS(functionName) \\\n    JSC::WriteBarrier<JSC::JSFunction> m_##functionName##Function;\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_FUNCTION_NAME(DECLARE_BUILTIN_SOURCE_MEMBERS)\n#undef DECLARE_BUILTIN_SOURCE_MEMBERS\n};\n\ninline void ${objectName}BuiltinFunctions::init(JSC::JSGlobalObject& globalObject)\n{\n#define EXPORT_FUNCTION(codeName, functionName, overriddenName, length)\\\n    m_##functionName##Function.set(m_vm, &globalObject, JSC::JSFunction::create(m_vm, &globalObject, codeName##Generator(m_vm), &globalObject));\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_CODE(EXPORT_FUNCTION)\n#undef EXPORT_FUNCTION\n}\n\ntemplate<typename Visitor>\ninline void ${objectName}BuiltinFunctions::visit(Visitor& visitor)\n{\n#define VISIT_FUNCTION(name) visitor.append(m_##name##Function);\n    ${macroPrefix}_FOREACH_${objectMacro}_BUILTIN_FUNCTION_NAME(VISIT_FUNCTION)\n#undef VISIT_FUNCTION\n}\n\ntemplate void ${objectName}BuiltinFunctions::visit(JSC::AbstractSlotVisitor&);\ntemplate void ${objectName}BuiltinFunctions::visit(JSC::SlotVisitor&);\n\n"

// The value of the object's annotation KEY ("" for a flag or none).
fn annotation(object: usize, key: []const u8) -> []const u8 {
    const o = &model.objects[object]
    var index: usize = 0
    while index < o.*.annotationCount {
        if std.text.same(o.*.keys[index], key) { return o.*.values[index] }
        index += 1
    }
    return ""
}

fn isInternal(object: usize) -> bool { return model.hasAnnotation(&model.objects[object], "internal") }

// NAME in capitals, its dots made REPLACEMENT (when not 0) or kept.
fn capitals(name: []const u8, replacement: u8) -> []const u8 {
    const at = copyOf(name)
    var index: usize = 0
    while index < name.length {
        var byte = upper(name[index])
        if byte == 46 && replacement != 0 { byte = replacement }
        s.put8(at + index, byte)
        index += 1
    }
    return s.bytes(at, name.length)
}

// TEMPLATE with each ${key} made the object's value (string.Template).
fn substitute(template: []const u8, object: usize) -> []const u8 {
    var result: []const u8 = ""
    var from: usize = 0
    var at: usize = 0
    while at < template.length {
        if template[at] != 36 {
            at += 1
            continue
        }
        result = s.join(result, template[from..at])
        const close = at + std.text.find(template[at..template.length], "}")
        const key = template[at + 2..close]
        const name = model.objects[object].name
        var value: []const u8 = ""
        if std.text.same(key, "namespace") {
            value = namespaceName()
        } else if std.text.same(key, "macroPrefix") {
            value = macroPrefix()
        } else if std.text.same(key, "objectName") {
            value = name
        } else if std.text.same(key, "objectMacro") {
            value = capitals(name, 0)
        } else if std.text.same(key, "objectNameLC") {
            value = lcfirst(name)
        } else {
            s.fail(s.join("KeyError: ", key))
        }
        result = s.join(result, value)
        at = close + 1
        from = at
    }
    return s.join(result, template[from..template.length])
}

const HEX = "0123456789abcdef"

// A text being built byte by byte, in the arena.
var buildAt: usize = 0
var buildLength: usize = 0

fn put(text: []const u8) -> void {
    for byte in text {
        s.put8(buildAt + buildLength, byte)
        buildLength += 1
    }
}

fn putEscape(value: u64) -> void {
    put("\\u")
    var shift: u6 = 12
    while true {
        const digit = @intCast(usize, (value >> shift) & 15)
        put(HEX[digit..digit + 1])
        if shift == 0 { break }
        shift -= 4
    }
}

// TEXT as json.dumps writes it inside its quotes (ASCII only).
fn jsonEscaped(text: []const u8) -> []const u8 {
    buildAt = s.alloc(text.length * 12 + 16)
    buildLength = 0
    var index: usize = 0
    while index < text.length {
        const byte = text[index]
        index += 1
        if byte == 34 {
            put("\\\"")
        } else if byte == 92 {
            put("\\\\")
        } else if byte == 10 {
            put("\\n")
        } else if byte == 13 {
            put("\\r")
        } else if byte == 9 {
            put("\\t")
        } else if byte == 8 {
            put("\\b")
        } else if byte == 12 {
            put("\\f")
        } else if byte >= 32 && byte < 127 {
            put(text[index - 1..index])
        } else if byte < 128 {
            putEscape(@intCast(u64, byte))
        } else {
            var value: u64 = 0
            var extra: usize = 0
            if byte >= 240 {
                value = @intCast(u64, byte & 7)
                extra = 3
            } else if byte >= 224 {
                value = @intCast(u64, byte & 15)
                extra = 2
            } else if byte >= 192 {
                value = @intCast(u64, byte & 31)
                extra = 1
            } else {
                s.fail("UnicodeDecodeError: the builtins are not UTF-8")
            }
            while extra > 0 {
                if index >= text.length || text[index] < 128 || text[index] >= 192 { s.fail("UnicodeDecodeError: the builtins are not UTF-8") }
                value = (value << 6) | @intCast(u64, text[index] & 63)
                index += 1
                extra -= 1
            }
            if value >= 65536 {
                // Outside the BMP: a surrogate pair.
                const rest = value - 65536
                putEscape(55296 + (rest >> 10))
                putEscape(56320 + (rest & 1023))
            } else {
                putEscape(value)
            }
        }
    }
    return s.bytes(buildAt, buildLength)
}

// The source of F as the separate files embed it: one string literal a
// line, each with its "\n" (the lines cut where the escaped text has \n,
// as the script cuts them).
fn embeddedLines(f: *const model.Function) -> []const u8 {
    const escaped = jsonEscaped(embeddedText(f))
    var result: []const u8 = ""
    var from: usize = 0
    var at: usize = 0
    var first = true
    while true {
        var end = at
        while end + 1 < escaped.length && !(escaped[end] == 92 && escaped[end + 1] == 110) { end += 1 }
        const last = end + 1 >= escaped.length
        const line = if last { escaped[from..escaped.length] } else { escaped[from..end] }
        if !first { result = s.join(result, "\n") }
        first = false
        result = s.join(result, s.join3("    \"", line, "\\n\" \\"))
        if last { break }
        from = end + 2
        at = from
    }
    return result
}

fn separateHeader(object: usize) -> void {
    const o = model.objects[object]
    const ns = namespaceName()
    const prefix = macroPrefix()
    const guard = annotation(object, "conditional")
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    section("#pragma once")
    if guard.length != 0 { section(s.join("#if ", guard)) }
    section("#include <cstdint>")
    var entries: [5][]const u8 = undefined
    entries[0] = "WebCore|JavaScriptCore|bytecode/UnlinkedFunctionExecutable.h"
    entries[1] = "WebCore|JavaScriptCore|builtins/BuiltinUtils.h"
    entries[2] = "WebCore|JavaScriptCore|runtime/Identifier.h"
    entries[3] = "WebCore|JavaScriptCore|runtime/JSFunction.h"
    entries[4] = "WebCore|JavaScriptCore|heap/SlotVisitorInlines.h"
    includes(&entries, 5)
    section("namespace JSC {\nclass FunctionExecutable;\n}")
    section(s.join3("namespace ", ns, " {"))

    sectionStart()
    s.out("/* ")
    s.out(o.name)
    s.out(" */")
    var index = o.firstFunction
    while index < o.firstFunction + o.functionCount {
        const code = s.join(mangledFunctionName(&model.functions[index]), "Code")
        s.out("\nextern const char* const s_")
        s.out(code)
        s.out(";\nextern const int s_")
        s.out(code)
        s.out("Length;\nextern const JSC::ConstructAbility s_")
        s.out(code)
        s.out("ConstructAbility;\nextern const JSC::ConstructorKind s_")
        s.out(code)
        s.out("ConstructorKind;\nextern const JSC::ImplementationVisibility s_")
        s.out(code)
        s.out("ImplementationVisibility;\nextern const JSC::InlineAttribute s_")
        s.out(code)
        s.out("InlineAttribute;")
        index += 1
    }
    const dataMacro = capitals(o.name, 95)
    s.out("\n\n#define ")
    s.out(prefix)
    s.out("_FOREACH_")
    s.out(dataMacro)
    s.out("_BUILTIN_DATA(macro) \\")
    index = o.firstFunction
    while index < o.firstFunction + o.functionCount {
        const f = &model.functions[index]
        s.out("\n    macro(")
        s.out(f.*.name)
        s.out(", ")
        s.out(mangledFunctionName(f))
        s.out(", ")
        s.outUnsigned(@intCast(u64, f.*.parameterCount))
        s.out(") \\")
        index += 1
    }
    s.out("\n")
    index = o.firstFunction
    while index < o.firstFunction + o.functionCount {
        s.out("\n#define ")
        s.out(prefix)
        s.out("_BUILTIN_")
        s.out(dataMacro)
        s.out("_")
        s.out(capitals(model.functions[index].name, 0))
        s.out(" 1")
        index += 1
    }

    const objectMacro = capitals(o.name, 0)
    sectionStart()
    s.out("#define ")
    s.out(prefix)
    s.out("_FOREACH_")
    s.out(objectMacro)
    s.out("_BUILTIN_CODE(macro) \\")
    index = o.firstFunction
    while index < o.firstFunction + o.functionCount {
        const f = &model.functions[index]
        const code = s.join(mangledFunctionName(f), "Code")
        s.out("\n    macro(")
        s.out(code)
        s.out(", ")
        s.out(f.*.name)
        s.out(", ")
        s.out(f.*.overriddenName)
        s.out(", s_")
        s.out(code)
        s.out("Length) \\")
        index += 1
    }

    // The names of the functions, sorted, each once.
    var names: [*][]const u8 = undefined
    unsafe { names = @ptrFromInt([*][]const u8, s.alloc((o.functionCount + 1) * 16)) }
    var nameCount: usize = 0
    index = o.firstFunction
    while index < o.firstFunction + o.functionCount {
        const name = model.functions[index].name
        var known = false
        var other: usize = 0
        while other < nameCount {
            if std.text.same(names[other], name) { known = true }
            other += 1
        }
        if !known {
            names[nameCount] = name
            nameCount += 1
        }
        index += 1
    }
    model.sortTexts(names, nameCount)
    sectionStart()
    s.out("#define ")
    s.out(prefix)
    s.out("_FOREACH_")
    s.out(objectMacro)
    s.out("_BUILTIN_FUNCTION_NAME(macro) \\")
    index = 0
    while index < nameCount {
        s.out("\n    macro(")
        s.out(names[index])
        s.out(") \\")
        index += 1
    }

    section(substitute(SEPARATE_HEADER_STATIC_MACROS, object))
    if model.framework == model.WEBCORE {
        section(substitute(SEPARATE_HEADER_WRAPPER_BOILERPLATE, object))
        if isInternal(object) { section(substitute(SEPARATE_HEADER_INTERNAL_FUNCTIONS_BOILERPLATE, object)) }
    }
    section(s.join3("} // namespace ", ns, ""))
    if guard.length != 0 { section(s.join("#endif // ", guard)) }
}

fn separateImplementation(object: usize) -> void {
    const o = model.objects[object]
    const ns = namespaceName()
    const guard = annotation(object, "conditional")
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    section(s.join3("#include \"config.h\"\n#include \"", mangledObjectName(object), "Builtins.h\""))
    if guard.length != 0 { section(s.join("#if ", guard)) }
    var entries: [8][]const u8 = undefined
    entries[0] = "JavaScriptCore|JavaScriptCore|builtins/BuiltinExecutables.h"
    entries[1] = "JavaScriptCore|JavaScriptCore|runtime/JSCellInlines.h"
    entries[2] = "WebCore|JavaScriptCore|runtime/JSObjectInlines.h"
    entries[3] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/VM.h"
    entries[4] = "WebCore|WebCore|bindings/js/WebCoreJSClientData.h"
    entries[5] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/IdentifierInlines.h"
    entries[6] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/ImplementationVisibility.h"
    entries[7] = "JavaScriptCore,WebCore|JavaScriptCore|runtime/Intrinsic.h"
    includes(&entries, 8)
    section(s.join3("namespace ", ns, " {"))
    var index = o.firstFunction
    while index < o.firstFunction + o.functionCount {
        const f = &model.functions[index]
        codeSection(f, characterCount(embeddedText(f)) + 1, embeddedLines(f))
        index += 1
    }
    if model.framework == model.JAVASCRIPTCORE {
        section(substitute(SEPARATE_JSC_IMPLEMENTATION_STATIC_MACROS, object))
    } else {
        section(substitute(SEPARATE_WEBCORE_IMPLEMENTATION_STATIC_MACROS, object))
    }
    section(s.join3("} // namespace ", ns, ""))
    if guard.length != 0 { section(s.join3("#endif // ", guard, "\n")) }
}

// ---------------------------------------------------------------------------
// The wrappers of WebCore: JSBuiltinFunctions holding every object's
// wrapper, JSBuiltinInternalFunctions those of the internal objects.

// TEXT inside #if GUARD ... #endif // GUARD when the guard is not empty,
// after a newline.
fn guarded(guard: []const u8, text: []const u8) -> void {
    s.out("\n")
    if guard.length != 0 {
        s.out("#if ")
        s.out(guard)
        s.out("\n")
    }
    s.out(text)
    if guard.length != 0 {
        s.out("\n#endif // ")
        s.out(guard)
    }
}

// The includes of FILE (Builtins.h or Builtins.cpp) of the objects, all
// or the internal ones, after the FIXED entries.
fn objectIncludes(fixed: [*][]const u8, fixedCount: usize, suffix: []const u8, internalOnly: bool) -> void {
    var entries: [*][]const u8 = undefined
    unsafe { entries = @ptrFromInt([*][]const u8, s.alloc((model.objectCount + fixedCount + 1) * 16)) }
    var count: usize = 0
    while count < fixedCount {
        entries[count] = fixed[count]
        count += 1
    }
    var object: usize = 0
    while object < model.objectCount {
        if !internalOnly || isInternal(object) {
            entries[count] = s.join3("WebCore|WebCore|", model.objects[object].name, suffix)
            count += 1
        }
        object += 1
    }
    includes(entries, count)
}

fn wrapperHeader() -> void {
    const ns = namespaceName()
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    section("#pragma once")
    section("#include <cstdint>")
    var fixed: [1][]const u8 = undefined
    fixed[0] = "WebCore|JavaScriptCore|runtime/VM.h"
    objectIncludes(&fixed, 1, "Builtins.h", false)
    section(s.join3("namespace ", ns, " {"))
    sectionStart()
    s.out("class JSBuiltinFunctions {\npublic:\n    explicit JSBuiltinFunctions(JSC::VM& vm)\n        : m_vm(vm)")
    var object: usize = 0
    while object < model.objectCount {
        guarded(annotation(object, "conditional"), s.join3("        , m_", lcfirst(model.objects[object].name), "Builtins(m_vm)"))
        object += 1
    }
    s.out("\n    {")
    object = 0
    while object < model.objectCount {
        if isInternal(object) { guarded(annotation(object, "conditional"), s.join3("        m_", lcfirst(model.objects[object].name), "Builtins.exportNames();")) }
        object += 1
    }
    s.out("\n    }\n")
    object = 0
    while object < model.objectCount {
        const name = model.objects[object].name
        guarded(annotation(object, "conditional"), s.join3(s.join3("    ", ucfirst(name), "BuiltinsWrapper& "), lcfirst(name), s.join3("Builtins() { return m_", lcfirst(name), "Builtins; }")))
        object += 1
    }
    s.out("\n\nprivate:\n    JSC::VM& m_vm;")
    object = 0
    while object < model.objectCount {
        const name = model.objects[object].name
        guarded(annotation(object, "conditional"), s.join3(s.join3("    ", ucfirst(name), "BuiltinsWrapper m_"), lcfirst(name), "Builtins;"))
        object += 1
    }
    s.out("\n};")
    section(s.join3("} // namespace ", ns, ""))
}

fn wrapperImplementation() -> void {
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    var fixed: [1][]const u8 = undefined
    objectIncludes(&fixed, 0, "Builtins.cpp", false)
}

fn internalsHeader() -> void {
    const ns = namespaceName()
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    section("#pragma once")
    section("#include <cstdint>")
    var fixed: [2][]const u8 = undefined
    fixed[0] = "WebCore|JavaScriptCore|heap/WeakInlines.h"
    fixed[1] = "WebCore|JavaScriptCore|runtime/VM.h"
    objectIncludes(&fixed, 2, "Builtins.h", true)
    section(s.join3("namespace ", ns, " {"))
    sectionStart()
    s.out("class JSDOMGlobalObject;\n\nclass JSBuiltinInternalFunctions {\npublic:\n    explicit JSBuiltinInternalFunctions(JSC::VM&);\n\n    template<typename Visitor> void visit(Visitor&);\n    void initialize(JSDOMGlobalObject&);\n")
    var object: usize = 0
    while object < model.objectCount {
        if isInternal(object) {
            const name = model.objects[object].name
            guarded(annotation(object, "conditional"), s.join3(s.join3("    ", ucfirst(name), "BuiltinFunctions& "), lcfirst(name), s.join3("() { return m_", lcfirst(name), "; }")))
        }
        object += 1
    }
    s.out("\n\nprivate:\n    JSC::VM& m_vm;")
    object = 0
    while object < model.objectCount {
        if isInternal(object) {
            const name = model.objects[object].name
            guarded(annotation(object, "conditional"), s.join3(s.join3("    ", ucfirst(name), "BuiltinFunctions m_"), lcfirst(name), ";"))
        }
        object += 1
    }
    s.out("\n};")
    section(s.join3("} // namespace ", ns, ""))
}

fn internalsImplementation() -> void {
    const ns = namespaceName()
    sectionCount = 0
    license()
    section(DO_NOT_EDIT_WARNING)
    section(s.join3("#include \"config.h\"\n#include \"", ns, "JSBuiltinInternals.h\""))
    var entries: [3][]const u8 = undefined
    entries[0] = "WebCore|WebCore|JSDOMGlobalObject.h"
    entries[1] = "WebCore|WebCore|WebCoreJSClientData.h"
    entries[2] = "WebCore|JavaScriptCore|runtime/JSObjectInlines.h"
    includes(&entries, 3)
    section(s.join3("namespace ", ns, " {"))
    sectionStart()
    s.out("JSBuiltinInternalFunctions::JSBuiltinInternalFunctions(JSC::VM& vm)\n    : m_vm(vm)")
    var object: usize = 0
    while object < model.objectCount {
        if isInternal(object) { guarded(annotation(object, "conditional"), s.join3("    , m_", lcfirst(model.objects[object].name), "(m_vm)")) }
        object += 1
    }
    s.out("\n{\n    UNUSED_PARAM(vm);\n}\n\ntemplate<typename Visitor>\nvoid JSBuiltinInternalFunctions::visit(Visitor& visitor)\n{")
    object = 0
    while object < model.objectCount {
        if isInternal(object) { guarded(annotation(object, "conditional"), s.join3("    m_", lcfirst(model.objects[object].name), ".visit(visitor);")) }
        object += 1
    }
    s.out("\n    UNUSED_PARAM(visitor);\n}\n\ntemplate void JSBuiltinInternalFunctions::visit(AbstractSlotVisitor&);\ntemplate void JSBuiltinInternalFunctions::visit(SlotVisitor&);\n\nSUPPRESS_ASAN void JSBuiltinInternalFunctions::initialize(JSDOMGlobalObject& globalObject)\n{\n    UNUSED_PARAM(globalObject);")
    object = 0
    while object < model.objectCount {
        if isInternal(object) { guarded(annotation(object, "conditional"), s.join3("    m_", lcfirst(model.objects[object].name), ".init(globalObject);")) }
        object += 1
    }
    s.out("\n\n    JSVMClientData& clientData = *downcast<JSVMClientData>(m_vm.clientData);\n    JSDOMGlobalObject::GlobalPropertyInfo staticGlobals[] = {")
    object = 0
    while object < model.objectCount {
        if isInternal(object) {
            const name = model.objects[object].name
            const accessor = lcfirst(name)
            const text = s.join3(s.join3("#define DECLARE_GLOBAL_STATIC(name) \\\n    JSDOMGlobalObject::GlobalPropertyInfo( \\\n        clientData.builtinFunctions().", accessor, "Builtins().name##PrivateName(), "),
                accessor, s.join3("().m_##name##Function.get() , JSC::PropertyAttribute::DontDelete | JSC::PropertyAttribute::ReadOnly),\n    WEBCORE_FOREACH_", capitals(name, 0), "_BUILTIN_FUNCTION_NAME(DECLARE_GLOBAL_STATIC)\n#undef DECLARE_GLOBAL_STATIC"))
            guarded(annotation(object, "conditional"), text)
        }
        object += 1
    }
    s.out("\n    };\n    globalObject.addStaticGlobals(staticGlobals);\n    UNUSED_PARAM(clientData);\n}")
    section(s.join3("} // namespace ", ns, ""))
}

// ---------------------------------------------------------------------------
// The run.

const MAX_INPUTS: usize = 4096

fn usage() -> void {
    s.say("usage: webkit-builtins --framework JavaScriptCore|WebCore --output-directory DIR [--combined] [--force] Builtin1.js [Builtin2.js ...]\n")
    const ignored = std.linux.syscall1(231, 2)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var inputs: [*][]const u8 = undefined
    unsafe { inputs = @ptrFromInt([*][]const u8, s.alloc(MAX_INPUTS * 16)) }
    var inputCount: usize = 0
    var framework: []const u8 = ""
    var outputDirectory: []const u8 = ""
    var hasOutputDirectory = false
    var combined = false
    var wrappersOnly = false
    var index: usize = 1
    while index < arguments.length {
        const argument = std.text.cString(arguments[index])
        index += 1
        // The options taking a value, as --name VALUE or --name=VALUE.
        var name = argument
        var value: []const u8 = ""
        var hasValue = false
        if std.text.startsWith(argument, "--") && std.text.contains(argument, "=") {
            const equals = std.text.find(argument, "=")
            name = argument[0..equals]
            value = argument[equals + 1..argument.length]
            hasValue = true
        }
        const takesValue = std.text.same(name, "--framework") || std.text.same(name, "--output-directory") || std.text.same(name, "-o") || std.text.same(name, "--input-directory") || std.text.same(name, "-i")
        if takesValue && !hasValue {
            if index >= arguments.length { usage() }
            value = std.text.cString(arguments[index])
            index += 1
        }
        if std.text.same(name, "--framework") {
            framework = value
        } else if std.text.same(name, "--output-directory") || std.text.same(name, "-o") {
            outputDirectory = value
            hasOutputDirectory = true
        } else if std.text.same(name, "--input-directory") || std.text.same(name, "-i") {
            s.fail("webkit-builtins: --input-directory is not supported; name the files")
        } else if std.text.same(name, "--combined") {
            combined = true
        } else if std.text.same(name, "--wrappers-only") {
            wrappersOnly = true
        } else if std.text.same(name, "--force") {
            force = true
        } else if std.text.same(name, "--debug") || std.text.same(name, "-v") {
            // The log is not kept.
        } else if std.text.same(name, "--test") || std.text.same(name, "-t") {
            s.fail("webkit-builtins: --test is not supported")
        } else if std.text.startsWith(argument, "-") && argument.length > 1 {
            usage()
        } else {
            if inputCount == MAX_INPUTS { s.fail("webkit-builtins: too many inputs") }
            inputs[inputCount] = argument
            inputCount += 1
        }
    }
    if inputCount == 0 { model.fail("At least one input file or directory expected.") }
    if !hasOutputDirectory { model.fail("Missing output directory.") }
    if framework.length == 0 { usage() }

    // The *.js of the inputs, sorted.
    var count: usize = 0
    index = 0
    while index < inputCount {
        if std.text.endsWith(inputs[index], ".js") {
            inputs[count] = inputs[index]
            count += 1
        }
        index += 1
    }
    model.sortTexts(inputs, count)

    model.begin(framework, std.process.environmentEntries(arguments))
    index = 0
    while index < count {
        model.parseFile(inputs[index])
        index += 1
    }

    if combined {
        combinedHeader()
        const middle = s.output().length
        writeFile(outputDirectory, s.join(namespaceName(), "Builtins.h"), 0)
        combinedImplementation()
        writeFile(outputDirectory, s.join(namespaceName(), "Builtins.cpp"), middle)
    } else if wrappersOnly {
        const ns = namespaceName()
        var from = s.output().length
        wrapperHeader()
        writeFile(outputDirectory, s.join(ns, "JSBuiltins.h"), from)
        from = s.output().length
        wrapperImplementation()
        writeFile(outputDirectory, s.join(ns, "JSBuiltins.cpp"), from)
        from = s.output().length
        internalsHeader()
        writeFile(outputDirectory, s.join(ns, "JSBuiltinInternals.h"), from)
        from = s.output().length
        internalsImplementation()
        writeFile(outputDirectory, s.join(ns, "JSBuiltinInternals.cpp"), from)
    } else {
        var object: usize = 0
        while object < model.objectCount {
            var from = s.output().length
            separateHeader(object)
            writeFile(outputDirectory, s.join(mangledObjectName(object), "Builtins.h"), from)
            from = s.output().length
            separateImplementation(object)
            writeFile(outputDirectory, s.join(mangledObjectName(object), "Builtins.cpp"), from)
            object += 1
        }
    }
    return 0
}
