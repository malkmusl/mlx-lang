// The model of WebCore's make_names.pl in Mlx: the elements and
// attributes read from the .in files (HTMLTagNames.in, svgattrs.in ...),
// each with the properties the Perl gives it, the parameters of each file,
// the orders the Perl sorts them in, and the code it makes to find a name
// among them (a switch on the length, then on the characters).
const std = @import("std")
const s = @import("./support.mlx")
const n = @import("./namestext.mlx")

pub const Element = struct {
    // "NAMESPACE:LOCALNAME", the Perl's hash key.
    key: []const u8
    cppNamespace: []const u8
    namespace: []const u8
    localName: []const u8
    identifier: []const u8
    tagEnumValue: []const u8
    nodeNameEnumValue: []const u8
    unadjustedTagEnumValue: []const u8
    parsedTagName: []const u8
    parsedTagEnumValue: []const u8
    constructorNeedsCreatedByParser: []const u8
    noConstructor: []const u8
    interfaceName: []const u8
    JSInterfaceName: []const u8
    wrapperOnlyIfMediaIsAvailable: []const u8
    settingsConditional: []const u8
    conditional: []const u8
    deprecatedGlobalSettingsConditional: []const u8
    customTypeHelper: []const u8
    // How many namespaces have an element of this local name.
    count: usize
}

pub const Attribute = struct {
    key: []const u8
    cppNamespace: []const u8
    namespace: []const u8
    localName: []const u8
    identifier: []const u8
    tagEnumValue: []const u8
    nodeNameEnumValue: []const u8
    // How many namespaces have an attribute of this local name.
    count: usize
}

pub const Parameter = struct {
    name: []const u8
    value: []const u8
}

// A C++ namespace read, with the namespacePrefix of its file.
pub const CppNamespace = struct {
    name: []const u8
    prefix: []const u8
}

const MAX_ELEMENTS: usize = 4096
const MAX_ATTRIBUTES: usize = 8192
const MAX_PARAMETERS: usize = 256
const MAX_NAMESPACES: usize = 64

pub var elements: [*]Element = undefined
pub var elementCount: usize = 0
pub var attributes: [*]Attribute = undefined
pub var attributeCount: usize = 0
pub var parameters: [*]Parameter = undefined
pub var parameterCount: usize = 0
pub var cppNamespaces: [*]CppNamespace = undefined
pub var cppNamespaceCount: usize = 0
// Whether parameters are the known ones, with their defaults (not so for
// the font family names, which are all parameters).
pub var initDefaults: bool = true

pub fn initialize() -> void {
    unsafe {
        elements = @ptrFromInt([*]Element, s.alloc(MAX_ELEMENTS * @sizeOf(Element)))
        attributes = @ptrFromInt([*]Attribute, s.alloc(MAX_ATTRIBUTES * @sizeOf(Attribute)))
        parameters = @ptrFromInt([*]Parameter, s.alloc(MAX_PARAMETERS * @sizeOf(Parameter)))
        cppNamespaces = @ptrFromInt([*]CppNamespace, s.alloc(MAX_NAMESPACES * @sizeOf(CppNamespace)))
    }
}

// ---------------------------------------------------------------------------
// Parameters.

// The parameter NAME ("" when not there).
pub fn parameter(name: []const u8) -> []const u8 {
    var index: usize = 0
    while index < parameterCount {
        if std.text.same(parameters[index].name, name) { return parameters[index].value }
        index += 1
    }
    return ""
}

pub fn hasParameter(name: []const u8) -> bool {
    var index: usize = 0
    while index < parameterCount {
        if std.text.same(parameters[index].name, name) { return true }
        index += 1
    }
    return false
}

pub fn setParameter(name: []const u8, value: []const u8) -> void {
    var index: usize = 0
    while index < parameterCount {
        if std.text.same(parameters[index].name, name) {
            parameters[index].value = value
            return
        }
        index += 1
    }
    if parameterCount == MAX_PARAMETERS { s.fail("make_names: too many parameters") }
    parameters[parameterCount] = Parameter.{ .name = name, .value = value }
    parameterCount += 1
}

pub fn clearParameters() -> void { parameterCount = 0 }

pub fn namespace() -> []const u8 { return parameter("namespace") }

fn parameterHandler(name: []const u8, value: []const u8) -> void {
    if parameterCount == 0 && initDefaults {
        setParameter("namespace", "")
        setParameter("namespacePrefix", "")
        setParameter("namespaceURI", "")
        setParameter("guardFactoryWith", "")
        setParameter("elementsNullNamespace", "0")
        setParameter("attrsNullNamespace", "0")
        setParameter("fallbackInterfaceName", "")
        setParameter("fallbackJSInterfaceName", "")
        setParameter("customElementInterfaceName", "")
    }
    if initDefaults && !hasParameter(name) { s.fail(s.join3("Unknown parameter ", name, " for tags/attrs")) }
    setParameter(name, value)
}

// ---------------------------------------------------------------------------
// Names.

// TEXT with every FROM byte made TO.
fn replaced(text: []const u8, from: u8, to: u8) -> []const u8 { return s.replaceByte(text, from, to) }

// C++ keywords that conflict with element names, and "small", a macro of
// Windows headers, take a "_".
fn avoidConflictingName(name: []const u8) -> []const u8 {
    if std.text.same(name, "small") || std.text.same(name, "switch") || std.text.same(name, "template") { return s.join(name, "_") }
    return name
}

// NAME in camel case: "_x" made "X", the first letter capital (and for
// SVG, "feX" made "FEX").
fn upperCaseName(name: []const u8) -> []const u8 {
    var text = name
    if std.text.same(namespace(), "SVG") && text.length > 2 && text[0] == 102 && text[1] == 101 {
        text = s.join("FE", s.capitalized(text[2..text.length]))
    }
    while true {
        const at = std.text.find(text, "_")
        if at == text.length { break }
        text = s.join(text[0..at], s.capitalized(text[at + 1..text.length]))
    }
    return s.capitalized(text)
}

fn defaultInterfaceName(identifier: []const u8) -> []const u8 {
    if !n.truthy(namespace()) { s.fail("No namespace found") }
    return s.join3(namespace(), upperCaseName(identifier), "Element")
}

pub fn findElement(key: []const u8) -> i64 {
    var index: usize = 0
    while index < elementCount {
        if std.text.same(elements[index].key, key) { return @intCast(i64, index) }
        index += 1
    }
    return -1
}

pub fn findAttribute(key: []const u8) -> i64 {
    var index: usize = 0
    while index < attributeCount {
        if std.text.same(attributes[index].key, key) { return @intCast(i64, index) }
        index += 1
    }
    return -1
}

fn newElement(key: []const u8, localName: []const u8) -> void {
    if elementCount == MAX_ELEMENTS { s.fail("make_names: too many elements") }
    const ns = namespace()
    const identifier = replaced(localName, 45, 95)
    const adjusted = !std.text.same(localName, n.lower(localName))
    const tagEnumValue = avoidConflictingName(identifier)
    const unadjusted = if adjusted { s.join(n.lower(identifier), "CaseUnadjusted") } else { "" }
    const interfaceName = defaultInterfaceName(identifier)
    elements[elementCount] = Element.{
        .key = key,
        .cppNamespace = ns,
        .namespace = ns,
        .localName = localName,
        .identifier = identifier,
        .tagEnumValue = tagEnumValue,
        .nodeNameEnumValue = s.join3(ns, "_", identifier),
        .unadjustedTagEnumValue = unadjusted,
        .parsedTagName = n.lower(localName),
        .parsedTagEnumValue = if adjusted { unadjusted } else { tagEnumValue },
        .constructorNeedsCreatedByParser = "0",
        .noConstructor = "0",
        .interfaceName = interfaceName,
        .JSInterfaceName = interfaceName,
        .wrapperOnlyIfMediaIsAvailable = "0",
        .settingsConditional = "0",
        .conditional = "0",
        .deprecatedGlobalSettingsConditional = "0",
        .customTypeHelper = "0",
        .count = 0,
    }
    elementCount += 1
}

fn elementHandler(name: []const u8, property: []const u8, value: []const u8) -> void {
    const key = s.join3(namespace(), ":", name)
    var found = findElement(key)
    if found < 0 {
        newElement(key, name)
        found = @intCast(i64, elementCount - 1)
    }
    if !n.truthy(property) { return }
    const e = &elements[@intCast(usize, found)]
    if std.text.same(property, "interfaceName") {
        // JSInterfaceName follows interfaceName unless it was set apart.
        if std.text.same(e.*.JSInterfaceName, e.*.interfaceName) { e.*.JSInterfaceName = value }
        e.*.interfaceName = value
    } else if std.text.same(property, "JSInterfaceName") {
        e.*.JSInterfaceName = value
    } else if std.text.same(property, "constructorNeedsCreatedByParser") {
        e.*.constructorNeedsCreatedByParser = value
    } else if std.text.same(property, "noConstructor") {
        e.*.noConstructor = value
    } else if std.text.same(property, "wrapperOnlyIfMediaIsAvailable") {
        e.*.wrapperOnlyIfMediaIsAvailable = value
    } else if std.text.same(property, "settingsConditional") {
        e.*.settingsConditional = value
    } else if std.text.same(property, "conditional") {
        e.*.conditional = value
    } else if std.text.same(property, "deprecatedGlobalSettingsConditional") {
        e.*.deprecatedGlobalSettingsConditional = value
    } else if std.text.same(property, "customTypeHelper") {
        e.*.customTypeHelper = value
    } else if std.text.same(property, "cppNamespace") {
        e.*.cppNamespace = value
    } else if std.text.same(property, "namespace") {
        e.*.namespace = value
    } else if std.text.same(property, "localName") {
        e.*.localName = value
    } else if std.text.same(property, "identifier") {
        e.*.identifier = value
    } else if std.text.same(property, "tagEnumValue") {
        e.*.tagEnumValue = value
    } else if std.text.same(property, "nodeNameEnumValue") {
        e.*.nodeNameEnumValue = value
    } else if std.text.same(property, "unadjustedTagEnumValue") {
        e.*.unadjustedTagEnumValue = value
    } else if std.text.same(property, "parsedTagName") {
        e.*.parsedTagName = value
    } else if std.text.same(property, "parsedTagEnumValue") {
        e.*.parsedTagEnumValue = value
    } else {
        s.fail(s.join3(s.join3("Unknown property ", property, " for element "), name, ""))
    }
}

fn attributeHandler(name: []const u8, property: []const u8, value: []const u8) -> void {
    const ns = namespace()
    const key = s.join3(ns, ":", name)
    var found = findAttribute(key)
    if found < 0 {
        if attributeCount == MAX_ATTRIBUTES { s.fail("make_names: too many attributes") }
        const webkit = if std.text.startsWith(name, "x-webkit-") { s.join("webkit", name[9..name.length]) } else { name }
        const identifier = replaced(webkit, 45, 95)
        const attributeNamespace = if n.truthy(parameter("attrsNullNamespace")) { "" } else { ns }
        const prefix = if attributeNamespace.length == 0 { "" } else { s.join(attributeNamespace, "_") }
        attributes[attributeCount] = Attribute.{
            .key = key,
            .cppNamespace = ns,
            .namespace = attributeNamespace,
            .localName = name,
            .identifier = identifier,
            .tagEnumValue = s.join(identifier, "Attr"),
            .nodeNameEnumValue = s.join3(prefix, identifier, "Attr"),
            .count = 0,
        }
        attributeCount += 1
        found = @intCast(i64, attributeCount - 1)
    }
    if !n.truthy(property) { return }
    const a = &attributes[@intCast(usize, found)]
    if std.text.same(property, "cppNamespace") {
        a.*.cppNamespace = value
    } else if std.text.same(property, "namespace") {
        a.*.namespace = value
    } else if std.text.same(property, "localName") {
        a.*.localName = value
    } else if std.text.same(property, "identifier") {
        a.*.identifier = value
    } else if std.text.same(property, "tagEnumValue") {
        a.*.tagEnumValue = value
    } else if std.text.same(property, "nodeNameEnumValue") {
        a.*.nodeNameEnumValue = value
    } else {
        s.fail(s.join3(s.join3("Unknown property ", property, " for attribute "), name, ""))
    }
}

fn noItem(name: []const u8, property: []const u8, value: []const u8) -> void {
    s.fail(s.join("make_names: an item where only parameters may be: ", name))
}

// The parameters of the font family names file (any names, no defaults).
pub fn readParameters(path: []const u8) -> void {
    initDefaults = false
    n.parseIn(s.readWhole(path), n.InHandler.{ .parameter = parameterHandler, .item = noItem })
}

fn readNames(path: []const u8, isElements: bool) -> void {
    const handler = if isElements {
        n.InHandler.{ .parameter = parameterHandler, .item = elementHandler }
    } else {
        n.InHandler.{ .parameter = parameterHandler, .item = attributeHandler }
    }
    n.parseIn(s.readWhole(path), handler)
    if !n.truthy(namespace()) { s.fail("You must specify a namespace (e.g. SVG) for <namespace>Names.h") }
    if !n.truthy(parameter("namespaceURI")) { s.fail("You must specify a namespaceURI (e.g. http://www.w3.org/2000/svg)") }
    if !n.truthy(parameter("namespacePrefix")) { setParameter("namespacePrefix", namespace()) }
    const total = if isElements { elementCount } else { attributeCount }
    if total == 0 { s.fail(s.join("Failed to read names from file: ", path)) }
    // The C++ namespace, with the parameters as they are now.
    var index: usize = 0
    while index < cppNamespaceCount && !std.text.same(cppNamespaces[index].name, namespace()) { index += 1 }
    if index == cppNamespaceCount {
        if cppNamespaceCount == MAX_NAMESPACES { s.fail("make_names: too many namespaces") }
        cppNamespaceCount += 1
    }
    cppNamespaces[index] = CppNamespace.{ .name = namespace(), .prefix = parameter("namespacePrefix") }
}

pub fn readElements(path: []const u8) -> void { readNames(path, true) }
pub fn readAttributes(path: []const u8) -> void { readNames(path, false) }

// The counts of namespaces by local name (the Perl's
// allNamespacesPerElementLocalName and ...AttributeLocalName).
pub fn collect() -> void {
    var index: usize = 0
    while index < elementCount {
        elements[index].count = elementNamespaces(elements[index].localName).count
        index += 1
    }
    index = 0
    while index < attributeCount {
        var namespaces = n.list()
        var other: usize = 0
        while other < attributeCount {
            if std.text.same(attributes[other].localName, attributes[index].localName) { n.add(&namespaces, attributes[other].namespace) }
            other += 1
        }
        attributes[index].count = namespaces.count
        index += 1
    }
}

// The namespaces of the elements named LOCALNAME, sorted.
pub fn elementNamespaces(localName: []const u8) -> n.List {
    var namespaces = n.list()
    var other: usize = 0
    while other < elementCount {
        if std.text.same(elements[other].localName, localName) { n.add(&namespaces, elements[other].namespace) }
        other += 1
    }
    n.sortList(&namespaces)
    return namespaces
}

// ---------------------------------------------------------------------------
// Orders.

fn byCount(first: usize, second: usize) -> i32 {
    if first == second { return 0 }
    return if first < second { -1 } else { 1 }
}

pub fn elementsByKey(first: usize, second: usize) -> i32 { return n.compare(elements[first].key, elements[second].key) }
pub fn attributesByKey(first: usize, second: usize) -> i32 { return n.compare(attributes[first].key, attributes[second].key) }

// The Perl's byElementNameOrder.
pub fn elementsByName(first: usize, second: usize) -> i32 {
    const counted = byCount(elements[first].count, elements[second].count)
    if counted != 0 { return counted }
    return n.compare(elements[first].nodeNameEnumValue, elements[second].nodeNameEnumValue)
}

// The Perl's byAttrNameOrder.
pub fn attributesByName(first: usize, second: usize) -> i32 {
    const counted = byCount(attributes[first].count, attributes[second].count)
    if counted != 0 { return counted }
    const named = n.compare(attributes[first].nodeNameEnumValue, attributes[second].nodeNameEnumValue)
    if named != 0 { return named }
    return n.compare(attributes[first].cppNamespace, attributes[second].cppNamespace)
}

pub fn sortedElements(order: fn(usize, usize) -> i32) -> [*]usize {
    const items = n.indexes(elementCount)
    n.sortBy(items, elementCount, order)
    return items
}

pub fn sortedAttributes(order: fn(usize, usize) -> i32) -> [*]usize {
    const items = n.indexes(attributeCount)
    n.sortBy(items, attributeCount, order)
    return items
}

// The C++ namespaces' names, sorted.
pub fn sortedCppNamespaces() -> n.List {
    var names = n.list()
    var index: usize = 0
    while index < cppNamespaceCount {
        n.push(&names, cppNamespaces[index].name)
        index += 1
    }
    n.sortList(&names)
    return names
}

pub fn cppNamespacePrefix(name: []const u8) -> []const u8 {
    var index: usize = 0
    while index < cppNamespaceCount {
        if std.text.same(cppNamespaces[index].name, name) { return cppNamespaces[index].prefix }
        index += 1
    }
    return ""
}

// ---------------------------------------------------------------------------
// The code finding a name: a switch on the length of the buffer, then on
// its characters, a comparison of several where all the candidates left
// share them.

pub const Candidate = struct {
    string: []const u8
    enumValue: []const u8
}

var candidates: [*]Candidate = undefined
var candidateCount: usize = 0

fn byString(first: usize, second: usize) -> i32 { return n.compare(candidates[first].string, candidates[second].string) }

fn letterAt(text: []const u8, at: usize) -> []const u8 { return text[at..at + 1] }

fn printPrefixCheck(indent: []const u8, startIndex: usize, string: []const u8, prefixLength: usize) -> void {
    const bufferStart = if startIndex > 0 { s.join3("buffer.subspan(", s.decimal(@intCast(u64, startIndex)), ").data()") } else { "buffer.data()" }
    if prefixLength == 1 {
        n.o3(indent, "if (buffer[", s.decimal(@intCast(u64, startIndex)))
        n.o3("] == '", letterAt(string, startIndex), "') {\n")
    } else if prefixLength <= 8 {
        n.o3(indent, "if (compareCharacters(", bufferStart)
        var index = startIndex
        while index < startIndex + prefixLength {
            n.o3(", '", letterAt(string, index), "'")
            index += 1
        }
        n.o(")) {\n")
    } else {
        n.o3(indent, "if (WTF::equal(", bufferStart)
        n.o3(", \"", string[startIndex..startIndex + prefixLength], "\"_span8)) {\n")
    }
}

// The length of what the candidates ITEMS share from START (to LENGTH).
fn commonPrefixLength(items: [*]usize, count: usize, start: usize, length: usize) -> usize {
    const first = candidates[items[0]].string
    var commonEnd = length
    var index: usize = 0
    while index < count {
        const string = candidates[items[index]].string
        var at = start
        while at < commonEnd {
            if string[at] != first[at] {
                commonEnd = at
                break
            }
            at += 1
        }
        index += 1
    }
    return commonEnd - start
}

fn findForLength(indent: []const u8, items: [*]usize, count: usize, length: usize, currentIndex: usize, enumClass: []const u8) -> void {
    if count == 1 {
        const candidate = candidates[items[0]]
        if currentIndex < length {
            printPrefixCheck(indent, currentIndex, candidate.string, length - currentIndex)
            n.o5(indent, "    return ", enumClass, "::", candidate.enumValue)
            n.o3(";\n", indent, "}\n")
        } else {
            n.o5(indent, "return ", enumClass, "::", candidate.enumValue)
            n.o(";\n")
        }
        return
    }
    const common = commonPrefixLength(items, count, currentIndex, length)
    if common > 1 {
        printPrefixCheck(indent, currentIndex, candidates[items[0]].string, common)
        findForLength(s.join(indent, "    "), items, count, length, currentIndex + common, enumClass)
        n.o5(indent, "    return ", enumClass, "::Unknown;\n", indent)
        n.o("}\n")
        return
    }
    n.o3(indent, "switch (buffer[", s.decimal(@intCast(u64, currentIndex)))
    n.o("]) {\n")
    var i: usize = 0
    while i < count {
        const letter = candidates[items[i]].string[currentIndex]
        n.o3(indent, "case '", letterAt(candidates[items[i]].string, currentIndex))
        n.o("': {\n")
        const start = i
        i += 1
        while i < count && candidates[items[i]].string[currentIndex] == letter { i += 1 }
        const group = i - start
        findForLength(s.join(indent, "    "), items + start, group, length, currentIndex + 1, enumClass)
        if group > 1 {
            n.o5(indent, "    return ", enumClass, "::Unknown;\n", "")
        } else if currentIndex + 1 < length {
            n.o3(indent, "    break;\n", "")
        }
        n.o3(indent, "}\n", "")
    }
    n.o3(indent, "default:\n", indent)
    n.o3("    break;\n", indent, "}\n")
}

pub fn startCandidates(capacity: usize) -> void {
    unsafe { candidates = @ptrFromInt([*]Candidate, s.alloc((capacity + 1) * @sizeOf(Candidate))) }
    candidateCount = 0
}

// A candidate, unless one of its string came before.
pub fn addCandidate(string: []const u8, enumValue: []const u8) -> void {
    var index: usize = 0
    while index < candidateCount {
        if std.text.same(candidates[index].string, string) { return }
        index += 1
    }
    candidates[candidateCount] = Candidate.{ .string = string, .enumValue = enumValue }
    candidateCount += 1
}

// The body of a function finding the candidates in `buffer` (the Perl's
// generateFindBody).
pub fn findBody(enumClass: []const u8) -> void {
    var longest: usize = 0
    var index: usize = 0
    while index < candidateCount {
        if candidates[index].string.length > longest { longest = candidates[index].string.length }
        index += 1
    }
    const items = n.indexes(candidateCount)
    n.o("    switch (buffer.size()) {\n")
    var length: usize = 1
    while length <= longest {
        var count: usize = 0
        index = 0
        while index < candidateCount {
            if candidates[index].string.length == length {
                items[count] = index
                count += 1
            }
            index += 1
        }
        if count > 0 {
            n.sortBy(items, count, byString)
            n.o3("    case ", s.decimal(@intCast(u64, length)), ": {\n")
            findForLength("        ", items, count, length, 0, enumClass)
            n.o("        break;\n    }\n")
        }
        length += 1
    }
    n.o("    default:\n        break;\n    }\n")
    n.o3("    return ", enumClass, "::Unknown;\n")
}
