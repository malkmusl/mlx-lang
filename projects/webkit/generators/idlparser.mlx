// WebKit's IDL parser (bindings/scripts/IDLParser.pm, with the simple
// preprocessor of preprocessor.pm it reads files through): Web IDL
// definitions into the records of idlmodel.mlx, typedefs applied, the
// extended attributes checked against IDLAttributes.json.
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType

// ---------------------------------------------------------------------------
// IDLAttributes.json: for each extended attribute, the contexts it is
// allowed in and whether it supports conjunctions.

pub const AttributeInfo = struct {
    contexts: r.StrList
    supportsConjunction: bool
}

var attributeInfos: *r.Map = undefined
var attributeInfosLoaded: bool = false

// A small JSON reader: just what IDLAttributes.json needs.
const Json = struct {
    text: Str
    at: usize
}

fn jsonSpace(j: *Json) -> void {
    while j.*.at < j.*.text.length && r.isSpace(j.*.text[j.*.at]) { j.*.at += 1 }
}

fn jsonString(j: *Json) -> Str {
    jsonSpace(j)
    if j.*.at >= j.*.text.length || j.*.text[j.*.at] != 34 { r.die("IDLAttributes.json: a string was expected") }
    j.*.at += 1
    const start = j.*.at
    var plain = true
    while j.*.at < j.*.text.length && j.*.text[j.*.at] != 34 {
        if j.*.text[j.*.at] == 92 {
            plain = false
            j.*.at += 1
        }
        j.*.at += 1
    }
    const raw = j.*.text[start..j.*.at]
    j.*.at += 1
    if plain { return raw }
    var b = r.buf()
    var index: usize = 0
    while index < raw.length {
        if raw[index] == 92 && index + 1 < raw.length {
            index += 1
            const c = raw[index]
            r.addByte(&b, if c == 110 { 10 } else if c == 116 { 9 } else { c })
        } else {
            r.addByte(&b, raw[index])
        }
        index += 1
    }
    return r.done(b)
}

fn jsonPeek(j: *Json) -> u8 {
    jsonSpace(j)
    if j.*.at >= j.*.text.length { return 0 }
    return j.*.text[j.*.at]
}

fn jsonExpect(j: *Json, byte: u8) -> void {
    if jsonPeek(j) != byte { r.die("IDLAttributes.json: unexpected text") }
    j.*.at += 1
}

// Skips one value.
fn jsonSkip(j: *Json) -> void {
    const c = jsonPeek(j)
    if c == 34 {
        const ignored = jsonString(j)
        return
    }
    if c == 123 || c == 91 {
        const close: u8 = if c == 123 { 125 } else { 93 }
        j.*.at += 1
        if jsonPeek(j) == close {
            j.*.at += 1
            return
        }
        while true {
            if c == 123 {
                const key = jsonString(j)
                jsonExpect(j, 58)
            }
            jsonSkip(j)
            if jsonPeek(j) == 44 {
                j.*.at += 1
                continue
            }
            jsonExpect(j, close)
            return
        }
    }
    while j.*.at < j.*.text.length {
        const d = j.*.text[j.*.at]
        if d == 44 || d == 125 || d == 93 || r.isSpace(d) { break }
        j.*.at += 1
    }
}

fn jsonWord(j: *Json) -> Str {
    jsonSpace(j)
    const start = j.*.at
    while j.*.at < j.*.text.length && r.isAlpha(j.*.text[j.*.at]) { j.*.at += 1 }
    return j.*.text[start..j.*.at]
}

fn readAttributeInfo(j: *Json) -> *AttributeInfo {
    const info: *AttributeInfo = unsafe { @ptrFromInt(*AttributeInfo, r.alloc(@sizeOf(AttributeInfo))) }
    info.* = AttributeInfo.{ .contexts = r.strList(), .supportsConjunction = false }
    jsonExpect(j, 123)
    if jsonPeek(j) == 125 {
        j.*.at += 1
        return info
    }
    while true {
        const key = jsonString(j)
        jsonExpect(j, 58)
        if r.same(key, "contextsAllowed") {
            jsonExpect(j, 91)
            if jsonPeek(j) != 93 {
                while true {
                    r.spush(&info.*.contexts, jsonString(j))
                    if jsonPeek(j) == 44 {
                        j.*.at += 1
                        continue
                    }
                    break
                }
            }
            jsonExpect(j, 93)
        } else if r.same(key, "supportsConjunction") {
            info.*.supportsConjunction = r.same(jsonWord(j), "true")
        } else {
            jsonSkip(j)
        }
        if jsonPeek(j) == 44 {
            j.*.at += 1
            continue
        }
        jsonExpect(j, 125)
        return info
    }
    return info
}

// Reads the "attributes" of the IDLAttributes.json at PATH.
pub fn loadAttributes(path: Str) -> void {
    attributeInfos = r.newMap()
    attributeInfosLoaded = true
    var j = Json.{ .text = r.readWhole(path), .at = 0 }
    jsonExpect(&j, 123)
    while true {
        const key = jsonString(&j)
        jsonExpect(&j, 58)
        if r.same(key, "attributes") {
            jsonExpect(&j, 123)
            if jsonPeek(&j) != 125 {
                while true {
                    const name = jsonString(&j)
                    jsonExpect(&j, 58)
                    r.set(attributeInfos, name, @intFromPtr(readAttributeInfo(&j)))
                    if jsonPeek(&j) == 44 {
                        j.at += 1
                        continue
                    }
                    break
                }
            }
            jsonExpect(&j, 125)
        } else {
            jsonSkip(&j)
        }
        if jsonPeek(&j) == 44 {
            j.at += 1
            continue
        }
        break
    }
}

// The entry of NAME, or null for an attribute IDLAttributes.json does not know.
pub fn attributeInfo(name: Str) -> ?*AttributeInfo {
    const address = r.get(attributeInfos, name)
    if address == 0 { return null }
    return unsafe { @ptrFromInt(*AttributeInfo, address) }
}

pub fn attributeAllowedIn(name: Str, context: Str) -> bool {
    const info = attributeInfo(name)
    if info == null { return false }
    return r.shas(info.?.*.contexts, context)
}

// ---------------------------------------------------------------------------
// The preprocessor: comments stripped, #if/#else/#endif evaluated.

// Whether the line LINE is a directive "#WORD..." (white space allowed
// around the #); AFTER is where the rest starts.
fn directive(line: Str, word: Str, after: *usize) -> bool {
    var at: usize = 0
    while at < line.length && r.isSpace(line[at]) { at += 1 }
    if at >= line.length || line[at] != 35 { return false }
    at += 1
    while at < line.length && r.isSpace(line[at]) { at += 1 }
    if !r.startsWith(line[at..line.length], word) { return false }
    at += word.length
    after.* = at
    return true
}

fn macroDefined(macros: *r.Map, name: Str) -> bool { return r.has(macros, name) }

fn isWordText(text: Str) -> bool {
    if text.length == 0 { return false }
    for byte in text {
        if !r.isWord(byte) { return false }
    }
    return true
}

// The text of EXPR without the white space at its ends, and with the
// outer "(" ... ")" or "!(" ... ")" taken off: preprocessor.pm's
// _evaluateCondition.
fn evaluateCondition(expression: Str, macros: *r.Map) -> bool {
    const trimmed = r.trim(expression)
    // ^\s*!\s*\((.+)\)\s*$ and ^\s*\((.+)\)\s*$: the greedy .+ runs to the last ")".
    if trimmed.length > 0 && trimmed[0] == 33 {
        var at: usize = 1
        while at < trimmed.length && r.isSpace(trimmed[at]) { at += 1 }
        if at < trimmed.length && trimmed[at] == 40 && trimmed[trimmed.length - 1] == 41 && trimmed.length - 1 > at + 1 {
            return !evaluateCondition(trimmed[at + 1..trimmed.length - 1], macros)
        }
    }
    if trimmed.length > 2 && trimmed[0] == 40 && trimmed[trimmed.length - 1] == 41 {
        return evaluateCondition(trimmed[1..trimmed.length - 1], macros)
    }
    // Conjunctions.
    var start: usize = 0
    var index: usize = 0
    while index <= expression.length {
        if index == expression.length || (index + 1 < expression.length && expression[index] == 38 && expression[index + 1] == 38) {
            const part = r.trim(expression[start..index])
            // ^\(?defined\((\w+)\)\)?$
            var p = part
            var name: Str = ""
            var recognized = false
            if p.length > 0 && p[0] == 40 { p = p[1..p.length] }
            if r.startsWith(p, "defined(") {
                var close = 8
                while close < p.length && r.isWord(p[close]) { close += 1 }
                if close > 8 && close < p.length && p[close] == 41 {
                    const rest = p[close + 1..p.length]
                    if rest.length == 0 || (rest.length == 1 && rest[0] == 41) {
                        name = p[8..close]
                        recognized = true
                    }
                }
            }
            if !recognized && isWordText(part) {
                name = part
                recognized = true
            }
            if recognized && !macroDefined(macros, name) { return false }
            if index == expression.length { break }
            start = index + 2
            index += 2
            continue
        }
        index += 1
    }
    return true
}

// Where the block comment starting at START ends (after its "*/"), or 0.
fn commentEnd(text: Str, start: usize) -> usize {
    var at = start + 2
    while at + 1 < text.length {
        if text[at] == 42 && text[at + 1] == 47 { return at + 2 }
        at += 1
    }
    return 0
}

// The file at FILENAME as preprocessor.pm's applyPreprocessor makes it
// (comments stripped, // comments too), its lines joined with a space as
// IDLParser joins them.
pub fn preprocess(fileName: Str, macros: *r.Map) -> Str {
    const raw = r.readWhole(fileName)
    // s|/\*.*?\*/||gs
    var b = r.buf()
    var at: usize = 0
    var start: usize = 0
    while at + 1 < raw.length {
        if raw[at] == 47 && raw[at + 1] == 42 {
            const end = commentEnd(raw, at)
            if end > 0 {
                r.add(&b, raw[start..at])
                at = end
                start = end
                continue
            }
        }
        at += 1
    }
    r.add(&b, raw[start..raw.length])
    const noBlocks = r.done(b)
    // s|//[^\n]*||g
    var c = r.buf()
    at = 0
    start = 0
    while at < noBlocks.length {
        if at + 1 < noBlocks.length && noBlocks[at] == 47 && noBlocks[at + 1] == 47 {
            r.add(&c, noBlocks[start..at])
            while at < noBlocks.length && noBlocks[at] != 10 { at += 1 }
            start = at
            continue
        }
        at += 1
    }
    r.add(&c, noBlocks[start..noBlocks.length])
    const content = r.done(c)

    // The lines (each with its newline), evaluated when the file has directives.
    var hasDirective = false
    at = 0
    var lineStart = true
    while at < content.length {
        const byte = content[at]
        if lineStart && byte == 35 {
            hasDirective = true
            break
        }
        if byte == 10 {
            lineStart = true
        } else if !r.isSpace(byte) {
            lineStart = false
        }
        at += 1
    }
    var text = content
    if hasDirective {
        var out = r.buf()
        var emittingStack = r.list()
        var conditionStack = r.list()
        var emitting = true
        at = 0
        while at < content.length {
            var end = at
            while end < content.length && content[end] != 10 { end += 1 }
            if end < content.length { end += 1 }
            const line = content[at..end]
            var rest: usize = 0
            if directive(line, "if", &rest) && rest < line.length && r.isSpace(line[rest]) {
                var conditionStart = rest
                while conditionStart < line.length && r.isSpace(line[conditionStart]) && line[conditionStart] != 10 { conditionStart += 1 }
                // \s+ may take the newline too, (.*) then nothing.
                var conditionEnd = conditionStart
                while conditionEnd < line.length && line[conditionEnd] != 10 { conditionEnd += 1 }
                const condition = evaluateCondition(line[conditionStart..conditionEnd], macros)
                r.push(&emittingStack, if emitting { 1 } else { 0 })
                r.push(&conditionStack, if condition { 1 } else { 0 })
                emitting = emitting && condition
            } else if directive(line, "else", &rest) && (rest >= line.length || !r.isWord(line[rest])) {
                const top = emittingStack.count - 1
                emitting = emittingStack.items[top] == 1 && conditionStack.items[top] == 0
            } else if directive(line, "endif", &rest) && (rest >= line.length || !r.isWord(line[rest])) {
                emittingStack.count -= 1
                emitting = emittingStack.items[emittingStack.count] == 1
                conditionStack.count -= 1
            } else if emitting {
                r.add(&out, line)
            }
            at = end
        }
        text = r.done(out)
    }
    // join(' ', split(/^/m, $text)): a space after each newline but a last one.
    var joined = r.buf()
    at = 0
    start = 0
    while at < text.length {
        if text[at] == 10 && at + 1 < text.length {
            r.add(&joined, text[start..at + 1])
            r.add(&joined, " ")
            start = at + 1
        }
        at += 1
    }
    r.add(&joined, text[start..text.length])
    return r.done(joined)
}

// The macros of a --defines value (quotes taken out, split at white space).
pub fn macrosOf(defines: Str) -> *r.Map {
    const macros = r.newMap()
    const words = r.splitWords(r.replaceAll(defines, "\"", ""))
    var index: usize = 0
    while index < words.count {
        r.set(macros, words.items[index], 1)
        index += 1
    }
    return macros
}

// ---------------------------------------------------------------------------
// Tokens.

const StringToken: u8 = 0
const IntegerToken: u8 = 1
const FloatToken: u8 = 2
const IdentifierToken: u8 = 3
const OtherToken: u8 = 4
const EmptyToken: u8 = 5

const Token = struct {
    kind: u8
    value: Str
}

pub const Parser = struct {
    content: Str
    at: usize
    token: Token
    next: Token
    fileName: Str
}

fn digitsAt(text: Str, at: usize) -> usize {
    var end = at
    while end < text.length && r.isDigit(text[end]) { end += 1 }
    return end - at
}

fn isHexDigit(byte: u8) -> bool { return r.isDigit(byte) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102) }

fn exponentAt(text: Str, at: usize) -> usize {
    if at >= text.length || (text[at] != 69 && text[at] != 101) { return 0 }
    var end = at + 1
    if end < text.length && (text[end] == 43 || text[end] == 45) { end += 1 }
    const digits = digitsAt(text, end)
    if digits == 0 { return 0 }
    return end + digits - at
}

// The length of the float token at AT, or 0.
fn floatAt(text: Str, at: usize) -> usize {
    var p = at
    if p < text.length && text[p] == 45 { p += 1 }
    // ([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([Ee][+-]?[0-9]+)?
    const lead = digitsAt(text, p)
    var q = p + lead
    var matched = false
    if lead > 0 && q < text.length && text[q] == 46 {
        q += 1
        q += digitsAt(text, q)
        matched = true
    } else if q < text.length && text[q] == 46 && digitsAt(text, q + 1) > 0 {
        q += 1
        q += digitsAt(text, q)
        matched = true
    }
    if matched {
        q += exponentAt(text, q)
        return q - at
    }
    // [0-9]+[Ee][+-]?[0-9]+
    if lead > 0 {
        const e = exponentAt(text, p + lead)
        if e > 0 { return p + lead + e - at }
    }
    return 0
}

fn integerAt(text: Str, at: usize) -> usize {
    var p = at
    if p < text.length && text[p] == 45 { p += 1 }
    if p >= text.length { return 0 }
    if text[p] >= 49 && text[p] <= 57 { return p + digitsAt(text, p) - at }
    if text[p] != 48 { return 0 }
    if p + 1 < text.length && (text[p + 1] == 88 || text[p + 1] == 120) {
        var q = p + 2
        while q < text.length && isHexDigit(text[q]) { q += 1 }
        if q > p + 2 { return q - at }
    }
    var q = p + 1
    while q < text.length && text[q] >= 48 && text[q] <= 55 { q += 1 }
    return q - at
}

fn isIdentifierByte(byte: u8) -> bool { return r.isWord(byte) || byte == 45 }

fn identifierAt(text: Str, at: usize) -> usize {
    var p = at
    if p < text.length && (text[p] == 95 || text[p] == 45) { p += 1 }
    if p >= text.length || !(r.isAlpha(text[p]) || text[p] == 95) {
        // [_-]? is optional: try without it.
        if p == at { return 0 }
        p = at
        if !(r.isAlpha(text[p]) || text[p] == 95) { return 0 }
    }
    p += 1
    while p < text.length && isIdentifierByte(text[p]) { p += 1 }
    return p - at
}

fn nextTokenInternal(p: *Parser) -> Token {
    const text = p.*.content
    var at = p.*.at
    while at < text.length && (text[at] == 9 || text[at] == 10 || text[at] == 13 || text[at] == 32) { at += 1 }
    p.*.at = at
    if at >= text.length { return Token.{ .kind = EmptyToken, .value = "empty" } }
    var length = floatAt(text, at)
    var kind = FloatToken
    if length == 0 {
        length = integerAt(text, at)
        kind = IntegerToken
    }
    if length == 0 && text[at] == 34 {
        var q = at + 1
        while q < text.length && text[q] != 34 { q += 1 }
        if q < text.length {
            length = q + 1 - at
            kind = StringToken
        }
    }
    if length == 0 {
        length = identifierAt(text, at)
        kind = IdentifierToken
    }
    if length == 0 {
        kind = OtherToken
        if at + 2 < text.length && text[at] == 46 && text[at + 1] == 46 && text[at + 2] == 46 {
            length = 3
        } else {
            const byte = text[at]
            if byte == 9 || byte == 10 || byte == 13 || byte == 32 || r.isWord(byte) { r.die(r.c2("Failed in tokenizing at ", p.*.fileName)) }
            length = 1
        }
    }
    p.*.at = at + length
    return Token.{ .kind = kind, .value = text[at..at + length] }
}

fn getToken(p: *Parser) -> Token {
    p.*.token = p.*.next
    p.*.next = nextTokenInternal(p)
    return p.*.token
}

fn peek(p: *Parser) -> Token { return p.*.next }

fn fail(p: *Parser, message: Str) -> void {
    r.die(r.cat([_]Str{ message, " in ", p.*.fileName }[0..]))
}

fn expect(p: *Parser, value: Str) -> void {
    const token = getToken(p)
    if !r.same(token.value, value) { fail(p, r.cat([_]Str{ "Next token should be ", value, ", but ", token.value }[0..])) }
}

fn unexpected(p: *Parser, token: Token) -> void { fail(p, r.c2("Unexpected token ", token.value)) }

fn oneOf(value: Str, words: []const Str) -> bool {
    for word in words {
        if r.same(value, word) { return true }
    }
    return false
}

const nextOptionallyReadonlyAttribute_1 = [_]Str{ "readonly", "attribute" }
const nextIntegerType_1 = [_]Str{ "int", "long", "short", "unsigned" }
const nextFloatType_1 = [_]Str{ "double", "float", "unrestricted" }
const nextArgumentList_1 = [_]Str{ "(", "ByteString", "DOMString", "USVString", "[", "any", "boolean", "byte", "double", "float", "in", "long", "object", "octet", "optional", "sequence", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextPrimitiveType_1 = [_]Str{ "boolean", "byte", "double", "float", "long", "octet", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextStringType_1 = [_]Str{ "ByteString", "DOMString", "USVString" }
const nextOperation_1 = [_]Str{ "(", "ByteString", "DOMString", "USVString", "any", "boolean", "byte", "deleter", "double", "float", "getter", "long", "object", "octet", "sequence", "setter", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextUnrestrictedFloatType_1 = [_]Str{ "double", "float" }
const nextExtendedAttributeRest3_1 = [_]Str{ ",", "]" }
const nextType_1 = [_]Str{ "ByteString", "DOMString", "USVString", "any", "boolean", "byte", "double", "float", "long", "object", "octet", "sequence", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextSpecials_1 = [_]Str{ "deleter", "getter", "setter" }
const nextDefinitions_1 = [_]Str{ "callback", "dictionary", "enum", "interface", "namespace", "partial", "typedef" }
const nextDictionaryMember_1 = [_]Str{ "(", "ByteString", "DOMString", "USVString", "any", "boolean", "byte", "double", "float", "long", "object", "octet", "required", "sequence", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextCallbackInterfaceMembers_1 = [_]Str{ "(", "const", "ByteString", "DOMString", "USVString", "any", "boolean", "byte", "double", "float", "long", "object", "octet", "sequence", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextInterfaceMembers_1 = [_]Str{ "(", "ByteString", "DOMString", "USVString", "any", "attribute", "boolean", "byte", "const", "constructor", "deleter", "double", "float", "getter", "inherit", "long", "object", "octet", "readonly", "sequence", "setter", "short", "static", "stringifier", "symbol", "undefined", "unrestricted", "unsigned" }
const nextMixinMembers_1 = [_]Str{ "(", "attribute", "ByteString", "DOMString", "USVString", "any", "boolean", "byte", "const", "double", "float", "long", "object", "octet", "readonly", "sequence", "short", "stringifier", "symbol", "undefined", "unrestricted", "unsigned" }
const nextNamespaceMembers_1 = [_]Str{ "(", "ByteString", "DOMString", "USVString", "any", "boolean", "byte", "const", "double", "float", "long", "object", "octet", "readonly", "sequence", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextPartialInterfaceMember_1 = [_]Str{ "(", "ByteString", "DOMString", "USVString", "any", "attribute", "boolean", "byte", "const", "deleter", "double", "float", "getter", "inherit", "long", "object", "octet", "readonly", "sequence", "setter", "short", "static", "stringifier", "symbol", "undefined", "unrestricted", "unsigned" }
const nextSingleType_1 = [_]Str{ "ByteString", "DOMString", "USVString", "boolean", "byte", "double", "float", "long", "object", "octet", "sequence", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextArgumentName_1 = [_]Str{ "async_iterable", "attribute", "callback", "const", "constructor", "deleter", "dictionary", "enum", "getter", "includes", "inherit", "interface", "iterable", "maplike", "mixin", "namespace", "partial", "readonly", "required", "setlike", "setter", "static", "stringifier", "typedef", "unrestricted" }
const nextConstValue_1 = [_]Str{ "false", "true" }
const nextConstValue_2 = [_]Str{ "-", "Infinity", "NaN" }
const nextCallbackOrInterface = [_]Str{ "callback", "interface" }
const nextRegularOperation_1 = [_]Str{ "(", "ByteString", "DOMString", "USVString", "any", "boolean", "byte", "double", "float", "long", "object", "octet", "sequence", "short", "symbol", "undefined", "unrestricted", "unsigned" }
const nextUnsignedIntegerType_1 = [_]Str{ "long", "short" }
const nextDefaultValue_1 = [_]Str{ "-", "Infinity", "NaN", "false", "null", "true" }
const argumentNameKeywords = [_]Str{ "async", "attribute", "callback", "const", "constructor", "deleter", "dictionary", "enum", "getter", "includes", "inherit", "interface", "iterable", "maplike", "mixin", "namespace", "partial", "readonly", "required", "setlike", "setter", "static", "stringifier", "typedef", "unrestricted" }

fn isIdentifier(t: Token) -> bool { return t.kind == IdentifierToken }

// ---------------------------------------------------------------------------
// Typedefs: kept for the whole run (a process), as the Perl keeps them.

var typedefs: *r.Map = undefined
var typedefsMade: bool = false

fn typedefsMap() -> *r.Map {
    if !typedefsMade {
        typedefs = r.newMap()
        typedefsMade = true
    }
    return typedefs
}

fn addBuiltinTypedefs() -> void {
    const map = typedefsMap()
    const bufferSource = m.newType("UNION")
    bufferSource.*.isUnion = true
    r.push(&bufferSource.*.subtypes, @intFromPtr(m.newType("ArrayBufferView")))
    r.push(&bufferSource.*.subtypes, @intFromPtr(m.newType("ArrayBuffer")))
    r.set(map, "BufferSource", @intFromPtr(bufferSource))
    r.set(map, "EpochTimeStamp", @intFromPtr(m.newType("unsigned long long")))
    r.set(map, "Base64URLString", @intFromPtr(m.newType("DOMString")))
}

// ---------------------------------------------------------------------------
// Extended attributes.

fn checkExtendedAttributes(p: *Parser, ext: *m.Ext, context: Str, secondContext: Str) -> void {
    var index: usize = 0
    while index < ext.*.names.count {
        const name = ext.*.names.items[index]
        const info = attributeInfo(name)
        if info == null { fail(p, r.c3("Unknown extended attribute: '", name, "'")) }
        if !r.shas(info.?.*.contexts, context) && !(secondContext.length > 0 && r.shas(info.?.*.contexts, secondContext)) {
            fail(p, r.c5("Extended attribute '", name, "' used in invalid context '", context, "'"))
        }
        index += 1
    }
}

fn isApplicableToTypes(p: *Parser, name: Str) -> bool {
    const info = attributeInfo(name)
    if info == null { fail(p, r.c3("Unknown extended attribute: '", name, "'")) }
    return r.shas(info.?.*.contexts, "type")
}

fn moveExtendedAttributesApplicableToTypes(p: *Parser, t: *IDLType, ext: *m.Ext) -> void {
    var names = r.scopy(ext.*.names)
    var index: usize = 0
    while index < names.count {
        const name = names.items[index]
        if isApplicableToTypes(p, name) {
            if !r.isDef(m.get(t.*.ext, name)) { m.setValue(t.*.ext, name, m.value(ext, name).?) }
            m.remove(ext, name)
        }
        index += 1
    }
}

fn parseExtendedAttributeListAllowEmpty(p: *Parser) -> *m.Ext {
    if r.same(peek(p).value, "[") { return parseExtendedAttributeList(p) }
    return m.newExt()
}

fn parseExtendedAttributeList(p: *Parser) -> *m.Ext {
    expect(p, "[")
    const list = m.newExt()
    const first = parseExtendedAttribute(p)
    m.copyInto(list, first)
    const rest = parseExtendedAttributes(p)
    m.copyInto(list, rest)
    expect(p, "]")
    return list
}

fn parseExtendedAttributes(p: *Parser) -> *m.Ext {
    const list = m.newExt()
    while r.same(peek(p).value, ",") {
        expect(p, ",")
        const attribute = parseExtendedAttribute2(p)
        m.copyInto(list, attribute)
    }
    return list
}

fn parseExtendedAttribute(p: *Parser) -> *m.Ext {
    const next = peek(p)
    if isIdentifier(next) {
        const name = parseName(p)
        return parseExtendedAttributeRest(p, name)
    }
    if r.same(next.value, "]") { return m.newExt() }
    unexpected(p, next)
    return m.newExt()
}

fn parseExtendedAttribute2(p: *Parser) -> *m.Ext {
    if isIdentifier(peek(p)) {
        const name = parseName(p)
        return parseExtendedAttributeRest(p, name)
    }
    return m.newExt()
}

fn parseExtendedAttributeRest(p: *Parser, name: Str) -> *m.Ext {
    const attrs = m.newExt()
    const next = peek(p)
    if r.same(next.value, "(") {
        expect(p, "(")
        const v = m.newValue(m.V_ARGS, "")
        v.*.items = parseArgumentList(p)
        m.setValue(attrs, name, v)
        expect(p, ")")
        return attrs
    }
    if r.same(next.value, "=") {
        expect(p, "=")
        m.setValue(attrs, name, parseExtendedAttributeRest2(p))
        return attrs
    }
    m.set(attrs, name, "VALUE_IS_MISSING")
    return attrs
}

fn parseExtendedAttributeRest2(p: *Parser) -> *m.Value {
    const next = peek(p)
    if r.same(next.value, "(") {
        expect(p, "(")
        const v = m.newValue(m.V_IDS, "")
        v.*.ids = parseIdentifierList(p)
        expect(p, ")")
        return v
    }
    if r.same(next.value, "[") {
        expect(p, "[")
        expect(p, "]")
        return m.newValue(m.V_STR, "[]")
    }
    if r.same(next.value, "{") {
        expect(p, "{")
        expect(p, "}")
        return m.newValue(m.V_STR, "{}")
    }
    if r.same(next.value, "*") {
        expect(p, "*")
        return m.newValue(m.V_STR, "*")
    }
    if isIdentifier(next) {
        const name = parseName(p)
        return parseExtendedAttributeRest3(p, name)
    }
    if next.kind == StringToken || next.kind == IntegerToken {
        return m.newValue(m.V_STR, getToken(p).value)
    }
    unexpected(p, next)
    return m.newValue(m.V_STR, "")
}

fn parseExtendedAttributeRest3(p: *Parser, name: Str) -> *m.Value {
    const next = peek(p)
    if r.same(next.value, "&") {
        expect(p, "&")
        const right = parseName(p)
        return m.newValue(m.V_STR, r.c3(name, "&", right))
    }
    if r.same(next.value, "|") {
        expect(p, "|")
        const right = parseName(p)
        return m.newValue(m.V_STR, r.c3(name, "|", right))
    }
    if r.same(next.value, "(") {
        expect(p, "(")
        const v = m.newValue(m.V_NAMED, name)
        v.*.items = parseArgumentList(p)
        expect(p, ")")
        return v
    }
    if isIdentifier(next) || oneOf(next.value, nextExtendedAttributeRest3_1[0..]) {
        if isIdentifier(peek(p)) { const ignored = getToken(p) }
        return m.newValue(m.V_STR, name)
    }
    unexpected(p, next)
    return m.newValue(m.V_STR, "")
}

fn parseIdentifierList(p: *Parser) -> r.StrList {
    var identifiers = r.strList()
    if isIdentifier(peek(p)) {
        r.spush(&identifiers, getToken(p).value)
        while r.same(peek(p).value, ",") {
            expect(p, ",")
            const token = getToken(p)
            if !isIdentifier(token) { fail(p, "Next token's type should be an identifier") }
            r.spush(&identifiers, token.value)
        }
    }
    return identifiers
}

fn parseName(p: *Parser) -> Str {
    const next = peek(p)
    if isIdentifier(next) { return getToken(p).value }
    unexpected(p, next)
    return ""
}

fn identifierRemoveNullablePrefix(name: Str) -> Str {
    if name.length > 0 && name[0] == 95 { return name[1..name.length] }
    return name
}

// ---------------------------------------------------------------------------
// Definitions.

fn parseDefinitions(p: *Parser) -> r.List {
    var definitions = r.list()
    while true {
        const ext = parseExtendedAttributeListAllowEmpty(p)
        const next = peek(p)
        if isIdentifier(next) || oneOf(next.value, nextDefinitions_1[0..]) {
            const definition = parseDefinition(p, ext)
            if definition != null { r.push(&definitions, @intFromPtr(definition.?)) }
        } else {
            break
        }
    }
    applyTypedefs(p, definitions)
    return definitions
}

fn applyTypedefsToOperation(p: *Parser, operation: *Node) -> void {
    if operation.*.ty != null { operation.*.ty = typeByApplyingTypedefs(p, operation.*.ty.?) }
    applyTypedefsToTypesOf(p, operation.*.arguments)
}

fn applyTypedefsToTypesOf(p: *Parser, nodes: r.List) -> void {
    var index: usize = 0
    while index < nodes.count {
        const n = m.node(nodes, index)
        n.*.ty = typeByApplyingTypedefs(p, n.*.ty.?)
        index += 1
    }
}

fn applyTypedefsToOperations(p: *Parser, nodes: r.List) -> void {
    var index: usize = 0
    while index < nodes.count {
        applyTypedefsToOperation(p, m.node(nodes, index))
        index += 1
    }
}

fn applyTypedefs(p: *Parser, definitions: r.List) -> void {
    var index: usize = 0
    while index < definitions.count {
        const d = m.node(definitions, index)
        if d.*.kind == m.K_INTERFACE {
            applyTypedefsToTypesOf(p, d.*.constants)
            applyTypedefsToTypesOf(p, d.*.attributes)
            applyTypedefsToOperations(p, d.*.operations)
            applyTypedefsToOperations(p, d.*.anonymousOperations)
            applyTypedefsToOperations(p, d.*.constructors)
            if d.*.iterable != null {
                const it = d.*.iterable.?
                if it.*.keyType != null { it.*.keyType = typeByApplyingTypedefs(p, it.*.keyType.?) }
                if it.*.valueType != null { it.*.valueType = typeByApplyingTypedefs(p, it.*.valueType.?) }
            }
            if d.*.asyncIterable != null {
                const it = d.*.asyncIterable.?
                if it.*.keyType != null { it.*.keyType = typeByApplyingTypedefs(p, it.*.keyType.?) }
                if it.*.valueType != null { it.*.valueType = typeByApplyingTypedefs(p, it.*.valueType.?) }
                applyTypedefsToTypesOf(p, it.*.arguments)
            }
            if d.*.mapLike != null {
                const it = d.*.mapLike.?
                if it.*.keyType != null { it.*.keyType = typeByApplyingTypedefs(p, it.*.keyType.?) }
                if it.*.valueType != null { it.*.valueType = typeByApplyingTypedefs(p, it.*.valueType.?) }
            }
            if d.*.setLike != null {
                const it = d.*.setLike.?
                if it.*.itemType != null { it.*.itemType = typeByApplyingTypedefs(p, it.*.itemType.?) }
            }
        } else if d.*.kind == m.K_DICTIONARY {
            applyTypedefsToTypesOf(p, d.*.members)
        } else if d.*.kind == m.K_CALLBACK {
            applyTypedefsToOperation(p, d.*.operation.?)
        } else if d.*.kind == m.K_NAMESPACE {
            applyTypedefsToTypesOf(p, d.*.constants)
            applyTypedefsToOperations(p, d.*.operations)
            applyTypedefsToTypesOf(p, d.*.attributes)
        }
        index += 1
    }
}

fn typeByApplyingTypedefs(p: *Parser, t: *IDLType) -> *IDLType {
    if t.*.subtypes.count > 0 {
        var index: usize = 0
        while index < t.*.subtypes.count {
            t.*.subtypes.items[index] = @intFromPtr(typeByApplyingTypedefs(p, m.subtype(t, index)))
            index += 1
        }
        return t
    }
    const map = typedefsMap()
    if r.has(map, t.*.name) {
        const typedefType: *IDLType = unsafe { @ptrFromInt(*IDLType, r.get(map, t.*.name)) }
        const cloned = m.cloneType(typedefType)
        cloned.*.isNullable = cloned.*.isNullable || t.*.isNullable
        moveExtendedAttributesApplicableToTypes(p, cloned, t.*.ext)
        return typeByApplyingTypedefs(p, cloned)
    }
    return t
}

fn parseDefinition(p: *Parser, ext: *m.Ext) -> ?*Node {
    const next = peek(p)
    if oneOf(next.value, nextCallbackOrInterface[0..]) { return parseCallbackOrInterfaceOrMixin(p, ext) }
    if r.same(next.value, "namespace") { return parseNamespace(p, ext) }
    if r.same(next.value, "partial") {
        expect(p, "partial")
        return parsePartialDefinition(p, ext)
    }
    if r.same(next.value, "dictionary") { return parseDictionary(p, ext) }
    if r.same(next.value, "enum") { return parseEnum(p, ext) }
    if r.same(next.value, "typedef") {
        parseTypedef(p, ext)
        return null
    }
    if isIdentifier(next) { return parseIncludesStatement(p, ext) }
    unexpected(p, next)
    return null
}

fn parseCallbackOrInterfaceOrMixin(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if r.same(next.value, "callback") {
        expect(p, "callback")
        const after = peek(p)
        if r.same(after.value, "interface") {
            expect(p, "interface")
            return parseCallbackInterface(p, ext)
        }
        if isIdentifier(after) { return parseCallbackRest(p, ext) }
        unexpected(p, after)
    }
    expect(p, "interface")
    const after = peek(p)
    if r.same(after.value, "mixin") { return parseMixin(p, ext) }
    if isIdentifier(after) { return parseInterface(p, ext) }
    unexpected(p, after)
    return m.newNode(m.K_INTERFACE)
}

fn interfaceName(p: *Parser) -> Str {
    const token = getToken(p)
    if !isIdentifier(token) { fail(p, "Next token's type should be an identifier") }
    return identifierRemoveNullablePrefix(token.value)
}

fn parseInterface(p: *Parser, ext: *m.Ext) -> *Node {
    const interface = m.newNode(m.K_INTERFACE)
    interface.*.ty = m.newType(interfaceName(p))
    if r.same(peek(p).value, ":") {
        expect(p, ":")
        interface.*.parentType = m.newType(parseName(p))
    }
    expect(p, "{")
    const members = parseMembers(p, 0)
    expect(p, "}")
    expect(p, ";")
    applyMemberList(interface, members)
    checkExtendedAttributes(p, ext, "interface", "")
    applyExtendedAttributeList(interface, ext)
    return interface
}

fn parseCallbackInterface(p: *Parser, ext: *m.Ext) -> *Node {
    const interface = m.newNode(m.K_INTERFACE)
    interface.*.isCallback = true
    interface.*.ty = m.newType(interfaceName(p))
    expect(p, "{")
    const members = parseMembers(p, 1)
    expect(p, "}")
    expect(p, ";")
    applyMemberList(interface, members)
    checkExtendedAttributes(p, ext, "interface", "")
    applyExtendedAttributeList(interface, ext)
    return interface
}

fn parseMixin(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "mixin")
    const mixin = m.newNode(m.K_INTERFACE)
    mixin.*.isMixin = true
    mixin.*.ty = m.newType(interfaceName(p))
    expect(p, "{")
    const members = parseMembers(p, 2)
    expect(p, "}")
    expect(p, ";")
    applyMemberList(mixin, members)
    checkExtendedAttributes(p, ext, "interface", "")
    applyExtendedAttributeList(mixin, ext)
    return mixin
}

// The members of an interface (0), a callback interface (1), a mixin (2),
// a namespace (3) or a partial interface (4).
fn parseMembers(p: *Parser, which: u8) -> r.List {
    var members = r.list()
    while true {
        const ext = parseExtendedAttributeListAllowEmpty(p)
        const next = peek(p)
        var starts = isIdentifier(next)
        if !starts {
            starts = if which == 0 { oneOf(next.value, nextInterfaceMembers_1[0..]) } else if which == 1 { oneOf(next.value, nextCallbackInterfaceMembers_1[0..]) } else if which == 2 { oneOf(next.value, nextMixinMembers_1[0..]) } else if which == 3 { oneOf(next.value, nextNamespaceMembers_1[0..]) } else { oneOf(next.value, nextPartialInterfaceMember_1[0..]) }
        }
        if !starts { break }
        const member = if which == 0 { parseInterfaceMember(p, ext) } else if which == 1 { parseCallbackInterfaceMember(p, ext) } else if which == 2 { parseMixinMember(p, ext) } else if which == 3 { parseNamespaceMember(p, ext) } else { parsePartialInterfaceMember(p, ext) }
        r.push(&members, @intFromPtr(member))
    }
    return members
}

fn parseCallbackInterfaceMember(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if r.same(next.value, "const") { return parseConst(p, ext) }
    if isIdentifier(next) || oneOf(next.value, nextRegularOperation_1[0..]) { return parseRegularOperation(p, ext) }
    unexpected(p, next)
    return m.newNode(m.K_OPERATION)
}

fn parseMixinMember(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if r.same(next.value, "const") { return parseConst(p, ext) }
    if r.same(next.value, "stringifier") { return parseStringifier(p, ext) }
    if oneOf(next.value, nextOptionallyReadonlyAttribute_1[0..]) {
        const isReadOnly = parseReadOnly(p)
        const attribute = parseAttributeRest(p, ext)
        attribute.*.isReadOnly = isReadOnly
        return attribute
    }
    if isIdentifier(next) || oneOf(next.value, nextRegularOperation_1[0..]) { return parseRegularOperation(p, ext) }
    unexpected(p, next)
    return m.newNode(m.K_OPERATION)
}

fn parseNamespace(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "namespace")
    const namespace = m.newNode(m.K_NAMESPACE)
    namespace.*.name = interfaceName(p)
    expect(p, "{")
    const members = parseMembers(p, 3)
    expect(p, "}")
    expect(p, ";")
    var index: usize = 0
    while index < members.count {
        const member = m.node(members, index)
        if member.*.kind == m.K_ATTRIBUTE {
            r.push(&namespace.*.attributes, @intFromPtr(member))
        } else if member.*.kind == m.K_CONSTANT {
            r.push(&namespace.*.constants, @intFromPtr(member))
        } else if member.*.kind == m.K_OPERATION {
            r.push(&namespace.*.operations, @intFromPtr(member))
        }
        index += 1
    }
    checkExtendedAttributes(p, ext, "namespace", "")
    namespace.*.ext = ext
    return namespace
}

fn parseNamespaceMember(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if r.same(next.value, "const") { return parseConst(p, ext) }
    if r.same(next.value, "readonly") {
        expect(p, "readonly")
        const attribute = parseAttributeRest(p, ext)
        attribute.*.isReadOnly = true
        return attribute
    }
    if isIdentifier(next) || oneOf(next.value, nextRegularOperation_1[0..]) { return parseRegularOperation(p, ext) }
    unexpected(p, next)
    return m.newNode(m.K_OPERATION)
}

fn parsePartialDefinition(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if r.same(next.value, "interface") {
        expect(p, "interface")
        const after = peek(p)
        if r.same(after.value, "mixin") {
            const mixin = parseMixin(p, ext)
            mixin.*.isPartial = true
            return mixin
        }
        if isIdentifier(after) { return parsePartialInterface(p, ext) }
        unexpected(p, after)
    }
    if r.same(next.value, "dictionary") {
        expect(p, "dictionary")
        return parsePartialDictionary(p, ext)
    }
    if r.same(next.value, "namespace") {
        const namespace = parseNamespace(p, ext)
        namespace.*.isPartial = true
        return namespace
    }
    unexpected(p, next)
    return m.newNode(m.K_INTERFACE)
}

fn parsePartialInterface(p: *Parser, ext: *m.Ext) -> *Node {
    const interface = m.newNode(m.K_INTERFACE)
    interface.*.isPartial = true
    interface.*.ty = m.newType(interfaceName(p))
    expect(p, "{")
    const members = parseMembers(p, 4)
    expect(p, "}")
    expect(p, ";")
    applyMemberList(interface, members)
    checkExtendedAttributes(p, ext, "interface", "")
    applyExtendedAttributeList(interface, ext)
    return interface
}

fn parsePartialInterfaceMember(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    const v = next.value
    if r.same(v, "const") { return parseConst(p, ext) }
    if r.same(v, "stringifier") { return parseStringifier(p, ext) }
    if r.same(v, "static") {
        expect(p, "static")
        const member = parseAttributeOrOperationForStringifierOrStatic(p, ext)
        member.*.isStatic = true
        return member
    }
    if r.same(v, "iterable") { return parseIterableRest(p, ext) }
    if r.same(v, "async_iterable") { return parseAsyncIterable(p, ext) }
    if r.same(v, "readonly") { return parseReadOnlyMember(p, ext) }
    if r.same(v, "attribute") { return parseAttributeRest(p, ext) }
    if r.same(v, "maplike") { return parseMapLikeRest(p, ext) }
    if r.same(v, "setlike") { return parseSetLikeRest(p, ext) }
    if r.same(v, "inherit") {
        expect(p, "inherit")
        const attribute = parseAttributeRest(p, ext)
        attribute.*.isInherit = true
        return attribute
    }
    if isIdentifier(next) || oneOf(v, nextOperation_1[0..]) {
        if oneOf(v, nextSpecials_1[0..]) { return parseSpecialOperation(p, ext) }
        return parseRegularOperation(p, ext)
    }
    unexpected(p, next)
    return m.newNode(m.K_OPERATION)
}

fn parseInterfaceMember(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if r.same(next.value, "constructor") { return parseConstructor(p, ext) }
    if isIdentifier(next) || oneOf(next.value, nextPartialInterfaceMember_1[0..]) { return parsePartialInterfaceMember(p, ext) }
    unexpected(p, next)
    return m.newNode(m.K_OPERATION)
}

fn parsePartialDictionary(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if !isIdentifier(next) { unexpected(p, next) }
    const dictionary = m.newNode(m.K_DICTIONARY)
    dictionary.*.isPartial = true
    checkExtendedAttributes(p, ext, "dictionary", "")
    dictionary.*.ext = ext
    const token = getToken(p)
    dictionary.*.ty = m.newType(token.value)
    expect(p, "{")
    dictionary.*.members = parseDictionaryMembers(p)
    expect(p, "}")
    expect(p, ";")
    return dictionary
}

fn parseDictionary(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "dictionary")
    const dictionary = m.newNode(m.K_DICTIONARY)
    checkExtendedAttributes(p, ext, "dictionary", "")
    dictionary.*.ext = ext
    dictionary.*.ty = m.newType(interfaceName(p))
    if r.same(peek(p).value, ":") {
        expect(p, ":")
        dictionary.*.parentType = m.newType(parseName(p))
    }
    expect(p, "{")
    dictionary.*.members = parseDictionaryMembers(p)
    expect(p, "}")
    expect(p, ";")
    return dictionary
}

fn parseDictionaryMembers(p: *Parser) -> r.List {
    var members = r.list()
    while true {
        const ext = parseExtendedAttributeListAllowEmpty(p)
        const next = peek(p)
        if isIdentifier(next) || oneOf(next.value, nextDictionaryMember_1[0..]) {
            r.push(&members, @intFromPtr(parseDictionaryMember(p, ext)))
        } else {
            break
        }
    }
    return members
}

fn parseDictionaryMember(p: *Parser, ext: *m.Ext) -> *Node {
    const member = m.newNode(m.K_MEMBER)
    if r.same(peek(p).value, "required") {
        expect(p, "required")
        member.*.isRequired = true
        member.*.ty = parseTypeWithExtendedAttributes(p)
        member.*.name = interfaceName(p)
        checkExtendedAttributes(p, ext, "dictionary-member", "")
        member.*.ext = ext
        expect(p, ";")
        return member
    }
    member.*.isRequired = false
    const t = parseType(p)
    moveExtendedAttributesApplicableToTypes(p, t, ext)
    member.*.ty = t
    member.*.name = interfaceName(p)
    member.*.defaultValue = parseDefault(p)
    checkExtendedAttributes(p, ext, "dictionary-member", "")
    if r.isDef(m.get(ext, "ImplementationRequired")) { member.*.isRequired = true }
    if !r.isDef(member.*.defaultValue) && r.isDef(m.get(ext, "ImplementationDefaultValue")) { member.*.defaultValue = m.get(ext, "ImplementationDefaultValue") }
    member.*.ext = ext
    expect(p, ";")
    return member
}

fn parseDefault(p: *Parser) -> Str {
    if r.same(peek(p).value, "=") {
        expect(p, "=")
        return parseDefaultValue(p)
    }
    return r.undef()
}

fn parseDefaultValue(p: *Parser) -> Str {
    const next = peek(p)
    if next.kind == FloatToken || next.kind == IntegerToken || oneOf(next.value, nextDefaultValue_1[0..]) { return parseConstValue(p) }
    if next.kind == StringToken { return getToken(p).value }
    if r.same(next.value, "[") {
        expect(p, "[")
        expect(p, "]")
        return "[]"
    }
    if r.same(next.value, "{") {
        expect(p, "{")
        expect(p, "}")
        return "{}"
    }
    unexpected(p, next)
    return ""
}

fn parseEnum(p: *Parser, ext: *m.Ext) -> *Node {
    const enumeration = m.newNode(m.K_ENUM)
    expect(p, "enum")
    const name = interfaceName(p)
    enumeration.*.name = name
    enumeration.*.ty = m.newType(name)
    expect(p, "{")
    // parseEnumValueList: at least one string, then strings with optional commas.
    if peek(p).kind != StringToken { unexpected(p, peek(p)) }
    while true {
        const token = getToken(p)
        r.spush(&enumeration.*.values, token.value[1..token.value.length - 1])
        if r.same(peek(p).value, ",") { expect(p, ",") }
        if peek(p).kind != StringToken { break }
    }
    expect(p, "}")
    expect(p, ";")
    checkExtendedAttributes(p, ext, "enum", "")
    enumeration.*.ext = ext
    return enumeration
}

fn parseCallbackRest(p: *Parser, ext: *m.Ext) -> *Node {
    const callback = m.newNode(m.K_CALLBACK)
    const nameToken = getToken(p)
    callback.*.ty = m.newType(nameToken.value)
    expect(p, "=")
    const operation = m.newNode(m.K_OPERATION)
    operation.*.ty = parseType(p)
    checkExtendedAttributes(p, ext, "callback-function", "operation")
    operation.*.ext = ext
    expect(p, "(")
    operation.*.arguments = parseArgumentList(p)
    expect(p, ")")
    expect(p, ";")
    callback.*.operation = operation
    callback.*.ext = ext
    return callback
}

fn parseTypedef(p: *Parser, ext: *m.Ext) -> void {
    if m.count(ext) > 0 { fail(p, "Extended attributes are not applicable to typedefs themselves") }
    expect(p, "typedef")
    const t = parseTypeWithExtendedAttributes(p)
    const nameToken = getToken(p)
    if !isIdentifier(nameToken) { fail(p, "Next token's type should be an identifier") }
    expect(p, ";")
    const map = typedefsMap()
    const name = nameToken.value
    if r.has(map, name) {
        const existing: *IDLType = unsafe { @ptrFromInt(*IDLType, r.get(map, name)) }
        if !r.same(t.*.name, existing.*.name) { fail(p, r.c2("typedef redefinition for ", name)) }
    }
    r.set(map, name, @intFromPtr(t))
}

fn parseIncludesStatement(p: *Parser, ext: *m.Ext) -> *Node {
    const statement = m.newNode(m.K_INCLUDES)
    statement.*.interfaceIdentifier = parseName(p)
    expect(p, "includes")
    statement.*.mixinIdentifier = parseName(p)
    expect(p, ";")
    checkExtendedAttributes(p, ext, "includes", "")
    statement.*.ext = ext
    return statement
}

fn parseConst(p: *Parser, ext: *m.Ext) -> *Node {
    const constant = m.newNode(m.K_CONSTANT)
    expect(p, "const")
    constant.*.ty = parseConstType(p)
    constant.*.name = interfaceName(p)
    expect(p, "=")
    constant.*.value = parseConstValue(p)
    expect(p, ";")
    checkExtendedAttributes(p, ext, "constant", "")
    constant.*.ext = ext
    return constant
}

fn parseConstValue(p: *Parser) -> Str {
    const next = peek(p)
    const v = next.value
    if r.same(v, "true") || r.same(v, "false") { return getToken(p).value }
    if r.same(v, "null") {
        expect(p, "null")
        return "null"
    }
    if next.kind == FloatToken || oneOf(v, nextConstValue_2[0..]) {
        if r.same(v, "-") {
            expect(p, "-")
            expect(p, "Infinity")
            return "-Infinity"
        }
        return getToken(p).value
    }
    if next.kind == IntegerToken { return getToken(p).value }
    unexpected(p, next)
    return ""
}

fn parseReadOnlyMember(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "readonly")
    const next = peek(p)
    if r.same(next.value, "attribute") {
        const attribute = parseAttributeRest(p, ext)
        attribute.*.isReadOnly = true
        return attribute
    }
    if r.same(next.value, "maplike") {
        const mapLike = parseMapLikeRest(p, ext)
        mapLike.*.isReadOnly = true
        return mapLike
    }
    if r.same(next.value, "setlike") {
        const setLike = parseSetLikeRest(p, ext)
        setLike.*.isReadOnly = true
        return setLike
    }
    unexpected(p, next)
    return m.newNode(m.K_ATTRIBUTE)
}

fn parseConstructor(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "constructor")
    const operation = m.newNode(m.K_OPERATION)
    operation.*.isConstructor = true
    expect(p, "(")
    operation.*.arguments = parseArgumentList(p)
    expect(p, ")")
    expect(p, ";")
    checkExtendedAttributes(p, ext, "operation", "")
    operation.*.ext = ext
    return operation
}

fn parseStringifier(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "stringifier")
    if r.same(peek(p).value, ";") {
        expect(p, ";")
        const operation = m.newNode(m.K_OPERATION)
        operation.*.isStringifier = true
        operation.*.name = ""
        operation.*.ty = m.newType("DOMString")
        operation.*.ext = ext
        return operation
    }
    const member = parseAttributeOrOperationForStringifierOrStatic(p, ext)
    member.*.isStringifier = true
    return member
}

fn parseAttributeOrOperationForStringifierOrStatic(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if oneOf(next.value, nextOptionallyReadonlyAttribute_1[0..]) {
        const isReadOnly = parseReadOnly(p)
        const attribute = parseAttributeRest(p, ext)
        attribute.*.isReadOnly = isReadOnly
        return attribute
    }
    if isIdentifier(next) || oneOf(next.value, nextRegularOperation_1[0..]) { return parseRegularOperation(p, ext) }
    unexpected(p, next)
    return m.newNode(m.K_OPERATION)
}

fn parseAttributeRest(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if !r.same(next.value, "attribute") { unexpected(p, next) }
    expect(p, "attribute")
    const attribute = m.newNode(m.K_ATTRIBUTE)
    checkExtendedAttributes(p, ext, "attribute", "")
    attribute.*.ext = ext
    attribute.*.ty = parseTypeWithExtendedAttributes(p)
    attribute.*.name = interfaceName(p)
    expect(p, ";")
    return attribute
}

fn parseReadOnly(p: *Parser) -> bool {
    if r.same(peek(p).value, "readonly") {
        expect(p, "readonly")
        return true
    }
    return false
}

fn parseRegularOperation(p: *Parser, ext: *m.Ext) -> *Node {
    const t = parseType(p)
    moveExtendedAttributesApplicableToTypes(p, t, ext)
    const operation = parseOperationRest(p, ext)
    operation.*.ty = t
    return operation
}

fn parseSpecialOperation(p: *Parser, ext: *m.Ext) -> *Node {
    var specials = r.strList()
    while oneOf(peek(p).value, nextSpecials_1[0..]) { r.spush(&specials, getToken(p).value) }
    const returnType = parseType(p)
    moveExtendedAttributesApplicableToTypes(p, returnType, ext)
    const operation = parseOperationRest(p, ext)
    operation.*.ty = returnType
    operation.*.specials = specials
    return operation
}

fn parseAsyncIterable(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "async_iterable")
    const iterable = m.newNode(m.K_ASYNC_ITERABLE)
    expect(p, "<")
    const first = parseTypeWithExtendedAttributes(p)
    if r.same(peek(p).value, ",") {
        expect(p, ",")
        const second = parseTypeWithExtendedAttributes(p)
        iterable.*.isKeyValue = true
        iterable.*.keyType = first
        iterable.*.valueType = second
    } else {
        iterable.*.isKeyValue = false
        iterable.*.valueType = first
    }
    expect(p, ">")
    if r.same(peek(p).value, "(") {
        expect(p, "(")
        r.append(&iterable.*.arguments, parseArgumentList(p))
        expect(p, ")")
    }
    expect(p, ";")
    iterable.*.ext = ext
    return iterable
}

fn parseIterableRest(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "iterable")
    const iterable = m.newNode(m.K_ITERABLE)
    expect(p, "<")
    const first = parseTypeWithExtendedAttributes(p)
    if r.same(peek(p).value, ",") {
        expect(p, ",")
        const second = parseTypeWithExtendedAttributes(p)
        iterable.*.isKeyValue = true
        iterable.*.keyType = first
        iterable.*.valueType = second
    } else {
        iterable.*.isKeyValue = false
        iterable.*.valueType = first
    }
    expect(p, ">")
    expect(p, ";")
    checkExtendedAttributes(p, ext, "iterable", "")
    iterable.*.ext = ext
    return iterable
}

fn parseMapLikeRest(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "maplike")
    const mapLike = m.newNode(m.K_MAPLIKE)
    expect(p, "<")
    mapLike.*.keyType = parseTypeWithExtendedAttributes(p)
    expect(p, ",")
    mapLike.*.valueType = parseTypeWithExtendedAttributes(p)
    expect(p, ">")
    expect(p, ";")
    checkExtendedAttributes(p, ext, "map-like", "")
    mapLike.*.ext = ext
    return mapLike
}

fn parseSetLikeRest(p: *Parser, ext: *m.Ext) -> *Node {
    expect(p, "setlike")
    const setLike = m.newNode(m.K_SETLIKE)
    expect(p, "<")
    setLike.*.itemType = parseTypeWithExtendedAttributes(p)
    expect(p, ">")
    expect(p, ";")
    checkExtendedAttributes(p, ext, "set-like", "")
    setLike.*.ext = ext
    return setLike
}

fn parseOperationRest(p: *Parser, ext: *m.Ext) -> *Node {
    const next = peek(p)
    if !(isIdentifier(next) || r.same(next.value, "(")) { unexpected(p, next) }
    const operation = m.newNode(m.K_OPERATION)
    var name: Str = ""
    if isIdentifier(peek(p)) { name = getToken(p).value }
    operation.*.name = identifierRemoveNullablePrefix(name)
    expect(p, "(")
    operation.*.arguments = parseArgumentList(p)
    expect(p, ")")
    expect(p, ";")
    checkExtendedAttributes(p, ext, "operation", "")
    operation.*.ext = ext
    return operation
}

fn parseArgumentList(p: *Parser) -> r.List {
    var arguments = r.list()
    const next = peek(p)
    if isIdentifier(next) || oneOf(next.value, nextArgumentList_1[0..]) {
        r.push(&arguments, @intFromPtr(parseArgument(p)))
        while r.same(peek(p).value, ",") {
            expect(p, ",")
            r.push(&arguments, @intFromPtr(parseArgument(p)))
        }
    }
    return arguments
}

fn parseArgument(p: *Parser) -> *Node {
    const next = peek(p)
    if !(isIdentifier(next) || oneOf(next.value, nextArgumentList_1[0..])) { unexpected(p, next) }
    const ext = parseExtendedAttributeListAllowEmpty(p)
    const argument = m.newNode(m.K_ARGUMENT)
    if r.same(peek(p).value, "optional") {
        expect(p, "optional")
        argument.*.ty = parseTypeWithExtendedAttributes(p)
        argument.*.isOptional = true
        argument.*.name = parseArgumentName(p)
        argument.*.defaultValue = parseDefault(p)
        checkExtendedAttributes(p, ext, "argument", "")
        if !r.isDef(argument.*.defaultValue) && r.isDef(m.get(ext, "ImplementationDefaultValue")) { argument.*.defaultValue = m.get(ext, "ImplementationDefaultValue") }
        argument.*.ext = ext
        return argument
    }
    const t = parseType(p)
    moveExtendedAttributesApplicableToTypes(p, t, ext)
    argument.*.ty = t
    argument.*.isOptional = false
    if r.same(peek(p).value, "...") {
        expect(p, "...")
        argument.*.isVariadic = true
    }
    argument.*.name = parseArgumentName(p)
    checkExtendedAttributes(p, ext, "argument", "")
    argument.*.ext = ext
    return argument
}

fn parseArgumentName(p: *Parser) -> Str {
    const next = peek(p)
    if oneOf(next.value, nextArgumentName_1[0..]) {
        if oneOf(next.value, argumentNameKeywords[0..]) { return getToken(p).value }
        unexpected(p, next)
    }
    if isIdentifier(next) { return getToken(p).value }
    unexpected(p, next)
    return ""
}

// ---------------------------------------------------------------------------
// Types.

fn parseType(p: *Parser) -> *IDLType {
    const next = peek(p)
    if r.same(next.value, "(") {
        const union = parseUnionType(p)
        union.*.isNullable = parseNull(p)
        union.*.ext = m.newExt()
        return union
    }
    if isIdentifier(next) || oneOf(next.value, nextType_1[0..]) {
        const single = parseSingleType(p)
        single.*.ext = m.newExt()
        return single
    }
    unexpected(p, next)
    return m.newType("")
}

fn parseTypeWithExtendedAttributes(p: *Parser) -> *IDLType {
    const ext = parseExtendedAttributeListAllowEmpty(p)
    checkExtendedAttributes(p, ext, "type", "")
    const next = peek(p)
    if r.same(next.value, "(") {
        const union = parseUnionType(p)
        union.*.isNullable = parseNull(p)
        union.*.ext = ext
        return union
    }
    if isIdentifier(next) || oneOf(next.value, nextType_1[0..]) {
        const single = parseSingleType(p)
        single.*.ext = ext
        return single
    }
    unexpected(p, next)
    return m.newType("")
}

fn parseSingleType(p: *Parser) -> *IDLType {
    const next = peek(p)
    if r.same(next.value, "any") {
        expect(p, "any")
        return m.newType("any")
    }
    if r.same(next.value, "Promise") {
        expect(p, "Promise")
        expect(p, "<")
        const sub = parseType(p)
        expect(p, ">")
        const t = m.newType("Promise")
        r.push(&t.*.subtypes, @intFromPtr(sub))
        return t
    }
    if isIdentifier(next) || oneOf(next.value, nextSingleType_1[0..]) {
        const t = parseDistinguishableType(p)
        t.*.isNullable = parseNull(p)
        return t
    }
    unexpected(p, next)
    return m.newType("")
}

fn parseUnionType(p: *Parser) -> *IDLType {
    const union = m.newType("UNION")
    union.*.isUnion = true
    expect(p, "(")
    r.push(&union.*.subtypes, @intFromPtr(parseUnionMemberType(p)))
    while r.same(peek(p).value, "or") {
        expect(p, "or")
        r.push(&union.*.subtypes, @intFromPtr(parseUnionMemberType(p)))
    }
    expect(p, ")")
    return union
}

fn parseUnionMemberType(p: *Parser) -> *IDLType {
    const ext = parseExtendedAttributeListAllowEmpty(p)
    checkExtendedAttributes(p, ext, "type", "")
    const next = peek(p)
    if r.same(next.value, "(") {
        const union = parseUnionType(p)
        union.*.isNullable = parseNull(p)
        union.*.ext = ext
        return union
    }
    if isIdentifier(next) || oneOf(next.value, nextSingleType_1[0..]) {
        const t = parseDistinguishableType(p)
        t.*.isNullable = parseNull(p)
        t.*.ext = ext
        return t
    }
    unexpected(p, next)
    return m.newType("")
}

fn parseDistinguishableType(p: *Parser) -> *IDLType {
    const next = peek(p)
    const v = next.value
    if oneOf(v, nextPrimitiveType_1[0..]) { return m.newType(parsePrimitiveType(p)) }
    if oneOf(v, nextStringType_1[0..]) { return m.newType(getToken(p).value) }
    if r.same(v, "sequence") || r.same(v, "FrozenArray") || r.same(v, "ObservableArray") {
        const name = getToken(p).value
        expect(p, "<")
        const sub = parseTypeWithExtendedAttributes(p)
        expect(p, ">")
        if r.same(name, "ObservableArray") { r.die("The ObservableArray type is not currently supported by the code generators.") }
        const t = m.newType(name)
        r.push(&t.*.subtypes, @intFromPtr(sub))
        return t
    }
    if r.same(v, "object") || r.same(v, "symbol") { return m.newType(getToken(p).value) }
    if r.same(v, "record") {
        expect(p, "record")
        expect(p, "<")
        const key = peek(p)
        if !oneOf(key.value, nextStringType_1[0..]) { unexpected(p, key) }
        const keyType = m.newType(getToken(p).value)
        expect(p, ",")
        const valueType = parseTypeWithExtendedAttributes(p)
        expect(p, ">")
        const t = m.newType("record")
        r.push(&t.*.subtypes, @intFromPtr(keyType))
        r.push(&t.*.subtypes, @intFromPtr(valueType))
        return t
    }
    if isIdentifier(next) { return m.newType(identifierRemoveNullablePrefix(getToken(p).value)) }
    unexpected(p, next)
    return m.newType("")
}

fn parseConstType(p: *Parser) -> *IDLType {
    const next = peek(p)
    if oneOf(next.value, nextPrimitiveType_1[0..]) {
        const t = m.newType(parsePrimitiveType(p))
        t.*.isNullable = parseNull(p)
        return t
    }
    if isIdentifier(next) {
        const t = m.newType(getToken(p).value)
        t.*.isNullable = parseNull(p)
        return t
    }
    unexpected(p, next)
    return m.newType("")
}

fn parsePrimitiveType(p: *Parser) -> Str {
    const next = peek(p)
    const v = next.value
    if oneOf(v, nextIntegerType_1[0..]) {
        if r.same(v, "unsigned") {
            expect(p, "unsigned")
            return r.c2("unsigned ", parseIntegerType(p))
        }
        if oneOf(v, nextUnsignedIntegerType_1[0..]) { return parseIntegerType(p) }
        unexpected(p, next)
    }
    if oneOf(v, nextFloatType_1[0..]) {
        if r.same(v, "unrestricted") {
            expect(p, "unrestricted")
            return r.c2("unrestricted ", parseFloatType(p))
        }
        return parseFloatType(p)
    }
    if r.same(v, "undefined") || r.same(v, "boolean") || r.same(v, "byte") || r.same(v, "octet") { return getToken(p).value }
    unexpected(p, next)
    return ""
}

fn parseFloatType(p: *Parser) -> Str {
    const next = peek(p)
    if r.same(next.value, "float") || r.same(next.value, "double") { return getToken(p).value }
    unexpected(p, next)
    return ""
}

fn parseIntegerType(p: *Parser) -> Str {
    const next = peek(p)
    if r.same(next.value, "short") || r.same(next.value, "int") { return getToken(p).value }
    if r.same(next.value, "long") {
        expect(p, "long")
        if r.same(peek(p).value, "long") {
            expect(p, "long")
            return "long long"
        }
        return "long"
    }
    unexpected(p, next)
    return ""
}

fn parseNull(p: *Parser) -> bool {
    if r.same(peek(p).value, "?") {
        expect(p, "?")
        return true
    }
    return false
}

// ---------------------------------------------------------------------------
// Members into their interface.

fn applyMemberList(interface: *Node, members: r.List) -> void {
    var index: usize = 0
    while index < members.count {
        const item = m.node(members, index)
        if item.*.kind == m.K_ATTRIBUTE {
            r.push(&interface.*.attributes, @intFromPtr(item))
        } else if item.*.kind == m.K_CONSTANT {
            r.push(&interface.*.constants, @intFromPtr(item))
        } else if item.*.kind == m.K_ITERABLE {
            interface.*.iterable = item
        } else if item.*.kind == m.K_ASYNC_ITERABLE {
            interface.*.asyncIterable = item
        } else if item.*.kind == m.K_MAPLIKE {
            interface.*.mapLike = item
        } else if item.*.kind == m.K_SETLIKE {
            interface.*.setLike = item
        } else if item.*.kind == m.K_OPERATION {
            if item.*.isConstructor {
                r.push(&interface.*.constructors, @intFromPtr(item))
            } else if item.*.name.length == 0 {
                r.push(&interface.*.anonymousOperations, @intFromPtr(item))
            } else {
                r.push(&interface.*.operations, @intFromPtr(item))
            }
        }
        index += 1
    }
}

fn applyExtendedAttributeList(interface: *Node, ext: *m.Ext) -> void {
    const factory = m.value(ext, "LegacyFactoryFunction")
    if factory != null {
        const constructor = m.newNode(m.K_OPERATION)
        constructor.*.isConstructor = true
        constructor.*.name = "LegacyFactoryFunction"
        constructor.*.ext = ext
        // The value is { NAME => arguments }.
        r.append(&constructor.*.arguments, factory.?.*.items)
        m.set(ext, "LegacyFactoryFunction", factory.?.*.text)
        r.push(&interface.*.constructors, @intFromPtr(constructor))
    }
    interface.*.ext = ext
}

fn convertNamespaceToInterface(namespace: *Node) -> *Node {
    const interface = m.newNode(m.K_INTERFACE)
    interface.*.ty = m.newType(namespace.*.name)
    var index: usize = 0
    while index < namespace.*.operations.count {
        const operation = m.node(namespace.*.operations, index)
        operation.*.isStatic = true
        r.push(&interface.*.operations, @intFromPtr(operation))
        index += 1
    }
    index = 0
    while index < namespace.*.attributes.count {
        const attribute = m.node(namespace.*.attributes, index)
        attribute.*.isStatic = true
        r.push(&interface.*.attributes, @intFromPtr(attribute))
        index += 1
    }
    r.append(&interface.*.constants, namespace.*.constants)
    interface.*.isNamespaceObject = true
    interface.*.isPartial = namespace.*.isPartial
    interface.*.ext = namespace.*.ext
    return interface
}

// ---------------------------------------------------------------------------
// Entry points.

// IDLParser's Parse: the document of the IDL file FILENAME.
pub fn parse(fileName: Str, macros: *r.Map) -> *m.Document {
    var p = Parser.{ .content = preprocess(fileName, macros), .at = 0, .token = Token.{ .kind = EmptyToken, .value = "empty" }, .next = Token.{ .kind = EmptyToken, .value = "empty" }, .fileName = fileName }
    addBuiltinTypedefs()
    const ignored = getToken(&p)
    const definitions = parseDefinitions(&p)
    if peek(&p).kind != EmptyToken { fail(&p, r.c2("Next token's type should be empty, but ", peek(&p).value)) }
    const document = m.newDocument(fileName)
    var index: usize = 0
    while index < definitions.count {
        const d = m.node(definitions, index)
        if d.*.kind == m.K_INTERFACE {
            r.push(&document.*.interfaces, @intFromPtr(d))
        } else if d.*.kind == m.K_ENUM {
            r.push(&document.*.enumerations, @intFromPtr(d))
        } else if d.*.kind == m.K_DICTIONARY {
            r.push(&document.*.dictionaries, @intFromPtr(d))
        } else if d.*.kind == m.K_CALLBACK {
            r.push(&document.*.callbackFunctions, @intFromPtr(d))
        } else if d.*.kind == m.K_NAMESPACE {
            r.push(&document.*.interfaces, @intFromPtr(convertNamespaceToInterface(d)))
        } else if d.*.kind == m.K_INCLUDES {
            r.push(&document.*.includes, @intFromPtr(d))
        }
        index += 1
    }
    return document
}

// IDLParser's ParseType: the type written TEXT (typedefs not applied).
pub fn parseTypeString(text: Str) -> *IDLType {
    var p = Parser.{ .content = text, .at = 0, .token = Token.{ .kind = EmptyToken, .value = "empty" }, .next = Token.{ .kind = EmptyToken, .value = "empty" }, .fileName = text }
    addBuiltinTypedefs()
    const ignored = getToken(&p)
    const result = parseType(&p)
    if peek(&p).kind != EmptyToken { fail(&p, "parsing type") }
    return result
}
