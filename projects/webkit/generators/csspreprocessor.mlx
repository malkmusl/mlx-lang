// WebCore's bindings/scripts/preprocessor.pm, as make-css-file-arrays.pl
// uses it: the file without its /* */ comments and, when some line starts
// with `#`, its `#if COND` / `#else` / `#endif` lines evaluated against
// the defines (COND being `defined(X) && X` joined by `&&`, maybe in
// parentheses, maybe negated as `!(...)`), the way the Perl does it rather
// than a C preprocessor.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const j = @import("./inspectorjsonvalue.mlx")
const c = @import("./csstext.mlx")

// Perl's \s and \w on bytes.
fn isSpace(byte: u8) -> bool { return byte == 32 || (byte >= 9 && byte <= 13) }

fn isWordText(text: []const u8) -> bool {
    if text.length == 0 { return false }
    for byte in text {
        if !s.isWord(byte) { return false }
    }
    return true
}

fn trimmed(text: []const u8) -> []const u8 {
    var start: usize = 0
    var end = text.length
    while start < end && isSpace(text[start]) { start += 1 }
    while end > start && isSpace(text[end - 1]) { end -= 1 }
    return text[start..end]
}

// The macros of DEFINES: its words, quotes taken out.
pub fn macros(defines: []const u8) -> t.List {
    var words = t.list()
    var start: usize = 0
    var index: usize = 0
    const plain = t.replaceAll(defines, "\"", "")
    while index <= plain.length {
        if index == plain.length || isSpace(plain[index]) {
            if index > start { t.push(&words, plain[start..index]) }
            start = index + 1
        }
        index += 1
    }
    return words
}

// What follows `(` and comes before the last `)` of EXPR when EXPR is
// `\s*(...)\s*` (after PREFIX), or "" when it is not.
fn parenthesized(expr: []const u8, negated: bool) -> []const u8 {
    var at: usize = 0
    while at < expr.length && isSpace(expr[at]) { at += 1 }
    if negated {
        if at >= expr.length || expr[at] != 33 { return "" }
        at += 1
        while at < expr.length && isSpace(expr[at]) { at += 1 }
    }
    if at >= expr.length || expr[at] != 40 { return "" }
    var end = expr.length
    while end > at && isSpace(expr[end - 1]) { end -= 1 }
    if end <= at + 2 || expr[end - 1] != 41 { return "" }
    return expr[at + 1..end - 1]
}

fn evaluate(expr: []const u8, defined: t.List) -> bool {
    const negatedInner = parenthesized(expr, true)
    if negatedInner.length > 0 { return !evaluate(negatedInner, defined) }
    const inner = parenthesized(expr, false)
    if inner.length > 0 { return evaluate(inner, defined) }
    // split(/\s*&&\s*/), trailing empty parts dropped.
    var parts = t.list()
    var start: usize = 0
    var index: usize = 0
    while index + 1 < expr.length {
        if expr[index] == 38 && expr[index + 1] == 38 {
            t.push(&parts, expr[start..index])
            index += 2
            start = index
        } else {
            index += 1
        }
    }
    t.push(&parts, expr[start..expr.length])
    while parts.count > 0 && trimmed(parts.items[parts.count - 1]).length == 0 { parts.count -= 1 }
    index = 0
    while index < parts.count {
        var part = trimmed(parts.items[index])
        // ^\(?defined\((\w+)\)\)?$
        var body = part
        if s.startsWith(body, "(") { body = body[1..body.length] }
        var name: []const u8 = ""
        if s.startsWith(body, "defined(") {
            var rest = body[8..body.length]
            if s.endsWith(rest, "))") && isWordText(rest[0..rest.length - 2]) {
                name = rest[0..rest.length - 2]
            } else if s.endsWith(rest, ")") && isWordText(rest[0..rest.length - 1]) {
                name = rest[0..rest.length - 1]
            }
        }
        if name.length == 0 && isWordText(part) { name = part }
        if name.length > 0 && !t.contains(defined, name) { return false }
        index += 1
    }
    return true
}

// After `#` and spaces at the start of LINE, whether WORD follows, ended as \b ends it.
fn directive(line: []const u8, word: []const u8) -> usize {
    var at: usize = 0
    while at < line.length && isSpace(line[at]) { at += 1 }
    if at >= line.length || line[at] != 35 { return 0 }
    at += 1
    while at < line.length && isSpace(line[at]) { at += 1 }
    if at + word.length > line.length || !s.same(line[at..at + word.length], word) { return 0 }
    return at + word.length
}

pub fn apply(content: []const u8, defines: []const u8) -> []const u8 {
    const text = j.withoutComments(content)
    // /^\s*#/m: a line whose first byte that is not a space is `#`.
    var hasDirectives = false
    var at: usize = 0
    var lineStart = true
    while at < text.length {
        if lineStart {
            var probe = at
            while probe < text.length && isSpace(text[probe]) { probe += 1 }
            if probe < text.length && text[probe] == 35 {
                hasDirectives = true
                break
            }
        }
        lineStart = text[at] == 10
        at += 1
    }
    if !hasDirectives { return text }
    const defined = macros(defines)
    var result = c.buf()
    var emitting: [64]bool = undefined
    var conditions: [64]bool = undefined
    var depth: usize = 0
    var on = true
    at = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        if end < text.length { end += 1 }
        const line = text[at..end]
        at = end
        const afterIf = directive(line, "if")
        if afterIf > 0 && afterIf < line.length && isSpace(line[afterIf]) {
            var condition = line[afterIf..line.length]
            while condition.length > 0 && isSpace(condition[0]) { condition = condition[1..condition.length] }
            var conditionEnd: usize = 0
            while conditionEnd < condition.length && condition[conditionEnd] != 10 { conditionEnd += 1 }
            const value = evaluate(condition[0..conditionEnd], defined)
            emitting[depth] = on
            conditions[depth] = value
            depth += 1
            on = on && value
            continue
        }
        const afterElse = directive(line, "else")
        if afterElse > 0 && (afterElse == line.length || !s.isWord(line[afterElse])) {
            on = emitting[depth - 1] && !conditions[depth - 1]
            continue
        }
        const afterEndif = directive(line, "endif")
        if afterEndif > 0 && (afterEndif == line.length || !s.isWord(line[afterEndif])) {
            depth -= 1
            on = emitting[depth]
            continue
        }
        if on { c.add(&result, line) }
    }
    return c.contents(&result)
}
