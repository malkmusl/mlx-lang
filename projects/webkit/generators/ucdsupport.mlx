// What the generators of JavaScriptCore's Unicode tables share, past
// support.mlx: hexadecimal numbers written and read, and the fields of
// the lines of the Unicode Character Database files.
const s = @import("./support.mlx")

// VALUE in hexadecimal, at least MINIMUM digits (zeros in front), in
// capitals with UPPER.
pub fn hex(value: u64, minimum: usize, upper: bool) -> []const u8 {
    var digits: [24]u8 = undefined
    var at: usize = 24
    var rest = value
    while rest != 0 || 24 - at < minimum || at == 24 {
        at -= 1
        const digit = @intCast(u8, rest % 16)
        digits[at] = if digit < 10 { 48 + digit } else if upper { 55 + digit } else { 87 + digit }
        rest /= 16
    }
    return s.join(digits[at..24], "")
}

pub fn outHex(value: u64, minimum: usize, upper: bool) -> void { s.out(hex(value, minimum, upper)) }

pub fn isHexDigit(byte: u8) -> bool { return s.isDigit(byte) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102) }

// The number TEXT writes in hexadecimal (Python's int(TEXT, 16)).
pub fn parseHex(text: []const u8) -> u64 {
    const digits = strip(text)
    if digits.length == 0 { s.fail(s.join("not a hexadecimal number: ", text)) }
    var value: u64 = 0
    for byte in digits {
        var digit: u64 = 0
        if s.isDigit(byte) {
            digit = @intCast(u64, byte - 48)
        } else if byte >= 65 && byte <= 70 {
            digit = @intCast(u64, byte - 55)
        } else if byte >= 97 && byte <= 102 {
            digit = @intCast(u64, byte - 87)
        } else {
            s.fail(s.join("not a hexadecimal number: ", text))
        }
        value = value * 16 + digit
    }
    return value
}

// TEXT without the white space around it (Python's strip()).
pub fn strip(text: []const u8) -> []const u8 { return s.trimEnd(s.trimStart(text)) }

// LINE before its comment, without the white space at its end (Python's
// line.split('#', 1)[0].rstrip()).
pub fn dataPart(line: []const u8) -> []const u8 {
    var end: usize = 0
    while end < line.length && line[end] != 35 { end += 1 }
    return s.trimEnd(line[0..end])
}

// How many fields LINE has between its semicolons.
pub fn fieldCount(line: []const u8) -> usize {
    var count: usize = 1
    for byte in line {
        if byte == 59 { count += 1 }
    }
    return count
}

// The field INDEX of LINE between its semicolons, as it is ("" past
// the last).
pub fn field(line: []const u8, index: usize) -> []const u8 {
    var start: usize = 0
    var number: usize = 0
    var at: usize = 0
    while at <= line.length {
        if at == line.length || line[at] == 59 {
            if number == index { return line[start..at] }
            number += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}
