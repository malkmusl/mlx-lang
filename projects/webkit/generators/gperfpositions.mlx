// Sets of byte positions in a keyword, as gperf's Positions class keeps
// them: 0 for the first byte, LASTCHAR for the last one, in decreasing
// order (LASTCHAR last); "useall" is the set '*' of every position below
// MAX_KEY_POS.
const s = @import("./support.mlx")
const io = @import("./gperfio.mlx")

pub const LASTCHAR: i64 = -1
pub const MAX_KEY_POS: i64 = 255
pub const MAX_SIZE: usize = 256
// The end of an iteration.
pub const EOS: i64 = -2

pub const Positions = struct {
    useall: bool
    size: usize
    p: [256]i64
}

pub fn none() -> Positions {
    var result = Positions.{ .useall = false, .size = 0, .p = undefined }
    return result
}

pub fn setUseall(set: *Positions, useall: bool) -> void {
    set.*.useall = useall
    if useall {
        set.*.size = 255
        var index: usize = 0
        while index < 255 {
            set.*.p[index] = 254 - @intCast(i64, index)
            index += 1
        }
    }
}

// Sorts the positions in decreasing order; false when two were the same.
pub fn sort(set: *Positions) -> bool {
    if set.*.useall { return true }
    var duplicateFree = true
    var index: usize = 1
    while index < set.*.size {
        var j = index
        const value = set.*.p[j]
        while j > 0 && value >= set.*.p[j - 1] {
            set.*.p[j] = set.*.p[j - 1]
            if set.*.p[j] == value { duplicateFree = false }
            j -= 1
        }
        set.*.p[j] = value
        index += 1
    }
    return duplicateFree
}

pub fn contains(set: *Positions, position: i64) -> bool {
    var index = set.*.size
    while index > 0 {
        const value = set.*.p[index - 1]
        if value == position { return true }
        if value > position { break }
        index -= 1
    }
    return false
}

pub fn add(set: *Positions, position: i64) -> void {
    setUseall(set, false)
    var count = set.*.size
    if count == MAX_SIZE { s.fail("Positions::add internal error: overflow") }
    // Moves the smaller positions up by one, from the end.
    var at: i64 = @intCast(i64, set.*.size) - 1
    while count > 0 {
        const value = set.*.p[@intCast(usize, at)]
        if value == position { s.fail("Positions::add internal error: duplicate") }
        if value > position { break }
        set.*.p[@intCast(usize, at + 1)] = value
        at -= 1
        count -= 1
    }
    set.*.p[@intCast(usize, at + 1)] = position
    set.*.size += 1
}

pub fn remove(set: *Positions, position: i64) -> void {
    setUseall(set, false)
    var count = set.*.size
    if count > 0 {
        var at = set.*.size - 1
        if set.*.p[at] == position {
            set.*.size -= 1
            return
        }
        if set.*.p[at] < position {
            var previous = set.*.p[at]
            while true {
                count -= 1
                if count == 0 { break }
                at -= 1
                if set.*.p[at] == position {
                    set.*.p[at] = previous
                    set.*.size -= 1
                    return
                }
                if set.*.p[at] > position { break }
                const current = set.*.p[at]
                set.*.p[at] = previous
                previous = current
            }
        }
    }
    s.fail("Positions::remove internal error: not found")
}

// Where an iteration (in decreasing order) over the positions that apply to
// keywords of length MAXLEN starts.
pub fn start(set: *Positions, maxlen: i64) -> usize {
    if set.*.useall {
        if maxlen <= MAX_KEY_POS { return @intCast(usize, MAX_KEY_POS - maxlen) }
        return 0
    }
    var index: usize = 0
    while index < set.*.size && set.*.p[index] >= maxlen { index += 1 }
    return index
}

// The positions in gperf's external syntax: "*", or "1,3-5,$".
pub fn print(set: *Positions) -> void {
    if set.*.useall {
        io.out("*")
        return
    }
    var first = true
    var seenLastchar = false
    var count = set.*.size
    var at: i64 = @intCast(i64, set.*.size) - 1
    while count > 0 {
        count -= 1
        const value = set.*.p[@intCast(usize, at)]
        if value == LASTCHAR {
            seenLastchar = true
        } else {
            if !first { io.out(",") }
            io.number(value + 1)
            if count > 0 && set.*.p[@intCast(usize, at - 1)] == value + 1 {
                io.out("-")
                while true {
                    at -= 1
                    count -= 1
                    if !(count > 0 && set.*.p[@intCast(usize, at - 1)] == set.*.p[@intCast(usize, at)] + 1) { break }
                }
                io.number(set.*.p[@intCast(usize, at)] + 1)
            }
            first = false
        }
        at -= 1
    }
    if seenLastchar {
        if !first { io.out(",") }
        io.out("$")
    }
}
