// CodeGeneratorJS.pm for enumerations, dictionaries and callbacks: their
// conversions to and from JavaScript, in their own files or in those of
// the interface declaring them.
const std = @import("std")
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const js = @import("./bindingsjs.mlx")
const t = @import("./bindingsjstypes.mlx")
const mo = @import("./bindingsjsmore.mlx")
const im = @import("./bindingsjsimpl.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

fn p(out: *StrList, text: Str) -> void { r.spush(out, text) }
fn cat(parts: []const Str) -> Str { return r.cat(parts) }
fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }

// ---------------------------------------------------------------------------
// Enumerations.

pub fn getEnumerationClassNameOf(ty: *IDLType, interface: ?*Node) -> Str {
    if cg.hasEnumImplementationNameOverride(ty) { return cg.getEnumImplementationNameOverride(ty) }
    const name = ty.*.name
    if cg.isExternalEnumType(ty) { return name }
    if interface == null { return name }
    return mo.getNestedClassName(interface.?, name)
}

pub fn getEnumerationClassName(ty: *IDLType) -> Str { return getEnumerationClassNameOf(ty, null) }

pub fn getEnumerationValueName(name: Str) -> Str {
    if name.length == 0 { return "EmptyString" }
    if std.text.same(name, "webrtc") { return "WebRTC" }
    const parts = r.splitByte(name, 45)
    var b = r.buf()
    var index: usize = 0
    while index < parts.count {
        r.add(&b, cg.wkUcfirst(parts.items[index]))
        index += 1
    }
    var result = r.done(b)
    if result.length > 0 && r.isDigit(result[0]) { result = r.c2("_", result) }
    return result
}

pub fn generateEnumerationHeader(enumeration: *Node, className: Str) -> void {
    r.sappend(js.headerContentHeader, js.generateHeaderContentHeader(enumeration))
    r.setStr(js.headerIncludes, r.c2(className, ".h"), "1")
    p(js.headerContent, "\nnamespace WebCore {\n\n")
    p(js.headerContent, generateEnumerationHeaderContent(enumeration, className, ""))
    p(js.headerContent, "} // namespace WebCore\n")
    const conditionalString = cg.generateConditionalString(enumeration.*.ext)
    if r.truthy(conditionalString) { p(js.headerContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

pub fn generateEnumerationImplementation(enumeration: *Node, className: Str) -> void {
    r.sappend(js.implContentHeader, js.generateImplementationContentHeader(enumeration))
    p(js.implContent, "\n")
    p(js.implContent, "\n\nnamespace WebCore {\n")
    p(js.implContent, "using namespace JSC;\n\n")
    p(js.implContent, generateEnumerationImplementationContent(enumeration, className, ""))
    p(js.implContent, "} // namespace WebCore\n")
    p(js.implContent, "\n")
    const conditionalString = cg.generateConditionalString(enumeration.*.ext)
    if r.truthy(conditionalString) { p(js.implContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

pub fn generateEnumerationImplementationContent(enumeration: *Node, className: Str, conditionalString: Str) -> Str {
    js.addToImplInclude("<JavaScriptCore/JSString.h>")
    js.addToImplInclude("JSDOMBindingFacade.h")
    js.addToImplInclude("JSDOMConvertEnumeration.h")
    js.addToImplInclude("<wtf/SortedArrayMap.h>")
    var b = r.buf()
    if r.truthy(conditionalString) { r.add(&b, cat([_]Str{ "#if ", conditionalString, "\n\n" }[0..])) }
    r.add(&b, cat([_]Str{ "String convertEnumerationToString(", className, " enumerationValue)\n" }[0..]))
    r.add(&b, "{\n")
    js.addToImplInclude("<wtf/NeverDestroyed.h>")
    const values = enumeration.*.values
    r.add(&b, cat([_]Str{ "    static const std::array<NeverDestroyed<String>, ", r.decimal(@intCast(u64, values.count)), "> values {\n" }[0..]))
    var index: usize = 0
    while index < values.count {
        if values.items[index].length == 0 {
            r.add(&b, "        emptyString(),\n")
        } else {
            r.add(&b, cat([_]Str{ "        MAKE_STATIC_STRING_IMPL(\"", values.items[index], "\"),\n" }[0..]))
        }
        index += 1
    }
    r.add(&b, "    };\n")
    index = 0
    while index < values.count {
        const valueName = getEnumerationValueName(values.items[index])
        const n = r.decimal(@intCast(u64, index))
        r.add(&b, cat([_]Str{ "    static_assert(static_cast<size_t>(", className, "::", valueName, ") == ", n, ", \"", className, "::", valueName, " is not ", n, " as expected\");\n" }[0..]))
        index += 1
    }
    r.add(&b, "    ASSERT(static_cast<size_t>(enumerationValue) < std::size(values));\n")
    r.add(&b, "    return values[static_cast<size_t>(enumerationValue)];\n")
    r.add(&b, "}\n\n")
    r.add(&b, cat([_]Str{ "template<> JSString* convertEnumerationToJS(VM& vm, ", className, " enumerationValue)\n" }[0..]))
    r.add(&b, "{\n")
    r.add(&b, "    return jsStringWithCache(vm, convertEnumerationToString(enumerationValue));\n")
    r.add(&b, "}\n\n")
    r.add(&b, cat([_]Str{ "template<> std::optional<", className, "> parseEnumerationFromString<", className, ">(const String& stringValue)\n" }[0..]))
    r.add(&b, "{\n")
    var sorted = r.ssorted(values)
    var first: usize = 0
    if sorted.items[0].length == 0 {
        r.add(&b, "    if (stringValue.isEmpty())\n")
        r.add(&b, cat([_]Str{ "        return ", className, "::", getEnumerationValueName(sorted.items[0]), ";\n" }[0..]))
        first = 1
    }
    r.add(&b, cat([_]Str{ "    static constexpr SortedArrayMap enumerationMapping { WTF::toArray<std::pair<ComparableASCIILiteral, ", className, ">>({\n" }[0..]))
    index = first
    while index < sorted.count {
        r.add(&b, cat([_]Str{ "        { \"", sorted.items[index], "\"_s, ", className, "::", getEnumerationValueName(sorted.items[index]), " },\n" }[0..]))
        index += 1
    }
    r.add(&b, "    }) };\n")
    r.add(&b, "    if (auto* enumerationValue = enumerationMapping.tryGet(stringValue); enumerationValue) [[likely]]\n")
    r.add(&b, "        return *enumerationValue;\n")
    r.add(&b, "    return std::nullopt;\n")
    r.add(&b, "}\n\n")
    r.add(&b, cat([_]Str{ "template<> std::optional<", className, "> parseEnumeration<", className, ">(JSGlobalObject& lexicalGlobalObject, JSValue value)\n" }[0..]))
    r.add(&b, "{\n")
    r.add(&b, cat([_]Str{ "    return parseEnumerationFromString<", className, ">(value.toWTFString(&lexicalGlobalObject));\n" }[0..]))
    r.add(&b, "}\n\n")
    r.add(&b, cat([_]Str{ "template<> ASCIILiteral expectedEnumerationValues<", className, ">()\n" }[0..]))
    r.add(&b, "{\n")
    r.add(&b, cat([_]Str{ "    return \"\\\"", r.sjoin(values, "\\\", \\\""), "\\\"\"_s;\n" }[0..]))
    r.add(&b, "}\n\n")
    if r.truthy(conditionalString) { r.add(&b, "#endif\n\n") }
    return r.done(b)
}

pub fn generateEnumerationsImplementationContent(interface: *Node, enumerations: r.List) -> Str {
    if enumerations.count == 0 { return "" }
    var b = r.buf()
    var index: usize = 0
    while index < enumerations.count {
        const enumeration = m.node(enumerations, index)
        const className = getEnumerationClassNameOf(enumeration.*.ty.?, interface)
        const conditionalString = cg.generateConditionalString(enumeration.*.ext)
        r.add(&b, generateEnumerationImplementationContent(enumeration, className, conditionalString))
        index += 1
    }
    return r.done(b)
}

pub fn generateEnumerationHeaderContent(enumeration: *Node, className: Str, conditionalString: Str) -> Str {
    r.setStr(js.headerIncludes, "JSDOMConvertEnumeration.h", "1")
    var b = r.buf()
    if r.truthy(conditionalString) { r.add(&b, cat([_]Str{ "#if ", conditionalString, "\n\n" }[0..])) }
    const exportMacro = js.getExportMacroForJSClass(enumeration)
    r.add(&b, cat([_]Str{ exportMacro, "String convertEnumerationToString(", className, ");\n" }[0..]))
    r.add(&b, cat([_]Str{ "template<> ", exportMacro, "JSC::JSString* convertEnumerationToJS(JSC::VM&, ", className, ");\n\n" }[0..]))
    r.add(&b, cat([_]Str{ "template<> ", exportMacro, "std::optional<", className, "> parseEnumerationFromString<", className, ">(const String&);\n" }[0..]))
    r.add(&b, cat([_]Str{ "template<> ", exportMacro, "std::optional<", className, "> parseEnumeration<", className, ">(JSC::JSGlobalObject&, JSC::JSValue);\n" }[0..]))
    r.add(&b, cat([_]Str{ "template<> ", exportMacro, "ASCIILiteral expectedEnumerationValues<", className, ">();\n\n" }[0..]))
    if r.truthy(conditionalString) { r.add(&b, "#endif\n\n") }
    return r.done(b)
}

pub fn generateEnumerationsHeaderContent(interface: *Node, enumerations: r.List) -> Str {
    if enumerations.count == 0 { return "" }
    var b = r.buf()
    var index: usize = 0
    while index < enumerations.count {
        const enumeration = m.node(enumerations, index)
        const className = getEnumerationClassNameOf(enumeration.*.ty.?, interface)
        const conditionalString = cg.generateConditionalString(enumeration.*.ext)
        r.add(&b, generateEnumerationHeaderContent(enumeration, className, conditionalString))
        index += 1
    }
    return r.done(b)
}

// ---------------------------------------------------------------------------
// Dictionaries.

pub fn getDictionaryClassNameOf(ty: *IDLType, interface: ?*Node) -> Str {
    if cg.hasDictionaryImplementationNameOverride(ty) { return cg.getDictionaryImplementationNameOverride(ty) }
    const name = ty.*.name
    if cg.isExternalDictionaryType(ty) { return name }
    if interface == null { return name }
    return mo.getNestedClassName(interface.?, name)
}

pub fn getDictionaryClassName(ty: *IDLType) -> Str { return getDictionaryClassNameOf(ty, null) }

pub fn generateDefaultValue(typeScope: ?*Node, context: *Node, typeValue: *IDLType, defaultValue: Str) -> Str {
    var ty = typeValue
    const idlType = t.getIDLType(typeScope, ty)
    if std.text.same(defaultValue, "null") {
        if ty.*.isUnion {
            if ty.*.isNullable { return cat([_]Str{ "typename Converter<", idlType, ">::ReturnType { std::nullopt }" }[0..]) }
            return cat([_]Str{ "convert<", idlType, ">(lexicalGlobalObject, jsNull());" }[0..])
        }
        if std.text.same(ty.*.name, "any") { return cat([_]Str{ "typename Converter<", idlType, ">::ReturnType { jsNull() }" }[0..]) }
        if cg.isWrapperType(ty) || cg.isBufferSourceType(ty) { return cat([_]Str{ "typename Converter<", idlType, ">::ReturnType { nullptr }" }[0..]) }
        if cg.isStringType(ty) {
            if m.on(ty.*.ext, "AtomString") { return cat([_]Str{ "typename Converter<", idlType, ">::ReturnType { nullAtom() }" }[0..]) }
            return cat([_]Str{ "typename Converter<", idlType, ">::ReturnType { String() }" }[0..])
        }
        if std.text.same(ty.*.name, "object") { return cat([_]Str{ "typename Converter<", idlType, ">::ReturnType { }" }[0..]) }
        return cat([_]Str{ "typename Converter<", idlType, ">::ReturnType { std::nullopt }" }[0..])
    }
    if std.text.same(defaultValue, "[]") { return cat([_]Str{ "Converter<", idlType, ">::ReturnType { }" }[0..]) }
    if std.text.same(defaultValue, "undefined") { return cat([_]Str{ "Converter<", idlType, ">::ReturnType { jsUndefined() }" }[0..]) }
    if std.text.same(defaultValue, "NaN") { return cat([_]Str{ "Converter<", idlType, ">::ReturnType { PNaN }" }[0..]) }
    if defaultValue.length > 0 && defaultValue[0] == 34 {
        if ty.*.isUnion {
            const members = t.getFlattenedMemberTypes(ty)
            var index: usize = 0
            while index < members.count {
                const member = r.at(*IDLType, members, index)
                if cg.isStringType(member) || cg.isEnumType(member) {
                    ty = member
                    break
                }
                index += 1
            }
        }
        if cg.isStringType(ty) {
            const useAtomString = m.on(ty.*.ext, "AtomString")
            if std.text.same(defaultValue, "\"\"") {
                if useAtomString { return cat([_]Str{ "Converter<", idlType, ">::ReturnType { emptyAtom() }" }[0..]) }
                return cat([_]Str{ "Converter<", idlType, ">::ReturnType { emptyString() }" }[0..])
            }
            if useAtomString { return cat([_]Str{ "Converter<", idlType, ">::ReturnType { AtomString(", defaultValue, "_s) }" }[0..]) }
            return cat([_]Str{ "Converter<", idlType, ">::ReturnType { ", defaultValue, "_s }" }[0..])
        }
        if cg.isEnumType(ty) {
            const className = getEnumerationClassNameOf(ty, typeScope)
            const valueName = getEnumerationValueName(r.substrInner(defaultValue, 1, 1))
            return cat([_]Str{ "Converter<", idlType, ">::ReturnType { ", className, "::", valueName, " }" }[0..])
        }
    }
    return cat([_]Str{ "Converter<", idlType, ">::ReturnType { ", defaultValue, " }" }[0..])
}

pub fn generateDictionaryHeaderContent(dictionary: *Node, className: Str, conditionalString: Str) -> Str {
    r.setStr(js.headerIncludes, "JSDOMConvertDictionary.h", "1")
    const exportMacro = js.getExportMacroForJSClass(dictionary)
    var b = r.buf()
    if r.truthy(conditionalString) { r.add(&b, cat([_]Str{ "#if ", conditionalString, "\n\n" }[0..])) }
    if mo.shouldGenerateConvertDictionary(dictionary) {
        r.add(&b, cat([_]Str{ "template<> ", exportMacro, "ConversionResult<IDLDictionary<", className, ">> convertDictionary<", className, ">(JSC::JSGlobalObject&, JSC::JSValue);\n\n" }[0..]))
    }
    if mo.shouldGenerateConvertDictionaryToJS(dictionary) {
        r.add(&b, cat([_]Str{ exportMacro, "JSC::JSObject* convertDictionaryToJS(JSC::JSGlobalObject&, JSDOMGlobalObject&, const ", className, "&);\n\n" }[0..]))
    }
    if r.truthy(conditionalString) { r.add(&b, "#endif\n\n") }
    return r.done(b)
}

pub fn generateDictionariesHeaderContent(typeScope: ?*Node, dictionaries: r.List) -> Str {
    if dictionaries.count == 0 { return "" }
    var b = r.buf()
    var index: usize = 0
    while index < dictionaries.count {
        const dictionary = m.node(dictionaries, index)
        index += 1
        if typeScope != null { r.setStr(js.headerIncludes, r.c2(typeName(typeScope.?), ".h"), "1") }
        const className = getDictionaryClassNameOf(dictionary.*.ty.?, typeScope)
        const conditionalString = cg.generateConditionalString(dictionary.*.ext)
        r.add(&b, generateDictionaryHeaderContent(dictionary, className, conditionalString))
    }
    return r.done(b)
}

fn generateDictionaryChecks(dictionary: *Node, className: Str) -> Str {
    js.addToImplInclude("<wtf/IsIncreasing.h>")
    js.addToImplInclude("<type_traits>")
    var b = r.buf()
    r.add(&b, "IGNORE_WARNINGS_BEGIN(\"invalid-offsetof\")\n\n")
    r.add(&b, cat([_]Str{ "static_assert(std::is_aggregate_v<", className, ">);\n" }[0..]))
    r.add(&b, "static_assert(IsIncreasing<\n")
    r.add(&b, "      0\n")
    var index: usize = 0
    while index < dictionary.*.members.count {
        const member = m.node(dictionary.*.members, index)
        index += 1
        const conditional = ext(member, "Conditional")
        if r.truthy(conditional) { r.add(&b, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..])) }
        const implementationName = r.orElse(ext(member, "ImplementedAs"), member.*.name)
        r.add(&b, cat([_]Str{ "    , offsetof(", className, ", ", implementationName, ")\n" }[0..]))
        if r.truthy(conditional) { r.add(&b, "#endif\n") }
    }
    r.add(&b, ">);\n\n")
    r.add(&b, "IGNORE_WARNINGS_END\n\n")
    return r.done(b)
}

fn getPermissiveEnumDefault(typeScope: *Node, member: *Node) -> (Str, Str) {
    const enumClassName = getEnumerationClassNameOf(member.*.ty.?, typeScope)
    if !r.isDef(member.*.defaultValue) { return -> (enumClassName, "std::nullopt") }
    const enumValue = getEnumerationValueName(r.substrInner(member.*.defaultValue, 1, 1))
    return -> (enumClassName, cat([_]Str{ enumClassName, "::", enumValue }[0..]))
}

fn generateDictionaryImplementationMemberConversion(typeScope: *Node, name: Str, dictionary: *Node, className: Str, member: *Node, initializationIndent: Str, initialization: *StrList) -> Str {
    if std.text.same(typeName(member), "any") && !r.isDef(member.*.defaultValue) { member.*.defaultValue = "undefined" }
    const conditional = ext(member, "Conditional")
    const ty = member.*.ty.?
    js.addToImplIncludesForIDLType(ty, conditional)
    var b = r.buf()
    if r.truthy(conditional) {
        const conditionalString = cg.generateConditionalStringFromAttributeValue(conditional)
        r.add(&b, cat([_]Str{ "#if ", conditionalString, "\n" }[0..]))
        p(initialization, cat([_]Str{ "#if ", conditionalString, "\n" }[0..]))
    }
    const key = member.*.name
    const implementedAsKey = r.orElse(ext(member, "ImplementedAs"), key)
    const idlType = t.getIDLType(typeScope, ty)
    const adjustedIDLType = t.getIDLTypeForDictionaryMember(typeScope, member)
    const needsRuntimeCheck = mo.needsRuntimeCheck(dictionary, member)
    var indent: Str = ""
    if needsRuntimeCheck {
        const runtimeEnableConditionalString = mo.generateRuntimeEnableConditionalString(dictionary, member, "&lexicalGlobalObject", false)
        r.add(&b, cat([_]Str{ "    auto ", implementedAsKey, "ConversionResult = [&] -> ConversionResult<", adjustedIDLType, "> {\n" }[0..]))
        r.add(&b, cat([_]Str{ "        if (", runtimeEnableConditionalString, ") {\n" }[0..]))
        indent = "        "
    }
    r.add(&b, cat([_]Str{ indent, "    JSValue ", key, "Value;\n" }[0..]))
    r.add(&b, cat([_]Str{ indent, "    if (isNullOrUndefined)\n" }[0..]))
    r.add(&b, cat([_]Str{ indent, "        ", key, "Value = jsUndefined();\n" }[0..]))
    r.add(&b, cat([_]Str{ indent, "    else {\n" }[0..]))
    r.add(&b, cat([_]Str{ indent, "        ", key, "Value = WebCore::get(object, &lexicalGlobalObject, Identifier::fromString(vm, \"", key, "\"_s));\n" }[0..]))
    r.add(&b, cat([_]Str{ indent, "        RETURN_IF_EXCEPTION(throwScope, ConversionResultException { });\n" }[0..]))
    r.add(&b, cat([_]Str{ indent, "    }\n" }[0..]))
    if member.*.isRequired {
        r.add(&b, cat([_]Str{ indent, "    if (", key, "Value.isUndefined()) {\n" }[0..]))
        r.add(&b, cat([_]Str{ indent, "        throwRequiredMemberTypeError(lexicalGlobalObject, throwScope, \"", member.*.name, "\"_s, \"", name, "\"_s, \"", mo.getTypeNameForDisplayInException(ty), "\"_s);\n" }[0..]))
        r.add(&b, cat([_]Str{ indent, "        return ConversionResultException { };\n" }[0..]))
        r.add(&b, cat([_]Str{ indent, "    }\n" }[0..]))
    }
    const defaultValueFunctor = mo.getDictionaryMemberDefaultValueFunctor(typeScope, member)
    const optional = t.memberIsOptional(member)
    var conversion: Str = ""
    if on(member, "PermissiveInvalidValue") && cg.isEnumType(ty) {
        const permissive = getPermissiveEnumDefault(typeScope, member)
        const returnExpr = if std.text.same(permissive.1, "std::nullopt") { "parseResult" } else { r.c3("parseResult.value_or(", permissive.1, ")") }
        if optional { js.addToImplIncludes("JSDOMConvertOptional.h", conditional) }
        var c = r.buf()
        r.add(&c, cat([_]Str{ "[&] -> ConversionResult<", adjustedIDLType, "> {\n" }[0..]))
        r.add(&c, cat([_]Str{ "        if (", key, "Value.isUndefined())\n" }[0..]))
        r.add(&c, cat([_]Str{ "            return ", permissive.1, ";\n" }[0..]))
        r.add(&c, cat([_]Str{ "        auto parseResult = parseEnumeration<", permissive.0, ">(lexicalGlobalObject, ", key, "Value);\n" }[0..]))
        r.add(&c, "        RETURN_IF_EXCEPTION(throwScope, ConversionResultException { });\n")
        r.add(&c, cat([_]Str{ "        return ", returnExpr, ";\n" }[0..]))
        r.add(&c, "    }()")
        conversion = r.done(c)
    } else {
        conversion = t.jsValueToNative(typeScope, member, r.c2(key, "Value"), conditional, "&lexicalGlobalObject", "lexicalGlobalObject", "", "uncheckedDowncast<JSDOMGlobalObject>(lexicalGlobalObject)", r.undef(), r.undef(), optional, defaultValueFunctor, r.undef())
    }
    if needsRuntimeCheck {
        r.add(&b, cat([_]Str{ "            return ", conversion, ";\n" }[0..]))
        r.add(&b, "        } else {\n")
        r.add(&b, cat([_]Str{ "            return ConversionResult<", adjustedIDLType, "> { Converter<", adjustedIDLType, ">::ReturnType { } };\n" }[0..]))
        r.add(&b, "        }\n")
        r.add(&b, "    }();\n")
    } else {
        r.add(&b, cat([_]Str{ "    auto ", implementedAsKey, "ConversionResult = ", conversion, ";\n" }[0..]))
    }
    r.add(&b, cat([_]Str{ "    if (", implementedAsKey, "ConversionResult.hasException(throwScope)) [[unlikely]]\n" }[0..]))
    r.add(&b, "        return ConversionResultException { };\n")
    p(initialization, cat([_]Str{ initializationIndent, implementedAsKey, "ConversionResult.releaseReturnValue(),\n" }[0..]))
    if r.truthy(conditional) {
        p(initialization, "#endif\n")
        r.add(&b, "#endif\n")
    }
    return r.done(b)
}

fn repeat(text: Str, count: usize) -> Str {
    var b = r.buf()
    var index: usize = 0
    while index < count {
        r.add(&b, text)
        index += 1
    }
    return r.done(b)
}

// The indices of NAMES in sorted order, equal names in their order (Perl's
// sort is stable).
fn sortedOrder(names: StrList) -> r.List {
    var order = r.list()
    var index: usize = 0
    while index < names.count {
        r.push(&order, index)
        index += 1
    }
    index = 1
    while index < order.count {
        const item = order.items[index]
        var at = index
        while at > 0 && r.less(names.items[item], names.items[order.items[at - 1]]) {
            order.items[at] = order.items[at - 1]
            at -= 1
        }
        order.items[at] = item
        index += 1
    }
    return order
}

fn generateConvertDictionary(dictionary: *Node, dictionaries: r.List, className: Str, interface: ?*Node) -> Str {
    const name = typeName(dictionary)
    const typeScope = if interface != null { interface.? } else { dictionary }
    var b = r.buf()
    r.add(&b, cat([_]Str{ "template<> ConversionResult<IDLDictionary<", className, ">> convertDictionary<", className, ">(JSGlobalObject& lexicalGlobalObject, JSValue value)\n" }[0..]))
    r.add(&b, "{\n")
    r.add(&b, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(&lexicalGlobalObject);\n")
    r.add(&b, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
    r.add(&b, "    bool isNullOrUndefined = value.isUndefinedOrNull();\n")
    r.add(&b, "    auto* object = isNullOrUndefined ? nullptr : value.getObject();\n")
    r.add(&b, "    if (!isNullOrUndefined && !object) [[unlikely]] {\n")
    r.add(&b, "        throwTypeError(&lexicalGlobalObject, throwScope);\n")
    r.add(&b, "        return ConversionResultException { };\n")
    r.add(&b, "    }\n")
    var aggregateInitialization = r.strList()
    const count = dictionaries.count
    var i: usize = 0
    while i < count {
        const current = m.node(dictionaries, i)
        const dictionaryClassName = getDictionaryClassNameOf(current.*.ty.?, interface)
        const indentForName = repeat("    ", count - i)
        const initializationIndent = r.c2("    ", indentForName)
        var initialization = r.strList()
        if i == count - 1 { r.spush(&initialization, r.c2(dictionaryClassName, " {\n")) } else { r.spush(&initialization, cat([_]Str{ indentForName, dictionaryClassName, " {\n" }[0..])) }
        r.sappend(&initialization, aggregateInitialization)
        var names = r.strList()
        var conversions = r.strList()
        var k: usize = 0
        while k < current.*.members.count {
            const member = m.node(current.*.members, k)
            k += 1
            const conversion = generateDictionaryImplementationMemberConversion(typeScope, name, current, className, member, initializationIndent, &initialization)
            r.spush(&names, member.*.name)
            r.spush(&conversions, conversion)
        }
        const order = sortedOrder(names)
        k = 0
        while k < order.count {
            r.add(&b, conversions.items[order.items[k]])
            k += 1
        }
        if i == count - 1 { r.spush(&initialization, r.c2(indentForName, "};\n")) } else { r.spush(&initialization, r.c2(indentForName, "},\n")) }
        aggregateInitialization = initialization
        i += 1
    }
    r.add(&b, "    return ")
    r.add(&b, r.sjoin(aggregateInitialization, ""))
    r.add(&b, "}\n\n")
    return r.done(b)
}

fn generateConvertDictionaryToJS(dictionary: *Node, dictionaries: r.List, className: Str, interface: ?*Node) -> Str {
    js.addToImplInclude("JSDOMGlobalObject.h")
    js.addToImplInclude("<JavaScriptCore/ObjectConstructor.h>")
    var hasUnconditionalMember = false
    const typeScope = if interface != null { interface.? } else { dictionary }
    var b = r.buf()
    r.add(&b, cat([_]Str{ "JSC::JSObject* convertDictionaryToJS(JSC::JSGlobalObject& lexicalGlobalObject, JSDOMGlobalObject& globalObject, const ", className, "& dictionary)\n" }[0..]))
    r.add(&b, "{\n")
    r.add(&b, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(&lexicalGlobalObject);\n")
    r.add(&b, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n\n")
    r.add(&b, "    auto result = WebCore::constructEmptyObject(&lexicalGlobalObject, globalObject.objectPrototype());\n\n")
    var i: usize = 0
    while i < dictionaries.count {
        const current = m.node(dictionaries, i)
        i += 1
        var names = r.strList()
        var k: usize = 0
        while k < current.*.members.count {
            r.spush(&names, m.node(current.*.members, k).*.name)
            k += 1
        }
        const order = sortedOrder(names)
        k = 0
        while k < order.count {
            const member = m.node(current.*.members, order.items[k])
            k += 1
            const key = member.*.name
            const implementedAsKey = r.orElse(ext(member, "ImplementedAs"), key)
            const valueExpression = r.c2("dictionary.", implementedAsKey)
            const conditional = ext(member, "Conditional")
            if r.truthy(conditional) {
                r.add(&b, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..]))
            } else {
                hasUnconditionalMember = true
            }
            const needsRuntimeCheck = mo.needsRuntimeCheck(current, member)
            var indent: Str = ""
            if needsRuntimeCheck {
                const runtimeEnableConditionalString = mo.generateRuntimeEnableConditionalString(current, member, "(&globalObject)", true)
                r.add(&b, cat([_]Str{ "    if (", runtimeEnableConditionalString, ") {\n" }[0..]))
                indent = "    "
            }
            if !member.*.isRequired && !r.isDef(member.*.defaultValue) {
                const idlType = t.getIDLType(typeScope, member.*.ty.?)
                const conversion = t.nativeToJSValueUsingReferences(member, typeScope, cat([_]Str{ idlType, "::extractValueFromNullable(", valueExpression, ")" }[0..]), "globalObject")
                r.add(&b, cat([_]Str{ indent, "    if (!", idlType, "::isNullValue(", valueExpression, ")) {\n" }[0..]))
                r.add(&b, cat([_]Str{ indent, "        auto ", key, "Value = ", conversion, ";\n" }[0..]))
                r.add(&b, cat([_]Str{ indent, "        RETURN_IF_EXCEPTION(throwScope, { });\n" }[0..]))
                r.add(&b, cat([_]Str{ indent, "        result->putDirect(vm, JSC::Identifier::fromString(vm, \"", key, "\"_s), ", key, "Value);\n" }[0..]))
                r.add(&b, cat([_]Str{ indent, "    }\n" }[0..]))
            } else {
                const conversion = t.nativeToJSValueUsingReferences(member, typeScope, valueExpression, "globalObject")
                r.add(&b, cat([_]Str{ indent, "    auto ", key, "Value = ", conversion, ";\n" }[0..]))
                r.add(&b, cat([_]Str{ indent, "    RETURN_IF_EXCEPTION(throwScope, { });\n" }[0..]))
                r.add(&b, cat([_]Str{ indent, "    result->putDirect(vm, JSC::Identifier::fromString(vm, \"", key, "\"_s), ", key, "Value);\n" }[0..]))
            }
            if needsRuntimeCheck { r.add(&b, "    }\n") }
            if r.truthy(conditional) { r.add(&b, "#endif\n") }
        }
    }
    if !hasUnconditionalMember {
        r.add(&b, "    UNUSED_PARAM(dictionary);\n")
        r.add(&b, "    UNUSED_VARIABLE(throwScope);\n\n")
    }
    r.add(&b, "    return result;\n")
    r.add(&b, "}\n\n")
    return r.done(b)
}

pub fn generateDictionaryImplementationContent(dictionary: *Node, className: Str, interface: ?*Node) -> Str {
    var b = r.buf()
    const conditional = ext(dictionary, "Conditional")
    if r.truthy(conditional) { r.add(&b, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n\n" }[0..])) }
    js.addToImplInclude("JSDOMBindingFacade.h")
    js.addToImplInclude("JSDOMConvertDictionary.h")
    var dictionaries = r.list()
    r.push(&dictionaries, @intFromPtr(dictionary))
    var parentType = dictionary.*.parentType
    while parentType != null {
        const parent = cg.getDictionaryByType(parentType.?)
        if parent == null { r.die(cat([_]Str{ "Unable to find definition for dictionary named '", parentType.?.*.name, "'!" }[0..])) }
        r.unshift(&dictionaries, @intFromPtr(parent.?))
        parentType = parent.?.*.parentType
    }
    r.add(&b, generateDictionaryChecks(dictionary, className))
    if mo.shouldGenerateConvertDictionary(dictionary) { r.add(&b, generateConvertDictionary(dictionary, dictionaries, className, interface)) }
    if mo.shouldGenerateConvertDictionaryToJS(dictionary) { r.add(&b, generateConvertDictionaryToJS(dictionary, dictionaries, className, interface)) }
    if r.truthy(conditional) { r.add(&b, "#endif\n\n") }
    return r.done(b)
}

pub fn generateDictionariesImplementationContent(typeScope: ?*Node, dictionaries: r.List) -> Str {
    var b = r.buf()
    var index: usize = 0
    while index < dictionaries.count {
        const dictionary = m.node(dictionaries, index)
        index += 1
        const className = getDictionaryClassNameOf(dictionary.*.ty.?, typeScope)
        r.add(&b, generateDictionaryImplementationContent(dictionary, className, typeScope))
    }
    return r.done(b)
}

pub fn generateDictionaryHeader(dictionary: *Node, className: Str, enumerations: r.List, otherDictionaries: r.List) -> void {
    r.sappend(js.headerContentHeader, js.generateHeaderContentHeader(dictionary))
    r.setStr(js.headerIncludes, r.c2(className, ".h"), "1")
    p(js.headerContent, "\nnamespace WebCore {\n\n")
    p(js.headerContent, generateDictionaryHeaderContent(dictionary, className, ""))
    p(js.headerContent, generateEnumerationsHeaderContent(dictionary, enumerations))
    if otherDictionaries.count > 0 { p(js.headerContent, generateDictionariesHeaderContent(dictionary, otherDictionaries)) }
    p(js.headerContent, "} // namespace WebCore\n")
    const conditionalString = cg.generateConditionalString(dictionary.*.ext)
    if r.truthy(conditionalString) { p(js.headerContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
    var ancestors = r.strList()
    var parentType = dictionary.*.parentType
    while parentType != null {
        if cg.isExternalDictionaryType(parentType.?) { r.spush(&ancestors, parentType.?.*.name) }
        const parent = cg.getDictionaryByType(parentType.?)
        if parent == null { r.die(cat([_]Str{ "Unable to find definition for dictionary named '", parentType.?.*.name, "'!" }[0..])) }
        parentType = parent.?.*.parentType
    }
    var files = r.strList()
    var index: usize = 0
    while index < ancestors.count {
        r.spush(&files, r.c2(ancestors.items[index], ".idl"))
        index += 1
    }
    p(js.depsContent, r.c2(className, ".h : "))
    p(js.depsContent, r.sjoin(files, " "))
    p(js.depsContent, "\n")
    index = 0
    while index < ancestors.count {
        p(js.depsContent, r.c2(ancestors.items[index], ".idl :\n"))
        index += 1
    }
}

pub fn generateDictionaryImplementation(dictionary: *Node, className: Str, enumerations: r.List, otherDictionaries: r.List) -> void {
    r.sappend(js.implContentHeader, js.generateImplementationContentHeader(dictionary))
    p(js.implContent, "\n")
    p(js.implContent, "\n\nnamespace WebCore {\n")
    p(js.implContent, "using namespace JSC;\n\n")
    p(js.implContent, generateDictionaryImplementationContent(dictionary, className, null))
    p(js.implContent, generateEnumerationsImplementationContent(dictionary, enumerations))
    if otherDictionaries.count > 0 { p(js.implContent, generateDictionariesImplementationContent(dictionary, otherDictionaries)) }
    p(js.implContent, "} // namespace WebCore\n")
    p(js.implContent, "\n")
    const conditionalString = cg.generateConditionalString(dictionary.*.ext)
    if r.truthy(conditionalString) { p(js.implContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

// ---------------------------------------------------------------------------
// Callbacks.

fn specializeTypeTraits(name: Str) -> void {
    const className = js.getCallbackClassName(name)
    p(js.headerContent, cat([_]Str{ "\nSPECIALIZE_TYPE_TRAITS_BEGIN(WebCore::", className, ")\n" }[0..]))
    p(js.headerContent, cat([_]Str{ "    static bool isType(const WebCore::", name, "& callback) { return callback.is", className, "(); }\n" }[0..]))
    p(js.headerContent, "SPECIALIZE_TYPE_TRAITS_END()\n")
}

pub fn generateCallbackFunctionHeader(callback: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    r.sappend(js.headerContentHeader, js.generateHeaderContentHeader(callback))
    p(js.headerContent, "\nnamespace WebCore {\n\n")
    var operations = r.list()
    r.push(&operations, @intFromPtr(callback.*.operation.?))
    generateCallbackHeaderContent(callback, operations, r.list(), js.headerContent, js.headerIncludes)
    p(js.headerContent, generateEnumerationsHeaderContent(callback, enumerations))
    p(js.headerContent, generateDictionariesHeaderContent(callback, dictionaries))
    p(js.headerContent, "} // namespace WebCore\n")
    specializeTypeTraits(typeName(callback))
    const conditionalString = cg.generateConditionalString(callback.*.ext)
    if r.truthy(conditionalString) { p(js.headerContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

pub fn generateCallbackFunctionImplementation(callback: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    r.sappend(js.implContentHeader, js.generateImplementationContentHeader(callback))
    p(js.implContent, "\n\nnamespace WebCore {\n")
    p(js.implContent, "using namespace JSC;\n\n")
    p(js.implContent, generateEnumerationsImplementationContent(callback, enumerations))
    p(js.implContent, generateDictionariesImplementationContent(callback, dictionaries))
    var operations = r.list()
    r.push(&operations, @intFromPtr(callback.*.operation.?))
    generateCallbackImplementationContent(callback, operations, r.list(), js.implContent, js.implIncludes)
    p(js.implContent, "} // namespace WebCore\n")
    const conditionalString = cg.generateConditionalString(callback.*.ext)
    if r.truthy(conditionalString) { p(js.implContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

pub fn generateCallbackInterfaceHeader(interface: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    r.sappend(js.headerContentHeader, js.generateHeaderContentHeader(interface))
    p(js.headerContent, "\nnamespace WebCore {\n\n")
    generateCallbackHeaderContent(interface, interface.*.operations, interface.*.constants, js.headerContent, js.headerIncludes)
    p(js.headerContent, generateEnumerationsHeaderContent(interface, enumerations))
    p(js.headerContent, generateDictionariesHeaderContent(interface, dictionaries))
    p(js.headerContent, "} // namespace WebCore\n")
    specializeTypeTraits(typeName(interface))
    const conditionalString = cg.generateConditionalString(interface.*.ext)
    if r.truthy(conditionalString) { p(js.headerContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

pub fn generateCallbackInterfaceImplementation(interface: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    r.sappend(js.implContentHeader, js.generateImplementationContentHeader(interface))
    p(js.implContent, "\n\nnamespace WebCore {\n")
    p(js.implContent, "using namespace JSC;\n\n")
    p(js.implContent, generateEnumerationsImplementationContent(interface, enumerations))
    p(js.implContent, generateDictionariesImplementationContent(interface, dictionaries))
    generateCallbackImplementationContent(interface, interface.*.operations, interface.*.constants, js.implContent, js.implIncludes)
    p(js.implContent, "} // namespace WebCore\n")
    const conditionalString = cg.generateConditionalString(interface.*.ext)
    if r.truthy(conditionalString) { p(js.implContent, cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

fn generateCallbackHeaderContent(interfaceOrCallback: *Node, operations: r.List, constants: r.List, content: *StrList, includes: *r.Map) -> void {
    const generateIsReachable = js.getGenerateIsReachable(interfaceOrCallback)
    if r.truthy(generateIsReachable) {
        if !std.text.same(generateIsReachable, "ImplScriptExecutionContext") { r.die("\"ImplScriptExecutionContext\" is the only valid value for \"GenerateIsReachable\" for callbacks.") }
        r.setStr(includes, "WebCoreOpaqueRoot.h", "1")
    }
    const name = typeName(interfaceOrCallback)
    const className = js.getCallbackClassName(name)
    r.setStr(includes, "IDLTypes.h", "1")
    r.setStr(includes, "JSCallbackData.h", "1")
    r.setStr(includes, "<wtf/Forward.h>", "1")
    r.setStr(includes, "<wtf/TypeCasts.h>", "1")
    r.setStr(includes, r.c2(name, ".h"), "1")
    const exportMacro = js.getExportMacroForJSClass(interfaceOrCallback)
    p(content, cat([_]Str{ "class ", exportMacro, className, " final : public ", name, " {\n" }[0..]))
    p(content, "public:\n")
    p(content, cat([_]Str{ "    static Ref<", className, "> create(JSC::JSObject* callback, JSDOMGlobalObject* globalObject)\n" }[0..]))
    p(content, "    {\n")
    p(content, cat([_]Str{ "        return adoptRef(*new ", className, "(callback, globalObject));\n" }[0..]))
    p(content, "    }\n\n")
    p(content, "    ScriptExecutionContext* scriptExecutionContext() const;\n\n")
    p(content, cat([_]Str{ "    ~", className, "() final;\n" }[0..]))
    p(content, "    JSCallbackData* callbackData() { return m_data; }\n")
    if constants.count > 0 { p(content, "    static JSC::JSValue getConstructor(JSC::VM&, const JSC::JSGlobalObject*);\n") }
    if operations.count > 0 {
        p(content, "\n    // Functions\n")
        var index: usize = 0
        while index < operations.count {
            const operation = m.node(operations, index)
            index += 1
            var arguments = r.strList()
            const callbackThisObject = ext(operation, "CallbackThisObject")
            if r.truthy(callbackThisObject) {
                const thisObjectType = cg.parseTypeString(callbackThisObject)
                r.spush(&arguments, cat([_]Str{ "typename ", t.getIDLType(interfaceOrCallback, thisObjectType), "::ParameterType thisObject" }[0..]))
            }
            var a: usize = 0
            while a < operation.*.arguments.count {
                const argument = m.node(operation.*.arguments, a)
                a += 1
                const idlType = t.getIDLType(interfaceOrCallback, argument.*.ty.?)
                if argument.*.isVariadic {
                    js.addToIncludes("JSDOMConvertVariadic.h", includes, "1")
                    js.addToIncludesForIDLType(argument.*.ty.?, includes, "1")
                    r.spush(&arguments, cat([_]Str{ "VariadicArguments<", idlType, ">&& ", argument.*.name }[0..]))
                } else {
                    r.spush(&arguments, cat([_]Str{ "typename ", idlType, "::ParameterType ", argument.*.name }[0..]))
                }
            }
            const nativeReturnType = cat([_]Str{ "CallbackResult<typename ", t.getIDLType(interfaceOrCallback, operation.*.ty.?), "::CallbackReturnType>" }[0..])
            const functionName = r.orElse(ext(operation, "ImplementedAs"), r.orElse(operation.*.name, "invoke"))
            const joined = r.sjoin(arguments, ", ")
            p(content, cat([_]Str{ "    ", nativeReturnType, " ", functionName, "(", joined, ") override;\n" }[0..]))
            if !cg.isPromiseType(operation.*.ty.?) {
                p(content, cat([_]Str{ "    ", nativeReturnType, " ", functionName, "RethrowingException(", joined, ") override;\n" }[0..]))
            }
        }
    }
    p(content, "\nprivate:\n")
    p(content, cat([_]Str{ "    ", className, "(JSC::JSObject*, JSDOMGlobalObject*);\n\n" }[0..]))
    p(content, "    bool hasCallback() const final { return m_data && m_data->callback(); }\n\n")
    p(content, cat([_]Str{ "    bool is", className, "() const final { return true; }\n\n" }[0..]))
    if !r.truthy(generateIsReachable) {
        p(content, "    void visitJSFunctionInGCThread(JSC::AbstractSlotVisitor&) override;\n\n")
        p(content, "    void visitJSFunctionInGCThread(JSC::SlotVisitor&) override;\n\n")
    }
    p(content, "    JSCallbackData* m_data;\n")
    p(content, "};\n\n")
    p(content, cat([_]Str{ exportMacro, "JSC::JSValue toJS(", name, "&);\n" }[0..]))
    p(content, cat([_]Str{ "inline JSC::JSValue toJS(", name, "* impl) { return impl ? toJS(*impl) : JSC::jsNull(); }\n\n" }[0..]))
    p(content, cat([_]Str{ "template<> struct JSDOMCallbackConverterTraits<", className, "> {\n" }[0..]))
    p(content, cat([_]Str{ "    using Base = ", name, ";\n" }[0..]))
    p(content, "};\n")
}

fn generateCallbackImplementationOperationBody(interfaceOrCallback: *Node, operations: r.List, content: *StrList, includes: *r.Map, operation: *Node, isForRethrowingHandler: bool) -> void {
    const name = typeName(interfaceOrCallback)
    const className = r.c2("JS", name)
    js.addToIncludesForIDLType(operation.*.ty.?, includes, r.undef())
    const nativeReturnType = cat([_]Str{ "CallbackResult<typename ", t.getIDLType(interfaceOrCallback, operation.*.ty.?), "::CallbackReturnType>" }[0..])
    const functionName = r.orElse(operation.*.name, "invoke")
    var functionImplementationName = r.orElse(ext(operation, "ImplementedAs"), functionName)
    if isForRethrowingHandler { functionImplementationName = r.c2(functionImplementationName, "RethrowingException") }
    var arguments = r.strList()
    var thisValue: Str = "jsUndefined()"
    const callbackThisObject = ext(operation, "CallbackThisObject")
    if r.truthy(callbackThisObject) {
        const thisObjectType = cg.parseTypeString(callbackThisObject)
        js.addToIncludesForIDLType(thisObjectType, includes, "1")
        r.spush(&arguments, cat([_]Str{ "typename ", t.getIDLType(interfaceOrCallback, thisObjectType), "::ParameterType thisObject" }[0..]))
        const thisObjectArgument = m.newNode(m.K_ARGUMENT)
        thisObjectArgument.*.ty = thisObjectType
        thisValue = t.nativeToJSValueUsingReferences(thisObjectArgument, interfaceOrCallback, "thisObject", "globalObject")
    }
    var a: usize = 0
    while a < operation.*.arguments.count {
        const argument = m.node(operation.*.arguments, a)
        a += 1
        const idlType = t.getIDLType(interfaceOrCallback, argument.*.ty.?)
        if argument.*.isVariadic {
            r.spush(&arguments, cat([_]Str{ "VariadicArguments<", idlType, ">&& ", argument.*.name }[0..]))
        } else {
            js.addToIncludesForIDLType(argument.*.ty.?, includes, "1")
            r.spush(&arguments, cat([_]Str{ "typename ", idlType, "::ParameterType ", argument.*.name }[0..]))
        }
    }
    p(content, cat([_]Str{ nativeReturnType, " ", className, "::", functionImplementationName, "(", r.sjoin(arguments, ", "), ")\n" }[0..]))
    p(content, "{\n")
    if !on(operation, "SkipCallbackInvokeCheck") {
        p(content, "    if (!canInvokeCallback())\n")
        p(content, "        return CallbackResultType::UnableToExecute;\n\n")
    }
    p(content, cat([_]Str{ "    Ref<", className, "> protectedThis(*this);\n\n" }[0..]))
    p(content, "    auto& globalObject = *m_data->globalObject();\n")
    p(content, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = globalObject.vm();\n\n")
    p(content, "    JSLockHolder lock(vm);\n")
    p(content, "    auto& lexicalGlobalObject = globalObject;\n")
    p(content, cat([_]Str{ "    JSValue thisValue = ", thisValue, ";\n" }[0..]))
    r.setStr(includes, "<JavaScriptCore/MarkedVector.h>", "1")
    p(content, "    MarkedArgumentBuffer args;\n")
    a = 0
    while a < operation.*.arguments.count {
        const argument = m.node(operation.*.arguments, a)
        a += 1
        if argument.*.isVariadic {
            const argumentName = argument.*.name
            p(content, cat([_]Str{ "    for (auto&& ", argumentName, "Item : WTF::move(", argumentName, ")) {\n" }[0..]))
            p(content, cat([_]Str{ "        args.append(", t.nativeToJSValueUsingReferences(argument, interfaceOrCallback, cat([_]Str{ "WTF::move(", argumentName, "Item)" }[0..]), "globalObject"), ");\n" }[0..]))
            p(content, "    }\n")
        } else {
            p(content, cat([_]Str{ "    args.append(", t.nativeToJSValueUsingReferences(argument, interfaceOrCallback, argument.*.name, "globalObject"), ");\n" }[0..]))
        }
    }
    p(content, "    ASSERT(!args.hasOverflowed());\n")
    p(content, "\n    NakedPtr<JSC::Exception> returnedException;\n")
    var invocation: Str = ""
    if interfaceOrCallback.*.kind == m.K_CALLBACK {
        invocation = "m_data->invokeCallback(thisValue, args, JSCallbackData::CallbackType::Function, Identifier(), returnedException)"
    } else {
        const callbackType = if operations.count > 1 { "Object" } else { "FunctionOrObject" }
        invocation = cat([_]Str{ "m_data->invokeCallback(thisValue, args, JSCallbackData::CallbackType::", callbackType, ", Identifier::fromString(vm, \"", functionName, "\"_s), returnedException)" }[0..])
    }
    const returnsUndefined = std.text.same(typeName(operation), "undefined")
    if returnsUndefined { p(content, cat([_]Str{ "    ", invocation, ";\n" }[0..])) } else { p(content, cat([_]Str{ "    auto jsResult = ", invocation, ";\n" }[0..])) }
    r.setStr(includes, "JSDOMExceptionHandling.h", "1")
    p(content, "    if (returnedException) {\n")
    if cg.isPromiseType(operation.*.ty.?) {
        p(content, "        auto* jsPromise = JSC::JSPromise::create(vm, globalObject.promiseStructure());\n")
        p(content, "        jsPromise->rejectAsHandled(vm, returnedException->value());\n")
        p(content, "        return { DOMPromise::create(globalObject, *jsPromise) };\n")
    } else if isForRethrowingHandler {
        p(content, "        auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
        p(content, "        throwException(&lexicalGlobalObject, throwScope, returnedException);\n")
        p(content, "        return CallbackResultType::ExceptionThrown;\n")
    } else {
        p(content, "        UNUSED_PARAM(lexicalGlobalObject);\n")
        p(content, "        auto* callbackRealm = m_data->callback()->realmMayBeNull();\n")
        p(content, "        reportException(callbackRealm ? callbackRealm : m_data->globalObject(), returnedException);\n")
        p(content, "        return CallbackResultType::ExceptionThrown;\n")
    }
    p(content, "     }\n\n")
    if returnsUndefined {
        p(content, "    return { };\n")
    } else {
        const nativeValue = t.jsValueToNative(interfaceOrCallback, operation, "jsResult", "", "&lexicalGlobalObject", "lexicalGlobalObject", r.undef(), r.undef(), r.undef(), r.undef(), false, r.undef(), r.undef())
        p(content, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
        p(content, cat([_]Str{ "    auto returnValue = ", nativeValue, ";\n" }[0..]))
        p(content, "    if (returnValue.hasException(throwScope)) [[unlikely]]\n")
        p(content, "        return CallbackResultType::ExceptionThrown;\n")
        p(content, "    return { returnValue.releaseReturnValue() };\n")
    }
    p(content, "}\n\n")
}

fn generateCallbackImplementationContent(interfaceOrCallback: *Node, operations: r.List, constants: r.List, content: *StrList, includes: *r.Map) -> void {
    const generateIsReachable = js.getGenerateIsReachable(interfaceOrCallback)
    const name = typeName(interfaceOrCallback)
    const visibleName = cg.getVisibleInterfaceName(interfaceOrCallback)
    const className = r.c2("JS", name)
    r.setStr(includes, "ContextDestructionObserverInlines.h", "1")
    r.setStr(includes, "JSDOMGlobalObject.h", "1")
    r.setStr(includes, "ScriptExecutionContext.h", "1")
    r.setStr(includes, "JSDOMBindingFacade.h", "1")
    const ownerObject = if r.truthy(generateIsReachable) { "globalObject->scriptExecutionContext()" } else { "this" }
    p(content, cat([_]Str{ className, "::", className, "(JSObject* callback, JSDOMGlobalObject* globalObject)\n" }[0..]))
    p(content, cat([_]Str{ "    : ", name, "(globalObject->scriptExecutionContext())\n" }[0..]))
    p(content, cat([_]Str{ "    , m_data(new JSCallbackData(callback, globalObject, ", ownerObject, "))\n" }[0..]))
    p(content, "{\n")
    p(content, "}\n\n")
    p(content, cat([_]Str{ className, "::~", className, "()\n" }[0..]))
    p(content, "{\n")
    p(content, "    SUPPRESS_UNCOUNTED_LOCAL ScriptExecutionContext* context = scriptExecutionContext();\n")
    p(content, "    // When the context is destroyed, all tasks with a reference to a callback\n")
    p(content, "    // should be deleted. So if the context is 0, we are on the context thread.\n")
    p(content, "    // We can't use RefPtr here since ScriptExecutionContext is not thread safe ref counted.\n")
    p(content, "    if (!context || context->isContextThread())\n")
    p(content, "        delete m_data;\n")
    p(content, "    else\n")
    p(content, "        context->postTask(DeleteCallbackDataTask(m_data));\n")
    p(content, "#ifndef NDEBUG\n")
    p(content, "    m_data = nullptr;\n")
    p(content, "#endif\n")
    p(content, "}\n\n")
    if constants.count > 0 {
        mo.generateConstructorDeclaration(content, className, interfaceOrCallback, name)
        var hashSize: usize = 0
        const hashName = r.c2(className, "ConstructorTable")
        var keys = r.strList()
        var values1 = r.strList()
        var values2 = r.strList()
        var specials = r.list()
        var conditionals = r.map()
        var readWriteConditionals = r.map()
        var index: usize = 0
        while index < constants.count {
            const constant = m.node(constants, index)
            index += 1
            r.spush(&keys, constant.*.name)
            r.spush(&values1, constant.*.value)
            r.spush(&values2, "0")
            const special: *StrList = unsafe { @ptrFromInt(*StrList, r.alloc(@sizeOf(StrList))) }
            special.* = r.strList()
            r.spush(special, "PropertyAttribute::ReadOnly")
            r.spush(special, "PropertyAttribute::DontDelete")
            r.spush(special, "PropertyAttribute::ConstantInteger")
            r.push(&specials, @intFromPtr(special))
            const implementedBy = ext(constant, "ImplementedBy")
            if r.truthy(implementedBy) { r.setStr(js.implIncludes, r.c2(implementedBy, ".h"), "1") }
            const conditional = ext(constant, "Conditional")
            if r.truthy(conditional) { r.setStr(&conditionals, constant.*.name, conditional) }
            hashSize += 1
        }
        if hashSize > 0 { mo.generateHashTable(className, hashName, hashSize, keys, specials, values1, values2, &conditionals, &readWriteConditionals, true) }
        r.sappend(content, cg.generateCompileTimeCheckForEnumsIfNeeded(interfaceOrCallback))
        mo.generateConstructorDefinitions(content, className, "", visibleName, interfaceOrCallback, false)
        js.addToImplInclude("JSDOMGlobalObjectInlines.h")
        p(content, cat([_]Str{ "JSValue ", className, "::getConstructor(VM& vm, const JSGlobalObject* globalObject)\n" }[0..]))
        p(content, "{\n")
        p(content, cat([_]Str{ "    return getDOMConstructor<", className, "DOMConstructor, DOMConstructorID::", name, ">(vm, *uncheckedDowncast<JSDOMGlobalObject>(globalObject));\n" }[0..]))
        p(content, "}\n\n")
    }
    var index: usize = 0
    while index < operations.count {
        const operation = m.node(operations, index)
        index += 1
        if on(operation, "Custom") { continue }
        generateCallbackImplementationOperationBody(interfaceOrCallback, operations, content, includes, operation, false)
        if !cg.isPromiseType(operation.*.ty.?) { generateCallbackImplementationOperationBody(interfaceOrCallback, operations, content, includes, operation, true) }
    }
    if !r.truthy(generateIsReachable) {
        p(content, cat([_]Str{ "void ", className, "::visitJSFunctionInGCThread(JSC::AbstractSlotVisitor& visitor)\n" }[0..]))
        p(content, "{\n")
        p(content, "    m_data->visitJSFunctionInGCThread(visitor);\n")
        p(content, "}\n\n")
        p(content, cat([_]Str{ "void ", className, "::visitJSFunctionInGCThread(JSC::SlotVisitor& visitor)\n" }[0..]))
        p(content, "{\n")
        p(content, "    m_data->visitJSFunctionInGCThread(visitor);\n")
        p(content, "}\n\n")
    }
    p(content, cat([_]Str{ "JSC::JSValue toJS(", name, "& impl)\n" }[0..]))
    p(content, "{\n")
    p(content, cat([_]Str{ "    if (auto* callbackData = downcast<", className, ">(impl).callbackData())\n" }[0..]))
    p(content, "        return callbackData->callback();\n")
    p(content, "    return jsNull();\n\n")
    p(content, "}\n\n")
    p(content, cat([_]Str{ "ScriptExecutionContext* ", className, "::scriptExecutionContext() const\n" }[0..]))
    p(content, "{\n")
    p(content, "    return ContextDestructionObserver::scriptExecutionContext();\n")
    p(content, "}\n")
}
