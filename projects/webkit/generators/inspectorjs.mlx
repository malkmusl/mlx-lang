// InspectorBackendCommands.js, as codegen/generate_js_backend_commands.py
// makes it: for each domain with a version, commands, events or enum
// types, the calls registering them with the Web Inspector's
// InspectorBackend. Like the original the text then goes through the C
// preprocessor (codegen/preprocess.pl), which keeps what the protocol's
// condition flags allow: the #if lines are worked out here, the lines
// left blank dropped, and a blank line put before each "//" comment.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const m = @import("./inspectormodel.mlx")

pub fn outputFilename(p: *m.Protocol) -> []const u8 { return "InspectorBackendCommands.js" }

fn shouldGenerate(domain: *m.Domain) -> bool {
    if domain.*.hasVersion || domain.*.commandCount > 0 || domain.*.eventCount > 0 { return true }
    var index: usize = 0
    while index < domain.*.declarationCount {
        if domain.*.declarations[index].ty.*.kind == m.ENUM { return true }
        index += 1
    }
    return false
}

fn enumMap(values: t.List) -> []const u8 {
    var pairs = t.list()
    var index: usize = 0
    while index < values.count {
        t.push(&pairs, t.c4(m.stylizedEnumName(values.items[index]), ": \"", values.items[index], "\""))
        index += 1
    }
    return t.joined(pairs, ", ")
}

fn registerEnum(domain: *m.Domain, name: []const u8, values: t.List) -> []const u8 {
    return t.c7("InspectorBackend.registerEnum(\"", domain.*.name, ".", name, "\", {", enumMap(values), "});")
}

fn generateDomain(domain: *m.Domain) -> []const u8 {
    var lines = t.list()
    t.push(&lines, s.join("// ", domain.*.name))
    t.push(&lines, t.c5("InspectorBackend.registerDomain(\"", domain.*.name, "\", ", domain.*.targetTypes, ");"))
    if domain.*.hasVersion {
        t.push(&lines, t.c5("InspectorBackend.registerVersion(\"", domain.*.name, "\", ", s.signedDecimal(domain.*.version), ");"))
    }

    var index: usize = 0
    while index < domain.*.declarationCount {
        const declaration = &domain.*.declarations[index]
        if m.isEnum(declaration.*.ty) {
            t.push(&lines, m.guarded(declaration.*.condition, registerEnum(domain, declaration.*.name, declaration.*.ty.*.values)))
        }
        var member: usize = 0
        while member < declaration.*.memberCount {
            const ty = declaration.*.members[member].ty
            if m.isAnonymousEnum(ty) {
                t.push(&lines, registerEnum(domain, s.join(declaration.*.name, m.ucfirst(declaration.*.members[member].name)), ty.*.values))
            }
            member += 1
        }
        index += 1
    }

    var hasAsyncCommands = false
    index = 0
    while index < domain.*.commandCount {
        const command = &domain.*.commands[index]
        if command.*.async { hasAsyncCommands = true }
        var callParameters = t.list()
        var parameter: usize = 0
        while parameter < command.*.parameterCount {
            const given = &command.*.parameters[parameter]
            var pairs = t.list()
            t.push(&pairs, t.c3("\"name\": \"", given.*.name, "\""))
            t.push(&pairs, t.c3("\"type\": \"", m.jsNameForParameterType(given.*.ty), "\""))
            if given.*.optional { t.push(&pairs, "\"optional\": true") }
            t.push(&callParameters, t.c3("{", t.joined(pairs, ", "), "}"))
            parameter += 1
        }
        var returnParameters = t.list()
        parameter = 0
        while parameter < command.*.returnCount {
            t.push(&returnParameters, t.c3("\"", command.*.returns[parameter].name, "\""))
            parameter += 1
        }
        const line = t.c9("InspectorBackend.registerCommand(\"", domain.*.name, ".", command.*.name, "\", ", command.*.targetTypes, ", [", t.joined(callParameters, ", "),
            t.c3("], [", t.joined(returnParameters, ", "), "]);"))
        t.push(&lines, m.guarded(command.*.condition, line))
        index += 1
    }

    index = 0
    while index < domain.*.eventCount {
        const event = &domain.*.events[index]
        var eventLines = t.list()
        var names = t.list()
        var parameter: usize = 0
        while parameter < event.*.parameterCount {
            const given = &event.*.parameters[parameter]
            if m.isAnonymousEnum(given.*.ty) {
                t.push(&eventLines, registerEnum(domain, s.join(m.ucfirst(event.*.name), m.ucfirst(given.*.name)), given.*.ty.*.values))
            }
            t.push(&names, t.c3("\"", given.*.name, "\""))
            parameter += 1
        }
        t.push(&eventLines, t.c9("InspectorBackend.registerEvent(\"", domain.*.name, ".", event.*.name, "\", ", event.*.targetTypes, ", [", t.joined(names, ", "), "]);"))
        t.push(&lines, m.guarded(event.*.condition, t.joined(eventLines, "\n")))
        index += 1
    }

    if domain.*.eventCount > 0 || hasAsyncCommands {
        t.push(&lines, t.c5("InspectorBackend.register", domain.*.name, "Dispatcher = InspectorBackend.registerDispatcher.bind(InspectorBackend, \"", domain.*.name, "\");"))
    }
    t.push(&lines, t.c5("InspectorBackend.activateDomain(\"", domain.*.name, "\", ", domain.*.debuggableTypes, ");"))
    return m.guarded(domain.*.condition, t.joined(lines, "\n"))
}

// The text before the preprocessor.
pub fn generateUnprocessed(p: *m.Protocol) -> []const u8 {
    var sections = t.list()
    t.push(&sections, m.license(p))
    var index: usize = 0
    while index < p.*.domainCount {
        if m.generated(p, index) && shouldGenerate(p.*.domains[index]) { t.push(&sections, generateDomain(p.*.domains[index])) }
        index += 1
    }
    return t.joined(sections, "\n\n")
}

pub fn generate(p: *m.Protocol) -> []const u8 { return preprocess(generateUnprocessed(p), p.*.conditionFlags) }

// ---------------------------------------------------------------------------
// The preprocessor's part: #if lines over the macros FLAGS define.

var expression: [*]const u8 = undefined
var expressionLength: usize = 0
var expressionAt: usize = 0
var flagsText: [*]const u8 = undefined
var flagsLength: usize = 0

fn skipBlanks() -> void {
    while expressionAt < expressionLength && (expression[expressionAt] == 32 || expression[expressionAt] == 9) { expressionAt += 1 }
}

// The value of the macro NAME as FLAGS define it ("A" is 1, "A=2" is 2),
// or -1 when they do not: the flags with their quotes gone, split on
// whitespace (preprocess.pl's -D macros).
fn macroValue(name: []const u8) -> i64 {
    const flags = t.replaceAll(flagsText[0..flagsLength], "\"", "")
    var start: usize = 0
    var index: usize = 0
    while index <= flags.length {
        if index == flags.length || s.isSpace(flags[index]) {
            const word = flags[start..index]
            const equals = s.find(word, "=")
            if equals > 0 && s.same(word[0..equals], name) {
                if equals == word.length { return 1 }
                var value: i64 = 0
                for byte in word[equals + 1..word.length] {
                    if s.isDigit(byte) { value = value * 10 + @intCast(i64, byte - 48) }
                }
                return value
            }
            start = index + 1
        }
        index += 1
    }
    return -1
}

fn isDefined(name: []const u8) -> bool { return macroValue(name) >= 0 }

fn identifier() -> []const u8 {
    skipBlanks()
    const start = expressionAt
    while expressionAt < expressionLength && s.isWord(expression[expressionAt]) { expressionAt += 1 }
    return expression[start..expressionAt]
}

fn take(text: []const u8) -> bool {
    skipBlanks()
    if expressionAt + text.length <= expressionLength && s.same(expression[expressionAt..expressionAt + text.length], text) {
        expressionAt += text.length
        return true
    }
    return false
}

fn primary() -> i64 {
    if take("(") {
        const value = disjunction()
        if !take(")") { s.fail("preprocess: missing ')' in #if") }
        return value
    }
    const name = identifier()
    if name.length == 0 { s.fail("preprocess: bad #if expression") }
    if s.same(name, "defined") {
        const parenthesized = take("(")
        const macro = identifier()
        if parenthesized && !take(")") { s.fail("preprocess: missing ')' after defined") }
        return if isDefined(macro) { 1 } else { 0 }
    }
    if s.isDigit(name[0]) {
        var value: i64 = 0
        for byte in name {
            if s.isDigit(byte) { value = value * 10 + @intCast(i64, byte - 48) }
        }
        return value
    }
    const value = macroValue(name)
    return if value >= 0 { value } else { 0 }
}

fn unary() -> i64 {
    if take("!") { return if unary() == 0 { 1 } else { 0 } }
    return primary()
}

fn conjunction() -> i64 {
    var value = unary()
    while take("&&") {
        const right = unary()
        value = if value != 0 && right != 0 { 1 } else { 0 }
    }
    return value
}

fn disjunction() -> i64 {
    var value = conjunction()
    while take("||") {
        const right = conjunction()
        value = if value != 0 || right != 0 { 1 } else { 0 }
    }
    return value
}

fn holds(condition: []const u8) -> bool {
    expression = condition.pointer
    expressionLength = condition.length
    expressionAt = 0
    return disjunction() != 0
}

fn isBlank(line: []const u8) -> bool {
    for byte in line {
        if !s.isSpace(byte) { return false }
    }
    return true
}

pub fn preprocess(text: []const u8, flags: []const u8) -> []const u8 {
    flagsText = flags.pointer
    flagsLength = flags.length
    var result = t.list()
    // For each #if open, whether its lines are kept.
    var kept: [64]bool = undefined
    var depth: usize = 0
    var at: usize = 0
    while at < text.length {
        const line = s.nextLine(text, &at)
        const trimmed = s.trimStart(line)
        const active = depth == 0 || kept[depth - 1]
        if s.startsWith(trimmed, "#") {
            const directive = s.trimStart(trimmed[1..trimmed.length])
            if s.startsWith(directive, "if") && (directive.length == 2 || !s.isWord(directive[2])) {
                if depth == 64 { s.fail("preprocess: #if nested too deeply") }
                kept[depth] = active && holds(directive[2..directive.length])
                depth += 1
                continue
            }
            if s.startsWith(directive, "endif") {
                if depth == 0 { s.fail("preprocess: #endif without #if") }
                depth -= 1
                continue
            }
        }
        if !active || isBlank(line) { continue }
        if s.startsWith(line, "//") { t.push(&result, "\n") }
        t.push(&result, line)
        t.push(&result, "\n")
    }
    return t.joined(result, "")
}
