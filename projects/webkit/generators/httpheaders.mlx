// WebCore's names of HTTP headers (HTTPHeaderNames.gperf, HTTPHeaderNames.h
// and HTTPHeaderNames.serialization.in), made as
// platform/network/create-http-header-name-table (Python) makes them, from
// platform/network/HTTPHeaderNames.in, in OUTPUT_DIRECTORY:
//
//     webkit-http-header-names INPUT OUTPUT_DIRECTORY
//
// One name a line (empty lines and those starting "//" skipped), sorted;
// each one's enumerator is the name without its "-" and ".". The Python
// then runs gperf on the .gperf file; here that is a step of its own:
//
//     gperf --key-positions=* -D -n -s 2 HTTPHeaderNames.gperf --output-file=HTTPHeaderNames.cpp
//
// (run in OUTPUT_DIRECTORY).
const std = @import("std")
const s = @import("./support.mlx")
const n = @import("./namestext.mlx")

// Python's str.strip(): the space at both ends gone.
fn strip(text: []const u8) -> []const u8 {
    var start: usize = 0
    var end = text.length
    while start < end && (s.isSpace(text[start]) || (text[start] >= 28 && text[start] <= 31)) { start += 1 }
    while end > start && (s.isSpace(text[end - 1]) || (text[end - 1] >= 28 && text[end - 1] <= 31)) { end -= 1 }
    return text[start..end]
}

fn identifierOf(name: []const u8) -> []const u8 { return n.without(n.without(name, 45), 46) }

fn generate(inputPath: []const u8, outputDirectory: []const u8) -> void {
    const text = s.readWhole(inputPath)
    var names = n.list()
    var at: usize = 0
    while at < text.length {
        const name = strip(s.nextLine(text, &at))
        if name.length == 0 || std.text.startsWith(name, "//") { continue }
        n.push(&names, name)
    }
    n.sortList(&names)
    if names.count == 0 { s.fail("create-http-header-name-table: no header names") }

    n.o(GPERF_HEAD)
    var index: usize = 0
    while index < names.count {
        n.o3("    \"", names.items[index], "\"_s,\n")
        index += 1
    }
    n.o("};\n\n")
    n.o(GPERF_DECLARATIONS)
    index = 0
    while index < names.count {
        n.o3(names.items[index], ", HTTPHeaderName::", identifierOf(names.items[index]))
        n.o("\n")
        index += 1
    }
    n.o(GPERF_TAIL)
    n.save(n.path(outputDirectory, "HTTPHeaderNames.gperf"))

    n.o(HEADER_HEAD)
    var shortest = names.items[0].length
    var longest = names.items[0].length
    index = 0
    while index < names.count {
        n.o3("    ", identifierOf(names.items[index]), ",\n")
        if names.items[index].length < shortest { shortest = names.items[index].length }
        if names.items[index].length > longest { longest = names.items[index].length }
        index += 1
    }
    n.o("};\n\n")
    n.o("const unsigned numHTTPHeaderNames = ")
    n.on(@intCast(u64, names.count))
    n.o(";\nconst size_t minHTTPHeaderNameLength = ")
    n.on(@intCast(u64, shortest))
    n.o(";\nconst size_t maxHTTPHeaderNameLength = ")
    n.on(@intCast(u64, longest))
    n.o(";\n")
    n.o(HEADER_TAIL)
    n.save(n.path(outputDirectory, "HTTPHeaderNames.h"))

    n.o(SERIALIZATION_HEAD)
    index = 0
    while index < names.count {
        if index > 0 { n.o(",\n") }
        n.o("        ")
        n.o(identifierOf(names.items[index]))
        index += 1
    }
    n.o(SERIALIZATION_TAIL)
    n.save(n.path(outputDirectory, "HTTPHeaderNames.serialization.in"))
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("Usage: webkit-http-header-names INPUT_FILE OUTPUT_DIRECTORY\n")
        return 1
    }
    generate(s.cString(arguments[1]), s.cString(arguments[2]))
    return 0
}

