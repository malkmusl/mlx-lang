// The lexer's keyword matcher of JavaScriptCore (KeywordLookup.h), made
// as WebKit's KeywordLookupGenerator.py makes it, from the keywords of
// parser/Keywords.table:
//
//     webkit-keyword-lookup KEYWORDS OUTPUT
//
// The keywords make a trie, its chains of single children merged into
// one node, its children ordered by how often their keywords are seen
// (the script's table of weights, summed over a subtree, heaviest first,
// ties kept in the order the children were first met). The trie is
// written twice as nested ifs, for 16-bit and for Latin-1 characters.
const std = @import("std")
const s = @import("./support.mlx")

const MAX_NODES: usize = 4096
const MAX_CHILDREN: usize = 128

const Node = struct {
    prefix: []const u8
    // The token of the keyword ending here, when there is one.
    value: []const u8
    hasValue: bool
    children: [*]usize
    childCount: usize
    fullPrefix: []const u8
    weight: f64
}

var nodes: [*]Node = undefined
var nodeCount: usize = 0

fn newNode(prefix: []const u8) -> usize {
    if nodeCount == MAX_NODES { s.fail("KeywordLookupGenerator: too many nodes") }
    var children: [*]usize = undefined
    unsafe { children = @ptrFromInt([*]usize, s.alloc(MAX_CHILDREN * 8)) }
    nodes[nodeCount] = Node.{ .prefix = prefix, .value = "", .hasValue = false, .children = children, .childCount = 0, .fullPrefix = "", .weight = 0.0 }
    nodeCount += 1
    return nodeCount - 1
}

// The observed weights of the most common keywords, as the script has them.
fn keywordWeight(word: []const u8) -> f64 {
    if s.same(word, "catch") || s.same(word, "try") || s.same(word, "while") || s.same(word, "case") || s.same(word, "break") || s.same(word, "new") || s.same(word, "in") { return 0.01 }
    if s.same(word, "typeof") || s.same(word, "true") || s.same(word, "false") { return 0.02 }
    if s.same(word, "for") || s.same(word, "null") || s.same(word, "else") { return 0.03 }
    if s.same(word, "return") || s.same(word, "var") { return 0.13 }
    if s.same(word, "if") { return 0.16 }
    if s.same(word, "function") || s.same(word, "this") { return 0.18 }
    return -1.0
}

fn insert(node: usize, key: []const u8, value: []const u8) -> void {
    if key.length == 0 {
        nodes[node].value = value
        nodes[node].hasValue = true
        return
    }
    var child = MAX_NODES
    var index: usize = 0
    while index < nodes[node].childCount {
        const c = nodes[node].children[index]
        if nodes[c].prefix[0] == key[0] { child = c }
        index += 1
    }
    if child == MAX_NODES {
        if nodes[node].childCount == MAX_CHILDREN { s.fail("KeywordLookupGenerator: too many children") }
        child = newNode(key[0..1])
        nodes[node].children[nodes[node].childCount] = child
        nodes[node].childCount += 1
    }
    insert(child, key[1..key.length], value)
}

// The node standing for NODE once each lone child without a value of its
// own is merged into its parent.
fn coalesce(node: usize) -> usize {
    var index: usize = 0
    while index < nodes[node].childCount {
        nodes[node].children[index] = coalesce(nodes[node].children[index])
        index += 1
    }
    if nodes[node].hasValue || nodes[node].childCount != 1 { return node }
    const only = nodes[node].children[0]
    const merged = newNode(s.join(nodes[node].prefix, nodes[only].prefix))
    nodes[merged].value = nodes[only].value
    nodes[merged].hasValue = nodes[only].hasValue
    nodes[merged].children = nodes[only].children
    nodes[merged].childCount = nodes[only].childCount
    return merged
}

fn fillOut(node: usize, prefix: []const u8) -> void {
    const full = s.join(prefix, nodes[node].prefix)
    nodes[node].fullPrefix = full
    var weight: f64 = 0.0
    const own = keywordWeight(full)
    if own >= 0.0 { weight = weight + own }
    const count = nodes[node].childCount
    const children = nodes[node].children
    var index: usize = 0
    while index < count {
        fillOut(children[index], full)
        weight = weight + nodes[children[index]].weight
        index += 1
    }
    // Heaviest first; a stable sort, so equal weights keep their order.
    index = 1
    while index < count {
        const moving = children[index]
        var at = index
        while at > 0 && nodes[children[at - 1]].weight < nodes[moving].weight {
            children[at] = children[at - 1]
            at -= 1
        }
        children[at] = moving
        index += 1
    }
    nodes[node].weight = weight
}

fn maxLength(node: usize) -> usize {
    var longest = nodes[node].fullPrefix.length
    var index: usize = 0
    while index < nodes[node].childCount {
        const length = maxLength(nodes[node].children[index])
        if length > longest { longest = length }
        index += 1
    }
    return longest
}

fn pad(indent: usize) -> void {
    var index: usize = 0
    while index < indent {
        s.out(" ")
        index += 1
    }
}

fn printSubTree(node: usize, indent: usize) -> void {
    const full = nodes[node].fullPrefix
    if nodes[node].hasValue {
        pad(indent)
        s.out("if (cannotBeIdentPartOrEscapeStart(code[")
        s.outUnsigned(@intCast(u64, full.length))
        s.out("])) [[likely]] {\n")
        pad(indent)
        s.out("    internalShift<")
        s.outUnsigned(@intCast(u64, full.length))
        s.out(">();\n")
        pad(indent)
        s.out("    if (shouldCreateIdentifier)\n")
        pad(indent)
        s.out("        data->ident = &m_vm.propertyNames->")
        s.out(full)
        s.out("Keyword;\n")
        pad(indent)
        s.out("    return ")
        s.out(nodes[node].value)
        s.out(";\n")
        pad(indent)
        s.out("}\n")
    }
    const rootIndex = full.length
    const count = nodes[node].childCount
    var index: usize = 0
    while index < count {
        const child = nodes[node].children[index]
        var k = nodes[child].prefix
        var baseIndex = rootIndex
        // As the script does: a three-letter step below the root is
        // compared from one character earlier.
        if baseIndex > 0 && k.length == 3 {
            baseIndex -= 1
            k = s.join(nodes[child].fullPrefix[baseIndex..baseIndex + 1], k)
        }
        pad(indent)
        s.out(if index == 0 { "if (" } else { "} else if (" })
        if k.length == 1 {
            s.out("code[")
            s.outUnsigned(@intCast(u64, baseIndex))
            s.out("] == '")
            s.out(k)
            s.out("'")
        } else {
            s.out("compareCharacters(code")
            if baseIndex > 0 {
                s.out(" + ")
                s.outUnsigned(@intCast(u64, baseIndex))
            }
            var at: usize = 0
            while at < k.length {
                s.out(", '")
                s.out(k[at..at + 1])
                s.out("'")
                at += 1
            }
            s.out(")")
        }
        s.out(") {\n")
        printSubTree(child, indent + 4)
        index += 1
        if index == count {
            pad(indent)
            s.out("}\n")
        }
    }
}

fn printFunction(characterType: []const u8, root: usize) -> void {
    s.out("template <>\n")
    s.out("template <bool shouldCreateIdentifier> ALWAYS_INLINE JSTokenType Lexer<")
    s.out(characterType)
    s.out(">::parseKeyword(JSTokenData* data)\n")
    s.out("{\n")
    s.out("    ASSERT(m_codeEnd - m_code >= maxTokenLength);\n")
    s.out("\n")
    s.out("    const ")
    s.out(characterType)
    s.out("* code = m_code;\n")
    printSubTree(root, 4)
    s.out("    return IDENT;\n")
    s.out("}\n")
}

// ---------------------------------------------------------------------------
// The keywords.

// Space as Python's string.whitespace.
fn isWhite(byte: u8) -> bool { return byte == 32 || (byte >= 9 && byte <= 13) }

fn allWhite(text: []const u8) -> bool {
    for byte in text {
        if !isWhite(byte) { return false }
    }
    return true
}

// The words of LINE (Python's split()), at most MAX of them into WORDS.
fn split(line: []const u8, words: *[4][]const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < line.length {
        while at < line.length && isWhite(line[at]) { at += 1 }
        if at == line.length { break }
        const start = at
        while at < line.length && !isWhite(line[at]) { at += 1 }
        if count < 4 { words.*[count] = line[start..at] }
        count += 1
    }
    return count
}

fn generate(keywordsPath: []const u8, outputPath: []const u8) -> void {
    unsafe { nodes = @ptrFromInt([*]Node, s.alloc(MAX_NODES * @sizeOf(Node))) }
    const text = s.readWhole(keywordsPath)
    // The lines that are not blank once their comments are cut off.
    var lines: [*][]const u8 = undefined
    unsafe { lines = @ptrFromInt([*][]const u8, s.alloc((text.length + 1) * 16)) }
    var lineCount: usize = 0
    var at: usize = 0
    while true {
        const start = at
        while at < text.length && text[at] != 10 { at += 1 }
        var line = text[start..at]
        var cut: usize = 0
        while cut < line.length && line[cut] != 35 { cut += 1 }
        line = line[0..cut]
        if !allWhite(line) {
            lines[lineCount] = line
            lineCount += 1
        }
        if at == text.length { break }
        at += 1
    }
    var words: [4][]const u8 = undefined
    if lineCount == 0 || split(lines[0], &words) == 0 || !s.same(words[0], "@begin") { s.fail("KeywordLookupGenerator: expected description beginning with @begin") }
    if !s.same(lines[lineCount - 1], "@end") { s.fail("KeywordLookupGenerator: expected description ending with @end") }
    const root = newNode("")
    var index: usize = 1
    while index + 1 < lineCount {
        if split(lines[index], &words) != 2 { s.fail(s.join("KeywordLookupGenerator: not KEYWORD TOKEN: ", lines[index])) }
        insert(root, words[0], words[1])
        index += 1
    }
    const ignored = coalesce(root)
    fillOut(root, "")

    s.out("// This file was generated by KeywordLookupGenerator.py.  Do not edit.\n")
    s.out("\n#include <wtf/StdLibExtras.h>\n#include <wtf/text/FastCharacterComparison.h>\n\n\n")
    s.out("WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN\n")
    s.out("\n")
    s.out("namespace JSC {\n")
    s.out("\n")
    s.out("static ALWAYS_INLINE bool cannotBeIdentPartOrEscapeStart(Latin1Character);\n")
    s.out("static ALWAYS_INLINE bool cannotBeIdentPartOrEscapeStart(char16_t);\n")
    // One past the longest keyword, so the matcher never checks bounds.
    s.out("static constexpr int maxTokenLength = ")
    s.outUnsigned(@intCast(u64, maxLength(root) + 1))
    s.out(";\n")
    s.out("\n")
    printFunction("char16_t", root)
    s.out("\n")
    printFunction("Latin1Character", root)
    s.out("\n")
    s.out("} // namespace JSC\n")
    s.out("\n")
    s.out("WTF_ALLOW_UNSAFE_BUFFER_USAGE_END\n")
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-keyword-lookup KEYWORDS OUTPUT\n")
        return 2
    }
    generate(s.cString(arguments[1]), s.cString(arguments[2]))
    return 0
}
