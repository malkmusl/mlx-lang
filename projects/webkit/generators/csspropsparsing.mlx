// process-css-properties.py's GenerateCSSPropertyParsing
// (CSSPropertyParsing.h and .cpp): from each property's grammar, a consume
// function built by the script's term generators (lambdas for groupings,
// repetitions and functions, switches over keywords, calls to the
// builtin consumers), the keyword-only fast path predicates, and the
// parse functions dispatching on the property ID for each set of
// properties and descriptors.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")
const g = @import("./csspropsterms.mlx")
const m = @import("./csspropsmodel.mlx")
const x = @import("./csspropsgen.mlx")

// ---------------------------------------------------------------------------
// KeywordFastPathGenerator.

const Fast = struct {
    name: []const u8
    keywords: g.Refs
    requiresState: bool
}

fn newFast(name: []const u8, keywords: g.Refs) -> *Fast {
    const fast: *Fast = unsafe { @ptrFromInt(*Fast, s.alloc(@sizeOf(Fast))) }
    fast.*.name = name
    fast.*.keywords = keywords
    fast.*.requiresState = false
    var index: usize = 0
    while index < keywords.count {
        if g.requiresState(g.termAt(keywords, index)) { fast.*.requiresState = true }
        index += 1
    }
    return fast
}

fn valueId(name: []const u8) -> []const u8 { return s.join("CSSValueID::CSSValue", g.nameToId(name)) }

// Lists of strings compared as Python compares lists.
fn listBefore(a: t.List, b: t.List) -> bool {
    var index: usize = 0
    while index < a.count && index < b.count {
        if !std.text.same(a.items[index], b.items[index]) { return t.before(a.items[index], b.items[index]) }
        index += 1
    }
    return a.count < b.count
}

fn listSame(a: t.List, b: t.List) -> bool {
    if a.count != b.count { return false }
    var index: usize = 0
    while index < a.count {
        if !std.text.same(a.items[index], b.items[index]) { return false }
        index += 1
    }
    return true
}

// Keyword terms with their (conditions, return value), for grouping.
const Keyed = struct {
    term: *g.Term
    conditions: t.List
    value: []const u8
}

fn keyedBefore(a: Keyed, b: Keyed) -> bool {
    if !listSame(a.conditions, b.conditions) { return listBefore(a.conditions, b.conditions) }
    return t.before(a.value, b.value)
}

fn keyedSame(a: Keyed, b: Keyed) -> bool { return listSame(a.conditions, b.conditions) && std.text.same(a.value, b.value) }

// Stably sorted.
fn sortKeyed(items: [*]Keyed, count: usize) -> void {
    var index: usize = 1
    while index < count {
        const item = items[index]
        var at = index
        while at > 0 && keyedBefore(item, items[at - 1]) {
            items[at] = items[at - 1]
            at -= 1
        }
        items[at] = item
        index += 1
    }
}

fn newKeyed(count: usize) -> [*]Keyed { return unsafe { @ptrFromInt([*]Keyed, s.alloc((count + 1) * @sizeOf(Keyed))) } }

fn fastSignatureParameters(fast: *Fast) -> []const u8 {
    if fast.*.requiresState { return "CSSValueID keyword, CSS::PropertyParserState& state" }
    return "CSSValueID keyword"
}

fn fastCall(fast: *Fast, keyword: []const u8, state: []const u8) -> []const u8 {
    if fast.*.requiresState { return t.c6(fast.*.name, "(", keyword, ", ", state, ")") }
    return t.c4(fast.*.name, "(", keyword, ")")
}

fn fastDefinition(w: *c.Writer, fast: *Fast) -> void {
    c.write(w, t.c5("static bool ", fast.*.name, "(", fastSignatureParameters(fast), ")"))
    c.write(w, "{")
    c.indent(w)
    const count = fast.*.keywords.count
    const items = newKeyed(count)
    var index: usize = 0
    while index < count {
        const term = g.termAt(fast.*.keywords, index)
        var conditions = t.list()
        if term.*.settingsFlag.length > 0 {
            if s.startsWith(term.*.settingsFlag, "DeprecatedGlobalSettings::") {
                t.push(&conditions, term.*.settingsFlag)
            } else {
                t.push(&conditions, s.join("state.context.", term.*.settingsFlag))
            }
        }
        if std.text.same(term.*.status, "internal") { t.push(&conditions, "isUASheetBehavior(state.context.mode)") }
        items[index] = Keyed.{ .term = term, .conditions = conditions, .value = "" }
        index += 1
    }
    sortKeyed(items, count)
    c.write(w, "switch (keyword) {")
    index = 0
    while index < count {
        var end = index
        while end < count && keyedSame(items[end], items[index]) {
            c.write(w, t.c3("case ", valueId(items[end].term.*.name), ":"))
            end += 1
        }
        c.indent(w)
        const conditions = items[index].conditions
        c.write(w, t.c3("return ", if conditions.count == 0 { "true" } else { t.joined(conditions, " && ") }, ";"))
        c.outdent(w)
        index = end
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return false;")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

// ---------------------------------------------------------------------------
// The term generators.

const G_OPTIONAL: u8 = 1
const G_FUNCTION: u8 = 2
const G_LITERAL: u8 = 3
const G_UNBOUNDED: u8 = 4
const G_BOUNDED: u8 = 5
const G_MATCH_ONE: u8 = 6
const G_ALL_ORDERED: u8 = 7
const G_ALL_ANY_ORDER: u8 = 8
const G_ONE_OR_MORE: u8 = 9
const G_REFERENCE: u8 = 10
const G_KEYWORDS: u8 = 11
const G_FAST_KEYWORDS: u8 = 12

const Gen = struct {
    kind: u8
    term: *g.Term
    subs: g.Refs
    sub: ?*Gen
    keywords: g.Refs
    fast: ?*Fast
    requiresState: bool
}

fn genAt(l: g.Refs, index: usize) -> *Gen { return unsafe { @ptrFromInt(*Gen, l.items[index]) } }

fn newGen(kind: u8, term: *g.Term) -> *Gen {
    const gen: *Gen = unsafe { @ptrFromInt(*Gen, s.alloc(@sizeOf(Gen))) }
    gen.*.kind = kind
    gen.*.term = term
    gen.*.subs = g.refs()
    gen.*.sub = null
    gen.*.keywords = g.refs()
    gen.*.fast = null
    gen.*.requiresState = false
    return gen
}

fn anyRequiresState(gens: g.Refs) -> bool {
    var index: usize = 0
    while index < gens.count {
        if genAt(gens, index).*.requiresState { return true }
        index += 1
    }
    return false
}

fn keywordsGen(keywords: g.Refs) -> *Gen {
    const gen = newGen(G_KEYWORDS, g.termAt(keywords, 0))
    gen.*.keywords = keywords
    var index: usize = 0
    while index < keywords.count {
        if g.requiresState(g.termAt(keywords, index)) { gen.*.requiresState = true }
        index += 1
    }
    return gen
}

fn fastKeywordsGen(fast: *Fast) -> *Gen {
    const gen = newGen(G_FAST_KEYWORDS, g.termAt(fast.*.keywords, 0))
    gen.*.fast = fast
    gen.*.keywords = fast.*.keywords
    gen.*.requiresState = fast.*.requiresState
    return gen
}

// The builtin's kind of consumer: whether it requires the state.
fn referenceRequiresState(term: *g.Term) -> bool {
    if term.*.overrideFunction.length > 0 { return true }
    if term.*.builtin == null { return true }
    const name = term.*.builtin.?.*.entry
    if std.text.same(name, "string") || std.text.same(name, "unicode-range-token") { return false }
    return true
}

fn makeGen(term: *g.Term, fast: ?*Fast) -> *Gen {
    const kind = term.*.kind
    if kind == g.K_MATCH_ONE {
        const gen = newGen(G_MATCH_ONE, term)
        var fastTerms = g.refs()
        var keywords = g.refs()
        var references = g.refs()
        var functions = g.refs()
        var unbounded = g.refs()
        var bounded = g.refs()
        var oneOrMore = g.refs()
        var allOrdered = g.refs()
        var allAnyOrder = g.refs()
        var index: usize = 0
        while index < term.*.subterms.count {
            const subterm = g.termAt(term.*.subterms, index)
            const address = term.*.subterms.items[index]
            const subkind = subterm.*.kind
            if subkind == g.K_KEYWORD {
                if fast != null && g.isFastPathKeyword(subterm) {
                    g.push(&fastTerms, address)
                } else {
                    g.push(&keywords, address)
                }
            } else if subkind == g.K_REFERENCE {
                g.push(&references, address)
            } else if subkind == g.K_FUNCTION {
                g.push(&functions, address)
            } else if subkind == g.K_UNBOUNDED_REPETITION {
                g.push(&unbounded, address)
            } else if subkind == g.K_BOUNDED_REPETITION {
                g.push(&bounded, address)
            } else if subkind == g.K_MATCH_ONE_OR_MORE_ANY_ORDER {
                g.push(&oneOrMore, address)
            } else if subkind == g.K_MATCH_ALL_ORDERED {
                g.push(&allOrdered, address)
            } else if subkind == g.K_MATCH_ALL_ANY_ORDER {
                g.push(&allAnyOrder, address)
            } else {
                s.fail(t.c5("Unsupported term '", g.str(subterm), "' used inside MatchOneTerm '", g.str(term), "'"))
            }
            index += 1
        }
        if fastTerms.count > 0 { g.push(&gen.*.subs, @intFromPtr(fastKeywordsGen(fast.?))) }
        if keywords.count > 0 { g.push(&gen.*.subs, @intFromPtr(keywordsGen(keywords))) }
        const groups = [_]*g.Refs{ &references, &functions, &unbounded, &bounded, &oneOrMore, &allOrdered, &allAnyOrder }
        for group in groups {
            var at: usize = 0
            while at < group.*.count {
                g.push(&gen.*.subs, @intFromPtr(makeGen(g.termAt(group.*, at), null)))
                at += 1
            }
        }
        gen.*.requiresState = term.*.settingsFlag.length > 0 || anyRequiresState(gen.*.subs)
        return gen
    }
    if kind == g.K_MATCH_ONE_OR_MORE_ANY_ORDER || kind == g.K_MATCH_ALL_ORDERED || kind == g.K_MATCH_ALL_ANY_ORDER {
        var genKind = G_ONE_OR_MORE
        if kind == g.K_MATCH_ALL_ORDERED { genKind = G_ALL_ORDERED }
        if kind == g.K_MATCH_ALL_ANY_ORDER { genKind = G_ALL_ANY_ORDER }
        const gen = newGen(genKind, term)
        var index: usize = 0
        while index < term.*.subterms.count {
            g.push(&gen.*.subs, @intFromPtr(makeGen(g.termAt(term.*.subterms, index), null)))
            index += 1
        }
        gen.*.requiresState = anyRequiresState(gen.*.subs)
        return gen
    }
    if kind == g.K_OPTIONAL || kind == g.K_UNBOUNDED_REPETITION || kind == g.K_BOUNDED_REPETITION || kind == g.K_FUNCTION {
        var genKind = G_OPTIONAL
        if kind == g.K_UNBOUNDED_REPETITION { genKind = G_UNBOUNDED }
        if kind == g.K_BOUNDED_REPETITION { genKind = G_BOUNDED }
        if kind == g.K_FUNCTION { genKind = G_FUNCTION }
        const gen = newGen(genKind, term)
        gen.*.sub = makeGen(term.*.sub.?, null)
        gen.*.requiresState = gen.*.sub.?.*.requiresState
        return gen
    }
    if kind == g.K_REFERENCE {
        const gen = newGen(G_REFERENCE, term)
        gen.*.requiresState = referenceRequiresState(term)
        return gen
    }
    if kind == g.K_LITERAL { s.fail(s.join("A literal term cannot be generated: ", g.str(term))) }
    var one = g.refs()
    g.push(&one, @intFromPtr(term))
    return keywordsGen(one)
}

fn joinedTerms(terms: g.Refs) -> []const u8 {
    var parts = t.list()
    var index: usize = 0
    while index < terms.count {
        t.push(&parts, g.str(g.termAt(terms, index)))
        index += 1
    }
    return t.joined(parts, " | ")
}

fn genStr(gen: *Gen) -> []const u8 {
    if gen.*.kind == G_KEYWORDS || gen.*.kind == G_FAST_KEYWORDS { return joinedTerms(gen.*.keywords) }
    return g.str(gen.*.term)
}

fn producesGroup(gen: *Gen) -> bool {
    const kind = gen.*.kind
    if kind == G_OPTIONAL { return producesGroup(gen.*.sub.?) }
    return kind == G_UNBOUNDED || kind == G_BOUNDED || kind == G_ALL_ORDERED || kind == G_ALL_ANY_ORDER || kind == G_ONE_OR_MORE
}

// The names the kinds of lambdas are called by.
fn lambdaName(gen: *Gen) -> []const u8 {
    const kind = gen.*.kind
    if kind == G_UNBOUNDED { return "consumeUnboundedRepetition" }
    if kind == G_BOUNDED { return "consumeBoundedRepetition" }
    if kind == G_ALL_ORDERED { return "consumeMatchAllOrdered" }
    if kind == G_ALL_ANY_ORDER { return "consumeMatchAllAnyOrder" }
    if kind == G_ONE_OR_MORE { return "consumeMatchOneOrMoreAnyOrder" }
    return t.c3("consume", g.nameToId(gen.*.term.*.name), "Function")
}

fn rangeParameters(requiresState: bool) -> []const u8 {
    if requiresState { return "CSSParserTokenRange& range, CSS::PropertyParserState& state" }
    return "CSSParserTokenRange& range"
}

fn callArguments(requiresState: bool, range: []const u8, state: []const u8) -> []const u8 {
    if requiresState { return t.c3(range, ", ", state) }
    return range
}

// The lambda's call for the lambda kinds.
fn lambdaCall(gen: *Gen, range: []const u8, state: []const u8) -> []const u8 {
    return t.c4(lambdaName(gen), "(", callArguments(gen.*.requiresState, range, state), ")")
}

fn settingsFlagCheck(w: *c.Writer, flag: []const u8) -> void {
    if flag.length == 0 { return }
    c.write(w, t.c3("if (!state.context.", flag, ")"))
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
}

fn writeReturnResult(w: *c.Writer, call: []const u8) -> void {
    c.write(w, t.c3("if (auto result = ", call, ")"))
    c.indent(w)
    c.write(w, "return result;")
    c.outdent(w)
}

fn genConditional(w: *c.Writer, gen: *Gen, range: []const u8, state: []const u8) -> void {
    const kind = gen.*.kind
    if kind == G_OPTIONAL { return genConditional(w, gen.*.sub.?, range, state) }
    if kind == G_MATCH_ONE {
        if gen.*.term.*.settingsFlag.length > 0 {
            c.write(w, t.c5("if (!", state, ".context.", gen.*.term.*.settingsFlag, ")"))
            c.indent(w)
            c.write(w, "return { };")
            c.outdent(w)
        }
        var index: usize = 0
        while index < gen.*.subs.count {
            genConditional(w, genAt(gen.*.subs, index), range, state)
            index += 1
        }
        return
    }
    if kind == G_REFERENCE {
        c.write(w, s.join("// ", genStr(gen)))
        if gen.*.term.*.settingsFlag.length > 0 { referenceLambda(w, gen) }
        writeReturnResult(w, referenceCall(gen, range, state))
        return
    }
    if kind == G_KEYWORDS {
        c.write(w, s.join("// ", genStr(gen)))
        keywordSwitch(w, gen, range, state, "break")
        return
    }
    if kind == G_FAST_KEYWORDS {
        c.write(w, s.join("// ", genStr(gen)))
        writeReturnResult(w, fastKeywordsCall(gen, range, state))
        return
    }
    if kind == G_LITERAL { return }
    c.write(w, s.join("// ", genStr(gen)))
    lambda(w, gen)
    writeReturnResult(w, lambdaCall(gen, range, state))
}

fn genUnconditional(w: *c.Writer, gen: *Gen, range: []const u8, state: []const u8) -> void {
    const kind = gen.*.kind
    if kind == G_OPTIONAL { return genUnconditional(w, gen.*.sub.?, range, state) }
    if kind == G_MATCH_ONE {
        if gen.*.term.*.settingsFlag.length > 0 {
            c.write(w, t.c5("if (!", state, ".context.", gen.*.term.*.settingsFlag, ")"))
            c.indent(w)
            c.write(w, "return { };")
            c.outdent(w)
        }
        var index: usize = 0
        while index + 1 < gen.*.subs.count {
            genConditional(w, genAt(gen.*.subs, index), range, state)
            index += 1
        }
        genUnconditional(w, genAt(gen.*.subs, gen.*.subs.count - 1), range, state)
        return
    }
    if kind == G_REFERENCE {
        c.write(w, s.join("// ", genStr(gen)))
        if gen.*.term.*.settingsFlag.length > 0 { referenceLambda(w, gen) }
        c.write(w, t.c3("return ", referenceCall(gen, range, state), ";"))
        return
    }
    if kind == G_KEYWORDS {
        c.write(w, s.join("// ", genStr(gen)))
        keywordSwitch(w, gen, range, state, "return nullptr")
        return
    }
    if kind == G_FAST_KEYWORDS {
        c.write(w, s.join("// ", genStr(gen)))
        c.write(w, t.c3("return ", fastKeywordsCall(gen, range, state), ";"))
        return
    }
    if kind == G_LITERAL { return }
    c.write(w, s.join("// ", genStr(gen)))
    lambda(w, gen)
    c.write(w, t.c3("return ", lambdaCall(gen, range, state), ";"))
}

fn genIntoBuilder(w: *c.Writer, gen: *Gen, range: []const u8, state: []const u8) -> void {
    const kind = gen.*.kind
    if !(kind == G_UNBOUNDED || kind == G_BOUNDED || kind == G_ALL_ORDERED || kind == G_ALL_ANY_ORDER || kind == G_ONE_OR_MORE) { s.fail(s.join("No generation into a builder for ", genStr(gen))) }
    c.write(w, s.join("// ", genStr(gen)))
    lambdaIntoBuilder(w, gen)
    c.write(w, t.c3("return ", lambdaCall(gen, range, state), ";"))
}

// ---------------------------------------------------------------------------
// References.

fn referenceCall(gen: *Gen, range: []const u8, state: []const u8) -> []const u8 {
    const term = gen.*.term
    if term.*.settingsFlag.length > 0 { return t.c7("consume", g.nameToId(term.*.name), "Reference(", range, ", ", state, ")") }
    return referenceCallDirect(gen, range, state)
}

fn referenceCallDirect(gen: *Gen, range: []const u8, state: []const u8) -> []const u8 {
    const term = gen.*.term
    const rs = t.c3(range, ", ", state)
    if term.*.overrideFunction.length > 0 { return t.c4(term.*.overrideFunction, "(", rs, ")") }
    if term.*.builtin == null { return t.c5("consume", g.nameToId(term.*.name), "(", rs, ")") }
    const builtin = term.*.builtin.?
    const name = builtin.*.entry
    if std.text.same(name, "angle") { return t.c7("CSSPrimitiveValueResolver<CSS::Angle<", g.builtinValue(builtin, "value-range"), ">>::consumeAndResolve(", rs, ", { .unitlessZeroAngle = ", g.builtinValue(builtin, "unitless-zero"), " })") }
    if std.text.same(name, "time") { return t.c5("CSSPrimitiveValueResolver<CSS::Time<", g.builtinValue(builtin, "value-range"), ">>::consumeAndResolve(", rs, ")") }
    if std.text.same(name, "length") { return t.c7("CSSPrimitiveValueResolver<CSS::Length<", g.builtinValue(builtin, "value-range"), ">>::consumeAndResolve(", rs, ", { .unitlessZeroLength = ", g.builtinValue(builtin, "unitless-zero"), " })") }
    if std.text.same(name, "length-percentage") { return t.c9("CSSPrimitiveValueResolver<CSS::LengthPercentage<", g.builtinValue(builtin, "value-range"), ">>::consumeAndResolve(", rs, ", { .anchorPolicy = ", g.builtinValue(builtin, "anchor"), ", .anchorSizePolicy = ", g.builtinValue(builtin, "anchor-size"), t.c3(", .unitlessZeroLength = ", g.builtinValue(builtin, "unitless-zero"), " })")) }
    if std.text.same(name, "integer") { return t.c5("CSSPrimitiveValueResolver<CSS::Integer<", g.builtinValue(builtin, "value-range"), ">>::consumeAndResolve(", rs, ")") }
    if std.text.same(name, "number") { return t.c5("CSSPrimitiveValueResolver<CSS::Number<", g.builtinValue(builtin, "value-range"), ">>::consumeAndResolve(", rs, ")") }
    if std.text.same(name, "percentage") { return t.c5("CSSPrimitiveValueResolver<CSS::Percentage<", g.builtinValue(builtin, "value-range"), ">>::consumeAndResolve(", rs, ")") }
    if std.text.same(name, "number-or-percentage-resolved-to-number") { return t.c3("consumePercentageDividedBy100OrNumber(", rs, ")") }
    if std.text.same(name, "position") { return t.c3("consumePosition(", rs, ")") }
    if std.text.same(name, "color") {
        const types = g.builtinValue(builtin, "allowed-types")
        if truthy(types) { return t.c5("consumeColor(", rs, ", { .allowedColorTypes = { ", types, " } })") }
        return t.c3("consumeColor(", rs, ", { .allowedColorTypes = { } })")
    }
    if std.text.same(name, "image") {
        const types = g.builtinValue(builtin, "allowed-types")
        if truthy(types) { return t.c5("consumeImage(", rs, ", { ", types, " })") }
        return t.c3("consumeImage(", rs, ", { })")
    }
    if std.text.same(name, "custom-ident") {
        const excluding = g.builtinValue(builtin, "excluding")
        if truthy(excluding) {
            const ids = c.splitByte(excluding, 32)
            var parts = t.list()
            var index: usize = 0
            while index < ids.count {
                t.push(&parts, valueId(ids.items[index]))
                index += 1
            }
            return t.c5("consumeCustomIdentExcluding(", rs, ", { ", t.joined(parts, ", "), " })")
        }
        return t.c3("consumeCustomIdent(", rs, ")")
    }
    if std.text.same(name, "url") {
        const modifiers = g.builtinValue(builtin, "allowed-modifiers")
        if truthy(modifiers) { return t.c5("consumeURL(", rs, ", { ", modifiers, " })") }
        return t.c3("consumeURL(", rs, ", { })")
    }
    if gen.*.requiresState { return t.c5("consume", g.nameToId(term.*.name), "(", rs, ")") }
    return t.c5("consume", g.nameToId(term.*.name), "(", range, ")")
}

fn truthy(text: []const u8) -> bool { return text.length > 0 && !g.isNone(text) }

fn referenceLambda(w: *c.Writer, gen: *Gen) -> void {
    const term = gen.*.term
    c.write(w, t.c3("auto consume", g.nameToId(term.*.name), "Reference = [](CSSParserTokenRange& range, CSS::PropertyParserState& state) -> RefPtr<CSSValue> {"))
    c.indent(w)
    settingsFlagCheck(w, term.*.settingsFlag)
    c.write(w, t.c3("return ", referenceCallDirect(gen, "range", "state"), ";"))
    c.outdent(w)
    c.write(w, "};")
}

// ---------------------------------------------------------------------------
// Keywords.

fn keywordSwitch(w: *c.Writer, gen: *Gen, range: []const u8, state: []const u8, otherwise: []const u8) -> void {
    const count = gen.*.keywords.count
    const items = newKeyed(count)
    var index: usize = 0
    while index < count {
        const term = g.termAt(gen.*.keywords, index)
        var conditions = t.list()
        if term.*.settingsFlag.length > 0 {
            if s.startsWith(term.*.settingsFlag, "DeprecatedGlobalSettings::") {
                t.push(&conditions, s.join("!", term.*.settingsFlag))
            } else {
                t.push(&conditions, t.c4("!", state, ".context.", term.*.settingsFlag))
            }
        }
        if std.text.same(term.*.status, "internal") { t.push(&conditions, t.c3("!isUASheetBehavior(", state, ".context.mode)")) }
        const value = if term.*.aliasedTo.length > 0 { valueId(term.*.aliasedTo) } else { "keyword" }
        items[index] = Keyed.{ .term = term, .conditions = conditions, .value = value }
        index += 1
    }
    sortKeyed(items, count)
    c.write(w, t.c3("switch (auto keyword = ", range, ".peek().id(); keyword) {"))
    index = 0
    while index < count {
        var end = index
        while end < count && keyedSame(items[end], items[index]) {
            c.write(w, t.c3("case ", valueId(items[end].term.*.name), ":"))
            end += 1
        }
        c.indent(w)
        const conditions = items[index].conditions
        if conditions.count > 0 {
            c.write(w, t.c3("if (", t.joined(conditions, " || "), ")"))
            c.indent(w)
            c.write(w, s.join(otherwise, ";"))
            c.outdent(w)
        }
        c.write(w, s.join(range, ".consumeIncludingWhitespace();"))
        c.write(w, t.c3("return CSSKeywordValue::create(CSS::Keyword { ", items[index].value, " });"))
        c.outdent(w)
        index = end
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, s.join(otherwise, ";"))
    c.outdent(w)
    c.write(w, "}")
}

fn fastKeywordsCall(gen: *Gen, range: []const u8, state: []const u8) -> []const u8 {
    const fast = gen.*.fast.?
    if gen.*.requiresState { return t.c7("consumeIdent(", range, ", ", fast.*.name, ", ", state, ")") }
    return t.c5("consumeIdent(", range, ", ", fast.*.name, ")")
}

// ---------------------------------------------------------------------------
// Lambdas.

fn repeatedTermLambda(w: *c.Writer, gen: *Gen) -> void {
    const repeated = gen.*.sub.?
    c.write(w, t.c3("auto consumeRepeatedTerm = [](", rangeParameters(repeated.*.requiresState), ") -> RefPtr<CSSValue> {"))
    c.indent(w)
    genUnconditional(w, repeated, "range", "state")
    c.outdent(w)
    c.write(w, "};")
}

fn listParameters(gen: *Gen) -> []const u8 {
    if gen.*.sub.?.*.requiresState { return "range, consumeRepeatedTerm, state" }
    return "range, consumeRepeatedTerm"
}

fn separatorText(term: *g.Term) -> []const u8 { return if term.*.separator == 44 { "," } else { " " } }

fn optimizationFor(term: *g.Term) -> []const u8 {
    if term.*.min <= 1 && term.*.singleValueOptimization { return "SingleValue" }
    return "None"
}

fn isOptionalGen(gen: *Gen) -> bool { return gen.*.kind == G_OPTIONAL }

fn subtermLambdas(w: *c.Writer, gen: *Gen) -> void {
    var index: usize = 0
    while index < gen.*.subs.count {
        const sub = genAt(gen.*.subs, index)
        c.write(w, t.c5("auto consumeTerm", s.decimal(index), " = [](", rangeParameters(sub.*.requiresState), ") -> RefPtr<CSSValue> {"))
        c.indent(w)
        genUnconditional(w, sub, "range", "state")
        c.outdent(w)
        c.write(w, "};")
        index += 1
    }
}

fn countOptional(gen: *Gen) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < gen.*.subs.count {
        if isOptionalGen(genAt(gen.*.subs, index)) { count += 1 }
        index += 1
    }
    return count
}

// The creations by list size of a non-CSSValueList grouping.
fn sizedReturns(w: *c.Writer, create: []const u8, minValues: usize, maxValues: usize, singleValueOptimization: bool) -> void {
    var strings = t.list()
    var index: usize = 0
    while index + 1 < minValues {
        t.push(&strings, t.c3("WTF::move(list[", s.decimal(index), "])"))
        index += 1
    }
    // range(min_values - 1, max_values - 1); min_values - 1 may be -1.
    var at: i64 = @intCast(i64, minValues) - 1
    while at < @intCast(i64, maxValues) - 1 {
        const listIndex = at
        t.push(&strings, t.c3("WTF::move(list[", s.signedDecimal(listIndex), "])"))
        c.write(w, t.c3("if (list.size() == ", s.signedDecimal(listIndex + 1), ")"))
        c.indent(w)
        if listIndex == 0 && singleValueOptimization {
            c.write(w, "return WTF::move(list[0]); // single item optimization")
        } else {
            c.write(w, t.c4("return ", create, t.c3("(", t.joined(strings, ", "), ")"), ";"))
        }
        c.outdent(w)
        at += 1
    }
    t.push(&strings, t.c3("WTF::move(list[", s.signedDecimal(@intCast(i64, maxValues) - 1), "])"))
    c.write(w, t.c4("return ", create, t.c3("(", t.joined(strings, ", "), ")"), ";"))
}

fn lambda(w: *c.Writer, gen: *Gen) -> void {
    const kind = gen.*.kind
    const term = gen.*.term
    if kind == G_FUNCTION { return functionLambda(w, gen) }
    if kind == G_UNBOUNDED {
        c.write(w, t.c3("auto consumeUnboundedRepetition = [](", rangeParameters(gen.*.sub.?.*.requiresState), ") -> RefPtr<CSSValue> {"))
        c.indent(w)
        settingsFlagCheck(w, term.*.settingsFlag)
        repeatedTermLambda(w, gen)
        c.write(w, t.c9("return consumeListSeparatedBy<'", separatorText(term), "', ListBounds::minimumOf(", s.signedDecimal(term.*.min), "), ListOptimization::", optimizationFor(term), ", ", term.*.valueType, t.c3(">(", listParameters(gen), ");")))
        c.outdent(w)
        c.write(w, "};")
        return
    }
    if kind == G_BOUNDED {
        c.write(w, t.c3("auto consumeBoundedRepetition = [](", rangeParameters(gen.*.sub.?.*.requiresState), ") -> RefPtr<CSSValue> {"))
        c.indent(w)
        settingsFlagCheck(w, term.*.settingsFlag)
        repeatedTermLambda(w, gen)
        if !std.text.same(term.*.valueType, "CSSValueList") {
            const callArgs = if gen.*.sub.?.*.requiresState { "rangeCopy, state" } else { "rangeCopy" }
            c.write(w, "CSSParserTokenRange rangeCopy = range;")
            var terms = t.list()
            var i: i64 = 0
            while i < term.*.min {
                const name = s.join("term", s.signedDecimal(i))
                t.push(&terms, s.join(name, ".releaseNonNull()"))
                c.write(w, t.c5("auto ", name, " = consumeRepeatedTerm(", callArgs, ");"))
                c.write(w, t.c3("if (!", name, ")"))
                c.indent(w)
                c.write(w, "return { };")
                c.outdent(w)
                i += 1
            }
            i = term.*.min
            while i < term.*.max {
                const name = s.join("term", s.signedDecimal(i))
                t.push(&terms, s.join(name, ".releaseNonNull()"))
                c.write(w, t.c5("auto ", name, " = consumeRepeatedTerm(", callArgs, ");"))
                c.write(w, t.c3("if (!", name, ") {"))
                c.indent(w)
                if term.*.defaultValue.length > 0 {
                    if !std.text.same(term.*.defaultValue, "previous") { s.fail(s.join("Unknown default value pragma ", term.*.defaultValue)) }
                    c.write(w, t.c5(name, " = term", s.signedDecimal(i - 1), ";", ""))
                    c.write(w, "range = rangeCopy;")
                    c.write(w, t.c5("return ", term.*.valueType, "::create(", t.joined(terms, ", "), ");"))
                } else {
                    c.write(w, "range = rangeCopy;")
                    if i - 1 == 0 && term.*.singleValueOptimization {
                        c.write(w, t.c3("return term", s.signedDecimal(i - 1), ".releaseNonNull(); // single item optimization"))
                    } else {
                        var allButLast = t.list()
                        var k: usize = 0
                        while k + 1 < terms.count {
                            t.push(&allButLast, terms.items[k])
                            k += 1
                        }
                        c.write(w, t.c5("return ", term.*.valueType, "::create(", t.joined(allButLast, ", "), ");"))
                    }
                }
                c.outdent(w)
                c.write(w, "}")
                i += 1
            }
            c.write(w, "range = rangeCopy;")
            c.write(w, t.c5("return ", term.*.valueType, "::create(", t.joined(terms, ", "), ");"))
        } else {
            c.write(w, t.c9("return consumeListSeparatedBy<'", separatorText(term), "', ListBounds { ", s.signedDecimal(term.*.min), ", ", s.signedDecimal(term.*.max), " }, ListOptimization::", optimizationFor(term), t.c3(">(", listParameters(gen), ");")))
        }
        c.outdent(w)
        c.write(w, "};")
        return
    }
    if kind == G_ALL_ORDERED { return allOrderedLambda(w, gen) }
    if kind == G_ALL_ANY_ORDER { return allAnyOrderLambda(w, gen) }
    return oneOrMoreLambda(w, gen)
}

fn lambdaIntoBuilder(w: *c.Writer, gen: *Gen) -> void {
    const kind = gen.*.kind
    const term = gen.*.term
    if kind == G_UNBOUNDED || kind == G_BOUNDED {
        c.write(w, t.c5("auto ", lambdaName(gen), " = [](", rangeParameters(gen.*.sub.?.*.requiresState), ") -> std::optional<CSSValueListBuilder> {"))
        c.indent(w)
        repeatedTermLambda(w, gen)
        if kind == G_UNBOUNDED {
            c.write(w, t.c7("return consumeListSeparatedByIntoBuilder<'", separatorText(term), "', ListBounds::minimumOf(", s.signedDecimal(term.*.min), ")>(", listParameters(gen), ");"))
        } else {
            c.write(w, t.c9("return consumeListSeparatedByIntoBuilder<'", separatorText(term), "', ListBounds { ", s.signedDecimal(term.*.min), ", ", s.signedDecimal(term.*.max), " }>(", listParameters(gen), ");"))
        }
        c.outdent(w)
        c.write(w, "};")
        return
    }
    c.write(w, t.c5("auto ", lambdaName(gen), " = [](", rangeParameters(gen.*.requiresState), ") -> std::optional<CSSValueListBuilder> {"))
    c.indent(w)
    if kind == G_ALL_ORDERED {
        subtermLambdas(w, gen)
        c.write(w, "CSSValueListBuilder list;")
        orderedValues(w, gen)
        c.write(w, "return { WTF::move(list) };")
    } else if kind == G_ALL_ANY_ORDER {
        anyOrderSubtermLambdas(w, gen)
        anyOrderCollect(w, gen)
        c.write(w, "return { WTF::move(list) };")
    } else {
        anyOrderSubtermLambdas(w, gen)
        if !term.*.preserveOrder { collectValues(w, gen) }
        c.write(w, "if (list.isEmpty())")
        c.indent(w)
        c.write(w, "return { };")
        c.outdent(w)
        c.write(w, "return { WTF::move(list) };")
    }
    c.outdent(w)
    c.write(w, "};")
}

// The values consumed in order into `list`, required ones failing.
fn orderedValues(w: *c.Writer, gen: *Gen) -> void {
    var index: usize = 0
    while index < gen.*.subs.count {
        const sub = genAt(gen.*.subs, index)
        const i = s.decimal(index)
        c.write(w, s.join("// ", genStr(sub)))
        c.write(w, t.c7("auto value", i, " = consumeTerm", i, "(", callArguments(sub.*.requiresState, "range", "state"), ");"))
        c.write(w, t.c3("if (value", i, ")"))
        c.indent(w)
        c.write(w, t.c3("list.append(value", i, ".releaseNonNull());"))
        c.outdent(w)
        if !isOptionalGen(sub) {
            c.write(w, "else")
            c.indent(w)
            c.write(w, "return { };")
            c.outdent(w)
        }
        index += 1
    }
}

fn allOrderedLambda(w: *c.Writer, gen: *Gen) -> void {
    const term = gen.*.term
    c.write(w, t.c3("auto consumeMatchAllOrdered = [](", rangeParameters(gen.*.requiresState), ") -> RefPtr<CSSValue> {"))
    c.indent(w)
    settingsFlagCheck(w, term.*.settingsFlag)
    subtermLambdas(w, gen)
    const list = std.text.same(term.*.valueType, "CSSValueList")
    const create = if list { "CSSValueList::createSpaceSeparated" } else { s.join(term.*.valueType, "::create") }
    const terms = gen.*.subs.count
    const optional = countOptional(gen)
    if optional > 0 {
        c.write(w, "CSSValueListBuilder list;")
        orderedValues(w, gen)
        if list {
            if terms - optional <= 1 && term.*.singleValueOptimization {
                c.write(w, "if (list.size() == 1)")
                c.indent(w)
                c.write(w, "return WTF::move(list[0]); // single item optimization")
                c.outdent(w)
            }
            c.write(w, t.c3("return ", create, "(WTF::move(list));"))
        } else {
            sizedReturns(w, create, terms - optional, terms, term.*.singleValueOptimization)
        }
    } else {
        var values = t.list()
        var index: usize = 0
        while index < terms {
            const sub = genAt(gen.*.subs, index)
            const i = s.decimal(index)
            c.write(w, s.join("// ", genStr(sub)))
            c.write(w, t.c7("auto value", i, " = consumeTerm", i, "(", callArguments(sub.*.requiresState, "range", "state"), ");"))
            c.write(w, t.c3("if (!value", i, ")"))
            c.indent(w)
            c.write(w, "return { };")
            c.outdent(w)
            t.push(&values, t.c3("value", i, ".releaseNonNull()"))
            index += 1
        }
        c.write(w, t.c5("return ", create, "(", t.joined(values, ", "), ");"))
    }
    c.outdent(w)
    c.write(w, "};")
}

// The try-consume lambdas of the any-order groupings, and the loop calling them.
fn anyOrderSubtermLambdas(w: *c.Writer, gen: *Gen) -> void {
    const preserve = gen.*.term.*.preserveOrder
    var tries = t.list()
    if preserve { c.write(w, "CSSValueListBuilder list;") }
    var index: usize = 0
    while index < gen.*.subs.count {
        const sub = genAt(gen.*.subs, index)
        const i = s.decimal(index)
        const parameters = rangeParameters(sub.*.requiresState)
        var capture: []const u8 = ""
        if preserve {
            c.write(w, t.c5("bool consumedValue", i, " = false; // ", genStr(sub), ""))
            capture = s.join("&list, &consumedValue", i)
        } else {
            c.write(w, t.c4("RefPtr<CSSValue> value", i, "; // ", genStr(sub)))
            capture = s.join("&value", i)
        }
        c.write(w, t.c7("auto tryConsumeTerm", i, " = [", capture, "](", parameters, ") -> bool {"))
        c.indent(w)
        c.write(w, t.c5("auto consumeTerm", i, " = [](", parameters, ") -> RefPtr<CSSValue> {"))
        c.indent(w)
        genUnconditional(w, sub, "range", "state")
        c.outdent(w)
        c.write(w, "};")
        const arguments = callArguments(sub.*.requiresState, "range", "state")
        t.push(&tries, t.c5("tryConsumeTerm", i, "(", arguments, ")"))
        if preserve {
            c.write(w, t.c3("if (consumedValue", i, ")"))
            c.indent(w)
            c.write(w, "return false;")
            c.outdent(w)
            c.write(w, t.c5("if (auto value = consumeTerm", i, "(", arguments, ")) {"))
            c.indent(w)
            c.write(w, "list.append(value.releaseNonNull());")
            c.write(w, t.c3("consumedValue", i, " = true;"))
            c.write(w, "return true;")
            c.outdent(w)
            c.write(w, "}")
            c.write(w, "return false;")
        } else {
            c.write(w, t.c3("if (value", i, ")"))
            c.indent(w)
            c.write(w, "return false;")
            c.outdent(w)
            c.write(w, t.c7("value", i, " = consumeTerm", i, "(", arguments, ");"))
            c.write(w, t.c3("return !!value", i, ";"))
        }
        c.outdent(w)
        c.write(w, "};")
        index += 1
    }
    c.write(w, t.c3("for (size_t i = 0; i < ", s.decimal(gen.*.subs.count), " && !range.atEnd(); ++i) {"))
    c.indent(w)
    c.write(w, t.c3("if (", t.joined(tries, " || "), ")"))
    c.indent(w)
    c.write(w, "continue;")
    c.outdent(w)
    c.write(w, "break;")
    c.outdent(w)
    c.write(w, "}")
}

// `if (valueN) list.append(...)` for each subterm, required ones failing when ORELSE.
fn collectValuesChecked(w: *c.Writer, gen: *Gen, requiredFail: bool) -> void {
    c.write(w, "CSSValueListBuilder list;")
    var index: usize = 0
    while index < gen.*.subs.count {
        const sub = genAt(gen.*.subs, index)
        const i = s.decimal(index)
        c.write(w, t.c4("if (value", i, ") // ", genStr(sub)))
        c.indent(w)
        c.write(w, t.c3("list.append(value", i, ".releaseNonNull());"))
        c.outdent(w)
        if requiredFail && !isOptionalGen(sub) {
            c.write(w, "else")
            c.indent(w)
            c.write(w, "return { };")
            c.outdent(w)
        }
        index += 1
    }
}

fn collectValues(w: *c.Writer, gen: *Gen) -> void { collectValuesChecked(w, gen, false) }

// After the loop of an all-any-order grouping: the required values checked into `list`.
fn anyOrderCollect(w: *c.Writer, gen: *Gen) -> void {
    if gen.*.term.*.preserveOrder {
        var index: usize = 0
        while index < gen.*.subs.count {
            const sub = genAt(gen.*.subs, index)
            if !isOptionalGen(sub) {
                c.write(w, t.c4("if (!consumedValue", s.decimal(index), ") // ", genStr(sub)))
                c.indent(w)
                c.write(w, "return { };")
                c.outdent(w)
            }
            index += 1
        }
    } else {
        collectValuesChecked(w, gen, true)
    }
}

fn allAnyOrderLambda(w: *c.Writer, gen: *Gen) -> void {
    const term = gen.*.term
    c.write(w, t.c3("auto consumeMatchAllAnyOrder = [](", rangeParameters(gen.*.requiresState), ") -> RefPtr<CSSValue> {"))
    c.indent(w)
    settingsFlagCheck(w, term.*.settingsFlag)
    anyOrderSubtermLambdas(w, gen)
    const terms = gen.*.subs.count
    const optional = countOptional(gen)
    if optional > 0 || term.*.preserveOrder {
        anyOrderCollect(w, gen)
        if std.text.same(term.*.valueType, "CSSValueList") {
            if terms - optional <= 1 && term.*.singleValueOptimization {
                c.write(w, "if (list.size() == 1)")
                c.indent(w)
                c.write(w, "return WTF::move(list[0]); // single item optimization")
                c.outdent(w)
            }
            c.write(w, "return CSSValueList::createSpaceSeparated(WTF::move(list));")
        } else {
            sizedReturns(w, s.join(term.*.valueType, "::create"), terms - optional, terms, term.*.singleValueOptimization)
        }
    } else {
        const create = if std.text.same(term.*.valueType, "CSSValueList") { "CSSValueList::createSpaceSeparated" } else { s.join(term.*.valueType, "::create") }
        var values = t.list()
        var index: usize = 0
        while index < terms {
            const sub = genAt(gen.*.subs, index)
            const i = s.decimal(index)
            c.write(w, t.c4("if (!value", i, ") // ", genStr(sub)))
            c.indent(w)
            c.write(w, "return { };")
            c.outdent(w)
            t.push(&values, t.c3("value", i, ".releaseNonNull()"))
            index += 1
        }
        c.write(w, t.c5("return ", create, "(", t.joined(values, ", "), ");"))
    }
    c.outdent(w)
    c.write(w, "};")
}

fn oneOrMoreLambda(w: *c.Writer, gen: *Gen) -> void {
    const term = gen.*.term
    c.write(w, t.c3("auto consumeMatchOneOrMoreAnyOrder = [](", rangeParameters(gen.*.requiresState), ") -> RefPtr<CSSValue> {"))
    c.indent(w)
    settingsFlagCheck(w, term.*.settingsFlag)
    anyOrderSubtermLambdas(w, gen)
    if !term.*.preserveOrder { collectValues(w, gen) }
    c.write(w, "if (list.isEmpty())")
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
    if std.text.same(term.*.valueType, "CSSValueList") {
        if term.*.singleValueOptimization {
            c.write(w, "if (list.size() == 1)")
            c.indent(w)
            c.write(w, "return WTF::move(list[0]); // single item optimization")
            c.outdent(w)
        }
        c.write(w, "return CSSValueList::createSpaceSeparated(WTF::move(list));")
    } else {
        sizedReturns(w, s.join(term.*.valueType, "::create"), 1, gen.*.subs.count, term.*.singleValueOptimization)
    }
    c.outdent(w)
    c.write(w, "};")
}

fn functionLambda(w: *c.Writer, gen: *Gen) -> void {
    const term = gen.*.term
    const parameters = gen.*.sub.?
    const requiresState = parameters.*.requiresState
    c.write(w, t.c3("auto ", lambdaName(gen), t.c3(" = [](", rangeParameters(requiresState), ") -> RefPtr<CSSValue> {")))
    c.indent(w)
    settingsFlagCheck(w, term.*.settingsFlag)
    const inner = if requiresState { "CSSParserTokenRange& args, CSS::PropertyParserState& state" } else { "CSSParserTokenRange& args" }
    const innerCall = if requiresState { "args, state" } else { "args" }
    c.write(w, t.c3("auto consumeParameters = [](", inner, ") -> std::optional<CSSValueListBuilder> {"))
    c.indent(w)
    if producesGroup(parameters) {
        genIntoBuilder(w, parameters, "args", "state")
    } else {
        c.write(w, t.c3("auto consumeParameter = [](", inner, ") -> RefPtr<CSSValue> {"))
        c.indent(w)
        genUnconditional(w, parameters, "args", "state")
        c.outdent(w)
        c.write(w, "};")
        c.write(w, t.c3("auto parameter = consumeParameter(", innerCall, ");"))
        c.write(w, "if (!parameter)")
        c.indent(w)
        c.write(w, if isOptionalGen(parameters) { "return CSSValueListBuilder { };" } else { "return { };" })
        c.outdent(w)
        c.write(w, "return CSSValueListBuilder { parameter.releaseNonNull() };")
    }
    c.outdent(w)
    c.write(w, "};")
    const id = valueId(term.*.name)
    c.write(w, t.c3("if (range.peek().functionId() != ", id, ")"))
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
    c.write(w, "CSSParserTokenRange rangeCopy = range;")
    c.write(w, "CSSParserTokenRange args = consumeFunction(rangeCopy);")
    c.write(w, t.c3("auto result = consumeParameters(", innerCall, ");"))
    c.write(w, "if (!result)")
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
    c.write(w, "if (!args.atEnd())")
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
    c.write(w, "range = rangeCopy;")
    c.write(w, t.c3("return CSSFunctionValue::create(", id, ", WTF::move(*result));"))
    c.outdent(w)
    c.write(w, "};")
}

// ---------------------------------------------------------------------------
// The property consumers.

const C_SKIP: u8 = 1
const C_CUSTOM: u8 = 2
const C_FAST_ONLY: u8 = 3
const C_DIRECT: u8 = 4
const C_GENERATED: u8 = 5

const Consumer = struct {
    kind: u8
    property: *m.Property
    fast: ?*Fast
    gen: ?*Gen
    requiresState: bool
}

fn consumerAt(l: g.Refs, index: usize) -> *Consumer { return unsafe { @ptrFromInt(*Consumer, l.items[index]) } }

var consumerProperties: g.Refs = undefined
var consumers: g.Refs = undefined

fn makeConsumer(p: *m.Property) -> *Consumer {
    const consumer: *Consumer = unsafe { @ptrFromInt(*Consumer, s.alloc(@sizeOf(Consumer))) }
    consumer.*.property = p
    consumer.*.fast = null
    consumer.*.gen = null
    consumer.*.requiresState = false
    if p.*.hasLonghands || m.cgOn(p, "skip-parser") {
        consumer.*.kind = C_SKIP
        return consumer
    }
    if m.cgOn(p, "parser-function") {
        consumer.*.kind = C_CUSTOM
        return consumer
    }
    if p.*.grammar == null { s.fail(t.c3("Invalid property definition for '", m.fullId(p), "'. Style properties must either specify values or a custom parser.")) }
    const grammar = p.*.grammar.?
    const fastName = s.join("isKeywordValidFor", m.nameForParsingMethods(p))
    if g.grammarHasOnlyFastPathKeywordTerms(grammar) {
        consumer.*.kind = C_FAST_ONLY
        consumer.*.fast = newFast(fastName, g.grammarFastPathKeywordTermsSorted(grammar))
        consumer.*.gen = fastKeywordsGen(consumer.*.fast.?)
        consumer.*.requiresState = consumer.*.fast.?.*.requiresState
        return consumer
    }
    if grammar.*.root.*.kind == g.K_REFERENCE {
        consumer.*.kind = C_DIRECT
        consumer.*.gen = makeGen(grammar.*.root, null)
        consumer.*.requiresState = consumer.*.gen.?.*.requiresState
        return consumer
    }
    consumer.*.kind = C_GENERATED
    if g.grammarHasFastPathKeywordTerms(grammar) { consumer.*.fast = newFast(fastName, g.grammarFastPathKeywordTermsSorted(grammar)) }
    consumer.*.gen = makeGen(grammar.*.root, consumer.*.fast)
    consumer.*.requiresState = consumer.*.gen.?.*.requiresState
    return consumer
}

fn consumerOf(p: *m.Property) -> *Consumer {
    var index: usize = 0
    while index < consumerProperties.count {
        if consumerProperties.items[index] == @intFromPtr(p) { return consumerAt(consumers, index) }
        index += 1
    }
    s.fail(s.join("no consumer for ", p.*.name))
    return consumerAt(consumers, 0)
}

fn isExported(consumer: *Consumer) -> bool {
    if consumer.*.kind == C_SKIP || consumer.*.kind == C_CUSTOM { return false }
    return m.cgOn(consumer.*.property, "parser-exported")
}

fn consumerSignature(consumer: *Consumer, definition: bool) -> []const u8 {
    const p = consumer.*.property
    const scope = if definition && m.cgOn(p, "parser-exported") { "CSSPropertyParsing::" } else { "" }
    var parameters: []const u8 = ""
    if definition {
        parameters = if consumer.*.requiresState { "CSSParserTokenRange& range, CSS::PropertyParserState& state" } else { "CSSParserTokenRange& range" }
    } else {
        parameters = if consumer.*.requiresState { "CSSParserTokenRange&, CSS::PropertyParserState&" } else { "CSSParserTokenRange&" }
    }
    return t.c6("RefPtr<CSSValue> ", scope, "consume", m.nameForParsingMethods(p), "(", s.join(parameters, ")"))
}

// The expression the parse function returns for the consumer's property ("" for none).
fn consumerCall(consumer: *Consumer, range: []const u8, state: []const u8) -> []const u8 {
    const kind = consumer.*.kind
    if kind == C_SKIP { return "" }
    if kind == C_CUSTOM { return t.c6(m.cgText(consumer.*.property, "parser-function"), "(", range, ", ", state, ")") }
    if kind == C_FAST_ONLY { return fastKeywordsCall(consumer.*.gen.?, range, state) }
    if kind == C_DIRECT { return referenceCall(consumer.*.gen.?, range, state) }
    const scope = if m.cgOn(consumer.*.property, "parser-exported") { "CSSPropertyParsing::" } else { "" }
    return t.c6(scope, "consume", m.nameForParsingMethods(consumer.*.property), "(", callArguments(consumer.*.requiresState, range, state), ")")
}

fn consumerDefinition(w: *c.Writer, consumer: *Consumer) -> void {
    const kind = consumer.*.kind
    if kind == C_SKIP || kind == C_CUSTOM { return }
    if kind == C_FAST_ONLY || kind == C_DIRECT {
        if !isExported(consumer) { return }
        c.write(w, consumerSignature(consumer, true))
        c.write(w, "{")
        c.indent(w)
        if kind == C_FAST_ONLY {
            c.write(w, t.c3("return ", consumerCall(consumer, "range", "state"), ";"))
        } else {
            genUnconditional(w, consumer.*.gen.?, "range", "state")
        }
        c.outdent(w)
        c.write(w, "}")
        c.newline(w)
        return
    }
    if isExported(consumer) {
        c.write(w, consumerSignature(consumer, true))
    } else {
        c.write(w, s.join("static ", consumerSignature(consumer, true)))
    }
    c.write(w, "{")
    c.indent(w)
    genUnconditional(w, consumer.*.gen.?, "range", "state")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

// ---------------------------------------------------------------------------
// The shared rules' consumers (only exported ones generate anything).

fn ruleGen(rule: *g.Rule) -> *Gen { return makeGen(rule.*.grammar.?.*.root, null) }

fn ruleSignature(rule: *g.Rule, gen: *Gen, definition: bool) -> []const u8 {
    var parameters: []const u8 = ""
    if definition {
        parameters = if gen.*.requiresState { "CSSParserTokenRange& range, CSS::PropertyParserState& state" } else { "CSSParserTokenRange& range" }
    } else {
        parameters = if gen.*.requiresState { "CSSParserTokenRange&, CSS::PropertyParserState&" } else { "CSSParserTokenRange&" }
    }
    return t.c6("RefPtr<CSSValue> ", if definition { "CSSPropertyParsing::" } else { "" }, "consume", rule.*.nameForMethods, "(", s.join(parameters, ")"))
}

// ---------------------------------------------------------------------------
// The collections: the style properties, then each descriptor set.

fn collectionCount() -> usize { return 1 + m.descriptorSetNames.count }

fn collectionId(index: usize) -> []const u8 {
    if index == 0 { return "StyleProperty" }
    const name = m.descriptorSetNames.items[index - 1]
    return s.join(g.nameToId(name[1..name.length]), "Descriptor")
}

fn collectionName(index: usize) -> []const u8 {
    if index == 0 { return "style" }
    return m.descriptorSetNames.items[index - 1]
}

fn collectionNoun(index: usize) -> []const u8 { return if index == 0 { "property" } else { "descriptor" } }

fn collectionMembers(index: usize) -> g.Refs {
    if index == 0 { return m.styleAll }
    return m.refsOf(m.descriptorSetsSorted.items[index - 1]).*
}

pub fn parsingHeader() -> []const u8 {
    setUp()
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.pragmaOnce(w)
    x.includesOf(w, "CSSPropertyNames.h CSSValueKeywords.h", "")
    x.openNamespace(w, "WebCore")
    x.forwardDeclarations(w, t.list(), x.words("CSSParserTokenRange CSSValue"))
    x.openNamespace(w, "CSS")
    x.forwardDeclarations(w, x.words("PropertyParserResult PropertyParserState"), t.list())
    x.closeNamespace(w, "CSS")
    c.write(w, "struct CSSPropertyParsing {")
    c.indent(w)
    var index: usize = 0
    while index < collectionCount() {
        const id = collectionId(index)
        const shorthands = index == 0
        c.write(w, t.c6("// Parse and return a single ", if shorthands { "longhand " } else { "" }, collectionName(index), " ", collectionNoun(index), "."))
        c.write(w, t.c4("static RefPtr<CSSValue> parse", id, if shorthands { "Longhand" } else { "" }, "(CSSParserTokenRange&, CSSPropertyID, CSS::PropertyParserState&);"))
        if shorthands {
            c.write(w, t.c5("// Parse a shorthand ", collectionName(index), " ", collectionNoun(index), ", adding longhands to the provided result collection. Returns true on success, false on failure."))
            c.write(w, t.c3("static bool parse", id, "Shorthand(CSSParserTokenRange&, CSSPropertyID, CSS::PropertyParserState&, CSS::PropertyParserResult&);"))
        }
        c.write(w, "// Fast path bare-keyword support.")
        c.write(w, t.c3("static bool isKeywordValidFor", id, "(CSSPropertyID, CSSValueID, CSS::PropertyParserState&);"))
        c.write(w, t.c3("static bool isKeywordFastPathEligible", id, "(CSSPropertyID);"))
        c.newline(w)
        index += 1
    }
    c.write(w, "// Direct consumers.")
    index = 0
    while index < collectionCount() {
        const members = collectionMembers(index)
        var any = false
        var at: usize = 0
        while at < members.count {
            if isExported(consumerOf(m.propertyAt(members, at))) { any = true }
            at += 1
        }
        if any {
            c.newline(w)
            c.write(w, t.c5("// Exported ", collectionName(index), " ", collectionNoun(index), " consumers."))
            at = 0
            while at < members.count {
                const consumer = consumerOf(m.propertyAt(members, at))
                if isExported(consumer) { c.write(w, t.c3("static ", consumerSignature(consumer, false), ";")) }
                at += 1
            }
        }
        index += 1
    }
    const sortedRules = g.sortedRules()
    var anyRule = false
    index = 0
    while index < sortedRules.count {
        if g.ruleAt0(sortedRules.items[index]).*.exported { anyRule = true }
        index += 1
    }
    if anyRule {
        c.newline(w)
        c.write(w, "// Exported shared consumers.")
        index = 0
        while index < sortedRules.count {
            const rule = g.ruleAt0(sortedRules.items[index])
            if rule.*.exported { c.write(w, t.c3("static ", ruleSignature(rule, ruleGen(rule), false), ";")) }
            index += 1
        }
    }
    c.outdent(w)
    c.write(w, "};")
    c.newline(w)
    x.closeNamespace(w, "WebCore")
    return c.written(w)
}

var ready: bool = false

fn setUp() -> void {
    if ready { return }
    ready = true
    consumerProperties = g.refs()
    consumers = g.refs()
    const all = m.allPropertiesAndDescriptors()
    var index: usize = 0
    while index < all.count {
        g.push(&consumerProperties, all.items[index])
        g.push(&consumers, @intFromPtr(makeConsumer(m.propertyAt(all, index))))
        index += 1
    }
}

fn parseLonghand(w: *c.Writer, index: usize) -> void {
    const shorthands = index == 0
    c.write(w, t.c4("RefPtr<CSSValue> CSSPropertyParsing::parse", collectionId(index), if shorthands { "Longhand" } else { "" }, "(CSSParserTokenRange& range, CSSPropertyID id, CSS::PropertyParserState& state)"))
    c.write(w, "{")
    c.indent(w)
    c.write(w, "if (!isExposed(id, state.context.propertySettings) && !isInternal(id)) {")
    c.indent(w)
    c.write(w, "// Allow internal properties as we use them to parse several internal-only-shorthands (e.g. background-repeat),")
    c.write(w, "// and to handle certain DOM-exposed values (e.g. -webkit-font-size-delta from execCommand('FontSizeDelta')).")
    c.write(w, "ASSERT_NOT_REACHED();")
    c.write(w, "return { };")
    c.outdent(w)
    c.write(w, "}")
    // (property, expression) pairs, sorted stably by expression, grouped.
    const members = collectionMembers(index)
    var properties = g.refs()
    var expressions = t.list()
    var at: usize = 0
    while at < members.count {
        const p = m.propertyAt(members, at)
        const expression = consumerCall(consumerOf(p), "range", "state")
        if expression.length > 0 {
            g.push(&properties, members.items[at])
            t.push(&expressions, expression)
        }
        at += 1
    }
    at = 1
    while at < expressions.count {
        const expression = expressions.items[at]
        const p = properties.items[at]
        var k = at
        while k > 0 && t.before(expression, expressions.items[k - 1]) {
            expressions.items[k] = expressions.items[k - 1]
            properties.items[k] = properties.items[k - 1]
            k -= 1
        }
        expressions.items[k] = expression
        properties.items[k] = p
        at += 1
    }
    // The groups: their first index into the sorted pairs.
    var groupStarts = g.refs()
    at = 0
    while at < expressions.count {
        if at == 0 || !std.text.same(expressions.items[at], expressions.items[at - 1]) { g.push(&groupStarts, at) }
        at += 1
    }
    // The groups sorted by their first property.
    var order = g.refs()
    at = 0
    while at < groupStarts.count {
        g.push(&order, properties.items[groupStarts.items[at]])
        at += 1
    }
    const sortedFirsts = m.sorted(order, m.comparePriority)
    c.write(w, "switch (id) {")
    at = 0
    while at < sortedFirsts.count {
        var group: usize = 0
        while properties.items[groupStarts.items[group]] != sortedFirsts.items[at] { group += 1 }
        var k = groupStarts.items[group]
        const expression = expressions.items[k]
        while k < expressions.count && std.text.same(expressions.items[k], expression) {
            c.write(w, t.c3("case ", m.fullId(m.propertyOf(properties.items[k])), ":"))
            k += 1
        }
        c.indent(w)
        c.write(w, t.c3("return ", expression, ";"))
        c.outdent(w)
        at += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn parseShorthand(w: *c.Writer, index: usize) -> void {
    if index != 0 { return }
    c.write(w, t.c3("bool CSSPropertyParsing::parse", collectionId(index), "Shorthand(CSSParserTokenRange& range, CSSPropertyID id, CSS::PropertyParserState& state, CSS::PropertyParserResult& result)"))
    c.write(w, "{")
    c.indent(w)
    c.write(w, "ASSERT(isShorthand(id));")
    c.newline(w)
    c.write(w, "switch (id) {")
    const members = collectionMembers(index)
    var at: usize = 0
    while at < members.count {
        const p = m.propertyAt(members, at)
        at += 1
        if !p.*.hasLonghands || m.cgOn(p, "skip-parser") { continue }
        c.write(w, t.c3("case ", m.fullId(p), ":"))
        c.indent(w)
        if m.cgOn(p, "settings-flag") && !m.cgOn(p, "internal-only") {
            c.write(w, t.c3("if (!state.context.propertySettings.", m.cgText(p, "settings-flag"), ") {"))
            c.indent(w)
            c.write(w, "ASSERT_NOT_REACHED();")
            c.write(w, "return false;")
            c.outdent(w)
            c.write(w, "}")
        }
        if m.cgOn(p, "parser-function") {
            c.write(w, t.c5("return CSS::PropertyParserCustom::", m.cgText(p, "parser-function"), "(range, state, ", m.cgShown(p, "parser-shorthand"), "(), result);"))
        } else if m.cgOn(p, "shorthand-parser-pattern") {
            c.write(w, t.c5("return CSS::PropertyParserCustom::consume", m.cgText(p, "shorthand-parser-pattern"), "Shorthand(range, state, ", m.cgShown(p, "parser-shorthand"), "(), result);"))
        } else {
            s.fail(t.c3("Shorthand property '", p.*.name, "' has unknown parsing method."))
        }
        c.outdent(w)
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return false;")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn keywordFunctions(w: *c.Writer, index: usize) -> void {
    const id = collectionId(index)
    const members = collectionMembers(index)
    var eligible = g.refs()
    var at: usize = 0
    while at < members.count {
        const consumer = consumerOf(m.propertyAt(members, at))
        if consumer.*.fast != null { g.push(&eligible, @intFromPtr(consumer)) }
        at += 1
    }
    if eligible.count == 0 {
        c.write(w, t.c3("bool CSSPropertyParsing::isKeywordValidFor", id, "(CSSPropertyID, CSSValueID, CSS::PropertyParserState&)"))
        c.write(w, "{")
        c.indent(w)
        c.write(w, "return false;")
        c.outdent(w)
        c.write(w, "}")
        c.newline(w)
        c.write(w, t.c3("bool CSSPropertyParsing::isKeywordFastPathEligible", id, "(CSSPropertyID)"))
        c.write(w, "{")
        c.indent(w)
        c.write(w, "return false;")
        c.outdent(w)
        c.write(w, "}")
        c.newline(w)
        return
    }
    var requiresState = false
    var ids = t.list()
    var mappings = t.list()
    at = 0
    while at < eligible.count {
        const consumer = consumerAt(eligible, at)
        const fast = consumer.*.fast.?
        if fast.*.requiresState { requiresState = true }
        t.push(&ids, m.fullId(consumer.*.property))
        t.push(&mappings, t.c3("return ", fastCall(fast, "keyword", "state"), ";"))
        at += 1
    }
    x.switchFunction(w, t.c4("bool CSSPropertyParsing::isKeywordValidFor", id, "(CSSPropertyID id, CSSValueID keyword, CSS::PropertyParserState&", if requiresState { " state)" } else { ")" }), ids, mappings, "return false;", "", "")
    x.switchFunctionBool(w, t.c3("bool CSSPropertyParsing::isKeywordFastPathEligible", id, "(CSSPropertyID id)"), ids)
}

pub fn parsing() -> []const u8 {
    setUp()
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.cppRequiredIncludes(w, "CSSPropertyParsing.h")
    x.includesOf(w, "CSSParserContext.h CSSParserIdioms.h CSSPropertyParser.h CSSPropertyParserCustom.h CSSPropertyParserState.h DeprecatedGlobalSettings.h", "")
    x.openNamespace(w, "WebCore")
    x.usingNamespaces(w, x.one("CSSPropertyParserHelpers"))
    // The keyword-only fast path predicates, the static consumers, the
    // exported ones, and the exported shared rules' consumers.
    var index: usize = 0
    while index < consumers.count {
        const consumer = consumerAt(consumers, index)
        if consumer.*.fast != null { fastDefinition(w, consumer.*.fast.?) }
        index += 1
    }
    index = 0
    while index < consumers.count {
        const consumer = consumerAt(consumers, index)
        if !m.cgOn(consumer.*.property, "parser-exported") { consumerDefinition(w, consumer) }
        index += 1
    }
    index = 0
    while index < consumers.count {
        const consumer = consumerAt(consumers, index)
        if m.cgOn(consumer.*.property, "parser-exported") { consumerDefinition(w, consumer) }
        index += 1
    }
    const sortedRules = g.sortedRules()
    index = 0
    while index < sortedRules.count {
        const rule = g.ruleAt0(sortedRules.items[index])
        if rule.*.exported {
            const gen = ruleGen(rule)
            c.write(w, ruleSignature(rule, gen, true))
            c.write(w, "{")
            c.indent(w)
            genUnconditional(w, gen, "range", "state")
            c.outdent(w)
            c.write(w, "}")
            c.newline(w)
        }
        index += 1
    }
    index = 0
    while index < collectionCount() {
        parseLonghand(w, index)
        parseShorthand(w, index)
        keywordFunctions(w, index)
        index += 1
    }
    x.closeNamespace(w, "WebCore")
    return c.written(w)
}
