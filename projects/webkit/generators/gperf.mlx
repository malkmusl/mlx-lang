// GNU gperf 3.1, the perfect hash function generator, as WebCore's
// generators run it (on CSSPropertyNames.gperf, CSSValueKeywords.gperf,
// HTTPHeaderNames.gperf, the SelectorPseudo*Map.gperf files and
// ColorData.gperf): from a keyword file, the C or C++ code of a hash
// function and a lookup function that recognize exactly its keywords,
// the same to the byte as gperf writes:
//
//     webkit-gperf [--program-name=NAME] [--directory=DIRECTORY] [OPTION]... [INPUT-FILE]
//
// with gperf's options (-k/--key-positions, -D, -n, -s, -m, -L, -t, -S,
// --output-file=FILE ...); the input is standard input when no file is
// given, the output standard output without --output-file (or with "-").
// The header comment repeats the command line as gperf got it, starting
// with the program's name: --program-name (not one of gperf's options,
// and not shown) gives the name to show, such as /usr/bin/gperf, which is
// how WebKit's build ran it; else it is this program's argv[0].
// --directory (not shown either) is where gperf runs, its files named
// from there, as WebKit's scripts run it in their output directory.
//
// The modules: gperfoptions (the command line and the options),
// gperfinput (the input file), gperfkeywords and gperfpositions (gperf's
// keywords, lists and position sets), gperfsearch (the hash function
// search) and gperfoutput (the code), gperfio (reading and writing).
const std = @import("std")
const s = @import("./support.mlx")
const io = @import("./gperfio.mlx")
const opt = @import("./gperfoptions.mlx")
const kw = @import("./gperfkeywords.mlx")
const inp = @import("./gperfinput.mlx")
const search = @import("./gperfsearch.mlx")
const output = @import("./gperfoutput.mlx")

// Runs gperf on the command line ARGUMENTS[0..COUNT] (ARGUMENTS[0] the
// name the header comment shows); the exit status.
pub fn run(arguments: [*][]const u8, count: usize) -> u8 {
    opt.parse(arguments, count)
    kw.initialize()
    inp.read()
    search.optimize(inp.input.*.head)
    output.output()
    const toStdout = !opt.o.*.hasOutputFile || std.text.same(opt.o.*.outputFileName, "-")
    if !io.writeTo(opt.o.*.outputFileName, toStdout) {
        if toStdout {
            s.say("error while writing output file\n")
        } else {
            s.say(s.join3("Cannot open output file '", opt.o.*.outputFileName, "'\n"))
        }
        return 1
    }
    return 0
}

const SYS_chdir: usize = 80

pub fn main(arguments: [][*]const u8) -> u8 {
    var vector: [*][]const u8 = undefined
    unsafe { vector = @ptrFromInt([*][]const u8, s.alloc((arguments.length + 1) * @sizeOf([]const u8))) }
    var count: usize = 0
    var index: usize = 0
    while index < arguments.length {
        const argument = s.cString(arguments[index])
        if index == 1 && s.startsWith(argument, "--program-name=") {
            vector[0] = argument[15..argument.length]
        } else if index <= 2 && count == 1 && s.startsWith(argument, "--directory=") {
            // (The argument is a C string: its text after the "=" is one.)
            if std.linux.syscall1(SYS_chdir, @intFromPtr(arguments[index]) + 12) != 0 {
                s.say(s.join3("Cannot change to the directory '", argument[12..argument.length], "'\n"))
                return 1
            }
        } else {
            vector[count] = argument
            count += 1
        }
        index += 1
    }
    if count == 0 {
        vector[0] = "gperf"
        count = 1
    }
    return run(vector, count)
}
