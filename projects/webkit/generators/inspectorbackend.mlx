// The backend dispatchers of the inspector protocol's C++ bindings, as
// WebKit's codegen makes them: the handler interfaces the agents implement
// and the dispatchers turning protocol messages into calls on them
// (generate_cpp_backend_dispatcher_header.py and _implementation.py), and
// the interfaces of the alternate dispatchers
// (generate_cpp_alternate_backend_dispatcher_header.py).
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const m = @import("./inspectormodel.mlx")

const ALL_CPP_FRAMEWORKS = "JavaScriptCore WebKit WebDriverBidi"

fn classAndExportMacro(p: *m.Protocol) -> []const u8 {
    if p.*.framework.exportMacro.length > 0 { return s.join("class ", p.*.framework.exportMacro) }
    return "class"
}

fn optionalName(member: *m.Member) -> []const u8 {
    if member.*.optional { return s.join("opt_", member.*.name) }
    return member.*.name
}

// The domains generated that have commands.
fn hasCommands(p: *m.Protocol, index: usize) -> bool { return m.generated(p, index) && p.*.domains[index].*.commandCount > 0 }

// ---------------------------------------------------------------------------
// InspectorAlternateBackendDispatchers.h

fn alternateDeclarationForCommand(command: *m.Command) -> []const u8 {
    var parameters = t.list()
    t.push(&parameters, "long protocol_requestId")
    var index: usize = 0
    while index < command.*.parameterCount {
        const parameter = &command.*.parameters[index]
        const ty = m.unenumerated(m.unaliased(parameter.*.ty))
        t.push(&parameters, t.c3(m.cppType(ty, parameter.*.optional, m.PARAMETER), " ", optionalName(parameter)))
        index += 1
    }
    return m.guarded(command.*.condition, t.c5("    virtual void ", command.*.name, "(", t.joined(parameters, ", "), ") = 0;"))
}

fn alternateDeclarationsForDomain(domain: *m.Domain) -> []const u8 {
    if domain.*.commandCount == 0 { return "" }
    var declarations = t.list()
    var index: usize = 0
    while index < domain.*.commandCount {
        t.push(&declarations, alternateDeclarationForCommand(&domain.*.commands[index]))
        index += 1
    }
    const name = domain.*.name
    return m.guarded(domain.*.condition, t.c9("class Alternate", name, "BackendDispatcher : public AlternateBackendDispatcher {\npublic:\n    virtual ~Alternate", name,
        "BackendDispatcher() { }\n", t.joined(declarations, "\n"), "\n};", "", ""))
}

pub fn generateAlternateHeader(p: *m.Protocol) -> []const u8 {
    const own = p.*.framework.name
    var includes = t.list()
    m.addInclude(p, &includes, own, own, s.join(p.*.framework.cppProtocolGroup, "ProtocolObjects.h"), true)
    m.addInclude(p, &includes, "JavaScriptCore", "JavaScriptCore", "inspector/InspectorFrontendRouter.h", true)
    m.addInclude(p, &includes, "JavaScriptCore", "JavaScriptCore", "inspector/InspectorBackendDispatcher.h", true)
    t.sort(&includes)

    var handlers = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        if m.generated(p, index) { t.push(&handlers, alternateDeclarationsForDomain(p.*.domains[index])) }
        index += 1
    }

    var sections = t.list()
    t.push(&sections, m.license(p))
    t.push(&sections, t.c3("#pragma once

#include <wtf/Platform.h>

#if ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)

", t.joined(includes, "\n"), "

namespace Inspector {

class AlternateBackendDispatcher {
public:
    void setBackendDispatcher(RefPtr<BackendDispatcher>&& dispatcher) { m_backendDispatcher = WTF::move(dispatcher); }
    BackendDispatcher* backendDispatcher() const { return m_backendDispatcher.get(); }
private:
    RefPtr<BackendDispatcher> m_backendDispatcher;
};
"))
    t.push(&sections, t.joined(t.nonEmpty(handlers), "\n\n"))
    t.push(&sections, "} // namespace Inspector

#endif // ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)")
    return t.joined(sections, "\n\n")
}

// ---------------------------------------------------------------------------
// InspectorBackendDispatchers.h

fn parameterList(command: *m.Command) -> t.List {
    var parameters = t.list()
    var index: usize = 0
    while index < command.*.parameterCount {
        const parameter = &command.*.parameters[index]
        t.push(&parameters, t.c3(m.cppType(parameter.*.ty, parameter.*.optional, m.PARAMETER), " ", optionalName(parameter)))
        index += 1
    }
    return parameters
}

fn handlerDeclarationForCommand(p: *m.Protocol, command: *m.Command) -> []const u8 {
    if command.*.async { return asyncHandlerDeclarationForCommand(p, command) }
    const parameters = t.joined(parameterList(command), ", ")
    var returns = t.list()
    var index: usize = 0
    while index < command.*.returnCount {
        const parameter = &command.*.returns[index]
        t.push(&returns, t.c4(m.cppType(parameter.*.ty, parameter.*.optional, m.RETURN_DECLARATION), " /* ", optionalName(parameter), " */"))
        index += 1
    }
    var line: []const u8 = ""
    if returns.count == 1 {
        line = t.c7("    virtual Inspector::CommandResult<", t.joined(returns, ", "), "> ", command.*.name, "(", parameters, ") = 0;")
    } else if returns.count > 0 {
        line = t.c7("    virtual Inspector::CommandResultOf<", t.joined(returns, ", "), "> ", command.*.name, "(", parameters, ") = 0;")
    } else {
        line = t.c5("    virtual Inspector::CommandResult<void> ", command.*.name, "(", parameters, ") = 0;")
    }
    return m.guarded(command.*.condition, line)
}

fn legacyAsyncResponseThunkDeclaration(p: *m.Protocol, command: *m.Command) -> []const u8 {
    const callbackName = s.join(m.ucfirst(command.*.name), "Callback")
    var returns = t.list()
    var index: usize = 0
    while index < command.*.returnCount {
        const parameter = &command.*.returns[index]
        t.push(&returns, t.c3(m.cppType(parameter.*.ty, parameter.*.optional, m.RETURN_ARGUMENT), " ", optionalName(parameter)))
        index += 1
    }
    return m.guarded(command.*.condition, t.c9("    ", classAndExportMacro(p), " ", callbackName, " : public BackendDispatcher::CallbackBase {\n    public:\n        ", callbackName,
        "(Ref<BackendDispatcher>&&, int id);\n        void sendSuccess(", t.joined(returns, ", "), ");\n    };"))
}

fn asyncHandlerDeclarationForCommand(p: *m.Protocol, command: *m.Command) -> []const u8 {
    var parameters = parameterList(command)
    var returns = t.list()
    var index: usize = 0
    while index < command.*.returnCount {
        const parameter = &command.*.returns[index]
        t.push(&returns, m.cppType(parameter.*.ty, parameter.*.optional, m.RETURN_DECLARATION))
        index += 1
    }
    if p.*.framework.legacyAsyncCallbacks {
        t.push(&parameters, t.c3("Ref<", m.ucfirst(command.*.name), "Callback>&&"))
    } else if returns.count > 1 {
        t.push(&parameters, t.c3("CommandCallbackOf<", t.joined(returns, ", "), ">&&"))
    } else if returns.count > 0 {
        t.push(&parameters, t.c3("CommandCallback<", returns.items[0], ">&&"))
    } else {
        t.push(&parameters, "CommandCallback<void>&&")
    }
    return m.guarded(command.*.condition, t.c5("    virtual void ", command.*.name, "(", t.joined(parameters, ", "), ") = 0;"))
}

fn handlerDeclarationsForDomain(p: *m.Protocol, domain: *m.Domain) -> []const u8 {
    var declarations = t.list()
    var index: usize = 0
    while index < domain.*.commandCount {
        const command = &domain.*.commands[index]
        if command.*.async && p.*.framework.legacyAsyncCallbacks { t.push(&declarations, legacyAsyncResponseThunkDeclaration(p, command)) }
        t.push(&declarations, handlerDeclarationForCommand(p, command))
        index += 1
    }
    const name = domain.*.name
    return m.guarded(domain.*.condition, t.c9(classAndExportMacro(p), " ", name, "BackendDispatcherHandler {\npublic:\n", t.joined(declarations, "\n"),
        "\nprotected:\n    virtual ~", name, "BackendDispatcherHandler();\n};", ""))
}

fn dispatcherDeclarationsForDomain(p: *m.Protocol, domain: *m.Domain) -> []const u8 {
    const name = domain.*.name
    var declarations = t.list()
    if domain.*.commandCount > 0 { t.push(&declarations, "private:") }
    var index: usize = 0
    while index < domain.*.commandCount {
        const command = &domain.*.commands[index]
        t.push(&declarations, m.guarded(command.*.condition, t.c3("    void ", command.*.name, "(long protocol_requestId, RefPtr<JSON::Object>&& protocol_parameters);")))
        index += 1
    }
    if p.*.framework.alternateDispatchers {
        t.push(&declarations, t.c5("#if ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)\npublic:\n    void setAlternateDispatcher(Alternate", name,
            "BackendDispatcher* alternateDispatcher) { m_alternateDispatcher = alternateDispatcher; }\nprivate:\n    Alternate", name,
            "BackendDispatcher* m_alternateDispatcher { nullptr };\n#endif // ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)"))
    }
    var text = t.list()
    t.push(&text, classAndExportMacro(p))
    t.push(&text, " ")
    t.push(&text, name)
    t.push(&text, "BackendDispatcher final : public SupplementalBackendDispatcher {\npublic:\n    static Ref<")
    t.push(&text, name)
    t.push(&text, "BackendDispatcher> create(BackendDispatcher&, ")
    t.push(&text, name)
    t.push(&text, "BackendDispatcherHandler*);\n    void dispatch(long protocol_requestId, const String& protocol_method, Ref<JSON::Object>&& protocol_message) final;\n")
    t.push(&text, t.joined(declarations, "\n"))
    t.push(&text, "\nprivate:\n    ")
    t.push(&text, name)
    t.push(&text, "BackendDispatcher(BackendDispatcher&, ")
    t.push(&text, name)
    t.push(&text, "BackendDispatcherHandler*);\n    ")
    t.push(&text, name)
    t.push(&text, "BackendDispatcherHandler* m_agent { nullptr };\n};")
    return m.guarded(domain.*.condition, t.joined(text, ""))
}

pub fn generateHeader(p: *m.Protocol) -> []const u8 {
    var includes = t.list()
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, p.*.framework.name, s.join(p.*.framework.cppProtocolGroup, "ProtocolObjects.h"), true)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "JavaScriptCore", "inspector/InspectorBackendDispatcher.h", true)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/Expected.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/text/MakeString.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/text/WTFString.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "std", "tuple", false)
    t.sort(&includes)

    var sections = t.list()
    t.push(&sections, m.license(p))
    t.push(&sections, t.c3("#pragma once\n\n", t.joined(includes, "\n"), "\n\nnamespace Inspector {\n\n"))
    if p.*.framework.alternateDispatchers {
        var lines = t.list()
        var any = false
        t.push(&lines, "#if ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)")
        var index: usize = 0
        while index < p.*.domainCount {
            if hasCommands(p, index) {
                const domain = p.*.domains[index]
                t.push(&lines, m.guarded(domain.*.condition, t.c3("class Alternate", domain.*.name, "BackendDispatcher;")))
                any = true
            }
            index += 1
        }
        t.push(&lines, "#endif // ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)")
        t.push(&sections, if any { t.joined(lines, "\n") } else { "" })
    }
    var index: usize = 0
    while index < p.*.domainCount {
        if hasCommands(p, index) { t.push(&sections, handlerDeclarationsForDomain(p, p.*.domains[index])) }
        index += 1
    }
    index = 0
    while index < p.*.domainCount {
        if hasCommands(p, index) { t.push(&sections, dispatcherDeclarationsForDomain(p, p.*.domains[index])) }
        index += 1
    }
    t.push(&sections, "} // namespace Inspector")
    return t.joined(sections, "\n\n")
}

// ---------------------------------------------------------------------------
// InspectorBackendDispatchers.cpp

fn dispatchCase(command: *m.Command) -> []const u8 {
    return m.guarded(command.*.condition, t.c5("    if (protocol_method == \"", command.*.name, "\"_s) {\n        ", command.*.name, "(protocol_requestId, WTF::move(protocol_parameters));\n        return;\n    }"))
}

fn smallSwitch(domain: *m.Domain) -> []const u8 {
    var cases = t.list()
    var index: usize = 0
    while index < domain.*.commandCount {
        t.push(&cases, dispatchCase(&domain.*.commands[index]))
        index += 1
    }
    const name = domain.*.name
    return t.c9("void ", name, "BackendDispatcher::dispatch(long protocol_requestId, const String& protocol_method, Ref<JSON::Object>&& protocol_message)\n{\n    Ref<", name,
        "BackendDispatcher> protect(*this);\n\n    auto protocol_parameters = protocol_message->getObject(\"params\"_s);\n\n", t.joined(cases, "\n"),
        "\n\n    m_backendDispatcher->reportProtocolError(BackendDispatcher::MethodNotFound, makeString(\"'", domain.*.exposedAs, ".\"_s, protocol_method, \"' was not found\"_s));\n}")
}

fn largeSwitch(domain: *m.Domain) -> []const u8 {
    const name = domain.*.name
    var cases = t.list()
    var index: usize = 0
    while index < domain.*.commandCount {
        const command = &domain.*.commands[index]
        t.push(&cases, m.guarded(command.*.condition, t.c7("        { \"", command.*.name, "\"_s, &", name, "BackendDispatcher::", command.*.name, " },")))
        index += 1
    }
    var text = t.list()
    t.push(&text, t.c5("void ", name, "BackendDispatcher::dispatch(long protocol_requestId, const String& protocol_method, Ref<JSON::Object>&& protocol_message)\n{\n    Ref<", name, "BackendDispatcher> protect(*this);\n\n"))
    t.push(&text, "    auto protocol_parameters = protocol_message->getObject(\"params\"_s);\n\n")
    t.push(&text, t.c3("    using CallHandler = void (", name, "BackendDispatcher::*)(long protocol_requestId, RefPtr<JSON::Object>&& protocol_message);\n"))
    t.push(&text, "    using DispatchMap = HashMap<String, CallHandler>;\n    static NeverDestroyed<DispatchMap> dispatchMap = DispatchMap({\n")
    t.push(&text, t.joined(cases, "\n"))
    t.push(&text, "\n    });\n\n    auto findResult = dispatchMap->find(protocol_method);\n    if (findResult == dispatchMap->end()) {\n")
    t.push(&text, t.c3("        m_backendDispatcher->reportProtocolError(BackendDispatcher::MethodNotFound, makeString(\"'", domain.*.exposedAs, ".\"_s, protocol_method, \"' was not found\"_s));\n"))
    t.push(&text, "        return;\n    }\n\n    ((*this).*findResult->value)(protocol_requestId, WTF::move(protocol_parameters));\n}")
    return t.joined(text, "")
}

// The lines setting the return values of COMMAND on protocol_jsonMessage
// (PREFIX before each name).
fn returnAssignments(p: *m.Protocol, command: *m.Command, prefix: []const u8, lines: *t.List, callbackParameters: *t.List) -> void {
    var index: usize = 0
    while index < command.*.returnCount {
        const parameter = &command.*.returns[index]
        const name = s.join(prefix, optionalName(parameter))
        const ty = m.dispatched(parameter.*.ty)
        const value = m.setterValue(p, ty, parameter.*.optional, name)
        const setter = m.cppSetterMethod(ty)
        t.push(callbackParameters, t.c3(m.cppType(ty, parameter.*.optional, m.RETURN_ARGUMENT), " ", name))
        if parameter.*.optional {
            t.push(lines, t.c3("    if (!!", name, ")"))
            t.push(lines, t.c7("        protocol_jsonMessage->", setter, "(\"", parameter.*.name, "\"_s, ", value, ");"))
        } else {
            t.push(lines, t.c7("    protocol_jsonMessage->", setter, "(\"", parameter.*.name, "\"_s, ", value, ");"))
        }
        index += 1
    }
}

fn legacyAsyncResponseThunk(p: *m.Protocol, command: *m.Command, domain: *m.Domain) -> []const u8 {
    var assignments = t.list()
    var callbackParameters = t.list()
    returnAssignments(p, command, "", &assignments, &callbackParameters)
    const name = domain.*.name
    const callbackName = s.join(m.ucfirst(command.*.name), "Callback")
    var text = t.list()
    t.push(&text, t.c9(name, "BackendDispatcherHandler::", callbackName, "::", callbackName, "(Ref<BackendDispatcher>&& backendDispatcher, int id) : BackendDispatcher::CallbackBase(WTF::move(backendDispatcher), id) { }\n\nvoid ",
        name, "BackendDispatcherHandler::", callbackName))
    t.push(&text, t.c3("::sendSuccess(", t.joined(callbackParameters, ", "), ")\n{\n    auto protocol_jsonMessage = JSON::Object::create();\n"))
    t.push(&text, t.joined(assignments, "\n"))
    t.push(&text, "\n    CallbackBase::sendSuccess(WTF::move(protocol_jsonMessage));\n}")
    return m.guarded(command.*.condition, t.joined(text, ""))
}

fn dispatcherImplementationForCommand(p: *m.Protocol, command: *m.Command, domain: *m.Domain) -> []const u8 {
    var parameterDeclarations = t.list()
    var enumResolutions = t.list()
    var alternateParameters = t.list()
    t.push(&alternateParameters, "protocol_requestId")
    var methodParameters = t.list()
    const enumErrorCode = p.*.framework.enumInvalidValueErrorCode

    // Step 1: the arguments of the call.
    var index: usize = 0
    while index < command.*.parameterCount {
        const parameter = &command.*.parameters[index]
        var parameterName = s.join("in_", optionalName(parameter))
        const variableName = parameterName
        const ty = m.dispatched(parameter.*.ty)
        var expression: []const u8 = ""
        if m.isEnum(ty) {
            parameterName = s.join(parameterName, "_json")
            t.push(&alternateParameters, parameterName)
            if enumResolutions.count > 0 { t.push(&enumResolutions, "") }
            t.push(&enumResolutions, t.c9("    auto ", variableName, " = Protocol::", m.helpersNamespace(p), "::parseEnumValueFromString<", m.cppProtocolType(ty), ">(", parameterName, ");"))
            const report = t.c7("        m_backendDispatcher->reportProtocolError(BackendDispatcher::", enumErrorCode, ", makeString(\"Unknown ", parameter.*.name, ": \"_s, ", parameterName, "));")
            if parameter.*.optional {
                t.push(&enumResolutions, t.c5("    if (!", parameterName, ".isEmpty() && !", variableName, ") {"))
                expression = t.c3("WTF::move(", variableName, ")")
            } else {
                t.push(&enumResolutions, t.c3("    if (!", variableName, ") {"))
                expression = s.join("*", variableName)
            }
            t.push(&enumResolutions, report)
            t.push(&enumResolutions, "        return;")
            t.push(&enumResolutions, "    }")
        } else {
            if std.text.same(ty.*.name, "string") {
                expression = variableName
            } else if parameter.*.optional {
                expression = t.c3("WTF::move(", variableName, ")")
            } else if std.text.same(ty.*.name, "boolean") || std.text.same(ty.*.name, "integer") || std.text.same(ty.*.name, "number") {
                expression = s.join("*", variableName)
            } else {
                expression = s.join(variableName, ".releaseNonNull()")
            }
            t.push(&alternateParameters, expression)
        }
        t.push(&methodParameters, expression)
        t.push(&parameterDeclarations, t.c9("    auto ", parameterName, " = m_backendDispatcher->", m.cppGetterMethod(ty), "(protocol_parameters.get(), \"", parameter.*.name, "\"_s, ",
            if parameter.*.optional { "false" } else { "true" }, ");"))
        index += 1
    }

    // Step 2: the expressions of what it returns.
    var destructuredNames = t.list()
    var conversions = t.list()
    var unusedParameters = t.list()
    index = 0
    while index < command.*.returnCount {
        t.push(&destructuredNames, s.join("out_", optionalName(&command.*.returns[index])))
        index += 1
    }
    returnAssignments(p, command, "out_", &conversions, &unusedParameters)

    if command.*.async {
        if p.*.framework.legacyAsyncCallbacks {
            const callbackName = t.c4(domain.*.name, "BackendDispatcherHandler::", m.ucfirst(command.*.name), "Callback")
            t.push(&methodParameters, t.c3("adoptRef(*new ", callbackName, "(m_backendDispatcher.copyRef(), protocol_requestId))"))
        } else {
            var alias: []const u8 = "CommandResult"
            var arguments = t.list()
            if command.*.returnCount > 1 { alias = "CommandResultOf" }
            index = 0
            while index < command.*.returnCount {
                t.push(&arguments, m.cppType(command.*.returns[index].ty, command.*.returns[index].optional, m.RETURN_DECLARATION))
                index += 1
            }
            if command.*.returnCount == 0 { t.push(&arguments, "void") }
            var thunk = t.list()
            t.push(&thunk, t.c5("[backendDispatcher = m_backendDispatcher.copyRef(), protocol_requestId](", alias, "<", t.joined(arguments, ", "), "> result) {"))
            t.push(&thunk, "        if (!result) {")
            t.push(&thunk, "           ASSERT(!result.error().isEmpty());")
            t.push(&thunk, "           backendDispatcher->reportProtocolError(protocol_requestId, BackendDispatcher::ServerError, result.error());")
            t.push(&thunk, "           backendDispatcher->sendPendingErrors();")
            t.push(&thunk, "           return;")
            t.push(&thunk, "        }")
            if destructuredNames.count > 1 {
                t.push(&thunk, t.c3("        auto [", t.joined(destructuredNames, ", "), "] = WTF::move(result.value());"))
            } else if destructuredNames.count > 0 {
                t.push(&thunk, t.c3("        auto ", t.joined(destructuredNames, ", "), " = WTF::move(result.value());"))
            }
            t.push(&thunk, "")
            t.push(&thunk, "        auto protocol_jsonMessage = JSON::Object::create();")
            index = 0
            while index < conversions.count {
                t.push(&thunk, s.join("    ", conversions.items[index]))
                index += 1
            }
            t.push(&thunk, "        backendDispatcher->sendResponse(protocol_requestId, WTF::move(protocol_jsonMessage), false);")
            t.push(&thunk, "    }")
            t.push(&methodParameters, t.joined(thunk, "\n"))
        }
    }

    const name = domain.*.name
    const invocation = t.joined(methodParameters, ", ")
    // Step 3: the code, line by line.
    var lines = t.list()
    if command.*.parameterCount == 0 {
        t.push(&lines, t.c5("void ", name, "BackendDispatcher::", command.*.name, "(long protocol_requestId, RefPtr<JSON::Object>&&)"))
    } else {
        t.push(&lines, t.c5("void ", name, "BackendDispatcher::", command.*.name, "(long protocol_requestId, RefPtr<JSON::Object>&& protocol_parameters)"))
    }
    t.push(&lines, "{")
    if command.*.parameterCount > 0 {
        t.push(&lines, t.c6(t.joined(parameterDeclarations, "\n"), "\n    if (m_backendDispatcher->hasProtocolErrors()) {\n        m_backendDispatcher->reportProtocolError(BackendDispatcher::InvalidParams, \"Some arguments of method '",
            domain.*.exposedAs, ".", command.*.name, "' can't be processed\"_s);\n        return;\n    }\n"))
    }
    if p.*.framework.alternateDispatchers {
        t.push(&lines, "#if ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)")
        t.push(&lines, "    if (m_alternateDispatcher) {")
        t.push(&lines, t.c5("        m_alternateDispatcher->", command.*.name, "(", t.joined(alternateParameters, ", "), ");"))
        t.push(&lines, "        return;")
        t.push(&lines, "    }")
        t.push(&lines, "#endif // ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)")
        t.push(&lines, "")
    }
    if enumResolutions.count > 0 {
        t.extend(&lines, enumResolutions)
        t.push(&lines, "")
    }
    if command.*.async {
        t.push(&lines, t.c5("    m_agent->", command.*.name, "(", invocation, ");"))
    } else {
        t.push(&lines, t.c5("    auto result = m_agent->", command.*.name, "(", invocation, ");"))
        t.push(&lines, "    if (!result) {")
        t.push(&lines, "        ASSERT(!result.error().isEmpty());")
        t.push(&lines, "        m_backendDispatcher->reportProtocolError(BackendDispatcher::ServerError, result.error());")
        t.push(&lines, "        return;")
        t.push(&lines, "    }")
        t.push(&lines, "")
        if destructuredNames.count == 1 {
            t.push(&lines, t.c3("    auto ", destructuredNames.items[0], " = WTF::move(result.value());"))
            t.push(&lines, "")
        } else if destructuredNames.count > 1 {
            t.push(&lines, t.c3("    auto [", t.joined(destructuredNames, ", "), "] = WTF::move(result.value());"))
            t.push(&lines, "")
        }
        t.push(&lines, "    auto protocol_jsonMessage = JSON::Object::create();")
        t.extend(&lines, conversions)
        t.push(&lines, "    m_backendDispatcher->sendResponse(protocol_requestId, WTF::move(protocol_jsonMessage), false);")
    }
    t.push(&lines, "}")
    return m.guarded(command.*.condition, t.joined(lines, "\n"))
}

fn dispatcherImplementationsForDomain(p: *m.Protocol, domain: *m.Domain) -> []const u8 {
    const name = domain.*.name
    var implementations = t.list()
    t.push(&implementations, t.c9("Ref<", name, "BackendDispatcher> ", name, "BackendDispatcher::create(BackendDispatcher& backendDispatcher, ", name,
        "BackendDispatcherHandler* agent)\n{\n    return adoptRef(*new ", name, t.c9("BackendDispatcher(backendDispatcher, agent));\n}\n\n", name, "BackendDispatcher::", name,
        "BackendDispatcher(BackendDispatcher& backendDispatcher, ", name, "BackendDispatcherHandler* agent)\n    : SupplementalBackendDispatcher(backendDispatcher)\n    , m_agent(agent)\n{\n    m_backendDispatcher->registerDispatcherForDomain(\"",
        domain.*.exposedAs, "\"_s, this);\n}")))
    if domain.*.commandCount <= 5 {
        t.push(&implementations, smallSwitch(domain))
    } else {
        t.push(&implementations, largeSwitch(domain))
    }
    var index: usize = 0
    while index < domain.*.commandCount {
        const command = &domain.*.commands[index]
        if command.*.async && p.*.framework.legacyAsyncCallbacks { t.push(&implementations, legacyAsyncResponseThunk(p, command, domain)) }
        t.push(&implementations, dispatcherImplementationForCommand(p, command, domain))
        index += 1
    }
    return m.guarded(domain.*.condition, t.joined(implementations, "\n\n"))
}

pub fn generateImplementation(p: *m.Protocol) -> []const u8 {
    var includes = t.list()
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "JavaScriptCore", "inspector/InspectorFrontendRouter.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/NeverDestroyed.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/text/MakeString.h", false)
    t.sort(&includes)
    const group = p.*.framework.cppProtocolGroup
    if p.*.framework.alternateDispatchers {
        t.push(&includes, "")
        t.push(&includes, "#if ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)")
        t.push(&includes, t.c3("#include \"", group, "AlternateBackendDispatchers.h\""))
        t.push(&includes, "#endif // ENABLE(INSPECTOR_ALTERNATE_DISPATCHERS)")
    }

    var sections = t.list()
    t.push(&sections, m.license(p))
    t.push(&sections, t.c5("#include \"config.h\"\n#include \"", group, "BackendDispatchers.h\"\n\n", t.joined(includes, "\n"), "\n\nnamespace Inspector {"))
    var destructors = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        if hasCommands(p, index) {
            const domain = p.*.domains[index]
            t.push(&destructors, m.guarded(domain.*.condition, t.c4(domain.*.name, "BackendDispatcherHandler::~", domain.*.name, "BackendDispatcherHandler() { }")))
        }
        index += 1
    }
    t.push(&sections, t.joined(destructors, "\n"))
    index = 0
    while index < p.*.domainCount {
        if hasCommands(p, index) { t.push(&sections, dispatcherImplementationsForDomain(p, p.*.domains[index])) }
        index += 1
    }
    t.push(&sections, "} // namespace Inspector\n")
    return t.joined(sections, "\n\n")
}
