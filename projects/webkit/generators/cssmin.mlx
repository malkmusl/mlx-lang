// CSS made smaller as JavaScriptCore's cssmin.py makes it (the build runs
// it as `cssmin.py < INPUT > OUTPUT`, here with the files named):
//
//     webkit-cssmin INPUT OUTPUT
//
// Comments, line ends and the spaces CSS does not need are taken out; see
// cssminify.mlx.
const s = @import("./support.mlx")
const c = @import("./csstext.mlx")
const m = @import("./cssminify.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-cssmin INPUT OUTPUT\n")
        return 2
    }
    s.writeWhole(s.cString(arguments[2]), m.cssminify(c.readFile(s.cString(arguments[1]))))
    return 0
}
