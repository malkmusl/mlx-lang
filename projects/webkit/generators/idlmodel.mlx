// The data WebKit's IDLParser.pm makes of an IDL file (its Class::Struct
// records): types, extended attributes, and one record for the other
// declarations (interfaces, dictionaries, enumerations, callbacks and
// their members), with the fields the bindings generator adds to them.
const r = @import("./bindingsrt.mlx")
const Str = r.Str
const List = r.List
const StrList = r.StrList

// ---------------------------------------------------------------------------
// Extended attributes.

// What an extended attribute holds: a string ("VALUE_IS_MISSING" when it
// was given no value), the identifiers of =(A, B), the arguments of
// Name(...), the one name and its arguments of =Name(...), or nodes the
// generator keeps there.
pub const V_STR: u8 = 0
pub const V_IDS: u8 = 1
pub const V_ARGS: u8 = 2
pub const V_NAMED: u8 = 3
pub const V_NODES: u8 = 4

pub const Value = struct {
    kind: u8
    text: Str
    ids: StrList
    // Nodes (arguments, or the generator's attributes).
    items: List
}

// The extended attributes of a declaration, in the order they came (the
// Perl keeps them in a hash; whatever depends on their order sorts them).
pub const Ext = struct {
    names: StrList
    values: List
}

pub fn newExt() -> *Ext {
    const e: *Ext = unsafe { @ptrFromInt(*Ext, r.alloc(@sizeOf(Ext))) }
    e.* = Ext.{ .names = r.strList(), .values = r.list() }
    return e
}

pub fn newValue(kind: u8, text: Str) -> *Value {
    const v: *Value = unsafe { @ptrFromInt(*Value, r.alloc(@sizeOf(Value))) }
    v.* = Value.{ .kind = kind, .text = text, .ids = r.strList(), .items = r.list() }
    return v
}

fn indexOf(e: *const Ext, name: Str) -> usize {
    var index: usize = 0
    while index < e.*.names.count {
        if r.same(e.*.names.items[index], name) { return index }
        index += 1
    }
    return e.*.names.count
}

pub fn exists(e: *const Ext, name: Str) -> bool { return indexOf(e, name) < e.*.names.count }

pub fn value(e: *const Ext, name: Str) -> ?*Value {
    const index = indexOf(e, name)
    if index == e.*.names.count { return null }
    return r.at(*Value, e.*.values, index)
}

// The value as Perl would print it: a string as it is, a reference as
// "ARRAY(0x...)" or "HASH(0x...)" (never equal to another).
pub fn textOf(v: *const Value) -> Str {
    if v.*.kind == V_STR { return v.*.text }
    if v.*.kind == V_NAMED { return r.c3("HASH(0x", r.hex(@intCast(u64, @intFromPtr(v))), ")") }
    return r.c3("ARRAY(0x", r.hex(@intCast(u64, @intFromPtr(v))), ")")
}

// The attribute NAME as a string, undef when it is not there.
pub fn get(e: *const Ext, name: Str) -> Str {
    const index = indexOf(e, name)
    if index == e.*.names.count { return r.undef() }
    return textOf(r.at(*Value, e.*.values, index))
}

// Whether the attribute NAME is there and true.
pub fn on(e: *const Ext, name: Str) -> bool { return r.truthy(get(e, name)) }

pub fn setValue(e: *Ext, name: Str, v: *Value) -> void {
    const index = indexOf(e, name)
    if index < e.*.names.count {
        e.*.values.items[index] = @intFromPtr(v)
        return
    }
    r.spush(&e.*.names, name)
    r.push(&e.*.values, @intFromPtr(v))
}

pub fn set(e: *Ext, name: Str, text: Str) -> void { setValue(e, name, newValue(V_STR, text)) }

pub fn remove(e: *Ext, name: Str) -> void {
    const index = indexOf(e, name)
    if index == e.*.names.count { return }
    var at = index
    while at + 1 < e.*.names.count {
        e.*.names.items[at] = e.*.names.items[at + 1]
        e.*.values.items[at] = e.*.values.items[at + 1]
        at += 1
    }
    e.*.names.count -= 1
    e.*.values.count -= 1
}

// Every attribute of FROM put on TO (IDLParser's copyExtendedAttributes).
pub fn copyInto(to: *Ext, from: *const Ext) -> void {
    var index: usize = 0
    while index < from.*.names.count {
        setValue(to, from.*.names.items[index], r.at(*Value, from.*.values, index))
        index += 1
    }
}

pub fn count(e: *const Ext) -> usize { return e.*.names.count }

// ---------------------------------------------------------------------------
// Types.

pub const IDLType = struct {
    name: Str
    isNullable: bool
    isUnion: bool
    subtypes: List
    ext: *Ext
}

pub fn newType(name: Str) -> *IDLType {
    const t: *IDLType = unsafe { @ptrFromInt(*IDLType, r.alloc(@sizeOf(IDLType))) }
    t.* = IDLType.{ .name = name, .isNullable = false, .isUnion = false, .subtypes = r.list(), .ext = newExt() }
    return t
}

pub fn subtype(t: *const IDLType, index: usize) -> *IDLType { return r.at(*IDLType, t.*.subtypes, index) }

// IDLParser's cloneType: the type and its subtypes copied, the extended
// attributes copied into a new hash.
pub fn cloneType(t: *const IDLType) -> *IDLType {
    const c = newType(t.*.name)
    c.*.isNullable = t.*.isNullable
    c.*.isUnion = t.*.isUnion
    copyInto(c.*.ext, t.*.ext)
    var index: usize = 0
    while index < t.*.subtypes.count {
        r.push(&c.*.subtypes, @intFromPtr(cloneType(subtype(t, index))))
        index += 1
    }
    return c
}

// ---------------------------------------------------------------------------
// Declarations.

pub const K_INTERFACE: u8 = 1
pub const K_DICTIONARY: u8 = 2
pub const K_ENUM: u8 = 3
pub const K_CALLBACK: u8 = 4
pub const K_NAMESPACE: u8 = 5
pub const K_INCLUDES: u8 = 6
pub const K_ATTRIBUTE: u8 = 7
pub const K_OPERATION: u8 = 8
pub const K_CONSTANT: u8 = 9
pub const K_ARGUMENT: u8 = 10
pub const K_MEMBER: u8 = 11
pub const K_ITERABLE: u8 = 12
pub const K_ASYNC_ITERABLE: u8 = 13
pub const K_MAPLIKE: u8 = 14
pub const K_SETLIKE: u8 = 15

pub const Node = struct {
    kind: u8
    name: Str
    ty: ?*IDLType
    parentType: ?*IDLType
    ext: *Ext
    constants: List
    operations: List
    anonymousOperations: List
    attributes: List
    constructors: List
    arguments: List
    members: List
    values: StrList
    specials: StrList
    isCallback: bool
    isNamespaceObject: bool
    isMixin: bool
    isPartial: bool
    isConstructor: bool
    isStatic: bool
    isStringifier: bool
    isReadOnly: bool
    isInherit: bool
    isOptional: bool
    isVariadic: bool
    isRequired: bool
    isKeyValue: bool
    // An argument's or member's default value (undef when none), a
    // constant's value.
    defaultValue: Str
    value: Str
    iterable: ?*Node
    asyncIterable: ?*Node
    mapLike: ?*Node
    setLike: ?*Node
    // A callback function's signature.
    operation: ?*Node
    keyType: ?*IDLType
    valueType: ?*IDLType
    itemType: ?*IDLType
    interfaceIdentifier: Str
    mixinIdentifier: Str
    // CodeGenerator's LinkOverloadedOperations: the operations of the
    // same name (this one among them) and this one's place (from 1).
    overloads: ?*List
    overloadIndex: usize
    // Fields the generator sets on operations and attributes.
    isTearOff: bool
}

pub fn newNode(kind: u8) -> *Node {
    const n: *Node = unsafe { @ptrFromInt(*Node, r.alloc(@sizeOf(Node))) }
    n.* = Node.{
        .kind = kind, .name = r.undef(), .ty = null, .parentType = null, .ext = newExt(),
        .constants = r.list(), .operations = r.list(), .anonymousOperations = r.list(), .attributes = r.list(),
        .constructors = r.list(), .arguments = r.list(), .members = r.list(), .values = r.strList(), .specials = r.strList(),
        .isCallback = false, .isNamespaceObject = false, .isMixin = false, .isPartial = false, .isConstructor = false,
        .isStatic = false, .isStringifier = false, .isReadOnly = false, .isInherit = false, .isOptional = false,
        .isVariadic = false, .isRequired = false, .isKeyValue = false,
        .defaultValue = r.undef(), .value = r.undef(),
        .iterable = null, .asyncIterable = null, .mapLike = null, .setLike = null, .operation = null,
        .keyType = null, .valueType = null, .itemType = null,
        .interfaceIdentifier = r.undef(), .mixinIdentifier = r.undef(),
        .overloads = null, .overloadIndex = 0, .isTearOff = false,
    }
    return n
}

pub fn node(l: List, index: usize) -> *Node { return r.at(*Node, l, index) }

// The type of N (which must have one).
pub fn typeOf(n: *const Node) -> *IDLType { return n.*.ty.? }

// The name of an interface, dictionary or enumeration (its type's name).
pub fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }

pub const Document = struct {
    interfaces: List
    enumerations: List
    dictionaries: List
    callbackFunctions: List
    namespaces: List
    includes: List
    fileName: Str
}

pub fn newDocument(fileName: Str) -> *Document {
    const d: *Document = unsafe { @ptrFromInt(*Document, r.alloc(@sizeOf(Document))) }
    d.* = Document.{ .interfaces = r.list(), .enumerations = r.list(), .dictionaries = r.list(), .callbackFunctions = r.list(), .namespaces = r.list(), .includes = r.list(), .fileName = fileName }
    return d
}

// ---------------------------------------------------------------------------
// Deep copies (Storable's dclone): what was shared stays shared within
// the copy.

const Clone = struct {
    seen: r.Map
}

fn key(address: usize) -> Str { return r.hex(@intCast(u64, address)) }

fn cloneExt(c: *Clone, e: *Ext) -> *Ext {
    const k = key(@intFromPtr(e))
    if r.has(&c.*.seen, k) { return unsafe { @ptrFromInt(*Ext, r.get(&c.*.seen, k)) } }
    const copy = newExt()
    r.set(&c.*.seen, k, @intFromPtr(copy))
    var index: usize = 0
    while index < e.*.names.count {
        const v = r.at(*Value, e.*.values, index)
        r.spush(&copy.*.names, e.*.names.items[index])
        r.push(&copy.*.values, @intFromPtr(cloneValue(c, v)))
        index += 1
    }
    return copy
}

fn cloneValue(c: *Clone, v: *Value) -> *Value {
    const k = key(@intFromPtr(v))
    if r.has(&c.*.seen, k) { return unsafe { @ptrFromInt(*Value, r.get(&c.*.seen, k)) } }
    const copy = newValue(v.*.kind, v.*.text)
    r.set(&c.*.seen, k, @intFromPtr(copy))
    copy.*.ids = r.scopy(v.*.ids)
    copy.*.items = cloneNodes(c, v.*.items)
    return copy
}

fn cloneTypeDeep(c: *Clone, t: ?*IDLType) -> ?*IDLType {
    if t == null { return null }
    const k = key(@intFromPtr(t.?))
    if r.has(&c.*.seen, k) { return unsafe { @ptrFromInt(*IDLType, r.get(&c.*.seen, k)) } }
    const copy = newType(t.?.*.name)
    r.set(&c.*.seen, k, @intFromPtr(copy))
    copy.*.isNullable = t.?.*.isNullable
    copy.*.isUnion = t.?.*.isUnion
    copy.*.ext = cloneExt(c, t.?.*.ext)
    var index: usize = 0
    while index < t.?.*.subtypes.count {
        r.push(&copy.*.subtypes, @intFromPtr(cloneTypeDeep(c, subtype(t.?, index)).?))
        index += 1
    }
    return copy
}

fn cloneNodes(c: *Clone, l: List) -> List {
    var copy = r.list()
    var index: usize = 0
    while index < l.count {
        r.push(&copy, @intFromPtr(cloneNode(c, node(l, index)).?))
        index += 1
    }
    return copy
}

fn cloneNode(c: *Clone, n: ?*Node) -> ?*Node {
    if n == null { return null }
    const k = key(@intFromPtr(n.?))
    if r.has(&c.*.seen, k) { return unsafe { @ptrFromInt(*Node, r.get(&c.*.seen, k)) } }
    const copy = newNode(n.?.*.kind)
    r.set(&c.*.seen, k, @intFromPtr(copy))
    copy.* = n.?.*
    copy.*.ty = cloneTypeDeep(c, n.?.*.ty)
    copy.*.parentType = cloneTypeDeep(c, n.?.*.parentType)
    copy.*.ext = cloneExt(c, n.?.*.ext)
    copy.*.constants = cloneNodes(c, n.?.*.constants)
    copy.*.operations = cloneNodes(c, n.?.*.operations)
    copy.*.anonymousOperations = cloneNodes(c, n.?.*.anonymousOperations)
    copy.*.attributes = cloneNodes(c, n.?.*.attributes)
    copy.*.constructors = cloneNodes(c, n.?.*.constructors)
    copy.*.arguments = cloneNodes(c, n.?.*.arguments)
    copy.*.members = cloneNodes(c, n.?.*.members)
    copy.*.values = r.scopy(n.?.*.values)
    copy.*.specials = r.scopy(n.?.*.specials)
    copy.*.iterable = cloneNode(c, n.?.*.iterable)
    copy.*.asyncIterable = cloneNode(c, n.?.*.asyncIterable)
    copy.*.mapLike = cloneNode(c, n.?.*.mapLike)
    copy.*.setLike = cloneNode(c, n.?.*.setLike)
    copy.*.operation = cloneNode(c, n.?.*.operation)
    copy.*.keyType = cloneTypeDeep(c, n.?.*.keyType)
    copy.*.valueType = cloneTypeDeep(c, n.?.*.valueType)
    copy.*.itemType = cloneTypeDeep(c, n.?.*.itemType)
    // Documents copied are fresh from the parser: no overloads linked yet.
    copy.*.overloads = null
    return copy
}

pub fn cloneDocument(d: *Document) -> *Document {
    var c = Clone.{ .seen = r.map() }
    const copy = newDocument(d.*.fileName)
    copy.*.interfaces = cloneNodes(&c, d.*.interfaces)
    copy.*.enumerations = cloneNodes(&c, d.*.enumerations)
    copy.*.dictionaries = cloneNodes(&c, d.*.dictionaries)
    copy.*.callbackFunctions = cloneNodes(&c, d.*.callbackFunctions)
    copy.*.namespaces = cloneNodes(&c, d.*.namespaces)
    copy.*.includes = cloneNodes(&c, d.*.includes)
    return copy
}
