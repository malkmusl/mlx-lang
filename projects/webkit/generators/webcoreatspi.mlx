// The D-Bus interface descriptions of WebCore's AT-SPI accessibility
// (AccessibilityAtspiInterfaces.h and .c), as GLib's gdbus-codegen 2.80
// makes them with --interface-info-header and --interface-info-body from
// the interfaces' XML (Source/WebCore/accessibility/atspi/xml/*.xml):
//
//     webkit-gdbus-codegen [--interface-prefix PREFIX] [--c-namespace NAMESPACE] [--pragma-once]
//         [--symbol-decorator DECORATOR] [--symbol-decorator-header HEADER] [--symbol-decorator-define DEFINE]
//         --interface-info-header|--interface-info-body --output FILE FILE.xml...
//
// The files are read in sorted order, each interface of their <node>
// with its methods (and their in and out arguments), signals, properties
// and annotations, as the tool's parser reads them. The header declares a
// GDBusInterfaceInfo per interface; the body defines it, with the
// GDBusMethodInfo, GDBusSignalInfo, GDBusPropertyInfo, GDBusArgInfo and
// GDBusAnnotationInfo it points to, named as the tool names them
// (namespace_interface__member_kind...). Only these two modes of the tool
// are made.
const std = @import("std")
const s = @import("./support.mlx")

// ---------------------------------------------------------------------------
// What the XML describes.

const INTERFACE: u8 = 0
const METHOD: u8 = 1
const SIGNAL: u8 = 2
const PROPERTY: u8 = 3
const ARG: u8 = 4
const ANNOTATION: u8 = 5

// A list of items, by index: its first and last.
const List = struct {
    first: usize
    last: usize
    count: usize
}

const Item = struct {
    kind: u8
    // A name (an annotation's key); an argument may have none.
    name: []const u8
    hasName: bool
    // An annotation's value, an argument's or property's type.
    value: []const u8
    access: []const u8
    annotations: List
    // An interface's methods, signals and properties; a method's in and
    // out arguments (a signal's in inArgs).
    methods: List
    signals: List
    properties: List
    inArgs: List
    outArgs: List
    next: usize
    // Made after reading: the C name, lower case.
    nameLower: []const u8
}

const NONE: usize = 18446744073709551615
const MAX_ITEMS: usize = 262144

var items: [*]Item = undefined
var itemCount: usize = 0
var interfaces: List = List.{ .first = NONE, .last = NONE, .count = 0 }

fn emptyList() -> List { return List.{ .first = NONE, .last = NONE, .count = 0 } }

fn newItem(kind: u8, name: []const u8, hasName: bool, value: []const u8) -> usize {
    if itemCount == MAX_ITEMS { s.fail("webkit-gdbus-codegen: too many items") }
    items[itemCount] = Item.{ .kind = kind, .name = name, .hasName = hasName, .value = value, .access = "",
        .annotations = emptyList(), .methods = emptyList(), .signals = emptyList(), .properties = emptyList(),
        .inArgs = emptyList(), .outArgs = emptyList(), .next = NONE, .nameLower = "" }
    itemCount += 1
    return itemCount - 1
}

fn append(list: *List, item: usize) -> void {
    if list.*.first == NONE {
        list.*.first = item
    } else {
        items[list.*.last].next = item
    }
    list.*.last = item
    list.*.count += 1
}

fn printError(message: []const u8) -> void {
    s.say(s.join3("ERROR: ", message, "\n"))
    const ignored = std.linux.syscall1(231, 1)
}

// ---------------------------------------------------------------------------
// Reading the XML: elements and their attributes; text, comments,
// declarations and processing instructions skipped.

var source: [*]const u8 = undefined
var sourceLength: usize = 0
var at: usize = 0

const MAX_ATTRIBUTES: usize = 64
var attributeNames: [*][]const u8 = undefined
var attributeValues: [*][]const u8 = undefined
var attributeCount: usize = 0

fn text() -> []const u8 { return source[0..sourceLength] }

fn attribute(name: []const u8) -> []const u8 {
    var index: usize = 0
    while index < attributeCount {
        if s.same(attributeNames[index], name) { return attributeValues[index] }
        index += 1
    }
    return ""
}

fn hasAttribute(name: []const u8) -> bool {
    var index: usize = 0
    while index < attributeCount {
        if s.same(attributeNames[index], name) { return true }
        index += 1
    }
    return false
}

// The attribute ATTRIBUTE, which the element must have (Python's
// attrs[...]).
fn required(name: []const u8) -> []const u8 {
    if !hasAttribute(name) { s.fail(s.join("KeyError: ", name)) }
    return attribute(name)
}

fn isNameByte(byte: u8) -> bool { return !s.isSpace(byte) && byte != 61 && byte != 62 && byte != 47 && byte != 34 && byte != 39 }

fn putUtf8(buffer: usize, length: *usize, value: u64) -> void {
    if value < 128 {
        s.put8(buffer + length.*, @intCast(u8, value))
        length.* += 1
    } else if value < 2048 {
        s.put8(buffer + length.*, @intCast(u8, 192 | (value >> 6)))
        s.put8(buffer + length.* + 1, @intCast(u8, 128 | (value & 63)))
        length.* += 2
    } else if value < 65536 {
        s.put8(buffer + length.*, @intCast(u8, 224 | (value >> 12)))
        s.put8(buffer + length.* + 1, @intCast(u8, 128 | ((value >> 6) & 63)))
        s.put8(buffer + length.* + 2, @intCast(u8, 128 | (value & 63)))
        length.* += 3
    } else {
        s.put8(buffer + length.*, @intCast(u8, 240 | (value >> 18)))
        s.put8(buffer + length.* + 1, @intCast(u8, 128 | ((value >> 12) & 63)))
        s.put8(buffer + length.* + 2, @intCast(u8, 128 | ((value >> 6) & 63)))
        s.put8(buffer + length.* + 3, @intCast(u8, 128 | (value & 63)))
        length.* += 4
    }
}

// An attribute value as XML gives it: references replaced, each tab or
// line break made a space.
fn attributeValue(raw: []const u8) -> []const u8 {
    const buffer = s.alloc(raw.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < raw.length {
        const byte = raw[index]
        if byte == 38 {
            const semicolon = index + s.find(raw[index..raw.length], ";")
            if semicolon >= raw.length { s.fail("webkit-gdbus-codegen: an unclosed reference in an attribute") }
            const name = raw[index + 1..semicolon]
            if s.same(name, "lt") {
                putUtf8(buffer, &length, 60)
            } else if s.same(name, "gt") {
                putUtf8(buffer, &length, 62)
            } else if s.same(name, "amp") {
                putUtf8(buffer, &length, 38)
            } else if s.same(name, "quot") {
                putUtf8(buffer, &length, 34)
            } else if s.same(name, "apos") {
                putUtf8(buffer, &length, 39)
            } else if name.length > 1 && name[0] == 35 {
                var value: u64 = 0
                if name[1] == 120 {
                    for digit in name[2..name.length] {
                        var d: u64 = 0
                        if digit >= 48 && digit <= 57 { d = @intCast(u64, digit - 48) } else if digit >= 97 && digit <= 102 { d = @intCast(u64, digit - 87) } else if digit >= 65 && digit <= 70 { d = @intCast(u64, digit - 55) } else { s.fail("webkit-gdbus-codegen: a bad character reference") }
                        value = value * 16 + d
                    }
                } else {
                    for digit in name[1..name.length] {
                        if !s.isDigit(digit) { s.fail("webkit-gdbus-codegen: a bad character reference") }
                        value = value * 10 + @intCast(u64, digit - 48)
                    }
                }
                putUtf8(buffer, &length, value)
            } else {
                s.fail(s.join("webkit-gdbus-codegen: an unknown entity: ", name))
            }
            index = semicolon + 1
            continue
        }
        if byte == 9 || byte == 10 || byte == 13 {
            // A CR LF pair is one line break.
            if byte == 13 && index + 1 < raw.length && raw[index + 1] == 10 { index += 1 }
            s.put8(buffer + length, 32)
        } else {
            s.put8(buffer + length, byte)
        }
        length += 1
        index += 1
    }
    return s.bytes(buffer, length)
}

fn skipPast(needle: []const u8) -> void {
    const where = at + s.find(text()[at..sourceLength], needle)
    if where >= sourceLength { s.fail("webkit-gdbus-codegen: the XML is not well-formed") }
    at = where + needle.length
}

// ---------------------------------------------------------------------------
// The parser's states (the tool's DBusXMLParser).

const STATE_TOP: u8 = 0
const STATE_NODE: u8 = 1
const STATE_INTERFACE: u8 = 2
const STATE_METHOD: u8 = 3
const STATE_SIGNAL: u8 = 4
const STATE_PROPERTY: u8 = 5
const STATE_ARG: u8 = 6
const STATE_ANNOTATION: u8 = 7
const STATE_IGNORED: u8 = 8

const MAX_DEPTH: usize = 1024
var state: u8 = 0
var current: usize = NONE
var stateStack: [*]u8 = undefined
var objectStack: [*]usize = undefined
var depth: usize = 0

fn annotate() -> void {
    if current == NONE { s.fail("AttributeError: 'NoneType' object has no attribute 'annotations'") }
    const anno = newItem(ANNOTATION, required("name"), true, required("value"))
    append(&items[current].annotations, anno)
    current = anno
    state = STATE_ANNOTATION
}

fn startElement(name: []const u8) -> void {
    const oldState = state
    const oldObject = current
    if state == STATE_IGNORED {
        state = STATE_IGNORED
    } else if state == STATE_TOP {
        state = if s.same(name, "node") { STATE_NODE } else { STATE_IGNORED }
    } else if state == STATE_NODE {
        if s.same(name, "interface") {
            const iface = newItem(INTERFACE, required("name"), true, "")
            append(&interfaces, iface)
            current = iface
            state = STATE_INTERFACE
        } else if s.same(name, "annotation") {
            annotate()
        } else {
            state = STATE_IGNORED
        }
    } else if state == STATE_INTERFACE {
        if s.same(name, "method") {
            const method = newItem(METHOD, required("name"), true, "")
            append(&items[current].methods, method)
            current = method
            state = STATE_METHOD
        } else if s.same(name, "signal") {
            const signal = newItem(SIGNAL, required("name"), true, "")
            append(&items[current].signals, signal)
            current = signal
            state = STATE_SIGNAL
        } else if s.same(name, "property") {
            const property = newItem(PROPERTY, required("name"), true, required("type"))
            const access = required("access")
            if !s.same(access, "readwrite") && !s.same(access, "read") && !s.same(access, "write") {
                printError(s.join3("Invalid access type \"", access, "\""))
            }
            items[property].access = access
            append(&items[current].properties, property)
            current = property
            state = STATE_PROPERTY
        } else if s.same(name, "annotation") {
            annotate()
        } else {
            state = STATE_IGNORED
        }
    } else if state == STATE_METHOD || state == STATE_SIGNAL {
        if s.same(name, "arg") {
            const arg = newItem(ARG, attribute("name"), hasAttribute("name"), required("type"))
            if state == STATE_SIGNAL {
                append(&items[current].inArgs, arg)
            } else {
                const direction = if hasAttribute("direction") { attribute("direction") } else { "in" }
                if s.same(direction, "in") {
                    append(&items[current].inArgs, arg)
                } else if s.same(direction, "out") {
                    append(&items[current].outArgs, arg)
                } else {
                    printError(s.join3("Invalid direction \"", direction, "\""))
                }
            }
            current = arg
            state = STATE_ARG
        } else if s.same(name, "annotation") {
            annotate()
        } else {
            state = STATE_IGNORED
        }
    } else {
        // In a property, an argument or an annotation, only annotations.
        if s.same(name, "annotation") { annotate() } else { state = STATE_IGNORED }
    }
    if depth == MAX_DEPTH { s.fail("webkit-gdbus-codegen: the XML is too deep") }
    stateStack[depth] = oldState
    objectStack[depth] = oldObject
    depth += 1
}

fn endElement() -> void {
    if depth == 0 { s.fail("webkit-gdbus-codegen: the XML is not well-formed") }
    depth -= 1
    state = stateStack[depth]
    current = objectStack[depth]
}

fn parse(path: []const u8) -> void {
    const data = s.readWhole(path)
    source = data.pointer
    sourceLength = data.length
    at = 0
    state = STATE_TOP
    current = NONE
    depth = 0
    while at < sourceLength {
        if source[at] != 60 {
            at += 1
            continue
        }
        const rest = text()[at..sourceLength]
        if s.startsWith(rest, "<!--") {
            skipPast("-->")
        } else if s.startsWith(rest, "<![CDATA[") {
            skipPast("]]>")
        } else if s.startsWith(rest, "<?") {
            skipPast("?>")
        } else if s.startsWith(rest, "<!") {
            skipPast(">")
        } else if s.startsWith(rest, "</") {
            skipPast(">")
            endElement()
        } else {
            at += 1
            const nameStart = at
            while at < sourceLength && isNameByte(source[at]) { at += 1 }
            const name = text()[nameStart..at]
            attributeCount = 0
            var empty = false
            while true {
                while at < sourceLength && s.isSpace(source[at]) { at += 1 }
                if at >= sourceLength { s.fail("webkit-gdbus-codegen: the XML is not well-formed") }
                if source[at] == 62 {
                    at += 1
                    break
                }
                if source[at] == 47 {
                    empty = true
                    skipPast(">")
                    break
                }
                const attributeStart = at
                while at < sourceLength && isNameByte(source[at]) { at += 1 }
                const attributeName = text()[attributeStart..at]
                while at < sourceLength && s.isSpace(source[at]) { at += 1 }
                if at >= sourceLength || source[at] != 61 { s.fail("webkit-gdbus-codegen: an attribute without a value") }
                at += 1
                while at < sourceLength && s.isSpace(source[at]) { at += 1 }
                if at >= sourceLength || (source[at] != 34 && source[at] != 39) { s.fail("webkit-gdbus-codegen: an unquoted attribute") }
                const quote = source[at]
                at += 1
                const valueStart = at
                while at < sourceLength && source[at] != quote { at += 1 }
                if at >= sourceLength { s.fail("webkit-gdbus-codegen: an unclosed attribute") }
                if attributeCount == MAX_ATTRIBUTES { s.fail("webkit-gdbus-codegen: too many attributes") }
                attributeNames[attributeCount] = attributeName
                attributeValues[attributeCount] = attributeValue(text()[valueStart..at])
                attributeCount += 1
                at += 1
            }
            startElement(name)
            if empty { endElement() }
        }
    }
}

// ---------------------------------------------------------------------------
// Names (the tool's utils and post_process).

fn isUpper(byte: u8) -> bool { return byte >= 65 && byte <= 90 }

fn lowered(text: []const u8) -> []const u8 {
    const buffer = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        const byte = text[index]
        s.put8(buffer + index, if isUpper(byte) { byte + 32 } else { byte })
        index += 1
    }
    return s.bytes(buffer, text.length)
}

fn replaced(text: []const u8, from: u8, to: u8) -> []const u8 { return s.replaceByte(text, from, to) }

// A dot makes the letter after it capital, and goes.
fn stripDots(text: []const u8) -> []const u8 {
    const buffer = s.alloc(text.length + 1)
    var length: usize = 0
    var forceUpper = false
    for byte in text {
        if byte == 46 {
            forceUpper = true
        } else {
            var c = byte
            if forceUpper {
                if c >= 97 && c <= 122 { c -= 32 }
                forceUpper = false
            }
            s.put8(buffer + length, c)
            length += 1
        }
    }
    return s.bytes(buffer, length)
}

fn camelCaseToUscore(text: []const u8) -> []const u8 {
    const buffer = s.alloc(text.length * 2 + 1)
    var length: usize = 0
    var insertUscore = false
    var previousWasLower = false
    var initial = true
    for byte in text {
        if initial && byte == 95 {
            s.put8(buffer + length, 95)
            length += 1
            continue
        }
        initial = false
        if isUpper(byte) {
            if previousWasLower { insertUscore = true }
            previousWasLower = false
        } else {
            previousWasLower = true
        }
        if insertUscore {
            s.put8(buffer + length, 95)
            length += 1
        }
        s.put8(buffer + length, if isUpper(byte) { byte + 32 } else { byte })
        length += 1
        insertUscore = false
    }
    return s.bytes(buffer, length)
}

fn isUglyCase(text: []const u8) -> bool { return text.length > 0 && s.find(text, "_") > 0 && s.find(text, "_") < text.length }

// The value of the first annotation KEY of LIST, or none.
fn lookup(list: List, key: []const u8, found: *bool) -> []const u8 {
    var item = list.first
    while item != NONE {
        if s.same(items[item].name, key) {
            found.* = true
            return items[item].value
        }
        item = items[item].next
    }
    found.* = false
    return ""
}

const C_NAME = "org.gtk.GDBus.C.Name"

// The C name of a member (method, signal, property) or annotation key.
fn memberNameLower(item: usize, alsoDots: bool) -> []const u8 {
    var found = false
    const overridden = lookup(items[item].annotations, C_NAME, &found)
    if isUglyCase(overridden) { return lowered(overridden) }
    const name = if found && overridden.length > 0 { overridden } else { items[item].name }
    var result = replaced(lowered(camelCaseToUscore(name)), 45, 95)
    if alsoDots { result = replaced(result, 46, 95) }
    return result
}

fn annotationsProcess(list: List) -> void {
    var item = list.first
    while item != NONE {
        items[item].nameLower = memberNameLower(item, true)
        annotationsProcess(items[item].annotations)
        item = items[item].next
    }
}

fn argsProcess(list: List, start: usize) -> usize {
    var number = start
    var item = list.first
    while item != NONE {
        if !items[item].hasName {
            items[item].name = s.join("unnamed_arg", s.decimal(@intCast(u64, number)))
            items[item].hasName = true
        }
        annotationsProcess(items[item].annotations)
        number += 1
        item = items[item].next
    }
    return number
}

fn postProcess(iface: usize, prefix: []const u8, namespace: []const u8) -> void {
    var cnsLower: []const u8 = ""
    if namespace.length > 0 {
        cnsLower = if isUglyCase(namespace) { s.join(lowered(namespace), "_") } else { s.join(lowered(camelCaseToUscore(namespace)), "_") }
    }
    var found = false
    const overridden = lookup(items[iface].annotations, C_NAME, &found)
    if isUglyCase(overridden) {
        items[iface].nameLower = s.join(cnsLower, lowered(overridden))
    } else {
        var name = items[iface].name
        if found && overridden.length > 0 {
            name = overridden
        } else if s.startsWith(name, prefix) {
            name = name[prefix.length..name.length]
        }
        items[iface].nameLower = s.join(cnsLower, camelCaseToUscore(stripDots(name)))
    }
    var item = items[iface].methods.first
    while item != NONE {
        items[item].nameLower = memberNameLower(item, false)
        const count = argsProcess(items[item].inArgs, 0)
        const ignored = argsProcess(items[item].outArgs, count)
        annotationsProcess(items[item].annotations)
        item = items[item].next
    }
    item = items[iface].signals.first
    while item != NONE {
        items[item].nameLower = memberNameLower(item, false)
        const ignored = argsProcess(items[item].inArgs, 0)
        annotationsProcess(items[item].annotations)
        item = items[item].next
    }
    item = items[iface].properties.first
    while item != NONE {
        var nameLower = memberNameLower(item, false)
        if s.same(nameLower, "type") { nameLower = "type_" }
        items[item].nameLower = nameLower
        annotationsProcess(items[item].annotations)
        item = items[item].next
    }
    annotationsProcess(items[iface].annotations)
}

// ---------------------------------------------------------------------------
// Writing.

const LICENSE = "/*\n * This file is generated by gdbus-codegen, do not modify it.\n *\n * The license of this code is the same as for the D-Bus interface description\n * it was derived from. Note that it links to GLib, so must comply with the\n * LGPL linking clauses.\n */\n"

fn o(text: []const u8) -> void { s.out(text) }

fn interfaceInfoHeader(headerName: []const u8, usePragma: bool, decorator: []const u8, decoratorHeader: []const u8, hasDecoratorHeader: bool) -> void {
    // The guard: the header's name in capitals, other characters "_".
    const guard = s.alloc(headerName.length + 1)
    var index: usize = 0
    while index < headerName.length {
        var byte = headerName[index]
        if byte >= 97 && byte <= 122 { byte -= 32 }
        if !(s.isDigit(byte) || isUpper(byte)) { byte = 95 }
        s.put8(guard + index, byte)
        index += 1
    }
    const guardName = if s.same(headerName, "-") { "STDOUT" } else { s.bytes(guard, headerName.length) }
    o(LICENSE)
    o("\n")
    if usePragma {
        o("#pragma once\n")
    } else {
        o(s.join3("#ifndef __", guardName, "__\n"))
        o(s.join3("#define __", guardName, "__\n"))
    }
    if hasDecoratorHeader {
        o("\n")
        o(s.join3("#include \"", decoratorHeader, "\"\n"))
    }
    o("\n#include <gio/gio.h>\n\nG_BEGIN_DECLS\n\n")
    var iface = interfaces.first
    while iface != NONE {
        o(s.join3("extern ", decorator, " const GDBusInterfaceInfo "))
        o(items[iface].nameLower)
        o("_interface;\n")
        iface = items[iface].next
    }
    o("\nG_END_DECLS\n")
    if !usePragma {
        o("\n")
        o(s.join3("#endif /* __", guardName, "__ */\n"))
    }
}

fn info(kind: []const u8, name: []const u8) -> void {
    o("const ")
    o(kind)
    o(" ")
    o(name)
    o(" =\n{\n  -1,  /* ref count */\n")
}

fn quoted(text: []const u8) -> void {
    o("  (gchar *) \"")
    o(text)
    o("\",\n")
}

fn pointerOr(count: usize, cast: []const u8, name: []const u8, otherwise: []const u8) -> void {
    if count > 0 {
        o("  (")
        o(cast)
        o(" **) ")
        o(name)
        o(",\n")
    } else {
        o(otherwise)
    }
}

fn arrayStart(elementType: []const u8, name: []const u8) -> void {
    o("const ")
    o(elementType)
    o(" * const ")
    o(name)
    o("[] =\n{\n")
}

fn arrayEnd() -> void { o("  NULL,\n};\n\n") }

fn defineAnnotations(arrayName: []const u8, list: List) -> void {
    if list.count == 0 { return }
    var item = list.first
    while item != NONE {
        const a = &items[item]
        item = a.*.next
        // The tool's own annotations are left out.
        if s.startsWith(a.*.name, "org.gtk.GDBus") { continue }
        const name = s.join3(arrayName, "__", a.*.nameLower)
        defineAnnotations(s.join(name, "_annotations"), a.*.annotations)
        info("GDBusAnnotationInfo", s.join(name, "_annotation"))
        quoted(a.*.name)
        quoted(a.*.value)
        pointerOr(a.*.annotations.count, "GDBusAnnotationInfo", s.join(name, "_annotations"), "  NULL,  /* no annotations */\n")
        o("};\n\n")
    }
    arrayStart("GDBusAnnotationInfo", arrayName)
    item = list.first
    while item != NONE {
        if !s.startsWith(items[item].name, "org.gtk.GDBus") {
            o("  &")
            o(arrayName)
            o("__")
            o(items[item].nameLower)
            o("_annotation,\n")
        }
        item = items[item].next
    }
    arrayEnd()
}

fn defineArgs(arrayName: []const u8, list: List) -> void {
    if list.count == 0 { return }
    var item = list.first
    while item != NONE {
        const a = &items[item]
        item = a.*.next
        const name = s.join3(arrayName, "__", a.*.name)
        defineAnnotations(s.join(name, "_arg_annotations"), a.*.annotations)
        info("GDBusArgInfo", s.join(name, "_arg"))
        quoted(a.*.name)
        quoted(a.*.value)
        pointerOr(a.*.annotations.count, "GDBusAnnotationInfo", s.join(name, "_arg_annotations"), "  NULL,  /* no annotations */\n")
        o("};\n\n")
    }
    arrayStart("GDBusArgInfo", arrayName)
    item = list.first
    while item != NONE {
        o("  &")
        o(arrayName)
        o("__")
        o(items[item].name)
        o("_arg,\n")
        item = items[item].next
    }
    arrayEnd()
}

// The array of the members of LIST, named PREFIX member SUFFIX.
fn memberArray(elementType: []const u8, arrayName: []const u8, list: List, prefix: []const u8, suffix: []const u8) -> void {
    arrayStart(elementType, arrayName)
    var item = list.first
    while item != NONE {
        o("  &")
        o(prefix)
        o(items[item].nameLower)
        o(suffix)
        o(",\n")
        item = items[item].next
    }
    arrayEnd()
}

fn defineInfos() -> void {
    var iface = interfaces.first
    while iface != NONE {
        const i = &items[iface]
        iface = i.*.next
        const base = s.join(i.*.nameLower, "_interface")
        o("/* ------------------------------------------------------------------------ */\n/* Definitions for ")
        o(i.*.name)
        o(" */\n\n")

        if i.*.methods.count > 0 {
            var item = i.*.methods.first
            while item != NONE {
                const m = &items[item]
                item = m.*.next
                const name = s.join3(base, "__", m.*.nameLower)
                defineArgs(s.join(name, "_method_in_args"), m.*.inArgs)
                defineArgs(s.join(name, "_method_out_args"), m.*.outArgs)
                defineAnnotations(s.join(name, "_method_annotations"), m.*.annotations)
                info("GDBusMethodInfo", s.join(name, "_method"))
                quoted(m.*.name)
                pointerOr(m.*.inArgs.count, "GDBusArgInfo", s.join(name, "_method_in_args"), "  NULL,  /* no in args */\n")
                pointerOr(m.*.outArgs.count, "GDBusArgInfo", s.join(name, "_method_out_args"), "  NULL,  /* no out args */\n")
                pointerOr(m.*.annotations.count, "GDBusAnnotationInfo", s.join(name, "_method_annotations"), "  NULL,  /* no annotations */\n")
                o("};\n\n")
            }
            memberArray("GDBusMethodInfo", s.join(base, "_methods"), i.*.methods, s.join(base, "__"), "_method")
        }

        if i.*.signals.count > 0 {
            var item = i.*.signals.first
            while item != NONE {
                const m = &items[item]
                item = m.*.next
                const name = s.join3(base, "__", m.*.nameLower)
                defineArgs(s.join(name, "_signal_args"), m.*.inArgs)
                defineAnnotations(s.join(name, "_signal_annotations"), m.*.annotations)
                info("GDBusSignalInfo", s.join(name, "_signal"))
                quoted(m.*.name)
                pointerOr(m.*.inArgs.count, "GDBusArgInfo", s.join(name, "_signal_args"), "  NULL,  /* no args */\n")
                pointerOr(m.*.annotations.count, "GDBusAnnotationInfo", s.join(name, "_signal_annotations"), "  NULL,  /* no annotations */\n")
                o("};\n\n")
            }
            memberArray("GDBusSignalInfo", s.join(base, "_signals"), i.*.signals, s.join(base, "__"), "_signal")
        }

        if i.*.properties.count > 0 {
            var item = i.*.properties.first
            while item != NONE {
                const p = &items[item]
                item = p.*.next
                const readable = s.same(p.*.access, "readwrite") || s.same(p.*.access, "read")
                const writable = s.same(p.*.access, "readwrite") || s.same(p.*.access, "write")
                var flags: []const u8 = "G_DBUS_PROPERTY_INFO_FLAGS_NONE"
                if readable && writable {
                    flags = "G_DBUS_PROPERTY_INFO_FLAGS_READABLE | G_DBUS_PROPERTY_INFO_FLAGS_WRITABLE"
                } else if readable {
                    flags = "G_DBUS_PROPERTY_INFO_FLAGS_READABLE"
                } else if writable {
                    flags = "G_DBUS_PROPERTY_INFO_FLAGS_WRITABLE"
                }
                const name = s.join3(base, "__", p.*.nameLower)
                defineAnnotations(s.join(name, "_property_annotations"), p.*.annotations)
                info("GDBusPropertyInfo", s.join(name, "_property"))
                quoted(p.*.name)
                quoted(p.*.value)
                o("  ")
                o(flags)
                o(",\n")
                pointerOr(p.*.annotations.count, "GDBusAnnotationInfo", s.join(name, "_property_annotations"), "  NULL,  /* no annotations */\n")
                o("};\n\n")
            }
            memberArray("GDBusPropertyInfo", s.join(base, "_properties"), i.*.properties, s.join(base, "__"), "_property")
        }

        defineAnnotations(s.join(base, "_annotations"), i.*.annotations)
        info("GDBusInterfaceInfo", base)
        quoted(i.*.name)
        pointerOr(i.*.methods.count, "GDBusMethodInfo", s.join(base, "_methods"), "  NULL,  /* no methods */\n")
        pointerOr(i.*.signals.count, "GDBusSignalInfo", s.join(base, "_signals"), "  NULL,  /* no signals */\n")
        pointerOr(i.*.properties.count, "GDBusPropertyInfo", s.join(base, "_properties"), "NULL,  /* no properties */\n")
        pointerOr(i.*.annotations.count, "GDBusAnnotationInfo", s.join(base, "_annotations"), "  NULL,  /* no annotations */\n")
        o("};\n\n")
    }
}

fn interfaceInfoBody(headerName: []const u8, define: []const u8, hasDefine: bool) -> void {
    o(LICENSE)
    if hasDefine {
        o("\n")
        o(s.join3("#define ", define, "\n"))
    }
    o("\n#ifdef HAVE_CONFIG_H\n#  include \"config.h\"\n#endif\n\n")
    if headerName.length > 0 { o(s.join3("#include \"", headerName, "\"\n\n")) }
    o("#include <string.h>\n\n")
    defineInfos()
}

// ---------------------------------------------------------------------------
// The run.

fn less(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

const MAX_FILES: usize = 4096

fn usage() -> void {
    s.say("usage: webkit-gdbus-codegen [--interface-prefix PREFIX] [--c-namespace NAMESPACE] [--pragma-once] --interface-info-header|--interface-info-body --output FILE FILE...\n")
    const ignored = std.linux.syscall1(231, 2)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var files: [*][]const u8 = undefined
    unsafe {
        files = @ptrFromInt([*][]const u8, s.alloc(MAX_FILES * 16))
        items = @ptrFromInt([*]Item, s.alloc(MAX_ITEMS * @sizeOf(Item)))
        attributeNames = @ptrFromInt([*][]const u8, s.alloc(MAX_ATTRIBUTES * 16))
        attributeValues = @ptrFromInt([*][]const u8, s.alloc(MAX_ATTRIBUTES * 16))
        stateStack = @ptrFromInt([*]u8, s.alloc(MAX_DEPTH))
        objectStack = @ptrFromInt([*]usize, s.alloc(MAX_DEPTH * 8))
    }
    var fileCount: usize = 0
    var prefix: []const u8 = "org.freedesktop.DBus."
    var namespace: []const u8 = ""
    var pragmaOnce = false
    var header = false
    var body = false
    var output: []const u8 = ""
    var hasOutput = false
    var decorator: []const u8 = ""
    var decoratorHeader: []const u8 = ""
    var hasDecoratorHeader = false
    var decoratorDefine: []const u8 = ""
    var hasDecoratorDefine = false
    var index: usize = 1
    while index < arguments.length {
        const argument = s.cString(arguments[index])
        index += 1
        var name = argument
        var value: []const u8 = ""
        var hasValue = false
        if s.startsWith(argument, "--") && s.contains(argument, "=") {
            const equals = s.find(argument, "=")
            name = argument[0..equals]
            value = argument[equals + 1..argument.length]
            hasValue = true
        }
        const takesValue = s.same(name, "--interface-prefix") || s.same(name, "--c-namespace") || s.same(name, "--output") || s.same(name, "--symbol-decorator") || s.same(name, "--symbol-decorator-header") || s.same(name, "--symbol-decorator-define")
        if takesValue && !hasValue {
            if index >= arguments.length { usage() }
            value = s.cString(arguments[index])
            index += 1
        }
        if s.same(name, "--interface-prefix") {
            prefix = value
        } else if s.same(name, "--c-namespace") {
            namespace = value
        } else if s.same(name, "--output") {
            output = value
            hasOutput = true
        } else if s.same(name, "--symbol-decorator") {
            decorator = value
        } else if s.same(name, "--symbol-decorator-header") {
            decoratorHeader = value
            hasDecoratorHeader = true
        } else if s.same(name, "--symbol-decorator-define") {
            decoratorDefine = value
            hasDecoratorDefine = true
        } else if s.same(name, "--pragma-once") {
            pragmaOnce = true
        } else if s.same(name, "--interface-info-header") {
            header = true
        } else if s.same(name, "--interface-info-body") {
            body = true
        } else if s.startsWith(argument, "-") && argument.length > 1 {
            s.fail(s.join("webkit-gdbus-codegen: not supported: ", argument))
        } else {
            if fileCount == MAX_FILES { s.fail("webkit-gdbus-codegen: too many files") }
            files[fileCount] = argument
            fileCount += 1
        }
    }
    if fileCount == 0 || header == body { usage() }
    if !hasOutput {
        if header { printError("Using --interface-info-header requires --output") }
        printError("Using --interface-info-body requires --output")
    }
    if decorator.length == 0 && (hasDecoratorHeader || hasDecoratorDefine) {
        printError("--symbol-decorator-define and --symbol-decorator-header must be used with --symbol-decorator")
    }

    // The files in sorted order.
    index = 1
    while index < fileCount {
        const item = files[index]
        var place = index
        while place > 0 && less(item, files[place - 1]) {
            files[place] = files[place - 1]
            place -= 1
        }
        files[place] = item
        index += 1
    }
    index = 0
    while index < fileCount {
        parse(files[index])
        index += 1
    }
    var iface = interfaces.first
    while iface != NONE {
        postProcess(iface, prefix, namespace)
        iface = items[iface].next
    }

    if header {
        interfaceInfoHeader(s.baseName(output), pragmaOnce, decorator, decoratorHeader, hasDecoratorHeader)
    } else {
        var headerName: []const u8 = ""
        if !s.same(output, "-") {
            // os.path.splitext of the base name, then .h.
            const base = s.baseName(output)
            var dot = base.length
            while dot > 0 && base[dot - 1] != 46 { dot -= 1 }
            var leading: usize = 0
            while leading < base.length && base[leading] == 46 { leading += 1 }
            const stem = if dot == 0 || dot - 1 < leading { base } else { base[0..dot - 1] }
            headerName = s.join(stem, ".h")
        }
        interfaceInfoBody(headerName, decoratorDefine, hasDecoratorDefine)
    }
    if s.same(output, "-") {
        const ignored = std.io.writeAll(std.io.stdout(), s.output())
    } else {
        s.writeOutput(output)
    }
    return 0
}
