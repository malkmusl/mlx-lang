// The lexer's test for white space beyond Latin-1 (JavaScriptCore's
// LexerUnicodePropertyTables.h), made as WebKit's
// parser/generateLexerUnicodePropertyTables.py makes it, from the
// characters of category Zs in UnicodeData.txt:
//
//     webkit-lexer-unicode-tables UNICODE_DATA OUTPUT
//
// The Zs characters above U+00FF, runs of consecutive ones as ranges,
// each a test in code point order with the character names as comments.
const std = @import("std")
const s = @import("./support.mlx")
const u = @import("./ucdsupport.mlx")

const HEADER = "/*\n * Copyright (C) 2026 Anthropic PBC.\n *\n * Redistribution and use in source and binary forms, with or without\n * modification, are permitted provided that the following conditions\n * are met:\n *\n * 1.  Redistributions of source code must retain the above copyright\n *     notice, this list of conditions and the following disclaimer.\n * 2.  Redistributions in binary form must reproduce the above copyright\n *     notice, this list of conditions and the following disclaimer in the\n *     documentation and/or other materials provided with the distribution.\n *\n * THIS SOFTWARE IS PROVIDED BY APPLE AND ITS CONTRIBUTORS \"AS IS\" AND ANY\n * EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n * WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n * DISCLAIMED. IN NO EVENT SHALL APPLE OR ITS CONTRIBUTORS BE LIABLE FOR ANY\n * DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n * LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n * ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF\n * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n */\n\n// DO NOT EDIT! - This file was generated by generateLexerUnicodePropertyTables.py\n\n#pragma once\n\nnamespace JSC {\n\n// ECMAScript WhiteSpace: Non-Latin1 Zs (Space_Separator) characters + BOM\n// Generated from UnicodeData.txt\n// https://tc39.es/ecma262/#sec-white-space\n// https://util.unicode.org/UnicodeJsps/list-unicodeset.jsp?a=%5B%3AGeneral_Category%3DSpace_Separator%3A%5D\nbool isNonLatin1WhiteSpace(char16_t ch)\n{\n    // U+FEFF BOM (ZERO WIDTH NO-BREAK SPACE) - ECMAScript WhiteSpace, not Zs\n    if (ch == 0xFEFF)\n        return true;\n"

const FOOTER = "    return false;\n}\n\n} // namespace JSC\n"

const MAX_POINTS: usize = 4096

var points: [*]u64 = undefined
var names: [*][]const u8 = undefined
var pointCount: usize = 0

fn generate(dataPath: []const u8, outputPath: []const u8) -> void {
    unsafe {
        points = @ptrFromInt([*]u64, s.alloc(MAX_POINTS * 8))
        names = @ptrFromInt([*][]const u8, s.alloc(MAX_POINTS * 16))
    }
    const text = s.readWhole(dataPath)
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 || u.fieldCount(line) < 3 { continue }
        const codePoint = u.parseHex(u.field(line, 0))
        if std.text.same(u.field(line, 2), "Zs") && codePoint > 255 {
            if pointCount == MAX_POINTS { s.fail("generateLexerUnicodePropertyTables: too many characters") }
            // Kept in code point order (a stable sort, as the script's).
            var slot = pointCount
            while slot > 0 && points[slot - 1] > codePoint {
                points[slot] = points[slot - 1]
                names[slot] = names[slot - 1]
                slot -= 1
            }
            points[slot] = codePoint
            names[slot] = u.field(line, 1)
            pointCount += 1
        }
    }
    s.out(HEADER)
    var index: usize = 0
    while index < pointCount {
        const start = index
        while index + 1 < pointCount && points[index + 1] == points[index] + 1 { index += 1 }
        if start == index {
            s.out("    if (ch == 0x")
            u.outHex(points[start], 4, true)
            s.out(")\n        return true; // ")
            s.out(names[start])
            s.out("\n")
        } else {
            s.out("    if (ch >= 0x")
            u.outHex(points[start], 4, true)
            s.out(" && ch <= 0x")
            u.outHex(points[index], 4, true)
            s.out(")\n        return true; // ")
            s.out(names[start])
            s.out(" ~ ")
            s.out(names[index])
            s.out("\n")
        }
        index += 1
    }
    s.out(FOOTER)
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-lexer-unicode-tables UNICODE_DATA OUTPUT\n")
        return 2
    }
    generate(s.cString(arguments[1]), s.cString(arguments[2]))
    return 0
}
