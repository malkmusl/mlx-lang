// The opcodes of JavaScriptCore's Air (AirOpcode.h, AirOpcodeUtils.h and
// AirOpcodeGenerated.h), made as WebKit's opcode_generator.rb (Ruby)
// makes them, from b3/air/AirOpcode.opcodes:
//
//     webkit-air-opcodes OPCODES OUTPUT_DIRECTORY
//
// Each opcode of the file is custom (its code written by hand), or has
// overloads: a signature (the role, bank and width of each argument)
// and the forms it takes (the kind of each argument, the architectures
// it is for, the assembler method it becomes). Out of them come the enum
// of the opcodes, the table of the role, bank and width of every
// argument, and the functions that tell a valid form, whether an
// argument may be a stack slot, which opcodes end a block or have
// effects, and that generate the code: switches on the opcode, the
// number of arguments and the kind of each argument in turn. Everything
// is in the order of the file. The text is the Ruby's to the byte.
const std = @import("std")
const s = @import("./support.mlx")

// ---------------------------------------------------------------------------
// What the file says.

const Opcode = struct {
    name: []const u8
    custom: bool
    // The overloads, a list through Overload.next (0 ends it).
    firstOverload: usize
    lastOverload: usize
    overloadCount: usize
    branch: bool
    terminal: bool
    effects: bool
    isReturn: bool
}

const Arg = struct {
    role: []const u8
    bank: []const u8
    width: []const u8
}

const Overload = struct {
    // Its arguments: args[argStart..argStart + argCount].
    argStart: usize
    argCount: usize
    // Its forms: forms[formStart..formStart + formCount].
    formStart: usize
    formCount: usize
    next: usize
}

const Kind = struct {
    name: []const u8
    // A Tmp*: one the opcode checks further.
    custom: bool
}

// A list of architectures, or none at all (Ruby's nil: any). Its names
// are archNames[start..start + count].
const Archs = struct {
    present: bool
    start: usize
    count: usize
}

const Form = struct {
    // Its kinds: kinds[kindStart..kindStart + kindCount].
    kindStart: usize
    kindCount: usize
    // "" when none.
    altName: []const u8
    archs: Archs
}

const MAX_OPCODES: usize = 4096
const MAX_OVERLOADS: usize = 8192
const MAX_ARGS: usize = 65536
const MAX_FORMS: usize = 65536
const MAX_KINDS: usize = 262144
const MAX_ARCHS: usize = 262144
const MAX_TOKENS: usize = 1048576

var opcodes: [*]Opcode = undefined
var opcodeCount: usize = 0
var overloads: [*]Overload = undefined
var overloadCount: usize = 1
var args: [*]Arg = undefined
var argCount: usize = 0
var forms: [*]Form = undefined
var formCount: usize = 0
var kinds: [*]Kind = undefined
var kindCount: usize = 0
var archNames: [*][]const u8 = undefined
var archCount: usize = 0

fn noArchs() -> Archs { return Archs.{ .present = false, .start = 0, .count = 0 } }

// ---------------------------------------------------------------------------
// Tokens: names (letters, digits, underscores) and , : * /. Comments run
// from # to the end of the line.

var tokens: [*][]const u8 = undefined
var tokenLines: [*]usize = undefined
var tokenCount: usize = 0
var tokenAt: usize = 0

fn isNameByte(byte: u8) -> bool { return s.isWord(byte) }

fn lex(text: []const u8) -> void {
    var line: usize = 1
    var at: usize = 0
    while at < text.length {
        const byte = text[at]
        const start = at
        if byte == 35 {
            while at < text.length && text[at] != 10 { at += 1 }
            continue
        }
        if byte == 10 {
            line += 1
            at += 1
            continue
        }
        if byte == 32 || byte == 9 || byte == 13 {
            at += 1
            continue
        }
        if isNameByte(byte) {
            while at < text.length && isNameByte(text[at]) { at += 1 }
        } else if byte == 44 || byte == 58 || byte == 42 || byte == 47 {
            at += 1
        } else {
            s.fail(s.join("Lexer error at line ", s.decimal(@intCast(u64, line))))
        }
        if tokenCount == MAX_TOKENS { s.fail("opcode_generator: too many tokens") }
        tokens[tokenCount] = text[start..at]
        tokenLines[tokenCount] = line
        tokenCount += 1
    }
}

// The token at hand ("" past the end).
fn token() -> []const u8 {
    if tokenAt >= tokenCount { return "" }
    return tokens[tokenAt]
}

fn advance() -> void { tokenAt += 1 }

fn parseError(comment: []const u8) -> void {
    if tokenAt >= tokenCount { s.fail(s.join("Parse error at end of file: ", comment)) }
    s.fail(s.join3(s.join3("Parse error: \"", token(), "\" at line "), s.decimal(@intCast(u64, tokenLines[tokenAt])), s.join(": ", comment)))
}

fn isToken(text: []const u8) -> bool { return std.text.same(token(), text) }

fn consume(text: []const u8) -> void {
    if !isToken(text) { parseError(s.join("Expected ", text)) }
    advance()
}

fn oneOf(text: []const u8, list: [][]const u8) -> bool {
    for entry in list {
        if std.text.same(text, entry) { return true }
    }
    return false
}

fn isRole(text: []const u8) -> bool {
    const roles = [10][]const u8{ "U", "D", "UD", "ZD", "UZD", "UA", "S", "ED", "EZD", "LU" }
    return oneOf(text, roles[0..10])
}

fn isBank(text: []const u8) -> bool { return std.text.same(text, "G") || std.text.same(text, "F") }

fn isKind(text: []const u8) -> bool {
    const names = [20][]const u8{ "Tmp", "Imm", "BigImm", "BitImm", "BitImm64", "FPImm32", "FPImm64", "FPImm128", "ZeroReg", "SimpleAddr",
        "Addr", "ExtendedOffsetAddr", "Index", "PreIndex", "PostIndex", "RelCond", "ResCond", "DoubleCond", "StatusCond", "SIMDInfo" }
    return oneOf(text, names[0..20])
}

fn isArch(text: []const u8) -> bool {
    const names = [12][]const u8{ "x86", "x86_32", "x86_64_avx", "x86_64", "arm", "armv7", "arm64e", "arm64_lse", "arm64_sha3", "arm64", "32", "64" }
    return oneOf(text, names[0..12])
}

fn isWidth(text: []const u8) -> bool {
    const names = [6][]const u8{ "8", "16", "32", "64", "Ptr", "128" }
    return oneOf(text, names[0..6])
}

fn isKeyword(text: []const u8) -> bool {
    return isRole(text) || isBank(text) || isKind(text) || isArch(text) || isWidth(text) || std.text.same(text, "custom") || std.text.same(text, "as")
}

fn isIdentifier(text: []const u8) -> bool {
    if text.length == 0 { return false }
    for byte in text {
        if !isNameByte(byte) { return false }
    }
    return !isKeyword(text)
}

fn consumeIdentifier() -> []const u8 {
    const result = token()
    if !isIdentifier(result) { parseError("Expected identifier") }
    advance()
    return result
}

fn consumeRole() -> []const u8 {
    const result = token()
    if !isRole(result) { parseError("Expected role (U, D, UD, ZD, UZD, UA, or S)") }
    advance()
    return result
}

fn consumeBank() -> []const u8 {
    const result = token()
    if !isBank(result) { parseError("Expected bank (G or F)") }
    advance()
    return result
}

fn consumeKind() -> []const u8 {
    const result = token()
    if !isKind(result) { parseError("Expected kind (Imm, BigImm, BitImm, BitImm64, FPImm32, FPImm64, FPImm128, ZeroReg, Tmp, SimpleAddr, Addr, ExtendedOffsetAddr, Index, PreIndex, PostIndex, RelCond, ResCond, DoubleCond, or StatusCond)") }
    advance()
    return result
}

fn consumeWidth() -> []const u8 {
    const result = token()
    if !isWidth(result) { parseError("Expected width (8, 16, 32, 64, or 128)") }
    advance()
    return result
}

fn addArch(name: []const u8) -> void {
    if archCount == MAX_ARCHS { s.fail("opcode_generator: too many architectures") }
    archNames[archCount] = name
    archCount += 1
}

// The architectures last read ahead, before an opcode or a form: the
// next to take them takes them.
var lastArchs: Archs = Archs.{ .present = false, .start = 0, .count = 0 }

// "x86 arm64:" and the like, when there.
fn parseArchs() -> void {
    if !isArch(token()) { return }
    const start = archCount
    while isArch(token()) {
        const name = token()
        if std.text.same(name, "x86") {
            addArch("X86")
            addArch("X86_64")
        } else if std.text.same(name, "x86_32") {
            addArch("X86")
        } else if std.text.same(name, "x86_64") {
            addArch("X86_64")
        } else if std.text.same(name, "x86_64_avx") {
            addArch("X86_64_AVX")
        } else if std.text.same(name, "arm") {
            addArch("ARM_THUMB2")
            addArch("ARM64")
        } else if std.text.same(name, "armv7") {
            addArch("ARM_THUMB2")
        } else if std.text.same(name, "arm64") {
            addArch("ARM64")
        } else if std.text.same(name, "arm64e") {
            addArch("ARM64E")
        } else if std.text.same(name, "arm64_lse") {
            addArch("ARM64_LSE")
        } else if std.text.same(name, "arm64_sha3") {
            addArch("ARM64_SHA3")
        } else if std.text.same(name, "32") {
            addArch("X86")
            addArch("ARM_THUMB2")
        } else {
            addArch("X86_64")
            addArch("ARM64")
        }
        advance()
    }
    consume(":")
    lastArchs = Archs.{ .present = true, .start = start, .count = archCount - start }
}

fn consumeArchs() -> Archs {
    const result = lastArchs
    lastArchs = noArchs()
    return result
}

fn hasArch(list: Archs, name: []const u8) -> bool {
    var index: usize = 0
    while index < list.count {
        if std.text.same(archNames[list.start + index], name) { return true }
        index += 1
    }
    return false
}

// The architectures of LEFT also in RIGHT (either none: the other).
fn intersectArchs(left: Archs, right: Archs) -> Archs {
    if !right.present { return left }
    if !left.present { return right }
    const start = archCount
    var index: usize = 0
    while index < left.count {
        const name = archNames[left.start + index]
        if hasArch(right, name) { addArch(name) }
        index += 1
    }
    return Archs.{ .present = true, .start = start, .count = archCount - start }
}

fn findOpcode(name: []const u8) -> usize {
    var index: usize = 0
    while index < opcodeCount {
        if std.text.same(opcodes[index].name, name) { return index }
        index += 1
    }
    return opcodeCount
}

fn newOpcode(name: []const u8, custom: bool) -> usize {
    if opcodeCount == MAX_OPCODES { s.fail("opcode_generator: too many opcodes") }
    opcodes[opcodeCount] = Opcode.{ .name = name, .custom = custom, .firstOverload = 0, .lastOverload = 0, .overloadCount = 0,
        .branch = false, .terminal = false, .effects = false, .isReturn = false }
    opcodeCount += 1
    return opcodeCount - 1
}

fn addForm(kindStart: usize, count: usize, altName: []const u8, archs: Archs) -> void {
    if formCount == MAX_FORMS { s.fail("opcode_generator: too many forms") }
    forms[formCount] = Form.{ .kindStart = kindStart, .kindCount = count, .altName = altName, .archs = archs }
    formCount += 1
}

fn isImmediate(name: []const u8) -> bool { return std.text.same(name, "Imm") || std.text.same(name, "BigImm") || std.text.same(name, "BitImm") || std.text.same(name, "BitImm64") }
fn isFPImmediate(name: []const u8) -> bool { return std.text.same(name, "FPImm32") || std.text.same(name, "FPImm64") || std.text.same(name, "FPImm128") }

fn parse() -> void {
    while tokenAt < tokenCount {
        if isToken("custom") {
            consume("custom")
            const name = consumeIdentifier()
            if findOpcode(name) < opcodeCount { parseError("Cannot overload a custom opcode") }
            const ignored = newOpcode(name, true)
            continue
        }
        parseArchs()
        const opcodeArchs = consumeArchs()
        const name = consumeIdentifier()
        var opcode = findOpcode(name)
        if opcode < opcodeCount {
            if opcodes[opcode].custom { parseError("Cannot overload a custom opcode") }
        } else {
            opcode = newOpcode(name, false)
        }

        const argStart = argCount
        if isRole(token()) {
            while true {
                const role = consumeRole()
                consume(":")
                const bank = consumeBank()
                consume(":")
                const width = consumeWidth()
                if argCount == MAX_ARGS { s.fail("opcode_generator: too many arguments") }
                args[argCount] = Arg.{ .role = role, .bank = bank, .width = width }
                argCount += 1
                if !isToken(",") { break }
                consume(",")
            }
        }
        const signatureLength = argCount - argStart

        while isToken("/") {
            consume("/")
            const directive = token()
            if std.text.same(directive, "branch") {
                opcodes[opcode].branch = true
                opcodes[opcode].terminal = true
            } else if std.text.same(directive, "terminal") {
                opcodes[opcode].terminal = true
            } else if std.text.same(directive, "effects") {
                opcodes[opcode].effects = true
            } else if std.text.same(directive, "return") {
                opcodes[opcode].isReturn = true
                opcodes[opcode].terminal = true
            } else {
                parseError("Bad / directive")
            }
            advance()
        }

        const formStart = formCount
        parseArchs()
        if isKind(token()) {
            while true {
                const kindStart = kindCount
                var altName: []const u8 = ""
                const formArchs = consumeArchs()
                while true {
                    if kindCount == MAX_KINDS { s.fail("opcode_generator: too many kinds") }
                    kinds[kindCount] = Kind.{ .name = consumeKind(), .custom = false }
                    kindCount += 1
                    if isToken("*") {
                        if !std.text.same(kinds[kindCount - 1].name, "Tmp") { parseError("Can only apply * to Tmp") }
                        kinds[kindCount - 1].custom = true
                        consume("*")
                    }
                    if !isToken(",") { break }
                    consume(",")
                }
                if isToken("as") {
                    consume("as")
                    altName = consumeIdentifier()
                }
                if kindCount - kindStart != signatureLength { parseError("Form has wrong number of arguments for overload") }
                var index: usize = 0
                while index < signatureLength {
                    const kind = kinds[kindStart + index].name
                    const arg = args[argStart + index]
                    if isImmediate(kind) {
                        if !std.text.same(arg.role, "U") { parseError("Form has an immediate for a non-use argument") }
                        if !std.text.same(arg.bank, "G") { parseError("Form has an immediate for a non-general-purpose argument") }
                    }
                    if isFPImmediate(kind) {
                        if !std.text.same(arg.role, "U") { parseError("Form has an immediate for a non-use argument") }
                        if !std.text.same(arg.bank, "F") { parseError("Form has an immediate for a non-floating-point-purpose argument") }
                    }
                    if std.text.same(kind, "ZeroReg") {
                        if !std.text.same(arg.role, "U") { parseError("Zero immediate must be a use argument") }
                        if !std.text.same(arg.bank, "G") { parseError("Zero immediate must be a general-purpose argument") }
                    }
                    index += 1
                }
                addForm(kindStart, signatureLength, altName, intersectArchs(opcodeArchs, formArchs))
                parseArchs()
                if !isKind(token()) { break }
            }
        }

        if signatureLength == 0 {
            if formCount != formStart { parseError("an opcode without arguments with forms") }
            addForm(kindCount, 0, "", opcodeArchs)
        }

        if overloadCount == MAX_OVERLOADS { s.fail("opcode_generator: too many overloads") }
        overloads[overloadCount] = Overload.{ .argStart = argStart, .argCount = signatureLength, .formStart = formStart, .formCount = formCount - formStart, .next = 0 }
        if opcodes[opcode].firstOverload == 0 {
            opcodes[opcode].firstOverload = overloadCount
        } else {
            overloads[opcodes[opcode].lastOverload].next = overloadCount
        }
        opcodes[opcode].lastOverload = overloadCount
        opcodes[opcode].overloadCount += 1
        overloadCount += 1
    }
}

// ---------------------------------------------------------------------------
// Output: the three files one after the other in the buffer.

// A line (Ruby's puts).
fn line(text: []const u8) -> void {
    s.out(text)
    s.out("\n")
}

fn number(value: usize) -> []const u8 { return s.decimal(@intCast(u64, value)) }

fn masmName(name: []const u8) -> []const u8 {
    const lowered = s.join(name, "")
    if lowered.length > 0 && lowered[0] >= 65 && lowered[0] <= 90 { s.put8(@intFromPtr(lowered.pointer), lowered[0] + 32) }
    return lowered
}

fn widthCode(width: []const u8) -> []const u8 {
    if std.text.same(width, "Ptr") { return "pointerWidth()" }
    return s.join("Width", width)
}

fn roleCode(role: []const u8) -> []const u8 {
    if std.text.same(role, "U") { return "Use" }
    if std.text.same(role, "D") { return "Def" }
    if std.text.same(role, "ZD") { return "ZDef" }
    if std.text.same(role, "UD") { return "UseDef" }
    if std.text.same(role, "UZD") { return "UseZDef" }
    if std.text.same(role, "UA") { return "UseAddr" }
    if std.text.same(role, "S") { return "Scratch" }
    if std.text.same(role, "ED") { return "EarlyDef" }
    if std.text.same(role, "EZD") { return "EarlyZDef" }
    return "LateUse"
}

fn pushMacros() -> void {
    line("#pragma push_macro(\"RotateLeft32\")")
    line("#pragma push_macro(\"RotateLeft64\")")
    line("#pragma push_macro(\"RotateRight32\")")
    line("#pragma push_macro(\"RotateRight64\")")
    line("#pragma push_macro(\"StoreFence\")")
    line("#pragma push_macro(\"LoadFence\")")
    line("#pragma push_macro(\"MemoryFence\")")
    line("#undef RotateLeft32")
    line("#undef RotateLeft64")
    line("#undef RotateRight32")
    line("#undef RotateRight64")
    line("#undef StoreFence")
    line("#undef LoadFence")
    line("#undef MemoryFence")
}

fn popMacros() -> void {
    line("#pragma pop_macro(\"RotateLeft32\")")
    line("#pragma pop_macro(\"RotateLeft64\")")
    line("#pragma pop_macro(\"RotateRight32\")")
    line("#pragma pop_macro(\"RotateRight64\")")
    line("#pragma pop_macro(\"StoreFence\")")
    line("#pragma pop_macro(\"LoadFence\")")
    line("#pragma pop_macro(\"MemoryFence\")")
}

var sourceName: [*]const u8 = undefined
var sourceNameLength: usize = 0

fn fileStart() -> void {
    s.out("// Generated by opcode_generator.rb from ")
    s.out(sourceName[0..sourceNameLength])
    line(" -- do not edit!")
    line("#pragma once")
}

// "#if CPU(...)" and "if (is...()) {" around code for some
// architectures only (an ARM64_LSE, ARM64_SHA3 or X86_64_AVX known at
// run time only, its CPU at compile time).
fn beginArchs(archs: Archs) -> void {
    if !archs.present { return }
    if archs.count == 0 {
        line("#if 0")
        return
    }
    s.out("#if ")
    var index: usize = 0
    while index < archs.count {
        var name = archNames[archs.start + index]
        if std.text.same(name, "ARM64_LSE") || std.text.same(name, "ARM64_SHA3") { name = "ARM64" }
        if std.text.same(name, "X86_64_AVX") { name = "X86_64" }
        if index > 0 { s.out(" || ") }
        s.out("CPU(")
        s.out(name)
        s.out(")")
        index += 1
    }
    s.out("\nif (")
    index = 0
    while index < archs.count {
        if index > 0 { s.out(" || ") }
        s.out("is")
        s.out(archNames[archs.start + index])
        s.out("()")
        index += 1
    }
    line(") {")
}

fn endArchs(archs: Archs) -> void {
    if !archs.present { return }
    line("}")
    line("#endif")
}

// ---------------------------------------------------------------------------
// The recursive matcher: a switch on the kind of each argument in turn,
// down to one form each, as the Ruby's matchForms does it (code not
// indented). What it switches on, what it leaves out and what it does
// with a form are set by a Match.

// The kind of argument I: args[I].kind(), opgenHiddenPtrIdentity(kinds)[I],
// or Arg::Addr for the argument asked about (in admitsStack).
const COLUMN_ARGS: u8 = 0
const COLUMN_KINDS: u8 = 1
const COLUMN_ADMITS: u8 = 2

// What a form gives: isValidForm in AirOpcodeUtils.h, Inst::isValidForm,
// a true in Inst::admitsStack, the call of Inst::generate.
const FORM_UTILS_VALID: u8 = 0
const FORM_INST_VALID: u8 = 1
const FORM_ADMITS: u8 = 2
const FORM_GENERATE: u8 = 3

const Match = struct {
    fast: bool
    column: u8
    callback: u8
    // admitsStack's argument; forms without an Addr there left out.
    argIndex: usize
    filter: bool
    opcode: usize
    overload: usize
}

fn kindAt(form: usize, index: usize) -> []const u8 {
    if index >= forms[form].kindCount { return "" }
    return kinds[forms[form].kindStart + index].name
}

fn columnOf(how: *Match, index: usize) -> []const u8 {
    if how.*.column == COLUMN_KINDS { return s.join3("opgenHiddenPtrIdentity(kinds)[", number(index), "]") }
    if how.*.column == COLUMN_ADMITS && index == how.*.argIndex { return "Arg::Addr" }
    return s.join3("args[", number(index), "].kind()")
}

fn formDone(how: *Match, form: usize) -> void {
    const overload = overloads[how.*.overload]
    const opcode = opcodes[how.*.opcode]
    const f = forms[form]
    if how.*.callback == FORM_UTILS_VALID {
        // Stack is not taken for a UseAddr (it is only if not a spill
        // slot): isValidForm is conservative.
        var index: usize = 0
        while index < overload.argCount {
            if std.text.same(args[overload.argStart + index].role, "UA") {
                line(s.join3("if (opgenHiddenPtrIdentity(kinds)[", number(index), "] == Arg::Stack)"))
                line("    return false;")
            }
            index += 1
        }
        var custom = false
        index = 0
        while index < f.kindCount {
            if kinds[f.kindStart + index].custom { custom = true }
            index += 1
        }
        if !custom {
            beginArchs(f.archs)
            line("OPGEN_RETURN(true);")
            endArchs(f.archs)
        }
    } else if how.*.callback == FORM_INST_VALID {
        beginArchs(f.archs)
        var needsMoreValidation = false
        var index: usize = 0
        while index < overload.argCount {
            const arg = args[overload.argStart + index]
            const kind = kinds[f.kindStart + index]
            const at = number(index)
            if kind.custom { needsMoreValidation = true }
            const name = kind.name
            var check: []const u8 = ""
            if std.text.same(name, "Tmp") {
                check = s.join3(s.join3("if (!args[", at, "].tmp().is"), arg.bank, "P())")
            } else if std.text.same(name, "Imm") || std.text.same(name, "BitImm") || std.text.same(name, "BitImm64") || std.text.same(name, "FPImm32") || std.text.same(name, "FPImm64") {
                check = s.join3(s.join3("if (!Arg::isValid", name, "Form(args["), at, "].value()))")
            } else if std.text.same(name, "FPImm128") {
                check = s.join3("if (!Arg::isValidFPImm128Form(args[", at, "].asV128()))")
            } else if std.text.same(name, "SimpleAddr") {
                check = s.join3("if (!args[", at, "].ptr().isGP())")
            } else if std.text.same(name, "Addr") || std.text.same(name, "ExtendedOffsetAddr") {
                if std.text.same(arg.role, "UA") {
                    line(s.join3(s.join3("if (args[", at, "].isStack() && args["), at, "].stackSlot()->isSpill())"))
                    line("OPGEN_RETURN(false);")
                }
                if std.text.same(name, "Addr") { check = s.join3("if (!Arg::isValidAddrForm(this->kind.opcode, args[", at, "].offset()))") }
            } else if std.text.same(name, "Index") {
                check = s.join3(s.join3("if (!Arg::isValidIndexForm(this->kind.opcode, args[", at, "].scale(), args["), at, s.join3("].offset(), ", widthCode(arg.width), "))"))
            } else if std.text.same(name, "PreIndex") || std.text.same(name, "PostIndex") {
                check = s.join3("if (!Arg::isValidIncrementIndexForm(args[", at, "].offset()))")
            }
            if check.length > 0 {
                line(check)
                line("OPGEN_RETURN(false);")
            }
            index += 1
        }
        if needsMoreValidation {
            line(s.join3("if (!is", opcode.name, "Valid(*this))"))
            line("OPGEN_RETURN(false);")
        }
        line("OPGEN_RETURN(true);")
        endArchs(f.archs)
    } else if how.*.callback == FORM_ADMITS {
        beginArchs(f.archs)
        line("OPGEN_RETURN(true);")
        endArchs(f.archs)
    } else {
        beginArchs(f.archs)
        const method = if f.altName.length > 0 { f.altName } else { masmName(opcode.name) }
        if opcode.branch { s.out("result = ") }
        s.out("jit.")
        s.out(method)
        s.out("(")
        var index: usize = 0
        while index < f.kindCount {
            if index != 0 { s.out(", ") }
            const name = kinds[f.kindStart + index].name
            s.out("args[")
            s.out(number(index))
            s.out("]")
            if std.text.same(name, "Tmp") {
                s.out(if std.text.same(args[overload.argStart + index].bank, "G") { ".gpr()" } else { ".fpr()" })
            } else if std.text.same(name, "Imm") || std.text.same(name, "BitImm") || std.text.same(name, "FPImm32") {
                s.out(".asTrustedImm32()")
            } else if std.text.same(name, "BigImm") {
                s.out(".asTrustedBigImm()")
            } else if std.text.same(name, "BitImm64") || std.text.same(name, "FPImm64") {
                s.out(".asTrustedImm64()")
            } else if std.text.same(name, "FPImm128") {
                s.out(".asV128()")
            } else if std.text.same(name, "ZeroReg") {
                s.out(".asZeroReg()")
            } else if std.text.same(name, "SimpleAddr") || std.text.same(name, "Addr") || std.text.same(name, "ExtendedOffsetAddr") {
                s.out(".asAddress()")
            } else if std.text.same(name, "Index") {
                s.out(".asBaseIndex()")
            } else if std.text.same(name, "PreIndex") {
                s.out(".asPreIndexAddress()")
            } else if std.text.same(name, "PostIndex") {
                s.out(".asPostIndexAddress()")
            } else if std.text.same(name, "RelCond") {
                s.out(".asRelationalCondition()")
            } else if std.text.same(name, "ResCond") {
                s.out(".asResultCondition()")
            } else if std.text.same(name, "DoubleCond") {
                s.out(".asDoubleCondition()")
            } else if std.text.same(name, "StatusCond") {
                s.out(".asStatusCondition()")
            } else if std.text.same(name, "SIMDInfo") {
                s.out(".simdInfo()")
            }
            index += 1
        }
        line(");")
        line("OPGEN_RETURN(result);")
        endArchs(f.archs)
    }
}

// LIST[0..COUNT] the forms (indices) still in the running.
fn matchForms(how: *Match, list: [*]usize, count: usize, columnIndex: usize) -> void {
    if count == 0 { return }
    if how.*.filter {
        var addresses: usize = 0
        var index: usize = 0
        while index < count {
            if std.text.same(kindAt(list[index], how.*.argIndex), "Addr") { addresses += 1 }
            index += 1
        }
        if addresses == 0 { return }
    }
    if columnIndex >= forms[list[0]].kindCount {
        if count != 1 { s.fail("opcode_generator: Did not reduce to one form") }
        formDone(how, list[0])
        line("break;")
        return
    }

    // The kinds at the column, in the order they come.
    var groups: [*][]const u8 = undefined
    unsafe { groups = @ptrFromInt([*][]const u8, s.alloc(count * @sizeOf([]const u8))) }
    var groupCount: usize = 0
    var index: usize = 0
    while index < count {
        const kind = kindAt(list[index], columnIndex)
        var seen = false
        var group: usize = 0
        while group < groupCount {
            if std.text.same(groups[group], kind) { seen = true }
            group += 1
        }
        if !seen {
            groups[groupCount] = kind
            groupCount += 1
        }
        index += 1
    }

    if how.*.fast && groupCount == 1 {
        matchForms(how, list, count, columnIndex + 1)
        return
    }

    line(s.join3("switch (", columnOf(how, columnIndex), ") {"))
    var group: usize = 0
    while group < groupCount {
        const key = groups[group]
        if std.text.same(key, "BitImm64") { line("#if USE(JSVALUE64)") }
        if std.text.same(key, "Addr") {
            line("case Arg::Addr:")
            line("case Arg::Stack:")
            line("case Arg::CallArg:")
        } else {
            line(s.join3("case Arg::", key, ":"))
        }
        var sublist: [*]usize = undefined
        unsafe { sublist = @ptrFromInt([*]usize, s.alloc(count * 8)) }
        var subcount: usize = 0
        index = 0
        while index < count {
            if std.text.same(kindAt(list[index], columnIndex), key) {
                sublist[subcount] = list[index]
                subcount += 1
            }
            index += 1
        }
        matchForms(how, sublist, subcount, columnIndex + 1)
        line("break;")
        if std.text.same(key, "BitImm64") { line("#endif // USE(JSVALUE64)") }
        group += 1
    }
    line("default:")
    line("break;")
    line("}")
}

// The forms of OVERLOAD, through the matcher.
fn matchOverloadForms(how: *Match, overload: usize) -> void {
    const o = overloads[overload]
    var list: [*]usize = undefined
    unsafe { list = @ptrFromInt([*]usize, s.alloc((o.formCount + 1) * 8)) }
    var index: usize = 0
    while index < o.formCount {
        list[index] = o.formStart + index
        index += 1
    }
    how.*.overload = overload
    matchForms(how, list, o.formCount, 0)
}

// Inst's switch on the opcode, the number of arguments (when there are
// more overloads than one, or always when SAFE) and the forms; a custom
// opcode has its own line.
fn matchInstOverloadForm(fast: bool, callback: u8) -> void {
    line("switch (this->kind.opcode) {")
    var opcode: usize = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        line(s.join3("case Opcode::", o.name, ":"))
        if o.custom {
            if callback == FORM_INST_VALID {
                line(s.join3("OPGEN_RETURN(", o.name, "Custom::isValidForm(*this));"))
            } else {
                line(s.join3("OPGEN_RETURN(", o.name, "Custom::generate(*this, jit, context));"))
            }
        } else {
            const needOverloadSwitch = o.overloadCount != 1 || !fast
            if needOverloadSwitch { line("switch (args.size()) {") }
            var overload = o.firstOverload
            while overload != 0 {
                if needOverloadSwitch { line(s.join3("case ", number(overloads[overload].argCount), ":")) }
                var how = Match.{ .fast = fast, .column = COLUMN_ARGS, .callback = callback, .argIndex = 0, .filter = false, .opcode = opcode, .overload = overload }
                matchOverloadForms(&how, overload)
                if needOverloadSwitch { line("break;") }
                overload = overloads[overload].next
            }
            if needOverloadSwitch {
                line("default:")
                line("break;")
                line("}")
            }
        }
        line("break;")
        opcode += 1
    }
    line("default:")
    line("break;")
    line("}")
}

// ---------------------------------------------------------------------------
// AirOpcode.h

fn opcodeHeader() -> void {
    fileStart()
    line("#include <wtf/Compiler.h>")
    line("#include <wtf/Platform.h>")
    line("WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN")
    line("")
    line("#if ENABLE(B3_JIT)")
    line("")
    line("#include <JavaScriptCore/JSExportMacros.h>")
    line("#include <cstdint>")
    line("")
    pushMacros()
    line("namespace JSC { namespace B3 { namespace Air {")
    line("enum Opcode : uint16_t {")
    var opcode: usize = 0
    while opcode < opcodeCount {
        line(s.join3("    ", opcodes[opcode].name, ","))
        opcode += 1
    }
    line("};")
    line(s.join3("static const unsigned numOpcodes = ", number(opcodeCount), ";"))
    line("} } } // namespace JSC::B3::Air")
    line("namespace WTF {")
    line("class PrintStream;")
    line("JS_EXPORT_PRIVATE void printInternal(PrintStream&, JSC::B3::Air::Opcode);")
    line("} // namespace WTF")
    popMacros()
    line("#endif // ENABLE(B3_JIT)")
    line("")
    line("WTF_ALLOW_UNSAFE_BUFFER_USAGE_END")
}

// ---------------------------------------------------------------------------
// AirOpcodeUtils.h

var maxNumOperands: usize = 0

// The case lines of the terminal opcodes (TERMINAL) or the returns, then
// the true they give if any.
fn casesWith(terminal: bool) -> void {
    var found = false
    var opcode: usize = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        if (terminal && o.terminal) || (!terminal && o.isReturn) {
            line(s.join3("case Opcode::", o.name, ":"))
            found = true
        }
        opcode += 1
    }
    if found { line("return true;") }
}

fn utilsHeader() -> void {
    fileStart()
    line("#include <wtf/Compiler.h>")
    line("WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN")
    line("")
    line("#if ENABLE(B3_JIT)")
    pushMacros()
    line("#include \"AirCustom.h\"")
    line("#include \"AirInst.h\"")
    line("#include \"AirFormTable.h\"")
    line("namespace JSC { namespace B3 { namespace Air {")
    line("inline bool opgenHiddenTruth() { return true; }")
    line("template<typename T>")
    line("inline T* opgenHiddenPtrIdentity(T* pointer) { return pointer; }")
    line("#define OPGEN_RETURN(value) do {\\")
    line("    if (opgenHiddenTruth())\\")
    line("        return value;\\")
    line("} while (false)")

    line("template<typename Functor>")
    line("ALWAYS_INLINE void Inst::forEachArg(const Functor& functor)")
    line("{")
    line("switch (kind.opcode) {")
    var opcode: usize = 0
    while opcode < opcodeCount {
        if opcodes[opcode].custom { line(s.join3("case Opcode::", opcodes[opcode].name, ":")) }
        opcode += 1
    }
    line("forEachArgCustom(scopedLambdaRef<EachArgCallback>(functor));")
    line("return;")
    line("default:")
    line("forEachArgSimple(functor);")
    line("return;")
    line("}")
    line("}")

    line("template<typename Func>")
    line("ALWAYS_INLINE void Inst::forEachArgSimple(const Func& func)")
    line("{")
    line("    auto args = this->args();")
    line("    size_t numOperands = args.size();")
    line("    size_t formOffset = (numOperands - 1) * numOperands / 2;")
    line(s.join3("    const uint8_t* formBase = g_formTable + kind.opcode * ", number((maxNumOperands + 1) * maxNumOperands / 2), " + formOffset;"))
    line("    for (size_t i = 0; i < numOperands; ++i) {")
    line("        uint8_t form = formBase[i];")
    line("        func(args[i], decodeFormRole(form), decodeFormBank(form), decodeFormWidth(form));")
    line("    }")
    line("}")

    line("template<typename... Arguments>")
    line("ALWAYS_INLINE bool isValidForm(Opcode opcode, Arguments... arguments)")
    line("{")
    line("Arg::Kind kinds[sizeof...(Arguments)] = { arguments... };")
    line("switch (opcode) {")
    opcode = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        line(s.join3("case Opcode::", o.name, ":"))
        if o.custom {
            line(s.join3("OPGEN_RETURN(", o.name, "Custom::isValidFormStatic(arguments...));"))
        } else {
            line("switch (sizeof...(Arguments)) {")
            var overload = o.firstOverload
            while overload != 0 {
                line(s.join3("case ", number(overloads[overload].argCount), ":"))
                var how = Match.{ .fast = false, .column = COLUMN_KINDS, .callback = FORM_UTILS_VALID, .argIndex = 0, .filter = false, .opcode = opcode, .overload = overload }
                matchOverloadForms(&how, overload)
                line("break;")
                overload = overloads[overload].next
            }
            line("default:")
            line("break;")
            line("}")
        }
        line("break;")
        opcode += 1
    }
    line("default:")
    line("break;")
    line("}")
    line("return false; ")
    line("}")

    line("inline bool isDefinitelyTerminal(Opcode opcode)")
    line("{")
    line("switch (opcode) {")
    casesWith(true)
    line("default:")
    line("return false;")
    line("}")
    line("}")

    line("inline bool isReturn(Opcode opcode)")
    line("{")
    line("switch (opcode) {")
    casesWith(false)
    line("default:")
    line("return false;")
    line("}")
    line("}")

    line("} } } // namespace JSC::B3::Air")
    popMacros()
    line("#endif // ENABLE(B3_JIT)")
    line("")
    line("WTF_ALLOW_UNSAFE_BUFFER_USAGE_END")
}

// ---------------------------------------------------------------------------
// AirOpcodeGenerated.h

// Whether the argument ARG_INDEX of a form of OVERLOAD may be an address
// (it is Addr there, not a UseAddr).
fn admitsAddress(overload: usize, form: usize, argIndex: usize) -> bool {
    const o = overloads[overload]
    const useAddr = argIndex < o.argCount && std.text.same(args[o.argStart + argIndex].role, "UA")
    return std.text.same(kindAt(form, argIndex), "Addr") && !useAddr
}

fn admitsStack() -> void {
    line("bool Inst::admitsStack(unsigned argIndex)")
    line("{")
    line("auto args = this->args();")
    line("switch (kind.opcode) {")
    var opcode: usize = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        line(s.join3("case Opcode::", o.name, ":"))
        var numArgs: usize = 0
        var overload = o.firstOverload
        while overload != 0 {
            if overloads[overload].argCount > numArgs { numArgs = overloads[overload].argCount }
            overload = overloads[overload].next
        }
        if o.custom {
            line(s.join3("OPGEN_RETURN(", o.name, "Custom::admitsStack(*this, argIndex));"))
        } else if numArgs > 0 {
            line("switch (argIndex) {")
            var argIndex: usize = 0
            while argIndex < numArgs {
                line(s.join3("case ", number(argIndex), ":"))
                // Whether all the forms of all the overloads do, or all
                // do not, take an address there (Yes first: with no forms
                // at all, an address is not taken).
                var numYes: usize = 0
                var numNo: usize = 0
                overload = o.firstOverload
                while overload != 0 {
                    var form: usize = 0
                    while form < overloads[overload].formCount {
                        if admitsAddress(overload, overloads[overload].formStart + form, argIndex) { numYes += 1 } else { numNo += 1 }
                        form += 1
                    }
                    overload = overloads[overload].next
                }
                if numYes == 0 {
                    line("OPGEN_RETURN(false);")
                } else if numNo == 0 {
                    line("OPGEN_RETURN(true);")
                } else {
                    const needOverloadSwitch = o.overloadCount != 1
                    if needOverloadSwitch { line("switch (args.size()) {") }
                    overload = o.firstOverload
                    while overload != 0 {
                        const ov = overloads[overload]
                        var yes: usize = 0
                        var no: usize = 0
                        var form: usize = 0
                        while form < ov.formCount {
                            if admitsAddress(overload, ov.formStart + form, argIndex) { yes += 1 } else { no += 1 }
                            form += 1
                        }
                        if yes == 0 {
                            // Nothing: down to the default.
                        } else if no == 0 {
                            if needOverloadSwitch { line(s.join3("case ", number(ov.argCount), ":")) }
                            line("OPGEN_RETURN(true);")
                            if needOverloadSwitch { line("break;") }
                        } else {
                            if needOverloadSwitch { line(s.join3("case ", number(ov.argCount), ":")) }
                            // Whether a form takes the argument made an address.
                            var how = Match.{ .fast = false, .column = COLUMN_ADMITS, .callback = FORM_ADMITS, .argIndex = argIndex, .filter = true, .opcode = opcode, .overload = overload }
                            matchOverloadForms(&how, overload)
                            if needOverloadSwitch { line("break;") }
                        }
                        overload = ov.next
                    }
                    if needOverloadSwitch {
                        line("default:")
                        line("break;")
                        line("}")
                    }
                }
                line("break;")
                argIndex += 1
            }
            line("default:")
            line("break;")
            line("}")
        }
        line("break;")
        opcode += 1
    }
    line("default:")
    line("break;")
    line("}")
    line("return false;")
    line("}")
}

// An Inst function on the opcodes with an attribute (terminal; effects;
// either), and the custom ones asking their Custom.
const WITH_TERMINAL: u8 = 0
const WITH_EFFECTS: u8 = 1
const WITH_EITHER: u8 = 2

fn attributeFunction(name: []const u8, attribute: u8) -> void {
    line(s.join3("bool Inst::", name, "()"))
    line("{")
    if attribute != WITH_TERMINAL {
        line("if (kind.effects)")
        line("return true;")
    }
    line("switch (kind.opcode) {")
    var found = false
    var opcode: usize = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        const has = if attribute == WITH_TERMINAL { o.terminal } else if attribute == WITH_EFFECTS { o.effects } else { o.terminal || o.effects }
        if has {
            line(s.join3("case Opcode::", o.name, ":"))
            found = true
        }
        opcode += 1
    }
    if found { line("return true;") }
    opcode = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        if o.custom {
            line(s.join3("case Opcode::", o.name, ":"))
            line(s.join3(s.join3("return ", o.name, "Custom::"), name, "(*this);"))
        }
        opcode += 1
    }
    line("default:")
    line("return false;")
    line("}")
    line("}")
}

fn generatedHeader() -> void {
    fileStart()
    line("#include <wtf/Compiler.h>")
    line("WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN")
    line("")
    line("#if ENABLE(B3_JIT)")
    pushMacros()
    line("#include \"AirInstInlines.h\"")
    line("#include \"B3ProcedureInlines.h\"")
    line("#include \"CCallHelpers.h\"")
    line("#include \"wtf/PrintStream.h\"")
    line("namespace WTF {")
    line("void printInternal(PrintStream& out, JSC::B3::Air::Opcode opcode)")
    line("{")
    line("    switch (opcode) {")
    var opcode: usize = 0
    while opcode < opcodeCount {
        const name = opcodes[opcode].name
        line(s.join3("    case JSC::B3::Air::Opcode::", name, ":"))
        line(s.join3("        out.print(\"", name, "\");"))
        line("        return;")
        opcode += 1
    }
    line("    }")
    line("    RELEASE_ASSERT_NOT_REACHED();")
    line("}")
    line("} // namespace WTF")
    line("namespace JSC { namespace B3 { namespace Air {")

    // The role, bank and width of every argument of every overload, by
    // opcode and number of arguments (the last overload of a number).
    line(s.join3("const uint8_t g_formTable[", number(opcodeCount * ((maxNumOperands + 1) * maxNumOperands / 2)), "] = {"))
    opcode = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        var numOperands: usize = 0
        while numOperands <= maxNumOperands {
            var found: usize = 0
            if !o.custom {
                var overload = o.firstOverload
                while overload != 0 {
                    if overloads[overload].argCount == numOperands { found = overload }
                    overload = overloads[overload].next
                }
            }
            if found != 0 {
                const ov = overloads[found]
                s.out("// ")
                s.out(o.name)
                s.out(" ")
                var index: usize = 0
                while index < numOperands {
                    const arg = args[ov.argStart + index]
                    if index > 0 { s.out(", ") }
                    s.out(arg.role)
                    s.out(":")
                    s.out(arg.bank)
                    s.out(":")
                    s.out(arg.width)
                    index += 1
                }
                s.out("\n")
                index = 0
                while index < numOperands {
                    const arg = args[ov.argStart + index]
                    s.out("ENCODE_INST_FORM(Arg::")
                    s.out(roleCode(arg.role))
                    s.out(", ")
                    s.out(arg.bank)
                    s.out("P, ")
                    s.out(widthCode(arg.width))
                    s.out("), ")
                    index += 1
                }
            } else {
                line(s.join3(s.join3("// Invalid: ", o.name, " with numOperands = "), number(numOperands), ""))
                var index: usize = 0
                while index < numOperands {
                    s.out("INVALID_INST_FORM, ")
                    index += 1
                }
            }
            s.out("\n")
            numOperands += 1
        }
        opcode += 1
    }
    line("};")

    line("void Inst::forEachArgCustom(ScopedLambda<EachArgCallback> lambda)")
    line("{")
    line("switch (kind.opcode) {")
    opcode = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        if o.custom {
            line(s.join3("case Opcode::", o.name, ":"))
            line(s.join3("", o.name, "Custom::forEachArg(*this, lambda);"))
            line("break;")
        }
        opcode += 1
    }
    line("default:")
    line("dataLog(\"Bad call to forEachArgCustom, not custom opcode: \", kind, \"\\n\");")
    line("RELEASE_ASSERT_NOT_REACHED();")
    line("}")
    line("}")

    line("bool Inst::isValidForm()")
    line("{")
    line("auto args = this->args();")
    matchInstOverloadForm(false, FORM_INST_VALID)
    line("return false;")
    line("}")

    admitsStack()

    line("bool Inst::admitsExtendedOffsetAddr(unsigned argIndex)")
    line("{")
    line("switch (kind.opcode) {")
    opcode = 0
    while opcode < opcodeCount {
        const o = opcodes[opcode]
        if o.custom {
            line(s.join3("case Opcode::", o.name, ":"))
            line(s.join3("OPGEN_RETURN(", o.name, "Custom::admitsExtendedOffsetAddr(*this, argIndex));"))
            line("break;")
        }
        opcode += 1
    }
    line("default:")
    line("break;")
    line("}")
    line("return false;")
    line("}")

    attributeFunction("isTerminal", WITH_TERMINAL)
    attributeFunction("hasNonArgNonControlEffects", WITH_EFFECTS)
    attributeFunction("hasNonArgEffects", WITH_EITHER)

    line("CCallHelpers::Jump Inst::generate(CCallHelpers& jit, GenerationContext& context)")
    line("{")
    line("auto args = this->args();")
    line("UNUSED_PARAM(jit);")
    line("UNUSED_PARAM(context);")
    line("CCallHelpers::Jump result;")
    matchInstOverloadForm(true, FORM_GENERATE)
    line("RELEASE_ASSERT_NOT_REACHED();")
    line("return result;")
    line("}")

    line("} } } // namespace JSC::B3::Air")
    popMacros()
    line("")
    line("#endif // ENABLE(B3_JIT)")
    line("")
    line("WTF_ALLOW_UNSAFE_BUFFER_USAGE_END")
}

// ---------------------------------------------------------------------------

fn generate(source: []const u8, directory: []const u8) -> void {
    unsafe {
        opcodes = @ptrFromInt([*]Opcode, s.alloc(MAX_OPCODES * @sizeOf(Opcode)))
        overloads = @ptrFromInt([*]Overload, s.alloc(MAX_OVERLOADS * @sizeOf(Overload)))
        args = @ptrFromInt([*]Arg, s.alloc(MAX_ARGS * @sizeOf(Arg)))
        forms = @ptrFromInt([*]Form, s.alloc(MAX_FORMS * @sizeOf(Form)))
        kinds = @ptrFromInt([*]Kind, s.alloc(MAX_KINDS * @sizeOf(Kind)))
        archNames = @ptrFromInt([*][]const u8, s.alloc(MAX_ARCHS * @sizeOf([]const u8)))
        tokens = @ptrFromInt([*][]const u8, s.alloc(MAX_TOKENS * @sizeOf([]const u8)))
        tokenLines = @ptrFromInt([*]usize, s.alloc(MAX_TOKENS * 8))
    }
    const name = s.baseName(source)
    sourceName = name.pointer
    sourceNameLength = name.length
    lex(s.readWhole(source))
    parse()

    var opcode: usize = 0
    while opcode < opcodeCount {
        var overload = opcodes[opcode].firstOverload
        while overload != 0 {
            if overloads[overload].argCount > maxNumOperands { maxNumOperands = overloads[overload].argCount }
            overload = overloads[overload].next
        }
        opcode += 1
    }

    const prefix = s.join(directory, "/Air")
    opcodeHeader()
    const opcodeEnd = s.output().length
    utilsHeader()
    const utilsEnd = s.output().length
    generatedHeader()
    const all = s.output()
    s.writeWhole(s.join(prefix, "Opcode.h"), all[0..opcodeEnd])
    s.writeWhole(s.join(prefix, "OpcodeUtils.h"), all[opcodeEnd..utilsEnd])
    s.writeWhole(s.join(prefix, "OpcodeGenerated.h"), all[utilsEnd..all.length])
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-air-opcodes OPCODES OUTPUT_DIRECTORY\n")
        return 2
    }
    generate(std.text.cString(arguments[1]), std.text.cString(arguments[2]))
    return 0
}
