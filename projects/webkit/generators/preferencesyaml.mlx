// A reader of the YAML WebKit's preference files are written in
// (Source/WTF/Scripts/Preferences/*.yaml), giving what Ruby's YAML
// (Psych) gives for them: mappings, in their order, of block style at any
// indentation; flow sequences `[ a, b ]`; block sequences of scalars or
// blocks; scalars plain, 'single' or "double" quoted, over several lines
// folded as YAML folds them; comments.
//
// A plain scalar keeps its text, its type decided when it is asked for:
// null (empty, ~, null), true and false (yes/true/on, no/false/off, any
// case), an integer (decimal), or else a string. What the files do not
// use (block scalars | and >, flow mappings, anchors, tags, several
// documents) is refused.
const std = @import("std")
const s = @import("./support.mlx")

pub const SCALAR: u8 = 0
pub const MAPPING: u8 = 1
pub const SEQUENCE: u8 = 2

pub const NONE: usize = 18446744073709551615

pub const Node = struct {
    kind: u8
    // A scalar's text, its escapes and folds undone.
    text: []const u8
    // Whether the scalar was written without quotes.
    plain: bool
    // The key of an entry of a mapping.
    key: []const u8
    // The first entry or item, and the one after this one.
    first: usize
    next: usize
}

const MAX_NODES: usize = 1048576

pub var nodes: [*]Node = undefined
var nodeCount: usize = 0
var ready: bool = false

var source: [*]const u8 = undefined
var sourceLength: usize = 0
var sourcePath: [*]const u8 = undefined
var sourcePathLength: usize = 0
// The start of the line the reader is at.
var position: usize = 0

fn text() -> []const u8 { return source[0..sourceLength] }

fn problem(at: usize, message: []const u8) -> void {
    var line: usize = 1
    var index: usize = 0
    while index < at && index < sourceLength {
        if source[index] == 10 { line += 1 }
        index += 1
    }
    s.fail(s.join3(s.join3("error: Could not parse input file: ", sourcePath[0..sourcePathLength], ":"), s.decimal(@intCast(u64, line)), s.join(": ", message)))
}

fn newNode(kind: u8) -> usize {
    if nodeCount == MAX_NODES { s.fail("yaml: too many nodes") }
    nodes[nodeCount] = Node.{ .kind = kind, .text = "", .plain = false, .key = "", .first = NONE, .next = NONE }
    nodeCount += 1
    return nodeCount - 1
}

fn scalar(value: []const u8, plain: bool) -> usize {
    const node = newNode(SCALAR)
    nodes[node].text = value
    nodes[node].plain = plain
    return node
}

// ---------------------------------------------------------------------------
// Lines.

fn lineEnd(at: usize) -> usize {
    var end = at
    while end < sourceLength && source[end] != 10 { end += 1 }
    return end
}

fn nextLine(at: usize) -> usize {
    const end = lineEnd(at)
    return if end < sourceLength { end + 1 } else { end }
}

fn indentOf(lineStart: usize) -> usize {
    var at = lineStart
    while at < sourceLength && source[at] == 32 { at += 1 }
    return at - lineStart
}

// Whether the line holds nothing but space and perhaps a comment.
fn isEmptyLine(lineStart: usize) -> bool {
    var at = lineStart
    while at < sourceLength && (source[at] == 32 || source[at] == 9 || source[at] == 13) { at += 1 }
    return at == sourceLength || source[at] == 10 || source[at] == 35
}

// The start of the next line with something on it, from LINESTART.
fn contentLine(lineStart: usize) -> usize {
    var at = lineStart
    while at < sourceLength && isEmptyLine(at) { at = nextLine(at) }
    return at
}

fn isBlank(byte: u8) -> bool { return byte == 32 || byte == 9 }

// ---------------------------------------------------------------------------
// Scalars.

// A buffer as large as what is left of the source: a scalar never grows.
fn buffer() -> usize { return s.alloc(sourceLength + 1) }

// The scalar quoted with QUOTE at AT; END set past its closing quote.
// Line breaks fold: one becomes a space, each empty line a newline, the
// space around them dropped.
fn quoted(at: usize, end: *usize) -> []const u8 {
    const quote = source[at]
    const result = buffer()
    var written: usize = 0
    // How much is kept should the line break here (space written
    // literally at a line's end is dropped).
    var kept: usize = 0
    var index = at + 1
    while true {
        if index >= sourceLength { problem(at, "an unterminated quoted scalar") }
        const byte = source[index]
        if byte == quote {
            if quote == 39 && index + 1 < sourceLength && source[index + 1] == 39 {
                s.put8(result + written, 39)
                written += 1
                kept = written
                index += 2
                continue
            }
            index += 1
            break
        }
        if byte == 10 {
            written = kept
            index += 1
            var breaks: usize = 0
            while true {
                while index < sourceLength && isBlank(source[index]) { index += 1 }
                if index < sourceLength && source[index] == 10 {
                    breaks += 1
                    index += 1
                } else {
                    break
                }
            }
            if breaks == 0 {
                s.put8(result + written, 32)
                written += 1
            }
            while breaks > 0 {
                s.put8(result + written, 10)
                written += 1
                breaks -= 1
            }
            kept = written
            continue
        }
        if byte == 92 && quote == 34 {
            if index + 1 >= sourceLength { problem(index, "an unterminated escape") }
            const letter = source[index + 1]
            index += 2
            if letter == 10 {
                // An escaped line break: the lines join with nothing between.
                while index < sourceLength && isBlank(source[index]) { index += 1 }
                kept = written
                continue
            }
            var digits: usize = 0
            if letter == 120 { digits = 2 }
            if letter == 117 { digits = 4 }
            if letter == 85 { digits = 8 }
            var value: u32 = 0
            if digits == 0 {
                const known = escaped(letter)
                if known < 0 { problem(index, "an unknown escape") }
                value = @intCast(u32, known)
            }
            while digits > 0 {
                if index >= sourceLength { problem(index, "a short escape") }
                const number = hexDigit(source[index])
                if number < 0 { problem(index, "a bad hexadecimal escape") }
                value = value * 16 + @intCast(u32, number)
                index += 1
                digits -= 1
            }
            written += utf8(result + written, value)
            kept = written
            continue
        }
        s.put8(result + written, byte)
        written += 1
        if !isBlank(byte) { kept = written }
        index += 1
    }
    end.* = index
    return s.bytes(result, written)
}

// The character of the escape \LETTER in a double-quoted scalar, or -1.
fn escaped(letter: u8) -> i64 {
    if letter == 48 { return 0 }
    if letter == 97 { return 7 }
    if letter == 98 { return 8 }
    if letter == 116 || letter == 9 { return 9 }
    if letter == 110 { return 10 }
    if letter == 118 { return 11 }
    if letter == 102 { return 12 }
    if letter == 114 { return 13 }
    if letter == 101 { return 27 }
    if letter == 32 || letter == 34 || letter == 47 || letter == 92 { return @intCast(i64, letter) }
    if letter == 78 { return 133 }
    if letter == 95 { return 160 }
    if letter == 76 { return 8232 }
    if letter == 80 { return 8233 }
    return -1
}

fn hexDigit(digit: u8) -> i64 {
    if digit >= 48 && digit <= 57 { return @intCast(i64, digit - 48) }
    if digit >= 97 && digit <= 102 { return @intCast(i64, digit - 87) }
    if digit >= 65 && digit <= 70 { return @intCast(i64, digit - 55) }
    return -1
}

// VALUE as UTF-8 at AT; how many bytes.
fn utf8(at: usize, value: u32) -> usize {
    if value < 128 {
        s.put8(at, @intCast(u8, value))
        return 1
    }
    if value < 2048 {
        s.put8(at, @intCast(u8, 192 | (value >> 6)))
        s.put8(at + 1, @intCast(u8, 128 | (value & 63)))
        return 2
    }
    if value < 65536 {
        s.put8(at, @intCast(u8, 224 | (value >> 12)))
        s.put8(at + 1, @intCast(u8, 128 | ((value >> 6) & 63)))
        s.put8(at + 2, @intCast(u8, 128 | (value & 63)))
        return 3
    }
    s.put8(at, @intCast(u8, 240 | (value >> 18)))
    s.put8(at + 1, @intCast(u8, 128 | ((value >> 12) & 63)))
    s.put8(at + 2, @intCast(u8, 128 | ((value >> 6) & 63)))
    s.put8(at + 3, @intCast(u8, 128 | (value & 63)))
    return 4
}

// The end of a plain scalar's text on the line from AT: before a comment
// (a # after space) and the space before it. Inside a flow collection a
// comma or closing bracket ends it too.
fn plainEnd(at: usize, flow: bool) -> usize {
    var index = at
    var end = at
    while index < sourceLength && source[index] != 10 {
        const byte = source[index]
        if byte == 35 && index > at && isBlank(source[index - 1]) { break }
        if flow && (byte == 44 || byte == 93) { break }
        index += 1
        if !isBlank(byte) && byte != 13 { end = index }
    }
    return end
}

// A plain scalar from AT, its key indented by INDENT: the lines after it
// indented further go on with it, folded.
fn plain(at: usize, indent: usize) -> []const u8 {
    const first = source[at..plainEnd(at, false)]
    var line = nextLine(at)
    // Whether more lines come.
    var probe = contentLine(line)
    if probe >= sourceLength || indentOf(probe) <= indent || source[probe + indentOf(probe)] == 35 {
        position = line
        return first
    }
    const result = buffer()
    var written: usize = 0
    for byte in first {
        s.put8(result + written, byte)
        written += 1
    }
    while true {
        // Empty lines between, each a newline; none, a space.
        var breaks: usize = 0
        var next = line
        while next < sourceLength && isEmptyLine(next) && source[next + indentOf(next)] != 35 {
            breaks += 1
            next = nextLine(next)
        }
        if next >= sourceLength || indentOf(next) <= indent || source[next + indentOf(next)] == 35 { break }
        if breaks == 0 {
            s.put8(result + written, 32)
            written += 1
        }
        while breaks > 0 {
            s.put8(result + written, 10)
            written += 1
            breaks -= 1
        }
        var start = next
        while start < sourceLength && isBlank(source[start]) { start += 1 }
        const piece = source[start..plainEnd(start, false)]
        for byte in piece {
            s.put8(result + written, byte)
            written += 1
        }
        line = nextLine(next)
    }
    position = line
    return s.bytes(result, written)
}

// A block scalar, literal (|) or folded (>), its header at AT, in a node
// indented by INDENT; the lines after it indented further are its text.
// Read as libyaml reads it: the chomping indicator (- strip, + keep, or
// one line break kept), and an indentation indicator or the indentation
// of the first line with text.
fn blockScalar(at: usize, indent: usize) -> []const u8 {
    const literal = source[at] == 124
    var chomping: i64 = 0
    var increment: usize = 0
    var index = at + 1
    while index < sourceLength && (source[index] == 43 || source[index] == 45 || (source[index] >= 49 && source[index] <= 57)) {
        if source[index] == 43 {
            chomping = 1
        } else if source[index] == 45 {
            chomping = -1
        } else {
            increment = @intCast(usize, source[index] - 48)
        }
        index += 1
    }
    endOfLine(index)
    var line = position
    var textIndent = indent + increment
    if increment == 0 {
        // The widest of the empty lines first and of the first with text.
        var probe = line
        var widest: usize = 0
        while probe < sourceLength {
            const width = indentOf(probe)
            if width > widest { widest = width }
            if probe + width < sourceLength && source[probe + width] != 10 { break }
            probe = nextLine(probe)
        }
        textIndent = if widest < indent + 1 { indent + 1 } else { widest }
    }
    const result = buffer()
    var written: usize = 0
    var leadingBreak = false
    var leadingBlank = false
    var trailingBreaks = blockBreaks(&line, textIndent)
    while line < sourceLength && indentOf(line) >= textIndent {
        const content = line + textIndent
        const trailingBlank = isBlank(source[content])
        if !literal && leadingBreak && !leadingBlank && !trailingBlank {
            if trailingBreaks == 0 {
                s.put8(result + written, 32)
                written += 1
            }
        } else if leadingBreak {
            s.put8(result + written, 10)
            written += 1
        }
        while trailingBreaks > 0 {
            s.put8(result + written, 10)
            written += 1
            trailingBreaks -= 1
        }
        leadingBlank = trailingBlank
        const end = lineEnd(content)
        var each = content
        while each < end {
            s.put8(result + written, source[each])
            written += 1
            each += 1
        }
        leadingBreak = end < sourceLength
        line = nextLine(content)
        trailingBreaks = blockBreaks(&line, textIndent)
    }
    if chomping != -1 && leadingBreak {
        s.put8(result + written, 10)
        written += 1
    }
    if chomping == 1 {
        while trailingBreaks > 0 {
            s.put8(result + written, 10)
            written += 1
            trailingBreaks -= 1
        }
    }
    position = line
    return s.bytes(result, written)
}

// The empty lines of a block scalar from LINE (spaces up to TEXTINDENT
// and a line break): how many; LINE moves past them.
fn blockBreaks(line: *usize, textIndent: usize) -> usize {
    var count: usize = 0
    while line.* < sourceLength {
        var width = indentOf(line.*)
        if width > textIndent { width = textIndent }
        const after = line.* + width
        if after >= sourceLength || source[after] != 10 { break }
        count += 1
        line.* = after + 1
    }
    return count
}

// What follows a value on its line may only be space and a comment.
fn endOfLine(at: usize) -> void {
    var index = at
    while index < sourceLength && isBlank(source[index]) { index += 1 }
    if index < sourceLength && source[index] != 10 && source[index] != 13 && source[index] != 35 { problem(index, "text after a value") }
    position = nextLine(index)
}

// A flow sequence from AT (its bracket); END set past it.
fn flowSequence(at: usize, end: *usize) -> usize {
    const sequence = newNode(SEQUENCE)
    var last = NONE
    var index = at + 1
    while true {
        while index < sourceLength && (isBlank(source[index]) || source[index] == 10 || source[index] == 13) { index += 1 }
        if index >= sourceLength { problem(at, "an unterminated flow sequence") }
        if source[index] == 93 {
            index += 1
            break
        }
        var item = NONE
        if source[index] == 34 || source[index] == 39 {
            var after: usize = 0
            item = scalar(quoted(index, &after), false)
            index = after
        } else if source[index] == 91 {
            var after: usize = 0
            item = flowSequence(index, &after)
            index = after
        } else if source[index] == 123 {
            problem(index, "flow mappings are not supported")
        } else {
            const stop = plainEnd(index, true)
            item = scalar(source[index..stop], true)
            index = stop
        }
        if last == NONE { nodes[sequence].first = item } else { nodes[last].next = item }
        last = item
        while index < sourceLength && isBlank(source[index]) { index += 1 }
        if index < sourceLength && source[index] == 44 { index += 1 }
    }
    end.* = index
    return sequence
}

// The value of a key indented by INDENT, starting at AT on the key's
// line (or of a sequence item).
fn inlineValue(at: usize, indent: usize) -> usize {
    const byte = source[at]
    if byte == 34 || byte == 39 {
        var after: usize = 0
        const value = quoted(at, &after)
        endOfLine(after)
        return scalar(value, false)
    }
    if byte == 91 {
        var after: usize = 0
        const sequence = flowSequence(at, &after)
        endOfLine(after)
        return sequence
    }
    if byte == 123 { problem(at, "flow mappings are not supported") }
    if byte == 124 || byte == 62 { return scalar(blockScalar(at, indent), false) }
    if byte == 38 || byte == 42 || byte == 33 { problem(at, "anchors, aliases and tags are not supported") }
    return scalar(plain(at, indent), true)
}

// ---------------------------------------------------------------------------
// Blocks.

// The value after "key:" (or "-") with nothing more on its line: a block
// indented further, a sequence at the same indentation (after a key), or
// null.
fn blockValue(indent: usize, afterKey: bool) -> usize {
    const next = contentLine(position)
    if next < sourceLength {
        const nextIndent = indentOf(next)
        if nextIndent > indent {
            // A scalar alone on the lines after.
            if !isItem(next + nextIndent) && !isMappingLine(next + nextIndent) { return inlineValue(next + nextIndent, indent) }
            return block(nextIndent)
        }
        if afterKey && nextIndent == indent && isItem(next + nextIndent) { return sequenceBlock(indent) }
    }
    return scalar("", true)
}

fn isItem(at: usize) -> bool {
    return source[at] == 45 && (at + 1 == sourceLength || source[at + 1] == 32 || source[at + 1] == 10)
}

fn block(indent: usize) -> usize {
    const at = contentLine(position)
    if isItem(at + indent) { return sequenceBlock(indent) }
    return mappingBlock(indent, NONE)
}

fn sequenceBlock(indent: usize) -> usize {
    const sequence = newNode(SEQUENCE)
    var last = NONE
    while true {
        const line = contentLine(position)
        if line >= sourceLength || indentOf(line) != indent || !isItem(line + indent) { break }
        var at = line + indent + 1
        while at < sourceLength && isBlank(source[at]) { at += 1 }
        var item = NONE
        if at >= sourceLength || source[at] == 10 || source[at] == 35 {
            position = nextLine(at)
            item = blockValue(indent, false)
        } else {
            // "- key: value": a mapping, its keys in line with the first.
            item = if isMappingLine(at) { mappingBlock(at - line, at) } else { inlineValue(at, indent) }
        }
        if last == NONE { nodes[sequence].first = item } else { nodes[last].next = item }
        last = item
    }
    return sequence
}

// Where the colon of a plain key on the line from AT is, or NONE.
fn keyColon(at: usize) -> usize {
    var index = at
    while index < sourceLength && source[index] != 10 {
        if source[index] == 58 && (index + 1 == sourceLength || isBlank(source[index + 1]) || source[index + 1] == 10 || source[index + 1] == 13) { return index }
        if source[index] == 35 && index > at && isBlank(source[index - 1]) { return NONE }
        index += 1
    }
    return NONE
}

fn isMappingLine(at: usize) -> bool {
    if source[at] == 34 || source[at] == 39 { return true }
    return keyColon(at) != NONE
}

// The mapping of keys indented by INDENT; its first key at FIRST when
// that one is after a sequence's dash (else NONE).
fn mappingBlock(indent: usize, first: usize) -> usize {
    const mapping = newNode(MAPPING)
    var last = NONE
    var firstAt = first
    while true {
        var at = firstAt
        firstAt = NONE
        if at == NONE {
            const line = contentLine(position)
            if line >= sourceLength { break }
            const lineIndent = indentOf(line)
            if lineIndent < indent { break }
            if lineIndent > indent { problem(line, "bad indentation of a mapping entry") }
            at = line + indent
            if isItem(at) { break }
        }
        var key: []const u8 = ""
        var colon: usize = 0
        if source[at] == 34 || source[at] == 39 {
            var after: usize = 0
            key = quoted(at, &after)
            while after < sourceLength && isBlank(source[after]) { after += 1 }
            if after >= sourceLength || source[after] != 58 { problem(after, "a key without a colon") }
            colon = after
        } else {
            colon = keyColon(at)
            if colon == NONE { problem(at, "a line that is not a key: value") }
            var keyEnd = colon
            while keyEnd > at && isBlank(source[keyEnd - 1]) { keyEnd -= 1 }
            key = source[at..keyEnd]
        }
        var valueAt = colon + 1
        while valueAt < sourceLength && isBlank(source[valueAt]) { valueAt += 1 }
        var value = NONE
        if valueAt >= sourceLength || source[valueAt] == 10 || source[valueAt] == 13 || source[valueAt] == 35 {
            position = nextLine(valueAt)
            value = blockValue(indent, true)
        } else {
            value = inlineValue(valueAt, indent)
        }
        nodes[value].key = key
        if last == NONE { nodes[mapping].first = value } else { nodes[last].next = value }
        last = value
    }
    return mapping
}

// The document of the file at PATH: its top node (a null scalar when it
// is empty).
pub fn load(path: []const u8) -> usize {
    if !ready {
        unsafe { nodes = @ptrFromInt([*]Node, s.alloc(MAX_NODES * @sizeOf(Node))) }
        ready = true
    }
    const data = s.readWhole(path)
    source = data.pointer
    sourceLength = data.length
    sourcePath = path.pointer
    sourcePathLength = path.length
    position = 0
    var at = contentLine(0)
    if at < sourceLength && std.text.startsWith(source[at..sourceLength], "---") {
        position = nextLine(at)
        at = contentLine(position)
    }
    if at >= sourceLength { return scalar("", true) }
    const top = if indentOf(at) == 0 && !isItem(at) && !isMappingLine(at) { inlineValue(at, 0) } else { block(indentOf(at)) }
    const rest = contentLine(position)
    if rest < sourceLength { problem(rest, "text after the document") }
    return top
}

// ---------------------------------------------------------------------------
// Reading what was read.

// The value of KEY in MAPPING (the last, as with Ruby's Hash), or NONE.
pub fn get(mapping: usize, key: []const u8) -> usize {
    if mapping == NONE || nodes[mapping].kind != MAPPING { return NONE }
    var found = NONE
    var entry = nodes[mapping].first
    while entry != NONE {
        if std.text.same(nodes[entry].key, key) { found = entry }
        entry = nodes[entry].next
    }
    return found
}

pub fn isNull(node: usize) -> bool {
    if node == NONE { return true }
    const n = nodes[node]
    if n.kind != SCALAR || !n.plain { return false }
    return n.text.length == 0 || std.text.same(n.text, "~") || std.text.same(n.text, "null") || std.text.same(n.text, "Null") || std.text.same(n.text, "NULL")
}

fn lowerIs(text: []const u8, word: []const u8) -> bool {
    if text.length != word.length { return false }
    var index: usize = 0
    while index < text.length {
        var byte = text[index]
        if byte >= 65 && byte <= 90 { byte += 32 }
        if byte != word[index] { return false }
        index += 1
    }
    return true
}

pub fn isTrue(node: usize) -> bool {
    if node == NONE || nodes[node].kind != SCALAR || !nodes[node].plain { return false }
    const t = nodes[node].text
    return lowerIs(t, "yes") || lowerIs(t, "true") || lowerIs(t, "on")
}

pub fn isFalse(node: usize) -> bool {
    if node == NONE || nodes[node].kind != SCALAR || !nodes[node].plain { return false }
    const t = nodes[node].text
    return lowerIs(t, "no") || lowerIs(t, "false") || lowerIs(t, "off")
}

// Whether the node is there and neither null nor false (Ruby's truth).
pub fn truthy(node: usize) -> bool { return !isNull(node) && !isFalse(node) }

// A decimal integer written plainly: [-+]?(0|[1-9][0-9_]*).
fn isDecimal(text: []const u8) -> bool {
    var at: usize = 0
    if at < text.length && (text[at] == 45 || text[at] == 43) { at += 1 }
    if at == text.length { return false }
    if text[at] == 48 { return at + 1 == text.length }
    while at < text.length {
        if !s.isDigit(text[at]) && text[at] != 95 { return false }
        at += 1
    }
    return true
}

// The value as Ruby's to_s gives it: true, false, "" for null, an
// integer without its sign + and underscores, or the text.
pub fn rubyText(node: usize) -> []const u8 {
    if isNull(node) { return "" }
    if isTrue(node) { return "true" }
    if isFalse(node) { return "false" }
    const n = nodes[node]
    if n.kind == SCALAR && n.plain && isDecimal(n.text) {
        const at = s.alloc(n.text.length + 1)
        var written: usize = 0
        for byte in n.text {
            if byte != 95 && byte != 43 {
                s.put8(at + written, byte)
                written += 1
            }
        }
        return s.bytes(at, written)
    }
    return n.text
}

// The text of a scalar (its value as a Ruby string would hold it).
pub fn textOf(node: usize) -> []const u8 {
    if node == NONE { return "" }
    return nodes[node].text
}

pub fn has(mapping: usize, key: []const u8) -> bool { return get(mapping, key) != NONE }

// Whether SEQUENCE holds a scalar of text VALUE.
pub fn includes(sequence: usize, value: []const u8) -> bool {
    if sequence == NONE || nodes[sequence].kind != SEQUENCE { return false }
    var item = nodes[sequence].first
    while item != NONE {
        if nodes[item].kind == SCALAR && std.text.same(nodes[item].text, value) { return true }
        item = nodes[item].next
    }
    return false
}
