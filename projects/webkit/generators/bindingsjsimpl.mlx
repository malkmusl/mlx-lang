// CodeGeneratorJS.pm's GenerateImplementation: the JS<Name>.cpp of an
// interface (its property tables, prototype, constructor, wrapper class,
// owner and toJS functions); the getters, setters and operations are in
// bindingsjsprops.mlx.
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const js = @import("./bindingsjs.mlx")
const t = @import("./bindingsjstypes.mlx")
const d = @import("./bindingsjsdict.mlx")
const h = @import("./bindingsjsheader.mlx")
const mo = @import("./bindingsjsmore.mlx")
const pr = @import("./bindingsjsprops.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

fn cat(parts: []const Str) -> Str { return r.cat(parts) }
fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }
fn ip(text: Str) -> void { r.spush(js.implContent, text) }
fn include(name: Str) -> void { js.addToImplInclude(name) }

// What bindingsjsprops.mlx has, under the names the other modules call.
pub fn generateCallWithUsingReferences(callWith: Str, out: *StrList, returnValue: Str, thisReference: Str, callFrameReference: Str, indent: Str) -> StrList { return pr.generateCallWithUsingReferences(callWith, out, returnValue, thisReference, callFrameReference, indent) }
pub fn willConvertUndefinedToDefaultParameterValue(ty: *IDLType, defaultValue: Str) -> bool { return pr.willConvertUndefinedToDefaultParameterValue(ty, defaultValue) }
pub fn generateArgumentsCountCheck(out: *StrList, operation: *Node, interface: *Node, indent: Str) -> void { pr.generateArgumentsCountCheck(out, operation, interface, indent) }
pub fn generateOperationParametersCheck(out: *StrList, operation: *Node, interface: *Node, functionImplementationName: Str, indent: Str) -> Str { return pr.generateOperationParametersCheck(out, operation, interface, functionImplementationName, indent) }

fn conditionalFor(n: *Node) -> Str { return cg.generateConditionalString(n.*.ext) }

pub fn generateImplementation(interface: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    const interfaceName = typeName(interface)
    const className = r.c2("JS", interfaceName)
    const hasParent = interface.*.parentType != null || on(interface, "JSLegacyParent")
    const parentClassName = js.getParentClassName(interface)
    const visibleInterfaceName = cg.getVisibleInterfaceName(interface)
    const needsVisitChildren = mo.instanceNeedsVisitChildren(interface)
    const indexedGetter = mo.getIndexedGetterOperation(interface)

    r.sappend(js.implContentHeader, js.generateImplementationContentHeader(interface))
    include("JSDOMBindingFacade.h")
    include("JSDOMBinding.h")
    include("JSDOMExceptionHandling.h")
    include("JSDOMWrapperCache.h")
    include("<wtf/GetPtr.h>")
    include("<wtf/PointerPreparations.h>")
    if indexedGetter != null { include("<JavaScriptCore/PropertyNameArray.h>") }
    if interface.*.mapLike != null { include("JSDOMMapLike.h") }
    if interface.*.setLike != null { include("JSDOMSetLike.h") }
    mo.addJSBuiltinIncludesIfNeeded(interface)
    const implType = mo.getImplClassName(interface)
    if interface.*.isNamespaceObject { include(r.c2(implType, ".h")) }
    if r.same(interfaceName, "Node") { include("ElementInlines.h") }
    if r.contains(interfaceName, "Document") { include("DocumentInlines.h") }

    js.implContent.*.count = 0
    ip("\n")
    ip("namespace WebCore {\n")
    ip("using namespace JSC;\n\n")
    ip(d.generateEnumerationsImplementationContent(interface, enumerations))
    ip(d.generateDictionariesImplementationContent(interface, dictionaries))

    const numAttributes = interface.*.attributes.count
    const numOperations = interface.*.operations.count
    const operations = interface.*.operations
    const attributes = interface.*.attributes

    if numOperations > 0 {
        var inAppleCopyright = false
        ip("// Functions\n\n")
        var index: usize = 0
        while index < operations.count {
            const operation = m.node(operations, index)
            index += 1
            if operation.*.overloadIndex > 1 { continue }
            if mo.isJSBuiltin(interface, operation) { continue }
            if r.same(operation.*.name, "[Symbol.Iterator]") || r.same(operation.*.name, "[Symbol.asyncIterator]") { continue }
            if on(operation, "AppleCopyright") {
                if !inAppleCopyright {
                    ip(js.beginAppleCopyrightForHeaderFiles)
                    inAppleCopyright = true
                }
            } else if inAppleCopyright {
                ip(js.endAppleCopyright)
                inAppleCopyright = false
            }
            const conditionalAttribute = mo.getConditionalForOperationConsideringOverloads(operation)
            const conditionalString = if r.truthy(conditionalAttribute) { cg.generateConditionalStringFromAttributeValue(conditionalAttribute) } else { r.undef() }
            if r.truthy(conditionalString) { ip(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
            const functionName = mo.getFunctionName(interface, className, operation)
            ip(cat([_]Str{ "static JSC_DECLARE_HOST_FUNCTION(", functionName, ");\n" }[0..]))
            if on(operation, "DOMJIT") {
                r.setStr(js.implIncludes, "DOMJITIDLType.h", "1")
                const withoutTypeCheck = r.c2(cg.wkLcfirst(functionName), "WithoutTypeCheck")
                var signature = r.buf()
                r.add(&signature, cat([_]Str{ "extern \"C\" { static JSC_DECLARE_JIT_OPERATION_WITHOUT_WTF_INTERNAL(", withoutTypeCheck, ", JSC::EncodedJSValue, (JSC::JSGlobalObject*, ", className, "*" }[0..]))
                var a: usize = 0
                while a < operation.*.arguments.count {
                    r.add(&signature, r.c2(", ", mo.getArgumentTypeForFunctionWithoutTypeCheck(interface, m.node(operation.*.arguments, a).*.ty.?)))
                    a += 1
                }
                r.add(&signature, ")); }")
                ip(r.done(signature))
            }
            if r.truthy(conditionalString) { ip("#endif\n") }
        }
        if inAppleCopyright { ip(js.endAppleCopyright) }
        ip("\n")
    }

    if numAttributes > 0 || mo.needsConstructorProperty(interface) {
        ip("// Attributes\n\n")
        if mo.needsConstructorProperty(interface) { ip(cat([_]Str{ "static JSC_DECLARE_CUSTOM_GETTER(js", interfaceName, "Constructor);\n" }[0..])) }
        const synthetic = mo.syntheticAttributes(interface)
        var index: usize = 0
        while index < synthetic.count {
            pr.generateAttributeGetterAndSetterDeclaration(js.implContent, interface, className, m.node(synthetic, index))
            index += 1
        }
        index = 0
        while index < attributes.count {
            pr.generateAttributeGetterAndSetterDeclaration(js.implContent, interface, className, m.node(attributes, index))
            index += 1
        }
        ip("\n")
    }

    if numOperations > 0 {
        var index: usize = 0
        while index < operations.count {
            const operation = m.node(operations, index)
            index += 1
            if !on(operation, "DOMJIT") { continue }
            r.setStr(js.implIncludes, "DOMJITIDLTypeFilter.h", "1")
            r.setStr(js.implIncludes, "DOMJITAbstractHeapRepository.h", "1")
            if operation.*.overloads != null && operation.*.overloads.?.*.count > 1 { r.die("Overloads is not supported in DOMJIT") }
            if !cg.extendedAttributeContains(ext(operation, "DOMJIT"), "ReadDOM") { r.die("Currently ReadDOM value is only allowed") }
            const functionName = mo.getFunctionName(interface, className, operation)
            const withoutTypeCheck = r.c2(cg.wkLcfirst(functionName), "WithoutTypeCheck")
            const signatureName = cat([_]Str{ "DOMJITSignatureFor", interfaceName, cg.wkUcfirst(operation.*.name) }[0..])
            const classInfo = cat([_]Str{ "JS", interfaceName, "::info()" }[0..])
            const resultType = mo.getResultTypeFilter(interface, operation.*.ty.?)
            const header = cat([_]Str{ "static const JSC::DOMJIT::Signature ", signatureName, "(", withoutTypeCheck, "," }[0..])
            var footer = r.buf()
            r.add(&footer, cat([_]Str{ classInfo, ", JSC::DOMJIT::Effect::forRead(DOMJIT::AbstractHeapRepository::DOM), ", resultType }[0..]))
            var a: usize = 0
            while a < operation.*.arguments.count {
                r.add(&footer, r.c2(", ", mo.getArgumentTypeFilter(interface, m.node(operation.*.arguments, a).*.ty.?)))
                a += 1
            }
            r.add(&footer, ");")
            const conditionalString = conditionalFor(operation)
            if r.truthy(conditionalString) { ip(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
            ip(cat([_]Str{ header, " ", r.done(footer), "\n" }[0..]))
            if r.truthy(conditionalString) { ip("#endif\n") }
            ip("\n")
        }
    }

    if numAttributes > 0 || mo.needsConstructorProperty(interface) {
        var index: usize = 0
        while index < attributes.count {
            const attribute = m.node(attributes, index)
            index += 1
            if !on(attribute, "DOMJIT") { continue }
            if !cg.extendedAttributeContains(ext(attribute, "DOMJIT"), "Getter") { r.die("Only DOMJIT=Getter is supported for attributes") }
            const conditionalString = conditionalFor(attribute)
            if r.truthy(conditionalString) { ip(cat([_]Str{ "#if ", conditionalString, "\n\n" }[0..])) }
            js.addToImplIncludes("DOMJITIDLTypeFilter.h", conditionalString)
            const generatorName = r.c2(interfaceName, cg.wkUcfirst(attribute.*.name))
            const domJITClassName = r.c2(generatorName, "Attribute")
            const getter = mo.getAttributeGetterName(interface, className, attribute)
            var resultType: Str = "JSC::SpecBytecodeTop"
            if on(attribute, "DOMJIT") { resultType = mo.getResultTypeFilter(interface, attribute.*.ty.?) }
            ip(cat([_]Str{ "static const JSC::DOMJIT::GetterSetter DOMJITAttributeFor", generatorName, " {\n" }[0..]))
            ip(cat([_]Str{ "    ", getter, ",\n" }[0..]))
            ip("#if ENABLE(JIT)\n")
            ip(cat([_]Str{ "    &compile", domJITClassName, ",\n" }[0..]))
            ip("#else\n")
            ip("    nullptr,\n")
            ip("#endif\n")
            ip(cat([_]Str{ "    ", resultType, "\n" }[0..]))
            ip("};\n\n")
            if r.truthy(conditionalString) { ip("#endif\n\n") }
        }
    }

    if !mo.headerNeedsPrototypeDeclaration(interface) { mo.generatePrototypeDeclaration(js.implContent, className, interface) }
    if !on(interface, "LegacyNoInterfaceObject") { mo.generateConstructorDeclaration(js.implContent, className, interface, "") }

    var runtimeEnabledConstants = r.list()
    // Properties on the instance.
    var instance = mo.hashData()
    const numInstanceProperties = mo.generatePropertiesHashTable(interface, true, &instance)
    if numInstanceProperties > 0 { mo.generateHashTable(className, r.c2(className, "Table"), numInstanceProperties, instance.keys, instance.specials, instance.values1, instance.values2, &instance.conditionals, &instance.readWriteConditionals, false) }

    // The interface object's properties (constants, static attributes, static operations).
    if !on(interface, "LegacyNoInterfaceObject") {
        var hashSize: usize = 0
        var table = mo.hashData()
        var index: usize = 0
        while index < interface.*.constants.count {
            const constant = m.node(interface.*.constants, index)
            index += 1
            r.spush(&table.keys, constant.*.name)
            r.spush(&table.values1, constant.*.value)
            r.spush(&table.values2, "0")
            mo.pushSpecials(&table.specials, constantSpecials())
            const implementedBy = ext(constant, "ImplementedBy")
            if r.truthy(implementedBy) { r.setStr(js.implIncludes, r.c2(implementedBy, ".h"), "1") }
            const conditional = ext(constant, "Conditional")
            if r.truthy(conditional) { r.setStr(&table.conditionals, constant.*.name, conditional) }
            if mo.needsRuntimeCheck(interface, constant) { r.push(&runtimeEnabledConstants, @intFromPtr(constant)) }
            hashSize += 1
        }
        index = 0
        while index < attributes.count {
            const attribute = m.node(attributes, index)
            index += 1
            if !attribute.*.isStatic { continue }
            const name = attribute.*.name
            r.spush(&table.keys, name)
            var specials = r.strList()
            if mo.isLegacyUnforgeable(interface, attribute) { r.spush(&specials, "JSC::PropertyAttribute::DontDelete") }
            if js.isReadonly(attribute) { r.spush(&specials, "JSC::PropertyAttribute::ReadOnly") }
            if mo.isAcceleratedDOMAttribute(interface, attribute) { r.spush(&specials, "JSC::PropertyAttribute::DOMAttribute") }
            if on(attribute, "DOMJIT") { r.spush(&specials, "JSC::PropertyAttribute::DOMJITAttribute") }
            mo.pushSpecials(&table.specials, specials)
            if on(attribute, "DOMJIT") {
                r.spush(&table.values1, cat([_]Str{ "&DOMJITAttributeFor", interfaceName, cg.wkUcfirst(name) }[0..]))
            } else {
                r.spush(&table.values1, mo.getAttributeGetterName(interface, className, attribute))
            }
            if js.isReadonly(attribute) {
                r.spush(&table.values2, "0")
            } else {
                r.spush(&table.values2, mo.getAttributeSetterName(interface, className, attribute))
            }
            const conditional = ext(attribute, "Conditional")
            if r.truthy(conditional) { r.setStr(&table.conditionals, name, conditional) }
            const readWriteConditional = ext(attribute, "ConditionallyReadWrite")
            if r.truthy(readWriteConditional) { r.setStr(&table.readWriteConditionals, name, readWriteConditional) }
            hashSize += 1
        }
        index = 0
        while index < operations.count {
            const operation = m.node(operations, index)
            index += 1
            if !operation.*.isStatic { continue }
            if operation.*.overloadIndex > 1 { continue }
            const name = operation.*.name
            r.spush(&table.keys, name)
            r.spush(&table.values1, mo.getFunctionName(interface, className, operation))
            const functionLength = mo.getFunctionLength(operation)
            if on(operation, "DOMJIT") {
                r.spush(&table.values2, cat([_]Str{ "DOMJITFunctionFor", interfaceName, cg.wkUcfirst(name) }[0..]))
            } else {
                r.spush(&table.values2, r.decimal(@intCast(u64, functionLength)))
            }
            mo.pushSpecials(&table.specials, mo.computeFunctionSpecial(interface, operation))
            const conditional = ext(operation, "Conditional")
            if r.truthy(conditional) { r.setStr(&table.conditionals, name, conditional) }
            hashSize += 1
        }
        if hashSize > 0 { mo.generateHashTable(className, r.c2(className, "ConstructorTable"), hashSize, table.keys, table.specials, table.values1, table.values2, &table.conditionals, &table.readWriteConditionals, true) }
        r.sappend(js.implContent, cg.generateCompileTimeCheckForEnumsIfNeeded(interface))
        const protoClassName = r.c2(className, "Prototype")
        mo.generateConstructorDefinitions(js.implContent, className, protoClassName, visibleInterfaceName, interface, false)
        const legacyFactoryFunction = ext(interface, "LegacyFactoryFunction")
        if r.truthy(legacyFactoryFunction) { mo.generateConstructorDefinitions(js.implContent, className, protoClassName, legacyFactoryFunction, interface, true) }
    }

    // The prototype's properties.
    var prototype = mo.hashData()
    const numPrototypeProperties = mo.generatePropertiesHashTable(interface, false, &prototype)
    var hashSize = numPrototypeProperties
    var ci: usize = 0
    while ci < interface.*.constants.count {
        const constant = m.node(interface.*.constants, ci)
        ci += 1
        r.spush(&prototype.keys, constant.*.name)
        r.spush(&prototype.values1, constant.*.value)
        r.spush(&prototype.values2, "0")
        mo.pushSpecials(&prototype.specials, constantSpecials())
        const conditional = ext(constant, "Conditional")
        if r.truthy(conditional) { r.setStr(&prototype.conditionals, constant.*.name, conditional) }
        hashSize += 1
    }
    if !js.shouldUseOrdinaryObjectPrototype(interface) {
        const justGenerateValueArray = !js.isDOMGlobalObject(interface)
        mo.generateHashTable(className, r.c2(className, "PrototypeTable"), hashSize, prototype.keys, prototype.specials, prototype.values1, prototype.values2, &prototype.conditionals, &prototype.readWriteConditionals, justGenerateValueArray)
        const prototypeHashTable = if justGenerateValueArray { "nullptr" } else { cat([_]Str{ "&", className, "PrototypeTable" }[0..]) }
        ip(cat([_]Str{ "const ClassInfo ", className, "Prototype::s_info = { \"", visibleInterfaceName, "\"_s, &Base::s_info, ", prototypeHashTable, ", nullptr, CREATE_METHOD_TABLE(", className, "Prototype) };\n\n" }[0..]))
        ip(cat([_]Str{ "JSC::Structure* ", className, "Prototype::createStructure(JSC::VM& vm, JSC::JSGlobalObject* globalObject, JSC::JSValue prototype)\n" }[0..]))
        ip("{\n")
        ip("    return JSC::Structure::create(vm, globalObject, prototype, JSC::TypeInfo(JSC::ObjectType, StructureFlags), info(), JSC::NonArray);\n")
        ip("}\n\n")
        ip(cat([_]Str{ "void ", className, "Prototype::finishCreation(VM& vm)\n" }[0..]))
        ip("{\n")
        ip("    Base::finishCreation(vm);\n")
    }
    if mo.prototypeHasStaticPropertyTable(interface) && !mo.isGlobalInterface(interface) && !js.shouldUseOrdinaryObjectPrototype(interface) {
        ip(cat([_]Str{ "    reifyStaticProperties(vm, ", className, "::info(), ", className, "PrototypeTableValues, *this);\n" }[0..]))
        var runtimeEnabled = r.copyList(prototype.runtimeEnabledOperations)
        r.append(&runtimeEnabled, prototype.runtimeEnabledAttributes)
        r.append(&runtimeEnabled, runtimeEnabledConstants)
        if runtimeEnabled.count > 0 { ip("    bool hasDisabledRuntimeProperties = false;\n") }
        var index: usize = 0
        while index < runtimeEnabled.count {
            const property = m.node(runtimeEnabled, index)
            index += 1
            const conditionalString = conditionalFor(property)
            if r.truthy(conditionalString) { ip(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
            const condition = mo.generateRuntimeEnableConditionalString(interface, property, "realm()", false)
            ip(cat([_]Str{ "    if (!", condition, ") {\n" }[0..]))
            ip("        hasDisabledRuntimeProperties = true;\n")
            ip(cat([_]Str{ "        auto propertyName = Identifier::fromString(vm, \"", property.*.name, "\"_s);\n" }[0..]))
            ip("        VM::DeletePropertyModeScope scope(vm, VM::DeletePropertyMode::IgnoreConfigurable);\n")
            ip("        DeletePropertySlot slot;\n")
            ip("        JSObject::deleteProperty(this, realm(), propertyName, slot);\n")
            ip("    }\n")
            if r.truthy(conditionalString) { ip("#endif\n") }
        }
        index = 0
        while index < prototype.runtimeEnabledAttributes.count {
            const attribute = m.node(prototype.runtimeEnabledAttributes, index)
            index += 1
            if !mo.needsRuntimeReadWriteCheck(interface, attribute) { continue }
            include("WebCoreJSClientData.h")
            const condition = mo.generateRuntimeEnableConditionalString(interface, attribute, "realm()", false)
            const getter = mo.getAttributeGetterName(interface, className, attribute)
            const jscAttributes = mo.stringifyJSCAttributes(mo.getJSCAttributesForAttribute(interface, attribute))
            const conditionalString = conditionalFor(attribute)
            if r.truthy(conditionalString) { ip(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
            ip("    // Adding back attribute, but as readonly, after removing the read-write variant above. \n")
            ip(cat([_]Str{ "    if (!", condition, ")\n" }[0..]))
            if mo.isAcceleratedDOMAttribute(interface, attribute) {
                ip(cat([_]Str{ "        putDirectCustomAccessor(vm, builtinNames(vm).", attribute.*.name, "PublicName(), JSC::DOMAttributeGetterSetter::create(vm, ", getter, ", nullptr, JSC::DOMAttributeAnnotation { ", className, "::info(), nullptr }), attributesForStructure(", jscAttributes, "));\n" }[0..]))
            } else {
                ip(cat([_]Str{ "        putDirectCustomAccessor(vm, builtinNames(vm).", attribute.*.name, "PublicName(), CustomGetterSetter::create(vm, ", getter, ", nullptr), attributesForStructure(", jscAttributes, "));\n" }[0..]))
            }
            if r.truthy(conditionalString) { ip("#endif\n") }
        }
        if runtimeEnabled.count > 0 {
            ip("    if (hasDisabledRuntimeProperties && structure()->isDictionary())\n")
            ip("        flattenDictionaryObject(vm);\n")
        }
        index = 0
        while index < operations.count {
            const operation = m.node(operations, index)
            index += 1
            if !on(operation, "PrivateIdentifier") { continue }
            include("WebCoreJSClientData.h")
            const conditionalString = conditionalFor(operation)
            if r.truthy(conditionalString) { ip(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
            ip(cat([_]Str{ "    putDirect(vm, builtinNames(vm).", operation.*.name, "PrivateName(), JSFunction::create(vm, realm(), 0, String(), ", mo.getFunctionName(interface, className, operation), ", ImplementationVisibility::Public), JSC::PropertyAttribute::ReadOnly | JSC::PropertyAttribute::DontEnum);\n" }[0..]))
            if r.truthy(conditionalString) { ip("#endif\n") }
        }
        if mo.interfaceNeedsIterator(interface) {
            include("<JavaScriptCore/BuiltinNames.h>")
            if mo.isKeyValueIterableInterface(interface) || interface.*.mapLike != null {
                ip("    putDirect(vm, vm.propertyNames->iteratorSymbol, WebCore::getDirect(this, vm, vm.propertyNames->builtinNames().entriesPublicName()), static_cast<unsigned>(JSC::PropertyAttribute::DontEnum));\n")
            } else if interface.*.setLike != null {
                ip("    putDirect(vm, vm.propertyNames->iteratorSymbol, WebCore::getDirect(this, vm, vm.propertyNames->builtinNames().valuesPublicName()), static_cast<unsigned>(JSC::PropertyAttribute::DontEnum));\n")
            } else {
                include("<JavaScriptCore/ArrayPrototype.h>")
                ip("    putDirect(vm, vm.propertyNames->iteratorSymbol, WebCore::getDirect(realm()->arrayPrototype(), vm, vm.propertyNames->builtinNames().valuesPrivateName()), static_cast<unsigned>(JSC::PropertyAttribute::DontEnum));\n")
            }
        }
        if mo.interfaceNeedsAsyncIterator(interface) {
            include("<JavaScriptCore/BuiltinNames.h>")
            const enabledBySettings = ext(interface.*.asyncIterable.?, "EnabledBySetting")
            if r.truthy(enabledBySettings) { ip(cat([_]Str{ "    if (uncheckedDowncast<JSDOMGlobalObject>(realm())->scriptExecutionContext()->settingsValues().", mo.toMethodName(enabledBySettings), ")\n    " }[0..])) }
            if interface.*.asyncIterable.?.*.isKeyValue {
                ip("    putDirect(vm, vm.propertyNames->asyncIteratorSymbol, WebCore::getDirect(this, vm, vm.propertyNames->builtinNames().entriesPublicName()), static_cast<unsigned>(JSC::PropertyAttribute::DontEnum));\n")
            } else {
                ip("    putDirect(vm, vm.propertyNames->asyncIteratorSymbol, WebCore::getDirect(this, vm, vm.propertyNames->builtinNames().valuesPublicName()), static_cast<unsigned>(JSC::PropertyAttribute::DontEnum));\n")
            }
        }
        if (interface.*.iterable != null || interface.*.asyncIterable != null) && !mo.isKeyValueIterableInterface(interface) { ip("    addValueIterableMethods(*realm(), *this);\n") }
        mo.addUnscopableProperties(interface)
    }
    if visibleInterfaceName.length < 2 { r.die("JSC_TO_STRING_TAG_WITHOUT_TRANSITION() requires strings two or more characters long") }
    if !js.shouldUseOrdinaryObjectPrototype(interface) {
        ip("    WebCore::putDirectWithoutTransition(this, vm, vm.propertyNames->toStringTagSymbol, jsNontrivialString(vm, info()->className), JSC::PropertyAttribute::DontEnum | JSC::PropertyAttribute::ReadOnly);\n")
        ip("}\n\n")
    }

    ip(cat([_]Str{ "const ClassInfo ", className, "::s_info = { \"", visibleInterfaceName, "\"_s, &Base::s_info, " }[0..]))
    if numInstanceProperties > 0 { ip(cat([_]Str{ "&", className, "Table" }[0..])) } else { ip("nullptr") }
    if on(interface, "DOMJIT") {
        ip("\n")
        ip("#if ENABLE(JIT)\n")
        ip(cat([_]Str{ ", &checkSubClassSnippetFor", className, "\n" }[0..]))
        ip("#else\n")
        ip(", nullptr\n")
        ip("#endif\n")
    } else {
        ip(", nullptr")
    }
    ip(cat([_]Str{ ", CREATE_METHOD_TABLE(", className, ") };\n\n" }[0..]))

    if r.same(interfaceName, "DOMWindow") {
        js.addIncludesForImplementationTypeInImpl("JSWindowProxy")
        js.addIncludesForImplementationTypeInImpl("HTMLFrameOwnerElement")
        ip(cat([_]Str{ className, "::", className, "(VM& vm, Structure* structure, Ref<", implType, ">&& impl, JSWindowProxy* proxy)\n" }[0..]))
        ip(cat([_]Str{ "    : ", parentClassName, "(vm, structure, WTF::move(impl), proxy)\n" }[0..]))
        ip("{\n")
        ip("}\n\n")
    } else if js.shouldCreateWithJSGlobalProxy(interface) {
        js.addIncludesForImplementationTypeInImpl(interfaceName)
        ip(cat([_]Str{ className, "::", className, "(VM& vm, Structure* structure, Ref<", implType, ">&& impl)\n" }[0..]))
        ip(cat([_]Str{ "    : ", parentClassName, "(vm, structure, WTF::move(impl))\n" }[0..]))
        ip("{\n")
        ip("}\n\n")
    } else if !js.needsImplementationClass(interface) {
        ip(cat([_]Str{ className, "::", className, "(Structure* structure, JSDOMGlobalObject& globalObject)\n" }[0..]))
        ip(cat([_]Str{ "    : ", parentClassName, "(structure, globalObject) { }\n\n" }[0..]))
    } else {
        ip(cat([_]Str{ className, "::", className, "(Structure* structure, JSDOMGlobalObject& globalObject, Ref<", implType, ">&& impl)\n" }[0..]))
        ip(cat([_]Str{ "    : ", parentClassName, "(structure, globalObject, WTF::move(impl))\n" }[0..]))
        ip("{\n")
        ip("}\n\n")
    }

    var finishCreation = r.strList()
    js.hasNonTrivialFinishCreation = false
    js.hasNonDefaultFinishCreation = false
    if r.same(interfaceName, "DOMWindow") {
        r.spush(&finishCreation, cat([_]Str{ "void ", className, "::finishCreation(VM& vm, JSWindowProxy* proxy)\n" }[0..]))
        r.spush(&finishCreation, "{\n")
        r.spush(&finishCreation, "    Base::finishCreation(vm, proxy);\n\n")
        r.spush(&finishCreation, "    auto* scriptExecutionContext = realm()->scriptExecutionContext();\n\n")
        js.hasNonDefaultFinishCreation = true
    } else if js.shouldCreateWithJSGlobalProxy(interface) {
        r.spush(&finishCreation, cat([_]Str{ "void ", className, "::finishCreation(VM& vm, JSGlobalProxy* proxy)\n" }[0..]))
        r.spush(&finishCreation, "{\n")
        r.spush(&finishCreation, "    Base::finishCreation(vm, proxy);\n\n")
        js.hasNonDefaultFinishCreation = true
    } else {
        r.spush(&finishCreation, cat([_]Str{ "void ", className, "::finishCreation(VM& vm)\n" }[0..]))
        r.spush(&finishCreation, "{\n")
        r.spush(&finishCreation, "    Base::finishCreation(vm);\n")
        r.spush(&finishCreation, "    ASSERT(inherits(info()));\n\n")
    }
    if !cg.inheritsExtendedAttribute(interface, "JSBuiltin") {
        include("ActiveDOMObject.h")
        if cg.inheritsExtendedAttribute(interface, "ActiveDOMObject") {
            ip(cat([_]Str{ "static_assert(std::is_base_of<ActiveDOMObject, ", implType, ">::value, \"Interface is marked as [ActiveDOMObject] but implementation class does not subclass ActiveDOMObject.\");\n\n" }[0..]))
        } else if !cg.inheritsExtendedAttribute(interface, "CustomIsReachable") {
            ip(cat([_]Str{ "static_assert(!std::is_base_of<ActiveDOMObject, ", implType, ">::value, \"Interface is not marked as [ActiveDOMObject] even though implementation class subclasses ActiveDOMObject.\");\n\n" }[0..]))
        }
    }
    if r.same(interfaceName, "Location") {
        r.spush(&finishCreation, "    putDirect(vm, vm.propertyNames->valueOf, realm()->objectProtoValueOfFunction(), JSC::PropertyAttribute::DontDelete | JSC::PropertyAttribute::ReadOnly | JSC::PropertyAttribute::DontEnum);\n")
        r.spush(&finishCreation, "    putDirect(vm, vm.propertyNames->toPrimitiveSymbol, jsUndefined(), JSC::PropertyAttribute::DontDelete | JSC::PropertyAttribute::ReadOnly | JSC::PropertyAttribute::DontEnum);\n")
        js.hasNonTrivialFinishCreation = true
    }
    var index: usize = 0
    while index < attributes.count {
        const attribute = m.node(attributes, index)
        index += 1
        if !mo.needsRuntimeCheck(interface, attribute) { continue }
        if !mo.attributeShouldBeOnInstance(interface, attribute) { continue }
        include("WebCoreJSClientData.h")
        const condition = mo.generateRuntimeEnableConditionalString(interface, attribute, "realm()", true)
        const attributeName = attribute.*.name
        const getter = mo.getAttributeGetterName(interface, className, attribute)
        const setter = if js.isReadonly(attribute) || cg.isConstructorType(attribute.*.ty.?) { "nullptr" } else { mo.getAttributeSetterName(interface, className, attribute) }
        const jscAttributes = mo.stringifyJSCAttributes(mo.getJSCAttributesForAttribute(interface, attribute))
        const isPrivateAndPublic = on(attribute, "PublicIdentifier") && on(attribute, "PrivateIdentifier")
        const conditionalString = conditionalFor(attribute)
        if r.truthy(conditionalString) { r.spush(&finishCreation, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
        r.spush(&finishCreation, cat([_]Str{ "    if (", condition, ")" }[0..]))
        if isPrivateAndPublic { r.spush(&finishCreation, " {") }
        r.spush(&finishCreation, "\n")
        if mo.isAcceleratedDOMAttribute(interface, attribute) { r.die("CustomGetterSetter is not allowed for DOMAttribute. DOMAttributeGetterSetter must be used.") }
        if on(attribute, "PublicIdentifier") || !on(attribute, "PrivateIdentifier") {
            r.spush(&finishCreation, cat([_]Str{ "        putDirectCustomAccessor(vm, builtinNames(vm).", attributeName, "PublicName(), CustomGetterSetter::create(vm, ", getter, ", ", setter, "), attributesForStructure(", jscAttributes, "));\n" }[0..]))
        }
        if on(attribute, "PrivateIdentifier") {
            r.spush(&finishCreation, cat([_]Str{ "        putDirectCustomAccessor(vm, builtinNames(vm).", attributeName, "PrivateName(), CustomGetterSetter::create(vm, ", getter, ", ", setter, "), attributesForStructure(", jscAttributes, "));\n" }[0..]))
        }
        if isPrivateAndPublic { r.spush(&finishCreation, "    }\n") }
        if r.truthy(conditionalString) { r.spush(&finishCreation, "#endif\n") }
        js.hasNonTrivialFinishCreation = true
    }
    index = 0
    while index < attributes.count {
        const attribute = m.node(attributes, index)
        index += 1
        if mo.needsRuntimeCheck(interface, attribute) { continue }
        if !on(attribute, "PrivateIdentifier") { continue }
        if !mo.attributeShouldBeOnInstance(interface, attribute) { continue }
        include("WebCoreJSClientData.h")
        const conditionalString = conditionalFor(attribute)
        const getter = mo.getAttributeGetterName(interface, className, attribute)
        if r.truthy(conditionalString) { r.spush(&finishCreation, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
        if mo.isAcceleratedDOMAttribute(interface, attribute) { r.die("CustomGetterSetter is not allowed for DOMAttribute. DOMAttributeGetterSetter must be used.") }
        r.spush(&finishCreation, cat([_]Str{ "    putDirectCustomAccessor(vm, builtinNames(vm).", attribute.*.name, "PrivateName(), CustomGetterSetter::create(vm, ", getter, ", nullptr), attributesForStructure(JSC::PropertyAttribute::DontDelete | JSC::PropertyAttribute::ReadOnly));\n" }[0..]))
        if r.truthy(conditionalString) { r.spush(&finishCreation, "#endif\n") }
        js.hasNonTrivialFinishCreation = true
    }
    index = 0
    while index < operations.count {
        const operation = m.node(operations, index)
        index += 1
        if !mo.needsRuntimeCheck(interface, operation) { continue }
        if !mo.operationShouldBeOnInstance(interface, operation) { continue }
        if operation.*.overloadIndex > 1 { continue }
        include("WebCoreJSClientData.h")
        const condition = mo.generateRuntimeEnableConditionalString(interface, operation, "realm()", true)
        const implementationFunction = mo.getFunctionName(interface, className, operation)
        const functionLength = r.decimal(@intCast(u64, mo.getFunctionLength(operation)))
        const jsAttributes = mo.stringifyJSCAttributes(mo.computeFunctionSpecial(interface, operation))
        const conditionalString = conditionalFor(operation)
        if r.truthy(conditionalString) { r.spush(&finishCreation, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
        r.spush(&finishCreation, cat([_]Str{ "    if (", condition, ")\n" }[0..]))
        const propertyName = cat([_]Str{ "builtinNames(vm).", operation.*.name, if on(operation, "PrivateIdentifier") { "PrivateName()" } else { "PublicName()" } }[0..])
        if mo.isJSBuiltin(interface, operation) {
            r.spush(&finishCreation, cat([_]Str{ "        putDirectBuiltinFunction(vm, this, ", propertyName, ", ", implementationFunction, "(vm), attributesForStructure(", jsAttributes, "));\n" }[0..]))
        } else {
            r.spush(&finishCreation, cat([_]Str{ "        putDirectNativeFunction(vm, this, ", propertyName, ", ", functionLength, ", ", implementationFunction, ", ImplementationVisibility::Public, NoIntrinsic, attributesForStructure(", jsAttributes, "));\n" }[0..]))
        }
        if r.truthy(conditionalString) { r.spush(&finishCreation, "#endif\n") }
        js.hasNonTrivialFinishCreation = true
    }
    if on(interface, "ReportExtraMemoryCost") {
        r.spush(&finishCreation, "    vm.heap.reportExtraMemoryAllocated(this, wrapped().memoryCost());\n")
        js.hasNonTrivialFinishCreation = true
    }
    r.spush(&finishCreation, "}\n")
    if js.hasNonTrivialFinishCreation || js.hasNonDefaultFinishCreation {
        if !js.hasNonTrivialFinishCreation { ip("#if ASSERT_ENABLED\n") }
        r.sappend(js.implContent, finishCreation)
        if !js.hasNonTrivialFinishCreation { ip("#endif\n") }
        ip("\n")
    }

    include("JSDOMBindingFacade.h")
    if r.same(interfaceName, "DOMWindow") {
        ip(cat([_]Str{ className, "* ", className, "::create(JSC::VM& vm, JSC::Structure* structure, Ref<", implType, ">&& impl, JSWindowProxy* proxy)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    ", className, "* ptr = new (NotNull, JSC::allocateCell<", className, ">(vm)) ", className, "(vm, structure, WTF::move(impl), proxy);\n" }[0..]))
        ip("    ptr->finishCreation(vm, proxy);\n")
        ip("    return ptr;\n")
        ip("}\n\n")
    } else if js.shouldCreateWithJSGlobalProxy(interface) {
        ip(cat([_]Str{ className, "* ", className, "::create(JSC::VM& vm, JSC::Structure* structure, Ref<", implType, ">&& impl, JSC::JSGlobalProxy* proxy)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    ", className, "* ptr = new (NotNull, JSC::allocateCell<", className, ">(vm)) ", className, "(vm, structure, WTF::move(impl));\n" }[0..]))
        ip("    ptr->finishCreation(vm, proxy);\n")
        ip("    return ptr;\n")
        ip("}\n\n")
    } else if on(interface, "MasqueradesAsUndefined") {
        ip(cat([_]Str{ className, "* ", className, "::create(JSC::Structure* structure, JSDOMGlobalObject* globalObject, Ref<", implType, ">&& impl)\n" }[0..]))
        ip("{\n")
        ip("    SUPPRESS_UNCOUNTED_LOCAL auto& vm = globalObject->vm();\n")
        ip("    globalObject->masqueradesAsUndefinedWatchpointSet().fireAll(vm, \"Allocated masquerading object\");\n")
        ip(cat([_]Str{ "    ", className, "* ptr = new (NotNull, JSC::allocateCell<", className, ">(vm)) ", className, "(structure, *globalObject, WTF::move(impl));\n" }[0..]))
        ip("    ptr->finishCreation(vm);\n")
        ip("    return ptr;\n")
        ip("}\n\n")
    } else if !js.needsImplementationClass(interface) {
        ip(cat([_]Str{ className, "* ", className, "::create(JSC::Structure* structure, JSDOMGlobalObject* globalObject)\n" }[0..]))
        ip("{\n")
        ip("    SUPPRESS_UNCOUNTED_LOCAL auto& vm = globalObject->vm();\n")
        ip(cat([_]Str{ "    ", className, "* ptr = new (NotNull, JSC::allocateCell<", className, ">(vm)) ", className, "(structure, *globalObject);\n" }[0..]))
        ip("    ptr->finishCreation(vm);\n")
        ip("    return ptr;\n")
        ip("}\n\n")
    } else {
        ip(cat([_]Str{ className, "* ", className, "::create(JSC::Structure* structure, JSDOMGlobalObject* globalObject, Ref<", implType, ">&& impl)\n" }[0..]))
        ip("{\n")
        ip("    SUPPRESS_UNCOUNTED_LOCAL auto& vm = globalObject->vm();\n")
        ip(cat([_]Str{ "    ", className, "* ptr = new (NotNull, JSC::allocateCell<", className, ">(vm)) ", className, "(structure, *globalObject, WTF::move(impl));\n" }[0..]))
        ip("    ptr->finishCreation(vm);\n")
        ip("    return ptr;\n")
        ip("}\n\n")
    }

    include("JSDOMBindingFacade.h")
    ip(cat([_]Str{ "JSC::Structure* ", className, "::createStructure(JSC::VM& vm, JSC::JSGlobalObject* globalObject, JSC::JSValue prototype)\n" }[0..]))
    ip("{\n")
    const indexingMode = if mo.instanceOverridesGetOwnPropertySlot(interface) { "JSC::MayHaveIndexedAccessors" } else { "JSC::NonArray" }
    if js.isDOMGlobalObject(interface) {
        ip(cat([_]Str{ "    return JSC::Structure::create(vm, globalObject, prototype, JSC::TypeInfo(JSC::GlobalObjectType, StructureFlags), info(), ", indexingMode, ");\n" }[0..]))
    } else if cg.inheritsInterface(interface, "Node") {
        ip(cat([_]Str{ "    return JSC::Structure::create(vm, globalObject, prototype, JSC::TypeInfo(JSC::JSType(", h.getJSTypeForNode(interface), "), StructureFlags), info(), ", indexingMode, ");\n" }[0..]))
    } else if cg.inheritsInterface(interface, "Event") {
        ip(cat([_]Str{ "    return JSC::Structure::create(vm, globalObject, prototype, JSC::TypeInfo(JSC::JSType(JSEventType), StructureFlags), info(), ", indexingMode, ");\n" }[0..]))
    } else if on(interface, "EmbedderArrayLike") {
        ip(cat([_]Str{ "    return JSC::Structure::create(vm, globalObject, prototype, JSC::TypeInfo(JSC::JSType(JSEmbedderArrayLikeType), StructureFlags), info(), ", indexingMode, ");\n" }[0..]))
    } else {
        ip(cat([_]Str{ "    return JSC::Structure::create(vm, globalObject, prototype, JSC::TypeInfo(JSC::ObjectType, StructureFlags), info(), ", indexingMode, ");\n" }[0..]))
    }
    ip("}\n\n")

    if !(js.shouldUseGlobalObjectPrototype(interface) || js.shouldUseOrdinaryObjectPrototype(interface)) {
        ip(cat([_]Str{ "JSObject* ", className, "::createPrototype(VM& vm, JSDOMGlobalObject& globalObject)\n" }[0..]))
        ip("{\n")
        if interface.*.parentType != null {
            ip(cat([_]Str{ "    auto* structure = ", className, "Prototype::createStructure(vm, &globalObject, JS", interface.*.parentType.?.*.name, "::prototype(vm, globalObject));\n" }[0..]))
        } else {
            const proto = if on(interface, "Exception") { "WebCore::storedPrototypeObject(globalObject.errorStructure())" } else { "globalObject.objectPrototype()" }
            ip(cat([_]Str{ "    auto* structure = ", className, "Prototype::createStructure(vm, &globalObject, ", proto, ");\n" }[0..]))
        }
        ip("    structure->setMayBePrototype(true);\n")
        ip(cat([_]Str{ "    return ", className, "Prototype::create(vm, &globalObject, structure);\n" }[0..]))
        ip("}\n\n")
        ip(cat([_]Str{ "JSObject* ", className, "::prototype(VM& vm, JSDOMGlobalObject& globalObject)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    return getDOMPrototype<", className, ">(vm, globalObject);\n" }[0..]))
        ip("}\n\n")
    }

    if !on(interface, "LegacyNoInterfaceObject") {
        include("JSDOMGlobalObjectInlines.h")
        ip(cat([_]Str{ "JSValue ", className, "::getConstructor(VM& vm, const JSGlobalObject* globalObject)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    return getDOMConstructor<", className, "DOMConstructor, DOMConstructorID::", interfaceName, ">(vm, *uncheckedDowncast<JSDOMGlobalObject>(globalObject));\n" }[0..]))
        ip("}\n\n")
        if on(interface, "LegacyFactoryFunction") {
            ip(cat([_]Str{ "JSValue ", className, "::getLegacyFactoryFunction(VM& vm, JSGlobalObject* globalObject)\n" }[0..]))
            ip("{\n")
            ip(cat([_]Str{ "    return getDOMConstructor<", className, "LegacyFactoryFunction, DOMConstructorID::", interfaceName, "LegacyFactory>(vm, *uncheckedDowncast<JSDOMGlobalObject>(globalObject));\n" }[0..]))
            ip("}\n\n")
        }
    }

    if !hasParent {
        ip(cat([_]Str{ "void ", className, "::destroy(JSC::JSCell* cell)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    SUPPRESS_MEMORY_UNSAFE_CAST ", className, "* thisObject = static_cast<", className, "*>(cell);\n" }[0..]))
        ip(cat([_]Str{ "    thisObject->", className, "::~", className, "();\n" }[0..]))
        ip("}\n\n")
    }

    if mo.instanceOverridesGetOwnPropertySlot(interface) {
        js.generateGetOwnPropertySlot(js.implContent, interface, className)
        js.generateGetOwnPropertySlotByIndex(js.implContent, interface, className)
    }
    if mo.instanceOverridesGetOwnPropertyNames(interface) { js.generateGetOwnPropertyNames(js.implContent, interface, className) }
    if mo.instanceOverridesPut(interface) {
        js.generatePut(js.implContent, interface, className)
        js.generatePutByIndex(js.implContent, interface, className)
    }
    if mo.instanceOverridesDefineOwnProperty(interface) { js.generateDefineOwnProperty(js.implContent, interface, className) }
    if mo.instanceOverridesDeleteProperty(interface) { js.generateDeletePropertyDefinition(js.implContent, interface, className) }
    if mo.instanceOverridesGetCallData(interface) { pr.generateGetCallData(js.implContent, interface, className) }
    if numAttributes > 0 { include("JSDOMAttribute.h") }
    if numOperations > 0 && !r.same(interfaceName, "EventTarget") { include("JSDOMOperation.h") }

    if mo.needsConstructorProperty(interface) {
        const constructorGetter = cat([_]Str{ "js", interfaceName, "Constructor" }[0..])
        ip(cat([_]Str{ "JSC_DEFINE_CUSTOM_GETTER(", constructorGetter, ", (JSGlobalObject* lexicalGlobalObject, EncodedJSValue thisValue, PropertyName))\n" }[0..]))
        ip("{\n")
        ip("    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
        ip("    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
        ip(cat([_]Str{ "    auto* prototype = dynamicDowncast<", className, "Prototype>(JSValue::decode(thisValue));\n" }[0..]))
        ip("    if (!prototype) [[unlikely]]\n")
        ip("        return throwVMTypeError(lexicalGlobalObject, throwScope);\n")
        ip(cat([_]Str{ "    return JSValue::encode(", className, "::getConstructor(vm, prototype->realm()));\n" }[0..]))
        ip("}\n\n")
    }

    const synthetic = mo.syntheticAttributes(interface)
    index = 0
    while index < synthetic.count + attributes.count {
        const attribute = if index < synthetic.count { m.node(synthetic, index) } else { m.node(attributes, index - synthetic.count) }
        index += 1
        pr.generateAttributeGetterDefinition(js.implContent, interface, className, attribute, enumerations)
        pr.generateAttributeSetterDefinition(js.implContent, interface, className, attribute)
    }
    index = 0
    while index < operations.count {
        pr.generateOperationDefinition(js.implContent, interface, className, m.node(operations, index))
        index += 1
    }
    if interface.*.iterable != null { pr.generateIterableDefinition(interface) }
    if interface.*.asyncIterable != null { pr.generateAsyncIterableDefinition(interface) }

    include("ExtendedDOMClientIsoSubspaces.h")
    include("ExtendedDOMIsoSubspaces.h")
    include("WebCoreJSClientData.h")
    include("<JavaScriptCore/JSDestructibleObjectHeapCellType.h>")
    include("<JavaScriptCore/SlotVisitorMacros.h>")
    include("<JavaScriptCore/SubspaceInlines.h>")
    ip(cat([_]Str{ "JSC::GCClient::IsoSubspace* ", className, "::subspaceForImpl(JSC::VM& vm)\n" }[0..]))
    ip("{\n")
    const isGlobal = js.isDOMGlobalObject(interface)
    ip(cat([_]Str{ "    return WebCore::subspaceForImpl<", className, ", UseCustomHeapCellType::", if isGlobal { "Yes" } else { "No" }, ">(vm, \"", className, "\"_s,\n" }[0..]))
    ip(cat([_]Str{ "        [] (auto& spaces) { return spaces.m_clientSubspaceFor", interfaceName, ".get(); },\n" }[0..]))
    ip(cat([_]Str{ "        [] (auto& spaces, auto&& space) { spaces.m_clientSubspaceFor", interfaceName, " = std::forward<decltype(space)>(space); },\n" }[0..]))
    ip(cat([_]Str{ "        [] (auto& spaces) { return spaces.m_subspaceFor", interfaceName, ".get(); },\n" }[0..]))
    ip(cat([_]Str{ "        [] (auto& spaces, auto&& space) { spaces.m_subspaceFor", interfaceName, " = std::forward<decltype(space)>(space); }", if isGlobal { "," } else { "" }, "\n" }[0..]))
    if isGlobal { ip(cat([_]Str{ "        [] (auto& server) -> JSC::HeapCellType& { return server.m_heapCellTypeFor", className, "; }\n" }[0..])) }
    ip("    );\n")
    ip("}\n\n")

    if needsVisitChildren {
        ip("template<typename Visitor>\n")
        ip(cat([_]Str{ "void ", className, "::visitChildrenImpl(JSCell* cell, Visitor& visitor)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(cell);\n" }[0..]))
        ip("    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n")
        ip("    Base::visitChildren(thisObject, visitor);\n")
        if on(interface, "JSCustomMarkFunction") { ip("    thisObject->visitAdditionalChildrenInGCThread(visitor);\n") }
        if on(interface, "GenerateAddOpaqueRoot") {
            include("<wtf/GetPtr.h>")
            include("WebCoreOpaqueRootInlines.h")
            var functionName = ext(interface, "GenerateAddOpaqueRoot")
            if r.same(functionName, "VALUE_IS_MISSING") { functionName = "opaqueRoot" }
            ip(cat([_]Str{ "    addWebCoreOpaqueRoot(visitor, thisObject->wrapped().", functionName, "());\n" }[0..]))
        }
        if on(interface, "ReportExtraMemoryCost") {
            ip("    visitor.reportExtraMemoryVisited(thisObject->wrapped().memoryCost());\n")
            if on(interface, "ReportExternalMemoryCost") {
                ip("#if ENABLE(RESOURCE_USAGE)\n")
                ip("    visitor.reportExternalMemoryVisited(thisObject->wrapped().externalMemoryCost());\n")
                ip("#endif\n")
            }
        }
        index = 0
        while index < attributes.count {
            const attribute = m.node(attributes, index)
            index += 1
            if on(attribute, "CachedAttribute") {
                const conditionalString = conditionalFor(attribute)
                if r.truthy(conditionalString) { ip(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
                ip(cat([_]Str{ "    visitor.append(thisObject->m_", attribute.*.name, ");\n" }[0..]))
                if r.truthy(conditionalString) { ip("#endif\n") }
            }
        }
        ip("}\n\n")
        ip(cat([_]Str{ "DEFINE_VISIT_CHILDREN(", className, ");\n\n" }[0..]))
        if on(interface, "JSCustomMarkFunction") {
            ip("template<typename Visitor>\n")
            ip(cat([_]Str{ "void ", className, "::visitOutputConstraints(JSCell* cell, Visitor& visitor)\n" }[0..]))
            ip("{\n")
            ip(cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(cell);\n" }[0..]))
            ip("    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n")
            ip("    Base::visitOutputConstraints(thisObject, visitor);\n")
            ip("    thisObject->visitAdditionalChildrenInGCThread(visitor);\n")
            ip("}\n\n")
            ip(cat([_]Str{ "template void ", className, "::visitOutputConstraints(JSCell*, AbstractSlotVisitor&);\n" }[0..]))
            ip(cat([_]Str{ "template void ", className, "::visitOutputConstraints(JSCell*, SlotVisitor&);\n" }[0..]))
        }
    }

    if mo.instanceNeedsEstimatedSize(interface) {
        ip(cat([_]Str{ "size_t ", className, "::estimatedSize(JSCell* cell, VM& vm)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(cell);\n" }[0..]))
        ip("    return Base::estimatedSize(thisObject, vm) + thisObject->wrapped().memoryCost();\n")
        ip("}\n\n")
    }

    if js.needsImplementationClass(interface) && !on(interface, "CustomHeapSnapshot") {
        include("<JavaScriptCore/HeapAnalyzer.h>")
        include("ContextDestructionObserverInlines.h")
        include("ScriptExecutionContext.h")
        include("<wtf/URL.h>")
        include("<wtf/text/MakeString.h>")
        ip(cat([_]Str{ "void ", className, "::analyzeHeap(JSCell* cell, HeapAnalyzer& analyzer)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(cell);\n" }[0..]))
        ip("    analyzer.setWrappedObjectForCell(cell, &thisObject->wrapped());\n")
        ip("    if (RefPtr context = thisObject->scriptExecutionContext())\n")
        ip("        analyzer.setLabelForCell(cell, makeString(\"url \"_s, context->url().string()));\n")
        ip("    Base::analyzeHeap(cell, analyzer);\n")
        ip("}\n\n")
    }

    if on(interface, "GenerateForEachEventHandlerContentAttribute") { pr.generateForEachEventHandlerContentAttribute(js.implContent, interface, className, "forEachEventHandlerContentAttribute", r.undef()) }
    if on(interface, "GenerateForEachWindowEventHandlerContentAttribute") { pr.generateForEachEventHandlerContentAttribute(js.implContent, interface, className, "forEachWindowEventHandlerContentAttribute", "WindowEventHandler") }

    if indexedGetter != null {
        if r.same(typeName(indexedGetter.?), "DOMString") { r.setStr(js.implIncludes, "<wtf/URL.h>", "1") }
        if (r.startsWith(interfaceName, "HTML") && r.endsWith(interfaceName, "Collection") && isWordName(interfaceName)) || r.same(interfaceName, "RadioNodeList") {
            r.setStr(js.implIncludes, "JSNode.h", "1")
            r.setStr(js.implIncludes, "Node.h", "1")
        }
    }

    if mo.shouldGenerateWrapperOwnerCode(hasParent, interface) { ip(cat([_]Str{ "JS", interfaceName, "Owner::JS", interfaceName, "Owner(ClangVTableWorkaroundTag) { }\n\n" }[0..])) }

    if mo.shouldGenerateWrapperOwnerCode(hasParent, interface) && !r.truthy(js.getCustomIsReachable(interface)) {
        generateIsReachable(interface, interfaceName, implType)
    }

    if mo.shouldGenerateWrapperOwnerCode(hasParent, interface) && !on(interface, "JSCustomFinalize") {
        ip(cat([_]Str{ "void JS", interfaceName, "Owner::finalize(JSC::Handle<JSC::Unknown> handle, void* context)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    SUPPRESS_MEMORY_UNSAFE_CAST auto* js", interfaceName, " = static_cast<JS", interfaceName, "*>(handle.slot()->asCell());\n" }[0..]))
        ip("    auto& world = *static_cast<DOMWrapperWorld*>(context);\n")
        ip(cat([_]Str{ "    SUPPRESS_UNCOUNTED_ARG uncacheWrapper(world, &js", interfaceName, "->wrapped(), js", interfaceName, ");\n" }[0..]))
        ip("}\n\n")
    }

    if mo.shouldGenerateToJSImplementation(hasParent, interface) { generateToJS(interface, interfaceName, implType) }

    if js.shouldGenerateToWrapped(hasParent, interface) && !on(interface, "JSCustomToNativeObject") {
        ip(cat([_]Str{ implType, "* ", className, "::toWrapped(JSC::VM&, JSC::JSValue value)\n" }[0..]))
        ip("{\n")
        ip(cat([_]Str{ "    if (auto* wrapper = ", mo.getCastingHelperForThisObject(interface), "(value))\n" }[0..]))
        ip("        return &wrapper->wrapped();\n")
        ip("    return nullptr;\n")
        ip("}\n")
    }
    ip("\n}\n")
    const conditionalString = conditionalFor(interface)
    if r.truthy(conditionalString) { ip(cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
}

fn isWordName(name: Str) -> bool {
    for byte in name {
        if !r.isWord(byte) { return false }
    }
    return true
}

fn constantSpecials() -> StrList {
    var specials = r.strList()
    r.spush(&specials, "PropertyAttribute::ReadOnly")
    r.spush(&specials, "PropertyAttribute::DontDelete")
    r.spush(&specials, "PropertyAttribute::ConstantInteger")
    return specials
}

fn generateIsReachable(interface: *Node, interfaceName: Str, implType: Str) -> void {
    ip(cat([_]Str{ "bool JS", interfaceName, "Owner::isReachableFromOpaqueRoots(JSC::Handle<JSC::Unknown> handle, void*, AbstractSlotVisitor& visitor, ASCIILiteral* reason)\n" }[0..]))
    ip("{\n")
    var emittedJSCast = false
    if cg.inheritsExtendedAttribute(interface, "ActiveDOMObject") {
        ip(cat([_]Str{ "    SUPPRESS_UNCOUNTED_LOCAL auto* js", interfaceName, " = uncheckedDowncast<JS", interfaceName, ">(handle.slot()->asCell());\n" }[0..]))
        emittedJSCast = true
        ip(cat([_]Str{ "    SUPPRESS_UNCOUNTED_LOCAL auto& wrapped = js", interfaceName, "->wrapped();\n" }[0..]))
        ip("    if (!wrapped.isContextStopped() && wrapped.hasPendingActivity()) {\n")
        ip("        if (reason) [[unlikely]]\n")
        ip("            *reason = \"ActiveDOMObject with pending activity\"_s;\n")
        ip("        return true;\n")
        ip("     }\n")
    }
    const cast = cat([_]Str{ "    auto* js", interfaceName, " = uncheckedDowncast<JS", interfaceName, ">(handle.slot()->asCell());\n" }[0..])
    if cg.inheritsInterface(interface, "Node") {
        if !emittedJSCast {
            ip(cast)
            emittedJSCast = true
        }
        ip("    if (JSNodeOwner::isReachableFromOpaqueRoots(handle, 0, visitor, reason))\n")
        ip("        return true;\n")
    }
    const reachable = js.getGenerateIsReachable(interface)
    if r.truthy(reachable) {
        include("WebCoreOpaqueRootInlines.h")
        if !emittedJSCast {
            ip(cast)
            emittedJSCast = true
        }
        const j = r.c2("js", interfaceName)
        var root = r.buf()
        if r.same(reachable, "Impl") {
            r.add(&root, cat([_]Str{ "    ", implType, "* owner = &", j, "->wrapped();\n" }[0..]))
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, cat([_]Str{ "        *reason = \"Reachable from ", interfaceName, "\"_s;\n" }[0..]))
        } else if r.same(reachable, "ReachableFromDOMWindow") {
            r.add(&root, cat([_]Str{ "    auto* owner = WTF::getPtr(", j, "->wrapped().window());\n" }[0..]))
            r.add(&root, "    if (!owner)\n")
            r.add(&root, "        return false;\n")
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, "        *reason = \"Reachable from Window\"_s;\n")
        } else if r.same(reachable, "ReachableFromNavigator") {
            r.setStr(js.implIncludes, "Navigator.h", "1")
            r.setStr(js.implIncludes, "WorkerNavigator.h", "1")
            r.add(&root, cat([_]Str{ "    NavigatorBase* owner = WTF::getPtr(", j, "->wrapped().navigator());\n" }[0..]))
            r.add(&root, "    if (!owner)\n")
            r.add(&root, "        return false;\n")
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, "        *reason = \"Reachable from Navigator\"_s;\n")
        } else if r.same(reachable, "ImplCanvasBase") {
            r.add(&root, cat([_]Str{ "    auto& owner = ", j, "->wrapped().canvasBase();\n" }[0..]))
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, "        *reason = \"Reachable from CanvasBase\"_s;\n")
        } else if r.same(reachable, "ImplDocument") {
            r.add(&root, cat([_]Str{ "    Document* owner = WTF::getPtr(", j, "->wrapped().document());\n" }[0..]))
            r.add(&root, "    if (!owner)\n")
            r.add(&root, "        return false;\n")
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, "        *reason = \"Reachable from Document\"_s;\n")
        } else if r.same(reachable, "ImplElementRoot") {
            r.setStr(js.implIncludes, "Element.h", "1")
            r.setStr(js.implIncludes, "JSNodeCustom.h", "1")
            r.add(&root, cat([_]Str{ "    Element* owner = WTF::getPtr(", j, "->wrapped().element());\n" }[0..]))
            r.add(&root, "    if (!owner)\n")
            r.add(&root, "        return false;\n")
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, cat([_]Str{ "        *reason = \"Reachable from ", interfaceName, "Owner\"_s;\n" }[0..]))
        } else if r.same(reachable, "ImplOwnerNodeRoot") {
            r.setStr(js.implIncludes, "Element.h", "1")
            r.setStr(js.implIncludes, "JSNodeCustom.h", "1")
            r.add(&root, cat([_]Str{ "    auto* owner = WTF::getPtr(", j, "->wrapped().ownerNode());\n" }[0..]))
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, cat([_]Str{ "        *reason = \"Reachable from ", interfaceName, " ownerNode\"_s;\n" }[0..]))
        } else if r.same(reachable, "ImplScriptExecutionContext") {
            r.add(&root, cat([_]Str{ "    ScriptExecutionContext* owner = WTF::getPtr(", j, "->wrapped().scriptExecutionContext());\n" }[0..]))
            r.add(&root, "    if (!owner)\n")
            r.add(&root, "        return false;\n")
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, "        *reason = \"Reachable from ScriptExecutionContext\"_s;\n")
        } else if r.same(reachable, "ImplWebXRSessionRoot") {
            r.add(&root, cat([_]Str{ "    WebXRSession* owner = WTF::getPtr(", j, "->wrapped().session());\n" }[0..]))
            r.add(&root, "    if (!owner)\n")
            r.add(&root, "        return false;\n")
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, "        *reason = \"Reachable from WebXRSession\"_s;\n")
        } else {
            r.add(&root, cat([_]Str{ "    auto& owner = ", j, "->wrapped();\n" }[0..]))
            r.add(&root, "    if (reason) [[unlikely]]\n")
            r.add(&root, cat([_]Str{ "        *reason = \"Reachable from ", j, "\"_s;\n" }[0..]))
        }
        ip(r.done(root))
        ip("    return containsWebCoreOpaqueRoot(visitor, owner);\n")
    } else {
        if !emittedJSCast { ip("    UNUSED_PARAM(handle);\n") }
        ip("    UNUSED_PARAM(visitor);\n")
        ip("    UNUSED_PARAM(reason);\n")
        ip("    return false;\n")
    }
    ip("}\n\n")
}

fn generateToJS(interface: *Node, interfaceName: Str, implType: Str) -> void {
    const vtableNameGnu = mo.getGnuVTableNameForInterface(interface)
    const vtableRefGnu = mo.getGnuVTableRefForInterface(interface)
    const vtableRefWin = mo.getWinVTableRefForInterface(interface)
    if r.truthy(vtableNameGnu) {
        ip(cat([_]Str{
            "WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN\n#if ENABLE(BINDING_INTEGRITY)\n#if PLATFORM(WIN)\n#pragma warning(disable: 4483)\nextern \"C\" { extern void (*const ", vtableRefWin, "[])(); }\n#else\nextern \"C\" { extern void* ", vtableNameGnu, "[]; }\n#endif\ntemplate<std::same_as<", implType, "> T>\nstatic inline void verifyVTable(", implType, "* ptr)\n{\n    if constexpr (std::is_polymorphic_v<T>) {\n        const void* actualVTablePointer = getVTablePointer<T>(ptr);\n#if PLATFORM(WIN)\n        void* expectedVTablePointer = ", vtableRefWin, ";\n#else\n        void* expectedVTablePointer = ", vtableRefGnu, ";\n#endif\n\n        // If you hit this assertion you either have a use after free bug, or\n        // ", implType, " has subclasses. If ", implType, " has subclasses that get passed\n        // to toJS() we currently require ", interfaceName, " you to opt out of binding hardening\n        // by adding the SkipVTableValidation attribute to the interface IDL definition\n        RELEASE_ASSERT(actualVTablePointer == expectedVTablePointer);\n    }\n}\n#endif\nWTF_ALLOW_UNSAFE_BUFFER_USAGE_END\n\n",
        }[0..]))
    }
    include("JSDOMWrapperCache.h")
    ip(cat([_]Str{ "JSC::JSValue toJSNewlyCreated(JSC::JSGlobalObject* lexicalGlobalObject, JSDOMGlobalObject* globalObject, Ref<", implType, ">&& impl)\n" }[0..]))
    ip("{\n")
    if r.endsWith(implType, "Document") {
        include("JSDocumentCustom.h")
        ip("    reportMemoryForDocumentIfFrameless(*lexicalGlobalObject, impl.get());\n")
    } else {
        ip("    UNUSED_PARAM(lexicalGlobalObject);\n")
    }
    var hasChildInterfaces = false
    if !on(interface, "IgnoreSubclassesWhenGeneratingToJSObject") {
        const children = cg.childInterfaces(interface)
        var index: usize = 0
        while index < children.count {
            const child = m.node(children, index)
            index += 1
            hasChildInterfaces = true
            const childImplType = mo.getImplClassName(child)
            const conditional = ext(child, "Conditional")
            if r.truthy(conditional) { ip(cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..])) }
            js.addToImplIncludesForIDLType(child.*.ty.?, r.undef())
            include(cat([_]Str{ "JS", typeName(child), ".h" }[0..]))
            const childName = typeName(child)
            if r.endsWith(childName, "Element") {
                if r.startsWith(childName, "HTML") {
                    include("HTMLElementTypeHelpers.h")
                } else if r.startsWith(childName, "SVG") {
                    include("SVGElementTypeHelpers.h")
                } else if r.startsWith(childName, "MathML") {
                    include("MathMLElementTypeHelpers.h")
                }
            }
            if r.same(childName, "SVGComponentTransferFunctionElement") { include("SVGComponentTransferFunctionElementInlines.h") }
            ip(cat([_]Str{ "    if (is<", childImplType, ">(impl))\n" }[0..]))
            ip(cat([_]Str{ "        return toJSNewlyCreated(lexicalGlobalObject, globalObject, uncheckedDowncast<", childImplType, ">(WTF::move(impl)));\n" }[0..]))
            if r.truthy(conditional) { ip("#endif\n") }
        }
    }
    if r.truthy(vtableNameGnu) && !hasChildInterfaces { ip(cat([_]Str{ "#if ENABLE(BINDING_INTEGRITY)\n    verifyVTable<", implType, ">(impl.ptr());\n#endif\n" }[0..])) }
    include("JSDOMWrapperCache.h")
    if cg.inheritsInterface(interface, "Node") {
        include("JSNodeCustom.h")
        ip("    globalObject = globalObjectForNode(impl.get(), globalObject);\n")
    }
    ip(cat([_]Str{ "    return createWrapper<", implType, ">(globalObject, WTF::move(impl));\n" }[0..]))
    ip("}\n\n")
    ip(cat([_]Str{ "JSC::JSValue toJS(JSC::JSGlobalObject* lexicalGlobalObject, JSDOMGlobalObject* globalObject, ", implType, "& impl)\n" }[0..]))
    ip("{\n")
    if r.endsWith(implType, "Document") {
        include("JSDocumentCustom.h")
        ip("    if (auto* wrapper = cachedDocumentWrapper(*lexicalGlobalObject, *globalObject, impl))\n")
        ip("        return wrapper;\n")
    }
    ip("    return wrap(lexicalGlobalObject, globalObject, impl);\n")
    ip("}\n\n")
}
