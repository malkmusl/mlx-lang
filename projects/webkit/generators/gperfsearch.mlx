// gperf's search for a perfect hash function (its search.cc), step by step
// as gperf takes them so that the same key positions, alpha increments and
// asso_values come out:
//
//     hash (keyword) = sum (asso_values[keyword[i] + alpha_inc[i]] : i in Pos)
//                      + len (keyword), unless -n or all lengths are equal
//
// 1. the byte positions Pos (unless -k gave them), as few as keep the
//    keywords apart; 2. the alpha increments that keep the multisets of
//    the selected bytes apart; 3. the asso_values, one group of characters
//    after the other, each group's values tried in gperf's order (start
//    -i, step -j, or -m pairs of them) until no two keywords collide.
const s = @import("./support.mlx")
const std = @import("std")
const io = @import("./gperfio.mlx")
const opt = @import("./gperfoptions.mlx")
const pos = @import("./gperfpositions.mlx")
const kw = @import("./gperfkeywords.mlx")

pub var head: i64 = -1
pub var totalKeys: i64 = 0
pub var maxKeyLen: i64 = 0
pub var minKeyLen: i64 = 0
pub var hashIncludesLen: bool = false
pub var keyPositions: *pos.Positions = undefined
pub var alphaInc: [*]i64 = undefined
pub var alphaSize: usize = 0
var alphaUnify: [*]usize = undefined
var hasAlphaUnify: bool = false
var maxSelcharsLength: usize = 0
pub var totalDuplicates: i64 = 0
var occurrences: [*]i64 = undefined
pub var assoValues: [*]i64 = undefined
var listLen: i64 = 0
var assoValueMax: i64 = 0
var initialAssoValue: i64 = 0
var jump: i64 = 0
var maxHashValue: i64 = 0

const UINT_MAX: u64 = 4294967295

// ---------------------------------------------------------------------------
// The sparse bit array of hash values (gperf's Bool_Array).

var detector: [*]u64 = undefined
var detectorIteration: u64 = 1

fn newDetector(size: i64) -> void {
    unsafe { detector = @ptrFromInt([*]u64, s.alloc(@intCast(usize, size) * 8)) }
    detectorIteration = 1
}

fn clearDetector() -> void { detectorIteration += 1 }

// Sets bit INDEX; whether it was set already.
fn setBit(index: i64) -> bool {
    const at = @intCast(usize, index)
    if detector[at] == detectorIteration { return true }
    detector[at] = detectorIteration
    return false
}

// ---------------------------------------------------------------------------
// Sets of keywords told apart by their selected characters (and, unless
// IGNORE_LENGTH, their lengths): what gperf's Hash_Table answers.

var setSlots: [*]usize = undefined
var setStamps: [*]u64 = undefined
var setMask: usize = 0
var setGeneration: u64 = 0
var setIgnoreLength: bool = false

fn startSet(ignoreLength: bool) -> void {
    if setMask == 0 {
        var size: usize = 16
        while size < @intCast(usize, totalKeys) * 4 { size *= 2 }
        unsafe {
            setSlots = @ptrFromInt([*]usize, s.alloc(size * 8))
            setStamps = @ptrFromInt([*]u64, s.alloc(size * 8))
        }
        setMask = size - 1
    }
    setGeneration += 1
    setIgnoreLength = ignoreLength
}

fn hashSel(keyword: *kw.Keyword, withLength: bool) -> u64 {
    var h: u64 = 14695981039346656037
    var index: usize = 0
    while index < keyword.*.selLength {
        h = (h ^ @intCast(u64, keyword.*.sel[index])) *% 1099511628211
        index += 1
    }
    if withLength { h = (h ^ (@intCast(u64, keyword.*.chars.length) +% 77777)) *% 1099511628211 }
    return h ^ (h >> 29)
}

fn sameSel(first: *kw.Keyword, second: *kw.Keyword) -> bool {
    if first.*.selLength != second.*.selLength { return false }
    var index: usize = 0
    while index < first.*.selLength {
        if first.*.sel[index] != second.*.sel[index] { return false }
        index += 1
    }
    return setIgnoreLength || first.*.chars.length == second.*.chars.length
}

// Adds keyword K; the keyword equal to it already there, or -1.
fn insert(k: usize) -> i64 {
    const keyword = &kw.keywords[k]
    var probe = @intCast(usize, hashSel(keyword, !setIgnoreLength) & @intCast(u64, setMask))
    while setStamps[probe] == setGeneration {
        const other = setSlots[probe]
        if sameSel(&kw.keywords[other], keyword) { return @intCast(i64, other) }
        probe = (probe + 1) & setMask
    }
    setStamps[probe] = setGeneration
    setSlots[probe] = k
    return -1
}

// ---------------------------------------------------------------------------
// Preparation.

fn prepare() -> void {
    totalKeys = @intCast(i64, kw.length(head))
    maxKeyLen = -2147483648
    minKeyLen = 2147483647
    var walk = head
    while walk >= 0 {
        const length = @intCast(i64, kw.at(walk).*.chars.length)
        if maxKeyLen < length { maxKeyLen = length }
        if minKeyLen > length { minKeyLen = length }
        walk = kw.next(walk)
    }
    if minKeyLen == 0 {
        s.say("Empty input keyword is not allowed.\nTo recognize an empty input keyword, your code should check for\nlen == 0 before calling the gperf generated lookup function.\n")
        io.exit(1)
    }
    if opt.has(opt.SEVENBIT) {
        walk = head
        while walk >= 0 {
            const chars = kw.at(walk).*.chars
            for byte in chars {
                if byte >= 128 {
                    s.say(s.join3("Option --seven-bit has been specified,\nbut keyword \"", chars, "\" contains non-ASCII characters.\nTry removing option --seven-bit.\n"))
                    io.exit(1)
                }
            }
            walk = kw.next(walk)
        }
    }
    hashIncludesLen = !(opt.has(opt.NOLENGTH) || minKeyLen == maxKeyLen)
}

// ---------------------------------------------------------------------------
// Step 1: the byte positions.

fn baseAlphaSize() -> usize { return if opt.has(opt.SEVENBIT) { 128 } else { 256 } }

// Upper case to lower case with -ignore-case (else none: false).
fn baseAlphaUnify(unify: *[*]usize) -> bool {
    if !opt.has(opt.UPPERLOWER) { return false }
    const size = baseAlphaSize()
    var table: [*]usize = undefined
    unsafe { table = @ptrFromInt([*]usize, s.alloc(size * 8)) }
    var c: usize = 0
    while c < size {
        table[c] = c
        c += 1
    }
    c = 65
    while c <= 90 {
        table[c] = c + 32
        c += 1
    }
    unify.* = table
    return true
}

var noIncrements: [*]i64 = undefined

fn countDuplicatesTuple(positions: *pos.Positions, unify: bool, table: [*]usize) -> u64 {
    var walk = head
    while walk >= 0 {
        kw.initSelchars(kw.at(walk), positions, unify, table, false, noIncrements, false)
        walk = kw.next(walk)
    }
    var count: u64 = 0
    startSet(!hashIncludesLen)
    walk = head
    while walk >= 0 {
        if insert(kw.first(walk)) >= 0 { count += 1 }
        walk = kw.next(walk)
    }
    return count
}

fn lowered(byte: u8) -> u8 {
    if opt.has(opt.UPPERLOWER) && byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
}

fn findPositions() -> void {
    if opt.has(opt.POSITIONS) {
        keyPositions.* = opt.o.*.keyPositions
        return
    }
    var table: [*]usize = undefined
    const unify = baseAlphaUnify(&table)

    // 1. The positions that tell apart keywords differing in one byte only
    //    (not the last).
    var mandatory = pos.none()
    if !opt.has(opt.DUP) {
        var l1 = head
        while l1 >= 0 && kw.next(l1) >= 0 {
            const keyword1 = kw.at(l1)
            var l2 = kw.next(l1)
            while l2 >= 0 {
                const keyword2 = kw.at(l2)
                if keyword1.*.chars.length == keyword2.*.chars.length {
                    const n = keyword1.*.chars.length
                    var i: usize = 0
                    while i + 1 < n {
                        if lowered(keyword1.*.chars[i]) != lowered(keyword2.*.chars[i]) { break }
                        i += 1
                    }
                    if i + 1 < n {
                        var j = i + 1
                        while j < n {
                            if lowered(keyword1.*.chars[j]) != lowered(keyword2.*.chars[j]) { break }
                            j += 1
                        }
                        if j >= n {
                            if !pos.contains(&mandatory, @intCast(i64, i)) { pos.add(&mandatory, @intCast(i64, i)) }
                        }
                    }
                }
                l2 = kw.next(l2)
            }
            l1 = kw.next(l1)
        }
    }

    // 2. Add positions, as long as this decreases the duplicates count.
    const imax: i64 = if maxKeyLen - 1 < pos.MAX_KEY_POS - 1 { maxKeyLen - 1 } else { pos.MAX_KEY_POS - 1 }
    var current = mandatory
    var currentDuplicates = countDuplicatesTuple(&current, unify, table)
    while true {
        var best = pos.none()
        var bestDuplicates: u64 = UINT_MAX
        var i = imax
        while i >= -1 {
            if !pos.contains(&current, i) {
                var tryal = current
                pos.add(&tryal, i)
                const tryDuplicates = countDuplicatesTuple(&tryal, unify, table)
                if tryDuplicates < bestDuplicates || (tryDuplicates == bestDuplicates && i >= 0) {
                    best = tryal
                    bestDuplicates = tryDuplicates
                }
            }
            i -= 1
        }
        if bestDuplicates >= currentDuplicates { break }
        current = best
        currentDuplicates = bestDuplicates
    }

    // 3. Remove positions, as long as this doesn't increase the duplicates
    //    count.
    while true {
        var best = pos.none()
        var bestDuplicates: u64 = UINT_MAX
        var i = imax
        while i >= -1 {
            if pos.contains(&current, i) && !pos.contains(&mandatory, i) {
                var tryal = current
                pos.remove(&tryal, i)
                const tryDuplicates = countDuplicatesTuple(&tryal, unify, table)
                if tryDuplicates < bestDuplicates || (tryDuplicates == bestDuplicates && i == -1) {
                    best = tryal
                    bestDuplicates = tryDuplicates
                }
            }
            i -= 1
        }
        if bestDuplicates > currentDuplicates { break }
        current = best
        currentDuplicates = bestDuplicates
    }

    // 4. Replace two positions by one, as long as this doesn't increase the
    //    duplicates count.
    while true {
        var best = pos.none()
        var bestDuplicates: u64 = UINT_MAX
        var i1 = imax
        while i1 >= -1 {
            if pos.contains(&current, i1) && !pos.contains(&mandatory, i1) {
                var i2 = imax
                while i2 >= -1 {
                    if pos.contains(&current, i2) && !pos.contains(&mandatory, i2) && i2 != i1 {
                        var i3 = imax
                        while i3 >= 0 {
                            if !pos.contains(&current, i3) {
                                var tryal = current
                                pos.remove(&tryal, i1)
                                pos.remove(&tryal, i2)
                                pos.add(&tryal, i3)
                                const tryDuplicates = countDuplicatesTuple(&tryal, unify, table)
                                if tryDuplicates < bestDuplicates
                                    || (tryDuplicates == bestDuplicates && (i1 == -1 || i2 == -1 || i3 >= 0)) {
                                    best = tryal
                                    bestDuplicates = tryDuplicates
                                }
                            }
                            i3 -= 1
                        }
                    }
                    i2 -= 1
                }
            }
            i1 -= 1
        }
        if bestDuplicates > currentDuplicates { break }
        current = best
        currentDuplicates = bestDuplicates
    }
    keyPositions.* = current
}

// ---------------------------------------------------------------------------
// Step 2: the alpha increments.

fn alphaSizeWith(increments: [*]i64) -> usize {
    var maxIncrement: i64 = 0
    var i: i64 = 0
    while i < maxKeyLen {
        if maxIncrement < increments[@intCast(usize, i)] { maxIncrement = increments[@intCast(usize, i)] }
        i += 1
    }
    return baseAlphaSize() + @intCast(usize, maxIncrement)
}

// The unification of asso_values[c] that --ignore-case asks for, with the
// increments: toupper(c) + inc and tolower(c) + inc go together.
fn alphaUnifyWith(positions: *pos.Positions, increments: [*]i64, unify: *[*]usize) -> bool {
    if !opt.has(opt.UPPERLOWER) { return false }
    const size = alphaSizeWith(increments)
    var table: [*]usize = undefined
    unsafe { table = @ptrFromInt([*]usize, s.alloc(size * 8)) }
    var c: usize = 0
    while c < size {
        table[c] = c
        c += 1
    }
    var walk = head
    while walk >= 0 {
        const keyword = kw.at(walk)
        const chars = keyword.*.chars
        var index = pos.start(positions, @intCast(i64, chars.length))
        while index < positions.*.size {
            const i = positions.*.p[index]
            var ch: usize = 0
            if i == pos.LASTCHAR {
                ch = @intCast(usize, chars[chars.length - 1])
            } else {
                ch = @intCast(usize, chars[@intCast(usize, i)])
            }
            if ch >= 65 && ch <= 90 { ch += 32 }
            if ch >= 97 && ch <= 122 {
                if i != pos.LASTCHAR { ch += @intCast(usize, increments[@intCast(usize, i)]) }
                const d = table[ch]
                const b = ch - 32
                var a: i64 = @intCast(i64, b)
                while a >= 0 && table[@intCast(usize, a)] == b {
                    table[@intCast(usize, a)] = d
                    a -= 32
                }
            }
            index += 1
        }
        walk = kw.next(walk)
    }
    unify.* = table
    return true
}

fn countDuplicatesMultiset(increments: [*]i64) -> u64 {
    var table: [*]usize = undefined
    const unify = alphaUnifyWith(keyPositions, increments, &table)
    var walk = head
    while walk >= 0 {
        kw.initSelchars(kw.at(walk), keyPositions, unify, table, true, increments, true)
        walk = kw.next(walk)
    }
    var count: u64 = 0
    startSet(!hashIncludesLen)
    walk = head
    while walk >= 0 {
        if insert(kw.first(walk)) >= 0 { count += 1 }
        walk = kw.next(walk)
    }
    return count
}

fn newIncrements() -> [*]i64 {
    const length: usize = if maxKeyLen > 0 { @intCast(usize, maxKeyLen) } else { 1 }
    var array: [*]i64 = undefined
    unsafe { array = @ptrFromInt([*]i64, s.alloc(length * 8)) }
    var i: usize = 0
    while i < length {
        array[i] = 0
        i += 1
    }
    return array
}

fn copyIncrements(target: [*]i64, source: [*]i64) -> void {
    var i: i64 = 0
    while i < maxKeyLen {
        target[@intCast(usize, i)] = source[@intCast(usize, i)]
        i += 1
    }
}

fn findAlphaInc() -> void {
    var table: [*]usize = undefined
    const unify = baseAlphaUnify(&table)
    const duplicatesGoal = countDuplicatesTuple(keyPositions, unify, table)
    const current = newIncrements()
    var currentDuplicates = countDuplicatesMultiset(current)
    if currentDuplicates > duplicatesGoal {
        // The positions whose increments may change.
        var indices: [*]usize = undefined
        unsafe { indices = @ptrFromInt([*]usize, s.alloc(257 * 8)) }
        var count: usize = 0
        var index = pos.start(keyPositions, maxKeyLen)
        while index < keyPositions.*.size {
            const keyPos = keyPositions.*.p[index]
            if keyPos != pos.LASTCHAR {
                indices[count] = @intCast(usize, keyPos)
                count += 1
            }
            index += 1
        }
        const best = newIncrements()
        const tryal = newIncrements()
        while true {
            var inc: i64 = 1
            while true {
                var bestDuplicates: u64 = UINT_MAX
                var j: usize = 0
                while j < count {
                    copyIncrements(tryal, current)
                    tryal[indices[j]] += inc
                    const tryDuplicates = countDuplicatesMultiset(tryal)
                    if tryDuplicates < bestDuplicates {
                        copyIncrements(best, tryal)
                        bestDuplicates = tryDuplicates
                    }
                    j += 1
                }
                if bestDuplicates < currentDuplicates {
                    copyIncrements(current, best)
                    currentDuplicates = bestDuplicates
                    break
                }
                inc += 1
            }
            if !(currentDuplicates > duplicatesGoal) { break }
        }
    }
    alphaInc = current
    alphaSize = alphaSizeWith(alphaInc)
    hasAlphaUnify = alphaUnifyWith(keyPositions, alphaInc, &alphaUnify)
}

// ---------------------------------------------------------------------------
// Step 3: the asso_values.

// The keywords of the list, in its order.
var order: [*]usize = undefined
var orderCount: usize = 0

var randomState: u64 = 0

fn random() -> i64 {
    randomState = randomState *% 6364136223846793005 +% 1442695040888963407
    return @intCast(i64, (randomState >> 33) & 2147483647)
}

fn prepareAssoValues() -> void {
    var walk = head
    while walk >= 0 {
        kw.initSelchars(kw.at(walk), keyPositions, hasAlphaUnify, alphaUnify, true, alphaInc, true)
        walk = kw.next(walk)
    }
    maxSelcharsLength = keyPositions.*.size - pos.start(keyPositions, maxKeyLen)

    // Keywords with the same selected characters (and length) are
    // duplicates: only the first stays on the list, the others are linked
    // to it.
    listLen = totalKeys
    totalDuplicates = 0
    startSet(!hashIncludesLen)
    var previous: i64 = -1
    walk = head
    while walk >= 0 {
        const k = kw.first(walk)
        const keyword = kw.at(walk)
        const other = insert(k)
        if other >= 0 {
            totalDuplicates += 1
            listLen -= 1
            kw.setNext(previous, kw.next(walk))
            const representative = &kw.keywords[@intCast(usize, other)]
            keyword.*.duplicateLink = representative.*.duplicateLink
            representative.*.duplicateLink = @intCast(i64, k)
            if !opt.has(opt.DUP) || opt.has(opt.DEBUG) {
                var message = s.join3("Key link: \"", keyword.*.chars, s.join3("\" = \"", representative.*.chars, "\", with key set \""))
                var j: usize = 0
                while j < keyword.*.selLength {
                    const one: [1]u8 = [1]u8{ @intCast(u8, keyword.*.sel[j] & 255) }
                    message = s.join(message, one[0..1])
                    j += 1
                }
                s.say(s.join(message, "\".\n"))
            }
        } else {
            keyword.*.duplicateLink = -1
            previous = walk
        }
        walk = kw.next(walk)
    }
    if totalDuplicates > 0 {
        if opt.has(opt.DUP) {
            s.say(s.join(s.signedDecimal(totalDuplicates), " input keys have identical hash values, examine output carefully...\n"))
        } else {
            s.say(s.join(s.signedDecimal(totalDuplicates), " input keys have identical hash values,\n"))
            if opt.has(opt.POSITIONS) {
                s.say("try different key positions or use option -D.\n")
            } else {
                s.say("use option -D.\n")
            }
            io.exit(1)
        }
    }

    unsafe {
        occurrences = @ptrFromInt([*]i64, s.alloc(alphaSize * 8))
        assoValues = @ptrFromInt([*]i64, s.alloc(alphaSize * 8))
    }
    var c: usize = 0
    while c < alphaSize {
        occurrences[c] = 0
        c += 1
    }
    walk = head
    while walk >= 0 {
        const keyword = kw.at(walk)
        var j: usize = 0
        while j < keyword.*.selLength {
            occurrences[keyword.*.sel[j]] += 1
            j += 1
        }
        walk = kw.next(walk)
    }

    // The bound of the asso_values: the keywords times -s, rounded up to a
    // power of 2 (float arithmetic as gperf's).
    var bound = @intFromFloat(u64, @floatFromInt(f32, listLen) * opt.o.*.sizeMultiple) & UINT_MAX
    if bound == 0 { bound = 1 }
    bound |= bound >> 1
    bound |= bound >> 2
    bound |= bound >> 4
    bound |= bound >> 8
    bound |= bound >> 16
    bound = (bound + 1) & UINT_MAX
    assoValueMax = @intCast(i64, bound)
    maxHashValue = (if hashIncludesLen { maxKeyLen } else { 0 }) + (assoValueMax - 1) * @intCast(i64, maxSelcharsLength)
    newDetector(maxHashValue + 1)

    if opt.has(opt.RANDOM) || opt.o.*.jump == 0 {
        randomState = @bitCast(u64, std.linux.syscall1(201, 0))
    }
    initialAssoValue = if opt.has(opt.RANDOM) { -1 } else { opt.o.*.initialAssoValue }
    jump = opt.o.*.jump

    orderCount = kw.length(head)
    unsafe { order = @ptrFromInt([*]usize, s.alloc((orderCount + 1) * 8)) }
    var t: usize = 0
    walk = head
    while walk >= 0 {
        order[t] = kw.first(walk)
        t += 1
        walk = kw.next(walk)
    }
}

// The keywords split into classes of those whose undetermined selected
// characters are the same multiset; the classes in the order of their first
// keyword, each one's keywords in list order.
const Partition = struct {
    classCount: usize
    start: [*]usize
    size: [*]usize
    members: [*]usize
}

const Step = struct {
    changingCount: usize
    changing: [*]usize
    assoValueMax: i64
    undetermined: [*]bool
    partition: Partition
}

// Scratch for computePartition.
var scratchReady: bool = false
var undeterminedPool: [*]usize = undefined
var undeterminedOffset: [*]usize = undefined
var undeterminedLength: [*]usize = undefined
var classOf: [*]usize = undefined
var classFirst: [*]usize = undefined
var classSize: [*]usize = undefined
var classSlots: [*]usize = undefined
var classStamps: [*]u64 = undefined
var classMask: usize = 0
var classGeneration: u64 = 0
var splitCardinalities: [*]u64 = undefined

fn prepareScratch() -> void {
    if scratchReady { return }
    scratchReady = true
    const n = orderCount + 1
    var size: usize = 16
    while size < n * 4 { size *= 2 }
    unsafe {
        undeterminedPool = @ptrFromInt([*]usize, s.alloc(n * (maxSelcharsLength + 1) * 8))
        undeterminedOffset = @ptrFromInt([*]usize, s.alloc(n * 8))
        undeterminedLength = @ptrFromInt([*]usize, s.alloc(n * 8))
        classOf = @ptrFromInt([*]usize, s.alloc(n * 8))
        classFirst = @ptrFromInt([*]usize, s.alloc(n * 8))
        classSize = @ptrFromInt([*]usize, s.alloc(n * 8))
        classSlots = @ptrFromInt([*]usize, s.alloc(size * 8))
        classStamps = @ptrFromInt([*]u64, s.alloc(size * 8))
        splitCardinalities = @ptrFromInt([*]u64, s.alloc((maxSelcharsLength + 2) * 8))
    }
    classMask = size - 1
}

fn sameUndetermined(first: usize, second: usize) -> bool {
    const length = undeterminedLength[first]
    if length != undeterminedLength[second] { return false }
    const a = undeterminedOffset[first]
    const b = undeterminedOffset[second]
    var i: usize = 0
    while i < length {
        if undeterminedPool[a + i] != undeterminedPool[b + i] { return false }
        i += 1
    }
    return true
}

fn computePartition(undetermined: [*]bool) -> Partition {
    prepareScratch()
    classGeneration += 1
    var classCount: usize = 0
    var t: usize = 0
    var poolTop: usize = 0
    while t < orderCount {
        const keyword = &kw.keywords[order[t]]
        undeterminedOffset[t] = poolTop
        var length: usize = 0
        var h: u64 = 14695981039346656037
        var i: usize = 0
        while i < keyword.*.selLength {
            const c = keyword.*.sel[i]
            if undetermined[c] {
                undeterminedPool[poolTop + length] = c
                length += 1
                h = (h ^ @intCast(u64, c)) *% 1099511628211
            }
            i += 1
        }
        undeterminedLength[t] = length
        poolTop += length
        h = (h ^ @intCast(u64, length)) *% 1099511628211
        var probe = @intCast(usize, (h ^ (h >> 29)) & @intCast(u64, classMask))
        var found: usize = classCount
        while classStamps[probe] == classGeneration {
            const candidate = classSlots[probe]
            if sameUndetermined(classFirst[candidate], t) {
                found = candidate
                break
            }
            probe = (probe + 1) & classMask
        }
        if found == classCount {
            classStamps[probe] = classGeneration
            classSlots[probe] = classCount
            classFirst[classCount] = t
            classSize[classCount] = 0
            classCount += 1
        }
        classOf[t] = found
        classSize[found] += 1
        t += 1
    }
    var partition = Partition.{ .classCount = classCount, .start = undefined, .size = undefined, .members = undefined }
    unsafe {
        partition.start = @ptrFromInt([*]usize, s.alloc((classCount + 1) * 8))
        partition.size = @ptrFromInt([*]usize, s.alloc((classCount + 1) * 8))
        partition.members = @ptrFromInt([*]usize, s.alloc((orderCount + 1) * 8))
    }
    var total: usize = 0
    var c: usize = 0
    while c < classCount {
        partition.start[c] = total
        partition.size[c] = 0
        total += classSize[c]
        c += 1
    }
    t = 0
    while t < orderCount {
        const cls = classOf[t]
        partition.members[partition.start[cls] + partition.size[cls]] = order[t]
        partition.size[cls] += 1
        t += 1
    }
    return partition
}

fn occurrencesIn(keyword: *kw.Keyword, c: usize) -> usize {
    var count: usize = 0
    var i: usize = 0
    while i < keyword.*.selLength {
        if keyword.*.sel[i] == c { count += 1 }
        i += 1
    }
    return count
}

// The collisions possible when asso_values[c] is chosen: each class split
// by how often c occurs, (|p|^2 - |p1|^2 - |p2|^2 - ...) / 2 summed up.
fn countPossibleCollisions(partition: *Partition, c: usize) -> u64 {
    var sum: u64 = 0
    const m = maxSelcharsLength
    var cls: usize = 0
    while cls < partition.*.classCount {
        var i: usize = 0
        while i <= m {
            splitCardinalities[i] = 0
            i += 1
        }
        const start = partition.*.start[cls]
        const size = partition.*.size[cls]
        var j: usize = 0
        while j < size {
            splitCardinalities[occurrencesIn(&kw.keywords[partition.*.members[start + j]], c)] += 1
            j += 1
        }
        sum += @intCast(u64, size * size)
        i = 0
        while i <= m {
            sum -= splitCardinalities[i] * splitCardinalities[i]
            i += 1
        }
        cls += 1
    }
    return sum
}

// Whether making c undetermined leaves the partition as it is.
fn unchangedPartition(partition: *Partition, c: usize) -> bool {
    var cls: usize = 0
    while cls < partition.*.classCount {
        const start = partition.*.start[cls]
        const size = partition.*.size[cls]
        const firstCount = occurrencesIn(&kw.keywords[partition.*.members[start]], c)
        var j: usize = 1
        while j < size {
            if occurrencesIn(&kw.keywords[partition.*.members[start + j]], c) != firstCount { return false }
            j += 1
        }
        cls += 1
    }
    return true
}

fn newBools(value: bool) -> [*]bool {
    var array: [*]bool = undefined
    unsafe { array = @ptrFromInt([*]bool, s.alloc(alphaSize + 1)) }
    var c: usize = 0
    while c < alphaSize {
        array[c] = value
        c += 1
    }
    return array
}

fn findAssoValues() -> void {
    // The steps, found from the last one back.
    var steps: [*]Step = undefined
    unsafe { steps = @ptrFromInt([*]Step, s.alloc((alphaSize + 2) * @sizeOf(Step))) }
    var stepCount: usize = 0
    const undetermined = newBools(false)
    const determined = newBools(true)
    while true {
        var partition = computePartition(undetermined)
        var bestC: usize = 0
        var bestCollisions: u64 = UINT_MAX
        var c: usize = 0
        while c < alphaSize {
            if occurrences[c] > 0 && determined[c] {
                const collisions = countPossibleCollisions(&partition, c)
                if collisions < bestCollisions {
                    bestC = c
                    bestCollisions = collisions
                }
            }
            c += 1
        }
        if bestCollisions == UINT_MAX { break }
        const chosen = bestC

        const stepUndetermined = newBools(false)
        c = 0
        while c < alphaSize {
            stepUndetermined[c] = undetermined[c]
            c += 1
        }
        undetermined[chosen] = true
        var before = computePartition(undetermined)
        c = 0
        while c < alphaSize {
            if occurrences[c] > 0 && determined[c] && unchangedPartition(&before, c) {
                undetermined[c] = true
                determined[c] = false
            }
            c += 1
        }
        if determined[chosen] { s.fail("gperf: internal error in the search for asso_values") }
        var changingCount: usize = 0
        c = 0
        while c < alphaSize {
            if undetermined[c] && !stepUndetermined[c] { changingCount += 1 }
            c += 1
        }
        var changing: [*]usize = undefined
        unsafe { changing = @ptrFromInt([*]usize, s.alloc((changingCount + 1) * 8)) }
        changingCount = 0
        c = 0
        while c < alphaSize {
            if undetermined[c] && !stepUndetermined[c] {
                changing[changingCount] = c
                changingCount += 1
            }
            c += 1
        }
        steps[stepCount] = Step.{ .changingCount = changingCount, .changing = changing, .assoValueMax = assoValueMax,
            .undetermined = stepUndetermined, .partition = partition }
        stepCount += 1
    }

    var c: usize = 0
    while c < alphaSize {
        assoValues[c] = 0
        c += 1
    }
    // The steps run from the first one (made last).
    var stepIndex = stepCount
    while stepIndex > 0 {
        stepIndex -= 1
        const step = &steps[stepIndex]
        const k = step.*.changingCount
        var i: usize = 0
        while i < k {
            const ch = step.*.changing[i]
            const value = if initialAssoValue < 0 { random() } else { initialAssoValue }
            assoValues[ch] = value & (step.*.assoValueMax - 1)
            i += 1
        }
        var iter: [*]i64 = undefined
        unsafe { iter = @ptrFromInt([*]i64, s.alloc((k + 1) * 8)) }
        i = 0
        while i < k {
            iter[i] = 0
            i += 1
        }
        var ii: usize = if jump != 0 { k - 1 } else { 0 }
        while true {
            // Whether these asso_values make keywords of one class collide.
            var hasCollision = false
            var cls: usize = 0
            while cls < step.*.partition.classCount {
                clearDetector()
                const start = step.*.partition.start[cls]
                const size = step.*.partition.size[cls]
                var j: usize = 0
                while j < size {
                    const keyword = &kw.keywords[step.*.partition.members[start + j]]
                    var sum: i64 = if hashIncludesLen { @intCast(i64, keyword.*.chars.length) } else { 0 }
                    var q: usize = 0
                    while q < keyword.*.selLength {
                        const sc = keyword.*.sel[q]
                        if !step.*.undetermined[sc] { sum += assoValues[sc] }
                        q += 1
                    }
                    if setBit(sum) {
                        hasCollision = true
                        break
                    }
                    j += 1
                }
                if hasCollision { break }
                cls += 1
            }
            if !hasCollision { break }

            // Other asso_values: for bound = 0, 1, ... and ii = 0 .. k-1,
            // iter[ii] := bound, iter[0..ii-1] <= bound, iter[ii+1..] < bound,
            // asso_values[changing[i]] = initial + iter[i] * jump.
            if jump != 0 {
                var bound = iter[ii]
                var found = false
                i = 0
                while i < ii {
                    const ch = step.*.changing[i]
                    iter[i] += 1
                    assoValues[ch] = (assoValues[ch] + jump) & (step.*.assoValueMax - 1)
                    if iter[i] <= bound {
                        found = true
                        break
                    }
                    assoValues[ch] = (assoValues[ch] - iter[i] * jump) & (step.*.assoValueMax - 1)
                    iter[i] = 0
                    i += 1
                }
                if !found {
                    i = ii + 1
                    while i < k {
                        const ch = step.*.changing[i]
                        iter[i] += 1
                        assoValues[ch] = (assoValues[ch] + jump) & (step.*.assoValueMax - 1)
                        if iter[i] < bound {
                            found = true
                            break
                        }
                        assoValues[ch] = (assoValues[ch] - iter[i] * jump) & (step.*.assoValueMax - 1)
                        iter[i] = 0
                        i += 1
                    }
                }
                if !found {
                    const chii = step.*.changing[ii]
                    assoValues[chii] = (assoValues[chii] - bound * jump) & (step.*.assoValueMax - 1)
                    iter[ii] = 0
                    ii += 1
                    if ii == k {
                        ii = 0
                        bound += 1
                        if bound == step.*.assoValueMax {
                            // Out of search space: a wider one for this step.
                            step.*.assoValueMax = 2 * step.*.assoValueMax
                            if step.*.assoValueMax > assoValueMax {
                                assoValueMax = step.*.assoValueMax
                                maxHashValue = (if hashIncludesLen { maxKeyLen } else { 0 }) + (assoValueMax - 1) * @intCast(i64, maxSelcharsLength)
                                newDetector(maxHashValue + 1)
                            }
                        }
                    }
                    const chnext = step.*.changing[ii]
                    iter[ii] = bound
                    assoValues[chnext] = (assoValues[chnext] + bound * jump) & (step.*.assoValueMax - 1)
                }
            } else {
                const ch = step.*.changing[ii]
                assoValues[ch] = (assoValues[ch] + random()) & (step.*.assoValueMax - 1)
                ii += 1
                if ii == k { ii = 0 }
            }
        }
    }
}

fn computeHash(keyword: *kw.Keyword) -> i64 {
    var sum: i64 = if hashIncludesLen { @intCast(i64, keyword.*.chars.length) } else { 0 }
    var i: usize = 0
    while i < keyword.*.selLength {
        sum += assoValues[keyword.*.sel[i]]
        i += 1
    }
    keyword.*.hashValue = sum
    return sum
}

fn findGoodAssoValues() -> void {
    prepareAssoValues()
    var iterations = opt.o.*.assoIterations
    if iterations == 0 {
        findAssoValues()
        return
    }
    // Pairs (initial value, jump): (0,1) (1,1) (2,1) (0,3) (3,1) (1,3) ...
    var best: [*]i64 = undefined
    unsafe { best = @ptrFromInt([*]i64, s.alloc(alphaSize * 8)) }
    var bestCollisions: i64 = 2147483647
    var bestMaxHashValue: i64 = 2147483647
    initialAssoValue = 0
    jump = 1
    while true {
        findAssoValues()
        var collisions: i64 = 0
        var maxHash: i64 = -2147483648
        clearDetector()
        var walk = head
        while walk >= 0 {
            const hashcode = computeHash(kw.at(walk))
            if maxHash < hashcode { maxHash = hashcode }
            if setBit(hashcode) { collisions += 1 }
            walk = kw.next(walk)
        }
        if collisions < bestCollisions || (collisions == bestCollisions && maxHash < bestMaxHashValue) {
            var c: usize = 0
            while c < alphaSize {
                best[c] = assoValues[c]
                c += 1
            }
            bestCollisions = collisions
            bestMaxHashValue = maxHash
        }
        iterations -= 1
        if iterations == 0 { break }
        if initialAssoValue >= 2 {
            initialAssoValue -= 2
            jump += 2
        } else {
            initialAssoValue += jump
            jump = 1
        }
    }
    initialAssoValue = 0
    jump = 1
    var c: usize = 0
    while c < alphaSize {
        assoValues[c] = best[c]
        c += 1
    }
}

// Finds the hash function for the keywords of LIST; the list comes out
// sorted by hash value, without the duplicates (which hang on their first).
pub fn optimize(list: i64) -> void {
    unsafe { keyPositions = @ptrFromInt(*pos.Positions, s.alloc(@sizeOf(pos.Positions))) }
    keyPositions.* = pos.none()
    noIncrements = newIncrements()
    head = list
    prepare()
    findPositions()
    findAlphaInc()
    findGoodAssoValues()

    clearDetector()
    var walk = head
    while walk >= 0 {
        if setBit(computeHash(kw.at(walk))) {
            s.say("\nInternal error, unexpected duplicate hash code\n")
            if opt.has(opt.POSITIONS) {
                s.say("try options -m or -r, or use new key positions.\n\n")
            } else {
                s.say("try options -m or -r.\n\n")
            }
            io.exit(1)
        }
        walk = kw.next(walk)
    }

    head = kw.sortByHashValue(head)

    // Unused asso_values[c] are max_hash_value + 1; unified ones follow
    // theirs.
    walk = head
    while kw.next(walk) >= 0 { walk = kw.next(walk) }
    const maxHash = kw.at(walk).*.hashValue
    var c: usize = 0
    while c < alphaSize {
        if occurrences[c] == 0 { assoValues[c] = maxHash + 1 }
        c += 1
    }
    if hasAlphaUnify {
        c = 0
        while c < alphaSize {
            if alphaUnify[c] != c { assoValues[c] = assoValues[alphaUnify[c]] }
            c += 1
        }
    }
}
