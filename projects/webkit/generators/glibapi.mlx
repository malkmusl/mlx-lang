// The headers of WebKit's GLib APIs and the files CMake configures, as
// WebKit's build makes them for the GTK and WPE ports:
//
//     webkit-glib-api header PORT INPUT OUTPUT [-DNAME[=VALUE] | -UNAME]...
//     webkit-glib-api configure INPUT OUTPUT [NAME=VALUE]...
//
// `header` is Source/WebKit/Scripts/glib/generate-api-header.py and the
// unifdef it runs (GLibMacros.cmake's GENERATE_GLIB_API_HEADERS, as
// JavaScriptCore's GLib.cmake makes jsc/JSCValue.h of JSCValue.h.in): the
// lines starting with @ become the port's checks that only the API's
// main header is included (others are dropped), `#include <@...@/` takes
// the port's include prefix, ENABLE(X), USE(X) and PLATFORM(X) are spelled
// out as `(defined(ENABLE_X) && ENABLE_X)`, then the conditionals that
// stand on the symbols given alone are decided, their lines and the
// branches not taken removed, as unifdef does. A conditional naming other
// symbols too is kept as it is; one that would need unifdef to rewrite
// its expression (given and other symbols together) is not done here and
// stops the run.
//
// `configure` is CMake's configure_file: @NAME@ and ${NAME} become the
// value given (an empty one for a name not given).
const std = @import("std")
const s = @import("./support.mlx")
const c = @import("./csstext.mlx")

const MAX_SYMBOLS: usize = 64
const MAX_DEPTH: usize = 64

// The symbols given: their names, whether defined, their values.
var symbolNames: [MAX_SYMBOLS][]const u8 = undefined
var symbolDefined: [MAX_SYMBOLS]bool = undefined
var symbolValues: [MAX_SYMBOLS]i64 = undefined
var symbolCount: usize = 0

fn symbolIndex(name: []const u8) -> usize {
    var index: usize = 0
    while index < symbolCount {
        if std.text.same(symbolNames[index], name) { return index }
        index += 1
    }
    return MAX_SYMBOLS
}

// -DNAME, -DNAME=VALUE (a number) or -UNAME.
fn addSymbol(argument: []const u8) -> void {
    if symbolCount == MAX_SYMBOLS { s.fail("webkit-glib-api: too many symbols") }
    if argument.length < 3 || argument[0] != 45 || (argument[1] != 68 && argument[1] != 85) { s.fail(s.join("webkit-glib-api: not -DNAME or -UNAME: ", argument)) }
    const rest = argument[2..argument.length]
    var equals: usize = 0
    while equals < rest.length && rest[equals] != 61 { equals += 1 }
    symbolNames[symbolCount] = rest[0..equals]
    symbolDefined[symbolCount] = argument[1] == 68
    symbolValues[symbolCount] = 1
    if equals < rest.length {
        const value = rest[equals + 1..rest.length]
        var number: i64 = 0
        var at: usize = 0
        if value.length == 0 { s.fail(s.join("webkit-glib-api: no value in ", argument)) }
        while at < value.length {
            if !std.ascii.isDigit(value[at]) { s.fail(s.join("webkit-glib-api: not a number: ", argument)) }
            number = number * 10 + @intCast(i64, value[at] - 48)
            at += 1
        }
        symbolValues[symbolCount] = number
    }
    symbolCount += 1
}

// ---------------------------------------------------------------------------
// What generate-api-header.py does before unifdef.

fn apiSingleHeaderCheck(port: []const u8) -> []const u8 {
    if std.text.same(port, "gtk4") { return "#if !defined(__WEBKIT_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <webkit/webkit.h> can be included directly.\"\n#endif" }
    if std.text.same(port, "gtk") { return "#if !defined(__WEBKIT_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <webkit2/webkit2.h> can be included directly.\"\n#endif" }
    return "#if !defined(__WEBKIT_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <wpe/webkit.h> can be included directly.\"\n#endif"
}

fn injectedBundleApiSingleHeaderCheck(port: []const u8) -> []const u8 {
    if std.text.same(port, "gtk4") { return "#if !defined(__WEBKIT_WEB_PROCESS_EXTENSION_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <webkit/webkit-web-process-extension.h> can be included directly.\"\n#endif" }
    if std.text.same(port, "gtk") { return "#if !defined(__WEBKIT_WEB_PROCESS_EXTENSION_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <webkit2/webkit-web-extension.h> can be included directly.\"\n#endif" }
    if std.text.same(port, "wpe2") { return "#if !defined(__WEBKIT_WEB_PROCESS_EXTENSION_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <wpe/webkit-web-process-extension.h> can be included directly.\"\n#endif" }
    return "#if !defined(__WEBKIT_WEB_PROCESS_EXTENSION_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <wpe/webkit-web-extension.h> can be included directly.\"\n#endif"
}

fn sharedApiSingleHeaderCheck(port: []const u8) -> []const u8 {
    if std.text.same(port, "gtk4") { return "#if !defined(__WEBKIT_H_INSIDE__) && !defined(__WEBKIT_WEB_PROCESS_EXTENSION_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <webkit/webkit.h> can be included directly.\"\n#endif" }
    if std.text.same(port, "gtk") { return "#if !defined(__WEBKIT_H_INSIDE__) && !defined(__WEBKIT_WEB_PROCESS_EXTENSION_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <webkit2/webkit2.h> can be included directly.\"\n#endif" }
    return "#if !defined(__WEBKIT_H_INSIDE__) && !defined(__WEBKIT_WEB_PROCESS_EXTENSION_H_INSIDE__) && !defined(BUILDING_WEBKIT)\n#error \"Only <wpe/webkit.h> can be included directly.\"\n#endif"
}

fn includePrefix(port: []const u8) -> []const u8 {
    if std.text.same(port, "gtk4") || std.text.same(port, "gtk") { return "webkit" }
    return "wpe"
}

fn lower(text: []const u8) -> []const u8 { return c.lower(text) }

fn isMacroName(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || std.ascii.isDigit(byte) || byte == 95 }

// re.sub(r"(NAMES)\(([A-Z0-9_]+)\)", ...) over LINE for the macros NAMES
// (tried in order at each place): `(defined(PREFIX_X) && PREFIX_X)`,
// PREFIX being the macro's name, or WTF_ and it for PLATFORM.
fn expandMacros(line: []const u8, names: [2][]const u8, count: usize) -> []const u8 {
    var b = c.buf()
    var at: usize = 0
    while at < line.length {
        var matched = false
        var which: usize = 0
        while which < count && !matched {
            const name = names[which]
            const open = s.join(name, "(")
            if at + open.length <= line.length && std.text.same(line[at..at + open.length], open) {
                var end = at + open.length
                while end < line.length && isMacroName(line[end]) { end += 1 }
                if end > at + open.length && end < line.length && line[end] == 41 {
                    const feature = line[at + open.length..end]
                    const prefix = if std.text.same(name, "PLATFORM") { "WTF_PLATFORM" } else { name }
                    const symbol = s.join3(prefix, "_", feature)
                    c.add(&b, s.join3("(defined(", symbol, s.join3(") && ", symbol, ")")))
                    at = end + 1
                    matched = true
                }
            }
            which += 1
        }
        if !matched {
            c.addByte(&b, line[at])
            at += 1
        }
    }
    return c.contents(&b)
}

fn expandIfdefs(line: []const u8) -> []const u8 {
    const first = [2][]const u8{ "ENABLE", "USE" }
    const second = [2][]const u8{ "PLATFORM", "" }
    return expandMacros(expandMacros(line, first, 2), second, 1)
}

// The input as the script hands it to unifdef.
fn prepared(port: []const u8, input: []const u8) -> []const u8 {
    var b = c.buf()
    var at: usize = 0
    while at < input.length {
        // A line with its newline, as readlines() gives it.
        const start = at
        while at < input.length && input[at] != 10 { at += 1 }
        if at < input.length { at += 1 }
        const line = input[start..at]
        if line[0] == 64 {
            if std.text.same(line, "@API_SINGLE_HEADER_CHECK@\n") {
                c.add(&b, s.join(apiSingleHeaderCheck(port), "\n"))
            } else if std.text.same(line, "@INJECTED_BUNDLE_API_SINGLE_HEADER_CHECK@\n") {
                c.add(&b, s.join(injectedBundleApiSingleHeaderCheck(port), "\n"))
            } else if std.text.same(line, "@SHARED_API_SINGLE_HEADER_CHECK@\n") {
                c.add(&b, s.join(sharedApiSingleHeaderCheck(port), "\n"))
            }
        } else if std.text.startsWith(line, "#include <@") {
            c.add(&b, replaceAll(line, "@API_INCLUDE_PREFIX@", includePrefix(port)))
        } else {
            c.add(&b, expandIfdefs(line))
        }
    }
    return c.contents(&b)
}

fn replaceAll(text: []const u8, from: []const u8, to: []const u8) -> []const u8 {
    var b = c.buf()
    var at: usize = 0
    while at < text.length {
        if at + from.length <= text.length && std.text.same(text[at..at + from.length], from) {
            c.add(&b, to)
            at += from.length
        } else {
            c.addByte(&b, text[at])
            at += 1
        }
    }
    return c.contents(&b)
}

// ---------------------------------------------------------------------------
// unifdef, for expressions of !, &&, ||, parentheses, defined and names.

const FALSE: u8 = 0
const TRUE: u8 = 1
const UNKNOWN: u8 = 2

const Expression = struct {
    text: []const u8
    at: usize
    // Whether a given symbol was named, and whether the expression holds
    // what is not understood here (comparisons, arithmetic).
    namesGiven: bool
    foreign: bool
}

fn skipSpaces(e: *Expression) -> void {
    while e.*.at < e.*.text.length && std.ascii.isCWhitespace(e.*.text[e.*.at]) { e.*.at += 1 }
}

fn peek(e: *Expression, token: []const u8) -> bool {
    skipSpaces(e)
    return e.*.at + token.length <= e.*.text.length && std.text.same(e.*.text[e.*.at..e.*.at + token.length], token)
}

fn identifier(e: *Expression) -> []const u8 {
    skipSpaces(e)
    const start = e.*.at
    while e.*.at < e.*.text.length && s.isWord(e.*.text[e.*.at]) { e.*.at += 1 }
    return e.*.text[start..e.*.at]
}

fn primary(e: *Expression) -> u8 {
    if peek(e, "!") && !peek(e, "!=") {
        e.*.at += 1
        const value = primary(e)
        return if value == UNKNOWN { UNKNOWN } else { 1 - value }
    }
    if peek(e, "(") {
        e.*.at += 1
        const value = disjunction(e)
        if !peek(e, ")") {
            e.*.foreign = true
            return UNKNOWN
        }
        e.*.at += 1
        return value
    }
    const name = identifier(e)
    if name.length == 0 {
        e.*.foreign = true
        e.*.at = e.*.text.length
        return UNKNOWN
    }
    if std.text.same(name, "defined") {
        var parenthesized = false
        if peek(e, "(") {
            e.*.at += 1
            parenthesized = true
        }
        const symbol = identifier(e)
        if parenthesized {
            if !peek(e, ")") {
                e.*.foreign = true
                return UNKNOWN
            }
            e.*.at += 1
        }
        const index = symbolIndex(symbol)
        if index == MAX_SYMBOLS { return UNKNOWN }
        e.*.namesGiven = true
        return if symbolDefined[index] { TRUE } else { FALSE }
    }
    if std.ascii.isDigit(name[0]) {
        var number: i64 = 0
        for byte in name {
            if !std.ascii.isDigit(byte) {
                e.*.foreign = true
                return UNKNOWN
            }
            number = number * 10 + @intCast(i64, byte - 48)
        }
        return if number != 0 { TRUE } else { FALSE }
    }
    const index = symbolIndex(name)
    if index == MAX_SYMBOLS { return UNKNOWN }
    e.*.namesGiven = true
    // (An undefined symbol is 0, as in the preprocessor.)
    return if symbolDefined[index] && symbolValues[index] != 0 { TRUE } else { FALSE }
}

fn conjunction(e: *Expression) -> u8 {
    var value = primary(e)
    while peek(e, "&&") {
        e.*.at += 2
        const other = primary(e)
        if value == FALSE || other == FALSE {
            value = FALSE
        } else if value == UNKNOWN || other == UNKNOWN {
            value = UNKNOWN
        }
    }
    return value
}

fn disjunction(e: *Expression) -> u8 {
    var value = conjunction(e)
    while peek(e, "||") {
        e.*.at += 2
        const other = conjunction(e)
        if value == TRUE || other == TRUE {
            value = TRUE
        } else if value == UNKNOWN || other == UNKNOWN {
            value = UNKNOWN
        }
    }
    return value
}

// The expression TEXT (a directive's, its comment cut off) decided: TRUE,
// FALSE, or UNKNOWN when it stands on other symbols.
fn decide(text: []const u8, line: []const u8) -> u8 {
    var e = Expression.{ .text = withoutComment(text), .at = 0, .namesGiven = false, .foreign = false }
    var value = disjunction(&e)
    skipSpaces(&e)
    if e.at < e.text.length { e.foreign = true }
    if e.foreign { value = UNKNOWN }
    if value == UNKNOWN && e.namesGiven { s.fail(s.join("webkit-glib-api: an expression unifdef would rewrite: ", line)) }
    return value
}

fn withoutComment(text: []const u8) -> []const u8 {
    var at: usize = 0
    while at + 1 < text.length {
        if text[at] == 47 && (text[at + 1] == 42 || text[at + 1] == 47) { return text[0..at] }
        at += 1
    }
    return text
}

// A preprocessor line's directive ("" for other lines) and what follows it.
fn directive(line: []const u8, rest: *[]const u8) -> []const u8 {
    var at: usize = 0
    while at < line.length && (line[at] == 32 || line[at] == 9) { at += 1 }
    if at >= line.length || line[at] != 35 { return "" }
    at += 1
    while at < line.length && (line[at] == 32 || line[at] == 9) { at += 1 }
    const start = at
    while at < line.length && s.isWord(line[at]) { at += 1 }
    rest.* = line[at..line.length]
    return line[start..at]
}

// A conditional's state: kept as it is (its lines written), or decided
// (its lines dropped) with the branch taken now; or inside a branch not
// taken (nothing of it written, nothing decided).
const KEPT: u8 = 0
const DECIDED: u8 = 1
const SKIPPED: u8 = 2

fn unifdef(text: []const u8) -> []const u8 {
    var b = c.buf()
    var states: [MAX_DEPTH]u8 = undefined
    var taking: [MAX_DEPTH]bool = undefined
    var depth: usize = 0
    var at: usize = 0
    while at < text.length {
        const start = at
        while at < text.length && text[at] != 10 { at += 1 }
        if at < text.length { at += 1 }
        const line = text[start..at]
        // Whether the lines here are written.
        var active = true
        var level: usize = 0
        while level < depth {
            if states[level] == SKIPPED || (states[level] == DECIDED && !taking[level]) { active = false }
            level += 1
        }
        var rest: []const u8 = ""
        const name = directive(line, &rest)
        if std.text.same(name, "if") || std.text.same(name, "ifdef") || std.text.same(name, "ifndef") {
            if depth == MAX_DEPTH { s.fail("webkit-glib-api: conditionals nested too deep") }
            if !active {
                states[depth] = SKIPPED
            } else {
                var value = UNKNOWN
                if std.text.same(name, "if") {
                    value = decide(rest, line)
                } else {
                    const index = symbolIndex(s.trimEnd(s.trimStart(withoutComment(rest))))
                    if index != MAX_SYMBOLS {
                        value = if symbolDefined[index] == std.text.same(name, "ifdef") { TRUE } else { FALSE }
                    }
                }
                if value == UNKNOWN {
                    states[depth] = KEPT
                    c.add(&b, line)
                } else {
                    states[depth] = DECIDED
                    taking[depth] = value == TRUE
                }
            }
            depth += 1
        } else if std.text.same(name, "elif") {
            if depth == 0 { s.fail("webkit-glib-api: #elif without #if") }
            if states[depth - 1] == DECIDED { s.fail(s.join("webkit-glib-api: #elif after a decided #if: ", line)) }
            if states[depth - 1] == KEPT {
                if decide(rest, line) != UNKNOWN { s.fail(s.join("webkit-glib-api: an #elif unifdef would rewrite: ", line)) }
                c.add(&b, line)
            }
        } else if std.text.same(name, "else") {
            if depth == 0 { s.fail("webkit-glib-api: #else without #if") }
            if states[depth - 1] == KEPT { c.add(&b, line) }
            if states[depth - 1] == DECIDED { taking[depth - 1] = !taking[depth - 1] }
        } else if std.text.same(name, "endif") {
            if depth == 0 { s.fail("webkit-glib-api: #endif without #if") }
            if states[depth - 1] == KEPT { c.add(&b, line) }
            depth -= 1
        } else if active {
            c.add(&b, line)
        }
    }
    if depth != 0 { s.fail("webkit-glib-api: #if without #endif") }
    return c.contents(&b)
}

// ---------------------------------------------------------------------------
// configure_file.

const MAX_VALUES: usize = 64
var valueNames: [MAX_VALUES][]const u8 = undefined
var valueTexts: [MAX_VALUES][]const u8 = undefined
var valueCount: usize = 0

fn valueOf(name: []const u8) -> []const u8 {
    var index: usize = 0
    while index < valueCount {
        if std.text.same(valueNames[index], name) { return valueTexts[index] }
        index += 1
    }
    return ""
}

fn configured(input: []const u8) -> []const u8 {
    var b = c.buf()
    var at: usize = 0
    while at < input.length {
        const byte = input[at]
        if byte == 64 || (byte == 36 && at + 1 < input.length && input[at + 1] == 123) {
            // @NAME@ or ${NAME}.
            const open: usize = if byte == 64 { 1 } else { 2 }
            const close: u8 = if byte == 64 { 64 } else { 125 }
            var end = at + open
            while end < input.length && s.isWord(input[end]) { end += 1 }
            if end > at + open && end < input.length && input[end] == close {
                c.add(&b, valueOf(input[at + open..end]))
                at = end + 1
                continue
            }
        }
        c.addByte(&b, byte)
        at += 1
    }
    return c.contents(&b)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length >= 5 && std.text.same(std.text.cString(arguments[1]), "header") {
        var port = lower(std.text.cString(arguments[2]))
        var index: usize = 5
        var newApi = false
        var gtk4 = false
        while index < arguments.length {
            const argument = std.text.cString(arguments[index])
            if std.text.same(argument, "-DENABLE_2022_GLIB_API=1") { newApi = true }
            if std.text.same(argument, "-DUSE_GTK4=1") { gtk4 = true }
            addSymbol(argument)
            index += 1
        }
        if std.text.same(port, "gtk") && gtk4 { port = "gtk4" }
        if std.text.same(port, "wpe") && newApi { port = "wpe2" }
        const input = s.readWhole(std.text.cString(arguments[3]))
        s.writeWhole(std.text.cString(arguments[4]), unifdef(prepared(port, input)))
        return 0
    }
    if arguments.length >= 4 && std.text.same(std.text.cString(arguments[1]), "configure") {
        var index: usize = 4
        while index < arguments.length {
            const argument = std.text.cString(arguments[index])
            var equals: usize = 0
            while equals < argument.length && argument[equals] != 61 { equals += 1 }
            if equals == argument.length || valueCount == MAX_VALUES { s.fail(s.join("webkit-glib-api: not NAME=VALUE: ", argument)) }
            valueNames[valueCount] = argument[0..equals]
            valueTexts[valueCount] = argument[equals + 1..argument.length]
            valueCount += 1
            index += 1
        }
        s.writeWhole(std.text.cString(arguments[3]), configured(s.readWhole(std.text.cString(arguments[2]))))
        return 0
    }
    s.say("usage: webkit-glib-api header PORT INPUT OUTPUT [-DNAME[=VALUE] | -UNAME]...\n       webkit-glib-api configure INPUT OUTPUT [NAME=VALUE]...\n")
    return 2
}
