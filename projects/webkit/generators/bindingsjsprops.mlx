// CodeGeneratorJS.pm for the members of an interface: attribute getters
// and setters, operations (their argument conversions, overload
// dispatchers, the [CallWith] arguments, default toJSON), and the
// iterators of iterable interfaces.
const std = @import("std")
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const js = @import("./bindingsjs.mlx")
const t = @import("./bindingsjstypes.mlx")
const d = @import("./bindingsjsdict.mlx")
const mo = @import("./bindingsjsmore.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

fn p(out: *StrList, text: Str) -> void { r.spush(out, text) }
fn cat(parts: []const Str) -> Str { return r.cat(parts) }
fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }
fn include(name: Str) -> void { js.addToImplInclude(name) }
fn dec(value: usize) -> Str { return r.decimal(@intCast(u64, value)) }

// Whether a part of the &-separated VALUE starts with PREFIX (ExtendedAttributeContains with a regular expression ^PREFIX).
fn containsPrefix(v: Str, prefix: Str) -> bool {
    if !r.truthy(v) { return false }
    const parts = cg.splitAmpersands(v)
    var index: usize = 0
    while index < parts.count {
        if std.text.startsWith(parts.items[index], prefix) { return true }
        index += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Attributes.

pub fn generateAttributeGetterAndSetterDeclaration(out: *StrList, interface: *Node, className: Str, attribute: *Node) -> void {
    if mo.isJSBuiltin(interface, attribute) { return }
    if on(attribute, "DelegateToSharedSyntheticAttribute") { return }
    const conditionalString = cg.generateConditionalString(attribute.*.ext)
    if r.truthy(conditionalString) { p(out, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
    const getter = mo.getAttributeGetterName(interface, className, attribute)
    const linkage = if js.useStandaloneConstructorAttributes(interface) && cg.isConstructorType(attribute.*.ty.?) { "" } else { "static " }
    p(out, cat([_]Str{ linkage, "JSC_DECLARE_CUSTOM_GETTER(", getter, ");\n" }[0..]))
    if !(js.isReadonly(attribute) || cg.isConstructorType(attribute.*.ty.?)) {
        const readWriteConditional = ext(attribute, "ConditionallyReadWrite")
        if r.truthy(readWriteConditional) { p(out, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(readWriteConditional), "\n" }[0..])) }
        p(out, cat([_]Str{ "static JSC_DECLARE_CUSTOM_SETTER(", mo.getAttributeSetterName(interface, className, attribute), ");\n" }[0..]))
        if r.truthy(readWriteConditional) { p(out, "#endif\n") }
    }
    if r.truthy(conditionalString) { p(out, "#endif\n") }
}

pub fn generateForEachEventHandlerContentAttribute(out: *StrList, interface: *Node, className: Str, functionName: Str, eventHandlerExtendedAttributeName: Str) -> void {
    include("HTMLNames.h")
    p(out, cat([_]Str{ "void ", className, "::", functionName, "(const Function<void(const AtomString& attributeName, const AtomString& eventName)>& function)\n" }[0..]))
    p(out, "{\n")
    p(out, "    static constexpr std::array table {\n")
    var index: usize = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        index += 1
        if cg.isEventHandlerType(attribute.*.ty.?) && (!r.isDef(eventHandlerExtendedAttributeName) || on(attribute, eventHandlerExtendedAttributeName)) {
            p(out, cat([_]Str{ "        std::pair<const decltype(HTMLNames::altAttr)&, const AtomString EventNames::*> { HTMLNames::", attribute.*.name, "Attr, &EventNames::", js.eventHandlerAttributeShortEventName(attribute), " },\n" }[0..]))
        }
    }
    p(out, "    };\n")
    p(out, "    auto& eventNames = WebCore::eventNames();\n")
    p(out, "    for (auto& names : table)\n")
    p(out, "        function(names.first.get().localName(), eventNames.*names.second);\n")
    p(out, "}\n\n")
}

// GetterExpression/SetterExpression's ($functionName, @arguments): the
// content attribute name joins the arguments when there is one.
fn expressionArguments(content: Str) -> StrList {
    var arguments = r.strList()
    if r.isDef(content) { r.spush(&arguments, content) }
    return arguments
}

fn generateAttributeGetterBodyDefinition(out: *StrList, interface: *Node, className: Str, attribute: *Node, bodyName: Str, conditional: Str, enumerations: r.List) -> void {
    var signature = r.strList()
    r.spush(&signature, "JSGlobalObject& lexicalGlobalObject")
    if !attribute.*.isStatic { r.spush(&signature, r.c2(className, "& thisObject")) }
    if cg.extendedAttributeContains(ext(attribute, "CallWith"), "PropertyName") { r.spush(&signature, "PropertyName propertyName") }
    const needSecurityCheck = on(interface, "CheckSecurity") && !on(attribute, "DoNotCheckSecurity") && !on(attribute, "DoNotCheckSecurityOnGetter")
    const hasCustomGetter = mo.hasCustomGetter(attribute)
    const ty = attribute.*.ty.?
    const isEventHandler = cg.isEventHandlerType(ty)
    const isConstructor = cg.isConstructorType(ty)
    const needThrowScope = needSecurityCheck || (!hasCustomGetter && !isEventHandler && !isConstructor)
    if (on(attribute, "Reflect") || on(attribute, "ReflectURL")) && cg.isStringType(ty) {
        if m.on(ty.*.ext, "AtomString") { r.die("Using [AtomString] on attributes marked as [Reflect] or [ReflectURL] is unnecessary") }
        m.set(ty.*.ext, "AtomString", "1")
    }
    p(out, cat([_]Str{ "static inline JSValue ", bodyName, "(", r.sjoin(signature, ", "), ")\n" }[0..]))
    p(out, "{\n")
    if needThrowScope {
        p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(&lexicalGlobalObject);\n")
        p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
    } else {
        p(out, "    UNUSED_PARAM(lexicalGlobalObject);\n")
    }
    if needSecurityCheck {
        if std.text.same(typeName(interface), "DOMWindow") {
            js.addToImplIncludes("JSDOMBindingSecurityInlines.h", conditional)
            p(out, "    bool shouldAllowAccess = BindingSecurity::shouldAllowAccessToDOMWindow(&lexicalGlobalObject, thisObject, ThrowSecurityError);\n")
        } else {
            js.addToImplIncludes("JSDOMBindingSecurity.h", conditional)
            p(out, "    bool shouldAllowAccess = BindingSecurity::shouldAllowAccessToDOMWindow(&lexicalGlobalObject, thisObject.wrapped().window(), ThrowSecurityError);\n")
        }
        p(out, "    EXCEPTION_ASSERT_UNUSED(throwScope, !throwScope.exception() || !shouldAllowAccess);\n")
        p(out, "    if (!shouldAllowAccess)\n")
        p(out, "        return jsUndefined();\n")
    }
    if hasCustomGetter {
        const name = cg.wkLcfirst(r.orElse(ext(attribute, "ImplementedAs"), attribute.*.name))
        p(out, cat([_]Str{ "    return thisObject.", name, "(lexicalGlobalObject);\n" }[0..]))
    } else if isEventHandler {
        r.setStr(js.implIncludes, "EventNames.h", "1")
        const getter = if on(attribute, "WindowEventHandler") { "windowEventHandlerAttribute" } else { "eventHandlerAttribute" }
        p(out, cat([_]Str{ "    return ", getter, "(protect(thisObject.wrapped()), ", js.eventHandlerAttributeEventName(attribute), ", protect(worldForDOMObject(thisObject)));\n" }[0..]))
    } else if isConstructor {
        var constructorType = ty.*.name
        const constructorGetter = if std.text.endsWith(constructorType, "LegacyFactoryFunctionConstructor") { "getLegacyFactoryFunction" } else { "getConstructor" }
        if std.text.endsWith(constructorType, "Constructor") { constructorType = constructorType[0..constructorType.length - 11] }
        if !std.text.same(constructorType, "any") && !std.text.endsWith(constructorType, "LegacyFactoryFunction") { js.addToImplIncludes(cat([_]Str{ "JS", constructorType, ".h" }[0..]), conditional) }
        if std.text.endsWith(constructorType, "LegacyFactoryFunction") { constructorType = constructorType[0..constructorType.length - 21] }
        if js.isDOMGlobalObject(interface) {
            p(out, cat([_]Str{ "    return JS", constructorType, "::", constructorGetter, "(JSC::getVM(&lexicalGlobalObject), &thisObject);\n" }[0..]))
        } else {
            p(out, cat([_]Str{ "    return JS", constructorType, "::", constructorGetter, "(JSC::getVM(&lexicalGlobalObject), thisObject.realm());\n" }[0..]))
        }
    } else {
        if on(attribute, "CachedAttribute") {
            p(out, cat([_]Str{ "    if (JSValue cachedValue = thisObject.m_", attribute.*.name, ".get())\n" }[0..]))
            p(out, "        return cachedValue;\n")
        }
        if attribute.*.isStatic && containsPrefix(ext(attribute, "CallWith"), "Relevant") { r.die("[CallWith=Relevant*] can't be used with static attributes.") }
        const callWithArgs = generateCallWithUsingReferences(ext(attribute, "CallWith"), out, "jsUndefined()", "thisObject", r.undef(), r.undef())
        var content: Str = ""
        const baseFunctionName = cg.getterExpression(js.implIncludes, typeName(interface), attribute, &content)
        var arguments = expressionArguments(content)
        const functionName = mo.getFullyQualifiedImplementationCallName(interface, attribute, baseFunctionName, "impl", conditional)
        mo.addAdditionalArgumentsForImplementationCall(&arguments, interface, attribute, "impl", "lexicalGlobalObject", "", "thisObject")
        var all = r.scopy(callWithArgs)
        r.sappend(&all, arguments)
        const globalObjectReference = if attribute.*.isStatic { "uncheckedDowncast<JSDOMGlobalObject>(lexicalGlobalObject)" } else { "*thisObject.realm()" }
        var toJSExpression = t.nativeToJSValueUsingReferences(attribute, interface, cat([_]Str{ functionName, "(", r.sjoin(all, ", "), ")" }[0..]), globalObjectReference)
        if !(attribute.*.isStatic || on(attribute, "ForwardToMapLike") || on(attribute, "ForwardToSetLike")) { p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = thisObject.wrapped();\n") }
        if !js.isReadonly(attribute) {
            const callTracer = r.orElse(ext(attribute, "CallTracer"), ext(interface, "CallTracer"))
            if r.truthy(callTracer) { mo.generateCallTracer(out, callTracer, attribute.*.name, r.strList(), r.strList(), "    ") }
        }
        if on(attribute, "Reflect") && on(attribute, "Enumerated") {
            const reflect = ext(attribute, "Reflect")
            var attributeName: Str = ""
            if !r.isDef(reflect) || std.text.same(reflect, "VALUE_IS_MISSING") {
                attributeName = attribute.*.name
            } else {
                attributeName = r.replaceAll(cg.unquoteStringLiteral(reflect), "-", "_")
            }
            const enumType = ext(attribute, "Enumerated")
            var index: usize = 0
            while index < enumerations.count {
                const enumeration = m.node(enumerations, index)
                index += 1
                const enumName = enumeration.*.name
                const enumClassName = d.getEnumerationClassNameOf(enumeration.*.ty.?, interface)
                if !std.text.same(enumName, enumType) { continue }
                var missingValueDefault = ext(enumeration, "MissingValueDefault")
                if std.text.same(r.defOr(missingValueDefault, ""), "VALUE_IS_MISSING") { missingValueDefault = r.undef() }
                var invalidValueDefault = ext(enumeration, "InvalidValueDefault")
                if std.text.same(r.defOr(invalidValueDefault, ""), "VALUE_IS_MISSING") { invalidValueDefault = r.undef() }
                p(out, cat([_]Str{ "    const AtomString& contentAttributeValue = impl.attributeWithoutSynchronization(WebCore::HTMLNames::", attributeName, "Attr);\n" }[0..]))
                p(out, "    AtomString result;\n")
                p(out, "    if (contentAttributeValue.isNull())\n")
                if r.isDef(missingValueDefault) {
                    p(out, cat([_]Str{ "        result = AtomString(\"", unquoted(missingValueDefault), "\"_s);\n" }[0..]))
                } else {
                    p(out, "        { }\n")
                }
                p(out, cat([_]Str{ "    else if (auto value = parseEnumerationFromString<", enumClassName, ">(contentAttributeValue.convertToASCIILowercase()); value) [[likely]]\n" }[0..]))
                p(out, "        result = AtomString(convertEnumerationToString(*value));\n")
                p(out, "    else\n")
                if r.isDef(invalidValueDefault) {
                    p(out, cat([_]Str{ "        result = AtomString(\"", unquoted(invalidValueDefault), "\"_s);\n" }[0..]))
                } else {
                    p(out, "        { }\n")
                }
                toJSExpression = t.nativeToJSValueUsingReferences(attribute, interface, "result", globalObjectReference)
            }
        }
        if on(attribute, "CachedAttribute") {
            p(out, cat([_]Str{ "    JSValue result = ", toJSExpression, ";\n" }[0..]))
            if needThrowScope { p(out, "    RETURN_IF_EXCEPTION(throwScope, { });\n") }
            p(out, cat([_]Str{ "    thisObject.m_", attribute.*.name, ".set(JSC::getVM(&lexicalGlobalObject), &thisObject, result);\n" }[0..]))
            p(out, "    return result;\n")
        } else if needThrowScope {
            p(out, cat([_]Str{ "    RELEASE_AND_RETURN(throwScope, (", toJSExpression, "));\n" }[0..]))
        } else {
            p(out, cat([_]Str{ "    return ", toJSExpression, ";\n" }[0..]))
        }
    }
    p(out, "}\n\n")
}

// s/^"(.*)"$/$1/
fn unquoted(text: Str) -> Str {
    if text.length >= 2 && text[0] == 34 && text[text.length - 1] == 34 { return text[1..text.length - 1] }
    return text
}

fn generateAttributeGetterTrampolineDefinition(out: *StrList, interface: *Node, className: Str, attribute: *Node, getterName: Str, bodyName: Str, conditional: Str) -> void {
    js.addToImplIncludes("JSDOMAttribute.h", conditional)
    var callName = r.buf()
    r.add(&callName, "get")
    if attribute.*.isStatic { r.add(&callName, "Static") }
    if cg.extendedAttributeContains(ext(attribute, "CallWith"), "PropertyName") { r.add(&callName, "PassingPropertyName") }
    var parameters = r.strList()
    r.spush(&parameters, bodyName)
    if on(attribute, "LegacyLenientThis") {
        r.spush(&parameters, "CastedThisErrorBehavior::ReturnEarly")
    } else if cg.isPromiseType(attribute.*.ty.?) {
        r.spush(&parameters, "CastedThisErrorBehavior::RejectPromise")
    } else if mo.isAcceleratedDOMAttribute(interface, attribute) {
        r.spush(&parameters, "CastedThisErrorBehavior::Assert")
    }
    p(out, cat([_]Str{ "JSC_DEFINE_CUSTOM_GETTER(", getterName, ", (JSGlobalObject* lexicalGlobalObject, EncodedJSValue thisValue, PropertyName attributeName))\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    return IDLAttribute<", className, ">::", r.done(callName), "<", r.sjoin(parameters, ", "), ">(*lexicalGlobalObject, thisValue, attributeName);\n" }[0..]))
    p(out, "}\n\n")
}

pub fn generateAttributeGetterDefinition(out: *StrList, interface: *Node, className: Str, attribute: *Node, enumerations: r.List) -> void {
    if mo.isJSBuiltin(interface, attribute) { return }
    if on(attribute, "DelegateToSharedSyntheticAttribute") { return }
    const getterName = mo.getAttributeGetterName(interface, className, attribute)
    const bodyName = r.c2(getterName, "Getter")
    const standalone = js.useStandaloneConstructorAttributes(interface) && cg.isConstructorType(attribute.*.ty.?)
    const conditional = ext(attribute, "Conditional")
    if r.truthy(conditional) {
        const conditionalString = cg.generateConditionalStringFromAttributeValue(conditional)
        if standalone { p(js.auxImplContent, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) } else { p(out, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
    }
    if standalone {
        p(js.auxImplContent, cat([_]Str{ "JSC_DECLARE_CUSTOM_GETTER(", getterName, ");\n" }[0..]))
        js.auxImplActive = true
        generateAttributeGetterBodyDefinition(js.auxImplContent, interface, className, attribute, bodyName, conditional, enumerations)
        generateAttributeGetterTrampolineDefinition(js.auxImplContent, interface, className, attribute, getterName, bodyName, conditional)
        js.auxImplActive = false
    } else {
        generateAttributeGetterBodyDefinition(out, interface, className, attribute, bodyName, conditional, enumerations)
        generateAttributeGetterTrampolineDefinition(out, interface, className, attribute, getterName, bodyName, conditional)
    }
    if r.truthy(conditional) {
        if standalone { p(js.auxImplContent, "#endif\n\n") } else { p(out, "#endif\n\n") }
    }
}

fn attributeSetterNeedsPropertyName(attribute: *Node) -> bool {
    return cg.extendedAttributeContains(ext(attribute, "CallWith"), "PropertyName") || on(attribute, "Replaceable")
}

// The implementation call of a setter with NATIVEVALUE (the Perl's
// $generateFunctionString).
fn setterFunctionString(out: *StrList, interface: *Node, attribute: *Node, conditional: Str, nativeValue: Str) -> Str {
    var content: Str = ""
    const baseFunctionName = cg.setterExpression(js.implIncludes, typeName(interface), attribute, &content)
    var arguments = expressionArguments(content)
    r.spush(&arguments, nativeValue)
    const functionName = mo.getFullyQualifiedImplementationCallName(interface, attribute, baseFunctionName, "impl", conditional)
    mo.addAdditionalArgumentsForImplementationCall(&arguments, interface, attribute, "impl", "lexicalGlobalObject", "", "thisObject")
    const setterCallWith = generateCallWithUsingReferences(ext(attribute, "SetterCallWith"), out, "false", "thisObject", r.undef(), r.undef())
    const callWith = generateCallWithUsingReferences(ext(attribute, "CallWith"), out, "false", "thisObject", r.undef(), r.undef())
    var all = r.scopy(callWith)
    r.sappend(&all, setterCallWith)
    r.sappend(&all, arguments)
    return cat([_]Str{ functionName, "(", r.sjoin(all, ", "), ")" }[0..])
}

fn generateAttributeSetterBodyDefinition(out: *StrList, interface: *Node, className: Str, attribute: *Node, bodyName: Str, conditional: Str) -> void {
    var signature = r.strList()
    r.spush(&signature, "JSGlobalObject& lexicalGlobalObject")
    if !attribute.*.isStatic { r.spush(&signature, r.c2(className, "& thisObject")) }
    r.spush(&signature, "JSValue value")
    if attributeSetterNeedsPropertyName(attribute) { r.spush(&signature, "PropertyName propertyName") }
    const needSecurityCheck = on(interface, "CheckSecurity") && !on(attribute, "DoNotCheckSecurity") && !on(attribute, "DoNotCheckSecurityOnSetter")
    const hasCustomSetter = mo.hasCustomSetter(attribute)
    const ty = attribute.*.ty.?
    const isEventHandler = cg.isEventHandlerType(ty)
    const isReplaceable = on(attribute, "Replaceable")
    const isLegacyLenientSetter = on(attribute, "LegacyLenientSetter")
    const needThrowScope = needSecurityCheck || (!hasCustomSetter && !isEventHandler && !isReplaceable && !isLegacyLenientSetter)
    p(out, cat([_]Str{ "static inline bool ", bodyName, "(", r.sjoin(signature, ", "), ")\n" }[0..]))
    p(out, "{\n")
    p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(&lexicalGlobalObject);\n")
    p(out, "    UNUSED_PARAM(vm);\n")
    if needThrowScope { p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n") }
    mo.generateCustomElementReactionsStackIfNeeded(out, attribute, "lexicalGlobalObject")
    if needSecurityCheck {
        if std.text.same(typeName(interface), "DOMWindow") {
            js.addToImplIncludes("JSDOMBindingSecurityInlines.h", conditional)
            p(out, "    bool shouldAllowAccess = BindingSecurity::shouldAllowAccessToDOMWindow(&lexicalGlobalObject, thisObject, ThrowSecurityError);\n")
        } else {
            js.addToImplIncludes("JSDOMBindingSecurity.h", conditional)
            p(out, "    bool shouldAllowAccess = BindingSecurity::shouldAllowAccessToDOMWindow(&lexicalGlobalObject, thisObject.wrapped().window(), ThrowSecurityError);\n")
        }
        p(out, "    EXCEPTION_ASSERT_UNUSED(throwScope, !throwScope.exception() || !shouldAllowAccess);\n")
        p(out, "    if (!shouldAllowAccess)\n")
        p(out, "        return false;\n")
    }
    if hasCustomSetter {
        p(out, cat([_]Str{ "    thisObject.set", cg.wkUcfirst(attribute.*.name), "(lexicalGlobalObject, value);\n" }[0..]))
        p(out, "    return true;\n")
    } else if isEventHandler {
        const setter = if on(attribute, "WindowEventHandler") { "setWindowEventHandlerAttribute" } else { "setEventHandlerAttribute" }
        const listenerType = if std.text.same(ty.*.name, "OnErrorEventHandler") && (js.isDOMGlobalObject(interface) || on(attribute, "WindowEventHandler")) { "JSErrorHandler" } else { "JSEventListener" }
        js.addToImplIncludes(r.c2(listenerType, ".h"), conditional)
        p(out, cat([_]Str{ "    ", setter, "<", listenerType, ">(protect(thisObject.wrapped()), ", js.eventHandlerAttributeEventName(attribute), ", value, thisObject);\n" }[0..]))
        p(out, "    vm.writeBarrier(&thisObject, value);\n")
        p(out, "    ensureStillAliveHere(value);\n\n")
        p(out, "    return true;\n")
    } else if isReplaceable {
        if needThrowScope { p(out, "    throwScope.release();\n") }
        p(out, "    bool shouldThrow = true;\n")
        p(out, "    WebCore::createDataProperty(&thisObject, &lexicalGlobalObject, propertyName, value, shouldThrow);\n")
        p(out, "    return true;\n")
    } else if on(attribute, "PutForwards") {
        if attribute.*.isStatic { r.die("[PutForwards] is not compatible with static attributes") }
        p(out, cat([_]Str{ "    auto id = Identifier::fromString(vm, \"", attribute.*.name, "\"_s);\n" }[0..]))
        p(out, "    auto valueToForwardTo = WebCore::get(&thisObject, &lexicalGlobalObject, id);\n")
        p(out, "    RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, "    if (!valueToForwardTo.isObject()) [[unlikely]] {\n")
        p(out, "        throwTypeError(&lexicalGlobalObject, throwScope);\n")
        p(out, "        return false;\n")
        p(out, "    }\n")
        p(out, cat([_]Str{ "    auto forwardId = Identifier::fromString(vm, \"", ext(attribute, "PutForwards"), "\"_s);\n" }[0..]))
        p(out, "    PutPropertySlot slot(valueToForwardTo, false);\n")
        p(out, "    asObject(valueToForwardTo)->methodTable()->put(asObject(valueToForwardTo), &lexicalGlobalObject, forwardId, value, slot);\n")
        p(out, "    RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, "    return true;\n")
    } else if isLegacyLenientSetter {
        if !attribute.*.isReadOnly { r.die("[LegacyLenientSetter] must be set with readonly") }
        p(out, "    UNUSED_PARAM(lexicalGlobalObject);\n")
        p(out, "    UNUSED_PARAM(thisObject);\n")
        p(out, "    UNUSED_PARAM(value);\n")
        p(out, "    return true;\n")
    } else if ty.*.isUnion && !ty.*.isNullable && on(attribute, "OptimizedUnionSetterUsingOverloads") {
        if !attribute.*.isStatic { p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = thisObject.wrapped();\n") }
        const globalObjectReference = if attribute.*.isStatic { "*uncheckedDowncast<JSDOMGlobalObject>(lexicalGlobalObject)" } else { "*thisObject.realm()" }
        const exceptionThrower = mo.getAttributeExceptionThrower(interface, attribute)
        p(out, "    auto valueFunctor = [&]<typename T>(T&& nativeValueConversionResult) -> bool {\n")
        p(out, "        if constexpr (std::same_as<T, ConversionResultException>) {\n")
        p(out, "            return false;\n")
        p(out, "        } else {\n")
        p(out, "            if (nativeValueConversionResult.hasException(throwScope)) [[unlikely]]\n")
        p(out, "                return false;\n")
        const functionString = setterFunctionString(out, interface, attribute, conditional, "nativeValueConversionResult.releaseReturnValue()")
        const callTracer = r.orElse(ext(attribute, "CallTracer"), ext(interface, "CallTracer"))
        if r.truthy(callTracer) {
            var types = r.strList()
            var expressions = r.strList()
            r.spush(&types, "typename T::IDL")
            r.spush(&expressions, "nativeValueConversionResult.returnValue()")
            mo.generateCallTracer(out, callTracer, attribute.*.name, types, expressions, "            ")
        }
        p(out, "            invokeFunctorPropagatingExceptionIfNecessary(lexicalGlobalObject, throwScope, [&] {\n")
        p(out, cat([_]Str{ "                return ", functionString, ";\n" }[0..]))
        p(out, "            });\n")
        p(out, "            return true;\n")
        p(out, "        }\n")
        p(out, "    };\n")
        const toNative = t.jsValueToNative(interface, attribute, "value", ext(attribute, "Conditional"), "&lexicalGlobalObject", "lexicalGlobalObject", "thisObject", globalObjectReference, exceptionThrower, r.undef(), false, r.undef(), "valueFunctor")
        p(out, cat([_]Str{ "    return ", toNative, ";\n" }[0..]))
    } else {
        if !attribute.*.isStatic { p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = thisObject.wrapped();\n") }
        var readValue: Str = ""
        var releaseValue: Str = ""
        if cg.isEnumType(ty) {
            if ty.*.isNullable {
                const nullString = setterFunctionString(out, interface, attribute, conditional, "std::nullopt")
                p(out, "    if (value.isUndefinedOrNull()) {\n")
                p(out, "        invokeFunctorPropagatingExceptionIfNecessary(lexicalGlobalObject, throwScope, [&] {\n")
                p(out, cat([_]Str{ "            return ", nullString, ";\n" }[0..]))
                p(out, "        });\n")
                p(out, "        return true;\n")
                p(out, "    }\n\n")
            }
            p(out, cat([_]Str{ "    auto optionalNativeValue = parseEnumeration<", d.getEnumerationClassNameOf(ty, interface), ">(lexicalGlobalObject, value);\n" }[0..]))
            p(out, "    RETURN_IF_EXCEPTION(throwScope, false);\n")
            p(out, "    if (!optionalNativeValue) [[unlikely]]\n")
            p(out, "        return false;\n")
            readValue = "optionalNativeValue.value()"
            releaseValue = "optionalNativeValue.value()"
        } else {
            const globalObjectReference = if attribute.*.isStatic { "*uncheckedDowncast<JSDOMGlobalObject>(lexicalGlobalObject)" } else { "*thisObject.realm()" }
            const exceptionThrower = mo.getAttributeExceptionThrower(interface, attribute)
            const toNative = t.jsValueToNativeShort(interface, attribute, "value", ext(attribute, "Conditional"), "&lexicalGlobalObject", "lexicalGlobalObject", "thisObject", globalObjectReference, exceptionThrower)
            p(out, cat([_]Str{ "    auto nativeValueConversionResult = ", toNative, ";\n" }[0..]))
            p(out, "    if (nativeValueConversionResult.hasException(throwScope)) [[unlikely]]\n")
            p(out, "        return false;\n")
            readValue = "nativeValueConversionResult.returnValue()"
            releaseValue = "nativeValueConversionResult.releaseReturnValue()"
        }
        const functionString = setterFunctionString(out, interface, attribute, conditional, releaseValue)
        const callTracer = r.orElse(ext(attribute, "CallTracer"), ext(interface, "CallTracer"))
        if r.truthy(callTracer) {
            var types = r.strList()
            var expressions = r.strList()
            r.spush(&types, t.getIDLType(interface, ty))
            r.spush(&expressions, readValue)
            mo.generateCallTracer(out, callTracer, attribute.*.name, types, expressions, "    ")
        }
        p(out, "    invokeFunctorPropagatingExceptionIfNecessary(lexicalGlobalObject, throwScope, [&] {\n")
        p(out, cat([_]Str{ "        return ", functionString, ";\n" }[0..]))
        p(out, "    });\n")
        p(out, "    return true;\n")
    }
    p(out, "}\n\n")
}

fn generateAttributeSetterTrampolineDefinition(out: *StrList, interface: *Node, className: Str, attribute: *Node, setterName: Str, bodyName: Str, conditional: Str) -> void {
    js.addToImplIncludes("JSDOMAttribute.h", conditional)
    var callName = r.buf()
    r.add(&callName, "set")
    if attribute.*.isStatic { r.add(&callName, "Static") }
    if attributeSetterNeedsPropertyName(attribute) { r.add(&callName, "PassingPropertyName") }
    var parameters = r.strList()
    r.spush(&parameters, bodyName)
    if on(attribute, "LegacyLenientThis") { r.spush(&parameters, "CastedThisErrorBehavior::ReturnEarly") }
    p(out, cat([_]Str{ "JSC_DEFINE_CUSTOM_SETTER(", setterName, ", (JSGlobalObject* lexicalGlobalObject, EncodedJSValue thisValue, EncodedJSValue encodedValue, PropertyName attributeName))\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    return IDLAttribute<", className, ">::", r.done(callName), "<", r.sjoin(parameters, ", "), ">(*lexicalGlobalObject, thisValue, encodedValue, attributeName);\n" }[0..]))
    p(out, "}\n\n")
}

pub fn generateAttributeSetterDefinition(out: *StrList, interface: *Node, className: Str, attribute: *Node) -> void {
    if js.isReadonly(attribute) { return }
    if cg.isConstructorType(attribute.*.ty.?) { return }
    if mo.isJSBuiltin(interface, attribute) { return }
    if on(attribute, "DelegateToSharedSyntheticAttribute") { return }
    const conditional = ext(attribute, "Conditional")
    if r.truthy(conditional) { p(out, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..])) }
    const readWriteConditional = ext(attribute, "ConditionallyReadWrite")
    if r.truthy(readWriteConditional) { p(out, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(readWriteConditional), "\n" }[0..])) }
    const setterName = mo.getAttributeSetterName(interface, className, attribute)
    const bodyName = r.c2(setterName, "Setter")
    generateAttributeSetterBodyDefinition(out, interface, className, attribute, bodyName, conditional)
    generateAttributeSetterTrampolineDefinition(out, interface, className, attribute, setterName, bodyName, conditional)
    if r.truthy(readWriteConditional) { p(out, "#endif\n\n") }
    if r.truthy(conditional) { p(out, "#endif\n\n") }
}

// ---------------------------------------------------------------------------
// Operations.

fn generateOperationTrampolineDefinition(out: *StrList, interface: *Node, className: Str, operation: *Node, functionName: Str, bodyName: Str) -> void {
    const hasPromiseReturnType = cg.isPromiseType(operation.*.ty.?)
    const idlOperationType = if hasPromiseReturnType || on(operation, "ReturnsPromisePair") { "IDLOperationReturningPromise" } else { "IDLOperation" }
    var callName = r.buf()
    r.add(&callName, "call")
    if on(operation, "ReturnsPromisePair") { r.add(&callName, "ReturningPromisePair") }
    if operation.*.isStatic { r.add(&callName, "Static") }
    if hasPromiseReturnType && on(operation, "ReturnsOwnPromise") { r.add(&callName, "ReturningOwnPromise") }
    var arguments = r.strList()
    r.spush(&arguments, bodyName)
    if on(operation, "ReturnsPromisePair") {
        r.spush(&arguments, d.getDictionaryClassNameOf(operation.*.ty.?, interface))
        js.addToImplIncludes("JSDOMPromise.h", ext(operation, "Conditional"))
    }
    if on(operation, "PrivateIdentifier") && !on(operation, "PublicIdentifier") { r.spush(&arguments, "CastedThisErrorBehavior::Assert") }
    p(out, cat([_]Str{ "JSC_DEFINE_HOST_FUNCTION(", functionName, ", (JSGlobalObject* lexicalGlobalObject, CallFrame* callFrame))\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    return ", idlOperationType, "<", className, ">::", r.done(callName), "<", r.sjoin(arguments, ", "), ">(*lexicalGlobalObject, *callFrame, \"", operation.*.name, "\");\n" }[0..]))
    p(out, "}\n\n")
}

fn generateOperationBodyDefinition(out: *StrList, interface: *Node, className: Str, operation: *Node, functionName: Str, functionImplementationName: Str, bodyName: Str, isOverloaded: bool, generatingOverloadDispatcher: bool) -> void {
    const hasPromiseReturnType = cg.isPromiseType(operation.*.ty.?)
    const idlOperationType = if hasPromiseReturnType || on(operation, "ReturnsPromisePair") { "IDLOperationReturningPromise" } else { "IDLOperation" }
    const conditional = ext(operation, "Conditional")
    var signature = r.strList()
    r.spush(&signature, "JSC::JSGlobalObject* lexicalGlobalObject")
    r.spush(&signature, "JSC::CallFrame* callFrame")
    if !operation.*.isStatic { r.spush(&signature, cat([_]Str{ "typename ", idlOperationType, "<", className, ">::ClassParameter castedThis" }[0..])) }
    if hasPromiseReturnType && !on(operation, "ReturnsOwnPromise") { r.spush(&signature, "Ref<DeferredPromise>&& promise") }
    if on(operation, "ReturnsPromisePair") { r.spush(&signature, "Ref<DeferredPromise>&& promise, Ref<DeferredPromise>&& promise2") }
    p(out, cat([_]Str{ "static inline JSC::EncodedJSValue ", bodyName, "(", r.sjoin(signature, ", "), ")\n" }[0..]))
    p(out, "{\n")
    p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
    p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
    p(out, "    UNUSED_PARAM(throwScope);\n")
    p(out, "    UNUSED_PARAM(callFrame);\n")
    if !generatingOverloadDispatcher { mo.generateCustomElementReactionsStackIfNeeded(out, operation, "*lexicalGlobalObject") }
    if !isOverloaded || generatingOverloadDispatcher {
        if on(interface, "CheckSecurity") && !on(operation, "DoNotCheckSecurity") {
            if operation.*.isStatic { r.die("Security checks are not supported for static operations.") }
            if std.text.same(typeName(interface), "DOMWindow") {
                js.addToImplIncludes("JSDOMBindingSecurityInlines.h", conditional)
                p(out, "    bool shouldAllowAccess = BindingSecurity::shouldAllowAccessToDOMWindow(lexicalGlobalObject, *castedThis, ThrowSecurityError);\n")
            } else {
                js.addToImplIncludes("JSDOMBindingSecurity.h", conditional)
                p(out, "    bool shouldAllowAccess = BindingSecurity::shouldAllowAccessToDOMWindow(lexicalGlobalObject, castedThis->wrapped().window(), ThrowSecurityError);\n")
            }
            p(out, "    EXCEPTION_ASSERT_UNUSED(throwScope, !throwScope.exception() || !shouldAllowAccess);\n")
            p(out, "    if (!shouldAllowAccess)\n")
            p(out, "        return JSValue::encode(jsUndefined());\n")
        }
    }
    const indent = "    "
    if generatingOverloadDispatcher {
        var forward = r.strList()
        r.spush(&forward, "lexicalGlobalObject")
        r.spush(&forward, "callFrame")
        if !operation.*.isStatic { r.spush(&forward, "castedThis") }
        if hasPromiseReturnType && !on(operation, "ReturnsOwnPromise") { r.spush(&forward, "WTF::move(promise)") }
        if on(operation, "ReturnsPromisePair") { r.spush(&forward, "WTF::move(promise), WTF::move(promise2)") }
        mo.generateOverloadDispatcher(operation, interface, functionName, "Body", r.sjoin(forward, ", "))
    } else if mo.hasCustomMethod(operation) {
        generateImplementationCustomFunctionCall(out, operation, interface, className, functionImplementationName, indent)
    } else {
        if !on(operation, "ForwardToMapLike") && !on(operation, "ForwardToSetLike") && !operation.*.isStatic { p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = castedThis->wrapped();\n") }
        generateArgumentsCountCheck(out, operation, interface, indent)
        const functionString = generateOperationParametersCheck(out, operation, interface, functionImplementationName, indent)
        if on(operation, "ResultField") {
            p(out, cat([_]Str{ "    auto implResult = ", functionString, ";\n" }[0..]))
            generateImplementationFunctionCall(out, operation, interface, cat([_]Str{ "WTF::move(implResult.", ext(operation, "ResultField"), ")" }[0..]), indent, true)
        } else {
            generateImplementationFunctionCall(out, operation, interface, functionString, indent, true)
        }
    }
    p(out, "}\n\n")
}

pub fn generateOperationDefinition(out: *StrList, interface: *Node, className: Str, operation: *Node) -> void {
    if mo.isJSBuiltin(interface, operation) { return }
    if on(operation, "FromIterable") { return }
    if on(operation, "Default") {
        generateDefaultOperationDefinition(out, interface, className, operation)
        return
    }
    const isCustom = mo.hasCustomMethod(operation)
    const isOverloaded = operation.*.overloads != null && operation.*.overloads.?.*.count > 1
    if isCustom && isOverloaded { r.die("[Custom] is not supported for overloaded operations.") }
    var inAppleCopyright = false
    if on(operation, "AppleCopyright") {
        p(out, js.beginAppleCopyrightForSourceFiles)
        inAppleCopyright = true
    }
    const conditional = ext(operation, "Conditional")
    if r.truthy(conditional) { p(out, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..])) }
    const hasPromiseReturnType = cg.isPromiseType(operation.*.ty.?)
    if !(isCustom || hasPromiseReturnType) { js.addToImplIncludesForIDLType(operation.*.ty.?, conditional) }
    if !hasPromiseReturnType { js.addToImplIncludes("JSDOMOperation.h", conditional) }
    if hasPromiseReturnType || on(operation, "ReturnsPromisePair") { js.addToImplIncludes("JSDOMOperationReturningPromise.h", conditional) }
    const functionName = mo.getFunctionName(interface, className, operation)
    const functionImplementationName = cg.operationName(operation)
    const bodyName = r.c2(if isOverloaded { r.c2(functionName, dec(operation.*.overloadIndex)) } else { functionName }, "Body")
    generateOperationBodyDefinition(out, interface, className, operation, functionName, functionImplementationName, bodyName, isOverloaded, false)
    if !isOverloaded { generateOperationTrampolineDefinition(out, interface, className, operation, functionName, bodyName) }
    if r.truthy(conditional) { p(out, "#endif\n\n") }
    if isOverloaded && operation.*.overloadIndex == operation.*.overloads.?.*.count {
        const overloadsConditional = mo.getConditionalForOperationConsideringOverloads(operation)
        const overloadsConditionalString = if r.truthy(overloadsConditional) { cg.generateConditionalStringFromAttributeValue(overloadsConditional) } else { r.undef() }
        if r.truthy(overloadsConditionalString) { p(out, cat([_]Str{ "#if ", overloadsConditionalString, "\n\n" }[0..])) }
        const dispatcherBodyName = r.c2(functionName, "OverloadDispatcher")
        generateOperationBodyDefinition(out, interface, className, operation, functionName, functionImplementationName, dispatcherBodyName, isOverloaded, true)
        generateOperationTrampolineDefinition(out, interface, className, operation, functionName, dispatcherBodyName)
        if r.truthy(overloadsConditionalString) { p(out, "#endif\n\n") }
    }
    if on(operation, "DOMJIT") {
        if r.truthy(conditional) { p(out, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..])) }
        js.addToImplIncludes("<JavaScriptCore/FrameTracers.h>", conditional)
        const withoutTypeCheck = r.c2(cg.wkLcfirst(functionName), "WithoutTypeCheck")
        p(out, cat([_]Str{ "JSC_DEFINE_JIT_OPERATION(", withoutTypeCheck, ", JSC::EncodedJSValue, (JSC::JSGlobalObject* lexicalGlobalObject, ", className, "* castedThis" }[0..]))
        var a: usize = 0
        while a < operation.*.arguments.count {
            const argument = m.node(operation.*.arguments, a)
            a += 1
            p(out, cat([_]Str{ ", ", mo.getArgumentTypeForFunctionWithoutTypeCheck(interface, argument.*.ty.?), " encoded", cg.wkUcfirst(argument.*.name) }[0..]))
        }
        p(out, "))\n")
        p(out, "{\n")
        p(out, "    UNUSED_PARAM(lexicalGlobalObject);\n")
        p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
        p(out, "    IGNORE_WARNINGS_BEGIN(\"frame-address\")\n")
        p(out, "    CallFrame* callFrame = DECLARE_CALL_FRAME(vm);\n")
        p(out, "    IGNORE_WARNINGS_END\n")
        p(out, "    JSC::JITOperationPrologueCallFrameTracer tracer(vm, callFrame);\n")
        p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
        p(out, "    UNUSED_PARAM(throwScope);\n")
        p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = castedThis->wrapped();\n")
        const implFunctionName = mo.getFullyQualifiedImplementationCallName(interface, operation, functionImplementationName, "impl", conditional)
        var arguments = r.strList()
        mo.addAdditionalArgumentsForImplementationCall(&arguments, interface, operation, "impl", "*lexicalGlobalObject", "*callFrame", "*castedThis")
        a = 0
        while a < operation.*.arguments.count {
            const argument = m.node(operation.*.arguments, a)
            a += 1
            const name = argument.*.name
            const encodedName = r.c2("encoded", cg.wkUcfirst(name))
            const nativeValue = t.toNativeForFunctionWithoutTypeCheck(interface, argument, encodedName, ext(operation, "Conditional"), r.undef(), r.undef(), r.undef())
            p(out, cat([_]Str{ "    auto ", name, " = ", nativeValue, ";\n" }[0..]))
            p(out, "    OPERATION_RETURN_IF_EXCEPTION(throwScope, encodedJSValue());\n")
            if t.shouldPassArgumentByReference(argument) { r.spush(&arguments, r.c2("*", name)) } else { r.spush(&arguments, cat([_]Str{ "WTF::move(", name, ")" }[0..])) }
        }
        const functionString = cat([_]Str{ implFunctionName, "(", r.sjoin(arguments, ", "), ")" }[0..])
        p(out, cat([_]Str{ "    OPERATION_RETURN(throwScope, JSValue::encode(", t.nativeToJSValueUsingPointers(operation, interface, functionString, "*castedThis->realm()"), "));\n" }[0..]))
        p(out, "}\n\n")
        if r.truthy(conditional) { p(out, "#endif\n\n") }
    }
    if inAppleCopyright { p(out, js.endAppleCopyright) }
}

fn generateDefaultOperationDefinition(out: *StrList, interface: *Node, className: Str, operation: *Node) -> void {
    if std.text.same(operation.*.name, "toJSON") && std.text.same(typeName(operation), "object") {
        generateDefaultToJSONOperationDefinition(out, interface, className, operation)
        return
    }
    r.die(cat([_]Str{ "[Default] is not support for for this operation (", operation.*.name, "). It is only currently defined for 'object toJSON();'." }[0..]))
}

fn generateDefaultToJSONOperationDefinition(out: *StrList, interface: *Node, className: Str, operation: *Node) -> void {
    var stack = r.list()
    r.push(&stack, @intFromPtr(interface))
    r.append(&stack, cg.parents(interface))
    const functionName = mo.getFunctionName(interface, className, operation)
    p(out, cat([_]Str{ "static inline EncodedJSValue ", functionName, "Body(JSGlobalObject* lexicalGlobalObject, CallFrame*, ", className, "* castedThis)\n" }[0..]))
    p(out, "{\n")
    p(js.implContent, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
    p(js.implContent, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
    p(js.implContent, "    UNUSED_PARAM(throwScope);\n")
    p(js.implContent, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = castedThis->wrapped();\n")
    include("<JavaScriptCore/ObjectConstructor.h>")
    p(js.implContent, "    auto* result = WebCore::constructEmptyObject(lexicalGlobalObject);\n")
    while stack.count > 0 {
        stack.count -= 1
        const current = m.node(stack, stack.count)
        var hasDefaultToJSON = false
        var o: usize = 0
        while o < current.*.operations.count {
            const candidate = m.node(current.*.operations, o)
            o += 1
            if on(candidate, "Default") && std.text.same(candidate.*.name, "toJSON") && std.text.same(typeName(candidate), "object") {
                hasDefaultToJSON = true
                break
            }
        }
        if !hasDefaultToJSON { continue }
        var a: usize = 0
        while a < current.*.attributes.count {
            const attribute = m.node(current.*.attributes, a)
            a += 1
            if attribute.*.isStatic { continue }
            if !cg.isJSONType(interface, attribute.*.ty.?) { continue }
            if on(attribute, "CachedAttribute") { r.die("[CachedAttribute] is not currently support on interfaces with [Default] object toJSON();") }
            const conditional = ext(attribute, "Conditional")
            if r.truthy(conditional) { p(out, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..])) }
            const attributeName = attribute.*.name
            var toJSExpression: Str = ""
            var mayThrowException = false
            if mo.hasCustomGetter(attribute) {
                toJSExpression = cat([_]Str{ "castedThis->", cg.wkLcfirst(r.orElse(ext(attribute, "ImplementedAs"), attributeName)), "(*lexicalGlobalObject)" }[0..])
                mayThrowException = true
            } else {
                var content: Str = ""
                const baseFunctionName = cg.getterExpression(js.implIncludes, typeName(current), attribute, &content)
                const arguments = expressionArguments(content)
                const name = mo.getFullyQualifiedImplementationCallName(current, attribute, baseFunctionName, "impl", conditional)
                mayThrowException = true
                toJSExpression = t.nativeToJSValue(attribute, current, cat([_]Str{ name, "(", r.sjoin(arguments, ", "), ")" }[0..]), "*lexicalGlobalObject", "*castedThis->realm()")
            }
            if mo.needsRuntimeCheck(current, attribute) {
                const condition = mo.generateRuntimeEnableConditionalString(current, attribute, "castedThis->realm()", true)
                p(out, cat([_]Str{ "    if (", condition, ") {\n" }[0..]))
                p(out, cat([_]Str{ "        auto ", attributeName, "Value = ", toJSExpression, ";\n" }[0..]))
                if mayThrowException { p(out, "        RETURN_IF_EXCEPTION(throwScope, { });\n") }
                p(out, cat([_]Str{ "        result->putDirect(vm, Identifier::fromString(vm, \"", attributeName, "\"_s), ", attributeName, "Value);\n" }[0..]))
                p(out, "    }\n")
            } else {
                p(out, cat([_]Str{ "    auto ", attributeName, "Value = ", toJSExpression, ";\n" }[0..]))
                if mayThrowException { p(out, "    RETURN_IF_EXCEPTION(throwScope, { });\n") }
                p(out, cat([_]Str{ "    result->putDirect(vm, Identifier::fromString(vm, \"", attributeName, "\"_s), ", attributeName, "Value);\n" }[0..]))
            }
            if r.truthy(conditional) { p(out, "#endif\n\n") }
        }
    }
    p(out, "    return JSValue::encode(result);\n")
    p(out, "}\n")
    p(out, "\n")
    p(out, cat([_]Str{ "JSC_DEFINE_HOST_FUNCTION(", functionName, ", (JSGlobalObject* lexicalGlobalObject, CallFrame* callFrame))\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    return IDLOperation<JS", typeName(interface), ">::call<", functionName, "Body>(*lexicalGlobalObject, *callFrame, \"toJSON\");\n" }[0..]))
    p(out, "}\n")
    p(out, "\n")
}

pub fn generateGetCallData(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomGetCallData") { return }
    include("JSPluginElementFunctions.h")
    p(out, cat([_]Str{ "CallData ", className, "::getCallData(JSCell* cell)\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(cell);\n" }[0..]))
    p(out, "    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n\n")
    p(out, "    return pluginElementCustomGetCallData(thisObject);\n")
    p(out, "}\n")
    p(out, "\n")
}

// ---------------------------------------------------------------------------
// [CallWith].

pub fn generateCallWithUsingReferences(callWith: Str, out: *StrList, returnValue: Str, thisReference: Str, callFrameReference: Str, indent: Str) -> StrList {
    const callFramePointer = if r.truthy(callFrameReference) { r.c2("&", callFrameReference) } else { callFrameReference }
    const globalObject = "uncheckedDowncast<JSDOMGlobalObject>(&lexicalGlobalObject)"
    return generateCallWith(callWith, out, returnValue, returnValue, callFramePointer, callFrameReference, globalObject, globalObject, thisReference, indent)
}

fn generateCallWithUsingPointers(callWith: Str, out: *StrList, returnValue: Str, thisReference: Str, indent: Str) -> StrList {
    const globalObject = "uncheckedDowncast<JSDOMGlobalObject>(lexicalGlobalObject)"
    return generateCallWith(callWith, out, returnValue, returnValue, "callFrame", "*callFrame", globalObject, globalObject, thisReference, indent)
}

fn generateConstructorCallWithUsingPointers(callWith: Str, out: *StrList, visibleInterfaceName: Str, thisReference: Str, indent: Str) -> StrList {
    const contextMissing = cat([_]Str{ "throwConstructorScriptExecutionContextUnavailableError(*lexicalGlobalObject, throwScope, \"", visibleInterfaceName, "\"_s)" }[0..])
    return generateCallWith(callWith, out, "", contextMissing, "callFrame", "*callFrame", "castedThis->realm()", "castedThis", thisReference, indent)
}

fn contextReturn(out: *StrList, indent: Str, contextMissing: Str) -> void {
    p(out, cat([_]Str{ indent, "    return", if r.truthy(contextMissing) { r.c2(" ", contextMissing) } else { "" }, ";\n" }[0..]))
}

fn generateCallWith(callWith: Str, out: *StrList, returnValue: Str, contextMissing: Str, callFramePointer: Str, callFrameReference: Str, globalObject: Str, scriptExecutionContextAccessor: Str, thisReference: Str, indentValue: Str) -> StrList {
    var args = r.strList()
    if !r.truthy(callWith) { return args }
    const indent = r.orElse(indentValue, "    ")
    if cg.extendedAttributeContains(callWith, "CurrentGlobalObject") { r.spush(&args, r.c2("*", globalObject)) }
    const relevantGlobalObjectPointer = cat([_]Str{ "(", thisReference, ").realm()" }[0..])
    if cg.extendedAttributeContains(callWith, "RelevantGlobalObject") { r.spush(&args, r.c2("*", relevantGlobalObjectPointer)) }
    if cg.extendedAttributeContains(callWith, "CurrentScriptExecutionContext") {
        p(out, cat([_]Str{ indent, "RefPtr context = ", scriptExecutionContextAccessor, "->scriptExecutionContext();\n" }[0..]))
        p(out, r.c2(indent, "if (!context) [[unlikely]]\n"))
        contextReturn(out, indent, contextMissing)
        r.spush(&args, "*context")
    }
    if cg.extendedAttributeContains(callWith, "RelevantScriptExecutionContext") {
        p(out, cat([_]Str{ indent, "auto* context = ", relevantGlobalObjectPointer, "->scriptExecutionContext();\n" }[0..]))
        p(out, r.c2(indent, "if (!context) [[unlikely]]\n"))
        contextReturn(out, indent, contextMissing)
        r.spush(&args, "*context")
    }
    if cg.extendedAttributeContains(callWith, "CurrentDocument") {
        include("Document.h")
        p(out, cat([_]Str{ indent, "RefPtr context = ", scriptExecutionContextAccessor, "->scriptExecutionContext();\n" }[0..]))
        p(out, r.c2(indent, "if (!context) [[unlikely]]\n"))
        contextReturn(out, indent, contextMissing)
        p(out, r.c2(indent, "Ref document = downcast<Document>(*context);\n"))
        r.spush(&args, "document.get()")
    }
    if cg.extendedAttributeContains(callWith, "RelevantDocument") {
        include("Document.h")
        p(out, cat([_]Str{ indent, "RefPtr context = ", relevantGlobalObjectPointer, "->scriptExecutionContext();\n" }[0..]))
        p(out, r.c2(indent, "if (!context) [[unlikely]]\n"))
        contextReturn(out, indent, contextMissing)
        p(out, r.c2(indent, "Ref document = downcast<Document>(*context);\n"))
        r.spush(&args, "document.get()")
    }
    if cg.extendedAttributeContains(callWith, "IncumbentDocument") {
        include("LocalDOMWindow.h")
        include("JSDOMWindowBase.h")
        p(out, cat([_]Str{ indent, "auto* incumbentDocument = incumbentDOMWindow(*", globalObject, ", ", callFrameReference, ").document();\n" }[0..]))
        p(out, r.c2(indent, "if (!incumbentDocument)\n"))
        p(out, cat([_]Str{ indent, "    return", if r.truthy(returnValue) { r.c2(" ", returnValue) } else { "" }, ";\n" }[0..]))
        r.spush(&args, "*incumbentDocument")
    }
    if cg.extendedAttributeContains(callWith, "EntryDocument") {
        include("LocalDOMWindow.h")
        include("JSDOMWindowBase.h")
        r.spush(&args, cat([_]Str{ "firstDOMWindow(*", globalObject, ").document()" }[0..]))
    }
    if cg.extendedAttributeContains(callWith, "ActiveWindow") {
        include("LocalDOMWindow.h")
        include("JSDOMWindowBase.h")
        r.spush(&args, cat([_]Str{ "activeDOMWindow(*", globalObject, ")" }[0..]))
    }
    if cg.extendedAttributeContains(callWith, "IncumbentWindow") {
        include("LocalDOMWindow.h")
        include("JSDOMWindowBase.h")
        r.spush(&args, cat([_]Str{ "incumbentDOMWindow(*", globalObject, if r.truthy(callFrameReference) { r.c2(", ", callFrameReference) } else { "" }, ")" }[0..]))
    }
    if cg.extendedAttributeContains(callWith, "LegacyActiveWindowForAccessor") {
        include("LocalDOMWindow.h")
        include("JSDOMWindowBase.h")
        r.spush(&args, cat([_]Str{ "legacyActiveDOMWindowForAccessor(*", globalObject, if r.truthy(callFrameReference) { r.c2(", ", callFrameReference) } else { "" }, ")" }[0..]))
    }
    if cg.extendedAttributeContains(callWith, "FirstWindow") {
        include("LocalDOMWindow.h")
        include("JSDOMWindowBase.h")
        r.spush(&args, cat([_]Str{ "firstDOMWindow(*", globalObject, ")" }[0..]))
    }
    if cg.extendedAttributeContains(callWith, "RuntimeFlags") { r.spush(&args, r.c2(globalObject, "->runtimeFlags()")) }
    if cg.extendedAttributeContains(callWith, "World") { r.spush(&args, cat([_]Str{ "worldForDOMObject(", thisReference, ")" }[0..])) }
    if cg.extendedAttributeContains(callWith, "PropertyName") {
        include("JSDOMConvertStrings.h")
        r.spush(&args, "propertyNameToAtomString(propertyName)")
    }
    return args
}

// ---------------------------------------------------------------------------
// Arguments.

pub fn generateArgumentsCountCheck(out: *StrList, operation: *Node, interface: *Node, indent: Str) -> void {
    if operation.*.overloads != null && operation.*.overloads.?.*.count > 1 { return }
    var mandatory = operation.*.arguments.count
    var index = operation.*.arguments.count
    while index > 0 {
        index -= 1
        const argument = m.node(operation.*.arguments, index)
        if argument.*.isOptional || argument.*.isVariadic { mandatory -= 1 } else { break }
    }
    if mandatory >= 1 {
        p(out, cat([_]Str{ indent, "if (callFrame->argumentCount() < ", dec(mandatory), ") [[unlikely]]\n" }[0..]))
        p(out, r.c2(indent, "    return throwVMError(lexicalGlobalObject, throwScope, createNotEnoughArgumentsError(lexicalGlobalObject));\n"))
    }
}

const defaultValueTypes = [_]Str{ "any", "DOMString", "USVString", "boolean", "byte", "long long", "long", "octet", "short", "unsigned long long", "unsigned long", "unsigned short", "double", "float", "unrestricted double", "unrestricted float" }
const defaultValueValues = [_]Str{ "undefined", "\"undefined\"", "\"undefined\"", "false", "0", "0", "0", "0", "0", "0", "0", "0", "NaN", "NaN", "NaN", "NaN" }

pub fn willConvertUndefinedToDefaultParameterValue(ty: *IDLType, defaultValue: Str) -> bool {
    var index: usize = 0
    while index < defaultValueTypes.length {
        if std.text.same(defaultValueTypes[index], ty.*.name) {
            if std.text.same(defaultValueValues[index], defaultValue) && !m.on(ty.*.ext, "EnforceRange") { return true }
            break
        }
        index += 1
    }
    if std.text.same(defaultValue, "null") && cg.isWrapperType(ty) { return true }
    if std.text.same(defaultValue, "{}") { return true }
    return false
}

fn isDictionaryLiteralDefaultValueValid(ty: *IDLType) -> bool {
    if cg.isDictionaryType(ty) { return true }
    if ty.*.isUnion {
        const members = t.getFlattenedMemberTypes(ty)
        var index: usize = 0
        while index < members.count {
            if cg.isDictionaryType(r.at(*IDLType, members, index)) { return true }
            index += 1
        }
        return false
    }
    if cg.isRecordType(ty) { return true }
    return false
}

fn generateArgumentConversions(out: *StrList, inputArguments: r.List, outputArguments: *StrList, globalObjectReference: Str, interface: *Node, quotedFunctionName: Str, functionImplementationName: Str, conditional: Str, indent: Str, thisObjectReferenceValue: Str) -> void {
    const thisObjectReference = r.orElse(thisObjectReferenceValue, "*castedThis")
    var argumentIndex: usize = 0
    while argumentIndex < inputArguments.count {
        const argument = m.node(inputArguments, argumentIndex)
        const ty = argument.*.ty.?
        js.addToImplIncludesForIDLType(ty, conditional)
        if argument.*.isOptional {
            if !r.isDef(argument.*.defaultValue) {
                if std.text.same(ty.*.name, "any") { argument.*.defaultValue = "undefined" }
                if cg.isStringType(ty) { argument.*.defaultValue = "null" }
                if ty.*.isNullable { argument.*.defaultValue = "null" }
            } else {
                if std.text.same(argument.*.defaultValue, "{}") && !isDictionaryLiteralDefaultValueValid(ty) { r.die("Default value '{}' is only supported by dictionary types, union types containing a dictionary (and record types as a non-standard extension)") }
                if std.text.same(argument.*.defaultValue, "[]") && !cg.isSequenceOrFrozenArrayType(ty) { r.die("Default value '[]' is only supported by sequence types and frozen array types") }
            }
        }
        const name = argument.*.name
        var v = name
        const index = dec(argumentIndex)
        if argument.*.isVariadic {
            js.addToImplIncludes("JSDOMConvertVariadic.h", conditional)
            const idlType = t.getIDLType(interface, ty)
            p(out, cat([_]Str{ indent, "auto ", name, " = convertVariadicArguments<", idlType, ">(*lexicalGlobalObject, *callFrame, ", index, ");\n" }[0..]))
            p(out, r.c2(indent, "RETURN_IF_EXCEPTION(throwScope, encodedJSValue());\n"))
            v = cat([_]Str{ "WTF::move(", name, ")" }[0..])
        } else {
            if argument.*.isOptional {
                if on(argument, "ReturnValue") { r.die("[ReturnValue] is not supported for optional arguments") }
                p(out, cat([_]Str{ indent, "EnsureStillAliveScope argument", index, " = callFrame->argument(", index, ");\n" }[0..]))
            } else {
                p(out, cat([_]Str{ indent, "EnsureStillAliveScope argument", index, " = callFrame->uncheckedArgument(", index, ");\n" }[0..]))
            }
            const lookup = cat([_]Str{ "argument", index, ".value()" }[0..])
            const thrower = mo.getArgumentExceptionThrowerFunctor(interface, argument, index, quotedFunctionName)
            const defaultFunctor = mo.getArgumentDefaultValueFunctor(interface, argument)
            const optional = t.argumentIsOptional(argument)
            const nativeValue = t.jsValueToNative(interface, argument, lookup, conditional, "lexicalGlobalObject", "*lexicalGlobalObject", thisObjectReference, globalObjectReference, thrower, functionImplementationName, optional, defaultFunctor, r.undef())
            p(out, cat([_]Str{ indent, "auto ", name, "ConversionResult = ", nativeValue, ";\n" }[0..]))
            p(out, cat([_]Str{ indent, "if (", name, "ConversionResult.hasException(throwScope)) [[unlikely]]\n" }[0..]))
            p(out, r.c2(indent, "   return encodedJSValue();\n"))
            v = r.c2(name, "ConversionResult.releaseReturnValue()")
        }
        r.spush(outputArguments, v)
        argumentIndex += 1
    }
}

pub fn generateOperationParametersCheck(out: *StrList, operation: *Node, interface: *Node, functionImplementationName: Str, indent: Str) -> Str {
    const visibleInterfaceName = cg.getVisibleInterfaceName(interface)
    const conditional = ext(operation, "Conditional")
    const isConstructor = operation.*.isConstructor
    const globalObjectReference = if operation.*.isStatic { "*uncheckedDowncast<JSDOMGlobalObject>(lexicalGlobalObject)" } else { "*castedThis->realm()" }
    const functionName = mo.getFullyQualifiedImplementationCallName(interface, operation, functionImplementationName, "impl", conditional)
    var arguments = r.strList()
    mo.addAdditionalArgumentsForImplementationCall(&arguments, interface, operation, "impl", "*lexicalGlobalObject", "*callFrame", "*castedThis")
    var callWith = ext(operation, "CallWith")
    if operation.*.isStatic && containsPrefix(callWith, "Relevant") { r.die("[CallWith=Relevant*] can't be used with static operations.") }
    var quotedFunctionName: Str = ""
    if !isConstructor {
        quotedFunctionName = cat([_]Str{ "\"", operation.*.name, "\"_s" }[0..])
        r.sappend(&arguments, generateCallWithUsingPointers(callWith, out, "JSValue::encode(jsUndefined())", "*castedThis", r.undef()))
    } else {
        quotedFunctionName = "nullptr"
        if !r.truthy(callWith) { callWith = ext(operation, "LegacyFactoryFunctionCallWith") }
        r.sappend(&arguments, generateConstructorCallWithUsingPointers(callWith, out, visibleInterfaceName, "*castedThis", r.undef()))
    }
    generateArgumentConversions(out, operation.*.arguments, &arguments, globalObjectReference, interface, quotedFunctionName, functionImplementationName, conditional, indent, r.undef())
    if operation.*.ty != null && cg.isPromiseType(operation.*.ty.?) && !on(operation, "PromiseProxy") && !on(operation, "ReturnsOwnPromise") { r.spush(&arguments, "WTF::move(promise)") }
    if on(operation, "ReturnsPromisePair") { r.spush(&arguments, "WTF::move(promise), WTF::move(promise2)") }
    return cat([_]Str{ functionName, "(", r.sjoin(arguments, ", "), ")" }[0..])
}

// ---------------------------------------------------------------------------
// Implementation calls.

fn generateWriteBarriersForArguments(out: *StrList, operation: *Node, indent: Str, isDryRun: bool) -> bool {
    var hasOutput = false
    var index: usize = 0
    while index < operation.*.arguments.count {
        const argument = m.node(operation.*.arguments, index)
        if std.text.same(typeName(argument), "EventListener") {
            if !isDryRun { p(out, cat([_]Str{ indent, "vm.writeBarrier(&static_cast<JSObject&>(*castedThis), argument", dec(index), ".value());\n" }[0..])) }
            hasOutput = true
        }
        index += 1
    }
    return hasOutput
}

fn generateImplementationFunctionCall(out: *StrList, operation: *Node, interface: *Node, functionString: Str, indent: Str, hasThrowScope: bool) -> void {
    const callTracer = r.orElse(ext(operation, "CallTracer"), ext(interface, "CallTracer"))
    if r.truthy(callTracer) {
        var types = r.strList()
        var expressions = r.strList()
        var index: usize = 0
        while index < operation.*.arguments.count {
            const argument = m.node(operation.*.arguments, index)
            index += 1
            r.spush(&types, t.getIDLTypeForArgument(interface, argument))
            r.spush(&expressions, r.c2(argument.*.name, "ConversionResult.returnValue()"))
        }
        mo.generateCallTracer(out, callTracer, operation.*.name, types, expressions, indent)
    }
    const hasWriteBarriers = generateWriteBarriersForArguments(out, operation, indent, true)
    const returnArgumentName = mo.getOperationReturnedArgumentName(operation)
    if r.truthy(returnArgumentName) {
        p(out, cat([_]Str{ indent, "invokeFunctorPropagatingExceptionIfNecessary(*lexicalGlobalObject, throwScope, [&] { return ", functionString, "; });\n" }[0..]))
        const ignored = generateWriteBarriersForArguments(out, operation, indent, false)
        p(out, cat([_]Str{ indent, "return JSValue::encode(", returnArgumentName, ".value());\n" }[0..]))
    } else {
        const globalObjectReference = if operation.*.isStatic { "*uncheckedDowncast<JSDOMGlobalObject>(lexicalGlobalObject)" } else { "*castedThis->realm()" }
        if hasWriteBarriers {
            p(out, cat([_]Str{ indent, "auto result = JSValue::encode(", t.nativeToJSValueUsingPointers(operation, interface, functionString, globalObjectReference), ");\n" }[0..]))
            if hasThrowScope { p(out, r.c2(indent, "RETURN_IF_EXCEPTION(throwScope, encodedJSValue());\n")) }
            const ignored = generateWriteBarriersForArguments(out, operation, indent, false)
            p(out, r.c2(indent, "return result;\n"))
        } else {
            p(out, cat([_]Str{ indent, "RELEASE_AND_RETURN(throwScope, JSValue::encode(", t.nativeToJSValueUsingPointers(operation, interface, functionString, globalObjectReference), "));\n" }[0..]))
        }
    }
}

fn generateImplementationCustomFunctionCall(out: *StrList, operation: *Node, interface: *Node, className: Str, functionImplementationName: Str, indent: Str) -> void {
    var arguments = r.strList()
    r.spush(&arguments, "*lexicalGlobalObject")
    r.spush(&arguments, "*callFrame")
    if cg.isPromiseType(operation.*.ty.?) && !on(operation, "ReturnsOwnPromise") { r.spush(&arguments, "WTF::move(promise)") }
    if operation.*.isStatic {
        p(out, cat([_]Str{ indent, "RELEASE_AND_RETURN(throwScope, (JSValue::encode(", className, "::", functionImplementationName, "(", r.sjoin(arguments, ", "), "))));\n" }[0..]))
    } else {
        p(out, cat([_]Str{ indent, "RELEASE_AND_RETURN(throwScope, (JSValue::encode(castedThis->", functionImplementationName, "(", r.sjoin(arguments, ", "), "))));\n" }[0..]))
    }
}

// ---------------------------------------------------------------------------
// Iterators.

pub fn generateAsyncIterableDefinition(interface: *Node) -> void { generateGenericIterableDefinition(interface, interface.*.asyncIterable.?) }
pub fn generateIterableDefinition(interface: *Node) -> void { generateGenericIterableDefinition(interface, interface.*.iterable.?) }

fn generateGenericIterableDefinition(interface: *Node, iterable: *Node) -> void {
    if on(interface, "JSBuiltin") { return }
    const interfaceName = typeName(interface)
    const className = r.c2("JS", interfaceName)
    const visibleInterfaceName = cg.getVisibleInterfaceName(interface)
    var iteratorBase: Str = ""
    var iteratorPrototypeBase: Str = ""
    if interface.*.iterable != null {
        iteratorBase = "JSDOMIteratorBase"
        iteratorPrototypeBase = "JSDOMIteratorPrototype"
        include("JSDOMIterator.h")
    } else {
        iteratorBase = "JSDOMAsyncIteratorBase"
        iteratorPrototypeBase = "JSDOMAsyncIteratorPrototype"
        include("JSDOMAsyncIterator.h")
    }
    include("<JavaScriptCore/SlotVisitorMacros.h>")
    if !mo.isKeyValueIterableInterface(interface) { return }
    const iteratorName = r.c2(interfaceName, "Iterator")
    const iteratorPrototypeName = r.c2(interfaceName, "IteratorPrototype")
    const traitsName = r.c2(interfaceName, "IteratorTraits")
    const traitsType = if iterable.*.isKeyValue { "JSDOMIteratorType::Map" } else { "JSDOMIteratorType::Set" }
    const traitsKeyType = if iterable.*.isKeyValue { t.getIDLType(interface, iterable.*.keyType.?) } else { "void" }
    const traitsValueType = t.getIDLType(interface, iterable.*.valueType.?)
    if iterable.*.isKeyValue { js.addToImplIncludesForIDLType(iterable.*.keyType.?, r.undef()) }
    js.addToImplIncludesForIDLType(iterable.*.valueType.?, r.undef())
    const out = js.implContent
    p(out, cat([_]Str{
        "struct ", traitsName, " {\n    static constexpr JSDOMIteratorType type = ", traitsType, ";\n    using KeyType = ", traitsKeyType, ";\n    using ValueType = ", traitsValueType, ";\n};\n\n",
        "using ", iteratorName, "Base = ", iteratorBase, "<", className, ", ", traitsName, ">;\n",
        "class ", iteratorName, " final : public ", iteratorName, "Base {\npublic:\n    using Base = ", iteratorName, "Base;\n    DECLARE_INFO;\n\n",
        "    template<typename, SubspaceAccess mode> static JSC::GCClient::IsoSubspace* subspaceFor(JSC::VM& vm)\n    {\n        if constexpr (mode == JSC::SubspaceAccess::Concurrently)\n            return nullptr;\n",
        "        return WebCore::subspaceForImpl<", iteratorName, ", UseCustomHeapCellType::No>(vm, \"", iteratorName, "\"_s,\n",
        "            [] (auto& spaces) { return spaces.m_clientSubspaceFor", iteratorName, ".get(); },\n",
        "            [] (auto& spaces, auto&& space) { spaces.m_clientSubspaceFor", iteratorName, " = std::forward<decltype(space)>(space); },\n",
        "            [] (auto& spaces) { return spaces.m_subspaceFor", iteratorName, ".get(); },\n",
        "            [] (auto& spaces, auto&& space) { spaces.m_subspaceFor", iteratorName, " = std::forward<decltype(space)>(space); }\n        );\n    }\n\n",
        "    static JSC::Structure* createStructure(JSC::VM& vm, JSC::JSGlobalObject* globalObject, JSC::JSValue prototype)\n    {\n        return JSC::Structure::create(vm, globalObject, prototype, JSC::TypeInfo(JSC::ObjectType, StructureFlags), info(), JSC::NonArray);\n    }\n\n",
        "    static ", iteratorName, "* create(JSC::VM& vm, JSC::Structure* structure, ", className, "& iteratedObject, IterationKind kind, InternalIterator&& iterator)\n    {\n",
        "        auto* instance = new (NotNull, JSC::allocateCell<", iteratorName, ">(vm)) ", iteratorName, "(structure, iteratedObject, kind, WTF::move(iterator));\n        instance->finishCreation(vm);\n        return instance;\n    }\n",
    }[0..]))
    if interface.*.asyncIterable != null {
        p(out, "\n    JSC::JSBoundFunction* createOnSettledFunction(JSC::JSGlobalObject*);\n    JSC::JSBoundFunction* createOnFulfilledFunction(JSC::JSGlobalObject*);\n    JSC::JSBoundFunction* createOnRejectedFunction(JSC::JSGlobalObject*);\n")
    }
    p(out, cat([_]Str{
        "private:\n    ", iteratorName, "(JSC::Structure* structure, ", className, "& iteratedObject, IterationKind kind, InternalIterator&& iterator)\n        : Base(structure, iteratedObject, kind, WTF::move(iterator))\n    {\n    }\n};\n\n",
        "using ", iteratorPrototypeName, " = ", iteratorPrototypeBase, "<", className, ", ", traitsName, ">;\n",
        "JSC_ANNOTATE_HOST_FUNCTION(", iteratorPrototypeName, "Next, ", iteratorPrototypeName, "::next);\n\n",
        "template<>\nconst JSC::ClassInfo ", iteratorName, "Base::s_info = { \"", visibleInterfaceName, "Base Iterator\"_s, &Base::s_info, nullptr, nullptr, CREATE_METHOD_TABLE(", iteratorName, "Base) };\n",
        "const JSC::ClassInfo ", iteratorName, "::s_info = { \"", visibleInterfaceName, " Iterator\"_s, &Base::s_info, nullptr, nullptr, CREATE_METHOD_TABLE(", iteratorName, ") };\n\n",
        "template<>\nconst JSC::ClassInfo ", iteratorPrototypeName, "::s_info = { \"", visibleInterfaceName, " Iterator\"_s, &Base::s_info, nullptr, nullptr, CREATE_METHOD_TABLE(", iteratorPrototypeName, ") };\n\n",
    }[0..]))
    var index: usize = 0
    while index < iterable.*.operations.count {
        const operation = m.node(iterable.*.operations, index)
        index += 1
        const propertyName = operation.*.name
        const functionName = mo.getFunctionName(interface, className, operation)
        if std.text.same(propertyName, "[Symbol.Iterator]") || std.text.same(propertyName, "[Symbol.asyncIterator]") { continue }
        if std.text.same(propertyName, "forEach") {
            p(out, cat([_]Str{ "static inline EncodedJSValue ", functionName, "Caller(JSGlobalObject* lexicalGlobalObject, CallFrame* callFrame, JS", interfaceName, "* thisObject)\n" }[0..]))
            p(out, "{\n")
            p(out, cat([_]Str{ "    return JSValue::encode(iteratorForEach<", iteratorName, ">(*lexicalGlobalObject, *callFrame, *thisObject));\n" }[0..]))
            p(out, "}\n\n")
        } else {
            var kind: Str = "Entries"
            if std.text.same(propertyName, "keys") { kind = "Keys" }
            if std.text.same(propertyName, "values") { kind = "Values" }
            if std.text.same(propertyName, "entries") && !iterable.*.isKeyValue { kind = "Values" }
            p(out, cat([_]Str{ "static inline EncodedJSValue ", functionName, "Caller(JSGlobalObject* lexicalGlobalObject, CallFrame* callFrame, JS", interfaceName, "* thisObject)\n" }[0..]))
            p(out, "{\n")
            p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
            p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
            p(out, "    UNUSED_PARAM(throwScope);\n")
            p(out, "    UNUSED_PARAM(callFrame);\n")
            var arguments = r.strList()
            r.spush(&arguments, "*thisObject")
            r.spush(&arguments, "*lexicalGlobalObject")
            r.spush(&arguments, "throwScope")
            r.spush(&arguments, r.c2("IterationKind::", kind))
            if interface.*.asyncIterable != null {
                const quotedFunctionName = cat([_]Str{ "\"", functionName, "\"_s" }[0..])
                const conditional = ext(operation, "Conditional")
                generateArgumentsCountCheck(out, interface.*.asyncIterable.?, interface, "    ")
                generateArgumentConversions(out, interface.*.asyncIterable.?.*.arguments, &arguments, "*thisObject->realm()", interface, quotedFunctionName, functionName, conditional, "    ", "*thisObject")
            }
            p(out, cat([_]Str{ "    RELEASE_AND_RETURN(throwScope, JSValue::encode(iteratorCreate<", iteratorName, ">(", r.sjoin(arguments, ", "), ")));\n" }[0..]))
            p(out, "}\n\n")
        }
        p(out, cat([_]Str{ "JSC_DEFINE_HOST_FUNCTION(", functionName, ", (JSC::JSGlobalObject* lexicalGlobalObject, JSC::CallFrame* callFrame))\n{\n    return IDLOperation<", className, ">::call<", functionName, "Caller>(*lexicalGlobalObject, *callFrame, \"", propertyName, "\");\n}\n\n" }[0..]))
    }
    if interface.*.asyncIterable != null {
        p(out, cat([_]Str{
            "JSC_ANNOTATE_HOST_FUNCTION(", iteratorName, "BaseOnPromiseSettled, ", iteratorName, "Base::onPromiseSettled);\n",
            "JSC_ANNOTATE_HOST_FUNCTION(", iteratorName, "BaseOnPromiseFulfilled, ", iteratorName, "Base::onPromiseFulFilled);\n",
            "JSC_ANNOTATE_HOST_FUNCTION(", iteratorName, "BaseOnPromiseRejected, ", iteratorName, "Base::onPromiseRejected);\n",
        }[0..]))
    }
}
