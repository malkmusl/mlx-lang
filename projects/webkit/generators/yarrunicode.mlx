// The Unicode property classes of JavaScriptCore's regular expressions
// (yarr/UnicodePatternTables.h: \p{...} and \P{...}), made as WebKit's
// yarr/generateYarrUnicodePropertyTables.py makes them, from the files of
// the Unicode Character Database in UCD_DIRECTORY:
//
//     webkit-yarr-unicode-tables UCD_DIRECTORY OUTPUT
//
// It reads PropertyAliases.txt, PropertyValueAliases.txt, UnicodeData.txt
// (the general categories), DerivedBinaryProperties.txt,
// DerivedCoreProperties.txt, DerivedNormalizationProps.txt, PropList.txt,
// emoji-data.txt (the binary properties), Scripts.txt,
// ScriptExtensions.txt, emoji-sequences.txt and emoji-zwj-sequences.txt
// (the properties of strings).
//
// Each class is four sorted lists, Latin-1 characters and ranges and the
// others, and strings for the sequence properties; a function creates
// each. Hash tables (rapidhash, as WTF hashes strings) find the classes
// by their names and aliases. The lists are built the way the script
// builds them, one character or range at a time, including what it does
// with ones that come out of order, so that every list and count comes
// out as its own do.
const std = @import("std")
const s = @import("./support.mlx")
const rapidhash = @import("./rapidhash.mlx")
const u = @import("./ucdsupport.mlx")

const HEADER = "/*\n* Copyright (C) 2017-2023 Apple Inc. All rights reserved.\n*\n* Redistribution and use in source and binary forms, with or without\n* modification, are permitted provided that the following conditions\n* are met:\n*\n* 1.  Redistributions of source code must retain the above copyright\n*     notice, this list of conditions and the following disclaimer.\n* 2.  Redistributions in binary form must reproduce the above copyright\n*     notice, this list of conditions and the following disclaimer in the\n*     documentation and/or other materials provided with the distribution.\n*\n* THIS SOFTWARE IS PROVIDED BY APPLE AND ITS CONTRIBUTORS \"AS IS\" AND ANY\n* EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n* WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n* DISCLAIMED. IN NO EVENT SHALL APPLE OR ITS CONTRIBUTORS BE LIABLE FOR ANY\n* DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n* (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n* LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n* ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n* (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF\n* THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n*/\n\n// DO NO EDIT! - This file was generated by generateYarrUnicodePropertyTables.py\n"

const FOOTER = "\n"

const LAST_LATIN1: i64 = 255
const LAST_ASCII: i64 = 127
const FIRST_NON_LATIN1: i64 = 256
const MAX_UNICODE: i64 = 1114111
const MAX_BMP: i64 = 65535

// ---------------------------------------------------------------------------
// Growable lists of numbers (characters, or ranges packed as low * 2^32 +
// high, or strings), named by their number in one pool.

const List = struct {
    items: [*]i64
    length: usize
    capacity: usize
}

const MAX_LISTS: usize = 16384
var lists: [*]List = undefined
var listCount: usize = 0

fn newList(capacity: usize) -> usize {
    if listCount == MAX_LISTS { s.fail("generateYarrUnicodePropertyTables: too many lists") }
    var items: [*]i64 = undefined
    unsafe { items = @ptrFromInt([*]i64, s.alloc(capacity * 8)) }
    lists[listCount] = List.{ .items = items, .length = 0, .capacity = capacity }
    listCount += 1
    return listCount - 1
}

fn copyList(list: usize) -> usize {
    const length = lists[list].length
    const copy = newList(if length < 4 { 4 } else { length })
    var index: usize = 0
    while index < length {
        lists[copy].items[index] = lists[list].items[index]
        index += 1
    }
    lists[copy].length = length
    return copy
}

fn size(list: usize) -> usize { return lists[list].length }
fn get(list: usize, index: usize) -> i64 { return lists[list].items[index] }
fn last(list: usize) -> i64 { return lists[list].items[lists[list].length - 1] }

fn grow(list: usize) -> void {
    if lists[list].length < lists[list].capacity { return }
    const capacity = lists[list].capacity * 2
    var items: [*]i64 = undefined
    unsafe { items = @ptrFromInt([*]i64, s.alloc(capacity * 8)) }
    var index: usize = 0
    while index < lists[list].length {
        items[index] = lists[list].items[index]
        index += 1
    }
    lists[list].items = items
    lists[list].capacity = capacity
}

fn append(list: usize, value: i64) -> void {
    grow(list)
    lists[list].items[lists[list].length] = value
    lists[list].length += 1
}

// VALUE put before the item at AT (Python's insert).
fn insert(list: usize, at: usize, value: i64) -> void {
    grow(list)
    const items = lists[list].items
    var index = lists[list].length
    while index > at {
        items[index] = items[index - 1]
        index -= 1
    }
    items[at] = value
    lists[list].length += 1
}

fn remove(list: usize, at: usize) -> void {
    const items = lists[list].items
    var index = at
    while index + 1 < lists[list].length {
        items[index] = items[index + 1]
        index += 1
    }
    lists[list].length -= 1
}

fn pop(list: usize) -> i64 {
    const value = last(list)
    lists[list].length -= 1
    return value
}

// Where VALUE first is in LIST, or its length.
fn find(list: usize, value: i64) -> usize {
    var index: usize = 0
    while index < lists[list].length {
        if lists[list].items[index] == value { return index }
        index += 1
    }
    return lists[list].length
}

fn pair(low: i64, high: i64) -> i64 { return low * 4294967296 + high }
fn low(range: i64) -> i64 { return range >> 32 }
fn high(range: i64) -> i64 { return range & 4294967295 }
fn lowAt(list: usize, index: usize) -> i64 { return low(get(list, index)) }
fn highAt(list: usize, index: usize) -> i64 { return high(get(list, index)) }

fn minimum(a: i64, b: i64) -> i64 { return if a < b { a } else { b } }
fn maximum(a: i64, b: i64) -> i64 { return if a > b { a } else { b } }

// ---------------------------------------------------------------------------
// Strings of code points, in one pool: each is its start * 256 + its
// length.

var stringPool: [*]u32 = undefined
var stringPoolLength: usize = 0
const STRING_POOL_SIZE: usize = 4194304

fn stringStart(text: i64) -> usize { return @intCast(usize, text >> 8) }
fn stringLength(text: i64) -> usize { return @intCast(usize, text & 255) }

// Longest strings first, then in the order of their code points.
fn stringBefore(first: i64, second: i64) -> bool {
    const firstLength = stringLength(first)
    const secondLength = stringLength(second)
    if firstLength != secondLength { return firstLength > secondLength }
    var index: usize = 0
    while index < firstLength {
        const a = stringPool[stringStart(first) + index]
        const b = stringPool[stringStart(second) + index]
        if a != b { return a < b }
        index += 1
    }
    return false
}

// A stable sort, as Python's.
fn sortStrings(list: usize) -> void {
    const items = lists[list].items
    var index: usize = 1
    while index < lists[list].length {
        const moving = items[index]
        var at = index
        while at > 0 && stringBefore(moving, items[at - 1]) {
            items[at] = items[at - 1]
            at -= 1
        }
        items[at] = moving
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Names and their aliases.

// Lists of names, numbered (0 is the empty one).
const Names = struct {
    items: [*][]const u8
    count: usize
}

const MAX_NAME_LISTS: usize = 8192
var nameLists: [*]Names = undefined
var nameListCount: usize = 0

fn newNames(capacity: usize) -> usize {
    var items: [*][]const u8 = undefined
    unsafe { items = @ptrFromInt([*][]const u8, s.alloc(capacity * 16 + 16)) }
    if nameListCount == MAX_NAME_LISTS { s.fail("generateYarrUnicodePropertyTables: too many aliases") }
    nameLists[nameListCount] = Names.{ .items = items, .count = 0 }
    nameListCount += 1
    return nameListCount - 1
}

// Dictionaries from names, in the order their keys came (as Python's):
// to a number, and to a name.
const Map = struct {
    keys: [*][]const u8
    values: [*]usize
    texts: [*][]const u8
    count: usize
}

const MAP_CAPACITY: usize = 8192
const GLOBAL_ALIASES: usize = 0
const CATEGORY_ALIASES: usize = 1
const ALIAS_TO_CATEGORY: usize = 2
const SCRIPT_ALIASES: usize = 3
const ALIAS_TO_SCRIPT: usize = 4
const CATEGORIES: usize = 5
const BINARY_PROPERTIES: usize = 6
const SCRIPTS: usize = 7
const SCRIPT_EXTENSIONS: usize = 8
const SEQUENCE_PROPERTIES: usize = 9
const MAP_COUNT: usize = 10
var maps: [*]Map = undefined

fn mapFind(map: usize, key: []const u8) -> usize {
    var index: usize = 0
    while index < maps[map].count {
        if std.text.same(maps[map].keys[index], key) { return index }
        index += 1
    }
    return maps[map].count
}

fn has(map: usize, key: []const u8) -> bool { return mapFind(map, key) < maps[map].count }

// KEY given VALUE and TEXT: where it was if it was there, else last.
fn put(map: usize, key: []const u8, value: usize, text: []const u8) -> void {
    const at = mapFind(map, key)
    if at == maps[map].count {
        if at == MAP_CAPACITY { s.fail("generateYarrUnicodePropertyTables: too many names") }
        maps[map].keys[at] = key
        maps[map].count += 1
    }
    maps[map].values[at] = value
    maps[map].texts[at] = text
}

fn valueOf(map: usize, key: []const u8) -> usize {
    const at = mapFind(map, key)
    if at == maps[map].count { s.fail(s.join("generateYarrUnicodePropertyTables: no entry for ", key)) }
    return maps[map].values[at]
}

// The aliases of NAME in an alias dictionary (none when it has none).
fn aliasesIn(map: usize, name: []const u8) -> usize {
    const at = mapFind(map, name)
    return if at == maps[map].count { 0 } else { maps[map].values[at] }
}

// The name an alias stands for in a reverse dictionary ("" when none).
fn nameFor(map: usize, alias: []const u8) -> []const u8 {
    const at = mapFind(map, alias)
    return if at == maps[map].count { "" } else { maps[map].texts[at] }
}

// ---------------------------------------------------------------------------
// The classes (the script's PropertyData), numbered as they are made.

const Property = struct {
    name: []const u8
    aliases: usize
    hasBMP: bool
    hasNonBMP: bool
    hasStrings: bool
    strings: usize
    matches: usize
    ranges: usize
    unicodeMatches: usize
    unicodeRanges: usize
    count: i64
}

const MAX_PROPERTIES: usize = 2048
var props: [*]Property = undefined
var propCount: usize = 0

fn newProperty(name: []const u8) -> usize {
    if propCount == MAX_PROPERTIES { s.fail("generateYarrUnicodePropertyTables: too many properties") }
    props[propCount] = Property.{ .name = name, .aliases = 0, .hasBMP = false, .hasNonBMP = false, .hasStrings = false,
        .strings = newList(4), .matches = newList(4), .ranges = newList(4), .unicodeMatches = newList(4), .unicodeRanges = newList(4), .count = 0 }
    propCount += 1
    return propCount - 1
}

fn copyProperty(p: usize) -> usize {
    if propCount == MAX_PROPERTIES { s.fail("generateYarrUnicodePropertyTables: too many properties") }
    const from = props[p]
    props[propCount] = Property.{ .name = from.name, .aliases = from.aliases, .hasBMP = from.hasBMP, .hasNonBMP = from.hasNonBMP,
        .hasStrings = from.hasStrings, .strings = copyList(from.strings), .matches = copyList(from.matches), .ranges = copyList(from.ranges),
        .unicodeMatches = copyList(from.unicodeMatches), .unicodeRanges = copyList(from.unicodeRanges), .count = from.count }
    propCount += 1
    return propCount - 1
}

fn addMatch(p: usize, codePoint: i64) -> void {
    if codePoint <= MAX_BMP {
        props[p].hasBMP = true
    } else {
        props[p].hasNonBMP = true
    }
    const latin1 = codePoint <= LAST_LATIN1
    const matches = if latin1 { props[p].matches } else { props[p].unicodeMatches }
    const ranges = if latin1 { props[p].ranges } else { props[p].unicodeRanges }
    if (size(matches) > 0 && last(matches) > codePoint) || (size(ranges) > 0 && high(last(ranges)) > codePoint) {
        addMatchUnordered(p, codePoint)
        return
    }
    props[p].count += 1
    if size(matches) > 0 && last(matches) == codePoint - 1 {
        const lowCodePoint = pop(matches)
        append(ranges, pair(lowCodePoint, codePoint))
    } else if size(ranges) > 0 && high(last(ranges)) == codePoint - 1 {
        const prior = pop(ranges)
        append(ranges, pair(low(prior), codePoint))
    } else {
        append(matches, codePoint)
    }
}

fn addMatchString(p: usize, text: i64) -> void {
    append(props[p].strings, text)
    props[p].hasStrings = true
}

fn addRange(p: usize, lowCodePoint: i64, highCodePoint: i64) -> void {
    if lowCodePoint <= MAX_BMP { props[p].hasBMP = true }
    if highCodePoint > MAX_BMP { props[p].hasNonBMP = true }
    if highCodePoint <= LAST_LATIN1 {
        const matches = props[p].matches
        const ranges = props[p].ranges
        if (size(matches) > 0 && last(matches) > lowCodePoint) || (size(ranges) > 0 && high(last(ranges)) > lowCodePoint) {
            addRangeUnordered(p, lowCodePoint, highCodePoint)
            return
        }
        props[p].count += highCodePoint - lowCodePoint + 1
        var from = lowCodePoint
        if size(matches) > 0 && last(matches) == lowCodePoint - 1 {
            from = pop(matches)
        } else if size(ranges) > 0 && high(last(ranges)) == lowCodePoint - 1 {
            from = low(pop(ranges))
        }
        append(ranges, pair(from, highCodePoint))
    } else if lowCodePoint <= LAST_LATIN1 {
        if lowCodePoint == LAST_LATIN1 {
            addMatch(p, lowCodePoint)
        } else {
            addRange(p, lowCodePoint, LAST_LATIN1)
        }
        if highCodePoint == FIRST_NON_LATIN1 {
            addMatch(p, highCodePoint)
        } else {
            addRange(p, FIRST_NON_LATIN1, highCodePoint)
        }
    } else {
        const matches = props[p].unicodeMatches
        const ranges = props[p].unicodeRanges
        if (size(matches) > 0 && last(matches) > lowCodePoint) || (size(ranges) > 0 && high(last(ranges)) > lowCodePoint) {
            addRangeUnordered(p, lowCodePoint, highCodePoint)
            return
        }
        props[p].count += highCodePoint - lowCodePoint + 1
        if size(matches) > 0 && last(matches) == lowCodePoint - 1 {
            const from = pop(matches)
            append(ranges, pair(from, highCodePoint))
        } else if size(ranges) > 0 && high(last(ranges)) == lowCodePoint - 1 {
            const prior = pop(ranges)
            append(ranges, pair(low(prior), highCodePoint))
        } else {
            append(ranges, pair(lowCodePoint, highCodePoint))
        }
    }
}

// The script's addMatchUnorderedForMatchesAndRanges.
fn addMatchUnorderedTo(p: usize, codePoint: i64, matches: usize, ranges: usize) -> void {
    if find(matches, codePoint) < size(matches) { return }
    var insertLocation = size(matches)
    var located = false
    var lowCodePoint = codePoint
    var highCodePoint = codePoint
    var idx: usize = 0
    while idx < size(matches) {
        const each = get(matches, idx)
        if codePoint == each + 1 {
            lowCodePoint = each
            if idx + 1 < size(matches) && codePoint == get(matches, idx + 1) - 1 {
                highCodePoint = get(matches, idx + 1)
                remove(matches, idx + 1)
                props[p].count -= 1
            } else {
                highCodePoint = codePoint
            }
            remove(matches, idx)
            props[p].count -= 1
            break
        } else if codePoint == each - 1 {
            lowCodePoint = codePoint
            highCodePoint = each
            remove(matches, idx)
            props[p].count -= 1
            break
        } else if codePoint < each {
            insertLocation = idx
            located = true
            break
        }
        idx += 1
    }
    if !located { insertLocation = size(matches) }

    const rangeCount = size(ranges)
    idx = 0
    while idx < rangeCount {
        const current = get(ranges, idx)
        if lowCodePoint >= low(current) && highCodePoint <= high(current) { return }
        if lowCodePoint <= high(current) + 1 && highCodePoint >= low(current) - 1 {
            mergeRanges(p, ranges, idx, lowCodePoint, highCodePoint)
            return
        } else if highCodePoint < low(current) {
            if lowCodePoint != highCodePoint {
                insert(ranges, idx, pair(lowCodePoint, highCodePoint))
                props[p].count += highCodePoint - lowCodePoint + 1
                return
            }
            break
        }
        idx += 1
    }
    if lowCodePoint != highCodePoint {
        append(ranges, pair(lowCodePoint, highCodePoint))
        props[p].count += highCodePoint - lowCodePoint + 1
        return
    }
    insert(matches, insertLocation, codePoint)
    props[p].count += 1
}

// LOW..HIGH joined with the ranges from AT on that it meets or touches,
// as one range in their place.
fn mergeRanges(p: usize, ranges: usize, at: usize, lowStart: i64, highStart: i64) -> void {
    var lowCodePoint = lowStart
    var highCodePoint = highStart
    while at < size(ranges) && highCodePoint >= lowAt(ranges, at) - 1 {
        const current = get(ranges, at)
        lowCodePoint = minimum(lowCodePoint, low(current))
        highCodePoint = maximum(highCodePoint, high(current))
        remove(ranges, at)
        props[p].count -= high(current) - low(current) + 1
    }
    insert(ranges, at, pair(lowCodePoint, highCodePoint))
    props[p].count += highCodePoint - lowCodePoint + 1
}

// The script's addRangeUnorderedForMatchesAndRanges.
fn addRangeUnorderedTo(p: usize, lowStart: i64, highStart: i64, matches: usize, ranges: usize) -> void {
    var lowCodePoint = lowStart
    var highCodePoint = highStart
    if size(matches) > 0 && highCodePoint >= get(matches, 0) && lowCodePoint <= last(matches) {
        const matchCount = size(matches)
        var idx: usize = 0
        while idx < matchCount {
            const each = get(matches, idx)
            if lowCodePoint <= each && highCodePoint >= each {
                while idx < size(matches) && highCodePoint >= get(matches, idx) {
                    remove(matches, idx)
                    props[p].count -= 1
                }
                if idx + 1 < size(matches) && highCodePoint == get(matches, idx + 1) - 1 {
                    highCodePoint = get(matches, idx + 1)
                    remove(matches, idx + 1)
                    props[p].count -= 1
                }
                break
            } else if lowCodePoint == each + 1 {
                lowCodePoint = each
                while idx < size(matches) && highCodePoint >= get(matches, idx) {
                    remove(matches, idx)
                    props[p].count -= 1
                }
                if idx + 1 < size(matches) && highCodePoint == get(matches, idx + 1) - 1 {
                    highCodePoint = get(matches, idx + 1)
                    remove(matches, idx + 1)
                    props[p].count -= 1
                }
                break
            } else if highCodePoint == each - 1 {
                highCodePoint = each
                remove(matches, idx)
                props[p].count -= 1
                break
            } else if highCodePoint < each {
                break
            }
            idx += 1
        }
    }

    const rangeCount = size(ranges)
    var idx: usize = 0
    while idx < rangeCount {
        const current = get(ranges, idx)
        if lowCodePoint >= low(current) && highCodePoint <= high(current) { return }
        if lowCodePoint <= high(current) + 1 && highCodePoint >= low(current) - 1 {
            mergeRanges(p, ranges, idx, lowCodePoint, highCodePoint)
            return
        } else if highCodePoint < low(current) {
            insert(ranges, idx, pair(lowCodePoint, highCodePoint))
            props[p].count += highCodePoint - lowCodePoint + 1
            return
        }
        idx += 1
    }
    append(ranges, pair(lowCodePoint, highCodePoint))
    props[p].count += highCodePoint - lowCodePoint + 1
}

fn addMatchUnordered(p: usize, codePoint: i64) -> void {
    if codePoint <= LAST_LATIN1 {
        addMatchUnorderedTo(p, codePoint, props[p].matches, props[p].ranges)
    } else {
        addMatchUnorderedTo(p, codePoint, props[p].unicodeMatches, props[p].unicodeRanges)
    }
}

fn addRangeUnordered(p: usize, lowCodePoint: i64, highCodePoint: i64) -> void {
    if highCodePoint <= LAST_LATIN1 {
        addRangeUnorderedTo(p, lowCodePoint, highCodePoint, props[p].matches, props[p].ranges)
    } else if lowCodePoint >= FIRST_NON_LATIN1 {
        addRangeUnorderedTo(p, lowCodePoint, highCodePoint, props[p].unicodeMatches, props[p].unicodeRanges)
    } else {
        if lowCodePoint == LAST_LATIN1 {
            addMatchUnorderedTo(p, lowCodePoint, props[p].matches, props[p].ranges)
        } else {
            // The script takes the matches beyond Latin-1 here.
            addRangeUnorderedTo(p, lowCodePoint, LAST_LATIN1, props[p].unicodeMatches, props[p].ranges)
        }
        if highCodePoint == FIRST_NON_LATIN1 {
            addMatchUnorderedTo(p, highCodePoint, props[p].unicodeMatches, props[p].unicodeRanges)
        } else {
            addRangeUnorderedTo(p, FIRST_NON_LATIN1, highCodePoint, props[p].unicodeMatches, props[p].unicodeRanges)
        }
    }
}

fn removeMatchFromRanges(p: usize, codePoint: i64, ranges: usize) -> void {
    var idx: usize = 0
    while idx < size(ranges) {
        const current = get(ranges, idx)
        if low(current) <= codePoint && codePoint <= high(current) {
            remove(ranges, idx)
            if low(current) < codePoint && codePoint < high(current) {
                // The high part first, as insert puts it before the index.
                if codePoint + 1 == high(current) {
                    addMatchUnordered(p, codePoint + 1)
                } else {
                    insert(ranges, idx, pair(codePoint + 1, high(current)))
                }
                if low(current) == codePoint - 1 {
                    addMatchUnordered(p, low(current))
                } else {
                    insert(ranges, idx, pair(low(current), codePoint - 1))
                }
            } else {
                var rest = if low(current) == codePoint { pair(codePoint + 1, high(current)) } else { pair(low(current), codePoint - 1) }
                if low(rest) == high(rest) {
                    addMatchUnordered(p, low(rest))
                } else {
                    insert(ranges, idx, rest)
                }
            }
            props[p].count -= 1
            return
        }
        idx += 1
    }
}

fn removeMatch(p: usize, codePoint: i64) -> void {
    const latin1 = codePoint <= LAST_LATIN1
    const matches = if latin1 { props[p].matches } else { props[p].unicodeMatches }
    const at = find(matches, codePoint)
    if at < size(matches) {
        remove(matches, at)
        props[p].count -= 1
    } else {
        removeMatchFromRanges(p, codePoint, if latin1 { props[p].ranges } else { props[p].unicodeRanges })
    }
}

// ---------------------------------------------------------------------------
// The output.

fn outMatchData(valuesPerLine: usize, list: usize, isRange: bool, digits: usize) -> void {
    s.out("{")
    var valuesThisLine: usize = 0
    var index: usize = 0
    while index < size(list) {
        if index > 0 { s.out(", ") }
        valuesThisLine += 1
        if valuesThisLine > valuesPerLine {
            s.out("\n            ")
            valuesThisLine = 1
        }
        const value = get(list, index)
        if isRange {
            s.out("{0x")
            u.outHex(@intCast(u64, low(value)), digits, false)
            s.out(", 0x")
            u.outHex(@intCast(u64, high(value)), digits, false)
            s.out("}")
        } else {
            s.out("0x")
            u.outHex(@intCast(u64, value), digits, false)
        }
        index += 1
    }
    s.out("}")
}

fn outStringTables(p: usize) -> void {
    const strings = props[p].strings
    s.out("static constexpr char32_t kStrings")
    s.outUnsigned(@intCast(u64, p))
    s.out("Data[] = {\n    ")
    var valuesThisLine: usize = 0
    var first = true
    var index: usize = 0
    while index < size(strings) {
        const text = get(strings, index)
        var at: usize = 0
        while at < stringLength(text) {
            if !first { s.out(", ") }
            first = false
            if valuesThisLine >= 16 {
                s.out("\n    ")
                valuesThisLine = 0
            }
            s.out("0x")
            u.outHex(@intCast(u64, stringPool[stringStart(text) + at]), 1, false)
            valuesThisLine += 1
            at += 1
        }
        index += 1
    }
    s.out("\n};\n")
    s.out("static constexpr uint8_t kStrings")
    s.outUnsigned(@intCast(u64, p))
    s.out("Lengths[] = {\n    ")
    valuesThisLine = 0
    first = true
    index = 0
    while index < size(strings) {
        if !first { s.out(", ") }
        first = false
        if valuesThisLine >= 24 {
            s.out("\n    ")
            valuesThisLine = 0
        }
        s.outUnsigned(@intCast(u64, stringLength(get(strings, index))))
        valuesThisLine += 1
        index += 1
    }
    s.out("\n};\n")
}

fn outProperty(p: usize) -> void {
    const property = props[p]
    if property.hasStrings { outStringTables(p) }
    s.out("static std::unique_ptr<CharacterClass> createCharacterClass")
    s.outUnsigned(@intCast(u64, p))
    s.out("()\n{\n")
    s.out("    // Name = ")
    s.out(property.name)
    s.out(",")
    if property.hasStrings {
        s.out(" number of strings: ")
        s.outUnsigned(@intCast(u64, size(property.strings)))
    }
    if property.count != 0 {
        s.out(" number of codePoints: ")
        s.outSigned(property.count)
    }
    s.out("\n")
    s.out("    auto characterClass = makeUnique<CharacterClass>(\n")
    s.out("        std::initializer_list<char32_t>(")
    outMatchData(8, property.matches, false, 2)
    s.out("),\n")
    s.out("        std::initializer_list<CharacterRange>(")
    outMatchData(4, property.ranges, true, 2)
    s.out("),\n")
    s.out("        std::initializer_list<char32_t>(")
    outMatchData(8, property.unicodeMatches, false, 4)
    s.out("),\n")
    s.out("        std::initializer_list<CharacterRange>(")
    outMatchData(4, property.unicodeRanges, true, 4)
    s.out("),\n")
    const widths = if property.hasNonBMP && property.hasBMP { "HasBothBMPAndNonBMP" } else if property.hasNonBMP { "HasNonBMPChars" } else if property.hasBMP { "HasBMPChars" } else { "Unknown" }
    s.out("        CharacterClassWidths::")
    s.out(widths)
    s.out(");\n")
    if property.hasStrings {
        s.out("    characterClass->m_strings.reserveInitialCapacity(")
        s.outUnsigned(@intCast(u64, size(property.strings)))
        s.out(");\n")
        s.out("    const char32_t* data = kStrings")
        s.outUnsigned(@intCast(u64, p))
        s.out("Data;\n")
        s.out("    for (uint8_t length : kStrings")
        s.outUnsigned(@intCast(u64, p))
        s.out("Lengths) {\n")
        s.out("        characterClass->m_strings.append(Vector<char32_t>(std::span(data, length)));\n")
        s.out("        data += length;\n")
        s.out("    }\n")
        s.out("    characterClass->m_inCanonicalForm = true;\n")
    }
    s.out("    return characterClass;\n}\n\n")
}

fn outAll() -> void {
    var p: usize = 0
    while p < propCount {
        outProperty(p)
        p += 1
    }
    s.out("using CreateCharacterClass = std::unique_ptr<CharacterClass> (*)();\n")
    s.out("static constinit CreateCharacterClass createCharacterClassFunctions[")
    s.outUnsigned(@intCast(u64, propCount))
    s.out("] = {\n   ")
    var onThisLine: usize = 0
    p = 0
    while p < propCount {
        s.out(" createCharacterClass")
        s.outUnsigned(@intCast(u64, p))
        s.out(",")
        onThisLine += 1
        if onThisLine == 4 {
            s.out("\n   ")
            onThisLine = 0
        }
        p += 1
    }
    s.out("};\n\n")
}

fn ceilingToPowerOf2(value: usize) -> usize {
    var power: usize = 1
    while value > power { power <<= 1 }
    return power
}

// The hash table of the names and aliases of the classes of MAP.
fn outHashTable(map: usize, prefix: []const u8) -> void {
    // The keys: each name, then its aliases.
    var keyCount: usize = 0
    var index: usize = 0
    while index < maps[map].count {
        keyCount += 1 + nameLists[props[maps[map].values[index]].aliases].count
        index += 1
    }
    var keys: [*][]const u8 = undefined
    var keyValues: [*]usize = undefined
    var slots: [*]i64 = undefined
    var links: [*]i64 = undefined
    const hashSize = ceilingToPowerOf2(maps[map].count * 2)
    unsafe {
        keys = @ptrFromInt([*][]const u8, s.alloc(keyCount * 16 + 16))
        keyValues = @ptrFromInt([*]usize, s.alloc(keyCount * 8 + 8))
        slots = @ptrFromInt([*]i64, s.alloc((hashSize + keyCount) * 8))
        links = @ptrFromInt([*]i64, s.alloc((hashSize + keyCount) * 8))
    }
    var k: usize = 0
    index = 0
    while index < maps[map].count {
        const p = maps[map].values[index]
        keys[k] = maps[map].keys[index]
        keyValues[k] = p
        k += 1
        const aliases = nameLists[props[p].aliases]
        var a: usize = 0
        while a < aliases.count {
            keys[k] = aliases.items[a]
            keyValues[k] = p
            k += 1
            a += 1
        }
        index += 1
    }
    var tableSize = hashSize
    index = 0
    while index < hashSize + keyCount {
        slots[index] = -1
        links[index] = -1
        index += 1
    }
    k = 0
    while k < keyCount {
        var h = @intCast(usize, rapidhash.hash(keys[k]) % @intCast(u64, hashSize))
        while slots[h] >= 0 {
            if links[h] >= 0 {
                h = @intCast(usize, links[h])
            } else {
                links[h] = @intCast(i64, tableSize)
                h = tableSize
                tableSize += 1
            }
        }
        slots[h] = @intCast(i64, k)
        k += 1
    }
    s.out("static constinit const struct HashIndex ")
    s.out(prefix)
    s.out("TableIndex[")
    s.outUnsigned(@intCast(u64, tableSize))
    s.out("] = {\n")
    index = 0
    while index < tableSize {
        s.out("    { ")
        s.outSigned(slots[index])
        s.out(", ")
        s.outSigned(links[index])
        s.out(" },\n")
        index += 1
    }
    s.out("};\n\n")
    s.out("static constinit const struct HashValue ")
    s.out(prefix)
    s.out("TableValue[")
    s.outUnsigned(@intCast(u64, keyCount))
    s.out("] = {\n")
    k = 0
    while k < keyCount {
        s.out("    { \"")
        s.out(keys[k])
        s.out("\", ")
        s.outUnsigned(@intCast(u64, keyValues[k]))
        s.out(" },\n")
        k += 1
    }
    s.out("};\n\n")
    s.out("static constinit const struct HashTable ")
    s.out(prefix)
    s.out("HashTable = \n")
    s.out("    { ")
    s.outUnsigned(@intCast(u64, keyCount))
    s.out(", ")
    s.outUnsigned(@intCast(u64, hashSize - 1))
    s.out(", ")
    s.out(prefix)
    s.out("TableValue, ")
    s.out(prefix)
    s.out("TableIndex };\n\n")
}

fn outMayContainStrings() -> void {
    s.out("static bool unicodeCharacterClassMayContainStrings(unsigned unicodeClassId)\n")
    s.out("{\n")
    s.out("    if (unicodeClassId >= ")
    s.outUnsigned(@intCast(u64, propCount))
    s.out(")\n")
    s.out("        return false;\n")
    s.out("\n")
    // The runs of consecutive classes with strings.
    var p: usize = 0
    while p < propCount {
        if !props[p].hasStrings {
            p += 1
            continue
        }
        const first = p
        while p + 1 < propCount && props[p + 1].hasStrings { p += 1 }
        if first == p {
            s.out("    if (unicodeClassId == ")
            s.outUnsigned(@intCast(u64, first))
            s.out(")\n")
        } else {
            s.out("    if (unicodeClassId >= ")
            s.outUnsigned(@intCast(u64, first))
            s.out(" && unicodeClassId <= ")
            s.outUnsigned(@intCast(u64, p))
            s.out(")\n")
        }
        s.out("        return true;\n")
        s.out("\n")
        p += 1
    }
    s.out("    return false;\n")
    s.out("}\n\n")
}

// ---------------------------------------------------------------------------
// The files.

var directory: [*]const u8 = undefined
var directoryLength: usize = 0

fn readUCD(name: []const u8) -> []const u8 { return s.readWhole(s.join3(directory[0..directoryLength], "/", name)) }

// The names of FIELDS, from field FROM on, each stripped, after FIRST.
fn namesOf(line: []const u8, first: []const u8, from: usize) -> usize {
    const count = u.fieldCount(line)
    const names = newNames(count + 1)
    nameLists[names].items[0] = first
    var n: usize = 1
    var index = from
    while index < count {
        nameLists[names].items[n] = u.strip(u.field(line, index))
        n += 1
        index += 1
    }
    nameLists[names].count = n
    return names
}

fn parsePropertyAliases(text: []const u8) -> void {
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 { continue }
        const fullName = u.strip(u.field(line, 1))
        // A second entry for a name is an error the script only reports.
        if !has(GLOBAL_ALIASES, fullName) { put(GLOBAL_ALIASES, fullName, namesOf(line, u.strip(u.field(line, 0)), 2), "") }
    }
}

fn parsePropertyValueAliases(text: []const u8) -> void {
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 { continue }
        const propertyType = u.strip(u.field(line, 0))
        var map: usize = 0
        var reverse: usize = 0
        if std.text.same(propertyType, "gc") {
            map = CATEGORY_ALIASES
            reverse = ALIAS_TO_CATEGORY
        } else if std.text.same(propertyType, "sc") {
            map = SCRIPT_ALIASES
            reverse = ALIAS_TO_SCRIPT
        } else {
            continue
        }
        const primary = u.strip(u.field(line, 1))
        const fullName = u.strip(u.field(line, 2))
        if !has(map, fullName) {
            put(map, fullName, namesOf(line, primary, 3), "")
            put(reverse, primary, 0, fullName)
        }
    }
}

// The general categories.

var lastAddedCodePoint: i64 = 0
var assignedProperty: usize = 0
var casedLetterProperty: usize = 0

fn specialCategory(name: []const u8) -> usize {
    const p = newProperty(name)
    put(CATEGORIES, name, p, "")
    return p
}

// The classes of the group of a category and of the category, made when
// first wanted: the group's is returned, the category's left in
// categoryProperty.
var categoryProperty: usize = 0

fn findPropertyGroupFor(categoryAlias: []const u8) -> usize {
    const category = nameFor(ALIAS_TO_CATEGORY, categoryAlias)
    const allCategoryAliases = aliasesIn(CATEGORY_ALIASES, category)
    const categoryGroup = nameFor(ALIAS_TO_CATEGORY, categoryAlias[0..1])
    const allCategoryGroupAliases = aliasesIn(CATEGORY_ALIASES, categoryGroup)
    var group: usize = 0
    if !has(CATEGORIES, categoryGroup) {
        group = newProperty(categoryGroup)
        props[group].aliases = allCategoryGroupAliases
        put(CATEGORIES, categoryGroup, group, "")
    } else {
        group = valueOf(CATEGORIES, categoryGroup)
    }
    if !has(CATEGORIES, category) {
        categoryProperty = newProperty(category)
        props[categoryProperty].aliases = allCategoryAliases
        put(CATEGORIES, category, categoryProperty, "")
    } else {
        categoryProperty = valueOf(CATEGORIES, category)
    }
    return group
}

fn isCasedLetter(alias: []const u8) -> bool { return std.text.same(alias, "Ll") || std.text.same(alias, "Lt") || std.text.same(alias, "Lu") }

fn addNextCodePoints(categoryAlias: []const u8, codePoint: i64, highCodePoint: i64, isRange: bool) -> void {
    if codePoint - lastAddedCodePoint > 1 {
        const group = findPropertyGroupFor("Cn")
        if codePoint - lastAddedCodePoint == 2 {
            addMatch(group, lastAddedCodePoint + 1)
            addMatch(categoryProperty, lastAddedCodePoint + 1)
        } else {
            addRange(group, lastAddedCodePoint + 1, codePoint - 1)
            addRange(categoryProperty, lastAddedCodePoint + 1, codePoint - 1)
        }
    }
    const group = findPropertyGroupFor(categoryAlias)
    if isRange {
        addRange(group, codePoint, highCodePoint)
        addRange(categoryProperty, codePoint, highCodePoint)
        if isCasedLetter(categoryAlias) { addRange(casedLetterProperty, codePoint, highCodePoint) }
        addRange(assignedProperty, codePoint, highCodePoint)
        lastAddedCodePoint = highCodePoint
    } else {
        addMatch(group, codePoint)
        addMatch(categoryProperty, codePoint)
        if isCasedLetter(categoryAlias) { addMatch(casedLetterProperty, codePoint) }
        addMatch(assignedProperty, codePoint)
        lastAddedCodePoint = codePoint
    }
}

// TEXT[length - FROM_END .. length - 1], as Python slices it.
fn tail(text: []const u8, fromEnd: usize) -> []const u8 {
    if text.length == 0 { return text }
    const start = if text.length > fromEnd { text.length - fromEnd } else { 0 }
    return text[start..text.length - 1]
}

fn hexCode(text: []const u8) -> i64 { return @intCast(i64, u.parseHex(text)) }

fn parseGeneralCategories(text: []const u8) -> void {
    var p = specialCategory("Any")
    addRange(p, 0, MAX_UNICODE)
    p = specialCategory("ASCII")
    addRange(p, 0, LAST_ASCII)
    assignedProperty = specialCategory("Assigned")
    const ignored = findPropertyGroupFor("Cn")
    const ignoredToo = findPropertyGroupFor("LC")
    casedLetterProperty = categoryProperty
    lastAddedCodePoint = 0

    var firstOfRange: i64 = 0
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 { continue }
        const codePoint = hexCode(u.field(line, 0))
        const description = u.strip(u.field(line, 1))
        const categoryAlias = u.strip(u.field(line, 2))
        if firstOfRange != 0 {
            if std.text.same(tail(description, 5), "Last") {
                addNextCodePoints(categoryAlias, firstOfRange, codePoint, true)
                firstOfRange = 0
                continue
            }
        }
        if std.text.same(tail(description, 6), "First") {
            firstOfRange = codePoint
            continue
        }
        addNextCodePoints(categoryAlias, codePoint, 0, false)
    }
    if lastAddedCodePoint < MAX_UNICODE {
        const group = findPropertyGroupFor("Cn")
        if MAX_UNICODE - lastAddedCodePoint == 1 {
            addMatch(group, MAX_UNICODE)
            addMatch(categoryProperty, MAX_UNICODE)
        } else {
            addRange(group, lastAddedCodePoint + 1, MAX_UNICODE)
            addRange(categoryProperty, lastAddedCodePoint + 1, MAX_UNICODE)
        }
    }
}

// The binary properties.

fn isSupportedBinary(name: []const u8) -> bool {
    const supported = "|Alphabetic|Any|ASCII|ASCII_Hex_Digit|Assigned|Bidi_Control|Bidi_Mirrored|Case_Ignorable|Cased|Changes_When_Casefolded|Changes_When_Casemapped|Changes_When_Lowercased|Changes_When_NFKC_Casefolded|Changes_When_Titlecased|Changes_When_Uppercased|Dash|Default_Ignorable_Code_Point|Deprecated|Diacritic|Emoji|Emoji_Component|Emoji_Modifier_Base|Emoji_Modifier|Emoji_Presentation|Extended_Pictographic|Extender|Grapheme_Base|Grapheme_Extend|Hex_Digit|ID_Continue|ID_Start|Ideographic|IDS_Binary_Operator|IDS_Trinary_Operator|Join_Control|Logical_Order_Exception|Lowercase|Math|Noncharacter_Code_Point|Pattern_Syntax|Pattern_White_Space|Quotation_Mark|Radical|Regional_Indicator|Sentence_Terminal|Soft_Dotted|Terminal_Punctuation|Unified_Ideograph|Uppercase|Variation_Selector|White_Space|XID_Continue|XID_Start|"
    return std.text.contains(supported, s.join3("|", name, "|"))
}

fn isSupportedSequence(name: []const u8) -> bool {
    const supported = "|Basic_Emoji|Emoji_Keycap_Sequence|RGI_Emoji|RGI_Emoji_Flag_Sequence|RGI_Emoji_Modifier_Sequence|RGI_Emoji_Tag_Sequence|RGI_Emoji_ZWJ_Sequence|"
    return std.text.contains(supported, s.join3("|", name, "|"))
}

// Where ".." is in TEXT, or its length.
fn dotDot(text: []const u8) -> usize { return std.text.find(text, "..") }

fn parseBinaryProperties(text: []const u8) -> void {
    var currentName: []const u8 = ""
    var hasCurrent = false
    var current: usize = 0
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 { continue }
        const codePoints = u.strip(u.field(line, 0))
        const name = u.strip(u.field(line, 1))
        if !hasCurrent || !std.text.same(name, currentName) {
            if !isSupportedBinary(name) { continue }
            currentName = name
            hasCurrent = true
            current = newProperty(name)
            props[current].aliases = aliasesIn(GLOBAL_ALIASES, name)
            put(BINARY_PROPERTIES, name, current, "")
        }
        const dots = dotDot(codePoints)
        if dots == codePoints.length {
            addMatch(current, hexCode(codePoints))
        } else {
            addRange(current, hexCode(codePoints[0..dots]), hexCode(codePoints[dots + 2..codePoints.length]))
        }
    }
}

// The scripts.

var unknownScript: usize = 0

fn parseScripts(text: []const u8) -> void {
    // The ranges given a script, to find those of none (Unknown).
    const assigned = newList(4096)
    var currentName: []const u8 = ""
    var hasCurrent = false
    var current: usize = 0
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 { continue }
        const codePoints = u.strip(u.field(line, 0))
        const name = u.strip(u.field(line, 1))
        if !hasCurrent || !std.text.same(name, currentName) {
            currentName = name
            hasCurrent = true
            current = newProperty(name)
            props[current].aliases = aliasesIn(SCRIPT_ALIASES, name)
            put(SCRIPTS, name, current, "")
        }
        const dots = dotDot(codePoints)
        var lowCodePoint: i64 = 0
        var highCodePoint: i64 = 0
        if dots == codePoints.length {
            lowCodePoint = hexCode(codePoints)
            highCodePoint = lowCodePoint
            addMatch(current, lowCodePoint)
        } else {
            lowCodePoint = hexCode(codePoints[0..dots])
            highCodePoint = hexCode(codePoints[dots + 2..codePoints.length])
            addRange(current, lowCodePoint, highCodePoint)
        }
        // Kept sorted by their low ends (a stable sort, as the script's).
        var slot = size(assigned)
        append(assigned, 0)
        const items = lists[assigned].items
        while slot > 0 && low(items[slot - 1]) > lowCodePoint {
            items[slot] = items[slot - 1]
            slot -= 1
        }
        items[slot] = pair(lowCodePoint, highCodePoint)
    }
    var lastAssigned: i64 = 0
    var index: usize = 0
    while index < size(assigned) {
        const range = get(assigned, index)
        if low(range) - lastAssigned > 1 {
            if low(range) - lastAssigned == 2 {
                addMatch(unknownScript, lastAssigned + 1)
            } else {
                addRange(unknownScript, lastAssigned + 1, low(range) - 1)
            }
        }
        lastAssigned = high(range)
        index += 1
    }
    if lastAssigned < MAX_UNICODE {
        if MAX_UNICODE - lastAssigned == 1 {
            addMatch(unknownScript, MAX_UNICODE)
        } else {
            addRange(unknownScript, lastAssigned + 1, MAX_UNICODE)
        }
    }
    put(SCRIPTS, "Unknown", unknownScript, "")
}

// The class of a script's extensions: a copy of the script's, or a new
// one for a script without characters of its own.
fn extensionStart(name: []const u8) -> usize {
    var p: usize = 0
    if has(SCRIPTS, name) {
        p = copyProperty(valueOf(SCRIPTS, name))
    } else {
        p = newProperty(name)
        props[p].aliases = aliasesIn(SCRIPT_ALIASES, name)
    }
    put(SCRIPT_EXTENSIONS, name, p, "")
    return p
}

fn parseScriptExtensions(text: []const u8) -> void {
    const common = extensionStart("Common")
    const inherited = extensionStart("Inherited")
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 { continue }
        const codePoints = u.strip(u.field(line, 0))
        const aliasList = u.strip(u.field(line, 1))
        var start: usize = 0
        var end: usize = 0
        while end <= aliasList.length {
            if end < aliasList.length && aliasList[end] != 32 {
                end += 1
                continue
            }
            const scriptName = nameFor(ALIAS_TO_SCRIPT, aliasList[start..end])
            var current: usize = 0
            if !has(SCRIPT_EXTENSIONS, scriptName) {
                current = copyProperty(valueOf(SCRIPTS, scriptName))
                put(SCRIPT_EXTENSIONS, scriptName, current, "")
            } else {
                current = valueOf(SCRIPT_EXTENSIONS, scriptName)
            }
            const dots = dotDot(codePoints)
            if dots == codePoints.length {
                const codePoint = hexCode(codePoints)
                addMatch(current, codePoint)
                removeMatch(common, codePoint)
                removeMatch(inherited, codePoint)
            } else {
                const lowCodePoint = hexCode(codePoints[0..dots])
                const highCodePoint = hexCode(codePoints[dots + 2..codePoints.length])
                addRange(current, lowCodePoint, highCodePoint)
                var codePoint = lowCodePoint
                while codePoint <= highCodePoint {
                    removeMatch(common, codePoint)
                    removeMatch(inherited, codePoint)
                    codePoint += 1
                }
            }
            end += 1
            start = end
        }
    }
    // The scripts with no extensions of their own are their scripts.
    var index: usize = 0
    while index < maps[SCRIPTS].count {
        const name = maps[SCRIPTS].keys[index]
        if !has(SCRIPT_EXTENSIONS, name) { put(SCRIPT_EXTENSIONS, name, maps[SCRIPTS].values[index], "") }
        index += 1
    }
}

// The properties of strings.

var rgiEmoji: usize = 0

fn parseSequences(text: []const u8) -> void {
    var currentName: []const u8 = ""
    var hasCurrent = false
    var current: usize = 0
    var at: usize = 0
    while at < text.length {
        const line = u.dataPart(s.nextLine(text, &at))
        if line.length == 0 { continue }
        const codePoints = u.strip(u.field(line, 0))
        const name = u.strip(u.field(line, 1))
        if !hasCurrent || !std.text.same(name, currentName) {
            if !isSupportedSequence(name) { continue }
            if hasCurrent { sortStrings(props[current].strings) }
            currentName = name
            hasCurrent = true
            current = newProperty(name)
            put(SEQUENCE_PROPERTIES, name, current, "")
        }
        const dots = dotDot(codePoints)
        if dots == codePoints.length {
            if !std.text.contains(codePoints, " ") {
                addMatch(current, hexCode(codePoints))
                addMatch(rgiEmoji, hexCode(codePoints))
            } else {
                // A string: its code points, between single spaces.
                const start = stringPoolLength
                var from: usize = 0
                var index: usize = 0
                while index <= codePoints.length {
                    if index == codePoints.length || codePoints[index] == 32 {
                        if stringPoolLength == STRING_POOL_SIZE { s.fail("generateYarrUnicodePropertyTables: too many strings") }
                        stringPool[stringPoolLength] = @intCast(u32, u.parseHex(codePoints[from..index]))
                        stringPoolLength += 1
                        from = index + 1
                    }
                    index += 1
                }
                const length = stringPoolLength - start
                if length > 255 { s.fail("generateYarrUnicodePropertyTables: string length must fit in uint8_t") }
                const string = @intCast(i64, start * 256 + length)
                addMatchString(current, string)
                addMatchString(rgiEmoji, string)
            }
        } else {
            const lowCodePoint = hexCode(codePoints[0..dots])
            const highCodePoint = hexCode(codePoints[dots + 2..codePoints.length])
            addRange(current, lowCodePoint, highCodePoint)
            addRange(rgiEmoji, lowCodePoint, highCodePoint)
        }
    }
    if !hasCurrent { s.fail("generateYarrUnicodePropertyTables: no sequence property") }
    sortStrings(props[current].strings)
    sortStrings(props[rgiEmoji].strings)
}

fn generate(ucd: []const u8, outputPath: []const u8) -> void {
    directory = ucd.pointer
    directoryLength = ucd.length
    unsafe {
        lists = @ptrFromInt([*]List, s.alloc(MAX_LISTS * @sizeOf(List)))
        nameLists = @ptrFromInt([*]Names, s.alloc(MAX_NAME_LISTS * @sizeOf(Names)))
        maps = @ptrFromInt([*]Map, s.alloc(MAP_COUNT * @sizeOf(Map)))
        props = @ptrFromInt([*]Property, s.alloc(MAX_PROPERTIES * @sizeOf(Property)))
        stringPool = @ptrFromInt([*]u32, s.alloc(STRING_POOL_SIZE * 4))
    }
    var map: usize = 0
    while map < MAP_COUNT {
        unsafe {
            maps[map] = Map.{ .keys = @ptrFromInt([*][]const u8, s.alloc(MAP_CAPACITY * 16)), .values = @ptrFromInt([*]usize, s.alloc(MAP_CAPACITY * 8)),
                .texts = @ptrFromInt([*][]const u8, s.alloc(MAP_CAPACITY * 16)), .count = 0 }
        }
        map += 1
    }
    const ignored = newNames(0)

    const propertyAliases = readUCD("PropertyAliases.txt")
    const propertyValueAliases = readUCD("PropertyValueAliases.txt")
    const scripts = readUCD("Scripts.txt")
    const scriptExtensions = readUCD("ScriptExtensions.txt")
    const unicodeData = readUCD("UnicodeData.txt")
    const derivedBinaryProperties = readUCD("DerivedBinaryProperties.txt")
    const derivedCoreProperties = readUCD("DerivedCoreProperties.txt")
    const derivedNormalizationProperties = readUCD("DerivedNormalizationProps.txt")
    const propList = readUCD("PropList.txt")
    const emojiData = readUCD("emoji-data.txt")
    const emojiSequences = readUCD("emoji-sequences.txt")
    const emojiZWJSequences = readUCD("emoji-zwj-sequences.txt")

    parsePropertyAliases(propertyAliases)
    parsePropertyValueAliases(propertyValueAliases)

    parseGeneralCategories(unicodeData)

    parseBinaryProperties(derivedBinaryProperties)
    parseBinaryProperties(derivedCoreProperties)
    parseBinaryProperties(derivedNormalizationProperties)
    parseBinaryProperties(propList)
    parseBinaryProperties(emojiData)

    unknownScript = newProperty("Unknown")
    props[unknownScript].aliases = aliasesIn(SCRIPT_ALIASES, "Unknown")
    parseScripts(scripts)
    parseScriptExtensions(scriptExtensions)

    rgiEmoji = newProperty("RGI_Emoji")
    put(SEQUENCE_PROPERTIES, "RGI_Emoji", rgiEmoji, "")
    parseSequences(emojiSequences)
    parseSequences(emojiZWJSequences)

    s.out(HEADER)
    outAll()
    s.out("// General_Category:\n")
    outHashTable(CATEGORIES, "generalCategory")
    s.out("// binary properties:\n")
    outHashTable(BINARY_PROPERTIES, "binaryProperty")
    s.out("// Scripts:\n")
    outHashTable(SCRIPTS, "script")
    s.out("// Script_Extensions:\n")
    outHashTable(SCRIPT_EXTENSIONS, "scriptExtension")
    s.out("// sequences properties:\n")
    outHashTable(SEQUENCE_PROPERTIES, "sequenceProperty")
    outMayContainStrings()
    s.out(FOOTER)
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-yarr-unicode-tables UCD_DIRECTORY OUTPUT\n")
        return 2
    }
    generate(std.text.cString(arguments[1]), std.text.cString(arguments[2]))
    return 0
}
