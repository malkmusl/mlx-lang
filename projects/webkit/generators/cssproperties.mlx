// WebCore's CSS properties and descriptors, as process-css-properties.py
// makes them from CSSProperties.json:
//
//     webkit-css-properties [--defines DEFINES] OUTPUT_DIRECTORY CSSProperties.json
//
// It writes, in OUTPUT_DIRECTORY, the JSON as given (the build's `perl -ne
// print` copy), CSSPropertyInitialValuesGeneratedInlines.h,
// CSSPropertyNames.h, CSSPropertyNames.gperf (gperf's input),
// CSSPropertyParsing.h and .cpp, CSSStyleProperties+PropertyNames.idl,
// StyleBuilderGenerated.cpp, StyleChangedAnimatablePropertiesGenerated.cpp,
// StyleComputedStyleProperties.h, .cpp and its +ConstructionInlines,
// +GettersInlines, +InitialInlines and +SettersInlines headers,
// StyleExtractorGenerated.cpp, StyleInterpolationWrapperMap.h and .cpp, and
// StylePropertyShorthandFunctions.h and .cpp. DEFINES are the ENABLE_ and
// USE_ macros a property's "enable-if" is checked against. The script
// then runs gperf, in OUTPUT_DIRECTORY:
//
//     gperf --key-positions=* -D -n -s 2 CSSPropertyNames.gperf --output-file=CSSPropertyNames.cpp
const s = @import("./support.mlx")
const c = @import("./csstext.mlx")
const m = @import("./csspropsmodel.mlx")
const names = @import("./csspropsnames.mlx")
const builder = @import("./csspropsbuilder.mlx")
const interpolation = @import("./csspropsinterpolation.mlx")
const parsing = @import("./csspropsparsing.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    var defines: []const u8 = ""
    var first: usize = 1
    if arguments.length > 2 && s.same(s.cString(arguments[1]), "--defines") {
        defines = s.cString(arguments[2])
        first = 3
    }
    if arguments.length != first + 2 {
        s.say("usage: webkit-css-properties [--defines DEFINES] OUTPUT_DIRECTORY CSSProperties.json\n")
        return 2
    }
    const directory = s.cString(arguments[first])
    const path = s.cString(arguments[first + 1])
    const text = c.readFile(path)
    m.setDefines(defines)
    m.read(text, path)
    c.writeFile(directory, "CSSProperties.json", text)
    c.writeFile(directory, "CSSPropertyInitialValuesGeneratedInlines.h", names.initialValues())
    c.writeFile(directory, "CSSPropertyNames.h", names.namesHeader())
    c.writeFile(directory, "CSSPropertyNames.gperf", names.namesGperf())
    c.writeFile(directory, "CSSPropertyParsing.h", parsing.parsingHeader())
    c.writeFile(directory, "CSSPropertyParsing.cpp", parsing.parsing())
    c.writeFile(directory, "CSSStyleProperties+PropertyNames.idl", names.propertyNamesIdl())
    c.writeFile(directory, "StyleBuilderGenerated.cpp", builder.builderGenerated())
    c.writeFile(directory, "StyleExtractorGenerated.cpp", builder.extractorGenerated())
    c.writeFile(directory, "StyleInterpolationWrapperMap.h", interpolation.wrapperMapHeader())
    c.writeFile(directory, "StyleInterpolationWrapperMap.cpp", interpolation.wrapperMap())
    c.writeFile(directory, "StylePropertyShorthandFunctions.h", builder.shorthandFunctionsHeader())
    c.writeFile(directory, "StylePropertyShorthandFunctions.cpp", builder.shorthandFunctions())
    return 0
}
