// process-css-properties.py's GenerateStyleInterpolationWrapperMap
// (StyleInterpolationWrapperMap.h and .cpp): the interpolation wrapper of
// each animatable longhand, and the shorthands built from them.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")
const g = @import("./csspropsterms.mlx")
const m = @import("./csspropsmodel.mlx")
const x = @import("./csspropsgen.mlx")
const b = @import("./csspropsbuilder.mlx")

pub fn wrapperMapHeader() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.pragmaOnce(w)
    x.includesOf(w, "CSSPropertyNames.h", "<array> <wtf/NeverDestroyed.h>")
    const namespaces = x.words("WebCore Style Interpolation")
    x.openNamespaces(w, namespaces)
    x.forwardDeclarations(w, t.list(), x.one("WrapperBase"))
    c.block(w, "            class WrapperMap final {
            public:
                static WrapperMap& singleton()
                {
                    static NeverDestroyed<WrapperMap> map;
                    return map;
                }

                WrapperBase* wrapper(CSSPropertyID id)
                {
                    if (id >= cssPropertyIDEnumValueCount)
                        return nullptr;
                    return m_wrappers[id];
                }

            private:
                friend class WTF::NeverDestroyed<WrapperMap>;

                WrapperMap();
                ~WrapperMap() = delete;

                std::array<WrapperBase*, cssPropertyIDEnumValueCount> m_wrappers;
            };")
    c.newline(w)
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

fn construction(p: *m.Property) -> []const u8 {
    var wrapperType: []const u8 = ""
    const animation = m.animationType(p)
    const listProperty = m.cgOn(p, "coordinated-value-list-property")
    if m.hasCg(p, "animation-wrapper") {
        wrapperType = m.cgShown(p, "animation-wrapper")
    } else if s.same(animation, "by computed value") || s.same(animation, "repeatable list") || s.same(animation, "see prose") {
        if listProperty {
            wrapperType = "CoordinatedValueListPropertyStyleTypeWrapper"
        } else if m.cgOn(p, "visited-link-color-support") {
            wrapperType = "VisitedAffectedStyleTypeWrapper"
        } else {
            wrapperType = "StyleTypeWrapper"
        }
    } else if s.same(animation, "discrete") {
        wrapperType = if listProperty { "DiscreteCoordinatedValueListPropertyWrapper" } else { "DiscreteWrapper" }
    } else {
        s.fail(t.c3("'", p.*.name, "' animation wrapper type is not defined"))
    }
    var parameters = t.list()
    if m.hasCg(p, "animation-wrapper-requires-override-parameters") {
        parameters = m.cgList(p, "animation-wrapper-requires-override-parameters")
    } else {
        t.push(&parameters, m.fullId(p))
        const style = "ComputedStyle"
        const methods = m.cgShown(p, "computed-style-name-for-methods")
        if listProperty {
            const listType = b.listTypeName(p)
            parameters = t.list()
            t.push(&parameters, t.c3("PropertyNameConstant<", m.fullId(p), "> { }"))
            t.push(&parameters, t.c4("&", style, "::", b.listGet(p)))
            t.push(&parameters, t.c4("&", style, "::", b.listEnsure(p)))
            t.push(&parameters, t.c4("&", style, "::", b.listSet(p)))
            t.push(&parameters, t.c9(wrapperType, "(", m.fullId(p), ", &", listType, "::value_type::", m.cgShown(p, "coordinated-value-list-property-getter"), ", &", t.c4(listType, "::value_type::", m.cgShown(p, "coordinated-value-list-property-setter"), ")")))
            wrapperType = "CoordinatedValueListPropertyWrapper"
        } else {
            if m.hasCg(p, "animation-wrapper-requires-getter") {
                t.push(&parameters, t.c4("&", style, "::", m.cgShown(p, "animation-wrapper-requires-getter")))
            } else {
                t.push(&parameters, t.c4("&", style, "::", m.cgShown(p, "computed-style-getter")))
            }
            if m.hasCg(p, "animation-wrapper-requires-setter") {
                t.push(&parameters, t.c4("&", style, "::", m.cgShown(p, "animation-wrapper-requires-setter")))
            } else {
                t.push(&parameters, t.c4("&", style, "::", m.cgShown(p, "computed-style-setter")))
            }
            if m.cgOn(p, "visited-link-color-support") {
                t.push(&parameters, t.c4("&", style, "::visitedLink", methods))
                t.push(&parameters, t.c4("&", style, "::setVisitedLink", methods))
            }
            t.extend(&parameters, m.cgList(p, "animation-wrapper-requires-additional-parameters"))
        }
    }
    return t.c5("new ", wrapperType, "(", t.joined(parameters, ", "), ")")
}

fn containsAnimatableLonghands(p: *m.Property, animatable: g.Refs) -> bool {
    var index: usize = 0
    while index < p.*.longhands.count {
        const longhand = m.propertyAt(p.*.longhands, index)
        if g.has(animatable, @intFromPtr(longhand)) { return true }
        if m.isLogical(longhand) {
            const name = longhand.*.logicalGroup.?.*.name
            var at: usize = 0
            while at < m.groups.count {
                const group = m.groupAt(m.groups, at)
                if s.same(group.*.name, name) {
                    var k: usize = 0
                    while k < group.*.physical.count {
                        if g.has(animatable, group.*.physical.items[k]) { return true }
                        k += 1
                    }
                }
                at += 1
            }
            return false
        }
        index += 1
    }
    return false
}

pub fn wrapperMap() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.cppRequiredIncludes(w, "StyleInterpolationWrapperMap.h")
    x.includesOf(w, "StylePropertyShorthand.h", "")
    c.write(w, "#define STYLE_INTERPOLATION_GENERATED_INCLUDE_TRAP 1")
    c.write(w, "#include \"StyleInterpolationWrappers.h\"")
    c.write(w, "#undef STYLE_INTERPOLATION_GENERATED_INCLUDE_TRAP")
    const namespaces = x.words("WebCore Style Interpolation")
    x.openNamespaces(w, namespaces)
    c.block(w, "            static WrapperBase* makeShorthandWrapper(CSSPropertyID id, const std::array<WrapperBase*, cssPropertyIDEnumValueCount>& wrappers)
            {
                auto shorthand = shorthandForProperty(id);
                ASSERT(shorthand.length());

                auto longhandWrappers = WTF::compactMap(shorthand, [&](auto longhand) -> std::optional<WrapperBase*> {
                    auto wrapper = wrappers[longhand];
                    if (!wrapper)
                        return std::nullopt;
                    return wrapper;
                });

                return new ShorthandWrapper(id, WTF::move(longhandWrappers));
            }
            ")
    c.write(w, "WrapperMap::WrapperMap()")
    c.indent(w)
    var animatable = g.refs()
    var shorthands = g.refs()
    c.write(w, ": m_wrappers {")
    c.indent(w)
    c.write(w, "nullptr, // CSSPropertyID::CSSPropertyInvalid")
    c.write(w, "nullptr, // CSSPropertyID::CSSPropertyCustom")
    const descriptorOnly = m.allDescriptorOnly()
    const unique = m.allUnique()
    var index: usize = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        index += 1
        const id = m.fullId(p)
        if !p.*.hasLonghands {
            if g.has(descriptorOnly, @intFromPtr(p)) {
                c.write(w, t.c3("nullptr, // ", id, " - not animatable (descriptor only)"))
                continue
            }
            if m.isLogical(p) {
                c.write(w, t.c3("nullptr, // ", id, " - logical, handled via resolution to physical"))
                continue
            }
            if !m.isAnimatable(p) {
                c.write(w, t.c4("nullptr, // ", id, " - ", m.animationType(p)))
                continue
            }
            c.write(w, t.c3(construction(p), ", // ", id))
            g.push(&animatable, @intFromPtr(p))
        } else if s.same(p.*.name, "all") || containsAnimatableLonghands(p, animatable) {
            c.write(w, t.c3("nullptr, // ", id, " - shorthand, will perform fix-up below"))
            g.push(&shorthands, @intFromPtr(p))
        } else {
            c.write(w, t.c3("nullptr, // ", id, " - not animatable (shorthand, has no animatable longhands)"))
        }
    }
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "{")
    c.indent(w)
    c.write(w, "// Build animatable shorthand wrappers from longhand wrappers initialized above.")
    c.newline(w)
    index = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        if g.has(shorthands, unique.items[index]) { c.write(w, t.c5("m_wrappers[", m.fullId(p), "] = makeShorthandWrapper(", m.fullId(p), ", m_wrappers);")) }
        index += 1
    }
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}
