// WebCore's names of elements and attributes, made as dom/make_names.pl
// (Perl, with bindings/scripts/InFilesParser.pm and StaticString.pm)
// makes them, from the .in files listing them:
//
//     webkit-make-names --outputDir DIRECTORY [--elements FILE] [--attrs FILE]
//         [--factory] [--wrapperFactory]
//     webkit-make-names --outputDir DIRECTORY --fonts FILE
//     webkit-make-names --outputDir DIRECTORY --enum TagName|NodeName|Namespace
//         --elements FILE ... --attrs FILE ...
//
// With one namespace's elements and attributes (html/HTMLTagNames.in and
// html/HTMLAttributeNames.in, svg/..., mathml/..., or only the attributes
// of svg/xlinkattrs.in, xml/xmlattrs.in, xml/xmlnsattrs.in) it makes
// NAMESPACENames.h/.cpp (a QualifiedName for each) and
// NAMESPACEElementTypeHelpers.h; with --factory NAMESPACEElementFactory.h/.cpp
// (an element of each tag), with --wrapperFactory
// JSNAMESPACEElementWrapperFactory.h/.cpp (its JavaScript wrapper). With
// --fonts, WebKitFontFamilyNames.h/.cpp from css/WebKitFontFamilyNames.in.
// With --enum and the files of every namespace, TagName.h/.cpp,
// NodeName.h/.cpp or Namespace.h/.cpp: enumerations of all the names, and
// the code finding one from its characters.
//
// Where the Perl walks a hash in its own order, the order cannot show in
// what it writes; everything else is in its sorted orders.
const s = @import("./support.mlx")
const n = @import("./namestext.mlx")
const m = @import("./namesmodel.mlx")
const e = @import("./namesenum.mlx")

fn ns() -> []const u8 { return m.namespace() }
fn param(name: []const u8) -> []const u8 { return m.parameter(name) }
fn lowercasePrefix() -> []const u8 { return n.lower(param("namespacePrefix")) }

// ---------------------------------------------------------------------------
// The parts every file has.

pub fn printLicenseHeader() -> void { n.o(LICENSE) }

fn printHeaderHead(namespaceName: []const u8, includes: []const u8, definitions: []const u8) -> void {
    n.o3("#pragma once\n\n", includes, "\n\nnamespace WebCore {\n\n")
    n.o3(definitions, "namespace ", namespaceName)
    n.o("Names {\n\n")
}

fn printCppHead(namespaceName: []const u8, includes: []const u8, usedNamespace: []const u8) -> void {
    n.o3("#include \"config.h\"\n\n#include \"", namespaceName, "Names.h\"\n\n")
    n.o3(includes, "\nnamespace WebCore {\n\nnamespace ", namespaceName)
    n.o3("Names {\n\nusing namespace ", usedNamespace, ";\n\n")
}

fn printInit(isDefinition: bool) -> void {
    if isDefinition {
        n.o("\nWEBCORE_EXPORT void init();\n\n} }\n\n")
        return
    }
    n.o("\nvoid init()
{
    static bool initialized = false;
    if (initialized)
        return;
    initialized = true;

    // Use placement new to initialize the globals.
")
}

// "ENABLE(A) && ENABLE(B)" of "A&B".
fn enableString(conditional: []const u8) -> []const u8 {
    var text = "ENABLE("
    var start: usize = 0
    var index: usize = 0
    var first = true
    while index <= conditional.length {
        if index == conditional.length || conditional[index] == 38 {
            const part = conditional[start..index]
            // Perl's split drops the empty fields at the end.
            if part.length > 0 || hasMore(conditional, index) {
                if !first { text = s.join(text, ") && ENABLE(") }
                text = s.join(text, part)
                first = false
            }
            start = index + 1
        }
        index += 1
    }
    return s.join(text, ")")
}

// Whether TEXT has something but "&" after AT.
fn hasMore(text: []const u8, at: usize) -> bool {
    var index = at
    while index < text.length {
        if text[index] != 38 { return true }
        index += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// The font family names.

fn printFonts(outputDirectory: []const u8) -> void {
    const names = parameterNames()
    const count = s.decimal(@intCast(u64, names.count))
    printLicenseHeader()
    printHeaderHead("WebKitFontFamily", "#include <wtf/NeverDestroyed.h>\n#include <wtf/Vector.h>\n#include <wtf/text/AtomString.h>\n", "")
    n.o("enum class FamilyNamesIndex {\n")
    var index: usize = 0
    while index < names.count {
        n.o3("    ", s.capitalized(names.items[index]), ",\n")
        index += 1
    }
    n.o("};\n\n")
    n.o("template<typename T, size_t inlineCapacity = 0>\n")
    n.o("class FamilyNamesList : public Vector<T, inlineCapacity> {\n")
    n.o("public:\n")
    n.o("    T& at(FamilyNamesIndex i)\n")
    n.o("    {\n")
    n.o("        return Vector<T, inlineCapacity>::at(static_cast<size_t>(i));\n")
    n.o("    }\n")
    n.o("};\n\n")
    n.o3("extern LazyNeverDestroyed<FamilyNamesList<const StaticStringImpl*, ", count, ">> familyNamesData;\n")
    n.o3("extern MainThreadLazyNeverDestroyed<FamilyNamesList<AtomStringImpl*, ", count, ">> familyNames;\n\n")
    index = 0
    while index < names.count {
        n.o3("extern MainThreadLazyNeverDestroyed<const AtomString> ", names.items[index], ";\n")
        index += 1
    }
    n.o("\n\n")
    printInit(true)
    n.save(n.path(outputDirectory, "WebKitFontFamilyNames.h"))

    printLicenseHeader()
    printCppHead("WebKitFontFamily", "", "WTF")
    index = 0
    while index < names.count {
        n.o5("static constexpr StringImpl::StaticStringImpl ", names.items[index], "Data(\"", param(names.items[index]), "\", StringImpl::StringAtom);\n")
        index += 1
    }
    n.o3("LazyNeverDestroyed<FamilyNamesList<const StaticStringImpl*, ", count, ">> familyNamesData;\n")
    n.o3("MainThreadLazyNeverDestroyed<FamilyNamesList<AtomStringImpl*, ", count, ">> familyNames;\n\n")
    index = 0
    while index < names.count {
        n.o3("MainThreadLazyNeverDestroyed<const AtomString> ", names.items[index], ";\n")
        index += 1
    }
    printInit(false)
    n.o("\n")
    printStringAsserts(names)
    n.o("    familyNamesData.construct();\n")
    index = 0
    while index < names.count {
        n.o3("    familyNamesData->append(&", names.items[index], "Data);\n")
        index += 1
    }
    n.o("\n")
    index = 0
    while index < names.count {
        n.o5("    ", names.items[index], ".construct(", names.items[index], "Data);\n")
        index += 1
    }
    n.o("\n    familyNames.construct();\n")
    index = 0
    while index < names.count {
        n.o3("    familyNames->append(", names.items[index], "->impl());\n")
        index += 1
    }
    n.o("}\n}\n}\n")
    n.save(n.path(outputDirectory, "WebKitFontFamilyNames.cpp"))
}

fn parameterNames() -> n.List {
    var names = n.list()
    var index: usize = 0
    while index < m.parameterCount {
        n.push(&names, m.parameters[index].name)
        index += 1
    }
    n.sortList(&names)
    return names
}

// StaticString.pm's GenerateStringAsserts, of NAMES (sorted).
fn printStringAsserts(names: n.List) -> void {
    n.o("#ifndef NDEBUG\n")
    var index: usize = 0
    while index < names.count {
        n.o3("    reinterpret_cast<const StringImpl*>(&", names.items[index], "Data)->assertHashIsCorrect();\n")
        index += 1
    }
    n.o("#endif // NDEBUG\n\n")
}

// ---------------------------------------------------------------------------
// NAMESPACENames.h and .cpp.

fn printNamesHeaderFile(filePath: []const u8) -> void {
    printLicenseHeader()
    const definitions = s.join3("class ", ns(), "QualifiedName : public QualifiedName {\npublic:\n    using QualifiedName::QualifiedName;\n};\n\n")
    printHeaderHead(ns(), "#include <WebCore/QualifiedName.h>\n#include <span>\n#include <wtf/NeverDestroyed.h>\n#include <wtf/text/AtomString.h>\n", definitions)
    n.o("// Namespace\n")
    n.o3("WEBCORE_EXPORT extern MainThreadLazyNeverDestroyed<const AtomString> ", lowercasePrefix(), "NamespaceURI;\n\n")
    if m.elementCount > 0 {
        n.o("// Tags\n")
        const order = m.sortedElements(m.elementsByKey)
        var index: usize = 0
        while index < m.elementCount {
            n.o5("WEBCORE_EXPORT extern LazyNeverDestroyed<const WebCore::", ns(), "QualifiedName> ", m.elements[order[index]].identifier, "Tag;\n")
            index += 1
        }
    }
    if m.attributeCount > 0 {
        n.o("// Attributes\n")
        const order = m.sortedAttributes(m.attributesByKey)
        var index: usize = 0
        while index < m.attributeCount {
            n.o3("WEBCORE_EXPORT extern LazyNeverDestroyed<const WebCore::QualifiedName> ", m.attributes[order[index]].identifier, "Attr;\n")
            index += 1
        }
    }
    n.o("\n")
    if m.elementCount > 0 {
        n.o5("constexpr unsigned ", ns(), "TagsCount = ", s.decimal(@intCast(u64, m.elementCount)), ";\n")
        n.o5("std::span<const WebCore::", ns(), "QualifiedName* const, ", ns(), "TagsCount> get")
        n.o3(ns(), "Tags();\n", "")
    }
    if m.attributeCount > 0 {
        n.o5("constexpr unsigned ", ns(), "AttrsCount = ", s.decimal(@intCast(u64, m.attributeCount)), ";\n")
    }
    printInit(true)
    n.save(filePath)
}

fn printDefinitions(isElements: bool, namespaceURI: []const u8, namespaceEnumValue: []const u8) -> void {
    n.o(if isElements { "\n    // Initialize tags\n" } else { "\n    // Initialize attributes\n" })
    const shortType = if isElements { "Tag" } else { "Attr" }
    const count = if isElements { m.elementCount } else { m.attributeCount }
    const order = if isElements { m.sortedElements(m.elementsByKey) } else { m.sortedAttributes(m.attributesByKey) }
    var index: usize = 0
    while index < count {
        const identifier = if isElements { m.elements[order[index]].identifier } else { m.attributes[order[index]].identifier }
        var nodeName = if isElements { m.elements[order[index]].nodeNameEnumValue } else { m.attributes[order[index]].nodeNameEnumValue }
        if !n.truthy(nodeName) { nodeName = "Unknown" }
        n.o5("    ", identifier, shortType, ".construct(nullAtom(), AtomString(", identifier)
        n.o5("Data), ", namespaceURI, ", Namespace::", namespaceEnumValue, ", NodeName::")
        n.o3(nodeName, ");\n", "")
        index += 1
    }
}

fn printNamesCppFile(filePath: []const u8) -> void {
    printLicenseHeader()
    printCppHead(ns(), "#include \"Namespace.h\"\n#include \"NodeName.h\"\n#include <array>\n", "WebCore")
    const lowercase = lowercasePrefix()
    n.o3("MainThreadLazyNeverDestroyed<const AtomString> ", lowercase, "NamespaceURI;\n\n")
    // The strings: each identifier with its local name (an attribute's
    // over an element's).
    var identifiers = n.list()
    var values = n.list()
    var index: usize = 0
    while index < m.elementCount {
        setString(&identifiers, &values, m.elements[index].identifier, m.elements[index].localName)
        index += 1
    }
    index = 0
    while index < m.attributeCount {
        setString(&identifiers, &values, m.attributes[index].identifier, m.attributes[index].localName)
        index += 1
    }
    var sorted = n.list()
    index = 0
    while index < identifiers.count {
        n.push(&sorted, identifiers.items[index])
        index += 1
    }
    n.sortList(&sorted)
    index = 0
    while index < sorted.count {
        n.o5("static constexpr StringImpl::StaticStringImpl ", sorted.items[index], "Data(\"", stringOf(identifiers, values, sorted.items[index]), "\", StringImpl::StringAtom);\n")
        index += 1
    }
    if m.elementCount > 0 {
        n.o("// Tags\n")
        const order = m.sortedElements(m.elementsByKey)
        index = 0
        while index < m.elementCount {
            n.o5("WEBCORE_EXPORT LazyNeverDestroyed<const ", ns(), "QualifiedName> ", m.elements[order[index]].identifier, "Tag;\n")
            index += 1
        }
        n.o5("\n\nstd::span<const WebCore::", ns(), "QualifiedName* const, ", ns(), "TagsCount> get")
        n.o3(ns(), "Tags()\n", "")
        n.o5("{\n    static const std::array<const WebCore::", ns(), "QualifiedName*, ", ns(), "TagsCount> ")
        n.o3(ns(), "Tags {\n", "")
        index = 0
        while index < m.elementCount {
            n.o3("        &", m.elements[order[index]].identifier, "Tag.get(),\n")
            index += 1
        }
        n.o3("    };\n    return ", ns(), "Tags;\n}\n")
    }
    if m.attributeCount > 0 {
        n.o("\n// Attributes\n")
        const order = m.sortedAttributes(m.attributesByKey)
        index = 0
        while index < m.attributeCount {
            n.o3("WEBCORE_EXPORT LazyNeverDestroyed<const QualifiedName> ", m.attributes[order[index]].identifier, "Attr;\n")
            index += 1
        }
    }
    printInit(false)
    n.o5("    AtomString ", lowercase, "NS(\"", param("namespaceURI"), "\"_s);\n\n")
    n.o("    // Namespace\n")
    n.o5("    ", lowercase, "NamespaceURI.construct(", lowercase, "NS);\n")
    n.o("\n")
    printStringAsserts(sorted)
    if m.elementCount > 0 {
        const nullNamespace = n.truthy(param("elementsNullNamespace"))
        printDefinitions(true, if nullNamespace { "nullAtom()" } else { s.join(lowercase, "NS") }, if nullNamespace { "None" } else { ns() })
    }
    if m.attributeCount > 0 {
        const nullNamespace = n.truthy(param("attrsNullNamespace"))
        printDefinitions(false, if nullNamespace { "nullAtom()" } else { s.join(lowercase, "NS") }, if nullNamespace { "None" } else { ns() })
    }
    n.o("}\n\n} }\n\n")
    n.save(filePath)
}

fn setString(names: *n.List, values: *n.List, name: []const u8, value: []const u8) -> void {
    var index: usize = 0
    while index < names.*.count {
        if s.same(names.*.items[index], name) {
            values.*.items[index] = value
            return
        }
        index += 1
    }
    n.push(names, name)
    n.push(values, value)
}

fn stringOf(names: n.List, values: n.List, name: []const u8) -> []const u8 {
    var index: usize = 0
    while index < names.count {
        if s.same(names.items[index], name) { return values.items[index] }
        index += 1
    }
    return ""
}

// ---------------------------------------------------------------------------
// NAMESPACEElementTypeHelpers.h.

fn printTypeHelpersHeaderFile(filePath: []const u8) -> void {
    printLicenseHeader()
    n.o3("#pragma once\n\n#include <WebCore/", ns(), "Names.h>\n\n")
    if s.same(ns(), "SVG") {
        n.o("#include \"SVGElementInlines.h\"\n\n")
    } else if s.same(ns(), "MathML") {
        n.o("#include \"MathMLElement.h\"\n\n")
    }
    // The classes of exactly one element each.
    var classes = n.list()
    var index: usize = 0
    while index < m.elementCount {
        n.add(&classes, m.elements[index].interfaceName)
        index += 1
    }
    n.sortList(&classes)
    var c: usize = 0
    while c < classes.count {
        const class = classes.items[c]
        c += 1
        var count: usize = 0
        var found: usize = 0
        index = 0
        while index < m.elementCount {
            if s.same(m.elements[index].interfaceName, class) {
                if count == 0 { found = index }
                count += 1
            }
            index += 1
        }
        const element = m.elements[found]
        if n.truthy(element.customTypeHelper) { continue }
        if count > 1 { continue }
        n.o3("namespace WebCore {\nclass ", class, ";\n}\nnamespace WTF {\n")
        n.o3("template<typename ArgType> class TypeCastTraits<const WebCore::", class, ", ArgType, false /* isBaseType */> {\n")
        n.o("public:\n    static bool isOfType(ArgType& node) { return checkTagName(node); }\nprivate:\n")
        const tag = s.join3(ns(), "Names::", element.identifier)
        if s.same(ns(), "HTML") && (n.truthy(element.wrapperOnlyIfMediaIsAvailable) || n.truthy(element.settingsConditional) || n.truthy(element.deprecatedGlobalSettingsConditional)) {
            n.o3("    static bool checkTagName(const WebCore::HTMLElement& element) { return !element.isHTMLUnknownElement() && element.hasTagName(WebCore::", tag, "Tag); }\n")
            n.o("    static bool checkTagName(const WebCore::Node& node)\n    {\n        auto* element = dynamicDowncast<WebCore::HTMLElement>(node);\n        return element && checkTagName(*element);\n    }\n")
        } else {
            n.o5("    static bool checkTagName(const WebCore::", ns(), "Element& element) { return element.hasTagName(WebCore::", tag, "Tag); }\n")
            n.o3("    static bool checkTagName(const WebCore::Node& node) { return node.hasTagName(WebCore::", tag, "Tag); }\n")
        }
        n.o("    static bool checkTagName(const WebCore::EventTarget& target)\n    {\n        auto* node = dynamicDowncast<WebCore::Node>(target);\n        return node && checkTagName(*node);\n    }\n};\n}\n")
        n.o("\n")
    }
    n.save(filePath)
}

// ---------------------------------------------------------------------------
// The element factory.

// The name of the constructor of an element of INTERFACENAME: the Perl's
// s/NAMESPACE(.*)Element/$1/, then lower case.
fn constructorName(interfaceName: []const u8) -> []const u8 {
    const prefix = ns()
    var at: usize = 0
    while at + prefix.length <= interfaceName.length {
        if s.same(interfaceName[at..at + prefix.length], prefix) {
            // The last "Element" after it.
            var end = interfaceName.length
            while end >= at + prefix.length + 7 {
                if s.same(interfaceName[end - 7..end], "Element") {
                    return n.lower(s.join3(interfaceName[0..at], interfaceName[at + prefix.length..end - 7], interfaceName[end..interfaceName.length]))
                }
                end -= 1
            }
        }
        at += 1
    }
    return n.lower(interfaceName)
}

fn printConstructorInterior(element: m.Element, interfaceName: []const u8) -> void {
    const fallback = param("fallbackInterfaceName")
    if n.truthy(element.wrapperOnlyIfMediaIsAvailable) {
        n.o3("    if (!document.settings().mediaEnabled())\n        return ", fallback, "::create(tagName, document);\n\n")
    }
    var runtimeCondition: []const u8 = ""
    const settings = element.settingsConditional
    if n.truthy(settings) {
        if s.contains(settings, "&") {
            var start: usize = 0
            var index: usize = 0
            while index <= settings.length {
                if index == settings.length || settings[index] == 38 {
                    const condition = settings[start..index]
                    if condition.length > 0 || hasMore(settings, index) {
                        if runtimeCondition.length > 0 { runtimeCondition = s.join(runtimeCondition, " && ") }
                        runtimeCondition = s.join(runtimeCondition, settingsCall(condition))
                    }
                    start = index + 1
                }
                index += 1
            }
        } else {
            runtimeCondition = settingsCall(settings)
        }
    } else if n.truthy(element.deprecatedGlobalSettingsConditional) {
        runtimeCondition = s.join3("DeprecatedGlobalSettings::", element.deprecatedGlobalSettingsConditional, "Enabled()")
    }
    if n.truthy(runtimeCondition) {
        n.o5("    if (!(", runtimeCondition, "))\n        return ", fallback, "::create(tagName, document);\n")
    }
    n.o3("    return ", interfaceName, "::create(tagName, document")
    if n.truthy(element.constructorNeedsCreatedByParser) { n.o(", createdByParser") }
    n.o(");\n}\n")
}

// "document.settings().NAME()" of NAME, "!document.settings().NAME()" of !NAME.
fn settingsCall(condition: []const u8) -> []const u8 {
    if condition.length > 1 && condition[0] == 33 { return s.join3("!document.settings().", condition[1..condition.length], "()") }
    return s.join3("document.settings().", condition, "()")
}

fn printConstructors(order: [*]usize) -> void {
    var handled = n.list()
    var position: usize = 0
    while position < m.elementCount {
        const element = m.elements[order[position]]
        position += 1
        const interfaceName = element.interfaceName
        if n.has(handled, interfaceName) { continue }
        if n.truthy(element.noConstructor) { continue }
        n.push(&handled, interfaceName)
        const conditional = element.conditional
        if n.truthy(conditional) { n.o3("#if ", enableString(conditional), "\n") }
        n.o5("static Ref<", ns(), "Element> ", constructorName(interfaceName), "Constructor(const QualifiedName& tagName, Document& document")
        n.o(", bool")
        if n.truthy(element.constructorNeedsCreatedByParser) { n.o(" createdByParser") }
        n.o(")\n{\n")
        printConstructorInterior(element, interfaceName)
        if n.truthy(conditional) { n.o("#endif\n") }
        n.o("\n")
    }
}

fn printTagNameCases(order: [*]usize, usePassedName: bool) -> void {
    var position: usize = 0
    while position < m.elementCount {
        const element = m.elements[order[position]]
        position += 1
        if n.truthy(element.noConstructor) { continue }
        const conditional = element.conditional
        if n.truthy(conditional) { n.o3("#if ", enableString(conditional), "\n") }
        n.o3("    case TagName::", element.tagEnumValue, ":\n")
        if usePassedName {
            n.o3("        return ", constructorName(element.interfaceName), "Constructor(name, document, createdByParser);\n")
        } else {
            n.o5("        return ", constructorName(element.interfaceName), "Constructor(", ns(), "Names::")
            n.o3(element.identifier, "Tag, document, createdByParser);\n", "")
        }
        if n.truthy(conditional) { n.o("#endif\n") }
    }
}

fn printElementIncludes(order: [*]usize) -> void {
    var seen = n.list()
    var position: usize = 0
    while position < m.elementCount {
        const element = m.elements[order[position]]
        position += 1
        if n.has(seen, element.interfaceName) { continue }
        if n.truthy(element.conditional) { continue }
        n.push(&seen, element.interfaceName)
        n.o3("#include \"", element.interfaceName, ".h\"\n")
    }
    n.o3("#include \"", param("fallbackInterfaceName"), ".h\"\n")
}

fn usesDefaultJSWrapper(element: m.Element) -> bool { return s.same(element.JSInterfaceName, s.join(ns(), "Element")) }

fn printJSElementIncludes(order: [*]usize) -> void {
    var seen = n.list()
    var position: usize = 0
    while position < m.elementCount {
        const element = m.elements[order[position]]
        position += 1
        if n.has(seen, element.JSInterfaceName) || usesDefaultJSWrapper(element) { continue }
        if n.truthy(element.conditional) { continue }
        n.push(&seen, element.JSInterfaceName)
        n.o3("#include \"JS", element.JSInterfaceName, ".h\"\n")
    }
    n.o3("#include \"JS", param("fallbackJSInterfaceName"), ".h\"\n")
}

fn printConditionalElementIncludes(wrapperIncludes: bool) -> void {
    var conditionals = n.list()
    var unconditional = n.list()
    var unconditionalJS = n.list()
    var index: usize = 0
    while index < m.elementCount {
        const element = m.elements[index]
        if n.truthy(element.conditional) {
            n.add(&conditionals, element.conditional)
        } else {
            n.add(&unconditional, element.interfaceName)
            n.add(&unconditionalJS, element.JSInterfaceName)
        }
        index += 1
    }
    n.sortList(&conditionals)
    var c: usize = 0
    while c < conditionals.count {
        const conditional = conditionals.items[c]
        c += 1
        n.o3("\n#if ENABLE(", conditional, ")\n")
        var interfaces = n.list()
        var jsInterfaces = n.list()
        index = 0
        while index < m.elementCount {
            if s.same(m.elements[index].conditional, conditional) {
                n.add(&interfaces, m.elements[index].interfaceName)
                n.add(&jsInterfaces, m.elements[index].JSInterfaceName)
            }
            index += 1
        }
        n.sortList(&interfaces)
        n.sortList(&jsInterfaces)
        var i: usize = 0
        while i < interfaces.count {
            if !n.has(unconditional, interfaces.items[i]) { n.o3("#include \"", interfaces.items[i], ".h\"\n") }
            i += 1
        }
        if wrapperIncludes {
            i = 0
            while i < jsInterfaces.count {
                if !n.has(unconditionalJS, jsInterfaces.items[i]) { n.o3("#include \"JS", jsInterfaces.items[i], ".h\"\n") }
                i += 1
            }
        }
        n.o("#endif\n")
    }
}

fn printFactoryCppFile(filePath: []const u8) -> void {
    const order = m.sortedElements(m.elementsByKey)
    const name = ns()
    const guard = param("guardFactoryWith")
    printLicenseHeader()
    n.o("#include \"config.h\"\n")
    if n.truthy(guard) { n.o3("\n#if ", guard, "\n\n") }
    n.o3("#include \"", name, "ElementFactory.h\"\n\n")
    n.o3("#include \"", name, "Names.h\"\n\n")
    printElementIncludes(order)
    printConditionalElementIncludes(false)
    n.o("\n#include \"DeprecatedGlobalSettings.h\"\n#include \"Document.h\"\n#include \"NodeName.h\"\n#include \"Settings.h\"\n#include \"TagName.h\"\n\nnamespace WebCore {\n\n")
    const arguments = "document, createdByParser"
    const lowercase = lowercasePrefix()
    printConstructors(order)
    n.o5("\nRefPtr<", name, "Element> ", name, "ElementFactory::createKnownElement(TagName tagName, Document& document, bool createdByParser)\n{\n    switch (tagName) {\n")
    printTagNameCases(order, false)
    n.o("    default:\n        return nullptr;\n    }\n}\n\n")
    n.o5("RefPtr<", name, "Element> ", name, "ElementFactory::createKnownElementWithName(TagName tagName, const QualifiedName& name, Document& document, bool createdByParser)\n{\n    switch (tagName) {\n")
    printTagNameCases(order, true)
    n.o("    default:\n        return nullptr;\n    }\n}\n\n")
    n.o5("RefPtr<", name, "Element> ", name, "ElementFactory::createKnownElement(const AtomString& localName, Document& document, bool createdByParser)\n{\n")
    n.o5("    return createKnownElement(tagNameForElementName(find", name, "ElementName(localName)), ", arguments, ");\n}\n\n")
    n.o5("RefPtr<", name, "Element> ", name, "ElementFactory::createKnownElement(const QualifiedName& name, Document& document, bool createdByParser)\n{\n")
    n.o3("    return createKnownElementWithName(tagNameForElementName(name.nodeName()), name, ", arguments, ");\n}\n\n")
    n.o5("Ref<", name, "Element> ", name, "ElementFactory::createElement(const AtomString& localName, Document& document, bool createdByParser)\n{\n")
    n.o3("    auto elementName = find", name, "ElementName(localName);\n")
    n.o3("    if (elementName != ElementName::Unknown)\n        return createKnownElement(tagNameForElementName(elementName), ", arguments, ").releaseNonNull();\n")
    n.o5("    return ", param("fallbackInterfaceName"), "::create(QualifiedName(nullAtom(), localName, ", name, "Names::")
    n.o3(lowercase, "NamespaceURI), document);\n}\n\n", "")
    n.o5("Ref<", name, "Element> ", name, "ElementFactory::createElement(const QualifiedName& name, Document& document, bool createdByParser)\n{\n")
    n.o("    auto elementName = name.nodeName();\n    if (elementName != ElementName::Unknown) {\n")
    n.o3("        if (auto result = createKnownElementWithName(tagNameForElementName(elementName), name, ", arguments, "))\n            return result.releaseNonNull();\n    }\n")
    n.o3("    return ", param("fallbackInterfaceName"), "::create(name, document);\n}\n\n} // namespace WebCore\n\n")
    if n.truthy(guard) { n.o("#endif\n") }
    n.save(filePath)
}

fn printFactoryHeaderFile(filePath: []const u8) -> void {
    const name = ns()
    printLicenseHeader()
    n.o("#pragma once\n\n#include <wtf/Forward.h>\n\nnamespace WebCore {\n\nclass Document;\nclass QualifiedName;\n\n")
    n.o3("class ", name, "Element;\n\nenum class TagName : uint16_t;\n\n")
    n.o3("class ", name, "ElementFactory {\npublic:\n")
    n.o3("    static RefPtr<", name, "Element> createKnownElement(const AtomString&, Document&, bool createdByParser = false);\n")
    n.o3("    static RefPtr<", name, "Element> createKnownElement(const QualifiedName&, Document&, bool createdByParser = false);\n")
    n.o3("    static RefPtr<", name, "Element> createKnownElement(TagName, Document&, bool createdByParser = false);\n")
    n.o3("    static RefPtr<", name, "Element> createKnownElementWithName(TagName, const QualifiedName&, Document&, bool createdByParser = false);\n")
    n.o3("    static Ref<", name, "Element> createElement(const AtomString&, Document&, bool createdByParser = false);\n")
    n.o3("    static Ref<", name, "Element> createElement(const QualifiedName&, Document&, bool createdByParser = false);\n")
    n.o("};\n\n}\n\n")
    n.save(filePath)
}

// ---------------------------------------------------------------------------
// The wrapper factory.

fn printWrapperFunction(name: []const u8, wrapper: []const u8, fallbackWrapper: []const u8, checked: bool, blank: bool) -> void {
    n.o5("static JSDOMObject* create", name, "Wrapper(JSDOMGlobalObject* globalObject, Ref<", ns(), "Element>&& element)\n{\n")
    if checked {
        n.o3("    if (element->is", param("fallbackInterfaceName"), "())\n")
        n.o3("        return createWrapper<", fallbackWrapper, ">(globalObject, WTF::move(element));\n")
    }
    n.o3("    return createWrapper<", wrapper, ">(globalObject, WTF::move(element));\n}\n")
    if blank { n.o("\n") }
}

fn printWrapperFunctions(order: [*]usize) -> void {
    const defaultElement = s.join(ns(), "Element")
    const fallbackJS = param("fallbackJSInterfaceName")
    const fallback = param("fallbackInterfaceName")
    var seen = n.list()
    var position: usize = 0
    while position < m.elementCount {
        const element = m.elements[order[position]]
        position += 1
        const js = element.JSInterfaceName
        if (n.has(seen, js) || (usesDefaultJSWrapper(element) && s.same(fallbackJS, defaultElement))) && !n.truthy(element.settingsConditional) { continue }
        n.add(&seen, js)
        const conditional = element.conditional
        if n.truthy(conditional) { n.o3("#if ", enableString(conditional), "\n\n") }
        if n.truthy(element.wrapperOnlyIfMediaIsAvailable) {
            printWrapperFunction(js, js, fallback, true, true)
        } else if n.truthy(element.settingsConditional) {
            printWrapperFunction(element.interfaceName, js, fallback, true, true)
        } else if n.truthy(element.deprecatedGlobalSettingsConditional) {
            printWrapperFunction(js, js, fallbackJS, true, false)
        } else {
            printWrapperFunction(js, js, "", false, true)
        }
        if n.truthy(conditional) { n.o("#endif\n\n") }
    }
}

fn printWrapperFactoryCppFile(outputDirectory: []const u8, fileName: []const u8) -> void {
    const order = m.sortedElements(m.elementsByKey)
    const name = ns()
    const guard = param("guardFactoryWith")
    const fallbackJS = param("fallbackJSInterfaceName")
    printLicenseHeader()
    n.o("#include \"config.h\"\n")
    n.o3("#include \"JS", name, "ElementWrapperFactory.h\"\n\n")
    if n.truthy(guard) { n.o3("\n#if ", guard, "\n\n") }
    printJSElementIncludes(order)
    printElementIncludes(order)
    n.o3("\n#include \"", name, "Names.h\"\n")
    n.o("\n#include \"DeprecatedGlobalSettings.h\"\n#include \"Document.h\"\n#include \"JSDOMWrapperCache.h\"\n#include \"NodeName.h\"\n#include \"Settings.h\"\n#include <wtf/NeverDestroyed.h>\n#include <wtf/StdLibExtras.h>\n")
    printConditionalElementIncludes(true)
    n.o("\nnamespace WebCore {\n\n")
    printWrapperFunctions(order)
    n.o5("\nJSDOMObject* createJS", name, "Wrapper(JSDOMGlobalObject* globalObject, Ref<", name, "Element>&& element)\n{\n    switch (element->elementName()) {\n")
    const defaultElement = s.join(name, "Element")
    var position: usize = 0
    while position < m.elementCount {
        const element = m.elements[order[position]]
        position += 1
        if usesDefaultJSWrapper(element) && s.same(fallbackJS, defaultElement) { continue }
        const conditional = element.conditional
        if n.truthy(conditional) { n.o3("#if ", enableString(conditional), "\n") }
        const ucName = if n.truthy(element.settingsConditional) { element.interfaceName } else { element.JSInterfaceName }
        n.o5("    case NodeName::", name, "_", element.identifier, ":\n")
        n.o3("        return create", ucName, "Wrapper(globalObject, WTF::move(element));\n")
        if n.truthy(conditional) { n.o("#endif\n") }
    }
    n.o("    default:\n        break;\n    }\n")
    const custom = param("customElementInterfaceName")
    if n.truthy(custom) {
        n.o3("    if (!element->isUnknownElement())\n        return createWrapper<", custom, ">(globalObject, WTF::move(element));\n")
    }
    if s.same(defaultElement, fallbackJS) { n.o3("    ASSERT(element->is", fallbackJS, "());\n") }
    n.o3("    return createWrapper<", fallbackJS, ">(globalObject, WTF::move(element));\n}\n\n}\n")
    if n.truthy(guard) { n.o("\n#endif\n") }
    n.save(n.path(outputDirectory, s.join3("JS", fileName, ".cpp")))
}

fn printWrapperFactoryHeaderFile(outputDirectory: []const u8, fileName: []const u8) -> void {
    const name = ns()
    printLicenseHeader()
    n.o("#pragma once\n\n#include <wtf/Forward.h>\n\nnamespace WebCore {\n\n    class JSDOMObject;\n    class JSDOMGlobalObject;\n")
    n.o3("    class ", name, "Element;\n\n")
    n.o5("    JSDOMObject* createJS", name, "Wrapper(JSDOMGlobalObject*, Ref<", name, "Element>&&);\n\n}\n\n")
    n.save(n.path(outputDirectory, s.join3("JS", fileName, ".h")))
}

// ---------------------------------------------------------------------------

fn usage() -> u8 {
    s.say("usage: webkit-make-names --outputDir DIRECTORY [--elements FILE ...] [--attrs FILE ...] [--factory] [--wrapperFactory] [--fonts FILE] [--enum TagName|NodeName|Namespace]\n")
    return 2
}

pub fn main(arguments: [][*]const u8) -> u8 {
    m.initialize()
    var elementsFiles = n.list()
    var attrsFiles = n.list()
    var outputDirectory: []const u8 = "."
    var fonts: []const u8 = ""
    var enumName: []const u8 = ""
    var factory = false
    var wrapperFactory = false
    var index: usize = 1
    while index < arguments.length {
        var argument = s.cString(arguments[index])
        index += 1
        // Getopt::Long takes "-name" as "--name", and "--name=value".
        if s.startsWith(argument, "--") { argument = argument[1..argument.length] }
        if !s.startsWith(argument, "-") { return usage() }
        var name = argument[1..argument.length]
        var value: []const u8 = ""
        var hasValue = false
        const equals = s.find(name, "=")
        if equals < name.length {
            value = name[equals + 1..name.length]
            name = name[0..equals]
            hasValue = true
        }
        if s.same(name, "factory") {
            factory = true
        } else if s.same(name, "wrapperFactory") {
            wrapperFactory = true
        } else if s.same(name, "elements") || s.same(name, "attrs") || s.same(name, "outputDir") || s.same(name, "fonts") || s.same(name, "enum") {
            if !hasValue {
                if index == arguments.length { return usage() }
                value = s.cString(arguments[index])
                index += 1
            }
            if s.same(name, "elements") {
                n.push(&elementsFiles, value)
            } else if s.same(name, "attrs") {
                n.push(&attrsFiles, value)
            } else if s.same(name, "outputDir") {
                outputDirectory = value
            } else if s.same(name, "fonts") {
                fonts = value
            } else {
                enumName = value
            }
        } else {
            return usage()
        }
    }
    n.makeDirectories(outputDirectory)

    if fonts.length > 0 {
        m.readParameters(fonts)
        printFonts(outputDirectory)
        return 0
    }

    if elementsFiles.count == 0 && attrsFiles.count == 0 { s.fail("You must specify at least one of --elements <file> or --attrs <file>") }
    const isEnum = enumName.length > 0
    if !isEnum && elementsFiles.count > 1 { s.fail("You must not specify multiple --elements <file> arguments unless --domNames is also specified") }
    if !isEnum && attrsFiles.count > 1 { s.fail("You must not specify multiple --attrs <file> arguments unless --domNames is also specified") }
    if isEnum && (factory || wrapperFactory) { s.fail("--enum must not be specified with --factory, --wrapperFactory, or --fonts") }
    if isEnum && !s.same(enumName, "TagName") && !s.same(enumName, "NodeName") && !s.same(enumName, "Namespace") { s.fail("Unsupported value for --enum") }

    var i: usize = 0
    while i < elementsFiles.count {
        m.readElements(elementsFiles.items[i])
        if isEnum { m.clearParameters() }
        i += 1
    }
    i = 0
    while i < attrsFiles.count {
        m.readAttributes(attrsFiles.items[i])
        if isEnum { m.clearParameters() }
        i += 1
    }
    if !isEnum && !n.truthy(param("fallbackJSInterfaceName")) { m.setParameter("fallbackJSInterfaceName", param("fallbackInterfaceName")) }
    m.collect()

    if !isEnum {
        printNamesHeaderFile(n.path(outputDirectory, s.join(ns(), "Names.h")))
        printNamesCppFile(n.path(outputDirectory, s.join(ns(), "Names.cpp")))
        printTypeHelpersHeaderFile(n.path(outputDirectory, s.join(ns(), "ElementTypeHelpers.h")))
    }
    if factory {
        printFactoryCppFile(n.path(outputDirectory, s.join(ns(), "ElementFactory.cpp")))
        printFactoryHeaderFile(n.path(outputDirectory, s.join(ns(), "ElementFactory.h")))
    }
    if wrapperFactory {
        const fileName = s.join(ns(), "ElementWrapperFactory")
        printWrapperFactoryCppFile(outputDirectory, fileName)
        printWrapperFactoryHeaderFile(outputDirectory, fileName)
    }
    if s.same(enumName, "TagName") {
        printLicenseHeader()
        e.printTagNameHeaderFile(n.path(outputDirectory, "TagName.h"))
        printLicenseHeader()
        e.printTagNameCppFile(n.path(outputDirectory, "TagName.cpp"))
    }
    if s.same(enumName, "NodeName") {
        printLicenseHeader()
        e.printNodeNameHeaderFile(n.path(outputDirectory, "NodeName.h"))
        printLicenseHeader()
        e.printNodeNameCppFile(n.path(outputDirectory, "NodeName.cpp"))
    }
    if s.same(enumName, "Namespace") {
        printLicenseHeader()
        e.printNamespaceHeaderFile(n.path(outputDirectory, "Namespace.h"))
        printLicenseHeader()
        e.printNamespaceCppFile(n.path(outputDirectory, "Namespace.cpp"))
    }
    return 0
}

