// WebCore's table of the named character references of HTML
// (HTMLEntityTable.cpp), made as html/parser/create-html-entity-table
// (Python) makes it, from html/parser/HTMLEntityNames.in:
//
//     webkit-html-entity-table -o OUTPUT INPUT
//
// Each line of the input is "NAME","U+XXXXX[ U+XXXXX]". The names, sorted,
// are kept in one string, each where it is already found in what came
// before, or else added at the end (overlapping the end where it can); a
// table gives each its characters, length and place in that string, and
// two short tables the first entry of each letter.
const std = @import("std")
const s = @import("./support.mlx")
const n = @import("./namestext.mlx")

const Entry = struct {
    name: []const u8
    value: []const u8
    offset: usize
}

var entries: [*]Entry = undefined
var entryCount: usize = 0

// The fields of a line of CSV (as Python's csv module reads them):
// quoted ones lose their quotes, a doubled quote inside is one.
fn fields(line: []const u8, first: *[]const u8, second: *[]const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while true {
        var field: []const u8 = ""
        if at < line.length && line[at] == 34 {
            at += 1
            while at < line.length {
                if line[at] == 34 {
                    if at + 1 < line.length && line[at + 1] == 34 {
                        field = s.join(field, "\"")
                        at += 2
                        continue
                    }
                    at += 1
                    break
                }
                field = s.join(field, line[at..at + 1])
                at += 1
            }
            while at < line.length && line[at] != 44 {
                field = s.join(field, line[at..at + 1])
                at += 1
            }
        } else {
            const start = at
            while at < line.length && line[at] != 44 { at += 1 }
            field = line[start..at]
        }
        if count == 0 { first.* = field }
        if count == 1 { second.* = field }
        count += 1
        if at >= line.length { break }
        at += 1
    }
    return count
}

// The number of "U+XXXXX" (0 for "").
fn codePoint(value: []const u8) -> u64 {
    if value.length == 0 { return 0 }
    if value.length < 3 || value[0] != 85 || value[1] != 43 { s.fail(s.join("create-html-entity-table: not U+XXXX: ", value)) }
    var result: u64 = 0
    for byte in value[2..value.length] {
        var digit: u64 = 0
        if byte >= 48 && byte <= 57 {
            digit = @intCast(u64, byte - 48)
        } else if byte >= 65 && byte <= 70 {
            digit = @intCast(u64, byte - 55)
        } else if byte >= 97 && byte <= 102 {
            digit = @intCast(u64, byte - 87)
        } else {
            s.fail(s.join("create-html-entity-table: not hexadecimal: ", value))
        }
        result = result * 16 + digit
    }
    return result
}

fn byName(first: usize, second: usize) -> i32 { return n.compare(entries[first].name, entries[second].name) }

// Where NEEDLE first is in TEXT, or -1 (Python's str.find).
fn findIn(text: []const u8, needle: []const u8) -> i64 {
    const at = s.find(text, needle)
    if at == text.length && !(needle.length == 0) { return -1 }
    return @intCast(i64, at)
}

