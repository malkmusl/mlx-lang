// THIS FILE IS GENERATED BY WebCore/html/parser/create-html-entity-table
// DO NOT EDIT!

#include \"config.h\"
#include \"HTMLEntityTable.h\"

#include <wtf/StdLibExtras.h>
#include <wtf/text/ASCIILiteral.h>

namespace WebCore {

static constexpr auto staticEntityStringStorage = "

const TAIL = "});

std::span<const char> HTMLEntityTableEntry::nameCharacters() const
{
    return staticEntityStringStorage.span().subspan(nameCharactersOffset, nameLengthExcludingSemicolon);
}

std::span<const HTMLEntityTableEntry> HTMLEntityTable::entriesStartingWith(char16_t c)
{
    if (c >= 'A' && c <= 'Z') {
        auto* start = &staticEntityTable[uppercaseOffset[c - 'A']];
        return unsafeMakeSpan(start, &staticEntityTable[uppercaseOffset[c - 'A' + 1] - 1] - start + 1);
    }
    if (c >= 'a' && c <= 'z') {
        auto* start = &staticEntityTable[lowercaseOffset[c - 'a']];
        return unsafeMakeSpan(start, &staticEntityTable[lowercaseOffset[c - 'a' + 1] - 1] - start + 1);
    }
    return { };
}

std::span<const HTMLEntityTableEntry> HTMLEntityTable::entries()
{
    return staticEntityTable;
}

}

"

fn generate(inputPath: []const u8, outputPath: []const u8) -> void {
    const text = s.readWhole(inputPath)
    var lineCount: usize = 0
    for byte in text {
        if byte == 10 { lineCount += 1 }
    }
    unsafe { entries = @ptrFromInt([*]Entry, s.alloc((lineCount + 2) * @sizeOf(Entry))) }
    var at: usize = 0
    while at < text.length {
        var line = s.nextLine(text, &at)
        if line.length > 0 && line[line.length - 1] == 13 { line = line[0..line.length - 1] }
        var name: []const u8 = ""
        var value: []const u8 = ""
        if fields(line, &name, &value) != 2 { s.fail(s.join("create-html-entity-table: not two fields: ", line)) }
        for byte in name {
            if byte > 127 { s.fail(s.join(name, " is not ASCII.")) }
        }
        entries[entryCount] = Entry.{ .name = name, .value = value, .offset = 0 }
        entryCount += 1
    }
    if entryCount == 0 { s.fail("Code assumes a non-empty entity array.") }
    const order = n.indexes(entryCount)
    n.sortBy(order, entryCount, byName)

    n.o(HEAD)
    var allData: []const u8 = ""
    var entityOffset: usize = 0
    var index: usize = 0
    while index < entryCount {
        const e = &entries[order[index]]
        var entity = e.*.name
        if entity.length > 0 && entity[entity.length - 1] == 59 { entity = entity[0..entity.length - 1] }
        const existing = findIn(allData, entity)
        if existing >= 0 {
            e.*.offset = @intCast(usize, existing)
        } else {
            n.o("\n\"")
            var dataToAdd = entity
            var thisOffset = entityOffset
            var truncated = if entity.length > 0 { entity.length - 1 } else { 0 }
            while truncated > 0 {
                if s.endsWith(allData, entity[0..truncated]) {
                    dataToAdd = entity[truncated..entity.length]
                    thisOffset = entityOffset - truncated
                    break
                }
                truncated -= 1
            }
            n.o(dataToAdd)
            allData = s.join(allData, dataToAdd)
            n.o("\"")
            entityOffset += dataToAdd.length
            e.*.offset = thisOffset
        }
        index += 1
    }
    n.o("_s;\n")

    n.o("\nstatic constexpr std::array<HTMLEntityTableEntry, ")
    n.on(@intCast(u64, entryCount))
    n.o("> staticEntityTable {\n")
    // The first entry of each starting byte.
    var firstOf: [256]i64 = undefined
    var letter: usize = 0
    while letter < 256 {
        firstOf[letter] = -1
        letter += 1
    }
    index = 0
    while index < entryCount {
        const e = entries[order[index]]
        if firstOf[e.name[0]] < 0 { firstOf[e.name[0]] = @intCast(i64, index) }
        var first = e.value
        var second: []const u8 = ""
        const space = s.find(e.value, " ")
        if space < e.value.length {
            first = e.value[0..space]
            second = e.value[space + 1..e.value.length]
            if s.contains(second, " ") { s.fail(s.join("create-html-entity-table: more than two values: ", e.value)) }
        }
        var nameLength = e.name.length
        const semicolon = e.name[e.name.length - 1] == 59
        if semicolon { nameLength -= 1 }
        n.o("    HTMLEntityTableEntry { ")
        n.on(codePoint(first))
        n.o(", ")
        n.on(@intCast(u64, nameLength))
        n.o(if semicolon { ", 1, " } else { ", 0, " })
        n.on(@intCast(u64, e.offset))
        n.o(", ")
        n.on(codePoint(second))
        n.o(" }, // &")
        n.o(e.name)
        n.o("\n")
        index += 1
    }
    n.o("};\n\n")
    n.o("static constexpr auto uppercaseOffset = WTF::toArray<uint16_t>({\n")
    letter = 65
    while letter <= 90 {
        n.on(@intCast(u64, firstOf[letter]))
        n.o(",\n")
        letter += 1
    }
    n.on(@intCast(u64, firstOf[97]))
    n.o("\n});\n\nstatic constexpr auto lowercaseOffset = WTF::toArray<uint16_t>({\n")
    letter = 97
    while letter <= 122 {
        n.on(@intCast(u64, firstOf[letter]))
        n.o(",\n")
        letter += 1
    }
    n.on(@intCast(u64, entryCount))
    n.o("\n")
    n.o(TAIL)
    n.save(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 4 || !std.text.same(s.cString(arguments[1]), "-o") {
        s.say("Usage: webkit-html-entity-table -o OUTPUT_FILE INPUT_FILE\n")
        return 1
    }
    generate(s.cString(arguments[3]), s.cString(arguments[2]))
    return 0
}
