// A file as a C array of its bytes, as JavaScriptCore's xxd.pl writes it:
//
//     webkit-xxd NAME INPUT OUTPUT
//
// `const unsigned char NAME[] = {`, the bytes as 0x.. joined by ", ", `};`.
const std = @import("std")
const s = @import("./support.mlx")
const c = @import("./csstext.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 4 {
        s.say("usage: webkit-xxd NAME INPUT OUTPUT\n")
        return 2
    }
    const data = c.readFile(std.text.cString(arguments[2]))
    const digits = "0123456789abcdef"
    var b = c.buf()
    c.add(&b, "const unsigned char ")
    c.add(&b, std.text.cString(arguments[1]))
    c.add(&b, "[] = {\n")
    var index: usize = 0
    while index < data.length {
        if index > 0 { c.add(&b, ", ") }
        c.add(&b, "0x")
        c.addByte(&b, digits[@intCast(usize, data[index] >> 4)])
        c.addByte(&b, digits[@intCast(usize, data[index] & 15)])
        index += 1
    }
    c.add(&b, "\n};\n")
    s.writeWhole(std.text.cString(arguments[3]), c.contents(&b))
    return 0
}
