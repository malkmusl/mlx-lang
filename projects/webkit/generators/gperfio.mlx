// The text webkit-gperf makes, built up in a buffer of its own (not
// support.mlx's, so that a generator calling gperf in the same process
// keeps its own) and written at the end to the output file or standard
// output; and its input, read whole from a file or standard input.
const std = @import("std")
const s = @import("./support.mlx")

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_open: usize = 2
const SYS_close: usize = 3
const O_RDONLY: usize = 0
const O_WRITE_NEW: usize = 577

const OUT_SIZE: usize = 1073741824
var base: usize = 0
var top: usize = 0

fn room(length: usize) -> void {
    if base == 0 { base = s.alloc(OUT_SIZE) }
    if top + length > OUT_SIZE { s.fail("gperf: the output is too large") }
}

pub fn out(text: []const u8) -> void {
    room(text.length)
    var index: usize = 0
    while index < text.length {
        s.put8(base + top + index, text[index])
        index += 1
    }
    top += text.length
}

pub fn outByte(byte: u8) -> void {
    room(1)
    s.put8(base + top, byte)
    top += 1
}

// N spaces (printf's "%*s" of "").
pub fn spaces(count: i64) -> void {
    var left = count
    while left > 0 {
        outByte(32)
        left -= 1
    }
}

// VALUE in decimal, right-aligned in WIDTH columns (printf's "%*d").
pub fn padded(width: i64, value: i64) -> void {
    var digits: [24]u8 = undefined
    var at: usize = 24
    var rest: u64 = if value < 0 { @intCast(u64, 0 - value) } else { @intCast(u64, value) }
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        if rest == 0 { break }
    }
    if value < 0 {
        at -= 1
        digits[at] = 45
    }
    spaces(width - @intCast(i64, 24 - at))
    out(digits[at..24])
}

pub fn number(value: i64) -> void { padded(0, value) }

pub fn text() -> []const u8 {
    if base == 0 { return "" }
    return s.bytes(base, top)
}

// Whether the text could be written to PATH (to standard output when
// TO_STDOUT).
pub fn writeTo(path: []const u8, toStdout: bool) -> bool {
    var descriptor: isize = 1
    if !toStdout {
        const name = s.join(path, "")
        descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_WRITE_NEW, 420)
        if descriptor < 0 { return false }
    }
    const data = text()
    var done: usize = 0
    while done < data.length {
        const count = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(data.pointer) + done, data.length - done)
        if count <= 0 { return false }
        done += @intCast(usize, count)
    }
    if !toStdout {
        const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    }
    return true
}

// The whole of PATH (of standard input when FROM_STDIN), with a NUL byte
// after its end as gperf has one; OK tells whether it could be opened.
pub fn readAll(path: []const u8, fromStdin: bool, ok: *bool) -> []const u8 {
    var descriptor: isize = 0
    if !fromStdin {
        const name = s.join(path, "")
        descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
        if descriptor < 0 {
            ok.* = false
            return ""
        }
    }
    const capacity: usize = 268435456
    const data = s.alloc(capacity + 1)
    var length: usize = 0
    while length < capacity {
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    s.put8(data + length, 0)
    if !fromStdin {
        const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    }
    ok.* = true
    return s.bytes(data, length)
}

// The run ends with STATUS.
pub fn exit(status: usize) -> void {
    const ignored = std.linux.syscall1(231, status)
}
