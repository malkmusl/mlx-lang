// The inspector protocol in one file, CombinedDomains.json, made as
// JavaScriptCore's Scripts/generate-combined-inspector-json.py makes it,
// from the domain files of inspector/protocol (or directories of them):
//
//     webkit-combined-inspector-json OUTPUT INPUT... 'CONDITION_FLAGS'
//
// The files, in the order of their paths, are copied unchanged (their
// trailing whitespace dropped) into a "domains" array; each must be JSON
// (once its /* */ comments are gone) with a "domain" key. The
// "conditionFlags" are those of CONDITION_FLAGS (split on single spaces,
// so an empty one too) written somewhere in a file, sorted.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const json = @import("./inspectorjsonvalue.mlx")

const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_access: usize = 21
const SYS_getdents64: usize = 217
const O_DIRECTORY: usize = 65536

// The "*.json" files of DIRECTORY (glob's: not those starting with a dot).
fn jsonFilesIn(directory: []const u8, files: *t.List) -> void {
    const name = s.join(directory, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_DIRECTORY, 0)
    if descriptor < 0 { return }
    const buffer = s.alloc(65536)
    while true {
        const got = std.linux.syscall3(SYS_getdents64, @bitCast(usize, descriptor), buffer, 65536)
        if got <= 0 { break }
        // struct linux_dirent64: d_ino (8), d_off (8), d_reclen (2), d_type (1), the name.
        var at: usize = 0
        while at < @bitCast(usize, got) {
            const record = s.bytes(buffer + at, 19)
            const recordLength = @intCast(usize, record[16]) | (@intCast(usize, record[17]) << 8)
            if recordLength == 0 { break }
            const entry = std.text.cString(unsafe { @ptrFromInt([*]const u8, buffer + at + 19) })
            if entry.length > 5 && entry[0] != 46 && std.text.endsWith(entry, ".json") {
                t.push(files, t.pathJoin(directory, s.join(entry, "")))
            }
            at += recordLength
        }
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

fn isDirectory(path: []const u8) -> bool {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_DIRECTORY, 0)
    if descriptor < 0 { return false }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return true
}

// TEXT as Python reads a file in text mode: "\r\n" and "\r" become "\n".
fn universalNewlines(text: []const u8) -> []const u8 {
    if !std.text.contains(text, "\r") { return text }
    const at = s.alloc(text.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < text.length {
        if text[index] == 13 {
            s.put8(at + length, 10)
            if index + 1 < text.length && text[index + 1] == 10 { index += 1 }
        } else {
            s.put8(at + length, text[index])
        }
        length += 1
        index += 1
    }
    return s.bytes(at, length)
}

fn combine(output: []const u8, inputs: t.List, flags: []const u8) -> void {
    var files = t.list()
    var index: usize = 0
    while index < inputs.count {
        const path = inputs.items[index]
        const name = s.join(path, "")
        if std.linux.syscall2(SYS_access, @intFromPtr(name.pointer), 0) < 0 { s.fail(t.c3("File \"", path, "\" not found")) }
        if isDirectory(path) {
            jsonFilesIn(path, &files)
        } else {
            t.push(&files, path)
        }
        index += 1
    }
    t.sort(&files)

    // The flags as Python's split(" ") gives them.
    var known = t.list()
    var start: usize = 0
    index = 0
    while index <= flags.length {
        if index == flags.length || flags[index] == 32 {
            t.push(&known, flags[start..index])
            start = index + 1
        }
        index += 1
    }
    var used = t.list()

    var text = t.list()
    t.push(&text, "{\"domains\":[\n")
    index = 0
    while index < files.count {
        const file = files.items[index]
        if index > 0 { t.push(&text, ",\n") }
        const contents = universalNewlines(s.readWhole(file))
        const domain = json.parse(json.withoutComments(contents), file)
        if domain.*.kind != json.OBJECT || !json.has(domain, "domain") {
            s.fail(t.c3("File \"", file, "\" does not contains a \"domain\" key."))
        }
        var flag: usize = 0
        while flag < known.count {
            const name = known.items[flag]
            if (name.length == 0 || std.text.contains(contents, name)) && !t.contains(used, name) { t.push(&used, name) }
            flag += 1
        }
        t.push(&text, t.rstrip(contents))
        t.push(&text, "\n")
        index += 1
    }
    t.sort(&used)
    t.push(&text, "], \"conditionFlags\": \"")
    t.push(&text, t.joined(used, " "))
    t.push(&text, "\"}\n")
    s.writeWhole(output, t.joined(text, ""))
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 4 {
        s.say("usage: webkit-combined-inspector-json OUTPUT [json files or directory of json files ...] 'condition_flags'\n")
        return 1
    }
    var inputs = t.list()
    var index: usize = 2
    while index + 1 < arguments.length {
        t.push(&inputs, std.text.cString(arguments[index]))
        index += 1
    }
    combine(std.text.cString(arguments[1]), inputs, std.text.cString(arguments[arguments.length - 1]))
    return 0
}
