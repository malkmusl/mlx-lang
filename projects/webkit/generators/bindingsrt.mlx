// What the port of WebKit's IDL bindings generator (its Perl scripts) is
// built on: strings with Perl's undef among them, text built up in
// growing buffers, lists, ordered maps keyed by strings, Perl's string
// functions and sort, files, and the child processes the generator runs
// its batches in.
const std = @import("std")
const s = @import("./support.mlx")

pub const Str = []const u8

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_fstat: usize = 5
const SYS_fork: usize = 57
const SYS_wait4: usize = 61
const SYS_exit_group: usize = 231
const O_RDONLY: usize = 0
const O_WRITE_NEW: usize = 577

// ---------------------------------------------------------------------------
// Memory and undef.

pub fn alloc(size: usize) -> usize { return s.alloc(size) }

var undefAddress: usize = 0

// Perl's undef as a string: empty, told apart from "" by its address.
pub fn undef() -> Str {
    if undefAddress == 0 { undefAddress = s.alloc(16) }
    return s.bytes(undefAddress, 0)
}

pub fn isDef(text: Str) -> bool {
    if undefAddress == 0 { return true }
    return text.length != 0 || @intFromPtr(text.pointer) != undefAddress
}

// Whether TEXT is true as Perl takes a string: defined, not "" and not "0".
pub fn truthy(text: Str) -> bool {
    if text.length == 0 { return false }
    if text.length == 1 && text[0] == 48 { return false }
    return true
}

// TEXT, or OTHER when TEXT is false (Perl's TEXT || OTHER).
pub fn orElse(text: Str, other: Str) -> Str {
    if truthy(text) { return text }
    return other
}

// TEXT, or OTHER when TEXT is undef (Perl's TEXT // OTHER).
pub fn defOr(text: Str, other: Str) -> Str {
    if isDef(text) { return text }
    return other
}

pub fn copyBytes(address: usize, text: Str) -> void {
    const target: [*]u8 = unsafe { @ptrFromInt([*]u8, address) }
    var index: usize = 0
    while index < text.length {
        target[index] = text[index]
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Strings put together.

pub fn cat(parts: []const Str) -> Str {
    var total: usize = 0
    for part in parts { total += part.length }
    const at = s.alloc(total + 1)
    var done: usize = 0
    for part in parts {
        copyBytes(at + done, part)
        done += part.length
    }
    s.put8(at + total, 0)
    return s.bytes(at, total)
}

pub fn c2(a: Str, b: Str) -> Str { return s.join(a, b) }
pub fn c3(a: Str, b: Str, c: Str) -> Str { return cat([_]Str{ a, b, c }[0..]) }
pub fn c4(a: Str, b: Str, c: Str, d: Str) -> Str { return cat([_]Str{ a, b, c, d }[0..]) }
pub fn c5(a: Str, b: Str, c: Str, d: Str, e: Str) -> Str { return cat([_]Str{ a, b, c, d, e }[0..]) }

// Where NEEDLE first is in TEXT at or after FROM, or TEXT's length.
pub fn findFrom(text: Str, needle: Str, from: usize) -> usize {
    if needle.length > text.length { return text.length }
    var at = from
    while at + needle.length <= text.length {
        var index: usize = 0
        while index < needle.length && text[at + index] == needle[index] { index += 1 }
        if index == needle.length { return at }
        at += 1
    }
    return text.length
}

pub fn findByte(text: Str, byte: u8) -> usize {
    var at: usize = 0
    while at < text.length && text[at] != byte { at += 1 }
    return at
}

pub fn hasByte(text: Str, byte: u8) -> bool { return findByte(text, byte) < text.length }

pub fn isSpace(byte: u8) -> bool { return s.isSpace(byte) }
pub fn isDigit(byte: u8) -> bool { return s.isDigit(byte) }
pub fn isWord(byte: u8) -> bool { return s.isWord(byte) }
pub fn isUpper(byte: u8) -> bool { return byte >= 65 && byte <= 90 }
pub fn isLower(byte: u8) -> bool { return byte >= 97 && byte <= 122 }
pub fn isAlpha(byte: u8) -> bool { return isUpper(byte) || isLower(byte) }

pub fn upperByte(byte: u8) -> u8 { return if isLower(byte) { byte - 32 } else { byte } }
pub fn lowerByte(byte: u8) -> u8 { return if isUpper(byte) { byte + 32 } else { byte } }

fn mapped(text: Str, upper: bool, firstOnly: bool) -> Str {
    if text.length == 0 { return text }
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        var byte = text[index]
        if !firstOnly || index == 0 { byte = if upper { upperByte(byte) } else { lowerByte(byte) } }
        s.put8(at + index, byte)
        index += 1
    }
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

pub fn uc(text: Str) -> Str { return mapped(text, true, false) }
pub fn lc(text: Str) -> Str { return mapped(text, false, false) }
pub fn ucfirst(text: Str) -> Str { return mapped(text, true, true) }
pub fn lcfirst(text: Str) -> Str { return mapped(text, false, true) }

// TEXT with every FROM made TO (s/FROM/TO/g on a plain string).
pub fn replaceAll(text: Str, from: Str, to: Str) -> Str {
    if std.text.find(text, from) == text.length { return text }
    var b = buf()
    var start: usize = 0
    var at: usize = 0
    while at + from.length <= text.length {
        if std.text.same(text[at..at + from.length], from) {
            add(&b, text[start..at])
            add(&b, to)
            at += from.length
            start = at
        } else {
            at += 1
        }
    }
    add(&b, text[start..text.length])
    return done(b)
}

// TEXT with its first FROM made TO (s/FROM/TO/ on a plain string).
pub fn replaceFirst(text: Str, from: Str, to: Str) -> Str {
    const at = std.text.find(text, from)
    if at == text.length { return text }
    return c3(text[0..at], to, text[at + from.length..text.length])
}

// TEXT without the white space at both ends (s/^\s+|\s+$//g).
pub fn trim(text: Str) -> Str { return s.trimEnd(s.trimStart(text)) }

// Perl's substr(TEXT, START) and substr(TEXT, START, LENGTH) with a
// negative LENGTH counted from the end.
pub fn substrFrom(text: Str, start: usize) -> Str {
    if start >= text.length { return "" }
    return text[start..text.length]
}

pub fn substrInner(text: Str, start: usize, fromEnd: usize) -> Str {
    if start + fromEnd >= text.length { return "" }
    return text[start..text.length - fromEnd]
}

pub fn decimal(value: u64) -> Str { return s.decimal(value) }
pub fn signedDecimal(value: i64) -> Str { return s.signedDecimal(value) }

pub fn hex(value: u64) -> Str {
    var digits: [24]u8 = undefined
    var at: usize = 24
    var rest = value
    while true {
        at -= 1
        const digit = @intCast(u8, rest % 16)
        digits[at] = if digit < 10 { 48 + digit } else { 87 + digit }
        rest /= 16
        if rest == 0 { break }
    }
    return s.join(digits[at..24], "")
}

// Whether FIRST sorts before SECOND by bytes (Perl's cmp).
pub fn less(first: Str, second: Str) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

// -1, 0 or 1 as Perl's cmp.
pub fn compare(first: Str, second: Str) -> i32 {
    if less(first, second) { return -1 }
    if less(second, first) { return 1 }
    return 0
}

// The decimal number at the start of TEXT as Perl's numeric value of a
// string takes it (leading spaces, a sign, digits).
pub fn numberOf(text: Str) -> i64 {
    var at: usize = 0
    while at < text.length && isSpace(text[at]) { at += 1 }
    var negative = false
    if at < text.length && (text[at] == 45 || text[at] == 43) {
        negative = text[at] == 45
        at += 1
    }
    var value: i64 = 0
    while at < text.length && isDigit(text[at]) {
        value = value * 10 + @intCast(i64, text[at] - 48)
        at += 1
    }
    return if negative { -value } else { value }
}

// ---------------------------------------------------------------------------
// Text built up in a buffer that grows.

pub const Buf = struct {
    base: usize
    length: usize
    capacity: usize
}

pub fn buf() -> Buf { return Buf.{ .base = 0, .length = 0, .capacity = 0 } }

pub fn add(b: *Buf, text: Str) -> void {
    if b.*.length + text.length + 1 > b.*.capacity {
        var capacity = if b.*.capacity == 0 { 256 } else { b.*.capacity * 2 }
        while capacity < b.*.length + text.length + 1 { capacity *= 2 }
        const base = s.alloc(capacity)
        if b.*.length > 0 { copyBytes(base, s.bytes(b.*.base, b.*.length)) }
        b.*.base = base
        b.*.capacity = capacity
    }
    copyBytes(b.*.base + b.*.length, text)
    b.*.length += text.length
}

pub fn addByte(b: *Buf, byte: u8) -> void {
    var one: [1]u8 = undefined
    one[0] = byte
    add(b, one[0..1])
}

// The text of B (NUL-terminated past its end).
pub fn done(b: Buf) -> Str {
    if b.base == 0 { return "" }
    s.put8(b.base + b.length, 0)
    return s.bytes(b.base, b.length)
}

// ---------------------------------------------------------------------------
// Lists of strings.

pub const StrList = struct {
    items: [*]Str
    count: usize
    capacity: usize
}

pub fn strList() -> StrList {
    const items: [*]Str = unsafe { @ptrFromInt([*]Str, s.alloc(4 * @sizeOf(Str))) }
    return StrList.{ .items = items, .count = 0, .capacity = 4 }
}

pub fn spush(l: *StrList, text: Str) -> void {
    if l.*.count == l.*.capacity {
        const capacity = l.*.capacity * 2
        const items: [*]Str = unsafe { @ptrFromInt([*]Str, s.alloc(capacity * @sizeOf(Str))) }
        var index: usize = 0
        while index < l.*.count {
            items[index] = l.*.items[index]
            index += 1
        }
        l.*.items = items
        l.*.capacity = capacity
    }
    l.*.items[l.*.count] = text
    l.*.count += 1
}

pub fn sunshift(l: *StrList, text: Str) -> void {
    spush(l, text)
    var index = l.*.count - 1
    while index > 0 {
        l.*.items[index] = l.*.items[index - 1]
        index -= 1
    }
    l.*.items[0] = text
}

pub fn sappend(l: *StrList, other: StrList) -> void {
    var index: usize = 0
    while index < other.count {
        spush(l, other.items[index])
        index += 1
    }
}

pub fn scopy(l: StrList) -> StrList {
    var result = strList()
    sappend(&result, l)
    return result
}

pub fn shas(l: StrList, text: Str) -> bool {
    var index: usize = 0
    while index < l.count {
        if std.text.same(l.items[index], text) { return true }
        index += 1
    }
    return false
}

// The items of L with SEPARATOR between them (Perl's join).
pub fn sjoin(l: StrList, separator: Str) -> Str {
    var b = buf()
    var index: usize = 0
    while index < l.count {
        if index > 0 { add(&b, separator) }
        add(&b, l.items[index])
        index += 1
    }
    return done(b)
}

// L in Perl's default order (by bytes), stably, by merging.
pub fn ssort(l: *StrList) -> void {
    if l.*.count < 2 { return }
    const scratch: [*]Str = unsafe { @ptrFromInt([*]Str, s.alloc(l.*.count * @sizeOf(Str))) }
    mergeSort(l.*.items, scratch, 0, l.*.count)
}

fn mergeSort(items: [*]Str, scratch: [*]Str, start: usize, end: usize) -> void {
    if end - start < 2 { return }
    const middle = start + (end - start) / 2
    mergeSort(items, scratch, start, middle)
    mergeSort(items, scratch, middle, end)
    var left = start
    var right = middle
    var out = start
    while left < middle || right < end {
        if right >= end || (left < middle && !less(items[right], items[left])) {
            scratch[out] = items[left]
            left += 1
        } else {
            scratch[out] = items[right]
            right += 1
        }
        out += 1
    }
    var index = start
    while index < end {
        items[index] = scratch[index]
        index += 1
    }
}

pub fn ssorted(l: StrList) -> StrList {
    var result = scopy(l)
    ssort(&result)
    return result
}

// L without repeated items, the first of each kept (List::Util's uniq).
pub fn suniq(l: StrList) -> StrList {
    var result = strList()
    var seen = map()
    var index: usize = 0
    while index < l.count {
        if !has(&seen, l.items[index]) {
            set(&seen, l.items[index], 1)
            spush(&result, l.items[index])
        }
        index += 1
    }
    return result
}

// TEXT split at each SEPARATOR byte, trailing empty fields dropped
// (Perl's split on a one-character pattern).
pub fn splitByte(text: Str, separator: u8) -> StrList {
    var result = strList()
    var start: usize = 0
    var index: usize = 0
    while index <= text.length {
        if index == text.length || text[index] == separator {
            spush(&result, text[start..index])
            start = index + 1
        }
        index += 1
    }
    while result.count > 0 && result.items[result.count - 1].length == 0 { result.count -= 1 }
    return result
}

// TEXT split at runs of white space, a leading empty field dropped (Perl's
// split(/\s+/) also drops one at the start only when the text begins
// with white space... as awk's split(' ') does; see splitSpaceRegex).
pub fn splitWords(text: Str) -> StrList {
    var result = strList()
    var at: usize = 0
    while at < text.length {
        while at < text.length && isSpace(text[at]) { at += 1 }
        if at >= text.length { break }
        const start = at
        while at < text.length && !isSpace(text[at]) { at += 1 }
        spush(&result, text[start..at])
    }
    return result
}

// Perl's split(/\s+/, TEXT): a leading empty field when TEXT begins with
// white space, trailing empty fields dropped.
pub fn splitSpaceRegex(text: Str) -> StrList {
    var result = strList()
    if text.length > 0 && isSpace(text[0]) { spush(&result, "") }
    const words = splitWords(text)
    sappend(&result, words)
    return result
}

// ---------------------------------------------------------------------------
// Lists of pointers (as addresses).

pub const List = struct {
    items: [*]usize
    count: usize
    capacity: usize
}

pub fn list() -> List {
    const items: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc(4 * @sizeOf(usize))) }
    return List.{ .items = items, .count = 0, .capacity = 4 }
}

pub fn newList() -> *List {
    const l: *List = unsafe { @ptrFromInt(*List, s.alloc(@sizeOf(List))) }
    l.* = list()
    return l
}

pub fn push(l: *List, item: usize) -> void {
    if l.*.count == l.*.capacity {
        const capacity = l.*.capacity * 2
        const items: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc(capacity * @sizeOf(usize))) }
        var index: usize = 0
        while index < l.*.count {
            items[index] = l.*.items[index]
            index += 1
        }
        l.*.items = items
        l.*.capacity = capacity
    }
    l.*.items[l.*.count] = item
    l.*.count += 1
}

pub fn unshift(l: *List, item: usize) -> void {
    push(l, item)
    var index = l.*.count - 1
    while index > 0 {
        l.*.items[index] = l.*.items[index - 1]
        index -= 1
    }
    l.*.items[0] = item
}

pub fn append(l: *List, other: List) -> void {
    var index: usize = 0
    while index < other.count {
        push(l, other.items[index])
        index += 1
    }
}

pub fn copyList(l: List) -> List {
    var result = list()
    append(&result, l)
    return result
}

pub fn at(comptime T: type, l: List, index: usize) -> T {
    return unsafe { @ptrFromInt(T, l.items[index]) }
}

pub fn listHas(l: List, item: usize) -> bool {
    var index: usize = 0
    while index < l.count {
        if l.items[index] == item { return true }
        index += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Maps from strings, their keys kept in the order they came.

pub const Map = struct {
    keys: [*]Str
    values: [*]usize
    live: [*]bool
    count: usize
    capacity: usize
    // Open addressing: slot -> index + 1 (0 for empty).
    slots: [*]usize
    slotCount: usize
    size: usize
}

pub fn map() -> Map {
    var m = Map.{ .keys = undefined, .values = undefined, .live = undefined, .count = 0, .capacity = 0, .slots = undefined, .slotCount = 0, .size = 0 }
    grow(&m, 8)
    return m
}

pub fn newMap() -> *Map {
    const m: *Map = unsafe { @ptrFromInt(*Map, s.alloc(@sizeOf(Map))) }
    m.* = map()
    return m
}

fn hashOf(text: Str) -> usize {
    var h: u64 = 14695981039346656037
    for byte in text {
        h = (h ^ @intCast(u64, byte)) *% 1099511628211
    }
    return @intCast(usize, h >> 1)
}

fn grow(m: *Map, capacity: usize) -> void {
    const keys: [*]Str = unsafe { @ptrFromInt([*]Str, s.alloc(capacity * @sizeOf(Str))) }
    const values: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc(capacity * @sizeOf(usize))) }
    const live: [*]bool = unsafe { @ptrFromInt([*]bool, s.alloc(capacity)) }
    var index: usize = 0
    while index < m.*.count {
        keys[index] = m.*.keys[index]
        values[index] = m.*.values[index]
        live[index] = m.*.live[index]
        index += 1
    }
    m.*.keys = keys
    m.*.values = values
    m.*.live = live
    m.*.capacity = capacity
    const slotCount = capacity * 2
    const slots: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc(slotCount * @sizeOf(usize))) }
    index = 0
    while index < slotCount {
        slots[index] = 0
        index += 1
    }
    m.*.slots = slots
    m.*.slotCount = slotCount
    index = 0
    while index < m.*.count {
        var slot = hashOf(m.*.keys[index]) % slotCount
        while slots[slot] != 0 { slot = (slot + 1) % slotCount }
        slots[slot] = index + 1
        index += 1
    }
}

// The index of KEY's entry (live or not), or the count.
fn lookup(m: *const Map, key: Str) -> usize {
    var slot = hashOf(key) % m.*.slotCount
    while m.*.slots[slot] != 0 {
        const index = m.*.slots[slot] - 1
        if std.text.same(m.*.keys[index], key) { return index }
        slot = (slot + 1) % m.*.slotCount
    }
    return m.*.count
}

pub fn has(m: *const Map, key: Str) -> bool {
    const index = lookup(m, key)
    return index < m.*.count && m.*.live[index]
}

// The value at KEY, or 0 when there is none.
pub fn get(m: *const Map, key: Str) -> usize {
    const index = lookup(m, key)
    if index < m.*.count && m.*.live[index] { return m.*.values[index] }
    return 0
}

pub fn set(m: *Map, key: Str, value: usize) -> void {
    const index = lookup(m, key)
    if index < m.*.count {
        if !m.*.live[index] {
            m.*.live[index] = true
            m.*.size += 1
        }
        m.*.values[index] = value
        return
    }
    if m.*.count == m.*.capacity { grow(m, m.*.capacity * 2) }
    const at_ = m.*.count
    m.*.keys[at_] = key
    m.*.values[at_] = value
    m.*.live[at_] = true
    m.*.count += 1
    m.*.size += 1
    var slot = hashOf(key) % m.*.slotCount
    while m.*.slots[slot] != 0 { slot = (slot + 1) % m.*.slotCount }
    m.*.slots[slot] = at_ + 1
}

pub fn remove(m: *Map, key: Str) -> void {
    const index = lookup(m, key)
    if index < m.*.count && m.*.live[index] {
        m.*.live[index] = false
        m.*.size -= 1
    }
}

// The keys of M in the order they first came.
pub fn keys(m: *const Map) -> StrList {
    var result = strList()
    var index: usize = 0
    while index < m.*.count {
        if m.*.live[index] { spush(&result, m.*.keys[index]) }
        index += 1
    }
    return result
}

pub fn sortedKeys(m: *const Map) -> StrList {
    var result = keys(m)
    ssort(&result)
    return result
}

// Maps from strings to strings (the value an address of a Str).
pub fn setStr(m: *Map, key: Str, value: Str) -> void {
    const cell: *Str = unsafe { @ptrFromInt(*Str, s.alloc(@sizeOf(Str))) }
    cell.* = value
    set(m, key, @intFromPtr(cell))
}

pub fn getStr(m: *const Map, key: Str) -> Str {
    const address = get(m, key)
    if address == 0 { return undef() }
    const cell: *Str = unsafe { @ptrFromInt(*Str, address) }
    return cell.*
}

// ---------------------------------------------------------------------------
// Files.

// The text of the file at PATH; FOUND says whether it could be read.
pub fn readFile(path: Str, found: *bool) -> Str {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 {
        found.* = false
        return ""
    }
    found.* = true
    var status: [144]u8 = undefined
    const statted = std.linux.syscall2(SYS_fstat, @bitCast(usize, descriptor), @intFromPtr(&status))
    var size: usize = 0
    var index: usize = 0
    while index < 8 {
        size |= @intCast(usize, status[48 + index]) << @intCast(u6, index * 8)
        index += 1
    }
    const capacity = size + 1
    const data = s.alloc(capacity + 1)
    var length: usize = 0
    while length < capacity {
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    s.put8(data + length, 0)
    return s.bytes(data, length)
}

pub fn readWhole(path: Str) -> Str {
    var found = false
    const text = readFile(path, &found)
    if !found { die(c2("Cannot open ", path)) }
    return text
}

pub fn exists(path: Str) -> bool {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 { return false }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return true
}

pub fn writeFile(path: Str, text: Str) -> void { s.writeWhole(path, text) }

// TEXT written to PATH unless the file already holds it.
pub fn writeIfChanged(path: Str, text: Str) -> void {
    var found = false
    const old = readFile(path, &found)
    if found && std.text.same(old, text) { return }
    s.writeWhole(path, text)
}

// The last part of PATH (File::Basename's fileparse with no suffixes).
pub fn baseName(path: Str) -> Str { return s.baseName(path) }

// The last part of PATH without SUFFIX at its end.
pub fn baseNameWithout(path: Str, suffix: Str) -> Str {
    const name = s.baseName(path)
    if name.length > suffix.length && std.text.endsWith(name, suffix) { return name[0..name.length - suffix.length] }
    return name
}

pub fn dirName(path: Str) -> Str {
    var end = path.length
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    if end > 1 { end -= 1 }
    return path[0..end]
}

// ---------------------------------------------------------------------------
// The run.

pub fn say(text: Str) -> void { s.say(text) }

// MESSAGE on standard error, and the run ends (status 255, as Perl's die).
pub fn die(message: Str) -> void {
    s.say(message)
    if message.length == 0 || message[message.length - 1] != 10 { s.say("\n") }
    exit(255)
}

pub fn exit(status: usize) -> void {
    const ignored = std.linux.syscall1(SYS_exit_group, status)
}

// A child process: 0 in the child, its id in the parent.
pub fn fork() -> isize { return std.linux.syscall0(SYS_fork) }

// Waits for any child; its exit status, or -1 when there are none.
pub fn waitChild() -> i64 {
    var status: u32 = 0
    const pid = std.linux.syscall4(SYS_wait4, @bitCast(usize, @intCast(isize, -1)), @intFromPtr(&status), 0, 0)
    if pid < 0 { return -1 }
    return @intCast(i64, status)
}
