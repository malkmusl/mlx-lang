// Text for the inspector protocol generators: lists of strings joined as
// Python joins them, strings put together from parts, sorting, and the
// files they read and write (written only when changed, in directories
// made as needed).
const std = @import("std")
const s = @import("./support.mlx")

const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_read: usize = 0
const SYS_mkdir: usize = 83
const O_RDONLY: usize = 0

// ---------------------------------------------------------------------------
// Strings.

pub fn copyInto(address: usize, text: []const u8) -> void {
    const target: [*]u8 = unsafe { @ptrFromInt([*]u8, address) }
    var index: usize = 0
    while index < text.length {
        target[index] = text[index]
        index += 1
    }
}

// The PARTS one after the other.
pub fn cat(parts: []const []const u8) -> []const u8 {
    var total: usize = 0
    for part in parts { total += part.length }
    const at = s.alloc(total + 1)
    var done: usize = 0
    for part in parts {
        copyInto(at + done, part)
        done += part.length
    }
    s.put8(at + total, 0)
    return s.bytes(at, total)
}

pub fn c2(a: []const u8, b: []const u8) -> []const u8 { return s.join(a, b) }

pub fn c3(a: []const u8, b: []const u8, c: []const u8) -> []const u8 {
    const parts = [_][]const u8{ a, b, c }
    return cat(parts[0..])
}

pub fn c4(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> []const u8 {
    const parts = [_][]const u8{ a, b, c, d }
    return cat(parts[0..])
}

pub fn c5(a: []const u8, b: []const u8, c: []const u8, d: []const u8, e: []const u8) -> []const u8 {
    const parts = [_][]const u8{ a, b, c, d, e }
    return cat(parts[0..])
}

pub fn c6(a: []const u8, b: []const u8, c: []const u8, d: []const u8, e: []const u8, f: []const u8) -> []const u8 {
    const parts = [_][]const u8{ a, b, c, d, e, f }
    return cat(parts[0..])
}

pub fn c7(a: []const u8, b: []const u8, c: []const u8, d: []const u8, e: []const u8, f: []const u8, g: []const u8) -> []const u8 {
    const parts = [_][]const u8{ a, b, c, d, e, f, g }
    return cat(parts[0..])
}

pub fn c8(a: []const u8, b: []const u8, c: []const u8, d: []const u8, e: []const u8, f: []const u8, g: []const u8, h: []const u8) -> []const u8 {
    const parts = [_][]const u8{ a, b, c, d, e, f, g, h }
    return cat(parts[0..])
}

pub fn c9(a: []const u8, b: []const u8, c: []const u8, d: []const u8, e: []const u8, f: []const u8, g: []const u8, h: []const u8, i: []const u8) -> []const u8 {
    const parts = [_][]const u8{ a, b, c, d, e, f, g, h, i }
    return cat(parts[0..])
}

// TEXT with its first byte upper case (Python's text[:1].upper() + text[1:]).
pub fn upperFirst(text: []const u8) -> []const u8 {
    if text.length == 0 || text[0] < 97 || text[0] > 122 { return text }
    const at = s.alloc(text.length + 1)
    copyInto(at, text)
    s.put8(at, text[0] - 32)
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

pub fn lowerByte(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

// Whether FIRST sorts before SECOND (by bytes, as Python compares the
// code points of ASCII and UTF-8 text alike).
pub fn before(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

// TEXT without the whitespace at its end (Python's str.rstrip() on ASCII).
pub fn rstrip(text: []const u8) -> []const u8 {
    var end = text.length
    while end > 0 {
        const byte = text[end - 1]
        if byte == 32 || (byte >= 9 && byte <= 13) || (byte >= 28 && byte <= 31) {
            end -= 1
        } else {
            break
        }
    }
    return text[0..end]
}

// ---------------------------------------------------------------------------
// Lists of strings.

pub const List = struct {
    items: [*][]const u8
    count: usize
    capacity: usize
}

pub fn list() -> List {
    const items: [*][]const u8 = unsafe { @ptrFromInt([*][]const u8, s.alloc(8 * @sizeOf([]const u8))) }
    return List.{ .items = items, .count = 0, .capacity = 8 }
}

pub fn push(l: *List, text: []const u8) -> void {
    if l.*.count == l.*.capacity {
        const capacity = l.*.capacity * 2
        const items: [*][]const u8 = unsafe { @ptrFromInt([*][]const u8, s.alloc(capacity * @sizeOf([]const u8))) }
        var index: usize = 0
        while index < l.*.count {
            items[index] = l.*.items[index]
            index += 1
        }
        l.*.items = items
        l.*.capacity = capacity
    }
    l.*.items[l.*.count] = text
    l.*.count += 1
}

// Every item of OTHER pushed on L.
pub fn extend(l: *List, other: List) -> void {
    var index: usize = 0
    while index < other.count {
        push(l, other.items[index])
        index += 1
    }
}

pub fn contains(l: List, text: []const u8) -> bool {
    var index: usize = 0
    while index < l.count {
        if s.same(l.items[index], text) { return true }
        index += 1
    }
    return false
}

// The items of L with SEPARATOR between them (Python's SEPARATOR.join(L)).
pub fn joined(l: List, separator: []const u8) -> []const u8 {
    if l.count == 0 { return "" }
    var total: usize = separator.length * (l.count - 1)
    var index: usize = 0
    while index < l.count {
        total += l.items[index].length
        index += 1
    }
    const at = s.alloc(total + 1)
    var done: usize = 0
    index = 0
    while index < l.count {
        if index > 0 {
            copyInto(at + done, separator)
            done += separator.length
        }
        copyInto(at + done, l.items[index])
        done += l.items[index].length
        index += 1
    }
    s.put8(at + total, 0)
    return s.bytes(at, total)
}

// L's items in order, by insertion (it is short).
pub fn sort(l: *List) -> void {
    var index: usize = 1
    while index < l.*.count {
        const item = l.*.items[index]
        var at = index
        while at > 0 && before(item, l.*.items[at - 1]) {
            l.*.items[at] = l.*.items[at - 1]
            at -= 1
        }
        l.*.items[at] = item
        index += 1
    }
}

// L without the items that are empty (Python's [x for x in L if x]).
pub fn nonEmpty(l: List) -> List {
    var result = list()
    var index: usize = 0
    while index < l.count {
        if l.items[index].length > 0 { push(&result, l.items[index]) }
        index += 1
    }
    return result
}

// ---------------------------------------------------------------------------
// Files.

// The text of the file at PATH, or "" with FOUND false when it cannot be read.
pub fn readIfThere(path: []const u8, found: *bool) -> []const u8 {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 {
        found.* = false
        return ""
    }
    found.* = true
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return s.readWhole(path)
}

// The directory PATH and those above it, made where missing.
pub fn makeDirectories(path: []const u8) -> void {
    var end: usize = 1
    while end <= path.length {
        if end == path.length || path[end] == 47 {
            const name = s.join(path[0..end], "")
            const made = std.linux.syscall2(SYS_mkdir, @intFromPtr(name.pointer), 493)
        }
        end += 1
    }
}

// PATH joined to NAME (Python's os.path.join).
pub fn pathJoin(directory: []const u8, name: []const u8) -> []const u8 {
    if directory.length == 0 || directory[directory.length - 1] == 47 { return s.join(directory, name) }
    return c3(directory, "/", name)
}

// The directory part of PATH (Python's os.path.dirname).
pub fn dirName(path: []const u8) -> []const u8 {
    var end = path.length
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    var trimmed = end
    while trimmed > 1 && path[trimmed - 1] == 47 { trimmed -= 1 }
    return path[0..trimmed]
}

// TEXT written to PATH unless the file already holds it.
pub fn writeIfChanged(path: []const u8, text: []const u8) -> void {
    var found = false
    const old = readIfThere(path, &found)
    if found && s.same(old, text) { return }
    const directory = dirName(path)
    if directory.length > 0 { makeDirectories(directory) }
    s.writeWhole(path, text)
}
