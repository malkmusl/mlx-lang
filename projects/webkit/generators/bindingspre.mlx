// WebKit's preprocess-idls.pl: from all the IDL files at once, which
// files supplement which (partial interfaces and dictionaries, included
// mixins), the global objects' constructor attributes (written as
// partial interfaces of DOMWindow, WorkerGlobalScope and the others),
// and the headers listing every wrapper's IsoSubspace and every DOM
// constructor. It reads the files as the Perl does, with regular
// expressions over their text (comments and # lines taken out), not
// through the IDL parser.
const std = @import("std")
const r = @import("./bindingsrt.mlx")
const Str = r.Str

pub const Options = struct {
    defines: Str
    idlFileNamesList: Str
    supplementalDependencyFile: Str
    isoSubspacesHeaderFile: Str
    clientISOSubspacesHeaderFile: Str
    constructorsHeaderFile: Str
    // The partial interfaces, in the order of globalScopes.
    constructorsFiles: [9]Str
}

pub const globalScopeOptions = [9]Str{ "--windowConstructorsFile", "--workerGlobalScopeConstructorsFile", "--shadowRealmGlobalScopeConstructorsFile", "--dedicatedWorkerGlobalScopeConstructorsFile", "--serviceWorkerGlobalScopeConstructorsFile", "--sharedWorkerGlobalScopeConstructorsFile", "--workletGlobalScopeConstructorsFile", "--paintWorkletGlobalScopeConstructorsFile", "--audioWorkletGlobalScopeConstructorsFile" }
const globalScopeInterfaces = [9]Str{ "DOMWindow", "WorkerGlobalScope", "ShadowRealmGlobalScope", "DedicatedWorkerGlobalScope", "ServiceWorkerGlobalScope", "SharedWorkerGlobalScope", "WorkletGlobalScope", "PaintWorkletGlobalScope", "AudioWorkletGlobalScope" }
const globalContexts = [9]Str{ "Window", "Worker", "ShadowRealm", "DedicatedWorker", "ServiceWorker", "SharedWorker", "Worklet", "PaintWorklet", "AudioWorklet" }
const supportedGlobalContexts = "(Window,DedicatedWorker,ServiceWorker,SharedWorker,PaintWorklet,AudioWorklet,ShadowRealm)"

pub fn emptyOptions() -> Options {
    return Options.{ .defines = r.undef(), .idlFileNamesList = r.undef(), .supplementalDependencyFile = r.undef(), .isoSubspacesHeaderFile = r.undef(), .clientISOSubspacesHeaderFile = r.undef(), .constructorsHeaderFile = r.undef(), .constructorsFiles = [9]Str{ "", "", "", "", "", "", "", "", "" } }
}

// ---------------------------------------------------------------------------
// The regular expressions of the Perl, on a file's text.

fn spacesAt(text: Str, at: usize) -> usize {
    var end = at
    while end < text.length && std.ascii.isCWhitespace(text[end]) { end += 1 }
    return end - at
}

fn wordAt(text: Str, at: usize) -> usize {
    var end = at
    while end < text.length && r.isWord(text[end]) { end += 1 }
    return end - at
}

fn literalAt(text: Str, at: usize, literal: Str) -> bool {
    return at + literal.length <= text.length && std.text.same(text[at..at + literal.length], literal)
}

// The file's text as processIDL keeps it: no # lines, no comments.
fn processIDL(path: Str) -> Str {
    const raw = r.readWhole(path)
    var b = r.buf()
    var at: usize = 0
    while at < raw.length {
        var end = at
        while end < raw.length && raw[end] != 10 { end += 1 }
        if end < raw.length { end += 1 }
        const line = raw[at..end]
        // /^\s*#/ on the line.
        var first: usize = 0
        while first < line.length && std.ascii.isCWhitespace(line[first]) { first += 1 }
        if !(first < line.length && line[first] == 35) { r.add(&b, line) }
        at = end
    }
    const joined = r.done(b)
    // s/(?:\/\/[^\n]*\n)|(?:\/\*(?:[^\*]+|\*(?!\/))*\*\/)//g
    var c = r.buf()
    at = 0
    var start: usize = 0
    while at + 1 < joined.length {
        if joined[at] == 47 && joined[at + 1] == 47 {
            var end = at + 2
            while end < joined.length && joined[end] != 10 { end += 1 }
            if end < joined.length {
                r.add(&c, joined[start..at])
                at = end + 1
                start = at
                continue
            }
        } else if joined[at] == 47 && joined[at + 1] == 42 {
            var end = at + 2
            var closed = false
            while end + 1 < joined.length {
                if joined[end] == 42 && joined[end + 1] == 47 {
                    closed = true
                    break
                }
                end += 1
            }
            if closed {
                r.add(&c, joined[start..at])
                at = end + 2
                start = at
                continue
            }
        }
        at += 1
    }
    r.add(&c, joined[start..joined.length])
    return r.done(c)
}

// /partial\s+(interface|dictionary|namespace)\s+(\w+)/mg and the mixin form.
fn partialNames(text: Str) -> r.StrList {
    var names = r.strList()
    var at: usize = 0
    while at < text.length {
        const found = r.findFrom(text, "partial", at)
        if found >= text.length { break }
        var p = found + 7
        var matched = false
        const s1 = spacesAt(text, p)
        if s1 > 0 && literalAt(text, p + s1, "interface") {
            p += s1 + 9
            const s2 = spacesAt(text, p)
            if s2 > 0 && literalAt(text, p + s2, "mixin") {
                p += s2 + 5
                const s3 = spacesAt(text, p)
                const w = wordAt(text, p + s3)
                if s3 > 0 && w > 0 {
                    r.spush(&names, text[p + s3..p + s3 + w])
                    at = p + s3 + w
                    matched = true
                }
            }
        }
        if !matched { at = found + 1 }
    }
    at = 0
    while at < text.length {
        const found = r.findFrom(text, "partial", at)
        if found >= text.length { break }
        var p = found + 7
        var matched = false
        const s1 = spacesAt(text, p)
        if s1 > 0 {
            p += s1
            var keyword: usize = 0
            if literalAt(text, p, "interface") { keyword = 9 } else if literalAt(text, p, "dictionary") { keyword = 10 } else if literalAt(text, p, "namespace") { keyword = 9 }
            if keyword > 0 {
                p += keyword
                const s2 = spacesAt(text, p)
                const w = wordAt(text, p + s2)
                if s2 > 0 && w > 0 {
                    const name = text[p + s2..p + s2 + w]
                    if !std.text.same(name, "mixin") { r.spush(&names, name) }
                    at = p + s2 + w
                    matched = true
                }
            }
        }
        if !matched { at = found + 1 }
    }
    return names
}

// /\b(\w+)\s+includes\s+(\w+)\s*;/mg
fn includedInterfaces(text: Str, interfaceName: Str) -> r.StrList {
    var included = r.strList()
    var at: usize = 0
    while at < text.length {
        if r.isWord(text[at]) && (at == 0 || !r.isWord(text[at - 1])) {
            const w1 = wordAt(text, at)
            var p = at + w1
            const s1 = spacesAt(text, p)
            if s1 > 0 && literalAt(text, p + s1, "includes") {
                p += s1 + 8
                const s2 = spacesAt(text, p)
                const w2 = wordAt(text, p + s2)
                if s2 > 0 && w2 > 0 {
                    const name = text[p + s2..p + s2 + w2]
                    var q = p + s2 + w2
                    q += spacesAt(text, q)
                    if q < text.length && text[q] == 59 {
                        if !std.text.same(text[at..at + w1], interfaceName) {
                            r.die(r.cat([_]Str{ "Identifier on the left of the 'includes' statement should be ", interfaceName, " in ", interfaceName, ".idl, but found ", text[at..at + w1] }[0..]))
                        }
                        r.spush(&included, name)
                        at = q + 1
                        continue
                    }
                }
            }
            at += w1
            continue
        }
        at += 1
    }
    return included
}

// Whether TEXT has FIRST, white space, SECOND, white space and a word.
fn hasWordsThenWord(text: Str, first: Str, second: Str) -> bool {
    var at: usize = 0
    while true {
        const found = r.findFrom(text, first, at)
        if found >= text.length { return false }
        var p = found + first.length
        const s1 = spacesAt(text, p)
        if s1 > 0 && literalAt(text, p + s1, second) {
            p += s1 + second.length
            const s2 = spacesAt(text, p)
            if s2 > 0 && wordAt(text, p + s2) > 0 { return true }
        }
        at = found + 1
    }
    return false
}

fn isCallbackInterface(text: Str) -> bool { return hasWordsThenWord(text, "callback", "interface") }
fn isMixinInterface(text: Str) -> bool { return hasWordsThenWord(text, "interface", "mixin") }

// /iterable\s*<\s*\w+\s*/
fn containsIterable(text: Str) -> bool {
    var at: usize = 0
    while true {
        const found = r.findFrom(text, "iterable", at)
        if found >= text.length { return false }
        var p = found + 8
        p += spacesAt(text, p)
        if p < text.length && text[p] == 60 {
            p += 1
            p += spacesAt(text, p)
            if wordAt(text, p) > 0 { return true }
        }
        at = found + 1
    }
    return false
}

// /\b(callback interface|interface|namespace)\s+(\w+)/
fn containsInterfaceOrCallbackInterface(text: Str) -> bool {
    var at: usize = 0
    while at < text.length {
        if r.isWord(text[at]) && (at == 0 || !r.isWord(text[at - 1])) {
            var lengths = [3]usize{ 0, 0, 0 }
            if literalAt(text, at, "callback interface") { lengths[0] = 18 }
            if literalAt(text, at, "interface") { lengths[1] = 9 }
            if literalAt(text, at, "namespace") { lengths[2] = 9 }
            for length in lengths {
                if length > 0 {
                    const s1 = spacesAt(text, at + length)
                    if s1 > 0 && wordAt(text, at + length + s1) > 0 { return true }
                }
            }
        }
        at += 1
    }
    return false
}

// /\s+const[\s\w]+=\s+[\w]+;/
fn containsConstants(text: Str) -> bool {
    var at: usize = 1
    while true {
        const found = r.findFrom(text, "const", at)
        if found >= text.length { return false }
        if std.ascii.isCWhitespace(text[found - 1]) {
            var p = found + 5
            const start = p
            while p < text.length && (std.ascii.isCWhitespace(text[p]) || r.isWord(text[p])) { p += 1 }
            if p > start && p < text.length && text[p] == 61 {
                p += 1
                const s1 = spacesAt(text, p)
                const w = wordAt(text, p + s1)
                if s1 > 0 && w > 0 && p + s1 + w < text.length && text[p + s1 + w] == 59 { return true }
            }
        }
        at = found + 1
    }
    return false
}

// Whether a ")" comes after AT before any "(" (the lookahead
// (?![^()]*\)) negated).
fn closesParenthesis(text: Str, at: usize) -> bool {
    var p = at
    while p < text.length {
        if text[p] == 41 { return true }
        if text[p] == 40 { return false }
        p += 1
    }
    return false
}

// getInterfaceExtendedAttributesFromIDL: the attributes of the [ ... ]
// before the interface, as a map of strings.
fn interfaceExtendedAttributes(text: Str) -> *r.Map {
    const attributes = r.newMap()
    const open = r.findByte(text, 91)
    if open >= text.length { return attributes }
    // The last "]" after it followed by \s+(callback interface|interface|namespace)\s+\w+.
    var close = text.length
    var at = text.length
    while at > open + 1 {
        at -= 1
        if text[at] != 93 { continue }
        const s1 = spacesAt(text, at + 1)
        if s1 == 0 { continue }
        const p = at + 1 + s1
        var length: usize = 0
        if literalAt(text, p, "callback interface") {
            const s2 = spacesAt(text, p + 18)
            if s2 > 0 && wordAt(text, p + 18 + s2) > 0 { length = 18 }
        }
        if length == 0 && (literalAt(text, p, "interface") || literalAt(text, p, "namespace")) {
            const s2 = spacesAt(text, p + 9)
            if s2 > 0 && wordAt(text, p + 9 + s2) > 0 { length = 9 }
        }
        if length > 0 {
            close = at
            break
        }
    }
    if close == text.length { return attributes }
    var parameters = text[open + 1..close]
    if r.hasByte(parameters, 125) {
        // (split '}', $1)[-1]: the last field that is not empty at the end.
        var end = parameters.length
        while end > 0 && parameters[end - 1] == 125 { end -= 1 }
        var start = end
        while start > 0 && parameters[start - 1] != 125 { start -= 1 }
        parameters = parameters[start..end]
        const bracket = r.findByte(parameters, 91)
        if bracket < parameters.length { parameters = parameters[bracket + 1..parameters.length] } else { parameters = parameters[0..parameters.length] }
    }
    // split(m/,(?![^()]*\))/, ...)
    var parts = r.strList()
    var start: usize = 0
    var index: usize = 0
    while index <= parameters.length {
        if index == parameters.length || (parameters[index] == 44 && !closesParenthesis(parameters, index + 1)) {
            r.spush(&parts, parameters[start..index])
            start = index + 1
        }
        index += 1
    }
    while parts.count > 0 && parts.items[parts.count - 1].length == 0 { parts.count -= 1 }
    index = 0
    while index < parts.count {
        const keyValue = r.splitByte(parts.items[index], 61)
        if keyValue.count > 0 {
            const key = r.trim(keyValue.items[0])
            if key.length > 0 {
                var value: Str = "VALUE_IS_MISSING"
                if keyValue.count > 1 { value = r.trim(keyValue.items[1]) }
                r.setStr(attributes, key, value)
            }
        }
        index += 1
    }
    return attributes
}

// ---------------------------------------------------------------------------
// Constructor attributes.

fn isConstructorAttributeName(name: Str) -> bool {
    const names = [_]Str{ "Conditional", "EnabledByDeprecatedGlobalSetting", "EnabledForWorld", "EnabledForGlobalObject", "EnabledBySetting", "SecureContext", "PrivateIdentifier", "PublicIdentifier", "DisabledByQuirk", "EnabledByQuirk", "EnabledForContext", "LegacyFactoryFunctionEnabledBySetting" }
    for n in names {
        if std.text.same(n, name) { return true }
    }
    return false
}

fn generateConstructorAttributes(interfaceName: Str, attributes: *r.Map, globalContext: Str, windowAliases: *Str) -> Str {
    if r.truthy(r.getStr(attributes, "ConditionalForWorker")) && (std.text.same(globalContext, "Worker") || std.text.same(globalContext, "DedicatedWorker")) {
        const conditionalForWorker = r.getStr(attributes, "ConditionalForWorker")
        var existing = r.getStr(attributes, "Conditional")
        if r.truthy(existing) { existing = r.c3(existing, "&", conditionalForWorker) } else { existing = conditionalForWorker }
        r.setStr(attributes, "Conditional", existing)
    }
    if std.text.same(globalContext, "ShadowRealm") && std.text.same(r.getStr(attributes, "Exposed"), "*") {
        var enabledBySetting: Str = "WebAPIsInShadowRealmEnabled"
        const existing = r.getStr(attributes, "EnabledBySetting")
        if r.truthy(existing) { enabledBySetting = r.c3(enabledBySetting, "&", existing) }
        r.setStr(attributes, "EnabledBySetting", enabledBySetting)
    }
    var code = r.buf()
    r.add(&code, "    ")
    var list = r.strList()
    const names = r.sortedKeys(attributes)
    var index: usize = 0
    while index < names.count {
        const name = names.items[index]
        if isConstructorAttributeName(name) {
            const v = r.getStr(attributes, name)
            if std.text.same(v, "VALUE_IS_MISSING") { r.spush(&list, name) } else { r.spush(&list, r.c3(name, "=", v)) }
        }
        index += 1
    }
    var prefix: Str = ""
    if list.count > 0 { prefix = r.c3("[", r.sjoin(list, ", "), "] ") }
    r.add(&code, prefix)
    var name = interfaceName
    if r.truthy(r.getStr(attributes, "InterfaceName")) { name = r.getStr(attributes, "InterfaceName") }
    r.add(&code, r.cat([_]Str{ "attribute ", interfaceName, "Constructor ", name, ";\n" }[0..]))
    if r.truthy(r.getStr(attributes, "LegacyFactoryFunction")) {
        var constructorName = r.getStr(attributes, "LegacyFactoryFunction")
        const parenthesis = r.findByte(constructorName, 40)
        constructorName = constructorName[0..parenthesis]
        r.add(&code, "    ")
        r.add(&code, prefix)
        r.add(&code, r.cat([_]Str{ "attribute ", interfaceName, "LegacyFactoryFunctionConstructor ", constructorName, ";\n" }[0..]))
    }
    windowAliases.* = ""
    if r.truthy(r.getStr(attributes, "LegacyWindowAlias")) {
        var v = r.getStr(attributes, "LegacyWindowAlias")
        if v[0] == 40 { v = r.substrInner(v, 1, 1) }
        const aliases = r.splitByte(v, 44)
        var b = r.buf()
        var a: usize = 0
        while a < aliases.count {
            r.add(&b, "    ")
            r.add(&b, prefix)
            r.add(&b, r.cat([_]Str{ "attribute ", interfaceName, "Constructor ", aliases.items[a], "; // Legacy Window alias.\n" }[0..]))
            a += 1
        }
        windowAliases.* = r.done(b)
    }
    return r.done(code)
}

// ---------------------------------------------------------------------------
// The run.

pub fn run(o: Options) -> void {
    if !r.isDef(o.supplementalDependencyFile) { r.die("Must specify an output file using --supplementalDependencyFile.") }
    const listing = r.readWhole(o.idlFileNamesList)
    var lineAt: usize = 0
    var fileNames = r.map()
    while lineAt < listing.length {
        var end = lineAt
        while end < listing.length && listing[end] != 10 { end += 1 }
        var line = listing[lineAt..end]
        if line.length > 0 && line[line.length - 1] == 13 { line = line[0..line.length - 1] }
        r.set(&fileNames, line, 1)
        lineAt = end + 1
    }
    const paths = r.sortedKeys(&fileNames)

    var interfaceNameToPath = r.map()
    var index: usize = 0
    while index < paths.count {
        r.setStr(&interfaceNameToPath, r.baseNameWithout(paths.items[index], ".idl"), paths.items[index])
        index += 1
    }

    // Path -> list of names (addresses of StrLists).
    var supplementalDependencies = r.map()
    var supplementals = r.map()
    var scopeCode: [9]r.Buf = undefined
    var g: usize = 0
    while g < 9 {
        scopeCode[g] = r.buf()
        g += 1
    }
    var iso = r.buf()
    r.add(&iso, "#include <wtf/FastMalloc.h>\n#include <wtf/Noncopyable.h>\n\n#pragma once\n\nnamespace WebCore {\nusing namespace JSC;\n\nclass DOMIsoSubspaces {\n    WTF_MAKE_NONCOPYABLE(DOMIsoSubspaces);\n    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(DOMIsoSubspaces);\npublic:\n    DOMIsoSubspaces() = default;\n")
    var clientIso = r.buf()
    r.add(&clientIso, "#include <wtf/FastMalloc.h>\n#include <wtf/Noncopyable.h>\n\n#pragma once\n\nnamespace WebCore {\nusing namespace JSC;\n\nclass DOMClientIsoSubspaces {\n    WTF_MAKE_NONCOPYABLE(DOMClientIsoSubspaces);\n    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(DOMClientIsoSubspaces);\npublic:\n    DOMClientIsoSubspaces() = default;\n")
    var constructors = r.buf()
    r.add(&constructors, "#include <wtf/FastMalloc.h>\n#include <wtf/Noncopyable.h>\n#include <JavaScriptCore/WriteBarrier.h>\n\n#pragma once\n\nnamespace WebCore {\n\nenum class DOMConstructorID : uint16_t {\n")
    var constructorCount: u64 = 0

    index = 0
    while index < paths.count {
        const path = paths.items[index]
        index += 1
        const text = processIDL(path)
        const partials = partialNames(text)
        if partials.count > 0 {
            const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.alloc(@sizeOf(r.StrList))) }
            l.* = partials
            r.set(&supplementalDependencies, path, @intFromPtr(l))
            continue
        }
        const empty: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.alloc(@sizeOf(r.StrList))) }
        empty.* = r.strList()
        r.set(&supplementals, path, @intFromPtr(empty))
        if !containsInterfaceOrCallbackInterface(text) { continue }
        const interfaceName = r.baseNameWithout(path, ".idl")
        const included = includedInterfaces(text, interfaceName)
        var i: usize = 0
        while i < included.count {
            const includedPath = r.getStr(&interfaceNameToPath, included.items[i])
            if !r.isDef(includedPath) { r.die(r.c2("Could not find a the IDL file where the following included interface is defined: ", included.items[i])) }
            if r.has(&supplementalDependencies, includedPath) {
                const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.get(&supplementalDependencies, includedPath)) }
                r.spush(l, interfaceName)
            } else {
                const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.alloc(@sizeOf(r.StrList))) }
                l.* = r.strList()
                r.spush(l, interfaceName)
                r.set(&supplementalDependencies, includedPath, @intFromPtr(l))
            }
            i += 1
        }
        if isMixinInterface(text) { continue }
        const isCallback = isCallbackInterface(text)
        if !isCallback {
            r.add(&iso, r.c3("    std::unique_ptr<IsoSubspace> m_subspaceFor", interfaceName, ";\n"))
            r.add(&clientIso, r.c3("    std::unique_ptr<GCClient::IsoSubspace> m_clientSubspaceFor", interfaceName, ";\n"))
            if containsIterable(text) {
                r.add(&iso, r.c3("    std::unique_ptr<IsoSubspace> m_subspaceFor", interfaceName, "Iterator;\n"))
                r.add(&clientIso, r.c3("    std::unique_ptr<GCClient::IsoSubspace> m_clientSubspaceFor", interfaceName, "Iterator;\n"))
            }
        }
        const attributes = interfaceExtendedAttributes(text)
        if !r.truthy(r.getStr(attributes, "LegacyNoInterfaceObject")) && (!isCallback || containsConstants(text)) {
            var exposed = r.getStr(attributes, "Exposed")
            if !r.truthy(exposed) { r.die(r.c2("ERROR: No [Exposed] extended attribute specified for interface in ", path)) }
            if std.text.same(exposed, "*") { exposed = supportedGlobalContexts }
            if exposed[0] == 40 { exposed = r.substrInner(exposed, 1, 1) }
            var exposedEnabledBySetting = r.map()
            const exposedSetting = r.getStr(attributes, "ExposedEnabledBySetting")
            if r.truthy(exposedSetting) {
                // /^(\w+)\|(\w+)$/
                const bar = r.findByte(exposedSetting, 124)
                if bar < exposedSetting.length && bar > 0 && bar + 1 < exposedSetting.length {
                    var allWords = true
                    var k: usize = 0
                    while k < exposedSetting.length {
                        if k != bar && !r.isWord(exposedSetting[k]) { allWords = false }
                        k += 1
                    }
                    if allWords { r.setStr(&exposedEnabledBySetting, exposedSetting[0..bar], exposedSetting[bar + 1..exposedSetting.length]) }
                }
            }
            const contexts = r.splitByte(exposed, 44)
            var c: usize = 0
            while c < contexts.count {
                const context = contexts.items[c]
                c += 1
                // A copy of the attributes for this context.
                const contextAttributes = r.newMap()
                const names = r.keys(attributes)
                var k: usize = 0
                while k < names.count {
                    r.setStr(contextAttributes, names.items[k], r.getStr(attributes, names.items[k]))
                    k += 1
                }
                const setting = r.getStr(&exposedEnabledBySetting, context)
                if r.truthy(setting) {
                    const existing = r.getStr(contextAttributes, "EnabledBySetting")
                    r.setStr(contextAttributes, "EnabledBySetting", if r.truthy(existing) { r.c3(setting, "&", existing) } else { setting })
                }
                var aliases: Str = ""
                const code = generateConstructorAttributes(interfaceName, contextAttributes, context, &aliases)
                var which: usize = 9
                g = 0
                while g < 9 {
                    if std.text.same(context, globalContexts[g]) { which = g }
                    g += 1
                }
                if which == 9 { r.die(r.cat([_]Str{ "Unsupported global context '", context, "' used in [Exposed] at ", path }[0..])) }
                r.add(&scopeCode[which], code)
                if which == 0 && aliases.length > 0 { r.add(&scopeCode[which], aliases) }
            }
        }
        r.add(&constructors, r.c3("    ", interfaceName, ",\n"))
        constructorCount += 1
        if r.truthy(r.getStr(attributes, "LegacyFactoryFunction")) {
            r.add(&constructors, r.c3("    ", interfaceName, "LegacyFactory,\n"))
            constructorCount += 1
        }
    }

    // The partial interfaces of the global objects.
    g = 0
    while g < 9 {
        const destination = o.constructorsFiles[g]
        r.writeIfChanged(destination, r.cat([_]Str{ "partial interface ", globalScopeInterfaces[g], " {\n", r.done(scopeCode[g]), "};\n" }[0..]))
        if r.isDef(r.getStr(&interfaceNameToPath, globalScopeInterfaces[g])) {
            const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.alloc(@sizeOf(r.StrList))) }
            l.* = r.strList()
            r.spush(l, globalScopeInterfaces[g])
            r.set(&supplementalDependencies, destination, @intFromPtr(l))
        }
        g += 1
    }

    if r.isDef(o.isoSubspacesHeaderFile) {
        r.add(&iso, "};\n} // namespace WebCore\n")
        r.writeIfChanged(o.isoSubspacesHeaderFile, r.done(iso))
    }
    if r.isDef(o.clientISOSubspacesHeaderFile) {
        r.add(&clientIso, "};\n} // namespace WebCore\n")
        r.writeIfChanged(o.clientISOSubspacesHeaderFile, r.done(clientIso))
    }
    if r.isDef(o.constructorsHeaderFile) {
        r.add(&constructors, "};\n\nstatic constexpr unsigned numberOfDOMConstructors = ")
        r.add(&constructors, r.decimal(constructorCount))
        r.add(&constructors, ";\n\nclass DOMConstructors {\n    WTF_MAKE_NONCOPYABLE(DOMConstructors);\n    WTF_DEPRECATED_MAKE_FAST_ALLOCATED(DOMConstructors);\npublic:\n    using ConstructorArray = std::array<JSC::WriteBarrier<JSC::JSObject>, numberOfDOMConstructors>;\n    DOMConstructors() = default;\n    ConstructorArray& array() { return m_array; }\n    const ConstructorArray& array() const { return m_array; }\n\nprivate:\n    ConstructorArray m_array { };\n};\n\n} // namespace WebCore\n")
        r.writeIfChanged(o.constructorsHeaderFile, r.done(constructors))
    }

    // Partial interfaces and includes resolved.
    const supplementing = r.sortedKeys(&supplementalDependencies)
    index = 0
    while index < supplementing.count {
        const path = supplementing.items[index]
        const bases: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.get(&supplementalDependencies, path)) }
        var b: usize = 0
        while b < bases.*.count {
            const target = r.getStr(&interfaceNameToPath, bases.*.items[b])
            if !r.truthy(target) { r.die(r.cat([_]Str{ bases.*.items[b], ".idl not found, but it is supplemented by ", path }[0..])) }
            if !r.has(&supplementals, target) {
                const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.alloc(@sizeOf(r.StrList))) }
                l.* = r.strList()
                r.set(&supplementals, target, @intFromPtr(l))
            }
            const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.get(&supplementals, target)) }
            r.spush(l, path)
            b += 1
        }
        index += 1
    }
    var dependencies = r.buf()
    const targets = r.sortedKeys(&supplementals)
    index = 0
    while index < targets.count {
        const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.get(&supplementals, targets.items[index])) }
        r.add(&dependencies, targets.items[index])
        r.add(&dependencies, " ")
        r.add(&dependencies, r.sjoin(l.*, " "))
        r.add(&dependencies, "\n")
        index += 1
    }
    r.writeIfChanged(o.supplementalDependencyFile, r.done(dependencies))
}
