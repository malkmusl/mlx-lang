// The grammars of process-css-properties.py: the BNF of the CSS
// specifications (with WebKit's `@(...)` annotations) read by the
// script's lexer and state machine into nodes, the nodes made terms
// (MatchOne, MatchAllOrdered, Optional, repetitions, references to
// builtins or shared rules, keywords, literals, functions), the terms
// written back as the script's str() writes them, and the fixups that
// replace references by the shared rules and `<<values>>` by the
// property's values.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")

// ---------------------------------------------------------------------------
// Lists of pointers (addresses).

pub const Refs = struct {
    items: [*]usize
    count: usize
    capacity: usize
}

pub fn refs() -> Refs {
    const items: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc(8 * 8)) }
    return Refs.{ .items = items, .count = 0, .capacity = 8 }
}

pub fn push(l: *Refs, address: usize) -> void {
    if l.*.count == l.*.capacity {
        const capacity = l.*.capacity * 2
        const items: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc(capacity * 8)) }
        var index: usize = 0
        while index < l.*.count {
            items[index] = l.*.items[index]
            index += 1
        }
        l.*.items = items
        l.*.capacity = capacity
    }
    l.*.items[l.*.count] = address
    l.*.count += 1
}

pub fn has(l: Refs, address: usize) -> bool {
    var index: usize = 0
    while index < l.count {
        if l.items[index] == address { return true }
        index += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Names (Name.convert_name_to_id).

pub fn nameToId(name: []const u8) -> []const u8 {
    if s.same(name, "url") { return "URL" }
    if s.same(name, "-infinity") { return "NegativeInfinity" }
    var result = c.buf()
    var index: usize = 0
    while index < name.length {
        const byte = name[index]
        if index == 0 && byte != 45 {
            c.addByte(&result, c.upperByte(byte))
            index += 1
        } else if byte == 45 && index + 1 < name.length && name[index + 1] != 10 {
            c.addByte(&result, c.upperByte(name[index + 1]))
            index += 2
        } else {
            c.addByte(&result, byte)
            index += 1
        }
    }
    const converted = c.contents(&result)
    var plain = c.buf()
    for byte in converted {
        if byte == 46 {
            c.addByte(&plain, 95)
        } else if byte != 40 && byte != 41 {
            c.addByte(&plain, byte)
        }
    }
    return c.contents(&plain)
}

pub fn lowerFirst(text: []const u8) -> []const u8 {
    if text.length == 0 { return text }
    var one: [1]u8 = undefined
    one[0] = t.lowerByte(text[0])
    return s.join(one[0..1], text[1..text.length])
}

pub fn upperFirst(text: []const u8) -> []const u8 { return t.upperFirst(text) }

// ---------------------------------------------------------------------------
// The parse tree (BNFGroupingNode, BNFFunctionNode, BNFReferenceNode and its
// attributes, BNFKeywordNode, BNFLiteralNode, BNFRepetitionModifier,
// BNFAnnotation and its directives: one struct for them all).

pub const N_GROUP: u8 = 1
pub const N_FUNCTION: u8 = 2
pub const N_REFERENCE: u8 = 3
pub const N_KEYWORD: u8 = 4
pub const N_LITERAL: u8 = 5
pub const N_STRING_ATTRIBUTE: u8 = 6
pub const N_RANGE_ATTRIBUTE: u8 = 7
pub const N_REPETITION: u8 = 8
pub const N_ANNOTATION: u8 = 9
pub const N_DIRECTIVE: u8 = 10

pub const G_ALL_ORDERED: u8 = 0
pub const G_ONE: u8 = 1
pub const G_ALL_ANY_ORDER: u8 = 2
pub const G_ONE_OR_MORE_ANY_ORDER: u8 = 3

// BNFNodeMultiplier.Kind (0 for none).
pub const M_ZERO_OR_ONE: u8 = 1
pub const M_SPACE_ZERO_OR_MORE: u8 = 2
pub const M_SPACE_ONE_OR_MORE: u8 = 3
pub const M_SPACE_EXACT: u8 = 4
pub const M_SPACE_AT_LEAST: u8 = 5
pub const M_SPACE_BETWEEN: u8 = 6
pub const M_COMMA_ONE_OR_MORE: u8 = 7
pub const M_COMMA_EXACT: u8 = 8
pub const M_COMMA_AT_LEAST: u8 = 9
pub const M_COMMA_BETWEEN: u8 = 10

// BNFRepetitionModifier.Kind.
const R_EXACT: u8 = 1
const R_AT_LEAST: u8 = 2
const R_BETWEEN: u8 = 3

pub const Node = struct {
    kind: u8
    groupKind: u8
    // Members of a grouping, attributes of a reference, directives of an annotation.
    members: Refs
    isInitial: bool
    isInternal: bool
    isFunctionReference: bool
    // A keyword, literal, function, reference, attribute or directive name.
    name: []const u8
    // The values of a string attribute or a directive.
    values: t.List
    // A range attribute's ends, as written.
    rangeMin: []const u8
    rangeMax: []const u8
    // A repetition modifier.
    repetitionKind: u8
    repetitionMin: i64
    repetitionMax: i64
    // The node's multiplier.
    multiplierKind: u8
    multiplierMin: i64
    multiplierMax: i64
    multiplierAnnotation: ?*Node
    annotation: ?*Node
    // A function's parameters, a grouping node.
    parameterGroup: ?*Node
}

fn node(kind: u8) -> *Node {
    const n: *Node = unsafe { @ptrFromInt(*Node, s.alloc(@sizeOf(Node))) }
    n.*.kind = kind
    n.*.groupKind = G_ALL_ORDERED
    n.*.members = refs()
    n.*.isInitial = false
    n.*.isInternal = false
    n.*.isFunctionReference = false
    n.*.name = "None"
    n.*.values = t.list()
    n.*.rangeMin = "None"
    n.*.rangeMax = "None"
    n.*.repetitionKind = 0
    n.*.repetitionMin = 0
    n.*.repetitionMax = 0
    n.*.multiplierKind = 0
    n.*.multiplierMin = 0
    n.*.multiplierMax = 0
    n.*.multiplierAnnotation = null
    n.*.annotation = null
    n.*.parameterGroup = null
    return n
}

pub fn nodeAt(l: Refs, index: usize) -> *Node { return unsafe { @ptrFromInt(*Node, l.items[index]) } }

// ---------------------------------------------------------------------------
// The lexer (BNFLexer): the token kinds in the order the script tries them.

const T_FLOAT: u8 = 1
const T_INT: u8 = 2
const T_LPAREN: u8 = 3
const T_RPAREN: u8 = 4
const T_LBRACE: u8 = 5
const T_RBRACE: u8 = 6
const T_LSQUARE: u8 = 7
const T_RSQUARE: u8 = 8
const T_LTLT: u8 = 9
const T_GTGT: u8 = 10
const T_LT: u8 = 11
const T_GT: u8 = 12
const T_SQUOTE: u8 = 13
const T_ATPAREN: u8 = 14
const T_HASH: u8 = 15
const T_PLUS: u8 = 16
const T_STAR: u8 = 17
const T_NOT: u8 = 18
const T_QMARK: u8 = 19
const T_OROR: u8 = 20
const T_OR: u8 = 21
const T_ANDAND: u8 = 22
const T_COMMA: u8 = 23
const T_SLASH: u8 = 24
const T_EQUAL: u8 = 25
const T_FUNC: u8 = 26
const T_ID: u8 = 27
const T_WHITESPACE: u8 = 28
const T_ILLEGAL: u8 = 29
const T_EOF: u8 = 30

const Token = struct {
    kind: u8
    value: []const u8
}

fn isIdStart(byte: u8) -> bool { return byte == 95 || byte == 45 || (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) }
fn isIdByte(byte: u8) -> bool { return isIdStart(byte) || s.isDigit(byte) }
fn isWhite(byte: u8) -> bool { return byte == 32 || (byte >= 9 && byte <= 13) || (byte >= 28 && byte <= 31) }

// The token at AT of DATA (its kind, its length in LENGTH).
fn lexOne(data: []const u8, at: usize, length: *usize) -> u8 {
    const byte = data[at]
    const rest = data.length - at
    // FLOAT r'\-?\d+\.\d+' and INT r'\-?\d+'.
    var digits = at
    if byte == 45 { digits += 1 }
    var end = digits
    while end < data.length && s.isDigit(data[end]) { end += 1 }
    if end > digits {
        if end + 1 < data.length && data[end] == 46 && s.isDigit(data[end + 1]) {
            var fraction = end + 1
            while fraction < data.length && s.isDigit(data[fraction]) { fraction += 1 }
            length.* = fraction - at
            return T_FLOAT
        }
        length.* = end - at
        return T_INT
    }
    length.* = 1
    if byte == 40 { return T_LPAREN }
    if byte == 41 { return T_RPAREN }
    if byte == 123 { return T_LBRACE }
    if byte == 125 { return T_RBRACE }
    if byte == 91 { return T_LSQUARE }
    if byte == 93 { return T_RSQUARE }
    if rest >= 2 && byte == 60 && data[at + 1] == 60 {
        length.* = 2
        return T_LTLT
    }
    if rest >= 2 && byte == 62 && data[at + 1] == 62 {
        length.* = 2
        return T_GTGT
    }
    if byte == 60 { return T_LT }
    if byte == 62 { return T_GT }
    if byte == 39 { return T_SQUOTE }
    if rest >= 2 && byte == 64 && data[at + 1] == 40 {
        length.* = 2
        return T_ATPAREN
    }
    if byte == 35 { return T_HASH }
    if byte == 43 { return T_PLUS }
    if byte == 42 { return T_STAR }
    if byte == 33 { return T_NOT }
    if byte == 63 { return T_QMARK }
    if rest >= 2 && byte == 124 && data[at + 1] == 124 {
        length.* = 2
        return T_OROR
    }
    if byte == 124 { return T_OR }
    if rest >= 2 && byte == 38 && data[at + 1] == 38 {
        length.* = 2
        return T_ANDAND
    }
    if byte == 44 { return T_COMMA }
    if byte == 47 { return T_SLASH }
    if byte == 61 { return T_EQUAL }
    if isIdStart(byte) {
        var idEnd = at + 1
        while idEnd < data.length && isIdByte(data[idEnd]) { idEnd += 1 }
        if idEnd < data.length && data[idEnd] == 40 {
            length.* = idEnd + 1 - at
            return T_FUNC
        }
        length.* = idEnd - at
        return T_ID
    }
    if isWhite(byte) {
        var whiteEnd = at + 1
        while whiteEnd < data.length && isWhite(data[whiteEnd]) { whiteEnd += 1 }
        length.* = whiteEnd - at
        return T_WHITESPACE
    }
    return T_ILLEGAL
}

// ---------------------------------------------------------------------------
// The parser (BNFParser): a stack of states, each with its node and the
// node that will own it.

const S_UNKNOWN_GROUPING_INITIAL: u8 = 1
const S_UNKNOWN_GROUPING_SEEN_TERM: u8 = 2
const S_KNOWN_ORDERED_GROUPING: u8 = 3
const S_KNOWN_COMBINATOR_GROUPING_TERM_REQUIRED: u8 = 4
const S_KNOWN_COMBINATOR_GROUPING_COMBINATOR_OR_CLOSE_REQUIRED: u8 = 5
const S_INTERNAL_REFERENCE_INITIAL: u8 = 6
const S_INTERNAL_REFERENCE_SEEN_ID: u8 = 7
const S_REFERENCE_INITIAL: u8 = 8
const S_REFERENCE_SEEN_QUOTE_OPEN: u8 = 9
const S_REFERENCE_SEEN_QUOTE_AND_ID: u8 = 10
const S_REFERENCE_SEEN_FUNCTION_OPEN: u8 = 11
const S_REFERENCE_SEEN_ID_OR_FUNCTION: u8 = 12
const S_REFERENCE_STRING_ATTRIBUTE_INITIAL: u8 = 13
const S_REFERENCE_STRING_ATTRIBUTE_SEEN_EQUAL: u8 = 14
const S_REFERENCE_STRING_ATTRIBUTE_SEEN_VALUE: u8 = 15
const S_REFERENCE_RANGE_ATTRIBUTE_INITIAL: u8 = 16
const S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MIN: u8 = 17
const S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MIN_AND_COMMA: u8 = 18
const S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MAX: u8 = 19
const S_REPETITION_MODIFIER_INITIAL: u8 = 20
const S_REPETITION_MODIFIER_SEEN_MIN: u8 = 21
const S_REPETITION_MODIFIER_SEEN_MIN_AND_COMMA: u8 = 22
const S_REPETITION_MODIFIER_SEEN_MAX: u8 = 23
const S_QUOTED_LITERAL_INITIAL: u8 = 24
const S_QUOTED_LITERAL_SEEN_ID: u8 = 25
const S_ANNOTATION_INITIAL: u8 = 26
const S_ANNOTATION_SEEN_ID: u8 = 27
const S_ANNOTATION_SEEN_EQUAL_OR_COMMA: u8 = 28
const S_ANNOTATION_SEEN_VALUE: u8 = 29
const S_DONE: u8 = 30

const State = struct {
    state: u8
    node: *Node
    // The owner; for an annotation, whether it is the owner's multiplier.
    owner: ?*Node
    ownerMultiplier: bool
}

const STACK_SIZE: usize = 256
var stack: [*]State = undefined
var depth: usize = 0
var multiplierTarget: ?*Node = null
// The annotation's target: a node, or (annotationOnMultiplier) its multiplier.
var annotationTarget: ?*Node = null
var annotationOnMultiplier: bool = false
var parsingPointer: [*]const u8 = undefined
var parsingLength: usize = 0

fn unexpected(token: Token) -> void {
    s.fail(t.c5("Unexpected token '", token.value, "' found while parsing '", parsingPointer[0..parsingLength], "'"))
}

fn top() -> *State { return &stack[depth - 1] }

fn transitionTop(to: u8) -> void { stack[depth - 1].state = to }

fn pushState(state: u8, n: *Node, owner: ?*Node, ownerMultiplier: bool) -> void {
    stack[depth] = State.{ .state = state, .node = n, .owner = owner, .ownerMultiplier = ownerMultiplier }
    depth += 1
}

fn setTargets(n: ?*Node) -> void {
    multiplierTarget = n
    annotationTarget = n
    annotationOnMultiplier = false
}

// `add` of a grouping or a function (to its parameter group).
fn addMember(owner: *Node, member: *Node) -> void {
    if owner.*.kind == N_FUNCTION {
        push(&owner.*.parameterGroup.?.*.members, @intFromPtr(member))
    } else {
        push(&owner.*.members, @intFromPtr(member))
    }
}

fn groupKindOf(n: *Node) -> u8 {
    if n.*.kind == N_FUNCTION { return n.*.parameterGroup.?.*.groupKind }
    return n.*.groupKind
}

fn setGroupKind(n: *Node, kind: u8) -> void {
    if n.*.kind == N_FUNCTION {
        n.*.parameterGroup.?.*.groupKind = kind
    } else {
        n.*.groupKind = kind
    }
}

fn exitInitialGrouping(token: Token, state: State) -> void {
    if state.node.*.kind == N_GROUP && state.node.*.isInitial {
        transitionTop(S_DONE)
        return
    }
    unexpected(token)
}

fn enterNewGrouping() -> void {
    pushState(S_UNKNOWN_GROUPING_INITIAL, node(N_GROUP), top().*.node, false)
    setTargets(null)
}

fn exitGrouping(token: Token, state: State) -> void {
    if state.node.*.kind == N_GROUP && !state.node.*.isInitial {
        depth -= 1
        addMember(state.owner.?, state.node)
        setTargets(state.node)
        return
    }
    unexpected(token)
}

fn enterNewFunction(token: Token) -> void {
    const function = node(N_FUNCTION)
    function.*.name = token.value[0..token.value.length - 1]
    function.*.parameterGroup = node(N_GROUP)
    pushState(S_UNKNOWN_GROUPING_INITIAL, function, top().*.node, false)
    setTargets(null)
}

fn exitFunction(token: Token, state: State) -> void {
    if state.node.*.kind == N_FUNCTION {
        depth -= 1
        addMember(state.owner.?, state.node)
        setTargets(state.node)
        return
    }
    unexpected(token)
}

fn enterNewInternalReference() -> void {
    const reference = node(N_REFERENCE)
    reference.*.isInternal = true
    pushState(S_INTERNAL_REFERENCE_INITIAL, reference, top().*.node, false)
    setTargets(null)
}

fn exitInternalReference(token: Token, state: State) -> void {
    if state.node.*.kind == N_REFERENCE && state.node.*.isInternal {
        depth -= 1
        addMember(state.owner.?, state.node)
        setTargets(state.node)
        return
    }
    unexpected(token)
}

fn enterNewReference() -> void {
    pushState(S_REFERENCE_INITIAL, node(N_REFERENCE), top().*.node, false)
    setTargets(null)
}

fn exitReference(token: Token, state: State) -> void {
    if state.node.*.kind == N_REFERENCE && !state.node.*.isInternal {
        depth -= 1
        addMember(state.owner.?, state.node)
        setTargets(state.node)
        return
    }
    unexpected(token)
}

fn enterNewRepetitionModifier(token: Token) -> void {
    if multiplierTarget == null { unexpected(token) }
    pushState(S_REPETITION_MODIFIER_INITIAL, node(N_REPETITION), multiplierTarget, false)
    annotationTarget = null
}

// BNFNodeMultiplier.add of a repetition modifier or a simple multiplier (KIND).
fn addMultiplier(target: *Node, repetition: ?*Node, simple: u8) -> void {
    if target.*.multiplierAnnotation != null { s.fail("Invalid to stack another multiplier on top of a multiplier that has already received an annotation.") }
    const kind = target.*.multiplierKind
    if kind == 0 {
        if repetition != null {
            const r = repetition.?
            target.*.multiplierMin = r.*.repetitionMin
            target.*.multiplierMax = r.*.repetitionMax
            if r.*.repetitionKind == R_EXACT { target.*.multiplierKind = M_SPACE_EXACT }
            if r.*.repetitionKind == R_AT_LEAST { target.*.multiplierKind = M_SPACE_AT_LEAST }
            if r.*.repetitionKind == R_BETWEEN { target.*.multiplierKind = M_SPACE_BETWEEN }
        } else {
            target.*.multiplierKind = simple
        }
    } else if kind == M_COMMA_ONE_OR_MORE {
        if repetition == null { s.fail("Invalid to stack a non-range multiplier on top of '#'.") }
        const r = repetition.?
        target.*.multiplierMin = r.*.repetitionMin
        target.*.multiplierMax = r.*.repetitionMax
        if r.*.repetitionKind == R_EXACT { target.*.multiplierKind = M_COMMA_EXACT }
        if r.*.repetitionKind == R_AT_LEAST { target.*.multiplierKind = M_COMMA_AT_LEAST }
        if r.*.repetitionKind == R_BETWEEN { target.*.multiplierKind = M_COMMA_BETWEEN }
    } else {
        s.fail("Invalid to stack another multiplier.")
    }
}

fn exitRepetitionModifier(token: Token, state: State) -> void {
    if state.node.*.kind == N_REPETITION {
        depth -= 1
        addMultiplier(state.owner.?, state.node, 0)
        multiplierTarget = null
        annotationTarget = state.owner
        annotationOnMultiplier = true
        return
    }
    unexpected(token)
}

fn enterNewStringAttribute(token: Token) -> void {
    const attribute = node(N_STRING_ATTRIBUTE)
    attribute.*.name = token.value
    pushState(S_REFERENCE_STRING_ATTRIBUTE_INITIAL, attribute, top().*.node, false)
    setTargets(null)
}

fn exitStringAttribute(token: Token, state: State) -> State {
    if state.node.*.kind != N_STRING_ATTRIBUTE { unexpected(token) }
    depth -= 1
    push(&state.owner.?.*.members, @intFromPtr(state.node))
    setTargets(null)
    return top().*
}

fn enterNewRangeAttribute() -> void {
    setTargets(null)
    pushState(S_REFERENCE_RANGE_ATTRIBUTE_INITIAL, node(N_RANGE_ATTRIBUTE), top().*.node, false)
}

fn exitRangeAttribute(token: Token, state: State) -> void {
    if state.node.*.kind != N_RANGE_ATTRIBUTE { unexpected(token) }
    depth -= 1
    push(&state.owner.?.*.members, @intFromPtr(state.node))
    setTargets(null)
}

fn enterNewQuotedLiteral() -> void {
    pushState(S_QUOTED_LITERAL_INITIAL, node(N_LITERAL), top().*.node, false)
    setTargets(null)
}

fn exitQuotedLiteral(token: Token, state: State) -> void {
    if state.node.*.kind != N_LITERAL { unexpected(token) }
    depth -= 1
    addMember(state.owner.?, state.node)
    setTargets(state.node)
}

fn enterNewAnnotation(token: Token) -> void {
    if annotationTarget == null { unexpected(token) }
    pushState(S_ANNOTATION_INITIAL, node(N_ANNOTATION), annotationTarget, annotationOnMultiplier)
    annotationTarget = null
}

fn exitAnnotation(token: Token, state: State) -> void {
    if state.node.*.kind != N_ANNOTATION { unexpected(token) }
    depth -= 1
    const owner = state.owner.?
    if state.ownerMultiplier {
        if owner.*.multiplierAnnotation != null { s.fail("Invalid to add an annotation to a multiplier node that already has an annotation.") }
        owner.*.multiplierAnnotation = state.node
    } else {
        if owner.*.annotation != null { s.fail("Invalid to add an annotation to a node that already has an annotation.") }
        owner.*.annotation = state.node
    }
    annotationTarget = null
}

fn enterNewDirective(token: Token) -> void {
    const directive = node(N_DIRECTIVE)
    directive.*.name = token.value
    pushState(S_ANNOTATION_SEEN_ID, directive, top().*.node, false)
}

fn exitDirective(token: Token, state: State) -> State {
    if state.node.*.kind != N_DIRECTIVE { unexpected(token) }
    depth -= 1
    push(&state.owner.?.*.members, @intFromPtr(state.node))
    return top().*
}

fn processKeyword(token: Token, state: State) -> void {
    const keyword = node(N_KEYWORD)
    keyword.*.name = token.value
    addMember(state.node, keyword)
    setTargets(keyword)
}

fn processUnquotedLiteral(token: Token, state: State) -> void {
    const literal = node(N_LITERAL)
    literal.*.name = token.value
    addMember(state.node, literal)
    setTargets(literal)
}

fn processSimpleMultiplier(token: Token) -> void {
    if multiplierTarget == null { unexpected(token) }
    var kind: u8 = 0
    if token.kind == T_QMARK { kind = M_ZERO_OR_ONE }
    if token.kind == T_STAR { kind = M_SPACE_ZERO_OR_MORE }
    if token.kind == T_PLUS { kind = M_SPACE_ONE_OR_MORE }
    if token.kind == T_HASH { kind = M_COMMA_ONE_OR_MORE }
    if kind == 0 { s.fail(t.c3("'", token.value, "' is not a valid BNFNodeMultiplier.Kind")) }
    addMultiplier(multiplierTarget.?, null, kind)
    annotationTarget = multiplierTarget
    annotationOnMultiplier = true
}

fn combinatorFor(kind: u8) -> u8 {
    if kind == T_OR { return G_ONE }
    if kind == T_OROR { return G_ONE_OR_MORE_ANY_ORDER }
    return G_ALL_ANY_ORDER
}

fn isCombinator(kind: u8) -> bool { return kind == T_OR || kind == T_OROR || kind == T_ANDAND }
fn isSimpleMultiplier(kind: u8) -> bool { return kind == T_HASH || kind == T_PLUS || kind == T_STAR || kind == T_NOT || kind == T_QMARK }
fn isUnquotedLiteral(kind: u8) -> bool { return kind == T_COMMA || kind == T_SLASH }

fn processCombinator(token: Token, state: State, known: bool) -> void {
    if known && groupKindOf(state.node) != combinatorFor(token.kind) { s.fail(t.c3("Unexpected token '", token.value, "'.")) }
    setGroupKind(state.node, combinatorFor(token.kind))
    setTargets(null)
}

fn step(token: Token) -> void {
    var state = top().*
    const kind = token.kind
    const which = state.state
    if which == S_UNKNOWN_GROUPING_INITIAL {
        transitionTop(S_UNKNOWN_GROUPING_SEEN_TERM)
        if kind == T_LSQUARE { return enterNewGrouping() }
        if kind == T_LTLT { return enterNewInternalReference() }
        if kind == T_LT { return enterNewReference() }
        if kind == T_FUNC { return enterNewFunction(token) }
        if kind == T_ID { return processKeyword(token, state) }
        if kind == T_SQUOTE { return enterNewQuotedLiteral() }
        if isUnquotedLiteral(kind) { return processUnquotedLiteral(token, state) }
        if kind == T_RPAREN { return exitFunction(token, state) }
        return unexpected(token)
    }
    if which == S_UNKNOWN_GROUPING_SEEN_TERM || which == S_KNOWN_ORDERED_GROUPING {
        if kind == T_RSQUARE { return exitGrouping(token, state) }
        if kind == T_EOF { return exitInitialGrouping(token, state) }
        if kind == T_RPAREN { return exitFunction(token, state) }
        if kind == T_LSQUARE || kind == T_LTLT || kind == T_LT || kind == T_FUNC || kind == T_ID || kind == T_SQUOTE || isUnquotedLiteral(kind) {
            transitionTop(S_KNOWN_ORDERED_GROUPING)
            if kind == T_LSQUARE { return enterNewGrouping() }
            if kind == T_LTLT { return enterNewInternalReference() }
            if kind == T_LT { return enterNewReference() }
            if kind == T_FUNC { return enterNewFunction(token) }
            if kind == T_ID { return processKeyword(token, state) }
            if kind == T_SQUOTE { return enterNewQuotedLiteral() }
            return processUnquotedLiteral(token, state)
        }
        if which == S_UNKNOWN_GROUPING_SEEN_TERM && isCombinator(kind) {
            transitionTop(S_KNOWN_COMBINATOR_GROUPING_TERM_REQUIRED)
            return processCombinator(token, state, false)
        }
        if isSimpleMultiplier(kind) { return processSimpleMultiplier(token) }
        if kind == T_ATPAREN { return enterNewAnnotation(token) }
        if kind == T_LBRACE { return enterNewRepetitionModifier(token) }
        return unexpected(token)
    }
    if which == S_KNOWN_COMBINATOR_GROUPING_TERM_REQUIRED {
        transitionTop(S_KNOWN_COMBINATOR_GROUPING_COMBINATOR_OR_CLOSE_REQUIRED)
        if kind == T_LSQUARE { return enterNewGrouping() }
        if kind == T_LTLT { return enterNewInternalReference() }
        if kind == T_LT { return enterNewReference() }
        if kind == T_FUNC { return enterNewFunction(token) }
        if kind == T_ID { return processKeyword(token, state) }
        return unexpected(token)
    }
    if which == S_KNOWN_COMBINATOR_GROUPING_COMBINATOR_OR_CLOSE_REQUIRED {
        if kind == T_RSQUARE { return exitGrouping(token, state) }
        if kind == T_EOF { return exitInitialGrouping(token, state) }
        if kind == T_RPAREN { return exitFunction(token, state) }
        if isCombinator(kind) {
            transitionTop(S_KNOWN_COMBINATOR_GROUPING_TERM_REQUIRED)
            return processCombinator(token, state, true)
        }
        if isSimpleMultiplier(kind) { return processSimpleMultiplier(token) }
        if kind == T_ATPAREN { return enterNewAnnotation(token) }
        if kind == T_LBRACE { return enterNewRepetitionModifier(token) }
        return unexpected(token)
    }
    if which == S_REFERENCE_INITIAL {
        if kind == T_FUNC {
            transitionTop(S_REFERENCE_SEEN_FUNCTION_OPEN)
            state.node.*.isFunctionReference = true
            state.node.*.name = token.value[0..token.value.length - 1]
            return
        }
        if kind == T_ID {
            transitionTop(S_REFERENCE_SEEN_ID_OR_FUNCTION)
            state.node.*.name = token.value
            return
        }
        if kind == T_SQUOTE { return transitionTop(S_REFERENCE_SEEN_QUOTE_OPEN) }
        return unexpected(token)
    }
    if which == S_REFERENCE_SEEN_QUOTE_OPEN {
        if kind == T_ID {
            transitionTop(S_REFERENCE_SEEN_QUOTE_AND_ID)
            state.node.*.name = t.c3("'", token.value, "'")
            return
        }
        return unexpected(token)
    }
    if which == S_REFERENCE_SEEN_QUOTE_AND_ID {
        if kind == T_SQUOTE { return transitionTop(S_REFERENCE_SEEN_ID_OR_FUNCTION) }
        return unexpected(token)
    }
    if which == S_REFERENCE_SEEN_FUNCTION_OPEN {
        if kind == T_RPAREN { return transitionTop(S_REFERENCE_SEEN_ID_OR_FUNCTION) }
        return unexpected(token)
    }
    if which == S_REFERENCE_SEEN_ID_OR_FUNCTION || which == S_INTERNAL_REFERENCE_SEEN_ID {
        if kind == T_ID { return enterNewStringAttribute(token) }
        if kind == T_LSQUARE { return enterNewRangeAttribute() }
        if which == S_REFERENCE_SEEN_ID_OR_FUNCTION && kind == T_GT { return exitReference(token, state) }
        if which == S_INTERNAL_REFERENCE_SEEN_ID && kind == T_GTGT { return exitInternalReference(token, state) }
        return unexpected(token)
    }
    if which == S_INTERNAL_REFERENCE_INITIAL {
        if kind == T_ID {
            transitionTop(S_INTERNAL_REFERENCE_SEEN_ID)
            state.node.*.name = token.value
            return
        }
        return unexpected(token)
    }
    if which == S_REFERENCE_STRING_ATTRIBUTE_INITIAL || which == S_REFERENCE_STRING_ATTRIBUTE_SEEN_VALUE {
        if which == S_REFERENCE_STRING_ATTRIBUTE_INITIAL && kind == T_EQUAL { return transitionTop(S_REFERENCE_STRING_ATTRIBUTE_SEEN_EQUAL) }
        if which == S_REFERENCE_STRING_ATTRIBUTE_SEEN_VALUE && kind == T_COMMA { return transitionTop(S_REFERENCE_STRING_ATTRIBUTE_SEEN_EQUAL) }
        state = exitStringAttribute(token, state)
        if kind == T_ID { return enterNewStringAttribute(token) }
        if kind == T_LSQUARE { return enterNewRangeAttribute() }
        if kind == T_GT { return exitReference(token, state) }
        if kind == T_GTGT { return exitInternalReference(token, state) }
        return unexpected(token)
    }
    if which == S_REFERENCE_STRING_ATTRIBUTE_SEEN_EQUAL {
        if kind == T_ID {
            transitionTop(S_REFERENCE_STRING_ATTRIBUTE_SEEN_VALUE)
            t.push(&state.node.*.values, token.value)
            return
        }
        return unexpected(token)
    }
    if which == S_REFERENCE_RANGE_ATTRIBUTE_INITIAL {
        if kind == T_INT || kind == T_FLOAT || (kind == T_ID && s.same(token.value, "-inf")) {
            transitionTop(S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MIN)
            state.node.*.rangeMin = token.value
            return
        }
        return unexpected(token)
    }
    if which == S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MIN {
        if kind == T_COMMA { return transitionTop(S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MIN_AND_COMMA) }
        return unexpected(token)
    }
    if which == S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MIN_AND_COMMA {
        if kind == T_INT || kind == T_FLOAT || (kind == T_ID && s.same(token.value, "inf")) {
            transitionTop(S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MAX)
            state.node.*.rangeMax = token.value
            return
        }
        return unexpected(token)
    }
    if which == S_REFERENCE_RANGE_ATTRIBUTE_SEEN_MAX {
        if kind == T_RSQUARE { return exitRangeAttribute(token, state) }
        return unexpected(token)
    }
    if which == S_REPETITION_MODIFIER_INITIAL {
        if kind == T_INT {
            transitionTop(S_REPETITION_MODIFIER_SEEN_MIN)
            state.node.*.repetitionKind = R_EXACT
            state.node.*.repetitionMin = parseInt(token.value)
            return
        }
        return unexpected(token)
    }
    if which == S_REPETITION_MODIFIER_SEEN_MIN {
        if kind == T_COMMA {
            transitionTop(S_REPETITION_MODIFIER_SEEN_MIN_AND_COMMA)
            state.node.*.repetitionKind = R_AT_LEAST
            return
        }
        if kind == T_RBRACE { return exitRepetitionModifier(token, state) }
        return unexpected(token)
    }
    if which == S_REPETITION_MODIFIER_SEEN_MIN_AND_COMMA {
        if kind == T_INT {
            transitionTop(S_REPETITION_MODIFIER_SEEN_MAX)
            state.node.*.repetitionKind = R_BETWEEN
            state.node.*.repetitionMax = parseInt(token.value)
            return
        }
        if kind == T_RBRACE { return exitRepetitionModifier(token, state) }
        return unexpected(token)
    }
    if which == S_REPETITION_MODIFIER_SEEN_MAX {
        if kind == T_RBRACE { return exitRepetitionModifier(token, state) }
        return unexpected(token)
    }
    if which == S_QUOTED_LITERAL_INITIAL {
        transitionTop(S_QUOTED_LITERAL_SEEN_ID)
        state.node.*.name = token.value
        return
    }
    if which == S_QUOTED_LITERAL_SEEN_ID {
        if kind == T_SQUOTE { return exitQuotedLiteral(token, state) }
        state.node.*.name = s.join(state.node.*.name, token.value)
        return
    }
    if which == S_ANNOTATION_INITIAL {
        if kind == T_ID { return enterNewDirective(token) }
        return unexpected(token)
    }
    if which == S_ANNOTATION_SEEN_ID {
        if kind == T_EQUAL { return transitionTop(S_ANNOTATION_SEEN_EQUAL_OR_COMMA) }
        state = exitDirective(token, state)
        if kind == T_ID { return enterNewDirective(token) }
        if kind == T_RPAREN { return exitAnnotation(token, state) }
        return unexpected(token)
    }
    if which == S_ANNOTATION_SEEN_EQUAL_OR_COMMA {
        if kind == T_ID {
            t.push(&state.node.*.values, token.value)
            return transitionTop(S_ANNOTATION_SEEN_VALUE)
        }
        return unexpected(token)
    }
    if which == S_ANNOTATION_SEEN_VALUE {
        if kind == T_COMMA { return transitionTop(S_ANNOTATION_SEEN_EQUAL_OR_COMMA) }
        state = exitDirective(token, state)
        if kind == T_ID { return enterNewDirective(token) }
        if kind == T_RPAREN { return exitAnnotation(token, state) }
        return unexpected(token)
    }
    unexpected(token)
}

pub fn parseInt(text: []const u8) -> i64 {
    var value: i64 = 0
    var index: usize = 0
    var negative = false
    if text.length > 0 && text[0] == 45 {
        negative = true
        index = 1
    }
    while index < text.length {
        value = value * 10 + @intCast(i64, text[index] - 48)
        index += 1
    }
    return if negative { -value } else { value }
}

// The parse tree of DATA (BNFParser.parse).
pub fn parseBNF(data: []const u8) -> *Node {
    stack = unsafe { @ptrFromInt([*]State, s.alloc(STACK_SIZE * @sizeOf(State))) }
    depth = 0
    setTargets(null)
    parsingPointer = data.pointer
    parsingLength = data.length
    const root = node(N_GROUP)
    root.*.isInitial = true
    pushState(S_UNKNOWN_GROUPING_INITIAL, root, null, false)
    var at: usize = 0
    while at <= data.length {
        var token = Token.{ .kind = T_EOF, .value = "\x00" }
        if at < data.length {
            var length: usize = 0
            const kind = lexOne(data, at, &length)
            token = Token.{ .kind = kind, .value = data[at..at + length] }
            at += length
            if kind == T_WHITESPACE { continue }
            if kind == T_ILLEGAL { s.fail(t.c3("Illegal token found while parsing grammar definition: '", token.value, "'")) }
        } else {
            at += 1
        }
        step(token)
    }
    if top().*.state != S_DONE { s.fail(s.join("Unexpected state after processing all tokens of ", data)) }
    return root
}

// ---------------------------------------------------------------------------
// Terms.

pub const K_REFERENCE: u8 = 1
pub const K_LITERAL: u8 = 2
pub const K_KEYWORD: u8 = 3
pub const K_MATCH_ONE: u8 = 4
pub const K_MATCH_ONE_OR_MORE_ANY_ORDER: u8 = 5
pub const K_MATCH_ALL_ORDERED: u8 = 6
pub const K_MATCH_ALL_ANY_ORDER: u8 = 7
pub const K_OPTIONAL: u8 = 8
pub const K_UNBOUNDED_REPETITION: u8 = 9
pub const K_BOUNDED_REPETITION: u8 = 10
pub const K_FUNCTION: u8 = 11

// A builtin reference's parameters: each name with its value, NONE when
// the script's is None.
pub const Builtin = struct {
    entry: []const u8
    names: t.List
    values: t.List
}

pub const NONE = "\x00None"

pub fn isNone(text: []const u8) -> bool { return s.same(text, NONE) }

pub const Term = struct {
    kind: u8
    subterms: Refs
    // An optional term's, a repetition's repeated term, a function's parameter group.
    sub: ?*Term
    annotation: ?*Node
    valueType: []const u8
    preserveOrder: bool
    singleValueOptimization: bool
    // "" for None.
    settingsFlag: []const u8
    defaultValue: []const u8
    separator: u8
    min: i64
    max: i64
    // A keyword's value, a reference's name, a function's name, a literal's value.
    name: []const u8
    aliasedTo: []const u8
    comment: []const u8
    status: []const u8
    isInternal: bool
    isFunctionReference: bool
    // A reference's parameters: N_STRING_ATTRIBUTE and N_RANGE_ATTRIBUTE nodes.
    parameters: Refs
    builtin: ?*Builtin
    overrideFunction: []const u8
    // Memo of fast_path_keyword_terms_sorted_by_name for a grammar's root.
    sortedFastPath: ?*Refs
}

pub fn termAt(l: Refs, index: usize) -> *Term { return unsafe { @ptrFromInt(*Term, l.items[index]) } }

pub fn newTerm(kind: u8) -> *Term {
    const term: *Term = unsafe { @ptrFromInt(*Term, s.alloc(@sizeOf(Term))) }
    term.*.kind = kind
    term.*.subterms = refs()
    term.*.sub = null
    term.*.annotation = null
    term.*.valueType = "CSSValueList"
    term.*.preserveOrder = false
    term.*.singleValueOptimization = true
    term.*.settingsFlag = ""
    term.*.defaultValue = ""
    term.*.separator = 32
    term.*.min = 0
    term.*.max = 0
    term.*.name = ""
    term.*.aliasedTo = ""
    term.*.comment = ""
    term.*.status = ""
    term.*.isInternal = false
    term.*.isFunctionReference = false
    term.*.parameters = refs()
    term.*.builtin = null
    term.*.overrideFunction = ""
    term.*.sortedFastPath = null
    return term
}

fn directiveValue(directive: *Node) -> []const u8 {
    if directive.*.values.count == 0 { s.fail(s.join("A directive without a value: ", directive.*.name)) }
    return directive.*.values.items[0]
}

// _process_annotation of each kind of term.
fn processAnnotation(term: *Term, annotation: ?*Node) -> void {
    term.*.annotation = annotation
    if annotation == null { return }
    const directives = annotation.?.*.members
    var index: usize = 0
    while index < directives.count {
        const directive = nodeAt(directives, index)
        const name = directive.*.name
        const kind = term.*.kind
        var known = false
        if s.same(name, "settings-flag") && kind != K_LITERAL && kind != K_OPTIONAL {
            term.*.settingsFlag = directiveValue(directive)
            known = true
        } else if s.same(name, "aliased-to") && kind == K_KEYWORD {
            term.*.aliasedTo = directiveValue(directive)
            known = true
        } else if s.same(name, "type") && (kind == K_MATCH_ONE_OR_MORE_ANY_ORDER || kind == K_MATCH_ALL_ORDERED || kind == K_MATCH_ALL_ANY_ORDER || kind == K_UNBOUNDED_REPETITION || kind == K_BOUNDED_REPETITION) {
            term.*.valueType = directiveValue(directive)
            known = true
        } else if s.same(name, "preserve-order") && (kind == K_MATCH_ONE_OR_MORE_ANY_ORDER || kind == K_MATCH_ALL_ANY_ORDER) {
            term.*.preserveOrder = true
            known = true
        } else if s.same(name, "no-single-item-opt") && (kind == K_MATCH_ONE_OR_MORE_ANY_ORDER || kind == K_MATCH_ALL_ORDERED || kind == K_MATCH_ALL_ANY_ORDER || kind == K_UNBOUNDED_REPETITION || kind == K_BOUNDED_REPETITION) {
            term.*.singleValueOptimization = false
            known = true
        } else if s.same(name, "default") && kind == K_BOUNDED_REPETITION {
            term.*.defaultValue = directiveValue(directive)
            known = true
        }
        if !known { s.fail(t.c3("Unknown annotation directive '", name, "'.")) }
        index += 1
    }
}

fn stringifiedAnnotation(annotation: ?*Node) -> []const u8 {
    if annotation == null { return "" }
    var parts = t.list()
    const directives = annotation.?.*.members
    var index: usize = 0
    while index < directives.count {
        const directive = nodeAt(directives, index)
        if directive.*.values.count > 0 {
            t.push(&parts, t.c3(directive.*.name, "=", t.joined(directive.*.values, ",")))
        } else {
            t.push(&parts, directive.*.name)
        }
        index += 1
    }
    return t.c3("@(", t.joined(parts, " "), ")")
}

// Python's repr of a list of strings.
pub fn pythonListRepr(values: t.List) -> []const u8 {
    var parts = t.list()
    var index: usize = 0
    while index < values.count {
        const value = values.items[index]
        if s.contains(value, "'") && !s.contains(value, "\"") {
            t.push(&parts, t.c3("\"", value, "\""))
        } else {
            t.push(&parts, t.c3("'", t.replaceAll(value, "'", "\\'"), "'"))
        }
        index += 1
    }
    return t.c3("[", t.joined(parts, ", "), "]")
}

fn parameterText(parameter: *Node) -> []const u8 {
    if parameter.*.kind == N_RANGE_ATTRIBUTE { return t.c5("[", parameter.*.rangeMin, ",", parameter.*.rangeMax, "]") }
    if parameter.*.values.count > 0 { return t.c3(parameter.*.name, "=", pythonListRepr(parameter.*.values)) }
    return parameter.*.name
}

fn joinedTerms(terms: Refs, separator: []const u8) -> []const u8 {
    var parts = t.list()
    var index: usize = 0
    while index < terms.count {
        t.push(&parts, str(termAt(terms, index)))
        index += 1
    }
    return t.joined(parts, separator)
}

// str(term).
pub fn str(term: *Term) -> []const u8 {
    const kind = term.*.kind
    const annotation = stringifiedAnnotation(term.*.annotation)
    if kind == K_REFERENCE {
        var parts = t.list()
        t.push(&parts, if term.*.isFunctionReference { s.join(term.*.name, "()") } else { term.*.name })
        var index: usize = 0
        while index < term.*.parameters.count {
            t.push(&parts, parameterText(nodeAt(term.*.parameters, index)))
            index += 1
        }
        const base = t.joined(parts, " ")
        if term.*.isInternal { return t.c4("<<", base, ">>", annotation) }
        return t.c4("<", base, ">", annotation)
    }
    if kind == K_LITERAL { return t.c3("'", term.*.name, "'") }
    if kind == K_KEYWORD { return s.join(term.*.name, annotation) }
    if kind == K_MATCH_ONE { return t.c4("[ ", joinedTerms(term.*.subterms, " | "), " ]", annotation) }
    if kind == K_MATCH_ONE_OR_MORE_ANY_ORDER { return t.c4("[ ", joinedTerms(term.*.subterms, " || "), " ]", annotation) }
    if kind == K_MATCH_ALL_ORDERED { return t.c4("[ ", joinedTerms(term.*.subterms, " "), " ]", annotation) }
    if kind == K_MATCH_ALL_ANY_ORDER { return t.c4("[ ", joinedTerms(term.*.subterms, " && "), " ]", annotation) }
    if kind == K_OPTIONAL { return t.c3(str(term.*.sub.?), "?", annotation) }
    if kind == K_UNBOUNDED_REPETITION || kind == K_BOUNDED_REPETITION { return t.c3(str(term.*.sub.?), stringifiedSuffix(term), annotation) }
    if kind == K_FUNCTION { return t.c5(term.*.name, "(", str(term.*.sub.?), ")", annotation) }
    return ""
}

pub fn stringifiedSuffix(term: *Term) -> []const u8 {
    const min = s.signedDecimal(term.*.min)
    const max = s.signedDecimal(term.*.max)
    if term.*.kind == K_UNBOUNDED_REPETITION {
        if term.*.separator == 32 {
            if term.*.min == 0 { return "*" }
            if term.*.min == 1 { return "+" }
            return t.c3("{", min, ",}")
        }
        if term.*.min == 1 { return "#" }
        return t.c3("#{", min, ",}")
    }
    if term.*.separator == 32 {
        if term.*.min == term.*.max { return t.c3("{", min, "}") }
        return t.c5("{", min, ",", max, "}")
    }
    if term.*.min == term.*.max { return t.c3("#{", min, "}") }
    return t.c5("#{", min, ",", max, "}")
}

// The " | "-free texts: stringified_without_brackets of a grouping term.
pub fn strWithoutBrackets(term: *Term) -> []const u8 {
    const kind = term.*.kind
    if kind == K_MATCH_ONE_OR_MORE_ANY_ORDER { return joinedTerms(term.*.subterms, " || ") }
    if kind == K_MATCH_ALL_ORDERED { return joinedTerms(term.*.subterms, " ") }
    if kind == K_MATCH_ALL_ANY_ORDER { return joinedTerms(term.*.subterms, " && ") }
    return str(term)
}

// ---------------------------------------------------------------------------
// The builtins (ReferenceTerm.builtins).

const StringDescriptor = struct {
    name: []const u8
    // "key=value" pairs; empty when the parameter takes its text as is.
    mappings: []const u8
    // Default keys separated by spaces ("" for none).
    defaults: []const u8
}

fn mappingFor(mappings: []const u8, key: []const u8) -> []const u8 {
    const pairs = c.splitByte(mappings, 32)
    var index: usize = 0
    while index < pairs.count {
        const pair = pairs.items[index]
        const equal = s.find(pair, "=")
        if s.same(pair[0..equal], key) { return pair[equal + 1..pair.length] }
        index += 1
    }
    return ""
}

const UNITLESS_ZERO = "allowed=UnitlessZeroQuirk::Allow forbidden=UnitlessZeroQuirk::Forbid"
const ANCHOR = "allowed=AnchorPolicy::Allow forbidden=AnchorPolicy::Forbid"
const ANCHOR_SIZE = "allowed=AnchorSizePolicy::Allow forbidden=AnchorSizePolicy::Forbid"
const COLOR_TYPES = "absolute=CSS::ColorType::Absolute current=CSS::ColorType::Current system=CSS::ColorType::System"
const IMAGE_TYPES = "url=AllowedImageType::URLFunction image-set=AllowedImageType::ImageSet generated=AllowedImageType::GeneratedImage"
const URL_MODIFIERS = "crossorigin=AllowedURLModifiers::CrossOrigin integrity=AllowedURLModifiers::Integrity referrerpolicy=AllowedURLModifiers::ReferrerPolicy"

// The schema of builtin NAME: its string parameters (into DESCRIPTORS) and
// whether it takes a range; false when NAME is no builtin.
fn builtinSchema(name: []const u8, descriptors: [*]StringDescriptor, count: *usize, range: *bool) -> bool {
    count.* = 0
    range.* = false
    if s.same(name, "angle") {
        range.* = true
        descriptors[0] = StringDescriptor.{ .name = "unitless-zero", .mappings = UNITLESS_ZERO, .defaults = "forbidden" }
        count.* = 1
        return true
    }
    if s.same(name, "length") {
        range.* = true
        descriptors[0] = StringDescriptor.{ .name = "unitless-zero", .mappings = UNITLESS_ZERO, .defaults = "allowed" }
        count.* = 1
        return true
    }
    if s.same(name, "length-percentage") {
        range.* = true
        descriptors[0] = StringDescriptor.{ .name = "unitless-zero", .mappings = UNITLESS_ZERO, .defaults = "allowed" }
        descriptors[1] = StringDescriptor.{ .name = "anchor", .mappings = ANCHOR, .defaults = "forbidden" }
        descriptors[2] = StringDescriptor.{ .name = "anchor-size", .mappings = ANCHOR_SIZE, .defaults = "forbidden" }
        count.* = 3
        return true
    }
    if s.same(name, "time") || s.same(name, "integer") || s.same(name, "number") || s.same(name, "percentage") || s.same(name, "resolution") || s.same(name, "number-or-percentage-resolved-to-number") {
        range.* = true
        return true
    }
    if s.same(name, "color") {
        descriptors[0] = StringDescriptor.{ .name = "allowed-types", .mappings = COLOR_TYPES, .defaults = "absolute current system" }
        count.* = 1
        return true
    }
    if s.same(name, "image") {
        descriptors[0] = StringDescriptor.{ .name = "allowed-types", .mappings = IMAGE_TYPES, .defaults = "url image-set generated" }
        count.* = 1
        return true
    }
    if s.same(name, "custom-ident") {
        descriptors[0] = StringDescriptor.{ .name = "excluding", .mappings = "", .defaults = "" }
        count.* = 1
        return true
    }
    if s.same(name, "url") {
        descriptors[0] = StringDescriptor.{ .name = "allowed-modifiers", .mappings = URL_MODIFIERS, .defaults = "" }
        count.* = 1
        return true
    }
    return s.same(name, "position") || s.same(name, "string") || s.same(name, "dashed-ident") || s.same(name, "feature-tag-value") || s.same(name, "variation-tag-value") || s.same(name, "unicode-range-token")
}

fn mapped(mappings: []const u8, keys: t.List) -> []const u8 {
    var parts = t.list()
    var index: usize = 0
    while index < keys.count {
        t.push(&parts, mappingFor(mappings, keys.items[index]))
        index += 1
    }
    return t.joined(parts, ", ")
}

fn makeBuiltin(name: []const u8, parameters: Refs) -> ?*Builtin {
    const descriptors: [*]StringDescriptor = unsafe { @ptrFromInt([*]StringDescriptor, s.alloc(4 * @sizeOf(StringDescriptor))) }
    var count: usize = 0
    var range = false
    if !builtinSchema(name, descriptors, &count, &range) { return null }
    const builtin: *Builtin = unsafe { @ptrFromInt(*Builtin, s.alloc(@sizeOf(Builtin))) }
    builtin.*.entry = name
    builtin.*.names = t.list()
    builtin.*.values = t.list()
    var given = t.list()
    var givenValues = t.list()
    var index: usize = 0
    while index < parameters.count {
        const parameter = nodeAt(parameters, index)
        if parameter.*.kind == N_STRING_ATTRIBUTE {
            var found = false
            var at: usize = 0
            while at < count {
                if s.same(descriptors[at].name, parameter.*.name) {
                    found = true
                    if t.contains(given, parameter.*.name) { s.fail(t.c3("More than one parameter of type '", parameter.*.name, "'.")) }
                    t.push(&given, parameter.*.name)
                    if descriptors[at].mappings.length > 0 {
                        if parameter.*.values.count == 0 { s.fail(t.c3("'", parameter.*.name, "' has no value associated with it.")) }
                        var v: usize = 0
                        while v < parameter.*.values.count {
                            if mappingFor(descriptors[at].mappings, parameter.*.values.items[v]).length == 0 { s.fail(t.c3("'", parameter.*.name, "' does not match any of the supported mappings.")) }
                            v += 1
                        }
                        t.push(&givenValues, mapped(descriptors[at].mappings, parameter.*.values))
                    } else {
                        // The list itself (its items joined by spaces here).
                        t.push(&givenValues, t.joined(parameter.*.values, " "))
                    }
                }
                at += 1
            }
            if !found { s.fail(t.c5("Unknown parameter '", parameter.*.name, "' passed to <", name, ">.")) }
        } else {
            if !range { s.fail(s.join("Range parameters are not supported for ", name)) }
            if t.contains(given, "value-range") { s.fail("More than one range parameter.") }
            t.push(&given, "value-range")
            const min = if s.same(parameter.*.rangeMin, "-inf") { "-CSS::Range::infinity" } else { parameter.*.rangeMin }
            const max = if s.same(parameter.*.rangeMax, "inf") { "CSS::Range::infinity" } else { parameter.*.rangeMax }
            t.push(&givenValues, t.c5("CSS::Range{", min, ", ", max, "}"))
        }
        index += 1
    }
    index = 0
    while index < count {
        const descriptor = descriptors[index]
        t.push(&builtin.*.names, descriptor.name)
        var value: []const u8 = NONE
        var at: usize = 0
        var found = false
        while at < given.count {
            if s.same(given.items[at], descriptor.name) {
                value = givenValues.items[at]
                found = true
            }
            at += 1
        }
        if !found && descriptor.mappings.length > 0 && descriptor.defaults.length > 0 { value = mapped(descriptor.mappings, c.splitByte(descriptor.defaults, 32)) }
        t.push(&builtin.*.values, value)
        index += 1
    }
    if range {
        t.push(&builtin.*.names, "value-range")
        var value: []const u8 = ""
        var at: usize = 0
        while at < given.count {
            if s.same(given.items[at], "value-range") { value = givenValues.items[at] }
            at += 1
        }
        t.push(&builtin.*.values, value)
    }
    return builtin
}

// The builtin's parameter NAME (NONE when None).
pub fn builtinValue(builtin: *Builtin, name: []const u8) -> []const u8 {
    var index: usize = 0
    while index < builtin.*.names.count {
        if s.same(builtin.*.names.items[index], name) { return builtin.*.values.items[index] }
        index += 1
    }
    s.fail(t.c4("no parameter ", name, " for builtin ", builtin.*.entry))
    return NONE
}

pub fn newReference(name: []const u8, isInternal: bool, isFunctionReference: bool, parameters: Refs, annotation: ?*Node, overrideFunction: []const u8) -> *Term {
    const term = newTerm(K_REFERENCE)
    term.*.name = name
    term.*.isInternal = isInternal
    term.*.isFunctionReference = isFunctionReference
    term.*.parameters = parameters
    term.*.builtin = makeBuiltin(name, parameters)
    term.*.overrideFunction = overrideFunction
    processAnnotation(term, annotation)
    return term
}

pub fn newKeyword(name: []const u8, annotation: ?*Node) -> *Term {
    const term = newTerm(K_KEYWORD)
    term.*.name = name
    processAnnotation(term, annotation)
    return term
}

fn wrap(n: *Node, term: *Term) -> *Term {
    const kind = n.*.multiplierKind
    if kind == 0 { return term }
    var wrapped: *Term = undefined
    if kind == M_ZERO_OR_ONE {
        wrapped = newTerm(K_OPTIONAL)
    } else if kind == M_SPACE_ZERO_OR_MORE || kind == M_SPACE_ONE_OR_MORE || kind == M_SPACE_AT_LEAST || kind == M_COMMA_ONE_OR_MORE || kind == M_COMMA_AT_LEAST {
        wrapped = newTerm(K_UNBOUNDED_REPETITION)
    } else {
        wrapped = newTerm(K_BOUNDED_REPETITION)
    }
    wrapped.*.sub = term
    if kind >= M_COMMA_ONE_OR_MORE { wrapped.*.separator = 44 }
    if kind == M_SPACE_ZERO_OR_MORE { wrapped.*.min = 0 }
    if kind == M_SPACE_ONE_OR_MORE || kind == M_COMMA_ONE_OR_MORE { wrapped.*.min = 1 }
    if kind == M_SPACE_EXACT || kind == M_COMMA_EXACT {
        wrapped.*.min = n.*.multiplierMin
        wrapped.*.max = n.*.multiplierMin
    }
    if kind == M_SPACE_AT_LEAST || kind == M_COMMA_AT_LEAST { wrapped.*.min = n.*.multiplierMin }
    if kind == M_SPACE_BETWEEN || kind == M_COMMA_BETWEEN {
        wrapped.*.min = n.*.multiplierMin
        wrapped.*.max = n.*.multiplierMax
    }
    processAnnotation(wrapped, n.*.multiplierAnnotation)
    return wrapped
}

fn membersTerms(n: *Node) -> Refs {
    var result = refs()
    var index: usize = 0
    while index < n.*.members.count {
        push(&result, @intFromPtr(fromNode(nodeAt(n.*.members, index))))
        index += 1
    }
    return result
}

// Term.from_node.
pub fn fromNode(n: *Node) -> *Term {
    var term: *Term = undefined
    if n.*.kind == N_GROUP {
        const groupKind = n.*.groupKind
        if groupKind == G_ALL_ORDERED && n.*.members.count == 1 {
            term = fromNode(nodeAt(n.*.members, 0))
        } else {
            var kind = K_MATCH_ALL_ORDERED
            if groupKind == G_ONE { kind = K_MATCH_ONE }
            if groupKind == G_ALL_ANY_ORDER { kind = K_MATCH_ALL_ANY_ORDER }
            if groupKind == G_ONE_OR_MORE_ANY_ORDER { kind = K_MATCH_ONE_OR_MORE_ANY_ORDER }
            term = newTerm(kind)
            term.*.subterms = membersTerms(n)
            processAnnotation(term, n.*.annotation)
        }
    } else if n.*.kind == N_REFERENCE {
        term = newReference(n.*.name, n.*.isInternal, n.*.isFunctionReference, n.*.members, n.*.annotation, "")
    } else if n.*.kind == N_FUNCTION {
        term = newTerm(K_FUNCTION)
        term.*.name = n.*.name
        term.*.sub = fromNode(n.*.parameterGroup.?)
        processAnnotation(term, n.*.annotation)
    } else if n.*.kind == N_KEYWORD {
        term = newKeyword(n.*.name, n.*.annotation)
    } else {
        term = newTerm(K_LITERAL)
        term.*.name = n.*.name
        processAnnotation(term, n.*.annotation)
    }
    return wrap(n, term)
}

// ---------------------------------------------------------------------------
// Grammars and the shared rules.

pub const Grammar = struct {
    name: []const u8
    root: *Term
}

pub fn grammarFromString(name: []const u8, text: []const u8) -> *Grammar {
    const grammar: *Grammar = unsafe { @ptrFromInt(*Grammar, s.alloc(@sizeOf(Grammar))) }
    grammar.*.name = name
    grammar.*.root = fromNode(parseBNF(text))
    return grammar
}

pub const Rule = struct {
    name: []const u8
    nameForMethods: []const u8
    exported: bool
    grammar: ?*Grammar
    grammarUnused: ?*Grammar
    grammarFunction: []const u8
}

// The shared rules, by name.
pub var rules: Refs = undefined

pub fn ruleAt(index: usize) -> *Rule { return unsafe { @ptrFromInt(*Rule, rules.items[index]) } }

fn ruleNamed(name: []const u8) -> ?*Rule {
    var index: usize = 0
    while index < rules.count {
        if s.same(ruleAt(index).*.name, name) { return ruleAt(index) }
        index += 1
    }
    return null
}

// MatchOneTerm.simplify: nested MatchOne terms' subterms taken in.
fn simplify(subterms: Refs) -> Refs {
    var result = refs()
    var index: usize = 0
    while index < subterms.count {
        const subterm = termAt(subterms, index)
        if subterm.*.kind == K_MATCH_ONE {
            if subterm.*.settingsFlag.length > 0 { s.fail("Simplifying a MatchOneTerm with a settings flag is not yet supported.") }
            var at: usize = 0
            while at < subterm.*.subterms.count {
                push(&result, subterm.*.subterms.items[at])
                at += 1
            }
        } else {
            push(&result, subterms.items[index])
        }
        index += 1
    }
    return result
}

// perform_fixups: references to shared rules replaced by the rules' terms
// (VALUES null), or `<<values>>` by the values' keyword terms.
pub fn fixups(term: *Term, values: ?*Refs) -> *Term {
    const kind = term.*.kind
    if kind == K_REFERENCE {
        if values != null {
            if term.*.isInternal && s.same(term.*.name, "values") {
                const result = newTerm(K_MATCH_ONE)
                var index: usize = 0
                while index < values.?.*.count {
                    push(&result.*.subterms, values.?.*.items[index])
                    index += 1
                }
                return result
            }
            return term
        }
        const rule = ruleNamed(str(term))
        if rule != null { return fixups(rule.?.*.grammar.?.*.root, null) }
        return term
    }
    if kind == K_LITERAL || kind == K_KEYWORD { return term }
    if kind == K_MATCH_ONE || kind == K_MATCH_ONE_OR_MORE_ANY_ORDER || kind == K_MATCH_ALL_ORDERED || kind == K_MATCH_ALL_ANY_ORDER {
        var fixed = refs()
        var index: usize = 0
        while index < term.*.subterms.count {
            push(&fixed, @intFromPtr(fixups(termAt(term.*.subterms, index), values)))
            index += 1
        }
        term.*.subterms = if kind == K_MATCH_ONE { simplify(fixed) } else { fixed }
        if term.*.subterms.count == 1 { return termAt(term.*.subterms, 0) }
        return term
    }
    term.*.sub = fixups(term.*.sub.?, values)
    return term
}

// SharedGrammarRules.from_json with its fixups, from the JSON object of rules.
pub fn readRules(names: t.List, grammars: t.List, unused: t.List, functions: t.List, exported: t.List) -> void {
    rules = refs()
    var index: usize = 0
    while index < names.count {
        const name = names.items[index]
        const rule: *Rule = unsafe { @ptrFromInt(*Rule, s.alloc(@sizeOf(Rule))) }
        rule.*.name = name
        rule.*.nameForMethods = nameToId(name[1..name.length - 1])
        rule.*.exported = exported.items[index].length > 0
        rule.*.grammar = null
        rule.*.grammarUnused = null
        rule.*.grammarFunction = functions.items[index]
        if grammars.items[index].length > 0 { rule.*.grammar = grammarFromString(name, grammars.items[index]) }
        if unused.items[index].length > 0 { rule.*.grammarUnused = grammarFromString(name, unused.items[index]) }
        if rule.*.grammarFunction.length > 0 {
            const grammar: *Grammar = unsafe { @ptrFromInt(*Grammar, s.alloc(@sizeOf(Grammar))) }
            grammar.*.name = name
            grammar.*.root = newReference(s.join(name[1..name.length - 1], "-override-function"), false, false, refs(), null, rule.*.grammarFunction)
            rule.*.grammar = grammar
        }
        push(&rules, @intFromPtr(rule))
        index += 1
    }
    index = 0
    while index < rules.count {
        const grammar = ruleAt(index).*.grammar.?
        grammar.*.root = fixups(grammar.*.root, null)
        index += 1
    }
}

// The rules sorted by name (SharedGrammarRules.all).
pub fn sortedRules() -> Refs {
    var result = refs()
    var index: usize = 0
    while index < rules.count {
        push(&result, rules.items[index])
        index += 1
    }
    index = 1
    while index < result.count {
        const item = result.items[index]
        var at = index
        while at > 0 && t.before(ruleAt0(item).*.name, ruleAt0(result.items[at - 1]).*.name) {
            result.items[at] = result.items[at - 1]
            at -= 1
        }
        result.items[at] = item
        index += 1
    }
    return result
}

pub fn ruleAt0(address: usize) -> *Rule { return unsafe { @ptrFromInt(*Rule, address) } }

// ---------------------------------------------------------------------------
// Questions asked of terms.

pub fn supportedKeywords(term: *Term, into: *t.List) -> void {
    const kind = term.*.kind
    if kind == K_KEYWORD {
        if !t.contains(into.*, term.*.name) { t.push(into, term.*.name) }
        return
    }
    if kind == K_REFERENCE || kind == K_LITERAL { return }
    if kind == K_MATCH_ONE || kind == K_MATCH_ONE_OR_MORE_ANY_ORDER || kind == K_MATCH_ALL_ORDERED || kind == K_MATCH_ALL_ANY_ORDER {
        var index: usize = 0
        while index < term.*.subterms.count {
            supportedKeywords(termAt(term.*.subterms, index), into)
            index += 1
        }
        return
    }
    supportedKeywords(term.*.sub.?, into)
}

pub fn hasNonBuiltinReferenceTerms(term: *Term) -> bool {
    const kind = term.*.kind
    if kind == K_REFERENCE { return term.*.builtin == null }
    if kind == K_LITERAL || kind == K_KEYWORD { return false }
    if kind == K_MATCH_ONE || kind == K_MATCH_ONE_OR_MORE_ANY_ORDER || kind == K_MATCH_ALL_ORDERED || kind == K_MATCH_ALL_ANY_ORDER {
        var index: usize = 0
        while index < term.*.subterms.count {
            if hasNonBuiltinReferenceTerms(termAt(term.*.subterms, index)) { return true }
            index += 1
        }
        return false
    }
    return hasNonBuiltinReferenceTerms(term.*.sub.?)
}

pub fn isFastPathKeyword(term: *Term) -> bool { return term.*.kind == K_KEYWORD && term.*.aliasedTo.length == 0 }

pub fn requiresState(term: *Term) -> bool { return term.*.settingsFlag.length > 0 || s.same(term.*.status, "internal") }

pub fn hasKeywordTerm(term: *Term) -> bool {
    var index: usize = 0
    while index < term.*.subterms.count {
        if termAt(term.*.subterms, index).*.kind == K_KEYWORD { return true }
        index += 1
    }
    return false
}

pub fn hasOnlyKeywordTerms(term: *Term) -> bool {
    var index: usize = 0
    while index < term.*.subterms.count {
        if termAt(term.*.subterms, index).*.kind != K_KEYWORD { return false }
        index += 1
    }
    return true
}

pub fn keywordTerms(term: *Term) -> Refs {
    var result = refs()
    var index: usize = 0
    while index < term.*.subterms.count {
        if termAt(term.*.subterms, index).*.kind == K_KEYWORD { push(&result, term.*.subterms.items[index]) }
        index += 1
    }
    return result
}

pub fn fastPathKeywordTerms(term: *Term) -> Refs {
    var result = refs()
    var index: usize = 0
    while index < term.*.subterms.count {
        if isFastPathKeyword(termAt(term.*.subterms, index)) { push(&result, term.*.subterms.items[index]) }
        index += 1
    }
    return result
}

pub fn hasFastPathKeywordTerms(term: *Term) -> bool { return fastPathKeywordTerms(term).count > 0 }

pub fn hasOnlyFastPathKeywordTerms(term: *Term) -> bool {
    var index: usize = 0
    while index < term.*.subterms.count {
        if !isFastPathKeyword(termAt(term.*.subterms, index)) { return false }
        index += 1
    }
    return true
}

pub fn grammarHasFastPathKeywordTerms(grammar: *Grammar) -> bool { return grammar.*.root.*.kind == K_MATCH_ONE && hasFastPathKeywordTerms(grammar.*.root) }
pub fn grammarHasOnlyKeywordTerms(grammar: *Grammar) -> bool { return grammar.*.root.*.kind == K_MATCH_ONE && hasOnlyKeywordTerms(grammar.*.root) }
pub fn grammarHasOnlyFastPathKeywordTerms(grammar: *Grammar) -> bool { return grammar.*.root.*.kind == K_MATCH_ONE && hasOnlyFastPathKeywordTerms(grammar.*.root) }

pub fn grammarFastPathKeywordTerms(grammar: *Grammar) -> Refs {
    if grammar.*.root.*.kind == K_MATCH_ONE { return fastPathKeywordTerms(grammar.*.root) }
    return refs()
}

// Names compared with prefixed ones ("-...") last.
pub fn prefixedLastBefore(a: []const u8, b: []const u8) -> bool {
    const aPrefixed = a[0] == 45
    const bPrefixed = b[0] == 45
    if aPrefixed && !bPrefixed { return false }
    if !aPrefixed && bPrefixed { return true }
    return t.before(a, b)
}

// Grammar.fast_path_keyword_terms_sorted_by_name.
pub fn grammarFastPathKeywordTermsSorted(grammar: *Grammar) -> Refs {
    var result = grammarFastPathKeywordTerms(grammar)
    var index: usize = 1
    while index < result.count {
        const item = result.items[index]
        var at = index
        while at > 0 && prefixedLastBefore(termAt0(item).*.name, termAt0(result.items[at - 1]).*.name) {
            result.items[at] = result.items[at - 1]
            at -= 1
        }
        result.items[at] = item
        index += 1
    }
    return result
}

pub fn termAt0(address: usize) -> *Term { return unsafe { @ptrFromInt(*Term, address) } }
