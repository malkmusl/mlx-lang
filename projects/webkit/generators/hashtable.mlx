// JavaScriptCore's static hash tables (its .lut.h files), made as WebKit's
// create_hash_table (Perl) makes them, from the tables between `@begin
// NAME` and `@end` in the comments of its sources and in
// parser/Keywords.table:
//
//     webkit-hash-table SOURCE OUTPUT
//
// Each line of a table is KEY VALUE [ATTRIBUTES [PARAMETERS
// [INTRINSIC]]]: a function (ATTRIBUTES naming Function), a lazily made
// cell, class structure or property, a getter (and setter, unless
// ReadOnly), or with no attributes a keyword of the lexer. A table is a
// compact hash index (keys by rapidhash, as WTF hashes strings, through
// a power of two twice the keys, colliding keys chained past its end)
// and the values in order. The text is the Perl's to the byte.
const std = @import("std")
const s = @import("./support.mlx")
const rapidhash = @import("./rapidhash.mlx")

const LEXER: u8 = 0
const FUNCTION: u8 = 1
const PROPERTY: u8 = 2
const CELL_PROPERTY: u8 = 3
const CLASS_STRUCTURE: u8 = 4
const PROPERTY_CALLBACK: u8 = 5

const Entry = struct {
    key: []const u8
    value: []const u8
    // As given, "None" when none were.
    attributes: []const u8
    parameters: []const u8
    intrinsic: []const u8
    // The setter of a getter ("0" when ReadOnly).
    setter: []const u8
    kind: u8
}

const MAX_ENTRIES: usize = 8192
const MAX_SLOTS: usize = 32768

var entries: [*]Entry = undefined
var entryCount: usize = 0
// The compact index: the entry at each slot and the slot it links on to
// (-1 for none).
var slots: [*]i64 = undefined
var links: [*]i64 = undefined
var compactSize: usize = 0
var compactMask: usize = 0

var sourceName: [*]const u8 = undefined
var sourceNameLength: usize = 0
var banner: bool = false
// Whether a table had a getter: once set, every later table of the file
// says so too (the Perl never clears it).
var hasSetter: bool = false
var includeBuiltin: bool = false

// ---------------------------------------------------------------------------
// The table.

fn ceilingToPowerOf2(value: usize) -> usize {
    var power: usize = 1
    while value > power { power <<= 1 }
    return power
}

fn layOut() -> void {
    const size = ceilingToPowerOf2(2 * entryCount)
    compactMask = size - 1
    compactSize = size
    var slot: usize = 0
    while slot < MAX_SLOTS {
        slots[slot] = -1
        links[slot] = -1
        slot += 1
    }
    var index: usize = 0
    while index < entryCount {
        var depth: usize = 0
        var h = @intCast(usize, rapidhash.hash(entries[index].key) % @intCast(u64, size))
        while slots[h] >= 0 {
            if compactSize > 1000 { s.fail("create_hash_table: The hash size is far too big. This should not be reached.") }
            if depth > 100 { s.fail("create_hash_table: The depth is far too big. This should not be reached.") }
            if links[h] >= 0 {
                h = @intCast(usize, links[h])
                depth += 1
            } else {
                links[h] = @intCast(i64, compactSize)
                h = compactSize
                compactSize += 1
            }
        }
        slots[h] = @intCast(i64, index)
        index += 1
    }
}

// VALUE with its first "js" made "JS", or else its first letter capital.
fn setterOf(value: []const u8) -> []const u8 {
    const at = s.find(value, "js")
    if at < value.length { return s.join3(value[0..at], "JS", value[at + 2..value.length]) }
    return s.capitalized(value)
}

// "PropertyAttribute::A|PropertyAttribute::B" of "A|B".
fn attributesOf(attributes: []const u8) -> []const u8 {
    var text = "static_cast<unsigned>(PropertyAttribute::"
    var start: usize = 0
    var index: usize = 0
    while index <= attributes.length {
        if index == attributes.length || attributes[index] == 124 {
            text = s.join(text, attributes[start..index])
            if index < attributes.length { text = s.join(text, "|PropertyAttribute::") }
            start = index + 1
        }
        index += 1
    }
    return s.join(text, ")")
}

// OBJECT_OFFSETOF(CLASS, MEMBER) of "CLASS::MEMBER".
fn offsetOf(property: []const u8) -> []const u8 {
    var at: usize = 0
    while at < property.length && s.isWord(property[at]) { at += 1 }
    if at == 0 || at + 2 > property.length || property[at] != 58 || property[at + 1] != 58 { s.fail(s.join("create_hash_table: not CLASS::MEMBER: ", property)) }
    return s.join3(s.join3("OBJECT_OFFSETOF(", property[0..at], ", "), property[at + 2..property.length], ")")
}

fn output(name: []const u8) -> void {
    if !banner {
        banner = true
        s.out("// Automatically generated from ")
        s.out(sourceName[0..sourceNameLength])
        s.out(" using create_hash_table. DO NOT EDIT!\n")
    }
    const nameEntries = s.replaceByte(s.join(name, "Values"), 58, 95)
    const nameIndex = s.replaceByte(s.join(name, "Index"), 58, 95)
    s.out("\n")
    if includeBuiltin { s.out("#include \"JSCBuiltins.h\"\n") }
    s.out("#include \"Lookup.h\"\n\nnamespace JSC {\n\n")
    layOut()
    s.out("static constinit const struct CompactHashIndex ")
    s.out(nameIndex)
    s.out("[")
    s.outUnsigned(@intCast(u64, compactSize))
    s.out("] = {\n")
    var slot: usize = 0
    while slot < compactSize {
        s.out("    { ")
        s.outSigned(slots[slot])
        s.out(", ")
        s.outSigned(links[slot])
        s.out(" },\n")
        slot += 1
    }
    s.out("};\n\nstatic constinit const struct HashTableValue ")
    s.out(nameEntries)
    s.out("[")
    s.outUnsigned(@intCast(u64, entryCount))
    s.out("] = {\n")
    var index: usize = 0
    while index < entryCount {
        const e = entries[index]
        const attributes = attributesOf(e.attributes)
        s.out("   { \"")
        s.out(e.key)
        s.out("\"_s, ")
        if e.kind == FUNCTION && std.text.same(e.value, "JSBuiltin") {
            const head = if s.endsWith(name, "Table") { name[0..name.length - 5] } else { name }
            s.out("((")
            s.out(attributes)
            s.out(") & ~PropertyAttribute::Function) | PropertyAttribute::Builtin, ")
            s.out(e.intrinsic)
            s.out(", { HashTableValue::BuiltinGeneratorType, ")
            s.out(head)
            s.out(s.capitalized(e.key))
            s.out("CodeGenerator, ")
            s.out(e.parameters)
            s.out(" } },\n")
        } else {
            s.out(attributes)
            s.out(", ")
            s.out(if e.kind == FUNCTION { e.intrinsic } else { "NoIntrinsic" })
            s.out(", { HashTableValue::")
            if e.kind == FUNCTION {
                s.out("NativeFunctionType, ")
                s.out(e.value)
                s.out(", ")
                s.out(e.parameters)
            } else if e.kind == PROPERTY {
                s.out("GetterSetterType, ")
                s.out(e.value)
                s.out(", ")
                s.out(e.setter)
            } else if e.kind == LEXER {
                s.out("LexerType, ")
                s.out(e.value)
            } else if e.kind == CELL_PROPERTY {
                s.out("LazyCellPropertyType, ")
                s.out(offsetOf(e.value))
            } else if e.kind == CLASS_STRUCTURE {
                s.out("LazyClassStructureType, ")
                s.out(offsetOf(e.value))
            } else {
                s.out("LazyPropertyType, ")
                s.out(e.value)
            }
            s.out(" } },\n")
        }
        index += 1
    }
    s.out("};\n\nstatic constinit const struct HashTable ")
    s.out(name)
    s.out(" =\n    { ")
    s.outUnsigned(@intCast(u64, entryCount))
    s.out(", ")
    s.outUnsigned(@intCast(u64, compactMask))
    s.out(if hasSetter { ", true, nullptr, " } else { ", false, nullptr, " })
    s.out(nameEntries)
    s.out(", ")
    s.out(nameIndex)
    s.out(" };\n\n} // namespace JSC\n")
}

// ---------------------------------------------------------------------------
// The source.

// The name of "@begin NAME [SIZE]", or "" when the line is not one.
fn tableName(line: []const u8) -> []const u8 {
    var at: usize = 6
    while at < line.length && s.isSpace(line[at]) { at += 1 }
    const start = at
    while at < line.length && (s.isWord(line[at]) || line[at] == 58) { at += 1 }
    const end = at
    while at < line.length && s.isSpace(line[at]) { at += 1 }
    while at < line.length && s.isDigit(line[at]) { at += 1 }
    while at < line.length && s.isSpace(line[at]) { at += 1 }
    if end == start || at < line.length { return "" }
    return line[start..end]
}

// Whether every byte of TEXT is a word character (or a bar, with BAR).
fn wordsOnly(text: []const u8, bar: bool) -> bool {
    for byte in text {
        if !s.isWord(byte) && !(bar && byte == 124) { return false }
    }
    return true
}

fn addEntry(line: []const u8) -> void {
    var fields: [5][]const u8 = undefined
    var count: usize = 0
    var at: usize = 0
    while at < line.length {
        while at < line.length && s.isSpace(line[at]) { at += 1 }
        if at == line.length { break }
        const start = at
        while at < line.length && !s.isSpace(line[at]) { at += 1 }
        if count == 5 { s.fail(s.join3("create_hash_table: invalid data {", line, "}")) }
        fields[count] = line[start..at]
        count += 1
    }
    while count < 5 {
        fields[count] = ""
        count += 1
    }
    if fields[1].length == 0 || !wordsOnly(fields[2], true) || !wordsOnly(fields[3], false) || !wordsOnly(fields[4], false) {
        s.fail(s.join3("create_hash_table: invalid data {", line, "}"))
    }
    if entryCount == MAX_ENTRIES { s.fail("create_hash_table: a table too large") }
    const attributes = fields[2]
    var e = Entry.{ .key = fields[0], .value = fields[1], .attributes = if attributes.length > 0 { attributes } else { "None" },
        .parameters = fields[3], .intrinsic = if fields[4].length > 0 { fields[4] } else { "NoIntrinsic" }, .setter = "0", .kind = LEXER }
    if std.text.same(e.value, "JSBuiltin") { includeBuiltin = true }
    if s.contains(attributes, "Function") {
        e.kind = FUNCTION
    } else if s.contains(attributes, "CellProperty") {
        e.kind = CELL_PROPERTY
    } else if s.contains(attributes, "ClassStructure") {
        e.kind = CLASS_STRUCTURE
    } else if s.contains(attributes, "PropertyCallback") {
        e.kind = PROPERTY_CALLBACK
    } else if attributes.length > 0 {
        e.kind = PROPERTY
        if !s.contains(attributes, "ReadOnly") { e.setter = s.join("set", setterOf(e.value)) }
        hasSetter = true
    }
    entries[entryCount] = e
    entryCount += 1
}

fn generate(source: []const u8, outputPath: []const u8) -> void {
    unsafe {
        entries = @ptrFromInt([*]Entry, s.alloc(MAX_ENTRIES * @sizeOf(Entry)))
        slots = @ptrFromInt([*]i64, s.alloc(MAX_SLOTS * 8))
        links = @ptrFromInt([*]i64, s.alloc(MAX_SLOTS * 8))
    }
    const name = s.baseName(source)
    sourceName = name.pointer
    sourceNameLength = name.length
    const text = s.readWhole(source)
    var inside = false
    var table: []const u8 = ""
    var at: usize = 0
    while at < text.length {
        const line = s.trimStart(s.nextLine(text, &at))
        if line.length == 0 || line[0] == 35 { continue }
        if !inside && s.startsWith(line, "@begin") {
            table = tableName(line)
            if table.length > 0 {
                inside = true
            } else {
                s.say(s.join3("WARNING: @begin without table name, skipping ", line, "\n"))
            }
        } else if inside && s.startsWith(line, "@end") && s.trimEnd(line).length == 4 {
            output(table)
            entryCount = 0
            includeBuiltin = false
            inside = false
        } else if inside {
            addEntry(line)
        }
    }
    if inside { s.fail("create_hash_table: missing closing @end") }
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-hash-table SOURCE OUTPUT\n")
        return 2
    }
    generate(s.cString(arguments[1]), s.cString(arguments[2]))
    return 0
}
