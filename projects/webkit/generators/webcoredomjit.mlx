// DOMJITAbstractHeapRepository.h, the abstract heaps of WebCore's DOMJIT
// as ranges, as Source/WebCore/domjit/generate-abstract-heap.rb makes it
// from DOMJITAbstractHeapRepository.yaml:
//
//     webkit-domjit-abstract-heap DOMJITAbstractHeapRepository.yaml OUTPUT.h
//
// The YAML is a tree of heaps: a mapping's keys and a sequence's items are
// the children of their heap. Each leaf takes one number, each heap the
// range of its children's numbers, [first, last); the file draws the tree
// in a comment and defines a JSC::DOMJIT::HeapRange per heap. The first
// top-level key is the root.
const s = @import("./support.mlx")
const yaml = @import("./preferencesyaml.mlx")

const HEADER = "/*\n * Copyright (C) 2016 Apple Inc. All rights reserved.\n *\n * Redistribution and use in source and binary forms, with or without\n * modification, are permitted provided that the following conditions\n * are met:\n * 1. Redistributions of source code must retain the above copyright\n *    notice, this list of conditions and the following disclaimer.\n * 2. Redistributions in binary form must reproduce the above copyright\n *    notice, this list of conditions and the following disclaimer in the\n *    documentation and/or other materials provided with the distribution.\n *\n * THIS SOFTWARE IS PROVIDED BY APPLE INC. ``AS IS'' AND ANY\n * EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE\n * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR\n * PURPOSE ARE DISCLAIMED.  IN NO EVENT SHALL APPLE INC. OR\n * CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL,\n * EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,\n * PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR\n * PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY\n * OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n */\n// Auto-generated file. Do not modify.\n\n#pragma once\n\n#include <JavaScriptCore/DOMJITHeapRange.h>\n\nnamespace WebCore { namespace DOMJIT { namespace AbstractHeapRepository {\n"

const MAX_NODES: usize = 1048576

// The range of each heap, by its node.
var firsts: [*]usize = undefined
var lasts: [*]usize = undefined

// A heap's name: a mapping entry's key, or a sequence item's text.
fn nameOf(node: usize, isItem: bool) -> []const u8 {
    if isItem { return yaml.rubyText(node) }
    return yaml.nodes[node].key
}

// The children of a heap: the entries or items of its node.
fn hasChildren(node: usize) -> bool {
    const kind = yaml.nodes[node].kind
    return (kind == yaml.MAPPING || kind == yaml.SEQUENCE) && yaml.nodes[node].first != yaml.NONE
}

fn itemsAreSequence(node: usize) -> bool { return yaml.nodes[node].kind == yaml.SEQUENCE }

fn compute(node: usize, start: usize) -> void {
    if node >= MAX_NODES { s.fail("webkit-domjit-abstract-heap: the tree is too large") }
    var current = start
    if !hasChildren(node) {
        firsts[node] = start
        lasts[node] = current + 1
        return
    }
    var child = yaml.nodes[node].first
    while child != yaml.NONE {
        compute(child, current)
        current = lasts[child]
        child = yaml.nodes[child].next
    }
    firsts[node] = start
    lasts[node] = current
}

fn shallowDump(node: usize, isItem: bool) -> void {
    s.out(nameOf(node, isItem))
    s.out("<")
    s.outUnsigned(@intCast(u64, firsts[node]))
    s.out(",")
    s.outUnsigned(@intCast(u64, lasts[node]))
    s.out(">")
}

fn deepDump(node: usize, isItem: bool, indent: usize) -> void {
    var index: usize = 0
    while index < indent {
        s.out("    ")
        index += 1
    }
    shallowDump(node, isItem)
    if !hasChildren(node) {
        s.out("\n")
        return
    }
    s.out(":\n")
    var child = yaml.nodes[node].first
    while child != yaml.NONE {
        deepDump(child, itemsAreSequence(node), indent + 1)
        child = yaml.nodes[child].next
    }
}

fn generate(node: usize, isItem: bool) -> void {
    s.out("constexpr JSC::DOMJIT::HeapRange ")
    s.out(nameOf(node, isItem))
    s.out("(JSC::DOMJIT::HeapRange::ConstExpr, ")
    s.outUnsigned(@intCast(u64, firsts[node]))
    s.out(", ")
    s.outUnsigned(@intCast(u64, lasts[node]))
    s.out(");\n")
    if !hasChildren(node) { return }
    var child = yaml.nodes[node].first
    while child != yaml.NONE {
        generate(child, itemsAreSequence(node))
        child = yaml.nodes[child].next
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 3 {
        s.say("usage: webkit-domjit-abstract-heap DOMJITAbstractHeapRepository.yaml OUTPUT.h\n")
        return 1
    }
    unsafe {
        firsts = @ptrFromInt([*]usize, s.alloc(MAX_NODES * 8))
        lasts = @ptrFromInt([*]usize, s.alloc(MAX_NODES * 8))
    }
    const top = yaml.load(s.cString(arguments[1]))
    if !hasChildren(top) { s.fail("NoMethodError: the tree has no heap") }
    const root = yaml.nodes[top].first
    const rootIsItem = itemsAreSequence(top)
    compute(root, 0)
    s.out(HEADER)
    s.out("/* DOMJIT Abstract Heap Tree.\n")
    deepDump(root, rootIsItem, 0)
    s.out("*/\n")
    generate(root, rootIsItem)
    s.out("} } }\n")
    s.writeOutput(s.cString(arguments[2]))
    return 0
}
