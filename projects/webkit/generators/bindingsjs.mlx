// WebKit's CodeGeneratorJS.pm, the JavaScript bindings of WebCore: for an
// interface, a dictionary, an enumeration or a callback, the text of its
// JS<Name>.h and JS<Name>.cpp (and the JS<Name>.dep listing the IDL files
// they depend on). This file has the generator's state, the members it
// adds to interfaces, the includes, and the legacy platform object hooks;
// bindingsjstypes.mlx, bindingsjsdict.mlx, bindingsjsheader.mlx,
// bindingsjsimpl.mlx and bindingsjsmore.mlx have the rest, function by
// function as the Perl has them.
const std = @import("std")
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const t = @import("./bindingsjstypes.mlx")
const d = @import("./bindingsjsdict.mlx")
const h = @import("./bindingsjsheader.mlx")
const im = @import("./bindingsjsimpl.mlx")
const mo = @import("./bindingsjsmore.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

// ---------------------------------------------------------------------------
// The text being made, as the Perl's module variables.

pub var headerContentHeader: *StrList = undefined
pub var headerContent: *StrList = undefined
pub var headerIncludes: *r.Map = undefined
pub var headerTrailingIncludes: *r.Map = undefined
pub var implContentHeader: *StrList = undefined
pub var implContent: *StrList = undefined
pub var implIncludes: *r.Map = undefined
pub var auxImplContent: *StrList = undefined
pub var auxImplIncludes: *r.Map = undefined
pub var auxImplActive: bool = false
pub var depsContent: *StrList = undefined
pub var hasNonTrivialFinishCreation: bool = false
pub var hasNonDefaultFinishCreation: bool = false
var stateMade: bool = false

fn newStrList() -> *StrList {
    const l: *StrList = unsafe { @ptrFromInt(*StrList, r.alloc(@sizeOf(StrList))) }
    l.* = r.strList()
    return l
}

fn ensureState() -> void {
    if stateMade { return }
    stateMade = true
    headerContentHeader = newStrList()
    headerContent = newStrList()
    headerIncludes = r.newMap()
    headerTrailingIncludes = r.newMap()
    implContentHeader = newStrList()
    implContent = newStrList()
    implIncludes = r.newMap()
    auxImplContent = newStrList()
    auxImplIncludes = r.newMap()
    depsContent = newStrList()
}

// Short forms for what the Perl writes most.
pub fn p(out: *StrList, text: Str) -> void { r.spush(out, text) }
pub fn cat(parts: []const Str) -> Str { return r.cat(parts) }
pub fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
pub fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
pub fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }

pub const beginAppleCopyrightForHeaderFiles = "// ------- Begin Apple Copyright -------\n/*\n * Copyright (C) 2008 Apple Inc. All rights reserved.\n *\n * Permission is granted by Apple to use this file to the extent\n * necessary to relink with LGPL WebKit files.\n *\n * No license or rights are granted by Apple expressly or by\n * implication, estoppel, or otherwise, to Apple patents and\n * trademarks. For the sake of clarity, no license or rights are\n * granted by Apple expressly or by implication, estoppel, or otherwise,\n * under any Apple patents, copyrights and trademarks to underlying\n * implementations of any application programming interfaces (APIs)\n * or to any functionality that is invoked by calling any API.\n */\n\n"
pub const beginAppleCopyrightForSourceFiles = "// ------- Begin Apple Copyright -------\n/*\n * Copyright (C) 2008 Apple Inc. All rights reserved.\n *\n * No license or rights are granted by Apple expressly or by implication,\n * estoppel, or otherwise, to Apple copyrights, patents, trademarks, trade\n * secrets or other rights.\n */\n\n"
pub const endAppleCopyright = "// ------- End Apple Copyright   -------\n\n"
pub const headerTemplate = "/*\n    This file is part of the WebKit open source project.\n    This file has been generated by generate-bindings.pl. DO NOT MODIFY!\n\n    This library is free software; you can redistribute it and/or\n    modify it under the terms of the GNU Library General Public\n    License as published by the Free Software Foundation; either\n    version 2 of the License, or (at your option) any later version.\n\n    This library is distributed in the hope that it will be useful,\n    but WITHOUT ANY WARRANTY; without even the implied warranty of\n    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU\n    Library General Public License for more details.\n\n    You should have received a copy of the GNU Library General Public License\n    along with this library; see the file COPYING.LIB.  If not, write to\n    the Free Software Foundation, Inc., 51 Franklin Street, Fifth Floor,\n    Boston, MA 02110-1301, USA.\n*/\n"

// ---------------------------------------------------------------------------
// What CodeGenerator asks of the generator.

pub fn generateEnumeration(enumeration: *Node) -> void {
    ensureState()
    const className = d.getEnumerationClassName(enumeration.*.ty.?)
    d.generateEnumerationHeader(enumeration, className)
    d.generateEnumerationImplementation(enumeration, className)
}

pub fn generateDictionary(dictionary: *Node, enumerations: r.List, otherDictionaries: r.List) -> void {
    ensureState()
    const className = d.getDictionaryClassName(dictionary.*.ty.?)
    d.generateDictionaryHeader(dictionary, className, enumerations, otherDictionaries)
    d.generateDictionaryImplementation(dictionary, className, enumerations, otherDictionaries)
}

pub fn generateCallbackFunction(callback: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    ensureState()
    d.generateCallbackFunctionHeader(callback, enumerations, dictionaries)
    d.generateCallbackFunctionImplementation(callback, enumerations, dictionaries)
}

pub fn generateInterface(interface: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    ensureState()
    cg.linkOverloadedOperations(interface)
    addIterableOperationIfNeeded(interface)
    addAsyncIterableOperationIfNeeded(interface)
    addMapLikeAttributesAndOperationIfNeeded(interface)
    addSetLikeAttributesAndOperationIfNeeded(interface)
    addStringifierOperationIfNeeded(interface)
    mo.addSharedSyntheticAttributesIfNeeded(interface)
    if interface.*.isCallback {
        d.generateCallbackInterfaceHeader(interface, enumerations, dictionaries)
        d.generateCallbackInterfaceImplementation(interface, enumerations, dictionaries)
    } else {
        im.generateImplementation(interface, enumerations, dictionaries)
        h.generateHeader(interface, enumerations, dictionaries)
    }
}

// ---------------------------------------------------------------------------
// Members added to the interface.

fn newOperation(name: Str) -> *Node {
    const operation = m.newNode(m.K_OPERATION)
    operation.*.name = name
    return operation
}

fn newArgument(name: Str, ty: *IDLType) -> *Node {
    const argument = m.newNode(m.K_ARGUMENT)
    argument.*.name = name
    argument.*.ty = ty
    return argument
}

fn addAsyncIterableOperationIfNeeded(interface: *Node) -> void {
    if interface.*.asyncIterable == null { return }
    m.set(interface.*.asyncIterable.?.*.ext, "FromIterable", "1")
    addGenericIterableOperations(interface, interface.*.asyncIterable.?, "[Symbol.asyncIterator]", false)
}

fn addIterableOperationIfNeeded(interface: *Node) -> void {
    if interface.*.iterable == null { return }
    const iterable = interface.*.iterable.?
    m.set(iterable.*.ext, "FromIterable", "1")
    addGenericIterableOperations(interface, iterable, "[Symbol.Iterator]", true)
    const forEach = newOperation("forEach")
    r.push(&forEach.*.arguments, @intFromPtr(newArgument("callback", m.newType("any"))))
    m.copyInto(forEach.*.ext, iterable.*.ext)
    r.push(&iterable.*.operations, @intFromPtr(forEach))
    if mo.isKeyValueIterableInterface(interface) { r.push(&interface.*.operations, @intFromPtr(forEach)) }
}

fn addIterableOperation(interface: *Node, iterable: *Node, name: Str) -> void {
    const operation = newOperation(name)
    m.copyInto(operation.*.ext, iterable.*.ext)
    r.push(&iterable.*.operations, @intFromPtr(operation))
    if mo.isKeyValueIterableInterface(interface) { r.push(&interface.*.operations, @intFromPtr(operation)) }
}

fn addGenericIterableOperations(interface: *Node, iterable: *Node, iteratorName: Str, isSync: bool) -> void {
    addIterableOperation(interface, iterable, iteratorName)
    if iterable.*.isKeyValue || isSync {
        addIterableOperation(interface, iterable, "entries")
        addIterableOperation(interface, iterable, "keys")
    }
    addIterableOperation(interface, iterable, "values")
}

// Whether a member of the interface (attribute, operation or constant) is named NAME.
fn hasMemberNamed(interface: *Node, name: Str) -> bool {
    const lists = [3]r.List{ interface.*.attributes, interface.*.operations, interface.*.constants }
    for l in lists {
        var index: usize = 0
        while index < l.count {
            if std.text.same(m.node(l, index).*.name, name) { return true }
            index += 1
        }
    }
    return false
}

fn likeOperation(interface: *Node, like: *Node, name: Str) -> *Node {
    const operation = newOperation(name)
    operation.*.ty = m.newType("any")
    return operation
}

fn pushLikeOperation(interface: *Node, like: *Node, operation: *Node) -> void {
    m.copyInto(operation.*.ext, like.*.ext)
    r.push(&interface.*.operations, @intFromPtr(operation))
}

fn addSizeAttribute(interface: *Node, like: *Node) -> void {
    const size = m.newNode(m.K_ATTRIBUTE)
    size.*.name = "size"
    size.*.isReadOnly = true
    size.*.ty = m.newType("any")
    m.copyInto(size.*.ext, like.*.ext)
    r.push(&interface.*.attributes, @intFromPtr(size))
}

fn addMapLikeAttributesAndOperationIfNeeded(interface: *Node) -> void {
    if interface.*.mapLike == null { return }
    const like = interface.*.mapLike.?
    m.set(like.*.ext, "ForwardToMapLike", "1")
    addSizeAttribute(interface, like)

    const get = newOperation("get")
    r.push(&get.*.arguments, @intFromPtr(newArgument("key", m.cloneType(like.*.keyType.?))))
    get.*.ty = m.newType("any")
    pushLikeOperation(interface, like, get)

    const hasOperation = newOperation("has")
    r.push(&hasOperation.*.arguments, @intFromPtr(newArgument("key", m.cloneType(like.*.keyType.?))))
    hasOperation.*.ty = m.newType("any")
    pushLikeOperation(interface, like, hasOperation)

    pushLikeOperation(interface, like, likeOperation(interface, like, "entries"))
    pushLikeOperation(interface, like, likeOperation(interface, like, "keys"))
    pushLikeOperation(interface, like, likeOperation(interface, like, "values"))

    const forEach = likeOperation(interface, like, "forEach")
    r.push(&forEach.*.arguments, @intFromPtr(newArgument("callback", m.newType("any"))))
    pushLikeOperation(interface, like, forEach)

    if like.*.isReadOnly { return }

    if !hasMemberNamed(interface, "set") {
        const set = newOperation("set")
        r.push(&set.*.arguments, @intFromPtr(newArgument("key", m.cloneType(like.*.keyType.?))))
        r.push(&set.*.arguments, @intFromPtr(newArgument("value", m.cloneType(like.*.valueType.?))))
        set.*.ty = m.newType("any")
        pushLikeOperation(interface, like, set)
    }
    if !hasMemberNamed(interface, "clear") { pushLikeOperation(interface, like, likeOperation(interface, like, "clear")) }
    if !hasMemberNamed(interface, "delete") {
        const remove = newOperation("delete")
        r.push(&remove.*.arguments, @intFromPtr(newArgument("key", m.cloneType(like.*.keyType.?))))
        remove.*.ty = m.newType("any")
        pushLikeOperation(interface, like, remove)
    }
}

fn addSetLikeAttributesAndOperationIfNeeded(interface: *Node) -> void {
    if interface.*.setLike == null { return }
    const like = interface.*.setLike.?
    m.set(like.*.ext, "ForwardToSetLike", "1")
    addSizeAttribute(interface, like)

    const hasOperation = newOperation("has")
    r.push(&hasOperation.*.arguments, @intFromPtr(newArgument("key", m.cloneType(like.*.itemType.?))))
    hasOperation.*.ty = m.newType("any")
    pushLikeOperation(interface, like, hasOperation)

    pushLikeOperation(interface, like, likeOperation(interface, like, "entries"))
    pushLikeOperation(interface, like, likeOperation(interface, like, "keys"))
    pushLikeOperation(interface, like, likeOperation(interface, like, "values"))

    const forEach = newOperation("forEach")
    r.push(&forEach.*.arguments, @intFromPtr(newArgument("callback", m.newType("any"))))
    forEach.*.ty = m.newType("any")
    pushLikeOperation(interface, like, forEach)

    if like.*.isReadOnly { return }

    if !hasMemberNamed(interface, "add") {
        const add = newOperation("add")
        r.push(&add.*.arguments, @intFromPtr(newArgument("key", m.cloneType(like.*.itemType.?))))
        add.*.ty = m.newType("any")
        pushLikeOperation(interface, like, add)
    }
    if !hasMemberNamed(interface, "clear") { pushLikeOperation(interface, like, likeOperation(interface, like, "clear")) }
    if !hasMemberNamed(interface, "delete") {
        const remove = newOperation("delete")
        r.push(&remove.*.arguments, @intFromPtr(newArgument("key", m.cloneType(like.*.itemType.?))))
        remove.*.ty = m.newType("any")
        pushLikeOperation(interface, like, remove)
    }
}

fn addStringifierOperationIfNeeded(interface: *Node) -> void {
    const lists = [3]r.List{ interface.*.attributes, interface.*.operations, interface.*.anonymousOperations }
    for l in lists {
        var index: usize = 0
        while index < l.count {
            const property = m.node(l, index)
            index += 1
            if !property.*.isStringifier { continue }
            if property.*.kind == m.K_ATTRIBUTE {
                if !(std.text.same(typeName(property), "DOMString") || std.text.same(typeName(property), "USVString")) { r.die("stringifier can only be used on attributes with type DOMString or USVString") }
            }
            if property.*.kind == m.K_OPERATION {
                if !std.text.same(typeName(property), "DOMString") { r.die("stringifier can only be used on operations with a return type of DOMString") }
                if property.*.arguments.count != 0 { r.die("stringifier can only be used on operations with zero arguments") }
                if std.text.same(property.*.name, "toString") { return }
            }
            const stringifier = newOperation("toString")
            stringifier.*.ty = m.cloneType(property.*.ty.?)
            stringifier.*.isStringifier = true
            m.copyInto(stringifier.*.ext, property.*.ext)
            if r.truthy(property.*.name) && !on(stringifier, "ImplementedAs") { m.set(stringifier.*.ext, "ImplementedAs", property.*.name) }
            if property.*.kind == m.K_ATTRIBUTE && !property.*.isReadOnly && on(stringifier, "CEReactions") { m.remove(stringifier.*.ext, "CEReactions") }
            r.push(&interface.*.operations, @intFromPtr(stringifier))
            return
        }
    }
}

pub fn eventHandlerAttributeShortEventName(attribute: *Node) -> Str {
    const eventType = r.orElse(ext(attribute, "ImplementedAs"), attribute.*.name)
    return r.c2(r.substrFrom(eventType, 2), "Event")
}

pub fn eventHandlerAttributeEventName(attribute: *Node) -> Str { return r.c2("eventNames().", eventHandlerAttributeShortEventName(attribute)) }

pub fn getParentClassName(interface: *Node) -> Str {
    if on(interface, "JSLegacyParent") { return ext(interface, "JSLegacyParent") }
    if !needsImplementationClass(interface) { return "JSDOMObject" }
    if interface.*.parentType != null { return r.c2("JS", interface.*.parentType.?.*.name) }
    if on(interface, "EmbedderArrayLike") { return r.c3("JSDOMEmbedderArrayLikeWrapper<", mo.getImplClassName(interface), ">") }
    if mo.hasTaggedWrapperForInterface(interface) { return cat([_]Str{ "JSDOMWrapper<", mo.getImplClassName(interface), ", SignedPtrTraits<", mo.getImplClassName(interface), ", ", mo.getImplClassPtrTag(interface), ">>" }[0..]) }
    return r.c3("JSDOMWrapper<", mo.getImplClassName(interface), ">")
}

pub fn getCallbackClassName(className: Str) -> Str { return r.c2("JS", className) }

pub fn getExportMacroForJSClass(interface: *Node) -> Str {
    if on(interface, "ExportMacro") { return r.c2(ext(interface, "ExportMacro"), " ") }
    return ""
}

pub fn addIncludesForImplementationTypeInImpl(implementationType: Str) -> void { r.setStr(implIncludes, r.c2(implementationType, ".h"), "1") }
pub fn addIncludesForImplementationTypeInHeader(implementationType: Str) -> void { r.setStr(headerIncludes, r.c2(implementationType, ".h"), "1") }

pub fn addToImplIncludesForIDLType(ty: *IDLType, conditional: Str) -> void { addToIncludesForIDLType(ty, implIncludes, conditional) }

pub fn addToIncludesForIDLType(ty: *IDLType, includes: *r.Map, conditional: Str) -> void {
    if ty.*.isNullable { addToIncludes("JSDOMConvertNullable.h", includes, conditional) }
    const overrideType = m.get(ty.*.ext, "OverrideIDLType")
    if r.truthy(overrideType) {
        if std.text.same(overrideType, "IDLIDBKey") {
            addToIncludes("JSDOMConvertIndexedDB.h", includes, conditional)
            return
        }
        if std.text.same(overrideType, "IDLWebGLAny") || std.text.same(overrideType, "IDLWebGLExtensionAny") {
            addToIncludes("JSDOMConvertWebGL.h", includes, conditional)
            return
        }
    }
    const name = ty.*.name
    if std.text.same(name, "undefined") {
        addToIncludes("IDLTypes.h", includes, conditional)
        addToIncludes("JSDOMConvertBase.h", includes, conditional)
        return
    }
    if std.text.same(name, "any") {
        addToIncludes("JSDOMConvertAny.h", includes, conditional)
        return
    }
    if std.text.same(name, "boolean") {
        addToIncludes("JSDOMConvertBoolean.h", includes, conditional)
        return
    }
    if cg.isBufferSourceType(ty) || m.on(ty.*.ext, "AllowShared") {
        addToIncludes("JSDOMConvertBufferSource.h", includes, conditional)
        addToIncludes("JSDOMConvertUnion.h", includes, conditional)
        return
    }
    if cg.isCallbackFunction(ty) || cg.isCallbackInterface(ty) {
        addToIncludes(cat([_]Str{ "JS", name, ".h" }[0..]), includes, conditional)
        addToIncludes("JSDOMConvertCallbacks.h", includes, conditional)
        return
    }
    if std.text.same(name, "Date") {
        addToIncludes("JSDOMConvertDate.h", includes, conditional)
        return
    }
    if cg.isExternalDictionaryType(ty) {
        addToIncludes(cat([_]Str{ "JS", name, ".h" }[0..]), includes, conditional)
        addToIncludes("JSDOMConvertDictionary.h", includes, conditional)
        return
    }
    if cg.isExternalEnumType(ty) {
        addToIncludes(cat([_]Str{ "JS", name, ".h" }[0..]), includes, conditional)
        addToIncludes("JSDOMConvertEnumeration.h", includes, conditional)
        return
    }
    if std.text.same(name, "EventListener") {
        addToIncludes("JSEventListener.h", includes, conditional)
        addToIncludes("JSDOMConvertEventListener.h", includes, conditional)
        return
    }
    if std.text.same(name, "XPathNSResolver") {
        addToIncludes("JSXPathNSResolver.h", includes, conditional)
        addToIncludes("JSDOMConvertXPathNSResolver.h", includes, conditional)
        return
    }
    if cg.isInterfaceType(ty) {
        addToIncludes(cat([_]Str{ "JS", name, ".h" }[0..]), includes, conditional)
        addToIncludes("JSDOMConvertInterface.h", includes, conditional)
        return
    }
    if std.text.same(name, "JSON") {
        addToIncludes("JSDOMConvertJSON.h", includes, conditional)
        return
    }
    if cg.isNumericType(ty) {
        addToIncludes("JSDOMConvertNumbers.h", includes, conditional)
        return
    }
    if std.text.same(name, "object") {
        addToIncludes("JSDOMConvertObject.h", includes, conditional)
        return
    }
    if cg.isPromiseType(ty) {
        addToIncludes("DOMPromiseProxy.h", includes, conditional)
        addToIncludes("JSDOMConvertPromise.h", includes, conditional)
        addToIncludesForIDLType(m.subtype(ty, 0), includes, conditional)
        return
    }
    if cg.isRecordType(ty) {
        addToIncludes("<wtf/Vector.h>", includes, conditional)
        addToIncludes("JSDOMConvertRecord.h", includes, conditional)
        addToIncludesForIDLType(m.subtype(ty, 0), includes, conditional)
        addToIncludesForIDLType(m.subtype(ty, 1), includes, conditional)
        return
    }
    if cg.isSequenceOrFrozenArrayType(ty) {
        addToIncludes("<JavaScriptCore/JSArray.h>", includes, conditional)
        addToIncludes("JSDOMConvertSequences.h", includes, conditional)
        addToIncludesForIDLType(m.subtype(ty, 0), includes, conditional)
        return
    }
    if std.text.same(name, "ScheduledAction") {
        addToIncludes("JSDOMConvertScheduledAction.h", includes, conditional)
        return
    }
    if std.text.same(name, "SerializedScriptValue") {
        addToIncludes("SerializedScriptValue.h", includes, conditional)
        addToIncludes("JSDOMConvertSerializedScriptValue.h", includes, conditional)
        return
    }
    if cg.isStringType(ty) {
        addToIncludes("JSDOMConvertStrings.h", includes, conditional)
        return
    }
    if ty.*.isUnion {
        addToIncludes("<wtf/Variant.h>", includes, conditional)
        addToIncludes("JSDOMConvertUnion.h", includes, conditional)
        var index: usize = 0
        while index < ty.*.subtypes.count {
            addToIncludesForIDLType(m.subtype(ty, index), includes, conditional)
            index += 1
        }
        return
    }
}

pub fn addToImplIncludes(header: Str, conditional: Str) -> void {
    if auxImplActive {
        addToIncludes(header, auxImplIncludes, conditional)
        return
    }
    addToIncludes(header, implIncludes, conditional)
}

pub fn addToImplInclude(header: Str) -> void { addToImplIncludes(header, r.undef()) }

pub fn addToAuxImplIncludes(header: Str, conditional: Str) -> void { addToIncludes(header, auxImplIncludes, conditional) }

pub fn addToIncludes(header: Str, includes: *r.Map, conditionalValue: Str) -> void {
    var conditional = conditionalValue
    if r.truthy(conditional) && (conditional[0] == 34 || conditional[0] == 39) { conditional = cg.unquoteStringLiteral(conditional) }
    if !r.truthy(conditional) {
        r.setStr(includes, header, "1")
    } else if !r.has(includes, header) {
        r.setStr(includes, header, conditional)
    } else {
        const old = r.getStr(includes, header)
        if !std.text.same(old, "1") { r.setStr(includes, header, r.c3(old, "|", conditional)) }
    }
}

pub fn isReadonly(attribute: *Node) -> bool {
    return attribute.*.isReadOnly && !on(attribute, "Replaceable") && !on(attribute, "PutForwards") && !on(attribute, "LegacyLenientSetter")
}

pub fn useStandaloneConstructorAttributes(interface: *Node) -> bool {
    if cg.ignoreStandaloneConstructorAttributes { return false }
    return on(interface, "StandaloneConstructorAttributes")
}

pub fn addClassForwardIfNeeded(ty: *IDLType) -> void {
    if cg.isSVGAnimatedType(ty) { return }
    if cg.isBufferSourceType(ty) { return }
    p(headerContent, cat([_]Str{ "class ", ty.*.name, ";\n\n" }[0..]))
}

pub fn getGenerateIsReachable(interface: *Node) -> Str { return ext(interface, "GenerateIsReachable") }
pub fn getCustomIsReachable(interface: *Node) -> Str { return ext(interface, "CustomIsReachable") }

pub fn isDOMGlobalObject(interface: *Node) -> bool {
    return std.text.same(typeName(interface), "DOMWindow") || cg.inheritsInterface(interface, "WorkerGlobalScope") || cg.inheritsInterface(interface, "WorkletGlobalScope") || std.text.same(typeName(interface), "ShadowRealmGlobalScope") || std.text.same(typeName(interface), "TestGlobalObject")
}

pub fn shouldUseGlobalObjectPrototype(interface: *Node) -> bool {
    if std.text.same(typeName(interface), "WorkerGlobalScope") { return false }
    if std.text.same(typeName(interface), "WorkletGlobalScope") { return false }
    return isDOMGlobalObject(interface)
}

pub fn shouldUseOrdinaryObjectPrototype(interface: *Node) -> bool { return interface.*.isNamespaceObject || std.text.same(typeName(interface), "ShadowRealmGlobalScope") }

pub fn shouldCreateWithJSGlobalProxy(interface: *Node) -> bool {
    return std.text.same(typeName(interface), "ShadowRealmGlobalScope") || cg.inheritsInterface(interface, "WorkerGlobalScope") || cg.inheritsInterface(interface, "WorkletGlobalScope")
}

// ---------------------------------------------------------------------------
// Legacy platform objects: indexed and named properties.

// The condition, the conversion and the attributes of an indexed getter.
fn generateIndexedGetter(interface: *Node, operation: *Node, indexExpression: Str) -> (Str, Str, Str) {
    var attributes = r.strList()
    if mo.getIndexedSetterOperation(interface) == null && !on(interface, "Plugin") { r.spush(&attributes, "JSC::PropertyAttribute::ReadOnly") }
    const functionName = r.orElse(ext(operation, "ImplementedAs"), r.orElse(operation.*.name, "item"))
    var condition: Str = ""
    var conversion: Str = ""
    if on(operation, "RaisesException") {
        condition = r.c2(indexExpression, " < thisObject->wrapped().length()")
        conversion = t.nativeToJSValueUsingPointers(operation, interface, cat([_]Str{ "thisObject->wrapped().", functionName, "(", indexExpression, ")" }[0..]), "*thisObject->realm()")
    } else {
        condition = cat([_]Str{ "auto item = thisObject->wrapped().", functionName, "(", indexExpression, "); !!item" }[0..])
        const idlType = t.getIDLType(interface, operation.*.ty.?)
        const extract = r.c2(idlType, "::extractValueFromNullable(WTF::move(item))")
        conversion = t.nativeToJSValueUsingPointers(operation, interface, extract, "*thisObject->realm()")
    }
    return -> (condition, conversion, mo.stringifyJSCAttributes(attributes))
}

fn generateNamedGetter(interface: *Node, operation: *Node, namedPropertyExpression: Str) -> (Str, Str) {
    var attributes = r.strList()
    if mo.getNamedSetterOperation(interface) == null && !on(interface, "Plugin") { r.spush(&attributes, "JSC::PropertyAttribute::ReadOnly") }
    if on(interface, "LegacyUnenumerableNamedProperties") { r.spush(&attributes, "JSC::PropertyAttribute::DontEnum") }
    const conversion = t.nativeToJSValueUsingPointers(operation, interface, namedPropertyExpression, "*thisObject->realm()")
    return -> (conversion, mo.stringifyJSCAttributes(attributes))
}

fn generateNamedGetterLambda(out: *StrList, indent: Str, interface: *Node, className: Str, operation: *Node, functionName: Str, idlType: Str) -> void {
    var arguments = im.generateCallWithUsingReferences(ext(operation, "CallWith"), out, "std::nullopt", "thisObject", "", "        ")
    r.spush(&arguments, "propertyNameToAtomString(propertyName)")
    p(out, cat([_]Str{ indent, "    auto getterFunctor = visibleNamedPropertyItemAccessorFunctor<", idlType, ", ", className, ">([] (", className, "& thisObject, PropertyName propertyName) -> decltype(auto) {\n" }[0..]))
    p(out, cat([_]Str{ indent, "        return thisObject.wrapped().", functionName, "(", r.sjoin(arguments, ", "), ");\n" }[0..]))
    p(out, r.c2(indent, "    });\n"))
}

fn overrideBuiltinOf(interface: *Node) -> Str {
    return if cg.inheritsExtendedAttribute(interface, "LegacyOverrideBuiltIns") { "LegacyOverrideBuiltIns::Yes" } else { "LegacyOverrideBuiltIns::No" }
}

pub fn generateGetOwnPropertySlot(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomGetOwnPropertySlot") { return }
    const namedGetter = mo.getNamedGetterOperation(interface)
    const indexedGetter = mo.getIndexedGetterOperation(interface)
    p(out, cat([_]Str{ "bool ", className, "::legacyPlatformObjectGetOwnProperty(JSObject* object, JSGlobalObject* lexicalGlobalObject, PropertyName propertyName, PropertySlot& slot, bool ignoreNamedProperties)\n" }[0..]))
    p(out, "{\n")
    if namedGetter == null { p(out, "    UNUSED_PARAM(ignoreNamedProperties);\n") }
    if namedGetter != null || indexedGetter != null { p(out, "    auto throwScope = DECLARE_THROW_SCOPE(JSC::getVM(lexicalGlobalObject));\n") }
    p(out, cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(object);\n" }[0..]))
    p(out, "    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n")
    if indexedGetter != null {
        p(out, "    if (auto index = parseIndex(propertyName)) {\n")
        const g = generateIndexedGetter(interface, indexedGetter.?, "index.value()")
        p(out, cat([_]Str{ "        if (", g.0, ") [[likely]] {\n" }[0..]))
        p(out, cat([_]Str{ "            auto value = ", g.1, ";\n" }[0..]))
        p(out, "            RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, cat([_]Str{ "            slot.setValue(thisObject, ", g.2, ", value);\n" }[0..]))
        p(out, "            return true;\n")
        p(out, "        }\n")
        if namedGetter != null || on(interface, "Plugin") { p(out, "        return WebCore::getOwnPropertySlot(object, lexicalGlobalObject, propertyName, slot);\n") }
        p(out, "    }\n")
    }
    if namedGetter != null {
        const op = namedGetter.?
        p(out, "    if (!ignoreNamedProperties) {\n")
        addToImplInclude("JSDOMAbstractOperations.h")
        const functionName = r.orElse(ext(op, "ImplementedAs"), r.orElse(op.*.name, "namedItem"))
        const idlType = t.getIDLTypeExcludingNullability(interface, op.*.ty.?)
        p(out, cat([_]Str{ "        using GetterIDLType = ", idlType, ";\n" }[0..]))
        generateNamedGetterLambda(out, "    ", interface, className, op, functionName, "GetterIDLType")
        p(out, cat([_]Str{ "        if (auto namedProperty = accessVisibleNamedProperty<", overrideBuiltinOf(interface), ">(*lexicalGlobalObject, *thisObject, propertyName, getterFunctor)) {\n" }[0..]))
        const g = generateNamedGetter(interface, op, "WTF::move(namedProperty.value())")
        p(out, cat([_]Str{ "            auto value = ", g.0, ";\n" }[0..]))
        p(out, "            RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, cat([_]Str{ "            slot.setValue(thisObject, ", g.1, ", value);\n" }[0..]))
        p(out, "            return true;\n")
        p(out, "        }\n")
        p(out, "    }\n")
    }
    if on(interface, "Plugin") {
        addToImplInclude("JSPluginElementFunctions.h")
        p(out, "    if (pluginElementCustomGetOwnPropertySlot(thisObject, lexicalGlobalObject, propertyName, slot))\n")
        p(out, "        return true;\n")
        p(out, "    ASSERT(slot.isTaintedByOpaqueObject());\n")
        p(out, "    if (slot.isVMInquiry())\n")
        p(out, "        return false;\n")
    }
    p(out, "    return WebCore::getOwnPropertySlot(object, lexicalGlobalObject, propertyName, slot);\n")
    p(out, "}\n\n")
    p(out, cat([_]Str{ "bool ", className, "::getOwnPropertySlot(JSObject* object, JSGlobalObject* lexicalGlobalObject, PropertyName propertyName, PropertySlot& slot)\n" }[0..]))
    p(out, "{\n")
    p(out, "    bool ignoreNamedProperties = false;\n")
    p(out, "    return legacyPlatformObjectGetOwnProperty(object, lexicalGlobalObject, propertyName, slot, ignoreNamedProperties);\n")
    p(out, "}\n\n")
}

pub fn generateGetOwnPropertySlotByIndex(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomGetOwnPropertySlot") { return }
    var didGeneratePropertyName = false
    const namedGetter = mo.getNamedGetterOperation(interface)
    const indexedGetter = mo.getIndexedGetterOperation(interface)
    p(out, cat([_]Str{ "bool ", className, "::getOwnPropertySlotByIndex(JSObject* object, JSGlobalObject* lexicalGlobalObject, unsigned index, PropertySlot& slot)\n" }[0..]))
    p(out, "{\n")
    p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
    if namedGetter != null || indexedGetter != null { p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n") }
    p(out, cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(object);\n" }[0..]))
    p(out, "    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n")
    if indexedGetter != null {
        p(out, "    if (index <= MAX_ARRAY_INDEX) [[likely]] {\n")
        const g = generateIndexedGetter(interface, indexedGetter.?, "index")
        p(out, cat([_]Str{ "        if (", g.0, ") [[likely]] {\n" }[0..]))
        p(out, cat([_]Str{ "            auto value = ", g.1, ";\n" }[0..]))
        p(out, "            RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, cat([_]Str{ "            slot.setValue(thisObject, ", g.2, ", value);\n" }[0..]))
        p(out, "            return true;\n")
        p(out, "        }\n")
        if namedGetter != null || on(interface, "Plugin") { p(out, "        return JSObject::getOwnPropertySlotByIndex(object, lexicalGlobalObject, index, slot);\n") }
        p(out, "    }\n")
    }
    if namedGetter != null {
        const op = namedGetter.?
        addToImplInclude("JSDOMAbstractOperations.h")
        if !didGeneratePropertyName {
            p(out, "    auto propertyName = Identifier::from(vm, index);\n")
            didGeneratePropertyName = true
        }
        const functionName = r.orElse(ext(op, "ImplementedAs"), r.orElse(op.*.name, "namedItem"))
        const idlType = t.getIDLTypeExcludingNullability(interface, op.*.ty.?)
        p(out, cat([_]Str{ "    using GetterIDLType = ", idlType, ";\n" }[0..]))
        generateNamedGetterLambda(out, "", interface, className, op, functionName, "GetterIDLType")
        p(out, cat([_]Str{ "    if (auto namedProperty = accessVisibleNamedProperty<", overrideBuiltinOf(interface), ">(*lexicalGlobalObject, *thisObject, propertyName, getterFunctor)) {\n" }[0..]))
        const g = generateNamedGetter(interface, op, "WTF::move(namedProperty.value())")
        p(out, cat([_]Str{ "        auto value = ", g.0, ";\n" }[0..]))
        p(out, "        RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, cat([_]Str{ "        slot.setValue(thisObject, ", g.1, ", value);\n" }[0..]))
        p(out, "        return true;\n")
        p(out, "    }\n")
    }
    if on(interface, "Plugin") {
        if !didGeneratePropertyName {
            p(out, "    auto propertyName = Identifier::from(vm, index);\n")
            didGeneratePropertyName = true
        }
        addToImplInclude("JSPluginElementFunctions.h")
        p(out, "    if (pluginElementCustomGetOwnPropertySlot(thisObject, lexicalGlobalObject, propertyName, slot))\n")
        p(out, "        return true;\n")
        p(out, "    ASSERT(slot.isTaintedByOpaqueObject());\n")
        p(out, "    if (slot.isVMInquiry())\n")
        p(out, "        return false;\n")
    }
    p(out, "    return JSObject::getOwnPropertySlotByIndex(object, lexicalGlobalObject, index, slot);\n")
    p(out, "}\n\n")
}

pub fn generateGetOwnPropertyNames(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomGetOwnPropertyNames") { return }
    const namedGetter = mo.getNamedGetterOperation(interface)
    const indexedGetter = mo.getIndexedGetterOperation(interface)
    p(out, cat([_]Str{ "void ", className, "::getOwnPropertyNames(JSObject* object, JSGlobalObject* lexicalGlobalObject, PropertyNameArrayBuilder& propertyNames, DontEnumPropertiesMode mode)\n" }[0..]))
    p(out, "{\n")
    if indexedGetter != null || namedGetter != null { p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n") }
    p(out, cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(object);\n" }[0..]))
    p(out, "    ASSERT_GC_OBJECT_INHERITS(object, info());\n")
    if indexedGetter != null {
        p(out, "    for (unsigned i = 0, count = thisObject->wrapped().length(); i < count; ++i)\n")
        p(out, "        propertyNames.add(Identifier::from(vm, i));\n")
    }
    if namedGetter != null {
        if !on(interface, "LegacyUnenumerableNamedProperties") {
            p(out, "    for (auto& propertyName : thisObject->wrapped().supportedPropertyNames())\n")
            p(out, "        propertyNames.add(Identifier::fromString(vm, propertyName));\n")
        } else {
            p(out, "    if (mode == DontEnumPropertiesMode::Include) {\n")
            p(out, "        for (auto& propertyName : thisObject->wrapped().supportedPropertyNames())\n")
            p(out, "            propertyNames.add(Identifier::fromString(vm, propertyName));\n")
            p(out, "    }\n")
        }
    }
    p(out, "    JSObject::getOwnPropertyNames(object, lexicalGlobalObject, propertyNames, mode);\n")
    p(out, "}\n\n")
}

fn generateInvokeIndexedPropertySetter(out: *StrList, indent: Str, interface: *Node, operation: *Node, indexExpression: Str, v: Str) -> void {
    const argument = m.node(operation.*.arguments, 1)
    const nativeValue = t.jsValueToNativeShort(interface, argument, v, ext(operation, "Conditional"), "lexicalGlobalObject", "*lexicalGlobalObject", "thisObject", "", "")
    p(out, cat([_]Str{ indent, "auto nativeValue = ", nativeValue, ";\n" }[0..]))
    p(out, r.c2(indent, "if (nativeValue.hasException(throwScope)) [[unlikely]]\n"))
    p(out, r.c2(indent, "    return true;\n"))
    const functionName = r.orElse(operation.*.name, "setItem")
    const functionString = cat([_]Str{ "thisObject->wrapped().", functionName, "(", indexExpression, ", nativeValue.releaseReturnValue())" }[0..])
    p(out, cat([_]Str{ indent, "invokeFunctorPropagatingExceptionIfNecessary(*lexicalGlobalObject, throwScope, [&] { return ", functionString, "; });\n" }[0..]))
}

fn generateInvokeNamedPropertySetter(out: *StrList, indent: Str, interface: *Node, operation: *Node, v: Str) -> void {
    const argument = m.node(operation.*.arguments, 1)
    const nativeValue = t.jsValueToNativeShort(interface, argument, v, ext(operation, "Conditional"), "lexicalGlobalObject", "*lexicalGlobalObject", "thisObject", "", "")
    p(out, cat([_]Str{ indent, "auto nativeValue = ", nativeValue, ";\n" }[0..]))
    p(out, r.c2(indent, "if (nativeValue.hasException(throwScope)) [[unlikely]]\n"))
    p(out, r.c2(indent, "    return true;\n"))
    const functionName = r.orElse(operation.*.name, "setNamedItem")
    const functionString = cat([_]Str{ "thisObject->wrapped().", functionName, "(propertyNameToString(propertyName), nativeValue.releaseReturnValue())" }[0..])
    p(out, cat([_]Str{ indent, "invokeFunctorPropagatingExceptionIfNecessary(*lexicalGlobalObject, throwScope, [&] { return ", functionString, "; });\n" }[0..]))
}

fn checkCEReactionsSetters(namedSetter: ?*Node, indexedSetter: ?*Node) -> void {
    if namedSetter != null && on(namedSetter.?, "CEReactions") && indexedSetter != null && on(indexedSetter.?, "CEReactions") { r.die("CEReactions is not supported on having both named setters and indexed setters") }
}

fn addQuirk(out: *StrList, call: Str) -> void {
    addToImplInclude("DocumentQuirks.h")
    p(out, "\n    // Temporary quirk for ungap/@custom-elements polyfill (rdar://problem/111008826), consider removing in 2025.\n")
    p(out, "    if (auto* document = dynamicDowncast<Document>(dynamicDowncast<JSDOMGlobalObject>(lexicalGlobalObject)->scriptExecutionContext())) {\n")
    p(out, "        if (document->quirks().needsConfigurableIndexedPropertiesQuirk()) [[unlikely]]\n")
    p(out, cat([_]Str{ "            return ", call, ";\n" }[0..]))
    p(out, "    }\n\n")
}

pub fn generatePut(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomPut") { return }
    const namedSetter = mo.getNamedSetterOperation(interface)
    const indexedSetter = mo.getIndexedSetterOperation(interface)
    p(out, cat([_]Str{ "bool ", className, "::put(JSCell* cell, JSGlobalObject* lexicalGlobalObject, PropertyName propertyName, JSValue value, PutPropertySlot& putPropertySlot)\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(cell);\n" }[0..]))
    p(out, "    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n\n")
    p(out, "    if (thisObject != putPropertySlot.thisValue()) [[unlikely]]\n")
    p(out, "        return JSObject::put(thisObject, lexicalGlobalObject, propertyName, value, putPropertySlot);\n")
    if namedSetter == null && indexedSetter == null { addQuirk(out, "JSObject::put(thisObject, lexicalGlobalObject, propertyName, value, putPropertySlot)") }
    p(out, "    auto throwScope = DECLARE_THROW_SCOPE(lexicalGlobalObject->vm());\n\n")
    checkCEReactionsSetters(namedSetter, indexedSetter)
    if namedSetter != null { mo.generateCustomElementReactionsStackIfNeeded(out, namedSetter.?, "*lexicalGlobalObject") }
    if indexedSetter != null { mo.generateCustomElementReactionsStackIfNeeded(out, indexedSetter.?, "*lexicalGlobalObject") }
    if indexedSetter != null {
        p(out, "    if (auto index = parseIndex(propertyName)) {\n")
        generateInvokeIndexedPropertySetter(out, "        ", interface, indexedSetter.?, "index.value()", "value")
        p(out, "        return true;\n")
        p(out, "    }\n\n")
    }
    if namedSetter != null {
        p(out, "    if (!propertyName.isSymbol()) {\n")
        var additionalIndent: Str = ""
        const legacyOverrideBuiltins = cg.inheritsExtendedAttribute(interface, "LegacyOverrideBuiltIns")
        if !legacyOverrideBuiltins {
            p(out, "        PropertySlot slot { thisObject, PropertySlot::InternalMethodType::VMInquiry, &lexicalGlobalObject->vm() };\n")
            p(out, "        JSValue prototype = WebCore::storedPrototype(thisObject->structure(), thisObject);\n")
            p(out, "        bool found = prototype.isObject() && WebCore::getPropertySlot(asObject(prototype), lexicalGlobalObject, propertyName, slot);\n")
            p(out, "        slot.disallowVMEntry.reset();\n")
            p(out, "        RETURN_IF_EXCEPTION(throwScope, false);\n")
            p(out, "        if (!found) {\n")
            additionalIndent = "    "
        }
        generateInvokeNamedPropertySetter(out, r.c2(additionalIndent, "        "), interface, namedSetter.?, "value")
        p(out, r.c2(additionalIndent, "        return true;\n"))
        if !legacyOverrideBuiltins { p(out, "        }\n") }
        p(out, "    }\n\n")
    }
    if namedSetter != null && on(interface, "Plugin") { r.die("Using both a named property setter and [Plugin] together is not supported.") }
    if on(interface, "Plugin") {
        addToImplInclude("JSPluginElementFunctions.h")
        p(out, "    bool putResult = false;\n")
        p(out, "    bool success = pluginElementCustomPut(thisObject, lexicalGlobalObject, propertyName, value, putPropertySlot, putResult);\n")
        p(out, "    RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, "    if (success)\n")
        p(out, "        return putResult;\n\n")
    }
    p(out, "    throwScope.assertNoException();\n")
    if mo.instanceOverridesDefineOwnProperty(interface) && (mo.instanceOverridesNamedDefineOwnProperty(interface) || indexedSetter == null) {
        if !mo.instanceOverridesNamedDefineOwnProperty(interface) {
            p(out, "    if (!parseIndex(propertyName))\n")
            p(out, "        RELEASE_AND_RETURN(throwScope, JSObject::put(thisObject, lexicalGlobalObject, propertyName, value, putPropertySlot));\n\n")
        }
        if mo.instanceOverridesGetOwnPropertySlot(interface) && !on(interface, "CustomGetOwnPropertySlot") {
            p(out, "    PropertyDescriptor ownDescriptor;\n")
            p(out, "    PropertySlot slot(thisObject, PropertySlot::InternalMethodType::GetOwnProperty);;\n")
            p(out, "    bool ignoreNamedProperties = true;\n")
            p(out, "    bool hasOwnProperty = legacyPlatformObjectGetOwnProperty(thisObject, lexicalGlobalObject, propertyName, slot, ignoreNamedProperties);\n")
            p(out, "    RETURN_IF_EXCEPTION(throwScope, false);\n")
            p(out, "    if (hasOwnProperty) {\n")
            p(out, "        ownDescriptor.setPropertySlot(lexicalGlobalObject, propertyName, slot);\n")
            p(out, "        RETURN_IF_EXCEPTION(throwScope, false);\n")
            p(out, "    }\n")
            p(out, "    RELEASE_AND_RETURN(throwScope, ordinarySetWithOwnDescriptor(lexicalGlobalObject, thisObject, propertyName, value, putPropertySlot.thisValue(), WTF::move(ownDescriptor), putPropertySlot.isStrictMode()));\n")
        } else {
            p(out, "    RELEASE_AND_RETURN(throwScope, ordinarySetSlow(lexicalGlobalObject, thisObject, propertyName, value, putPropertySlot.thisValue(), putPropertySlot.isStrictMode()));\n")
        }
    } else {
        p(out, "    RELEASE_AND_RETURN(throwScope, JSObject::put(thisObject, lexicalGlobalObject, propertyName, value, putPropertySlot));\n")
    }
    p(out, "}\n\n")
}

pub fn generatePutByIndex(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomPut") { return }
    const namedSetter = mo.getNamedSetterOperation(interface)
    const indexedSetter = mo.getIndexedSetterOperation(interface)
    const legacyOverrideBuiltins = cg.inheritsExtendedAttribute(interface, "LegacyOverrideBuiltIns")
    const ellidesCallsToBase = (namedSetter != null && legacyOverrideBuiltins) && !on(interface, "Plugin")
    p(out, cat([_]Str{ "bool ", className, "::putByIndex(JSCell* cell, JSGlobalObject* lexicalGlobalObject, unsigned index, JSValue value, bool", if !ellidesCallsToBase { " shouldThrow" } else { "" }, ")\n" }[0..]))
    p(out, "{\n")
    if namedSetter == null && indexedSetter == null { addQuirk(out, "JSObject::putByIndex(cell, lexicalGlobalObject, index, value, shouldThrow)") }
    p(out, cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(cell);\n" }[0..]))
    p(out, "    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n\n")
    p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
    p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n\n")
    checkCEReactionsSetters(namedSetter, indexedSetter)
    if namedSetter != null { mo.generateCustomElementReactionsStackIfNeeded(out, namedSetter.?, "*lexicalGlobalObject") }
    if indexedSetter != null { mo.generateCustomElementReactionsStackIfNeeded(out, indexedSetter.?, "*lexicalGlobalObject") }
    if indexedSetter != null {
        p(out, "    if (index <= MAX_ARRAY_INDEX) [[likely]] {\n")
        generateInvokeIndexedPropertySetter(out, "        ", interface, indexedSetter.?, "index", "value")
        p(out, "        return true;\n")
        p(out, "    }\n\n")
    }
    if namedSetter != null {
        p(out, "    auto propertyName = Identifier::from(vm, index);\n")
        var additionalIndent: Str = ""
        if !legacyOverrideBuiltins {
            p(out, "    PropertySlot slot { thisObject, PropertySlot::InternalMethodType::VMInquiry, &vm };\n")
            p(out, "    JSValue prototype = WebCore::storedPrototype(thisObject->structure(), thisObject);\n")
            p(out, "    bool found = prototype.isObject() && WebCore::getPropertySlot(asObject(prototype), lexicalGlobalObject, propertyName, slot);\n")
            p(out, "    slot.disallowVMEntry.reset();\n")
            p(out, "    RETURN_IF_EXCEPTION(throwScope, false);\n")
            p(out, "    if (!found) {\n")
            additionalIndent = "    "
        }
        generateInvokeNamedPropertySetter(out, r.c2(additionalIndent, "    "), interface, namedSetter.?, "value")
        p(out, r.c2(additionalIndent, "    return true;\n"))
        if !legacyOverrideBuiltins { p(out, "    }\n\n") }
    }
    if namedSetter != null && on(interface, "Plugin") { r.die("Using both a named property setter and [Plugin] together is not supported.") }
    if on(interface, "Plugin") {
        addToImplInclude("JSPluginElementFunctions.h")
        p(out, "    auto propertyName = Identifier::from(vm, index);\n")
        p(out, "    PutPropertySlot putPropertySlot(thisObject, shouldThrow);\n")
        p(out, "    bool putResult = false;\n")
        p(out, "    bool success = pluginElementCustomPut(thisObject, lexicalGlobalObject, propertyName, value, putPropertySlot, putResult);\n")
        p(out, "    RETURN_IF_EXCEPTION(throwScope, false);\n")
        p(out, "    if (success)\n")
        p(out, "        return putResult;\n\n")
    }
    if !ellidesCallsToBase {
        p(out, "    throwScope.assertNoException();\n")
        if mo.instanceOverridesDefineOwnProperty(interface) {
            if namedSetter == null { p(out, "    auto propertyName = Identifier::from(vm, index);\n") }
            p(out, "    PutPropertySlot putPropertySlot(thisObject, shouldThrow);\n")
            p(out, "    RELEASE_AND_RETURN(throwScope, ordinarySetSlow(lexicalGlobalObject, thisObject, propertyName, value, putPropertySlot.thisValue(), shouldThrow));\n")
        } else {
            p(out, "    RELEASE_AND_RETURN(throwScope, JSObject::putByIndex(cell, lexicalGlobalObject, index, value, shouldThrow));\n")
        }
    }
    p(out, "}\n\n")
}

fn generateIsLegacyUnforgeablePropertyName(out: *StrList, interface: *Node) -> bool {
    var names = r.strList()
    const lists = [2]r.List{ interface.*.attributes, interface.*.operations }
    for l in lists {
        var index: usize = 0
        while index < l.count {
            const property = m.node(l, index)
            index += 1
            if property.*.isStatic { continue }
            if mo.isLegacyUnforgeable(interface, property) { r.spush(&names, property.*.name) }
        }
    }
    if names.count == 0 { return false }
    var parts = r.strList()
    var index: usize = 0
    while index < names.count {
        r.spush(&parts, cat([_]Str{ "propertyName == \"", names.items[index], "\"_s" }[0..]))
        index += 1
    }
    p(out, "static bool isLegacyUnforgeablePropertyName(PropertyName propertyName)\n")
    p(out, "{\n")
    p(out, cat([_]Str{ "    return ", r.sjoin(parts, " || "), ";\n" }[0..]))
    p(out, "}\n\n")
    return true
}

pub fn generateDefineOwnProperty(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomDefineOwnProperty") { return }
    const namedSetter = mo.getNamedSetterOperation(interface)
    const namedGetter = mo.getNamedGetterOperation(interface)
    const indexedSetter = mo.getIndexedSetterOperation(interface)
    const indexedGetter = mo.getIndexedGetterOperation(interface)
    if namedSetter == null && namedGetter == null && indexedSetter == null && indexedGetter == null { return }
    p(out, cat([_]Str{ "bool ", className, "::defineOwnProperty(JSObject* object, JSGlobalObject* lexicalGlobalObject, PropertyName propertyName, const PropertyDescriptor& propertyDescriptor, bool shouldThrow)\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    auto* thisObject = uncheckedDowncast<", className, ">(object);\n" }[0..]))
    p(out, "    ASSERT_GC_OBJECT_INHERITS(thisObject, info());\n\n")
    p(out, "    auto throwScope = DECLARE_THROW_SCOPE(lexicalGlobalObject->vm());\n\n")
    checkCEReactionsSetters(namedSetter, indexedSetter)
    if namedSetter != null { mo.generateCustomElementReactionsStackIfNeeded(out, namedSetter.?, "*lexicalGlobalObject") }
    if indexedSetter != null { mo.generateCustomElementReactionsStackIfNeeded(out, indexedSetter.?, "*lexicalGlobalObject") }
    if indexedGetter != null {
        if indexedSetter == null {
            p(out, "    if (parseIndex(propertyName))\n")
            p(out, "        return typeError(lexicalGlobalObject, throwScope, shouldThrow, \"Cannot set indexed properties on this object\"_s);\n\n")
        } else {
            p(out, "    if (auto index = parseIndex(propertyName)) {\n")
            p(out, "        if (!propertyDescriptor.isDataDescriptor())\n")
            p(out, "            return typeError(lexicalGlobalObject, throwScope, shouldThrow, \"Cannot set indexed properties on this object\"_s);\n")
            generateInvokeIndexedPropertySetter(out, "        ", interface, indexedSetter.?, "index.value()", "propertyDescriptor.value()")
            p(out, "        return true;\n")
            p(out, "    }\n\n")
        }
    }
    if namedGetter != null && !mo.isGlobalInterface(interface) {
        p(out, "    if (!propertyName.isSymbol()) {\n")
        var additionalIndent: Str = ""
        const hasUnforgable = generateIsLegacyUnforgeablePropertyName(out, interface)
        if hasUnforgable {
            p(out, "        if (!isLegacyUnforgeablePropertyName(propertyName)) {\n")
            additionalIndent = r.c2(additionalIndent, "    ")
        }
        const legacyOverrideBuiltins = cg.inheritsExtendedAttribute(interface, "LegacyOverrideBuiltIns")
        if !legacyOverrideBuiltins {
            p(out, r.c2(additionalIndent, "        PropertySlot slot { thisObject, PropertySlot::InternalMethodType::VMInquiry, &lexicalGlobalObject->vm() };\n"))
            p(out, r.c2(additionalIndent, "        bool found = WebCore::getOwnPropertySlot(thisObject, lexicalGlobalObject, propertyName, slot);\n"))
            p(out, r.c2(additionalIndent, "        slot.disallowVMEntry.reset();\n"))
            p(out, r.c2(additionalIndent, "        RETURN_IF_EXCEPTION(throwScope, false);\n"))
            p(out, r.c2(additionalIndent, "        if (!found) {\n"))
            additionalIndent = r.c2(additionalIndent, "    ")
        }
        if namedSetter == null {
            p(out, r.c2(additionalIndent, "        if (thisObject->wrapped().isSupportedPropertyName(propertyNameToString(propertyName)))\n"))
            p(out, r.c2(additionalIndent, "            return typeError(lexicalGlobalObject, throwScope, shouldThrow, \"Cannot set named properties on this object\"_s);\n"))
        } else {
            p(out, r.c2(additionalIndent, "        if (!propertyDescriptor.isDataDescriptor())\n"))
            p(out, r.c2(additionalIndent, "            return typeError(lexicalGlobalObject, throwScope, shouldThrow, \"Cannot set named properties on this object\"_s);\n"))
            generateInvokeNamedPropertySetter(out, r.c2(additionalIndent, "        "), interface, namedSetter.?, "propertyDescriptor.value()")
            p(out, r.c2(additionalIndent, "        return true;\n"))
        }
        if !legacyOverrideBuiltins { p(out, r.c2(additionalIndent, "    }\n")) }
        if hasUnforgable { p(out, "        }\n") }
        p(out, "    }\n\n")
    }
    p(out, "    PropertyDescriptor newPropertyDescriptor = propertyDescriptor;\n")
    p(out, "    throwScope.release();\n")
    p(out, "    return JSObject::defineOwnProperty(object, lexicalGlobalObject, propertyName, newPropertyDescriptor, shouldThrow);\n")
    p(out, "}\n\n")
}

fn generateDeletePropertyCommon(out: *StrList, interface: *Node, className: Str, operation: *Node, conditional: Str) -> void {
    if mo.getNamedGetterOperation(interface) == null { r.die("Named property deleters are not allowed without a corresponding named property getter.") }
    if mo.isGlobalInterface(interface) { r.die("Named property deleters are not allowed on global object interfaces.") }
    addToImplIncludes("JSDOMAbstractOperations.h", conditional)
    p(out, cat([_]Str{ "        if (isVisibleNamedProperty<", overrideBuiltinOf(interface), ">(*lexicalGlobalObject, thisObject, propertyName)) {\n" }[0..]))
    mo.generateCustomElementReactionsStackIfNeeded(out, operation, "*lexicalGlobalObject")
    const functionName = r.orElse(ext(operation, "ImplementedAs"), r.orElse(cg.wkLcfirst(operation.*.name), "deleteNamedProperty"))
    const functionCall = cat([_]Str{ "impl.", functionName, "(propertyNameToString(propertyName))" }[0..])
    if !r.truthy(operation.*.name) {
        p(out, cat([_]Str{ "            using ReturnType = decltype(", functionCall, ");\n" }[0..]))
        p(out, "            static_assert(std::is_same_v<ReturnType, ExceptionOr<bool>> || std::is_same_v<ReturnType, bool>, \"The implementation of named deleters without an identifier must return either bool or ExceptionOr<bool>.\");\n")
    }
    p(out, cat([_]Str{ "            return performLegacyPlatformObjectDeleteOperation(*lexicalGlobalObject, [&] { return ", functionCall, "; });\n" }[0..]))
    p(out, "        }\n")
}

fn generateDeleteProperty(out: *StrList, interface: *Node, className: Str, deleter: ?*Node, conditional: Str) -> void {
    p(out, cat([_]Str{ "bool ", className, "::deleteProperty(JSCell* cell, JSGlobalObject* lexicalGlobalObject, PropertyName propertyName, DeletePropertySlot& slot)\n" }[0..]))
    p(out, "{\n")
    p(out, cat([_]Str{ "    auto& thisObject = *uncheckedDowncast<", className, ">(cell);\n" }[0..]))
    p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = thisObject.wrapped();\n")
    if deleter == null { addQuirk(out, "JSObject::deleteProperty(cell, lexicalGlobalObject, propertyName, slot)") }
    if mo.getIndexedGetterOperation(interface) != null {
        p(out, "    if (auto index = parseIndex(propertyName))\n")
        p(out, "        return !impl.isSupportedPropertyIndex(index.value());\n")
    }
    if mo.getNamedGetterOperation(interface) != null {
        p(out, "    if (!propertyName.isSymbol() && impl.isSupportedPropertyName(propertyNameToString(propertyName))) {\n")
        if deleter != null {
            generateDeletePropertyCommon(out, interface, className, deleter.?, conditional)
        } else {
            p(out, "        PropertySlot slotForGet { &thisObject, PropertySlot::InternalMethodType::VMInquiry, &lexicalGlobalObject->vm() };\n")
            p(out, "        if (!WebCore::getOwnPropertySlot(&thisObject, lexicalGlobalObject, propertyName, slotForGet))\n")
            p(out, "            return false;\n")
        }
        p(out, "    }\n")
    }
    p(out, "    return JSObject::deleteProperty(cell, lexicalGlobalObject, propertyName, slot);\n")
    p(out, "}\n\n")
}

fn generateDeletePropertyByIndex(out: *StrList, interface: *Node, className: Str, deleter: ?*Node, conditional: Str) -> void {
    p(out, cat([_]Str{ "bool ", className, "::deletePropertyByIndex(JSCell* cell, JSGlobalObject* lexicalGlobalObject, unsigned index)\n" }[0..]))
    p(out, "{\n")
    p(out, "    UNUSED_PARAM(lexicalGlobalObject);\n")
    p(out, cat([_]Str{ "    auto& thisObject = *uncheckedDowncast<", className, ">(cell);\n" }[0..]))
    p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& impl = thisObject.wrapped();\n")
    if deleter == null { addQuirk(out, "JSObject::deletePropertyByIndex(cell, lexicalGlobalObject, index)") }
    if mo.getIndexedGetterOperation(interface) != null {
        p(out, "    return !impl.isSupportedPropertyIndex(index);\n")
    } else {
        p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = JSC::getVM(lexicalGlobalObject);\n")
        p(out, "    auto propertyName = Identifier::from(vm, index);\n")
        p(out, "    if (impl.isSupportedPropertyName(propertyNameToString(propertyName))) {\n")
        if deleter != null {
            generateDeletePropertyCommon(out, interface, className, deleter.?, conditional)
        } else {
            p(out, "        PropertySlot slotForGet { &thisObject, PropertySlot::InternalMethodType::VMInquiry, &lexicalGlobalObject->vm() };\n")
            p(out, "        if (!WebCore::getOwnPropertySlot(&thisObject, lexicalGlobalObject, propertyName, slotForGet))\n")
            p(out, "            return false;\n")
        }
        p(out, "    }\n")
        p(out, "    return JSObject::deletePropertyByIndex(cell, lexicalGlobalObject, index);\n")
    }
    p(out, "}\n\n")
}

pub fn generateDeletePropertyDefinition(out: *StrList, interface: *Node, className: Str) -> void {
    if on(interface, "CustomDeleteProperty") { return }
    const deleter = mo.getNamedDeleterOperation(interface)
    const conditional = if deleter != null { ext(deleter.?, "Conditional") } else { r.undef() }
    if r.truthy(conditional) { p(out, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n\n" }[0..])) }
    generateDeleteProperty(out, interface, className, deleter, conditional)
    generateDeletePropertyByIndex(out, interface, className, deleter, conditional)
    if r.truthy(conditional) { p(implContent, "#endif\n\n") }
}

pub fn generateHeaderContentHeader(interface: *Node) -> StrList {
    var result = r.strList()
    r.spush(&result, if on(interface, "AppleCopyright") { beginAppleCopyrightForHeaderFiles } else { headerTemplate })
    r.spush(&result, "\n#pragma once\n\n")
    const conditionalString = cg.generateConditionalString(interface.*.ext)
    if r.truthy(conditionalString) { r.spush(&result, cat([_]Str{ "#if ", conditionalString, "\n\n" }[0..])) }
    return result
}

pub fn generateImplementationContentHeader(interface: *Node) -> StrList {
    const className = r.c2("JS", typeName(interface))
    var result = r.strList()
    r.spush(&result, if on(interface, "AppleCopyright") { beginAppleCopyrightForSourceFiles } else { headerTemplate })
    r.spush(&result, "\n#include \"config.h\"\n")
    const conditionalString = cg.generateConditionalString(interface.*.ext)
    if r.truthy(conditionalString) { r.spush(&result, cat([_]Str{ "\n#if ", conditionalString, "\n\n" }[0..])) }
    r.spush(&result, cat([_]Str{ "#include \"", className, ".h\"\n\n" }[0..]))
    return result
}

pub fn needsImplementationClass(interface: *Node) -> bool {
    if on(interface, "JSBuiltin") { return false }
    if interface.*.isNamespaceObject { return false }
    return true
}

pub fn shouldGenerateToWrapped(hasParent: bool, interface: *Node) -> bool {
    if !needsImplementationClass(interface) { return false }
    if !hasParent || on(interface, "JSGenerateToNativeObject") { return true }
    if interface.*.parentType != null && std.text.same(interface.*.parentType.?.*.name, "EventTarget") { return true }
    return false
}

// ---------------------------------------------------------------------------
// Writing the files.

// Internal macOS SDKs up to 10.15 have non-suffixed headers in their
// WebKitAdditions; the generator names the suffixed ones.
fn substituteHeader(include: Str) -> Str {
    if std.text.same(include, "\"ApplePayInstallmentConfiguration.h\"") { return "\"ApplePayInstallmentConfigurationWebCore.h\"" }
    if std.text.same(include, "\"ApplePaySetupFeatureType.h\"") { return "\"ApplePaySetupFeatureTypeWebCore.h\"" }
    if std.text.same(include, "\"ApplePaySetupFeature.h\"") { return "\"ApplePaySetupFeatureWebCore.h\"" }
    if std.text.same(include, "\"ApplePaySetup.h\"") { return "\"ApplePaySetupWebCore.h\"" }
    if std.text.same(include, "\"PaymentInstallmentConfiguration.h\"") { return "\"PaymentInstallmentConfigurationWebCore.h\"" }
    return include
}

fn quotedUnlessBracketed(include: Str) -> Str {
    if include.length > 0 && (include[0] == 34 || include[0] == 60) { return include }
    return r.c3("\"", include, "\"")
}

// The first ".h" taken out, as the Perl's s/\.h//.
fn withoutFirstDotH(include: Str) -> Str {
    var index: usize = 0
    while index + 1 < include.length {
        if include[index] == 46 && include[index + 1] == 104 { return r.c2(include[0..index], include[index + 2..include.length]) }
        index += 1
    }
    return include
}

fn included(includes: *r.Map, include: Str) -> bool { return r.has(includes, include) && r.truthy(r.getStr(includes, include)) }

// The #include lines of an implementation's INCLUDES: the unconditional
// ones sorted, then a #if group per condition. ADDEVENTTARGETINLINES puts
// EventTargetInlines.h before JSEventTarget.h; EXTRA is one more
// unconditional include (undefined for none).
fn implementationIncludeLines(includes: *r.Map, addEventTargetInlines: bool, extra: Str) -> Str {
    var plain = r.strList()
    var conditions = r.newMap()
    var conditionNames = r.strList()
    const names = r.keys(includes)
    var index: usize = 0
    while index < names.count {
        var include = names.items[index]
        index += 1
        if included(headerIncludes, include) { continue }
        if included(headerTrailingIncludes, include) { continue }
        const condition = r.getStr(includes, include)
        if r.startsWith(withoutFirstDotH(include), "SVGAnimated") { continue }
        include = quotedUnlessBracketed(include)
        if std.text.same(condition, "1") {
            if addEventTargetInlines && std.text.same(include, "\"JSEventTarget.h\"") { r.spush(&plain, "\"EventTargetInlines.h\"") }
            r.spush(&plain, include)
        } else {
            const conditionString = cg.generateConditionalStringFromAttributeValue(condition)
            if !r.has(conditions, conditionString) {
                const group: *StrList = newStrList()
                r.set(conditions, conditionString, @intFromPtr(group))
                r.spush(&conditionNames, conditionString)
            }
            const group: *StrList = unsafe { @ptrFromInt(*StrList, r.get(conditions, conditionString)) }
            r.spush(group, include)
        }
    }
    if r.isDef(extra) { r.spush(&plain, extra) }
    var b = r.buf()
    r.ssort(&plain)
    for include in plain.items[0..plain.count] { r.add(&b, r.c3("#include ", include, "\n")) }
    r.ssort(&conditionNames)
    for condition in conditionNames.items[0..conditionNames.count] {
        r.add(&b, r.c3("\n#if ", condition, "\n"))
        const group: *StrList = unsafe { @ptrFromInt(*StrList, r.get(conditions, condition)) }
        r.ssort(group)
        for include in group.*.items[0..group.*.count] { r.add(&b, r.c3("#include ", include, "\n")) }
        r.add(&b, "#endif\n")
    }
    return r.done(b)
}

// The header's include lines for INCLUDES, sorted.
fn headerIncludeLines(includes: *r.Map, name: Str, substitute: bool) -> Str {
    const isPrivate = mo.isPrivateHeader(cat([_]Str{ "JS", name, ".h" }[0..]))
    var lines = r.strList()
    const names = r.keys(includes)
    for include0 in names.items[0..names.count] {
        var include = include0
        if !(include.length > 0 && (include[0] == 34 || include[0] == 60)) {
            include = if isPrivate { r.c3("<WebCore/", include, ">") } else { r.c3("\"", include, "\"") }
        }
        if substitute { include = substituteHeader(include) }
        r.spush(&lines, include)
    }
    r.ssort(&lines)
    const own = cat([_]Str{ "\"JS", name, ".h\"" }[0..])
    var b = r.buf()
    for include in lines.items[0..lines.count] {
        if substitute && std.text.same(include, own) { continue }
        r.add(&b, r.c3("#include ", include, "\n"))
    }
    return r.done(b)
}

// WriteData: JS<Name>.cpp, JS<Name>.h, JS<Name>.dep when it has
// content, and JS<Name>ConstructorAttributes.cpp for an interface with
// [StandaloneConstructorAttributes]; the state is then emptied.
pub fn writeData(node: *Node, outputDir: Str) -> void {
    ensureState()
    const name = typeName(node)
    const base = cat([_]Str{ outputDir, "/JS", name }[0..])

    const extra = if std.text.same(name, "AddEventListenerOptions") || std.text.same(name, "EventTarget") { "\"AbortSignal.h\"" } else { r.undef() }
    var contents = r.buf()
    r.add(&contents, r.sjoin(implContentHeader.*, ""))
    r.add(&contents, implementationIncludeLines(implIncludes, true, extra))
    r.add(&contents, r.sjoin(implContent.*, ""))
    r.writeFile(r.c2(base, ".cpp"), r.done(contents))

    if m.exists(node.*.ext, "StandaloneConstructorAttributes") && on(node, "StandaloneConstructorAttributes") {
        if !included(auxImplIncludes, "JSDOMGlobalObjectInlines.h") { r.setStr(auxImplIncludes, "JSDOMGlobalObjectInlines.h", "1") }
        var aux = r.buf()
        r.add(&aux, r.sjoin(generateImplementationContentHeader(node), ""))
        r.add(&aux, implementationIncludeLines(auxImplIncludes, false, r.undef()))
        r.add(&aux, "\nnamespace WebCore {\nusing namespace JSC;\n\n")
        r.add(&aux, r.sjoin(auxImplContent.*, ""))
        r.add(&aux, "} // namespace WebCore\n")
        if r.truthy(cg.generateConditionalString(node.*.ext)) { r.add(&aux, "\n#endif\n") }
        r.writeFile(r.c2(base, "ConstructorAttributes.cpp"), r.done(aux))
    }

    implContentHeader.* = r.strList()
    implContent.* = r.strList()
    implIncludes = r.newMap()
    auxImplContent.* = r.strList()
    auxImplIncludes = r.newMap()

    var header = r.buf()
    r.add(&header, r.sjoin(headerContentHeader.*, ""))
    r.add(&header, headerIncludeLines(headerIncludes, name, true))
    r.add(&header, r.sjoin(headerContent.*, ""))
    r.add(&header, headerIncludeLines(headerTrailingIncludes, name, false))
    r.writeFile(r.c2(base, ".h"), r.done(header))

    headerContentHeader.* = r.strList()
    headerContent.* = r.strList()
    headerIncludes = r.newMap()
    headerTrailingIncludes = r.newMap()

    if depsContent.*.count > 0 {
        r.writeFile(r.c2(base, ".dep"), r.sjoin(depsContent.*, ""))
        depsContent.* = r.strList()
    }
}
