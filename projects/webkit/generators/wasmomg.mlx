// JavaScriptCore's WasmOMGIRGeneratorInlines.h, made as WebKit's
// generateWasmOMGIRGeneratorInlinesHeader.py makes it, from
// wasm/wasm.json:
//
//     webkit-wasm-omg WASM_JSON OUTPUT
//
// Each unary or binary opcode with a "b3op" gets an OMGIRGenerator::add
// method that builds its B3 values. The b3op is the name of one B3
// opcode, applied to the operands in order, or an expression of them:
// "RotL(@0, Trunc(@1))", "Equal(i32(0), @0)", @N the operand N and
// i32(X) / i64(X) a constant. Each value is named temp and the position
// of its token in the expression (commas not counted), inner ones made
// first. The text is the Python's to the byte.
const std = @import("std")
const s = @import("./support.mlx")
const w = @import("./wasmjson.mlx")

const MAX_TOKENS: usize = 256

const Generator = struct {
    tokens: [*][]const u8
    count: usize
    index: usize
    // The lines made so far, each but the first after "\n    ".
    code: []const u8
    lines: usize
}

fn isAlnum(byte: u8) -> bool { return s.isDigit(byte) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }

// The tokens of SOURCE: names and numbers, @N, parentheses (the commas
// left out).
fn lex(source: []const u8, generator: *Generator) -> void {
    var at: usize = 0
    while at != source.length {
        while at < source.length && s.isSpace(source[at]) { at += 1 }
        const start = at
        if at < source.length && isAlnum(source[at]) {
            while at < source.length && isAlnum(source[at]) { at += 1 }
        } else if at + 1 < source.length && source[at] == 64 && s.isDigit(source[at + 1]) {
            at += 1
            while at < source.length && s.isDigit(source[at]) { at += 1 }
        } else if at + 1 < source.length && source[at] == 45 && s.isDigit(source[at + 1]) {
            at += 1
            while at < source.length && s.isDigit(source[at]) { at += 1 }
        } else if at < source.length && (source[at] == 40 || source[at] == 41) {
            at += 1
        } else if at < source.length && source[at] == 44 {
            at += 1
            continue
        } else {
            s.fail(s.join("Lexing Error: could not lex token from: ", source))
        }
        if generator.*.count == MAX_TOKENS { s.fail("generateWasmOMGIRGeneratorInlinesHeader: a b3op too long") }
        generator.*.tokens[generator.*.count] = source[start..at]
        generator.*.count += 1
    }
}

fn token(generator: *Generator) -> []const u8 {
    if generator.*.index >= generator.*.count { s.fail("generateWasmOMGIRGeneratorInlinesHeader: a b3op ends too soon") }
    return generator.*.tokens[generator.*.index]
}

fn consume(generator: *Generator, expected: []const u8) -> void {
    if !std.text.same(token(generator), expected) { s.fail(s.join3("Parse error Expected ", expected, s.join(" but got ", token(generator)))) }
    generator.*.index += 1
}

fn temp(index: usize) -> []const u8 { return s.join("temp", s.decimal(@intCast(u64, index))) }

fn addLine(generator: *Generator, line: []const u8) -> void {
    generator.*.code = if generator.*.lines == 0 { line } else { s.join3(generator.*.code, "\n    ", line) }
    generator.*.lines += 1
}

fn b3Code(generator: *Generator, index: usize, op: []const u8, parameters: []const u8) -> void {
    addLine(generator, s.join3(s.join3("Value* ", temp(index), " = m_currentBlock->appendNew<Value>(m_proc, B3::"), op, s.join3(", origin(), ", parameters, ");")))
}

// The value of the expression at the token, its code made; the tokens
// passed.
fn generateOpcode(generator: *Generator) -> []const u8 {
    const first = token(generator)
    if std.text.same(first, "i32") || std.text.same(first, "i64") {
        const kind = if std.text.same(first, "i64") { "Int64" } else { "Int32" }
        generator.*.index += 1
        consume(generator, "(")
        const index = generator.*.index
        addLine(generator, s.join3(s.join3("Value* ", temp(index), " = constant("), kind, s.join3(", ", token(generator), ");")))
        generator.*.index += 1
        consume(generator, ")")
        return temp(index)
    }
    if first.length > 1 && first[0] == 64 {
        generator.*.index += 1
        return s.join3("get(arg", first[1..first.length], ")")
    }
    const index = generator.*.index
    // Past the name and (unchecked) its opening parenthesis.
    generator.*.index += 2
    var parameters: []const u8 = ""
    var closed = false
    while generator.*.index < generator.*.count {
        if std.text.same(token(generator), ")") {
            generator.*.index += 1
            closed = true
            break
        }
        const parameter = generateOpcode(generator)
        parameters = if parameters.length == 0 { parameter } else { s.join3(parameters, ", ", parameter) }
    }
    if !closed { s.fail("Parse error Parsing arguments fell off end") }
    b3Code(generator, index, first, parameters)
    return temp(index)
}

fn generateSimpleCode(op: usize) -> void {
    const parameterCount = w.parameterCount(op)
    s.out("\nauto OMGIRGenerator::add")
    s.out(w.toCpp(w.keyOf(op)))
    s.out("(")
    var index: usize = 0
    while index < parameterCount {
        s.out("ExpressionType arg")
        s.outUnsigned(@intCast(u64, index))
        s.out(", ")
        index += 1
    }
    s.out("ExpressionType& result) -> PartialResult\n{\n")
    var generator = Generator.{ .tokens = undefined, .count = 0, .index = 0, .code = "", .lines = 0 }
    unsafe { generator.tokens = @ptrFromInt([*][]const u8, s.alloc(MAX_TOKENS * @sizeOf([]const u8))) }
    lex(w.text(op, "b3op"), &generator)
    var result: []const u8 = ""
    if generator.count == 1 {
        // A B3 opcode alone: applied to the operands.
        var parameters: []const u8 = ""
        index = 0
        while index < parameterCount {
            const parameter = s.join3("get(arg", s.decimal(@intCast(u64, index)), ")")
            parameters = if index == 0 { parameter } else { s.join3(parameters, ", ", parameter) }
            index += 1
        }
        b3Code(&generator, 0, generator.tokens[0], parameters)
        result = temp(0)
    } else {
        result = generateOpcode(&generator)
    }
    addLine(&generator, s.join("Value* resultValue = ", result))
    s.out("    ")
    s.out(generator.code)
    s.out(";\n    result = push(resultValue);\n    return { };\n}\n")
}

fn generate(jsonPath: []const u8, outputPath: []const u8) -> void {
    const root = w.load(jsonPath)
    const opcodes = w.section(root, "opcode")
    w.header("generateWasmOMGIRGeneratorInlinesHeader.py")
    s.out("\n\n#pragma once\n\n#if ENABLE(WEBASSEMBLY)\n\nnamespace JSC { namespace Wasm {\n\n")
    var op = w.first(opcodes)
    while op != 0 {
        if w.isSimple(op) && (w.isBinary(op) || w.isUnary(op)) { generateSimpleCode(op) }
        op = w.next(op)
    }
    s.out("\n\n} } // namespace JSC::Wasm\n\n#endif // ENABLE(WEBASSEMBLY)\n\n")
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-wasm-omg WASM_JSON OUTPUT\n")
        return 2
    }
    generate(s.cString(arguments[1]), s.cString(arguments[2]))
    return 0
}
