// CodeGeneratorJS.pm's GenerateHeader: the JS<Name>.h of an interface (its
// wrapper class, owner, toJS functions, prototype for global objects),
// and the JS<Name>.dep of the IDL files it depends on.
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const js = @import("./bindingsjs.mlx")
const t = @import("./bindingsjstypes.mlx")
const d = @import("./bindingsjsdict.mlx")
const mo = @import("./bindingsjsmore.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

fn cat(parts: []const Str) -> Str { return r.cat(parts) }
fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }
fn hp(text: Str) -> void { r.spush(js.headerContent, text) }
fn hinclude(name: Str) -> void { r.setStr(js.headerIncludes, name, "1") }

pub fn generateHeader(interface: *Node, enumerations: r.List, dictionaries: r.List) -> void {
    const interfaceName = typeName(interface)
    const className = r.c2("JS", interfaceName)
    var structureFlags = r.map()
    const hasParent = interface.*.parentType != null || on(interface, "JSLegacyParent")
    const parentClassName = js.getParentClassName(interface)
    const needsVisitChildren = mo.instanceNeedsVisitChildren(interface)

    r.sappend(js.headerContentHeader, js.generateHeaderContentHeader(interface))
    if hasParent {
        hinclude(r.c2(parentClassName, ".h"))
    } else {
        hinclude("<WebCore/JSDOMWrapper.h>")
        if on(interface, "Exception") { hinclude("<JavaScriptCore/ErrorPrototype.h>") }
    }
    if r.startsWith(className, "JSSVG") { hinclude("SVGElement.h") }
    const implType = mo.getImplClassName(interface)
    hp("\nnamespace WebCore {\n\n")
    if cg.isSVGAnimatedType(interface.*.ty.?) {
        hinclude("SVGAnimatedPropertyImpl.h")
    } else if cg.isSVGPathSegType(interface.*.ty.?) {
        hinclude("SVGPathSegImpl.h")
    } else {
        if hasParent && on(interface, "JSGenerateToNativeObject") { hinclude(r.c2(interfaceName, ".h")) }
        if js.isDOMGlobalObject(interface) { js.addClassForwardIfNeeded(interface.*.ty.?) }
    }
    if r.same(interfaceName, "DOMWindow") { hinclude("JSWindowProxy.h") }
    if r.same(parentClassName, "JSEventTarget") { hinclude("EventTarget.h") }
    const exportMacro = js.getExportMacroForJSClass(interface)
    if mo.hasTaggedWrapperForInterface(interface) && interface.*.parentType != null { r.die(cat([_]Str{ "Interface ", implType, " marked as TaggedWrapper but extends another interface." }[0..])) }
    if mo.hasTaggedWrapperForInterface(interface) { hp(cat([_]Str{ "WTF_DECLARE_PTRTAG(", mo.getImplClassPtrTag(interface), ")\n" }[0..])) }
    hp(cat([_]Str{ "class ", exportMacro, className, " : public ", parentClassName, " {\n" }[0..]))
    hp("public:\n")
    hp(cat([_]Str{ "    using Base = ", parentClassName, ";\n" }[0..]))
    if hasParent { hp(cat([_]Str{ "    using DOMWrapped = ", implType, ";\n" }[0..])) }
    if r.same(interfaceName, "DOMWindow") {
        hp(cat([_]Str{ "    static ", className, "* create(JSC::VM&, JSC::Structure*, Ref<", implType, ">&&, JSWindowProxy*);\n\n" }[0..]))
    } else if js.shouldCreateWithJSGlobalProxy(interface) {
        hp(cat([_]Str{ "    static ", className, "* create(JSC::VM&, JSC::Structure*, Ref<", implType, ">&&, JSC::JSGlobalProxy*);\n\n" }[0..]))
    } else if on(interface, "MasqueradesAsUndefined") {
        js.addIncludesForImplementationTypeInHeader(implType)
        hp(cat([_]Str{ "    static ", className, "* create(JSC::Structure*, JSDOMGlobalObject*, Ref<", implType, ">&&);\n\n" }[0..]))
    } else if !js.needsImplementationClass(interface) {
        hp(cat([_]Str{ "    static ", className, "* create(JSC::Structure*, JSDOMGlobalObject*);\n\n" }[0..]))
    } else {
        if !cg.isSVGAnimatedType(interface.*.ty.?) && !cg.isSVGPathSegType(interface.*.ty.?) { js.addIncludesForImplementationTypeInHeader(implType) }
        hp(cat([_]Str{ "    static ", className, "* create(JSC::Structure*, JSDOMGlobalObject*, Ref<", implType, ">&&);\n\n" }[0..]))
    }
    if mo.instancePropertyCount(interface) > 0 { r.set(&structureFlags, "JSC::HasStaticPropertyTable", 1) }
    if on(interface, "NewImpurePropertyFiresWatchpoints") { r.set(&structureFlags, "JSC::NewImpurePropertyFiresWatchpoints", 1) }
    if on(interface, "IsImmutablePrototypeExoticObject") { r.set(&structureFlags, "JSC::IsImmutablePrototypeExoticObject", 1) }
    if on(interface, "MasqueradesAsUndefined") { r.set(&structureFlags, "JSC::MasqueradesAsUndefined", 1) }
    if r.same(interfaceName, "DOMWindow") { r.set(&structureFlags, "JSC::ImplementsHasInstance | JSC::ImplementsDefaultHasInstance", 1) }
    if !(js.shouldUseGlobalObjectPrototype(interface) || js.shouldUseOrdinaryObjectPrototype(interface)) {
        hp("    static JSC::JSObject* createPrototype(JSC::VM&, JSDOMGlobalObject&);\n")
        hp("    static JSC::JSObject* prototype(JSC::VM&, JSDOMGlobalObject&);\n")
    }
    if js.shouldGenerateToWrapped(hasParent, interface) {
        const exportPrefix = if on(interface, "ExportToWrappedFunction") { "WEBCORE_EXPORT " } else { "" }
        hp(cat([_]Str{ "    static ", exportPrefix, implType, "* toWrapped(JSC::VM&, JSC::JSValue);\n" }[0..]))
    }
    if on(interface, "JSCustomHeader") { r.setStr(js.headerTrailingIncludes, r.c2(className, "Custom.h"), "1") }
    const namedGetter = mo.getNamedGetterOperation(interface)
    if namedGetter != null {
        if cg.inheritsExtendedAttribute(interface, "LegacyOverrideBuiltIns") {
            r.set(&structureFlags, "JSC::GetOwnPropertySlotIsImpure", 1)
        } else {
            r.set(&structureFlags, "JSC::GetOwnPropertySlotIsImpureForPropertyAbsence", 1)
        }
    }
    if mo.instanceOverridesGetOwnPropertySlot(interface) {
        if !on(interface, "CustomGetOwnPropertySlot") { hp("    static bool legacyPlatformObjectGetOwnProperty(JSC::JSObject*, JSC::JSGlobalObject*, JSC::PropertyName, JSC::PropertySlot&, bool ignoreNamedProperties);\n") }
        hp("    static bool getOwnPropertySlot(JSC::JSObject*, JSC::JSGlobalObject*, JSC::PropertyName, JSC::PropertySlot&);\n")
        r.set(&structureFlags, "JSC::OverridesGetOwnPropertySlot", 1)
        hp("    static bool getOwnPropertySlotByIndex(JSC::JSObject*, JSC::JSGlobalObject*, unsigned propertyName, JSC::PropertySlot&);\n")
        r.set(&structureFlags, "JSC::InterceptsGetOwnPropertySlotByIndexEvenWhenLengthIsNotZero", 1)
    }
    if on(interface, "Plugin") || mo.getNamedSetterOperation(interface) != null { r.set(&structureFlags, "JSC::ProhibitsPropertyCaching", 1) }
    if mo.instanceOverridesGetOwnPropertyNames(interface) {
        hp("    static void getOwnPropertyNames(JSC::JSObject*, JSC::JSGlobalObject*, JSC::PropertyNameArrayBuilder&, JSC::DontEnumPropertiesMode);\n")
        r.set(&structureFlags, "JSC::OverridesGetOwnPropertyNames", 1)
    }
    if mo.instanceOverridesPut(interface) {
        hp("    static bool put(JSC::JSCell*, JSC::JSGlobalObject*, JSC::PropertyName, JSC::JSValue, JSC::PutPropertySlot&);\n")
        hp("    static bool putByIndex(JSC::JSCell*, JSC::JSGlobalObject*, unsigned propertyName, JSC::JSValue, bool shouldThrow);\n")
        r.set(&structureFlags, "JSC::OverridesPut", 1)
    }
    if mo.instanceOverridesDefineOwnProperty(interface) { hp("    static bool defineOwnProperty(JSC::JSObject*, JSC::JSGlobalObject*, JSC::PropertyName, const JSC::PropertyDescriptor&, bool shouldThrow);\n") }
    if mo.instanceOverridesDeleteProperty(interface) {
        hp("    static bool deleteProperty(JSC::JSCell*, JSC::JSGlobalObject*, JSC::PropertyName, JSC::DeletePropertySlot&);\n")
        hp("    static bool deletePropertyByIndex(JSC::JSCell*, JSC::JSGlobalObject*, unsigned);\n")
    }
    if mo.instanceOverridesGetCallData(interface) {
        hp("    static JSC::CallData getCallData(JSC::JSCell*);\n\n")
        hinclude("<JavaScriptCore/CallData.h>")
        r.set(&structureFlags, "JSC::OverridesGetCallData", 1)
    }
    if on(interface, "CustomGetPrototype") {
        hp("    static JSC::JSValue getPrototype(JSC::JSObject*, JSC::JSGlobalObject*);\n")
        r.set(&structureFlags, "JSC::OverridesGetPrototype", 1)
    }
    if on(interface, "CustomPreventExtensions") { hp("    static bool NODELETE preventExtensions(JSC::JSObject*, JSC::JSGlobalObject*);\n") }
    if mo.instanceNeedsEstimatedSize(interface) { hp("    static size_t estimatedSize(JSCell*, JSC::VM&);\n") }
    if !hasParent { hp("    static void destroy(JSC::JSCell*);\n") }
    if r.same(interfaceName, "Node") {
        hp("\n")
        hp("protected:\n")
        hp("    static const JSC::ClassInfo s_info;\n")
        hp("public:\n")
        hp("    static constexpr const JSC::ClassInfo* info() { return &s_info; }\n\n")
    } else {
        hp("\n")
        hp("    DECLARE_INFO;\n\n")
    }
    hp("    static JSC::Structure* createStructure(JSC::VM&, JSC::JSGlobalObject*, JSC::JSValue);\n")
    if cg.inheritsInterface(interface, "HTMLElement") { hp("    JSC::JSScope* pushEventHandlerScope(JSC::JSGlobalObject*, JSC::JSScope*) const;\n\n") }
    if !on(interface, "LegacyNoInterfaceObject") {
        hp("    static JSC::JSValue getConstructor(JSC::VM&, const JSC::JSGlobalObject*);\n")
        if on(interface, "LegacyFactoryFunction") { hp("    static JSC::JSValue getLegacyFactoryFunction(JSC::VM&, JSC::JSGlobalObject*);\n") }
    }
    if on(interface, "GenerateForEachEventHandlerContentAttribute") { hp("    static void forEachEventHandlerContentAttribute(const Function<void(const AtomString& attributeName, const AtomString& eventName)>&);\n\n") }
    if on(interface, "GenerateForEachWindowEventHandlerContentAttribute") { hp("    static void forEachWindowEventHandlerContentAttribute(const Function<void(const AtomString& attributeName, const AtomString& eventName)>&);\n\n") }

    var numCustomOperations: usize = 0
    var numCustomAttributes: usize = 0
    var numCustomEnabledBy: usize = 0
    var hasDOMJITAttributes = false
    const attributes = interface.*.attributes
    var index: usize = 0
    while index < attributes.count {
        const attribute = m.node(attributes, index)
        index += 1
        if mo.hasCustomGetter(attribute) { numCustomAttributes += 1 }
        if mo.hasCustomSetter(attribute) { numCustomAttributes += 1 }
        if on(attribute, "CustomEnabledBy") { numCustomEnabledBy += 1 }
        if on(attribute, "CachedAttribute") {
            const conditionalString = cg.generateConditionalString(attribute.*.ext)
            if r.truthy(conditionalString) { hp(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
            hp(cat([_]Str{ "    mutable JSC::WriteBarrier<JSC::Unknown> m_", attribute.*.name, ";\n" }[0..]))
            if r.truthy(conditionalString) { hp("#endif\n") }
        }
        if on(attribute, "DOMJIT") { hasDOMJITAttributes = true }
    }
    hp("    template<typename, JSC::SubspaceAccess mode> static JSC::GCClient::IsoSubspace* subspaceFor(JSC::VM& vm)\n")
    hp("    {\n")
    hp("        if constexpr (mode == JSC::SubspaceAccess::Concurrently)\n")
    hp("            return nullptr;\n")
    hp("        return subspaceForImpl(vm);\n")
    hp("    }\n")
    hp("    static JSC::GCClient::IsoSubspace* subspaceForImpl(JSC::VM& vm);\n")
    if needsVisitChildren {
        hp("    DECLARE_VISIT_CHILDREN;\n")
        if on(interface, "JSCustomMarkFunction") { hp("    template<typename Visitor> void visitAdditionalChildrenInGCThread(Visitor&);\n") }
        hp("\n")
        if on(interface, "JSCustomMarkFunction") { hp("    template<typename Visitor> static void visitOutputConstraints(JSCell*, Visitor&);\n") }
    }
    if js.needsImplementationClass(interface) { hp("    static void analyzeHeap(JSCell*, JSC::HeapAnalyzer&);\n") }
    if numCustomAttributes > 0 {
        hp("\n    // Custom attributes\n")
        index = 0
        while index < attributes.count {
            const attribute = m.node(attributes, index)
            index += 1
            const conditionalString = cg.generateConditionalString(attribute.*.ext)
            if mo.hasCustomGetter(attribute) {
                if r.truthy(conditionalString) { hp(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
                hp(cat([_]Str{ "    JSC::JSValue ", cg.wkLcfirst(attribute.*.name), "(JSC::JSGlobalObject&) const;\n" }[0..]))
                if r.truthy(conditionalString) { hp("#endif\n") }
            }
            if mo.hasCustomSetter(attribute) && !js.isReadonly(attribute) {
                if r.truthy(conditionalString) { hp(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
                hp(cat([_]Str{ "    void set", cg.wkUcfirst(attribute.*.name), "(JSC::JSGlobalObject&, JSC::JSValue);\n" }[0..]))
                if r.truthy(conditionalString) { hp("#endif\n") }
            }
        }
    }
    const operations = interface.*.operations
    index = 0
    while index < operations.count {
        const operation = m.node(operations, index)
        index += 1
        if mo.hasCustomMethod(operation) { numCustomOperations += 1 }
        if on(operation, "CustomEnabledBy") { numCustomEnabledBy += 1 }
    }
    if numCustomEnabledBy > 0 {
        var methods = r.strList()
        hp("\n    // Custom enabled-by\n")
        index = 0
        while index < attributes.count {
            const attribute = m.node(attributes, index)
            index += 1
            if on(attribute, "CustomEnabledBy") { r.spush(&methods, mo.toMethodName(ext(attribute, "CustomEnabledBy"))) }
        }
        index = 0
        while index < operations.count {
            const operation = m.node(operations, index)
            index += 1
            if on(operation, "CustomEnabledBy") { r.spush(&methods, mo.toMethodName(ext(operation, "CustomEnabledBy"))) }
        }
        const unique = r.suniq(methods)
        index = 0
        while index < unique.count {
            hp(cat([_]Str{ "    static bool ", unique.items[index], "(ScriptExecutionContext*);\n" }[0..]))
            index += 1
        }
    }
    if numCustomOperations > 0 {
        var inAppleCopyright = false
        hp("\n    // Custom functions\n")
        index = 0
        while index < operations.count {
            const operation = m.node(operations, index)
            index += 1
            if !mo.hasCustomMethod(operation) { continue }
            if operation.*.overloads != null && operation.*.overloadIndex != 1 { continue }
            if on(operation, "AppleCopyright") {
                if !inAppleCopyright {
                    hp(js.beginAppleCopyrightForHeaderFiles)
                    inAppleCopyright = true
                }
            } else if inAppleCopyright {
                hp(js.endAppleCopyright)
                inAppleCopyright = false
            }
            const conditionalString = cg.generateConditionalString(operation.*.ext)
            if r.truthy(conditionalString) { hp(cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
            const functionImplementationName = cg.operationName(operation)
            var functionArguments = r.strList()
            r.spush(&functionArguments, "JSC::JSGlobalObject&")
            r.spush(&functionArguments, "JSC::CallFrame&")
            if cg.isPromiseType(operation.*.ty.?) && !on(operation, "ReturnsOwnPromise") { r.spush(&functionArguments, "Ref<DeferredPromise>&&") }
            if on(operation, "ReturnsPromisePair") { r.spush(&functionArguments, "Ref<DeferredPromise>&&, Ref<DeferredPromise>&&") }
            hp(cat([_]Str{ "    ", if operation.*.isStatic { "static " } else { "" }, "JSC::JSValue ", functionImplementationName, "(", r.sjoin(functionArguments, ", "), ");\n" }[0..]))
            if r.truthy(conditionalString) { hp("#endif\n") }
        }
        if inAppleCopyright { hp(js.endAppleCopyright) }
    }
    if js.needsImplementationClass(interface) && hasParent {
        hp(cat([_]Str{ "    ", interfaceName, "& wrapped() const\n" }[0..]))
        hp("    {\n")
        hp(cat([_]Str{ "        return static_cast<", interfaceName, "&>(Base::wrapped());\n" }[0..]))
        hp("    }\n\n")
    }
    if structureFlags.size > 0 {
        hp("public:\n")
        if r.same(interfaceName, "ShadowRealmGlobalScope") {
            hp("    static constexpr unsigned StructureFlags = (Base::StructureFlags & ~JSC::IsImmutablePrototypeExoticObject)")
        } else {
            hp("    static constexpr unsigned StructureFlags = Base::StructureFlags")
        }
        const flags = r.sortedKeys(&structureFlags)
        index = 0
        while index < flags.count {
            hp(r.c2(" | ", flags.items[index]))
            index += 1
        }
        hp(";\n")
    }
    hp("protected:\n")
    if r.same(interfaceName, "DOMWindow") {
        hp(cat([_]Str{ "    ", className, "(JSC::VM&, JSC::Structure*, Ref<", implType, ">&&, JSWindowProxy*);\n" }[0..]))
    } else if js.shouldCreateWithJSGlobalProxy(interface) {
        hp(cat([_]Str{ "    ", className, "(JSC::VM&, JSC::Structure*, Ref<", implType, ">&&);\n" }[0..]))
    } else if !js.needsImplementationClass(interface) {
        hp(cat([_]Str{ "    ", className, "(JSC::Structure*, JSDOMGlobalObject&);\n\n" }[0..]))
    } else {
        hp(cat([_]Str{ "    ", className, "(JSC::Structure*, JSDOMGlobalObject&, Ref<", implType, ">&&);\n\n" }[0..]))
    }
    if js.hasNonTrivialFinishCreation || js.hasNonDefaultFinishCreation {
        if !js.hasNonTrivialFinishCreation { hp("#if ASSERT_ENABLED\n") }
        if r.same(interfaceName, "DOMWindow") {
            hp("    void finishCreation(JSC::VM&, JSWindowProxy*);\n")
        } else if js.shouldCreateWithJSGlobalProxy(interface) {
            hp("    void finishCreation(JSC::VM&, JSC::JSGlobalProxy*);\n")
        } else {
            hp("    void finishCreation(JSC::VM&);\n")
        }
        if !js.hasNonTrivialFinishCreation { hp("#endif\n") }
    } else {
        hp("    DECLARE_DEFAULT_FINISH_CREATION;\n")
    }
    hp("};\n\n")
    if mo.shouldGenerateWrapperOwnerCode(hasParent, interface) {
        var overrideDecl: Str = "final"
        if r.same(interfaceName, "Node") {
            hp(cat([_]Str{ "class ", exportMacro, "JS", interfaceName, "Owner : public JSC::WeakHandleOwner {\n" }[0..]))
            overrideDecl = "override"
        } else if cg.inheritsInterface(interface, "Node") {
            hinclude("JSNode.h")
            hp(cat([_]Str{ "class ", exportMacro, "JS", interfaceName, "Owner final : public JSNodeOwner {\n" }[0..]))
        } else {
            hp(cat([_]Str{ "class ", exportMacro, "JS", interfaceName, "Owner final : public JSC::WeakHandleOwner {\n" }[0..]))
        }
        hinclude("<wtf/NeverDestroyed.h>")
        hp("public:\n")
        hp(cat([_]Str{ "    JS", interfaceName, "Owner() = default;\n" }[0..]))
        hp(cat([_]Str{ "    bool isReachableFromOpaqueRoots(JSC::Handle<JSC::Unknown>, void* context, JSC::AbstractSlotVisitor&, ASCIILiteral*) ", overrideDecl, ";\n" }[0..]))
        hp(cat([_]Str{ "    void finalize(JSC::Handle<JSC::Unknown>, void* context) ", overrideDecl, ";\n" }[0..]))
        hp("\n")
        hp("private:\n")
        hp(cat([_]Str{ "    explicit JS", interfaceName, "Owner(ClangVTableWorkaroundTag);\n" }[0..]))
        hp("};\n")
        hp("\n")
        hp(cat([_]Str{ "inline JSC::WeakHandleOwner* wrapperOwner(DOMWrapperWorld&, ", implType, "*)\n" }[0..]))
        hp("{\n")
        hp(cat([_]Str{ "    static NeverDestroyed<JS", interfaceName, "Owner> owner;\n" }[0..]))
        hp("    return &owner.get();\n")
        hp("}\n")
        hp("\n")
        hp(cat([_]Str{ "inline void* wrapperKey(", implType, "* wrappableObject)\n" }[0..]))
        hp("{\n")
        hp("    return wrappableObject;\n")
        hp("}\n")
        hp("\n")
    }
    if mo.shouldGenerateToJSDeclaration(hasParent, interface) {
        if r.same(implType, "Node") || r.same(implType, "NodeList") {
            hp(cat([_]Str{ "JSC::JSValue toJS(JSC::JSGlobalObject*, JSDOMGlobalObject*, ", implType, "&);\n" }[0..]))
        } else {
            hp(cat([_]Str{ exportMacro, "JSC::JSValue toJS(JSC::JSGlobalObject*, JSDOMGlobalObject*, ", implType, "&);\n" }[0..]))
        }
        hp(cat([_]Str{ "JSC::JSValue toJSNewlyCreated(JSC::JSGlobalObject*, JSDOMGlobalObject*, Ref<", implType, ">&&);\n" }[0..]))
        hp(cat([_]Str{ "ALWAYS_INLINE JSC::JSValue toJSNewlyCreated(JSC::JSGlobalObject* lexicalGlobalObject, JSDOMGlobalObject* globalObject, ", implType, "& impl) { return toJSNewlyCreated(lexicalGlobalObject, globalObject, Ref { impl }); }\n" }[0..]))
    }
    hp("\n")
    if mo.headerNeedsPrototypeDeclaration(interface) {
        hinclude("<WebCore/JSDOMBindingFacade.h>")
        mo.generatePrototypeDeclaration(js.headerContent, className, interface)
    }
    if on(interface, "DOMJIT") {
        r.setStr(js.implIncludes, "<JavaScriptCore/Snippet.h>", "1")
        r.sunshift(js.headerContent, "namespace JSC { class Snippet; }\n")
        hp("#if ENABLE(JIT)\n")
        hp(cat([_]Str{ "Ref<JSC::Snippet> checkSubClassSnippetFor", className, "();\n" }[0..]))
        hp("#endif\n")
    }
    if hasDOMJITAttributes {
        r.setStr(js.implIncludes, "<JavaScriptCore/DOMJITGetterSetter.h>", "1")
        r.sunshift(js.headerContent, "namespace JSC { namespace DOMJIT { class CallDOMGetterSnippet; } }\n")
        hp("// DOM JIT Attributes\n\n")
        index = 0
        while index < attributes.count {
            const attribute = m.node(attributes, index)
            index += 1
            if !on(attribute, "DOMJIT") { continue }
            if !cg.extendedAttributeContains(ext(attribute, "DOMJIT"), "Getter") { r.die("Only DOMJIT=Getter is supported for attributes") }
            const domJITClassName = cat([_]Str{ interfaceName, cg.wkUcfirst(attribute.*.name), "Attribute" }[0..])
            hp("#if ENABLE(JIT)\n")
            hp(cat([_]Str{ "Ref<JSC::DOMJIT::CallDOMGetterSnippet> compile", domJITClassName, "();\n" }[0..]))
            hp("#endif\n\n")
        }
    }
    if mo.hasCustomConstructor(interface) {
        hp("// Custom constructor\n")
        hp(cat([_]Str{ "JSC::EncodedJSValue construct", className, "(JSC::JSGlobalObject*, JSC::CallFrame&);\n\n" }[0..]))
    }
    if js.needsImplementationClass(interface) {
        hinclude("<WebCore/JSDOMWrapper.h>")
        hp(cat([_]Str{ "template<> struct JSDOMWrapperConverterTraits<", implType, "> {\n" }[0..]))
        hp(cat([_]Str{ "    using WrapperClass = ", className, ";\n" }[0..]))
        hp(cat([_]Str{ "    using ToWrappedReturnType = ", implType, "*;\n" }[0..]))
        hp("};\n")
    }
    hp(d.generateEnumerationsHeaderContent(interface, enumerations))
    hp(d.generateDictionariesHeaderContent(interface, dictionaries))
    const conditionalString = cg.generateConditionalString(interface.*.ext)
    hp("\n} // namespace WebCore\n")
    if r.truthy(conditionalString) { hp(cat([_]Str{ "\n#endif // ", conditionalString, "\n" }[0..])) }
    if on(interface, "AppleCopyright") {
        hp("\n")
        hp(js.endAppleCopyright)
    }

    var ancestors = r.strList()
    const chain = cg.parents(interface)
    index = 0
    while index < chain.count {
        r.spush(&ancestors, typeName(m.node(chain, index)))
        index += 1
    }
    index = 0
    while index < dictionaries.count {
        const dictionary = m.node(dictionaries, index)
        index += 1
        var parentType = dictionary.*.parentType
        while parentType != null {
            if cg.isExternalDictionaryType(parentType.?) { r.spush(&ancestors, parentType.?.*.name) }
            const parent = cg.getDictionaryByType(parentType.?)
            if parent == null { r.die(cat([_]Str{ "Unable to find definition for dictionary named '", parentType.?.*.name, "'!" }[0..])) }
            parentType = parent.?.*.parentType
        }
    }
    var files = r.strList()
    index = 0
    while index < ancestors.count {
        r.spush(&files, r.c2(ancestors.items[index], ".idl"))
        index += 1
    }
    r.spush(js.depsContent, r.c2(className, ".h : "))
    r.spush(js.depsContent, r.sjoin(files, " "))
    r.spush(js.depsContent, "\n")
    index = 0
    while index < ancestors.count {
        r.spush(js.depsContent, r.c2(ancestors.items[index], ".idl :\n"))
        index += 1
    }
}

pub fn getJSTypeForNode(interface: *Node) -> Str {
    if cg.inheritsInterface(interface, "Document") { return "JSDocumentWrapperType" }
    if cg.inheritsInterface(interface, "DocumentFragment") { return "JSDocumentFragmentNodeType" }
    if cg.inheritsInterface(interface, "DocumentType") { return "JSDocumentTypeNodeType" }
    if cg.inheritsInterface(interface, "ProcessingInstruction") { return "JSProcessingInstructionNodeType" }
    if cg.inheritsInterface(interface, "CDATASection") { return "JSCDATASectionNodeType" }
    if cg.inheritsInterface(interface, "Attr") { return "JSAttrNodeType" }
    if cg.inheritsInterface(interface, "Comment") { return "JSCommentNodeType" }
    if cg.inheritsInterface(interface, "Text") { return "JSTextNodeType" }
    if cg.inheritsInterface(interface, "Element") { return "JSElementType" }
    return "JSNodeType"
}
