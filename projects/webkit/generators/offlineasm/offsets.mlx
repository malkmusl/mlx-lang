// What offlineasm reads back from the extractor programs built from the
// headers it made (its offsets.rb): the tables of 64-bit integers in them,
// found by their magic numbers. A settings extractor has, per
// configuration it was built for, the header magic and the
// configuration's index; an offsets extractor has the header magic, then
// the index and each value, every one after the offset magic.
const std = @import("std")
const s = @import("../support.mlx")
const u = @import("./util.mlx")

pub const HEADER_MAGIC_0: u64 = 776207718
pub const HEADER_MAGIC_1: u64 = 1132052410
pub const MAGIC_0: u64 = 1549236935
pub const MAGIC_1: u64 = 267773781

// The bytes of two numbers of 8 bytes, little or big endian.
fn magicBytes(first: u64, second: u64, big: bool) -> []const u8 {
    const at = s.alloc(17)
    var index: usize = 0
    while index < 8 {
        const shift = @intCast(u64, if big { 7 - index } else { index }) * 8
        s.put8(at + index, @intCast(u8, (first >> shift) & 255))
        s.put8(at + 8 + index, @intCast(u8, (second >> shift) & 255))
        index += 1
    }
    return s.bytes(at, 16)
}

// sliceByteArrays: BYTES cut at each place PATTERN is, the pattern left
// out (the places tried one after another, as Ruby tries them). The
// pieces are the starts and ends of PIECES.
const Pieces = struct {
    starts: [*]usize
    ends: [*]usize
    count: usize
}

fn slice(bytes: []const u8, pattern: []const u8) -> Pieces {
    var found: usize = 0
    var index: usize = 0
    while index + pattern.length <= bytes.length {
        if bytes[index] == pattern[0] && std.text.same(bytes[index..index + pattern.length], pattern) { found += 1 }
        index += 1
    }
    var pieces: Pieces = undefined
    unsafe {
        pieces.starts = @ptrFromInt([*]usize, s.alloc((found + 1) * 8))
        pieces.ends = @ptrFromInt([*]usize, s.alloc((found + 1) * 8))
    }
    pieces.count = 0
    var last: usize = 0
    index = 0
    while index + pattern.length <= bytes.length {
        if bytes[index] == pattern[0] && std.text.same(bytes[index..index + pattern.length], pattern) {
            pieces.starts[pieces.count] = last
            pieces.ends[pieces.count] = if index > last { index } else { last }
            pieces.count += 1
            last = index + pattern.length
        }
        index += 1
    }
    pieces.starts[pieces.count] = last
    pieces.ends[pieces.count] = if bytes.length > last { bytes.length } else { last }
    pieces.count += 1
    return pieces
}

fn readInt(bytes: []const u8, big: bool) -> i128 {
    if bytes.length < 8 { s.fail("offlineasm: a value cut short in an extractor") }
    var value: u64 = 0
    var index: usize = 0
    while index < 8 {
        const byte = @intCast(u64, if big { bytes[index] } else { bytes[7 - index] })
        value = (value << 8) | byte
        index += 1
    }
    return @intCast(i128, @bitCast(i64, value))
}

fn variantFile(file: []const u8, variant: []const u8) -> []const u8 {
    if std.text.same(variant, "normal") { return file }
    return u.cat3(file, "_", variant)
}

// The configuration indices in the settings extractor FILE.
pub fn configurationIndices(file: []const u8, list: *u.Buf, count: *usize) -> void {
    const bytes = u.readFile(file)
    var found: usize = 0
    var endian: usize = 0
    while endian < 2 {
        const big = endian == 1
        const pieces = slice(bytes, magicBytes(HEADER_MAGIC_0, HEADER_MAGIC_1, big))
        var index: usize = 1
        while index < pieces.count {
            addValue(list, count, readInt(bytes[pieces.starts[index]..pieces.ends[index]], big))
            found += 1
            index += 1
        }
        endian += 1
    }
    if found == 0 {
        s.fail("OffsetExtractor: No magic values found. Skipping offsets extractor file generation.")
    }
}

// The values of a list kept in a buffer, 16 bytes each.
pub fn addValue(list: *u.Buf, count: *usize, value: i128) -> void {
    var bytes: [16]u8 = undefined
    var rest = @bitCast(u128, value)
    var index: usize = 0
    while index < 16 {
        bytes[index] = @intCast(u8, @intCast(u32, rest & 255))
        rest >>= 8
        index += 1
    }
    u.bufAdd(list, bytes[0..16])
    count.* += 1
}

pub fn valueAt(list: *u.Buf, index: usize) -> i128 {
    const bytes = s.bytes(list.*.base + index * 16, 16)
    var value: u128 = 0
    var at: usize = 16
    while at > 0 {
        at -= 1
        value = (value << 8) | @intCast(u128, bytes[at])
    }
    return @bitCast(i128, value)
}

// configurationIndicesForVariants: the indices of all the variants'
// files, each once.
pub fn configurationIndicesForVariants(file: []const u8, variants: [*][]const u8, variantCount: usize, list: *u.Buf, count: *usize) -> void {
    var all = u.bufNew(256)
    var allCount: usize = 0
    var variant: usize = 0
    while variant < variantCount {
        configurationIndices(variantFile(file, variants[variant]), &all, &allCount)
        variant += 1
    }
    var index: usize = 0
    while index < allCount {
        const value = valueAt(&all, index)
        var seen = false
        var other: usize = 0
        while other < count.* {
            if valueAt(list, other) == value { seen = true }
            other += 1
        }
        if !seen { addValue(list, count, value) }
        index += 1
    }
}

// A configuration of an offsets extractor: its index and its values.
pub const Configuration = struct {
    index: i128
    values: u.Buf
    count: usize
}

// offsetsAndConfigurationIndexForVariants: the configurations of the
// offsets extractor FILE (of each variant), a later one of an index
// replacing an earlier one in its place.
pub fn offsetsAndConfigurationIndexForVariants(file: []const u8, variants: [*][]const u8, variantCount: usize, configurations: [*]Configuration, count: *usize) -> void {
    var variant: usize = 0
    while variant < variantCount {
        const path = variantFile(file, variants[variant])
        const bytes = u.readFile(path)
        const first = count.*
        var endian: usize = 0
        while endian < 2 {
            const big = endian == 1
            const pieces = slice(bytes, magicBytes(HEADER_MAGIC_0, HEADER_MAGIC_1, big))
            var piece: usize = 1
            while piece < pieces.count {
                const config = bytes[pieces.starts[piece]..pieces.ends[piece]]
                const parts = slice(config, magicBytes(MAGIC_0, MAGIC_1, big))
                if parts.count < 2 { s.fail("offlineasm: no configuration index in an offsets extractor") }
                const index = readInt(config[parts.starts[1]..parts.ends[1]], big)
                var values = u.bufNew(1024)
                var valueCount: usize = 0
                var part: usize = 2
                while part < parts.count {
                    addValue(&values, &valueCount, readInt(config[parts.starts[part]..parts.ends[part]], big))
                    part += 1
                }
                var slot = count.*
                var other = first
                while other < count.* {
                    if configurations[other].index == index { slot = other }
                    other += 1
                }
                if slot == count.* {
                    if count.* == 64 { s.fail("offlineasm: too many configurations") }
                    count.* += 1
                }
                configurations[slot] = Configuration.{ .index = index, .values = values, .count = valueCount }
                piece += 1
            }
            endian += 1
        }
        if count.* == first {
            s.fail(u.cat3("offlineasm: No magic values found in ", path, ". Skipping assembly file generation."))
        }
        variant += 1
    }
}
