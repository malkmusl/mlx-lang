// JavaScriptCore's offlineasm in Mlx, for the X86_64 and C_LOOP backends: the
// LLInt's .asm sources (llint/LowLevelInterpreter.asm and the files it
// includes, InitBytecodes.asm from the -I directory among them) made the
// three headers WebKit's Ruby scripts make of them, to the byte:
//
//     webkit-offlineasm settings OFFLINEASM [-IDIR]... ASM OUTPUT BACKENDS
//         LLIntDesiredSettings.h (generate_settings_extractor.rb): a table
//         with every configuration of the settings the sources test, each
//         behind its #if, from which LLIntSettingsExtractor is built.
//     webkit-offlineasm offsets OFFLINEASM [-IDIR]... ASM SETTINGS_EXTRACTOR OUTPUT BACKENDS VARIANTS
//         LLIntDesiredOffsets.h (generate_offset_extractor.rb): for the
//         configuration the settings extractor holds, the structure
//         offsets, sizes and constant expressions the code uses, from
//         which LLIntOffsetsExtractor is built.
//     webkit-offlineasm assembly OFFLINEASM [-IDIR]... ASM OFFSETS_EXTRACTOR OUTPUT VARIANTS
//         LLIntAssembly.h (asm.rb): the interpreter as x86-64 assembly
//         (x86.mlx) or as C++ (cloop.mlx), with the values the offsets
//         extractor holds.
//
// with the options --webkit-additions-path=PATH and --depfile=DEPFILE,
// and for assembly --platform=OS and --binary-format=FORMAT. OFFLINEASM
// is WebKit's offlineasm directory: the first line of each header (the
// last of LLIntAssembly.h) has a SHA-1 of its Ruby files, as the scripts
// read them, so that a change to the assembler remakes the headers. A
// header whose hash line is that of its inputs already is left alone.
const std = @import("std")
const s = @import("../support.mlx")
const u = @import("./util.mlx")
const ast = @import("./ast.mlx")
const parser = @import("./parser.mlx")
const transform = @import("./transform.mlx")
const offsets = @import("./offsets.mlx")
const cloop = @import("./cloop.mlx")
const x86 = @import("./x86.mlx")

const Node = ast.Node

const BACKEND_COUNT: usize = 6

fn backendName(index: usize) -> []const u8 {
    if index == 0 { return "X86_64" }
    if index == 1 { return "ARMv7" }
    if index == 2 { return "ARM64" }
    if index == 3 { return "ARM64E" }
    if index == 4 { return "RISCV64" }
    return "C_LOOP"
}

fn backendIndex(name: []const u8) -> usize {
    var index: usize = 0
    while index < BACKEND_COUNT {
        if std.text.same(backendName(index), name) { return index }
        index += 1
    }
    return BACKEND_COUNT
}

// The backends one may generate for ($validBackends), in the order given.
var validBackends: [*]bool = undefined
var validOrder: [*]usize = undefined
var validCount: usize = 0

// The settings the sources test that are no backend, in the order the
// tree has them.
var settingNames: [*][]const u8 = undefined
var settingCount: usize = 0

// Options.
var depfilePointer: [*]const u8 = undefined
var depfileLength: usize = 0
var platformPointer: [*]const u8 = undefined
var platformLength: usize = 0
var hasPlatform = false
var binaryFormatIsELF = false

fn depfile() -> []const u8 { return if depfileLength == 0 { "" } else { depfilePointer[0..depfileLength] } }

fn upcase(text: []const u8) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        const byte = text[index]
        s.put8(at + index, if byte >= 97 && byte <= 122 { byte - 32 } else { byte })
        index += 1
    }
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

fn addValidBackend(name: []const u8) -> void {
    const index = backendIndex(name)
    if index == BACKEND_COUNT { return }
    var other: usize = 0
    while other < validCount {
        if validOrder[other] == index { return }
        other += 1
    }
    validBackends[index] = true
    validOrder[validCount] = index
    validCount += 1
}

// canonicalizeBackendNames and includeOnlyBackends of the list given (its
// names apart at commas and whitespace).
fn includeOnlyBackends(list: []const u8) -> void {
    var index: usize = 0
    while index < 8 {
        validBackends[index] = false
        index += 1
    }
    validCount = 0
    var at: usize = 0
    while at < list.length {
        while at < list.length && (list[at] == 44 || std.ascii.isCWhitespace(list[at])) { at += 1 }
        const start = at
        while at < list.length && !(list[at] == 44 || std.ascii.isCWhitespace(list[at])) { at += 1 }
        if at == start { continue }
        var name = upcase(list[start..at])
        if std.text.startsWith(name, "ARM") {
            const v7 = std.text.find(name, "ARMV7")
            if v7 < name.length {
                var rest = name[v7 + 5..name.length]
                var suffix: []const u8 = ""
                if rest.length > 0 && (rest[0] == 75 || rest[0] == 83) {
                    suffix = if rest[0] == 75 { "k" } else { "s" }
                    rest = rest[1..rest.length]
                }
                name = u.cat4(name[0..v7], "ARMv7", suffix, rest)
            }
            if std.text.same(name, "ARM64_32") { name = "ARM64" }
        }
        if std.text.same(name, "I386") { name = "X86" }
        addValidBackend(name)
        if std.text.startsWith(name, "ARMv7") { addValidBackend("ARMv7") }
    }
}

fn allBackendsValid() -> void {
    validCount = 0
    var index: usize = 0
    while index < BACKEND_COUNT {
        validBackends[index] = true
        validOrder[index] = index
        validCount += 1
        index += 1
    }
}

fn validBackendList() -> []const u8 {
    var text: []const u8 = ""
    var index: usize = 0
    while index < validCount {
        text = if index == 0 { backendName(validOrder[index]) } else { u.cat3(text, " ", backendName(validOrder[index])) }
        index += 1
    }
    return text
}

// ---------------------------------------------------------------------------
// Settings (settings.rb). A configuration's index counts the backends
// first, then each setting, true before false.

fn computeSettings(program: *Node) -> void {
    const settings = ast.filterUnique(program, ast.SETTING)
    unsafe { settingNames = @ptrFromInt([*][]const u8, s.alloc((settings.count + 1) * @sizeOf([]const u8))) }
    settingCount = 0
    var index: usize = 0
    while index < settings.count {
        const name = settings.items[index].*.name
        if backendIndex(name) == BACKEND_COUNT {
            settingNames[settingCount] = name
            settingCount += 1
        }
        index += 1
    }
}

fn combinationCount() -> u64 { return @intCast(u64, BACKEND_COUNT) << @intCast(u64, settingCount) }

fn backendOf(configuration: u64) -> usize { return @intCast(usize, configuration >> @intCast(u64, settingCount)) }

fn settingOf(configuration: u64, setting: usize) -> bool {
    return (configuration >> @intCast(u64, settingCount - 1 - setting)) & 1 == 0
}

fn cppSettingsTest(configuration: u64) -> []const u8 {
    var text = u.bufNew(1024)
    u.bufAdd(&text, "#if ")
    const backend = backendOf(configuration)
    var index: usize = 0
    while index < BACKEND_COUNT {
        if index > 0 { u.bufAdd(&text, " && ") }
        if index != backend { u.bufAdd(&text, "!") }
        u.bufAdd(&text, "OFFLINE_ASM_")
        u.bufAdd(&text, backendName(index))
        index += 1
    }
    index = 0
    while index < settingCount {
        u.bufAdd(&text, " && ")
        if !settingOf(configuration, index) { u.bufAdd(&text, "!") }
        u.bufAdd(&text, "OFFLINE_ASM_")
        u.bufAdd(&text, settingNames[index])
        index += 1
    }
    return u.bufText(&text)
}

fn settingsMap(configuration: u64) -> *u.Map {
    const map = u.mapNew(64)
    const backend = backendOf(configuration)
    var index: usize = 0
    while index < BACKEND_COUNT {
        u.mapPut(map, backendName(index), if index == backend { 1 } else { 2 })
        index += 1
    }
    index = 0
    while index < settingCount {
        u.mapPut(map, settingNames[index], if settingOf(configuration, index) { 1 } else { 2 })
        index += 1
    }
    return map
}

// ---------------------------------------------------------------------------
// Offsets, sizes and constant expressions, sorted (offsets.rb).

fn before(first: *Node, second: *Node) -> bool {
    const order = u.compare(first.*.name, second.*.name)
    if order != 0 { return order < 0 }
    return u.compare(first.*.text, second.*.text) < 0
}

fn sortedList(program: *Node, kind: u8) -> ast.List {
    const list = ast.filterUnique(program, kind)
    var index: usize = 1
    while index < list.count {
        const node = list.items[index]
        var at = index
        while at > 0 && before(node, list.items[at - 1]) {
            list.items[at] = list.items[at - 1]
            at -= 1
        }
        list.items[at] = node
        index += 1
    }
    return list
}

fn erroneous(program: *Node) -> ?*Node {
    const errors = ast.filterUnique(program, ast.ERROR)
    if errors.count > 0 { return errors.items[0] }
    return null
}

// ---------------------------------------------------------------------------
// The hash lines, and leaving a header alone.

fn selfHash(directory: []const u8) -> []const u8 {
    const names = u.listDirectory(directory)
    var contents = u.bufNew(1048576)
    var at: usize = 0
    while at < names.length {
        var end = at
        while names[end] != 0 { end += 1 }
        const name = names[at..end]
        if std.text.endsWith(name, ".rb") { u.bufAdd(&contents, u.readFile(u.joinPath(directory, name))) }
        at = end + 1
    }
    return u.sha1Hex(u.bufText(&contents))
}

fn firstLine(path: []const u8) -> []const u8 {
    const text = u.readFile(path)
    var at: usize = 0
    return s.nextLine(text, &at)
}

fn lastNonEmptyLine(path: []const u8) -> []const u8 {
    const text = u.readFile(path)
    var last: []const u8 = ""
    var at: usize = 0
    while at < text.length {
        const line = s.nextLine(text, &at)
        if line.length > 0 { last = line }
    }
    return last
}

fn upToDate(output: []const u8) -> bool {
    return u.exists(output) && (depfile().length == 0 || u.exists(depfile()))
}

// Shellwords.escape.
fn shellEscape(text: []const u8) -> []const u8 {
    if text.length == 0 { return "''" }
    var escaped = u.bufNew(text.length * 2 + 1)
    for byte in text {
        if byte == 10 {
            u.bufAdd(&escaped, "'\n'")
        } else {
            if !(u.isAlnum(byte) || byte == 95 || byte == 45 || byte == 46 || byte == 44 || byte == 58 || byte == 43 || byte == 47 || byte == 64) { u.bufByte(&escaped, 92) }
            u.bufByte(&escaped, byte)
        }
    }
    return u.bufText(&escaped)
}

// The depfile: OUTPUT and the sources parse() read, sorted, each once.
fn writeDepfile(output: []const u8) -> void {
    if depfile().length == 0 { return }
    const all = u.bufText(&parser.sources)
    var names: [*][]const u8 = undefined
    unsafe { names = @ptrFromInt([*][]const u8, s.alloc(4096 * @sizeOf([]const u8))) }
    var count: usize = 0
    var at: usize = 0
    while at < all.length {
        var end = at
        while all[end] != 0 { end += 1 }
        const name = all[at..end]
        var seen = false
        var other: usize = 0
        while other < count {
            if std.text.same(names[other], name) { seen = true }
            other += 1
        }
        if !seen && count < 4096 {
            var place = count
            while place > 0 && u.compare(name, names[place - 1]) < 0 {
                names[place] = names[place - 1]
                place -= 1
            }
            names[place] = name
            count += 1
        }
        at = end + 1
    }
    var text = u.bufNew(4096)
    u.bufAdd(&text, shellEscape(output))
    u.bufAdd(&text, ": ")
    var index: usize = 0
    while index < count {
        if index > 0 { u.bufAdd(&text, " ") }
        u.bufAdd(&text, shellEscape(names[index]))
        index += 1
    }
    u.bufByte(&text, 10)
    s.writeWhole(depfile(), u.bufText(&text))
}

// The output through OUTPUT.part, renamed when done.
fn writeThroughPart(output: []const u8) -> void {
    const part = u.joinPath(u.dirName(output), u.cat(s.baseName(output), ".part"))
    s.writeWhole(part, u.bufText(&cloop.output))
    u.rename(part, output)
}

// ---------------------------------------------------------------------------
// The three headers.

fn generateSettings(directory: []const u8, positional: [*][]const u8, count: usize) -> void {
    if count != 3 { usage() }
    const asmFile = positional[0]
    const output = positional[1]
    includeOnlyBackends(positional[2])
    const inputHash = u.cat5("// SettingsExtractor input hash: ", parser.parseHash(asmFile), " ", selfHash(directory), u.cat(" ", validBackendList()))
    if upToDate(output) && std.text.same(firstLine(output), inputHash) { return }
    const program = parser.parse(asmFile)
    writeDepfile(output)
    computeSettings(program)
    cloop.line(inputHash)
    const combinations = combinationCount()
    cloop.line(u.cat3("static const int64_t settingsExtractorTable[", s.decimal(combinations * 3), "] = {"))
    var configuration: u64 = 0
    while configuration < combinations {
        if validBackends[backendOf(configuration)] {
            cloop.line(cppSettingsTest(configuration))
            cloop.line(u.cat3("unsigned(", s.decimal(offsets.HEADER_MAGIC_0), "),"))
            cloop.line(u.cat3("unsigned(", s.decimal(offsets.HEADER_MAGIC_1), "),"))
            cloop.line(u.cat(s.decimal(configuration), ","))
            cloop.line("#endif")
        }
        configuration += 1
    }
    cloop.line("};")
    writeThroughPart(output)
}

fn magicLines() -> void {
    cloop.line(u.cat3("unsigned(", s.decimal(offsets.MAGIC_0), "),"))
    cloop.line(u.cat3("unsigned(", s.decimal(offsets.MAGIC_1), "),"))
}

// The variants given (apart at commas and whitespace).
fn splitVariants(text: []const u8, count: *usize) -> [*][]const u8 {
    var variants: [*][]const u8 = undefined
    unsafe { variants = @ptrFromInt([*][]const u8, s.alloc(64 * @sizeOf([]const u8))) }
    var at: usize = 0
    while at < text.length {
        while at < text.length && (text[at] == 44 || std.ascii.isCWhitespace(text[at])) { at += 1 }
        const start = at
        while at < text.length && !(text[at] == 44 || std.ascii.isCWhitespace(text[at])) { at += 1 }
        if at > start && count.* < 64 {
            variants[count.*] = text[start..at]
            count.* += 1
        }
    }
    return variants
}

fn generateOffsets(directory: []const u8, positional: [*][]const u8, count: usize) -> void {
    if count != 5 { usage() }
    const asmFile = positional[0]
    const settingsFile = positional[1]
    const output = positional[2]
    includeOnlyBackends(positional[3])
    var variantCount: usize = 0
    const variants = splitVariants(positional[4], &variantCount)
    var indices = u.bufNew(256)
    var indexCount: usize = 0
    offsets.configurationIndicesForVariants(settingsFile, variants, variantCount, &indices, &indexCount)
    var joined: []const u8 = ""
    var index: usize = 0
    while index < indexCount {
        joined = if index == 0 { u.decimal128(offsets.valueAt(&indices, 0)) } else { u.cat3(joined, " ", u.decimal128(offsets.valueAt(&indices, index))) }
        index += 1
    }
    const inputHash = u.cat5("// OffsetExtractor input hash: ", parser.parseHash(asmFile), " ", u.sha1Hex(joined), u.cat4(" ", selfHash(directory), " ", validBackendList()))
    if upToDate(output) && std.text.same(firstLine(output), inputHash) { return }
    const program = parser.parse(asmFile)
    computeSettings(program)
    writeDepfile(output)
    cloop.line(inputHash)
    index = 0
    while index < indexCount {
        const configuration = @intCast(u64, offsets.valueAt(&indices, index))
        if configuration >= combinationCount() { s.fail("offlineasm: a configuration index out of range") }
        if validBackends[backendOf(configuration)] {
            const lowLevel = transform.demacroify(transform.resolveSettings(program, settingsMap(configuration)))
            const offsetList = sortedList(lowLevel, ast.STRUCT_OFFSET)
            const sizeList = sortedList(lowLevel, ast.SIZEOF)
            const constList = sortedList(lowLevel, ast.CONST_EXPR)
            cloop.line(cppSettingsTest(configuration))
            const failing = erroneous(lowLevel)
            if failing != null {
                cloop.line(u.cat3("#error \"Invalid configuration. Error at: ", ast.originString(failing.?.*.origin), "\""))
            } else {
                var item: usize = 0
                while item < constList.count {
                    cloop.line(u.cat5("constexpr int64_t constValue", s.decimal(@intCast(u64, item)), " = static_cast<int64_t>(", constList.items[item].*.name, ");"))
                    item += 1
                }
                cloop.line("static const int64_t offsetExtractorTable[] = {")
                cloop.line(u.cat3("unsigned(", s.decimal(offsets.HEADER_MAGIC_0), "),"))
                cloop.line(u.cat3("unsigned(", s.decimal(offsets.HEADER_MAGIC_1), "),"))
                magicLines()
                cloop.line(u.cat(s.decimal(configuration), ","))
                item = 0
                while item < offsetList.count {
                    magicLines()
                    cloop.line(u.cat5("OFFLINE_ASM_OFFSETOF(", offsetList.items[item].*.name, ", ", offsetList.items[item].*.text, "),"))
                    item += 1
                }
                item = 0
                while item < sizeList.count {
                    magicLines()
                    cloop.line(u.cat3("sizeof(", sizeList.items[item].*.name, "),"))
                    item += 1
                }
                item = 0
                while item < constList.count {
                    magicLines()
                    cloop.line(u.cat3("constValue", s.decimal(@intCast(u64, item)), ","))
                    item += 1
                }
                cloop.line("};")
            }
            cloop.line("#endif")
        }
        index += 1
    }
    writeThroughPart(output)
}

fn generateAssembly(directory: []const u8, positional: [*][]const u8, count: usize) -> void {
    if count != 4 { usage() }
    const asmFile = positional[0]
    const offsetsFile = positional[1]
    const output = positional[2]
    var variantCount: usize = 0
    const variants = splitVariants(positional[3], &variantCount)
    allBackendsValid()
    var configurations: [*]offsets.Configuration = undefined
    unsafe { configurations = @ptrFromInt([*]offsets.Configuration, s.alloc(64 * @sizeOf(offsets.Configuration))) }
    var configurationCount: usize = 0
    offsets.offsetsAndConfigurationIndexForVariants(offsetsFile, variants, variantCount, configurations, &configurationCount)
    var joined = u.bufNew(16384)
    var index: usize = 0
    while index < configurationCount {
        var value: usize = 0
        while value < configurations[index].count {
            if joined.length > 0 { u.bufAdd(&joined, " ") }
            u.bufAdd(&joined, u.decimal128(offsets.valueAt(&configurations[index].values, value)))
            value += 1
        }
        if joined.length > 0 { u.bufAdd(&joined, " ") }
        u.bufAdd(&joined, u.decimal128(configurations[index].index))
        index += 1
    }
    const inputHash = u.cat5("// offlineasm input hash: ", parser.parseHash(asmFile), " ", u.sha1Hex(u.bufText(&joined)), u.cat4(" ", selfHash(directory), " ", u.sha1Hex(if hasPlatform { platformPointer[0..platformLength] } else { "" })))
    if upToDate(output) && std.text.same(lastNonEmptyLine(output), inputHash) { return }
    const program = parser.parse(asmFile)
    computeSettings(program)
    writeDepfile(output)
    index = 0
    while index < configurationCount {
        const configuration = @intCast(u64, configurations[index].index)
        if configuration >= combinationCount() { s.fail("offlineasm: a configuration index out of range") }
        const backend = backendOf(configuration)
        if validBackends[backend] {
            if backend != 5 && backend != 0 { s.fail("offlineasm: only the X86_64 and C_LOOP backends are supported") }
            var lowLevel = transform.demacroify(transform.resolveSettings(program, settingsMap(configuration)))
            // buildOffsetsMap: the values in the order of the lists.
            const offsetList = sortedList(lowLevel, ast.STRUCT_OFFSET)
            const sizeList = sortedList(lowLevel, ast.SIZEOF)
            const constList = sortedList(lowLevel, ast.CONST_EXPR)
            if offsetList.count + sizeList.count + constList.count != configurations[index].count { s.fail("offlineasm: the offsets extractor does not match the sources") }
            var value: usize = 0
            var item: usize = 0
            while item < offsetList.count + sizeList.count + constList.count {
                const node = if item < offsetList.count { offsetList.items[item] } else if item < offsetList.count + sizeList.count { sizeList.items[item - offsetList.count] } else { constList.items[item - offsetList.count - sizeList.count] }
                node.*.value = offsets.valueAt(&configurations[index].values, value)
                node.*.resolved = true
                value += 1
                item += 1
            }
            lowLevel = transform.resolve(lowLevel)
            cloop.line(cppSettingsTest(configuration))
            const failing = erroneous(lowLevel)
            if failing != null {
                cloop.line(u.cat3("#error \"Invalid configuration. Error at: ", ast.originString(failing.?.*.origin), "\""))
            } else {
                if backend == 0 {
                    // ($emitELFDebugDirectives, for every backend but the C_LOOP.)
                    x86.elfDirectives = binaryFormatIsELF
                    x86.lowerProgram(lowLevel)
                } else {
                    cloop.lowerProgram(lowLevel)
                }
            }
            cloop.line("#endif")
        }
        index += 1
    }
    cloop.line(inputHash)
    s.writeWhole(output, u.bufText(&cloop.output))
}

fn usage() -> void {
    s.fail("usage: webkit-offlineasm settings OFFLINEASM [-IDIR]... ASM OUTPUT BACKENDS\n       webkit-offlineasm offsets OFFLINEASM [-IDIR]... ASM SETTINGS_EXTRACTOR OUTPUT BACKENDS VARIANTS\n       webkit-offlineasm assembly OFFLINEASM [-IDIR]... ASM OFFSETS_EXTRACTOR OUTPUT VARIANTS\n   options: --webkit-additions-path=PATH --depfile=DEPFILE --platform=OS --binary-format=FORMAT")
}

// The value of "--NAME=VALUE" or of "--NAME VALUE"; AT moves past it.
fn optionValue(arguments: [][*]const u8, at: *usize, name: []const u8) -> []const u8 {
    const argument = std.text.cString(arguments[at.*])
    at.* += 1
    if argument.length > name.length && argument[name.length] == 61 { return argument[name.length + 1..argument.length] }
    if at.* >= arguments.length { usage() }
    const value = std.text.cString(arguments[at.*])
    at.* += 1
    return value
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 3 {
        usage()
        return 2
    }
    ast.initialize()
    parser.initialize()
    cloop.initialize()
    cloop.initializeShapes()
    unsafe {
        validBackends = @ptrFromInt([*]bool, s.alloc(8))
        validOrder = @ptrFromInt([*]usize, s.alloc(64))
    }
    const mode = std.text.cString(arguments[1])
    const directory = std.text.cString(arguments[2])
    var at: usize = 3
    // IncludeFile.processIncludeOptions: the -I options first.
    while at < arguments.length && std.text.startsWith(std.text.cString(arguments[at]), "-I") {
        const argument = std.text.cString(arguments[at])
        parser.addIncludeDir(argument[2..argument.length])
        at += 1
    }
    var positional: [*][]const u8 = undefined
    unsafe { positional = @ptrFromInt([*][]const u8, s.alloc(64 * @sizeOf([]const u8))) }
    var count: usize = 0
    while at < arguments.length {
        const argument = std.text.cString(arguments[at])
        if std.text.startsWith(argument, "--webkit-additions-path") {
            parser.setAdditionsPath(optionValue(arguments, &at, "--webkit-additions-path"))
        } else if std.text.startsWith(argument, "--depfile") {
            const value = optionValue(arguments, &at, "--depfile")
            depfilePointer = value.pointer
            depfileLength = value.length
        } else if std.text.startsWith(argument, "--platform") {
            const value = optionValue(arguments, &at, "--platform")
            platformPointer = value.pointer
            platformLength = value.length
            hasPlatform = true
        } else if std.text.startsWith(argument, "--binary-format") {
            // ELF's .size and .type of the labels (not for the C_LOOP).
            const format = optionValue(arguments, &at, "--binary-format")
            binaryFormatIsELF = std.text.same(format, "ELF")
        } else {
            if count == 64 { usage() }
            positional[count] = argument
            count += 1
            at += 1
        }
    }
    if std.text.same(mode, "settings") {
        generateSettings(directory, positional, count)
    } else if std.text.same(mode, "offsets") {
        generateOffsets(directory, positional, count)
    } else if std.text.same(mode, "assembly") {
        generateAssembly(directory, positional, count)
    } else {
        usage()
    }
    return 0
}
