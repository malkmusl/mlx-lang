// The C_LOOP backend of offlineasm (its cloop.rb, with the Assembler of
// asm.rb and the label lowering of backends.rb): each instruction of the
// resolved tree made the C++ statements LLIntAssembly.h has for it, the
// place in the .asm sources it came from in a comment at column 60 (when
// it is another place than the last one written).
const std = @import("std")
const s = @import("../support.mlx")
const u = @import("./util.mlx")
const ast = @import("./ast.mlx")

const Node = ast.Node

// ---------------------------------------------------------------------------
// The assembler: what is written, and the comments waiting for a line.

pub var output: u.Buf = undefined
// The place of the instruction being lowered, and the last one written
// (pointers and lengths).
var codeOriginPointer: [*]const u8 = undefined
var codeOriginLength: usize = 0
var hasCodeOrigin = false
var lastCodeOriginPointer: [*]const u8 = undefined
var lastCodeOriginLength: usize = 0
var hasLastCodeOrigin = false
// @newlineSpacerState: none, :global or :annotation.
const SPACER_NONE: u8 = 0
const SPACER_GLOBAL: u8 = 1
const SPACER_ANNOTATION: u8 = 2
var newlineSpacerState: u8 = 0
var uidCount: u64 = 0
const COMMENT_COLUMN: usize = 60

pub fn initialize() -> void { output = u.bufNew(8388608) }

pub fn line(text: []const u8) -> void {
    u.bufAdd(&output, text)
    u.bufByte(&output, 10)
}

// Assembler#lastComment: the place of the instruction, if it is another
// than the last one given.
fn lastComment() -> []const u8 {
    var result: []const u8 = ""
    const codeOrigin = codeOriginPointer[0..codeOriginLength]
    if hasCodeOrigin && (!hasLastCodeOrigin || !std.text.same(codeOrigin, lastCodeOriginPointer[0..lastCodeOriginLength])) {
        lastCodeOriginPointer = codeOriginPointer
        lastCodeOriginLength = codeOriginLength
        hasLastCodeOrigin = true
        result = codeOrigin
    }
    hasCodeOrigin = false
    if result.length > 0 { return u.cat("// ", result) }
    return result
}

fn formatDump(text: []const u8, comment: []const u8) -> []const u8 {
    if comment.length > 0 { return u.cat3(u.padRight(text, COMMENT_COLUMN), " ", comment) }
    return text
}

fn putc(text: []const u8) -> void { line(formatDump(u.cat("    ", text), lastComment())) }

fn putsNewlineSpacerIfAppropriate(state: u8) -> void {
    if newlineSpacerState != state {
        line("")
        newlineSpacerState = state
    }
}

fn putsLabel(name: []const u8, isGlobal: bool, isExport: bool, isAligned: bool, alignTo: []const u8) -> void {
    putsNewlineSpacerIfAppropriate(SPACER_GLOBAL)
    if isGlobal {
        if isAligned {
            if isExport {
                line(formatDump(u.cat3("OFFLINE_ASM_GLOBAL_EXPORT_LABEL(", name, ")"), lastComment()))
            } else if alignTo.length > 0 {
                line(formatDump(u.cat5("OFFLINE_ASM_ALIGNED_GLOBAL_LABEL(", name, ", ", alignTo, ")"), lastComment()))
            } else {
                line(formatDump(u.cat3("OFFLINE_ASM_GLOBAL_LABEL(", name, ")"), lastComment()))
            }
        } else if isExport {
            line(formatDump(u.cat3("OFFLINE_ASM_UNALIGNED_GLOBAL_EXPORT_LABEL(", name, ")"), lastComment()))
        } else {
            line(formatDump(u.cat3("OFFLINE_ASM_UNALIGNED_GLOBAL_LABEL(", name, ")"), lastComment()))
        }
    } else if s.startsWith(name, "llint_op_") {
        line(formatDump(u.cat3("OFFLINE_ASM_OPCODE_LABEL(op_", name[9..name.length], ")"), lastComment()))
    } else {
        if alignTo.length > 0 { line(formatDump(u.cat3("OFFLINE_ASM_ALIGN_TRAP(", alignTo, ")"), lastComment())) }
        line(formatDump(u.cat3("OFFLINE_ASM_GLUE_LABEL(", name, ")"), lastComment()))
    }
    newlineSpacerState = SPACER_NONE
}

fn putsLocalLabel(name: []const u8) -> void {
    line("")
    line(formatDump(u.cat3("  OFFLINE_ASM_LOCAL_LABEL(", name, ")"), lastComment()))
}

// Assembler#inAsm, around lowering the tree.
pub fn lowerProgram(program: *Node) -> void {
    hasCodeOrigin = false
    newlineSpacerState = SPACER_NONE
    uidCount = 0
    line("")
    line("OFFLINE_ASM_BEGIN")
    var index: usize = 0
    while index < program.*.count {
        lowerNode(program.*.items[index])
        index += 1
    }
    const comment = lastComment()
    if comment.length > 0 { line(comment) }
    line("OFFLINE_ASM_END")
}

fn lowerNode(node: *Node) -> void {
    const kind = node.*.kind
    if kind == ast.INSTRUCTION {
        const origin = ast.originString(node.*.origin)
        codeOriginPointer = origin.pointer
        codeOriginLength = origin.length
        hasCodeOrigin = true
        lowerInstruction(node)
    } else if kind == ast.LABEL {
        const alignTo = if node.*.a != null { ast.dump(node.*.a.?) } else { "" }
        putsLabel(node.*.name[1..node.*.name.length], node.*.isGlobal, node.*.isExport, node.*.isAligned, alignTo)
    } else if kind == ast.LOCAL_LABEL {
        putsLocalLabel(ast.localLabelString(node))
    } else if kind != ast.SKIP {
        s.fail(u.cat("offlineasm: Unexpected node at ", ast.originString(node.*.origin)))
    }
}

// ---------------------------------------------------------------------------
// Types of values, and operands as C++.

const INTPTR: u8 = 1
const UINTPTR: u8 = 2
const INT32: u8 = 3
const UINT32: u8 = 4
const INT16: u8 = 5
const UINT16: u8 = 6
const INT64: u8 = 7
const UINT64: u8 = 8
const INT8: u8 = 9
const UINT8: u8 = 10
const INT8_PTR: u8 = 11
const VOID_PTR: u8 = 12
const NATIVE_FUNC: u8 = 13
const DOUBLE: u8 = 14
const BITS_AS_DOUBLE: u8 = 15
const BITS_AS_INT64: u8 = 16
const OPCODE: u8 = 17

fn mapType(kind: u8) -> []const u8 {
    if kind == INTPTR { return ".i()" }
    if kind == UINTPTR { return ".u()" }
    if kind == INT32 { return ".i32()" }
    if kind == UINT32 { return ".u32()" }
    if kind == INT16 { return ".i16()" }
    if kind == UINT16 { return ".u16()" }
    if kind == INT64 { return ".i64()" }
    if kind == UINT64 { return ".u64()" }
    if kind == INT8 { return ".i8()" }
    if kind == UINT8 { return ".u8()" }
    if kind == INT8_PTR { return ".i8p()" }
    if kind == VOID_PTR { return ".vp()" }
    if kind == NATIVE_FUNC { return ".nativeFunc()" }
    if kind == DOUBLE { return ".d()" }
    if kind == BITS_AS_DOUBLE { return ".bitsAsDouble()" }
    if kind == BITS_AS_INT64 { return ".bitsAsInt64()" }
    if kind == OPCODE { return ".opcode()" }
    s.fail("offlineasm: Unsupported type")
    return ""
}

// The C++ type a memory reference of a type reads ("" for none).
fn memoryType(kind: u8) -> []const u8 {
    if kind == INT8 { return "int8_t" }
    if kind == INT16 { return "int16_t" }
    if kind == INT32 { return "int32_t" }
    if kind == INT64 { return "int64_t" }
    if kind == INTPTR { return "intptr_t" }
    if kind == UINT8 { return "uint8_t" }
    if kind == UINT16 { return "uint16_t" }
    if kind == UINT32 { return "uint32_t" }
    if kind == UINT64 { return "uint64_t" }
    if kind == UINTPTR { return "uintptr_t" }
    if kind == NATIVE_FUNC { return "NativeFunction" }
    if kind == OPCODE { return "Opcode" }
    if kind == DOUBLE { return "double" }
    return ""
}

fn badOperand(node: *Node, what: []const u8) -> void {
    s.fail(u.cat5("offlineasm: ", what, " of an operand of kind ", s.decimal(@intCast(u64, node.*.kind)), u.cat(" at ", ast.originString(node.*.origin))))
}

fn clDump(node: *Node) -> []const u8 {
    const kind = node.*.kind
    if kind == ast.REGISTER {
        const name = node.*.name
        if std.text.same(name, "t0") || std.text.same(name, "a0") || std.text.same(name, "r0") { return "t0" }
        if std.text.same(name, "t1") || std.text.same(name, "a1") || std.text.same(name, "r1") { return "t1" }
        if std.text.same(name, "t2") || std.text.same(name, "a2") { return "t2" }
        if std.text.same(name, "t3") || std.text.same(name, "a3") { return "t3" }
        if std.text.same(name, "t4") { return "pc" }
        if std.text.same(name, "t5") { return "t5" }
        if std.text.same(name, "t6") { return "t6" }
        if std.text.same(name, "t7") { return "t7" }
        if std.text.same(name, "csr0") { return "pcBase" }
        if std.text.same(name, "csr1") { return "numberTag" }
        if std.text.same(name, "csr2") { return "notCellMask" }
        if std.text.same(name, "csr3") { return "metadataTable" }
        if std.text.same(name, "cfr") { return "cfr" }
        if std.text.same(name, "lr") { return "lr" }
        if std.text.same(name, "sp") { return "sp" }
        s.fail(u.cat3("offlineasm: Bad register ", name, u.cat(" for C_LOOP at ", ast.originString(node.*.origin))))
    }
    if kind == ast.FP_REGISTER {
        const name = node.*.name
        if std.text.same(name, "ft0") || std.text.same(name, "fr") { return "d0" }
        if std.text.same(name, "ft1") { return "d1" }
        if std.text.same(name, "ft2") { return "d2" }
        if std.text.same(name, "ft3") { return "d3" }
        if std.text.same(name, "ft4") { return "d4" }
        if std.text.same(name, "ft5") { return "d5" }
        s.fail(u.cat3("offlineasm: Bad register ", name, u.cat(" for C_LOOP at ", ast.originString(node.*.origin))))
    }
    if kind == ast.IMMEDIATE { return u.decimal128(node.*.value) }
    if kind == ast.ADDRESS { return u.cat5("[", clDump(node.*.a.?), ", ", u.decimal128(node.*.b.?.*.value), "]") }
    if kind == ast.BASE_INDEX {
        return u.cat4(u.cat4("[", clDump(node.*.a.?), ", ", clDump(node.*.d.?)), ", ", clDump(node.*.b.?), u.cat3(" << ", s.decimal(scaleShift(node)), "]"))
    }
    if kind == ast.ABSOLUTE_ADDRESS { return ast.originString(node.*.origin) }
    badOperand(node, "clDump")
    return ""
}

fn scaleShift(node: *Node) -> u64 {
    const scale = node.*.c.?
    if scale.*.kind == ast.IMMEDIATE {
        if scale.*.value == 1 { return 0 }
        if scale.*.value == 2 { return 1 }
        if scale.*.value == 4 { return 2 }
        if scale.*.value == 8 { return 3 }
    }
    s.fail(u.cat("offlineasm: Bad scale at ", ast.originString(node.*.origin)))
    return 0
}

fn clValue(node: *Node, kind: u8) -> []const u8 {
    const nodeKind = node.*.kind
    if nodeKind == ast.REGISTER || nodeKind == ast.FP_REGISTER { return u.cat(clDump(node), mapType(kind)) }
    if nodeKind == ast.IMMEDIATE {
        // Positive values in hexadecimal (0x8000000000000000 is too large a
        // decimal for the compiler), negative ones in decimal.
        const value = node.*.value
        const text = if value < 0 { u.decimal128(value) } else { u.cat("0x", u.hex128(value)) }
        var cast: []const u8 = ""
        if kind == INT8 {
            cast = "int8_t"
        } else if kind == INT16 {
            cast = "int16_t"
        } else if kind == INT32 {
            cast = "int32_t"
        } else if kind == INT64 {
            cast = "int64_t"
        } else if kind == INTPTR {
            cast = "intptr_t"
        } else if kind == UINT8 {
            cast = "uint8_t"
        } else if kind == UINT32 {
            cast = "uint32_t"
        } else if kind == UINT64 {
            cast = "uint64_t"
        } else if kind == UINTPTR {
            cast = "uintptr_t"
        } else {
            s.fail(u.cat("offlineasm: Not implemented immediate of type at ", ast.originString(node.*.origin)))
        }
        return u.cat4(cast, "(", text, ")")
    }
    if nodeKind == ast.ADDRESS {
        if kind == UINT16 || memoryType(kind).length == 0 || kind == DOUBLE { s.fail(u.cat("offlineasm: Unexpected Address type at ", ast.originString(node.*.origin))) }
        return memRef(node, kind)
    }
    if nodeKind == ast.BASE_INDEX {
        if kind == NATIVE_FUNC || memoryType(kind).length == 0 || kind == DOUBLE { s.fail(u.cat("offlineasm: Unexpected BaseIndex type at ", ast.originString(node.*.origin))) }
        return memRef(node, kind)
    }
    badOperand(node, "clValue")
    return ""
}

fn clLValue(node: *Node, kind: u8) -> []const u8 {
    const nodeKind = node.*.kind
    if nodeKind == ast.REGISTER || nodeKind == ast.FP_REGISTER { return clDump(node) }
    if nodeKind == ast.ADDRESS || nodeKind == ast.BASE_INDEX { return clValue(node, kind) }
    badOperand(node, "clLValue")
    return ""
}

fn pointerExpr(node: *Node) -> []const u8 {
    const base = clValue(node.*.a.?, INT8_PTR)
    if node.*.kind == ast.ADDRESS {
        const offset = node.*.b.?.*.value
        if offset == 0 { return base }
        if offset > 0 { return u.cat3(base, " + ", u.decimal128(offset)) }
        return u.cat3(base, " - ", u.decimal128(0 - offset))
    }
    const scaled = u.cat5(base, " + (", clValue(node.*.b.?, INTPTR), " << ", u.cat(s.decimal(scaleShift(node)), ")"))
    if node.*.d.?.*.value == 0 { return scaled }
    return u.cat3(scaled, " + ", clValue(node.*.d.?, INTPTR))
}

// The memory reference of a type (Address#int32MemRef and the others).
fn memRef(node: *Node, kind: u8) -> []const u8 {
    if node.*.kind == ast.LABEL_REFERENCE && kind == INTPTR { return u.cat3("*CAST<intptr_t*>(&", cLabel(node), ")") }
    if node.*.kind != ast.ADDRESS && node.*.kind != ast.BASE_INDEX { badOperand(node, "a memory reference") }
    if node.*.kind == ast.BASE_INDEX && kind == NATIVE_FUNC { badOperand(node, "nativeFuncMemRef") }
    return u.cat5("*CAST<", memoryType(kind), "*>(", pointerExpr(node), ")")
}

fn cLabel(node: *Node) -> []const u8 {
    if node.*.kind == ast.LABEL_REFERENCE {
        const name = node.*.a.?.*.name
        const stripped = name[1..name.length]
        if s.startsWith(stripped, "llint_op_") { return u.cat("op_", stripped[9..stripped.length]) }
        return stripped
    }
    if node.*.kind == ast.LOCAL_LABEL_REFERENCE { return ast.localLabelString(node.*.a.?) }
    badOperand(node, "cLabel")
    return ""
}

fn emitLea(source: *Node, destination: *Node, kind: u8) -> void {
    if source.*.kind == ast.ADDRESS {
        const base = if destination == source.*.a.? { clValue(destination, INT8_PTR) } else { clValue(source.*.a.?, INT8_PTR) }
        putc(u.cat5(clLValue(destination, INT8_PTR), " = ", base, " + ", u.cat(clValue(source.*.b.?, kind), ";")))
    } else if source.*.kind == ast.BASE_INDEX {
        if source.*.d.?.*.value != 0 { s.fail("offlineasm: Malformed BaseIndex, offset should be zero") }
        putc(u.cat5(clLValue(destination, INT8_PTR), " = ", clValue(source.*.a.?, INT8_PTR), " + (", u.cat5(clValue(source.*.b.?, INTPTR), " << ", s.decimal(scaleShift(source)), ");", "")))
    } else if source.*.kind == ast.LABEL_REFERENCE {
        putc(u.cat4(clLValue(destination, VOID_PTR), " = CAST<void*>(&", cLabel(source), ");"))
        if source.*.value != 0 {
            putc(u.cat5(clLValue(destination, INT8_PTR), " = ", clValue(destination, INT8_PTR), " + ", u.cat(u.decimal128(source.*.value), ";")))
        }
    } else {
        badOperand(source, "lea")
    }
}

// ---------------------------------------------------------------------------
// The kinds of instructions.

const OPERATION: u8 = 1
const SHIFT: u8 = 2
const UNARY: u8 = 3
const COMPARE_BRANCH: u8 = 4
const NAN_BRANCH: u8 = 5
const TEST_BRANCH: u8 = 6
const COMPARE_SET: u8 = 7
const TEST_SET: u8 = 8
const OP_BRANCH: u8 = 9
const OVERFLOW_BRANCH: u8 = 10
const SPECIAL: u8 = 11

const Shape = struct {
    group: u8
    kind: u8
    operator: []const u8
    condition: []const u8
}

var shapes: [*]Shape = undefined
var shapeCount: usize = 0
var shapeIndex: *u.Map = undefined

fn shape(name: []const u8, group: u8, kind: u8, operator: []const u8, condition: []const u8) -> void {
    shapes[shapeCount] = Shape.{ .group = group, .kind = kind, .operator = operator, .condition = condition }
    shapeCount += 1
    u.mapPut(shapeIndex, name, shapeCount)
}

fn special(name: []const u8) -> void { shape(name, SPECIAL, 0, "", "") }

// The branches and sets of one comparison over the sizes b, i, q, p.
fn comparisons(name: []const u8, operator: []const u8, signed: bool) -> void {
    shape(u.cat3("bb", name, ""), COMPARE_BRANCH, if signed { INT8 } else { UINT8 }, operator, "")
    shape(u.cat3("bi", name, ""), COMPARE_BRANCH, if signed { INT32 } else { UINT32 }, operator, "")
    shape(u.cat3("bq", name, ""), COMPARE_BRANCH, if signed { INT64 } else { UINT64 }, operator, "")
    shape(u.cat3("bp", name, ""), COMPARE_BRANCH, if signed { INTPTR } else { UINTPTR }, operator, "")
}

fn sets(name: []const u8, operator: []const u8, signed: bool) -> void {
    shape(u.cat("cb", name), COMPARE_SET, if signed { INT8 } else { UINT8 }, operator, "")
    shape(u.cat("ci", name), COMPARE_SET, if signed { INT32 } else { UINT32 }, operator, "")
    shape(u.cat("cq", name), COMPARE_SET, if signed { INT64 } else { UINT64 }, operator, "")
    shape(u.cat("cp", name), COMPARE_SET, if signed { INTPTR } else { UINTPTR }, operator, "")
}

pub fn initializeShapes() -> void {
    unsafe { shapes = @ptrFromInt([*]Shape, s.alloc(512 * @sizeOf(Shape))) }
    shapeIndex = u.mapNew(1024)
    shape("addi", OPERATION, INT32, "+", "")
    shape("addq", OPERATION, INT64, "+", "")
    shape("addp", OPERATION, INTPTR, "+", "")
    shape("andi", OPERATION, INT32, "&", "")
    shape("andq", OPERATION, INT64, "&", "")
    shape("andp", OPERATION, INTPTR, "&", "")
    shape("ori", OPERATION, INT32, "|", "")
    shape("orq", OPERATION, INT64, "|", "")
    shape("orp", OPERATION, INTPTR, "|", "")
    shape("orh", OPERATION, INT16, "|", "")
    shape("xori", OPERATION, INT32, "^", "")
    shape("xorq", OPERATION, INT64, "^", "")
    shape("xorp", OPERATION, INTPTR, "^", "")
    shape("lshifti", SHIFT, INT32, "<<", "")
    shape("lshiftq", SHIFT, INT64, "<<", "")
    shape("lshiftp", SHIFT, INTPTR, "<<", "")
    shape("rshifti", SHIFT, INT32, ">>", "")
    shape("rshiftq", SHIFT, INT64, ">>", "")
    shape("rshiftp", SHIFT, INTPTR, ">>", "")
    shape("urshifti", SHIFT, UINT32, ">>", "")
    shape("urshiftq", SHIFT, UINT64, ">>", "")
    shape("urshiftp", SHIFT, UINTPTR, ">>", "")
    shape("muli", OPERATION, INT32, "*", "")
    shape("mulq", OPERATION, INT64, "*", "")
    shape("mulp", OPERATION, INTPTR, "*", "")
    shape("subi", OPERATION, INT32, "-", "")
    shape("subq", OPERATION, INT64, "-", "")
    shape("subp", OPERATION, INTPTR, "-", "")
    shape("negi", UNARY, INT32, "-", "")
    shape("negq", UNARY, INT64, "-", "")
    shape("negp", UNARY, INTPTR, "-", "")
    shape("noti", UNARY, INT32, "~", "")
    shape("addd", OPERATION, DOUBLE, "+", "")
    shape("divd", OPERATION, DOUBLE, "/", "")
    shape("subd", OPERATION, DOUBLE, "-", "")
    shape("muld", OPERATION, DOUBLE, "*", "")
    shape("bdeq", COMPARE_BRANCH, DOUBLE, "==", "")
    shape("bdneq", COMPARE_BRANCH, DOUBLE, "!=", "")
    shape("bdgt", COMPARE_BRANCH, DOUBLE, ">", "")
    shape("bdgteq", COMPARE_BRANCH, DOUBLE, ">=", "")
    shape("bdlt", COMPARE_BRANCH, DOUBLE, "<", "")
    shape("bdlteq", COMPARE_BRANCH, DOUBLE, "<=", "")
    shape("bdequn", NAN_BRANCH, DOUBLE, "==", "")
    shape("bdnequn", NAN_BRANCH, DOUBLE, "!=", "")
    shape("bdgtun", NAN_BRANCH, DOUBLE, ">", "")
    shape("bdgtequn", NAN_BRANCH, DOUBLE, ">=", "")
    shape("bdltun", NAN_BRANCH, DOUBLE, "<", "")
    shape("bdltequn", NAN_BRANCH, DOUBLE, "<=", "")
    comparisons("eq", "==", true)
    comparisons("neq", "!=", true)
    comparisons("a", ">", false)
    comparisons("aeq", ">=", false)
    comparisons("b", "<", false)
    comparisons("beq", "<=", false)
    comparisons("gt", ">", true)
    comparisons("gteq", ">=", true)
    comparisons("lt", "<", true)
    comparisons("lteq", "<=", true)
    shape("btbz", TEST_BRANCH, INT8, "", "== 0")
    shape("btiz", TEST_BRANCH, INT32, "", "== 0")
    shape("btqz", TEST_BRANCH, INT64, "", "== 0")
    shape("btpz", TEST_BRANCH, INTPTR, "", "== 0")
    shape("btbnz", TEST_BRANCH, INT8, "", "!= 0")
    shape("btinz", TEST_BRANCH, INT32, "", "!= 0")
    shape("btqnz", TEST_BRANCH, INT64, "", "!= 0")
    shape("btpnz", TEST_BRANCH, INTPTR, "", "!= 0")
    shape("btbs", TEST_BRANCH, INT8, "", "< 0")
    shape("btis", TEST_BRANCH, INT32, "", "< 0")
    shape("btqs", TEST_BRANCH, INT64, "", "< 0")
    shape("btps", TEST_BRANCH, INTPTR, "", "< 0")
    // Comparisons setting a value: eq and neq unsigned here.
    sets("eq", "==", false)
    sets("neq", "!=", false)
    sets("a", ">", false)
    sets("aeq", ">=", false)
    sets("b", "<", false)
    sets("beq", "<=", false)
    sets("gt", ">", true)
    sets("gteq", ">=", true)
    sets("lt", "<", true)
    sets("lteq", "<=", true)
    shape("cdgt", COMPARE_SET, DOUBLE, ">", "")
    shape("cdgteq", COMPARE_SET, DOUBLE, ">=", "")
    shape("cdlt", COMPARE_SET, DOUBLE, "<", "")
    shape("cdlteq", COMPARE_SET, DOUBLE, "<=", "")
    shape("tbs", TEST_SET, INT8, "", "< 0")
    shape("tis", TEST_SET, INT32, "", "< 0")
    shape("tqs", TEST_SET, INT64, "", "< 0")
    shape("tps", TEST_SET, INTPTR, "", "< 0")
    shape("tbz", TEST_SET, INT8, "", "== 0")
    shape("tiz", TEST_SET, INT32, "", "== 0")
    shape("tqz", TEST_SET, INT64, "", "== 0")
    shape("tpz", TEST_SET, INTPTR, "", "== 0")
    shape("tbnz", TEST_SET, INT8, "", "!= 0")
    shape("tinz", TEST_SET, INT32, "", "!= 0")
    shape("tqnz", TEST_SET, INT64, "", "!= 0")
    shape("tpnz", TEST_SET, INTPTR, "", "!= 0")
    shape("baddio", OVERFLOW_BRANCH, INT32, "+", "")
    shape("bsubio", OVERFLOW_BRANCH, INT32, "-", "")
    shape("bmulio", OVERFLOW_BRANCH, INT32, "*", "")
    shape("baddis", OP_BRANCH, INT32, "+", "< 0")
    shape("baddiz", OP_BRANCH, INT32, "+", "== 0")
    shape("baddinz", OP_BRANCH, INT32, "+", "!= 0")
    shape("baddqs", OP_BRANCH, INT64, "+", "< 0")
    shape("baddqz", OP_BRANCH, INT64, "+", "== 0")
    shape("baddqnz", OP_BRANCH, INT64, "+", "!= 0")
    shape("baddps", OP_BRANCH, INTPTR, "+", "< 0")
    shape("baddpz", OP_BRANCH, INTPTR, "+", "== 0")
    shape("baddpnz", OP_BRANCH, INTPTR, "+", "!= 0")
    shape("bsubis", OP_BRANCH, INT32, "-", "< 0")
    shape("bsubiz", OP_BRANCH, INT32, "-", "== 0")
    shape("bsubinz", OP_BRANCH, INT32, "-", "!= 0")
    shape("borris", OP_BRANCH, INT32, "|", "< 0")
    shape("borriz", OP_BRANCH, INT32, "|", "== 0")
    shape("borrinz", OP_BRANCH, INT32, "|", "!= 0")
    special("loadi")
    special("loadis")
    special("loadq")
    special("loadp")
    special("storei")
    special("storeq")
    special("storep")
    special("loadb")
    special("loadbsi")
    special("loadbsq")
    special("storeb")
    special("loadh")
    special("loadhsi")
    special("loadhsq")
    special("storeh")
    special("loadd")
    special("stored")
    special("transferi")
    special("transferq")
    special("transferp")
    special("ci2ds")
    special("td2i")
    special("bcd2i")
    special("move")
    special("sxi2q")
    special("zxi2q")
    special("sxb2i")
    special("sxh2i")
    special("sxb2q")
    special("sxb2p")
    special("sxh2q")
    special("nop")
    special("jmp")
    special("call")
    special("break")
    special("ret")
    special("cdqi")
    special("idivi")
    special("fii2d")
    special("fd2ii")
    special("fq2d")
    special("fd2q")
    special("leai")
    special("leap")
    special("memfence")
    special("push")
    special("pop")
    special("cloopCrash")
    special("cloopCallJSFunction")
    special("cloopCallNative")
    special("cloopCallSlowPath")
    special("cloopCallSlowPathVoid")
    special("cloopCallSlowPath3")
    special("cloopCallSlowPath4")
    special("cloopDo")
}

// ---------------------------------------------------------------------------
// Lowering an instruction.

fn emitOperation(operands: [*]*Node, count: usize, kind: u8, operator: []const u8) -> void {
    var first = operands[1]
    var second = operands[0]
    var destination = operands[1]
    if count == 3 {
        first = operands[0]
        second = operands[1]
        destination = operands[2]
    } else if count != 2 {
        s.fail("offlineasm: an operation needs 2 or 3 operands")
    }
    if destination.*.kind == ast.IMMEDIATE { s.fail("offlineasm: an operation into an immediate") }
    var header: []const u8 = ""
    var footer: []const u8 = ""
    if destination.*.kind == ast.REGISTER && (kind == INT32 || kind == UINT32) {
        header = "(uint32_t)("
        footer = ")"
    } else if destination.*.kind == ast.REGISTER && kind == INT16 {
        header = "(uint16_t)("
        footer = ")"
    }
    putc(u.cat4(u.cat4(clLValue(destination, kind), " = ", header, clValue(first, kind)), u.cat3(" ", operator, " "), clValue(second, kind), u.cat(footer, ";")))
}

fn emitShift(operands: [*]*Node, count: usize, kind: u8, operator: []const u8) -> void {
    const destination = if count == 3 { operands[2] } else { operands[1] }
    var header: []const u8 = ""
    var footer: []const u8 = ""
    if destination.*.kind == ast.REGISTER && (kind == INT32 || kind == UINT32) {
        header = "(uint32_t)("
        footer = ")"
    }
    var mask = "0x1f"
    if kind == INTPTR || kind == UINTPTR {
        mask = "((sizeof(uintptr_t) == 8) ? 0x3f : 0x1f)"
    } else if kind == INT64 || kind == UINT64 {
        mask = "0x3f"
    }
    putc(u.cat4(u.cat4(clLValue(destination, kind), " = ", header, clValue(operands[1], kind)), u.cat3(" ", operator, " ("), clValue(operands[0], INTPTR), u.cat5(" & ", mask, ")", footer, ";")))
}

fn emitUnary(operands: [*]*Node, count: usize, kind: u8, operator: []const u8) -> void {
    if count != 1 { s.fail("offlineasm: a unary operation needs 1 operand") }
    const destination = operands[0]
    if destination.*.kind == ast.IMMEDIATE { s.fail("offlineasm: a unary operation on an immediate") }
    var header: []const u8 = ""
    var footer: []const u8 = ""
    if destination.*.kind == ast.REGISTER && (kind == INT32 || kind == UINT32) {
        header = "(uint32_t)("
        footer = ")"
    }
    putc(u.cat4(u.cat4(clLValue(destination, kind), " = ", header, operator), clValue(destination, kind), footer, ";"))
}

// cloopGenerateConditionExpression.
fn conditionExpression(operands: [*]*Node, count: usize, kind: u8, condition: []const u8) -> []const u8 {
    const first = clValue(operands[0], kind)
    var left = first
    if count == 3 {
        left = u.cat5("(", first, " & ", clValue(operands[1], kind), ")")
    } else if count != 2 {
        s.fail("offlineasm: Expected 2 or 3 operands")
    }
    return u.cat3(left, " ", condition)
}

fn lowerInstruction(node: *Node) -> void {
    const opcode = node.*.name
    const operands = node.*.items
    const count = node.*.count
    const found = u.mapGet(shapeIndex, opcode)
    if found == 0 {
        lowerDefault(node)
        return
    }
    const form = shapes[found - 1]
    const kind = form.kind
    if form.group == OPERATION {
        emitOperation(operands, count, kind, form.operator)
    } else if form.group == SHIFT {
        emitShift(operands, count, kind, form.operator)
    } else if form.group == UNARY {
        emitUnary(operands, count, kind, form.operator)
    } else if form.group == COMPARE_BRANCH {
        putc(u.cat5("if (", clValue(operands[0], kind), u.cat3(" ", form.operator, " "), clValue(operands[1], kind), ")"))
        putc(u.cat3("    goto ", cLabel(operands[2]), ";"))
    } else if form.group == NAN_BRANCH {
        const left = clValue(operands[0], DOUBLE)
        const right = clValue(operands[1], DOUBLE)
        putc(u.cat5("if (std::isnan(", left, ") || std::isnan(", right, ")"))
        putc(u.cat5("    || (", left, u.cat3(" ", form.operator, " "), right, "))"))
        putc(u.cat3("    goto ", cLabel(operands[2]), ";"))
    } else if form.group == TEST_BRANCH {
        putc(u.cat3("if (", conditionExpression(operands, count, kind, form.condition), ")"))
        putc(u.cat3("    goto ", cLabel(operands[count - 1]), ";"))
    } else if form.group == COMPARE_SET {
        putc(u.cat5(clLValue(operands[2], kind), " = (", clValue(operands[0], kind), u.cat3(" ", form.operator, " "), u.cat(clValue(operands[1], kind), ");")))
    } else if form.group == TEST_SET {
        putc(u.cat4(clLValue(operands[count - 1], INTPTR), " = (", conditionExpression(operands, count, kind, form.condition), ");"))
    } else if form.group == OP_BRANCH {
        const temporary = if kind == INTPTR { "intptr_t" } else if kind == INT32 { "int32_t" } else { "int64_t" }
        putc("{")
        putc(u.cat5(u.cat3("    ", temporary, " temp = "), clValue(operands[1], kind), u.cat3(" ", form.operator, " "), clValue(operands[0], kind), ";"))
        putc(u.cat3("    ", clLValue(operands[1], kind), " = temp;"))
        putc(u.cat3("    if (temp ", form.condition, ")"))
        putc(u.cat3("        goto  ", cLabel(operands[2]), ";"))
        putc("}")
    } else if form.group == OVERFLOW_BRANCH {
        putc("{")
        const operation = if std.text.same(form.operator, "+") { "add" } else if std.text.same(form.operator, "-") { "sub" } else { "multiply" }
        putc("    int32_t result;")
        putc(u.cat5("    bool success = WTF::ArithmeticOperations<int32_t, int32_t, int32_t>::", operation, "(", clValue(operands[1], kind), u.cat3(", ", clValue(operands[0], kind), ", result);")))
        putc(u.cat3("    ", clLValue(operands[1], kind), " = (uint32_t)(result);"))
        putc("    if (!success)")
        putc(u.cat3("        goto ", cLabel(operands[2]), ";"))
        putc("}")
    } else {
        lowerSpecial(node, opcode, operands, count)
    }
}

fn assign(left: []const u8, right: []const u8) -> void { putc(u.cat4(left, " = ", right, ";")) }

fn lowerSpecial(node: *Node, opcode: []const u8, operands: [*]*Node, count: usize) -> void {
    if std.text.same(opcode, "loadi") {
        assign(clLValue(operands[1], UINT32), memRef(operands[0], UINT32))
    } else if std.text.same(opcode, "loadis") {
        assign(clLValue(operands[1], INT32), memRef(operands[0], INT32))
    } else if std.text.same(opcode, "loadq") {
        assign(clLValue(operands[1], INT64), memRef(operands[0], INT64))
    } else if std.text.same(opcode, "loadp") {
        assign(clLValue(operands[1], INTPTR), memRef(operands[0], INTPTR))
    } else if std.text.same(opcode, "storei") {
        assign(memRef(operands[1], INT32), clValue(operands[0], INT32))
    } else if std.text.same(opcode, "storeq") {
        assign(memRef(operands[1], INT64), clValue(operands[0], INT64))
    } else if std.text.same(opcode, "storep") {
        assign(memRef(operands[1], INTPTR), clValue(operands[0], INTPTR))
    } else if std.text.same(opcode, "loadb") {
        assign(clLValue(operands[1], INTPTR), memRef(operands[0], UINT8))
    } else if std.text.same(opcode, "loadbsi") {
        assign(clLValue(operands[1], UINT32), u.cat3("(uint32_t)((int32_t)", memRef(operands[0], INT8), ")"))
    } else if std.text.same(opcode, "loadbsq") {
        assign(clLValue(operands[1], UINT64), u.cat("(int64_t)", memRef(operands[0], INT8)))
    } else if std.text.same(opcode, "storeb") {
        assign(memRef(operands[1], UINT8), clValue(operands[0], INT8))
    } else if std.text.same(opcode, "loadh") {
        assign(clLValue(operands[1], INTPTR), memRef(operands[0], UINT16))
    } else if std.text.same(opcode, "loadhsi") {
        assign(clLValue(operands[1], UINT32), u.cat3("(uint32_t)((int32_t)", memRef(operands[0], INT16), ")"))
    } else if std.text.same(opcode, "loadhsq") {
        assign(clLValue(operands[1], UINT64), u.cat("(int64_t)", memRef(operands[0], INT16)))
    } else if std.text.same(opcode, "storeh") {
        assign(memRef(operands[1], UINT16), clValue(operands[0], INT16))
    } else if std.text.same(opcode, "loadd") {
        assign(clLValue(operands[1], DOUBLE), memRef(operands[0], DOUBLE))
    } else if std.text.same(opcode, "stored") {
        assign(memRef(operands[1], DOUBLE), clValue(operands[0], DOUBLE))
    } else if std.text.same(opcode, "transferi") {
        putc(u.cat3(memRef(operands[1], UINT32), " = ", memRef(operands[0], UINT32)))
    } else if std.text.same(opcode, "transferq") {
        putc(u.cat3(memRef(operands[1], UINT64), " = ", memRef(operands[0], UINT64)))
    } else if std.text.same(opcode, "transferp") {
        putc(u.cat3(memRef(operands[1], UINTPTR), " = ", memRef(operands[0], UINTPTR)))
    } else if std.text.same(opcode, "ci2ds") {
        putc(u.cat4(clLValue(operands[1], DOUBLE), " = (double)", clValue(operands[0], INT32), "; // ci2ds"))
    } else if std.text.same(opcode, "td2i") {
        putc(u.cat4(clLValue(operands[1], INTPTR), " = (uint32_t)(intptr_t)", clValue(operands[0], DOUBLE), "; // td2i"))
    } else if std.text.same(opcode, "bcd2i") {
        putc("{ // bcd2i")
        putc(u.cat3("    double d = ", clValue(operands[0], DOUBLE), ";"))
        putc("    const int32_t asInt32 = int32_t(d);")
        putc("    if (asInt32 != d || (!asInt32 && std::signbit(d))) // true for -0.0")
        putc(u.cat3("        goto  ", cLabel(operands[2]), ";"))
        putc(u.cat3("    ", clLValue(operands[1], INTPTR), " = (uint32_t)asInt32;"))
        putc("}")
    } else if std.text.same(opcode, "move") {
        assign(clLValue(operands[1], INTPTR), clValue(operands[0], INTPTR))
    } else if std.text.same(opcode, "sxi2q") {
        assign(clLValue(operands[1], INT64), clValue(operands[0], INT32))
    } else if std.text.same(opcode, "zxi2q") {
        assign(clLValue(operands[1], UINT64), clValue(operands[0], UINT32))
    } else if std.text.same(opcode, "sxb2i") {
        assign(clLValue(operands[1], INT32), clValue(operands[0], INT8))
    } else if std.text.same(opcode, "sxh2i") {
        assign(clLValue(operands[1], INT32), clValue(operands[0], INT16))
    } else if std.text.same(opcode, "sxb2q") || std.text.same(opcode, "sxb2p") {
        assign(clLValue(operands[1], INT64), clValue(operands[0], INT8))
    } else if std.text.same(opcode, "sxh2q") {
        assign(clLValue(operands[1], INT64), clValue(operands[0], INT16))
    } else if std.text.same(opcode, "nop") {
        putc("// nop")
    } else if std.text.same(opcode, "jmp") {
        const target = operands[0]
        if target.*.kind == ast.LOCAL_LABEL_REFERENCE || target.*.kind == ast.LABEL_REFERENCE {
            putc(u.cat3("goto ", cLabel(target), ";"))
        } else {
            putc(u.cat3("opcode = ", clValue(target, OPCODE), ";"))
            putc("DISPATCH_OPCODE();")
        }
    } else if std.text.same(opcode, "call") {
        putc("CRASH(); // generic call instruction not supported by design!")
    } else if std.text.same(opcode, "break") {
        putc("CRASH(); // break instruction not implemented.")
    } else if std.text.same(opcode, "ret") {
        putc("opcode = lr.opcode();")
        putc("DISPATCH_OPCODE();")
    } else if std.text.same(opcode, "cdqi") {
        putc("{ // cdqi")
        putc("    int64_t temp = t0.i32(); // sign extend the low 32bit")
        putc("    t0 = (uint32_t)temp; // low word")
        putc("    t1 = (uint32_t)(temp >> 32); // high word")
        putc("}")
    } else if std.text.same(opcode, "idivi") {
        putc("{ // idivi")
        putc("    int64_t dividend = (int64_t(t1.u32()) << 32) | t0.u32();")
        putc(u.cat3("    int64_t divisor = ", clValue(operands[0], INTPTR), ";"))
        putc("    t1 = (uint32_t)(dividend % divisor); // remainder")
        putc("    t0 = (uint32_t)(dividend / divisor); // quotient")
        putc("}")
    } else if std.text.same(opcode, "fii2d") {
        putc(u.cat5(clLValue(operands[2], DOUBLE), " = ints2Double(", clValue(operands[0], UINT32), ", ", u.cat(clValue(operands[1], UINT32), "); // fii2d")))
    } else if std.text.same(opcode, "fd2ii") {
        putc(u.cat5("double2Ints(", clValue(operands[0], DOUBLE), ", ", clDump(operands[1]), u.cat3(", ", clDump(operands[2]), "); // fd2ii")))
    } else if std.text.same(opcode, "fq2d") {
        putc(u.cat4(clLValue(operands[1], DOUBLE), " = ", clValue(operands[0], BITS_AS_DOUBLE), "; // fq2d"))
    } else if std.text.same(opcode, "fd2q") {
        putc(u.cat4(clLValue(operands[1], INT64), " = ", clValue(operands[0], BITS_AS_INT64), "; // fd2q"))
    } else if std.text.same(opcode, "leai") {
        emitLea(operands[0], operands[1], INT32)
    } else if std.text.same(opcode, "leap") {
        emitLea(operands[0], operands[1], INTPTR)
    } else if std.text.same(opcode, "memfence") {
        // Nothing.
    } else if std.text.same(opcode, "push") {
        var index: usize = 0
        while index < count {
            putc(u.cat3("PUSH(", clDump(operands[index]), ");"))
            index += 1
        }
    } else if std.text.same(opcode, "pop") {
        var index: usize = 0
        while index < count {
            putc(u.cat3("POP(", clDump(operands[index]), ");"))
            index += 1
        }
    } else if std.text.same(opcode, "cloopCrash") {
        putc("CRASH();")
    } else if std.text.same(opcode, "cloopCallJSFunction") {
        uidCount += 1
        const uid = s.decimal(uidCount)
        putc(u.cat3("lr = getOpcode(llint_cloop_did_return_from_js_", uid, ");"))
        putc(u.cat3("opcode = ", clValue(operands[0], OPCODE), ";"))
        putc("DISPATCH_OPCODE();")
        putsLabel(u.cat("llint_cloop_did_return_from_js_", uid), false, false, false, "")
    } else if std.text.same(opcode, "cloopCallNative") {
        putc("cloopStack.setCurrentStackPointer(sp.vp());")
        putc(u.cat3("nativeFunc = ", clValue(operands[0], NATIVE_FUNC), ";"))
        putc("functionReturnValue = JSValue::decode(nativeFunc(uncheckedDowncast<JSGlobalObject>(t0.cell()), t1.callFrame()));")
        putc("#if USE(JSVALUE32_64)")
        putc("    t1 = functionReturnValue.tag();")
        putc("    t0 = functionReturnValue.payload();")
        putc("#else // USE_JSVALUE64)")
        putc("    t0 = JSValue::encode(functionReturnValue);")
        putc("#endif // USE_JSVALUE64)")
    } else if std.text.same(opcode, "cloopCallSlowPath") {
        putc("{")
        putc("    cloopStack.setCurrentStackPointer(sp.vp());")
        putc(u.cat5("    UGPRPair result = ", cLabel(operands[0]), "(", clDump(operands[1]), u.cat3(", ", clDump(operands[2]), ");")))
        putc("    decodeResult(result, t0, t1);")
        putc("}")
    } else if std.text.same(opcode, "cloopCallSlowPathVoid") {
        putc("cloopStack.setCurrentStackPointer(sp.vp());")
        putc(u.cat5(cLabel(operands[0]), "(", clDump(operands[1]), ", ", u.cat(clDump(operands[2]), ");")))
    } else if std.text.same(opcode, "cloopCallSlowPath3") {
        putc("{")
        putc("    cloopStack.setCurrentStackPointer(sp.vp());")
        putc(u.cat5("    UGPRPair result = ", cLabel(operands[0]), "(", clDump(operands[1]), u.cat5(", ", clDump(operands[2]), ", ", clDump(operands[3]), ");")))
        putc("    decodeResult(result, t0, t1);")
        putc("}")
    } else if std.text.same(opcode, "cloopCallSlowPath4") {
        putc("{")
        putc("    cloopStack.setCurrentStackPointer(sp.vp());")
        putc(u.cat5("    UGPRPair result = ", cLabel(operands[0]), "(", clDump(operands[1]), u.cat5(", ", clDump(operands[2]), ", ", clDump(operands[3]), u.cat3(", ", clDump(operands[4]), ");"))))
        putc("    decodeResult(result, t0, t1);")
        putc("}")
    } else if std.text.same(opcode, "cloopDo") {
        putc(if node.*.hasText { node.*.text } else { "" })
    } else {
        lowerDefault(node)
    }
}

// Instruction#lowerDefault: annotations, emit, and the pointer tagging
// the C_LOOP has none of.
fn lowerDefault(node: *Node) -> void {
    const opcode = node.*.name
    if std.text.same(opcode, "localAnnotation") {
        // Instruction annotations are off: nothing.
    } else if std.text.same(opcode, "globalAnnotation") {
        putsNewlineSpacerIfAppropriate(SPACER_ANNOTATION)
    } else if std.text.same(opcode, "emit") {
        var text = u.bufNew(64)
        var index: usize = 0
        while index < node.*.count {
            const operand = node.*.items[index]
            if operand.*.kind == ast.LOCAL_LABEL_REFERENCE {
                u.bufAdd(&text, u.cat3("\" LOCAL_LABEL_STRING(", ast.localLabelString(operand.*.a.?), ") \""))
            } else {
                u.bufAdd(&text, ast.dump(operand))
            }
            index += 1
        }
        line(formatDump(u.cat3("    \"", u.bufText(&text), " \\n\""), lastComment()))
    } else if std.text.same(opcode, "tagCodePtr") || std.text.same(opcode, "tagReturnAddress") || std.text.same(opcode, "untagReturnAddress") || std.text.same(opcode, "removeCodePtrTag") || std.text.same(opcode, "untagArrayPtr") || std.text.same(opcode, "removeArrayPtrTag") {
        // Nothing.
    } else {
        s.fail(u.cat3("offlineasm: Unhandled opcode ", opcode, u.cat(" at ", ast.originString(node.*.origin))))
    }
}
