// What the parts of webkit-offlineasm share beyond support.mlx: text
// built up in growable buffers, maps keyed by text, integers of 128 bits
// written out as Ruby writes them, SHA-1 digests in hexadecimal, files
// tested, listed and renamed.
const std = @import("std")
const sha1 = @import("std.sha1")
const s = @import("../support.mlx")

const SYS_read: usize = 0
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_lseek: usize = 8
const SYS_rename: usize = 82
const SYS_getdents64: usize = 217
const O_RDONLY: usize = 0
const O_DIRECTORY: usize = 65536

// ---------------------------------------------------------------------------
// Text.

pub fn cat(first: []const u8, second: []const u8) -> []const u8 { return s.join(first, second) }
pub fn cat3(a: []const u8, b: []const u8, c: []const u8) -> []const u8 { return cat(cat(a, b), c) }
pub fn cat4(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> []const u8 { return cat(cat(a, b), cat(c, d)) }
pub fn cat5(a: []const u8, b: []const u8, c: []const u8, d: []const u8, e: []const u8) -> []const u8 { return cat(cat4(a, b, c, d), e) }

pub fn copyBytes(to: usize, text: []const u8) -> void {
    if text.length == 0 { return }
    var target: [*]u8 = undefined
    unsafe { target = @ptrFromInt([*]u8, to) }
    std.mem.copy(target, text.pointer, text.length)
}

pub fn isAlnum(byte: u8) -> bool { return std.ascii.isAlphabetic(byte) || std.ascii.isDigit(byte) }

// A text that grows: bytes appended at its end.
pub const Buf = struct {
    base: usize
    length: usize
    capacity: usize
}

pub fn bufNew(capacity: usize) -> Buf {
    return Buf.{ .base = s.alloc(capacity), .length = 0, .capacity = capacity }
}

pub fn bufAdd(buffer: *Buf, text: []const u8) -> void {
    if buffer.*.length + text.length > buffer.*.capacity {
        var capacity = buffer.*.capacity * 2
        while capacity < buffer.*.length + text.length { capacity *= 2 }
        const base = s.alloc(capacity)
        copyBytes(base, s.bytes(buffer.*.base, buffer.*.length))
        buffer.*.base = base
        buffer.*.capacity = capacity
    }
    copyBytes(buffer.*.base + buffer.*.length, text)
    buffer.*.length += text.length
}

pub fn bufByte(buffer: *Buf, byte: u8) -> void {
    var one: [1]u8 = undefined
    one[0] = byte
    bufAdd(buffer, one[0..1])
}

pub fn bufText(buffer: *Buf) -> []const u8 { return s.bytes(buffer.*.base, buffer.*.length) }

// TEXT padded with spaces on its right to WIDTH (Ruby's "%-Ns").
pub fn padRight(text: []const u8, width: usize) -> []const u8 {
    if text.length >= width { return text }
    const at = s.alloc(width + 1)
    copyBytes(at, text)
    var index = text.length
    while index < width {
        s.put8(at + index, 32)
        index += 1
    }
    s.put8(at + width, 0)
    return s.bytes(at, width)
}

// Byte order of two texts (Ruby's String#<=>): -1, 0 or 1.
pub fn compare(first: []const u8, second: []const u8) -> i32 {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return if first[index] < second[index] { -1 } else { 1 } }
        index += 1
    }
    if first.length == second.length { return 0 }
    return if first.length < second.length { -1 } else { 1 }
}

// ---------------------------------------------------------------------------
// Integers of 128 bits (Ruby's are unbounded; offlineasm's stay well within).

pub fn decimal128(value: i128) -> []const u8 {
    var digits: [48]u8 = undefined
    var at: usize = 48
    const negative = value < 0
    // (An if-expression of 128 bits loses its upper half: statements.)
    var rest = @bitCast(u128, value)
    if negative { rest = @bitCast(u128, 0 - value) }
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + @intCast(u32, rest % 10))
        rest /= 10
        if rest == 0 { break }
    }
    if negative {
        at -= 1
        digits[at] = 45
    }
    return s.join(digits[at..48], "")
}

// VALUE (not negative) in lower-case hexadecimal, without a prefix.
pub fn hex128(value: i128) -> []const u8 {
    if value < 0 { s.fail("offlineasm: a negative number written in hexadecimal") }
    var digits: [40]u8 = undefined
    var at: usize = 40
    var rest = @bitCast(u128, value)
    while true {
        at -= 1
        const digit = @intCast(u8, @intCast(u32, rest % 16))
        digits[at] = if digit < 10 { 48 + digit } else { 87 + digit }
        rest /= 16
        if rest == 0 { break }
    }
    return s.join(digits[at..40], "")
}

// The value of decimal digits (Ruby's String#to_i on them).
pub fn parseDecimal(text: []const u8) -> i128 {
    var value: i128 = 0
    var index: usize = 0
    var negative = false
    if index < text.length && text[index] == 45 {
        negative = true
        index += 1
    }
    while index < text.length && std.ascii.isDigit(text[index]) {
        value = value * 10 + @intCast(i128, text[index] - 48)
        index += 1
    }
    if negative { return 0 - value }
    return value
}

// ---------------------------------------------------------------------------
// Maps keyed by text, to a word (0 for none).

pub const Map = struct {
    keys: [*][]const u8
    values: [*]usize
    hashes: [*]u64
    used: [*]bool
    capacity: usize
    count: usize
}

pub fn hashText(text: []const u8) -> u64 {
    var value: u64 = 14695981039346656037
    for byte in text {
        value = (value ^ @intCast(u64, byte)) *% 1099511628211
    }
    return value
}

pub fn mapNew(capacity: usize) -> *Map {
    var map: *Map = undefined
    unsafe {
        map = @ptrFromInt(*Map, s.alloc(@sizeOf(Map)))
        map.*.keys = @ptrFromInt([*][]const u8, s.alloc(capacity * @sizeOf([]const u8)))
        map.*.values = @ptrFromInt([*]usize, s.alloc(capacity * 8))
        map.*.hashes = @ptrFromInt([*]u64, s.alloc(capacity * 8))
        map.*.used = @ptrFromInt([*]bool, s.alloc(capacity))
    }
    map.*.capacity = capacity
    map.*.count = 0
    var index: usize = 0
    while index < capacity {
        map.*.used[index] = false
        index += 1
    }
    return map
}

fn slotOf(map: *Map, key: []const u8, hash: u64) -> usize {
    const mask = map.*.capacity - 1
    var slot = @intCast(usize, hash & @intCast(u64, mask))
    while map.*.used[slot] {
        if map.*.hashes[slot] == hash && std.text.same(map.*.keys[slot], key) { return slot }
        slot = (slot + 1) & mask
    }
    return slot
}

pub fn mapFind(map: *Map, key: []const u8, hash: u64) -> usize {
    const slot = slotOf(map, key, hash)
    return if map.*.used[slot] { map.*.values[slot] } else { 0 }
}

pub fn mapHas(map: *Map, key: []const u8, hash: u64) -> bool {
    return map.*.used[slotOf(map, key, hash)]
}

pub fn mapGet(map: *Map, key: []const u8) -> usize { return mapFind(map, key, hashText(key)) }

pub fn mapSet(map: *Map, key: []const u8, hash: u64, value: usize) -> void {
    if (map.*.count + 1) * 2 > map.*.capacity {
        const old = map.*
        const bigger = mapNew(old.capacity * 2)
        var index: usize = 0
        while index < old.capacity {
            if old.used[index] {
                const slot = slotOf(bigger, old.keys[index], old.hashes[index])
                bigger.*.used[slot] = true
                bigger.*.keys[slot] = old.keys[index]
                bigger.*.hashes[slot] = old.hashes[index]
                bigger.*.values[slot] = old.values[index]
                bigger.*.count += 1
            }
            index += 1
        }
        map.* = bigger.*
    }
    const slot = slotOf(map, key, hash)
    if !map.*.used[slot] {
        map.*.used[slot] = true
        map.*.keys[slot] = key
        map.*.hashes[slot] = hash
        map.*.count += 1
    }
    map.*.values[slot] = value
}

pub fn mapPut(map: *Map, key: []const u8, value: usize) -> void { mapSet(map, key, hashText(key), value) }

// ---------------------------------------------------------------------------
// Scopes: maps that copy another (a Ruby Hash#dup), sharing it instead,
// the entries set on the copy kept apart and found first. A scope may
// also hide keys of the one it copies.

pub const Scope = struct {
    parent: ?*Scope
    map: ?*Map
    hidden: [*][]const u8
    hiddenCount: usize
}

pub fn scopeNew(parent: ?*Scope) -> *Scope {
    var scope: *Scope = undefined
    unsafe { scope = @ptrFromInt(*Scope, s.alloc(@sizeOf(Scope))) }
    scope.*.parent = parent
    scope.*.map = null
    scope.*.hiddenCount = 0
    return scope
}

pub fn scopeSet(scope: *Scope, key: []const u8, value: usize) -> void {
    if scope.*.map == null { scope.*.map = mapNew(8) }
    mapPut(scope.*.map.?, key, value)
}

// KEY's value in SCOPE or in the scopes it copies (0 for none).
pub fn scopeGet(start: ?*Scope, key: []const u8) -> usize {
    const hash = hashText(key)
    var scope = start
    while scope != null {
        const here = scope.?
        if here.*.map != null {
            const map = here.*.map.?
            const slot = slotOf(map, key, hash)
            if map.*.used[slot] { return map.*.values[slot] }
        }
        var index: usize = 0
        while index < here.*.hiddenCount {
            if std.text.same(here.*.hidden[index], key) { return 0 }
            index += 1
        }
        scope = here.*.parent
    }
    return 0
}

// ---------------------------------------------------------------------------
// Digests.

pub fn sha1Hex(text: []const u8) -> []const u8 {
    var digest: [20]u8 = undefined
    sha1.sha1(text, &digest)
    var out: [40]u8 = undefined
    var index: usize = 0
    while index < 20 {
        const high = digest[index] >> 4
        const low = digest[index] & 15
        out[2 * index] = if high < 10 { 48 + high } else { 87 + high }
        out[2 * index + 1] = if low < 10 { 48 + low } else { 87 + low }
        index += 1
    }
    return s.join(out[0..40], "")
}

// ---------------------------------------------------------------------------
// Files.

// The whole of the file PATH, in memory of its size (support's readWhole
// sets aside more, and the many files read here would add up).
pub fn readFile(path: []const u8) -> []const u8 {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 { s.fail(cat("cannot read ", path)) }
    const file = @bitCast(usize, descriptor)
    const size = std.linux.syscall3(SYS_lseek, file, 0, 2)
    if size < 0 { s.fail(cat("cannot read ", path)) }
    const rewound = std.linux.syscall3(SYS_lseek, file, 0, 0)
    const capacity = @intCast(usize, size)
    const data = s.alloc(capacity + 1)
    var length: usize = 0
    while length < capacity {
        const count = std.linux.syscall3(SYS_read, file, data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, file)
    s.put8(data + length, 0)
    return s.bytes(data, length)
}

pub fn exists(path: []const u8) -> bool {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 { return false }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return true
}

// Whether PATH is a file one can read that is not a directory.
pub fn isFile(path: []const u8) -> bool {
    if !exists(path) { return false }
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY | O_DIRECTORY, 0)
    if descriptor < 0 { return true }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return false
}

// The names in DIRECTORY, in the order the system lists them (as Ruby's
// Dir.foreach has them), "." and ".." among them; one after another,
// each ended by a zero byte.
pub fn listDirectory(directory: []const u8) -> []const u8 {
    const name = s.join(directory, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY | O_DIRECTORY, 0)
    if descriptor < 0 { s.fail(cat("cannot list ", directory)) }
    var names = bufNew(4096)
    const capacity: usize = 65536
    const buffer = s.alloc(capacity)
    while true {
        const count = std.linux.syscall3(SYS_getdents64, @bitCast(usize, descriptor), buffer, capacity)
        if count <= 0 { break }
        var at: usize = 0
        const total = @intCast(usize, count)
        while at < total {
            const record = s.bytes(buffer + at, 20)
            const length = @intCast(usize, record[16]) | (@intCast(usize, record[17]) << 8)
            var view: [*]const u8 = undefined
            unsafe { view = @ptrFromInt([*]const u8, buffer + at + 19) }
            bufAdd(&names, std.text.cString(view))
            bufByte(&names, 0)
            at += length
        }
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return bufText(&names)
}

pub fn rename(from: []const u8, to: []const u8) -> void {
    const source = s.join(from, "")
    const target = s.join(to, "")
    const result = std.linux.syscall2(SYS_rename, @intFromPtr(source.pointer), @intFromPtr(target.pointer))
    if result < 0 { s.fail(cat("cannot rename ", from)) }
}

// Ruby's File.dirname.
pub fn dirName(path: []const u8) -> []const u8 {
    var end = path.length
    while end > 1 && path[end - 1] == 47 { end -= 1 }
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    if end == 0 { return "." }
    while end > 1 && path[end - 1] == 47 { end -= 1 }
    return path[0..end]
}

// Ruby's File.join of two parts.
pub fn joinPath(directory: []const u8, name: []const u8) -> []const u8 {
    if directory.length > 0 && directory[directory.length - 1] == 47 { return cat(directory, name) }
    return cat3(directory, "/", name)
}
