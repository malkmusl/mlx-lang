const s = @import("../support.mlx")

fn hex(v: i128) -> []const u8 {
    var digits: [40]u8 = undefined
    var at: usize = 40
    var rest = @bitCast(u128, v)
    while true {
        at -= 1
        const d = @intCast(u8, rest % 16)
        digits[at] = if d < 10 { 48 + d } else { 87 + d }
        rest /= 16
        if rest == 0 { break }
    }
    return s.join(digits[at..40], "")
}

noinline fn big(a: u64) -> i128 { return @intCast(i128, a) }
noinline fn mul(a: i128, b: i128) -> i128 { return a * b }

pub fn main(arguments: [][*]const u8) -> u8 {
    var v: i128 = 18446744073709551615
    s.out(hex(v))
    s.out(" ")
    var w: u64 = 18446744073709551615
    s.out(hex(big(w)))
    s.out(" ")
    var x: i128 = 1
    x = x << 70
    s.out(hex(x))
    s.out(" ")
    s.out(hex(mul(x, 3)))
    s.out(" ")
    s.out(hex(-x))
    s.out(" ")
    s.out(hex(mul(-5, 7)))
    s.out("\n")
    s.say(s.output())
    return 0
}
