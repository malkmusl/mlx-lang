// The tree offlineasm works on (its ast.rb): one node structure for
// every kind of node, what each kind keeps in which field said at its
// kind; the nodes Ruby keeps one of per name (variables, registers,
// labels, settings, structure offsets, sizes, constant expressions)
// found again by name; the source files and the places in them.
const s = @import("../support.mlx")
const u = @import("./util.mlx")

// Kinds, with the fields each uses (a, b, c, d: nodes; items: a list).
pub const STRUCT_OFFSET: u8 = 1      // name: the structure, text: the field
pub const SIZEOF: u8 = 2             // name: the structure
pub const IMMEDIATE: u8 = 3          // value
pub const ADD: u8 = 4                // a + b
pub const SUB: u8 = 5                // a - b
pub const MUL: u8 = 6                // a * b
pub const NEG: u8 = 7                // -a
pub const OR: u8 = 8                 // a | b
pub const AND: u8 = 9                // a & b
pub const XOR: u8 = 10               // a ^ b
pub const BITNOT: u8 = 11            // ~a
pub const STRING: u8 = 12            // name: the text between the quotes
pub const REGISTER: u8 = 13          // name
pub const FP_REGISTER: u8 = 14       // name
pub const VEC_REGISTER: u8 = 15      // name
pub const VARIABLE: u8 = 17          // name, text: the name it had in its macro
pub const ADDRESS: u8 = 18           // a: base, b: offset
pub const BASE_INDEX: u8 = 19        // a: base, b: index, c: scale, d: offset
pub const ABSOLUTE_ADDRESS: u8 = 20  // a: the address
pub const INSTRUCTION: u8 = 21       // name: opcode, items: operands, text: annotation (hasText)
pub const ERROR: u8 = 22
pub const CONST_EXPR: u8 = 23        // name: the C++ text
pub const CONST_DECL: u8 = 24        // a: variable, b: value
pub const LABEL: u8 = 25             // name, a: what it is aligned to (or none), the label flags
pub const LOCAL_LABEL: u8 = 26       // name
pub const LABEL_REFERENCE: u8 = 27   // a: the label, value: an offset
pub const LOCAL_LABEL_REFERENCE: u8 = 28 // a: the local label
pub const SEQUENCE: u8 = 29          // items
pub const TRUE: u8 = 30
pub const FALSE: u8 = 31
pub const SETTING: u8 = 32           // name
pub const PRED_AND: u8 = 33          // a and b
pub const PRED_OR: u8 = 34           // a or b
pub const PRED_NOT: u8 = 35          // not a
pub const SKIP: u8 = 36
pub const IF_THEN_ELSE: u8 = 37      // a: predicate, b: then, c: else
pub const MACRO: u8 = 38             // name ("" for a macro passed as an argument), items: variables, a: body
pub const MACRO_CALL: u8 = 39        // name, items: operands, text: annotation (hasText), original: the name called

pub const Node = struct {
    kind: u8
    origin: u64
    name: []const u8
    text: []const u8
    hasText: bool
    original: []const u8
    value: i128
    // For structure offsets, sizes and constant expressions: whether value
    // holds what the offsets extractor found for them.
    resolved: bool
    a: ?*Node
    b: ?*Node
    c: ?*Node
    d: ?*Node
    items: [*]*Node
    count: usize
    // Labels.
    isGlobal: bool
    isExport: bool
    isAligned: bool
    isExtern: bool
    definedInFile: bool
    // A mark for the passes that visit each node once.
    stamp: u64
}

// ---------------------------------------------------------------------------
// Lists of nodes.

pub fn nodeArray(count: usize) -> [*]*Node {
    unsafe { return @ptrFromInt([*]*Node, s.alloc((count + 1) * 8)) }
}

pub const List = struct {
    items: [*]*Node
    count: usize
    capacity: usize
}

pub fn listNew(capacity: usize) -> List {
    return List.{ .items = nodeArray(capacity), .count = 0, .capacity = capacity }
}

pub fn listAdd(list: *List, node: *Node) -> void {
    if list.*.count == list.*.capacity {
        const capacity = list.*.capacity * 2 + 4
        const items = nodeArray(capacity)
        var index: usize = 0
        while index < list.*.count {
            items[index] = list.*.items[index]
            index += 1
        }
        list.*.items = items
        list.*.capacity = capacity
    }
    list.*.items[list.*.count] = node
    list.*.count += 1
}

// ---------------------------------------------------------------------------
// Source files and places in them: an origin is the file's number (from
// 1) above 32 bits and the line below; 0 is none.

var fileNames: [*][]const u8 = undefined
var fileBases: [*][]const u8 = undefined
var fileCount: usize = 0

pub fn sourceFile(path: []const u8) -> u64 {
    if fileCount == 0 {
        unsafe {
            fileNames = @ptrFromInt([*][]const u8, s.alloc(1024 * @sizeOf([]const u8)))
            fileBases = @ptrFromInt([*][]const u8, s.alloc(1024 * @sizeOf([]const u8)))
        }
    }
    if fileCount == 1023 { s.fail("offlineasm: too many source files") }
    fileCount += 1
    fileNames[fileCount] = path
    fileBases[fileCount] = s.baseName(path)
    return @intCast(u64, fileCount)
}

pub fn originOf(file: u64, line: usize) -> u64 { return (file << 32) | @intCast(u64, line) }
pub fn originLine(origin: u64) -> u64 { return origin & 4294967295 }

// "LowLevelInterpreter.asm:138" (CodeOrigin#to_s).
pub fn originString(origin: u64) -> []const u8 {
    if origin == 0 { return "" }
    return u.cat3(fileBases[@intCast(usize, origin >> 32)], ":", s.decimal(originLine(origin)))
}

// "LowLevelInterpreter_asm_138": the base name with its first dot made
// an underscore, and the line.
pub fn labelStringExtension(origin: u64) -> []const u8 {
    const base = fileBases[@intCast(usize, origin >> 32)]
    const dot = s.find(base, ".")
    const name = if dot < base.length { u.cat3(base[0..dot], "_", base[dot + 1..base.length]) } else { base }
    return u.cat3(name, "_", s.decimal(originLine(origin)))
}

// ---------------------------------------------------------------------------
// Nodes.

pub fn newNode(kind: u8, origin: u64) -> *Node {
    var node: *Node = undefined
    unsafe { node = @ptrFromInt(*Node, s.alloc(@sizeOf(Node))) }
    node.*.kind = kind
    node.*.origin = origin
    node.*.name = ""
    node.*.text = ""
    node.*.hasText = false
    node.*.original = ""
    node.*.value = 0
    node.*.resolved = false
    node.*.a = null
    node.*.b = null
    node.*.c = null
    node.*.d = null
    node.*.items = nodeArray(0)
    node.*.count = 0
    node.*.isGlobal = false
    node.*.isExport = false
    node.*.isAligned = true
    node.*.isExtern = true
    node.*.definedInFile = false
    node.*.stamp = 0
    return node
}

pub fn copyNode(node: *Node) -> *Node {
    const copy = newNode(node.*.kind, node.*.origin)
    copy.* = node.*
    return copy
}

pub fn nodeAt(word: usize) -> ?*Node {
    if word == 0 { return null }
    unsafe { return @ptrFromInt(*Node, word) }
}

pub fn wordOf(node: *Node) -> usize { return @intFromPtr(node) }

pub fn immediate(origin: u64, value: i128) -> *Node {
    const node = newNode(IMMEDIATE, origin)
    node.*.value = value
    return node
}

pub fn binary(kind: u8, origin: u64, left: *Node, right: *Node) -> *Node {
    const node = newNode(kind, origin)
    node.*.a = left
    node.*.b = right
    return node
}

pub fn unary(kind: u8, origin: u64, child: *Node) -> *Node {
    const node = newNode(kind, origin)
    node.*.a = child
    return node
}

pub fn withItems(kind: u8, origin: u64, items: [*]*Node, count: usize) -> *Node {
    const node = newNode(kind, origin)
    node.*.items = items
    node.*.count = count
    return node
}

pub fn instruction(origin: u64, opcode: []const u8, operands: [*]*Node, count: usize, annotation: []const u8, hasAnnotation: bool) -> *Node {
    const node = withItems(INSTRUCTION, origin, operands, count)
    node.*.name = opcode
    node.*.text = annotation
    node.*.hasText = hasAnnotation
    return node
}

pub fn labelReference(origin: u64, label: *Node) -> *Node {
    const node = newNode(LABEL_REFERENCE, origin)
    node.*.a = label
    return node
}

pub fn localLabelReference(origin: u64, label: *Node) -> *Node {
    const node = newNode(LOCAL_LABEL_REFERENCE, origin)
    node.*.a = if label.*.kind == LOCAL_LABEL_REFERENCE { label.*.a.? } else { label }
    return node
}

pub fn ifThenElse(origin: u64, predicate: *Node, thenCase: *Node) -> *Node {
    const node = newNode(IF_THEN_ELSE, origin)
    node.*.a = predicate
    node.*.b = thenCase
    node.*.c = newNode(SKIP, origin)
    return node
}

pub fn isRegisterKind(kind: u8) -> bool { return kind == REGISTER || kind == FP_REGISTER || kind == VEC_REGISTER }

// Node#immediate? (for the kinds that have it).
pub fn isImmediate(node: *Node) -> bool {
    const kind = node.*.kind
    return kind == STRUCT_OFFSET || kind == SIZEOF || (kind >= IMMEDIATE && kind <= BITNOT) || kind == CONST_EXPR
}

// ---------------------------------------------------------------------------
// The nodes there is one of per name.

var variables: *u.Map = undefined
var registers: *u.Map = undefined
var structOffsets: *u.Map = undefined
var sizeofs: *u.Map = undefined
var constExprs: *u.Map = undefined
var settings: *u.Map = undefined
// $labelMapping: the labels and local labels by name.
var labels: *u.Map = undefined
pub var trueNode: *Node = undefined
pub var falseNode: *Node = undefined
var uniqueNameCounter: u64 = 0

pub fn initialize() -> void {
    variables = u.mapNew(4096)
    registers = u.mapNew(256)
    structOffsets = u.mapNew(4096)
    sizeofs = u.mapNew(1024)
    constExprs = u.mapNew(4096)
    settings = u.mapNew(256)
    labels = u.mapNew(65536)
    trueNode = newNode(TRUE, 0)
    falseNode = newNode(FALSE, 0)
}

pub fn boolNode(value: bool) -> *Node { return if value { trueNode } else { falseNode } }

pub fn variableFor(origin: u64, name: []const u8, original: []const u8) -> *Node {
    const found = nodeAt(u.mapGet(variables, name))
    if found != null { return found.? }
    const node = newNode(VARIABLE, origin)
    node.*.name = name
    node.*.text = if original.length > 0 { original } else { name }
    u.mapPut(variables, name, wordOf(node))
    return node
}

pub fn registerFor(kind: u8, origin: u64, name: []const u8) -> *Node {
    const key = u.cat(if kind == REGISTER { "r" } else if kind == FP_REGISTER { "f" } else { "v" }, name)
    const found = nodeAt(u.mapGet(registers, key))
    if found != null { return found.? }
    const node = newNode(kind, origin)
    node.*.name = name
    u.mapPut(registers, key, wordOf(node))
    return node
}

pub fn structOffsetFor(origin: u64, structName: []const u8, field: []const u8) -> *Node {
    const key = u.cat3(structName, "\x01", field)
    const found = nodeAt(u.mapGet(structOffsets, key))
    if found != null { return found.? }
    const node = newNode(STRUCT_OFFSET, origin)
    node.*.name = structName
    node.*.text = field
    u.mapPut(structOffsets, key, wordOf(node))
    return node
}

// "STRUCT::FIELD" (StructOffset#dump).
pub fn structOffsetDump(node: *Node) -> []const u8 { return u.cat3(node.*.name, "::", node.*.text) }

// A structure offset of "A::B::FIELD": the structure is all before the
// last "::".
pub fn structOffsetOfDump(origin: u64, dump: []const u8) -> *Node {
    var last = dump.length
    var at: usize = 0
    while at + 1 < dump.length {
        if dump[at] == 58 && dump[at + 1] == 58 { last = at }
        at += 1
    }
    if last == dump.length { return structOffsetFor(origin, "", dump) }
    return structOffsetFor(origin, dump[0..last], dump[last + 2..dump.length])
}

pub fn sizeofFor(origin: u64, structName: []const u8) -> *Node {
    const found = nodeAt(u.mapGet(sizeofs, structName))
    if found != null { return found.? }
    const node = newNode(SIZEOF, origin)
    node.*.name = structName
    u.mapPut(sizeofs, structName, wordOf(node))
    return node
}

pub fn constExprFor(origin: u64, text: []const u8) -> *Node {
    const found = nodeAt(u.mapGet(constExprs, text))
    if found != null { return found.? }
    const node = newNode(CONST_EXPR, origin)
    node.*.name = text
    u.mapPut(constExprs, text, wordOf(node))
    return node
}

pub fn settingFor(origin: u64, name: []const u8) -> *Node {
    const found = nodeAt(u.mapGet(settings, name))
    if found != null { return found.? }
    const node = newNode(SETTING, origin)
    node.*.name = name
    u.mapPut(settings, name, wordOf(node))
    return node
}

pub fn labelNamed(name: []const u8) -> ?*Node { return nodeAt(u.mapGet(labels, name)) }

// Label.forName.
pub fn labelFor(origin: u64, name: []const u8, definedInFile: bool) -> *Node {
    var label = labelNamed(name)
    if label != null {
        if label.?.*.kind != LABEL { s.fail(u.cat("offlineasm: Label name collision: ", name)) }
    } else {
        const node = newNode(LABEL, origin)
        node.*.name = name
        node.*.definedInFile = definedInFile
        u.mapPut(labels, name, wordOf(node))
        label = node
    }
    if definedInFile { label.?.*.isExtern = false }
    return label.?
}

// The label NAME declared at ORIGIN (global, aligned...): the one there
// is, or a new one.
fn declaredLabel(origin: u64, name: []const u8) -> *Node {
    const label = labelNamed(name)
    if label != null { return label.? }
    const node = newNode(LABEL, origin)
    node.*.name = name
    u.mapPut(labels, name, wordOf(node))
    return node
}

pub fn setAsGlobal(origin: u64, name: []const u8) -> void {
    const label = declaredLabel(origin, name)
    if label.*.isGlobal { s.fail(u.cat3("offlineasm: Label: ", name, " declared global multiple times")) }
    label.*.isGlobal = true
}

pub fn setAsGlobalExport(origin: u64, name: []const u8) -> void {
    const label = declaredLabel(origin, name)
    if label.*.isGlobal { s.fail(u.cat3("offlineasm: Label: ", name, " declared global multiple times")) }
    label.*.isGlobal = true
    label.*.isExport = true
}

pub fn setAsUnalignedGlobal(origin: u64, name: []const u8) -> void {
    const label = declaredLabel(origin, name)
    if label.*.isGlobal { s.fail(u.cat3("offlineasm: Label: ", name, " declared global multiple times")) }
    label.*.isGlobal = true
    label.*.isAligned = false
}

pub fn setAsUnalignedGlobalExport(origin: u64, name: []const u8) -> void {
    const label = declaredLabel(origin, name)
    if label.*.isGlobal { s.fail(u.cat3("offlineasm: Label: ", name, " declared global multiple times")) }
    label.*.isGlobal = true
    label.*.isAligned = false
    label.*.isExport = true
}

pub fn setAligned(label: *Node, alignTo: *Node) -> void {
    label.*.isAligned = true
    label.*.a = alignTo
    label.*.isGlobal = true
}

pub fn setAsAligned(origin: u64, name: []const u8, alignTo: *Node) -> void {
    // Ruby asks aligned? of a label there already is, which it is unless
    // declared otherwise.
    const existing = labelNamed(name)
    if existing != null && existing.?.*.isAligned { s.fail(u.cat3("offlineasm: Label: ", name, " declared aligned multiple times")) }
    setAligned(declaredLabel(origin, name), alignTo)
}

pub fn localLabelFor(origin: u64, name: []const u8) -> *Node {
    const label = labelNamed(name)
    if label != null {
        if label.?.*.kind != LOCAL_LABEL { s.fail(u.cat("offlineasm: Label name collision: ", name)) }
        return label.?
    }
    const node = newNode(LOCAL_LABEL, origin)
    node.*.name = name
    u.mapPut(labels, name, wordOf(node))
    return node
}

// LocalLabel.unique: "_COMMENT", or "_N_COMMENT" with the first N free.
pub fn uniqueLocalLabel(origin: u64, comment: []const u8) -> *Node {
    var name = u.cat("_", comment)
    if labelNamed(name) != null {
        while true {
            name = u.cat4("_", s.decimal(uniqueNameCounter), "_", comment)
            if labelNamed(name) == null { break }
            uniqueNameCounter += 1
        }
    }
    return localLabelFor(origin, name)
}

// The C name of a local label (LocalLabel#labelString).
pub fn localLabelString(label: *Node) -> []const u8 {
    return u.cat4("jsc_llint_", label.*.name[1..label.*.name.length], "_", labelStringExtension(label.*.origin))
}

// ---------------------------------------------------------------------------
// Children, as Node#children has them.

pub fn childCount(node: *Node) -> usize {
    const kind = node.*.kind
    if kind == ADD || kind == SUB || kind == MUL || kind == OR || kind == AND || kind == XOR { return 2 }
    if kind == NEG || kind == BITNOT { return 1 }
    if kind == ADDRESS { return 2 }
    if kind == BASE_INDEX { return 3 }
    if kind == INSTRUCTION || kind == SEQUENCE || kind == MACRO_CALL { return node.*.count }
    if kind == CONST_DECL { return 2 }
    if kind == LABEL { return if node.*.isAligned && node.*.a != null { 1 } else { 0 } }
    if kind == LABEL_REFERENCE || kind == LOCAL_LABEL_REFERENCE { return 1 }
    if kind == PRED_AND || kind == PRED_OR { return 2 }
    if kind == PRED_NOT { return 1 }
    if kind == IF_THEN_ELSE { return 3 }
    if kind == MACRO { return node.*.count + 1 }
    return 0
}

pub fn childAt(node: *Node, index: usize) -> *Node {
    const kind = node.*.kind
    if kind == INSTRUCTION || kind == SEQUENCE || kind == MACRO_CALL { return node.*.items[index] }
    if kind == MACRO { return if index < node.*.count { node.*.items[index] } else { node.*.a.? } }
    if kind == BASE_INDEX { return if index == 0 { node.*.a.? } else if index == 1 { node.*.b.? } else { node.*.d.? } }
    if index == 0 { return node.*.a.? }
    if index == 1 { return node.*.b.? }
    return node.*.c.?
}

var stampNow: u64 = 0

fn collect(node: *Node, kind: u8, list: *List) -> void {
    if node.*.kind == kind && node.*.stamp != stampNow {
        node.*.stamp = stampNow
        listAdd(list, node)
    }
    const count = childCount(node)
    var index: usize = 0
    while index < count {
        collect(childAt(node, index), kind, list)
        index += 1
    }
}

// node.filter(KIND).uniq: the nodes of KIND in the tree, in the order of
// Node#flatten, each once.
pub fn filterUnique(node: *Node, kind: u8) -> List {
    stampNow += 1
    var list = listNew(64)
    collect(node, kind, &list)
    return list
}

// ---------------------------------------------------------------------------
// Dumps (Node#dump), for the kinds a name can be made of.

pub fn dump(node: *Node) -> []const u8 {
    const kind = node.*.kind
    if kind == IMMEDIATE { return u.decimal128(node.*.value) }
    if kind == VARIABLE { return node.*.text }
    if isRegisterKind(kind) || kind == STRING { return node.*.name }
    if kind == STRUCT_OFFSET { return structOffsetDump(node) }
    if kind == SIZEOF { return u.cat("sizeof ", node.*.name) }
    if kind == LABEL_REFERENCE || kind == LOCAL_LABEL_REFERENCE { return node.*.a.?.*.name }
    if kind == ADD { return u.cat5("(", dump(node.*.a.?), " + ", dump(node.*.b.?), ")") }
    if kind == SUB { return u.cat5("(", dump(node.*.a.?), " - ", dump(node.*.b.?), ")") }
    if kind == MUL { return u.cat5("(", dump(node.*.a.?), " * ", dump(node.*.b.?), ")") }
    if kind == OR { return u.cat5("(", dump(node.*.a.?), " | ", dump(node.*.b.?), ")") }
    if kind == AND { return u.cat5("(", dump(node.*.a.?), " & ", dump(node.*.b.?), ")") }
    if kind == XOR { return u.cat5("(", dump(node.*.a.?), " ^ ", dump(node.*.b.?), ")") }
    if kind == NEG { return u.cat3("(-", dump(node.*.a.?), ")") }
    if kind == BITNOT { return u.cat3("(~", dump(node.*.a.?), ")") }
    if kind == ADDRESS { return u.cat4(dump(node.*.b.?), "[", dump(node.*.a.?), "]") }
    if kind == ABSOLUTE_ADDRESS { return u.cat(dump(node.*.a.?), "[]") }
    s.fail(u.cat("offlineasm: cannot dump a node of kind ", s.decimal(@intCast(u64, kind))))
    return ""
}

// The name of a node (what Ruby's #name gives), for "%NAME%" made of it.
pub fn nameOf(node: *Node) -> []const u8 {
    const kind = node.*.kind
    if kind == IMMEDIATE { return u.cat("0x", u.hex128(node.*.value)) }
    if kind == LABEL_REFERENCE || kind == LOCAL_LABEL_REFERENCE { return node.*.a.?.*.name }
    if kind == VARIABLE || isRegisterKind(kind) || kind == LABEL || kind == LOCAL_LABEL || kind == SETTING || kind == MACRO || kind == MACRO_CALL { return node.*.name }
    s.fail(u.cat("offlineasm: no name for a node of kind ", s.decimal(@intCast(u64, kind))))
    return ""
}
