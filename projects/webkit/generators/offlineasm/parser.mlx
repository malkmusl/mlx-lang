// offlineasm's lexer and parser (its parser.rb): the text of an .asm file
// made tokens, the tokens a tree of ast.mlx nodes, the files it includes
// read and parsed in their place; and parseHash, the digest of a file and
// of all it includes, as they are on disk.
const s = @import("../support.mlx")
const u = @import("./util.mlx")
const ast = @import("./ast.mlx")

const Node = ast.Node

const TOKEN: u8 = 0
const ANNOTATION: u8 = 1
const END: u8 = 2

const Token = struct {
    kind: u8
    text: []const u8
    origin: u64
    // For an annotation: whether whitespace came before it on its line.
    local: bool
}

// What ends a sequence: nothing but the end of the file, "else", "end"
// or "elsif", or "end".
const FINAL_NONE: u8 = 0
const FINAL_ELSE_END: u8 = 1
const FINAL_END: u8 = 2

const Parser = struct {
    tokens: [*]Token
    count: usize
    index: usize
    annotation: []const u8
    hasAnnotation: bool
    fileName: []const u8
}

var instructionSet: *u.Map = undefined
var gprs: *u.Map = undefined
var fprs: *u.Map = undefined
var vecs: *u.Map = undefined
var keywords: *u.Map = undefined

// The -I directories, each with a slash after it as Ruby adds one.
var includeDirs: [*][]const u8 = undefined
var includeDirCount: usize = 0
// --webkit-additions-path (none when its length is 0).
var additionsPointer: [*]const u8 = undefined
var additionsLength: usize = 0

pub fn setAdditionsPath(path: []const u8) -> void {
    additionsPointer = path.pointer
    additionsLength = path.length
}

// The files parse() read (for a depfile), one after another, each ended
// by a zero byte.
pub var sources: u.Buf = undefined

fn addWords(map: *u.Map, words: []const u8) -> void {
    var at: usize = 0
    while at < words.length {
        while at < words.length && words[at] == 32 { at += 1 }
        const start = at
        while at < words.length && words[at] != 32 { at += 1 }
        if at > start { u.mapPut(map, words[start..at], 1) }
    }
}

pub fn initialize() -> void {
    unsafe { includeDirs = @ptrFromInt([*][]const u8, s.alloc(64 * @sizeOf([]const u8))) }
    sources = u.bufNew(4096)
    gprs = u.mapNew(64)
    addWords(gprs, "t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 cfr sp lr pc zr csr0 csr1 csr2 csr3 csr4 csr5 csr6 csr7 csr8 csr9 csr10 invalidGPR")
    fprs = u.mapNew(64)
    addWords(fprs, "ft0 ft1 ft2 ft3 ft4 ft5 ft6 ft7 csfr0 csfr1 csfr2 csfr3 csfr4 csfr5 csfr6 csfr7 csfr8 csfr9 csfr10 csfr11")
    vecs = u.mapNew(128)
    addWords(vecs, "v0 v0_b v0_h v0_i v0_q v1 v1_b v1_h v1_i v1_q v2 v2_b v2_h v2_i v2_q v3 v3_b v3_h v3_i v3_q")
    addWords(vecs, "v4 v4_b v4_h v4_i v4_q v5 v5_b v5_h v5_i v5_q v6 v6_b v6_h v6_i v6_q v7 v7_b v7_h v7_i v7_q")
    keywords = u.mapNew(64)
    addWords(keywords, "true false if then else elsif end and or not global macro const constexpr sizeof error include")
    instructionSet = u.mapNew(1024)
    addWords(instructionSet, "emit addi andi andf andd lshifti lshiftp lshiftq muli negi negp negq noti ori")
    addWords(instructionSet, "orf ord orh rshifti urshifti rshiftp urshiftp rshiftq urshiftq lrotatei lrotateq rrotatei rrotateq subi")
    addWords(instructionSet, "xori load2ia loadi loadis loadb loadbsi loadbsq loadh loadhsi loadhsq store2ia storei storeh storeb")
    addWords(instructionSet, "transferi transferq transferp loadf loadd loadv moved storef stored storev addf addd divf divd")
    addWords(instructionSet, "subf subd mulf muld sqrtf sqrtd floorf floord roundf roundd truncatef truncated truncatef2i truncatef2q")
    addWords(instructionSet, "truncated2q truncated2i truncatef2is truncated2is truncatef2qs truncated2qs ci2d ci2ds ci2f ci2fs cq2f cq2fs cq2d cq2ds")
    addWords(instructionSet, "cd2f cf2d fii2d fd2ii fq2d fd2q bdeq bdneq bdgt bdgteq bdlt bdlteq bdequn bdnequn")
    addWords(instructionSet, "bdgtun bdgtequn bdltun bdltequn bfeq bfgt bflt bfgtun bfgtequn bfltun bfltequn btd2i td2i bcd2i")
    addWords(instructionSet, "movdz pop popv push pushv move sxi2q zxi2q sxb2i sxh2i sxb2q sxb2p sxh2q nop")
    addWords(instructionSet, "bieq bineq bia biaeq bib bibeq bigt bigteq bilt bilteq bbeq bbneq bba bbaeq")
    addWords(instructionSet, "bbb bbbeq bbgt bbgteq bblt bblteq btis btiz btinz btbs btbz btbnz jmp baddio")
    addWords(instructionSet, "baddis baddiz baddinz bsubio bsubis bsubiz bsubinz bmulio bmulis bmuliz bmulinz borio boris boriz")
    addWords(instructionSet, "borinz break call ret cbeq cbneq cba cbaeq cbb cbbeq cbgt cbgteq cblt cblteq")
    addWords(instructionSet, "cieq cineq cia ciaeq cib cibeq cigt cigteq cilt cilteq tis tiz tinz tbs")
    addWords(instructionSet, "tbz tbnz tps tpz tpnz peek poke bpeq bpneq bpa bpaeq bpb bpbeq bpgt")
    addWords(instructionSet, "bpgteq bplt bplteq addp mulp andp orp subp xorp loadp cpeq cpneq cpa cpaeq")
    addWords(instructionSet, "cpb cpbeq cpgt cpgteq cplt cplteq storep btps btpz btpnz baddpo baddps baddpz baddpnz")
    addWords(instructionSet, "tqs tqz tqnz bqeq bqneq bqa bqaeq bqb bqbeq bqgt bqgteq bqlt bqlteq addq")
    addWords(instructionSet, "mulq andq orq subq xorq loadq cqeq cqneq cqa cqaeq cqb cqbeq cqgt cqgteq")
    addWords(instructionSet, "cqlt cqlteq storeq btqs btqz btqnz baddqo baddqs baddqz baddqnz bo bs bz bnz")
    addWords(instructionSet, "leai leap memfence tagCodePtr tagReturnAddress untagReturnAddress removeCodePtrTag untagArrayPtr removeArrayPtrTag tzcnti tzcntq lzcnti lzcntq absf")
    addWords(instructionSet, "absd negf negd ceilf ceild cfeq cdeq cfneq cfnequn cdneq cdnequn cflt cdlt cflteq")
    addWords(instructionSet, "cdlteq cfgt cdgt cfgteq cdgteq fi2f ff2i tls_loadp tls_storep cdqi idivi udivi cqoq idivq")
    addWords(instructionSet, "udivq notq atomicxchgaddb atomicxchgaddh atomicxchgaddi atomicxchgaddq atomicxchgsubb atomicxchgsubh atomicxchgsubi atomicxchgsubq atomicxchgb atomicxchgh atomicxchgi atomicxchgq")
    addWords(instructionSet, "batomicweakcasb batomicweakcash batomicweakcasi batomicweakcasq atomicweakcasb atomicweakcash atomicweakcasi atomicweakcasq atomicloadb atomicloadh atomicloadi atomicloadq fence adcq")
    addWords(instructionSet, "sbcq umulhq smulhq adci bcs clrbp mvlbl globaladdr sbci moveii loadlinkb loadlinkh loadlinki loadlink2i")
    addWords(instructionSet, "storecondb storecondh storecondi storecond2i writefence bfiq pcrtoaddr loadqinc loadlinkacqb loadlinkacqh loadlinkacqi loadlinkacqq storecondrelb storecondrelh")
    addWords(instructionSet, "storecondreli storecondrelq atomicxchgclearb atomicxchgclearh atomicxchgcleari atomicxchgclearq atomicxchgorb atomicxchgorh atomicxchgori atomicxchgorq atomicxchgxorb atomicxchgxorh atomicxchgxori atomicxchgxorq")
    addWords(instructionSet, "loadpairq loadpairp loadpairi storepairq storepairp storepairi loadpaird storepaird loadpairv storepairv addlshiftp addqs subqs umovb")
    addWords(instructionSet, "umovh umovi umovq smulli umulli addis subis oris addps divi divis divq divqs remi")
    addWords(instructionSet, "remis remq remqs la movz movn setcallreg slt sltu pichdr cloopCrash cloopCallJSFunction cloopCallNative cloopCallSlowPath")
    addWords(instructionSet, "cloopCallSlowPathVoid cloopCallSlowPath3 cloopCallSlowPath4 cloopDo")
}

pub fn addIncludeDir(path: []const u8) -> void {
    if includeDirCount == 64 { s.fail("offlineasm: too many -I directories") }
    includeDirs[includeDirCount] = u.cat(path, "/")
    includeDirCount += 1
}

pub fn isInstructionName(name: []const u8) -> bool { return u.mapGet(instructionSet, name) != 0 }

// ---------------------------------------------------------------------------
// The lexer.

fn isWordByte(byte: u8) -> bool { return u.isAlnum(byte) || byte == 95 }
fn isHexDigit(byte: u8) -> bool { return s.isDigit(byte) || (byte >= 97 && byte <= 102) || (byte >= 65 && byte <= 70) }

fn addToken(list: *[*]Token, count: *usize, capacity: *usize, token: Token) -> void {
    if count.* == capacity.* {
        const bigger = capacity.* * 2
        var tokens: [*]Token = undefined
        unsafe { tokens = @ptrFromInt([*]Token, s.alloc(bigger * @sizeOf(Token))) }
        var index: usize = 0
        while index < count.* {
            tokens[index] = list.*[index]
            index += 1
        }
        list.* = tokens
        capacity.* = bigger
    }
    list.*[count.*] = token
    count.* += 1
}

fn lex(parser: *Parser, text: []const u8, file: u64) -> void {
    var capacity: usize = 1024
    var tokens: [*]Token = undefined
    unsafe { tokens = @ptrFromInt([*]Token, s.alloc(capacity * @sizeOf(Token))) }
    var count: usize = 0
    var line: usize = 1
    var annotation: []const u8 = ""
    var hasAnnotation = false
    var annotationLocal = false
    var whitespaceFound = false
    var at: usize = 0
    while at < text.length {
        const byte = text[at]
        const next: u8 = if at + 1 < text.length { text[at + 1] } else { 0 }
        const origin = ast.originOf(file, line)
        if byte == 35 {
            // # comment.
            while at < text.length && text[at] != 10 { at += 1 }
            whitespaceFound = false
            continue
        }
        if byte == 47 && next == 42 {
            // A /* comment */, if it is closed.
            var end = at + 2
            while end + 1 < text.length && !(text[end] == 42 && text[end + 1] == 47) { end += 1 }
            if end + 1 < text.length {
                var index = at
                while index < end {
                    if text[index] == 10 { line += 1 }
                    index += 1
                }
                at = end + 2
                whitespaceFound = true
                continue
            }
        }
        if byte == 47 && next == 47 {
            // An annotation: "//", maybe a space, the rest of the line.
            at += 2
            if at < text.length && text[at] == 32 { at += 1 }
            const start = at
            while at < text.length && text[at] != 10 { at += 1 }
            annotation = text[start..at]
            hasAnnotation = true
            annotationLocal = whitespaceFound
            whitespaceFound = false
            continue
        }
        var start = at
        var kind: u8 = 255
        var made: []const u8 = ""
        if byte == 10 {
            if hasAnnotation {
                addToken(&tokens, &count, &capacity, Token.{ .kind = ANNOTATION, .text = annotation, .origin = origin, .local = annotationLocal })
                hasAnnotation = false
            }
            addToken(&tokens, &count, &capacity, Token.{ .kind = TOKEN, .text = "\n", .origin = origin, .local = false })
            line += 1
            at += 1
            whitespaceFound = false
            continue
        }
        if u.isLetter(byte) || byte == 37 {
            at += 1
            while at < text.length && (isWordByte(text[at]) || text[at] == 46 || text[at] == 37) { at += 1 }
            kind = TOKEN
        } else if byte == 46 {
            at += 1
            while at < text.length && isWordByte(text[at]) { at += 1 }
            kind = TOKEN
        } else if byte == 95 {
            at += 1
            while at < text.length && (isWordByte(text[at]) || text[at] == 37) { at += 1 }
            kind = TOKEN
        } else if byte == 32 || byte == 9 {
            while at < text.length && (text[at] == 32 || text[at] == 9) { at += 1 }
            whitespaceFound = true
            continue
        } else if byte == 48 && next == 120 && at + 2 < text.length && isHexDigit(text[at + 2]) {
            at += 2
            var value: i128 = 0
            while at < text.length && isHexDigit(text[at]) {
                const digit = text[at]
                const d: u8 = if s.isDigit(digit) { digit - 48 } else if digit >= 97 { digit - 87 } else { digit - 55 }
                value = value * 16 + @intCast(i128, d)
                at += 1
            }
            made = u.decimal128(value)
            kind = TOKEN
        } else if byte == 48 && next >= 48 && next <= 55 {
            at += 1
            var value: i128 = 0
            while at < text.length && text[at] >= 48 && text[at] <= 55 {
                value = value * 8 + @intCast(i128, text[at] - 48)
                at += 1
            }
            made = u.decimal128(value)
            kind = TOKEN
        } else if s.isDigit(byte) {
            while at < text.length && s.isDigit(text[at]) { at += 1 }
            kind = TOKEN
        } else if byte == 58 && next == 58 {
            at += 2
            kind = TOKEN
        } else if byte == 58 || byte == 44 || byte == 40 || byte == 41 || byte == 91 || byte == 93 || byte == 61 || byte == 43 || byte == 45 || byte == 126 || byte == 124 || byte == 38 || byte == 94 || byte == 42 {
            at += 1
            kind = TOKEN
        } else if byte == 34 {
            // ".*": to the last quote on the line.
            var end = at + 1
            var last = at
            while end < text.length && text[end] != 10 {
                if text[end] == 34 { last = end }
                end += 1
            }
            if last > at {
                at = last + 1
                kind = TOKEN
            }
        }
        if kind == 255 {
            // Ruby's last case, /\?/, is not anchored: the first question
            // mark anywhere on, the text up to it skipped.
            var question = at
            while question < text.length && text[question] != 63 { question += 1 }
            if question == text.length {
                s.fail(u.cat3("offlineasm: Lexer error at ", ast.originString(origin), ", unexpected sequence"))
            }
            start = question
            at = question + 1
            kind = TOKEN
        }
        const tokenText = if made.length > 0 { made } else { text[start..at] }
        addToken(&tokens, &count, &capacity, Token.{ .kind = TOKEN, .text = tokenText, .origin = origin, .local = false })
        whitespaceFound = false
    }
    parser.*.tokens = tokens
    parser.*.count = count
}

// ---------------------------------------------------------------------------
// Tokens.

fn current(parser: *Parser) -> Token { return at(parser, parser.*.index) }

fn at(parser: *Parser, index: usize) -> Token {
    if index < parser.*.count { return parser.*.tokens[index] }
    return Token.{ .kind = END, .text = "", .origin = 0, .local = false }
}

fn is(token: Token, text: []const u8) -> bool { return token.kind == TOKEN && s.same(token.text, text) }
fn isNow(parser: *Parser, text: []const u8) -> bool { return is(current(parser), text) }

fn isRegister(token: Token) -> bool {
    if token.kind != TOKEN { return false }
    return u.mapGet(gprs, token.text) != 0 || u.mapGet(fprs, token.text) != 0 || u.mapGet(vecs, token.text) != 0
}

fn isInstruction(token: Token) -> bool { return token.kind == TOKEN && u.mapGet(instructionSet, token.text) != 0 }

fn isKeyword(token: Token) -> bool {
    return token.kind == TOKEN && (u.mapGet(keywords, token.text) != 0 || isRegister(token) || isInstruction(token))
}

// [a-zA-Z%][a-zA-Z0-9_.%]* and no keyword.
fn isIdentifier(token: Token) -> bool {
    if token.kind != TOKEN || token.text.length == 0 { return false }
    const text = token.text
    if !u.isLetter(text[0]) && text[0] != 37 { return false }
    var index: usize = 1
    while index < text.length {
        const byte = text[index]
        if !(isWordByte(byte) || byte == 46 || byte == 37) { return false }
        index += 1
    }
    return !isKeyword(token)
}

fn isLabelText(text: []const u8) -> bool {
    if text.length == 0 || text[0] != 95 { return false }
    var index: usize = 1
    while index < text.length {
        if !(isWordByte(text[index]) || text[index] == 37) { return false }
        index += 1
    }
    return true
}

fn isLabel(token: Token) -> bool { return token.kind == TOKEN && isLabelText(token.text) }

fn isLocalLabel(token: Token) -> bool {
    if token.kind != TOKEN || token.text.length == 0 || token.text[0] != 46 { return false }
    var index: usize = 1
    while index < token.text.length {
        if !isWordByte(token.text[index]) { return false }
        index += 1
    }
    return true
}

fn isVariable(token: Token) -> bool { return isIdentifier(token) || isRegister(token) }
fn isInteger(token: Token) -> bool { return token.kind == TOKEN && token.text.length > 0 && s.isDigit(token.text[0]) }
fn isString(token: Token) -> bool {
    return token.kind == TOKEN && token.text.length >= 2 && token.text[0] == 34 && token.text[token.text.length - 1] == 34
}

fn finalMatches(token: Token, final: u8) -> bool {
    if final == FINAL_END { return is(token, "end") }
    return is(token, "else") || is(token, "end") || is(token, "elsif")
}

fn parseError(parser: *Parser, comment: []const u8) -> void {
    const token = current(parser)
    if token.kind == END { s.fail(u.cat("offlineasm: Parse error at end of file: ", comment)) }
    s.fail(u.cat5("offlineasm: Parse error: \"", token.text, "\" at ", ast.originString(token.origin), u.cat(": ", comment)))
}

fn skipNewLine(parser: *Parser) -> void {
    while isNow(parser, "\n") { parser.*.index += 1 }
}

// ---------------------------------------------------------------------------
// Predicates (of "if").

fn parsePredicateAtom(parser: *Parser) -> *Node {
    const token = current(parser)
    if is(token, "not") {
        parser.*.index += 1
        return ast.unary(ast.PRED_NOT, token.origin, parsePredicateAtom(parser))
    }
    if is(token, "(") {
        parser.*.index += 1
        skipNewLine(parser)
        const result = parsePredicate(parser)
        if !isNow(parser, ")") { parseError(parser, "expected )") }
        parser.*.index += 1
        return result
    }
    if is(token, "true") {
        parser.*.index += 1
        return ast.trueNode
    }
    if is(token, "false") {
        parser.*.index += 1
        return ast.falseNode
    }
    if isIdentifier(token) {
        parser.*.index += 1
        return ast.settingFor(token.origin, token.text)
    }
    parseError(parser, "in a predicate")
    return ast.trueNode
}

fn parsePredicateAnd(parser: *Parser) -> *Node {
    var result = parsePredicateAtom(parser)
    while isNow(parser, "and") {
        const origin = current(parser).origin
        parser.*.index += 1
        skipNewLine(parser)
        const right = parsePredicateAtom(parser)
        result = ast.binary(ast.PRED_AND, origin, result, right)
    }
    return result
}

fn parsePredicate(parser: *Parser) -> *Node {
    var result = parsePredicateAnd(parser)
    while isNow(parser, "or") {
        const origin = current(parser).origin
        parser.*.index += 1
        skipNewLine(parser)
        const right = parsePredicateAnd(parser)
        result = ast.binary(ast.PRED_OR, origin, result, right)
    }
    return result
}

// ---------------------------------------------------------------------------
// Operands.

fn parseVariable(parser: *Parser) -> *Node {
    const token = current(parser)
    var result: *Node = ast.trueNode
    if isRegister(token) {
        if u.mapGet(vecs, token.text) != 0 {
            result = ast.registerFor(ast.VEC_REGISTER, token.origin, token.text)
        } else if u.mapGet(fprs, token.text) != 0 {
            result = ast.registerFor(ast.FP_REGISTER, token.origin, token.text)
        } else {
            result = ast.registerFor(ast.REGISTER, token.origin, token.text)
        }
    } else if isIdentifier(token) {
        result = ast.variableFor(token.origin, token.text, "")
    } else {
        parseError(parser, "expected a variable")
    }
    parser.*.index += 1
    return result
}

fn parseConstExpr(parser: *Parser) -> *Node {
    if !isNow(parser, "constexpr") { parseError(parser, "expected constexpr") }
    parser.*.index += 1
    skipNewLine(parser)
    var origin: u64 = 0
    var text: []const u8 = ""
    if isNow(parser, "(") {
        // The tokens up to the matching parenthesis, joined.
        origin = current(parser).origin
        parser.*.index += 1
        if isNow(parser, ")") { s.fail("offlineasm: empty constexpr") }
        var depth: usize = 0
        var joined = u.bufNew(64)
        while !isNow(parser, ")") || depth > 0 {
            const token = current(parser)
            if token.kind == END { parseError(parser, "unterminated constexpr") }
            if is(token, "(") {
                depth += 1
            } else if is(token, ")") {
                depth -= 1
            }
            u.bufAdd(&joined, token.text)
            parser.*.index += 1
        }
        parser.*.index += 1
        text = u.bufText(&joined)
    } else {
        const names = parseColonColon(parser)
        origin = names.0
        text = names.1
    }
    return ast.constExprFor(origin, text)
}

// NAME(::NAME)*: where it starts, and the names joined with "::".
fn parseColonColon(parser: *Parser) -> (u64, []const u8) {
    skipNewLine(parser)
    const origin = current(parser).origin
    if !isIdentifier(current(parser)) { parseError(parser, "expected an identifier") }
    var joined = current(parser).text
    parser.*.index += 1
    while isNow(parser, "::") {
        parser.*.index += 1
        if !isIdentifier(current(parser)) { parseError(parser, "expected an identifier after ::") }
        joined = u.cat3(joined, "::", current(parser).text)
        parser.*.index += 1
    }
    return -> (origin, joined)
}

fn parseAddress(parser: *Parser, offset: *Node) -> *Node {
    if !isNow(parser, "[") { parseError(parser, "expected [") }
    const origin = current(parser).origin
    parser.*.index += 1
    if isNow(parser, "]") {
        parser.*.index += 1
        return ast.unary(ast.ABSOLUTE_ADDRESS, origin, offset)
    }
    const base = parseVariable(parser)
    var result: *Node = base
    if isNow(parser, "]") {
        if !(base.*.kind == ast.VARIABLE || ast.isRegisterKind(base.*.kind)) { s.fail("offlineasm: Bad base for address") }
        if !(offset.*.kind == ast.VARIABLE || ast.isImmediate(offset)) { s.fail(u.cat("offlineasm: Bad offset for address at ", ast.originString(origin))) }
        result = ast.binary(ast.ADDRESS, origin, base, offset)
    } else {
        if !isNow(parser, ",") { parseError(parser, "expected , in an address") }
        parser.*.index += 1
        const index = parseVariable(parser)
        result = ast.newNode(ast.BASE_INDEX, origin)
        result.*.a = base
        result.*.b = index
        result.*.d = offset
        if isNow(parser, "]") {
            result.*.c = ast.immediate(origin, 1)
        } else {
            if !isNow(parser, ",") { parseError(parser, "expected , in an address") }
            parser.*.index += 1
            if isNow(parser, "1") || isNow(parser, "2") || isNow(parser, "4") || isNow(parser, "8") {
                result.*.c = ast.immediate(origin, u.parseDecimal(current(parser).text))
                parser.*.index += 1
            } else if isNow(parser, "constexpr") {
                result.*.c = parseConstExpr(parser)
            } else {
                result.*.c = parseVariable(parser)
            }
            if !isNow(parser, "]") { parseError(parser, "expected ]") }
        }
    }
    parser.*.index += 1
    return result
}

fn parseExpressionAtom(parser: *Parser) -> *Node {
    skipNewLine(parser)
    const token = current(parser)
    if is(token, "-") {
        parser.*.index += 1
        return ast.unary(ast.NEG, token.origin, parseExpressionAtom(parser))
    }
    if is(token, "~") {
        parser.*.index += 1
        return ast.unary(ast.BITNOT, token.origin, parseExpressionAtom(parser))
    }
    if is(token, "(") {
        parser.*.index += 1
        const result = parseExpression(parser)
        if !isNow(parser, ")") { parseError(parser, "expected ')'") }
        parser.*.index += 1
        return result
    }
    if isInteger(token) {
        parser.*.index += 1
        return ast.immediate(token.origin, u.parseDecimal(token.text))
    }
    if isString(token) {
        parser.*.index += 1
        const node = ast.newNode(ast.STRING, token.origin)
        node.*.name = token.text[1..token.text.length - 1]
        return node
    }
    if isIdentifier(token) {
        const names = parseColonColon(parser)
        if s.contains(names.1, "::") { return ast.structOffsetOfDump(names.0, names.1) }
        return ast.variableFor(names.0, names.1, "")
    }
    if isRegister(token) { return parseVariable(parser) }
    if is(token, "sizeof") {
        parser.*.index += 1
        const names = parseColonColon(parser)
        return ast.sizeofFor(names.0, names.1)
    }
    if is(token, "constexpr") { return parseConstExpr(parser) }
    if isLabel(token) {
        parser.*.index += 1
        return ast.labelReference(token.origin, ast.labelFor(token.origin, token.text, false))
    }
    if isLocalLabel(token) {
        parser.*.index += 1
        return ast.localLabelReference(token.origin, ast.localLabelFor(token.origin, token.text))
    }
    parseError(parser, "expected an expression")
    return ast.trueNode
}

fn parseExpressionMul(parser: *Parser) -> *Node {
    skipNewLine(parser)
    var result = parseExpressionAtom(parser)
    while isNow(parser, "*") {
        const origin = current(parser).origin
        parser.*.index += 1
        result = ast.binary(ast.MUL, origin, result, parseExpressionAtom(parser))
    }
    return result
}

fn couldBeExpression(parser: *Parser) -> bool {
    const token = current(parser)
    return is(token, "-") || is(token, "~") || is(token, "sizeof") || is(token, "constexpr") || isInteger(token) || isString(token) || isVariable(token) || isLabel(token) || is(token, "(")
}

fn parseExpressionAdd(parser: *Parser) -> *Node {
    skipNewLine(parser)
    var result = parseExpressionMul(parser)
    while isNow(parser, "+") || isNow(parser, "-") {
        const kind = if isNow(parser, "+") { ast.ADD } else { ast.SUB }
        const origin = current(parser).origin
        parser.*.index += 1
        result = ast.binary(kind, origin, result, parseExpressionMul(parser))
    }
    return result
}

fn parseExpressionAnd(parser: *Parser) -> *Node {
    skipNewLine(parser)
    var result = parseExpressionAdd(parser)
    while isNow(parser, "&") {
        const origin = current(parser).origin
        parser.*.index += 1
        result = ast.binary(ast.AND, origin, result, parseExpressionAdd(parser))
    }
    return result
}

fn parseExpression(parser: *Parser) -> *Node {
    skipNewLine(parser)
    var result = parseExpressionAnd(parser)
    while isNow(parser, "|") || isNow(parser, "^") {
        const kind = if isNow(parser, "|") { ast.OR } else { ast.XOR }
        const origin = current(parser).origin
        parser.*.index += 1
        result = ast.binary(kind, origin, result, parseExpressionAnd(parser))
    }
    return result
}

fn parseOperand(parser: *Parser, comment: []const u8) -> *Node {
    skipNewLine(parser)
    if couldBeExpression(parser) {
        const expression = parseExpression(parser)
        if isNow(parser, "[") { return parseAddress(parser, expression) }
        return expression
    }
    if isNow(parser, "[") { return parseAddress(parser, ast.immediate(current(parser).origin, 0)) }
    const token = current(parser)
    if isLocalLabel(token) {
        parser.*.index += 1
        return ast.localLabelReference(token.origin, ast.localLabelFor(token.origin, token.text))
    }
    parseError(parser, comment)
    return ast.trueNode
}

fn parseMacroVariables(parser: *Parser) -> ast.List {
    skipNewLine(parser)
    if !isNow(parser, "(") { parseError(parser, "expected (") }
    parser.*.index += 1
    var variables = ast.listNew(4)
    while true {
        skipNewLine(parser)
        const token = current(parser)
        if is(token, ")") {
            parser.*.index += 1
            break
        }
        if !isIdentifier(token) { parseError(parser, "expected a macro variable") }
        ast.listAdd(&variables, ast.variableFor(token.origin, token.text, ""))
        parser.*.index += 1
        skipNewLine(parser)
        if isNow(parser, ")") {
            parser.*.index += 1
            break
        }
        if !isNow(parser, ",") { parseError(parser, "expected , or )") }
        parser.*.index += 1
    }
    return variables
}

// ---------------------------------------------------------------------------
// Sequences.

// The tokens are at the end of the sequence.
fn atEnd(parser: *Parser, final: u8) -> bool {
    if final == FINAL_NONE { return parser.*.index == parser.*.count }
    return finalMatches(current(parser), final)
}

// IncludeFile: MODULE.asm in the last -I directory that has it, else in
// DEFAULT.
fn includeFileName(module: []const u8, defaultDirectory: []const u8) -> []const u8 {
    const file = u.cat(module, ".asm")
    var directory = defaultDirectory
    var index: usize = 0
    while index < includeDirCount {
        if u.isFile(u.joinPath(includeDirs[index], file)) { directory = includeDirs[index] }
        index += 1
    }
    return u.joinPath(directory, file)
}

fn additionsDirectory() -> []const u8 {
    if additionsLength > 0 { return additionsPointer[0..additionsLength] }
    return "/WebKitAdditions/"
}

// The file an include names (or "" when it is optional and missing), the
// tokens past it.
fn parseInclude(parser: *Parser) -> []const u8 {
    parser.*.index += 1
    var optional = false
    if isNow(parser, "?") {
        optional = true
        parser.*.index += 1
    }
    if !isIdentifier(current(parser)) { parseError(parser, "expected a file to include") }
    const module = current(parser).text
    parser.*.index += 1
    var fileName = includeFileName(module, additionsDirectory())
    if !u.exists(fileName) { fileName = includeFileName(module, u.dirName(parser.*.fileName)) }
    if !u.exists(fileName) {
        if !optional { s.fail(u.cat("offlineasm: File not found: ", fileName)) }
        return ""
    }
    return fileName
}

fn parseSequence(parser: *Parser, final: u8, comment: []const u8) -> *Node {
    const firstOrigin = current(parser).origin
    var list = ast.listNew(16)
    while true {
        const token = current(parser)
        if token.kind == ANNOTATION {
            const opcode = if token.local { "localAnnotation" } else { "globalAnnotation" }
            ast.listAdd(&list, ast.instruction(token.origin, opcode, ast.nodeArray(0), 0, token.text, true))
            parser.*.hasAnnotation = false
            parser.*.index += 2
        } else if atEnd(parser, final) {
            break
        } else if is(token, "\n") {
            parser.*.index += 1
        } else if is(token, "const") {
            parser.*.index += 1
            if !isVariable(current(parser)) { parseError(parser, "expected a variable after const") }
            const variable = ast.variableFor(current(parser).origin, current(parser).text, "")
            parser.*.index += 1
            if !isNow(parser, "=") { parseError(parser, "expected =") }
            parser.*.index += 1
            const value = parseOperand(parser, u.cat("while inside of const ", variable.*.name))
            ast.listAdd(&list, ast.binary(ast.CONST_DECL, current(parser).origin, variable, value))
        } else if is(token, "error") {
            ast.listAdd(&list, ast.newNode(ast.ERROR, token.origin))
            parser.*.index += 1
        } else if is(token, "if") {
            parser.*.index += 1
            skipNewLine(parser)
            var predicate = parsePredicate(parser)
            if !(isNow(parser, "then") || isNow(parser, "\n")) { parseError(parser, "expected then") }
            parser.*.index += 1
            skipNewLine(parser)
            var node = ast.ifThenElse(token.origin, predicate, parseSequence(parser, FINAL_ELSE_END, "while inside of if"))
            ast.listAdd(&list, node)
            while isNow(parser, "elsif") {
                const origin = current(parser).origin
                parser.*.index += 1
                skipNewLine(parser)
                predicate = parsePredicate(parser)
                if !(isNow(parser, "then") || isNow(parser, "\n")) { parseError(parser, "expected then") }
                parser.*.index += 1
                skipNewLine(parser)
                const elseCase = ast.ifThenElse(origin, predicate, parseSequence(parser, FINAL_ELSE_END, "while inside of elsif"))
                node.*.c = elseCase
                node = elseCase
            }
            if isNow(parser, "else") {
                parser.*.index += 1
                node.*.c = parseSequence(parser, FINAL_END, "while inside of else")
                parser.*.index += 1
            } else {
                if !isNow(parser, "end") { parseError(parser, "expected end") }
                parser.*.index += 1
            }
        } else if is(token, "macro") {
            parser.*.index += 1
            skipNewLine(parser)
            if !isIdentifier(current(parser)) { parseError(parser, "expected a macro name") }
            const name = current(parser).text
            parser.*.index += 1
            const variables = parseMacroVariables(parser)
            const body = parseSequence(parser, FINAL_END, u.cat("while inside of macro ", name))
            parser.*.index += 1
            const macro = ast.withItems(ast.MACRO, token.origin, variables.items, variables.count)
            macro.*.name = name
            macro.*.a = body
            ast.listAdd(&list, macro)
        } else if is(token, "global") || is(token, "globalexport") || is(token, "unalignedglobal") || is(token, "aligned") || is(token, "unalignedglobalexport") {
            parser.*.index += 1
            skipNewLine(parser)
            if !isLabel(current(parser)) { parseError(parser, "expected a label") }
            const name = current(parser).text
            parser.*.index += 1
            if is(token, "global") {
                ast.setAsGlobal(token.origin, name)
            } else if is(token, "globalexport") {
                ast.setAsGlobalExport(token.origin, name)
            } else if is(token, "unalignedglobal") {
                ast.setAsUnalignedGlobal(token.origin, name)
            } else if is(token, "unalignedglobalexport") {
                ast.setAsUnalignedGlobalExport(token.origin, name)
            } else {
                // Ruby's `align !=~ /[0-9]+/` is always true: the
                // alignment is always a variable.
                const alignment = ast.variableFor(token.origin, current(parser).text, "")
                parser.*.index += 1
                ast.setAsAligned(token.origin, name, alignment)
            }
        } else if isInstruction(token) {
            const name = token.text
            parser.*.index += 1
            if atEnd(parser, final) {
                // Zero operand instruction, and it's the last one.
                ast.listAdd(&list, ast.instruction(token.origin, name, ast.nodeArray(0), 0, parser.*.annotation, parser.*.hasAnnotation))
                parser.*.hasAnnotation = false
                break
            } else if current(parser).kind == ANNOTATION {
                ast.listAdd(&list, ast.instruction(token.origin, name, ast.nodeArray(0), 0, current(parser).text, true))
                parser.*.hasAnnotation = false
                parser.*.index += 2
            } else if isNow(parser, "\n") {
                ast.listAdd(&list, ast.instruction(token.origin, name, ast.nodeArray(0), 0, parser.*.annotation, parser.*.hasAnnotation))
                parser.*.hasAnnotation = false
                parser.*.index += 1
            } else {
                var operands = ast.listNew(4)
                var endOfSequence = false
                while true {
                    ast.listAdd(&operands, parseOperand(parser, u.cat("while inside of instruction ", name)))
                    if atEnd(parser, final) {
                        endOfSequence = true
                        break
                    } else if isNow(parser, ",") {
                        parser.*.index += 1
                    } else if current(parser).kind == ANNOTATION {
                        parser.*.annotation = current(parser).text
                        parser.*.hasAnnotation = true
                        parser.*.index += 2
                        break
                    } else if isNow(parser, "\n") {
                        parser.*.index += 1
                        break
                    } else {
                        parseError(parser, "Expected a comma, newline, or end")
                    }
                }
                ast.listAdd(&list, ast.instruction(token.origin, name, operands.items, operands.count, parser.*.annotation, parser.*.hasAnnotation))
                parser.*.hasAnnotation = false
                if endOfSequence { break }
            }
        } else if isIdentifier(token) {
            // A macro invocation.
            const name = token.text
            parser.*.index += 1
            if !isNow(parser, "(") { parseError(parser, u.cat3("Expected \"(\" after ", name, "")) }
            parser.*.index += 1
            var operands = ast.listNew(4)
            skipNewLine(parser)
            if isNow(parser, ")") {
                parser.*.index += 1
            } else {
                while true {
                    skipNewLine(parser)
                    if isNow(parser, "macro") {
                        // A macro passed as an argument.
                        const origin = current(parser).origin
                        parser.*.index += 1
                        const variables = parseMacroVariables(parser)
                        const body = parseSequence(parser, FINAL_END, u.cat("while inside of anonymous macro passed as argument to ", name))
                        parser.*.index += 1
                        const macro = ast.withItems(ast.MACRO, origin, variables.items, variables.count)
                        macro.*.a = body
                        ast.listAdd(&operands, macro)
                    } else {
                        ast.listAdd(&operands, parseOperand(parser, u.cat("while inside of macro call to ", name)))
                    }
                    skipNewLine(parser)
                    if isNow(parser, ")") {
                        parser.*.index += 1
                        break
                    } else if isNow(parser, ",") {
                        parser.*.index += 1
                    } else {
                        parseError(parser, u.cat("while parsing invocation of macro ", name))
                    }
                }
            }
            if current(parser).kind == ANNOTATION {
                parser.*.annotation = current(parser).text
                parser.*.hasAnnotation = true
                parser.*.index += 2
            }
            const call = ast.withItems(ast.MACRO_CALL, token.origin, operands.items, operands.count)
            call.*.name = name
            call.*.original = name
            call.*.text = parser.*.annotation
            call.*.hasText = parser.*.hasAnnotation
            ast.listAdd(&list, call)
            parser.*.hasAnnotation = false
        } else if isLabel(token) || isLocalLabel(token) {
            parser.*.index += 1
            if !isNow(parser, ":") { parseError(parser, "expected :") }
            if isLabel(token) {
                ast.listAdd(&list, ast.labelFor(token.origin, token.text, true))
            } else {
                ast.listAdd(&list, ast.localLabelFor(token.origin, token.text))
            }
            parser.*.index += 1
        } else if is(token, "include") {
            const fileName = parseInclude(parser)
            if fileName.length > 0 { ast.listAdd(&list, parse(fileName)) }
        } else {
            parseError(parser, u.cat("Expecting terminal ", comment))
        }
    }
    return ast.withItems(ast.SEQUENCE, firstOrigin, list.items, list.count)
}

// readTextFile: the file, which must be ASCII, without its carriage
// returns.
fn readTextFile(fileName: []const u8) -> []const u8 {
    const data = u.readFile(fileName)
    var carriage = false
    for byte in data {
        if byte >= 128 { s.fail(u.cat(fileName, " contains non-ASCII characters")) }
        if byte == 13 { carriage = true }
    }
    if !carriage { return data }
    var kept = u.bufNew(data.length + 1)
    for byte in data {
        if byte != 13 { u.bufByte(&kept, byte) }
    }
    return u.bufText(&kept)
}

fn newParser(text: []const u8, fileName: []const u8) -> *Parser {
    var parser: *Parser = undefined
    unsafe { parser = @ptrFromInt(*Parser, s.alloc(@sizeOf(Parser))) }
    parser.*.index = 0
    parser.*.annotation = ""
    parser.*.hasAnnotation = false
    parser.*.fileName = fileName
    lex(parser, text, ast.sourceFile(fileName))
    return parser
}

pub fn parse(fileName: []const u8) -> *Node {
    u.bufAdd(&sources, fileName)
    u.bufByte(&sources, 0)
    const parser = newParser(readTextFile(fileName), fileName)
    return parseSequence(parser, FINAL_NONE, "")
}

// ---------------------------------------------------------------------------
// parseHash: SHA-1 of FILE and of every file it includes, in order, each
// before what it includes, conditions or not.

fn includedFiles(fileName: []const u8, contents: *u.Buf) -> void {
    u.bufAdd(contents, u.readFile(fileName))
    const parser = newParser(readTextFile(fileName), fileName)
    while parser.*.index < parser.*.count {
        if isNow(parser, "include") {
            const included = parseInclude(parser)
            if included.length > 0 { includedFiles(included, contents) }
        } else {
            parser.*.index += 1
        }
    }
}

pub fn parseHash(fileName: []const u8) -> []const u8 {
    var contents = u.bufNew(1048576)
    includedFiles(fileName, &contents)
    return u.sha1Hex(u.bufText(&contents))
}
