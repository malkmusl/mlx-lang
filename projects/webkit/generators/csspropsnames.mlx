// process-css-properties.py's GenerateCSSPropertyInitialValues
// (CSSPropertyInitialValuesGeneratedInlines.h), GenerateCSSPropertyNames
// (CSSPropertyNames.h and gperf's input CSSPropertyNames.gperf) and
// GenerateCSSStylePropertiesPropertyNames
// (CSSStyleProperties+PropertyNames.idl).
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")
const g = @import("./csspropsterms.mlx")
const m = @import("./csspropsmodel.mlx")
const x = @import("./csspropsgen.mlx")

// ---------------------------------------------------------------------------
// CSSPropertyInitialValuesGeneratedInlines.h

fn unitType(element: *m.InitialElement) -> []const u8 {
    if element.*.unit.length == 0 { return "CSSUnitType::CSS_NUMBER" }
    if std.text.same(element.*.unit, "%") { return "CSSUnitType::CSS_PERCENTAGE" }
    return s.join("CSSUnitType::CSS_", c.upper(element.*.unit))
}

pub fn initialValues() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.pragmaOnce(w)
    x.includesOf(w, "CSSPrimitiveValue.h CSSPropertyNames.h CSSValueKeywords.h", "<wtf/Variant.h>")
    x.openNamespace(w, "WebCore")
    c.write(w, "using InitialValue = Variant<CSSValueID, CSSPrimitiveValue::Raw>;")
    c.newline(w)
    c.write(w, "static constexpr InitialValue initialValueForLonghand(CSSPropertyID longhand)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "switch (longhand) {")
    // Grouped by the initial value's text, in the order the texts come.
    var texts = t.list()
    var groups = g.refs()
    const properties = m.allNonShorthands()
    var index: usize = 0
    while index < properties.count {
        const p = m.propertyAt(properties, index)
        index += 1
        if m.cgOn(p, "internal-only") || p.*.initial == null { continue }
        const initial = p.*.initial.?
        if initial.*.elements.count != 1 { continue }
        if m.elementAt(initial.*.elements, 0).*.kind == m.I_SPECIAL { continue }
        var at: usize = 0
        while at < texts.count && !std.text.same(texts.items[at], initial.*.text) { at += 1 }
        if at == texts.count {
            t.push(&texts, initial.*.text)
            const group: *g.Refs = unsafe { @ptrFromInt(*g.Refs, s.alloc(@sizeOf(g.Refs))) }
            group.* = g.refs()
            g.push(&groups, @intFromPtr(group))
        }
        g.push(m.refsOf(groups.items[at]), @intFromPtr(p))
    }
    index = 0
    while index < groups.count {
        const group = m.sorted(m.refsOf(groups.items[index]).*, m.compareId)
        var at: usize = 0
        while at < group.count {
            c.write(w, t.c3("case ", m.fullId(m.propertyAt(group, at)), ":"))
            at += 1
        }
        const element = m.elementAt(m.propertyAt(group, 0).*.initial.?.*.elements, 0)
        c.indent(w)
        if element.*.kind == m.I_NUMERIC {
            c.write(w, t.c5("return CSSPrimitiveValue::Raw { ", unitType(element), ", ", element.*.digits, " };"))
        } else {
            c.write(w, t.c3("return CSSValue", g.nameToId(element.*.name), ";"))
        }
        c.outdent(w)
        index += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "RELEASE_ASSERT_NOT_REACHED();")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    x.closeNamespace(w, "WebCore")
    return c.written(w)
}

// ---------------------------------------------------------------------------
// CSSPropertyNames.h

fn propertyConstants(w: *c.Writer) -> void {
    c.write(w, "enum CSSPropertyID : uint16_t {")
    c.indent(w)
    c.write(w, "CSSPropertyInvalid = 0,")
    c.write(w, "CSSPropertyCustom = 1,")
    const first: usize = 2
    var count: usize = 2
    var maxLength: usize = 0
    var firsts: [7]usize = undefined
    var lasts: [7]usize = undefined
    var bucket: usize = 0
    while bucket < 7 {
        firsts[bucket] = 0
        lasts[bucket] = 0
        bucket += 1
    }
    const unique = m.allUnique()
    var index: usize = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        // 0 shorthand, 1 top, 2 high, 3 medium, 4 low, 5 physical, 6 logical.
        if p.*.hasLonghands {
            bucket = 0
        } else if m.cgOn(p, "top-priority") {
            bucket = 1
        } else if m.cgOn(p, "high-priority") {
            bucket = 2
        } else if m.cgOn(p, "medium-priority") {
            bucket = 3
        } else if p.*.logicalGroup == null {
            bucket = 4
        } else if std.text.same(p.*.logicalGroup.?.*.logic, "physical") {
            bucket = 5
        } else {
            bucket = 6
        }
        if firsts[bucket] == 0 { firsts[bucket] = unique.items[index] }
        lasts[bucket] = unique.items[index]
        c.write(w, t.c4(m.idWithoutScope(p), " = ", s.decimal(count), ","))
        count += 1
        if p.*.name.length > maxLength { maxLength = p.*.name.length }
        index += 1
    }
    const num = count - first
    c.outdent(w)
    c.write(w, "};")
    c.newline(w)
    c.write(w, "// Enum value of the first \"real\" CSS property, which excludes")
    c.write(w, "// CSSPropertyInvalid and CSSPropertyCustom.")
    c.write(w, t.c3("constexpr uint16_t firstCSSProperty = ", s.decimal(first), ";"))
    c.write(w, "// Total number of enum values in the CSSPropertyID enum. If making an array")
    c.write(w, "// that can be indexed into using the enum value, use this as the size.")
    c.write(w, t.c3("constexpr uint16_t cssPropertyIDEnumValueCount = ", s.decimal(count), ";"))
    c.write(w, "// Number of \"real\" CSS properties. This differs from cssPropertyIDEnumValueCount,")
    c.write(w, "// as this doesn't consider CSSPropertyInvalid and CSSPropertyCustom.")
    c.write(w, t.c3("constexpr uint16_t numCSSProperties = ", s.decimal(num), ";"))
    c.write(w, t.c3("constexpr unsigned maxCSSPropertyNameLength = ", s.decimal(maxLength), ";"))
    const names = [_][]const u8{ "Shorthand", "TopPriority", "HighPriority", "MediumPriority", "LowPriority", "LogicalGroupPhysical", "LogicalGroupLogical" }
    const order = [_]usize{ 1, 2, 3, 4, 5, 6 }
    for which in order {
        c.write(w, t.c5("constexpr auto first", names[which], "Property = ", m.fullId(m.propertyOf(firsts[which])), ";"))
        c.write(w, t.c5("constexpr auto last", names[which], "Property = ", m.fullId(m.propertyOf(lasts[which])), ";"))
    }
    c.write(w, "constexpr auto firstLogicalGroupProperty = firstLogicalGroupPhysicalProperty;")
    c.write(w, "constexpr auto lastLogicalGroupProperty = lastLogicalGroupLogicalProperty;")
    c.write(w, t.c3("constexpr auto firstShorthandProperty = ", m.fullId(m.propertyOf(firsts[0])), ";"))
    c.write(w, t.c3("constexpr auto lastShorthandProperty = ", m.fullId(m.propertyOf(lasts[0])), ";"))
    c.write(w, "constexpr uint16_t numCSSPropertyLonghands = firstShorthandProperty - firstCSSProperty;")
    c.newline(w)
    c.write(w, t.c3("extern const std::array<CSSPropertyID, ", s.decimal(m.allComputed().count), "> computedPropertyIDs;"))
    c.newline(w)
    c.write(w, "template<CSSPropertyID C> struct PropertyNameConstant {")
    c.indent(w)
    c.write(w, "static constexpr auto value = C;")
    c.write(w, "constexpr bool operator==(const PropertyNameConstant&) const = default;")
    c.write(w, "constexpr bool operator==(CSSPropertyID other) const { return value == other; }")
    c.outdent(w)
    c.write(w, "};")
    c.newline(w)
}

fn propertySettings(w: *c.Writer) -> void {
    c.write(w, "struct CSSPropertySettings {")
    c.indent(w)
    c.write(w, "WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(CSSPropertySettings);")
    c.newline(w)
    const flags = m.settingsFlags()
    var index: usize = 0
    while index < flags.count {
        c.write(w, t.c3("bool ", flags.items[index], " : 1 { false };"))
        index += 1
    }
    c.newline(w)
    c.write(w, "CSSPropertySettings() = default;")
    c.write(w, "explicit CSSPropertySettings(const Settings&);")
    c.outdent(w)
    c.write(w, "};")
    c.newline(w)
    c.write(w, "bool operator==(const CSSPropertySettings&, const CSSPropertySettings&);")
    c.write(w, "void add(Hasher&, const CSSPropertySettings&);")
    c.newline(w)
}

pub fn namesHeader() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.pragmaOnce(w)
    x.includesOf(w, "", "<array> <wtf/HashFunctions.h> <wtf/HashTraits.h>")
    x.openNamespace(w, "WebCore")
    x.forwardDeclarations(w, t.list(), x.one("Settings"))
    propertyConstants(w)
    propertySettings(w)
    c.block(w, "            constexpr bool isLonghand(CSSPropertyID);
            bool isInternal(CSSPropertyID);
            bool isExposed(CSSPropertyID, const Settings*);
            bool isExposed(CSSPropertyID, const Settings&);
            bool isExposed(CSSPropertyID, const CSSPropertySettings*);
            bool isExposed(CSSPropertyID, const CSSPropertySettings&);

            CSSPropertyID findCSSProperty(const char* characters, unsigned length);
            ASCIILiteral nameLiteral(CSSPropertyID);
            const AtomString& nameString(CSSPropertyID);
            String nameForIDL(CSSPropertyID);

            CSSPropertyID cascadeAliasProperty(CSSPropertyID);

            template<CSSPropertyID first, CSSPropertyID last> struct CSSPropertiesRange {
                struct Iterator {
                    uint16_t index { static_cast<uint16_t>(first) };
                    constexpr CSSPropertyID operator*() const { return static_cast<CSSPropertyID>(index); }
                    constexpr Iterator& operator++() { ++index; return *this; }
                    constexpr bool operator==(std::nullptr_t) const { return index > static_cast<uint16_t>(last); }
                };
                static constexpr Iterator begin() { return { }; }
                static constexpr std::nullptr_t end() { return nullptr; }
                static constexpr uint16_t size() { return last - first + 1; }
            };
            using AllCSSPropertiesRange = CSSPropertiesRange<static_cast<CSSPropertyID>(firstCSSProperty), lastShorthandProperty>;
            using AllLonghandCSSPropertiesRange = CSSPropertiesRange<static_cast<CSSPropertyID>(firstCSSProperty), lastLogicalGroupProperty>;
            constexpr AllCSSPropertiesRange allCSSProperties() { return { }; }
            constexpr AllLonghandCSSPropertiesRange allLonghandCSSProperties() { return { }; }

            constexpr bool isLonghand(CSSPropertyID property)
            {
                return static_cast<uint16_t>(property) >= firstCSSProperty
                    && static_cast<uint16_t>(property) < static_cast<uint16_t>(firstShorthandProperty);
            }
            constexpr bool isShorthand(CSSPropertyID property)
            {
                return static_cast<uint16_t>(property) >= static_cast<uint16_t>(firstShorthandProperty)
                    && static_cast<uint16_t>(property) <= static_cast<uint16_t>(lastShorthandProperty);
            }

            constexpr bool isLogicalPropertyGroupProperty(CSSPropertyID property)
            {
                return static_cast<uint16_t>(property) >= static_cast<uint16_t>(firstLogicalGroupPhysicalProperty)
                    && static_cast<uint16_t>(property) <= static_cast<uint16_t>(lastLogicalGroupLogicalProperty);
            }

            constexpr bool isLogicalPropertyGroupPhysicalProperty(CSSPropertyID property)
            {
                return static_cast<uint16_t>(property) >= static_cast<uint16_t>(firstLogicalGroupPhysicalProperty)
                    && static_cast<uint16_t>(property) <= static_cast<uint16_t>(lastLogicalGroupPhysicalProperty);
            }

            constexpr bool isLogicalPropertyGroupLogicalProperty(CSSPropertyID property)
            {
                return static_cast<uint16_t>(property) >= static_cast<uint16_t>(firstLogicalGroupLogicalProperty)
                    && static_cast<uint16_t>(property) <= static_cast<uint16_t>(lastLogicalGroupLogicalProperty);
            }

            WTF::TextStream& operator<<(WTF::TextStream&, CSSPropertyID);
            ")
    x.closeNamespace(w, "WebCore")
    x.openNamespace(w, "WTF")
    c.block(w, "                template<> struct DefaultHash<WebCore::CSSPropertyID> : IntHash<unsigned> { };

                template<> struct HashTraits<WebCore::CSSPropertyID> : GenericHashTraits<WebCore::CSSPropertyID> {
                    static const bool emptyValueIsZero = true;
                    static void constructDeletedValue(WebCore::CSSPropertyID& slot) { slot = static_cast<WebCore::CSSPropertyID>(std::numeric_limits<uint16_t>::max()); }
                    static bool isDeletedValue(WebCore::CSSPropertyID value) { return static_cast<uint16_t>(value) == std::numeric_limits<uint16_t>::max(); }
                };
                ")
    x.closeNamespace(w, "WTF")
    x.openNamespace(w, "std")
    c.block(w, "                template<> struct iterator_traits<WebCore::AllCSSPropertiesRange::Iterator> { using value_type = WebCore::CSSPropertyID; };
                template<> struct iterator_traits<WebCore::AllLonghandCSSPropertiesRange::Iterator> { using value_type = WebCore::CSSPropertyID; };
                ")
    x.closeNamespace(w, "std")
    return c.written(w)
}

// ---------------------------------------------------------------------------
// CSSPropertyNames.gperf

fn gperfPrelude(w: *c.Writer) -> void {
    c.write(w, "%{")
    x.heading(w)
    x.cppRequiredIncludes(w, "CSSPropertyNames.h")
    x.includesOf(w, "BoxSides.h CSSParserContext.h CSSProperty.h CSSValueKeywords.h DeprecatedGlobalSettings.h Settings.h", "<string.h> <wtf/ASCIICType.h> <wtf/Hasher.h> <wtf/text/AtomString.h> <wtf/text/TextStream.h>")
    c.block(w, "
            IGNORE_WARNINGS_BEGIN(\"implicit-fallthrough\")
            WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN

            // Older versions of gperf like to use the `register` keyword.
            #define register
            ")
    x.openNamespace(w, "WebCore")
    c.block(w, "            static_assert(cssPropertyIDEnumValueCount <= (std::numeric_limits<uint16_t>::max() + 1), \"CSSPropertyID should fit into uint16_t.\");
            ")
    const computed = m.allComputed()
    c.write(w, t.c3("const std::array<CSSPropertyID, ", s.decimal(computed.count), "> computedPropertyIDs {"))
    c.indent(w)
    var index: usize = 0
    while index < computed.count {
        c.write(w, s.join(m.fullId(m.propertyAt(computed, index)), ","))
        index += 1
    }
    c.outdent(w)
    c.write(w, "};")
    c.newline(w)
    const unique = m.allUnique()
    c.write(w, t.c3("static constexpr std::array<StringImpl::StaticStringImpl, ", s.decimal(unique.count), "> propertyNameData = {{"))
    c.indent(w)
    index = 0
    while index < unique.count {
        c.write(w, t.c3("StringImpl::StaticStringImpl(\"", m.propertyAt(unique, index).*.name, "\", StringImpl::StringAtom),"))
        index += 1
    }
    c.outdent(w)
    c.write(w, "}};")
    c.newline(w)
    c.write(w, "%}")
}

fn gperfKeywords(w: *c.Writer) -> void {
    var entries = t.list()
    const unique = m.allUnique()
    var index: usize = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        const entry = t.c3(p.*.name, ", ", m.fullId(p))
        if !t.contains(entries, entry) { t.push(&entries, entry) }
        index += 1
    }
    const all = m.allPropertiesAndDescriptors()
    index = 0
    while index < all.count {
        const p = m.propertyAt(all, index)
        var at: usize = 0
        while at < p.*.aliases.count {
            const entry = t.c3(p.*.aliases.items[at], ", ", m.fullId(p))
            if !t.contains(entries, entry) { t.push(&entries, entry) }
            at += 1
        }
        index += 1
    }
    t.sort(&entries)
    c.write(w, "%%")
    index = 0
    while index < entries.count {
        c.write(w, entries.items[index])
        index += 1
    }
    c.write(w, "%%")
}

fn lookupFunctions(w: *c.Writer) -> void {
    c.block(w, "
            CSSPropertyID findCSSProperty(const char* characters, unsigned length)
            {
                auto* value = CSSPropertyNamesHash::in_word_set(characters, length);
                return value ? static_cast<CSSPropertyID>(value->id) : CSSPropertyID::CSSPropertyInvalid;
            }

            ASCIILiteral nameLiteral(CSSPropertyID id)
            {
                if (id < firstCSSProperty)
                    return { };
                unsigned index = id - firstCSSProperty;
                if (index >= numCSSProperties)
                    return { };
                return propertyNameData[index].literal();
            }

            const AtomString& nameString(CSSPropertyID id)
            {
                if (id < firstCSSProperty)
                    return nullAtom();
                unsigned index = id - firstCSSProperty;
                if (index >= numCSSProperties)
                    return nullAtom();

                static NeverDestroyed<std::array<AtomString, numCSSProperties>> atomStrings;
                auto& string = atomStrings.get()[index];
                if (string.isNull())
                    string = propertyNameData[index];
                return string;
            }

            String nameForIDL(CSSPropertyID id)
            {
                Latin1Character characters[maxCSSPropertyNameLength];
                const char* nameForCSS = nameLiteral(id);
                if (!nameForCSS)
                    return emptyString();

                auto* propertyNamePointer = nameForCSS;
                auto* nextCharacter = characters;
                while (char character = *propertyNamePointer++) {
                    if (character == '-') {
                        char nextCharacter = *propertyNamePointer++;
                        if (!nextCharacter)
                            break;
                        character = (propertyNamePointer - 2 != nameForCSS) ? toASCIIUpper(nextCharacter) : nextCharacter;
                    }
                    *nextCharacter++ = character;
                }
                return std::span<const Latin1Character> { characters, nextCharacter };
            }

            ")
}

// _generate_physical_logical_conversion_function.
fn conversionFunction(w: *c.Writer, signature: []const u8, source: []const u8, destination: []const u8, prefix: []const u8) -> void {
    const sourceId = g.nameToId(source)
    const destinationId = g.nameToId(destination)
    c.write(w, signature)
    c.write(w, "{")
    c.indent(w)
    c.write(w, "switch (id) {")
    const groups = m.sortedGroups()
    var index: usize = 0
    while index < groups.count {
        const group = m.groupAt(groups, index)
        const kindId = g.nameToId(group.*.kind)
        const destinations = m.resolvers(destination, group.*.kind)
        var properties = t.list()
        var at: usize = 0
        while at < destinations.count {
            t.push(&properties, m.fullId(m.groupProperty(group, destination, destinations.items[at])))
            at += 1
        }
        // The source's resolvers, sorted.
        var sourceResolvers = t.list()
        t.extend(&sourceResolvers, if std.text.same(source, "logical") { group.*.logicalResolvers } else { group.*.physicalResolvers })
        t.sort(&sourceResolvers)
        at = 0
        while at < sourceResolvers.count {
            const resolver = sourceResolvers.items[at]
            const p = m.groupProperty(group, source, resolver)
            const resolverEnum = t.c4(prefix, kindId, "::", g.nameToId(resolver))
            c.write(w, t.c3("case ", m.fullId(p), ": {"))
            c.indent(w)
            c.write(w, t.c5("static constexpr CSSPropertyID properties[", s.decimal(properties.count), "] = { ", t.joined(properties, ", "), " };"))
            c.write(w, t.c9("return properties[static_cast<size_t>(map", kindId, sourceId, "To", destinationId, "(writingMode, ", resolverEnum, "))];", ""))
            c.outdent(w)
            c.write(w, "}")
            at += 1
        }
        index += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return id;")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn settingsFlagMappings(l: g.Refs, suffix: []const u8) -> t.List {
    var result = t.list()
    var index: usize = 0
    while index < l.count {
        t.push(&result, t.c4("return settings.", m.cgText(m.propertyAt(l, index), "settings-flag"), suffix, ";"))
        index += 1
    }
    return result
}

fn isExposedFunctions(w: *c.Writer) -> void {
    const flagged = m.allUniqueWithSettingsFlag()
    x.switchFunction(w, "static bool isExposedNotInvalidAndNotInternal(CSSPropertyID id, const CSSPropertySettings& settings)", x.idsOf(flagged), settingsFlagMappings(flagged, ""), "return true;", "", "")
    x.switchFunction(w, "static bool isExposedNotInvalidAndNotInternal(CSSPropertyID id, const Settings& settings)", x.idsOf(flagged), settingsFlagMappings(flagged, "()"), "return true;", "", "")
    c.block(w, "            bool isExposed(CSSPropertyID id, const CSSPropertySettings* settings)
            {
                if (id == CSSPropertyID::CSSPropertyInvalid || isInternal(id))
                    return false;
                if (!settings)
                    return true;
                return isExposedNotInvalidAndNotInternal(id, *settings);
            }

            bool isExposed(CSSPropertyID id, const CSSPropertySettings& settings)
            {
                if (id == CSSPropertyID::CSSPropertyInvalid || isInternal(id))
                    return false;
                return isExposedNotInvalidAndNotInternal(id, settings);
            }

            bool isExposed(CSSPropertyID id, const Settings* settings)
            {
                if (id == CSSPropertyID::CSSPropertyInvalid || isInternal(id))
                    return false;
                if (!settings)
                    return true;
                return isExposedNotInvalidAndNotInternal(id, *settings);
            }

            bool isExposed(CSSPropertyID id, const Settings& settings)
            {
                if (id == CSSPropertyID::CSSPropertyInvalid || isInternal(id))
                    return false;
                return isExposedNotInvalidAndNotInternal(id, settings);
            }
        ")
}

fn isInheritedProperty(w: *c.Writer) -> void {
    c.write(w, "constexpr bool isInheritedPropertyTable[cssPropertyIDEnumValueCount] = {")
    c.indent(w)
    c.write(w, "false, // CSSPropertyID::CSSPropertyInvalid")
    c.write(w, "true , // CSSPropertyID::CSSPropertyCustom")
    const unique = m.allUnique()
    var index: usize = 0
    while index < unique.count {
        const p = m.propertyAt(unique, index)
        c.write(w, t.c3(if m.inherited(p) { "true " } else { "false" }, ", // ", m.fullId(p)))
        index += 1
    }
    c.outdent(w)
    c.write(w, "};")
    c.block(w, "
            bool CSSProperty::isInheritedProperty(CSSPropertyID id)
            {
                ASSERT(id < cssPropertyIDEnumValueCount);
                ASSERT(id != CSSPropertyID::CSSPropertyInvalid);
                return isInheritedPropertyTable[id];
            }
            ")
}

fn sameGroupDifferentLogic(w: *c.Writer) -> void {
    c.write(w, "bool CSSProperty::areInSameLogicalPropertyGroupWithDifferentMappingLogic(CSSPropertyID id1, CSSPropertyID id2)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "switch (id1) {")
    const groups = m.sortedGroups()
    var index: usize = 0
    while index < groups.count {
        const group = m.groupAt(groups, index)
        const logical = m.sorted(group.*.logical, m.compareName)
        const physical = m.sorted(group.*.physical, m.compareName)
        var round: usize = 0
        while round < 2 {
            const first = if round == 0 { logical } else { physical }
            const second = if round == 0 { physical } else { logical }
            var at: usize = 0
            while at < first.count {
                c.write(w, t.c3("case ", m.fullId(m.propertyAt(first, at)), ":"))
                at += 1
            }
            c.indent(w)
            c.write(w, "switch (id2) {")
            at = 0
            while at < second.count {
                c.write(w, t.c3("case ", m.fullId(m.propertyAt(second, at)), ":"))
                at += 1
            }
            c.indent(w)
            c.write(w, "return true;")
            c.outdent(w)
            c.write(w, "default:")
            c.indent(w)
            c.write(w, "return false;")
            c.outdent(w)
            c.write(w, "}")
            c.outdent(w)
            round += 1
        }
        index += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return false;")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn acceleratedClause(p: *m.Property) -> []const u8 {
    if std.text.same(m.cgText(p, "animation-wrapper-acceleration"), "threaded-only") { return "settings.threadedScrollDrivenAnimationsEnabled() || settings.threadedTimeBasedAnimationsEnabled()" }
    return "true"
}

fn hasAcceleration(p: *m.Property) -> bool {
    const value = m.cg(p, "animation-wrapper-acceleration")
    return value != null && value.?.*.kind != 0
}

fn animationPropertyFunctions(w: *c.Writer) -> void {
    x.switchFunctionBool(w, "bool CSSProperty::animationUsesNonAdditiveOrCumulativeInterpolation(CSSPropertyID id)", x.idsOf(x.withCg(m.styleAll, "animation-wrapper-requires-non-additive-or-cumulative-interpolation")))
    x.switchFunctionBool(w, "bool CSSProperty::animationUsesNonNormalizedDiscreteInterpolation(CSSPropertyID id)", x.idsOf(x.withCg(m.styleAll, "animation-wrapper-requires-non-normalized-discrete-interpolation")))
    const accelerated = x.withCg(m.styleAll, "animation-wrapper-acceleration")
    var mappings = t.list()
    var index: usize = 0
    while index < accelerated.count {
        t.push(&mappings, t.c3("return ", acceleratedClause(m.propertyAt(accelerated, index)), ";"))
        index += 1
    }
    x.switchFunction(w, "bool CSSProperty::animationIsAccelerated(CSSPropertyID id, [[maybe_unused]] const Settings& settings)", x.idsOf(accelerated), mappings, "return false;", "", "")
    c.write(w, "std::span<const CSSPropertyID> CSSProperty::allAcceleratedAnimationProperties([[maybe_unused]] const Settings& settings)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "static constexpr std::array propertiesExcludingThreadedOnly {")
    c.indent(w)
    var threaded = false
    index = 0
    while index < m.styleAll.count {
        const p = m.propertyAt(m.styleAll, index)
        index += 1
        if !hasAcceleration(p) { continue }
        if std.text.same(m.cgText(p, "animation-wrapper-acceleration"), "threaded-only") {
            threaded = true
            continue
        }
        c.write(w, s.join(m.fullId(p), ","))
    }
    c.outdent(w)
    c.write(w, "};")
    if threaded {
        c.write(w, "static constexpr std::array propertiesIncludingThreadedOnly {")
        c.indent(w)
        index = 0
        while index < m.styleAll.count {
            const p = m.propertyAt(m.styleAll, index)
            if hasAcceleration(p) { c.write(w, s.join(m.fullId(p), ",")) }
            index += 1
        }
        c.outdent(w)
        c.write(w, "};")
        c.write(w, "if (settings.threadedScrollDrivenAnimationsEnabled() || settings.threadedTimeBasedAnimationsEnabled())")
        c.indent(w)
        c.write(w, "return std::span<const CSSPropertyID> { propertiesIncludingThreadedOnly };")
        c.outdent(w)
    }
    c.write(w, "return std::span<const CSSPropertyID> { propertiesExcludingThreadedOnly };")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn settingsFunctions(w: *c.Writer) -> void {
    const flags = m.settingsFlags()
    c.write(w, "CSSPropertySettings::CSSPropertySettings(const Settings& settings)")
    c.indent(w)
    var index: usize = 0
    while index < flags.count {
        const flag = flags.items[index]
        c.write(w, t.c6(if index == 0 { ": " } else { ", " }, flag, " { settings.", flag, "() }", ""))
        index += 1
    }
    c.outdent(w)
    c.write(w, "{")
    c.write(w, "}")
    c.newline(w)
    c.write(w, "bool operator==(const CSSPropertySettings& a, const CSSPropertySettings& b)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, t.c5("return a.", flags.items[0], " == b.", flags.items[0], ""))
    c.indent(w)
    index = 1
    while index < flags.count {
        const flag = flags.items[index]
        c.write(w, t.c6("&& a.", flag, " == b.", flag, if index + 1 == flags.count { ";" } else { "" }, ""))
        index += 1
    }
    c.outdent(w)
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
    c.write(w, "void add(Hasher& hasher, const CSSPropertySettings& settings)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "add(hasher, WTF::packBools(")
    c.indent(w)
    index = 0
    while index < flags.count {
        c.write(w, t.c3("settings.", flags.items[index], if index + 1 == flags.count { "" } else { "," }))
        index += 1
    }
    c.outdent(w)
    c.write(w, "));")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn validKeywords(w: *c.Writer) -> void {
    // The properties with values, and the name of their arrays.
    var withValues = g.refs()
    var arrays = t.list()
    var index: usize = 0
    while index < m.styleAll.count {
        const p = m.propertyAt(m.styleAll, index)
        if p.*.hasValues && p.*.values.count > 0 {
            g.push(&withValues, m.styleAll.items[index])
            t.push(&arrays, t.c3("validKeywordsFor", m.nameForMethods(p), ""))
        }
        index += 1
    }
    var seen = t.list()
    index = 0
    while index < withValues.count {
        const p = m.propertyAt(withValues, index)
        const name = arrays.items[index]
        index += 1
        if t.contains(seen, name) { continue }
        t.push(&seen, name)
        c.write(w, t.c3("static constexpr std::array ", name, " {"))
        c.indent(w)
        var at: usize = 0
        while at < p.*.values.count {
            c.write(w, t.c3("CSSValueID::CSSValue", g.nameToId(m.valueAt(p.*.values, at).*.value), ","))
            at += 1
        }
        c.outdent(w)
        c.write(w, "};")
        c.newline(w)
    }
    c.write(w, "std::span<const CSSValueID> CSSProperty::validKeywordsForProperty(CSSPropertyID id)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "switch (id) {")
    index = 0
    while index < withValues.count {
        c.write(w, t.c3("case ", m.fullId(m.propertyAt(withValues, index)), ":"))
        c.indent(w)
        c.write(w, t.c3("return std::span<const CSSValueID> { ", arrays.items[index], " };"))
        c.outdent(w)
        index += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return { };")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
    index = 0
    while index < withValues.count {
        const p = m.propertyAt(withValues, index)
        index += 1
        if !anyFlagged(p) { continue }
        c.write(w, t.c3("static bool isKeywordValidFor", m.nameForMethods(p), "Values(CSSValueID keyword, const CSSParserContext& context)"))
        c.write(w, "{")
        c.indent(w)
        c.write(w, "switch (keyword) {")
        var unflagged: usize = 0
        var at: usize = 0
        while at < p.*.values.count {
            const value = m.valueAt(p.*.values, at)
            if value.*.settingsFlag.length == 0 {
                c.write(w, t.c3("case CSSValueID::CSSValue", g.nameToId(value.*.value), ":"))
                unflagged += 1
            }
            at += 1
        }
        if unflagged > 0 {
            c.indent(w)
            c.write(w, "return true;")
            c.outdent(w)
        }
        // By flag, in the order the flags come.
        var flags = t.list()
        at = 0
        while at < p.*.values.count {
            const flag = m.valueAt(p.*.values, at).*.settingsFlag
            if flag.length > 0 && !t.contains(flags, flag) { t.push(&flags, flag) }
            at += 1
        }
        var f: usize = 0
        while f < flags.count {
            const flag = flags.items[f]
            at = 0
            while at < p.*.values.count {
                const value = m.valueAt(p.*.values, at)
                if std.text.same(value.*.settingsFlag, flag) { c.write(w, t.c3("case CSSValueID::CSSValue", g.nameToId(value.*.value), ":")) }
                at += 1
            }
            c.indent(w)
            if s.contains(flag, "::") || s.contains(flag, "(") {
                c.write(w, t.c3("return ", flag, ";"))
            } else {
                c.write(w, t.c3("return context.", flag, ";"))
            }
            c.outdent(w)
            f += 1
        }
        c.write(w, "default:")
        c.indent(w)
        c.write(w, "return false;")
        c.outdent(w)
        c.write(w, "}")
        c.outdent(w)
        c.write(w, "}")
        c.newline(w)
    }
    c.write(w, "bool CSSProperty::isKeywordValidForPropertyValues(CSSPropertyID id, CSSValueID keyword, const CSSParserContext& context)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "switch (id) {")
    index = 0
    while index < withValues.count {
        const p = m.propertyAt(withValues, index)
        c.write(w, t.c3("case ", m.fullId(p), ":"))
        c.indent(w)
        if anyFlagged(p) {
            c.write(w, t.c3("return isKeywordValidFor", m.nameForMethods(p), "Values(keyword, context);"))
        } else {
            c.write(w, t.c5("return std::ranges::find(", arrays.items[index], ", keyword) != ", arrays.items[index], ".end();"))
        }
        c.outdent(w)
        index += 1
    }
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "return false;")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn anyFlagged(p: *m.Property) -> bool {
    var at: usize = 0
    while at < p.*.values.count {
        if m.valueAt(p.*.values, at).*.settingsFlag.length > 0 { return true }
        at += 1
    }
    return false
}

// _term_matches_number_or_integer.
fn matchesNumberOrInteger(term: *g.Term) -> bool {
    const kind = term.*.kind
    if kind == g.K_MATCH_ONE || kind == g.K_MATCH_ONE_OR_MORE_ANY_ORDER {
        var index: usize = 0
        while index < term.*.subterms.count {
            if matchesNumberOrInteger(g.termAt(term.*.subterms, index)) { return true }
            index += 1
        }
        return false
    }
    if kind == g.K_MATCH_ALL_ORDERED || kind == g.K_MATCH_ALL_ANY_ORDER {
        var any = false
        var index: usize = 0
        while index < term.*.subterms.count {
            const inner = g.termAt(term.*.subterms, index)
            if matchesNumberOrInteger(inner) {
                any = true
            } else if inner.*.kind != g.K_OPTIONAL {
                return false
            }
            index += 1
        }
        return any
    }
    if kind == g.K_OPTIONAL { return matchesNumberOrInteger(term.*.sub.?) }
    if kind == g.K_UNBOUNDED_REPETITION || kind == g.K_BOUNDED_REPETITION { return matchesNumberOrInteger(term.*.sub.?) && term.*.min < 2 }
    if kind == g.K_REFERENCE { return std.text.same(term.*.name, "number") || std.text.same(term.*.name, "integer") || std.text.same(term.*.name, "number-or-percentage-resolved-to-number") }
    return false
}

fn matchesNumberOrIntegerProperty(p: *m.Property) -> bool {
    if m.cgOn(p, "parser-function-allows-number-or-integer-input") { return true }
    if p.*.grammar == null { return false }
    return matchesNumberOrInteger(p.*.grammar.?.*.root)
}

pub fn namesGperf() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    gperfPrelude(w)
    c.block(w, "            %struct-type
            struct CSSPropertyHashTableEntry {
                const char* name;
                uint16_t id;
            };
            %language=C++
            %readonly-tables
            %global-table
            %7bit
            %compare-strncmp
            %define class-name CSSPropertyNamesHash
            %enum
            ")
    gperfKeywords(w)
    lookupFunctions(w)
    var internal = g.refs()
    const unique = m.allUnique()
    var index: usize = 0
    while index < unique.count {
        if m.cgOn(m.propertyAt(unique, index), "internal-only") { g.push(&internal, unique.items[index]) }
        index += 1
    }
    x.switchFunctionBool(w, "bool isInternal(CSSPropertyID id)", x.idsOf(internal))
    isExposedFunctions(w)
    isInheritedProperty(w)
    const aliased = x.withCg(m.styleAll, "cascade-alias")
    var mappings = t.list()
    index = 0
    while index < aliased.count {
        t.push(&mappings, t.c3("return ", m.fullId(m.propertyAt(aliased, index).*.cascadeAlias.?), ";"))
        index += 1
    }
    x.switchFunction(w, "CSSPropertyID cascadeAliasProperty(CSSPropertyID id)", x.idsOf(aliased), mappings, "return id;", "", "")
    const withAliases = x.withCg(m.styleAll, "aliases")
    mappings = t.list()
    index = 0
    while index < withAliases.count {
        t.push(&mappings, t.c3("return { ", t.joined(x.quoteList(m.propertyAt(withAliases, index).*.aliases, "\"", "_s"), ", "), " };"))
        index += 1
    }
    x.switchFunction(w, "Vector<String> CSSProperty::aliasesForProperty(CSSPropertyID id)", x.idsOf(withAliases), mappings, "return { };", "", "")
    x.bitSet(w, "CSSProperty::colorProperties", x.idsOf(x.withCg(m.styleAll, "color-property")))
    // The physical properties of the groups, unique, sorted by ID.
    var physical = g.refs()
    const groups = m.sortedGroups()
    index = 0
    while index < groups.count {
        const group = m.groupAt(groups, index)
        const destinations = m.resolvers("physical", group.*.kind)
        var at: usize = 0
        while at < destinations.count {
            const p = m.groupProperty(group, "physical", destinations.items[at])
            if !g.has(physical, @intFromPtr(p)) { g.push(&physical, @intFromPtr(p)) }
            at += 1
        }
        index += 1
    }
    x.bitSet(w, "CSSProperty::physicalProperties", x.idsOf(m.sorted(physical, m.compareId)))
    const separated = x.withCg(m.styleAll, "separator")
    mappings = t.list()
    index = 0
    while index < separated.count {
        t.push(&mappings, t.c3("return '", m.cgText(m.propertyAt(separated, index), "separator")[0..1], "';"))
        index += 1
    }
    x.switchFunction(w, "char16_t CSSProperty::listValuedPropertySeparator(CSSPropertyID id)", x.idsOf(separated), mappings, "break;", "", "return '\\0';")
    var numeric = g.refs()
    index = 0
    while index < m.styleAll.count {
        if matchesNumberOrIntegerProperty(m.propertyAt(m.styleAll, index)) { g.push(&numeric, m.styleAll.items[index]) }
        index += 1
    }
    x.switchFunctionBool(w, "bool CSSProperty::allowsNumberOrIntegerInput(CSSPropertyID id)", x.idsOf(numeric))
    x.switchFunctionBool(w, "bool CSSProperty::disablesNativeAppearance(CSSPropertyID id)", x.idsOf(x.withCg(m.styleAll, "disables-native-appearance")))
    index = 0
    while index < groups.count {
        const group = m.groupAt(groups, index)
        var members = g.refs()
        var round: usize = 0
        while round < 2 {
            const properties = if round == 0 { group.*.logical } else { group.*.physical }
            var at: usize = 0
            while at < properties.count {
                const p = m.propertyAt(properties, at)
                if !g.has(members, @intFromPtr(p)) { g.push(&members, @intFromPtr(p)) }
                const shorthand = m.shorthandOf(p)
                if shorthand != null && !g.has(members, @intFromPtr(shorthand.?)) { g.push(&members, @intFromPtr(shorthand.?)) }
                at += 1
            }
            round += 1
        }
        x.switchFunctionBool(w, t.c3("bool CSSProperty::is", g.nameToId(group.*.name), "Property(CSSPropertyID id)"), x.idsOf(m.sorted(members, m.compareName)))
        index += 1
    }
    x.switchFunctionBool(w, "bool CSSProperty::isInLogicalPropertyGroup(CSSPropertyID id)", x.idsOf(m.allInLogicalPropertyGroup()))
    sameGroupDifferentLogic(w)
    conversionFunction(w, "CSSPropertyID CSSProperty::resolveDirectionAwareProperty(CSSPropertyID id, WritingMode writingMode)", "logical", "physical", "LogicalBox")
    conversionFunction(w, "CSSPropertyID CSSProperty::unresolvePhysicalProperty(CSSPropertyID id, WritingMode writingMode)", "physical", "logical", "Box")
    x.switchFunctionBool(w, "bool CSSProperty::isDescriptorOnly(CSSPropertyID id)", x.idsOf(m.allDescriptorOnly()))
    x.switchFunctionBool(w, "bool CSSProperty::acceptsQuirkyColor(CSSPropertyID id)", x.idsOf(x.withCg(m.styleAll, "accepts-quirky-color")))
    x.switchFunctionBool(w, "bool CSSProperty::acceptsQuirkyLength(CSSPropertyID id)", x.idsOf(x.withCg(m.styleAll, "accepts-quirky-length")))
    x.switchFunctionBool(w, "bool CSSProperty::acceptsQuirkyAngle(CSSPropertyID id)", x.idsOf(x.withCg(m.styleAll, "accepts-quirky-angle")))
    animationPropertyFunctions(w)
    settingsFunctions(w)
    c.block(w, "
            TextStream& operator<<(TextStream& stream, CSSPropertyID property)
            {
                return stream << nameLiteral(property);
            }
            ")
    validKeywords(w)
    x.closeNamespace(w, "WebCore")
    c.write(w, "WTF_ALLOW_UNSAFE_BUFFER_USAGE_END")
    c.write(w, "IGNORE_WARNINGS_END")
    return c.written(w)
}

// ---------------------------------------------------------------------------
// CSSStyleProperties+PropertyNames.idl

fn idlAttribute(name: []const u8, lowercaseFirst: bool) -> []const u8 {
    var b = c.buf()
    var upperNext = false
    var index: usize = if lowercaseFirst { 1 } else { 0 }
    while index < name.length {
        const byte = name[index]
        if byte == 45 {
            upperNext = true
        } else if upperNext {
            upperNext = false
            c.addByte(&b, c.upperByte(byte))
        } else {
            c.addByte(&b, byte)
        }
        index += 1
    }
    return c.contents(&b)
}

// SECTION: 0 camel-cased, 1 webkit-cased, 2 dashed, 3 epub-cased.
fn idlSection(w: *c.Writer, comment: []const u8, names: t.List, properties: g.Refs, section: usize) -> void {
    c.block(w, comment)
    const variants = [_][]const u8{ "CamelCased", "WebKitCased", "Dashed", "EpubCased" }
    var index: usize = 0
    while index < names.count {
        const name = names.items[index]
        const p = m.propertyAt(properties, index)
        index += 1
        if section == 1 && !s.startsWith(name, "-webkit-") { continue }
        if section == 2 && !s.contains(name, "-") { continue }
        if section == 3 && !s.startsWith(name, "-epub-") { continue }
        const attribute = if section == 2 { name } else { idlAttribute(name, section != 0) }
        var extended = t.list()
        t.push(&extended, t.c3("DelegateToSharedSyntheticAttribute=propertyValueFor", variants[section], "IDLAttribute"))
        t.push(&extended, "CallWith=PropertyName")
        if m.cgOn(p, "settings-flag") { t.push(&extended, s.join("EnabledBySetting=", m.cgText(p, "settings-flag"))) }
        c.write(w, t.c5("[CEReactions=Needed, ", t.joined(extended, ", "), "] attribute [LegacyNullToEmptyString] CSSOMString ", attribute, ";"))
    }
}

pub fn propertyNamesIdl() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    // Names and aliases to their properties (a later one replacing), sorted.
    var names = t.list()
    var properties = g.refs()
    const all = m.allNonInternalOnly()
    var index: usize = 0
    while index < all.count {
        const p = m.propertyAt(all, index)
        var at: usize = 0
        while at <= p.*.aliases.count {
            const name = if at == 0 { p.*.name } else { p.*.aliases.items[at - 1] }
            var k: usize = 0
            var found = false
            while k < names.count {
                if std.text.same(names.items[k], name) {
                    properties.items[k] = @intFromPtr(p)
                    found = true
                }
                k += 1
            }
            if !found {
                t.push(&names, name)
                g.push(&properties, @intFromPtr(p))
            }
            at += 1
        }
        index += 1
    }
    // Sorted by name, the properties alongside.
    index = 1
    while index < names.count {
        const name = names.items[index]
        const p = properties.items[index]
        var at = index
        while at > 0 && t.before(name, names.items[at - 1]) {
            names.items[at] = names.items[at - 1]
            properties.items[at] = properties.items[at - 1]
            at -= 1
        }
        names.items[at] = name
        properties.items[at] = p
        index += 1
    }
    c.block(w, "            typedef USVString CSSOMString;
            ")
    c.write(w, "partial interface CSSStyleProperties {")
    c.indent(w)
    idlSection(w, "                        // For each CSS property property that is a supported CSS property, the following
                        // partial interface applies where camel-cased attribute is obtained by running the
                        // CSS property to IDL attribute algorithm for property.
                        // Example: font-size -> element.style.fontSize
                        // Example: -webkit-transform -> element.style.WebkitTransform
                        // [CEReactions] attribute [LegacyNullToEmptyString] CSSOMString _camel_cased_attribute;
                        ", names, properties, 0)
    idlSection(w, "
                        // For each CSS property property that is a supported CSS property and that begins
                        // with the string -webkit-, the following partial interface applies where webkit-cased
                        // attribute is obtained by running the CSS property to IDL attribute algorithm for
                        // property, with the lowercase first flag set.
                        // Example: -webkit-transform -> element.style.webkitTransform
                        // [CEReactions] attribute [LegacyNullToEmptyString] CSSOMString _webkit_cased_attribute;
                        ", names, properties, 1)
    idlSection(w, "
                        // For each CSS property property that is a supported CSS property, except for
                        // properties that have no \"-\" (U+002D) in the property name, the following partial
                        // interface applies where dashed attribute is property.
                        // Example: font-size -> element.style['font-size']
                        // Example: -webkit-transform -> element.style.['-webkit-transform']
                        // [CEReactions] attribute [LegacyNullToEmptyString] CSSOMString _dashed_attribute;
                        ", names, properties, 2)
    idlSection(w, "
                        // Non-standard. Special case properties starting with -epub- like is done for
                        // -webkit-, where attribute is obtained by running the CSS property to IDL attribute
                        // algorithm for property, with the lowercase first flag set.
                        // Example: -epub-caption-side -> element.style.epubCaptionSide
                        ", names, properties, 3)
    c.outdent(w)
    c.write(w, "};")
    return c.written(w)
}
