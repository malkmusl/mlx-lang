// JavaScriptCore's bytecode headers, made as WebKit's generator/main.rb
// (Ruby) makes them, from bytecode/BytecodeList.rb:
//
//     webkit-bytecodes --bytecodes_h FILE --bytecode_structs_h FILE
//         --init_bytecodes_asm FILE --bytecode_indices_h FILE
//         --wasm_json FILE --bytecode_dumper FILE BYTECODE-LIST
//
// (-b, -s, -a and -i stand for the first four.) BYTECODE-LIST names the
// opcodes in sections (bytecodelist.mlx reads it); each opcode has
// operands ("args"), may have metadata (a struct the code block keeps
// for it), temporaries and checkpoints. The outputs:
//
//   Bytecodes.h        each section's opcodes and lengths as macros, the
//                      checkpoint counts and metadata sizes, the opcode
//                      numbers as strings
//   BytecodeStructs.h  a struct per bytecode: its emitters, dumper,
//                      decoders, operand setters, metadata and fields
//   InitBytecodes.asm  the LLInt's entry address of every opcode, narrow,
//                      wide16 and wide32
//   BytecodeIndices.h  the index of every operand in its bytecode
//   BytecodeDumperGenerated.cpp  dumpBytecode, a case per bytecode
//
// Each starts with Apple's license (of this year, as Ruby's Date.today
// has it) and ends with the SHA-1 of the list. The wasm.json file is
// read, as main.rb reads it, but the list asks nothing of it. The text
// is the Ruby's to the byte.
const std = @import("std")
const sha1 = @import("std.sha1")
const s = @import("./support.mlx")
const list = @import("./bytecodelist.mlx")

const NONE: usize = 18446744073709551615
const SYS_time: usize = 201

// ---------------------------------------------------------------------------
// Output: one file's text at a time.

const BUFFER_SIZE: usize = 268435456
var bufferBase: usize = 0
var bufferTop: usize = 0

fn out(text: []const u8) -> void {
    if bufferBase == 0 { bufferBase = s.alloc(BUFFER_SIZE) }
    if bufferTop + text.length > BUFFER_SIZE { s.fail("the output is too large") }
    var index: usize = 0
    while index < text.length {
        s.put8(bufferBase + bufferTop + index, text[index])
        index += 1
    }
    bufferTop += text.length
}

fn outNumber(value: usize) -> void { out(s.decimal(@intCast(u64, value))) }

// ---------------------------------------------------------------------------
// GeneratedFile.rb: the license, the text, the hash of the list.

const LICENSE_LINES: usize = 22
// The year, as text (module variables cannot be slices).
var yearText: [*]const u8 = undefined
var yearLength: usize = 0

fn licenseLine(index: usize) -> []const u8 {
    if index == 0 { return s.join3("Copyright (C) ", yearText[0..yearLength], " Apple Inc. All rights reserved.") }
    if index == 1 { return "" }
    if index == 2 { return "Redistribution and use in source and binary forms, with or without" }
    if index == 3 { return "modification, are permitted provided that the following conditions" }
    if index == 4 { return "are met:" }
    if index == 5 { return "" }
    if index == 6 { return "1.  Redistributions of source code must retain the above copyright" }
    if index == 7 { return "    notice, this list of conditions and the following disclaimer." }
    if index == 8 { return "2.  Redistributions in binary form must reproduce the above copyright" }
    if index == 9 { return "    notice, this list of conditions and the following disclaimer in the" }
    if index == 10 { return "    documentation and/or other materials provided with the distribution." }
    if index == 11 { return "" }
    if index == 12 { return "THIS SOFTWARE IS PROVIDED BY APPLE AND ITS CONTRIBUTORS \"AS IS\" AND ANY" }
    if index == 13 { return "EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED" }
    if index == 14 { return "WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE" }
    if index == 15 { return "DISCLAIMED. IN NO EVENT SHALL APPLE OR ITS CONTRIBUTORS BE LIABLE FOR ANY" }
    if index == 16 { return "DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES" }
    if index == 17 { return "(INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;" }
    if index == 18 { return "LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND" }
    if index == 19 { return "ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT" }
    if index == 20 { return "(INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF" }
    return "THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE."
}

// The year now (in universal time), from days since 1970.
fn currentYear() -> []const u8 {
    const now = std.linux.syscall1(SYS_time, 0)
    var days = @intCast(i64, now) / 86400
    // Civil from days (Howard Hinnant's algorithm).
    days += 719468
    const era = days / 146097
    const dayOfEra = days - era * 146097
    const yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    const dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    const monthIndex = (5 * dayOfYear + 2) / 153
    var result = yearOfEra + era * 400
    if monthIndex >= 10 { result += 1 }
    return s.signedDecimal(result)
}

var listHash: [*]const u8 = undefined

fn hexOf(digest: *[20]u8) -> []const u8 {
    const digits = "0123456789abcdef"
    const at = s.alloc(41)
    var index: usize = 0
    while index < 20 {
        s.put8(at + 2 * index, digits[@intCast(usize, digest.*[index] >> 4)])
        s.put8(at + 2 * index + 1, digits[@intCast(usize, digest.*[index] & 15)])
        index += 1
    }
    s.put8(at + 40, 0)
    return s.bytes(at, 40)
}

// The start of a file: the license in a C comment, or in lines of
// "#" comments (ASSEMBLY).
fn beginFile(assembly: bool) -> void {
    bufferTop = 0
    const comment = if assembly { "#" } else { " *" }
    if !assembly { out("/*\n") }
    var index: usize = 0
    while index < LICENSE_LINES {
        if index > 0 { out("\n") }
        out(comment)
        out(" ")
        out(licenseLine(index))
        index += 1
    }
    out("\n\n")
    out(comment)
    out(" Autogenerated by generator/main.rb, do not modify.\n")
    if !assembly { out("*/\n") }
    out("\n")
}

fn endFile(assembly: bool, path: []const u8) -> void {
    out(if assembly { "#" } else { "// " })
    out(" SHA1Hash: ")
    out(listHash[0..40])
    out("\n")
    s.writeWhole(path, s.bytes(bufferBase, bufferTop))
}

// ---------------------------------------------------------------------------
// Opcode.rb, Argument.rb, Metadata.rb.

fn opcodeName(op: usize) -> []const u8 { return list.opcodeName(op) }

fn isWasm(op: usize) -> bool { return std.text.same(list.section(list.opcode(op).section).name, "Wasm") }
fn opcodeIDType(op: usize) -> []const u8 { return if isWasm(op) { "WasmOpcodeID" } else { "OpcodeID" } }
fn wide16(op: usize) -> []const u8 { return if isWasm(op) { "wasm_wide16" } else { "op_wide16" } }
fn wide32(op: usize) -> []const u8 { return if isWasm(op) { "wasm_wide32" } else { "op_wide32" } }
fn traits(op: usize) -> []const u8 { return if isWasm(op) { "WasmOpcodeTraits" } else { "JSOpcodeTraits" } }
fn typePrefix(op: usize) -> []const u8 { return if isWasm(op) { "Wasm" } else { "JS" } }

fn hasMetadata(op: usize) -> bool { return list.opcode(op).metadata != NONE }

fn argCount(op: usize) -> usize {
    const args = list.opcode(op).args
    return if args == NONE { 0 } else { list.value(args).count }
}

// An operand's name: its key, without the "?" of an optional one.
fn argName(op: usize, index: usize) -> []const u8 {
    const key = list.value(list.item(list.opcode(op).args, index)).key
    if key.length > 0 && key[key.length - 1] == 63 { return key[0..key.length - 1] }
    return key
}

fn argType(op: usize, index: usize) -> []const u8 { return list.text(list.item(list.opcode(op).args, index)) }

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }
fn upper(byte: u8) -> u8 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }

// Opcode#capitalized_name: each part between underscores capitalized
// (the rest lower case); a part starting with digits has its first
// letter after them capital.
fn capitalizedName(op: usize) -> []const u8 {
    const name = opcodeName(op)
    const at = s.alloc(name.length + 1)
    var length: usize = 0
    var start: usize = 0
    while start < name.length {
        var end = start
        while end < name.length && name[end] != 95 { end += 1 }
        var digits = start
        while digits < end && std.ascii.isDigit(name[digits]) { digits += 1 }
        var index = start
        while index < end {
            const byte = name[index]
            s.put8(at + length, if index == digits { upper(byte) } else if index == start { upper(byte) } else { lower(byte) })
            length += 1
            index += 1
        }
        start = end + 1
    }
    return s.bytes(at, length)
}

// Argument#capitalized_name: the first letter of each word capital.
fn argCapitalizedName(name: []const u8) -> []const u8 {
    const at = s.alloc(name.length + 1)
    var length: usize = 0
    var start = true
    for byte in name {
        if byte == 95 {
            start = true
        } else {
            s.put8(at + length, if start { upper(byte) } else { byte })
            length += 1
            start = false
        }
    }
    return s.bytes(at, length)
}

fn opcodeLength(op: usize) -> usize { return argCount(op) + if hasMetadata(op) { 1 } else { 0 } }

// ", Type name" for each operand (TYPED), ", Type& name" (REFERENCE), or
// ", name".
fn outArgs(op: usize, typed: bool, reference: bool) -> void {
    var index: usize = 0
    while index < argCount(op) {
        out(", ")
        if typed {
            out(argType(op, index))
            out(if reference { "& " } else { " " })
        }
        out(argName(op, index))
        index += 1
    }
}

fn outTypedArgs(op: usize) -> void { outArgs(op, true, false) }
fn outUntypedArgs(op: usize) -> void { outArgs(op, false, false) }

fn outMetadataParam(op: usize) -> void { if hasMetadata(op) { out(", unsigned __metadataID") } }
fn outMetadataArg(op: usize) -> void { if hasMetadata(op) { out(", __metadataID") } }

fn outCreateEmitterLocal(op: usize) -> void {
    if hasMetadata(op) { out("\n        auto __metadataID = gen->addMetadataFor(opcodeID);") }
}

fn fitsCheck(typeName: []const u8, size: []const u8, name: []const u8) -> []const u8 {
    return s.join(s.join3("Fits<", typeName, ", "), s.join(size, s.join3(">::check(", name, ")")))
}

fn fitsConvert(typeName: []const u8, size: []const u8, name: []const u8) -> []const u8 {
    return s.join(s.join3("Fits<", typeName, ", "), s.join(size, s.join3(">::convert(", name, ")")))
}

fn outEmitter(op: usize) -> void {
    out("    template<typename BytecodeGenerator>\n    static void emit(BytecodeGenerator* gen")
    outTypedArgs(op)
    out(")\n    {\n        emitWithSmallestSizeRequirement<OpcodeSize::Narrow, BytecodeGenerator>(gen")
    outUntypedArgs(op)
    out(");\n    }\n")
    if hasMetadata(op) {
        out("\n    template<OpcodeSize __size, typename BytecodeGenerator, FitsAssertion shouldAssert = Assert>\n    static bool emit(BytecodeGenerator* gen")
        outTypedArgs(op)
        out(")\n    {")
        outCreateEmitterLocal(op)
        out("\n        return emit<__size, BytecodeGenerator, shouldAssert>(gen")
        outUntypedArgs(op)
        outMetadataArg(op)
        out(");\n    }\n\n    template<OpcodeSize __size, typename BytecodeGenerator>\n    static bool checkWithoutMetadataID(BytecodeGenerator* gen")
        outTypedArgs(op)
        out(")\n    {\n        decltype(gen->addMetadataFor(opcodeID)) __metadataID { };\n        return checkImpl<__size, BytecodeGenerator>(gen")
        outUntypedArgs(op)
        outMetadataArg(op)
        out(");\n    }\n")
    }
    out("\n    template<OpcodeSize __size, typename BytecodeGenerator, FitsAssertion shouldAssert = Assert, bool recordOpcode = true>\n    static bool emit(BytecodeGenerator* gen")
    outTypedArgs(op)
    outMetadataParam(op)
    out(")\n    {\n        bool didEmit = emitImpl<__size, recordOpcode, BytecodeGenerator>(gen")
    outUntypedArgs(op)
    outMetadataArg(op)
    out(");\n        if (shouldAssert == Assert)\n            ASSERT(didEmit);\n        return didEmit;\n    }\n\n")
    out("    template<OpcodeSize __size, typename BytecodeGenerator>\n    static void emitWithSmallestSizeRequirement(BytecodeGenerator* gen")
    outTypedArgs(op)
    out(")\n    {\n        ")
    outCreateEmitterLocal(op)
    const sizes = [3][]const u8{ "Narrow", "Wide16", "Wide32" }
    var index: usize = 0
    while index < 2 {
        out("\n        if (static_cast<unsigned>(__size) <= static_cast<unsigned>(OpcodeSize::")
        out(sizes[index])
        out(")) {\n            if (emit<OpcodeSize::")
        out(sizes[index])
        out(", BytecodeGenerator, NoAssert, true>(gen")
        outUntypedArgs(op)
        outMetadataArg(op)
        out("))\n                return;\n        }")
        index += 1
    }
    out("\n        emit<OpcodeSize::Wide32, BytecodeGenerator, Assert, true>(gen")
    outUntypedArgs(op)
    outMetadataArg(op)
    out(");\n    }\n\nprivate:\n")
    out("    template<OpcodeSize __size, typename BytecodeGenerator>\n    static bool checkImpl(BytecodeGenerator* gen")
    outArgs(op, true, true)
    outMetadataParam(op)
    out(")\n    {\n        UNUSED_PARAM(gen);\n        return ")
    const idType = opcodeIDType(op)
    out(fitsCheck(idType, "__size", "opcodeID"))
    index = 0
    while index < argCount(op) {
        out("\n            && ")
        out(fitsCheck(argType(op, index), "__size", argName(op, index)))
        index += 1
    }
    if hasMetadata(op) {
        out("\n            && ")
        out(fitsCheck("unsigned", "__size", "__metadataID"))
    }
    out("\n            && (__size == OpcodeSize::Narrow ? ")
    out(fitsCheck(idType, "OpcodeSize::Narrow", "opcodeID"))
    out(" : ")
    out(fitsCheck(idType, "OpcodeSize::Wide16", "opcodeID"))
    out(")\n            && (__size == OpcodeSize::Wide16 ? ")
    out(fitsCheck(idType, "OpcodeSize::Narrow", wide16(op)))
    out(" : true)\n            && (__size == OpcodeSize::Wide32 ? ")
    out(fitsCheck(idType, "OpcodeSize::Narrow", wide32(op)))
    out(" : true);\n    }\n\n")
    out("    template<OpcodeSize __size, bool recordOpcode, typename BytecodeGenerator>\n    static bool emitImpl(BytecodeGenerator* gen")
    outTypedArgs(op)
    outMetadataParam(op)
    out(")\n    {\n        ")
    if list.opcode(op).checkpoints != NONE { out("gen->setUsesCheckpoints();") }
    out("\n        if (__size == OpcodeSize::Wide16)\n            gen->alignWideOpcode16();\n        else if (__size == OpcodeSize::Wide32)\n            gen->alignWideOpcode32();\n        if (checkImpl<__size>(gen")
    outUntypedArgs(op)
    outMetadataArg(op)
    out(")) {\n            if (recordOpcode)\n                gen->recordOpcode(opcodeID);\n")
    out("            gen->template writeOpcode<__size>(opcodeID")
    outUntypedArgs(op)
    outMetadataArg(op)
    out(");\n            return true;\n        }\n        return false;\n    }\n\npublic:")
}

fn outDumper(op: usize) -> void {
    const prefix = typePrefix(op)
    out("    void dump(BytecodeDumperBase<")
    out(prefix)
    out("InstructionStream>* dumper, ")
    out(prefix)
    out("InstructionStream::Offset __location, int __sizeShiftAmount)\n    {\n        dumper->printLocationAndOp(__location, &\"**")
    out(list.opcode(op).name)
    out("\"[2 - __sizeShiftAmount]);\n")
    var index: usize = 0
    while index < argCount(op) {
        if index > 0 { out("\n") }
        out("        dumper->dumpOperand(\"")
        out(argName(op, index))
        out("\", m_")
        out(argName(op, index))
        out(if index == 0 { ", true);" } else { ", false);" })
        index += 1
    }
    out("\n    }\n")
}

// ": m_a(...)\n        , m_b(...)" loading the fields from the stream.
fn outInit(op: usize, size: []const u8) -> void {
    const count = argCount(op)
    if count == 0 && !hasMetadata(op) { return }
    out(": ")
    var index: usize = 0
    while index < count {
        if index > 0 { out("\n        , ") }
        out("m_")
        out(argName(op, index))
        out("(")
        out(fitsConvert(argType(op, index), size, s.join3("stream[", s.decimal(@intCast(u64, index)), "]")))
        out(")")
        index += 1
    }
    if hasMetadata(op) {
        if index > 0 { out("\n        , ") }
        out("m_metadataID(")
        out(fitsConvert("unsigned", size, s.join3("stream[", s.decimal(@intCast(u64, index)), "]")))
        out(")")
    }
}

fn outConstructor(op: usize, name: []const u8, stream: []const u8, size: []const u8) -> void {
    out("    ")
    out(name)
    out("(const ")
    out(stream)
    out("* stream)\n        ")
    outInit(op, s.join("OpcodeSize::", size))
    out("\n    {\n        ASSERT_UNUSED(stream, static_cast<")
    out(opcodeIDType(op))
    out(">(std::bit_cast<const typename OpcodeIDWidthBySize<")
    out(typePrefix(op))
    out("OpcodeTraits, OpcodeSize::")
    out(size)
    out(">::opcodeType*>(stream)[-1]) == opcodeID);\n    }\n")
}

fn outConstructors(op: usize) -> void {
    const name = capitalizedName(op)
    const prefix = typePrefix(op)
    outConstructor(op, name, "uint8_t", "Narrow")
    out("\n")
    outConstructor(op, name, "uint16_t", "Wide16")
    out("\n\n")
    outConstructor(op, name, "uint32_t", "Wide32")
    out("\n    static ")
    out(name)
    out(" decode(const uint8_t* stream)\n    {\n        // A pointer is pointing to the first operand (opcode and prefix are not included).\n        if (*stream == ")
    out(wide32(op))
    out(")\n            return { std::bit_cast<const uint32_t*>(stream + /* prefix */ 1 + OpcodeIDWidthBySize<")
    out(prefix)
    out("OpcodeTraits, OpcodeSize::Wide32>::opcodeIDSize) };\n        if (*stream == ")
    out(wide16(op))
    out(")\n            return { std::bit_cast<const uint16_t*>(stream + /* prefix */ 1 + OpcodeIDWidthBySize<")
    out(prefix)
    out("OpcodeTraits, OpcodeSize::Wide16>::opcodeIDSize) };\n        return { stream + OpcodeIDWidthBySize<")
    out(prefix)
    out("OpcodeTraits, OpcodeSize::Narrow>::opcodeIDSize };\n    }\n")
}

fn outSetter(op: usize, index: usize) -> void {
    const name = argCapitalizedName(argName(op, index))
    const typeName = argType(op, index)
    out("    template<typename Functor>\n    void set")
    out(name)
    out("(")
    out(typeName)
    out(" value, Functor func)\n    {\n        if (isWide32())\n            set")
    out(name)
    out("<OpcodeSize::Wide32>(value, func);\n        else if (isWide16())\n            set")
    out(name)
    out("<OpcodeSize::Wide16>(value, func);\n        else\n            set")
    out(name)
    out("<OpcodeSize::Narrow>(value, func);\n    }\n\n    template <OpcodeSize size, typename Functor>\n    void set")
    out(name)
    out("(")
    out(typeName)
    out(" value, Functor func)\n    {\n        if (!")
    out(fitsCheck(typeName, "size", "value"))
    out(")\n            value = func();\n        auto* stream = std::bit_cast<typename TypeBySize<size>::unsignedType*>(reinterpret_cast<uint8_t*>(this) + ")
    outNumber(index)
    out(" * size + PaddingBySize<size>::value + OpcodeIDWidthBySize<")
    out(traits(op))
    out(", size>::opcodeIDSize);\n        *stream = ")
    out(fitsConvert(typeName, "size", "value"))
    out(";\n    }\n")
}

fn outSetters(op: usize) -> void {
    var index: usize = 0
    while index < argCount(op) {
        if index > 0 { out("\n") }
        outSetter(op, index)
        index += 1
    }
}

// The fields of FIELDS (a hash), unions for the hashes in it; their
// names (outside the unions too) go to NAMES.
fn outMetadataFields(prefix: []const u8, fields: usize, names: [*][]const u8, count: *usize) -> void {
    var index: usize = 0
    while index < list.value(fields).count {
        if index > 0 { out("\n") }
        const field = list.item(fields, index)
        const v = list.value(field)
        if v.kind == list.HASH {
            out(prefix)
            out("union {\n")
            outMetadataFields(s.join(prefix, "    "), field, names, count)
            out("\n")
            out(prefix)
            out("};")
        } else {
            names[count.*] = v.key
            count.* += 1
            out(prefix)
            out(list.text(field))
            out(" m_")
            out(v.key)
            out(";")
        }
        index += 1
    }
}

fn outMetadataStruct(op: usize) -> void {
    const opcode = list.opcode(op)
    if opcode.metadata == NONE { return }
    const inits = opcode.initializers != NONE && list.value(opcode.initializers).count > 0
    out("\n    struct Metadata {\n        WTF_MAKE_NONCOPYABLE(Metadata);\n\n    public:\n        ")
    out("static constexpr ")
    out(opcodeIDType(op))
    out(" opcodeID = ")
    out(opcodeName(op))
    out(";\n        Metadata(const ")
    out(capitalizedName(op))
    out("&")
    if inits {
        out(" __op)\n            : ")
        var index: usize = 0
        while index < list.value(opcode.initializers).count {
            if index > 0 { out("\n            , ") }
            const entry = list.item(opcode.initializers, index)
            out("m_")
            out(list.value(entry).key)
            out("(__op.m_")
            out(list.text(entry))
            out(")")
            index += 1
        }
        out("\n        { }\n\n")
    } else {
        out(") { }\n\n")
    }
    var names: [256][]const u8 = undefined
    var count: usize = 0
    outMetadataFields("        ", opcode.metadata, &names, &count)
    out("\n")
    var index: usize = 0
    while index < count {
        if index > 0 { out("\n") }
        const name = names[index]
        out("        static constexpr ptrdiff_t offsetOf")
        out(s.join(s.capitalized(name[0..1]), name[1..name.length]))
        out("() { return OBJECT_OFFSETOF(Metadata, m_")
        out(name)
        out("); }")
        index += 1
    }
    out("\n    };\n")
}

fn outMetadataAccessor(op: usize) -> void {
    if !hasMetadata(op) { return }
    out("\n    Metadata& metadata(CodeBlock* codeBlock) const\n    {\n        return codeBlock->metadata<Metadata>(opcodeID, m_metadataID);\n    }\n")
}

fn outMembers(op: usize) -> void {
    var index: usize = 0
    while index < argCount(op) {
        if index > 0 { out("\n") }
        out("    ")
        out(argType(op, index))
        out(" m_")
        out(argName(op, index))
        out(";")
        index += 1
    }
    if hasMetadata(op) { out("\n    unsigned m_metadataID;") }
}

fn outStruct(op: usize) -> void {
    const opcode = list.opcode(op)
    const name = capitalizedName(op)
    out("struct ")
    out(name)
    out(" : public ")
    out(typePrefix(op))
    out("Instruction {\n    static constexpr ")
    out(opcodeIDType(op))
    out(" opcodeID = ")
    out(opcodeName(op))
    out(";\n    static constexpr size_t length = ")
    outNumber(opcodeLength(op))
    out(";\n    ")
    if opcode.tmps != NONE {
        out("enum Tmps : uint8_t {")
        var index: usize = 0
        while index < list.value(opcode.tmps).count {
            out("\n        ")
            out(list.value(list.item(opcode.tmps, index)).key)
            out(",")
            index += 1
        }
        out("\n    };")
    }
    out("\n    ")
    if opcode.checkpoints != NONE {
        out("enum Checkpoints : uint8_t {")
        var index: usize = 0
        while index < list.value(opcode.checkpoints).count {
            out("\n        ")
            out(list.value(list.item(opcode.checkpoints, index)).key)
            out(",")
            index += 1
        }
        out("\n        numberOfCheckpoints,\n    };")
    }
    out("\n\n\n")
    outEmitter(op)
    out("\n")
    outDumper(op)
    out("\n")
    outConstructors(op)
    out("\n")
    outSetters(op)
    outMetadataStruct(op)
    outMetadataAccessor(op)
    out("\n")
    outMembers(op)
    out("\n};\n")
    if opcode.checkpoints != NONE {
        out("static_assert(")
        out(name)
        out("::length + 1 > ")
        out(name)
        out("::numberOfCheckpoints, \"FullBytecodeLivess relies on the length of ")
        out(name)
        out(" being greater than the number of checkpoints\");")
    }
    out("\n")
}

// ---------------------------------------------------------------------------
// The files (DSL.rb).

// Whether the opcodes of section INDEX go into the structs file (and the
// dumper): emit_in_structs_file, not Wasm.
fn structSection(index: usize) -> bool {
    return list.option(index, "emit_in_structs_file") && !std.text.same(list.section(index).name, "Wasm")
}

fn sectionHelpers(index: usize) -> void {
    const sectionValue = list.section(index)
    const component = list.optionText(index, "macro_name_component")
    if list.option(index, "emit_in_h_file") {
        out("#define FOR_EACH_")
        out(component)
        out("_ID(macro) \\\n")
        var longest: usize = 0
        var at: usize = 0
        while at < sectionValue.count {
            const op = list.sectionOpcode(index, at)
            out("    macro(")
            out(opcodeName(op))
            out(", ")
            outNumber(opcodeLength(op))
            out(") \\\n")
            if opcodeLength(op) > longest { longest = opcodeLength(op) }
            at += 1
        }
        out("\n#define NUMBER_OF_")
        out(component)
        out("_IDS ")
        outNumber(sectionValue.count)
        out("\n#define MAX_LENGTH_OF_")
        out(component)
        out("_IDS ")
        outNumber(longest)
        out("\n")
    }
    if list.option(index, "emit_in_structs_file") {
        out("static constexpr unsigned ")
        var lowered = s.join(component, "")
        var at: usize = 0
        while at < lowered.length {
            s.put8(@intFromPtr(lowered.pointer) + at, lower(lowered[at]))
            at += 1
        }
        out(lowered)
        out("CheckpointCountTable[] = {\n")
        at = 0
        while true {
            if at >= sectionValue.count { s.fail("a section with only opcodes with checkpoints") }
            const op = list.sectionOpcode(index, at)
            const checkpoints = list.opcode(op).checkpoints
            if checkpoints == NONE {
                out("};\n\n#define NUMBER_OF_")
                out(component)
                out("_WITH_CHECKPOINTS ")
                outNumber(at)
                out("\n")
                break
            }
            out("    ")
            outNumber(list.value(checkpoints).count)
            out(",\n")
            at += 1
        }
        out("\n#define FOR_EACH_")
        out(component)
        out("_METADATA_SIZE(macro) \\\n")
        at = 0
        while true {
            if at >= sectionValue.count { s.fail("a section with only opcodes with metadata") }
            const op = list.sectionOpcode(index, at)
            if !hasMetadata(op) {
                out("\n#define NUMBER_OF_")
                out(component)
                out("_WITH_METADATA ")
                outNumber(at)
                out("\n")
                break
            }
            out("    macro(sizeof(")
            out(capitalizedName(op))
            out("::Metadata))\\\n")
            at += 1
        }
        out("\n#define FOR_EACH_")
        out(component)
        out("_METADATA_ALIGNMENT(macro) \\\n")
        at = 0
        while true {
            const op = list.sectionOpcode(index, at)
            if !hasMetadata(op) {
                out("\n")
                break
            }
            out("    macro(alignof(")
            out(capitalizedName(op))
            out("::Metadata))\\\n")
            at += 1
        }
    }
    if list.option(index, "emit_opcode_id_string_values_in_h_file") {
        const total = list.opcodeTotal()
        var round: usize = 0
        while round < 3 {
            var at: usize = 0
            while at < sectionValue.count {
                const op = list.sectionOpcode(index, at)
                out("#define ")
                out(opcodeName(op))
                out(if round == 0 { "_value_string \"" } else if round == 1 { "_wide16_value_string \"" } else { "_wide32_value_string \"" })
                outNumber(total * round + list.opcode(op).id)
                out("\"\n")
                at += 1
            }
            round += 1
        }
    }
}

fn writeBytecodes(path: []const u8) -> void {
    beginFile(false)
    out("#pragma once\n\n")
    var index: usize = 0
    var first = true
    while index < list.sectionTotal() {
        if !first { out("\n") }
        sectionHelpers(index)
        first = false
        index += 1
    }
    index = 0
    while index < list.sectionTotal() {
        if list.option(index, "emit_in_structs_file") {
            if !first { out("\n") }
            first = false
            out("#define FOR_EACH_")
            out(list.optionText(index, "macro_name_component"))
            out("_STRUCT(macro) \\\n")
            var at: usize = 0
            while at < list.section(index).count {
                if at > 0 { out("\n") }
                out("    macro(")
                out(capitalizedName(list.sectionOpcode(index, at)))
                out(") \\")
                at += 1
            }
            out("\n")
        }
        index += 1
    }
    out("\n")
    endFile(false, path)
}

fn writeBytecodeStructs(path: []const u8) -> void {
    beginFile(false)
    out("#pragma once\n\n#include \"ArithProfile.h\"\n#include \"ArrayAllocationProfile.h\"\n#include \"BytecodeDumper.h\"\n")
    out("#include \"Fits.h\"\n#include \"GetByIdMetadata.h\"\n#include \"Instruction.h\"\n#include \"IterationModeMetadata.h\"\n")
    out("#include \"JSPropertyNameEnumerator.h\"\n#include \"Opcode.h\"\n#include \"PrivateFieldPutKind.h\"\n#include \"PutByStatus.h\"\n")
    out("#include \"PutByIdFlags.h\"\n#include \"ToThisStatus.h\"\n\nWTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN\n\nnamespace JSC {\n\n")
    out("class BasicBlockLocation;\n\nvoid dumpBytecode(BytecodeDumperBase<JSInstructionStream>* dumper, JSInstructionStream::Offset, const JSInstruction*);\n\n\n")
    var first = true
    var index: usize = 0
    while index < list.sectionTotal() {
        if structSection(index) {
            var at: usize = 0
            while at < list.section(index).count {
                if !first { out("\n") }
                first = false
                outStruct(list.sectionOpcode(index, at))
                at += 1
            }
        }
        index += 1
    }
    out("\n\n\n} // namespace JSC\n\nWTF_ALLOW_UNSAFE_BUFFER_USAGE_END\n\n")
    endFile(false, path)
}

fn writeBytecodeDumper(path: []const u8) -> void {
    beginFile(false)
    out("#include \"config.h\"\n#include \"BytecodeDumper.h\"\n\n#include \"ButterflyInlines.h\"\n#include \"BytecodeStructs.h\"\n\nnamespace JSC {\n\n")
    out("void dumpBytecode(BytecodeDumperBase<JSInstructionStream>* dumper, JSInstructionStream::Offset __location, const JSInstruction* __instruction)\n{\n    switch (__instruction->opcodeID()) {\n")
    var first = true
    var index: usize = 0
    while index < list.sectionTotal() {
        if structSection(index) {
            var at: usize = 0
            while at < list.section(index).count {
                if !first { out("\n") }
                first = false
                const op = list.sectionOpcode(index, at)
                out("    case ")
                out(opcodeName(op))
                out(":\n        __instruction->as<")
                out(capitalizedName(op))
                out(">().dump(dumper, __location, __instruction->sizeShiftAmount());\n        break;")
                at += 1
            }
        }
        index += 1
    }
    out("\n    default:\n        ASSERT_NOT_REACHED();\n    }\n}\n\n} // namespace JSC\n")
    endFile(false, path)
}

fn writeInitAsm(path: []const u8) -> void {
    beginFile(true)
    var first = true
    var round: usize = 0
    while round < 3 {
        // The number is the opcode's place among the assembly's opcodes.
        var number: usize = 0
        var index: usize = 0
        while index < list.sectionTotal() {
            if list.option(index, "emit_in_asm_file") {
                const prefix = list.optionText(index, "asm_prefix")
                var at: usize = 0
                while at < list.section(index).count {
                    if !first { out("\n") }
                    first = false
                    const op = list.sectionOpcode(index, at)
                    out(if round == 0 { "setEntryAddress(" } else if round == 1 { "setEntryAddressWide16(" } else { "setEntryAddressWide32(" })
                    outNumber(number)
                    out(", _")
                    out(prefix)
                    out(opcodeName(op))
                    out(if round == 0 { ")" } else if round == 1 { "_wide16)" } else { "_wide32)" })
                    number += 1
                    at += 1
                }
            }
            index += 1
        }
        round += 1
    }
    out("\n")
    endFile(true, path)
}

fn writeIndices(path: []const u8) -> void {
    beginFile(false)
    out("namespace JSC {\n\n")
    var first = true
    var index: usize = 0
    while index < list.sectionTotal() {
        if list.option(index, "emit_in_structs_file") {
            var at: usize = 0
            while at < list.section(index).count {
                // Ruby joins the opcodes' lists of lines: an opcode with
                // none still has its separator.
                if !first { out("\n") }
                first = false
                const op = list.sectionOpcode(index, at)
                const name = capitalizedName(op)
                var number: usize = 0
                while number < opcodeLength(op) {
                    if number > 0 { out("\n") }
                    out("const unsigned ")
                    out(name)
                    out("_m_")
                    out(if number < argCount(op) { argName(op, number) } else { "metadataID" })
                    out("_index = ")
                    outNumber(number)
                    out(";")
                    number += 1
                }
                at += 1
            }
        }
        index += 1
    }
    out("\n\n} // namespace JSC\n")
    endFile(false, path)
}

// ---------------------------------------------------------------------------
// The command line (Options.rb).

fn usage() -> u8 {
    s.say("usage: webkit-bytecodes --bytecodes_h FILE --bytecode_structs_h FILE --init_bytecodes_asm FILE --bytecode_indices_h FILE --wasm_json FILE --bytecode_dumper FILE BYTECODE-LIST\n")
    return 1
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var paths: [6][]const u8 = [6][]const u8{ "", "", "", "", "", "" }
    var listPath: []const u8 = ""
    var index: usize = 1
    while index < arguments.length {
        const argument = std.text.cString(arguments[index])
        var which: usize = NONE
        if std.text.same(argument, "--bytecodes_h") || std.text.same(argument, "-b") { which = 0 }
        if std.text.same(argument, "--bytecode_structs_h") || std.text.same(argument, "-s") { which = 1 }
        if std.text.same(argument, "--init_bytecodes_asm") || std.text.same(argument, "-a") { which = 2 }
        if std.text.same(argument, "--bytecode_indices_h") || std.text.same(argument, "-i") { which = 3 }
        if std.text.same(argument, "--wasm_json") { which = 4 }
        if std.text.same(argument, "--bytecode_dumper") { which = 5 }
        if which != NONE {
            if index + 1 >= arguments.length { return usage() }
            paths[which] = std.text.cString(arguments[index + 1])
            index += 2
        } else if argument.length > 0 && argument[0] == 45 {
            return usage()
        } else {
            if listPath.length > 0 { return usage() }
            listPath = argument
            index += 1
        }
    }
    var at: usize = 0
    while at < 6 {
        if paths[at].length == 0 { return usage() }
        at += 1
    }
    if listPath.length == 0 { return usage() }

    const contents = s.readWhole(listPath)
    const wasm = s.readWhole(paths[4])
    list.read(listPath, contents)

    var hashing: sha1.Sha1 = undefined
    sha1.sha1Init(&hashing)
    sha1.sha1Update(&hashing, contents)
    var digest: [20]u8 = undefined
    sha1.sha1Final(&hashing, &digest)
    listHash = hexOf(&digest).pointer
    const year = currentYear()
    yearText = year.pointer
    yearLength = year.length

    // In main.rb's order.
    writeBytecodes(paths[0])
    writeBytecodeStructs(paths[1])
    writeBytecodeDumper(paths[5])
    writeInitAsm(paths[2])
    writeIndices(paths[3])
    return 0
}
