// Style sheets (and scripts) as C arrays of their characters, as WebCore's
// css/make-css-file-arrays.pl writes them (UserAgentStyleSheets.h and
// UserAgentStyleSheetsData.cpp):
//
//     webkit-css-file-arrays [--defines DEFINES] HEADER OUTPUT INPUT...
//
// Each INPUT (NAME.css or NAME.js) is read through the preprocessor (see
// csspreprocessor.mlx), its comments taken out and its runs of spaces made
// one; HEADER declares and OUTPUT defines NAMEUserAgentStyleSheet (or
// NAMEJavaScript), sixteen characters a line.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const j = @import("./inspectorjsonvalue.mlx")
const c = @import("./csstext.mlx")
const p = @import("./csspreprocessor.mlx")

fn isSpace(byte: u8) -> bool { return byte == 32 || (byte >= 9 && byte <= 13) }

// The word before EXTENSION at the end of PATH, "" when PATH does not end so.
fn nameBefore(path: []const u8, extension: []const u8) -> []const u8 {
    if !std.text.endsWith(path, extension) { return "" }
    const end = path.length - extension.length
    var start = end
    while start > 0 && s.isWord(path[start - 1]) { start -= 1 }
    return path[start..end]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var defines: []const u8 = ""
    var first: usize = 1
    if arguments.length > 2 && std.text.same(s.cString(arguments[1]), "--defines") {
        defines = s.cString(arguments[2])
        first = 3
    }
    if arguments.length < first + 2 {
        s.say("usage: webkit-css-file-arrays [--defines DEFINES] HEADER OUTPUT INPUT...\n")
        return 2
    }
    var header = c.buf()
    var out = c.buf()
    c.add(&header, "#include <array>\nnamespace WebCore {\n")
    c.add(&out, "#include <array>\nnamespace WebCore {\n")
    var index = first + 2
    while index < arguments.length {
        const path = s.cString(arguments[index])
        var name = nameBefore(path, ".css")
        const css = name.length > 0
        if !css { name = nameBefore(path, ".js") }
        if name.length == 0 { s.fail(s.join("not a .css or .js file: ", path)) }
        var text = j.withoutComments(p.apply(c.readFile(path), defines))
        var crunched = c.buf()
        var at: usize = 0
        while at < text.length {
            if isSpace(text[at]) {
                while at < text.length && isSpace(text[at]) { at += 1 }
                c.addByte(&crunched, 32)
            } else {
                c.addByte(&crunched, text[at])
                at += 1
            }
        }
        text = c.contents(&crunched)
        if std.text.startsWith(text, " ") { text = text[1..text.length] }
        if std.text.endsWith(text, " ") { text = text[0..text.length - 1] }
        const length = s.decimal(text.length)
        const variable = if css { s.join(name, "UserAgentStyleSheet") } else { s.join(name, "JavaScript") }
        c.add(&header, t.c5("extern const std::array<const char, ", length, "> ", variable, ";\n"))
        c.add(&out, t.c5("extern const std::array<const char, ", length, "> ", variable, " = {\n"))
        at = 0
        while at < text.length {
            c.add(&out, "    ")
            var column: usize = 0
            while column < 16 && at < text.length {
                if text[at] >= 128 { s.fail(s.join("not ASCII: ", path)) }
                if column > 0 { c.add(&out, ", ") }
                c.add(&out, s.decimal(@intCast(u64, text[at])))
                at += 1
                column += 1
            }
            if at != text.length { c.add(&out, ",") }
            c.add(&out, "\n")
        }
        c.add(&out, "};\n")
        index += 1
    }
    c.add(&header, "}\n")
    c.add(&out, "}\n")
    s.writeWhole(s.cString(arguments[first]), c.contents(&header))
    s.writeWhole(s.cString(arguments[first + 1]), c.contents(&out))
    return 0
}
