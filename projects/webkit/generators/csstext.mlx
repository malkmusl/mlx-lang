// Text for WebCore's CSS generators: output built up in growable buffers
// (several files from one run), the Writer the Python scripts share (a
// line at the current indentation, blocks dedented then indented as
// Python's textwrap does), and the build's defines as a set of words.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")

// ---------------------------------------------------------------------------
// Buffers.

pub const Buf = struct {
    base: usize
    length: usize
    capacity: usize
}

pub fn buf() -> Buf {
    return Buf.{ .base = s.alloc(65536), .length = 0, .capacity = 65536 }
}

pub fn add(b: *Buf, text: []const u8) -> void {
    if b.*.length + text.length > b.*.capacity {
        var capacity = b.*.capacity * 2
        while b.*.length + text.length > capacity { capacity *= 2 }
        const base = s.alloc(capacity)
        t.copyInto(base, s.bytes(b.*.base, b.*.length))
        b.*.base = base
        b.*.capacity = capacity
    }
    t.copyInto(b.*.base + b.*.length, text)
    b.*.length += text.length
}

pub fn addByte(b: *Buf, byte: u8) -> void {
    if b.*.length + 1 > b.*.capacity {
        const capacity = b.*.capacity * 2
        const base = s.alloc(capacity)
        t.copyInto(base, s.bytes(b.*.base, b.*.length))
        b.*.base = base
        b.*.capacity = capacity
    }
    s.put8(b.*.base + b.*.length, byte)
    b.*.length += 1
}

pub fn contents(b: *Buf) -> []const u8 { return s.bytes(b.*.base, b.*.length) }

// ---------------------------------------------------------------------------
// The scripts' Writer: four spaces a level.

pub const Writer = struct {
    b: Buf
    level: usize
}

pub fn writer() -> Writer { return Writer.{ .b = buf(), .level = 0 } }

fn currentIndent(w: *Writer) -> []const u8 { return spaces(w.*.level * 4) }

pub fn spaces(count: usize) -> []const u8 {
    const all = "                                                                                                                                "
    if count <= all.length { return all[0..count] }
    const at = s.alloc(count + 1)
    var index: usize = 0
    while index < count {
        s.put8(at + index, 32)
        index += 1
    }
    return s.bytes(at, count)
}

// The text as it is (the scripts' to.write(...)).
pub fn raw(w: *Writer, text: []const u8) -> void { add(&w.*.b, text) }

// TEXT at the current indentation, and a newline.
pub fn write(w: *Writer, text: []const u8) -> void {
    add(&w.*.b, currentIndent(w))
    add(&w.*.b, text)
    add(&w.*.b, "\n")
}

pub fn newline(w: *Writer) -> void { add(&w.*.b, "\n") }

// TEXT dedented, indented to the current level, and a newline.
pub fn block(w: *Writer, text: []const u8) -> void {
    add(&w.*.b, indentLines(dedent(text), currentIndent(w)))
    add(&w.*.b, "\n")
}

pub fn indent(w: *Writer) -> void { w.*.level += 1 }
pub fn outdent(w: *Writer) -> void { w.*.level -= 1 }

pub fn written(w: *Writer) -> []const u8 { return contents(&w.*.b) }

// ---------------------------------------------------------------------------
// textwrap.

// textwrap.dedent: lines of only spaces and tabs emptied, then the
// leading spaces and tabs common to every other line taken off.
pub fn dedent(text: []const u8) -> []const u8 {
    var cleaned = buf()
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        var blank = end > at
        var index = at
        while index < end {
            if text[index] != 32 && text[index] != 9 { blank = false }
            index += 1
        }
        if !blank { add(&cleaned, text[at..end]) }
        if end < text.length { addByte(&cleaned, 10) }
        at = end + 1
    }
    const plain = contents(&cleaned)
    // The margin: the longest common prefix of the non-empty lines' indents.
    var margin: []const u8 = ""
    var haveMargin = false
    at = 0
    while at < plain.length {
        var end = at
        while end < plain.length && plain[end] != 10 { end += 1 }
        if end > at {
            var lead = at
            while lead < end && (plain[lead] == 32 || plain[lead] == 9) { lead += 1 }
            const indentText = plain[at..lead]
            if !haveMargin {
                margin = indentText
                haveMargin = true
            } else {
                var common: usize = 0
                while common < margin.length && common < indentText.length && margin[common] == indentText[common] { common += 1 }
                margin = margin[0..common]
            }
        }
        at = end + 1
    }
    if margin.length == 0 { return plain }
    var result = buf()
    at = 0
    while at < plain.length {
        var end = at
        while end < plain.length && plain[end] != 10 { end += 1 }
        const line = plain[at..end]
        if std.text.startsWith(line, margin) {
            add(&result, line[margin.length..line.length])
        } else {
            add(&result, line)
        }
        if end < plain.length { addByte(&result, 10) }
        at = end + 1
    }
    return contents(&result)
}

// textwrap.indent: PREFIX before every line that is not only whitespace.
pub fn indentLines(text: []const u8, prefix: []const u8) -> []const u8 {
    if prefix.length == 0 { return text }
    var result = buf()
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        if end < text.length { end += 1 }
        const line = text[at..end]
        var onlySpace = true
        for byte in line {
            if !s.isSpace(byte) { onlySpace = false }
        }
        if !onlySpace { add(&result, prefix) }
        add(&result, line)
        at = end
    }
    return contents(&result)
}

// ---------------------------------------------------------------------------
// Defines.

// The words of DEFINES split at single spaces (Python's split(' ')).
pub fn splitSpaces(text: []const u8) -> t.List {
    var words = t.list()
    var start: usize = 0
    var index: usize = 0
    while index <= text.length {
        if index == text.length || text[index] == 32 {
            t.push(&words, text[start..index])
            start = index + 1
        }
        index += 1
    }
    return words
}

// TEXT split at each SEPARATOR byte (Python's split with one character).
pub fn splitByte(text: []const u8, separator: u8) -> t.List {
    var words = t.list()
    var start: usize = 0
    var index: usize = 0
    while index <= text.length {
        if index == text.length || text[index] == separator {
            t.push(&words, text[start..index])
            start = index + 1
        }
        index += 1
    }
    return words
}

// ---------------------------------------------------------------------------
// Small text helpers.

pub fn lower(text: []const u8) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        s.put8(at + index, t.lowerByte(text[index]))
        index += 1
    }
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

pub fn upperByte(byte: u8) -> u8 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }

pub fn upper(text: []const u8) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        s.put8(at + index, upperByte(text[index]))
        index += 1
    }
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

// Python's str.capitalize() on ASCII: the first letter upper case, the rest lower.
pub fn capitalize(text: []const u8) -> []const u8 {
    if text.length == 0 { return text }
    const rest = lower(text)
    const at = s.alloc(text.length + 1)
    t.copyInto(at, rest)
    s.put8(at, upperByte(text[0]))
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

// The whole file at PATH, in memory sized to it (support's readWhole
// takes a quarter gigabyte a file, too much for runs reading many).
pub fn readFile(path: []const u8) -> []const u8 {
    const name = s.join(path, "")
    const descriptor = std.linux.syscall3(2, @intFromPtr(name.pointer), 0, 0)
    if descriptor < 0 { s.fail(s.join("cannot read ", path)) }
    var b = buf()
    while true {
        if b.length + 65536 > b.capacity {
            const capacity = b.capacity * 2
            const base = s.alloc(capacity)
            t.copyInto(base, s.bytes(b.base, b.length))
            b.base = base
            b.capacity = capacity
        }
        const count = std.linux.syscall3(0, @bitCast(usize, descriptor), b.base + b.length, 65536)
        if count <= 0 { break }
        b.length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(3, @bitCast(usize, descriptor))
    return contents(&b)
}

pub fn writeFile(directory: []const u8, name: []const u8, text: []const u8) -> void {
    s.writeWhole(t.pathJoin(directory, name), text)
}
