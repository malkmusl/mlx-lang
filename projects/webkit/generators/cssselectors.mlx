// WebCore's CSS pseudo-classes and pseudo-elements, as
// process-css-pseudo-selectors.py makes them from CSSPseudoSelectors.json:
// their enums (CSSSelectorEnums.h), the functions saying whether each is
// enabled, how it is written and whether it takes an argument
// (CSSSelectorInlines.h), the user agent parts' names (UserAgentParts.h,
// UserAgentParts.cpp), and gperf's inputs for looking them up by name
// (SelectorPseudoClassAndCompatibilityElementMap.gperf,
// SelectorPseudoElementMap.gperf):
//
//     webkit-css-pseudo-selectors [--defines DEFINES] OUTPUT_DIRECTORY CSSPseudoSelectors.json
//
// The JSON is also copied to OUTPUT_DIRECTORY (the build's `perl -ne
// print`). A selector with a "conditional" ENABLE(X) is in the maps only
// when ENABLE_X is one of DEFINES. The .cpp files are then gperf's, run
// in OUTPUT_DIRECTORY:
//
//     gperf --key-positions=* -m 10 -s 2 SelectorPseudoClassAndCompatibilityElementMap.gperf --output-file=SelectorPseudoClassAndCompatibilityElementMap.cpp
//     gperf --key-positions=* -m 10 -s 2 SelectorPseudoElementMap.gperf --output-file=SelectorPseudoElementMap.cpp
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const j = @import("./inspectorjsonvalue.mlx")
const c = @import("./csstext.mlx")

var defines: t.List = undefined

// ---------------------------------------------------------------------------
// Checking the input (InputValidator).

fn isKnownPrefix(name: []const u8) -> bool {
    if !std.text.startsWith(name, "-") { return true }
    return std.text.startsWith(name, "-apple-") || std.text.startsWith(name, "-internal-") || std.text.startsWith(name, "-webkit-")
}

fn knownKey(key: []const u8, elements: bool) -> u8 {
    // The JSON kind the key's value must have, 0 for an unknown key.
    if std.text.same(key, "aliases") { return j.ARRAY }
    if std.text.same(key, "argument") || std.text.same(key, "comment") || std.text.same(key, "conditional") || std.text.same(key, "settings-flag") || std.text.same(key, "status") { return j.STRING }
    if elements && (std.text.same(key, "supports-single-colon-for-compatibility") || std.text.same(key, "user-agent-part") || std.text.same(key, "user-agent-part-string")) { return j.TRUE }
    return 0
}

fn validate(data: *j.Value, pseudoType: []const u8, elements: bool, expectedWebKitCount: usize) -> void {
    const documentation = j.get(j.get(data, "documentation").?, "fields").?
    const pseudos = j.get(data, pseudoType).?
    var webkitCount: usize = 0
    var index: usize = 0
    while index < pseudos.*.count {
        const name = pseudos.*.keys[index]
        const pseudo = pseudos.*.items[index]
        if std.text.startsWith(name, "-webkit-") { webkitCount += 1 }
        if std.text.startsWith(name, "-apple-") && !j.has(pseudo, "settings-flag") { s.fail(t.c3("\"", name, "\" should have a \"settings-flag\" that is not exposed to web content.")) }
        if !isKnownPrefix(name) { s.fail(t.c3("\"", name, "\" starts with an unknown prefix.")) }
        var at: usize = 0
        while at < pseudo.*.count {
            const key = pseudo.*.keys[at]
            const value = pseudo.*.items[at]
            const kind = knownKey(key, elements)
            if kind == 0 { s.fail(t.c7("Unknown field \"", key, "\" for ", pseudoType, " found in \"", name, "\".")) }
            const valueKind = if value.*.kind == j.FALSE { j.TRUE } else { value.*.kind }
            if valueKind != kind { s.fail(t.c5("Invalid value type for \"", key, "\" in \"", name, "\".")) }
            if !j.has(documentation, key) { s.fail(t.c5("Missing documentation for field \"", key, "\" found in \"", pseudoType, "\".")) }
            if std.text.same(key, "aliases") {
                var alias: usize = 0
                while alias < value.*.count {
                    if !isKnownPrefix(value.*.items[alias].*.text) { s.fail(t.c3("\"", value.*.items[alias].*.text, "\" starts with an unknown prefix.")) }
                    alias += 1
                }
                if j.boolAt(pseudo, "supports-single-colon-for-compatibility", false) { s.fail("Setting \"aliases\" along with \"supports-single-colon-for-compatibility\": true is not supported.") }
            }
            if std.text.same(key, "argument") {
                if !std.text.same(value.*.text, "required") && !std.text.same(value.*.text, "optional") { s.fail(t.c3("Invalid \"argument\" field in \"", name, "\". The field should either be absent, \"required\" or \"optional\".")) }
                if j.boolAt(pseudo, "user-agent-part", false) { s.fail("Setting \"argument\" along with \"user-agent-part\": true is not supported.") }
            }
            if std.text.same(key, "supports-single-colon-for-compatibility") {
                if !std.text.same(name, "after") && !std.text.same(name, "before") && !std.text.same(name, "first-letter") && !std.text.same(name, "first-line") { s.fail(t.c3("Unexpected \"supports-single-colon-for-compatibility\" field in \"", name, "\". This should never be set on new pseudo-elements.")) }
            }
            if std.text.same(key, "user-agent-part-string") && j.boolAt(pseudo, "user-agent-part", false) { s.fail("Setting \"user-agent-part-string\" along with \"user-agent-part\": true is not supported.") }
            at += 1
        }
        index += 1
    }
    if webkitCount > expectedWebKitCount { s.fail("Instead of adding a `-webkit-` prefix, please consider these alternatives.") }
    if webkitCount < expectedWebKitCount { s.fail(t.c5("The number of `-webkit-` prefixed ", pseudoType, " has decreased to ", s.decimal(webkitCount), " (yay!), please update the count in `process-css-pseudo-selectors.py`.")) }
}

// ---------------------------------------------------------------------------
// Helpers.

fn isEnabled(pseudo: *j.Value) -> bool {
    if !j.has(pseudo, "conditional") { return true }
    const expanded = t.replaceAll(t.replaceAll(j.stringAt(pseudo, "conditional", ""), "(", "_"), ")", "")
    return t.contains(defines, expanded)
}

fn enumName(name: []const u8) -> []const u8 {
    const parts = c.splitByte(name, 45)
    var result = t.list()
    var index: usize = 0
    while index < parts.count {
        const part = parts.items[index]
        if std.text.same(part, "webkit") {
            t.push(&result, "WebKit")
        } else if std.text.same(part, "html") {
            t.push(&result, "HTML")
        } else {
            t.push(&result, c.capitalize(part))
        }
        index += 1
    }
    return t.joined(result, "")
}

fn functionName(name: []const u8) -> []const u8 {
    const parts = t.nonEmpty(c.splitByte(name, 45))
    var result = parts.items[0]
    var index: usize = 1
    while index < parts.count {
        result = s.join(result, c.capitalize(parts.items[index]))
        index += 1
    }
    return result
}

fn writeCopyright(w: *c.Writer) -> void {
    c.block(w, "/*
 * Copyright (C) 2014-2024 Apple Inc. All rights reserved.
 *
 * Redistribution and use in source and binary forms, with or without
 * modification, are permitted provided that the following conditions
 * are met:
 * 1. Redistributions of source code must retain the above copyright
 *    notice, this list of conditions and the following disclaimer.
 * 2. Redistributions in binary form must reproduce the above copyright
 *    notice, this list of conditions and the following disclaimer in the
 *    documentation and/or other materials provided with the distribution.
 *
 * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
 * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
 * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
 * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
 * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
 * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
 * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
 * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
 * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
 * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
 * THE POSSIBILITY OF SUCH DAMAGE.
 */")
}

fn writeAutogenerationComment(w: *c.Writer) -> void {
    c.newline(w)
    c.write(w, "// This file is automatically generated from CSSPseudoSelectors.json by the process-css-pseudo-selectors.py script, do not edit by hand.")
}

fn writePragmaOnce(w: *c.Writer) -> void {
    c.newline(w)
    c.write(w, "#pragma once")
}

fn openNamespace(w: *c.Writer) -> void {
    c.newline(w)
    c.write(w, "namespace WebCore {")
}

fn closeNamespace(w: *c.Writer) -> void {
    c.newline(w)
    c.write(w, "} // namespace WebCore")
}

// ---------------------------------------------------------------------------
// The gperf maps: names in order of first insertion, a later insertion
// replacing the value (a Python dict).

const Map = struct {
    keys: t.List
    first: t.List
    second: t.List
}

fn mapPut(map: *Map, key: []const u8, first: []const u8, second: []const u8) -> void {
    var index: usize = 0
    while index < map.*.keys.count {
        if std.text.same(map.*.keys.items[index], key) {
            map.*.first.items[index] = first
            map.*.second.items[index] = second
            return
        }
        index += 1
    }
    t.push(&map.*.keys, key)
    t.push(&map.*.first, first)
    t.push(&map.*.second, second)
}

fn newMap() -> Map { return Map.{ .keys = t.list(), .first = t.list(), .second = t.list() } }

fn pseudoClassMap(data: *j.Value) -> Map {
    var map = newMap()
    const classes = j.get(data, "pseudo-classes").?
    var index: usize = 0
    while index < classes.*.count {
        const name = classes.*.keys[index]
        const pseudo = classes.*.items[index]
        if isEnabled(pseudo) {
            mapPut(&map, name, enumName(name), "std::nullopt")
            const aliases = j.get(pseudo, "aliases")
            if aliases != null {
                var at: usize = 0
                while at < aliases.?.*.count {
                    mapPut(&map, aliases.?.*.items[at].*.text, enumName(name), "std::nullopt")
                    at += 1
                }
            }
        }
        index += 1
    }
    const elements = j.get(data, "pseudo-elements").?
    index = 0
    while index < elements.*.count {
        const name = elements.*.keys[index]
        const pseudo = elements.*.items[index]
        if isEnabled(pseudo) && j.boolAt(pseudo, "supports-single-colon-for-compatibility", false) { mapPut(&map, name, "std::nullopt", enumName(name)) }
        index += 1
    }
    return map
}

fn pseudoElementMap(data: *j.Value) -> Map {
    var map = newMap()
    const elements = j.get(data, "pseudo-elements").?
    var index: usize = 0
    while index < elements.*.count {
        const name = elements.*.keys[index]
        const pseudo = elements.*.items[index]
        if isEnabled(pseudo) {
            const part = j.boolAt(pseudo, "user-agent-part", false)
            mapPut(&map, name, if part { "UserAgentPart" } else { enumName(name) }, "")
            const aliases = j.get(pseudo, "aliases")
            if aliases != null {
                var at: usize = 0
                while at < aliases.?.*.count {
                    mapPut(&map, aliases.?.*.items[at].*.text, if part { "UserAgentPartLegacyAlias" } else { enumName(name) }, "")
                    at += 1
                }
            }
        }
        index += 1
    }
    return map
}

fn prefixValue(prefix: []const u8, value: []const u8) -> []const u8 {
    if std.text.same(value, "std::nullopt") { return value }
    return t.c4("CSSSelector::", prefix, "::", value)
}

fn longestKey(map: Map) -> usize {
    var longest: usize = 0
    var index: usize = 0
    while index < map.keys.count {
        if map.keys.items[index].length > longest { longest = map.keys.items[index].length }
        index += 1
    }
    return longest
}

fn gperfFile(classes: bool, map: Map) -> []const u8 {
    var writer = c.writer()
    const w = &writer
    c.write(w, "%{")
    writeCopyright(w)
    writeAutogenerationComment(w)
    c.newline(w)
    c.write(w, "#include \"config.h\"")
    c.write(w, "#include \"SelectorPseudoTypeMap.h\"")
    if classes {
        c.newline(w)
        c.write(w, "#include \"MutableCSSSelector.h\"")
    }
    c.newline(w)
    c.write(w, "WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN")
    c.write(w, "IGNORE_WARNINGS_BEGIN(\"implicit-fallthrough\")")
    c.newline(w)
    c.write(w, "// Older versions of gperf use the `register` keyword.")
    c.write(w, "#define register")
    openNamespace(w)
    if classes {
        c.block(w, "
                struct SelectorPseudoClassOrCompatibilityPseudoElementEntry {
                    const char* name;
                    PseudoClassOrCompatibilityPseudoElement pseudoTypes;
                };")
    } else {
        c.block(w, "
                struct SelectorPseudoTypeEntry {
                    const char* name;
                    std::optional<CSSSelector::PseudoElement> type;
                };")
    }
    c.newline(w)
    c.write(w, "%}")
    const suffix = if classes { "{std::nullopt,std::nullopt}" } else { "std::nullopt" }
    const className = if classes { "SelectorPseudoClassAndCompatibilityElementMapHash" } else { "SelectorPseudoElementMapHash" }
    const entry = if classes { "SelectorPseudoClassOrCompatibilityPseudoElementEntry" } else { "SelectorPseudoTypeEntry" }
    c.block(w, t.c7("
            %struct-type
            %define initializer-suffix ,", suffix, "
            %define class-name ", className, "
            %omit-struct-type
            %language=C++
            %readonly-tables
            %global-table
            %ignore-case
            %compare-strncmp
            %enum

            struct ", entry, ";
            "))
    c.write(w, "%%")
    var index: usize = 0
    while index < map.keys.count {
        const key = map.keys.items[index]
        if classes {
            c.write(w, t.c7("\"", key, "\", {", prefixValue("PseudoClass", map.first.items[index]), ", ", prefixValue("PseudoElement", map.second.items[index]), "}"))
        } else {
            c.write(w, t.c4("\"", key, "\", ", prefixValue("PseudoElement", map.first.items[index])))
        }
        index += 1
    }
    c.write(w, "%%")
    const longest = s.decimal(longestKey(map))
    if classes {
        c.block(w, "
        static inline const SelectorPseudoClassOrCompatibilityPseudoElementEntry* findPseudoClassAndCompatibilityElementName(std::span<const Latin1Character> characters)
        {
            return SelectorPseudoClassAndCompatibilityElementMapHash::in_word_set(byteCast<char>(characters.data()), characters.size());
        }")
        c.block(w, t.c3("
        static inline const SelectorPseudoClassOrCompatibilityPseudoElementEntry* findPseudoClassAndCompatibilityElementName(std::span<const char16_t> characters)
        {
            constexpr unsigned maxKeywordLength = ", longest, ";
            std::array<Latin1Character, maxKeywordLength> buffer;
            if (characters.size() > maxKeywordLength)
                return nullptr;

            for (size_t i = 0; i < characters.size(); ++i) {
                char16_t character = characters[i];
                if (!isLatin1(character))
                    return nullptr;

                buffer[i] = static_cast<Latin1Character>(character);
            }
            return findPseudoClassAndCompatibilityElementName(std::span { buffer }.first(characters.size()));
        }"))
        c.block(w, "
        PseudoClassOrCompatibilityPseudoElement findPseudoClassAndCompatibilityElementName(StringView name)
        {
            const SelectorPseudoClassOrCompatibilityPseudoElementEntry* entry;
            if (name.is8Bit())
                entry = findPseudoClassAndCompatibilityElementName(name.span8());
            else
                entry = findPseudoClassAndCompatibilityElementName(name.span16());

            if (entry)
                return entry->pseudoTypes;
            return { std::nullopt, std::nullopt };
        }")
    } else {
        c.block(w, "
            static inline std::optional<CSSSelector::PseudoElement> findPseudoElementName(std::span<const Latin1Character> characters)
            {
                if (auto entry = SelectorPseudoElementMapHash::in_word_set(byteCast<char>(characters.data()), characters.size()))
                    return entry->type;
                return std::nullopt;
            }")
        c.block(w, t.c3("
            static inline std::optional<CSSSelector::PseudoElement> findPseudoElementName(std::span<const char16_t> characters)
            {
                constexpr unsigned maxKeywordLength = ", longest, ";
                std::array<Latin1Character, maxKeywordLength> buffer;
                if (characters.size() > maxKeywordLength)
                    return std::nullopt;

                for (size_t i = 0; i < characters.size(); ++i) {
                    char16_t character = characters[i];
                    if (!isLatin1(character))
                        return std::nullopt;

                    buffer[i] = static_cast<Latin1Character>(character);
                }
                return findPseudoElementName(std::span { buffer }.first(characters.size()));
            }"))
        c.block(w, "
            std::optional<CSSSelector::PseudoElement> findPseudoElementName(StringView name)
            {
                if (name.is8Bit())
                    return findPseudoElementName(name.span8());
                return findPseudoElementName(name.span16());
            }")
    }
    closeNamespace(w)
    c.newline(w)
    c.write(w, "IGNORE_WARNINGS_END")
    c.write(w, "WTF_ALLOW_UNSAFE_BUFFER_USAGE_END")
    return c.written(w)
}

// ---------------------------------------------------------------------------
// CSSSelectorEnums.h

fn writeEnumClass(w: *c.Writer, typeName: []const u8, pseudos: *j.Value, extra: bool) -> void {
    c.newline(w)
    c.write(w, t.c3("enum class CSSSelector", typeName, " : uint8_t {"))
    var index: usize = 0
    while index < pseudos.*.count {
        const pseudo = pseudos.*.items[index]
        if !j.boolAt(pseudo, "user-agent-part", false) {
            const conditional = j.stringAt(pseudo, "conditional", "")
            if conditional.length > 0 { c.write(w, s.join("#if ", conditional)) }
            c.indent(w)
            c.write(w, s.join(enumName(pseudos.*.keys[index]), ","))
            c.outdent(w)
            if conditional.length > 0 { c.write(w, "#endif") }
        }
        index += 1
    }
    if extra {
        c.indent(w)
        c.write(w, "UserAgentPart,")
        c.write(w, "UserAgentPartLegacyAlias,")
        c.write(w, "WebKitUnknown,")
        c.outdent(w)
    }
    c.write(w, "};")
}

fn enumsFile(data: *j.Value) -> []const u8 {
    var writer = c.writer()
    const w = &writer
    writeCopyright(w)
    writeAutogenerationComment(w)
    writePragmaOnce(w)
    openNamespace(w)
    writeEnumClass(w, "PseudoClass", j.get(data, "pseudo-classes").?, false)
    writeEnumClass(w, "PseudoElement", j.get(data, "pseudo-elements").?, true)
    closeNamespace(w)
    return c.written(w)
}

// ---------------------------------------------------------------------------
// CSSSelectorInlines.h

fn formatSingleFlag(text: []const u8) -> []const u8 {
    var flag = t.rstrip(s.trimStart(text))
    const negated = std.text.startsWith(flag, "!")
    if negated { flag = flag[1..flag.length] }
    const formatted = if std.text.startsWith(flag, "DeprecatedGlobalSettings::") { s.join(flag, "()") } else { s.join("context.", flag) }
    if negated { return s.join("!", formatted) }
    return formatted
}

// re.split(r' (\&\&|\|\|) ', flag), each flag formatted.
fn formatSettingsFlag(flag: []const u8) -> []const u8 {
    var result = t.list()
    var parts: usize = 1
    var start: usize = 0
    var index: usize = 0
    while index + 4 <= flag.length {
        const piece = flag[index..index + 4]
        if std.text.same(piece, " && ") || std.text.same(piece, " || ") {
            t.push(&result, formatSingleFlag(flag[start..index]))
            t.push(&result, flag[index + 1..index + 3])
            parts += 2
            index += 4
            start = index
        } else {
            index += 1
        }
    }
    t.push(&result, formatSingleFlag(flag[start..flag.length]))
    const joined = t.joined(result, " ")
    if parts > 1 { return t.c3("(", joined, ")") }
    return joined
}

fn enablementCondition(pseudo: *j.Value, internal: bool) -> []const u8 {
    var conditions = t.list()
    if j.has(pseudo, "settings-flag") { t.push(&conditions, formatSettingsFlag(j.stringAt(pseudo, "settings-flag", ""))) }
    if internal { t.push(&conditions, "isUASheetBehavior(context.mode)") }
    return t.joined(conditions, " && ")
}

fn writeIf(w: *c.Writer, pseudo: *j.Value) -> void {
    if j.has(pseudo, "conditional") { c.write(w, s.join("#if ", j.stringAt(pseudo, "conditional", ""))) }
}

fn writeEndif(w: *c.Writer, pseudo: *j.Value) -> void {
    if j.has(pseudo, "conditional") { c.write(w, "#endif") }
}

fn writeDefaultReturn(w: *c.Writer, value: []const u8) -> void {
    c.indent(w)
    c.write(w, "default:")
    c.indent(w)
    c.write(w, value)
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
}

fn writeIsPseudoClassEnabled(w: *c.Writer, pseudos: *j.Value) -> void {
    c.block(w, "
            inline bool CSSSelector::isPseudoClassEnabled(PseudoClass type, const CSSSelectorParserContext& context)
            {
                switch (type) {")
    var index: usize = 0
    while index < pseudos.*.count {
        const name = pseudos.*.keys[index]
        const pseudo = pseudos.*.items[index]
        const internal = std.text.startsWith(name, "-internal-")
        if j.has(pseudo, "settings-flag") || internal {
            writeIf(w, pseudo)
            c.indent(w)
            c.write(w, t.c3("case PseudoClass::", enumName(name), ":"))
            c.indent(w)
            c.write(w, t.c3("return ", enablementCondition(pseudo, internal), ";"))
            c.outdent(w)
            c.outdent(w)
            writeEndif(w, pseudo)
        }
        index += 1
    }
    writeDefaultReturn(w, "return true;")
}

fn writeUserAgentPartCases(w: *c.Writer, names: t.List, conditions: t.List, conditionals: t.List) -> void {
    var index: usize = 0
    while index < names.count {
        const conditional = conditionals.items[index]
        if conditional.length > 0 { c.write(w, s.join("#if ", conditional)) }
        c.indent(w)
        c.indent(w)
        var condition = conditions.items[index]
        if std.text.contains(condition, " && ") || std.text.contains(condition, " || ") { condition = t.c3("(", condition, ")") }
        c.write(w, t.c5("if (!", condition, " && equalLettersIgnoringASCIICase(name, \"", names.items[index], "\"_s))"))
        c.indent(w)
        c.write(w, "return false;")
        c.outdent(w)
        c.outdent(w)
        c.outdent(w)
        if conditional.length > 0 { c.write(w, "#endif") }
        index += 1
    }
    c.indent(w)
    c.indent(w)
    c.write(w, "return true;")
    c.outdent(w)
    c.outdent(w)
}

// Into the ordered map of NAMES (a Python dict): a later put replaces the values.
fn partPut(names: *t.List, conditions: *t.List, conditionals: *t.List, name: []const u8, condition: []const u8, conditional: []const u8) -> void {
    var index: usize = 0
    while index < names.*.count {
        if std.text.same(names.*.items[index], name) {
            conditions.*.items[index] = condition
            conditionals.*.items[index] = conditional
            return
        }
        index += 1
    }
    t.push(names, name)
    t.push(conditions, condition)
    t.push(conditionals, conditional)
}

fn writeIsPseudoElementEnabled(w: *c.Writer, pseudos: *j.Value) -> void {
    c.block(w, "
            inline bool CSSSelector::isPseudoElementEnabled(PseudoElement type, StringView name, const CSSSelectorParserContext& context)
            {
                switch (type) {")
    var partNames = t.list()
    var partConditions = t.list()
    var partConditionals = t.list()
    var aliasNames = t.list()
    var aliasConditions = t.list()
    var aliasConditionals = t.list()
    var index: usize = 0
    while index < pseudos.*.count {
        const name = pseudos.*.keys[index]
        const pseudo = pseudos.*.items[index]
        const internal = std.text.startsWith(name, "-internal-")
        if j.has(pseudo, "settings-flag") || internal {
            const condition = enablementCondition(pseudo, internal)
            if j.boolAt(pseudo, "user-agent-part", false) {
                const conditional = j.stringAt(pseudo, "conditional", "")
                partPut(&partNames, &partConditions, &partConditionals, name, condition, conditional)
                const aliases = j.get(pseudo, "aliases")
                if aliases != null {
                    var at: usize = 0
                    while at < aliases.?.*.count {
                        partPut(&aliasNames, &aliasConditions, &aliasConditionals, aliases.?.*.items[at].*.text, condition, conditional)
                        at += 1
                    }
                }
            } else {
                writeIf(w, pseudo)
                c.indent(w)
                c.write(w, t.c3("case PseudoElement::", enumName(name), ":"))
                c.indent(w)
                c.write(w, t.c3("return ", condition, ";"))
                c.outdent(w)
                c.outdent(w)
                writeEndif(w, pseudo)
            }
        }
        index += 1
    }
    c.indent(w)
    c.write(w, "case PseudoElement::UserAgentPart:")
    c.outdent(w)
    writeUserAgentPartCases(w, partNames, partConditions, partConditionals)
    c.indent(w)
    c.write(w, "case PseudoElement::UserAgentPartLegacyAlias:")
    c.outdent(w)
    writeUserAgentPartCases(w, aliasNames, aliasConditions, aliasConditionals)
    writeDefaultReturn(w, "return true;")
}

fn writeSelectorTextForPseudoClass(w: *c.Writer, pseudos: *j.Value) -> void {
    c.block(w, "
            inline const ASCIILiteral CSSSelector::selectorTextForPseudoClass(PseudoClass type)
            {
                switch (type) {")
    var index: usize = 0
    while index < pseudos.*.count {
        const name = pseudos.*.keys[index]
        const pseudo = pseudos.*.items[index]
        writeIf(w, pseudo)
        c.indent(w)
        c.write(w, t.c3("case PseudoClass::", enumName(name), ":"))
        c.indent(w)
        c.write(w, t.c3("return \":", name, "\"_s;"))
        c.outdent(w)
        c.outdent(w)
        writeEndif(w, pseudo)
        index += 1
    }
    c.indent(w)
    c.write(w, "default:")
    c.indent(w)
    c.write(w, "ASSERT_NOT_REACHED();")
    c.write(w, "return \"\"_s;")
    c.outdent(w)
    c.write(w, "}")
    c.outdent(w)
    c.write(w, "}")
}

fn writeNameForUserAgentPartLegacyAlias(w: *c.Writer, pseudos: *j.Value) -> void {
    c.block(w, "
            inline const ASCIILiteral CSSSelector::nameForUserAgentPartLegacyAlias(StringView alias)
            {")
    var index: usize = 0
    while index < pseudos.*.count {
        const name = pseudos.*.keys[index]
        const pseudo = pseudos.*.items[index]
        const aliases = j.get(pseudo, "aliases")
        if j.boolAt(pseudo, "user-agent-part", false) && aliases != null {
            writeIf(w, pseudo)
            c.indent(w)
            var at: usize = 0
            while at < aliases.?.*.count {
                c.write(w, t.c3("if (equalLettersIgnoringASCIICase(alias, \"", aliases.?.*.items[at].*.text, "\"_s))"))
                c.indent(w)
                c.write(w, t.c3("return \"", name, "\"_s;"))
                c.outdent(w)
                at += 1
            }
            c.outdent(w)
            writeEndif(w, pseudo)
        }
        index += 1
    }
    c.indent(w)
    c.write(w, "ASSERT_NOT_REACHED();")
    c.write(w, "return \"\"_s;")
    c.outdent(w)
    c.write(w, "}")
}

fn writeArgumentCheck(w: *c.Writer, function: []const u8, enumType: []const u8, optionalToo: bool, pseudos: *j.Value) -> void {
    c.block(w, t.c5("
            inline bool CSSSelector::", function, "(", enumType, " type)
            {
                switch (type) {"))
    var index: usize = 0
    while index < pseudos.*.count {
        const name = pseudos.*.keys[index]
        const pseudo = pseudos.*.items[index]
        const argument = j.stringAt(pseudo, "argument", "")
        if std.text.same(argument, "required") || (optionalToo && std.text.same(argument, "optional")) {
            writeIf(w, pseudo)
            c.indent(w)
            c.write(w, t.c5("case ", enumType, "::", enumName(name), ":"))
            c.outdent(w)
            writeEndif(w, pseudo)
        }
        index += 1
    }
    c.indent(w)
    c.indent(w)
    c.write(w, "return true;")
    c.outdent(w)
    c.outdent(w)
    writeDefaultReturn(w, "return false;")
}

fn inlinesFile(data: *j.Value) -> []const u8 {
    var writer = c.writer()
    const w = &writer
    const classes = j.get(data, "pseudo-classes").?
    const elements = j.get(data, "pseudo-elements").?
    writeCopyright(w)
    writeAutogenerationComment(w)
    writePragmaOnce(w)
    c.newline(w)
    c.write(w, "#include \"CSSSelector.h\"")
    c.write(w, "#include \"CSSSelectorParserContext.h\"")
    c.write(w, "#include \"DeprecatedGlobalSettings.h\"")
    c.write(w, "#include <wtf/text/StringView.h>")
    openNamespace(w)
    writeIsPseudoClassEnabled(w, classes)
    writeIsPseudoElementEnabled(w, elements)
    writeSelectorTextForPseudoClass(w, classes)
    writeNameForUserAgentPartLegacyAlias(w, elements)
    writeArgumentCheck(w, "pseudoClassRequiresArgument", "PseudoClass", false, classes)
    writeArgumentCheck(w, "pseudoElementRequiresArgument", "PseudoElement", false, elements)
    writeArgumentCheck(w, "pseudoClassMayHaveArgument", "PseudoClass", true, classes)
    writeArgumentCheck(w, "pseudoElementMayHaveArgument", "PseudoElement", true, elements)
    closeNamespace(w)
    return c.written(w)
}

// ---------------------------------------------------------------------------
// UserAgentParts.h and UserAgentParts.cpp

fn isPart(pseudo: *j.Value) -> bool { return j.has(pseudo, "user-agent-part") || j.has(pseudo, "user-agent-part-string") }

fn partsHeader(elements: *j.Value) -> []const u8 {
    var writer = c.writer()
    const w = &writer
    writeCopyright(w)
    writeAutogenerationComment(w)
    writePragmaOnce(w)
    c.newline(w)
    c.write(w, "#include <wtf/Forward.h>")
    c.newline(w)
    c.write(w, "namespace WebCore::UserAgentParts {")
    c.newline(w)
    var index: usize = 0
    while index < elements.*.count {
        const pseudo = elements.*.items[index]
        if isPart(pseudo) {
            writeIf(w, pseudo)
            c.write(w, t.c3("const AtomString& ", functionName(elements.*.keys[index]), "();"))
            writeEndif(w, pseudo)
        }
        index += 1
    }
    c.newline(w)
    c.write(w, "} // WebCore::UserAgentParts")
    return c.written(w)
}

fn partsImplementation(elements: *j.Value) -> []const u8 {
    var writer = c.writer()
    const w = &writer
    writeCopyright(w)
    writeAutogenerationComment(w)
    c.newline(w)
    c.write(w, "#include \"config.h\"")
    c.write(w, "#include \"UserAgentParts.h\"")
    c.newline(w)
    c.write(w, "#include <wtf/NeverDestroyed.h>")
    c.write(w, "#include <wtf/text/AtomString.h>")
    c.newline(w)
    c.write(w, "namespace WebCore::UserAgentParts {")
    c.newline(w)
    var index: usize = 0
    while index < elements.*.count {
        const pseudo = elements.*.items[index]
        if isPart(pseudo) {
            const name = elements.*.keys[index]
            const function = functionName(name)
            writeIf(w, pseudo)
            c.write(w, t.c3("const AtomString& ", function, "()"))
            c.write(w, "{")
            c.indent(w)
            c.write(w, t.c5("static MainThreadNeverDestroyed<const AtomString> ", function, "(\"", name, "\"_s);"))
            c.write(w, t.c3("return ", function, ";"))
            c.outdent(w)
            c.write(w, "}")
            writeEndif(w, pseudo)
            c.newline(w)
        }
        index += 1
    }
    c.write(w, "} // WebCore::UserAgentParts")
    return c.written(w)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var definesText: []const u8 = ""
    var first: usize = 1
    if arguments.length > 2 && std.text.same(s.cString(arguments[1]), "--defines") {
        definesText = s.cString(arguments[2])
        first = 3
    }
    if arguments.length != first + 2 {
        s.say("usage: webkit-css-pseudo-selectors [--defines DEFINES] OUTPUT_DIRECTORY CSSPseudoSelectors.json\n")
        return 2
    }
    // [i.strip() for i in defines.split(' ')]
    const words = c.splitSpaces(definesText)
    defines = t.list()
    var index: usize = 0
    while index < words.count {
        t.push(&defines, t.rstrip(s.trimStart(words.items[index])))
        index += 1
    }
    const directory = s.cString(arguments[first])
    const path = s.cString(arguments[first + 1])
    const text = c.readFile(path)
    const data = j.parse(text, path)
    validate(data, "pseudo-classes", false, 5)
    validate(data, "pseudo-elements", true, 59)
    c.writeFile(directory, "CSSPseudoSelectors.json", text)
    c.writeFile(directory, "SelectorPseudoClassAndCompatibilityElementMap.gperf", gperfFile(true, pseudoClassMap(data)))
    c.writeFile(directory, "SelectorPseudoElementMap.gperf", gperfFile(false, pseudoElementMap(data)))
    c.writeFile(directory, "CSSSelectorEnums.h", enumsFile(data))
    c.writeFile(directory, "CSSSelectorInlines.h", inlinesFile(data))
    const elements = j.get(data, "pseudo-elements").?
    c.writeFile(directory, "UserAgentParts.h", partsHeader(elements))
    c.writeFile(directory, "UserAgentParts.cpp", partsImplementation(elements))
    return 0
}
