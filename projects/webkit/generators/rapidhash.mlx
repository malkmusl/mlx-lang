// rapidhash on the bytes of a string, masked as WTF's StringHasher masks
// it: the hash WebKit's generators put in their tables (create_hash_table,
// the Unicode property tables of yarr) for the hash tables of
// JavaScriptCore to find them by.
const SECRET0: u64 = 3257665815644502181
const SECRET1: u64 = 10067880064238660809
const SECRET2: u64 = 5418857496715711651

fn mix(a: u64, b: u64) -> u64 {
    const product = @intCast(u128, a) * @intCast(u128, b)
    return @intCast(u64, product & 18446744073709551615) ^ @intCast(u64, product >> 64)
}

fn read64(key: []const u8, at: usize) -> u64 {
    var value: u64 = 0
    var index: usize = 8
    while index > 0 {
        index -= 1
        value = (value << 8) | @intCast(u64, key[at + index])
    }
    return value
}

fn read32(key: []const u8, at: usize) -> u64 {
    return @intCast(u64, key[at]) | (@intCast(u64, key[at + 1]) << 8) | (@intCast(u64, key[at + 2]) << 16) | (@intCast(u64, key[at + 3]) << 24)
}

pub fn hash(key: []const u8) -> u64 {
    const length = @intCast(u64, key.length)
    var seed = mix(SECRET0, SECRET1) ^ length
    var a: u64 = 0
    var b: u64 = 0
    if key.length <= 16 {
        if key.length >= 4 {
            const delta: usize = if key.length >= 8 { 4 } else { 0 }
            a = (read32(key, 0) << 32) | read32(key, key.length - 4)
            b = (read32(key, delta) << 32) | read32(key, key.length - 4 - delta)
        } else if key.length > 0 {
            a = (@intCast(u64, key[0]) << 56) | (@intCast(u64, key[key.length >> 1]) << 32) | @intCast(u64, key[key.length - 1])
        }
    } else {
        var rest = key.length
        var off: usize = 0
        if rest > 48 {
            var see1 = seed
            var see2 = seed
            while true {
                seed = mix(read64(key, off) ^ SECRET0, read64(key, off + 8) ^ seed)
                see1 = mix(read64(key, off + 16) ^ SECRET1, read64(key, off + 24) ^ see1)
                see2 = mix(read64(key, off + 32) ^ SECRET2, read64(key, off + 40) ^ see2)
                off += 48
                rest -= 48
                if rest < 48 { break }
            }
            seed ^= see1 ^ see2
        }
        if rest > 16 {
            seed = mix(read64(key, off) ^ SECRET2, read64(key, off + 8) ^ seed ^ SECRET1)
            if rest > 32 { seed = mix(read64(key, off + 16) ^ SECRET2, read64(key, off + 24) ^ seed) }
        }
        a = read64(key, off + rest - 16)
        b = read64(key, off + rest - 8)
    }
    a ^= SECRET1
    b ^= seed
    const product = @intCast(u128, a) * @intCast(u128, b)
    a = @intCast(u64, product & 18446744073709551615)
    b = @intCast(u64, product >> 64)
    // 24 bits (StringImpl keeps 8 for flags), never 0 ("not hashed yet").
    const value = mix(a ^ SECRET0 ^ length, b ^ SECRET1) & 16777215
    return if value == 0 { 8388608 } else { value }
}
