// The builtins of JavaScriptCore and WebCore as WebKit's builtins
// generator (Scripts/wkbuiltins/builtins_model.py) reads them from their
// JavaScript files: each file an object, its functions found and cut out
// by the script's regular expressions, their @annotations read, and the
// copyright lines of every file's first comment gathered. What the
// script's patterns match is matched here by the same patterns.
const std = @import("std")
const s = @import("./support.mlx")
const re = @import("./pyregex.mlx")

pub const JAVASCRIPTCORE: u8 = 0
pub const WEBCORE: u8 = 1

pub const Function = struct {
    name: []const u8
    // The text as embedded: comments gone, some annotations taken out.
    source: []const u8
    parameters: [*][]const u8
    parameterCount: usize
    isAsync: bool
    isConstructor: bool
    isLinkTimeConstant: bool
    isNakedConstructor: bool
    isAlwaysInline: bool
    intrinsic: []const u8
    visibility: []const u8
    overriddenName: []const u8
    object: usize
}

pub const Object = struct {
    name: []const u8
    // The annotations of the file, `// @key=value` and `// @flag` lines
    // (a flag's value is "").
    keys: [*][]const u8
    values: [*][]const u8
    annotationCount: usize
    // Its functions, in the order of the file, from this one on.
    firstFunction: usize
    functionCount: usize
}

const MAX_FUNCTIONS: usize = 8192
const MAX_OBJECTS: usize = 512
const MAX_COPYRIGHTS: usize = 4096
const MAX_ANNOTATIONS: usize = 64

pub var functions: [*]Function = undefined
pub var functionCount: usize = 0
pub var objects: [*]Object = undefined
pub var objectCount: usize = 0
// The copyright lines met, each once (the script's set).
var copyrightLines: [*][]const u8 = undefined
var copyrightLineCount: usize = 0

pub var framework: u8 = 0
// Whether the run is a Debug configuration (CONFIGURATION unset or
// starting with Debug): otherwise the embedded sources are minified.
pub var debug: bool = true

var functionHead: *re.Regex = undefined
var linkTimeConstant: *re.Regex = undefined
var alwaysInline: *re.Regex = undefined
var visibilityAnnotation: *re.Regex = undefined
var nakedConstructor: *re.Regex = undefined
var intrinsicAnnotation: *re.Regex = undefined
var constructorAnnotation: *re.Regex = undefined
var getterAnnotation: *re.Regex = undefined
var asyncFunction: *re.Regex = undefined
var functionName: *re.Regex = undefined
var overriddenNameAnnotation: *re.Regex = undefined
var parameterFinder: *re.Regex = undefined
var parametersSplitter: *re.Regex = undefined
var multilineComment: *re.Regex = undefined
var singleLineComment: *re.Regex = undefined
var keyValueAnnotation: *re.Regex = undefined
var flagAnnotation: *re.Regex = undefined
var lineWithOnlySingleLineComment: *re.Regex = undefined
var lineWithTrailingSingleLineComment: *re.Regex = undefined
var leadingWhitespace: *re.Regex = undefined
var multipleEmptyLines: *re.Regex = undefined
var copyrightYear: *re.Regex = undefined
var ownerStart: *re.Regex = undefined

pub fn fail(message: []const u8) -> void { s.fail(s.join("ParseException: ", message)) }

// FRAMEWORK is "JavaScriptCore" or "WebCore"; ENVIRONMENT the program's.
pub fn begin(name: []const u8, environment: [*][*]const u8) -> void {
    if std.text.same(name, "JavaScriptCore") {
        framework = JAVASCRIPTCORE
    } else if std.text.same(name, "WebCore") {
        framework = WEBCORE
    } else {
        fail(s.join("Unknown framework: ", name))
    }
    const configuration = std.process.environmentFrom(environment, "CONFIGURATION")
    if configuration != null {
        const value = configuration.?.pointer[0..configuration.?.length]
        debug = s.startsWith(value, "Debug")
    }
    unsafe {
        functions = @ptrFromInt([*]Function, s.alloc(MAX_FUNCTIONS * @sizeOf(Function)))
        objects = @ptrFromInt([*]Object, s.alloc(MAX_OBJECTS * @sizeOf(Object)))
        copyrightLines = @ptrFromInt([*][]const u8, s.alloc(MAX_COPYRIGHTS * 16))
    }
    const flags = re.MULTILINE | re.DOTALL
    functionHead = re.compile("(?:@[\\w|=\\[\\] \\\"\\.]+\\s*\\n)*(?:async\\s+)?function\\s+\\w+\\s*\\(.*?\\)", flags)
    linkTimeConstant = re.compile(".*^@linkTimeConstant", flags)
    alwaysInline = re.compile(".*^@alwaysInline", flags)
    visibilityAnnotation = re.compile(".*^@visibility=(\\w+)", flags)
    nakedConstructor = re.compile(".*^@nakedConstructor", flags)
    intrinsicAnnotation = re.compile(".*^@intrinsic=(\\w+)", flags)
    constructorAnnotation = re.compile(".*^@constructor", flags)
    getterAnnotation = re.compile(".*^@getter", flags)
    asyncFunction = re.compile(".*^(async)?\\s*function", flags)
    functionName = re.compile("function\\s+(\\w+)\\s*\\(", flags)
    overriddenNameAnnotation = re.compile(".*^@overriddenName=(\\\".+\\\")$", flags)
    parameterFinder = re.compile("^(?:async\\s+)?function\\s+(?:\\w+)\\s*\\(((?:\\s*\\w+)?\\s*(?:\\s*,\\s*\\w+)*)?\\s*\\)", flags)
    parametersSplitter = re.compile(",\\s*(?![^{}]*\\})", flags)
    multilineComment = re.compile("\\/\\*.*?\\*\\/", flags)
    singleLineComment = re.compile("\\/\\/.*?\\n", flags)
    keyValueAnnotation = re.compile("^\\/\\/ @(\\w+)=([^=]+?)\\n", flags)
    flagAnnotation = re.compile("^\\/\\/ @(\\w+)[^=]*?\\n", flags)
    lineWithOnlySingleLineComment = re.compile("^\\s*\\/\\/\\n", flags)
    lineWithTrailingSingleLineComment = re.compile("\\s*\\/\\/\\n", flags)
    leadingWhitespace = re.compile("^ +", flags)
    multipleEmptyLines = re.compile("\\n{2,}", flags)
    copyrightYear = re.compile("(\\d{4})[, ]{0,2}", 0)
    ownerStart = re.compile("[^\\d, ]", 0)
}

// ---------------------------------------------------------------------------
// Copyrights.

const DEFAULT_COPYRIGHT = "2016 Apple Inc. All rights reserved."

fn addCopyrightLine(line: []const u8) -> void {
    var index: usize = 0
    while index < copyrightLineCount {
        if std.text.same(copyrightLines[index], line) { return }
        index += 1
    }
    if copyrightLineCount == MAX_COPYRIGHTS { fail("too many copyright lines") }
    copyrightLines[copyrightLineCount] = line
    copyrightLineCount += 1
}

// The lines of the first comment before "Redistribution", without the
// comment's marks and the word Copyright.
fn parseCopyrightLines(text: []const u8) -> void {
    const comment = re.search(multilineComment, text, 0)
    if !comment.found { fail("a file without a comment") }
    var block = re.group(comment, text, 0)
    const cut = s.find(block, "Redistribution")
    if cut == block.length { fail("substring not found: Redistribution") }
    block = block[0..cut]
    addCopyrightLine(DEFAULT_COPYRIGHT)
    var at: usize = 0
    var lineStart: usize = 0
    while at <= block.length {
        if at == block.length || block[at] == 10 {
            var line = block[lineStart..at]
            line = re.replaceAll(line, "/*", "")
            line = re.replaceAll(line, "*/", "")
            line = re.replaceAll(line, "*", "")
            line = re.replaceAll(line, "Copyright", "")
            line = re.replaceAll(line, "copyright", "")
            line = re.replaceAll(line, "(C)", "")
            line = re.replaceAll(line, "(c)", "")
            line = re.strip(line)
            if line.length > 0 { addCopyrightLine(line) }
            lineStart = at + 1
        }
        at += 1
    }
}

pub fn less(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

// Sorts the texts in place (stably, as Python sorts).
pub fn sortTexts(items: [*][]const u8, count: usize) -> void {
    var index: usize = 1
    while index < count {
        const item = items[index]
        var at = index
        while at > 0 && less(item, items[at - 1]) {
            items[at] = items[at - 1]
            at -= 1
        }
        items[at] = item
        index += 1
    }
}

// The copyrights, one per owner: "YEARS OWNER", the years of all the
// owner's lines joined (sorted, each once), the list sorted.
pub fn copyrights(count: *usize) -> [*][]const u8 {
    var owners: [*][]const u8 = undefined
    var years: [*][*][]const u8 = undefined
    var yearCounts: [*]usize = undefined
    unsafe {
        owners = @ptrFromInt([*][]const u8, s.alloc((copyrightLineCount + 1) * 16))
        years = @ptrFromInt([*][*][]const u8, s.alloc((copyrightLineCount + 1) * 8))
        yearCounts = @ptrFromInt([*]usize, s.alloc((copyrightLineCount + 1) * 8))
    }
    var ownerCount: usize = 0
    var index: usize = 0
    while index < copyrightLineCount {
        const line = copyrightLines[index]
        const ownerMatch = re.search(ownerStart, line, 0)
        if !ownerMatch.found { s.fail("AttributeError: a copyright line without an owner") }
        const owner = line[re.start(ownerMatch, 0)..line.length]
        var which: usize = 0
        while which < ownerCount && !std.text.same(owners[which], owner) { which += 1 }
        if which == ownerCount {
            owners[ownerCount] = owner
            unsafe { years[ownerCount] = @ptrFromInt([*][]const u8, s.alloc(line.length * 16 + 16)) }
            yearCounts[ownerCount] = 0
            ownerCount += 1
        }
        var at: usize = 0
        while at <= line.length {
            const m = re.search(copyrightYear, line, at)
            if !m.found { break }
            const year = re.group(m, line, 1)
            var known = false
            var y: usize = 0
            while y < yearCounts[which] {
                if std.text.same(years[which][y], year) { known = true }
                y += 1
            }
            if !known {
                years[which][yearCounts[which]] = year
                yearCounts[which] += 1
            }
            at = re.after(m)
        }
        index += 1
    }
    var result: [*][]const u8 = undefined
    unsafe { result = @ptrFromInt([*][]const u8, s.alloc((ownerCount + 1) * 16)) }
    index = 0
    while index < ownerCount {
        sortTexts(years[index], yearCounts[index])
        var text: []const u8 = ""
        var y: usize = 0
        while y < yearCounts[index] {
            if y > 0 { text = s.join(text, ", ") }
            text = s.join(text, years[index][y])
            y += 1
        }
        result[index] = s.join3(text, " ", owners[index])
        index += 1
    }
    sortTexts(result, ownerCount)
    count.* = ownerCount
    return result
}

// ---------------------------------------------------------------------------
// Annotations of a file.

fn addAnnotation(o: *Object, key: []const u8, value: []const u8) -> void {
    var index: usize = 0
    while index < o.*.annotationCount {
        if std.text.same(o.*.keys[index], key) { fail(s.join("Duplicate annotation found: ", key)) }
        index += 1
    }
    if o.*.annotationCount == MAX_ANNOTATIONS { fail("too many annotations") }
    o.*.keys[o.*.annotationCount] = key
    o.*.values[o.*.annotationCount] = value
    o.*.annotationCount += 1
}

fn parseAnnotations(o: *Object, text: []const u8) -> void {
    var at: usize = 0
    while at <= text.length {
        const m = re.search(keyValueAnnotation, text, at)
        if !m.found { break }
        addAnnotation(o, re.group(m, text, 1), re.group(m, text, 2))
        at = re.after(m)
    }
    at = 0
    while at <= text.length {
        const m = re.search(flagAnnotation, text, at)
        if !m.found { break }
        addAnnotation(o, re.group(m, text, 1), "")
        at = re.after(m)
    }
}

pub fn hasAnnotation(o: *const Object, key: []const u8) -> bool {
    var index: usize = 0
    while index < o.*.annotationCount {
        if std.text.same(o.*.keys[index], key) { return true }
        index += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Functions.

// Where the first match of R is, or not.
fn matches(r: *re.Regex, text: []const u8) -> bool { return re.matchAt(r, text, 0).found }

fn functionFrom(text: []const u8, object: usize) -> Function {
    var source = re.sub(multilineComment, text, "")

    var intrinsic: []const u8 = "NoIntrinsic"
    if s.contains(source, "@intrinsic=") {
        const m = re.search(intrinsicAnnotation, source, 0)
        if m.found {
            intrinsic = re.group(m, source, 1)
            source = re.replaceAll(source, re.group(m, source, 0), "")
        }
    }

    var overriddenName: []const u8 = ""
    var overridden = false
    if s.contains(source, "@overriddenName=") {
        const m = re.search(overriddenNameAnnotation, source, 0)
        if m.found {
            overriddenName = re.group(m, source, 1)
            overridden = true
            source = re.replaceAll(source, re.group(m, source, 0), "")
        }
    }

    if !debug {
        source = re.sub(lineWithOnlySingleLineComment, source, "")
        source = re.sub(lineWithTrailingSingleLineComment, source, "\n")
        source = re.sub(leadingWhitespace, source, "")
        source = re.sub(multipleEmptyLines, source, "\n")
    }

    const nameMatch = re.search(functionName, source, 0)
    if !nameMatch.found { s.fail("IndexError: a function without a name") }
    const name = re.group(nameMatch, source, 1)
    const asyncMatch = re.matchAt(asyncFunction, source, 0)
    const isAsync = asyncMatch.found && std.text.same(re.group(asyncMatch, source, 1), "async")
    var isConstructor = matches(constructorAnnotation, source)
    const isGetter = matches(getterAnnotation, source)
    const isLinkTimeConstant = matches(linkTimeConstant, source)
    const isNakedConstructor = matches(nakedConstructor, source)
    const isAlwaysInline = matches(alwaysInline, source)
    if isNakedConstructor { isConstructor = true }

    var visibility: []const u8 = "Public"
    if s.contains(source, "@visibility=") {
        const m = re.search(visibilityAnnotation, source, 0)
        if m.found {
            visibility = re.group(m, source, 1)
            source = re.replaceAll(source, visibility, "")
        }
    } else if isLinkTimeConstant {
        visibility = "Private"
    }

    const found = re.search(parameterFinder, source, 0)
    if !found.found { s.fail(s.join("IndexError: no parameters found for ", name)) }
    const pieces = re.split(parametersSplitter, re.group(found, source, 1))
    var parameters: [*][]const u8 = undefined
    unsafe { parameters = @ptrFromInt([*][]const u8, s.alloc((pieces.count + 1) * 16)) }
    var index: usize = 0
    while index < pieces.count {
        parameters[index] = re.strip(pieces.items[index])
        index += 1
    }
    var parameterCount = pieces.count
    if parameters[0].length == 0 { parameterCount = 0 }

    if isGetter && !overridden {
        overriddenName = s.join3("\"get ", name, "\"_s")
        overridden = true
    }
    if !overridden { overriddenName = "ASCIILiteral()" }
    if overriddenName[overriddenName.length - 1] == 34 { overriddenName = s.join(overriddenName, "_s") }

    return Function.{ .name = name, .source = source, .parameters = parameters, .parameterCount = parameterCount,
        .isAsync = isAsync, .isConstructor = isConstructor, .isLinkTimeConstant = isLinkTimeConstant,
        .isNakedConstructor = isNakedConstructor, .isAlwaysInline = isAlwaysInline, .intrinsic = intrinsic,
        .visibility = visibility, .overriddenName = overriddenName, .object = object }
}

fn isQuote(byte: u8) -> bool { return byte == 96 || byte == 39 || byte == 34 }

// The functions of TEXT: each from its head (annotations, `function`,
// name and parameters) to the brace closing its body, braces in strings
// not counted.
fn parseFunctions(source: []const u8, object: usize) -> void {
    const text = re.sub(multilineComment, re.sub(singleLineComment, source, "//\n"), "/**/")
    var from: usize = 0
    var end: usize = 0
    while from <= text.length {
        const m = re.search(functionHead, text, from)
        if !m.found { break }
        from = re.after(m)
        const start = re.start(m, 0)
        if start < end { continue }
        end = re.end(m, 0)
        while true {
            if end >= text.length { s.fail("IndexError: string index out of range") }
            if text[end] == 123 { break }
            end += 1
        }
        var depth: usize = 1
        var escaping = false
        // The quote of the string the scan is in, or 0.
        var quote: u8 = 0
        while depth > 0 {
            end += 1
            if end >= text.length { s.fail("IndexError: string index out of range") }
            const byte = text[end]
            if escaping {
                escaping = false
                continue
            }
            if isQuote(byte) {
                if quote == 0 {
                    quote = byte
                } else if byte == quote {
                    quote = 0
                }
                continue
            }
            if byte == 92 && quote != 0 {
                escaping = true
                continue
            }
            // A regular expression with a lone quote would leave the scan
            // in a string: the script forgets the string at each line's
            // end, unless it is a template.
            if byte == 10 && quote != 96 {
                quote = 0
                continue
            }
            if quote != 0 { continue }
            if byte == 123 {
                depth += 1
            } else if byte == 125 {
                depth -= 1
            }
        }
        end += 1
        if functionCount == MAX_FUNCTIONS { fail("too many functions") }
        functions[functionCount] = functionFrom(re.strip(text[start..end]), object)
        functionCount += 1
    }
}

// ---------------------------------------------------------------------------
// Files.

// TEXT with its line ends made \n, as Python reads a text file.
fn universalNewlines(text: []const u8) -> []const u8 {
    if !s.contains(text, "\r") { return text }
    const result = s.alloc(text.length + 1)
    var written: usize = 0
    var index: usize = 0
    while index < text.length {
        if text[index] == 13 {
            s.put8(result + written, 10)
            if index + 1 < text.length && text[index + 1] == 10 { index += 1 }
        } else {
            s.put8(result + written, text[index])
        }
        written += 1
        index += 1
    }
    return s.bytes(result, written)
}

// The name of the framework's test files (Framework-Object-options.js)
// is the object's.
fn objectFileName(path: []const u8) -> []const u8 {
    const name = s.baseName(path)
    const prefix = if framework == JAVASCRIPTCORE { "JavaScriptCore" } else { "WebCore" }
    if !s.startsWith(name, prefix) { return name }
    var dashes: usize = 0
    var first: usize = 0
    var second: usize = 0
    var index: usize = 0
    while index < name.length {
        if name[index] == 45 {
            dashes += 1
            if dashes == 1 { first = index }
            if dashes == 2 { second = index }
        }
        index += 1
    }
    if dashes != 2 { s.fail("ValueError: a test file name not of three parts") }
    return s.join(name[first + 1..second], ".js")
}

// The name without its extension (os.path.splitext).
fn withoutExtension(name: []const u8) -> []const u8 {
    var dot = name.length
    while dot > 0 && name[dot - 1] != 46 { dot -= 1 }
    if dot == 0 { return name }
    // Leading dots do not start an extension.
    var leading: usize = 0
    while leading < name.length && name[leading] == 46 { leading += 1 }
    if dot - 1 < leading { return name }
    return name[0..dot - 1]
}

pub fn parseFile(path: []const u8) -> void {
    const text = universalNewlines(s.readWhole(path))
    parseCopyrightLines(text)
    if objectCount == MAX_OBJECTS { fail("too many files") }
    const index = objectCount
    objectCount += 1
    var keys: [*][]const u8 = undefined
    var values: [*][]const u8 = undefined
    unsafe {
        keys = @ptrFromInt([*][]const u8, s.alloc(MAX_ANNOTATIONS * 16))
        values = @ptrFromInt([*][]const u8, s.alloc(MAX_ANNOTATIONS * 16))
    }
    objects[index] = Object.{ .name = withoutExtension(objectFileName(path)), .keys = keys, .values = values,
        .annotationCount = 0, .firstFunction = functionCount, .functionCount = 0 }
    parseAnnotations(&objects[index], text)
    parseFunctions(text, index)
    objects[index].functionCount = functionCount - objects[index].firstFunction
}

// All the functions (or those of objects annotated `internal`), sorted
// by name, stably: their indexes, COUNT set.
pub fn sortedFunctions(internalOnly: bool, count: *usize) -> [*]usize {
    var order: [*]usize = undefined
    unsafe { order = @ptrFromInt([*]usize, s.alloc((functionCount + 1) * 8)) }
    var total: usize = 0
    var index: usize = 0
    while index < functionCount {
        if !internalOnly || hasAnnotation(&objects[functions[index].object], "internal") {
            order[total] = index
            total += 1
        }
        index += 1
    }
    index = 1
    while index < total {
        const item = order[index]
        var at = index
        while at > 0 && less(functions[item].name, functions[order[at - 1]].name) {
            order[at] = order[at - 1]
            at -= 1
        }
        order[at] = item
        index += 1
    }
    count.* = total
    return order
}
