// The data WebCore keeps in sync between its processes, as
// Source/WebCore/Scripts/generate-process-sync-data.py makes it from a
// description (page/DocumentSyncData.in, page/FrameTreeSyncData.in):
//
//     webkit-process-sync-data PREFIX DESCRIPTION.in [OUTPUT_DIRECTORY]
//
// Each line not a comment (#) is "Name : Type" or "Name : Namespace::Type",
// perhaps followed by [Conditional=... Headers=<a>,<b>], read with the
// script's regular expressions. Five files are made: PREFIXSyncClient.h
// and .cpp (a broadcast function per datum), PREFIXSyncData.h and .cpp
// (the class holding the data, updated from a serialized variant), and
// PREFIXSyncData.serialization.in (for WebKit's serializers). The
// variant takes the conditional data first; the class's members put them
// before the last unconditional one, as the script does.
const std = @import("std")
const s = @import("./support.mlx")
const re = @import("./pyregex.mlx")

const HEADER_LICENSE = "/*\n * Copyright (C) 2025 Apple Inc. All rights reserved.\n *\n * Redistribution and use in source and binary forms, with or without\n * modification, are permitted provided that the following conditions\n * are met:\n * 1.  Redistributions of source code must retain the above copyright\n *     notice, this list of conditions and the following disclaimer.\n * 2.  Redistributions in binary form must reproduce the above copyright\n *     notice, this list of conditions and the following disclaimer in the\n *     documentation and/or other materials provided with the distribution.\n *\n * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS'' AND\n * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n * WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n * DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS BE LIABLE FOR\n * ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL\n * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR\n * SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER\n * CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,\n * OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n */\n"
const PROCESS_SYNC_CLIENT_HEADER_PREFIX = "\nnamespace WebCore {\n\nclass {prefix}SyncData;\nstruct {prefix}SyncSerializationData;\n\nclass {prefix}SyncClient {\n    WTF_MAKE_TZONE_ALLOCATED_INLINE({prefix}SyncClient);\n\npublic:\n    {prefix}SyncClient() = default;\n    virtual ~{prefix}SyncClient() = default;\n\n    virtual void broadcastAll{prefix}SyncDataToOtherProcesses({prefix}SyncData&) { }\n"
const PROCESS_SYNC_CLIENT_HEADER_SUFFIX = "\nprotected:\n    virtual void broadcast{prefix}SyncDataToOtherProcesses(const {prefix}SyncSerializationData&) { }\n};\n\n} // namespace WebCore\n"
const PROCESS_SYNC_CLIENT_IMPL_PREFIX = "\n#include \"config.h\"\n#include \"{prefix}SyncClient.h\"\n\n#include \"{prefix}SyncData.h\"\n#include <wtf/EnumTraits.h>\n\nnamespace WebCore {\n"
const PROCESS_SYNC_DATA_HEADER_SUFFIX = "\nstruct {prefix}SyncSerializationData {\n    {prefix}SyncDataVariant value;\n};\n\n"
const SYNCED_DATA_HEADER_MIDFIX = "\nnamespace WebCore {\n\nstruct {prefix}SyncSerializationData;\n\nclass data_type_name : public RefCounted<data_type_name> {\nWTF_MAKE_TZONE_ALLOCATED_INLINE(data_type_name);\npublic:\n    template<typename... Args>\n    static Ref<data_type_name> create(Args&&... args)\n    {\n        return adoptRef(*new data_type_name(std::forward<Args>(args)...));\n    }\n    static Ref<data_type_name> create() { return adoptRef(*new data_type_name); }\n    WEBCORE_EXPORT void update(const {prefix}SyncSerializationData&);\n"
const SYNCHED_DATA_IMPL_PREFIX = "\n#include \"config.h\"\n#include \"data_type_name.h\"\n\n#include <wtf/EnumTraits.h>\n\nnamespace WebCore {\n\nvoid data_type_name::update(const {prefix}SyncSerializationData& data)\n{\n    switch (static_cast<{prefix}SyncDataType>(data.value.index())) {"
const SYNCHED_DATA_IMPL_MIDFIX = "    default:\n        RELEASE_ASSERT_NOT_REACHED();\n    }\n}\n"
const SERIALIZATION_IN_LICENSE = "#\n# Copyright (C) 2025 Apple Inc. All rights reserved.\n#\n# Redistribution and use in source and binary forms, with or without\n# modification, are permitted provided that the following conditions\n# are met:\n# 1.  Redistributions of source code must retain the above copyright\n#     notice, this list of conditions and the following disclaimer.\n# 2.  Redistributions in binary form must reproduce the above copyright\n#     notice, this list of conditions and the following disclaimer in the\n#     documentation and/or other materials provided with the distribution.\n#\n# THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS'' AND\n# ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n# WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n# DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS BE LIABLE FOR\n# ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL\n# DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR\n# SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER\n# CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY,\n# OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n# OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n#\n"
const PROCESS_SYNC_DATA_SERIALIZATION_IN_PREFIX = "\nheader: <WebCore/{prefix}SyncData.h>\n"
const PROCESS_SYNC_DATA_SERIALIZATION_IN_SUFFIX = "\n[CustomHeader] struct WebCore::{prefix}SyncSerializationData {\n    WebCore::{prefix}SyncDataVariant value;\n};\n"

const Datum = struct {
    name: []const u8
    // The type and, when it has one, its namespace and the two joined.
    underlyingType: []const u8
    hasNamespace: bool
    fullyQualifiedType: []const u8
    conditional: []const u8
    hasConditional: bool
    // The headers, as Headers= lists them (split at its commas).
    headers: [*][]const u8
    headerCount: usize
    variantIndex: usize
}

const MAX_DATA: usize = 1024
const MAX_HEADERS: usize = 64

var data: [*]Datum = undefined
var dataCount: usize = 0
// The data in variant order (conditional ones first) and in the class's
// order: indexes into data.
var variantOrder: [*]usize = undefined
var classOrder: [*]usize = undefined
var classCount: usize = 0
var prefixPointer: [*]const u8 = undefined
var prefixLength: usize = 0

fn prefix() -> []const u8 { return prefixPointer[0..prefixLength] }

fn failWith(message: []const u8) -> void { s.fail(s.join("Exception: ", message)) }

fn newDatum(name: []const u8, namespace: []const u8, hasNamespace: bool, underlyingType: []const u8, options: []const u8, hasOptions: bool) -> Datum {
    var headers: [*][]const u8 = undefined
    unsafe { headers = @ptrFromInt([*][]const u8, s.alloc(MAX_HEADERS * 16)) }
    var datum = Datum.{ .name = name, .underlyingType = underlyingType, .hasNamespace = hasNamespace,
        .fullyQualifiedType = if hasNamespace { s.join3(namespace, "::", underlyingType) } else { underlyingType },
        .conditional = "", .hasConditional = false, .headers = headers, .headerCount = 0, .variantIndex = 0 }
    if !hasOptions { return datum }
    // The options, split at whitespace.
    var at: usize = 0
    while at < options.length {
        if s.isSpace(options[at]) {
            at += 1
            continue
        }
        const start = at
        while at < options.length && !s.isSpace(options[at]) { at += 1 }
        const option = options[start..at]
        if std.text.startsWith(option, "Conditional=") {
            datum.conditional = option[12..option.length]
            datum.hasConditional = true
        } else if std.text.startsWith(option, "Headers=") {
            const list = option[8..option.length]
            datum.headerCount = 0
            var from: usize = 0
            var index: usize = 0
            while index <= list.length {
                if index == list.length || list[index] == 44 {
                    if datum.headerCount == MAX_HEADERS { s.fail("webkit-process-sync-data: too many headers") }
                    headers[datum.headerCount] = list[from..index]
                    datum.headerCount += 1
                    from = index + 1
                }
                index += 1
            }
        } else {
            failWith(s.join3("Invalid option argument '", option, "' found"))
        }
    }
    return datum
}

fn add(datum: Datum) -> void {
    if dataCount == MAX_DATA { s.fail("webkit-process-sync-data: too many data") }
    data[dataCount] = datum
    dataCount += 1
}

fn parse(path: []const u8) -> void {
    const withNamespaceAndOptions = re.compile("(.*) : (.*)::(.*) \\[(.*)\\]", 0)
    const withNamespace = re.compile("(.*) : (.*)::(.*)", 0)
    const withOptions = re.compile("(.*) : (.*) \\[(.*)\\]", 0)
    const plain = re.compile("(.*) : (.*)", 0)
    const text = s.readWhole(path)
    var at: usize = 0
    while at < text.length {
        const line = s.trimEnd(s.trimStart(s.nextLine(text, &at)))
        if std.text.startsWith(line, "#") { continue }
        var m = re.search(withNamespaceAndOptions, line, 0)
        if m.found {
            add(newDatum(re.group(m, line, 1), re.group(m, line, 2), true, re.group(m, line, 3), re.group(m, line, 4), true))
            continue
        }
        m = re.search(withNamespace, line, 0)
        if m.found {
            add(newDatum(re.group(m, line, 1), re.group(m, line, 2), true, re.group(m, line, 3), "", false))
            continue
        }
        m = re.search(withOptions, line, 0)
        if m.found {
            add(newDatum(re.group(m, line, 1), "", false, re.group(m, line, 2), re.group(m, line, 3), true))
            continue
        }
        m = re.search(plain, line, 0)
        if m.found { add(newDatum(re.group(m, line, 1), "", false, re.group(m, line, 2), "", false)) }
    }
}

// The two orders of the script.
fn order() -> void {
    unsafe {
        variantOrder = @ptrFromInt([*]usize, s.alloc((dataCount + 1) * 8))
        classOrder = @ptrFromInt([*]usize, s.alloc((dataCount + 1) * 8))
    }
    var count: usize = 0
    var index: usize = 0
    while index < dataCount {
        if data[index].hasConditional {
            variantOrder[count] = index
            count += 1
        }
        index += 1
    }
    var unconditional: usize = 0
    index = 0
    while index < dataCount {
        if !data[index].hasConditional {
            variantOrder[count] = index
            count += 1
            unconditional += 1
        }
        index += 1
    }
    if unconditional == 0 { failWith("Surprisingly, no unconditional types found (this will make it hard to construct the variant in a way that will compile)") }
    index = 0
    while index < dataCount {
        data[variantOrder[index]].variantIndex = index
        index += 1
    }
    // All the unconditional ones but the last, the conditional ones, the
    // last unconditional one; without conditional ones when there is only
    // one unconditional.
    classCount = 0
    var seen: usize = 0
    index = 0
    while index < dataCount {
        if !data[index].hasConditional {
            seen += 1
            if seen < unconditional {
                classOrder[classCount] = index
                classCount += 1
            }
        }
        index += 1
    }
    if unconditional > 1 {
        index = 0
        while index < dataCount {
            if data[index].hasConditional {
                classOrder[classCount] = index
                classCount += 1
            }
            index += 1
        }
    }
    index = dataCount
    while index > 0 {
        index -= 1
        if !data[index].hasConditional {
            classOrder[classCount] = index
            classCount += 1
            break
        }
    }
}

// ---------------------------------------------------------------------------
// Writing: each file a list of lines, "\n" between them.

var lineCount: usize = 0

fn line(text: []const u8) -> void {
    if lineCount > 0 { s.out("\n") }
    s.out(text)
    lineCount += 1
}

fn line3(first: []const u8, second: []const u8, third: []const u8) -> void { line(s.join3(first, second, third)) }

fn withPrefix(template: []const u8) -> []const u8 { return re.replaceAll(template, "{prefix}", prefix()) }

fn lowerFirst(name: []const u8) -> []const u8 {
    if name.length == 0 { return name }
    const at = s.alloc(name.length + 1)
    var index: usize = 0
    while index < name.length {
        s.put8(at + index, name[index])
        index += 1
    }
    if name[0] >= 65 && name[0] <= 90 { s.put8(at, name[0] + 32) }
    return s.bytes(at, name.length)
}

fn ifConditional(d: *const Datum) -> void { if d.*.hasConditional { line(s.join("#if ", d.*.conditional)) } }
fn endConditional(d: *const Datum) -> void { if d.*.hasConditional { line("#endif") } }

// The headers of the data in ORDER, each as given.
fn headerLines(list: [*]usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        const d = &data[list[index]]
        var h: usize = 0
        while h < d.*.headerCount {
            line(s.join("#include ", d.*.headers[h]))
            h += 1
        }
        index += 1
    }
}

fn clientHeader() -> void {
    lineCount = 0
    line(HEADER_LICENSE)
    line("#pragma once\n")
    headerLines(variantOrder, dataCount)
    line("#include <wtf/TZoneMallocInlines.h>")
    line(withPrefix(PROCESS_SYNC_CLIENT_HEADER_PREFIX))
    var index: usize = 0
    while index < dataCount {
        const d = &data[variantOrder[index]]
        ifConditional(d)
        line(s.join3(s.join3("    WEBCORE_EXPORT void broadcast", d.*.name, "ToOtherProcesses(const "), d.*.fullyQualifiedType, "&);"))
        endConditional(d)
        index += 1
    }
    line(withPrefix(PROCESS_SYNC_CLIENT_HEADER_SUFFIX))
}

fn clientImplementation() -> void {
    const p = prefix()
    lineCount = 0
    line(HEADER_LICENSE)
    line(withPrefix(PROCESS_SYNC_CLIENT_IMPL_PREFIX))
    var index: usize = 0
    while index < dataCount {
        const d = &data[variantOrder[index]]
        ifConditional(d)
        line(s.join3(s.join3("void ", p, "SyncClient::broadcast"), d.*.name, s.join3("ToOtherProcesses(const ", d.*.fullyQualifiedType, "& data)")))
        line("{")
        line(s.join3(s.join3(s.join3("    broadcast", p, "SyncDataToOtherProcesses({ "), p, s.join3("SyncDataVariant { WTF::InPlaceIndex<std::to_underlying(", p, "SyncDataType::")), d.*.name, ")>, data } });"))
        line("}")
        endConditional(d)
        index += 1
    }
    line("\n} // namespace WebCore\n")
}

fn dataTypes() -> void {
    const p = prefix()
    line3("enum class ", p, "SyncDataType : uint8_t {")
    var index: usize = 0
    while index < dataCount {
        const d = &data[variantOrder[index]]
        ifConditional(d)
        line(s.join3(s.join3("    ", d.*.name, " = "), s.decimal(@intCast(u64, d.*.variantIndex)), ","))
        endConditional(d)
        index += 1
    }
    line("};")
    line("")
    line(s.join3(s.join3("static const ", p, "SyncDataType all"), p, "SyncDataTypes[] = {"))
    index = 0
    while index < classCount {
        const d = &data[classOrder[index]]
        ifConditional(d)
        line(s.join3(if index == 0 { "    " } else { "    , " }, p, s.join("SyncDataType::", d.*.name)))
        endConditional(d)
        index += 1
    }
    line("};")
    line("")
    index = 0
    while index < dataCount {
        const d = &data[variantOrder[index]]
        if d.*.hasConditional {
            line(s.join("#if !", d.*.conditional))
            line3("using ", d.*.underlyingType, " = bool;")
            line("#endif")
        }
        index += 1
    }
    line("")
    line3("using ", p, "SyncDataVariant = Variant<")
    index = 0
    while index < dataCount {
        const d = &data[variantOrder[index]]
        line3("    ", d.*.fullyQualifiedType, if index + 1 < dataCount { "," } else { "" })
        index += 1
    }
    line(">;")
    line(withPrefix(PROCESS_SYNC_DATA_HEADER_SUFFIX))
}

// What was written since FROM, "data_type_name" made PREFIXSyncData.
fn named(from: usize) -> []const u8 {
    const all = s.output()
    return re.replaceAll(all[from..all.length], "data_type_name", s.join(prefix(), "SyncData"))
}

fn dataHeader() -> void {
    lineCount = 0
    line(HEADER_LICENSE)
    line("#pragma once\n")
    line("#include <wtf/TZoneMallocInlines.h>")
    line("#include <wtf/Ref.h>")
    line("#include <wtf/RefCounted.h>")
    headerLines(classOrder, classCount)
    line(withPrefix(SYNCED_DATA_HEADER_MIDFIX))
    var index: usize = 0
    while index < classCount {
        const d = &data[classOrder[index]]
        ifConditional(d)
        line(s.join3(s.join3("    ", d.*.fullyQualifiedType, " "), lowerFirst(d.*.name), " { };"))
        endConditional(d)
        index += 1
    }
    line("")
    line("private:")
    line("    data_type_name() = default;")
    line("    WEBCORE_EXPORT data_type_name(")
    index = 0
    while index < classCount {
        const d = &data[classOrder[index]]
        ifConditional(d)
        line(s.join(if index == 0 { "        " } else { "      , " }, d.*.fullyQualifiedType))
        endConditional(d)
        index += 1
    }
    line("    );")
    line("};")
    line("")
    dataTypes()
    line("} // namespace WebCore")
    line("")
}

fn dataImplementation() -> void {
    const p = prefix()
    lineCount = 0
    line(HEADER_LICENSE)
    line(withPrefix(SYNCHED_DATA_IMPL_PREFIX))
    var index: usize = 0
    while index < classCount {
        const d = &data[classOrder[index]]
        ifConditional(d)
        line(s.join3(s.join3("    case ", p, "SyncDataType::"), d.*.name, ":"))
        line(s.join3(s.join3("        ", lowerFirst(d.*.name), " = std::get<std::to_underlying("), p, s.join3("SyncDataType::", d.*.name, ")>(data.value);")))
        line("        break;")
        endConditional(d)
        index += 1
    }
    line(SYNCHED_DATA_IMPL_MIDFIX)
    line("data_type_name::data_type_name(")
    if data[classOrder[0]].hasConditional { failWith("First argument to constructor cannot be conditional") }
    index = 0
    while index < classCount {
        const d = &data[classOrder[index]]
        ifConditional(d)
        line(s.join3(if index == 0 { "      " } else { "    , " }, d.*.fullyQualifiedType, s.join(" ", lowerFirst(d.*.name))))
        endConditional(d)
        index += 1
    }
    line(")")
    index = 0
    while index < classCount {
        const d = &data[classOrder[index]]
        const name = lowerFirst(d.*.name)
        ifConditional(d)
        line(s.join3(if index == 0 { "    : " } else { "    , " }, name, s.join3("(", name, ")")))
        endConditional(d)
        index += 1
    }
    line("{")
    line("}")
    line("")
    line("} // namespace WebCore")
    line("")
}

fn serializationIn() -> void {
    const p = prefix()
    lineCount = 0
    line(SERIALIZATION_IN_LICENSE)
    line(withPrefix(PROCESS_SYNC_DATA_SERIALIZATION_IN_PREFIX))
    line3("[RefCounted] class WebCore::", p, "SyncData {")
    var index: usize = 0
    while index < classCount {
        const d = &data[classOrder[index]]
        ifConditional(d)
        line(s.join3(s.join3("    ", d.*.fullyQualifiedType, " "), lowerFirst(d.*.name), ";"))
        endConditional(d)
        index += 1
    }
    line("};")
    line("")
    index = 0
    while index < dataCount {
        const d = &data[variantOrder[index]]
        if d.*.hasConditional {
            line(s.join("#if !", d.*.conditional))
            line3("using ", d.*.fullyQualifiedType, " = bool;")
            line("#endif")
        }
        index += 1
    }
    line("")
    var variant = s.join3("using WebCore::", p, "SyncDataVariant = Variant<")
    index = 0
    while index < dataCount {
        variant = s.join3(variant, data[variantOrder[index]].fullyQualifiedType, if index + 1 < dataCount { ", " } else { ">;" })
        index += 1
    }
    line(variant)
    line(withPrefix(PROCESS_SYNC_DATA_SERIALIZATION_IN_SUFFIX))
}

// ---------------------------------------------------------------------------
// The run.

fn write(directory: []const u8, name: []const u8, text: []const u8) -> void { s.writeWhole(s.join3(directory, prefix(), name), text) }

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 3 { return 255 }
    unsafe { data = @ptrFromInt([*]Datum, s.alloc(MAX_DATA * @sizeOf(Datum))) }
    var directory: []const u8 = ""
    if arguments.length > 3 { directory = s.join(s.cString(arguments[3]), "/") }
    const name = s.cString(arguments[1])
    prefixPointer = name.pointer
    prefixLength = name.length
    parse(s.cString(arguments[2]))
    order()

    var from = s.output().length
    clientHeader()
    write(directory, "SyncClient.h", s.output()[from..s.output().length])
    from = s.output().length
    clientImplementation()
    write(directory, "SyncClient.cpp", s.output()[from..s.output().length])
    from = s.output().length
    serializationIn()
    write(directory, "SyncData.serialization.in", s.output()[from..s.output().length])
    from = s.output().length
    dataHeader()
    write(directory, "SyncData.h", named(from))
    from = s.output().length
    dataImplementation()
    write(directory, "SyncData.cpp", named(from))
    return 0
}
