// The protocol's types in C++, as WebKit's codegen makes them
// (generate_cpp_protocol_types_header.py and _implementation.py): the
// domains' versions, their aliases and arrays as typedefs, their enums as
// enum classes (numbered across the protocol) with the strings they stand
// for, their objects as classes with builders checking at compile time
// that every required field is set, and the run-time checks of the shapes
// of the objects built by hand.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const m = @import("./inspectormodel.mlx")

const ALL_CPP_FRAMEWORKS = "JavaScriptCore WebKit WebDriverBidi"

fn domainOf(p: *m.Protocol, index: usize) -> *m.Domain { return p.*.domains[index] }

fn declarationCondition(ty: *m.Type) -> []const u8 { return ty.*.declaration.?.*.condition }

fn hasObjectsOrEnums(domain: *m.Domain) -> bool {
    var index: usize = 0
    while index < domain.*.declarationCount {
        const kind = domain.*.declarations[index].ty.*.kind
        if kind == m.OBJECT || kind == m.ENUM { return true }
        index += 1
    }
    return false
}

fn withExportMacro(p: *m.Protocol, text: []const u8) -> []const u8 {
    if p.*.framework.exportMacro.length > 0 { return t.c3(p.*.framework.exportMacro, " ", text) }
    return text
}

// ---------------------------------------------------------------------------
// InspectorProtocolObjects.h

fn versions(p: *m.Protocol) -> []const u8 {
    var sections = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        const domain = domainOf(p, index)
        if m.generated(p, index) && domain.*.hasVersion && domain.*.version != 0 {
            const text = t.c7("namespace ", domain.*.name, " {\nstatic constexpr unsigned VERSION = ", s.signedDecimal(domain.*.version), ";\n} // ", domain.*.name, "")
            t.push(&sections, m.guarded(domain.*.condition, text))
        }
        index += 1
    }
    if sections.count == 0 { return "" }
    return t.c3("// Versions.\n", t.joined(sections, "\n\n"), "\n// End of versions.\n")
}

fn forwardDeclarations(p: *m.Protocol) -> []const u8 {
    var sections = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        const domain = domainOf(p, index)
        if m.generated(p, index) && hasObjectsOrEnums(domain) {
            var lines = t.list()
            t.push(&lines, t.c3("namespace ", domain.*.name, " {"))
            var at: usize = 0
            while at < domain.*.declarationCount {
                const ty = domain.*.declarations[at].ty
                if ty.*.kind == m.OBJECT { t.push(&lines, m.guarded(declarationCondition(ty), t.c3("class ", ty.*.name, ";"))) }
                at += 1
            }
            at = 0
            while at < domain.*.declarationCount {
                const ty = domain.*.declarations[at].ty
                if ty.*.kind == m.ENUM { t.push(&lines, m.guarded(declarationCondition(ty), t.c3("enum class ", ty.*.name, ";"))) }
                at += 1
            }
            t.push(&lines, s.join("} // ", domain.*.name))
            t.push(&sections, m.guarded(domain.*.condition, t.joined(lines, "\n")))
        }
        index += 1
    }
    if sections.count == 0 { return "" }
    return t.c3("// Forward declarations.\n", t.joined(sections, "\n\n"), "\n// End of forward declarations.\n")
}

fn describedLines(description: []const u8, line: []const u8) -> []const u8 {
    if description.length > 0 { return t.c4("/* ", description, " */\n", line) }
    return line
}

fn typedefsForDomain(domain: *m.Domain) -> []const u8 {
    var sections = t.list()
    var index: usize = 0
    while index < domain.*.declarationCount {
        const declaration = &domain.*.declarations[index]
        if declaration.*.ty.*.kind == m.ALIASED {
            const line = t.c5("using ", declaration.*.name, " = ", m.cppNameForPrimitive(declaration.*.ty.*.resolved.?), ";")
            t.push(&sections, m.guarded(declaration.*.condition, describedLines(declaration.*.description, line)))
        }
        index += 1
    }
    index = 0
    while index < domain.*.declarationCount {
        const declaration = &domain.*.declarations[index]
        if declaration.*.ty.*.kind == m.ARRAY {
            const line = t.c5("using ", declaration.*.name, " = JSON::ArrayOf<", m.cppProtocolType(declaration.*.ty.*.resolved.?), ">;")
            t.push(&sections, m.guarded(declaration.*.condition, describedLines(declaration.*.description, line)))
        }
        index += 1
    }
    if sections.count == 0 { return "" }
    return m.guarded(domain.*.condition, t.c6("namespace ", domain.*.name, " {\n", t.joined(sections, "\n"), "\n} // ", domain.*.name))
}

fn typedefs(p: *m.Protocol) -> []const u8 {
    var sections = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        if m.generated(p, index) {
            const text = typedefsForDomain(domainOf(p, index))
            if text.length > 0 { t.push(&sections, text) }
        }
        index += 1
    }
    if sections.count == 0 { return "" }
    return t.c3("// Typedefs.\n", t.joined(sections, "\n\n"), "\n// End of typedefs.")
}

fn enumTypeLines(p: *m.Protocol, name: []const u8, ty: *m.Type) -> t.List {
    const enumName = m.ucfirst(name)
    var lines = t.list()
    t.push(&lines, t.c3("enum class ", enumName, " {"))
    var index: usize = 0
    while index < ty.*.values.count {
        const value = ty.*.values.items[index]
        t.push(&lines, t.c5("    ", m.stylizedEnumName(value), " = ", m.encodingFor(p, value), ","))
        index += 1
    }
    t.push(&lines, s.join("}; // enum class ", enumName))
    return lines
}

fn structForEnumDeclaration(p: *m.Protocol, declaration: *m.Declaration) -> []const u8 {
    var lines = t.list()
    if declaration.*.description.length > 0 { t.push(&lines, t.c3("/* ", declaration.*.description, " */")) }
    t.extend(&lines, enumTypeLines(p, declaration.*.name, declaration.*.ty))
    return m.guarded(declaration.*.condition, t.joined(lines, "\n"))
}

fn structForAnonymousEnumMember(p: *m.Protocol, member: *m.Member) -> []const u8 {
    const lines = enumTypeLines(p, member.*.name, member.*.ty)
    var indented = t.list()
    var index: usize = 0
    while index < lines.count {
        const line = lines.items[index]
        if line.length == 0 || s.startsWith(line, "#") || s.startsWith(line, "/*") || s.startsWith(line, "*/") || s.startsWith(line, "//") {
            t.push(&indented, line)
        } else {
            t.push(&indented, s.join("    ", line))
        }
        index += 1
    }
    return t.joined(indented, "\n")
}

fn builderStateEnum(declaration: *m.Declaration) -> []const u8 {
    var lines = t.list()
    var values = t.list()
    t.push(&lines, "    enum {")
    t.push(&lines, "        NoFieldsSet = 0,")
    var index: usize = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if !member.*.optional {
            const value = s.join(m.ucfirst(member.*.name), "Set")
            t.push(&lines, t.c5("        ", value, " = 1 << ", s.decimal(@intCast(u64, values.count)), ","))
            t.push(&values, value)
        }
        index += 1
    }
    if values.count > 0 {
        t.push(&lines, t.c3("        AllFieldsSet = (", t.joined(values, " | "), ")"))
    } else {
        t.push(&lines, "        AllFieldsSet = 0")
    }
    t.push(&lines, "    };")
    t.push(&lines, "")
    return t.joined(lines, "\n")
}

// What a builder or setter passes for MEMBER's value named NAME.
fn memberValue(p: *m.Protocol, member: *m.Member, name: []const u8) -> []const u8 {
    if m.isEnum(member.*.ty) { return t.c5("Protocol::", m.helpersNamespace(p), "::getEnumConstantValue(", name, ")") }
    if m.shouldMoveArgument(member.*.ty, false) { return t.c3("WTF::move(", name, ")") }
    return name
}

fn builderSetterForMember(p: *m.Protocol, member: *m.Member) -> []const u8 {
    const name = s.join("in_", member.*.name)
    const camel = m.ucfirst(member.*.name)
    const key = member.*.name
    var lines = t.list()
    t.push(&lines, "")
    t.push(&lines, t.c9("        Builder<STATE | ", camel, "Set>& set", camel, "(", m.cppTypeForTypeMemberArgument(member.*.ty, member.*.name), " ", name, ")"))
    t.push(&lines, "        {")
    t.push(&lines, t.c5("            static_assert(!(STATE & ", camel, "Set), \"property ", key, " already set\");"))
    t.push(&lines, t.c7("            Ref { *m_result }->", m.cppSetterMethod(member.*.ty), "(\"", key, "\"_s, ", memberValue(p, member, name), ");"))
    t.push(&lines, t.c3("            return castState<", camel, "Set>();"))
    t.push(&lines, "        }")
    if member.*.nullable {
        t.push(&lines, "")
        t.push(&lines, t.c5("        Builder<STATE | ", camel, "Set>& set", camel, "IsNull()"))
        t.push(&lines, "        {")
        t.push(&lines, t.c5("            static_assert(!(STATE & ", camel, "Set), \"property ", key, " already set\");"))
        t.push(&lines, t.c3("            Ref { *m_result }->setValue(\"", key, "\"_s, JSON::Value::null());"))
        t.push(&lines, t.c3("            return castState<", camel, "Set>();"))
        t.push(&lines, "        }")
    }
    return t.joined(lines, "\n")
}

fn uncheckedSetterForMember(p: *m.Protocol, member: *m.Member) -> []const u8 {
    const name = s.join("in_opt_", member.*.name)
    const camel = m.ucfirst(member.*.name)
    const key = member.*.name
    var lines = t.list()
    t.push(&lines, "")
    t.push(&lines, t.c7("    void set", camel, "(", m.cppTypeForTypeMemberArgument(member.*.ty, member.*.name), " ", name, ")"))
    t.push(&lines, "    {")
    t.push(&lines, t.c7("        JSON::ObjectBase::", m.cppSetterMethod(member.*.ty), "(\"", key, "\"_s, ", memberValue(p, member, name), ");"))
    t.push(&lines, "    }")
    if member.*.nullable {
        t.push(&lines, "")
        t.push(&lines, t.c3("    void set", camel, "IsNull()"))
        t.push(&lines, "    {")
        t.push(&lines, t.c3("        JSON::ObjectBase::setValue(\"", key, "\"_s, JSON::Value::null());"))
        t.push(&lines, "    }")
    }
    return t.joined(lines, "\n")
}

const BUILDER_PRELUDE = "    using JSON::ObjectBase::setBoolean;
    using JSON::ObjectBase::setInteger;
    using JSON::ObjectBase::setDouble;
    using JSON::ObjectBase::setString;
    using JSON::ObjectBase::setValue;
    using JSON::ObjectBase::setObject;
    using JSON::ObjectBase::setArray;

    template<int STATE>
    class Builder {
    private:
        RefPtr<${objectType}> m_result;

        template<int STEP> Builder<STATE | STEP>& castState()
        {
            SUPPRESS_MEMORY_UNSAFE_CAST return *reinterpret_cast<Builder<STATE | STEP>*>(this);
        }

        Builder(Ref<${objectType}>&& object)
            : m_result(WTF::move(object))
        {
            static_assert(STATE == NoFieldsSet, \"builder created in non init state\");
        }
        friend class ${objectType};
    public:"

const BUILDER_POSTLUDE = "
        Ref<${objectType}> release()
        {
            static_assert(STATE == AllFieldsSet, \"result is not ready\");
            static_assert(sizeof(${objectType}) == sizeof(JSON::Object), \"cannot cast\");

            return m_result.releaseNonNull();
        }
    };

private:
    ${objectType}() = default;

public:
    /*
     * Synthetic constructor:
${constructorExample}
     */
    static Builder<NoFieldsSet> create()
    {
        return Builder<NoFieldsSet>(adoptRef(*new ${objectType}));
    }"

fn classForObjectDeclaration(p: *m.Protocol, declaration: *m.Declaration) -> []const u8 {
    const objectName = declaration.*.name
    var lines = t.list()
    if declaration.*.description.length > 0 { t.push(&lines, t.c3("/* ", declaration.*.description, " */")) }
    const baseClass = if m.hasOpenFields(declaration.*.ty) { "JSON::Object" } else { "JSON::ObjectBase" }
    t.push(&lines, t.c5("class ", objectName, " final : public ", baseClass, " {"))
    t.push(&lines, "public:")
    var index: usize = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if m.isAnonymousEnum(member.*.ty) {
            t.push(&lines, t.c5("    // Named after property name '", member.*.name, "' while generating ", objectName, "."))
            t.push(&lines, structForAnonymousEnumMember(p, member))
            t.push(&lines, "")
        }
        index += 1
    }
    t.push(&lines, builderStateEnum(declaration))

    var example = t.list()
    t.push(&example, t.c5("     * Ref<", objectName, "> result = ", objectName, "::create()"))
    index = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if !member.*.optional { t.push(&example, t.c3("     *     .set", m.ucfirst(member.*.name), "(...)")) }
        index += 1
    }
    t.push(&example, "     *     .release()")
    const constructorExample = s.join(t.joined(example, "\n"), ";")

    t.push(&lines, t.replaceAll(BUILDER_PRELUDE, "${objectType}", objectName))
    index = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if !member.*.optional { t.push(&lines, builderSetterForMember(p, member)) }
        index += 1
    }
    t.push(&lines, t.replaceAll(t.replaceAll(BUILDER_POSTLUDE, "${objectType}", objectName), "${constructorExample}", constructorExample))
    index = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if !member.*.optional && member.*.nullable { t.push(&lines, uncheckedSetterForMember(p, member)) }
        index += 1
    }
    index = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if member.*.optional { t.push(&lines, uncheckedSetterForMember(p, member)) }
        index += 1
    }
    t.push(&lines, "};")
    return m.guarded(declaration.*.condition, t.joined(lines, "\n"))
}

fn buildersForDomain(p: *m.Protocol, domain: *m.Domain) -> []const u8 {
    var sections = t.list()
    var index: usize = 0
    while index < domain.*.declarationCount {
        const declaration = &domain.*.declarations[index]
        if declaration.*.ty.*.kind == m.ENUM {
            t.push(&sections, structForEnumDeclaration(p, declaration))
        } else if declaration.*.ty.*.kind == m.OBJECT {
            t.push(&sections, classForObjectDeclaration(p, declaration))
        }
        index += 1
    }
    const kept = t.nonEmpty(sections)
    if kept.count == 0 { return "" }
    return m.guarded(domain.*.condition, t.c5("namespace ", domain.*.name, " {\n\n", t.joined(kept, "\n\n"), s.join("\n\n} // ", domain.*.name)))
}

fn bindingTraitsDeclarations(p: *m.Protocol) -> []const u8 {
    const keywords = if p.*.framework.exportMacro.length > 0 { s.join("struct ", p.*.framework.exportMacro) } else { "struct" }
    var lines = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        if m.generated(p, index) {
            const domain = domainOf(p, index)
            var at: usize = 0
            while at < domain.*.declarationCount {
                const declaration = &domain.*.declarations[at]
                if m.needsShapeAssertions(p, declaration.*.ty) {
                    if declaration.*.ty.*.kind == m.OBJECT {
                        const argument = m.guarded(declaration.*.condition, m.cppProtocolType(declaration.*.ty))
                        t.push(&lines, t.c5("template<> ", keywords, " BindingTraits<", argument, "> {"))
                        if m.needsRuntimeCasts(declaration.*.ty) { t.push(&lines, t.c3("static Ref<", argument, "> runtimeCast(Ref<JSON::Value>&& value);")) }
                        t.push(&lines, "static void assertValueHasExpectedType(JSON::Value*);")
                        t.push(&lines, "};")
                    }
                    var member: usize = 0
                    while member < declaration.*.memberCount {
                        const ty = declaration.*.members[member].ty
                        if ty.*.kind == m.ENUM {
                            const argument = m.guarded(declaration.*.condition, m.cppTypeForEnum(ty, t.c3(declaration.*.name, "::", m.ucfirst(declaration.*.members[member].name))))
                            t.push(&lines, t.c5("template<> ", keywords, " BindingTraits<", argument, "> {"))
                            t.push(&lines, "static void assertValueHasExpectedType(JSON::Value*);")
                            t.push(&lines, "};")
                        }
                        member += 1
                    }
                }
                at += 1
            }
        }
        index += 1
    }
    return t.joined(lines, "\n")
}

fn parseDeclaration(p: *m.Protocol, cppType: []const u8) -> []const u8 {
    return t.c5("template<>\n", withExportMacro(p, t.c3("std::optional<", cppType, ">")), " parseEnumValueFromString<", cppType, ">(const String&);")
}

fn enumConversionDeclarations(p: *m.Protocol, sectionsOut: *t.List) -> void {
    const namespace = m.helpersNamespace(p)
    var sections = t.list()
    t.push(&sections, t.c3("namespace ", namespace, " {\n\ntemplate<typename ProtocolEnumType>\nstd::optional<ProtocolEnumType> parseEnumValueFromString(const String&);"))
    var index: usize = 0
    while index < p.*.domainCount {
        const domain = domainOf(p, index)
        if m.generated(p, index) && hasObjectsOrEnums(domain) {
            var lines = t.list()
            t.push(&lines, t.c3("// Enums in the '", domain.*.name, "' Domain"))
            var at: usize = 0
            while at < domain.*.declarationCount {
                const ty = domain.*.declarations[at].ty
                if ty.*.kind == m.ENUM {
                    t.push(&lines, m.guarded(declarationCondition(ty), parseDeclaration(p, m.cppTypeForEnum(ty, ty.*.name))))
                }
                at += 1
            }
            at = 0
            while at < domain.*.declarationCount {
                const declaration = &domain.*.declarations[at]
                if declaration.*.ty.*.kind == m.OBJECT {
                    var objectLines = t.list()
                    var member: usize = 0
                    while member < declaration.*.memberCount {
                        const ty = declaration.*.members[member].ty
                        if m.isAnonymousEnum(ty) {
                            t.push(&objectLines, parseDeclaration(p, m.cppTypeForEnum(ty, t.c3(declaration.*.name, "::", m.ucfirst(declaration.*.members[member].name)))))
                        }
                        member += 1
                    }
                    if objectLines.count > 0 { t.push(&lines, m.guarded(declaration.*.condition, t.joined(objectLines, "\n"))) }
                }
                at += 1
            }
            if lines.count > 1 { t.push(&sections, m.guarded(domain.*.condition, t.joined(lines, "\n"))) }
        }
        index += 1
    }
    if sections.count == 1 { return }
    t.push(&sections, s.join("} // namespace ", namespace))
    t.push(sectionsOut, t.joined(sections, "\n\n"))
}

fn hashDeclarations(p: *m.Protocol, sectionsOut: *t.List) -> void {
    var lines = t.list()
    var index: usize = 0
    while index < p.*.domainCount {
        const domain = domainOf(p, index)
        var hasEnums = false
        var at: usize = 0
        while at < domain.*.declarationCount {
            if domain.*.declarations[at].ty.*.kind == m.ENUM { hasEnums = true }
            at += 1
        }
        if m.generated(p, index) && hasEnums {
            if lines.count == 0 {
                t.push(&lines, "namespace WTF {")
                t.push(&lines, "")
                t.push(&lines, "template<typename T> struct DefaultHash;")
            }
            var domainLines = t.list()
            t.push(&domainLines, "")
            t.push(&domainLines, t.c3("// Hash declarations in the '", domain.*.name, "' Domain"))
            at = 0
            while at < domain.*.declarationCount {
                const ty = domain.*.declarations[at].ty
                if ty.*.kind == m.ENUM {
                    const name = t.c3(domain.*.name, "::", ty.*.name)
                    t.push(&domainLines, m.guarded(declarationCondition(ty), t.c5("template<>\nstruct DefaultHash<Inspector::Protocol::", name, "> : IntHash<Inspector::Protocol::", name, "> { };")))
                }
                at += 1
            }
            t.push(&lines, m.guarded(domain.*.condition, t.joined(domainLines, "\n")))
        }
        index += 1
    }
    if lines.count == 0 { return }
    t.push(&lines, "")
    t.push(&lines, "} // namespace WTF")
    t.push(sectionsOut, t.joined(lines, "\n"))
}

pub fn generateHeader(p: *m.Protocol) -> []const u8 {
    var includes = t.list()
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "JavaScriptCore", "inspector/InspectorProtocolTypes.h", true)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "JavaScriptCore", "JSExportMacros.h", true)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/JSONValues.h", false)
    m.addInclude(p, &includes, ALL_CPP_FRAMEWORKS, "WTF", "wtf/text/WTFString.h", false)
    t.sort(&includes)

    var sections = t.list()
    t.push(&sections, m.license(p))
    t.push(&sections, t.c3("#pragma once\n\n", t.joined(includes, "\n"), "\n\nnamespace Inspector {\n\n"))
    t.push(&sections, "namespace Protocol {")
    t.push(&sections, versions(p))
    t.push(&sections, forwardDeclarations(p))
    t.push(&sections, typedefs(p))
    if m.enumValues(p).count > 0 {
        const namespace = m.helpersNamespace(p)
        t.push(&sections, t.c3("namespace ", namespace, " {"))
        t.push(&sections, t.c3(withExportMacro(p, "String"), " getEnumConstantValue(int code);

template<typename T> String getEnumConstantValue(T enumValue)
{
    return getEnumConstantValue(static_cast<int>(enumValue));
}", ""))
        t.push(&sections, s.join("} // namespace ", namespace))
    }
    var index: usize = 0
    while index < p.*.domainCount {
        if m.generated(p, index) {
            const builders = buildersForDomain(p, domainOf(p, index))
            if builders.length > 0 { t.push(&sections, builders) }
        }
        index += 1
    }
    t.push(&sections, bindingTraitsDeclarations(p))
    enumConversionDeclarations(p, &sections)
    t.push(&sections, "} // namespace Protocol")
    t.push(&sections, "} // namespace Inspector")
    hashDeclarations(p, &sections)
    return t.joined(sections, "\n\n")
}

// ---------------------------------------------------------------------------
// InspectorProtocolObjects.cpp

fn conversionMethodBody(ty: *m.Type, cppType: []const u8) -> []const u8 {
    var lines = t.list()
    t.push(&lines, t.c5("template<> std::optional<", cppType, "> parseEnumValueFromString<", cppType, ">(const String& protocolString)"))
    t.push(&lines, "{")
    t.push(&lines, "    static const auto constantValues = WTF::toArray<size_t>({")
    var index: usize = 0
    while index < ty.*.values.count {
        t.push(&lines, t.c5("        (size_t)", cppType, "::", m.stylizedEnumName(ty.*.values.items[index]), ","))
        index += 1
    }
    t.push(&lines, "    });")
    t.push(&lines, t.c3("    for (size_t i = 0; i < ", s.decimal(@intCast(u64, ty.*.values.count)), "; ++i)"))
    t.push(&lines, "        if (protocolString == enum_constant_values[constantValues[i]])")
    t.push(&lines, t.c3("            return (", cppType, ")constantValues[i];"))
    t.push(&lines, "")
    t.push(&lines, "    return std::nullopt;")
    t.push(&lines, "}")
    return t.joined(lines, "\n")
}

fn enumConversionMethodsForDomain(domain: *m.Domain) -> []const u8 {
    if !hasObjectsOrEnums(domain) { return "" }
    var lines = t.list()
    t.push(&lines, t.c3("// Enums in the '", domain.*.name, "' Domain"))
    var index: usize = 0
    while index < domain.*.declarationCount {
        const ty = domain.*.declarations[index].ty
        if ty.*.kind == m.ENUM {
            t.push(&lines, "")
            t.push(&lines, m.guarded(declarationCondition(ty), conversionMethodBody(ty, m.cppTypeForEnum(ty, ty.*.name))))
        }
        index += 1
    }
    index = 0
    while index < domain.*.declarationCount {
        const declaration = &domain.*.declarations[index]
        if declaration.*.ty.*.kind == m.OBJECT {
            var objectLines = t.list()
            var member: usize = 0
            while member < declaration.*.memberCount {
                const ty = declaration.*.members[member].ty
                if m.isAnonymousEnum(ty) {
                    t.push(&objectLines, conversionMethodBody(ty, m.cppTypeForEnum(ty, t.c3(declaration.*.name, "::", m.ucfirst(declaration.*.members[member].name)))))
                }
                member += 1
            }
            if objectLines.count > 0 {
                t.push(&lines, "")
                t.push(&lines, m.guarded(declaration.*.condition, t.joined(objectLines, "\n")))
            }
        }
        index += 1
    }
    if lines.count == 1 { return "" }
    return m.guarded(domain.*.condition, t.joined(lines, "\n"))
}

fn assertionForEnum(member: *m.Member, declaration: *m.Declaration) -> []const u8 {
    var lines = t.list()
    t.push(&lines, t.c3("void BindingTraits<", m.cppTypeForEnum(member.*.ty, t.c3(declaration.*.name, "::", m.ucfirst(member.*.name))), ">::assertValueHasExpectedType(JSON::Value* value)"))
    t.push(&lines, "{")
    t.push(&lines, "    ASSERT_UNUSED(value, value);")
    t.push(&lines, "#if ASSERT_ENABLED")
    t.push(&lines, "    auto result = value->asString();")
    t.push(&lines, "    ASSERT(result);")
    var conditions = t.list()
    var index: usize = 0
    while index < member.*.ty.*.values.count {
        t.push(&conditions, t.c3("result == \"", member.*.ty.*.values.items[index], "\"_s"))
        index += 1
    }
    t.push(&lines, t.c3("    ASSERT(", t.joined(conditions, " || "), ");"))
    t.push(&lines, "#endif")
    t.push(&lines, "}")
    return t.joined(lines, "\n")
}

fn memberTypeForAssertion(member: *m.Member, declaration: *m.Declaration) -> []const u8 {
    const ty = m.unaliased(member.*.ty)
    if ty.*.kind == m.ENUM { return m.cppTypeForEnum(ty, t.c3(declaration.*.name, "::", m.ucfirst(member.*.name))) }
    return m.cppProtocolType(ty)
}

fn assertionForObjectDeclaration(declaration: *m.Declaration) -> []const u8 {
    var lines = t.list()
    t.push(&lines, t.c3("void BindingTraits<", m.cppProtocolType(declaration.*.ty), ">::assertValueHasExpectedType(JSON::Value* value)"))
    t.push(&lines, "{\n    ASSERT_UNUSED(value, value);\n#if ASSERT_ENABLED\n    auto object = value->asObject();\n    ASSERT(object);")
    var required: usize = 0
    var index: usize = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if !member.*.optional {
            const name = member.*.name
            t.push(&lines, t.c9("    {\n        auto ", name, "Pos = object->find(\"", name, "\"_s);\n        ASSERT(", name, "Pos != object->end());\n        BindingTraits<", memberTypeForAssertion(member, declaration),
                t.c3(">::assertValueHasExpectedType(", name, "Pos->value.ptr());\n    }")))
            required += 1
        }
        index += 1
    }
    t.push(&lines, "")
    t.push(&lines, t.c3("    size_t foundPropertiesCount = ", s.decimal(@intCast(u64, required)), ";"))
    index = 0
    while index < declaration.*.memberCount {
        const member = &declaration.*.members[index]
        if member.*.optional {
            const name = member.*.name
            t.push(&lines, t.c9("    {\n        auto ", name, "Pos = object->find(\"", name, "\"_s);\n        if (", name, "Pos != object->end()) {\n            BindingTraits<", memberTypeForAssertion(member, declaration),
                t.c3(">::assertValueHasExpectedType(", name, "Pos->value.ptr());")))
            t.push(&lines, "            ++foundPropertiesCount;")
            t.push(&lines, "        }")
            t.push(&lines, "    }")
        }
        index += 1
    }
    t.push(&lines, t.c3("    if (foundPropertiesCount ", if m.hasOpenFields(declaration.*.ty) { ">=" } else { "!=" }, " object->size())"))
    t.push(&lines, "        FATAL(\"Unexpected properties in object: %s\\n\", object->toJSONString().ascii().data());")
    t.push(&lines, "#endif")
    t.push(&lines, "}")
    return t.joined(lines, "\n")
}

const RUNTIME_CAST = "Ref<${objectType}> BindingTraits<${objectType}>::runtimeCast(Ref<JSON::Value>&& value)
{
    auto result = value->asObject();
    BindingTraits<${objectType}>::assertValueHasExpectedType(result.get());
    static_assert(sizeof(${objectType}) == sizeof(JSON::ObjectBase), \"type cast problem\");
    return unsafeRefDowncast<${objectType}>(upcast<JSON::ObjectBase>(result.releaseNonNull()));
}
"

fn assertionsForDomain(p: *m.Protocol, domain: *m.Domain) -> []const u8 {
    var sections = t.list()
    var index: usize = 0
    while index < domain.*.declarationCount {
        const declaration = &domain.*.declarations[index]
        if m.needsShapeAssertions(p, declaration.*.ty) {
            var typeLines = t.list()
            var member: usize = 0
            while member < declaration.*.memberCount {
                if declaration.*.members[member].ty.*.kind == m.ENUM { t.push(&typeLines, assertionForEnum(&declaration.*.members[member], declaration)) }
                member += 1
            }
            if declaration.*.ty.*.kind == m.OBJECT {
                t.push(&typeLines, assertionForObjectDeclaration(declaration))
                if m.needsRuntimeCasts(declaration.*.ty) { t.push(&typeLines, t.replaceAll(RUNTIME_CAST, "${objectType}", m.cppProtocolType(declaration.*.ty))) }
            }
            if typeLines.count > 0 { t.push(&sections, m.guarded(declaration.*.condition, t.joined(typeLines, "\n\n"))) }
        }
        index += 1
    }
    if sections.count == 0 { return "" }
    return m.guarded(domain.*.condition, t.joined(sections, "\n\n"))
}

pub fn generateImplementation(p: *m.Protocol) -> []const u8 {
    var includes = t.list()
    m.addInclude(p, &includes, "JavaScriptCore WebKit", "WTF", "wtf/Assertions.h", false)
    t.sort(&includes)

    var sections = t.list()
    t.push(&sections, m.license(p))
    t.push(&sections, t.c5("#include \"config.h\"\n#include \"", p.*.framework.cppProtocolGroup, "ProtocolObjects.h\"\n\n", t.joined(includes, "\n"), "\n\nnamespace Inspector {"))
    t.push(&sections, "namespace Protocol {")

    const namespace = m.helpersNamespace(p)
    var helpers = t.list()
    t.push(&helpers, t.c3("namespace ", namespace, " {"))
    const values = m.enumValues(p)
    if values.count > 0 {
        var lines = t.list()
        t.push(&lines, "static const auto enum_constant_values = WTF::toArray<ASCIILiteral>({")
        var index: usize = 0
        while index < values.count {
            t.push(&lines, t.c3("    \"", values.items[index], "\"_s,"))
            index += 1
        }
        t.push(&lines, "});")
        t.push(&lines, "")
        t.push(&lines, "String getEnumConstantValue(int code) {")
        t.push(&lines, "    return enum_constant_values[code];")
        t.push(&lines, "}")
        t.push(&helpers, t.joined(lines, "\n"))
    }
    var index: usize = 0
    while index < p.*.domainCount {
        if m.generated(p, index) {
            const methods = enumConversionMethodsForDomain(domainOf(p, index))
            if methods.length > 0 { t.push(&helpers, methods) }
        }
        index += 1
    }
    if helpers.count > 1 {
        t.push(&helpers, s.join("} // namespace ", namespace))
        t.extend(&sections, helpers)
    }

    index = 0
    while index < p.*.domainCount {
        if m.generated(p, index) {
            const assertions = assertionsForDomain(p, domainOf(p, index))
            if assertions.length > 0 { t.push(&sections, assertions) }
        }
        index += 1
    }
    t.push(&sections, "} // namespace Protocol")
    t.push(&sections, "} // namespace Inspector\n")
    return t.joined(sections, "\n\n")
}
