// WebCore's CSS value keywords, as process-css-values.py makes them: the
// keyword files put together (CSSValueKeywords.in, as the build's
// `perl -ne print` makes it), the enum of their IDs (CSSValueKeywords.h)
// and gperf's input for the keyword lookup (CSSValueKeywords.gperf):
//
//     webkit-css-values [--defines DEFINES] OUTPUT_DIRECTORY KEYWORDS.in...
//
// Each line of a keyword file is a keyword, maybe with `enable-if=COND`
// (kept only when COND holds for DEFINES: `A|B`, `A&B`, `!A`) and
// `id=ID`; text after "//" is a comment. CSSValueKeywords.cpp is then
// gperf's work, run in OUTPUT_DIRECTORY:
//
//     gperf --key-positions=* -D -n -s 2 CSSValueKeywords.gperf --output-file=CSSValueKeywords.cpp
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")

const Value = struct {
    name: []const u8
    id: []const u8
}

var values: [*]Value = undefined
var valueCount: usize = 0
var defines: t.List = undefined

fn isEnabled(conditional: []const u8) -> bool {
    if s.contains(conditional, "|") {
        const parts = c.splitByte(conditional, 124)
        var index: usize = 0
        while index < parts.count {
            if isEnabled(parts.items[index]) { return true }
            index += 1
        }
        return false
    }
    if s.contains(conditional, "&") {
        const parts = c.splitByte(conditional, 38)
        var index: usize = 0
        while index < parts.count {
            if !isEnabled(parts.items[index]) { return false }
            index += 1
        }
        return true
    }
    if conditional[0] == 33 { return !t.contains(defines, conditional[1..conditional.length]) }
    return t.contains(defines, conditional)
}

// Value.convert_name_to_id: re.sub(r'(^[^-])|-(.)', upper of the group).
pub fn nameToId(name: []const u8) -> []const u8 {
    var result = c.buf()
    var index: usize = 0
    while index < name.length {
        const byte = name[index]
        if index == 0 && byte != 45 {
            c.addByte(&result, c.upperByte(byte))
            index += 1
        } else if byte == 45 && index + 1 < name.length && name[index + 1] != 10 {
            c.addByte(&result, c.upperByte(name[index + 1]))
            index += 2
        } else {
            c.addByte(&result, byte)
            index += 1
        }
    }
    return c.contents(&result)
}

// The value of attribute NAME in PART ("NAME=value"), checked as the script checks it.
fn attribute(current: []const u8, name: []const u8, part: []const u8, value: []const u8) -> []const u8 {
    var equal: usize = 0
    while equal < part.length && part[equal] != 61 { equal += 1 }
    if !std.text.same(part[0..equal], name) { return current }
    if current.length > 0 { s.fail(t.c5("More than one '", name, "' attribute specified for value '", value, "'.")) }
    const rest = if equal < part.length { part[equal + 1..part.length] } else { "" }
    if rest.length == 0 { s.fail(t.c5("Empty '", name, "' attribute specified for value '", value, "'.")) }
    return rest
}

fn readValues(text: []const u8) -> void {
    var at: usize = 0
    while at < text.length {
        var line = s.nextLine(text, &at)
        const comment = s.find(line, "//")
        line = t.rstrip(line[0..comment])
        if line.length == 0 { continue }
        const parts = c.splitByte(line, 32)
        const name = parts.items[0]
        var conditional: []const u8 = ""
        var id: []const u8 = ""
        var index: usize = 1
        while index < parts.count {
            conditional = attribute(conditional, "enable-if", parts.items[index], name)
            id = attribute(id, "id", parts.items[index], name)
            index += 1
        }
        if conditional.length > 0 && !isEnabled(conditional) { continue }
        values[valueCount] = Value.{ .name = name, .id = if id.length > 0 { id } else { nameToId(name) } }
        valueCount += 1
    }
}

fn header() -> []const u8 {
    var w = c.writer()
    c.raw(&w, "// This file is automatically generated from CSSValueKeywords.in and SVGCSSValueKeywords.in by the process-css-values script. Do not edit it.\"\n\n#pragma once\n\n#include <array>\n#include <wtf/HashFunctions.h>\n#include <wtf/HashTraits.h>\n\nnamespace WebCore {\n\n")
    c.raw(&w, "enum CSSValueID : uint16_t {\n    CSSValueInvalid = 0,\n")
    var maxLength: usize = 0
    var index: usize = 0
    while index < valueCount {
        c.raw(&w, t.c5("    CSSValue", values[index].id, " = ", s.decimal(index + 1), ",\n"))
        if values[index].name.length > maxLength { maxLength = values[index].name.length }
        index += 1
    }
    c.raw(&w, "};\n\n")
    c.raw(&w, t.c3("constexpr uint16_t numCSSValueKeywords = ", s.decimal(valueCount + 1), ";\n"))
    c.raw(&w, t.c3("constexpr uint16_t lastCSSValueKeyword = ", s.decimal(valueCount), ";\n"))
    c.raw(&w, t.c3("constexpr unsigned maxCSSValueKeywordLength = ", s.decimal(maxLength), ";\n"))
    c.raw(&w, c.dedent("            CSSValueID findCSSValueKeyword(std::span<const char> characters);
            ASCIILiteral nameLiteral(CSSValueID);
            ASCIILiteral nameLiteralForSerialization(CSSValueID); // Lowercase.
            WEBCORE_EXPORT const AtomString& nameString(CSSValueID);
            const AtomString& nameStringForSerialization(CSSValueID); // Lowercase.

            struct AllCSSValueKeywordsRange {
                struct Iterator {
                    uint16_t index { 0 };
                    constexpr CSSValueID operator*() const { return static_cast<CSSValueID>(index); }
                    constexpr Iterator& operator++() { ++index; return *this; }
                    constexpr bool operator==(std::nullptr_t) const { return index >= numCSSValueKeywords; }
                };
                static constexpr Iterator begin() { return { }; }
                static constexpr std::nullptr_t end() { return nullptr; }
                static constexpr uint16_t size() { return numCSSValueKeywords; }
            };
            constexpr AllCSSValueKeywordsRange allCSSValueKeywords() { return { }; }

"))
    c.raw(&w, "template<CSSValueID C> struct Constant {\n    static constexpr auto value = C;\n    constexpr bool operator==(const Constant<C>&) const = default;\n};\n\n")
    c.raw(&w, "namespace CSS {\n\n// A predefined keyword value\n// https://drafts.csswg.org/css-values-4/#keywords\nstruct Keyword {\n    CSSValueID value;\n\n")
    c.raw(&w, "    constexpr bool operator==(const Keyword&) const = default;\n    constexpr bool operator==(CSSValueID other) const { return value == other; };\n\n")
    c.raw(&w, "    // Unique types for each predefined keyword value.\n\n")
    index = 0
    while index < valueCount {
        c.raw(&w, t.c5("    using ", values[index].id, " = Constant<CSSValue", values[index].id, ">;\n"))
        index += 1
    }
    c.raw(&w, "};\n\n\n} // namespace CSS\n} // namespace WebCore\n\n")
    c.raw(&w, "\nnamespace WTF {\n\ntemplate<> struct DefaultHash<WebCore::CSSValueID> : IntHash<unsigned> { };\n\ntemplate<> struct HashTraits<WebCore::CSSValueID> : StrongEnumHashTraits<WebCore::CSSValueID> { };\n\n}\n")
    c.raw(&w, "\nnamespace std {\n\ntemplate<> struct iterator_traits<WebCore::AllCSSValueKeywordsRange::Iterator> { using value_type = WebCore::CSSValueID; };\n\n}\n")
    c.raw(&w, "\n")
    return c.written(&w)
}

fn gperf() -> []const u8 {
    var w = c.writer()
    c.raw(&w, "%{\n// This file is automatically generated from CSSValueKeywords.in and SVGCSSValueKeywords.in by the process-css-values script. Do not edit it.\"\n\n#include \"config.h\"\n#include \"CSSValueKeywords.h\"\n\n#include <array>\n#include <wtf/ASCIICType.h>\n#include <wtf/NeverDestroyed.h>\n#include <wtf/text/AtomString.h>\n#include <wtf/text/StringImpl.h>\n#include <string.h>\n\nWTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN\nIGNORE_WARNINGS_BEGIN(\"implicit-fallthrough\")\n\n// Older versions of gperf generate code using the `register` keyword.\n#define register\n\nnamespace WebCore {\n\n%}\n")
    c.raw(&w, "%struct-type\nstruct CSSValueHashTableEntry {\n    const char* name;\n    uint16_t id;\n};\n%language=C++\n%readonly-tables\n%7bit\n%compare-strncmp\n%define class-name CSSValueKeywordsHash\n%enum\n%%\n")
    var index: usize = 0
    while index < valueCount {
        c.raw(&w, t.c4(c.lower(values[index].name), ", CSSValue", values[index].id, "\n"))
        index += 1
    }
    c.raw(&w, "%%\n")
    const count = s.decimal(valueCount + 2)
    c.raw(&w, t.c3("static constexpr std::array<StringImpl::StaticStringImpl, ", count, "> valueData = {{\n"))
    c.raw(&w, "    StringImpl::StaticStringImpl(\"\", StringImpl::StringAtom),\n")
    index = 0
    while index < valueCount {
        c.raw(&w, t.c3("    StringImpl::StaticStringImpl(\"", values[index].name, "\", StringImpl::StringAtom),\n"))
        index += 1
    }
    c.raw(&w, "    StringImpl::StaticStringImpl(\"\", StringImpl::StringAtom)\n}};\n")
    c.raw(&w, t.c3("static constexpr std::array<StringImpl::StaticStringImpl, ", count, "> valueDataForSerialization = {{\n"))
    c.raw(&w, "    StringImpl::StaticStringImpl(\"\", StringImpl::StringAtom),\n")
    index = 0
    while index < valueCount {
        c.raw(&w, t.c3("    StringImpl::StaticStringImpl(\"", c.lower(values[index].name), "\", StringImpl::StringAtom),\n"))
        index += 1
    }
    c.raw(&w, "    StringImpl::StaticStringImpl(\"\", StringImpl::StringAtom)\n}};\n")
    c.raw(&w, c.dedent("
            CSSValueID findCSSValueKeyword(std::span<const char> characters)
            {
                auto* value = CSSValueKeywordsHash::in_word_set(characters.data(), characters.size());
                return value ? static_cast<CSSValueID>(value->id) : CSSValueInvalid;
            }

            ASCIILiteral nameLiteral(CSSValueID id)
            {
                if (static_cast<uint16_t>(id) >= numCSSValueKeywords)
                    return { };
                return valueData[id].literal();
            }

            // When serializing a CSS keyword, it should be converted to ASCII lowercase.
            // https://drafts.csswg.org/cssom/#serialize-a-css-component-value
            ASCIILiteral nameLiteralForSerialization(CSSValueID id)
            {
                if (static_cast<uint16_t>(id) >= numCSSValueKeywords)
                    return { };
                return valueDataForSerialization[id].literal();
            }

            const AtomString& nameString(CSSValueID id)
            {
                if (static_cast<uint16_t>(id) >= numCSSValueKeywords)
                    return nullAtom();

                static NeverDestroyed<std::array<AtomString, numCSSValueKeywords>> strings;
                auto& string = strings.get()[id];
                if (string.isNull())
                    string = valueData[id];
                return string;
            }

            // When serializing a CSS keyword, it should be converted to ASCII lowercase.
            // https://drafts.csswg.org/cssom/#serialize-a-css-component-value
            const AtomString& nameStringForSerialization(CSSValueID id)
            {
                if (static_cast<uint16_t>(id) >= numCSSValueKeywords)
                    return nullAtom();

                static NeverDestroyed<std::array<AtomString, numCSSValueKeywords>> strings;
                auto& string = strings.get()[id];
                if (string.isNull())
                    string = valueDataForSerialization[id];
                return string;
            }

"))
    c.raw(&w, "} // namespace WebCore\n\nIGNORE_WARNINGS_END\nWTF_ALLOW_UNSAFE_BUFFER_USAGE_END\n")
    return c.written(&w)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var definesText: []const u8 = ""
    var first: usize = 1
    if arguments.length > 2 && std.text.same(s.cString(arguments[1]), "--defines") {
        definesText = s.cString(arguments[2])
        first = 3
    }
    if arguments.length < first + 2 {
        s.say("usage: webkit-css-values [--defines DEFINES] OUTPUT_DIRECTORY KEYWORDS.in...\n")
        return 2
    }
    defines = c.splitSpaces(definesText)
    const directory = s.cString(arguments[first])
    values = unsafe { @ptrFromInt([*]Value, s.alloc(65536 * @sizeOf(Value))) }
    var all = c.buf()
    var index = first + 1
    while index < arguments.length {
        c.add(&all, c.readFile(s.cString(arguments[index])))
        index += 1
    }
    const keywords = c.contents(&all)
    readValues(keywords)
    c.writeFile(directory, "CSSValueKeywords.in", keywords)
    c.writeFile(directory, "CSSValueKeywords.h", header())
    c.writeFile(directory, "CSSValueKeywords.gperf", gperf())
    return 0
}
