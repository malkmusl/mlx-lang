// CodeGeneratorJS.pm's IDL types in C++: the IDL<...> type of an IDL
// type, and the conversions between JavaScript values and native ones.
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const js = @import("./bindingsjs.mlx")
const d = @import("./bindingsjsdict.mlx")
const mo = @import("./bindingsjsmore.mlx")
const im = @import("./bindingsjsimpl.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

fn cat(parts: []const Str) -> Str { return r.cat(parts) }
fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
fn tOn(ty: *const IDLType, name: Str) -> bool { return m.on(ty.*.ext, name) }

pub fn getFlattenedMemberTypes(unionType: *IDLType) -> r.List {
    var result = r.list()
    var index: usize = 0
    while index < unionType.*.subtypes.count {
        const member = m.subtype(unionType, index)
        if member.*.isUnion { r.append(&result, getFlattenedMemberTypes(member)) } else { r.push(&result, @intFromPtr(member)) }
        index += 1
    }
    return result
}

pub fn getNumberOfNullableMemberTypes(unionType: *IDLType) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < unionType.*.subtypes.count {
        const member = m.subtype(unionType, index)
        if member.*.isNullable { count += 1 }
        if member.*.isUnion { count += getNumberOfNullableMemberTypes(member) }
        index += 1
    }
    return count
}

pub fn getIDLUnionMemberTypes(interface: ?*Node, unionType: *IDLType) -> StrList {
    const nullable = getNumberOfNullableMemberTypes(unionType)
    if nullable > 1 { r.die("Union types must only have 0 or 1 nullable types.") }
    var result = r.strList()
    if nullable == 1 { r.spush(&result, "IDLNull") }
    const members = getFlattenedMemberTypes(unionType)
    var index: usize = 0
    while index < members.count {
        r.spush(&result, getIDLTypeExcludingNullability(interface, r.at(*IDLType, members, index)))
        index += 1
    }
    return result
}

pub fn isAnnotatedType(ty: *IDLType) -> bool {
    return tOn(ty, "Clamp") || tOn(ty, "EnforceRange") || tOn(ty, "LegacyNullToEmptyString") || tOn(ty, "AtomString") || tOn(ty, "RequiresExistingAtomString") || tOn(ty, "AllowShared")
}

pub fn getAnnotatedIDLType(ty: *IDLType) -> Str {
    if tOn(ty, "Clamp") { return "IDLClampAdaptor" }
    if tOn(ty, "EnforceRange") { return "IDLEnforceRangeAdaptor" }
    if tOn(ty, "LegacyNullToEmptyString") {
        if tOn(ty, "AtomString") { return "IDLLegacyNullToEmptyAtomStringAdaptor" }
        return "IDLLegacyNullToEmptyStringAdaptor"
    }
    if tOn(ty, "AtomString") { return "IDLAtomStringAdaptor" }
    if tOn(ty, "RequiresExistingAtomString") { return "IDLRequiresExistingAtomStringAdaptor" }
    if tOn(ty, "AllowShared") { return "IDLAllowSharedAdaptor" }
    return ""
}

const idlTypeNames = [_]Str{ "undefined", "any", "boolean", "byte", "octet", "short", "unsigned short", "long", "unsigned long", "long long", "unsigned long long", "float", "unrestricted float", "double", "unrestricted double", "DOMString", "ByteString", "USVString", "object", "ArrayBuffer", "ArrayBufferView", "DataView", "Int8Array", "Int16Array", "Int32Array", "Uint8Array", "Uint16Array", "Uint32Array", "Uint8ClampedArray", "Float16Array", "Float32Array", "Float64Array", "BigInt64Array", "BigUint64Array", "Date", "EventListener", "JSON", "ScheduledAction", "SerializedScriptValue" }
const idlTypeValues = [_]Str{ "IDLUndefined", "IDLAny", "IDLBoolean", "IDLByte", "IDLOctet", "IDLShort", "IDLUnsignedShort", "IDLLong", "IDLUnsignedLong", "IDLLongLong", "IDLUnsignedLongLong", "IDLFloat", "IDLUnrestrictedFloat", "IDLDouble", "IDLUnrestrictedDouble", "IDLDOMString", "IDLByteString", "IDLUSVString", "IDLObject", "IDLArrayBuffer", "IDLArrayBufferView", "IDLDataView", "IDLInt8Array", "IDLInt16Array", "IDLInt32Array", "IDLUint8Array", "IDLUint16Array", "IDLUint32Array", "IDLUint8ClampedArray", "IDLFloat16Array", "IDLFloat32Array", "IDLFloat64Array", "IDLBigInt64Array", "IDLBigUint64Array", "IDLDate", "IDLEventListener<JSEventListener>", "IDLJSON", "IDLScheduledAction", "IDLSerializedScriptValue<SerializedScriptValue>" }

pub fn getBaseIDLType(interface: ?*Node, ty: *IDLType) -> Str {
    if tOn(ty, "OverrideIDLType") { return m.get(ty.*.ext, "OverrideIDLType") }
    var index: usize = 0
    while index < idlTypeNames.length {
        if r.same(idlTypeNames[index], ty.*.name) { return idlTypeValues[index] }
        index += 1
    }
    if cg.isEnumType(ty) { return r.c3("IDLEnumeration<", d.getEnumerationClassNameOf(ty, interface), ">") }
    if cg.isDictionaryType(ty) { return r.c3("IDLDictionary<", d.getDictionaryClassNameOf(ty, interface), ">") }
    if cg.isSequenceType(ty) || cg.isFrozenArrayType(ty) {
        const kind = if cg.isSequenceType(ty) { "IDLSequence<" } else { "IDLFrozenArray<" }
        const inner = getIDLType(interface, m.subtype(ty, 0))
        const inlineCapacity = m.get(ty.*.ext, "InlineCapacity")
        if r.truthy(inlineCapacity) { return cat([_]Str{ kind, inner, ", ", inlineCapacity, ">" }[0..]) }
        return r.c3(kind, inner, ">")
    }
    if cg.isRecordType(ty) { return cat([_]Str{ "IDLRecord<", getIDLType(interface, m.subtype(ty, 0)), ", ", getIDLType(interface, m.subtype(ty, 1)), ">" }[0..]) }
    if cg.isPromiseType(ty) {
        const promiseType = if tOn(ty, "BypassDocumentFullyActiveCheck") { "IDLPromiseIgnoringSuspension" } else { "IDLPromise" }
        return cat([_]Str{ promiseType, "<", getIDLType(interface, m.subtype(ty, 0)), ">" }[0..])
    }
    if ty.*.isUnion { return r.c3("IDLUnion<", r.sjoin(getIDLUnionMemberTypes(interface, ty), ", "), ">") }
    if cg.isCallbackFunction(ty) { return r.c3("IDLCallbackFunction<", js.getCallbackClassName(ty.*.name), ">") }
    if cg.isCallbackInterface(ty) { return r.c3("IDLCallbackInterface<", js.getCallbackClassName(ty.*.name), ">") }
    if !cg.isInterfaceType(ty) { r.die(cat([_]Str{ "Unknown type '", ty.*.name, "'." }[0..])) }
    return r.c3("IDLInterface<", ty.*.name, ">")
}

pub fn getIDLTypeExcludingNullability(interface: ?*Node, ty: *IDLType) -> Str {
    var base = getBaseIDLType(interface, ty)
    if isAnnotatedType(ty) { base = cat([_]Str{ getAnnotatedIDLType(ty), "<", base, ">" }[0..]) }
    return base
}

pub fn getIDLType(interface: ?*Node, ty: *IDLType) -> Str {
    var base = getIDLTypeExcludingNullability(interface, ty)
    if ty.*.isNullable { base = r.c3("IDLNullable<", base, ">") }
    return base
}


fn isOptionalWithoutDefault(isOptional: bool, n: *Node) -> bool {
    return isOptional && ((r.isDef(n.*.defaultValue) && !im.willConvertUndefinedToDefaultParameterValue(n.*.ty.?, n.*.defaultValue)) || !r.isDef(n.*.defaultValue))
}

pub fn getIDLTypeForArgument(interface: *Node, argument: *Node) -> Str {
    const functor = mo.getArgumentDefaultValueFunctor(interface, argument)
    const optional = isOptionalWithoutDefault(argument.*.isOptional, argument)
    var idlType = getIDLType(interface, argument.*.ty.?)
    if optional && !r.truthy(functor) { idlType = r.c3("IDLOptional<", idlType, ">") }
    return idlType
}

pub fn getIDLTypeForDictionaryMember(interface: *Node, member: *Node) -> Str {
    const functor = mo.getDictionaryMemberDefaultValueFunctor(interface, member)
    const optional = isOptionalWithoutDefault(!member.*.isRequired, member)
    var idlType = getIDLType(interface, member.*.ty.?)
    if optional && !r.truthy(functor) { idlType = r.c3("IDLOptional<", idlType, ">") }
    return idlType
}

// Whether the member is optional and has no default the conversion
// would give anyway (the $optional of the Perl).
pub fn memberIsOptional(member: *Node) -> bool { return isOptionalWithoutDefault(!member.*.isRequired, member) }
pub fn argumentIsOptional(argument: *Node) -> bool { return isOptionalWithoutDefault(argument.*.isOptional, argument) }

pub fn shouldPassArgumentByReference(argument: *Node) -> bool {
    const ty = argument.*.ty.?
    if ty.*.isNullable { return false }
    if cg.isCallbackInterface(ty) { return false }
    if cg.isCallbackFunction(ty) { return false }
    if !cg.isWrapperType(ty) && !cg.isBufferSourceType(ty) { return false }
    return true
}

fn jsValueToNativeDOMConvertNeedsThisObject(ty: *IDLType) -> bool { return r.same(ty.*.name, "EventListener") }

fn jsValueToNativeDOMConvertNeedsGlobalObject(ty: *IDLType) -> bool {
    if cg.isCallbackInterface(ty) { return true }
    if cg.isCallbackFunction(ty) { return true }
    if cg.isRecordType(ty) { return jsValueToNativeDOMConvertNeedsGlobalObject(m.subtype(ty, 1)) }
    if r.same(ty.*.name, "ScheduledAction") { return true }
    return false
}

fn isValidContextForJSValueToNative(context: *Node) -> bool {
    return (context.*.kind == m.K_ATTRIBUTE && !cg.isEnumType(context.*.ty.?)) || context.*.kind == m.K_ARGUMENT || context.*.kind == m.K_MEMBER || context.*.kind == m.K_OPERATION
}

pub fn jsValueToNative(interface: *Node, context: *Node, v: Str, conditional: Str, lexicalGlobalObjectPointer: Str, lexicalGlobalObjectReferenceValue: Str, thisObjectReferenceValue: Str, globalObjectReference: Str, exceptionThrowerFunctor: Str, functionName: Str, optional: bool, defaultValueFunctor: Str, resultValueFunctor: Str) -> Str {
    if !isValidContextForJSValueToNative(context) { r.die("Invalid context type") }
    const ty = context.*.ty.?
    const lexicalGlobalObjectReference = r.orElse(lexicalGlobalObjectReferenceValue, "*lexicalGlobalObject")
    const thisObjectReference = r.orElse(thisObjectReferenceValue, "*castedThis")
    js.addToImplIncludesForIDLType(ty, conditional)
    if jsValueToNativeDOMConvertNeedsGlobalObject(ty) { js.addToImplIncludes("JSDOMGlobalObject.h", conditional) }
    if optional { js.addToImplIncludes("JSDOMConvertOptional.h", conditional) }
    var idlType = getIDLType(interface, ty)
    if optional && !r.truthy(defaultValueFunctor) { idlType = r.c3("IDLOptional<", idlType, ">") }
    var arguments = r.strList()
    r.spush(&arguments, lexicalGlobalObjectReference)
    r.spush(&arguments, v)
    if jsValueToNativeDOMConvertNeedsThisObject(ty) { r.spush(&arguments, thisObjectReference) }
    if jsValueToNativeDOMConvertNeedsGlobalObject(ty) { r.spush(&arguments, globalObjectReference) }
    if r.truthy(defaultValueFunctor) { r.spush(&arguments, defaultValueFunctor) }
    if r.truthy(exceptionThrowerFunctor) { r.spush(&arguments, exceptionThrowerFunctor) }
    if r.truthy(resultValueFunctor) { r.spush(&arguments, resultValueFunctor) }
    if r.same(ty.*.name, "ScheduledAction") {
        const interfaceName = cg.getVisibleInterfaceName(interface)
        if r.truthy(functionName) {
            r.spush(&arguments, cat([_]Str{ "\"", interfaceName, " ", functionName, "\"_s" }[0..]))
        } else {
            r.spush(&arguments, cat([_]Str{ "\"", interfaceName, " ", context.*.name, "\"_s" }[0..]))
        }
    }
    const convertFunction = if r.isDef(defaultValueFunctor) { "convertOptionalWithDefault" } else { "convert" }
    return cat([_]Str{ convertFunction, "<", idlType, ">(", r.sjoin(arguments, ", "), ")" }[0..])
}

// JSValueToNative with the arguments after GLOBALOBJECTREFERENCE left out (undef).
pub fn jsValueToNativeShort(interface: *Node, context: *Node, v: Str, conditional: Str, lexicalGlobalObjectPointer: Str, lexicalGlobalObjectReference: Str, thisObjectReference: Str, globalObjectReference: Str, exceptionThrowerFunctor: Str) -> Str {
    return jsValueToNative(interface, context, v, conditional, lexicalGlobalObjectPointer, lexicalGlobalObjectReference, thisObjectReference, globalObjectReference, exceptionThrowerFunctor, r.undef(), false, r.undef(), r.undef())
}

pub fn toNativeForFunctionWithoutTypeCheck(interface: *Node, context: *Node, v: Str, conditional: Str, lexicalGlobalObjectPointer: Str, lexicalGlobalObjectReferenceValue: Str, thisObjectReference: Str) -> Str {
    if !isValidContextForJSValueToNative(context) { r.die("Invalid context type") }
    const ty = context.*.ty.?
    const lexicalGlobalObjectReference = r.orElse(lexicalGlobalObjectReferenceValue, "*lexicalGlobalObject")
    js.addToImplIncludesForIDLType(ty, conditional)
    js.addToImplInclude("DOMJITIDLConvert.h")
    const idlType = getIDLType(interface, ty)
    return cat([_]Str{ "DOMJIT::DirectConverter<", idlType, ">::directConvert(", lexicalGlobalObjectReference, ", ", v, ")" }[0..])
}

fn overrideNeedsStateOrGlobalObject(ty: *IDLType, result: *bool) -> bool {
    if !tOn(ty, "OverrideIDLType") { return false }
    const name = m.get(ty.*.ext, "OverrideIDLType")
    result.* = r.same(name, "IDLIDBKey") || r.same(name, "IDLWebGLAny") || r.same(name, "IDLWebGLExtensionAny")
    return true
}

pub fn nativeToJSValueDOMConvertNeedsState(ty: *IDLType) -> bool {
    var result = false
    if overrideNeedsStateOrGlobalObject(ty, &result) { return result }
    if ty.*.isUnion { return true }
    if cg.isSequenceOrFrozenArrayType(ty) || cg.isRecordType(ty) || cg.isStringType(ty) || cg.isEnumType(ty) || cg.isDictionaryType(ty) || cg.isInterfaceType(ty) || cg.isBufferSourceType(ty) || cg.isPromiseType(ty) { return true }
    if r.same(ty.*.name, "Date") || r.same(ty.*.name, "JSON") || r.same(ty.*.name, "SerializedScriptValue") { return true }
    return false
}

pub fn nativeToJSValueDOMConvertNeedsGlobalObject(ty: *IDLType) -> bool {
    var result = false
    if overrideNeedsStateOrGlobalObject(ty, &result) { return result }
    if ty.*.isUnion { return true }
    if cg.isSequenceOrFrozenArrayType(ty) || cg.isRecordType(ty) || cg.isDictionaryType(ty) || cg.isInterfaceType(ty) || cg.isBufferSourceType(ty) || cg.isPromiseType(ty) { return true }
    if r.same(ty.*.name, "SerializedScriptValue") { return true }
    return false
}

pub fn nativeToJSValueUsingReferences(context: *Node, interface: *Node, v: Str, globalObjectReference: Str) -> Str { return nativeToJSValue(context, interface, v, "lexicalGlobalObject", globalObjectReference) }
pub fn nativeToJSValueUsingPointers(context: *Node, interface: *Node, v: Str, globalObjectReference: Str) -> Str { return nativeToJSValue(context, interface, v, "*lexicalGlobalObject", globalObjectReference) }

pub fn nativeToJSValue(context: *Node, interface: *Node, value: Str, lexicalGlobalObjectReference: Str, globalObjectReference: Str) -> Str {
    if !(context.*.kind == m.K_ATTRIBUTE || context.*.kind == m.K_ARGUMENT || context.*.kind == m.K_MEMBER || context.*.kind == m.K_OPERATION) { r.die("Invalid context type") }
    const conditional = ext(context, "Conditional")
    const ty = context.*.ty.?
    const mayThrowException = context.*.kind == m.K_ATTRIBUTE || context.*.kind == m.K_OPERATION || context.*.kind == m.K_MEMBER
    var v = value
    if on(context, "Reflect") && (r.same(ty.*.name, "unsigned long") || r.same(ty.*.name, "unsigned short")) {
        v = r.replaceAll(v, "unsignedIntegral", "integral")
        v = r.c3("std::max(0, ", v, ")")
    }
    js.addToImplIncludesForIDLType(ty, conditional)
    if nativeToJSValueDOMConvertNeedsGlobalObject(ty) { js.addToImplIncludes("JSDOMGlobalObject.h", conditional) }
    if on(context, "CheckSecurityForNode") {
        js.addToImplIncludes("JSDOMBindingSecurity.h", conditional)
        v = cat([_]Str{ "BindingSecurity::checkSecurityForNode(", lexicalGlobalObjectReference, ", ", v, ")" }[0..])
    }
    if on(context, "CheckSecurityForNodeWithFrameOwner") {
        js.addToImplIncludes("JSDOMBindingSecurity.h", conditional)
        v = cat([_]Str{ "BindingSecurity::checkSecurityForNodeWithFrameOwner(", lexicalGlobalObjectReference, ", ", v, ", impl)" }[0..])
    }
    if on(context, "CheckSecurityForNodeWithDOMWindow") {
        js.addToImplIncludes("JSDOMBindingSecurity.h", conditional)
        v = cat([_]Str{ "BindingSecurity::checkSecurityForNodeWithDOMWindow(", lexicalGlobalObjectReference, ", ", v, ", impl)" }[0..])
    }
    const idlType = getIDLType(interface, ty)
    const needsFunctorWrapping = r.same(ty.*.name, "undefined") || cg.isPromiseType(ty) || on(context, "ReturnsPromisePair")
    var arguments = r.strList()
    if nativeToJSValueDOMConvertNeedsState(ty) || mayThrowException { r.spush(&arguments, lexicalGlobalObjectReference) }
    if nativeToJSValueDOMConvertNeedsGlobalObject(ty) { r.spush(&arguments, globalObjectReference) }
    if mayThrowException { r.spush(&arguments, "throwScope") }
    if needsFunctorWrapping {
        r.spush(&arguments, cat([_]Str{ "[&] -> decltype(auto) { return ", v, "; }" }[0..]))
    } else {
        r.spush(&arguments, v)
    }
    const functionName = if on(context, "NewObject") { "toJSNewlyCreated" } else { "toJS" }
    return cat([_]Str{ functionName, "<", idlType, ">(", r.sjoin(arguments, ", "), ")" }[0..])
}
