// The bindings of the Web Inspector protocol, made as WebKit's
// inspector/scripts/generate-inspector-protocol-bindings.py makes them
// (with its codegen package), from a protocol specification such as
// JavaScriptCore's CombinedDomains.json:
//
//     webkit-inspector-protocol-bindings --outputDir DIR --framework NAME
//         [--force] [--frontend] [--backend] [--test]
//         PRIMARY.json [SUPPLEMENTAL.json ...]
//
// The supplemental specifications only give types the primary one refers
// to. What is made depends on the framework (named as WebKit names them):
//
//     JavaScriptCore  InspectorBackendCommands.js and the C++ of the
//                     protocol group "Inspector": InspectorAlternateBackendDispatchers.h,
//                     InspectorBackendDispatchers.h/.cpp, InspectorFrontendDispatchers.h/.cpp,
//                     InspectorProtocolObjects.h/.cpp
//     WebKit, WebDriverBidi
//                     the same C++ (but the alternate dispatchers) of the
//                     groups "Automation" and "WebDriverBidi"
//     WebInspectorUI  InspectorBackendCommands.js
//
// (the Objective-C bindings, of WebInspector and of WebKit's frontend,
// are not made). Each file is written only when its text changes, with
// one newline after its last line; with --test they all go into one file,
// PRIMARY.json-result, as the original's tests have them.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const m = @import("./inspectormodel.mlx")
const js = @import("./inspectorjs.mlx")
const backend = @import("./inspectorbackend.mlx")
const frontend = @import("./inspectorfrontend.mlx")
const objects = @import("./inspectorobjects.mlx")

const JS_BACKEND_COMMANDS: u8 = 0
const ALTERNATE_BACKEND_DISPATCHER_HEADER: u8 = 1
const BACKEND_DISPATCHER_HEADER: u8 = 2
const BACKEND_DISPATCHER_IMPLEMENTATION: u8 = 3
const FRONTEND_DISPATCHER_HEADER: u8 = 4
const FRONTEND_DISPATCHER_IMPLEMENTATION: u8 = 5
const PROTOCOL_TYPES_HEADER: u8 = 6
const PROTOCOL_TYPES_IMPLEMENTATION: u8 = 7

fn filename(p: *m.Protocol, generator: u8) -> []const u8 {
    const group = p.*.framework.cppProtocolGroup
    if generator == JS_BACKEND_COMMANDS { return js.outputFilename(p) }
    if generator == ALTERNATE_BACKEND_DISPATCHER_HEADER { return s.join(group, "AlternateBackendDispatchers.h") }
    if generator == BACKEND_DISPATCHER_HEADER { return s.join(group, "BackendDispatchers.h") }
    if generator == BACKEND_DISPATCHER_IMPLEMENTATION { return s.join(group, "BackendDispatchers.cpp") }
    if generator == FRONTEND_DISPATCHER_HEADER { return s.join(group, "FrontendDispatchers.h") }
    if generator == FRONTEND_DISPATCHER_IMPLEMENTATION { return s.join(group, "FrontendDispatchers.cpp") }
    if generator == PROTOCOL_TYPES_HEADER { return s.join(group, "ProtocolObjects.h") }
    return s.join(group, "ProtocolObjects.cpp")
}

fn output(p: *m.Protocol, generator: u8) -> []const u8 {
    if generator == JS_BACKEND_COMMANDS { return js.generate(p) }
    if generator == ALTERNATE_BACKEND_DISPATCHER_HEADER { return backend.generateAlternateHeader(p) }
    if generator == BACKEND_DISPATCHER_HEADER { return backend.generateHeader(p) }
    if generator == BACKEND_DISPATCHER_IMPLEMENTATION { return backend.generateImplementation(p) }
    if generator == FRONTEND_DISPATCHER_HEADER { return frontend.generateHeader(p) }
    if generator == FRONTEND_DISPATCHER_IMPLEMENTATION { return frontend.generateImplementation(p) }
    if generator == PROTOCOL_TYPES_HEADER { return objects.generateHeader(p) }
    return objects.generateImplementation(p)
}

fn usage() -> u8 {
    s.say("usage: webkit-inspector-protocol-bindings --outputDir DIR --framework NAME [--force] [--frontend] [--backend] [--test] PrimaryProtocol.json [SupplementalProtocol.json ...]\n")
    return 2
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var outputDirectory: []const u8 = ""
    var frameworkName: []const u8 = ""
    var force = false
    var concatenate = false
    var generateFrontend = false
    var generateBackend = false
    var specifications = t.list()
    var index: usize = 1
    while index < arguments.length {
        const argument = s.cString(arguments[index])
        if (s.same(argument, "--outputDir") || s.same(argument, "-o") || s.same(argument, "--framework")) && index + 1 < arguments.length {
            const value = s.cString(arguments[index + 1])
            if s.same(argument, "--framework") { frameworkName = value } else { outputDirectory = value }
            index += 2
            continue
        }
        if s.startsWith(argument, "--outputDir=") {
            outputDirectory = argument[12..argument.length]
        } else if s.startsWith(argument, "--framework=") {
            frameworkName = argument[12..argument.length]
        } else if s.same(argument, "--force") {
            force = true
        } else if s.same(argument, "--test") || s.same(argument, "-t") {
            concatenate = true
        } else if s.same(argument, "--frontend") {
            generateFrontend = true
        } else if s.same(argument, "--backend") {
            generateBackend = true
        } else if s.same(argument, "--debug") || s.same(argument, "-v") {
        } else if argument.length > 1 && argument[0] == 45 {
            return usage()
        } else {
            t.push(&specifications, argument)
        }
        index += 1
    }
    if specifications.count < 1 {
        s.say("ParseException: At least one plain argument expected\n")
        return usage()
    }
    if outputDirectory.length == 0 {
        s.say("ParseException: Missing output directory\n")
        return usage()
    }
    if !m.isFrameworkName(frameworkName) {
        s.say("--framework: invalid choice (choose from 'JavaScriptCore', 'WebInspector', 'WebInspectorUI', 'WebKit', 'WebDriverBidi', 'Test')\n")
        return usage()
    }
    // Neither asked for: both.
    if !generateBackend && !generateFrontend {
        generateBackend = true
        generateFrontend = true
    }

    const primary = specifications.items[0]
    const p = m.newProtocol(frameworkName)
    p.*.inputFilename = s.baseName(primary)
    index = 1
    while index < specifications.count {
        m.loadSpecification(p, specifications.items[index], true)
        index += 1
    }
    m.loadSpecification(p, primary, false)
    m.resolveTypes(p)

    var generators: [8]u8 = undefined
    var count: usize = 0
    const name = p.*.framework.name
    if s.same(name, "JavaScriptCore") || s.same(name, "Test") {
        if s.same(name, "Test") { s.say("note: the Objective-C bindings of the Test framework are not made\n") }
        var generator: u8 = 0
        while generator < 8 {
            generators[count] = generator
            count += 1
            generator += 1
        }
    } else if generateBackend && (s.same(name, "WebKit") || s.same(name, "WebDriverBidi")) {
        var generator: u8 = BACKEND_DISPATCHER_HEADER
        while generator < 8 {
            generators[count] = generator
            count += 1
            generator += 1
        }
    } else if s.same(name, "WebInspectorUI") {
        generators[0] = JS_BACKEND_COMMANDS
        count = 1
    } else if s.same(name, "WebKit") || s.same(name, "WebInspector") {
        s.fail("the Objective-C bindings are not made")
    }

    var concatenated = t.list()
    index = 0
    while index < count {
        const generator = generators[index]
        const file = filename(p, generator)
        if concatenate && generator == JS_BACKEND_COMMANDS {
            // The file before and after the preprocessor.
            const original = js.generateUnprocessed(p)
            t.push(&concatenated, t.c3("### Begin File: ", file, ".in"))
            t.push(&concatenated, original)
            t.push(&concatenated, t.c3("### End File: ", file, ".in"))
            t.push(&concatenated, "")
            t.push(&concatenated, t.c3("### Begin File: ", file, ".out"))
            t.push(&concatenated, js.preprocess(original, p.*.conditionFlags))
            t.push(&concatenated, t.c3("### End File: ", file, ".out"))
            t.push(&concatenated, "")
        } else if concatenate {
            t.push(&concatenated, s.join("### Begin File: ", file))
            t.push(&concatenated, output(p, generator))
            t.push(&concatenated, s.join("### End File: ", file))
            t.push(&concatenated, "")
        } else {
            writeFile(t.pathJoin(outputDirectory, file), output(p, generator), force)
        }
        index += 1
    }
    if concatenate {
        writeFile(t.pathJoin(outputDirectory, s.join(s.baseName(primary), "-result")), t.joined(concatenated, "\n"), force)
    }
    return 0
}

// TEXT to PATH as the original's IncrementalFileWriter has it: without its
// trailing whitespace but one newline, the file left alone when unchanged.
fn writeFile(path: []const u8, text: []const u8, force: bool) -> void {
    const contents = s.join(t.rstrip(text), "\n")
    if force {
        const directory = t.dirName(path)
        if directory.length > 0 { t.makeDirectories(directory) }
        s.writeWhole(path, contents)
    } else {
        t.writeIfChanged(path, contents)
    }
}
