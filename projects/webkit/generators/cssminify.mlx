// The minifiers of JavaScriptCore's Scripts: cssmin.py's regular
// expressions (comments, line ends and needless spaces taken out of CSS)
// and jsmin.py's JavascriptMinify (version 2.0.9, the character machine of
// Douglas Crockford's JSMin), both on the text's bytes, which for these
// ASCII sources is what the scripts do on its characters.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const j = @import("./inspectorjsonvalue.mlx")
const c = @import("./csstext.mlx")

// ---------------------------------------------------------------------------
// cssmin.py

// Python's \s on a str (ASCII part): space, \t \n \v \f \r and \x1c-\x1f.
fn isPythonSpace(byte: u8) -> bool { return byte == 32 || (byte >= 9 && byte <= 13) || (byte >= 28 && byte <= 31) }

fn isTight(byte: u8) -> bool { return byte == 59 || byte == 123 || byte == 125 || byte == 44 || byte == 126 || byte == 62 || byte == 33 }

pub fn cssminify(input: []const u8) -> []const u8 {
    // r"\/\*.*?\*\/" -> "" (after "\r\n" made "\n").
    var text = j.withoutComments(t.replaceAll(input, "\r\n", "\n"))
    // r"\n" -> "", r"\s+" -> " ".
    var b = c.buf()
    var index: usize = 0
    while index < text.length {
        if text[index] != 10 { c.addByte(&b, text[index]) }
        index += 1
    }
    text = c.contents(&b)
    b = c.buf()
    index = 0
    while index < text.length {
        if isPythonSpace(text[index]) {
            while index < text.length && isPythonSpace(text[index]) { index += 1 }
            c.addByte(&b, 32)
        } else {
            c.addByte(&b, text[index])
            index += 1
        }
    }
    text = c.contents(&b)
    // r"\s?([;{},~>!])\s?" -> r"\1".
    b = c.buf()
    index = 0
    while index < text.length {
        var at = index
        if isPythonSpace(text[at]) && at + 1 < text.length && isTight(text[at + 1]) { at += 1 }
        if isTight(text[at]) {
            c.addByte(&b, text[at])
            at += 1
            if at < text.length && isPythonSpace(text[at]) { at += 1 }
            index = at
        } else {
            c.addByte(&b, text[index])
            index += 1
        }
    }
    text = c.contents(&b)
    // r":\s" -> ":".
    b = c.buf()
    index = 0
    while index < text.length {
        c.addByte(&b, text[index])
        if text[index] == 58 && index + 1 < text.length && isPythonSpace(text[index + 1]) { index += 1 }
        index += 1
    }
    text = c.contents(&b)
    // r"\s?([-+])(?:\s(?![0-9(])(?!var))" -> r"\1".
    b = c.buf()
    index = 0
    while index < text.length {
        var matched = false
        var at = index
        var tries: usize = 0
        while tries < 2 && !matched {
            // First with the optional space taken, then without it.
            var sign = at
            if tries == 0 {
                if !(isPythonSpace(text[at]) && at + 1 < text.length) {
                    tries += 1
                    continue
                }
                sign = at + 1
            }
            if (text[sign] == 45 || text[sign] == 43) && sign + 1 < text.length && isPythonSpace(text[sign + 1]) {
                const after = sign + 2
                var allowed = true
                if after < text.length && (std.ascii.isDigit(text[after]) || text[after] == 40) { allowed = false }
                if after + 3 <= text.length && std.text.same(text[after..after + 3], "var") { allowed = false }
                if allowed {
                    c.addByte(&b, text[sign])
                    index = after
                    matched = true
                }
            }
            tries += 1
        }
        if !matched {
            c.addByte(&b, text[index])
            index += 1
        }
    }
    text = c.contents(&b)
    // r";}" -> "}".
    return t.replaceAll(text, ";}", "}")
}

// ---------------------------------------------------------------------------
// jsmin.py: characters as numbers, -1 standing for Python's '' (the end).

const NONE: i32 = -1

var input: [*]const u8 = undefined
var inputLength: usize = 0
var inputAt: usize = 0
var output: c.Buf = undefined
var isReturn: bool = false
// What return_buf holds, as far as it can still become "return".
var returnBuf: [8]u8 = undefined
var returnLength: usize = 0

fn read() -> i32 {
    if inputAt >= inputLength { return NONE }
    const byte = input[inputAt]
    inputAt += 1
    return @intCast(i32, byte)
}

// `char in "..."` of Python: '' is in every string.
fn isIn(char: i32, set: []const u8) -> bool {
    if char == NONE { return true }
    for byte in set {
        if @intCast(i32, byte) == char { return true }
    }
    return false
}

fn isReturnLetter(char: i32) -> bool { return char == 114 || char == 101 || char == 116 || char == 117 || char == 110 }

// write(): every text that is part of "return" is kept in return_buf.
fn writeText(text: []const u8) -> void {
    if text.length <= 6 && std.text.contains("return", text) {
        for byte in text {
            if returnLength < 7 { returnBuf[returnLength] = byte }
            returnLength += 1
        }
        isReturn = returnLength == 6 && std.text.same(returnBuf[0..6], "return")
    }
    c.add(&output, text)
    if isReturn { returnLength = 0 }
}

fn writeChar(char: i32) -> void {
    var one: [1]u8 = undefined
    one[0] = @intCast(u8, char)
    writeText(one[0..1])
}

const SPACE_STRINGS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$\\"
const NEWLINE_START = "{[(+-abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$\\"
const NEWLINE_END = "}])+-\"'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$\\"

pub fn jsmin(text: []const u8) -> []const u8 {
    input = text.pointer
    inputLength = text.length
    inputAt = 0
    output = c.buf()
    isReturn = false
    returnLength = 0
    var doNewline = false
    var doSpace = false
    var escapeSlashCount: usize = 0
    var doingSingleComment = false
    var previousBeforeComment: i32 = NONE
    var doingMultiComment = false
    var inRe = false
    var inQuote: i32 = NONE
    var quoteBuf = c.buf()
    var previousNonSpace: i32 = NONE

    var previous = read()
    if previous == 92 { escapeSlashCount += 1 }
    var next1 = read()
    if previous == 47 {
        if next1 == 47 {
            doingSingleComment = true
        } else if next1 == 42 {
            doingMultiComment = true
            previous = next1
            next1 = read()
        } else {
            writeChar(previous)
        }
    } else if previous == NONE {
        return c.contents(&output)
    } else if previous >= 33 {
        if previous == 39 || previous == 34 { inQuote = previous }
        writeChar(previous)
        previousNonSpace = previous
    } else {
        previousNonSpace = 32
    }
    if next1 == NONE { return c.contents(&output) }

    while true {
        var next2 = read()
        if next2 == NONE {
            // last = next1.strip()
            const blank = next1 == NONE || next1 == 32 || (next1 >= 9 && next1 <= 13) || (next1 >= 28 && next1 <= 31)
            if !(doingSingleComment || doingMultiComment) && !blank && next1 != 47 {
                if inQuote != NONE { writeText(c.contents(&quoteBuf)) }
                writeChar(next1)
            }
            break
        }
        if doingMultiComment {
            if next1 == 42 && next2 == 47 {
                doingMultiComment = false
                next2 = read()
            }
        } else if doingSingleComment {
            if isIn(next1, "\r\n") {
                doingSingleComment = false
                while isIn(next2, "\r\n") {
                    next2 = read()
                    if next2 == NONE { break }
                }
                if isIn(previousBeforeComment, ")}]") {
                    doNewline = true
                } else if isIn(previousBeforeComment, SPACE_STRINGS) {
                    writeText("\n")
                }
            }
        } else if inQuote != NONE {
            c.addByte(&quoteBuf, @intCast(u8, next1))
            if next1 == inQuote {
                const quoted = c.contents(&quoteBuf)
                var slashes: usize = 0
                var at = quoted.length - 1
                while at > 0 {
                    if quoted[at - 1] != 92 { break }
                    slashes += 1
                    at -= 1
                }
                if slashes % 2 == 0 {
                    inQuote = NONE
                    writeText(quoted)
                }
            }
        } else if isIn(next1, "\r\n") {
            if isIn(previousNonSpace, NEWLINE_END) || previousNonSpace > 126 {
                while true {
                    if next2 < 33 {
                        next2 = read()
                        if next2 == NONE { break }
                    } else {
                        if isIn(next2, NEWLINE_START) || next2 > 126 || next2 == 47 { doNewline = true }
                        break
                    }
                }
            }
        } else if next1 < 33 && !inRe {
            if (isIn(previousNonSpace, SPACE_STRINGS) || previousNonSpace > 126) && (isIn(next2, SPACE_STRINGS) || next2 > 126) {
                doSpace = true
            } else if isIn(previousNonSpace, "-+") && next2 == previousNonSpace {
                doSpace = true
            } else if isReturn && next2 == 47 {
                writeText(" ")
            }
        } else if next1 == 47 {
            if doSpace { writeText(" ") }
            if inRe {
                if previous != 92 || escapeSlashCount % 2 == 0 || isIn(next2, "gimy") { inRe = false }
                writeText("/")
            } else if next2 == 47 {
                doingSingleComment = true
                previousBeforeComment = previousNonSpace
            } else if next2 == 42 {
                doingMultiComment = true
                previous = next1
                next1 = next2
                next2 = read()
            } else {
                inRe = isIn(previousNonSpace, "(,=:[?!&|") || isReturn
                writeText("/")
            }
        } else {
            if doSpace {
                doSpace = false
                writeText(" ")
            }
            if doNewline {
                writeText("\n")
                doNewline = false
            }
            writeChar(next1)
            if !inRe && (next1 == 39 || next1 == 34 || next1 == 96) {
                inQuote = next1
                quoteBuf = c.buf()
            }
        }
        previous = next1
        next1 = next2
        if previous >= 33 { previousNonSpace = previous }
        if previous == 92 {
            escapeSlashCount += 1
        } else {
            escapeSlashCount = 0
        }
    }
    return c.contents(&output)
}
