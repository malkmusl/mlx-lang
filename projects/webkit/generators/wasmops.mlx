// JavaScriptCore's WasmOps.h, made as WebKit's generateWasmOpsHeader.py
// makes it, from wasm/wasm.json:
//
//     webkit-wasm-ops WASM_JSON OUTPUT
//
// The types and packed types become FOR_EACH_* macro lists (name, value,
// B3 type, position, ...), and so do the opcodes, sorted out by their
// category: special, control flow, unary and binary (with the types they
// take and give), memory loads and stores, table, saturating and wide
// arithmetic extended ops, atomics, GC. Then a bit set of the valid
// one-byte opcodes and the log2 of the alignment of each memory access.
// Everything is in the order of the JSON file. The text is the Python's
// to the byte.
const std = @import("std")
const s = @import("./support.mlx")
const w = @import("./wasmjson.mlx")

var types: usize = 0
var opcodes: usize = 0

// Python's capitalize(): the first letter a capital, the others small.
fn capitalized(text: []const u8) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        var byte = text[index]
        if index == 0 && byte >= 97 && byte <= 122 { byte -= 32 }
        if index > 0 && byte >= 65 && byte <= 90 { byte += 32 }
        s.put8(at + index, byte)
        index += 1
    }
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

fn cppType(entry: []const u8) -> []const u8 {
    if std.text.same(entry, "bool") { return "I32" }
    return capitalized(entry)
}

// One entry of a macro list, its line continued from the last.
fn macroStart(name: []const u8, value: i64, b3: []const u8, position: usize) -> void {
    s.out(" \\\n    macro(")
    s.out(w.toCpp(name))
    s.out(", ")
    s.out(w.pythonHex(value))
    s.out(", ")
    s.out(b3)
    s.out(", ")
    s.outUnsigned(@intCast(u64, position))
}

fn typeMacros() -> void {
    var position: usize = 0
    var entry = w.first(types)
    while entry != 0 {
        macroStart(w.keyOf(entry), w.integer(entry, "value"), w.text(entry, "b3type"), position)
        s.out(", ")
        s.out(w.keyOf(entry))
        s.out(", ")
        s.out(w.text(entry, "width"))
        s.out(")")
        position += 1
        entry = w.next(entry)
    }
}

// The sets of opcodes of the lists.
const SPECIAL: u8 = 0
const CONTROL: u8 = 1
const NON_COMPARE_UNARY: u8 = 2
const COMPARE_UNARY: u8 = 3
const NON_COMPARE_BINARY: u8 = 4
const COMPARE_BINARY: u8 = 5
const MEMORY_LOAD: u8 = 6
const MEMORY_STORE: u8 = 7
const TABLE: u8 = 8
const TRUNC_SATURATED: u8 = 9
const WIDE_ARITHMETIC: u8 = 10
const ATOMIC_LOAD: u8 = 11
const ATOMIC_STORE: u8 = 12
const ATOMIC_BINARY_RMW: u8 = 13
const ATOMIC_OTHER: u8 = 14
const GC: u8 = 15
const ATOMIC: u8 = 16

fn inSet(set: u8, op: usize) -> bool {
    const category = w.category(op)
    if set == SPECIAL {
        return !(w.isUnary(op) || w.isBinary(op) || std.text.same(category, "control") || std.text.same(category, "memory") || w.integer(op, "value") == 252 || std.text.same(category, "gc") || w.isAtomic(op))
    }
    if set == CONTROL { return std.text.same(category, "control") }
    if set == NON_COMPARE_UNARY { return w.isUnary(op) && !w.isCompare(op) }
    if set == COMPARE_UNARY { return w.isUnary(op) && w.isCompare(op) }
    if set == NON_COMPARE_BINARY { return w.isBinary(op) && !w.isCompare(op) }
    if set == COMPARE_BINARY { return w.isBinary(op) && w.isCompare(op) }
    if set == MEMORY_LOAD { return std.text.same(category, "memory") && w.returnCount(op) == 1 }
    if set == MEMORY_STORE { return std.text.same(category, "memory") && w.returnCount(op) == 0 }
    if set == TABLE { return std.text.same(category, "exttable") }
    if set == TRUNC_SATURATED { return std.text.same(category, "conversion") && w.integer(op, "value") == 252 }
    if set == WIDE_ARITHMETIC { return std.text.same(category, "widearithmetic") }
    if set == ATOMIC_LOAD { return w.isAtomicLoad(op) }
    if set == ATOMIC_STORE { return w.isAtomicStore(op) }
    if set == ATOMIC_BINARY_RMW { return w.isAtomicBinaryRMW(op) }
    if set == ATOMIC_OTHER { return w.isAtomic(op) && !w.isAtomicLoad(op) && !w.isAtomicStore(op) && !w.isAtomicBinaryRMW(op) }
    if set == GC { return std.text.same(category, "gc") }
    return w.isAtomic(op)
}

// What a list adds after the position of an opcode: nothing, the types
// of its parameters and results, the type of its result, or the type of
// its second parameter.
const NOTHING: u8 = 0
const ALL_TYPES: u8 = 1
const RESULT_TYPE: u8 = 2
const STORED_TYPE: u8 = 3

fn outTypes(list: usize) -> void {
    var entry = w.first(list)
    while entry != 0 {
        s.out(", ")
        s.out(cppType(w.textOf(entry)))
        entry = w.next(entry)
    }
}

// The list of the opcodes of SET, with their FIELD ("value" or
// "extendedOp") as their value.
fn opcodeMacros(set: u8, field: []const u8, extra: u8) -> void {
    var position: usize = 0
    var op = w.first(opcodes)
    while op != 0 {
        if inSet(set, op) {
            const b3 = if w.isSimple(op) { w.text(op, "b3op") } else { "Oops" }
            macroStart(w.keyOf(op), w.integer(op, field), b3, position)
            if extra == ALL_TYPES {
                outTypes(w.member(op, "parameter"))
                outTypes(w.member(op, "return"))
            } else if extra == RESULT_TYPE {
                s.out(", ")
                s.out(cppType(w.textOf(w.element(w.member(op, "return"), 0))))
            } else if extra == STORED_TYPE {
                s.out(", ")
                s.out(cppType(w.textOf(w.element(w.member(op, "parameter"), 1))))
            }
            s.out(")")
            position += 1
        }
        op = w.next(op)
    }
}

fn defines() -> void {
    s.out("#define FOR_EACH_WASM_SPECIAL_OP(macro)")
    opcodeMacros(SPECIAL, "value", NOTHING)
    s.out("\n\n#define FOR_EACH_WASM_CONTROL_FLOW_OP(macro)")
    opcodeMacros(CONTROL, "value", NOTHING)
    s.out("\n\n#define FOR_EACH_WASM_NON_COMPARE_UNARY_OP(macro)")
    opcodeMacros(NON_COMPARE_UNARY, "value", ALL_TYPES)
    s.out("\n\n#define FOR_EACH_WASM_COMPARE_UNARY_OP(macro)")
    opcodeMacros(COMPARE_UNARY, "value", ALL_TYPES)
    s.out("\n\n#define FOR_EACH_WASM_UNARY_OP(macro) \\\n    FOR_EACH_WASM_NON_COMPARE_UNARY_OP(macro) \\\n    FOR_EACH_WASM_COMPARE_UNARY_OP(macro)")
    s.out("\n\n#define FOR_EACH_WASM_NON_COMPARE_BINARY_OP(macro)")
    opcodeMacros(NON_COMPARE_BINARY, "value", ALL_TYPES)
    s.out("\n\n#define FOR_EACH_WASM_COMPARE_BINARY_OP(macro)")
    opcodeMacros(COMPARE_BINARY, "value", ALL_TYPES)
    s.out("\n\n#define FOR_EACH_WASM_BINARY_OP(macro) \\\n    FOR_EACH_WASM_NON_COMPARE_BINARY_OP(macro) \\\n    FOR_EACH_WASM_COMPARE_BINARY_OP(macro)")
    s.out("\n\n#define FOR_EACH_WASM_MEMORY_LOAD_OP(macro)")
    opcodeMacros(MEMORY_LOAD, "value", RESULT_TYPE)
    s.out("\n\n#define FOR_EACH_WASM_MEMORY_STORE_OP(macro)")
    opcodeMacros(MEMORY_STORE, "value", STORED_TYPE)
    s.out("\n\n#define FOR_EACH_WASM_TABLE_OP(macro)")
    opcodeMacros(TABLE, "extendedOp", NOTHING)
    s.out("\n\n#define FOR_EACH_WASM_TRUNC_SATURATED_OP(macro)")
    opcodeMacros(TRUNC_SATURATED, "extendedOp", ALL_TYPES)
    s.out("\n\n#define FOR_EACH_WASM_WIDE_ARITHMETIC_OP(macro)")
    opcodeMacros(WIDE_ARITHMETIC, "extendedOp", ALL_TYPES)
    s.out("\n\n#define FOR_EACH_WASM_EXT_ATOMIC_LOAD_OP(macro)")
    opcodeMacros(ATOMIC_LOAD, "extendedOp", RESULT_TYPE)
    s.out("\n\n#define FOR_EACH_WASM_EXT_ATOMIC_STORE_OP(macro)")
    opcodeMacros(ATOMIC_STORE, "extendedOp", STORED_TYPE)
    s.out("\n\n#define FOR_EACH_WASM_EXT_ATOMIC_BINARY_RMW_OP(macro)")
    opcodeMacros(ATOMIC_BINARY_RMW, "extendedOp", STORED_TYPE)
    s.out("\n\n#define FOR_EACH_WASM_EXT_ATOMIC_OTHER_OP(macro)")
    opcodeMacros(ATOMIC_OTHER, "extendedOp", NOTHING)
    s.out("\n\n#define FOR_EACH_WASM_GC_OP(macro)")
    opcodeMacros(GC, "extendedOp", NOTHING)
    s.out("\n\n")
}

// ---------------------------------------------------------------------------
// The valid one-byte opcodes: the values of all, and 0xfd (ExtSIMD).

var valid: [256]bool = undefined
var maxOpValue: usize = 0

fn findValid() -> void {
    var value: usize = 0
    while value < 256 {
        valid[value] = false
        value += 1
    }
    valid[253] = true
    maxOpValue = 253
    var op = w.first(opcodes)
    while op != 0 {
        const opValue = w.integer(op, "value")
        if opValue < 0 || opValue > 255 { s.fail(s.join("generateWasmOpsHeader: an opcode value out of a byte: ", w.keyOf(op))) }
        const at = @intCast(usize, opValue)
        valid[at] = true
        if at > maxOpValue { maxOpValue = at }
        op = w.next(op)
    }
}

// The bit set, eight opcodes a byte, "0xff, 0x3f, ...".
fn validOps() -> void {
    var index: usize = 0
    while index * 8 < maxOpValue + 1 {
        var entry: i64 = 0
        var bit: usize = 0
        while bit < 8 {
            if index * 8 + bit < 256 && valid[index * 8 + bit] { entry |= @intCast(i64, 1) << @intCast(u6, bit) }
            bit += 1
        }
        if index > 0 { s.out(", ") }
        s.out(w.pythonHex(entry))
        index += 1
    }
}

// ---------------------------------------------------------------------------
// The log2 of the alignment of a memory access: of the bits it reads or
// writes, the number after the operation's name ("i64.load32_u",
// "i32.atomic.rmw8.add_u") or else after the type ("f64.store").

fn log2Of(bits: usize) -> []const u8 {
    if bits == 8 { return "0" }
    if bits == 16 { return "1" }
    if bits == 32 { return "2" }
    if bits == 64 { return "3" }
    if bits == 128 { return "4" }
    s.fail("generateWasmOpsHeader: a memory access not of 8, 16, 32, 64 or 128 bits")
    return ""
}

fn number(text: []const u8, at: usize) -> usize {
    var value: usize = 0
    var index = at
    while index < text.length && s.isDigit(text[index]) {
        value = value * 10 + @intCast(usize, text[index] - 48)
        index += 1
    }
    return value
}

fn memoryLog2Alignment(op: usize) -> []const u8 {
    const name = w.keyOf(op)
    const category = w.category(op)
    if std.text.same(category, "atomic") {
        if std.text.same(name, "atomic.fence") { return log2Of(8) }
        if std.text.same(name, "memory.atomic.notify") { return log2Of(32) }
        if !std.text.startsWith(name, "memory.atomic.wait") { s.fail(s.join("generateWasmOpsHeader: an unknown atomic: ", name)) }
        return log2Of(number(name, 18))
    }
    if name.length < 5 || (name[0] != 105 && name[0] != 102) || name[3] != 46 { s.fail(s.join("generateWasmOpsHeader: an unknown memory access: ", name)) }
    var at: usize = 4
    while at < name.length && !s.isDigit(name[at]) { at += 1 }
    if at < name.length { return log2Of(number(name, at)) }
    return log2Of(number(name, 1))
}

// The cases of the opcodes of SET, one a line, as "PREFIXName: return N;".
fn alignmentCases(set: u8, prefix: []const u8) -> void {
    var firstCase = true
    var op = w.first(opcodes)
    while op != 0 {
        if inSet(set, op) {
            if !firstCase { s.out("\n") }
            firstCase = false
            s.out("    case ")
            s.out(prefix)
            s.out(w.toCpp(w.keyOf(op)))
            s.out(": return ")
            s.out(memoryLog2Alignment(op))
            s.out(";")
        }
        op = w.next(op)
    }
}

// ---------------------------------------------------------------------------

fn generate(jsonPath: []const u8, outputPath: []const u8) -> void {
    const root = w.load(jsonPath)
    types = w.section(root, "type")
    opcodes = w.section(root, "opcode")
    const packedTypes = w.section(root, "packed_type")
    var minTypeValue: i64 = 0
    var entry = w.first(types)
    var firstType = true
    while entry != 0 {
        const value = w.integer(entry, "value")
        if firstType || value < minTypeValue { minTypeValue = value }
        firstType = false
        entry = w.next(entry)
    }
    findValid()

    w.header("generateWasmOpsHeader.py")
    s.out("\n")
    s.out("\n")
    s.out("#pragma once\n")
    s.out("\n")
    s.out("#include <wtf/Compiler.h>\n")
    s.out("\n")
    s.out("WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN\n")
    s.out("\n")
    s.out("#include <wtf/Platform.h>\n")
    s.out("\n")
    s.out("#if ENABLE(WEBASSEMBLY)\n")
    s.out("\n")
    s.out("#include <cstdint>\n")
    s.out("#include <wtf/PrintStream.h>\n")
    s.out("#include <wtf/text/ASCIILiteral.h>\n")
    s.out("\n")
    s.out("namespace JSC {\n")
    s.out("\n")
    s.out("enum class Width : uint8_t;\n")
    s.out("\n")
    s.out("namespace Wasm {\n")
    s.out("\n")
    s.out("static constexpr unsigned expectedVersionNumber = ")
    s.out(w.expectedVersion(root))
    s.out(";\n\nstatic constexpr unsigned numTypes = ")
    s.outUnsigned(@intCast(u64, w.count(types)))
    s.out(";\n\nstatic constexpr int minTypeValue = ")
    s.outSigned(minTypeValue)
    s.out(";\n")
    s.out("#define FOR_EACH_WASM_TYPE(macro)")
    typeMacros()
    s.out("\n\n#define FOR_EACH_WASM_PACKED_TYPE(macro)")
    var packedType = w.first(packedTypes)
    while packedType != 0 {
        s.out(" \\\n    macro(")
        s.out(w.toCpp(w.keyOf(packedType)))
        s.out(", ")
        s.out(w.pythonHex(w.integer(packedType, "value")))
        s.out(")")
        packedType = w.next(packedType)
    }
    s.out("\n\n")
    // (The script means to leave out funcref and externref here, but its
    // filter looks at the macro text, which is never either: all go in.)
    s.out("#define FOR_EACH_WASM_TYPE_EXCEPT_FUNCREF_AND_EXTERNREF(macro)")
    typeMacros()
    s.out("\n")
    s.out("#define CREATE_ENUM_VALUE(name, id, ...) name = id,\n")
    s.out("enum class TypeKind : int8_t {\n")
    s.out("    FOR_EACH_WASM_TYPE(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("#undef CREATE_ENUM_VALUE\n")
    s.out("\n")
    s.out("#define CREATE_ENUM_VALUE(name, id) name = id,\n")
    s.out("enum class PackedType: int8_t {\n")
    s.out("    FOR_EACH_WASM_PACKED_TYPE(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("#undef CREATE_ENUM_VALUE\n")
    s.out("\n")
    s.out("using TypeIndex = uintptr_t;\n")
    s.out("\n")
    s.out("inline bool typeIndexIsType(TypeIndex index)\n")
    s.out("{\n")
    s.out("    auto signedIndex = static_cast<std::make_signed<TypeIndex>::type>(index);\n")
    s.out("    return (signedIndex < 0) && (signedIndex > minTypeValue);\n")
    s.out("}\n")
    s.out("\n")
    s.out("struct Type {\n")
    s.out("    TypeKind kind;\n")
    s.out("    TypeIndex index;\n")
    s.out("\n")
    s.out("    bool operator==(const Type& other) const\n")
    s.out("    {\n")
    s.out("        return other.kind == kind && other.index == index;\n")
    s.out("    }\n")
    s.out("\n")
    s.out("    bool isNullable() const\n")
    s.out("    {\n")
    s.out("        return kind == TypeKind::RefNull || kind == TypeKind::Externref || kind == TypeKind::Funcref;\n")
    s.out("    }\n")
    s.out("\n")
    s.out("    // Saying conservatively.\n")
    s.out("    bool definitelyIsCellOrNull() const;\n")
    s.out("    bool definitelyIsWasmGCObjectOrNull() const;\n")
    s.out("\n")
    s.out("    void dump(PrintStream& out) const;\n")
    s.out("    Width width() const;\n")
    s.out("\n")
    s.out("    // Use Wasm::isFuncref and Wasm::isExternref instead because they check against all kinds of representations of function references and external references.\n")
    s.out("\n")
    s.out("    #define CREATE_PREDICATE(name, ...) bool is ## name() const { return kind == TypeKind::name; }\n")
    s.out("    FOR_EACH_WASM_TYPE_EXCEPT_FUNCREF_AND_EXTERNREF(CREATE_PREDICATE)\n")
    s.out("    #undef CREATE_PREDICATE\n")
    s.out("\n")
    s.out("    bool isGP64() const\n")
    s.out("    {\n")
    s.out("        switch(kind) {\n")
    s.out("        case TypeKind::I64:\n")
    s.out("        case TypeKind::Funcref:\n")
    s.out("        case TypeKind::Exnref:\n")
    s.out("        case TypeKind::Externref:\n")
    s.out("        case TypeKind::RefNull:\n")
    s.out("        case TypeKind::Ref:\n")
    s.out("            return true;\n")
    s.out("        default:\n")
    s.out("            return false;\n")
    s.out("        }\n")
    s.out("    }\n")
    s.out("};\n")
    s.out("\n")
    s.out("namespace Types\n")
    s.out("{\n")
    s.out("#define CREATE_CONSTANT(name, id, ...) constexpr Type name = Type{TypeKind::name, 0u};\n")
    s.out("FOR_EACH_WASM_TYPE(CREATE_CONSTANT)\n")
    s.out("#undef CREATE_CONSTANT\n")
    s.out("#if USE(JSVALUE64)\n")
    s.out("constexpr Type IPtr = I64;\n")
    s.out("#elif USE(JSVALUE32_64)\n")
    s.out("constexpr Type IPtr = I32;\n")
    s.out("#endif\n")
    s.out("} // namespace Types\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, id, ...) case id: return true;\n")
    s.out("template <typename Int>\n")
    s.out("inline bool isValidTypeKind(Int i)\n")
    s.out("{\n")
    s.out("    switch (i) {\n")
    s.out("    default: return false;\n")
    s.out("    FOR_EACH_WASM_TYPE(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return false;\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, id, ...) case id: return true;\n")
    s.out("template <typename Int>\n")
    s.out("inline bool isValidPackedType(Int i)\n")
    s.out("{\n")
    s.out("    switch (i) {\n")
    s.out("    default: return false;\n")
    s.out("    FOR_EACH_WASM_PACKED_TYPE(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return false;\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, ...) case TypeKind::name: return #name ## _s;\n")
    s.out("inline ASCIILiteral makeString(TypeKind kind)\n")
    s.out("{\n")
    s.out("    switch (kind) {\n")
    s.out("    FOR_EACH_WASM_TYPE(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return { };\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, ...) case PackedType::name: return #name ## _s;\n")
    s.out("inline ASCIILiteral makeString(PackedType packedType)\n")
    s.out("{\n")
    s.out("    switch (packedType) {\n")
    s.out("    FOR_EACH_WASM_PACKED_TYPE(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return { };\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, id, b3type, inc, ...) case TypeKind::name: return inc;\n")
    s.out("inline int linearizeType(TypeKind kind)\n")
    s.out("{\n")
    s.out("    switch (kind) {\n")
    s.out("    FOR_EACH_WASM_TYPE(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return 0;\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, id, b3type, inc, ...) case inc: return TypeKind::name;\n")
    s.out("inline TypeKind linearizedToType(int i)\n")
    s.out("{\n")
    s.out("    switch (i) {\n")
    s.out("    FOR_EACH_WASM_TYPE(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return TypeKind::Void;\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("\n")
    defines()
    s.out("\n")
    s.out("#define FOR_EACH_WASM_EXT_PREFIX_OP_WITH_ENUM(macro) \\\n")
    s.out("    macro(ExtGC, 0xFB, Oops, 0, ExtGCOpType) \\\n")
    s.out("    macro(Ext1, 0xFC, Oops, 0, Ext1OpType) \\\n")
    s.out("    macro(ExtSIMD, 0xFD, Oops, 0, ExtSIMDOpType) \\\n")
    s.out("    macro(ExtAtomic, 0xFE, Oops, 0, ExtAtomicOpType)\n")
    s.out("\n")
    s.out("#define FOR_EACH_WASM_OP(macro) \\\n")
    s.out("    FOR_EACH_WASM_SPECIAL_OP(macro) \\\n")
    s.out("    FOR_EACH_WASM_CONTROL_FLOW_OP(macro) \\\n")
    s.out("    FOR_EACH_WASM_UNARY_OP(macro) \\\n")
    s.out("    FOR_EACH_WASM_BINARY_OP(macro) \\\n")
    s.out("    FOR_EACH_WASM_MEMORY_LOAD_OP(macro) \\\n")
    s.out("    FOR_EACH_WASM_MEMORY_STORE_OP(macro) \\\n")
    s.out("    FOR_EACH_WASM_EXT_PREFIX_OP_WITH_ENUM(macro)\n")
    s.out("\n")
    s.out("#define CREATE_ENUM_VALUE(name, id, ...) name = id,\n")
    s.out("\n")
    s.out("enum OpType : uint8_t {\n")
    s.out("    FOR_EACH_WASM_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("template<typename Int>\n")
    s.out("inline bool isValidOpType(Int i)\n")
    s.out("{\n")
    s.out("    // Bitset of valid ops.\n")
    s.out("    static const uint8_t valid[] = { ")
    validOps()
    s.out(" };\n    return 0 <= i && i <= ")
    s.outUnsigned(@intCast(u64, maxOpValue))
    s.out(" && (valid[i / 8] & (1 << (i % 8)));\n")
    s.out("}\n")
    s.out("\n")
    s.out("enum class BinaryOpType : uint8_t {\n")
    s.out("    FOR_EACH_WASM_BINARY_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("enum class UnaryOpType : uint8_t {\n")
    s.out("    FOR_EACH_WASM_UNARY_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("enum class LoadOpType : uint8_t {\n")
    s.out("    FOR_EACH_WASM_MEMORY_LOAD_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("enum class StoreOpType : uint8_t {\n")
    s.out("    FOR_EACH_WASM_MEMORY_STORE_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("enum class Ext1OpType : uint32_t {\n")
    s.out("    FOR_EACH_WASM_TABLE_OP(CREATE_ENUM_VALUE)\n")
    s.out("    FOR_EACH_WASM_TRUNC_SATURATED_OP(CREATE_ENUM_VALUE)\n")
    s.out("    FOR_EACH_WASM_WIDE_ARITHMETIC_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("enum class ExtSIMDOpType : uint32_t;\n")
    s.out("\n")
    s.out("enum class ExtGCOpType : uint32_t {\n")
    s.out("    FOR_EACH_WASM_GC_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("enum class ExtAtomicOpType : uint32_t {\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_LOAD_OP(CREATE_ENUM_VALUE)\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_STORE_OP(CREATE_ENUM_VALUE)\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_BINARY_RMW_OP(CREATE_ENUM_VALUE)\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_OTHER_OP(CREATE_ENUM_VALUE)\n")
    s.out("};\n")
    s.out("\n")
    s.out("#undef CREATE_ENUM_VALUE\n")
    s.out("\n")
    s.out("inline bool isControlOp(OpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    s.out("#define CREATE_CASE(name, ...) case OpType::name:\n")
    s.out("    FOR_EACH_WASM_CONTROL_FLOW_OP(CREATE_CASE)\n")
    s.out("        return true;\n")
    s.out("#undef CREATE_CASE\n")
    s.out("    default:\n")
    s.out("        break;\n")
    s.out("    }\n")
    s.out("    return false;\n")
    s.out("}\n")
    s.out("\n")
    s.out("inline bool isControlFlowInstruction(OpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    s.out("#define CREATE_CASE(name, ...) case OpType::name:\n")
    s.out("    FOR_EACH_WASM_CONTROL_FLOW_OP(CREATE_CASE)\n")
    s.out("        return true;\n")
    s.out("#undef CREATE_CASE\n")
    s.out("    default:\n")
    s.out("        break;\n")
    s.out("    }\n")
    s.out("    return false;\n")
    s.out("}\n")
    s.out("\n")
    s.out("// Enhanced version that includes ExtGC branch operations\n")
    s.out("// This function requires access to the current extended opcode for ExtGC operations\n")
    s.out("template<typename ExtendedOpcodeProvider>\n")
    s.out("inline bool isControlFlowInstructionWithExtGC(OpType op, ExtendedOpcodeProvider&& getExtendedOpcode)\n")
    s.out("{\n")
    s.out("    if (isControlFlowInstruction(op))\n")
    s.out("        return true;\n")
    s.out("\n")
    s.out("    if (op == OpType::ExtGC) {\n")
    s.out("        uint32_t extOp = getExtendedOpcode();\n")
    s.out("        return extOp == static_cast<uint32_t>(ExtGCOpType::BrOnCast) || extOp == static_cast<uint32_t>(ExtGCOpType::BrOnCastFail);\n")
    s.out("    }\n")
    s.out("\n")
    s.out("    return false;\n")
    s.out("}\n")
    s.out("\n")
    s.out("inline uint32_t memoryLog2Alignment(OpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    alignmentCases(MEMORY_LOAD, "")
    s.out("\n")
    alignmentCases(MEMORY_STORE, "")
    s.out("\n")
    s.out("    default:\n")
    s.out("        break;\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return 0;\n")
    s.out("}\n")
    s.out("\n")
    s.out("inline uint32_t memoryLog2Alignment(ExtAtomicOpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    alignmentCases(ATOMIC, "ExtAtomicOpType::")
    s.out("\n")
    s.out("    default:\n")
    s.out("        break;\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return 0;\n")
    s.out("}\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, ...) case name: return #name ## _s;\n")
    s.out("inline ASCIILiteral makeString(OpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    s.out("    FOR_EACH_WASM_OP(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return { };\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, ...) case Ext1OpType::name: return #name ## _s;\n")
    s.out("inline ASCIILiteral makeString(Ext1OpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    s.out("    FOR_EACH_WASM_TABLE_OP(CREATE_CASE)\n")
    s.out("    FOR_EACH_WASM_TRUNC_SATURATED_OP(CREATE_CASE)\n")
    s.out("    FOR_EACH_WASM_WIDE_ARITHMETIC_OP(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return { };\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, ...) case ExtGCOpType::name: return #name ## _s;\n")
    s.out("inline ASCIILiteral makeString(ExtGCOpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    s.out("    FOR_EACH_WASM_GC_OP(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return { };\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("#define CREATE_CASE(name, ...) case ExtAtomicOpType::name: return #name ## _s;\n")
    s.out("inline ASCIILiteral makeString(ExtAtomicOpType op)\n")
    s.out("{\n")
    s.out("    switch (op) {\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_LOAD_OP(CREATE_CASE)\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_STORE_OP(CREATE_CASE)\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_BINARY_RMW_OP(CREATE_CASE)\n")
    s.out("    FOR_EACH_WASM_EXT_ATOMIC_OTHER_OP(CREATE_CASE)\n")
    s.out("    }\n")
    s.out("    RELEASE_ASSERT_NOT_REACHED();\n")
    s.out("    return { };\n")
    s.out("}\n")
    s.out("#undef CREATE_CASE\n")
    s.out("\n")
    s.out("} } // namespace JSC::Wasm\n")
    s.out("\n")
    s.out("namespace WTF {\n")
    s.out("\n")
    s.out("inline void printInternal(PrintStream& out, JSC::Wasm::TypeKind kind)\n")
    s.out("{\n")
    s.out("    out.print(JSC::Wasm::makeString(kind));\n")
    s.out("}\n")
    s.out("\n")
    s.out("inline void printInternal(PrintStream& out, JSC::Wasm::OpType op)\n")
    s.out("{\n")
    s.out("    out.print(JSC::Wasm::makeString(op));\n")
    s.out("}\n")
    s.out("\n")
    s.out("inline void printInternal(PrintStream& out, JSC::Wasm::ExtAtomicOpType op)\n")
    s.out("{\n")
    s.out("    out.print(JSC::Wasm::makeString(op));\n")
    s.out("}\n")
    s.out("\n")
    s.out("} // namespace WTF\n")
    s.out("\n")
    s.out("#endif // ENABLE(WEBASSEMBLY)\n")
    s.out("\n")
    s.out("WTF_ALLOW_UNSAFE_BUFFER_USAGE_END\n")
    s.out("\n")
    s.writeOutput(outputPath)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-wasm-ops WASM_JSON OUTPUT\n")
        return 2
    }
    generate(std.text.cString(arguments[1]), std.text.cString(arguments[2]))
    return 0
}
