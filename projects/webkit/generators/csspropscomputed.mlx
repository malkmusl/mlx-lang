// process-css-properties.py's GenerateStyleComputedStyleProperties
// (StyleComputedStyleProperties.h, .cpp and its +ConstructionInlines,
// +GettersInlines, +SettersInlines and +InitialInlines headers): for each
// property stored in Style::ComputedStyle, its getter, setter, initial
// value and the related functions (explicitly set, visited link, color
// resolving), each declared, then defined inline or out of line unless
// skipped or custom; the logical property groups' getters and setters;
// the ColorPropertyTraits specializations. And
// GenerateStyleChangedAnimatablePropertiesGenerated
// (StyleChangedAnimatablePropertiesGenerated.cpp): a comparison function
// for each node of the storage tree that holds animatable properties.
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")
const g = @import("./csspropsterms.mlx")
const m = @import("./csspropsmodel.mlx")
const x = @import("./csspropsgen.mlx")

// ---------------------------------------------------------------------------
// Types of a property's functions.

fn computedType(p: *m.Property) -> []const u8 { return m.cgShown(p, "computed-style-type") }

fn getterReturnType(p: *m.Property) -> []const u8 {
    if s.same(m.cgText(p, "computed-style-storage-kind"), "reference") { return t.c3("const ", computedType(p), "&") }
    return computedType(p)
}

fn setterArgumentType(p: *m.Property) -> []const u8 {
    if s.same(m.cgText(p, "computed-style-storage-kind"), "reference") { return s.join(computedType(p), "&&") }
    return computedType(p)
}

fn setterReturnType(p: *m.Property) -> []const u8 {
    if m.cgOn(p, "computed-style-setter-returns-if-changed") { return "bool" }
    return "void"
}

// ---------------------------------------------------------------------------
// Storage access (StylePropertyStorageAccess).

const Storage = struct {
    valueType: []const u8
    kind: []const u8
    name: []const u8
    // For a physical-group container: the resolver's name.
    resolver: []const u8
    containerKind: []const u8
    path: t.List
}

fn newStorage(valueType: []const u8, kind: []const u8, name: []const u8, resolver: []const u8, containerKind: []const u8, path: t.List) -> *Storage {
    const storage: *Storage = unsafe { @ptrFromInt(*Storage, s.alloc(@sizeOf(Storage))) }
    storage.*.valueType = valueType
    storage.*.kind = kind
    storage.*.name = name
    storage.*.resolver = resolver
    storage.*.containerKind = containerKind
    storage.*.path = path
    return storage
}

fn getExpression(storage: *Storage) -> []const u8 {
    var expression: []const u8 = ""
    if s.same(storage.*.containerKind, "data") {
        expression = t.c3(t.joined(storage.*.path, "->"), "->", storage.*.name)
    } else if s.same(storage.*.containerKind, "struct") {
        expression = t.c3(t.joined(storage.*.path, "->"), ".", storage.*.name)
    } else if s.same(storage.*.containerKind, "physical-group") {
        expression = t.c4(t.joined(storage.*.path, "->"), ".", g.lowerFirst(g.nameToId(storage.*.resolver)), "()")
    } else {
        s.fail(s.join("No get expression for a container of kind ", storage.*.containerKind))
    }
    if s.same(storage.*.kind, "enum") { return t.c5("static_cast<", storage.*.valueType, ">(", expression, ")") }
    if s.same(storage.*.kind, "raw") { return t.c4(storage.*.valueType, "::fromRaw(", expression, ")") }
    return expression
}

fn setExpression(storage: *Storage, argument: []const u8) -> []const u8 {
    var rhs = argument
    if s.same(storage.*.kind, "reference") { rhs = t.c3("WTF::move(", argument, ")") }
    if s.same(storage.*.kind, "enum") { rhs = t.c3("static_cast<unsigned>(", argument, ")") }
    if s.same(storage.*.kind, "raw") { rhs = s.join(argument, ".toRaw()") }
    const base = t.joined(storage.*.path, ".access().")
    if s.same(storage.*.containerKind, "data") { return t.c5(base, ".access().", storage.*.name, " = ", rhs) }
    if s.same(storage.*.containerKind, "struct") { return t.c5(base, ".", storage.*.name, " = ", rhs) }
    if s.same(storage.*.containerKind, "physical-group") { return t.c6(base, ".set", g.nameToId(storage.*.resolver), "(", rhs, ")") }
    s.fail(s.join("No set expression for a container of kind ", storage.*.containerKind))
    return ""
}

// ---------------------------------------------------------------------------
// Functions (ComputedStyleFunctionBase and its kinds).

const F_GETTER: u8 = 1
const F_SETTER: u8 = 2
const F_DID_SET: u8 = 3
const F_INITIAL: u8 = 4
const F_HES_GETTER: u8 = 5
const F_HES_SETTER: u8 = 6
const F_VL_GETTER: u8 = 7
const F_VL_SETTER: u8 = 8
const F_COLOR_RESOLVER: u8 = 9
const F_COLOR_RCC: u8 = 10
const F_COLOR_RCC_ACF: u8 = 11
const F_COLOR_VL_RCC: u8 = 12
const F_COLOR_VL_RCC_ACF: u8 = 13
const F_COLOR_VD: u8 = 14
const F_COLOR_VD_ACF: u8 = 15
const F_AXIS_GET_SPECIFIED: u8 = 16
const F_AXIS_GET_CURRENT: u8 = 17
const F_AXIS_SET_CURRENT: u8 = 18
const F_SE_GET_SPECIFIED: u8 = 19
const F_SE_GET_CURRENT: u8 = 20
const F_SE_SET_CURRENT: u8 = 21
const F_BA_GET_SPECIFIED: u8 = 22
const F_BA_GET_CURRENT: u8 = 23
const F_BA_SET_CURRENT: u8 = 24
const F_LR_GET_SPECIFIED: u8 = 25
const F_LR_GET_CURRENT: u8 = 26
const F_LR_SET_CURRENT: u8 = 27
const F_CT_COLOR: u8 = 28
const F_CT_VL_COLOR: u8 = 29
const F_CT_RCC: u8 = 30
const F_CT_VL_RCC: u8 = 31
const F_CT_EXCLUDES: u8 = 32

const Fn = struct {
    kind: u8
    scope: []const u8
    name: []const u8
    exported: bool
    constant: bool
    isStatic: bool
    inlined: bool
    returnType: []const u8
    argumentType: []const u8
    argumentName: []const u8
    argumentDefault: []const u8
    hasArgument: bool
    isConst: bool
    p: *m.Property
    storage: ?*Storage
    // The logical groups' properties: major and minor; left, right, top,
    // bottom; horizontal and vertical (as a and b).
    a: *m.Property
    b: *m.Property
    top: *m.Property
    bottom: *m.Property
}

fn fnAt(l: g.Refs, index: usize) -> *Fn { return unsafe { @ptrFromInt(*Fn, l.items[index]) } }

fn newFn(kind: u8, p: *m.Property, name: []const u8, returnType: []const u8, isConst: bool) -> *Fn {
    const f: *Fn = unsafe { @ptrFromInt(*Fn, s.alloc(@sizeOf(Fn))) }
    f.*.kind = kind
    f.*.scope = "ComputedStyleProperties"
    f.*.name = name
    f.*.exported = false
    f.*.constant = false
    f.*.isStatic = false
    f.*.inlined = false
    f.*.returnType = returnType
    f.*.argumentType = ""
    f.*.argumentName = ""
    f.*.argumentDefault = ""
    f.*.hasArgument = false
    f.*.isConst = isConst
    f.*.p = p
    f.*.storage = null
    f.*.a = p
    f.*.b = p
    f.*.top = p
    f.*.bottom = p
    return f
}

fn argument(f: *Fn, argumentType: []const u8, name: []const u8) -> void {
    f.*.hasArgument = true
    f.*.argumentType = argumentType
    f.*.argumentName = name
}

fn isInlineFn(f: *Fn) -> bool { return f.*.constant || f.*.inlined }

fn on(p: *m.Property, key: []const u8) -> bool { return m.cgOn(p, key) }

fn isSkipped(f: *Fn) -> bool {
    const p = f.*.p
    const kind = f.*.kind
    const skipGetter = on(p, "skip-computed-style-getter")
    const skipSetter = on(p, "skip-computed-style-setter")
    if kind == F_GETTER { return skipGetter }
    if kind == F_SETTER { return skipSetter }
    if kind == F_DID_SET { return skipSetter || !on(p, "computed-style-setter-requires-did-set") }
    if kind == F_INITIAL { return on(p, "skip-computed-style-initial") }
    if kind == F_HES_GETTER { return skipGetter || !on(p, "computed-style-has-explicitly-set-storage-path") }
    if kind == F_HES_SETTER { return skipSetter || !on(p, "computed-style-has-explicitly-set-storage-path") }
    if kind == F_VL_GETTER { return skipGetter || !on(p, "computed-style-visited-link-storage-path") }
    if kind == F_VL_SETTER { return skipSetter || !on(p, "computed-style-visited-link-storage-path") }
    if kind == F_COLOR_RESOLVER || kind == F_COLOR_RCC || kind == F_COLOR_RCC_ACF || kind == F_COLOR_VD || kind == F_COLOR_VD_ACF { return skipGetter || !on(p, "color-property") }
    if kind == F_COLOR_VL_RCC || kind == F_COLOR_VL_RCC_ACF { return skipGetter || !on(p, "color-property") || !on(p, "computed-style-visited-link-storage-path") }
    if kind == F_CT_COLOR { return skipGetter || !on(p, "color-property") }
    if kind == F_CT_VL_COLOR { return skipGetter || !on(p, "color-property") || !on(p, "visited-link-color-support") }
    if kind == F_CT_RCC { return skipGetter || !on(p, "color-property") || !on(p, "color-property-traits-requires-resolving-current-color") }
    if kind == F_CT_VL_RCC { return skipGetter || !on(p, "color-property") || !on(p, "visited-link-color-support") || !on(p, "color-property-traits-requires-resolving-current-color") }
    if kind == F_CT_EXCLUDES { return skipGetter || !on(p, "color-property") || !on(p, "color-property-traits-requires-excludes-visited-link-color") }
    return false
}

fn isCustom(f: *Fn) -> bool {
    const p = f.*.p
    const kind = f.*.kind
    if kind == F_GETTER { return on(p, "computed-style-getter-custom") }
    if kind == F_SETTER { return on(p, "computed-style-setter-custom") }
    if kind == F_DID_SET { return true }
    if kind == F_INITIAL { return on(p, "computed-style-initial-custom") }
    if kind == F_HES_GETTER { return on(p, "computed-style-has-explicitly-set-getter-custom") }
    if kind == F_HES_SETTER { return on(p, "computed-style-has-explicitly-set-setter-custom") }
    if kind == F_VL_GETTER { return on(p, "computed-style-visited-link-getter-custom") }
    if kind == F_VL_SETTER { return on(p, "computed-style-visited-link-setter-custom") }
    if kind == F_CT_COLOR { return on(p, "color-property-traits-color-custom") }
    if kind == F_CT_VL_COLOR { return on(p, "color-property-traits-visited-link-color-custom") }
    if kind == F_CT_RCC || kind == F_CT_VL_RCC || kind == F_CT_EXCLUDES { return true }
    return false
}

fn declaration(w: *c.Writer, f: *Fn) -> void {
    var b = c.buf()
    if f.*.isStatic { c.add(&b, "static ") }
    if f.*.constant {
        c.add(&b, "constexpr ")
    } else if f.*.inlined {
        c.add(&b, "inline ")
    } else if f.*.exported {
        c.add(&b, "WEBCORE_EXPORT ")
    }
    c.add(&b, f.*.returnType)
    c.add(&b, " ")
    c.add(&b, f.*.name)
    c.add(&b, "(")
    if f.*.hasArgument {
        c.add(&b, f.*.argumentType)
        if f.*.argumentDefault.length > 0 {
            c.add(&b, " = ")
            c.add(&b, f.*.argumentDefault)
        }
    }
    c.add(&b, ")")
    if f.*.isConst { c.add(&b, " const") }
    c.add(&b, ";")
    c.write(w, c.contents(&b))
}

fn definitionLine(w: *c.Writer, f: *Fn) -> void {
    var b = c.buf()
    if f.*.constant {
        c.add(&b, "constexpr ")
    } else if f.*.inlined {
        c.add(&b, "inline ")
    }
    c.add(&b, f.*.returnType)
    c.add(&b, " ")
    c.add(&b, f.*.scope)
    c.add(&b, "::")
    c.add(&b, f.*.name)
    c.add(&b, "(")
    if f.*.hasArgument {
        c.add(&b, f.*.argumentType)
        c.add(&b, " ")
        c.add(&b, f.*.argumentName)
    }
    c.add(&b, ")")
    if f.*.isConst { c.add(&b, " const") }
    c.write(w, c.contents(&b))
}

fn body(w: *c.Writer, f: *Fn, lines: t.List) -> void {
    definitionLine(w, f)
    c.write(w, "{")
    c.indent(w)
    var index: usize = 0
    while index < lines.count {
        c.write(w, lines.items[index])
        index += 1
    }
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn oneLine(w: *c.Writer, f: *Fn, line: []const u8) -> void { body(w, f, x.one(line)) }

fn setterDefinition(w: *c.Writer, f: *Fn, didSet: []const u8) -> void {
    const name = f.*.argumentName
    const getter = getExpression(f.*.storage.?)
    const setter = setExpression(f.*.storage.?, name)
    definitionLine(w, f)
    c.write(w, "{")
    c.indent(w)
    if s.same(f.*.returnType, "void") || s.same(f.*.returnType, "bool") {
        c.write(w, t.c5("if (", name, " != ", getter, ") {"))
        c.indent(w)
        c.write(w, s.join(setter, ";"))
        if didSet.length > 0 { c.write(w, s.join(didSet, ";")) }
        if s.same(f.*.returnType, "bool") { c.write(w, "return true;") }
        c.outdent(w)
        c.write(w, "}")
        if s.same(f.*.returnType, "bool") { c.write(w, "return false;") }
    }
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

// ValueKeywordName.cpp_enum_literal.
fn enumLiteral(base: []const u8, id: []const u8) -> []const u8 {
    var override: []const u8 = ""
    if s.same(base, "WindRule") {
        if s.same(id, "Nonzero") { override = "NonZero" }
        if s.same(id, "Evenodd") { override = "EvenOdd" }
    }
    if s.same(base, "FlexWrap") && s.same(id, "Nowrap") { override = "NoWrap" }
    if s.same(base, "TextDirection") {
        if s.same(id, "Ltr") { override = "LTR" }
        if s.same(id, "Rtl") { override = "RTL" }
    }
    return t.c3(base, "::", if override.length > 0 { override } else { id })
}

fn literalExpression(p: *m.Property, element: *m.InitialElement) -> []const u8 {
    if element.*.kind == m.I_SPECIAL { s.fail(s.join("Special literals must have custom initial function implementation: ", p.*.name)) }
    if s.same(m.cgText(p, "computed-style-storage-kind"), "enum") {
        if element.*.kind != m.I_KEYWORD { s.fail(s.join("A numeric initial value of an enum: ", p.*.name)) }
        return enumLiteral(computedType(p), g.nameToId(element.*.name))
    }
    if element.*.kind == m.I_KEYWORD { return t.c3("CSS::Keyword::", g.nameToId(element.*.name), " { }") }
    if element.*.unit.length == 0 { return s.join(element.*.digits, "_css_number") }
    if s.same(element.*.unit, "%") { return s.join(element.*.digits, "_css_percentage") }
    return t.c3(element.*.digits, "_css_", element.*.unit)
}

fn initialDefinition(w: *c.Writer, f: *Fn) -> void {
    const p = f.*.p
    if p.*.initial == null { s.fail(s.join("No initial value for ", p.*.name)) }
    const elements = p.*.initial.?.*.elements
    var expression: []const u8 = ""
    var literals = false
    var index: usize = 0
    while index < elements.count {
        if m.elementAt(elements, index).*.kind == m.I_NUMERIC { literals = true }
        index += 1
    }
    if elements.count == 1 {
        expression = literalExpression(p, m.elementAt(elements, 0))
    } else {
        var parts = t.list()
        index = 0
        while index < elements.count {
            t.push(&parts, literalExpression(p, m.elementAt(elements, index)))
            index += 1
        }
        expression = t.c3("{ ", t.joined(parts, ", "), " }")
    }
    var lines = t.list()
    if literals { t.push(&lines, "using namespace CSS::Literals;") }
    t.push(&lines, t.c3("return ", expression, ";"))
    body(w, f, lines)
}

fn colorResolverGetter(p: *m.Property) -> []const u8 { return s.join(m.cgText(p, "computed-style-getter"), "Resolver()") }

fn moveValue(setter: []const u8) -> []const u8 { return s.join(setter, "(WTF::move(value));") }

fn definition(w: *c.Writer, f: *Fn) -> void {
    const kind = f.*.kind
    const p = f.*.p
    if kind == F_GETTER || kind == F_HES_GETTER || kind == F_VL_GETTER { return oneLine(w, f, t.c3("return ", getExpression(f.*.storage.?), ";")) }
    if kind == F_SETTER {
        const didSet = if on(p, "computed-style-setter-requires-did-set") { t.c3("didSet", m.cgShown(p, "computed-style-name-for-methods"), "()") } else { "" }
        return setterDefinition(w, f, didSet)
    }
    if kind == F_HES_SETTER || kind == F_VL_SETTER { return setterDefinition(w, f, "") }
    if kind == F_INITIAL { return initialDefinition(w, f) }
    if kind == F_COLOR_RESOLVER { return oneLine(w, f, t.c3("return ColorPropertyResolver<ColorPropertyTraits<PropertyNameConstant<", m.idWithoutScope(p), ">>> { *this };")) }
    if kind == F_COLOR_RCC { return oneLine(w, f, t.c3("return ", colorResolverGetter(p), ".colorResolvingCurrentColor();")) }
    if kind == F_COLOR_RCC_ACF { return oneLine(w, f, t.c3("return ", colorResolverGetter(p), ".colorResolvingCurrentColorApplyingColorFilter();")) }
    if kind == F_COLOR_VL_RCC { return oneLine(w, f, t.c3("return ", colorResolverGetter(p), ".visitedLinkColorResolvingCurrentColor();")) }
    if kind == F_COLOR_VL_RCC_ACF { return oneLine(w, f, t.c3("return ", colorResolverGetter(p), ".visitedLinkColorResolvingCurrentColorApplyingColorFilter();")) }
    if kind == F_COLOR_VD { return oneLine(w, f, t.c5("return ", colorResolverGetter(p), ".visitedDependentColor(", f.*.argumentName, ");")) }
    if kind == F_COLOR_VD_ACF { return oneLine(w, f, t.c5("return ", colorResolverGetter(p), ".visitedDependentColorApplyingColorFilter(", f.*.argumentName, ");")) }
    const aGetter = m.cgText(f.*.a, "computed-style-getter")
    const bGetter = m.cgText(f.*.b, "computed-style-getter")
    const aSetter = m.cgText(f.*.a, "computed-style-setter")
    const bSetter = m.cgText(f.*.b, "computed-style-setter")
    const topGetter = m.cgText(f.*.top, "computed-style-getter")
    const bottomGetter = m.cgText(f.*.bottom, "computed-style-getter")
    const topSetter = m.cgText(f.*.top, "computed-style-setter")
    const bottomSetter = m.cgText(f.*.bottom, "computed-style-setter")
    const arg = f.*.argumentName
    if kind == F_AXIS_GET_SPECIFIED { return oneLine(w, f, t.c7("return ", arg, ".isHorizontal() ? ", aGetter, "() : ", bGetter, "();")) }
    if kind == F_AXIS_GET_CURRENT { return oneLine(w, f, t.c3("return logical", f.*.a.*.id, "(writingMode());")) }
    if kind == F_SE_GET_CURRENT || kind == F_BA_GET_CURRENT || kind == F_LR_GET_CURRENT { return oneLine(w, f, t.c3("return ", f.*.name, "(writingMode());")) }
    var lines = t.list()
    if kind == F_AXIS_SET_CURRENT || kind == F_LR_SET_CURRENT {
        t.push(&lines, "if (writingMode().isHorizontal())")
        t.push(&lines, s.join("    ", moveValue(aSetter)))
        t.push(&lines, "else")
        t.push(&lines, s.join("    ", moveValue(bSetter)))
    } else if kind == F_SE_GET_SPECIFIED {
        t.push(&lines, t.c3("if (", arg, ".isHorizontal())"))
        t.push(&lines, t.c7("    return ", arg, ".isInlineLeftToRight() ? ", aGetter, "() : ", bGetter, "();"))
        t.push(&lines, "else")
        t.push(&lines, t.c7("    return ", arg, ".isInlineTopToBottom() ? ", topGetter, "() : ", bottomGetter, "();"))
    } else if kind == F_SE_SET_CURRENT {
        t.push(&lines, "if (writingMode().isHorizontal()) {")
        t.push(&lines, "    if (writingMode().isInlineLeftToRight())")
        t.push(&lines, s.join("        ", moveValue(aSetter)))
        t.push(&lines, "    else")
        t.push(&lines, s.join("        ", moveValue(bSetter)))
        t.push(&lines, "} else {")
        t.push(&lines, "    if (writingMode().isInlineTopToBottom())")
        t.push(&lines, s.join("        ", moveValue(topSetter)))
        t.push(&lines, "    else")
        t.push(&lines, s.join("        ", moveValue(bottomSetter)))
        t.push(&lines, "}")
    } else if kind == F_BA_GET_SPECIFIED {
        t.push(&lines, t.c3("switch (", arg, ".blockDirection()) {"))
        t.push(&lines, "case FlowDirection::LeftToRight:")
        t.push(&lines, t.c3("    return ", aGetter, "();"))
        t.push(&lines, "case FlowDirection::RightToLeft:")
        t.push(&lines, t.c3("    return ", bGetter, "();"))
        t.push(&lines, "case FlowDirection::TopToBottom:")
        t.push(&lines, t.c3("    return ", topGetter, "();"))
        t.push(&lines, "case FlowDirection::BottomToTop:")
        t.push(&lines, t.c3("    return ", bottomGetter, "();"))
        t.push(&lines, "}")
        t.push(&lines, "ASSERT_NOT_REACHED();")
        t.push(&lines, t.c3("return ", bottomGetter, "();"))
    } else if kind == F_BA_SET_CURRENT {
        t.push(&lines, "switch (writingMode().blockDirection()) {")
        t.push(&lines, "case FlowDirection::LeftToRight:")
        t.push(&lines, t.c3("    return ", moveValue(aSetter), ""))
        t.push(&lines, "case FlowDirection::RightToLeft:")
        t.push(&lines, t.c3("    return ", moveValue(bSetter), ""))
        t.push(&lines, "case FlowDirection::TopToBottom:")
        t.push(&lines, t.c3("    return ", moveValue(topSetter), ""))
        t.push(&lines, "case FlowDirection::BottomToTop:")
        t.push(&lines, t.c3("    return ", moveValue(bottomSetter), ""))
        t.push(&lines, "}")
    } else if kind == F_LR_GET_SPECIFIED {
        t.push(&lines, t.c3("if (", arg, ".isHorizontal())"))
        t.push(&lines, t.c3("    return ", aGetter, "();"))
        t.push(&lines, "else")
        t.push(&lines, t.c3("    return ", bGetter, "();"))
    } else if kind == F_CT_COLOR {
        t.push(&lines, t.c3("return style.", m.cgText(p, "computed-style-getter"), "();"))
    } else if kind == F_CT_VL_COLOR {
        t.push(&lines, t.c3("return style.visitedLink", m.cgShown(p, "computed-style-name-for-methods"), "();"))
    } else {
        s.fail(t.c3("'", f.*.name, "' always requires a custom definition"))
    }
    body(w, f, lines)
}

// ComputedStylePropertyFunctionSet.
fn declarations(w: *c.Writer, l: g.Refs) -> void {
    var index: usize = 0
    while index < l.count {
        if !isSkipped(fnAt(l, index)) { declaration(w, fnAt(l, index)) }
        index += 1
    }
}

fn inlineDefinitions(w: *c.Writer, l: g.Refs) -> void {
    var index: usize = 0
    while index < l.count {
        const f = fnAt(l, index)
        if !isSkipped(f) && !isCustom(f) && isInlineFn(f) { definition(w, f) }
        index += 1
    }
}

fn outOfLineDefinitions(w: *c.Writer, l: g.Refs) -> void {
    var index: usize = 0
    while index < l.count {
        const f = fnAt(l, index)
        if !isSkipped(f) && !isCustom(f) && !isInlineFn(f) { definition(w, f) }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// A property's functions (ComputedStylePropertyGenerator).

const PropertyFunctions = struct {
    getter: *Fn
    setter: *Fn
    initial: *Fn
    didSet: *Fn
    hesGetter: *Fn
    hesSetter: *Fn
    vlGetter: *Fn
    vlSetter: *Fn
    colorResolver: *Fn
    rcc: *Fn
    rccAcf: *Fn
    vlRcc: *Fn
    vlRccAcf: *Fn
    vd: *Fn
    vdAcf: *Fn
}

fn storageName(p: *m.Property, container: []const u8, nameKey: []const u8) -> []const u8 {
    if s.same(container, "physical-group") { return "" }
    return m.cgShown(p, nameKey)
}

fn resolverOf(p: *m.Property, container: []const u8) -> []const u8 {
    if s.same(container, "physical-group") { return p.*.logicalGroup.?.*.resolver }
    return ""
}

fn propertyFunctions(p: *m.Property) -> *PropertyFunctions {
    const pf: *PropertyFunctions = unsafe { @ptrFromInt(*PropertyFunctions, s.alloc(@sizeOf(PropertyFunctions))) }
    const methods = m.cgShown(p, "computed-style-name-for-methods")
    const getterName = m.cgShown(p, "computed-style-getter")
    const container = m.cgContainer(p, "computed-style-storage-container")
    const principle = newStorage(computedType(p), m.cgShown(p, "computed-style-storage-kind"), storageName(p, container, "computed-style-storage-name"), resolverOf(p, container), container, m.cgList(p, "computed-style-storage-path"))
    const hesContainer = m.cgContainer(p, "computed-style-has-explicitly-set-storage-container")
    const hes = newStorage("bool", "value", storageName(p, hesContainer, "computed-style-has-explicitly-set-storage-name"), resolverOf(p, hesContainer), hesContainer, m.cgList(p, "computed-style-has-explicitly-set-storage-path"))
    const vlContainer = m.cgContainer(p, "computed-style-visited-link-storage-container")
    const vl = newStorage(computedType(p), m.cgShown(p, "computed-style-storage-kind"), storageName(p, vlContainer, "computed-style-visited-link-storage-name"), resolverOf(p, vlContainer), vlContainer, m.cgList(p, "computed-style-visited-link-storage-path"))

    var f = newFn(F_GETTER, p, getterName, getterReturnType(p), true)
    f.*.constant = on(p, "computed-style-getter-constexpr")
    f.*.inlined = m.cgOnByDefault(p, "computed-style-getter-inline")
    f.*.exported = on(p, "computed-style-getter-exported")
    f.*.storage = principle
    pf.*.getter = f

    f = newFn(F_SETTER, p, m.cgShown(p, "computed-style-setter"), setterReturnType(p), false)
    f.*.constant = on(p, "computed-style-setter-constexpr")
    f.*.inlined = m.cgOnByDefault(p, "computed-style-setter-inline")
    f.*.exported = on(p, "computed-style-setter-exported")
    argument(f, setterArgumentType(p), "value")
    f.*.storage = principle
    pf.*.setter = f

    f = newFn(F_DID_SET, p, s.join("didSet", methods), "void", false)
    f.*.inlined = true
    pf.*.didSet = f

    f = newFn(F_INITIAL, p, m.cgShown(p, "computed-style-initial"), computedType(p), false)
    f.*.isStatic = true
    f.*.constant = on(p, "computed-style-initial-constexpr")
    f.*.inlined = m.cgOnByDefault(p, "computed-style-initial-inline")
    f.*.exported = on(p, "computed-style-initial-exported")
    pf.*.initial = f

    f = newFn(F_HES_GETTER, p, s.join("hasExplicitlySet", methods), "bool", true)
    f.*.inlined = true
    f.*.storage = hes
    pf.*.hesGetter = f

    f = newFn(F_HES_SETTER, p, s.join("setHasExplicitlySet", methods), "void", false)
    f.*.inlined = true
    argument(f, "bool", "value")
    f.*.storage = hes
    pf.*.hesSetter = f

    f = newFn(F_VL_GETTER, p, s.join("visitedLink", methods), getterReturnType(p), true)
    f.*.inlined = true
    f.*.storage = vl
    pf.*.vlGetter = f

    f = newFn(F_VL_SETTER, p, s.join("setVisitedLink", methods), "void", false)
    f.*.inlined = true
    argument(f, setterArgumentType(p), "value")
    f.*.storage = vl
    pf.*.vlSetter = f

    f = newFn(F_COLOR_RESOLVER, p, s.join(getterName, "Resolver"), "decltype(auto)", true)
    f.*.inlined = true
    pf.*.colorResolver = f

    f = newFn(F_COLOR_RCC, p, s.join(getterName, "ResolvingCurrentColor"), "WebCore::Color", true)
    f.*.exported = on(p, "computed-style-resolving-current-color-exported")
    pf.*.rcc = f

    f = newFn(F_COLOR_RCC_ACF, p, s.join(getterName, "ResolvingCurrentColorApplyingColorFilter"), "WebCore::Color", true)
    f.*.exported = on(p, "computed-style-resolving-current-color-applying-color-filter-exported")
    pf.*.rccAcf = f

    f = newFn(F_COLOR_VL_RCC, p, t.c3("visitedLink", methods, "ResolvingCurrentColor"), "WebCore::Color", true)
    f.*.exported = on(p, "computed-style-visited-link-resolving-current-color-exported")
    pf.*.vlRcc = f

    f = newFn(F_COLOR_VL_RCC_ACF, p, t.c3("visitedLink", methods, "ResolvingCurrentColorApplyingColorFilter"), "WebCore::Color", true)
    f.*.exported = on(p, "computed-style-visited-link-resolving-current-color-applying-color-filter-exported")
    pf.*.vlRccAcf = f

    f = newFn(F_COLOR_VD, p, s.join("visitedDependent", methods), "WebCore::Color", true)
    f.*.exported = on(p, "computed-style-visited-dependent-exported")
    argument(f, "OptionSet<PaintBehavior>", "paintBehavior")
    f.*.argumentDefault = "{ }"
    pf.*.vd = f

    f = newFn(F_COLOR_VD_ACF, p, t.c3("visitedDependent", methods, "ApplyingColorFilter"), "WebCore::Color", true)
    f.*.exported = on(p, "computed-style-visited-dependent-applying-color-filter-exported")
    argument(f, "OptionSet<PaintBehavior>", "paintBehavior")
    f.*.argumentDefault = "{ }"
    pf.*.vdAcf = f
    return pf
}

fn allOf(pf: *PropertyFunctions) -> g.Refs {
    var l = g.refs()
    const all = [_]*Fn{ pf.*.getter, pf.*.setter, pf.*.initial, pf.*.didSet, pf.*.hesGetter, pf.*.hesSetter, pf.*.vlGetter, pf.*.vlSetter, pf.*.colorResolver, pf.*.rcc, pf.*.rccAcf, pf.*.vlRcc, pf.*.vlRccAcf, pf.*.vd, pf.*.vdAcf }
    for f in all { g.push(&l, @intFromPtr(f)) }
    return l
}

fn gettersOf(pf: *PropertyFunctions) -> g.Refs {
    var l = g.refs()
    const all = [_]*Fn{ pf.*.getter, pf.*.hesGetter, pf.*.vlGetter, pf.*.colorResolver, pf.*.rcc, pf.*.rccAcf, pf.*.vlRcc, pf.*.vlRccAcf, pf.*.vd, pf.*.vdAcf }
    for f in all { g.push(&l, @intFromPtr(f)) }
    return l
}

fn settersOf(pf: *PropertyFunctions) -> g.Refs {
    var l = g.refs()
    g.push(&l, @intFromPtr(pf.*.setter))
    g.push(&l, @intFromPtr(pf.*.hesSetter))
    g.push(&l, @intFromPtr(pf.*.vlSetter))
    return l
}

// ColorPropertyTraitsGenerator's functions.
fn colorTraits(p: *m.Property) -> g.Refs {
    const scope = t.c3("ColorPropertyTraits<PropertyNameConstant<", m.idWithoutScope(p), ">>")
    var l = g.refs()
    const kinds = [_]u8{ F_CT_COLOR, F_CT_VL_COLOR, F_CT_RCC, F_CT_VL_RCC, F_CT_EXCLUDES }
    const names = [_][]const u8{ "color", "visitedLinkColor", "colorResolvingCurrentColor", "visitedLinkColorResolvingCurrentColor", "excludesVisitedLinkColor" }
    const returns = [_][]const u8{ "const Color&", "const Color&", "WebCore::Color", "WebCore::Color", "bool" }
    var index: usize = 0
    while index < 5 {
        const f = newFn(kinds[index], p, names[index], returns[index], false)
        f.*.scope = scope
        f.*.isStatic = true
        f.*.inlined = true
        if index == 4 {
            argument(f, "const WebCore::Color&", "color")
        } else {
            argument(f, "const ComputedStyleProperties&", "style")
        }
        g.push(&l, @intFromPtr(f))
        index += 1
    }
    return l
}

// ---------------------------------------------------------------------------
// The logical property groups' functions.

fn groupFn(kind: u8, name: []const u8, returnType: []const u8, a: *m.Property, b: *m.Property) -> *Fn {
    const isGetter = !(kind == F_AXIS_SET_CURRENT || kind == F_SE_SET_CURRENT || kind == F_BA_SET_CURRENT || kind == F_LR_SET_CURRENT)
    const f = newFn(kind, a, name, returnType, isGetter)
    f.*.inlined = true
    f.*.a = a
    f.*.b = b
    if kind == F_AXIS_GET_SPECIFIED || kind == F_SE_GET_SPECIFIED || kind == F_BA_GET_SPECIFIED || kind == F_LR_GET_SPECIFIED { argument(f, "WritingMode", "writingMode") }
    if !isGetter { argument(f, setterArgumentType(a), "value") }
    return f
}

const LogicalFunctions = struct {
    group: *m.Group
    all: g.Refs
    getters: g.Refs
    setters: g.Refs
}

fn logicalAt(l: g.Refs, index: usize) -> *LogicalFunctions { return unsafe { @ptrFromInt(*LogicalFunctions, l.items[index]) } }

fn addTriple(lf: *LogicalFunctions, getSpecified: *Fn, getCurrent: *Fn, setCurrent: *Fn) -> void {
    g.push(&lf.*.all, @intFromPtr(getSpecified))
    g.push(&lf.*.all, @intFromPtr(getCurrent))
    g.push(&lf.*.all, @intFromPtr(setCurrent))
    g.push(&lf.*.getters, @intFromPtr(getSpecified))
    g.push(&lf.*.getters, @intFromPtr(getCurrent))
    g.push(&lf.*.setters, @intFromPtr(setCurrent))
}

fn sideTriple(lf: *LogicalFunctions, beforeAfter: bool, edge: []const u8, left: *m.Property, right: *m.Property, top: *m.Property, bottom: *m.Property) -> void {
    const prefix = g.nameToId(lf.*.group.*.name)
    const getterName = s.join(g.lowerFirst(prefix), edge)
    const setterName = t.c3("set", prefix, edge)
    var fns: [3]*Fn = undefined
    const kinds = if beforeAfter { [_]u8{ F_BA_GET_SPECIFIED, F_BA_GET_CURRENT, F_BA_SET_CURRENT } } else { [_]u8{ F_SE_GET_SPECIFIED, F_SE_GET_CURRENT, F_SE_SET_CURRENT } }
    var index: usize = 0
    while index < 3 {
        const f = groupFn(kinds[index], if index == 2 { setterName } else { getterName }, if index == 2 { "void" } else { getterReturnType(left) }, left, right)
        f.*.top = top
        f.*.bottom = bottom
        fns[index] = f
        index += 1
    }
    addTriple(lf, fns[0], fns[1], fns[2])
}

fn logicalFunctions(group: *m.Group) -> ?*LogicalFunctions {
    if !s.same(group.*.kind, "axis") && !s.same(group.*.kind, "side") { return null }
    const lf: *LogicalFunctions = unsafe { @ptrFromInt(*LogicalFunctions, s.alloc(@sizeOf(LogicalFunctions))) }
    lf.*.group = group
    lf.*.all = g.refs()
    lf.*.getters = g.refs()
    lf.*.setters = g.refs()
    if s.same(group.*.kind, "axis") {
        const horizontal = m.groupProperty(group, "physical", "horizontal")
        const vertical = m.groupProperty(group, "physical", "vertical")
        const pairs = [_]*m.Property{ horizontal, vertical, vertical, horizontal }
        var index: usize = 0
        while index < 2 {
            const major = pairs[index * 2]
            const minor = pairs[index * 2 + 1]
            const getSpecified = groupFn(F_AXIS_GET_SPECIFIED, s.join("logical", major.*.id), getterReturnType(major), major, minor)
            const getCurrent = groupFn(F_AXIS_GET_CURRENT, s.join("logical", major.*.id), getterReturnType(major), major, minor)
            const setCurrent = groupFn(F_AXIS_SET_CURRENT, s.join("setLogical", major.*.id), "void", major, minor)
            addTriple(lf, getSpecified, getCurrent, setCurrent)
            index += 1
        }
        return lf
    }
    const top = m.groupProperty(group, "physical", "top")
    const right = m.groupProperty(group, "physical", "right")
    const bottom = m.groupProperty(group, "physical", "bottom")
    const left = m.groupProperty(group, "physical", "left")
    sideTriple(lf, false, "Start", left, right, top, bottom)
    sideTriple(lf, false, "End", right, left, bottom, top)
    sideTriple(lf, true, "Before", left, right, top, bottom)
    sideTriple(lf, true, "After", right, left, bottom, top)
    const prefix = g.nameToId(group.*.name)
    const edges = [_][]const u8{ "LogicalLeft", "LogicalRight" }
    const horizontals = [_]*m.Property{ left, right }
    const verticals = [_]*m.Property{ top, bottom }
    var index: usize = 0
    while index < 2 {
        const getterName = s.join(g.lowerFirst(prefix), edges[index])
        const getSpecified = groupFn(F_LR_GET_SPECIFIED, getterName, getterReturnType(horizontals[index]), horizontals[index], verticals[index])
        const getCurrent = groupFn(F_LR_GET_CURRENT, getterName, getterReturnType(horizontals[index]), horizontals[index], verticals[index])
        const setCurrent = groupFn(F_LR_SET_CURRENT, t.c3("set", prefix, edges[index]), "void", horizontals[index], verticals[index])
        addTriple(lf, getSpecified, getCurrent, setCurrent)
        index += 1
    }
    return lf
}

// ---------------------------------------------------------------------------
// The generators' inputs.

var propertyList: g.Refs = undefined
var functionSets: g.Refs = undefined
var colorList: g.Refs = undefined
var colorSets: g.Refs = undefined
var logicalSets: g.Refs = undefined
var ready: bool = false

fn isStored(p: *m.Property) -> bool {
    return !(on(p, "skip-computed-style") || m.isLogical(p) || p.*.hasLonghands || on(p, "cascade-alias") || on(p, "coordinated-value-list-property"))
}

fn setUp() -> void {
    if ready { return }
    ready = true
    propertyList = g.refs()
    functionSets = g.refs()
    colorList = g.refs()
    colorSets = g.refs()
    logicalSets = g.refs()
    var index: usize = 0
    while index < m.styleAll.count {
        const p = m.propertyAt(m.styleAll, index)
        if isStored(p) {
            g.push(&propertyList, m.styleAll.items[index])
            g.push(&functionSets, @intFromPtr(propertyFunctions(p)))
            if on(p, "color-property") {
                g.push(&colorList, m.styleAll.items[index])
                const traits: *g.Refs = unsafe { @ptrFromInt(*g.Refs, s.alloc(@sizeOf(g.Refs))) }
                traits.* = colorTraits(p)
                g.push(&colorSets, @intFromPtr(traits))
            }
        }
        index += 1
    }
    index = 0
    while index < m.groups.count {
        const lf = logicalFunctions(m.groupAt(m.groups, index))
        if lf != null { g.push(&logicalSets, @intFromPtr(lf.?)) }
        index += 1
    }
}

fn functionsAt(index: usize) -> *PropertyFunctions { return unsafe { @ptrFromInt(*PropertyFunctions, functionSets.items[index]) } }

// ---------------------------------------------------------------------------
// The files.

pub fn header() -> []const u8 {
    setUp()
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.pragmaOnce(w)
    x.includesOf(w, "", "<WebCore/StyleComputedStyleBase.h>")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    c.write(w, "class ComputedStyleProperties : public ComputedStyleBase {")
    c.write(w, "public:")
    c.indent(w)
    var index: usize = 0
    while index < propertyList.count {
        c.write(w, t.c3("// '", m.propertyAt(propertyList, index).*.name, "'"))
        declarations(w, allOf(functionsAt(index)))
        c.newline(w)
        index += 1
    }
    index = 0
    while index < logicalSets.count {
        const lf = logicalAt(logicalSets, index)
        c.write(w, t.c5("// Logical getters and setters for '", lf.*.group.*.name, "' properties of type '", lf.*.group.*.kind, "'."))
        declarations(w, lf.*.all)
        c.newline(w)
        index += 1
    }
    c.outdent(w)
    c.write(w, "protected:")
    c.indent(w)
    c.write(w, "ComputedStyleProperties(ComputedStyleProperties&&) = default;")
    c.write(w, "ComputedStyleProperties& operator=(ComputedStyleProperties&&) = default;")
    c.newline(w)
    c.write(w, "inline ComputedStyleProperties(CreateDefaultStyleTag);")
    c.write(w, "inline ComputedStyleProperties(const ComputedStyleProperties&, CloneTag);")
    c.newline(w)
    c.write(w, "inline ComputedStyleProperties(ComputedStyleProperties&, ComputedStyleProperties&&);")
    c.outdent(w)
    c.write(w, "};")
    c.newline(w)
    index = 0
    while index < colorList.count {
        c.write(w, t.c3("template<> struct ColorPropertyTraits<PropertyNameConstant<", m.idWithoutScope(m.propertyAt(colorList, index)), ">> {"))
        c.indent(w)
        declarations(w, m.refsOf(colorSets.items[index]).*)
        c.outdent(w)
        c.write(w, "};")
        c.newline(w)
        index += 1
    }
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

pub fn implementation() -> []const u8 {
    setUp()
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.cppRequiredIncludes(w, "StyleComputedStyleProperties.h")
    x.includesOf(w, "StyleComputedStyle+GettersInlines.h", "")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    var index: usize = 0
    while index < propertyList.count {
        outOfLineDefinitions(w, allOf(functionsAt(index)))
        index += 1
    }
    index = 0
    while index < logicalSets.count {
        outOfLineDefinitions(w, logicalAt(logicalSets, index).*.all)
        index += 1
    }
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

pub fn constructionInlines() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.pragmaOnce(w)
    x.includesOf(w, "StyleComputedStyleBase+ConstructionInlines.h StyleComputedStyleProperties.h", "")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    c.write(w, "inline ComputedStyleProperties::ComputedStyleProperties(CreateDefaultStyleTag tag)")
    c.write(w, "    : ComputedStyleBase { tag }")
    c.write(w, "{")
    c.write(w, "}")
    c.newline(w)
    c.write(w, "inline ComputedStyleProperties::ComputedStyleProperties(const ComputedStyleProperties& other, CloneTag tag)")
    c.write(w, "    : ComputedStyleBase { other, tag }")
    c.write(w, "{")
    c.write(w, "}")
    c.newline(w)
    c.write(w, "inline ComputedStyleProperties::ComputedStyleProperties(ComputedStyleProperties& a, ComputedStyleProperties&& b)")
    c.write(w, "    : ComputedStyleBase { a, WTF::move(b) }")
    c.write(w, "{")
    c.write(w, "}")
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

fn trapHeading(w: *c.Writer, trap: []const u8, from: []const u8) -> void {
    x.heading(w)
    x.pragmaOnce(w)
    c.write(w, s.join("#ifndef ", trap))
    c.write(w, t.c3("#error \"Please do not include this file anywhere except from ", from, ".\""))
    c.write(w, "#endif")
    c.newline(w)
}

pub fn gettersInlines() -> []const u8 {
    setUp()
    var writer = c.writer()
    const w = &writer
    trapHeading(w, "COMPUTED_STYLE_PROPERTIES_GETTERS_INLINES_INCLUDE_TRAP", "StyleComputedStyle+GettersInlines.h")
    x.includesOf(w, "", "<WebCore/StyleComputedStyleProperties+GettersCustomInlines.h>")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    var index: usize = 0
    while index < propertyList.count {
        inlineDefinitions(w, gettersOf(functionsAt(index)))
        index += 1
    }
    index = 0
    while index < logicalSets.count {
        inlineDefinitions(w, logicalAt(logicalSets, index).*.getters)
        index += 1
    }
    index = 0
    while index < colorSets.count {
        inlineDefinitions(w, m.refsOf(colorSets.items[index]).*)
        index += 1
    }
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

pub fn settersInlines() -> []const u8 {
    setUp()
    var writer = c.writer()
    const w = &writer
    trapHeading(w, "COMPUTED_STYLE_PROPERTIES_SETTERS_INLINES_INCLUDE_TRAP", "StyleComputedStyle+SettersInlines.h")
    x.includesOf(w, "StyleComputedStyleProperties+SettersCustomInlines.h", "")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    var index: usize = 0
    while index < propertyList.count {
        inlineDefinitions(w, settersOf(functionsAt(index)))
        index += 1
    }
    index = 0
    while index < logicalSets.count {
        inlineDefinitions(w, logicalAt(logicalSets, index).*.setters)
        index += 1
    }
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

pub fn initialInlines() -> []const u8 {
    setUp()
    var writer = c.writer()
    const w = &writer
    trapHeading(w, "COMPUTED_STYLE_PROPERTIES_INITIAL_INLINES_INCLUDE_TRAP", "StyleComputedStyle+InitialInlines.h")
    x.includesOf(w, "", "<WebCore/StyleComputedStyleProperties+InitialCustomInlines.h>")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    var index: usize = 0
    while index < propertyList.count {
        var one = g.refs()
        g.push(&one, @intFromPtr(functionsAt(index).*.initial))
        inlineDefinitions(w, one)
        index += 1
    }
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}

// ---------------------------------------------------------------------------
// StyleChangedAnimatablePropertiesGenerated.cpp

fn childFunctionName(function: []const u8, child: *m.StorageNode) -> []const u8 { return g.lowerFirst(g.nameToId(t.c3(function, "_", child.*.name))) }

fn skippedComment(p: *m.Property) -> []const u8 {
    // The animation type as the f-string shows it, "None" when absent.
    const kind = m.animationType(p)
    return t.c4("// SKIPPED '", p.*.name, "' - ", if kind.length > 0 { kind } else { "None" })
}

fn changedOpaque(w: *c.Writer, n: *m.StorageNode, function: []const u8) -> void {
    c.write(w, t.c3("static void ", function, "(const auto&, const auto&, CSSPropertiesBitSet& changingProperties)"))
    c.write(w, "{")
    c.indent(w)
    var animatable = g.refs()
    var other = g.refs()
    var round: usize = 0
    while round < 2 {
        const properties = if round == 0 { n.*.properties } else { n.*.visitedLinkProperties }
        var index: usize = 0
        while index < properties.count {
            const p = m.propertyAt(properties, index)
            if m.isAnimatable(p) {
                if !g.has(animatable, properties.items[index]) { g.push(&animatable, properties.items[index]) }
            } else {
                if !g.has(other, properties.items[index]) { g.push(&other, properties.items[index]) }
            }
            index += 1
        }
        round += 1
    }
    const sortedAnimatable = m.sorted(animatable, m.compareId)
    var index: usize = 0
    while index < sortedAnimatable.count {
        c.write(w, t.c3("changingProperties.m_properties.set(", m.idWithoutScope(m.propertyAt(sortedAnimatable, index)), ");"))
        index += 1
    }
    if other.count > 0 {
        c.newline(w)
        c.write(w, "// Non-animatable properties:")
        const sortedOther = m.sorted(other, m.compareId)
        index = 0
        while index < sortedOther.count {
            c.write(w, skippedComment(m.propertyAt(sortedOther, index)))
            index += 1
        }
    }
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn storageAt0(address: usize) -> *m.StorageNode { return unsafe { @ptrFromInt(*m.StorageNode, address) } }

fn changedFunction(w: *c.Writer, n: *m.StorageNode, children: g.Refs, function: []const u8) -> void {
    if s.same(n.*.kind, "opaque") { return changedOpaque(w, n, function) }
    c.write(w, t.c3("static void ", function, "(const auto& a, const auto& b, CSSPropertiesBitSet& changingProperties)"))
    c.write(w, "{")
    c.indent(w)
    // The children by name, partitioned by kind.
    var sortedChildren = g.refs()
    var index: usize = 0
    while index < children.count {
        g.push(&sortedChildren, children.items[index])
        index += 1
    }
    index = 1
    while index < sortedChildren.count {
        const item = sortedChildren.items[index]
        var at = index
        while at > 0 && t.before(storageAt0(item).*.name, storageAt0(sortedChildren.items[at - 1]).*.name) {
            sortedChildren.items[at] = sortedChildren.items[at - 1]
            at -= 1
        }
        sortedChildren.items[at] = item
        index += 1
    }
    var dataChildren = g.refs()
    var opaqueChildren = g.refs()
    var structChildren = g.refs()
    index = 0
    while index < sortedChildren.count {
        const child = storageAt0(sortedChildren.items[index])
        if s.same(child.*.kind, "data") {
            g.push(&dataChildren, sortedChildren.items[index])
        } else if s.same(child.*.kind, "opaque") {
            g.push(&opaqueChildren, sortedChildren.items[index])
        } else {
            g.push(&structChildren, sortedChildren.items[index])
        }
        index += 1
    }
    var animatable = g.refs()
    var nonAnimatable = g.refs()
    const properties = m.sorted(n.*.properties, m.compareId)
    index = 0
    while index < properties.count {
        if m.isAnimatable(m.propertyAt(properties, index)) { g.push(&animatable, properties.items[index]) } else { g.push(&nonAnimatable, properties.items[index]) }
        index += 1
    }
    var animatableVisited = g.refs()
    var nonAnimatableVisited = g.refs()
    const visited = m.sorted(n.*.visitedLinkProperties, m.compareId)
    index = 0
    while index < visited.count {
        if m.isAnimatable(m.propertyAt(visited, index)) { g.push(&animatableVisited, visited.items[index]) } else { g.push(&nonAnimatableVisited, visited.items[index]) }
        index += 1
    }
    index = 0
    while index < dataChildren.count {
        const child = storageAt0(dataChildren.items[index])
        const name = child.*.name
        c.write(w, t.c5("if (a.", name, ".ptr() != b.", name, ".ptr())"))
        c.indent(w)
        c.write(w, t.c6(childFunctionName(function, child), "(*a.", name, ", *b.", name, ", changingProperties);"))
        c.outdent(w)
        index += 1
    }
    if dataChildren.count > 0 && opaqueChildren.count > 0 { c.newline(w) }
    index = 0
    while index < opaqueChildren.count {
        const child = storageAt0(opaqueChildren.items[index])
        const name = child.*.name
        c.write(w, t.c5("if (a.", name, " != b.", name, ")"))
        c.indent(w)
        c.write(w, t.c6(childFunctionName(function, child), "(a.", name, ", b.", name, ", changingProperties);"))
        c.outdent(w)
        index += 1
    }
    if (dataChildren.count > 0 || opaqueChildren.count > 0) && structChildren.count > 0 { c.newline(w) }
    index = 0
    while index < structChildren.count {
        const child = storageAt0(structChildren.items[index])
        const name = child.*.name
        c.write(w, t.c6(childFunctionName(function, child), "(a.", name, ", b.", name, ", changingProperties);"))
        index += 1
    }
    const anyChildren = dataChildren.count > 0 || opaqueChildren.count > 0 || structChildren.count > 0
    if anyChildren && animatable.count > 0 { c.newline(w) }
    changedProperties(w, n, animatable, false)
    if (anyChildren || animatable.count > 0) && animatableVisited.count > 0 { c.newline(w) }
    changedProperties(w, n, animatableVisited, true)
    if nonAnimatable.count > 0 {
        c.newline(w)
        c.write(w, "// Non-animatable properties:")
        index = 0
        while index < nonAnimatable.count {
            c.write(w, skippedComment(m.propertyAt(nonAnimatable, index)))
            index += 1
        }
    }
    if nonAnimatableVisited.count > 0 {
        c.newline(w)
        c.write(w, "// Non-animatable visited link properties:")
        index = 0
        while index < nonAnimatableVisited.count {
            c.write(w, skippedComment(m.propertyAt(nonAnimatableVisited, index)))
            index += 1
        }
    }
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
}

fn changedProperties(w: *c.Writer, n: *m.StorageNode, properties: g.Refs, visited: bool) -> void {
    var index: usize = 0
    while index < properties.count {
        const p = m.propertyAt(properties, index)
        index += 1
        if on(p, "computed-style-changed-for-animation-custom") {
            c.write(w, t.c3("ChangedAnimatablePropertiesCustom::conservativelyCollectChangedAnimatablePropertiesFor", if visited { s.join("VisitedLink", p.*.id) } else { p.*.id }, "(a, b, changingProperties);"))
            continue
        }
        var expression: []const u8 = ""
        if s.same(n.*.kind, "data") || s.same(n.*.kind, "struct") {
            expression = m.cgShown(p, if visited { "computed-style-visited-link-storage-name" } else { "computed-style-storage-name" })
        } else if s.same(n.*.kind, "physical-group") {
            expression = s.join(g.lowerFirst(g.nameToId(p.*.logicalGroup.?.*.resolver)), "()")
        }
        c.write(w, t.c5("if (a.", expression, " != b.", expression, ")"))
        c.indent(w)
        c.write(w, t.c3("changingProperties.m_properties.set(", m.idWithoutScope(p), ");"))
        c.outdent(w)
    }
}

fn changedRecursive(w: *c.Writer, n: *m.StorageNode, function: []const u8) -> bool {
    var generated = g.refs()
    var index: usize = 0
    while index < n.*.children.count {
        const child = m.storageAt(n.*.children, index)
        if changedRecursive(w, child, childFunctionName(function, child)) { g.push(&generated, n.*.children.items[index]) }
        index += 1
    }
    var any = generated.count > 0
    index = 0
    while index < n.*.properties.count {
        if m.isAnimatable(m.propertyAt(n.*.properties, index)) { any = true }
        index += 1
    }
    index = 0
    while index < n.*.visitedLinkProperties.count {
        if m.isAnimatable(m.propertyAt(n.*.visitedLinkProperties, index)) { any = true }
        index += 1
    }
    if !any { return false }
    changedFunction(w, n, generated, function)
    return true
}

pub fn changedAnimatableProperties() -> []const u8 {
    var writer = c.writer()
    const w = &writer
    x.heading(w)
    x.cppRequiredIncludes(w, "StyleChangedAnimatablePropertiesGenerated.h")
    x.includesOf(w, "StyleChangedAnimatablePropertiesCustom.h", "")
    const namespaces = x.words("WebCore Style")
    x.openNamespaces(w, namespaces)
    c.write(w, "class ChangedAnimatablePropertiesFunctions final {")
    c.write(w, "public:")
    c.indent(w)
    const generated = changedRecursive(w, m.storageModel(), "collect")
    c.outdent(w)
    c.write(w, "};")
    c.newline(w)
    c.write(w, "void ChangedAnimatablePropertiesGenerated::conservativelyCollectChangedAnimatableProperties(const ComputedStyle& a, const ComputedStyle& b, CSSPropertiesBitSet& changingProperties)")
    c.write(w, "{")
    c.indent(w)
    c.write(w, "ChangedAnimatablePropertiesFunctions::collect(a, b, changingProperties);")
    c.outdent(w)
    c.write(w, "}")
    c.newline(w)
    x.closeNamespaces(w, namespaces)
    return c.written(w)
}
