// What WebKit's Wasm generators (generateWasm.py and the scripts built
// on it) share: wasm/wasm.json read whole into a tree that keeps the
// members of each object in the order of the file (as Python's dicts
// do), the copyright header of their outputs, the C++ names of the
// opcodes, and the tests on an opcode's category.
const json = @import("std.json")
const s = @import("./support.mlx")

pub const OBJECT: u8 = 1
pub const ARRAY: u8 = 2
pub const STRING: u8 = 3
pub const NUMBER: u8 = 4
pub const LITERAL: u8 = 5

// A value of the document. Node 0 is none: a first or next of 0 ends a
// list of children.
const Node = struct {
    kind: u8
    // The member's name, "" in an array.
    key: []const u8
    // A string decoded, a number or literal as written.
    text: []const u8
    first: usize
    last: usize
    next: usize
    count: usize
}

const MAX_NODES: usize = 65536

var nodes: [*]Node = undefined
var nodeCount: usize = 0

fn addNode(kind: u8, key: []const u8, text: []const u8, parent: usize) -> usize {
    if nodeCount == MAX_NODES { s.fail("wasm.json: too many values") }
    const index = nodeCount
    nodes[index] = Node.{ .kind = kind, .key = key, .text = text, .first = 0, .last = 0, .next = 0, .count = 0 }
    nodeCount += 1
    if parent != 0 {
        if nodes[parent].first == 0 {
            nodes[parent].first = index
        } else {
            nodes[nodes[parent].last].next = index
        }
        nodes[parent].last = index
        nodes[parent].count += 1
    }
    return index
}

fn decoded(raw: json.String) -> []const u8 {
    const at = s.alloc(raw.length + 1)
    var view: [*]u8 = undefined
    unsafe { view = @ptrFromInt([*]u8, at) }
    const length = json.decodeString(raw, view, raw.length + 1)
    if length < 0 { s.fail("wasm.json: a bad string") }
    return s.bytes(at, @intCast(usize, length))
}

// The document at PATH; its top value is node 1.
pub fn load(path: []const u8) -> usize {
    unsafe { nodes = @ptrFromInt([*]Node, s.alloc(MAX_NODES * @sizeOf(Node))) }
    nodeCount = 1
    nodes[0] = Node.{ .kind = 0, .key = "", .text = "", .first = 0, .last = 0, .next = 0, .count = 0 }
    const text = s.readWhole(path)
    var tokenizer: json.Tokenizer = undefined
    json.initAt(&tokenizer, text.pointer, text.length)
    var token: json.Token = undefined
    var open: [64]usize = undefined
    var depth: usize = 0
    var key: []const u8 = ""
    while json.next(&tokenizer, &token) {
        const kind = token.kind
        const parent = if depth > 0 { open[depth - 1] } else { 0 }
        if kind == json.TokenKind.key {
            key = decoded(token.value)
        } else if kind == json.TokenKind.objectStart || kind == json.TokenKind.arrayStart {
            open[depth] = addNode(if kind == json.TokenKind.objectStart { OBJECT } else { ARRAY }, key, "", parent)
            depth += 1
            key = ""
        } else if kind == json.TokenKind.objectEnd || kind == json.TokenKind.arrayEnd {
            depth -= 1
        } else if kind == json.TokenKind.string {
            const ignored = addNode(STRING, key, decoded(token.value), parent)
            key = ""
        } else {
            const raw = token.value
            const ignored = addNode(if kind == json.TokenKind.number { NUMBER } else { LITERAL }, key, raw.pointer[0..raw.length], parent)
            key = ""
        }
    }
    if json.failed(&tokenizer) { s.fail(s.join("wasm.json: ", json.errorMessage(json.errorCode(&tokenizer)))) }
    return 1
}

pub fn kindOf(node: usize) -> u8 { return nodes[node].kind }
pub fn keyOf(node: usize) -> []const u8 { return nodes[node].key }
pub fn textOf(node: usize) -> []const u8 { return nodes[node].text }
pub fn first(node: usize) -> usize { return nodes[node].first }
pub fn next(node: usize) -> usize { return nodes[node].next }
pub fn count(node: usize) -> usize { return nodes[node].count }

// The member KEY of the object NODE (the last, should it be there
// twice, as Python keeps it), or 0.
pub fn member(node: usize, key: []const u8) -> usize {
    var found: usize = 0
    var child = nodes[node].first
    while child != 0 {
        if s.same(nodes[child].key, key) { found = child }
        child = nodes[child].next
    }
    return found
}

pub fn has(node: usize, key: []const u8) -> bool { return member(node, key) != 0 }

fn needed(node: usize, key: []const u8) -> usize {
    const found = member(node, key)
    if found == 0 { s.fail(s.join3("wasm.json: no \"", key, "\"")) }
    return found
}

// The text of the member KEY.
pub fn text(node: usize, key: []const u8) -> []const u8 { return nodes[needed(node, key)].text }

// The number NODE is (an integer).
pub fn integerOf(node: usize) -> i64 {
    const digits = nodes[node].text
    var at: usize = 0
    var negative = false
    if digits.length > 0 && digits[0] == 45 {
        negative = true
        at = 1
    }
    if at == digits.length { s.fail(s.join("wasm.json: not an integer: ", digits)) }
    var value: i64 = 0
    while at < digits.length {
        if !s.isDigit(digits[at]) { s.fail(s.join("wasm.json: not an integer: ", digits)) }
        value = value * 10 + @intCast(i64, digits[at] - 48)
        at += 1
    }
    return if negative { 0 - value } else { value }
}

pub fn integer(node: usize, key: []const u8) -> i64 { return integerOf(needed(node, key)) }

// The element INDEX of the array NODE.
pub fn element(node: usize, index: usize) -> usize {
    var child = nodes[node].first
    var at: usize = 0
    while at < index {
        if child == 0 { s.fail("wasm.json: an array too short") }
        child = nodes[child].next
        at += 1
    }
    if child == 0 { s.fail("wasm.json: an array too short") }
    return child
}

// ---------------------------------------------------------------------------
// What generateWasm.py does.

// The member's node of the top object (types, packed types, opcodes).
pub fn section(root: usize, key: []const u8) -> usize { return needed(root, key) }

// The version of the preamble, as Python's str() writes it.
pub fn expectedVersion(root: usize) -> []const u8 {
    var version: []const u8 = ""
    var entry = first(needed(root, "preamble"))
    while entry != 0 {
        if s.same(text(entry, "name"), "version") { version = textOf(needed(entry, "value")) }
        entry = next(entry)
    }
    return version
}

// The header of every output, naming SCRIPT, the generator.
pub fn header(script: []const u8) -> void {
    s.out("/*\n")
    s.out(" * Copyright (C) 2016-2017 Apple Inc. All rights reserved.\n")
    s.out(" *\n")
    s.out(" * Redistribution and use in source and binary forms, with or without\n")
    s.out(" * modification, are permitted provided that the following conditions\n")
    s.out(" * are met:\n")
    s.out(" *\n")
    s.out(" * 1.  Redistributions of source code must retain the above copyright\n")
    s.out(" *     notice, this list of conditions and the following disclaimer.\n")
    s.out(" * 2.  Redistributions in binary form must reproduce the above copyright\n")
    s.out(" *     notice, this list of conditions and the following disclaimer in the\n")
    s.out(" *     documentation and/or other materials provided with the distribution.\n")
    s.out(" *\n")
    s.out(" * THIS SOFTWARE IS PROVIDED BY APPLE AND ITS CONTRIBUTORS \"AS IS\" AND ANY\n")
    s.out(" * EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED\n")
    s.out(" * WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE\n")
    s.out(" * DISCLAIMED. IN NO EVENT SHALL APPLE OR ITS CONTRIBUTORS BE LIABLE FOR ANY\n")
    s.out(" * DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES\n")
    s.out(" * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;\n")
    s.out(" * LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND\n")
    s.out(" * ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n")
    s.out(" * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF\n")
    s.out(" * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n")
    s.out(" */\n")
    s.out("\n")
    s.out("// DO NO EDIT! - This file was generated by ")
    s.out(script)
}

fn isLowerOrDigit(byte: u8) -> bool { return (byte >= 97 && byte <= 122) || s.isDigit(byte) }

fn upper(byte: u8) -> u8 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }

// The C++ name of a Wasm name: each byte but a lower-case letter or a
// digit, with the byte after it, made that byte in capitals ("ref_null"
// RefNull, "i32.trunc_sat_f32_s" I32TruncSatF32S), the first letter a
// capital.
pub fn toCpp(name: []const u8) -> []const u8 {
    const at = s.alloc(name.length + 1)
    var length: usize = 0
    var index: usize = 0
    while index < name.length {
        if !isLowerOrDigit(name[index]) && index + 1 < name.length {
            s.put8(at + length, upper(name[index + 1]))
            index += 2
        } else {
            s.put8(at + length, name[index])
            index += 1
        }
        length += 1
    }
    if length > 0 {
        var view: [*]const u8 = undefined
        unsafe { view = @ptrFromInt([*]const u8, at) }
        s.put8(at, upper(view[0]))
    }
    s.put8(at + length, 0)
    return s.bytes(at, length)
}

// VALUE as Python's hex() writes it: "0xfc", "-0x1", "0x0".
pub fn pythonHex(value: i64) -> []const u8 {
    var magnitude: u64 = if value < 0 { @intCast(u64, 0 - value) } else { @intCast(u64, value) }
    var digits: [24]u8 = undefined
    var at: usize = 24
    while true {
        at -= 1
        const digit = @intCast(u8, magnitude % 16)
        digits[at] = if digit < 10 { 48 + digit } else { 87 + digit }
        magnitude /= 16
        if magnitude == 0 { break }
    }
    at -= 1
    digits[at] = 120
    at -= 1
    digits[at] = 48
    if value < 0 {
        at -= 1
        digits[at] = 45
    }
    return s.join(digits[at..24], "")
}

// ---------------------------------------------------------------------------
// The kinds of opcodes (OP an opcode's object).

pub fn category(op: usize) -> []const u8 { return text(op, "category") }

pub fn isNormal(op: usize) -> bool {
    if has(op, "extendedOp") { return false }
    const kind = category(op)
    return s.same(kind, "arithmetic") || s.same(kind, "comparison") || s.same(kind, "conversion")
}

pub fn parameterCount(op: usize) -> usize { return count(needed(op, "parameter")) }
pub fn returnCount(op: usize) -> usize { return count(needed(op, "return")) }

pub fn isUnary(op: usize) -> bool { return isNormal(op) && parameterCount(op) == 1 }
pub fn isBinary(op: usize) -> bool { return isNormal(op) && parameterCount(op) == 2 }
pub fn isCompare(op: usize) -> bool { return s.same(category(op), "comparison") }
pub fn isAtomic(op: usize) -> bool { return s.startsWith(category(op), "atomic") }
pub fn isAtomicLoad(op: usize) -> bool { return s.same(category(op), "atomic.load") }
pub fn isAtomicStore(op: usize) -> bool { return s.same(category(op), "atomic.store") }
pub fn isAtomicBinaryRMW(op: usize) -> bool { return s.same(category(op), "atomic.rmw.binary") }
pub fn isSimple(op: usize) -> bool { return has(op, "b3op") }
