// JavaScript made smaller as JavaScriptCore's jsmin.py makes it when run
// as a program (the build's `jsmin.py < INPUT > OUTPUT`, here with the
// files named): the minified text and a newline.
//
//     webkit-jsmin INPUT OUTPUT
const std = @import("std")
const s = @import("./support.mlx")
const c = @import("./csstext.mlx")
const m = @import("./cssminify.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        s.say("usage: webkit-jsmin INPUT OUTPUT\n")
        return 2
    }
    s.writeWhole(std.text.cString(arguments[2]), s.join(m.jsmin(c.readFile(std.text.cString(arguments[1]))), "\n"))
    return 0
}
