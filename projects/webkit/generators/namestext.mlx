// What the WebCore name generators (make_names.pl, make_event_factory.pl,
// make-event-names.py, create-http-header-name-table and
// create-html-entity-table in Mlx) share: an output buffer written to one
// file after another, a stable sort with a comparison, the .in files
// WebCore's InFilesParser.pm reads, and Perl's notion of a true string.
const std = @import("std")
const s = @import("./support.mlx")

const SYS_mkdir: usize = 83

// ---------------------------------------------------------------------------
// Output: the text of one file at a time.

const BUFFER_SIZE: usize = 268435456
var bufferBase: usize = 0
var bufferTop: usize = 0

pub fn o(text: []const u8) -> void {
    if bufferBase == 0 { bufferBase = s.alloc(BUFFER_SIZE) }
    if bufferTop + text.length > BUFFER_SIZE { s.fail("the output is too large") }
    const target: [*]u8 = unsafe { @ptrFromInt([*]u8, bufferBase + bufferTop) }
    var index: usize = 0
    while index < text.length {
        target[index] = text[index]
        index += 1
    }
    bufferTop += text.length
}

pub fn on(value: u64) -> void { o(s.decimal(value)) }

pub fn o3(a: []const u8, b: []const u8, c: []const u8) -> void {
    o(a)
    o(b)
    o(c)
}

pub fn o5(a: []const u8, b: []const u8, c: []const u8, d: []const u8, e: []const u8) -> void {
    o(a)
    o(b)
    o(c)
    o(d)
    o(e)
}

// The text so far, written to PATH; the next file begins empty.
pub fn save(path: []const u8) -> void {
    if bufferBase == 0 { bufferBase = s.alloc(BUFFER_SIZE) }
    s.writeWhole(path, s.bytes(bufferBase, bufferTop))
    bufferTop = 0
}

// ---------------------------------------------------------------------------
// Text.

// Whether FIRST sorts before SECOND, byte by byte (Perl's cmp, Python's <).
pub fn before(first: []const u8, second: []const u8) -> bool {
    return compare(first, second) < 0
}

pub fn compare(first: []const u8, second: []const u8) -> i32 {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return if first[index] < second[index] { -1 } else { 1 } }
        index += 1
    }
    if first.length == second.length { return 0 }
    return if first.length < second.length { -1 } else { 1 }
}

// Whether Perl takes TEXT for true: not empty and not "0".
pub fn truthy(text: []const u8) -> bool { return text.length > 0 && !std.text.same(text, "0") }

pub fn lower(text: []const u8) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        const byte = text[index]
        s.put8(at + index, if byte >= 65 && byte <= 90 { byte + 32 } else { byte })
        index += 1
    }
    s.put8(at + text.length, 0)
    return s.bytes(at, text.length)
}

// TEXT with its first letter small (Perl's lcfirst).
pub fn lowerFirst(text: []const u8) -> []const u8 {
    if text.length == 0 || text[0] < 65 || text[0] > 90 { return text }
    return s.join(lower(text[0..1]), text[1..text.length])
}

// TEXT without the bytes BYTE.
pub fn without(text: []const u8, byte: u8) -> []const u8 {
    const at = s.alloc(text.length + 1)
    var length: usize = 0
    for each in text {
        if each != byte {
            s.put8(at + length, each)
            length += 1
        }
    }
    s.put8(at + length, 0)
    return s.bytes(at, length)
}

// TEXT without the space at both ends (Perl's s/^\s+//, s/\s+$//).
pub fn trim(text: []const u8) -> []const u8 { return s.trimEnd(s.trimStart(text)) }

// ---------------------------------------------------------------------------
// Lists of strings, and indexes sorted by a comparison.

pub const List = struct {
    items: [*][]const u8
    count: usize
    capacity: usize
}

pub fn list() -> List {
    const items: [*][]const u8 = unsafe { @ptrFromInt([*][]const u8, s.alloc(16 * @sizeOf([]const u8))) }
    return List.{ .items = items, .count = 0, .capacity = 16 }
}

pub fn push(l: *List, text: []const u8) -> void {
    if l.*.count == l.*.capacity {
        const capacity = l.*.capacity * 2
        const items: [*][]const u8 = unsafe { @ptrFromInt([*][]const u8, s.alloc(capacity * @sizeOf([]const u8))) }
        var index: usize = 0
        while index < l.*.count {
            items[index] = l.*.items[index]
            index += 1
        }
        l.*.items = items
        l.*.capacity = capacity
    }
    l.*.items[l.*.count] = text
    l.*.count += 1
}

pub fn has(l: List, text: []const u8) -> bool {
    var index: usize = 0
    while index < l.count {
        if std.text.same(l.items[index], text) { return true }
        index += 1
    }
    return false
}

// TEXT pushed unless L has it already (the keys of a Perl hash).
pub fn add(l: *List, text: []const u8) -> void {
    if !has(l.*, text) { push(l, text) }
}

// L's items in byte order (Perl's sort, Python's sorted).
pub fn sortList(l: *List) -> void {
    var index: usize = 1
    while index < l.*.count {
        const item = l.*.items[index]
        var at = index
        while at > 0 && before(item, l.*.items[at - 1]) {
            l.*.items[at] = l.*.items[at - 1]
            at -= 1
        }
        l.*.items[at] = item
        index += 1
    }
}

pub fn indexes(count: usize) -> [*]usize {
    const items: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc((count + 1) * 8)) }
    var index: usize = 0
    while index < count {
        items[index] = index
        index += 1
    }
    return items
}

// ITEMS sorted by ORDER (negative: the first goes first), equal ones kept
// in the order they were (a merge sort, as Perl's).
pub fn sortBy(items: [*]usize, count: usize, order: fn(usize, usize) -> i32) -> void {
    if count < 2 { return }
    const scratch: [*]usize = unsafe { @ptrFromInt([*]usize, s.alloc(count * 8)) }
    var width: usize = 1
    while width < count {
        var start: usize = 0
        while start < count {
            const middle = if start + width < count { start + width } else { count }
            const end = if start + 2 * width < count { start + 2 * width } else { count }
            var left = start
            var right = middle
            var at = start
            while at < end {
                if left < middle && (right >= end || order(items[right], items[left]) >= 0) {
                    scratch[at] = items[left]
                    left += 1
                } else {
                    scratch[at] = items[right]
                    right += 1
                }
                at += 1
            }
            start = end
        }
        var index: usize = 0
        while index < count {
            items[index] = scratch[index]
            index += 1
        }
        width *= 2
    }
}

// ---------------------------------------------------------------------------
// Files and directories.

// The directory PATH and those above it, made where missing (Perl's mkpath).
pub fn makeDirectories(path: []const u8) -> void {
    var end: usize = 1
    while end <= path.length {
        if end == path.length || path[end] == 47 {
            const name = s.join(path[0..end], "")
            const made = std.linux.syscall2(SYS_mkdir, @intFromPtr(name.pointer), 493)
        }
        end += 1
    }
}

pub fn path(directory: []const u8, name: []const u8) -> []const u8 { return s.join3(directory, "/", name) }

// ---------------------------------------------------------------------------
// WebCore's .in files, as InFilesParser.pm reads them: common parameters
// (NAME or NAME=VALUE) up to the first empty line, then one item a line
// with its options (NAME OPTION[=VALUE], ...). A value without one is "1";
// one in double quotes loses them.

pub const InHandler = struct {
    parameter: fn([]const u8, []const u8) -> void
    item: fn([]const u8, []const u8, []const u8) -> void
}

// Perl's trimQuoteAndWS: the first "..." with something inside made its
// inside, then the space at both ends gone.
fn unquoted(text: []const u8) -> []const u8 {
    var open: usize = 0
    while open < text.length {
        if text[open] == 34 {
            var close = open + 1
            while close < text.length && text[close] != 34 { close += 1 }
            if close == text.length { break }
            if close > open + 1 {
                return trim(s.join3(text[0..open], text[open + 1..close], text[close + 1..text.length]))
            }
        }
        open += 1
    }
    return trim(text)
}

// Perl's split SEPARATOR, TEXT taken to its first two fields (the later
// ones dropped, as are empty fields at the end): whether there was a
// second, non-empty, field.
fn splitTwo(text: []const u8, separator: u8, first: *[]const u8, second: *[]const u8) -> bool {
    var at: usize = 0
    while at < text.length && text[at] != separator { at += 1 }
    first.* = text[0..at]
    if at == text.length { return false }
    var end = at + 1
    while end < text.length && text[end] != separator { end += 1 }
    second.* = text[at + 1..end]
    if second.*.length > 0 { return true }
    // An empty second field counts when a later field is not empty.
    var rest = end
    while rest < text.length {
        if text[rest] != separator { return true }
        rest += 1
    }
    return false
}

pub fn parseIn(text: []const u8, handler: InHandler) -> void {
    var common = true
    var started = false
    var at: usize = 0
    while at < text.length {
        var line = trim(s.nextLine(text, &at))
        if line.length == 0 {
            if started { common = false }
            continue
        }
        started = true
        if line[0] == 35 { continue }
        // A comment: "#" and at least one byte after it.
        const hash = std.text.find(line, "#")
        if hash + 1 < line.length { line = line[0..hash] }
        if common {
            var name: []const u8 = ""
            var value: []const u8 = ""
            if splitTwo(line, 61, &name, &value) {
                handler.parameter(trim(name), unquoted(value))
            } else {
                handler.parameter(trim(name), "1")
            }
        } else {
            var end: usize = 0
            while end < line.length && !std.ascii.isCWhitespace(line[end]) { end += 1 }
            const itemName = line[0..end]
            const options = s.trimStart(line[end..line.length])
            if truthy(options) {
                var start: usize = 0
                var index: usize = 0
                while index <= options.length {
                    if index == options.length || options[index] == 44 {
                        const option = options[start..index]
                        var optionName: []const u8 = ""
                        var value: []const u8 = ""
                        if splitTwo(option, 61, &optionName, &value) {
                            handler.item(itemName, trim(optionName), unquoted(value))
                        } else {
                            handler.item(itemName, trim(optionName), "1")
                        }
                        start = index + 1
                    }
                    index += 1
                }
            } else {
                handler.item(itemName, "", "")
            }
        }
    }
}
