// CodeGeneratorJS.pm's smaller helpers: what an interface's members need
// (special operations, which object a property lives on, its attributes,
// runtime checks), names of generated functions, the exception functors,
// and the class names of nested enumerations and dictionaries.
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const js = @import("./bindingsjs.mlx")
const t = @import("./bindingsjstypes.mlx")
const d = @import("./bindingsjsdict.mlx")
const im = @import("./bindingsjsimpl.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

fn p(out: *StrList, text: Str) -> void { r.spush(out, text) }
fn cat(parts: []const Str) -> Str { return r.cat(parts) }
fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }

pub fn shouldGenerateWrapperOwnerCode(hasParent: bool, interface: *Node) -> bool {
    if !js.needsImplementationClass(interface) { return false }
    if !hasParent { return true }
    if r.truthy(js.getGenerateIsReachable(interface)) { return true }
    if r.truthy(js.getCustomIsReachable(interface)) { return true }
    if on(interface, "JSCustomFinalize") { return true }
    if cg.inheritsExtendedAttribute(interface, "ActiveDOMObject") { return true }
    return false
}

pub fn shouldGenerateToJSDeclaration(hasParent: bool, interface: *Node) -> bool {
    if on(interface, "SuppressToJSObject") { return false }
    if !js.needsImplementationClass(interface) { return false }
    if js.isDOMGlobalObject(interface) { return false }
    return true
}

pub fn shouldGenerateToJSImplementation(hasParent: bool, interface: *Node) -> bool {
    if !shouldGenerateToJSDeclaration(hasParent, interface) { return false }
    if !on(interface, "CustomToJSObject") { return true }
    return false
}

pub fn shouldGenerateConvertDictionary(dictionary: *Node) -> bool {
    if on(dictionary, "JSGenerateToNativeObject") { return true }
    if !on(dictionary, "JSGenerateToJSObject") { return true }
    return false
}

pub fn shouldGenerateConvertDictionaryToJS(dictionary: *Node) -> bool { return on(dictionary, "JSGenerateToJSObject") }

pub fn getTypeNameForDisplayInException(ty: *IDLType) -> Str {
    if ty.*.isUnion {
        const members = t.getFlattenedMemberTypes(ty)
        var names = r.strList()
        var index: usize = 0
        while index < members.count {
            r.spush(&names, r.at(*IDLType, members, index).*.name)
            index += 1
        }
        return r.c3("(", r.sjoin(names, " or "), ")")
    }
    return ty.*.name
}

pub fn getArgumentExceptionFunction(interface: *Node, argument: *Node, argumentIndex: Str, quotedFunctionName: Str) -> Str {
    const name = argument.*.name
    const visibleInterfaceName = cg.getVisibleInterfaceName(interface)
    const ty = argument.*.ty.?
    const typeNameText = getTypeNameForDisplayInException(ty)
    if cg.isCallbackInterface(ty) || r.same(ty.*.name, "EventListener") {
        return cat([_]Str{ "throwArgumentMustBeObjectError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ");" }[0..])
    }
    if cg.isCallbackFunction(ty) {
        return cat([_]Str{ "throwArgumentMustBeFunctionError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ");" }[0..])
    }
    if cg.isWrapperType(ty) || cg.isBufferSourceType(ty) {
        return cat([_]Str{ "throwArgumentTypeError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ", \"", typeNameText, "\"_s);" }[0..])
    }
    if cg.isEnumType(ty) {
        const className = d.getEnumerationClassNameOf(ty, interface)
        return cat([_]Str{ "throwArgumentMustBeEnumError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ", expectedEnumerationValues<", className, ">());" }[0..])
    }
    return r.undef()
}

pub fn getArgumentExceptionThrowerFunctor(interface: *Node, argument: *Node, argumentIndex: Str, quotedFunctionName: Str) -> Str {
    const functionCall = getArgumentExceptionFunction(interface, argument, argumentIndex, quotedFunctionName)
    if r.truthy(functionCall) { return cat([_]Str{ "[](JSC::JSGlobalObject& lexicalGlobalObject, JSC::ThrowScope& scope) { ", functionCall, " }" }[0..]) }
    return r.undef()
}

pub fn getAttributeExceptionFunction(interface: *Node, attribute: *Node) -> Str {
    const name = attribute.*.name
    const visibleInterfaceName = cg.getVisibleInterfaceName(interface)
    const ty = attribute.*.ty.?
    const typeNameText = getTypeNameForDisplayInException(ty)
    if cg.isWrapperType(ty) || cg.isBufferSourceType(ty) {
        return cat([_]Str{ "throwAttributeTypeError(lexicalGlobalObject, scope, \"", visibleInterfaceName, "\"_s, \"", name, "\"_s, \"", typeNameText, "\"_s);" }[0..])
    }
    return r.undef()
}

pub fn getAttributeExceptionThrower(interface: *Node, attribute: *Node) -> Str {
    const functionCall = getAttributeExceptionFunction(interface, attribute)
    if r.truthy(functionCall) { return cat([_]Str{ "[](JSC::JSGlobalObject& lexicalGlobalObject, JSC::ThrowScope& scope) { ", functionCall, " }" }[0..]) }
    return r.undef()
}

pub fn getArgumentDefaultValueFunctor(interface: *Node, argument: *Node) -> Str {
    if r.isDef(argument.*.defaultValue) && !im.willConvertUndefinedToDefaultParameterValue(argument.*.ty.?, argument.*.defaultValue) {
        const idlType = t.getIDLType(interface, argument.*.ty.?)
        const defaultValue = d.generateDefaultValue(interface, argument, argument.*.ty.?, argument.*.defaultValue)
        return cat([_]Str{ "[&] -> ConversionResult<", idlType, "> { return ", defaultValue, "; }" }[0..])
    }
    return r.undef()
}

pub fn getDictionaryMemberDefaultValueFunctor(interface: *Node, member: *Node) -> Str {
    if !member.*.isRequired && r.isDef(member.*.defaultValue) && !im.willConvertUndefinedToDefaultParameterValue(member.*.ty.?, member.*.defaultValue) {
        const idlType = t.getIDLType(interface, member.*.ty.?)
        const defaultValue = d.generateDefaultValue(interface, member, member.*.ty.?, member.*.defaultValue)
        return cat([_]Str{ "[&] -> ConversionResult<", idlType, "> { return ", defaultValue, "; }" }[0..])
    }
    return r.undef()
}

pub fn mangleAttributeOrFunctionName(name: Str) -> Str {
    const mangled = r.replaceAll(name, "-", "_dash_")
    if mangled.length > 0 && mangled[0] == 95 { return mangled }
    return r.c2("_", mangled)
}

pub fn getAttributeGetterName(interface: *Node, className: Str, attribute: *Node) -> Str {
    if on(attribute, "DelegateToSharedSyntheticAttribute") { return getAttributeGetterName(interface, className, getSharedSyntheticAttribute(interface, attribute)) }
    if isJSBuiltin(interface, attribute) { return getJSBuiltinFunctionName(className, attribute) }
    if attribute.*.isStatic { return cat([_]Str{ cg.wkLcfirst(className), "Constructor", mangleAttributeOrFunctionName(attribute.*.name) }[0..]) }
    if cg.isConstructorType(attribute.*.ty.?) { return cat([_]Str{ cg.wkLcfirst(className), mangleAttributeOrFunctionName(attribute.*.name), "Constructor" }[0..]) }
    return r.c2(cg.wkLcfirst(className), mangleAttributeOrFunctionName(attribute.*.name))
}

pub fn getAttributeSetterName(interface: *Node, className: Str, attribute: *Node) -> Str {
    if on(attribute, "DelegateToSharedSyntheticAttribute") { return getAttributeSetterName(interface, className, getSharedSyntheticAttribute(interface, attribute)) }
    if isJSBuiltin(interface, attribute) { return r.c2("set", cg.wkUcfirst(getJSBuiltinFunctionName(className, attribute))) }
    if attribute.*.isStatic { return cat([_]Str{ "set", cg.wkUcfirst(className), "Constructor", mangleAttributeOrFunctionName(attribute.*.name) }[0..]) }
    return cat([_]Str{ "set", cg.wkUcfirst(className), mangleAttributeOrFunctionName(attribute.*.name) }[0..])
}

pub fn getFunctionName(interface: *Node, className: Str, operation: *Node) -> Str {
    if isJSBuiltin(interface, operation) { return getJSBuiltinFunctionName(className, operation) }
    var functionName = operation.*.name
    if r.same(functionName, "[Symbol.Iterator]") { functionName = "SymbolIterator" }
    if r.same(functionName, "[Symbol.asyncIterator]") { functionName = "AsyncSymbolIterator" }
    const kind = if operation.*.isStatic { "Constructor" } else if operationShouldBeOnInstance(interface, operation) { "Instance" } else { "Prototype" }
    return cat([_]Str{ cg.wkLcfirst(className), kind, "Function", mangleAttributeOrFunctionName(functionName) }[0..])
}

pub fn getFullyQualifiedImplementationCallName(interface: *Node, property: *Node, implementationName: Str, implExpression: Str, conditional: Str) -> Str {
    const implementedBy = ext(property, "ImplementedBy")
    if r.truthy(implementedBy) && !on(property, "Reflect") {
        js.addToImplIncludes(r.c2(implementedBy, ".h"), conditional)
        return cat([_]Str{ "WebCore::", implementedBy, "::", implementationName }[0..])
    }
    if property.*.isStatic || property.*.isConstructor { return cat([_]Str{ typeName(interface), "::", implementationName }[0..]) }
    if on(property, "ForwardToMapLike") { return cat([_]Str{ "forward", cg.wkUcfirst(property.*.name), "ToMapLike" }[0..]) }
    if on(property, "ForwardToSetLike") { return cat([_]Str{ "forward", cg.wkUcfirst(property.*.name), "ToSetLike" }[0..]) }
    return cat([_]Str{ implExpression, ".", implementationName }[0..])
}

pub fn addAdditionalArgumentsForImplementationCall(arguments: *StrList, interface: *Node, property: *Node, implExpression: Str, globalObject: Str, callFrame: Str, thisObjectExpression: Str) -> void {
    if on(property, "ImplementedBy") && !property.*.isStatic && !on(property, "Reflect") { r.sunshift(arguments, implExpression) }
    if on(property, "ForwardToMapLike") || on(property, "ForwardToSetLike") {
        r.spush(arguments, globalObject)
        if property.*.kind == m.K_OPERATION { r.spush(arguments, callFrame) }
        r.spush(arguments, thisObjectExpression)
    }
}

fn getSpecialAccessorOperationForType(interface: *Node, special: Str, firstParameterType: Str, numberOfParameters: usize) -> ?*Node {
    const lists = [2]r.List{ interface.*.operations, interface.*.anonymousOperations }
    for l in lists {
        var index: usize = 0
        while index < l.count {
            const operation = m.node(l, index)
            index += 1
            if r.shas(operation.*.specials, special) && operation.*.arguments.count == numberOfParameters && r.same(typeName(m.node(operation.*.arguments, 0)), firstParameterType) { return operation }
        }
    }
    return null
}

pub fn isGlobalInterface(interface: *Node) -> bool { return on(interface, "Global") }

pub fn attributeShouldBeOnInstance(interface: *Node, attribute: *Node) -> bool {
    if isGlobalInterface(interface) { return true }
    if cg.isConstructorType(attribute.*.ty.?) { return true }
    if isLegacyUnforgeable(interface, attribute) { return true }
    if on(interface, "CheckSecurity") {
        if on(attribute, "DoNotCheckSecurity") { return false }
        if on(attribute, "DoNotCheckSecurityOnGetter") { return false }
        return true
    }
    return false
}

// IsAlwaysExposedOnInterface, on the [Exposed] values (a string, or the
// list of =(A, B)).
fn isAlwaysExposedOnInterface(interfaceExposures: ?*m.Value, contextExposures: *m.Value) -> bool {
    var contextSet = r.strList()
    if contextExposures.*.kind == m.V_IDS { r.sappend(&contextSet, contextExposures.*.ids) } else { r.spush(&contextSet, m.textOf(contextExposures)) }
    var interfaceList = r.strList()
    if interfaceExposures != null && interfaceExposures.?.*.kind == m.V_IDS {
        r.sappend(&interfaceList, interfaceExposures.?.*.ids)
    } else {
        const text = if interfaceExposures == null { "" } else { m.textOf(interfaceExposures.?) }
        if r.same(text, "*") { return r.same(m.textOf(contextExposures), "*") }
        r.spush(&interfaceList, text)
    }
    var index: usize = 0
    while index < interfaceList.count {
        if !r.shas(contextSet, interfaceList.items[index]) { return false }
        index += 1
    }
    return true
}

const privateHeaders = [_]Str{ "JSAbstractRange.h", "JSBlob.h", "JSCompositeOperation.h", "JSCompositeOperationOrAuto.h", "JSComputedEffectTiming.h", "JSCSSRule.h", "JSCSSRuleList.h", "JSCSSStyleDeclaration.h", "JSDeprecatedCSSOMCounter.h", "JSDeprecatedCSSOMRect.h", "JSDeprecatedCSSOMRGBColor.h", "JSDeprecatedCSSOMValue.h", "JSDeprecatedCSSOMValueList.h", "JSDocument.h", "JSDOMImplementation.h", "JSDOMWindow.h", "JSEffectTiming.h", "JSElement.h", "JSEvent.h", "JSEventTarget.h", "JSFile.h", "JSHTMLCollection.h", "JSHTMLElement.h", "JSHTMLOptionsCollection.h", "JSImageData.h", "JSIterationCompositeOperation.h", "JSKeyframeEffectOptions.h", "JSMediaList.h", "JSNamedNodeMap.h", "JSNode.h", "JSNodeIterator.h", "JSNodeList.h", "JSNotification.h", "JSOffscreenCanvas.h", "JSOptionalEffectTiming.h", "JSRange.h", "JSStyleSheet.h", "JSStyleSheetList.h", "JSTreeWalker.h", "JSWebKitJSHandle.h", "JSWebKitNodeSnapshot.h", "JSXPathExpression.h", "JSXPathResult.h" }

pub fn isPrivateHeader(headerFileName: Str) -> bool {
    var sanitized = headerFileName
    if sanitized.length > 0 && (sanitized[0] == 34 || sanitized[0] == 60) { sanitized = sanitized[1..sanitized.length] }
    if sanitized.length > 0 && (sanitized[sanitized.length - 1] == 34 || sanitized[sanitized.length - 1] == 62) { sanitized = sanitized[0..sanitized.length - 1] }
    for name in privateHeaders {
        if r.same(name, sanitized) { return true }
    }
    return false
}

pub fn needsRuntimeCheck(interface: *Node, context: *Node) -> bool {
    if on(context, "Exposed") {
        if !isAlwaysExposedOnInterface(m.value(interface.*.ext, "Exposed"), m.value(context.*.ext, "Exposed").?) { return true }
    }
    const names = [_]Str{ "EnabledByDeprecatedGlobalSetting", "EnabledForContext", "EnabledForGlobalObject", "EnabledForWorld", "EnabledBySetting", "EnabledByQuirk", "DisabledByQuirk", "SecureContext" }
    for name in names {
        if on(context, name) { return true }
    }
    return false
}

pub fn needsRuntimeReadWriteCheck(interface: *Node, context: *Node) -> bool { return on(context, "EnabledConditionallyReadWriteBySetting") }

pub fn operationShouldBeOnInstance(interface: *Node, operation: *Node) -> bool {
    if isGlobalInterface(interface) { return true }
    if isLegacyUnforgeable(interface, operation) {
        if needsRuntimeCheck(interface, operation) { r.die(cat([_]Str{ "The bindings generator does not support putting runtime-enabled operations on the instance yet (except for global objects):[", typeName(interface), "::", operation.*.name, "]" }[0..])) }
        return true
    }
    return false
}

pub fn getOperationReturnedArgumentName(operation: *Node) -> Str {
    var index: usize = 0
    while index < operation.*.arguments.count {
        if on(m.node(operation.*.arguments, index), "ReturnValue") { return r.c2("argument", r.decimal(@intCast(u64, index))) }
        index += 1
    }
    return r.undef()
}

pub fn isAcceleratedDOMAttribute(interface: *Node, attribute: *Node) -> bool {
    if needsRuntimeCheck(interface, attribute) && attributeShouldBeOnInstance(interface, attribute) { return false }
    if on(attribute, "PrivateIdentifier") && attributeShouldBeOnInstance(interface, attribute) { return false }
    if js.isDOMGlobalObject(interface) { return false }
    if attribute.*.isStatic { return false }
    if on(attribute, "ForwardToMapLike") { return false }
    if on(attribute, "ForwardToSetLike") { return false }
    if cg.isConstructorType(attribute.*.ty.?) { return false }
    if isJSBuiltin(interface, attribute) { return false }
    if on(attribute, "LegacyLenientThis") { return false }
    if cg.isPromiseType(attribute.*.ty.?) { return false }
    if on(attribute, "DOMJIT") { return false }
    return true
}

pub fn stringifyJSCAttributes(specials: StrList) -> Str {
    if specials.count == 0 { return "0" }
    if specials.count == 1 { return r.c3("static_cast<unsigned>(", specials.items[0], ")") }
    return r.sjoin(specials, " | ")
}

pub fn getJSCAttributesForAttribute(interface: *Node, attribute: *Node) -> StrList {
    var specials = r.strList()
    if isLegacyUnforgeable(interface, attribute) { r.spush(&specials, "JSC::PropertyAttribute::DontDelete") }
    const isGlobalConstructor = cg.isConstructorType(attribute.*.ty.?)
    if on(attribute, "NotEnumerable") || isGlobalConstructor { r.spush(&specials, "JSC::PropertyAttribute::DontEnum") }
    if js.isReadonly(attribute) { r.spush(&specials, "JSC::PropertyAttribute::ReadOnly") }
    if !(isGlobalConstructor || isJSBuiltin(interface, attribute)) { r.spush(&specials, "JSC::PropertyAttribute::CustomAccessor") }
    if isAcceleratedDOMAttribute(interface, attribute) { r.spush(&specials, "JSC::PropertyAttribute::DOMAttribute") }
    if on(attribute, "DOMJIT") { r.spush(&specials, "JSC::PropertyAttribute::DOMJITAttribute") }
    if isJSBuiltin(interface, attribute) {
        r.spush(&specials, "JSC::PropertyAttribute::Accessor")
        r.spush(&specials, "JSC::PropertyAttribute::Builtin")
    }
    return specials
}

pub fn getIndexedGetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "getter", "unsigned long", 1) }
pub fn getIndexedSetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "setter", "unsigned long", 2) }
pub fn getNamedGetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "getter", "DOMString", 1) }
pub fn getNamedSetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "setter", "DOMString", 2) }
pub fn getNamedDeleterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "deleter", "DOMString", 1) }

pub fn instanceOperationCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.operations.count {
        if operationShouldBeOnInstance(interface, m.node(interface.*.operations, index)) { count += 1 }
        index += 1
    }
    return count
}

pub fn prototypeOperationCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        if !operation.*.isStatic && !operationShouldBeOnInstance(interface, operation) { count += 1 }
        index += 1
    }
    return count
}

pub fn instancePropertyCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.attributes.count {
        if attributeShouldBeOnInstance(interface, m.node(interface.*.attributes, index)) { count += 1 }
        index += 1
    }
    return count + instanceOperationCount(interface)
}

pub fn prototypePropertyCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.attributes.count {
        if !attributeShouldBeOnInstance(interface, m.node(interface.*.attributes, index)) { count += 1 }
        index += 1
    }
    count += prototypeOperationCount(interface)
    if needsConstructorProperty(interface) { count += 1 }
    return count
}

pub fn instanceOverridesGetOwnPropertySlot(interface: *Node) -> bool {
    return on(interface, "CustomGetOwnPropertySlot") || on(interface, "Plugin") || getIndexedGetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesGetOwnPropertyNames(interface: *Node) -> bool {
    return on(interface, "CustomGetOwnPropertyNames") || getIndexedGetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesPut(interface: *Node) -> bool {
    return on(interface, "CustomPut") || on(interface, "Plugin") || getIndexedSetterOperation(interface) != null || getIndexedGetterOperation(interface) != null || getNamedSetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesIndexedDefineOwnProperty(interface: *Node) -> bool {
    return on(interface, "CustomDefineOwnProperty") || getIndexedSetterOperation(interface) != null || getIndexedGetterOperation(interface) != null
}

pub fn instanceOverridesNamedDefineOwnProperty(interface: *Node) -> bool {
    return on(interface, "CustomDefineOwnProperty") || getNamedSetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesDefineOwnProperty(interface: *Node) -> bool { return instanceOverridesIndexedDefineOwnProperty(interface) || instanceOverridesNamedDefineOwnProperty(interface) }

pub fn instanceOverridesDeleteProperty(interface: *Node) -> bool {
    return on(interface, "CustomDeleteProperty") || getNamedDeleterOperation(interface) != null || getNamedGetterOperation(interface) != null || getIndexedGetterOperation(interface) != null
}

pub fn prototypeHasStaticPropertyTable(interface: *Node) -> bool { return interface.*.constants.count > 0 || prototypePropertyCount(interface) > 0 }

pub fn instanceNeedsVisitChildren(interface: *Node) -> bool {
    var index: usize = 0
    while index < interface.*.attributes.count {
        if on(m.node(interface.*.attributes, index), "CachedAttribute") { return true }
        index += 1
    }
    if on(interface, "JSCustomMarkFunction") { return true }
    if on(interface, "GenerateAddOpaqueRoot") { return true }
    if on(interface, "Plugin") { return true }
    if on(interface, "ReportExtraMemoryCost") { return true }
    return false
}

pub fn instanceNeedsEstimatedSize(interface: *Node) -> bool { return on(interface, "ReportExtraMemoryCost") }

pub fn getImplClassName(interface: *Node) -> Str { return typeName(interface) }
pub fn getImplClassPtrTag(interface: *Node) -> Str { return r.c2(typeName(interface), "PtrTag") }

// IsClassNameWordBoundary with I counted from the end when FROMEND.
fn isClassNameWordBoundary(name: Str, index: usize, fromEnd: bool) -> bool {
    var i = index
    if fromEnd {
        if index > name.length { return false }
        i = name.length - index
    }
    if i == 0 { return true }
    if i == name.length { return true }
    if i > name.length { return false }
    const check = name[i - 1..name.length]
    if check.length >= 2 && !r.isUpper(check[0]) && r.isUpper(check[1]) { return true }
    if check.length >= 3 && r.isUpper(check[0]) && r.isUpper(check[1]) && !r.isUpper(check[2]) { return true }
    return false
}

fn prefix(text: Str, length: usize) -> Str { return if length > text.length { text } else { text[0..length] } }

fn isPrefixRemovable(class: Str, name: Str, i: usize) -> bool {
    if !isClassNameWordBoundary(name, i, false) { return false }
    if isClassNameWordBoundary(class, i, false) && r.same(prefix(class, i), prefix(name, i)) { return true }
    if isClassNameWordBoundary(class, i, true) && r.same(class[class.length - i..class.length], prefix(name, i)) { return true }
    return false
}

pub fn getNestedClassName(interface: *Node, name: Str) -> Str {
    const class = getImplClassName(interface)
    var member = cg.wkUcfirst(name)
    var longest: usize = 0
    if member.length >= 2 && r.isUpper(member[0]) && member[1] != 10 {
        var i: usize = 2
        while i + 1 < member.length {
            if isPrefixRemovable(class, member, i) { longest = i }
            i += 1
        }
    }
    member = r.substrFrom(member, longest)
    return cat([_]Str{ class, "::", member }[0..])
}

pub fn isLegacyUnforgeable(interface: *Node, property: *Node) -> bool {
    return on(property, "LegacyUnforgeable") || on(interface, "LegacyUnforgeable")
}

pub fn hasCustomConstructor(interface: *Node) -> bool {
    var custom = false
    var nonCustom = false
    var index: usize = 0
    while index < interface.*.constructors.count {
        if on(m.node(interface.*.constructors, index), "Custom") { custom = true } else { nonCustom = true }
        index += 1
    }
    if custom && nonCustom { r.die("Using both Custom and non-Custom constructors on the same interface is not supported at this time") }
    return custom
}

pub fn hasCustomGetter(attribute: *Node) -> bool { return on(attribute, "Custom") || on(attribute, "CustomGetter") }
pub fn hasCustomSetter(attribute: *Node) -> bool { return on(attribute, "Custom") || on(attribute, "CustomSetter") }
pub fn hasCustomMethod(operation: *Node) -> bool { return on(operation, "Custom") }

pub fn needsConstructorProperty(interface: *Node) -> bool {
    if interface.*.isNamespaceObject { return false }
    return !on(interface, "LegacyNoInterfaceObject")
}

pub fn isConstructable(interface: *Node) -> bool { return interface.*.constructors.count > 0 }
pub fn instanceOverridesGetCallData(interface: *Node) -> bool { return on(interface, "CustomGetCallData") || on(interface, "Plugin") }
pub fn headerNeedsPrototypeDeclaration(interface: *Node) -> bool { return js.isDOMGlobalObject(interface) }

pub fn computeFunctionSpecial(interface: *Node, operation: *Node) -> StrList {
    var specials = r.strList()
    if isLegacyUnforgeable(interface, operation) {
        r.spush(&specials, "JSC::PropertyAttribute::DontDelete")
        r.spush(&specials, "JSC::PropertyAttribute::ReadOnly")
    }
    if on(operation, "NotEnumerable") { r.spush(&specials, "JSC::PropertyAttribute::DontEnum") }
    if isJSBuiltin(interface, operation) { r.spush(&specials, "JSC::PropertyAttribute::Builtin") } else { r.spush(&specials, "JSC::PropertyAttribute::Function") }
    if on(operation, "DOMJIT") { r.spush(&specials, "JSC::PropertyAttribute::DOMJITFunction") }
    return specials
}

pub fn isJSBuiltin(interface: *Node, object: *Node) -> bool {
    if on(object, "Custom") || on(object, "CustomGetter") || on(object, "CustomSetter") { return false }
    if on(object, "JSBuiltin") { return true }
    if on(interface, "JSBuiltin") { return true }
    return false
}

pub fn hasJSBuiltinConstructor(interface: *Node) -> bool {
    if on(interface, "JSBuiltin") { return true }
    var builtin = false
    var nonBuiltin = false
    var index: usize = 0
    while index < interface.*.constructors.count {
        if on(m.node(interface.*.constructors, index), "JSBuiltin") { builtin = true } else { nonBuiltin = true }
        index += 1
    }
    if builtin && nonBuiltin { r.die("Using both JSBuiltin and non-JSBuiltin constructors on the same interface is not supported at this time") }
    return builtin
}

pub fn getJSBuiltinFunctionName(className: Str, operation: *Node) -> Str {
    var scopeName = ext(operation, "ImplementedBy")
    if !r.truthy(scopeName) { scopeName = r.substrFrom(className, 2) }
    return getJSBuiltinFunctionNameFromString(scopeName, operation.*.name)
}

pub fn getJSBuiltinFunctionNameFromString(scopeName: Str, functionName: Str) -> Str {
    return cat([_]Str{ cg.wkLcfirst(scopeName), cg.wkUcfirst(functionName), "CodeGenerator" }[0..])
}

pub fn getJSBuiltinScopeName(interface: *Node, object: *Node) -> Str { return r.orElse(ext(object, "ImplementedBy"), typeName(interface)) }

pub fn addJSBuiltinIncludesIfNeeded(interface: *Node) -> void {
    if hasJSBuiltinConstructor(interface) {
        js.addToImplInclude(r.c2(typeName(interface), "Builtins.h"))
        return
    }
    var index: usize = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        if isJSBuiltin(interface, operation) { js.addToImplIncludes(r.c2(getJSBuiltinScopeName(interface, operation), "Builtins.h"), ext(operation, "Conditional")) }
        index += 1
    }
    index = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        if isJSBuiltin(interface, attribute) { js.addToImplIncludes(r.c2(getJSBuiltinScopeName(interface, attribute), "Builtins.h"), ext(attribute, "Conditional")) }
        index += 1
    }
}

// GenerateCallTracer, the arguments as their types and expressions.
pub fn generateCallTracer(out: *StrList, callTracer: Str, name: Str, argumentTypes: StrList, argumentExpressions: StrList, indent: Str) -> void {
    js.addToImplInclude(r.c2(callTracer, ".h"))
    p(out, cat([_]Str{ indent, "if (impl.hasActive", callTracer, "()) [[unlikely]]\n" }[0..]))
    p(out, cat([_]Str{ indent, "    ", callTracer, "::recordAction(impl, \"", name, "\"_s" }[0..]))
    if argumentTypes.count > 0 {
        var parts = r.strList()
        var index: usize = 0
        while index < argumentTypes.count {
            r.spush(&parts, cat([_]Str{ callTracer, "::processArgument<", argumentTypes.items[index], ">(impl, ", argumentExpressions.items[index], ")" }[0..]))
            index += 1
        }
        p(out, cat([_]Str{ ", { ", r.sjoin(parts, ", "), " }" }[0..]))
    }
    p(out, ");\n")
}

pub fn generateCustomElementReactionsStackIfNeeded(out: *StrList, context: *Node, stateVariable: Str) -> void {
    const reactions = ext(context, "CEReactions")
    if !r.truthy(reactions) { return }
    js.addToImplInclude("CustomElementReactionQueue.h")
    if !(r.same(reactions, "NotNeeded") || r.same(reactions, "Needed")) { r.die(cat([_]Str{ "CEReactions should have a value of Needed or NotNeeded but found '", reactions, "'. Most CEReactions are not needed because WebKit does not support customized builtins." }[0..])) }
    if r.same(reactions, "NotNeeded") {
        p(out, "    CustomElementReactionDisallowedScope customElementReactionDisallowedScope;\n")
    } else {
        p(out, cat([_]Str{ "    CustomElementReactionStack customElementReactionStack(", stateVariable, ");\n" }[0..]))
    }
}

fn makeSharedSyntheticAttribute(name: Str, base: *Node) -> *Node {
    const shared = m.newNode(m.K_ATTRIBUTE)
    shared.*.name = name
    shared.*.ty = m.cloneType(base.*.ty.?)
    m.copyInto(shared.*.ext, base.*.ext)
    m.remove(shared.*.ext, "DelegateToSharedSyntheticAttribute")
    m.set(shared.*.ext, "IsSharedSyntheticAttribute", "1")
    return shared
}

pub fn addSharedSyntheticAttributesIfNeeded(interface: *Node) -> void {
    if m.exists(interface.*.ext, "SyntheticIDLAttributes") { return }
    var seen = r.map()
    const v = m.newValue(m.V_NODES, "")
    var index: usize = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        index += 1
        if on(attribute, "DelegateToSharedSyntheticAttribute") {
            const name = ext(attribute, "DelegateToSharedSyntheticAttribute")
            if !r.has(&seen, name) {
                r.set(&seen, name, 1)
                r.push(&v.*.items, @intFromPtr(makeSharedSyntheticAttribute(name, attribute)))
            }
        }
    }
    m.setValue(interface.*.ext, "SyntheticIDLAttributes", v)
}

// The attributes kept in SyntheticIDLAttributes.
pub fn syntheticAttributes(interface: *Node) -> r.List {
    const v = m.value(interface.*.ext, "SyntheticIDLAttributes")
    if v == null { return r.list() }
    return v.?.*.items
}

pub fn getSharedSyntheticAttribute(interface: *Node, attribute: *Node) -> *Node {
    const attributes = syntheticAttributes(interface)
    var index: usize = 0
    while index < attributes.count {
        const synthetic = m.node(attributes, index)
        if r.same(ext(attribute, "DelegateToSharedSyntheticAttribute"), synthetic.*.name) { return synthetic }
        index += 1
    }
    r.die("GetSharedSyntheticAttribute: none found")
    return attribute
}

pub fn toMethodName(param: Str) -> Str {
    if r.startsWith(param, "CSSOM") { return param }
    var ret = r.lcfirst(param)
    const pairs = [_]Str{ "cSS", "css", "dOM", "dom", "hTML", "html", "hDR", "hdr", "jS", "js", "uRL", "url", "xML", "xml", "xSLT", "xslt" }
    var index: usize = 0
    while index < pairs.length {
        if r.startsWith(ret, pairs[index]) { ret = r.replaceFirst(ret, pairs[index], pairs[index + 1]) }
        index += 2
    }
    if r.same(ret, "create") { ret = "isCreate" }
    if r.same(ret, "exclusive") { ret = "isExclusive" }
    return ret
}

fn generateRuntimeEnableConditionalStringForExposeScope(exposed: Str, context: *Node, globalObjectPtr: Str) -> Str {
    var wrapperType: Str = ""
    var sideCondition = r.undef()
    if r.same(exposed, "Window") {
        wrapperType = "JSDOMWindowBase"
    } else if r.same(exposed, "Worker") {
        wrapperType = "JSWorkerGlobalScopeBase"
    } else if r.same(exposed, "DedicatedWorker") {
        wrapperType = "JSDedicatedWorkerGlobalScope"
    } else if r.same(exposed, "SharedWorker") {
        wrapperType = "JSSharedWorkerGlobalScope"
    } else if r.same(exposed, "ServiceWorker") {
        wrapperType = "JSServiceWorkerGlobalScope"
    } else if r.same(exposed, "ShadowRealm") {
        wrapperType = "JSShadowRealmGlobalScopeBase"
    } else if r.same(exposed, "Worklet") {
        wrapperType = "JSWorkletGlobalScopeBase"
    } else if r.same(exposed, "AudioWorklet") {
        wrapperType = "JSWorkletGlobalScopeBase"
        sideCondition = "global->scriptExecutionContext()->isAudioWorkletGlobalScope()"
    } else {
        r.die(r.c3("Unrecognized value '", exposed, "' for the Exposed extended attribute"))
    }
    js.addToImplIncludes(r.c2(wrapperType, ".h"), "0")
    if r.isDef(sideCondition) { return cat([_]Str{ "([&] { auto* global = dynamicDowncast<", wrapperType, ">(", globalObjectPtr, "); return global && ", sideCondition, "; })()" }[0..]) }
    return cat([_]Str{ "(", globalObjectPtr, ")->inherits<", wrapperType, ">()" }[0..])
}

fn generateRuntimeEnableConditionalStringForExposed(interface: *Node, context: *Node, globalObjectPtr: Str, conjuncts: *StrList) -> void {
    if r.same(ext(context, "Exposed"), "VALUE_IS_MISSING") { r.die("Must specify value for Exposed.") }
    js.addToImplInclude("ScriptExecutionContext.h")
    const v = m.value(context.*.ext, "Exposed").?
    if r.same(m.textOf(v), "*") { return }
    if v.*.kind == m.V_IDS {
        var disjuncts = r.strList()
        var index: usize = 0
        while index < v.*.ids.count {
            r.spush(&disjuncts, generateRuntimeEnableConditionalStringForExposeScope(v.*.ids.items[index], context, globalObjectPtr))
            index += 1
        }
        r.spush(conjuncts, r.c3("(", r.sjoin(disjuncts, " || "), ")"))
    } else {
        r.spush(conjuncts, generateRuntimeEnableConditionalStringForExposeScope(m.textOf(v), context, globalObjectPtr))
    }
}

fn requireValue(context: *Node, name: Str) -> void {
    if r.same(ext(context, name), "VALUE_IS_MISSING") { r.die(r.c3("Must specify value for ", name, ".")) }
}

fn exposedOnlyToWindowCheck(interface: *Node, name: Str) -> void {
    if on(interface, "Exposed") && !r.same(ext(interface, "Exposed"), "Window") { r.die(r.c2(name, " can only be used by interfaces only exposed to the Window")) }
}

fn orJoined(parts: StrList) -> Str {
    const result = r.sjoin(parts, " || ")
    if parts.count > 1 { return r.c3("(", result, ")") }
    return result
}

pub fn generateRuntimeEnableConditionalString(interface: *Node, context: *Node, globalObjectPtr: Str, globalObjectPtrIsJSDOMGlobalObject: bool) -> Str {
    const expr = if globalObjectPtrIsJSDOMGlobalObject { globalObjectPtr } else { r.c3("uncheckedDowncast<JSDOMGlobalObject>(", globalObjectPtr, ")") }
    const isWindow = r.same(typeName(interface), "DOMWindow")
    if on(context, "CustomEnabledBy") {
        const className = r.c2("JS", typeName(interface))
        if r.same(ext(context, "CustomEnabledBy"), "VALUE_IS_MISSING") { r.die("Must specify value for EnabledForWorld.") }
        const method = toMethodName(ext(context, "CustomEnabledBy"))
        return cat([_]Str{ className, "::", method, "(", expr, "->scriptExecutionContext())" }[0..])
    }
    var conjuncts = r.strList()
    if on(context, "SecureContext") {
        js.addToImplInclude("ScriptExecutionContext.h")
        if on(context, "ContextAllowsMediaDevices") {
            r.spush(&conjuncts, cat([_]Str{ "(", expr, "->scriptExecutionContext()->isSecureContext()|| ", expr, "->scriptExecutionContext()->allowsMediaDevices())" }[0..]))
        } else if isWindow {
            r.spush(&conjuncts, "(scriptExecutionContext && scriptExecutionContext->isSecureContext())")
        } else {
            r.spush(&conjuncts, r.c2(expr, "->scriptExecutionContext()->isSecureContext()"))
        }
    }
    if on(context, "Exposed") { generateRuntimeEnableConditionalStringForExposed(interface, context, globalObjectPtr, &conjuncts) }
    if on(context, "EnabledForWorld") {
        requireValue(context, "EnabledForWorld")
        js.addToImplInclude("DOMWrapperWorld.h")
        r.spush(&conjuncts, cat([_]Str{ "worldForDOMObject(*", globalObjectPtr, ").", toMethodName(ext(context, "EnabledForWorld")), "()" }[0..]))
    }
    if on(context, "EnabledForGlobalObject") {
        requireValue(context, "EnabledForGlobalObject")
        js.addToImplInclude("DOMWrapperWorld.h")
        r.spush(&conjuncts, cat([_]Str{ expr, "->", toMethodName(ext(context, "EnabledForGlobalObject")), "()" }[0..]))
    }
    if on(context, "EnabledBySetting") {
        requireValue(context, "EnabledBySetting")
        const flags = r.splitByte(ext(context, "EnabledBySetting"), 38)
        const exposedToWindowOnly = on(interface, "Exposed") && r.same(ext(interface, "Exposed"), "Window")
        js.addToImplInclude(if exposedToWindowOnly { "DocumentSettingsValues.h" } else { "ScriptExecutionContext.h" })
        js.addToImplInclude("Settings.h")
        var f: usize = 0
        while f < flags.count {
            const orflags = r.splitByte(flags.items[f], 124)
            f += 1
            var orconjuncts = r.strList()
            var o: usize = 0
            while o < orflags.count {
                const method = toMethodName(orflags.items[o])
                o += 1
                if isWindow {
                    r.spush(&orconjuncts, cat([_]Str{ "(scriptExecutionContext && scriptExecutionContext->settingsValues().", method, ")" }[0..]))
                } else if exposedToWindowOnly {
                    r.spush(&orconjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->settingsValues().", method }[0..]))
                } else {
                    r.spush(&orconjuncts, cat([_]Str{ expr, "->scriptExecutionContext()->settingsValues().", method }[0..]))
                }
            }
            r.spush(&conjuncts, orJoined(orconjuncts))
        }
    }
    if on(context, "EnabledConditionallyReadWriteBySetting") {
        requireValue(context, "EnabledConditionallyReadWriteBySetting")
        js.addToImplInclude("Document.h")
        exposedOnlyToWindowCheck(interface, "EnabledConditionallyReadWriteBySetting")
        const flags = r.splitByte(ext(context, "EnabledConditionallyReadWriteBySetting"), 38)
        var f: usize = 0
        while f < flags.count {
            const orflags = r.splitByte(flags.items[f], 124)
            f += 1
            var orconjuncts = r.strList()
            var o: usize = 0
            while o < orflags.count {
                r.spush(&orconjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->settingsValues().", toMethodName(orflags.items[o]) }[0..]))
                o += 1
            }
            r.spush(&conjuncts, orJoined(orconjuncts))
        }
    }
    if on(context, "EnabledByQuirk") {
        requireValue(context, "EnabledByQuirk")
        js.addToImplInclude("DocumentQuirks.h")
        exposedOnlyToWindowCheck(interface, "EnabledByQuirk")
        const flags = r.splitByte(ext(context, "EnabledByQuirk"), 38)
        var f: usize = 0
        while f < flags.count {
            const method = toMethodName(flags.items[f])
            f += 1
            if isWindow {
                r.spush(&conjuncts, cat([_]Str{ "(scriptExecutionContext && downcast<Document>(scriptExecutionContext)->quirks().", method, "Quirk())" }[0..]))
            } else {
                r.spush(&conjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->quirks().", method, "Quirk()" }[0..]))
            }
        }
    }
    if on(context, "DisabledByQuirk") {
        requireValue(context, "DisabledByQuirk")
        js.addToImplInclude("DocumentQuirks.h")
        exposedOnlyToWindowCheck(interface, "DisabledByQuirk")
        const flags = r.splitByte(ext(context, "DisabledByQuirk"), 38)
        var f: usize = 0
        while f < flags.count {
            const method = toMethodName(flags.items[f])
            f += 1
            if isWindow {
                r.spush(&conjuncts, cat([_]Str{ "(!scriptExecutionContext || !downcast<Document>(scriptExecutionContext)->quirks().", method, "Quirk())" }[0..]))
            } else {
                r.spush(&conjuncts, cat([_]Str{ "!downcast<Document>(", expr, "->scriptExecutionContext())->quirks().", method, "Quirk()" }[0..]))
            }
        }
    }
    if on(context, "EnabledByDeprecatedGlobalSetting") {
        requireValue(context, "EnabledByDeprecatedGlobalSetting")
        js.addToImplInclude("DeprecatedGlobalSettings.h")
        const flags = r.splitByte(ext(context, "EnabledByDeprecatedGlobalSetting"), 38)
        var f: usize = 0
        while f < flags.count {
            r.spush(&conjuncts, cat([_]Str{ "DeprecatedGlobalSettings::", toMethodName(flags.items[f]), "()" }[0..]))
            f += 1
        }
    }
    if on(context, "EnabledForContext") {
        if !r.same(ext(context, "EnabledForContext"), "VALUE_IS_MISSING") { r.die("Must not specify value for EnabledForContext.") }
        if !cg.isConstructorType(context.*.ty.?) { r.die("EnabledForContext must be an interface or constructor attribute.") }
        const contextRef = cat([_]Str{ "*", expr, "->scriptExecutionContext()" }[0..])
        const name = context.*.name
        js.addToImplInclude(cat([_]Str{ "JS", name, ".h" }[0..]))
        r.spush(&conjuncts, cat([_]Str{ name, "::enabledForContext(", contextRef, ")" }[0..]))
    }
    if on(context, "LegacyFactoryFunctionEnabledBySetting") {
        requireValue(context, "LegacyFactoryFunctionEnabledBySetting")
        const settings = r.splitByte(ext(context, "LegacyFactoryFunctionEnabledBySetting"), 38)
        var f: usize = 0
        while f < settings.count {
            r.spush(&conjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->settings().", toMethodName(settings.items[f]), "()" }[0..]))
            f += 1
        }
    }
    const result = r.sjoin(conjuncts, " && ")
    if conjuncts.count > 1 { return r.c3("(", result, ")") }
    return result
}

pub fn getCastingHelperForThisObject(interface: *Node) -> Str { return r.c3("dynamicDowncast<JS", typeName(interface), ">") }

pub fn addUnscopableProperties(interface: *Node) -> void {
    var unscopables = r.strList()
    const lists = [2]r.List{ interface.*.operations, interface.*.attributes }
    for l in lists {
        var index: usize = 0
        while index < l.count {
            const property = m.node(l, index)
            if on(property, "Unscopable") { r.spush(&unscopables, property.*.name) }
            index += 1
        }
    }
    if unscopables.count == 0 { return }
    js.addToImplInclude("<JavaScriptCore/ObjectConstructor.h>")
    p(js.implContent, "    JSObject& unscopables = *WebCore::constructEmptyObject(realm(), realm()->nullPrototypeObjectStructure());\n")
    var index: usize = 0
    while index < unscopables.count {
        p(js.implContent, cat([_]Str{ "    unscopables.putDirect(vm, Identifier::fromString(vm, \"", unscopables.items[index], "\"_s), jsBoolean(true));\n" }[0..]))
        index += 1
    }
    p(js.implContent, "    WebCore::putDirectWithoutTransition(this, vm, vm.propertyNames->unscopablesSymbol, &unscopables, JSC::PropertyAttribute::DontEnum | JSC::PropertyAttribute::ReadOnly);\n")
}

pub fn getArgumentTypeForFunctionWithoutTypeCheck(interface: *Node, ty: *IDLType) -> Str { return r.c3("DOMJIT::IDLJSArgumentType<", t.getIDLType(interface, ty), ">") }
pub fn getArgumentTypeFilter(interface: *Node, ty: *IDLType) -> Str { return r.c3("DOMJIT::IDLArgumentTypeFilter<", t.getIDLType(interface, ty), ">::value") }
pub fn getResultTypeFilter(interface: *Node, ty: *IDLType) -> Str { return r.c3("DOMJIT::IDLResultTypeFilter<", t.getIDLType(interface, ty), ">::value") }

pub fn getAttributeWithName(interface: *Node, name: Str) -> ?*Node {
    var index: usize = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        if r.same(attribute.*.name, name) { return attribute }
        index += 1
    }
    return null
}

pub fn interfaceNeedsIterator(interface: *Node) -> bool {
    if interface.*.setLike != null || interface.*.mapLike != null || interface.*.iterable != null { return true }
    if getIndexedGetterOperation(interface) != null {
        const length = getAttributeWithName(interface, "length")
        if length != null && cg.isIntegerType(length.?.*.ty.?) { return true }
    }
    return false
}

pub fn interfaceNeedsAsyncIterator(interface: *Node) -> bool { return interface.*.asyncIterable != null }
