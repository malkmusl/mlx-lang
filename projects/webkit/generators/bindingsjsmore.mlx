// CodeGeneratorJS.pm's smaller helpers: what an interface's members need
// (special operations, which object a property lives on, its attributes,
// runtime checks), names of generated functions, the exception functors,
// and the class names of nested enumerations and dictionaries.
const std = @import("std")
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const cg = @import("./bindingsgen.mlx")
const js = @import("./bindingsjs.mlx")
const t = @import("./bindingsjstypes.mlx")
const d = @import("./bindingsjsdict.mlx")
const im = @import("./bindingsjsimpl.mlx")
const rh = @import("./rapidhash.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType
const StrList = r.StrList

fn p(out: *StrList, text: Str) -> void { r.spush(out, text) }
fn cat(parts: []const Str) -> Str { return r.cat(parts) }
fn ext(n: *const Node, name: Str) -> Str { return m.get(n.*.ext, name) }
fn on(n: *const Node, name: Str) -> bool { return m.on(n.*.ext, name) }
fn typeName(n: *const Node) -> Str { return n.*.ty.?.*.name }

pub fn shouldGenerateWrapperOwnerCode(hasParent: bool, interface: *Node) -> bool {
    if !js.needsImplementationClass(interface) { return false }
    if !hasParent { return true }
    if r.truthy(js.getGenerateIsReachable(interface)) { return true }
    if r.truthy(js.getCustomIsReachable(interface)) { return true }
    if on(interface, "JSCustomFinalize") { return true }
    if cg.inheritsExtendedAttribute(interface, "ActiveDOMObject") { return true }
    return false
}

pub fn shouldGenerateToJSDeclaration(hasParent: bool, interface: *Node) -> bool {
    if on(interface, "SuppressToJSObject") { return false }
    if !js.needsImplementationClass(interface) { return false }
    if js.isDOMGlobalObject(interface) { return false }
    return true
}

pub fn shouldGenerateToJSImplementation(hasParent: bool, interface: *Node) -> bool {
    if !shouldGenerateToJSDeclaration(hasParent, interface) { return false }
    if !on(interface, "CustomToJSObject") { return true }
    return false
}

pub fn shouldGenerateConvertDictionary(dictionary: *Node) -> bool {
    if on(dictionary, "JSGenerateToNativeObject") { return true }
    if !on(dictionary, "JSGenerateToJSObject") { return true }
    return false
}

pub fn shouldGenerateConvertDictionaryToJS(dictionary: *Node) -> bool { return on(dictionary, "JSGenerateToJSObject") }

pub fn getTypeNameForDisplayInException(ty: *IDLType) -> Str {
    if ty.*.isUnion {
        const members = t.getFlattenedMemberTypes(ty)
        var names = r.strList()
        var index: usize = 0
        while index < members.count {
            r.spush(&names, r.at(*IDLType, members, index).*.name)
            index += 1
        }
        return r.c3("(", r.sjoin(names, " or "), ")")
    }
    return ty.*.name
}

pub fn getArgumentExceptionFunction(interface: *Node, argument: *Node, argumentIndex: Str, quotedFunctionName: Str) -> Str {
    const name = argument.*.name
    const visibleInterfaceName = cg.getVisibleInterfaceName(interface)
    const ty = argument.*.ty.?
    const typeNameText = getTypeNameForDisplayInException(ty)
    if cg.isCallbackInterface(ty) || std.text.same(ty.*.name, "EventListener") {
        return cat([_]Str{ "throwArgumentMustBeObjectError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ");" }[0..])
    }
    if cg.isCallbackFunction(ty) {
        return cat([_]Str{ "throwArgumentMustBeFunctionError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ");" }[0..])
    }
    if cg.isWrapperType(ty) || cg.isBufferSourceType(ty) {
        return cat([_]Str{ "throwArgumentTypeError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ", \"", typeNameText, "\"_s);" }[0..])
    }
    if cg.isEnumType(ty) {
        const className = d.getEnumerationClassNameOf(ty, interface)
        return cat([_]Str{ "throwArgumentMustBeEnumError(lexicalGlobalObject, scope, ", argumentIndex, ", \"", name, "\"_s, \"", visibleInterfaceName, "\"_s, ", quotedFunctionName, ", expectedEnumerationValues<", className, ">());" }[0..])
    }
    return r.undef()
}

pub fn getArgumentExceptionThrowerFunctor(interface: *Node, argument: *Node, argumentIndex: Str, quotedFunctionName: Str) -> Str {
    const functionCall = getArgumentExceptionFunction(interface, argument, argumentIndex, quotedFunctionName)
    if r.truthy(functionCall) { return cat([_]Str{ "[](JSC::JSGlobalObject& lexicalGlobalObject, JSC::ThrowScope& scope) { ", functionCall, " }" }[0..]) }
    return r.undef()
}

pub fn getAttributeExceptionFunction(interface: *Node, attribute: *Node) -> Str {
    const name = attribute.*.name
    const visibleInterfaceName = cg.getVisibleInterfaceName(interface)
    const ty = attribute.*.ty.?
    const typeNameText = getTypeNameForDisplayInException(ty)
    if cg.isWrapperType(ty) || cg.isBufferSourceType(ty) {
        return cat([_]Str{ "throwAttributeTypeError(lexicalGlobalObject, scope, \"", visibleInterfaceName, "\"_s, \"", name, "\"_s, \"", typeNameText, "\"_s);" }[0..])
    }
    return r.undef()
}

pub fn getAttributeExceptionThrower(interface: *Node, attribute: *Node) -> Str {
    const functionCall = getAttributeExceptionFunction(interface, attribute)
    if r.truthy(functionCall) { return cat([_]Str{ "[](JSC::JSGlobalObject& lexicalGlobalObject, JSC::ThrowScope& scope) { ", functionCall, " }" }[0..]) }
    return r.undef()
}

pub fn getArgumentDefaultValueFunctor(interface: *Node, argument: *Node) -> Str {
    if r.isDef(argument.*.defaultValue) && !im.willConvertUndefinedToDefaultParameterValue(argument.*.ty.?, argument.*.defaultValue) {
        const idlType = t.getIDLType(interface, argument.*.ty.?)
        const defaultValue = d.generateDefaultValue(interface, argument, argument.*.ty.?, argument.*.defaultValue)
        return cat([_]Str{ "[&] -> ConversionResult<", idlType, "> { return ", defaultValue, "; }" }[0..])
    }
    return r.undef()
}

pub fn getDictionaryMemberDefaultValueFunctor(interface: *Node, member: *Node) -> Str {
    if !member.*.isRequired && r.isDef(member.*.defaultValue) && !im.willConvertUndefinedToDefaultParameterValue(member.*.ty.?, member.*.defaultValue) {
        const idlType = t.getIDLType(interface, member.*.ty.?)
        const defaultValue = d.generateDefaultValue(interface, member, member.*.ty.?, member.*.defaultValue)
        return cat([_]Str{ "[&] -> ConversionResult<", idlType, "> { return ", defaultValue, "; }" }[0..])
    }
    return r.undef()
}

pub fn mangleAttributeOrFunctionName(name: Str) -> Str {
    const mangled = r.replaceAll(name, "-", "_dash_")
    if mangled.length > 0 && mangled[0] == 95 { return mangled }
    return r.c2("_", mangled)
}

pub fn getAttributeGetterName(interface: *Node, className: Str, attribute: *Node) -> Str {
    if on(attribute, "DelegateToSharedSyntheticAttribute") { return getAttributeGetterName(interface, className, getSharedSyntheticAttribute(interface, attribute)) }
    if isJSBuiltin(interface, attribute) { return getJSBuiltinFunctionName(className, attribute) }
    if attribute.*.isStatic { return cat([_]Str{ cg.wkLcfirst(className), "Constructor", mangleAttributeOrFunctionName(attribute.*.name) }[0..]) }
    if cg.isConstructorType(attribute.*.ty.?) { return cat([_]Str{ cg.wkLcfirst(className), mangleAttributeOrFunctionName(attribute.*.name), "Constructor" }[0..]) }
    return r.c2(cg.wkLcfirst(className), mangleAttributeOrFunctionName(attribute.*.name))
}

pub fn getAttributeSetterName(interface: *Node, className: Str, attribute: *Node) -> Str {
    if on(attribute, "DelegateToSharedSyntheticAttribute") { return getAttributeSetterName(interface, className, getSharedSyntheticAttribute(interface, attribute)) }
    if isJSBuiltin(interface, attribute) { return r.c2("set", cg.wkUcfirst(getJSBuiltinFunctionName(className, attribute))) }
    if attribute.*.isStatic { return cat([_]Str{ "set", cg.wkUcfirst(className), "Constructor", mangleAttributeOrFunctionName(attribute.*.name) }[0..]) }
    return cat([_]Str{ "set", cg.wkUcfirst(className), mangleAttributeOrFunctionName(attribute.*.name) }[0..])
}

pub fn getFunctionName(interface: *Node, className: Str, operation: *Node) -> Str {
    if isJSBuiltin(interface, operation) { return getJSBuiltinFunctionName(className, operation) }
    var functionName = operation.*.name
    if std.text.same(functionName, "[Symbol.Iterator]") { functionName = "SymbolIterator" }
    if std.text.same(functionName, "[Symbol.asyncIterator]") { functionName = "AsyncSymbolIterator" }
    const kind = if operation.*.isStatic { "Constructor" } else if operationShouldBeOnInstance(interface, operation) { "Instance" } else { "Prototype" }
    return cat([_]Str{ cg.wkLcfirst(className), kind, "Function", mangleAttributeOrFunctionName(functionName) }[0..])
}

pub fn getFullyQualifiedImplementationCallName(interface: *Node, property: *Node, implementationName: Str, implExpression: Str, conditional: Str) -> Str {
    const implementedBy = ext(property, "ImplementedBy")
    if r.truthy(implementedBy) && !on(property, "Reflect") {
        js.addToImplIncludes(r.c2(implementedBy, ".h"), conditional)
        return cat([_]Str{ "WebCore::", implementedBy, "::", implementationName }[0..])
    }
    if property.*.isStatic || property.*.isConstructor { return cat([_]Str{ typeName(interface), "::", implementationName }[0..]) }
    if on(property, "ForwardToMapLike") { return cat([_]Str{ "forward", cg.wkUcfirst(property.*.name), "ToMapLike" }[0..]) }
    if on(property, "ForwardToSetLike") { return cat([_]Str{ "forward", cg.wkUcfirst(property.*.name), "ToSetLike" }[0..]) }
    return cat([_]Str{ implExpression, ".", implementationName }[0..])
}

pub fn addAdditionalArgumentsForImplementationCall(arguments: *StrList, interface: *Node, property: *Node, implExpression: Str, globalObject: Str, callFrame: Str, thisObjectExpression: Str) -> void {
    if on(property, "ImplementedBy") && !property.*.isStatic && !on(property, "Reflect") { r.sunshift(arguments, implExpression) }
    if on(property, "ForwardToMapLike") || on(property, "ForwardToSetLike") {
        r.spush(arguments, globalObject)
        if property.*.kind == m.K_OPERATION { r.spush(arguments, callFrame) }
        r.spush(arguments, thisObjectExpression)
    }
}

fn getSpecialAccessorOperationForType(interface: *Node, special: Str, firstParameterType: Str, numberOfParameters: usize) -> ?*Node {
    const lists = [2]r.List{ interface.*.operations, interface.*.anonymousOperations }
    for l in lists {
        var index: usize = 0
        while index < l.count {
            const operation = m.node(l, index)
            index += 1
            if r.shas(operation.*.specials, special) && operation.*.arguments.count == numberOfParameters && std.text.same(typeName(m.node(operation.*.arguments, 0)), firstParameterType) { return operation }
        }
    }
    return null
}

pub fn isGlobalInterface(interface: *Node) -> bool { return on(interface, "Global") }

pub fn attributeShouldBeOnInstance(interface: *Node, attribute: *Node) -> bool {
    if isGlobalInterface(interface) { return true }
    if cg.isConstructorType(attribute.*.ty.?) { return true }
    if isLegacyUnforgeable(interface, attribute) { return true }
    if on(interface, "CheckSecurity") {
        if on(attribute, "DoNotCheckSecurity") { return false }
        if on(attribute, "DoNotCheckSecurityOnGetter") { return false }
        return true
    }
    return false
}

// IsAlwaysExposedOnInterface, on the [Exposed] values (a string, or the
// list of =(A, B)).
fn isAlwaysExposedOnInterface(interfaceExposures: ?*m.Value, contextExposures: *m.Value) -> bool {
    var contextSet = r.strList()
    if contextExposures.*.kind == m.V_IDS { r.sappend(&contextSet, contextExposures.*.ids) } else { r.spush(&contextSet, m.textOf(contextExposures)) }
    var interfaceList = r.strList()
    if interfaceExposures != null && interfaceExposures.?.*.kind == m.V_IDS {
        r.sappend(&interfaceList, interfaceExposures.?.*.ids)
    } else {
        const text = if interfaceExposures == null { "" } else { m.textOf(interfaceExposures.?) }
        if std.text.same(text, "*") { return std.text.same(m.textOf(contextExposures), "*") }
        r.spush(&interfaceList, text)
    }
    var index: usize = 0
    while index < interfaceList.count {
        if !r.shas(contextSet, interfaceList.items[index]) { return false }
        index += 1
    }
    return true
}

const privateHeaders = [_]Str{ "JSAbstractRange.h", "JSBlob.h", "JSCompositeOperation.h", "JSCompositeOperationOrAuto.h", "JSComputedEffectTiming.h", "JSCSSRule.h", "JSCSSRuleList.h", "JSCSSStyleDeclaration.h", "JSDeprecatedCSSOMCounter.h", "JSDeprecatedCSSOMRect.h", "JSDeprecatedCSSOMRGBColor.h", "JSDeprecatedCSSOMValue.h", "JSDeprecatedCSSOMValueList.h", "JSDocument.h", "JSDOMImplementation.h", "JSDOMWindow.h", "JSEffectTiming.h", "JSElement.h", "JSEvent.h", "JSEventTarget.h", "JSFile.h", "JSHTMLCollection.h", "JSHTMLElement.h", "JSHTMLOptionsCollection.h", "JSImageData.h", "JSIterationCompositeOperation.h", "JSKeyframeEffectOptions.h", "JSMediaList.h", "JSNamedNodeMap.h", "JSNode.h", "JSNodeIterator.h", "JSNodeList.h", "JSNotification.h", "JSOffscreenCanvas.h", "JSOptionalEffectTiming.h", "JSRange.h", "JSStyleSheet.h", "JSStyleSheetList.h", "JSTreeWalker.h", "JSWebKitJSHandle.h", "JSWebKitNodeSnapshot.h", "JSXPathExpression.h", "JSXPathResult.h" }

pub fn isPrivateHeader(headerFileName: Str) -> bool {
    var sanitized = headerFileName
    if sanitized.length > 0 && (sanitized[0] == 34 || sanitized[0] == 60) { sanitized = sanitized[1..sanitized.length] }
    if sanitized.length > 0 && (sanitized[sanitized.length - 1] == 34 || sanitized[sanitized.length - 1] == 62) { sanitized = sanitized[0..sanitized.length - 1] }
    for name in privateHeaders {
        if std.text.same(name, sanitized) { return true }
    }
    return false
}

pub fn needsRuntimeCheck(interface: *Node, context: *Node) -> bool {
    if on(context, "Exposed") {
        if !isAlwaysExposedOnInterface(m.value(interface.*.ext, "Exposed"), m.value(context.*.ext, "Exposed").?) { return true }
    }
    const names = [_]Str{ "EnabledByDeprecatedGlobalSetting", "EnabledForContext", "EnabledForGlobalObject", "EnabledForWorld", "EnabledBySetting", "EnabledByQuirk", "DisabledByQuirk", "SecureContext" }
    for name in names {
        if on(context, name) { return true }
    }
    return false
}

pub fn needsRuntimeReadWriteCheck(interface: *Node, context: *Node) -> bool { return on(context, "EnabledConditionallyReadWriteBySetting") }

pub fn operationShouldBeOnInstance(interface: *Node, operation: *Node) -> bool {
    if isGlobalInterface(interface) { return true }
    if isLegacyUnforgeable(interface, operation) {
        if needsRuntimeCheck(interface, operation) { r.die(cat([_]Str{ "The bindings generator does not support putting runtime-enabled operations on the instance yet (except for global objects):[", typeName(interface), "::", operation.*.name, "]" }[0..])) }
        return true
    }
    return false
}

pub fn getOperationReturnedArgumentName(operation: *Node) -> Str {
    var index: usize = 0
    while index < operation.*.arguments.count {
        if on(m.node(operation.*.arguments, index), "ReturnValue") { return r.c2("argument", r.decimal(@intCast(u64, index))) }
        index += 1
    }
    return r.undef()
}

pub fn isAcceleratedDOMAttribute(interface: *Node, attribute: *Node) -> bool {
    if needsRuntimeCheck(interface, attribute) && attributeShouldBeOnInstance(interface, attribute) { return false }
    if on(attribute, "PrivateIdentifier") && attributeShouldBeOnInstance(interface, attribute) { return false }
    if js.isDOMGlobalObject(interface) { return false }
    if attribute.*.isStatic { return false }
    if on(attribute, "ForwardToMapLike") { return false }
    if on(attribute, "ForwardToSetLike") { return false }
    if cg.isConstructorType(attribute.*.ty.?) { return false }
    if isJSBuiltin(interface, attribute) { return false }
    if on(attribute, "LegacyLenientThis") { return false }
    if cg.isPromiseType(attribute.*.ty.?) { return false }
    if on(attribute, "DOMJIT") { return false }
    return true
}

pub fn stringifyJSCAttributes(specials: StrList) -> Str {
    if specials.count == 0 { return "0" }
    if specials.count == 1 { return r.c3("static_cast<unsigned>(", specials.items[0], ")") }
    return r.sjoin(specials, " | ")
}

pub fn getJSCAttributesForAttribute(interface: *Node, attribute: *Node) -> StrList {
    var specials = r.strList()
    if isLegacyUnforgeable(interface, attribute) { r.spush(&specials, "JSC::PropertyAttribute::DontDelete") }
    const isGlobalConstructor = cg.isConstructorType(attribute.*.ty.?)
    if on(attribute, "NotEnumerable") || isGlobalConstructor { r.spush(&specials, "JSC::PropertyAttribute::DontEnum") }
    if js.isReadonly(attribute) { r.spush(&specials, "JSC::PropertyAttribute::ReadOnly") }
    if !(isGlobalConstructor || isJSBuiltin(interface, attribute)) { r.spush(&specials, "JSC::PropertyAttribute::CustomAccessor") }
    if isAcceleratedDOMAttribute(interface, attribute) { r.spush(&specials, "JSC::PropertyAttribute::DOMAttribute") }
    if on(attribute, "DOMJIT") { r.spush(&specials, "JSC::PropertyAttribute::DOMJITAttribute") }
    if isJSBuiltin(interface, attribute) {
        r.spush(&specials, "JSC::PropertyAttribute::Accessor")
        r.spush(&specials, "JSC::PropertyAttribute::Builtin")
    }
    return specials
}

pub fn getIndexedGetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "getter", "unsigned long", 1) }
pub fn getIndexedSetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "setter", "unsigned long", 2) }
pub fn getNamedGetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "getter", "DOMString", 1) }
pub fn getNamedSetterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "setter", "DOMString", 2) }
pub fn getNamedDeleterOperation(interface: *Node) -> ?*Node { return getSpecialAccessorOperationForType(interface, "deleter", "DOMString", 1) }

pub fn instanceOperationCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.operations.count {
        if operationShouldBeOnInstance(interface, m.node(interface.*.operations, index)) { count += 1 }
        index += 1
    }
    return count
}

pub fn prototypeOperationCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        if !operation.*.isStatic && !operationShouldBeOnInstance(interface, operation) { count += 1 }
        index += 1
    }
    return count
}

pub fn instancePropertyCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.attributes.count {
        if attributeShouldBeOnInstance(interface, m.node(interface.*.attributes, index)) { count += 1 }
        index += 1
    }
    return count + instanceOperationCount(interface)
}

pub fn prototypePropertyCount(interface: *Node) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < interface.*.attributes.count {
        if !attributeShouldBeOnInstance(interface, m.node(interface.*.attributes, index)) { count += 1 }
        index += 1
    }
    count += prototypeOperationCount(interface)
    if needsConstructorProperty(interface) { count += 1 }
    return count
}

pub fn instanceOverridesGetOwnPropertySlot(interface: *Node) -> bool {
    return on(interface, "CustomGetOwnPropertySlot") || on(interface, "Plugin") || getIndexedGetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesGetOwnPropertyNames(interface: *Node) -> bool {
    return on(interface, "CustomGetOwnPropertyNames") || getIndexedGetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesPut(interface: *Node) -> bool {
    return on(interface, "CustomPut") || on(interface, "Plugin") || getIndexedSetterOperation(interface) != null || getIndexedGetterOperation(interface) != null || getNamedSetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesIndexedDefineOwnProperty(interface: *Node) -> bool {
    return on(interface, "CustomDefineOwnProperty") || getIndexedSetterOperation(interface) != null || getIndexedGetterOperation(interface) != null
}

pub fn instanceOverridesNamedDefineOwnProperty(interface: *Node) -> bool {
    return on(interface, "CustomDefineOwnProperty") || getNamedSetterOperation(interface) != null || getNamedGetterOperation(interface) != null
}

pub fn instanceOverridesDefineOwnProperty(interface: *Node) -> bool { return instanceOverridesIndexedDefineOwnProperty(interface) || instanceOverridesNamedDefineOwnProperty(interface) }

pub fn instanceOverridesDeleteProperty(interface: *Node) -> bool {
    return on(interface, "CustomDeleteProperty") || getNamedDeleterOperation(interface) != null || getNamedGetterOperation(interface) != null || getIndexedGetterOperation(interface) != null
}

pub fn prototypeHasStaticPropertyTable(interface: *Node) -> bool { return interface.*.constants.count > 0 || prototypePropertyCount(interface) > 0 }

pub fn instanceNeedsVisitChildren(interface: *Node) -> bool {
    var index: usize = 0
    while index < interface.*.attributes.count {
        if on(m.node(interface.*.attributes, index), "CachedAttribute") { return true }
        index += 1
    }
    if on(interface, "JSCustomMarkFunction") { return true }
    if on(interface, "GenerateAddOpaqueRoot") { return true }
    if on(interface, "Plugin") { return true }
    if on(interface, "ReportExtraMemoryCost") { return true }
    return false
}

pub fn instanceNeedsEstimatedSize(interface: *Node) -> bool { return on(interface, "ReportExtraMemoryCost") }

pub fn getImplClassName(interface: *Node) -> Str { return typeName(interface) }
pub fn getImplClassPtrTag(interface: *Node) -> Str { return r.c2(typeName(interface), "PtrTag") }

// IsClassNameWordBoundary with I counted from the end when FROMEND.
fn isClassNameWordBoundary(name: Str, index: usize, fromEnd: bool) -> bool {
    var i = index
    if fromEnd {
        if index > name.length { return false }
        i = name.length - index
    }
    if i == 0 { return true }
    if i == name.length { return true }
    if i > name.length { return false }
    const check = name[i - 1..name.length]
    if check.length >= 2 && !r.isUpper(check[0]) && r.isUpper(check[1]) { return true }
    if check.length >= 3 && r.isUpper(check[0]) && r.isUpper(check[1]) && !r.isUpper(check[2]) { return true }
    return false
}

fn prefix(text: Str, length: usize) -> Str { return if length > text.length { text } else { text[0..length] } }

fn isPrefixRemovable(class: Str, name: Str, i: usize) -> bool {
    if !isClassNameWordBoundary(name, i, false) { return false }
    if isClassNameWordBoundary(class, i, false) && std.text.same(prefix(class, i), prefix(name, i)) { return true }
    if isClassNameWordBoundary(class, i, true) && std.text.same(class[class.length - i..class.length], prefix(name, i)) { return true }
    return false
}

pub fn getNestedClassName(interface: *Node, name: Str) -> Str {
    const class = getImplClassName(interface)
    var member = cg.wkUcfirst(name)
    var longest: usize = 0
    if member.length >= 2 && r.isUpper(member[0]) && member[1] != 10 {
        var i: usize = 2
        while i + 1 < member.length {
            if isPrefixRemovable(class, member, i) { longest = i }
            i += 1
        }
    }
    member = r.substrFrom(member, longest)
    return cat([_]Str{ class, "::", member }[0..])
}

pub fn isLegacyUnforgeable(interface: *Node, property: *Node) -> bool {
    return on(property, "LegacyUnforgeable") || on(interface, "LegacyUnforgeable")
}

pub fn hasCustomConstructor(interface: *Node) -> bool {
    var custom = false
    var nonCustom = false
    var index: usize = 0
    while index < interface.*.constructors.count {
        if on(m.node(interface.*.constructors, index), "Custom") { custom = true } else { nonCustom = true }
        index += 1
    }
    if custom && nonCustom { r.die("Using both Custom and non-Custom constructors on the same interface is not supported at this time") }
    return custom
}

pub fn hasCustomGetter(attribute: *Node) -> bool { return on(attribute, "Custom") || on(attribute, "CustomGetter") }
pub fn hasCustomSetter(attribute: *Node) -> bool { return on(attribute, "Custom") || on(attribute, "CustomSetter") }
pub fn hasCustomMethod(operation: *Node) -> bool { return on(operation, "Custom") }

pub fn needsConstructorProperty(interface: *Node) -> bool {
    if interface.*.isNamespaceObject { return false }
    return !on(interface, "LegacyNoInterfaceObject")
}

pub fn isConstructable(interface: *Node) -> bool { return interface.*.constructors.count > 0 }
pub fn instanceOverridesGetCallData(interface: *Node) -> bool { return on(interface, "CustomGetCallData") || on(interface, "Plugin") }
pub fn headerNeedsPrototypeDeclaration(interface: *Node) -> bool { return js.isDOMGlobalObject(interface) }

pub fn computeFunctionSpecial(interface: *Node, operation: *Node) -> StrList {
    var specials = r.strList()
    if isLegacyUnforgeable(interface, operation) {
        r.spush(&specials, "JSC::PropertyAttribute::DontDelete")
        r.spush(&specials, "JSC::PropertyAttribute::ReadOnly")
    }
    if on(operation, "NotEnumerable") { r.spush(&specials, "JSC::PropertyAttribute::DontEnum") }
    if isJSBuiltin(interface, operation) { r.spush(&specials, "JSC::PropertyAttribute::Builtin") } else { r.spush(&specials, "JSC::PropertyAttribute::Function") }
    if on(operation, "DOMJIT") { r.spush(&specials, "JSC::PropertyAttribute::DOMJITFunction") }
    return specials
}

pub fn isJSBuiltin(interface: *Node, object: *Node) -> bool {
    if on(object, "Custom") || on(object, "CustomGetter") || on(object, "CustomSetter") { return false }
    if on(object, "JSBuiltin") { return true }
    if on(interface, "JSBuiltin") { return true }
    return false
}

pub fn hasJSBuiltinConstructor(interface: *Node) -> bool {
    if on(interface, "JSBuiltin") { return true }
    var builtin = false
    var nonBuiltin = false
    var index: usize = 0
    while index < interface.*.constructors.count {
        if on(m.node(interface.*.constructors, index), "JSBuiltin") { builtin = true } else { nonBuiltin = true }
        index += 1
    }
    if builtin && nonBuiltin { r.die("Using both JSBuiltin and non-JSBuiltin constructors on the same interface is not supported at this time") }
    return builtin
}

pub fn getJSBuiltinFunctionName(className: Str, operation: *Node) -> Str {
    var scopeName = ext(operation, "ImplementedBy")
    if !r.truthy(scopeName) { scopeName = r.substrFrom(className, 2) }
    return getJSBuiltinFunctionNameFromString(scopeName, operation.*.name)
}

pub fn getJSBuiltinFunctionNameFromString(scopeName: Str, functionName: Str) -> Str {
    return cat([_]Str{ cg.wkLcfirst(scopeName), cg.wkUcfirst(functionName), "CodeGenerator" }[0..])
}

pub fn getJSBuiltinScopeName(interface: *Node, object: *Node) -> Str { return r.orElse(ext(object, "ImplementedBy"), typeName(interface)) }

pub fn addJSBuiltinIncludesIfNeeded(interface: *Node) -> void {
    if hasJSBuiltinConstructor(interface) {
        js.addToImplInclude(r.c2(typeName(interface), "Builtins.h"))
        return
    }
    var index: usize = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        if isJSBuiltin(interface, operation) { js.addToImplIncludes(r.c2(getJSBuiltinScopeName(interface, operation), "Builtins.h"), ext(operation, "Conditional")) }
        index += 1
    }
    index = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        if isJSBuiltin(interface, attribute) { js.addToImplIncludes(r.c2(getJSBuiltinScopeName(interface, attribute), "Builtins.h"), ext(attribute, "Conditional")) }
        index += 1
    }
}

// GenerateCallTracer, the arguments as their types and expressions.
pub fn generateCallTracer(out: *StrList, callTracer: Str, name: Str, argumentTypes: StrList, argumentExpressions: StrList, indent: Str) -> void {
    js.addToImplInclude(r.c2(callTracer, ".h"))
    p(out, cat([_]Str{ indent, "if (impl.hasActive", callTracer, "()) [[unlikely]]\n" }[0..]))
    p(out, cat([_]Str{ indent, "    ", callTracer, "::recordAction(impl, \"", name, "\"_s" }[0..]))
    if argumentTypes.count > 0 {
        var parts = r.strList()
        var index: usize = 0
        while index < argumentTypes.count {
            r.spush(&parts, cat([_]Str{ callTracer, "::processArgument<", argumentTypes.items[index], ">(impl, ", argumentExpressions.items[index], ")" }[0..]))
            index += 1
        }
        p(out, cat([_]Str{ ", { ", r.sjoin(parts, ", "), " }" }[0..]))
    }
    p(out, ");\n")
}

pub fn generateCustomElementReactionsStackIfNeeded(out: *StrList, context: *Node, stateVariable: Str) -> void {
    const reactions = ext(context, "CEReactions")
    if !r.truthy(reactions) { return }
    js.addToImplInclude("CustomElementReactionQueue.h")
    if !(std.text.same(reactions, "NotNeeded") || std.text.same(reactions, "Needed")) { r.die(cat([_]Str{ "CEReactions should have a value of Needed or NotNeeded but found '", reactions, "'. Most CEReactions are not needed because WebKit does not support customized builtins." }[0..])) }
    if std.text.same(reactions, "NotNeeded") {
        p(out, "    CustomElementReactionDisallowedScope customElementReactionDisallowedScope;\n")
    } else {
        p(out, cat([_]Str{ "    CustomElementReactionStack customElementReactionStack(", stateVariable, ");\n" }[0..]))
    }
}

fn makeSharedSyntheticAttribute(name: Str, base: *Node) -> *Node {
    const shared = m.newNode(m.K_ATTRIBUTE)
    shared.*.name = name
    shared.*.ty = m.cloneType(base.*.ty.?)
    m.copyInto(shared.*.ext, base.*.ext)
    m.remove(shared.*.ext, "DelegateToSharedSyntheticAttribute")
    m.set(shared.*.ext, "IsSharedSyntheticAttribute", "1")
    return shared
}

pub fn addSharedSyntheticAttributesIfNeeded(interface: *Node) -> void {
    if m.exists(interface.*.ext, "SyntheticIDLAttributes") { return }
    var seen = r.map()
    const v = m.newValue(m.V_NODES, "")
    var index: usize = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        index += 1
        if on(attribute, "DelegateToSharedSyntheticAttribute") {
            const name = ext(attribute, "DelegateToSharedSyntheticAttribute")
            if !r.has(&seen, name) {
                r.set(&seen, name, 1)
                r.push(&v.*.items, @intFromPtr(makeSharedSyntheticAttribute(name, attribute)))
            }
        }
    }
    m.setValue(interface.*.ext, "SyntheticIDLAttributes", v)
}

// The attributes kept in SyntheticIDLAttributes.
pub fn syntheticAttributes(interface: *Node) -> r.List {
    const v = m.value(interface.*.ext, "SyntheticIDLAttributes")
    if v == null { return r.list() }
    return v.?.*.items
}

pub fn getSharedSyntheticAttribute(interface: *Node, attribute: *Node) -> *Node {
    const attributes = syntheticAttributes(interface)
    var index: usize = 0
    while index < attributes.count {
        const synthetic = m.node(attributes, index)
        if std.text.same(ext(attribute, "DelegateToSharedSyntheticAttribute"), synthetic.*.name) { return synthetic }
        index += 1
    }
    r.die("GetSharedSyntheticAttribute: none found")
    return attribute
}

pub fn toMethodName(param: Str) -> Str {
    if r.startsWith(param, "CSSOM") { return param }
    var ret = r.lcfirst(param)
    const pairs = [_]Str{ "cSS", "css", "dOM", "dom", "hTML", "html", "hDR", "hdr", "jS", "js", "uRL", "url", "xML", "xml", "xSLT", "xslt" }
    var index: usize = 0
    while index < pairs.length {
        if r.startsWith(ret, pairs[index]) { ret = r.replaceFirst(ret, pairs[index], pairs[index + 1]) }
        index += 2
    }
    if std.text.same(ret, "create") { ret = "isCreate" }
    if std.text.same(ret, "exclusive") { ret = "isExclusive" }
    return ret
}

fn generateRuntimeEnableConditionalStringForExposeScope(exposed: Str, context: *Node, globalObjectPtr: Str) -> Str {
    var wrapperType: Str = ""
    var sideCondition = r.undef()
    if std.text.same(exposed, "Window") {
        wrapperType = "JSDOMWindowBase"
    } else if std.text.same(exposed, "Worker") {
        wrapperType = "JSWorkerGlobalScopeBase"
    } else if std.text.same(exposed, "DedicatedWorker") {
        wrapperType = "JSDedicatedWorkerGlobalScope"
    } else if std.text.same(exposed, "SharedWorker") {
        wrapperType = "JSSharedWorkerGlobalScope"
    } else if std.text.same(exposed, "ServiceWorker") {
        wrapperType = "JSServiceWorkerGlobalScope"
    } else if std.text.same(exposed, "ShadowRealm") {
        wrapperType = "JSShadowRealmGlobalScopeBase"
    } else if std.text.same(exposed, "Worklet") {
        wrapperType = "JSWorkletGlobalScopeBase"
    } else if std.text.same(exposed, "AudioWorklet") {
        wrapperType = "JSWorkletGlobalScopeBase"
        sideCondition = "global->scriptExecutionContext()->isAudioWorkletGlobalScope()"
    } else {
        r.die(r.c3("Unrecognized value '", exposed, "' for the Exposed extended attribute"))
    }
    js.addToImplIncludes(r.c2(wrapperType, ".h"), "0")
    if r.isDef(sideCondition) { return cat([_]Str{ "([&] { auto* global = dynamicDowncast<", wrapperType, ">(", globalObjectPtr, "); return global && ", sideCondition, "; })()" }[0..]) }
    return cat([_]Str{ "(", globalObjectPtr, ")->inherits<", wrapperType, ">()" }[0..])
}

fn generateRuntimeEnableConditionalStringForExposed(interface: *Node, context: *Node, globalObjectPtr: Str, conjuncts: *StrList) -> void {
    if std.text.same(ext(context, "Exposed"), "VALUE_IS_MISSING") { r.die("Must specify value for Exposed.") }
    js.addToImplInclude("ScriptExecutionContext.h")
    const v = m.value(context.*.ext, "Exposed").?
    if std.text.same(m.textOf(v), "*") { return }
    if v.*.kind == m.V_IDS {
        var disjuncts = r.strList()
        var index: usize = 0
        while index < v.*.ids.count {
            r.spush(&disjuncts, generateRuntimeEnableConditionalStringForExposeScope(v.*.ids.items[index], context, globalObjectPtr))
            index += 1
        }
        r.spush(conjuncts, r.c3("(", r.sjoin(disjuncts, " || "), ")"))
    } else {
        r.spush(conjuncts, generateRuntimeEnableConditionalStringForExposeScope(m.textOf(v), context, globalObjectPtr))
    }
}

fn requireValue(context: *Node, name: Str) -> void {
    if std.text.same(ext(context, name), "VALUE_IS_MISSING") { r.die(r.c3("Must specify value for ", name, ".")) }
}

fn exposedOnlyToWindowCheck(interface: *Node, name: Str) -> void {
    if on(interface, "Exposed") && !std.text.same(ext(interface, "Exposed"), "Window") { r.die(r.c2(name, " can only be used by interfaces only exposed to the Window")) }
}

fn orJoined(parts: StrList) -> Str {
    const result = r.sjoin(parts, " || ")
    if parts.count > 1 { return r.c3("(", result, ")") }
    return result
}

pub fn generateRuntimeEnableConditionalString(interface: *Node, context: *Node, globalObjectPtr: Str, globalObjectPtrIsJSDOMGlobalObject: bool) -> Str {
    const expr = if globalObjectPtrIsJSDOMGlobalObject { globalObjectPtr } else { r.c3("uncheckedDowncast<JSDOMGlobalObject>(", globalObjectPtr, ")") }
    const isWindow = std.text.same(typeName(interface), "DOMWindow")
    if on(context, "CustomEnabledBy") {
        const className = r.c2("JS", typeName(interface))
        if std.text.same(ext(context, "CustomEnabledBy"), "VALUE_IS_MISSING") { r.die("Must specify value for EnabledForWorld.") }
        const method = toMethodName(ext(context, "CustomEnabledBy"))
        return cat([_]Str{ className, "::", method, "(", expr, "->scriptExecutionContext())" }[0..])
    }
    var conjuncts = r.strList()
    if on(context, "SecureContext") {
        js.addToImplInclude("ScriptExecutionContext.h")
        if on(context, "ContextAllowsMediaDevices") {
            r.spush(&conjuncts, cat([_]Str{ "(", expr, "->scriptExecutionContext()->isSecureContext()|| ", expr, "->scriptExecutionContext()->allowsMediaDevices())" }[0..]))
        } else if isWindow {
            r.spush(&conjuncts, "(scriptExecutionContext && scriptExecutionContext->isSecureContext())")
        } else {
            r.spush(&conjuncts, r.c2(expr, "->scriptExecutionContext()->isSecureContext()"))
        }
    }
    if on(context, "Exposed") { generateRuntimeEnableConditionalStringForExposed(interface, context, globalObjectPtr, &conjuncts) }
    if on(context, "EnabledForWorld") {
        requireValue(context, "EnabledForWorld")
        js.addToImplInclude("DOMWrapperWorld.h")
        r.spush(&conjuncts, cat([_]Str{ "worldForDOMObject(*", globalObjectPtr, ").", toMethodName(ext(context, "EnabledForWorld")), "()" }[0..]))
    }
    if on(context, "EnabledForGlobalObject") {
        requireValue(context, "EnabledForGlobalObject")
        js.addToImplInclude("DOMWrapperWorld.h")
        r.spush(&conjuncts, cat([_]Str{ expr, "->", toMethodName(ext(context, "EnabledForGlobalObject")), "()" }[0..]))
    }
    if on(context, "EnabledBySetting") {
        requireValue(context, "EnabledBySetting")
        const flags = r.splitByte(ext(context, "EnabledBySetting"), 38)
        const exposedToWindowOnly = on(interface, "Exposed") && std.text.same(ext(interface, "Exposed"), "Window")
        js.addToImplInclude(if exposedToWindowOnly { "DocumentSettingsValues.h" } else { "ScriptExecutionContext.h" })
        js.addToImplInclude("Settings.h")
        var f: usize = 0
        while f < flags.count {
            const orflags = r.splitByte(flags.items[f], 124)
            f += 1
            var orconjuncts = r.strList()
            var o: usize = 0
            while o < orflags.count {
                const method = toMethodName(orflags.items[o])
                o += 1
                if isWindow {
                    r.spush(&orconjuncts, cat([_]Str{ "(scriptExecutionContext && scriptExecutionContext->settingsValues().", method, ")" }[0..]))
                } else if exposedToWindowOnly {
                    r.spush(&orconjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->settingsValues().", method }[0..]))
                } else {
                    r.spush(&orconjuncts, cat([_]Str{ expr, "->scriptExecutionContext()->settingsValues().", method }[0..]))
                }
            }
            r.spush(&conjuncts, orJoined(orconjuncts))
        }
    }
    if on(context, "EnabledConditionallyReadWriteBySetting") {
        requireValue(context, "EnabledConditionallyReadWriteBySetting")
        js.addToImplInclude("Document.h")
        exposedOnlyToWindowCheck(interface, "EnabledConditionallyReadWriteBySetting")
        const flags = r.splitByte(ext(context, "EnabledConditionallyReadWriteBySetting"), 38)
        var f: usize = 0
        while f < flags.count {
            const orflags = r.splitByte(flags.items[f], 124)
            f += 1
            var orconjuncts = r.strList()
            var o: usize = 0
            while o < orflags.count {
                r.spush(&orconjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->settingsValues().", toMethodName(orflags.items[o]) }[0..]))
                o += 1
            }
            r.spush(&conjuncts, orJoined(orconjuncts))
        }
    }
    if on(context, "EnabledByQuirk") {
        requireValue(context, "EnabledByQuirk")
        js.addToImplInclude("DocumentQuirks.h")
        exposedOnlyToWindowCheck(interface, "EnabledByQuirk")
        const flags = r.splitByte(ext(context, "EnabledByQuirk"), 38)
        var f: usize = 0
        while f < flags.count {
            const method = toMethodName(flags.items[f])
            f += 1
            if isWindow {
                r.spush(&conjuncts, cat([_]Str{ "(scriptExecutionContext && downcast<Document>(scriptExecutionContext)->quirks().", method, "Quirk())" }[0..]))
            } else {
                r.spush(&conjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->quirks().", method, "Quirk()" }[0..]))
            }
        }
    }
    if on(context, "DisabledByQuirk") {
        requireValue(context, "DisabledByQuirk")
        js.addToImplInclude("DocumentQuirks.h")
        exposedOnlyToWindowCheck(interface, "DisabledByQuirk")
        const flags = r.splitByte(ext(context, "DisabledByQuirk"), 38)
        var f: usize = 0
        while f < flags.count {
            const method = toMethodName(flags.items[f])
            f += 1
            if isWindow {
                r.spush(&conjuncts, cat([_]Str{ "(!scriptExecutionContext || !downcast<Document>(scriptExecutionContext)->quirks().", method, "Quirk())" }[0..]))
            } else {
                r.spush(&conjuncts, cat([_]Str{ "!downcast<Document>(", expr, "->scriptExecutionContext())->quirks().", method, "Quirk()" }[0..]))
            }
        }
    }
    if on(context, "EnabledByDeprecatedGlobalSetting") {
        requireValue(context, "EnabledByDeprecatedGlobalSetting")
        js.addToImplInclude("DeprecatedGlobalSettings.h")
        const flags = r.splitByte(ext(context, "EnabledByDeprecatedGlobalSetting"), 38)
        var f: usize = 0
        while f < flags.count {
            r.spush(&conjuncts, cat([_]Str{ "DeprecatedGlobalSettings::", toMethodName(flags.items[f]), "()" }[0..]))
            f += 1
        }
    }
    if on(context, "EnabledForContext") {
        if !std.text.same(ext(context, "EnabledForContext"), "VALUE_IS_MISSING") { r.die("Must not specify value for EnabledForContext.") }
        if !cg.isConstructorType(context.*.ty.?) { r.die("EnabledForContext must be an interface or constructor attribute.") }
        const contextRef = cat([_]Str{ "*", expr, "->scriptExecutionContext()" }[0..])
        const name = context.*.name
        js.addToImplInclude(cat([_]Str{ "JS", name, ".h" }[0..]))
        r.spush(&conjuncts, cat([_]Str{ name, "::enabledForContext(", contextRef, ")" }[0..]))
    }
    if on(context, "LegacyFactoryFunctionEnabledBySetting") {
        requireValue(context, "LegacyFactoryFunctionEnabledBySetting")
        const settings = r.splitByte(ext(context, "LegacyFactoryFunctionEnabledBySetting"), 38)
        var f: usize = 0
        while f < settings.count {
            r.spush(&conjuncts, cat([_]Str{ "downcast<Document>(", expr, "->scriptExecutionContext())->settings().", toMethodName(settings.items[f]), "()" }[0..]))
            f += 1
        }
    }
    const result = r.sjoin(conjuncts, " && ")
    if conjuncts.count > 1 { return r.c3("(", result, ")") }
    return result
}

pub fn getCastingHelperForThisObject(interface: *Node) -> Str { return r.c3("dynamicDowncast<JS", typeName(interface), ">") }

pub fn addUnscopableProperties(interface: *Node) -> void {
    var unscopables = r.strList()
    const lists = [2]r.List{ interface.*.operations, interface.*.attributes }
    for l in lists {
        var index: usize = 0
        while index < l.count {
            const property = m.node(l, index)
            if on(property, "Unscopable") { r.spush(&unscopables, property.*.name) }
            index += 1
        }
    }
    if unscopables.count == 0 { return }
    js.addToImplInclude("<JavaScriptCore/ObjectConstructor.h>")
    p(js.implContent, "    JSObject& unscopables = *WebCore::constructEmptyObject(realm(), realm()->nullPrototypeObjectStructure());\n")
    var index: usize = 0
    while index < unscopables.count {
        p(js.implContent, cat([_]Str{ "    unscopables.putDirect(vm, Identifier::fromString(vm, \"", unscopables.items[index], "\"_s), jsBoolean(true));\n" }[0..]))
        index += 1
    }
    p(js.implContent, "    WebCore::putDirectWithoutTransition(this, vm, vm.propertyNames->unscopablesSymbol, &unscopables, JSC::PropertyAttribute::DontEnum | JSC::PropertyAttribute::ReadOnly);\n")
}

pub fn getArgumentTypeForFunctionWithoutTypeCheck(interface: *Node, ty: *IDLType) -> Str { return r.c3("DOMJIT::IDLJSArgumentType<", t.getIDLType(interface, ty), ">") }
pub fn getArgumentTypeFilter(interface: *Node, ty: *IDLType) -> Str { return r.c3("DOMJIT::IDLArgumentTypeFilter<", t.getIDLType(interface, ty), ">::value") }
pub fn getResultTypeFilter(interface: *Node, ty: *IDLType) -> Str { return r.c3("DOMJIT::IDLResultTypeFilter<", t.getIDLType(interface, ty), ">::value") }

pub fn getAttributeWithName(interface: *Node, name: Str) -> ?*Node {
    var index: usize = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        if std.text.same(attribute.*.name, name) { return attribute }
        index += 1
    }
    return null
}

pub fn interfaceNeedsIterator(interface: *Node) -> bool {
    if interface.*.setLike != null || interface.*.mapLike != null || interface.*.iterable != null { return true }
    if getIndexedGetterOperation(interface) != null {
        const length = getAttributeWithName(interface, "length")
        if length != null && cg.isIntegerType(length.?.*.ty.?) { return true }
    }
    return false
}

pub fn interfaceNeedsAsyncIterator(interface: *Node) -> bool { return interface.*.asyncIterable != null }

// ---------------------------------------------------------------------------
// Property tables.

pub const HashData = struct {
    keys: StrList
    // Each a *StrList of attributes.
    specials: r.List
    values1: StrList
    values2: StrList
    conditionals: r.Map
    readWriteConditionals: r.Map
    runtimeEnabledOperations: r.List
    runtimeEnabledAttributes: r.List
}

pub fn hashData() -> HashData {
    return HashData.{ .keys = r.strList(), .specials = r.list(), .values1 = r.strList(), .values2 = r.strList(), .conditionals = r.map(), .readWriteConditionals = r.map(), .runtimeEnabledOperations = r.list(), .runtimeEnabledAttributes = r.list() }
}

pub fn pushSpecials(l: *r.List, specials: StrList) -> void {
    const cell: *StrList = unsafe { @ptrFromInt(*StrList, r.alloc(@sizeOf(StrList))) }
    cell.* = specials
    r.push(l, @intFromPtr(cell))
}

pub fn generatePropertiesHashTable(interface: *Node, isInstance: bool, data: *HashData) -> usize {
    const interfaceName = typeName(interface)
    const className = r.c2("JS", interfaceName)
    var propertyCount = if isInstance { instancePropertyCount(interface) } else { prototypePropertyCount(interface) }
    if !isInstance && needsConstructorProperty(interface) {
        if propertyCount == 0 { r.die("Died") }
        r.spush(&data.*.keys, "constructor")
        r.spush(&data.*.values1, cat([_]Str{ "js", interfaceName, "Constructor" }[0..]))
        r.spush(&data.*.values2, "0")
        var specials = r.strList()
        r.spush(&specials, "PropertyAttribute::DontEnum")
        pushSpecials(&data.*.specials, specials)
    }
    if propertyCount == 0 { return 0 }
    var index: usize = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        index += 1
        if attribute.*.isStatic { continue }
        if attributeShouldBeOnInstance(interface, attribute) != isInstance { continue }
        if on(attribute, "PrivateIdentifier") && !on(attribute, "PublicIdentifier") { continue }
        if isInstance && needsRuntimeCheck(interface, attribute) {
            propertyCount -= 1
            continue
        }
        const name = attribute.*.name
        r.spush(&data.*.keys, name)
        pushSpecials(&data.*.specials, getJSCAttributesForAttribute(interface, attribute))
        if on(attribute, "DOMJIT") {
            r.spush(&data.*.values1, cat([_]Str{ "&DOMJITAttributeFor", interfaceName, cg.wkUcfirst(attribute.*.name) }[0..]))
        } else {
            r.spush(&data.*.values1, getAttributeGetterName(interface, className, attribute))
        }
        if js.isReadonly(attribute) || cg.isConstructorType(attribute.*.ty.?) {
            r.spush(&data.*.values2, "0")
        } else {
            r.spush(&data.*.values2, getAttributeSetterName(interface, className, attribute))
        }
        const conditional = ext(attribute, "Conditional")
        if r.truthy(conditional) { r.setStr(&data.*.conditionals, name, conditional) }
        const readWriteConditional = ext(attribute, "ConditionallyReadWrite")
        if r.truthy(readWriteConditional) { r.setStr(&data.*.readWriteConditionals, name, readWriteConditional) }
        const runtimeCheck = needsRuntimeCheck(interface, attribute)
        const readWriteCheck = needsRuntimeReadWriteCheck(interface, attribute)
        if runtimeCheck && readWriteCheck { r.die(cat([_]Str{ "Being both runtime enabled and runtime conditionally read-write is not yet supported (used on the '", name, "' attribute of '", interfaceName, "')." }[0..])) }
        if runtimeCheck || readWriteCheck { r.push(&data.*.runtimeEnabledAttributes, @intFromPtr(attribute)) }
    }
    index = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        index += 1
        if on(operation, "PrivateIdentifier") && !on(operation, "PublicIdentifier") { continue }
        if operation.*.isStatic { continue }
        if operation.*.overloadIndex > 1 { continue }
        if operationShouldBeOnInstance(interface, operation) != isInstance { continue }
        if std.text.same(operation.*.name, "[Symbol.Iterator]") || std.text.same(operation.*.name, "[Symbol.asyncIterator]") { continue }
        if isInstance && needsRuntimeCheck(interface, operation) {
            propertyCount -= 1
            continue
        }
        const name = operation.*.name
        r.spush(&data.*.keys, name)
        r.spush(&data.*.values1, getFunctionName(interface, className, operation))
        const functionLength = getFunctionLength(operation)
        if on(operation, "DOMJIT") {
            r.spush(&data.*.values2, cat([_]Str{ "&DOMJITSignatureFor", interfaceName, cg.wkUcfirst(operation.*.name) }[0..]))
        } else {
            r.spush(&data.*.values2, r.decimal(@intCast(u64, functionLength)))
        }
        pushSpecials(&data.*.specials, computeFunctionSpecial(interface, operation))
        const conditional = getConditionalForOperationConsideringOverloads(operation)
        if r.truthy(conditional) { r.setStr(&data.*.conditionals, name, conditional) }
        if needsRuntimeCheck(interface, operation) { r.push(&data.*.runtimeEnabledOperations, @intFromPtr(operation)) }
    }
    return propertyCount
}

pub fn getConditionalForOperationConsideringOverloads(operation: *Node) -> Str {
    if operation.*.overloads == null { return ext(operation, "Conditional") }
    var conditions = r.map()
    const overloads = operation.*.overloads.?.*
    var index: usize = 0
    while index < overloads.count {
        const conditional = ext(m.node(overloads, index), "Conditional")
        if !r.truthy(conditional) { return r.undef() }
        r.set(&conditions, conditional, 1)
        index += 1
    }
    return r.sjoin(r.keys(&conditions), "|")
}

pub fn getFunctionLength(operation: *Node) -> usize {
    var length = overloadLength(operation)
    if operation.*.overloads != null {
        const overloads = operation.*.overloads.?.*
        var index: usize = 0
        while index < overloads.count {
            const other = overloadLength(m.node(overloads, index))
            if other < length { length = other }
            index += 1
        }
    }
    return length
}

fn overloadLength(operation: *Node) -> usize {
    var length: usize = 0
    var index: usize = 0
    while index < operation.*.arguments.count {
        const argument = m.node(operation.*.arguments, index)
        if argument.*.isOptional || argument.*.isVariadic { break }
        length += 1
        index += 1
    }
    return length
}

pub fn lengthOfLongestOperationParameterList(overloads: r.List) -> usize {
    var result: usize = 0
    var index: usize = 0
    while index < overloads.count {
        const count = m.node(overloads, index).*.arguments.count
        if result < count { result = count }
        index += 1
    }
    return result
}

// ---------------------------------------------------------------------------
// Overload resolution.

const Tuple = struct {
    overload: *Node
    types: r.List
    optionality: StrList
}

fn addTuple(sets: *r.Map, overload: *Node, types: r.List, optionality: StrList) -> void {
    const tuple: *Tuple = unsafe { @ptrFromInt(*Tuple, r.alloc(@sizeOf(Tuple))) }
    tuple.* = Tuple.{ .overload = overload, .types = r.copyList(types), .optionality = r.scopy(optionality) }
    const key = r.decimal(@intCast(u64, types.count))
    if !r.has(sets, key) { r.set(sets, key, @intFromPtr(r.newList())) }
    const l: *r.List = unsafe { @ptrFromInt(*r.List, r.get(sets, key)) }
    r.push(l, @intFromPtr(tuple))
}

fn computeEffectiveOverloadSet(overloads: r.List) -> r.Map {
    var sets = r.map()
    const longest = lengthOfLongestOperationParameterList(overloads)
    var index: usize = 0
    while index < overloads.count {
        const overload = m.node(overloads, index)
        index += 1
        const n = overload.*.arguments.count
        var types = r.list()
        var optionality = r.strList()
        var isVariadic = false
        var a: usize = 0
        while a < n {
            const argument = m.node(overload.*.arguments, a)
            a += 1
            r.push(&types, @intFromPtr(argument.*.ty.?))
            if argument.*.isOptional {
                r.spush(&optionality, "optional")
            } else if argument.*.isVariadic {
                r.spush(&optionality, "variadic")
                isVariadic = true
            } else {
                r.spush(&optionality, "required")
            }
        }
        addTuple(&sets, overload, types, optionality)
        if isVariadic {
            var newTypes = r.copyList(types)
            var newOptionality = r.scopy(optionality)
            var i = n
            while i < longest {
                r.push(&newTypes, types.items[types.count - 1])
                r.spush(&newOptionality, "variadic")
                addTuple(&sets, overload, newTypes, newOptionality)
                i += 1
            }
        }
        var i = n
        while i > 0 {
            i -= 1
            const argument = m.node(overload.*.arguments, i)
            if !(argument.*.isOptional || argument.*.isVariadic) { break }
            types.count -= 1
            optionality.count -= 1
            addTuple(&sets, overload, types, optionality)
        }
    }
    return sets
}

fn isDistinguishableWithUnion(ty: *IDLType, unionSubtypes: r.List) -> bool {
    if ty.*.isUnion { r.die("First type should not be a union") }
    var index: usize = 0
    while index < unionSubtypes.count {
        if !areTypesDistinguishable(ty, r.at(*IDLType, unionSubtypes, index)) { return false }
        index += 1
    }
    return true
}

fn areTypesDistinguishable(a: *IDLType, b: *IDLType) -> bool {
    if a.*.isNullable && b.*.isNullable { return false }
    if a.*.isUnion && b.*.isUnion {
        var index: usize = 0
        while index < a.*.subtypes.count {
            if !isDistinguishableWithUnion(m.subtype(a, index), b.*.subtypes) { return false }
            index += 1
        }
        return true
    } else if a.*.isUnion {
        return isDistinguishableWithUnion(b, a.*.subtypes)
    } else if b.*.isUnion {
        return isDistinguishableWithUnion(a, b.*.subtypes)
    }
    if std.text.same(a.*.name, b.*.name) { return false }
    if std.text.same(a.*.name, "object") || std.text.same(b.*.name, "object") { return false }
    if cg.isNumericType(a) && cg.isNumericType(b) { return false }
    if cg.isStringOrEnumType(a) && cg.isStringOrEnumType(b) { return false }
    if cg.isDictionaryType(a) && cg.isDictionaryType(b) { return false }
    if cg.isCallbackInterface(a) && cg.isCallbackInterface(b) { return false }
    if cg.isCallbackFunction(a) && cg.isCallbackFunction(b) { return false }
    if cg.isSequenceOrFrozenArrayType(a) && cg.isSequenceOrFrozenArrayType(b) { return false }
    return true
}

fn tupleAt(s: r.List, index: usize) -> *Tuple { return r.at(*Tuple, s, index) }

fn getDistinguishingArgumentIndex(operation: *Node, s: r.List) -> usize {
    const first = tupleAt(s, 0).*.types
    const second = tupleAt(s, 1).*.types
    var index: usize = 0
    while index < first.count {
        if areTypesDistinguishable(r.at(*IDLType, first, index), r.at(*IDLType, second, index)) { return index }
        index += 1
    }
    r.die(cat([_]Str{ "Undistinguishable overloads for operation ", operation.*.name, " with length: ", r.decimal(@intCast(u64, first.count)) }[0..]))
    return 0
}

const IS_OPTIONAL: u8 = 0
const IS_NULLABLE_OR_DICTIONARY_OR_RECORD_OR_UNION_CONTAINING_ONE: u8 = 1
const IS_OBJECT_OR_ERROR: u8 = 2
const IS_OBJECT_OR_ERROR_OR_DOMEXCEPTION: u8 = 3
const IS_OBJECT_OR_CALLBACK_FUNCTION: u8 = 4
const IS_SEQUENCE_OR_FROZEN_ARRAY: u8 = 5
const IS_DICTIONARY_OR_RECORD_OR_OBJECT_OR_CALLBACK_INTERFACE: u8 = 6
const IS_BOOLEAN: u8 = 7
const IS_NUMERIC: u8 = 8
const IS_STRING_OR_ENUM: u8 = 9
const IS_ANY: u8 = 10

fn isDictionaryOrRecord(ty: *IDLType) -> bool { return cg.isDictionaryType(ty) || cg.isRecordType(ty) }

fn matches(kind: u8, ty: *IDLType, optionality: Str) -> bool {
    if kind == IS_OPTIONAL { return std.text.same(optionality, "optional") }
    if kind == IS_NULLABLE_OR_DICTIONARY_OR_RECORD_OR_UNION_CONTAINING_ONE {
        if ty.*.isNullable { return true }
        if ty.*.isUnion {
            const members = t.getFlattenedMemberTypes(ty)
            var index: usize = 0
            while index < members.count {
                if ty.*.isNullable || isDictionaryOrRecord(r.at(*IDLType, members, index)) { return true }
                index += 1
            }
            return false
        }
        return isDictionaryOrRecord(ty)
    }
    if kind == IS_OBJECT_OR_ERROR { return std.text.same(ty.*.name, "object") || std.text.same(ty.*.name, "Error") }
    if kind == IS_OBJECT_OR_ERROR_OR_DOMEXCEPTION { return std.text.same(ty.*.name, "object") || std.text.same(ty.*.name, "Error") || std.text.same(ty.*.name, "DOMException") }
    if kind == IS_OBJECT_OR_CALLBACK_FUNCTION { return std.text.same(ty.*.name, "object") || cg.isCallbackFunction(ty) }
    if kind == IS_SEQUENCE_OR_FROZEN_ARRAY { return cg.isSequenceOrFrozenArrayType(ty) }
    if kind == IS_DICTIONARY_OR_RECORD_OR_OBJECT_OR_CALLBACK_INTERFACE {
        if isDictionaryOrRecord(ty) { return true }
        if std.text.same(ty.*.name, "object") { return true }
        if cg.isCallbackInterface(ty) && !cg.isCallbackFunction(ty) { return true }
        return false
    }
    if kind == IS_BOOLEAN { return std.text.same(ty.*.name, "boolean") }
    if kind == IS_NUMERIC { return cg.isNumericType(ty) }
    if kind == IS_STRING_OR_ENUM { return cg.isStringOrEnumType(ty) }
    return std.text.same(ty.*.name, "any")
}

fn getOverloadThatMatches(s: r.List, parameterIndex: usize, kind: u8) -> ?*Node {
    var index: usize = 0
    while index < s.count {
        const tuple = tupleAt(s, index)
        index += 1
        const ty = r.at(*IDLType, tuple.*.types, parameterIndex)
        const optionality = tuple.*.optionality.items[parameterIndex]
        if ty.*.isUnion {
            const members = t.getFlattenedMemberTypes(ty)
            var k: usize = 0
            while k < members.count {
                if matches(kind, r.at(*IDLType, members, k), optionality) { return tuple.*.overload }
                k += 1
            }
        } else if matches(kind, ty, optionality) {
            return tuple.*.overload
        }
    }
    return null
}

fn getOverloadThatMatchesIgnoringUnionSubtypes(s: r.List, parameterIndex: usize, kind: u8) -> ?*Node {
    var index: usize = 0
    while index < s.count {
        const tuple = tupleAt(s, index)
        index += 1
        const ty = r.at(*IDLType, tuple.*.types, parameterIndex)
        if matches(kind, ty, tuple.*.optionality.items[parameterIndex]) { return tuple.*.overload }
    }
    return null
}

fn generateOverloadCallIfNecessary(overload: ?*Node, condition: Str, conditionCanThrow: bool, include: Str, prefix: Str, suffix: Str, parameters: Str) -> void {
    if overload == null { return }
    const o = overload.?
    const out = js.implContent
    const conditionalString = cg.generateConditionalString(o.*.ext)
    if r.truthy(conditionalString) { p(out, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
    const call = cat([_]Str{ "RELEASE_AND_RETURN(throwScope, (", prefix, r.decimal(@intCast(u64, o.*.overloadIndex)), suffix, "(", parameters, ")));\n" }[0..])
    if r.truthy(condition) && conditionCanThrow {
        p(out, "        {\n")
        p(out, cat([_]Str{ "            bool success = ", condition, ";\n" }[0..]))
        p(out, "            RETURN_IF_EXCEPTION(throwScope, { });\n")
        p(out, "            if (success)\n")
        p(out, r.c2("                ", call))
        p(out, "        }\n")
    } else if r.truthy(condition) {
        p(out, cat([_]Str{ "        if (", condition, ")\n" }[0..]))
        p(out, r.c2("            ", call))
    } else {
        p(out, r.c2("        ", call))
    }
    if r.truthy(conditionalString) { p(out, "#endif\n") }
    if r.truthy(include) { js.addToImplIncludes(include, ext(o, "Conditional")) }
}

pub fn generateOverloadDispatcher(operation: *Node, interface: *Node, prefix: Str, suffix: Str, parameters: Str) -> void {
    const overloads = operation.*.overloads.?.*
    var sets = computeEffectiveOverloadSet(overloads)
    const out = js.implContent
    const maxArgCount = lengthOfLongestOperationParameterList(overloads)
    p(out, cat([_]Str{ "    size_t argsCount = std::min<size_t>(", r.decimal(@intCast(u64, maxArgCount)), ", callFrame->argumentCount());\n" }[0..]))
    const lengths = r.sortedKeys(&sets)
    var li: usize = 0
    while li < lengths.count {
        const length = lengths.items[li]
        li += 1
        p(out, cat([_]Str{ "    if (argsCount == ", length, ") {\n" }[0..]))
        const sp: *r.List = unsafe { @ptrFromInt(*r.List, r.get(&sets, length)) }
        const s = sp.*
        if s.count > 1 {
            const di = getDistinguishingArgumentIndex(operation, s)
            p(out, cat([_]Str{ "        JSValue distinguishingArg = callFrame->uncheckedArgument(", r.decimal(@intCast(u64, di)), ");\n" }[0..]))
            generateOverloadCallIfNecessary(getOverloadThatMatchesIgnoringUnionSubtypes(s, di, IS_OPTIONAL), "distinguishingArg.isUndefined()", false, "", prefix, suffix, parameters)
            generateOverloadCallIfNecessary(getOverloadThatMatchesIgnoringUnionSubtypes(s, di, IS_NULLABLE_OR_DICTIONARY_OR_RECORD_OR_UNION_CONTAINING_ONE), "distinguishingArg.isUndefinedOrNull()", false, "", prefix, suffix, parameters)
            var k: usize = 0
            while k < s.count {
                const tuple = tupleAt(s, k)
                k += 1
                const ty = r.at(*IDLType, tuple.*.types, di)
                var subtypes = r.list()
                if ty.*.isUnion { subtypes = t.getFlattenedMemberTypes(ty) } else { r.push(&subtypes, @intFromPtr(ty)) }
                var q: usize = 0
                while q < subtypes.count {
                    const subtype = r.at(*IDLType, subtypes, q)
                    q += 1
                    if cg.isWrapperType(subtype) || cg.isBufferSourceType(subtype) {
                        if std.text.same(subtype.*.name, "DOMWindow") {
                            js.addToImplInclude("JSWindowProxy.h")
                            generateOverloadCallIfNecessary(tuple.*.overload, "distinguishingArg.isObject() && (asObject(distinguishingArg)->inherits<JSWindowProxy>() || asObject(distinguishingArg)->inherits<JSDOMWindow>())", false, "", prefix, suffix, parameters)
                        } else {
                            generateOverloadCallIfNecessary(tuple.*.overload, cat([_]Str{ "distinguishingArg.isObject() && asObject(distinguishingArg)->inherits<JS", subtype.*.name, ">()" }[0..]), false, "", prefix, suffix, parameters)
                        }
                    }
                }
            }
            generateOverloadCallIfNecessary(getOverloadThatMatches(s, di, IS_OBJECT_OR_ERROR_OR_DOMEXCEPTION), "distinguishingArg.isObject() && asObject(distinguishingArg)->inherits<JSDOMException>()", false, "", prefix, suffix, parameters)
            generateOverloadCallIfNecessary(getOverloadThatMatches(s, di, IS_OBJECT_OR_ERROR), "distinguishingArg.isObject() && asObject(distinguishingArg)->type() == ErrorInstanceType", false, "", prefix, suffix, parameters)
            generateOverloadCallIfNecessary(getOverloadThatMatches(s, di, IS_OBJECT_OR_CALLBACK_FUNCTION), "distinguishingArg.isCallable()", false, "", prefix, suffix, parameters)
            generateOverloadCallIfNecessary(getOverloadThatMatches(s, di, IS_SEQUENCE_OR_FROZEN_ARRAY), "WebCore::hasIteratorMethod(lexicalGlobalObject, distinguishingArg)", true, "JSDOMBindingFacade.h", prefix, suffix, parameters)
            generateOverloadCallIfNecessary(getOverloadThatMatches(s, di, IS_DICTIONARY_OR_RECORD_OR_OBJECT_OR_CALLBACK_INTERFACE), "distinguishingArg.isObject()", false, "", prefix, suffix, parameters)
            const booleanOverload = getOverloadThatMatches(s, di, IS_BOOLEAN)
            generateOverloadCallIfNecessary(booleanOverload, "distinguishingArg.isBoolean()", false, "", prefix, suffix, parameters)
            const numericOverload = getOverloadThatMatches(s, di, IS_NUMERIC)
            generateOverloadCallIfNecessary(numericOverload, "distinguishingArg.isNumber()", false, "", prefix, suffix, parameters)
            const stringOverload = getOverloadThatMatches(s, di, IS_STRING_OR_ENUM)
            if stringOverload != null {
                generateOverloadCallIfNecessary(stringOverload, r.undef(), false, "", prefix, suffix, parameters)
            } else if numericOverload != null {
                generateOverloadCallIfNecessary(numericOverload, r.undef(), false, "", prefix, suffix, parameters)
            } else if booleanOverload != null {
                generateOverloadCallIfNecessary(booleanOverload, r.undef(), false, "", prefix, suffix, parameters)
            } else {
                generateOverloadCallIfNecessary(getOverloadThatMatches(s, di, IS_ANY), r.undef(), false, "", prefix, suffix, parameters)
            }
        } else {
            generateOverloadCallIfNecessary(tupleAt(s, 0).*.overload, r.undef(), false, "", prefix, suffix, parameters)
        }
        p(out, "    }\n")
    }
    const minArgCount = getFunctionLength(operation)
    if minArgCount > 0 {
        p(out, cat([_]Str{ "    return argsCount < ", r.decimal(@intCast(u64, minArgCount)), " ? throwVMError(lexicalGlobalObject, throwScope, createNotEnoughArgumentsError(lexicalGlobalObject)) : throwVMTypeError(lexicalGlobalObject, throwScope);\n" }[0..]))
    } else {
        p(out, "    return throwVMTypeError(lexicalGlobalObject, throwScope);\n")
    }
}

// ---------------------------------------------------------------------------
// Virtual tables.

pub fn getGnuVTableRefForInterface(interface: *Node) -> Str {
    const vtableName = getGnuVTableNameForInterface(interface)
    if !r.truthy(vtableName) { return "0" }
    const offset = if std.text.same(typeName(interface), "ApplePaySession") { "3" } else { "2" }
    return cat([_]Str{ "&", vtableName, "[", offset, "]" }[0..])
}

pub fn getGnuVTableNameForInterface(interface: *Node) -> Str {
    const name = typeName(interface)
    if r.hasByte(name, 60) { return "" }
    if getSkipVTableValidationForInterface(interface) { return "" }
    return r.c2("_ZTV", getGnuMangledNameForInterface(interface))
}

pub fn getGnuMangledNameForInterface(interface: *Node) -> Str {
    const name = typeName(interface)
    if r.hasByte(name, 60) { return "" }
    return cat([_]Str{ "N7WebCore", r.decimal(@intCast(u64, name.length)), name, "E" }[0..])
}

pub fn getWinVTableRefForInterface(interface: *Node) -> Str {
    const vtableName = getWinVTableNameForInterface(interface)
    if !r.truthy(vtableName) { return "0" }
    return cat([_]Str{ "__identifier(\"", vtableName, "\")" }[0..])
}

pub fn getWinVTableNameForInterface(interface: *Node) -> Str {
    const name = typeName(interface)
    if r.hasByte(name, 60) { return "" }
    if getSkipVTableValidationForInterface(interface) { return "" }
    return cat([_]Str{ "??_7", name, "@WebCore@@", "6B@" }[0..])
}

pub fn getSkipVTableValidationForInterface(interface: *Node) -> bool { return on(interface, "SkipVTableValidation") }
pub fn hasTaggedWrapperForInterface(interface: *Node) -> bool { return on(interface, "TaggedWrapper") }

// ---------------------------------------------------------------------------
// Hash tables.

fn ceilingToPowerOf2(size: usize) -> usize {
    var power: usize = 1
    while size > power { power <<= 1 }
    return power
}

fn generateHashTableValueArray(keys: StrList, specials: r.List, values1: StrList, values2: StrList, conditionals: ?*r.Map, readWriteConditionals: ?*r.Map, nameEntries: Str) -> Str {
    var b = r.buf()
    const packedSize = keys.count
    const arraySize = if packedSize == 0 { 1 } else { packedSize }
    r.add(&b, cat([_]Str{ "\nstatic const std::array<HashTableValue, ", r.decimal(@intCast(u64, arraySize)), "> ", nameEntries, " {\n" }[0..]))
    var i: usize = 0
    while i < keys.count {
        const key = keys.items[i]
        var conditional = r.undef()
        if conditionals != null { conditional = r.getStr(conditionals.?, key) }
        if r.truthy(conditional) { r.add(&b, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(conditional), "\n" }[0..])) }
        const special: *StrList = unsafe { @ptrFromInt(*StrList, specials.items[i]) }
        const jscAttributes = stringifyJSCAttributes(special.*)
        var typeTag: Str = "GetterSetter"
        if r.contains(jscAttributes, "DOMJITFunction") {
            typeTag = "DOMJITFunction"
        } else if r.contains(jscAttributes, "Function") {
            typeTag = "NativeFunction"
        } else if r.contains(jscAttributes, "Builtin") {
            typeTag = if r.contains(jscAttributes, "Accessor") { "BuiltinAccessor" } else { "BuiltinGenerator" }
        } else if r.contains(jscAttributes, "ConstantInteger") {
            typeTag = "Constant"
        } else if r.contains(jscAttributes, "DOMJITAttribute") {
            typeTag = "DOMJITAttribute"
        }
        var readWriteConditional = r.undef()
        if readWriteConditionals != null { readWriteConditional = r.getStr(readWriteConditionals.?, key) }
        if r.truthy(readWriteConditional) { r.add(&b, cat([_]Str{ "#if ", cg.generateConditionalStringFromAttributeValue(readWriteConditional), "\n" }[0..])) }
        const hasSecondValue = !std.text.same(typeTag, "Constant")
        const secondValue = if hasSecondValue { r.c2(", ", values2.items[i]) } else { "" }
        r.add(&b, cat([_]Str{ "    HashTableValue { \"", key, "\"_s, ", jscAttributes, ", NoIntrinsic, { HashTableValue::", typeTag, "Type, ", values1.items[i], secondValue, " } },\n" }[0..]))
        if r.truthy(readWriteConditional) {
            r.add(&b, "#else\n")
            const zero = if hasSecondValue { ", 0" } else { "" }
            r.spush(special, "PropertyAttribute::ReadOnly")
            r.add(&b, cat([_]Str{ "    HashTableValue { \"", key, "\"_s, ", stringifyJSCAttributes(special.*), ", NoIntrinsic, { HashTableValue::", typeTag, "Type, ", values1.items[i], zero, " } },\n" }[0..]))
            r.add(&b, "#endif\n")
        }
        if r.truthy(conditional) {
            r.add(&b, "#else\n")
            r.add(&b, "    HashTableValue { { }, 0, NoIntrinsic, { HashTableValue::End } },\n")
            r.add(&b, "#endif\n")
        }
        i += 1
    }
    if packedSize == 0 { r.add(&b, "    HashTableValue { { }, 0, NoIntrinsic, { HashTableValue::End } }\n") }
    r.add(&b, "};\n\n")
    return r.done(b)
}

pub fn generateHashTable(className: Str, name: Str, size: usize, keys: StrList, specials: r.List, values1: StrList, values2: StrList, conditionals: ?*r.Map, readWriteConditionals: ?*r.Map, justGenerateValueArray: bool) -> void {
    const nameEntries = r.replaceAll(r.c2(name, "Values"), ":", "_")
    const nameIndex = r.replaceAll(r.c2(name, "Index"), ":", "_")
    const out = js.implContent
    if r.contains(name, "Prototype") {
        p(out, "/* Hash table for prototype */\n")
    } else if r.contains(name, "Constructor") {
        p(out, "/* Hash table for constructor */\n")
    } else {
        p(out, "/* Hash table */\n")
    }
    if justGenerateValueArray {
        if size > 0 { p(out, generateHashTableValueArray(keys, specials, values1, values2, conditionals, readWriteConditionals, nameEntries)) }
        return
    }
    var compactSize = ceilingToPowerOf2(size * 2)
    const numEntries = compactSize
    var table = r.map()
    var links = r.map()
    var i: usize = 0
    while i < keys.count {
        var h = @intCast(usize, rapidhashOf(keys.items[i]) % @intCast(u64, numEntries))
        while r.has(&table, r.decimal(@intCast(u64, h))) {
            const hk = r.decimal(@intCast(u64, h))
            if r.has(&links, hk) {
                h = r.get(&links, hk)
            } else {
                r.set(&links, hk, compactSize)
                h = compactSize
                compactSize += 1
            }
        }
        r.set(&table, r.decimal(@intCast(u64, h)), i)
        i += 1
    }
    var b = r.buf()
    r.add(&b, cat([_]Str{ "\nstatic const struct CompactHashIndex ", nameIndex, "[", r.decimal(@intCast(u64, compactSize)), "] = {\n" }[0..]))
    i = 0
    while i < compactSize {
        const k = r.decimal(@intCast(u64, i))
        const tv = if r.has(&table, k) { r.decimal(@intCast(u64, r.get(&table, k))) } else { "-1" }
        const lv = if r.has(&links, k) { r.decimal(@intCast(u64, r.get(&links, k))) } else { "-1" }
        r.add(&b, cat([_]Str{ "    { ", tv, ", ", lv, " },\n" }[0..]))
        i += 1
    }
    r.add(&b, "};\n\n")
    r.add(&b, generateHashTableValueArray(keys, specials, values1, values2, conditionals, readWriteConditionals, nameEntries))
    var seen = r.map()
    i = 0
    while i < specials.count {
        const special: *StrList = unsafe { @ptrFromInt(*StrList, specials.items[i]) }
        var k: usize = 0
        while k < special.*.count {
            r.set(&seen, special.*.items[k], 1)
            k += 1
        }
        i += 1
    }
    const seenAttributes = r.sortedKeys(&seen)
    const seenString = r.c3("static_cast<uint8_t>(", stringifyJSCAttributes(seenAttributes), ")")
    r.add(&b, cat([_]Str{ "static const HashTable ", name, " = { ", r.decimal(@intCast(u64, keys.count)), ", ", r.decimal(@intCast(u64, numEntries - 1)), ", ", seenString, ", ", className, "::info(), ", nameEntries, ".data(), ", nameIndex, " };\n" }[0..]))
    p(out, r.done(b))
}

fn rapidhashOf(key: Str) -> u64 { return rh.hash(key) }

// ---------------------------------------------------------------------------
// Prototypes and constructors.

pub fn generatePrototypeDeclaration(out: *StrList, className: Str, interface: *Node) -> void {
    if js.shouldUseOrdinaryObjectPrototype(interface) { return }
    const prototypeClassName = r.c2(className, "Prototype")
    var structureFlags = r.map()
    p(out, cat([_]Str{ "class ", prototypeClassName, " final : public JSC::JSNonFinalObject {\n" }[0..]))
    p(out, "public:\n")
    p(out, "    using Base = JSC::JSNonFinalObject;\n")
    p(out, cat([_]Str{ "    static ", prototypeClassName, "* create(JSC::VM& vm, JSDOMGlobalObject* globalObject, JSC::Structure* structure)\n" }[0..]))
    p(out, "    {\n")
    p(out, cat([_]Str{ "        ", className, "Prototype* ptr = new (NotNull, JSC::allocateCell<", className, "Prototype>(vm)) ", className, "Prototype(vm, globalObject, structure);\n" }[0..]))
    p(out, "        ptr->finishCreation(vm);\n")
    p(out, "        return ptr;\n")
    p(out, "    }\n\n")
    p(out, "    DECLARE_INFO;\n")
    p(out, "    template<typename CellType, JSC::SubspaceAccess>\n")
    p(out, "    static JSC::GCClient::IsoSubspace* subspaceFor(JSC::VM& vm)\n")
    p(out, "    {\n")
    p(out, cat([_]Str{ "        STATIC_ASSERT_ISO_SUBSPACE_SHARABLE(", prototypeClassName, ", Base);\n" }[0..]))
    p(out, "        return &vm.plainObjectSpace();\n")
    p(out, "    }\n")
    p(out, "    static JSC::Structure* createStructure(JSC::VM&, JSC::JSGlobalObject*, JSC::JSValue);\n")
    p(out, "\nprivate:\n")
    p(out, cat([_]Str{ "    ", prototypeClassName, "(JSC::VM& vm, JSC::JSGlobalObject*, JSC::Structure* structure)\n" }[0..]))
    p(out, "        : JSC::JSNonFinalObject(vm, structure)\n")
    p(out, "    {\n")
    p(out, "    }\n")
    p(out, "\n")
    p(out, "    void finishCreation(JSC::VM&);\n")
    if !js.shouldUseOrdinaryObjectPrototype(interface) && js.isDOMGlobalObject(interface) { r.set(&structureFlags, "JSC::HasStaticPropertyTable", 1) }
    if on(interface, "IsImmutablePrototypeExoticObjectOnPrototype") { r.set(&structureFlags, "JSC::IsImmutablePrototypeExoticObject", 1) }
    if structureFlags.size > 0 {
        p(out, "public:\n")
        p(out, "    static constexpr unsigned StructureFlags = Base::StructureFlags")
        const flags = r.sortedKeys(&structureFlags)
        var index: usize = 0
        while index < flags.count {
            p(out, r.c2(" | ", flags.items[index]))
            index += 1
        }
        p(out, ";\n")
    }
    p(out, "};\n")
    p(out, cat([_]Str{ "STATIC_ASSERT_ISO_SUBSPACE_SHARABLE(", prototypeClassName, ", ", prototypeClassName, "::Base);\n\n" }[0..]))
}

pub fn getConstructorTemplateClassName(interface: *Node) -> Str {
    if hasJSBuiltinConstructor(interface) { return "JSDOMBuiltinConstructor" }
    if interface.*.isNamespaceObject { return "JSDOMConstructorNotCallable" }
    if on(interface, "LegacyFactoryFunction") { return "JSDOMConstructorNotConstructable" }
    if !isConstructable(interface) { return "JSDOMConstructorNotConstructable" }
    return "JSDOMConstructor"
}

pub fn generateConstructorDeclaration(out: *StrList, className: Str, interface: *Node, unused: Str) -> void {
    const interfaceName = typeName(interface)
    const constructorClassName = r.c2(className, "DOMConstructor")
    const templateClassName = getConstructorTemplateClassName(interface)
    js.addToImplInclude(r.c2(templateClassName, ".h"))
    if on(interface, "LegacyFactoryFunction") { js.addToImplInclude("JSDOMLegacyFactoryFunction.h") }
    p(out, cat([_]Str{ "using ", constructorClassName, " = ", templateClassName, "<", className, ">;\n" }[0..]))
    if on(interface, "LegacyFactoryFunction") { p(out, cat([_]Str{ "using JS", interfaceName, "LegacyFactoryFunction = JSDOMLegacyFactoryFunction<", className, ">;\n" }[0..])) }
    p(out, "\n")
}

pub fn generateConstructorDefinitions(out: *StrList, className: Str, protoClassName: Str, visibleInterfaceName: Str, interface: *Node, generatingLegacyFactoryFunction: bool) -> void {
    if isConstructable(interface) {
        const constructors = interface.*.constructors
        if constructors.count > 1 {
            var index: usize = 0
            while index < constructors.count {
                generateConstructorDefinition(out, className, protoClassName, visibleInterfaceName, interface, generatingLegacyFactoryFunction, m.node(constructors, index))
                index += 1
            }
            const impl = js.implContent
            p(impl, cat([_]Str{ "template<> EncodedJSValue JSC_HOST_CALL_ATTRIBUTES ", className, "DOMConstructor::construct(JSGlobalObject* lexicalGlobalObject, CallFrame* callFrame)\n" }[0..]))
            p(impl, "{\n")
            p(impl, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = lexicalGlobalObject->vm();\n")
            p(impl, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
            p(impl, "    UNUSED_PARAM(throwScope);\n")
            generateOverloadDispatcher(m.node(constructors, 0), interface, r.c2("construct", className), "", "lexicalGlobalObject, callFrame")
            p(impl, "}\n")
            p(impl, cat([_]Str{ "JSC_ANNOTATE_HOST_FUNCTION(", className, "ConstructorConstruct, ", className, "DOMConstructor::construct);\n\n" }[0..]))
        } else if constructors.count == 1 {
            generateConstructorDefinition(out, className, protoClassName, visibleInterfaceName, interface, generatingLegacyFactoryFunction, m.node(constructors, 0))
        }
    }
    generateConstructorHelperMethods(out, className, protoClassName, visibleInterfaceName, interface, generatingLegacyFactoryFunction)
}

pub fn generateConstructorDefinition(out: *StrList, className: Str, protoClassName: Str, visibleInterfaceName: Str, interface: *Node, generatingLegacyFactoryFunction: bool, operation: *Node) -> void {
    if hasJSBuiltinConstructor(interface) { return }
    const constructorClassName = if generatingLegacyFactoryFunction { r.c2(className, "LegacyFactoryFunction") } else { r.c2(className, "DOMConstructor") }
    if !isConstructable(interface) { return }
    if hasCustomConstructor(interface) {
        p(out, cat([_]Str{ "template<> JSC::EncodedJSValue JSC_HOST_CALL_ATTRIBUTES ", constructorClassName, "::construct(JSC::JSGlobalObject* lexicalGlobalObject, JSC::CallFrame* callFrame)\n" }[0..]))
        p(out, "{\n")
        p(out, "    ASSERT(callFrame);\n")
        p(out, cat([_]Str{ "    return construct", className, "(lexicalGlobalObject, *callFrame);\n" }[0..]))
        p(out, "}\n")
        p(js.implContent, cat([_]Str{ "JSC_ANNOTATE_HOST_FUNCTION(", constructorClassName, "Construct, ", constructorClassName, "::construct);\n\n" }[0..]))
        return
    }
    if on(interface, "LegacyFactoryFunction") && !generatingLegacyFactoryFunction { return }
    const isOverloaded = operation.*.overloads != null && operation.*.overloads.?.*.count > 1
    if isOverloaded {
        p(out, cat([_]Str{ "static inline EncodedJSValue construct", className, r.decimal(@intCast(u64, operation.*.overloadIndex)), "(JSGlobalObject* lexicalGlobalObject, CallFrame* callFrame)\n" }[0..]))
    } else {
        p(out, cat([_]Str{ "template<> EncodedJSValue JSC_HOST_CALL_ATTRIBUTES ", constructorClassName, "::construct(JSGlobalObject* lexicalGlobalObject, CallFrame* callFrame)\n" }[0..]))
    }
    p(out, "{\n")
    p(out, "    SUPPRESS_UNCOUNTED_LOCAL auto& vm = lexicalGlobalObject->vm();\n")
    p(out, "    auto throwScope = DECLARE_THROW_SCOPE(vm);\n")
    p(out, cat([_]Str{ "    auto* castedThis = uncheckedDowncast<", constructorClassName, ">(callFrame->jsCallee());\n" }[0..]))
    p(out, "    ASSERT(castedThis);\n")
    if on(operation, "EnabledBySetting") {
        const condition = generateRuntimeEnableConditionalString(interface, operation, "lexicalGlobalObject", false)
        p(out, cat([_]Str{ "    if (!", condition, ") {\n" }[0..]))
        p(out, "        throwTypeError(lexicalGlobalObject, throwScope, \"Illegal constructor\"_s);\n")
        p(out, "        return JSValue::encode(jsNull());\n")
        p(out, "    }\n")
    }
    im.generateArgumentsCountCheck(out, operation, interface, "    ")
    const functionImplementationName = if generatingLegacyFactoryFunction { "createForLegacyFactoryFunction" } else { "create" }
    const functionString = im.generateOperationParametersCheck(out, operation, interface, functionImplementationName, "    ")
    p(out, cat([_]Str{ "    auto object = ", functionString, ";\n" }[0..]))
    p(out, "    if constexpr (IsExceptionOr<decltype(object)>)\n")
    p(out, "        RETURN_IF_EXCEPTION(throwScope, { });\n")
    p(out, "    static_assert(TypeOrExceptionOrUnderlyingType<decltype(object)>::isRef);\n")
    const idlType = t.getIDLType(interface, interface.*.ty.?)
    const implType = getImplClassName(interface)
    js.addToImplInclude("JSDOMConvertInterface.h")
    p(out, cat([_]Str{ "    auto jsValue = toJSNewlyCreated<", idlType, ">(*lexicalGlobalObject, *castedThis->realm(), throwScope, WTF::move(object));\n" }[0..]))
    p(out, "    if constexpr (IsExceptionOr<decltype(object)>)\n")
    p(out, "        RETURN_IF_EXCEPTION(throwScope, { });\n")
    p(out, cat([_]Str{ "    setSubclassStructureIfNeeded<", implType, ">(lexicalGlobalObject, callFrame, asObject(jsValue));\n" }[0..]))
    p(out, "    RETURN_IF_EXCEPTION(throwScope, { });\n")
    p(out, "    return JSValue::encode(jsValue);\n")
    p(out, "}\n")
    if !isOverloaded { p(out, cat([_]Str{ "JSC_ANNOTATE_HOST_FUNCTION(", constructorClassName, "Construct, ", constructorClassName, "::construct);\n" }[0..])) }
    p(out, "\n")
}

fn constructorHasProperties(interface: *Node) -> bool {
    if interface.*.constants.count > 0 { return true }
    var index: usize = 0
    while index < interface.*.attributes.count {
        if m.node(interface.*.attributes, index).*.isStatic { return true }
        index += 1
    }
    index = 0
    while index < interface.*.operations.count {
        if m.node(interface.*.operations, index).*.isStatic { return true }
        index += 1
    }
    return false
}

fn getRuntimeEnabledStaticProperties(interface: *Node) -> r.List {
    var result = r.list()
    var index: usize = 0
    while index < interface.*.attributes.count {
        const attribute = m.node(interface.*.attributes, index)
        index += 1
        if attributeShouldBeOnInstance(interface, attribute) { continue }
        if !attribute.*.isStatic { continue }
        if needsRuntimeCheck(interface, attribute) { r.push(&result, @intFromPtr(attribute)) }
    }
    index = 0
    while index < interface.*.constants.count {
        const constant = m.node(interface.*.constants, index)
        index += 1
        if needsRuntimeCheck(interface, constant) { r.push(&result, @intFromPtr(constant)) }
    }
    index = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        index += 1
        if on(operation, "PrivateIdentifier") && !on(operation, "PublicIdentifier") { continue }
        if operation.*.overloadIndex > 1 { continue }
        if operationShouldBeOnInstance(interface, operation) { continue }
        if std.text.same(operation.*.name, "[Symbol.Iterator]") || std.text.same(operation.*.name, "[Symbol.asyncIterator]") { continue }
        if !operation.*.isStatic { continue }
        if needsRuntimeCheck(interface, operation) { r.push(&result, @intFromPtr(operation)) }
    }
    return result
}

fn generateConstructorHelperMethods(out: *StrList, className: Str, protoClassName: Str, visibleInterfaceName: Str, interface: *Node, generatingLegacyFactoryFunction: bool) -> void {
    const constructorClassName = if generatingLegacyFactoryFunction { r.c2(className, "LegacyFactoryFunction") } else { r.c2(className, "DOMConstructor") }
    var leastConstructorLength: usize = 0
    if interface.*.constructors.count > 0 {
        leastConstructorLength = 255
        var index: usize = 0
        while index < interface.*.constructors.count {
            const length = getFunctionLength(m.node(interface.*.constructors, index))
            if length < leastConstructorLength { leastConstructorLength = length }
            index += 1
        }
    }
    p(out, cat([_]Str{ "template<> const ClassInfo ", constructorClassName, "::s_info = { \"", visibleInterfaceName, "\"_s, &Base::s_info, nullptr, nullptr, CREATE_METHOD_TABLE(", constructorClassName, ") };\n\n" }[0..]))
    p(out, cat([_]Str{ "template<> JSValue ", constructorClassName, "::prototypeForStructure(JSC::VM& vm, const JSDOMGlobalObject& globalObject)\n" }[0..]))
    p(out, "{\n")
    if interface.*.parentType != null {
        const parentAttributes = cg.getInterfaceExtendedAttributesFromName(interface.*.parentType.?.*.name)
        if parentAttributes == null { r.die("Can't use an undefined value as a HASH reference") }
        if r.truthy(r.getStr(parentAttributes.?, "LegacyNoInterfaceObject")) { r.die("An interface cannot inherit from another interface that is marked as [LegacyNoInterfaceObject]") }
    }
    if !generatingLegacyFactoryFunction && interface.*.parentType != null {
        p(out, cat([_]Str{ "    return JS", interface.*.parentType.?.*.name, "::getConstructor(vm, &globalObject);\n" }[0..]))
    } else if js.shouldUseOrdinaryObjectPrototype(interface) {
        js.addToImplInclude("<JavaScriptCore/ObjectPrototype.h>")
        p(out, "    UNUSED_PARAM(vm);\n")
        p(out, "    return globalObject.objectPrototype();\n")
    } else {
        js.addToImplInclude("<JavaScriptCore/FunctionPrototype.h>")
        p(out, "    UNUSED_PARAM(vm);\n")
        p(out, "    return globalObject.functionPrototype();\n")
    }
    p(out, "}\n\n")
    p(out, cat([_]Str{ "template<> void ", constructorClassName, "::initializeProperties(VM& vm, JSDOMGlobalObject& globalObject)\n" }[0..]))
    p(out, "{\n")
    if visibleInterfaceName.length < 2 { r.die("jsNontrivialString() requires strings two or more characters long") }
    if interface.*.isNamespaceObject {
        p(out, "    WebCore::putDirectWithoutTransition(this, vm, vm.propertyNames->toStringTagSymbol, jsNontrivialString(vm, info()->className), JSC::PropertyAttribute::DontEnum | JSC::PropertyAttribute::ReadOnly);\n")
    } else {
        const length = r.decimal(@intCast(u64, leastConstructorLength))
        if on(interface, "LegacyFactoryFunctionEnabledBySetting") {
            const condition = generateRuntimeEnableConditionalString(interface, interface, "(&globalObject)", true)
            p(out, cat([_]Str{ "    int constructorLength = ", length, ";\n" }[0..]))
            p(out, cat([_]Str{ "    if (!", condition, ")\n" }[0..]))
            p(out, "        constructorLength = 0;\n")
            p(out, "    putDirect(vm, vm.propertyNames->length, jsNumber(constructorLength), JSC::PropertyAttribute::ReadOnly | JSC::PropertyAttribute::DontEnum);\n")
        } else {
            p(out, cat([_]Str{ "    putDirect(vm, vm.propertyNames->length, jsNumber(", length, "), JSC::PropertyAttribute::ReadOnly | JSC::PropertyAttribute::DontEnum);\n" }[0..]))
        }
        p(out, cat([_]Str{ "    JSString* nameString = jsNontrivialString(vm, \"", visibleInterfaceName, "\"_s);\n" }[0..]))
        p(out, "    m_originalName.set(vm, this, nameString);\n")
        p(out, "    putDirect(vm, vm.propertyNames->name, nameString, JSC::PropertyAttribute::ReadOnly | JSC::PropertyAttribute::DontEnum);\n")
        if interface.*.isCallback {
            p(out, "    UNUSED_PARAM(globalObject);\n")
        } else {
            const prototype = if js.shouldUseGlobalObjectPrototype(interface) { "WebCore::storedPrototype(globalObject.structure(), &globalObject)" } else { r.c2(className, "::prototype(vm, globalObject)") }
            p(out, cat([_]Str{ "    putDirect(vm, vm.propertyNames->prototype, ", prototype, ", JSC::PropertyAttribute::ReadOnly | JSC::PropertyAttribute::DontEnum | JSC::PropertyAttribute::DontDelete);\n" }[0..]))
        }
    }
    const classForThis = if interface.*.isCallback { "nullptr" } else { r.c2(className, "::info()") }
    if constructorHasProperties(interface) { p(out, cat([_]Str{ "    reifyStaticProperties(vm, ", classForThis, ", ", className, "ConstructorTableValues, *this);\n" }[0..])) }
    const runtimeEnabled = getRuntimeEnabledStaticProperties(interface)
    if interface.*.isNamespaceObject && runtimeEnabled.count == 0 { p(out, "    UNUSED_PARAM(globalObject);\n") }
    var index: usize = 0
    while index < runtimeEnabled.count {
        const property = m.node(runtimeEnabled, index)
        index += 1
        const conditionalString = cg.generateConditionalString(property.*.ext)
        if r.truthy(conditionalString) { p(out, cat([_]Str{ "#if ", conditionalString, "\n" }[0..])) }
        const condition = generateRuntimeEnableConditionalString(interface, property, "(&globalObject)", true)
        p(out, cat([_]Str{ "    if (!", condition, ") {\n" }[0..]))
        p(out, cat([_]Str{ "        auto propertyName = Identifier::fromString(vm, \"", property.*.name, "\"_s);\n" }[0..]))
        p(out, "        VM::DeletePropertyModeScope scope(vm, VM::DeletePropertyMode::IgnoreConfigurable);\n")
        p(out, "        DeletePropertySlot slot;\n")
        p(out, "        JSObject::deleteProperty(this, &globalObject, propertyName, slot);\n")
        p(out, "    }\n")
        if r.truthy(conditionalString) { p(out, "#endif\n") }
    }
    p(out, "}\n\n")
    if hasJSBuiltinConstructor(interface) {
        p(out, cat([_]Str{ "template<> FunctionExecutable* ", constructorClassName, "::initializeExecutable(VM& vm)\n" }[0..]))
        p(out, "{\n")
        p(out, cat([_]Str{ "    return ", getJSBuiltinFunctionNameFromString(typeName(interface), r.c2("initialize", typeName(interface))), "(vm);\n" }[0..]))
        p(out, "}\n")
        p(out, "\n")
    }
}

// An iterable over values: no key type and an indexed getter.
pub fn isValueIterableInterface(interface: *Node) -> bool {
    if interface.*.iterable == null && interface.*.asyncIterable == null { return false }
    if interface.*.iterable != null && interface.*.iterable.?.*.keyType != null { return false }
    if interface.*.asyncIterable != null && interface.*.asyncIterable.?.*.keyType != null { return false }
    if getIndexedGetterOperation(interface) == null { return false }
    return true
}

pub fn isKeyValueIterableInterface(interface: *Node) -> bool {
    if interface.*.iterable == null && interface.*.asyncIterable == null { return false }
    return !isValueIterableInterface(interface)
}
