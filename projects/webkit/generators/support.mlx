// What WebKit's generators in Mlx share: memory (an arena, never freed:
// the runs are short), whole files read and written, the text they make
// built up in one buffer, and the little work on text they all do.
const std = @import("std")

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_lseek: usize = 8
const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231
const O_RDONLY: usize = 0
const O_WRITE_NEW: usize = 577

// ---------------------------------------------------------------------------
// Memory.

const ARENA_SIZE: usize = 17179869184
var arenaNext: usize = 0
var arenaEnd: usize = 0

pub fn alloc(size: usize) -> usize {
    if arenaNext == 0 {
        // Reserved, not committed: pages come as they are touched.
        const reserved = std.linux.syscall6(SYS_mmap, 0, ARENA_SIZE, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
        if reserved < 0 { fail("no memory") }
        arenaNext = @bitCast(usize, reserved)
        arenaEnd = arenaNext + ARENA_SIZE
    }
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fail("out of memory") }
    arenaNext = at + size
    return at
}

pub fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }

pub fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

// ---------------------------------------------------------------------------
// Messages.

pub fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

// MESSAGE on standard error, and the run ends (status 1).
pub fn fail(message: []const u8) -> void {
    say(message)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

// ---------------------------------------------------------------------------
// Text.

pub fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    var index: usize = 0
    while index < first.length {
        put8(at + index, first[index])
        index += 1
    }
    index = 0
    while index < second.length {
        put8(at + first.length + index, second[index])
        index += 1
    }
    put8(at + first.length + second.length, 0)
    return bytes(at, first.length + second.length)
}

pub fn join3(first: []const u8, second: []const u8, third: []const u8) -> []const u8 { return join(join(first, second), third) }

// TEXT with every FROM byte made TO.
pub fn replaceByte(text: []const u8, from: u8, to: u8) -> []const u8 {
    const at = alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        put8(at + index, if text[index] == from { to } else { text[index] })
        index += 1
    }
    put8(at + text.length, 0)
    return bytes(at, text.length)
}

// TEXT with its first letter capital (Perl's ucfirst).
pub fn capitalized(text: []const u8) -> []const u8 {
    if text.length == 0 || text[0] < 97 || text[0] > 122 { return text }
    const at = alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        put8(at + index, text[index])
        index += 1
    }
    put8(at, text[0] - 32)
    put8(at + text.length, 0)
    return bytes(at, text.length)
}

// Space as Perl's \s: space, tab, the line ends, form and line feeds.
pub fn isSpace(byte: u8) -> bool { return byte == 32 || (byte >= 9 && byte <= 13) }
// A word character (Perl's \w on bytes).
pub fn isWord(byte: u8) -> bool { return std.ascii.isDigit(byte) || byte == 95 || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }

pub fn trimStart(text: []const u8) -> []const u8 {
    var at: usize = 0
    while at < text.length && isSpace(text[at]) { at += 1 }
    return text[at..text.length]
}

pub fn trimEnd(text: []const u8) -> []const u8 {
    var end = text.length
    while end > 0 && isSpace(text[end - 1]) { end -= 1 }
    return text[0..end]
}

// The line of TEXT at AT (without its newline); AT moves past it.
pub fn nextLine(text: []const u8, at: *usize) -> []const u8 {
    const start = at.*
    var end = start
    while end < text.length && text[end] != 10 { end += 1 }
    at.* = if end < text.length { end + 1 } else { end }
    return text[start..end]
}

// The last part of PATH, after its last slash.
pub fn baseName(path: []const u8) -> []const u8 {
    var start = path.length
    while start > 0 && path[start - 1] != 47 { start -= 1 }
    return path[start..path.length]
}

pub fn decimal(value: u64) -> []const u8 {
    var digits: [24]u8 = undefined
    var at: usize = 24
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        if rest == 0 { break }
    }
    return join(digits[at..24], "")
}

pub fn signedDecimal(value: i64) -> []const u8 {
    if value < 0 { return join("-", decimal(@intCast(u64, -value))) }
    return decimal(@intCast(u64, value))
}

// ---------------------------------------------------------------------------
// Files.

pub fn readWhole(path: []const u8) -> []const u8 {
    const name = join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 { fail(join("cannot read ", path)) }
    // As large as the file (its end, found by seeking there), and a byte.
    const end = std.linux.syscall3(SYS_lseek, @bitCast(usize, descriptor), 0, 2)
    const back = std.linux.syscall3(SYS_lseek, @bitCast(usize, descriptor), 0, 0)
    const capacity: usize = if end > 0 { @intCast(usize, end) + 1 } else { 1 }
    const data = alloc(capacity)
    var length: usize = 0
    while length < capacity {
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return bytes(data, length)
}

pub fn writeWhole(path: []const u8, text: []const u8) -> void {
    const name = join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_WRITE_NEW, 420)
    if descriptor < 0 { fail(join("cannot write ", path)) }
    var done: usize = 0
    while done < text.length {
        const count = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(text.pointer) + done, text.length - done)
        if count <= 0 { fail(join("cannot write ", path)) }
        done += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

// ---------------------------------------------------------------------------
// Output: text built up in one buffer, written at the end.

const OUT_SIZE: usize = 1073741824
var outBase: usize = 0
var outTop: usize = 0

pub fn out(text: []const u8) -> void {
    if outBase == 0 { outBase = alloc(OUT_SIZE) }
    if outTop + text.length > OUT_SIZE { fail("the output is too large") }
    var index: usize = 0
    while index < text.length {
        put8(outBase + outTop + index, text[index])
        index += 1
    }
    outTop += text.length
}

pub fn outUnsigned(value: u64) -> void { out(decimal(value)) }
pub fn outSigned(value: i64) -> void { out(signedDecimal(value)) }

pub fn output() -> []const u8 {
    if outBase == 0 { return "" }
    return bytes(outBase, outTop)
}

pub fn writeOutput(path: []const u8) -> void { writeWhole(path, output()) }
