// Files put one after the other into one (the build's `cmake -E cat
// INPUT... > OUTPUT`, as it makes ModernMediaControls.css and .js):
//
//     webkit-cat OUTPUT INPUT...
const std = @import("std")
const s = @import("./support.mlx")
const c = @import("./csstext.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 2 {
        s.say("usage: webkit-cat OUTPUT INPUT...\n")
        return 2
    }
    var b = c.buf()
    var index: usize = 2
    while index < arguments.length {
        c.add(&b, c.readFile(std.text.cString(arguments[index])))
        index += 1
    }
    s.writeWhole(std.text.cString(arguments[1]), c.contents(&b))
    return 0
}
