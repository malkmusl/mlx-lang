// WebCore's factories of JavaScript wrappers for events and event targets
// (EventFactory.cpp, EventInterfaces.h and EventHeaders.h; the same of
// EventTarget), made as dom/make_event_factory.pl (Perl, with
// bindings/scripts/InFilesCompiler.pm) makes them, from
// dom/EventInterfaces.in or dom/EventTargetFactory.in:
//
//     webkit-event-factory --input INPUT [--input INPUT ...] --outputDir DIRECTORY
//
// The input names the namespace (Event or EventTarget), the factory
// function (toNewlyCreated or toJS) and whether the namespace is a suffix
// of the wrapper classes, then one interface a line with its interfaceName
// and conditional. The interface types are numbered: those of each
// conditional first, by conditional, then the others.
const s = @import("./support.mlx")
const n = @import("./namestext.mlx")

const Item = struct {
    name: []const u8
    interfaceName: []const u8
    conditional: []const u8
}

const MAX_ITEMS: usize = 4096

var items: [*]Item = undefined
var itemCount: usize = 0
var namespaceName: [*]const u8 = undefined
var namespaceLength: usize = 0
var factoryFunction: [*]const u8 = undefined
var factoryFunctionLength: usize = 0
var suffixName: [*]const u8 = undefined
var suffixLength: usize = 0

fn namespace() -> []const u8 { return namespaceName[0..namespaceLength] }

fn parameter(name: []const u8, value: []const u8) -> void {
    if s.same(name, "namespace") {
        namespaceName = value.pointer
        namespaceLength = value.length
    } else if s.same(name, "factoryFunction") {
        factoryFunction = value.pointer
        factoryFunctionLength = value.length
    } else if s.same(name, "useNamespaceAsSuffix") {
        suffixName = value.pointer
        suffixLength = value.length
    } else {
        s.fail(s.join3("Unknown parameter ", name, ""))
    }
}

fn item(name: []const u8, property: []const u8, value: []const u8) -> void {
    var index: usize = 0
    while index < itemCount && !s.same(items[index].name, name) { index += 1 }
    if index == itemCount {
        if itemCount == MAX_ITEMS { s.fail("make_event_factory: too many items") }
        items[itemCount] = Item.{ .name = name, .interfaceName = "0", .conditional = "0" }
        itemCount += 1
    }
    if !n.truthy(property) { return }
    if s.same(property, "interfaceName") {
        items[index].interfaceName = value
    } else if s.same(property, "conditional") {
        items[index].conditional = value
    } else {
        s.fail(s.join3(s.join3("Unknown property ", property, " for "), name, ""))
    }
}

fn interfaceOf(index: usize) -> []const u8 {
    if n.truthy(items[index].interfaceName) { return items[index].interfaceName }
    return items[index].name
}

fn byName(first: usize, second: usize) -> i32 { return n.compare(items[first].name, items[second].name) }

// "ENABLE(A) || ENABLE(B)" of "A|B".
fn conditionalString(conditional: []const u8) -> []const u8 {
    var text = "ENABLE("
    var start: usize = 0
    var index: usize = 0
    while index <= conditional.length {
        if index == conditional.length || conditional[index] == 124 {
            if start > 0 { text = s.join(text, ") || ENABLE(") }
            text = s.join(text, conditional[start..index])
            start = index + 1
        }
        index += 1
    }
    return s.join(text, ")")
}

fn macroStyle(camelCase: []const u8) -> []const u8 {
    if s.same(camelCase, "Event") { return "EVENT" }
    if s.same(camelCase, "EventTarget") { return "EVENT_TARGET" }
    if s.same(camelCase, "Exception") { return "EXCEPTION" }
    s.fail(s.join3("Ok, you got me. This script is really just a giant hack. ($camelCase=", camelCase, ")"))
    return ""
}

fn generateImplementation(outputDirectory: []const u8, order: [*]usize) -> void {
    const ns = namespace()
    const function = factoryFunction[0..factoryFunctionLength]
    const newlyCreated = s.same(function, "toNewlyCreated")
    if !newlyCreated && !s.same(function, "toJS") { s.fail("factoryFunction should be either toJS or toNewlyCreated") }
    n.o(LICENSE)
    n.o3("#include \"config.h\"\n#include \"", ns, "Headers.h\"\n\n")
    n.o("#include \"JSDOMGlobalObject.h\"\n#include \"JSDOMWrapperCache.h\"\n#include \"JSDOMBindingFacade.h\"\n\nnamespace WebCore {\n\n")
    if newlyCreated {
        n.o3("JSC::JSValue toJSNewlyCreated(JSC::JSGlobalObject*, JSDOMGlobalObject* globalObject, Ref<", ns, ">&& impl)\n{\n")
        n.o("    switch (impl->interfaceType()) {\n    case EventInterfaceType::Invalid:\n        ASSERT_NOT_REACHED();\n        break;\n")
    } else {
        n.o3("JSC::JSValue toJS(JSC::JSGlobalObject* state, JSDOMGlobalObject* globalObject, ", ns, "& impl)\n{\n")
        n.o3("    switch (impl.", n.lowerFirst(s.join(ns, "Interface")), "()) {\n")
        n.o3("    case ", ns, "InterfaceType::Invalid:\n        ASSERT_NOT_REACHED();\n        break;\n")
        n.o5("    case ", ns, "InterfaceType::", ns, ":\n        break;\n")
    }
    var generated = n.list()
    var position: usize = 0
    while position < itemCount {
        const index = order[position]
        position += 1
        const conditional = items[index].conditional
        const interfaceName = interfaceOf(index)
        if n.has(generated, interfaceName) { continue }
        n.push(&generated, interfaceName)
        const suffix = if s.same(suffixName[0..suffixLength], "true") { ns } else { "" }
        if n.truthy(conditional) {
            // "#if ENABLE(A) || ENABLE(B)".
            n.o3("#if ", conditionalString(conditional), "\n")
        }
        n.o5("    case ", ns, "InterfaceType::", interfaceName, ":\n")
        if newlyCreated {
            n.o5("        return createWrapper<", interfaceName, suffix, ">(globalObject, WTF::move(impl));\n", "")
        } else {
            n.o3("        return toJS(state, globalObject, downcast<", interfaceName, ">(impl));\n")
        }
        if n.truthy(conditional) { n.o("#endif\n") }
    }
    n.o("    }\n")
    if newlyCreated {
        n.o3("    return createWrapper<", ns, ">(globalObject, WTF::move(impl));\n")
    } else {
        n.o("    return wrap(state, globalObject, impl);\n")
    }
    n.o("}\n\n} // namespace WebCore\n")
    n.save(n.path(outputDirectory, s.join(ns, "Factory.cpp")))
}

fn generateInterfacesHeader(outputDirectory: []const u8, order: [*]usize) -> void {
    const ns = namespace()
    n.o(LICENSE)
    n.o("#pragma once\n\n")
    var unconditional = n.list()
    var conditionals = n.list()
    var position: usize = 0
    while position < itemCount {
        const index = order[position]
        position += 1
        if n.truthy(items[index].conditional) {
            n.add(&conditionals, items[index].conditional)
        } else {
            n.add(&unconditional, interfaceOf(index))
        }
    }
    const ignored = macroStyle(ns)
    n.o("namespace WebCore {\n\n")
    n.o3("enum class ", ns, "InterfaceType : uint8_t {\n")
    n.o("    Invalid = 0,\n")
    var count: u64 = 1
    n.sortList(&conditionals)
    var c: usize = 0
    while c < conditionals.count {
        const conditional = conditionals.items[c]
        c += 1
        n.o3("#if ", conditionalString(conditional), "\n")
        var interfaces = n.list()
        var index: usize = 0
        while index < itemCount {
            if s.same(items[index].conditional, conditional) { n.add(&interfaces, interfaceOf(index)) }
            index += 1
        }
        n.sortList(&interfaces)
        var i: usize = 0
        while i < interfaces.count {
            if !n.has(unconditional, interfaces.items[i]) {
                n.o3("    ", interfaces.items[i], " = ")
                n.on(count)
                n.o(",\n")
                count += 1
            }
            i += 1
        }
        n.o("#endif\n")
    }
    if s.same(ns, "EventTarget") {
        n.o3("    ", ns, " = ")
        n.on(count)
        n.o(",\n")
        count += 1
    }
    n.sortList(&unconditional)
    var u: usize = 0
    while u < unconditional.count {
        n.o3("    ", unconditional.items[u], " = ")
        n.on(count)
        n.o(",\n")
        count += 1
        u += 1
    }
    n.o("};\n\n} // namespace WebCore\n")
    n.save(n.path(outputDirectory, s.join(ns, "Interfaces.h")))
}

fn generateHeadersHeader(outputDirectory: []const u8, order: [*]usize) -> void {
    const ns = namespace()
    n.o(LICENSE)
    n.o3("#ifndef ", ns, "Headers_h\n")
    n.o3("#define ", ns, "Headers_h\n\n")
    var included = n.list()
    var position: usize = 0
    while position < itemCount {
        const index = order[position]
        position += 1
        const conditional = items[index].conditional
        const interfaceName = interfaceOf(index)
        if n.has(included, interfaceName) { continue }
        n.push(&included, interfaceName)
        if n.truthy(conditional) { n.o3("#if ", conditionalString(conditional), "\n") }
        n.o3("#include \"", interfaceName, ".h\"\n")
        n.o3("#include \"JS", interfaceName, ".h\"\n")
        if n.truthy(conditional) { n.o("#endif\n") }
    }
    n.o3("\n#endif // ", ns, "Headers_h\n")
    n.save(n.path(outputDirectory, s.join(ns, "Headers.h")))
}

pub fn main(arguments: [][*]const u8) -> u8 {
    unsafe { items = @ptrFromInt([*]Item, s.alloc(MAX_ITEMS * @sizeOf(Item))) }
    namespaceName = "0".pointer
    namespaceLength = 1
    factoryFunction = "0".pointer
    factoryFunctionLength = 1
    suffixName = "0".pointer
    suffixLength = 1
    var inputs = n.list()
    var outputDirectory: []const u8 = "."
    var index: usize = 1
    while index < arguments.length {
        const argument = s.cString(arguments[index])
        if (s.same(argument, "--input") || s.same(argument, "--outputDir")) && index + 1 < arguments.length {
            const value = s.cString(arguments[index + 1])
            if s.same(argument, "--input") { n.push(&inputs, value) } else { outputDirectory = value }
            index += 2
        } else if s.startsWith(argument, "--input=") {
            n.push(&inputs, argument[8..argument.length])
            index += 1
        } else if s.startsWith(argument, "--outputDir=") {
            outputDirectory = argument[12..argument.length]
            index += 1
        } else {
            s.say("usage: webkit-event-factory --input INPUT [--input INPUT ...] --outputDir DIRECTORY\n")
            return 2
        }
    }
    if inputs.count == 0 { s.fail("You must specify at least one --input <file>") }
    n.makeDirectories(outputDirectory)
    const handler = n.InHandler.{ .parameter = parameter, .item = item }
    var i: usize = 0
    while i < inputs.count {
        n.parseIn(s.readWhole(inputs.items[i]), handler)
        if itemCount == 0 { s.fail(s.join("Failed to read from file: ", inputs.items[i])) }
        i += 1
    }
    const order = n.indexes(itemCount)
    n.sortBy(order, itemCount, byName)
    generateImplementation(outputDirectory, order)
    generateInterfacesHeader(outputDirectory, order)
    generateHeadersHeader(outputDirectory, order)
    return 0
}

