// gperf's input file: DECLARATIONS %% KEYWORDS %% CODE, read as gperf's
// Input::read_input reads it. The declarations are C code between %{ and
// %}, % directives (options) and the struct declaration of --struct-type;
// each keyword line is a keyword (bare up to a delimiter, or a C string)
// and, with --struct-type, the rest of its line.
const s = @import("./support.mlx")
const io = @import("./gperfio.mlx")
const opt = @import("./gperfoptions.mlx")
const kw = @import("./gperfkeywords.mlx")

pub const Input = struct {
    text: []const u8
    verbatimDeclarations: []const u8
    verbatimDeclarationsLineno: i64
    verbatimCode: []const u8
    verbatimCodeLineno: i64
    structDecl: []const u8
    structDeclLineno: i64
    returnType: []const u8
    structTag: []const u8
    charsetDependent: bool
    head: i64
}

pub var input: *Input = undefined

// The byte at INDEX of the input, NUL past its end (as gperf's buffer).
fn byteAt(index: usize) -> u8 {
    if index < input.*.text.length { return input.*.text[index] }
    return 0
}

fn prettyInputFileName() -> []const u8 {
    if opt.o.*.hasInputFile { return opt.o.*.inputFileName }
    return "(standard input)"
}

fn complain(lineno: i64, message: []const u8) -> void {
    s.say(s.join3(prettyInputFileName(), ":", s.join3(s.signedDecimal(lineno), ": ", message)))
}

fn die(lineno: i64, message: []const u8) -> void {
    complain(lineno, message)
    io.exit(1)
}

fn isNameByte(byte: u8) -> bool {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 45 || byte == 95
}

// At LINE (its '%' at index LINE, ending at LINE_END): AT moves past
// "%DECL" when it is that (a '-' of DECL matching '_' too).
fn matchName(line: usize, lineEnd: usize, decl: []const u8, at: *usize) -> bool {
    var p = at.*
    for d in decl {
        if !(p < lineEnd) { return false }
        const byte = byteAt(p)
        if !(byte == d || (d == 45 && byte == 95)) { return false }
        p += 1
    }
    if p < lineEnd && isNameByte(byteAt(p)) { return false }
    at.* = p
    return true
}

fn skipBlanks(at: *usize, lineEnd: usize) -> void {
    while at.* < lineEnd && (byteAt(at.*) == 32 || byteAt(at.*) == 9) { at.* += 1 }
}

fn expectEnd(at: usize, lineEnd: usize, lineno: i64) -> void {
    var p = at
    skipBlanks(&p, lineEnd)
    if p < lineEnd && byteAt(p) != 10 { die(lineno, "junk after declaration\n") }
}

fn word(at: *usize, lineEnd: usize) -> []const u8 {
    const start = at.*
    while at.* < lineEnd && !(byteAt(at.*) == 32 || byteAt(at.*) == 9 || byteAt(at.*) == 10) { at.* += 1 }
    return input.*.text[start..at.*]
}

// "%DECL".
fn isDeclaration(line: usize, lineEnd: usize, lineno: i64, decl: []const u8) -> bool {
    var at = line + 1
    if !matchName(line, lineEnd, decl, &at) { return false }
    expectEnd(at, lineEnd, lineno)
    return true
}

// "%DECL=ARG".
fn isDeclarationWithArg(line: usize, lineEnd: usize, lineno: i64, decl: []const u8, argument: *[]const u8) -> bool {
    var at = line + 1
    if !matchName(line, lineEnd, decl, &at) { return false }
    if !(at < lineEnd && byteAt(at) == 61) { die(lineno, s.join3("missing argument in %", decl, "=ARG declaration.\n")) }
    at += 1
    argument.* = word(&at, lineEnd)
    expectEnd(at, lineEnd, lineno)
    return true
}

// "%define DECL ARG".
fn isDefineDeclaration(line: usize, lineEnd: usize, lineno: i64, decl: []const u8, argument: *[]const u8) -> bool {
    var at = line + 1
    for d in "define" {
        if !(at < lineEnd) { return false }
        if byteAt(at) != d { return false }
        at += 1
    }
    if !(at < lineEnd && (byteAt(at) == 32 || byteAt(at) == 9)) { return false }
    skipBlanks(&at, lineEnd)
    if !matchName(line, lineEnd, decl, &at) { return false }
    if !(at < lineEnd && (byteAt(at) == 32 || byteAt(at) == 9)) {
        die(lineno, s.join3("missing argument in %define ", decl, " ARG declaration.\n"))
    }
    skipBlanks(&at, lineEnd)
    argument.* = word(&at, lineEnd)
    expectEnd(at, lineEnd, lineno)
    return true
}

// The end of the line at LINE (past its newline), at most LIMIT.
fn lineEndOf(line: usize, limit: usize) -> usize {
    var p = line
    while p < limit {
        if byteAt(p) == 10 { return p + 1 }
        p += 1
    }
    return limit
}

fn directive(line: usize, lineEnd: usize, lineno: i64) -> void {
    var argument: []const u8 = ""
    if isDeclarationWithArg(line, lineEnd, lineno, "delimiters", &argument) {
        opt.setDelimiters(argument)
    } else if isDeclaration(line, lineEnd, lineno, "struct-type") {
        opt.set(opt.TYPE)
    } else if isDeclaration(line, lineEnd, lineno, "ignore-case") {
        opt.set(opt.UPPERLOWER)
    } else if isDeclarationWithArg(line, lineEnd, lineno, "language", &argument) {
        opt.setLanguage(argument)
    } else if isDefineDeclaration(line, lineEnd, lineno, "slot-name", &argument) {
        opt.setSlotName(argument)
    } else if isDefineDeclaration(line, lineEnd, lineno, "initializer-suffix", &argument) {
        opt.setInitializerSuffix(argument)
    } else if isDefineDeclaration(line, lineEnd, lineno, "hash-function-name", &argument) {
        opt.setHashName(argument)
    } else if isDefineDeclaration(line, lineEnd, lineno, "lookup-function-name", &argument) {
        opt.setFunctionName(argument)
    } else if isDefineDeclaration(line, lineEnd, lineno, "class-name", &argument) {
        opt.setClassName(argument)
    } else if isDeclaration(line, lineEnd, lineno, "7bit") {
        opt.set(opt.SEVENBIT)
    } else if isDeclaration(line, lineEnd, lineno, "compare-lengths") {
        opt.set(opt.LENTABLE)
    } else if isDeclaration(line, lineEnd, lineno, "compare-strncmp") {
        opt.set(opt.COMP)
    } else if isDeclaration(line, lineEnd, lineno, "readonly-tables") {
        opt.set(opt.CONST)
    } else if isDeclaration(line, lineEnd, lineno, "enum") {
        opt.set(opt.ENUM)
    } else if isDeclaration(line, lineEnd, lineno, "includes") {
        opt.set(opt.INCLUDE)
    } else if isDeclaration(line, lineEnd, lineno, "global-table") {
        opt.set(opt.GLOBAL)
    } else if isDeclaration(line, lineEnd, lineno, "pic") {
        opt.set(opt.SHAREDLIB)
    } else if isDefineDeclaration(line, lineEnd, lineno, "string-pool-name", &argument) {
        opt.setStringpoolName(argument)
    } else if isDeclaration(line, lineEnd, lineno, "null-strings") {
        opt.set(opt.NULLSTRINGS)
    } else if isDefineDeclaration(line, lineEnd, lineno, "constants-prefix", &argument) {
        opt.setConstantsPrefix(argument)
    } else if isDefineDeclaration(line, lineEnd, lineno, "word-array-name", &argument) {
        opt.setWordlistName(argument)
    } else if isDefineDeclaration(line, lineEnd, lineno, "length-table-name", &argument) {
        opt.setLengthtableName(argument)
    } else if isDeclarationWithArg(line, lineEnd, lineno, "switch", &argument) {
        opt.setTotalSwitches(opt.atoi(argument))
        if opt.o.*.totalSwitches <= 0 { die(lineno, s.join3("number of switches ", argument, " must be a positive number\n")) }
    } else if isDeclaration(line, lineEnd, lineno, "omit-struct-type") {
        opt.set(opt.NOTYPE)
    } else {
        die(lineno, "unrecognized % directive\n")
    }
}

// The struct declaration of --struct-type: the declaration lines outside
// %{ %}, without leading blanks and comments and trailing blanks, ending
// in ';'; its line; the "struct something" it declares.
fn structDeclaration(text: []const u8, linenos: [*]i64, lineCount: usize) -> void {
    var p: usize = 0
    var l: usize = 0
    while true {
        const byte = if p < text.length { text[p] } else { 0 }
        const after = if p + 1 < text.length { text[p + 1] } else { 0 }
        if byte == 32 || byte == 9 {
            p += 1
            continue
        }
        if byte == 10 {
            l += 1
            p += 1
            continue
        }
        if byte == 47 && after == 42 {
            p += 2
            while p < text.length {
                if text[p] == 42 && p + 1 < text.length && text[p + 1] == 47 {
                    p += 2
                    break
                }
                if text[p] == 10 { l += 1 }
                p += 1
            }
            continue
        }
        if byte == 47 && after == 47 {
            p += 2
            while p < text.length && text[p] != 10 { p += 1 }
            if p < text.length {
                l += 1
                p += 1
            }
            continue
        }
        break
    }
    var decl = text[p..text.length]
    input.*.structDeclLineno = if l < lineCount { linenos[l] } else { 0 }
    var end = decl.length
    while end > 0 && (decl[end - 1] == 10 || decl[end - 1] == 32 || decl[end - 1] == 9) { end -= 1 }
    decl = decl[0..end]
    if decl.length == 0 {
        s.say(s.join(prettyInputFileName(), ": missing struct declaration for option --struct-type\n"))
        io.exit(1)
    }
    if decl[decl.length - 1] != 59 { decl = s.join(decl, ";") }
    input.*.structDecl = decl
    var tagEnd: usize = 0
    while tagEnd < decl.length && decl[tagEnd] != 123 && decl[tagEnd] != 59 && decl[tagEnd] != 10 { tagEnd += 1 }
    while tagEnd > 0 && (decl[tagEnd - 1] == 10 || decl[tagEnd - 1] == 32 || decl[tagEnd - 1] == 9) { tagEnd -= 1 }
    input.*.structTag = decl[0..tagEnd]
    input.*.returnType = s.join(decl[0..tagEnd], " *")
}

fn isDelimiter(byte: u8) -> bool {
    // strchr finds the terminating NUL too.
    if byte == 0 { return true }
    for d in opt.o.*.delimiters {
        if d == byte { return true }
    }
    return false
}

fn isOctal(byte: u8) -> bool { return byte >= 48 && byte <= 55 }

// The rest of the line from LP for --struct-type (without its newline).
fn restOf(lp: usize, lineEnd: usize) -> []const u8 {
    if !opt.has(opt.TYPE) { return "" }
    var end = lineEnd
    if lineEnd > lp && byteAt(lineEnd - 1) == 10 { end -= 1 }
    if end < lp { end = lp }
    // A C string: it ends at a NUL byte.
    var stop = lp
    while stop < end && byteAt(stop) != 0 { stop += 1 }
    return input.*.text[lp..stop]
}

fn keywordLines(keywords: usize, keywordsEnd: usize, keywordsLineno: i64) -> void {
    var head: i64 = -1
    var tail: i64 = -1
    var lineno = keywordsLineno
    var charsetDependent = false
    var line = keywords
    while line < keywordsEnd {
        const lineEnd = lineEndOf(line, keywordsEnd)
        const lead = byteAt(line)
        if lead == 35 {
            // A comment line.
        } else if lead == 37 {
            die(lineno, "declarations are not allowed in the keywords section.\nTo declare a keyword starting with %, enclose it in double-quotes.\n")
        } else {
            var chars: []const u8 = ""
            var rest: []const u8 = ""
            if lead == 34 {
                // A string in C syntax.
                const buffer = s.alloc(lineEnd - line + 1)
                var kp: usize = 0
                var lp = line + 1
                while true {
                    if lp == lineEnd { die(lineno, "unterminated string\n") }
                    var c = byteAt(lp)
                    if c == 92 {
                        lp += 1
                        c = byteAt(lp)
                        if isOctal(c) {
                            var code: i64 = 0
                            var count: usize = 0
                            while count < 3 && isOctal(byteAt(lp)) {
                                code = code * 8 + @intCast(i64, byteAt(lp) - 48)
                                lp += 1
                                count += 1
                            }
                            if code > 255 { complain(lineno, "octal escape out of range\n") }
                            s.put8(buffer + kp, @intCast(u8, code & 255))
                        } else if c == 120 {
                            var code: i64 = 0
                            var count: usize = 0
                            lp += 1
                            while true {
                                const h = byteAt(lp)
                                var digit: i64 = -1
                                if h >= 48 && h <= 57 { digit = @intCast(i64, h - 48) }
                                if h >= 65 && h <= 70 { digit = @intCast(i64, h - 55) }
                                if h >= 97 && h <= 102 { digit = @intCast(i64, h - 87) }
                                if digit < 0 { break }
                                code = (code *% 16 +% digit) & 4294967295
                                lp += 1
                                count += 1
                            }
                            if count == 0 { complain(lineno, "hexadecimal escape without any hex digits\n") }
                            if code > 255 { complain(lineno, "hexadecimal escape out of range\n") }
                            s.put8(buffer + kp, @intCast(u8, code & 255))
                        } else if c == 92 || c == 39 || c == 34 {
                            s.put8(buffer + kp, c)
                            lp += 1
                            charsetDependent = true
                        } else if c == 110 || c == 116 || c == 114 || c == 102 || c == 98 || c == 97 || c == 118 {
                            const value: u8 = match c {
                                110 => 10
                                116 => 9
                                114 => 13
                                102 => 12
                                98 => 8
                                97 => 7
                                else => 11
                            }
                            s.put8(buffer + kp, value)
                            lp += 1
                            charsetDependent = true
                        } else {
                            die(lineno, "invalid escape sequence in string\n")
                        }
                    } else if c == 34 {
                        break
                    } else {
                        s.put8(buffer + kp, c)
                        lp += 1
                        charsetDependent = true
                    }
                    kp += 1
                }
                lp += 1
                if lp < lineEnd && byteAt(lp) != 10 {
                    if !isDelimiter(byteAt(lp)) { die(lineno, "string not followed by delimiter\n") }
                    lp += 1
                }
                chars = s.bytes(buffer, kp)
                rest = restOf(lp, lineEnd)
            } else {
                // Not a string: up to the delimiter.
                var lp = line
                while true {
                    if !(lp < lineEnd && byteAt(lp) != 10) {
                        chars = input.*.text[line..lp]
                        break
                    }
                    if isDelimiter(byteAt(lp)) {
                        chars = input.*.text[line..lp]
                        lp += 1
                        rest = restOf(lp, lineEnd)
                        break
                    }
                    lp += 1
                }
                if chars.length > 0 { charsetDependent = true }
            }
            const keyword = kw.addKeyword(chars, rest, lineno)
            const cons = kw.node(keyword)
            if tail < 0 { head = cons } else { kw.setNext(tail, cons) }
            tail = cons
        }
        lineno += 1
        line = lineEnd
    }
    if head < 0 {
        s.say(s.join(prettyInputFileName(), ": No keywords in input file!\n"))
        io.exit(1)
    }
    input.*.head = head
    input.*.charsetDependent = charsetDependent
}

pub fn read() -> void {
    unsafe { input = @ptrFromInt(*Input, s.alloc(@sizeOf(Input))) }
    var ok = false
    const text = io.readAll(opt.o.*.inputFileName, !opt.o.*.hasInputFile, &ok)
    if !ok {
        s.say(s.join3("Cannot open input file '", opt.o.*.inputFileName, "'\n"))
        io.exit(1)
    }
    if text.length == 0 {
        s.say(s.join(prettyInputFileName(), ": The input file is empty!\n"))
        io.exit(1)
    }
    input.*.text = text
    input.*.verbatimDeclarations = ""
    input.*.verbatimDeclarationsLineno = 0
    input.*.verbatimCode = ""
    input.*.verbatimCodeLineno = 0
    input.*.structDecl = ""
    input.*.structDeclLineno = 0
    input.*.returnType = ""
    input.*.structTag = ""
    input.*.charsetDependent = false
    input.*.head = -1
    const inputEnd = text.length

    // The %% separator lines.
    var separator: [2]usize = undefined
    var separatorLineno: [2]i64 = undefined
    var separators: usize = 0
    var lineno: i64 = 1
    var p: usize = 0
    while p < inputEnd {
        if byteAt(p) == 37 && byteAt(p + 1) == 37 {
            separator[separators] = p
            separatorLineno[separators] = lineno
            separators += 1
            if separators == 2 { break }
        }
        lineno += 1
        p = lineEndOf(p, inputEnd)
    }

    var hasDeclarations = false
    if separators == 1 {
        if opt.has(opt.TYPE) {
            hasDeclarations = true
        } else {
            p = 0
            while p < separator[0] {
                if byteAt(p) == 37 {
                    hasDeclarations = true
                    break
                }
                p = lineEndOf(p, separator[0])
            }
        }
    } else {
        hasDeclarations = separators > 0
    }

    var declarations: usize = 0
    var declarationsEnd: usize = 0
    var keywords: usize = 0
    var keywordsLineno: i64 = 1
    if hasDeclarations {
        declarationsEnd = separator[0]
        var nonempty = false
        p = declarationsEnd + 2
        while p < inputEnd {
            if byteAt(p) == 10 {
                p += 1
                break
            }
            if !(byteAt(p) == 32 || byteAt(p) == 9) { nonempty = true }
            p += 1
        }
        if nonempty { complain(separatorLineno[0], "warning: junk after %% is ignored\n") }
        keywords = p
        keywordsLineno = separatorLineno[0] + 1
    }
    var keywordsEnd = inputEnd
    const codeSeparators: usize = if hasDeclarations { 1 } else { 0 }
    if separators > codeSeparators {
        keywordsEnd = separator[separators - 1]
        input.*.verbatimCode = text[separator[separators - 1] + 2..inputEnd]
        input.*.verbatimCodeLineno = separatorLineno[separators - 1]
    }

    // The declarations.
    var verbatimStart: usize = 0
    var inVerbatim = false
    var hadVerbatim = false
    var verbatimClosed = false
    var structText: []const u8 = ""
    var linenos: [*]i64 = undefined
    unsafe { linenos = @ptrFromInt([*]i64, s.alloc((declarationsEnd + 2) * 8)) }
    var lineCount: usize = 0
    lineno = 1
    var line = declarations
    while line < declarationsEnd {
        const lineEnd = lineEndOf(line, declarationsEnd)
        if byteAt(line) == 37 {
            const second = byteAt(line + 1)
            if second == 123 {
                if hadVerbatim {
                    s.say(s.join3(prettyInputFileName(), ":", s.join3(s.signedDecimal(input.*.verbatimDeclarationsLineno), ":\n", "")))
                    die(lineno, "only one %{...%} section is allowed\n")
                }
                hadVerbatim = true
                inVerbatim = true
                verbatimStart = line + 2
                input.*.verbatimDeclarationsLineno = lineno
            } else if second == 125 {
                if !hadVerbatim { die(lineno, "%} outside of %{...%} section\n") }
                if verbatimClosed { die(lineno, "%{...%} section already closed\n") }
                verbatimClosed = true
                inVerbatim = false
                input.*.verbatimDeclarations = if line > verbatimStart { text[verbatimStart..line] } else { "" }
                var nonempty = false
                var q = line + 2
                while q < lineEnd {
                    if byteAt(q) == 10 { break }
                    if !(byteAt(q) == 32 || byteAt(q) == 9) { nonempty = true }
                    q += 1
                }
                if nonempty { complain(lineno, "warning: junk after %} is ignored\n") }
            } else if inVerbatim {
                complain(lineno, "warning: % directives are ignored inside the %{...%} section\n")
            } else {
                directive(line, lineEnd, lineno)
            }
        } else if !inVerbatim {
            // The line goes to the struct declaration.
            var stop = line
            while stop < lineEnd && byteAt(stop) != 0 { stop += 1 }
            structText = s.join(structText, text[line..stop])
            linenos[lineCount] = lineno
            lineCount += 1
        }
        lineno += 1
        line = lineEnd
    }
    if inVerbatim {
        s.say(s.join3(prettyInputFileName(), ":", s.join(s.signedDecimal(input.*.verbatimDeclarationsLineno), ": unterminated %{ section\n")))
        io.exit(1)
    }
    if opt.has(opt.TYPE) { structDeclaration(structText, linenos, lineCount) }

    keywordLines(keywords, keywordsEnd, keywordsLineno)
}
