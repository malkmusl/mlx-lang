// WebKit's CodeGenerator.pm: the IDL file of each target processed (its
// partial interfaces, mixins and partial dictionaries merged in), and the
// helpers every bindings generator asks: what an IDL type is, the
// interfaces, dictionaries and enumerations of other IDL files (parsed
// as asked for and kept for the rest of the process), the names of
// things, conditional strings. Its caches live as long as the process,
// one batch of files, as in the Perl.
const std = @import("std")
const r = @import("./bindingsrt.mlx")
const m = @import("./idlmodel.mlx")
const parser = @import("./idlparser.mlx")
const js = @import("./bindingsjs.mlx")
const Str = r.Str
const Node = m.Node
const IDLType = m.IDLType

pub const Generation = struct {
    defines: Str
    outputDirectory: Str
    idlFileNamesList: Str
    idlAttributesFile: Str
    supplementalDependencyFile: Str
    ignoreStandaloneConstructorAttributes: bool
}

pub var macros: *r.Map = undefined
pub var outputDirectory: [*]const u8 = undefined
pub var outputDirectoryLength: usize = 0
pub var ignoreStandaloneConstructorAttributes: bool = false
var idlFileNamesListPath: [*]const u8 = undefined
var idlFileNamesListLength: usize = 0
var targetPath: [*]const u8 = undefined
var targetPathLength: usize = 0

// The document being generated.
pub var useDocument: *m.Document = undefined

// Basename of an IDL file -> the sorted paths of the files supplementing it.
var supplementalDependencies: *r.Map = undefined
var hasSupplementalDependencies: bool = false

// Caches, for the process.
var idlFiles: *r.Map = undefined
var idlFilesLoaded: bool = false
var childrenMap: *r.Map = undefined
var childrenMapBuilt: bool = false
var cachedInterfaces: *r.Map = undefined
var cachedExtendedAttributes: *r.Map = undefined
var cachedExternalDictionaries: *r.Map = undefined
var cachedExternalEnumerations: *r.Map = undefined
var cachedTypes: *r.Map = undefined
var cachedParsedDocuments: *r.Map = undefined
var dictionaryTypeImplementationNameOverrides: *r.Map = undefined
var enumTypeImplementationNameOverrides: *r.Map = undefined
var isCallbackInterfaceCache: *r.Map = undefined
var isCallbackFunctionCache: *r.Map = undefined
var conditionalStringCache: *r.Map = undefined
var fileContentsCache: *r.Map = undefined

pub fn outputDir() -> Str { return outputDirectory[0..outputDirectoryLength] }
pub fn targetIdlFilePath() -> Str { return targetPath[0..targetPathLength] }

pub fn prepare(g: *Generation) -> void {
    parser.loadAttributes(g.*.idlAttributesFile)
    macros = parser.macrosOf(g.*.defines)
    outputDirectory = g.*.outputDirectory.pointer
    outputDirectoryLength = g.*.outputDirectory.length
    idlFileNamesListPath = g.*.idlFileNamesList.pointer
    idlFileNamesListLength = g.*.idlFileNamesList.length
    ignoreStandaloneConstructorAttributes = g.*.ignoreStandaloneConstructorAttributes
    cachedInterfaces = r.newMap()
    cachedExtendedAttributes = r.newMap()
    cachedExternalDictionaries = r.newMap()
    cachedExternalEnumerations = r.newMap()
    cachedTypes = r.newMap()
    cachedParsedDocuments = r.newMap()
    dictionaryTypeImplementationNameOverrides = r.newMap()
    enumTypeImplementationNameOverrides = r.newMap()
    isCallbackInterfaceCache = r.newMap()
    isCallbackFunctionCache = r.newMap()
    conditionalStringCache = r.newMap()
    fileContentsCache = r.newMap()
    supplementalDependencies = r.newMap()
    if r.isDef(g.*.supplementalDependencyFile) {
        hasSupplementalDependencies = true
        const text = r.readWhole(g.*.supplementalDependencyFile)
        var at: usize = 0
        while at < text.length {
            var end = at
            while end < text.length && text[end] != 10 { end += 1 }
            const fields = r.splitSpaceRegex(text[at..end])
            at = end + 1
            if fields.count == 0 || fields.items[0].length == 0 { continue }
            const following: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.alloc(@sizeOf(r.StrList))) }
            following.* = r.strList()
            var index: usize = 1
            while index < fields.count {
                r.spush(following, fields.items[index])
                index += 1
            }
            r.ssort(following)
            r.set(supplementalDependencies, r.baseName(fields.items[0]), @intFromPtr(following))
        }
    }
}

fn supplementsOf(fileName: Str) -> r.StrList {
    const address = r.get(supplementalDependencies, fileName)
    if address == 0 { return r.strList() }
    const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, address) }
    return l.*
}

// The text of FILE, as slurp reads it.
pub fn slurp(file: Str) -> Str {
    const address = r.get(fileContentsCache, file)
    if address != 0 { return r.getStr(fileContentsCache, file) }
    const text = r.readWhole(file)
    r.setStr(fileContentsCache, file, text)
    return text
}

pub fn parse(file: Str) -> *m.Document { return parser.parse(file, macros) }

// ---------------------------------------------------------------------------
// Documents.

// generate-bindings-all's child: the bindings of the IDL file FILE.
pub fn generate(g: *Generation, file: Str) -> void {
    targetPath = file.pointer
    targetPathLength = file.length
    const document = parse(file)
    processDocument(document)
}

fn processDocument(document: *m.Document) -> void {
    useDocument = document
    if document.*.interfaces.count > 0 {
        processInterfaces(document)
        return
    }
    if document.*.callbackFunctions.count > 0 {
        if document.*.callbackFunctions.count > 1 { r.die("Multiple standalone callback functions per document are not supported") }
        const callback = m.node(document.*.callbackFunctions, 0)
        processDictionaryAndEnumerationImplementedAsOverrides(document)
        js.generateCallbackFunction(callback, document.*.enumerations, document.*.dictionaries)
        js.writeData(callback, outputDir())
        return
    }
    if document.*.dictionaries.count > 0 {
        processDictionaries(document)
        return
    }
    if document.*.enumerations.count > 0 {
        if document.*.enumerations.count > 1 { r.die("Multiple standalone enumerations per document are not supported") }
        const enumeration = m.node(document.*.enumerations, 0)
        processDictionaryAndEnumerationImplementedAsOverrides(document)
        js.generateEnumeration(enumeration)
        js.writeData(enumeration, outputDir())
        return
    }
}

fn generateEmptyHeaderAndCpp(document: *m.Document) -> void {
    const targetName = r.baseNameWithout(document.*.fileName, ".idl")
    const headerName = r.cat([_]Str{ "JS", targetName, ".h" }[0..])
    const cppName = r.cat([_]Str{ "JS", targetName, ".cpp" }[0..])
    const contents = r.cat([_]Str{ "/*\n    This file is generated to inform build scripts that ", headerName, " and\n    ", cppName, " were created for ", targetName, ".idl, and prevent the build\n    scripts from trying to regenerate ", headerName, " and ", cppName, " on every build.\n*/\n" }[0..])
    r.writeFile(r.cat([_]Str{ outputDir(), "/", headerName }[0..]), contents)
    r.writeFile(r.cat([_]Str{ outputDir(), "/", cppName }[0..]), contents)
}

fn processDictionaryAndEnumerationImplementedAsOverrides(document: *m.Document) -> void {
    var index: usize = 0
    while index < document.*.dictionaries.count {
        const d = m.node(document.*.dictionaries, index)
        if m.on(d.*.ext, "ImplementedAs") { r.setStr(dictionaryTypeImplementationNameOverrides, m.typeName(d), m.get(d.*.ext, "ImplementedAs")) }
        index += 1
    }
    index = 0
    while index < document.*.enumerations.count {
        const e = m.node(document.*.enumerations, index)
        if m.on(e.*.ext, "ImplementedAs") { r.setStr(enumTypeImplementationNameOverrides, m.typeName(e), m.get(e.*.ext, "ImplementedAs")) }
        index += 1
    }
}

fn processInterfaces(document: *m.Document) -> void {
    if document.*.interfaces.count > 1 { r.die("Multiple interfaces per document are not supported") }
    const interface = m.node(document.*.interfaces, 0)
    if interface.*.isMixin || interface.*.isPartial {
        generateEmptyHeaderAndCpp(document)
        return
    }
    processInterfaceSupplementalDependencies(interface, document)
    processDictionaryAndEnumerationImplementedAsOverrides(document)
    js.generateInterface(interface, document.*.enumerations, document.*.dictionaries)
    js.writeData(interface, outputDir())
}

fn processDictionaries(document: *m.Document) -> void {
    var dictionary: ?*Node = null
    var otherDictionaries = r.list()
    var hasOthers = false
    if document.*.dictionaries.count == 1 {
        dictionary = m.node(document.*.dictionaries, 0)
    } else {
        const primary = r.baseNameWithout(targetIdlFilePath(), ".idl")
        var index: usize = 0
        while index < document.*.dictionaries.count {
            const candidate = m.node(document.*.dictionaries, index)
            if std.text.same(m.typeName(candidate), primary) {
                dictionary = candidate
            } else {
                r.push(&otherDictionaries, @intFromPtr(candidate))
                hasOthers = true
            }
            index += 1
        }
        if dictionary == null { r.die("Multiple dictionaries per document are only supported if one matches the filename") }
    }
    const d = dictionary.?
    if d.*.isPartial {
        generateEmptyHeaderAndCpp(document)
        return
    }
    processDictionarySupplementalDependencies(d, document)
    processDictionaryAndEnumerationImplementedAsOverrides(document)
    js.generateDictionary(d, document.*.enumerations, otherDictionaries)
    js.writeData(d, outputDir())
}

// The extended attributes of SUPPLEMENTAL allowed in CONTEXT, put on PROPERTY.
fn mergeExtendedAttributesFromSupplemental(supplemental: *m.Ext, property: *Node, context: Str) -> void {
    var index: usize = 0
    while index < supplemental.*.names.count {
        const name = supplemental.*.names.items[index]
        const v = r.at(*m.Value, supplemental.*.values, index)
        index += 1
        if !parser.attributeAllowedIn(name, context) { continue }
        if std.text.same(name, "Conditional") && !std.text.same(context, "operation") {
            m.setValue(property.*.ext, name, v)
            continue
        }
        if m.on(property.*.ext, name) {
            const info = parser.attributeInfo(name)
            if info == null || !info.?.*.supportsConjunction { r.die(r.c3("Duplicate non-mergeable extended attribute (", name, ") found when merging extended attributes")) }
            m.set(property.*.ext, name, r.c3(m.get(property.*.ext, name), "&", m.textOf(v)))
        } else {
            m.setValue(property.*.ext, name, v)
        }
    }
}

fn isValidSupplementalInterface(supplemental: *Node, target: *Node, includesMap: *r.Map) -> bool {
    if supplemental.*.isPartial && std.text.same(m.typeName(supplemental), m.typeName(target)) { return true }
    if supplemental.*.isMixin && r.has(includesMap, m.typeName(supplemental)) { return true }
    return false
}

// A document of FILE fresh from the parser: the first parse kept, copies
// of it handed out (as the Perl's dclone).
fn supplementalDocument(file: Str) -> *m.Document {
    if r.has(cachedParsedDocuments, file) {
        const cached: *m.Document = unsafe { @ptrFromInt(*m.Document, r.get(cachedParsedDocuments, file)) }
        return m.cloneDocument(cached)
    }
    const document = parse(file)
    r.set(cachedParsedDocuments, file, @intFromPtr(m.cloneDocument(document)))
    return document
}

// The global contexts of an [Exposed] value as shouldPropertyBeExposed
// splits it; a list value (as the parser makes of =(A,B)) is one context
// that matches nothing ("ARRAY(0x...)").
fn exposedContexts(v: Str) -> r.StrList {
    var text = v
    if text.length > 0 && text[0] == 40 { text = r.substrInner(text, 1, 1) }
    return r.splitByte(text, 44)
}

fn contextMatches(pattern: Str, context: Str) -> bool {
    for byte in pattern {
        if !r.isWord(byte) { return false }
    }
    return std.text.same(pattern, context)
}

pub fn shouldPropertyBeExposed(context: *Node, target: *Node) -> bool {
    const exposedAttribute = r.orElse(m.get(target.*.ext, "Exposed"), "Window")
    if std.text.same(exposedAttribute, "*") { return true }
    const targetContexts = exposedContexts(exposedAttribute)
    const exposed = m.get(context.*.ext, "Exposed")
    if !r.truthy(exposed) { return true }
    const sourceContexts = exposedContexts(exposed)
    var t: usize = 0
    while t < targetContexts.count {
        var s: usize = 0
        while s < sourceContexts.count {
            if contextMatches(targetContexts.items[t], sourceContexts.items[s]) { return true }
            s += 1
        }
        t += 1
    }
    return false
}

fn processInterfaceSupplementalDependencies(target: *Node, targetDocument: *m.Document) -> void {
    if !hasSupplementalDependencies { return }
    const targetFileName = r.baseName(targetDocument.*.fileName)
    const supplements = supplementsOf(targetFileName)
    var includesMap = r.map()
    var index: usize = 0
    while index < targetDocument.*.includes.count {
        const include = m.node(targetDocument.*.includes, index)
        index += 1
        if std.text.same(include.*.interfaceIdentifier, m.typeName(target)) {
            var found = false
            var k: usize = 0
            while k < supplements.count {
                if std.text.same(r.baseNameWithout(supplements.items[k], ".idl"), include.*.mixinIdentifier) { found = true }
                k += 1
            }
            if !found { r.die(r.cat([_]Str{ "included interface mixin ", include.*.mixinIdentifier, " not in supplemental dependencies." }[0..])) }
            r.set(&includesMap, include.*.mixinIdentifier, @intFromPtr(include))
        }
    }
    index = 0
    while index < supplements.count {
        const idlFile = supplements.items[index]
        index += 1
        if std.text.same(r.baseName(idlFile), targetFileName) { continue }
        const document = supplementalDocument(idlFile)
        var i: usize = 0
        while i < document.*.interfaces.count {
            const interface = m.node(document.*.interfaces, i)
            i += 1
            if !isValidSupplementalInterface(interface, target, &includesMap) { continue }
            var e: usize = 0
            while e < document.*.enumerations.count {
                const enumeration = m.node(document.*.enumerations, e)
                e += 1
                var present = false
                var k: usize = 0
                while k < targetDocument.*.enumerations.count {
                    if std.text.same(m.typeName(m.node(targetDocument.*.enumerations, k)), m.typeName(enumeration)) { present = true }
                    k += 1
                }
                if !present { r.push(&targetDocument.*.enumerations, @intFromPtr(enumeration)) }
            }
            const fromMixin = interface.*.isMixin && !interface.*.isPartial
            if fromMixin { processInterfaceSupplementalDependencies(interface, document) }
            var includeExt: *m.Ext = m.newExt()
            if fromMixin {
                const include: *Node = unsafe { @ptrFromInt(*Node, r.get(&includesMap, m.typeName(interface))) }
                includeExt = include.*.ext
            }
            var a: usize = 0
            while a < interface.*.attributes.count {
                const attribute = m.node(interface.*.attributes, a)
                a += 1
                if !(target.*.isMixin || shouldPropertyBeExposed(attribute, target)) { continue }
                if fromMixin { mergeExtendedAttributesFromSupplemental(includeExt, attribute, "attribute") }
                mergeExtendedAttributesFromSupplemental(interface.*.ext, attribute, "attribute")
                r.push(&target.*.attributes, @intFromPtr(attribute))
            }
            var o: usize = 0
            while o < interface.*.operations.count {
                const operation = m.node(interface.*.operations, o)
                o += 1
                if !(target.*.isMixin || shouldPropertyBeExposed(operation, target)) { continue }
                if fromMixin { mergeExtendedAttributesFromSupplemental(includeExt, operation, "operation") }
                mergeExtendedAttributesFromSupplemental(interface.*.ext, operation, "operation")
                r.push(&target.*.operations, @intFromPtr(operation))
            }
            var c: usize = 0
            while c < interface.*.constants.count {
                const constant = m.node(interface.*.constants, c)
                c += 1
                if !(target.*.isMixin || shouldPropertyBeExposed(constant, target)) { continue }
                if fromMixin { mergeExtendedAttributesFromSupplemental(includeExt, constant, "constant") }
                mergeExtendedAttributesFromSupplemental(interface.*.ext, constant, "constant")
                r.push(&target.*.constants, @intFromPtr(constant))
            }
        }
    }
}

fn processDictionarySupplementalDependencies(target: *Node, targetDocument: *m.Document) -> void {
    if !hasSupplementalDependencies { return }
    const targetFileName = r.baseName(targetDocument.*.fileName)
    const supplements = supplementsOf(targetFileName)
    var index: usize = 0
    while index < supplements.count {
        const idlFile = supplements.items[index]
        index += 1
        if std.text.same(r.baseName(idlFile), targetFileName) { continue }
        const document = supplementalDocument(idlFile)
        var d: usize = 0
        while d < document.*.dictionaries.count {
            const dictionary = m.node(document.*.dictionaries, d)
            d += 1
            if !(dictionary.*.isPartial && std.text.same(m.typeName(dictionary), m.typeName(target))) { continue }
            var k: usize = 0
            while k < dictionary.*.members.count {
                const member = m.node(dictionary.*.members, k)
                k += 1
                if !shouldPropertyBeExposed(member, target) { continue }
                mergeExtendedAttributesFromSupplemental(dictionary.*.ext, member, "dictionary-member")
                r.push(&target.*.members, @intFromPtr(member))
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Other IDL files.

// The path of the IDL file of NAME, undef when the list has none.
pub fn idlFileForInterface(name: Str) -> Str {
    if !idlFilesLoaded {
        idlFiles = r.newMap()
        idlFilesLoaded = true
        const text = r.readWhole(idlFileNamesListPath[0..idlFileNamesListLength])
        var at: usize = 0
        while at < text.length {
            var end = at
            while end < text.length && text[end] != 10 { end += 1 }
            const line = text[at..end]
            at = end + 1
            r.setStr(idlFiles, r.baseNameWithout(line, ".idl"), line)
        }
    }
    return r.getStr(idlFiles, name)
}

// The interface NAME (as its own IDL file declares it), parsed once.
pub fn parseInterface(outer: *Node, name: Str) -> ?*Node {
    if std.text.same(name, "Object") || std.text.same(name, "UNION") { return null }
    if r.has(cachedInterfaces, name) { return unsafe { @ptrFromInt(*Node, r.get(cachedInterfaces, name)) } }
    const file = idlFileForInterface(name)
    if !r.truthy(file) { r.die(r.cat([_]Str{ "Could NOT find IDL file for interface \"", name, "\", reachable from \"", m.typeName(outer), "\"!" }[0..])) }
    const document = parse(file)
    var index: usize = 0
    while index < document.*.interfaces.count {
        const interface = m.node(document.*.interfaces, index)
        if std.text.same(m.typeName(interface), name) {
            r.set(cachedInterfaces, name, @intFromPtr(interface))
            return interface
        }
        index += 1
    }
    r.die(r.c3("Could NOT find interface definition for ", name, r.c2(" in ", file)))
    return null
}

pub fn parseTypeString(text: Str) -> *IDLType {
    if r.has(cachedTypes, text) { return unsafe { @ptrFromInt(*IDLType, r.get(cachedTypes, text)) } }
    const t = parser.parseTypeString(text)
    r.set(cachedTypes, text, @intFromPtr(t))
    return t
}

// The ancestors of INTERFACE, parent first (ForAllParents' order before
// its recursion), each parsed.
pub fn parents(interface: *Node) -> r.List {
    var result = r.list()
    var current = interface
    while current.*.parentType != null {
        const parent = parseInterface(interface, current.*.parentType.?.*.name)
        if parent == null { break }
        r.push(&result, @intFromPtr(parent.?))
        current = parent.?
    }
    return result
}

// Whether the text of a file has "WORD", white space and NAME.
fn hasDeclaration(text: Str, word: Str, name: Str) -> bool {
    var at: usize = 0
    while true {
        const found = r.findFrom(text, word, at)
        if found >= text.length { return false }
        at = found + 1
        if found > 0 && r.isWord(text[found - 1]) { continue }
        var p = found + word.length
        const start = p
        while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
        if p == start { continue }
        if std.text.startsWith(text[p..text.length], name) { return true }
    }
    return false
}

// The enumeration NAME: of the document, or of its own IDL file.
pub fn getEnumByType(t: *IDLType) -> ?*Node {
    const name = t.*.name
    var index: usize = 0
    while index < useDocument.*.enumerations.count {
        const e = m.node(useDocument.*.enumerations, index)
        if std.text.same(m.typeName(e), name) { return e }
        index += 1
    }
    if r.has(cachedExternalEnumerations, name) {
        const address = r.get(cachedExternalEnumerations, name)
        if address == 1 { return null }
        return unsafe { @ptrFromInt(*Node, address) }
    }
    const file = idlFileForInterface(name)
    if !r.truthy(file) { return null }
    const text = slurp(file)
    if hasDeclaration(text, "enum", name) {
        const document = parse(file)
        index = 0
        while index < document.*.enumerations.count {
            const e = m.node(document.*.enumerations, index)
            index += 1
            if !std.text.same(m.typeName(e), name) { continue }
            r.set(cachedExternalEnumerations, name, @intFromPtr(e))
            const implementedAs = m.get(e.*.ext, "ImplementedAs")
            if r.truthy(implementedAs) { r.setStr(enumTypeImplementationNameOverrides, m.typeName(e), implementedAs) }
            return e
        }
    }
    r.set(cachedExternalEnumerations, name, 1)
    return null
}

fn cachedExternalEnumeration(name: Str) -> bool {
    const address = r.get(cachedExternalEnumerations, name)
    return address > 1
}

pub fn isEnumType(t: *IDLType) -> bool { return getEnumByType(t) != null }
pub fn isExternalEnumType(t: *IDLType) -> bool { return isEnumType(t) && cachedExternalEnumeration(t.*.name) }
pub fn hasEnumImplementationNameOverride(t: *IDLType) -> bool { return r.has(enumTypeImplementationNameOverrides, t.*.name) }
pub fn getEnumImplementationNameOverride(t: *IDLType) -> Str { return r.getStr(enumTypeImplementationNameOverrides, t.*.name) }

pub fn getDictionaryByType(t: *IDLType) -> ?*Node {
    const name = t.*.name
    var index: usize = 0
    while index < useDocument.*.dictionaries.count {
        const d = m.node(useDocument.*.dictionaries, index)
        if std.text.same(m.typeName(d), name) { return d }
        index += 1
    }
    if r.has(cachedExternalDictionaries, name) {
        const address = r.get(cachedExternalDictionaries, name)
        if address == 1 { return null }
        return unsafe { @ptrFromInt(*Node, address) }
    }
    const file = idlFileForInterface(name)
    if !r.truthy(file) { return null }
    const text = slurp(file)
    if hasDeclaration(text, "dictionary", name) {
        const document = parse(file)
        index = 0
        while index < document.*.dictionaries.count {
            const d = m.node(document.*.dictionaries, index)
            index += 1
            if !std.text.same(m.typeName(d), name) { continue }
            processDictionarySupplementalDependencies(d, document)
            r.set(cachedExternalDictionaries, name, @intFromPtr(d))
            const implementedAs = m.get(d.*.ext, "ImplementedAs")
            if r.truthy(implementedAs) { r.setStr(dictionaryTypeImplementationNameOverrides, name, implementedAs) }
            return d
        }
    }
    r.set(cachedExternalDictionaries, name, 1)
    return null
}

pub fn isDictionaryType(t: *IDLType) -> bool {
    if t.*.name.length == 0 || !r.isUpper(t.*.name[0]) { return false }
    return getDictionaryByType(t) != null
}

pub fn isExternalDictionaryType(t: *IDLType) -> bool { return isDictionaryType(t) && r.get(cachedExternalDictionaries, t.*.name) > 1 }
pub fn hasDictionaryImplementationNameOverride(t: *IDLType) -> bool { return r.has(dictionaryTypeImplementationNameOverrides, t.*.name) }
pub fn getDictionaryImplementationNameOverride(t: *IDLType) -> Str { return r.getStr(dictionaryTypeImplementationNameOverrides, t.*.name) }

// ---------------------------------------------------------------------------
// Types.

fn oneOf(value: Str, words: []const Str) -> bool {
    for word in words {
        if std.text.same(value, word) { return true }
    }
    return false
}

const integerTypes = [_]Str{ "byte", "long long", "long", "octet", "short", "unsigned long long", "unsigned long", "unsigned short" }
const floatingPointTypes = [_]Str{ "float", "unrestricted float", "double", "unrestricted double" }
const stringTypes = [_]Str{ "ByteString", "DOMString", "USVString" }
const bufferSourceTypes = [_]Str{ "ArrayBuffer", "ArrayBufferView", "DataView", "Float16Array", "Float32Array", "Float64Array", "Int16Array", "Int32Array", "Int8Array", "Uint16Array", "Uint32Array", "Uint8Array", "Uint8ClampedArray", "BigInt64Array", "BigUint64Array" }
const primitiveTypes = [_]Str{ "boolean", "undefined", "Date" }
const svgAttributesInHTML = [_]Str{ "class", "id", "onabort", "onclick", "onerror", "onload", "onmousedown", "onmouseenter", "onmouseleave", "onmousemove", "onmouseout", "onmouseover", "onmouseup", "onresize", "onscroll", "onunload" }

pub fn isNumericType(t: *IDLType) -> bool { return oneOf(t.*.name, integerTypes[0..]) || oneOf(t.*.name, floatingPointTypes[0..]) }
pub fn isIntegerType(t: *IDLType) -> bool { return oneOf(t.*.name, integerTypes[0..]) }
pub fn isFloatingPointType(t: *IDLType) -> bool { return oneOf(t.*.name, floatingPointTypes[0..]) }
pub fn isPrimitiveType(t: *IDLType) -> bool { return oneOf(t.*.name, primitiveTypes[0..]) || isNumericType(t) }
pub fn isStringType(t: *IDLType) -> bool { return oneOf(t.*.name, stringTypes[0..]) }
pub fn isStringOrEnumType(t: *IDLType) -> bool { return isStringType(t) || isEnumType(t) }
pub fn isSVGAnimatedTypeName(name: Str) -> bool { return std.text.startsWith(name, "SVGAnimated") }
pub fn isSVGAnimatedType(t: *IDLType) -> bool { return isSVGAnimatedTypeName(t.*.name) }
pub fn isSVGPathSegTypeName(name: Str) -> bool { return std.text.startsWith(name, "SVGPathSeg") }
pub fn isSVGPathSegType(t: *IDLType) -> bool { return isSVGPathSegTypeName(t.*.name) }
pub fn isConstructorType(t: *IDLType) -> bool { return std.text.endsWith(t.*.name, "Constructor") }
pub fn isEventHandlerType(t: *IDLType) -> bool { return std.text.endsWith(t.*.name, "EventHandler") }
pub fn isSequenceType(t: *IDLType) -> bool { return std.text.same(t.*.name, "sequence") }
pub fn isFrozenArrayType(t: *IDLType) -> bool { return std.text.same(t.*.name, "FrozenArray") }
pub fn isSequenceOrFrozenArrayType(t: *IDLType) -> bool { return isSequenceType(t) || isFrozenArrayType(t) }
pub fn isRecordType(t: *IDLType) -> bool { return std.text.same(t.*.name, "record") }
pub fn isBufferSourceType(t: *IDLType) -> bool { return oneOf(t.*.name, bufferSourceTypes[0..]) }
pub fn isPromiseType(t: *IDLType) -> bool { return std.text.same(t.*.name, "Promise") }

pub fn isBuiltinType(t: *IDLType) -> bool {
    if isPrimitiveType(t) || isSequenceOrFrozenArrayType(t) || isRecordType(t) || isStringType(t) || isBufferSourceType(t) { return true }
    if t.*.isUnion { return true }
    const names = [_]Str{ "EventListener", "JSON", "Promise", "ScheduledAction", "SerializedScriptValue", "any", "object" }
    return oneOf(t.*.name, names[0..])
}

pub fn isInterfaceType(t: *IDLType) -> bool {
    if isBuiltinType(t) { return false }
    if isDictionaryType(t) { return false }
    if isEnumType(t) { return false }
    return true
}

pub fn isWrapperType(t: *IDLType) -> bool { return isInterfaceType(t) }

pub fn interfaceHasRegularToJSONOperation(interface: *Node) -> bool {
    var index: usize = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        if !operation.*.isStatic && std.text.same(operation.*.name, "toJSON") { return true }
        index += 1
    }
    return false
}

pub fn isJSONType(interface: *Node, t: *IDLType) -> bool {
    if std.text.same(t.*.name, "object") || std.text.same(t.*.name, "boolean") { return true }
    if isNumericType(t) || isStringOrEnumType(t) { return true }
    if isSequenceOrFrozenArrayType(t) || isRecordType(t) { return isJSONType(interface, m.subtype(t, 0)) }
    if isInterfaceType(t) {
        if isEventHandlerType(t) { return false }
        const other = parseInterface(interface, t.*.name).?
        if interfaceHasRegularToJSONOperation(other) { return true }
        const chain = parents(other)
        var any = false
        var index: usize = 0
        while index < chain.count {
            if interfaceHasRegularToJSONOperation(m.node(chain, index)) { any = true }
            index += 1
        }
        if any { return true }
    }
    if t.*.isUnion { r.die("Default toJSON is currently not supported for union types.") }
    if isDictionaryType(t) { r.die("Default toJSON is currently not supported for dictionary types.") }
    return false
}

fn computeIsCallbackInterface(t: *IDLType) -> bool {
    if !isInterfaceType(t) { return false }
    if std.text.same(t.*.name, "WindowProxy") { return false }
    const file = idlFileForInterface(t.*.name)
    if !r.truthy(file) { r.die(r.c3("Could NOT find IDL file for interface \"", t.*.name, "\"!")) }
    const text = slurp(file)
    // /callback\s+interface\s+(\w+)/
    var at: usize = 0
    while true {
        const found = r.findFrom(text, "callback", at)
        if found >= text.length { return false }
        at = found + 1
        var p = found + 8
        const s1 = p
        while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
        if p == s1 || !std.text.startsWith(text[p..text.length], "interface") { continue }
        p += 9
        const s2 = p
        while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
        if p > s2 && p < text.length && r.isWord(text[p]) { return true }
    }
    return false
}

pub fn isCallbackInterface(t: *IDLType) -> bool {
    if r.has(isCallbackInterfaceCache, t.*.name) { return r.get(isCallbackInterfaceCache, t.*.name) == 2 }
    const result = computeIsCallbackInterface(t)
    r.set(isCallbackInterfaceCache, t.*.name, if result { 2 } else { 1 })
    return result
}

fn computeIsCallbackFunction(t: *IDLType) -> bool {
    if !isInterfaceType(t) { return false }
    if std.text.same(t.*.name, "WindowProxy") { return false }
    const file = idlFileForInterface(t.*.name)
    if !r.truthy(file) { r.die(r.c3("Could NOT find IDL file for interface \"", t.*.name, "\"!")) }
    const text = slurp(file)
    // /(.*)callback\s+(\w+)\s+=/
    var at: usize = 0
    while true {
        const found = r.findFrom(text, "callback", at)
        if found >= text.length { return false }
        at = found + 1
        var p = found + 8
        const s1 = p
        while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
        if p == s1 { continue }
        const w = p
        while p < text.length && r.isWord(text[p]) { p += 1 }
        if p == w { continue }
        const s2 = p
        while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
        if p > s2 && p < text.length && text[p] == 61 { return true }
    }
    return false
}

pub fn isCallbackFunction(t: *IDLType) -> bool {
    if r.has(isCallbackFunctionCache, t.*.name) { return r.get(isCallbackFunctionCache, t.*.name) == 2 }
    const result = computeIsCallbackFunction(t)
    r.set(isCallbackFunctionCache, t.*.name, if result { 2 } else { 1 })
    return result
}

// GetInterfaceExtendedAttributesFromName: the attributes before the
// interface in NAME's IDL file, read by a regular expression (a map of
// strings), or null.
pub fn getInterfaceExtendedAttributesFromName(name: Str) -> ?*r.Map {
    const file = idlFileForInterface(name)
    if !r.truthy(file) { r.die(r.c3("Could NOT find IDL file for interface \"", name, "\"!")) }
    if r.has(cachedExtendedAttributes, file) {
        const address = r.get(cachedExtendedAttributes, file)
        if address == 1 { return null }
        return unsafe { @ptrFromInt(*r.Map, address) }
    }
    const text = slurp(file)
    // /\[(.*)\]\s+(callback interface|interface)\s+(\w+)/gs
    const open = r.findByte(text, 91)
    var close = text.length
    if open < text.length {
        var at = text.length
        while at > open + 1 {
            at -= 1
            if text[at] != 93 { continue }
            var p = at + 1
            while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
            if p == at + 1 { continue }
            var length: usize = 0
            if std.text.startsWith(text[p..text.length], "callback interface") { length = 18 } else if std.text.startsWith(text[p..text.length], "interface") { length = 9 }
            if length == 0 { continue }
            var q = p + length
            const s = q
            while q < text.length && std.ascii.isCWhitespace(text[q]) { q += 1 }
            if q > s && q < text.length && r.isWord(text[q]) {
                close = at
                break
            }
        }
    }
    if close == text.length {
        r.set(cachedExtendedAttributes, file, 1)
        return null
    }
    const attributes = r.newMap()
    const parts = r.splitByte(text[open + 1..close], 44)
    var index: usize = 0
    while index < parts.count {
        const keyValue = r.splitByte(parts.items[index], 61)
        index += 1
        if keyValue.count == 0 { continue }
        const k = r.trim(keyValue.items[0])
        if k.length == 0 { continue }
        var v: Str = "VALUE_IS_MISSING"
        if keyValue.count > 1 { v = r.trim(keyValue.items[1]) }
        r.setStr(attributes, k, v)
    }
    r.set(cachedExtendedAttributes, file, @intFromPtr(attributes))
    return attributes
}

// ---------------------------------------------------------------------------
// Names.

// WK_ucfirst: the first letter upper case, as WebKit's style has it.
pub fn wkUcfirst(param: Str) -> Str {
    var ret = r.ucfirst(param)
    if std.text.startsWith(ret, "Xml") && ret.length > 3 && !r.isLower(ret[3]) { ret = r.replaceFirst(ret, "Xml", "XML") }
    if std.text.startsWith(ret, "Svg") { ret = r.replaceFirst(ret, "Svg", "SVG") }
    if std.text.startsWith(ret, "Srgb") { ret = r.replaceFirst(ret, "Srgb", "SRGB") }
    if std.text.startsWith(ret, "Cenc") { ret = r.replaceFirst(ret, "Cenc", "cenc") }
    if std.text.startsWith(ret, "Cbcs") { ret = r.replaceFirst(ret, "Cbcs", "cbcs") }
    if std.text.same(ret, "Pq") { ret = "PQ" }
    if std.text.startsWith(ret, "Hlg") { ret = r.replaceFirst(ret, "Hlg", "HLG") }
    if std.text.startsWith(ret, "Ios") { ret = r.replaceFirst(ret, "Ios", "iOS") }
    if std.text.startsWith(ret, "Hls") { ret = r.replaceFirst(ret, "Hls", "HLS") }
    return ret
}

pub fn wkLcfirst(param: Str) -> Str {
    var ret = r.lcfirst(param)
    if std.text.startsWith(ret, "dOM") { ret = r.replaceFirst(ret, "dOM", "dom") }
    if std.text.startsWith(ret, "hTML") { ret = r.replaceFirst(ret, "hTML", "html") }
    if std.text.startsWith(ret, "uRL") { ret = r.replaceFirst(ret, "uRL", "url") }
    if std.text.startsWith(ret, "jS") { ret = r.replaceFirst(ret, "jS", "js") }
    if std.text.startsWith(ret, "xML") { ret = r.replaceFirst(ret, "xML", "xml") }
    if std.text.startsWith(ret, "xSLT") { ret = r.replaceFirst(ret, "xSLT", "xslt") }
    if std.text.startsWith(ret, "cSS") { ret = r.replaceFirst(ret, "cSS", "css") }
    if std.text.startsWith(ret, "rTC") { ret = r.replaceFirst(ret, "rTC", "rtc") }
    if std.text.same(ret, "create") { ret = "isCreate" }
    if std.text.same(ret, "exclusive") { ret = "isExclusive" }
    return ret
}

// s/\-(.)/uc($1)/ge then s/\-//g.
fn camelCased(name: Str) -> Str {
    if !r.hasByte(name, 45) { return name }
    var b = r.buf()
    var index: usize = 0
    while index < name.length {
        if name[index] == 45 {
            if index + 1 < name.length && name[index + 1] != 10 {
                // The character after the dash, upper cased (a dash too is skipped).
                const next = name[index + 1]
                if next != 45 { r.addByte(&b, r.upperByte(next)) }
                index += 2
                continue
            }
            index += 1
            continue
        }
        r.addByte(&b, name[index])
        index += 1
    }
    return r.done(b)
}

pub fn namespaceForAttributeName(interfaceName: Str, attributeName: Str) -> Str {
    if std.text.startsWith(interfaceName, "SVG") && !oneOf(attributeName, svgAttributesInHTML[0..]) { return "SVGNames" }
    return "HTMLNames"
}

pub fn linkOverloadedOperations(interface: *Node) -> void {
    var regular = r.map()
    var static = r.map()
    var index: usize = 0
    while index < interface.*.operations.count {
        const operation = m.node(interface.*.operations, index)
        index += 1
        const map = if operation.*.isStatic { &static } else { &regular }
        if !r.has(map, operation.*.name) { r.set(map, operation.*.name, @intFromPtr(r.newList())) }
        const overloads: *r.List = unsafe { @ptrFromInt(*r.List, r.get(map, operation.*.name)) }
        r.push(overloads, @intFromPtr(operation))
        operation.*.overloads = overloads
        operation.*.overloadIndex = overloads.*.count
    }
    index = 0
    while index < interface.*.constructors.count {
        const constructor = m.node(interface.*.constructors, index)
        constructor.*.overloads = &interface.*.constructors
        constructor.*.overloadIndex = index + 1
        index += 1
    }
}

pub fn operationName(operation: *Node) -> Str {
    var name = wkLcfirst(camelCased(operation.*.name))
    if m.on(operation.*.ext, "ImplementedAs") { name = m.get(operation.*.ext, "ImplementedAs") }
    return name
}

pub fn attributeNameForGetterAndSetter(attribute: *Node) -> Str {
    var name = camelCased(attribute.*.name)
    if m.on(attribute.*.ext, "ImplementedAs") { name = m.get(attribute.*.ext, "ImplementedAs") }
    if isSVGAnimatedType(attribute.*.ty.?) { name = r.c2(name, "Animated") }
    return name
}

pub fn unquoteStringLiteral(text: Str) -> Str {
    if !r.truthy(text) { return text }
    if text.length < 2 { return text }
    if text[0] != 34 && text[0] != 39 {
        if !std.text.same(text, "VALUE_IS_MISSING") { r.die(r.c3("Identifier '", text, "' should be a string literal")) }
        return text
    }
    return r.substrInner(text, 1, 1)
}

// "WebCore::NAMESPACE::NAMEAttr" of a reflected attribute, undef when it
// is not reflected; the namespace's header goes into INCLUDES.
pub fn contentAttributeName(includes: *r.Map, interfaceName: Str, attribute: *Node, getterOrSetter: Str) -> Str {
    const reflect = m.get(attribute.*.ext, "Reflect")
    const reflectURL = m.get(attribute.*.ext, "ReflectURL")
    const reflectSetter = m.get(attribute.*.ext, "ReflectSetter")
    if r.truthy(reflectURL) && r.truthy(reflect) { r.die("Do not use both [ReflectURL] and [Reflect] on the same attribute") }
    if r.truthy(reflectURL) && r.truthy(reflectSetter) { r.die("Do not use both [ReflectURL] and [ReflectSetter] on the same attribute") }
    if r.truthy(reflect) && r.truthy(reflectSetter) { r.die("Do not use both [Reflect] and [ReflectSetter] on the same attribute") }
    var chosen = reflect
    if !r.truthy(chosen) { chosen = reflectURL }
    if std.text.same(getterOrSetter, "setter") && !r.truthy(chosen) { chosen = reflectSetter }
    var name = unquoteStringLiteral(chosen)
    if !r.truthy(name) { return r.undef() }
    name = r.replaceAll(name, "-", "_")
    if std.text.same(name, "VALUE_IS_MISSING") { name = r.lc(attribute.*.name) }
    const namespace = namespaceForAttributeName(interfaceName, name)
    r.setStr(includes, r.c2(namespace, ".h"), "1")
    return r.cat([_]Str{ "WebCore::", namespace, "::", name, "Attr" }[0..])
}

// GetterExpression: the function name, and the content attribute name
// ("" for none) as a second result.
pub fn getterExpression(includes: *r.Map, interfaceName: Str, attribute: *Node, contentName: *Str) -> Str {
    var content = contentAttributeName(includes, interfaceName, attribute, "getter")
    if !r.truthy(content) {
        contentName.* = r.undef()
        return wkLcfirst(attributeNameForGetterAndSetter(attribute))
    }
    const t = attribute.*.ty.?
    var functionName: Str = ""
    if m.on(attribute.*.ext, "ReflectURL") {
        r.setStr(includes, "ElementInlines.h", "1")
        functionName = "getURLAttributeForBindings"
    } else if std.text.same(t.*.name, "boolean") {
        r.setStr(includes, "ElementInlines.h", "1")
        functionName = "hasAttributeWithoutSynchronization"
    } else if std.text.same(t.*.name, "double") {
        functionName = "numericAttribute"
    } else if std.text.same(t.*.name, "long") {
        functionName = "integralAttribute"
    } else if std.text.same(t.*.name, "unsigned long") {
        functionName = "unsignedIntegralAttribute"
    } else if std.text.same(t.*.name, "Element") {
        functionName = "getElementAttributeForBindings"
    } else if std.text.same(t.*.name, "FrozenArray") && t.*.subtypes.count == 1 && std.text.same(m.subtype(t, 0).*.name, "Element") {
        functionName = "getElementsArrayAttribute"
    } else {
        if std.text.same(content, "WebCore::HTMLNames::idAttr") {
            functionName = "getIdAttribute"
            content = ""
        } else if std.text.same(content, "WebCore::HTMLNames::nameAttr") {
            r.setStr(includes, "ElementInlines.h", "1")
            functionName = "getNameAttribute"
            content = ""
        } else if isSVGAnimatedType(t) {
            functionName = "getAttribute"
        } else {
            r.setStr(includes, "ElementInlines.h", "1")
            functionName = "attributeWithoutSynchronization"
        }
    }
    contentName.* = content
    return functionName
}

pub fn setterExpression(includes: *r.Map, interfaceName: Str, attribute: *Node, contentName: *Str) -> Str {
    const content = contentAttributeName(includes, interfaceName, attribute, "setter")
    if !r.truthy(content) {
        contentName.* = r.undef()
        return r.c2("set", wkUcfirst(attributeNameForGetterAndSetter(attribute)))
    }
    const t = attribute.*.ty.?
    var functionName: Str = ""
    if std.text.same(t.*.name, "boolean") {
        functionName = "setBooleanAttribute"
    } else if std.text.same(t.*.name, "double") {
        functionName = "setNumericAttribute"
    } else if std.text.same(t.*.name, "long") {
        functionName = "setIntegralAttribute"
    } else if std.text.same(t.*.name, "unsigned long") {
        functionName = "setUnsignedIntegralAttribute"
    } else if std.text.same(t.*.name, "Element") {
        functionName = "setElementAttribute"
    } else if std.text.same(t.*.name, "FrozenArray") && t.*.subtypes.count == 1 && std.text.same(m.subtype(t, 0).*.name, "Element") {
        functionName = "setElementsArrayAttribute"
    } else if isSVGAnimatedType(t) {
        functionName = "setAttribute"
    } else {
        functionName = "setAttributeWithoutSynchronization"
    }
    contentName.* = content
    return functionName
}

// ---------------------------------------------------------------------------
// Conditionals.

pub fn generateConditionalString(ext: *m.Ext) -> Str {
    const conditional = m.get(ext, "Conditional")
    if r.truthy(conditional) { return generateConditionalStringFromAttributeValue(conditional) }
    return ""
}

// ConditionalComparator's key: a leading "!" moved to the end.
fn conditionalKey(text: Str) -> Str {
    if text.length >= 2 && text[0] == 33 { return r.c2(text[1..text.length], "!") }
    return text
}

fn sortConditionals(l: *r.StrList) -> void {
    // Insertion sort by the comparator (short lists, distinct keys).
    var index: usize = 1
    while index < l.*.count {
        const item = l.*.items[index]
        const k = conditionalKey(item)
        var at = index
        while at > 0 && r.less(k, conditionalKey(l.*.items[at - 1])) {
            l.*.items[at] = l.*.items[at - 1]
            at -= 1
        }
        l.*.items[at] = item
        index += 1
    }
}

pub fn generateConditionalStringFromAttributeValue(value: Str) -> Str {
    var conditional = value
    if conditional.length > 0 && (conditional[0] == 34 || conditional[0] == 39) { conditional = unquoteStringLiteral(conditional) }
    if r.has(conditionalStringCache, conditional) { return r.getStr(conditionalStringCache, conditional) }
    var disjunction = r.map()
    const disjuncts = r.splitByte(conditional, 124)
    var index: usize = 0
    while index < disjuncts.count {
        var conjunction = r.map()
        const conjuncts = r.splitByte(disjuncts.items[index], 38)
        var k: usize = 0
        while k < conjuncts.count {
            const part = conjuncts.items[k]
            if std.text.startsWith(part, "ENABLE_") { r.die("Conditional macros should not include the leading 'ENABLE_'") }
            var item = part
            if part.length > 0 {
                if part[0] == 33 && part.length > 1 { item = r.cat([_]Str{ "!ENABLE(", part[1..part.length], ")" }[0..]) } else { item = r.cat([_]Str{ "ENABLE(", part, ")" }[0..]) }
            }
            r.set(&conjunction, item, 1)
            k += 1
        }
        var names = r.keys(&conjunction)
        sortConditionals(&names)
        r.set(&disjunction, r.sjoin(names, " && "), 1)
        index += 1
    }
    var result: Str = ""
    if disjunction.size == 0 {
        result = "1"
    } else if disjunction.size == 1 {
        result = r.keys(&disjunction).items[0]
    } else {
        var names = r.keys(&disjunction)
        sortConditionals(&names)
        var parts = r.strList()
        index = 0
        while index < names.count {
            const name = names.items[index]
            r.spush(&parts, if r.hasByte(name, 32) { r.c3("(", name, ")") } else { name })
            index += 1
        }
        result = r.sjoin(parts, " || ")
    }
    r.setStr(conditionalStringCache, conditional, result)
    return result
}

pub fn generateCompileTimeCheckForEnumsIfNeeded(interface: *Node) -> r.StrList {
    var checks = r.strList()
    if m.on(interface.*.ext, "DoNotCheckConstants") || interface.*.constants.count == 0 { return checks }
    const enumName = m.get(interface.*.ext, "ConstantsEnum")
    const baseScope = r.orElse(enumName, r.orElse(m.get(interface.*.ext, "ConstantsScope"), m.typeName(interface)))
    var index: usize = 0
    while index < interface.*.constants.count {
        const constant = m.node(interface.*.constants, index)
        index += 1
        if m.on(constant.*.ext, "DoNotCheckConstants") { continue }
        var constantEnum = r.orElse(m.get(constant.*.ext, "ConstantsEnum"), enumName)
        if r.truthy(constantEnum) && constantEnum.length >= 2 && constantEnum[0] == 34 && constantEnum[constantEnum.length - 1] == 34 { constantEnum = constantEnum[1..constantEnum.length - 1] }
        const scope = r.orElse(m.get(constant.*.ext, "ImplementedBy"), r.orElse(constantEnum, baseScope))
        const name = r.orElse(m.get(constant.*.ext, "ImplementedAs"), constant.*.name)
        const v = if r.truthy(constantEnum) { r.cat([_]Str{ "static_cast<", constantEnum, ">(", constant.*.value, ")" }[0..]) } else { constant.*.value }
        const conditional = m.get(constant.*.ext, "Conditional")
        if r.truthy(conditional) { r.spush(&checks, r.c3("#if ", generateConditionalStringFromAttributeValue(conditional), "\n")) }
        r.spush(&checks, r.cat([_]Str{ "static_assert(", scope, "::", name, " == ", v, ", \"", name, " in ", scope, " does not match value from IDL\");\n" }[0..]))
        if r.truthy(conditional) { r.spush(&checks, "#endif\n") }
    }
    r.spush(&checks, "\n")
    return checks
}

// Whether the &-separated VALUE has KEYWORD among its parts.
pub fn extendedAttributeContains(v: Str, keyword: Str) -> bool {
    if !r.truthy(v) { return false }
    const parts = splitAmpersands(v)
    return r.shas(parts, keyword)
}

// split /\s*\&\s*/
pub fn splitAmpersands(v: Str) -> r.StrList {
    var parts = r.strList()
    var start: usize = 0
    var index: usize = 0
    while index <= v.length {
        if index == v.length || v[index] == 38 {
            var end = index
            if index < v.length {
                while end > start && std.ascii.isCWhitespace(v[end - 1]) { end -= 1 }
            }
            r.spush(&parts, v[start..end])
            var next = index + 1
            while next < v.length && std.ascii.isCWhitespace(v[next]) { next += 1 }
            start = next
            index = next
            if index > v.length { break }
            continue
        }
        index += 1
    }
    while parts.count > 0 && parts.items[parts.count - 1].length == 0 { parts.count -= 1 }
    return parts
}

pub fn getVisibleInterfaceName(interface: *Node) -> Str {
    const name = m.get(interface.*.ext, "InterfaceName")
    return if r.truthy(name) { name } else { m.typeName(interface) }
}

pub fn inheritsInterface(interface: *Node, name: Str) -> bool {
    if std.text.same(name, m.typeName(interface)) { return true }
    const chain = parents(interface)
    var index: usize = 0
    while index < chain.count {
        if std.text.same(m.typeName(m.node(chain, index)), name) { return true }
        index += 1
    }
    return false
}

pub fn inheritsExtendedAttribute(interface: *Node, name: Str) -> bool {
    if m.on(interface.*.ext, name) { return true }
    const chain = parents(interface)
    var index: usize = 0
    var found = false
    while index < chain.count {
        if m.on(m.node(chain, index).*.ext, name) { found = true }
        index += 1
    }
    return found
}

// ---------------------------------------------------------------------------
// Children (ForEachChildInterface): interfaces whose IDL text says they
// inherit from INTERFACE, sorted by name, each parsed.

fn buildInheritanceMap() -> void {
    if childrenMapBuilt { return }
    childrenMapBuilt = true
    childrenMap = r.newMap()
    const ignored = idlFileForInterface("")
    const names = r.keys(idlFiles)
    var index: usize = 0
    while index < names.count {
        const name = names.items[index]
        index += 1
        const text = slurp(r.getStr(idlFiles, name))
        // /interface\s+\Q$name\E\s*:\s*(\w+)\s*\{/
        var at: usize = 0
        while true {
            const found = r.findFrom(text, "interface", at)
            if found >= text.length { break }
            at = found + 1
            var p = found + 9
            const s1 = p
            while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
            if p == s1 || !std.text.startsWith(text[p..text.length], name) { continue }
            p += name.length
            while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
            if p >= text.length || text[p] != 58 { continue }
            p += 1
            while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
            const w = p
            while p < text.length && r.isWord(text[p]) { p += 1 }
            if p == w { continue }
            const parent = text[w..p]
            while p < text.length && std.ascii.isCWhitespace(text[p]) { p += 1 }
            if p >= text.length || text[p] != 123 { continue }
            if !r.has(childrenMap, parent) { r.set(childrenMap, parent, @intFromPtr(newStrList())) }
            const children: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.get(childrenMap, parent)) }
            r.spush(children, name)
            break
        }
    }
}

fn newStrList() -> *r.StrList {
    const l: *r.StrList = unsafe { @ptrFromInt(*r.StrList, r.alloc(@sizeOf(r.StrList))) }
    l.* = r.strList()
    return l
}

pub fn childInterfaces(interface: *Node) -> r.List {
    buildInheritanceMap()
    var result = r.list()
    const address = r.get(childrenMap, m.typeName(interface))
    if address == 0 { return result }
    const children: *r.StrList = unsafe { @ptrFromInt(*r.StrList, address) }
    const sorted = r.ssorted(children.*)
    var index: usize = 0
    while index < sorted.count {
        r.push(&result, @intFromPtr(parseInterface(interface, sorted.items[index]).?))
        index += 1
    }
    return result
}
