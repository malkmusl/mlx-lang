// Scripts as C arrays of their bytes, as JavaScriptCore's
// make-js-file-arrays.py writes them (UserAgentScripts.h and
// UserAgentScriptsData.cpp):
//
//     webkit-js-file-arrays [--no-minify] [--fail-if-non-ascii] -n NAMESPACE HEADER SOURCE INPUT...
//
// Each INPUT (NAME.js) becomes NAMEJavaScript: a sourceURL comment and the
// script minified as jsmin.py does it (see cssminify.mlx), sixteen bytes
// a line.
const std = @import("std")
const s = @import("./support.mlx")
const t = @import("./inspectortext.mlx")
const c = @import("./csstext.mlx")
const m = @import("./cssminify.mlx")

// The file name of PATH without its extension (os.path.splitext of the basename).
fn stem(path: []const u8) -> []const u8 {
    const base = s.baseName(path)
    var dot = base.length
    while dot > 0 && base[dot - 1] != 46 { dot -= 1 }
    if dot <= 1 { return base }
    var leading: usize = 0
    while leading < base.length && base[leading] == 46 { leading += 1 }
    if dot - 1 < leading { return base }
    return base[0..dot - 1]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var minify = true
    var asciiOnly = false
    var namespace: []const u8 = ""
    var paths = t.list()
    var index: usize = 1
    while index < arguments.length {
        const argument = s.cString(arguments[index])
        if std.text.same(argument, "--no-minify") {
            minify = false
        } else if std.text.same(argument, "--fail-if-non-ascii") {
            asciiOnly = true
        } else if (std.text.same(argument, "-n") || std.text.same(argument, "--namespace")) && index + 1 < arguments.length {
            index += 1
            namespace = s.cString(arguments[index])
        } else if s.startsWith(argument, "--namespace=") {
            namespace = argument[12..argument.length]
        } else {
            t.push(&paths, argument)
        }
        index += 1
    }
    if namespace.length == 0 || paths.count < 3 {
        s.say("usage: webkit-js-file-arrays [--no-minify] [--fail-if-non-ascii] -n NAMESPACE HEADER SOURCE INPUT...\n")
        return 2
    }
    const headerPath = paths.items[0]
    var header = c.buf()
    var source = c.buf()
    c.add(&header, t.c3("namespace ", namespace, " {\n"))
    c.add(&source, t.c3("#include \"", s.baseName(headerPath), "\"\n"))
    c.add(&source, t.c3("namespace ", namespace, " {\n"))
    index = 2
    while index < paths.count {
        const variable = stem(paths.items[index])
        const data = c.readFile(paths.items[index])
        const directive = t.c3("//# sourceURL=__InjectedScript_", variable, ".js\n")
        const characters = s.join(directive, if minify { m.jsmin(data) } else { data })
        if asciiOnly {
            for byte in characters {
                if byte >= 128 { s.fail(s.join(paths.items[index], " is not ASCII")) }
            }
        }
        const size = s.decimal(characters.length)
        c.add(&header, t.c5("extern const char ", variable, "JavaScript[", size, "];\n"))
        c.add(&source, t.c5("const char ", variable, "JavaScript[", size, "] = {\n"))
        var at: usize = 0
        while at < characters.length {
            c.add(&source, "    ")
            var column: usize = 0
            while column < 16 && at < characters.length {
                if column > 0 { c.add(&source, ",") }
                const byte = characters[at]
                if byte < 128 {
                    c.add(&source, s.decimal(@intCast(u64, byte)))
                } else {
                    const digits = "0123456789abcdef"
                    c.add(&source, "'\\x")
                    c.addByte(&source, digits[@intCast(usize, byte >> 4)])
                    c.addByte(&source, digits[@intCast(usize, byte & 15)])
                    c.add(&source, "'")
                }
                at += 1
                column += 1
            }
            c.add(&source, ",\n")
        }
        c.add(&source, "};\n")
        index += 1
    }
    c.add(&header, t.c3("} // namespace ", namespace, "\n"))
    c.add(&source, t.c3("} // namespace ", namespace, "\n"))
    s.writeWhole(headerPath, c.contents(&header))
    s.writeWhole(paths.items[1], c.contents(&source))
    return 0
}
