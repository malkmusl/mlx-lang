// WebKit's unified sources, as its generate-unified-source-bundles.py
// makes them: the sources of a list (Sources.txt and the like), sorted by
// their directory, put up to eight at a time into UnifiedSource-DIR-N.cpp
// files (one directory's sources each; C files apart, as -c.c), each
// file only including the sources. A source marked @no-unify, or
// @no-unify-when(bundle<=N) when bundles are of N or fewer, is compiled
// alone. Made while ./mlx build declares the steps: the bundles are
// written (only when they change) and the files to compile returned.
const std = @import("std")
const Build = @import("std.build")

const MAX_SOURCES: usize = 4096
const MAX_PREFIXES: usize = 256
// A dense bundle (a --dense-bundle-filter's) takes this many sources.
const MAX_DENSE_BUNDLE_SIZE: usize = 64

pub const Options = struct {
    // The sources of a bundle (8 unless WEBKIT_MAX_BUNDLE_SIZE).
    maxBundleSize: usize
    // Whether @cost:N counts a source as N (with WEBKIT_MAX_BUNDLE_SIZE).
    enforceCost: bool
    // Lines of GLOB=NAME: sources whose path matches GLOB go to the
    // bundles named NAME, MAX_DENSE_BUNDLE_SIZE at a time.
    denseFilters: []const u8
}

const Source = struct {
    path: []const u8
    // Its directory ("" at the top) and its file's name.
    directory: []const u8
    name: []const u8
    // Which list named it.
    list: usize
    unifiable: bool
    cost: usize
    // Which bundles take it: ".cpp", ".c", ".mm", ".nonARC-mm", or
    // another extension (compiled alone).
    key: []const u8
}

// The bundles of one kind of source.
const Manager = struct {
    key: []const u8
    suffix: []const u8
    fileCount: usize
    bundleCount: usize
    text: []const u8
    prefix: []const u8
    hasPrefix: bool
}

const State = struct {
    b: *Build.Builder
    options: Options
    // Where the bundles go, the source tree, the generated sources.
    output: []const u8
    sourceTree: []const u8
    derived: []const u8
    // What to compile, a path a line.
    compile: []const u8
    // The bundles made of each kind and directory so far.
    prefixManager: [MAX_PREFIXES]usize
    prefixName: [MAX_PREFIXES][]const u8
    prefixCount: [MAX_PREFIXES]usize
    prefixes: usize
}

fn same(a: []const u8, b: []const u8) -> bool { return std.text.same(a, b) }

fn isSpace(byte: u8) -> bool { return byte == 32 || (byte >= 9 && byte <= 13) }
fn isAlphanumeric(byte: u8) -> bool { return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) }

fn strip(text: []const u8) -> []const u8 {
    var start: usize = 0
    var end = text.length
    while start < end && isSpace(text[start]) { start += 1 }
    while end > start && isSpace(text[end - 1]) { end -= 1 }
    return text[start..end]
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && same(text[0..prefix.length], prefix)
}

fn parseDecimal(text: []const u8) -> usize {
    var value: usize = 0
    for byte in text { value = value * 10 + @intCast(usize, byte - 48) }
    return value
}

fn decimal(b: *Build.Builder, value: usize) -> []const u8 {
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &digits) }
    const length = std.text.appendUnsigned(bytes, 0, 24, value)
    return Build.concat(b, bytes[0..length], "")
}

// Runs of other than letters and digits made "-", none at the ends;
// "root" when nothing is left.
fn sanitize(b: *Build.Builder, text: []const u8) -> []const u8 {
    var result = ""
    var dash = false
    for byte in text {
        if isAlphanumeric(byte) {
            if dash && result.length > 0 { result = Build.concat(b, result, "-") }
            dash = false
            var one: [1]u8 = undefined
            one[0] = byte
            result = Build.concat(b, result, one[0..1])
        } else {
            dash = true
        }
    }
    return if result.length > 0 { result } else { "root" }
}

// fnmatch: * any run of characters (slashes too), ? any one.
fn globMatches(pattern: []const u8, text: []const u8) -> bool {
    var p: usize = 0
    var t: usize = 0
    var starP: usize = pattern.length + 1
    var starT: usize = 0
    while t < text.length {
        if p < pattern.length && (pattern[p] == 63 || pattern[p] == text[t]) && pattern[p] != 42 {
            p += 1
            t += 1
        } else if p < pattern.length && pattern[p] == 42 {
            starP = p
            starT = t
            p += 1
        } else if starP <= pattern.length {
            p = starP + 1
            starT += 1
            t = starT
        } else {
            return false
        }
    }
    while p < pattern.length && pattern[p] == 42 { p += 1 }
    return p == pattern.length
}

// A source's bundle prefix (its top directory, sanitized, or a dense
// filter's name) and the sources such a bundle takes.
fn prefixOf(s: *State, source: Source, size: *usize) -> []const u8 {
    const b = s.*.b
    var at: usize = 0
    while at < s.*.options.denseFilters.length {
        const filter = Build.nextLine(s.*.options.denseFilters, &at)
        if filter.length == 0 { continue }
        var equals: usize = 0
        while equals < filter.length && filter[equals] != 61 { equals += 1 }
        const pattern = filter[0..equals]
        if globMatches(pattern, source.path) {
            size.* = if s.*.options.maxBundleSize > MAX_DENSE_BUNDLE_SIZE { s.*.options.maxBundleSize } else { MAX_DENSE_BUNDLE_SIZE }
            const name = if equals < filter.length { filter[equals + 1..filter.length] } else { "" }
            return if name.length > 0 { name } else { sanitize(b, pattern) }
        }
    }
    size.* = s.*.options.maxBundleSize
    var top: usize = 0
    while top < source.directory.length && source.directory[top] != 47 { top += 1 }
    return sanitize(b, if source.directory.length == 0 { "." } else { source.directory[0..top] })
}

// Where a source is: in the source tree, else among the generated ones.
fn located(s: *State, path: []const u8) -> []const u8 {
    const b = s.*.b
    const inTree = Build.concat(b, Build.concat(b, s.*.sourceTree, "/"), path)
    if Build.exists(b, inTree) { return inTree }
    return Build.concat(b, Build.concat(b, s.*.derived, "/"), path)
}

fn compileAlso(s: *State, path: []const u8) -> void {
    s.*.compile = Build.concat(s.*.b, s.*.compile, Build.concat(s.*.b, path, "\n"))
}

fn flush(s: *State, m: *Manager) -> void {
    const b = s.*.b
    m.*.bundleCount += 1
    const name = Build.concat(b, Build.concat(b, Build.concat(b, "UnifiedSource-", m.*.prefix), Build.concat(b, "-", decimal(b, m.*.bundleCount))), m.*.suffix)
    const path = Build.concat(b, Build.concat(b, s.*.output, "/"), name)
    _ = Build.writeText(b, path, m.*.text)
    compileAlso(s, path)
    m.*.text = ""
    m.*.fileCount = 0
}

fn countOf(s: *State, manager: usize, prefix: []const u8) -> usize {
    var index: usize = 0
    while index < s.*.prefixes {
        if s.*.prefixManager[index] == manager && same(s.*.prefixName[index], prefix) { return s.*.prefixCount[index] }
        index += 1
    }
    return 0
}

fn setCount(s: *State, manager: usize, prefix: []const u8, count: usize) -> void {
    var index: usize = 0
    while index < s.*.prefixes {
        if s.*.prefixManager[index] == manager && same(s.*.prefixName[index], prefix) {
            s.*.prefixCount[index] = count
            return
        }
        index += 1
    }
    if s.*.prefixes == MAX_PREFIXES { return }
    s.*.prefixManager[s.*.prefixes] = manager
    s.*.prefixName[s.*.prefixes] = prefix
    s.*.prefixCount[s.*.prefixes] = count
    s.*.prefixes += 1
}

fn addFile(s: *State, m: *Manager, manager: usize, source: Source) -> void {
    var size: usize = 0
    const prefix = prefixOf(s, source, &size)
    if !m.*.hasPrefix || !same(m.*.prefix, prefix) {
        if m.*.fileCount != 0 { flush(s, m) }
        // A directory's bundles are numbered on where they left off.
        if m.*.hasPrefix { setCount(s, manager, m.*.prefix, m.*.bundleCount) }
        m.*.bundleCount = countOf(s, manager, prefix)
        m.*.prefix = prefix
        m.*.hasPrefix = true
    }
    if m.*.fileCount > 0 && m.*.fileCount + source.cost > size { flush(s, m) }
    m.*.text = Build.concat(s.*.b, m.*.text, Build.concat(s.*.b, Build.concat(s.*.b, "#include \"", source.path), "\"\n"))
    m.*.fileCount += source.cost
}

// -1, 0 or 1 as A is before, the same as or after B (by bytes).
fn textOrder(a: []const u8, b: []const u8) -> i32 {
    var k: usize = 0
    while k < a.length && k < b.length {
        if a[k] != b[k] { return if a[k] < b[k] { -1 } else { 1 } }
        k += 1
    }
    if a.length == b.length { return 0 }
    return if a.length < b.length { -1 } else { 1 }
}

// Directories A and B in order of their parts, as Python orders tuples.
fn directoryOrder(a: []const u8, b: []const u8) -> i32 {
    var i: usize = 0
    var j: usize = 0
    var aLeft = a.length > 0
    var bLeft = b.length > 0
    while aLeft && bLeft {
        var ie = i
        while ie < a.length && a[ie] != 47 { ie += 1 }
        var je = j
        while je < b.length && b[je] != 47 { je += 1 }
        const order = textOrder(a[i..ie], b[j..je])
        if order != 0 { return order }
        aLeft = ie < a.length
        bLeft = je < b.length
        i = ie + 1
        j = je + 1
    }
    if aLeft { return 1 }
    if bLeft { return -1 }
    return 0
}

fn sourceBefore(a: Source, b: Source) -> bool {
    const d = directoryOrder(a.directory, b.directory)
    if d != 0 { return d < 0 }
    if a.list != b.list { return a.list < b.list }
    return textOrder(a.name, b.name) < 0
}

// A line of a list (its comment taken off, trimmed, not empty) as a source.
fn parseSource(b: *Build.Builder, line: []const u8, list: usize, options: Options) -> Source {
    var source = Source.{ .path = line, .directory = "", .name = line, .list = list, .unifiable = true, .cost = 1, .key = "" }
    var nonARC = false
    var attributeStart: usize = 0
    while attributeStart < line.length && line[attributeStart] != 64 { attributeStart += 1 }
    if attributeStart < line.length {
        var at = attributeStart + 1
        while at <= line.length {
            var end = at
            while end < line.length && line[end] != 64 { end += 1 }
            const attribute = strip(line[at..end])
            if same(attribute, "no-unify") {
                source.unifiable = false
            } else if startsWith(attribute, "no-unify-when(bundle<=") && attribute.length > 23 && attribute[attribute.length - 1] == 41 {
                if options.maxBundleSize <= parseDecimal(attribute[22..attribute.length - 1]) { source.unifiable = false }
            } else if same(attribute, "nonARC") {
                nonARC = true
            } else if startsWith(attribute, "header:") {
                // Header groups are ignored (--ignore-header-groups).
            } else if startsWith(attribute, "cost:") {
                if options.enforceCost { source.cost = parseDecimal(attribute[5..attribute.length]) }
            } else {
                Build.fail(b, "unified sources: an unknown attribute", attribute)
            }
            at = end + 1
        }
    }
    const path = strip(line[0..attributeStart])
    source.path = path
    var slash = path.length
    while slash > 0 && path[slash - 1] != 47 { slash -= 1 }
    source.directory = if slash > 0 { path[0..slash - 1] } else { "" }
    source.name = path[slash..path.length]
    var dot = source.name.length
    while dot > 0 && source.name[dot - 1] != 46 { dot -= 1 }
    source.key = if dot > 1 { source.name[dot - 1..source.name.length] } else { "" }
    if nonARC && same(source.key, ".mm") { source.key = ".nonARC-mm" }
    return source
}

// The sources of LISTS (paths, a line each) bundled into OUTPUT: what to
// compile, a path a line (bundles first as they are made, the sources
// compiled alone where they come in order; a source by where it is, in
// SOURCE_TREE or else in DERIVED).
pub fn bundle(b: *Build.Builder, lists: []const u8, output: []const u8, sourceTree: []const u8, derived: []const u8, options: Options) -> []const u8 {
    var s = State.{ .b = b, .options = options, .output = output, .sourceTree = sourceTree, .derived = derived, .compile = "",
        .prefixManager = undefined, .prefixName = undefined, .prefixCount = undefined, .prefixes = 0 }
    var sources: [MAX_SOURCES]Source = undefined
    var count: usize = 0
    var list: usize = 0
    var listAt: usize = 0
    while listAt < lists.length {
        const listPath = Build.nextLine(lists, &listAt)
        if listPath.length == 0 { continue }
        const text = Build.readText(b, listPath)
        var at: usize = 0
        while at < text.length {
            var line = Build.nextLine(text, &at)
            var comment: usize = 0
            while comment + 1 < line.length && !(line[comment] == 47 && line[comment + 1] == 47) { comment += 1 }
            if comment + 1 < line.length { line = line[0..comment] }
            line = strip(line)
            if line.length == 0 { continue }
            if count == MAX_SOURCES {
                Build.fail(b, "unified sources: more sources than MAX_SOURCES in", listPath)
                break
            }
            // In order (an insertion sort: a few thousand sources).
            const source = parseSource(b, line, list, options)
            var index = count
            while index > 0 && sourceBefore(source, sources[index - 1]) {
                sources[index] = sources[index - 1]
                index -= 1
            }
            sources[index] = source
            count += 1
        }
        list += 1
    }
    var managers: [4]Manager = undefined
    const keys = [4][]const u8{ ".cpp", ".c", ".mm", ".nonARC-mm" }
    const suffixes = [4][]const u8{ ".cpp", "-c.c", "-ARC.mm", "-nonARC.mm" }
    var m: usize = 0
    while m < 4 {
        managers[m] = Manager.{ .key = keys[m], .suffix = suffixes[m], .fileCount = 0, .bundleCount = 0, .text = "", .prefix = "", .hasPrefix = false }
        m += 1
    }
    var index: usize = 0
    while index < count {
        const source = sources[index]
        var which: usize = 4
        m = 0
        while m < 4 {
            if same(managers[m].key, source.key) { which = m }
            m += 1
        }
        if which == 4 || !source.unifiable {
            compileAlso(&s, located(&s, source.path))
        } else {
            addFile(&s, &managers[which], which, source)
        }
        index += 1
    }
    m = 0
    while m < 4 {
        if managers[m].fileCount != 0 { flush(&s, &managers[m]) }
        m += 1
    }
    return s.compile
}
