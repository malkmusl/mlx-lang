// nebula io: the file formats, as a list (the model is
// filters/registry.mlx): each has a number that stays, a key for
// settings and scripts, names in English and German, its extensions
// ("jpg jpeg jpe jfif": the usual one first), its MIME type, whether it
// keeps layers and alpha, how it is recognized by its first bytes, and
// what reads and writes it. The program's File menu calls load() and
// save():
//
//     var result: formats.LoadResult = undefined
//     const status = formats.load(allocator, path, &result)
//     if status != formats.Status.ok { say(formats.message(status, german)) }
//     ... result.image.? (its one layer "Background"), result.format ...
//
//     const options = formats.saveOptions()
//     _ = formats.save(image, "bild.jpg", formats.JPEG, &options)
//
// load() reads the file whole, tells its format by its content first
// and by its extension second (a PNG called .jpg is read as a PNG), and
// makes an image of it: a single-picture format gives one paint layer
// "Background" holding the picture, written into the layer's device tile
// by tile (tiles that would hold nothing are not made), the image's
// resolution the file's (72 an inch when it says none). save() writes
// what the image shows (core/render.mlx's read(), in bands of rows),
// laid over the options' matte where the format (or the options) keep no
// alpha, and replaces the file whole or not at all (io/text.mlx's
// writeFile). A PNG is compressed as the bands come; the other formats'
// encoders take the whole picture, which is then held once while saving.
//
// The layered formats (OpenRaster, Krita, Photoshop) and GIF and TIFF
// have their numbers and rows here already, recognized by their first
// bytes but without readers and writers: load() says Status.unsupported
// for them until their packages put their functions into the rows
// (readImage and writeImage: a whole image, layers and all; or read and
// write: one picture). exportDevice() and importPicture() are what those
// will need: a layer's exact bounds as PNG bytes, and PNG (or any picture
// format read here) back into a layer at a place.
const std = @import("std")
const png = @import("./png.mlx")
const flat = @import("./flat.mlx")
const text = @import("./text.mlx")
const table = @import("../core/table.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history_module = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")

pub const Allocator = std.allocator.Allocator
pub const Picture = png.Picture
pub const Device = device_module.Device
pub const Image = image_module.Image
pub const Rect = geom.Rect

// What loading or saving came to.
pub const Status = enum(u8) {
    ok,
    notFound,
    notReadable,
    unknownFormat,
    damaged,
    tooLarge,
    noMemory,
    cannotWrite,
    unsupported
}

// What a status says to the user.
pub fn message(status: Status, german: bool) -> []const u8 {
    if status == Status.ok { return if german { "Erledigt" } else { "Done" } }
    if status == Status.notFound { return if german { "Die Datei gibt es nicht" } else { "The file does not exist" } }
    if status == Status.notReadable { return if german { "Die Datei kann nicht gelesen werden" } else { "The file cannot be read" } }
    if status == Status.unknownFormat { return if german { "Das Dateiformat ist unbekannt" } else { "The file format is not known" } }
    if status == Status.damaged { return if german { "Die Datei ist beschädigt" } else { "The file is damaged" } }
    if status == Status.tooLarge { return if german { "Das Bild ist zu groß" } else { "The picture is too large" } }
    if status == Status.noMemory { return if german { "Nicht genug Speicher" } else { "Not enough memory" } }
    if status == Status.cannotWrite { return if german { "Die Datei kann nicht geschrieben werden" } else { "The file cannot be written" } }
    return if german { "Das kann dieses Format hier (noch) nicht" } else { "This is not supported for this format (yet)" }
}

// The formats' numbers: they stay, whatever comes.
pub const NONE: u16 = 0
pub const PNG: u16 = 1
pub const JPEG: u16 = 2
pub const WEBP: u16 = 3
pub const BMP: u16 = 4
pub const TGA: u16 = 5
pub const PNM: u16 = 6
pub const QOI: u16 = 7
pub const ORA: u16 = 8
pub const KRA: u16 = 9
pub const PSD: u16 = 10
pub const GIF: u16 = 11
pub const TIFF: u16 = 12

// How a file is saved.
pub const SaveOptions = struct {
    // Keep alpha where the format can (false: everything is laid over
    // `matte`, as it is anyway where the format has no alpha).
    alpha: bool
    matte: u32
    // JPEG's quality, 1 to 100.
    quality: u32
    // How hard to compress (PNG and the archives): 0 to 9, -1 for 6.
    level: i32
}

// Alpha kept, white under what has none, quality 90, level 6.
pub fn saveOptions() -> SaveOptions {
    return SaveOptions.{ .alpha = true, .matte = pixel.WHITE, .quality = 90, .level = 6 }
}

// What load() made: the image (the caller's: image_module.destroy) and
// the format it was read as.
pub const LoadResult = struct {
    image: ?*Image
    format: u16
}

// Whether `bytes` begin as the format's files do.
pub const Sniff = fn(bytes: []const u8) -> bool
// One picture of a single-picture format (png.free() frees it after
// png.Status.ok).
pub const Read = fn(bytes: []const u8, allocator: Allocator, into: *Picture) -> png.Status
// One picture at the end of `into` (false: no memory, or the format
// cannot hold it); the picture is laid over the matte already when it is
// to have no alpha.
pub const Write = fn(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool
// A whole document, layers and all (the layered formats).
pub const ReadImage = fn(allocator: Allocator, bytes: []const u8, into: *LoadResult) -> Status
pub const WriteImage = fn(image: *Image, options: *const SaveOptions, into: *std.ArrayList(u8)) -> Status

pub const Info = struct {
    id: u16
    // Its name in settings and scripts.
    key: []const u8
    name: []const u8
    german: []const u8
    // Without points, a space between them, the usual one first.
    extensions: []const u8
    mime: []const u8
    layers: bool
    alpha: bool
    canRead: bool
    canWrite: bool
    sniff: ?Sniff
    read: ?Read
    write: ?Write
    readImage: ?ReadImage
    writeImage: ?WriteImage
}

// ---------------------------------------------------------------------------
// Recognizing files

fn sniffPng(bytes: []const u8) -> bool { return png.isPng(bytes) }

// A TGA has no signature: only the TGA 2 footer says so for certain (one
// without it is known by its extension, or by a header that makes sense
// when nothing else fits).
fn sniffTga(bytes: []const u8) -> bool {
    if !flat.isTga(bytes) || bytes.length < 18 + 26 { return false }
    const footer = bytes.pointer + (bytes.length - 18)
    return std.mem.eql(footer, "TRUEVISION-XFILE.\x00".pointer, 18)
}

// A ZIP whose first entry is a stored "mimetype" holding `mime` (as
// OpenRaster and Krita write it).
fn zipOfType(bytes: []const u8, mime: []const u8) -> bool {
    if bytes.length < 38 + mime.length || std.mem.readU32Little(bytes.pointer, 0) != 0x04034b50 { return false }
    return std.mem.eql(bytes.pointer + 30, "mimetype".pointer, 8) && std.mem.eql(bytes.pointer + 38, mime.pointer, mime.length)
}

fn sniffOra(bytes: []const u8) -> bool { return zipOfType(bytes, "image/openraster") }
fn sniffKra(bytes: []const u8) -> bool { return zipOfType(bytes, "application/x-krita") }
fn sniffPsd(bytes: []const u8) -> bool { return bytes.length >= 26 && std.mem.readU32Big(bytes.pointer, 0) == 0x38425053 }
fn sniffGif(bytes: []const u8) -> bool { return bytes.length >= 6 && std.mem.eql(bytes.pointer, "GIF8".pointer, 4) && (bytes[4] == 55 || bytes[4] == 57) && bytes[5] == 97 }

fn sniffTiff(bytes: []const u8) -> bool {
    if bytes.length < 8 { return false }
    const head = std.mem.readU32Big(bytes.pointer, 0)
    return head == 0x49492A00 || head == 0x4D4D002A
}

// ---------------------------------------------------------------------------
// The single-picture writers, with the options

fn writePng(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool {
    var settings = png.options(options.*.alpha)
    settings.matte = options.*.matte
    settings.level = options.*.level
    settings.resolution = picture.*.resolution
    return png.encodeWith(picture.*.pixels, picture.*.width, picture.*.height, picture.*.width, &settings, into)
}

fn writeJpeg(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool {
    return flat.encodeJpeg(picture, options.*.quality, options.*.matte, into)
}

fn writeWebp(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool {
    return flat.encodeWebp(picture, into)
}

fn writeBmp(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool {
    return flat.encodeBmp(picture, options.*.alpha, options.*.matte, into)
}

fn writeTga(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool {
    return flat.encodeTga(picture, options.*.alpha, options.*.matte, into)
}

// PAM with alpha, PPM without (save() takes alpha away unless the file is
// to be a .pam).
fn writePnm(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool {
    if options.*.alpha { return flat.encodePam(picture, into) }
    return flat.encodePpm(picture, options.*.matte, into)
}

fn writeQoi(picture: *const Picture, options: *const SaveOptions, into: *std.ArrayList(u8)) -> bool {
    return flat.encodeQoi(picture, options.*.alpha, options.*.matte, into)
}

// ---------------------------------------------------------------------------
// The list

const FORMATS = [12]Info{
    Info.{ .id = PNG, .key = "png", .name = "PNG image", .german = "PNG-Bild", .extensions = "png", .mime = "image/png", .layers = false, .alpha = true, .canRead = true, .canWrite = true, .sniff = sniffPng, .read = png.decode, .write = writePng, .readImage = null, .writeImage = null },
    Info.{ .id = JPEG, .key = "jpeg", .name = "JPEG image", .german = "JPEG-Bild", .extensions = "jpg jpeg jpe jfif", .mime = "image/jpeg", .layers = false, .alpha = false, .canRead = true, .canWrite = true, .sniff = flat.isJpeg, .read = flat.decodeJpeg, .write = writeJpeg, .readImage = null, .writeImage = null },
    Info.{ .id = WEBP, .key = "webp", .name = "WebP image", .german = "WebP-Bild", .extensions = "webp", .mime = "image/webp", .layers = false, .alpha = true, .canRead = true, .canWrite = true, .sniff = flat.isWebp, .read = flat.decodeWebp, .write = writeWebp, .readImage = null, .writeImage = null },
    Info.{ .id = BMP, .key = "bmp", .name = "Windows bitmap", .german = "Windows-Bitmap", .extensions = "bmp dib", .mime = "image/bmp", .layers = false, .alpha = true, .canRead = true, .canWrite = true, .sniff = flat.isBmp, .read = flat.decodeBmp, .write = writeBmp, .readImage = null, .writeImage = null },
    Info.{ .id = TGA, .key = "tga", .name = "TGA image (Targa)", .german = "TGA-Bild (Targa)", .extensions = "tga icb vda vst", .mime = "image/x-tga", .layers = false, .alpha = true, .canRead = true, .canWrite = true, .sniff = sniffTga, .read = flat.decodeTga, .write = writeTga, .readImage = null, .writeImage = null },
    Info.{ .id = PNM, .key = "pnm", .name = "Netpbm image (PBM, PGM, PPM, PAM)", .german = "Netpbm-Bild (PBM, PGM, PPM, PAM)", .extensions = "ppm pnm pbm pgm pam", .mime = "image/x-portable-anymap", .layers = false, .alpha = true, .canRead = true, .canWrite = true, .sniff = flat.isPnm, .read = flat.decodePnm, .write = writePnm, .readImage = null, .writeImage = null },
    Info.{ .id = QOI, .key = "qoi", .name = "QOI image", .german = "QOI-Bild", .extensions = "qoi", .mime = "image/qoi", .layers = false, .alpha = true, .canRead = true, .canWrite = true, .sniff = flat.isQoi, .read = flat.decodeQoi, .write = writeQoi, .readImage = null, .writeImage = null },
    Info.{ .id = ORA, .key = "ora", .name = "OpenRaster image", .german = "OpenRaster-Bild", .extensions = "ora", .mime = "image/openraster", .layers = true, .alpha = true, .canRead = false, .canWrite = false, .sniff = sniffOra, .read = null, .write = null, .readImage = null, .writeImage = null },
    Info.{ .id = KRA, .key = "kra", .name = "Krita document", .german = "Krita-Dokument", .extensions = "kra", .mime = "application/x-krita", .layers = true, .alpha = true, .canRead = false, .canWrite = false, .sniff = sniffKra, .read = null, .write = null, .readImage = null, .writeImage = null },
    Info.{ .id = PSD, .key = "psd", .name = "Photoshop document", .german = "Photoshop-Dokument", .extensions = "psd", .mime = "image/vnd.adobe.photoshop", .layers = true, .alpha = true, .canRead = false, .canWrite = false, .sniff = sniffPsd, .read = null, .write = null, .readImage = null, .writeImage = null },
    Info.{ .id = GIF, .key = "gif", .name = "GIF image", .german = "GIF-Bild", .extensions = "gif", .mime = "image/gif", .layers = false, .alpha = true, .canRead = false, .canWrite = false, .sniff = sniffGif, .read = null, .write = null, .readImage = null, .writeImage = null },
    Info.{ .id = TIFF, .key = "tiff", .name = "TIFF image", .german = "TIFF-Bild", .extensions = "tif tiff", .mime = "image/tiff", .layers = false, .alpha = true, .canRead = false, .canWrite = false, .sniff = sniffTiff, .read = null, .write = null, .readImage = null, .writeImage = null },
}

var kept: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// All formats, in the order of their numbers.
pub fn list() -> []const Info {
    if kept.address != 0 { return table.rows(Info, &kept) }
    return table.keep(Info, &kept, FORMATS[0..])
}

// How many formats there are.
pub fn count() -> usize { return list().length }

// The format at `index` of the list (null past its end).
pub fn at(index: usize) -> ?*const Info {
    const all = list()
    if index >= all.length { return null }
    return &all[index]
}

// The format numbered `id` (null: there is none).
pub fn find(id: u16) -> ?*const Info {
    const all = list()
    var index: usize = 0
    while index < all.length {
        if all[index].id == id { return &all[index] }
        index += 1
    }
    return null
}

// The format a setting or a script names `key`.
pub fn byKey(key: []const u8) -> ?*const Info {
    const all = list()
    var index: usize = 0
    while index < all.length {
        if std.text.same(all[index].key, key) { return &all[index] }
        index += 1
    }
    return null
}

// Whether `extension` (any case, no point) is one of the format's.
pub fn hasExtension(info: *const Info, extension: []const u8) -> bool {
    if extension.length == 0 { return false }
    const words = info.*.extensions
    var start: usize = 0
    while start < words.length {
        var end = start
        while end < words.length && words[end] != 32 { end += 1 }
        if text.sameIgnoringCase(words[start..end], extension) { return true }
        start = end + 1
    }
    return false
}

// The format whose extension the file name has (null: none has it).
pub fn byPath(path: []const u8) -> ?*const Info {
    const extension = text.extension(path)
    const all = list()
    var index: usize = 0
    while index < all.length {
        if hasExtension(&all[index], extension) { return &all[index] }
        index += 1
    }
    return null
}

// The format whose first bytes `bytes` are (null: none is known by them).
pub fn sniff(bytes: []const u8) -> ?*const Info {
    const all = list()
    var index: usize = 0
    while index < all.length {
        if all[index].sniff != null && all[index].sniff.?(bytes) { return &all[index] }
        index += 1
    }
    return null
}

// The format of a file: by its content, else by its name, else by what
// is left (a TGA without its footer). NONE when nothing fits.
pub fn detect(bytes: []const u8, path: []const u8) -> u16 {
    const by_content = sniff(bytes)
    if by_content != null { return by_content.?.*.id }
    const by_name = byPath(path)
    if by_name != null { return by_name.?.*.id }
    if flat.isTga(bytes) { return TGA }
    return NONE
}

// ---------------------------------------------------------------------------
// Pictures into devices and out of them

fn statusOf(status: png.Status) -> Status {
    if status == png.Status.ok { return Status.ok }
    if status == png.Status.notThisFormat { return Status.unknownFormat }
    if status == png.Status.unsupported { return Status.unsupported }
    if status == png.Status.tooLarge { return Status.tooLarge }
    if status == png.Status.noMemory { return Status.noMemory }
    return Status.damaged
}

fn smaller(a: i32, b: i32) -> i32 { return if a < b { a } else { b } }

// Whether any of the `columns` x `rows` pixels at `from` (`stride` words a
// row) is not `blank`.
fn shows(from: [*]const u32, columns: usize, rows: usize, stride: usize, blank: u32) -> bool {
    var row: usize = 0
    while row < rows {
        const line = from + row * stride
        var column: usize = 0
        while column < columns {
            if line[column] != blank { return true }
            column += 1
        }
        row += 1
    }
    return false
}

// The picture into `device` with its first pixel at (x, y), a tile of the
// device at a time; where a tile would hold nothing but the device's
// default and there is none yet, none is made. False when memory ran out
// (what was written stays), and, with nothing written, for a place the
// device cannot address (png.addressable: an edge near the ends of i32).
pub fn writePicture(device: *Device, picture: *const Picture, x: i32, y: i32) -> bool {
    if picture.*.width > png.LARGEST || picture.*.height > png.LARGEST { return false }
    const width = @intCast(i32, picture.*.width)
    const height = @intCast(i32, picture.*.height)
    if !png.addressable(geom.rect(x, y, width, height), device.*.x, device.*.y) { return false }
    const blank = device.*.defaultPixel
    var top: i32 = 0
    while top < height {
        const place_y = y + top - device.*.y
        const rows = smaller(device_module.TILE - (place_y & device_module.TILE_MASK), height - top)
        var left: i32 = 0
        while left < width {
            const place_x = x + left - device.*.x
            const columns = smaller(device_module.TILE - (place_x & device_module.TILE_MASK), width - left)
            const from = picture.*.pixels + (@intCast(usize, top) * picture.*.width + @intCast(usize, left))
            const needed = shows(from, @intCast(usize, columns), @intCast(usize, rows), picture.*.width, blank) || device_module.tileRead(device, place_x >> 6, place_y >> 6) != null
            if needed && !device_module.writeRect(device, geom.rect(x + left, y + top, columns, rows), from, picture.*.width) { return false }
            left += columns
        }
        top += rows
    }
    return true
}

// The picture into `device` at (x, y), and freed: tooLarge for a place
// the device cannot address, noMemory when memory ran out.
fn place(device: *Device, picture: *Picture, x: i32, y: i32) -> Status {
    var status = Status.ok
    if !png.addressable(geom.rect(x, y, @intCast(i32, picture.*.width), @intCast(i32, picture.*.height)), device.*.x, device.*.y) {
        status = Status.tooLarge
    } else if !writePicture(device, picture, x, y) {
        status = Status.noMemory
    }
    png.free(picture)
    return status
}

// The bytes of a picture file (any format read here, told by its
// content) into `device` with the picture's first pixel at (x, y).
// unknownFormat or unsupported for what is not read here, the reader's
// failure (damaged, tooLarge, noMemory), tooLarge for a place the device
// cannot address.
pub fn importPicture(allocator: Allocator, bytes: []const u8, device: *Device, x: i32, y: i32) -> Status {
    // (A PNG, what the layered formats hold, by a direct call: a record
    // handed through a function pointer is a new value of the arena at
    // every call, and a document has many layers.)
    if png.isPng(bytes) { return importPng(allocator, bytes, device, x, y) }
    const info = sniff(bytes)
    if info == null || info.?.*.read == null { return if info == null { Status.unknownFormat } else { Status.unsupported } }
    var picture: Picture = undefined
    const status = info.?.*.read.?(bytes, allocator, &picture)
    if status != png.Status.ok { return statusOf(status) }
    return place(device, &picture, x, y)
}

fn importPng(allocator: Allocator, bytes: []const u8, device: *Device, x: i32, y: i32) -> Status {
    var picture: Picture = undefined
    const status = png.decode(bytes, allocator, &picture)
    if status != png.Status.ok { return statusOf(status) }
    return place(device, &picture, x, y)
}

// The pixels of `device` inside their exact bounds (where they are not
// its default: a layer's transparent), as a PNG at the end of `into`
// (RGBA, `level` 0 to 9 or -1), and those bounds into `bounds` (image
// coordinates). A device of nothing but its default gives one pixel of
// it at (0, 0) (transparent for a layer; imported, it makes no tile).
// False when memory ran out (`into` is then as it was).
pub fn exportDevice(device: *Device, level: i32, into: *std.ArrayList(u8), bounds: *Rect) -> bool {
    // (Straight into `bounds`: a local Rect given a function's result
    // anew would be a new value of the arena at every call.)
    bounds.* = device_module.exactBounds(device)
    if geom.isEmpty(bounds.*) { bounds.* = geom.rect(0, 0, 1, 1) }
    var settings = png.options(true)
    settings.level = level
    return png.encodeDevice(device, bounds.*, &settings, into)
}

// ---------------------------------------------------------------------------
// Loading

// The picture as an image of one paint layer, "Background".
fn imageOf(allocator: Allocator, picture: *const Picture, into: *LoadResult) -> Status {
    const resolution = if picture.*.resolution > 0.0 { picture.*.resolution } else { 72.0 }
    const width = @intCast(i32, picture.*.width)
    const height = @intCast(i32, picture.*.height)
    if width > image_module.LARGEST || height > image_module.LARGEST { return Status.tooLarge }
    const made = image_module.create(allocator, width, height, resolution)
    if made == null { return Status.noMemory }
    const image = made.?
    const layer = ops.newLayer(image, node_module.PAINT, "Background", "Open")
    if layer == null || !writePicture(layer.?.*.device.?, picture, 0, 0) {
        image_module.destroy(image)
        return Status.noMemory
    }
    // A file just opened has nothing to undo.
    history_module.clear(image.*.history)
    image_module.damageAll(image)
    image.*.modified = false
    into.*.image = image
    return Status.ok
}

// Reads the file at `path` as an image into `into` (the caller's to
// destroy after Status.ok; null otherwise).
pub fn load(allocator: Allocator, path: []const u8, into: *LoadResult) -> Status {
    into.*.image = null
    into.*.format = NONE
    var contents: text.Contents = undefined
    const read = text.readFile(allocator, path, &contents)
    if read == text.FileStatus.notFound { return Status.notFound }
    if read == text.FileStatus.notReadable { return Status.notReadable }
    if read == text.FileStatus.noMemory { return Status.noMemory }
    const bytes = contents.bytes[0..contents.length]
    var status = Status.unknownFormat
    const info = find(detect(bytes, path))
    if info != null {
        status = Status.unsupported
        if info.?.*.readImage != null {
            status = info.?.*.readImage.?(allocator, bytes, into)
        } else if info.?.*.read != null {
            var picture: Picture = undefined
            status = statusOf(info.?.*.read.?(bytes, allocator, &picture))
            if status == Status.ok {
                status = imageOf(allocator, &picture, into)
                png.free(&picture)
            }
        }
    }
    text.freeFile(&contents)
    if status != Status.ok {
        if into.*.image != null {
            image_module.destroy(into.*.image.?)
            into.*.image = null
        }
        return status
    }
    into.*.format = info.?.*.id
    image_module.setPath(into.*.image.?, path)
    return Status.ok
}

// ---------------------------------------------------------------------------
// Saving

fn readImage(context: *anyopaque, area: *const Rect, into: [*]u32, stride: usize) -> void {
    const image: *Image = unsafe { @ptrCast(*Image, context) }
    render.read(image, area.*, into, stride)
}

const BAND: i32 = 64

// What the image shows, whole, into `picture` (made here), in bands.
fn pictureOf(image: *Image, picture: *Picture) -> Status {
    const made = png.makePicture(picture, @intCast(usize, image.*.width), @intCast(usize, image.*.height), image.*.allocator)
    if made != png.Status.ok { return statusOf(made) }
    picture.*.resolution = image.*.resolution
    var top: i32 = 0
    while top < image.*.height {
        const rows = smaller(BAND, image.*.height - top)
        render.read(image, geom.rect(0, top, image.*.width, rows), picture.*.pixels + @intCast(usize, top) * picture.*.width, picture.*.width)
        top += rows
    }
    return Status.ok
}

// Writes what `image` shows as the file `path` in format `format` (a
// number of the list) with `options`, whole or not at all. The image's
// own path and its "modified" are the caller's to set.
pub fn save(image: *Image, path: []const u8, format: u16, options: *const SaveOptions) -> Status {
    const info = find(format)
    if info == null { return Status.unknownFormat }
    if info.?.*.writeImage == null && info.?.*.write == null { return Status.unsupported }
    var settings = options.*
    // Alpha only where the format has it; a Netpbm file has it only as PAM.
    if !info.?.*.alpha || (format == PNM && !text.hasExtension(path, "pam")) { settings.alpha = false }
    const allocator = image.*.allocator
    var bytes = std.ArrayList(u8).init(allocator)
    var status = Status.ok
    if info.?.*.writeImage != null {
        status = info.?.*.writeImage.?(image, &settings, &bytes)
    } else if format == PNG {
        // Compressed as the bands come: the picture is never held whole.
        var encoding = png.options(settings.alpha)
        encoding.matte = settings.matte
        encoding.level = settings.level
        encoding.resolution = image.*.resolution
        if !png.encodeFrom(readImage, image, image_module.bounds(image), &encoding, &bytes) { status = Status.noMemory }
    } else if format == WEBP && (image.*.width > 16384 || image.*.height > 16384) {
        // (The WebP encoder's limit; the other formats hold LARGEST.)
        status = Status.tooLarge
    } else {
        var picture: Picture = undefined
        status = pictureOf(image, &picture)
        if status == Status.ok {
            if !settings.alpha {
                const total = picture.width * picture.height
                var index: usize = 0
                while index < total {
                    const value = picture.pixels[index]
                    if value >> 24 != 255 { picture.pixels[index] = pixel.over(settings.matte, value, 255) | 0xFF000000 }
                    index += 1
                }
            }
            if !info.?.*.write.?(&picture, &settings, &bytes) { status = Status.noMemory }
            png.free(&picture)
        }
    }
    if status == Status.ok && !text.writeFile(allocator, path, bytes.items()) { status = Status.cannotWrite }
    bytes.deinit()
    return status
}
