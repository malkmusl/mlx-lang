// nebula io: LZF, the compression of the tiles in a Krita document
// (io/kra.mlx), as Marc Lehmann's liblzf 3.6 does it, written here from
// its algorithm.
//
//     var table: lzf.Table = undefined
//     lzf.begin(&table, slots)                    // slots: lzf.SLOTS words of scratch
//     const made = lzf.compress(&table, from, length, into, room)   // 0: did not fit
//     var produced: usize = 0
//     if !lzf.decompress(packed, into, capacity, &produced) { ... damaged ... }
//
// The format is a row of commands. A byte below 32 is a run of that
// many plus one literal bytes, which follow. Any other byte is a back
// reference: its top three bits are the length less two (7: a byte
// follows with the rest of it), its low five bits and the next byte the
// distance back less one; the bytes are copied one after the other, so a
// reference may overlap what it makes (a run of one byte repeated).
//
// The compressor is liblzf's (lzf_c.c in its default build, VERY_FAST,
// HLOG 16, with the hash table cleared at every call): the three bytes at
// each place are hashed into a table of the last place they were seen
// at; a place found there that is less than 8192 back and holds the same
// three bytes starts a reference, as long as the bytes match and at most
// 264; everything else becomes literal runs of up to 32 bytes. After a
// reference the hash of its last two places is put into the table, the
// places inside it not (VERY_FAST). The same input gives the same bytes
// as liblzf's.
//
// The table is the caller's (SLOTS words: 256 KiB, from core/scratch.mlx
// or the heap, never a local) and not really cleared at every call: an
// entry holds a place counted from where this call's numbers begin
// (`base`), and one from an earlier call is below that and counts as
// empty. begin() clears it once; compress() clears it again only when
// the numbers would run past what a u32 counts.
//
// The decompressor trusts nothing: a run or a reference that would read
// past the input, write past the output's capacity or reach before its
// start makes it fail, never trap.
const std = @import("std")

// The hash table's size in words: 2 to the 16th (liblzf's HLOG).
pub const SLOTS: usize = 65536
// The longest literal run, the farthest a reference reaches back and its
// longest copy.
pub const MOST_LITERALS: usize = 32
pub const MOST_DISTANCE: usize = 8192
pub const MOST_LENGTH: usize = 264

// The room compress() needs so that `length` bytes always fit (its tests
// are liblzf's: they keep a few bytes free that a match might need).
// What it makes is at most 3 bytes less: one command byte for every 32
// literals, and one more.
pub fn bound(length: usize) -> usize {
    return length + length / 32 + 4
}

pub const Table = struct {
    slots: [*]u32
    // Entries above this are this call's: place + 1 + base.
    base: u32
}

// Takes `slots` (SLOTS words of the caller's) as the hash table, empty.
pub fn begin(table: *Table, slots: [*]u32) -> void {
    table.*.slots = slots
    table.*.base = 0
    clear(table)
}

fn clear(table: *Table) -> void {
    var index: usize = 0
    while index < SLOTS {
        table.*.slots[index] = 0
        index += 1
    }
    table.*.base = 0
}

// liblzf's IDX for VERY_FAST: the hash of the bytes in `value` (the
// three last ones in its low 24 bits, the one before in its top byte).
inline fn slotOf(value: u32) -> usize {
    return @intCast(usize, ((value >> 8) -% (value *% 5)) & 0xFFFF)
}

// `length` bytes at `from` compressed into `into` (`room` bytes, nothing
// written past them). How many were made; 0 for no input, and when they
// did not fit (`into` may have been written then): never with a `room` of
// bound(length).
pub fn compress(table: *Table, from: [*]const u8, length: usize, into: [*]u8, room: usize) -> usize {
    if length == 0 || room == 0 || length > 0x7FFFFFFF { return 0 }
    if @intCast(usize, table.*.base) + length + 2 > 0xFFFFFFFF { clear(table) }
    const base = table.*.base
    table.*.base = @intCast(u32, @intCast(usize, base) + length + 1)
    const slots = table.*.slots
    var ip: usize = 0
    // `op` is where the next byte goes, the command of the open literal
    // run being at op - lit - 1 (one place is kept for it: "start run").
    var op: usize = 1
    var lit: usize = 0
    var value: u32 = (@intCast(u32, from[0]) << 8) | (if length > 1 { @intCast(u32, from[1]) } else { 0 })
    while length >= 3 && ip < length - 2 {
        value = (value << 8) | @intCast(u32, from[ip + 2])
        const slot = slotOf(value)
        const entry = slots[slot]
        slots[slot] = base + @intCast(u32, ip) + 1
        var matched = false
        var reference: usize = 0
        if entry > base {
            reference = @intCast(usize, entry - base - 1)
            // (A reference to the very first byte is never taken: liblzf
            // tells an empty slot by it.)
            matched = reference > 0 && ip - reference - 1 < MOST_DISTANCE && from[reference + 2] == from[ip + 2] && from[reference] == from[ip] && from[reference + 1] == from[ip + 1]
        }
        if matched {
            const distance = ip - reference - 1
            var most = length - ip - 2
            if most > MOST_LENGTH { most = MOST_LENGTH }
            // The conservative test, then the exact one.
            if op + 4 >= room {
                const undone: usize = if lit == 0 { 1 } else { 0 }
                if op - undone + 4 >= room { return 0 }
            }
            // The literal run ends (and is taken back when it is empty).
            into[op - lit - 1] = @intCast(u8, (lit -% 1) & 255)
            if lit == 0 { op -= 1 }
            // How many bytes match: liblzf looks at 16 more without
            // asking whether they are wanted when more than 16 may be
            // (the input has them: `most` is two short of its end), and
            // so may take two more than `most`.
            var count: usize = 2
            var ended = false
            if most > 16 {
                var step: usize = 0
                while step < 16 && !ended {
                    count += 1
                    ended = from[reference + count] != from[ip + count]
                    step += 1
                }
            }
            while !ended {
                count += 1
                ended = !(count < most && from[reference + count] == from[ip + count])
            }
            // Bytes copied less two.
            count -= 2
            ip += 1
            if count < 7 {
                into[op] = @intCast(u8, (distance >> 8) + (count << 5))
                op += 1
            } else {
                into[op] = @intCast(u8, (distance >> 8) + (7 << 5))
                into[op + 1] = @intCast(u8, count - 7)
                op += 2
            }
            into[op] = @intCast(u8, distance & 255)
            op += 2
            lit = 0
            ip += count + 1
            if ip >= length - 2 { break }
            // The two places before the next are hashed (VERY_FAST).
            ip -= 2
            value = (@intCast(u32, from[ip]) << 8) | @intCast(u32, from[ip + 1])
            value = (value << 8) | @intCast(u32, from[ip + 2])
            slots[slotOf(value)] = base + @intCast(u32, ip) + 1
            ip += 1
            value = (value << 8) | @intCast(u32, from[ip + 2])
            slots[slotOf(value)] = base + @intCast(u32, ip) + 1
            ip += 1
        } else {
            if op >= room { return 0 }
            lit += 1
            into[op] = from[ip]
            op += 1
            ip += 1
            if lit == MOST_LITERALS {
                into[op - lit - 1] = @intCast(u8, lit - 1)
                lit = 0
                op += 1
            }
        }
    }
    // At most three bytes are left.
    if op + 3 > room { return 0 }
    while ip < length {
        lit += 1
        into[op] = from[ip]
        op += 1
        ip += 1
        if lit == MOST_LITERALS {
            into[op - lit - 1] = @intCast(u8, lit - 1)
            lit = 0
            op += 1
        }
    }
    into[op - lit - 1] = @intCast(u8, (lit -% 1) & 255)
    if lit == 0 { op -= 1 }
    return op
}

// `input` decompressed into `into` (`capacity` bytes): how many bytes it
// made into `produced`. False for input that is damaged: a run or a
// reference cut short, one reaching before the output's start, more
// output than `capacity` (what was written before stays). Empty input
// makes nothing.
pub fn decompress(input: []const u8, into: [*]u8, capacity: usize, produced: *usize) -> bool {
    produced.* = 0
    const length = input.length
    const data = input.pointer
    var ip: usize = 0
    var op: usize = 0
    while ip < length {
        const command = @intCast(usize, data[ip])
        ip += 1
        if command < 32 {
            const count = command + 1
            if count > capacity - op || count > length - ip { return false }
            std.mem.copy(into + op, data + ip, count)
            op += count
            ip += count
        } else {
            var count = command >> 5
            if ip >= length { return false }
            if count == 7 {
                count += @intCast(usize, data[ip])
                ip += 1
                if ip >= length { return false }
            }
            const distance = ((command & 31) << 8) + @intCast(usize, data[ip]) + 1
            ip += 1
            count += 2
            if count > capacity - op || distance > op { return false }
            // Byte after byte: the copy may overlap what it makes.
            var from = op - distance
            var left = count
            while left > 0 {
                into[op] = into[from]
                op += 1
                from += 1
                left -= 1
            }
        }
    }
    produced.* = op
    return true
}
