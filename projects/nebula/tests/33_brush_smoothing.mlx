// nebula's smoothing between the pointer and the stroke
// (brush/smoothing.mlx): points pass unchanged without it, except those
// that say nothing new; the basic curve takes the staircase out of
// whole-pixel lines and circles (how far from the true shape, how sharp
// the turns, how far apart and how far behind the pen the points are, that
// it ends at the pen); the weighted average takes jitter out and closes up
// at the end; the stabilizer follows the average of its samples whatever
// the rate of the events, catches up while the pen rests and runs on to
// the pointer at the end, or hangs on its rope; pixel art gets pixel
// centres without the corners of an L (also on the far side of a leap);
// pressure made from speed, its tapers and its least, real pressure left
// alone, the tablet's curve (and its ends: 0 to 1 whatever the table
// says); a small `capacity` loses nothing and changes nothing (on a
// thousand random strokes too), nor does an event repeated; reset() and
// two smoothers give the same line again; a stroke mirrored, moved by
// whole tiles or drawn 2^40 ms later comes out mirrored, moved or later,
// exactly; odd input (NaN, time running back or standing still, stamps a
// hair apart, a leap of 1e8 pixels, a full queue) and options that are no
// lengths (infinite, NaN, 1e308) do no harm; a smoother is one heap block
// under 32 KiB, given back whole; 120000 pushes take nothing from the
// value arena. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const point_module = @import("../brush/point.mlx")
const smoothing = @import("../brush/smoothing.mlx")

const Point = point_module.Point
const Smoother = smoothing.Smoother

const ROOM: usize = 65536
// A float is as good as equal below this.
const TINY: f64 = 0.000000001
const DEGREE: f64 = math.pi / 180.0

// The points that came out of a smoother, in heap memory.
const Line = struct {
    points: [*]Point
    count: usize
}

fn push(s: *Smoother, line: *Line, x: f64, y: f64, pressure: f64, time: f64) -> usize {
    const raw = point_module.at(x, y, pressure, time)
    const count = smoothing.push(s, &raw, line.*.points + line.*.count, ROOM - line.*.count)
    line.*.count += count
    return count
}

fn rest(s: *Smoother, line: *Line, time: f64) -> usize {
    const count = smoothing.tick(s, time, line.*.points + line.*.count, ROOM - line.*.count)
    line.*.count += count
    return count
}

fn lift(s: *Smoother, line: *Line) -> usize {
    const count = smoothing.finish(s, line.*.points + line.*.count, ROOM - line.*.count)
    line.*.count += count
    return count
}

// The room for points at one call when `room` are wanted at most.
fn spare(line: *const Line, room: usize) -> usize {
    return if room < ROOM - line.*.count { room } else { ROOM - line.*.count }
}

fn last(line: *const Line) -> *const Point {
    return &line.*.points[line.*.count - 1]
}

fn same(a: *const Point, b: *const Point) -> bool {
    return a.*.x == b.*.x && a.*.y == b.*.y && a.*.pressure == b.*.pressure && a.*.tiltX == b.*.tiltX && a.*.tiltY == b.*.tiltY && a.*.rotation == b.*.rotation && a.*.time == b.*.time
}

fn sameLines(a: *const Line, b: *const Line) -> bool {
    if a.*.count != b.*.count { return false }
    var index: usize = 0
    while index < a.*.count {
        if !same(&a.*.points[index], &b.*.points[index]) { return false }
        index += 1
    }
    return true
}

fn far(ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    return math.sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
}

// How far the line's end is from (x, y).
fn behind(line: *const Line, x: f64, y: f64) -> f64 {
    return far(last(line).*.x, last(line).*.y, x, y)
}

// The sharpest turn from one segment of the line to the next, as its
// sine; 2 when the line turns back on itself.
fn sharpest(line: *const Line) -> f64 {
    var worst: f64 = 0.0
    var index: usize = 2
    while index < line.*.count {
        const ax = line.*.points[index - 1].x - line.*.points[index - 2].x
        const ay = line.*.points[index - 1].y - line.*.points[index - 2].y
        const bx = line.*.points[index].x - line.*.points[index - 1].x
        const by = line.*.points[index].y - line.*.points[index - 1].y
        const sizes = math.sqrt((ax * ax + ay * ay) * (bx * bx + by * by))
        if sizes > 0.0 {
            if ax * bx + ay * by <= 0.0 { return 2.0 }
            const sine = math.abs(ax * by - ay * bx) / sizes
            if sine > worst { worst = sine }
        }
        index += 1
    }
    return worst
}

// The longest step from one point of the line to the next.
fn widest(line: *const Line) -> f64 {
    var worst: f64 = 0.0
    var index: usize = 1
    while index < line.*.count {
        const step = far(line.*.points[index - 1].x, line.*.points[index - 1].y, line.*.points[index].x, line.*.points[index].y)
        if step > worst { worst = step }
        index += 1
    }
    return worst
}

fn timesGrow(line: *const Line) -> bool {
    var index: usize = 1
    while index < line.*.count {
        if !(line.*.points[index].time >= line.*.points[index - 1].time) { return false }
        index += 1
    }
    return true
}

// Whether every pressure of the line is from `low` to `high`.
fn pressuresWithin(line: *const Line, low: f64, high: f64) -> bool {
    var index: usize = 0
    while index < line.*.count {
        const pressure = line.*.points[index].pressure
        if !(pressure >= low && pressure <= high) { return false }
        index += 1
    }
    return true
}

fn toSegment(px: f64, py: f64, ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    const dx = bx - ax
    const dy = by - ay
    const size = dx * dx + dy * dy
    var part: f64 = 0.0
    if size > 0.0 { part = math.clamp(((px - ax) * dx + (py - ay) * dy) / size, 0.0, 1.0) }
    return far(px, py, ax + dx * part, ay + dy * part)
}

// The furthest any point of `a` is from the line `b`.
fn apart(a: *const Line, b: *const Line) -> f64 {
    var worst: f64 = 0.0
    var index: usize = 0
    while index < a.*.count {
        var nearest: f64 = 1.0e30
        var other: usize = 1
        while other < b.*.count {
            const off = toSegment(a.*.points[index].x, a.*.points[index].y, b.*.points[other - 1].x, b.*.points[other - 1].y, b.*.points[other].x, b.*.points[other].y)
            if off < nearest { nearest = off }
            other += 1
        }
        if nearest > worst { worst = nearest }
        index += 1
    }
    return worst
}

// How far, in the mean (root of the mean square), the line's points
// from `from` on are from the straight line through the origin at `angle`.
fn offLine(line: *const Line, from: usize, angle: f64) -> f64 {
    var sum: f64 = 0.0
    var index = from
    while index < line.*.count {
        const off = line.*.points[index].y * math.cos(angle) - line.*.points[index].x * math.sin(angle)
        sum += off * off
        index += 1
    }
    return math.sqrt(sum / @floatFromInt(f64, line.*.count - from))
}

// The same from the circle of `radius` around the origin.
fn offCircle(line: *const Line, radius: f64) -> f64 {
    var sum: f64 = 0.0
    var index: usize = 0
    while index < line.*.count {
        const off = far(0.0, 0.0, line.*.points[index].x, line.*.points[index].y) - radius
        sum += off * off
        index += 1
    }
    return math.sqrt(sum / @floatFromInt(f64, line.*.count))
}

// A number from -1 to 1, the next of a fixed sequence.
fn noise(seed: *u64) -> f64 {
    seed.* = seed.* *% 6364136223846793005 +% 1442695040888963407
    return @floatFromInt(f64, (seed.* >> 33) & 0xFFFFF) / 524288.0 - 1.0
}

// ---------------------------------------------------------------------------

fn checkNone(s: *Smoother, a: *Line) -> u8 {
    var options = smoothing.defaults()
    options.mode = smoothing.NONE
    smoothing.init(s, &options)
    a.*.count = 0
    // Everything of a point passes, fractions and negative places too.
    var raw = point_module.at(1.5, -2.25, 0.5, 10.0)
    raw.tiltX = 0.25
    raw.tiltY = -0.5
    raw.rotation = 1.0
    var index: usize = 0
    while index < 5 {
        raw.x += 3.0
        raw.y -= 1.5
        raw.time += 7.0
        if smoothing.push(s, &raw, a.*.points + a.*.count, ROOM - a.*.count) != 1 { return 1 }
        if !same(&a.*.points[a.*.count], &raw) { return 2 }
        a.*.count += 1
        index += 1
    }
    // The same place, pressure and hold again says nothing; a change of
    // pressure or tilt does.
    raw.time += 7.0
    if smoothing.push(s, &raw, a.*.points + a.*.count, ROOM - a.*.count) != 0 { return 3 }
    raw.pressure = 0.75
    if smoothing.push(s, &raw, a.*.points + a.*.count, ROOM - a.*.count) != 1 || a.*.points[a.*.count].pressure != 0.75 { return 4 }
    raw.tiltX = 0.5
    if smoothing.push(s, &raw, a.*.points + a.*.count, ROOM - a.*.count) != 1 || a.*.points[a.*.count].tiltX != 0.5 { return 5 }
    // Nothing is owed at the end, and nothing taken after it.
    if lift(s, a) != 0 || smoothing.busy(s) { return 6 }
    if push(s, a, 500.0, 500.0, 1.0, 1000.0) != 0 { return 7 }

    // A time that runs back counts as the last one; what is no place is
    // left out and harms nothing.
    smoothing.reset(s)
    a.*.count = 0
    if push(s, a, 0.0, 0.0, 1.0, 100.0) != 1 || push(s, a, 4.0, 0.0, 1.0, 50.0) != 1 { return 8 }
    if a.*.points[1].time != 100.0 || a.*.points[1].x != 4.0 { return 9 }
    if push(s, a, math.nan(), 0.0, 1.0, 120.0) != 0 || push(s, a, 0.0, math.infinity(), 1.0, 120.0) != 0 || push(s, a, 3.0e9, 0.0, 1.0, 120.0) != 0 { return 10 }
    if push(s, a, 8.0, 0.0, math.nan(), 130.0) != 1 || last(a).*.pressure != 1.0 || last(a).*.x != 8.0 { return 11 }
    // No points at all: no end either.
    smoothing.reset(s)
    a.*.count = 0
    if rest(s, a, 5.0) != 0 || lift(s, a) != 0 || smoothing.busy(s) { return 12 }
    return 0
}

// A whole-pixel line through the origin at `angle`, a raw point every
// `pace` pixels of it (0: at every pixel it touches), a quarter of a
// pixel in a millisecond; a.count afterwards. Returns the furthest the
// line's end was behind the pen after a push.
fn drawLine(s: *Smoother, a: *Line, angle: f64, pace: f64, reach: f64) -> f64 {
    var lag: f64 = 0.0
    var along: f64 = 0.0
    var before_x: f64 = -1.0
    var before_y: f64 = -1.0
    while along <= reach {
        const x = math.round(along * math.cos(angle))
        const y = math.round(along * math.sin(angle))
        if x != before_x || y != before_y {
            _ = push(s, a, x, y, 1.0, along * 4.0)
            if behind(a, x, y) > lag { lag = behind(a, x, y) }
        }
        before_x = x
        before_y = y
        along += if pace > 0.0 { pace } else { 0.25 }
    }
    return lag
}

// A whole-pixel circle of radius 100 around the origin, a raw point every
// `pace` degrees (0: at every pixel), a degree in 10 ms.
fn drawCircle(s: *Smoother, a: *Line, pace: f64) -> void {
    var angle: f64 = 0.0
    var before_x: f64 = -1000.0
    var before_y: f64 = -1000.0
    while angle <= 360.0 {
        const x = math.round(100.0 * math.cos(angle * DEGREE))
        const y = math.round(100.0 * math.sin(angle * DEGREE))
        if x != before_x || y != before_y { _ = push(s, a, x, y, 1.0, angle * 10.0) }
        before_x = x
        before_y = y
        angle += if pace > 0.0 { pace } else { 0.125 }
    }
}

fn checkBasic(s: *Smoother, a: *Line) -> u8 {
    var options = smoothing.defaults()
    options.mode = smoothing.BASIC
    smoothing.init(s, &options)
    // No turn of more than 3.5 degrees from one point to the next: a
    // staircase turns by 45 or 90 at every step.
    const gentle = math.sin(3.5 * DEGREE)

    // A fast pen: a raw point every 8 pixels along 30 degrees. The line
    // is half a raw segment behind and ends at the pen, exactly.
    a.*.count = 0
    var lag = drawLine(s, a, 30.0 * DEGREE, 8.0, 400.0)
    if lag > 5.0 { return 20 }
    if lift(s, a) == 0 || smoothing.busy(s) { return 21 }
    if a.*.points[0].x != 0.0 || a.*.points[0].y != 0.0 || a.*.points[0].time != 0.0 { return 22 }
    const pen = point_module.at(346.0, 200.0, 1.0, 1600.0)
    if !same(last(a), &pen) { return 23 }
    if offLine(a, 0, 30.0 * DEGREE) > 0.2 { return 24 }
    if sharpest(a) > gentle { return 25 }
    if widest(a) > 1.0 + TINY || widest(a) < 0.5 { return 26 }
    if !timesGrow(a) || a.*.count < 400 || a.*.count > 520 { return 27 }

    // A slow pen: a raw point at every pixel, the staircase itself, at
    // every slope. The line is behind the pen by about 10 pixels at
    // most (5 and a step to gather the raw points of a bend, half of
    // that to their mean, half the way between two bends), within a
    // quarter of a pixel of the true line (one nearly along a row of
    // pixels can be little nearer: it is the row) and turns nowhere by
    // more than 3.5 degrees.
    var slope: f64 = 1.5
    while slope < 90.0 {
        smoothing.reset(s)
        a.*.count = 0
        lag = drawLine(s, a, slope * DEGREE, 0.0, 400.0)
        if lag > 10.5 || sharpest(a) > gentle { return 28 }
        const before = a.*.count
        _ = lift(s, a)
        if a.*.count == before { return 29 }
        if last(a).*.x != math.round(400.0 * math.cos(slope * DEGREE)) || last(a).*.y != math.round(400.0 * math.sin(slope * DEGREE)) { return 30 }
        if offLine(a, 0, slope * DEGREE) > 0.25 { return 31 }
        // The end has to reach the pen's pixel, which is where the grid
        // put it: it may turn a little more.
        if sharpest(a) > math.sin(4.5 * DEGREE) { return 32 }
        if widest(a) > 1.0 + TINY || !timesGrow(a) { return 33 }
        slope += 1.5
    }
    // At 30 degrees the staircase's 0.29 pixels from the true line are
    // down to less than 0.1.
    smoothing.reset(s)
    a.*.count = 0
    _ = drawLine(s, a, 30.0 * DEGREE, 0.0, 400.0)
    _ = lift(s, a)
    if offLine(a, 0, 30.0 * DEGREE) > 0.1 || sharpest(a) > gentle || behind(a, 346.0, 200.0) != 0.0 { return 19 }

    // The circle of radius 100, at every pixel (where the mean of the
    // raw points of a bend is much nearer to it than a pixel) and every 6
    // degrees (where every bend is one raw point, half a pixel off).
    smoothing.reset(s)
    a.*.count = 0
    drawCircle(s, a, 0.0)
    _ = lift(s, a)
    if last(a).*.x != 100.0 || last(a).*.y != 0.0 { return 34 }
    if offCircle(a, 100.0) > 0.12 { return 35 }
    if sharpest(a) > gentle || widest(a) > 1.0 + TINY || !timesGrow(a) { return 36 }
    if a.*.count < 620 || a.*.count > 760 { return 37 }
    smoothing.reset(s)
    a.*.count = 0
    drawCircle(s, a, 6.0)
    _ = lift(s, a)
    if offCircle(a, 100.0) > 0.3 || sharpest(a) > gentle || widest(a) > 1.0 + TINY || behind(a, 100.0, 0.0) != 0.0 { return 38 }

    // A finer step: the points nearer, the same way.
    options.step = 0.25
    smoothing.init(s, &options)
    a.*.count = 0
    _ = drawLine(s, a, 30.0 * DEGREE, 8.0, 400.0)
    _ = lift(s, a)
    if widest(a) > 0.25 + TINY || a.*.count < 1600 || offLine(a, 0, 30.0 * DEGREE) > 0.2 { return 39 }
    options.step = 1.0

    // Pressure and time go along the curve: both only grow here, from
    // the first raw point's to the last one's.
    smoothing.init(s, &options)
    a.*.count = 0
    var index: usize = 0
    while index <= 20 {
        const part = @floatFromInt(f64, index) / 20.0
        _ = push(s, a, part * 200.0, math.round(part * part * 60.0), 0.2 + 0.7 * part, part * 400.0)
        index += 1
    }
    _ = lift(s, a)
    if a.*.points[0].pressure != 0.2 || last(a).*.pressure != 0.2 + 0.7 || last(a).*.time != 400.0 { return 40 }
    index = 1
    while index < a.*.count {
        if a.*.points[index].pressure < a.*.points[index - 1].pressure - TINY { return 41 }
        index += 1
    }
    if !timesGrow(a) || !pressuresWithin(a, 0.2, 0.9) { return 42 }
    // The time is the pen's: half way along it is half way through.
    const half = &a.*.points[a.*.count / 2]
    if math.abs(half.*.time - half.*.x * 2.0) > 8.0 { return 43 }

    // The pen rests: the line closes up to it (at the tick that says so,
    // not before), and goes on from there.
    smoothing.reset(s)
    a.*.count = 0
    _ = drawLine(s, a, 30.0 * DEGREE, 0.0, 100.0)
    if behind(a, 87.0, 50.0) < 1.0 { return 44 }
    if rest(s, a, 450.0) != 0 { return 45 }
    if rest(s, a, 520.0) == 0 || behind(a, 87.0, 50.0) != 0.0 { return 46 }
    if rest(s, a, 600.0) != 0 { return 47 }
    _ = push(s, a, 87.0, 60.0, 1.0, 640.0)
    _ = push(s, a, 87.0, 70.0, 1.0, 680.0)
    _ = lift(s, a)
    if last(a).*.x != 87.0 || last(a).*.y != 70.0 || widest(a) > 1.0 + TINY || !timesGrow(a) { return 48 }
    // Only a tick says that the pen rested: a raw point after a long
    // silence may have been held up on its way.
    smoothing.reset(s)
    a.*.count = 0
    _ = drawLine(s, a, 30.0 * DEGREE, 0.0, 100.0)
    const resting = a.*.count
    _ = push(s, a, 87.0, 51.0, 1.0, 900.0)
    if a.*.count != resting || behind(a, 87.0, 51.0) < 1.0 { return 49 }

    // A pen that tells fractions (grain 0): every raw point is a bend,
    // the line half a raw segment behind even at one pixel a point.
    options.grain = 0.0
    smoothing.init(s, &options)
    a.*.count = 0
    lag = 0.0
    index = 0
    while index <= 200 {
        const along = @floatFromInt(f64, index)
        _ = push(s, a, along * 0.8, along * 0.6 + 2.0 * math.sin(along * 0.1), 0.5, along * 4.0)
        if behind(a, along * 0.8, along * 0.6 + 2.0 * math.sin(along * 0.1)) > lag { lag = behind(a, along * 0.8, along * 0.6 + 2.0 * math.sin(along * 0.1)) }
        index += 1
    }
    _ = lift(s, a)
    if lag > 0.75 || sharpest(a) > gentle || behind(a, 160.0, 120.0 + 2.0 * math.sin(20.0)) != 0.0 { return 50 }

    // A click is a dot.
    smoothing.init(s, &options)
    a.*.count = 0
    if push(s, a, 7.0, 9.0, 1.0, 0.0) != 1 || lift(s, a) != 0 || a.*.points[0].x != 7.0 || a.*.points[0].y != 9.0 { return 51 }

    // A canvas at 400 %: the pointer's pixel is a quarter of the image's,
    // and so is everything the grid does to the line.
    options.grain = 1.0
    options = smoothing.forZoom(&options, 4.0)
    options.step = 0.25
    smoothing.init(s, &options)
    a.*.count = 0
    lag = 0.0
    var along: f64 = 0.0
    while along <= 400.0 {
        const x = math.round(along * math.cos(30.0 * DEGREE)) / 4.0
        const y = math.round(along * math.sin(30.0 * DEGREE)) / 4.0
        _ = push(s, a, x, y, 1.0, along * 4.0)
        if behind(a, x, y) > lag { lag = behind(a, x, y) }
        along += 0.25
    }
    _ = lift(s, a)
    if lag > 10.5 / 4.0 || offLine(a, 0, 30.0 * DEGREE) > 0.025 || sharpest(a) > gentle || widest(a) > 0.25 + TINY || behind(a, 86.5, 50.0) != 0.0 { return 52 }
    return 0
}

fn checkWeighted(s: *Smoother, a: *Line) -> u8 {
    var options = smoothing.defaults()
    options.mode = smoothing.WEIGHTED
    options.distance = 30.0
    smoothing.init(s, &options)

    // A straight line with noise of +-2 pixels on every point.
    a.*.count = 0
    var seed: u64 = 12345
    var raw_sum: f64 = 0.0
    var lag: f64 = 0.0
    var pen_x: f64 = 0.0
    var pen_y: f64 = 0.0
    var index: usize = 0
    while index <= 300 {
        pen_x = @floatFromInt(f64, index) * 2.0 + noise(&seed) * 2.0
        pen_y = noise(&seed) * 2.0
        if push(s, a, pen_x, pen_y, 1.0, @floatFromInt(f64, index) * 4.0) != 1 { return 60 }
        raw_sum += pen_y * pen_y
        if behind(a, pen_x, pen_y) > lag { lag = behind(a, pen_x, pen_y) }
        index += 1
    }
    const raw_off = math.sqrt(raw_sum / 301.0)
    // The first points have little before them to be averaged with.
    const out_off = offLine(a, 40, 0.0)
    if raw_off < 1.0 || out_off * 3.0 > raw_off || out_off > 0.35 { return 61 }
    // Behind the pen by less than the sigma: some two thirds of it on a
    // straight way.
    if lag > 30.0 || lag < 10.0 { return 62 }
    // The end closes up to the pen, in a few points.
    const before = a.*.count
    const closing = lift(s, a)
    if closing < 2 || closing > 24 || smoothing.busy(s) { return 63 }
    if last(a).*.x != pen_x || last(a).*.y != pen_y || !timesGrow(a) { return 64 }
    if far(a.*.points[before - 1].x, a.*.points[before - 1].y, pen_x, pen_y) < 10.0 { return 65 }
    index = before
    while index < a.*.count {
        // Each closing point nearer to the pen than the one before.
        if far(a.*.points[index].x, a.*.points[index].y, pen_x, pen_y) >= far(a.*.points[index - 1].x, a.*.points[index - 1].y, pen_x, pen_y) { return 66 }
        index += 1
    }

    // Aggressiveness 0 leaves the end where it is, 1 goes straight to
    // the pen.
    options.tailAggressiveness = 0.0
    smoothing.init(s, &options)
    a.*.count = 0
    index = 0
    while index <= 100 {
        _ = push(s, a, @floatFromInt(f64, index) * 2.0, 0.0, 1.0, @floatFromInt(f64, index) * 4.0)
        index += 1
    }
    if lift(s, a) != 0 || behind(a, 200.0, 0.0) < 10.0 || smoothing.busy(s) { return 67 }
    options.tailAggressiveness = 1.0
    smoothing.init(s, &options)
    a.*.count = 0
    index = 0
    while index <= 100 {
        _ = push(s, a, @floatFromInt(f64, index) * 2.0, 0.0, 1.0, @floatFromInt(f64, index) * 4.0)
        index += 1
    }
    if lift(s, a) != 1 || last(a).*.x != 200.0 || last(a).*.y != 0.0 { return 68 }
    // 0.5 halves the bell curve with every closing point: from 30 below
    // half a pixel in six, the sixth the pen (raw points half a pixel
    // apart, where a sigma of half a pixel still averages).
    options.tailAggressiveness = 0.5
    smoothing.init(s, &options)
    a.*.count = 0
    index = 0
    while index <= 400 {
        _ = push(s, a, @floatFromInt(f64, index) * 0.5, 0.0, 1.0, @floatFromInt(f64, index) * 2.0)
        index += 1
    }
    if lift(s, a) != 6 || last(a).*.x != 200.0 || a.*.points[a.*.count - 2].x >= 200.0 { return 59 }
    options.tailAggressiveness = 0.15

    // The weights go by the way back along the line, not by the number of
    // raw points: the pen telling the same place again (a pen whose
    // pressure changed, a pointer that repeats itself) does not pull the
    // average toward it.
    smoothing.init(s, &options)
    a.*.count = 0
    index = 0
    while index <= 100 {
        _ = push(s, a, @floatFromInt(f64, index) * 2.0, 0.0, 1.0, @floatFromInt(f64, index) * 4.0)
        index += 1
    }
    const held_x = last(a).*.x
    index = 1
    while index <= 10 {
        if push(s, a, 200.0, 0.0, 1.0, 400.0 + @floatFromInt(f64, index) * 4.0) != 0 { return 75 }
        index += 1
    }
    if last(a).*.x != held_x || held_x > 190.0 { return 75 }

    // A clean line stays on itself; of a whole-pixel line's staircase (its
    // points 0.29 from the true line in the mean) a sigma of 8 leaves a
    // quarter.
    smoothing.init(s, &options)
    a.*.count = 0
    index = 0
    while index <= 100 {
        _ = push(s, a, @floatFromInt(f64, index) * 1.5, @floatFromInt(f64, index) * 3.0, 1.0, @floatFromInt(f64, index) * 4.0)
        if math.abs(last(a).*.y - last(a).*.x * 2.0) > TINY { return 69 }
        index += 1
    }
    options.distance = 8.0
    smoothing.init(s, &options)
    a.*.count = 0
    _ = drawLine(s, a, 30.0 * DEGREE, 0.0, 400.0)
    _ = lift(s, a)
    if offLine(a, 0, 30.0 * DEGREE) > 0.08 || behind(a, 346.0, 200.0) != 0.0 || !timesGrow(a) { return 70 }

    // The pressure: the newest raw point's, or averaged like the places.
    options.distance = 30.0
    smoothing.init(s, &options)
    a.*.count = 0
    index = 0
    while index <= 100 {
        const pressure = if index % 2 == 0 { 0.4 } else { 0.8 }
        _ = push(s, a, @floatFromInt(f64, index) * 2.0, 0.0, pressure, @floatFromInt(f64, index) * 4.0)
        if last(a).*.pressure != pressure { return 71 }
        index += 1
    }
    options.smoothPressure = true
    smoothing.init(s, &options)
    a.*.count = 0
    index = 0
    while index <= 100 {
        _ = push(s, a, @floatFromInt(f64, index) * 2.0, 0.0, if index % 2 == 0 { 0.4 } else { 0.8 }, @floatFromInt(f64, index) * 4.0)
        if index > 30 && math.abs(last(a).*.pressure - 0.6) > 0.02 { return 72 }
        index += 1
    }

    // No distance: the points pass.
    options.distance = 0.0
    smoothing.init(s, &options)
    a.*.count = 0
    if push(s, a, 1.0, 2.0, 1.0, 0.0) != 1 || push(s, a, 5.0, 3.0, 1.0, 8.0) != 1 || last(a).*.x != 5.0 || last(a).*.y != 3.0 || lift(s, a) != 0 { return 73 }
    // A click is a dot.
    options.distance = 30.0
    smoothing.init(s, &options)
    a.*.count = 0
    if push(s, a, 7.0, 9.0, 1.0, 0.0) != 1 || lift(s, a) != 0 || a.*.points[0].x != 7.0 { return 74 }
    return 0
}

// A wave drawn at 0.4 pixels a millisecond, whole pixels, an event every
// `interval` ms, 1.5 s long, the end at the pen.
fn drawWave(s: *Smoother, a: *Line, interval: f64) -> void {
    var time: f64 = 0.0
    while time < 1500.0 {
        _ = push(s, a, math.round(time * 0.4), math.round(60.0 * math.sin(time * 0.004)), 1.0, time)
        time += interval
    }
    _ = push(s, a, 600.0, math.round(60.0 * math.sin(6.0)), 1.0, 1500.0)
    _ = lift(s, a)
}

fn checkStabilizer(s: *Smoother, a: *Line, b: *Line) -> u8 {
    var options = smoothing.defaults()
    options.mode = smoothing.STABILIZER
    options.sampleCount = 50
    smoothing.init(s, &options)

    // The brush starts at the pen and falls behind a pen that moves:
    // by the way gone in half the window of 250 ms, on the pen's line.
    a.*.count = 0
    if push(s, a, 0.0, 0.0, 1.0, 0.0) != 1 || a.*.points[0].x != 0.0 || a.*.points[0].time != 0.0 { return 80 }
    var time: f64 = 8.0
    while time <= 400.0 {
        _ = push(s, a, time * 0.5, time * 0.25, 1.0, time)
        if math.abs(last(a).*.y * 2.0 - last(a).*.x) > TINY { return 81 }
        time += 8.0
    }
    const moving = behind(a, 200.0, 100.0)
    if moving < 60.0 || moving > 75.0 || !timesGrow(a) { return 82 }
    // The pen rests (at a place of fractions: no sum of fifty gives it
    // back): every tick brings the brush nearer, until it is there, to
    // the bit, after the window's 250 ms; then ticks say nothing.
    _ = push(s, a, 200.1, 100.3, 1.0, 404.0)
    var gap = behind(a, 200.1, 100.3)
    var ticks: usize = 0
    time = 404.0
    while ticks < 40 {
        time += 16.0
        ticks += 1
        if rest(s, a, time) == 0 { break }
        if behind(a, 200.1, 100.3) >= gap { return 83 }
        gap = behind(a, 200.1, 100.3)
    }
    if gap != 0.0 || ticks < 15 || ticks > 18 { return 84 }
    if rest(s, a, time + 5000.0) != 0 || !timesGrow(a) { return 85 }
    if lift(s, a) != 0 { return 86 }
    // A pointer silent for a second was where it had been (nobody ticked,
    // but its events come only when it moves): the brush did not drift
    // toward where it went then; it sets out when time goes on.
    smoothing.reset(s)
    a.*.count = 0
    if push(s, a, 0.0, 0.0, 1.0, 0.0) != 1 || push(s, a, 100.0, 0.0, 1.0, 1000.0) != 0 { return 79 }
    if rest(s, a, 1100.0) == 0 || last(a).*.x < 30.0 || last(a).*.x > 50.0 { return 78 }
    if rest(s, a, 1300.0) == 0 || last(a).*.x != 100.0 { return 77 }
    // Pen down and resting at a place of fractions: the window is full of
    // it from the start, so ticks bring nothing (an average of fifty of it
    // would be a rounding off and wobble).
    smoothing.reset(s)
    a.*.count = 0
    if push(s, a, 100.1, 100.3, 1.0, 0.0) != 1 || rest(s, a, 1000.0) != 0 || rest(s, a, 5000.0) != 0 || lift(s, a) != 0 { return 76 }

    // The finish line: on, the line runs on to the pointer at the end;
    // off, it ends where the brush was.
    smoothing.reset(s)
    a.*.count = 0
    time = 0.0
    while time <= 400.0 {
        _ = push(s, a, time * 0.5, time * 0.25, 1.0, time)
        time += 8.0
    }
    _ = push(s, a, 200.1, 100.3, 1.0, 404.0)
    const closing = lift(s, a)
    if closing < 10 || closing > 50 || behind(a, 200.1, 100.3) != 0.0 || !timesGrow(a) || smoothing.busy(s) { return 87 }
    options.finishLine = false
    smoothing.init(s, &options)
    a.*.count = 0
    time = 0.0
    while time <= 400.0 {
        _ = push(s, a, time * 0.5, time * 0.25, 1.0, time)
        time += 8.0
    }
    if lift(s, a) != 0 || behind(a, 200.0, 100.0) < 60.0 || smoothing.busy(s) { return 88 }
    options.finishLine = true

    // The same way told every 2 ms and every 16 ms: the same line, well
    // within a pixel.
    smoothing.init(s, &options)
    a.*.count = 0
    drawWave(s, a, 2.0)
    smoothing.reset(s)
    b.*.count = 0
    drawWave(s, b, 16.0)
    if a.*.count < 200 || b.*.count < 200 { return 89 }
    if apart(a, b) > 0.25 || apart(b, a) > 0.25 { return 90 }
    if behind(a, 600.0, last(b).*.y) != 0.0 || last(b).*.x != 600.0 { return 91 }

    // The sensors: steadied with the places, or as the pen tells them.
    smoothing.init(s, &options)
    a.*.count = 0
    time = 0.0
    while time <= 800.0 {
        _ = push(s, a, time * 0.5, 0.0, if @intFromFloat(i64, time / 8.0) % 2 == 0 { 0.3 } else { 0.7 }, time)
        if time > 300.0 && math.abs(last(a).*.pressure - 0.5) > 0.03 { return 92 }
        time += 8.0
    }
    options.stabilizeSensors = false
    smoothing.init(s, &options)
    a.*.count = 0
    var lowest: f64 = 1.0
    var highest: f64 = 0.0
    time = 0.0
    while time <= 800.0 {
        _ = push(s, a, time * 0.5, 0.0, if @intFromFloat(i64, time / 8.0) % 2 == 0 { 0.3 } else { 0.7 }, time)
        if last(a).*.pressure < lowest { lowest = last(a).*.pressure }
        if last(a).*.pressure > highest { highest = last(a).*.pressure }
        time += 8.0
    }
    if lowest > 0.4 || highest < 0.6 || !pressuresWithin(a, 0.3, 0.7) { return 93 }
    options.stabilizeSensors = true

    // One sample: the brush is where the pen was at the last 5 ms.
    options.sampleCount = 0
    smoothing.init(s, &options)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, 10.0, 0.0, 1.0, 10.0)
    if a.*.count != 3 || a.*.points[1].x != 5.0 || a.*.points[2].x != 10.0 || a.*.points[2].time != 10.0 { return 94 }
    options.sampleCount = 50

    // The rope of 20 pixels. Pen down is a point; nothing more while the
    // pointer stays within 20 pixels of it, wherever it wanders.
    options.delayDistance = 20.0
    smoothing.init(s, &options)
    a.*.count = 0
    if push(s, a, 100.0, 100.0, 1.0, 0.0) != 1 { return 95 }
    var turn: f64 = 0.0
    time = 0.0
    while turn < 12.0 {
        time += 8.0
        if push(s, a, 100.0 + 19.0 * math.cos(turn), 100.0 + 19.0 * math.sin(turn), 1.0, time) != 0 { return 96 }
        turn += 0.5
    }
    if rest(s, a, time + 500.0) != 0 || a.*.count != 1 { return 97 }
    // Then the pointer leaves: the brush follows at the rope's length,
    // never further, and no nearer while it is pulled straight on.
    time += 500.0
    var x: f64 = 100.0
    while x <= 400.0 {
        time += 8.0
        _ = push(s, a, x, 100.0 + 3.0 * math.sin(x * 0.7), 1.0, time)
        if behind(a, x, 100.0 + 3.0 * math.sin(x * 0.7)) > 20.0 + TINY { return 98 }
        if x > 160.0 && behind(a, x, 100.0 + 3.0 * math.sin(x * 0.7)) < 20.0 - TINY { return 99 }
        x += 4.0
    }
    if a.*.count < 50 || !timesGrow(a) { return 100 }
    // The pointer wobbled 3 pixels to either side; the brush much less.
    var wobble: f64 = 0.0
    var index: usize = a.*.count / 2
    while index < a.*.count {
        if math.abs(a.*.points[index].y - 100.0) > wobble { wobble = math.abs(a.*.points[index].y - 100.0) }
        index += 1
    }
    if wobble > 0.5 { return 101 }
    // Back toward the brush: inside the rope again, nothing moves.
    if push(s, a, 390.0, 100.0, 1.0, time + 8.0) != 0 || push(s, a, 372.0, 108.0, 1.0, time + 16.0) != 0 { return 102 }
    // The end: on to the pointer, one point, stamped as if drawn at the
    // pen's speed (later than the point before, not at the same time).
    if lift(s, a) != 1 || behind(a, 372.0, 108.0) != 0.0 || !timesGrow(a) || !(last(a).*.time > a.*.points[a.*.count - 2].time) { return 103 }
    options.finishLine = false
    smoothing.init(s, &options)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, 100.0, 0.0, 1.0, 8.0)
    if lift(s, a) != 0 || math.abs(last(a).*.x - 80.0) > TINY || last(a).*.y != 0.0 { return 104 }
    options.finishLine = true
    // The rope too draws the same line at any rate of events.
    smoothing.init(s, &options)
    a.*.count = 0
    drawWave(s, a, 2.0)
    smoothing.reset(s)
    b.*.count = 0
    drawWave(s, b, 16.0)
    if apart(a, b) > 0.5 || apart(b, a) > 0.5 { return 105 }
    // On the rope the sensors are steadied too.
    smoothing.reset(s)
    a.*.count = 0
    time = 0.0
    while time <= 800.0 {
        _ = push(s, a, time * 0.5, 0.0, if @intFromFloat(i64, time / 8.0) % 2 == 0 { 0.3 } else { 0.7 }, time)
        if time > 300.0 && math.abs(last(a).*.pressure - 0.5) > 0.03 { return 107 }
        time += 8.0
    }

    // A time that runs back counts as the last one: the line is the one
    // drawn with that time, not one where the pointer seems to have rested.
    options.delayDistance = 0.0
    smoothing.init(s, &options)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, 10.0, 0.0, 1.0, 100.0)
    _ = push(s, a, 20.0, 0.0, 1.0, 50.0)
    _ = push(s, a, 30.0, 0.0, 1.0, 160.0)
    _ = lift(s, a)
    smoothing.reset(s)
    b.*.count = 0
    _ = push(s, b, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, b, 10.0, 0.0, 1.0, 100.0)
    _ = push(s, b, 20.0, 0.0, 1.0, 100.0)
    _ = push(s, b, 30.0, 0.0, 1.0, 160.0)
    _ = lift(s, b)
    if a.*.count < 10 || !sameLines(a, b) { return 106 }
    return 0
}

fn isCentre(value: f64) -> bool {
    return value - math.floor(value) == 0.5
}

// Whether the line is one of pixels: every point a pixel's centre, every
// step to one of the eight pixels around, and no three in a row an L.
fn pixelPerfect(line: *const Line) -> bool {
    var index: usize = 0
    while index < line.*.count {
        const point = &line.*.points[index]
        if !isCentre(point.*.x) || !isCentre(point.*.y) { return false }
        if index >= 1 {
            const before = &line.*.points[index - 1]
            const dx = math.abs(point.*.x - before.*.x)
            const dy = math.abs(point.*.y - before.*.y)
            if dx > 1.0 || dy > 1.0 || (dx == 0.0 && dy == 0.0) { return false }
            if index >= 2 {
                const first = &line.*.points[index - 2]
                const straight_in = first.*.x == before.*.x || first.*.y == before.*.y
                const straight_out = point.*.x == before.*.x || point.*.y == before.*.y
                if straight_in && straight_out && first.*.x != point.*.x && first.*.y != point.*.y { return false }
            }
        }
        index += 1
    }
    return true
}

fn checkPixel(s: *Smoother, a: *Line) -> u8 {
    var options = smoothing.defaults()
    options.mode = smoothing.PIXEL
    smoothing.init(s, &options)

    // A wavy way across negative places, raw points fractions and up to
    // seven pixels apart.
    a.*.count = 0
    if push(s, a, -40.3, -17.8, 1.0, 0.0) != 1 || a.*.points[0].x != -40.5 || a.*.points[0].y != -17.5 { return 110 }
    var index: usize = 1
    var x: f64 = 0.0
    var y: f64 = 0.0
    while index <= 80 {
        const along = @floatFromInt(f64, index)
        x = -40.3 + along * 3.7
        y = -17.8 + along * 2.1 + 25.0 * math.sin(along * 0.21)
        _ = push(s, a, x, y, 1.0, along * 8.0)
        // One pixel is held back, no more.
        if behind(a, math.floor(x) + 0.5, math.floor(y) + 0.5) > 1.5 { return 111 }
        index += 1
    }
    if lift(s, a) != 1 || smoothing.busy(s) { return 112 }
    if last(a).*.x != math.floor(x) + 0.5 || last(a).*.y != math.floor(y) + 0.5 || last(a).*.time != 640.0 { return 113 }
    if a.*.count < 300 || !pixelPerfect(a) || !timesGrow(a) { return 114 }

    // A staircase told pixel by pixel (right, down, right, down) comes
    // out as the diagonal.
    smoothing.reset(s)
    a.*.count = 0
    index = 0
    while index <= 40 {
        _ = push(s, a, @floatFromInt(f64, (index + 1) / 2), @floatFromInt(f64, index / 2), 1.0, @floatFromInt(f64, index) * 8.0)
        index += 1
    }
    _ = lift(s, a)
    if a.*.count != 21 || !pixelPerfect(a) { return 115 }
    index = 0
    while index < a.*.count {
        if a.*.points[index].x != @floatFromInt(f64, index) + 0.5 || a.*.points[index].y != @floatFromInt(f64, index) + 0.5 { return 116 }
        index += 1
    }
    // A line at 30 degrees: as many pixels as it is wide, one in a column.
    smoothing.reset(s)
    a.*.count = 0
    _ = drawLine(s, a, 30.0 * DEGREE, 0.0, 400.0)
    _ = lift(s, a)
    if a.*.count != 347 || !pixelPerfect(a) || last(a).*.x != 346.5 || last(a).*.y != 200.5 { return 117 }
    // The same pixel again and again is one point; a click is a dot.
    smoothing.reset(s)
    a.*.count = 0
    if push(s, a, 3.2, 3.9, 1.0, 0.0) != 1 || push(s, a, 3.9, 3.1, 1.0, 8.0) != 0 || lift(s, a) != 0 || a.*.count != 1 { return 118 }
    // A leap further than any image is wide is not walked.
    smoothing.reset(s)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, 2.0, 0.0, 1.0, 8.0)
    _ = push(s, a, 50000000.0, 3.0, 1.0, 16.0)
    _ = lift(s, a)
    if a.*.count != 4 || last(a).*.x != 50000000.5 || last(a).*.y != 3.5 || a.*.points[2].x != 2.5 { return 119 }
    // The pixel a leap lands on is kept when the line goes on from it to
    // a neighbour: with the pixel before the leap, two million pixels
    // away, it makes no L. (Its time is its raw point's.)
    smoothing.reset(s)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, 2.0, 0.0, 1.0, 8.0)
    _ = push(s, a, 2000000.0, 0.0, 1.0, 16.0)
    _ = push(s, a, 2000000.0, 1.0, 1.0, 24.0)
    _ = lift(s, a)
    if a.*.count != 5 || a.*.points[2].x != 2.5 || a.*.points[3].x != 2000000.5 || a.*.points[3].y != 0.5 || a.*.points[3].time != 16.0 { return 108 }
    if last(a).*.x != 2000000.5 || last(a).*.y != 1.5 || last(a).*.time != 24.0 { return 108 }
    // So it is when the leap is the first way after pen down, to the left;
    // an L on the far side is cut as anywhere (down, then right: the
    // pixel at the bend goes).
    smoothing.reset(s)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, -2000000.0, 0.0, 1.0, 16.0)
    _ = push(s, a, -2000000.0, -1.0, 1.0, 24.0)
    _ = push(s, a, -1999999.0, -1.0, 1.0, 32.0)
    _ = lift(s, a)
    if a.*.count != 3 || a.*.points[0].x != 0.5 || a.*.points[1].x != -1999999.5 || a.*.points[1].y != 0.5 || a.*.points[1].time != 16.0 { return 109 }
    if last(a).*.x != -1999998.5 || last(a).*.y != -0.5 || last(a).*.time != 32.0 { return 109 }
    return 0
}

// A straight stroke to the right at `speed` pixels a millisecond, an
// event every 8 ms for two seconds.
fn drawAtSpeed(s: *Smoother, a: *Line, speed: f64) -> void {
    var time: f64 = 0.0
    while time <= 2000.0 {
        _ = push(s, a, time * speed, 0.0, 1.0, time)
        time += 8.0
    }
}

fn checkPressure(s: *Smoother, a: *Line, table: [*]f32) -> u8 {
    var options = smoothing.defaults()
    options.mode = smoothing.NONE
    options.simulatePressure = smoothing.PRESSURE_BY_SPEED
    options.speedForMinimum = 2.0
    options.minimumPressure = 0.2
    options.taper = false
    smoothing.init(s, &options)

    // A steady speed gives a steady pressure, a higher speed a lower
    // one, down to the least at 2 pixels a millisecond and beyond.
    var speed: f64 = 0.125
    var slower: f64 = 2.0
    while speed <= 8.0 {
        smoothing.reset(s)
        a.*.count = 0
        drawAtSpeed(s, a, speed)
        const settled = last(a).*.pressure
        const expected = if speed < 2.0 { 0.2 + 0.8 * (1.0 - speed / 2.0) } else { 0.2 }
        if math.abs(settled - expected) > 0.000001 { return 120 }
        if speed <= 2.0 && settled >= slower { return 121 }
        slower = settled
        // The pen was at rest when it came down: full pressure at first,
        // then down to the speed's own within the first half and steady.
        if a.*.points[0].pressure != 1.0 || !pressuresWithin(a, 0.2, 1.0) { return 122 }
        var index: usize = 1
        while index < a.*.count {
            if a.*.points[index].pressure > a.*.points[index - 1].pressure + TINY { return 123 }
            if index > a.*.count / 2 && math.abs(a.*.points[index].pressure - settled) > 0.00001 { return 124 }
            index += 1
        }
        if lift(s, a) != 0 { return 125 }
        speed = speed * 2.0
    }

    // Whole pixels and a slow hand told every 2 ms, each event a pixel on
    // or none (0 or 0.5 pixels a millisecond, one by one): the speed is
    // evened out, the pressure wavers little.
    smoothing.reset(s)
    a.*.count = 0
    var time: f64 = 0.0
    while time <= 2000.0 {
        _ = push(s, a, math.round(time * 0.3), 0.0, 1.0, time)
        if time > 1000.0 && math.abs(last(a).*.pressure - 0.88) > 0.02 { return 126 }
        time += 2.0
    }
    // Two events stamped with the same millisecond (the stamps are whole
    // ones, the events can come faster): the way of both counts once time
    // has passed, so one pixel a millisecond is still 0.6.
    smoothing.reset(s)
    a.*.count = 0
    time = 0.0
    while time <= 2000.0 {
        _ = push(s, a, time - 4.0, 0.0, 1.0, time)
        _ = push(s, a, time, 0.0, 1.0, time)
        time += 8.0
    }
    if math.abs(last(a).*.pressure - 0.6) > 0.000001 { return 147 }
    // Two stamps a hair apart (the least float above 0) say nothing of a
    // speed and do not spoil the rest of the stroke: a quarter pixel a
    // millisecond is still 0.9.
    smoothing.reset(s)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, 2.0, 0.0, 1.0, 5.0e-324)
    time = 8.0
    while time <= 2000.0 {
        _ = push(s, a, time * 0.25, 0.0, 1.0, time)
        time += 8.0
    }
    if math.abs(last(a).*.pressure - 0.9) > 0.000001 { return 149 }

    // The taper: the line starts at the least pressure and rises to the
    // speed's own over the taper's 24 pixels.
    options.taper = true
    smoothing.init(s, &options)
    a.*.count = 0
    drawAtSpeed(s, a, 0.25)
    if a.*.points[0].pressure != 0.2 || !pressuresWithin(a, 0.2, 1.0) { return 127 }
    var index: usize = 1
    while index < a.*.count {
        const point = &a.*.points[index]
        if point.*.x <= 24.0 && point.*.pressure <= a.*.points[index - 1].pressure { return 128 }
        if point.*.x <= 24.0 && point.*.pressure > 0.2 + 0.8 * point.*.x / 24.0 + TINY { return 129 }
        if point.*.x >= 400.0 && math.abs(point.*.pressure - 0.9) > 0.000001 { return 130 }
        index += 1
    }
    // The end, the pen lifted while moving: the line runs out to the
    // right of it, 15 pixels (60 ms of the speed), the pressure falling
    // to the least.
    const before = a.*.count
    const closing = lift(s, a)
    if closing < 3 || closing > 16 || smoothing.busy(s) { return 131 }
    index = before
    while index < a.*.count {
        const point = &a.*.points[index]
        if point.*.pressure >= a.*.points[index - 1].pressure || point.*.x <= a.*.points[index - 1].x || math.abs(point.*.y) > TINY { return 132 }
        index += 1
    }
    if last(a).*.pressure != 0.2 || math.abs(last(a).*.x - 515.0) > 0.01 || !timesGrow(a) { return 133 }
    if math.abs(last(a).*.time - 2060.0) > 0.1 { return 134 }
    // A faster pen runs out further, but never beyond the taper's length.
    smoothing.reset(s)
    a.*.count = 0
    drawAtSpeed(s, a, 1.0)
    _ = lift(s, a)
    if math.abs(last(a).*.x - 2024.0) > TINY || last(a).*.pressure != 0.2 { return 135 }
    // A short quick stroke, lifted while the start's taper still rises:
    // the end's points fall evenly from where the line was to the least
    // (the start's taper is not laid on them once more).
    smoothing.reset(s)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 1.0, 0.0)
    _ = push(s, a, 8.0, 0.0, 1.0, 8.0)
    _ = push(s, a, 16.0, 0.0, 1.0, 16.0)
    const short_end = a.*.count
    const short_closing = lift(s, a)
    if short_end != 3 || short_closing < 2 { return 148 }
    const short_from = a.*.points[short_end - 1].pressure
    if !(short_from > 0.3 && short_from < 0.2 + 0.8 * 16.0 / 24.0) { return 148 }
    index = 0
    while index < short_closing {
        const expected = short_from + (0.2 - short_from) * @floatFromInt(f64, index + 1) / @floatFromInt(f64, short_closing)
        const point = &a.*.points[short_end + index]
        if math.abs(point.*.pressure - expected) > TINY || !(point.*.x > 16.0) || point.*.y != 0.0 { return 148 }
        index += 1
    }
    // A pen that rested before it lifted ends blunt, where it is.
    smoothing.reset(s)
    a.*.count = 0
    drawAtSpeed(s, a, 0.25)
    _ = rest(s, a, 3000.0)
    if lift(s, a) != 0 || last(a).*.x != 500.0 || math.abs(last(a).*.pressure - 0.9) > 0.000001 { return 136 }
    // A click is a dot at the least pressure.
    smoothing.reset(s)
    a.*.count = 0
    if push(s, a, 5.0, 5.0, 1.0, 0.0) != 1 || lift(s, a) != 0 || a.*.points[0].pressure != 0.2 { return 137 }
    // Another least.
    options.minimumPressure = 0.5
    smoothing.init(s, &options)
    a.*.count = 0
    drawAtSpeed(s, a, 3.0)
    // A line as thin as it gets already does not run out at the end.
    if lift(s, a) != 0 || !pressuresWithin(a, 0.5, 1.0) || last(a).*.pressure != 0.5 || a.*.points[0].pressure != 0.5 { return 138 }
    options.minimumPressure = 0.2

    // Real pressure is left alone: a point that brings some makes the
    // stroke a pen's, and full pressure after it stays full; a pen's
    // stroke is never touched.
    smoothing.init(s, &options)
    a.*.count = 0
    if push(s, a, 0.0, 0.0, 0.4, 0.0) != 1 || a.*.points[0].pressure != 0.4 { return 139 }
    if push(s, a, 50.0, 0.0, 1.0, 8.0) != 1 || a.*.points[1].pressure != 1.0 { return 140 }
    if push(s, a, 100.0, 0.0, 0.0, 16.0) != 1 || a.*.points[2].pressure != 0.0 || lift(s, a) != 0 { return 141 }
    options.hasPressure = true
    smoothing.init(s, &options)
    a.*.count = 0
    drawAtSpeed(s, a, 3.0)
    if !pressuresWithin(a, 1.0, 1.0) || lift(s, a) != 0 { return 142 }
    options.hasPressure = false

    // Through the curves of the other modes the pressure stays between
    // the least and full, and the taper is theirs too.
    var mode: u8 = smoothing.BASIC
    while mode <= smoothing.STABILIZER {
        options.mode = mode
        smoothing.init(s, &options)
        a.*.count = 0
        time = 0.0
        while time <= 1200.0 {
            _ = push(s, a, math.round(time * (0.2 + time * 0.001)), math.round(30.0 * math.sin(time * 0.01)), 1.0, time)
            time += 8.0
        }
        const drawn = a.*.count
        if lift(s, a) == 0 { return 143 }
        if !pressuresWithin(a, 0.2, 1.0) || a.*.points[0].pressure != 0.2 || last(a).*.pressure != 0.2 { return 144 }
        // Slow at first, fast at the end: thinner there.
        if a.*.points[drawn - 1].pressure > a.*.points[drawn / 4].pressure - 0.2 { return 145 }
        if !timesGrow(a) { return 146 }
        mode += 1
    }

    // The tablet's curve, here the square: on every pressure that
    // leaves, between two entries a straight line.
    options = smoothing.defaults()
    options.mode = smoothing.NONE
    options.pressureCurve = table
    smoothing.init(s, &options)
    a.*.count = 0
    _ = push(s, a, 0.0, 0.0, 0.0, 0.0)
    _ = push(s, a, 1.0, 0.0, 1.0, 8.0)
    _ = push(s, a, 2.0, 0.0, 0.5, 16.0)
    _ = push(s, a, 3.0, 0.0, 0.2, 24.0)
    if a.*.count != 4 || a.*.points[0].pressure != 0.0 || a.*.points[1].pressure != 1.0 { return 150 }
    const middle = (@floatCast(f64, table[127]) + @floatCast(f64, table[128])) / 2.0
    if math.abs(a.*.points[2].pressure - middle) > TINY || math.abs(middle - 0.25) > 0.0001 { return 151 }
    if a.*.points[3].pressure != @floatCast(f64, table[51]) || math.abs(a.*.points[3].pressure - 0.04) > 0.000001 { return 152 }
    // And on the pressure made from speed: 0.6 at one pixel a millisecond.
    options.simulatePressure = smoothing.PRESSURE_BY_SPEED
    options.taper = false
    smoothing.init(s, &options)
    a.*.count = 0
    drawAtSpeed(s, a, 1.0)
    if math.abs(last(a).*.pressure - 0.36) > 0.0001 || a.*.points[0].pressure != 1.0 { return 153 }
    return 0
}

// One stroke in `mode` with everything on, `room` points at most taken
// at a call (the rest left waiting; 0: nothing taken until the end), a
// rest in the middle and the end: a.count afterwards. `doubled`: every
// raw point comes twice, as a repeated event (the same millisecond).
fn play(s: *Smoother, a: *Line, room: usize, doubled: bool) -> void {
    var time: f64 = 0.0
    var index: usize = 0
    while index < 110 {
        const along = @floatFromInt(f64, index)
        const raw = point_module.at(math.round(along * 5.0), math.round(40.0 * math.sin(along * 0.11)), 1.0, time)
        a.*.count += smoothing.push(s, &raw, a.*.points + a.*.count, spare(a, room))
        if doubled { a.*.count += smoothing.push(s, &raw, a.*.points + a.*.count, spare(a, room)) }
        time += 8.0
        if index == 60 {
            time += 200.0
            a.*.count += smoothing.tick(s, time - 100.0, a.*.points + a.*.count, spare(a, room))
            a.*.count += smoothing.tick(s, time, a.*.points + a.*.count, spare(a, room))
        }
        index += 1
    }
    a.*.count += smoothing.tick(s, time, a.*.points + a.*.count, spare(a, room))
    a.*.count += smoothing.finish(s, a.*.points + a.*.count, spare(a, room))
    const taking = if room == 0 { 5 } else { room }
    while smoothing.busy(s) {
        a.*.count += smoothing.drain(s, a.*.points + a.*.count, spare(a, taking))
    }
}

fn everything(mode: u8, rope: f64, table: [*]f32) -> smoothing.Options {
    var options = smoothing.defaults()
    options.mode = mode
    options.distance = 12.0
    options.delayDistance = rope
    options.simulatePressure = smoothing.PRESSURE_BY_SPEED
    options.pressureCurve = table
    return options
}

fn checkCapacity(s: *Smoother, other: *Smoother, a: *Line, b: *Line, table: [*]f32) -> u8 {
    var variant: u8 = 0
    while variant < 6 {
        // The five modes, and the stabilizer on its rope.
        const mode = if variant == 5 { smoothing.STABILIZER } else { variant }
        var options = everything(mode, if variant == 5 { 12.0 } else { 0.0 }, table)
        smoothing.init(s, &options)
        a.*.count = 0
        play(s, a, ROOM, false)
        if a.*.count < 100 || smoothing.busy(s) || !timesGrow(a) || widest(a) > 30.0 { return 160 }

        // One point at a call, three, none: the same points, to the bit.
        b.*.count = 0
        smoothing.reset(s)
        play(s, b, 1, false)
        if !sameLines(a, b) { return 161 }
        b.*.count = 0
        smoothing.reset(s)
        play(s, b, 3, false)
        if !sameLines(a, b) { return 162 }
        b.*.count = 0
        smoothing.reset(s)
        play(s, b, 0, false)
        if !sameLines(a, b) { return 163 }

        // After another stroke left unfinished, reset() gives the same
        // again; and so does another smoother.
        smoothing.reset(s)
        b.*.count = 0
        _ = smoothing.push(s, &a.*.points[5], b.*.points, 0)
        _ = smoothing.push(s, &a.*.points[50], b.*.points, 1)
        _ = smoothing.push(s, &a.*.points[20], b.*.points, 0)
        if !smoothing.busy(s) { return 164 }
        smoothing.reset(s)
        if smoothing.busy(s) || smoothing.drain(s, b.*.points, 10) != 0 { return 165 }
        play(s, b, ROOM, false)
        if !sameLines(a, b) { return 166 }
        smoothing.init(other, &options)
        b.*.count = 0
        play(other, b, 7, false)
        if !sameLines(a, b) { return 167 }
        // An event repeated (the same place and millisecond) changes
        // nothing.
        smoothing.reset(s)
        b.*.count = 0
        play(s, b, 2, true)
        if !sameLines(a, b) { return 179 }
        variant += 1
    }

    // A call with room for nothing takes the raw point all the same, and
    // says that points wait.
    var options = smoothing.defaults()
    options.mode = smoothing.BASIC
    smoothing.init(s, &options)
    a.*.count = 0
    var raw = point_module.at(0.0, 0.0, 1.0, 0.0)
    if smoothing.push(s, &raw, a.*.points, 0) != 0 || !smoothing.busy(s) { return 168 }
    raw.x = 40.0
    raw.time = 8.0
    if smoothing.push(s, &raw, a.*.points, 2) != 2 || !smoothing.busy(s) { return 169 }
    if a.*.points[0].x != 0.0 || math.abs(a.*.points[1].x - 1.0) > TINY { return 170 }
    a.*.count = 2
    while smoothing.busy(s) {
        a.*.count += smoothing.drain(s, a.*.points + a.*.count, 4)
    }
    if a.*.count != 21 || math.abs(last(a).*.x - 20.0) > TINY { return 171 }

    // More raw points than can wait, none ever taken: the first ones are
    // kept (three ticks wait among them), the newest place is the newest
    // point's, and the line ends at the pen.
    options.mode = smoothing.NONE
    smoothing.init(s, &options)
    var index: usize = 0
    while index < 1000 {
        raw.x = @floatFromInt(f64, index)
        raw.time = @floatFromInt(f64, index)
        if smoothing.push(s, &raw, a.*.points, 0) != 0 { return 172 }
        if index % 100 == 50 && smoothing.tick(s, raw.time, a.*.points, 0) != 0 { return 173 }
        index += 1
    }
    // A tick into the full queue is dropped, not put in the newest raw
    // point's place.
    if smoothing.tick(s, 1000.0, a.*.points, 0) != 0 { return 173 }
    a.*.count = smoothing.finish(s, a.*.points, ROOM)
    // The first QUEUE events are kept: the raw points 0, 1, ... with a
    // tick after 50, 150, ... among them; the last place goes to the
    // newest raw point.
    var kept_raw: usize = 0
    var events: usize = 0
    while events < smoothing.QUEUE {
        events += 1
        if kept_raw % 100 == 50 && events < smoothing.QUEUE { events += 1 }
        kept_raw += 1
    }
    if a.*.count != kept_raw || smoothing.busy(s) { return 174 }
    if a.*.points[0].x != 0.0 || a.*.points[kept_raw - 2].x != @floatFromInt(f64, kept_raw - 2) || last(a).*.x != 999.0 { return 175 }

    // A leap of 50000 pixels in BASIC: every pixel of it, taken 4096 at
    // a time.
    options.mode = smoothing.BASIC
    smoothing.init(s, &options)
    raw.x = 0.0
    raw.time = 0.0
    var total = smoothing.push(s, &raw, a.*.points, 4096)
    raw.x = 50000.0
    raw.time = 8.0
    total += smoothing.push(s, &raw, a.*.points, 4096)
    if total != 4097 { return 176 }
    var end_x = a.*.points[4095].x
    var widest_step: f64 = 0.0
    var finished = false
    while true {
        const count = if finished { smoothing.drain(s, a.*.points, 4096) } else { smoothing.finish(s, a.*.points, 4096) }
        finished = true
        if count == 0 { break }
        index = 0
        while index < count {
            if a.*.points[index].x - end_x > widest_step { widest_step = a.*.points[index].x - end_x }
            end_x = a.*.points[index].x
            index += 1
        }
        total += count
    }
    if total != 50001 || end_x != 50000.0 || widest_step > 1.0 + TINY || smoothing.busy(s) { return 177 }
    // And one of 1e8: cut into no more than 2^20 steps a piece, it ends
    // at the pen.
    smoothing.reset(s)
    raw.x = 0.0
    total = smoothing.push(s, &raw, a.*.points, 4096)
    raw.x = 100000000.0
    raw.y = -100000000.0
    total += smoothing.push(s, &raw, a.*.points, 4096)
    finished = false
    while true {
        const count = if finished { smoothing.drain(s, a.*.points, ROOM) } else { smoothing.finish(s, a.*.points, ROOM) }
        finished = true
        if count == 0 { break }
        end_x = a.*.points[count - 1].x
        total += count
    }
    if total != 2097153 || end_x != 100000000.0 { return 178 }
    return 0
}

fn checkRest(s: *Smoother) -> u8 {
    // Names for people, in both languages.
    if !std.text.same(smoothing.title(smoothing.BASIC, false), "Basic") || !std.text.same(smoothing.title(smoothing.PIXEL, true), "Pixelgenau") { return 200 }
    var mode: u8 = 0
    while mode < 7 {
        if smoothing.title(mode, false).length == 0 || smoothing.title(mode, true).length == 0 { return 201 }
        mode += 1
    }
    if !std.text.same(smoothing.title(99, false), smoothing.title(smoothing.NONE, false)) { return 202 }

    // Lengths meant on the screen, for a canvas at 400 %.
    var options = smoothing.defaults()
    options.distance = 20.0
    options.delayDistance = 40.0
    const near = smoothing.forZoom(&options, 4.0)
    if near.distance != 5.0 || near.delayDistance != 10.0 || near.grain != 0.25 || near.step != options.step { return 203 }
    if near.speedForMinimum != options.speedForMinimum / 4.0 || near.taperLength != options.taperLength / 4.0 { return 204 }
    options.scalable = false
    if smoothing.forZoom(&options, 4.0).distance != 20.0 || smoothing.forZoom(&options, 0.0).delayDistance != 40.0 { return 205 }
    // A zoom that is none leaves the options as they are.
    const unzoomed = smoothing.forZoom(&options, math.nan())
    const negative = smoothing.forZoom(&options, -2.0)
    if unzoomed.grain != options.grain || unzoomed.delayDistance != 40.0 || negative.grain != options.grain || negative.speedForMinimum != options.speedForMinimum || negative.taperLength != options.taperLength { return 229 }
    // Every mode has its own name, in both languages.
    var first: u8 = 0
    while @intCast(usize, first) < smoothing.MODES {
        var second: u8 = first + 1
        while @intCast(usize, second) < smoothing.MODES {
            if std.text.same(smoothing.title(first, false), smoothing.title(second, false)) || std.text.same(smoothing.title(first, true), smoothing.title(second, true)) { return 230 }
            second += 1
        }
        first += 1
    }

    // Options that make no sense become ones that do.
    options.mode = 99
    options.step = math.nan()
    options.distance = -5.0
    options.sampleCount = 100000
    options.minimumPressure = 7.0
    options.speedForMinimum = 0.0
    smoothing.init(s, &options)
    if s.*.options.mode != smoothing.NONE || s.*.options.step != 1.0 || s.*.options.distance != 0.0 { return 206 }
    if @intCast(usize, s.*.options.sampleCount) != smoothing.SAMPLES || s.*.options.minimumPressure != 1.0 || s.*.options.speedForMinimum <= 0.0 { return 207 }
    return 0
}

fn below(seed: *u64, count: u64) -> u64 {
    seed.* = seed.* *% 6364136223846793005 +% 1442695040888963407
    return (seed.* >> 33) % count
}

// Three thousand strokes of whatever comes: any options, steps of a pixel
// and leaps, the same place again, time standing still, running back and
// long silences, pressure from a pen or none, a NaN now and then, ticks
// in between, room for many points or few or none. Whatever goes in,
// what comes out is a place, at a time not before the last one's, with a
// pressure from 0 to 1 and no more tilt than went in; pixel art stays on
// pixel centres; and when all is taken, nothing waits.
fn checkOdd(s: *Smoother, a: *Line, table: [*]f32) -> u8 {
    var seed: u64 = 99
    var options = smoothing.defaults()
    var round: usize = 0
    while round < 3000 {
        options.mode = @intCast(u8, below(&seed, 5))
        options.grain = @floatFromInt(f64, below(&seed, 3))
        options.step = if below(&seed, 2) == 0 { 0.3 } else { 2.5 }
        options.distance = if below(&seed, 4) == 0 { 0.0 } else if below(&seed, 2) == 0 { 3.0 } else { 20.0 }
        options.tailAggressiveness = @floatFromInt(f64, below(&seed, 3)) * 0.5
        options.smoothPressure = below(&seed, 2) == 0
        options.sampleCount = if below(&seed, 3) == 0 { 1 } else if below(&seed, 2) == 0 { 7 } else { 256 }
        options.delayDistance = if below(&seed, 2) == 0 { 0.0 } else if below(&seed, 2) == 0 { 5.0 } else { 40.0 }
        options.finishLine = below(&seed, 3) != 0
        options.stabilizeSensors = below(&seed, 2) == 0
        options.simulatePressure = @intCast(u8, below(&seed, 2))
        options.hasPressure = below(&seed, 5) == 0
        options.minimumPressure = @floatFromInt(f64, below(&seed, 3)) * 0.5
        options.taper = below(&seed, 2) == 0
        options.taperLength = @floatFromInt(f64, below(&seed, 3)) * 12.0
        options.pressureCurve = null
        if below(&seed, 3) == 0 { options.pressureCurve = table }
        smoothing.init(s, &options)
        const room: usize = if below(&seed, 4) == 0 { 0 } else if below(&seed, 3) == 0 { 2 } else { ROOM }
        const wild = below(&seed, 6) == 0
        const pen = below(&seed, 4) == 0
        var x = @floatFromInt(f64, below(&seed, 400)) - 200.0
        var y = @floatFromInt(f64, below(&seed, 400)) - 200.0
        var time = @floatFromInt(f64, below(&seed, 1000))
        a.*.count = 0
        var left = below(&seed, 60) + 1
        while left > 0 && a.*.count < ROOM / 2 {
            const move = below(&seed, 10)
            if move == 1 && wild {
                x += @floatFromInt(f64, below(&seed, 3000)) - 1500.0
                y += @floatFromInt(f64, below(&seed, 3000)) - 1500.0
            } else if move >= 1 && move < 6 {
                x += @floatFromInt(f64, below(&seed, 3)) - 1.0
                y += @floatFromInt(f64, below(&seed, 3)) - 1.0
            } else if move >= 6 {
                x += @floatFromInt(f64, below(&seed, 300)) * 0.1 - 15.0
                y += @floatFromInt(f64, below(&seed, 300)) * 0.1 - 15.0
            }
            const wait = below(&seed, 12)
            time += if wait < 4 { 0.0 } else if wait < 9 { 8.0 } else if wait == 9 { 1.0 } else if wait == 10 { 150.0 } else { -20.0 }
            var raw = point_module.at(x, y, 1.0, time)
            if pen { raw.pressure = @floatFromInt(f64, below(&seed, 101)) * 0.01 }
            if below(&seed, 50) == 0 { raw.pressure = math.nan() }
            if below(&seed, 70) == 0 { raw.x = math.nan() }
            if below(&seed, 70) == 0 { raw.time = math.infinity() }
            raw.tiltX = @floatFromInt(f64, below(&seed, 101)) * 0.01 - 0.5
            a.*.count += smoothing.push(s, &raw, a.*.points + a.*.count, spare(a, room))
            if below(&seed, 5) == 0 { a.*.count += smoothing.tick(s, time + @floatFromInt(f64, below(&seed, 300)), a.*.points + a.*.count, spare(a, room)) }
            left -= 1
        }
        a.*.count += smoothing.finish(s, a.*.points + a.*.count, spare(a, room))
        var calls: usize = 0
        while smoothing.busy(s) && a.*.count < ROOM - 64 {
            a.*.count += smoothing.drain(s, a.*.points + a.*.count, 64)
            calls += 1
            if calls > ROOM { return 210 }
        }
        if a.*.count < ROOM - 64 && (smoothing.busy(s) || smoothing.drain(s, a.*.points + a.*.count, 64) != 0) { return 211 }
        var index: usize = 0
        while index < a.*.count {
            const point = &a.*.points[index]
            if !(math.abs(point.*.x) < 10000.0 && math.abs(point.*.y) < 10000.0) { return 212 }
            if !(point.*.time < 100000.0) || (index > 0 && !(point.*.time >= a.*.points[index - 1].time)) { return 213 }
            if !(point.*.pressure >= 0.0 && point.*.pressure <= 1.0) { return 214 }
            if !(math.abs(point.*.tiltX) <= 0.5) || point.*.tiltY != 0.0 || point.*.rotation != 0.0 { return 215 }
            if options.mode == smoothing.PIXEL && (!isCentre(point.*.x) || !isCentre(point.*.y)) { return 216 }
            index += 1
        }
        round += 1
    }
    return 0
}

// A wandering stroke of 200 raw points (whole pixels and quarters, tilt,
// pauses of 120 ms, ticks now and then), mirrored when `sign` is -1,
// moved by (dx, dy), its stamps (whole milliseconds) from `start` on;
// ended with a tick and finish(). a.count afterwards.
fn wander(s: *Smoother, a: *Line, sign: f64, dx: f64, dy: f64, start: f64) -> void {
    a.*.count = 0
    var time = start
    var index: usize = 0
    while index < 200 {
        const along = @floatFromInt(f64, index)
        const x = math.round(along * 3.0 + 10.0 * math.sin(along * 0.2)) + 0.25 * @floatFromInt(f64, index % 3)
        var raw = point_module.at(sign * x + dx, math.round(30.0 * math.cos(along * 0.07)) - 7.0 + dy, 1.0, time)
        raw.tiltX = 0.125 * @floatFromInt(f64, index % 5)
        a.*.count += smoothing.push(s, &raw, a.*.points + a.*.count, ROOM - a.*.count)
        time += if index % 17 == 0 { 120.0 } else { 7.0 }
        if index % 23 == 0 { _ = rest(s, a, time - 3.0) }
        index += 1
    }
    _ = rest(s, a, time + 40.0)
    _ = lift(s, a)
}

// What follows from the arithmetic, not from a number found by trying:
// IEEE arithmetic rounds a negated sum to the negated result, so a stroke
// mirrored left to right comes out mirrored bit for bit (every mode but
// PIXEL, whose pixels are not symmetric about 0); a pixel line moved by
// whole tiles (across 0, into negative places) is the same line moved;
// and nothing hangs on when a stroke is drawn, only on the time between
// its points: stamps 2^40 ms later or earlier (whole milliseconds, exact
// there too) give the same places and pressures.
fn checkProperties(s: *Smoother, a: *Line, b: *Line) -> u8 {
    var variant: u8 = 0
    while variant < 10 {
        // NONE, BASIC, WEIGHTED, STABILIZER, its rope; with pressure
        // made from speed (and its tapers) and without.
        var options = smoothing.defaults()
        options.mode = if variant % 5 == 4 { smoothing.STABILIZER } else { variant % 5 }
        if variant % 5 == 4 { options.delayDistance = 9.0 }
        if variant >= 5 { options.simulatePressure = smoothing.PRESSURE_BY_SPEED }
        smoothing.init(s, &options)
        wander(s, a, 1.0, 0.0, 0.0, 0.0)
        smoothing.reset(s)
        wander(s, b, -1.0, 0.0, 0.0, 0.0)
        if a.*.count < 150 || a.*.count != b.*.count { return 218 }
        var index: usize = 0
        while index < a.*.count {
            const p = &a.*.points[index]
            const q = &b.*.points[index]
            if p.*.x != -q.*.x || p.*.y != q.*.y || p.*.pressure != q.*.pressure || p.*.tiltX != q.*.tiltX || p.*.time != q.*.time { return 218 }
            index += 1
        }
        var shift: f64 = 1099511627776.0
        while shift > -2.0e12 {
            smoothing.reset(s)
            wander(s, b, 1.0, 0.0, 0.0, shift)
            if a.*.count != b.*.count { return 219 }
            index = 0
            while index < a.*.count {
                const p = &a.*.points[index]
                const q = &b.*.points[index]
                if p.*.x != q.*.x || p.*.y != q.*.y || p.*.pressure != q.*.pressure || math.abs(p.*.time + shift - q.*.time) > 0.01 { return 219 }
                index += 1
            }
            shift = shift - 2199023255552.0
        }
        variant += 1
    }
    var options = smoothing.defaults()
    options.mode = smoothing.PIXEL
    options.simulatePressure = smoothing.PRESSURE_BY_SPEED
    smoothing.init(s, &options)
    wander(s, a, 1.0, 0.0, 0.0, 0.0)
    smoothing.reset(s)
    wander(s, b, 1.0, -320.0, 192.0, 0.0)
    if a.*.count < 300 || a.*.count != b.*.count || !pixelPerfect(b) { return 217 }
    var index: usize = 0
    while index < a.*.count {
        const p = &a.*.points[index]
        const q = &b.*.points[index]
        if p.*.x - 320.0 != q.*.x || p.*.y + 192.0 != q.*.y || p.*.pressure != q.*.pressure || p.*.time != q.*.time { return 217 }
        index += 1
    }
    return 0
}

// The tablet's curve at its ends and beyond them: a table whose first
// entry is -0.5 and last 1.5 (the rest index / 255) gives out 0 to 1 only,
// for pressures of 0 to 1 and beyond.
fn checkCurveEdges(s: *Smoother, a: *Line, table: [*]f32) -> u8 {
    var index: usize = 0
    while index < 256 {
        table[index] = @floatCast(f32, @floatFromInt(f64, index) / 255.0)
        index += 1
    }
    table[0] = -0.5
    table[255] = 1.5
    var options = smoothing.defaults()
    options.mode = smoothing.NONE
    options.pressureCurve = table
    smoothing.init(s, &options)
    a.*.count = 0
    // At entry 0 (-0.5), and half way to entry 1 (about -0.25): 0.
    _ = push(s, a, 0.0, 0.0, 0.0, 0.0)
    _ = push(s, a, 1.0, 0.0, 0.5 / 255.0, 8.0)
    // Below 0: as 0.
    _ = push(s, a, 2.0, 0.0, -3.0, 16.0)
    if a.*.count != 3 || a.*.points[0].pressure != 0.0 || a.*.points[1].pressure != 0.0 || a.*.points[2].pressure != 0.0 { return 220 }
    // At entry 255 (1.5), half way to it from entry 254 (about 1.25), and
    // above 1: 1.
    _ = push(s, a, 3.0, 0.0, 1.0, 24.0)
    _ = push(s, a, 4.0, 0.0, 254.5 / 255.0, 32.0)
    _ = push(s, a, 5.0, 0.0, 7.0, 40.0)
    if a.*.count != 6 || a.*.points[3].pressure != 1.0 || a.*.points[4].pressure != 1.0 || a.*.points[5].pressure != 1.0 { return 221 }
    // Inside, the entries as they are: 0.6 is entry 153.
    _ = push(s, a, 6.0, 0.0, 0.6, 48.0)
    if a.*.count != 7 || math.abs(last(a).*.pressure - 0.6) > 0.000001 { return 222 }
    return 0
}

// The smoother's memory: one heap block, under the 32 KiB from which a
// block takes one of brixOS's 256 memory regions, given back whole.
fn checkMemory() -> u8 {
    if @sizeOf(Smoother) > 32768 { return 223 }
    const allocator = std.heap.allocator()
    var options = smoothing.defaults()
    const before = std.heap.liveBytes()
    var index: usize = 0
    while index < 100 {
        const made = smoothing.create(allocator, &options)
        if made == null { return 224 }
        if smoothing.busy(made.?) || made.?.*.options.mode != smoothing.BASIC { return 224 }
        smoothing.destroy(allocator, made.?)
        index += 1
    }
    if std.heap.liveBytes() != before { return 224 }
    return 0
}

// One stroke of whatever comes from `start` (no NaN: every raw point
// counts), `room` points at a call (0: none while drawing, one at a time
// at the end). Checks, with all the room, that the brush on the rope is
// never further from the pen than the rope after a raw point.
fn wild(s: *Smoother, a: *Line, start: u64, room: usize) -> bool {
    var seed = start
    a.*.count = 0
    var x = @floatFromInt(f64, below(&seed, 400)) - 200.0
    var y = @floatFromInt(f64, below(&seed, 400)) - 200.0
    var time = @floatFromInt(f64, below(&seed, 1000))
    var left = below(&seed, 60) + 1
    const rope = s.*.options.mode == smoothing.STABILIZER && s.*.options.delayDistance > 0.0
    while left > 0 {
        const move = below(&seed, 10)
        if move == 1 {
            x += @floatFromInt(f64, below(&seed, 300)) - 150.0
            y += @floatFromInt(f64, below(&seed, 300)) - 150.0
        } else if move < 6 {
            x += @floatFromInt(f64, below(&seed, 3)) - 1.0
            y += @floatFromInt(f64, below(&seed, 3)) - 1.0
        } else {
            x += @floatFromInt(f64, below(&seed, 300)) * 0.1 - 15.0
            y += @floatFromInt(f64, below(&seed, 300)) * 0.1 - 15.0
        }
        const wait = below(&seed, 12)
        time += if wait < 3 { 0.0 } else if wait < 9 { 8.0 } else if wait == 9 { 1.0 } else if wait == 10 { 150.0 } else { -20.0 }
        var raw = point_module.at(x, y, 1.0, time)
        if below(&seed, 7) == 0 { raw.pressure = @floatFromInt(f64, below(&seed, 101)) * 0.01 }
        raw.tiltX = @floatFromInt(f64, below(&seed, 101)) * 0.01 - 0.5
        a.*.count += smoothing.push(s, &raw, a.*.points + a.*.count, spare(a, room))
        if rope && room == ROOM && behind(a, x, y) > s.*.options.delayDistance + TINY { return false }
        if below(&seed, 5) == 0 { a.*.count += smoothing.tick(s, time + @floatFromInt(f64, below(&seed, 300)), a.*.points + a.*.count, spare(a, room)) }
        left -= 1
    }
    a.*.count += smoothing.finish(s, a.*.points + a.*.count, spare(a, room))
    while smoothing.busy(s) {
        a.*.count += smoothing.drain(s, a.*.points + a.*.count, spare(a, if room == 0 { 1 } else { room }))
    }
    return true
}

// A thousand strokes of whatever comes, under any options, taken with all
// the room and then with room for 0 to 3 points at a call: the same
// points, to the bit. The rope holds; pixel art stays pixel perfect.
fn checkWild(s: *Smoother, a: *Line, b: *Line) -> u8 {
    var seed: u64 = 7
    var options = smoothing.defaults()
    var round: usize = 0
    while round < 1000 {
        options.mode = @intCast(u8, below(&seed, 5))
        options.grain = @floatFromInt(f64, below(&seed, 3)) * 0.5
        options.step = if below(&seed, 2) == 0 { 0.3 } else { 2.5 }
        options.distance = if below(&seed, 4) == 0 { 0.0 } else if below(&seed, 2) == 0 { 3.0 } else { 20.0 }
        options.tailAggressiveness = @floatFromInt(f64, below(&seed, 3)) * 0.5
        options.smoothPressure = below(&seed, 2) == 0
        options.sampleCount = if below(&seed, 3) == 0 { 1 } else if below(&seed, 2) == 0 { 7 } else { 256 }
        options.delayDistance = if below(&seed, 2) == 0 { 0.0 } else if below(&seed, 2) == 0 { 5.0 } else { 40.0 }
        options.finishLine = below(&seed, 3) != 0
        options.stabilizeSensors = below(&seed, 2) == 0
        options.simulatePressure = @intCast(u8, below(&seed, 2))
        options.hasPressure = below(&seed, 5) == 0
        options.minimumPressure = @floatFromInt(f64, below(&seed, 3)) * 0.4
        options.taper = below(&seed, 2) == 0
        options.taperLength = @floatFromInt(f64, below(&seed, 3)) * 12.0
        smoothing.init(s, &options)
        const start = seed
        if !wild(s, a, start, ROOM) { return 226 }
        if options.mode == smoothing.PIXEL && !pixelPerfect(a) { return 227 }
        smoothing.reset(s)
        _ = wild(s, b, start, @intCast(usize, below(&seed, 4)))
        if !sameLines(a, b) { return 225 }
        round += 1
    }
    return 0
}

// A value of a length that is none (infinite, NaN, 1e308, the least
// float, -0) in every option and in the zoom: whatever init() makes of
// it, what comes out is a place (the pen goes 240 pixels, a taper can
// run on past it), at a time not before the last one's, with a pressure
// from 0 to 1, and nothing waits at the end. (A table of NaN, 7 and -2
// gives pressures from 0 to 1 too.)
fn checkExtreme(s: *Smoother, a: *Line, table: [*]f32) -> u8 {
    var index: usize = 0
    while index < 256 {
        table[index] = if index % 3 == 0 { @floatCast(f32, math.nan()) } else if index % 3 == 1 { 7.0 } else { -2.0 }
        index += 1
    }
    var seed: u64 = 5
    var options = smoothing.defaults()
    var round: usize = 0
    while round < 2000 {
        options.mode = @intCast(u8, below(&seed, 5))
        options.grain = oddLength(&seed)
        options.step = oddLength(&seed)
        options.distance = oddLength(&seed)
        options.tailAggressiveness = oddLength(&seed)
        options.smoothPressure = below(&seed, 2) == 0
        options.sampleCount = @intCast(u32, below(&seed, 300))
        options.delayDistance = oddLength(&seed)
        options.finishLine = below(&seed, 2) == 0
        options.stabilizeSensors = below(&seed, 2) == 0
        options.simulatePressure = @intCast(u8, below(&seed, 3))
        options.speedForMinimum = oddLength(&seed)
        options.minimumPressure = oddLength(&seed)
        options.taper = below(&seed, 2) == 0
        options.taperLength = oddLength(&seed)
        options.pressureCurve = null
        if below(&seed, 2) == 0 { options.pressureCurve = table }
        const scaled = smoothing.forZoom(&options, oddLength(&seed))
        smoothing.init(s, &scaled)
        a.*.count = 0
        var x: f64 = 0.0
        var time: f64 = 0.0
        var left: usize = 40
        while left > 0 {
            x += @floatFromInt(f64, below(&seed, 7))
            time += @floatFromInt(f64, below(&seed, 20))
            _ = push(s, a, x, @floatFromInt(f64, below(&seed, 5)), 1.0, time)
            if below(&seed, 4) == 0 { _ = rest(s, a, time + 200.0) }
            left -= 1
        }
        _ = lift(s, a)
        var calls: usize = 0
        while smoothing.busy(s) && calls < 100 {
            a.*.count += smoothing.drain(s, a.*.points + a.*.count, spare(a, 4096))
            calls += 1
        }
        if smoothing.busy(s) || a.*.count == 0 { return 228 }
        index = 0
        while index < a.*.count {
            const p = &a.*.points[index]
            if !(math.abs(p.*.x) < 1000.0 && math.abs(p.*.y) < 1000.0) { return 228 }
            if !(p.*.pressure >= 0.0 && p.*.pressure <= 1.0) || !(p.*.time < 10000.0) || (index > 0 && !(p.*.time >= a.*.points[index - 1].time)) { return 228 }
            index += 1
        }
        round += 1
    }
    return 0
}

fn oddLength(seed: *u64) -> f64 {
    const pick = below(seed, 8)
    if pick == 0 { return math.infinity() }
    if pick == 1 { return -math.infinity() }
    if pick == 2 { return math.nan() }
    if pick == 3 { return 1.0e308 }
    if pick == 4 { return -0.0 }
    if pick == 5 { return 5.0e-324 }
    if pick == 6 { return 1.0e-300 }
    return 3.0
}

// 120000 raw points through the five modes and the stabilizer's rope, a
// stroke of 500 at a time with a tick in every 50.
fn checkArena(s: *Smoother, a: *Line, table: [*]f32) -> u8 {
    const arena = turns.locate()
    var variant: u8 = 0
    var options = everything(smoothing.NONE, 0.0, table)
    var grown: usize = 0
    var total: usize = 0
    while variant < 6 {
        options.mode = if variant == 5 { smoothing.STABILIZER } else { variant }
        options.delayDistance = if variant == 5 { 12.0 } else { 0.0 }
        smoothing.init(s, &options)
        const before = turns.used(arena)
        var index: usize = 0
        while index < 20000 {
            const along = @floatFromInt(f64, index)
            const raw = point_module.at(math.round(300.0 * math.cos(along * 0.01)), math.round(300.0 * math.sin(along * 0.013)), 1.0, along * 8.0)
            total += smoothing.push(s, &raw, a.*.points, ROOM)
            if index % 50 == 25 { total += smoothing.tick(s, along * 8.0 + 2.0, a.*.points, ROOM) }
            if index % 500 == 499 {
                total += smoothing.tick(s, along * 8.0 + 4.0, a.*.points, ROOM)
                total += smoothing.finish(s, a.*.points, ROOM)
                smoothing.reset(s)
            }
            index += 1
        }
        grown += turns.used(arena) - before
        variant += 1
    }
    if total < 100000 { return 190 }
    if grown > 1024 { return 191 }
    return 0
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var options = smoothing.defaults()
    const made = smoothing.create(allocator, &options)
    const second = smoothing.create(allocator, &options)
    const first_memory = allocator.alloc(ROOM * @sizeOf(Point), 16)
    const second_memory = allocator.alloc(ROOM * @sizeOf(Point), 16)
    const table_memory = allocator.alloc(256 * 4, 16)
    if made == null || second == null || first_memory == null || second_memory == null || table_memory == null { return 255 }
    const s = made.?
    var a = Line.{ .points = unsafe { @ptrCast([*]Point, first_memory.?) }, .count = 0 }
    var b = Line.{ .points = unsafe { @ptrCast([*]Point, second_memory.?) }, .count = 0 }
    const table: [*]f32 = unsafe { @ptrCast([*]f32, table_memory.?) }
    var index: usize = 0
    while index < 256 {
        const part = @floatFromInt(f64, index) / 255.0
        table[index] = @floatCast(f32, part * part)
        index += 1
    }

    var failed = checkNone(s, &a)
    if failed != 0 { return failed }
    failed = checkBasic(s, &a)
    if failed != 0 { return failed }
    failed = checkWeighted(s, &a)
    if failed != 0 { return failed }
    failed = checkStabilizer(s, &a, &b)
    if failed != 0 { return failed }
    failed = checkPixel(s, &a)
    if failed != 0 { return failed }
    failed = checkPressure(s, &a, table)
    if failed != 0 { return failed }
    failed = checkCapacity(s, second.?, &a, &b, table)
    if failed != 0 { return failed }
    failed = checkRest(s)
    if failed != 0 { return failed }
    failed = checkOdd(s, &a, table)
    if failed != 0 { return failed }
    failed = checkArena(s, &a, table)
    if failed != 0 { return failed }
    failed = checkProperties(s, &a, &b)
    if failed != 0 { return failed }
    failed = checkWild(s, &a, &b)
    if failed != 0 { return failed }
    failed = checkMemory()
    if failed != 0 { return failed }
    // The table is rewritten by these two.
    failed = checkCurveEdges(s, &a, table)
    if failed != 0 { return failed }
    failed = checkExtreme(s, &a, table)
    if failed != 0 { return failed }

    smoothing.destroy(allocator, second.?)
    smoothing.destroy(allocator, s)
    return 13
}
