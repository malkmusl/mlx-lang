// nebula's smoothing (work in progress). Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const point_module = @import("../brush/point.mlx")
const smoothing = @import("../brush/smoothing.mlx")

const Point = point_module.Point
const Smoother = smoothing.Smoother

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var options = smoothing.defaults()
    options.mode = smoothing.NONE
    const smoother = smoothing.create(allocator, &options).?
    const memory = allocator.alloc(4096 * @sizeOf(Point), 16).?
    const out: [*]Point = unsafe { @ptrCast([*]Point, memory) }
    const raw = point_module.at(3.0, 4.0, 1.0, 10.0)
    if smoothing.push(smoother, &raw, out, 4096) != 1 { return 1 }
    if out[0].x != 3.0 || out[0].y != 4.0 { return 2 }
    return 13
}
