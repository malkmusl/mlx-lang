// nebula's Artistic, Colors, Map and Other filters (filters/artistic.mlx,
// map.mlx, other.mlx), all through filters/registry.mlx: each of the
// sixteen is in the list with its id, key, group and names once, its
// numbers described with sound ranges; each runs on 1 x 1, 1 x N, N x 1
// and 257 x 130 pixels that are all transparent, all opaque and anything,
// at every end of its numbers' ranges, leaving the words past a row's
// width alone and the scratch pool as it was, keeping transparent
// transparent and (where the filter is not about alpha) opaque opaque; a
// NaN counts as the initial value and a number beyond its range as the
// range's end; neutral numbers change no bit; small pictures come out as
// worked out by hand; an opaque red square on transparent ground (with
// green left in its unseen pixels) stays pure red; a picture filtered
// whole is the picture filtered in blocks of 256 with the margin the
// filter names (and for the filters that read around a pixel not with
// one less); the same seed gives the same pixels, another seed others;
// fifty runs of a filter take nothing from the value arena. Oilpaint,
// Propagate Colors, Pixelize, Small Tiles, Round Corners, Wave, Posterize,
// Phong Bumpmap, Normalize and Color to Alpha come out as a second, plain
// way of working them out gives (every pixel of a window counted anew,
// every seen pixel tried, each box added up, doubles), on random pictures
// of every kind from 1 x 1 to across tile borders; Halftone turned by
// quarters is Halftone at 0; a filter run a second time gives what it gave
// the first; at every end of their ranges the filters give the heap back
// what they take and take nothing from the value arena. Prints how many
// megapixels a second the heavy ones do. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const registry = @import("../filters/registry.mlx")
const types = @import("../filters/types.mlx")
const artistic = @import("../filters/artistic.mlx")
const map = @import("../filters/map.mlx")
const other = @import("../filters/other.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")

// The picture the block comparison filters: three blocks across and down,
// the last ones cut.
const WIDE: usize = 600
const HIGH: usize = 530
const BLOCK: usize = 256
// The largest size every filter is run on, and the words of a row past
// its pixels, which a filter has to leave alone.
const ODD_WIDE: usize = 257
const ODD_HIGH: usize = 130
const PAD: usize = 3
const GUARD: u32 = 0xDEADBEEF
// The picture the speed is measured on.
const FAST_WIDE: usize = 2048
const FAST_HIGH: usize = 1536

// What a picture is made of.
const NOTHING: u32 = 0
const OPAQUE: u32 = 1
const MIXED: u32 = 2

const RED: u32 = 0xFFFF0000
const BLUE: u32 = 0xFF0000FF

const FILTERS: usize = 16
const IDS = [16]u16{ artistic.OILPAINT, artistic.PIXELIZE, artistic.RAINDROPS, artistic.HALFTONE, artistic.POSTERIZE, map.SMALL_TILES, map.ROUND_CORNERS, map.PHONG_BUMPMAP, map.NORMALIZE, map.PROPAGATE_COLORS, other.RANDOM_NOISE, other.RANDOM_PICK, other.WAVE, other.COLOR_TO_ALPHA, other.MAXIMIZE, other.MINIMIZE }
const KEYS = [16][]const u8{ "oilpaint", "pixelize", "raindrops", "halftone", "posterize", "smalltiles", "roundcorners", "phongbumpmap", "normalize", "propagatecolors", "noise", "randompick", "wave", "colortoalpha", "maximize", "minimize" }
const GROUPS = [16]u8{ types.ARTISTIC, types.ARTISTIC, types.ARTISTIC, types.ARTISTIC, types.ARTISTIC, types.MAP, types.MAP, types.MAP, types.MAP, types.MAP, types.OTHER, types.OTHER, types.OTHER, types.COLORS, types.COLORS, types.COLORS }
// The first and the last id of the module a filter is in.
const FROM = [16]u16{ 250, 250, 250, 250, 250, 300, 300, 300, 300, 300, 350, 350, 350, 350, 350, 350 }
const UNTIL = [16]u16{ 299, 299, 299, 299, 299, 349, 349, 349, 349, 349, 399, 399, 399, 399, 399, 399 }
// Whether opaque pixels stay opaque whatever the numbers (Halftone's two
// colours may be transparent, Round Corners and Color to Alpha are about
// alpha).
const KEEPS_OPAQUE = [16]bool{ true, true, true, false, true, true, false, true, true, true, true, true, true, false, true, true }

// Everything the checks work with, in heap memory: the loop of checks
// gives the value arena back now and then, so nothing they keep may be a
// local.
const Work = struct {
    // A picture before it is filtered, filtered whole, filtered in
    // blocks, and one block with its margin.
    source: [*]u32
    whole: [*]u32
    tiled: [*]u32
    piece: [*]u32
    fast: [*]u32
    pool: *scratch.Pool
    params: registry.Params
    block_params: registry.Params
    loop: turns.Turns
}

fn report(id: u16, what: []const u8) -> void {
    _ = std.io.print("filter ")
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, id))
    _ = std.io.print(": ")
    _ = std.io.println(what)
}

// Dice of the test's own: a number scrambled.
fn dice(value: u64) -> u64 {
    var bits = value *% 0x9E3779B97F4A7C15
    bits = (bits ^ (bits >> 29)) *% 0xBF58476D1CE4E5B9
    return bits ^ (bits >> 32)
}

// `width` x `height` pixels of `kind` at `pixels`, the words past a row's
// width up to `stride` set to GUARD. MIXED is a quarter opaque, a quarter
// transparent (half of those with a colour left in them) and the rest
// any alpha.
fn fill(pixels: [*]u32, width: usize, height: usize, stride: usize, kind: u32, seed: u64) -> void {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < stride {
            var value: u32 = GUARD
            if x < width {
                const bits = dice(seed *% 1000003 +% y *% 65536 +% x)
                const color = @intCast(u32, bits & 0xFFFFFF)
                value = 0
                if kind == OPAQUE { value = 0xFF000000 | color }
                if kind == MIXED {
                    const choice = (bits >> 24) & 3
                    if choice == 0 {
                        value = 0xFF000000 | color
                    } else if choice == 1 {
                        value = if (bits >> 26) & 1 == 0 { 0 } else { color }
                    } else {
                        value = (@intCast(u32, (bits >> 32) & 255) << 24) | color
                    }
                }
            }
            pixels[y * stride + x] = value
            x += 1
        }
        y += 1
    }
}

// A picture with areas, edges, grain and every kind of alpha: patches of
// 13 x 9 pixels of one colour each, some opaque, some transparent, some
// in between, some of any alpha pixel by pixel.
fn picture(pixels: [*]u32, width: usize, height: usize, stride: usize, seed: u64) -> void {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const area = dice(seed *% 7919 +% (y / 9) *% 4096 +% x / 13)
            const grain = dice(seed ^ (y *% 65536 +% x))
            const color = @intCast(u32, (area ^ (grain & 0x030303)) & 0xFFFFFF)
            const choice = (area >> 24) & 3
            var alpha: u32 = 255
            if choice == 1 { alpha = 0 }
            if choice == 2 { alpha = @intCast(u32, (area >> 32) & 255) }
            if choice == 3 { alpha = @intCast(u32, (grain >> 24) & 255) }
            pixels[y * stride + x] = (alpha << 24) | color
            x += 1
        }
        y += 1
    }
}

// Transparent pixels with one in two hundred seen (of any alpha) among
// them, `width` x `height` without gaps.
fn sparse(pixels: [*]u32, width: usize, height: usize) -> void {
    var index: usize = 0
    while index < width * height {
        const bits = dice(index *% 7 +% 99)
        pixels[index] = if bits % 200 == 0 { @intCast(u32, (bits >> 8) & 0xFFFFFFFF) | 0x01000000 } else { 0 }
        index += 1
    }
}

fn copy(into: [*]u32, into_stride: usize, from: [*]const u32, from_stride: usize, width: usize, height: usize) -> void {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            into[y * into_stride + x] = from[y * from_stride + x]
            x += 1
        }
        y += 1
    }
}

// How many of `width` x `height` pixels differ.
fn differing(a: [*]const u32, a_stride: usize, b: [*]const u32, b_stride: usize, width: usize, height: usize) -> usize {
    var count: usize = 0
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            if a[y * a_stride + x] != b[y * b_stride + x] { count += 1 }
            x += 1
        }
        y += 1
    }
    return count
}

fn setAll(pixels: [*]u32, count: usize, value: u32) -> void {
    var index: usize = 0
    while index < count {
        pixels[index] = value
        index += 1
    }
}

// ---- The list ----

fn choicesIn(text: []const u8) -> usize {
    if text.length == 0 { return 0 }
    var count: usize = 1
    for byte in text {
        if byte == 124 { count += 1 }
    }
    return count
}

fn wiring(work: *Work) -> u8 {
    var index: usize = 0
    while index < FILTERS {
        const id = IDS[index]
        const found = registry.find(id)
        if found == null {
            report(id, "is not in the registry")
            return 2
        }
        const info = found.?
        if info.*.id != id || id < FROM[index] || id > UNTIL[index] || info.*.category != GROUPS[index] { return 3 }
        if !std.text.same(info.*.key, KEYS[index]) { return 4 }
        const named = registry.byKey(KEYS[index])
        if named == null || named.?.*.id != id { return 5 }
        if info.*.name.length == 0 || info.*.german.length == 0 || info.*.params.length > 32 { return 6 }
        var at: usize = 0
        while at < info.*.params.length {
            const param = &info.*.params[at]
            if param.*.name.length == 0 || param.*.german.length == 0 { return 7 }
            if !(param.*.low < param.*.high) || !(param.*.low <= param.*.initial) || !(param.*.initial <= param.*.high) {
                report(id, "a number's initial value is not in its range")
                return 8
            }
            if param.*.kind == types.BOOL && (param.*.low != 0.0 || param.*.high != 1.0) { return 9 }
            if param.*.kind == types.CHOICE {
                const wanted = @intFromFloat(usize, param.*.high) + 1
                if param.*.low != 0.0 || choicesIn(param.*.choices) != wanted || choicesIn(param.*.choicesGerman) != wanted { return 10 }
            }
            at += 1
        }
        // defaults() is the initial values and nothing after them.
        registry.defaults(id, &work.*.params)
        if work.*.params.id != id || work.*.params.textLength != 0 { return 11 }
        at = 0
        while at < 32 {
            const wanted = if at < info.*.params.length { info.*.params[at].initial } else { 0.0 }
            if work.*.params.values[at] != wanted { return 11 }
            at += 1
        }
        // No other filter of the whole list has the id or the key.
        const all = registry.count()
        var same_id: usize = 0
        var same_key: usize = 0
        var place: usize = 0
        while place < all {
            turns.turn(&work.*.loop)
            const entry = registry.at(place)
            if entry == null { return 12 }
            if entry.?.*.id == id { same_id += 1 }
            if std.text.same(entry.?.*.key, KEYS[index]) { same_key += 1 }
            place += 1
        }
        if same_id != 1 || same_key != 1 {
            report(id, "its id or key is in the list more than once")
            return 12
        }
        index += 1
    }
    return 0
}

// ---- Every size, every content, every end of the ranges ----

// The filter of work.params over one picture: 0, or which check failed.
fn once(work: *Work, index: usize, width: usize, height: usize, kind: u32) -> u8 {
    const stride = width + PAD
    const pixels = work.*.whole
    fill(pixels, width, height, stride, kind, 77)
    const before = scratch.mark(work.*.pool)
    if !registry.apply(&work.*.params, pixels, width, height, stride) { return 20 }
    const after = scratch.mark(work.*.pool)
    if before.block != after.block || before.used != after.used { return 21 }
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const p = pixels[y * stride + x]
            if kind == NOTHING && p != 0 { return 22 }
            if kind == OPAQUE && KEEPS_OPAQUE[index] && p >> 24 != 255 { return 23 }
            x += 1
        }
        while x < stride {
            if pixels[y * stride + x] != GUARD { return 24 }
            x += 1
        }
        y += 1
    }
    return 0
}

fn survive(work: *Work, index: usize) -> u8 {
    var size: usize = 0
    while size < 4 {
        const width: usize = if size == 0 { 1 } else if size == 1 { 1 } else if size == 2 { 61 } else { ODD_WIDE }
        const height: usize = if size == 0 { 1 } else if size == 1 { 47 } else if size == 2 { 1 } else { ODD_HIGH }
        var kind: u32 = 0
        while kind < 3 {
            const failed = once(work, index, width, height, kind)
            if failed != 0 { return failed }
            kind += 1
        }
        size += 1
    }
    return 0
}

// The filter of work.params over the mixed picture, into `into`.
fn result(work: *Work, into: [*]u32) -> bool {
    fill(into, ODD_WIDE, ODD_HIGH, ODD_WIDE, MIXED, 5)
    return registry.apply(&work.*.params, into, ODD_WIDE, ODD_HIGH, ODD_WIDE)
}

fn extremes(work: *Work, index: usize) -> u8 {
    const id = IDS[index]
    const info = registry.find(id).?
    const count = info.*.params.length
    const params = &work.*.params
    if count <= 4 {
        // Every combination of the ranges' ends.
        var combinations: usize = 1
        combinations = combinations << count
        var mask: usize = 0
        while mask < combinations {
            turns.turn(&work.*.loop)
            registry.defaults(id, params)
            var at: usize = 0
            while at < count {
                params.*.values[at] = if (mask >> at) & 1 != 0 { info.*.params[at].high } else { info.*.params[at].low }
                at += 1
            }
            const failed = survive(work, index)
            if failed != 0 {
                report(id, "fails at an end of its numbers' ranges")
                return failed
            }
            mask += 1
        }
    } else {
        // Each number alone at its low and at its high end.
        var at: usize = 0
        while at < count * 2 {
            turns.turn(&work.*.loop)
            registry.defaults(id, params)
            params.*.values[at / 2] = if at % 2 == 0 { info.*.params[at / 2].low } else { info.*.params[at / 2].high }
            const failed = survive(work, index)
            if failed != 0 {
                report(id, "fails at an end of one number's range")
                return failed
            }
            at += 1
        }
    }
    // The initial values too, and then each number wild: NaN is the
    // initial value, what is beyond the range is the range's end.
    registry.defaults(id, params)
    const plain = survive(work, index)
    if plain != 0 {
        report(id, "fails at its initial values")
        return plain
    }
    var at: usize = 0
    while at < count * 7 {
        turns.turn(&work.*.loop)
        const which = at / 7
        const param = &info.*.params[which]
        var wild = math.nan()
        var tame = param.*.initial
        if at % 7 == 1 {
            wild = param.*.low - 1.0
            tame = param.*.low
        } else if at % 7 == 2 {
            wild = param.*.high + 1.0
            tame = param.*.high
        } else if at % 7 == 3 {
            wild = param.*.low - 1.0e30
            tame = param.*.low
        } else if at % 7 == 4 {
            wild = param.*.high + 1.0e30
            tame = param.*.high
        } else if at % 7 == 5 {
            wild = math.negativeInfinity()
            tame = param.*.low
        } else if at % 7 == 6 {
            wild = math.infinity()
            tame = param.*.high
        }
        registry.defaults(id, params)
        params.*.values[which] = tame
        const tame_margin = registry.margin(params)
        if !result(work, work.*.tiled) { return 25 }
        params.*.values[which] = wild
        if registry.margin(params) != tame_margin || tame_margin < 0 { return 26 }
        if !result(work, work.*.whole) { return 25 }
        if differing(work.*.whole, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH) != 0 {
            report(id, "takes a wild number for something else than the range's end or the initial value")
            return 27
        }
        at += 1
    }
    return 0
}

// ---- Neutral numbers ----

// Whether the filter of work.params leaves the mixed picture as it is,
// to the bit (its unseen colours too).
fn unchanged(work: *Work) -> bool {
    fill(work.*.tiled, ODD_WIDE, ODD_HIGH, ODD_WIDE, MIXED, 5)
    if !result(work, work.*.whole) { return false }
    return differing(work.*.whole, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH) == 0
}

fn neutral(work: *Work) -> u8 {
    const p = &work.*.params
    registry.defaults(artistic.PIXELIZE, p)
    p.*.values[0] = 1.0
    p.*.values[1] = 1.0
    if !unchanged(work) || registry.margin(p) != 0 { return 40 }
    registry.defaults(map.SMALL_TILES, p)
    p.*.values[0] = 1.0
    if !unchanged(work) { return 41 }
    registry.defaults(map.ROUND_CORNERS, p)
    p.*.values[0] = 0.0
    if !unchanged(work) || registry.margin(p) != 0 { return 42 }
    // Propagate Colors bounded to nothing: no pixel but the seen ones is
    // that near, and those it leaves.
    registry.defaults(map.PROPAGATE_COLORS, p)
    p.*.values[1] = @floatFromInt(f64, map.BOUNDED)
    p.*.values[2] = 0.0
    if !unchanged(work) || registry.margin(p) != 0 { return 42 }
    registry.defaults(other.RANDOM_NOISE, p)
    p.*.values[0] = 0.0
    if !unchanged(work) { return 43 }
    registry.defaults(other.RANDOM_NOISE, p)
    p.*.values[1] = 0.0
    if !unchanged(work) { return 44 }
    registry.defaults(other.RANDOM_PICK, p)
    p.*.values[0] = 0.0
    if !unchanged(work) { return 45 }
    registry.defaults(other.RANDOM_PICK, p)
    p.*.values[1] = 1.0
    if !unchanged(work) || registry.margin(p) != 0 { return 46 }
    registry.defaults(other.RANDOM_PICK, p)
    p.*.values[2] = 0.0
    if !unchanged(work) { return 47 }
    registry.defaults(other.WAVE, p)
    p.*.values[2] = 0.0
    p.*.values[6] = 0.0
    if !unchanged(work) || registry.margin(p) != 0 { return 48 }
    // And they do change it otherwise: the checks above are not empty.
    registry.defaults(other.WAVE, p)
    if unchanged(work) { return 49 }
    return 0
}

// ---- Small pictures worked out by hand ----

fn load(into: [*]u32, values: []const u32) -> void {
    var index: usize = 0
    while index < values.length {
        into[index] = values[index]
        index += 1
    }
}

fn holds(pixels: [*]const u32, values: []const u32) -> bool {
    var index: usize = 0
    while index < values.length {
        if pixels[index] != values[index] { return false }
        index += 1
    }
    return true
}

fn posterizeExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // Two steps: below half nothing, from half on all. Alpha stays.
    registry.defaults(artistic.POSTERIZE, p)
    p.*.values[0] = 2.0
    load(w, [4]u32{ 0x407F8000, 0xFF000000, 0xFFFFFFFF, 0xFF7F8081 }[0..])
    if !registry.apply(p, w, 4, 1, 4) { return 50 }
    if !holds(w, [4]u32{ 0x4000FF00, 0xFF000000, 0xFFFFFFFF, 0xFF00FFFF }[0..]) { return 50 }
    // Four steps: 0, 85, 170, 255, the nearest (42.5 is where 0 ends).
    p.*.values[0] = 4.0
    load(w, [4]u32{ 0xFF6480C8, 0x802A2B7F, 0xFFD4D5FF, 0x01000001 }[0..])
    if !registry.apply(p, w, 2, 2, 2) { return 51 }
    if !holds(w, [4]u32{ 0xFF55AAAA, 0x80005555, 0xFFAAFFFF, 0x01000000 }[0..]) { return 51 }
    if registry.margin(p) != 0 { return 51 }
    return 0
}

fn channelsExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // The largest stays; equal ones stay together; alpha stays.
    registry.defaults(other.MAXIMIZE, p)
    load(w, [4]u32{ 0x800A141E, 0xFF323214, 0xFF070707, 0x00FF0102 }[0..])
    if !registry.apply(p, w, 4, 1, 4) { return 52 }
    if !holds(w, [4]u32{ 0x8000001E, 0xFF323200, 0xFF070707, 0x00FF0000 }[0..]) { return 52 }
    registry.defaults(other.MINIMIZE, p)
    load(w, [4]u32{ 0x800A141E, 0xFF323214, 0xFF070707, 0xFFFF0100 }[0..])
    if !registry.apply(p, w, 2, 2, 2) { return 53 }
    if !holds(w, [4]u32{ 0x800A0000, 0xFF000014, 0xFF070707, 0xFF000000 }[0..]) { return 53 }
    return 0
}

fn colorToAlphaExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // White out, threshold 100. White itself: nothing left. (250, 250,
    // 250) is 5 away: 5 / 100 of it is left, alpha 13, and its colour
    // goes 100 / 5 times as far from white, to 155. Black and (155, 255,
    // 255) are 100 or more away: as they were. Half-opaque (200, 255,
    // 255) is 55 away: alpha 128 * 140 / 255 = 70, red 255 - 100.
    registry.defaults(other.COLOR_TO_ALPHA, p)
    load(w, [6]u32{ 0xFFFFFFFF, 0xFFFAFAFA, 0xFF000000, 0xFF9BFFFF, 0x80C8FFFF, 0x00123456 }[0..])
    if !registry.apply(p, w, 3, 2, 3) { return 54 }
    if !holds(w, [6]u32{ 0, 0x0D9B9B9B, 0xFF000000, 0xFF9BFFFF, 0x469BFFFF, 0x00123456 }[0..]) { return 54 }
    // Red out of colours near it, threshold 60: laid over red again, each
    // is what it was (to one step of rounding).
    p.*.values[0] = 4294901760.0
    p.*.values[1] = 60.0
    var index: usize = 0
    while index < 4096 {
        const bits = dice(@intCast(u64, index))
        const r = 255 - @intCast(u32, bits & 63)
        const g = @intCast(u32, (bits >> 8) & 63)
        const b = @intCast(u32, (bits >> 16) & 63)
        work.*.source[index] = 0xFF000000 | (r << 16) | (g << 8) | b
        w[index] = work.*.source[index]
        index += 1
    }
    if !registry.apply(p, w, 64, 64, 64) { return 55 }
    var thinner: usize = 0
    index = 0
    while index < 4096 {
        const was = work.*.source[index]
        const back = pixel.over(RED, w[index], 255)
        var channel: u32 = 0
        while channel < 24 {
            const a = @intCast(i32, (was >> channel) & 255)
            const b = @intCast(i32, (back >> channel) & 255)
            if a - b > 1 || b - a > 1 { return 55 }
            channel += 8
        }
        if w[index] >> 24 < 255 { thinner += 1 }
        index += 1
    }
    // Most of them are nearer than the threshold and lost alpha.
    if thinner < 3000 { return 56 }
    return 0
}

fn pixelizeExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // Cells of 2 x 2 on 5 x 2. The first: two reds, a blue and an unseen
    // green: alpha (3 * 255 + 2) / 4 = 191, red 2 / 3 and blue 1 / 3 of
    // what is seen, no green. The second: nothing seen. The third, one
    // pixel wide: the mean of its two.
    registry.defaults(artistic.PIXELIZE, p)
    p.*.values[0] = 2.0
    p.*.values[1] = 2.0
    load(w, [10]u32{ RED, 0x0000FF00, 0x00FFFFFF, 0x00FFFFFF, 0xFF101010, RED, BLUE, 0x00FFFFFF, 0, 0x80202020 }[0..])
    if !registry.apply(p, w, 5, 2, 5) { return 57 }
    // The third, an opaque grey 16 and a half-seen grey 32: alpha (255 +
    // 128 + 1) / 2 = 192, grey (16 * 255 + 32 * 128 + 191) / 383 = 21.
    if !holds(w, [10]u32{ 0xBFAA0055, 0xBFAA0055, 0, 0, 0xC0151515, 0xBFAA0055, 0xBFAA0055, 0, 0, 0xC0151515 }[0..]) { return 57 }
    if registry.margin(p) != 2 { return 58 }
    p.*.values[0] = 7.0
    p.*.values[1] = 3.0
    if registry.margin(p) != 7 { return 58 }
    return 0
}

fn smallTilesExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // 4 x 4 in four squares: one colour; blues 0, 2, 4, 6 (mean 3); two
    // reds and two unseen (alpha 128, red); an opaque grey 16, a
    // half-seen grey 32 and two unseen (alpha (255 + 128 + 2) / 4 = 96,
    // grey (16 * 255 + 32 * 128 + 191) / 383 = 21). Made small that is
    // 2 x 2, laid out twice across and down.
    registry.defaults(map.SMALL_TILES, p)
    load(w, [16]u32{
        0xFF101010, 0xFF101010, 0xFF000000, 0xFF000002,
        0xFF101010, 0xFF101010, 0xFF000004, 0xFF000006,
        RED, 0x0000FF00, 0xFF101010, 0,
        0x0000FF00, RED, 0x80202020, 0x00FFFFFF,
    }[0..])
    if !registry.apply(p, w, 4, 4, 4) { return 59 }
    if !holds(w, [16]u32{
        0xFF101010, 0xFF000003, 0xFF101010, 0xFF000003,
        0x80FF0000, 0x60151515, 0x80FF0000, 0x60151515,
        0xFF101010, 0xFF000003, 0xFF101010, 0xFF000003,
        0x80FF0000, 0x60151515, 0x80FF0000, 0x60151515,
    }[0..]) { return 59 }
    // Every number of tiles on a picture of nothing leaves nothing.
    p.*.values[0] = 64.0
    setAll(w, 100, 0x00ABCDEF)
    if !registry.apply(p, w, 10, 10, 10) { return 59 }
    if w[0] != 0 || w[99] != 0 { return 59 }
    // Two tiles on 3 x 1: the first is one pixel wide, the mean of all
    // three (16 + 32 + 96) / 3 = 48; the second two, the first pixel
    // alone and the mean of the other two, 64. Down there is one row for
    // two tiles: one of them no pixel high.
    p.*.values[0] = 2.0
    load(w, [3]u32{ 0xFF000010, 0xFF000020, 0xFF000060 }[0..])
    if !registry.apply(p, w, 3, 1, 3) { return 60 }
    if !holds(w, [3]u32{ 0xFF000030, 0xFF000010, 0xFF000040 }[0..]) { return 60 }
    // Three tiles on 2 x 5: across they are 0, 1 and 1 pixels wide (each
    // one shows the mean of a whole row band), down 1, 2 and 2 high. The
    // tile one high is the mean of all ten, 250 / 10 = 25; the ones two
    // high are rows 0 and 1 ((10 + 20) / 4 = 7.5: 8) and rows 2 to 4
    // ((30 + 40 + 50 + 100) / 6 = 36.7: 37).
    p.*.values[0] = 3.0
    load(w, [10]u32{ 0xFF00000A, 0xFF000000, 0xFF000014, 0xFF000000, 0xFF00001E, 0xFF000000, 0xFF000028, 0xFF000000, 0xFF000032, 0xFF000064 }[0..])
    if !registry.apply(p, w, 2, 5, 2) { return 61 }
    if !holds(w, [10]u32{ 0xFF000019, 0xFF000019, 0xFF000008, 0xFF000008, 0xFF000025, 0xFF000025, 0xFF000008, 0xFF000008, 0xFF000025, 0xFF000025 }[0..]) { return 61 }
    return 0
}

fn roundCornersExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // Radius 10 on 40 x 30: the circle's middle is (10, 10) from each
    // corner, a pixel's alpha is how far its middle is inside (radius -
    // distance + 0.5, held in 0 to 1). (3, 2) is 9.925 from the middle:
    // 0.575, alpha 147; (4, 1) 10.124: 0.376, 96; (1, 5) 9.618: 0.882,
    // 225; (0, 9) 9.513: 0.987, 252; (0, 0) and (2, 2) are outside.
    registry.defaults(map.ROUND_CORNERS, p)
    p.*.values[0] = 10.0
    setAll(w, 1200, 0xFF336699)
    if !registry.apply(p, w, 40, 30, 40) { return 62 }
    if w[0] != 0 || w[2 * 40 + 2] != 0 || w[5 * 40] != 0 { return 62 }
    if w[2 * 40 + 3] != 0x93336699 || w[1 * 40 + 4] != 0x60336699 || w[5 * 40 + 1] != 0xE1336699 || w[9 * 40] != 0xFC336699 { return 63 }
    if w[3 * 40 + 3] != 0xFF336699 || w[10] != 0xFF336699 || w[15 * 40 + 20] != 0xFF336699 || w[10 * 40] != 0xFF336699 { return 64 }
    // The four corners are each other's mirror.
    var y: usize = 0
    while y < 30 {
        var x: usize = 0
        while x < 40 {
            const here = w[y * 40 + x]
            if here != w[y * 40 + (39 - x)] || here != w[(29 - y) * 40 + x] { return 65 }
            x += 1
        }
        y += 1
    }
    // A pixel that was half seen keeps half of what an opaque one keeps.
    setAll(w, 1200, 0x80336699)
    if !registry.apply(p, w, 40, 30, 40) { return 66 }
    if w[2 * 40 + 3] != 0x4A336699 || w[0] != 0 || w[15 * 40 + 20] != 0x80336699 { return 66 }
    // Radius 2 on 6 x 4, half the shorter side: the corner pixel is 0.379
    // inside (alpha 97) and its neighbours 0.919 (234), the two middle
    // columns stay.
    if registry.margin(p) != 10 { return 67 }
    p.*.values[0] = 2.0
    setAll(w, 24, 0xFFFFFFFF)
    if !registry.apply(p, w, 6, 4, 6) { return 67 }
    if !holds(w, [12]u32{ 0x61FFFFFF, 0xEAFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xEAFFFFFF, 0x61FFFFFF, 0xEAFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xEAFFFFFF }[0..]) { return 67 }
    if w[18] != 0x61FFFFFF || w[23] != 0x61FFFFFF || w[12] != 0xEAFFFFFF { return 67 }
    // Radius 3 on the same: the upper and the lower corners' cuts meet in
    // the middle rows, whose first pixel keeps 0.585 (149) of the upper
    // cut and 0.950 (242) of the lower one: 141.
    p.*.values[0] = 3.0
    setAll(w, 24, 0xFFFFFFFF)
    if !registry.apply(p, w, 6, 4, 6) { return 123 }
    if !holds(w, [24]u32{
        0, 0x95FFFFFF, 0xF2FFFFFF, 0xF2FFFFFF, 0x95FFFFFF, 0,
        0x8DFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x8DFFFFFF,
        0x8DFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x8DFFFFFF,
        0, 0x95FFFFFF, 0xF2FFFFFF, 0xF2FFFFFF, 0x95FFFFFF, 0,
    }[0..]) { return 123 }
    // And on 5 x 3 at radius 2 the middle row's ends lose 0.919 twice:
    // 234 of 234, 215.
    p.*.values[0] = 2.0
    setAll(w, 15, 0xFFFFFFFF)
    if !registry.apply(p, w, 5, 3, 5) { return 123 }
    if !holds(w, [15]u32{ 0x61FFFFFF, 0xEAFFFFFF, 0xFFFFFFFF, 0xEAFFFFFF, 0x61FFFFFF, 0xD7FFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xD7FFFFFF, 0x61FFFFFF, 0xEAFFFFFF, 0xFFFFFFFF, 0xEAFFFFFF, 0x61FFFFFF }[0..]) { return 123 }
    // Beyond half the diagonal nothing is left.
    p.*.values[0] = 30.0
    setAll(w, 24, 0xFFFFFFFF)
    if !registry.apply(p, w, 6, 4, 6) { return 124 }
    var index: usize = 0
    while index < 24 {
        if w[index] != 0 { return 124 }
        index += 1
    }
    return 0
}

// The 7 x 5 picture of propagateExact: four seen pixels (opaque red at
// (0, 0), opaque blue at (5, 1), half-seen green at (2, 4), a quarter-seen
// white at (6, 4)), the rest unseen with a colour left in them, but for
// one that is 0.
const SPREAD_IN = [35]u32{
    0xFFFF0000, 0x00123456, 0x00123456, 0x00000000, 0x00123456, 0x00123456, 0x00123456,
    0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456, 0xFF0000FF, 0x00123456,
    0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456,
    0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456,
    0x00123456, 0x00123456, 0x8000FF00, 0x00123456, 0x00123456, 0x00123456, 0x40FFFFFF,
}
// Unbounded and expanding, Euclidean, city block and chessboard: worked
// out by trying every seen pixel for every unseen one (the nearest; of
// equals the leftmost column, then the nearest in it, then the upper).
const SPREAD_EUCLIDEAN = [35]u32{
    0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0xFFFF0000, 0x8000FF00, 0x8000FF00, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x40FFFFFF, 0x40FFFFFF,
    0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x40FFFFFF, 0x40FFFFFF,
}
const SPREAD_CITY = [35]u32{
    0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0xFFFF0000, 0x8000FF00, 0x8000FF00, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0xFF0000FF, 0x40FFFFFF,
    0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x40FFFFFF, 0x40FFFFFF,
}
const SPREAD_CHESS = [35]u32{
    0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0xFFFF0000, 0xFFFF0000, 0x8000FF00, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x40FFFFFF, 0x40FFFFFF,
    0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x40FFFFFF, 0x40FFFFFF,
}
// Bounded: Euclidean to 1.5 (what is a diagonal step away) expanding;
// city block and chessboard to 1 preserving (the colour comes, alpha
// stays 0).
const SPREAD_NEAR = [35]u32{
    0xFFFF0000, 0xFFFF0000, 0x00123456, 0x00000000, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0xFFFF0000, 0xFFFF0000, 0x00123456, 0x00123456, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0x00123456, 0x00123456, 0x00123456, 0x00123456, 0xFF0000FF, 0xFF0000FF, 0xFF0000FF,
    0x00123456, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x00123456, 0x40FFFFFF, 0x40FFFFFF,
    0x00123456, 0x8000FF00, 0x8000FF00, 0x8000FF00, 0x00123456, 0x40FFFFFF, 0x40FFFFFF,
}
const SPREAD_CITY_HIDDEN = [35]u32{
    0xFFFF0000, 0x00FF0000, 0x00123456, 0x00000000, 0x00123456, 0x000000FF, 0x00123456,
    0x00FF0000, 0x00123456, 0x00123456, 0x00123456, 0x000000FF, 0xFF0000FF, 0x000000FF,
    0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x000000FF, 0x00123456,
    0x00123456, 0x00123456, 0x0000FF00, 0x00123456, 0x00123456, 0x00123456, 0x00FFFFFF,
    0x00123456, 0x0000FF00, 0x8000FF00, 0x0000FF00, 0x00123456, 0x00FFFFFF, 0x40FFFFFF,
}
const SPREAD_CHESS_HIDDEN = [35]u32{
    0xFFFF0000, 0x00FF0000, 0x00123456, 0x00000000, 0x000000FF, 0x000000FF, 0x000000FF,
    0x00FF0000, 0x00FF0000, 0x00123456, 0x00123456, 0x000000FF, 0xFF0000FF, 0x000000FF,
    0x00123456, 0x00123456, 0x00123456, 0x00123456, 0x000000FF, 0x000000FF, 0x000000FF,
    0x00123456, 0x0000FF00, 0x0000FF00, 0x0000FF00, 0x00123456, 0x00FFFFFF, 0x00FFFFFF,
    0x00123456, 0x0000FF00, 0x8000FF00, 0x0000FF00, 0x00123456, 0x00FFFFFF, 0x40FFFFFF,
}

// Propagate Colors over SPREAD_IN with `metric`, `bounded` to `amount`,
// `expand`ing or not: whether it comes out as `wanted` (by element: a
// slice of a constant table would be a copy of it in the value arena).
fn spreads(work: *Work, metric: u32, bounded: bool, amount: f64, expand: bool, wanted: u32) -> bool {
    const p = &work.*.params
    const w = work.*.whole
    registry.defaults(map.PROPAGATE_COLORS, p)
    p.*.values[0] = @floatFromInt(f64, metric)
    p.*.values[1] = @floatFromInt(f64, if bounded { map.BOUNDED } else { map.UNBOUNDED })
    p.*.values[2] = amount
    p.*.values[3] = @floatFromInt(f64, if expand { map.EXPAND } else { map.PRESERVE })
    var index: usize = 0
    while index < 35 {
        w[index] = SPREAD_IN[index]
        index += 1
    }
    if !registry.apply(p, w, 7, 5, 7) { return false }
    index = 0
    while index < 35 {
        var expected = SPREAD_IN[index]
        if wanted == 0 { expected = SPREAD_EUCLIDEAN[index] }
        if wanted == 1 { expected = SPREAD_CITY[index] }
        if wanted == 2 { expected = SPREAD_CHESS[index] }
        if wanted == 3 { expected = SPREAD_NEAR[index] }
        if wanted == 4 { expected = SPREAD_CITY_HIDDEN[index] }
        if wanted == 5 { expected = SPREAD_CHESS_HIDDEN[index] }
        if w[index] != expected { return false }
        index += 1
    }
    return true
}

fn propagateExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    registry.defaults(map.PROPAGATE_COLORS, p)
    // As it starts: unbounded (no margin), Euclidean, expanding.
    if registry.margin(p) != 0 || p.*.values[0] != @floatFromInt(f64, map.EUCLIDEAN) || p.*.values[3] != @floatFromInt(f64, map.EXPAND) { return 114 }
    p.*.values[1] = @floatFromInt(f64, map.BOUNDED)
    p.*.values[2] = 7.25
    if registry.margin(p) != 8 { return 114 }
    if !spreads(work, map.EUCLIDEAN, false, 8.0, true, 0) { return 115 }
    if !spreads(work, map.CITY_BLOCK, false, 8.0, true, 1) { return 116 }
    if !spreads(work, map.CHESSBOARD, false, 8.0, true, 2) { return 117 }
    if !spreads(work, map.EUCLIDEAN, true, 1.5, true, 3) { return 118 }
    if !spreads(work, map.CITY_BLOCK, true, 1.0, false, 4) { return 119 }
    if !spreads(work, map.CHESSBOARD, true, 1.0, false, 5) { return 120 }
    // A row with one seen pixel in its middle: the colour goes both ways,
    // to the ends; bounded to 3, three each way.
    var pass: usize = 0
    while pass < 2 {
        setAll(w, 64, 0)
        w[20] = 0xFF336699
        registry.defaults(map.PROPAGATE_COLORS, p)
        if pass == 1 {
            p.*.values[1] = @floatFromInt(f64, map.BOUNDED)
            p.*.values[2] = 3.0
        }
        if !registry.apply(p, w, 64, 1, 64) { return 121 }
        var index: usize = 0
        while index < 64 {
            const near = (index >= 17 && index <= 23) || pass == 0
            if w[index] != (if near { 0xFF336699 } else { 0 }) { return 121 }
            index += 1
        }
        pass += 1
    }
    // Nothing seen, or nothing unseen: nothing changes.
    registry.defaults(map.PROPAGATE_COLORS, p)
    setAll(w, 64, 0x00ABCDEF)
    if !registry.apply(p, w, 8, 8, 8) || w[0] != 0x00ABCDEF || w[63] != 0x00ABCDEF { return 122 }
    return 0
}

fn oilpaintExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    registry.defaults(artistic.OILPAINT, p)
    if registry.margin(p) != 1 { return 68 }
    // One light pixel in a dark picture: every neighbourhood has more of
    // the dark, the pixel goes.
    setAll(w, 25, 0xFF404040)
    w[12] = 0xFFC0C0C0
    if !registry.apply(p, w, 5, 5, 5) { return 68 }
    var index: usize = 0
    while index < 25 {
        if w[index] != 0xFF404040 { return 68 }
        index += 1
    }
    // A straight edge stays: left of it six of nine are dark, right of it
    // six are light.
    index = 0
    while index < 24 {
        w[index] = if index % 6 < 3 { 0xFF202020 } else { 0xFFE0E0E0 }
        index += 1
    }
    if !registry.apply(p, w, 6, 4, 6) { return 69 }
    index = 0
    while index < 24 {
        if w[index] != (if index % 6 < 3 { 0xFF202020 } else { 0xFFE0E0E0 }) { return 69 }
        index += 1
    }
    // Ten levels: greys 100 and 102 are in the same one, so the middle of
    // five 100s and four 102s is their mean, 908 / 9 = 101.
    p.*.values[1] = 10.0
    load(w, [9]u32{ 0xFF646464, 0xFF666666, 0xFF646464, 0xFF666666, 0xFF646464, 0xFF666666, 0xFF646464, 0xFF666666, 0xFF646464 }[0..])
    if !registry.apply(p, w, 3, 3, 3) { return 70 }
    if w[4] != 0xFF656565 { return 70 }
    // Greys 105 and 130 are a level apart (4 and 5 of the ten): the
    // middle stays one of the five, not a mix with the four.
    load(w, [9]u32{ 0xFF696969, 0xFF828282, 0xFF696969, 0xFF828282, 0xFF696969, 0xFF828282, 0xFF696969, 0xFF828282, 0xFF696969 }[0..])
    if !registry.apply(p, w, 3, 3, 3) { return 70 }
    if w[4] != 0xFF696969 { return 70 }
    // Alpha is the count. Left of two pixels, the edge standing in for
    // what is beyond it, the dark one counts twice at alpha 100 and the
    // light one once at alpha 200: equal, and the darker level wins. The
    // pixel's own alpha stays.
    registry.defaults(artistic.OILPAINT, p)
    load(w, [2]u32{ 0x64202020, 0xC8E0E0E0 }[0..])
    if !registry.apply(p, w, 2, 1, 2) { return 71 }
    if w[0] != 0x64202020 || w[1] != 0xC8E0E0E0 { return 71 }
    // The same with the light one a little stronger: it wins on the left.
    load(w, [2]u32{ 0x64202020, 0xC9E0E0E0 }[0..])
    if !registry.apply(p, w, 2, 1, 2) { return 72 }
    if w[0] != 0x64E0E0E0 || w[1] != 0xC9E0E0E0 { return 72 }
    // What is not seen has no say and is 0 afterwards.
    load(w, [3]u32{ 0x00FFFFFF, 0xFF102030, 0x00FFFFFF }[0..])
    if !registry.apply(p, w, 1, 3, 1) { return 73 }
    if w[0] != 0 || w[1] != 0xFF102030 || w[2] != 0 { return 73 }
    // The largest brush on a picture smaller than it.
    p.*.values[0] = 5.0
    if registry.margin(p) != 5 { return 74 }
    setAll(w, 6, 0xFF778899)
    if !registry.apply(p, w, 3, 2, 3) { return 74 }
    if w[0] != 0xFF778899 || w[5] != 0xFF778899 { return 74 }
    return 0
}

// The pixel of the wave pictures at (x, y): each its own.
fn tagged(x: usize, y: usize) -> u32 {
    return 0xFF000000 | (@intCast(u32, x) << 16) | (@intCast(u32, y * 8 + x) << 8) | @intCast(u32, x * 17 + y)
}

fn waveExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // A triangle 4 pixels long and 2 high, sideways: rows 0 and 2 stay,
    // row 1 shows what is 2 to its right, row 3 what is 2 to its left,
    // the edge standing in beyond the edge.
    registry.defaults(other.WAVE, p)
    p.*.values[0] = 4.0
    p.*.values[1] = 0.0
    p.*.values[2] = 2.0
    p.*.values[3] = 1.0
    p.*.values[6] = 0.0
    if registry.margin(p) != 2 { return 75 }
    var y: usize = 0
    while y < 4 {
        var x: usize = 0
        while x < 8 {
            w[y * 8 + x] = tagged(x, y)
            x += 1
        }
        y += 1
    }
    if !registry.apply(p, w, 8, 4, 8) { return 75 }
    var x: usize = 0
    while x < 8 {
        if w[x] != tagged(x, 0) || w[16 + x] != tagged(x, 2) { return 75 }
        if w[8 + x] != tagged(if x + 2 > 7 { 7 } else { x + 2 }, 1) { return 76 }
        if w[24 + x] != tagged(if x < 2 { 0 } else { x - 2 }, 3) { return 76 }
        x += 1
    }
    // The same wave shifted by a pixel is the next row's.
    p.*.values[1] = 1.0
    y = 0
    while y < 4 {
        x = 0
        while x < 8 {
            w[y * 8 + x] = tagged(x, y)
            x += 1
        }
        y += 1
    }
    if !registry.apply(p, w, 8, 4, 8) { return 77 }
    if w[0] != tagged(2, 0) || w[8 + 3] != tagged(3, 1) || w[16 + 3] != tagged(1, 2) { return 77 }
    // A sine as long and 3 high is 3 at its quarter: up and down now.
    // Column 1 shows what is 3 below (the edge at the bottom), column 3
    // what is 3 above.
    registry.defaults(other.WAVE, p)
    p.*.values[2] = 0.0
    p.*.values[4] = 4.0
    p.*.values[5] = 0.0
    p.*.values[6] = 3.0
    if registry.margin(p) != 3 { return 78 }
    y = 0
    while y < 6 {
        x = 0
        while x < 4 {
            w[y * 4 + x] = tagged(x, y)
            x += 1
        }
        y += 1
    }
    if !registry.apply(p, w, 4, 6, 4) { return 78 }
    y = 0
    while y < 6 {
        if w[y * 4] != tagged(0, y) || w[y * 4 + 2] != tagged(2, y) { return 78 }
        if w[y * 4 + 1] != tagged(1, if y + 3 > 5 { 5 } else { y + 3 }) { return 79 }
        if w[y * 4 + 3] != tagged(3, if y < 3 { 0 } else { y - 3 }) { return 79 }
        y += 1
    }
    // Half a pixel: a triangle 8 long and 1 high is 0.5 at row 1, where
    // each pixel is the mean of itself and its right neighbour, rounded
    // up: red x + 1, green 8 + x + 1, blue 17 x + 1 + 9; the last one has
    // no neighbour.
    registry.defaults(other.WAVE, p)
    p.*.values[0] = 8.0
    p.*.values[1] = 0.0
    p.*.values[2] = 1.0
    p.*.values[3] = 1.0
    p.*.values[6] = 0.0
    y = 0
    while y < 2 {
        x = 0
        while x < 8 {
            w[y * 8 + x] = tagged(x, y)
            x += 1
        }
        y += 1
    }
    if !registry.apply(p, w, 8, 2, 8) { return 80 }
    x = 0
    while x < 7 {
        if w[8 + x] != (0xFF000000 | (@intCast(u32, x + 1) << 16) | (@intCast(u32, x + 9) << 8) | @intCast(u32, x * 17 + 10)) { return 80 }
        x += 1
    }
    if w[15] != tagged(7, 1) || w[3] != tagged(3, 0) { return 80 }
    // Between a seen and an unseen pixel: half the alpha, and the seen
    // one's colour alone.
    load(w, [4]u32{ 0, 0, RED, 0x0000FF00 }[0..])
    if !registry.apply(p, w, 2, 2, 2) { return 81 }
    if w[2] != 0x80FF0000 || w[3] != 0 { return 81 }
    // Thirds of a pixel: a triangle 12 long is 1 / 3 at row 1 and 2 / 3
    // at row 2, in 256ths 85 and 171; between red 0 and red 100 that is
    // (100 * 85 + 128) / 256 = 33 and (100 * 171 + 128) / 256 = 67.
    p.*.values[0] = 12.0
    load(w, [6]u32{ 0xFF000000, 0xFF640000, 0xFF000000, 0xFF640000, 0xFF000000, 0xFF640000 }[0..])
    if !registry.apply(p, w, 2, 3, 2) { return 81 }
    if !holds(w, [6]u32{ 0xFF000000, 0xFF640000, 0xFF210000, 0xFF640000, 0xFF430000, 0xFF640000 }[0..]) { return 81 }
    return 0
}

fn normalizeExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // (128, 128, 128) points a little along all three: the length 1 makes
    // it 0.577 each, 128 + 0.577 * 127.5 = 201; black the same the other
    // way, 54. Directions that have the length stay. Alpha stays.
    registry.defaults(map.NORMALIZE, p)
    load(w, [6]u32{ 0x40808080, 0xFF000000, 0xFFFF8080, 0xFF8080FF, 0x007F7FFF, 0xFFC86432 }[0..])
    if !registry.apply(p, w, 3, 2, 3) { return 82 }
    if !holds(w, [6]u32{ 0x40C9C9C9, 0xFF363636, 0xFFFF8080, 0xFF8080FF, 0x007F7FFF, 0xFFD46025 }[0..]) { return 82 }
    // Done twice it is done once (to a step of rounding).
    fill(w, 64, 64, 64, OPAQUE, 3)
    if !registry.apply(p, w, 64, 64, 64) { return 83 }
    copy(work.*.tiled, 64, w, 64, 64, 64)
    if !registry.apply(p, w, 64, 64, 64) { return 83 }
    var index: usize = 0
    while index < 4096 {
        var channel: u32 = 0
        while channel < 24 {
            const a = @intCast(i32, (w[index] >> channel) & 255)
            const b = @intCast(i32, (work.*.tiled[index] >> channel) & 255)
            if a - b > 1 || b - a > 1 { return 83 }
            channel += 8
        }
        index += 1
    }
    return 0
}

// Light 1 alone from `azimuth` at 45 degrees over a 16 x 8 picture made
// of a `left` and a `right` half; the pixel in row 4, column `at`.
fn lit(work: *Work, left: u32, right: u32, azimuth: f64, at: usize) -> u32 {
    const p = &work.*.params
    const w = work.*.whole
    registry.defaults(map.PHONG_BUMPMAP, p)
    p.*.values[8] = azimuth
    var index: usize = 0
    while index < 128 {
        w[index] = if index % 16 < 8 { left } else { right }
        index += 1
    }
    _ = registry.apply(p, w, 16, 8, 16)
    return w[4 * 16 + at]
}

// The same over an 8 x 16 picture of an `upper` and a `lower` half; the
// pixel in column 4, row `at`.
fn litDown(work: *Work, upper: u32, lower: u32, azimuth: f64, at: usize) -> u32 {
    const p = &work.*.params
    const w = work.*.whole
    registry.defaults(map.PHONG_BUMPMAP, p)
    p.*.values[8] = azimuth
    var index: usize = 0
    while index < 128 {
        w[index] = if index < 64 { upper } else { lower }
        index += 1
    }
    _ = registry.apply(p, w, 8, 16, 8)
    return w[at * 8 + 4]
}

fn phongExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // A flat picture under the one light the filter starts with (from
    // the upper left, 45 degrees up): ambient 0.2, diffuse 0.5 * sin 45,
    // specular 0.3 * (cos 22.5)^40, in all 0.566 of white: 144.
    registry.defaults(map.PHONG_BUMPMAP, p)
    if registry.margin(p) != 1 { return 84 }
    const half = math.cos(math.pi / 8.0)
    const shine = math.pow(half, 40.0)
    const expected = @intFromFloat(u32, (0.2 + 0.5 * math.sin(math.pi / 4.0) + 0.3 * shine) * 255.0 + 0.5)
    if expected != 144 { return 84 }
    setAll(w, 256, 0xFF5A7813)
    w[5] = 0x805A7813
    w[6] = 0x00FFFFFF
    if !registry.apply(p, w, 16, 16, 16) { return 85 }
    // Alpha stays, the unseen pixel is 0, and around the two the ground
    // falls off, so only what is away from them is flat.
    if w[5] >> 24 != 0x80 || w[6] != 0 { return 85 }
    if w[0] != 0xFF909090 || w[255] != 0xFF909090 || w[8 * 16 + 8] != 0xFF909090 { return 86 }
    // A step up by 8 from black to a dark grey: its side's normal is (-8,
    // 0, 8), which is where a light from the left at 45 degrees comes
    // from. Lit from there the side gets all the diffuse light (0.2 +
    // 0.5 + the floor's shine: 182), lit from the right none (the
    // ambient 0.2 alone: 51), lit from above something in between; the
    // floor away from the step is as ever.
    const flat = lit(work, 0xFF000000, 0xFF000000, 180.0, 7)
    const facing = lit(work, 0xFF000000, 0xFF080808, 180.0, 7)
    const away = lit(work, 0xFF000000, 0xFF080808, 0.0, 7)
    const along = lit(work, 0xFF000000, 0xFF080808, 90.0, 7)
    if flat != 0xFF909090 || facing != 0xFFB6B6B6 || away != 0xFF333333 { return 87 }
    if along & 255 >= flat & 255 || along & 255 <= away & 255 { return 88 }
    if lit(work, 0xFF000000, 0xFF080808, 180.0, 3) != flat || lit(work, 0xFF000000, 0xFF080808, 180.0, 12) != flat { return 88 }
    // The step the other way is lit from the right.
    if lit(work, 0xFF080808, 0xFF000000, 0.0, 8) != facing { return 89 }
    // The height is the lightness times alpha: a seen grey next to
    // nothing is a step, the same grey next to itself is not.
    if lit(work, 0x00080808, 0xFF080808, 180.0, 8) != facing || lit(work, 0xFF080808, 0xFF080808, 180.0, 8) != flat { return 89 }
    // A step up towards the bottom of the picture has its side towards
    // the top: lit from above (90 degrees), dark from below.
    if litDown(work, 0xFF000000, 0xFF080808, 90.0, 7) != facing || litDown(work, 0xFF000000, 0xFF080808, 270.0, 8) != away { return 89 }
    if litDown(work, 0xFF080808, 0xFF000000, 270.0, 8) != facing { return 89 }
    // A red light and no ambient one: red alone.
    registry.defaults(map.PHONG_BUMPMAP, p)
    p.*.values[2] = 0.0
    p.*.values[7] = 4294901760.0
    setAll(w, 64, 0xFF808080)
    if !registry.apply(p, w, 8, 8, 8) { return 90 }
    if w[27] & 0xFFFF != 0 || (w[27] >> 16) & 255 < 80 { return 90 }
    // Four lights are more light than one.
    registry.defaults(map.PHONG_BUMPMAP, p)
    p.*.values[10] = 1.0
    p.*.values[14] = 1.0
    p.*.values[18] = 1.0
    setAll(w, 64, 0xFF808080)
    if !registry.apply(p, w, 8, 8, 8) { return 91 }
    if w[27] != 0xFFFFFFFF { return 91 }
    // A normal map: (128, 128, 255) is the flat normal (to a rounding
    // step), a normal leaning left is lit from the left; no margin.
    registry.defaults(map.PHONG_BUMPMAP, p)
    p.*.values[1] = 1.0
    p.*.values[8] = 180.0
    if registry.margin(p) != 0 { return 92 }
    setAll(w, 64, 0xFF8080FF)
    w[9] = 0xFF2080C0
    w[10] = 0xFFE080C0
    if !registry.apply(p, w, 8, 8, 8) { return 92 }
    const level = @intCast(i32, w[27] & 255)
    if level < 143 || level > 145 || w[9] & 255 <= w[27] & 255 || w[10] & 255 >= w[27] & 255 { return 92 }
    // The channel asked for is the height: a step in blue alone is none
    // for red.
    const step = lit(work, 0xFF0000FF, 0xFF000000, 180.0, 7)
    registry.defaults(map.PHONG_BUMPMAP, p)
    p.*.values[0] = 1.0
    p.*.values[8] = 180.0
    var index: usize = 0
    while index < 128 {
        w[index] = if index % 16 < 8 { 0xFF0000FF } else { 0xFF000000 }
        index += 1
    }
    if !registry.apply(p, w, 16, 8, 16) { return 93 }
    if w[4 * 16 + 7] != flat || step == flat { return 93 }
    return 0
}

fn halftoneExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // Red dots on blue. White is all paper, black all ink, and the other
    // way round when inverted.
    registry.defaults(artistic.HALFTONE, p)
    p.*.values[4] = 4294901760.0
    p.*.values[5] = 4278190335.0
    if registry.margin(p) != 0 { return 94 }
    setAll(w, 4096, 0xFFFFFFFF)
    if !registry.apply(p, w, 64, 64, 64) { return 94 }
    var index: usize = 0
    while index < 4096 {
        if w[index] != BLUE { return 94 }
        index += 1
    }
    setAll(w, 4096, 0xFF000000)
    if !registry.apply(p, w, 64, 64, 64) { return 95 }
    index = 0
    while index < 4096 {
        if w[index] != RED { return 95 }
        index += 1
    }
    p.*.values[2] = 1.0
    setAll(w, 4096, 0xFF000000)
    if !registry.apply(p, w, 64, 64, 64) { return 96 }
    index = 0
    while index < 4096 {
        if w[index] != BLUE { return 96 }
        index += 1
    }
    // Without anti-aliasing a pixel is ink or paper, and as much of the
    // picture is ink as it is short of white.
    p.*.values[2] = 0.0
    p.*.values[3] = 0.0
    var inked: [3]usize = [3]usize{ 0, 0, 0 }
    var shade: usize = 0
    while shade < 3 {
        setAll(w, 4096, if shade == 0 { 0xFFC0C0C0 } else if shade == 1 { 0xFF808080 } else { 0xFF404040 })
        if !registry.apply(p, w, 64, 64, 64) { return 97 }
        index = 0
        while index < 4096 {
            if w[index] == RED { inked[shade] += 1 } else if w[index] != BLUE { return 97 }
            index += 1
        }
        shade += 1
    }
    // A quarter, a half and three quarters of the 4096 pixels (to four
    // in a hundred: the dots are counted by their pixels' middles).
    if inked[0] < 860 || inked[0] > 1190 || inked[1] < 1880 || inked[1] > 2210 || inked[2] < 2900 || inked[2] > 3230 { return 98 }
    // With it there are pixels in between, and the dots are where they
    // were.
    p.*.values[3] = 1.0
    setAll(w, 4096, 0xFF808080)
    if !registry.apply(p, w, 64, 64, 64) { return 99 }
    var between: usize = 0
    var ink: usize = 0
    index = 0
    while index < 4096 {
        if w[index] == RED { ink += 1 } else if w[index] != BLUE { between += 1 }
        index += 1
    }
    if between < 100 || ink < inked[1] / 2 || ink > inked[1] { return 99 }
    // The pixel's alpha stays, times the colour's: half-seen black under
    // half-seen ink is a quarter seen.
    setAll(w, 64, 0x80000000)
    if !registry.apply(p, w, 8, 8, 8) { return 100 }
    if w[20] != 0x80FF0000 { return 100 }
    p.*.values[4] = 2164195328.0
    setAll(w, 64, 0x80000000)
    if !registry.apply(p, w, 8, 8, 8) { return 101 }
    if w[20] != 0x40FF0000 { return 101 }
    // At angle 0 and cells of 8 the dots repeat every 8 pixels.
    registry.defaults(artistic.HALFTONE, p)
    p.*.values[1] = 0.0
    setAll(w, 4096, 0xFFA0A0A0)
    if !registry.apply(p, w, 64, 64, 64) { return 102 }
    index = 0
    while index < 4096 {
        if index % 64 >= 8 && w[index] != w[index - 8] { return 102 }
        if index >= 512 && w[index] != w[index - 512] { return 102 }
        index += 1
    }
    // A dot is round: around a cell's middle the picture is its own
    // mirror.
    if w[3 * 64 + 2] != w[3 * 64 + 5] || w[2 * 64 + 3] != w[5 * 64 + 3] || w[1 * 64 + 1] != w[6 * 64 + 6] { return 103 }
    // The middle of a cell is ink, its corner paper (this grey's dot is
    // 2.8 pixels wide).
    if w[3 * 64 + 3] != 0xFF000000 || w[0] != 0xFFFFFFFF { return 103 }
    return 0
}

fn raindropsExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    // An even grey has nothing to enlarge: what is seen of the drops is
    // their light alone, a shadow, a glow and a highlight, at most 80
    // darker and lighter, grey as before.
    registry.defaults(artistic.RAINDROPS, p)
    p.*.values[0] = 60.0
    p.*.values[1] = 40.0
    if registry.margin(p) != 60 { return 104 }
    setAll(w, ODD_WIDE * ODD_HIGH, 0xFF808080)
    if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 104 }
    var darker: usize = 0
    var lighter: usize = 0
    var same: usize = 0
    var darkest: u32 = 255
    var lightest: u32 = 0
    var index: usize = 0
    while index < ODD_WIDE * ODD_HIGH {
        const q = w[index]
        const grey = q & 255
        if q >> 24 != 255 || (q >> 16) & 255 != grey || (q >> 8) & 255 != grey { return 105 }
        if grey < 48 || grey > 188 { return 105 }
        if grey < 128 { darker += 1 } else if grey > 128 { lighter += 1 } else { same += 1 }
        if grey < darkest { darkest = grey }
        if grey > lightest { lightest = grey }
        index += 1
    }
    if darker < 200 || lighter < 200 || same < 5000 { return 106 }
    // The shadow goes down to 80 below, the glow up to 40 above, the
    // highlight to 60.
    if darkest > 60 || lightest < 176 { return 106 }
    // On a picture a drop enlarges: inside it pixels show what is nearer
    // its middle, so in a picture of dark and light columns many pixels
    // of a drop show the other kind of column, which is further from
    // what they were than any light of a drop; outside the drops nothing
    // changes.
    index = 0
    while index < ODD_WIDE * ODD_HIGH {
        w[index] = if (index % ODD_WIDE) % 4 < 2 { 0xFF202020 } else { 0xFFE0E0E0 }
        work.*.tiled[index] = w[index]
        index += 1
    }
    if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 107 }
    var swapped: usize = 0
    index = 0
    while index < ODD_WIDE * ODD_HIGH {
        const now = @intCast(i32, w[index] & 255)
        const was = @intCast(i32, work.*.tiled[index] & 255)
        if now - was > 100 || was - now > 100 { swapped += 1 }
        index += 1
    }
    const moved = differing(w, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH)
    if swapped < 500 || moved > ODD_WIDE * ODD_HIGH * 3 / 4 { return 107 }
    // Fish eyes enlarge more: all of them or none are two pictures.
    p.*.values[2] = 0.0
    copy(w, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH)
    if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 107 }
    copy(work.*.piece, ODD_WIDE, w, ODD_WIDE, ODD_WIDE, ODD_HIGH)
    p.*.values[2] = 100.0
    copy(w, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH)
    if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 107 }
    if differing(w, ODD_WIDE, work.*.piece, ODD_WIDE, ODD_WIDE, ODD_HIGH) < 500 { return 107 }
    return 0
}

fn diceExact(work: *Work) -> u8 {
    const p = &work.*.params
    const w = work.*.whole
    const count = ODD_WIDE * ODD_HIGH
    // Random Noise as it starts: half the pixels get a colour of the
    // dice, alpha stays.
    registry.defaults(other.RANDOM_NOISE, p)
    setAll(w, count, 0x80202020)
    if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 108 }
    var changed: usize = 0
    var reds: usize = 0
    var index: usize = 0
    while index < count {
        if w[index] >> 24 != 0x80 { return 108 }
        if w[index] != 0x80202020 {
            changed += 1
            reds += @intCast(usize, (w[index] >> 16) & 255)
        }
        index += 1
    }
    if changed < count * 47 / 100 || changed > count * 53 / 100 { return 109 }
    // The colours are any, and nothing of the dark grey is left in them:
    // their red is 127.5 on average.
    if reds / changed < 120 || reds / changed > 135 { return 109 }
    // All of them at level 100; at half the opacity half as far from what
    // was.
    p.*.values[0] = 100.0
    p.*.values[1] = 50.0
    setAll(w, count, 0xFF808080)
    if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 110 }
    changed = 0
    index = 0
    while index < count {
        const red = (w[index] >> 16) & 255
        if red < 64 || red > 192 || w[index] >> 24 != 255 { return 110 }
        if w[index] != 0xFF808080 { changed += 1 }
        index += 1
    }
    if changed < count * 99 / 100 { return 110 }
    // Random Pick: every pixel is one of its window (5 across here), at
    // half the opacity the even mix of itself and one of its window (of
    // pixels of any alpha, as core/pixel.mlx mixes them); most are not
    // the one that was there.
    var pass: usize = 0
    while pass < 2 {
        registry.defaults(other.RANDOM_PICK, p)
        p.*.values[0] = 100.0
        p.*.values[1] = 5.0
        if pass == 1 { p.*.values[2] = 50.0 }
        const strength: u32 = if pass == 0 { 255 } else { 128 }
        if registry.margin(p) != 2 { return 111 }
        fill(w, ODD_WIDE, ODD_HIGH, ODD_WIDE, if pass == 0 { OPAQUE } else { MIXED }, 21)
        copy(work.*.tiled, ODD_WIDE, w, ODD_WIDE, ODD_WIDE, ODD_HIGH)
        if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 111 }
        changed = 0
        var y: usize = 0
        while y < ODD_HIGH {
            var x: usize = 0
            while x < ODD_WIDE {
                const now = w[y * ODD_WIDE + x]
                const was = work.*.tiled[y * ODD_WIDE + x]
                if now != was { changed += 1 }
                var found = false
                var dy: usize = 0
                while dy < 5 && !found {
                    var from_y = if y + dy < 2 { 0 } else { y + dy - 2 }
                    if from_y >= ODD_HIGH { from_y = ODD_HIGH - 1 }
                    var dx: usize = 0
                    while dx < 5 {
                        var from_x = if x + dx < 2 { 0 } else { x + dx - 2 }
                        if from_x >= ODD_WIDE { from_x = ODD_WIDE - 1 }
                        var mixed = pixel.mix(was, work.*.tiled[from_y * ODD_WIDE + from_x], strength)
                        if mixed >> 24 == 0 { mixed = 0 }
                        if mixed == now { found = true }
                        dx += 1
                    }
                    dy += 1
                }
                if !found { return 112 }
                x += 1
            }
            y += 1
        }
        if changed < count * 8 / 10 { return 112 }
        pass += 1
    }
    registry.defaults(other.RANDOM_PICK, p)
    p.*.values[1] = 5.0
    fill(work.*.tiled, ODD_WIDE, ODD_HIGH, ODD_WIDE, OPAQUE, 21)
    // Level 30: about three in ten.
    p.*.values[0] = 30.0
    copy(w, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH)
    if !registry.apply(p, w, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 113 }
    changed = differing(w, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH)
    if changed < count * 25 / 100 || changed > count * 31 / 100 { return 113 }
    return 0
}

// ---- Transparent neighbours ----

// A red square on unseen green, 64 x 48.
fn redSquare(pixels: [*]u32) -> void {
    var y: usize = 0
    while y < 48 {
        var x: usize = 0
        while x < 64 {
            pixels[y * 64 + x] = if x >= 16 && x < 48 && y >= 12 && y < 36 { RED } else { 0x0000FF00 }
            x += 1
        }
        y += 1
    }
}

// The filter of work.params over the red square: whether all that is
// seen afterwards is pure red and all that is not seen is 0 (`drops`:
// Raindrops, which adds light and leaves the pixels outside its drops:
// what is seen has as much green as blue), and something is seen.
fn staysRed(work: *Work, drops: bool) -> bool {
    const w = work.*.whole
    redSquare(w)
    if !registry.apply(&work.*.params, w, 64, 48, 64) { return false }
    var seen: usize = 0
    var index: usize = 0
    while index < 64 * 48 {
        const p = w[index]
        if p >> 24 == 0 {
            if p != 0 && !drops { return false }
        } else {
            seen += 1
            if drops {
                if (p >> 8) & 255 != p & 255 { return false }
            } else if p & 0x00FFFFFF != 0xFF0000 {
                return false
            }
        }
        index += 1
    }
    return seen > 100
}

fn bleeding(work: *Work) -> u8 {
    const p = &work.*.params
    registry.defaults(artistic.OILPAINT, p)
    if !staysRed(work, false) { return 130 }
    p.*.values[0] = 5.0
    p.*.values[1] = 255.0
    if !staysRed(work, false) { return 130 }
    registry.defaults(artistic.PIXELIZE, p)
    p.*.values[0] = 5.0
    p.*.values[1] = 7.0
    if !staysRed(work, false) { return 131 }
    registry.defaults(map.SMALL_TILES, p)
    p.*.values[0] = 3.0
    if !staysRed(work, false) { return 132 }
    registry.defaults(other.RANDOM_PICK, p)
    p.*.values[0] = 100.0
    p.*.values[1] = 9.0
    if !staysRed(work, false) { return 133 }
    p.*.values[2] = 50.0
    if !staysRed(work, false) { return 133 }
    registry.defaults(other.WAVE, p)
    p.*.values[0] = 7.0
    p.*.values[2] = 3.0
    p.*.values[4] = 11.0
    p.*.values[6] = 5.0
    p.*.values[7] = 1.0
    if !staysRed(work, false) { return 134 }
    registry.defaults(artistic.RAINDROPS, p)
    p.*.values[0] = 30.0
    p.*.values[1] = 40.0
    p.*.values[2] = 50.0
    if !staysRed(work, true) { return 135 }
    // Propagate Colors spreads the red, and nothing of the green under
    // the transparency, whatever the metric; bounded, what it does not
    // reach stays as it was, and it reaches a band around the square.
    var metric: u32 = 0
    while metric < 3 {
        registry.defaults(map.PROPAGATE_COLORS, p)
        p.*.values[0] = @floatFromInt(f64, metric)
        if !staysRed(work, false) { return 136 }
        p.*.values[1] = @floatFromInt(f64, map.BOUNDED)
        p.*.values[2] = 5.5
        const w = work.*.whole
        redSquare(w)
        if !registry.apply(p, w, 64, 48, 64) { return 137 }
        var seen: usize = 0
        var index: usize = 0
        while index < 64 * 48 {
            if w[index] >> 24 == 0 {
                if w[index] != 0x0000FF00 { return 137 }
            } else {
                if w[index] != RED { return 137 }
                seen += 1
            }
            index += 1
        }
        if seen <= 32 * 24 + 4 * 5 * 28 || seen > 43 * 35 { return 137 }
        metric += 1
    }
    return 0
}

// ---- Whole against blocks ----

// work.source (WIDE x HIGH) filtered whole into work.whole and block by
// block into work.tiled, each block of 256 grown by the filter's margin
// plus `more` (held inside the picture, as the edge stands in for what
// is beyond it either way), filtered and its middle taken: how many
// pixels differ. Wave counts its waves from the piece's first row and
// column, so the piece's place is added to its two shifts.
fn blocksDiffer(work: *Work, more: i32) -> usize {
    const params = &work.*.params
    copy(work.*.whole, WIDE, work.*.source, WIDE, WIDE, HIGH)
    _ = registry.apply(params, work.*.whole, WIDE, HIGH, WIDE)
    var reach = registry.margin(params) + more
    if reach < 0 { reach = 0 }
    const margin = @intCast(usize, reach)
    var by: usize = 0
    while by < HIGH {
        const bh = if HIGH - by < BLOCK { HIGH - by } else { BLOCK }
        var bx: usize = 0
        while bx < WIDE {
            const bw = if WIDE - bx < BLOCK { WIDE - bx } else { BLOCK }
            const left = if bx < margin { 0 } else { bx - margin }
            const top = if by < margin { 0 } else { by - margin }
            const right = if bx + bw + margin > WIDE { WIDE } else { bx + bw + margin }
            const bottom = if by + bh + margin > HIGH { HIGH } else { by + bh + margin }
            const pw = right - left
            const ph = bottom - top
            copy(work.*.piece, pw, work.*.source + (top * WIDE + left), WIDE, pw, ph)
            work.*.block_params = params.*
            if params.*.id == other.WAVE {
                const across = @intFromFloat(usize, params.*.values[0])
                const down = @intFromFloat(usize, params.*.values[4])
                work.*.block_params.values[1] = @floatFromInt(f64, (@intFromFloat(usize, params.*.values[1]) + top) % across)
                work.*.block_params.values[5] = @floatFromInt(f64, (@intFromFloat(usize, params.*.values[5]) + left) % down)
            }
            _ = registry.apply(&work.*.block_params, work.*.piece, pw, ph, pw)
            copy(work.*.tiled + (by * WIDE + bx), WIDE, work.*.piece + ((by - top) * pw + (bx - left)), pw, bw, bh)
            bx += bw
        }
        by += bh
    }
    return differing(work.*.whole, WIDE, work.*.tiled, WIDE, WIDE, HIGH)
}

fn blocks(work: *Work) -> u8 {
    const p = &work.*.params
    picture(work.*.source, WIDE, HIGH, WIDE, 11)
    // Oilpaint: its brush size around a pixel, no less.
    registry.defaults(artistic.OILPAINT, p)
    if blocksDiffer(work, 0) != 0 { return 140 }
    if blocksDiffer(work, -1) == 0 { return 141 }
    turns.turn(&work.*.loop)
    p.*.values[0] = 5.0
    p.*.values[1] = 255.0
    if blocksDiffer(work, 0) != 0 { return 142 }
    if blocksDiffer(work, -1) == 0 { return 143 }
    turns.turn(&work.*.loop)
    p.*.values[0] = 3.0
    p.*.values[1] = 10.0
    if blocksDiffer(work, 0) != 0 { return 144 }
    turns.turn(&work.*.loop)
    // Pixelize where the blocks start on the cell grid: cells of 8 x 16
    // and a margin of 16.
    registry.defaults(artistic.PIXELIZE, p)
    p.*.values[0] = 8.0
    p.*.values[1] = 16.0
    if registry.margin(p) != 16 || blocksDiffer(work, 0) != 0 { return 145 }
    turns.turn(&work.*.loop)
    // Halftone at angle 0 with cells of 8: the same.
    registry.defaults(artistic.HALFTONE, p)
    p.*.values[1] = 0.0
    if blocksDiffer(work, 0) != 0 { return 146 }
    turns.turn(&work.*.loop)
    registry.defaults(artistic.POSTERIZE, p)
    if blocksDiffer(work, 0) != 0 { return 147 }
    turns.turn(&work.*.loop)
    // Phong Bumpmap: one pixel around a height map, none around a normal
    // map.
    registry.defaults(map.PHONG_BUMPMAP, p)
    if blocksDiffer(work, 0) != 0 { return 148 }
    if blocksDiffer(work, -1) == 0 { return 149 }
    turns.turn(&work.*.loop)
    p.*.values[0] = 4.0
    p.*.values[10] = 1.0
    p.*.values[11] = 4294936576.0
    p.*.values[14] = 1.0
    p.*.values[18] = 1.0
    p.*.values[5] = 200.0
    if blocksDiffer(work, 0) != 0 { return 150 }
    turns.turn(&work.*.loop)
    p.*.values[1] = 1.0
    if registry.margin(p) != 0 || blocksDiffer(work, 0) != 0 { return 151 }
    turns.turn(&work.*.loop)
    registry.defaults(map.NORMALIZE, p)
    if blocksDiffer(work, 0) != 0 { return 152 }
    turns.turn(&work.*.loop)
    // Wave: the larger amplitude, no less.
    registry.defaults(other.WAVE, p)
    if registry.margin(p) != 4 || blocksDiffer(work, 0) != 0 { return 153 }
    if blocksDiffer(work, -1) == 0 { return 154 }
    turns.turn(&work.*.loop)
    p.*.values[0] = 37.0
    p.*.values[1] = 400.0
    p.*.values[2] = 23.0
    p.*.values[3] = 1.0
    p.*.values[4] = 91.0
    p.*.values[5] = 5.0
    p.*.values[6] = 9.0
    if registry.margin(p) != 23 || blocksDiffer(work, 0) != 0 { return 155 }
    if blocksDiffer(work, -1) == 0 { return 156 }
    turns.turn(&work.*.loop)
    p.*.values[2] = 0.0
    p.*.values[6] = 100.0
    if registry.margin(p) != 100 || blocksDiffer(work, 0) != 0 { return 157 }
    turns.turn(&work.*.loop)
    registry.defaults(other.COLOR_TO_ALPHA, p)
    p.*.values[1] = 200.0
    if blocksDiffer(work, 0) != 0 { return 158 }
    registry.defaults(other.MAXIMIZE, p)
    if blocksDiffer(work, 0) != 0 { return 159 }
    registry.defaults(other.MINIMIZE, p)
    if blocksDiffer(work, 0) != 0 { return 160 }
    turns.turn(&work.*.loop)
    // Round Corners: its radius, the corners' cuts held to the picture's
    // corners; at 300 the upper and the lower ones meet.
    registry.defaults(map.ROUND_CORNERS, p)
    p.*.values[0] = 40.0
    if registry.margin(p) != 40 || blocksDiffer(work, 0) != 0 { return 164 }
    if blocksDiffer(work, -1) == 0 { return 165 }
    p.*.values[0] = 300.0
    if blocksDiffer(work, 0) != 0 { return 164 }
    turns.turn(&work.*.loop)
    // Propagate Colors bounded: its amount, with each metric.
    var metric: u32 = 0
    while metric < 3 {
        registry.defaults(map.PROPAGATE_COLORS, p)
        p.*.values[0] = @floatFromInt(f64, metric)
        p.*.values[1] = @floatFromInt(f64, map.BOUNDED)
        p.*.values[2] = if metric == 0 { 10.5 } else { 7.0 }
        if registry.margin(p) != (if metric == 0 { 11 } else { 7 }) || blocksDiffer(work, 0) != 0 { return 166 }
        p.*.values[3] = @floatFromInt(f64, map.PRESERVE)
        if blocksDiffer(work, 0) != 0 { return 167 }
        turns.turn(&work.*.loop)
        metric += 1
    }
    // Where what is seen is far apart, the amount is reached and a margin
    // one less is not enough.
    sparse(work.*.source, WIDE, HIGH)
    metric = 0
    while metric < 3 {
        registry.defaults(map.PROPAGATE_COLORS, p)
        p.*.values[0] = @floatFromInt(f64, metric)
        p.*.values[1] = @floatFromInt(f64, map.BOUNDED)
        p.*.values[2] = 9.0
        if blocksDiffer(work, 0) != 0 { return 168 }
        if blocksDiffer(work, -1) == 0 { return 169 }
        turns.turn(&work.*.loop)
        metric += 1
    }
    // The same on an opaque picture, where Oilpaint and Wave take their
    // short ways.
    fill(work.*.source, WIDE, HIGH, WIDE, OPAQUE, 4)
    registry.defaults(artistic.OILPAINT, p)
    p.*.values[0] = 2.0
    if blocksDiffer(work, 0) != 0 { return 161 }
    if blocksDiffer(work, -1) == 0 { return 162 }
    registry.defaults(other.WAVE, p)
    if blocksDiffer(work, 0) != 0 { return 163 }
    return 0
}

// ---- The same seed, the same pixels ----

fn seeds(work: *Work) -> u8 {
    const p = &work.*.params
    const dicers = [3]u16{ artistic.RAINDROPS, other.RANDOM_NOISE, other.RANDOM_PICK }
    const seed_at = [3]usize{ 3, 2, 3 }
    var index: usize = 0
    while index < 3 {
        turns.turn(&work.*.loop)
        registry.defaults(dicers[index], p)
        p.*.values[seed_at[index]] = 12345.0
        if !result(work, work.*.whole) || !result(work, work.*.tiled) { return 170 }
        if differing(work.*.whole, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH) != 0 {
            report(dicers[index], "gives other pixels for the same seed")
            return 171
        }
        p.*.values[seed_at[index]] = 12346.0
        if !result(work, work.*.tiled) { return 170 }
        if differing(work.*.whole, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH) < 500 {
            report(dicers[index], "gives the same pixels for another seed")
            return 172
        }
        index += 1
    }
    return 0
}

// ---- The value arena ----

// Fifty runs of each filter as it starts, through the registry (which
// finds it in the modules' lists each time), take nothing from the value
// arena.
fn arena(work: *Work) -> u8 {
    const base = turns.locate()
    var index: usize = 0
    while index < FILTERS {
        turns.turn(&work.*.loop)
        fill(work.*.whole, ODD_WIDE, ODD_HIGH, ODD_WIDE + PAD, MIXED, 31)
        const before = turns.used(base)
        const marked = scratch.mark(work.*.pool)
        var round: usize = 0
        while round < 50 {
            registry.defaults(IDS[index], &work.*.params)
            if !registry.apply(&work.*.params, work.*.whole, ODD_WIDE, ODD_HIGH, ODD_WIDE + PAD) { return 180 }
            _ = registry.margin(&work.*.params)
            round += 1
        }
        const after = scratch.mark(work.*.pool)
        if turns.used(base) - before > 1024 {
            report(IDS[index], "takes memory from the value arena at every run")
            return 180
        }
        if marked.block != after.block || marked.used != after.used { return 181 }
        index += 1
    }
    // And the module's list costs nothing after its first asking.
    const before = turns.used(base)
    var round: usize = 0
    while round < 100 {
        if artistic.list().length != 5 || map.list().length != 5 || other.list().length != 6 { return 182 }
        round += 1
    }
    if turns.used(base) - before > 1024 { return 182 }
    return 0
}

// ---- The plain way ----
//
// Each filter that has a plain way of saying what it does is worked out
// again here that way, pixel by pixel (every pixel of a window counted
// anew, every seen pixel tried, each tile's box added up), on random
// pictures of every kind and size, and compared: the filters' sliding
// histograms, stacks, column sums and short ways have to come to the same
// pixels.

// A picture of four greys at any alpha (a quarter of them unseen, a
// quarter opaque), so that levels and colours meet often.
const FEW: u32 = 3

// A random picture of `kind` (NOTHING, OPAQUE, MIXED as fill() makes them,
// or FEW) into work.source, `width` x `height` without gaps.
fn sample(work: *Work, width: usize, height: usize, kind: u32, seed: u64) -> void {
    if kind != FEW {
        fill(work.*.source, width, height, width, kind, seed)
        return
    }
    var index: usize = 0
    while index < width * height {
        const bits = dice(seed *% 31337 +% index)
        const grey = 0x20 + @intCast(u32, (bits >> 8) & 3) * 0x40
        var alpha = @intCast(u32, (bits >> 16) & 255)
        if (bits >> 24) & 3 == 0 { alpha = 0 }
        if (bits >> 24) & 3 == 1 { alpha = 255 }
        work.*.source[index] = (alpha << 24) | (grey << 16) | (grey << 8) | grey
        index += 1
    }
}

// work.source filtered by work.params into work.whole (no gaps).
fn filtered(work: *Work, width: usize, height: usize) -> bool {
    copy(work.*.whole, width, work.*.source, width, width, height)
    return registry.apply(&work.*.params, work.*.whole, width, height, width)
}

// Whether the filter's pixels (work.whole) are the plain way's
// (work.tiled).
fn agrees(work: *Work, width: usize, height: usize) -> bool {
    return differing(work.*.whole, width, work.*.tiled, width, width, height) == 0
}

// at + step - back, held in 0 to size - 1: a window's pixel, the edge
// standing in for what is beyond it.
fn clamped(at: usize, step: usize, back: usize, size: usize) -> usize {
    if at + step < back { return 0 }
    const place = at + step - back
    return if place >= size { size - 1 } else { place }
}

// The mean of the box `left` to `right` and `top` to `bottom` of
// `source` (`width` a row): the alpha's mean, the colour's mean weighed
// by alpha, both rounded to the nearest (a half up); 0 where nothing is
// seen.
fn boxMean(source: [*]const u32, width: usize, left: usize, right: usize, top: usize, bottom: usize) -> u32 {
    var alpha: u64 = 0
    var red: u64 = 0
    var green: u64 = 0
    var blue: u64 = 0
    var y = top
    while y < bottom {
        var x = left
        while x < right {
            const p = source[y * width + x]
            const a = @intCast(u64, p >> 24)
            alpha += a
            red += @intCast(u64, (p >> 16) & 255) * a
            green += @intCast(u64, (p >> 8) & 255) * a
            blue += @intCast(u64, p & 255) * a
            x += 1
        }
        y += 1
    }
    const count = @intCast(u64, (right - left) * (bottom - top))
    const mean = (alpha + count / 2) / count
    if mean == 0 { return 0 }
    return (@intCast(u32, mean) << 24) | (@intCast(u32, (red + alpha / 2) / alpha) << 16) | (@intCast(u32, (green + alpha / 2) / alpha) << 8) | @intCast(u32, (blue + alpha / 2) / alpha)
}

// The sizes the plain ways are tried on: 1 x 1, a column, a row, small
// and odd, and across a tile border of 64.
fn shapeWidth(shape: usize) -> usize {
    return if shape == 0 { 1 } else if shape == 1 { 1 } else if shape == 2 { 13 } else if shape == 3 { 6 } else { 67 }
}

fn shapeHeight(shape: usize) -> usize {
    return if shape == 0 { 1 } else if shape == 1 { 13 } else if shape == 2 { 1 } else if shape == 3 { 5 } else { 66 }
}

// Oilpaint the plain way: for each seen pixel every pixel of its window
// sorted into the levels anew (a level is luma * levels / 256), each
// counting its alpha; the fullest level (the darker of equals) gives its
// mean colour, the pixel keeps its alpha; what is unseen is 0.
fn oilpaintPlain(work: *Work, width: usize, height: usize, radius: usize, levels: usize) -> void {
    const source = work.*.source
    const bins = work.*.piece
    const side = radius * 2 + 1
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const own = source[y * width + x]
            var expected: u32 = 0
            if own >> 24 != 0 {
                var index: usize = 0
                while index < levels * 4 {
                    bins[index] = 0
                    index += 1
                }
                var dy: usize = 0
                while dy < side {
                    const from_y = clamped(y, dy, radius, height)
                    var dx: usize = 0
                    while dx < side {
                        const p = source[from_y * width + clamped(x, dx, radius, width)]
                        const a = p >> 24
                        const level = @intCast(usize, pixel.luma(p) * @intCast(u32, levels) / 256)
                        bins[level * 4] += a
                        bins[level * 4 + 1] += ((p >> 16) & 255) * a
                        bins[level * 4 + 2] += ((p >> 8) & 255) * a
                        bins[level * 4 + 3] += (p & 255) * a
                        dx += 1
                    }
                    dy += 1
                }
                var best: usize = 0
                index = 1
                while index < levels {
                    if bins[index * 4] > bins[best * 4] { best = index }
                    index += 1
                }
                const most = bins[best * 4]
                expected = (own & 0xFF000000) | (((bins[best * 4 + 1] + most / 2) / most) << 16) | (((bins[best * 4 + 2] + most / 2) / most) << 8) | ((bins[best * 4 + 3] + most / 2) / most)
            }
            work.*.tiled[y * width + x] = expected
            x += 1
        }
        y += 1
    }
}

fn oilpaintAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var shape: usize = 0
    while shape < 5 {
        const width = shapeWidth(shape)
        const height = shapeHeight(shape)
        var kind: u32 = OPAQUE
        while kind <= FEW {
            sample(work, width, height, kind, @intCast(u64, shape * 4) + @intCast(u64, kind))
            var radius: usize = 1
            while radius <= 5 {
                var choice: usize = 0
                while choice < 3 {
                    turns.turn(&work.*.loop)
                    const levels: usize = if choice == 0 { 10 } else if choice == 1 { 37 } else { 255 }
                    registry.defaults(artistic.OILPAINT, p)
                    p.*.values[0] = @floatFromInt(f64, radius)
                    p.*.values[1] = @floatFromInt(f64, levels)
                    if !filtered(work, width, height) { return 190 }
                    oilpaintPlain(work, width, height, radius, levels)
                    if !agrees(work, width, height) {
                        report(artistic.OILPAINT, "is not what the plain way gives")
                        return 190
                    }
                    choice += 1
                }
                radius += 2
            }
            kind += 1
        }
        shape += 1
    }
    return 0
}

// Transparent pixels with seen ones among them, one in `every` on
// average, `width` x `height` into work.source: the seen ones of any
// alpha and colour, the unseen ones with a colour left in them or 0.
fn scatter(work: *Work, width: usize, height: usize, every: u64, seed: u64) -> void {
    var index: usize = 0
    while index < width * height {
        const bits = dice(seed *% 7777 +% index)
        const color = @intCast(u32, bits & 0xFFFFFF)
        if (bits >> 32) % every == 0 {
            work.*.source[index] = (@intCast(u32, 1 + (bits >> 40) % 255) << 24) | color
        } else {
            work.*.source[index] = if (bits >> 50) & 1 == 0 { color } else { 0 }
        }
        index += 1
    }
}

// Propagate Colors the plain way: every seen pixel tried for every unseen
// one; the nearest by the metric, of equals the leftmost, then the one
// nearest along its column, then the upper one. Bounded: only as far as
// the amount (Euclidean: the root of the squares compared).
fn propagatePlain(work: *Work, width: usize, height: usize, metric: u32, bounded: bool, amount: f64, expand: bool) -> void {
    const source = work.*.source
    var index: usize = 0
    while index < width * height {
        const here = source[index]
        var expected = here
        if here >> 24 == 0 {
            const x = index % width
            const y = index / width
            var found = false
            var best: u64 = 0
            var best_x: usize = 0
            var best_along: u64 = 0
            var best_y: usize = 0
            var at: usize = 0
            while at < width * height {
                if source[at] >> 24 != 0 {
                    const sx = at % width
                    const sy = at / width
                    const across = @intCast(u64, if sx > x { sx - x } else { x - sx })
                    const along = @intCast(u64, if sy > y { sy - y } else { y - sy })
                    var distance = if across > along { across } else { along }
                    if metric == map.EUCLIDEAN { distance = across * across + along * along }
                    if metric == map.CITY_BLOCK { distance = across + along }
                    var better = !found || distance < best
                    if found && distance == best {
                        better = sx < best_x || (sx == best_x && (along < best_along || (along == best_along && sy < best_y)))
                    }
                    if better {
                        found = true
                        best = distance
                        best_x = sx
                        best_along = along
                        best_y = sy
                    }
                }
                at += 1
            }
            if found {
                var reach = @floatFromInt(f64, best)
                if metric == map.EUCLIDEAN { reach = @sqrt(reach) }
                if !bounded || reach <= amount {
                    const from = source[best_y * width + best_x]
                    expected = if expand { from } else { from & 0x00FFFFFF }
                }
            }
        }
        work.*.tiled[index] = expected
        index += 1
    }
}

fn propagateAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var shape: usize = 0
    while shape < 6 {
        const width: usize = if shape == 0 { 1 } else if shape == 1 { 1 } else if shape == 2 { 30 } else if shape == 3 { 23 } else if shape == 4 { 41 } else { 9 }
        const height: usize = if shape == 0 { 1 } else if shape == 1 { 30 } else if shape == 2 { 1 } else if shape == 3 { 17 } else if shape == 4 { 9 } else { 41 }
        var density: usize = 0
        while density < 4 {
            const every: u64 = if density == 0 { 2 } else if density == 1 { 7 } else if density == 2 { 40 } else { 400 }
            scatter(work, width, height, every, @intCast(u64, shape * 8 + density))
            var metric: u32 = 0
            while metric < 3 {
                var reach: usize = 0
                while reach < 6 {
                    turns.turn(&work.*.loop)
                    const amount: f64 = if reach == 1 { 0.0 } else if reach == 2 { 1.0 } else if reach == 3 { 1.5 } else if reach == 4 { 2.9 } else { 6.25 }
                    const expand = (reach + density) % 2 == 0
                    registry.defaults(map.PROPAGATE_COLORS, p)
                    p.*.values[0] = @floatFromInt(f64, metric)
                    p.*.values[1] = @floatFromInt(f64, if reach == 0 { map.UNBOUNDED } else { map.BOUNDED })
                    p.*.values[2] = amount
                    p.*.values[3] = @floatFromInt(f64, if expand { map.EXPAND } else { map.PRESERVE })
                    if !filtered(work, width, height) { return 191 }
                    propagatePlain(work, width, height, metric, reach != 0, amount, expand)
                    if !agrees(work, width, height) {
                        report(map.PROPAGATE_COLORS, "is not what the plain way gives")
                        return 191
                    }
                    reach += 1
                }
                metric += 1
            }
            density += 1
        }
        shape += 1
    }
    return 0
}

// Pixelize and Small Tiles the plain way: each pixel the box mean of its
// cell; each pixel of a tile the box mean of the part of the picture it
// stands for.
fn pixelizeAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var shape: usize = 0
    while shape < 5 {
        const width: usize = if shape == 4 { 70 } else { shapeWidth(shape) }
        const height: usize = if shape == 4 { 9 } else { shapeHeight(shape) }
        sample(work, width, height, if shape % 2 == 0 { MIXED } else { FEW }, @intCast(u64, shape + 40))
        var cells: usize = 0
        while cells < 8 {
            turns.turn(&work.*.loop)
            const across: usize = if cells == 0 { 1 } else if cells == 1 { 3 } else if cells == 2 { 2 } else if cells == 3 { 4 } else if cells == 4 { 64 } else if cells == 5 { 1024 } else if cells == 6 { 1024 } else { 5 }
            const down: usize = if cells == 0 { 3 } else if cells == 1 { 1 } else if cells == 2 { 2 } else if cells == 3 { 7 } else if cells == 4 { 64 } else if cells == 5 { 1024 } else if cells == 6 { 1 } else { 6 }
            registry.defaults(artistic.PIXELIZE, p)
            p.*.values[0] = @floatFromInt(f64, across)
            p.*.values[1] = @floatFromInt(f64, down)
            if !filtered(work, width, height) { return 192 }
            var y: usize = 0
            while y < height {
                const top = y / down * down
                const bottom = if top + down > height { height } else { top + down }
                var x: usize = 0
                while x < width {
                    const left = x / across * across
                    const right = if left + across > width { width } else { left + across }
                    work.*.tiled[y * width + x] = boxMean(work.*.source, width, left, right, top, bottom)
                    x += 1
                }
                y += 1
            }
            if !agrees(work, width, height) {
                report(artistic.PIXELIZE, "is not what the plain way gives")
                return 192
            }
            cells += 1
        }
        shape += 1
    }
    return 0
}

// Of `tiles` tiles over `size` pixels (tile i from i * size / tiles on),
// where the one that `at` is in begins, and where it ends.
fn tileStart(at: usize, size: usize, tiles: usize) -> usize {
    var tile: usize = 0
    while (tile + 1) * size / tiles <= at { tile += 1 }
    return tile * size / tiles
}

fn tileEnd(at: usize, size: usize, tiles: usize) -> usize {
    var tile: usize = 0
    while (tile + 1) * size / tiles <= at { tile += 1 }
    return (tile + 1) * size / tiles
}

fn smallTilesAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var shape: usize = 0
    while shape < 8 {
        const width: usize = if shape == 0 { 1 } else if shape == 1 { 5 } else if shape == 2 { 2 } else if shape == 3 { 13 } else if shape == 4 { 1 } else if shape == 5 { 9 } else if shape == 6 { 61 } else { 130 }
        const height: usize = if shape == 0 { 1 } else if shape == 1 { 3 } else if shape == 2 { 5 } else if shape == 3 { 4 } else if shape == 4 { 9 } else if shape == 5 { 1 } else if shape == 6 { 47 } else { 70 }
        sample(work, width, height, if shape % 2 == 0 { MIXED } else { FEW }, @intCast(u64, shape + 50))
        var choice: usize = 0
        while choice < 6 {
            turns.turn(&work.*.loop)
            const tiles: usize = if choice == 0 { 2 } else if choice == 1 { 3 } else if choice == 2 { 5 } else if choice == 3 { 7 } else if choice == 4 { 64 } else { 13 }
            registry.defaults(map.SMALL_TILES, p)
            p.*.values[0] = @floatFromInt(f64, tiles)
            if !filtered(work, width, height) { return 193 }
            var y: usize = 0
            while y < height {
                const tile_top = tileStart(y, height, tiles)
                const high = tileEnd(y, height, tiles) - tile_top
                const row = y - tile_top
                var x: usize = 0
                while x < width {
                    const tile_left = tileStart(x, width, tiles)
                    const wide = tileEnd(x, width, tiles) - tile_left
                    const column = x - tile_left
                    work.*.tiled[y * width + x] = boxMean(work.*.source, width, column * width / wide, (column + 1) * width / wide, row * height / high, (row + 1) * height / high)
                    x += 1
                }
                y += 1
            }
            if !agrees(work, width, height) {
                report(map.SMALL_TILES, "is not what the plain way gives")
                return 193
            }
            choice += 1
        }
        shape += 1
    }
    return 0
}

// Round Corners the plain way: each pixel tried against each corner's
// circle in turn, losing alpha to each whose square it is in as far as
// its middle is outside (radius - distance + 0.5, held in 0 to 1).
fn roundAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var shape: usize = 0
    while shape < 8 {
        const width: usize = if shape == 0 { 1 } else if shape == 1 { 1 } else if shape == 2 { 7 } else if shape == 3 { 6 } else if shape == 4 { 5 } else if shape == 5 { 40 } else if shape == 6 { 130 } else { 70 }
        const height: usize = if shape == 0 { 1 } else if shape == 1 { 7 } else if shape == 2 { 1 } else if shape == 3 { 4 } else if shape == 4 { 3 } else if shape == 5 { 30 } else if shape == 6 { 70 } else { 130 }
        sample(work, width, height, if shape % 2 == 0 { MIXED } else { OPAQUE }, @intCast(u64, shape + 60))
        var choice: usize = 0
        while choice < 9 {
            turns.turn(&work.*.loop)
            const radius: usize = if choice == 0 { 1 } else if choice == 1 { 2 } else if choice == 2 { 3 } else if choice == 3 { 5 } else if choice == 4 { 10 } else if choice == 5 { 35 } else if choice == 6 { 64 } else if choice == 7 { 100 } else { 4096 }
            registry.defaults(map.ROUND_CORNERS, p)
            p.*.values[0] = @floatFromInt(f64, radius)
            if !filtered(work, width, height) { return 195 }
            const reach = @floatFromInt(f64, radius)
            var index: usize = 0
            while index < width * height {
                const x = index % width
                const y = index / width
                var q = work.*.source[index]
                var corner: usize = 0
                while corner < 4 {
                    const cx = if corner % 2 == 0 { x } else { width - 1 - x }
                    const cy = if corner < 2 { y } else { height - 1 - y }
                    if cx < radius && cy < radius {
                        const dx = reach - (@floatFromInt(f64, cx) + 0.5)
                        const dy = reach - (@floatFromInt(f64, cy) + 0.5)
                        const inside = reach - @sqrt(dx * dx + dy * dy) + 0.5
                        if inside < 1.0 {
                            var cover: u32 = 0
                            if inside > 0.0 { cover = @intFromFloat(u32, math.round(inside * 255.0)) }
                            const a = pixel.mul(q >> 24, cover)
                            q = if a == 0 { 0 } else { (q & 0x00FFFFFF) | (a << 24) }
                        }
                    }
                    corner += 1
                }
                work.*.tiled[index] = q
                index += 1
            }
            if !agrees(work, width, height) {
                report(map.ROUND_CORNERS, "is not what the plain way gives")
                return 195
            }
            choice += 1
        }
        shape += 1
    }
    return 0
}

// A wave at `place` the plain way: amplitude times a sine (shape 0), or a
// triangle that like it starts at 0 going up (1 at a quarter, -1 at three
// quarters), of (place + shift) / wavelength. (The shape comes as the
// number: a bool made by comparing a double with a constant arrives
// wrong in a function it is handed to, a fault of the compiler.)
fn waveAt(place: usize, length: usize, shift: usize, amplitude: f64, shape: f64) -> f64 {
    const part = @floatFromInt(f64, (place + shift) % length) / @floatFromInt(f64, length)
    if shape == 0.0 { return amplitude * math.sin(part * 2.0 * math.pi) }
    if part < 0.25 { return amplitude * 4.0 * part }
    if part < 0.75 { return amplitude * (2.0 - 4.0 * part) }
    return amplitude * (4.0 * part - 4.0)
}

// Wave the plain way: the picture at (x + h(y), y + v(x)), the four
// pixels around it (the edge standing in beyond it) each at its share in
// 256ths of a pixel times its alpha.
fn wavePlain(work: *Work, width: usize, height: usize) -> void {
    const p = &work.*.params
    const source = work.*.source
    var y: usize = 0
    while y < height {
        const sideways = waveAt(y, @intFromFloat(usize, p.*.values[0]), @intFromFloat(usize, p.*.values[1]), p.*.values[2], p.*.values[3])
        var step_x = @intFromFloat(i64, @floor(sideways))
        var wx = @intFromFloat(u64, math.round((sideways - @floor(sideways)) * 256.0))
        if wx == 256 {
            step_x += 1
            wx = 0
        }
        var x: usize = 0
        while x < width {
            const upright = waveAt(x, @intFromFloat(usize, p.*.values[4]), @intFromFloat(usize, p.*.values[5]), p.*.values[6], p.*.values[7])
            var step_y = @intFromFloat(i64, @floor(upright))
            var wy = @intFromFloat(u64, math.round((upright - @floor(upright)) * 256.0))
            if wy == 256 {
                step_y += 1
                wy = 0
            }
            var corner: usize = 0
            var alpha: u64 = 0
            var red: u64 = 0
            var green: u64 = 0
            var blue: u64 = 0
            while corner < 4 {
                var from_x = @intCast(i64, x) + step_x + @intCast(i64, corner % 2)
                var from_y = @intCast(i64, y) + step_y + @intCast(i64, corner / 2)
                if from_x < 0 { from_x = 0 }
                if from_x >= @intCast(i64, width) { from_x = @intCast(i64, width) - 1 }
                if from_y < 0 { from_y = 0 }
                if from_y >= @intCast(i64, height) { from_y = @intCast(i64, height) - 1 }
                const q = source[@intCast(usize, from_y) * width + @intCast(usize, from_x)]
                const share = (if corner % 2 == 0 { 256 - wx } else { wx }) * (if corner < 2 { 256 - wy } else { wy })
                const weight = @intCast(u64, q >> 24) * share
                alpha += weight
                red += @intCast(u64, (q >> 16) & 255) * weight
                green += @intCast(u64, (q >> 8) & 255) * weight
                blue += @intCast(u64, q & 255) * weight
                corner += 1
            }
            var expected: u32 = 0
            const a = (alpha + 32768) >> 16
            if a != 0 {
                expected = (@intCast(u32, a) << 24) | (@intCast(u32, (red + alpha / 2) / alpha) << 16) | (@intCast(u32, (green + alpha / 2) / alpha) << 8) | @intCast(u32, (blue + alpha / 2) / alpha)
            }
            work.*.tiled[y * width + x] = expected
            x += 1
        }
        y += 1
    }
}

fn waveAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var shape: usize = 0
    while shape < 4 {
        const width: usize = if shape == 0 { 1 } else if shape == 1 { 9 } else { 61 }
        const height: usize = if shape == 0 { 9 } else if shape == 1 { 1 } else { 47 }
        sample(work, width, height, if shape == 3 { OPAQUE } else { MIXED }, @intCast(u64, shape + 70))
        var choice: usize = 0
        while choice < 6 {
            turns.turn(&work.*.loop)
            registry.defaults(other.WAVE, p)
            if choice == 0 {
                p.*.values[0] = 1.0
                p.*.values[2] = 100.0
                p.*.values[4] = 3.0
                p.*.values[6] = 100.0
                p.*.values[7] = 1.0
            } else if choice == 1 {
                p.*.values[0] = 7.0
                p.*.values[1] = 3.0
                p.*.values[2] = 3.0
                p.*.values[3] = 1.0
                p.*.values[6] = 0.0
            } else if choice == 2 {
                p.*.values[0] = 1000.0
                p.*.values[1] = 999.0
                p.*.values[2] = 50.0
                p.*.values[4] = 13.0
                p.*.values[5] = 1000.0
                p.*.values[6] = 1.0
            } else if choice == 3 {
                p.*.values[0] = 37.0
                p.*.values[1] = 400.0
                p.*.values[2] = 23.0
                p.*.values[3] = 1.0
                p.*.values[4] = 91.0
                p.*.values[5] = 5.0
                p.*.values[6] = 9.0
            } else if choice == 4 {
                p.*.values[2] = 0.0
                p.*.values[4] = 12.0
                p.*.values[6] = 7.0
                p.*.values[7] = 1.0
            }
            if !filtered(work, width, height) { return 196 }
            wavePlain(work, width, height)
            if !agrees(work, width, height) {
                report(other.WAVE, "is not what the plain way gives")
                return 196
            }
            choice += 1
        }
        shape += 1
    }
    return 0
}

// Posterize the plain way: each channel value v to the nearest of the
// steps k * 255 / (steps - 1), that rounded (a half up); for every value
// and every number of steps.
fn posterizeAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var index: usize = 0
    while index < 256 {
        const v = @intCast(u32, index)
        work.*.source[index] = (v << 24) | (v << 16) | ((255 - v) << 8) | (v / 2)
        index += 1
    }
    var steps: usize = 2
    while steps <= 255 {
        turns.turn(&work.*.loop)
        registry.defaults(artistic.POSTERIZE, p)
        p.*.values[0] = @floatFromInt(f64, steps)
        if !filtered(work, 256, 1) { return 197 }
        const last = @floatFromInt(f64, steps - 1)
        index = 0
        while index < 256 {
            const q = work.*.source[index]
            var expected = q & 0xFF000000
            var shift: u32 = 0
            while shift < 24 {
                const channel = @floatFromInt(f64, (q >> shift) & 255)
                const k = @floor(channel * last / 255.0 + 0.5)
                expected |= @intFromFloat(u32, @floor(k * 255.0 / last + 0.5)) << shift
                shift += 8
            }
            if work.*.whole[index] != expected {
                report(artistic.POSTERIZE, "is not what the plain way gives")
                return 197
            }
            index += 1
        }
        steps += 1
    }
    return 0
}

// Phong Bumpmap the plain way, in doubles and without short ways: the
// normal from the heights around (or the normal map), each light's
// direction and half way, Blinn-Phong, the sum held in 0 to 1. To a
// step of rounding.
fn phongPlain(work: *Work, width: usize, height: usize) -> bool {
    const p = &work.*.params
    const source = work.*.source
    const channel = @intFromFloat(u32, p.*.values[0])
    var index: usize = 0
    while index < width * height {
        const x = index % width
        const y = index / width
        const q = source[index]
        const got = work.*.whole[index]
        if q >> 24 == 0 {
            if got != 0 { return false }
        } else {
            var nx: f64 = 0.0
            var ny: f64 = 0.0
            var nz: f64 = 8.0
            if p.*.values[1] != 0.0 {
                nx = @floatFromInt(f64, (q >> 16) & 255) / 127.5 - 1.0
                ny = @floatFromInt(f64, (q >> 8) & 255) / 127.5 - 1.0
                nz = @floatFromInt(f64, q & 255) / 127.5 - 1.0
            } else {
                var around: [4]f64 = [4]f64{ 0.0, 0.0, 0.0, 0.0 }
                var side: usize = 0
                while side < 4 {
                    var at_x = x
                    var at_y = y
                    if side == 0 && x > 0 { at_x = x - 1 }
                    if side == 1 && x + 1 < width { at_x = x + 1 }
                    if side == 2 && y > 0 { at_y = y - 1 }
                    if side == 3 && y + 1 < height { at_y = y + 1 }
                    const r = source[at_y * width + at_x]
                    var level = r >> 24
                    if channel == 0 { level = pixel.mul(r >> 24, pixel.luma(r)) }
                    if channel == 1 { level = pixel.mul(r >> 24, (r >> 16) & 255) }
                    if channel == 2 { level = pixel.mul(r >> 24, (r >> 8) & 255) }
                    if channel == 3 { level = pixel.mul(r >> 24, r & 255) }
                    around[side] = @floatFromInt(f64, level)
                    side += 1
                }
                // x to the right, y up: the normal leans away from what
                // is higher.
                nx = around[0] - around[1]
                ny = around[3] - around[2]
            }
            const length = @sqrt(nx * nx + ny * ny + nz * nz)
            nx = nx / length
            ny = ny / length
            nz = nz / length
            var light: [3]f64 = [3]f64{ p.*.values[2], p.*.values[2], p.*.values[2] }
            var lamp: usize = 0
            while lamp < 4 {
                const first = 6 + lamp * 4
                if p.*.values[first] != 0.0 {
                    const color = @intFromFloat(u32, p.*.values[first + 1])
                    const azimuth = p.*.values[first + 2] * math.pi / 180.0
                    const inclination = p.*.values[first + 3] * math.pi / 180.0
                    const lx = math.cos(azimuth) * math.cos(inclination)
                    const ly = math.sin(azimuth) * math.cos(inclination)
                    const lz = math.sin(inclination)
                    const facing = nx * lx + ny * ly + nz * lz
                    if facing > 0.0 {
                        const half_length = @sqrt(lx * lx + ly * ly + (lz + 1.0) * (lz + 1.0))
                        const glint = (nx * lx + ny * ly + nz * (lz + 1.0)) / half_length
                        var lit = p.*.values[3] * facing
                        if glint > 0.0 { lit += p.*.values[4] * math.pow(glint, p.*.values[5]) }
                        var part: usize = 0
                        while part < 3 {
                            light[part] += @floatFromInt(f64, (color >> @intCast(u32, 16 - part * 8)) & 255) / 255.0 * lit
                            part += 1
                        }
                    }
                }
                lamp += 1
            }
            if got >> 24 != q >> 24 { return false }
            var part: usize = 0
            while part < 3 {
                var share = light[part]
                if share < 0.0 { share = 0.0 }
                if share > 1.0 { share = 1.0 }
                const wanted = @intFromFloat(i32, share * 255.0 + 0.5)
                const shown = @intCast(i32, (got >> @intCast(u32, 16 - part * 8)) & 255)
                if wanted - shown > 1 || shown - wanted > 1 { return false }
                part += 1
            }
        }
        index += 1
    }
    return true
}

fn phongAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var round: usize = 0
    while round < 24 {
        turns.turn(&work.*.loop)
        const width: usize = if round % 4 == 0 { 1 } else if round % 4 == 1 { 23 } else { 37 }
        const height: usize = if round % 4 == 1 { 1 } else { 29 }
        sample(work, width, height, if round % 3 == 0 { FEW } else if round % 3 == 1 { MIXED } else { OPAQUE }, @intCast(u64, round + 80))
        registry.defaults(map.PHONG_BUMPMAP, p)
        const bits = dice(@intCast(u64, round) +% 4242)
        p.*.values[0] = @floatFromInt(f64, bits % 5)
        p.*.values[1] = if round % 5 == 4 { 1.0 } else { 0.0 }
        p.*.values[2] = @floatFromInt(f64, (bits >> 8) & 255) / 512.0
        p.*.values[3] = @floatFromInt(f64, (bits >> 16) & 255) / 255.0
        p.*.values[4] = @floatFromInt(f64, (bits >> 24) & 255) / 255.0
        p.*.values[5] = @floatFromInt(f64, 1 + (bits >> 32) % 200)
        var lamp: usize = 0
        while lamp < 4 {
            const more = dice(bits +% lamp)
            const first = 6 + lamp * 4
            p.*.values[first] = if lamp == 0 || more & 1 != 0 { 1.0 } else { 0.0 }
            p.*.values[first + 1] = @floatFromInt(f64, (more >> 8) & 0xFFFFFFFF)
            p.*.values[first + 2] = @floatFromInt(f64, (more >> 40) % 361)
            p.*.values[first + 3] = @floatFromInt(f64, (more >> 50) % 91)
            lamp += 1
        }
        if !filtered(work, width, height) { return 198 }
        if !phongPlain(work, width, height) {
            report(map.PHONG_BUMPMAP, "is not what the plain way gives")
            return 198
        }
        round += 1
    }
    return 0
}

// Two channels a step of rounding apart at most.
fn near(a: u32, b: u32) -> bool {
    return a <= b + 1 && b <= a + 1
}

// Normalize the plain way, in doubles: (r, g, b) / 127.5 - 1 made one
// long and turned back into channels; alpha stays, the unseen stay as
// they were. To a step of rounding.
fn normalizeAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var kind: u32 = OPAQUE
    while kind <= FEW {
        turns.turn(&work.*.loop)
        sample(work, 61, 47, kind, @intCast(u64, kind) + 100)
        registry.defaults(map.NORMALIZE, p)
        if !filtered(work, 61, 47) { return 204 }
        var index: usize = 0
        while index < 61 * 47 {
            const q = work.*.source[index]
            const got = work.*.whole[index]
            if q >> 24 == 0 {
                if got != q { return 204 }
            } else {
                if got >> 24 != q >> 24 { return 204 }
                const x = @floatFromInt(f64, (q >> 16) & 255) / 127.5 - 1.0
                const y = @floatFromInt(f64, (q >> 8) & 255) / 127.5 - 1.0
                const z = @floatFromInt(f64, q & 255) / 127.5 - 1.0
                const length = @sqrt(x * x + y * y + z * z)
                const r = @intFromFloat(u32, (x / length + 1.0) * 127.5 + 0.5)
                const g = @intFromFloat(u32, (y / length + 1.0) * 127.5 + 0.5)
                const b = @intFromFloat(u32, (z / length + 1.0) * 127.5 + 0.5)
                if !near(r, (got >> 16) & 255) || !near(g, (got >> 8) & 255) || !near(b, got & 255) {
                    report(map.NORMALIZE, "is not what the plain way gives")
                    return 204
                }
            }
            index += 1
        }
        kind += 1
    }
    return 0
}

// Color to Alpha the plain way, in doubles: what is left of a pixel is its
// distance from the colour (the largest of the three channels' differences)
// over the threshold, held at 1; its alpha times that, its colour moved
// away from the colour by one over that (held in 0 to 255); nothing left
// is 0. To a step of rounding.
fn colorToAlphaAgain(work: *Work) -> u8 {
    const p = &work.*.params
    var round: usize = 0
    while round < 12 {
        turns.turn(&work.*.loop)
        sample(work, 61, 47, if round % 3 == 0 { OPAQUE } else if round % 3 == 1 { MIXED } else { FEW }, @intCast(u64, round) + 110)
        const bits = dice(@intCast(u64, round) +% 999)
        const taken = @intCast(u32, bits & 0xFFFFFFFF)
        const threshold = 1 + @intCast(u32, (bits >> 32) % 255)
        registry.defaults(other.COLOR_TO_ALPHA, p)
        p.*.values[0] = @floatFromInt(f64, taken)
        p.*.values[1] = @floatFromInt(f64, threshold)
        if !filtered(work, 61, 47) { return 205 }
        var index: usize = 0
        while index < 61 * 47 {
            const q = work.*.source[index]
            const got = work.*.whole[index]
            var far: u32 = 0
            var shift: u32 = 0
            while shift < 24 {
                const c = (q >> shift) & 255
                const t = (taken >> shift) & 255
                const apart = if c > t { c - t } else { t - c }
                if apart > far { far = apart }
                shift += 8
            }
            if q >> 24 == 0 || far >= threshold {
                if got != q { return 205 }
            } else {
                const left = @floatFromInt(f64, far) / @floatFromInt(f64, threshold)
                const alpha = @floatFromInt(f64, q >> 24) * left
                if got == 0 {
                    if alpha >= 1.5 { return 206 }
                } else {
                    if !near(@intFromFloat(u32, alpha + 0.5), got >> 24) { return 206 }
                    shift = 0
                    while shift < 24 {
                        const c = @floatFromInt(f64, (q >> shift) & 255)
                        const t = @floatFromInt(f64, (taken >> shift) & 255)
                        var moved = t + (c - t) / left
                        if moved < 0.0 { moved = 0.0 }
                        if moved > 255.0 { moved = 255.0 }
                        if !near(@intFromFloat(u32, moved + 0.5), (got >> shift) & 255) {
                            report(other.COLOR_TO_ALPHA, "is not what the plain way gives")
                            return 207
                        }
                        shift += 8
                    }
                }
            }
            index += 1
        }
        round += 1
    }
    return 0
}

// Halftone's grid is square and its dots round: turned by a quarter, a
// half, three quarters or a whole turn it is the grid at angle 0 again,
// pixel for pixel. And Invert is the two colours swapped.
fn halftoneTurns(work: *Work) -> u8 {
    const p = &work.*.params
    sample(work, 61, 47, MIXED, 90)
    var choice: usize = 0
    while choice < 6 {
        turns.turn(&work.*.loop)
        registry.defaults(artistic.HALFTONE, p)
        p.*.values[0] = if choice < 2 { 8.0 } else if choice < 4 { 5.0 } else { 2.0 }
        p.*.values[3] = if choice % 2 == 0 { 1.0 } else { 0.0 }
        p.*.values[4] = 4294901760.0
        p.*.values[5] = 2164195583.0
        p.*.values[1] = 0.0
        if !filtered(work, 61, 47) { return 199 }
        copy(work.*.tiled, 61, work.*.whole, 61, 61, 47)
        var angle: usize = 1
        while angle <= 4 {
            p.*.values[1] = @floatFromInt(f64, angle * 90)
            if !filtered(work, 61, 47) { return 199 }
            if !agrees(work, 61, 47) {
                report(artistic.HALFTONE, "turned by quarters is not the grid at angle 0")
                return 199
            }
            angle += 1
        }
        p.*.values[1] = 30.0
        if !filtered(work, 61, 47) { return 200 }
        copy(work.*.tiled, 61, work.*.whole, 61, 61, 47)
        p.*.values[2] = 1.0
        p.*.values[4] = 2164195583.0
        p.*.values[5] = 4294901760.0
        if !filtered(work, 61, 47) || !agrees(work, 61, 47) { return 200 }
        choice += 1
    }
    return 0
}

// ---- The same thing twice ----

// A filter keeps nothing from one run to the next that changes the
// pixels: a picture filtered, then another one of other sizes and kinds,
// then the first again comes out the same both times.
fn again(work: *Work) -> u8 {
    var index: usize = 0
    while index < FILTERS {
        turns.turn(&work.*.loop)
        var which: usize = 0
        while which < 3 {
            setting(work, IDS[index], which)
            fill(work.*.tiled, ODD_WIDE, ODD_HIGH, ODD_WIDE, MIXED, 3)
            if !registry.apply(&work.*.params, work.*.tiled, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 203 }
            fill(work.*.whole, 61, 47, 64, OPAQUE, 4)
            if !registry.apply(&work.*.params, work.*.whole, 61, 47, 64) { return 203 }
            fill(work.*.whole, ODD_WIDE, ODD_HIGH, ODD_WIDE, MIXED, 3)
            if !registry.apply(&work.*.params, work.*.whole, ODD_WIDE, ODD_HIGH, ODD_WIDE) { return 203 }
            if differing(work.*.whole, ODD_WIDE, work.*.tiled, ODD_WIDE, ODD_WIDE, ODD_HIGH) != 0 {
                report(IDS[index], "gives other pixels the second time")
                return 203
            }
            which += 1
        }
        index += 1
    }
    return 0
}

// ---- Heap and arena at every end ----

// The settings each filter is run at here: as it starts, every number at
// its low end, every number at its high end.
fn setting(work: *Work, id: u16, which: usize) -> void {
    registry.defaults(id, &work.*.params)
    if which == 0 { return }
    const info = registry.find(id).?
    var at: usize = 0
    while at < info.*.params.length {
        work.*.params.values[at] = if which == 1 { info.*.params[at].low } else { info.*.params[at].high }
        at += 1
    }
}

// What a filter takes from the heap it gives back, and from the value
// arena it takes nothing, also at the ends of its ranges and on pictures
// of every kind: after one round to warm the scratch pool up, twenty more
// leave std.heap's live bytes as they were and the arena where it was.
fn kept(work: *Work) -> u8 {
    const base = turns.locate()
    var index: usize = 0
    while index < FILTERS {
        var which: usize = 0
        while which < 3 {
            turns.turn(&work.*.loop)
            var live: usize = 0
            var used: usize = 0
            var round: usize = 0
            while round < 21 {
                if round == 1 {
                    live = std.heap.liveBytes()
                    used = turns.used(base)
                }
                setting(work, IDS[index], which)
                fill(work.*.whole, ODD_WIDE, ODD_HIGH, ODD_WIDE + PAD, @intCast(u32, round % 3), 47)
                if !registry.apply(&work.*.params, work.*.whole, ODD_WIDE, ODD_HIGH, ODD_WIDE + PAD) { return 201 }
                _ = registry.margin(&work.*.params)
                round += 1
            }
            if std.heap.liveBytes() != live {
                report(IDS[index], "keeps heap memory it took")
                return 201
            }
            if turns.used(base) - used > 1024 {
                report(IDS[index], "takes memory from the value arena at an end of its ranges")
                return 202
            }
            which += 1
        }
        index += 1
    }
    return 0
}

// ---- Speed ----

fn speed(work: *Work, id: u16, name: []const u8, opaque: bool) -> void {
    if opaque {
        // Something like a photograph: soft slopes with a little grain.
        var y: usize = 0
        while y < FAST_HIGH {
            var x: usize = 0
            while x < FAST_WIDE {
                const grain = @intCast(u32, dice(y *% 65536 +% x) & 3)
                work.*.fast[y * FAST_WIDE + x] = 0xFF000000 | ((@intCast(u32, x / 9) & 255) << 16) | ((@intCast(u32, y / 7) & 255) << 8) | ((@intCast(u32, (x + y) / 11) & 252) + grain)
                x += 1
            }
            y += 1
        }
    } else {
        picture(work.*.fast, FAST_WIDE, FAST_HIGH, FAST_WIDE, 3)
    }
    registry.defaults(id, &work.*.params)
    const started = std.time.monotonicNanoseconds()
    _ = registry.apply(&work.*.params, work.*.fast, FAST_WIDE, FAST_HIGH, FAST_WIDE)
    var took = (std.time.monotonicNanoseconds() - started) / 1000
    if took == 0 { took = 1 }
    // Megapixels a second in tenths: pixels per microsecond times ten.
    const tenths = FAST_WIDE * FAST_HIGH * 10 / took
    _ = std.io.print(name)
    _ = std.io.print(if opaque { " (opaque picture): " } else { " (layer with every alpha): " })
    _ = std.io.writeUnsigned(std.io.stdout(), tenths / 10)
    _ = std.io.print(".")
    _ = std.io.writeUnsigned(std.io.stdout(), tenths % 10)
    _ = std.io.println(" megapixels a second")
}

fn words(count: usize) -> ?[*]u32 {
    const memory = std.heap.allocator().alloc(count * 4, 16)
    if memory == null { return null }
    unsafe { return @ptrCast([*]u32, memory.?) }
}

pub fn main() -> u8 {
    _ = crash.install()
    const memory = std.heap.allocator().alloc(@sizeOf(Work), 16)
    if memory == null { return 1 }
    const work: *Work = unsafe { @ptrCast(*Work, memory.?) }
    const source = words(WIDE * HIGH)
    const whole = words(WIDE * HIGH)
    const tiled = words(WIDE * HIGH)
    const piece = words(WIDE * HIGH)
    const fast = words(FAST_WIDE * FAST_HIGH)
    if source == null || whole == null || tiled == null || piece == null || fast == null { return 1 }
    work.*.source = source.?
    work.*.whole = whole.?
    work.*.tiled = tiled.?
    work.*.piece = piece.?
    work.*.fast = fast.?
    work.*.pool = scratch.common()
    turns.begin(&work.*.loop, true, false)

    var failed = wiring(work)
    if failed != 0 { return failed }

    var index: usize = 0
    while index < FILTERS {
        turns.turn(&work.*.loop)
        failed = extremes(work, index)
        if failed != 0 { return failed }
        index += 1
    }
    turns.turn(&work.*.loop)

    failed = neutral(work)
    if failed != 0 { return failed }
    failed = posterizeExact(work)
    if failed != 0 { return failed }
    failed = channelsExact(work)
    if failed != 0 { return failed }
    failed = colorToAlphaExact(work)
    if failed != 0 { return failed }
    failed = pixelizeExact(work)
    if failed != 0 { return failed }
    failed = smallTilesExact(work)
    if failed != 0 { return failed }
    failed = roundCornersExact(work)
    if failed != 0 { return failed }
    failed = propagateExact(work)
    if failed != 0 { return failed }
    failed = oilpaintExact(work)
    if failed != 0 { return failed }
    failed = waveExact(work)
    if failed != 0 { return failed }
    failed = normalizeExact(work)
    if failed != 0 { return failed }
    failed = phongExact(work)
    if failed != 0 { return failed }
    failed = halftoneExact(work)
    if failed != 0 { return failed }
    failed = raindropsExact(work)
    if failed != 0 { return failed }
    failed = diceExact(work)
    if failed != 0 { return failed }
    turns.turn(&work.*.loop)
    failed = bleeding(work)
    if failed != 0 { return failed }
    turns.turn(&work.*.loop)
    failed = blocks(work)
    if failed != 0 { return failed }
    failed = seeds(work)
    if failed != 0 { return failed }
    failed = arena(work)
    if failed != 0 { return failed }
    failed = oilpaintAgain(work)
    if failed != 0 { return failed }
    failed = propagateAgain(work)
    if failed != 0 { return failed }
    failed = pixelizeAgain(work)
    if failed != 0 { return failed }
    failed = smallTilesAgain(work)
    if failed != 0 { return failed }
    failed = roundAgain(work)
    if failed != 0 { return failed }
    failed = waveAgain(work)
    if failed != 0 { return failed }
    failed = posterizeAgain(work)
    if failed != 0 { return failed }
    failed = phongAgain(work)
    if failed != 0 { return failed }
    failed = halftoneTurns(work)
    if failed != 0 { return failed }
    failed = normalizeAgain(work)
    if failed != 0 { return failed }
    failed = colorToAlphaAgain(work)
    if failed != 0 { return failed }
    failed = again(work)
    if failed != 0 { return failed }
    failed = kept(work)
    if failed != 0 { return failed }

    speed(work, artistic.OILPAINT, "Oilpaint", true)
    speed(work, artistic.OILPAINT, "Oilpaint", false)
    speed(work, artistic.PIXELIZE, "Pixelize", false)
    speed(work, artistic.RAINDROPS, "Raindrops", false)
    speed(work, artistic.HALFTONE, "Halftone", true)
    speed(work, artistic.POSTERIZE, "Posterize", true)
    speed(work, map.SMALL_TILES, "Small Tiles", false)
    speed(work, map.PHONG_BUMPMAP, "Phong Bumpmap", true)
    speed(work, map.NORMALIZE, "Normalize", true)
    speed(work, map.PROPAGATE_COLORS, "Propagate Colors", false)
    speed(work, other.RANDOM_NOISE, "Random Noise", true)
    speed(work, other.RANDOM_PICK, "Random Pick", false)
    speed(work, other.WAVE, "Wave", true)
    speed(work, other.WAVE, "Wave", false)
    speed(work, other.COLOR_TO_ALPHA, "Color to Alpha", true)
    return 13
}
