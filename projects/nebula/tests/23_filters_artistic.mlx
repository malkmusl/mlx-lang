// nebula's Artistic, Colors, Map and Other filters (being written).
const std = @import("std")
const crash = @import("std.crash")
const registry = @import("../filters/registry.mlx")
const artistic = @import("../filters/artistic.mlx")

pub fn main() -> u8 {
    _ = crash.install()
    var params: registry.Params = undefined
    registry.defaults(artistic.OILPAINT, &params)
    const allocator = std.heap.allocator()
    const width: usize = 4000
    const height: usize = 3000
    const memory = allocator.alloc(width * height * 4, 16)
    if memory == null { return 1 }
    const pixels: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    var index: usize = 0
    var state: u64 = 1
    while index < width * height {
        state = state *% 6364136223846793005 +% 1442695040888963407
        const px = @intCast(u32, index % width)
        const py = @intCast(u32, index / width)
        pixels[index] = 0xFF000000 | (((px / 16) & 255) << 16) | (((py / 12) & 255) << 8) | (((px + py) / 40) & 255)
        index += 1
    }
    var id: u16 = 250
    while id < 400 {
        if registry.find(id) == null {
            id += 1
            continue
        }
        registry.defaults(id, &params)
        const start = std.time.milliseconds()
        if !registry.apply(&params, pixels, width, height, width) { return 2 }
        const took = std.time.milliseconds() - start
        _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, id))
        _ = std.io.print(": ")
        _ = std.io.writeUnsigned(std.io.stdout(), took)
        _ = std.io.println(" ms")
        id += 1
    }
    return 13
}
