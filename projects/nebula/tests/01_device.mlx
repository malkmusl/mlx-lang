// nebula's Device: pixels by place and by rectangle across tile borders
// and negative coordinates, the default where nothing was written, copies
// that share their tiles until written, a device moved, changes undone
// and redone (begin, commit, apply, rollback), tiles that became blank
// dropped, bounds. Exits 13.
const std = @import("std")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")

const RED: u32 = 0xFFFF0000
const GREEN: u32 = 0xFF00FF00
const BLUE: u32 = 0x800000FF

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const made = device.create(allocator, 0)
    if made == null { return 1 }
    const layer = made.?

    // Nothing written: the default everywhere, no tiles, no bounds.
    if device.pixel(layer, 5, 7) != 0 || device.pixel(layer, -900, 12345) != 0 { return 2 }
    if device.tileCount(layer) != 0 || !geom.isEmpty(device.extent(layer)) || !device.isBlank(layer) { return 3 }

    // Single pixels, also left of and above the origin.
    device.setPixel(layer, 3, 4, RED)
    device.setPixel(layer, -1, -1, GREEN)
    device.setPixel(layer, 64, 63, BLUE)
    if device.pixel(layer, 3, 4) != RED || device.pixel(layer, -1, -1) != GREEN || device.pixel(layer, 64, 63) != BLUE { return 4 }
    if device.pixel(layer, 4, 4) != 0 || device.pixel(layer, 63, 63) != 0 { return 5 }
    if device.tileCount(layer) != 3 { return 6 }
    const bounds = device.exactBounds(layer)
    if bounds.x != -1 || bounds.y != -1 || bounds.width != 66 || bounds.height != 65 { return 7 }
    const around = device.extent(layer)
    if around.x != -64 || around.y != -64 || around.width != 192 || around.height != 128 { return 8 }

    // A rectangle across four tiles, written and read back.
    var buffer: [400]u32 = undefined
    var back: [400]u32 = undefined
    var index: usize = 0
    while index < 400 {
        buffer[index] = 0xFF000000 | @intCast(u32, index)
        back[index] = 1
        index += 1
    }
    const area = geom.rect(54, 120, 20, 20)
    if !device.writeRect(layer, area, &buffer, 20) { return 9 }
    device.readRect(layer, area, &back, 20)
    index = 0
    while index < 400 {
        if back[index] != buffer[index] { return 10 }
        index += 1
    }
    if device.pixel(layer, 54, 120) != 0xFF000000 || device.pixel(layer, 73, 139) != 0xFF00018F { return 11 }
    // Reading past what was written gives the default around it.
    device.readRect(layer, geom.rect(53, 119, 20, 20), &back, 20)
    if back[0] != 0 || back[19] != 0 || back[20] != 0 || back[21] != 0xFF000000 { return 12 }

    // A copy shares the tiles; writing one leaves the other.
    const copied = device.copy(layer)
    if copied == null { return 13 - 1 }
    const twin = copied.?
    if device.pixel(twin, 3, 4) != RED || device.tileCount(twin) != device.tileCount(layer) { return 14 }
    device.setPixel(twin, 3, 4, GREEN)
    if device.pixel(layer, 3, 4) != RED || device.pixel(twin, 3, 4) != GREEN { return 15 }
    device.setPixel(layer, 3, 5, BLUE)
    if device.pixel(twin, 3, 5) != 0 { return 16 }
    device.destroy(twin)
    if device.pixel(layer, 3, 4) != RED || device.pixel(layer, 3, 5) != BLUE { return 17 }

    // A change, undone and redone.
    device.begin(layer)
    device.setPixel(layer, 3, 4, GREEN)
    _ = device.fill(layer, geom.rect(200, 200, 10, 10), RED)
    const pending = device.pendingArea(layer)
    if pending.x != 0 || pending.y != 0 || pending.width != 256 || pending.height != 256 { return 18 }
    const change = device.commit(layer)
    if change == null { return 19 }
    if change.?.*.count != 2 { return 20 }
    if device.pixel(layer, 3, 4) != GREEN || device.pixel(layer, 205, 205) != RED { return 21 }
    const undone = device.apply(layer, change.?, true)
    if device.pixel(layer, 3, 4) != RED || device.pixel(layer, 205, 205) != 0 || device.pixel(layer, 3, 5) != BLUE { return 22 }
    if undone.x != 0 || undone.y != 0 || undone.width != 256 || undone.height != 256 { return 23 }
    _ = device.apply(layer, change.?, false)
    if device.pixel(layer, 3, 4) != GREEN || device.pixel(layer, 205, 205) != RED { return 24 }
    _ = device.apply(layer, change.?, true)
    device.destroyChange(change.?)
    if device.pixel(layer, 3, 4) != RED || device.pixel(layer, 205, 205) != 0 { return 25 }

    // A change that changes nothing is none; one given up puts all back.
    device.begin(layer)
    if device.commit(layer) != null { return 26 }
    device.begin(layer)
    device.setPixel(layer, 1000, 1000, RED)
    device.setPixel(layer, 3, 4, BLUE)
    device.moveBy(layer, 7, 0)
    const reverted = device.rollback(layer)
    if geom.isEmpty(reverted) { return 27 }
    if device.pixel(layer, 3, 4) != RED || device.pixel(layer, 1000, 1000) != 0 || layer.*.x != 0 { return 28 }

    // Erasing a whole tile's content drops the tile at commit.
    const tiles = device.tileCount(layer)
    device.begin(layer)
    device.setPixel(layer, -1, -1, 0)
    const erased = device.commit(layer)
    if erased == null { return 29 }
    if device.tileCount(layer) != tiles - 1 { return 30 }
    _ = device.apply(layer, erased.?, true)
    if device.pixel(layer, -1, -1) != GREEN || device.tileCount(layer) != tiles { return 31 }
    device.destroyChange(erased.?)

    // Moved: the same pixels elsewhere, and the move undone.
    device.begin(layer)
    device.moveBy(layer, 100, -50)
    const move = device.commit(layer)
    if move == null { return 32 }
    if device.pixel(layer, 103, -46) != RED || device.pixel(layer, 3, 4) != 0 { return 33 }
    device.setPixel(layer, 0, 0, BLUE)
    if device.pixel(layer, 0, 0) != BLUE { return 34 }
    device.setPixel(layer, 0, 0, 0)
    _ = device.apply(layer, move.?, true)
    if device.pixel(layer, 3, 4) != RED { return 35 }
    device.destroyChange(move.?)

    // Filled and cleared by rectangle.
    if !device.fill(layer, geom.rect(-10, -10, 148, 148), BLUE) { return 36 }
    if device.pixel(layer, -10, -10) != BLUE || device.pixel(layer, 137, 137) != BLUE || device.pixel(layer, 138, 137) != 0 || device.pixel(layer, 3, 4) != BLUE { return 37 }
    device.clearRect(layer, geom.rect(0, 0, 64, 64))
    if device.pixel(layer, 0, 0) != 0 || device.pixel(layer, 63, 63) != 0 || device.pixel(layer, 64, 64) != BLUE || device.pixel(layer, -1, 0) != BLUE { return 38 }
    device.clear(layer)
    if device.tileCount(layer) != 0 || device.pixel(layer, 64, 64) != 0 { return 39 }

    // A mask's plane: an opaque default.
    const plane = device.create(allocator, 0xFF000000)
    if plane == null { return 40 }
    if device.pixel(plane.?, 9, 9) != 0xFF000000 { return 41 }
    device.setPixel(plane.?, 9, 9, 0xFFFFFFFF)
    const lit = device.exactBounds(plane.?)
    if lit.x != 9 || lit.y != 9 || lit.width != 1 || lit.height != 1 { return 42 }
    device.destroy(plane.?)
    device.destroy(layer)
    return 13
}
