// The File and Edit menus' actions (actions/file.mlx, actions/edit.mlx,
// app/clipboard.mlx, app/autosave.mlx) in nebula without a window, played
// with scripts as a person would, in a home, state and configuration
// folder of the test's own under the current directory. Checked: File >
// New shows its dialog and Enter makes the image it proposes; a document
// without changes closes without a question; Save As through the file
// dialog (a path typed, Enter) writes a PNG std.png reads back with the
// right pixels, the document is then unchanged and named after the file,
// the file first among the recent ones and in the Open Recent submenu;
// Save As offers the layered format first when one can be written (and
// then keeps two layers through saving and opening), PNG first while none
// can; a change and Close ask Save / Discard / Cancel: Escape keeps the
// document, Discard closes it; Open (a path typed) gives the pixels back,
// opening it again shows the one open; Save writes it again without
// asking; Export writes a JPEG and leaves the document's name and its
// changed state alone; Save Incremental Version makes NAME_001, then
// NAME_002; Revert reads the file again. Edit: a red 10 x 10 square across
// a tile border cut leaves transparency, the clipboard keeps its place and
// the system's clipboard gets a PNG; Paste makes a new layer with it at
// the same place and deselects, one undo step for both; Paste into New
// Image makes a 10 x 10 document; Copy Merged takes what all layers show;
// a picture another program put on the clipboard goes into the middle of
// the view, and so does one that does not fit the image; one pixel is
// copied, nothing (the clipboard keeps what it had), only what is in the
// image of a layer that reaches into negative places; Paste into Active
// Layer mixes it in; Clear and the fills with a selection change only the
// selection; Fill with Pattern; Stroke Selection inside, centred and
// outside, with its mitred corners; each of these one undo step; undo and
// redo by their actions. Autosave: nothing before the interval, the file
// after it, its name beside it, Save removing it; autosaves left by an
// earlier run offered and opened again as changed documents. Document
// Information shows its rows. Quit with a changed document asks; Cancel
// keeps running, Discard quits. The value arena does not grow while
// dialogs are drawn. Pictures of the dialogs in both languages and both
// themes are written to the current directory and, when NEBULA_SHOTS names
// a folder, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const std_png = @import("std.png")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const documents = @import("../app/documents.mlx")
const recent = @import("../app/recent.mlx")
const shell_module = @import("../app/shell.mlx")
const clipboard = @import("../app/clipboard.mlx")
const autosave = @import("../app/autosave.mlx")
const actions = @import("../actions/registry.mlx")
const file_actions = @import("../actions/file.mlx")
const edit_actions = @import("../actions/edit.mlx")
const geom = @import("../core/geom.mlx")
const device = @import("../core/device.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const history = @import("../core/history.mlx")
const selection = @import("../core/selection.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")
const formats = @import("../io/formats.mlx")
const io_png = @import("../io/png.mlx")
const filedialog = @import("../ui/filedialog.mlx")
const canvasview = @import("../ui/canvasview.mlx")

const App = state.App

const RED: u32 = 0xFFFF0000
const WHITE: u32 = 0xFFFFFFFF

// The test's own: the app, its folder, a script being written, a path
// being put together, where pictures go too.
const T = struct {
    app: *App
    root: [600]u8
    rootLength: usize
    text: [4096]u8
    textLength: usize
    path: [1200]u8
    pathLength: usize
    shots: []const u8
}

fn rootOf(t: *T) -> []const u8 {
    const bytes: [*]const u8 = &t.*.root
    return bytes[0..t.*.rootLength]
}

// The test's folder with `rest` after it, NUL-terminated too (pathZ).
fn pathOf(t: *T, rest: []const u8) -> []const u8 {
    const bytes: [*]u8 = &t.*.path
    t.*.pathLength = std.text.append(bytes, std.text.append(bytes, 0, 1199, rootOf(t)), 1199, rest)
    bytes[t.*.pathLength] = 0
    return bytes[0..t.*.pathLength]
}

fn pathZ(t: *T) -> [*]const u8 {
    const bytes: [*]const u8 = &t.*.path
    return bytes
}

fn exists(t: *T, rest: []const u8) -> bool {
    _ = pathOf(t, rest)
    return std.fs.exists(pathZ(t))
}

// Scripts.
fn begin(t: *T) -> void { t.*.textLength = 0 }

fn add(t: *T, text: []const u8) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.textLength = std.text.append(bytes, t.*.textLength, 4096, text)
}

fn play(t: *T) -> bool {
    const bytes: [*]const u8 = &t.*.text
    return script.run(t.*.app, bytes[0..t.*.textLength])
}

fn run(t: *T, text: []const u8) -> bool {
    return script.run(t.*.app, text)
}

// The file dialog shown: the path field gets `rest` (under the test's
// folder) and Enter.
fn choose(t: *T, rest: []const u8) -> bool {
    if !filedialog.isOpen(t.*.app) { return false }
    begin(t)
    add(t, "key Ctrl+L\ntype ")
    add(t, pathOf(t, rest))
    add(t, "\nkey Enter\n")
    return play(t)
}

// A picture of the window, here and where NEBULA_SHOTS says.
fn shot(t: *T, name: []const u8) -> bool {
    begin(t)
    add(t, "shot ")
    add(t, name)
    add(t, "\n")
    if t.*.shots.length > 0 && t.*.shots.length < 1000 {
        add(t, "shot ")
        add(t, t.*.shots)
        if t.*.shots[t.*.shots.length - 1] != '/' { add(t, "/") }
        add(t, name)
        add(t, "\n")
    }
    return play(t)
}

// The environment the program reads: HOME and the XDG folders inside the
// test's folder.
fn setEnvironment(t: *T, allocator: std.allocator.Allocator) -> bool {
    const text = allocator.alloc(3000, 16)
    const list = allocator.alloc(48, 16)
    if text == null || list == null { return false }
    const entries: [*]usize = unsafe { @ptrCast([*]usize, list.?) }
    var at: usize = 0
    var index: usize = 0
    while index < 4 {
        const start = at
        if index == 0 { at = std.text.append(text.?, at, 2990, "HOME=") }
        if index == 1 { at = std.text.append(text.?, at, 2990, "XDG_STATE_HOME=") }
        if index == 2 { at = std.text.append(text.?, at, 2990, "XDG_CONFIG_HOME=") }
        if index == 3 { at = std.text.append(text.?, at, 2990, "XDG_DATA_HOME=") }
        at = std.text.append(text.?, at, 2990, rootOf(t))
        if index == 0 { at = std.text.append(text.?, at, 2990, "/home") }
        if index == 1 { at = std.text.append(text.?, at, 2990, "/state") }
        if index == 2 { at = std.text.append(text.?, at, 2990, "/config") }
        if index == 3 { at = std.text.append(text.?, at, 2990, "/data") }
        text.?[at] = 0
        at += 1
        entries[index] = @intFromPtr(text.?) + start
        index += 1
    }
    entries[4] = 0
    shell_module.setEnvironment(t.*.app.*.shell, unsafe { @ptrCast([*][*]const u8, list.?) })
    return true
}

// ---------------------------------------------------------------------------
// The image

fn image(app: *App) -> *image_module.Image { return api.image(app).? }

fn layerPixel(app: *App, x: i32, y: i32) -> u32 {
    return device.pixel(api.activeNode(app).?.*.device.?, x, y)
}

fn shown(app: *App, x: i32, y: i32) -> u32 {
    const picture = image(app)
    _ = render.update(picture)
    return device.pixel(picture.*.projection, x, y)
}

fn steps(app: *App) -> usize { return history.stepsDone(image(app).*.history) }

fn select(app: *App, x: i32, y: i32, width: i32, height: i32) -> void {
    const picture = image(app)
    ops.beginSelection(picture)
    _ = selection.fromRect(picture.*.selection, geom.rect(x, y, width, height), selection.REPLACE, 0.0)
    ops.endSelection(picture, true, "Select")
}

fn deselect(app: *App) -> void {
    const picture = image(app)
    ops.beginSelection(picture)
    ops.endSelection(picture, false, "Deselect")
}

// The document in front goes without what the file actions do when they
// close one (its autosave stays): as a crash leaves it.
fn dropDocument(app: *App) -> void {
    canvasview.forget(app, api.document(app).?)
    documents.close(app, app.*.current)
}

fn layerCount(app: *App) -> usize { return ops.layerCount(image(app).*.root) }

fn nameIs(app: *App, name: []const u8) -> bool {
    return std.text.same(documents.nameOf(api.document(app).?), name)
}

// The pixel (x, y) of the PNG file at the test's folder + `rest`
// (premultiplied, as std.png gives it); 1 when it cannot be read.
fn filePixel(t: *T, rest: []const u8, x: usize, y: usize, width: *usize) -> u32 {
    var picture: std_png.Image = undefined
    _ = pathOf(t, rest)
    if std_png.loadFile(&picture, pathZ(t), std.heap.allocator()) != std_png.Status.ok { return 1 }
    width.* = picture.width
    var found: u32 = 1
    if x < picture.width && y < picture.height { found = picture.pixels[y * picture.width + x] }
    std_png.deinit(&picture)
    return found
}

// The File menu's recent files (its MenuSource): how many there are.
fn recentCount(app: *App) -> usize {
    const total = actions.sourceCount()
    var index: usize = 0
    while index < total {
        const source = actions.sourceAt(index)
        if source != null && source.?.*.menu == state.MENU_FILE { return source.?.*.count(app) }
        index += 1
    }
    return 0
}

// Whether its first entry names `name`.
fn recentShows(app: *App, name: []const u8) -> bool {
    const total = actions.sourceCount()
    var index: usize = 0
    while index < total {
        const source = actions.sourceAt(index)
        if source != null && source.?.*.menu == state.MENU_FILE {
            return source.?.*.count(app) >= 1 && std.text.contains(source.?.*.name(app, 0), name)
        }
        index += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// File

// New through its dialog; a document without changes closes at once.
fn checkNew(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "action file_new\n") || app.*.dialogCount != 1 { return 10 }
    if !shot(t, "file-new.png") { return 11 }
    if !run(t, "key Enter\n") || app.*.dialogCount != 0 || app.*.count != 1 { return 12 }
    const doc = api.document(app).?
    if doc.*.image.*.width != 1600 || doc.*.image.*.height != 1200 || !nameIs(app, "Untitled-1") || documents.isModified(doc) { return 14 }
    if shown(app, 800, 600) != WHITE { return 15 }
    if !run(t, "action file_close\n") || app.*.count != 0 || app.*.dialogCount != 0 { return 16 }
    // Without a document the actions that need one cannot run.
    if run(t, "action file_save\n") || run(t, "action edit_copy\n") { return 17 }
    return 0
}

// Save As (PNG), the file's pixels, the document's state, the recent
// files; Close asking; Open; Save again.
fn checkSave(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 120 90 FFFFFF\ncolor FF0000\n") { return 20 }
    const before = steps(app)
    select(app, 10, 10, 20, 15)
    if !run(t, "action edit_fill_foreground\n") || steps(app) != before + 2 { return 21 }
    if layerPixel(app, 12, 12) != RED || layerPixel(app, 30, 12) != 0 || shown(app, 12, 12) != RED || shown(app, 5, 5) != WHITE { return 22 }
    deselect(app)
    if !documents.isModified(api.document(app).?) { return 23 }
    // Save asks for a name (the document has none); the layered format
    // first when one can be written, else PNG.
    if !run(t, "action file_save\n") || !filedialog.isOpen(app) { return 24 }
    const ora = formats.find(formats.ORA).?
    const layered = ora.*.canWrite && ora.*.writeImage != null
    const first = filedialog.nameText(app)
    if (layered && !std.text.endsWith(first, ".ora")) || (!layered && !std.text.same(first, "Untitled-2.png")) { return 25 }
    if !shot(t, "file-save-as.png") { return 26 }
    if !choose(t, "/files/picture.png") || filedialog.isOpen(app) { return 27 }
    if !exists(t, "/files/picture.png") { return 28 }
    var width: usize = 0
    if filePixel(t, "/files/picture.png", 12, 12, &width) != RED || width != 120 || filePixel(t, "/files/picture.png", 5, 5, &width) != WHITE || filePixel(t, "/files/picture.png", 29, 24, &width) != RED || filePixel(t, "/files/picture.png", 30, 25, &width) != WHITE { return 29 }
    const doc = api.document(app).?
    if documents.isModified(doc) || !nameIs(app, "picture.png") || doc.*.format != @intCast(u8, formats.PNG) { return 30 }
    if !std.text.same(image_module.pathOf(doc.*.image), pathOf(t, "/files/picture.png")) { return 31 }
    if recent.count(app) < 1 || !std.text.same(recent.at(app, 0), pathOf(t, "/files/picture.png")) || !recentShows(app, "picture.png") { return 32 }
    if !std.text.contains(api.noteOf(app), "merged") { return 33 }
    // Saved flat knowingly: Save writes it again without asking.
    select(app, 40, 40, 20, 20)
    if !run(t, "color 0000FF\naction edit_fill_foreground\naction file_save\n") || filedialog.isOpen(app) || documents.isModified(doc) { return 34 }
    deselect(app)
    if filePixel(t, "/files/picture.png", 50, 50, &width) != 0xFF0000FF { return 35 }
    // A change; Close asks: Escape keeps it, Discard closes it.
    if !run(t, "color 00FF00\naction edit_fill_foreground\naction file_close\n") || app.*.dialogCount != 1 || app.*.count != 1 { return 36 }
    if !shot(t, "file-close-ask.png") { return 37 }
    if !run(t, "key Escape\n") || app.*.dialogCount != 0 || app.*.count != 1 || file_actions.closing(app) { return 38 }
    if !run(t, "action file_close\nkey Tab\nkey Enter\n") || app.*.count != 0 || app.*.dialogCount != 0 { return 39 }
    // Open: the file's pixels back, one layer, unchanged.
    if !run(t, "action file_open\n") || !filedialog.isOpen(app) { return 40 }
    if !shot(t, "file-open.png") { return 41 }
    if !choose(t, "/files/picture.png") || app.*.count != 1 { return 42 }
    if !nameIs(app, "picture.png") || documents.isModified(api.document(app).?) || layerCount(app) != 1 { return 43 }
    if shown(app, 12, 12) != RED || shown(app, 50, 50) != 0xFF0000FF || shown(app, 5, 5) != WHITE { return 44 }
    // Opened again: the one open comes to the front, none is added.
    if !run(t, "new 30 30\n") || app.*.count != 2 { return 45 }
    if !file_actions.openPath(app, pathOf(t, "/files/picture.png")) || app.*.count != 2 || app.*.current != 0 { return 46 }
    if !run(t, "action file_close\n") || app.*.count != 1 || !nameIs(app, "Untitled-3") { return 47 }
    if !run(t, "action file_close\n") || app.*.count != 0 { return 48 }
    // A file that is not there is said, and nothing opens.
    if file_actions.openPath(app, pathOf(t, "/files/none.png")) || app.*.count != 0 || app.*.dialogCount != 1 { return 49 }
    if !run(t, "key Enter\n") || app.*.dialogCount != 0 { return 50 }
    return 0
}

// The layered format, when one can be written: two layers through saving
// and opening.
fn checkLayered(t: *T) -> u8 {
    const app = t.*.app
    const ora = formats.find(formats.ORA).?
    if !(ora.*.canWrite && ora.*.writeImage != null && ora.*.canRead) { return 0 }
    if !run(t, "new 64 48 FFFFFF\naction file_save_as\n") || !filedialog.isOpen(app) { return 55 }
    if !choose(t, "/files/layers.ora") || !exists(t, "/files/layers.ora") { return 56 }
    if !run(t, "action file_close\n") || app.*.count != 0 { return 57 }
    if !file_actions.openPath(app, pathOf(t, "/files/layers.ora")) || layerCount(app) != 2 { return 58 }
    if !run(t, "action file_close\n") || app.*.count != 0 { return 59 }
    return 0
}

// Export, an incremental version, Revert, the information.
fn checkExport(t: *T) -> u8 {
    const app = t.*.app
    // As main.mlx hands them: NUL-terminated, relative to the working
    // directory (made absolute).
    const named = [1][*]const u8{ "t70/files/picture.png\x00".pointer }
    if file_actions.openPaths(app, named[0..]) != 1 || app.*.count != 1 || !std.text.same(image_module.pathOf(image(app)), pathOf(t, "/files/picture.png")) { return 60 }
    if !run(t, "color 102030\naction edit_fill_foreground\naction file_export\n") || !filedialog.isOpen(app) { return 61 }
    if !choose(t, "/files/export.jpg") || !exists(t, "/files/export.jpg") { return 62 }
    var contents: [4]u8 = undefined
    const bytes: [*]u8 = &contents
    if std.fs.readFile(pathZ(t), bytes, 4) != 4 || bytes[0] != 0xFF || bytes[1] != 0xD8 { return 63 }
    const doc = api.document(app).?
    if !nameIs(app, "picture.png") || !documents.isModified(doc) || !std.text.same(image_module.pathOf(doc.*.image), pathOf(t, "/files/picture.png")) { return 64 }
    // Incremental versions.
    if !run(t, "key Ctrl+Alt+S\n") || !exists(t, "/files/picture_001.png") || !nameIs(app, "picture_001.png") || documents.isModified(doc) { return 65 }
    if !run(t, "action file_save_incremental\n") || !exists(t, "/files/picture_002.png") || !nameIs(app, "picture_002.png") { return 66 }
    // The Open Recent submenu offers only files that are there.
    if !recentShows(app, "picture_002.png") { return 75 }
    const listed = recentCount(app)
    _ = pathOf(t, "/files/picture_001.png")
    if listed < 3 || !std.fs.delete(pathZ(t)) || recentCount(app) != listed - 1 { return 76 }
    // Revert: a change asks; Revert reads the file again.
    if !run(t, "color 00FF00\naction edit_fill_foreground\n") || shown(app, 5, 5) != 0xFF00FF00 { return 67 }
    if !run(t, "action file_revert\n") || app.*.dialogCount != 1 { return 68 }
    if !run(t, "key Enter\n") || app.*.dialogCount != 0 || documents.isModified(api.document(app).?) || shown(app, 5, 5) != 0xFF102030 { return 69 }
    // The information.
    if !run(t, "action file_document_info\n") || app.*.dialogCount != 1 { return 70 }
    if !shot(t, "file-info.png") { return 71 }
    if !run(t, "german\n") || !shot(t, "file-info-german.png") { return 72 }
    app.*.shell.*.lightness = 1024
    if !shot(t, "file-info-light.png") { return 78 }
    app.*.shell.*.lightness = 0
    app.*.german = false
    if !run(t, "key Escape\n") || app.*.dialogCount != 0 { return 73 }
    if !run(t, "action file_close\n") || app.*.count != 0 { return 74 }
    if !run(t, "action file_clear_recent\n") || recent.count(app) != 0 || recentCount(app) != 0 || run(t, "action file_clear_recent\n") { return 77 }
    return 0
}

// ---------------------------------------------------------------------------
// Edit

// Cut, the clipboard, paste, paste into a new image, copy merged.
fn checkClipboard(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 128 96 FFFFFF\ncolor FF0000\n") { return 80 }
    // A red square across the tile border at 64.
    select(app, 60, 60, 10, 10)
    if !run(t, "action edit_fill_foreground\n") || layerPixel(app, 63, 63) != RED || layerPixel(app, 64, 69) != RED || layerPixel(app, 70, 70) != 0 { return 81 }
    const layer = api.activeNode(app).?
    var before = steps(app)
    if !run(t, "action edit_cut\n") || steps(app) != before + 1 { return 82 }
    if device.pixel(layer.*.device.?, 63, 63) != 0 || device.pixel(layer.*.device.?, 69, 69) != 0 || shown(app, 65, 65) != WHITE { return 83 }
    if !geom.same(clipboard.bounds(app), geom.rect(60, 60, 10, 10)) || !shell_module.clipboardHas(app.*.shell, clipboard.MIME) { return 84 }
    // Paste: a new layer, the square where it was, the selection gone;
    // one step.
    before = steps(app)
    if !run(t, "action edit_paste\n") || layerCount(app) != 3 || image(app).*.selected { return 85 }
    if steps(app) != before + 1 || @intFromPtr(api.activeNode(app).?) == @intFromPtr(layer) { return 86 }
    if layerPixel(app, 60, 60) != RED || layerPixel(app, 69, 69) != RED || layerPixel(app, 59, 60) != 0 || layerPixel(app, 70, 69) != 0 || shown(app, 65, 65) != RED { return 87 }
    if !run(t, "action edit_undo\n") || layerCount(app) != 2 || !image(app).*.selected || shown(app, 65, 65) != WHITE { return 88 }
    if !run(t, "action edit_redo\n") || layerCount(app) != 3 || image(app).*.selected { return 89 }
    // Paste into New Image: 10 x 10, red.
    if !run(t, "action edit_paste_new_image\n") || app.*.count != 2 { return 90 }
    if image(app).*.width != 10 || image(app).*.height != 10 || shown(app, 0, 0) != RED || shown(app, 9, 9) != RED || documents.isModified(api.document(app).?) { return 91 }
    if !run(t, "action file_close\n") || app.*.count != 1 { return 92 }
    // Copy Merged: the white ground and the red square together.
    select(app, 50, 50, 30, 30)
    if !run(t, "action edit_copy_merged\n") || !geom.same(clipboard.bounds(app), geom.rect(50, 50, 30, 30)) { return 93 }
    if !run(t, "action edit_paste_new_image\n") || image(app).*.width != 30 || shown(app, 2, 2) != WHITE || shown(app, 15, 15) != RED || shown(app, 9, 9) != WHITE || shown(app, 10, 10) != RED { return 94 }
    if !run(t, "action file_close\n") || app.*.count != 1 { return 95 }
    // Copy of the active layer only: the pasted one (on top).
    image(app).*.active = node_module.childAt(image(app).*.root, 2)
    select(app, 0, 0, 128, 96)
    if !run(t, "action edit_copy\n") || !geom.same(clipboard.bounds(app), geom.rect(60, 60, 10, 10)) { return 96 }
    deselect(app)
    // Paste into the active layer (the cut one): mixed in, one step.
    image(app).*.active = layer
    before = steps(app)
    if !run(t, "action edit_paste_into\n") || steps(app) != before + 1 || layerCount(app) != 3 || device.pixel(layer.*.device.?, 65, 65) != RED || layer.*.overlay != null { return 97 }
    // Another program's picture: in the middle of the view.
    var pixels: [6]u32 = [6]u32{ 0xFF00FF00, 0xFF00FF00, 0xFF00FF00, 0xFF00FF00, 0xFF00FF00, 0xFF00FF00 }
    var bytes = std.ArrayList(u8).init(std.heap.allocator())
    defer bytes.deinit()
    if !io_png.encode(&pixels, 3, 2, 3, true, &bytes) || !shell_module.setClipboard(app.*.shell, clipboard.MIME, bytes.items()) { return 98 }
    if !run(t, "action edit_paste\n") || layerCount(app) != 4 { return 99 }
    const foreign = device.exactBounds(api.activeNode(app).?.*.device.?)
    const view = api.document(app).?.*.view
    const middle_x = @intFromFloat(i32, view.centerX)
    const middle_y = @intFromFloat(i32, view.centerY)
    if foreign.width != 3 || foreign.height != 2 || foreign.x + 1 - middle_x > 1 || middle_x - foreign.x - 1 > 1 || foreign.y + 1 - middle_y > 1 || middle_y - foreign.y - 1 > 1 { return 100 }
    if layerPixel(app, foreign.x, foreign.y) != 0xFF00FF00 { return 101 }
    // Our own copy again: our pixels, with their place.
    image(app).*.active = layer
    select(app, 60, 60, 10, 10)
    if !run(t, "action edit_copy\nkey Ctrl+V\n") || layerCount(app) != 5 || layerPixel(app, 60, 60) != RED { return 102 }
    if !shot(t, "edit-paste.png") { return 103 }
    if !run(t, "action file_close\nkey Tab\nkey Enter\n") || app.*.count != 0 { return 104 }
    // Paste with no document: a new image.
    if !run(t, "action edit_paste\n") || app.*.count != 1 || image(app).*.width != 10 { return 105 }
    if !run(t, "action file_close\n") || app.*.count != 0 { return 106 }
    return 0
}

// The edges: one pixel, nothing to copy, pixels at negative places (only
// what is in the image is copied), pixels that do not fit the image
// pasted into (the middle of the view).
fn checkEdges(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 40 40\ncolor FF0000\naction edit_fill_foreground\n") { return 180 }
    select(app, 3, 3, 1, 1)
    if !run(t, "action edit_copy\n") || !geom.same(clipboard.bounds(app), geom.rect(3, 3, 1, 1)) { return 181 }
    // A layer moved half out of the image to the top left.
    const layer = api.activeNode(app).?
    device.moveBy(layer.*.device.?, -20, -20)
    if layerPixel(app, -20, -20) != RED || layerPixel(app, 19, 19) != RED || layerPixel(app, 20, 20) != 0 { return 182 }
    deselect(app)
    if !run(t, "action edit_copy\n") || !geom.same(clipboard.bounds(app), geom.rect(0, 0, 20, 20)) { return 183 }
    // Nothing there: the clipboard keeps what it had.
    select(app, 25, 25, 10, 10)
    if !run(t, "action edit_copy\n") || !geom.same(clipboard.bounds(app), geom.rect(0, 0, 20, 20)) || !std.text.contains(api.noteOf(app), "nothing") { return 184 }
    // A wide picture pasted into a small image: its middle in the view's.
    select(app, 0, 0, 20, 4)
    if !run(t, "action edit_copy\nnew 12 12\naction edit_paste\n") || layerCount(app) != 3 { return 185 }
    const pasted = device.exactBounds(api.activeNode(app).?.*.device.?)
    if pasted.width != 20 || pasted.height != 4 || pasted.x != -4 || pasted.y != 4 { return 186 }
    if !run(t, "action file_close\nkey Tab\nkey Enter\naction file_close\nkey Tab\nkey Enter\n") || app.*.count != 0 { return 187 }
    return 0
}

// Clear, the fills and the stroke, each one step.
fn checkFills(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 100 80\ncolor 00FF00\naction edit_fill_foreground\n") { return 110 }
    if layerPixel(app, 0, 0) != 0xFF00FF00 || layerPixel(app, 99, 79) != 0xFF00FF00 { return 111 }
    select(app, 10, 10, 5, 5)
    var before = steps(app)
    if !run(t, "key Delete\n") || steps(app) != before + 1 || layerPixel(app, 12, 12) != 0 || layerPixel(app, 14, 14) != 0 || layerPixel(app, 15, 12) != 0xFF00FF00 || layerPixel(app, 9, 9) != 0xFF00FF00 { return 112 }
    select(app, 20, 20, 8, 8)
    before = steps(app)
    if !run(t, "background 0000FF\naction edit_fill_background\n") || steps(app) != before + 1 { return 114 }
    if layerPixel(app, 22, 22) != 0xFF0000FF || layerPixel(app, 27, 27) != 0xFF0000FF || layerPixel(app, 28, 28) != 0xFF00FF00 || layerPixel(app, 19, 22) != 0xFF00FF00 { return 115 }
    if !run(t, "color FF0000\nkey Shift+Backspace\n") || layerPixel(app, 22, 22) != RED || layerPixel(app, 30, 30) != 0xFF00FF00 { return 116 }
    // A pattern, through its form: opaque where the selection is.
    if !run(t, "key Delete\naction edit_fill_pattern\n") || app.*.dialogCount != 1 || layerPixel(app, 22, 22) != 0 { return 117 }
    if !shot(t, "edit-fill-pattern.png") { return 118 }
    before = steps(app)
    if !run(t, "key Enter\n") || app.*.dialogCount != 0 || steps(app) != before + 1 { return 119 }
    if layerPixel(app, 22, 22) >> 24 != 255 || layerPixel(app, 27, 27) >> 24 != 255 || layerPixel(app, 28, 28) != 0xFF00FF00 { return 120 }
    // Stroke Selection: centred (the form, Enter), 4 pixels wide.
    if !run(t, "action file_close\nkey Tab\nkey Enter\nnew 100 80\ncolor 2040C0\n") || app.*.count != 1 { return 121 }
    select(app, 30, 30, 20, 20)
    if !run(t, "action edit_stroke_selection\n") || app.*.dialogCount != 1 { return 122 }
    if !shot(t, "edit-stroke.png") { return 123 }
    before = steps(app)
    if !run(t, "key Enter\n") || app.*.dialogCount != 0 || steps(app) != before + 1 { return 124 }
    const blue: u32 = 0xFF2040C0
    if layerPixel(app, 28, 40) != blue || layerPixel(app, 31, 40) != blue || layerPixel(app, 27, 40) != 0 || layerPixel(app, 32, 40) != 0 || layerPixel(app, 40, 40) != 0 { return 125 }
    if layerPixel(app, 51, 40) != blue || layerPixel(app, 52, 40) != 0 || layerPixel(app, 40, 28) != blue || layerPixel(app, 40, 51) != blue { return 126 }
    // Mitred corners: the corner square is whole.
    if layerPixel(app, 28, 28) != blue || layerPixel(app, 51, 51) != blue || layerPixel(app, 27, 27) != 0 { return 127 }
    if !run(t, "action edit_undo\n") || layerPixel(app, 28, 40) != 0 { return 128 }
    // Inside and outside, 3 pixels.
    if !edit_actions.strokeSelected(app, 3.0, RED, edit_actions.STROKE_INSIDE) { return 129 }
    if layerPixel(app, 30, 40) != RED || layerPixel(app, 32, 40) != RED || layerPixel(app, 33, 40) != 0 || layerPixel(app, 29, 40) != 0 || layerPixel(app, 49, 49) != RED { return 130 }
    if !run(t, "action edit_undo\n") || layerPixel(app, 30, 40) != 0 { return 131 }
    if !edit_actions.strokeSelected(app, 3.0, RED, edit_actions.STROKE_OUTSIDE) { return 132 }
    if layerPixel(app, 27, 40) != RED || layerPixel(app, 29, 40) != RED || layerPixel(app, 26, 40) != 0 || layerPixel(app, 30, 40) != 0 || layerPixel(app, 27, 27) != RED || layerPixel(app, 52, 52) != RED { return 133 }
    // A selection of two squares that touch at a corner: two rings.
    select(app, 10, 10, 5, 5)
    const picture = image(app)
    ops.beginSelection(picture)
    _ = selection.fromRect(picture.*.selection, geom.rect(15, 15, 5, 5), selection.ADD, 0.0)
    ops.endSelection(picture, true, "Select")
    if !edit_actions.strokeSelected(app, 1.0, RED, edit_actions.STROKE_INSIDE) { return 134 }
    if layerPixel(app, 10, 12) != RED || layerPixel(app, 12, 12) != 0 || layerPixel(app, 19, 17) != RED || layerPixel(app, 17, 17) != 0 || layerPixel(app, 14, 14) != RED || layerPixel(app, 15, 15) != RED { return 135 }
    // Without a selection there is nothing to stroke.
    deselect(app)
    if run(t, "action edit_stroke_selection\n") || edit_actions.strokeSelected(app, 2.0, RED, edit_actions.STROKE_CENTRED) { return 136 }
    if !run(t, "action file_close\nkey Tab\nkey Enter\n") || app.*.count != 0 { return 137 }
    return 0
}

// ---------------------------------------------------------------------------
// Autosave and quitting

fn checkAutosave(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 40 30 FFFFFF\ncolor FF0000\naction edit_fill_foreground\n") { return 140 }
    const doc = api.document(app).?
    var where: [4096]u8 = undefined
    const bytes: [*]u8 = &where
    if !autosave.pending(app) { return 139 }
    autosave.tick(app)
    app.*.shell.*.clock += 4 * 60000
    autosave.tick(app)
    if autosave.pathOf(app, doc, bytes) != 0 { return 141 }
    app.*.shell.*.clock += 60000
    autosave.tick(app)
    const length = autosave.pathOf(app, doc, bytes)
    if length == 0 || !std.text.startsWith(bytes[0..length], pathOf(t, "/state/mlx/nebula/autosave/nebula-")) || !std.fs.exists(bytes) || autosave.pending(app) { return 142 }
    // Beside it, the document's name.
    var name: [64]u8 = undefined
    const name_bytes: [*]u8 = &name
    var stem = length
    while stem > 0 && bytes[stem - 1] != 46 { stem -= 1 }
    const name_path_length = std.text.append(bytes, stem, 4096, "name")
    bytes[name_path_length] = 0
    const read = std.fs.readFile(bytes, name_bytes, 64)
    if read < 11 || !std.text.startsWith(name_bytes[0..read], "Untitled-") { return 143 }
    _ = autosave.pathOf(app, doc, bytes)
    // Saved: the autosave goes.
    if !run(t, "action file_save_as\n") || !choose(t, "/files/auto.png") || documents.isModified(doc) { return 144 }
    if std.fs.exists(bytes) || autosave.pathOf(app, doc, bytes) != 0 { return 145 }
    // Changed again and written, then left behind as by a crash: the
    // next start offers it.
    if !run(t, "color 0000FF\naction edit_fill_foreground\n") || !autosave.pending(app) { return 146 }
    if !autosave.write(app, doc) || autosave.pathOf(app, doc, bytes) == 0 { return 147 }
    if autosave.leftOver(app) != 0 { return 148 }
    // (The document is let go without its autosave being removed: what a
    // crash leaves.)
    dropDocument(app)
    if autosave.leftOver(app) != 1 || !autosave.offer(app) || app.*.dialogCount != 1 { return 149 }
    if !shot(t, "file-recover.png") { return 150 }
    app.*.shell.*.lightness = 1024
    if !run(t, "german\n") || !shot(t, "file-recover-light-german.png") { return 159 }
    app.*.shell.*.lightness = 0
    app.*.german = false
    if !run(t, "key Enter\n") || app.*.dialogCount != 0 || app.*.count != 1 { return 151 }
    const recovered = api.document(app).?
    if !std.text.contains(documents.nameOf(recovered), "auto.png") || !documents.isModified(recovered) || image_module.pathOf(recovered.*.image).length != 0 { return 152 }
    if shown(app, 5, 5) != 0xFF0000FF { return 153 }
    // Closed: its autosave goes with it.
    if !run(t, "action file_close\nkey Tab\nkey Enter\n") || app.*.count != 0 || autosave.leftOver(app) != 0 { return 154 }
    // Discard removes what is left.
    if !run(t, "new 20 20 FFFFFF\ncolor FF0000\naction edit_fill_foreground\n") || !autosave.write(app, api.document(app).?) { return 156 }
    dropDocument(app)
    if !autosave.offer(app) || !run(t, "key Tab\nkey Enter\n") || app.*.dialogCount != 0 || autosave.leftOver(app) != 0 || app.*.count != 0 { return 157 }
    return 0
}

// Frames of the information dialog one after another, the value arena
// given back before each as the window's loop does: it does not grow.
fn checkArena(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 64 64 FFFFFF\naction file_document_info\n") || app.*.dialogCount != 1 { return 160 }
    const frame = script.frameOf(app).?
    var rounds: turns.Turns = undefined
    turns.begin(&rounds, true, false)
    const arena = rounds.base
    const mark = turns.used(arena)
    var first: usize = 0
    var last: usize = 0
    var round: usize = 0
    while round < 120 {
        turns.turn(&rounds)
        app.*.shell.*.clock += 16
        loop.frame(app, frame)
        last = turns.used(arena) - mark
        if round == 40 { first = last }
        if last > 2097152 { return 161 }
        round += 1
    }
    const off = if last > first { last - first } else { first - last }
    if off > 1024 { return 162 }
    turns.turn(&rounds)
    if !run(t, "key Escape\naction file_close\n") || app.*.count != 0 { return 163 }
    return 0
}

fn checkQuit(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 50 50 FFFFFF\ncolor FF0000\naction edit_fill_foreground\nnew 50 50 FFFFFF\n") || app.*.count != 2 { return 170 }
    // The light theme and German, for the pictures.
    app.*.shell.*.lightness = 1024
    if !run(t, "german\naction file_quit\n") || app.*.dialogCount != 1 || !app.*.shell.*.running { return 171 }
    if !shot(t, "file-quit-light-german.png") { return 172 }
    if !run(t, "key Escape\n") || !app.*.shell.*.running || app.*.count != 2 || file_actions.closing(app) { return 173 }
    // Discard: the one with changes goes, the other without a question,
    // and the program ends.
    if !run(t, "action file_quit\nkey Tab\nkey Enter\n") { return 174 }
    if app.*.shell.*.running || app.*.count != 0 { return 175 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    // (In heap memory: a script's steps give the value arena back.)
    const memory = allocator.alloc(@sizeOf(T), 16)
    if memory == null { return 1 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    const made = script.headless(allocator)
    if made == null { return 1 }
    t.*.app = made.?
    t.*.shots = ""
    const shots = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if shots != null { t.*.shots = std.string.asSlice(shots.?) }
    const root: [*]u8 = &t.*.root
    if std.fs.getWorkingDirectory(root, 500) <= 0 { return 2 }
    var length: usize = 0
    while length < 500 && root[length] != 0 { length += 1 }
    t.*.rootLength = std.text.append(root, length, 590, "/t70")
    if !std.fs.makeDirectories(pathOf(t, "/files"), 493) || !std.fs.makeDirectories(pathOf(t, "/home"), 493) { return 3 }
    if !setEnvironment(t, allocator) { return 4 }
    if !run(t, "size 1280 800\n") { return 5 }
    var failed = checkNew(t)
    if failed == 0 { failed = checkSave(t) }
    if failed == 0 { failed = checkLayered(t) }
    if failed == 0 { failed = checkExport(t) }
    if failed == 0 { failed = checkClipboard(t) }
    if failed == 0 { failed = checkEdges(t) }
    if failed == 0 { failed = checkFills(t) }
    if failed == 0 { failed = checkAutosave(t) }
    if failed == 0 { failed = checkArena(t) }
    if failed == 0 { failed = checkQuit(t) }
    if failed != 0 { return failed }
    return 13
}
