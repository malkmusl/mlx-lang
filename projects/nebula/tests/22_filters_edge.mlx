// nebula's Edge Detection and Emboss filters (filters/edge.mlx), through
// the registry: every filter is listed with an id and a key of its own
// and initial values inside their ranges; exact pixels for the 3x3
// kernels (which side is which, per channel, the edges held), for Emboss
// with Variable Depth (its rounding too), for Edge Detection (the three
// formulas, the four sides equal to the fixed filters, the direction, a
// larger radius, the answer as alpha), the high pass (a ramp is flat grey,
// an impulse spreads as a bell) and the normal map; the rule for
// translucent neighbours and the high pass's three boxes against sums
// written out here, pixel by pixel; every filter at its
// parameters' extremes and with NaN on 1x1, 1xN, Nx1 and 257x130 pictures
// that are transparent, opaque or mixed, with a stride wider than the
// picture (the words beside it stay); transparent neighbours make no edge
// and leave no colour; a picture filtered whole equals the same filtered
// in blocks of 256 grown by margin(); the same numbers give the same
// pixels; the two convolutions by themselves (channels, a box and a
// binomial blur of an impulse, which way a kernel is turned, the identity
// bit for bit); 50 applications take no memory of the value arena and
// leave the scratch pool as it was. Prints megapixels per second of the
// heavier filters. Exits 13.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")
const filters = @import("../filters/registry.mlx")
const types = @import("../filters/types.mlx")
const edge = @import("../filters/edge.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")

const SENTINEL: u32 = 0xDEADBEEF

const CLEAR: u32 = 0
const SOLID: u32 = 1
const MIXED: u32 = 2

const MINE = [14]u16{ edge.TOP_EDGE, edge.RIGHT_EDGE, edge.BOTTOM_EDGE, edge.LEFT_EDGE, edge.EDGE_DETECTION, edge.GAUSSIAN_HIGH_PASS, edge.HEIGHT_TO_NORMAL, edge.LAPLACIAN, edge.EMBOSS_HORIZONTAL, edge.EMBOSS_VERTICAL, edge.EMBOSS_ALL, edge.EMBOSS_HORIZONTAL_VERTICAL, edge.EMBOSS_LAPLACIAN, edge.EMBOSS }

fn words(count: usize) -> [*]u32 {
    const memory = std.heap.allocator().alloc(count * 4, 16).?
    unsafe { return @ptrCast([*]u32, memory) }
}

// A generator of its own (xorshift): the same seed, the same picture.
fn next(state: *u64) -> u32 {
    var x = state.*
    x ^= x << 13
    x ^= x >> 7
    x ^= x << 17
    state.* = x
    return @intCast(u32, x >> 32)
}

// A picture of noise: transparent with colour left in it, opaque, or
// every pixel one of transparent, opaque, translucent.
fn noise(pixels: [*]u32, width: usize, height: usize, stride: usize, kind: u32, seed: u64) -> void {
    var state: u64 = seed *% 0x9E3779B97F4A7C15 +% 88172645463325252
    if state == 0 { state = 1 }
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const value = next(&state)
            var made = value & 0x00FFFFFF
            if kind == SOLID {
                made |= 0xFF000000
            } else if kind == MIXED {
                const pick = next(&state) & 3
                if pick == 1 { made |= 0xFF000000 }
                if pick >= 2 { made = value }
            }
            pixels[y * stride + x] = made
            x += 1
        }
        y += 1
    }
}

fn flood(pixels: [*]u32, width: usize, height: usize, stride: usize, value: u32) -> void {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            pixels[y * stride + x] = value
            x += 1
        }
        y += 1
    }
}

fn copy(into: [*]u32, from: [*]const u32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        into[index] = from[index]
        index += 1
    }
}

fn same(a: [*]const u32, b: [*]const u32, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn bars(text: []const u8) -> usize {
    var count: usize = 0
    for byte in text {
        if byte == 124 { count += 1 }
    }
    return count
}

// Every filter of the module is in the registry, once, and says of itself
// what the dialog and the files need.
fn wiring() -> u8 {
    if edge.list().length != 14 { return 1 }
    var index: usize = 0
    while index < 14 {
        const id = MINE[index]
        const found = filters.find(id)
        if found == null { return 2 }
        const info = found.?
        if info.*.id != id || id < 200 || id > 249 { return 3 }
        const group: u8 = if id < 220 { types.EDGE } else { types.EMBOSS }
        if info.*.category != group { return 4 }
        if info.*.key.length == 0 || info.*.name.length == 0 || info.*.german.length == 0 { return 5 }
        const named = filters.byKey(info.*.key)
        if named == null || named.?.*.id != id { return 6 }
        if info.*.margin == null { return 7 }
        var params: filters.Params = undefined
        filters.defaults(id, &params)
        if params.id != id { return 8 }
        var place: usize = 0
        while place < info.*.params.length {
            const param = &info.*.params[place]
            if param.*.name.length == 0 || param.*.german.length == 0 { return 9 }
            if !(param.*.low < param.*.high) || param.*.initial < param.*.low || param.*.initial > param.*.high { return 10 }
            if params.values[place] != param.*.initial { return 11 }
            if param.*.kind == types.CHOICE {
                const choices = @intFromFloat(usize, param.*.high) + 1
                if param.*.low != 0.0 || bars(param.*.choices) + 1 != choices || bars(param.*.choicesGerman) + 1 != choices { return 12 }
            }
            place += 1
        }
        if filters.margin(&params) < 1 { return 15 }
        index += 1
    }
    const all = filters.count()
    var first: usize = 0
    while first < all {
        var second = first + 1
        while second < all {
            const a = filters.at(first).?
            const b = filters.at(second).?
            if a.*.id == b.*.id || std.text.same(a.*.key, b.*.key) { return 14 }
            second += 1
        }
        first += 1
    }
    return 0
}

fn run(id: u16, pixels: [*]u32, width: usize, height: usize, stride: usize) -> bool {
    var params: filters.Params = undefined
    filters.defaults(id, &params)
    return filters.apply(&params, pixels, width, height, stride)
}

// 5x5 of grey 100 with 110 in the middle through filter `id`: every
// pixel then is one of four greys, by where it lies to the middle.
fn impulse(id: u16, grid: [*]u32, middle: u32, beside: u32, diagonal: u32, other: u32) -> bool {
    flood(grid, 5, 5, 5, pixel.gray(100))
    grid[12] = pixel.gray(110)
    if !run(id, grid, 5, 5, 5) { return false }
    var y: i32 = 0
    while y < 5 {
        var x: i32 = 0
        while x < 5 {
            const dx = if x < 2 { 2 - x } else { x - 2 }
            const dy = if y < 2 { 2 - y } else { y - 2 }
            var expected = other
            if dx == 0 && dy == 0 { expected = middle }
            if dx + dy == 1 { expected = beside }
            if dx == 1 && dy == 1 { expected = diagonal }
            if grid[@intCast(usize, y * 5 + x)] != pixel.gray(expected) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// The fixed 3x3 kernels, pixel by pixel.
fn kernels(grid: [*]u32) -> u8 {
    // A step downward, 10 above 50: the top filter is lighter at it (40
    // times the three weights of a row), the bottom one darker; the first
    // row has itself above it.
    var y: usize = 0
    while y < 5 {
        flood(grid + y * 5, 5, 1, 5, pixel.gray(if y < 2 { 10 } else { 50 }))
        y += 1
    }
    if !run(edge.TOP_EDGE, grid, 5, 5, 5) { return 20 }
    y = 0
    while y < 5 {
        var x: usize = 0
        while x < 5 {
            if grid[y * 5 + x] != pixel.gray(if y == 1 || y == 2 { 247 } else { 127 }) { return 21 }
            x += 1
        }
        y += 1
    }
    y = 0
    while y < 5 {
        flood(grid + y * 5, 5, 1, 5, pixel.gray(if y < 2 { 10 } else { 50 }))
        y += 1
    }
    if !run(edge.BOTTOM_EDGE, grid, 5, 5, 5) { return 22 }
    if grid[0] != pixel.gray(127) || grid[7] != pixel.gray(7) || grid[12] != pixel.gray(7) || grid[17] != pixel.gray(127) || grid[24] != pixel.gray(127) { return 23 }

    // Red rises by 10 a column, green by 5 a row, blue by 3 a column and
    // 1 a row: each channel answers for itself, and at the picture's ends
    // the neighbour outside is the end pixel.
    var side: u32 = 0
    while side < 4 {
        y = 0
        while y < 5 {
            var x: usize = 0
            while x < 5 {
                grid[y * 5 + x] = pixel.rgb(@intCast(u32, x) * 10, @intCast(u32, y) * 5, @intCast(u32, x) * 3 + @intCast(u32, y))
                x += 1
            }
            y += 1
        }
        const id = if side == 0 { edge.LEFT_EDGE } else if side == 1 { edge.RIGHT_EDGE } else if side == 2 { edge.TOP_EDGE } else { edge.BOTTOM_EDGE }
        if !run(id, grid, 5, 5, 5) { return 24 }
        y = 0
        while y < 5 {
            var x: usize = 0
            while x < 5 {
                // The slopes times three rows (or columns), halved at an end.
                const inner_x = x > 0 && x < 4
                const inner_y = y > 0 && y < 4
                var r: i32 = if inner_x { 60 } else { 30 }
                var g: i32 = 0
                var b: i32 = if inner_x { 18 } else { 9 }
                if side >= 2 {
                    r = 0
                    g = if inner_y { 30 } else { 15 }
                    b = if inner_y { 6 } else { 3 }
                }
                if side == 1 || side == 3 {
                    r = -r
                    g = -g
                    b = -b
                }
                if grid[y * 5 + x] != pixel.rgb(@intCast(u32, 127 + r), @intCast(u32, 127 + g), @intCast(u32, 127 + b)) { return 25 }
                x += 1
            }
            y += 1
        }
        side += 1
    }

    // One lighter pixel (by 10) through the kernels that look all round.
    if !impulse(edge.EMBOSS_ALL, grid, 207, 117, 117, 127) { return 26 }
    if !impulse(edge.EMBOSS_HORIZONTAL_VERTICAL, grid, 167, 117, 127, 127) { return 27 }
    if !impulse(edge.EMBOSS_LAPLACIAN, grid, 167, 127, 117, 127) { return 28 }
    if !impulse(edge.LAPLACIAN, grid, 80, 0, 0, 0) { return 29 }
    // Horizontal only: the right neighbour minus the left one.
    flood(grid, 5, 5, 5, pixel.gray(100))
    grid[12] = pixel.gray(110)
    if !run(edge.EMBOSS_HORIZONTAL, grid, 5, 5, 5) { return 30 }
    var index: usize = 0
    while index < 25 {
        const expected: u32 = if index == 11 { 137 } else if index == 13 { 117 } else { 127 }
        if grid[index] != pixel.gray(expected) { return 31 }
        index += 1
    }
    // Vertical only: the neighbour below minus the one above.
    flood(grid, 5, 5, 5, pixel.gray(100))
    grid[12] = pixel.gray(110)
    if !run(edge.EMBOSS_VERTICAL, grid, 5, 5, 5) { return 32 }
    index = 0
    while index < 25 {
        const expected: u32 = if index == 7 { 137 } else if index == 17 { 117 } else { 127 }
        if grid[index] != pixel.gray(expected) { return 33 }
        index += 1
    }
    return 0
}

// 5x5 of grey 100 with `middle` in the middle embossed at `depth`: the
// middle and the pixel below and to the right of it, mid grey elsewhere.
fn relief(grid: [*]u32, middle: u32, depth: f64, at_middle: u32, at_after: u32) -> bool {
    flood(grid, 5, 5, 5, pixel.gray(100))
    grid[12] = middle
    var params: filters.Params = undefined
    filters.defaults(edge.EMBOSS, &params)
    params.values[0] = depth
    if !filters.apply(&params, grid, 5, 5, 5) { return false }
    var index: usize = 0
    while index < 25 {
        const expected: u32 = if index == 12 { at_middle } else if index == 18 { at_after } else { 127 }
        if grid[index] != pixel.gray(expected) { return false }
        index += 1
    }
    return true
}

fn emboss(grid: [*]u32) -> u8 {
    // The difference of 10 times depth / 10 around 127.
    if !relief(grid, pixel.gray(110), 30.0, 157, 97) { return 35 }
    if !relief(grid, pixel.gray(110), 10.0, 137, 117) { return 36 }
    if !relief(grid, pixel.gray(110), 300.0, 255, 0) { return 37 }
    // Out of range and not a number: 300, 10, and the initial 30.
    if !relief(grid, pixel.gray(110), 5000.0, 255, 0) { return 38 }
    if !relief(grid, pixel.gray(110), -7.0, 137, 117) { return 39 }
    if !relief(grid, pixel.gray(110), math.nan(), 157, 97) { return 40 }
    // A half rounds upward: 1.5 becomes 2, -1.5 becomes -1.
    if !relief(grid, pixel.gray(101), 15.0, 129, 126) { return 41 }
    // On the lightness: this colour's is 91, 9 below the ground.
    if pixel.luma(pixel.rgb(200, 50, 10)) != 91 { return 42 }
    if !relief(grid, pixel.rgb(200, 50, 10), 30.0, 100, 154) { return 43 }
    // A translucent neighbour counts by its alpha: 100 * 128 / 255 is 50.
    flood(grid, 3, 3, 3, 0x0000FF00)
    grid[0] = 0x80323232
    grid[4] = pixel.gray(150)
    var params: filters.Params = undefined
    filters.defaults(edge.EMBOSS, &params)
    params.values[0] = 10.0
    if !filters.apply(&params, grid, 3, 3, 3) { return 44 }
    if grid[4] != pixel.gray(177) || grid[0] != 0x807F7F7F { return 45 }
    if grid[1] != 0 || grid[3] != 0 || grid[8] != 0 { return 46 }
    return 0
}

fn detect(pixels: [*]u32, width: usize, height: usize, stride: usize, formula: i32, output: i32, radius_x: f64, radius_y: f64, to_alpha: bool) -> bool {
    var params: filters.Params = undefined
    filters.defaults(edge.EDGE_DETECTION, &params)
    params.values[0] = @floatFromInt(f64, formula)
    params.values[1] = @floatFromInt(f64, output)
    params.values[2] = radius_x
    params.values[3] = radius_y
    params.values[4] = if to_alpha { 1.0 } else { 0.0 }
    return filters.apply(&params, pixels, width, height, stride)
}

// A grey picture rising by `dx` a column and `dy` a row from `base`.
fn ramp(pixels: [*]u32, width: usize, height: usize, base: i32, dx: i32, dy: i32) -> void {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            pixels[y * width + x] = pixel.gray(@intCast(u32, base + dx * @intCast(i32, x) + dy * @intCast(i32, y)))
            x += 1
        }
        y += 1
    }
}

// Whether every pixel that has all its neighbours is grey `expected`.
fn inner(pixels: [*]const u32, width: usize, height: usize, reach: usize, expected: u32) -> bool {
    var y = reach
    while y + reach < height {
        var x = reach
        while x + reach < width {
            if pixels[y * width + x] != pixel.gray(expected) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

fn detection(grid: [*]u32, work: [*]u32, keep: [*]u32) -> u8 {
    // A ramp of 4 a column and 3 a row: the slopes are those times the
    // kernel's weight on a ramp (6, 8 and 2), their length a 3-4-5.
    ramp(grid, 9, 9, 10, 4, 3)
    if !detect(grid, 9, 9, 9, edge.PREWITT, edge.ALL_SIDES, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 30) { return 50 }
    ramp(grid, 9, 9, 10, 4, 3)
    if !detect(grid, 9, 9, 9, edge.SOBEL, edge.ALL_SIDES, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 40) { return 51 }
    ramp(grid, 9, 9, 10, 4, 3)
    if !detect(grid, 9, 9, 9, edge.SIMPLE, edge.ALL_SIDES, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 10) { return 52 }

    // The angle: lighter to the right 128, to the left 255, downward 191,
    // upward 64, down and right 159 (an eighth of a turn), flat 128.
    ramp(grid, 9, 9, 10, 10, 0)
    if !detect(grid, 9, 9, 9, edge.SOBEL, edge.DIRECTION, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 128) { return 53 }
    ramp(grid, 9, 9, 200, -10, 0)
    if !detect(grid, 9, 9, 9, edge.SOBEL, edge.DIRECTION, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 255) { return 54 }
    ramp(grid, 9, 9, 10, 0, 10)
    if !detect(grid, 9, 9, 9, edge.PREWITT, edge.DIRECTION, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 191) { return 55 }
    ramp(grid, 9, 9, 200, 0, -10)
    if !detect(grid, 9, 9, 9, edge.SIMPLE, edge.DIRECTION, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 64) { return 56 }
    ramp(grid, 9, 9, 10, 5, 5)
    if !detect(grid, 9, 9, 9, edge.PREWITT, edge.DIRECTION, 1.0, 1.0, false) || !inner(grid, 9, 9, 1, 159) { return 57 }
    ramp(grid, 9, 9, 99, 0, 0)
    if !detect(grid, 9, 9, 9, edge.SOBEL, edge.DIRECTION, 1.0, 1.0, false) || !inner(grid, 9, 9, 0, 128) { return 58 }

    // Prewitt at radius 1 is the fixed filter of each side, on opaque and
    // on mixed pictures (two different convolutions agree).
    var kind: u32 = SOLID
    while kind <= MIXED {
        var side: i32 = edge.TOP
        while side <= edge.LEFT {
            const id = if side == edge.TOP { edge.TOP_EDGE } else if side == edge.BOTTOM { edge.BOTTOM_EDGE } else if side == edge.RIGHT { edge.RIGHT_EDGE } else { edge.LEFT_EDGE }
            noise(work, 40, 30, 40, kind, 77)
            noise(keep, 40, 30, 40, kind, 77)
            if !detect(work, 40, 30, 40, edge.PREWITT, side, 1.0, 1.0, false) || !run(id, keep, 40, 30, 40) { return 59 }
            if !same(work, keep, 1200) { return 60 }
            side += 1
        }
        kind += 1
    }

    // A hard step of 40 between columns 5 and 6, at a radius that reaches
    // two pixels: the nearest columns answer as at radius 1 (3 * 40), the
    // next ones two thirds of it, the vertical radius does not matter.
    var y: usize = 0
    while y < 8 {
        var x: usize = 0
        while x < 12 {
            grid[y * 12 + x] = pixel.gray(if x < 6 { 60 } else { 100 })
            x += 1
        }
        y += 1
    }
    copy(keep, grid, 96)
    if !detect(grid, 12, 8, 12, edge.PREWITT, edge.LEFT, 3.0, 50.0, false) { return 61 }
    y = 0
    while y < 8 {
        var x: usize = 0
        while x < 12 {
            const expected: u32 = if x == 5 || x == 6 { 247 } else if x == 4 || x == 7 { 207 } else { 127 }
            if grid[y * 12 + x] != pixel.gray(expected) { return 62 }
            x += 1
        }
        y += 1
    }
    // The right side is the left one turned round: 127 minus the same.
    copy(grid, keep, 96)
    if !detect(grid, 12, 8, 12, edge.PREWITT, edge.RIGHT, 3.0, 1.0, false) { return 63 }
    if grid[5] != pixel.gray(7) || grid[4] != pixel.gray(47) || grid[3] != pixel.gray(127) { return 64 }
    // The same picture has no upper or lower edges.
    copy(grid, keep, 96)
    if !detect(grid, 12, 8, 12, edge.SOBEL, edge.TOP, 1.0, 3.0, false) || !inner(grid, 12, 8, 0, 127) { return 65 }
    // Sobel reaching two pixels: slope weights 2 and 2 ahead, so a step of
    // 20 answers 4 * 20 beside it and half of that a column further.
    y = 0
    while y < 8 {
        var x: usize = 0
        while x < 12 {
            grid[y * 12 + x] = pixel.gray(if x < 6 { 60 } else { 80 })
            x += 1
        }
        y += 1
    }
    if !detect(grid, 12, 8, 12, edge.SOBEL, edge.LEFT, 3.0, 1.0, false) { return 66 }
    y = 0
    while y < 8 {
        var x: usize = 0
        while x < 12 {
            const expected: u32 = if x == 5 || x == 6 { 207 } else if x == 4 || x == 7 { 167 } else { 127 }
            if grid[y * 12 + x] != pixel.gray(expected) { return 67 }
            x += 1
        }
        y += 1
    }
    // A step downward at vertical radius 3 through the top filter: the
    // same numbers along the rows.
    y = 0
    while y < 12 {
        flood(grid + y * 8, 8, 1, 8, pixel.gray(if y < 6 { 60 } else { 100 }))
        y += 1
    }
    if !detect(grid, 8, 12, 8, edge.PREWITT, edge.TOP, 1.0, 3.0, false) { return 68 }
    y = 0
    while y < 12 {
        const expected: u32 = if y == 5 || y == 6 { 247 } else if y == 4 || y == 7 { 207 } else { 127 }
        if grid[y * 8] != pixel.gray(expected) || grid[y * 8 + 7] != pixel.gray(expected) { return 69 }
        y += 1
    }

    // The answer as alpha: the colour stays, the length of the slope (120
    // beside the step, nothing elsewhere) becomes the alpha.
    copy(grid, keep, 96)
    if !detect(grid, 12, 8, 12, edge.PREWITT, edge.ALL_SIDES, 1.0, 1.0, true) { return 70 }
    y = 0
    while y < 8 {
        var x: usize = 0
        while x < 12 {
            const expected: u32 = if x == 5 { 0x783C3C3C } else if x == 6 { 0x78646464 } else { 0 }
            if grid[y * 12 + x] != expected { return 71 }
            x += 1
        }
        y += 1
    }
    // What margin() says: the reach of the radius that counts.
    var params: filters.Params = undefined
    filters.defaults(edge.EDGE_DETECTION, &params)
    if filters.margin(&params) != 1 { return 72 }
    params.values[2] = 100.0
    if filters.margin(&params) != 31 { return 73 }
    params.values[1] = @floatFromInt(f64, edge.TOP)
    if filters.margin(&params) != 1 { return 74 }
    params.values[3] = 9.0
    if filters.margin(&params) != 3 { return 75 }
    params.values[3] = math.nan()
    if filters.margin(&params) != 1 { return 76 }
    return 0
}

fn highPass(grid: [*]u32) -> u8 {
    var params: filters.Params = undefined
    filters.defaults(edge.GAUSSIAN_HIGH_PASS, &params)
    // sigma 0.6: three sigmas reach two pixels.
    if filters.margin(&params) != 2 { return 80 }
    // A flat picture has nothing high in it.
    flood(grid, 12, 12, 12, 0xFF4D4D4D)
    if !filters.apply(&params, grid, 12, 12, 12) || !inner(grid, 12, 12, 0, 128) { return 81 }
    // Nor has a ramp: the bell is the same on both sides and weighs 1.
    ramp(grid, 40, 8, 20, 3, 0)
    if !filters.apply(&params, grid, 40, 8, 40) || !inner(grid, 40, 8, 2, 128) { return 82 }
    params.values[0] = 9.0
    if filters.margin(&params) != 9 { return 83 }
    ramp(grid, 40, 40, 20, 3, 2)
    if !filters.apply(&params, grid, 40, 40, 40) || !inner(grid, 40, 40, 9, 128) { return 84 }

    // One pixel 120 above a ground of 60: around it 128 minus the bell,
    // the same on all eight sides, falling away from the middle, and all
    // of it together what the middle keeps (within 1 % of 120 and the
    // rounding of 24 pixels).
    params.values[0] = 1.0
    flood(grid, 9, 9, 9, pixel.gray(60))
    grid[40] = pixel.gray(180)
    if !filters.apply(&params, grid, 9, 9, 9) { return 85 }
    var total: i32 = 0
    var y: usize = 0
    while y < 9 {
        var x: usize = 0
        while x < 9 {
            const here = grid[y * 9 + x]
            if here != grid[x * 9 + y] || here != grid[(8 - y) * 9 + x] || here != grid[y * 9 + 8 - x] { return 86 }
            if here != pixel.gray(pixel.value(here)) { return 87 }
            const dx = if x < 4 { 4 - x } else { x - 4 }
            const dy = if y < 4 { 4 - y } else { y - 4 }
            if (dx > 2 || dy > 2) && here != pixel.gray(128) { return 88 }
            total += @intCast(i32, pixel.value(here)) - 128
            x += 1
        }
        y += 1
    }
    if total < -5 || total > 5 { return 89 }
    // A bell up to a reach of 12; beyond it three boxes, as wide together
    // as their variance says: 4 + 4 + 3 at radius 13, 30 + 30 + 29 at 100.
    params.values[0] = 12.0
    if filters.margin(&params) != 12 { return 92 }
    params.values[0] = 13.0
    if filters.margin(&params) != 11 { return 93 }
    params.values[0] = 100.0
    if filters.margin(&params) != 89 { return 94 }
    const middle = pixel.value(grid[40])
    const beside = pixel.value(grid[41])
    const corner = pixel.value(grid[50])
    const further = pixel.value(grid[42])
    // sigma 0.6: the bell's middle weighs 0.4407 of the 120 (the middle
    // keeps 67 of them), a pixel beside it 0.1099.
    if middle != 195 || beside != 115 { return 90 }
    if !(beside < corner && corner < further && further <= 128) { return 91 }
    return 0
}

fn normalOf(pixels: [*]u32, width: usize, height: usize, formula: i32, red: f64, green: f64, blue: f64) -> bool {
    var params: filters.Params = undefined
    filters.defaults(edge.HEIGHT_TO_NORMAL, &params)
    params.values[0] = @floatFromInt(f64, formula)
    params.values[3] = red
    params.values[4] = green
    params.values[5] = blue
    return filters.apply(&params, pixels, width, height, width)
}

fn normals(grid: [*]u32) -> u8 {
    // Flat: the normal points out of the picture.
    flood(grid, 9, 9, 9, 0xFF336699)
    if !run(edge.HEIGHT_TO_NORMAL, grid, 9, 9, 9) { return 95 }
    var index: usize = 0
    while index < 81 {
        if grid[index] != 0xFF8080FF { return 96 }
        index += 1
    }
    // Rising by 16 a column, Sobel: a slope of 8 * 16 / 255, the normal
    // leans left by 0.4486 and stands 0.8937 high.
    ramp(grid, 9, 9, 10, 16, 0)
    if !normalOf(grid, 9, 9, edge.SOBEL, 0.0, 2.0, 4.0) { return 97 }
    const slope = 128.0 / 255.0
    const length = math.sqrt(1.0 + slope * slope)
    const lean = @intFromFloat(u32, 128.0 - 127.5 * slope / length)
    const stand = @intFromFloat(u32, 128.0 + 127.5 / length)
    if lean != 70 || stand != 241 { return 98 }
    if grid[40] != pixel.rgb(70, 128, 241) || grid[10] != pixel.rgb(70, 128, 241) { return 99 }
    // Rising by 16 a row: the normal leans up (Y+ is lighter).
    ramp(grid, 9, 9, 10, 0, 16)
    if !normalOf(grid, 9, 9, edge.SOBEL, 0.0, 2.0, 4.0) { return 100 }
    if grid[40] != pixel.rgb(128, 185, 241) { return 101 }
    // The channels show what they are told: Z+, X-, Y-.
    ramp(grid, 9, 9, 10, 16, 0)
    if !normalOf(grid, 9, 9, edge.SOBEL, 4.0, 1.0, 3.0) { return 102 }
    if grid[40] != pixel.rgb(241, 185, 128) { return 103 }
    // Z-: the flat normal is black there. Prewitt weighs a ramp 6 times.
    ramp(grid, 9, 9, 10, 16, 0)
    if !normalOf(grid, 9, 9, edge.PREWITT, 5.0, 5.0, 0.0) { return 104 }
    const gentle = 96.0 / 255.0
    const shorter = math.sqrt(1.0 + gentle * gentle)
    if grid[40] != pixel.rgb(@intFromFloat(u32, 128.0 - 127.5 / shorter), @intFromFloat(u32, 128.0 - 127.5 / shorter), @intFromFloat(u32, 128.0 - 127.5 * gentle / shorter)) { return 105 }
    // The height is the lightness, whatever the colour, and alpha stays.
    flood(grid, 9, 9, 9, 0x80FF0000)
    if !run(edge.HEIGHT_TO_NORMAL, grid, 9, 9, 9) || grid[40] != 0x808080FF { return 106 }
    return 0
}

// The quotient rounded to the nearest whole number, halves upward, on
// both sides of zero.
fn rounded(numerator: i64, divisor: i64) -> i64 {
    const twice = numerator * 2 + divisor
    var quotient = twice / (divisor * 2)
    if twice % (divisor * 2) < 0 { quotient -= 1 }
    return quotient
}

// What the module says a pixel becomes, written out: the neighbour `dx`
// to the right and `dy` below weighs along[dx + reach] * across[dy +
// reach] (beyond the picture: its nearest pixel), the pixel itself
// `center` more; a neighbour counts by its alpha and what it lacks is the
// pixel's own colour; one division, halves upward; alpha stays, nothing
// stays nothing.
fn ruled(source: [*]const u32, width: usize, height: usize, x: usize, y: usize, along: [*]const i64, across: [*]const i64, reach: usize, center: i64, divisor: i64, offset: i64) -> u32 {
    const own = source[y * width + x]
    if own >> 24 == 0 { return 0 }
    var made = own & 0xFF000000
    var shift: u5 = 0
    while shift < 24 {
        const mine = @intCast(i64, (own >> shift) & 255)
        var sum: i64 = 0
        var total: i64 = center
        var row: usize = 0
        while row <= reach * 2 {
            const from_y = if y + row < reach { 0 } else if y + row - reach >= height { height - 1 } else { y + row - reach }
            var column: usize = 0
            while column <= reach * 2 {
                const from_x = if x + column < reach { 0 } else if x + column - reach >= width { width - 1 } else { x + column - reach }
                const other = source[from_y * width + from_x]
                const weight = along[column] * across[row]
                sum += weight * @intCast(i64, other >> 24) * (@intCast(i64, (other >> shift) & 255) - mine)
                total += weight
                column += 1
            }
            row += 1
        }
        const value = rounded(sum + total * 255 * mine, divisor * 255) + offset
        made |= @intCast(u32, if value < 0 { 0 } else if value > 255 { 255 } else { value }) << shift
        shift += 8
    }
    return made
}

fn obeys(result: [*]const u32, source: [*]const u32, width: usize, height: usize, along: [*]const i64, across: [*]const i64, reach: usize, center: i64, divisor: i64, offset: i64) -> bool {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            if result[y * width + x] != ruled(source, width, height, x, y, along, across, reach, center, divisor, offset) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// Filters against the rule written out, on opaque and on mixed pictures.
fn rule(work: [*]u32, keep: [*]u32) -> u8 {
    const width: usize = 29
    const height: usize = 23
    var along: [64]i64 = undefined
    var across: [64]i64 = undefined
    var kind: u32 = SOLID
    while kind <= MIXED {
        noise(keep, width, height, width, kind, 41)
        // Left Edge Detection: the right neighbours minus the left ones.
        along[0] = -1
        along[1] = 0
        along[2] = 1
        across[0] = 1
        across[1] = 1
        across[2] = 1
        copy(work, keep, width * height)
        if !run(edge.LEFT_EDGE, work, width, height, width) || !obeys(work, keep, width, height, &along, &across, 1, 0, 1, 127) { return 201 }
        // Emboss in All Directions: nine times the pixel minus all nine.
        along[0] = 1
        along[2] = 1
        along[1] = 1
        across[0] = -1
        across[1] = -1
        across[2] = -1
        copy(work, keep, width * height)
        if !run(edge.EMBOSS_ALL, work, width, height, width) || !obeys(work, keep, width, height, &along, &across, 1, 9, 1, 127) { return 202 }
        // Edge Detection, Sobel, left side, reaching two pixels: slopes 2
        // and 2 ahead, the bell 8 13 16 13 8 four times, divided by their
        // 4 * 58.
        along[0] = -2
        along[1] = -2
        along[2] = 0
        along[3] = 2
        along[4] = 2
        across[0] = 32
        across[1] = 52
        across[2] = 64
        across[3] = 52
        across[4] = 32
        copy(work, keep, width * height)
        if !detect(work, width, height, width, edge.SOBEL, edge.LEFT, 3.0, 1.0, false) || !obeys(work, keep, width, height, &along, &across, 2, 0, 232, 127) { return 203 }
        // The top side of the same: the two kernels change places.
        copy(work, keep, width * height)
        if !detect(work, width, height, width, edge.SOBEL, edge.TOP, 1.0, 3.0, false) || !obeys(work, keep, width, height, &across, &along, 2, 0, 232, 127) { return 204 }
        // Gaussian High Pass at radius 13: boxes of 9, 9 and 7 pixels
        // after one another, each way; the pixel as heavy as all of them.
        var index: usize = 0
        while index < 23 {
            along[index] = 0
            index += 1
        }
        along[11] = 1
        var box: usize = 0
        while box < 3 {
            const m: usize = if box < 2 { 4 } else { 3 }
            index = 0
            while index < 23 {
                var sum: i64 = 0
                var tap: usize = 0
                while tap <= m * 2 {
                    if index + tap >= m && index + tap - m < 23 { sum += along[index + tap - m] }
                    tap += 1
                }
                across[index] = sum
                index += 1
            }
            index = 0
            while index < 23 {
                along[index] = across[index]
                index += 1
            }
            box += 1
        }
        if along[0] != 1 || along[1] != 3 || along[10] != 50 || along[11] != 51 || along[22] != 1 { return 205 }
        index = 0
        while index < 23 {
            across[index] = -along[index]
            index += 1
        }
        var params: filters.Params = undefined
        filters.defaults(edge.GAUSSIAN_HIGH_PASS, &params)
        params.values[0] = 13.0
        copy(work, keep, width * height)
        if !filters.apply(&params, work, width, height, width) || !obeys(work, keep, width, height, &along, &across, 11, 567 * 567, 567 * 567, 128) { return 206 }
        kind += 1
    }
    return 0
}

// One picture of `kind` through a filter, the picture inside a frame of
// other words: the frame stays, what was transparent is 0, alpha stays
// (or, where the filter writes it, does not grow and keeps the colour).
fn trial(params: *const filters.Params, width: usize, height: usize, kind: u32, seed: u64, work: [*]u32, keep: [*]u32) -> bool {
    const stride = width + 3
    const count = stride * (height + 2)
    var index: usize = 0
    while index < count {
        work[index] = SENTINEL
        index += 1
    }
    noise(work + stride, width, height, stride, kind, seed)
    copy(keep, work, count)
    if !filters.apply(params, work + stride, width, height, stride) { return false }
    var to_alpha = false
    if params.*.id == edge.EDGE_DETECTION && params.*.values[4] >= 0.5 { to_alpha = true }
    index = 0
    while index < count {
        const before = keep[index]
        const after = work[index]
        const y = index / stride
        const x = index % stride
        if y == 0 || y > height || x >= width {
            if after != SENTINEL { return false }
        } else if before >> 24 == 0 {
            if after != 0 { return false }
        } else if to_alpha {
            if after >> 24 > before >> 24 { return false }
            if after >> 24 == 0 && after != 0 { return false }
            if after >> 24 != 0 && (after & 0x00FFFFFF) != (before & 0x00FFFFFF) { return false }
        } else if after >> 24 != before >> 24 {
            return false
        }
        index += 1
    }
    return true
}

const WIDTHS = [4]usize{ 1, 1, 9, 257 }
const HEIGHTS = [4]usize{ 1, 9, 1, 130 }

fn trials(params: *const filters.Params, work: [*]u32, keep: [*]u32) -> bool {
    var size: usize = 0
    while size < 4 {
        var kind: u32 = CLEAR
        while kind <= MIXED {
            if !trial(params, WIDTHS[size], HEIGHTS[size], kind, @intCast(u64, size) * 3 + @intCast(u64, kind) + 1, work, keep) { return false }
            kind += 1
        }
        size += 1
    }
    return true
}

// Every filter at its initial values, at its parameters' ends (all
// combinations up to four parameters, each alone above that) and with
// each parameter not a number.
fn sweep(work: [*]u32, keep: [*]u32) -> u8 {
    var index: usize = 0
    while index < 14 {
        const info = filters.find(MINE[index]).?
        const count = info.*.params.length
        var params: filters.Params = undefined
        filters.defaults(MINE[index], &params)
        if !trials(&params, work, keep) { return 110 }
        if count <= 4 {
            var mask: usize = 0
            while mask < (@intCast(usize, 1) << @intCast(u6, count)) {
                var place: usize = 0
                while place < count {
                    params.values[place] = if (mask >> @intCast(u6, place)) & 1 != 0 { info.*.params[place].high } else { info.*.params[place].low }
                    place += 1
                }
                if !trials(&params, work, keep) { return 111 }
                mask += 1
            }
        } else {
            var place: usize = 0
            while place < count {
                filters.defaults(MINE[index], &params)
                params.values[place] = info.*.params[place].low
                if !trials(&params, work, keep) { return 112 }
                params.values[place] = info.*.params[place].high
                if !trials(&params, work, keep) { return 113 }
                place += 1
            }
        }
        var place: usize = 0
        while place < count {
            filters.defaults(MINE[index], &params)
            params.values[place] = math.nan()
            if !trials(&params, work, keep) { return 114 }
            // Not a number is the initial value: the same pixels.
            noise(work, 31, 17, 31, MIXED, 5)
            noise(keep, 31, 17, 31, MIXED, 5)
            if !filters.apply(&params, work, 31, 17, 31) || !run(MINE[index], keep, 31, 17, 31) || !same(work, keep, 527) { return 115 }
            // Far outside is the nearest end.
            filters.defaults(MINE[index], &params)
            params.values[place] = 1.0e300
            noise(work, 31, 17, 31, MIXED, 6)
            if !filters.apply(&params, work, 31, 17, 31) { return 116 }
            params.values[place] = info.*.params[place].high
            noise(keep, 31, 17, 31, MIXED, 6)
            if !filters.apply(&params, keep, 31, 17, 31) || !same(work, keep, 527) { return 117 }
            params.values[place] = -math.infinity()
            noise(work, 31, 17, 31, MIXED, 6)
            if !filters.apply(&params, work, 31, 17, 31) { return 118 }
            params.values[place] = info.*.params[place].low
            noise(keep, 31, 17, 31, MIXED, 6)
            if !filters.apply(&params, keep, 31, 17, 31) || !same(work, keep, 527) { return 119 }
            place += 1
        }
        index += 1
    }
    return 0
}

// An opaque red square on a transparent ground that has green left in
// it: inside the square every filter answers what it answers on a picture
// all red (the ground is no edge and gives no colour), outside nothing.
fn bleed(work: [*]u32, keep: [*]u32) -> u8 {
    var index: usize = 0
    while index < 14 {
        flood(work, 24, 24, 24, 0x0000FF00)
        flood(work + 8 * 24 + 8, 8, 8, 24, 0xFFFF0000)
        flood(keep, 24, 24, 24, 0xFFFF0000)
        if !run(MINE[index], work, 24, 24, 24) || !run(MINE[index], keep, 24, 24, 24) { return 120 }
        var y: usize = 0
        while y < 24 {
            var x: usize = 0
            while x < 24 {
                const inside = x >= 8 && x < 16 && y >= 8 && y < 16
                if inside && work[y * 24 + x] != keep[y * 24 + x] { return 121 }
                if !inside && work[y * 24 + x] != 0 { return 122 }
                x += 1
            }
            y += 1
        }
        index += 1
    }
    // What that is: mid grey for the kernels around 127, black for the
    // slopes' length, the flat normal, the high pass's 128.
    flood(keep, 24, 24, 24, 0xFFFF0000)
    if !run(edge.EMBOSS_ALL, keep, 24, 24, 24) || keep[100] != 0xFF7F7F7F { return 123 }
    flood(keep, 24, 24, 24, 0xFFFF0000)
    if !run(edge.EDGE_DETECTION, keep, 24, 24, 24) || keep[100] != 0xFF000000 { return 124 }
    flood(keep, 24, 24, 24, 0xFFFF0000)
    if !run(edge.GAUSSIAN_HIGH_PASS, keep, 24, 24, 24) || keep[100] != 0xFF808080 { return 125 }
    return 0
}

// A picture of noise, opaque in its left part and transparent (with
// colour left in it) in its lower right corner, so that of the blocks of
// 256 one is opaque with all its margin, one transparent, the others
// mixed: a filter that takes a shorter way through such blocks has to
// arrive at the same pixels.
fn landscape(pixels: [*]u32, width: usize, height: usize) -> void {
    noise(pixels, width, height, width, MIXED, 99)
    var state: u64 = 4711
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            if x < 420 { pixels[y * width + x] = next(&state) | 0xFF000000 }
            if x > 420 && y > 400 { pixels[y * width + x] &= 0x00FFFFFF }
            x += 1
        }
        y += 1
    }
}

// The picture filtered whole equals the picture filtered as the
// compositor does it: in blocks of 256, each with margin() more around
// it (as far as the picture goes), the block cut out of the answer.
fn pieces(params: *const filters.Params, source: [*]const u32, whole: [*]u32, parts: [*]u32, block: [*]u32, width: usize, height: usize) -> bool {
    copy(whole, source, width * height)
    if !filters.apply(params, whole, width, height, width) { return false }
    const reach = @intCast(usize, filters.margin(params))
    var top: usize = 0
    while top < height {
        const tall = if height - top < 256 { height - top } else { 256 }
        var left: usize = 0
        while left < width {
            const broad = if width - left < 256 { width - left } else { 256 }
            const x0 = if left < reach { 0 } else { left - reach }
            const y0 = if top < reach { 0 } else { top - reach }
            const x1 = if left + broad + reach > width { width } else { left + broad + reach }
            const y1 = if top + tall + reach > height { height } else { top + tall + reach }
            const stride = x1 - x0
            var y = y0
            while y < y1 {
                copy(block + (y - y0) * stride, source + y * width + x0, stride)
                y += 1
            }
            if !filters.apply(params, block, stride, y1 - y0, stride) { return false }
            y = top
            while y < top + tall {
                copy(parts + y * width + left, block + (y - y0) * stride + (left - x0), broad)
                y += 1
            }
            left += broad
        }
        top += tall
    }
    return same(whole, parts, width * height)
}

fn blocks(source: [*]u32, whole: [*]u32, parts: [*]u32, block: [*]u32) -> u8 {
    const width: usize = 700
    const height: usize = 600
    landscape(source, width, height)
    var params: filters.Params = undefined
    var index: usize = 0
    while index < 14 {
        filters.defaults(MINE[index], &params)
        if !pieces(&params, source, whole, parts, block, width, height) { return 130 }
        index += 1
    }
    filters.defaults(edge.EDGE_DETECTION, &params)
    params.values[0] = @floatFromInt(f64, edge.SOBEL)
    params.values[2] = 7.0
    params.values[3] = 20.0
    if filters.margin(&params) != 7 || !pieces(&params, source, whole, parts, block, width, height) { return 131 }
    params.values[0] = @floatFromInt(f64, edge.SIMPLE)
    params.values[1] = @floatFromInt(f64, edge.DIRECTION)
    params.values[2] = 5.0
    if !pieces(&params, source, whole, parts, block, width, height) { return 132 }
    params.values[0] = @floatFromInt(f64, edge.PREWITT)
    params.values[1] = @floatFromInt(f64, edge.TOP)
    params.values[3] = 100.0
    params.values[4] = 1.0
    if filters.margin(&params) != 31 || !pieces(&params, source, whole, parts, block, width, height) { return 133 }
    params.values[0] = @floatFromInt(f64, edge.SOBEL)
    params.values[1] = @floatFromInt(f64, edge.RIGHT)
    params.values[2] = 40.0
    params.values[4] = 0.0
    if filters.margin(&params) != 13 || !pieces(&params, source, whole, parts, block, width, height) { return 134 }
    filters.defaults(edge.GAUSSIAN_HIGH_PASS, &params)
    params.values[0] = 10.0
    if filters.margin(&params) != 10 || !pieces(&params, source, whole, parts, block, width, height) { return 135 }
    params.values[0] = 40.0
    if filters.margin(&params) != 35 || !pieces(&params, source, whole, parts, block, width, height) { return 139 }
    filters.defaults(edge.HEIGHT_TO_NORMAL, &params)
    params.values[0] = @floatFromInt(f64, edge.PREWITT)
    params.values[1] = 10.0
    params.values[2] = 4.0
    params.values[3] = 3.0
    if filters.margin(&params) != 4 || !pieces(&params, source, whole, parts, block, width, height) { return 136 }
    filters.defaults(edge.EMBOSS, &params)
    params.values[0] = 300.0
    if !pieces(&params, source, whole, parts, block, width, height) { return 137 }
    // The same numbers, the same pixels: twice from one picture.
    index = 0
    while index < 14 {
        copy(whole, source, width * height)
        copy(parts, source, width * height)
        if !run(MINE[index], whole, width, height, width) || !run(MINE[index], parts, width, height, width) || !same(whole, parts, width * height) { return 138 }
        index += 1
    }
    return 0
}

const ONES = [3]i32{ 1, 1, 1 }
const BINOMIAL = [3]i32{ 1, 2, 1 }
const FIRST = [3]i32{ 1, 0, 0 }
const LAST = [3]i32{ 0, 0, 1 }
const ONE = [1]i32{1}
const EVEN = [2]i32{ 1, 1 }
const HEAVY = [3]i32{ 20000, 20000, 20000 }

// The two convolutions by themselves.
fn cores(grid: [*]u32, work: [*]u32, keep: [*]u32) -> u8 {
    // Only the channel named takes the answer.
    var twice = edge.Kernel3.{ .weights = [9]i32{ 0, 0, 0, 0, 2, 0, 0, 0, 0 }, .divisor = 1, .offset = 0, .channels = edge.CHANNEL_RED }
    flood(grid, 4, 4, 4, 0xFF405060)
    grid[5] = 0xFF906070
    if !edge.convolve3(grid, 4, 4, 4, &twice) || grid[0] != 0xFF805060 || grid[5] != 0xFFFF6070 { return 140 }
    twice.channels = edge.CHANNEL_GREEN | edge.CHANNEL_BLUE
    twice.offset = -100
    if !edge.convolve3(grid, 4, 4, 4, &twice) || grid[0] != 0xFF803C5C || grid[5] != 0xFFFF5C7C { return 141 }
    // The lightness as a grey, to all channels or to one.
    var gray = edge.Kernel3.{ .weights = [9]i32{ 0, 0, 0, 0, 1, 0, 0, 0, 0 }, .divisor = 1, .offset = 0, .channels = edge.COLOR | edge.GRAY }
    flood(grid, 4, 4, 4, 0xFFC8320A)
    if !edge.convolve3(grid, 4, 4, 4, &gray) || grid[7] != 0xFF5B5B5B { return 142 }
    gray.channels = edge.CHANNEL_GREEN | edge.GRAY
    flood(grid, 4, 4, 4, 0x80C8320A)
    if !edge.convolve3(grid, 4, 4, 4, &gray) || grid[7] != 0x80C85B0A { return 143 }
    // No divisor, no channels.
    gray.divisor = 0
    if edge.convolve3(grid, 4, 4, 4, &gray) || grid[7] != 0x80C85B0A { return 144 }
    gray.divisor = 1
    gray.channels = edge.GRAY
    if !edge.convolve3(grid, 4, 4, 4, &gray) || grid[7] != 0x80C85B0A { return 145 }
    // The divisor rounds halves upward on both sides of zero.
    var halves = edge.Kernel3.{ .weights = [9]i32{ 0, 0, 0, 0, 1, 0, 0, 0, 0 }, .divisor = 2, .offset = 0, .channels = edge.COLOR }
    flood(grid, 4, 4, 4, 0xFF030405)
    if !edge.convolve3(grid, 4, 4, 4, &halves) || grid[3] != 0xFF020203 { return 146 }
    halves.weights[4] = -1
    halves.offset = 10
    flood(grid, 4, 4, 4, 0xFF030405)
    if !edge.convolve3(grid, 4, 4, 4, &halves) || grid[3] != 0xFF090808 { return 147 }

    // A box blur of one pixel of 90 on black spreads evenly: nine tens.
    var box = edge.Separable.{ .along = ONES[0..], .across = ONES[0..], .center = 0, .divisor = 9, .offset = 0, .channels = edge.COLOR }
    flood(grid, 7, 7, 7, 0xFF000000)
    grid[24] = 0xFF5A5A5A
    if !edge.convolveSeparable(grid, 7, 7, 7, &box) { return 148 }
    var index: usize = 0
    while index < 49 {
        const x = index % 7
        const y = index / 7
        const expected: u32 = if x >= 2 && x <= 4 && y >= 2 && y <= 4 { 10 } else { 0 }
        if grid[index] != pixel.gray(expected) { return 149 }
        index += 1
    }
    // A binomial blur of 160: 40 in the middle, 20 beside, 10 diagonal.
    box.along = BINOMIAL[0..]
    box.across = BINOMIAL[0..]
    box.divisor = 16
    flood(grid, 7, 7, 7, 0xFF000000)
    grid[24] = 0xFFA0A0A0
    if !edge.convolveSeparable(grid, 7, 7, 7, &box) { return 150 }
    if grid[24] != pixel.gray(40) || grid[23] != pixel.gray(20) || grid[31] != pixel.gray(20) || grid[16] != pixel.gray(10) || grid[32] != pixel.gray(10) || grid[22] != pixel.gray(0) { return 151 }
    // Which way a kernel is turned: the weight written first meets the
    // pixel after this one (right, below), the last the one before; the
    // picture's ends are their own neighbours.
    box.along = FIRST[0..]
    box.across = ONE[0..]
    box.divisor = 1
    ramp(grid, 5, 5, 10, 10, 1)
    if !edge.convolveSeparable(grid, 5, 5, 5, &box) || grid[0] != pixel.gray(20) || grid[3] != pixel.gray(50) || grid[4] != pixel.gray(50) || grid[9] != pixel.gray(51) { return 152 }
    box.along = ONE[0..]
    box.across = LAST[0..]
    ramp(grid, 5, 5, 10, 1, 10)
    if !edge.convolveSeparable(grid, 5, 5, 5, &box) || grid[0] != pixel.gray(10) || grid[5] != pixel.gray(10) || grid[10] != pixel.gray(20) || grid[24] != pixel.gray(44) { return 153 }
    var corner = edge.Kernel3.{ .weights = [9]i32{ 1, 0, 0, 0, 0, 0, 0, 0, 0 }, .divisor = 1, .offset = 0, .channels = edge.COLOR }
    ramp(grid, 5, 5, 10, 1, 10)
    if !edge.convolve3(grid, 5, 5, 5, &corner) || grid[0] != pixel.gray(21) || grid[6] != pixel.gray(32) || grid[24] != pixel.gray(54) || grid[19] != pixel.gray(54) { return 154 }
    // The weight for the pixel itself: the sum of a row of three minus
    // three times the pixel, on a ramp of 7 a column: nothing, but at the
    // ends, where a neighbour is the pixel again.
    box.along = ONES[0..]
    box.across = ONE[0..]
    box.center = -3
    box.divisor = 1
    box.offset = 100
    ramp(grid, 5, 1, 10, 7, 0)
    if !edge.convolveSeparable(grid, 5, 1, 5, &box) || grid[0] != pixel.gray(107) || grid[2] != pixel.gray(100) || grid[4] != pixel.gray(93) { return 155 }
    // Kernels that cannot be: an even number of weights, too heavy.
    box.center = 0
    box.along = EVEN[0..]
    ramp(grid, 5, 5, 10, 1, 10)
    if edge.convolveSeparable(grid, 5, 5, 5, &box) || grid[24] != pixel.gray(54) { return 156 }
    box.along = HEAVY[0..]
    if edge.convolveSeparable(grid, 5, 5, 5, &box) || grid[24] != pixel.gray(54) { return 157 }

    // The kernel that is the pixel itself changes nothing, bit for bit,
    // but that a transparent pixel is stored as 0.
    var itself = edge.Kernel3.{ .weights = [9]i32{ 0, 0, 0, 0, 1, 0, 0, 0, 0 }, .divisor = 1, .offset = 0, .channels = edge.COLOR }
    box.along = ONE[0..]
    box.across = ONE[0..]
    box.offset = 0
    var kind: u32 = SOLID
    while kind <= MIXED {
        var core: u32 = 0
        while core < 2 {
            noise(work, 50, 40, 50, kind, 31)
            copy(keep, work, 2000)
            if core == 0 {
                if !edge.convolve3(work, 50, 40, 50, &itself) { return 158 }
            } else if !edge.convolveSeparable(work, 50, 40, 50, &box) {
                return 159
            }
            index = 0
            while index < 2000 {
                const expected = if keep[index] >> 24 == 0 { 0 } else { keep[index] }
                if work[index] != expected { return 160 }
                index += 1
            }
            core += 1
        }
        kind += 1
    }
    // A blur of translucent pixels weighs colour by alpha: a red pixel at
    // alpha 51 beside an opaque blue one moves it a fifth as far as an
    // opaque red one would (255 / 3 / 5 = 17).
    box.along = ONES[0..]
    box.divisor = 3
    grid[0] = 0x33FF0000
    grid[1] = 0xFF0000FF
    grid[2] = 0xFF0000FF
    if !edge.convolveSeparable(grid, 3, 1, 3, &box) || grid[1] != 0xFF1100EE || grid[2] != 0xFF0000FF { return 161 }
    return 0
}

// Megapixels a second, with one decimal.
fn report(name: []const u8, count: usize, milliseconds: usize) -> void {
    const elapsed = if milliseconds == 0 { 1 } else { milliseconds }
    const tenths = count / (elapsed * 100)
    _ = std.io.print(name)
    _ = std.io.print(": ")
    _ = std.io.writeUnsigned(std.io.stdout(), tenths / 10)
    _ = std.io.print(".")
    _ = std.io.writeUnsigned(std.io.stdout(), tenths % 10)
    _ = std.io.print(" megapixels a second\n")
}

fn timed(name: []const u8, params: *const filters.Params, pixels: [*]u32, source: [*]const u32, width: usize, height: usize) -> bool {
    copy(pixels, source, width * height)
    const before = std.time.milliseconds()
    if !filters.apply(params, pixels, width, height, width) { return false }
    report(name, width * height, std.time.milliseconds() - before)
    return true
}

fn speed(pixels: [*]u32, source: [*]u32) -> u8 {
    const width: usize = 1024
    const height: usize = 1024
    var params: filters.Params = undefined
    var kind: u32 = SOLID
    while kind <= MIXED {
        noise(source, width, height, width, kind, 12)
        _ = std.io.print(if kind == SOLID { "an opaque megapixel\n" } else { "a megapixel with transparency\n" })
        filters.defaults(edge.TOP_EDGE, &params)
        if !timed("  Top Edge Detection", &params, pixels, source, width, height) { return 170 }
        filters.defaults(edge.EMBOSS_ALL, &params)
        if !timed("  Emboss in All Directions", &params, pixels, source, width, height) { return 171 }
        filters.defaults(edge.EMBOSS, &params)
        if !timed("  Emboss with Variable Depth", &params, pixels, source, width, height) { return 172 }
        filters.defaults(edge.EDGE_DETECTION, &params)
        if !timed("  Edge Detection (Prewitt, all sides, radius 1)", &params, pixels, source, width, height) { return 173 }
        params.values[0] = @floatFromInt(f64, edge.SOBEL)
        params.values[2] = 20.0
        params.values[3] = 20.0
        if !timed("  Edge Detection (Sobel, all sides, radius 20)", &params, pixels, source, width, height) { return 174 }
        params.values[1] = @floatFromInt(f64, edge.DIRECTION)
        params.values[2] = 1.0
        params.values[3] = 1.0
        if !timed("  Edge Detection (Sobel, direction, radius 1)", &params, pixels, source, width, height) { return 175 }
        params.values[1] = @floatFromInt(f64, edge.TOP)
        if !timed("  Edge Detection (Sobel, top, radius 1)", &params, pixels, source, width, height) { return 176 }
        filters.defaults(edge.GAUSSIAN_HIGH_PASS, &params)
        if !timed("  Gaussian High Pass (radius 1)", &params, pixels, source, width, height) { return 177 }
        params.values[0] = 10.0
        if !timed("  Gaussian High Pass (radius 10)", &params, pixels, source, width, height) { return 178 }
        params.values[0] = 100.0
        if !timed("  Gaussian High Pass (radius 100)", &params, pixels, source, width, height) { return 179 }
        filters.defaults(edge.HEIGHT_TO_NORMAL, &params)
        if !timed("  Height to Normal Map (Sobel, radius 1)", &params, pixels, source, width, height) { return 180 }
        kind += 1
    }
    return 0
}

// 50 applications of a filter (and as many askings for its margin) leave
// the value arena where it was. The filter is called as the registry
// calls it, but looked up once before: the registry's own find() takes
// arena memory at every call (a copy of the modules' constant tables),
// which is not the filters'.
fn steady(params: *const filters.Params, work: [*]u32) -> bool {
    const info = filters.find(params.*.id).?
    const base = turns.locate()
    const before = turns.used(base)
    var round: usize = 0
    while round < 50 {
        noise(work, 64, 64, 64, if round & 1 == 0 { SOLID } else { MIXED }, 3)
        info.*.apply(params, work, 64, 64, 64)
        if info.*.margin.?(params) < 1 { return false }
        round += 1
    }
    return turns.used(base) - before <= 256
}

fn arena(work: [*]u32) -> u8 {
    var params: filters.Params = undefined
    var index: usize = 0
    while index < 14 {
        filters.defaults(MINE[index], &params)
        if !steady(&params, work) { return 190 }
        index += 1
    }
    filters.defaults(edge.EDGE_DETECTION, &params)
    params.values[0] = @floatFromInt(f64, edge.SOBEL)
    params.values[1] = @floatFromInt(f64, edge.BOTTOM)
    params.values[3] = 30.0
    params.values[4] = 1.0
    if !steady(&params, work) { return 191 }
    params.values[1] = @floatFromInt(f64, edge.DIRECTION)
    if !steady(&params, work) { return 192 }
    filters.defaults(edge.GAUSSIAN_HIGH_PASS, &params)
    params.values[0] = 60.0
    if !steady(&params, work) { return 193 }
    filters.defaults(edge.HEIGHT_TO_NORMAL, &params)
    params.values[1] = 15.0
    params.values[3] = 5.0
    if !steady(&params, work) { return 194 }
    return 0
}

pub fn main() -> u8 {
    const pool = scratch.common()
    const start = scratch.mark(pool)
    const grid = words(4096)
    const work = words(40000)
    const keep = words(40000)
    const large = words(1048576)
    const source = words(1048576)
    const parts = words(420000)
    const block = words(200000)

    var failed = wiring()
    if failed != 0 { return failed }
    failed = kernels(grid)
    if failed != 0 { return failed }
    failed = emboss(grid)
    if failed != 0 { return failed }
    failed = detection(grid, work, keep)
    if failed != 0 { return failed }
    failed = highPass(grid)
    if failed != 0 { return failed }
    failed = normals(grid)
    if failed != 0 { return failed }
    failed = cores(grid, work, keep)
    if failed != 0 { return failed }
    failed = rule(work, keep)
    if failed != 0 { return failed }
    failed = sweep(work, keep)
    if failed != 0 { return failed }
    failed = bleed(work, keep)
    if failed != 0 { return failed }
    failed = blocks(source, large, parts, block)
    if failed != 0 { return failed }
    failed = arena(work)
    if failed != 0 { return failed }
    failed = speed(large, source)
    if failed != 0 { return failed }

    // Whatever the filters took of the scratch pool they gave back.
    const end = scratch.mark(pool)
    if end.block != start.block || end.used != start.used { return 200 }
    return 13
}
