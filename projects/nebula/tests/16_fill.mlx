// nebula's bucket (core/fill.mlx): the region of a place found by colour.
// A closed outline holds a fill in and out, a gap of one pixel across a
// corner leaks only with diagonal neighbours; the threshold on a gradient
// (colour and alpha) counts exactly, softness gives the amounts it says,
// what is transparent has no colour; a place outside the area, an area
// of one pixel and of none; 4096 x 4096 of nothing in well under a second
// (the times are printed), tiles of one colour, a spiral maze, a comb
// that makes the list of rows grow and a list that cannot grow (nothing
// found, no crash); the boundary colour, every similar pixel wherever it
// is; grown, shrunk and feathered (the Gaussian and, for a large feather,
// the three means), at the image's edge both ways, more than the most;
// the regions inside a drawn shape by each method and the methods'
// names; painting with an opacity, a selection, a pattern and its
// offset, erasing, alpha locked, undone; negative coordinates, a moved
// layer and a moved mask; 300 pictures at random against the plain way
// to a region, pixel for pixel; and 200 fills take nothing of the value
// arena. Then the ends: areas of one pixel on either side of the tiles'
// borders, a wall on a tile's edge and a line through its corner, the
// amounts at the ends of the threshold, a transparent boundary, areas of
// no size, places a billion pixels out, patterns from the ends of i32 and
// bounds of the whole plane; a change open on the mask (undone and
// redone exactly) and on the sample (nothing recorded), the same twice,
// masks whose default is everything; the heap given back; against plain
// ways again: enclosed() by every method (400 pictures), region() and
// similar() on areas either side of 64 and 128 grown by up to 12,
// feathering against the float sums (the Gaussian within a level, the
// three means within three and within six of the Gaussian), paint()
// and paintPattern() against blend.blendPixelAt pixel for pixel (150);
// and 3000 more of every kind take nothing of the value arena. Exits 13.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")
const fill = @import("../core/fill.mlx")

const BLACK: u32 = 0xFF000000
const RED: u32 = 0xFFFF0000
const GREEN: u32 = 0xFF00FF00
const BLUE: u32 = 0xFF0000FF
const WHITE: u32 = 0xFFFFFFFF

fn is(area: geom.Rect, x: i32, y: i32, width: i32, height: i32) -> bool {
    return area.x == x && area.y == y && area.width == width && area.height == height
}

// A line of one pixel around `area`.
fn outline(layer: *device.Device, area: geom.Rect, color: u32) -> void {
    _ = device.fill(layer, geom.rect(area.x, area.y, area.width, 1), color)
    _ = device.fill(layer, geom.rect(area.x, area.y + area.height - 1, area.width, 1), color)
    _ = device.fill(layer, geom.rect(area.x, area.y, 1, area.height), color)
    _ = device.fill(layer, geom.rect(area.x + area.width - 1, area.y, 1, area.height), color)
}

// How many pixels of `area` the mask holds more than nothing of (`total`:
// what their amounts add up to).
fn measure(found: *device.Device, area: geom.Rect, total: bool) -> u64 {
    const allocator = std.heap.allocator()
    const width = @intCast(usize, area.width)
    const line = allocator.alloc(width, 16).?
    var result: u64 = 0
    var y = area.y
    while y < area.y + area.height {
        mask.readBytes(found, geom.rect(area.x, y, area.width, 1), line, width)
        var index: usize = 0
        while index < width {
            if total {
                result += @intCast(u64, line[index])
            } else if line[index] != 0 {
                result += 1
            }
            index += 1
        }
        y += 1
    }
    allocator.free(line, width, 16)
    return result
}

// A closed outline, a gap across its corner, places and areas at the edge
// of what makes sense.
fn outlines(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const layer = device.create(allocator, 0).?
    const area = geom.rect(0, 0, 100, 80)
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    var options = fill.defaults()
    if options.threshold != 20 || options.softness != 100 || !options.contiguous || options.diagonal { return 1 }
    if options.reference != fill.REFERENCE_SEED || options.grow != 0 || options.feather != 0.0 || options.stopAtImageEdge { return 2 }
    options.threshold = 0

    // Inside stays inside.
    const inside = fill.region(layer, 20, 20, area, &options, found)
    if !is(inside, 11, 11, 28, 28) || measure(found, area, false) != 784 { return 3 }
    if mask.at(found, 11, 11) != 255 || mask.at(found, 10, 11) != 0 || mask.at(found, 38, 38) != 255 || mask.at(found, 39, 38) != 0 { return 4 }
    // Outside covers the rest and not the inside, nor the line.
    const outside = fill.region(layer, 0, 0, area, &options, found)
    if !is(outside, 0, 0, 100, 80) || measure(found, area, false) != 7100 { return 5 }
    if mask.at(found, 20, 20) != 0 || mask.at(found, 10, 10) != 0 || mask.at(found, 99, 79) != 255 || mask.at(found, 100, 79) != 0 { return 6 }
    // The line itself is a region too.
    const line = fill.region(layer, 39, 25, area, &options, found)
    if !is(line, 10, 10, 30, 30) || measure(found, area, false) != 116 || mask.at(found, 10, 10) != 255 || mask.at(found, 11, 11) != 0 { return 7 }

    // The corner taken out: its two sides touch only across it. Straight
    // neighbours hold, diagonal ones leak.
    device.setPixel(layer, 10, 10, 0)
    _ = fill.region(layer, 20, 20, area, &options, found)
    if measure(found, area, false) != 784 || mask.at(found, 10, 10) != 0 { return 8 }
    _ = fill.region(layer, 0, 0, area, &options, found)
    if measure(found, area, false) != 7101 || mask.at(found, 10, 10) != 255 || mask.at(found, 11, 11) != 0 { return 9 }
    options.diagonal = true
    const leaked = fill.region(layer, 20, 20, area, &options, found)
    if !is(leaked, 0, 0, 100, 80) || measure(found, area, false) != 7885 || mask.at(found, 0, 0) != 255 || mask.at(found, 11, 10) != 0 { return 10 }
    options.diagonal = false
    device.setPixel(layer, 10, 10, BLACK)

    // A place outside the area: nothing, and the mask is nothing.
    if !geom.isEmpty(fill.region(layer, 200, 200, area, &options, found)) || measure(found, area, false) != 0 { return 11 }
    _ = fill.region(layer, 0, 0, area, &options, found)
    if !geom.isEmpty(fill.region(layer, -1, 5, area, &options, found)) || measure(found, area, false) != 0 { return 12 }
    // An area of one pixel, and none.
    const dot = fill.region(layer, 5, 5, geom.rect(5, 5, 1, 1), &options, found)
    if !is(dot, 5, 5, 1, 1) || mask.at(found, 5, 5) != 255 || mask.at(found, 6, 5) != 0 || mask.at(found, 5, 6) != 0 { return 14 }
    if !geom.isEmpty(fill.region(layer, 0, 0, geom.empty(), &options, found)) { return 15 }
    // The area is where the search stops: the mask beyond it is not written.
    device.clear(found)
    const part = fill.region(layer, 0, 0, geom.rect(0, 0, 70, 5), &options, found)
    if !is(part, 0, 0, 70, 5) || mask.at(found, 69, 4) != 255 || mask.at(found, 70, 4) != 0 || mask.at(found, 69, 5) != 0 { return 16 }
    device.destroy(layer)
    return 0
}

// The threshold, the softness, what counts as a colour.
fn colours(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 256, 4)
    // Greys from 0 to 255, a column each, across four tiles.
    const ramp = device.create(allocator, 0).?
    var x: i32 = 0
    while x < 256 {
        const level = @intCast(u32, x)
        _ = device.fill(ramp, geom.rect(x, 0, 1, 4), pixel.rgb(level, level, level))
        x += 1
    }
    var options = fill.defaults()
    options.threshold = 0
    if !is(fill.region(ramp, 100, 1, area, &options, found), 100, 0, 1, 4) || measure(found, area, false) != 4 { return 20 }
    options.threshold = 10
    if !is(fill.region(ramp, 100, 1, area, &options, found), 90, 0, 21, 4) || measure(found, area, false) != 84 { return 21 }
    if mask.at(found, 90, 0) != 255 || mask.at(found, 110, 3) != 255 || mask.at(found, 89, 0) != 0 || mask.at(found, 111, 3) != 0 { return 22 }
    options.threshold = 255
    if !is(fill.region(ramp, 100, 1, area, &options, found), 0, 0, 256, 4) || measure(found, area, false) != 1024 { return 23 }
    options.threshold = 1000
    if measure(found, fill.region(ramp, 100, 1, area, &options, found), false) != 1024 { return 24 }

    // Softness 0: whole only at no difference, then evenly down to
    // nothing just past the threshold.
    options.threshold = 10
    options.softness = 0
    if !is(fill.region(ramp, 100, 1, area, &options, found), 90, 0, 21, 4) || measure(found, area, false) != 84 { return 25 }
    if mask.at(found, 100, 1) != 255 || mask.at(found, 101, 1) != 232 || mask.at(found, 99, 2) != 232 || mask.at(found, 105, 0) != 139 { return 26 }
    if mask.at(found, 110, 1) != 23 || mask.at(found, 90, 3) != 23 || mask.at(found, 111, 1) != 0 || mask.at(found, 89, 1) != 0 { return 27 }
    // Softness 50: whole up to half the threshold.
    options.softness = 50
    _ = fill.region(ramp, 100, 1, area, &options, found)
    if mask.at(found, 105, 1) != 255 || mask.at(found, 95, 1) != 255 || mask.at(found, 106, 1) != 213 || mask.at(found, 110, 1) != 43 || mask.at(found, 111, 1) != 0 { return 28 }
    options.softness = 100
    _ = fill.region(ramp, 100, 1, area, &options, found)
    if mask.at(found, 110, 1) != 255 || mask.at(found, 111, 1) != 0 { return 29 }
    options.softness = 300
    _ = fill.region(ramp, 100, 1, area, &options, found)
    if mask.at(found, 110, 1) != 255 || mask.at(found, 111, 1) != 0 { return 30 }

    // Grown by one, the amounts spread as amounts: each the largest next
    // to it; shrunk, the smallest (at the area's edge only when the edge
    // is one of the region's).
    options.softness = 0
    options.grow = 1
    if !is(fill.region(ramp, 100, 1, area, &options, found), 89, 0, 23, 4) { return 31 }
    if mask.at(found, 105, 1) != 162 || mask.at(found, 111, 1) != 23 || mask.at(found, 112, 1) != 0 || mask.at(found, 100, 0) != 255 { return 32 }
    options.grow = -1
    if !is(fill.region(ramp, 100, 1, area, &options, found), 91, 0, 19, 4) { return 33 }
    if mask.at(found, 105, 1) != 116 || mask.at(found, 110, 1) != 0 || mask.at(found, 100, 1) != 232 || mask.at(found, 100, 0) != 232 { return 34 }
    options.stopAtImageEdge = true
    if !is(fill.region(ramp, 100, 1, area, &options, found), 91, 1, 19, 2) || mask.at(found, 100, 0) != 0 || mask.at(found, 100, 1) != 232 { return 35 }
    options = fill.defaults()

    // How far colours are apart.
    if fill.difference(0xFF102030, 0xFF132030) != 3 || fill.difference(0xFF102030, 0xFF102530) != 5 || fill.difference(0xFF102030, 0xFF102039) != 9 { return 36 }
    if fill.difference(0xFF000000, 0x80000000) != 127 || fill.difference(0x00FF0000, 0x0000FF00) != 0 || fill.difference(0x00FF0000, 0x40FF0000) != 64 { return 37 }
    if fill.difference(0x40FFFFFF, 0x00000000) != 64 || fill.difference(WHITE, BLACK) != 255 || fill.difference(RED, RED) != 0 { return 38 }

    // What is transparent is one region whatever colour hides in it.
    const hidden = device.create(allocator, 0).?
    const small = geom.rect(0, 0, 20, 20)
    _ = device.fill(hidden, small, 0x00FF0000)
    _ = device.fill(hidden, geom.rect(5, 5, 10, 10), 0x0000FF00)
    _ = device.fill(hidden, geom.rect(8, 8, 2, 2), 0x01FFFFFF)
    options.threshold = 0
    if !is(fill.region(hidden, 0, 0, small, &options, found), 0, 0, 20, 20) || measure(found, small, false) != 396 || mask.at(found, 8, 8) != 0 { return 39 }
    options.threshold = 1
    if measure(found, fill.region(hidden, 6, 6, small, &options, found), false) != 400 { return 40 }

    // Alpha is a channel: a ramp of it, from nothing.
    const fading = device.create(allocator, 0).?
    x = 1
    while x < 256 {
        _ = device.fill(fading, geom.rect(x, 0, 1, 4), pixel.pack(@intCast(u32, x), 255, 0, 0))
        x += 1
    }
    options.threshold = 10
    if !is(fill.region(fading, 100, 2, area, &options, found), 90, 0, 21, 4) { return 41 }
    if !is(fill.region(fading, 0, 2, area, &options, found), 0, 0, 11, 4) || measure(found, area, false) != 44 { return 42 }
    device.destroy(ramp)
    device.destroy(hidden)
    device.destroy(fading)
    return 0
}

// Large and winding regions.
fn sizes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    var options = fill.defaults()
    options.threshold = 0

    // 4096 x 4096 of nothing: no tile is looked into.
    const nothing = device.create(allocator, 0).?
    const large = geom.rect(0, 0, 4096, 4096)
    var started = std.time.milliseconds()
    const all = fill.region(nothing, 2000, 2000, large, &options, found)
    var took = std.time.milliseconds() - started
    _ = std.io.print("fill of 4096 x 4096, no tiles: ")
    _ = std.io.writeUnsigned(std.io.stdout(), took)
    _ = std.io.println(" ms")
    if !is(all, 0, 0, 4096, 4096) || device.tileCount(found) != 4096 || device.tileCount(nothing) != 0 { return 50 }
    if took >= 1000 { return 51 }
    if measure(found, large, false) != 16777216 || mask.at(found, 4095, 4095) != 255 || mask.at(found, 4096, 4095) != 0 { return 52 }
    started = std.time.milliseconds()
    const everywhere = fill.similar(nothing, 0x00123456, large, &options, found)
    took = std.time.milliseconds() - started
    _ = std.io.print("similar over 4096 x 4096, no tiles: ")
    _ = std.io.writeUnsigned(std.io.stdout(), took)
    _ = std.io.println(" ms")
    if !is(everywhere, 0, 0, 4096, 4096) || took >= 1000 || measure(found, large, true) != 4278190080 { return 53 }
    device.clear(found)
    device.destroy(nothing)

    // Tiles that are there: of one colour in the middle, of two at the rim.
    const flat = device.create(allocator, 0).?
    _ = device.fill(flat, geom.rect(0, 0, 300, 200), RED)
    const around = geom.rect(-10, -10, 320, 220)
    if !is(fill.region(flat, 150, 100, around, &options, found), 0, 0, 300, 200) || measure(found, around, false) != 60000 { return 54 }
    if !is(fill.region(flat, -5, -5, around, &options, found), -10, -10, 320, 220) || measure(found, around, false) != 10400 || mask.at(found, 150, 100) != 0 { return 55 }
    // One pixel in a tile of one colour splits nothing off but itself.
    device.setPixel(flat, 100, 100, BLUE)
    if measure(found, fill.region(flat, 150, 100, around, &options, found), false) != 59999 || mask.at(found, 100, 100) != 0 { return 56 }
    device.destroy(flat)

    // A spiral: 64 square walls inside each other, 3 pixels between them,
    // each open at one end only, so that the way in winds through all.
    const maze = device.create(allocator, 0).?
    const square = geom.rect(0, 0, 512, 512)
    var ring: i32 = 0
    while ring < 64 {
        const inset = ring * 4
        outline(maze, geom.rect(inset, inset, 512 - 2 * inset, 512 - 2 * inset), BLACK)
        if ring > 0 {
            if ring & 1 == 0 {
                _ = device.fill(maze, geom.rect(inset + 1, inset, 2, 1), 0)
            } else {
                _ = device.fill(maze, geom.rect(509 - inset, 511 - inset, 2, 1), 0)
            }
        }
        ring += 1
    }
    var open: u64 = 0
    var y: i32 = 0
    while y < 512 {
        var x: i32 = 0
        while x < 512 {
            if device.pixel(maze, x, y) == 0 { open += 1 }
            x += 1
        }
        y += 1
    }
    if open < 190000 || open > 200000 { return 57 }
    started = std.time.milliseconds()
    const wound = fill.region(maze, 1, 1, square, &options, found)
    took = std.time.milliseconds() - started
    _ = std.io.print("fill of a spiral, 512 x 512: ")
    _ = std.io.writeUnsigned(std.io.stdout(), took)
    _ = std.io.println(" ms")
    if !is(wound, 1, 1, 510, 510) || measure(found, square, false) != open || mask.at(found, 255, 255) != 255 || mask.at(found, 0, 0) != 0 { return 58 }
    // From the middle the same way back out.
    if measure(found, fill.region(maze, 255, 255, square, &options, found), false) != open { return 59 }
    // A wall is a region too: the outermost, around everything.
    if !is(fill.region(maze, 0, 0, square, &options, found), 0, 0, 512, 512) || measure(found, square, false) != 2044 { return 60 }
    options.reference = fill.REFERENCE_BOUNDARY
    options.boundary = BLACK
    if measure(found, fill.region(maze, 1, 1, square, &options, found), false) != open { return 61 }
    options.reference = fill.REFERENCE_SEED
    device.destroy(maze)

    // A comb of 5000 teeth: each is a row to come back to, more than the
    // list starts with room for.
    const comb = device.create(allocator, 0).?
    const strip = geom.rect(0, 0, 10000, 3)
    _ = device.fill(comb, geom.rect(0, 1, 10000, 2), BLACK)
    var tooth: i32 = 0
    while tooth < 10000 {
        _ = device.fill(comb, geom.rect(tooth, 1, 1, 2), 0)
        tooth += 2
    }
    if !is(fill.region(comb, 0, 0, strip, &options, found), 0, 0, 10000, 3) || measure(found, strip, false) != 20000 { return 62 }
    if mask.at(found, 9998, 2) != 255 || mask.at(found, 9999, 2) != 0 || mask.at(found, 9999, 0) != 255 { return 63 }
    device.clear(found)
    device.destroy(comb)

    // No memory for the list of rows (the layer's allocator has 16 KiB,
    // the list wants 48): nothing found, the mask nothing, no crash.
    const little = allocator.alloc(16384, 16).?
    var state = std.fixed_buffer_allocator.init(little, 16384)
    const poor = device.create(std.fixed_buffer_allocator.interface(&state), 0)
    if poor == null { return 64 }
    _ = device.fill(found, geom.rect(0, 0, 10, 10), mask.ALL)
    if !geom.isEmpty(fill.region(poor.?, 5, 5, geom.rect(0, 0, 200, 200), &options, found)) || device.tileCount(found) != 0 { return 65 }
    // One row needs no list.
    if !is(fill.region(poor.?, 5, 0, geom.rect(0, 0, 200, 1), &options, found), 0, 0, 200, 1) { return 66 }
    device.clear(found)
    device.destroy(poor.?)
    allocator.free(little, 16384, 16)
    return 0
}

// The boundary colour, and every similar pixel wherever it is.
fn modes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const layer = device.create(allocator, 0).?
    const area = geom.rect(0, 0, 100, 80)
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    _ = device.fill(layer, geom.rect(15, 15, 5, 5), RED)
    _ = device.fill(layer, geom.rect(25, 25, 5, 5), GREEN)
    _ = device.fill(layer, geom.rect(60, 60, 4, 4), RED)
    var options = fill.defaults()
    options.threshold = 0

    // By the colour clicked the blocks inside the outline stay out; up to
    // the black line they are in.
    if measure(found, fill.region(layer, 12, 12, area, &options, found), false) != 734 { return 70 }
    options.reference = fill.REFERENCE_BOUNDARY
    options.boundary = BLACK
    if !is(fill.region(layer, 12, 12, area, &options, found), 11, 11, 28, 28) || measure(found, area, false) != 784 { return 71 }
    if mask.at(found, 16, 16) != 255 || mask.at(found, 26, 26) != 255 || mask.at(found, 10, 12) != 0 { return 72 }
    if !geom.isEmpty(fill.region(layer, 10, 20, area, &options, found)) || measure(found, area, false) != 0 { return 73 }
    if !is(fill.region(layer, 0, 0, area, &options, found), 0, 0, 100, 80) || measure(found, area, false) != 7100 || mask.at(found, 61, 61) != 255 { return 74 }
    // A pixel between the line's colour and not: in by what it is not.
    device.setPixel(layer, 30, 30, 0xFF404040)
    options.threshold = 100
    options.softness = 0
    if measure(found, fill.region(layer, 12, 12, area, &options, found), false) != 784 || mask.at(found, 30, 30) != 162 || mask.at(found, 31, 30) != 255 { return 75 }
    device.setPixel(layer, 30, 30, 0)
    // Not contiguous: all that is not the line.
    options = fill.defaults()
    options.threshold = 0
    options.reference = fill.REFERENCE_BOUNDARY
    options.boundary = BLACK
    options.contiguous = false
    if !is(fill.region(layer, 0, 0, area, &options, found), 0, 0, 100, 80) || measure(found, area, false) != 7884 { return 76 }

    // Similar colours wherever they are.
    options = fill.defaults()
    options.threshold = 0
    if !is(fill.similar(layer, RED, area, &options, found), 15, 15, 49, 49) || measure(found, area, false) != 41 { return 77 }
    if mask.at(found, 15, 15) != 255 || mask.at(found, 63, 63) != 255 || mask.at(found, 20, 15) != 0 || mask.at(found, 40, 40) != 0 { return 78 }
    options.contiguous = false
    if !is(fill.region(layer, 62, 62, area, &options, found), 15, 15, 49, 49) || measure(found, area, false) != 41 { return 79 }
    options.contiguous = true
    if !is(fill.region(layer, 62, 62, area, &options, found), 60, 60, 4, 4) || measure(found, area, false) != 16 { return 80 }
    if !geom.isEmpty(fill.similar(layer, BLUE, area, &options, found)) || measure(found, area, false) != 0 { return 81 }
    options.threshold = 255
    if measure(found, fill.similar(layer, RED, area, &options, found), false) != 8000 { return 82 }
    // Red against green and black is 255 away, against nothing too.
    options.threshold = 254
    if measure(found, fill.similar(layer, RED, area, &options, found), false) != 41 { return 83 }
    device.destroy(layer)
    return 0
}

// Grown, shrunk, feathered.
fn afterwards(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const block = device.create(allocator, 0).?
    const area = geom.rect(0, 0, 100, 80)
    const own = geom.rect(30, 20, 40, 30)
    _ = device.fill(block, own, RED)
    var options = fill.defaults()
    options.threshold = 0
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 90 }

    // Grown by 3, round: 3 more on every side, the corners a quarter of
    // a disc (4 pixels each).
    options.grow = 3
    if !is(fill.region(block, 40, 30, area, &options, found), 27, 17, 46, 36) || measure(found, area, false) != 1636 { return 91 }
    if mask.at(found, 27, 17) != 0 || mask.at(found, 28, 18) != 255 || mask.at(found, 27, 20) != 255 || mask.at(found, 26, 20) != 0 || mask.at(found, 29, 17) != 0 || mask.at(found, 30, 17) != 255 { return 92 }
    options.grow = 1
    if !is(fill.region(block, 40, 30, area, &options, found), 29, 19, 42, 32) || measure(found, area, false) != 1340 || mask.at(found, 29, 19) != 0 { return 93 }
    // Shrunk by 3.
    options.grow = -3
    if !is(fill.region(block, 40, 30, area, &options, found), 33, 23, 34, 24) || measure(found, area, false) != 816 { return 94 }
    if mask.at(found, 33, 23) != 255 || mask.at(found, 32, 23) != 0 || mask.at(found, 66, 46) != 255 || mask.at(found, 67, 46) != 0 { return 95 }
    // More than the most there is: the most (400), here all of the area,
    // and nothing at all.
    options.grow = 2000000000
    if !is(fill.region(block, 40, 30, area, &options, found), 0, 0, 100, 80) || measure(found, area, false) != 8000 { return 139 }
    options.grow = -2147483647
    if !geom.isEmpty(fill.region(block, 40, 30, area, &options, found)) || measure(found, area, false) != 0 { return 140 }
    options.grow = -2147483647 - 1
    if !geom.isEmpty(fill.region(block, 40, 30, area, &options, found)) || measure(found, area, false) != 0 { return 17 }
    // A feather without end is the most there is.
    options.grow = 0
    options.feather = math.infinity()
    const endless = fill.region(block, 40, 30, area, &options, found)
    const kept = mask.create(allocator, false).?
    _ = device.assign(kept, found)
    options.feather = fill.MOST_FEATHER
    if geom.isEmpty(endless) || !geom.same(endless, fill.region(block, 40, 30, area, &options, found)) || !alike(kept, found, area) { return 18 }
    device.destroy(kept)
    options.feather = 0.0
    // Shrunk away altogether.
    options.grow = -15
    if !geom.isEmpty(fill.region(block, 40, 30, area, &options, found)) || measure(found, area, false) != 0 { return 96 }
    options.grow = -14
    if !is(fill.region(block, 40, 30, area, &options, found), 44, 34, 12, 2) { return 97 }

    // The region is all of the area: it goes on past the edge, or the
    // edge is its own. Nothing is written past the area either way.
    device.clear(found)
    options.grow = -3
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 98 }
    options.stopAtImageEdge = true
    if !is(fill.region(block, 40, 30, own, &options, found), 33, 23, 34, 24) || measure(found, area, false) != 816 { return 99 }
    options.grow = 3
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 100 }
    options.stopAtImageEdge = false
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 101 }

    // Feathered by 4: the edge spread over 4 pixels to either side (a
    // Gaussian of 4 / 3 as its deviation, its weights adding up to one:
    // the amounts are as many as before altogether), the same on every
    // side, a corner rounder than an edge.
    options.grow = 0
    options.feather = 4.0
    if !is(fill.region(block, 40, 30, area, &options, found), 26, 16, 48, 38) || measure(found, area, false) != 1792 || measure(found, area, true) != 306000 { return 102 }
    if mask.at(found, 25, 35) != 0 || mask.at(found, 26, 35) != 1 || mask.at(found, 27, 35) != 7 || mask.at(found, 28, 35) != 32 || mask.at(found, 29, 35) != 89 { return 103 }
    if mask.at(found, 30, 35) != 166 || mask.at(found, 31, 35) != 223 || mask.at(found, 32, 35) != 248 || mask.at(found, 33, 35) != 254 || mask.at(found, 34, 35) != 255 { return 104 }
    if mask.at(found, 50, 16) != 1 || mask.at(found, 50, 17) != 7 || mask.at(found, 73, 35) != 1 || mask.at(found, 50, 53) != 1 || mask.at(found, 50, 54) != 0 { return 105 }
    if mask.at(found, 27, 17) != 0 || mask.at(found, 28, 18) != 4 || mask.at(found, 29, 19) != 31 || mask.at(found, 30, 20) != 108 || mask.at(found, 69, 49) != 108 { return 114 }
    // At the image's edge: none of it when the region goes on, the same
    // fading when the edge is the region's.
    device.clear(found)
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 || measure(found, area, true) != 306000 { return 106 }
    options.stopAtImageEdge = true
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 || measure(found, area, true) != 288192 { return 107 }
    if mask.at(found, 30, 20) != 108 || mask.at(found, 30, 35) != 166 || mask.at(found, 50, 35) != 255 || mask.at(found, 29, 35) != 0 { return 108 }
    options.stopAtImageEdge = false
    // Grown, then feathered.
    options.grow = 2
    options.feather = 2.0
    if !is(fill.region(block, 40, 30, area, &options, found), 26, 16, 48, 38) || measure(found, area, false) != 1792 || measure(found, area, true) != 378420 { return 109 }
    // A feather that is no number or less than nothing is none; a tiny
    // one changes nothing.
    options.grow = 0
    options.feather = -3.0
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, true) != 306000 { return 110 }
    options.feather = math.nan()
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, true) != 306000 { return 113 }
    options.feather = 0.01
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, true) != 306000 { return 111 }
    // Similar pixels are grown as one mask.
    options.feather = 0.0
    options.grow = 1
    _ = device.fill(block, geom.rect(80, 60, 2, 2), RED)
    if !is(fill.similar(block, RED, area, &options, found), 29, 19, 54, 44) || measure(found, area, false) != 1340 + 12 { return 112 }
    device.destroy(block)

    // A feather of 60, above what the Gaussian itself is used for: three
    // means in a row (19, 19 and 20 to either side), as many amounts
    // altogether, half at the edge, the same along rows and columns.
    const slab = device.create(allocator, 0).?
    const room = geom.rect(0, 0, 600, 500)
    _ = device.fill(slab, geom.rect(150, 150, 300, 200), RED)
    options.grow = 0
    options.feather = 60.0
    if !is(fill.region(slab, 300, 250, room, &options, found), 99, 99, 402, 302) || measure(found, room, false) != 117764 || measure(found, room, true) != 15300000 { return 115 }
    if mask.at(found, 98, 250) != 0 || mask.at(found, 100, 250) != 1 || mask.at(found, 120, 250) != 18 || mask.at(found, 140, 250) != 83 || mask.at(found, 149, 250) != 125 || mask.at(found, 150, 250) != 130 { return 116 }
    if mask.at(found, 160, 250) != 177 || mask.at(found, 180, 250) != 238 || mask.at(found, 200, 250) != 254 || mask.at(found, 208, 250) != 255 || mask.at(found, 300, 250) != 255 { return 117 }
    if mask.at(found, 300, 149) != 125 || mask.at(found, 300, 150) != 130 || mask.at(found, 300, 349) != 130 || mask.at(found, 300, 350) != 125 || mask.at(found, 449, 250) != 130 || mask.at(found, 450, 250) != 125 { return 118 }
    // The region is the area: going on past it nothing fades.
    const all = geom.rect(150, 150, 300, 200)
    device.clear(found)
    if !is(fill.region(slab, 300, 250, all, &options, found), 150, 150, 300, 200) || measure(found, room, true) != 15300000 { return 119 }
    // Shrunk by 40, then grown by 40: a rectangle again, its corners round.
    options.feather = 0.0
    options.grow = -40
    if !is(fill.region(slab, 300, 250, room, &options, found), 190, 190, 220, 120) || measure(found, room, false) != 26400 { return 137 }
    options.grow = 40
    if !is(fill.region(slab, 300, 250, room, &options, found), 110, 110, 380, 280) || mask.at(found, 110, 250) != 255 || mask.at(found, 109, 250) != 0 || mask.at(found, 121, 121) != 0 || mask.at(found, 122, 122) != 255 { return 138 }
    device.destroy(slab)
    device.clear(found)
    return 0
}

// The regions inside a drawn shape.
fn shapes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 100, 80)
    // A sea of nothing; a green island with a lake of nothing in it; a
    // red island further out.
    const scene = device.create(allocator, 0).?
    _ = device.fill(scene, geom.rect(40, 40, 10, 10), GREEN)
    _ = device.fill(scene, geom.rect(43, 43, 4, 4), 0)
    _ = device.fill(scene, geom.rect(70, 40, 20, 10), RED)
    // The shape: around the green island, across the red one.
    const lasso = mask.create(allocator, false).?
    _ = device.fill(lasso, geom.rect(30, 30, 50, 30), mask.ALL)
    var options = fill.defaults()
    options.threshold = 0

    // The island and its lake; not the sea, which goes on past the shape,
    // nor the island the shape cuts.
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), 40, 40, 10, 10) || measure(found, area, false) != 100 { return 120 }
    if mask.at(found, 35, 35) != 0 || mask.at(found, 72, 42) != 0 || mask.at(found, 44, 44) != 255 || mask.at(found, 40, 40) != 255 { return 121 }
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.TRANSPARENT_REGIONS), 43, 43, 4, 4) || measure(found, area, false) != 16 { return 122 }
    options.boundary = GREEN
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_OF_COLOR), 40, 40, 10, 10) || measure(found, area, false) != 84 || mask.at(found, 44, 44) != 0 { return 123 }
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_SURROUNDED_BY), 43, 43, 4, 4) || measure(found, area, false) != 16 { return 124 }
    options.boundary = RED
    if !geom.isEmpty(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_OF_COLOR)) || measure(found, area, false) != 0 { return 125 }
    // Nothing is closed off by red here: all that is not red reaches out.
    if !geom.isEmpty(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_SURROUNDED_BY)) { return 126 }
    // Grown afterwards.
    options.grow = 1
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), 39, 39, 12, 12) || measure(found, area, false) != 140 { return 127 }
    options.grow = 0

    // The shape around both islands.
    _ = device.fill(lasso, geom.rect(30, 30, 65, 30), mask.ALL)
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), 40, 40, 50, 10) || measure(found, area, false) != 300 { return 128 }
    // Less than half of the shape is not the shape: a column of the red
    // island at 100 of 255 puts it out again, at 128 not.
    _ = device.fill(lasso, geom.rect(89, 30, 1, 30), pixel.gray(100))
    if measure(found, fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), false) != 100 { return 129 }
    _ = device.fill(lasso, geom.rect(89, 30, 1, 30), pixel.gray(128))
    if measure(found, fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), false) != 300 { return 130 }
    // The lake reached across a corner of the island: with diagonal
    // neighbours it is the sea's.
    device.setPixel(scene, 40, 40, 0)
    device.setPixel(scene, 41, 41, 0)
    device.setPixel(scene, 42, 42, 0)
    if measure(found, fill.enclosed(scene, lasso, area, &options, found, fill.TRANSPARENT_REGIONS), false) != 18 { return 131 }
    options.diagonal = true
    if !geom.isEmpty(fill.enclosed(scene, lasso, area, &options, found, fill.TRANSPARENT_REGIONS)) { return 132 }
    options.diagonal = false

    // What the methods are called.
    var method: u8 = 0
    while method < fill.METHODS {
        if fill.methodTitle(method, false).length == 0 || std.text.same(fill.methodTitle(method, false), fill.methodTitle(method, true)) { return 141 }
        method += 1
    }
    if !std.text.same(fill.methodTitle(fill.TRANSPARENT_REGIONS, true), "Transparente Bereiche") || !std.text.same(fill.methodTitle(fill.ALL_REGIONS, false), "All regions") { return 142 }

    // A shape that is everything: every region is inside (the area's edge
    // is not the shape's). A shape that is nothing: none.
    const everything = mask.create(allocator, true).?
    if !is(fill.enclosed(scene, everything, area, &options, found, fill.ALL_REGIONS), 0, 0, 100, 80) || measure(found, area, false) != 8000 { return 133 }
    const none = mask.create(allocator, false).?
    if !geom.isEmpty(fill.enclosed(scene, none, area, &options, found, fill.ALL_REGIONS)) || measure(found, area, false) != 0 { return 134 }

    // Amounts with a threshold: each region by its own colour.
    const shades = device.create(allocator, BLACK).?
    _ = device.fill(shades, geom.rect(40, 40, 6, 6), 0xFF808080)
    _ = device.fill(shades, geom.rect(42, 42, 2, 2), 0xFF848484)
    options.threshold = 8
    options.softness = 0
    _ = device.fill(lasso, area, mask.NOTHING)
    _ = device.fill(lasso, geom.rect(30, 30, 30, 30), mask.ALL)
    if !is(fill.enclosed(shades, lasso, area, &options, found, fill.ALL_REGIONS), 40, 40, 6, 6) || measure(found, area, false) != 36 { return 135 }
    // The inner grey was reached from the outer one, 4 away of 8 at
    // softness 0: (255 * 5 + 4) / 9 = 142, and is not searched from again.
    if mask.at(found, 40, 40) != 255 || mask.at(found, 42, 42) != 142 || mask.at(found, 43, 43) != 142 || mask.at(found, 44, 44) != 255 || mask.at(found, 39, 40) != 0 { return 136 }
    device.destroy(shades)
    device.destroy(none)
    device.destroy(everything)
    device.destroy(lasso)
    device.destroy(scene)
    return 0
}

// The region filled: a colour, a pattern.
fn painting(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 100, 80)
    const block = device.create(allocator, 0).?
    _ = device.fill(block, geom.rect(30, 20, 40, 30), RED)
    var options = fill.defaults()
    options.threshold = 0
    const bounds = fill.region(block, 40, 30, area, &options, found)
    if !is(bounds, 30, 20, 40, 30) { return 150 }

    // Half opaque green over blue, undone.
    const canvas = device.create(allocator, 0).?
    _ = device.fill(canvas, area, BLUE)
    device.begin(canvas)
    var changed = fill.paint(canvas, found, bounds, GREEN, blend.NORMAL, 128, 0, null)
    const change = device.commit(canvas)
    const mixed = pixel.over(BLUE, GREEN, 128)
    if !is(changed, 30, 20, 40, 30) || mixed != 0xFF00807F { return 151 }
    if device.pixel(canvas, 30, 20) != mixed || device.pixel(canvas, 69, 49) != mixed || device.pixel(canvas, 63, 30) != mixed || device.pixel(canvas, 64, 30) != mixed { return 152 }
    if device.pixel(canvas, 29, 20) != BLUE || device.pixel(canvas, 70, 49) != BLUE || device.pixel(canvas, 30, 19) != BLUE || device.pixel(canvas, 69, 50) != BLUE { return 153 }
    if change == null { return 154 }
    _ = device.apply(canvas, change.?, true)
    if device.pixel(canvas, 30, 20) != BLUE || device.pixel(canvas, 50, 35) != BLUE { return 155 }
    device.destroyChange(change.?)

    // Wider bounds than the region change nothing more.
    changed = fill.paint(canvas, found, area, GREEN, blend.NORMAL, 255, 0, null)
    if !is(changed, 30, 20, 40, 30) || device.pixel(canvas, 30, 20) != GREEN || device.pixel(canvas, 29, 20) != BLUE { return 156 }
    // Bounds that cut the region cut the fill.
    _ = device.fill(canvas, area, BLUE)
    changed = fill.paint(canvas, found, geom.rect(60, 40, 40, 40), GREEN, blend.NORMAL, 255, 0, null)
    if !is(changed, 60, 40, 10, 10) || device.pixel(canvas, 60, 40) != GREEN || device.pixel(canvas, 59, 40) != BLUE || device.pixel(canvas, 60, 39) != BLUE { return 157 }
    _ = device.fill(canvas, area, BLUE)

    // A selection of the left half, half selected: half the amount there,
    // none of the fill beside it.
    const chosen = mask.create(allocator, false).?
    _ = device.fill(chosen, geom.rect(0, 0, 50, 80), pixel.gray(128))
    changed = fill.paint(canvas, found, bounds, GREEN, blend.NORMAL, 255, 0, chosen)
    if !is(changed, 30, 20, 20, 30) || device.pixel(canvas, 49, 25) != mixed || device.pixel(canvas, 30, 49) != mixed || device.pixel(canvas, 50, 25) != BLUE { return 158 }
    // With an opacity as well: 128 of 128.
    _ = device.fill(canvas, area, BLUE)
    _ = fill.paint(canvas, found, bounds, GREEN, blend.NORMAL, 128, 0, chosen)
    if pixel.mul(128, 128) != 64 || device.pixel(canvas, 40, 30) != pixel.over(BLUE, GREEN, 64) || device.pixel(canvas, 60, 30) != BLUE { return 159 }

    // On nothing: the colour itself, and tiles only where the region is.
    const fresh = device.create(allocator, 0).?
    _ = fill.paint(fresh, found, area, GREEN, blend.NORMAL, 255, 0, null)
    if device.pixel(fresh, 30, 20) != GREEN || device.pixel(fresh, 69, 49) != GREEN || device.pixel(fresh, 29, 20) != 0 || device.tileCount(fresh) != 2 { return 160 }
    // A colour that is half transparent itself, at alpha 200 of 255.
    device.clear(fresh)
    _ = fill.paint(fresh, found, bounds, 0x80FF0000, blend.NORMAL, 200, 0, null)
    if device.pixel(fresh, 40, 30) != pixel.over(0, 0x80FF0000, 200) || device.pixel(fresh, 40, 30) != 0x64FF0000 { return 161 }
    // No opacity: nothing.
    device.clear(fresh)
    if !geom.isEmpty(fill.paint(fresh, found, bounds, GREEN, blend.NORMAL, 0, 0, null)) || device.tileCount(fresh) != 0 { return 162 }
    if !geom.isEmpty(fill.paint(fresh, found, geom.empty(), GREEN, blend.NORMAL, 255, 0, null)) || !geom.isEmpty(fill.paint(fresh, found, geom.rect(0, 0, 20, 20), GREEN, blend.NORMAL, 255, 0, null)) { return 163 }
    // Erased: what was there goes where the region is.
    _ = device.fill(fresh, area, RED)
    _ = fill.paint(fresh, found, bounds, WHITE, blend.ERASE, 255, 0, null)
    if device.pixel(fresh, 40, 30) != 0 || device.pixel(fresh, 29, 30) != RED { return 164 }
    // Alpha locked: only where there is paint.
    device.clear(fresh)
    _ = device.fill(fresh, geom.rect(0, 0, 40, 80), RED)
    _ = fill.paint(fresh, found, bounds, GREEN, blend.NORMAL, 255, blend.FLAG_ALPHA_LOCK, null)
    if device.pixel(fresh, 35, 30) != GREEN || device.pixel(fresh, 45, 30) != 0 { return 165 }

    // Dissolved: each pixel taken or not by its place in the image, the
    // same whichever tile it is in and wherever the stretch began.
    _ = device.fill(canvas, area, BLUE)
    _ = fill.paint(canvas, found, bounds, GREEN, blend.DISSOLVE, 128, 0, null)
    var taken: u32 = 0
    var py: i32 = 20
    while py < 50 {
        var px: i32 = 30
        while px < 70 {
            const shown = device.pixel(canvas, px, py)
            if shown != blend.blendPixelAt(blend.DISSOLVE, BLUE, GREEN, 128, 0, blend.seedAt(px, py)) { return 175 }
            if shown == GREEN { taken += 1 }
            px += 1
        }
        py += 1
    }
    if taken < 400 || taken > 800 { return 176 }

    // A region of amounts: each pixel by its own.
    const ramp = device.create(allocator, 0).?
    var x: i32 = 0
    while x < 256 {
        const level = @intCast(u32, x)
        _ = device.fill(ramp, geom.rect(x, 0, 1, 4), pixel.rgb(level, level, level))
        x += 1
    }
    options.threshold = 10
    options.softness = 0
    const soft = fill.region(ramp, 100, 1, geom.rect(0, 0, 256, 4), &options, found)
    _ = device.fill(canvas, area, BLUE)
    changed = fill.paint(canvas, found, soft, GREEN, blend.NORMAL, 255, 0, null)
    if !is(soft, 90, 0, 21, 4) || !is(changed, 90, 0, 21, 4) { return 166 }
    if device.pixel(canvas, 95, 1) != pixel.over(BLUE, GREEN, 139) || device.pixel(canvas, 90, 1) != pixel.over(BLUE, GREEN, 23) || device.pixel(canvas, 89, 1) != BLUE { return 167 }
    options = fill.defaults()
    options.threshold = 0
    _ = fill.region(block, 40, 30, area, &options, found)

    // A pattern of 2 x 2 laid from (1, 0): the place decides the pixel,
    // across the tile's border as well.
    const pattern = [4]u32{ RED, GREEN, BLUE, WHITE }
    const tiled = device.create(allocator, 0).?
    changed = fill.paintPattern(tiled, found, bounds, &pattern, 2, 2, 1, 0, blend.NORMAL, 255, 0, null)
    if !is(changed, 30, 20, 40, 30) { return 168 }
    if device.pixel(tiled, 30, 20) != GREEN || device.pixel(tiled, 31, 20) != RED || device.pixel(tiled, 30, 21) != WHITE || device.pixel(tiled, 31, 21) != BLUE { return 169 }
    if device.pixel(tiled, 63, 25) != BLUE || device.pixel(tiled, 64, 25) != WHITE || device.pixel(tiled, 65, 25) != BLUE || device.pixel(tiled, 29, 20) != 0 || device.pixel(tiled, 70, 20) != 0 { return 170 }
    // 3 x 2 from (-2, 5): column (x + 2) mod 3, row (y - 5) mod 2.
    const wide = [6]u32{ 0xFF000001, 0xFF000002, 0xFF000003, 0xFF000004, 0xFF000005, 0xFF000006 }
    device.clear(tiled)
    _ = fill.paintPattern(tiled, found, bounds, &wide, 3, 2, -2, 5, blend.NORMAL, 255, 0, null)
    if device.pixel(tiled, 30, 20) != 0xFF000006 || device.pixel(tiled, 31, 20) != 0xFF000004 || device.pixel(tiled, 30, 21) != 0xFF000003 || device.pixel(tiled, 69, 49) != 0xFF000003 { return 171 }
    // An offset far beyond the pattern's size, either way.
    device.clear(tiled)
    _ = fill.paintPattern(tiled, found, bounds, &wide, 3, 2, 3001, -2001, blend.NORMAL, 255, 0, null)
    if device.pixel(tiled, 30, 20) != 0xFF000006 || device.pixel(tiled, 31, 20) != 0xFF000004 { return 172 }
    // With an opacity and the selection over blue.
    _ = device.fill(canvas, area, BLUE)
    changed = fill.paintPattern(canvas, found, bounds, &pattern, 2, 2, 0, 0, blend.NORMAL, 255, 0, chosen)
    if !is(changed, 30, 20, 20, 30) || device.pixel(canvas, 30, 20) != pixel.over(BLUE, RED, 128) || device.pixel(canvas, 31, 21) != pixel.over(BLUE, WHITE, 128) || device.pixel(canvas, 50, 20) != BLUE { return 173 }
    // A pattern of no size is none.
    if !geom.isEmpty(fill.paintPattern(canvas, found, bounds, &pattern, 0, 2, 0, 0, blend.NORMAL, 255, 0, null)) || !geom.isEmpty(fill.paintPattern(canvas, found, bounds, &pattern, 2, -1, 0, 0, blend.NORMAL, 255, 0, null)) { return 174 }
    device.destroy(tiled)
    device.destroy(ramp)
    device.destroy(fresh)
    device.destroy(chosen)
    device.destroy(canvas)
    device.destroy(block)
    return 0
}

// Left of and above the origin, a layer moved, the mask moved.
fn places(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const far = device.create(allocator, 0).?
    outline(far, geom.rect(-100, -90, 30, 30), BLACK)
    var area = geom.rect(-130, -120, 100, 80)
    var options = fill.defaults()
    options.threshold = 0
    if !is(fill.region(far, -90, -80, area, &options, found), -99, -89, 28, 28) || measure(found, area, false) != 784 { return 180 }
    if mask.at(found, -99, -89) != 255 || mask.at(found, -100, -89) != 0 || mask.at(found, -72, -62) != 255 || mask.at(found, -71, -62) != 0 { return 181 }
    if !is(fill.region(far, -130, -120, area, &options, found), -130, -120, 100, 80) || measure(found, area, false) != 7100 { return 182 }

    // The layer moved: its pixels are elsewhere in the image, its tiles
    // no longer on the image's 64s; the mask moved another way.
    device.clear(found)
    device.moveTo(far, 37, -11)
    device.moveTo(found, 5, 7)
    area = geom.rect(-93, -131, 100, 80)
    if !is(fill.region(far, -53, -91, area, &options, found), -62, -100, 28, 28) || measure(found, area, false) != 784 { return 183 }
    if mask.at(found, -62, -100) != 255 || mask.at(found, -63, -100) != 0 || mask.at(found, -35, -73) != 255 || mask.at(found, -34, -73) != 0 { return 184 }
    if !is(fill.region(far, -93, -131, area, &options, found), -93, -131, 100, 80) || measure(found, area, false) != 7100 { return 185 }
    options.grow = 1
    if !is(fill.region(far, -53, -91, area, &options, found), -63, -101, 30, 30) || measure(found, area, false) != 896 || mask.at(found, -63, -101) != 0 { return 186 }
    options.grow = 0
    options.feather = 4.0
    if !is(fill.region(far, -53, -91, area, &options, found), -66, -104, 36, 36) || mask.at(found, -62, -87) != 166 || mask.at(found, -63, -87) != 89 || measure(found, area, true) != 199920 { return 187 }
    options.feather = 0.0
    if !is(fill.similar(far, BLACK, area, &options, found), -63, -101, 30, 30) || measure(found, area, false) != 116 { return 188 }
    const lasso = mask.create(allocator, false).?
    device.moveTo(lasso, -1000, 3)
    _ = device.fill(lasso, geom.rect(-70, -108, 45, 45), mask.ALL)
    if !is(fill.enclosed(far, lasso, area, &options, found, fill.ALL_REGIONS), -63, -101, 30, 30) || measure(found, area, false) != 900 { return 189 }
    if !is(fill.enclosed(far, lasso, area, &options, found, fill.TRANSPARENT_REGIONS), -62, -100, 28, 28) || measure(found, area, false) != 784 { return 190 }
    // Painted into a layer that sits elsewhere again.
    const canvas = device.create(allocator, 0).?
    device.moveTo(canvas, -3, 9)
    const painted = fill.paint(canvas, found, area, GREEN, blend.NORMAL, 255, 0, null)
    if !is(painted, -62, -100, 28, 28) || device.pixel(canvas, -62, -100) != GREEN || device.pixel(canvas, -35, -73) != GREEN || device.pixel(canvas, -63, -100) != 0 || device.pixel(canvas, -34, -73) != 0 { return 191 }
    const pattern = [4]u32{ RED, GREEN, BLUE, WHITE }
    device.clear(canvas)
    _ = fill.paintPattern(canvas, found, area, &pattern, 2, 2, 0, 0, blend.NORMAL, 255, 0, null)
    // (-62, -100): column 0, row 0; (-61, -99): column 1, row 1.
    if device.pixel(canvas, -62, -100) != RED || device.pixel(canvas, -61, -100) != GREEN || device.pixel(canvas, -62, -99) != BLUE || device.pixel(canvas, -61, -99) != WHITE { return 192 }
    device.destroy(canvas)
    device.destroy(lasso)
    device.destroy(far)
    device.clear(found)
    device.moveTo(found, 0, 0)
    return 0
}

fn random(state: *u64, below: u32) -> u32 {
    state.* ^= state.* << 13
    state.* ^= state.* >> 7
    state.* ^= state.* << 17
    return @intCast(u32, (state.* >> 20) % @intCast(u64, below))
}

fn between(state: *u64, low: i32, high: i32) -> i32 {
    return low + @intCast(i32, random(state, @intCast(u32, high - low + 1)))
}

// What the module's header says a pixel counts with.
fn amountBy(distance: u32, limit: u32, softness: u32, stopping: bool) -> u32 {
    const whole = limit * softness / 100
    const steps = limit + 1 - whole
    var amount: u32 = 0
    if distance <= whole {
        amount = 255
    } else if distance <= limit {
        amount = (255 * (limit + 1 - distance) + steps / 2) / steps
    }
    return if stopping { 255 - amount } else { amount }
}

// The plain way to a region: of `want` (amounts; 0: not to take) what is
// connected with `start` is marked in `member`, pixel by pixel.
fn connect(want: [*]const u8, member: [*]u8, stack: [*]u32, width: i32, height: i32, start: usize, diagonal: bool) -> void {
    var held: usize = 0
    if want[start] != 0 {
        member[start] = 1
        stack[0] = @intCast(u32, start)
        held = 1
    }
    while held > 0 {
        held -= 1
        const at = @intCast(i32, stack[held])
        var dy: i32 = -1
        while dy <= 1 {
            var dx: i32 = -1
            while dx <= 1 {
                const x = at % width + dx
                const y = at / width + dy
                if (dx != 0 || dy != 0) && (diagonal || dx == 0 || dy == 0) && x >= 0 && y >= 0 && x < width && y < height {
                    const next = @intCast(usize, y * width + x)
                    if want[next] != 0 && member[next] == 0 {
                        member[next] = 1
                        stack[held] = @intCast(u32, next)
                        held += 1
                    }
                }
                dx += 1
            }
            dy += 1
        }
    }
}

// The plain way to grow and shrink: every pixel the largest (smallest)
// within a disc; outside the area is the edge again, or nothing (`stop`).
fn reshaped(from: [*]const u8, into: [*]u8, width: i32, height: i32, grow: i32, stop: bool) -> void {
    const radius = if grow < 0 { -grow } else { grow }
    var y: i32 = 0
    while y < height {
        var x: i32 = 0
        while x < width {
            var result: u32 = if grow > 0 { 0 } else { 255 }
            var dy = -radius
            while dy <= radius {
                var dx = -radius
                while dx <= radius {
                    if dx * dx + dy * dy <= radius * radius {
                        const outside = x + dx < 0 || y + dy < 0 || x + dx >= width || y + dy >= height
                        var value: u32 = 0
                        if !outside || !stop { value = @intCast(u32, from[@intCast(usize, geom.clampInt(y + dy, 0, height - 1) * width + geom.clampInt(x + dx, 0, width - 1))]) }
                        if grow > 0 {
                            if value > result { result = value }
                        } else if value < result {
                            result = value
                        }
                    }
                    dx += 1
                }
                dy += 1
            }
            into[@intCast(usize, y * width + x)] = @intCast(u8, result)
            x += 1
        }
        y += 1
    }
}

// 300 pictures of rectangles and dots at random, a layer and a mask that
// sit anywhere, options at random: the mask is what the plain way gives,
// pixel for pixel, and the rectangle returned is the one around it.
fn against(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const colors = [8]u32{ BLACK, RED, 0xFFFA0000, 0, 0x00FFFFFF, GREEN, 0x80FF0000, 0xFF080808 }
    const thresholds = [6]u32{ 0, 0, 5, 8, 127, 255 }
    const softnesses = [4]u32{ 100, 100, 0, 50 }
    const grows = [8]i32{ 0, 0, 0, 1, 2, 3, -1, -2 }
    const most: usize = 100 * 100
    const pixels = allocator.words(most)
    const stack = allocator.words(most)
    const want = allocator.alloc(most, 16).?
    const member = allocator.alloc(most, 16).?
    const other = allocator.alloc(most, 16).?
    const got = allocator.alloc(most, 16).?
    var state: u64 = 88172645463325252
    var round: u32 = 0
    while round < 300 {
        const width = between(&state, 1, 100)
        const height = between(&state, 1, 100)
        const area = geom.rect(between(&state, -200, 200), between(&state, -200, 200), width, height)
        const sample = device.create(allocator, if random(&state, 4) == 0 { RED } else { 0 }).?
        device.moveTo(sample, between(&state, -100, 100), between(&state, -100, 100))
        device.moveTo(found, between(&state, -100, 100), between(&state, -100, 100))
        var shapes = random(&state, 10)
        while shapes > 0 {
            const place = geom.rect(area.x + between(&state, -20, width), area.y + between(&state, -20, height), between(&state, 1, 80), between(&state, 1, 80))
            _ = device.fill(sample, place, colors[@intCast(usize, random(&state, 8))])
            shapes -= 1
        }
        var dots = if random(&state, 3) == 0 { 0 } else { random(&state, 150) }
        while dots > 0 {
            device.setPixel(sample, area.x + between(&state, 0, width - 1), area.y + between(&state, 0, height - 1), colors[@intCast(usize, random(&state, 8))])
            dots -= 1
        }
        var options = fill.defaults()
        options.threshold = thresholds[@intCast(usize, random(&state, 6))]
        options.softness = softnesses[@intCast(usize, random(&state, 4))]
        options.diagonal = random(&state, 2) == 0
        options.contiguous = random(&state, 4) != 0
        const stopping = random(&state, 4) == 0
        if stopping {
            options.reference = fill.REFERENCE_BOUNDARY
            options.boundary = colors[@intCast(usize, random(&state, 8))]
        }
        options.grow = grows[@intCast(usize, random(&state, 8))]
        options.stopAtImageEdge = random(&state, 2) == 0
        const x = area.x + between(&state, 0, width - 1)
        const y = area.y + between(&state, 0, height - 1)
        const stride = @intCast(usize, width)
        const count = stride * @intCast(usize, height)
        device.readRect(sample, area, pixels, stride)
        const reference = if stopping { options.boundary } else { device.pixel(sample, x, y) }
        var index: usize = 0
        while index < count {
            want[index] = @intCast(u8, amountBy(fill.difference(pixels[index], reference), options.threshold, options.softness, stopping))
            member[index] = if options.contiguous { 0 } else { 1 }
            index += 1
        }
        if options.contiguous { connect(want, member, stack, width, height, @intCast(usize, y - area.y) * stride + @intCast(usize, x - area.x), options.diagonal) }
        index = 0
        while index < count {
            if member[index] == 0 { want[index] = 0 }
            index += 1
        }
        var expected = want
        if options.grow != 0 {
            reshaped(want, other, width, height, options.grow, options.stopAtImageEdge)
            expected = other
        }
        const result = fill.region(sample, x, y, area, &options, found)
        mask.readBytes(found, area, got, stride)
        if !std.mem.eql(expected, got, count) { return 210 }
        // Nothing but the region in the mask, the rectangle around it.
        if !geom.same(result, mask.bounds(found)) { return 211 }
        device.clear(found)
        device.destroy(sample)
        round += 1
    }
    device.moveTo(found, 0, 0)
    allocator.free(got, most, 16)
    allocator.free(other, most, 16)
    allocator.free(member, most, 16)
    allocator.free(want, most, 16)
    unsafe {
        allocator.free(@ptrCast([*]u8, stack), most * 4 + 4, 16)
        allocator.free(@ptrCast([*]u8, pixels), most * 4 + 4, 16)
    }
    return 0
}

// The pixel of a pattern `width` x `height` laid from (ox, oy) at (x, y),
// the differences taken in i64.
fn patternAt(pattern: [*]const u32, width: i32, height: i32, ox: i32, oy: i32, x: i32, y: i32) -> u32 {
    var column = (@intCast(i64, x) - @intCast(i64, ox)) % @intCast(i64, width)
    if column < 0 { column += @intCast(i64, width) }
    var row = (@intCast(i64, y) - @intCast(i64, oy)) % @intCast(i64, height)
    if row < 0 { row += @intCast(i64, height) }
    return pattern[@intCast(usize, row * @intCast(i64, width) + column)]
}

// The ends of what makes sense: areas of one pixel on either side of tile
// borders at both signs, grown into discs; one column across tiles; a
// wall along a tile border and a diagonal line through a tile's corner;
// the amounts at the ends of the threshold; a transparent boundary;
// options beyond their range; areas of no size; places a billion pixels
// out, a layer two billion away from the area; a pattern laid from the
// ends of i32.
fn extremes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    var options = fill.defaults()
    options.threshold = 0
    const dots = device.create(allocator, 0).?
    const corners = [6]i32{ 63, 64, -1, -64, -65, 127 }
    var index: usize = 0
    while index < 6 {
        device.setPixel(dots, corners[index], corners[index], BLACK)
        index += 1
    }
    index = 0
    while index < 6 {
        const c = corners[index]
        device.clear(found)
        if !is(fill.region(dots, c, c, geom.rect(c, c, 1, 1), &options, found), c, c, 1, 1) || mask.at(found, c, c) != 255 || mask.at(found, c + 1, c) != 0 || mask.at(found, c, c - 1) != 0 { return 212 }
        // The dot alone (its diagonal neighbour is another region), grown
        // by 1 and 2: discs of 5 and 13 pixels; shrunk: nothing.
        const around = geom.rect(c - 10, c - 10, 21, 21)
        if !is(fill.region(dots, c, c, around, &options, found), c, c, 1, 1) || measure(found, around, false) != 1 { return 213 }
        options.grow = 1
        if !is(fill.region(dots, c, c, around, &options, found), c - 1, c - 1, 3, 3) || measure(found, around, false) != 5 || mask.at(found, c - 1, c - 1) != 0 { return 214 }
        options.grow = 2
        if !is(fill.region(dots, c, c, around, &options, found), c - 2, c - 2, 5, 5) || measure(found, around, false) != 13 || mask.at(found, c + 2, c + 1) != 0 || mask.at(found, c + 2, c) != 255 { return 215 }
        options.grow = -1
        if !geom.isEmpty(fill.region(dots, c, c, around, &options, found)) || measure(found, around, false) != 0 { return 216 }
        options.grow = 0
        index += 1
    }
    // One column across three tiles.
    device.clear(found)
    if !is(fill.region(dots, 70, 150, geom.rect(70, -100, 1, 300), &options, found), 70, -100, 1, 300) || measure(found, geom.rect(69, -101, 3, 302), false) != 300 { return 217 }
    device.destroy(dots)

    // A wall on a tile's first column; a line across a tile's corner.
    const wall = device.create(allocator, 0).?
    _ = device.fill(wall, geom.rect(64, -200, 1, 400), BLACK)
    const field = geom.rect(0, -100, 128, 200)
    if !is(fill.region(wall, 63, 0, field, &options, found), 0, -100, 64, 200) || measure(found, field, false) != 12800 { return 218 }
    if !is(fill.region(wall, 65, 0, field, &options, found), 65, -100, 63, 200) || measure(found, field, false) != 12600 { return 219 }
    if !is(fill.region(wall, 64, 0, field, &options, found), 64, -100, 1, 200) || measure(found, field, false) != 200 { return 220 }
    device.destroy(wall)
    const line = device.create(allocator, 0).?
    var x: i32 = 0
    while x < 128 {
        device.setPixel(line, x, 127 - x, BLACK)
        x += 1
    }
    const square = geom.rect(0, 0, 128, 128)
    // Below the line x + y < 127: 1 + 2 + ... + 127; across it, with
    // diagonal neighbours, all but the line.
    if !is(fill.region(line, 0, 0, square, &options, found), 0, 0, 127, 127) || measure(found, square, false) != 8128 { return 221 }
    options.diagonal = true
    if !is(fill.region(line, 0, 0, square, &options, found), 0, 0, 128, 128) || measure(found, square, false) != 16256 || mask.at(found, 64, 64) != 255 || mask.at(found, 64, 63) != 0 { return 222 }
    options.diagonal = false
    device.destroy(line)

    // The amounts at the ends: a threshold of 255 at softness 0 falls
    // from 255 to nothing past 255: 255 * (256 - d) / 256, rounded; a
    // threshold of 1 halves; options far past their range are their ends.
    const ramp = device.create(allocator, 0).?
    x = 0
    while x < 256 {
        _ = device.fill(ramp, geom.rect(x, 0, 1, 4), pixel.rgb(@intCast(u32, x), @intCast(u32, x), @intCast(u32, x)))
        x += 1
    }
    const strip = geom.rect(0, 0, 256, 4)
    options.threshold = 255
    options.softness = 0
    if !is(fill.region(ramp, 0, 1, strip, &options, found), 0, 0, 256, 4) || measure(found, strip, false) != 1024 { return 223 }
    if mask.at(found, 0, 0) != 255 || mask.at(found, 1, 1) != 254 || mask.at(found, 128, 2) != 128 || mask.at(found, 255, 3) != 1 { return 224 }
    options.threshold = 1
    if !is(fill.region(ramp, 0, 1, strip, &options, found), 0, 0, 2, 4) || mask.at(found, 0, 2) != 255 || mask.at(found, 1, 2) != 128 { return 225 }
    options.threshold = 0xFFFFFFFF
    options.softness = 0xFFFFFFFF
    if measure(found, fill.region(ramp, 0, 1, strip, &options, found), true) != 1024 * 255 { return 226 }
    options.threshold = 0
    options.softness = 100
    device.destroy(ramp)

    // Every transparent pixel is a transparent boundary, whatever colour
    // hides in it: the opaque square inside is the region; clicked on
    // the boundary, nothing.
    const glass = device.create(allocator, 0).?
    _ = device.fill(glass, geom.rect(0, 0, 40, 40), 0x00FF0000)
    _ = device.fill(glass, geom.rect(5, 5, 10, 10), 0x0000FF00)
    _ = device.fill(glass, geom.rect(20, 20, 10, 10), BLUE)
    _ = device.fill(glass, geom.rect(22, 22, 3, 3), RED)
    const pane = geom.rect(-10, -10, 60, 60)
    options.reference = fill.REFERENCE_BOUNDARY
    options.boundary = 0x00ABCDEF
    if !is(fill.region(glass, 21, 21, pane, &options, found), 20, 20, 10, 10) || measure(found, pane, false) != 100 { return 227 }
    if !geom.isEmpty(fill.region(glass, 7, 7, pane, &options, found)) || measure(found, pane, false) != 0 { return 228 }
    options = fill.defaults()
    options.threshold = 0
    device.destroy(glass)

    // Areas of no size or less: nothing anywhere.
    const plain = device.create(allocator, 0).?
    const lasso = mask.create(allocator, true).?
    _ = device.fill(found, geom.rect(0, 0, 8, 8), mask.ALL)
    const backwards = geom.rect(5, 5, -3, 4)
    if !geom.isEmpty(fill.region(plain, 5, 5, backwards, &options, found)) || !geom.isEmpty(fill.similar(plain, 0, backwards, &options, found)) { return 229 }
    if !geom.isEmpty(fill.enclosed(plain, lasso, geom.rect(5, 5, 4, 0), &options, found, fill.ALL_REGIONS)) || measure(found, geom.rect(0, 0, 8, 8), false) != 64 { return 230 }
    if !geom.isEmpty(fill.paint(plain, found, backwards, GREEN, blend.NORMAL, 255, 0, null)) || device.tileCount(plain) != 0 { return 231 }
    device.clear(found)

    // A billion pixels out, the layer and the mask moved there too.
    const d: i32 = 1000000000
    const far = device.create(allocator, 0).?
    device.moveTo(far, d - 37, -d + 5)
    device.moveTo(found, d + 3, -d - 70)
    outline(far, geom.rect(d + 10, -d + 10, 30, 30), BLACK)
    const out = geom.rect(d, -d, 100, 80)
    if !is(fill.region(far, d + 20, -d + 20, out, &options, found), d + 11, -d + 11, 28, 28) || measure(found, out, false) != 784 { return 232 }
    if !is(fill.region(far, d, -d, out, &options, found), d, -d, 100, 80) || measure(found, out, false) != 7100 || mask.at(found, d + 20, -d + 20) != 0 { return 233 }
    options.grow = 1
    if !is(fill.region(far, d + 20, -d + 20, out, &options, found), d + 10, -d + 10, 30, 30) || measure(found, out, false) != 896 { return 234 }
    options.grow = 0
    // The layer two billion pixels from the area: its tiles are numbered
    // past 31 million there, and there is nothing in them.
    device.moveTo(far, -d, 0)
    if !is(fill.region(far, d + 50, -d + 40, out, &options, found), d, -d, 100, 80) || measure(found, out, false) != 8000 { return 235 }
    device.clear(found)
    device.moveTo(found, 0, 0)
    device.destroy(far)

    // A pattern laid from the ends of i32: the place in it is the
    // difference taken whole.
    const block = device.create(allocator, 0).?
    _ = device.fill(block, geom.rect(30, 20, 40, 30), RED)
    const bounds = fill.region(block, 40, 30, geom.rect(0, 0, 100, 80), &options, found)
    const wide = [6]u32{ 0xFF000001, 0xFF000002, 0xFF000003, 0xFF000004, 0xFF000005, 0xFF000006 }
    const ends = [4]i32{ -2147483647 - 1, 2147483647, -2147483647, 2147483646 }
    index = 0
    while index < 4 {
        const ox = ends[index]
        const oy = ends[3 - index]
        device.clear(plain)
        if !is(fill.paintPattern(plain, found, bounds, &wide, 3, 2, ox, oy, blend.NORMAL, 255, 0, null), 30, 20, 40, 30) { return 236 }
        var py: i32 = 20
        while py < 50 {
            var px: i32 = 30
            while px < 70 {
                if device.pixel(plain, px, py) != patternAt(&wide, 3, 2, ox, oy, px, py) { return 237 }
                px += 1
            }
            py += 1
        }
        index += 1
    }
    // (30, 20) from (-2^31, 2^31 - 1): column 2147483678 mod 3 = 2, row
    // -2147483627 mod 2 = 1.
    device.clear(plain)
    _ = fill.paintPattern(plain, found, bounds, &wide, 3, 2, -2147483647 - 1, 2147483647, blend.NORMAL, 255, 0, null)
    if device.pixel(plain, 30, 20) != 0xFF000006 { return 238 }
    // Bounds of the whole plane cost what the region's do.
    device.clear(plain)
    const started = std.time.milliseconds()
    const everything = fill.paint(plain, found, geom.rect(-1000000000, -1000000000, 2000000000, 2000000000), GREEN, blend.NORMAL, 255, 0, lasso)
    if !is(everything, 30, 20, 40, 30) || device.pixel(plain, 30, 20) != GREEN || device.tileCount(plain) != 2 || std.time.milliseconds() - started > 1000 { return 239 }
    device.clear(found)
    device.destroy(block)
    device.destroy(lasso)
    device.destroy(plain)
    return 0
}

// Whether two masks hold the same amounts in `area`.
fn alike(a: *device.Device, b: *device.Device, area: geom.Rect) -> bool {
    const allocator = std.heap.allocator()
    const width = @intCast(usize, area.width)
    const count = width * @intCast(usize, area.height)
    const first = allocator.alloc(count, 16).?
    const second = allocator.alloc(count, 16).?
    mask.readBytes(a, area, first, width)
    mask.readBytes(b, area, second, width)
    const same = std.mem.eql(first, second, count)
    allocator.free(second, count, 16)
    allocator.free(first, count, 16)
    return same
}

// A change open on the mask while a search runs is recorded whole and
// undone and redone exactly; one open on the sample records nothing. The
// same search twice finds the same. A mask whose default is everything
// is made nothing within the area and keeps everything outside it, and
// holds there what a mask of nothing holds.
fn changes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 100, 80)
    const view = geom.rect(-30, -30, 160, 140)
    const layer = device.create(allocator, 0).?
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    _ = device.fill(layer, geom.rect(60, 30, 20, 20), RED)
    _ = device.fill(layer, geom.rect(64, 34, 5, 5), 0xFFF00000)
    const lasso = mask.create(allocator, false).?
    _ = device.fill(lasso, geom.rect(5, 5, 50, 50), mask.ALL)
    var options = fill.defaults()
    options.threshold = 16
    options.softness = 30
    options.grow = 2
    options.feather = 3.0

    // Something there before, in the area and out of it.
    device.clear(found)
    _ = device.fill(found, geom.rect(-20, -20, 30, 30), mask.ALL)
    _ = device.fill(found, geom.rect(50, 50, 70, 5), pixel.gray(77))
    const before = mask.create(allocator, false).?
    _ = device.assign(before, found)
    device.begin(found)
    device.begin(layer)
    const first = fill.region(layer, 70, 40, area, &options, found)
    const kept = mask.create(allocator, false).?
    _ = device.assign(kept, found)
    const second = fill.region(layer, 70, 40, area, &options, found)
    if geom.isEmpty(first) || !geom.same(first, second) || !alike(kept, found, view) { return 240 }
    if device.commit(layer) != null { return 241 }
    const change = device.commit(found)
    if change == null { return 242 }
    _ = device.apply(found, change.?, true)
    if !alike(before, found, view) || mask.at(found, -20, -20) != 255 || mask.at(found, 110, 52) != 77 { return 243 }
    _ = device.apply(found, change.?, false)
    if !alike(kept, found, view) || mask.at(found, 110, 52) != 77 || mask.at(found, 0, 0) != 0 { return 244 }
    device.destroyChange(change.?)
    // The others twice, the same.
    _ = fill.enclosed(layer, lasso, area, &options, found, fill.TRANSPARENT_REGIONS)
    _ = device.assign(kept, found)
    _ = fill.enclosed(layer, lasso, area, &options, found, fill.TRANSPARENT_REGIONS)
    if !alike(kept, found, view) { return 245 }
    _ = fill.similar(layer, RED, area, &options, found)
    _ = device.assign(kept, found)
    _ = fill.similar(layer, RED, area, &options, found)
    if !alike(kept, found, view) { return 246 }

    // Into a mask of everything, every way a search goes: what a mask of
    // nothing holds in the area, everything outside it.
    const full = mask.create(allocator, true).?
    var round: i32 = 0
    while round < 16 {
        options = fill.defaults()
        options.threshold = if round & 1 == 0 { 0 } else { 20 }
        options.softness = if round & 2 == 0 { 100 } else { 0 }
        options.grow = (round & 3) - 1
        options.feather = if round & 4 == 0 { 0.0 } else { 2.0 }
        options.contiguous = round & 8 == 0
        device.clear(found)
        const plain = fill.region(layer, 70, 40, area, &options, found)
        if !geom.same(plain, fill.region(layer, 70, 40, area, &options, full)) || !alike(found, full, area) { return 247 }
        if mask.at(full, -1, -1) != 255 || mask.at(full, 100, 40) != 255 || mask.at(full, 50, 80) != 255 { return 248 }
        const inside = fill.enclosed(layer, lasso, area, &options, found, @intCast(u8, round & 3))
        if !geom.same(inside, fill.enclosed(layer, lasso, area, &options, full, @intCast(u8, round & 3))) || !alike(found, full, area) || mask.at(full, -1, 0) != 255 { return 249 }
        const like = fill.similar(layer, RED, area, &options, found)
        if !geom.same(like, fill.similar(layer, RED, area, &options, full)) || !alike(found, full, area) || mask.at(full, 0, -1) != 255 { return 250 }
        round += 1
    }
    device.clear(found)
    device.destroy(full)
    device.destroy(kept)
    device.destroy(before)
    device.destroy(lasso)
    device.destroy(layer)
    return 0
}

// What the module takes of the heap it gives back: the list of rows that
// grows (a comb), the searches inside a shape, grown, shrunk, feathered
// both ways, painted. A round leaves the heap as the round before did.
fn giving(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const comb = device.create(allocator, 0).?
    _ = device.fill(comb, geom.rect(0, 1, 3000, 2), BLACK)
    var tooth: i32 = 0
    while tooth < 3000 {
        _ = device.fill(comb, geom.rect(tooth, 1, 1, 2), 0)
        tooth += 2
    }
    const strip = geom.rect(0, 0, 3000, 3)
    const area = geom.rect(0, 0, 300, 200)
    const scene = device.create(allocator, 0).?
    outline(scene, geom.rect(10, 10, 100, 100), BLACK)
    _ = device.fill(scene, geom.rect(150, 50, 60, 60), RED)
    const lasso = mask.create(allocator, false).?
    _ = device.fill(lasso, geom.rect(0, 0, 130, 130), mask.ALL)
    const canvas = device.create(allocator, 0).?
    const pattern = [4]u32{ RED, GREEN, BLUE, WHITE }
    var options = fill.defaults()
    options.threshold = 0
    var held: usize = 0
    var round: u32 = 0
    while round < 6 {
        options.grow = 0
        options.feather = 0.0
        if !is(fill.region(comb, 0, 0, strip, &options, found), 0, 0, 3000, 3) { return 251 }
        options.grow = 5
        options.feather = 40.0
        if geom.isEmpty(fill.region(scene, 50, 50, area, &options, found)) { return 252 }
        options.grow = -5
        options.feather = 3.0
        _ = fill.similar(scene, RED, area, &options, found)
        var method: u8 = 0
        while method < fill.METHODS {
            _ = fill.enclosed(scene, lasso, area, &options, found, method)
            method += 1
        }
        _ = fill.region(scene, 50, 50, area, &options, found)
        _ = fill.paint(canvas, found, area, GREEN, blend.NORMAL, 200, 0, lasso)
        _ = fill.paintPattern(canvas, found, area, &pattern, 2, 2, 1, 1, blend.MULTIPLY, 255, 0, null)
        // (the first round fills the working memory's blocks and makes
        // the devices' tiles and tables)
        if round == 1 { held = std.heap.liveBytes() }
        if round > 1 && std.heap.liveBytes() != held { return 253 }
        round += 1
    }
    device.clear(found)
    device.destroy(canvas)
    device.destroy(lasso)
    device.destroy(scene)
    device.destroy(comb)
    return 0
}

// The amounts of `pixels` against `reference` (`count` of them) into `want`.
fn weighAll(pixels: [*]const u32, want: [*]u8, count: usize, reference: u32, options: *const fill.Options, stopping: bool) -> void {
    const limit = if options.*.threshold > 255 { 255 } else { options.*.threshold }
    const soft = if options.*.softness > 100 { 100 } else { options.*.softness }
    var index: usize = 0
    while index < count {
        want[index] = @intCast(u8, amountBy(fill.difference(pixels[index], reference), limit, soft, stopping))
        index += 1
    }
}

// A picture of rectangles and dots at random within (and around) `area`.
fn scatter(state: *u64, sample: *device.Device, area: geom.Rect, colors: [*]const u32, kinds: u32) -> void {
    var shapes = random(state, 12)
    while shapes > 0 {
        const place = geom.rect(area.x + between(state, -20, area.width), area.y + between(state, -20, area.height), between(state, 1, area.width / 2 + 3), between(state, 1, area.height / 2 + 3))
        _ = device.fill(sample, place, colors[@intCast(usize, random(state, kinds))])
        shapes -= 1
    }
    var dots = random(state, 60)
    while dots > 0 {
        device.setPixel(sample, area.x + between(state, 0, area.width - 1), area.y + between(state, 0, area.height - 1), colors[@intCast(usize, random(state, kinds))])
        dots -= 1
    }
}

// enclosed() against the plain way: from every pixel inside the shape,
// row after row, that no search reached yet and that is to take, the
// pixels connected with it (compared with its own colour for
// ALL_REGIONS, else with the method's colour; for REGIONS_SURROUNDED_BY
// everything that is not the boundary's), every one of them noted as
// reached; the region kept, each amount the larger, when none of it is
// outside the shape. 400 pictures, shapes and options at random (a
// quarter of them or so keep something).
fn enclosedAgainst(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const colors = [8]u32{ BLACK, RED, 0xFFFA0000, 0, 0x00FFFFFF, GREEN, 0x80FF0000, 0xFF080808 }
    const thresholds = [5]u32{ 0, 0, 5, 8, 127 }
    const softnesses = [3]u32{ 100, 0, 50 }
    const grows = [6]i32{ 0, 0, 0, 1, 2, -1 }
    const methods = [5]u8{ fill.ALL_REGIONS, fill.REGIONS_OF_COLOR, fill.TRANSPARENT_REGIONS, fill.REGIONS_SURROUNDED_BY, 9 }
    const most: usize = 40 * 40
    const pixels = allocator.words(most)
    const stack = allocator.words(most)
    const want = allocator.alloc(most, 16).?
    const member = allocator.alloc(most, 16).?
    const seen = allocator.alloc(most, 16).?
    const inside = allocator.alloc(most, 16).?
    const result = allocator.alloc(most, 16).?
    const other = allocator.alloc(most, 16).?
    const got = allocator.alloc(most, 16).?
    var state: u64 = 0x9E3779B97F4A7C15
    var kept: u32 = 0
    var round: u32 = 0
    while round < 400 {
        const width = between(&state, 1, 40)
        const height = between(&state, 1, 40)
        const area = geom.rect(between(&state, -150, 150), between(&state, -150, 150), width, height)
        const sample = device.create(allocator, if random(&state, 4) == 0 { RED } else { 0 }).?
        device.moveTo(sample, between(&state, -100, 100), between(&state, -100, 100))
        device.moveTo(found, between(&state, -100, 100), between(&state, -100, 100))
        scatter(&state, sample, area, &colors, 8)
        // The shape: a few rectangles, some of them not whole, on nothing
        // or (now and then) on everything with holes.
        const everywhere = random(&state, 5) == 0
        const shape = mask.create(allocator, everywhere).?
        device.moveTo(shape, between(&state, -100, 100), between(&state, -100, 100))
        var parts = random(&state, 5) + 1
        while parts > 0 {
            const place = geom.rect(area.x + between(&state, -10, width), area.y + between(&state, -10, height), between(&state, 1, width), between(&state, 1, height))
            const amounts = [5]u32{ 255, 255, 0, 128, 127 }
            _ = device.fill(shape, place, pixel.gray(amounts[@intCast(usize, random(&state, 5))]))
            parts -= 1
        }
        var options = fill.defaults()
        options.threshold = thresholds[@intCast(usize, random(&state, 5))]
        options.softness = softnesses[@intCast(usize, random(&state, 3))]
        options.diagonal = random(&state, 2) == 0
        options.boundary = colors[@intCast(usize, random(&state, 8))]
        options.grow = grows[@intCast(usize, random(&state, 6))]
        options.stopAtImageEdge = random(&state, 2) == 0
        const method = methods[@intCast(usize, random(&state, 5))]
        const stride = @intCast(usize, width)
        const count = stride * @intCast(usize, height)
        device.readRect(sample, area, pixels, stride)
        mask.readBytes(shape, area, inside, stride)
        const stopping = method == fill.REGIONS_SURROUNDED_BY
        var reference = options.boundary
        if method == fill.TRANSPARENT_REGIONS { reference = 0 }
        if method != fill.ALL_REGIONS { weighAll(pixels, want, count, reference, &options, stopping) }
        var index: usize = 0
        while index < count {
            seen[index] = 0
            result[index] = 0
            index += 1
        }
        var start: usize = 0
        while start < count {
            if inside[start] >= 128 && seen[start] == 0 {
                if method == fill.ALL_REGIONS { weighAll(pixels, want, count, pixels[start], &options, false) }
                if want[start] != 0 {
                    index = 0
                    while index < count {
                        member[index] = 0
                        index += 1
                    }
                    connect(want, member, stack, width, height, start, options.diagonal)
                    var within = true
                    index = 0
                    while index < count {
                        if member[index] != 0 {
                            seen[index] = 1
                            if inside[index] < 128 { within = false }
                        }
                        index += 1
                    }
                    if within {
                        index = 0
                        while index < count {
                            if member[index] != 0 && want[index] > result[index] { result[index] = want[index] }
                            index += 1
                        }
                    }
                }
            }
            start += 1
        }
        var expected = result
        if options.grow != 0 {
            reshaped(result, other, width, height, options.grow, options.stopAtImageEdge)
            expected = other
        }
        const rect = fill.enclosed(sample, shape, area, &options, found, method)
        mask.readBytes(found, area, got, stride)
        if !std.mem.eql(expected, got, count) { return 204 }
        if !geom.same(rect, mask.bounds(found)) { return 205 }
        if !geom.isEmpty(rect) { kept += 1 }
        device.clear(found)
        device.destroy(shape)
        device.destroy(sample)
        round += 1
    }
    device.moveTo(found, 0, 0)
    // (and the comparison was not of nothing with nothing only)
    if kept < 80 { return 206 }
    allocator.free(got, most, 16)
    allocator.free(other, most, 16)
    allocator.free(result, most, 16)
    allocator.free(inside, most, 16)
    allocator.free(seen, most, 16)
    allocator.free(member, most, 16)
    allocator.free(want, most, 16)
    unsafe {
        allocator.free(@ptrCast([*]u8, stack), most * 4 + 4, 16)
        allocator.free(@ptrCast([*]u8, pixels), most * 4 + 4, 16)
    }
    return 0
}

// region() and similar() against the plain way on larger areas: widths
// and heights of one, either side of 64 and of 128, places on and off the
// tiles' 64s, grown and shrunk by up to 12, 40 pictures at random.
fn largerAgainst(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const colors = [6]u32{ BLACK, RED, 0xFFF80000, 0, 0x00FF00FF, 0xFF101010 }
    const sizes = [10]i32{ 1, 2, 63, 64, 65, 127, 128, 129, 150, 97 }
    const grows = [9]i32{ 0, 4, -4, 7, -7, 12, -12, 10, -1 }
    const most: usize = 160 * 160
    const pixels = allocator.words(most)
    const stack = allocator.words(most)
    const want = allocator.alloc(most, 16).?
    const member = allocator.alloc(most, 16).?
    const other = allocator.alloc(most, 16).?
    const got = allocator.alloc(most, 16).?
    var state: u64 = 0x2545F4914F6CDD1D
    var round: u32 = 0
    while round < 40 {
        const width = if random(&state, 3) == 0 { between(&state, 1, 160) } else { sizes[@intCast(usize, random(&state, 10))] }
        const height = if random(&state, 3) == 0 { between(&state, 1, 160) } else { sizes[@intCast(usize, random(&state, 10))] }
        // On the sample's 64s or anywhere.
        const sample = device.create(allocator, if random(&state, 5) == 0 { 0xFFF80000 } else { 0 }).?
        device.moveTo(sample, between(&state, -100, 100), between(&state, -100, 100))
        var area = geom.rect(between(&state, -300, 300), between(&state, -300, 300), width, height)
        if random(&state, 2) == 0 { area = geom.rect(sample.*.x + 64 * between(&state, -3, 3), sample.*.y + 64 * between(&state, -3, 3), width, height) }
        device.moveTo(found, between(&state, -100, 100), between(&state, -100, 100))
        scatter(&state, sample, area, &colors, 6)
        var options = fill.defaults()
        options.threshold = if random(&state, 2) == 0 { 0 } else { 8 }
        options.softness = if random(&state, 2) == 0 { 100 } else { 0 }
        options.diagonal = random(&state, 2) == 0
        options.grow = grows[@intCast(usize, random(&state, 9))]
        options.stopAtImageEdge = random(&state, 2) == 0
        const alike_any = random(&state, 3) == 0
        const x = area.x + between(&state, 0, width - 1)
        const y = area.y + between(&state, 0, height - 1)
        const stride = @intCast(usize, width)
        const count = stride * @intCast(usize, height)
        device.readRect(sample, area, pixels, stride)
        const reference = if alike_any { colors[@intCast(usize, random(&state, 6))] } else { device.pixel(sample, x, y) }
        weighAll(pixels, want, count, reference, &options, false)
        var index: usize = 0
        if !alike_any {
            while index < count {
                member[index] = 0
                index += 1
            }
            connect(want, member, stack, width, height, @intCast(usize, y - area.y) * stride + @intCast(usize, x - area.x), options.diagonal)
            index = 0
            while index < count {
                if member[index] == 0 { want[index] = 0 }
                index += 1
            }
        }
        var expected = want
        if options.grow != 0 {
            reshaped(want, other, width, height, options.grow, options.stopAtImageEdge)
            expected = other
        }
        var result = geom.empty()
        if alike_any {
            result = fill.similar(sample, reference, area, &options, found)
        } else {
            result = fill.region(sample, x, y, area, &options, found)
        }
        mask.readBytes(found, area, got, stride)
        if !std.mem.eql(expected, got, count) { return 207 }
        if !geom.same(result, mask.bounds(found)) { return 208 }
        device.clear(found)
        device.destroy(sample)
        round += 1
    }
    device.moveTo(found, 0, 0)
    allocator.free(got, most, 16)
    allocator.free(other, most, 16)
    allocator.free(member, most, 16)
    allocator.free(want, most, 16)
    unsafe {
        allocator.free(@ptrCast([*]u8, stack), most * 4 + 4, 16)
        allocator.free(@ptrCast([*]u8, pixels), most * 4 + 4, 16)
    }
    return 0
}

fn doublesOf(memory: [*]u8) -> [*]f64 { unsafe { return @ptrCast([*]f64, memory) } }

// What a blur leaves along one line of a run `length` long (`profile`
// from `before` pixels ahead of it to as many past it): a feather of 32
// or less is a Gaussian of a third of it as its deviation (0.05 below
// 0.15) over ceil(feather) to either side, its weights normalized; more
// is three means one after the other, of the widths whose variances add
// up to the Gaussian's (the narrower odd width w <= sqrt(4 dev^2 + 1),
// round((12 dev^2 - 3 w^2 - 12 w - 9) / (-4 w - 4)) of them that narrow,
// the others 2 wider; `gaussian`: the Gaussian whatever the feather).
// `line`, `spare`: room for the profile's length. Returns how far the
// blur reaches.
fn blurred(feather: f64, gaussian: bool, length: i32, before: i32, profile: [*]f64, line: [*]f64, spare: [*]f64) -> i32 {
    const total = length + 2 * before
    var index: i32 = 0
    while index < total {
        line[@intCast(usize, index)] = if index >= before && index < before + length { 1.0 } else { 0.0 }
        profile[@intCast(usize, index)] = 0.0
        index += 1
    }
    if feather <= 32.0 || gaussian {
        const reach = @intFromFloat(i32, @ceil(feather))
        const deviation = if feather < 0.15 { 0.05 } else { feather / 3.0 }
        var sum: f64 = 0.0
        var k = -reach
        while k <= reach {
            sum += math.exp(-@floatFromInt(f64, k * k) / (2.0 * deviation * deviation))
            k += 1
        }
        index = 0
        while index < total {
            k = -reach
            var value: f64 = 0.0
            while k <= reach {
                const from = index - k
                if from >= 0 && from < total { value += line[@intCast(usize, from)] * math.exp(-@floatFromInt(f64, k * k) / (2.0 * deviation * deviation)) / sum }
                k += 1
            }
            profile[@intCast(usize, index)] = value
            index += 1
        }
        return reach
    }
    const deviation = feather / 3.0
    var narrow_width = @intFromFloat(i32, @floor(math.sqrt(4.0 * deviation * deviation + 1.0)))
    if narrow_width & 1 == 0 { narrow_width -= 1 }
    const w = @floatFromInt(f64, narrow_width)
    const narrow = @intFromFloat(i32, math.round((12.0 * deviation * deviation - 3.0 * w * w - 12.0 * w - 9.0) / (-4.0 * w - 4.0)))
    var reach: i32 = 0
    var pass: i32 = 0
    while pass < 3 {
        const radius = if pass < narrow { (narrow_width - 1) / 2 } else { (narrow_width + 1) / 2 }
        reach += radius
        index = 0
        while index < total {
            var value: f64 = 0.0
            var k = -radius
            while k <= radius {
                const from = index + k
                if from >= 0 && from < total { value += line[@intCast(usize, from)] }
                k += 1
            }
            spare[@intCast(usize, index)] = value / @floatFromInt(f64, 2 * radius + 1)
            index += 1
        }
        index = 0
        while index < total {
            line[@intCast(usize, index)] = spare[@intCast(usize, index)]
            index += 1
        }
        pass += 1
    }
    index = 0
    while index < total {
        profile[@intCast(usize, index)] = line[@intCast(usize, index)]
        index += 1
    }
    return reach
}

// A rectangle feathered: every amount 255 times the product of what the
// blur leaves of the rectangle along its row and its column, within one
// level for the Gaussian (two passes, each rounded) and three for the
// means (six), nothing past the blur's reach, the area far around it
// (`gaussian`: compared with the Gaussian whatever the feather).
fn feathered(found: *device.Device, feather: f64, block: geom.Rect, tolerance: f64, gaussian: bool) -> bool {
    const allocator = std.heap.allocator()
    const sample = device.create(allocator, 0).?
    _ = device.fill(sample, block, RED)
    const margin: i32 = 420
    const longest = @intCast(usize, (if block.width > block.height { block.width } else { block.height }) + 2 * margin)
    const memory = allocator.alloc(longest * 8 * 5, 16).?
    const across = doublesOf(memory)
    const down = across + longest
    const line = down + longest
    const spare = line + longest
    const reach = blurred(feather, gaussian, block.width, margin, across, line, spare)
    _ = blurred(feather, gaussian, block.height, margin, down, line, spare)
    // (the means reach a little past the Gaussian's ceil(feather))
    const area = geom.grown(block, reach + 9)
    var options = fill.defaults()
    options.threshold = 0
    options.feather = feather
    const result = fill.region(sample, block.x, block.y, area, &options, found)
    var whole = geom.isEmpty(result) == false
    const row = allocator.alloc(@intCast(usize, area.width), 16).?
    var y = area.y
    while y < area.y + area.height && whole {
        mask.readBytes(found, geom.rect(area.x, y, area.width, 1), row, @intCast(usize, area.width))
        const vertical = down[@intCast(usize, y - block.y + margin)]
        var x = area.x
        while x < area.x + area.width {
            const expected = 255.0 * across[@intCast(usize, x - block.x + margin)] * vertical
            const got = @floatFromInt(f64, row[@intCast(usize, x - area.x)])
            const far = x < block.x - reach || x >= block.x + block.width + reach || y < block.y - reach || y >= block.y + block.height + reach
            if math.abs(got - expected) > tolerance + 0.000001 || (far && got != 0.0) { whole = false }
            x += 1
        }
        y += 1
    }
    allocator.free(row, @intCast(usize, area.width), 16)
    allocator.free(memory, longest * 8 * 5, 16)
    device.clear(found)
    device.destroy(sample)
    return whole
}

// Feathered against the plain sums, from a fraction of a pixel to the
// most, single pixels and long thin rectangles, on and off the tiles;
// the three means also against the Gaussian they stand for: within the
// six levels the module's header promises.
fn featherAgainst(found: *device.Device) -> u8 {
    if !feathered(found, 0.5, geom.rect(3, 5, 1, 1), 1.0, false) { return 143 }
    if !feathered(found, 1.0, geom.rect(-64, 63, 1, 1), 1.0, false) { return 144 }
    if !feathered(found, 2.5, geom.rect(-7, -9, 7, 9), 1.0, false) { return 145 }
    if !feathered(found, 7.3, geom.rect(60, 1, 13, 2), 1.0, false) { return 146 }
    if !feathered(found, 16.0, geom.rect(-100, 30, 60, 50), 1.0, false) { return 147 }
    if !feathered(found, 32.0, geom.rect(10, -70, 70, 64), 1.0, false) { return 148 }
    if !feathered(found, 32.5, geom.rect(-33, 17, 80, 1), 3.0, false) || !feathered(found, 32.5, geom.rect(-33, 17, 80, 1), 6.0, true) { return 149 }
    if !feathered(found, 45.5, geom.rect(5, 5, 100, 90), 3.0, false) || !feathered(found, 45.5, geom.rect(5, 5, 100, 90), 6.0, true) { return 177 }
    if !feathered(found, 120.0, geom.rect(-150, -129, 300, 260), 3.0, false) || !feathered(found, 120.0, geom.rect(-150, -129, 300, 260), 6.0, true) { return 178 }
    if !feathered(found, 400.0, geom.rect(0, 0, 600, 500), 3.0, false) || !feathered(found, 400.0, geom.rect(0, 0, 600, 500), 6.0, true) { return 179 }
    return 0
}

// paint() and paintPattern() against blend.blendPixelAt pixel by pixel:
// within the bounds each pixel is what the mode leaves of it at the
// opacity times the region's amount times the selection's (each product
// pixel.mul), seeded by its place; outside them nothing changes; the
// rectangle returned is the one around the pixels whose region's amount
// (times the selection's) is more than nothing. Region masks, selections
// and layers of either default, each moved anywhere, modes and flags,
// patterns of any size from any offset, 150 at random.
fn paintAgainst() -> u8 {
    const allocator = std.heap.allocator()
    const colors = [8]u32{ BLACK, RED, 0x80FF0000, 0, 0x00FFFFFF, GREEN, 0x40102030, WHITE }
    const modes = [12]u16{ blend.NORMAL, blend.NORMAL, blend.MULTIPLY, blend.SCREEN, blend.DISSOLVE, blend.ERASE, blend.COPY, blend.BEHIND, blend.DESTINATION_IN, blend.OVERLAY, blend.DODGE, 400 }
    const flagsets = [5]u32{ 0, 0, blend.FLAG_ALPHA_LOCK, blend.FLAG_LOCK_RED, blend.FLAG_ALPHA_LOCK | blend.FLAG_LOCK_BLUE }
    const levels = [6]u32{ 255, 255, 0, 1, 128, 200 }
    const most: usize = 264 * 264
    const before = allocator.words(most)
    const after = allocator.words(most)
    const pattern = allocator.words(36)
    var state: u64 = 0x5DEECE66D
    var round: u32 = 0
    while round < 150 {
        const width = between(&state, 1, 100)
        const height = between(&state, 1, 100)
        const area = geom.rect(between(&state, -150, 150), between(&state, -150, 150), width, height)
        const region = mask.create(allocator, random(&state, 6) == 0).?
        device.moveTo(region, between(&state, -100, 100), between(&state, -100, 100))
        var parts = random(&state, 6)
        while parts > 0 {
            _ = device.fill(region, geom.rect(area.x + between(&state, -20, width), area.y + between(&state, -20, height), between(&state, 1, 60), between(&state, 1, 60)), pixel.gray(levels[@intCast(usize, random(&state, 6))]))
            parts -= 1
        }
        var dots = random(&state, 80)
        while dots > 0 {
            mask.set(region, area.x + between(&state, -5, width + 5), area.y + between(&state, -5, height + 5), random(&state, 256))
            dots -= 1
        }
        var selection: ?*device.Device = null
        if random(&state, 3) != 0 {
            const chosen = mask.create(allocator, random(&state, 4) == 0).?
            device.moveTo(chosen, between(&state, -100, 100), between(&state, -100, 100))
            parts = random(&state, 4) + 1
            while parts > 0 {
                _ = device.fill(chosen, geom.rect(area.x + between(&state, -20, width), area.y + between(&state, -20, height), between(&state, 1, 80), between(&state, 1, 80)), pixel.gray(levels[@intCast(usize, random(&state, 6))]))
                parts -= 1
            }
            selection = chosen
        }
        const target = device.create(allocator, if random(&state, 4) == 0 { 0x80123456 } else { 0 }).?
        device.moveTo(target, between(&state, -100, 100), between(&state, -100, 100))
        scatter(&state, target, area, &colors, 8)
        // Bounds around the area, cutting it or wider; sometimes
        // everything there is (when the region or the selection is
        // nothing around its tiles: one that is everything everywhere is
        // painted everywhere).
        var bounds = geom.rect(area.x + between(&state, -10, 10), area.y + between(&state, -10, 10), between(&state, 0, width + 10), between(&state, 0, height + 10))
        const bounded = !mask.reachesEverywhere(region) || (selection != null && !mask.reachesEverywhere(selection.?))
        if bounded && random(&state, 8) == 0 { bounds = geom.rect(-1000000, -1000000, 2000000, 2000000) }
        // (all the region and the selection can be more than nothing in)
        const view = geom.grown(area, 82)
        const stride = @intCast(usize, view.width)
        device.readRect(target, view, before, stride)
        const mode = modes[@intCast(usize, random(&state, 12))]
        const flags = flagsets[@intCast(usize, random(&state, 5))]
        const opacity = if random(&state, 6) == 0 { 0 } else { random(&state, 300) }
        const color = colors[@intCast(usize, random(&state, 8))]
        const patterned = random(&state, 2) == 0
        const pw = between(&state, 1, 6)
        const ph = between(&state, 1, 6)
        var place: usize = 0
        while place < 36 {
            pattern[place] = colors[@intCast(usize, random(&state, 8))] ^ (random(&state, 256) << 8)
            place += 1
        }
        const ox = if random(&state, 4) == 0 { between(&state, -2147483647, 2147483647) } else { between(&state, -100, 100) }
        const oy = if random(&state, 4) == 0 { between(&state, -2147483647, 2147483647) } else { between(&state, -100, 100) }
        var result = geom.empty()
        if patterned {
            result = fill.paintPattern(target, region, bounds, pattern, pw, ph, ox, oy, mode, opacity, flags, selection)
        } else {
            result = fill.paint(target, region, bounds, color, mode, opacity, flags, selection)
        }
        device.readRect(target, view, after, stride)
        var x0: i32 = 2147483647
        var y0: i32 = 2147483647
        var x1: i32 = -2147483647
        var y1: i32 = -2147483647
        var y = view.y
        while y < view.y + view.height {
            var x = view.x
            while x < view.x + view.width {
                const at = @intCast(usize, y - view.y) * stride + @intCast(usize, x - view.x)
                var expected = before[at]
                if geom.contains(bounds, x, y) && opacity != 0 {
                    var amount = mask.at(region, x, y)
                    if selection != null { amount = pixel.mul(amount, mask.at(selection.?, x, y)) }
                    if amount != 0 {
                        if x < x0 { x0 = x }
                        if x > x1 { x1 = x }
                        if y < y0 { y0 = y }
                        if y > y1 { y1 = y }
                    }
                    const source = if patterned { patternAt(pattern, pw, ph, ox, oy, x, y) } else { color }
                    expected = blend.blendPixelAt(mode, before[at], source, pixel.mul(if opacity > 255 { 255 } else { opacity }, amount), flags, blend.seedAt(x, y))
                }
                if after[at] != expected { return 193 }
                x += 1
            }
            y += 1
        }
        if x1 < x0 {
            if !geom.isEmpty(result) { return 194 }
        } else if !is(result, x0, y0, x1 - x0 + 1, y1 - y0 + 1) {
            return 195
        }
        device.destroy(target)
        if selection != null { device.destroy(selection.?) }
        device.destroy(region)
        round += 1
    }
    unsafe {
        allocator.free(@ptrCast([*]u8, pattern), 36 * 4 + 4, 16)
        allocator.free(@ptrCast([*]u8, after), most * 4 + 4, 16)
        allocator.free(@ptrCast([*]u8, before), most * 4 + 4, 16)
    }
    return 0
}

// Many fills take nothing of the value arena.
fn lasting(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 100, 80)
    const layer = device.create(allocator, 0).?
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    _ = device.fill(layer, geom.rect(60, 30, 20, 20), RED)
    const lasso = mask.create(allocator, false).?
    _ = device.fill(lasso, geom.rect(5, 5, 50, 50), mask.ALL)
    const canvas = device.create(allocator, 0).?
    const pattern = [4]u32{ RED, GREEN, BLUE, WHITE }
    var options = fill.defaults()
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: i32 = 0
    while round < 200 {
        options.grow = (round & 3) - 1
        options.feather = if round & 4 == 0 { 0.0 } else { 1.5 }
        options.diagonal = round & 8 != 0
        const inside = fill.region(layer, 20, 20, area, &options, found)
        if geom.isEmpty(inside) { return 200 }
        _ = fill.paint(canvas, found, inside, GREEN, blend.NORMAL, 200, 0, lasso)
        if geom.isEmpty(fill.similar(layer, RED, area, &options, found)) { return 201 }
        _ = fill.paintPattern(canvas, found, area, &pattern, 2, 2, round, -round, blend.NORMAL, 255, 0, null)
        if geom.isEmpty(fill.enclosed(layer, lasso, area, &options, found, fill.ALL_REGIONS)) { return 202 }
        round += 1
    }
    const grown = turns.used(arena) - before
    if grown > 1024 { return 203 }
    device.destroy(canvas)
    device.destroy(lasso)
    device.destroy(layer)
    return 0
}

// 3000 more of every kind, every way: the boundary colour, not
// contiguous, each method inside a shape, the three means, a mask and a
// layer moved, paints with a selection, a pattern and bounds of
// everything, no search found. The value arena grows by nothing.
fn lastingLonger(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(-37, -20, 130, 90)
    const layer = device.create(allocator, 0).?
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    _ = device.fill(layer, geom.rect(60, 30, 20, 20), RED)
    _ = device.fill(layer, geom.rect(-30, -15, 8, 8), 0x80FF0000)
    const lasso = mask.create(allocator, false).?
    _ = device.fill(lasso, geom.rect(-10, 5, 70, 50), mask.ALL)
    const canvas = device.create(allocator, 0).?
    const pattern = [6]u32{ RED, GREEN, BLUE, WHITE, BLACK, 0x80808080 }
    var options = fill.defaults()
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: i32 = 0
    while round < 3000 {
        options.threshold = @intCast(u32, round & 31)
        options.softness = @intCast(u32, (round * 7) % 101)
        options.grow = (round % 7) - 3
        options.feather = if round % 5 == 0 { 0.0 } else if round % 5 == 1 { 2.5 } else if round % 5 == 2 { 33.0 } else { 0.0 }
        options.diagonal = round & 8 != 0
        options.contiguous = round % 3 != 0
        options.reference = if round % 4 == 0 { fill.REFERENCE_BOUNDARY } else { fill.REFERENCE_SEED }
        options.stopAtImageEdge = round & 16 != 0
        device.moveTo(found, round % 70, -(round % 50))
        device.moveTo(layer, -(round % 3), round % 2)
        const inside = fill.region(layer, 20 + round % 9, 20, area, &options, found)
        _ = fill.paint(canvas, found, inside, GREEN, @intCast(u16, round % 60), 200, @intCast(u32, round & 1), lasso)
        _ = fill.similar(layer, RED, area, &options, found)
        _ = fill.paintPattern(canvas, found, geom.rect(-1000000, -1000000, 2000000, 2000000), &pattern, 3, 2, round, -round, blend.NORMAL, 255, 0, null)
        _ = fill.enclosed(layer, lasso, area, &options, found, @intCast(u8, round & 3))
        _ = fill.region(layer, 500, 500, area, &options, found)
        round += 1
    }
    const grown = turns.used(arena) - before
    if grown > 1024 { return 209 }
    device.moveTo(found, 0, 0)
    device.clear(found)
    device.destroy(canvas)
    device.destroy(lasso)
    device.destroy(layer)
    return 0
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const made = mask.create(allocator, false)
    if made == null { return 255 }
    const found = made.?
    var failed = outlines(found)
    if failed != 0 { return failed }
    failed = colours(found)
    if failed != 0 { return failed }
    failed = sizes(found)
    if failed != 0 { return failed }
    failed = modes(found)
    if failed != 0 { return failed }
    failed = afterwards(found)
    if failed != 0 { return failed }
    failed = shapes(found)
    if failed != 0 { return failed }
    failed = painting(found)
    if failed != 0 { return failed }
    failed = places(found)
    if failed != 0 { return failed }
    failed = against(found)
    if failed != 0 { return failed }
    failed = lasting(found)
    if failed != 0 { return failed }
    failed = extremes(found)
    if failed != 0 { return failed }
    failed = changes(found)
    if failed != 0 { return failed }
    failed = giving(found)
    if failed != 0 { return failed }
    failed = enclosedAgainst(found)
    if failed != 0 { return failed }
    failed = largerAgainst(found)
    if failed != 0 { return failed }
    failed = featherAgainst(found)
    if failed != 0 { return failed }
    failed = paintAgainst()
    if failed != 0 { return failed }
    failed = lastingLonger(found)
    if failed != 0 { return failed }
    device.destroy(found)
    return 13
}
