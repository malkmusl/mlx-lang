// nebula's bucket (core/fill.mlx): the region of a place found by colour.
// A closed outline holds a fill in and out, a gap of one pixel across a
// corner leaks only with diagonal neighbours; the threshold on a gradient
// (colour and alpha) counts exactly, softness gives the amounts it says,
// what is transparent has no colour; a place outside the area, an area
// of one pixel and of none; 4096 x 4096 of nothing in well under a second
// (the time is printed), tiles of one colour, a spiral maze and a comb
// that makes the list of rows grow; the boundary colour, every similar
// pixel wherever it is; grown, shrunk and feathered, at the image's edge
// both ways; the regions inside a drawn shape by each method; painting
// with an opacity, a selection, a pattern and its offset, erasing, undone;
// negative coordinates, a moved layer and a moved mask; and 200 fills
// take nothing of the value arena. Exits 13.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")
const fill = @import("../core/fill.mlx")

const BLACK: u32 = 0xFF000000
const RED: u32 = 0xFFFF0000
const GREEN: u32 = 0xFF00FF00
const BLUE: u32 = 0xFF0000FF
const WHITE: u32 = 0xFFFFFFFF

fn is(area: geom.Rect, x: i32, y: i32, width: i32, height: i32) -> bool {
    return area.x == x && area.y == y && area.width == width && area.height == height
}

// A line of one pixel around `area`.
fn outline(layer: *device.Device, area: geom.Rect, color: u32) -> void {
    _ = device.fill(layer, geom.rect(area.x, area.y, area.width, 1), color)
    _ = device.fill(layer, geom.rect(area.x, area.y + area.height - 1, area.width, 1), color)
    _ = device.fill(layer, geom.rect(area.x, area.y, 1, area.height), color)
    _ = device.fill(layer, geom.rect(area.x + area.width - 1, area.y, 1, area.height), color)
}

// How many pixels of `area` the mask holds more than nothing of (`total`:
// what their amounts add up to).
fn measure(found: *device.Device, area: geom.Rect, total: bool) -> u64 {
    const allocator = std.heap.allocator()
    const width = @intCast(usize, area.width)
    const line = allocator.alloc(width, 16).?
    var result: u64 = 0
    var y = area.y
    while y < area.y + area.height {
        mask.readBytes(found, geom.rect(area.x, y, area.width, 1), line, width)
        var index: usize = 0
        while index < width {
            if total {
                result += @intCast(u64, line[index])
            } else if line[index] != 0 {
                result += 1
            }
            index += 1
        }
        y += 1
    }
    allocator.free(line, width, 16)
    return result
}

// A closed outline, a gap across its corner, places and areas at the edge
// of what makes sense.
fn outlines(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const layer = device.create(allocator, 0).?
    const area = geom.rect(0, 0, 100, 80)
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    var options = fill.defaults()
    if options.threshold != 20 || options.softness != 100 || !options.contiguous || options.diagonal { return 1 }
    if options.reference != fill.REFERENCE_SEED || options.grow != 0 || options.feather != 0.0 || options.stopAtImageEdge { return 2 }
    options.threshold = 0

    // Inside stays inside.
    const inside = fill.region(layer, 20, 20, area, &options, found)
    if !is(inside, 11, 11, 28, 28) || measure(found, area, false) != 784 { return 3 }
    if mask.at(found, 11, 11) != 255 || mask.at(found, 10, 11) != 0 || mask.at(found, 38, 38) != 255 || mask.at(found, 39, 38) != 0 { return 4 }
    // Outside covers the rest and not the inside, nor the line.
    const outside = fill.region(layer, 0, 0, area, &options, found)
    if !is(outside, 0, 0, 100, 80) || measure(found, area, false) != 7100 { return 5 }
    if mask.at(found, 20, 20) != 0 || mask.at(found, 10, 10) != 0 || mask.at(found, 99, 79) != 255 || mask.at(found, 100, 79) != 0 { return 6 }
    // The line itself is a region too.
    const line = fill.region(layer, 39, 25, area, &options, found)
    if !is(line, 10, 10, 30, 30) || measure(found, area, false) != 116 || mask.at(found, 10, 10) != 255 || mask.at(found, 11, 11) != 0 { return 7 }

    // The corner taken out: its two sides touch only across it. Straight
    // neighbours hold, diagonal ones leak.
    device.setPixel(layer, 10, 10, 0)
    _ = fill.region(layer, 20, 20, area, &options, found)
    if measure(found, area, false) != 784 || mask.at(found, 10, 10) != 0 { return 8 }
    _ = fill.region(layer, 0, 0, area, &options, found)
    if measure(found, area, false) != 7101 || mask.at(found, 10, 10) != 255 || mask.at(found, 11, 11) != 0 { return 9 }
    options.diagonal = true
    const leaked = fill.region(layer, 20, 20, area, &options, found)
    if !is(leaked, 0, 0, 100, 80) || measure(found, area, false) != 7885 || mask.at(found, 0, 0) != 255 || mask.at(found, 11, 10) != 0 { return 10 }
    options.diagonal = false
    device.setPixel(layer, 10, 10, BLACK)

    // A place outside the area: nothing, and the mask is nothing.
    if !geom.isEmpty(fill.region(layer, 200, 200, area, &options, found)) || measure(found, area, false) != 0 { return 11 }
    _ = fill.region(layer, 0, 0, area, &options, found)
    if !geom.isEmpty(fill.region(layer, -1, 5, area, &options, found)) || measure(found, area, false) != 0 { return 12 }
    // An area of one pixel, and none.
    const dot = fill.region(layer, 5, 5, geom.rect(5, 5, 1, 1), &options, found)
    if !is(dot, 5, 5, 1, 1) || mask.at(found, 5, 5) != 255 || mask.at(found, 6, 5) != 0 || mask.at(found, 5, 6) != 0 { return 14 }
    if !geom.isEmpty(fill.region(layer, 0, 0, geom.empty(), &options, found)) { return 15 }
    // The area is where the search stops: the mask beyond it is not written.
    device.clear(found)
    const part = fill.region(layer, 0, 0, geom.rect(0, 0, 70, 5), &options, found)
    if !is(part, 0, 0, 70, 5) || mask.at(found, 69, 4) != 255 || mask.at(found, 70, 4) != 0 || mask.at(found, 69, 5) != 0 { return 16 }
    device.destroy(layer)
    return 0
}

// The threshold, the softness, what counts as a colour.
fn colours(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 256, 4)
    // Greys from 0 to 255, a column each, across four tiles.
    const ramp = device.create(allocator, 0).?
    var x: i32 = 0
    while x < 256 {
        const level = @intCast(u32, x)
        _ = device.fill(ramp, geom.rect(x, 0, 1, 4), pixel.rgb(level, level, level))
        x += 1
    }
    var options = fill.defaults()
    options.threshold = 0
    if !is(fill.region(ramp, 100, 1, area, &options, found), 100, 0, 1, 4) || measure(found, area, false) != 4 { return 20 }
    options.threshold = 10
    if !is(fill.region(ramp, 100, 1, area, &options, found), 90, 0, 21, 4) || measure(found, area, false) != 84 { return 21 }
    if mask.at(found, 90, 0) != 255 || mask.at(found, 110, 3) != 255 || mask.at(found, 89, 0) != 0 || mask.at(found, 111, 3) != 0 { return 22 }
    options.threshold = 255
    if !is(fill.region(ramp, 100, 1, area, &options, found), 0, 0, 256, 4) || measure(found, area, false) != 1024 { return 23 }
    options.threshold = 1000
    if measure(found, fill.region(ramp, 100, 1, area, &options, found), false) != 1024 { return 24 }

    // Softness 0: whole only at no difference, then evenly down to
    // nothing just past the threshold.
    options.threshold = 10
    options.softness = 0
    if !is(fill.region(ramp, 100, 1, area, &options, found), 90, 0, 21, 4) || measure(found, area, false) != 84 { return 25 }
    if mask.at(found, 100, 1) != 255 || mask.at(found, 101, 1) != 232 || mask.at(found, 99, 2) != 232 || mask.at(found, 105, 0) != 139 { return 26 }
    if mask.at(found, 110, 1) != 23 || mask.at(found, 90, 3) != 23 || mask.at(found, 111, 1) != 0 || mask.at(found, 89, 1) != 0 { return 27 }
    // Softness 50: whole up to half the threshold.
    options.softness = 50
    _ = fill.region(ramp, 100, 1, area, &options, found)
    if mask.at(found, 105, 1) != 255 || mask.at(found, 95, 1) != 255 || mask.at(found, 106, 1) != 213 || mask.at(found, 110, 1) != 43 || mask.at(found, 111, 1) != 0 { return 28 }
    options.softness = 100
    _ = fill.region(ramp, 100, 1, area, &options, found)
    if mask.at(found, 110, 1) != 255 || mask.at(found, 111, 1) != 0 { return 29 }
    options.softness = 300
    _ = fill.region(ramp, 100, 1, area, &options, found)
    if mask.at(found, 110, 1) != 255 || mask.at(found, 111, 1) != 0 { return 30 }

    // Grown by one, the amounts spread as amounts: each the largest next
    // to it; shrunk, the smallest (at the area's edge only when the edge
    // is one of the region's).
    options.softness = 0
    options.grow = 1
    if !is(fill.region(ramp, 100, 1, area, &options, found), 89, 0, 23, 4) { return 31 }
    if mask.at(found, 105, 1) != 162 || mask.at(found, 111, 1) != 23 || mask.at(found, 112, 1) != 0 || mask.at(found, 100, 0) != 255 { return 32 }
    options.grow = -1
    if !is(fill.region(ramp, 100, 1, area, &options, found), 91, 0, 19, 4) { return 33 }
    if mask.at(found, 105, 1) != 116 || mask.at(found, 110, 1) != 0 || mask.at(found, 100, 1) != 232 || mask.at(found, 100, 0) != 232 { return 34 }
    options.stopAtImageEdge = true
    if !is(fill.region(ramp, 100, 1, area, &options, found), 91, 1, 19, 2) || mask.at(found, 100, 0) != 0 || mask.at(found, 100, 1) != 232 { return 35 }
    options = fill.defaults()

    // How far colours are apart.
    if fill.difference(0xFF102030, 0xFF132030) != 3 || fill.difference(0xFF102030, 0xFF102530) != 5 || fill.difference(0xFF102030, 0xFF102039) != 9 { return 36 }
    if fill.difference(0xFF000000, 0x80000000) != 127 || fill.difference(0x00FF0000, 0x0000FF00) != 0 || fill.difference(0x00FF0000, 0x40FF0000) != 64 { return 37 }
    if fill.difference(0x40FFFFFF, 0x00000000) != 64 || fill.difference(WHITE, BLACK) != 255 || fill.difference(RED, RED) != 0 { return 38 }

    // What is transparent is one region whatever colour hides in it.
    const hidden = device.create(allocator, 0).?
    const small = geom.rect(0, 0, 20, 20)
    _ = device.fill(hidden, small, 0x00FF0000)
    _ = device.fill(hidden, geom.rect(5, 5, 10, 10), 0x0000FF00)
    _ = device.fill(hidden, geom.rect(8, 8, 2, 2), 0x01FFFFFF)
    options.threshold = 0
    if !is(fill.region(hidden, 0, 0, small, &options, found), 0, 0, 20, 20) || measure(found, small, false) != 396 || mask.at(found, 8, 8) != 0 { return 39 }
    options.threshold = 1
    if measure(found, fill.region(hidden, 6, 6, small, &options, found), false) != 400 { return 40 }

    // Alpha is a channel: a ramp of it, from nothing.
    const fading = device.create(allocator, 0).?
    x = 1
    while x < 256 {
        _ = device.fill(fading, geom.rect(x, 0, 1, 4), pixel.pack(@intCast(u32, x), 255, 0, 0))
        x += 1
    }
    options.threshold = 10
    if !is(fill.region(fading, 100, 2, area, &options, found), 90, 0, 21, 4) { return 41 }
    if !is(fill.region(fading, 0, 2, area, &options, found), 0, 0, 11, 4) || measure(found, area, false) != 44 { return 42 }
    device.destroy(ramp)
    device.destroy(hidden)
    device.destroy(fading)
    return 0
}

// Large and winding regions.
fn sizes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    var options = fill.defaults()
    options.threshold = 0

    // 4096 x 4096 of nothing: no tile is looked into.
    const nothing = device.create(allocator, 0).?
    const large = geom.rect(0, 0, 4096, 4096)
    var started = std.time.milliseconds()
    const all = fill.region(nothing, 2000, 2000, large, &options, found)
    var took = std.time.milliseconds() - started
    _ = std.io.print("fill of 4096 x 4096, no tiles: ")
    _ = std.io.writeUnsigned(std.io.stdout(), took)
    _ = std.io.println(" ms")
    if !is(all, 0, 0, 4096, 4096) || device.tileCount(found) != 4096 || device.tileCount(nothing) != 0 { return 50 }
    if took >= 1000 { return 51 }
    if measure(found, large, false) != 16777216 || mask.at(found, 4095, 4095) != 255 || mask.at(found, 4096, 4095) != 0 { return 52 }
    started = std.time.milliseconds()
    const everywhere = fill.similar(nothing, 0x00123456, large, &options, found)
    took = std.time.milliseconds() - started
    _ = std.io.print("similar over 4096 x 4096, no tiles: ")
    _ = std.io.writeUnsigned(std.io.stdout(), took)
    _ = std.io.println(" ms")
    if !is(everywhere, 0, 0, 4096, 4096) || took >= 1000 || measure(found, large, true) != 4278190080 { return 53 }
    device.clear(found)
    device.destroy(nothing)

    // Tiles that are there: of one colour in the middle, of two at the rim.
    const flat = device.create(allocator, 0).?
    _ = device.fill(flat, geom.rect(0, 0, 300, 200), RED)
    const around = geom.rect(-10, -10, 320, 220)
    if !is(fill.region(flat, 150, 100, around, &options, found), 0, 0, 300, 200) || measure(found, around, false) != 60000 { return 54 }
    if !is(fill.region(flat, -5, -5, around, &options, found), -10, -10, 320, 220) || measure(found, around, false) != 10400 || mask.at(found, 150, 100) != 0 { return 55 }
    // One pixel in a tile of one colour splits nothing off but itself.
    device.setPixel(flat, 100, 100, BLUE)
    if measure(found, fill.region(flat, 150, 100, around, &options, found), false) != 59999 || mask.at(found, 100, 100) != 0 { return 56 }
    device.destroy(flat)

    // A spiral: 64 square walls inside each other, 3 pixels between them,
    // each open at one end only, so that the way in winds through all.
    const maze = device.create(allocator, 0).?
    const square = geom.rect(0, 0, 512, 512)
    var ring: i32 = 0
    while ring < 64 {
        const inset = ring * 4
        outline(maze, geom.rect(inset, inset, 512 - 2 * inset, 512 - 2 * inset), BLACK)
        if ring > 0 {
            if ring & 1 == 0 {
                _ = device.fill(maze, geom.rect(inset + 1, inset, 2, 1), 0)
            } else {
                _ = device.fill(maze, geom.rect(509 - inset, 511 - inset, 2, 1), 0)
            }
        }
        ring += 1
    }
    var open: u64 = 0
    var y: i32 = 0
    while y < 512 {
        var x: i32 = 0
        while x < 512 {
            if device.pixel(maze, x, y) == 0 { open += 1 }
            x += 1
        }
        y += 1
    }
    if open < 190000 || open > 200000 { return 57 }
    started = std.time.milliseconds()
    const wound = fill.region(maze, 1, 1, square, &options, found)
    took = std.time.milliseconds() - started
    _ = std.io.print("fill of a spiral, 512 x 512: ")
    _ = std.io.writeUnsigned(std.io.stdout(), took)
    _ = std.io.println(" ms")
    if !is(wound, 1, 1, 510, 510) || measure(found, square, false) != open || mask.at(found, 255, 255) != 255 || mask.at(found, 0, 0) != 0 { return 58 }
    // From the middle the same way back out.
    if measure(found, fill.region(maze, 255, 255, square, &options, found), false) != open { return 59 }
    // A wall is a region too: the outermost, around everything.
    if !is(fill.region(maze, 0, 0, square, &options, found), 0, 0, 512, 512) || measure(found, square, false) != 2044 { return 60 }
    options.reference = fill.REFERENCE_BOUNDARY
    options.boundary = BLACK
    if measure(found, fill.region(maze, 1, 1, square, &options, found), false) != open { return 61 }
    options.reference = fill.REFERENCE_SEED
    device.destroy(maze)

    // A comb of 5000 teeth: each is a row to come back to, more than the
    // list starts with room for.
    const comb = device.create(allocator, 0).?
    const strip = geom.rect(0, 0, 10000, 3)
    _ = device.fill(comb, geom.rect(0, 1, 10000, 2), BLACK)
    var tooth: i32 = 0
    while tooth < 10000 {
        _ = device.fill(comb, geom.rect(tooth, 1, 1, 2), 0)
        tooth += 2
    }
    if !is(fill.region(comb, 0, 0, strip, &options, found), 0, 0, 10000, 3) || measure(found, strip, false) != 20000 { return 62 }
    if mask.at(found, 9998, 2) != 255 || mask.at(found, 9999, 2) != 0 || mask.at(found, 9999, 0) != 255 { return 63 }
    device.clear(found)
    device.destroy(comb)
    return 0
}

// The boundary colour, and every similar pixel wherever it is.
fn modes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const layer = device.create(allocator, 0).?
    const area = geom.rect(0, 0, 100, 80)
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    _ = device.fill(layer, geom.rect(15, 15, 5, 5), RED)
    _ = device.fill(layer, geom.rect(25, 25, 5, 5), GREEN)
    _ = device.fill(layer, geom.rect(60, 60, 4, 4), RED)
    var options = fill.defaults()
    options.threshold = 0

    // By the colour clicked the blocks inside the outline stay out; up to
    // the black line they are in.
    if measure(found, fill.region(layer, 12, 12, area, &options, found), false) != 734 { return 70 }
    options.reference = fill.REFERENCE_BOUNDARY
    options.boundary = BLACK
    if !is(fill.region(layer, 12, 12, area, &options, found), 11, 11, 28, 28) || measure(found, area, false) != 784 { return 71 }
    if mask.at(found, 16, 16) != 255 || mask.at(found, 26, 26) != 255 || mask.at(found, 10, 12) != 0 { return 72 }
    if !geom.isEmpty(fill.region(layer, 10, 20, area, &options, found)) || measure(found, area, false) != 0 { return 73 }
    if !is(fill.region(layer, 0, 0, area, &options, found), 0, 0, 100, 80) || measure(found, area, false) != 7100 || mask.at(found, 61, 61) != 255 { return 74 }
    // A pixel between the line's colour and not: in by what it is not.
    device.setPixel(layer, 30, 30, 0xFF404040)
    options.threshold = 100
    options.softness = 0
    if measure(found, fill.region(layer, 12, 12, area, &options, found), false) != 784 || mask.at(found, 30, 30) != 162 || mask.at(found, 31, 30) != 255 { return 75 }
    device.setPixel(layer, 30, 30, 0)
    // Not contiguous: all that is not the line.
    options = fill.defaults()
    options.threshold = 0
    options.reference = fill.REFERENCE_BOUNDARY
    options.boundary = BLACK
    options.contiguous = false
    if !is(fill.region(layer, 0, 0, area, &options, found), 0, 0, 100, 80) || measure(found, area, false) != 7884 { return 76 }

    // Similar colours wherever they are.
    options = fill.defaults()
    options.threshold = 0
    if !is(fill.similar(layer, RED, area, &options, found), 15, 15, 49, 49) || measure(found, area, false) != 41 { return 77 }
    if mask.at(found, 15, 15) != 255 || mask.at(found, 63, 63) != 255 || mask.at(found, 20, 15) != 0 || mask.at(found, 40, 40) != 0 { return 78 }
    options.contiguous = false
    if !is(fill.region(layer, 62, 62, area, &options, found), 15, 15, 49, 49) || measure(found, area, false) != 41 { return 79 }
    options.contiguous = true
    if !is(fill.region(layer, 62, 62, area, &options, found), 60, 60, 4, 4) || measure(found, area, false) != 16 { return 80 }
    if !geom.isEmpty(fill.similar(layer, BLUE, area, &options, found)) || measure(found, area, false) != 0 { return 81 }
    options.threshold = 255
    if measure(found, fill.similar(layer, RED, area, &options, found), false) != 8000 { return 82 }
    // Red against green and black is 255 away, against nothing too.
    options.threshold = 254
    if measure(found, fill.similar(layer, RED, area, &options, found), false) != 41 { return 83 }
    device.destroy(layer)
    return 0
}

// Grown, shrunk, feathered.
fn afterwards(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const block = device.create(allocator, 0).?
    const area = geom.rect(0, 0, 100, 80)
    const own = geom.rect(30, 20, 40, 30)
    _ = device.fill(block, own, RED)
    var options = fill.defaults()
    options.threshold = 0
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 90 }

    // Grown by 3, round: 3 more on every side, the corners a quarter of
    // a disc (4 pixels each).
    options.grow = 3
    if !is(fill.region(block, 40, 30, area, &options, found), 27, 17, 46, 36) || measure(found, area, false) != 1636 { return 91 }
    if mask.at(found, 27, 17) != 0 || mask.at(found, 28, 18) != 255 || mask.at(found, 27, 20) != 255 || mask.at(found, 26, 20) != 0 || mask.at(found, 29, 17) != 0 || mask.at(found, 30, 17) != 255 { return 92 }
    options.grow = 1
    if !is(fill.region(block, 40, 30, area, &options, found), 29, 19, 42, 32) || measure(found, area, false) != 1340 || mask.at(found, 29, 19) != 0 { return 93 }
    // Shrunk by 3.
    options.grow = -3
    if !is(fill.region(block, 40, 30, area, &options, found), 33, 23, 34, 24) || measure(found, area, false) != 816 { return 94 }
    if mask.at(found, 33, 23) != 255 || mask.at(found, 32, 23) != 0 || mask.at(found, 66, 46) != 255 || mask.at(found, 67, 46) != 0 { return 95 }
    // Shrunk away altogether.
    options.grow = -15
    if !geom.isEmpty(fill.region(block, 40, 30, area, &options, found)) || measure(found, area, false) != 0 { return 96 }
    options.grow = -14
    if !is(fill.region(block, 40, 30, area, &options, found), 44, 34, 12, 2) { return 97 }

    // The region is all of the area: it goes on past the edge, or the
    // edge is its own. Nothing is written past the area either way.
    device.clear(found)
    options.grow = -3
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 98 }
    options.stopAtImageEdge = true
    if !is(fill.region(block, 40, 30, own, &options, found), 33, 23, 34, 24) || measure(found, area, false) != 816 { return 99 }
    options.grow = 3
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 100 }
    options.stopAtImageEdge = false
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 { return 101 }

    // Feathered by 4: the edge spread over 4 pixels to either side, the
    // amounts as many as before altogether, half at the edge.
    options.grow = 0
    options.feather = 4.0
    if !is(fill.region(block, 40, 30, area, &options, found), 26, 16, 48, 38) || measure(found, area, false) != 1820 || measure(found, area, true) != 306000 { return 102 }
    if mask.at(found, 25, 35) != 0 || mask.at(found, 26, 35) != 7 || mask.at(found, 27, 35) != 24 || mask.at(found, 28, 35) != 56 || mask.at(found, 29, 35) != 101 { return 103 }
    if mask.at(found, 30, 35) != 154 || mask.at(found, 31, 35) != 199 || mask.at(found, 32, 35) != 231 || mask.at(found, 33, 35) != 248 || mask.at(found, 34, 35) != 255 { return 104 }
    if mask.at(found, 50, 16) != 7 || mask.at(found, 73, 35) != 7 || mask.at(found, 50, 53) != 7 || mask.at(found, 26, 16) != 0 || mask.at(found, 27, 17) != 2 || mask.at(found, 30, 20) != 93 { return 105 }
    // At the image's edge: none of it when the region goes on, the same
    // fading when the edge is the region's.
    device.clear(found)
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 || measure(found, area, true) != 306000 { return 106 }
    options.stopAtImageEdge = true
    if !is(fill.region(block, 40, 30, own, &options, found), 30, 20, 40, 30) || measure(found, area, false) != 1200 || measure(found, area, true) != 280240 { return 107 }
    if mask.at(found, 30, 20) != 93 || mask.at(found, 30, 35) != 154 || mask.at(found, 50, 35) != 255 || mask.at(found, 29, 35) != 0 { return 108 }
    options.stopAtImageEdge = false
    // Grown, then feathered.
    options.grow = 2
    options.feather = 2.0
    if !is(fill.region(block, 40, 30, area, &options, found), 26, 16, 48, 38) || measure(found, area, false) != 1812 || measure(found, area, true) != 378424 { return 109 }
    // A feather that is no number or less than nothing is none; a tiny
    // one changes nothing.
    options.grow = 0
    options.feather = -3.0
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, true) != 306000 { return 110 }
    options.feather = math.nan()
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, true) != 306000 { return 113 }
    options.feather = 0.01
    if !is(fill.region(block, 40, 30, area, &options, found), 30, 20, 40, 30) || measure(found, area, true) != 306000 { return 111 }
    // Similar pixels are grown as one mask.
    options.feather = 0.0
    options.grow = 1
    _ = device.fill(block, geom.rect(80, 60, 2, 2), RED)
    if !is(fill.similar(block, RED, area, &options, found), 29, 19, 54, 44) || measure(found, area, false) != 1340 + 12 { return 112 }
    device.destroy(block)
    return 0
}

// The regions inside a drawn shape.
fn shapes(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 100, 80)
    // A sea of nothing; a green island with a lake of nothing in it; a
    // red island further out.
    const scene = device.create(allocator, 0).?
    _ = device.fill(scene, geom.rect(40, 40, 10, 10), GREEN)
    _ = device.fill(scene, geom.rect(43, 43, 4, 4), 0)
    _ = device.fill(scene, geom.rect(70, 40, 20, 10), RED)
    // The shape: around the green island, across the red one.
    const lasso = mask.create(allocator, false).?
    _ = device.fill(lasso, geom.rect(30, 30, 50, 30), mask.ALL)
    var options = fill.defaults()
    options.threshold = 0

    // The island and its lake; not the sea, which goes on past the shape,
    // nor the island the shape cuts.
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), 40, 40, 10, 10) || measure(found, area, false) != 100 { return 120 }
    if mask.at(found, 35, 35) != 0 || mask.at(found, 72, 42) != 0 || mask.at(found, 44, 44) != 255 || mask.at(found, 40, 40) != 255 { return 121 }
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.TRANSPARENT_REGIONS), 43, 43, 4, 4) || measure(found, area, false) != 16 { return 122 }
    options.boundary = GREEN
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_OF_COLOR), 40, 40, 10, 10) || measure(found, area, false) != 84 || mask.at(found, 44, 44) != 0 { return 123 }
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_SURROUNDED_BY), 43, 43, 4, 4) || measure(found, area, false) != 16 { return 124 }
    options.boundary = RED
    if !geom.isEmpty(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_OF_COLOR)) || measure(found, area, false) != 0 { return 125 }
    // Nothing is closed off by red here: all that is not red reaches out.
    if !geom.isEmpty(fill.enclosed(scene, lasso, area, &options, found, fill.REGIONS_SURROUNDED_BY)) { return 126 }
    // Grown afterwards.
    options.grow = 1
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), 39, 39, 12, 12) || measure(found, area, false) != 140 { return 127 }
    options.grow = 0

    // The shape around both islands.
    _ = device.fill(lasso, geom.rect(30, 30, 65, 30), mask.ALL)
    if !is(fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), 40, 40, 50, 10) || measure(found, area, false) != 300 { return 128 }
    // Less than half of the shape is not the shape: a column of the red
    // island at 100 of 255 puts it out again, at 128 not.
    _ = device.fill(lasso, geom.rect(89, 30, 1, 30), pixel.gray(100))
    if measure(found, fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), false) != 100 { return 129 }
    _ = device.fill(lasso, geom.rect(89, 30, 1, 30), pixel.gray(128))
    if measure(found, fill.enclosed(scene, lasso, area, &options, found, fill.ALL_REGIONS), false) != 300 { return 130 }
    // The lake reached across a corner of the island: with diagonal
    // neighbours it is the sea's.
    device.setPixel(scene, 40, 40, 0)
    device.setPixel(scene, 41, 41, 0)
    device.setPixel(scene, 42, 42, 0)
    if measure(found, fill.enclosed(scene, lasso, area, &options, found, fill.TRANSPARENT_REGIONS), false) != 18 { return 131 }
    options.diagonal = true
    if !geom.isEmpty(fill.enclosed(scene, lasso, area, &options, found, fill.TRANSPARENT_REGIONS)) { return 132 }
    options.diagonal = false

    // A shape that is everything: every region is inside (the area's edge
    // is not the shape's). A shape that is nothing: none.
    const everything = mask.create(allocator, true).?
    if !is(fill.enclosed(scene, everything, area, &options, found, fill.ALL_REGIONS), 0, 0, 100, 80) || measure(found, area, false) != 8000 { return 133 }
    const none = mask.create(allocator, false).?
    if !geom.isEmpty(fill.enclosed(scene, none, area, &options, found, fill.ALL_REGIONS)) || measure(found, area, false) != 0 { return 134 }

    // Amounts with a threshold: each region by its own colour.
    const shades = device.create(allocator, BLACK).?
    _ = device.fill(shades, geom.rect(40, 40, 6, 6), 0xFF808080)
    _ = device.fill(shades, geom.rect(42, 42, 2, 2), 0xFF848484)
    options.threshold = 8
    options.softness = 0
    _ = device.fill(lasso, area, mask.NOTHING)
    _ = device.fill(lasso, geom.rect(30, 30, 30, 30), mask.ALL)
    if !is(fill.enclosed(shades, lasso, area, &options, found, fill.ALL_REGIONS), 40, 40, 6, 6) || measure(found, area, false) != 36 { return 135 }
    // The inner grey was reached from the outer one, 4 away of 8 at
    // softness 0: (255 * 5 + 4) / 9 = 142, and is not searched from again.
    if mask.at(found, 40, 40) != 255 || mask.at(found, 42, 42) != 142 || mask.at(found, 43, 43) != 142 || mask.at(found, 44, 44) != 255 || mask.at(found, 39, 40) != 0 { return 136 }
    device.destroy(shades)
    device.destroy(none)
    device.destroy(everything)
    device.destroy(lasso)
    device.destroy(scene)
    return 0
}

// The region filled: a colour, a pattern.
fn painting(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 100, 80)
    const block = device.create(allocator, 0).?
    _ = device.fill(block, geom.rect(30, 20, 40, 30), RED)
    var options = fill.defaults()
    options.threshold = 0
    const bounds = fill.region(block, 40, 30, area, &options, found)
    if !is(bounds, 30, 20, 40, 30) { return 150 }

    // Half opaque green over blue, undone.
    const canvas = device.create(allocator, 0).?
    _ = device.fill(canvas, area, BLUE)
    device.begin(canvas)
    var changed = fill.paint(canvas, found, bounds, GREEN, blend.NORMAL, 128, 0, null)
    const change = device.commit(canvas)
    const mixed = pixel.over(BLUE, GREEN, 128)
    if !is(changed, 30, 20, 40, 30) || mixed != 0xFF00807F { return 151 }
    if device.pixel(canvas, 30, 20) != mixed || device.pixel(canvas, 69, 49) != mixed || device.pixel(canvas, 63, 30) != mixed || device.pixel(canvas, 64, 30) != mixed { return 152 }
    if device.pixel(canvas, 29, 20) != BLUE || device.pixel(canvas, 70, 49) != BLUE || device.pixel(canvas, 30, 19) != BLUE || device.pixel(canvas, 69, 50) != BLUE { return 153 }
    if change == null { return 154 }
    _ = device.apply(canvas, change.?, true)
    if device.pixel(canvas, 30, 20) != BLUE || device.pixel(canvas, 50, 35) != BLUE { return 155 }
    device.destroyChange(change.?)

    // Wider bounds than the region change nothing more.
    changed = fill.paint(canvas, found, area, GREEN, blend.NORMAL, 255, 0, null)
    if !is(changed, 30, 20, 40, 30) || device.pixel(canvas, 30, 20) != GREEN || device.pixel(canvas, 29, 20) != BLUE { return 156 }
    // Bounds that cut the region cut the fill.
    _ = device.fill(canvas, area, BLUE)
    changed = fill.paint(canvas, found, geom.rect(60, 40, 40, 40), GREEN, blend.NORMAL, 255, 0, null)
    if !is(changed, 60, 40, 10, 10) || device.pixel(canvas, 60, 40) != GREEN || device.pixel(canvas, 59, 40) != BLUE || device.pixel(canvas, 60, 39) != BLUE { return 157 }
    _ = device.fill(canvas, area, BLUE)

    // A selection of the left half, half selected: half the amount there,
    // none of the fill beside it.
    const chosen = mask.create(allocator, false).?
    _ = device.fill(chosen, geom.rect(0, 0, 50, 80), pixel.gray(128))
    changed = fill.paint(canvas, found, bounds, GREEN, blend.NORMAL, 255, 0, chosen)
    if !is(changed, 30, 20, 20, 30) || device.pixel(canvas, 49, 25) != mixed || device.pixel(canvas, 30, 49) != mixed || device.pixel(canvas, 50, 25) != BLUE { return 158 }
    // With an opacity as well: 128 of 128.
    _ = device.fill(canvas, area, BLUE)
    _ = fill.paint(canvas, found, bounds, GREEN, blend.NORMAL, 128, 0, chosen)
    if pixel.mul(128, 128) != 64 || device.pixel(canvas, 40, 30) != pixel.over(BLUE, GREEN, 64) || device.pixel(canvas, 60, 30) != BLUE { return 159 }

    // On nothing: the colour itself, and tiles only where the region is.
    const fresh = device.create(allocator, 0).?
    _ = fill.paint(fresh, found, area, GREEN, blend.NORMAL, 255, 0, null)
    if device.pixel(fresh, 30, 20) != GREEN || device.pixel(fresh, 69, 49) != GREEN || device.pixel(fresh, 29, 20) != 0 || device.tileCount(fresh) != 2 { return 160 }
    // A colour that is half transparent itself, at alpha 200 of 255.
    device.clear(fresh)
    _ = fill.paint(fresh, found, bounds, 0x80FF0000, blend.NORMAL, 200, 0, null)
    if device.pixel(fresh, 40, 30) != pixel.over(0, 0x80FF0000, 200) || device.pixel(fresh, 40, 30) != 0x64FF0000 { return 161 }
    // No opacity: nothing.
    device.clear(fresh)
    if !geom.isEmpty(fill.paint(fresh, found, bounds, GREEN, blend.NORMAL, 0, 0, null)) || device.tileCount(fresh) != 0 { return 162 }
    if !geom.isEmpty(fill.paint(fresh, found, geom.empty(), GREEN, blend.NORMAL, 255, 0, null)) || !geom.isEmpty(fill.paint(fresh, found, geom.rect(0, 0, 20, 20), GREEN, blend.NORMAL, 255, 0, null)) { return 163 }
    // Erased: what was there goes where the region is.
    _ = device.fill(fresh, area, RED)
    _ = fill.paint(fresh, found, bounds, WHITE, blend.ERASE, 255, 0, null)
    if device.pixel(fresh, 40, 30) != 0 || device.pixel(fresh, 29, 30) != RED { return 164 }
    // Alpha locked: only where there is paint.
    device.clear(fresh)
    _ = device.fill(fresh, geom.rect(0, 0, 40, 80), RED)
    _ = fill.paint(fresh, found, bounds, GREEN, blend.NORMAL, 255, blend.FLAG_ALPHA_LOCK, null)
    if device.pixel(fresh, 35, 30) != GREEN || device.pixel(fresh, 45, 30) != 0 { return 165 }

    // A region of amounts: each pixel by its own.
    const ramp = device.create(allocator, 0).?
    var x: i32 = 0
    while x < 256 {
        const level = @intCast(u32, x)
        _ = device.fill(ramp, geom.rect(x, 0, 1, 4), pixel.rgb(level, level, level))
        x += 1
    }
    options.threshold = 10
    options.softness = 0
    const soft = fill.region(ramp, 100, 1, geom.rect(0, 0, 256, 4), &options, found)
    _ = device.fill(canvas, area, BLUE)
    changed = fill.paint(canvas, found, soft, GREEN, blend.NORMAL, 255, 0, null)
    if !is(soft, 90, 0, 21, 4) || !is(changed, 90, 0, 21, 4) { return 166 }
    if device.pixel(canvas, 95, 1) != pixel.over(BLUE, GREEN, 139) || device.pixel(canvas, 90, 1) != pixel.over(BLUE, GREEN, 23) || device.pixel(canvas, 89, 1) != BLUE { return 167 }
    options = fill.defaults()
    options.threshold = 0
    _ = fill.region(block, 40, 30, area, &options, found)

    // A pattern of 2 x 2 laid from (1, 0): the place decides the pixel,
    // across the tile's border as well.
    const pattern = [4]u32{ RED, GREEN, BLUE, WHITE }
    const tiled = device.create(allocator, 0).?
    changed = fill.paintPattern(tiled, found, bounds, &pattern, 2, 2, 1, 0, blend.NORMAL, 255, 0, null)
    if !is(changed, 30, 20, 40, 30) { return 168 }
    if device.pixel(tiled, 30, 20) != GREEN || device.pixel(tiled, 31, 20) != RED || device.pixel(tiled, 30, 21) != WHITE || device.pixel(tiled, 31, 21) != BLUE { return 169 }
    if device.pixel(tiled, 63, 25) != BLUE || device.pixel(tiled, 64, 25) != WHITE || device.pixel(tiled, 65, 25) != BLUE || device.pixel(tiled, 29, 20) != 0 || device.pixel(tiled, 70, 20) != 0 { return 170 }
    // 3 x 2 from (-2, 5): column (x + 2) mod 3, row (y - 5) mod 2.
    const wide = [6]u32{ 0xFF000001, 0xFF000002, 0xFF000003, 0xFF000004, 0xFF000005, 0xFF000006 }
    device.clear(tiled)
    _ = fill.paintPattern(tiled, found, bounds, &wide, 3, 2, -2, 5, blend.NORMAL, 255, 0, null)
    if device.pixel(tiled, 30, 20) != 0xFF000006 || device.pixel(tiled, 31, 20) != 0xFF000004 || device.pixel(tiled, 30, 21) != 0xFF000003 || device.pixel(tiled, 69, 49) != 0xFF000003 { return 171 }
    // An offset far beyond the pattern's size, either way.
    device.clear(tiled)
    _ = fill.paintPattern(tiled, found, bounds, &wide, 3, 2, 3001, -2001, blend.NORMAL, 255, 0, null)
    if device.pixel(tiled, 30, 20) != 0xFF000006 || device.pixel(tiled, 31, 20) != 0xFF000004 { return 172 }
    // With an opacity and the selection over blue.
    _ = device.fill(canvas, area, BLUE)
    changed = fill.paintPattern(canvas, found, bounds, &pattern, 2, 2, 0, 0, blend.NORMAL, 255, 0, chosen)
    if !is(changed, 30, 20, 20, 30) || device.pixel(canvas, 30, 20) != pixel.over(BLUE, RED, 128) || device.pixel(canvas, 31, 21) != pixel.over(BLUE, WHITE, 128) || device.pixel(canvas, 50, 20) != BLUE { return 173 }
    // A pattern of no size is none.
    if !geom.isEmpty(fill.paintPattern(canvas, found, bounds, &pattern, 0, 2, 0, 0, blend.NORMAL, 255, 0, null)) || !geom.isEmpty(fill.paintPattern(canvas, found, bounds, &pattern, 2, -1, 0, 0, blend.NORMAL, 255, 0, null)) { return 174 }
    device.destroy(tiled)
    device.destroy(ramp)
    device.destroy(fresh)
    device.destroy(chosen)
    device.destroy(canvas)
    device.destroy(block)
    return 0
}

// Left of and above the origin, a layer moved, the mask moved.
fn places(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const far = device.create(allocator, 0).?
    outline(far, geom.rect(-100, -90, 30, 30), BLACK)
    var area = geom.rect(-130, -120, 100, 80)
    var options = fill.defaults()
    options.threshold = 0
    if !is(fill.region(far, -90, -80, area, &options, found), -99, -89, 28, 28) || measure(found, area, false) != 784 { return 180 }
    if mask.at(found, -99, -89) != 255 || mask.at(found, -100, -89) != 0 || mask.at(found, -72, -62) != 255 || mask.at(found, -71, -62) != 0 { return 181 }
    if !is(fill.region(far, -130, -120, area, &options, found), -130, -120, 100, 80) || measure(found, area, false) != 7100 { return 182 }

    // The layer moved: its pixels are elsewhere in the image, its tiles
    // no longer on the image's 64s; the mask moved another way.
    device.clear(found)
    device.moveTo(far, 37, -11)
    device.moveTo(found, 5, 7)
    area = geom.rect(-93, -131, 100, 80)
    if !is(fill.region(far, -53, -91, area, &options, found), -62, -100, 28, 28) || measure(found, area, false) != 784 { return 183 }
    if mask.at(found, -62, -100) != 255 || mask.at(found, -63, -100) != 0 || mask.at(found, -35, -73) != 255 || mask.at(found, -34, -73) != 0 { return 184 }
    if !is(fill.region(far, -93, -131, area, &options, found), -93, -131, 100, 80) || measure(found, area, false) != 7100 { return 185 }
    options.grow = 1
    if !is(fill.region(far, -53, -91, area, &options, found), -63, -101, 30, 30) || measure(found, area, false) != 896 || mask.at(found, -63, -101) != 0 { return 186 }
    options.grow = 0
    options.feather = 4.0
    if !is(fill.region(far, -53, -91, area, &options, found), -66, -104, 36, 36) || mask.at(found, -62, -87) != 154 || mask.at(found, -63, -87) != 101 { return 187 }
    options.feather = 0.0
    if !is(fill.similar(far, BLACK, area, &options, found), -63, -101, 30, 30) || measure(found, area, false) != 116 { return 188 }
    const lasso = mask.create(allocator, false).?
    device.moveTo(lasso, -1000, 3)
    _ = device.fill(lasso, geom.rect(-70, -108, 45, 45), mask.ALL)
    if !is(fill.enclosed(far, lasso, area, &options, found, fill.ALL_REGIONS), -63, -101, 30, 30) || measure(found, area, false) != 900 { return 189 }
    if !is(fill.enclosed(far, lasso, area, &options, found, fill.TRANSPARENT_REGIONS), -62, -100, 28, 28) || measure(found, area, false) != 784 { return 190 }
    // Painted into a layer that sits elsewhere again.
    const canvas = device.create(allocator, 0).?
    device.moveTo(canvas, -3, 9)
    const painted = fill.paint(canvas, found, area, GREEN, blend.NORMAL, 255, 0, null)
    if !is(painted, -62, -100, 28, 28) || device.pixel(canvas, -62, -100) != GREEN || device.pixel(canvas, -35, -73) != GREEN || device.pixel(canvas, -63, -100) != 0 || device.pixel(canvas, -34, -73) != 0 { return 191 }
    const pattern = [4]u32{ RED, GREEN, BLUE, WHITE }
    device.clear(canvas)
    _ = fill.paintPattern(canvas, found, area, &pattern, 2, 2, 0, 0, blend.NORMAL, 255, 0, null)
    // (-62, -100): column 0, row 0; (-61, -99): column 1, row 1.
    if device.pixel(canvas, -62, -100) != RED || device.pixel(canvas, -61, -100) != GREEN || device.pixel(canvas, -62, -99) != BLUE || device.pixel(canvas, -61, -99) != WHITE { return 192 }
    device.destroy(canvas)
    device.destroy(lasso)
    device.destroy(far)
    device.clear(found)
    device.moveTo(found, 0, 0)
    return 0
}

// Many fills take nothing of the value arena.
fn lasting(found: *device.Device) -> u8 {
    const allocator = std.heap.allocator()
    const area = geom.rect(0, 0, 100, 80)
    const layer = device.create(allocator, 0).?
    outline(layer, geom.rect(10, 10, 30, 30), BLACK)
    _ = device.fill(layer, geom.rect(60, 30, 20, 20), RED)
    const lasso = mask.create(allocator, false).?
    _ = device.fill(lasso, geom.rect(5, 5, 50, 50), mask.ALL)
    const canvas = device.create(allocator, 0).?
    const pattern = [4]u32{ RED, GREEN, BLUE, WHITE }
    var options = fill.defaults()
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: i32 = 0
    while round < 200 {
        options.grow = (round & 3) - 1
        options.feather = if round & 4 == 0 { 0.0 } else { 1.5 }
        options.diagonal = round & 8 != 0
        const inside = fill.region(layer, 20, 20, area, &options, found)
        if geom.isEmpty(inside) { return 200 }
        _ = fill.paint(canvas, found, inside, GREEN, blend.NORMAL, 200, 0, lasso)
        if geom.isEmpty(fill.similar(layer, RED, area, &options, found)) { return 201 }
        _ = fill.paintPattern(canvas, found, area, &pattern, 2, 2, round, -round, blend.NORMAL, 255, 0, null)
        if geom.isEmpty(fill.enclosed(layer, lasso, area, &options, found, fill.ALL_REGIONS)) { return 202 }
        round += 1
    }
    const grown = turns.used(arena) - before
    if grown > 1024 { return 203 }
    device.destroy(canvas)
    device.destroy(lasso)
    device.destroy(layer)
    return 0
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const made = mask.create(allocator, false)
    if made == null { return 255 }
    const found = made.?
    var failed = outlines(found)
    if failed != 0 { return failed }
    failed = colours(found)
    if failed != 0 { return failed }
    failed = sizes(found)
    if failed != 0 { return failed }
    failed = modes(found)
    if failed != 0 { return failed }
    failed = afterwards(found)
    if failed != 0 { return failed }
    failed = shapes(found)
    if failed != 0 { return failed }
    failed = painting(found)
    if failed != 0 { return failed }
    failed = places(found)
    if failed != 0 { return failed }
    failed = lasting(found)
    if failed != 0 { return failed }
    device.destroy(found)
    return 13
}
