// The channels, histogram and grid dockers (dockers/channels.mlx,
// histogram.mlx, grid.mlx), played without a window as a person would.
// Channels: the pictures of a half white layer (white where it is, the
// checker where it is not; alpha white and black), kept from frame to
// frame; red taken out by a click on its row (one step, undone by
// Ctrl+Z), the composite of the white layer then cyan where only it is
// (when core/render.mlx honours Node.channels: until then the test says
// that check waits); "Show all" puts two hidden channels back in one
// step. Histogram: a layer half black, half white across a tile's border
// counts exactly 65 x 66 of each and nothing between, its two bars as
// tall as the chart, mean 127.5, median 0; frames without a change count
// nothing again, a painted pixel makes exactly one counting again; the
// logarithmic scale shows a single pixel's bar taller than the linear
// one, without counting again; the image as the source counts the same;
// a gradient's bars are all equally tall; a layer partly at negative
// places counts only inside the image, transparent pixels not at all,
// half transparent ones whole; an empty layer counts nothing; a layer of
// 2048 x 1024 is counted over several frames, computing meanwhile. Grid:
// "Show grid", a spacing typed (the link makes the other the same, and
// unlinked it does not), subdivisions, an offset, a spacing held to its
// range; the grid shows in the frame where a line is and not between; a
// guide added at a typed 100 is in Document.guidesAcross and shows in the
// frame, a second one there is refused; snapPoint snaps within 8 window
// pixels (fewer image pixels when zoomed in), to a guide before a farther
// grid line, not at all when snapping is off or there is no image, and
// takes huge places; guides removed by their rows' crosses and all at
// once. Everything drawn opaque, light and dark, English and German; the
// value arena does not grow over 60 frames that make the pictures and the
// counts again each time, nor does the heap. Against a second, plain
// count pixel by pixel: wandering pixels of alpha 0, 1, 128 and 255 on a
// 520 x 300 image whose untouched blocks are a default pixel that is not
// transparent, the device then moved by an odd distance, a change open
// while counting, the image as the source; the ends of Rec. 709's
// luminance, a pixel at each corner of the blocks around (64, 64), a
// layer far beyond the image, choices that are no choices. A half
// transparent red pictured over the checker to the grey. An image closed
// and another made in its memory between two frames: the dockers show the
// new one; hidden as tabs and shown again they make nothing again. A
// group's counts and pictures, a channel taken out of it undone and
// redone. snapPoint at the edges: offsets at the ends of an i32, negative
// places, spacings of 0 and below, subdivisions of 0, the reach to the
// pixel at two zooms and none, a guide and a grid line equally near, 32
// guides and no more; 5000 snaps and guides without the value arena
// growing. The grid's section folded and unfolded; at a window 400 high
// the docker scrolls, what is out of sight cannot be pointed at and the
// bar dragged brings it in. Pictures: docker-misc.png,
// docker-misc-light.png, docker-misc-german.png, docker-misc-1024.png,
// docker-misc-narrow.png (the narrowest docks, at 1024 x 768; windows down
// to 64 x 64 and a layout pass's drawn too) in the current directory and,
// when NEBULA_SHOTS names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const docks = @import("../ui/docks.mlx")
const viewport = @import("../ui/viewport.mlx")
const channels = @import("../dockers/channels.mlx")
const histogram = @import("../dockers/histogram.mlx")
const grid = @import("../dockers/grid.mlx")
const documents = @import("../app/documents.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const node_module = @import("../core/node.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const image_module = @import("../core/image.mlx")
const render = @import("../core/render.mlx")
const geom = @import("../core/geom.mlx")
const ops = @import("../core/ops.mlx")

const App = state.App

// The three dockers where they all show at once: the grid's at the left,
// the channels' and the histogram's at the right.
const LAYOUT: []const u8 = "area left 270\npanel 1000 0 open grid\narea right 290\npanel 320 0 open channels\npanel 360 0 open histogram\npanel 320 0 open layers history\n"

// The same at the narrowest an area of the docks is.
const NARROW: []const u8 = "area left 140\npanel 1000 0 open grid\narea right 140\npanel 320 0 open channels\npanel 360 0 open histogram\n"

// A script being put together.
var buffer: [1024]u8 = undefined
var used: usize = 0
// Where the pictures go besides the current directory (NEBULA_SHOTS).
var shotsAt: usize = 0
var shotsLength: usize = 0

fn start() -> void { used = 0 }
fn add(text: []const u8) -> void { used = std.text.append(&buffer, used, 1024, text) }
fn addNumber(value: i32) -> void { used = std.text.appendSigned(&buffer, used, 1024, @intCast(isize, value)) }

fn play(app: *App) -> bool {
    const bytes: [*]const u8 = &buffer
    return script.run(app, bytes[0..used])
}

fn clickIn(app: *App, area: ui.Rect) -> bool {
    if ui.isEmpty(area) { return false }
    start()
    add("click ")
    addNumber(area.x + area.width / 2)
    add(" ")
    addNumber(area.y + area.height / 2)
    add("\n")
    return play(app)
}

// A number typed into the spin box at `area`: a click opens it with its
// text chosen, the digits replace it, Enter takes them.
fn typeInto(app: *App, area: ui.Rect, value: i32) -> bool {
    if !clickIn(app, area) { return false }
    start()
    add("type ")
    addNumber(value)
    add("\nkey Enter\n")
    return play(app)
}

// `count` frames, as a window would draw them one after another.
fn frames(app: *App, count: usize) -> void {
    const canvas = script.frameOf(app).?
    var index: usize = 0
    while index < count {
        app.*.shell.*.clock += 16
        api.redraw(app)
        loop.frame(app, canvas)
        index += 1
    }
}

// The window's pixel at (x, y) in the last frame.
fn windowAt(app: *App, x: i32, y: i32) -> u32 {
    const frame = script.frameOf(app).?
    return frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)]
}

// The frame as a picture here and in the shots' directory.
fn save(app: *App, name: []const u8) -> bool {
    start()
    add("shot ")
    add(name)
    add("\n")
    if !play(app) { return false }
    if shotsLength == 0 || shotsLength > 400 { return true }
    const shots = unsafe { @ptrFromInt([*]const u8, shotsAt) }[0..shotsLength]
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, shots)
    if bytes[length - 1] != '/' { length = std.text.appendByte(bytes, length, 599, '/') }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    const frame = script.frameOf(app).?
    return png.saveFile(bytes, frame.*.pixels, frame.*.width, frame.*.height, frame.*.stride, false, app.*.allocator)
}

fn inside(part: ui.Rect, around: ui.Rect) -> bool {
    return !ui.isEmpty(part) && part.x >= around.x && part.y >= around.y && ui.right(part) <= ui.right(around) && ui.bottom(part) <= ui.bottom(around)
}

// Every pixel of the docks opaque.
fn docksOpaque(app: *App) -> bool {
    const frame = script.frameOf(app).?
    var which: usize = 0
    while which < 2 {
        const area = if which == 0 { app.*.leftDock } else { app.*.rightDock }
        var y = area.y
        while y < ui.bottom(area) {
            var x = area.x
            while x < ui.right(area) {
                // (Drawn: the docks are the desktop's glass, translucent.)
                if x >= 0 && y >= 0 && @intCast(usize, x) < frame.*.width && @intCast(usize, y) < frame.*.height && windowAt(app, x, y) >> 24 == 0 { return false }
                x += 1
            }
            y += 1
        }
        which += 1
    }
    return true
}

// The active layer's pixels in `area` set to `value`: one step.
fn fill(app: *App, area: geom.Rect, value: u32) -> bool {
    const image = api.image(app).?
    const layer = api.activeNode(app).?
    if !ops.beginPixels(image, layer) { return false }
    if !device.fill(layer.*.device.?, area, value) { return false }
    _ = ops.endPixels(image, layer, "Fill")
    return true
}

// How many pixels of column `x` of the histogram's chart are not the
// chart's ground: the bar's height there.
fn barAt(app: *App, x: i32) -> i32 {
    const chart = histogram.chartArea(app)
    const ground = state.themeOf(app).*.field
    var height: i32 = 0
    var y = chart.y
    while y < ui.bottom(chart) {
        if windowAt(app, x, y) != ground { height += 1 }
        y += 1
    }
    return height
}

// The chart's column that shows `value`.
fn columnOf(app: *App, value: i32) -> i32 {
    const chart = histogram.chartArea(app)
    return chart.x + (value * chart.width + 128) / 256
}

// Counts until the histogram is done (at most `most` frames); false
// when it is not by then.
fn counted(app: *App, most: usize) -> bool {
    var index: usize = 0
    while index < most {
        frames(app, 1)
        if !histogram.isComputing(app) { return true }
        index += 1
    }
    return false
}

fn near(a: f64, b: f64) -> bool { return a - b < 0.000001 && b - a < 0.000001 }

// The window's pixels on the line of image row `y` (`across`) or image
// column `x`, at a place on the other axis: whether any differs from
// `before` (sampled the same way into `into`).
fn sampleLine(app: *App, across: bool, at: f64, other: f64, into: [*]u32) -> void {
    const doc = api.document(app).?
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    if across { viewport.toWindow(&doc.*.view, other, at, &wx, &wy) } else { viewport.toWindow(&doc.*.view, at, other, &wx, &wy) }
    const x = @intFromFloat(i32, @floor(wx))
    const y = @intFromFloat(i32, @floor(wy))
    var index: i32 = 0
    while index < 3 {
        into[@intCast(usize, index)] = if across { windowAt(app, x, y - 1 + index) } else { windowAt(app, x - 1 + index, y) }
        index += 1
    }
}

fn differs(a: [*]const u32, b: [*]const u32) -> bool {
    return a[0] != b[0] || a[1] != b[1] || a[2] != b[2]
}

// ---------------------------------------------------------------------------

fn checkChannels(app: *App) -> u8 {
    if !script.run(app, "new 130 66\n") { return 20 }
    frames(app, 2)
    const image = api.image(app).?
    const layer = api.activeNode(app).?
    if layer.*.channels != channels.ALL { return 21 }
    // The layer white at the left, nothing at the right.
    if !fill(app, geom.rect(0, 0, 65, 66), 0xFFFFFFFF) { return 22 }
    frames(app, 2)
    const red = channels.thumbArea(app, channels.RED)
    const alpha = channels.thumbArea(app, channels.ALPHA)
    if ui.isEmpty(red) || ui.isEmpty(alpha) || red.width < 8 || red.height < 4 { return 23 }
    const middle = red.y + red.height / 2
    if windowAt(app, red.x + 1, middle) != 0xFFFFFFFF { return 24 }
    const checker = windowAt(app, ui.right(red) - 2, middle)
    if checker != 0xFFCCCCCC && checker != 0xFF999999 { return 25 }
    if windowAt(app, alpha.x + 1, alpha.y + alpha.height / 2) != 0xFFFFFFFF || windowAt(app, ui.right(alpha) - 2, alpha.y + alpha.height / 2) != 0xFF000000 { return 26 }
    // Kept: frames without a change make no pictures.
    const made = channels.refreshes(app)
    frames(app, 6)
    if channels.refreshes(app) != made { return 27 }
    // Red taken out by its row: one step; the white layer shows cyan
    // where nothing is under it.
    const steps = history.stepsDone(image.*.history)
    if !clickIn(app, channels.rowArea(app, channels.RED)) { return 28 }
    if layer.*.channels != 11 || history.stepsDone(image.*.history) != steps + 1 { return 29 }
    _ = render.update(image)
    const shown = device.pixel(image.*.projection, 10, 10)
    if shown == 0xFF00FFFF {
        if device.pixel(image.*.projection, 100, 10) != 0 { return 30 }
    } else if shown == 0xFFFFFFFF {
        _ = std.io.println("69_dockers_misc: the composite does not honour Node.channels yet (waiting for core/render.mlx)")
    } else {
        return 31
    }
    if !script.run(app, "key Ctrl+Z\n") || layer.*.channels != channels.ALL { return 32 }
    // Two taken out, "Show all" puts both back in one step.
    if !channels.setShown(app, channels.GREEN, false) || !channels.setShown(app, channels.ALPHA, false) || layer.*.channels != 5 { return 33 }
    if channels.setShown(app, channels.GREEN, false) { return 34 }
    const before_all = history.stepsDone(image.*.history)
    if !channels.showAll(app) || layer.*.channels != channels.ALL || history.stepsDone(image.*.history) != before_all + 1 || channels.showAll(app) { return 35 }
    if channels.bitOf(channels.RED) != 4 || channels.bitOf(channels.BLUE) != 1 || channels.bitOf(9) != 0 { return 36 }
    return 0
}

fn checkHistogram(app: *App) -> u8 {
    // Half black, half white, across the border of two tiles.
    if !script.run(app, "new 130 66\n") { return 40 }
    if !fill(app, geom.rect(0, 0, 65, 66), 0xFF000000) || !fill(app, geom.rect(65, 0, 65, 66), 0xFFFFFFFF) { return 41 }
    if !counted(app, 20) { return 42 }
    if histogram.pixelCount(app) != 8580 { return 43 }
    var channel: usize = 0
    while channel < histogram.CHANNELS {
        if histogram.countOf(app, channel, 0) != 4290 || histogram.countOf(app, channel, 255) != 4290 { return 44 }
        var value: usize = 1
        while value < 255 {
            if histogram.countOf(app, channel, value) != 0 { return 45 }
            value += 1
        }
        channel += 1
    }
    if !near(histogram.meanOf(app, histogram.CHANNEL_LUMA), 127.5) || histogram.medianOf(app, histogram.CHANNEL_LUMA) != 0 { return 46 }
    // Two bars as tall as the chart, nothing between.
    const chart = histogram.chartArea(app)
    if ui.isEmpty(chart) || chart.height < 20 || chart.width < 100 { return 47 }
    if barAt(app, chart.x) != chart.height || barAt(app, ui.right(chart) - 1) != chart.height { return 48 }
    if barAt(app, columnOf(app, 100)) != 0 { return 49 }
    // Frames with nothing changed count nothing again.
    const before = histogram.computations(app)
    frames(app, 10)
    if histogram.computations(app) != before || histogram.isComputing(app) { return 50 }
    // A pixel painted: counted once again.
    if !fill(app, geom.rect(5, 5, 1, 1), 0xFF808080) { return 51 }
    if !counted(app, 20) || histogram.computations(app) != before + 1 { return 52 }
    frames(app, 5)
    if histogram.computations(app) != before + 1 { return 53 }
    if histogram.countOf(app, histogram.CHANNEL_LUMA, 128) != 1 || histogram.countOf(app, histogram.CHANNEL_LUMA, 0) != 4289 || histogram.countOf(app, histogram.CHANNEL_RED, 128) != 1 { return 54 }
    // The logarithmic scale: the single pixel's bar is taller.
    const single = columnOf(app, 128)
    const linear = barAt(app, single)
    if linear < 1 || linear > 2 { return 55 }
    if !clickIn(app, histogram.controlArea(app, histogram.CONTROL_LOG)) { return 56 }
    frames(app, 1)
    if barAt(app, single) <= linear + 2 || histogram.computations(app) != before + 1 { return 57 }
    if !clickIn(app, histogram.controlArea(app, histogram.CONTROL_LINEAR)) { return 58 }
    frames(app, 1)
    if barAt(app, single) != linear { return 59 }
    // The whole image counts the same (nothing else shows).
    histogram.setSource(app, histogram.SOURCE_IMAGE)
    if !counted(app, 20) || histogram.computations(app) != before + 2 || histogram.pixelCount(app) != 8580 || histogram.countOf(app, histogram.CHANNEL_BLUE, 255) != 4290 { return 60 }
    histogram.setSource(app, histogram.SOURCE_LAYER)
    histogram.setChannel(app, histogram.CHANNEL_RED)
    if !counted(app, 20) { return 61 }

    // A gradient: every value as often; all bars as tall as the chart.
    if !script.run(app, "new 256 16\n") { return 62 }
    var x: i32 = 0
    while x < 256 {
        const grey = @intCast(u32, x)
        if !fill(app, geom.rect(x, 0, 1, 16), 0xFF000000 | (grey << 16) | (grey << 8) | grey) { return 63 }
        x += 1
    }
    if !counted(app, 20) { return 64 }
    var value: usize = 0
    while value < 256 {
        if histogram.countOf(app, histogram.CHANNEL_LUMA, value) != 16 || histogram.countOf(app, histogram.CHANNEL_RED, value) != 16 { return 65 }
        value += 1
    }
    const flat = histogram.chartArea(app)
    var column = flat.x
    while column < ui.right(flat) {
        if barAt(app, column) != flat.height { return 66 }
        column += 1
    }

    // Partly at negative places, transparent and half transparent pixels.
    if !script.run(app, "new 100 100\n") { return 67 }
    if !fill(app, geom.rect(-50, -50, 100, 100), 0xFFFF0000) || !fill(app, geom.rect(60, 60, 10, 10), 0x00FFFFFF) || !fill(app, geom.rect(0, 60, 10, 10), 0x80000000) { return 68 }
    if !counted(app, 20) { return 69 }
    if histogram.pixelCount(app) != 2600 || histogram.countOf(app, histogram.CHANNEL_RED, 255) != 2500 || histogram.countOf(app, histogram.CHANNEL_RED, 0) != 100 || histogram.countOf(app, histogram.CHANNEL_GREEN, 255) != 0 { return 70 }
    // Rec. 709: pure red is 54 of 255.
    if histogram.countOf(app, histogram.CHANNEL_LUMA, 54) != 2500 { return 71 }

    // An empty layer of a 1 x 1 image counts nothing; then one pixel.
    if !script.run(app, "new 1 1\n") || !counted(app, 20) || histogram.pixelCount(app) != 0 || histogram.medianOf(app, histogram.CHANNEL_RED) != 0 { return 72 }
    if !fill(app, geom.rect(0, 0, 1, 1), 0xFF102030) || !counted(app, 20) || histogram.pixelCount(app) != 1 || histogram.countOf(app, histogram.CHANNEL_GREEN, 32) != 1 { return 73 }

    // A large layer: counted over several frames.
    if !script.run(app, "new 2048 1024\n") { return 74 }
    if !fill(app, geom.rect(0, 0, 2048, 1024), 0xFF336699) { return 75 }
    const large = histogram.computations(app)
    frames(app, 1)
    if !histogram.isComputing(app) || histogram.computations(app) != large { return 76 }
    if !counted(app, 40) || histogram.computations(app) != large + 1 || histogram.pixelCount(app) != 2097152 || histogram.countOf(app, histogram.CHANNEL_RED, 51) != 2097152 { return 77 }
    return 0
}

fn checkGrid(app: *App) -> u8 {
    if !script.run(app, "new 200 160 FFFFFF\n") { return 80 }
    frames(app, 2)
    const doc = api.document(app).?
    if doc.*.showGrid { return 81 }
    var before: [3]u32 = [3]u32{ 0, 0, 0 }
    var after: [3]u32 = [3]u32{ 0, 0, 0 }
    var between: [3]u32 = [3]u32{ 0, 0, 0 }
    var between_after: [3]u32 = [3]u32{ 0, 0, 0 }
    sampleLine(app, false, 32.0, 50.0, &before)
    sampleLine(app, false, 8.0, 50.0, &between)
    if !clickIn(app, grid.partArea(app, grid.PART_SHOW_GRID)) || !doc.*.showGrid { return 82 }
    // A spacing typed across: down follows (linked).
    if !typeInto(app, grid.partArea(app, grid.PART_SPACING_X), 32) || doc.*.gridX != 32 || doc.*.gridY != 32 { return 83 }
    frames(app, 2)
    sampleLine(app, false, 32.0, 50.0, &after)
    sampleLine(app, false, 8.0, 50.0, &between_after)
    if !differs(&before, &after) || differs(&between, &between_after) { return 84 }
    // Unlinked: down set alone.
    if !clickIn(app, grid.partArea(app, grid.PART_LINK)) { return 85 }
    if !typeInto(app, grid.partArea(app, grid.PART_SPACING_Y), 40) || doc.*.gridY != 40 || doc.*.gridX != 32 { return 86 }
    if !typeInto(app, grid.partArea(app, grid.PART_DIVISIONS), 4) || doc.*.gridDivisions != 4 { return 87 }
    if !typeInto(app, grid.partArea(app, grid.PART_OFFSET_X), 3) || doc.*.gridOffsetX != 3 { return 88 }
    // Held to its range: a spacing of 0 is 1.
    if !typeInto(app, grid.partArea(app, grid.PART_SPACING_X), 0) || doc.*.gridX != 1 { return 89 }
    if !typeInto(app, grid.partArea(app, grid.PART_SPACING_X), 32) || !typeInto(app, grid.partArea(app, grid.PART_SPACING_Y), 32) || !typeInto(app, grid.partArea(app, grid.PART_DIVISIONS), 2) || !typeInto(app, grid.partArea(app, grid.PART_OFFSET_X), 0) { return 90 }

    // A guide across at a typed 100: kept and shown.
    frames(app, 2)
    sampleLine(app, true, 100.0, 50.0, &before)
    if !typeInto(app, grid.partArea(app, grid.PART_POSITION), 100) || !clickIn(app, grid.partArea(app, grid.PART_ADD)) { return 91 }
    if doc.*.guidesAcrossCount != 1 || doc.*.guidesAcross[0] != 100 || doc.*.guidesDownCount != 0 { return 92 }
    frames(app, 2)
    sampleLine(app, true, 100.0, 50.0, &after)
    if !differs(&before, &after) { return 93 }
    // A second one there is refused; one down is kept beside it.
    if grid.addGuide(app, true, 100) || doc.*.guidesAcrossCount != 1 { return 94 }
    if !grid.addGuide(app, false, 150) || doc.*.guidesDownCount != 1 || doc.*.guidesDown[0] != 150 { return 95 }
    // (The list of guides grew: the rows under it are lower now.)
    frames(app, 2)

    // Snapping: off, nothing moves.
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    if grid.snapPoint(app, 33.5, 70.0, &sx, &sy) || sx != 33.5 || sy != 70.0 { return 96 }
    if !clickIn(app, grid.partArea(app, grid.PART_SNAP_GRID)) || !grid.snapToGrid(app) || grid.snapToGuides(app) { return 97 }
    // Lines every 16 (32 in two): at zoom 1 within 8 pixels.
    doc.*.view.zoom = 1.0
    if !grid.snapPoint(app, 33.5, 70.0, &sx, &sy) || sx != 32.0 || sy != 64.0 { return 98 }
    // Zoomed in four times: within 2 image pixels.
    doc.*.view.zoom = 4.0
    if !grid.snapPoint(app, 33.5, 37.0, &sx, &sy) || sx != 32.0 || sy != 37.0 { return 99 }
    // The guides: the one across at 100 before the grid's 96.
    if !clickIn(app, grid.partArea(app, grid.PART_SNAP_GUIDES)) || !grid.snapToGuides(app) { return 100 }
    doc.*.view.zoom = 1.0
    if !grid.snapPoint(app, 149.0, 98.5, &sx, &sy) || sx != 150.0 || sy != 100.0 { return 101 }
    // Huge places do not trap; nothing near them but the grid.
    _ = grid.snapPoint(app, 1000000000000.0, -1000000000000.0, &sx, &sy)
    grid.setSnapping(app, false, false)
    if grid.snapPoint(app, 149.0, 98.5, &sx, &sy) { return 102 }
    frames(app, 2)
    return 0
}

// A guide removed by its row's cross, the rest by "Remove all guides".
fn guideRemoved(app: *App) -> u8 {
    const doc = api.document(app).?
    if !grid.addGuide(app, true, 40) { return 103 }
    frames(app, 2)
    if !clickIn(app, grid.crossArea(app, false, 0)) || doc.*.guidesDownCount != 0 || doc.*.guidesAcrossCount != 2 || doc.*.guidesAcross[1] != 40 { return 104 }
    frames(app, 2)
    if !clickIn(app, grid.crossArea(app, true, 0)) || doc.*.guidesAcrossCount != 1 || doc.*.guidesAcross[0] != 40 { return 105 }
    frames(app, 2)
    if !clickIn(app, grid.partArea(app, grid.PART_CLEAR)) || doc.*.guidesAcrossCount != 0 || doc.*.guidesDownCount != 0 { return 106 }
    if !grid.addGuide(app, false, 60) || !grid.addGuide(app, false, 61) || doc.*.guidesDownCount != 2 { return 107 }
    grid.removeGuide(app, false, 0)
    if doc.*.guidesDownCount != 1 || doc.*.guidesDown[0] != 61 { return 108 }
    grid.removeGuides(app)
    if doc.*.guidesDownCount != 0 { return 109 }
    return 0
}

// ---------------------------------------------------------------------------
// A second count, plain: every pixel of the image read by itself.

// Rec. 709's luminance of a straight pixel, rounded half up: written
// apart from the docker's own arithmetic.
fn plainLuma(value: u32) -> usize {
    const weighted = ((value >> 16) & 255) * 2126 + ((value >> 8) & 255) * 7152 + (value & 255) * 722
    var luma = weighted / 10000
    if weighted % 10000 >= 5000 { luma += 1 }
    return @intCast(usize, luma)
}

// The histogram of what `node` has inside the image (`bins`: four rows of
// 256, luminance, red, green, blue), counted pixel by pixel; the pixels
// counted.
fn plainCount(image: *image_module.Image, node: *node_module.Node, bins: [*]u32) -> u64 {
    device.fillWords(bins, 1024, 0)
    var total: u64 = 0
    var y: i32 = 0
    while y < image.*.height {
        var x: i32 = 0
        while x < image.*.width {
            const value = device.pixel(node.*.device.?, x, y)
            if value >> 24 != 0 {
                bins[plainLuma(value)] += 1
                bins[256 + @intCast(usize, (value >> 16) & 255)] += 1
                bins[512 + @intCast(usize, (value >> 8) & 255)] += 1
                bins[768 + @intCast(usize, value & 255)] += 1
                total += 1
            }
            x += 1
        }
        y += 1
    }
    return total
}

// Whether the docker's last counts are `bins` and `total` to the pixel,
// with the mean and median of each channel that follow from them.
fn sameCounts(app: *App, bins: [*]const u32, total: u64) -> bool {
    if histogram.pixelCount(app) != total { return false }
    var channel: usize = 0
    while channel < 4 {
        var sum: u64 = 0
        var value: usize = 0
        while value < 256 {
            if histogram.countOf(app, channel, value) != bins[channel * 256 + value] { return false }
            sum += @intCast(u64, bins[channel * 256 + value]) * @intCast(u64, value)
            value += 1
        }
        // The median: the first value where at least half are reached.
        var below: u64 = 0
        var median: usize = 0
        while median < 255 && (below + @intCast(u64, bins[channel * 256 + median])) * 2 < total {
            below += @intCast(u64, bins[channel * 256 + median])
            median += 1
        }
        if total == 0 { median = 0 }
        if histogram.medianOf(app, channel) != median { return false }
        const mean = if total == 0 { 0.0 } else { @floatFromInt(f64, sum) / @floatFromInt(f64, total) }
        if !near(histogram.meanOf(app, channel), mean) { return false }
        channel += 1
    }
    return true
}

// A pixel for (x, y) that wanders over all values: alpha 0, 1, 128 or
// 255, the colours from a hash of the place.
fn wandering(x: i32, y: i32) -> u32 {
    const place = @intCast(u32, (x + 1000) & 4095) *% 2654435761 +% @intCast(u32, (y + 1000) & 4095) *% 40503
    const mixed = (place ^ (place >> 13)) *% 2246822519
    const kind = (mixed >> 29) & 3
    const alpha: u32 = if kind == 0 { 0 } else if kind == 1 { 1 } else if kind == 2 { 128 } else { 255 }
    return (alpha << 24) | (mixed & 0x00FFFFFF)
}

// The histogram against the plain count: a layer of wandering pixels over
// a part of a 520 x 300 image (neither side a multiple of 64), partly
// outside it, the rest its default pixel (not transparent: whole blocks
// of it count at once); the device moved by an odd distance; a change
// open while counting; the same twice in a row.
fn checkAgainstPlain(app: *App) -> u8 {
    const allocator = app.*.allocator
    const memory = allocator.alloc(1024 * 4 + 300 * 4, 16)
    if memory == null { return 140 }
    const bins: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    const row: [*]u32 = bins + 1024
    if !script.run(app, "new 520 300\n") { return 141 }
    histogram.setSource(app, histogram.SOURCE_LAYER)
    histogram.setChannel(app, histogram.CHANNEL_LUMA)
    const image = api.image(app).?
    const layer = api.activeNode(app).?
    if !ops.beginPixels(image, layer) { return 142 }
    device.setDefault(layer.*.device.?, 0xFF204060)
    var y: i32 = -20
    while y < 200 {
        var x: i32 = 0
        while x < 300 {
            row[@intCast(usize, x)] = wandering(x - 30, y)
            x += 1
        }
        if !device.writeRect(layer.*.device.?, geom.rect(-30, y, 300, 1), row, 300) { return 143 }
        y += 1
    }
    // (A pixel at each corner of a block, and at the image's last one.)
    if !device.fill(layer.*.device.?, geom.rect(63, 63, 2, 2), 0x01FFFFFF) || !device.fill(layer.*.device.?, geom.rect(519, 299, 1, 1), 0xFF0000FF) { return 144 }
    _ = ops.endPixels(image, layer, "Wandering")
    image_module.damageAll(image)
    const before = histogram.computations(app)
    if !counted(app, 40) || histogram.computations(app) != before + 1 { return 145 }
    var total = plainCount(image, layer, bins)
    // Most of the image is the default pixel: 520 x 300 less what was
    // written inside it.
    if bins[256 + 0x20] < 40000 || !sameCounts(app, bins, total) { return 146 }
    // Moved by an odd distance: the blocks are no tiles any more.
    const moved = layer.*.device.?
    device.moveTo(moved, moved.*.x - 37, moved.*.y + 5)
    image_module.damageAll(image)
    if !counted(app, 40) || histogram.computations(app) != before + 2 { return 147 }
    total = plainCount(image, layer, bins)
    if !sameCounts(app, bins, total) { return 148 }
    // A change open (a stroke under way) while the counting runs.
    device.begin(moved)
    if !device.fill(moved, geom.rect(100, 100, 140, 70), 0xFFFFFFFF) { return 149 }
    image_module.damage(image, geom.rect(100, 100, 140, 70))
    if !counted(app, 40) { return 150 }
    total = plainCount(image, layer, bins)
    if !sameCounts(app, bins, total) || histogram.countOf(app, histogram.CHANNEL_LUMA, 255) < 140 * 70 { return 151 }
    _ = device.rollback(moved)
    image_module.damageAll(image)
    if !counted(app, 40) { return 152 }
    total = plainCount(image, layer, bins)
    if !sameCounts(app, bins, total) { return 153 }
    // The image as the source: the projection, the layer over nothing.
    histogram.setSource(app, histogram.SOURCE_IMAGE)
    if !counted(app, 40) { return 154 }
    const counts_image = histogram.computations(app)
    frames(app, 3)
    if histogram.computations(app) != counts_image { return 155 }
    histogram.setSource(app, histogram.SOURCE_LAYER)
    if !counted(app, 40) { return 156 }
    unsafe { allocator.free(memory.?, 1024 * 4 + 300 * 4, 16) }
    return 0
}

// Luminance at the ends of each channel, alpha 1 counted whole, a pixel
// at each of the four corners of the 64 x 64 blocks around (64, 64), a
// layer far larger than the image (only its inside counts).
fn checkCountEdges(app: *App) -> u8 {
    if !script.run(app, "new 129 65\n") { return 160 }
    if !fill(app, geom.rect(0, 0, 1, 1), 0x01FFFFFF) || !fill(app, geom.rect(63, 63, 2, 2), 0xFF00FF00) || !fill(app, geom.rect(128, 64, 1, 1), 0xFF0000FF) || !fill(app, geom.rect(128, 0, 1, 1), 0xFFFF0000) {
        return 161
    }
    if !counted(app, 20) || histogram.pixelCount(app) != 7 { return 162 }
    // White 255, green 182, blue 18, red 54 (Rec. 709, rounded).
    if histogram.countOf(app, histogram.CHANNEL_LUMA, 255) != 1 || histogram.countOf(app, histogram.CHANNEL_LUMA, 182) != 4 || histogram.countOf(app, histogram.CHANNEL_LUMA, 18) != 1 || histogram.countOf(app, histogram.CHANNEL_LUMA, 54) != 1 { return 163 }
    if histogram.countOf(app, histogram.CHANNEL_GREEN, 255) != 5 || histogram.countOf(app, histogram.CHANNEL_GREEN, 0) != 2 || histogram.countOf(app, histogram.CHANNEL_RED, 255) != 2 { return 164 }
    if plainLuma(0xFF00FF00) != 182 || plainLuma(0xFF0000FF) != 18 || plainLuma(0xFFFF0000) != 54 { return 165 }
    // A layer far beyond the image: what is outside does not count.
    if !fill(app, geom.rect(-200, -300, 700, 600), 0xFF7F7F7F) || !counted(app, 20) || histogram.pixelCount(app) != 129 * 65 || histogram.countOf(app, histogram.CHANNEL_BLUE, 127) != 129 * 65 { return 166 }
    // Asking for what is not there.
    if histogram.countOf(app, 4, 0) != 0 || histogram.countOf(app, 0, 256) != 0 || histogram.medianOf(app, 9) != 0 || histogram.meanOf(app, 9) != 0.0 { return 167 }
    histogram.setChannel(app, 9)
    histogram.setSource(app, 7)
    if !counted(app, 5) || histogram.pixelCount(app) != 129 * 65 { return 168 }
    return 0
}

// The channels' pictures of a half transparent red: the colour's share
// over the checker (230 or 204 for red, 102 or 76 for green where the
// checker is light or dark), alpha its grey.
fn checkHalfPictures(app: *App) -> u8 {
    if !script.run(app, "new 130 66\n") { return 170 }
    if !fill(app, geom.rect(0, 0, 130, 66), 0x80FF0000) { return 171 }
    frames(app, 2)
    const red = channels.thumbArea(app, channels.RED)
    const green = channels.thumbArea(app, channels.GREEN)
    const alpha = channels.thumbArea(app, channels.ALPHA)
    if ui.isEmpty(red) || red.width != green.width || red.height != alpha.height { return 172 }
    var y: i32 = 0
    while y < red.height {
        var x: i32 = 0
        while x < red.width {
            const r = windowAt(app, red.x + x, red.y + y)
            const g = windowAt(app, green.x + x, green.y + y)
            if !((r == 0xFFE6E6E6 && g == 0xFF666666) || (r == 0xFFCCCCCC && g == 0xFF4C4C4C)) { return 173 }
            if windowAt(app, alpha.x + x, alpha.y + y) != 0xFF808080 { return 174 }
            x += 1
        }
        y += 1
    }
    // Rows that are not there.
    if !ui.isEmpty(channels.rowArea(app, channels.CHANNELS)) || !ui.isEmpty(channels.thumbArea(app, 99)) || channels.setShown(app, channels.CHANNELS, false) || channels.setShown(app, 99, true) { return 175 }
    if channels.bitOf(channels.GREEN) | channels.bitOf(channels.RED) | channels.bitOf(channels.BLUE) | channels.bitOf(channels.ALPHA) != channels.ALL { return 176 }
    return 0
}

// An image closed and another of the same size made in its place
// between two frames (the memory of the one may be the other's): the
// dockers show the new one.
// (One layer, as an opened file has it: its node and the image are made
// in the order the closed one's were let go.)
fn oneLayer(app: *App, color: u32) -> bool {
    const made = image_module.create(app.*.allocator, 70, 50, 72.0)
    if made == null { return false }
    const layer = ops.newLayer(made.?, node_module.PAINT, "Only", "New layer")
    if layer == null || !device.fill(layer.?.*.device.?, image_module.bounds(made.?), color) { return false }
    image_module.damageAll(made.?)
    return documents.add(app, made.?, "Only") != null
}

fn checkReplaced(app: *App) -> u8 {
    if !oneLayer(app, 0xFFFFFFFF) { return 180 }
    histogram.setSource(app, histogram.SOURCE_LAYER)
    histogram.setChannel(app, histogram.CHANNEL_LUMA)
    var image = api.image(app).?
    if !counted(app, 20) || histogram.countOf(app, histogram.CHANNEL_LUMA, 255) != 3500 { return 181 }
    frames(app, 2)
    const red = channels.thumbArea(app, channels.RED)
    if ui.isEmpty(red) || windowAt(app, red.x + 1, red.y + 1) != 0xFFFFFFFF { return 182 }
    const old = @intFromPtr(image)
    const old_layer = @intFromPtr(image.*.active.?)
    const doc = api.document(app).?
    canvasview.forget(app, doc)
    documents.close(app, app.*.current)
    if !oneLayer(app, 0xFF000000) { return 183 }
    image = api.image(app).?
    if @intFromPtr(image) == old && @intFromPtr(image.*.active.?) == old_layer { _ = std.io.println("69_dockers_misc: the new image and its layer have the closed ones' addresses") }
    if !counted(app, 20) || histogram.countOf(app, histogram.CHANNEL_LUMA, 0) != 3500 || histogram.countOf(app, histogram.CHANNEL_LUMA, 255) != 0 { return 184 }
    frames(app, 1)
    const red_now = channels.thumbArea(app, channels.RED)
    if ui.isEmpty(red_now) || windowAt(app, red_now.x + 1, red_now.y + 1) != 0xFF000000 { return 185 }
    // Hidden for a while and shown again, nothing changed meanwhile:
    // nothing is made again.
    const counts = histogram.computations(app)
    const made = channels.refreshes(app)
    if !docks.read(app, "area left 270\npanel 1000 0 open grid\narea right 290\npanel 600 0 open layers channels histogram\n") { return 186 }
    frames(app, 3)
    if !ui.isEmpty(histogram.chartArea(app)) || !ui.isEmpty(channels.rowArea(app, channels.RED)) { return 187 }
    if !docks.read(app, LAYOUT) { return 188 }
    frames(app, 2)
    if ui.isEmpty(histogram.chartArea(app)) || histogram.computations(app) != counts || histogram.isComputing(app) || channels.refreshes(app) != made { return 189 }
    return 0
}

// snapPoint at the edges: offsets at the ends of what an i32 holds,
// negative places, a spacing of 0 or below, subdivisions of 0, the reach
// to the pixel (8 snaps, 8.5 does not), zoomed out, a guide and a grid
// line equally near (the guide wins), the guides full.
fn checkSnapEdges(app: *App) -> u8 {
    if !script.run(app, "new 200 160\n") { return 190 }
    const doc = api.document(app).?
    doc.*.view.zoom = 1.0
    grid.setSnapping(app, true, false)
    doc.*.gridX = 10
    doc.*.gridY = 10
    doc.*.gridDivisions = 1
    doc.*.gridOffsetX = 2147483647
    doc.*.gridOffsetY = -2147483648
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    // Lines at 7, 17, ... across and 2, 12, ... down.
    if !grid.snapPoint(app, 33.5, 5.0, &sx, &sy) || sx != 37.0 || sy != 2.0 { return 191 }
    doc.*.gridOffsetX = -3
    doc.*.gridOffsetY = 0
    doc.*.gridX = 16
    if !grid.snapPoint(app, -33.5, -1.0, &sx, &sy) || sx != -35.0 || sy != 0.0 { return 192 }
    // No spacing across: x stays; y snaps.
    doc.*.gridX = 0
    if !grid.snapPoint(app, 33.5, 33.5, &sx, &sy) || sx != 33.5 || sy != 30.0 { return 193 }
    doc.*.gridX = -5
    doc.*.gridY = -5
    if grid.snapPoint(app, 33.5, 33.5, &sx, &sy) || sx != 33.5 || sy != 33.5 { return 194 }
    // Subdivisions 0 count as 1; the reach is 8 window pixels exactly.
    doc.*.gridX = 100
    doc.*.gridY = 100
    doc.*.gridOffsetX = 0
    doc.*.gridDivisions = 0
    if !grid.snapPoint(app, 8.0, 108.5, &sx, &sy) || sx != 0.0 || sy != 108.5 { return 195 }
    doc.*.view.zoom = 0.5
    if !grid.snapPoint(app, 15.0, 117.0, &sx, &sy) || sx != 0.0 || sy != 117.0 { return 196 }
    doc.*.view.zoom = 0.0
    if grid.snapPoint(app, 15.0, 117.0, &sx, &sy) || sx != 15.0 { return 197 }
    doc.*.view.zoom = 1.0
    // A guide across at 100, a grid line at 96 (spacing 16): from 98
    // both are 2 away, the guide wins; guides are left out while only
    // the grid is snapped to.
    doc.*.gridY = 16
    doc.*.gridDivisions = 1
    if !grid.addGuide(app, true, 100) { return 198 }
    if !grid.snapPoint(app, 0.5, 98.0, &sx, &sy) || sy != 96.0 { return 199 }
    grid.setSnapping(app, true, true)
    if !grid.snapPoint(app, 0.5, 98.0, &sx, &sy) || sy != 100.0 { return 200 }
    // Thirty-two of a kind, no more; removing what is not there does
    // nothing.
    var index: i32 = 0
    while index < 31 {
        if !grid.addGuide(app, true, index * 3) { return 201 }
        index += 1
    }
    if doc.*.guidesAcrossCount != 32 || grid.addGuide(app, true, 1000) || doc.*.guidesAcrossCount != 32 { return 202 }
    grid.removeGuide(app, true, 32)
    grid.removeGuide(app, true, 1000000)
    if doc.*.guidesAcrossCount != 32 { return 203 }
    grid.removeGuide(app, true, 31)
    if doc.*.guidesAcrossCount != 31 || doc.*.guidesAcross[30] != 87 || doc.*.guidesAcross[0] != 100 { return 204 }
    // Drawn with all of them in the list, then none.
    frames(app, 2)
    grid.removeGuides(app)
    grid.setSnapping(app, false, false)
    frames(app, 1)
    return 0
}

// The grid's section folded by its head: its parts are gone, the guides'
// move up; unfolded again.
fn checkFolding(app: *App) -> u8 {
    frames(app, 2)
    const show = grid.partArea(app, grid.PART_SHOW_GRID)
    const add = grid.partArea(app, grid.PART_ADD)
    if ui.isEmpty(show) || ui.isEmpty(add) { return 205 }
    const doc = api.document(app).?
    const shown = doc.*.showGrid
    const head = ui.rect(show.x, show.y - 26, show.width, 22)
    if !clickIn(app, head) || !ui.isEmpty(grid.partArea(app, grid.PART_SHOW_GRID)) || doc.*.showGrid != shown { return 206 }
    const add_now = grid.partArea(app, grid.PART_ADD)
    if ui.isEmpty(add_now) || add_now.y >= add.y { return 207 }
    if !clickIn(app, head) || ui.isEmpty(grid.partArea(app, grid.PART_SHOW_GRID)) || grid.partArea(app, grid.PART_ADD).y != add.y { return 208 }
    return 0
}

// The four channels' pictures of the last frame into `into` (44 x 28
// words each at most), or compared with what `into` holds.
fn copyPictures(app: *App, into: [*]u32) -> void {
    var channel: usize = 0
    while channel < channels.CHANNELS {
        const area = channels.thumbArea(app, channel)
        var y: i32 = 0
        while y < area.height {
            var x: i32 = 0
            while x < area.width {
                into[channel * 1232 + @intCast(usize, y * 44 + x)] = windowAt(app, area.x + x, area.y + y)
                x += 1
            }
            y += 1
        }
        channel += 1
    }
}

fn samePictures(app: *App, kept: [*]const u32) -> bool {
    var channel: usize = 0
    while channel < channels.CHANNELS {
        const area = channels.thumbArea(app, channel)
        if ui.isEmpty(area) { return false }
        var y: i32 = 0
        while y < area.height {
            var x: i32 = 0
            while x < area.width {
                if kept[channel * 1232 + @intCast(usize, y * 44 + x)] != windowAt(app, area.x + x, area.y + y) { return false }
                x += 1
            }
            y += 1
        }
        channel += 1
    }
    return true
}

// A group as the active node: what it shows (made by core/render.mlx, it
// has no pixels of its own) is counted and pictured; a channel taken out
// of it and put back by undo and redo.
fn checkGroup(app: *App) -> u8 {
    if !script.run(app, "new 100 70\n") { return 211 }
    if !fill(app, geom.rect(10, 10, 50, 40), 0xFF336699) || !fill(app, geom.rect(70, 0, 30, 70), 0xFFFFFFFF) { return 212 }
    const image = api.image(app).?
    const layer = api.activeNode(app).?
    // The layer's pictures (read from its device at the samples), kept to
    // compare with the group's (made by render a row at a time).
    frames(app, 2)
    const memory = app.*.allocator.alloc(4 * 44 * 28 * 4, 16)
    if memory == null { return 226 }
    const pictures: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    const first = channels.thumbArea(app, channels.RED)
    if ui.isEmpty(first) || first.width > 44 || first.height > 28 { return 227 }
    copyPictures(app, pictures)
    const group = ops.newLayer(image, node_module.GROUP, "Group", "New group")
    if group == null || !ops.move(image, layer, group.?, 0, "Move") { return 213 }
    image.*.active = group
    api.layersChanged(app)
    if !counted(app, 20) || histogram.pixelCount(app) != 4100 || histogram.countOf(app, histogram.CHANNEL_BLUE, 0x99) != 2000 || histogram.countOf(app, histogram.CHANNEL_LUMA, 255) != 2100 { return 214 }
    frames(app, 1)
    const again = channels.thumbArea(app, channels.RED)
    if again.width != first.width || again.height != first.height || !samePictures(app, pictures) { return 228 }
    unsafe { app.*.allocator.free(memory.?, 4 * 44 * 28 * 4, 16) }
    const alpha = channels.thumbArea(app, channels.ALPHA)
    // The white band at the right is opaque, the corner at the left's top
    // is not.
    if ui.isEmpty(alpha) || windowAt(app, ui.right(alpha) - 1, alpha.y + 1) != 0xFFFFFFFF || windowAt(app, alpha.x, alpha.y) != 0xFF000000 { return 215 }
    if !channels.setShown(app, channels.GREEN, false) || group.?.*.channels != 13 { return 216 }
    api.undo(app)
    if group.?.*.channels != channels.ALL { return 217 }
    api.redo(app)
    if group.?.*.channels != 13 || !channels.showAll(app) { return 218 }
    return 0
}

// A window so low that the grid's docker does not show all it has: what
// is out of sight cannot be pointed at, and the scroll bar dragged (there
// may be no wheel) brings it in.
fn checkScrolled(app: *App) -> u8 {
    if !script.run(app, "size 1024 400\n") { return 219 }
    frames(app, 3)
    const show = grid.partArea(app, grid.PART_SHOW_GRID)
    if ui.isEmpty(show) || !ui.isEmpty(grid.partArea(app, grid.PART_SNAP_GUIDES)) { return 220 }
    // The bar at the right of the docker, its thumb at the top.
    const bar_x = ui.right(show) + 10
    const top = show.y - 32
    start()
    add("drag ")
    addNumber(bar_x)
    add(" ")
    addNumber(top + 8)
    add(" ")
    addNumber(bar_x)
    add(" ")
    addNumber(top + 600)
    add("\n")
    if !play(app) { return 221 }
    frames(app, 1)
    const snap = grid.partArea(app, grid.PART_SNAP_GUIDES)
    if ui.isEmpty(snap) || !inside(snap, app.*.leftDock) || !ui.isEmpty(grid.partArea(app, grid.PART_SHOW_GRID)) { return 222 }
    if !clickIn(app, snap) || !grid.snapToGuides(app) { return 223 }
    grid.setSnapping(app, false, false)
    if !script.run(app, "size 1280 800\n") { return 224 }
    frames(app, 2)
    if ui.isEmpty(grid.partArea(app, grid.PART_SHOW_GRID)) { return 225 }
    return 0
}

// Snapping and the guides' list a great many times: the value arena does
// not grow.
fn checkSnapArena(app: *App) -> u8 {
    var loop_turns: turns.Turns = undefined
    turns.begin(&loop_turns, true, false)
    const arena = loop_turns.base
    const mark = turns.used(arena)
    grid.setSnapping(app, true, true)
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    var round: i32 = 0
    while round < 5000 {
        if !grid.addGuide(app, false, round) { return 209 }
        _ = grid.snapPoint(app, @floatFromInt(f64, round) * 0.37, @floatFromInt(f64, round) * -1.3, &sx, &sy)
        grid.removeGuide(app, false, 0)
        histogram.setChannel(app, @intCast(usize, round & 3))
        round += 1
    }
    grid.setSnapping(app, false, false)
    histogram.setChannel(app, histogram.CHANNEL_LUMA)
    if turns.used(arena) != mark { return 210 }
    return 0
}

// Frames one after another, the value arena given back before each as a
// window's loop does, each making the channels' pictures and the counts
// again (the image changed): each takes what the one before took.
fn steady(app: *App) -> u8 {
    const canvas = script.frameOf(app).?
    const image = api.image(app).?
    var loop_turns: turns.Turns = undefined
    turns.begin(&loop_turns, true, false)
    const arena = loop_turns.base
    const mark = turns.used(arena)
    var first: usize = 0
    var heap: usize = 0
    const made = channels.refreshes(app)
    const counts = histogram.computations(app)
    var round: usize = 0
    while round < 60 {
        turns.turn(&loop_turns)
        app.*.shell.*.clock += 16
        image_module.damageAll(image)
        api.redraw(app)
        loop.frame(app, canvas)
        const now = turns.used(arena) - mark
        if round == 4 {
            first = now
            heap = std.heap.liveBytes()
        }
        if round > 4 && now != first { return 110 }
        round += 1
    }
    turns.turn(&loop_turns)
    if turns.used(arena) != mark { return 111 }
    // Nor does the heap: the pictures' memory is made once and kept.
    if std.heap.liveBytes() != heap { return 113 }
    if channels.refreshes(app) < made + 60 || histogram.computations(app) < counts + 60 { return 112 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null {
        const shots = std.string.asSlice(named.?)
        shotsAt = @intFromPtr(shots.pointer)
        shotsLength = shots.length
    }
    const made = script.headless(allocator)
    if made == null { return 1 }
    const app = made.?
    if !script.run(app, "size 1280 800\n") { return 2 }
    if !docks.read(app, LAYOUT) { return 3 }
    // With no image the dockers say so and keep nothing.
    frames(app, 2)
    if !ui.isEmpty(channels.rowArea(app, channels.RED)) || !ui.isEmpty(histogram.chartArea(app)) || !ui.isEmpty(grid.partArea(app, grid.PART_SHOW_GRID)) { return 4 }
    var x: f64 = 0.0
    var y: f64 = 0.0
    grid.setSnapping(app, true, true)
    if grid.snapPoint(app, 1.5, 2.5, &x, &y) || x != 1.5 || y != 2.5 { return 5 }
    grid.setSnapping(app, false, false)

    var failed = checkChannels(app)
    if failed != 0 { return failed }
    failed = checkHistogram(app)
    if failed != 0 { return failed }
    failed = checkGrid(app)
    if failed != 0 { return failed }
    failed = guideRemoved(app)
    if failed != 0 { return failed }
    failed = checkAgainstPlain(app)
    if failed != 0 { return failed }
    failed = checkCountEdges(app)
    if failed != 0 { return failed }
    failed = checkHalfPictures(app)
    if failed != 0 { return failed }
    failed = checkReplaced(app)
    if failed != 0 { return failed }
    failed = checkSnapEdges(app)
    if failed != 0 { return failed }
    failed = checkFolding(app)
    if failed != 0 { return failed }
    failed = checkSnapArena(app)
    if failed != 0 { return failed }
    failed = checkGroup(app)
    if failed != 0 { return failed }
    failed = checkScrolled(app)
    if failed != 0 { return failed }

    // Pictures: an image with something in it, the three dockers showing.
    if !script.run(app, "new 320 240 FFFFFF\n") { return 120 }
    if !fill(app, geom.rect(40, 30, 160, 120), 0xFFD04030) || !fill(app, geom.rect(140, 90, 140, 110), 0xC03070E0) { return 121 }
    const doc = api.document(app).?
    doc.*.showGrid = true
    doc.*.gridX = 40
    doc.*.gridY = 40
    if !grid.addGuide(app, true, 120) || !grid.addGuide(app, false, 160) { return 122 }
    _ = channels.setShown(app, channels.BLUE, false)
    frames(app, 4)
    if !counted(app, 20) { return 123 }
    if !save(app, "docker-misc.png") || !docksOpaque(app) { return 124 }
    app.*.shell.*.lightness = 1024
    frames(app, 2)
    if !save(app, "docker-misc-light.png") || !docksOpaque(app) { return 125 }
    app.*.shell.*.lightness = 0
    if !script.run(app, "german\n") { return 126 }
    frames(app, 2)
    if !save(app, "docker-misc-german.png") || !docksOpaque(app) { return 127 }
    app.*.german = false
    if !script.run(app, "size 1024 768\n") { return 128 }
    frames(app, 2)
    if !save(app, "docker-misc-1024.png") || !docksOpaque(app) { return 129 }
    const alpha_row = channels.rowArea(app, channels.ALPHA)
    if ui.isEmpty(histogram.chartArea(app)) || ui.isEmpty(alpha_row) { return 130 }
    // The narrowest docks, and windows down to the smallest a script
    // makes and a layout pass's: nothing traps, the parts stay in their
    // dockers.
    if !docks.read(app, NARROW) || !script.run(app, "size 1024 768\n") { return 132 }
    frames(app, 2)
    if !save(app, "docker-misc-narrow.png") || !docksOpaque(app) { return 133 }
    if !inside(histogram.chartArea(app), app.*.rightDock) || !inside(grid.partArea(app, grid.PART_SHOW_GRID), app.*.leftDock) || !inside(channels.rowArea(app, channels.RED), app.*.rightDock) { return 134 }
    if !script.run(app, "size 400 300\nsize 64 64\n") { return 135 }
    frames(app, 2)
    var nowhere = view.layoutCanvas()
    api.redraw(app)
    loop.frame(app, &nowhere)
    if !docks.read(app, LAYOUT) || !script.run(app, "size 1024 768\n") { return 136 }
    frames(app, 2)

    // The pointer where no widget is (under the channels' rows): no
    // tooltip comes up halfway through the frames.
    start()
    add("pointer ")
    addNumber(alpha_row.x + alpha_row.width / 2)
    add(" ")
    addNumber(ui.bottom(alpha_row) + 6)
    add("\n")
    if !play(app) { return 131 }
    failed = steady(app)
    if failed != 0 { return failed }
    return 13
}
