// nebula's memory between runs (app/settings.mlx, app/shortcuts.mlx,
// app/recent.mlx) on headless Apps that get an environment of the test's
// own: XDG_CONFIG_HOME, XDG_STATE_HOME and HOME in a directory it makes
// under the current one (nebula-58). Checked: every setting's default
// without a file; settings changed, held to their ranges and saved, read
// back by a second App; a hand-written file (comments, keys and groups
// nobody knows, numbers that are none, values out of range, a CR line
// end) read to defaults and held values and written back with what it
// did not know, the same again when read and written once more; texts
// kept and read back byte for byte (line feeds, "=", not ASCII, blanks
// at the ends, every byte value, 4 KiB) and the keys and values refused;
// shortcuts on the registries' rows (the brush tool, the actions when
// there are any): the default, set, "none", text that is no shortcut,
// reset, the default not kept, conflicts (a mark's Shift, a letter's),
// the [Shortcuts] lines read back, resetAll; the recent files (order,
// the limit, a path again to the front, remove, clear, kept across Apps,
// a file gone); a configuration folder that cannot be made (a file in
// the way) and no environment at all: saving fails, nothing crashes; no
// value-arena growth over 1000 lookups of shortcuts; the heap the same
// over 50 loads and saves. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const state = @import("../app/state.mlx")
const script = @import("../app/script.mlx")
const shell_module = @import("../app/shell.mlx")
const keys = @import("../app/keys.mlx")
const settings = @import("../app/settings.mlx")
const shortcuts = @import("../app/shortcuts.mlx")
const recent = @import("../app/recent.mlx")
const tools = @import("../tools/registry.mlx")
const actions = @import("../actions/registry.mlx")
const smoothing = @import("../brush/smoothing.mlx")
const text_io = @import("../io/text.mlx")

const App = state.App

// The current directory, and paths under its nebula-58 (NUL after each).
var cwd: [4096]u8 = undefined
var cwdLength: usize = 0
var paths: [8][1024]u8 = undefined

// The environments: "NAME=value" texts with a NUL after each, and the
// lists of their addresses that end with a null entry.
var texts: [3][4096]u8 = undefined
var lists: [3][4]usize = undefined

// An action of the test's own (not in the registry): its shortcut comes
// from its row or from the settings' [Shortcuts] line of its key.
fn nothing(app: *App) -> void {}

const TEST_ACTIONS = [1]state.Action{
    state.Action.{ .key = "my_test_action", .name = "Test", .german = "Test", .shortcut = "Ctrl+J", .menu = 0, .submenu = "", .flags = 0, .run = nothing, .checked = null, .enabled = null },
}

// cwd/nebula-58/rest ("": the folder itself) into paths[slot], with a NUL
// after it.
fn where(slot: usize, rest: []const u8) -> []const u8 {
    const bytes: [*]u8 = &paths[slot]
    const current: [*]const u8 = &cwd
    var length = std.text.append(bytes, 0, 1023, current[0..cwdLength])
    length = std.text.append(bytes, length, 1023, "/nebula-58")
    if rest.length > 0 {
        length = std.text.appendByte(bytes, length, 1023, 47)
        length = std.text.append(bytes, length, 1023, rest)
    }
    bytes[length] = 0
    return bytes[0..length]
}

fn variable(bytes: [*]u8, at: usize, name: []const u8, rest: []const u8) -> usize {
    const current: [*]const u8 = &cwd
    var length = std.text.append(bytes, at, 4095, name)
    length = std.text.append(bytes, length, 4095, current[0..cwdLength])
    length = std.text.append(bytes, length, 4095, "/nebula-58/")
    length = std.text.append(bytes, length, 4095, rest)
    return std.text.appendByte(bytes, length, 4095, 0)
}

// Environment `which`: the configuration in nebula-58/`config`, the state
// in nebula-58/`kept`, the home nebula-58/home.
fn environment(which: usize, config: []const u8, kept: []const u8) -> [*][*]const u8 {
    const bytes: [*]u8 = &texts[which]
    lists[which][0] = @intFromPtr(bytes)
    var length = variable(bytes, 0, "XDG_CONFIG_HOME=", config)
    lists[which][1] = @intFromPtr(bytes + length)
    length = variable(bytes, length, "XDG_STATE_HOME=", kept)
    lists[which][2] = @intFromPtr(bytes + length)
    length = variable(bytes, length, "HOME=", "home")
    lists[which][3] = 0
    unsafe { return @ptrCast([*][*]const u8, &lists[which]) }
}

fn fresh(allocator: std.allocator.Allocator, entries: [*][*]const u8) -> ?*App {
    const made = script.headless(allocator)
    if made == null { return null }
    shell_module.setEnvironment(made.?.*.shell, entries)
    return made
}

fn same(left: []const u8, right: []const u8) -> bool { return std.text.same(left, right) }

fn sameShortcut(left: keys.Shortcut, right: keys.Shortcut) -> bool {
    return left.modifiers == right.modifiers && left.character == right.character && left.code == right.code
}

fn makeFile(path: []const u8, text: []const u8) -> bool {
    return std.fs.writeFile(path.pointer, text.pointer, text.length, 420)
}

// A file's text, read whole into `contents` (given back by the next one).
var contents: text_io.Contents = undefined
var holding: bool = false

fn fileText(allocator: std.allocator.Allocator, path: []const u8) -> []const u8 {
    if holding { text_io.freeFile(&contents) }
    holding = text_io.readFile(allocator, path, &contents) == text_io.FileStatus.ok
    if !holding { return "" }
    return contents.bytes[0..contents.length]
}

fn has(text: []const u8, part: []const u8) -> bool { return std.text.contains(text, part) }

// Where `part` is in `text` (text.length when it is not).
fn place(text: []const u8, part: []const u8) -> usize { return std.text.find(text, part) }

const HAND_LINES: usize = 45

const HAND = [45][]const u8{
    "# Written by hand: comments, what a newer version knows, mistakes.",
    "   # an indented comment",
    "top_level = kept before groups",
    "",
    "[General]",
    "undo_steps = 99999999999",
    "autosave_minutes = soon",
    "recent_files = -4",
    "language = de",
    "theme = purple",
    "confirm_close = no",
    "future_option = 42",
    "this line has no equals sign",
    "= a value without a key",
    "[Canvas]",
    "checker_size = 1",
    "checker_light = 0A0B0C",
    "checker_dark = #zzzzzz",
    "pixel_grid_zoom = 800",
    "cursor_cross = YES",
    "[Painting]",
    "smoothing = Weighted",
    "smoothing_distance = 0",
    "image_width = 640",
    "image_height =",
    "image_background = 00000000",
    "[Tablet]",
    "pressure_curve = 0,0;2,2",
    "[Files]",
    "save_format = PNG!",
    "jpeg_quality = 101",
    "png_compression = 3\r",
    "[Plugins]",
    "alpha = one = two",
    "beta =",
    "gamma = 1",
    "# a comment in a group nobody here knows",
    "gamma = 2",
    "[Shortcuts]",
    "tool:brush = P",
    "my_test_action = Ctrl+K",
    "future_action = Ctrl+Alt+F",
    "[State]",
    "docks = left\\nright",
    "a_key_that_is_much_too_long_to_be_kept = x",
}

// The 4 KiB value: every byte value, a space first.
var big: [4097]u8 = undefined

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    if std.fs.getWorkingDirectory(&cwd, 4096) <= 0 { return 1 }
    const current: [*]const u8 = &cwd
    cwdLength = std.text.cString(current).length
    if cwdLength == 0 || cwdLength > 900 { return 1 }
    _ = std.fs.removeTree(where(0, "").pointer)
    // The test's action, kept in heap memory as a registry keeps its rows.
    const action_memory = allocator.alloc(@sizeOf(state.Action), 16)
    if action_memory == null { return 2 }
    const testAction: *state.Action = unsafe { @ptrCast(*state.Action, action_memory.?) }
    testAction.* = TEST_ACTIONS[0]
    if !std.fs.makeDirectories(where(0, "home"), 493) || !std.fs.makeDirectories(where(0, "files"), 493) { return 2 }

    // -----------------------------------------------------------------
    // Without a file: every default; reading writes nothing.
    const first_environment = environment(0, "config", "state")
    const made = fresh(allocator, first_environment)
    if made == null { return 3 }
    const app = made.?
    if settings.load(app) { return 3 }
    const prefs = settings.get(app)
    if prefs.*.language != settings.LANGUAGE_SYSTEM || prefs.*.theme != settings.THEME_SYSTEM || prefs.*.undoSteps != 200 || prefs.*.autosaveMinutes != 5 || prefs.*.recentFiles != 20 || !prefs.*.confirmClose { return 4 }
    if prefs.*.groundBrightness != 25 || prefs.*.checkerSize != 16 || prefs.*.checkerLight != 0xFFFFFFFF || prefs.*.checkerDark != 0xFFCCCCCC || prefs.*.pixelGridZoom != 2400 || !prefs.*.antialiasOutline || !prefs.*.cursorOutline || prefs.*.cursorCross || prefs.*.wheelZoom != settings.WHEEL_ZOOMS { return 5 }
    if prefs.*.smoothing != smoothing.BASIC || prefs.*.smoothingDistance != 15 || prefs.*.simulatePressure || prefs.*.imageWidth != 1920 || prefs.*.imageHeight != 1080 || prefs.*.imageResolution != 300 || prefs.*.imageBackground != 0xFFFFFFFF { return 6 }
    if !same(settings.lineText(&prefs.*.pressureCurve), "0,0;1,1") || !same(settings.lineText(&prefs.*.saveFormat), "ora") || prefs.*.pngCompression != 6 || prefs.*.jpegQuality != 90 || !prefs.*.keepBackup { return 7 }
    if settings.text(app, "docks").length != 0 || recent.count(app) != 0 || recent.at(app, 0).length != 0 || recent.exists(app, 0) { return 8 }
    const conf_path = where(1, "config/mlx/nebula.conf")
    if std.fs.exists(conf_path.pointer) { return 9 }
    // Every setting is described for a dialog, in both languages.
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const described = settings.settingAt(index)
        if described == null || described.?.key.length == 0 || described.?.name.length == 0 || described.?.german.length == 0 || settings.groupName(described.?.group).length == 0 { return 10 }
        index += 1
    }
    if settings.settingAt(settings.SETTING_COUNT) != null { return 10 }

    // -----------------------------------------------------------------
    // Changed, held to the ranges, saved; a second App reads them.
    prefs.*.undoSteps = 350
    prefs.*.theme = settings.THEME_DARK
    prefs.*.language = settings.LANGUAGE_GERMAN
    prefs.*.smoothing = smoothing.STABILIZER
    prefs.*.imageBackground = 0x80102030
    prefs.*.checkerDark = 0xFF000000
    prefs.*.confirmClose = false
    prefs.*.cursorCross = true
    prefs.*.wheelZoom = settings.CONTROL_WHEEL_ZOOMS
    prefs.*.jpegQuality = 500
    prefs.*.checkerSize = 0
    prefs.*.recentFiles = 1000
    if !settings.setLine(&prefs.*.pressureCurve, "0,0;0.5,0.25;1.000,1") || !settings.setLine(&prefs.*.saveFormat, "png") { return 11 }
    // (Too long for a Line: refused, the line as it was.)
    index = 0
    while index < 256 {
        big[index] = 48
        index += 1
    }
    if settings.setLine(&prefs.*.saveFormat, big[0..256]) || !same(settings.lineText(&prefs.*.saveFormat), "png") { return 11 }
    if !settings.changed(app) { return 12 }
    if prefs.*.jpegQuality != 100 || prefs.*.checkerSize != 2 || prefs.*.recentFiles != 100 { return 14 }
    if !std.fs.exists(conf_path.pointer) { return 15 }
    const second_made = fresh(allocator, first_environment)
    if second_made == null { return 16 }
    const second = second_made.?
    const read = settings.get(second)
    if read.*.undoSteps != 350 || read.*.theme != settings.THEME_DARK || read.*.language != settings.LANGUAGE_GERMAN || read.*.smoothing != smoothing.STABILIZER || read.*.imageBackground != 0x80102030 || read.*.checkerDark != 0xFF000000 { return 17 }
    if read.*.confirmClose || !read.*.cursorCross || read.*.wheelZoom != settings.CONTROL_WHEEL_ZOOMS || read.*.jpegQuality != 100 || read.*.checkerSize != 2 || read.*.recentFiles != 100 { return 18 }
    if !same(settings.lineText(&read.*.pressureCurve), "0,0;0.5,0.25;1.000,1") || !same(settings.lineText(&read.*.saveFormat), "png") { return 19 }
    // A curve or a format key that is none goes back to its default.
    if !settings.setLine(&prefs.*.pressureCurve, "0,0;1.5,1") || !settings.setLine(&prefs.*.saveFormat, "") { return 20 }
    prefs.*.smoothing = 9
    prefs.*.recentFiles = 20
    if !settings.changed(app) { return 20 }
    if !same(settings.lineText(&prefs.*.pressureCurve), "0,0;1,1") || !same(settings.lineText(&prefs.*.saveFormat), "ora") || prefs.*.smoothing != smoothing.BASIC { return 21 }
    // The second App reads the file again when asked to.
    if !settings.load(second) || !same(settings.lineText(&read.*.saveFormat), "ora") || read.*.undoSteps != 350 { return 22 }
    const written = fileText(allocator, conf_path)
    if !has(written, "[General]\n") || !has(written, "undo_steps = 350\n") || !has(written, "theme = dark\n") || !has(written, "image_background = 80102030\n") || !has(written, "checker_dark = 000000\n") || !has(written, "smoothing = basic\n") || !has(written, "confirm_close = off\n") || !has(written, "wheel_zoom = ctrl+wheel\n") { return 23 }
    if has(written, "[Shortcuts]") || has(written, "[State]") { return 24 }

    // -----------------------------------------------------------------
    // A file written by hand.
    if !std.fs.makeDirectories(where(2, "handmade/mlx"), 493) { return 25 }
    const hand_path = where(3, "handmade/mlx/nebula.conf")
    var hand = std.ArrayList(u8).init(allocator)
    index = 0
    while index < HAND_LINES {
        if !hand.appendSlice(HAND[index]) || !hand.append(10) { return 25 }
        index += 1
    }
    if !makeFile(hand_path, hand.items()) { return 25 }
    hand.deinit()
    const hand_environment = environment(1, "handmade", "state")
    const third_made = fresh(allocator, hand_environment)
    if third_made == null { return 26 }
    const third = third_made.?
    if !settings.load(third) { return 26 }
    const handmade = settings.get(third)
    // Out of range: held; no number: the default; a word in another case.
    if handmade.*.undoSteps != 10000 || handmade.*.autosaveMinutes != 5 || handmade.*.recentFiles != 0 || handmade.*.language != settings.LANGUAGE_GERMAN || handmade.*.theme != settings.THEME_SYSTEM || handmade.*.confirmClose { return 27 }
    if handmade.*.checkerSize != 2 || handmade.*.checkerLight != 0xFF0A0B0C || handmade.*.checkerDark != 0xFFCCCCCC || handmade.*.pixelGridZoom != 800 || !handmade.*.cursorCross { return 28 }
    if handmade.*.smoothing != smoothing.WEIGHTED || handmade.*.smoothingDistance != 1 || handmade.*.imageWidth != 640 || handmade.*.imageHeight != 1080 || handmade.*.imageBackground != 0 { return 29 }
    if !same(settings.lineText(&handmade.*.pressureCurve), "0,0;1,1") || !same(settings.lineText(&handmade.*.saveFormat), "ora") || handmade.*.jpegQuality != 100 || handmade.*.pngCompression != 3 { return 30 }
    if !same(settings.text(third, "docks"), "left\nright") || settings.text(third, "a_key_that_is_much_too_long_to_be_kept").length != 0 { return 31 }
    const plugins_alpha = settings.kept(third, "Plugins", "alpha")
    const plugins_gamma = settings.kept(third, "Plugins", "gamma")
    if plugins_alpha == null || !same(plugins_alpha.?, "one = two") || plugins_gamma == null || !same(plugins_gamma.?, "2") { return 32 }
    if !settings.save(third) { return 33 }
    const again = fileText(allocator, hand_path)
    if !has(again, "top_level = kept before groups\n") || place(again, "top_level") > place(again, "[General]") { return 34 }
    const future = place(again, "future_option = 42\n")
    if future >= again.length || future < place(again, "[General]") || future > place(again, "[Canvas]") { return 35 }
    const plugins = place(again, "\n[Plugins]\n")
    if plugins >= again.length || place(again, "alpha = one = two\n") < plugins || !has(again, "beta = \n") || !has(again, "gamma = 2\n") || has(again, "gamma = 1") { return 36 }
    if !has(again, "\n[Shortcuts]\ntool:brush = P\nmy_test_action = Ctrl+K\nfuture_action = Ctrl+Alt+F\n") || !has(again, "\n[State]\ndocks = left\\nright\n") { return 37 }
    if has(again, "# a comment") || has(again, "no equals sign") || has(again, "without a key") || has(again, "much_too_long") || has(again, "\r") { return 38 }
    if !has(again, "undo_steps = 10000\n") || !has(again, "theme = system\n") || !has(again, "checker_dark = CCCCCC\n") || !has(again, "image_background = 00000000\n") || !has(again, "pressure_curve = 0,0;1,1\n") || !has(again, "save_format = ora\n") || !has(again, "png_compression = 3\n") { return 39 }
    // Read and written once more, the file stays what it is.
    const fourth_made = fresh(allocator, hand_environment)
    if fourth_made == null || !settings.load(fourth_made.?) || !settings.save(fourth_made.?) { return 40 }
    var once = std.ArrayList(u8).init(allocator)
    if !once.appendSlice(again) { return 40 }
    if !same(fileText(allocator, hand_path), once.items()) { return 41 }
    once.deinit()

    // -----------------------------------------------------------------
    // Texts kept for other parts, read back byte for byte.
    index = 0
    while index < 4097 {
        big[index] = @intCast(u8, (index + 32) & 255)
        index += 1
    }
    const blanks = "  \\back\\slashes\\, a CR\r and a tab at the end\t"
    if !settings.setText(app, "docks", "left:layers,brushes\nright:color\n") || !settings.setText(app, "equals", "a=b = c==") || !settings.setText(app, "unicode", "Grüße, Ölfarbe – 日本語 ✓") { return 42 }
    if !settings.setText(app, "blanks", blanks) || !settings.setText(app, "big", big[0..4096]) || !settings.setText(app, "k234567890123456789012345678901", "the longest key") { return 43 }
    if settings.setText(app, "", "x") || settings.setText(app, "k2345678901234567890123456789012", "x") || settings.setText(app, "a=b", "x") || settings.setText(app, "#c", "x") || settings.setText(app, "[d", "x") { return 44 }
    if settings.setText(app, " e", "x") || settings.setText(app, "f ", "x") || settings.setText(app, "g\nh", "x") || settings.setText(app, "too_big", big[0..4097]) || settings.text(app, "too_big").length != 0 { return 45 }
    // A value that is a text kept already (its bytes move while it is
    // copied).
    if !settings.setText(app, "copy", settings.text(app, "big")) || !same(settings.text(app, "copy"), big[0..4096]) { return 46 }
    if !settings.setText(app, "copy", settings.text(app, "copy")[0..100]) || !same(settings.text(app, "copy"), big[0..100]) { return 46 }
    const texts_made = fresh(allocator, first_environment)
    if texts_made == null { return 47 }
    const reader = texts_made.?
    if !same(settings.text(reader, "docks"), "left:layers,brushes\nright:color\n") || !same(settings.text(reader, "equals"), "a=b = c==") || !same(settings.text(reader, "unicode"), "Grüße, Ölfarbe – 日本語 ✓") { return 48 }
    if !same(settings.text(reader, "blanks"), blanks) || !same(settings.text(reader, "big"), big[0..4096]) || !same(settings.text(reader, "k234567890123456789012345678901"), "the longest key") || !same(settings.text(reader, "copy"), big[0..100]) { return 49 }
    // The settings are what they were.
    if settings.get(reader).*.undoSteps != 350 { return 50 }
    // "" keeps nothing.
    if !settings.setText(reader, "equals", "") || settings.text(reader, "equals").length != 0 { return 51 }
    if !settings.load(app) || settings.text(app, "equals").length != 0 || !same(settings.text(app, "docks"), "left:layers,brushes\nright:color\n") { return 52 }

    // -----------------------------------------------------------------
    // Shortcuts, on the registries' rows.
    const brush_found = tools.byKey("brush")
    if brush_found == null { return 53 }
    const brush = brush_found.?
    const own = keys.parse(brush.*.shortcut)
    if !sameShortcut(shortcuts.ofTool(app, brush), own) || !sameShortcut(shortcuts.ofAction(app, testAction), keys.parse("Ctrl+J")) { return 54 }
    if !shortcuts.set(app, "tool:brush", "ctrl+alt+f7") || !sameShortcut(shortcuts.ofTool(app, brush), keys.parse("Ctrl+Alt+F7")) { return 55 }
    const noted = settings.kept(app, settings.SHORTCUTS, "tool:brush")
    if noted == null || !same(noted.?, "Ctrl+Alt+F7") { return 56 }
    const holder = shortcuts.conflict(app, keys.parse("Ctrl+Alt+F7"), "")
    if holder == null || !same(holder.?, "tool:brush") || shortcuts.conflict(app, keys.parse("Ctrl+Alt+F7"), "tool:brush") != null { return 57 }
    const freed = shortcuts.conflict(app, own, "")
    if freed != null && same(freed.?, "tool:brush") { return 58 }
    if shortcuts.conflict(app, keys.none(), "") != null { return 58 }
    // "none": no shortcut at all.
    if !shortcuts.set(app, "tool:brush", "none") || !keys.isNone(shortcuts.ofTool(app, brush)) { return 59 }
    const none_noted = settings.kept(app, settings.SHORTCUTS, "tool:brush")
    if none_noted == null || !same(none_noted.?, "none") { return 59 }
    // Text that names no shortcut, keys that name nothing: refused.
    if shortcuts.set(app, "tool:brush", "Ctrl+") || shortcuts.set(app, "tool:no_such_tool", "B") || shortcuts.set(app, "no_such_action_58", "B") || !keys.isNone(shortcuts.ofTool(app, brush)) { return 60 }
    // Its own again.
    if !shortcuts.reset(app, "tool:brush") || !sameShortcut(shortcuts.ofTool(app, brush), own) || shortcuts.reset(app, "tool:brush") || settings.kept(app, settings.SHORTCUTS, "tool:brush") != null { return 61 }
    if !shortcuts.set(app, "tool:brush", brush.*.shortcut) || settings.kept(app, settings.SHORTCUTS, "tool:brush") != null { return 62 }
    // A mark's Shift is the way to it: "[" and "Shift+[" are one press; a
    // letter's is not.
    if !shortcuts.set(app, "tool:brush", "Shift+[") { return 63 }
    const mark = shortcuts.conflict(app, keys.parse("["), "")
    if mark == null || !same(mark.?, "tool:brush") { return 63 }
    if !shortcuts.set(app, "tool:brush", "Shift+Q") || shortcuts.conflict(app, keys.parse("Q"), "") != null { return 64 }
    // Kept in the file, read by another App.
    if !shortcuts.set(app, "tool:brush", "Alt+F5") { return 65 }
    const keys_made = fresh(allocator, first_environment)
    if keys_made == null { return 66 }
    const other = keys_made.?
    if !sameShortcut(shortcuts.ofTool(other, brush), keys.parse("Alt+F5")) || !sameShortcut(shortcuts.ofAction(other, testAction), keys.parse("Ctrl+J")) { return 67 }
    // The hand-written file's lines: a tool's and an action's.
    if !sameShortcut(shortcuts.ofTool(third, brush), keys.parse("P")) || !sameShortcut(shortcuts.ofAction(third, testAction), keys.parse("Ctrl+K")) { return 68 }
    // An action of the registry, when it has one with a shortcut.
    const action_count = actions.count()
    index = 0
    while index < action_count {
        const action = actions.at(index)
        if action != null && !keys.isNone(keys.parse(action.?.*.shortcut)) {
            const action_own = keys.parse(action.?.*.shortcut)
            if !sameShortcut(shortcuts.ofAction(other, action.?), action_own) { return 69 }
            if !shortcuts.set(other, action.?.*.key, "Ctrl+Alt+F8") || !sameShortcut(shortcuts.ofAction(other, action.?), keys.parse("Ctrl+Alt+F8")) { return 70 }
            if !shortcuts.set(other, "tool:brush", action.?.*.shortcut) { return 71 }
            const tool_holder = shortcuts.conflict(other, action_own, action.?.*.key)
            const action_holder = shortcuts.conflict(other, keys.parse("Ctrl+Alt+F8"), "tool:brush")
            if tool_holder == null || !same(tool_holder.?, "tool:brush") || action_holder == null || !same(action_holder.?, action.?.*.key) { return 72 }
            if !shortcuts.reset(other, action.?.*.key) || !sameShortcut(shortcuts.ofAction(other, action.?), action_own) { return 73 }
            break
        }
        index += 1
    }
    shortcuts.resetAll(other)
    if !sameShortcut(shortcuts.ofTool(other, brush), own) || settings.kept(other, settings.SHORTCUTS, "tool:brush") != null { return 74 }
    if !settings.load(app) || !sameShortcut(shortcuts.ofTool(app, brush), own) { return 75 }

    // -----------------------------------------------------------------
    // No value arena taken by the lookups the loop makes at every key.
    const arena = turns.locate()
    _ = shortcuts.ofAction(app, testAction)
    _ = shortcuts.ofTool(app, brush)
    const before = turns.used(arena)
    var looked: usize = 0
    var round: usize = 0
    while round < 1000 {
        if !keys.isNone(shortcuts.ofAction(app, testAction)) { looked += 1 }
        if keys.matches(shortcuts.ofTool(app, brush), 0, 0, "b") { looked += 1 }
        var row: usize = 0
        while row < action_count {
            const action = actions.at(row)
            if action != null { _ = shortcuts.ofAction(app, action.?) }
            row += 1
        }
        round += 1
    }
    const grown = turns.used(arena) - before
    if grown > 512 || looked < 1000 { return 76 }

    // -----------------------------------------------------------------
    // The recent files.
    const a = where(4, "files/a.png")
    const b = where(5, "files/b.png")
    const c = where(6, "files/c.png")
    const d = where(7, "files/d.png")
    if !makeFile(a, "a") || !makeFile(b, "b") || !makeFile(c, "c") || !makeFile(d, "d") { return 77 }
    if recent.count(app) != 0 { return 78 }
    if !recent.add(app, a) || !recent.add(app, b) || !recent.add(app, c) { return 79 }
    if recent.count(app) != 3 || !same(recent.at(app, 0), c) || !same(recent.at(app, 1), b) || !same(recent.at(app, 2), a) || recent.at(app, 3).length != 0 { return 80 }
    // Again: to the front, not twice.
    if !recent.add(app, a) || recent.count(app) != 3 || !same(recent.at(app, 0), a) || !same(recent.at(app, 1), c) || !same(recent.at(app, 2), b) { return 81 }
    if recent.remove(app, where(1, "files/none.png")) || recent.add(app, "") || recent.add(app, "two\nlines") || recent.count(app) != 3 { return 82 }
    // The limit: what is beyond it goes.
    prefs.*.recentFiles = 3
    if !settings.changed(app) { return 83 }
    if !recent.add(app, d) || recent.count(app) != 3 || !same(recent.at(app, 0), d) || !same(recent.at(app, 1), a) || !same(recent.at(app, 2), c) { return 84 }
    // A path of the list itself.
    if !recent.add(app, recent.at(app, 2)) || !same(recent.at(app, 0), c) || !same(recent.at(app, 1), d) || !same(recent.at(app, 2), a) { return 85 }
    if !recent.remove(app, recent.at(app, 2)) || recent.count(app) != 2 || !same(recent.at(app, 0), c) || !same(recent.at(app, 1), d) { return 86 }
    // Kept for another App; a file that is gone is not offered.
    const recent_made = fresh(allocator, first_environment)
    if recent_made == null { return 87 }
    const later = recent_made.?
    if recent.count(later) != 2 || !same(recent.at(later, 0), c) || !same(recent.at(later, 1), d) || !recent.exists(later, 0) || !recent.exists(later, 1) { return 88 }
    if !std.fs.delete(d.pointer) || !recent.exists(later, 0) || recent.exists(later, 1) || recent.count(later) != 2 || recent.exists(later, 2) { return 89 }
    // A smaller limit lists fewer at once.
    settings.get(later).*.recentFiles = 1
    if recent.count(later) != 1 || recent.at(later, 1).length != 0 { return 90 }
    settings.get(later).*.recentFiles = 20
    if !settings.changed(later) || recent.count(later) != 2 { return 90 }
    if !recent.clear(later) || recent.count(later) != 0 { return 91 }
    const cleared_made = fresh(allocator, first_environment)
    if cleared_made == null || recent.count(cleared_made.?) != 0 { return 92 }
    // A limit of 0 keeps none.
    settings.get(later).*.recentFiles = 0
    if !settings.changed(later) || !recent.add(later, a) || recent.count(later) != 0 { return 93 }
    settings.get(later).*.recentFiles = 20
    if !settings.changed(later) || !recent.load(later) || recent.count(later) != 0 { return 93 }

    // -----------------------------------------------------------------
    // A folder that cannot be made (a file where "mlx" would be), and no
    // environment at all: nothing is written, nothing crashes.
    if !std.fs.makeDirectories(where(1, "blocked"), 493) || !makeFile(where(1, "blocked/mlx"), "in the way") { return 94 }
    const blocked_made = fresh(allocator, environment(2, "blocked", "blocked"))
    if blocked_made == null { return 95 }
    const blocked = blocked_made.?
    if settings.load(blocked) || settings.get(blocked).*.undoSteps != 200 { return 95 }
    if settings.save(blocked) || settings.changed(blocked) { return 96 }
    if !settings.setText(blocked, "key", "value") || !same(settings.text(blocked, "key"), "value") { return 97 }
    if !shortcuts.set(blocked, "tool:brush", "Alt+F6") || !sameShortcut(shortcuts.ofTool(blocked, brush), keys.parse("Alt+F6")) { return 98 }
    if recent.add(blocked, a) || recent.count(blocked) != 1 || recent.clear(blocked) { return 99 }
    if std.fs.isDirectory(where(1, "blocked/mlx").pointer) || !same(fileText(allocator, where(1, "blocked/mlx")), "in the way") { return 100 }
    const bare_made = script.headless(allocator)
    if bare_made == null { return 101 }
    const bare = bare_made.?
    if settings.load(bare) || settings.save(bare) || settings.get(bare).*.jpegQuality != 90 || recent.add(bare, a) || recent.count(bare) != 1 { return 101 }
    if !settings.setText(bare, "key", "value") || !same(settings.text(bare, "key"), "value") { return 102 }

    // -----------------------------------------------------------------
    // The heap the same over 50 loads and saves (of the settings and of
    // the recent files), with the shortcuts worked out again after each
    // (after a round as they go, so that what is kept is as long).
    if !settings.load(app) || !settings.save(app) || !recent.load(app) || !recent.add(app, a) || !recent.add(app, c) { return 103 }
    _ = shortcuts.ofTool(app, brush)
    const live = std.heap.liveBytes()
    round = 0
    while round < 50 {
        if !settings.load(app) || !settings.save(app) { return 104 }
        if !recent.load(app) || !recent.add(app, if round % 2 == 0 { a } else { c }) { return 105 }
        if !sameShortcut(shortcuts.ofTool(app, brush), own) { return 106 }
        round += 1
    }
    if std.heap.liveBytes() != live { return 107 }

    if holding { text_io.freeFile(&contents) }
    if !std.fs.removeTree(where(0, "").pointer) { return 108 }
    return 13
}
