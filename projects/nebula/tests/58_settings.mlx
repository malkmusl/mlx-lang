// nebula's memory between runs (app/settings.mlx, app/shortcuts.mlx,
// app/recent.mlx) on headless Apps that get an environment of the test's
// own: XDG_CONFIG_HOME, XDG_STATE_HOME and HOME in a directory it makes
// under the current one (nebula-58). Checked: every setting's default
// without a file; settings changed, held to their ranges and saved, read
// back by a second App; a hand-written file (comments, keys and groups
// nobody knows, numbers that are none, values out of range, a CR line
// end) read to defaults and held values and written back with what it
// did not know, the same again when read and written once more; texts
// kept and read back byte for byte (line feeds, "=", not ASCII, blanks
// at the ends, every byte value, 4 KiB) and the keys and values refused;
// shortcuts on the registries' rows (the brush tool, the actions when
// there are any): the default, set, "none", text that is no shortcut,
// reset, the default not kept, conflicts (a mark's Shift, a letter's),
// the [Shortcuts] lines read back, resetAll; the recent files (order,
// the limit, a path again to the front, remove, clear, kept across Apps,
// a file gone); a configuration folder that cannot be made (a file in
// the way) and no environment at all: saving fails, nothing crashes; no
// value-arena growth over 1000 lookups of shortcuts; the heap the same
// over 50 loads and saves. Then (109 on) every one of the 27 settings
// away from its default, saved and read back, its line in the file
// written out here a second way, and what each row says of itself
// (a default in its range, a choice's words); numbers, colours, switches,
// words, curves and format keys at and beyond their edges (2^32, more
// digits than a u64 holds, signs, blanks, hexadecimal case, alpha 0, 255
// bytes and 256); an empty file, a file of every byte value, a file
// without a last line feed, a setting in another group, 3000 lines
// nobody knows; the groups kept for other parts (keep, forget, what they
// refuse, the generation); texts with blanks only, backslashes, comment
// and group marks, keys not in ASCII, 64 values of 1000 bytes; shortcuts
// written in other ways (lower case, "Ctrl++", F12, Return, "", unreadable
// text in the file, NONE) and conflicts that are not; recent files at
// their most (100 of 150), paths of 4095 and 4096 bytes, a list written
// by hand (CR LF, empty and duplicate lines, a line too long, no last
// line feed), removed to nothing; no value-arena growth over 1000
// lookups of everything a frame asks, at most 16 KiB a save and 4 KiB a
// load; the heap the same over 50 rounds of all of it. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const state = @import("../app/state.mlx")
const script = @import("../app/script.mlx")
const shell_module = @import("../app/shell.mlx")
const keys = @import("../app/keys.mlx")
const settings = @import("../app/settings.mlx")
const shortcuts = @import("../app/shortcuts.mlx")
const recent = @import("../app/recent.mlx")
const tools = @import("../tools/registry.mlx")
const actions = @import("../actions/registry.mlx")
const smoothing = @import("../brush/smoothing.mlx")
const text_io = @import("../io/text.mlx")

const App = state.App

// The current directory, and paths under its nebula-58 (NUL after each).
var cwd: [4096]u8 = undefined
var cwdLength: usize = 0
var paths: [8][1024]u8 = undefined

// The environments: "NAME=value" texts with a NUL after each, and the
// lists of their addresses that end with a null entry.
var texts: [8][4096]u8 = undefined
var lists: [8][4]usize = undefined

// An action of the test's own (not in the registry): its shortcut comes
// from its row or from the settings' [Shortcuts] line of its key.
fn nothing(app: *App) -> void {}

const TEST_ACTIONS = [1]state.Action{
    state.Action.{ .key = "my_test_action", .name = "Test", .german = "Test", .shortcut = "Ctrl+J", .menu = 0, .submenu = "", .flags = 0, .run = nothing, .checked = null, .enabled = null },
}

// cwd/nebula-58/rest ("": the folder itself) into paths[slot], with a NUL
// after it.
fn where(slot: usize, rest: []const u8) -> []const u8 {
    const bytes: [*]u8 = &paths[slot]
    const current: [*]const u8 = &cwd
    var length = std.text.append(bytes, 0, 1023, current[0..cwdLength])
    length = std.text.append(bytes, length, 1023, "/nebula-58")
    if rest.length > 0 {
        length = std.text.appendByte(bytes, length, 1023, 47)
        length = std.text.append(bytes, length, 1023, rest)
    }
    bytes[length] = 0
    return bytes[0..length]
}

fn variable(bytes: [*]u8, at: usize, name: []const u8, rest: []const u8) -> usize {
    const current: [*]const u8 = &cwd
    var length = std.text.append(bytes, at, 4095, name)
    length = std.text.append(bytes, length, 4095, current[0..cwdLength])
    length = std.text.append(bytes, length, 4095, "/nebula-58/")
    length = std.text.append(bytes, length, 4095, rest)
    return std.text.appendByte(bytes, length, 4095, 0)
}

// Environment `which`: the configuration in nebula-58/`config`, the state
// in nebula-58/`kept`, the home nebula-58/home.
fn environment(which: usize, config: []const u8, kept: []const u8) -> [*][*]const u8 {
    const bytes: [*]u8 = &texts[which]
    lists[which][0] = @intFromPtr(bytes)
    var length = variable(bytes, 0, "XDG_CONFIG_HOME=", config)
    lists[which][1] = @intFromPtr(bytes + length)
    length = variable(bytes, length, "XDG_STATE_HOME=", kept)
    lists[which][2] = @intFromPtr(bytes + length)
    length = variable(bytes, length, "HOME=", "home")
    lists[which][3] = 0
    unsafe { return @ptrCast([*][*]const u8, &lists[which]) }
}

fn fresh(allocator: std.allocator.Allocator, entries: [*][*]const u8) -> ?*App {
    const made = script.headless(allocator)
    if made == null { return null }
    shell_module.setEnvironment(made.?.*.shell, entries)
    return made
}

fn same(left: []const u8, right: []const u8) -> bool { return std.text.same(left, right) }

fn sameShortcut(left: keys.Shortcut, right: keys.Shortcut) -> bool {
    return left.modifiers == right.modifiers && left.character == right.character && left.code == right.code
}

fn makeFile(path: []const u8, text: []const u8) -> bool {
    return std.fs.writeFile(path.pointer, text.pointer, text.length, 420)
}

// A file's text, read whole into `contents` (given back by the next one).
var contents: text_io.Contents = undefined
var holding: bool = false

fn fileText(allocator: std.allocator.Allocator, path: []const u8) -> []const u8 {
    if holding { text_io.freeFile(&contents) }
    holding = text_io.readFile(allocator, path, &contents) == text_io.FileStatus.ok
    if !holding { return "" }
    return contents.bytes[0..contents.length]
}

fn has(text: []const u8, part: []const u8) -> bool { return std.text.contains(text, part) }

// Where `part` is in `text` (text.length when it is not).
fn place(text: []const u8, part: []const u8) -> usize { return std.text.find(text, part) }

const HAND_LINES: usize = 45

const HAND = [45][]const u8{
    "# Written by hand: comments, what a newer version knows, mistakes.",
    "   # an indented comment",
    "top_level = kept before groups",
    "",
    "[General]",
    "undo_steps = 99999999999",
    "autosave_minutes = soon",
    "recent_files = -4",
    "language = de",
    "theme = purple",
    "confirm_close = no",
    "future_option = 42",
    "this line has no equals sign",
    "= a value without a key",
    "[Canvas]",
    "checker_size = 1",
    "checker_light = 0A0B0C",
    "checker_dark = #zzzzzz",
    "pixel_grid_zoom = 800",
    "cursor_cross = YES",
    "[Painting]",
    "smoothing = Weighted",
    "smoothing_distance = 0",
    "image_width = 640",
    "image_height =",
    "image_background = 00000000",
    "[Tablet]",
    "pressure_curve = 0,0;2,2",
    "[Files]",
    "save_format = PNG!",
    "jpeg_quality = 101",
    "png_compression = 3\r",
    "[Plugins]",
    "alpha = one = two",
    "beta =",
    "gamma = 1",
    "# a comment in a group nobody here knows",
    "gamma = 2",
    "[Shortcuts]",
    "tool:brush = P",
    "my_test_action = Ctrl+K",
    "future_action = Ctrl+Alt+F",
    "[State]",
    "docks = left\\nright",
    "a_key_that_is_much_too_long_to_be_kept = x",
}

// The 4 KiB value: every byte value, a space first.
var big: [4097]u8 = undefined

// ---------------------------------------------------------------------------
// The checks from 109 on, a part a function: each returns the number of
// the check that failed, 0 when all held.

// Room for a line worked out here, a long path, a key.
var lineRoom: [512]u8 = undefined
var long: [4096]u8 = undefined
var nameRoom: [256]u8 = undefined

// A field of a Preferences record at `offset`, reached here a second way.
fn numberIn(prefs: *settings.Preferences, offset: usize) -> *u32 { unsafe { return @ptrCast(*u32, @ptrCast([*]u8, prefs) + offset) } }
fn switchIn(prefs: *settings.Preferences, offset: usize) -> *bool { unsafe { return @ptrCast(*bool, @ptrCast([*]u8, prefs) + offset) } }
fn choiceIn(prefs: *settings.Preferences, offset: usize) -> *u8 { unsafe { return @ptrCast(*u8, @ptrCast([*]u8, prefs) + offset) } }
fn lineIn(prefs: *settings.Preferences, offset: usize) -> *settings.Line { unsafe { return @ptrCast(*settings.Line, @ptrCast([*]u8, prefs) + offset) } }

// The row of the setting named `key`.
fn rowOf(key: []const u8) -> ?*const settings.Setting {
    var result: ?*const settings.Setting = null
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const row = settings.settingAt(index)
        if row != null && same(row.?.*.key, key) { result = row }
        index += 1
    }
    return result
}

// A colour as the file writes it, worked out here: six hexadecimal digits
// (upper case) when it is opaque, else eight.
fn hexOf(color: u32, into: [*]u8, at: usize) -> usize {
    const digits: usize = if color >> 24 == 255 { 6 } else { 8 }
    var index: usize = 0
    while index < digits {
        const nibble = @intCast(u8, (color >> @intCast(u5, (digits - 1 - index) * 4)) & 15)
        into[at + index] = if nibble < 10 { nibble + 48 } else { nibble + 55 }
        index += 1
    }
    return at + digits
}

// The line the file has for setting `row` of `prefs`, worked out here
// ("\nundo_steps = 200\n"), in lineRoom.
fn expectedLine(prefs: *settings.Preferences, row: *const settings.Setting) -> []const u8 {
    const into: [*]u8 = &lineRoom
    var length = std.text.appendByte(into, 0, 512, 10)
    length = std.text.append(into, length, 512, row.*.key)
    length = std.text.append(into, length, 512, " = ")
    if row.*.kind == settings.NUMBER {
        length = std.text.appendUnsigned(into, length, 512, @intCast(usize, numberIn(prefs, row.*.offset).*))
    } else if row.*.kind == settings.SWITCH {
        length = std.text.append(into, length, 512, if switchIn(prefs, row.*.offset).* { "on" } else { "off" })
    } else if row.*.kind == settings.CHOICE {
        length = std.text.append(into, length, 512, settings.word(row, @intCast(usize, choiceIn(prefs, row.*.offset).*)))
    } else if row.*.kind == settings.COLOR {
        length = hexOf(numberIn(prefs, row.*.offset).*, into, length)
    } else {
        length = std.text.append(into, length, 512, settings.lineText(lineIn(prefs, row.*.offset)))
    }
    length = std.text.appendByte(into, length, 512, 10)
    return into[0..length]
}

// `text` as the file at `path`, read again by `app`.
fn loadText(app: *App, path: []const u8, text: []const u8) -> bool {
    return makeFile(path, text) && settings.load(app)
}

// The pressure curve after `text` was read as the file.
fn curveAfter(app: *App, path: []const u8, text: []const u8) -> []const u8 {
    if !loadText(app, path, text) { return "(not read)" }
    return settings.lineText(&settings.get(app).*.pressureCurve)
}

// `prefix` and the number `number` in nameRoom ("v17").
fn numbered(prefix: []const u8, number: usize) -> []const u8 {
    const into: [*]u8 = &nameRoom
    const length = std.text.append(into, 0, 256, prefix)
    return into[0..std.text.appendUnsigned(into, length, 256, number)]
}

// How many line feeds `text` has.
fn lineCount(text: []const u8) -> usize {
    var count: usize = 0
    for byte in text {
        if byte == 10 { count += 1 }
    }
    return count
}

// Every setting away from its default, saved and read back by another
// App, each line of the file as worked out here; what each row says of
// itself; the groups kept for other parts.
fn everySetting(allocator: std.allocator.Allocator) -> u8 {
    const entries = environment(3, "every", "every-state")
    const made = fresh(allocator, entries)
    if made == null { return 109 }
    const app = made.?
    const prefs = settings.get(app)
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const row = settings.settingAt(index).?
        // The same row at every asking (it stays where it is).
        if @intFromPtr(settings.settingAt(index).?) != @intFromPtr(row) { return 110 }
        if row.*.kind == settings.NUMBER {
            if row.*.low > row.*.initial || row.*.initial > row.*.high || numberIn(prefs, row.*.offset).* != row.*.initial || settings.word(row, 0).length != 0 { return 111 }
            numberIn(prefs, row.*.offset).* = if row.*.initial == row.*.high { row.*.low } else { row.*.high }
        } else if row.*.kind == settings.SWITCH {
            if switchIn(prefs, row.*.offset).* != (row.*.initial != 0) { return 111 }
            switchIn(prefs, row.*.offset).* = row.*.initial == 0
        } else if row.*.kind == settings.CHOICE {
            const count = @intCast(usize, row.*.wordCount)
            if count < 2 || @intCast(usize, row.*.initial) >= count || @intCast(u32, choiceIn(prefs, row.*.offset).*) != row.*.initial || settings.word(row, count).length != 0 || settings.word(row, count - 1).length == 0 { return 112 }
            choiceIn(prefs, row.*.offset).* = if @intCast(usize, row.*.initial) == count - 1 { 0 } else { @intCast(u8, count - 1) }
        } else if row.*.kind == settings.COLOR {
            if numberIn(prefs, row.*.offset).* != row.*.initial { return 113 }
            // An alpha neither 0 nor 255, and another colour a row.
            numberIn(prefs, row.*.offset).* = 0x12345678 + @intCast(u32, index)
        } else {
            // A text's default is one of its kind.
            if row.*.kind != settings.TEXT || row.*.check == null || !row.*.check.?(row.*.text) || !same(settings.lineText(lineIn(prefs, row.*.offset)), row.*.text) { return 114 }
        }
        index += 1
    }
    // The words, as the file writes them.
    const language = rowOf("language")
    const theme = rowOf("theme")
    const wheel = rowOf("wheel_zoom")
    const smoother = rowOf("smoothing")
    if language == null || theme == null || wheel == null || smoother == null { return 115 }
    if !same(settings.word(language.?, 0), "system") || !same(settings.word(language.?, 1), "en") || !same(settings.word(language.?, 2), "de") || settings.word(language.?, 3).length != 0 { return 115 }
    if !same(settings.word(theme.?, @intCast(usize, settings.THEME_DARK)), "dark") || !same(settings.word(theme.?, @intCast(usize, settings.THEME_LIGHT)), "light") || !same(settings.word(wheel.?, @intCast(usize, settings.CONTROL_WHEEL_ZOOMS)), "ctrl+wheel") { return 115 }
    if @intCast(usize, smoother.?.*.wordCount) != smoothing.MODES || !same(settings.word(smoother.?, @intCast(usize, smoothing.NONE)), "none") || !same(settings.word(smoother.?, @intCast(usize, smoothing.STABILIZER)), "stabilizer") || !same(settings.word(smoother.?, @intCast(usize, smoothing.PIXEL)), "pixel") { return 115 }
    if settings.groupName(5).length != 0 || !same(settings.groupName(settings.TABLET), "Tablet") { return 115 }
    if !settings.setLine(&prefs.*.pressureCurve, "0,0.1;0.5,0.5;1,0.9") || !settings.setLine(&prefs.*.saveFormat, "webp") { return 116 }
    if !settings.changed(app) { return 117 }
    const second = fresh(allocator, entries)
    if second == null { return 118 }
    const back = settings.get(second.?)
    const file = fileText(allocator, where(1, "every/mlx/nebula.conf"))
    // (Row 8 is checker_light: 0x12345678 + 8.)
    if !has(file, "\nchecker_light = 12345680\n") || !has(file, "\npressure_curve = 0,0.1;0.5,0.5;1,0.9\n") { return 120 }
    index = 0
    while index < settings.SETTING_COUNT {
        const row = settings.settingAt(index).?
        var equal = false
        if row.*.kind == settings.NUMBER || row.*.kind == settings.COLOR {
            equal = numberIn(back, row.*.offset).* == numberIn(prefs, row.*.offset).* && numberIn(back, row.*.offset).* != row.*.initial
        } else if row.*.kind == settings.SWITCH {
            equal = switchIn(back, row.*.offset).* == switchIn(prefs, row.*.offset).* && switchIn(back, row.*.offset).* != (row.*.initial != 0)
        } else if row.*.kind == settings.CHOICE {
            equal = choiceIn(back, row.*.offset).* == choiceIn(prefs, row.*.offset).* && @intCast(u32, choiceIn(back, row.*.offset).*) != row.*.initial
        } else {
            equal = same(settings.lineText(lineIn(back, row.*.offset)), settings.lineText(lineIn(prefs, row.*.offset))) && !same(settings.lineText(lineIn(back, row.*.offset)), row.*.text)
        }
        if !equal { return 119 }
        if !has(file, expectedLine(back, row)) { return 120 }
        index += 1
    }
    // A Line that says it is longer than it can be: read as LINE bytes,
    // held to its default by changed().
    back.*.saveFormat.length = 100000
    if settings.lineText(&back.*.saveFormat).length != settings.LINE { return 121 }
    if !settings.changed(second.?) || !same(settings.lineText(&back.*.saveFormat), "ora") { return 121 }

    // The groups kept for other parts: what they refuse changes nothing.
    const before = settings.generation(app)
    if settings.keep(app, "General", "x", "1") || settings.keep(app, "State", "x", "1") || settings.keep(app, "", "x", "1") || settings.keep(app, "Bad]", "x", "1") { return 122 }
    if settings.keep(app, "Plugins", "x", " 1") || settings.keep(app, "Plugins", "x", "1\t") || settings.keep(app, "Plugins", "x", "1\n2") || settings.keep(app, "Plugins", "[x", "1") || settings.keep(app, "Plugins", "#x", "1") || settings.keep(app, "Plugins", "x ", "1") { return 122 }
    if settings.generation(app) != before || settings.kept(app, "Plugins", "x") != null { return 122 }
    index = 0
    while index < 256 {
        nameRoom[index] = 107
        index += 1
    }
    const name: [*]const u8 = &nameRoom
    if !settings.keep(app, "Plugins", name[0..127], "v") || settings.keep(app, "Plugins", name[0..128], "v") || settings.generation(app) == before { return 123 }
    if !settings.keep(app, "Plugins", "x", "") || !settings.save(app) || !settings.load(app) { return 124 }
    const empty = settings.kept(app, "Plugins", "x")
    const longest = settings.kept(app, "Plugins", name[0..127])
    if empty == null || empty.?.length != 0 || longest == null || !same(longest.?, "v") { return 124 }
    if !settings.forget(app, "Plugins", name[0..127]) || settings.forget(app, "Plugins", name[0..127]) || settings.forget(app, "State", "x") || settings.forget(app, "General", "undo_steps") { return 125 }
    settings.forgetGroup(app, "Plugins")
    settings.forgetGroup(app, "General")
    if settings.kept(app, "Plugins", "x") != null || settings.get(app).*.undoSteps != 10000 { return 125 }
    return 0
}

// Numbers, colours, switches and words at and beyond their edges; curves
// and format keys; files that are empty, of every byte value, without a
// last line feed, with a setting in another group, of 3000 lines.
fn edges(allocator: std.allocator.Allocator) -> u8 {
    const entries = environment(4, "edges", "edges-state")
    if !std.fs.makeDirectories(where(2, "edges/mlx"), 493) { return 130 }
    const path = where(3, "edges/mlx/nebula.conf")
    const made = fresh(allocator, entries)
    if made == null { return 130 }
    const app = made.?
    const prefs = settings.get(app)
    // (Not the defaults before: a value that cannot be read must give the
    // default, not what was there.)
    prefs.*.keepBackup = false
    prefs.*.checkerSize = 99
    const numbers = "[General]\nundo_steps = 4294967295\nautosave_minutes = -0\nrecent_files = +7\n[Canvas]\nground_brightness = 99999999999999999999999999\nchecker_size = 12abc\npixel_grid_zoom = 0x10\nchecker_light = ffffff\nchecker_dark = #FFFFFFFF\nantialias_outline = no\ncursor_cross = On\nwheel_zoom = Ctrl+Wheel\n[Painting]\nsimulate_pressure = TRUE\nimage_width = 4294967296\nimage_height = 1e3\nimage_resolution = \t 600 \t\nimage_background = 00ffffff\nsmoothing = PIXEL\nsmoothing_distance = 1000\n[Files]\nkeep_backup = 2\nsave_format = 0123456789abcde\npng_compression = -\njpeg_quality = 1\n"
    if !loadText(app, path, numbers) { return 131 }
    if prefs.*.undoSteps != 10000 || prefs.*.autosaveMinutes != 0 || prefs.*.recentFiles != 7 || prefs.*.groundBrightness != 100 || prefs.*.checkerSize != 16 || prefs.*.pixelGridZoom != 2400 { return 132 }
    if prefs.*.checkerLight != 0xFFFFFFFF || prefs.*.checkerDark != 0xFFFFFFFF || prefs.*.antialiasOutline || !prefs.*.cursorCross || prefs.*.wheelZoom != settings.CONTROL_WHEEL_ZOOMS || !prefs.*.simulatePressure || !prefs.*.keepBackup { return 133 }
    if prefs.*.imageWidth != 32768 || prefs.*.imageHeight != 1080 || prefs.*.imageResolution != 600 || prefs.*.imageBackground != 0x00FFFFFF || prefs.*.smoothing != smoothing.PIXEL || prefs.*.smoothingDistance != 1000 { return 134 }
    if !same(settings.lineText(&prefs.*.saveFormat), "0123456789abcde") || prefs.*.pngCompression != 6 || prefs.*.jpegQuality != 1 { return 135 }
    if !settings.save(app) { return 136 }
    const written = fileText(allocator, path)
    if !has(written, "\nimage_background = 00FFFFFF\n") || !has(written, "\nchecker_light = FFFFFF\n") || !has(written, "\nchecker_dark = FFFFFF\n") || !has(written, "\nwheel_zoom = ctrl+wheel\n") || !has(written, "\nsmoothing = pixel\n") { return 137 }
    if !has(written, "\nundo_steps = 10000\n") || !has(written, "\nrecent_files = 7\n") || !has(written, "\nautosave_minutes = 0\n") || !has(written, "\nimage_width = 32768\n") || !has(written, "\nimage_resolution = 600\n") || !has(written, "\nantialias_outline = off\n") { return 137 }
    // save() holds what it writes to what it may be, in memory too.
    prefs.*.undoSteps = 0
    prefs.*.theme = 7
    if !settings.setLine(&prefs.*.saveFormat, "PNG!") || !settings.save(app) { return 152 }
    if prefs.*.undoSteps != 1 || prefs.*.theme != settings.THEME_SYSTEM || !same(settings.lineText(&prefs.*.saveFormat), "ora") { return 152 }
    const held = fileText(allocator, path)
    if !has(held, "\nundo_steps = 1\n") || !has(held, "\ntheme = system\n") || !has(held, "\nsave_format = ora\n") { return 152 }

    // Curves: a ";" after the last point is allowed, the points need not
    // rise; one point, a number above 1, "0.", an empty point, a point
    // without its comma or with three numbers are none.
    if !same(curveAfter(app, path, "[Tablet]\npressure_curve = 0,0;1,1;\n"), "0,0;1,1;") || !same(curveAfter(app, path, "[Tablet]\npressure_curve = 1,1;0.25,0.75;0,0\n"), "1,1;0.25,0.75;0,0") { return 138 }
    if !same(curveAfter(app, path, "[Tablet]\npressure_curve = 0,0\n"), "0,0;1,1") || !same(curveAfter(app, path, "[Tablet]\npressure_curve = 0,0;1,1.0001\n"), "0,0;1,1") || !same(curveAfter(app, path, "[Tablet]\npressure_curve = 0.,0;1,1\n"), "0,0;1,1") { return 139 }
    if !same(curveAfter(app, path, "[Tablet]\npressure_curve = 0,0;;1,1\n"), "0,0;1,1") || !same(curveAfter(app, path, "[Tablet]\npressure_curve = 0,0;1\n"), "0,0;1,1") || !same(curveAfter(app, path, "[Tablet]\npressure_curve = 0,0;1,1,1\n"), "0,0;1,1") { return 139 }
    // 255 bytes (63 points "0,0;" and "1,1") fit a Line; 256 do not.
    var curve = std.ArrayList(u8).init(allocator)
    if !curve.appendSlice("[Tablet]\npressure_curve = ") { return 140 }
    const start = curve.items().length
    var index: usize = 0
    while index < 63 {
        if !curve.appendSlice("0,0;") { return 140 }
        index += 1
    }
    if !curve.appendSlice("1,1") { return 140 }
    const fitting = curve.items()[start..curve.items().length]
    if fitting.length != 255 || !same(curveAfter(app, path, curve.items()), fitting) { return 141 }
    if !curve.append(59) || !same(curveAfter(app, path, curve.items()), "0,0;1,1") { return 142 }
    curve.deinit()
    // Format keys: 15 small letters and digits at most.
    if !loadText(app, path, "[Files]\nsave_format = 0123456789abcdef\n") || !same(settings.lineText(&prefs.*.saveFormat), "ora") { return 143 }
    if !loadText(app, path, "[Files]\nsave_format = Png\n") || !same(settings.lineText(&prefs.*.saveFormat), "ora") { return 143 }
    if !loadText(app, path, "[Files]\nsave_format = jpg\n") || !same(settings.lineText(&prefs.*.saveFormat), "jpg") { return 143 }

    // An empty file: every default.
    prefs.*.undoSteps = 9
    if !loadText(app, path, "") || prefs.*.undoSteps != 200 || prefs.*.jpegQuality != 90 || !same(settings.lineText(&prefs.*.saveFormat), "ora") { return 144 }
    // No line feed after the last line.
    if !loadText(app, path, "[General]\nundo_steps = 77") || prefs.*.undoSteps != 77 { return 145 }
    // A setting in a group not its own is a key nobody knows there.
    if !loadText(app, path, "[Canvas]\nundo_steps = 5\n[General]\nundo_steps = 6\n") || prefs.*.undoSteps != 6 { return 146 }
    const stray = settings.kept(app, "Canvas", "undo_steps")
    if stray == null || !same(stray.?, "5") || !settings.save(app) { return 146 }
    const moved = fileText(allocator, path)
    const kept_at = place(moved, "\nundo_steps = 5\n")
    if kept_at >= moved.length || kept_at < place(moved, "[Canvas]") || kept_at > place(moved, "[Painting]") || !has(moved, "\nundo_steps = 6\n") { return 146 }
    // A file of every byte value: read without harm, written, and the
    // same when read and written again.
    index = 0
    while index < 4096 {
        big[index] = @intCast(u8, (index * 7 + 3) & 255)
        index += 1
    }
    if !loadText(app, path, big[0..4096]) || !settings.save(app) { return 147 }
    var first = std.ArrayList(u8).init(allocator)
    if !first.appendSlice(fileText(allocator, path)) { return 147 }
    if !settings.load(app) || !settings.save(app) || !same(fileText(allocator, path), first.items()) { return 147 }
    first.deinit()

    // 3000 lines nobody knows: all kept, written and read back.
    var many = std.ArrayList(u8).init(allocator)
    if !many.appendSlice("[Plugins]\n") { return 148 }
    index = 0
    while index < 3000 {
        if !many.appendSlice(numbered("key", index)) || !many.appendSlice(" = ") || !many.appendSlice(numbered("value", index)) || !many.append(10) { return 148 }
        index += 1
    }
    if !loadText(app, path, many.items()) { return 148 }
    many.deinit()
    const last = settings.kept(app, "Plugins", "key2999")
    const first_kept = settings.kept(app, "Plugins", "key0")
    if last == null || !same(last.?, "value2999") || first_kept == null || !same(first_kept.?, "value0") || !settings.save(app) { return 149 }
    const reread = fresh(allocator, entries)
    if reread == null { return 150 }
    const middle = settings.kept(reread.?, "Plugins", "key1500")
    if middle == null || !same(middle.?, "value1500") || lineCount(fileText(allocator, path)) < 3000 { return 150 }
    if holding {
        text_io.freeFile(&contents)
        holding = false
    }
    // The heap the same over loads and saves of it.
    const live = std.heap.liveBytes()
    index = 0
    while index < 5 {
        if !settings.load(reread.?) || !settings.save(reread.?) { return 151 }
        index += 1
    }
    if std.heap.liveBytes() != live { return 151 }
    return 0
}

// Texts kept: blanks only, backslashes, comment and group marks, keys not
// in ASCII, 64 values of 1000 bytes, all read back by another App and
// then removed.
fn textEdges(allocator: std.allocator.Allocator) -> u8 {
    const entries = environment(5, "texts", "texts-state")
    const made = fresh(allocator, entries)
    if made == null { return 155 }
    const app = made.?
    if !settings.setText(app, "spaces", "   ") || !settings.setText(app, "escape", "\\s") || !settings.setText(app, "backslash_n", "a\\nb") || !settings.setText(app, "line_feed", "a\nb") { return 156 }
    if !settings.setText(app, "trailing", "x\\") || !settings.setText(app, "comment", "#not a comment") || !settings.setText(app, "group", "[not a group]") || !settings.setText(app, "größe", "Maß") || !settings.setText(app, "dock:left", "=") { return 156 }
    var index: usize = 0
    while index < 64 {
        if !settings.setText(app, numbered("v", index), big[index..index + 1000]) { return 157 }
        index += 1
    }
    const reader_made = fresh(allocator, entries)
    if reader_made == null { return 158 }
    const reader = reader_made.?
    if !same(settings.text(reader, "spaces"), "   ") || !same(settings.text(reader, "escape"), "\\s") || !same(settings.text(reader, "backslash_n"), "a\\nb") || !same(settings.text(reader, "line_feed"), "a\nb") { return 159 }
    if !same(settings.text(reader, "trailing"), "x\\") || !same(settings.text(reader, "comment"), "#not a comment") || !same(settings.text(reader, "group"), "[not a group]") || !same(settings.text(reader, "größe"), "Maß") || !same(settings.text(reader, "dock:left"), "=") { return 159 }
    index = 0
    while index < 64 {
        if !same(settings.text(reader, numbered("v", index)), big[index..index + 1000]) { return 160 }
        index += 1
    }
    const file = fileText(allocator, where(1, "texts/mlx/nebula.conf"))
    if !has(file, "\nspaces = \\s \\s\n") || !has(file, "\nescape = \\\\s\n") || !has(file, "\nline_feed = a\\nb\n") || !has(file, "\nbackslash_n = a\\\\nb\n") { return 161 }
    index = 0
    while index < 64 {
        if !settings.setText(reader, numbered("v", index), "") || settings.text(reader, numbered("v", index)).length != 0 { return 162 }
        index += 1
    }
    const after_made = fresh(allocator, entries)
    if after_made == null || settings.text(after_made.?, "v0").length != 0 || settings.text(after_made.?, "v63").length != 0 || !same(settings.text(after_made.?, "spaces"), "   ") { return 163 }
    if has(fileText(allocator, where(1, "texts/mlx/nebula.conf")), "\nv0 = ") { return 163 }
    return 0
}

// The brush tool's line in [Shortcuts] ("": none).
fn brushLine(app: *App) -> []const u8 {
    const line = settings.kept(app, settings.SHORTCUTS, "tool:brush")
    if line == null { return "" }
    return line.?
}

// Shortcuts written other ways, read from lines that name none, and
// presses that are no conflict.
fn shortcutEdges(allocator: std.allocator.Allocator) -> u8 {
    const entries = environment(6, "keys", "keys-state")
    const made = fresh(allocator, entries)
    if made == null { return 165 }
    const app = made.?
    const brush_found = tools.byKey("brush")
    if brush_found == null { return 165 }
    const brush = brush_found.?
    const own = keys.parse(brush.*.shortcut)
    // Its own in lower case: no change kept.
    var lower: [32]u8 = undefined
    const lowered: [*]u8 = &lower
    var length = keys.format(own, lowered)
    var index: usize = 0
    while index < length {
        if lowered[index] >= 65 && lowered[index] <= 90 { lowered[index] = lowered[index] + 32 }
        index += 1
    }
    if !shortcuts.set(app, "tool:brush", lowered[0..length]) || settings.kept(app, settings.SHORTCUTS, "tool:brush") != null || !sameShortcut(shortcuts.ofTool(app, brush), own) { return 166 }
    // Written as people read them.
    const plus = keys.parse("Ctrl++")
    if plus.character != 43 || plus.modifiers != keys.CONTROL { return 167 }
    if !shortcuts.set(app, "tool:brush", "Ctrl++") || !same(brushLine(app), "Ctrl++") || !sameShortcut(shortcuts.ofTool(app, brush), plus) { return 167 }
    if !shortcuts.set(app, "tool:brush", "f12") || !same(brushLine(app), "F12") || shortcuts.ofTool(app, brush).code != keys.F12 { return 168 }
    if !shortcuts.set(app, "tool:brush", "Return") || !same(brushLine(app), "Enter") || shortcuts.ofTool(app, brush).code != keys.ENTER { return 168 }
    if !shortcuts.set(app, "tool:brush", "ctrl+shift+z") || !same(brushLine(app), "Ctrl+Shift+Z") { return 168 }
    // "" is none, as "none" is.
    if !shortcuts.set(app, "tool:brush", "") || !same(brushLine(app), "none") || !keys.isNone(shortcuts.ofTool(app, brush)) || shortcuts.conflict(app, own, "") != null { return 169 }
    // A digit is a mark: Shift is the way to it. A letter's Shift is part
    // of the shortcut.
    if !shortcuts.set(app, "tool:brush", "Shift+1") { return 170 }
    const digit = shortcuts.conflict(app, keys.parse("1"), "")
    // (Ctrl+1 may be an action's: it is not the brush's.)
    const control_digit = shortcuts.conflict(app, keys.parse("Ctrl+1"), "")
    // ("1" is taken: by the brush, or by an action that has it too.)
    if digit == null || (control_digit != null && same(control_digit.?, "tool:brush")) { return 170 }
    if !shortcuts.set(app, "tool:brush", "Ctrl+B") || shortcuts.conflict(app, keys.parse("Ctrl+Shift+B"), "") != null || shortcuts.conflict(app, keys.parse("B"), "") != null { return 171 }
    const exact = shortcuts.conflict(app, keys.parse("ctrl+b"), "")
    if exact == null || !same(exact.?, "tool:brush") { return 171 }
    // Lines of the file: one that names no shortcut gives the row's own,
    // NONE in any case none, keys nobody knows are kept through a change.
    if !std.fs.makeDirectories(where(2, "keys/mlx"), 493) { return 172 }
    const path = where(3, "keys/mlx/nebula.conf")
    if !loadText(app, path, "[Shortcuts]\ntool:brush = Ctrl+\nfuture_thing = Ctrl+Q\n") || !sameShortcut(shortcuts.ofTool(app, brush), own) { return 172 }
    if !loadText(app, path, "[Shortcuts]\ntool:brush =   NONE  \nfuture_thing = Ctrl+Q\n") || !keys.isNone(shortcuts.ofTool(app, brush)) { return 173 }
    if !loadText(app, path, "[Shortcuts]\ntool:brush = alt+F3\nfuture_thing = Ctrl+Q\n") || !sameShortcut(shortcuts.ofTool(app, brush), keys.parse("Alt+F3")) { return 174 }
    if !shortcuts.set(app, "tool:brush", "P") || !has(fileText(allocator, path), "\nfuture_thing = Ctrl+Q\n") || !has(fileText(allocator, path), "\ntool:brush = P\n") { return 175 }
    if !shortcuts.reset(app, "tool:brush") || shortcuts.reset(app, "tool:brush") || has(fileText(allocator, path), "tool:brush") || !has(fileText(allocator, path), "\nfuture_thing = Ctrl+Q\n") { return 176 }
    return 0
}

// Recent files at their most, paths at the edge of what is kept, a list
// written by hand, removed to nothing; the heap and the value arena over
// 200 changes.
fn recentEdges(allocator: std.allocator.Allocator) -> u8 {
    const entries = environment(7, "recent", "recent-state")
    const made = fresh(allocator, entries)
    if made == null { return 180 }
    const app = made.?
    settings.get(app).*.recentFiles = 100
    if !settings.changed(app) { return 180 }
    var index: usize = 0
    while index < 150 {
        if !recent.add(app, numbered("/nowhere/p", index)) { return 181 }
        index += 1
    }
    if recent.count(app) != 100 || !same(recent.at(app, 0), "/nowhere/p149") || !same(recent.at(app, 99), "/nowhere/p50") || recent.at(app, 100).length != 0 { return 182 }
    const list_path = where(3, "recent-state/mlx/nebula/recent")
    const listed = fileText(allocator, list_path)
    if lineCount(listed) != 100 || !std.text.startsWith(listed, "/nowhere/p149\n") || !std.text.endsWith(listed, "\n/nowhere/p50\n") { return 183 }
    // A path of 4095 bytes is kept, one of 4096 not; nor one with a NUL
    // or a CR in it.
    long[0] = 47
    index = 1
    while index < 4096 {
        long[index] = 120
        index += 1
    }
    if !recent.add(app, long[0..4095]) || recent.at(app, 0).length != 4095 || recent.exists(app, 0) || recent.count(app) != 100 { return 184 }
    long[2] = 0
    if recent.add(app, long[0..4096]) || recent.add(app, long[0..10]) || recent.add(app, "a\rb") || recent.at(app, 0).length != 4095 { return 185 }
    // A list written by hand: CR LF, empty lines, a path twice, a line too
    // long, no line feed after the last.
    var hand = std.ArrayList(u8).init(allocator)
    if !hand.appendSlice("\n/one\r\n/two\n/one\n\n") { return 186 }
    index = 0
    while index < 5000 {
        if !hand.append(121) { return 186 }
        index += 1
    }
    if !hand.appendSlice("\n/three") || !makeFile(list_path, hand.items()) { return 186 }
    hand.deinit()
    if !recent.load(app) || recent.count(app) != 3 || !same(recent.at(app, 0), "/one") || !same(recent.at(app, 1), "/two") || !same(recent.at(app, 2), "/three") { return 187 }
    // Removed to nothing.
    if !recent.remove(app, "/two") || recent.count(app) != 2 || !same(recent.at(app, 0), "/one") || !same(recent.at(app, 1), "/three") { return 188 }
    if !recent.remove(app, "/three") || !recent.remove(app, "/one") || recent.count(app) != 0 || recent.remove(app, "/one") { return 189 }
    if fileText(allocator, list_path).length != 0 || !holding { return 189 }
    text_io.freeFile(&contents)
    holding = false
    // The heap the same, the value arena all but untouched (what std.fs
    // takes for a path), over 200 changes.
    if !recent.add(app, "/r/a") || !recent.add(app, "/r/b") { return 190 }
    const live = std.heap.liveBytes()
    const arena = turns.locate()
    const used = turns.used(arena)
    index = 0
    while index < 200 {
        if !recent.add(app, if index % 2 == 0 { "/r/a" } else { "/r/b" }) || recent.count(app) != 2 { return 190 }
        index += 1
    }
    if !recent.remove(app, "/r/a") || !recent.add(app, "/r/a") { return 190 }
    if std.heap.liveBytes() != live { return 191 }
    if turns.used(arena) - used > 202 * 16384 { return 192 }
    return 0
}

// What a frame asks of these modules takes no value arena; a save takes
// at most 16 KiB of it (what std.fs takes for its paths), a load 4 KiB;
// the heap is the same over 50 rounds of everything.
fn arenaAndHeap(app: *App, brush: *const state.Tool, action: *const state.Action) -> u8 {
    const arena = turns.locate()
    _ = shortcuts.conflict(app, keys.parse("Ctrl+Alt+F9"), "")
    _ = settings.settingAt(0)
    var used = turns.used(arena)
    var looked: usize = 0
    var round: usize = 0
    while round < 1000 {
        const row = settings.settingAt(round % settings.SETTING_COUNT)
        if row != null && row.?.*.key.length > 0 && settings.word(row.?, 1).length < 100 && settings.groupName(row.?.*.group).length > 0 { looked += 1 }
        if settings.get(app).*.undoSteps > 0 && settings.text(app, "docks").length < 100000 && settings.kept(app, settings.SHORTCUTS, "tool:brush") == null && settings.generation(app) > 0 { looked += 1 }
        if shortcuts.conflict(app, keys.parse("Ctrl+Alt+F9"), "") == null && !keys.isNone(shortcuts.ofTool(app, brush)) && !keys.isNone(shortcuts.ofAction(app, action)) { looked += 1 }
        if recent.count(app) <= recent.MOST && recent.at(app, 0).length < 4096 { looked += 1 }
        round += 1
    }
    if turns.used(arena) - used > 512 || looked != 4000 { return 195 }
    used = turns.used(arena)
    round = 0
    while round < 100 {
        settings.get(app).*.undoSteps = 300 + @intCast(u32, round)
        if !settings.changed(app) { return 196 }
        round += 1
    }
    if turns.used(arena) - used > 100 * 16384 { return 196 }
    used = turns.used(arena)
    round = 0
    while round < 100 {
        if !settings.load(app) || settings.get(app).*.undoSteps != 399 { return 197 }
        round += 1
    }
    if turns.used(arena) - used > 100 * 4096 { return 197 }
    // Everything once, so that what it keeps has its size; then 50 rounds.
    if !settings.setText(app, "round", "a") || !shortcuts.set(app, "tool:brush", "F7") || !shortcuts.reset(app, "tool:brush") || !recent.add(app, "/round/a") || !recent.remove(app, "/round/a") { return 198 }
    _ = shortcuts.ofTool(app, brush)
    const live = std.heap.liveBytes()
    round = 0
    while round < 50 {
        if !settings.load(app) || !settings.setText(app, "round", if round % 2 == 0 { "b" } else { "a" }) || keys.isNone(shortcuts.ofTool(app, brush)) { return 199 }
        if !shortcuts.set(app, "tool:brush", "F7") || shortcuts.ofTool(app, brush).code != keys.F1 + 6 || !shortcuts.reset(app, "tool:brush") { return 199 }
        if !recent.add(app, "/round/a") || !recent.remove(app, "/round/a") || !settings.save(app) { return 199 }
        round += 1
    }
    if std.heap.liveBytes() != live { return 200 }
    return 0
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    if std.fs.getWorkingDirectory(&cwd, 4096) <= 0 { return 1 }
    const current: [*]const u8 = &cwd
    cwdLength = std.text.cString(current).length
    if cwdLength == 0 || cwdLength > 900 { return 1 }
    _ = std.fs.removeTree(where(0, "").pointer)
    // The test's action, kept in heap memory as a registry keeps its rows.
    const action_memory = allocator.alloc(@sizeOf(state.Action), 16)
    if action_memory == null { return 2 }
    const testAction: *state.Action = unsafe { @ptrCast(*state.Action, action_memory.?) }
    testAction.* = TEST_ACTIONS[0]
    if !std.fs.makeDirectories(where(0, "home"), 493) || !std.fs.makeDirectories(where(0, "files"), 493) { return 2 }

    // -----------------------------------------------------------------
    // Without a file: every default; reading writes nothing.
    const first_environment = environment(0, "config", "state")
    const made = fresh(allocator, first_environment)
    if made == null { return 3 }
    const app = made.?
    if settings.load(app) { return 3 }
    const prefs = settings.get(app)
    if prefs.*.language != settings.LANGUAGE_SYSTEM || prefs.*.theme != settings.THEME_SYSTEM || prefs.*.undoSteps != 200 || prefs.*.autosaveMinutes != 5 || prefs.*.recentFiles != 20 || !prefs.*.confirmClose { return 4 }
    if prefs.*.groundBrightness != 25 || prefs.*.checkerSize != 16 || prefs.*.checkerLight != 0xFFFFFFFF || prefs.*.checkerDark != 0xFFCCCCCC || prefs.*.pixelGridZoom != 2400 || !prefs.*.antialiasOutline || !prefs.*.cursorOutline || prefs.*.cursorCross || prefs.*.wheelZoom != settings.WHEEL_ZOOMS { return 5 }
    if prefs.*.smoothing != smoothing.BASIC || prefs.*.smoothingDistance != 15 || prefs.*.simulatePressure || prefs.*.imageWidth != 1920 || prefs.*.imageHeight != 1080 || prefs.*.imageResolution != 300 || prefs.*.imageBackground != 0xFFFFFFFF { return 6 }
    if !same(settings.lineText(&prefs.*.pressureCurve), "0,0;1,1") || !same(settings.lineText(&prefs.*.saveFormat), "ora") || prefs.*.pngCompression != 6 || prefs.*.jpegQuality != 90 || !prefs.*.keepBackup { return 7 }
    if settings.text(app, "docks").length != 0 || recent.count(app) != 0 || recent.at(app, 0).length != 0 || recent.exists(app, 0) { return 8 }
    const conf_path = where(1, "config/mlx/nebula.conf")
    if std.fs.exists(conf_path.pointer) { return 9 }
    // Every setting is described for a dialog, in both languages.
    var index: usize = 0
    while index < settings.SETTING_COUNT {
        const described = settings.settingAt(index)
        if described == null || described.?.*.key.length == 0 || described.?.*.name.length == 0 || described.?.*.german.length == 0 || settings.groupName(described.?.*.group).length == 0 { return 10 }
        index += 1
    }
    if settings.settingAt(settings.SETTING_COUNT) != null { return 10 }

    // -----------------------------------------------------------------
    // Changed, held to the ranges, saved; a second App reads them.
    prefs.*.undoSteps = 350
    prefs.*.theme = settings.THEME_DARK
    prefs.*.language = settings.LANGUAGE_GERMAN
    prefs.*.smoothing = smoothing.STABILIZER
    prefs.*.imageBackground = 0x80102030
    prefs.*.checkerDark = 0xFF000000
    prefs.*.confirmClose = false
    prefs.*.cursorCross = true
    prefs.*.wheelZoom = settings.CONTROL_WHEEL_ZOOMS
    prefs.*.jpegQuality = 500
    prefs.*.checkerSize = 0
    prefs.*.recentFiles = 1000
    if !settings.setLine(&prefs.*.pressureCurve, "0,0;0.5,0.25;1.000,1") || !settings.setLine(&prefs.*.saveFormat, "png") { return 11 }
    // (Too long for a Line: refused, the line as it was.)
    index = 0
    while index < 256 {
        big[index] = 48
        index += 1
    }
    if settings.setLine(&prefs.*.saveFormat, big[0..256]) || !same(settings.lineText(&prefs.*.saveFormat), "png") { return 11 }
    if !settings.changed(app) { return 12 }
    if prefs.*.jpegQuality != 100 || prefs.*.checkerSize != 2 || prefs.*.recentFiles != 100 { return 14 }
    if !std.fs.exists(conf_path.pointer) { return 15 }
    const second_made = fresh(allocator, first_environment)
    if second_made == null { return 16 }
    const second = second_made.?
    const read = settings.get(second)
    if read.*.undoSteps != 350 || read.*.theme != settings.THEME_DARK || read.*.language != settings.LANGUAGE_GERMAN || read.*.smoothing != smoothing.STABILIZER || read.*.imageBackground != 0x80102030 || read.*.checkerDark != 0xFF000000 { return 17 }
    if read.*.confirmClose || !read.*.cursorCross || read.*.wheelZoom != settings.CONTROL_WHEEL_ZOOMS || read.*.jpegQuality != 100 || read.*.checkerSize != 2 || read.*.recentFiles != 100 { return 18 }
    if !same(settings.lineText(&read.*.pressureCurve), "0,0;0.5,0.25;1.000,1") || !same(settings.lineText(&read.*.saveFormat), "png") { return 19 }
    // A curve or a format key that is none goes back to its default.
    if !settings.setLine(&prefs.*.pressureCurve, "0,0;1.5,1") || !settings.setLine(&prefs.*.saveFormat, "") { return 20 }
    prefs.*.smoothing = 9
    prefs.*.recentFiles = 20
    if !settings.changed(app) { return 20 }
    if !same(settings.lineText(&prefs.*.pressureCurve), "0,0;1,1") || !same(settings.lineText(&prefs.*.saveFormat), "ora") || prefs.*.smoothing != smoothing.BASIC { return 21 }
    // The second App reads the file again when asked to.
    if !settings.load(second) || !same(settings.lineText(&read.*.saveFormat), "ora") || read.*.undoSteps != 350 { return 22 }
    const written = fileText(allocator, conf_path)
    if !has(written, "[General]\n") || !has(written, "undo_steps = 350\n") || !has(written, "theme = dark\n") || !has(written, "image_background = 80102030\n") || !has(written, "checker_dark = 000000\n") || !has(written, "smoothing = basic\n") || !has(written, "confirm_close = off\n") || !has(written, "wheel_zoom = ctrl+wheel\n") { return 23 }
    if has(written, "[Shortcuts]") || has(written, "[State]") { return 24 }

    // -----------------------------------------------------------------
    // A file written by hand.
    if !std.fs.makeDirectories(where(2, "handmade/mlx"), 493) { return 25 }
    const hand_path = where(3, "handmade/mlx/nebula.conf")
    var hand = std.ArrayList(u8).init(allocator)
    index = 0
    while index < HAND_LINES {
        if !hand.appendSlice(HAND[index]) || !hand.append(10) { return 25 }
        index += 1
    }
    if !makeFile(hand_path, hand.items()) { return 25 }
    hand.deinit()
    const hand_environment = environment(1, "handmade", "state")
    const third_made = fresh(allocator, hand_environment)
    if third_made == null { return 26 }
    const third = third_made.?
    if !settings.load(third) { return 26 }
    const handmade = settings.get(third)
    // Out of range: held; no number: the default; a word in another case.
    if handmade.*.undoSteps != 10000 || handmade.*.autosaveMinutes != 5 || handmade.*.recentFiles != 0 || handmade.*.language != settings.LANGUAGE_GERMAN || handmade.*.theme != settings.THEME_SYSTEM || handmade.*.confirmClose { return 27 }
    if handmade.*.checkerSize != 2 || handmade.*.checkerLight != 0xFF0A0B0C || handmade.*.checkerDark != 0xFFCCCCCC || handmade.*.pixelGridZoom != 800 || !handmade.*.cursorCross { return 28 }
    if handmade.*.smoothing != smoothing.WEIGHTED || handmade.*.smoothingDistance != 1 || handmade.*.imageWidth != 640 || handmade.*.imageHeight != 1080 || handmade.*.imageBackground != 0 { return 29 }
    if !same(settings.lineText(&handmade.*.pressureCurve), "0,0;1,1") || !same(settings.lineText(&handmade.*.saveFormat), "ora") || handmade.*.jpegQuality != 100 || handmade.*.pngCompression != 3 { return 30 }
    if !same(settings.text(third, "docks"), "left\nright") || settings.text(third, "a_key_that_is_much_too_long_to_be_kept").length != 0 { return 31 }
    const plugins_alpha = settings.kept(third, "Plugins", "alpha")
    const plugins_gamma = settings.kept(third, "Plugins", "gamma")
    if plugins_alpha == null || !same(plugins_alpha.?, "one = two") || plugins_gamma == null || !same(plugins_gamma.?, "2") { return 32 }
    if !settings.save(third) { return 33 }
    const again = fileText(allocator, hand_path)
    if !has(again, "top_level = kept before groups\n") || place(again, "top_level") > place(again, "[General]") { return 34 }
    const future = place(again, "future_option = 42\n")
    if future >= again.length || future < place(again, "[General]") || future > place(again, "[Canvas]") { return 35 }
    const plugins = place(again, "\n[Plugins]\n")
    if plugins >= again.length || place(again, "alpha = one = two\n") < plugins || !has(again, "beta = \n") || !has(again, "gamma = 2\n") || has(again, "gamma = 1") { return 36 }
    if !has(again, "\n[Shortcuts]\ntool:brush = P\nmy_test_action = Ctrl+K\nfuture_action = Ctrl+Alt+F\n") || !has(again, "\n[State]\ndocks = left\\nright\n") { return 37 }
    if has(again, "# a comment") || has(again, "no equals sign") || has(again, "without a key") || has(again, "much_too_long") || has(again, "\r") { return 38 }
    if !has(again, "undo_steps = 10000\n") || !has(again, "theme = system\n") || !has(again, "checker_dark = CCCCCC\n") || !has(again, "image_background = 00000000\n") || !has(again, "pressure_curve = 0,0;1,1\n") || !has(again, "save_format = ora\n") || !has(again, "png_compression = 3\n") { return 39 }
    // Read and written once more, the file stays what it is.
    const fourth_made = fresh(allocator, hand_environment)
    if fourth_made == null || !settings.load(fourth_made.?) || !settings.save(fourth_made.?) { return 40 }
    var once = std.ArrayList(u8).init(allocator)
    if !once.appendSlice(again) { return 40 }
    if !same(fileText(allocator, hand_path), once.items()) { return 41 }
    once.deinit()

    // -----------------------------------------------------------------
    // Texts kept for other parts, read back byte for byte.
    index = 0
    while index < 4097 {
        big[index] = @intCast(u8, (index + 32) & 255)
        index += 1
    }
    const blanks = "  \\back\\slashes\\, a CR\r and a tab at the end\t"
    if !settings.setText(app, "docks", "left:layers,brushes\nright:color\n") || !settings.setText(app, "equals", "a=b = c==") || !settings.setText(app, "unicode", "Grüße, Ölfarbe – 日本語 ✓") { return 42 }
    if !settings.setText(app, "blanks", blanks) || !settings.setText(app, "big", big[0..4096]) || !settings.setText(app, "k234567890123456789012345678901", "the longest key") { return 43 }
    if settings.setText(app, "", "x") || settings.setText(app, "k2345678901234567890123456789012", "x") || settings.setText(app, "a=b", "x") || settings.setText(app, "#c", "x") || settings.setText(app, "[d", "x") { return 44 }
    if settings.setText(app, " e", "x") || settings.setText(app, "f ", "x") || settings.setText(app, "g\nh", "x") || settings.setText(app, "too_big", big[0..4097]) || settings.text(app, "too_big").length != 0 { return 45 }
    // A value that is a text kept already (its bytes move while it is
    // copied).
    if !settings.setText(app, "copy", settings.text(app, "big")) || !same(settings.text(app, "copy"), big[0..4096]) { return 46 }
    if !settings.setText(app, "copy", settings.text(app, "copy")[0..100]) || !same(settings.text(app, "copy"), big[0..100]) { return 46 }
    const texts_made = fresh(allocator, first_environment)
    if texts_made == null { return 47 }
    const reader = texts_made.?
    if !same(settings.text(reader, "docks"), "left:layers,brushes\nright:color\n") || !same(settings.text(reader, "equals"), "a=b = c==") || !same(settings.text(reader, "unicode"), "Grüße, Ölfarbe – 日本語 ✓") { return 48 }
    if !same(settings.text(reader, "blanks"), blanks) || !same(settings.text(reader, "big"), big[0..4096]) || !same(settings.text(reader, "k234567890123456789012345678901"), "the longest key") || !same(settings.text(reader, "copy"), big[0..100]) { return 49 }
    // The settings are what they were.
    if settings.get(reader).*.undoSteps != 350 { return 50 }
    // "" keeps nothing.
    if !settings.setText(reader, "equals", "") || settings.text(reader, "equals").length != 0 { return 51 }
    if !settings.load(app) || settings.text(app, "equals").length != 0 || !same(settings.text(app, "docks"), "left:layers,brushes\nright:color\n") { return 52 }

    // -----------------------------------------------------------------
    // Shortcuts, on the registries' rows.
    const brush_found = tools.byKey("brush")
    if brush_found == null { return 53 }
    const brush = brush_found.?
    const own = keys.parse(brush.*.shortcut)
    if !sameShortcut(shortcuts.ofTool(app, brush), own) || !sameShortcut(shortcuts.ofAction(app, testAction), keys.parse("Ctrl+J")) { return 54 }
    if !shortcuts.set(app, "tool:brush", "ctrl+alt+f7") || !sameShortcut(shortcuts.ofTool(app, brush), keys.parse("Ctrl+Alt+F7")) { return 55 }
    const noted = settings.kept(app, settings.SHORTCUTS, "tool:brush")
    if noted == null || !same(noted.?, "Ctrl+Alt+F7") { return 56 }
    const holder = shortcuts.conflict(app, keys.parse("Ctrl+Alt+F7"), "")
    if holder == null || !same(holder.?, "tool:brush") || shortcuts.conflict(app, keys.parse("Ctrl+Alt+F7"), "tool:brush") != null { return 57 }
    const freed = shortcuts.conflict(app, own, "")
    if freed != null && same(freed.?, "tool:brush") { return 58 }
    if shortcuts.conflict(app, keys.none(), "") != null { return 58 }
    // "none": no shortcut at all.
    if !shortcuts.set(app, "tool:brush", "none") || !keys.isNone(shortcuts.ofTool(app, brush)) { return 59 }
    const none_noted = settings.kept(app, settings.SHORTCUTS, "tool:brush")
    if none_noted == null || !same(none_noted.?, "none") { return 59 }
    // Text that names no shortcut, keys that name nothing: refused.
    if shortcuts.set(app, "tool:brush", "Ctrl+") || shortcuts.set(app, "tool:no_such_tool", "B") || shortcuts.set(app, "no_such_action_58", "B") || !keys.isNone(shortcuts.ofTool(app, brush)) { return 60 }
    // Its own again.
    if !shortcuts.reset(app, "tool:brush") || !sameShortcut(shortcuts.ofTool(app, brush), own) || shortcuts.reset(app, "tool:brush") || settings.kept(app, settings.SHORTCUTS, "tool:brush") != null { return 61 }
    if !shortcuts.set(app, "tool:brush", brush.*.shortcut) || settings.kept(app, settings.SHORTCUTS, "tool:brush") != null { return 62 }
    // A mark's Shift is the way to it: "[" and "Shift+[" are one press; a
    // letter's is not.
    if !shortcuts.set(app, "tool:brush", "Shift+[") { return 63 }
    const mark = shortcuts.conflict(app, keys.parse("["), "")
    if mark == null || !same(mark.?, "tool:brush") { return 63 }
    // (Q itself may be another's: the brush's Shift+Q is not it.)
    if !shortcuts.set(app, "tool:brush", "Shift+Q") { return 64 }
    const plain_q = shortcuts.conflict(app, keys.parse("Q"), "")
    if plain_q != null && same(plain_q.?, "tool:brush") { return 64 }
    // Kept in the file, read by another App.
    if !shortcuts.set(app, "tool:brush", "Alt+F5") { return 65 }
    const keys_made = fresh(allocator, first_environment)
    if keys_made == null { return 66 }
    const other = keys_made.?
    if !sameShortcut(shortcuts.ofTool(other, brush), keys.parse("Alt+F5")) || !sameShortcut(shortcuts.ofAction(other, testAction), keys.parse("Ctrl+J")) { return 67 }
    // The hand-written file's lines: a tool's and an action's.
    if !sameShortcut(shortcuts.ofTool(third, brush), keys.parse("P")) || !sameShortcut(shortcuts.ofAction(third, testAction), keys.parse("Ctrl+K")) { return 68 }
    // An action of the registry, when it has one with a shortcut.
    const action_count = actions.count()
    index = 0
    while index < action_count {
        const action = actions.at(index)
        if action != null && !keys.isNone(keys.parse(action.?.*.shortcut)) {
            const action_own = keys.parse(action.?.*.shortcut)
            if !sameShortcut(shortcuts.ofAction(other, action.?), action_own) { return 69 }
            if !shortcuts.set(other, action.?.*.key, "Ctrl+Alt+F8") || !sameShortcut(shortcuts.ofAction(other, action.?), keys.parse("Ctrl+Alt+F8")) { return 70 }
            if !shortcuts.set(other, "tool:brush", action.?.*.shortcut) { return 71 }
            const tool_holder = shortcuts.conflict(other, action_own, action.?.*.key)
            const action_holder = shortcuts.conflict(other, keys.parse("Ctrl+Alt+F8"), "tool:brush")
            if tool_holder == null || !same(tool_holder.?, "tool:brush") || action_holder == null || !same(action_holder.?, action.?.*.key) { return 72 }
            if !shortcuts.reset(other, action.?.*.key) || !sameShortcut(shortcuts.ofAction(other, action.?), action_own) { return 73 }
            break
        }
        index += 1
    }
    shortcuts.resetAll(other)
    if !sameShortcut(shortcuts.ofTool(other, brush), own) || settings.kept(other, settings.SHORTCUTS, "tool:brush") != null { return 74 }
    if !settings.load(app) || !sameShortcut(shortcuts.ofTool(app, brush), own) { return 75 }

    // -----------------------------------------------------------------
    // No value arena taken by the lookups the loop makes at every key.
    const arena = turns.locate()
    _ = shortcuts.ofAction(app, testAction)
    _ = shortcuts.ofTool(app, brush)
    const before = turns.used(arena)
    var looked: usize = 0
    var round: usize = 0
    while round < 1000 {
        if !keys.isNone(shortcuts.ofAction(app, testAction)) { looked += 1 }
        if keys.matches(shortcuts.ofTool(app, brush), 0, 0, "b") { looked += 1 }
        var row: usize = 0
        while row < action_count {
            const action = actions.at(row)
            if action != null { _ = shortcuts.ofAction(app, action.?) }
            row += 1
        }
        round += 1
    }
    const grown = turns.used(arena) - before
    if grown > 512 || looked < 1000 { return 76 }

    // -----------------------------------------------------------------
    // The recent files.
    const a = where(4, "files/a.png")
    const b = where(5, "files/b.png")
    const c = where(6, "files/c.png")
    const d = where(7, "files/d.png")
    if !makeFile(a, "a") || !makeFile(b, "b") || !makeFile(c, "c") || !makeFile(d, "d") { return 77 }
    if recent.count(app) != 0 { return 78 }
    if !recent.add(app, a) || !recent.add(app, b) || !recent.add(app, c) { return 79 }
    if recent.count(app) != 3 || !same(recent.at(app, 0), c) || !same(recent.at(app, 1), b) || !same(recent.at(app, 2), a) || recent.at(app, 3).length != 0 { return 80 }
    // Again: to the front, not twice.
    if !recent.add(app, a) || recent.count(app) != 3 || !same(recent.at(app, 0), a) || !same(recent.at(app, 1), c) || !same(recent.at(app, 2), b) { return 81 }
    if recent.remove(app, where(1, "files/none.png")) || recent.add(app, "") || recent.add(app, "two\nlines") || recent.count(app) != 3 { return 82 }
    // The limit: what is beyond it goes.
    prefs.*.recentFiles = 3
    if !settings.changed(app) { return 83 }
    if !recent.add(app, d) || recent.count(app) != 3 || !same(recent.at(app, 0), d) || !same(recent.at(app, 1), a) || !same(recent.at(app, 2), c) { return 84 }
    // A path of the list itself.
    if !recent.add(app, recent.at(app, 2)) || !same(recent.at(app, 0), c) || !same(recent.at(app, 1), d) || !same(recent.at(app, 2), a) { return 85 }
    if !recent.remove(app, recent.at(app, 2)) || recent.count(app) != 2 || !same(recent.at(app, 0), c) || !same(recent.at(app, 1), d) { return 86 }
    // Kept for another App; a file that is gone is not offered.
    const recent_made = fresh(allocator, first_environment)
    if recent_made == null { return 87 }
    const later = recent_made.?
    if recent.count(later) != 2 || !same(recent.at(later, 0), c) || !same(recent.at(later, 1), d) || !recent.exists(later, 0) || !recent.exists(later, 1) { return 88 }
    if !std.fs.delete(d.pointer) || !recent.exists(later, 0) || recent.exists(later, 1) || recent.count(later) != 2 || recent.exists(later, 2) { return 89 }
    // A smaller limit lists fewer at once.
    settings.get(later).*.recentFiles = 1
    if recent.count(later) != 1 || recent.at(later, 1).length != 0 { return 90 }
    settings.get(later).*.recentFiles = 20
    if !settings.changed(later) || recent.count(later) != 2 { return 90 }
    if !recent.clear(later) || recent.count(later) != 0 { return 91 }
    const cleared_made = fresh(allocator, first_environment)
    if cleared_made == null || recent.count(cleared_made.?) != 0 { return 92 }
    // A limit of 0 keeps none.
    settings.get(later).*.recentFiles = 0
    if !settings.changed(later) || !recent.add(later, a) || recent.count(later) != 0 { return 93 }
    settings.get(later).*.recentFiles = 20
    if !settings.changed(later) || !recent.load(later) || recent.count(later) != 0 { return 93 }

    // -----------------------------------------------------------------
    // A folder that cannot be made (a file where "mlx" would be), and no
    // environment at all: nothing is written, nothing crashes.
    if !std.fs.makeDirectories(where(1, "blocked"), 493) || !makeFile(where(1, "blocked/mlx"), "in the way") { return 94 }
    const blocked_made = fresh(allocator, environment(2, "blocked", "blocked"))
    if blocked_made == null { return 95 }
    const blocked = blocked_made.?
    if settings.load(blocked) || settings.get(blocked).*.undoSteps != 200 { return 95 }
    if settings.save(blocked) || settings.changed(blocked) { return 96 }
    if !settings.setText(blocked, "key", "value") || !same(settings.text(blocked, "key"), "value") { return 97 }
    if !shortcuts.set(blocked, "tool:brush", "Alt+F6") || !sameShortcut(shortcuts.ofTool(blocked, brush), keys.parse("Alt+F6")) { return 98 }
    if recent.add(blocked, a) || recent.count(blocked) != 1 || recent.clear(blocked) { return 99 }
    if std.fs.isDirectory(where(1, "blocked/mlx").pointer) || !same(fileText(allocator, where(1, "blocked/mlx")), "in the way") { return 100 }
    const bare_made = script.headless(allocator)
    if bare_made == null { return 101 }
    const bare = bare_made.?
    if settings.load(bare) || settings.save(bare) || settings.get(bare).*.jpegQuality != 90 || recent.add(bare, a) || recent.count(bare) != 1 { return 101 }
    if !settings.setText(bare, "key", "value") || !same(settings.text(bare, "key"), "value") { return 102 }

    // -----------------------------------------------------------------
    // The heap the same over 50 loads and saves (of the settings and of
    // the recent files), with the shortcuts worked out again after each
    // (after a round as they go, so that what is kept is as long).
    if !settings.load(app) || !settings.save(app) || !recent.load(app) || !recent.add(app, a) || !recent.add(app, c) { return 103 }
    _ = shortcuts.ofTool(app, brush)
    const live = std.heap.liveBytes()
    round = 0
    while round < 50 {
        if !settings.load(app) || !settings.save(app) { return 104 }
        if !recent.load(app) || !recent.add(app, if round % 2 == 0 { a } else { c }) { return 105 }
        if !sameShortcut(shortcuts.ofTool(app, brush), own) { return 106 }
        round += 1
    }
    if std.heap.liveBytes() != live { return 107 }

    var code = everySetting(allocator)
    if code == 0 { code = edges(allocator) }
    if code == 0 { code = textEdges(allocator) }
    if code == 0 { code = shortcutEdges(allocator) }
    if code == 0 { code = recentEdges(allocator) }
    if code == 0 { code = arenaAndHeap(app, brush, testAction) }
    if code != 0 { return code }

    if holding { text_io.freeFile(&contents) }
    if !std.fs.removeTree(where(0, "").pointer) { return 108 }
    return 13
}
