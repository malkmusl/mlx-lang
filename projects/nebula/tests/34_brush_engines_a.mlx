// nebula's brush engines that read the picture, and the quick brush
// (brush/smudge_engine.mlx, clone_engine.mlx, filter_engine.mlx,
// deform_engine.mlx, quick_engine.mlx). Each is in the list of engines
// under its key and number, paints on the layer (the quick brush as its
// paint mode says), and a preset names it and keeps its numbers. The
// colour smudge drags red into blue the further the longer its smudge
// length (only mixes of the two, in the brush's band), its length driven
// by the pressure too; at smudge length 0 it paints only the paint colour,
// without a colour rate nothing; half the rate lays half the colour; it
// dulls stripes to one grey where smearing carries them; it reads the
// sample in overlay mode, keeps alpha when asked, and its mirrored copies
// drag their own paint. The clone copies a pattern of every alpha exactly
// with its offset, keeps the offset for the next strokes or starts over,
// anchors again at a new source, clones from the sample, paints nothing
// without a source, and heals a patch to the brightness where it goes.
// The filter brush inverts once under a stroke that crosses itself, with
// the layer's change open or not, blurs the way the whole picture is
// blurred, and paints nothing with a filter not known. The deform brush
// swirls either way (only greys of black and white, only mixes of red and
// blue, nothing beyond its radius, mirrored copies mirror images), grows
// and shrinks a dot, moves it with the pen, magnifies as a lens without
// piling up where growing piles up, and shakes the same with the same
// seed. The quick brush paints the pixel engine's hard round band to a
// level, washed and on the layer, through a selection, and erases. At the
// edges (left of and above the origin on a moved layer across its tiles,
// dabs of 1, 0.3 and 400 pixels, a thousand million pixels away, wrapped
// around the image) every engine's rectangles hold what it changed. And
// every engine paints 5000 dabs (mirrored, through a soft selection)
// without the value arena growing, leaves the heap as it was after the
// stroke, and every rectangle it returns holds what it changed. Prints
// dabs a second of each. Exits 13.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")
const types = @import("../brush/types.mlx")
const engines = @import("../brush/engines.mlx")
const stroke_module = @import("../brush/stroke.mlx")
const point = @import("../brush/point.mlx")
const smudge = @import("../brush/smudge_engine.mlx")
const clone = @import("../brush/clone_engine.mlx")
const filter = @import("../brush/filter_engine.mlx")
const deform = @import("../brush/deform_engine.mlx")
const quick = @import("../brush/quick_engine.mlx")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const node = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const ops = @import("../core/ops.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const registry = @import("../filters/registry.mlx")

const Device = device.Device
const Stroke = types.Stroke
const Settings = types.Settings
const Target = types.Target
const Rect = geom.Rect

const RED: u32 = 0xFFFF0000
const BLUE: u32 = 0xFF0000FF
const GREEN: u32 = 0xFF00FF00
const WHITE: u32 = 0xFFFFFFFF
const BLACK: u32 = 0xFF000000

// What every part of the test works with (made once in main).
const Ctx = struct {
    image: *image_module.Image
    layer: *node.Node
    brush: *Settings
    stroke: *Stroke
}

fn targetOn(ctx: *Ctx, onto: *Device, direct: bool) -> Target {
    return Target.{ .image = ctx.*.image, .node = ctx.*.layer, .device = onto, .direct = direct, .foreground = GREEN, .background = WHITE, .selection = null, .alphaLock = false, .mirrorHorizontal = false, .axisX = 0.0, .mirrorVertical = false, .axisY = 0.0, .wrap = false, .seed = 7, .sample = null }
}

// A whole stroke along a straight line at full pressure, cut into
// `pieces` events.
fn line(ctx: *Ctx, target: *const Target, x0: f64, y0: f64, x1: f64, y1: f64, pieces: usize) -> void {
    const first = point.at(x0, y0, 1.0, 0.0)
    _ = stroke_module.begin(ctx.*.stroke, target, ctx.*.brush, &first)
    var piece: usize = 1
    while piece <= pieces {
        const part = @floatFromInt(f64, piece) / @floatFromInt(f64, pieces)
        const next = point.at(x0 + (x1 - x0) * part, y0 + (y1 - y0) * part, 1.0, 1000.0 * part)
        _ = stroke_module.to(ctx.*.stroke, &next)
        piece += 1
    }
    _ = stroke_module.end(ctx.*.stroke)
}

// One dab at (x, y): a stroke without motion.
fn tap(ctx: *Ctx, target: *const Target, x: f64, y: f64) -> void {
    const first = point.at(x, y, 1.0, 0.0)
    _ = stroke_module.begin(ctx.*.stroke, target, ctx.*.brush, &first)
    _ = stroke_module.end(ctx.*.stroke)
}

// A brush of `engine` at `size`, hard, a tenth of it apart, its size not
// driven by the pressure, painting on the layer.
fn hard(settings: *Settings, size: f64) -> void {
    settings.*.size = size
    settings.*.tip.horizontalFade = 1.0
    settings.*.tip.verticalFade = 1.0
    settings.*.tip.spacing = 0.1
    settings.*.options[types.OPTION_SIZE].on = false
}

fn fillArea(on: *Device, x: i32, y: i32, width: i32, height: i32, color: u32) -> void {
    _ = device.fill(on, geom.rect(x, y, width, height), color)
}

// How many pixels of `area` differ between two devices.
fn differing(a: *Device, b: *Device, area: Rect) -> usize {
    var count: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if device.pixel(a, x, y) != device.pixel(b, x, y) { count += 1 }
            x += 1
        }
        y += 1
    }
    return count
}

// Whether every pixel of `area` that differs between `before` and `after`
// lies in `inside`.
fn changedWithin(before: *Device, after: *Device, area: Rect, inside: Rect) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if device.pixel(before, x, y) != device.pixel(after, x, y) && !geom.contains(inside, x, y) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

inline fn redOf(on: *Device, x: i32, y: i32) -> u32 { return pixel.red(device.pixel(on, x, y)) }

// A colour for every place, alpha included (0 and 255 among them).
fn pattern(x: i32, y: i32) -> u32 {
    var z = (@intCast(u64, @bitCast(u32, x)) *% 0x9E3779B97F4A7C15) ^ (@intCast(u64, @bitCast(u32, y)) *% 0xC2B2AE3D27D4EB4F)
    z = (z ^ (z >> 29)) *% 0xBF58476D1CE4E5B9
    z = z ^ (z >> 32)
    var alpha = @intCast(u32, (z >> 24) & 255)
    if (x + y) % 5 == 0 { alpha = 255 }
    if (x + y) % 7 == 0 { alpha = 0 }
    return (alpha << 24) | @intCast(u32, z & 0xFFFFFF)
}

fn paintPattern(on: *Device, x: i32, y: i32, width: i32, height: i32) -> void {
    var row = y
    while row < y + height {
        var column = x
        while column < x + width {
            device.setPixel(on, column, row, pattern(column, row))
            column += 1
        }
        row += 1
    }
}

fn show(what: []const u8, value: usize) -> void {
    _ = std.io.print(what)
    _ = std.io.writeUnsigned(std.io.stdout(), value)
    _ = std.io.println("")
}

// ---------------------------------------------------------------------------
// The list

fn checkRegistry(ctx: *Ctx) -> u8 {
    const smudging = engines.byKey("colorsmudge")
    if smudging == null || smudging.?.*.id != types.ENGINE_COLORSMUDGE { return 1 }
    const cloning = engines.byKey("duplicate")
    if cloning == null || cloning.?.*.id != types.ENGINE_DUPLICATE { return 2 }
    const filtering = engines.byKey("filter")
    if filtering == null || filtering.?.*.id != types.ENGINE_FILTER { return 3 }
    const deforming = engines.byKey("deform")
    if deforming == null || deforming.?.*.id != types.ENGINE_DEFORM { return 4 }
    const quickly = engines.byKey("quick")
    if quickly == null || quickly.?.*.id != quick.ENGINE_QUICK { return 5 }
    // The same records by number, and the pixel engine still first.
    if @intFromPtr(engines.find(types.ENGINE_COLORSMUDGE).?) != @intFromPtr(smudging.?) || @intFromPtr(engines.find(types.ENGINE_DUPLICATE).?) != @intFromPtr(cloning.?) { return 6 }
    if @intFromPtr(engines.find(types.ENGINE_FILTER).?) != @intFromPtr(filtering.?) || @intFromPtr(engines.find(types.ENGINE_DEFORM).?) != @intFromPtr(deforming.?) || @intFromPtr(engines.find(quick.ENGINE_QUICK).?) != @intFromPtr(quickly.?) { return 6 }
    if engines.count() < 7 || engines.at(0).?.*.id != types.ENGINE_PAINTBRUSH { return 6 }
    // The ones that read the layer paint on it; the quick brush as its
    // paint mode says.
    const direct = types.ENGINE_DIRECT
    if smudging.?.*.flags != types.ENGINE_READS_SAMPLE | direct || cloning.?.*.flags != types.ENGINE_READS_SAMPLE | direct || filtering.?.*.flags != direct || deforming.?.*.flags != direct || quickly.?.*.flags != 0 { return 7 }
    const brush = ctx.*.brush
    smudge.defaults(brush)
    brush.*.paintMode = types.MODE_WASH
    if stroke_module.paintsIndirectly(brush) { return 8 }
    quick.defaults(brush)
    if !stroke_module.paintsIndirectly(brush) { return 8 }
    brush.*.paintMode = types.MODE_BUILD_UP
    if stroke_module.paintsIndirectly(brush) { return 8 }
    if !std.text.same(engines.name(types.ENGINE_COLORSMUDGE, false), "Colour smudge") || !std.text.same(engines.name(types.ENGINE_DEFORM, true), "Verformen") || !std.text.same(engines.name(quick.ENGINE_QUICK, false), "Quick brush") { return 9 }
    // A preset names its engine and keeps the engine's numbers.
    deform.defaults(brush)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.SWIRL_CCW)
    var text = std.ArrayList(u8).init(std.heap.allocator())
    defer text.deinit()
    if !types.write(brush, &text) { return 9 }
    if std.text.find(text.items(), "engine = deform") == text.items().length { return 9 }
    types.defaults(brush)
    if !types.parse(text.items(), brush) || brush.*.engine != types.ENGINE_DEFORM || brush.*.values[deform.VALUE_MODE] != 3.0 || brush.*.values[deform.VALUE_AMOUNT] != 0.3 { return 9 }
    return 0
}

// ---------------------------------------------------------------------------
// Colour smudge

// Red left of x = 200, blue from there to 400 (and red again from 400 to
// 600 when `both`), rows 0 to 199.
fn redBlue(on: *Device, both: bool) -> void {
    device.clear(on)
    fillArea(on, 0, 0, 200, 200, RED)
    fillArea(on, 200, 0, 200, 200, BLUE)
    if both { fillArea(on, 400, 0, 200, 200, RED) }
}

// Whether every pixel of row `y` from x0 up to x1 is an opaque mix of
// red and blue.
fn redBlueMixes(on: *Device, x0: i32, x1: i32, y: i32) -> bool {
    var x = x0
    while x < x1 {
        const value = device.pixel(on, x, y)
        const sum = pixel.red(value) + pixel.blue(value)
        if value >> 24 != 255 || pixel.green(value) != 0 || sum < 254 || sum > 256 { return false }
        x += 1
    }
    return true
}

// Whether every pixel of `area` is `color`.
fn allOf(on: *Device, area: Rect, color: u32) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if device.pixel(on, x, y) != color { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// Whether the pixels of `area` are not all the same.
fn varied(on: *Device, area: Rect) -> bool {
    const first = device.pixel(on, area.x, area.y)
    return !allOf(on, area, first)
}

// Vertical stripes of black and white, three pixels each.
fn stripes(on: *Device) -> void {
    device.clear(on)
    var x: i32 = 0
    while x < 400 {
        fillArea(on, x, 0, 3, 200, if (x / 3) % 2 == 0 { BLACK } else { WHITE })
        x += 3
    }
}

fn checkSmudge(ctx: *Ctx) -> u8 {
    const allocator = std.heap.allocator()
    const brush = ctx.*.brush
    const plane = device.create(allocator, 0).?
    defer device.destroy(plane)
    const other = device.create(allocator, 0).?
    defer device.destroy(other)
    var target = targetOn(ctx, plane, true)
    smudge.defaults(brush)
    hard(brush, 20.0)

    // From red into blue along y = 100.5: red is dragged into the blue,
    // the further the longer the smudge length; nothing but mixes of the
    // two come out; the band is the brush's (rows 90 to 111, the outer
    // two half covered), and before the stroke nothing changed.
    redBlue(plane, false)
    brush.*.values[smudge.VALUE_LENGTH] = 0.9
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 7)
    if device.pixel(plane, 139, 100) != RED || device.pixel(plane, 260, 89) != BLUE || device.pixel(plane, 260, 112) != BLUE { return 10 }
    if !redBlueMixes(plane, 130, 370, 100) || !redBlueMixes(plane, 130, 370, 95) || !redBlueMixes(plane, 130, 370, 108) { return 11 }
    var x: i32 = 210
    while x <= 340 {
        if redOf(plane, x, 100) > redOf(plane, x - 10, 100) + 1 { return 12 }
        x += 10
    }
    if redOf(plane, 250, 100) < 200 || redOf(plane, 340, 100) < 100 || redOf(plane, 260, 92) < 100 { return 13 }
    redBlue(plane, false)
    brush.*.values[smudge.VALUE_LENGTH] = 0.5
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 3)
    if redOf(plane, 210, 100) < 150 || redOf(plane, 230, 100) > 60 || redOf(plane, 300, 100) > 20 || !redBlueMixes(plane, 130, 370, 100) { return 14 }
    redBlue(plane, false)
    brush.*.values[smudge.VALUE_LENGTH] = 0.2
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 1)
    if redOf(plane, 200, 100) < 100 || redOf(plane, 210, 100) > 40 || redOf(plane, 220, 100) > 5 { return 15 }
    // The smudge length times its option's: driven by the pressure, a
    // light pen drags nothing.
    redBlue(plane, false)
    brush.*.values[smudge.VALUE_LENGTH] = 0.9
    brush.*.options[types.OPTION_SMUDGE_LENGTH].on = true
    var pen = point.at(150.5, 100.5, 0.02, 0.0)
    _ = stroke_module.begin(ctx.*.stroke, &target, brush, &pen)
    pen = point.at(350.5, 100.5, 0.02, 100.0)
    _ = stroke_module.to(ctx.*.stroke, &pen)
    _ = stroke_module.end(ctx.*.stroke)
    if redOf(plane, 210, 100) > 5 || redOf(plane, 190, 100) != 255 { return 28 }
    brush.*.options[types.OPTION_SMUDGE_LENGTH].on = false

    // Smudge length 0: the paint colour alone at the colour rate (the
    // whole core green, nothing of red dragged), and with no colour rate
    // nothing changes at all.
    redBlue(plane, false)
    brush.*.values[smudge.VALUE_LENGTH] = 0.0
    brush.*.values[smudge.VALUE_RATE] = 1.0
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 5)
    if !allOf(plane, geom.rect(151, 91, 199, 19), GREEN) || !allOf(plane, geom.rect(141, 100, 219, 1), GREEN) || device.pixel(plane, 140, 89) != RED || device.pixel(plane, 300, 112) != BLUE { return 16 }
    redBlue(plane, false)
    redBlue(other, false)
    brush.*.values[smudge.VALUE_RATE] = 0.0
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 5)
    if differing(plane, other, geom.rect(100, 50, 300, 100)) != 0 { return 17 }
    // Half the colour rate: a dab lays half green over what is there, and
    // dabs that follow add their halves.
    brush.*.values[smudge.VALUE_RATE] = 0.5
    tap(ctx, &target, 300.5, 100.5)
    if device.pixel(plane, 300, 100) != pixel.over(BLUE, GREEN, 128) || device.pixel(plane, 300, 89) != BLUE { return 18 }
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 5)
    if pixel.green(device.pixel(plane, 250, 100)) < 250 { return 18 }

    // Dulling carries one colour: the core of the last dab is one colour,
    // where smearing carries the stripes along; the two differ.
    brush.*.values[smudge.VALUE_RATE] = 0.0
    brush.*.values[smudge.VALUE_LENGTH] = 0.9
    stripes(plane)
    line(ctx, &target, 100.5, 100.5, 200.5, 100.5, 4)
    const last_x = @intFromFloat(i32, @floor(ctx.*.stroke.*.dab.x))
    const core = geom.rect(last_x - 5, 95, 11, 11)
    if !varied(plane, core) { return 19 }
    stripes(other)
    brush.*.values[smudge.VALUE_MODE] = smudge.DULLING
    brush.*.values[smudge.VALUE_RADIUS] = 1.0
    target.device = other
    line(ctx, &target, 100.5, 100.5, 200.5, 100.5, 4)
    const dulled = device.pixel(other, last_x, 100)
    if !allOf(other, core, dulled) || differing(plane, other, geom.rect(80, 80, 140, 40)) < 1000 { return 20 }
    // ... a grey of the stripes' mean, as grey as they are together.
    if pixel.red(dulled) != pixel.green(dulled) || pixel.red(dulled) != pixel.blue(dulled) || pixel.red(dulled) < 80 || pixel.red(dulled) > 175 || dulled >> 24 != 255 { return 21 }
    // Dulling from red into blue drags red too, as one colour a dab.
    redBlue(other, false)
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 7)
    if redOf(other, 220, 100) < 100 || !redBlueMixes(other, 130, 370, 100) { return 22 }

    // Overlay: the colour comes from the sample (all layers), the paint
    // goes onto the layer: an empty layer gets the smudged picture; read
    // from itself it stays empty.
    brush.*.values[smudge.VALUE_MODE] = smudge.SMEARING
    redBlue(other, false)
    device.clear(plane)
    target.device = plane
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 7)
    if !device.isBlank(plane) { return 23 }
    brush.*.values[smudge.VALUE_OVERLAY] = 1.0
    target.sample = other
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 7)
    if device.pixel(plane, 250, 100) >> 24 != 255 || redOf(plane, 250, 100) < 200 || !redBlueMixes(plane, 141, 360, 100) || device.pixel(plane, 250, 89) != 0 { return 24 }
    if device.pixel(other, 250, 100) != BLUE { return 24 }
    target.sample = null
    brush.*.values[smudge.VALUE_OVERLAY] = 0.0

    // Smudging colour only: dragged into transparency, the transparent
    // pixels stay so; smearing alpha too, they get paint.
    device.clear(plane)
    fillArea(plane, 0, 0, 200, 200, RED)
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 7)
    if device.pixel(plane, 230, 100) >> 24 < 200 || redOf(plane, 230, 100) != 255 { return 25 }
    device.clear(plane)
    fillArea(plane, 0, 0, 200, 200, RED)
    brush.*.values[smudge.VALUE_KEEP_ALPHA] = 1.0
    line(ctx, &target, 150.5, 100.5, 350.5, 100.5, 7)
    if device.pixel(plane, 230, 100) >> 24 != 0 || device.pixel(plane, 190, 100) != RED { return 26 }
    brush.*.values[smudge.VALUE_KEEP_ALPHA] = 0.0

    // Mirrored, each copy drags its own paint: red | blue | red mirrored
    // about x = 300, a stroke from 150 to 250 and its copy from 450 to
    // 350 leave mirror images.
    redBlue(plane, true)
    target.mirrorHorizontal = true
    target.axisX = 300.0
    line(ctx, &target, 150.5, 100.5, 250.5, 100.5, 5)
    target.mirrorHorizontal = false
    var y: i32 = 88
    while y < 114 {
        x = 130
        while x < 300 {
            if device.pixel(plane, x, y) != device.pixel(plane, 599 - x, y) { return 27 }
            x += 1
        }
        y += 1
    }
    if redOf(plane, 230, 100) < 200 || redOf(plane, 369, 100) < 200 { return 27 }
    return 0
}

// ---------------------------------------------------------------------------
// Clone

// Whether two pixels look the same (the colour of a transparent one does
// not count).
fn seenSame(a: u32, b: u32) -> bool {
    return a == b || (a >> 24 == 0 && b >> 24 == 0)
}

// Whether every pixel of `area` on `on` is the pattern's `dx`, `dy` away.
fn copiedFrom(on: *Device, area: Rect, dx: i32, dy: i32) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if !seenSame(device.pixel(on, x, y), pattern(x + dx, y + dy)) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

fn checkClone(ctx: *Ctx) -> u8 {
    const allocator = std.heap.allocator()
    const brush = ctx.*.brush
    const plane = device.create(allocator, 0).?
    defer device.destroy(plane)
    const other = device.create(allocator, 0).?
    defer device.destroy(other)
    var target = targetOn(ctx, plane, true)
    // The source: a pattern of every colour and alpha, from (40, 40) to
    // (120, 160); where it goes: grey.
    paintPattern(plane, 40, 40, 80, 120)
    fillArea(plane, 280, 40, 120, 120, 0xFF808080)
    clone.defaults(brush)
    hard(brush, 20.0)

    // No source: nothing is painted.
    target.device = other
    paintPattern(other, 40, 40, 80, 120)
    fillArea(other, 280, 40, 120, 120, 0xFF808080)
    line(ctx, &target, 310.5, 80.5, 350.5, 80.5, 3)
    if differing(plane, other, geom.rect(0, 0, 450, 200)) != 0 || clone.hasSource(brush) { return 30 }
    target.device = plane

    // From (60.5, 80.5) to a stroke from (310.5, 80.5): the pattern 250 to
    // the left, to the bit where the hard tip covers all (rows 71 to 89,
    // the caps left out), alpha 0 and 255 and between included; nothing
    // outside the band.
    clone.setSource(brush, 60.5, 80.5)
    if !clone.hasSource(brush) { return 31 }
    line(ctx, &target, 310.5, 80.5, 350.5, 80.5, 3)
    if !copiedFrom(plane, geom.rect(311, 71, 39, 19), -250, 0) || !copiedFrom(plane, geom.rect(301, 80, 59, 1), -250, 0) { return 32 }
    if device.pixel(plane, 330, 69) != 0xFF808080 || device.pixel(plane, 330, 91) != 0xFF808080 || device.pixel(plane, 299, 80) != 0xFF808080 || device.pixel(plane, 361, 80) != 0xFF808080 { return 33 }
    // The source itself is as it was.
    if !copiedFrom(plane, geom.rect(40, 40, 80, 120), 0, 0) { return 34 }

    // The offset stays for the strokes after (aligned) ...
    clone.keepAlignment(ctx.*.stroke, brush)
    line(ctx, &target, 310.5, 130.5, 350.5, 130.5, 2)
    if !copiedFrom(plane, geom.rect(311, 121, 39, 19), -250, 0) { return 35 }
    // ... unless every stroke starts at the source.
    brush.*.values[clone.VALUE_RESET] = 1.0
    clone.keepAlignment(ctx.*.stroke, brush)
    line(ctx, &target, 330.5, 120.5, 340.5, 120.5, 1)
    if !copiedFrom(plane, geom.rect(331, 111, 9, 19), -270, -40) { return 36 }
    brush.*.values[clone.VALUE_RESET] = 0.0
    // A new source: the next stroke anchors again.
    clone.setSource(brush, 100.5, 60.5)
    if brush.*.values[clone.VALUE_ANCHORED] != 0.0 { return 37 }
    line(ctx, &target, 380.5, 60.5, 380.5, 70.5, 1)
    if !copiedFrom(plane, geom.rect(371, 61, 19, 9), -280, 0) { return 37 }

    // Cloning from the sample (all layers): the layer gets the sample's
    // pattern, the sample stays.
    device.clear(other)
    paintPattern(other, 40, 40, 80, 120)
    device.clear(plane)
    target.sample = other
    clone.setSource(brush, 60.5, 80.5)
    line(ctx, &target, 310.5, 80.5, 350.5, 80.5, 3)
    if !copiedFrom(plane, geom.rect(311, 71, 39, 19), -250, 0) { return 38 }
    if !copiedFrom(other, geom.rect(40, 40, 80, 120), 0, 0) || !geom.isEmpty(geom.intersect(device.exactBounds(plane), geom.rect(0, 0, 200, 200))) { return 38 }
    target.sample = null

    // Healing: a dark patch with a light spot, cloned onto a lighter
    // grey, takes on the grey's brightness and keeps its spot.
    device.clear(plane)
    fillArea(plane, 40, 40, 60, 60, 0xFF404040)
    fillArea(plane, 69, 69, 3, 3, 0xFF505050)
    fillArea(plane, 240, 40, 60, 60, 0xFF808080)
    clone.setSource(brush, 70.5, 70.5)
    brush.*.values[clone.VALUE_HEALING] = 1.0
    tap(ctx, &target, 270.5, 70.5)
    const healed = device.pixel(plane, 263, 70)
    const spot = device.pixel(plane, 270, 70)
    if pixel.red(healed) < 0x7E || pixel.red(healed) > 0x80 || pixel.red(spot) < 0x8E || pixel.red(spot) > 0x90 || healed >> 24 != 255 { return 39 }
    brush.*.values[clone.VALUE_HEALING] = 0.0
    tap(ctx, &target, 270.5, 70.5)
    if device.pixel(plane, 263, 70) != 0xFF404040 || device.pixel(plane, 270, 70) != 0xFF505050 { return 39 }
    return 0
}

// ---------------------------------------------------------------------------
// Filter brush

// A picture where every pixel differs from its neighbours.
fn gradient(on: *Device) -> void {
    device.clear(on)
    var y: i32 = 0
    while y < 300 {
        var x: i32 = 0
        while x < 400 {
            device.setPixel(on, x, y, 0xFF000000 | (@intCast(u32, x & 255) << 16) | (@intCast(u32, (y * 3) & 255) << 8) | @intCast(u32, (x * 7 + y) & 255))
            x += 1
        }
        y += 1
    }
}

// A stroke there and back again along y = 100.5 from x = 100.5 to 200.5.
fn thereAndBack(ctx: *Ctx, target: *const Target) -> void {
    const first = point.at(100.5, 100.5, 1.0, 0.0)
    _ = stroke_module.begin(ctx.*.stroke, target, ctx.*.brush, &first)
    const far = point.at(200.5, 100.5, 1.0, 100.0)
    _ = stroke_module.to(ctx.*.stroke, &far)
    const back = point.at(100.5, 100.5, 1.0, 200.0)
    _ = stroke_module.to(ctx.*.stroke, &back)
    _ = stroke_module.end(ctx.*.stroke)
}

// Whether every pixel of `area` is the one of `original` with its colour
// inverted (as seen: the colour of a transparent one does not count).
fn inverted(on: *Device, original: *Device, area: Rect) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if !seenSame(device.pixel(on, x, y), device.pixel(original, x, y) ^ 0x00FFFFFF) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// Whether the pixels of `area` are the ones of `original` blurred as the
// brush's filter blurs the whole picture (to a level).
fn blurredLike(ctx: *Ctx, on: *Device, original: *Device, area: Rect) -> bool {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(400 * 300 * 4, 16)
    if memory == null { return false }
    defer allocator.free(memory.?, 400 * 300 * 4, 16)
    const whole: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    device.readRect(original, geom.rect(0, 0, 400, 300), whole, 400)
    const params_memory = allocator.alloc(@sizeOf(node.Params), 16)
    if params_memory == null { return false }
    defer allocator.free(params_memory.?, @sizeOf(node.Params), 16)
    const params: *node.Params = unsafe { @ptrCast(*node.Params, params_memory.?) }
    registry.defaults(filter.filterOf(ctx.*.brush).?.*.id, params)
    if !registry.apply(params, whole, 400, 300, 400) { return false }
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            const got = device.pixel(on, x, y)
            const wanted = whole[@intCast(usize, y * 400 + x)]
            if got >> 24 != 255 || pixel.red(got) + 1 < pixel.red(wanted) || pixel.red(got) > pixel.red(wanted) + 1 || pixel.green(got) + 1 < pixel.green(wanted) || pixel.green(got) > pixel.green(wanted) + 1 || pixel.blue(got) + 1 < pixel.blue(wanted) || pixel.blue(got) > pixel.blue(wanted) + 1 { return false }
            x += 1
        }
        y += 1
    }
    return true
}

fn checkFilter(ctx: *Ctx) -> u8 {
    const allocator = std.heap.allocator()
    const brush = ctx.*.brush
    const plane = device.create(allocator, 0).?
    defer device.destroy(plane)
    gradient(plane)
    const original = device.copy(plane).?
    defer device.destroy(original)
    var target = targetOn(ctx, plane, true)
    filter.defaults(brush)
    hard(brush, 20.0)
    if filter.filterOf(brush) == null || !std.text.same(filter.filterOf(brush).?.*.key, "blur") { return 50 }
    if !filter.setFilter(brush, "invert") || filter.setFilter(brush, "no such filter") || !std.text.same(types.textOf(brush), "invert") { return 50 }

    // Invert, there and back again, with the layer's change open (as the
    // tool paints): inverted once wherever the hard tip covered all, the
    // half covered rows between, nothing beyond.
    device.begin(plane)
    thereAndBack(ctx, &target)
    if !inverted(plane, original, geom.rect(101, 91, 99, 19)) || !inverted(plane, original, geom.rect(91, 100, 119, 1)) { return 51 }
    if differing(plane, original, geom.rect(0, 0, 400, 90)) != 0 || differing(plane, original, geom.rect(0, 111, 400, 189)) != 0 || differing(plane, original, geom.rect(0, 90, 90, 21)) != 0 || differing(plane, original, geom.rect(211, 90, 189, 21)) != 0 { return 52 }
    const half = device.pixel(plane, 150, 90)
    if half == device.pixel(original, 150, 90) || half == device.pixel(original, 150, 90) ^ 0x00FFFFFF { return 53 }
    _ = device.rollback(plane)
    if differing(plane, original, geom.rect(0, 0, 400, 300)) != 0 { return 54 }
    // The same with no change open (the engine keeps the layer as it was
    // itself), and twice over: a stroke does not invert what it inverted.
    thereAndBack(ctx, &target)
    if !inverted(plane, original, geom.rect(101, 91, 99, 19)) || differing(plane, original, geom.rect(0, 0, 400, 90)) != 0 { return 55 }
    // A second stroke inverts back.
    thereAndBack(ctx, &target)
    if differing(plane, original, geom.rect(101, 91, 99, 19)) != 0 { return 56 }

    // A blur reads around the dab: the stroke's core is the picture
    // blurred as a whole.
    gradient(plane)
    if !filter.setFilter(brush, "blur") { return 57 }
    thereAndBack(ctx, &target)
    if !blurredLike(ctx, plane, original, geom.rect(101, 91, 99, 19)) || differing(plane, original, geom.rect(0, 0, 400, 89)) != 0 { return 58 }

    // A filter that is not known: the stroke does not begin, nothing is
    // painted.
    gradient(plane)
    types.setText(brush, "no such filter")
    if filter.filterOf(brush) != null { return 59 }
    const first = point.at(150.5, 100.5, 1.0, 0.0)
    _ = stroke_module.begin(ctx.*.stroke, &target, brush, &first)
    if stroke_module.isActive(ctx.*.stroke) || differing(plane, original, geom.rect(0, 0, 400, 300)) != 0 { return 59 }
    return 0
}

// ---------------------------------------------------------------------------
// Deform

// Whether every pixel of `area` is an opaque grey.
fn greys(on: *Device, area: Rect) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            const value = device.pixel(on, x, y)
            if value >> 24 != 255 || pixel.red(value) != pixel.green(value) || pixel.red(value) != pixel.blue(value) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// How many pixels of `area` are darker than half, and the sum of their
// columns.
fn dark(on: *Device, area: Rect, columns: *i64) -> usize {
    var count: usize = 0
    columns.* = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if pixel.red(device.pixel(on, x, y)) < 128 {
                count += 1
                columns.* += @intCast(i64, x)
            }
            x += 1
        }
        y += 1
    }
    return count
}

// White, with a black disc of radius 4.5 around the centre of pixel
// (x, y).
fn dot(on: *Device, x: i32, y: i32) -> void {
    var dy: i32 = -5
    while dy <= 5 {
        var dx: i32 = -5
        while dx <= 5 {
            if dx * dx + dy * dy <= 20 { device.setPixel(on, x + dx, y + dy, BLACK) }
            dx += 1
        }
        dy += 1
    }
}

// White with black bars three pixels high: right of (150, 150) for 40
// pixels, and their mirror image about x = 300.
fn bars(on: *Device) -> void {
    device.clear(on)
    fillArea(on, 0, 0, 600, 300, WHITE)
    fillArea(on, 150, 149, 40, 3, BLACK)
    fillArea(on, 410, 149, 40, 3, BLACK)
}

fn checkDeform(ctx: *Ctx) -> u8 {
    const allocator = std.heap.allocator()
    const brush = ctx.*.brush
    const plane = device.create(allocator, 0).?
    defer device.destroy(plane)
    const other = device.create(allocator, 0).?
    defer device.destroy(other)
    var target = targetOn(ctx, plane, true)
    deform.defaults(brush)
    hard(brush, 60.0)
    brush.*.values[deform.VALUE_AMOUNT] = 1.0

    // A clockwise swirl turns the bar right of the centre down (on the
    // screen), only greys come out, and nothing beyond the radius moves.
    bars(plane)
    _ = device.assign(other, plane)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.SWIRL_CW)
    tap(ctx, &target, 150.5, 150.5)
    if redOf(plane, 160, 160) > 100 || redOf(plane, 160, 140) < 200 || redOf(plane, 150, 150) != 0 { return 60 }
    if !greys(plane, geom.rect(110, 110, 81, 81)) { return 61 }
    if differing(plane, other, geom.rect(110, 110, 81, 81)) < 100 || device.pixel(plane, 182, 150) != BLACK || device.pixel(plane, 175, 175) != WHITE || differing(plane, other, geom.rect(0, 0, 118, 300)) != 0 { return 62 }
    // Counter-clockwise the other way.
    bars(plane)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.SWIRL_CCW)
    tap(ctx, &target, 150.5, 150.5)
    if redOf(plane, 160, 140) > 100 || redOf(plane, 160, 160) < 200 || !greys(plane, geom.rect(110, 110, 81, 81)) { return 63 }
    // Red and blue only mix: no green, red and blue adding up to all; at
    // the top red comes from the left, at the bottom blue from the right.
    redBlue(plane, false)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.SWIRL_CW)
    tap(ctx, &target, 200.5, 100.5)
    var y: i32 = 70
    while y < 131 {
        if !redBlueMixes(plane, 160, 241, y) { return 64 }
        y += 1
    }
    if redOf(plane, 200, 80) < 200 || redOf(plane, 200, 120) > 55 { return 64 }
    // Mirrored, the copy turns the other way: mirror images.
    bars(plane)
    target.mirrorHorizontal = true
    target.axisX = 300.0
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.SWIRL_CW)
    tap(ctx, &target, 150.5, 150.5)
    target.mirrorHorizontal = false
    y = 110
    while y < 191 {
        var x: i32 = 110
        while x < 191 {
            if device.pixel(plane, x, y) != device.pixel(plane, 599 - x, y) { return 65 }
            x += 1
        }
        y += 1
    }

    // Growing enlarges a dot, shrinking makes it smaller.
    var columns: i64 = 0
    device.clear(plane)
    fillArea(plane, 0, 0, 400, 300, WHITE)
    dot(plane, 100, 100)
    const before = dark(plane, geom.rect(60, 60, 81, 81), &columns)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.GROW)
    tap(ctx, &target, 100.5, 100.5)
    const grown = dark(plane, geom.rect(60, 60, 81, 81), &columns)
    if before < 50 || grown < before * 3 / 2 || !greys(plane, geom.rect(60, 60, 81, 81)) { return 66 }
    fillArea(plane, 0, 0, 400, 300, WHITE)
    dot(plane, 100, 100)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.SHRINK)
    tap(ctx, &target, 100.5, 100.5)
    if dark(plane, geom.rect(60, 60, 81, 81), &columns) * 3 / 2 > before { return 67 }

    // Moving takes the dot along with the pen.
    fillArea(plane, 0, 0, 400, 300, WHITE)
    dot(plane, 100, 200)
    var start: i64 = 0
    const count = dark(plane, geom.rect(60, 160, 120, 81), &start)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.MOVE)
    line(ctx, &target, 100.5, 200.5, 130.5, 200.5, 6)
    var moved: i64 = 0
    const after = dark(plane, geom.rect(60, 160, 120, 81), &moved)
    if after == 0 || moved / @intCast(i64, after) < start / @intCast(i64, count) + 5 { return 68 }

    // Grow piles up dab after dab; the lens reads the layer as it was
    // before the stroke: dabs on one place (an airbrush resting) are one.
    fillArea(plane, 0, 0, 400, 300, WHITE)
    dot(plane, 100, 100)
    _ = device.assign(other, plane)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.LENS_IN)
    tap(ctx, &target, 100.5, 100.5)
    if dark(plane, geom.rect(60, 60, 81, 81), &columns) < before * 3 / 2 { return 69 }
    target.device = other
    brush.*.airbrush = true
    const resting = point.at(100.5, 100.5, 1.0, 0.0)
    _ = stroke_module.begin(ctx.*.stroke, &target, brush, &resting)
    _ = stroke_module.tick(ctx.*.stroke, 200.0)
    _ = stroke_module.end(ctx.*.stroke)
    if ctx.*.stroke.*.dabs < 5 || differing(plane, other, geom.rect(60, 60, 81, 81)) != 0 { return 70 }
    fillArea(other, 0, 0, 400, 300, WHITE)
    dot(other, 100, 100)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.GROW)
    _ = stroke_module.begin(ctx.*.stroke, &target, brush, &resting)
    _ = stroke_module.tick(ctx.*.stroke, 200.0)
    _ = stroke_module.end(ctx.*.stroke)
    if dark(other, geom.rect(60, 60, 81, 81), &columns) <= grown { return 71 }
    brush.*.airbrush = false
    target.device = plane

    // Colour deformation shakes the pixels: only greys of the stripes,
    // the same with the same seed, others with another.
    stripes(plane)
    stripes(other)
    brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, deform.COLOR)
    tap(ctx, &target, 100.5, 100.5)
    target.device = other
    tap(ctx, &target, 100.5, 100.5)
    if differing(plane, other, geom.rect(60, 60, 81, 81)) != 0 || !greys(plane, geom.rect(60, 60, 81, 81)) { return 72 }
    stripes(other)
    target.seed = 8
    tap(ctx, &target, 100.5, 100.5)
    if differing(plane, other, geom.rect(60, 60, 81, 81)) < 100 { return 73 }
    stripes(other)
    if differing(plane, other, geom.rect(60, 60, 81, 81)) < 100 { return 73 }
    return 0
}

// ---------------------------------------------------------------------------
// Quick brush

// Whether two devices hold the same pixels in `area` to a level of alpha
// and of each channel (the colour of a transparent pixel not counting).
fn alike(a: *Device, b: *Device, area: Rect) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            const one = device.pixel(a, x, y)
            const two = device.pixel(b, x, y)
            if one != two {
                if one >> 24 + 1 < two >> 24 || two >> 24 + 1 < one >> 24 { return false }
                if one >> 24 != 0 && two >> 24 != 0 {
                    if pixel.red(one) + 1 < pixel.red(two) || pixel.red(two) + 1 < pixel.red(one) { return false }
                    if pixel.green(one) + 1 < pixel.green(two) || pixel.green(two) + 1 < pixel.green(one) { return false }
                    if pixel.blue(one) + 1 < pixel.blue(two) || pixel.blue(two) + 1 < pixel.blue(one) { return false }
                }
            }
            x += 1
        }
        y += 1
    }
    return true
}

// The same strokes with the pixel engine's hard round brush on `a` and
// the quick brush on `b`: along a row, slanted, and a dab alone.
fn bothBrushes(ctx: *Ctx, target: *Target, a: *Device, b: *Device, opacity: f64, flow: f64) -> void {
    const brush = ctx.*.brush
    const engines_of = [2]u16{ types.ENGINE_PAINTBRUSH, quick.ENGINE_QUICK }
    for engine, index in engines_of {
        types.defaults(brush)
        hard(brush, 30.0)
        brush.*.engine = engine
        brush.*.opacity = opacity
        brush.*.flow = flow
        target.*.device = if index == 0 { a } else { b }
        line(ctx, target, 100.5, 100.5, 300.5, 100.5, 4)
        line(ctx, target, 100.3, 150.7, 290.1, 230.2, 9)
        tap(ctx, target, 350.25, 60.625)
    }
}

fn checkQuick(ctx: *Ctx) -> u8 {
    const allocator = std.heap.allocator()
    const brush = ctx.*.brush
    const a = device.create(allocator, 0).?
    defer device.destroy(a)
    const b = device.create(allocator, 0).?
    defer device.destroy(b)
    const whole = geom.rect(60, 30, 340, 240)
    // Washed (on an overlay): the same band to a level, at full opacity
    // and below it.
    var target = targetOn(ctx, a, false)
    bothBrushes(ctx, &target, a, b, 1.0, 1.0)
    if !alike(a, b, whole) || device.pixel(b, 200, 100) != GREEN || device.pixel(b, 200, 84) != 0 || device.pixel(b, 200, 116) != 0 { return 80 }
    device.clear(a)
    device.clear(b)
    bothBrushes(ctx, &target, a, b, 0.6, 0.3)
    if !alike(a, b, whole) || device.pixel(b, 200, 100) >> 24 > 153 || device.pixel(b, 200, 100) >> 24 < 140 { return 81 }
    // On the layer (build-up), over a picture: the same, to a level.
    target.direct = true
    gradient(a)
    gradient(b)
    bothBrushes(ctx, &target, a, b, 0.5, 1.0)
    if !alike(a, b, whole) || pixel.green(device.pixel(b, 200, 100)) < 250 || device.pixel(b, 200, 80) != device.pixel(a, 200, 80) { return 82 }
    // Through a selection, and as an eraser.
    const limits = mask.create(allocator, false).?
    defer device.destroy(limits)
    _ = device.fill(limits, geom.rect(0, 0, 200, 400), pixel.gray(255))
    target.selection = limits
    gradient(a)
    gradient(b)
    bothBrushes(ctx, &target, a, b, 1.0, 1.0)
    if !alike(a, b, whole) || device.pixel(b, 150, 100) != GREEN || differing(a, b, geom.rect(200, 0, 200, 300)) != 0 || device.pixel(b, 250, 100) == GREEN { return 83 }
    target.selection = null
    quick.defaults(brush)
    hard(brush, 30.0)
    brush.*.eraser = true
    gradient(b)
    target.device = b
    line(ctx, &target, 100.5, 100.5, 300.5, 100.5, 4)
    if device.pixel(b, 200, 100) >> 24 != 0 || device.pixel(b, 200, 80) >> 24 != 255 { return 84 }
    return 0
}

// ---------------------------------------------------------------------------
// Every engine: 5000 dabs and the value arena, the heap after the stroke,
// the rectangles, the speed

// The pen on leg `leg` of a long stroke: a knot inside 40..560 x 40..360.
fn legPoint(pen: *point.Point, leg: usize) -> void {
    const turn = @floatFromInt(f64, leg) * 0.37
    pen.* = point.at(300.0 + 250.0 * math.sin(turn * 0.71), 200.0 + 150.0 * math.sin(turn), 0.5 + 0.5 * math.abs(math.sin(turn * 3.0)), @floatFromInt(f64, leg) * 30.0)
}

// A stroke of at least `dabs` dabs along the knot; the bytes the value
// arena grew by meanwhile. (A function of its own: in a frame as full as
// the checks' a Point would be taken from the arena.)
fn longStroke(ctx: *Ctx, target: *const Target, dabs: u32) -> usize {
    var pen = point.at(300.0, 200.0, 0.5, 0.0)
    _ = stroke_module.begin(ctx.*.stroke, target, ctx.*.brush, &pen)
    const arena = turns.locate()
    const before = turns.used(arena)
    var leg: usize = 1
    while ctx.*.stroke.*.dabs < dabs && leg < 1000000 {
        legPoint(&pen, leg)
        _ = stroke_module.to(ctx.*.stroke, &pen)
        leg += 1
    }
    const grown = turns.used(arena) - before
    _ = stroke_module.end(ctx.*.stroke)
    return grown
}

// Whether every pixel of `region` that differs between `before` and
// `after` (a copy of it made before a call: the tiles the call did not
// write are still the same tiles) lies in `inside`.
fn changesWithin(before: *Device, after: *Device, region: Rect, inside: Rect) -> bool {
    const left = (region.x - after.*.x) >> 6
    const top = (region.y - after.*.y) >> 6
    const right = (region.x + region.width - 1 - after.*.x) >> 6
    const bottom = (region.y + region.height - 1 - after.*.y) >> 6
    var ty = top
    while ty <= bottom {
        var tx = left
        while tx <= right {
            const old = device.tileRead(before, tx, ty)
            const now = device.tileRead(after, tx, ty)
            const same = (old == null && now == null) || (old != null && now != null && @intFromPtr(old.?) == @intFromPtr(now.?))
            if !same && !changedWithin(before, after, device.tileArea(after, tx, ty), inside) { return false }
            tx += 1
        }
        ty += 1
    }
    return true
}

// A stroke along the knot, every rectangle a call returns checked
// against what changed (a copy of the layer before each call). False
// when a change lies outside.
fn rectanglesHold(ctx: *Ctx, target: *const Target, legs: usize) -> bool {
    const on = target.*.device
    var pen = point.at(300.0, 200.0, 0.5, 0.0)
    var before = device.copy(on).?
    var area = stroke_module.begin(ctx.*.stroke, target, ctx.*.brush, &pen)
    var leg: usize = 1
    var whole_ok = true
    while leg <= legs + 1 {
        if !changesWithin(before, on, geom.rect(0, 0, 600, 400), area) { whole_ok = false }
        device.destroy(before)
        before = device.copy(on).?
        if leg <= legs {
            legPoint(&pen, leg)
            area = stroke_module.to(ctx.*.stroke, &pen)
        } else {
            area = stroke_module.end(ctx.*.stroke)
        }
        leg += 1
    }
    if !changesWithin(before, on, geom.rect(0, 0, 600, 400), area) { whole_ok = false }
    device.destroy(before)
    return whole_ok
}

// The brush of engine number `which` for the long strokes.
fn brushFor(brush: *Settings, which: usize) -> void {
    if which <= 1 {
        smudge.defaults(brush)
        brush.*.values[smudge.VALUE_MODE] = if which == 0 { smudge.SMEARING } else { smudge.DULLING }
        brush.*.values[smudge.VALUE_RATE] = 0.2
        brush.*.options[types.OPTION_SMUDGE_LENGTH].on = true
    } else if which == 2 {
        clone.defaults(brush)
        clone.setSource(brush, 200.5, 150.5)
        brush.*.values[clone.VALUE_HEALING] = 1.0
    } else if which == 3 {
        filter.defaults(brush)
        _ = filter.setFilter(brush, "invert")
    } else if which <= 5 {
        deform.defaults(brush)
        brush.*.values[deform.VALUE_MODE] = @floatFromInt(f32, if which == 4 { deform.SWIRL_CW } else { deform.MOVE })
        brush.*.values[deform.VALUE_AMOUNT] = 0.5
    } else {
        quick.defaults(brush)
    }
    brush.*.size = 24.0
}

fn nameOf(which: usize) -> []const u8 {
    if which == 0 { return "colorsmudge (smearing)" }
    if which == 1 { return "colorsmudge (dulling)" }
    if which == 2 { return "duplicate (healing)" }
    if which == 3 { return "filter (invert)" }
    if which == 4 { return "deform (swirl)" }
    if which == 5 { return "deform (move)" }
    return "quick"
}

fn checkEvery(ctx: *Ctx) -> u8 {
    const allocator = std.heap.allocator()
    const brush = ctx.*.brush
    const plane = device.create(allocator, 0).?
    defer device.destroy(plane)
    const limits = mask.create(allocator, false).?
    defer device.destroy(limits)
    _ = device.fill(limits, geom.rect(0, 0, 400, 400), pixel.gray(255))
    _ = device.fill(limits, geom.rect(400, 0, 200, 400), pixel.gray(120))
    var target = targetOn(ctx, plane, true)
    target.mirrorHorizontal = true
    target.axisX = 300.0
    target.selection = limits
    var which: usize = 0
    while which < 7 {
        // The layer has tiles everywhere the strokes go: what grows in
        // the heap is the engines'.
        gradient(plane)
        fillArea(plane, 400, 0, 200, 400, 0xFF336699)
        fillArea(plane, 0, 300, 400, 100, 0x80996633)
        brushFor(brush, which)
        // (A stroke first: the tip's masks, the working memory and the
        // filters' lists are made at their first use and stay.)
        if !rectanglesHold(ctx, &target, 40) { return 100 + @intCast(u8, which) }
        const live = std.heap.liveBytes()
        const began = std.time.monotonicNanoseconds()
        const grown = longStroke(ctx, &target, 5000)
        var spent = std.time.monotonicNanoseconds() - began
        if spent == 0 { spent = 1 }
        if ctx.*.stroke.*.dabs < 5000 || grown > 16384 { return 110 + @intCast(u8, which) }
        if std.heap.liveBytes() != live { return 120 + @intCast(u8, which) }
        _ = std.io.print(nameOf(which))
        show(": dabs a second ", @intCast(usize, ctx.*.stroke.*.dabs) * 1000000000 / spent)
        which += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Edges: left of and above the origin across tiles of a moved layer, the
// smallest and large dabs, far away, wrapped around the image

// A stroke from (x0, y0) to (x1, y1) in `pieces` events whose every
// returned rectangle holds what the call changed (looked for in `region`).
fn strokeHolds(ctx: *Ctx, target: *const Target, region: Rect, x0: f64, y0: f64, x1: f64, y1: f64, pieces: usize) -> bool {
    const on = target.*.device
    var held = true
    var before = device.copy(on).?
    var pen = point.at(x0, y0, 1.0, 0.0)
    var area = stroke_module.begin(ctx.*.stroke, target, ctx.*.brush, &pen)
    var piece: usize = 1
    while piece <= pieces + 1 {
        if !changesWithin(before, on, region, area) { held = false }
        device.destroy(before)
        before = device.copy(on).?
        if piece <= pieces {
            const part = @floatFromInt(f64, piece) / @floatFromInt(f64, pieces)
            pen = point.at(x0 + (x1 - x0) * part, y0 + (y1 - y0) * part, 1.0, 100.0 * part)
            area = stroke_module.to(ctx.*.stroke, &pen)
        } else {
            area = stroke_module.end(ctx.*.stroke)
        }
        piece += 1
    }
    if !changesWithin(before, on, region, area) { held = false }
    device.destroy(before)
    return held
}

fn checkEdges(ctx: *Ctx) -> u8 {
    const allocator = std.heap.allocator()
    const brush = ctx.*.brush
    const plane = device.create(allocator, 0).?
    defer device.destroy(plane)
    // A layer moved off the origin: its tiles begin at -37 + 64 k and
    // -21 + 64 k.
    device.moveTo(plane, -37, -21)
    var target = targetOn(ctx, plane, true)
    const near = geom.rect(-300, -300, 600, 600)

    // A clone across tile borders, from left of and above the origin.
    paintPattern(plane, -130, -130, 140, 100)
    clone.defaults(brush)
    hard(brush, 20.0)
    clone.setSource(brush, -90.5, -70.5)
    if !strokeHolds(ctx, &target, near, 10.5, 40.5, 110.5, 40.5, 5) { return 130 }
    if !copiedFrom(plane, geom.rect(11, 31, 99, 19), -101, -111) { return 131 }
    // Invert there: once, exactly, across the borders.
    const original = device.copy(plane).?
    defer device.destroy(original)
    filter.defaults(brush)
    hard(brush, 20.0)
    _ = filter.setFilter(brush, "invert")
    if !strokeHolds(ctx, &target, near, -110.5, -80.5, -20.5, -80.5, 4) { return 132 }
    if !inverted(plane, original, geom.rect(-109, -90, 88, 19)) { return 133 }

    var which: usize = 0
    while which < 7 {
        device.clear(plane)
        paintPattern(plane, -150, -150, 300, 300)
        brushFor(brush, which)
        target.wrap = false
        // Across the origin, through tile borders.
        if !strokeHolds(ctx, &target, near, -60.5, -10.5, 60.5, 50.5, 7) { return 140 + @intCast(u8, which) }
        // The smallest dabs, and a large one.
        brush.*.size = 1.0
        if !strokeHolds(ctx, &target, near, -20.5, -20.5, 20.5, 20.5, 3) { return 140 + @intCast(u8, which) }
        brush.*.size = 0.3
        if !strokeHolds(ctx, &target, near, -20.25, 20.25, 20.25, -20.25, 3) { return 140 + @intCast(u8, which) }
        brush.*.size = 400.0
        brush.*.tip.spacing = 0.2
        if !strokeHolds(ctx, &target, geom.rect(-500, -500, 1000, 1000), -10.5, -10.5, 30.5, 10.5, 2) { return 140 + @intCast(u8, which) }
        brush.*.size = 24.0
        // Far away, where a device still reaches.
        if !strokeHolds(ctx, &target, geom.rect(999999800, -1000000100, 400, 300), 999999900.5, -999999990.5, 1000000000.0, -999999980.5, 3) { return 150 + @intCast(u8, which) }
        // Around the image's edge.
        target.wrap = true
        if !strokeHolds(ctx, &target, geom.rect(-64, -64, 728, 528), 590.5, 390.5, 615.5, 410.5, 5) { return 160 + @intCast(u8, which) }
        which += 1
    }
    target.wrap = false
    return 0
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const image = image_module.create(allocator, 600, 400, 72.0).?
    const layer = ops.newLayer(image, node.PAINT, "Layer", "New layer").?
    const brush_memory = allocator.alloc(@sizeOf(Settings), 16)
    if brush_memory == null { return 1 }
    var ctx = Ctx.{ .image = image, .layer = layer, .brush = undefined, .stroke = stroke_module.create(allocator).? }
    ctx.brush = unsafe { @ptrCast(*Settings, brush_memory.?) }
    var failed = checkRegistry(&ctx)
    if failed != 0 { return failed }
    failed = checkSmudge(&ctx)
    if failed != 0 { return failed }
    failed = checkClone(&ctx)
    if failed != 0 { return failed }
    failed = checkFilter(&ctx)
    if failed != 0 { return failed }
    failed = checkDeform(&ctx)
    if failed != 0 { return failed }
    failed = checkQuick(&ctx)
    if failed != 0 { return failed }
    failed = checkEdges(&ctx)
    if failed != 0 { return failed }
    failed = checkEvery(&ctx)
    if failed != 0 { return failed }
    stroke_module.destroy(ctx.stroke)
    allocator.free(brush_memory.?, @sizeOf(Settings), 16)
    image_module.destroy(image)
    return 13
}
