// The file dialog (ui/filedialog.mlx) in nebula without a window, played
// with scripts as a person would use it, on a tree of files the test
// makes under the current directory (a.png, b.jpg, c.txt, .hidden, "sub"
// with x.png, 300 numbered pictures in "many", a home with Pictures).
// Checked: opening with the filters PNG, JPEG and All shows the
// directories and a.png only; the filter list changed by its keys shows
// b.jpg, then c.txt; the hidden files' toggle shows .hidden and Ctrl+H
// hides it; letters typed go to the first name that starts with them,
// and what is typed within a second is one word; Down and Enter go into
// "sub", Backspace up again (the cursor on "sub"), Enter takes x.png and
// the callback gets its whole path and the filter; Escape cancels
// without a call; "" starts where the last file was chosen; the path
// field: Tab completes a name, Enter goes there; End shows the 300th
// file in view; sorting by name descending and by size both ways; a
// double click goes into a directory; several files chosen with Ctrl+A,
// a call for each; saving: the name proposed with its base selected so
// that typing replaces it, the filter changing its extension, a new
// name getting the filter's extension, a name that is there asked about
// first (by keys and by the buttons), Back; New Folder makes the folder
// and goes into it, a bad name is said in the dialog's line; a start
// that is not there falls back to the home, the places (Home, Pictures
// that is there, not Desktop that is not, the root, the directory used
// last); a path that is not there is said, in German too; the dialog and
// its buttons inside the window at 1024 x 768 and 800 x 600; its pixels
// opaque, its ground the panel's, the chosen row lit; the value arena
// not growing over 200 frames; the heap as it was after the dialog
// opened and closed 20 times. Pictures (file-open.png, file-save.png,
// file-german.png, file-light.png) are written to the current directory
// and, when NEBULA_SHOTS names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const state = @import("../app/state.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const shell_module = @import("../app/shell.mlx")
const filedialog = @import("../ui/filedialog.mlx")

const App = state.App

// What the callbacks were handed.
var calls: usize = 0
var lastFilter: usize = 0
var lastPath: [1200]u8 = undefined
var lastLength: usize = 0

fn done(app: *App, path: []const u8, filter: usize) -> void {
    calls += 1
    lastFilter = filter
    const bytes: [*]u8 = &lastPath
    lastLength = std.text.append(bytes, 0, 1200, path)
}

// The test's own: the app, the tree's root, a script being written, a
// path being put together, where pictures go too.
const T = struct {
    app: *App
    root: [600]u8
    rootLength: usize
    text: [4096]u8
    textLength: usize
    path: [1200]u8
    pathLength: usize
    shots: []const u8
}

fn rootOf(t: *T) -> []const u8 {
    const bytes: [*]const u8 = &t.*.root
    return bytes[0..t.*.rootLength]
}

// The tree's directory with `rest` after it (also NUL-terminated:
// pathZ); the home beside it.
fn pathOf(t: *T, rest: []const u8) -> []const u8 {
    const bytes: [*]u8 = &t.*.path
    t.*.pathLength = std.text.append(bytes, std.text.append(bytes, std.text.append(bytes, 0, 1199, rootOf(t)), 1199, "/files"), 1199, rest)
    bytes[t.*.pathLength] = 0
    return bytes[0..t.*.pathLength]
}

fn homeOf(t: *T, rest: []const u8) -> []const u8 {
    const bytes: [*]u8 = &t.*.path
    t.*.pathLength = std.text.append(bytes, std.text.append(bytes, std.text.append(bytes, 0, 1199, rootOf(t)), 1199, "/home"), 1199, rest)
    bytes[t.*.pathLength] = 0
    return bytes[0..t.*.pathLength]
}

fn pathZ(t: *T) -> [*]const u8 {
    const bytes: [*]const u8 = &t.*.path
    return bytes
}

fn lastIs(t: *T, rest: []const u8) -> bool {
    const bytes: [*]const u8 = &lastPath
    return std.text.same(bytes[0..lastLength], pathOf(t, rest))
}

// Scripts.
fn begin(t: *T) -> void { t.*.textLength = 0 }

fn add(t: *T, text: []const u8) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.textLength = std.text.append(bytes, t.*.textLength, 4096, text)
}

fn addNumber(t: *T, value: i32) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.textLength = std.text.appendSigned(bytes, t.*.textLength, 4096, @intCast(isize, value))
}

fn play(t: *T) -> bool {
    const bytes: [*]const u8 = &t.*.text
    return script.run(t.*.app, bytes[0..t.*.textLength])
}

fn run(t: *T, text: []const u8) -> bool {
    return script.run(t.*.app, text)
}

// A click in the middle of `area`.
fn click(t: *T, area: ui.Rect) -> bool {
    if area.width <= 0 || area.height <= 0 { return false }
    begin(t)
    add(t, "click ")
    addNumber(t, area.x + area.width / 2)
    add(t, " ")
    addNumber(t, area.y + area.height / 2)
    add(t, "\n")
    return play(t)
}

// Types `text` (and Enter after it when `enter`).
fn typeText(t: *T, text: []const u8, enter: bool) -> bool {
    begin(t)
    add(t, "type ")
    add(t, text)
    add(t, "\n")
    if enter { add(t, "key Enter\n") }
    return play(t)
}

// The filter list opened by a click and moved by `key` (Down, Home, ...)
// then Enter.
fn chooseFilter(t: *T, key: []const u8) -> bool {
    if !click(t, filedialog.layoutOf(t.*.app).filter) { return false }
    begin(t)
    add(t, "key ")
    add(t, key)
    add(t, "\nkey Enter\n")
    return play(t)
}

// A picture of the window, here and where NEBULA_SHOTS says.
fn shot(t: *T, name: []const u8) -> bool {
    begin(t)
    add(t, "shot ")
    add(t, name)
    add(t, "\n")
    if t.*.shots.length > 0 && t.*.shots.length < 1000 {
        add(t, "shot ")
        add(t, t.*.shots)
        if t.*.shots[t.*.shots.length - 1] != '/' { add(t, "/") }
        add(t, name)
        add(t, "\n")
    }
    return play(t)
}

fn inside(area: ui.Rect, outer: ui.Rect) -> bool {
    return area.width > 0 && area.height > 0 && area.x >= outer.x && area.y >= outer.y && ui.right(area) <= ui.right(outer) && ui.bottom(area) <= ui.bottom(outer)
}

fn nameIs(app: *App, row: usize, name: []const u8) -> bool {
    return std.text.same(filedialog.rowName(app, row), name)
}

fn cursorIs(app: *App, name: []const u8) -> bool {
    return nameIs(app, filedialog.cursorRow(app), name)
}

// The filters of the tests: a local table (a module-level one sliced at
// run time would be copied into the value arena every time), and titles
// in the program's language, as a caller gives them.
fn openWith(t: *T, directory: []const u8, many: bool) -> bool {
    const app = t.*.app
    const filters = [3]filedialog.Filter{
        filedialog.Filter.{ .name = "PNG image", .german = "PNG-Bild", .extensions = "png" },
        filedialog.Filter.{ .name = "JPEG image", .german = "JPEG-Bild", .extensions = "jpg jpeg" },
        filedialog.Filter.{ .name = "All files", .german = "Alle Dateien", .extensions = "" },
    }
    if many { return filedialog.openMany(app, state.tr(app, "Open Images", "Bilder öffnen"), directory, filters[0..], done) }
    return filedialog.open(app, state.tr(app, "Open Image", "Bild öffnen"), directory, filters[0..], done)
}

fn saveWith(t: *T, directory: []const u8, name: []const u8) -> bool {
    const app = t.*.app
    const filters = [3]filedialog.Filter{
        filedialog.Filter.{ .name = "PNG image", .german = "PNG-Bild", .extensions = "png" },
        filedialog.Filter.{ .name = "JPEG image", .german = "JPEG-Bild", .extensions = "jpg jpeg" },
        filedialog.Filter.{ .name = "All files", .german = "Alle Dateien", .extensions = "" },
    }
    return filedialog.save(app, state.tr(app, "Save Image As", "Bild speichern unter"), directory, name, filters[0..], done)
}

// The tree the dialog is shown: false when it could not be made.
fn makeTree(t: *T) -> bool {
    var content: [400]u8 = undefined
    const bytes: [*]u8 = &content
    var index: usize = 0
    while index < 400 {
        bytes[index] = @intCast(u8, 65 + index % 26)
        index += 1
    }
    if !std.fs.makeDirectories(pathOf(t, "/sub"), 493) || !std.fs.makeDirectories(pathOf(t, "/many"), 493) || !std.fs.makeDirectories(homeOf(t, "/Pictures"), 493) { return false }
    _ = pathOf(t, "/a.png")
    if !std.fs.writeFile(pathZ(t), bytes, 10, 420) { return false }
    _ = pathOf(t, "/b.jpg")
    if !std.fs.writeFile(pathZ(t), bytes, 20, 420) { return false }
    _ = pathOf(t, "/c.txt")
    if !std.fs.writeFile(pathZ(t), bytes, 30, 420) { return false }
    _ = pathOf(t, "/.hidden")
    if !std.fs.writeFile(pathZ(t), bytes, 5, 420) { return false }
    _ = pathOf(t, "/sub/x.png")
    if !std.fs.writeFile(pathZ(t), bytes, 7, 420) { return false }
    // img-001.png to img-300.png, each (number * 11) % 301 bytes long:
    // all lengths differ, 1 is img-219's, 2 img-137's, 300 img-082's.
    var number: usize = 1
    while number <= 300 {
        var name: [32]u8 = undefined
        const name_bytes: [*]u8 = &name
        var length = std.text.append(name_bytes, 0, 32, "/many/img-")
        if number < 100 { length = std.text.appendByte(name_bytes, length, 32, '0') }
        if number < 10 { length = std.text.appendByte(name_bytes, length, 32, '0') }
        length = std.text.appendUnsigned(name_bytes, length, 32, number)
        length = std.text.append(name_bytes, length, 32, ".png")
        _ = pathOf(t, name_bytes[0..length])
        if !std.fs.writeFile(pathZ(t), bytes, number * 11 % 301, 420) { return false }
        number += 1
    }
    return true
}

// The program's environment: HOME is the tree's "home".
fn setHome(t: *T, allocator: std.allocator.Allocator) -> bool {
    const text = allocator.alloc(700, 16)
    const list = allocator.alloc(16, 16)
    if text == null || list == null { return false }
    const length = std.text.append(text.?, std.text.append(text.?, 0, 699, "HOME="), 699, homeOf(t, ""))
    text.?[length] = 0
    const entries: [*]usize = unsafe { @ptrCast([*]usize, list.?) }
    entries[0] = @intFromPtr(text.?)
    entries[1] = 0
    shell_module.setEnvironment(t.*.app.*.shell, unsafe { @ptrCast([*][*]const u8, list.?) })
    return true
}

// Opening: the filters, hidden files, typing, going in and up, taking a
// file, Escape, where it starts.
fn checkOpening(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, ""), false) || !filedialog.isOpen(app) { return 1 }
    if !run(t, "wait 16\n") { return 2 }
    if !std.text.same(filedialog.directory(app), pathOf(t, "")) { return 3 }
    if filedialog.rowCount(app) != 3 || !nameIs(app, 0, "many") || !nameIs(app, 1, "sub") || !nameIs(app, 2, "a.png") { return 4 }
    if !filedialog.rowIsDirectory(app, 0) || filedialog.rowIsDirectory(app, 2) || filedialog.cursorRow(app) != 0 { return 5 }
    if !shot(t, "file-open.png") { return 6 }
    // JPEG, then all files.
    if !chooseFilter(t, "Down") || filedialog.filter(app) != 1 { return 7 }
    if filedialog.rowCount(app) != 3 || !nameIs(app, 2, "b.jpg") { return 8 }
    if !chooseFilter(t, "Down") || filedialog.filter(app) != 2 { return 9 }
    if filedialog.rowCount(app) != 5 || !nameIs(app, 2, "a.png") || !nameIs(app, 3, "b.jpg") || !nameIs(app, 4, "c.txt") { return 10 }
    // Hidden files: the toggle, Ctrl+H.
    if !click(t, filedialog.layoutOf(app).hidden) || filedialog.rowCount(app) != 6 || !nameIs(app, 2, ".hidden") { return 11 }
    if !run(t, "key Ctrl+H\n") || filedialog.rowCount(app) != 5 { return 12 }
    // Letters: "b" goes to b.jpg; "su" typed at once is one word; a
    // second later "c" starts another.
    if !typeText(t, "b", false) || !cursorIs(app, "b.jpg") { return 13 }
    if !run(t, "wait 1100\n") || !typeText(t, "su", false) || !cursorIs(app, "sub") { return 14 }
    if !run(t, "wait 1100\n") || !typeText(t, "c", false) || !cursorIs(app, "c.txt") { return 15 }
    // PNG again; Home, Down, Enter: into "sub"; Backspace: up, on "sub".
    if !chooseFilter(t, "Home") || filedialog.filter(app) != 0 || filedialog.rowCount(app) != 3 { return 16 }
    if !run(t, "key Home\nkey Down\nkey Enter\n") || !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 17 }
    if filedialog.rowCount(app) != 1 || !cursorIs(app, "x.png") { return 18 }
    if !run(t, "key Backspace\n") || !std.text.same(filedialog.directory(app), pathOf(t, "")) || !cursorIs(app, "sub") { return 19 }
    // Into it again; Enter takes x.png.
    if !run(t, "key Enter\nkey Enter\n") || filedialog.isOpen(app) { return 20 }
    if calls != 1 || lastFilter != 0 || !lastIs(t, "/sub/x.png") { return 21 }
    // "" starts where the last file was chosen; Escape cancels.
    if !openWith(t, "", false) || !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 22 }
    if !run(t, "wait 16\nkey Escape\n") || filedialog.isOpen(app) || calls != 1 { return 23 }
    // Cancel by its button, and Escape in the path field only leaves it.
    if !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") || !click(t, filedialog.layoutOf(app).cancel) || filedialog.isOpen(app) { return 24 }
    return 0
}

// The path field, End, sorting, a double click, several files.
fn checkList(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") { return 1 }
    // A path typed: Tab completes "ma" to "many/"; Enter goes there.
    if !click(t, filedialog.layoutOf(app).path) || !run(t, "key Ctrl+A\n") { return 2 }
    if !typeText(t, pathOf(t, "/ma"), false) || !run(t, "key Tab\n") { return 3 }
    if !std.text.same(filedialog.pathText(app), pathOf(t, "/many/")) { return 4 }
    if !run(t, "key Enter\n") || !std.text.same(filedialog.directory(app), pathOf(t, "/many")) { return 5 }
    if filedialog.rowCount(app) != 300 || filedialog.cursorRow(app) != 0 || !nameIs(app, 299, "img-300.png") { return 6 }
    // End: the 300th file is the cursor's, and in view.
    const list = filedialog.layoutOf(app).list
    if inside(filedialog.rowArea(app, 299), list) { return 7 }
    if !run(t, "key End\n") || filedialog.cursorRow(app) != 299 || !inside(filedialog.rowArea(app, 299), list) { return 8 }
    if inside(filedialog.rowArea(app, 0), list) { return 9 }
    if !run(t, "key Home\n") || !inside(filedialog.rowArea(app, 0), list) { return 10 }
    // By name the other way round, by size, by size the other way round.
    if !click(t, filedialog.layoutOf(app).nameHead) || !nameIs(app, 0, "img-300.png") || !nameIs(app, 299, "img-001.png") { return 11 }
    if !click(t, filedialog.layoutOf(app).sizeHead) || !nameIs(app, 0, "img-219.png") || !nameIs(app, 1, "img-137.png") { return 12 }
    if !click(t, filedialog.layoutOf(app).sizeHead) || !nameIs(app, 0, "img-082.png") { return 13 }
    if !click(t, filedialog.layoutOf(app).nameHead) || !nameIs(app, 0, "img-001.png") { return 14 }
    // Up by a click on the parts of the path ("many"'s parent is the
    // part before the last); a double click goes into "sub".
    if !run(t, "key Backspace\n") || !std.text.same(filedialog.directory(app), pathOf(t, "")) { return 15 }
    const sub = filedialog.rowArea(app, 1)
    if !nameIs(app, 1, "sub") || !click(t, sub) || !click(t, sub) { return 16 }
    if !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 17 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) || calls != 1 { return 18 }
    // Several: all files of "All", one call each, in the list's order.
    if !openWith(t, pathOf(t, ""), true) || !run(t, "wait 16\n") || !chooseFilter(t, "End") { return 19 }
    if !run(t, "key Ctrl+A\nkey Enter\n") || filedialog.isOpen(app) { return 20 }
    if calls != 4 || lastFilter != 2 || !lastIs(t, "/c.txt") { return 21 }
    return 0
}

// Saving: the name, the filter's extension, asking before replacing.
fn checkSaving(t: *T) -> u8 {
    const app = t.*.app
    if !saveWith(t, pathOf(t, ""), "untitled.png") || !run(t, "wait 16\n") { return 1 }
    if !std.text.same(filedialog.nameText(app), "untitled.png") || filedialog.filter(app) != 0 { return 2 }
    // The base is selected: typing replaces it, the extension stays.
    if !typeText(t, "drawing", false) || !std.text.same(filedialog.nameText(app), "drawing.png") { return 3 }
    if !shot(t, "file-save.png") { return 4 }
    // Another filter, another extension.
    if !chooseFilter(t, "Down") || filedialog.filter(app) != 1 || !std.text.same(filedialog.nameText(app), "drawing.jpg") { return 5 }
    // A new name without an extension gets the filter's.
    if !run(t, "key Ctrl+A\n") || !typeText(t, "fresh", true) || filedialog.isOpen(app) { return 6 }
    if calls != 5 || lastFilter != 1 || !lastIs(t, "/fresh.jpg") { return 7 }
    // A name that is there: asked first, Enter answers.
    if !saveWith(t, pathOf(t, ""), "a.png") || !run(t, "wait 16\nkey Enter\n") { return 8 }
    if !filedialog.asking(app) || calls != 5 || !filedialog.isOpen(app) || filedialog.message(app).length == 0 { return 9 }
    if !run(t, "key Enter\n") || filedialog.isOpen(app) || calls != 6 || !lastIs(t, "/a.png") || lastFilter != 0 { return 10 }
    // By the buttons: Save asks, Back takes the question back, Save and
    // Replace replace.
    if !saveWith(t, pathOf(t, ""), "b.jpg") || !run(t, "wait 16\n") || filedialog.filter(app) != 1 { return 11 }
    const layout = filedialog.layoutOf(app)
    if !click(t, layout.accept) || !filedialog.asking(app) || calls != 6 { return 12 }
    if !click(t, layout.cancel) || filedialog.asking(app) || !filedialog.isOpen(app) { return 13 }
    if !click(t, layout.accept) || !click(t, layout.accept) || filedialog.isOpen(app) || calls != 7 || !lastIs(t, "/b.jpg") { return 14 }
    // A click on a file names it; a directory's name typed goes there.
    if !saveWith(t, pathOf(t, ""), "untitled.png") || !run(t, "wait 16\n") { return 15 }
    if !click(t, filedialog.rowArea(t.*.app, 2)) || !std.text.same(filedialog.nameText(app), "a.png") { return 16 }
    if !run(t, "key Ctrl+A\n") || !typeText(t, "sub", true) || !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 17 }
    if !std.text.same(filedialog.nameText(app), "untitled.png") || calls != 7 { return 18 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 19 }
    return 0
}

// New Folder, errors, the start's fallback, the places, German.
fn checkFolders(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") { return 1 }
    if !click(t, filedialog.layoutOf(app).newFolder) || !run(t, "key Ctrl+A\n") || !typeText(t, "made", true) { return 2 }
    _ = pathOf(t, "/made")
    if !std.fs.exists(pathZ(t)) || !std.text.same(filedialog.directory(app), pathOf(t, "/made")) { return 3 }
    // A name with a slash is no folder's: said, and nothing made.
    if !click(t, filedialog.layoutOf(app).newFolder) || !run(t, "key Ctrl+A\n") || !typeText(t, "x/y", true) { return 4 }
    _ = pathOf(t, "/made/x")
    if filedialog.message(app).length == 0 || std.fs.exists(pathZ(t)) || !std.text.same(filedialog.directory(app), pathOf(t, "/made")) { return 5 }
    if !run(t, "key Escape\nkey Escape\n") || filedialog.isOpen(app) { return 6 }
    // A start that is not there: the home. Its places.
    if !openWith(t, pathOf(t, "/not-there"), false) || !run(t, "wait 16\n") { return 7 }
    if !std.text.same(filedialog.directory(app), homeOf(t, "")) { return 8 }
    if filedialog.placeCount(app) != 5 || !std.text.same(filedialog.placeAt(app, 0), homeOf(t, "")) || !std.text.same(filedialog.placeAt(app, 1), homeOf(t, "/Pictures")) { return 9 }
    // (The directories used last: the tree's root, then "sub".)
    if !std.text.same(filedialog.placeAt(app, 2), "/") || !std.text.same(filedialog.placeAt(app, 3), pathOf(t, "")) || !std.text.same(filedialog.placeAt(app, 4), pathOf(t, "/sub")) { return 10 }
    // A click on a place goes there.
    const layout = filedialog.layoutOf(app)
    if !click(t, ui.rect(layout.places.x, layout.places.y + 20 + 24, layout.places.width, 24)) || !std.text.same(filedialog.directory(app), homeOf(t, "/Pictures")) { return 11 }
    // A path that is not there is said (in German, too).
    if !click(t, filedialog.layoutOf(app).path) || !run(t, "key Ctrl+A\n") || !typeText(t, "/not-there-either", true) { return 12 }
    if !std.text.startsWith(filedialog.message(app), "There is no") { return 13 }
    if !run(t, "key Escape\nkey Escape\n") || filedialog.isOpen(app) { return 14 }
    // German: opened again (its title is the caller's), the same said so.
    if !run(t, "german\n") || !openWith(t, homeOf(t, "/Pictures"), false) || !click(t, filedialog.layoutOf(app).path) { return 15 }
    if !run(t, "key Ctrl+A\n") || !typeText(t, "/not-there-either", true) || !std.text.startsWith(filedialog.message(app), "Es gibt keinen") { return 16 }
    if !run(t, "key Escape\n") || !shot(t, "file-german.png") { return 17 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 18 }
    t.*.app.*.german = false
    return 0
}

// The window's sizes, the pixels.
fn checkLook(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "size 800 600\n") || !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") { return 1 }
    var layout = filedialog.layoutOf(app)
    var window = ui.rect(0, 0, 800, 600)
    if !inside(layout.box, window) || !inside(layout.accept, layout.box) || !inside(layout.cancel, layout.box) || !inside(layout.list, layout.box) || !inside(layout.filter, layout.box) { return 2 }
    if layout.list.height < 10 * 24 || layout.accept.y < ui.bottom(layout.list) { return 3 }
    if !run(t, "key Escape\nsize 1024 768\n") || !saveWith(t, pathOf(t, ""), "untitled.png") || !run(t, "wait 16\n") { return 4 }
    layout = filedialog.layoutOf(app)
    window = ui.rect(0, 0, 1024, 768)
    if !inside(layout.box, window) || !inside(layout.accept, layout.box) || !inside(layout.cancel, layout.box) || !inside(layout.name, layout.box) || !inside(layout.filter, layout.box) { return 5 }
    if ui.bottom(layout.name) > layout.accept.y || ui.right(layout.name) > layout.filter.x { return 6 }
    if !run(t, "key Escape\n") || !openWith(t, pathOf(t, ""), false) || !run(t, "key Down\n") { return 7 }
    // Every pixel of the dialog opaque; its ground the panel's; the
    // cursor's row lit.
    const frame = script.frameOf(app).?
    if frame.*.width != 1024 || frame.*.height != 768 { return 8 }
    layout = filedialog.layoutOf(app)
    var y = @intCast(usize, layout.box.y)
    while y < @intCast(usize, ui.bottom(layout.box)) {
        var x = @intCast(usize, layout.box.x)
        while x < @intCast(usize, ui.right(layout.box)) {
            if frame.*.pixels[y * frame.*.stride + x] >> 24 != 255 { return 9 }
            x += 1
        }
        y += 1
    }
    const theme = &app.*.theme
    const ground = canvas_module.over(theme.*.background | 0xFF000000, theme.*.panel, 255)
    const probe_x = @intCast(usize, layout.box.x + 4)
    const probe_y = @intCast(usize, layout.box.y + layout.box.height / 2)
    if frame.*.pixels[probe_y * frame.*.stride + probe_x] != ground { return 10 }
    const row = filedialog.rowArea(app, filedialog.cursorRow(app))
    const lit_x = @intCast(usize, ui.right(row) - 8)
    const lit_y = @intCast(usize, row.y + row.height / 2)
    if frame.*.pixels[lit_y * frame.*.stride + lit_x] != theme.*.menuChosen { return 11 }
    // Outside the dialog the window is darker than without it.
    const outside = frame.*.pixels[2 * frame.*.stride + 2]
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 12 }
    if frame.*.width != 1024 { return 13 }
    const bare = frame.*.pixels[2 * frame.*.stride + 2]
    if (outside & 255) + ((outside >> 8) & 255) >= (bare & 255) + ((bare >> 8) & 255) { return 14 }
    // Light: a picture to look at.
    t.*.app.*.shell.*.lightness = 1024
    if !openWith(t, pathOf(t, "/many"), false) || !run(t, "key Down\nkey Down\n") || !shot(t, "file-light.png") { return 15 }
    if !run(t, "key Escape\n") { return 16 }
    t.*.app.*.shell.*.lightness = 0
    return 0
}

// Frames one after another, the value arena given back before each as
// the window's loop does: what a frame takes does not grow.
fn checkArena(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, "/many"), false) || !run(t, "wait 16\nkey Down\n") { return 1 }
    const frame = script.frameOf(app).?
    var rounds: turns.Turns = undefined
    turns.begin(&rounds, true, false)
    const arena = rounds.base
    const mark = turns.used(arena)
    // (A tooltip may come up within the first second: compared from then.)
    var first: usize = 0
    var last: usize = 0
    var round: usize = 0
    while round < 200 {
        turns.turn(&rounds)
        app.*.shell.*.clock += 16
        loop.frame(app, frame)
        last = turns.used(arena) - mark
        if round == 80 { first = last }
        if last > 2097152 { return 2 }
        round += 1
    }
    const off = if last > first { last - first } else { first - last }
    if off > 1024 { return 3 }
    turns.turn(&rounds)
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 4 }
    return 0
}

// Opened and closed again and again: the heap as it was.
fn checkHeap(t: *T) -> u8 {
    if !openWith(t, pathOf(t, "/many"), false) || !run(t, "wait 16\nkey End\nkey Escape\n") { return 1 }
    const live = std.heap.liveBytes()
    var round: usize = 0
    while round < 20 {
        if !openWith(t, pathOf(t, "/many"), false) || !run(t, "wait 16\nkey End\nkey Escape\n") || filedialog.isOpen(t.*.app) { return 2 }
        round += 1
    }
    const now = std.heap.liveBytes()
    const off = if now > live { now - live } else { live - now }
    if off > 1024 { return 3 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(T), 16)
    if memory == null { return 1 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    t.*.shots = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { t.*.shots = std.string.asSlice(named.?) }
    // The tree, under the current directory.
    var here: [600]u8 = undefined
    const here_bytes: [*]u8 = &here
    if std.fs.getWorkingDirectory(here_bytes, 500) <= 0 { return 2 }
    const working = std.text.cString(here_bytes)
    const root_bytes: [*]u8 = &t.*.root
    t.*.rootLength = std.text.append(root_bytes, std.text.append(root_bytes, 0, 600, working), 600, "/test-56")
    if !makeTree(t) { return 3 }
    const made = script.headless(allocator)
    if made == null { return 4 }
    t.*.app = made.?
    if !setHome(t, allocator) { return 5 }
    if !run(t, "size 1024 768\n") { return 6 }

    var failed = checkOpening(t)
    if failed != 0 { return 10 + failed }
    failed = checkList(t)
    if failed != 0 { return 40 + failed }
    failed = checkSaving(t)
    if failed != 0 { return 70 + failed }
    failed = checkFolders(t)
    if failed != 0 { return 100 + failed }
    failed = checkLook(t)
    if failed != 0 { return 130 + failed }
    failed = checkArena(t)
    if failed != 0 { return 160 + failed }
    failed = checkHeap(t)
    if failed != 0 { return 170 + failed }
    // Kept for the next run: the directories used last.
    var recent = std.ArrayList(u8).init(allocator)
    filedialog.recentDirectories(t.*.app, &recent)
    if !std.text.startsWith(recent.items(), pathOf(t, "")) { return 180 }
    filedialog.setRecentDirectories(t.*.app, "/\nrelative/not/kept\n/a/../b/\n")
    recent.clearRetainingCapacity()
    filedialog.recentDirectories(t.*.app, &recent)
    if !std.text.same(recent.items(), "/\n/b") { return 181 }
    return 13
}
