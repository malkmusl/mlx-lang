// The file dialog (ui/filedialog.mlx) in nebula without a window, played
// with scripts as a person would use it, on a tree of files the test
// makes under the current directory (a.png, b.jpg, c.txt, .hidden, "sub"
// with x.png, 300 numbered pictures in "many", a home with Pictures).
// Checked: opening with the filters PNG, JPEG and All shows the
// directories and a.png only; the filter list changed by its keys shows
// b.jpg, then c.txt; the hidden files' toggle shows .hidden and Ctrl+H
// hides it; letters typed go to the first name that starts with them,
// and what is typed within a second is one word; Down and Enter go into
// "sub", Backspace up again (the cursor on "sub"), Enter takes x.png and
// the callback gets its whole path and the filter; Escape cancels
// without a call, and so does Cancel; "" starts where the last file
// was chosen; the path field: Tab completes a name, Enter goes there;
// End shows the 300th file in view; sorting by name descending and by
// size both ways; the Up button; a double click goes into a directory;
// a part of the path clicked goes there; several files chosen with
// Ctrl+A, a call for each; saving: the name proposed with its base
// selected so that typing replaces it, the filter changing its
// extension, a new name getting the filter's extension, a name that is
// there asked about first (by keys and by the buttons), Back, a click on
// a file naming it, a directory's name going there; New Folder makes the
// folder and goes into it, a bad name is said in the dialog's line; a
// start that is not there falls back to the home, the places (Home,
// Pictures that is there, not Desktop that is not, the root, the
// directories used last) and a click on one; a path that is not there
// is said, in German too; the dialog and its parts inside the window at
// 1024 x 768 and 800 x 600, in both languages and both kinds, one beside
// the other without overlapping; its pixels opaque, its ground the
// panel's, the chosen row lit; the value arena not growing over 200
// frames; the heap as it was after the dialog opened and closed 20
// times, and after saving, filters, folders begun and paths completed.
// Then: the size column rounded once to its unit up to terabytes (sparse
// files), dates in the zone TZ names, in German too, sorting by date;
// 2 500 entries of mixed case and a name of 255 bytes in the order asked
// for (checked pair by pair with the test's own order) both ways and by
// size, type-ahead among them, reading them again costing the value
// arena nothing per entry; no filters at all, opened while open, no room
// for another dialog, closed under another one, a folder typed that is
// not there while saving, a name with a folder before it, a start that
// cannot be read said; windows of 0 x 0 up to 400 x 400; Shift+click,
// Ctrl+click and Shift+Down choosing several, Page Down and Up, the
// clipboard, Tab completing as far as names agree, a double click on a
// file, a folder that is there not made again, a folder gone when read
// again, the root. Pictures (file-open.png, file-save.png,
// file-german.png, file-light.png) are written to the current directory
// and, when NEBULA_SHOTS names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const shell_module = @import("../app/shell.mlx")
const filedialog = @import("../ui/filedialog.mlx")

const App = state.App

// What the callbacks were handed.
var calls: usize = 0
var lastFilter: usize = 0
var lastPath: [1200]u8 = undefined
var lastLength: usize = 0
// The names handed over since `joinedLength` was set to 0, ";" after each.
var joined: [600]u8 = undefined
var joinedLength: usize = 0

fn done(app: *App, path: []const u8, filter: usize) -> void {
    calls += 1
    lastFilter = filter
    const bytes: [*]u8 = &lastPath
    lastLength = std.text.append(bytes, 0, 1200, path)
    var start = path.length
    while start > 0 && path[start - 1] != '/' { start -= 1 }
    const record: [*]u8 = &joined
    joinedLength = std.text.append(record, std.text.append(record, joinedLength, 600, path[start..path.length]), 600, ";")
}

fn joinedIs(names: []const u8) -> bool {
    const record: [*]const u8 = &joined
    return std.text.same(record[0..joinedLength], names)
}

// The test's own: the app, the tree's root, a script being written, a
// path being put together, where pictures go too.
const T = struct {
    app: *App
    root: [600]u8
    rootLength: usize
    text: [4096]u8
    textLength: usize
    path: [1200]u8
    pathLength: usize
    shots: []const u8
}

fn rootOf(t: *T) -> []const u8 {
    const bytes: [*]const u8 = &t.*.root
    return bytes[0..t.*.rootLength]
}

// The tree's directory with `rest` after it (also NUL-terminated:
// pathZ); the home beside it.
fn pathOf(t: *T, rest: []const u8) -> []const u8 {
    const bytes: [*]u8 = &t.*.path
    t.*.pathLength = std.text.append(bytes, std.text.append(bytes, std.text.append(bytes, 0, 1199, rootOf(t)), 1199, "/files"), 1199, rest)
    bytes[t.*.pathLength] = 0
    return bytes[0..t.*.pathLength]
}

fn homeOf(t: *T, rest: []const u8) -> []const u8 {
    const bytes: [*]u8 = &t.*.path
    t.*.pathLength = std.text.append(bytes, std.text.append(bytes, std.text.append(bytes, 0, 1199, rootOf(t)), 1199, "/home"), 1199, rest)
    bytes[t.*.pathLength] = 0
    return bytes[0..t.*.pathLength]
}

fn pathZ(t: *T) -> [*]const u8 {
    const bytes: [*]const u8 = &t.*.path
    return bytes
}

fn lastIs(t: *T, rest: []const u8) -> bool {
    const bytes: [*]const u8 = &lastPath
    return std.text.same(bytes[0..lastLength], pathOf(t, rest))
}

// Scripts.
fn begin(t: *T) -> void { t.*.textLength = 0 }

fn add(t: *T, text: []const u8) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.textLength = std.text.append(bytes, t.*.textLength, 4096, text)
}

fn addNumber(t: *T, value: i32) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.textLength = std.text.appendSigned(bytes, t.*.textLength, 4096, @intCast(isize, value))
}

fn play(t: *T) -> bool {
    const bytes: [*]const u8 = &t.*.text
    return script.run(t.*.app, bytes[0..t.*.textLength])
}

fn run(t: *T, text: []const u8) -> bool {
    return script.run(t.*.app, text)
}

// A click in the middle of `area`.
fn click(t: *T, area: ui.Rect) -> bool {
    if area.width <= 0 || area.height <= 0 { return false }
    begin(t)
    add(t, "click ")
    addNumber(t, area.x + area.width / 2)
    add(t, " ")
    addNumber(t, area.y + area.height / 2)
    add(t, "\n")
    return play(t)
}

// Types `text` (and Enter after it when `enter`).
fn typeText(t: *T, text: []const u8, enter: bool) -> bool {
    begin(t)
    add(t, "type ")
    add(t, text)
    add(t, "\n")
    if enter { add(t, "key Enter\n") }
    return play(t)
}

// The filter list opened by a click and moved by `key` (Down, Home, ...)
// then Enter.
fn chooseFilter(t: *T, key: []const u8) -> bool {
    if !click(t, filedialog.layoutOf(t.*.app).filter) { return false }
    begin(t)
    add(t, "key ")
    add(t, key)
    add(t, "\nkey Enter\n")
    return play(t)
}

// A picture of the window, here and where NEBULA_SHOTS says.
fn shot(t: *T, name: []const u8) -> bool {
    begin(t)
    add(t, "shot ")
    add(t, name)
    add(t, "\n")
    if t.*.shots.length > 0 && t.*.shots.length < 1000 {
        add(t, "shot ")
        add(t, t.*.shots)
        if t.*.shots[t.*.shots.length - 1] != '/' { add(t, "/") }
        add(t, name)
        add(t, "\n")
    }
    return play(t)
}

fn inside(area: ui.Rect, outer: ui.Rect) -> bool {
    return area.width > 0 && area.height > 0 && area.x >= outer.x && area.y >= outer.y && ui.right(area) <= ui.right(outer) && ui.bottom(area) <= ui.bottom(outer)
}

fn nameIs(app: *App, row: usize, name: []const u8) -> bool {
    return std.text.same(filedialog.rowName(app, row), name)
}

fn cursorIs(app: *App, name: []const u8) -> bool {
    return nameIs(app, filedialog.cursorRow(app), name)
}

// The filters of the tests: a local table (a module-level one sliced at
// run time would be copied into the value arena every time), and titles
// in the program's language, as a caller gives them.
fn openWith(t: *T, directory: []const u8, many: bool) -> bool {
    const app = t.*.app
    const filters = [3]filedialog.Filter{
        filedialog.Filter.{ .name = "PNG image", .german = "PNG-Bild", .extensions = "png" },
        filedialog.Filter.{ .name = "JPEG image", .german = "JPEG-Bild", .extensions = "jpg jpeg" },
        filedialog.Filter.{ .name = "All files", .german = "Alle Dateien", .extensions = "" },
    }
    if many { return filedialog.openMany(app, state.tr(app, "Open Images", "Bilder öffnen"), directory, filters[0..], done) }
    return filedialog.open(app, state.tr(app, "Open Image", "Bild öffnen"), directory, filters[0..], done)
}

fn saveWith(t: *T, directory: []const u8, name: []const u8) -> bool {
    const app = t.*.app
    const filters = [3]filedialog.Filter{
        filedialog.Filter.{ .name = "PNG image", .german = "PNG-Bild", .extensions = "png" },
        filedialog.Filter.{ .name = "JPEG image", .german = "JPEG-Bild", .extensions = "jpg jpeg" },
        filedialog.Filter.{ .name = "All files", .german = "Alle Dateien", .extensions = "" },
    }
    return filedialog.save(app, state.tr(app, "Save Image As", "Bild speichern unter"), directory, name, filters[0..], done)
}

// The tree the dialog is shown: false when it could not be made.
fn makeTree(t: *T) -> bool {
    var content: [400]u8 = undefined
    const bytes: [*]u8 = &content
    var index: usize = 0
    while index < 400 {
        bytes[index] = @intCast(u8, 65 + index % 26)
        index += 1
    }
    if !std.fs.makeDirectories(pathOf(t, "/sub"), 493) || !std.fs.makeDirectories(pathOf(t, "/many"), 493) || !std.fs.makeDirectories(homeOf(t, "/Pictures"), 493) { return false }
    _ = pathOf(t, "/a.png")
    if !std.fs.writeFile(pathZ(t), bytes, 10, 420) { return false }
    _ = pathOf(t, "/b.jpg")
    if !std.fs.writeFile(pathZ(t), bytes, 20, 420) { return false }
    _ = pathOf(t, "/c.txt")
    if !std.fs.writeFile(pathZ(t), bytes, 30, 420) { return false }
    _ = pathOf(t, "/.hidden")
    if !std.fs.writeFile(pathZ(t), bytes, 5, 420) { return false }
    _ = pathOf(t, "/sub/x.png")
    if !std.fs.writeFile(pathZ(t), bytes, 7, 420) { return false }
    // img-001.png to img-300.png, each (number * 11) % 301 bytes long:
    // all lengths differ, 1 is img-219's, 2 img-137's, 300 img-082's.
    var number: usize = 1
    while number <= 300 {
        var name: [32]u8 = undefined
        const name_bytes: [*]u8 = &name
        var length = std.text.append(name_bytes, 0, 32, "/many/img-")
        if number < 100 { length = std.text.appendByte(name_bytes, length, 32, '0') }
        if number < 10 { length = std.text.appendByte(name_bytes, length, 32, '0') }
        length = std.text.appendUnsigned(name_bytes, length, 32, number)
        length = std.text.append(name_bytes, length, 32, ".png")
        _ = pathOf(t, name_bytes[0..length])
        if !std.fs.writeFile(pathZ(t), bytes, number * 11 % 301, 420) { return false }
        number += 1
    }
    return true
}

// The program's environment: HOME is the tree's "home"; the time zone a
// POSIX rule two hours east of UTC without summer time (the dates below
// are its, whatever zone the machine has).
fn setHome(t: *T, allocator: std.allocator.Allocator) -> bool {
    const text = allocator.alloc(720, 16)
    const list = allocator.alloc(24, 16)
    if text == null || list == null { return false }
    const length = std.text.append(text.?, std.text.append(text.?, 0, 699, "HOME="), 699, homeOf(t, ""))
    text.?[length] = 0
    const zone_end = std.text.append(text.?, length + 1, 719, "TZ=XYZ-2")
    text.?[zone_end] = 0
    const entries: [*]usize = unsafe { @ptrCast([*]usize, list.?) }
    entries[0] = @intFromPtr(text.?)
    entries[1] = @intFromPtr(text.?) + length + 1
    entries[2] = 0
    shell_module.setEnvironment(t.*.app.*.shell, unsafe { @ptrCast([*][*]const u8, list.?) })
    return true
}

// A file of the tree `length` bytes long (its size set, nothing written:
// sparse) that changed last at `modified` (seconds since 1970; below 0:
// now). False when it could not be made.
fn makeFile(t: *T, rest: []const u8, length: u64, modified: isize) -> bool {
    _ = pathOf(t, rest)
    const file = std.fs.open(pathZ(t), std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.isValid(file) { return false }
    const sized = std.fs.truncate(file, @intCast(usize, length))
    _ = std.fs.close(file)
    if !sized { return false }
    return modified < 0 || std.fs.setTimes(pathZ(t), modified, 0, modified, 0, false)
}

// Opening: the filters, hidden files, typing, going in and up, taking a
// file, Escape, where it starts.
fn checkOpening(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, ""), false) || !filedialog.isOpen(app) { return 1 }
    if !run(t, "wait 16\n") { return 2 }
    if !std.text.same(filedialog.directory(app), pathOf(t, "")) { return 3 }
    if filedialog.rowCount(app) != 3 || !nameIs(app, 0, "many") || !nameIs(app, 1, "sub") || !nameIs(app, 2, "a.png") { return 4 }
    if !filedialog.rowIsDirectory(app, 0) || filedialog.rowIsDirectory(app, 2) || filedialog.cursorRow(app) != 0 { return 5 }
    if !shot(t, "file-open.png") { return 6 }
    // JPEG, then all files.
    if !chooseFilter(t, "Down") || filedialog.filter(app) != 1 { return 7 }
    if filedialog.rowCount(app) != 3 || !nameIs(app, 2, "b.jpg") { return 8 }
    if !chooseFilter(t, "Down") || filedialog.filter(app) != 2 { return 9 }
    if filedialog.rowCount(app) != 5 || !nameIs(app, 2, "a.png") || !nameIs(app, 3, "b.jpg") || !nameIs(app, 4, "c.txt") { return 10 }
    // Hidden files: the toggle, Ctrl+H.
    if !click(t, filedialog.layoutOf(app).hidden) || filedialog.rowCount(app) != 6 || !nameIs(app, 2, ".hidden") { return 11 }
    if !run(t, "key Ctrl+H\n") || filedialog.rowCount(app) != 5 { return 12 }
    // Letters: "b" goes to b.jpg; "su" typed at once is one word; a
    // second later "c" starts another.
    if !typeText(t, "b", false) || !cursorIs(app, "b.jpg") { return 13 }
    if !run(t, "wait 1100\n") || !typeText(t, "su", false) || !cursorIs(app, "sub") { return 14 }
    if !run(t, "wait 1100\n") || !typeText(t, "c", false) || !cursorIs(app, "c.txt") { return 15 }
    // PNG again; Home, Down, Enter: into "sub"; Backspace: up, on "sub".
    if !chooseFilter(t, "Home") || filedialog.filter(app) != 0 || filedialog.rowCount(app) != 3 { return 16 }
    if !run(t, "key Home\nkey Down\nkey Enter\n") || !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 17 }
    if filedialog.rowCount(app) != 1 || !cursorIs(app, "x.png") { return 18 }
    if !run(t, "key Backspace\n") || !std.text.same(filedialog.directory(app), pathOf(t, "")) || !cursorIs(app, "sub") { return 19 }
    // Into it again; Enter takes x.png.
    if !run(t, "key Enter\nkey Enter\n") || filedialog.isOpen(app) { return 20 }
    if calls != 1 || lastFilter != 0 || !lastIs(t, "/sub/x.png") { return 21 }
    // "" starts where the last file was chosen; Escape cancels.
    if !openWith(t, "", false) || !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 22 }
    if !run(t, "wait 16\nkey Escape\n") || filedialog.isOpen(app) || calls != 1 { return 23 }
    // Cancel by its button, and Escape in the path field only leaves it.
    if !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") || !click(t, filedialog.layoutOf(app).cancel) || filedialog.isOpen(app) { return 24 }
    return 0
}

// The path field, End, sorting, a double click, several files.
fn checkList(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") { return 1 }
    // A path typed: Tab completes "ma" to "many/"; Enter goes there.
    if !click(t, filedialog.layoutOf(app).path) || !run(t, "key Ctrl+A\n") { return 2 }
    if !typeText(t, pathOf(t, "/ma"), false) || !run(t, "key Tab\n") { return 3 }
    if !std.text.same(filedialog.pathText(app), pathOf(t, "/many/")) { return 4 }
    if !run(t, "key Enter\n") || !std.text.same(filedialog.directory(app), pathOf(t, "/many")) { return 5 }
    if filedialog.rowCount(app) != 300 || filedialog.cursorRow(app) != 0 || !nameIs(app, 299, "img-300.png") { return 6 }
    // End: the 300th file is the cursor's, and in view.
    const list = filedialog.layoutOf(app).list
    if inside(filedialog.rowArea(app, 299), list) { return 7 }
    if !run(t, "key End\n") || filedialog.cursorRow(app) != 299 || !inside(filedialog.rowArea(app, 299), list) { return 8 }
    if inside(filedialog.rowArea(app, 0), list) { return 9 }
    if !run(t, "key Home\n") || !inside(filedialog.rowArea(app, 0), list) { return 10 }
    // By name the other way round, by size, by size the other way round.
    if !click(t, filedialog.layoutOf(app).nameHead) || !nameIs(app, 0, "img-300.png") || !nameIs(app, 299, "img-001.png") { return 11 }
    if !click(t, filedialog.layoutOf(app).sizeHead) || !nameIs(app, 0, "img-219.png") || !nameIs(app, 1, "img-137.png") { return 12 }
    if !click(t, filedialog.layoutOf(app).sizeHead) || !nameIs(app, 0, "img-082.png") { return 13 }
    if !click(t, filedialog.layoutOf(app).nameHead) || !nameIs(app, 0, "img-001.png") { return 14 }
    // Up by its button; a double click goes into "sub"; the first of the
    // path's parts shown goes to a directory above.
    if !click(t, filedialog.layoutOf(app).up) || !std.text.same(filedialog.directory(app), pathOf(t, "")) { return 15 }
    const sub = filedialog.rowArea(app, 1)
    if !nameIs(app, 1, "sub") || !click(t, sub) || !click(t, sub) { return 16 }
    if !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 17 }
    const crumbs = filedialog.layoutOf(app).crumbs
    if !click(t, ui.rect(crumbs.x, crumbs.y, 8, crumbs.height)) { return 18 }
    const above = filedialog.directory(app)
    if above.length >= pathOf(t, "").length || !std.text.startsWith(pathOf(t, ""), above) { return 19 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) || calls != 1 { return 20 }
    // Several: all files of "All", one call each, in the list's order.
    if !openWith(t, pathOf(t, ""), true) || !run(t, "wait 16\n") || !chooseFilter(t, "End") { return 21 }
    if !run(t, "key Ctrl+A\nkey Enter\n") || filedialog.isOpen(app) { return 22 }
    if calls != 4 || lastFilter != 2 || !lastIs(t, "/c.txt") { return 23 }
    return 0
}

// Saving: the name, the filter's extension, asking before replacing.
fn checkSaving(t: *T) -> u8 {
    const app = t.*.app
    if !saveWith(t, pathOf(t, ""), "untitled.png") || !run(t, "wait 16\n") { return 1 }
    if !std.text.same(filedialog.nameText(app), "untitled.png") || filedialog.filter(app) != 0 { return 2 }
    // The base is selected: typing replaces it, the extension stays.
    if !typeText(t, "drawing", false) || !std.text.same(filedialog.nameText(app), "drawing.png") { return 3 }
    if !shot(t, "file-save.png") { return 4 }
    // Another filter, another extension.
    if !chooseFilter(t, "Down") || filedialog.filter(app) != 1 || !std.text.same(filedialog.nameText(app), "drawing.jpg") { return 5 }
    // A new name without an extension gets the filter's.
    if !run(t, "key Ctrl+A\n") || !typeText(t, "fresh", true) || filedialog.isOpen(app) { return 6 }
    if calls != 5 || lastFilter != 1 || !lastIs(t, "/fresh.jpg") { return 7 }
    // A name that is there: asked first, Enter answers.
    if !saveWith(t, pathOf(t, ""), "a.png") || !run(t, "wait 16\nkey Enter\n") { return 8 }
    if !filedialog.asking(app) || calls != 5 || !filedialog.isOpen(app) || filedialog.message(app).length == 0 { return 9 }
    if !run(t, "key Enter\n") || filedialog.isOpen(app) || calls != 6 || !lastIs(t, "/a.png") || lastFilter != 0 { return 10 }
    // By the buttons: Save asks, Back takes the question back, Save and
    // Replace replace.
    if !saveWith(t, pathOf(t, ""), "b.jpg") || !run(t, "wait 16\n") || filedialog.filter(app) != 1 { return 11 }
    const layout = filedialog.layoutOf(app)
    if !click(t, layout.accept) || !filedialog.asking(app) || calls != 6 { return 12 }
    if !click(t, layout.cancel) || filedialog.asking(app) || !filedialog.isOpen(app) { return 13 }
    if !click(t, layout.accept) || !click(t, layout.accept) || filedialog.isOpen(app) || calls != 7 || !lastIs(t, "/b.jpg") { return 14 }
    // A click on a file names it; a directory's name typed goes there.
    if !saveWith(t, pathOf(t, ""), "untitled.png") || !run(t, "wait 16\n") { return 15 }
    if !click(t, filedialog.rowArea(t.*.app, 2)) || !std.text.same(filedialog.nameText(app), "a.png") { return 16 }
    if !run(t, "key Ctrl+A\n") || !typeText(t, "sub", true) || !std.text.same(filedialog.directory(app), pathOf(t, "/sub")) { return 17 }
    if !std.text.same(filedialog.nameText(app), "untitled.png") || calls != 7 { return 18 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 19 }
    return 0
}

// New Folder, errors, the start's fallback, the places, German.
fn checkFolders(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") { return 1 }
    if !click(t, filedialog.layoutOf(app).newFolder) || !run(t, "key Ctrl+A\n") || !typeText(t, "made", true) { return 2 }
    _ = pathOf(t, "/made")
    if !std.fs.exists(pathZ(t)) || !std.text.same(filedialog.directory(app), pathOf(t, "/made")) { return 3 }
    // A name with a slash is no folder's: said, and nothing made.
    if !click(t, filedialog.layoutOf(app).newFolder) || !run(t, "key Ctrl+A\n") || !typeText(t, "x/y", true) { return 4 }
    _ = pathOf(t, "/made/x")
    if filedialog.message(app).length == 0 || std.fs.exists(pathZ(t)) || !std.text.same(filedialog.directory(app), pathOf(t, "/made")) { return 5 }
    if !run(t, "key Escape\nkey Escape\n") || filedialog.isOpen(app) { return 6 }
    // A start that is not there: the home. Its places.
    if !openWith(t, pathOf(t, "/not-there"), false) || !run(t, "wait 16\n") { return 7 }
    if !std.text.same(filedialog.directory(app), homeOf(t, "")) { return 8 }
    if filedialog.placeCount(app) != 5 || !std.text.same(filedialog.placeAt(app, 0), homeOf(t, "")) || !std.text.same(filedialog.placeAt(app, 1), homeOf(t, "/Pictures")) { return 9 }
    // (The directories used last: the tree's root, then "sub".)
    if !std.text.same(filedialog.placeAt(app, 2), "/") || !std.text.same(filedialog.placeAt(app, 3), pathOf(t, "")) || !std.text.same(filedialog.placeAt(app, 4), pathOf(t, "/sub")) { return 10 }
    // A click on a place goes there.
    const layout = filedialog.layoutOf(app)
    if !click(t, ui.rect(layout.places.x, layout.places.y + 20 + 24, layout.places.width, 24)) || !std.text.same(filedialog.directory(app), homeOf(t, "/Pictures")) { return 11 }
    // A path that is not there is said (in German, too).
    if !click(t, filedialog.layoutOf(app).path) || !run(t, "key Ctrl+A\n") || !typeText(t, "/not-there-either", true) { return 12 }
    if !std.text.startsWith(filedialog.message(app), "There is no") { return 13 }
    if !run(t, "key Escape\nkey Escape\n") || filedialog.isOpen(app) { return 14 }
    // German: opened again (its title is the caller's), the same said so.
    if !run(t, "german\n") || !openWith(t, homeOf(t, "/Pictures"), false) || !click(t, filedialog.layoutOf(app).path) { return 15 }
    if !run(t, "key Ctrl+A\n") || !typeText(t, "/not-there-either", true) || !std.text.startsWith(filedialog.message(app), "Es gibt keinen") { return 16 }
    if !run(t, "key Escape\n") || !shot(t, "file-german.png") { return 17 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 18 }
    t.*.app.*.german = false
    return 0
}

// The window's sizes, the pixels.
fn checkLook(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "size 800 600\n") || !openWith(t, pathOf(t, ""), false) || !run(t, "wait 16\n") { return 1 }
    var layout = filedialog.layoutOf(app)
    var window = ui.rect(0, 0, 800, 600)
    if !inside(layout.box, window) || !inside(layout.accept, layout.box) || !inside(layout.cancel, layout.box) || !inside(layout.list, layout.box) || !inside(layout.filter, layout.box) { return 2 }
    if layout.list.height < 10 * 24 || layout.accept.y < ui.bottom(layout.list) { return 3 }
    if !run(t, "key Escape\nsize 1024 768\n") || !saveWith(t, pathOf(t, ""), "untitled.png") || !run(t, "wait 16\n") { return 4 }
    layout = filedialog.layoutOf(app)
    window = ui.rect(0, 0, 1024, 768)
    if !inside(layout.box, window) || !inside(layout.accept, layout.box) || !inside(layout.cancel, layout.box) || !inside(layout.name, layout.box) || !inside(layout.filter, layout.box) { return 5 }
    if ui.bottom(layout.name) > layout.accept.y || ui.right(layout.name) > layout.filter.x { return 6 }
    if !run(t, "key Escape\n") || !openWith(t, pathOf(t, ""), false) || !run(t, "key Down\n") { return 7 }
    // Every pixel of the dialog opaque; its ground the panel's; the
    // cursor's row lit.
    const frame = script.frameOf(app).?
    if frame.*.width != 1024 || frame.*.height != 768 { return 8 }
    layout = filedialog.layoutOf(app)
    var y = @intCast(usize, layout.box.y)
    while y < @intCast(usize, ui.bottom(layout.box)) {
        var x = @intCast(usize, layout.box.x)
        while x < @intCast(usize, ui.right(layout.box)) {
            if frame.*.pixels[y * frame.*.stride + x] >> 24 != 255 { return 9 }
            x += 1
        }
        y += 1
    }
    const theme = &app.*.theme
    const ground = canvas_module.over(theme.*.background | 0xFF000000, theme.*.panel, 255)
    const probe_x = @intCast(usize, layout.box.x + 4)
    const probe_y = @intCast(usize, layout.box.y + layout.box.height / 2)
    if frame.*.pixels[probe_y * frame.*.stride + probe_x] != ground { return 10 }
    const row = filedialog.rowArea(app, filedialog.cursorRow(app))
    const lit_x = @intCast(usize, ui.right(row) - 8)
    const lit_y = @intCast(usize, row.y + row.height / 2)
    if frame.*.pixels[lit_y * frame.*.stride + lit_x] != theme.*.menuChosen { return 11 }
    // Outside the dialog the window is darker than without it.
    const outside = frame.*.pixels[2 * frame.*.stride + 2]
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 12 }
    if frame.*.width != 1024 { return 13 }
    const bare = frame.*.pixels[2 * frame.*.stride + 2]
    if (outside & 255) + ((outside >> 8) & 255) >= (bare & 255) + ((bare >> 8) & 255) { return 14 }
    // Light: a picture to look at.
    t.*.app.*.shell.*.lightness = 1024
    if !openWith(t, pathOf(t, "/many"), false) || !run(t, "key Down\nkey Down\n") || !shot(t, "file-light.png") { return 15 }
    if !run(t, "key Escape\n") { return 16 }
    t.*.app.*.shell.*.lightness = 0
    // Both sizes, both languages, both kinds: every part in the box, the
    // rows of parts one beside the other without overlapping, ten rows of
    // the list at least.
    var shape: usize = 0
    while shape < 8 {
        const small = shape & 1 != 0
        app.*.german = shape & 2 != 0
        const saving = shape & 4 != 0
        if !run(t, if small { "size 800 600\n" } else { "size 1024 768\n" }) { return 17 }
        const opened = if saving { saveWith(t, pathOf(t, ""), "untitled.png") } else { openWith(t, pathOf(t, ""), false) }
        if !opened || !run(t, "wait 16\n") { return 18 }
        if !laidOut(filedialog.layoutOf(app), if small { ui.rect(0, 0, 800, 600) } else { ui.rect(0, 0, 1024, 768) }, saving) { return 19 }
        if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 20 }
        shape += 1
    }
    app.*.german = false
    return 0
}

// The dialog's parts in `window` as they should be.
fn laidOut(l: filedialog.Layout, window: ui.Rect, saving: bool) -> bool {
    const box = l.box
    if !inside(box, window) || !inside(l.up, box) || !inside(l.crumbs, box) || !inside(l.hidden, box) || !inside(l.newFolder, box) || !inside(l.path, box) { return false }
    if !inside(l.places, box) || !inside(l.frame, box) || !inside(l.list, l.frame) || !inside(l.filter, box) || !inside(l.message, box) || !inside(l.cancel, box) || !inside(l.accept, box) { return false }
    // The row of the directory, left to right; the path under it; the
    // places beside the list; the bottom under them.
    if ui.right(l.up) > l.crumbs.x || ui.right(l.crumbs) > l.hidden.x || ui.right(l.hidden) > l.newFolder.x { return false }
    if ui.bottom(l.up) > l.path.y || ui.bottom(l.path) > l.places.y || ui.bottom(l.path) > l.frame.y || ui.right(l.places) > l.frame.x { return false }
    if ui.right(l.message) > l.cancel.x || ui.right(l.cancel) > l.accept.x || l.list.height < 10 * 24 { return false }
    if saving {
        if !inside(l.name, box) || ui.bottom(l.frame) > l.name.y || ui.right(l.name) > l.filter.x || ui.bottom(l.name) > l.cancel.y || ui.bottom(l.filter) > l.cancel.y { return false }
    } else {
        if ui.bottom(l.frame) > l.cancel.y || ui.right(l.filter) > l.message.x { return false }
    }
    return true
}

// Frames one after another, the value arena given back before each as
// the window's loop does: what a frame takes does not grow.
fn checkArena(t: *T) -> u8 {
    const app = t.*.app
    if !openWith(t, pathOf(t, "/many"), false) || !run(t, "wait 16\nkey Down\n") { return 1 }
    const frame = script.frameOf(app).?
    var rounds: turns.Turns = undefined
    turns.begin(&rounds, true, false)
    const arena = rounds.base
    const mark = turns.used(arena)
    // (A tooltip may come up within the first second: compared from then.)
    var first: usize = 0
    var last: usize = 0
    var round: usize = 0
    while round < 200 {
        turns.turn(&rounds)
        app.*.shell.*.clock += 16
        loop.frame(app, frame)
        last = turns.used(arena) - mark
        if round == 80 { first = last }
        if last > 2097152 { return 2 }
        round += 1
    }
    const off = if last > first { last - first } else { first - last }
    if off > 1024 { return 3 }
    turns.turn(&rounds)
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 4 }
    return 0
}

// Opened and closed again and again: the heap as it was. Also when
// each time a file is saved under with another filter, a folder begun
// and given up, a path completed and left, and then a file taken.
fn checkHeap(t: *T) -> u8 {
    if !openWith(t, pathOf(t, "/many"), false) || !run(t, "wait 16\nkey End\nkey Escape\n") { return 1 }
    const live = std.heap.liveBytes()
    var round: usize = 0
    while round < 20 {
        if !openWith(t, pathOf(t, "/many"), false) || !run(t, "wait 16\nkey End\nkey Escape\n") || filedialog.isOpen(t.*.app) { return 2 }
        round += 1
    }
    const now = std.heap.liveBytes()
    const off = if now > live { now - live } else { live - now }
    if off > 1024 { return 3 }
    if !heapRound(t) { return 4 }
    const taken = calls
    const live_again = std.heap.liveBytes()
    round = 0
    while round < 10 {
        if !heapRound(t) { return 5 }
        round += 1
    }
    // (Nothing is kept from one round to the next: 0 bytes when this
    // was written; a leak of 26 bytes a round shows.)
    const now_again = std.heap.liveBytes()
    const off_again = if now_again > live_again { now_again - live_again } else { live_again - now_again }
    if calls != taken + 10 || off_again > 256 { return 6 }
    return 0
}

fn heapRound(t: *T) -> bool {
    const app = t.*.app
    if !saveWith(t, pathOf(t, ""), "untitled.png") || !run(t, "wait 16\n") || !chooseFilter(t, "Down") { return false }
    if !click(t, filedialog.layoutOf(app).newFolder) || !run(t, "key Escape\nkey Ctrl+L\n") { return false }
    if !typeText(t, pathOf(t, "/ma"), false) || !run(t, "key Tab\nkey Escape\nkey Escape\n") || filedialog.isOpen(app) { return false }
    return openWith(t, pathOf(t, "/sub"), false) && run(t, "wait 16\nkey Enter\n") && !filedialog.isOpen(app)
}

// "sizes/sNN.png" (two digits).
fn sizeName(index: usize, into: [*]u8) -> usize {
    var length = std.text.append(into, 0, 32, "/sizes/s")
    length = std.text.appendByte(into, length, 32, @intCast(u8, 48 + index / 10))
    length = std.text.appendByte(into, length, 32, @intCast(u8, 48 + index % 10))
    return std.text.append(into, length, 32, ".png")
}

// The size and date columns: a size rounded once, half up, to its unit
// (what rounds to 1000 is the next unit's); dates in the zone of TZ
// (two hours east: 22:13 UTC is 00:13 of the next day), German with a
// decimal comma and the day first; a date not known says nothing;
// sorted by the date and by the size.
fn checkSizes(t: *T) -> u8 {
    const app = t.*.app
    if !std.fs.makeDirectories(pathOf(t, "/sizes"), 493) { return 1 }
    // The sizes and what they are called, worked out by hand.
    const sizes = [12]u64{ 0, 999, 1000, 1049, 1050, 9949, 9950, 12451, 999499, 999500, 1000000, 1500000 }
    const said = [12][]const u8{ "0 B", "999 B", "1.0 kB", "1.0 kB", "1.1 kB", "9.9 kB", "10 kB", "12 kB", "999 kB", "1.0 MB", "1.0 MB", "1.5 MB" }
    // 14 November 2023 22:13:20 UTC; 1970 (not known); 29 February 2000 00:00 UTC.
    const times = [3]isize{ 1700000000, 0, 951782400 }
    var name: [32]u8 = undefined
    const name_bytes: [*]u8 = &name
    var index: usize = 0
    while index < 12 {
        const length = sizeName(index, name_bytes)
        if !makeFile(t, name_bytes[0..length], sizes[index], if index < 3 { times[index] } else { -1 }) { return 2 }
        index += 1
    }
    // Sizes of the gigabytes and terabytes, where the file system takes
    // them (they take no room).
    var huge: usize = 0
    if makeFile(t, "/sizes/s12.png", 5000000000, -1) && makeFile(t, "/sizes/s13.png", 999999999999, -1) && makeFile(t, "/sizes/s14.png", 12345678901234, -1) { huge = 3 }
    if !openWith(t, pathOf(t, "/sizes"), false) || !run(t, "wait 16\n") { return 3 }
    if filedialog.rowCount(app) < 12 + huge { return 4 }
    index = 0
    while index < 12 {
        const length = sizeName(index, name_bytes)
        if !nameIs(app, index, name_bytes[7..length]) || !std.text.same(filedialog.rowSize(app, index), said[index]) { return 5 }
        index += 1
    }
    if huge == 3 && (!std.text.same(filedialog.rowSize(app, 12), "5.0 GB") || !std.text.same(filedialog.rowSize(app, 13), "1.0 TB") || !std.text.same(filedialog.rowSize(app, 14), "12 TB")) { return 6 }
    if !std.text.same(filedialog.rowModified(app, 0), "2023-11-15 00:13") || filedialog.rowModified(app, 1).length != 0 || !std.text.same(filedialog.rowModified(app, 2), "2000-02-29 02:00") { return 7 }
    // A date of now: "YYYY-MM-DD HH:MM".
    const today = filedialog.rowModified(app, 3)
    if today.length != 16 || today[4] != '-' || today[7] != '-' || today[10] != ' ' || today[13] != ':' || today[0] < '2' { return 8 }
    app.*.german = true
    const german_ok = std.text.same(filedialog.rowSize(app, 2), "1,0 kB") && std.text.same(filedialog.rowSize(app, 7), "12 kB") && std.text.same(filedialog.rowModified(app, 0), "15.11.2023 00:13") && std.text.same(filedialog.rowModified(app, 2), "29.02.2000 02:00")
    app.*.german = false
    if !german_ok { return 9 }
    // By the date: 1970, 2000, 2023, then the files of now; the other way
    // round they come last.
    if !click(t, filedialog.layoutOf(app).modifiedHead) || !nameIs(app, 0, "s01.png") || !nameIs(app, 1, "s02.png") || !nameIs(app, 2, "s00.png") { return 10 }
    const count = filedialog.rowCount(app)
    if !click(t, filedialog.layoutOf(app).modifiedHead) || !nameIs(app, count - 1, "s01.png") || !nameIs(app, count - 2, "s02.png") || !nameIs(app, count - 3, "s00.png") { return 11 }
    // By the size (the sizes grow with the names), then back to the names.
    if !click(t, filedialog.layoutOf(app).sizeHead) || !nameIs(app, 0, "s00.png") || !nameIs(app, 11, "s11.png") { return 12 }
    if !click(t, filedialog.layoutOf(app).sizeHead) || !nameIs(app, count - 1, "s00.png") || !nameIs(app, count - 12, "s11.png") { return 13 }
    if !click(t, filedialog.layoutOf(app).nameHead) || !nameIs(app, 0, "s00.png") || !nameIs(app, 1, "s01.png") { return 14 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 15 }
    return 0
}

fn fold(byte: u8) -> u8 { return if byte >= 'A' && byte <= 'Z' { byte + 32 } else { byte } }

// The test's own order of names: letters' case aside, the shorter first
// when one starts the other, by the bytes when they differ only in case.
fn foldedBefore(x: []const u8, y: []const u8) -> bool {
    var index: usize = 0
    while index < x.length && index < y.length {
        if fold(x[index]) != fold(y[index]) { return fold(x[index]) < fold(y[index]) }
        index += 1
    }
    if x.length != y.length { return x.length < y.length }
    index = 0
    while index < x.length {
        if x[index] != y[index] { return x[index] < y[index] }
        index += 1
    }
    return false
}

// The size "big/NAME-N.png" was made with: N * 7919 % 5000 (0 for the
// names without a number).
fn bigSize(name: []const u8) -> u64 {
    var dash = name.length
    var at: usize = 0
    while at < name.length {
        if name[at] == '-' { dash = at }
        at += 1
    }
    if dash == name.length { return 0 }
    var number: u64 = 0
    at = dash + 1
    while at < name.length && name[at] >= '0' && name[at] <= '9' {
        number = number * 10 + @intCast(u64, name[at] - '0')
        at += 1
    }
    return number * 7919 % 5000
}

// Row `a` comes before row `b`: directories first, then by the column.
fn rowsInOrder(app: *App, a: usize, b: usize, by_size: bool, descending: bool) -> bool {
    const x_directory = filedialog.rowIsDirectory(app, a)
    if x_directory != filedialog.rowIsDirectory(app, b) { return x_directory }
    const x = filedialog.rowName(app, a)
    const y = filedialog.rowName(app, b)
    if by_size && !x_directory && bigSize(x) != bigSize(y) {
        return if descending { bigSize(x) > bigSize(y) } else { bigSize(x) < bigSize(y) }
    }
    return if descending { foldedBefore(y, x) } else { foldedBefore(x, y) }
}

fn allInOrder(app: *App, by_size: bool, descending: bool) -> bool {
    const count = filedialog.rowCount(app)
    var row: usize = 1
    while row < count {
        if !rowsInOrder(app, row - 1, row, by_size, descending) { return false }
        row += 1
    }
    return true
}

// Thousands of entries of mixed case (directories, pictures, others,
// names that differ only in case, one of 255 bytes): what the filter
// takes shows, in the order asked for (checked pair by pair with the
// test's own order, both ways, by the size too); End and Home; letters
// typed go to the first row (found by the test's own search) that
// starts with them; reading them again takes no more of the value arena
// than reading a folder of one, and keys and readings over and over do
// not make it grow.
fn checkBig(t: *T) -> u8 {
    const app = t.*.app
    if !std.fs.makeDirectories(pathOf(t, "/big"), 493) { return 1 }
    var shown: usize = 0
    var seed: u32 = 12345
    var name: [80]u8 = undefined
    const bytes: [*]u8 = &name
    var index: usize = 0
    while index < 2500 {
        var length = std.text.append(bytes, 0, 80, "/big/")
        // 1 to 12 letters and digits of both cases, "-", the index.
        seed = seed *% 1103515245 +% 12345
        const letters = 1 + (seed >> 16) % 12
        var letter: u32 = 0
        while letter < letters {
            seed = seed *% 1103515245 +% 12345
            const pick = (seed >> 16) % 62
            const byte = if pick < 26 { 65 + pick } else if pick < 52 { 71 + pick } else { pick - 4 }
            length = std.text.appendByte(bytes, length, 80, @intCast(u8, byte))
            letter += 1
        }
        length = std.text.appendByte(bytes, length, 80, '-')
        length = std.text.appendUnsigned(bytes, length, 80, index)
        if index % 100 == 7 {
            if !std.fs.makeDirectories(pathOf(t, bytes[0..length]), 493) { return 2 }
            shown += 1
        } else {
            const picture = index % 5 != 0
            length = std.text.append(bytes, length, 80, if picture { ".png" } else { ".txt" })
            if !makeFile(t, bytes[0..length], @intCast(u64, index * 7919 % 5000), -1) { return 3 }
            if picture { shown += 1 }
        }
        index += 1
    }
    if !makeFile(t, "/big/ab.png", 0, -1) || !makeFile(t, "/big/AB.png", 0, -1) || !makeFile(t, "/big/Ab.png", 0, -1) || !makeFile(t, "/big/aB.png", 0, -1) { return 4 }
    const long_at = pathOf(t, "/big/").length
    var long: usize = 0
    while long < 251 {
        t.*.path[long_at + long] = 'Q'
        long += 1
    }
    const path_bytes: [*]u8 = &t.*.path
    const long_end = std.text.append(path_bytes, long_at + 251, 1199, ".png")
    t.*.path[long_end] = 0
    const long_file = std.fs.open(pathZ(t), std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.isValid(long_file) { return 5 }
    _ = std.fs.close(long_file)
    shown += 5
    if !openWith(t, pathOf(t, "/big"), false) || !run(t, "wait 16\n") { return 6 }
    const count = filedialog.rowCount(app)
    if count != shown || !allInOrder(app, false, false) { return 7 }
    // The names that differ only in case one after another; the long one whole.
    var row: usize = 0
    var found_long = false
    while row < count {
        if nameIs(app, row, "AB.png") && (!nameIs(app, row + 1, "Ab.png") || !nameIs(app, row + 2, "aB.png") || !nameIs(app, row + 3, "ab.png")) { return 8 }
        if filedialog.rowName(app, row).length == 255 { found_long = true }
        row += 1
    }
    if !found_long { return 9 }
    if !run(t, "key End\n") || filedialog.cursorRow(app) != count - 1 || !inside(filedialog.rowArea(app, count - 1), filedialog.layoutOf(app).list) { return 10 }
    if !run(t, "key Home\n") || filedialog.cursorRow(app) != 0 || !inside(filedialog.rowArea(app, 0), filedialog.layoutOf(app).list) { return 11 }
    // Both ways by name, by the size both ways.
    if !click(t, filedialog.layoutOf(app).nameHead) || !allInOrder(app, false, true) { return 12 }
    if !click(t, filedialog.layoutOf(app).sizeHead) || !allInOrder(app, true, false) { return 13 }
    if !click(t, filedialog.layoutOf(app).sizeHead) || !allInOrder(app, true, true) { return 14 }
    if !click(t, filedialog.layoutOf(app).nameHead) || !allInOrder(app, false, false) { return 15 }
    // Two letters of a name half way down: the first row that starts so.
    var pick = count / 2
    while pick < count && (filedialog.rowName(app, pick).length < 3 || filedialog.rowName(app, pick)[1] == '-') { pick += 1 }
    if pick == count { return 16 }
    const typed = filedialog.rowName(app, pick)[0..2]
    var expected: usize = 0
    while expected < count && !(fold(filedialog.rowName(app, expected)[0]) == fold(typed[0]) && filedialog.rowName(app, expected).length >= 2 && fold(filedialog.rowName(app, expected)[1]) == fold(typed[1])) { expected += 1 }
    if !run(t, "wait 1100\n") || !typeText(t, typed, false) || filedialog.cursorRow(app) != expected { return 17 }
    // Reading the 2 500 entries again (F5) takes of the value arena what
    // a key that reads nothing does (the same rows are drawn after
    // either): nothing per entry. (Each takes a frame's worth: the
    // window is drawn after a key.)
    const arena = turns.locate()
    if !run(t, "wait 16\n") { return 18 }
    var before = turns.used(arena)
    if !run(t, "key Down\n") { return 19 }
    const key_use = turns.used(arena) - before
    const kept = filedialog.cursorRow(app)
    before = turns.used(arena)
    // (The cursor stays on its entry.)
    if !run(t, "key F5\n") || filedialog.rowCount(app) != count || filedialog.cursorRow(app) != kept || kept != expected + 1 { return 20 }
    const read_use = turns.used(arena) - before
    if read_use > key_use + 2048 { return 21 }
    // Keys and readings 300 times over, the arena given back between as
    // the window's loop does: what one takes does not grow.
    var rounds: turns.Turns = undefined
    turns.begin(&rounds, true, false)
    const mark = turns.used(arena)
    var first: usize = 0
    var round: usize = 0
    while round < 300 {
        turns.turn(&rounds)
        var step: []const u8 = "key Down\n"
        if round % 3 == 0 { step = "key Up\n" }
        if round % 50 == 49 { step = "key F5\n" }
        if !run(t, step) { return 22 }
        const used = turns.used(arena) - mark
        if round == 49 { first = used }
        if used > 4194304 || (round == 299 && used > first + 1024) { return 23 }
        round += 1
    }
    turns.turn(&rounds)
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 24 }
    return 0
}

fn nothing(app: *App, window: ui.Rect) -> void {}

fn otherDialog(app: *App) -> bool {
    return api.pushDialog(app, state.Dialog.{ .draw = nothing, .keyPress = null, .cancel = null, .accept = null })
}

// Edges: no filters at all; opened while open; no room for another
// dialog; closed under another dialog (nothing of it stays); a folder
// typed with a slash that is not there, while saving; a name with a
// folder before it saved there (and "" starts there next); a start that
// cannot be read is said.
fn checkEdges(t: *T) -> u8 {
    const app = t.*.app
    var expected_calls = calls
    if !std.fs.makeDirectories(pathOf(t, "/edges/inner"), 493) || !makeFile(t, "/edges/one.png", 1, -1) || !makeFile(t, "/edges/two.txt", 2, -1) { return 1 }
    const one = [1]filedialog.Filter{ filedialog.Filter.{ .name = "PNG image", .german = "PNG-Bild", .extensions = "png" } }
    // No filters: every file, no list of them; saving adds no extension.
    if !filedialog.open(app, "Open", pathOf(t, "/edges"), one[0..0], done) || !run(t, "wait 16\n") { return 2 }
    if filedialog.rowCount(app) != 3 || !nameIs(app, 0, "inner") || !nameIs(app, 2, "two.txt") || filedialog.layoutOf(app).filter.width != 0 { return 3 }
    if !run(t, "key Escape\n") || !filedialog.save(app, "Save", pathOf(t, "/edges"), "plain", one[0..0], done) || !run(t, "wait 16\nkey Enter\n") { return 4 }
    expected_calls += 1
    if filedialog.isOpen(app) || calls != expected_calls || !lastIs(t, "/edges/plain") || lastFilter != 0 { return 5 }
    // Opened while open: one dialog, showing the second request.
    if !openWith(t, pathOf(t, "/edges"), false) || !openWith(t, pathOf(t, "/edges/inner"), false) || !run(t, "wait 16\n") { return 6 }
    if app.*.dialogCount != 1 || !std.text.same(filedialog.directory(app), pathOf(t, "/edges/inner")) { return 7 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) || app.*.dialogCount != 0 || calls != expected_calls { return 8 }
    // No room: not shown, nothing kept.
    while app.*.dialogCount < state.DIALOGS {
        if !otherDialog(app) { return 9 }
    }
    const live = std.heap.liveBytes()
    if openWith(t, pathOf(t, "/edges"), false) || filedialog.isOpen(app) || std.heap.liveBytes() != live { return 10 }
    while app.*.dialogCount > 0 { api.popDialog(app) }
    // Closed under another: once that one goes, nothing stands in the way.
    if !openWith(t, pathOf(t, "/edges"), false) || !otherDialog(app) || !run(t, "wait 16\n") { return 11 }
    filedialog.close(app)
    if filedialog.isOpen(app) || !run(t, "wait 16\n") { return 12 }
    api.popDialog(app)
    if !run(t, "wait 16\n") || app.*.dialogCount != 0 { return 13 }
    // Saving: a folder asked for (a slash at its end) that is not there.
    if !saveWith(t, pathOf(t, "/edges"), "untitled.png") || !run(t, "wait 16\nkey Ctrl+L\n") { return 14 }
    if !typeText(t, pathOf(t, "/edges/nowhere/"), true) || !filedialog.isOpen(app) || calls != expected_calls || !std.text.startsWith(filedialog.message(app), "There is no folder") { return 15 }
    // A name with a folder before it: saved in that folder, which is
    // where the next opening without a directory starts.
    expected_calls += 1
    if !run(t, "key Escape\nkey Ctrl+A\n") || !typeText(t, "inner/deep", true) || filedialog.isOpen(app) || calls != expected_calls || !lastIs(t, "/edges/inner/deep.png") { return 16 }
    if !openWith(t, "", false) || !std.text.same(filedialog.directory(app), pathOf(t, "/edges/inner")) || !run(t, "key Escape\n") { return 17 }
    // A start that cannot be read: the home, and the line says which.
    if !openWith(t, pathOf(t, "/edges/not-there"), false) || !run(t, "wait 16\n") { return 18 }
    if !std.text.same(filedialog.directory(app), homeOf(t, "")) || !std.text.contains(filedialog.message(app), "/edges/not-there") { return 19 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 20 }
    return 0
}

// Windows of no pixels up to 400 x 400 (the shell's size set directly:
// scripts take 64 at least), the dialog drawn, clicked and keyed in both
// modes: nothing traps, nothing is drawn outside the window, and at
// 0 x 0 the dialog takes no room.
fn checkTiny(t: *T) -> u8 {
    const app = t.*.app
    var mode: usize = 0
    while mode < 2 {
        var size: i32 = 0
        while size <= 400 {
            const opened = if mode == 0 { openWith(t, pathOf(t, ""), false) } else { saveWith(t, pathOf(t, ""), "untitled.png") }
            if !opened { return 1 }
            app.*.shell.*.width = size
            app.*.shell.*.height = size / 2
            if !run(t, "wait 16\nclick 1 1\nclick 20 12\nkey Down\nkey End\nkey Tab\nkey Ctrl+H\nkey Ctrl+H\nwait 16\n") { return 2 }
            const box = filedialog.layoutOf(app).box
            if box.width < 0 || box.height < 0 || box.x < 0 || box.y < 0 || ui.right(box) > size || ui.bottom(box) > size / 2 { return 3 }
            if size == 0 && (box.width != 0 || box.height != 0) { return 4 }
            filedialog.close(app)
            if filedialog.isOpen(app) { return 5 }
            size += if size < 4 { 1 } else { 33 }
        }
        mode += 1
    }
    if !run(t, "size 1024 768\nwait 16\n") || app.*.dialogCount != 0 { return 6 }
    return 0
}

// More keys and clicks: several chosen by Shift+click and Ctrl+click,
// and by Shift with the keys (a call for each, in the list's order);
// Page Down and Page Up by the list's whole rows less one; the
// clipboard in the name field; Tab completing as far as the names agree
// (no slash after a file's); Escape leaving the path field first; a
// double click taking a file; a folder that is there not made again; a
// folder gone when it is read again said, and Backspace leaving it;
// Backspace at the root.
fn checkKeys(t: *T) -> u8 {
    const app = t.*.app
    if !std.fs.makeDirectories(pathOf(t, "/keys/pick"), 493) || !std.fs.makeDirectories(pathOf(t, "/keys/gone"), 493) { return 1 }
    if !makeFile(t, "/keys/pick/p1.png", 1, -1) || !makeFile(t, "/keys/pick/p2.png", 1, -1) || !makeFile(t, "/keys/pick/p3.png", 1, -1) || !makeFile(t, "/keys/pick/p4.png", 1, -1) || !makeFile(t, "/keys/pick/p5.png", 1, -1) { return 1 }
    if !makeFile(t, "/keys/alpha-one.png", 1, -1) || !makeFile(t, "/keys/alpha-two.png", 1, -1) { return 1 }
    // A click on p1, Shift+click on p3, Ctrl+click on p5 and on p2 (off
    // again): p1, p3, p5.
    if !openWith(t, pathOf(t, "/keys/pick"), true) || !run(t, "wait 16\n") || filedialog.rowCount(app) != 5 { return 2 }
    var expected_calls = calls + 3
    joinedLength = 0
    if !click(t, filedialog.rowArea(app, 0)) || !run(t, "down Shift\n") || !click(t, filedialog.rowArea(app, 2)) || !run(t, "up Shift\ndown Ctrl\n") { return 3 }
    if !click(t, filedialog.rowArea(app, 4)) || !click(t, filedialog.rowArea(app, 1)) || !run(t, "up Ctrl\nkey Enter\n") { return 4 }
    if filedialog.isOpen(app) || calls != expected_calls || !joinedIs("p1.png;p3.png;p5.png;") { return 5 }
    // Home, Shift+Down twice, Enter: p1, p2, p3.
    if !openWith(t, pathOf(t, "/keys/pick"), true) || !run(t, "wait 16\nkey Home\nkey Shift+Down\nkey Shift+Down\nkey Enter\n") { return 6 }
    expected_calls += 3
    if filedialog.isOpen(app) || calls != expected_calls || !joinedIs("p1.png;p3.png;p5.png;p1.png;p2.png;p3.png;") { return 7 }
    // A double click on p4 takes it.
    if !openWith(t, pathOf(t, "/keys/pick"), false) || !run(t, "wait 16\n") { return 8 }
    const fourth = filedialog.rowArea(app, 3)
    expected_calls += 1
    if !click(t, fourth) || !click(t, fourth) || filedialog.isOpen(app) || calls != expected_calls || !lastIs(t, "/keys/pick/p4.png") { return 9 }
    // Page Down and Page Up: as many rows as the list shows whole, less one.
    if !openWith(t, pathOf(t, "/many"), false) || !run(t, "wait 16\nkey Home\nkey PageDown\n") { return 10 }
    const page = @intCast(usize, filedialog.layoutOf(app).list.height / 24 - 1)
    if page < 9 || filedialog.cursorRow(app) != page || !inside(filedialog.rowArea(app, page), filedialog.layoutOf(app).list) { return 11 }
    if !run(t, "key PageDown\nkey PageUp\n") || filedialog.cursorRow(app) != page { return 12 }
    if !run(t, "key PageUp\nkey PageUp\n") || filedialog.cursorRow(app) != 0 { return 13 }
    if !run(t, "key End\nkey PageDown\n") || filedialog.cursorRow(app) != 299 || !run(t, "key Escape\n") { return 14 }
    // The clipboard: all of the name cut, put back twice.
    if !saveWith(t, pathOf(t, "/keys"), "untitled.png") || !run(t, "wait 16\nkey Ctrl+A\nkey Ctrl+X\n") || filedialog.nameText(app).length != 0 { return 15 }
    if !std.text.same(shell_module.clipboard(app.*.shell, "text/plain;charset=utf-8"), "untitled.png") { return 16 }
    if !run(t, "key Ctrl+V\nkey Ctrl+V\n") || !std.text.same(filedialog.nameText(app), "untitled.pnguntitled.png") || !run(t, "key Escape\n") { return 17 }
    // Tab: "al" to "alpha-" (two names agree so far), "o" to the file.
    if !openWith(t, pathOf(t, "/keys"), false) || !run(t, "wait 16\nkey Ctrl+L\n") || !typeText(t, pathOf(t, "/keys/al"), false) || !run(t, "key Tab\n") { return 18 }
    if !std.text.same(filedialog.pathText(app), pathOf(t, "/keys/alpha-")) { return 18 }
    if !typeText(t, "o", false) || !run(t, "key Tab\n") || !std.text.same(filedialog.pathText(app), pathOf(t, "/keys/alpha-one.png")) { return 19 }
    // Escape leaves the field (the path shows the folder again), then closes.
    if !run(t, "key Escape\n") || !filedialog.isOpen(app) || !std.text.same(filedialog.pathText(app), pathOf(t, "/keys/")) { return 20 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) || calls != expected_calls { return 20 }
    return 0
}

// The folders: one that is there not made again, one gone said, "~" and
// "/" typed over the list starting a path, Alt+Up, the root.
fn checkGone(t: *T) -> u8 {
    const app = t.*.app
    // New Folder "pick": there already, said; nothing changes.
    if !openWith(t, pathOf(t, "/keys"), false) || !run(t, "wait 16\n") || !click(t, filedialog.layoutOf(app).newFolder) { return 1 }
    if !run(t, "key Ctrl+A\n") || !typeText(t, "pick", true) || !std.text.contains(filedialog.message(app), "pick") || !std.text.same(filedialog.directory(app), pathOf(t, "/keys")) { return 2 }
    if !run(t, "key Escape\nkey Escape\n") || filedialog.isOpen(app) { return 3 }
    // A folder taken away while shown: F5 says it cannot be read and
    // stays; Backspace goes up.
    if !openWith(t, pathOf(t, "/keys/gone"), false) || !run(t, "wait 16\n") { return 4 }
    _ = pathOf(t, "/keys/gone")
    if !std.fs.removeDir(pathZ(t)) { return 4 }
    if !run(t, "key F5\n") || !std.text.contains(filedialog.message(app), "cannot be read") || !std.text.same(filedialog.directory(app), pathOf(t, "/keys/gone")) { return 5 }
    if !run(t, "key Backspace\n") || !std.text.same(filedialog.directory(app), pathOf(t, "/keys")) || !cursorIs(app, "pick") { return 6 }
    // "~" typed over the list starts a path from the home.
    if !typeText(t, "~/Pictures", true) || !std.text.same(filedialog.directory(app), homeOf(t, "/Pictures")) { return 7 }
    // "/" too; Alt+Up goes up.
    if !typeText(t, pathOf(t, "/keys/pick"), true) || !std.text.same(filedialog.directory(app), pathOf(t, "/keys/pick")) { return 8 }
    if !run(t, "key Alt+Up\n") || !std.text.same(filedialog.directory(app), pathOf(t, "/keys")) { return 9 }
    // The root: nothing above it.
    if !openWith(t, "/", false) || !run(t, "wait 16\nkey Backspace\nkey Alt+Up\n") || !std.text.same(filedialog.directory(app), "/") { return 10 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 11 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(T), 16)
    if memory == null { return 1 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    t.*.shots = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { t.*.shots = std.string.asSlice(named.?) }
    // The tree, under the current directory.
    var here: [600]u8 = undefined
    const here_bytes: [*]u8 = &here
    if std.fs.getWorkingDirectory(here_bytes, 500) <= 0 { return 2 }
    const working = std.text.cString(here_bytes)
    const root_bytes: [*]u8 = &t.*.root
    t.*.rootLength = std.text.append(root_bytes, std.text.append(root_bytes, 0, 600, working), 600, "/test-56")
    if !makeTree(t) { return 3 }
    const made = script.headless(allocator)
    if made == null { return 4 }
    t.*.app = made.?
    if !setHome(t, allocator) { return 5 }
    if !run(t, "size 1024 768\n") { return 6 }

    // (Never 13 for a failure: the first numbers start above it.)
    var failed = checkOpening(t)
    if failed != 0 { return 13 + failed }
    failed = checkList(t)
    if failed != 0 { return 40 + failed }
    failed = checkSaving(t)
    if failed != 0 { return 70 + failed }
    failed = checkFolders(t)
    if failed != 0 { return 100 + failed }
    failed = checkLook(t)
    if failed != 0 { return 130 + failed }
    failed = checkArena(t)
    if failed != 0 { return 150 + failed }
    failed = checkHeap(t)
    if failed != 0 { return 155 + failed }
    // Kept for the next run: the directories used last.
    var recent = std.ArrayList(u8).init(allocator)
    filedialog.recentDirectories(t.*.app, &recent)
    if !std.text.startsWith(recent.items(), pathOf(t, "")) { return 162 }
    filedialog.setRecentDirectories(t.*.app, "/\nrelative/not/kept\n/a/../b/\n")
    recent.clearRetainingCapacity()
    filedialog.recentDirectories(t.*.app, &recent)
    if !std.text.same(recent.items(), "/\n/b") { return 163 }
    failed = checkSizes(t)
    if failed != 0 { return 163 + failed }
    failed = checkBig(t)
    if failed != 0 { return 178 + failed }
    failed = checkEdges(t)
    if failed != 0 { return 202 + failed }
    // (The numbers left between the first checks' are used.)
    failed = checkTiny(t)
    if failed != 0 { return 89 + failed }
    failed = checkKeys(t)
    if failed != 0 { return 222 + failed }
    failed = checkGone(t)
    if failed != 0 { return 118 + failed }
    return 13
}
