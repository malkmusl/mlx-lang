// nebula's image: layers in a tree mixed into the projection (opacity, a
// hidden layer, a group with its own opacity and a pass-through one, a
// fill layer, a filter layer and its mask, a transparency mask, a clone,
// a layer that inherits alpha, an overlay with and without a selection),
// and every step undone and redone: new and removed layers, moves,
// properties, pixels, the selection, several things as one step, the
// limit of steps. Mixing many times takes no memory of the value arena.
// Exits 13.
const std = @import("std")
const turns = @import("std.turns")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const node = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")
const filters = @import("../filters/registry.mlx")

const RED: u32 = 0xFFFF0000
const GREEN: u32 = 0xFF00FF00
const BLUE: u32 = 0xFF0000FF
const WHITE: u32 = 0xFFFFFFFF

fn shown(image: *image_module.Image, x: i32, y: i32) -> u32 {
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

fn paint(image: *image_module.Image, layer: *node.Node, area: geom.Rect, color: u32, name: []const u8) -> void {
    _ = ops.beginPixels(image, layer)
    _ = device.fill(layer.*.device.?, area, color)
    _ = ops.endPixels(image, layer, name)
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const made = image_module.create(allocator, 300, 200, 72.0)
    if made == null { return 1 }
    const image = made.?
    if image_module.create(allocator, 0, 10, 72.0) != null { return 2 }
    if shown(image, 10, 10) != 0 { return 3 }

    // A red layer, a half-opaque green one over part of it.
    const background = ops.newLayer(image, node.PAINT, "Background", "New layer").?
    paint(image, background, geom.rect(0, 0, 300, 200), RED, "Fill")
    if shown(image, 10, 10) != RED || shown(image, 299, 199) != RED { return 4 }
    const green = ops.newLayer(image, node.PAINT, "Green", "New layer").?
    paint(image, green, geom.rect(50, 50, 100, 100), GREEN, "Fill")
    if shown(image, 60, 60) != GREEN || shown(image, 10, 10) != RED { return 5 }
    ops.setOpacity(image, green, 128, "Opacity")
    const mixed = shown(image, 60, 60)
    if mixed != pixel.over(RED, GREEN, 128) || pixel.red(mixed) != 127 || pixel.green(mixed) != 128 { return 6 }
    ops.setVisible(image, green, false, "Hide")
    if shown(image, 60, 60) != RED { return 7 }
    _ = history.undo(image.*.history, image)
    if shown(image, 60, 60) != mixed { return 8 }
    _ = history.undo(image.*.history, image)
    if shown(image, 60, 60) != GREEN || green.*.opacity != 255 { return 9 }
    _ = history.redo(image.*.history, image)
    if shown(image, 60, 60) != mixed || green.*.opacity != 128 { return 10 }
    if !std.text.same(history.undoName(image.*.history), "Opacity") || !std.text.same(history.redoName(image.*.history), "Hide") { return 11 }

    // The pixels' own undo, and what is drawn again is where they are.
    paint(image, green, geom.rect(50, 50, 10, 10), BLUE, "Blue corner")
    if shown(image, 55, 55) != pixel.over(RED, BLUE, 128) { return 12 }
    const back = history.undo(image.*.history, image)
    if back.x != 0 || back.y != 0 || back.width != 64 || back.height != 64 { return 14 }
    if shown(image, 55, 55) != mixed { return 15 }

    // A group at half opacity holding an opaque blue layer; the same
    // passed through shows it whole.
    ops.setOpacity(image, green, 255, "Opacity")
    const group = ops.newLayer(image, node.GROUP, "Group", "New group").?
    const blue = ops.newLayer(image, node.PAINT, "Blue", "New layer").?
    if blue.*.parent == null || @intFromPtr(blue.*.parent.?) != @intFromPtr(group) { return 16 }
    paint(image, blue, geom.rect(100, 100, 100, 50), BLUE, "Fill")
    ops.setOpacity(image, group, 128, "Opacity")
    if shown(image, 120, 120) != pixel.over(GREEN, BLUE, 128) || shown(image, 180, 120) != pixel.over(RED, BLUE, 128) { return 17 }
    const group_before = node.props(group)
    group.*.passThrough = true
    ops.changed(image, group, &group_before, "Pass through")
    if shown(image, 120, 120) != BLUE { return 18 }
    _ = history.undo(image.*.history, image)
    if shown(image, 120, 120) != pixel.over(GREEN, BLUE, 128) { return 19 }

    // A transparency mask on the group: nothing of it left of x = 150.
    const hole = ops.newMask(image, group, node.TRANSPARENCY_MASK, "Mask", "New mask").?
    if shown(image, 120, 120) != pixel.over(GREEN, BLUE, 128) { return 20 }
    _ = ops.beginPixels(image, hole)
    _ = device.fill(hole.*.device.?, geom.rect(0, 0, 150, 200), mask.NOTHING)
    _ = ops.endPixels(image, hole, "Mask")
    if shown(image, 120, 120) != GREEN || shown(image, 180, 120) != pixel.over(RED, BLUE, 128) { return 21 }
    ops.remove(image, hole, "Remove mask")
    if shown(image, 120, 120) != pixel.over(GREEN, BLUE, 128) { return 22 }
    _ = history.undo(image.*.history, image)
    if shown(image, 120, 120) != GREEN { return 23 }
    _ = history.redo(image.*.history, image)

    // Moved below the green layer, the group shows only beside it.
    if !ops.move(image, group, image.*.root, 1, "Move") { return 24 }
    if shown(image, 120, 120) != GREEN || shown(image, 180, 120) != pixel.over(RED, BLUE, 128) { return 25 }
    _ = history.undo(image.*.history, image)
    if shown(image, 120, 120) != pixel.over(GREEN, BLUE, 128) { return 26 }
    if ops.move(image, group, blue, 0, "Move") { return 27 }

    // A filter layer inverting everything below it, then only where its
    // mask says.
    image.*.active = group
    group.*.collapsed = true
    const invert = ops.newLayer(image, node.FILTER, "Invert", "New filter layer").?
    if invert.*.parent == null || @intFromPtr(invert.*.parent.?) != @intFromPtr(image.*.root) { return 28 }
    const invert_before = node.props(invert)
    invert.*.params.id = filters.INVERT
    ops.changed(image, invert, &invert_before, "Filter")
    if shown(image, 10, 10) != 0xFF00FFFF || shown(image, 60, 60) != 0xFFFF00FF { return 29 }
    _ = ops.beginPixels(image, invert)
    _ = device.fill(invert.*.device.?, geom.rect(0, 0, 300, 100), mask.NOTHING)
    _ = ops.endPixels(image, invert, "Filter mask")
    if shown(image, 10, 10) != RED || shown(image, 10, 150) != 0xFF00FFFF { return 30 }
    ops.setOpacity(image, invert, 0, "Opacity")
    if shown(image, 10, 150) != RED { return 31 }

    // A fill layer, clipped to what is below it in its group by
    // inheriting alpha.
    const island = ops.newLayer(image, node.GROUP, "Island", "New group").?
    const base = ops.newLayer(image, node.PAINT, "Base", "New layer").?
    paint(image, base, geom.rect(200, 0, 50, 50), GREEN, "Fill")
    const flood = ops.newLayer(image, node.FILL, "White", "New fill layer").?
    const flood_before = node.props(flood)
    flood.*.params.values[0] = 255.0
    flood.*.params.values[1] = 255.0
    flood.*.params.values[2] = 255.0
    flood.*.params.values[3] = 255.0
    ops.changed(image, flood, &flood_before, "Colour")
    if shown(image, 5, 5) != WHITE || shown(image, 210, 10) != WHITE { return 32 }
    const flood_free = node.props(flood)
    flood.*.inheritAlpha = true
    ops.changed(image, flood, &flood_free, "Inherit alpha")
    if shown(image, 5, 5) != RED || shown(image, 210, 10) != WHITE || shown(image, 260, 10) != RED { return 33 }
    if @intFromPtr(flood.*.parent.?) != @intFromPtr(island) { return 34 }

    // A clone of the base, moved 60 down.
    image.*.active = island
    island.*.collapsed = true
    const clone = ops.newLayer(image, node.CLONE, "Clone", "New clone").?
    const clone_before = node.props(clone)
    clone.*.cloneOf = base.*.id
    ops.changed(image, clone, &clone_before, "Clone")
    device.moveTo(clone.*.device.?, 0, 60)
    image_module.damageAll(image)
    if shown(image, 210, 70) != GREEN || shown(image, 210, 55) != RED { return 35 }

    // An overlay: shown, not kept; only in the selection when masked.
    const stroke = device.create(allocator, 0).?
    _ = device.fill(stroke, geom.rect(0, 180, 300, 10), BLUE)
    background.*.overlay = stroke
    background.*.overlayOpacity = 255
    background.*.overlayBlend = blend.NORMAL
    image_module.damage(image, device.extent(stroke))
    if shown(image, 5, 185) != BLUE || device.pixel(background.*.device.?, 5, 185) != RED { return 36 }
    ops.beginSelection(image)
    _ = device.fill(image.*.selection, geom.rect(0, 0, 100, 200), mask.ALL)
    ops.endSelection(image, true, "Select")
    if !image.*.selected || image_module.selectedAt(image, 50, 50) != 255 || image_module.selectedAt(image, 150, 50) != 0 { return 37 }
    background.*.overlayMasked = true
    image_module.damageAll(image)
    if shown(image, 5, 185) != BLUE || shown(image, 150, 185) != RED { return 38 }
    background.*.overlay = null
    device.destroy(stroke)
    image_module.damageAll(image)
    if shown(image, 5, 185) != RED { return 39 }
    _ = history.undo(image.*.history, image)
    if image.*.selected || image_module.selectedAt(image, 150, 50) != 255 { return 40 }
    _ = history.redo(image.*.history, image)
    if !image.*.selected || image_module.selectedAt(image, 150, 50) != 0 { return 41 }
    ops.beginSelection(image)
    ops.endSelection(image, false, "Deselect")
    if image.*.selected || device.tileCount(image.*.selection) != 0 { return 42 }
    _ = history.undo(image.*.history, image)
    if !image.*.selected || image_module.selectedAt(image, 50, 50) != 255 { return 43 }

    // Several things as one step.
    const steps = history.stepsDone(image.*.history)
    history.begin(image.*.history, "Three at once")
    const extra = ops.newLayer(image, node.PAINT, "Extra", "New layer").?
    paint(image, extra, geom.rect(0, 0, 20, 20), BLUE, "Fill")
    ops.setOpacity(image, extra, 200, "Opacity")
    history.end(image.*.history)
    if history.stepsDone(image.*.history) != steps + 1 || !std.text.same(history.undoName(image.*.history), "Three at once") { return 44 }
    const extra_id = extra.*.id
    const count = image_module.nodeCount(image)
    _ = history.undo(image.*.history, image)
    if image_module.find(image, extra_id) != null || image_module.nodeCount(image) != count - 1 { return 45 }
    if image.*.active == null { return 46 }
    _ = history.redo(image.*.history, image)
    const again = image_module.find(image, extra_id)
    if again == null || again.?.*.opacity != 200 || device.pixel(again.?.*.device.?, 5, 5) != BLUE { return 47 }
    if history.stepName(image.*.history, 0).length == 0 || history.stepCount(image.*.history) != history.stepsDone(image.*.history) { return 48 }

    // Recording after an undo forgets what was undone; a jump goes back
    // and forth.
    _ = history.undo(image.*.history, image)
    paint(image, background, geom.rect(0, 0, 4, 4), WHITE, "Dot")
    if history.canRedo(image.*.history) || image_module.find(image, extra_id) != null { return 49 }
    const all = history.stepsDone(image.*.history)
    _ = history.jump(image.*.history, image, 2)
    if history.stepsDone(image.*.history) != 2 || image_module.nodeCount(image) != 1 { return 50 }
    if shown(image, 60, 60) != RED { return 51 }
    _ = history.jump(image.*.history, image, all)
    if history.stepsDone(image.*.history) != all || device.pixel(background.*.device.?, 1, 1) != WHITE { return 52 }

    // No more steps than the limit.
    image.*.history.*.limit = 5
    var round: u32 = 0
    while round < 12 {
        paint(image, background, geom.rect(0, 0, 2, 2), 0xFF000000 | round, "Dot")
        round += 1
    }
    if history.stepCount(image.*.history) != 5 { return 53 }
    _ = history.jump(image.*.history, image, 0)
    if device.pixel(background.*.device.?, 0, 0) != (0xFF000000 | 6) { return 54 }

    // A duplicate has new ids and shares the pixels until written.
    var next = image.*.nextId
    const twin = node.duplicate(island, &next)
    if twin == null { return 55 }
    image.*.nextId = next
    if twin.?.*.id == island.*.id || node.childCount(twin.?) != node.childCount(island) { return 56 }
    if !ops.add(image, twin.?, image.*.root, node.childCount(image.*.root), "Duplicate") { return 57 }
    if image_module.find(image, twin.?.*.id) == null { return 58 }

    // Mixing the whole image many times leaves the value arena alone.
    const arena = turns.locate()
    const before = turns.used(arena)
    round = 0
    while round < 200 {
        image_module.damageAll(image)
        _ = render.update(image)
        round += 1
    }
    const grown = turns.used(arena) - before
    if grown > 65536 { return 59 }

    image_module.destroy(image)
    return 13
}
