// Brush presets (brush/presets.mlx), the Brush Presets docker
// (dockers/presets.mlx), the brush editor (ui/brusheditor.mlx) and the
// Tool Options docker (dockers/options.mlx).
//
// The presets: every built-in text parses (or names an engine that is not
// in the program), keeps every key it names as written (no typo, nothing
// held to a range: sanitize changes nothing), their names are unique,
// every tag has presets, thumbnails are not blank and are drawn once;
// saving under a built-in's name adds a number, saving under a painter's
// name replaces it, renaming onto another's name and deleting a built-in
// are refused, names nothing is left of are refused, a name of slashes
// is a file of its own, a rename in capitals only keeps the file, a
// second store reads what the first wrote, deleting removes the files.
//
// The docker, played as a person would in a window of 1024 x 768 (and
// 1280 x 800): a click on a preset makes the brush in use equal to it
// (field by field and as a whole), the preset in use is marked; the tag
// chosen with the keys in its list and a typed search narrow the grid;
// the list view; the arrow keys over the docker go from preset to preset;
// the brush saved as a new preset writes its file (in an XDG_DATA_HOME
// made here) and a second App reads it; renaming moves the file; deleting
// removes it; a built-in one cannot be renamed or deleted; the cells fill
// the dock at its narrowest and widest; windows of every size.
//
// The editor: the preview is drawn once and again only when the brush
// changed; the diameter slider and OK change the brush in use, Cancel
// and Escape do not; a point added to the pressure curve of the size
// option survives OK; a sensor added and removed; the pages by the keys;
// Save as Preset under the name typed; German at 1280 x 800, light.
//
// Tool Options: the docker shows the tool in use (its region over all of
// the docker), its options, and follows a change of tool.
//
// Everything drawn where the docker and the editor are is opaque, light
// and dark; frames over the docker and the editor leave the value arena
// and the heap as they were. Pictures: presets.png, presets-list.png,
// presets-light.png, brusheditor.png, brusheditor-german.png,
// brusheditor-light.png, in the current directory and, when NEBULA_SHOTS
// names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const types = @import("../brush/types.mlx")
const curve_module = @import("../brush/curve.mlx")
const engines = @import("../brush/engines.mlx")
const presets = @import("../brush/presets.mlx")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const brushes = @import("../app/brushes.mlx")
const shell_module = @import("../app/shell.mlx")
const docks = @import("../ui/docks.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const brusheditor = @import("../ui/brusheditor.mlx")
const preset_docker = @import("../dockers/presets.mlx")
const options_docker = @import("../dockers/options.mlx")
const tools = @import("../tools/registry.mlx")

const App = state.App
const Settings = types.Settings
const Store = presets.Store

const NOTHING: usize = 18446744073709551615

// ---------------------------------------------------------------------------
// Scripts, pictures, the environment

var buffer: [1024]u8 = undefined
var used: usize = 0
var shotsAt: usize = 0
var shotsLength: usize = 0

fn start() -> void { used = 0 }
fn add(text: []const u8) -> void { used = std.text.append(&buffer, used, 1024, text) }
fn addNumber(value: i32) -> void { used = std.text.appendSigned(&buffer, used, 1024, @intCast(isize, value)) }

fn play(app: *App) -> bool {
    const bytes: [*]const u8 = &buffer
    return script.run(app, bytes[0..used])
}

fn run(app: *App, text: []const u8) -> bool { return script.run(app, text) }

fn click(app: *App, x: i32, y: i32) -> bool {
    start()
    add("click ")
    addNumber(x)
    add(" ")
    addNumber(y)
    add("\n")
    return play(app)
}

fn pointer(app: *App, x: i32, y: i32) -> bool {
    start()
    add("pointer ")
    addNumber(x)
    add(" ")
    addNumber(y)
    add("\n")
    return play(app)
}

fn clickIn(app: *App, area: ui.Rect) -> bool {
    if ui.isEmpty(area) { return false }
    return click(app, area.x + area.width / 2, area.y + area.height / 2)
}

// A click at `part` (0..1000) of the way across `area`, in its middle
// row.
fn clickAcross(app: *App, area: ui.Rect, part: i32) -> bool {
    if ui.isEmpty(area) { return false }
    return click(app, area.x + area.width * part / 1000, area.y + area.height / 2)
}

fn regionOf(app: *App, id: u64) -> ui.Rect { return view.areaOf(state.uiOf(app), id) }

// The frame as a picture here and in the shots' directory.
fn save(app: *App, name: []const u8) -> bool {
    start()
    add("shot ")
    add(name)
    add("\n")
    if !play(app) { return false }
    if shotsLength == 0 || shotsLength > 400 { return true }
    const shots = unsafe { @ptrFromInt([*]const u8, shotsAt) }[0..shotsLength]
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, shots)
    if bytes[length - 1] != '/' { length = std.text.appendByte(bytes, length, 599, '/') }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    const frame = script.frameOf(app).?
    return png.saveFile(bytes, frame.*.pixels, frame.*.width, frame.*.height, frame.*.stride, false, app.*.allocator)
}

// The environment of the Apps and the store here: XDG_DATA_HOME is a
// folder under the current directory.
var environmentText: [4200]u8 = undefined
var environmentList: [2]usize = [2]usize{ 0, 0 }
var folderText: [4200]u8 = undefined
var folderLength: usize = 0

fn makeEnvironment() -> ?[*][*]const u8 {
    var found: ?[*][*]const u8 = null
    var directory: [4096]u8 = undefined
    if std.fs.getWorkingDirectory(&directory, 4096) <= 0 { return found }
    const here = std.text.cString(&directory)
    if here.length == 0 || here.length > 4000 { return found }
    var length = std.text.append(&environmentText, 0, 4200, "XDG_DATA_HOME=")
    length = std.text.append(&environmentText, length, 4200, here)
    length = std.text.append(&environmentText, length, 4200, "/presets-home")
    environmentText[length] = 0
    folderLength = std.text.append(&folderText, 0, 4200, here)
    folderLength = std.text.append(&folderText, folderLength, 4200, "/presets-home/mlx/nebula/brushes")
    folderText[folderLength] = 0
    environmentList[0] = @intFromPtr(&environmentText)
    environmentList[1] = 0
    found = unsafe { @ptrCast([*][*]const u8, &environmentList) }
    return found
}

// Whether the painter's file `stem`.nbrush is in the folder.
var fileText: [4400]u8 = undefined
fn fileThere(stem: []const u8) -> bool {
    var length = std.text.append(&fileText, 0, 4400, folderText[0..folderLength])
    length = std.text.appendByte(&fileText, length, 4400, '/')
    length = std.text.append(&fileText, length, 4400, stem)
    length = std.text.append(&fileText, length, 4400, ".nbrush")
    fileText[length] = 0
    return std.fs.exists(&fileText)
}

fn newApp(allocator: std.allocator.Allocator, environment: [*][*]const u8) -> ?*App {
    const made = script.headless(allocator)
    if made == null { return made }
    shell_module.setEnvironment(made.?.*.shell, environment)
    return made
}

fn sameSettings(a: *const Settings, b: *const Settings) -> bool {
    return unsafe { std.mem.eql(@ptrCast([*]const u8, a), @ptrCast([*]const u8, b), @sizeOf(Settings)) }
}

// Whether two brushes are written as the same preset file (all that
// counts of them is the same; bytes nothing reads may differ).
fn sameText(allocator: std.allocator.Allocator, a: *const Settings, b: *const Settings) -> bool {
    var left = std.ArrayList(u8).init(allocator)
    var right = std.ArrayList(u8).init(allocator)
    const same = types.write(a, &left) && types.write(b, &right) && std.text.same(left.items(), right.items())
    left.deinit()
    right.deinit()
    return same
}

fn copySettings(into: *Settings, from: *const Settings) -> void {
    unsafe { std.mem.copy(@ptrCast([*]u8, into), @ptrCast([*]const u8, from), @sizeOf(Settings)) }
}

fn newSettings(allocator: std.allocator.Allocator) -> ?*Settings {
    var found: ?*Settings = null
    const memory = allocator.alloc(@sizeOf(Settings), 16)
    if memory == null { return found }
    found = unsafe { @ptrCast(*Settings, memory.?) }
    return found
}

// ---------------------------------------------------------------------------
// The texts of the built-in presets

fn isBlank(byte: u8) -> bool { return byte == 32 || byte == 9 }

fn trimmed(text: []const u8) -> []const u8 {
    var start_at: usize = 0
    var end = text.length
    while start_at < end && isBlank(text[start_at]) { start_at += 1 }
    while end > start_at && isBlank(text[end - 1]) { end -= 1 }
    return text[start_at..end]
}

// The value `written` has for `key` (one "key = value" a line); false when
// it has no such line.
fn valueIn(written: []const u8, key: []const u8, into: *[]const u8) -> bool {
    var at: usize = 0
    while at < written.length {
        var end = at
        while end < written.length && written[end] != 10 { end += 1 }
        const line = written[at..end]
        var split: usize = 0
        while split < line.length && line[split] != '=' { split += 1 }
        if split < line.length && std.text.same(trimmed(line[0..split]), key) {
            into.* = trimmed(line[split + 1..])
            return true
        }
        at = end + 1
    }
    return false
}

// The whole of `text` as a number (false: it is none).
fn numberOf(text: []const u8, into: *f64) -> bool {
    var at: usize = 0
    if !curve_module.parseNumber(text, &at, into) { return false }
    return trimmed(text[at..]).length == 0
}

fn sameValue(left: []const u8, right: []const u8) -> bool {
    var a: f64 = 0.0
    var b: f64 = 0.0
    if numberOf(left, &a) && numberOf(right, &b) {
        const off = if a > b { a - b } else { b - a }
        return off < 0.0000005
    }
    return std.text.same(left, right)
}

// Every "key = value" line of `text` is in `written` with that value.
fn keptAsWritten(text: []const u8, written: []const u8) -> bool {
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        at = end + 1
        if line.length == 0 { continue }
        var split: usize = 0
        while split < line.length && line[split] != '=' { split += 1 }
        if split >= line.length { return false }
        var found: []const u8 = ""
        if !valueIn(written, trimmed(line[0..split]), &found) { return false }
        if !sameValue(trimmed(line[split + 1..]), found) { return false }
    }
    return true
}

// The engine a preset's text names is not in the program.
fn namesMissingEngine(text: []const u8) -> bool {
    var key: []const u8 = ""
    if !valueIn(text, "engine", &key) { return false }
    return engines.byKey(key) == null
}

// ---------------------------------------------------------------------------
// Part 1: the presets themselves

fn checkBuiltIns(allocator: std.allocator.Allocator, store: *Store) -> u8 {
    const parsed = newSettings(allocator)
    const held = newSettings(allocator)
    if parsed == null || held == null { return 20 }
    var expected: usize = 0
    var index: usize = 0
    while index < presets.builtInCount() {
        const text = presets.builtInText(index)
        if text.length == 0 { return 21 }
        if !types.parse(text, parsed.?) {
            if !namesMissingEngine(text) { return 22 }
        } else {
            copySettings(held.?, parsed.?)
            types.sanitize(held.?)
            if !sameSettings(held.?, parsed.?) { return 23 }
            var written = std.ArrayList(u8).init(allocator)
            if !types.write(parsed.?, &written) { return 24 }
            const kept = keptAsWritten(text, written.items())
            written.deinit()
            if !kept { return 25 }
            if types.nameOf(parsed.?).length == 0 { return 26 }
            expected += 1
        }
        index += 1
    }
    // The spray stands in for the spray engine's when there is none: of
    // the two that parse then, one is left out.
    const stand_ins: usize = if engines.find(types.ENGINE_SPRAY) != null { 1 } else { 0 }
    if presets.count(store) + stand_ins != expected { return 27 }
    if presets.count(store) < 30 { return 28 }
    // Unique names, tags on each, every built-in tag used, none mine.
    var tag_seen: u8 = 0
    index = 0
    while index < presets.count(store) {
        if presets.isUser(store, index) || presets.tags(store, index) == 0 || presets.tags(store, index) & presets.TAG_MINE != 0 { return 29 }
        tag_seen |= presets.tags(store, index)
        var other = index + 1
        while other < presets.count(store) {
            if std.text.same(presets.name(store, index), presets.name(store, other)) { return 30 }
            other += 1
        }
        if presets.find(store, presets.name(store, index)) == null { return 31 }
        index += 1
    }
    if tag_seen != 127 { return 32 }
    // What a painter expects is there.
    if presets.find(store, "basic round hard") == null || presets.find(store, "Airbrush Soft") == null || presets.find(store, "Pixel 1 px") == null || presets.find(store, "Eraser Soft") == null || presets.find(store, "Leaf Scatter") == null || presets.find(store, "Spray") == null { return 33 }
    const pixel_brush = presets.settingsOf(store, presets.find(store, "Pixel 1 px").?).?
    if pixel_brush.*.size != 1.0 || pixel_brush.*.tip.antialias || !pixel_brush.*.options[types.OPTION_SHARPNESS].on { return 34 }
    return 0
}

fn blankThumb(thumb: [*]const u8) -> bool {
    var at: usize = 0
    var covered: usize = 0
    while at < presets.THUMB_WIDTH * presets.THUMB_HEIGHT {
        if thumb[at] > 32 { covered += 1 }
        at += 1
    }
    // (At least a line's worth of pixels.)
    return covered < 40
}

fn wholePixels(thumb: [*]const u8) -> bool {
    var at: usize = 0
    while at < presets.THUMB_WIDTH * presets.THUMB_HEIGHT {
        if thumb[at] != 0 && thumb[at] != 255 { return false }
        at += 1
    }
    return true
}

fn checkThumbnails(store: *Store) -> u8 {
    const before = presets.drawnCount(store)
    var index: usize = 0
    while index < presets.count(store) {
        const thumb = presets.thumbnail(store, index)
        if thumb == null || blankThumb(thumb.?) { return 40 }
        index += 1
    }
    if presets.drawnCount(store) != before + @intCast(u64, presets.count(store)) { return 41 }
    // Asked again: kept, not drawn again.
    index = 0
    while index < presets.count(store) {
        if presets.thumbnail(store, index) == null { return 42 }
        index += 1
    }
    if presets.drawnCount(store) != before + @intCast(u64, presets.count(store)) { return 43 }
    // The pixel brushes paint whole pixels, none partly.
    if !wholePixels(presets.thumbnail(store, presets.find(store, "Pixel 1 px").?).?) || !wholePixels(presets.thumbnail(store, presets.find(store, "Pixel 3 px").?).?) { return 46 }
    // An eraser's: a faint band with the S taken out of it.
    const eraser = presets.thumbnail(store, presets.find(store, "Eraser Hard").?).?
    const band = eraser[2 * presets.THUMB_WIDTH + 2] == 0 && eraser[8 * presets.THUMB_WIDTH + 2] > 0 && eraser[8 * presets.THUMB_WIDTH + 2] < 128
    if !band { return 44 }
    if presets.thumbnail(store, presets.count(store)) != null { return 45 }
    return 0
}

fn checkNarrowing(store: *Store) -> u8 {
    var pixel_count: usize = 0
    var pen_count: usize = 0
    var index: usize = 0
    while index < presets.count(store) {
        if presets.matches(store, index, presets.TAG_PIXEL, "") {
            pixel_count += 1
            if presets.tags(store, index) & presets.TAG_PIXEL == 0 { return 50 }
        }
        if presets.matches(store, index, 0, " PEN ") {
            pen_count += 1
            const name = presets.name(store, index)
            if !std.text.contains(name, "Pen") && !std.text.contains(name, "pen") { return 51 }
        }
        if !presets.matches(store, index, 0, "") { return 52 }
        index += 1
    }
    if pixel_count < 2 || pixel_count >= presets.count(store) || pen_count < 3 || pen_count >= presets.count(store) { return 53 }
    if presets.matches(store, 0, presets.TAG_INK | presets.TAG_BASIC, "no such brush") { return 54 }
    return 0
}

fn checkFiles(allocator: std.allocator.Allocator, store: *Store, environment: [*][*]const u8) -> u8 {
    const brush = newSettings(allocator)
    if brush == null { return 60 }
    types.defaults(brush.?)
    brush.?.*.size = 33.0
    const before = presets.count(store)
    // Under a built-in's name: a number is added.
    const first = presets.save(store, brush.?, "Ink Pen")
    if first == null || !std.text.same(presets.name(store, first.?), "Ink Pen 2") || !presets.isUser(store, first.?) || presets.count(store) != before + 1 { return 61 }
    if !fileThere("Ink Pen 2") || presets.tags(store, first.?) != presets.TAG_MINE { return 62 }
    // The painter's own after the built-in ones, sorted by name.
    const second = presets.save(store, brush.?, "Aardvark")
    if second == null || second.? != before || presets.find(store, "Ink Pen 2").? != before + 1 { return 63 }
    // The same name again replaces it.
    brush.?.*.size = 44.0
    const again = presets.save(store, brush.?, "  aardvark ")
    if again == null || presets.count(store) != before + 2 || presets.settingsOf(store, presets.find(store, "Aardvark").?).?.*.size != 44.0 { return 64 }
    // Nothing left of a name; a name of slashes becomes a file of its own.
    if presets.save(store, brush.?, "  \n ") != null || presets.count(store) != before + 2 { return 65 }
    const odd = presets.save(store, brush.?, "../a/b")
    if odd == null || !fileThere("_._a_b") { return 66 }
    // Renaming onto another's name, a built-in, deleting a built-in.
    if presets.rename(store, presets.find(store, "Aardvark").?, "ink pen 2") != null { return 67 }
    if presets.rename(store, 0, "Mine now") != null || presets.remove(store, 0) { return 68 }
    const renamed = presets.rename(store, presets.find(store, "Aardvark").?, "Zebra")
    if renamed == null || !std.text.same(presets.name(store, renamed.?), "Zebra") || fileThere("Aardvark") || !fileThere("Zebra") { return 69 }
    // In capitals only: the file stays the same one.
    const capitals = presets.rename(store, renamed.?, "ZEBRA")
    if capitals == null || !std.text.same(presets.name(store, capitals.?), "ZEBRA") || !fileThere("Zebra") || fileThere("ZEBRA") { return 75 }
    // A second store reads what the first wrote.
    const memory = allocator.alloc(@sizeOf(Store), 16)
    if memory == null { return 70 }
    std.mem.zero(memory.?, @sizeOf(Store))
    const other: *Store = unsafe { @ptrCast(*Store, memory.?) }
    if !presets.init(other, allocator, environment) { return 71 }
    const zebra = presets.find(other, "Zebra")
    if zebra == null || !presets.isUser(other, zebra.?) || presets.settingsOf(other, zebra.?).?.*.size != 44.0 || presets.count(other) != presets.count(store) || presets.unreadableCount(other) != 0 { return 72 }
    presets.deinit(other)
    // Deleting each: the files go.
    while presets.count(store) > before {
        if !presets.remove(store, before) { return 73 }
    }
    if fileThere("Zebra") || fileThere("Ink Pen 2") || fileThere("_._a_b") { return 74 }
    return 0
}

fn checkStore(allocator: std.allocator.Allocator, environment: [*][*]const u8) -> u8 {
    const memory = allocator.alloc(@sizeOf(Store), 16)
    if memory == null { return 10 }
    std.mem.zero(memory.?, @sizeOf(Store))
    const store: *Store = unsafe { @ptrCast(*Store, memory.?) }
    if !presets.init(store, allocator, environment) { return 11 }
    if presets.folder(store).length == 0 || presets.count(store) >= presets.builtInCount() || presets.drawnCount(store) != 0 { return 12 }
    var result = checkBuiltIns(allocator, store)
    if result != 0 { return result }
    result = checkThumbnails(store)
    if result != 0 { return result }
    result = checkNarrowing(store)
    if result != 0 { return result }
    result = checkFiles(allocator, store, environment)
    if result != 0 { return result }
    presets.deinit(store)
    if presets.count(store) != 0 { return 13 }
    return 0
}

// ---------------------------------------------------------------------------
// Part 2: the docker

fn storeOf(app: *App) -> *Store { return preset_docker.storeOf(app).? }

// Every pixel of `area` in the last frame is opaque.
fn allOpaque(app: *App, area: ui.Rect) -> bool {
    const frame = script.frameOf(app).?
    if ui.isEmpty(area) || area.x < 0 || area.y < 0 || @intCast(usize, ui.right(area)) > frame.*.width || @intCast(usize, ui.bottom(area)) > frame.*.height { return false }
    var row = area.y
    while row < ui.bottom(area) {
        var column = area.x
        while column < ui.right(area) {
            if frame.*.pixels[@intCast(usize, row) * frame.*.stride + @intCast(usize, column)] >> 24 != 255 { return false }
            column += 1
        }
        row += 1
    }
    return true
}

// Frames one after another as a window's loop draws them: after the first
// few each takes what the one before took of the value arena, and the
// heap holds what it held.
fn steady(app: *App) -> bool {
    const canvas = script.frameOf(app).?
    var loop_turns: turns.Turns = undefined
    turns.begin(&loop_turns, true, false)
    const arena = loop_turns.base
    const mark = turns.used(arena)
    var first: usize = 0
    var live: usize = 0
    var round: usize = 0
    while round < 60 {
        turns.turn(&loop_turns)
        app.*.shell.*.clock += 16
        api.redraw(app)
        loop.frame(app, canvas)
        const now = turns.used(arena) - mark
        if round == 4 {
            first = now
            live = std.heap.liveBytes()
        }
        if round > 4 && (now != first || now > 1048576 || std.heap.liveBytes() != live) { return false }
        round += 1
    }
    turns.turn(&loop_turns)
    return turns.used(arena) == mark
}

fn insideOf(part: ui.Rect, whole: ui.Rect) -> bool {
    return !ui.isEmpty(part) && part.x >= whole.x && part.y >= whole.y && ui.right(part) <= ui.right(whole) && ui.bottom(part) <= ui.bottom(whole)
}

// Windows of every size down to the least a script makes: nothing traps,
// with the docker and with the editor open.
fn everySize(app: *App) -> bool {
    return run(app, "size 800 600\nsize 640 480\nsize 320 240\nsize 64 64\nsize 200 900\nsize 1024 768\n")
}

fn checkDocker(app: *App, environment: [*][*]const u8, allocator: std.allocator.Allocator) -> u8 {
    if !run(app, "size 1024 768\nnew 640 480 FFFFFF\n") { return 80 }
    // The presets' tab in front.
    if !clickIn(app, docks.tabOf(app, preset_docker.ID)) { return 81 }
    const store = storeOf(app)
    const content = docks.contentOf(app, preset_docker.ID)
    if ui.isEmpty(content) || preset_docker.shownCount(app) != presets.count(store) { return 82 }
    const first_cell = preset_docker.cellArea(app, 0)
    if ui.isEmpty(first_cell) || first_cell.x < content.x || ui.right(first_cell) > ui.right(content) { return 83 }

    // A click on a preset: it is the brush in use, field by field.
    const ink = presets.find(store, "Ink Pen").?
    preset_docker.setFilter(app, 0, "Ink Pen", false)
    if !run(app, "wait 20\n") || preset_docker.shownCount(app) != 1 || preset_docker.shownAt(app, 0) != ink { return 84 }
    if !clickIn(app, preset_docker.cellArea(app, 0)) { return 85 }
    const brush = brushes.current(app)
    const chosen = presets.settingsOf(store, ink).?
    if brush.*.size != chosen.*.size || brush.*.opacity != chosen.*.opacity || brush.*.flow != chosen.*.flow || brush.*.tip.kind != chosen.*.tip.kind || brush.*.tip.spacing != chosen.*.tip.spacing || brush.*.tip.horizontalFade != chosen.*.tip.horizontalFade || brush.*.engine != chosen.*.engine { return 86 }
    if brush.*.options[types.OPTION_SIZE].sensors[0].curve.count != 3 || !sameSettings(brush, chosen) { return 87 }
    if !run(app, "wait 20\n") || preset_docker.markedPlace(app) != 0 { return 79 }
    // A textured one: its tip too.
    const chalk = presets.find(store, "Chalk").?
    preset_docker.setFilter(app, 0, "chalk", false)
    if !run(app, "wait 20\n") || !clickIn(app, preset_docker.cellArea(app, 0)) { return 88 }
    if brush.*.tip.kind != types.TIP_PREDEFINED || brush.*.tip.predefined != presets.settingsOf(store, chalk).?.*.tip.predefined || !sameSettings(brush, presets.settingsOf(store, chalk).?) { return 89 }

    // The tag chosen with the keys in its list: the Pixel presets only.
    preset_docker.setFilter(app, 0, "", false)
    if !run(app, "wait 20\n") || !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_TAG))) { return 90 }
    if !run(app, "key Down\nkey Down\nkey Down\nkey Down\nkey Down\nkey Down\nkey Down\nkey Enter\nwait 20\n") { return 91 }
    const pixel_shown = preset_docker.shownCount(app)
    if pixel_shown < 2 || pixel_shown >= presets.count(store) { return 92 }
    var place: usize = 0
    while place < pixel_shown {
        if presets.tags(store, preset_docker.shownAt(app, place)) & presets.TAG_PIXEL == 0 { return 93 }
        place += 1
    }
    // Back to all, and a search typed: the names with "pen".
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_TAG))) || !run(app, "key Home\nkey Enter\nwait 20\n") || preset_docker.shownCount(app) != presets.count(store) { return 94 }
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_SEARCH))) || !run(app, "type PEN\nkey Enter\nwait 20\n") { return 95 }
    const pen_shown = preset_docker.shownCount(app)
    if pen_shown < 3 || pen_shown >= presets.count(store) { return 96 }
    place = 0
    while place < pen_shown {
        const name = presets.name(store, preset_docker.shownAt(app, place))
        if !std.text.contains(name, "Pen") && !std.text.contains(name, "pen") { return 97 }
        place += 1
    }
    // The arrow keys over the docker go to the next preset shown.
    const shown_first = preset_docker.shownAt(app, 0)
    if !clickIn(app, preset_docker.cellArea(app, 0)) || !std.text.same(types.nameOf(brush), presets.name(store, shown_first)) { return 98 }
    if !run(app, "key Right\nwait 20\n") || !std.text.same(types.nameOf(brush), presets.name(store, preset_docker.shownAt(app, 1))) { return 99 }
    if !run(app, "key Left\nkey Left\nwait 20\n") || !std.text.same(types.nameOf(brush), presets.name(store, shown_first)) { return 100 }

    // The list view.
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_VIEW))) { return 101 }
    preset_docker.setFilter(app, 0, "", true)
    if !run(app, "wait 20\n") || ui.isEmpty(regionOf(app, preset_docker.idOf(preset_docker.PART_ROW + 1))) { return 102 }
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_ROW + 1))) || !std.text.same(types.nameOf(brush), presets.name(store, 1)) { return 103 }
    if !pointer(app, content.x + 60, content.y + 80) || !save(app, "presets-list.png") { return 104 }
    preset_docker.setFilter(app, 0, "", false)
    if !run(app, "wait 20\n") { return 105 }

    // The brush saved as a new preset: its file, the brush named so and
    // marked.
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_NEW))) || !api.dialogOpen(app) { return 106 }
    if !run(app, "type My Ink\nkey Enter\nwait 20\n") || api.dialogOpen(app) { return 107 }
    if !fileThere("My Ink") || !std.text.same(types.nameOf(brush), "My Ink") { return 108 }
    const mine = presets.find(store, "My Ink")
    if mine == null || !presets.isUser(store, mine.?) || !sameSettings(presets.settingsOf(store, mine.?).?, brush) { return 109 }
    if ui.isEmpty(preset_docker.cellArea(app, mine.?)) || preset_docker.markedPlace(app) != mine.? { return 110 }
    // A second App reads it at its start.
    const second = newApp(allocator, environment)
    if second == null { return 111 }
    const other = preset_docker.storeOf(second.?)
    if other == null { return 112 }
    const there = presets.find(other.?, "My Ink")
    if there == null || !presets.isUser(other.?, there.?) || !sameText(allocator, presets.settingsOf(other.?, there.?).?, brush) { return 113 }

    // Renamed: the file moves, the brush in use follows.
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_RENAME))) || !api.dialogOpen(app) { return 114 }
    if !run(app, "type Wet Ink\nkey Enter\nwait 20\n") || api.dialogOpen(app) { return 115 }
    if fileThere("My Ink") || !fileThere("Wet Ink") || !std.text.same(types.nameOf(brush), "Wet Ink") || presets.find(store, "Wet Ink") == null { return 116 }
    // Deleted (asked first): the file goes.
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_DELETE))) || !api.dialogOpen(app) { return 117 }
    if !run(app, "key Enter\nwait 20\n") || api.dialogOpen(app) { return 118 }
    if fileThere("Wet Ink") || presets.find(store, "Wet Ink") != null || presets.count(store) != presets.count(other.?) - 1 { return 119 }
    // A built-in one cannot be renamed or deleted: the buttons take no
    // click.
    preset_docker.setFilter(app, 0, "", false)
    if !run(app, "wait 20\n") || !clickIn(app, preset_docker.cellArea(app, 0)) || !ui.isEmpty(regionOf(app, preset_docker.idOf(preset_docker.PART_DELETE))) || !ui.isEmpty(regionOf(app, preset_docker.idOf(preset_docker.PART_RENAME))) { return 120 }

    // The dock at its narrowest and its widest: the cells fill its width,
    // one column at least, more when there is room.
    docks.setAreaWidth(app, docks.AREA_RIGHT, docks.SMALLEST_WIDTH)
    if !run(app, "wait 20\n") || !insideOf(preset_docker.cellArea(app, 0), docks.contentOf(app, preset_docker.ID)) { return 126 }
    const narrow_width = preset_docker.cellArea(app, 0).width
    docks.setAreaWidth(app, docks.AREA_RIGHT, docks.LARGEST_WIDTH)
    if !run(app, "wait 20\n") || !insideOf(preset_docker.cellArea(app, 0), docks.contentOf(app, preset_docker.ID)) || ui.isEmpty(preset_docker.cellArea(app, 5)) { return 127 }
    if preset_docker.cellArea(app, 5).y != preset_docker.cellArea(app, 0).y || narrow_width < preset_docker.LEAST_CELL_WIDTH { return 128 }
    docks.setAreaWidth(app, docks.AREA_RIGHT, docks.DEFAULT_WIDTH)
    // Thumbnails are drawn once: frames over the docker draw none again.
    const drawn = presets.drawnCount(store)
    api.redraw(app)
    if !run(app, "wait 50\n") || presets.drawnCount(store) != drawn { return 121 }
    if !allOpaque(app, content) { return 122 }
    if !pointer(app, first_cell.x + first_cell.width / 2, first_cell.y + first_cell.height / 2) || !save(app, "presets.png") { return 123 }
    if !steady(app) { return 124 }
    if !everySize(app) { return 129 }
    // Light.
    app.*.shell.*.lightness = 1024
    if !save(app, "presets-light.png") || !allOpaque(app, content) { return 125 }
    app.*.shell.*.lightness = 0
    return 0
}

// ---------------------------------------------------------------------------
// Part 3: the editor

fn openEditor(app: *App) -> bool {
    if !clickIn(app, regionOf(app, preset_docker.idOf(preset_docker.PART_EDIT))) { return false }
    return brusheditor.isOpen(app) && run(app, "wait 20\n")
}

fn button(app: *App, which: usize) -> bool {
    return clickIn(app, regionOf(app, dialogs.partId(app, dialogs.PART_BUTTON + which)))
}

fn checkEditor(app: *App, allocator: std.allocator.Allocator) -> u8 {
    const store = storeOf(app)
    const brush = brushes.current(app)
    brushes.use(app, presets.settingsOf(store, presets.find(store, "Basic Round Hard").?).?)
    const kept = newSettings(allocator)
    if kept == null { return 130 }
    copySettings(kept.?, brush)
    // Open: the preview drawn once, not again while nothing changes.
    if !openEditor(app) || brusheditor.previewRenders(app) != 1 { return 131 }
    if !run(app, "wait 100\npointer 300 300\nwait 100\n") || brusheditor.previewRenders(app) != 1 { return 132 }
    const edited = brusheditor.edited(app).?
    if !sameSettings(edited, brush) { return 133 }
    // The diameter dragged: the copy changes, the preview with it, the
    // brush in use not yet.
    const diameter = regionOf(app, brusheditor.idOf(brusheditor.PART_DIAMETER))
    if !clickAcross(app, diameter, 700) || !run(app, "wait 20\n") { return 134 }
    const size = edited.*.size
    if size == kept.?.*.size || size < 30.0 || brusheditor.previewRenders(app) != 2 || brush.*.size != kept.?.*.size { return 135 }
    // OK: it is the brush in use.
    if !button(app, brusheditor.BUTTON_OK) || brusheditor.isOpen(app) || brush.*.size != size { return 136 }
    // Changed and cancelled: the brush stays.
    copySettings(kept.?, brush)
    if !openEditor(app) || !clickAcross(app, regionOf(app, brusheditor.idOf(brusheditor.PART_DIAMETER)), 200) { return 137 }
    if brusheditor.edited(app).?.*.size == kept.?.*.size { return 138 }
    if !button(app, brusheditor.BUTTON_CANCEL) || brusheditor.isOpen(app) || !sameSettings(brush, kept.?) { return 139 }
    // And by Escape.
    if !openEditor(app) || !clickAcross(app, regionOf(app, brusheditor.idOf(brusheditor.PART_RATIO)), 300) || brusheditor.edited(app).?.*.tip.ratio == kept.?.*.tip.ratio { return 140 }
    if !run(app, "key Escape\nwait 20\n") || brusheditor.isOpen(app) || !sameSettings(brush, kept.?) { return 141 }

    // A point added to the pressure curve of the size: it is the brush's
    // after OK.
    if !openEditor(app) { return 142 }
    const size_page = brusheditor.PAGE_OPTION + types.OPTION_SIZE
    if !clickIn(app, regionOf(app, brusheditor.idOf(brusheditor.PART_PAGE + size_page))) || brusheditor.page(app) != size_page { return 143 }
    const curve_area = regionOf(app, brusheditor.idOf(brusheditor.PART_CURVE))
    if ui.isEmpty(curve_area) || !clickIn(app, curve_area) { return 144 }
    const curve = &brusheditor.edited(app).?.*.options[types.OPTION_SIZE].sensors[0].curve
    if curve.*.count != 3 || curve.*.x[1] < 0.45 || curve.*.x[1] > 0.55 || curve.*.y[1] < 0.45 || curve.*.y[1] > 0.55 { return 145 }
    // A sensor added (the first kind not used: pressure in) and removed.
    if !clickIn(app, regionOf(app, brusheditor.idOf(brusheditor.PART_ADD_SENSOR))) { return 146 }
    const option = &brusheditor.edited(app).?.*.options[types.OPTION_SIZE]
    if option.*.count != 2 || option.*.sensors[1].kind != types.SENSOR_PRESSURE_IN { return 147 }
    if !save(app, "brusheditor.png") { return 148 }
    if !allOpaque(app, dialogs.frameArea(app)) { return 149 }
    if !clickIn(app, regionOf(app, brusheditor.idOf(brusheditor.PART_REMOVE + 1))) || option.*.count != 1 || option.*.sensors[0].curve.count != 3 { return 150 }
    // The pages by the keys.
    if !run(app, "key Down\nwait 20\n") || brusheditor.page(app) != size_page + 1 { return 151 }
    if !run(app, "key Up\nkey Up\nwait 20\n") || brusheditor.page(app) != size_page - 1 { return 152 }
    if !steady(app) { return 153 }
    if !everySize(app) || !brusheditor.isOpen(app) { return 161 }
    // Saved as a preset under the name typed at the top: the dialog stays.
    if !clickIn(app, regionOf(app, brusheditor.idOf(brusheditor.PART_NAME))) || !run(app, "type Soft Size\nkey Enter\nwait 20\n") { return 158 }
    if !button(app, brusheditor.BUTTON_SAVE) || !brusheditor.isOpen(app) || !fileThere("Soft Size") { return 159 }
    const saved = presets.find(store, "Soft Size")
    if saved == null || presets.settingsOf(store, saved.?).?.*.options[types.OPTION_SIZE].sensors[0].curve.count != 3 { return 160 }
    if !button(app, brusheditor.BUTTON_OK) || brusheditor.isOpen(app) { return 154 }
    if brush.*.options[types.OPTION_SIZE].sensors[0].curve.count != 3 || brush.*.options[types.OPTION_SIZE].count != 1 || !std.text.same(types.nameOf(brush), "Soft Size") { return 155 }
    // In German, at 1280 x 800, on the tip's page.
    if !run(app, "german\nsize 1280 800\n") || !openEditor(app) || !save(app, "brusheditor-german.png") { return 156 }
    // Light: opaque too.
    app.*.shell.*.lightness = 1024
    if !clickIn(app, regionOf(app, brusheditor.idOf(brusheditor.PART_PAGE + brusheditor.PAGE_GENERAL))) || !save(app, "brusheditor-light.png") || !allOpaque(app, dialogs.frameArea(app)) { return 162 }
    app.*.shell.*.lightness = 0
    if !button(app, brusheditor.BUTTON_CANCEL) || brusheditor.isOpen(app) { return 157 }
    return 0
}

// ---------------------------------------------------------------------------
// Part 4: the Tool Options docker

fn checkOptions(app: *App) -> u8 {
    if !clickIn(app, docks.tabOf(app, options_docker.ID)) || !run(app, "wait 20\n") { return 170 }
    const content = docks.contentOf(app, options_docker.ID)
    if ui.isEmpty(content) || options_docker.shownTool(app) != app.*.tool { return 171 }
    // Its region lies over all of the docker.
    const frame = regionOf(app, options_docker.frameId())
    if frame.x != content.x || frame.y != content.y || frame.width != content.width || frame.height != content.height { return 172 }
    const tool = api.tool(app).?
    const area = options_docker.optionsArea(app)
    if tool.*.options != null && (ui.isEmpty(area) || area.y <= content.y || ui.bottom(area) > ui.bottom(content)) { return 173 }
    if tool.*.options == null && !ui.isEmpty(area) { return 174 }
    if !allOpaque(app, content) { return 175 }
    // Another tool: the docker follows.
    var index: usize = 0
    while index < tools.count() {
        const other = tools.at(index).?
        if other.*.id != app.*.tool {
            api.setTool(app, other.*.id)
            if !run(app, "wait 20\n") || options_docker.shownTool(app) != other.*.id { return 176 }
            break
        }
        index += 1
    }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null {
        const shots = std.string.asSlice(named.?)
        shotsAt = @intFromPtr(shots.pointer)
        shotsLength = shots.length
    }
    const environment = makeEnvironment()
    if environment == null { return 2 }
    // (A folder a run by hand left.)
    _ = std.fs.removeTree(&folderText)
    var result = checkStore(allocator, environment.?)
    if result != 0 { return result }
    const made = newApp(allocator, environment.?)
    if made == null { return 3 }
    const app = made.?
    result = checkDocker(app, environment.?, allocator)
    if result != 0 { return result }
    result = checkEditor(app, allocator)
    if result != 0 { return result }
    result = checkOptions(app)
    if result != 0 { return result }
    return 13
}
