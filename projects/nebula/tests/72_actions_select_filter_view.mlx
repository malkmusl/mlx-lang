// The Select, Filter, View, Settings, Tools and Help menus' actions,
// played by scripts on an App with no window (app/script.mlx) whose
// settings live in nebula-72 under the current directory. Checked: Select
// All, Deselect, Reselect and Invert by their keys and actions, each one
// step of the history, Display Selection's flag; Grow, Shrink, Feather
// and Border by their dialogs (Enter takes the number offered, digits
// typed replace it, Backspace, Up, Escape changes nothing), the exact new
// edges; Smooth; Select Opaque and its Subtract; Select from Colour
// Range: the red patch by the foreground, the blue one by a click in the
// dialog's picture. The Filter menu: each group's entries are the
// registry's filters of that group (all of them, "…" after those with a
// form, German names); Invert through the menu bar's Filter > Adjust is
// applied at once as one step and leaves transparent pixels 0; Gaussian
// Blur's form shows a preview through the layer's substitute (the image
// changes, the layer does not), OK applies it as one step "Gaussian Blur",
// Cancel leaves no trace; a blur of a layer across tile borders equals the
// whole layer blurred in one piece; numbers typed into the form are the
// ones Ctrl+F applies again, Ctrl+Alt+F asks them again; a layer of more
// than two million pixels is filtered over frames under a progress dialog,
// and Escape there puts it back. The View menu: zoom in and out, 100 %,
// fit, turned left, right and back, mirrored, grid, rulers, guides, pixel
// grid, wrap around, canvas only, full screen (their keys and their
// checks), the dockers' list toggling each docker, all shown and hidden.
// The Tools menu lists every tool by group and chooses it. The
// preferences: undo steps typed and saved, read by a second App; a new
// shortcut recorded for Select All that then selects, a conflict with
// Invert Selection named and taken over at the second press, all reset;
// the language switched to German and back; the light theme. Help: the
// list of shortcuts and its way to the preferences, About. The value
// arena does not grow over repeated filters and selection changes.
// Pictures filter-dialog.png, color-range.png, preferences.png,
// preferences-shortcuts.png, preferences-light.png, shortcuts.png go to
// the current directory and, when NEBULA_SHOTS names a directory, there
// too. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const script = @import("../app/script.mlx")
const shell_module = @import("../app/shell.mlx")
const settings = @import("../app/settings.mlx")
const shortcuts = @import("../app/shortcuts.mlx")
const documents = @import("../app/documents.mlx")
const menus = @import("../ui/menus.mlx")
const docks = @import("../ui/docks.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const kit_module = @import("../ui/kit.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const filterdialog = @import("../ui/filterdialog.mlx")
const filter_actions = @import("../actions/filter.mlx")
const loop = @import("../app/loop.mlx")
const preferences = @import("../ui/preferences.mlx")
const dockers = @import("../dockers/registry.mlx")
const actions = @import("../actions/registry.mlx")
const tools = @import("../tools/registry.mlx")
const filters = @import("../filters/registry.mlx")
const types = @import("../filters/types.mlx")
const blur = @import("../filters/blur.mlx")
const adjust = @import("../filters/adjust.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const mask = @import("../core/mask.mlx")
const selection = @import("../core/selection.mlx")
const render = @import("../core/render.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")

const App = state.App

// The current directory, the settings' folder, the environment.
var cwd: [4096]u8 = undefined
var cwdLength: usize = 0
var envText: [4096]u8 = undefined
var envList: [4]usize = undefined
var shotsAt: [512]u8 = undefined
var shotsLength: usize = 0
// Numbers for a filter of the test's own (as the dialog's).
var params: node_module.Params = undefined

fn run(app: *App, text: []const u8) -> bool { return script.run(app, text) }

// A picture of the window as it is now, here and in NEBULA_SHOTS.
fn picture(app: *App, name: []const u8) -> bool {
    var line: [700]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 700, "shot ")
    length = std.text.append(bytes, length, 700, name)
    length = std.text.append(bytes, length, 700, "\n")
    if !run(app, bytes[0..length]) { return false }
    if shotsLength == 0 { return true }
    const shots: [*]const u8 = &shotsAt
    length = std.text.append(bytes, 0, 700, "shot ")
    length = std.text.append(bytes, length, 700, shots[0..shotsLength])
    if shotsAt[shotsLength - 1] != 47 { length = std.text.append(bytes, length, 700, "/") }
    length = std.text.append(bytes, length, 700, name)
    length = std.text.append(bytes, length, 700, "\n")
    return run(app, bytes[0..length])
}

fn step2(app: *App, command: []const u8, x: i32, y: i32) -> bool {
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, command)
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, x))
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, y))
    length = std.text.append(bytes, length, 96, "\n")
    return run(app, bytes[0..length])
}

// A click in the middle of `area` (false for an empty one).
fn clickIn(app: *App, area: ui.Rect) -> bool {
    if area.width <= 0 || area.height <= 0 { return false }
    return step2(app, "click", area.x + area.width / 2, area.y + area.height / 2)
}

fn imageOf(app: *App) -> *image_module.Image { return api.image(app).? }

fn steps(app: *App) -> usize { return history.stepsDone(imageOf(app).*.history) }

fn lastStep(app: *App, name: []const u8) -> bool { return std.text.same(history.undoName(imageOf(app).*.history), name) }

// The amount selected at (x, y) (0 when there is no selection).
fn picked(app: *App, x: i32, y: i32) -> u32 {
    const image = imageOf(app)
    if !image.*.selected { return 0 }
    return mask.at(image.*.selection, x, y)
}

// What the image shows at (x, y).
fn shown(app: *App, x: i32, y: i32) -> u32 {
    const image = imageOf(app)
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

fn layerOf(app: *App) -> *node_module.Node { return api.activeNode(app).? }

// A sum of every pixel of `area` of a device, in order.
fn checksum(target: *device.Device, area: geom.Rect) -> u64 {
    var sum: u64 = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            sum = sum *% 31 +% @intCast(u64, device.pixel(target, x, y))
            x += 1
        }
        y += 1
    }
    return sum
}

fn actionOf(key: []const u8) -> *const state.Action { return actions.byKey(key).? }

fn checked(app: *App, key: []const u8) -> bool {
    const action = actionOf(key)
    return action.*.checked != null && action.*.checked.?(app)
}

fn sameShortcut(left: keys.Shortcut, right: keys.Shortcut) -> bool {
    return left.modifiers == right.modifiers && left.character == right.character && left.code == right.code
}

fn hasShortcut(app: *App, key: []const u8, text: []const u8) -> bool {
    return sameShortcut(shortcuts.ofAction(app, actionOf(key)), keys.parse(text))
}

// The menu source of `menu` whose submenu is `submenu` (null: none).
fn sourceOf(menu: u8, submenu: []const u8) -> ?*const state.MenuSource {
    var index: usize = 0
    while index < actions.sourceCount() {
        const source = actions.sourceAt(index)
        if source != null && source.?.*.menu == menu && std.text.same(source.?.*.submenu, submenu) { return source }
        index += 1
    }
    return null
}

// The row of the open list `at` named `name` (NO_ROW: none).
fn rowNamed(app: *App, at: usize, name: []const u8) -> usize {
    var index: usize = 0
    while index < menus.rowCount(app, at) {
        if std.text.same(menus.rowName(app, at, index), name) { return index }
        index += 1
    }
    return menus.NO_ROW
}

fn environment() -> [*][*]const u8 {
    const bytes: [*]u8 = &envText
    const current: [*]const u8 = &cwd
    envList[0] = @intFromPtr(bytes)
    var length = std.text.append(bytes, 0, 4095, "XDG_CONFIG_HOME=")
    length = std.text.append(bytes, length, 4095, current[0..cwdLength])
    length = std.text.append(bytes, length, 4095, "/nebula-72/config")
    length = std.text.appendByte(bytes, length, 4095, 0)
    envList[1] = @intFromPtr(bytes + length)
    length = std.text.append(bytes, length, 4095, "HOME=")
    length = std.text.append(bytes, length, 4095, current[0..cwdLength])
    length = std.text.append(bytes, length, 4095, "/nebula-72/home")
    length = std.text.appendByte(bytes, length, 4095, 0)
    envList[2] = 0
    unsafe { return @ptrCast([*][*]const u8, &envList) }
}

fn fresh(allocator: std.allocator.Allocator) -> ?*App {
    const made = script.headless(allocator)
    if made == null { return null }
    shell_module.setEnvironment(made.?.*.shell, environment())
    return made
}

// ---------------------------------------------------------------------------
// Select All, Deselect, Reselect, Invert, Display Selection

fn basics(app: *App) -> u8 {
    const image = imageOf(app)
    var base = steps(app)
    if !run(app, "action select_all\n") || !image.*.selected { return 10 }
    if picked(app, 0, 0) != 255 || picked(app, 255, 191) != 255 || mask.at(image.*.selection, 256, 10) != 0 || mask.at(image.*.selection, -1, 0) != 0 { return 11 }
    if steps(app) != base + 1 || !lastStep(app, "Select All") { return 12 }
    if !run(app, "key Ctrl+Shift+A\n") || image.*.selected || steps(app) != base + 2 || !lastStep(app, "Deselect") { return 13 }
    // Deselect with nothing selected cannot run.
    if run(app, "action select_none\n") || steps(app) != base + 2 { return 14 }
    if !api.actionEnabled(app, actionOf("select_reselect")) { return 15 }
    if !run(app, "key Ctrl+Shift+D\n") || !image.*.selected || picked(app, 100, 100) != 255 || picked(app, 255, 0) != 255 || steps(app) != base + 3 || !lastStep(app, "Reselect") { return 16 }
    // A rectangle of the test's own, then inverted by its key and back.
    ops.beginSelection(image)
    if !selection.fromRect(image.*.selection, geom.rect(40, 40, 20, 20), selection.REPLACE, 0.0) { return 17 }
    ops.endSelection(image, true, "Rectangle")
    base = steps(app)
    if !run(app, "key Ctrl+I\n") || picked(app, 50, 50) != 0 || picked(app, 10, 10) != 255 || picked(app, 255, 191) != 255 || picked(app, 39, 50) != 255 { return 18 }
    if steps(app) != base + 1 || !lastStep(app, "Invert Selection") { return 19 }
    if !run(app, "action select_invert\n") || picked(app, 50, 50) != 255 || picked(app, 10, 10) != 0 || picked(app, 59, 59) != 255 || picked(app, 60, 59) != 0 || steps(app) != base + 2 { return 20 }
    // Undo takes the inversion back.
    if !run(app, "key Ctrl+Z\n") || picked(app, 50, 50) != 0 || !run(app, "key Ctrl+Shift+Z\n") || picked(app, 50, 50) != 255 { return 21 }
    // Display Selection: the document's flag and the entry's check.
    const doc = api.document(app).?
    if !doc.*.showSelection || !checked(app, "select_display") { return 22 }
    if !run(app, "key Ctrl+H\n") || doc.*.showSelection || checked(app, "select_display") { return 23 }
    if !run(app, "action select_display\n") || !doc.*.showSelection { return 24 }
    // Reselect belongs to the image it was taken from.
    if !run(app, "new 64 64\n") || api.actionEnabled(app, actionOf("select_reselect")) { return 25 }
    canvasview.forget(app, api.document(app).?)
    documents.close(app, app.*.current)
    if api.image(app).?.*.width != 256 || !api.actionEnabled(app, actionOf("select_reselect")) { return 26 }
    return 0
}

// ---------------------------------------------------------------------------
// Grow, Shrink, Feather, Border, Smooth by their dialogs

fn outline(app: *App) -> u8 {
    const image = imageOf(app)
    // The rectangle 40..59 is selected (basics left it so).
    var base = steps(app)
    if !run(app, "action select_grow\n") || app.*.dialogCount != 1 { return 30 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 { return 31 }
    if picked(app, 36, 50) != 255 || picked(app, 35, 50) != 0 || picked(app, 50, 36) != 255 || picked(app, 50, 35) != 0 || picked(app, 63, 50) != 255 || picked(app, 64, 50) != 0 { return 32 }
    if steps(app) != base + 1 || !lastStep(app, "Grow Selection") { return 33 }
    // A digit typed replaces the number offered.
    if !run(app, "action select_shrink\ntype 3\nkey Enter\n") || app.*.dialogCount != 0 { return 34 }
    if picked(app, 39, 50) != 255 || picked(app, 38, 50) != 0 || picked(app, 60, 50) != 255 || picked(app, 61, 50) != 0 || steps(app) != base + 2 { return 35 }
    // Two digits; then a third taken back with Backspace.
    if !run(app, "action select_grow\ntype 10\nkey Enter\n") || picked(app, 29, 50) != 255 || picked(app, 28, 50) != 0 { return 36 }
    if !run(app, "action select_shrink\ntype 105\nkey Backspace\nkey Enter\n") || picked(app, 39, 50) != 255 || picked(app, 38, 50) != 0 { return 37 }
    // Up steps the number offered (Grow's last: 10).
    if !run(app, "action select_grow\nkey Up\nkey Enter\n") || picked(app, 28, 50) != 255 || picked(app, 27, 50) != 0 { return 38 }
    // Escape changes nothing.
    base = steps(app)
    if !run(app, "action select_grow\nkey Escape\n") || app.*.dialogCount != 0 || steps(app) != base || picked(app, 27, 50) != 0 { return 39 }
    // Cancel by its button.
    if !run(app, "action select_border\n") { return 40 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_BUTTON + 1))) || app.*.dialogCount != 0 || steps(app) != base { return 41 }
    // Feather: the edge becomes soft, the middle stays.
    if !run(app, "action select_feather\nkey Enter\n") || steps(app) != base + 1 || !lastStep(app, "Feather Selection") { return 42 }
    const soft = picked(app, 28, 50)
    if soft == 0 || soft == 255 || picked(app, 50, 50) != 255 || picked(app, 10, 50) != 0 { return 43 }
    // Border: a band of 2 to each side of the outline, nothing in the
    // middle.
    if !run(app, "action select_border\ntype 2\nkey Enter\n") || steps(app) != base + 2 { return 44 }
    if picked(app, 27, 50) != 255 || picked(app, 50, 50) != 0 || picked(app, 20, 50) != 0 { return 45 }
    if !run(app, "action select_smooth\n") || steps(app) != base + 3 || !image.*.selected { return 46 }
    // Shrink from the image's edge: all of it shrinks from every side.
    if !run(app, "action select_all\naction select_shrink\n") { return 47 }
    const box = view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_FIELD + 1))
    if !clickIn(app, box) || !run(app, "type 5\nkey Enter\n") || picked(app, 4, 50) != 0 || picked(app, 5, 50) != 255 || picked(app, 250, 50) != 255 || picked(app, 251, 50) != 0 { return 48 }
    // Without it a selection at the edge stays there.
    if !run(app, "action select_all\naction select_shrink\n") || !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_FIELD + 1))) || !run(app, "type 5\nkey Enter\n") || picked(app, 0, 50) != 255 { return 49 }
    return 0
}

// ---------------------------------------------------------------------------
// Select Opaque, Select from Colour Range

fn byColor(app: *App) -> u8 {
    const image = imageOf(app)
    const layer = layerOf(app)
    // A red and a blue patch on the empty layer (set up, not a step).
    if !device.fill(layer.*.device.?, geom.rect(100, 100, 30, 30), 0xFFFF0000) || !device.fill(layer.*.device.?, geom.rect(10, 120, 20, 20), 0xFF0000FF) { return 50 }
    image_module.damageAll(image)
    var base = steps(app)
    if !run(app, "action select_opaque\n") || picked(app, 110, 110) != 255 || picked(app, 15, 125) != 255 || picked(app, 90, 90) != 0 || picked(app, 50, 50) != 0 { return 51 }
    if steps(app) != base + 1 { return 52 }
    if !run(app, "action select_opaque_subtract\n") || image.*.selected || steps(app) != base + 2 { return 53 }
    // The foreground's red: the red patch, not the blue one.
    if !run(app, "color FF0000\naction select_color_range\n") || app.*.dialogCount != 1 { return 54 }
    if !picture(app, "color-range.png") { return 55 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 || !image.*.selected { return 56 }
    if picked(app, 110, 110) != 255 || picked(app, 129, 129) != 255 || picked(app, 15, 125) != 0 || picked(app, 50, 50) != 0 || picked(app, 130, 110) != 0 { return 57 }
    if steps(app) != base + 3 || !lastStep(app, "Select from Colour Range") { return 58 }
    // A click on the blue patch in the dialog's picture (256 x 192
    // fitted into 452 x 200: 267 x 200, 200 / 192 of a pixel each).
    if !run(app, "action select_color_range\n") { return 59 }
    const thumb = view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_FIELD))
    if thumb.width != 267 || thumb.height != 200 { return 60 }
    if !step2(app, "click", thumb.x + 20 * 200 / 192, thumb.y + 130 * 200 / 192) || !run(app, "key Enter\n") { return 61 }
    if picked(app, 15, 125) != 255 || picked(app, 110, 110) != 0 { return 62 }
    // Cancel keeps the selection.
    base = steps(app)
    if !run(app, "action select_color_range\nkey Escape\n") || steps(app) != base || picked(app, 15, 125) != 255 { return 63 }
    if !run(app, "action select_none\n") { return 64 }
    return 0
}

// ---------------------------------------------------------------------------
// The Filter menu

const GROUPS = [9][]const u8{ "Adjust|Anpassen", "Artistic|Künstlerisch", "Blur|Weichzeichnen", "Colours|Farben", "Edge Detection|Kantenerkennung", "Emboss|Relief", "Enhance|Verbessern", "Map|Abbilden", "Other|Sonstige" }

fn filterMenu(app: *App) -> u8 {
    var total: usize = 0
    var group: usize = 0
    while group < 9 {
        const source = sourceOf(state.MENU_FILTER, GROUPS[group])
        if source == null { return 65 }
        const count = source.?.*.count(app)
        var expected: usize = 0
        var index: usize = 0
        while index < filters.count() {
            if filters.at(index).?.*.category == @intCast(u8, group) { expected += 1 }
            index += 1
        }
        if count != expected || count == 0 { return 66 }
        // Each entry is its filter, with "…" when it has a form.
        var entry: usize = 0
        while entry < count {
            const name = source.?.*.name(app, entry)
            const info = filter_actions.filterIn(@intCast(u8, group), entry)
            if info == null || !std.text.startsWith(name, info.?.*.name) || std.text.endsWith(name, "…") != (info.?.*.params.length > 0) { return 67 }
            entry += 1
        }
        total += count
        group += 1
    }
    if total != filters.count() { return 68 }
    const blurs = sourceOf(state.MENU_FILTER, "Blur|Weichzeichnen").?
    if !std.text.same(blurs.*.name(app, 0), "Gaussian Blur…") { return 69 }
    const adjusts = sourceOf(state.MENU_FILTER, "Adjust|Anpassen").?
    if !std.text.same(adjusts.*.name(app, 0), "Invert") { return 70 }
    app.*.german = true
    const german = std.text.same(blurs.*.name(app, 0), "Gaußscher Weichzeichner …")
    app.*.german = false
    if !german { return 71 }
    // Nothing to repeat yet.
    if api.actionEnabled(app, actionOf("filter_repeat")) { return 72 }
    return 0
}

// Invert through the menu bar: Filter > Adjust > Invert.
fn invertByMenu(app: *App) -> u8 {
    const layer = layerOf(app)
    const base = steps(app)
    if device.pixel(layer.*.device.?, 110, 110) != 0xFFFF0000 { return 75 }
    if !clickIn(app, menus.titleArea(app, state.MENU_FILTER)) || !menus.isOpen(app) { return 76 }
    const row = rowNamed(app, 0, "Adjust")
    if row == menus.NO_ROW || !clickIn(app, menus.rowArea(app, 0, row)) || menus.depth(app) != 2 { return 77 }
    const entry = rowNamed(app, 1, "Invert")
    if entry == menus.NO_ROW || !clickIn(app, menus.rowArea(app, 1, entry)) { return 78 }
    if menus.isOpen(app) || app.*.dialogCount != 0 { return 79 }
    if device.pixel(layer.*.device.?, 110, 110) != 0xFF00FFFF || device.pixel(layer.*.device.?, 15, 125) != 0xFFFFFF00 { return 80 }
    // Transparent stays nothing at all.
    if device.pixel(layer.*.device.?, 50, 50) != 0 || device.pixel(layer.*.device.?, 200, 20) != 0 { return 81 }
    if steps(app) != base + 1 || !lastStep(app, "Invert") { return 82 }
    if shown(app, 110, 110) != 0xFF00FFFF || shown(app, 50, 50) != 0xFFFFFFFF { return 83 }
    return 0
}

// Gaussian Blur's form: the preview, OK, Cancel.
fn gaussian(app: *App) -> u8 {
    const layer = layerOf(app)
    const image = imageOf(app)
    const all = image_module.bounds(image)
    const before = checksum(layer.*.device.?, all)
    var base = steps(app)
    // (The pointer away from the dockers and the dialog.)
    if !run(app, "pointer 300 400\n") { return 85 }
    filterdialog.choose(app, blur.GAUSSIAN_BLUR)
    if !run(app, "wait 10\n") || app.*.dialogCount != 1 || !filterdialog.busy(app) { return 86 }
    if layer.*.substitute == null { return 87 }
    // The image shows the blur, the layer is as it was.
    const edge = shown(app, 99, 110)
    if edge == 0xFFFFFFFF || edge == 0xFF00FFFF { return 88 }
    if checksum(layer.*.device.?, all) != before || device.pixel(layer.*.device.?, 99, 110) != 0 { return 89 }
    if !picture(app, "filter-dialog.png") { return 90 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 || filterdialog.busy(app) || layer.*.substitute != null { return 91 }
    if device.pixel(layer.*.device.?, 99, 110) == 0 || checksum(layer.*.device.?, all) == before { return 92 }
    if steps(app) != base + 1 || !lastStep(app, "Gaussian Blur") || shown(app, 99, 110) != edge { return 93 }
    // Cancel: nothing changes, nothing is kept.
    const blurred = checksum(layer.*.device.?, all)
    const showing = shown(app, 99, 109)
    base = steps(app)
    filterdialog.choose(app, blur.GAUSSIAN_BLUR)
    if !run(app, "wait 10\n") || layer.*.substitute == null || shown(app, 99, 109) == showing { return 94 }
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 || layer.*.substitute != null { return 95 }
    if checksum(layer.*.device.?, all) != blurred || steps(app) != base || shown(app, 99, 109) != showing { return 96 }
    // The preview off: the image shows the layer as it is.
    filterdialog.choose(app, blur.GAUSSIAN_BLUR)
    if !run(app, "wait 10\n") { return 97 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_FIELD + node_module.VALUES))) || layer.*.substitute != null || shown(app, 99, 109) != showing { return 98 }
    // (Off it stays for the next form; on again for the rest.)
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_FIELD + node_module.VALUES))) || layer.*.substitute == null || !run(app, "key Escape\n") { return 99 }
    return 0
}

// The layer's pixels against `reference` (`stride` words a row from
// `from`'s corner) over `area`: the largest difference of a channel.
fn largestDifference(target: *device.Device, reference: [*]const u32, stride: usize, from: geom.Rect, area: geom.Rect) -> u32 {
    var most: u32 = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            var wanted = reference[@intCast(usize, y - from.y) * stride + @intCast(usize, x - from.x)]
            if wanted >> 24 == 0 { wanted = 0 }
            const got = device.pixel(target, x, y)
            var shift: u32 = 0
            while shift < 32 {
                const a = (wanted >> @intCast(u5, shift)) & 255
                const b = (got >> @intCast(u5, shift)) & 255
                const apart = if a > b { a - b } else { b - a }
                if apart > most { most = apart }
                shift += 8
            }
            x += 1
        }
        y += 1
    }
    return most
}

// `source` filtered with `params` in one piece; the largest difference
// to the layer over what the filter could change.
fn againstWhole(app: *App, source: *device.Device, target: *device.Device) -> u32 {
    const margin = filters.margin(&params)
    const inner = geom.grown(device.extent(source), margin)
    const outer = geom.grown(inner, margin)
    const stride = @intCast(usize, outer.width)
    const count = stride * @intCast(usize, outer.height)
    const memory = app.*.allocator.alloc(count * 4, 16)
    if memory == null { return 1000 }
    const buffer: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    device.readRect(source, outer, buffer, stride)
    _ = filters.apply(&params, buffer, stride, @intCast(usize, outer.height), stride)
    const most = largestDifference(target, buffer, stride, outer, inner)
    app.*.allocator.free(memory.?, count * 4, 16)
    return most
}

// A pattern across the tiles' borders, blurred by the dialog and again
// with Ctrl+F: as the layer blurred in one piece.
fn seams(app: *App) -> u8 {
    if !run(app, "new 200 160\n") { return 100 }
    const layer = layerOf(app)
    var y: i32 = 20
    while y < 140 {
        var x: i32 = 20
        while x < 180 {
            const r = @intCast(u32, (x * 5) & 255)
            const g = @intCast(u32, (y * 3) & 255)
            const b = @intCast(u32, ((x + y) * 7) & 255)
            const a: u32 = if (x / 9 + y / 7) % 5 == 0 { 128 } else { 255 }
            device.setPixel(layer.*.device.?, x, y, (a << 24) | (r << 16) | (g << 8) | b)
            x += 1
        }
        y += 1
    }
    image_module.damageAll(imageOf(app))
    const before = device.copy(layer.*.device.?)
    if before == null { return 101 }
    // The form's numbers as they were left: the blur's own (5, 5).
    filterdialog.choose(app, blur.GAUSSIAN_BLUR)
    if !run(app, "wait 10\nkey Enter\n") || app.*.dialogCount != 0 || steps(app) != 1 { return 102 }
    filters.defaults(blur.GAUSSIAN_BLUR, &params)
    if againstWhole(app, before.?, layer.*.device.?) > 1 { return 103 }
    device.destroy(before.?)
    // Numbers typed into the form (2 and 2) are what Ctrl+F applies.
    filterdialog.choose(app, blur.GAUSSIAN_BLUR)
    if !run(app, "wait 10\n") || app.*.dialogCount != 1 { return 104 }
    const kit = api.kit(app)
    // (A frame opens the number for typing.)
    kit_module.focus(kit, dialogs.partId(app, dialogs.PART_FIELD))
    api.redraw(app)
    if !run(app, "wait 10\ntype 2\nkey Enter\n") { return 105 }
    kit_module.focus(kit, dialogs.partId(app, dialogs.PART_FIELD + 1))
    api.redraw(app)
    if !run(app, "wait 10\ntype 2\nkey Enter\n") || app.*.dialogCount != 1 { return 106 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 || steps(app) != 2 { return 107 }
    const again = device.copy(layer.*.device.?)
    if again == null || !api.actionEnabled(app, actionOf("filter_repeat")) { return 108 }
    if !run(app, "key Ctrl+F\n") || steps(app) != 3 || !lastStep(app, "Gaussian Blur") { return 109 }
    params.values[0] = 2.0
    params.values[1] = 2.0
    if againstWhole(app, again.?, layer.*.device.?) > 1 { return 110 }
    device.destroy(again.?)
    // Ctrl+Alt+F asks again; Escape leaves it.
    if !run(app, "key Ctrl+Alt+F\n") || app.*.dialogCount != 1 || !run(app, "key Escape\n") || steps(app) != 3 { return 111 }
    // With a selection: only inside it, by its amounts.
    const kept = device.copy(layer.*.device.?)
    if kept == null { return 112 }
    const image = imageOf(app)
    ops.beginSelection(image)
    if !selection.fromRect(image.*.selection, geom.rect(0, 0, 100, 160), selection.REPLACE, 0.0) { return 113 }
    ops.endSelection(image, true, "Rectangle")
    if !run(app, "key Ctrl+F\n") || steps(app) != 5 { return 114 }
    if device.pixel(layer.*.device.?, 150, 80) != device.pixel(kept.?, 150, 80) || device.pixel(layer.*.device.?, 50, 80) == device.pixel(kept.?, 50, 80) { return 115 }
    device.destroy(kept.?)
    canvasview.forget(app, api.document(app).?)
    documents.close(app, app.*.current)
    return 0
}

// A long filter over frames, and one cancelled.
fn longJob(app: *App) -> u8 {
    if !run(app, "new 2100 1050 FFFFFF\n") { return 120 }
    const image = imageOf(app)
    image.*.active = node_module.childAt(image.*.root, 0)
    filterdialog.choose(app, adjust.INVERT)
    if app.*.dialogCount != 1 || !filterdialog.busy(app) { return 121 }
    var rounds: usize = 0
    while app.*.dialogCount > 0 && rounds < 40 {
        if !run(app, "wait 20\n") { return 123 }
        rounds += 1
    }
    if app.*.dialogCount != 0 || filterdialog.busy(app) { return 124 }
    if shown(app, 0, 0) != 0xFF000000 || shown(app, 2099, 1049) != 0xFF000000 || shown(app, 1000, 500) != 0xFF000000 { return 125 }
    if steps(app) != 1 || !lastStep(app, "Invert") { return 126 }
    // Begun again, stopped by Escape after one frame's part: as it was.
    const ground = image.*.active.?.*.device.?
    filterdialog.choose(app, adjust.INVERT)
    const frame = script.frameOf(app)
    if frame == null || app.*.dialogCount != 1 { return 127 }
    loop.frame(app, frame.?)
    if app.*.dialogCount != 1 || device.pixel(ground, 0, 0) != 0xFFFFFFFF || device.pixel(ground, 2099, 1049) != 0xFF000000 { return 122 }
    // (Escape straight to the loop: a script draws the frames due first,
    // and those would finish the work.)
    loop.event(app, ui_app.EVENT_KEY, keys.ESCAPE, 1)
    if app.*.dialogCount != 0 || steps(app) != 1 { return 128 }
    if device.pixel(ground, 0, 0) != 0xFF000000 || device.pixel(ground, 2099, 1049) != 0xFF000000 { return 129 }
    canvasview.forget(app, api.document(app).?)
    documents.close(app, app.*.current)
    return 0
}

// ---------------------------------------------------------------------------
// The View menu

fn near(value: f64, wanted: f64) -> bool { return value > wanted - 0.000001 && value < wanted + 0.000001 }

fn viewing(app: *App) -> u8 {
    const doc = api.document(app).?
    if !run(app, "pointer 300 400\nkey 1\n") || doc.*.view.zoom != 1.0 { return 130 }
    if !run(app, "key Ctrl++\n") || !(doc.*.view.zoom > 1.0) { return 131 }
    const larger = doc.*.view.zoom
    if !run(app, "key Ctrl+-\n") || !(doc.*.view.zoom < larger) { return 132 }
    if !run(app, "action view_zoom_out\n") || !(doc.*.view.zoom < 1.0) { return 133 }
    if !run(app, "action view_zoom_in\naction view_zoom_actual\n") || doc.*.view.zoom != 1.0 { return 134 }
    if !run(app, "key Ctrl+0\n") || doc.*.view.zoom == 1.0 || doc.*.view.zoom * 256.0 > @floatFromInt(f64, doc.*.view.area.width) { return 135 }
    if !run(app, "action view_zoom_width\n") || !(doc.*.view.zoom > 0.0) { return 136 }
    const notch = 3.141592653589793 / 12.0
    if !run(app, "key 4\n") || !near(doc.*.view.rotation, -notch) || !api.actionEnabled(app, actionOf("view_rotate_reset")) { return 137 }
    if !run(app, "key 6\nkey 6\n") || !near(doc.*.view.rotation, notch) { return 138 }
    if !run(app, "key 5\n") || doc.*.view.rotation != 0.0 || api.actionEnabled(app, actionOf("view_rotate_reset")) { return 139 }
    if !run(app, "key M\n") || !doc.*.view.mirror || !checked(app, "view_mirror") { return 140 }
    if !run(app, "action view_mirror\n") || doc.*.view.mirror || checked(app, "view_mirror") { return 141 }
    if !run(app, "key Ctrl+Shift+'\n") || !doc.*.showGrid || !checked(app, "view_grid") { return 142 }
    if !run(app, "action view_grid\n") || doc.*.showGrid { return 143 }
    if !run(app, "action view_rulers\n") || !doc.*.showRulers || !checked(app, "view_rulers") { return 144 }
    if !run(app, "action view_rulers\n") || doc.*.showRulers { return 145 }
    if !doc.*.showGuides || !run(app, "action view_guides\n") || doc.*.showGuides || checked(app, "view_guides") { return 146 }
    if !run(app, "action view_guides\n") || !doc.*.showGuides { return 147 }
    const grid = canvasview.pixelGrid(app)
    if !run(app, "action view_pixel_grid\n") || canvasview.pixelGrid(app) == grid || checked(app, "view_pixel_grid") == grid { return 148 }
    if !run(app, "action view_pixel_grid\n") || canvasview.pixelGrid(app) != grid { return 149 }
    if !run(app, "key W\n") || !app.*.wrapAround || !checked(app, "view_wrap_around") { return 150 }
    if !run(app, "key W\n") || app.*.wrapAround { return 151 }
    if !run(app, "action view_canvas_only\n") || !app.*.canvasOnly || !checked(app, "view_canvas_only") || app.*.canvasArea.height != 768 { return 152 }
    if !run(app, "action view_canvas_only\n") || app.*.canvasOnly { return 153 }
    if !run(app, "key Ctrl+Shift+F\n") || !checked(app, "view_fullscreen") || !run(app, "action view_fullscreen\n") || checked(app, "view_fullscreen") { return 154 }
    return 0
}

fn dockersList(app: *App) -> u8 {
    const source = sourceOf(state.MENU_VIEW, "Dockers|Docker")
    if source == null || source.?.*.count(app) != dockers.count() || dockers.count() == 0 { return 160 }
    const first = dockers.at(0).?
    const was = docks.isShown(app, first.*.id)
    if source.?.*.checked.?(app, 0) != was { return 161 }
    source.?.*.run(app, 0)
    if docks.isShown(app, first.*.id) == was || source.?.*.checked.?(app, 0) == was { return 162 }
    source.?.*.run(app, 0)
    if docks.isShown(app, first.*.id) != was { return 163 }
    if !std.text.same(source.?.*.name(app, 0), first.*.name) { return 164 }
    if !run(app, "action view_dockers_hide\n") { return 165 }
    var index: usize = 0
    while index < dockers.count() {
        if docks.isShown(app, dockers.at(index).?.*.id) { return 166 }
        index += 1
    }
    if !run(app, "action view_dockers_show\n") { return 167 }
    index = 0
    while index < dockers.count() {
        if !docks.isShown(app, dockers.at(index).?.*.id) { return 168 }
        index += 1
    }
    if !run(app, "action settings_reset_dockers\nexpect-note dockers\n") { return 169 }
    return 0
}

const TOOL_GROUPS = [7][]const u8{ "Paint|Malen", "Shapes|Formen", "Transform|Transformieren", "Fill|Füllen", "Select|Auswählen", "View|Ansicht", "Other|Sonstige" }

fn toolsMenu(app: *App) -> u8 {
    var total: usize = 0
    var group: usize = 0
    while group < 7 {
        const source = sourceOf(state.MENU_TOOLS, TOOL_GROUPS[group])
        if source == null { return 170 }
        const count = source.?.*.count(app)
        var entry: usize = 0
        while entry < count {
            source.?.*.run(app, entry)
            if !source.?.*.checked.?(app, entry) || source.?.*.name(app, entry).length == 0 { return 171 }
            entry += 1
        }
        total += count
        group += 1
    }
    if total != tools.count() || total == 0 { return 172 }
    const paint = sourceOf(state.MENU_TOOLS, "Paint|Malen").?
    paint.*.run(app, 0)
    if app.*.tool != tools.at(0).?.*.id { return 173 }
    return 0
}

// ---------------------------------------------------------------------------
// The preferences

fn prefs(app: *App, allocator: std.allocator.Allocator) -> u8 {
    if !run(app, "action settings_preferences\n") || preferences.page(app) != preferences.PAGE_GENERAL { return 175 }
    if !picture(app, "preferences.png") { return 176 }
    // Undo steps typed: applied to the images, saved, read by another App.
    if !clickIn(app, preferences.settingArea(app, "undo_steps")) || !run(app, "type 350\nkey Enter\n") { return 177 }
    if settings.get(app).*.undoSteps != 350 || imageOf(app).*.history.*.limit != 350 { return 178 }
    var path: [4200]u8 = undefined
    const bytes: [*]u8 = &path
    const current: [*]const u8 = &cwd
    var length = std.text.append(bytes, 0, 4200, current[0..cwdLength])
    length = std.text.append(bytes, length, 4200, "/nebula-72/config/mlx/nebula.conf")
    bytes[length] = 0
    if !std.fs.exists(bytes) { return 179 }
    const second = fresh(allocator)
    if second == null || settings.get(second.?).*.undoSteps != 350 { return 180 }
    // A switch: saved at once.
    const before = settings.get(app).*.confirmClose
    if !clickIn(app, preferences.settingArea(app, "confirm_close")) || settings.get(app).*.confirmClose == before { return 181 }
    if !settings.load(second.?) || settings.get(second.?).*.confirmClose == before { return 182 }
    if !clickIn(app, preferences.settingArea(app, "confirm_close")) || settings.get(app).*.confirmClose != before { return 183 }
    // The Shortcuts page: Select All found by the filter, a new shortcut.
    if !clickIn(app, preferences.pageArea(app, preferences.PAGE_SHORTCUTS)) || preferences.page(app) != preferences.PAGE_SHORTCUTS { return 184 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, 300))) || !run(app, "type select\n") { return 185 }
    if !clickIn(app, preferences.rowArea(app, "select_all")) || !preferences.recording(app) { return 186 }
    if !picture(app, "preferences-shortcuts.png") { return 187 }
    if !run(app, "key Ctrl+Shift+K\n") || preferences.recording(app) || !hasShortcut(app, "select_all", "Ctrl+Shift+K") { return 188 }
    // Invert Selection's keys: named as a conflict, taken at the second
    // press.
    if !clickIn(app, preferences.rowArea(app, "select_all")) || !run(app, "key Ctrl+I\n") { return 189 }
    if !std.text.same(preferences.conflict(app), "select_invert") || !preferences.recording(app) || !hasShortcut(app, "select_all", "Ctrl+Shift+K") { return 190 }
    if !run(app, "key Ctrl+I\n") || preferences.recording(app) || !hasShortcut(app, "select_all", "Ctrl+I") || !keys.isNone(shortcuts.ofAction(app, actionOf("select_invert"))) { return 191 }
    // Closed, the keys select all; Ctrl+A does nothing now.
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 192 }
    if imageOf(app).*.selected && !run(app, "action select_none\n") { return 193 }
    if !run(app, "pointer 300 400\nkey Ctrl+A\n") || imageOf(app).*.selected { return 194 }
    if !run(app, "key Ctrl+I\n") || !imageOf(app).*.selected || picked(app, 0, 0) != 255 { return 195 }
    // Every shortcut its own again, after asking.
    if !run(app, "action settings_shortcuts\n") || preferences.page(app) != preferences.PAGE_SHORTCUTS { return 196 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_BUTTON))) || app.*.dialogCount != 2 { return 197 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 1 { return 198 }
    if !hasShortcut(app, "select_all", "Ctrl+A") || !hasShortcut(app, "select_invert", "Ctrl+I") { return 199 }
    // Backspace takes a shortcut away; the row's button gives it back.
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, 300))) || !run(app, "type select\n") { return 217 }
    if !clickIn(app, preferences.rowArea(app, "select_all")) || !run(app, "key Backspace\n") || !keys.isNone(shortcuts.ofAction(app, actionOf("select_all"))) { return 200 }
    const row = preferences.rowArea(app, "select_all")
    if !step2(app, "click", row.x + row.width - 30, row.y + row.height / 2) || !hasShortcut(app, "select_all", "Ctrl+A") { return 201 }
    // Up, Down and Enter choose a row and record it.
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 202 }
    // The language: German at once, then English, then the system's.
    if !run(app, "action settings_preferences\n") || !clickIn(app, preferences.pageArea(app, preferences.PAGE_LANGUAGE)) { return 203 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, 312))) || !app.*.german || settings.get(app).*.language != settings.LANGUAGE_GERMAN { return 204 }
    if !picture(app, "preferences-german.png") { return 205 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, 311))) || app.*.german { return 206 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, 310))) || app.*.german || settings.get(app).*.language != settings.LANGUAGE_SYSTEM { return 207 }
    // The light theme.
    if !clickIn(app, preferences.pageArea(app, preferences.PAGE_GENERAL)) { return 208 }
    settings.get(app).*.theme = settings.THEME_LIGHT
    if !settings.changed(app) || !picture(app, "preferences-light.png") || app.*.lightness != 1024 { return 209 }
    settings.get(app).*.theme = settings.THEME_SYSTEM
    if !settings.changed(app) || !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 210 }
    return 0
}

fn help(app: *App) -> u8 {
    if !run(app, "action help_shortcuts\n") || app.*.dialogCount != 1 { return 212 }
    if !picture(app, "shortcuts.png") { return 213 }
    if !clickIn(app, view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_BUTTON))) || app.*.dialogCount != 1 || preferences.page(app) != preferences.PAGE_SHORTCUTS { return 214 }
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 215 }
    if !run(app, "action help_about\n") || app.*.dialogCount != 1 || !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 216 }
    return 0
}

// The value arena over this package's own work: a filter applied again
// and again at numbers that change nothing (blocks read, filtered,
// compared, nothing written: the history is not touched, which takes
// arena space of its own in core/ops.mlx), and frames of the filter's
// form with its preview made again in each. (No script in between:
// nothing gives the arena back.)
fn arena(app: *App) -> u8 {
    const base = turns.locate()
    filterdialog.choose(app, adjust.BRIGHTNESS_CONTRAST)
    if !run(app, "wait 10\nkey Enter\n") || app.*.dialogCount != 0 { return 220 }
    const before_steps = steps(app)
    filterdialog.repeat(app)
    const before = turns.used(base)
    var round: usize = 0
    while round < 20 {
        filterdialog.repeat(app)
        round += 1
    }
    if turns.used(base) != before || steps(app) != before_steps { return 221 }
    // The Gaussian form open, its preview turned off and on in every
    // frame (a click on its switch: the preview made again).
    filterdialog.choose(app, blur.GAUSSIAN_BLUR)
    if !run(app, "wait 10\n") || app.*.dialogCount != 1 { return 222 }
    const frame = script.frameOf(app).?
    const box = view.areaOf(state.uiOf(app), dialogs.partId(app, dialogs.PART_FIELD + node_module.VALUES))
    if box.width <= 0 { return 223 }
    const layer = layerOf(app)
    _ = view.pointerMove(state.uiOf(app), box.x + 4, box.y + box.height / 2)
    loop.frame(app, frame)
    const during = turns.used(base)
    round = 0
    while round < 20 {
        _ = view.pointerButton(state.uiOf(app), true)
        loop.frame(app, frame)
        _ = view.pointerButton(state.uiOf(app), false)
        loop.frame(app, frame)
        round += 1
    }
    @discardError(std.io.printFmt("frames {} {}\n", .{ turns.used(base) - during, if layer.*.substitute == null { 0 } else { 1 } }))
    if turns.used(base) != during || layer.*.substitute == null { return 224 }
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 || layer.*.substitute != null { return 225 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const shots = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if shots != null {
        const bytes: [*]u8 = &shotsAt
        shotsLength = std.text.append(bytes, 0, 512, std.string.asSlice(shots.?))
    }
    const length = std.fs.getWorkingDirectory(&cwd, 4096)
    if length <= 0 { return 1 }
    cwdLength = @intCast(usize, length)
    while cwdLength > 0 && cwd[cwdLength - 1] == 0 { cwdLength -= 1 }
    const allocator = std.heap.allocator()
    const made = fresh(allocator)
    if made == null { return 2 }
    const app = made.?
    if !run(app, "size 1024 768\nnew 256 192 FFFFFF\n") { return 3 }
    // Every action of these menus is there.
    const keys_wanted = [8][]const u8{ "select_all", "select_color_range", "filter_repeat", "view_zoom_in", "view_canvas_only", "settings_preferences", "help_about", "help_shortcuts" }
    var index: usize = 0
    while index < 8 {
        if actions.byKey(keys_wanted[index]) == null { return 4 }
        index += 1
    }
    var failed = basics(app)
    if failed != 0 { return failed }
    failed = outline(app)
    if failed != 0 { return failed }
    failed = byColor(app)
    if failed != 0 { return failed }
    failed = filterMenu(app)
    if failed != 0 { return failed }
    failed = invertByMenu(app)
    if failed != 0 { return failed }
    failed = gaussian(app)
    if failed != 0 { return failed }
    failed = seams(app)
    if failed != 0 { return failed }
    failed = longJob(app)
    if failed != 0 { return failed }
    failed = viewing(app)
    if failed != 0 { return failed }
    failed = dockersList(app)
    if failed != 0 { return failed }
    failed = toolsMenu(app)
    if failed != 0 { return failed }
    failed = prefs(app, allocator)
    if failed != 0 { return failed }
    failed = help(app)
    if failed != 0 { return failed }
    failed = arena(app)
    if failed != 0 { return failed }
    return 13
}
