// nebula's shortcuts: read from text and written as it, matched by what a
// key types (letters, digits, marks: the same on every keyboard layout)
// or by its code (function keys, named keys), with the modifiers a
// shortcut names and no others; and the App's slots. Exits 13.
const std = @import("std")
const state = @import("../app/state.mlx")
const shell_module = @import("../app/shell.mlx")
const keys = @import("../app/keys.mlx")

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const undo = keys.parse("Ctrl+Shift+Z")
    if undo.modifiers != (keys.CONTROL | keys.SHIFT) || undo.character != 122 || undo.code != 0 { return 1 }
    var text: [32]u8 = undefined
    const bytes: [*]const u8 = &text
    var length = keys.format(undo, &text)
    if !std.text.same(bytes[0..length], "Ctrl+Shift+Z") { return 2 }
    // The letter with exactly these modifiers, whatever case it types.
    if !keys.matches(undo, 44, keys.CONTROL | keys.SHIFT, "Z") { return 3 }
    if keys.matches(undo, 44, keys.CONTROL, "z") || keys.matches(undo, 44, keys.CONTROL | keys.SHIFT | keys.ALT, "Z") { return 4 }
    // A German keyboard's Z is another key: the letter decides.
    if !keys.matches(undo, 21, keys.CONTROL | keys.SHIFT, "Z") || keys.matches(undo, 44, keys.CONTROL | keys.SHIFT, "Y") { return 5 }
    // A plain letter is no shortcut with Control held.
    const brush = keys.parse("b")
    if !keys.matches(brush, 48, 0, "b") || keys.matches(brush, 48, keys.CONTROL, "b") || !keys.matches(brush, 48, 0, "B") { return 6 }
    // Function keys and named keys go by their code.
    const f5 = keys.parse("F5")
    if f5.code != 63 || f5.character != 0 || !keys.matches(f5, 63, 0, "") || keys.matches(f5, 64, 0, "") { return 7 }
    if keys.parse("F12").code != keys.F12 || keys.parse("F10").code != keys.F10 || !keys.isNone(keys.parse("F13")) || !keys.isNone(keys.parse("F0")) { return 8 }
    length = keys.format(keys.parse("shift+f11"), &text)
    if !std.text.same(bytes[0..length], "Shift+F11") { return 9 }
    const delete = keys.parse("Shift+Del")
    if delete.code != keys.DELETE || !keys.matches(delete, keys.DELETE, keys.SHIFT, "") || keys.matches(delete, keys.DELETE, 0, "") { return 10 }
    length = keys.format(delete, &text)
    if !std.text.same(bytes[0..length], "Shift+Del") { return 11 }
    if keys.parse("Space").code != keys.SPACE || keys.parse("PgUp").code != keys.PAGE_UP || keys.parse("Escape").code != keys.ESCAPE { return 12 }
    // A mark's Shift belongs to the layout, not to the shortcut.
    const bracket = keys.parse("[")
    if !keys.matches(bracket, 26, 0, "[") || !keys.matches(bracket, 9, keys.SHIFT, "[") || keys.matches(bracket, 26, keys.CONTROL, "[") { return 14 }
    const plus = keys.parse("Ctrl++")
    if plus.character != 43 || plus.modifiers != keys.CONTROL || !keys.matches(plus, 13, keys.CONTROL | keys.SHIFT, "+") { return 15 }
    length = keys.format(plus, &text)
    if !std.text.same(bytes[0..length], "Ctrl++") { return 16 }
    if keys.parse("Ctrl+Plus").character != 43 { return 17 }
    // What cannot be read is no shortcut, and no shortcut matches nothing.
    if !keys.isNone(keys.parse("Ctrl+Nonsense")) || !keys.isNone(keys.parse("")) || !keys.isNone(keys.parse("Hyper+A")) { return 18 }
    if keys.matches(keys.none(), 30, 0, "a") || keys.format(keys.none(), &text) != 0 { return 19 }
    if keys.modifierOf(keys.LEFT_SHIFT) != keys.SHIFT || keys.modifierOf(keys.RIGHT_CONTROL) != keys.CONTROL || keys.modifierOf(30) != 0 || !keys.isModifier(keys.LEFT_ALT) { return 20 }
    if keys.functionKey(keys.F1) != 1 || keys.functionKey(keys.F11) != 11 || keys.functionKey(30) != 0 { return 21 }

    // The App's slots: zeroed memory of a part's own, the same each time.
    const memory = allocator.alloc(@sizeOf(shell_module.Shell), 16).?
    const shell: *shell_module.Shell = unsafe { @ptrCast(*shell_module.Shell, memory) }
    shell_module.init(shell, allocator)
    const app = state.create(allocator, shell).?
    if state.hasSlot(app, state.SLOT_KIT) { return 22 }
    const mine = state.slot(app, state.SLOT_KIT, 64).?
    if mine[0] != 0 || mine[63] != 0 { return 23 }
    mine[0] = 7
    if state.slot(app, state.SLOT_KIT, 64).?[0] != 7 || !state.hasSlot(app, state.SLOT_KIT) { return 24 }
    if state.slot(app, state.SLOTS, 8) != null { return 25 }
    if !std.text.same(state.tr(app, "Layer", "Ebene"), "Layer") { return 26 }
    app.*.german = true
    if !std.text.same(state.tr(app, "Layer", "Ebene"), "Ebene") { return 27 }
    // A shell without a window: its own clock and clipboard.
    if !shell_module.isHeadless(shell) || shell_module.now(shell) != 1000 { return 28 }
    if !shell_module.setClipboard(shell, "text/plain", "hello") || !std.text.same(shell_module.clipboard(shell, "text/plain"), "hello") { return 29 }
    if shell_module.clipboard(shell, "image/png").length != 0 || !shell_module.clipboardHas(shell, "text/plain") { return 30 }
    return 13
}
