// Animation (core/animation.mlx) and the timeline docker
// (dockers/timeline.mlx), played without a window: three keys of a layer
// at 0, 5 and 10 painted in three colours, the frame that holds at every
// time (3 shows the first, 7 the second, after the last the last), times
// held to their range; a duplicate key sharing its tiles until painted;
// painting at time 5 changing only that frame, and undo at another time
// going to that frame and restoring it (redo too); a key removed, undone,
// and the only key never; holds inserted and removed moving the keys
// after them; the onion skin at time 5 (red-tinted key before, green-
// tinted key after, nothing of the frame shown) and at 10 with two keys
// before fading; a second layer made animated by a duplicate key, the
// first key holding its content, undone back to a layer with its own
// device; the PNG sequence of the frames 0 to 10 as eleven files with the
// right colours (and no twelfth), its names, and ranges refused; the
// timeline docker: a click on a frame shows its time, the ruler too, the
// transport's buttons, a double click adding a key and Ctrl+Z taking it
// away, a key dragged along its row, keys over the docker, the buttons
// for keys, the frame rate typed, zoom, the wheel over the ruler and the
// bar under the frames moving them sideways, the clip exported beside the
// image's file (and the note to save it first); playing advancing a frame
// every 1/24 s over the clock's ticks and pausing, and the played time by
// the clock alone; a layer brought back by undo synchronized; the onion
// skin drawn over the canvas and gone again; at 1024 x 768, and narrow at
// the left with two rows, everything of the docker inside it and nothing
// over another; the value arena not growing over many times shown; the
// heap holding what it held after images animated, undone and ended (the
// record before the image and after); the record let go when its
// document closes. Pictures timeline.png, timeline-onion.png,
// timeline-plain.png, timeline-1024.png, timeline-narrow.png,
// timeline-light.png and timeline-german.png in the current directory
// and, when NEBULA_SHOTS names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const settings = @import("../app/settings.mlx")
const documents = @import("../app/documents.mlx")
const docks = @import("../ui/docks.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const viewport = @import("../ui/viewport.mlx")
const timeline = @import("../dockers/timeline.mlx")
const animation = @import("../core/animation.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const device = @import("../core/device.mlx")
const history = @import("../core/history.mlx")
const render = @import("../core/render.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const io_png = @import("../io/png.mlx")
const io_text = @import("../io/text.mlx")

const App = state.App
const Image = image_module.Image
const Node = node_module.Node
const Animation = animation.Animation

const RED: u32 = 0xFFE02020
const GREEN: u32 = 0xFF20B040
const BLUE: u32 = 0xFF2040E0
const YELLOW: u32 = 0xFFF0D020
const ORANGE: u32 = 0xFFF08020
const WHITE: u32 = 0xFFFFFFFF

// Where the keys at 0, 5 and 10 paint (the third across the tiles' border
// at 64), and a place inside each.
fn area0() -> geom.Rect { return geom.rect(8, 8, 16, 16) }
fn area5() -> geom.Rect { return geom.rect(32, 8, 16, 16) }
fn area10() -> geom.Rect { return geom.rect(56, 8, 16, 16) }
const X0: i32 = 15
const X5: i32 = 39
const X10: i32 = 66
const Y: i32 = 15
// Where the yellow goes at 5.
const YX: i32 = 12
const YY: i32 = 44

// A script being put together.
var buffer: [1024]u8 = undefined
var used: usize = 0
// Where the pictures go besides the current directory (NEBULA_SHOTS).
var shotsAt: usize = 0
var shotsLength: usize = 0

fn start() -> void { used = 0 }
fn add(text: []const u8) -> void { used = std.text.append(&buffer, used, 1024, text) }
fn addNumber(value: i32) -> void { used = std.text.appendSigned(&buffer, used, 1024, @intCast(isize, value)) }

fn play(app: *App) -> bool {
    const bytes: [*]const u8 = &buffer
    return script.run(app, bytes[0..used])
}

fn point(app: *App, command: []const u8, x: i32, y: i32) -> bool {
    start()
    add(command)
    add(" ")
    addNumber(x)
    add(" ")
    addNumber(y)
    add("\n")
    return play(app)
}

fn click(app: *App, x: i32, y: i32) -> bool { return point(app, "click", x, y) }

fn clickIn(app: *App, area: ui.Rect) -> bool {
    if ui.isEmpty(area) { return false }
    return click(app, area.x + area.width / 2, area.y + area.height / 2)
}

fn drag(app: *App, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    start()
    add("drag ")
    addNumber(x0)
    add(" ")
    addNumber(y0)
    add(" ")
    addNumber(x1)
    add(" ")
    addNumber(y1)
    add(" 6\n")
    return play(app)
}

// The frame as a picture here and in the shots' directory.
fn save(app: *App, name: []const u8) -> bool {
    start()
    add("shot ")
    add(name)
    add("\n")
    if !play(app) { return false }
    if shotsLength == 0 || shotsLength > 400 { return true }
    const shots = unsafe { @ptrFromInt([*]const u8, shotsAt) }[0..shotsLength]
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, shots)
    if bytes[length - 1] != '/' { length = std.text.appendByte(bytes, length, 599, '/') }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    const frame = script.frameOf(app).?
    return png.saveFile(bytes, frame.*.pixels, frame.*.width, frame.*.height, frame.*.stride, false, app.*.allocator)
}

// What the whole image shows at (x, y).
fn shown(image: *Image, x: i32, y: i32) -> u32 {
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

// `area` of `node` painted `color`: one step of the history.
fn paint(image: *Image, node: *Node, area: geom.Rect, color: u32) -> bool {
    if !ops.beginPixels(image, node) { return false }
    if !device.fill(node.*.device.?, area, color) { return false }
    return !geom.isEmpty(ops.endPixels(image, node, "Paint"))
}

fn keyDevice(anim: *Animation, node: *Node, time: i32) -> *device.Device {
    return animation.deviceAt(animation.trackOf(anim, node.*.id).?, time)
}

fn keyTimes(anim: *Animation, node: *Node, a: i32, b: i32, c: i32) -> bool {
    const track = animation.trackOf(anim, node.*.id)
    if track == null || animation.keyCount(track.?) != 3 { return false }
    return animation.keyTime(track.?, 0) == a && animation.keyTime(track.?, 1) == b && animation.keyTime(track.?, 2) == c
}

fn showsAt(anim: *Animation, image: *Image, time: i32, at0: u32, at5: u32, at10: u32) -> bool {
    _ = animation.setTime(anim, image, time)
    return shown(image, X0, Y) == at0 && shown(image, X5, Y) == at5 && shown(image, X10, Y) == at10
}

// ---------------------------------------------------------------------------

// Three keys at 0, 5 and 10, each painted, and what every time shows.
fn keysAndTime(anim: *Animation, image: *Image, layer: *Node) -> u8 {
    if anim.*.fps != 24 || anim.*.start != 0 || anim.*.end != 23 || anim.*.time != 0 || animation.isAnimated(anim, layer.*.id) { return 20 }
    if animation.find(image) == null || @intFromPtr(animation.find(image).?) != @intFromPtr(anim) { return 21 }
    const original = layer.*.device.?
    // The first key holds what the layer showed: its own device.
    if !animation.addBlankKey(anim, image, layer.*.id, 0, "New Frame") { return 22 }
    const track = animation.trackOf(anim, layer.*.id)
    if track == null || animation.keyCount(track.?) != 1 || animation.keyTime(track.?, 0) != 0 { return 23 }
    if @intFromPtr(layer.*.device.?) != @intFromPtr(original) { return 24 }
    if !paint(image, layer, area0(), RED) { return 25 }
    if !animation.addBlankKey(anim, image, layer.*.id, 5, "New Frame") || animation.keyCount(track.?) != 2 { return 26 }
    if anim.*.time != 0 || shown(image, X0, Y) != RED { return 27 }
    // At 5 the empty frame: the white ground shows.
    _ = animation.setTime(anim, image, 5)
    if @intFromPtr(layer.*.device.?) == @intFromPtr(original) || device.tileCount(layer.*.device.?) != 0 || shown(image, X0, Y) != WHITE { return 28 }
    if !paint(image, layer, area5(), GREEN) { return 29 }
    if !animation.addBlankKey(anim, image, layer.*.id, 10, "New Frame") { return 30 }
    _ = animation.setTime(anim, image, 10)
    if !paint(image, layer, area10(), BLUE) { return 31 }
    if !keyTimes(anim, layer, 0, 5, 10) { return 32 }
    // Time 3 shows the first, 7 the second; the last holds on.
    if !showsAt(anim, image, 3, RED, WHITE, WHITE) { return 33 }
    if !showsAt(anim, image, 7, WHITE, GREEN, WHITE) { return 34 }
    if !showsAt(anim, image, 10, WHITE, WHITE, BLUE) || !showsAt(anim, image, 400, WHITE, WHITE, BLUE) { return 35 }
    if !showsAt(anim, image, 0, RED, WHITE, WHITE) || @intFromPtr(layer.*.device.?) != @intFromPtr(original) { return 36 }
    // Times are held to 0 .. LAST_TIME.
    _ = animation.setTime(anim, image, -5)
    if anim.*.time != 0 { return 37 }
    _ = animation.setTime(anim, image, 2000000000)
    if anim.*.time != animation.LAST_TIME { return 38 }
    _ = animation.setTime(anim, image, 0)
    // Reading the keys.
    var at: i32 = 0
    var index: usize = 0
    if animation.shownIndex(track.?, 7) != 1 || animation.shownIndex(track.?, 99) != 2 || !animation.keyIndexAt(track.?, 5, &index) || index != 1 || animation.keyIndexAt(track.?, 6, &index) { return 39 }
    if !animation.nextKey(track.?, 5, &at) || at != 10 || animation.nextKey(track.?, 10, &at) { return 40 }
    if !animation.previousKey(track.?, 5, &at) || at != 0 || animation.previousKey(track.?, 0, &at) || animation.lastKeyTime(anim) != 10 { return 41 }
    if animation.isBlankKey(track.?, 1) { return 42 }
    // Not on a time outside the range, not on a group.
    if animation.addBlankKey(anim, image, layer.*.id, -1, "x") || animation.addBlankKey(anim, image, layer.*.id, animation.LAST_TIME + 1, "x") { return 43 }
    const group = ops.newLayer(image, node_module.GROUP, "Group", "New group")
    if group == null || animation.addBlankKey(anim, image, group.?.*.id, 3, "x") || animation.addDuplicateKey(anim, image, group.?.*.id, 3, "x") { return 44 }
    ops.remove(image, group.?, "Remove")
    image.*.active = layer
    return 0
}

// A duplicate key shares its tiles until one of the two is painted.
fn duplicateKey(app: *App, anim: *Animation, image: *Image, layer: *Node) -> u8 {
    if !animation.addDuplicateKey(anim, image, layer.*.id, 12, "Duplicate Frame") { return 45 }
    if animation.addDuplicateKey(anim, image, layer.*.id, 12, "Duplicate Frame") { return 46 }
    const ten = keyDevice(anim, layer, 10)
    const twelve = keyDevice(anim, layer, 12)
    if @intFromPtr(ten) == @intFromPtr(twelve) || device.tileCount(twelve) != device.tileCount(ten) || device.tileCount(ten) != 2 { return 47 }
    const shared_left = device.tileRead(twelve, 0, 0)
    const shared_right = device.tileRead(twelve, 1, 0)
    if shared_left == null || shared_right == null || @intFromPtr(shared_left.?) != @intFromPtr(device.tileRead(ten, 0, 0).?) || @intFromPtr(shared_right.?) != @intFromPtr(device.tileRead(ten, 1, 0).?) { return 48 }
    // Painted at 12, only 12's tile is its own then.
    _ = animation.setTime(anim, image, 12)
    if @intFromPtr(layer.*.device.?) != @intFromPtr(twelve) || shown(image, X10, Y) != BLUE { return 49 }
    if !paint(image, layer, geom.rect(58, 10, 4, 4), YELLOW) { return 50 }
    if device.pixel(twelve, 60, 12) != YELLOW || device.pixel(ten, 60, 12) != BLUE { return 51 }
    if @intFromPtr(device.tileRead(twelve, 0, 0).?) == @intFromPtr(device.tileRead(ten, 0, 0).?) || @intFromPtr(device.tileRead(twelve, 1, 0).?) != @intFromPtr(device.tileRead(ten, 1, 0).?) { return 52 }
    api.undo(app)
    if device.pixel(twelve, 60, 12) != BLUE { return 53 }
    return 0
}

// Painting at 5 changes that frame alone; undone and redone at other
// times it is that frame that changes (and is shown).
fn paintAndUndo(app: *App, anim: *Animation, image: *Image, layer: *Node) -> u8 {
    _ = animation.setTime(anim, image, 5)
    if !paint(image, layer, geom.rect(8, 40, 12, 12), YELLOW) { return 55 }
    const zero = keyDevice(anim, layer, 0)
    const five = keyDevice(anim, layer, 5)
    const ten = keyDevice(anim, layer, 10)
    if device.pixel(five, YX, YY) != YELLOW || device.pixel(zero, YX, YY) != 0 || device.pixel(ten, YX, YY) != 0 { return 56 }
    if shown(image, YX, YY) != YELLOW { return 57 }
    _ = animation.setTime(anim, image, 3)
    if shown(image, YX, YY) != WHITE { return 58 }
    // At 0, undo: the time goes to 5 and the yellow leaves frame 5.
    _ = animation.setTime(anim, image, 0)
    api.undo(app)
    if anim.*.time != 5 || device.pixel(five, YX, YY) != 0 || device.pixel(zero, X0, Y) != RED || device.pixel(zero, YX, YY) != 0 { return 59 }
    if @intFromPtr(layer.*.device.?) != @intFromPtr(five) || shown(image, YX, YY) != WHITE || shown(image, X5, Y) != GREEN { return 60 }
    // At 10, redo: back to 5, the yellow back on it.
    _ = animation.setTime(anim, image, 10)
    api.redo(app)
    if anim.*.time != 5 || device.pixel(five, YX, YY) != YELLOW || device.pixel(ten, YX, YY) != 0 || shown(image, YX, YY) != YELLOW { return 61 }
    // And undone once more from 12, for what follows.
    _ = animation.setTime(anim, image, 12)
    api.undo(app)
    if anim.*.time != 5 || device.pixel(five, YX, YY) != 0 || device.pixel(keyDevice(anim, layer, 12), YX, YY) != 0 { return 62 }
    return 0
}

// A key taken away, undone and redone.
fn removeKeys(app: *App, anim: *Animation, image: *Image, layer: *Node) -> u8 {
    const track = animation.trackOf(anim, layer.*.id).?
    if animation.keyCount(track) != 4 { return 63 }
    if !animation.removeKey(anim, image, layer.*.id, 12, "Remove Frame") || !keyTimes(anim, layer, 0, 5, 10) { return 64 }
    if animation.removeKey(anim, image, layer.*.id, 12, "Remove Frame") || animation.removeKey(anim, image, layer.*.id, -3, "Remove Frame") { return 65 }
    if !showsAt(anim, image, 12, WHITE, WHITE, BLUE) { return 66 }
    api.undo(app)
    if animation.keyCount(track) != 4 || animation.keyTime(track, 3) != 12 { return 67 }
    api.redo(app)
    if !keyTimes(anim, layer, 0, 5, 10) { return 68 }
    return 0
}

// Holds inserted and removed move the keys after them.
fn holds(anim: *Animation, image: *Image, layer: *Node) -> u8 {
    if !animation.insertHold(anim, image, layer.*.id, 5, 2, "Insert Hold Frame") || !keyTimes(anim, layer, 0, 5, 12) { return 70 }
    if !showsAt(anim, image, 11, WHITE, GREEN, WHITE) || !showsAt(anim, image, 12, WHITE, WHITE, BLUE) { return 71 }
    // Before the first key nothing moves: keys after 0 move.
    if !animation.insertHold(anim, image, layer.*.id, 0, 1, "Insert Hold Frame") || !keyTimes(anim, layer, 0, 6, 13) { return 72 }
    if !animation.removeHold(anim, image, layer.*.id, 0, 1, "Remove Hold Frame") || !keyTimes(anim, layer, 0, 5, 12) { return 73 }
    // Only as many as lie between: 6 asked, 6 free.
    if !animation.removeHold(anim, image, layer.*.id, 5, 2, "Remove Hold Frame") || !keyTimes(anim, layer, 0, 5, 10) { return 74 }
    if animation.removeHold(anim, image, layer.*.id, 9, 1, "x") || animation.removeHold(anim, image, layer.*.id, 4, 1, "x") { return 75 }
    if animation.insertHold(anim, image, layer.*.id, 10, 1, "x") || animation.insertHold(anim, image, layer.*.id, 5, 0, "x") || animation.insertHold(anim, image, layer.*.id, 5, animation.LAST_TIME, "x") { return 76 }
    // Moved and moved back.
    if !animation.moveKey(anim, image, layer.*.id, 10, 14, "Move Frame") || !keyTimes(anim, layer, 0, 5, 14) { return 77 }
    if animation.moveKey(anim, image, layer.*.id, 9, 3, "x") || animation.moveKey(anim, image, layer.*.id, 14, -1, "x") || animation.moveKey(anim, image, layer.*.id, 14, 14, "x") { return 78 }
    if !animation.moveKey(anim, image, layer.*.id, 14, 10, "Move Frame") || !showsAt(anim, image, 10, WHITE, WHITE, BLUE) { return 79 }
    return 0
}

// What the onion skin of a key `distance` away shows of `color`.
fn tinted(anim: *Animation, color: u32, tint: u32, opacity: u32) -> u32 {
    _ = anim
    const r = pixel.lerp(pixel.red(color), pixel.red(tint), animation.TINT)
    const g = pixel.lerp(pixel.green(color), pixel.green(tint), animation.TINT)
    const b = pixel.lerp(pixel.blue(color), pixel.blue(tint), animation.TINT)
    return pixel.pack(pixel.mul(color >> 24, opacity), r, g, b)
}

fn onionSkin(anim: *Animation, image: *Image, layer: *Node) -> u8 {
    if animation.onion(anim, image) != null { return 80 }
    animation.setOnion(anim, true, 1, 1)
    image.*.active = layer
    _ = animation.setTime(anim, image, 5)
    const skin = animation.onion(anim, image)
    if skin == null { return 81 }
    const near = animation.onionOpacityOf(anim, 1, 1)
    if near != anim.*.onionOpacity || near == 0 { return 82 }
    if device.pixel(skin.?, X0, Y) != tinted(anim, RED, animation.TINT_BEFORE, near) { return 83 }
    if device.pixel(skin.?, X10, Y) != tinted(anim, BLUE, animation.TINT_AFTER, near) { return 84 }
    // Red before, green after.
    const before = device.pixel(skin.?, X0, Y)
    const after = device.pixel(skin.?, X10, Y)
    if pixel.red(before) <= pixel.green(before) || pixel.green(after) <= pixel.red(after) || pixel.green(after) <= pixel.blue(after) { return 85 }
    // The frame shown is not in it, nor is anything elsewhere.
    if device.pixel(skin.?, X5, Y) != 0 || device.pixel(skin.?, 100, 80) != 0 { return 86 }
    // The same when nothing changed.
    const again = animation.onion(anim, image)
    if again == null || @intFromPtr(again.?) != @intFromPtr(skin.?) { return 87 }
    // Two keys before at 10: the nearer stronger.
    animation.setOnion(anim, true, 2, 0)
    _ = animation.setTime(anim, image, 10)
    const two = animation.onion(anim, image)
    if two == null { return 88 }
    const far = animation.onionOpacityOf(anim, 2, 2)
    if far >= near || far == 0 { return 89 }
    if device.pixel(two.?, X5, Y) != tinted(anim, GREEN, animation.TINT_BEFORE, near) || device.pixel(two.?, X0, Y) != tinted(anim, RED, animation.TINT_BEFORE, far) || device.pixel(two.?, X10, Y) != 0 { return 90 }
    animation.setOnion(anim, false, 1, 1)
    if animation.onion(anim, image) != null { return 91 }
    // Held to its range.
    animation.setOnion(anim, false, -4, 99)
    if anim.*.before != 0 || anim.*.after != animation.ONION_MOST { return 92 }
    animation.setOnion(anim, false, 1, 1)
    return 0
}

// A second layer made animated by a duplicate key: the first key holds
// what it showed; undone, it is a layer of its own device again.
fn secondLayer(app: *App, anim: *Animation, image: *Image, layer: *Node) -> u8 {
    const second = ops.newLayer(image, node_module.PAINT, "Layer 2", "New layer")
    if second == null { return 93 }
    if !paint(image, second.?, geom.rect(90, 60, 10, 10), ORANGE) { return 94 }
    const own = second.?.*.device.?
    _ = animation.setTime(anim, image, 7)
    if !animation.addDuplicateKey(anim, image, second.?.*.id, 4, "Duplicate Frame") { return 95 }
    const track = animation.trackOf(anim, second.?.*.id)
    if track == null || animation.keyCount(track.?) != 2 || animation.keyTime(track.?, 0) != 0 || animation.keyTime(track.?, 1) != 4 { return 96 }
    // At 7 the copy shows; its tiles are the first key's.
    if @intFromPtr(second.?.*.device.?) == @intFromPtr(own) || shown(image, 95, 65) != ORANGE { return 97 }
    if !animation.removeKey(anim, image, second.?.*.id, 4, "Remove Frame") || @intFromPtr(second.?.*.device.?) != @intFromPtr(own) { return 98 }
    if animation.removeKey(anim, image, second.?.*.id, 0, "Remove Frame") { return 99 }
    api.undo(app)
    api.undo(app)
    if animation.isAnimated(anim, second.?.*.id) || @intFromPtr(second.?.*.device.?) != @intFromPtr(own) || shown(image, 95, 65) != ORANGE { return 100 }
    api.redo(app)
    if !animation.isAnimated(anim, second.?.*.id) || animation.keyCount(animation.trackOf(anim, second.?.*.id).?) != 2 || shown(image, 95, 65) != ORANGE { return 101 }
    // The first layer is as it was.
    if !showsAt(anim, image, 7, WHITE, GREEN, WHITE) { return 102 }
    // Taken out of the image at 7, brought back by undo at 0: it shows
    // the frame of 7 until it is synchronized, then the first key's.
    const copy = second.?.*.device.?
    ops.remove(image, second.?, "Remove layer")
    _ = animation.setTime(anim, image, 0)
    api.undo(app)
    if !node_module.isUnder(second.?, image.*.root) || @intFromPtr(second.?.*.device.?) != @intFromPtr(copy) { return 103 }
    if geom.isEmpty(animation.sync(anim, image)) || @intFromPtr(second.?.*.device.?) != @intFromPtr(own) || !geom.isEmpty(animation.sync(anim, image)) { return 104 }
    // And it goes again (a layer the docker lists apart from it).
    api.redo(app)
    if node_module.isUnder(second.?, image.*.root) { return 116 }
    image.*.active = layer
    if !showsAt(anim, image, 3, RED, WHITE, WHITE) { return 117 }
    return 0
}

fn checkFile(app: *App, number: usize, at: i32, color: u32, blank0: bool) -> bool {
    var name: [64]u8 = undefined
    const bytes: [*]u8 = &name
    const length = animation.sequenceName("frames/walk", number, bytes, 64)
    if length == 0 { return false }
    var contents: io_text.Contents = undefined
    if io_text.readFile(app.*.allocator, bytes[0..length], &contents) != io_text.FileStatus.ok { return false }
    var picture: io_png.Picture = undefined
    const status = io_png.decode(contents.bytes[0..contents.length], app.*.allocator, &picture)
    io_text.freeFile(&contents)
    if status != io_png.Status.ok { return false }
    var good = picture.width == 120 && picture.height == 90
    if good {
        good = picture.pixels[@intCast(usize, Y) * 120 + @intCast(usize, at)] == color && picture.pixels[80 * 120 + 100] == WHITE
        if blank0 && picture.pixels[@intCast(usize, Y) * 120 + @intCast(usize, X0)] != WHITE { good = false }
    }
    io_png.free(&picture)
    return good
}

// The frames 0 to 10 as PNG files.
fn exportFrames(app: *App, anim: *Animation, image: *Image) -> u8 {
    var name: [64]u8 = undefined
    const bytes: [*]u8 = &name
    var length = animation.sequenceName("walk", 7, bytes, 64)
    if !std.text.same(bytes[0..length], "walk_0007.png") { return 105 }
    length = animation.sequenceName("a", 12345, bytes, 64)
    if !std.text.same(bytes[0..length], "a_12345.png") || animation.sequenceName("long-name", 1, bytes, 10) != 0 { return 106 }
    if !std.fs.makeDir("frames\x00".pointer, 493) { return 107 }
    _ = animation.setTime(anim, image, 17)
    var written: usize = 0
    if animation.exportSequence(anim, image, "frames/walk", 0, 10, &written) != animation.Export.ok || written != 11 { return 108 }
    if anim.*.time != 17 { return 109 }
    var number: usize = 1
    while number <= 11 {
        const time = @intCast(i32, number) - 1
        var ok = false
        if time < 5 {
            ok = checkFile(app, number, X0, RED, false)
        } else if time < 10 {
            ok = checkFile(app, number, X5, GREEN, true)
        } else {
            ok = checkFile(app, number, X10, BLUE, true)
        }
        if !ok { return 110 }
        number += 1
    }
    if std.fs.exists("frames/walk_0012.png\x00".pointer) || std.fs.exists("frames/walk_0000.png\x00".pointer) { return 111 }
    if animation.exportSequence(anim, image, "frames/x", 5, 2, &written) != animation.Export.badRange || written != 0 { return 112 }
    if animation.exportSequence(anim, image, "frames/x", -1, 2, &written) != animation.Export.badRange { return 114 }
    if animation.exportSequence(anim, image, "no-such-folder/x", 0, 0, &written) != animation.Export.cannotWrite || anim.*.time != 17 { return 115 }
    return 0
}

// ---------------------------------------------------------------------------
// The docker

fn inside(part: ui.Rect, whole: ui.Rect) -> bool {
    return part.x >= whole.x && part.y >= whole.y && ui.right(part) <= ui.right(whole) && ui.bottom(part) <= ui.bottom(whole)
}

// Everything of the docker inside its content and nothing over another.
fn laidOut(app: *App) -> bool {
    const content = docks.contentOf(app, timeline.ID)
    if ui.isEmpty(content) { return false }
    var parts: [24]ui.Rect = undefined
    if timeline.BUTTONS + timeline.FIELDS > 24 { return false }
    var count: usize = 0
    var index: usize = 0
    while index < timeline.BUTTONS {
        parts[count] = timeline.buttonArea(app, index)
        count += 1
        index += 1
    }
    index = 0
    while index < timeline.FIELDS {
        parts[count] = timeline.fieldArea(app, index)
        count += 1
        index += 1
    }
    index = 0
    while index < count {
        if ui.isEmpty(parts[index]) || !inside(parts[index], content) { return false }
        var other = index + 1
        while other < count {
            if !ui.isEmpty(ui.intersect(parts[index], parts[other])) { return false }
            other += 1
        }
        index += 1
    }
    const ruler = timeline.rulerArea(app)
    return !ui.isEmpty(ruler) && inside(ruler, content)
}

fn docker(app: *App, anim: *Animation, image: *Image, layer: *Node) -> u8 {
    if !docks.read(app, "area left 280\narea right 480\npanel 400 0 open layers\npanel 600 0 open timeline\n") { return 120 }
    _ = animation.setTime(anim, image, 0)
    if !script.run(app, "size 1280 800\npointer 5 5\n") { return 121 }
    if !laidOut(app) || timeline.rowCount(app) != 1 || timeline.rowNode(app, 0) != layer.*.id { return 122 }
    // A click on frame 3 of the row shows time 3.
    if !clickIn(app, timeline.cellArea(app, 0, 3)) || anim.*.time != 3 { return 123 }
    // The ruler: a click on 8 shows 8.
    const ruler = timeline.rulerArea(app)
    const width = timeline.frameWidth(app)
    if !click(app, ruler.x + (8 - timeline.firstFrame(app)) * width + width / 2, ruler.y + ruler.height / 2) || anim.*.time != 8 { return 124 }
    // The transport.
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_NEXT)) || anim.*.time != 9 { return 125 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_LAST)) || anim.*.time != 23 { return 126 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_PREVIOUS)) || anim.*.time != 22 { return 127 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_FIRST)) || anim.*.time != 0 { return 128 }
    // A double click on frame 15 makes a key there; Ctrl+Z takes it away.
    const track = animation.trackOf(anim, layer.*.id).?
    const cell = timeline.cellArea(app, 0, 15)
    if ui.isEmpty(cell) { return 129 }
    if !click(app, cell.x + cell.width / 2, cell.y + cell.height / 2) || !click(app, cell.x + cell.width / 2, cell.y + cell.height / 2) { return 130 }
    var index: usize = 0
    if anim.*.time != 15 || animation.keyCount(track) != 4 || !animation.keyIndexAt(track, 15, &index) { return 131 }
    if !script.run(app, "key Ctrl+Z\n") || animation.keyCount(track) != 3 || animation.keyIndexAt(track, 15, &index) { return 132 }
    // A key dragged from 10 to 13, and back by undo.
    const from = timeline.cellArea(app, 0, 10)
    const to = timeline.cellArea(app, 0, 13)
    if ui.isEmpty(from) || ui.isEmpty(to) { return 133 }
    if !drag(app, from.x + from.width / 2, from.y + from.height / 2, to.x + to.width / 2, to.y + to.height / 2) { return 134 }
    if !keyTimes(anim, layer, 0, 5, 13) || anim.*.time != 13 { return 135 }
    if !script.run(app, "key Ctrl+Z\n") || !keyTimes(anim, layer, 0, 5, 10) { return 136 }
    // Keys over the docker.
    const content = docks.contentOf(app, timeline.ID)
    if !point(app, "pointer", content.x + content.width / 2, ui.bottom(content) - 4) { return 137 }
    _ = animation.setTime(anim, image, 4)
    if !script.run(app, "key Right\n") || anim.*.time != 5 { return 138 }
    if !script.run(app, "key Shift+Right\n") || anim.*.time != 10 { return 139 }
    if !script.run(app, "key Shift+Left\nkey Shift+Left\n") || anim.*.time != 0 { return 140 }
    if !script.run(app, "key End\n") || anim.*.time != 23 { return 141 }
    if !script.run(app, "key Home\n") || anim.*.time != 0 { return 142 }
    // The keys of the active layer by the buttons: an empty frame at 3,
    // taken away again.
    _ = animation.setTime(anim, image, 3)
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_BLANK)) || animation.keyCount(track) != 4 || !animation.isBlankKey(track, 1) { return 143 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_REMOVE)) || animation.keyCount(track) != 3 { return 144 }
    // The frame rate typed.
    if !clickIn(app, timeline.fieldArea(app, timeline.FIELD_FPS)) || !script.run(app, "key Ctrl+A\ntype 12\nkey Enter\n") || anim.*.fps != 12 { return 145 }
    animation.setRate(anim, 24)
    // Zoom: wider and narrower frames.
    if timeline.frameWidth(app) != 12 || !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_ZOOM_IN)) || timeline.frameWidth(app) != 16 { return 146 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_ZOOM_OUT)) || !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_ZOOM_OUT)) || timeline.frameWidth(app) != 10 { return 147 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_ZOOM_IN)) || timeline.frameWidth(app) != 12 { return 148 }
    // The wheel over the ruler moves the frames sideways (four a notch),
    // the bar under them back.
    if timeline.firstFrame(app) != 0 || !point(app, "pointer", ruler.x + 20, ruler.y + 5) || !script.run(app, "wheel 2\n") || timeline.firstFrame(app) != 8 { return 149 }
    const bar = timeline.barArea(app)
    const bar_y = bar.y + bar.height / 2
    if ui.isEmpty(bar) || !click(app, bar.x + 2, bar_y) || timeline.firstFrame(app) != 0 { return 118 }
    if !click(app, ui.right(bar) - 2, bar_y) || timeline.firstFrame(app) <= 0 { return 119 }
    if !click(app, bar.x + 2, bar_y) || timeline.firstFrame(app) != 0 { return 189 }
    if !drag(app, bar.x + 5, bar_y, bar.x + 105, bar_y) || timeline.firstFrame(app) <= 0 { return 190 }
    if !click(app, bar.x + 2, bar_y) || timeline.firstFrame(app) != 0 { return 191 }
    // The clip exported beside the image's file; without one the status
    // bar says to save first.
    image_module.setPath(image, "")
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_EXPORT)) || !std.text.contains(api.noteOf(app), "Save") { return 195 }
    image_module.setPath(image, "frames/clip.kra")
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_EXPORT)) || !std.text.contains(api.noteOf(app), "24 frames") { return 196 }
    if !std.fs.exists("frames/clip_0001.png\x00".pointer) || !std.fs.exists("frames/clip_0024.png\x00".pointer) || std.fs.exists("frames/clip_0025.png\x00".pointer) { return 197 }
    image_module.setPath(image, "")
    return 0
}

// Playing: a frame every 1/24 second as the clock goes; paused, the time
// stays.
fn playing(app: *App, anim: *Animation, image: *Image) -> u8 {
    _ = animation.setTime(anim, image, 0)
    if !script.run(app, "wait 50\n") { return 150 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_PLAY)) || !anim.*.playing { return 151 }
    const begun = anim.*.time
    if !script.run(app, "wait 250\n") { return 152 }
    // 250 ms: 6 frames (one either way for the click's own frame).
    if anim.*.time < begun + 5 || anim.*.time > begun + 7 { return 153 }
    if !script.run(app, "wait 1000\n") { return 154 }
    // Round the clip: 24 frames a second come back near where they were.
    if anim.*.time > anim.*.end { return 155 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_PLAY)) || anim.*.playing { return 156 }
    const stopped = anim.*.time
    if !script.run(app, "wait 400\n") || anim.*.time != stopped { return 157 }
    // The playing time by the clock alone.
    animation.setRange(anim, 0, 9)
    _ = animation.setTime(anim, image, 8)
    animation.play(anim, 1000)
    if animation.playedTime(anim, 1000) != 8 || animation.playedTime(anim, 1041) != 8 || animation.playedTime(anim, 1042) != 9 || animation.playedTime(anim, 1084) != 0 || animation.playedTime(anim, 1000 + 1000) != 2 { return 158 }
    if animation.untilNext(anim, 1000) != 42 || animation.untilNext(anim, 1042) != 42 { return 159 }
    animation.pause(anim)
    animation.setRange(anim, 0, 23)
    if anim.*.end != 23 { return 160 }
    animation.setRange(anim, 30, 5)
    if anim.*.start != 30 || anim.*.end != 30 { return 161 }
    animation.setRange(anim, 0, 23)
    return 0
}

// The onion skin over the canvas, the pictures, and the window at 1024.
fn pictures(app: *App, anim: *Animation, image: *Image, layer: *Node) -> u8 {
    const doc = api.document(app).?
    _ = animation.setTime(anim, image, 5)
    if !save(app, "timeline.png") { return 165 }
    // Where image place (X0, Y) is in the window.
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(&doc.*.view, @floatFromInt(f64, X0) + 0.5, @floatFromInt(f64, Y) + 0.5, &wx, &wy)
    const x = @intFromFloat(i32, wx)
    const y = @intFromFloat(i32, wy)
    const frame = script.frameOf(app).?
    if x < 0 || y < 0 || @intCast(usize, x) >= frame.*.width || @intCast(usize, y) >= frame.*.height { return 166 }
    const plain = frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)]
    if plain & 0xFFFFFF != 0xFFFFFF { return 167 }
    // With the onion skin on, the white there is tinted red.
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_ONION)) || !anim.*.onionOn { return 168 }
    if !save(app, "timeline-onion.png") { return 169 }
    const skin = frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)]
    if pixel.red(skin) <= pixel.green(skin) + 40 || pixel.red(skin) <= pixel.blue(skin) + 40 { return 170 }
    if !clickIn(app, timeline.buttonArea(app, timeline.BUTTON_ONION)) || anim.*.onionOn { return 171 }
    if !save(app, "timeline-plain.png") { return 172 }
    if frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)] != plain { return 173 }
    // At 1024 x 768 all of it in the docker.
    if !script.run(app, "size 1024 768\npointer 5 5\n") || !laidOut(app) { return 174 }
    if !save(app, "timeline-1024.png") { return 175 }
    // A third layer, animated, above: two rows; the docker narrow, at the
    // left.
    const third = ops.newLayer(image, node_module.PAINT, "Layer 3", "New layer")
    if third == null || !paint(image, third.?, geom.rect(84, 50, 24, 24), ORANGE) { return 178 }
    if !animation.addBlankKey(anim, image, third.?.*.id, 0, "New Frame") || !animation.addBlankKey(anim, image, third.?.*.id, 8, "New Frame") || !animation.addDuplicateKey(anim, image, third.?.*.id, 16, "Duplicate Frame") { return 179 }
    image.*.active = layer
    if !docks.read(app, "area right 280\narea left 280\npanel 600 0 open timeline\npanel 400 0 open layers\n") || !script.run(app, "size 1024 768\npointer 5 5\n") { return 181 }
    if !laidOut(app) || timeline.rowCount(app) != 2 || timeline.rowNode(app, 0) != third.?.*.id || timeline.rowNode(app, 1) != layer.*.id { return 182 }
    if !save(app, "timeline-narrow.png") { return 183 }
    if !docks.read(app, "area left 280\narea right 480\npanel 400 0 open layers\npanel 600 0 open timeline\n") { return 184 }
    settings.get(app).*.theme = settings.THEME_LIGHT
    if !script.run(app, "size 1280 800\n") || !save(app, "timeline-light.png") { return 176 }
    settings.get(app).*.theme = settings.THEME_DARK
    if !script.run(app, "german\n") || !save(app, "timeline-german.png") || !laidOut(app) { return 177 }
    app.*.german = false
    return 0
}

// Times shown again and again leave the value arena as it was.
fn steady(anim: *Animation, image: *Image) -> u8 {
    animation.setOnion(anim, true, 2, 2)
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: i32 = 0
    while round < 200 {
        _ = animation.setTime(anim, image, round % 14)
        _ = render.update(image)
        _ = animation.onion(anim, image)
        round += 1
    }
    const grown = turns.used(arena) - before
    animation.setOnion(anim, false, 1, 1)
    if grown > 65536 { return 180 }
    return 0
}

// An image animated, painted, its keys changed, undone and redone, then
// ended with its record (`early`: the record first, else the image first).
fn round(allocator: std.allocator.Allocator, early: bool) -> bool {
    const made = image_module.create(allocator, 100, 80, 72.0)
    if made == null { return false }
    const image = made.?
    const layer = ops.newLayer(image, node_module.PAINT, "L", "New layer")
    const anim = animation.make(image)
    if layer == null || anim == null { return false }
    const id = layer.?.*.id
    var good = animation.addBlankKey(anim.?, image, id, 0, "k") && paint(image, layer.?, geom.rect(0, 0, 70, 10), RED)
    good = good && animation.addBlankKey(anim.?, image, id, 5, "k")
    _ = animation.setTime(anim.?, image, 5)
    good = good && paint(image, layer.?, geom.rect(10, 10, 70, 10), GREEN) && animation.addDuplicateKey(anim.?, image, id, 8, "k")
    _ = animation.setTime(anim.?, image, 8)
    good = good && paint(image, layer.?, geom.rect(20, 20, 70, 10), BLUE) && animation.removeKey(anim.?, image, id, 5, "k")
    _ = history.undo(image.*.history, image)
    _ = history.undo(image.*.history, image)
    _ = history.redo(image.*.history, image)
    good = good && animation.moveKey(anim.?, image, id, 8, 12, "k") && animation.insertHold(anim.?, image, id, 0, 3, "k")
    animation.setOnion(anim.?, true, 2, 2)
    _ = animation.setTime(anim.?, image, 8)
    good = good && animation.onion(anim.?, image) != null
    _ = history.undo(image.*.history, image)
    _ = animation.setTime(anim.?, image, 0)
    const number = image.*.number
    if early { animation.release(image) }
    image_module.destroy(image)
    if !early { animation.releaseNumber(number) }
    return good
}

// What all that takes is given back: the heap holds what it held before.
fn balanced(allocator: std.allocator.Allocator) -> u8 {
    if !round(allocator, true) || !round(allocator, false) { return 192 }
    const before = std.heap.liveBytes()
    var index: usize = 0
    while index < 3 {
        if !round(allocator, index % 2 == 0) { return 193 }
        index += 1
    }
    if std.heap.liveBytes() != before { return 194 }
    return 0
}

// A document closed: its record goes with it.
fn closing(app: *App) -> u8 {
    const doc = api.document(app).?
    const number = doc.*.image.*.number
    canvasview.forget(app, doc)
    documents.close(app, app.*.current)
    if !script.run(app, "new 64 48\npointer 5 5\n") { return 185 }
    var index: usize = 0
    while index < animation.recordSlots() {
        if animation.recordNumber(index) == number { return 186 }
        index += 1
    }
    if animation.find(api.image(app).?) == null { return 187 }
    animation.release(api.image(app).?)
    if animation.find(api.image(app).?) != null { return 188 }
    return 0
}

// ---------------------------------------------------------------------------
// Edges, each on an image of its own

const Allocator = std.allocator.Allocator

// A colour of part alpha, and one of none.
const HALF: u32 = 0x64FF8000
const CLEAR: u32 = 0x00FF0000

// A name longer than any exportSequence() makes.
var longName: [1200]u8 = undefined

// An image of `width` x `height` with one paint layer (the active one)
// and its animation record; null when any of it fails.
fn fresh(allocator: Allocator, width: i32, height: i32) -> ?*Image {
    const made = image_module.create(allocator, width, height, 72.0)
    if made == null { return null }
    if ops.newLayer(made.?, node_module.PAINT, "Layer", "New layer") == null || animation.make(made.?) == null {
        image_module.destroy(made.?)
        return null
    }
    return made
}

fn finish(image: *Image) -> void {
    animation.release(image)
    image_module.destroy(image)
}

fn same(a: *device.Device, b: *device.Device) -> bool { return @intFromPtr(a) == @intFromPtr(b) }

// A layer something is under way on (a change open on its device, a
// stroke's overlay, a preview's substitute) keeps its frame when the time
// moves; sync() puts the right one in once it is over, and what was
// changed meanwhile belongs to the frame it was changed on. An exchange
// moves the image's revision on (the layers' pictures), no other time
// does, and none makes the image modified.
fn pendingSwap(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 100, 80)
    if made == null { return 198 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    if !animation.addBlankKey(anim, image, id, 0, "k") || !paint(image, layer, geom.rect(10, 10, 8, 8), RED) || !animation.addBlankKey(anim, image, id, 5, "k") { return 198 }
    const track = animation.trackOf(anim, id).?
    const zero = animation.deviceAt(track, 0)
    const five = animation.deviceAt(track, 5)
    const revision = image.*.revision
    // A change open on frame 0: the time moves, the frame stays.
    device.begin(zero)
    device.setPixel(zero, 30, 30, BLUE)
    _ = animation.setTime(anim, image, 5)
    if anim.*.time != 5 || !anim.*.pending || !same(layer.*.device.?, zero) || image.*.revision != revision { return 199 }
    if !geom.isEmpty(animation.sync(anim, image)) || !anim.*.pending || !same(layer.*.device.?, zero) { return 199 }
    const change = device.commit(zero)
    if change == null { return 199 }
    history.pixels(image.*.history, "Dot", id, change.?)
    image.*.modified = false
    if geom.isEmpty(animation.sync(anim, image)) || anim.*.pending || !same(layer.*.device.?, five) || image.*.revision == revision || image.*.modified { return 200 }
    // The dot was frame 0's: undone at 5, the time goes to 0 and the dot
    // leaves frame 0 alone.
    _ = history.undo(image.*.history, image)
    if anim.*.time != 0 || device.pixel(zero, 30, 30) != 0 || device.pixel(zero, 12, 12) != RED || !same(layer.*.device.?, zero) || device.pixel(five, 30, 30) != 0 { return 200 }
    // A stroke's overlay, then a preview's substitute: the same.
    const extra = device.create(allocator, 0)
    if extra == null { return 201 }
    layer.*.overlay = extra
    _ = animation.setTime(anim, image, 5)
    if !anim.*.pending || !same(layer.*.device.?, zero) { return 201 }
    layer.*.overlay = null
    layer.*.substitute = extra
    if !geom.isEmpty(animation.sync(anim, image)) || !anim.*.pending || !same(layer.*.device.?, zero) { return 201 }
    layer.*.substitute = null
    if geom.isEmpty(animation.sync(anim, image)) || anim.*.pending || !same(layer.*.device.?, five) { return 201 }
    device.destroy(extra.?)
    // Another time showing the same frame: no exchange, the revision stays.
    const kept = image.*.revision
    image.*.modified = false
    _ = animation.setTime(anim, image, 7)
    if image.*.revision != kept || anim.*.time != 7 || image.*.modified { return 201 }
    finish(image)
    return 0
}

// Frames moved with device.moveTo below zero and off the tiles' grid,
// painted across tile borders, colours of no alpha and of part alpha:
// the image and the onion skin show each where it is, and the nearer key
// lies over the farther one.
fn movedFrames(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 100, 80)
    if made == null { return 202 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    // Frame 0 red across the tiles at -64, 0 and 64; frame 5 green over a
    // part of it; frame 10 nothing seen and something half seen.
    if !animation.addBlankKey(anim, image, id, 0, "k") || !paint(image, layer, geom.rect(-70, -3, 140, 10), RED) { return 202 }
    if !animation.addBlankKey(anim, image, id, 5, "k") { return 202 }
    _ = animation.setTime(anim, image, 5)
    if !paint(image, layer, geom.rect(-30, 0, 20, 20), GREEN) || !animation.addBlankKey(anim, image, id, 10, "k") { return 202 }
    _ = animation.setTime(anim, image, 10)
    if !paint(image, layer, geom.rect(50, 50, 10, 10), CLEAR) || !paint(image, layer, geom.rect(60, 50, 10, 10), HALF) { return 202 }
    const track = animation.trackOf(anim, id).?
    // Frame 0 at (-30, 17): its red is (-100, 14) to (40, 24) now; frame 5
    // at (33, 3): its green (3, 3) to (23, 23).
    device.moveTo(animation.deviceAt(track, 0), -30, 17)
    device.moveTo(animation.deviceAt(track, 5), 33, 3)
    _ = animation.setTime(anim, image, 0)
    if shown(image, 0, 14) != RED || shown(image, 39, 23) != RED || shown(image, 0, 13) != 0 || shown(image, 40, 23) != 0 || shown(image, 0, 24) != 0 { return 202 }
    // The onion skin at 5: frame 0 red-tinted, frame 10 green-tinted, 5
    // itself not.
    image.*.active = layer
    animation.setOnion(anim, true, 1, 1)
    _ = animation.setTime(anim, image, 5)
    const skin = animation.onion(anim, image)
    if skin == null { return 203 }
    const near = animation.onionOpacityOf(anim, 1, 1)
    const red_near = tinted(anim, RED, animation.TINT_BEFORE, near)
    // (Frame 0's tiles begin at -94, -30 and 34 now.)
    if device.pixel(skin.?, -100, 14) != red_near || device.pixel(skin.?, 39, 23) != red_near || device.pixel(skin.?, -95, 20) != red_near || device.pixel(skin.?, -94, 20) != red_near { return 203 }
    if device.pixel(skin.?, -31, 20) != red_near || device.pixel(skin.?, -30, 20) != red_near || device.pixel(skin.?, 33, 20) != red_near || device.pixel(skin.?, 34, 20) != red_near { return 203 }
    if device.pixel(skin.?, -101, 14) != 0 || device.pixel(skin.?, -100, 13) != 0 || device.pixel(skin.?, 40, 23) != 0 || device.pixel(skin.?, -100, 24) != 0 { return 203 }
    if device.pixel(skin.?, 55, 55) != 0 || device.pixel(skin.?, 65, 55) != tinted(anim, HALF, animation.TINT_AFTER, near) || pixel.alpha(device.pixel(skin.?, 65, 55)) != pixel.mul(0x64, near) { return 204 }
    if device.pixel(skin.?, 10, 5) != 0 { return 204 }
    // Two keys before at 10: the green (nearer) over the red (farther)
    // where they meet; each alone elsewhere.
    animation.setOnion(anim, true, 2, 0)
    _ = animation.setTime(anim, image, 10)
    const two = animation.onion(anim, image)
    if two == null { return 205 }
    const far = animation.onionOpacityOf(anim, 2, 2)
    const red_far = tinted(anim, RED, animation.TINT_BEFORE, far)
    const green_near = tinted(anim, GREEN, animation.TINT_BEFORE, near)
    const both = pixel.over(red_far, green_near, 255)
    if both == pixel.over(green_near, red_far, 255) || device.pixel(two.?, 10, 20) != both || device.pixel(two.?, 10, 5) != green_near || device.pixel(two.?, -50, 15) != red_far || device.pixel(two.?, 65, 55) != 0 { return 205 }
    finish(image)
    return 0
}

// insertHold() and removeHold() undo each other for any time and count;
// keys at the end of time.
fn holdsInverse(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 64, 64)
    if made == null { return 206 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    var times: [4]i32 = undefined
    times[0] = 0
    times[1] = 5
    times[2] = 10
    times[3] = 30
    var index: usize = 0
    while index < 4 {
        if !animation.addBlankKey(anim, image, id, times[index], "k") { return 206 }
        index += 1
    }
    const track = animation.trackOf(anim, id).?
    var at: [6]i32 = undefined
    at[0] = 0
    at[1] = 3
    at[2] = 5
    at[3] = 9
    at[4] = 10
    at[5] = 29
    var which: usize = 0
    while which < 6 {
        var count: i32 = 1
        while count <= 7 {
            const time = at[which]
            if !animation.insertHold(anim, image, id, time, count, "Insert") || animation.keyCount(track) != 4 { return 206 }
            index = 0
            while index < 4 {
                const wanted = if times[index] > time { times[index] + count } else { times[index] }
                if animation.keyTime(track, index) != wanted { return 206 }
                index += 1
            }
            if !animation.removeHold(anim, image, id, time, count, "Remove") { return 207 }
            index = 0
            while index < 4 {
                if animation.keyTime(track, index) != times[index] { return 207 }
                index += 1
            }
            // Both undone: as before too.
            _ = history.undo(image.*.history, image)
            _ = history.undo(image.*.history, image)
            index = 0
            while index < 4 {
                if animation.keyTime(track, index) != times[index] { return 207 }
                index += 1
            }
            count += 3
        }
        which += 1
    }
    // At the end of time: the last key one before LAST_TIME can go one on,
    // not two; a key at LAST_TIME itself is shown there.
    if !animation.moveKey(anim, image, id, 30, animation.LAST_TIME - 1, "Move") || animation.insertHold(anim, image, id, 10, 2, "x") { return 208 }
    if !animation.insertHold(anim, image, id, 10, 1, "x") || animation.keyTime(track, 3) != animation.LAST_TIME || animation.insertHold(anim, image, id, 10, 1, "x") { return 208 }
    if !animation.removeHold(anim, image, id, 10, 1, "x") || !animation.addBlankKey(anim, image, id, animation.LAST_TIME, "k") || animation.keyCount(track) != 5 { return 208 }
    _ = animation.setTime(anim, image, animation.LAST_TIME)
    if !same(layer.*.device.?, animation.deviceAt(track, animation.LAST_TIME)) || animation.shownIndex(track, animation.LAST_TIME) != 4 || animation.lastKeyTime(anim) != animation.LAST_TIME { return 208 }
    finish(image)
    return 0
}

// The first key of a layer when the clip starts later; a key asked for
// twice at one time; make() and release() twice.
fn firstKeys(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 64, 64)
    if made == null { return 209 }
    const image = made.?
    const a = image.*.active.?
    const anim = animation.find(image).?
    animation.setRange(anim, 10, 30)
    if !paint(image, a, geom.rect(0, 0, 8, 8), RED) { return 209 }
    const own = a.*.device.?
    // Before the clip: the content is the key, at 4, and nothing else.
    if !animation.addBlankKey(anim, image, a.*.id, 4, "k") || animation.keyCount(animation.trackOf(anim, a.*.id).?) != 1 || animation.keyTime(animation.trackOf(anim, a.*.id).?, 0) != 4 || !same(a.*.device.?, own) { return 209 }
    _ = history.undo(image.*.history, image)
    if animation.isAnimated(anim, a.*.id) || !same(a.*.device.?, own) { return 209 }
    // Inside it: the content at the clip's start, the empty frame at 20.
    if !animation.addBlankKey(anim, image, a.*.id, 20, "k") { return 210 }
    const track = animation.trackOf(anim, a.*.id).?
    if animation.keyCount(track) != 2 || animation.keyTime(track, 0) != 10 || animation.keyTime(track, 1) != 20 || !same(a.*.device.?, own) { return 210 }
    _ = animation.setTime(anim, image, 25)
    const blank = animation.deviceAt(track, 20)
    if !same(a.*.device.?, blank) || device.tileCount(blank) != 0 { return 210 }
    // Asked again at 20: another empty frame gives the first way; undone,
    // the first is back and shown.
    if !animation.addBlankKey(anim, image, a.*.id, 20, "k") || animation.keyCount(track) != 2 || same(animation.deviceAt(track, 20), blank) || !same(a.*.device.?, animation.deviceAt(track, 20)) { return 211 }
    _ = history.undo(image.*.history, image)
    if animation.keyCount(track) != 2 || !same(animation.deviceAt(track, 20), blank) || !same(a.*.device.?, blank) { return 211 }
    // A copy asked for on layers not animated yet: at the clip's start it
    // is the content alone; later a copy sharing the content's tiles.
    const b = ops.newLayer(image, node_module.PAINT, "B", "New layer")
    if b == null || !paint(image, b.?, geom.rect(0, 0, 8, 8), GREEN) || !animation.addDuplicateKey(anim, image, b.?.*.id, 10, "k") { return 212 }
    if animation.keyCount(animation.trackOf(anim, b.?.*.id).?) != 1 || animation.addDuplicateKey(anim, image, b.?.*.id, 10, "k") { return 212 }
    const c = ops.newLayer(image, node_module.PAINT, "C", "New layer")
    if c == null || !paint(image, c.?, geom.rect(0, 0, 8, 8), BLUE) { return 212 }
    const content = c.?.*.device.?
    if !animation.addDuplicateKey(anim, image, c.?.*.id, 15, "k") { return 212 }
    const copied = animation.trackOf(anim, c.?.*.id).?
    if animation.keyCount(copied) != 2 || animation.keyTime(copied, 0) != 10 || animation.keyTime(copied, 1) != 15 || !same(animation.deviceAt(copied, 10), content) { return 212 }
    if same(c.?.*.device.?, content) || @intFromPtr(device.tileRead(c.?.*.device.?, 0, 0).?) != @intFromPtr(device.tileRead(content, 0, 0).?) || shown(image, 3, 3) != BLUE { return 212 }
    // The record is made once; released twice, it is gone once.
    if @intFromPtr(animation.make(image).?) != @intFromPtr(anim) { return 213 }
    const slots = animation.recordSlots()
    animation.release(image)
    animation.release(image)
    if animation.find(image) != null || animation.recordSlots() != slots { return 213 }
    image_module.destroy(image)
    return 0
}

// The clock: a frame due exactly when the arithmetic says, at every
// millisecond of three seconds for several rates, and after a very long
// time too.
fn playClock(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 1, 1)
    if made == null { return 214 }
    const image = made.?
    const anim = animation.find(image).?
    animation.setRange(anim, 0, 9)
    _ = animation.setTime(anim, image, 3)
    animation.play(anim, 0)
    // 10^18 milliseconds are 10^15 seconds: 24 * 10^15 frames, a whole
    // number of rounds of ten.
    const long: usize = 1000000000000000000
    if animation.playedTime(anim, long) != 3 || animation.playedTime(anim, long + 41) != 3 || animation.playedTime(anim, long + 42) != 4 { return 214 }
    if animation.untilNext(anim, long) != 42 || animation.untilNext(anim, long + 41) != 1 || animation.untilNext(anim, long + 42) != 42 { return 214 }
    animation.setRange(anim, 0, animation.LAST_TIME)
    _ = animation.setTime(anim, image, 0)
    var rates: [6]i32 = undefined
    rates[0] = 1
    rates[1] = 7
    rates[2] = 24
    rates[3] = 25
    rates[4] = 60
    rates[5] = 120
    var which: usize = 0
    while which < 6 {
        animation.setRate(anim, rates[which])
        animation.play(anim, 5000)
        const fps = @intCast(usize, rates[which])
        var elapsed: usize = 0
        while elapsed < 3000 {
            const now = 5000 + elapsed
            const time = animation.playedTime(anim, now)
            if time != @intCast(i32, elapsed * fps / 1000) { return 215 }
            const wait = animation.untilNext(anim, now)
            if wait < 1 || animation.playedTime(anim, now + wait) != time + 1 || animation.playedTime(anim, now + wait - 1) != time { return 215 }
            elapsed += 1
        }
        which += 1
    }
    animation.pause(anim)
    if animation.playedTime(anim, 99999) != anim.*.time { return 215 }
    finish(image)
    return 0
}

// sequenceName() exactly at its capacity, and with few and many digits.
fn sequenceNames() -> u8 {
    var name: [64]u8 = undefined
    const bytes: [*]u8 = &name
    // "walk_0007.png" is 13 bytes.
    if animation.sequenceName("walk", 7, bytes, 13) != 13 || !std.text.same(bytes[0..13], "walk_0007.png") || animation.sequenceName("walk", 7, bytes, 12) != 0 { return 216 }
    var length = animation.sequenceName("x", 0, bytes, 64)
    if !std.text.same(bytes[0..length], "x_0000.png") || animation.sequenceName("x", 0, bytes, 0) != 0 { return 216 }
    length = animation.sequenceName("", 99999, bytes, 64)
    if !std.text.same(bytes[0..length], "_99999.png") { return 216 }
    length = animation.sequenceName("x", 123456789, bytes, 64)
    if !std.text.same(bytes[0..length], "x_123456789.png") || animation.sequenceName("x", 123456789, bytes, 14) != 0 { return 216 }
    return 0
}

// What a file of the sequence shows at (x, y); 1 when it is not a PNG of
// `width` x `height`.
fn fileShows(allocator: Allocator, path: []const u8, width: usize, height: usize, x: usize, y: usize) -> u32 {
    var contents: io_text.Contents = undefined
    if io_text.readFile(allocator, path, &contents) != io_text.FileStatus.ok { return 1 }
    var picture: io_png.Picture = undefined
    const status = io_png.decode(contents.bytes[0..contents.length], allocator, &picture)
    io_text.freeFile(&contents)
    if status != io_png.Status.ok { return 1 }
    var value: u32 = 1
    if picture.width == width && picture.height == height { value = picture.pixels[y * width + x] }
    io_png.free(&picture)
    return value
}

// An image of one pixel, its two frames exported (what lies outside it
// not); a name too long refused; a frame at the end of time exported as
// the first of its range.
fn tinyImage(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 1, 1)
    if made == null { return 217 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    if !animation.addBlankKey(anim, image, id, 0, "k") || !paint(image, layer, geom.rect(-5, -5, 6, 6), RED) || !animation.addBlankKey(anim, image, id, 1, "k") { return 217 }
    _ = animation.setTime(anim, image, 1)
    if !paint(image, layer, geom.rect(0, 0, 1, 1), HALF) || !animation.addDuplicateKey(anim, image, id, animation.LAST_TIME, "k") { return 217 }
    if !std.fs.makeDir("tiny\x00".pointer, 493) { return 217 }
    var written: usize = 0
    if animation.exportSequence(anim, image, "tiny/t", 0, 1, &written) != animation.Export.ok || written != 2 || anim.*.time != 1 { return 218 }
    if fileShows(allocator, "tiny/t_0001.png", 1, 1, 0, 0) != RED || fileShows(allocator, "tiny/t_0002.png", 1, 1, 0, 0) != HALF { return 218 }
    if animation.exportSequence(anim, image, "tiny/end", animation.LAST_TIME, animation.LAST_TIME, &written) != animation.Export.ok || written != 1 || fileShows(allocator, "tiny/end_0001.png", 1, 1, 0, 0) != HALF { return 218 }
    var index: usize = 0
    while index < 1200 {
        longName[index] = 'a'
        index += 1
    }
    const bytes: [*]const u8 = &longName
    if animation.exportSequence(anim, image, bytes[0..1200], 0, 0, &written) != animation.Export.cannotWrite || written != 0 || anim.*.time != 1 { return 218 }
    finish(image)
    return 0
}

// An animated layer taken out and its removal forgotten (the history
// cleared: the layer is ended, with the frame it showed): the time, the
// onion skin of another layer, an export and the record's end do not
// touch it, and the heap holds what it held before.
fn forgotten(allocator: Allocator) -> bool {
    const made = fresh(allocator, 80, 60)
    if made == null { return false }
    const image = made.?
    const a = image.*.active.?
    const anim = animation.find(image).?
    var good = animation.addBlankKey(anim, image, a.*.id, 0, "k") && paint(image, a, geom.rect(0, 0, 70, 10), RED) && animation.addBlankKey(anim, image, a.*.id, 5, "k")
    _ = animation.setTime(anim, image, 5)
    good = good && paint(image, a, geom.rect(0, 20, 70, 10), GREEN)
    const b = ops.newLayer(image, node_module.PAINT, "B", "New layer")
    good = good && b != null && animation.addBlankKey(anim, image, b.?.*.id, 0, "k") && paint(image, b.?, geom.rect(0, 40, 70, 10), BLUE) && animation.addDuplicateKey(anim, image, b.?.*.id, 3, "k")
    if !good { return false }
    ops.remove(image, a, "Remove")
    history.clear(image.*.history)
    image.*.active = b
    animation.setOnion(anim, true, 1, 1)
    _ = animation.setTime(anim, image, 3)
    const skin = animation.onion(anim, image)
    good = skin != null && device.pixel(skin.?, 5, 45) == tinted(anim, BLUE, animation.TINT_BEFORE, anim.*.onionOpacity) && device.pixel(skin.?, 5, 25) == 0
    _ = animation.setTime(anim, image, 0)
    _ = animation.setTime(anim, image, 5)
    var written: usize = 0
    good = good && animation.isAnimated(anim, a.*.id) && animation.lastKeyTime(anim) == 5
    good = good && animation.exportSequence(anim, image, "forgotten/f", 0, 1, &written) == animation.Export.ok && written == 2
    good = good && fileShows(allocator, "forgotten/f_0001.png", 80, 60, 5, 45) == BLUE && fileShows(allocator, "forgotten/f_0001.png", 80, 60, 5, 5) == 0
    finish(image)
    return good
}

fn forgottenLayer(allocator: Allocator) -> u8 {
    if !std.fs.makeDir("forgotten\x00".pointer, 493) || !forgotten(allocator) { return 219 }
    const before = std.heap.liveBytes()
    if !forgotten(allocator) { return 219 }
    if std.heap.liveBytes() != before { return 220 }
    return 0
}

// A history of three steps: older key changes and strokes made at other
// times are forgotten as new ones come; what is left undoes and redoes
// on the right frames, and nothing is kept that nothing holds.
fn shortHistory(allocator: Allocator, check: bool) -> u8 {
    const made = fresh(allocator, 64, 64)
    if made == null { return 221 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    image.*.history.*.limit = 3
    var time: i32 = 0
    while time < 24 {
        if !animation.addBlankKey(anim, image, id, time, "k") { return 221 }
        _ = animation.setTime(anim, image, time)
        if !paint(image, layer, geom.rect(time, time, 2, 2), RED) { return 221 }
        _ = animation.setTime(anim, image, 0)
        time += 2
    }
    const track = animation.trackOf(anim, id).?
    // Left: the stroke at 20, the key at 22, its stroke. Undone from 0.
    var undone: usize = 0
    while history.canUndo(image.*.history) {
        _ = history.undo(image.*.history, image)
        undone += 1
    }
    // (Key 22 undone at 22, the frame of 20 shows there: the time stays.)
    if check && (undone != 3 || animation.keyCount(track) != 11 || device.pixel(animation.deviceAt(track, 20), 20, 20) != 0 || device.pixel(animation.deviceAt(track, 18), 18, 18) != RED || anim.*.time != 22 || !same(layer.*.device.?, animation.deviceAt(track, 20))) { return 222 }
    while history.canRedo(image.*.history) { _ = history.redo(image.*.history, image) }
    if check && (animation.keyCount(track) != 12 || device.pixel(animation.deviceAt(track, 22), 22, 22) != RED || device.pixel(animation.deviceAt(track, 20), 20, 20) != RED || anim.*.time != 22) { return 223 }
    finish(image)
    return 0
}

fn historyLimit(allocator: Allocator) -> u8 {
    const failed = shortHistory(allocator, true)
    if failed != 0 { return failed }
    const before = std.heap.liveBytes()
    if shortHistory(allocator, false) != 0 { return 221 }
    if std.heap.liveBytes() != before { return 223 }
    return 0
}

// A key taken away while a stroke is open on its frame: the layer keeps
// the frame until the stroke is over; the stroke stays that frame's when
// undone and redone, and the key comes back with it.
fn strokeOnRemovedKey(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 64, 64)
    if made == null { return 224 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    if !animation.addBlankKey(anim, image, id, 0, "k") || !paint(image, layer, geom.rect(0, 0, 8, 8), RED) || !animation.addBlankKey(anim, image, id, 5, "k") { return 224 }
    _ = animation.setTime(anim, image, 5)
    const track = animation.trackOf(anim, id).?
    const zero = animation.deviceAt(track, 0)
    const five = animation.deviceAt(track, 5)
    if !ops.beginPixels(image, layer) || !device.fill(five, geom.rect(40, 40, 4, 4), GREEN) { return 224 }
    if !animation.removeKey(anim, image, id, 5, "Remove") || animation.keyCount(track) != 1 || !same(layer.*.device.?, five) || !anim.*.pending { return 225 }
    if geom.isEmpty(ops.endPixels(image, layer, "Stroke")) || geom.isEmpty(animation.sync(anim, image)) || !same(layer.*.device.?, zero) || anim.*.pending { return 225 }
    // Undone: the stroke leaves the frame taken away, the time stays.
    _ = history.undo(image.*.history, image)
    if device.pixel(five, 41, 41) != 0 || anim.*.time != 5 || !same(layer.*.device.?, zero) { return 226 }
    _ = history.undo(image.*.history, image)
    if animation.keyCount(track) != 2 || !same(layer.*.device.?, five) || device.pixel(five, 41, 41) != 0 { return 226 }
    _ = history.redo(image.*.history, image)
    _ = history.redo(image.*.history, image)
    if animation.keyCount(track) != 1 || !same(layer.*.device.?, zero) || device.pixel(five, 41, 41) != GREEN || device.pixel(zero, 41, 41) != 0 { return 226 }
    finish(image)
    return 0
}

// An animated layer with a transparency mask (a mask of everything at
// first, half of it hidden): every frame is masked alike; the mask has
// no keys, nor an onion skin.
fn maskedLayer(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 100, 80)
    if made == null { return 227 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    if !paint(image, layer, geom.rect(0, 0, 100, 80), RED) { return 227 }
    const mask = ops.newMask(image, layer, node_module.TRANSPARENCY_MASK, "Mask", "New mask")
    if mask == null || device.pixel(mask.?.*.device.?, 70, 70) != 0xFFFFFFFF { return 227 }
    if !ops.beginPixels(image, mask.?) || !device.fill(mask.?.*.device.?, geom.rect(50, 0, 50, 80), 0xFF000000) || geom.isEmpty(ops.endPixels(image, mask.?, "Hide")) { return 227 }
    if animation.addBlankKey(anim, image, mask.?.*.id, 3, "k") || animation.addDuplicateKey(anim, image, mask.?.*.id, 3, "k") { return 227 }
    if !animation.addBlankKey(anim, image, id, 5, "k") { return 228 }
    _ = animation.setTime(anim, image, 5)
    if !paint(image, layer, geom.rect(0, 0, 100, 80), GREEN) { return 228 }
    _ = animation.setTime(anim, image, 0)
    if shown(image, 10, 10) != RED || shown(image, 60, 10) != 0 || shown(image, 49, 79) != RED || shown(image, 50, 79) != 0 { return 228 }
    _ = animation.setTime(anim, image, 5)
    if shown(image, 10, 10) != GREEN || shown(image, 60, 10) != 0 || shown(image, 49, 79) != GREEN || shown(image, 50, 79) != 0 { return 228 }
    image.*.active = mask
    animation.setOnion(anim, true, 1, 1)
    if animation.onion(anim, image) != null { return 228 }
    finish(image)
    return 0
}

// The onion skin over the canvas, at zoom 4 and at zoom 1/2 (both exact
// in floating point), against a second sampling of it: at every window
// pixel of the canvas the plain frame with the skin's pixel under the
// pixel's middle laid over it, and the plain frame again once it is off.
fn onionWindow(app: *App, anim: *Animation, image: *Image, layer: *Node) -> u8 {
    const doc = api.document(app).?
    image.*.active = layer
    _ = animation.setTime(anim, image, 5)
    const area = app.*.canvasArea
    if ui.isEmpty(area) { return 229 }
    const count = @intCast(usize, area.width) * @intCast(usize, area.height)
    const memory = app.*.allocator.alloc(count * 4, 16)
    if memory == null { return 229 }
    const plain: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    var zoom: f64 = 4.0
    var result: u8 = 0
    while zoom > 0.25 && result == 0 {
        doc.*.view.zoom = zoom
        doc.*.view.centerX = 60.0
        doc.*.view.centerY = 45.0
        doc.*.view.rotation = 0.0
        doc.*.view.mirror = false
        animation.setOnion(anim, false, 1, 1)
        api.redraw(app)
        if !script.run(app, "shot onion-check.png\nshot onion-check.png\n") { return 229 }
        var frame = script.frameOf(app).?
        var row: usize = 0
        while row < @intCast(usize, area.height) {
            var column: usize = 0
            while column < @intCast(usize, area.width) {
                plain[row * @intCast(usize, area.width) + column] = frame.*.pixels[(@intCast(usize, area.y) + row) * frame.*.stride + @intCast(usize, area.x) + column]
                column += 1
            }
            row += 1
        }
        animation.setOnion(anim, true, 1, 1)
        api.redraw(app)
        if !script.run(app, "shot onion-check.png\nshot onion-check.png\n") { return 229 }
        frame = script.frameOf(app).?
        const skin = animation.onion(anim, image).?
        var tinted_count: usize = 0
        row = 0
        while row < @intCast(usize, area.height) && result == 0 {
            var column: usize = 0
            while column < @intCast(usize, area.width) {
                const wx = area.x + @intCast(i32, column)
                const wy = area.y + @intCast(i32, row)
                var ix: f64 = 0.0
                var iy: f64 = 0.0
                viewport.toImage(&doc.*.view, @floatFromInt(f64, wx) + 0.5, @floatFromInt(f64, wy) + 0.5, &ix, &iy)
                const under = plain[row * @intCast(usize, area.width) + column]
                var wanted = under
                if ix > -100000.0 && ix < 100000.0 && iy > -100000.0 && iy < 100000.0 {
                    const value = device.pixel(skin, @intFromFloat(i32, @floor(ix)), @intFromFloat(i32, @floor(iy)))
                    if value >> 24 != 0 {
                        wanted = canvas_module.over(under, canvas_module.premultiplied(value), 255)
                        tinted_count += 1
                    }
                }
                if frame.*.pixels[@intCast(usize, wy) * frame.*.stride + @intCast(usize, wx)] != wanted { result = 230 }
                column += 1
            }
            row += 1
        }
        if result == 0 && tinted_count == 0 { result = 230 }
        animation.setOnion(anim, false, 1, 1)
        api.redraw(app)
        if !script.run(app, "shot onion-check.png\nshot onion-check.png\n") { return 229 }
        frame = script.frameOf(app).?
        row = 0
        while row < @intCast(usize, area.height) && result == 0 {
            var column: usize = 0
            while column < @intCast(usize, area.width) {
                if frame.*.pixels[(@intCast(usize, area.y) + row) * frame.*.stride + @intCast(usize, area.x) + column] != plain[row * @intCast(usize, area.width) + column] { result = 231 }
                column += 1
            }
            row += 1
        }
        zoom = zoom / 8.0
    }
    app.*.allocator.free(memory.?, count * 4, 16)
    doc.*.view.zoom = 1.0
    api.redraw(app)
    return result
}

// Seventy animated layers: the docker lists MOST_ROWS of them, names
// regions only for the rows in view, and stays inside the window's 2048.
fn manyRows(app: *App, anim: *Animation, image: *Image) -> u8 {
    var index: usize = 0
    while index < 70 {
        const made = ops.newLayer(image, node_module.PAINT, "Many", "New layer")
        if made == null || !animation.addBlankKey(anim, image, made.?.*.id, 0, "k") { return 232 }
        index += 1
    }
    if !script.run(app, "size 1280 800\npointer 5 5\n") || timeline.rowCount(app) != timeline.MOST_ROWS || !laidOut(app) { return 233 }
    const widgets = state.uiOf(app)
    if widgets.*.shownCount >= 2048 || ui.isEmpty(timeline.cellArea(app, 0, 2)) || !ui.isEmpty(timeline.cellArea(app, timeline.MOST_ROWS - 1, 2)) { return 233 }
    return 0
}

// Thousands of times shown on a layer of three frames, playing by the
// clock, the onion skin made again and again and the image drawn: the
// value arena stays as it was.
fn steadyMany(allocator: Allocator) -> u8 {
    const made = fresh(allocator, 200, 150)
    if made == null { return 234 }
    const image = made.?
    const layer = image.*.active.?
    const anim = animation.find(image).?
    const id = layer.*.id
    var time: i32 = 0
    while time < 12 {
        if !animation.addBlankKey(anim, image, id, time, "k") { return 234 }
        _ = animation.setTime(anim, image, time)
        if !paint(image, layer, geom.rect(time * 10, 30, 90, 70), RED + @intCast(u32, time)) { return 234 }
        time += 4
    }
    animation.setOnion(anim, true, 2, 2)
    animation.setRange(anim, 0, 11)
    animation.play(anim, 0)
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: usize = 0
    while round < 3000 {
        if round % 2 == 0 {
            _ = animation.setTime(anim, image, @intCast(i32, round % 12))
        } else {
            _ = animation.advance(anim, image, round * 7)
        }
        _ = animation.sync(anim, image)
        _ = animation.onion(anim, image)
        _ = render.update(image)
        round += 1
    }
    const grown = turns.used(arena) - before
    @discardError(std.io.printFmt("arena grew {} bytes\n", .{grown}))
    finish(image)
    if grown > 0 { return 234 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null {
        const shots = std.string.asSlice(named.?)
        shotsAt = @intFromPtr(shots.pointer)
        shotsLength = shots.length
    }
    const made = script.headless(allocator)
    if made == null { return 1 }
    const app = made.?
    if !script.run(app, "size 1280 800\nnew 120 90 FFFFFF\n") { return 2 }
    const image = api.image(app).?
    const layer = image.*.active.?
    const anim = animation.make(image)
    if anim == null { return 3 }
    var failed = keysAndTime(anim.?, image, layer)
    if failed != 0 { return failed }
    failed = duplicateKey(app, anim.?, image, layer)
    if failed != 0 { return failed }
    failed = paintAndUndo(app, anim.?, image, layer)
    if failed != 0 { return failed }
    failed = removeKeys(app, anim.?, image, layer)
    if failed != 0 { return failed }
    failed = holds(anim.?, image, layer)
    if failed != 0 { return failed }
    failed = onionSkin(anim.?, image, layer)
    if failed != 0 { return failed }
    failed = secondLayer(app, anim.?, image, layer)
    if failed != 0 { return failed }
    failed = exportFrames(app, anim.?, image)
    if failed != 0 { return failed }
    failed = docker(app, anim.?, image, layer)
    if failed != 0 { return failed }
    failed = playing(app, anim.?, image)
    if failed != 0 { return failed }
    failed = pictures(app, anim.?, image, layer)
    if failed != 0 { return failed }
    failed = onionWindow(app, anim.?, image, layer)
    if failed != 0 { return failed }
    failed = steady(anim.?, image)
    if failed != 0 { return failed }
    failed = manyRows(app, anim.?, image)
    if failed != 0 { return failed }
    failed = closing(app)
    if failed != 0 { return failed }
    failed = balanced(allocator)
    if failed != 0 { return failed }
    return edges(allocator)
}

// The edges, each on an image of its own.
fn edges(allocator: Allocator) -> u8 {
    var failed = pendingSwap(allocator)
    if failed != 0 { return failed }
    failed = movedFrames(allocator)
    if failed != 0 { return failed }
    failed = holdsInverse(allocator)
    if failed != 0 { return failed }
    failed = firstKeys(allocator)
    if failed != 0 { return failed }
    failed = playClock(allocator)
    if failed != 0 { return failed }
    failed = sequenceNames()
    if failed != 0 { return failed }
    failed = tinyImage(allocator)
    if failed != 0 { return failed }
    failed = forgottenLayer(allocator)
    if failed != 0 { return failed }
    failed = historyLimit(allocator)
    if failed != 0 { return failed }
    failed = strokeOnRemovedKey(allocator)
    if failed != 0 { return failed }
    failed = maskedLayer(allocator)
    if failed != 0 { return failed }
    failed = steadyMany(allocator)
    if failed != 0 { return failed }
    return 13
}
