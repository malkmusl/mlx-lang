// The view tools and the text tool (tools/views.mlx, tools/text.mlx,
// core/textrender.mlx) on an app without a window, played by scripts:
// the zoom tool's click doubles the zoom about the point (the image point
// under it stays), Alt and a click halves it, a rectangle dragged out is
// zoomed to fill the canvas; the pan tool moves the view's centre by the
// drag over the zoom; the measure shows a label (the frame changes), 300
// pixels at 0 degrees for a level drag of 300, Shift keeps to 15 degree
// steps, Escape takes it away; the rotate tool turns by the angle swept
// about the middle (90 degrees), Shift in 15 degree steps, a double click
// sets it upright; Escape in the middle of a zoom, a pan or a turn leaves
// the view as it was; none of them records a step; the hand's gestures
// (Control zooms, Shift turns, else it moves; a modifier let go of no
// longer counts). The text tool: a click and typing show the text over the
// canvas, Control and Enter puts it in a new layer named after it, dark
// where the letters are and as wide as textrender.measure says, one step
// "Text" that one undo takes away; 72 pixel text is taller than 12 pixel
// text; centred text is centred on the click; a dragged box wraps its
// lines; only the selection gets text; a long first word is cut for the
// layer's name between characters; a click in the box moves the caret,
// one beside it or another tool puts the text on the image; Escape while
// typing leaves nothing, on the image or over it. textrender's edges (empty
// text, a closing line feed, sizes beyond the limits, negative places,
// across tiles, the caret and the click finding each other) and that
// setting text again and again leaves the value arena as it was. Every
// tool's options are drawn at 1024 x 768, dark and light, English and
// German, and a click on them takes (and is kept in the settings).
//
// At the edges: textrender's bytes and its mask hold the same coverage at
// negative places and across tile borders (left, right, sharp); nothing
// to set sets nothing; places beyond its reach (huge, not a number) set
// nothing, far ones within it are set there; the sizes 1 and 1000; right
// alignment in a box; letters spaced back over each other keep the box
// as wide as the first; the caret and the click at every boundary (bytes
// of several, empty lines, broken words, centred lines); a selection that
// is all, a layer moved away, a change open (taken back, done again,
// undone, redone), the same text twice, a colour of alpha 0 and opacity
// 0; the font list; a long text takes nothing of the value arena a glyph;
// fonts made and destroyed give the heap back. The tools: pan and zoom in
// a turned, mirrored, zoomed view keep the image point under the pointer,
// the largest zoom stays; Alt and a rectangle shrinks the canvas into it;
// the measure in a turned view is in the image's pixels; a double click
// with Rotate View keeps the middle; the hand's zoom stays in its limits;
// Escape takes the marks off the frame. The text: what is pasted (control
// characters out), whole characters for Left, Right and Backspace, Home,
// End, Up and Down by the lines as set, a click in the box at a boundary;
// filled to the brim no half character goes in, and the full text is one
// step; undo and redo give back the image exactly, and the frame; what
// shows while typing is what the layer shows after; in a turned view the
// text lands where it was clicked; Escape while a box is dragged; the
// marks take of the value arena a frame what they take for a short text;
// another document in front drops the text, its keys are that document's;
// every panel at no width at all.
//
// Pictures (zoom.png, measure.png, text.png, text-turned.png,
// options-dark.png, ...) go to the current directory and, when
// NEBULA_SHOTS names one, to that one too. Without a font the text checks
// that need one are passed over. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view_module = @import("std.ui.view")
const theme_module = @import("std.ui.theme")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const script = @import("../app/script.mlx")
const registry = @import("../tools/registry.mlx")
const views = @import("../tools/views.mlx")
const text_tool = @import("../tools/text.mlx")
const textrender = @import("../core/textrender.mlx")
const viewport = @import("../ui/viewport.mlx")
const kit_module = @import("../ui/kit.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const mask = @import("../core/mask.mlx")
const node_module = @import("../core/node.mlx")
const render = @import("../core/render.mlx")
const image_module = @import("../core/image.mlx")
const geom = @import("../core/geom.mlx")
const blend = @import("../core/blend.mlx")
const shell_module = @import("../app/shell.mlx")
const settings = @import("../app/settings.mlx")

const App = state.App

// Where pictures go besides the current directory ("" none).
var shotsPlace: [512]u8 = undefined
var shotsLength: usize = 0

// ---------------------------------------------------------------------------
// Playing

fn play(app: *App, command: []const u8, values: [*]const i32, count: usize) -> bool {
    var text: [256]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 256, command)
    var index: usize = 0
    while index < count {
        length = std.text.append(bytes, length, 256, " ")
        length = std.text.appendSigned(bytes, length, 256, @intCast(isize, values[index]))
        index += 1
    }
    length = std.text.append(bytes, length, 256, "\n")
    return script.run(app, bytes[0..length])
}

fn click(app: *App, x: i32, y: i32) -> bool {
    const values = [2]i32{ x, y }
    return play(app, "click", &values, 2)
}

fn pointer(app: *App, x: i32, y: i32) -> bool {
    const values = [2]i32{ x, y }
    return play(app, "pointer", &values, 2)
}

fn drag(app: *App, x0: i32, y0: i32, x1: i32, y1: i32, steps: i32) -> bool {
    const values = [5]i32{ x0, y0, x1, y1, steps }
    return play(app, "drag", &values, 5)
}

// A picture of the frame, here and where NEBULA_SHOTS says.
fn shot(app: *App, name: []const u8) -> bool {
    var text: [700]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 700, "shot ")
    length = std.text.append(bytes, length, 700, name)
    length = std.text.append(bytes, length, 700, "\n")
    if shotsLength > 0 {
        const place: [*]const u8 = &shotsPlace
        length = std.text.append(bytes, length, 700, "shot ")
        length = std.text.append(bytes, length, 700, place[0..shotsLength])
        length = std.text.append(bytes, length, 700, "/")
        length = std.text.append(bytes, length, 700, name)
        length = std.text.append(bytes, length, 700, "\n")
    }
    return script.run(app, bytes[0..length])
}

// Saves pixels of our own (the options' pictures) the same two ways.
fn save(name: []const u8, pixels: [*]const u32, width: usize, height: usize) -> bool {
    var text: [700]u8 = undefined
    const bytes: [*]u8 = &text
    const allocator = std.heap.allocator()
    if !png.saveFile(std.text.zeroTerminated(bytes, 700, name), pixels, width, height, width, false, allocator) { return false }
    if shotsLength > 0 {
        const place: [*]const u8 = &shotsPlace
        var length = std.text.append(bytes, 0, 700, place[0..shotsLength])
        length = std.text.append(bytes, length, 700, "/")
        length = std.text.append(bytes, length, 700, name)
        if !png.saveFile(std.text.zeroTerminated(bytes, 700, bytes[0..length]), pixels, width, height, width, false, allocator) { return false }
    }
    return true
}

fn viewOf(app: *App) -> *viewport.View {
    return &api.document(app).?.*.view
}

// The window pixel image point (x, y) is shown in.
fn windowOf(app: *App, x: f64, y: f64, wx: *i32, wy: *i32) -> void {
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    viewport.toWindow(viewOf(app), x, y, &fx, &fy)
    wx.* = @intFromFloat(i32, @floor(fx))
    wy.* = @intFromFloat(i32, @floor(fy))
}

// The image point under the middle of window pixel (wx, wy).
fn imageAt(app: *App, wx: i32, wy: i32, x: *f64, y: *f64) -> void {
    viewport.toImage(viewOf(app), @floatFromInt(f64, wx) + 0.5, @floatFromInt(f64, wy) + 0.5, x, y)
}

fn near(a: f64, b: f64, within: f64) -> bool {
    return a - b <= within && b - a <= within
}

// The view back to zoom 1, upright, the image's middle in the middle.
fn resetView(app: *App) -> void {
    const view = viewOf(app)
    view.*.zoom = 1.0
    view.*.rotation = 0.0
    view.*.mirror = false
    view.*.centerX = 200.0
    view.*.centerY = 150.0
    api.redraw(app)
}

// A sum of the canvas area's pixels in the frame drawn last.
fn areaHash(app: *App) -> u64 {
    const frame = script.frameOf(app).?
    const area = app.*.canvasArea
    var hash: u64 = 1469598103934665603
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            hash = (hash ^ @intCast(u64, frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)])) *% 1099511628211
            x += 1
        }
        y += 1
    }
    return hash
}

fn middleOfArea(app: *App, x: *i32, y: *i32) -> void {
    const area = viewOf(app).*.area
    x.* = area.x + area.width / 2
    y.* = area.y + area.height / 2
}

// ---------------------------------------------------------------------------
// The tools are there

fn testTable() -> u8 {
    const zoom = registry.byKey("zoom")
    const pan = registry.byKey("pan")
    const measure = registry.byKey("measure")
    const rotate = registry.byKey("rotateview")
    const text = registry.byKey("text")
    if zoom == null || pan == null || measure == null || rotate == null || text == null { return 2 }
    if zoom.?.*.id != 50 || pan.?.*.id != 51 || measure.?.*.id != 52 || rotate.?.*.id != 53 || text.?.*.id != 60 { return 3 }
    if !std.text.same(zoom.?.*.shortcut, "Z") || !std.text.same(pan.?.*.shortcut, "H") || text.?.*.shortcut.length != 0 { return 4 }
    if zoom.?.*.options == null || pan.?.*.options == null || measure.?.*.options == null || rotate.?.*.options == null || text.?.*.options == null { return 5 }
    if text.?.*.keyPress == null || text.?.*.finish == null || text.?.*.cancel == null || text.?.*.busy == null { return 6 }
    return 0
}

// ---------------------------------------------------------------------------
// Zoom

fn testZoom(app: *App) -> u8 {
    if !script.run(app, "tool zoom\n") || app.*.tool != views.ZOOM { return 10 }
    resetView(app)
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, 120.0, 90.0, &wx, &wy)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    imageAt(app, wx, wy, &x0, &y0)
    if !click(app, wx, wy) { return 11 }
    const view = viewOf(app)
    if !near(view.*.zoom, 2.0, 0.000001) { return 12 }
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    imageAt(app, wx, wy, &x1, &y1)
    // (13 is the number of success: this check shares 12.)
    if !near(x0, x1, 0.001) || !near(y0, y1, 0.001) { return 12 }
    // Alt and a click: half, about the same point.
    if !script.run(app, "down Alt\n") || !click(app, wx, wy) || !script.run(app, "up Alt\n") { return 14 }
    if !near(view.*.zoom, 1.0, 0.000001) { return 15 }
    imageAt(app, wx, wy, &x1, &y1)
    if !near(x0, x1, 0.001) || !near(y0, y1, 0.001) { return 16 }
    if history.stepsDone(api.image(app).?.*.history) != 0 { return 17 }

    // A rectangle around image (100, 100) - (200, 150): it fills the
    // canvas (its wider side does), its middle in the middle.
    var ax: i32 = 0
    var ay: i32 = 0
    var bx: i32 = 0
    var by: i32 = 0
    windowOf(app, 100.0, 100.0, &ax, &ay)
    windowOf(app, 200.0, 150.0, &bx, &by)
    const values = [2]i32{ ax, ay }
    const later = [2]i32{ bx, by }
    if !play(app, "pointer", &values, 2) || !script.run(app, "press\n") || !play(app, "pointer", &later, 2) { return 18 }
    if !api.toolBusy(app) { return 19 }
    if !shot(app, "zoom.png") || !script.run(app, "release\n") { return 20 }
    if api.toolBusy(app) { return 21 }
    const room_x = @floatFromInt(f64, view.*.area.width)
    const room_y = @floatFromInt(f64, view.*.area.height)
    const wanted = math.min(room_x / @floatFromInt(f64, bx - ax + 1), room_y / @floatFromInt(f64, by - ay + 1))
    if !near(view.*.zoom, wanted, 0.0001) || view.*.zoom < 2.0 { return 22 }
    var mx: f64 = 0.0
    var my: f64 = 0.0
    viewport.toImage(view, @floatFromInt(f64, view.*.area.x) + room_x / 2.0, @floatFromInt(f64, view.*.area.y) + room_y / 2.0, &mx, &my)
    if !near(mx, 150.5, 0.6) || !near(my, 125.5, 0.6) { return 23 }
    // The rectangle's corners are inside the canvas now, one side at its
    // edges.
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    viewport.toWindow(view, 100.0, 100.0, &cx, &cy)
    if cx < @floatFromInt(f64, view.*.area.x) - view.*.zoom || cy < @floatFromInt(f64, view.*.area.y) - view.*.zoom { return 24 }
    if cx > @floatFromInt(f64, view.*.area.x) + view.*.zoom && cy > @floatFromInt(f64, view.*.area.y) + view.*.zoom { return 27 }
    // Escape in the middle of a drag leaves the view as it is, and the
    // frame (the rectangle is gone).
    resetView(app)
    if !play(app, "pointer", &values, 2) { return 25 }
    const untouched = areaHash(app)
    if !script.run(app, "press\n") || !play(app, "pointer", &later, 2) || areaHash(app) == untouched || !script.run(app, "key Escape\nrelease\n") { return 25 }
    if !near(view.*.zoom, 1.0, 0.000001) || api.toolBusy(app) || !play(app, "pointer", &values, 2) || areaHash(app) != untouched { return 26 }
    return 0
}

// ---------------------------------------------------------------------------
// Pan, and the hand's gestures

fn gestureInput(x: i32, y: i32, modifiers: u32) -> state.Input {
    return state.Input.{ .x = 0.0, .y = 0.0, .windowX = x, .windowY = y, .pressure = 1.0, .tiltX = 0.0, .tiltY = 0.0, .rotation = 0.0, .time = 0.0, .button = 0, .buttons = 0, .modifiers = modifiers, .clicks = 1 }
}

fn testPan(app: *App) -> u8 {
    if !script.run(app, "tool pan\n") || app.*.tool != views.PAN { return 30 }
    resetView(app)
    const view = viewOf(app)
    view.*.zoom = 2.0
    var mx: i32 = 0
    var my: i32 = 0
    middleOfArea(app, &mx, &my)
    if !drag(app, mx, my, mx + 100, my + 40, 10) { return 31 }
    if !near(view.*.centerX, 150.0, 0.000001) || !near(view.*.centerY, 130.0, 0.000001) || !near(view.*.zoom, 2.0, 0.0) { return 32 }
    if api.toolBusy(app) || history.stepsDone(api.image(app).?.*.history) != 0 { return 33 }
    // Escape in the middle of a drag: the view is where it was.
    if !pointer(app, mx, my) || !script.run(app, "press\n") || !pointer(app, mx + 60, my + 30) { return 43 }
    if near(view.*.centerX, 150.0, 1.0) || !api.toolBusy(app) { return 44 }
    if !script.run(app, "key Escape\nrelease\n") || view.*.centerX != 150.0 || view.*.centerY != 130.0 || api.toolBusy(app) { return 45 }

    // The hand: with Control a drag up by ZOOM_PIXELS doubles the zoom
    // about where it began.
    resetView(app)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    imageAt(app, mx - 50, my + 20, &x0, &y0)
    // (The shell says what is held now; the input what the loop saw.)
    app.*.shell.*.modifiers = keys.CONTROL
    var input = gestureInput(mx - 50, my + 20, keys.CONTROL)
    if !views.canvasGesture(app, &input, views.GESTURE_PRESS) { return 34 }
    input = gestureInput(mx + 10, my + 20 - 120, 0)
    if !views.canvasGesture(app, &input, views.GESTURE_MOVE) || !views.canvasGesture(app, &input, views.GESTURE_RELEASE) { return 35 }
    if !near(view.*.zoom, 2.0, 0.000001) { return 36 }
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    imageAt(app, mx - 50, my + 20, &x1, &y1)
    if !near(x0, x1, 0.001) || !near(y0, y1, 0.001) { return 37 }
    if views.canvasGesture(app, &input, views.GESTURE_MOVE) { return 38 }
    // With Shift it turns: a quarter round about the middle.
    resetView(app)
    app.*.shell.*.modifiers = keys.SHIFT
    input = gestureInput(mx + 80, my, keys.SHIFT)
    if !views.canvasGesture(app, &input, views.GESTURE_PRESS) { return 39 }
    input = gestureInput(mx, my - 80, keys.SHIFT)
    if !views.canvasGesture(app, &input, views.GESTURE_RELEASE) { return 40 }
    if !near(view.*.rotation, -math.pi / 2.0, 0.02) { return 41 }
    // Plain: it moves the view with the pointer; a modifier the loop
    // still names but that is no longer held does not count.
    app.*.shell.*.modifiers = 0
    resetView(app)
    input = gestureInput(mx, my, keys.SHIFT)
    _ = views.canvasGesture(app, &input, views.GESTURE_PRESS)
    input = gestureInput(mx - 30, my + 12, 0)
    _ = views.canvasGesture(app, &input, views.GESTURE_RELEASE)
    if !near(view.*.centerX, 230.0, 0.000001) || !near(view.*.centerY, 138.0, 0.000001) { return 42 }
    resetView(app)
    return 0
}

// ---------------------------------------------------------------------------
// Measure

fn testMeasure(app: *App) -> u8 {
    if !script.run(app, "tool measure\n") { return 50 }
    resetView(app)
    var length: f64 = 0.0
    var angle: f64 = 0.0
    if views.measured(app, &length, &angle) { return 51 }
    var ax: i32 = 0
    var ay: i32 = 0
    windowOf(app, 50.0, 100.0, &ax, &ay)
    if !pointer(app, ax - 30, ay - 40) { return 52 }
    const before = areaHash(app)
    if !drag(app, ax, ay, ax + 300, ay, 12) { return 53 }
    if !views.measured(app, &length, &angle) { return 54 }
    if !near(length, 300.0, 0.000001) || !near(angle, 0.0, 0.000001) { return 55 }
    if !pointer(app, ax - 30, ay - 40) || areaHash(app) == before { return 56 }
    if !shot(app, "measure.png") { return 57 }
    // A line drawn from right to left is half round.
    if !drag(app, ax + 300, ay, ax, ay, 12) || !views.measured(app, &length, &angle) || !near(angle, 180.0, 0.000001) { return 58 }
    // Shift: steps of 15 degrees, the length kept. Up and to the right is
    // a positive angle (the image's y grows downwards).
    if !script.run(app, "down Shift\n") || !drag(app, ax, ay, ax + 100, ay - 12, 8) || !script.run(app, "up Shift\n") { return 59 }
    if !views.measured(app, &length, &angle) || !near(angle, 0.0, 0.000001) || !near(length, math.sqrt(100.0 * 100.0 + 144.0), 0.000001) { return 60 }
    if !script.run(app, "down Shift\n") || !drag(app, ax, ay, ax + 100, ay - 90, 8) || !script.run(app, "up Shift\n") { return 61 }
    if !views.measured(app, &length, &angle) || !near(angle, 45.0, 0.000001) { return 62 }
    // Escape takes it away; nothing was recorded.
    if !script.run(app, "key Escape\n") || views.measured(app, &length, &angle) { return 63 }
    if !pointer(app, ax - 30, ay - 40) || areaHash(app) != before { return 64 }
    if history.stepsDone(api.image(app).?.*.history) != 0 { return 65 }
    return 0
}

// ---------------------------------------------------------------------------
// Rotate View

fn testRotate(app: *App) -> u8 {
    if !script.run(app, "tool rotateview\n") { return 70 }
    resetView(app)
    const view = viewOf(app)
    var mx: i32 = 0
    var my: i32 = 0
    middleOfArea(app, &mx, &my)
    // From right of the middle to below it: a quarter clockwise.
    if !drag(app, mx + 100, my, mx, my + 100, 10) { return 71 }
    // (The angle is the one between the two pixels' middles about the
    // area's middle: a quarter but for half a pixel.)
    const cx = @floatFromInt(f64, view.*.area.x) + @floatFromInt(f64, view.*.area.width) / 2.0
    const cy = @floatFromInt(f64, view.*.area.y) + @floatFromInt(f64, view.*.area.height) / 2.0
    const swept = math.atan2(@floatFromInt(f64, my + 100) + 0.5 - cy, @floatFromInt(f64, mx) + 0.5 - cx) - math.atan2(@floatFromInt(f64, my) + 0.5 - cy, @floatFromInt(f64, mx + 100) + 0.5 - cx)
    if !near(view.*.rotation, swept, 0.000001) || !near(view.*.rotation, math.pi / 2.0, 0.02) { return 72 }
    if !near(view.*.centerX, 200.0, 0.01) || !near(view.*.centerY, 150.0, 0.01) || api.toolBusy(app) { return 73 }
    if !shot(app, "rotate.png") { return 74 }
    // With Shift: steps of 15 degrees (90 + 16.7 is 105). (A while
    // after the last press, or this one would be a double click.)
    if !script.run(app, "wait 500\ndown Shift\n") || !drag(app, mx + 100, my, mx + 100, my + 30, 6) || !script.run(app, "up Shift\n") { return 75 }
    if !near(view.*.rotation, math.pi * 105.0 / 180.0, 0.000001) { return 76 }
    // Escape in the middle of a drag: as it was.
    const kept = view.*.rotation
    if !script.run(app, "wait 500\n") || !pointer(app, mx + 100, my) || !script.run(app, "press\n") || !pointer(app, mx, my + 100) { return 66 }
    if near(view.*.rotation, kept, 0.5) { return 67 }
    if !script.run(app, "key Escape\nrelease\n") || view.*.rotation != kept || api.toolBusy(app) { return 68 }
    // (The frame too: the turn's marks are gone.)
    if !pointer(app, mx + 100, my) || !script.run(app, "wait 500\n") { return 68 }
    const resting = areaHash(app)
    if !script.run(app, "press\n") || !pointer(app, mx, my + 100) || areaHash(app) == resting || !script.run(app, "key Escape\nrelease\n") || !pointer(app, mx + 100, my) || areaHash(app) != resting { return 68 }
    // A double click: upright again.
    if !click(app, mx + 60, my + 60) || !click(app, mx + 60, my + 60) { return 77 }
    if view.*.rotation != 0.0 || history.stepsDone(api.image(app).?.*.history) != 0 { return 78 }
    return 0
}

// ---------------------------------------------------------------------------
// textrender itself

fn testRender(fonts: *textrender.Fonts) -> u8 {
    var style = textrender.defaultStyle()
    style.size = 40.0
    const empty = textrender.measure(fonts, &style, "")
    if empty.lines != 1 || empty.width != 0.0 || empty.height <= 30.0 { return 80 }
    const two = textrender.measure(fonts, &style, "ab\n")
    if two.lines != 2 || !near(two.height, empty.height + two.pitch, 0.000001) { return 81 }
    const hello = textrender.measure(fonts, &style, "Hello")
    if hello.width < 60.0 || hello.width > 160.0 || hello.left != 0.0 { return 82 }
    // Centred and right aligned text without a width is anchored at its
    // middle and its right edge.
    style.alignment = textrender.ALIGN_CENTER
    if !near(textrender.measure(fonts, &style, "Hello").left, -hello.width / 2.0, 0.000001) { return 83 }
    style.alignment = textrender.ALIGN_RIGHT
    if !near(textrender.measure(fonts, &style, "Hello").left, -hello.width, 0.000001) { return 84 }
    style.alignment = textrender.ALIGN_LEFT
    // Letter spacing adds after every character but the last.
    style.letterSpacing = 10.0
    if !near(textrender.measure(fonts, &style, "Hello").width, hello.width + 40.0, 0.000001) { return 85 }
    style.letterSpacing = 0.0
    // Wrapping: between words, inside a word longer than the width.
    style.wrap = 120.0
    const wrapped = textrender.measure(fonts, &style, "one two three four")
    if wrapped.lines < 3 || wrapped.width != 120.0 { return 86 }
    if textrender.measure(fonts, &style, "abcdefghijklmnopqrstuvwxyz").lines < 4 { return 87 }
    style.wrap = 0.0
    // Sizes are held to their limits.
    style.size = 0.0
    if textrender.sizeOf(&style) != textrender.SMALLEST || textrender.measure(fonts, &style, "x").width > 2.0 { return 88 }
    style.size = 100000.0
    if textrender.sizeOf(&style) != textrender.LARGEST { return 89 }
    style.size = 40.0
    // The caret and the click find each other.
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var tall: f64 = 0.0
    if !textrender.caretAt(fonts, &style, "Hello\nWorld", 10.0, 20.0, 3, &cx, &cy, &tall) || cy != 20.0 || cx <= 10.0 { return 90 }
    if textrender.offsetAt(fonts, &style, "Hello\nWorld", 10.0, 20.0, cx, cy + tall / 2.0) != 3 { return 91 }
    if !textrender.caretAt(fonts, &style, "Hello\nWorld", 10.0, 20.0, 8, &cx, &cy, &tall) || !near(cy, 20.0 + two.pitch, 0.000001) { return 92 }
    if textrender.offsetAt(fonts, &style, "Hello\nWorld", 10.0, 20.0, cx + 0.5, cy + 2.0) != 8 { return 93 }
    if textrender.offsetAt(fonts, &style, "Hello\nWorld", 10.0, 20.0, -500.0, 900.0) != 6 { return 94 }

    // Into bytes: dark where the letters are, nothing outside; a place
    // half off the buffer is cut, not a fault.
    const allocator = std.heap.allocator()
    const bytes = allocator.alloc(200 * 80, 16)
    if bytes == null { return 95 }
    std.mem.zero(bytes.?, 200 * 80)
    if !textrender.render(fonts, &style, "Hello", 10.0, 10.0, bytes.?, 200, 80, 200) { return 96 }
    var full: usize = 0
    var index: usize = 0
    while index < 200 * 80 {
        if bytes.?[index] == 255 { full += 1 }
        index += 1
    }
    if full < 100 || bytes.?[0] != 0 || bytes.?[200 * 80 - 1] != 0 { return 97 }
    std.mem.zero(bytes.?, 200 * 80)
    if !textrender.render(fonts, &style, "Hello", -60.0, -20.0, bytes.?, 200, 80, 200) { return 98 }
    // Without smooth edges every byte is all or nothing.
    style.antialias = false
    std.mem.zero(bytes.?, 200 * 80)
    _ = textrender.render(fonts, &style, "Hello", 10.0, 10.0, bytes.?, 200, 80, 200)
    index = 0
    while index < 200 * 80 {
        if bytes.?[index] != 0 && bytes.?[index] != 255 { return 99 }
        index += 1
    }
    style.antialias = true
    allocator.free(bytes.?, 200 * 80, 16)

    // Into a mask across tile borders and at negative places, and mixed
    // into a layer: the same pixels.
    const cover = mask.create(allocator, false).?
    const area = textrender.coverage(fonts, &style, "Hello", -30.0, 40.0, cover)
    if geom.isEmpty(area) || area.x >= 0 || area.y + area.height <= 64 || !geom.same(mask.bounds(cover), geom.intersect(mask.bounds(cover), area)) { return 100 }
    const layer = device.create(allocator, 0).?
    const changed = textrender.paint(fonts, &style, "Hello", -30.0, 40.0, layer, 0xFF2040C0, blend.NORMAL, 255, 0, null)
    if geom.isEmpty(changed) || !geom.same(device.exactBounds(layer), mask.bounds(cover)) { return 101 }
    var y = changed.y
    var differ = false
    while y < changed.y + changed.height {
        var x = changed.x
        while x < changed.x + changed.width {
            const amount = mask.at(cover, x, y)
            const shown = device.pixel(layer, x, y)
            if (amount == 0) != (shown == 0) || (amount == 255 && shown != 0xFF2040C0) || (shown != 0 && shown & 0xFFFFFF != 0x2040C0) { differ = true }
            x += 1
        }
        y += 1
    }
    if differ { return 102 }
    // Only where the selection is.
    const chosen = mask.create(allocator, false).?
    _ = device.fill(chosen, geom.rect(-100, 0, 100, 200), mask.ALL)
    const other = device.create(allocator, 0).?
    _ = textrender.paint(fonts, &style, "Hello", -30.0, 40.0, other, 0xFF2040C0, blend.NORMAL, 255, 0, chosen)
    const kept = device.exactBounds(other)
    if geom.isEmpty(kept) || kept.x + kept.width > 0 { return 103 }

    // Setting text again and again leaves the value arena as it was.
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: usize = 0
    while round < 60 {
        device.clear(cover)
        _ = textrender.coverage(fonts, &style, "Hello, World", 3.0, 70.0, cover)
        _ = textrender.paint(fonts, &style, "AV Typo\nwraps", 0.0, 0.0, other, 0xFF000000, blend.NORMAL, 128, 0, null)
        _ = textrender.measure(fonts, &style, "measure me")
        round += 1
    }
    if turns.used(arena) - before > 65536 { return 104 }
    device.destroy(cover)
    device.destroy(layer)
    device.destroy(chosen)
    device.destroy(other)
    return 0
}

// ---------------------------------------------------------------------------
// The text tool

fn layerCount(app: *App) -> usize {
    return node_module.childCount(api.image(app).?.*.root)
}

// Places a text at image point (x, y) by a click, types it and puts it
// on the image with Control and Enter.
fn writeAt(app: *App, x: f64, y: f64, words: []const u8) -> bool {
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, x, y, &wx, &wy)
    if !click(app, wx, wy) || !text_tool.editing(app) { return false }
    var text: [300]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 300, "type ")
    length = std.text.append(bytes, length, 300, words)
    length = std.text.append(bytes, length, 300, "\nkey Ctrl+Enter\n")
    return script.run(app, bytes[0..length]) && !text_tool.editing(app)
}

fn testText(app: *App, fonts: ?*textrender.Fonts) -> u8 {
    if !script.run(app, "tool text\ncolor 000000\n") || app.*.tool != text_tool.TEXT { return 110 }
    resetView(app)
    const style = text_tool.styleOf(app).?
    style.*.size = 40.0
    style.*.alignment = textrender.ALIGN_LEFT
    const image = api.image(app).?
    const layers = layerCount(app)
    const steps = history.stepsDone(image.*.history)
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, 40.0, 60.0, &wx, &wy)
    if !pointer(app, wx, wy) { return 111 }
    const before = areaHash(app)
    if !click(app, wx, wy) || !text_tool.editing(app) || !api.toolBusy(app) { return 112 }
    // Keys are the text's now: B does not choose the brush.
    if !script.run(app, "type Hellx\nkey Backspace\ntype o\n") || !std.text.same(text_tool.typedText(app), "Hello") || app.*.tool != text_tool.TEXT { return 113 }
    if fonts != null && areaHash(app) == before { return 114 }
    if !shot(app, "text.png") { return 115 }
    // Enter is a new line; Left and Delete take it away again.
    if !script.run(app, "key Enter\nkey Left\nkey Delete\n") || !std.text.same(text_tool.typedText(app), "Hello") { return 116 }
    if layerCount(app) != layers || history.stepsDone(image.*.history) != steps { return 117 }
    if !script.run(app, "key Ctrl+Enter\n") || text_tool.editing(app) || api.toolBusy(app) { return 118 }
    if fonts == null {
        // Without a font nothing is set.
        if layerCount(app) != layers { return 119 }
        return 0
    }
    // A new layer, the active one, named after the text, one step.
    if layerCount(app) != layers + 1 || history.stepsDone(image.*.history) != steps + 1 { return 120 }
    if !std.text.same(history.undoName(image.*.history), "Text") { return 121 }
    const layer = api.activeNode(app).?
    if !std.text.same(node_module.nameOf(layer), "Hello") || layer.*.kind != node_module.PAINT { return 122 }
    const bounds = device.exactBounds(layer.*.device.?)
    // (Measured with the tool's own fonts: the same list as the test's.)
    const own = text_tool.fontsOf(app)
    if own == null || textrender.count(own.?) != textrender.count(fonts.?) { return 155 }
    const extent = textrender.measure(own.?, style, "Hello")
    const width = @floatFromInt(f64, bounds.width)
    if geom.isEmpty(bounds) || width > extent.width + 1.0 || width < extent.width - 0.25 * style.*.size { return 123 }
    if bounds.x < 38 || bounds.x > 46 || bounds.y < 60 || bounds.y + bounds.height > 60 + @intFromFloat(i32, extent.height) + 1 { return 124 }
    // Dark where the letters are, and so is the image there.
    var solid: u32 = 0
    var sx: i32 = 0
    var sy: i32 = 0
    var y = bounds.y
    while y < bounds.y + bounds.height {
        var x = bounds.x
        while x < bounds.x + bounds.width {
            const value = device.pixel(layer.*.device.?, x, y)
            if value != 0 && value & 0xFFFFFF != 0 { return 125 }
            if value == 0xFF000000 {
                solid += 1
                sx = x
                sy = y
            }
            x += 1
        }
        y += 1
    }
    if solid < 80 { return 126 }
    _ = render.update(image)
    if device.pixel(image.*.projection, sx, sy) != 0xFF000000 || device.pixel(image.*.projection, 20, 20) != 0xFFFFFFFF { return 127 }
    // The overlay is gone: the frame shows the image's own pixels there.
    if !shot(app, "text-set.png") { return 128 }
    // One undo takes the layer away.
    if !script.run(app, "key Ctrl+Z\n") || layerCount(app) != layers || history.stepsDone(image.*.history) != steps { return 129 }
    _ = render.update(image)
    if device.pixel(image.*.projection, sx, sy) != 0xFFFFFFFF { return 130 }

    // Large text is taller than small text.
    style.*.size = 12.0
    if !writeAt(app, 20.0, 20.0, "Hi") { return 131 }
    const small = device.exactBounds(api.activeNode(app).?.*.device.?)
    style.*.size = 72.0
    if !writeAt(app, 20.0, 150.0, "Hi") { return 132 }
    const large = device.exactBounds(api.activeNode(app).?.*.device.?)
    if small.height < 6 || large.height < small.height * 4 { return 133 }
    if !script.run(app, "key Ctrl+Z\nkey Ctrl+Z\n") || layerCount(app) != layers { return 134 }

    // Centred: on the place clicked.
    style.*.size = 40.0
    style.*.alignment = textrender.ALIGN_CENTER
    if !writeAt(app, 200.0, 120.0, "Middle") { return 135 }
    const centred = device.exactBounds(api.activeNode(app).?.*.device.?)
    const middle = @floatFromInt(f64, centred.x) + @floatFromInt(f64, centred.width) / 2.0
    if !near(middle, 200.0, 3.0) { return 136 }
    if !shot(app, "text-centred.png") { return 137 }
    if !script.run(app, "key Ctrl+Z\n") { return 138 }
    style.*.alignment = textrender.ALIGN_LEFT

    // With a selection the text is only where it is.
    image.*.selected = true
    _ = device.fill(image.*.selection, geom.rect(0, 0, 230, 300), mask.ALL)
    image_module.selectionChanged(image)
    if !writeAt(app, 200.0, 40.0, "Selected") { return 156 }
    const cut = device.exactBounds(api.activeNode(app).?.*.device.?)
    if geom.isEmpty(cut) || cut.x + cut.width > 230 || cut.x > 205 { return 157 }
    device.clear(image.*.selection)
    image.*.selected = false
    image_module.selectionChanged(image)
    if !script.run(app, "key Ctrl+Z\n") || layerCount(app) != layers { return 158 }

    // A dragged box: its lines wrap at its width.
    var ax: i32 = 0
    var ay: i32 = 0
    var bx: i32 = 0
    var by: i32 = 0
    style.*.size = 24.0
    windowOf(app, 30.0, 120.0, &ax, &ay)
    windowOf(app, 150.0, 220.0, &bx, &by)
    if !drag(app, ax, ay, bx, by, 8) || !text_tool.editing(app) { return 139 }
    if !script.run(app, "type one two three four five\n") { return 140 }
    if !shot(app, "text-box.png") || !script.run(app, "key Ctrl+Enter\n") { return 141 }
    const boxed = device.exactBounds(api.activeNode(app).?.*.device.?)
    if boxed.x < 30 || boxed.x + boxed.width > 30 + (bx - ax) + 1 || boxed.height < 60 { return 142 }
    if !std.text.same(node_module.nameOf(api.activeNode(app).?), "one two three four five") { return 143 }
    if !script.run(app, "key Ctrl+Z\n") || layerCount(app) != layers { return 144 }
    // A long first word is cut for the name, not in a character.
    const long = "\xC3\x9Cberraschungsgr\xC3\xB6\xC3\x9Fen\xC3\xA4nderungsverfahren"
    style.*.size = 12.0
    if !writeAt(app, 10.0, 250.0, long) { return 159 }
    const title = node_module.nameOf(api.activeNode(app).?)
    if title.length < 24 || title.length > 32 || !std.text.startsWith(long, title) || long[title.length] & 192 == 128 { return 171 }
    if !script.run(app, "key Ctrl+Z\n") || layerCount(app) != layers { return 172 }

    // Escape while typing leaves nothing behind, on the image or over it.
    if !pointer(app, wx, wy) { return 145 }
    const quiet = areaHash(app)
    if !click(app, wx, wy) || !script.run(app, "type abc\n") || areaHash(app) == quiet { return 146 }
    if !script.run(app, "key Escape\n") || text_tool.editing(app) || api.toolBusy(app) { return 147 }
    if layerCount(app) != layers || history.stepsDone(image.*.history) != steps || areaHash(app) != quiet { return 148 }
    // A click beside the box puts the text on the image; a click in it
    // moves the caret.
    style.*.size = 40.0
    if !click(app, wx, wy) || !script.run(app, "type Hello\n") { return 149 }
    if !click(app, wx + 2, wy + 20) || !text_tool.editing(app) || std.text.same(text_tool.typedText(app), "") { return 150 }
    if !script.run(app, "type X\n") || std.text.same(text_tool.typedText(app), "HelloX") || text_tool.typedText(app).length != 6 { return 151 }
    if !click(app, wx + 300, wy + 150) || text_tool.editing(app) || layerCount(app) != layers + 1 { return 152 }
    // Another tool also puts it there.
    windowOf(app, 60.0, 200.0, &ax, &ay)
    if !click(app, ax, ay) || !script.run(app, "type more\ntool zoom\n") || layerCount(app) != layers + 2 { return 153 }
    if !script.run(app, "key Ctrl+Z\nkey Ctrl+Z\n") || layerCount(app) != layers { return 154 }
    return 0
}

// ---------------------------------------------------------------------------
// The options

// One frame of the widgets drawn by hand: every tool's options side by
// side in panels as the Tool Options docker shows them, each `wide`
// pixels across and `high` pixels down (also on a layout pass's canvas,
// which has no pixels). The tallest returned in `tallest`.
fn optionsFrame(app: *App, canvas: *state.Canvas, wide: i32, high: i32, tallest: *i32) -> void {
    const widgets = state.uiOf(app)
    const kit = api.kit(app)
    view_module.begin(widgets, canvas)
    kit_module.begin(kit, widgets, canvas, state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app), @intCast(u64, app.*.time), app.*.german)
    const theme = state.themeOf(app)
    if canvas.*.width > 0 { canvas_module.clear(canvas, theme.*.background) }
    const order = [5]u8{ views.ZOOM, views.PAN, views.MEASURE, views.ROTATE, text_tool.TEXT }
    tallest.* = 0
    var index: usize = 0
    while index < 5 {
        const tool = registry.find(order[index]).?
        const panel = ui.rect(@intCast(i32, index) * (wide + 4), 0, wide, high)
        canvas_module.fillRect(canvas, panel.x, panel.y, panel.width, panel.height, theme.*.panel)
        const inner = ui.rect(panel.x + 8, panel.y + 8, panel.width - 16, panel.height - 16)
        kit_module.clipBegin(kit, inner)
        const height = tool.*.options.?(app, inner)
        kit_module.clipEnd(kit)
        if height > tallest.* { tallest.* = height }
        index += 1
    }
    _ = kit_module.end(kit)
    _ = view_module.end(widgets)
}

fn testOptions(app: *App) -> u8 {
    const allocator = std.heap.allocator()
    const wide: i32 = 260
    const width: usize = 5 * 264
    const height: usize = 560
    const memory = allocator.alloc(width * height * 4, 16)
    if memory == null { return 160 }
    const pixels: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    var canvas = state.Canvas.{ .pixels = pixels, .width = width, .height = height, .stride = width, .swapRedBlue = false, .device = 0, .opacity = 255 }
    // A measure to show, a text being typed (its Apply and Cancel).
    if !script.run(app, "tool measure\n") { return 161 }
    resetView(app)
    var ax: i32 = 0
    var ay: i32 = 0
    windowOf(app, 50.0, 100.0, &ax, &ay)
    if !drag(app, ax, ay, ax + 180, ay - 60, 6) { return 162 }
    if !script.run(app, "tool text\n") { return 163 }
    windowOf(app, 60.0, 60.0, &ax, &ay)
    if !click(app, ax, ay) || !script.run(app, "type Draft\n") { return 164 }
    var tallest: i32 = 0
    optionsFrame(app, &canvas, wide, @intCast(i32, height), &tallest)
    if tallest <= 0 || tallest > @intCast(i32, height) - 16 { return 165 }
    if !save("options-dark.png", pixels, width, height) { return 166 }
    // The layout pass names the regions; a click on the second alignment
    // button (centred) takes in the frame after.
    var layout = view_module.layoutCanvas()
    optionsFrame(app, &layout, wide, @intCast(i32, height), &tallest)
    const s = if app.*.scale > 0 { app.*.scale } else { 1 }
    const row = kit_module.ROW * s
    const panel_x = 4 * (wide + 4) + 8
    const named = if (wide - 16) * 2 / 5 < 84 * s { (wide - 16) * 2 / 5 } else { 84 * s }
    const button_x = panel_x + named + (row + 2 * s) + row / 2
    const button_y = 8 + 2 * (row + 4 * s) + row / 2
    const widgets = state.uiOf(app)
    _ = view_module.pointerMove(widgets, button_x, button_y)
    _ = view_module.pointerButton(widgets, true)
    _ = view_module.pointerButton(widgets, false)
    optionsFrame(app, &canvas, wide, @intCast(i32, height), &tallest)
    // (And it is kept for the next run, by its number.)
    if text_tool.styleOf(app).?.*.alignment != textrender.ALIGN_CENTER || !std.text.same(settings.text(app, "tool.text.align"), "1") { return 167 }
    text_tool.styleOf(app).?.*.alignment = textrender.ALIGN_LEFT
    // Light and German.
    app.*.theme = theme_module.scaled(theme_module.light(), app.*.scale)
    app.*.german = true
    optionsFrame(app, &canvas, wide, @intCast(i32, height), &tallest)
    if tallest <= 0 || tallest > @intCast(i32, height) - 16 { return 168 }
    if !save("options-light-de.png", pixels, width, height) { return 169 }
    app.*.theme = theme_module.scaled(theme_module.dark(), app.*.scale)
    app.*.german = false
    if !script.run(app, "key Escape\n") || text_tool.editing(app) { return 170 }
    allocator.free(memory.?, width * height * 4, 16)
    return 0
}

// ---------------------------------------------------------------------------
// textrender at its edges

// A hash of a device's pixels over `area`.
fn deviceHash(target: *device.Device, area: geom.Rect) -> u64 {
    var hash: u64 = 1469598103934665603
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            hash = (hash ^ @intCast(u64, device.pixel(target, x, y))) *% 1099511628211
            x += 1
        }
        y += 1
    }
    return hash
}

// Whether two devices have the same pixels over `area`.
fn samePixels(a: *device.Device, b: *device.Device, area: geom.Rect) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if device.pixel(a, x, y) != device.pixel(b, x, y) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// Whether `text` set at (x, y) into a mask has the amounts it has set
// into a buffer of bytes whose first is image pixel (bx, by), `width` x
// `height` of them (the two ways are written apart in textrender), and
// nothing of it lies outside the buffer.
fn sameAsBytes(fonts: *textrender.Fonts, style: *const textrender.Style, text: []const u8, x: f64, y: f64, bx: i32, by: i32, width: usize, height: usize) -> bool {
    const allocator = std.heap.allocator()
    const bytes = allocator.alloc(width * height, 16)
    if bytes == null { return false }
    std.mem.zero(bytes.?, width * height)
    const m = mask.create(allocator, false).?
    var same = textrender.render(fonts, style, text, x - @floatFromInt(f64, bx), y - @floatFromInt(f64, by), bytes.?, width, height, width)
    const covered = textrender.coverage(fonts, style, text, x, y, m)
    const buffer = geom.rect(bx, by, @intCast(i32, width), @intCast(i32, height))
    if geom.isEmpty(covered) || !geom.same(geom.intersect(covered, buffer), covered) || !geom.same(geom.intersect(mask.bounds(m), covered), mask.bounds(m)) { same = false }
    var row: usize = 0
    while row < height && same {
        var column: usize = 0
        while column < width {
            if mask.at(m, bx + @intCast(i32, column), by + @intCast(i32, row)) != @intCast(u32, bytes.?[row * width + column]) { same = false }
            column += 1
        }
        row += 1
    }
    device.destroy(m)
    allocator.free(bytes.?, width * height, 16)
    return same
}

// Every boundary between characters of `text` (set at (x, y)): the caret
// there and a click at the caret find each other.
fn caretsRoundTrip(fonts: *textrender.Fonts, style: *const textrender.Style, text: []const u8) -> bool {
    var offset: usize = 0
    while offset <= text.length {
        if offset == text.length || text[offset] & 192 != 128 {
            var cx: f64 = 0.0
            var cy: f64 = 0.0
            var tall: f64 = 0.0
            if !textrender.caretAt(fonts, style, text, 7.0, -3.0, offset, &cx, &cy, &tall) { return false }
            if textrender.offsetAt(fonts, style, text, 7.0, -3.0, cx, cy + tall / 2.0) != offset { return false }
        }
        offset += 1
    }
    return true
}

fn testRenderEdges(fonts: *textrender.Fonts) -> u8 {
    const allocator = std.heap.allocator()
    var style = textrender.defaultStyle()
    // (40 / 2048 of an em is a fraction a double holds exactly: the two
    // ways of setting place every glyph on the same pixel.)
    style.size = 40.0
    // Bytes and a mask agree at negative places and across tile borders.
    if !sameAsBytes(fonts, &style, "Wg,\xC3\x84\xC3\xB6y", -64.25, 63.5, -100, 20, 420, 140) { return 173 }
    if !sameAsBytes(fonts, &style, "Tile\nborders", -0.5, -40.75, -80, -80, 400, 200) { return 174 }
    style.alignment = textrender.ALIGN_RIGHT
    if !sameAsBytes(fonts, &style, "right", 127.75, -64.0, -80, -100, 300, 150) { return 175 }
    style.alignment = textrender.ALIGN_LEFT
    style.antialias = false
    if !sameAsBytes(fonts, &style, "sharp", 63.75, 64.25, 0, 0, 300, 200) { return 176 }
    style.antialias = true

    // Nothing to set: no pixel, no rectangle.
    const bytes = allocator.alloc(64, 16).?
    std.mem.zero(bytes, 64)
    if !textrender.render(fonts, &style, "", 0.0, 0.0, bytes, 8, 8, 8) || !textrender.render(fonts, &style, "  \n \n", 0.0, 0.0, bytes, 8, 8, 8) { return 177 }
    if !textrender.render(fonts, &style, "Hello", 0.0, 0.0, bytes, 0, 0, 0) { return 177 }
    var index: usize = 0
    while index < 64 {
        if bytes[index] != 0 { return 177 }
        index += 1
    }
    // A buffer of one byte takes what lies on it.
    if !textrender.render(fonts, &style, "|", -10.0, -10.0, bytes, 1, 1, 1) || bytes[1] != 0 { return 177 }
    allocator.free(bytes, 64, 16)
    const blanks = textrender.measure(fonts, &style, "  \n \n")
    if blanks.lines != 3 || blanks.width != 0.0 { return 180 }
    const m = mask.create(allocator, false).?
    if !geom.isEmpty(textrender.coverage(fonts, &style, "", 5.0, 5.0, m)) || !geom.isEmpty(textrender.coverage(fonts, &style, " \n\t ", 5.0, 5.0, m)) || !mask.isNothing(m) { return 180 }
    const layer = device.create(allocator, 0).?
    if !geom.isEmpty(textrender.paint(fonts, &style, "", 5.0, 5.0, layer, 0xFF000000, blend.NORMAL, 255, 0, null)) || !device.isBlank(layer) { return 180 }

    // Places beyond what is set (huge, not a number): nothing, no fault.
    const far = [4]f64{ 1.0e12, -1.0e12, 3.0e9, math.nan() }
    index = 0
    while index < 4 {
        if !geom.isEmpty(textrender.coverage(fonts, &style, "far", far[index], 10.0, m)) || !geom.isEmpty(textrender.coverage(fonts, &style, "far", 10.0, far[index], m)) { return 183 }
        if !geom.isEmpty(textrender.paint(fonts, &style, "far", far[index], far[index], layer, 0xFF000000, blend.NORMAL, 255, 0, null)) { return 183 }
        index += 1
    }
    if !mask.isNothing(m) || !device.isBlank(layer) { return 183 }
    // Far, but within the image's reach: set there.
    const distant = textrender.coverage(fonts, &style, "I", 900000000.0, -900000000.0, m)
    if geom.isEmpty(distant) || distant.x < 900000000 || distant.x > 900000010 || distant.y < -900000000 || distant.y > -899999960 { return 186 }
    if mask.at(m, distant.x + distant.width / 2, distant.y + distant.height / 2) != 255 { return 186 }
    device.clear(m)

    // The smallest and the largest sizes.
    style.size = 1.0
    if textrender.coverage(fonts, &style, "Hello", 0.0, 0.0, m).width > 6 { return 188 }
    device.clear(m)
    style.size = 1000.0
    const huge = textrender.measure(fonts, &style, "W")
    if huge.height != huge.ascent + huge.descent || huge.ascent < 600.0 || huge.ascent > 1200.0 { return 189 }
    const w = textrender.coverage(fonts, &style, "W", 0.0, 0.0, m)
    // (A capital stands on the baseline, its top-left corner inked.)
    if w.y < 0 || w.y + w.height > @intFromFloat(i32, huge.ascent) + 1 || w.y + w.height < @intFromFloat(i32, huge.ascent) - 1 || w.height < 600 || mask.at(m, w.x + 3, w.y + 3) != 255 { return 190 }
    device.clear(m)
    style.size = 40.0

    // Right aligned in a box: the lines end at its right edge.
    style.alignment = textrender.ALIGN_RIGHT
    style.wrap = 200.0
    const boxed = textrender.coverage(fonts, &style, "ab\nlonger line", 10.0, 0.0, m)
    if boxed.x + boxed.width > 211 || boxed.x + boxed.width < 202 || boxed.x < 10 { return 191 }
    device.clear(m)
    style.alignment = textrender.ALIGN_LEFT
    style.wrap = 0.0

    // Letters drawn back over each other: the box is as wide as the
    // farthest right any letter reaches (the first), never below zero.
    style.letterSpacing = -1000.0
    const back = textrender.measure(fonts, &style, "Hello")
    if back.width != textrender.measure(fonts, &style, "H").width || back.width <= 0.0 { return 192 }
    style.letterSpacing = 0.0

    // The caret and the click at every boundary, on lines broken at line
    // feeds, inside a word and between words.
    if !caretsRoundTrip(fonts, &style, "A\xC3\xA4\xE2\x82\xAC\n\nxy\xF0\x9F\x98\x80z") { return 193 }
    style.wrap = 60.0
    if !caretsRoundTrip(fonts, &style, "abcdefghij") { return 194 }
    style.alignment = textrender.ALIGN_CENTER
    if !caretsRoundTrip(fonts, &style, "wrapped centred lines") { return 195 }
    style.alignment = textrender.ALIGN_LEFT
    style.wrap = 0.0

    // A selection whose default is all is as no selection; a layer moved
    // elsewhere gets the same pixels in the image; while a change is open
    // the text can be taken back and done again exactly.
    const plain = device.create(allocator, 0).?
    const area = textrender.paint(fonts, &style, "Same\npixels", -70.0, 30.0, plain, 0xC0805020, blend.NORMAL, 200, 0, null)
    const around = geom.grown(area, 2)
    const everywhere = mask.create(allocator, true).?
    const chosen = device.create(allocator, 0).?
    if !geom.same(textrender.paint(fonts, &style, "Same\npixels", -70.0, 30.0, chosen, 0xC0805020, blend.NORMAL, 200, 0, everywhere), area) || !samePixels(plain, chosen, around) { return 196 }
    const moved = device.create(allocator, 0).?
    device.moveTo(moved, 37, -70)
    _ = textrender.paint(fonts, &style, "Same\npixels", -70.0, 30.0, moved, 0xC0805020, blend.NORMAL, 200, 0, null)
    if !samePixels(plain, moved, around) { return 197 }
    const recorded = device.create(allocator, 0).?
    device.begin(recorded)
    _ = textrender.paint(fonts, &style, "Same\npixels", -70.0, 30.0, recorded, 0xC0805020, blend.NORMAL, 200, 0, null)
    _ = device.rollback(recorded)
    if !device.isBlank(recorded) { return 198 }
    device.begin(recorded)
    _ = textrender.paint(fonts, &style, "Same\npixels", -70.0, 30.0, recorded, 0xC0805020, blend.NORMAL, 200, 0, null)
    const change = device.commit(recorded)
    if change == null || !samePixels(plain, recorded, around) { return 199 }
    _ = device.apply(recorded, change.?, true)
    if !device.isBlank(recorded) { return 200 }
    _ = device.apply(recorded, change.?, false)
    if !samePixels(plain, recorded, around) { return 201 }
    device.destroyChange(change.?)

    // Twice the same: the mask's coverage is as after once; opaque
    // letters stay as they are.
    const once = textrender.coverage(fonts, &style, "Twice", 3.25, 5.5, m)
    const first = deviceHash(m, geom.grown(once, 1))
    if !geom.same(textrender.coverage(fonts, &style, "Twice", 3.25, 5.5, m), once) || deviceHash(m, geom.grown(once, 1)) != first { return 202 }
    device.clear(m)
    const solid = device.create(allocator, 0).?
    const inked = textrender.paint(fonts, &style, "Twice", 3.25, 5.5, solid, 0xFF102030, blend.NORMAL, 255, 0, null)
    const again = device.copy(solid).?
    _ = textrender.paint(fonts, &style, "Twice", 3.25, 5.5, again, 0xFF102030, blend.NORMAL, 255, 0, null)
    var y = inked.y
    while y < inked.y + inked.height {
        var x = inked.x
        while x < inked.x + inked.width {
            if device.pixel(solid, x, y) == 0xFF102030 && device.pixel(again, x, y) != 0xFF102030 { return 203 }
            x += 1
        }
        y += 1
    }
    // A colour of alpha 0 and an opacity of 0 leave nothing to see.
    const clear = device.create(allocator, 0).?
    _ = textrender.paint(fonts, &style, "Ghost", 0.0, 0.0, clear, 0x00FF0000, blend.NORMAL, 255, 0, null)
    const ghost = device.exactBounds(clear)
    y = ghost.y
    while y < ghost.y + ghost.height {
        var x = ghost.x
        while x < ghost.x + ghost.width {
            if device.pixel(clear, x, y) >> 24 != 0 { return 204 }
            x += 1
        }
        y += 1
    }
    if !geom.isEmpty(textrender.paint(fonts, &style, "Ghost", 0.0, 0.0, layer, 0xFF000000, blend.NORMAL, 0, 0, null)) || !device.isBlank(layer) { return 205 }

    // The list of fonts: every name finds its font (or the first of that
    // name), an unknown one none, past the last there is no name.
    const total = textrender.count(fonts)
    if total == 0 || total > textrender.FONTS || textrender.name(fonts, total).length != 0 { return 206 }
    index = 0
    while index < total {
        const named = textrender.name(fonts, index)
        if named.length == 0 || textrender.find(fonts, named) > index || !std.text.same(textrender.name(fonts, textrender.find(fonts, named)), named) { return 207 }
        index += 1
    }
    if textrender.find(fonts, "No Such Font") != total || textrender.usable(fonts, total + 7) >= total { return 208 }
    // Setting a long text takes nothing of the value arena a glyph.
    if !longTextArena(fonts, 16384) { return 202 }

    device.destroy(m)
    device.destroy(layer)
    device.destroy(plain)
    device.destroy(everywhere)
    device.destroy(chosen)
    device.destroy(moved)
    device.destroy(recorded)
    device.destroy(solid)
    device.destroy(again)
    device.destroy(clear)
    return 0
}

// A text of 2000 characters set once into a mask: the value arena grows
// by less than `most` bytes (nothing a glyph).
fn longTextArena(fonts: *textrender.Fonts, most: usize) -> bool {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(2000, 16).?
    var index: usize = 0
    while index < 2000 {
        memory[index] = if index % 50 == 49 { 10 } else if index % 7 == 6 { 32 } else { @intCast(u8, 97 + index % 26) }
        index += 1
    }
    var style = textrender.defaultStyle()
    style.size = 9.0
    const m = mask.create(allocator, false).?
    const arena = turns.locate()
    const before = turns.used(arena)
    const area = textrender.coverage(fonts, &style, memory[0..2000], -10.0, -10.0, m)
    const grown = turns.used(arena) - before
    device.destroy(m)
    allocator.free(memory, 2000, 16)
    return !geom.isEmpty(area) && grown < most
}

// The value arena taken by the text tool's marks drawn 100 times over the
// same frame (a text being typed, its box, its caret; the loop gives it
// back at every turn).
fn overlayArena(app: *App) -> usize {
    const tool = registry.find(text_tool.TEXT).?
    const frame = script.frameOf(app).?
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: usize = 0
    while round < 100 {
        if round % 25 == 0 { _ = text_tool.styleOf(app) }
        tool.*.overlay.?(app, frame)
        round += 1
    }
    return turns.used(arena) - before
}

// What textrender takes from the heap it gives back: fonts made, used and
// destroyed, again and again, leave the heap as it was (once the tiles'
// pool holds what a mask's tiles take).
fn testRenderMemory() -> u8 {
    const allocator = std.heap.allocator()
    var round: usize = 0
    var before: usize = 0
    while round < 6 {
        if round == 1 { before = std.heap.liveBytes() }
        const fonts = textrender.create(allocator)
        if fonts == null { return 209 }
        var style = textrender.defaultStyle()
        style.size = 30.0
        _ = textrender.measure(fonts.?, &style, "measured")
        const layer = device.create(allocator, 0).?
        _ = textrender.paint(fonts.?, &style, "painted\nand gone", 0.0, 0.0, layer, 0xFF000000, blend.NORMAL, 255, 0, null)
        device.destroy(layer)
        textrender.destroy(fonts.?)
        round += 1
    }
    if std.heap.liveBytes() != before { return 210 }
    return 0
}

// ---------------------------------------------------------------------------
// The text tool at its edges

// A hash of what the image shows, all of it.
fn imageHash(app: *App) -> u64 {
    const image = api.image(app).?
    _ = render.update(image)
    return deviceHash(image.*.projection, geom.rect(0, 0, image.*.width, image.*.height))
}

fn framePixel(app: *App, wx: i32, wy: i32) -> u32 {
    const frame = script.frameOf(app).?
    return frame.*.pixels[@intCast(usize, wy) * frame.*.stride + @intCast(usize, wx)]
}

// Whether every channel of `a` is within `within` of `b`'s.
fn channelsNear(a: u32, b: u32, within: u32) -> bool {
    var shift: u32 = 0
    while shift < 32 {
        const x = (a >> shift) & 255
        const y = (b >> shift) & 255
        if x > y + within || y > x + within { return false }
        shift += 8
    }
    return true
}

// `data` on the clipboard as text, then Control and V.
fn paste(app: *App, data: []const u8) -> bool {
    if !shell_module.setClipboard(app.*.shell, "text/plain;charset=utf-8", data) { return false }
    return script.run(app, "key Ctrl+V\n")
}

fn testTextEdges(app: *App) -> u8 {
    const allocator = std.heap.allocator()
    if !script.run(app, "tool text\ncolor 000000\n") { return 211 }
    resetView(app)
    const style = text_tool.styleOf(app).?
    style.*.size = 40.0
    style.*.alignment = textrender.ALIGN_LEFT
    style.*.letterSpacing = 0.0
    style.*.lineSpacing = 1.0
    style.*.antialias = true
    const image = api.image(app).?
    const layers = layerCount(app)
    const steps = history.stepsDone(image.*.history)
    const fonts = text_tool.fontsOf(app).?
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, 40.0, 60.0, &wx, &wy)
    // Pasted: line feeds stay, a tab is a blank, carriage returns and the
    // other control characters go.
    if !click(app, wx, wy) || !paste(app, "a\r\nb\tc\x01d\x7F") || !std.text.same(text_tool.typedText(app), "a\nb cd") { return 212 }
    // Left, Right and Backspace step over whole characters.
    if !script.run(app, "key Escape\n") || !click(app, wx, wy) || !paste(app, "a\xC3\xA4\xE2\x82\xAC") { return 213 }
    if !script.run(app, "key Left\ntype x\n") || !std.text.same(text_tool.typedText(app), "a\xC3\xA4x\xE2\x82\xAC") { return 214 }
    if !script.run(app, "key Right\nkey Backspace\nkey Left\nkey Backspace\n") || !std.text.same(text_tool.typedText(app), "ax") { return 215 }
    // Home, End, Up and Down by the lines as they are set (each line
    // below is wider than the one above where the caret leaves it).
    if !script.run(app, "key Escape\n") || !click(app, wx, wy) { return 216 }
    if !script.run(app, "type abc\nkey Enter\ntype defgh\nkey Up\ntype 1\nkey Home\ntype 2\nkey Home\nkey Down\ntype 3\nkey End\nkey Up\ntype 4\nkey Down\nkey Down\ntype 5\nkey Up\nkey Up\nkey Up\ntype 6\n") { return 216 }
    if !std.text.same(text_tool.typedText(app), "62abc14\n3defgh5") { return 217 }
    // A click in the box: the caret goes to the boundary nearest to it.
    if !script.run(app, "key Escape\n") || !click(app, wx, wy) || !script.run(app, "type Hello\n") { return 218 }
    var ax: f64 = 0.0
    var ay: f64 = 0.0
    imageAt(app, wx, wy, &ax, &ay)
    var styled = style.*
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var tall: f64 = 0.0
    if !textrender.caretAt(fonts, &styled, "Hello", ax, ay, 2, &cx, &cy, &tall) { return 219 }
    var kx: i32 = 0
    var ky: i32 = 0
    windowOf(app, cx, cy + tall / 2.0, &kx, &ky)
    if !click(app, kx, ky) || !script.run(app, "type X\n") || !std.text.same(text_tool.typedText(app), "HeXllo") { return 220 }
    if !script.run(app, "key Escape\n") || layerCount(app) != layers || history.stepsDone(image.*.history) != steps { return 221 }

    // Typed to the brim: what does not fit stays out, whole characters,
    // and the status bar says why.
    style.*.size = 6.0
    const full = allocator.alloc(text_tool.CAPACITY, 16).?
    std.mem.set(full, 97, text_tool.CAPACITY)
    if !click(app, wx, wy) || !paste(app, full[0..text_tool.CAPACITY - 1]) || text_tool.typedText(app).length != text_tool.CAPACITY - 1 { return 222 }
    if !paste(app, "\xC3\xA4") || text_tool.typedText(app).length != text_tool.CAPACITY - 1 || !std.text.contains(api.noteOf(app), "longer") { return 223 }
    if !script.run(app, "type b\ntype c\n") || text_tool.typedText(app).length != text_tool.CAPACITY || text_tool.typedText(app)[text_tool.CAPACITY - 1] != 98 { return 224 }
    // A text that full is one step and one layer all the same, named
    // after its first 32 bytes.
    if !script.run(app, "key Ctrl+Enter\n") || text_tool.editing(app) || layerCount(app) != layers + 1 || history.stepsDone(image.*.history) != steps + 1 { return 225 }
    if !std.text.same(node_module.nameOf(api.activeNode(app).?), full[0..32]) || !script.run(app, "key Ctrl+Z\n") || layerCount(app) != layers { return 225 }
    allocator.free(full, text_tool.CAPACITY, 16)
    style.*.size = 40.0

    // Undo takes all of it back, redo puts the same back.
    const clean = imageHash(app)
    if !writeAt(app, 40.0, 60.0, "Exact") { return 226 }
    const written = imageHash(app)
    if written == clean { return 227 }
    if !script.run(app, "key Ctrl+Z\n") || imageHash(app) != clean || layerCount(app) != layers { return 228 }
    if !script.run(app, "key Ctrl+Shift+Z\n") || imageHash(app) != written || layerCount(app) != layers + 1 { return 229 }
    if !script.run(app, "key Ctrl+Z\n") || imageHash(app) != clean { return 230 }
    // The frame is as before it all: box, caret and letters are gone.
    if !pointer(app, wx, wy) { return 230 }
    const before_frame = areaHash(app)
    if !writeAt(app, 40.0, 60.0, "Gone") || !script.run(app, "key Ctrl+Z\n") || !pointer(app, wx, wy) || areaHash(app) != before_frame { return 230 }

    // What shows while it is typed is what the layer shows after (at zoom
    // 1, upright: window pixel for image pixel).
    // (What the marks take of the value arena a frame does not grow with
    // the text: no glyph, no pixel takes any.)
    if !click(app, wx, wy) || !script.run(app, "type Live\n") { return 231 }
    const short = overlayArena(app)
    if !paste(app, "a longer text of many words, set again and again while it is drawn\nwith a second line") || overlayArena(app) != short || short > 100 * 256 { return 231 }
    if !script.run(app, "key Escape\n") || !click(app, wx, wy) || !script.run(app, "type Live\nkey Home\n") { return 231 }
    styled = style.*
    const cover = mask.create(allocator, false).?
    _ = textrender.coverage(fonts, &styled, "Live", ax, ay, cover)
    const inked = mask.bounds(cover)
    device.destroy(cover)
    // (The pointer away from the letters: its cross is in the frame.)
    if geom.isEmpty(inked) || !pointer(app, wx + 250, wy + 150) { return 232 }
    const shown = allocator.alloc(@intCast(usize, inked.width * inked.height) * 4, 16).?
    const live: [*]u32 = unsafe { @ptrCast([*]u32, shown) }
    var ox: i32 = 0
    var oy: i32 = 0
    windowOf(app, 0.5, 0.5, &ox, &oy)
    var y: i32 = 0
    while y < inked.height {
        var x: i32 = 0
        while x < inked.width {
            live[@intCast(usize, y * inked.width + x)] = framePixel(app, ox + inked.x + x, oy + inked.y + y)
            x += 1
        }
        y += 1
    }
    if !script.run(app, "key Ctrl+Enter\n") || layerCount(app) != layers + 1 { return 233 }
    var dark: usize = 0
    y = 0
    while y < inked.height {
        var x: i32 = 0
        while x < inked.width {
            const now = framePixel(app, ox + inked.x + x, oy + inked.y + y)
            if !channelsNear(now, live[@intCast(usize, y * inked.width + x)], 2) { return 234 }
            if now & 0xFF == 0 { dark += 1 }
            x += 1
        }
        y += 1
    }
    allocator.free(shown, @intCast(usize, inked.width * inked.height) * 4, 16)
    if dark < 40 || !script.run(app, "key Ctrl+Z\n") { return 235 }

    // Turned and zoomed: the text is set where it was clicked in the image.
    const view = viewOf(app)
    view.*.zoom = 2.0
    view.*.rotation = 0.5
    api.redraw(app)
    windowOf(app, 100.0, 80.0, &kx, &ky)
    if !click(app, kx, ky) || !script.run(app, "type Hi\nkey Ctrl+Enter\n") { return 236 }
    imageAt(app, kx, ky, &ax, &ay)
    styled = style.*
    const where = mask.create(allocator, false).?
    _ = textrender.coverage(fonts, &styled, "Hi", ax, ay, where)
    if !geom.same(mask.bounds(where), device.exactBounds(api.activeNode(app).?.*.device.?)) { return 237 }
    device.destroy(where)
    if !shot(app, "text-turned.png") || !script.run(app, "key Ctrl+Z\n") || layerCount(app) != layers { return 238 }
    resetView(app)

    // Escape while a box is being dragged out: nothing is left.
    if !pointer(app, wx, wy) { return 239 }
    const quiet = areaHash(app)
    if !script.run(app, "press\n") || !pointer(app, wx + 80, wy + 50) || !api.toolBusy(app) { return 240 }
    if !script.run(app, "key Escape\n") || api.toolBusy(app) || !script.run(app, "release\n") || text_tool.editing(app) { return 241 }
    if !pointer(app, wx, wy) || areaHash(app) != quiet || layerCount(app) != layers || history.stepsDone(image.*.history) != steps { return 242 }
    return 0
}

// Every tool's options in panels narrower than anything sensible (none
// wide at all): drawn, laid out, never a fault.
fn testNarrowOptions(app: *App) -> u8 {
    const allocator = std.heap.allocator()
    if !script.run(app, "tool text\n") { return 243 }
    var ax: i32 = 0
    var ay: i32 = 0
    windowOf(app, 60.0, 60.0, &ax, &ay)
    if !click(app, ax, ay) || !script.run(app, "type Narrow\n") { return 244 }
    const widths = [4]i32{ 0, 1, 12, 40 }
    const memory = allocator.alloc(5 * 60 * 400 * 4, 16).?
    const pixels: [*]u32 = unsafe { @ptrCast([*]u32, memory) }
    var index: usize = 0
    while index < 4 {
        const wide = widths[index]
        var canvas = state.Canvas.{ .pixels = pixels, .width = @intCast(usize, 5 * (wide + 4)), .height = 400, .stride = 5 * 60, .swapRedBlue = false, .device = 0, .opacity = 255 }
        var tallest: i32 = 0
        optionsFrame(app, &canvas, wide, 400, &tallest)
        if tallest < 0 { return 245 }
        var layout = view_module.layoutCanvas()
        optionsFrame(app, &layout, wide, 400, &tallest)
        if tallest < 0 { return 246 }
        index += 1
    }
    allocator.free(memory, 5 * 60 * 400 * 4, 16)
    if !script.run(app, "key Escape\n") || text_tool.editing(app) { return 247 }
    return 0
}

// A text being typed when another document comes to the front is
// dropped: the keys, the shortcuts and undo are that document's again,
// and nothing goes into either image.
fn testTextOtherImage(app: *App) -> u8 {
    if !script.run(app, "tool text\n") { return 178 }
    resetView(app)
    const image = api.image(app).?
    const layers = layerCount(app)
    const steps = history.stepsDone(image.*.history)
    var ax: i32 = 0
    var ay: i32 = 0
    windowOf(app, 60.0, 60.0, &ax, &ay)
    if !click(app, ax, ay) || !script.run(app, "type Lost\n") || !text_tool.editing(app) { return 179 }
    if !script.run(app, "new 120 80 FFFFFF\n") || api.image(app).? == image { return 181 }
    if text_tool.editing(app) || api.toolBusy(app) { return 182 }
    // B chooses the brush again (and the text tool, let go, sets nothing).
    const fresh = layerCount(app)
    if !script.run(app, "key B\n") || app.*.tool == text_tool.TEXT || layerCount(app) != fresh { return 184 }
    if !script.run(app, "action file_close\n") || api.image(app).? != image { return 185 }
    if layerCount(app) != layers || history.stepsDone(image.*.history) != steps { return 187 }
    return 0
}

// ---------------------------------------------------------------------------
// The view tools at their edges

fn testViewEdges(app: *App) -> u8 {
    const view = viewOf(app)
    var mx: i32 = 0
    var my: i32 = 0
    middleOfArea(app, &mx, &my)
    // Pan, turned, mirrored and zoomed: the image point under the press is
    // under the release.
    if !script.run(app, "tool pan\n") { return 248 }
    resetView(app)
    view.*.zoom = 1.5
    view.*.rotation = 0.6
    view.*.mirror = true
    api.redraw(app)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    imageAt(app, mx - 40, my + 10, &x0, &y0)
    if !drag(app, mx - 40, my + 10, mx + 60, my + 50, 7) { return 249 }
    imageAt(app, mx + 60, my + 50, &x1, &y1)
    if !near(x0, x1, 0.000001) || !near(y0, y1, 0.000001) { return 250 }
    // Zoom, turned and mirrored: the point under the click stays; at the
    // largest zoom a click changes nothing.
    if !script.run(app, "tool zoom\n") { return 251 }
    imageAt(app, mx + 30, my - 20, &x0, &y0)
    if !click(app, mx + 30, my - 20) || !near(view.*.zoom, 3.0, 0.000001) { return 252 }
    imageAt(app, mx + 30, my - 20, &x1, &y1)
    if !near(x0, x1, 0.000001) || !near(y0, y1, 0.000001) { return 253 }
    view.*.zoom = viewport.LARGEST
    imageAt(app, mx + 30, my - 20, &x0, &y0)
    if !script.run(app, "wait 500\n") || !click(app, mx + 30, my - 20) || view.*.zoom != viewport.LARGEST { return 254 }
    imageAt(app, mx + 30, my - 20, &x1, &y1)
    if !near(x0, x1, 0.000001) || !near(y0, y1, 0.000001) { return 255 }
    resetView(app)
    return 0
}

// Zooming out into a rectangle (Alt and a drag): what the canvas showed
// fits into the rectangle, its middle in the rectangle's middle; the
// measure in a turned and zoomed view is in the image's pixels; Rotate
// View's double click keeps the image point in the middle; the hand's
// zoom keeps to the zoom's limits.
fn testViewEdgesMore(app: *App) -> u8 {
    const view = viewOf(app)
    var mx: i32 = 0
    var my: i32 = 0
    middleOfArea(app, &mx, &my)
    if !script.run(app, "tool zoom\n") { return 46 }
    resetView(app)
    const room_x = @floatFromInt(f64, view.*.area.width)
    const room_y = @floatFromInt(f64, view.*.area.height)
    const middle_x = @floatFromInt(f64, view.*.area.x) + room_x / 2.0
    const middle_y = @floatFromInt(f64, view.*.area.y) + room_y / 2.0
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    viewport.toImage(view, middle_x, middle_y, &cx, &cy)
    const ax = mx - 150
    const ay = my - 40
    const bx = mx + 10
    const by = my + 80
    if !script.run(app, "down Alt\n") || !drag(app, ax, ay, bx, by, 6) || !script.run(app, "up Alt\n") { return 105 }
    const wanted = math.min(@floatFromInt(f64, bx - ax + 1) / room_x, @floatFromInt(f64, by - ay + 1) / room_y)
    if !near(view.*.zoom, wanted, 0.000001) { return 106 }
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(view, cx, cy, &wx, &wy)
    if !near(wx, @floatFromInt(f64, ax + bx + 1) / 2.0, 0.000001) || !near(wy, @floatFromInt(f64, ay + by + 1) / 2.0, 0.000001) { return 107 }

    // The measure, turned a quarter and zoomed 2: in the image's pixels.
    if !script.run(app, "tool measure\n") { return 28 }
    resetView(app)
    view.*.zoom = 2.0
    view.*.rotation = math.pi / 2.0
    api.redraw(app)
    var px0: f64 = 0.0
    var py0: f64 = 0.0
    var px1: f64 = 0.0
    var py1: f64 = 0.0
    imageAt(app, mx - 100, my, &px0, &py0)
    imageAt(app, mx + 100, my + 30, &px1, &py1)
    if !drag(app, mx - 100, my, mx + 100, my + 30, 9) { return 29 }
    var length: f64 = 0.0
    var angle: f64 = 0.0
    if !views.measured(app, &length, &angle) { return 47 }
    const dx = px1 - px0
    const dy = py1 - py0
    if !near(length, math.sqrt(dx * dx + dy * dy), 0.000001) || !near(length, math.sqrt(200.0 * 200.0 + 30.0 * 30.0) / 2.0, 0.000001) { return 48 }
    if !near(angle, math.atan2(-dy, dx) * 180.0 / math.pi, 0.000001) { return 49 }
    if !script.run(app, "key Escape\n") { return 69 }

    // A double click with Rotate View: upright, the image point in the
    // middle of the canvas staying there.
    if !script.run(app, "tool rotateview\nwait 500\n") { return 79 }
    resetView(app)
    view.*.zoom = 1.3
    view.*.rotation = 0.7
    api.redraw(app)
    viewport.toImage(view, middle_x, middle_y, &cx, &cy)
    if !click(app, mx + 60, my + 60) || !click(app, mx + 60, my + 60) || view.*.rotation != 0.0 { return 108 }
    var nx: f64 = 0.0
    var ny: f64 = 0.0
    viewport.toImage(view, middle_x, middle_y, &nx, &ny)
    if !near(nx, cx, 0.000001) || !near(ny, cy, 0.000001) { return 109 }

    // The hand's zoom, dragged far beyond: held to the zoom's limits.
    resetView(app)
    app.*.shell.*.modifiers = keys.CONTROL
    var input = gestureInput(mx, my, keys.CONTROL)
    if !views.canvasGesture(app, &input, views.GESTURE_PRESS) { return 9 }
    input = gestureInput(mx, my - 100000, 0)
    if !views.canvasGesture(app, &input, views.GESTURE_MOVE) || view.*.zoom != viewport.LARGEST { return 9 }
    input = gestureInput(mx, my + 100000, 0)
    if !views.canvasGesture(app, &input, views.GESTURE_RELEASE) || view.*.zoom != viewport.SMALLEST { return 9 }
    app.*.shell.*.modifiers = 0
    resetView(app)
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const environment = std.process.environmentEntries(arguments)
    const place = std.process.environmentFrom(environment, "NEBULA_SHOTS")
    if place != null && place.?.length > 0 && place.?.length < 500 {
        const into: [*]u8 = &shotsPlace
        shotsLength = std.text.append(into, 0, 512, place.?.pointer[0..place.?.length])
        while shotsLength > 1 && shotsPlace[shotsLength - 1] == 47 { shotsLength -= 1 }
    }
    var failed = testTable()
    if failed != 0 { return failed }
    const allocator = std.heap.allocator()
    const made = script.headless(allocator)
    if made == null { return 1 }
    const app = made.?
    if !script.run(app, "size 1024 768\nnew 400 300 FFFFFF\n") { return 7 }
    failed = testZoom(app)
    if failed != 0 { return failed }
    failed = testPan(app)
    if failed != 0 { return failed }
    failed = testMeasure(app)
    if failed != 0 { return failed }
    failed = testRotate(app)
    if failed != 0 { return failed }
    const fonts = textrender.create(allocator)
    if fonts == null { return 8 }
    var usable: ?*textrender.Fonts = null
    if textrender.usable(fonts.?, 0) < textrender.count(fonts.?) {
        usable = fonts
        failed = testRender(fonts.?)
        if failed != 0 { return failed }
        failed = testRenderEdges(fonts.?)
        if failed != 0 { return failed }
        failed = testRenderMemory()
        if failed != 0 { return failed }
    }
    failed = testText(app, usable)
    if failed != 0 { return failed }
    failed = testViewEdges(app)
    if failed != 0 { return failed }
    failed = testViewEdgesMore(app)
    if failed != 0 { return failed }
    if usable != null {
        failed = testTextEdges(app)
        if failed != 0 { return failed }
    }
    failed = testNarrowOptions(app)
    if failed != 0 { return failed }
    failed = testTextOtherImage(app)
    if failed != 0 { return failed }
    failed = testOptions(app)
    if failed != 0 { return failed }
    textrender.destroy(fonts.?)
    return 13
}
