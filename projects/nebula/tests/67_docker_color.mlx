// nebula's colour docker and palette docker (dockers/color.mlx,
// dockers/palette.mlx, on ui/colorpicker.mlx), played without a window
// (app/script.mlx). Checked: a drag in the triangle sets the colour of the
// place (its saturation and value from the place's weights between the
// corners, worked out here); the ring sets the hue of the place's angle
// and keeps saturation and value, and the triangle turns with it; the
// selector's image is rendered again for a new hue and not when only a
// mark moves; the right button sets the other colour; the background
// chosen in the pair is the one edited; the square and the bar of the
// other shape set what their places say, their corners exactly 0 and 1;
// the red slider dragged to its start makes red 0 and changes nothing
// else; a typed number; alpha alone; HSL's lightness at its end is white
// and back from it the hue is kept; the hex field takes #336699 and
// refuses what is no colour; the history keeps the colours used, newest
// first, twenty at most, and a click on one takes it; swap and reset in
// the pair; the selector's shape, the sliders' model and fold kept in the
// settings; at docker widths 240, 280 and 400 the parts lie inside the
// docker and none overlaps another (the slider rows and their parts, the
// history's cells neither). The palette docker: a click on the third
// swatch of the default palette sets the foreground to it, Ctrl+click the
// background; the arrows move the choice and Enter takes it; the add
// button grows the palette by the foreground and keeps it in the
// settings; a name typed; remove; a double click opens the colour dialog;
// the import button the file dialog; export and import back give the same
// palette, a file that is no palette and one that is not there are
// refused; another palette chosen, and the edited one comes back as it
// was left; at widths 240 and 400 its parts inside it and none over
// another. Every pixel of both dockers is opaque, in the dark and the
// light look. 200 frames of each docker (and 200 with a new hue each, the
// triangle rendered each time) take of the value arena what the second
// took. The geometry's edges: selectors too small, places outside the
// triangle held to its edges, a place and back. Pictures color.png,
// color-square.png, color-240.png, color-280.png, color-400.png,
// color-light.png, color-german.png, palette.png, palette-240.png and
// palette-400.png are written to the current directory and, when
// NEBULA_SHOTS names a directory, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const kit_module = @import("../ui/kit.mlx")
const text_io = @import("../io/text.mlx")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const settings = @import("../app/settings.mlx")
const color_module = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")
const palette_module = @import("../core/palette.mlx")
const docks = @import("../ui/docks.mlx")
const filedialog = @import("../ui/filedialog.mlx")
const colorpicker = @import("../ui/colorpicker.mlx")
const color_docker = @import("../dockers/color.mlx")
const palette_docker = @import("../dockers/palette.mlx")

const App = state.App

const HISTORY_DOCKER: u8 = 4

// The test's own: the app, a script being written, where pictures go too.
const T = struct {
    app: *App
    text: [4096]u8
    textLength: usize
    shots: []const u8
}

fn begin(t: *T) -> void { t.*.textLength = 0 }

fn add(t: *T, text: []const u8) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.textLength = std.text.append(bytes, t.*.textLength, 4096, text)
}

fn addNumber(t: *T, value: i32) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.textLength = std.text.appendSigned(bytes, t.*.textLength, 4096, @intCast(isize, value))
}

fn play(t: *T) -> bool {
    const bytes: [*]const u8 = &t.*.text
    return script.run(t.*.app, bytes[0..t.*.textLength])
}

fn run(t: *T, text: []const u8) -> bool { return script.run(t.*.app, text) }

fn clickAt(t: *T, x: i32, y: i32) -> bool {
    begin(t)
    add(t, "click ")
    addNumber(t, x)
    add(t, " ")
    addNumber(t, y)
    add(t, "\n")
    return play(t)
}

fn clickIn(t: *T, area: ui.Rect) -> bool {
    if area.width <= 0 || area.height <= 0 { return false }
    return clickAt(t, area.x + area.width / 2, area.y + area.height / 2)
}

fn dragTo(t: *T, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    begin(t)
    add(t, "drag ")
    addNumber(t, x0)
    add(t, " ")
    addNumber(t, y0)
    add(t, " ")
    addNumber(t, x1)
    add(t, " ")
    addNumber(t, y1)
    add(t, " 8\n")
    return play(t)
}

// A frame, as the window would draw one now.
fn frame(t: *T) -> bool { return run(t, "wait 16\n") }

// A picture of the window, here and where NEBULA_SHOTS says.
fn shot(t: *T, name: []const u8) -> bool {
    begin(t)
    add(t, "shot ")
    add(t, name)
    add(t, "\n")
    if t.*.shots.length > 0 && t.*.shots.length < 1000 {
        add(t, "shot ")
        add(t, t.*.shots)
        if t.*.shots[t.*.shots.length - 1] != '/' { add(t, "/") }
        add(t, name)
        add(t, "\n")
    }
    return play(t)
}

fn near(a: f64, b: f64, within: f64) -> bool { return a - b <= within && b - a <= within }

fn picker(t: *T) -> *colorpicker.Picker { return color_docker.pickerOf(t.*.app).? }

fn inside(area: ui.Rect, outer: ui.Rect) -> bool {
    return area.x >= outer.x && area.y >= outer.y && ui.right(area) <= ui.right(outer) && ui.bottom(area) <= ui.bottom(outer)
}

fn overlap(a: ui.Rect, b: ui.Rect) -> bool {
    if a.width <= 0 || a.height <= 0 || b.width <= 0 || b.height <= 0 { return false }
    return a.x < ui.right(b) && b.x < ui.right(a) && a.y < ui.bottom(b) && b.y < ui.bottom(a)
}

// The saturation and value of the place (x, y) of the triangle `geo`
// shows, worked out here from its corners: the place's weights between
// them (barycentric), the value what the hue's and white's weights make
// together, the saturation the hue's share of that.
fn expectedTriangle(geo: *const colorpicker.Geometry, x: f64, y: f64, s: *f64, v: *f64) -> void {
    const area = (geo.*.whiteX - geo.*.hueX) * (geo.*.blackY - geo.*.hueY) - (geo.*.blackX - geo.*.hueX) * (geo.*.whiteY - geo.*.hueY)
    // Each corner's weight: the area of the triangle the place makes
    // with the other two, of the whole.
    const hue_weight = ((geo.*.whiteX - x) * (geo.*.blackY - y) - (geo.*.blackX - x) * (geo.*.whiteY - y)) / area
    const white_weight = ((geo.*.blackX - x) * (geo.*.hueY - y) - (geo.*.hueX - x) * (geo.*.blackY - y)) / area
    v.* = hue_weight + white_weight
    s.* = hue_weight / (hue_weight + white_weight)
}

// The place in the triangle of weights (hue, white, black).
fn placeIn(geo: *const colorpicker.Geometry, hue: f64, white: f64, x: *i32, y: *i32) -> void {
    const black = 1.0 - hue - white
    x.* = @intFromFloat(i32, @floor(hue * geo.*.hueX + white * geo.*.whiteX + black * geo.*.blackX))
    y.* = @intFromFloat(i32, @floor(hue * geo.*.hueY + white * geo.*.whiteY + black * geo.*.blackY))
}

// The hue of pixel (x, y) on the ring: its middle's angle about the
// ring's, counter-clockwise from the right.
fn expectedHue(geo: *const colorpicker.Geometry, x: i32, y: i32) -> f64 {
    var turns_ = math.atan2(geo.*.cy - (@floatFromInt(f64, y) + 0.5), @floatFromInt(f64, x) + 0.5 - geo.*.cx) / 6.283185307179586
    if turns_ < 0.0 { turns_ += 1.0 }
    return turns_
}

// The place on the ring's middle line at `angle` (a part of a turn).
fn onRing(geo: *const colorpicker.Geometry, angle: f64, x: *i32, y: *i32) -> void {
    const radius = (geo.*.inner + geo.*.outer) / 2.0
    x.* = @intFromFloat(i32, @floor(geo.*.cx + radius * math.cos(angle * 6.283185307179586)))
    y.* = @intFromFloat(i32, @floor(geo.*.cy - radius * math.sin(angle * 6.283185307179586)))
}

// Every pixel of `area` of the frame opaque.
fn opaque(t: *T, area: ui.Rect) -> bool {
    const canvas = script.frameOf(t.*.app).?
    if area.width <= 0 || area.height <= 0 { return false }
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            if canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)] >> 24 != 255 { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// The colour docker

// The selector: the triangle, the ring, the render counter, the right
// button, the background edited.
fn checkSelector(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "color 8040C0\nbackground FFFFFF\n") || !frame(t) { return 14 }
    var layout = color_docker.layoutOf(app)
    const content = docks.contentOf(app, color_docker.ID)
    if layout.selector.width < 200 || !inside(layout.geometry.box, content) || layout.geometry.shape != colorpicker.SHAPE_RING { return 15 }
    if !near(picker(t).*.hue, 0.75, 0.01) { return 16 }

    // A drag in the triangle: the colour of the place where it ended.
    var geo = layout.geometry
    var x: i32 = 0
    var y: i32 = 0
    placeIn(&geo, 0.5, 0.2, &x, &y)
    if !dragTo(t, @intFromFloat(i32, geo.cx), @intFromFloat(i32, geo.cy), x, y) { return 17 }
    var s: f64 = 0.0
    var v: f64 = 0.0
    expectedTriangle(&geo, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &s, &v)
    const hue = picker(t).*.hue
    if !near(picker(t).*.saturation, s, 1.0 / 255.0) || !near(picker(t).*.value, v, 1.0 / 255.0) { return 18 }
    if app.*.foreground != color_module.fromHsv(hue, picker(t).*.saturation, picker(t).*.value, 255) { return 19 }
    var hh: f64 = 0.0
    var hs: f64 = 0.0
    var hv: f64 = 0.0
    color_module.toHsv(app.*.foreground, &hh, &hs, &hv)
    if !near(hv, v, 1.0 / 255.0) || !near(hs, s, 3.0 / 255.0) || !near(hh, hue, 2.0 / 255.0) { return 20 }
    if app.*.background != 0xFFFFFFFF { return 21 }

    // The mark moved, the image stayed: no rendering; nor for frames.
    const rendered = colorpicker.renders(picker(t))
    if rendered == 0 { return 22 }
    placeIn(&geo, 0.2, 0.6, &x, &y)
    if !dragTo(t, @intFromFloat(i32, geo.cx), @intFromFloat(i32, geo.cy), x, y) || !frame(t) || !frame(t) { return 23 }
    if colorpicker.renders(picker(t)) != rendered { return 24 }

    // The ring: the hue of the place, saturation and value kept.
    const kept_s = picker(t).*.saturation
    const kept_v = picker(t).*.value
    var x0: i32 = 0
    var y0: i32 = 0
    onRing(&geo, hue, &x0, &y0)
    onRing(&geo, 0.3, &x, &y)
    if !dragTo(t, x0, y0, x, y) { return 25 }
    if !near(picker(t).*.hue, expectedHue(&geo, x, y), 1.0e-9) || !near(picker(t).*.hue, 0.3, 0.01) { return 26 }
    if picker(t).*.saturation != kept_s || picker(t).*.value != kept_v { return 27 }
    if app.*.foreground != color_module.fromHsv(picker(t).*.hue, kept_s, kept_v, 255) { return 28 }
    if colorpicker.renders(picker(t)) <= rendered { return 29 }
    // The triangle turned with the hue: its corner of the pure hue is at
    // the hue's angle.
    if !frame(t) { return 30 }
    layout = color_docker.layoutOf(app)
    geo = layout.geometry
    const corner_angle = math.atan2(geo.cy - geo.hueY, geo.hueX - geo.cx) / 6.283185307179586
    if !near(corner_angle, picker(t).*.hue, 1.0e-6) { return 31 }

    // The right button on the triangle: the background, the foreground
    // as it was; the marks back on the foreground afterwards.
    const foreground = app.*.foreground
    placeIn(&geo, 0.7, 0.1, &x0, &y0)
    placeIn(&geo, 0.3, 0.3, &x, &y)
    begin(t)
    add(t, "pointer ")
    addNumber(t, x0)
    add(t, " ")
    addNumber(t, y0)
    add(t, "\npress right\npointer ")
    addNumber(t, (x0 + x) / 2)
    add(t, " ")
    addNumber(t, (y0 + y) / 2)
    add(t, "\npointer ")
    addNumber(t, x)
    add(t, " ")
    addNumber(t, y)
    add(t, "\nrelease right\nwait 16\n")
    if !play(t) { return 32 }
    expectedTriangle(&geo, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &s, &v)
    if app.*.foreground != foreground || app.*.background != color_module.fromHsv(picker(t).*.hue, s, v, 255) { return 33 }
    if colorpicker.draggingSecondary(picker(t)) || picker(t).*.color != foreground { return 34 }

    // The background chosen in the pair is the one the selector edits.
    if !clickAt(t, ui.right(layout.pair) - 4, ui.bottom(layout.pair) - 4) || !color_docker.editsBackground(app) { return 35 }
    if !frame(t) { return 36 }
    geo = color_docker.layoutOf(app).geometry
    placeIn(&geo, 0.6, 0.3, &x, &y)
    if !dragTo(t, @intFromFloat(i32, geo.cx), @intFromFloat(i32, geo.cy), x, y) { return 37 }
    expectedTriangle(&geo, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &s, &v)
    if app.*.foreground != foreground || app.*.background != color_module.fromHsv(picker(t).*.hue, s, v, 255) { return 38 }
    if !clickAt(t, layout.pair.x + 4, layout.pair.y + 4) || color_docker.editsBackground(app) { return 39 }
    if !frame(t) || picker(t).*.color != app.*.foreground { return 40 }
    return 0
}

// The other shape: the square and the bar.
fn checkSquare(t: *T) -> u8 {
    const app = t.*.app
    var layout = color_docker.layoutOf(app)
    const before = colorpicker.renders(picker(t))
    if !clickIn(t, layout.shape) || picker(t).*.shape != colorpicker.SHAPE_SQUARE || !frame(t) { return 46 }
    // (The shape is kept in the settings, with the model and the fold.)
    if !std.text.same(settings.text(app, "color"), "square hsv folded") { return 61 }
    layout = color_docker.layoutOf(app)
    const square = layout.geometry.square
    const bar = layout.geometry.bar
    if square.width < 150 || square.width != square.height || bar.height != square.height || bar.x <= ui.right(square) || ui.right(bar) > ui.right(docks.contentOf(app, color_docker.ID)) { return 47 }
    if colorpicker.renders(picker(t)) != before + 1 { return 48 }
    // The square: saturation along, value up; its first and last pixels
    // 0 and 1.
    const x = square.x + square.width * 3 / 4
    const y = square.y + square.height / 3
    if !dragTo(t, square.x + 5, square.y + 5, x, y) { return 49 }
    const s = @floatFromInt(f64, x - square.x) / @floatFromInt(f64, square.width - 1)
    const v = 1.0 - @floatFromInt(f64, y - square.y) / @floatFromInt(f64, square.height - 1)
    if !near(picker(t).*.saturation, s, 1.0 / 255.0) || !near(picker(t).*.value, v, 1.0 / 255.0) { return 50 }
    if app.*.foreground != color_module.fromHsv(picker(t).*.hue, s, v, 255) { return 51 }
    if colorpicker.renders(picker(t)) != before + 1 { return 52 }
    if !dragTo(t, x, y, square.x - 30, ui.bottom(square) + 30) || picker(t).*.saturation != 0.0 || picker(t).*.value != 0.0 || app.*.foreground != 0xFF000000 { return 53 }
    if !dragTo(t, square.x, square.y, ui.right(square) + 9, square.y - 9) || picker(t).*.saturation != 1.0 || picker(t).*.value != 1.0 { return 54 }
    // The bar: the hue, top to bottom; saturation and value kept.
    const bar_y = bar.y + bar.height / 6
    if !dragTo(t, bar.x + 4, bar.y + 4, bar.x + 4, bar_y) { return 55 }
    if !near(picker(t).*.hue, @floatFromInt(f64, bar_y - bar.y) / @floatFromInt(f64, bar.height - 1), 1.0 / 255.0) || picker(t).*.saturation != 1.0 || picker(t).*.value != 1.0 { return 56 }
    if !near(picker(t).*.hue, 1.0 / 6.0, 0.01) || app.*.foreground != color_module.fromHsv(picker(t).*.hue, 1.0, 1.0, 255) || pixel.red(app.*.foreground) != 255 || pixel.green(app.*.foreground) < 240 || pixel.blue(app.*.foreground) != 0 { return 57 }
    if colorpicker.renders(picker(t)) <= before + 1 { return 58 }
    if !shot(t, "color-square.png") { return 59 }
    if !clickIn(t, layout.shape) || picker(t).*.shape != colorpicker.SHAPE_RING { return 60 }
    return 0
}

// The sliders: red to its start, a number typed, HSL's lightness.
fn checkSliders(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "color 8040C0\n") || !frame(t) { return 64 }
    var layout = color_docker.layoutOf(app)
    if layout.sliders.width != 0 { return 65 }
    if !clickIn(t, layout.heading) || !frame(t) { return 66 }
    layout = color_docker.layoutOf(app)
    if layout.sliders.width <= 0 || layout.sliders.height != colorpicker.slidersHeight(1) { return 67 }
    // (The docker scrolls when it is taller than its place: the rows
    // needed are in view in a window of 1280 x 800.)
    const red_row = colorpicker.channelRow(layout.sliders, colorpicker.CHANNEL_RED, 1)
    const track = colorpicker.trackOf(red_row, 1)
    if !inside(red_row, layout.view) || track.width < 60 { return 68 }
    const mark = track.x + (track.width - 1) * 128 / 255
    if !dragTo(t, mark, red_row.y + red_row.height / 2, track.x - 40, red_row.y + red_row.height / 2) { return 69 }
    if app.*.foreground != 0xFF0040C0 { return 70 }
    // The green number typed.
    const green_row = colorpicker.channelRow(layout.sliders, colorpicker.CHANNEL_GREEN, 1)
    if !clickAt(t, ui.right(green_row) - 30, green_row.y + green_row.height / 2) || !run(t, "type 200\nkey Enter\nwait 16\n") { return 71 }
    if app.*.foreground != 0xFF00C8C0 { return 72 }
    // Alpha dragged to its end and back to the start: only alpha.
    const alpha_row = colorpicker.channelRow(layout.sliders, colorpicker.CHANNEL_ALPHA, 1)
    const alpha_track = colorpicker.trackOf(alpha_row, 1)
    if !dragTo(t, ui.right(alpha_track) - 1, alpha_row.y + 10, alpha_track.x + alpha_track.width / 2, alpha_row.y + 10) { return 73 }
    if pixel.alpha(app.*.foreground) < 126 || pixel.alpha(app.*.foreground) > 130 || app.*.foreground & 0xFFFFFF != 0x00C8C0 { return 74 }
    if !dragTo(t, alpha_track.x + alpha_track.width / 2, alpha_row.y + 10, ui.right(alpha_track) + 20, alpha_row.y + 10) || app.*.foreground != 0xFF00C8C0 { return 75 }
    // HSL: its lightness at the end is white, the hue kept for the grey.
    const hue = picker(t).*.hue
    const model_row = ui.rect(layout.sliders.x, layout.sliders.y, layout.sliders.width, 24)
    if !clickAt(t, model_row.x + model_row.width / 2, model_row.y + 12) || picker(t).*.model != colorpicker.MODEL_HSL { return 76 }
    if !std.text.same(settings.text(app, "color"), "ring hsl open") { return 62 }
    const light_row = colorpicker.channelRow(layout.sliders, colorpicker.CHANNEL_LIGHTNESS, 1)
    const light_track = colorpicker.trackOf(light_row, 1)
    if !dragTo(t, light_track.x + light_track.width / 2, light_row.y + 10, ui.right(light_track) + 30, light_row.y + 10) { return 77 }
    if app.*.foreground != 0xFFFFFFFF || picker(t).*.hue != hue || picker(t).*.modelLightness != 1.0 { return 78 }
    if !dragTo(t, ui.right(light_track) - 1, light_row.y + 10, light_track.x + light_track.width / 2, light_row.y + 10) { return 79 }
    // (Back from white the hue and the saturation are what they were.)
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    color_module.toHsl(app.*.foreground, &h, &s, &l)
    if !near(h, hue, 2.0 / 255.0) || !near(l, 0.5, 1.0 / 255.0) || s < 0.9 { return 80 }
    if !clickAt(t, model_row.x + 10, model_row.y + 12) || picker(t).*.model != colorpicker.MODEL_HSV { return 81 }
    return 0
}

// The hex field, the history, the pair's swap and reset.
fn checkFields(t: *T) -> u8 {
    const app = t.*.app
    if !frame(t) { return 82 }
    var layout = color_docker.layoutOf(app)
    // (Scrolled into view: the sliders are open.)
    if !inside(layout.hex, layout.view) {
        if !clickIn(t, layout.heading) || !frame(t) { return 83 }
        layout = color_docker.layoutOf(app)
    }
    if !inside(layout.hex, layout.view) { return 84 }
    if !clickIn(t, layout.hex) || !run(t, "type 336699\nkey Enter\nwait 16\n") { return 85 }
    if app.*.foreground != 0xFF336699 { return 86 }
    if !clickIn(t, layout.hex) || !run(t, "type 3x6\nkey Enter\nwait 16\nexpect-note colour\n") || app.*.foreground != 0xFF336699 { return 87 }
    // The history.
    const history = color_docker.historyOf(app).?
    color_docker.noteUsed(app, 0xFF112233)
    color_docker.noteUsed(app, 0xFF445566)
    color_docker.noteUsed(app, 0xFF112233)
    if history.*.count != 2 || history.*.colors[0] != 0xFF112233 || history.*.colors[1] != 0xFF445566 { return 88 }
    if !frame(t) { return 89 }
    layout = color_docker.layoutOf(app)
    if !clickIn(t, colorpicker.historyCell(layout.history, 1, 1)) || app.*.foreground != 0xFF445566 { return 90 }
    var index: u32 = 0
    while index < 25 {
        color_docker.noteUsed(app, 0xFF000000 | (index * 0x010203))
        index += 1
    }
    if history.*.count != colorpicker.HISTORY || history.*.colors[0] != 0xFF000000 | (24 * 0x010203) || history.*.colors[19] != 0xFF000000 | (5 * 0x010203) { return 91 }
    // Swap and reset: the pair's corners (the kit's colorPair).
    if !run(t, "color 123456\nbackground ABCDEF\n") || !frame(t) { return 92 }
    layout = color_docker.layoutOf(app)
    const side = layout.pair.width
    const corner = side - side * 5 / 8 - 2
    if !clickAt(t, layout.pair.x + side - corner / 2, layout.pair.y + corner / 2) { return 93 }
    if app.*.foreground != 0xFFABCDEF || app.*.background != 0xFF123456 { return 94 }
    if !clickAt(t, layout.pair.x + corner / 2, layout.pair.y + side - corner / 2) { return 95 }
    if app.*.foreground != 0xFF000000 || app.*.background != 0xFFFFFFFF { return 96 }
    return 0
}

// The parts of the docker at `width`: inside it, none over another.
fn checkWidth(t: *T, width: i32, name: []const u8) -> u8 {
    const app = t.*.app
    docks.setAreaWidth(app, docks.AREA_RIGHT, width)
    if !run(t, "color 4080C0\n") || !frame(t) { return 100 }
    const layout = color_docker.layoutOf(app)
    const content = docks.contentOf(app, color_docker.ID)
    if content.width <= 0 || content.width > width { return 101 }
    var parts: [10]ui.Rect = undefined
    parts[0] = layout.pair
    parts[1] = layout.title
    parts[2] = layout.shape
    parts[3] = layout.geometry.box
    parts[4] = layout.heading
    parts[5] = layout.sliders
    parts[6] = layout.recent
    parts[7] = layout.history
    parts[8] = layout.hexLabel
    parts[9] = layout.hex
    var a: usize = 0
    while a < 10 {
        // Across, inside the docker (up and down it scrolls).
        if parts[a].width > 0 && (parts[a].x < content.x || ui.right(parts[a]) > ui.right(content)) { return 102 }
        var b = a + 1
        while b < 10 {
            if overlap(parts[a], parts[b]) { return 103 }
            b += 1
        }
        a += 1
    }
    if layout.sliders.width <= 0 || layout.geometry.box.width < 150 { return 104 }
    // The slider rows, and in each its letter, track and number.
    var channel: u8 = 0
    while @intCast(usize, channel) < colorpicker.CHANNELS {
        const row = colorpicker.channelRow(layout.sliders, channel, 1)
        if !inside(row, layout.sliders) { return 105 }
        const track = colorpicker.trackOf(row, 1)
        if track.width < 40 || track.x < row.x + 16 || ui.right(track) > ui.right(row) - 54 { return 106 }
        var other: u8 = channel + 1
        while @intCast(usize, other) < colorpicker.CHANNELS {
            if overlap(row, colorpicker.channelRow(layout.sliders, other, 1)) { return 107 }
            other += 1
        }
        channel += 1
    }
    var index: usize = 0
    while index < colorpicker.HISTORY {
        const cell = colorpicker.historyCell(layout.history, index, 1)
        if !inside(cell, layout.history) || cell.width < 12 { return 108 }
        if index > 0 && overlap(cell, colorpicker.historyCell(layout.history, index - 1, 1)) { return 109 }
        index += 1
    }
    if !opaque(t, content) { return 110 }
    if !shot(t, name) { return 111 }
    return 0
}

// ---------------------------------------------------------------------------
// The palette docker

fn checkPalette(t: *T) -> u8 {
    const app = t.*.app
    docks.setAreaWidth(app, docks.AREA_RIGHT, 280)
    if !frame(t) || !clickIn(t, docks.tabOf(app, palette_docker.ID)) || !frame(t) { return 116 }
    const content = docks.contentOf(app, palette_docker.ID)
    if content.width <= 0 || palette_docker.shown(app) != palette_module.DEFAULT { return 117 }
    var layout = palette_docker.layoutOf(app)
    const shown = palette_docker.paletteShown(app).?
    const colors = palette_module.builtinColors(palette_module.DEFAULT)
    if palette_module.count(shown) != colors.length || layout.columns != 8 || layout.cell < 20 || !inside(layout.grid, content) { return 118 }
    // The third swatch: the foreground. The fourth with Control: the
    // background.
    if !run(t, "color 000000\nbackground FFFFFF\n") { return 119 }
    const cell = layout.cell
    if !clickAt(t, layout.grid.x + 2 * cell + cell / 2, layout.grid.y + cell / 2) { return 120 }
    if app.*.foreground != colors[2] || palette_docker.selected(app) != 2 || app.*.background != 0xFFFFFFFF { return 121 }
    begin(t)
    add(t, "down Ctrl\nclick ")
    addNumber(t, layout.grid.x + 3 * cell + cell / 2)
    add(t, " ")
    addNumber(t, layout.grid.y + cell / 2)
    add(t, "\nup Ctrl\n")
    if !play(t) || app.*.background != colors[3] || app.*.foreground != colors[2] { return 122 }
    // The arrows move the choice (the pointer over the docker).
    begin(t)
    add(t, "pointer ")
    addNumber(t, layout.grid.x + cell / 2)
    add(t, " ")
    addNumber(t, layout.grid.y + cell / 2)
    add(t, "\nkey Right\nkey Down\n")
    if !play(t) || palette_docker.selected(app) != 4 + 8 { return 123 }
    if !run(t, "key Left\nkey Up\nkey Enter\n") || palette_docker.selected(app) != 3 || app.*.foreground != colors[3] { return 124 }
    // Added: the foreground at the end, chosen, kept in the settings.
    const count = palette_module.count(shown)
    if !run(t, "color 336699\n") || !clickIn(t, layout.add) { return 125 }
    if palette_module.count(shown) != count + 1 || palette_module.colorAt(shown, count) != 0xFF336699 || palette_docker.selected(app) != count { return 126 }
    if settings.text(app, "palette-0").length == 0 { return 127 }
    // Named in the row of the one chosen.
    if !frame(t) { return 128 }
    layout = palette_docker.layoutOf(app)
    if !clickIn(t, layout.name) || !run(t, "type Sea\nkey Enter\nwait 16\n") || !std.text.same(palette_module.nameAt(shown, count), "Sea") { return 129 }
    if !shot(t, "palette.png") || !opaque(t, content) { return 130 }
    // Removed.
    if !clickIn(t, layout.remove) || palette_module.count(shown) != count { return 131 }
    // A double click: the colour dialog for the swatch.
    begin(t)
    add(t, "click ")
    addNumber(t, layout.grid.x + cell / 2)
    add(t, " ")
    addNumber(t, layout.grid.y + cell / 2)
    add(t, "\nclick ")
    addNumber(t, layout.grid.x + cell / 2)
    add(t, " ")
    addNumber(t, layout.grid.y + cell / 2)
    add(t, "\n")
    if !play(t) || app.*.dialogCount != 1 { return 132 }
    if !run(t, "key Escape\n") || app.*.dialogCount != 0 { return 133 }
    // The import button: the file dialog.
    if !clickIn(t, layout.load) || !filedialog.isOpen(app) { return 134 }
    if !run(t, "key Escape\n") || filedialog.isOpen(app) { return 135 }

    // Exported, then imported back into My palette: the same colours,
    // names and columns.
    if !run(t, "color 102030\n") || !palette_docker.addColor(app, 0xFF102030) { return 136 }
    const exported_count = palette_module.count(shown)
    const copy = palette_module.create(app.*.allocator)
    if copy == null || !palette_module.copy(copy.?, shown) { return 137 }
    if !palette_docker.exportTo(app, "palette-67.gpl") || !std.fs.exists("palette-67.gpl\x00".pointer) { return 138 }
    if !palette_docker.importFrom(app, "palette-67.gpl") || palette_docker.shown(app) != palette_docker.USER { return 139 }
    const mine = palette_docker.paletteShown(app).?
    if palette_module.count(mine) != exported_count || mine.*.columns != copy.?.*.columns || !std.text.same(palette_module.name(mine), palette_module.name(copy.?)) { return 140 }
    var index: usize = 0
    while index < exported_count {
        if palette_module.colorAt(mine, index) != palette_module.colorAt(copy.?, index) || !std.text.same(palette_module.nameAt(mine, index), palette_module.nameAt(copy.?, index)) { return 141 }
        index += 1
    }
    palette_module.destroy(copy.?)
    if settings.text(app, "palette-user").length == 0 || !std.text.same(settings.text(app, "palette"), "user") { return 142 }
    // A file that is no palette (a PNG): refused, My palette as it was.
    if !run(t, "shot not-a-palette.png\n") { return 143 }
    if palette_docker.importFrom(app, "not-a-palette.png") || palette_module.count(mine) != exported_count { return 144 }
    if palette_docker.importFrom(app, "no-such-file.gpl") || palette_module.count(mine) != exported_count { return 145 }
    // Another palette chosen: the greys.
    palette_docker.choose(app, palette_module.GREYS)
    if !frame(t) || palette_docker.shown(app) != palette_module.GREYS || palette_module.count(palette_docker.paletteShown(app).?) != palette_module.builtinColors(palette_module.GREYS).length { return 146 }
    palette_docker.choose(app, palette_module.DEFAULT)
    if !frame(t) { return 147 }
    // The default palette as edited above (one swatch more), kept.
    if palette_module.count(palette_docker.paletteShown(app).?) != colors.length + 1 { return 148 }
    return 0
}

// The palette docker at `width`: its parts inside it, none over another,
// its swatches in the palette's eight columns while they fit.
fn checkPaletteWidth(t: *T, width: i32, name: []const u8) -> u8 {
    const app = t.*.app
    docks.setAreaWidth(app, docks.AREA_RIGHT, width)
    if !frame(t) || !frame(t) { return 150 }
    const content = docks.contentOf(app, palette_docker.ID)
    const layout = palette_docker.layoutOf(app)
    if content.width <= 0 || layout.columns != 8 || layout.cell < 12 { return 151 }
    var parts: [7]ui.Rect = undefined
    parts[0] = layout.choice
    parts[1] = layout.grid
    parts[2] = layout.entry
    parts[3] = layout.add
    parts[4] = layout.remove
    parts[5] = layout.load
    parts[6] = layout.save
    var a: usize = 0
    while a < 7 {
        if !inside(parts[a], content) || parts[a].width <= 0 { return 152 }
        var b = a + 1
        while b < 7 {
            if overlap(parts[a], parts[b]) { return 153 }
            b += 1
        }
        a += 1
    }
    if layout.name.width > 0 && (!inside(layout.name, layout.entry) || !inside(layout.value, layout.entry) || overlap(layout.name, layout.value)) { return 154 }
    if !opaque(t, content) || !shot(t, name) { return 155 }
    return 0
}

// ---------------------------------------------------------------------------
// Edges of the geometry, the value arena, the looks

fn checkEdges(t: *T) -> u8 {
    // A selector too small for an image: nothing drawn, no trap.
    const tiny = colorpicker.geometry(ui.rect(10, 10, 10, 10), colorpicker.SHAPE_RING, 0.0, 1)
    if tiny.outer > 5.0 { return 160 }
    const none = colorpicker.geometry(ui.rect(0, 0, 0, 0), colorpicker.SHAPE_SQUARE, 0.5, 1)
    if none.square.width != 0 || none.bar.width != 0 { return 161 }
    if colorpicker.selectorHeight(0, colorpicker.SHAPE_RING, 1) != 0 || colorpicker.selectorHeight(10, colorpicker.SHAPE_SQUARE, 1) != 0 { return 162 }
    // Places outside the triangle are held to its edges: beyond the hue's
    // corner the pure hue, beyond the black one black (its saturation
    // kept), beyond the white-black edge a grey.
    const geo = colorpicker.geometry(ui.rect(0, 0, 300, 300), colorpicker.SHAPE_RING, 0.0, 1)
    var s: f64 = 0.4
    var v: f64 = 0.4
    colorpicker.triangleAt(&geo, geo.hueX + 50.0, geo.hueY, &s, &v)
    if s != 1.0 || v != 1.0 { return 163 }
    s = 0.4
    colorpicker.triangleAt(&geo, geo.blackX - 10.0, geo.blackY + 30.0, &s, &v)
    if v != 0.0 || s != 0.4 { return 164 }
    colorpicker.triangleAt(&geo, geo.cx - 140.0, geo.cy, &s, &v)
    if s != 0.0 || v <= 0.0 || v >= 1.0 { return 165 }
    // A place and back: trianglePlace is triangleAt's opposite.
    var x: f64 = 0.0
    var y: f64 = 0.0
    colorpicker.trianglePlace(&geo, 0.25, 0.75, &x, &y)
    colorpicker.triangleAt(&geo, x, y, &s, &v)
    if !near(s, 0.25, 1.0e-9) || !near(v, 0.75, 1.0e-9) { return 166 }
    // The history of one colour noted many times holds it once.
    var history = colorpicker.History.{ .colors = undefined, .count = 0 }
    var round: usize = 0
    while round < 50 {
        colorpicker.remember(&history, 0xFF010203)
        round += 1
    }
    if history.count != 1 || history.colors[0] != 0xFF010203 { return 167 }
    return 0
}

// 200 frames of a docker: each takes of the value arena what the second
// took (std.ui's text takes some for every line), none more. With
// `turning` the foreground's hue changes every frame: the selector's
// triangle is rendered each time.
fn framesTake(t: *T, turning: bool) -> u8 {
    const app = t.*.app
    const canvas = script.frameOf(app).?
    const renders_before = colorpicker.renders(picker(t))
    var frames: turns.Turns = undefined
    turns.begin(&frames, true, false)
    const arena = frames.base
    const mark = turns.used(arena)
    var first: usize = 0
    var last: usize = 0
    var round: usize = 0
    while round < 200 {
        turns.turn(&frames)
        if turning { api.setForeground(app, if round & 1 == 0 { 0xFF3366CC } else { 0xFFCC6633 }) }
        loop.frame(app, canvas)
        last = turns.used(arena) - mark
        if round == 1 { first = last }
        if last > 1048576 { return 1 }
        round += 1
    }
    if last != first { return 2 }
    turns.turn(&frames)
    if turns.used(arena) != mark { return 3 }
    if turning && colorpicker.renders(picker(t)) < renders_before + 200 { return 4 }
    return 0
}

fn checkArena(t: *T) -> u8 {
    const app = t.*.app
    if !clickIn(t, docks.tabOf(app, color_docker.ID)) || !frame(t) { return 172 }
    if framesTake(t, false) != 0 { return 173 }
    if framesTake(t, true) != 0 { return 174 }
    if !clickIn(t, docks.tabOf(app, palette_docker.ID)) || !frame(t) || docks.contentOf(app, palette_docker.ID).width <= 0 { return 175 }
    if framesTake(t, false) != 0 { return 176 }
    return 0
}

fn checkLooks(t: *T) -> u8 {
    const app = t.*.app
    docks.setAreaWidth(app, docks.AREA_RIGHT, 280)
    if !run(t, "color 3A7BD5\nbackground F2E9DC\n") || !frame(t) { return 178 }
    if !shot(t, "color.png") { return 179 }
    // The light look.
    app.*.shell.*.lightness = 1024
    if !frame(t) || !shot(t, "color-light.png") || !opaque(t, docks.contentOf(app, color_docker.ID)) { return 180 }
    app.*.shell.*.lightness = 0
    // German.
    if !run(t, "german\n") || !frame(t) || !shot(t, "color-german.png") { return 181 }
    app.*.german = false
    return 0
}

// ---------------------------------------------------------------------------
// The selector alone, on a kit and a canvas of the test's own (no App)

const SIDE: usize = 640

const W = struct {
    ui: view.Ui
    theme: theme_module.Theme
    body: text_module.Text
    small: text_module.Text
    canvas: canvas_module.Canvas
    nowhere: canvas_module.Canvas
    kit: *kit_module.Kit
    picker: colorpicker.Picker
    color: u32
    time: u64
}

fn selectorId() -> u64 { return view.id("test.selector") }

// One frame of the selector alone in `box` on `canvas` (cleared to the
// theme's background first when it has pixels).
fn widgetFrame(w: *W, canvas: *canvas_module.Canvas, box: ui.Rect) -> u8 {
    if canvas.*.width > 0 { canvas_module.clear(canvas, w.*.theme.background) }
    view.begin(&w.*.ui, canvas)
    kit_module.begin(w.*.kit, &w.*.ui, canvas, &w.*.theme, &w.*.body, &w.*.small, &w.*.body, w.*.time, false)
    w.*.time += 16
    const picked = colorpicker.selector(w.*.kit, &w.*.picker, selectorId(), box, &w.*.color)
    _ = kit_module.end(w.*.kit)
    _ = view.end(&w.*.ui)
    return picked
}

fn canvasAt(w: *W, x: i32, y: i32) -> u32 {
    return w.*.canvas.pixels[@intCast(usize, y) * SIDE + @intCast(usize, x)]
}

// Whether every pixel of the canvas is the theme's background (nothing
// was drawn).
fn untouched(w: *W) -> bool {
    var index: usize = 0
    while index < SIDE * SIDE {
        if w.*.canvas.pixels[index] != w.*.theme.background { return false }
        index += 1
    }
    return true
}

// The largest difference of two pixels' bytes.
fn byteDistance(a: u32, b: u32) -> u32 {
    var most: u32 = 0
    var shift: u32 = 0
    while shift < 32 {
        const x = (a >> shift) & 255
        const y = (b >> shift) & 255
        const d = if x > y { x - y } else { y - x }
        if d > most { most = d }
        shift += 8
    }
    return most
}

// How far (x, y) lies inside the edge a-b of a triangle whose third
// corner is c (pixels; below 0: outside).
fn insideEdge(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, x: f64, y: f64) -> f64 {
    const nx = by - ay
    const ny = ax - bx
    const length = @sqrt(nx * nx + ny * ny)
    const toward = (cx - ax) * nx + (cy - ay) * ny
    const along_normal = ((x - ax) * nx + (y - ay) * ny) / length
    return if toward > 0.0 { along_normal } else { -along_normal }
}

fn insideTriangle(geo: *const colorpicker.Geometry, x: f64, y: f64, margin: f64) -> bool {
    return insideEdge(geo.*.hueX, geo.*.hueY, geo.*.whiteX, geo.*.whiteY, geo.*.blackX, geo.*.blackY, x, y) > margin && insideEdge(geo.*.whiteX, geo.*.whiteY, geo.*.blackX, geo.*.blackY, geo.*.hueX, geo.*.hueY, x, y) > margin && insideEdge(geo.*.blackX, geo.*.blackY, geo.*.hueX, geo.*.hueY, geo.*.whiteX, geo.*.whiteY, x, y) > margin
}

// The ring and triangle image (the picker's, under the marks) against
// what each place shows, worked out here: where the ring is whole the hue
// of the pixel's angle at full saturation and value; two pixels inside
// the triangle the colour of the place's saturation and value (from its
// weights between the corners, expectedTriangle); outside the ring and
// between the ring and the triangle nothing. Within one step a channel
// (the image mixes white and the hue by the weights, the test goes
// through HSV). `checked` counts the pixels compared.
fn ringImageMatches(picker: *colorpicker.Picker, geo: *const colorpicker.Geometry, checked: *usize) -> bool {
    const width = geo.*.box.width
    var row: i32 = 0
    while row < geo.*.box.height {
        var column: i32 = 0
        while column < width {
            const x = @floatFromInt(f64, geo.*.box.x + column) + 0.5
            const y = @floatFromInt(f64, geo.*.box.y + row) + 0.5
            const dx = x - geo.*.cx
            const dy = y - geo.*.cy
            const distance = @sqrt(dx * dx + dy * dy)
            const got = picker.*.pixels[@intCast(usize, row) * @intCast(usize, width) + @intCast(usize, column)]
            if distance > geo.*.inner + 1.0 && distance < geo.*.outer - 1.0 {
                var angle = math.atan2(-dy, dx) / 6.283185307179586
                if angle < 0.0 { angle += 1.0 }
                if byteDistance(got, color_module.fromHsv(angle, 1.0, 1.0, 255)) > 1 { return false }
                checked.* += 1
            } else if distance > geo.*.outer + 1.0 || (distance < geo.*.inner - 1.0 && distance > geo.*.inner - 3.0) {
                if got != 0 { return false }
                checked.* += 1
            } else if insideTriangle(geo, x, y, 2.0) {
                var s: f64 = 0.0
                var v: f64 = 0.0
                expectedTriangle(geo, x, y, &s, &v)
                if byteDistance(got, color_module.fromHsv(picker.*.hue, s, v, 255)) > 1 { return false }
                checked.* += 1
            }
            column += 1
        }
        row += 1
    }
    return true
}

// The square and bar image against hsvToRgb's colours, exactly: inside
// the rounded corners the square's pixel (column, row) is the hue at the
// saturation column/(side-1) and the value 1-row/(side-1), the bar's row
// the hue row/(side-1) at full saturation and value; the gap between
// them is empty.
fn squareImageMatches(picker: *colorpicker.Picker, geo: *const colorpicker.Geometry, checked: *usize) -> bool {
    const width = geo.*.box.width
    const side = geo.*.square.width
    const last = @floatFromInt(f64, side - 1)
    const bar_left = geo.*.bar.x - geo.*.box.x
    var row: i32 = 3
    while row < side - 3 {
        const line = @intCast(usize, row) * @intCast(usize, width)
        var column: i32 = 3
        while column < width - 3 {
            const got = picker.*.pixels[line + @intCast(usize, column)]
            if column < side - 3 {
                if got != color_module.fromHsv(picker.*.hue, @floatFromInt(f64, column) / last, 1.0 - @floatFromInt(f64, row) / last, 255) { return false }
                checked.* += 1
            } else if column >= side && column < bar_left {
                if got != 0 { return false }
            } else if column >= bar_left + 3 {
                if got != color_module.fromHsv(@floatFromInt(f64, row) / last, 1.0, 1.0, 255) { return false }
                checked.* += 1
            }
            column += 1
        }
        row += 1
    }
    return true
}

// A press at (x0, y0) in the selector, moved to (x1, y1), let go: the
// two-frame rhythm of std.ui (a frame names the regions, input meets
// them, the next frame reacts).
fn widgetDrag(w: *W, box: ui.Rect, x0: i32, y0: i32, x1: i32, y1: i32) -> void {
    _ = widgetFrame(w, &w.*.canvas, box)
    _ = view.pointerMove(&w.*.ui, x0, y0)
    _ = view.pointerButton(&w.*.ui, true)
    _ = widgetFrame(w, &w.*.canvas, box)
    _ = view.pointerMove(&w.*.ui, x1, y1)
    _ = widgetFrame(w, &w.*.canvas, box)
    _ = view.pointerButton(&w.*.ui, false)
    _ = widgetFrame(w, &w.*.canvas, box)
}

// 1000 frames of the selector, the hue changing every other one: each
// takes of the value arena what the second took.
fn widgetFramesTake(w: *W, box: ui.Rect) -> bool {
    var frames: turns.Turns = undefined
    turns.begin(&frames, true, false)
    const arena = frames.base
    const mark = turns.used(arena)
    var first: usize = 0
    var round: usize = 0
    while round < 1000 {
        turns.turn(&frames)
        if round & 1 == 0 { w.*.color = if round & 2 == 0 { 0xFF3366CC } else { 0xFFCC9933 } }
        _ = widgetFrame(w, &w.*.canvas, box)
        const used = turns.used(arena) - mark
        if round == 1 { first = used }
        if round > 1 && used != first { return false }
        round += 1
    }
    turns.turn(&frames)
    return turns.used(arena) == mark
}

fn checkWidgets(allocator: std.allocator.Allocator) -> u8 {
    const memory = allocator.alloc(@sizeOf(W), 16)
    if memory == null { return 186 }
    const w: *W = unsafe { @ptrCast(*W, memory.?) }
    const pixels = allocator.alloc(SIDE * SIDE * 4, 16)
    if pixels == null { return 186 }
    w.*.canvas = canvas_module.Canvas.{ .pixels = unsafe { @ptrCast([*]u32, pixels.?) }, .width = SIDE, .height = SIDE, .stride = SIDE, .swapRedBlue = false, .device = 0, .opacity = 255 }
    w.*.nowhere = view.layoutCanvas()
    // (The selector draws no text: without fonts all of this holds.)
    _ = text_module.loadText(&w.*.body, 13, allocator)
    _ = text_module.loadText(&w.*.small, 12, allocator)
    w.*.theme = theme_module.scaled(theme_module.dark(), 1)
    view.init(&w.*.ui, &w.*.theme, &w.*.body, &w.*.small, &w.*.body)
    const made = kit_module.create(allocator)
    if made == null { return 186 }
    w.*.kit = made.?
    w.*.time = 1000
    // (Once before counting: the square takes scratch memory, kept for
    // the next taking.)
    w.*.color = 0xFF3366CC
    colorpicker.init(&w.*.picker, allocator, w.*.color)
    colorpicker.setShape(&w.*.picker, colorpicker.SHAPE_SQUARE)
    _ = widgetFrame(w, &w.*.canvas, ui.rect(0, 0, 300, 274))
    colorpicker.release(&w.*.picker)
    const live = std.heap.liveBytes()

    // The ring's image is what each place shows; the canvas has it where
    // no mark is, and nothing beside the box.
    colorpicker.init(&w.*.picker, allocator, w.*.color)
    const box = ui.rect(20, 30, 301, 301)
    if widgetFrame(w, &w.*.canvas, box) != colorpicker.PICK_NONE || colorpicker.renders(&w.*.picker) != 1 { return 187 }
    const geo = colorpicker.geometry(box, colorpicker.SHAPE_RING, w.*.picker.hue, 1)
    var checked: usize = 0
    if !ringImageMatches(&w.*.picker, &geo, &checked) || checked < 50000 { return 188 }
    var x: i32 = 0
    var y: i32 = 0
    onRing(&geo, w.*.picker.hue + 0.5, &x, &y)
    const image_at = w.*.picker.pixels[@intCast(usize, y - box.y) * @intCast(usize, box.width) + @intCast(usize, x - box.x)]
    if canvasAt(w, x, y) != image_at || image_at >> 24 != 255 { return 189 }
    if canvasAt(w, box.x + 2, box.y + 2) != w.*.theme.background || canvasAt(w, ui.right(box), box.y + 150) != w.*.theme.background || canvasAt(w, box.x + 150, box.y - 1) != w.*.theme.background { return 190 }
    // The same frame again, and a colour of the same hue: no rendering;
    // another hue: the triangle again.
    _ = widgetFrame(w, &w.*.canvas, box)
    if colorpicker.renders(&w.*.picker) != 1 { return 191 }
    w.*.color = 0xFF336699
    _ = widgetFrame(w, &w.*.canvas, box)
    if colorpicker.renders(&w.*.picker) != 2 { return 192 }
    checked = 0
    if !ringImageMatches(&w.*.picker, &colorpicker.geometry(box, colorpicker.SHAPE_RING, w.*.picker.hue, 1), &checked) { return 193 }

    // A layout pass: the region named, nothing rendered (a new hue
    // waits for a frame with pixels).
    w.*.color = 0xFF66CC33
    _ = widgetFrame(w, &w.*.nowhere, box)
    const named = view.areaOf(&w.*.ui, selectorId())
    if colorpicker.renders(&w.*.picker) != 2 || named.x != box.x || named.width != box.width || named.height != box.height { return 194 }
    _ = widgetFrame(w, &w.*.canvas, box)
    if colorpicker.renders(&w.*.picker) != 3 { return 195 }

    // A drag in the triangle of a colour of no alpha: the place's colour,
    // still of no alpha.
    w.*.color = 0x00FF0000
    _ = widgetFrame(w, &w.*.canvas, box)
    const red = colorpicker.geometry(box, colorpicker.SHAPE_RING, w.*.picker.hue, 1)
    placeIn(&red, 0.4, 0.3, &x, &y)
    widgetDrag(w, box, @intFromFloat(i32, red.cx), @intFromFloat(i32, red.cy), x, y)
    var s: f64 = 0.0
    var v: f64 = 0.0
    expectedTriangle(&red, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &s, &v)
    if w.*.color != color_module.fromHsv(w.*.picker.hue, w.*.picker.saturation, w.*.picker.value, 0) || !near(w.*.picker.saturation, s, 1.0 / 255.0) || !near(w.*.picker.value, v, 1.0 / 255.0) { return 196 }
    // A grey keeps the hue the picker had, black its saturation too.
    const hue = w.*.picker.hue
    colorpicker.follow(&w.*.picker, 0xFF808080)
    if w.*.picker.hue != hue || w.*.picker.saturation != 0.0 || !near(w.*.picker.value, 128.0 / 255.0, 1.0e-12) { return 197 }
    colorpicker.follow(&w.*.picker, 0xFF336699)
    const kept_s = w.*.picker.saturation
    colorpicker.follow(&w.*.picker, 0xFF000000)
    if w.*.picker.saturation != kept_s || w.*.picker.value != 0.0 { return 198 }

    // The square and the bar: exactly hsvToRgb's colours.
    w.*.color = 0xFF3366CC
    colorpicker.setShape(&w.*.picker, colorpicker.SHAPE_SQUARE)
    const square_box = ui.rect(15, 25, 330, 304)
    _ = widgetFrame(w, &w.*.canvas, square_box)
    const square = colorpicker.geometry(square_box, colorpicker.SHAPE_SQUARE, w.*.picker.hue, 1)
    checked = 0
    if square.square.width < 200 || !squareImageMatches(&w.*.picker, &square, &checked) || checked < 70000 { return 199 }
    w.*.color = 0xFFCC3366
    _ = widgetFrame(w, &w.*.canvas, square_box)
    checked = 0
    if !squareImageMatches(&w.*.picker, &square, &checked) { return 200 }
    colorpicker.setShape(&w.*.picker, colorpicker.SHAPE_RING)

    // Twice the scale: the ring twice as wide at least, drawn.
    w.*.theme = theme_module.scaled(theme_module.dark(), 2)
    const before = colorpicker.renders(&w.*.picker)
    _ = widgetFrame(w, &w.*.canvas, ui.rect(10, 10, 600, 600))
    const big = colorpicker.geometry(ui.rect(10, 10, 600, 600), colorpicker.SHAPE_RING, w.*.picker.hue, 2)
    if colorpicker.renders(&w.*.picker) != before + 1 || big.outer - big.inner < 24.0 || canvasAt(w, 310, 14) == w.*.theme.background { return 201 }
    w.*.theme = theme_module.scaled(theme_module.dark(), 1)

    // Boxes partly or wholly off the canvas, one too large to render, and
    // sizes from nothing to 40 pixels in both shapes: no trap; nothing
    // drawn beside the box, nothing at all when it is too small.
    _ = widgetFrame(w, &w.*.canvas, ui.rect(-200, -250, 300, 300))
    if canvasAt(w, 150, 100) != w.*.theme.background || canvasAt(w, 60, 20) == w.*.theme.background { return 202 }
    _ = widgetFrame(w, &w.*.canvas, ui.rect(500, 520, 300, 300))
    if canvasAt(w, 450, 600) != w.*.theme.background || canvasAt(w, 0, 0) != w.*.theme.background { return 203 }
    _ = widgetFrame(w, &w.*.canvas, ui.rect(-2000, 100, 300, 300))
    if !untouched(w) { return 204 }
    _ = widgetFrame(w, &w.*.canvas, ui.rect(100, 2000, 300, 300))
    if !untouched(w) { return 204 }
    _ = widgetFrame(w, &w.*.canvas, ui.rect(0, 0, 5000, 5000))
    if !untouched(w) || view.areaOf(&w.*.ui, selectorId()).width != 5000 { return 205 }
    var size: i32 = -2
    while size <= 40 {
        _ = widgetFrame(w, &w.*.canvas, ui.rect(64, 64, size, size))
        if size < 24 && !untouched(w) { return 206 }
        colorpicker.setShape(&w.*.picker, colorpicker.SHAPE_SQUARE)
        _ = widgetFrame(w, &w.*.canvas, ui.rect(64, 64, size, size))
        if size < 24 && !untouched(w) { return 207 }
        colorpicker.setShape(&w.*.picker, colorpicker.SHAPE_RING)
        size += 1
    }
    // The memory of the image given back, also twice.
    colorpicker.release(&w.*.picker)
    colorpicker.release(&w.*.picker)
    if std.heap.liveBytes() != live { return 208 }
    // A picker made, drawn at many sizes (its image grown and reused) and
    // given back 300 times: the heap as it was.
    var round: i32 = 0
    while round < 300 {
        colorpicker.init(&w.*.picker, allocator, 0xFF000000 | @intCast(u32, round) * 0x030507)
        colorpicker.setShape(&w.*.picker, if round & 1 == 0 { colorpicker.SHAPE_RING } else { colorpicker.SHAPE_SQUARE })
        _ = widgetFrame(w, &w.*.canvas, ui.rect(5, 5, 40 + round, 30 + round))
        _ = widgetFrame(w, &w.*.canvas, ui.rect(5, 5, 340 - round, 300 - round))
        colorpicker.release(&w.*.picker)
        round += 1
    }
    if std.heap.liveBytes() != live { return 209 }
    // The value arena over 1000 frames.
    colorpicker.init(&w.*.picker, allocator, 0xFF3366CC)
    if !widgetFramesTake(w, box) { return 210 }
    colorpicker.release(&w.*.picker)
    if std.heap.liveBytes() != live { return 211 }

    // The history: a count beyond what it holds is a full one; a colour
    // noted again moves to the front, the others keep their order.
    var history = colorpicker.History.{ .colors = undefined, .count = 1000 }
    var index: usize = 0
    while index < colorpicker.HISTORY {
        history.colors[index] = 0xFF000000 | @intCast(u32, index)
        index += 1
    }
    colorpicker.remember(&history, 0xFF000013)
    if history.count != colorpicker.HISTORY || history.colors[0] != 0xFF000013 || history.colors[1] != 0xFF000000 || history.colors[19] != 0xFF000012 { return 212 }
    colorpicker.remember(&history, 0xFFABCDEF)
    if history.count != colorpicker.HISTORY || history.colors[0] != 0xFFABCDEF || history.colors[1] != 0xFF000013 || history.colors[19] != 0xFF000011 { return 213 }
    // History cells: inside the row, apart, the row's first at its left
    // edge and its last at its right edge, at any width.
    var width: i32 = 120
    while width <= 420 {
        const area = ui.rect(7, 9, width, colorpicker.historyHeight(width, 1))
        const columns: usize = if width >= 320 { 20 } else { 10 }
        index = 0
        while index < colorpicker.HISTORY {
            const cell = colorpicker.historyCell(area, index, 1)
            if !inside(cell, area) || cell.width < 9 || cell.width != cell.height { return 214 }
            if index % columns != 0 && (overlap(cell, colorpicker.historyCell(area, index - 1, 1)) || cell.x - ui.right(colorpicker.historyCell(area, index - 1, 1)) < 3) { return 214 }
            if index % columns == 0 && cell.x != area.x { return 215 }
            if index % columns == columns - 1 && ui.right(cell) != ui.right(area) { return 215 }
            index += 1
        }
        width += 1
    }
    if colorpicker.historyHeight(0, 1) != 0 || colorpicker.historyHeight(-5, 1) != 0 || colorpicker.selectorHeight(300, colorpicker.SHAPE_SQUARE, 0) != colorpicker.selectorHeight(300, colorpicker.SHAPE_SQUARE, 1) { return 216 }
    kit_module.destroy(w.*.kit)
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(T), 16)
    if memory == null { return 182 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    t.*.shots = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { t.*.shots = std.string.asSlice(named.?) }
    const made = script.headless(allocator)
    if made == null { return 183 }
    t.*.app = made.?
    const app = t.*.app
    if !run(t, "size 1280 800\nnew 320 240 FFFFFF\n") { return 184 }
    // The colour docker gets the right side's height: the other dockers
    // hidden, the palette behind it.
    docks.hideAll(app)
    docks.toggle(app, palette_docker.ID)
    docks.toggle(app, color_docker.ID)
    if !docks.isShown(app, color_docker.ID) || !docks.isShown(app, palette_docker.ID) || docks.isShown(app, HISTORY_DOCKER) { return 5 }
    docks.setAreaWidth(app, docks.AREA_RIGHT, 280)
    if !frame(t) || docks.contentOf(app, color_docker.ID).width <= 0 { return 185 }

    var failed = checkSelector(t)
    if failed != 0 { return failed }
    failed = checkSquare(t)
    if failed != 0 { return failed }
    failed = checkSliders(t)
    if failed != 0 { return failed }
    failed = checkFields(t)
    if failed != 0 { return failed }
    failed = checkWidth(t, 240, "color-240.png")
    if failed != 0 { return failed }
    failed = checkWidth(t, 400, "color-400.png")
    if failed != 0 { return failed }
    failed = checkWidth(t, 280, "color-280.png")
    if failed != 0 { return failed }
    failed = checkLooks(t)
    if failed != 0 { return failed }
    failed = checkPalette(t)
    if failed != 0 { return failed }
    failed = checkPaletteWidth(t, 240, "palette-240.png")
    if failed != 0 { return failed }
    failed = checkPaletteWidth(t, 400, "palette-400.png")
    if failed != 0 { return failed }
    failed = checkEdges(t)
    if failed != 0 { return failed }
    failed = checkArena(t)
    if failed != 0 { return failed }
    return 13
}
