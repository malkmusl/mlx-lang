// EXPECTED in heap memory: read at run time from the constant itself,
// even one row, it would be copied whole into the value arena each time.
var keptExpected: table.Kept = table.Kept.{ .address = 0, .length = 0 }

// An opaque colour whose three channels differ, and the same at half
// alpha (premultiplied, as every canvas colour).
const INK: u32 = 0xFFE87830
const HALF_INK: u32 = 0x80743C18

// The probe canvases: an icon is drawn at (MARGIN, MARGIN) on them.
const PROBE: usize = 64
const MARGIN: i32 = 8
// The canvas for an icon larger than any kept picture.
const LARGE: usize = 320

// The contact sheet.
const COLUMNS: usize = 6
const CELL_WIDTH: usize = 186
const CELL_HEIGHT: usize = 30
const EDGE: usize = 16
const HEADER: usize = 48

const State = struct {
    first: [*]u32
    second: [*]u32
    // Every icon's picture at 24 pixels, 576 words each.
    reference: [*]u32
    large: [*]u32
    // As large: an icon's picture of LARGEST pixels, to sample.
    spare: [*]u32
    sheet: [*]u32
    sheetWidth: usize
    sheetHeight: usize
    text: Text
    hasText: bool
}

fn words(allocator: std.allocator.Allocator, count: usize) -> ?[*]u32 {
    const memory = allocator.alloc(count * 4, 16)
    if memory == null { return null }
    unsafe { return @ptrCast([*]u32, memory.?) }
}

fn canvasOn(pixels: [*]u32, width: usize, height: usize) -> Canvas {
    return Canvas.{ .pixels = pixels, .width = width, .height = height, .stride = width, .swapRedBlue = false, .device = 0, .opacity = 255 }
}

fn fillWords(pixels: [*]u32, count: usize, value: u32) -> void {
    var index: usize = 0
    while index < count {
        pixels[index] = value
        index += 1
    }
}

fn sameWords(a: [*]const u32, b: [*]const u32, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// `color` at the share `amount` (0-255) of a pixel: what a picture's pixel
// must be.
fn shared(color: u32, amount: u32) -> u32 {
    return pixel.pack(pixel.mul(color >> 24, amount), pixel.mul((color >> 16) & 255, amount), pixel.mul((color >> 8) & 255, amount), pixel.mul(color & 255, amount))
}

// Looks at a square canvas `side` wide on which an icon was drawn `size`
// pixels large at (MARGIN, MARGIN) in the opaque `color` over nothing:
// 0 when nothing lies outside the icon's box and every pixel in it is
// the colour at some share; 1 for a pixel outside, 2 for another colour.
// `covered` gets the shares' sum.
fn examine(pixels: [*]const u32, side: usize, size: usize, color: u32, covered: *usize) -> u32 {
    const low = @intCast(usize, MARGIN)
    var sum: usize = 0
    var row: usize = 0
    while row < side {
        var column: usize = 0
        while column < side {
            const word = pixels[row * side + column]
            const inside = row >= low && row < low + size && column >= low && column < low + size
            if !inside {
                if word != 0 { return 1 }
            } else {
                const amount = word >> 24
                if word != shared(color, amount) { return 2 }
                sum += @intCast(usize, amount)
            }
            column += 1
        }
        row += 1
    }
    covered.* = sum
    return 0
}

// One channel (at `shift`) of two pixels at most one apart.
fn near(a: u32, b: u32, shift: u32) -> bool {
    const x = (a >> shift) & 255
    const y = (b >> shift) & 255
    return x <= y + 1 && y <= x + 1
}

// Looks at the large canvas, an icon drawn on it larger than any kept
// picture in the opaque `color`: 0 when every pixel is the colour at some
// share (each channel to one in 255: the scaling mixes neighbouring
// pixels, and the rounding of a mix and of a share differ), 1 otherwise.
fn examineLarge(pixels: [*]const u32, color: u32) -> u32 {
    var index: usize = 0
    while index < LARGE * LARGE {
        const word = pixels[index]
        const wanted = shared(color, word >> 24)
        if !near(word, wanted, 16) || !near(word, wanted, 8) || !near(word, wanted, 0) { return 1 }
        index += 1
    }
    return 0
}

fn say(icon: u16, what: []const u8) -> void {
    _ = std.io.print(icons.name(icon))
    _ = std.io.print(": ")
    _ = std.io.println(what)
}

// Draws the sheet: a row of buttons as a toolbar shows them (plain, under
// the pointer, chosen, disabled), then every icon at 24 and at 16 pixels
// with its key, down the columns.
fn drawSheet(s: *State, theme: *Theme) -> void {
    var canvas = canvasOn(s.*.sheet, s.*.sheetWidth, s.*.sheetHeight)
    canvas_module.clear(&canvas, theme.*.background)
    const total = icons.count()
    const rows = (total + COLUMNS - 1) / COLUMNS
    var button: usize = 0
    while button < 16 {
        const x = @intCast(i32, EDGE + button * 30)
        const y = @intCast(i32, EDGE)
        var ground = theme.*.button
        var ink = theme.*.text
        if button == 1 { ground = theme.*.buttonHover }
        if button == 2 {
            ground = theme.*.selected
            ink = theme.*.accent
        }
        if button == 3 { ink = theme.*.disabled }
        if button >= 8 { ground = theme.*.panel }
        canvas_module.fillRoundedRect(&canvas, x, y, 26, 26, theme.*.smallRadius, ground)
        icons.draw(&canvas, @intCast(u16, button), x + 5, y + 5, 16, ink)
        button += 1
    }
    if s.*.hasText {
        text_module.drawText(&canvas, &s.*.text, "Nebula: every icon at 24 and at 16 pixels", @intCast(i32, EDGE + 16 * 30 + 12), @intCast(i32, EDGE + 6), theme.*.dim, 0)
    }
    canvas_module.fillRect(&canvas, @intCast(i32, EDGE), @intCast(i32, HEADER - 5), @intCast(i32, s.*.sheetWidth - 2 * EDGE), 1, theme.*.divider)
    var index: usize = 0
    while index < total {
        const x = @intCast(i32, EDGE + (index / rows) * CELL_WIDTH)
        const y = @intCast(i32, HEADER + (index % rows) * CELL_HEIGHT)
        const icon = @intCast(u16, index)
        icons.draw(&canvas, icon, x + 2, y + 3, 24, theme.*.text)
        icons.draw(&canvas, icon, x + 36, y + 7, 16, theme.*.text)
        if s.*.hasText {
            text_module.drawText(&canvas, &s.*.text, icons.name(icon), x + 62, y + (@intCast(i32, CELL_HEIGHT) - s.*.text.ascent * 3 / 2) / 2, theme.*.dim, @intCast(i32, CELL_WIDTH) - 66)
        }
        index += 1
    }
}

// The sheet is opaque everywhere: a window drawn so shows nothing through.
fn sheetOpaque(s: *State) -> bool {
    const count = s.*.sheetWidth * s.*.sheetHeight
    var index: usize = 0
    while index < count {
        if (s.*.sheet[index] >> 24) != 255 { return false }
        index += 1
    }
    return true
}

// Saves the sheet as `file` in `directory` ("" for the current one).
fn saveSheet(s: *State, directory: []const u8, file: []const u8, allocator: std.allocator.Allocator) -> bool {
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length: usize = 0
    if directory.length > 0 {
        length = std.text.append(bytes, length, 599, directory)
        length = std.text.append(bytes, length, 599, "/")
    }
    length = std.text.append(bytes, length, 599, file)
    bytes[length] = 0
    return png.saveFile(bytes, s.*.sheet, s.*.sheetWidth, s.*.sheetHeight, s.*.sheetWidth, true, allocator)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.heap.allocator()
    const total = icons.count()

    // Numbers and keys.
    const expected = table.keep(Expected, &keptExpected, EXPECTED[0..])
    if total != expected.length { return 1 }
    var index: usize = 0
    while index < total {
        const icon = expected[index].icon
        if @intCast(usize, icon) != index { return 2 }
        if !std.text.same(icons.name(icon), expected[index].name) { return 3 }
        if icons.named(expected[index].name) != icon { return 4 }
        var other: usize = 0
        while other < index {
            if std.text.same(expected[other].name, expected[index].name) { return 5 }
            other += 1
        }
        index += 1
    }
    if icons.name(@intCast(u16, total)).length != 0 || icons.name(icons.NONE).length != 0 { return 6 }
    if icons.named("no-such-icon") != icons.NONE || icons.named("") != icons.NONE { return 7 }

    const memory = allocator.alloc(@sizeOf(State), 16)
    if memory == null { return 8 }
    const s: *State = unsafe { @ptrCast(*State, memory.?) }
    const rows = (total + COLUMNS - 1) / COLUMNS
    s.*.sheetWidth = 2 * EDGE + COLUMNS * CELL_WIDTH
    s.*.sheetHeight = HEADER + rows * CELL_HEIGHT + EDGE
    const first = words(allocator, PROBE * PROBE)
    const second = words(allocator, PROBE * PROBE)
    const reference = words(allocator, total * 576)
    const large = words(allocator, LARGE * LARGE)
    const spare = words(allocator, LARGE * LARGE)
    const sheet = words(allocator, s.*.sheetWidth * s.*.sheetHeight)
    if first == null || second == null || reference == null || large == null || spare == null || sheet == null { return 8 }
    s.*.first = first.?
    s.*.second = second.?
    s.*.reference = reference.?
    s.*.large = large.?
    s.*.spare = spare.?
    s.*.sheet = sheet.?
    s.*.text.loaded = false
    // Without a font the sheets have no keys; everything else is checked.
    s.*.hasText = text_module.loadText(&s.*.text, 12, allocator)

    var one = canvasOn(s.*.first, PROBE, PROBE)
    var two = canvasOn(s.*.second, PROBE, PROBE)
    const cells = PROBE * PROBE
    var covered: usize = 0

    // Every icon at 24 pixels: in its box, the colour only, neither blank
    // nor a blot; the same again from the kept pictures.
    if icons.cached() != 0 || icons.cachedBytes() != 0 { return 9 }
    index = 0
    while index < total {
        const icon = @intCast(u16, index)
        fillWords(s.*.first, cells, 0)
        icons.draw(&one, icon, MARGIN, MARGIN, 24, INK)
        const status = examine(s.*.first, PROBE, 24, INK, &covered)
        if status == 1 {
            say(icon, "draws outside its box")
            return 10
        }
        if status == 2 {
            say(icon, "has another colour than the one asked")
            return 11
        }
        if covered * 100 < 576 * 255 * 3 || covered * 100 > 576 * 255 * 85 {
            say(icon, "covers too little or too much of its box")
            return 12
        }
        var row: usize = 0
        while row < 24 {
            var column: usize = 0
            while column < 24 {
                s.*.reference[index * 576 + row * 24 + column] = s.*.first[(row + 8) * PROBE + column + 8]
                column += 1
            }
            row += 1
        }
        const kept = icons.cached()
        if kept != index + 1 { return 47 }
        fillWords(s.*.second, cells, 0)
        icons.draw(&two, icon, MARGIN, MARGIN, 24, INK)
        if !sameWords(s.*.first, s.*.second, cells) {
            say(icon, "is another picture the second time")
            return 14
        }
        if icons.cached() != kept { return 15 }
        index += 1
    }
    if icons.cachedBytes() != total * 576 * 4 { return 16 }

    // The other sizes.
    const sizes = [4]usize{ 16, 20, 32, 48 }
    for size in sizes {
        index = 0
        while index < total {
            const icon = @intCast(u16, index)
            fillWords(s.*.first, cells, 0)
            icons.draw(&one, icon, MARGIN, MARGIN, @intCast(i32, size), INK)
            const status = examine(s.*.first, PROBE, size, INK, &covered)
            if status != 0 {
                say(icon, "draws outside its box or in another colour at another size")
                return 17
            }
            if covered * 100 < size * size * 255 * 2 || covered * 100 > size * size * 255 * 88 {
                say(icon, "covers too little or too much at another size")
                return 18
            }
            index += 1
        }
    }

    // Tiny sizes and one that fills the probe: no trap, in the box, the
    // colour only.
    var tiny: usize = 1
    while tiny <= 56 {
        index = 0
        while index < total {
            fillWords(s.*.first, cells, 0)
            icons.draw(&one, @intCast(u16, index), MARGIN, MARGIN, @intCast(i32, tiny), INK)
            if examine(s.*.first, PROBE, tiny, INK, &covered) != 0 {
                say(@intCast(u16, index), "draws outside its box or in another colour at a tiny size")
                return 55
            }
            index += 1
        }
        tiny = if tiny == 15 { 56 } else { tiny + 1 }
    }

    // After release() nothing is kept, and every picture is drawn the
    // same again.
    icons.release()
    if icons.cached() != 0 || icons.cachedBytes() != 0 { return 19 }
    index = 0
    while index < total {
        fillWords(s.*.first, cells, 0)
        icons.draw(&one, @intCast(u16, index), MARGIN, MARGIN, 24, INK)
        var row: usize = 0
        while row < 24 {
            if !sameWords(s.*.reference + (index * 576 + row * 24), s.*.first + ((row + 8) * PROBE + 8), 24) {
                say(@intCast(u16, index), "is another picture after release()")
                return 20
            }
            row += 1
        }
        index += 1
    }

    // A layout pass's canvas and one without rows: nothing drawn, nothing
    // made.
    icons.release()
    var nowhere = view.layoutCanvas()
    var flat = canvasOn(s.*.first, PROBE, 0)
    index = 0
    while index < total {
        icons.draw(&nowhere, @intCast(u16, index), 10, 10, 24, INK)
        icons.draw(&flat, @intCast(u16, index), 10, 10, 24, INK)
        icons.drawFor(index, &nowhere, 10, 10, 24, INK)
        index += 1
    }
    if icons.cached() != 0 { return 21 }

    // What is no icon, no size, no colour, and what lies off the canvas.
    fillWords(s.*.first, cells, 0)
    icons.draw(&one, icons.NONE, MARGIN, MARGIN, 24, INK)
    icons.draw(&one, @intCast(u16, total), MARGIN, MARGIN, 24, INK)
    icons.drawFor(total, &one, MARGIN, MARGIN, 24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, MARGIN, MARGIN, 0, INK)
    icons.draw(&one, icons.TOOL_BRUSH, MARGIN, MARGIN, -24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, MARGIN, MARGIN, 24, 0)
    icons.draw(&one, icons.TOOL_BRUSH, MARGIN, MARGIN, 24, 0x00FFFFFF)
    icons.draw(&one, icons.TOOL_BRUSH, 64, 8, 24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, 8, 64, 24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, -24, 8, 24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, 8, -24, 24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, 2147483647, 2147483647, 24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, -2147483648, -2147483648, 24, INK)
    icons.draw(&one, icons.TOOL_BRUSH, 2147483600, 8, 2147483647, INK)
    index = 0
    while index < cells {
        if s.*.first[index] != 0 { return 22 }
        index += 1
    }
    if icons.cached() != 0 { return 23 }

    // An icon partly on the canvas: the part that is on it, nothing else.
    const brush = @intCast(usize, icons.TOOL_PAN) * 576
    fillWords(s.*.first, cells, 0)
    icons.draw(&one, icons.TOOL_PAN, -10, -7, 24, INK)
    icons.draw(&one, icons.TOOL_PAN, 50, 53, 24, INK)
    var row: usize = 0
    while row < PROBE {
        var column: usize = 0
        while column < PROBE {
            var wanted: u32 = 0
            if row < 17 && column < 14 { wanted = s.*.reference[brush + (row + 7) * 24 + column + 10] }
            if row >= 53 && column >= 50 { wanted = s.*.reference[brush + (row - 53) * 24 + column - 50] }
            if s.*.first[row * PROBE + column] != wanted { return 24 }
            column += 1
        }
        row += 1
    }

    // A translucent colour: the same shares of it. On an opaque ground the
    // canvas stays opaque and has the picture over the ground; on a faded
    // canvas the picture is faded.
    const ground: u32 = 0xFF1E2028
    index = 0
    while index < total {
        const icon = @intCast(u16, index)
        fillWords(s.*.first, cells, 0)
        icons.draw(&one, icon, MARGIN, MARGIN, 24, HALF_INK)
        fillWords(s.*.second, cells, ground)
        icons.draw(&two, icon, MARGIN, MARGIN, 24, HALF_INK)
        row = 0
        while row < 24 {
            var column: usize = 0
            while column < 24 {
                const amount = s.*.reference[index * 576 + row * 24 + column] >> 24
                const at = (row + 8) * PROBE + column + 8
                if s.*.first[at] != shared(HALF_INK, amount) { return 25 }
                if s.*.second[at] != canvas_module.over(ground, shared(HALF_INK, amount), 255) { return 26 }
                if (s.*.second[at] >> 24) != 255 { return 27 }
                column += 1
            }
            row += 1
        }
        index += 1
    }
    fillWords(s.*.first, cells, 0)
    canvas_module.setOpacity(&one, 128)
    icons.draw(&one, icons.VISIBLE, MARGIN, MARGIN, 24, INK)
    canvas_module.setOpacity(&one, 255)
    const eye = @intCast(usize, icons.VISIBLE) * 576
    row = 0
    while row < 24 {
        var column: usize = 0
        while column < 24 {
            if s.*.first[(row + 8) * PROBE + column + 8] != canvas_module.over(0, s.*.reference[eye + row * 24 + column], 128) { return 28 }
            column += 1
        }
        row += 1
    }
    fillWords(s.*.first, cells, 0)
    canvas_module.setOpacity(&one, 0)
    icons.draw(&one, icons.VISIBLE, MARGIN, MARGIN, 24, INK)
    canvas_module.setOpacity(&one, 255)
    if s.*.first[20 * PROBE + 20] != 0 { return 29 }

    // drawFor() is draw() with the icon's number as its context.
    fillWords(s.*.first, cells, 0)
    fillWords(s.*.second, cells, 0)
    icons.draw(&one, icons.LAYER_DELETE, MARGIN, MARGIN, 20, INK)
    icons.drawFor(@intCast(usize, icons.LAYER_DELETE), &two, MARGIN, MARGIN, 20, INK)
    if !sameWords(s.*.first, s.*.second, cells) || examine(s.*.first, PROBE, 20, INK, &covered) != 0 || covered == 0 { return 30 }

    // An icon larger than any kept picture: its picture scaled up, in its
    // box, the colour only (a square's inside exactly the colour), the
    // picture kept no larger than LARGEST.
    var big = canvasOn(s.*.large, LARGE, LARGE)
    fillWords(s.*.large, LARGE * LARGE, 0)
    icons.release()
    icons.draw(&big, icons.STOP, 10, 10, 300, INK)
    if icons.cachedBytes() != @intCast(usize, icons.LARGEST * icons.LARGEST) * 4 { return 50 }
    if s.*.large[160 * LARGE + 160] != INK || s.*.large[110 * LARGE + 110] != INK || s.*.large[210 * LARGE + 210] != INK { return 31 }
    index = 0
    while index < LARGE {
        if s.*.large[5 * LARGE + index] != 0 || s.*.large[315 * LARGE + index] != 0 || s.*.large[index * LARGE + 5] != 0 || s.*.large[index * LARGE + 315] != 0 { return 32 }
        index += 1
    }
    if examineLarge(s.*.large, INK) != 0 { return 51 }
    // Just above LARGEST and very large and far: the part on the canvas.
    fillWords(s.*.large, LARGE * LARGE, 0)
    icons.draw(&big, icons.TOOL_BRUSH, 0, 0, icons.LARGEST + 1, INK)
    if examineLarge(s.*.large, INK) != 0 { return 52 }
    fillWords(s.*.first, cells, 0)
    icons.draw(&one, icons.STOP, -1073741800, -1073741800, 2147483647, INK)
    index = 0
    while index < cells {
        if s.*.first[index] != INK { return 53 }
        index += 1
    }
    fillWords(s.*.first, cells, 0)
    icons.draw(&one, icons.STOP, -2147483600, -2147483600, 2147483647, INK)
    icons.draw(&one, icons.STOP, 60, 60, 2147483647, INK)
    if s.*.first[0] != 0 || s.*.first[59 * PROBE + 59] != 0 || s.*.first[60 * PROBE + 60] != 0 { return 54 }

    // More pictures than are kept: their number and their bytes stay
    // bounded, and one that was forgotten is drawn the same again.
    icons.release()
    var shade: u32 = 0
    while shade < 3 {
        index = 0
        while index < total {
            icons.draw(&one, @intCast(u16, index), MARGIN, MARGIN, 24, 0xFF000000 | (shade * 80 + 40))
            if icons.cached() > icons.CACHE_PICTURES { return 33 }
            index += 1
        }
        shade += 1
    }
    if total * 3 > icons.CACHE_PICTURES && icons.cached() != icons.CACHE_PICTURES { return 34 }
    const largest = @intCast(usize, icons.LARGEST)
    index = 0
    while index < 96 {
        icons.draw(&big, @intCast(u16, index), 10, 10, 256, INK)
        if icons.cachedBytes() > icons.CACHE_BYTES || icons.cached() > icons.CACHE_PICTURES || icons.cached() == 0 { return 35 }
        index += 1
    }
    if icons.cachedBytes() + largest * largest * 4 <= icons.CACHE_BYTES { return 36 }
    fillWords(s.*.first, cells, 0)
    icons.draw(&one, icons.TOOL_BRUSH, MARGIN, MARGIN, 24, INK)
    row = 0
    while row < 24 {
        if !sameWords(s.*.reference + row * 24, s.*.first + ((row + 8) * PROBE + 8), 24) { return 37 }
        row += 1
    }

    // The sheets, on the dark and on the light theme.
    var dark = theme_module.dark()
    drawSheet(s, &dark)
    if !sheetOpaque(s) { return 38 }
    const shots = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if !saveSheet(s, "", "icons-dark.png", allocator) { return 39 }
    if shots != null && shots.?.length > 0 && !saveSheet(s, std.string.asSlice(shots.?), "icons-dark.png", allocator) { return 40 }
    var light = theme_module.light()
    drawSheet(s, &light)
    if !sheetOpaque(s) { return 41 }
    if !saveSheet(s, "", "icons-light.png", allocator) { return 42 }
    if shots != null && shots.?.length > 0 && !saveSheet(s, std.string.asSlice(shots.?), "icons-light.png", allocator) { return 43 }

    // Making pictures and drawing kept ones take nothing of the value
    // arena (which a window's loop gives back only when it turns).
    icons.release()
    const arena = turns.locate()
    var before = turns.used(arena)
    index = 0
    while index < total {
        icons.draw(&one, @intCast(u16, index), MARGIN, MARGIN, 24, INK)
        icons.draw(&one, @intCast(u16, index), MARGIN, MARGIN, 16, INK)
        _ = icons.name(@intCast(u16, index))
        index += 1
    }
    icons.draw(&big, icons.TOOL_FILL, 0, 4, 120, INK)
    if icons.named("bullet") != icons.BULLET { return 48 }
    if turns.used(arena) != before { return 49 }
    const kept = icons.cached()
    before = turns.used(arena)
    var round: usize = 0
    while round < 5000 {
        const icon = @intCast(u16, round % total)
        icons.draw(&one, icon, MARGIN + @intCast(i32, round % 7) - 3, MARGIN, 24, INK)
        icons.drawFor(round % total, &one, MARGIN, MARGIN + @intCast(i32, round % 5) - 2, 16, INK)
        if round % 50 == 0 { icons.draw(&big, icons.TOOL_FILL, @intCast(i32, round % 13) - 6, 4, 120, INK) }
        round += 1
    }
    if turns.used(arena) != before { return 44 }
    if icons.cached() != kept { return 45 }

    icons.release()
    if icons.cached() != 0 { return 46 }

    // Edges, the order of forgetting, the heap, the larger icons.
    const keys = checkKeys()
    if keys != 0 { return keys }
    const faint = checkFaintest(s)
    if faint != 0 { return faint }
    const lighting = checkOpacity(s)
    if lighting != 0 { return lighting }
    const dot = checkOnePixel(s)
    if dot != 0 { return dot }
    const padded = checkPadded(s)
    if padded != 0 { return padded }
    const swapping = checkSwapped(s)
    if swapping != 0 { return swapping }
    const oldest = checkOldestGoes(s)
    if oldest != 0 { return oldest }
    const heap = checkHeap(s)
    if heap != 0 { return heap }
    const stretched = checkStretched(s)
    if stretched != 0 { return stretched }
    const shape = checkStretchShape(s)
    if shape != 0 { return shape }
    icons.release()
    if icons.cached() != 0 { return 46 }
    return 13
}

// Keys differing from a real one by case, by a letter missing or one too
// many are no key.
fn checkKeys() -> u8 {
    if icons.named("tool-brush") != icons.TOOL_BRUSH { return 79 }
    if icons.named("TOOL-BRUSH") != icons.NONE || icons.named("tool-brus") != icons.NONE || icons.named("tool-brushx") != icons.NONE || icons.named(" tool-brush") != icons.NONE { return 79 }
    return 0
}

// The faintest colour there is (alpha 1, premultiplied): a pixel is that
// colour where the icon covers at least half of it (1 * share / 255
// rounds to 1 from a share of 128), and nothing elsewhere.
fn checkFaintest(s: *State) -> u8 {
    const faint: u32 = 0x01010101
    var one = canvasOn(s.*.first, PROBE, PROBE)
    const total = icons.count()
    var index: usize = 0
    while index < total {
        fillWords(s.*.first, PROBE * PROBE, 0)
        icons.draw(&one, @intCast(u16, index), MARGIN, MARGIN, 24, faint)
        var row: usize = 0
        while row < PROBE {
            var column: usize = 0
            while column < PROBE {
                var wanted: u32 = 0
                if row >= 8 && row < 32 && column >= 8 && column < 32 && (s.*.reference[index * 576 + (row - 8) * 24 + column - 8] >> 24) >= 128 { wanted = faint }
                if s.*.first[row * PROBE + column] != wanted {
                    say(@intCast(u16, index), "is wrong in the faintest colour")
                    return 85
                }
                column += 1
            }
            row += 1
        }
        index += 1
    }
    return 0
}

// The first probe, on which `icon` was drawn at 24 pixels at (MARGIN,
// MARGIN) over nothing, holds its reference picture laid over nothing at
// `opacity`, and nothing outside the icon's box.
fn sameAsFaded(s: *State, icon: u16, opacity: u32) -> bool {
    const base = @intCast(usize, icon) * 576
    var row: usize = 0
    while row < PROBE {
        var column: usize = 0
        while column < PROBE {
            var wanted: u32 = 0
            if row >= 8 && row < 32 && column >= 8 && column < 32 { wanted = canvas_module.over(0, s.*.reference[base + (row - 8) * 24 + column - 8], opacity) }
            if s.*.first[row * PROBE + column] != wanted { return false }
            column += 1
        }
        row += 1
    }
    return true
}

// A canvas whose opacity was set past 255 straight into it draws as at
// 255; at opacity 0 nothing is drawn and no picture is made for it; a
// context past every icon draws nothing.
fn checkOpacity(s: *State) -> u8 {
    var one = canvasOn(s.*.first, PROBE, PROBE)
    var big = canvasOn(s.*.large, LARGE, LARGE)
    fillWords(s.*.first, PROBE * PROBE, 0)
    one.opacity = 1000
    icons.draw(&one, icons.VISIBLE, MARGIN, MARGIN, 24, INK)
    if !sameAsFaded(s, icons.VISIBLE, 255) { return 69 }
    fillWords(s.*.large, LARGE * LARGE, 0)
    big.opacity = 300
    icons.draw(&big, icons.TOOL_FILL, 0, 0, 120, INK)
    fillWords(s.*.spare, LARGE * LARGE, 0)
    var plain = canvasOn(s.*.spare, LARGE, LARGE)
    icons.draw(&plain, icons.TOOL_FILL, 0, 0, 120, INK)
    if !sameWords(s.*.large, s.*.spare, LARGE * LARGE) { return 69 }

    icons.release()
    fillWords(s.*.first, PROBE * PROBE, 0)
    fillWords(s.*.large, LARGE * LARGE, 0)
    one.opacity = 0
    big.opacity = 0
    icons.draw(&one, icons.VISIBLE, MARGIN, MARGIN, 24, INK)
    icons.drawFor(@intCast(usize, icons.HIDDEN), &one, MARGIN, MARGIN, 24, INK)
    icons.draw(&big, icons.VISIBLE, 0, 0, 200, INK)
    var index: usize = 0
    while index < PROBE * PROBE {
        if s.*.first[index] != 0 { return 70 }
        index += 1
    }
    index = 0
    while index < LARGE * LARGE {
        if s.*.large[index] != 0 { return 70 }
        index += 1
    }
    if icons.cached() != 0 { return 71 }

    one.opacity = 255
    const most: usize = 18446744073709551615
    icons.drawFor(65536, &one, MARGIN, MARGIN, 24, INK)
    icons.drawFor(65536 + @intCast(usize, icons.TOOL_BRUSH), &one, MARGIN, MARGIN, 24, INK)
    icons.drawFor(most, &one, MARGIN, MARGIN, 24, INK)
    index = 0
    while index < PROBE * PROBE {
        if s.*.first[index] != 0 { return 72 }
        index += 1
    }
    if icons.cached() != 0 { return 72 }
    return 0
}

// What a canvas of one pixel shows of an icon: the one pixel of its
// picture that falls on it, wherever the icon lies; the word after the
// canvas is not touched.
fn checkOnePixel(s: *State) -> u8 {
    const chosen = [4]u16{ icons.TOOL_PAN, icons.STOP, icons.SETTINGS, icons.TOOL_BRUSH }
    var dot = canvasOn(s.*.first, 1, 1)
    for icon in chosen {
        var dy: usize = 0
        while dy < 26 {
            var dx: usize = 0
            while dx < 26 {
                s.*.first[0] = 0
                s.*.first[1] = 0x12345678
                icons.draw(&dot, icon, 0 - @intCast(i32, dx), 0 - @intCast(i32, dy), 24, INK)
                var wanted: u32 = 0
                if dx < 24 && dy < 24 { wanted = s.*.reference[@intCast(usize, icon) * 576 + dy * 24 + dx] }
                if s.*.first[0] != wanted || s.*.first[1] != 0x12345678 { return 73 }
                dx += 1
            }
            dy += 1
        }
    }
    // Stretched: only the one pixel, the colour at some share.
    s.*.first[0] = 0
    s.*.first[1] = 0x12345678
    icons.draw(&dot, icons.STOP, -100, -100, 200, INK)
    if s.*.first[0] != INK || s.*.first[1] != 0x12345678 { return 73 }
    return 0
}

// A canvas 40 pixels wide whose rows lie 64 apart: what is past its width
// in each row is not its own and stays as it was; in it, the pictures.
fn checkPadded(s: *State) -> u8 {
    const pan = @intCast(usize, icons.TOOL_PAN) * 576
    const foreign: u32 = 0x12345678
    var narrow = Canvas.{ .pixels = s.*.first, .width = 40, .height = 64, .stride = PROBE, .swapRedBlue = false, .device = 0, .opacity = 255 }
    var row: usize = 0
    while row < PROBE {
        var column: usize = 0
        while column < PROBE {
            s.*.first[row * PROBE + column] = if column < 40 { 0 } else { foreign }
            column += 1
        }
        row += 1
    }
    icons.draw(&narrow, icons.TOOL_PAN, 30, 8, 24, INK)
    icons.draw(&narrow, icons.TOOL_PAN, -12, 40, 24, INK)
    row = 0
    while row < PROBE {
        var column: usize = 0
        while column < PROBE {
            var wanted: u32 = 0
            if column >= 40 {
                wanted = foreign
            } else if row >= 8 && row < 32 && column >= 30 {
                wanted = s.*.reference[pan + (row - 8) * 24 + column - 30]
            } else if row >= 40 && column < 12 {
                wanted = s.*.reference[pan + (row - 40) * 24 + column + 12]
            }
            if s.*.first[row * PROBE + column] != wanted { return 74 }
            column += 1
        }
        row += 1
    }
    icons.draw(&narrow, icons.TOOL_FILL, 10, -30, 120, INK)
    icons.draw(&narrow, icons.STOP, -60, -60, 140, INK)
    row = 0
    while row < PROBE {
        var column: usize = 40
        while column < PROBE {
            if s.*.first[row * PROBE + column] != foreign { return 75 }
            column += 1
        }
        row += 1
    }
    return 0
}

// A word as a canvas that keeps red and blue the other way round holds it.
fn swapped(word: u32) -> u32 {
    return (word & 0xFF00FF00) | ((word >> 16) & 255) | ((word & 255) << 16)
}

// A canvas that keeps red and blue the other way round gets every
// picture with the two swapped: over nothing, over an opaque ground, and
// stretched.
fn checkSwapped(s: *State) -> u8 {
    const total = icons.count()
    const cells = PROBE * PROBE
    const ground: u32 = 0xFF3A2010
    var plain = canvasOn(s.*.first, PROBE, PROBE)
    var other = canvasOn(s.*.second, PROBE, PROBE)
    other.swapRedBlue = true
    var index: usize = 0
    while index < total {
        const icon = @intCast(u16, index)
        fillWords(s.*.first, cells, 0)
        fillWords(s.*.second, cells, 0)
        icons.draw(&plain, icon, MARGIN - 13, MARGIN + 3, 24, HALF_INK)
        icons.draw(&other, icon, MARGIN - 13, MARGIN + 3, 24, HALF_INK)
        var at: usize = 0
        while at < cells {
            if s.*.second[at] != swapped(s.*.first[at]) { return 76 }
            at += 1
        }
        fillWords(s.*.first, cells, ground)
        fillWords(s.*.second, cells, swapped(ground))
        icons.draw(&plain, icon, MARGIN, MARGIN, 20, INK)
        icons.draw(&other, icon, MARGIN, MARGIN, 20, INK)
        icons.draw(&plain, icon, 40, 44, 24, HALF_INK)
        icons.draw(&other, icon, 40, 44, 24, HALF_INK)
        at = 0
        while at < cells {
            if s.*.second[at] != swapped(s.*.first[at]) { return 77 }
            at += 1
        }
        index += 1
    }
    var big = canvasOn(s.*.large, LARGE, LARGE)
    var turned = canvasOn(s.*.spare, LARGE, LARGE)
    turned.swapRedBlue = true
    index = 0
    while index < total {
        fillWords(s.*.large, LARGE * LARGE, ground)
        fillWords(s.*.spare, LARGE * LARGE, swapped(ground))
        icons.draw(&big, @intCast(u16, index), -7, 5, 130, HALF_INK)
        icons.draw(&turned, @intCast(u16, index), -7, 5, 130, HALF_INK)
        var at: usize = 0
        while at < LARGE * LARGE {
            if s.*.spare[at] != swapped(s.*.large[at]) { return 78 }
            at += 1
        }
        index += 17
    }
    return 0
}

// The picture drawn longest ago is the one forgotten when another must
// be kept. Pictures of different sizes take different bytes, so the
// bytes kept say which one went.
fn checkOldestGoes(s: *State) -> u8 {
    var one = canvasOn(s.*.first, PROBE, PROBE)
    const total = icons.count()
    const most = icons.CACHE_PICTURES
    icons.release()
    // The first drawn: 20 x 20 x 4 bytes; the second: 30 x 30 x 4; the
    // rest 24 x 24 x 4, in colours nothing else is drawn in.
    icons.draw(&one, 0, 0, 0, 20, INK)
    icons.draw(&one, 1, 0, 0, 30, INK)
    var made: usize = 2
    while made < most {
        const k = made - 2
        icons.draw(&one, @intCast(u16, k % total), 0, 0, 24, 0xFF000000 | @intCast(u32, k / total + 1))
        made += 1
    }
    const full = 1600 + 3600 + (most - 2) * 2304
    if icons.cached() != most || icons.cachedBytes() != full { return 63 }
    // The first drawn again: now the second is the oldest, and goes for
    // the next new picture.
    icons.draw(&one, 0, 0, 0, 20, INK)
    if icons.cached() != most || icons.cachedBytes() != full { return 63 }
    icons.draw(&one, 2, 0, 0, 24, 0xFF0000FF)
    if icons.cached() != most || icons.cachedBytes() != full - 3600 + 2304 { return 64 }
    // The second again: made anew, and the oldest of the rest goes.
    icons.draw(&one, 1, 0, 0, 30, INK)
    if icons.cached() != most || icons.cachedBytes() != full { return 65 }
    // The first is still kept: drawing it makes nothing.
    icons.draw(&one, 0, 0, 0, 20, INK)
    if icons.cached() != most || icons.cachedBytes() != full { return 65 }
    icons.release()
    return 0
}

// What the icons take from the heap they give back: drawing kept
// pictures takes nothing, no kept picture is a block of its own (brixOS
// makes each block above 32 KiB one of a process's 256 memory regions),
// and release() leaves the heap as it found it.
fn checkHeap(s: *State) -> u8 {
    var one = canvasOn(s.*.first, PROBE, PROBE)
    var big = canvasOn(s.*.large, LARGE, LARGE)
    icons.release()
    const live = std.heap.liveBytes()
    const regions = std.heap.largeCount()
    icons.draw(&one, icons.TOOL_BRUSH, MARGIN, MARGIN, 24, INK)
    const holding = std.heap.liveBytes()
    var round: usize = 0
    while round < 1000 {
        icons.draw(&one, icons.TOOL_BRUSH, MARGIN + @intCast(i32, round % 9) - 4, MARGIN, 24, INK)
        icons.drawFor(@intCast(usize, icons.TOOL_BRUSH), &one, MARGIN, MARGIN - @intCast(i32, round % 5), 24, INK)
        round += 1
    }
    if std.heap.liveBytes() != holding { return 66 }
    var index: usize = 0
    while index < 64 {
        icons.draw(&big, @intCast(u16, index), 0, 0, 200, INK)
        index += 1
    }
    const largest = @intCast(usize, icons.LARGEST)
    if icons.cached() != 65 || icons.cachedBytes() != 64 * largest * largest * 4 + 2304 { return 67 }
    if std.heap.largeCount() != regions { return 67 }
    icons.release()
    if std.heap.liveBytes() != live || std.heap.largeCount() != regions { return 68 }
    return 0
}

// What an icon drawn `size` pixels large (more than LARGEST) must show at
// (`column`, `row`) of its box, worked out the plain way: its picture of
// LARGEST pixels (`picture`, rows LARGE apart) sampled where the middle
// of that pixel falls on it, between its four nearest pixels by how near
// each is (in 256ths), each channel rounded.
fn sampled(picture: [*]const u32, column: i64, row: i64, size: i64) -> u32 {
    const side = @intCast(i64, icons.LARGEST)
    var sx = (2 * column + 1) * side * 128 / size - 128
    var sy = (2 * row + 1) * side * 128 / size - 128
    if sx < 0 { sx = 0 }
    if sy < 0 { sy = 0 }
    const x0 = sx / 256
    const y0 = sy / 256
    const x1 = if x0 + 1 < side { x0 + 1 } else { x0 }
    const y1 = if y0 + 1 < side { y0 + 1 } else { y0 }
    const fx = sx % 256
    const fy = sy % 256
    const a = picture[@intCast(usize, y0) * LARGE + @intCast(usize, x0)]
    const b = picture[@intCast(usize, y0) * LARGE + @intCast(usize, x1)]
    const c = picture[@intCast(usize, y1) * LARGE + @intCast(usize, x0)]
    const d = picture[@intCast(usize, y1) * LARGE + @intCast(usize, x1)]
    var result: u32 = 0
    var shift: u32 = 0
    while shift < 32 {
        const mixed = @intCast(i64, (a >> shift) & 255) * (256 - fx) * (256 - fy) + @intCast(i64, (b >> shift) & 255) * fx * (256 - fy) + @intCast(i64, (c >> shift) & 255) * (256 - fx) * fy + @intCast(i64, (d >> shift) & 255) * fx * fy
        result = result | (@intCast(u32, (mixed + 32768) / 65536) << shift)
        shift += 8
    }
    return result
}

// Every icon drawn larger than any kept picture is, to the pixel, what
// sampled() says: on the large canvas, partly off the probe on each side,
// faded by the canvas, and over an opaque ground.
fn checkStretched(s: *State) -> u8 {
    var big = canvasOn(s.*.large, LARGE, LARGE)
    var probe = canvasOn(s.*.first, PROBE, PROBE)
    var plain = canvasOn(s.*.spare, LARGE, LARGE)
    const total = icons.count()
    const ground: u32 = 0xFF1E2028
    var index: usize = 0
    while index < total {
        const icon = @intCast(u16, index)
        fillWords(s.*.spare, LARGE * LARGE, 0)
        icons.draw(&plain, icon, 0, 0, icons.LARGEST, INK)
        const kind = index % 3
        var size: i64 = 256
        if kind == 0 { size = 91 }
        if kind == 1 { size = 137 }
        const wide = @intCast(i32, size)
        fillWords(s.*.large, LARGE * LARGE, 0)
        icons.draw(&big, icon, 3, 5, wide, INK)
        var row: i64 = 0
        while row < @intCast(i64, LARGE) {
            var column: i64 = 0
            while column < @intCast(i64, LARGE) {
                var wanted: u32 = 0
                if row >= 5 && row < 5 + size && column >= 3 && column < 3 + size { wanted = sampled(s.*.spare, column - 3, row - 5, size) }
                if s.*.large[@intCast(usize, row) * LARGE + @intCast(usize, column)] != wanted {
                    say(icon, "is not its picture sampled bilinearly when stretched")
                    return 60
                }
                column += 1
            }
            row += 1
        }
        fillWords(s.*.first, PROBE * PROBE, 0)
        icons.draw(&probe, icon, -37, -51, wide, INK)
        fillWords(s.*.second, PROBE * PROBE, 0)
        var right = canvasOn(s.*.second, PROBE, PROBE)
        icons.draw(&right, icon, 20, 30, wide, INK)
        row = 0
        while row < @intCast(i64, PROBE) {
            var column: i64 = 0
            while column < @intCast(i64, PROBE) {
                var wanted: u32 = 0
                if row + 51 < size && column + 37 < size { wanted = sampled(s.*.spare, column + 37, row + 51, size) }
                if s.*.first[@intCast(usize, row) * PROBE + @intCast(usize, column)] != wanted { return 61 }
                wanted = 0
                if row >= 30 && column >= 20 { wanted = sampled(s.*.spare, column - 20, row - 30, size) }
                if s.*.second[@intCast(usize, row) * PROBE + @intCast(usize, column)] != wanted { return 62 }
                column += 1
            }
            row += 1
        }
        if index % 11 == 0 {
            // The picture in the translucent colour, to sample for the
            // icon drawn in it.
            fillWords(s.*.large, LARGE * LARGE, 0)
            icons.draw(&big, icon, 0, 0, icons.LARGEST, HALF_INK)
            fillWords(s.*.first, PROBE * PROBE, 0)
            probe.opacity = 128
            icons.draw(&probe, icon, -20, -9, 100, INK)
            probe.opacity = 255
            fillWords(s.*.second, PROBE * PROBE, ground)
            icons.draw(&right, icon, -20, -9, 100, HALF_INK)
            row = 0
            while row < @intCast(i64, PROBE) {
                var column: i64 = 0
                while column < @intCast(i64, PROBE) {
                    const at = @intCast(usize, row) * PROBE + @intCast(usize, column)
                    if s.*.first[at] != canvas_module.over(0, sampled(s.*.spare, column + 20, row + 9, 100), 128) { return 83 }
                    if s.*.second[at] != canvas_module.over(ground, sampled(s.*.large, column + 20, row + 9, 100), 255) { return 84 }
                    column += 1
                }
                row += 1
            }
        }
        index += 1
    }
    return 0
}

// An icon's weight (the alpha of its box summed) and its middle (where
// that weight balances, in pixels from the box's corner), in the box
// `size` pixels square at the top left of the large canvas.
const Balance = struct {
    weight: f64
    x: f64
    y: f64
}

fn balanceOf(pixels: [*]const u32, size: usize) -> Balance {
    var weight: u64 = 0
    var across: u64 = 0
    var down: u64 = 0
    var row: usize = 0
    while row < size {
        var column: usize = 0
        while column < size {
            const alpha = @intCast(u64, pixels[row * LARGE + column] >> 24)
            weight += alpha
            across += alpha * @intCast(u64, 2 * column + 1)
            down += alpha * @intCast(u64, 2 * row + 1)
            column += 1
        }
        row += 1
    }
    const total = @floatFromInt(f64, weight)
    return Balance.{ .weight = total, .x = @floatFromInt(f64, across) / (2.0 * total), .y = @floatFromInt(f64, down) / (2.0 * total) }
}

// Scaled up by a factor f, an icon weighs f * f times its picture and
// balances at f times its picture's middle: bilinear sampling neither
// shifts nor squeezes it. Exactly so at f = 2 (each pixel of the picture
// spreads over the rows and columns around it with weights 3/4, 3/4,
// 1/4, 1/4 each way: 2 in all); at 5/3 the sum of the samples is the
// interpolated picture's integral to well within 1 in 100.
fn checkStretchShape(s: *State) -> u8 {
    var big = canvasOn(s.*.large, LARGE, LARGE)
    const total = icons.count()
    const largest = @intCast(usize, icons.LARGEST)
    var index: usize = 0
    while index < total {
        const icon = @intCast(u16, index)
        fillWords(s.*.large, LARGE * LARGE, 0)
        icons.draw(&big, icon, 0, 0, icons.LARGEST, INK)
        const kept = balanceOf(s.*.large, largest)
        var pass: usize = 0
        while pass < 2 {
            const size: usize = if pass == 0 { 180 } else { 150 }
            fillWords(s.*.large, LARGE * LARGE, 0)
            icons.draw(&big, icon, 0, 0, @intCast(i32, size), INK)
            const grown = balanceOf(s.*.large, size)
            const factor = @floatFromInt(f64, size) / @floatFromInt(f64, largest)
            const weight = kept.weight * factor * factor
            if math.absolute(grown.weight - weight) > weight * 0.01 {
                say(icon, "changes its weight when stretched")
                return 80
            }
            if math.absolute(grown.x - kept.x * factor) > 0.25 || math.absolute(grown.y - kept.y * factor) > 0.25 {
                say(icon, "moves when stretched")
                return 81
            }
            pass += 1
        }
        index += 1
    }
    return 0
}
