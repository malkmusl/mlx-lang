// nebula's icons (ui/icons.mlx): every icon has its number and a key of
// its own; each draws a picture that is not blank and not a blot (3 to 85
// in a hundred of its box at 24 pixels), stays in its box, has only the
// colour asked (at the share of each pixel it covers), is the same when
// drawn again from the kept pictures and after release(), at 16, 20, 24,
// 32 and 48 pixels; a translucent colour, a faded canvas, an opaque
// ground under it (which stays opaque), a canvas it only partly lies on,
// a canvas of no pixels (a layout pass: nothing drawn, nothing kept),
// what is no icon, no size, no colour; the kept pictures stay bounded in
// number and in bytes, and the one drawn longest ago is the one that
// goes; 5000 draws of kept pictures take nothing of the value arena, and
// release() gives the heap back all it took. An icon larger than any kept
// picture is, to the pixel, that picture sampled bilinearly (a second,
// plain implementation here says what each pixel must be), wherever it
// lies, and keeps the picture's weight and middle. Canvases that keep red
// and blue the other way round, whose rows are longer than they are wide,
// of one pixel, at opacities past 255 and 0, and the faintest colour get
// what they must. It writes two contact sheets of all icons at 24 and 16
// pixels with their keys, icons-dark.png and icons-light.png, into the
// current directory and, when NEBULA_SHOTS names a directory, into that.
// Exits 13.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")
const png = @import("std.png")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const view = @import("std.ui.view")
const pixel = @import("../core/pixel.mlx")
const table = @import("../core/table.mlx")
const icons = @import("../ui/icons.mlx")

const Canvas = canvas_module.Canvas
const Text = text_module.Text
const Theme = theme_module.Theme

