// nebula's transform (core/transform.mlx): the matrix (the inverse within
// 1e-12, a rectangle onto four corners and back, the parts of an affine
// matrix making it again, the pixels around a rectangle's picture, also
// under a perspective whose vanishing line crosses it); the exact moves
// (flips, quarter and half turns, four of them nothing, offset around the
// edges) for a layer and for a mask that sits elsewhere, across tile
// borders and at negative places, undone as one change; resample(): the
// identity and a move by whole pixels to the bit with every filter, a
// mirror and a quarter turn given as matrices like the exact ones, a
// checker twice as large with NEAREST, a fine checkerboard shrunk to its
// mean grey, a ramp that stays a ramp when enlarged, a red square on
// nothing that stays pure red at its soft edges (enlarged, turned,
// shrunk), red between transparent green staying red, 4096 pixels
// becoming 16 with the mean colour, eight eighths of a turn back at the
// start, a square onto four corners, a vanishing line through the area,
// masks staying opaque greys with their default, a device transformed in
// place and undone, plain buffers against the devices' numbers, one
// pixel, far and absurd places. A megapixel turned and scaled takes no
// memory of the value arena; how fast it went is printed. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const math = @import("std.math")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const pixel = @import("../core/pixel.mlx")
const transform = @import("../core/transform.mlx")

const Matrix = transform.Matrix

fn near(a: f64, b: f64, by: f64) -> bool {
    const difference = if a > b { a - b } else { b - a }
    return difference <= by
}

fn sameMatrix(a: *const Matrix, b: *const Matrix, by: f64) -> bool {
    return near(a.*.a, b.*.a, by) && near(a.*.b, b.*.b, by) && near(a.*.c, b.*.c, by) && near(a.*.d, b.*.d, by) && near(a.*.e, b.*.e, by) && near(a.*.f, b.*.f, by) && near(a.*.g, b.*.g, by) && near(a.*.h, b.*.h, by) && near(a.*.i, b.*.i, by)
}

// A pixel that says where it was put: every place another colour.
fn marked(x: i32, y: i32) -> u32 {
    return 0xFF000000 | (@intCast(u32, x & 255) << 16) | (@intCast(u32, y & 255) << 8) | @intCast(u32, (x * 7 + y * 13) & 255)
}

fn matrixChecks() -> u8 {
    // The inverse undoes: affine and perspective.
    const turn = transform.rotation(0.7, 40.0, -25.0)
    const zoom = transform.scaling(1.75, 0.4, 3.0, 9.0)
    const lean = transform.shearing(0.3, -0.2, 1.0, 2.0)
    const first = transform.multiply(&zoom, &turn)
    var m = transform.multiply(&lean, &first)
    var back: Matrix = undefined
    if !transform.invert(&m, &back) { return 1 }
    const one = transform.identity()
    const product = transform.multiply(&back, &m)
    if !sameMatrix(&product, &one, 0.000000000001) { return 2 }
    if back.g != 0.0 || back.h != 0.0 || back.i != 1.0 || !transform.isAffine(&back) { return 3 }
    m.g = 0.001
    m.h = -0.002
    if transform.isAffine(&m) || !transform.invert(&m, &back) { return 4 }
    const other = transform.multiply(&m, &back)
    if !sameMatrix(&other, &one, 0.000000000001) { return 5 }
    const flat = Matrix.{ .a = 1.0, .b = 2.0, .c = 0.0, .d = 2.0, .e = 4.0, .f = 0.0, .g = 0.0, .h = 0.0, .i = 1.0 }
    if transform.invert(&flat, &back) { return 6 }

    // multiply(l, r) does r first; a point goes where the parts say.
    const moved = transform.translation(10.0, -4.0)
    const both = transform.multiply(&zoom, &moved)
    const p = transform.apply(&both, 1.0, 2.0)
    if !near(p.x, 3.0 + 1.75 * 8.0, 0.000000000001) || !near(p.y, 9.0 + 0.4 * -11.0, 0.000000000001) { return 7 }
    const quarter = transform.rotation(1.5707963267948966, 0.0, 0.0)
    if quarter.a != 0.0 || quarter.b != -1.0 || quarter.d != 1.0 || quarter.e != 0.0 { return 8 }
    const q = transform.apply(&quarter, 1.0, 0.0)
    if q.x != 0.0 || q.y != 1.0 { return 9 }

    // Whole moves are told from the rest.
    if !transform.isTranslation(&one) || !transform.isTranslation(&moved) || transform.isTranslation(&zoom) { return 10 }
    const half = transform.translation(0.5, 0.0)
    if transform.isTranslation(&half) || transform.isTranslation(&m) { return 11 }

    // A rectangle onto four corners, and back.
    const quad = transform.Quad.{ .x0 = 12.0, .y0 = 7.0, .x1 = 150.0, .y1 = 30.0, .x2 = 170.0, .y2 = 140.0, .x3 = -5.0, .y3 = 99.0 }
    const area = geom.rect(-20, 10, 80, 60)
    var onto: Matrix = undefined
    if !transform.toQuad(area, &quad, &onto) { return 12 }
    const corners = transform.quadOf(area)
    const landed = transform.mapQuad(&onto, &corners)
    if !near(landed.x0, quad.x0, 0.000000001) || !near(landed.y0, quad.y0, 0.000000001) || !near(landed.x1, quad.x1, 0.000000001) || !near(landed.y1, quad.y1, 0.000000001) { return 14 }
    if !near(landed.x2, quad.x2, 0.000000001) || !near(landed.y2, quad.y2, 0.000000001) || !near(landed.x3, quad.x3, 0.000000001) || !near(landed.y3, quad.y3, 0.000000001) { return 15 }
    if transform.isAffine(&onto) { return 16 }
    var straight: Matrix = undefined
    if !transform.fromQuad(&quad, area, &straight) { return 17 }
    const home = transform.apply(&straight, quad.x2, quad.y2)
    if !near(home.x, 60.0, 0.000000001) || !near(home.y, 70.0, 0.000000001) { return 18 }
    var unit: Matrix = undefined
    if !transform.unitToQuad(&quad, &unit) { return 19 }
    const middle = transform.apply(&unit, 1.0, 1.0)
    if !near(middle.x, 170.0, 0.000000001) || !near(middle.y, 140.0, 0.000000001) { return 20 }
    // A parallelogram needs no perspective; a quad folded over has none.
    const slanted = transform.Quad.{ .x0 = 0.0, .y0 = 0.0, .x1 = 10.0, .y1 = 2.0, .x2 = 13.0, .y2 = 9.0, .x3 = 3.0, .y3 = 7.0 }
    if !transform.unitToQuad(&slanted, &unit) || !transform.isAffine(&unit) { return 21 }
    const folded = transform.Quad.{ .x0 = 0.0, .y0 = 0.0, .x1 = 10.0, .y1 = 0.0, .x2 = 2.0, .y2 = 1.0, .x3 = 0.0, .y3 = 10.0 }
    if transform.unitToQuad(&folded, &unit) { return 22 }
    const line = transform.Quad.{ .x0 = 0.0, .y0 = 0.0, .x1 = 1.0, .y1 = 1.0, .x2 = 2.0, .y2 = 2.0, .x3 = 3.0, .y3 = 3.0 }
    if transform.unitToQuad(&line, &unit) || transform.toQuad(geom.empty(), &quad, &unit) { return 23 }

    // The parts of an affine matrix make it again.
    var affine = transform.multiply(&lean, &first)
    affine.c = 31.5
    affine.f = -8.25
    const parts = transform.decompose(&affine)
    const again = transform.compose(&parts)
    if !sameMatrix(&again, &affine, 0.000000000001) { return 24 }
    if parts.x != 31.5 || parts.y != -8.25 { return 25 }
    const plain = transform.Parts.{ .x = 5.0, .y = 6.0, .rotation = -2.5, .scaleX = 3.0, .scaleY = 0.5, .shear = 0.25 }
    const built = transform.compose(&plain)
    const found = transform.decompose(&built)
    if !near(found.rotation, -2.5, 0.000000000001) || !near(found.scaleX, 3.0, 0.000000000001) || !near(found.scaleY, 0.5, 0.000000000001) || !near(found.shear, 0.25, 0.000000000001) { return 26 }
    const mirror = transform.scaling(-1.0, 1.0, 0.0, 0.0)
    const mirrored = transform.decompose(&mirror)
    const remade = transform.compose(&mirrored)
    if !sameMatrix(&remade, &mirror, 0.000000000001) || !(mirrored.scaleY < 0.0) { return 27 }
    const column = Matrix.{ .a = 0.0, .b = -2.0, .c = 1.0, .d = 0.0, .e = 0.0, .f = 2.0, .g = 0.0, .h = 0.0, .i = 1.0 }
    const squeezed = transform.decompose(&column)
    const unsqueezed = transform.compose(&squeezed)
    if !sameMatrix(&unsqueezed, &column, 0.000000000001) { return 28 }

    // The pixels around a rectangle's picture.
    const box = transform.mapRect(&quarter, geom.rect(0, 0, 100, 40))
    if box.x != -40 || box.y != 0 || box.width != 40 || box.height != 100 { return 29 }
    const grown = transform.mapRect(&zoom, geom.rect(3, 9, 4, 10))
    if grown.x != 3 || grown.y != 9 || grown.width != 7 || grown.height != 4 { return 30 }
    const shifted = transform.mapRect(&half, geom.rect(0, 0, 2, 2))
    if shifted.x != 0 || shifted.width != 3 || shifted.height != 2 { return 31 }
    if !geom.isEmpty(transform.mapRect(&one, geom.empty())) { return 32 }
    const tilted = transform.mapRect(&onto, area)
    if tilted.x != -5 || tilted.y != 7 || tilted.width != 175 || tilted.height != 133 { return 33 }
    // A perspective whose vanishing line crosses the rectangle: only the
    // part in front of it counts, and that reaches as far as is looked.
    const horizon = Matrix.{ .a = 1.0, .b = 0.0, .c = 0.0, .d = 0.0, .e = 1.0, .f = 0.0, .g = -0.01, .h = 0.0, .i = 1.0 }
    const open = transform.mapRect(&horizon, geom.rect(0, 0, 200, 10))
    if open.x != 0 || open.width < 100000000 || open.y != 0 || open.height < 20000000 { return 34 }
    const behind = transform.mapRect(&horizon, geom.rect(150, 0, 50, 10))
    if !geom.isEmpty(behind) { return 35 }
    if !std.text.same(transform.filterTitle(transform.BICUBIC, false), "Bicubic") || !std.text.same(transform.filterTitle(transform.BICUBIC, true), "Bikubisch") { return 36 }
    return 0
}

// A device with marked pixels in `area`.
fn paintMarked(layer: *device.Device, area: geom.Rect) -> void {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            device.setPixel(layer, x, y, marked(x, y))
            x += 1
        }
        y += 1
    }
}

fn exactChecks(allocator: std.allocator.Allocator, blank: u32, origin_x: i32, origin_y: i32) -> u8 {
    const layer = device.create(allocator, blank).?
    device.moveTo(layer, origin_x, origin_y)
    // Content across tile borders, left of and above the origin, and a
    // lone pixel far outside the rectangle everything turns about.
    const content = geom.rect(-70, -33, 150, 101)
    const about = geom.rect(-70, -33, 150, 101)
    paintMarked(layer, content)
    device.setPixel(layer, 300, -200, 0xFF123456)
    const original = device.copy(layer).?

    // Mirrored: the first column is the last, a place outside mirrors
    // about the same line; twice is nothing.
    if !transform.flipHorizontal(layer, about) { return 40 }
    if device.pixel(layer, -70, -33) != marked(79, -33) || device.pixel(layer, 79, 67) != marked(-70, 67) || device.pixel(layer, 0, 0) != marked(9, 0) { return 41 }
    if device.pixel(layer, -291, -200) != 0xFF123456 || device.pixel(layer, 300, -200) != blank { return 42 }
    if device.pixel(layer, 80, 0) != blank || device.pixel(layer, -71, 0) != blank { return 43 }
    if !transform.flipHorizontal(layer, about) { return 44 }
    if !sameDevices(layer, original, geom.rect(-400, -300, 800, 500)) { return 45 }
    if !transform.flipVertical(layer, about) { return 46 }
    if device.pixel(layer, -70, -33) != marked(-70, 67) || device.pixel(layer, 5, 67) != marked(5, -33) || device.pixel(layer, 300, 234) != 0xFF123456 { return 47 }
    if !transform.flipVertical(layer, about) { return 48 }
    if !sameDevices(layer, original, geom.rect(-400, -300, 800, 500)) { return 49 }

    // A quarter turn clockwise: the top left corner's pixel is the top
    // right one of the turned rectangle at the same top left.
    if !transform.rotate90(layer, about) { return 50 }
    const turned = transform.rotatedRect(about)
    if turned.x != -70 || turned.y != -33 || turned.width != 101 || turned.height != 150 { return 51 }
    if device.pixel(layer, 30, -33) != marked(-70, -33) || device.pixel(layer, 30, 116) != marked(79, -33) || device.pixel(layer, -70, -33) != marked(-70, 67) || device.pixel(layer, -70, 116) != marked(79, 67) { return 52 }
    if device.pixel(layer, 31, 0) != blank || device.pixel(layer, 0, 117) != blank || device.pixel(layer, -71, 0) != blank { return 53 }
    const bounds = device.exactBounds(layer)
    if blank == 0 && (bounds.x != -70 || bounds.y != -33 || bounds.width != 268 || bounds.height != 371) { return 54 }
    // Three more (about the turned rectangle, then the first again) make
    // a whole turn; a half turn is two of them; back is the other way.
    if !transform.rotate90(layer, turned) { return 55 }
    const upside = device.copy(layer).?
    if device.pixel(layer, 79, 67) != marked(-70, -33) || device.pixel(layer, -70, -33) != marked(79, 67) { return 56 }
    if !transform.rotate90(layer, about) || !transform.rotate90(layer, turned) { return 57 }
    if !sameDevices(layer, original, geom.rect(-700, -700, 1400, 1400)) { return 58 }
    if !transform.rotate180(layer, about) { return 59 }
    if !sameDevices(layer, upside, geom.rect(-700, -700, 1400, 1400)) { return 60 }
    if !transform.rotate180(layer, about) || !sameDevices(layer, original, geom.rect(-700, -700, 1400, 1400)) { return 61 }
    if !transform.rotate270(layer, about) { return 62 }
    if device.pixel(layer, -70, 116) != marked(-70, -33) || device.pixel(layer, 30, -33) != marked(79, 67) { return 63 }
    if !transform.rotate90(layer, turned) || !sameDevices(layer, original, geom.rect(-700, -700, 1400, 1400)) { return 64 }
    // Four quarter turns about one rectangle are a whole turn too.
    if !transform.rotate90(layer, about) || !transform.rotate90(layer, about) || !transform.rotate90(layer, about) || !transform.rotate90(layer, about) { return 65 }
    if !sameDevices(layer, original, geom.rect(-700, -700, 1400, 1400)) { return 66 }

    // Undone as one change.
    device.begin(layer)
    if !transform.rotate90(layer, about) { return 67 }
    const change = device.commit(layer)
    if change == null { return 68 }
    _ = device.apply(layer, change.?, true)
    if !sameDevices(layer, original, geom.rect(-700, -700, 1400, 1400)) { return 69 }
    _ = device.apply(layer, change.?, false)
    if device.pixel(layer, 30, -33) != marked(-70, -33) { return 70 }
    _ = device.apply(layer, change.?, true)
    device.destroyChange(change.?)

    // Offset: pushed inside a rectangle, around its edges; outside it
    // nothing moves.
    const inside = geom.rect(-10, -20, 90, 70)
    if !transform.offset(layer, inside, 100, -5) { return 71 }
    var y: i32 = -40
    while y < 80 {
        var x: i32 = -40
        while x < 100 {
            var expected = device.pixel(original, x, y)
            if geom.contains(inside, x, y) {
                const from_x = inside.x + wrap(x - inside.x - 100, inside.width)
                const from_y = inside.y + wrap(y - inside.y + 5, inside.height)
                expected = device.pixel(original, from_x, from_y)
            }
            if device.pixel(layer, x, y) != expected { return 72 }
            x += 1
        }
        y += 1
    }
    if !transform.offset(layer, inside, -10, 5 + 70 * 3) { return 73 }
    if !sameDevices(layer, original, geom.rect(-400, -300, 800, 500)) { return 74 }
    if !transform.offset(layer, inside, 90, -140) || !sameDevices(layer, original, geom.rect(-400, -300, 800, 500)) { return 75 }
    if !transform.offset(layer, geom.empty(), 3, 3) { return 76 }

    // Nothing at all: nothing to do, no tile made.
    const none = device.create(allocator, blank).?
    if !transform.flipHorizontal(none, about) || !transform.rotate90(none, about) || !transform.offset(none, inside, 3, 3) || device.tileCount(none) != 0 { return 77 }
    device.destroy(none)
    device.destroy(upside)
    device.destroy(original)
    device.destroy(layer)
    return 0
}

fn wrap(value: i32, by: i32) -> i32 {
    return ((value % by) + by) % by
}

// Whether two devices show the same in `area`.
fn sameDevices(a: *device.Device, b: *device.Device, area: geom.Rect) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if device.pixel(a, x, y) != device.pixel(b, x, y) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// A layer's pixels: marked ones across tile borders and translucent ones
// (every alpha from 1 on) beside them.
fn paintMixed(layer: *device.Device) -> void {
    paintMarked(layer, geom.rect(-70, -33, 150, 101))
    var y: i32 = 100
    while y < 140 {
        var x: i32 = 100
        while x < 140 {
            device.setPixel(layer, x, y, (marked(x, y) & 0x00FFFFFF) | (@intCast(u32, 1 + (x * 5 + y * 3) & 127) << 24))
            x += 1
        }
        y += 1
    }
}

fn absDifference(a: u32, b: u32) -> u32 { return if a > b { a - b } else { b - a } }

// Whether two pixels are within `by` in every channel.
fn close(a: u32, b: u32, by: u32) -> bool {
    return absDifference(a >> 24, b >> 24) <= by && absDifference(pixel.red(a), pixel.red(b)) <= by && absDifference(pixel.green(a), pixel.green(b)) <= by && absDifference(pixel.blue(a), pixel.blue(b)) <= by
}

fn copyChecks(allocator: std.allocator.Allocator) -> u8 {
    const source = device.create(allocator, 0).?
    paintMixed(source)
    const around = geom.rect(-100, -60, 300, 250)
    const one = transform.identity()
    const moved = transform.translation(37.0, -70.0)
    var filter: u8 = 0
    while filter < 5 {
        // The identity changes nothing, whatever the filter.
        const same = device.create(allocator, 0).?
        if !transform.resample(source, same, &one, filter, around) { return 120 }
        if !sameDevices(source, same, geom.rect(-110, -70, 320, 270)) { return 121 }
        if device.tileCount(same) != device.tileCount(source) { return 122 }
        device.destroy(same)
        // A move by whole pixels moves them as they are, also into a
        // device that sits elsewhere.
        const shifted = device.create(allocator, 0).?
        device.moveTo(shifted, 5, -9)
        if !transform.resample(source, shifted, &moved, filter, geom.rect(-63, -130, 300, 250)) { return 123 }
        var y: i32 = -130
        while y < 120 {
            var x: i32 = -63
            while x < 237 {
                if device.pixel(shifted, x, y) != device.pixel(source, x - 37, y + 70) { return 124 }
                x += 1
            }
            y += 1
        }
        device.destroy(shifted)
        filter += 1
    }
    // Only the area is written.
    const part = device.create(allocator, 0).?
    _ = device.fill(part, geom.rect(-10, -10, 30, 30), 0xFF00FF00)
    if !transform.resample(source, part, &one, transform.BILINEAR, geom.rect(0, 0, 10, 10)) { return 125 }
    if device.pixel(part, 3, 3) != marked(3, 3) || device.pixel(part, -1, 3) != 0xFF00FF00 || device.pixel(part, 10, 9) != 0xFF00FF00 { return 126 }
    // What cannot be done says so: no inverse, the source as the target.
    const flat = transform.scaling(0.0, 1.0, 0.0, 0.0)
    if transform.resample(source, part, &flat, transform.BILINEAR, around) { return 127 }
    if transform.resample(source, source, &moved, transform.BILINEAR, around) { return 128 }
    if !transform.resample(source, part, &flat, transform.BILINEAR, geom.empty()) { return 129 }
    device.destroy(part)

    // A mirror and a quarter turn given as matrices land exactly where
    // the exact functions put the pixels.
    const about = geom.rect(-70, -33, 150, 101)
    const opaque = device.create(allocator, 0).?
    paintMarked(opaque, about)
    const mirrored = device.copy(opaque).?
    if !transform.flipHorizontal(mirrored, about) { return 130 }
    const turned = device.copy(opaque).?
    if !transform.rotate90(turned, about) { return 131 }
    const mirror = transform.scaling(-1.0, 1.0, 5.0, 0.0)
    const quarter = transform.rotation(1.5707963267948966, -70.0 + 50.5, -33.0 + 50.5)
    filter = 0
    while filter < 5 {
        const flipped = device.create(allocator, 0).?
        if !transform.resample(opaque, flipped, &mirror, filter, geom.rect(-80, -40, 170, 120)) { return 132 }
        if !sameDevices(flipped, mirrored, geom.rect(-80, -40, 170, 120)) { return 133 }
        device.destroy(flipped)
        const spun = device.create(allocator, 0).?
        if !transform.resample(opaque, spun, &quarter, filter, geom.rect(-80, -40, 120, 170)) { return 134 }
        if !sameDevices(spun, turned, geom.rect(-80, -40, 120, 170)) { return 135 }
        device.destroy(spun)
        filter += 1
    }
    device.destroy(turned)
    device.destroy(mirrored)
    device.destroy(opaque)

    // An area done in one go and in four odd pieces is the same to the
    // bit: no seams where blocks or calls meet.
    const zoom = transform.scaling(1.7, 0.6, 3.0, -2.0)
    const spin = transform.rotation(0.4, 20.0, 10.0)
    const both = transform.multiply(&spin, &zoom)
    filter = 0
    while filter < 5 {
        var general: usize = 0
        while general < 2 {
            const m = if general == 0 { zoom } else { both }
            const once = device.create(allocator, 0).?
            const pieces = device.create(allocator, 0).?
            device.moveTo(pieces, -7, 19)
            if !transform.resample(source, once, &m, filter, geom.rect(-140, -90, 420, 300)) { return 136 }
            if !transform.resample(source, pieces, &m, filter, geom.rect(-140, -90, 131, 77)) || !transform.resample(source, pieces, &m, filter, geom.rect(-9, -90, 289, 77)) { return 137 }
            if !transform.resample(source, pieces, &m, filter, geom.rect(-140, -13, 203, 223)) || !transform.resample(source, pieces, &m, filter, geom.rect(63, -13, 217, 223)) { return 138 }
            if !sameDevices(once, pieces, geom.rect(-150, -100, 440, 320)) || device.isBlank(once) { return 139 }
            device.destroy(pieces)
            device.destroy(once)
            general += 1
        }
        filter += 1
    }
    device.destroy(source)
    return 0
}

// An opaque checkerboard of single pixels in two colours.
fn paintChecker(layer: *device.Device, area: geom.Rect, even: u32, odd: u32) -> void {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            device.setPixel(layer, x, y, if (x + y) & 1 == 0 { even } else { odd })
            x += 1
        }
        y += 1
    }
}

fn scaleChecks(allocator: std.allocator.Allocator) -> u8 {
    // Twice as large with NEAREST: every pixel four times, nothing new.
    const checker = device.create(allocator, 0).?
    const board = geom.rect(-10, -6, 80, 76)
    paintChecker(checker, board, 0xFF102030, 0xC0F0E0D0)
    const twice = transform.scaling(2.0, 2.0, 0.0, 0.0)
    const doubled = device.create(allocator, 0).?
    if !transform.resample(checker, doubled, &twice, transform.NEAREST, geom.rect(-30, -20, 180, 170)) { return 140 }
    var y: i32 = -30
    while y < 160 {
        var x: i32 = -40
        while x < 160 {
            const expected = if x >= -30 && y >= -20 && y < 150 && x < 150 { device.pixel(checker, x >> 1, y >> 1) } else { 0 }
            if device.pixel(doubled, x, y) != expected { return 141 }
            x += 1
        }
        y += 1
    }
    device.destroy(doubled)
    device.destroy(checker)

    // Half the size of a black and white checkerboard: the mean grey,
    // with the box and with the filters that widen (2x) or hand over to
    // it (4x, 8x).
    const fine = device.create(allocator, 0).?
    paintChecker(fine, geom.rect(-64, -64, 256, 256), 0xFF000000, 0xFFFFFFFF)
    var filter: u8 = 1
    while filter < 5 {
        var shrink: i32 = 2
        while shrink <= 8 {
            const smaller = transform.scaling(1.0 / @floatFromInt(f64, shrink), 1.0 / @floatFromInt(f64, shrink), 0.0, 0.0)
            const grey = device.create(allocator, 0).?
            // Well inside: at the border the filters reach into nothing.
            const inner = geom.rect(-64 / shrink + 4, -64 / shrink + 4, 256 / shrink - 8, 256 / shrink - 8)
            if !transform.resample(fine, grey, &smaller, filter, inner) { return 142 }
            y = inner.y
            while y < inner.y + inner.height {
                var x = inner.x
                while x < inner.x + inner.width {
                    const p = device.pixel(grey, x, y)
                    if p >> 24 != 255 || pixel.red(p) < 127 || pixel.red(p) > 128 || pixel.green(p) != pixel.red(p) || pixel.blue(p) != pixel.red(p) { return 143 }
                    x += 1
                }
                y += 1
            }
            device.destroy(grey)
            shrink *= 2
        }
        filter += 1
    }
    device.destroy(fine)

    // A ramp made 2.5 times as wide with the bicubic filter stays a ramp:
    // never down by more than 1, and where the straight line is.
    const ramp = device.create(allocator, 0).?
    y = 0
    while y < 20 {
        var x: i32 = 0
        while x < 80 {
            device.setPixel(ramp, x, y, pixel.rgb(@intCast(u32, x * 3), 255 - @intCast(u32, x * 3), 7))
            x += 1
        }
        y += 1
    }
    const wider = transform.scaling(2.5, 2.5, 0.0, 0.0)
    filter = transform.BILINEAR
    while filter <= transform.LANCZOS3 {
        const stretched = device.create(allocator, 0).?
        if !transform.scaleDevice(ramp, stretched, 2.5, 2.5, filter, 0.0, 0.0) { return 144 }
        var x: i32 = 10
        while x < 189 {
            const here = device.pixel(stretched, x, 25)
            const after = device.pixel(stretched, x + 1, 25)
            if pixel.red(after) + 1 < pixel.red(here) || pixel.green(after) > pixel.green(here) + 1 || here >> 24 != 255 || pixel.blue(here) != 7 { return 145 }
            // The place in the source: (x + 0.5) / 2.5, a pixel's value
            // being that of its middle.
            const line = 3.0 * ((@floatFromInt(f64, x) + 0.5) / 2.5 - 0.5)
            if !near(@floatFromInt(f64, pixel.red(here)), line, 1.01) { return 146 }
            x += 1
        }
        // It ends where it should: two and a half times 80 by 20, and
        // nothing beyond.
        const reach = device.exactBounds(stretched)
        if reach.x > 0 || reach.x < -8 || reach.x + reach.width < 200 || reach.x + reach.width > 208 || reach.y > 0 || reach.y + reach.height < 50 { return 147 }
        device.destroy(stretched)
        filter += 1
    }
    _ = wider
    device.destroy(ramp)

    // A red square on nothing, one and a half times as large and turned:
    // wherever anything shows it is pure red, also at the soft edges.
    const square = device.create(allocator, 0).?
    _ = device.fill(square, geom.rect(-5, 58, 30, 20), 0xFFFF0000)
    filter = transform.BILINEAR
    while filter <= transform.BOX {
        var turned: usize = 0
        while turned < 3 {
            const grow = transform.scaling(1.5, 1.5, 0.0, 0.0)
            const spin = transform.rotation(0.3 * @floatFromInt(f64, turned), 10.0, 68.0)
            // Straight, turned, and turned at a third of the size (many
            // samples a pixel).
            const small = transform.scaling(0.3, 0.3, 10.0, 68.0)
            var m = transform.multiply(&spin, &grow)
            if turned == 2 { m = transform.multiply(&spin, &small) }
            const shown = device.create(allocator, 0).?
            const area = transform.coverage(geom.rect(-5, 58, 30, 20), &m, filter)
            if !transform.resample(square, shown, &m, filter, area) { return 148 }
            var soft: usize = 0
            var solid: usize = 0
            y = area.y
            while y < area.y + area.height {
                var x = area.x
                while x < area.x + area.width {
                    const p = device.pixel(shown, x, y)
                    if p >> 24 == 0 {
                        if p != 0 { return 149 }
                    } else {
                        if pixel.red(p) < 254 || pixel.green(p) > 1 || pixel.blue(p) > 1 { return 150 }
                        // (Lanczos ripples a little inside an edge.)
                        if p >> 24 >= 240 { solid += 1 } else { soft += 1 }
                    }
                    x += 1
                }
                y += 1
            }
            // About 30 x 20 times 1.5 squared (0.3 squared) pixels of it.
            if turned < 2 && (solid < 1150 || solid > 1350) { return 151 }
            // Soft edges, but for the box where it only picks pixels.
            if soft == 0 && (filter != transform.BOX || turned == 0) { return 158 }
            if turned == 2 && (solid + soft < 40 || solid + soft > 110) { return 152 }
            // The border of the area it was given is empty: nothing of
            // the result was cut off.
            var x = area.x
            while x < area.x + area.width {
                if device.pixel(shown, x, area.y) != 0 || device.pixel(shown, x, area.y + area.height - 1) != 0 { return 153 }
                x += 1
            }
            device.destroy(shown)
            turned += 1
        }
        filter += 1
    }
    device.destroy(square)

    // Red columns between transparent ones whose colour is green: half
    // the size is half as dense and as red as before.
    const stripes = device.create(allocator, 0).?
    y = -8
    while y < 72 {
        var x: i32 = -8
        while x < 72 {
            device.setPixel(stripes, x, y, if x & 1 == 0 { 0xFFFF0000 } else { 0x0000FF00 })
            x += 1
        }
        y += 1
    }
    filter = transform.BILINEAR
    while filter <= transform.BOX {
        const half = transform.scaling(0.5, 0.5, 0.0, 0.0)
        const thin = device.create(allocator, 0).?
        if !transform.resample(stripes, thin, &half, filter, geom.rect(0, 0, 30, 30)) { return 154 }
        // The same shrunk to a quarter and turned a little: pixel by
        // pixel, many samples each.
        const quarter = transform.scaling(0.25, 0.25, 0.0, 0.0)
        const spin = transform.rotation(0.2, 8.0, 8.0)
        const both = transform.multiply(&spin, &quarter)
        const turned = device.create(allocator, 0).?
        if !transform.resample(stripes, turned, &both, filter, geom.rect(6, 4, 6, 6)) { return 155 }
        y = 0
        while y < 30 {
            var x: i32 = 0
            while x < 30 {
                const p = device.pixel(thin, x, y)
                if p & 0x00FFFFFF != 0x00FF0000 || p >> 24 < 126 || p >> 24 > 129 { return 156 }
                if x >= 6 && x < 12 && y >= 4 && y < 10 {
                    const q = device.pixel(turned, x, y)
                    if q & 0x00FFFFFF != 0x00FF0000 || q >> 24 < 110 || q >> 24 > 146 { return 157 }
                }
                x += 1
            }
            y += 1
        }
        device.destroy(turned)
        device.destroy(thin)
        filter += 1
    }
    device.destroy(stripes)
    return 0
}

// 4096 pixels become 16: each is the mean of the 256 x 256 under it.
fn hugeChecks(allocator: std.allocator.Allocator) -> u8 {
    const wide = device.create(allocator, 0).?
    device.moveTo(wide, 13, -5)
    const row = allocator.alloc(4096 * 4, 16)
    if row == null { return 160 }
    const words: [*]u32 = unsafe { @ptrCast([*]u32, row.?) }
    var sums: [32]u64 = undefined
    var index: usize = 0
    while index < 32 {
        sums[index] = 0
        index += 1
    }
    var y: i32 = 0
    while y < 512 {
        var x: i32 = 0
        while x < 4096 {
            // Not the same in any two blocks, and nothing a few samples
            // would guess.
            const value = @intCast(u32, ((x * 37 + y * 11) ^ (x >> 5)) & 255) * @intCast(u32, (x >> 8) + 1) / 16
            words[@intCast(usize, x)] = pixel.rgb(value, 255 - value, 60)
            sums[@intCast(usize, (y >> 8) * 16 + (x >> 8))] += @intCast(u64, value)
            x += 1
        }
        if !device.writeRect(wide, geom.rect(-2048, y - 256, 4096, 1), words, 4096) { return 161 }
        y += 1
    }
    allocator.free(row.?, 4096 * 4, 16)
    const tiny = transform.scaling(1.0 / 256.0, 1.0 / 256.0, 0.0, 0.0)
    var filter: u8 = transform.BILINEAR
    while filter <= transform.BOX {
        const small = device.create(allocator, 0).?
        if !transform.resample(wide, small, &tiny, filter, geom.rect(-10, -3, 20, 6)) { return 162 }
        y = -3
        while y < 3 {
            var x: i32 = -10
            while x < 10 {
                const p = device.pixel(small, x, y)
                if x < -8 || x >= 8 || y < -1 || y >= 1 {
                    if p != 0 { return 163 }
                } else {
                    const mean = @intCast(u32, (sums[@intCast(usize, (y + 1) * 16 + x + 8)] + 32768) / 65536)
                    if p >> 24 != 255 || absDifference(pixel.red(p), mean) > 1 || absDifference(pixel.green(p), 255 - mean) > 1 || pixel.blue(p) != 60 { return 164 }
                }
                x += 1
            }
            y += 1
        }
        device.destroy(small)
        filter += 1
    }
    // The same pixel by pixel (turned by nothing to speak of): the mean
    // of 32 x 32 samples, near the true one.
    const spin = transform.rotation(0.000001, 0.0, 0.0)
    const both = transform.multiply(&spin, &tiny)
    const sampled = device.create(allocator, 0).?
    if !transform.resample(wide, sampled, &both, transform.BILINEAR, geom.rect(-8, -1, 16, 2)) { return 165 }
    y = -1
    while y < 1 {
        var x: i32 = -7
        while x < 7 {
            const p = device.pixel(sampled, x, y)
            const mean = @intCast(u32, (sums[@intCast(usize, (y + 1) * 16 + x + 8)] + 32768) / 65536)
            if p >> 24 != 255 || absDifference(pixel.red(p), mean) > 6 || pixel.blue(p) != 60 { return 166 }
            x += 1
        }
        y += 1
    }
    device.destroy(sampled)
    device.destroy(wide)
    return 0
}

// A picture without hard edges.
fn smooth(x: i32, y: i32) -> u32 {
    const fx = @floatFromInt(f64, x)
    const fy = @floatFromInt(f64, y)
    const r = 128.0 + 100.0 * math.sin(fx * 0.35) * math.cos(fy * 0.3)
    const g = 128.0 + 90.0 * math.cos(fx * 0.25 + fy * 0.2)
    return pixel.rgb(@intFromFloat(u32, r), @intFromFloat(u32, g), 100)
}

fn turnChecks(allocator: std.allocator.Allocator) -> u8 {
    // Eight eighths of a turn bring a picture back to where it was: its
    // middle, which nothing from outside has reached, is nearly the same.
    var filter: u8 = transform.BILINEAR
    while filter <= transform.LANCZOS3 {
        var from = device.create(allocator, 0).?
        var onto = device.create(allocator, 0).?
        var y: i32 = -20
        while y < 108 {
            var x: i32 = -20
            while x < 108 {
                device.setPixel(from, x, y, smooth(x, y))
                x += 1
            }
            y += 1
        }
        var round: usize = 0
        while round < 8 {
            device.clear(onto)
            if !transform.rotateDevice(from, onto, 0.7853981633974483, 44.0, 44.0, filter) { return 170 }
            const swap = from
            from = onto
            onto = swap
            round += 1
        }
        var total: u64 = 0
        var worst: u32 = 0
        y = 24
        while y < 64 {
            var x: i32 = 24
            while x < 64 {
                const p = device.pixel(from, x, y)
                const q = smooth(x, y)
                if p >> 24 != 255 { return 171 }
                const dr = absDifference(pixel.red(p), pixel.red(q))
                const dg = absDifference(pixel.green(p), pixel.green(q))
                total += @intCast(u64, dr + dg + absDifference(pixel.blue(p), pixel.blue(q)))
                if dr > worst { worst = dr }
                if dg > worst { worst = dg }
                x += 1
            }
            y += 1
        }
        // The mean error of a channel in hundredths: the bilinear filter
        // blurs a little each time, the others hardly.
        // (Measured: 2.82 and 14, 0.04 and 2, 0.50 and 5. Lanczos is the
        // better of the two at fine detail, not at these gentle waves.)
        const mean = total * 100 / (40 * 40 * 3)
        if filter == transform.BILINEAR && (mean > 400 || worst > 24) { return 172 }
        if filter == transform.BICUBIC && (mean > 40 || worst > 4) { return 173 }
        if filter == transform.LANCZOS3 && (mean > 100 || worst > 10) { return 174 }
        device.destroy(from)
        device.destroy(onto)
        filter += 1
    }

    // A square of four colours onto four corners: each colour is at its
    // corner, nothing is outside them.
    const square = device.create(allocator, 0).?
    _ = device.fill(square, geom.rect(0, 0, 32, 32), 0xFFFF0000)
    _ = device.fill(square, geom.rect(32, 0, 32, 32), 0xFF00FF00)
    _ = device.fill(square, geom.rect(32, 32, 32, 32), 0xFF0000FF)
    _ = device.fill(square, geom.rect(0, 32, 32, 32), 0xFFFFFF00)
    const quad = transform.Quad.{ .x0 = 10.0, .y0 = 20.0, .x1 = 120.0, .y1 = 5.0, .x2 = 140.0, .y2 = 110.0, .x3 = -8.0, .y3 = 90.0 }
    var tilt: transform.Matrix = undefined
    if !transform.toQuad(geom.rect(0, 0, 64, 64), &quad, &tilt) { return 175 }
    filter = transform.NEAREST
    while filter <= transform.BOX {
        const tilted = device.create(allocator, 0).?
        if !transform.transformInto(square, tilted, &tilt, filter) { return 176 }
        var corner: usize = 0
        while corner < 4 {
            const cx = if corner == 0 { quad.x0 } else if corner == 1 { quad.x1 } else if corner == 2 { quad.x2 } else { quad.x3 }
            const cy = if corner == 0 { quad.y0 } else if corner == 1 { quad.y1 } else if corner == 2 { quad.y2 } else { quad.y3 }
            const colour: u32 = if corner == 0 { 0xFFFF0000 } else if corner == 1 { 0xFF00FF00 } else if corner == 2 { 0xFF0000FF } else { 0xFFFFFF00 }
            // Ten pixels towards the middle of the four, and six away.
            const dx = 65.5 - cx
            const dy = 56.25 - cy
            const length = math.sqrt(dx * dx + dy * dy)
            const inside = device.pixel(tilted, @intFromFloat(i32, math.floor(cx + dx * 10.0 / length)), @intFromFloat(i32, math.floor(cy + dy * 10.0 / length)))
            const outside = device.pixel(tilted, @intFromFloat(i32, math.floor(cx - dx * 6.0 / length)), @intFromFloat(i32, math.floor(cy - dy * 6.0 / length)))
            // (Bicubic and Lanczos ring faintly around an edge and, Lanczos,
            // ripple inside it.)
            const rings = filter == transform.BICUBIC || filter == transform.LANCZOS3
            if inside & 0x00FFFFFF != colour & 0x00FFFFFF || inside >> 24 < 240 || (!rings && inside != colour) { return 177 }
            if outside >> 24 > 8 || (!rings && outside != 0) { return 178 }
            corner += 1
        }
        // All of it is there, and no more than the filters' faint rings
        // around it (two or three source pixels, larger here).
        const bounds = device.exactBounds(tilted)
        if bounds.x < -17 || bounds.y < -4 || bounds.x + bounds.width > 149 || bounds.y + bounds.height > 119 || bounds.width < 147 || bounds.height < 104 { return 179 }
        device.destroy(tilted)
        filter += 1
    }

    // A perspective whose vanishing line (x = -100 in the result) runs
    // through the area: nothing behind it, nothing read without end next
    // to it (a tile a million pixels away lands there).
    _ = device.fill(square, geom.rect(-1000064, 0, 64, 64), 0xFF0000FF)
    const vanish = transform.Matrix.{ .a = 1.0, .b = 0.0, .c = 0.0, .d = 0.0, .e = 1.0, .f = 0.0, .g = -0.01, .h = 0.0, .i = 1.0 }
    filter = transform.NEAREST
    while filter <= transform.BOX {
        const far = device.create(allocator, 0).?
        if !transform.resample(square, far, &vanish, filter, geom.rect(-300, 0, 600, 8)) { return 180 }
        if device.pixel(far, -200, 3) != 0 || device.pixel(far, -101, 3) != 0 || device.pixel(far, -97, 3) != 0 { return 181 }
        if device.pixel(far, 10, 4) != 0xFFFF0000 || device.pixel(far, 120, 2) != 0xFF00FF00 || device.pixel(far, 200, 3) != 0 { return 182 }
        if device.pixel(far, -100, 0) >> 24 > 40 { return 183 }
        device.destroy(far)
        filter += 1
    }
    device.destroy(square)
    return 0
}

fn isGrey(p: u32) -> bool {
    return p >> 24 == 255 && pixel.red(p) == pixel.green(p) && pixel.green(p) == pixel.blue(p)
}

// Masks are opaque greys with a default that is not transparent: they
// stay so.
fn maskChecks(allocator: std.allocator.Allocator) -> u8 {
    const small = mask.create(allocator, false).?
    _ = device.fill(small, geom.rect(10, 10, 20, 20), mask.ALL)
    var filter: u8 = transform.NEAREST
    while filter <= transform.BOX {
        const large = mask.create(allocator, false).?
        if !transform.scaleDevice(small, large, 2.0, 2.0, filter, 0.0, 0.0) { return 190 }
        if mask.at(large, 40, 40) != 255 || mask.at(large, 25, 25) != 255 || mask.at(large, 54, 54) != 255 || mask.at(large, 10, 40) != 0 || mask.at(large, 70, 40) != 0 || mask.at(large, 500, 500) != 0 { return 191 }
        var y: i32 = 0
        while y < 80 {
            var x: i32 = 0
            while x < 80 {
                if !isGrey(device.pixel(large, x, y)) { return 192 }
                x += 1
            }
            y += 1
        }
        if device.tileCount(large) > 4 { return 193 }
        device.destroy(large)
        filter += 1
    }
    device.destroy(small)

    // Everything but a hole, turned in place: the hole turns, everything
    // stays everything.
    filter = transform.NEAREST
    while filter <= transform.BOX {
        const holed = mask.create(allocator, true).?
        _ = device.fill(holed, geom.rect(-20, -8, 80, 30), mask.NOTHING)
        const spin = transform.rotation(1.0, 20.0, 7.0)
        const changed = transform.transformDevice(holed, &spin, filter)
        if geom.isEmpty(changed) || !geom.contains(changed, -20, -8) || !geom.contains(changed, 30, 40) { return 194 }
        if mask.at(holed, 20, 7) != 0 || mask.at(holed, 26, 30) != 0 || mask.at(holed, 55, 7) != 255 || mask.at(holed, -15, 7) != 255 || mask.at(holed, 300, -300) != 255 { return 195 }
        var y: i32 = -60
        while y < 80 {
            var x: i32 = -40
            while x < 90 {
                if !isGrey(device.pixel(holed, x, y)) { return 196 }
                x += 1
            }
            y += 1
        }
        device.destroy(holed)
        filter += 1
    }

    // A fine checker of all and nothing at a quarter of the size is half
    // of everything, also where the source has no tile on one side.
    const fine = mask.create(allocator, true).?
    paintChecker(fine, geom.rect(0, 0, 128, 128), mask.ALL, mask.NOTHING)
    const quarter = transform.scaling(0.25, 0.25, 0.0, 0.0)
    const coarse = mask.create(allocator, true).?
    if !transform.resample(fine, coarse, &quarter, transform.BILINEAR, geom.rect(-8, -8, 48, 48)) { return 197 }
    if mask.at(coarse, 3, 3) < 127 || mask.at(coarse, 3, 3) > 128 || mask.at(coarse, 31, 31) < 127 || mask.at(coarse, 31, 31) > 128 { return 198 }
    if device.pixel(coarse, -3, 5) != mask.ALL || device.pixel(coarse, 35, 5) != mask.ALL || device.pixel(coarse, 5, -1) != mask.ALL { return 199 }
    device.destroy(coarse)
    device.destroy(fine)

    // Everything but a long thin hole, 4000 times narrower: two pixels
    // of nothing in each of its rows, everything around them (the tables
    // are made in strips for such a shrink, most rows are read nowhere).
    const long = mask.create(allocator, true).?
    _ = device.fill(long, geom.rect(0, 0, 8000, 4), mask.NOTHING)
    const narrow = transform.scaling(1.0 / 4000.0, 1.0, 0.0, 0.0)
    const short = mask.create(allocator, true).?
    if !transform.resample(long, short, &narrow, transform.BICUBIC, geom.rect(-300, -2, 600, 8)) { return 185 }
    var y: i32 = -2
    while y < 6 {
        var x: i32 = -300
        while x < 300 {
            const expected = if x >= 0 && x < 2 && y >= 0 && y < 4 { mask.NOTHING } else { mask.ALL }
            if device.pixel(short, x, y) != expected { return 186 }
            x += 1
        }
        y += 1
    }
    if device.tileCount(short) != 1 { return 187 }
    device.destroy(short)
    device.destroy(long)
    return 0
}

// A device's own pixels transformed, as one change that is undone.
fn inPlaceChecks(allocator: std.allocator.Allocator) -> u8 {
    const layer = device.create(allocator, 0).?
    const content = geom.rect(-70, -33, 150, 101)
    paintMarked(layer, content)
    const original = device.copy(layer).?
    device.begin(layer)
    const twice = transform.scaling(2.0, 2.0, 0.0, 0.0)
    const changed = transform.transformDevice(layer, &twice, transform.NEAREST)
    const change = device.commit(layer)
    if change == null { return 200 }
    if changed.x > -140 || changed.y > -66 || changed.x + changed.width < 160 || changed.y + changed.height < 136 { return 201 }
    var y: i32 = -80
    while y < 150 {
        var x: i32 = -150
        while x < 170 {
            if device.pixel(layer, x, y) != device.pixel(original, x >> 1, y >> 1) { return 202 }
            x += 1
        }
        y += 1
    }
    _ = device.apply(layer, change.?, true)
    if !sameDevices(layer, original, geom.rect(-200, -100, 400, 300)) { return 203 }
    device.destroyChange(change.?)

    // A move by whole pixels only moves the device.
    const tiles = device.tileCount(layer)
    const shift = transform.translation(5.0, -300.0)
    const moved = transform.transformDevice(layer, &shift, transform.BICUBIC)
    if moved.x != -70 || moved.y != -333 || moved.width != 155 || moved.height != 401 || device.tileCount(layer) != tiles { return 204 }
    if device.pixel(layer, -65, -333) != marked(-70, -33) || layer.*.x != 5 || layer.*.y != -300 { return 205 }
    device.moveTo(layer, 0, 0)

    // Nothing to do, and what cannot be done, change nothing.
    const one = transform.identity()
    const flat = transform.scaling(1.0, 0.0, 0.0, 0.0)
    if !geom.isEmpty(transform.transformDevice(layer, &one, transform.BILINEAR)) || !geom.isEmpty(transform.transformDevice(layer, &flat, transform.BILINEAR)) { return 206 }
    if !sameDevices(layer, original, geom.rect(-200, -100, 400, 300)) { return 207 }
    const none = device.create(allocator, 0).?
    if !geom.isEmpty(transform.transformDevice(none, &twice, transform.BILINEAR)) || device.tileCount(none) != 0 { return 208 }
    if !geom.isEmpty(transform.transformedBounds(none, &twice)) { return 209 }
    const where = transform.transformedBounds(layer, &twice)
    if where.x != -140 || where.y != -66 || where.width != 300 || where.height != 202 { return 210 }

    // In place is the same as into another device.
    const spin = transform.rotation(0.6, 3.0, 9.0)
    if !transform.rotateDevice(layer, none, 0.6, 3.0, 9.0, transform.BICUBIC) { return 211 }
    if geom.isEmpty(transform.transformDevice(layer, &spin, transform.BICUBIC)) { return 212 }
    if !sameDevices(layer, none, geom.rect(-200, -200, 400, 400)) || device.pixel(layer, 3, 9) >> 24 != 255 { return 214 }
    // The result of a perspective that reaches the vanishing line is
    // not made.
    const vanish = transform.Matrix.{ .a = 1.0, .b = 0.0, .c = 0.0, .d = 0.0, .e = 1.0, .f = 0.0, .g = -0.01, .h = 0.0, .i = 1.0 }
    paintMarked(none, geom.rect(0, 0, 200, 10))
    const tiles_before = device.tileCount(none)
    if !geom.isEmpty(transform.transformDevice(none, &vanish, transform.BILINEAR)) || device.tileCount(none) != tiles_before { return 215 }
    device.destroy(none)
    device.destroy(original)
    device.destroy(layer)
    return 0
}

// Plain buffers: the same numbers as a device's two passes.
fn bufferChecks(allocator: std.allocator.Allocator) -> u8 {
    const memory = allocator.alloc(100 * 64 * 4 + 90 * 60 * 4, 16)
    if memory == null { return 220 }
    const picture: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    const result = picture + 6400
    const layer = device.create(allocator, 0).?
    var y: i32 = 0
    while y < 64 {
        var x: i32 = 0
        while x < 100 {
            // 96 pixels of picture and 4 that are not part of it.
            var p: u32 = 0x12345678
            if x < 96 {
                p = (marked(x * 3, y * 5) & 0x00FFFFFF) | (@intCast(u32, 255 - ((x * y) & 127)) << 24)
                device.setPixel(layer, x, y, p)
            }
            picture[@intCast(usize, y * 100 + x)] = p
            x += 1
        }
        y += 1
    }
    var filter: u8 = transform.BILINEAR
    while filter <= transform.BOX {
        // A quarter of the size: the box (asked for or not), the same as
        // the device's, to the bit; the words between the rows stay.
        var index: usize = 0
        while index < 90 * 60 {
            result[index] = 0xABCDEF01
            index += 1
        }
        if !transform.scalePixels(picture, 96, 64, 100, result, 24, 16, 30, filter) { return 221 }
        const quarter = transform.scaling(0.25, 0.25, 0.0, 0.0)
        const small = device.create(allocator, 0).?
        if !transform.resample(layer, small, &quarter, filter, geom.rect(0, 0, 24, 16)) { return 222 }
        y = 0
        while y < 16 {
            var x: i32 = 0
            while x < 30 {
                const got = result[@intCast(usize, y * 30 + x)]
                if x >= 24 {
                    if got != 0xABCDEF01 { return 223 }
                } else if got != device.pixel(small, x, y) || got >> 24 == 0 {
                    return 224
                }
                x += 1
            }
            y += 1
        }
        device.destroy(small)
        // Two and a half times the size: the same but at the borders,
        // where a buffer's last pixels go on and a layer ends.
        if !transform.scalePixels(picture, 32, 24, 100, result, 80, 60, 90, filter) { return 225 }
        const cut = device.create(allocator, 0).?
        var row: i32 = 0
        while row < 24 {
            if !device.writeRect(cut, geom.rect(0, row, 32, 1), picture + @intCast(usize, row * 100), 32) { return 226 }
            row += 1
        }
        const larger = device.create(allocator, 0).?
        if !transform.scaleDevice(cut, larger, 2.5, 2.5, filter, 0.0, 0.0) { return 227 }
        y = 0
        while y < 60 {
            var x: i32 = 0
            while x < 80 {
                const got = result[@intCast(usize, y * 90 + x)]
                // (Every alpha of the picture is 128 or more; the sharper
                // filters swing a little past that.)
                if got >> 24 < 100 { return 228 }
                if x >= 8 && x < 72 && y >= 8 && y < 52 && !close(got, device.pixel(larger, x, y), 1) { return 229 }
                x += 1
            }
            y += 1
        }
        device.destroy(larger)
        device.destroy(cut)
        filter += 1
    }
    // The same size copies; NEAREST repeats pixels; one colour stays one
    // colour up to the border with every filter.
    if !transform.scalePixels(picture, 96, 64, 100, result, 96, 56, 90, transform.BICUBIC) { return 230 }
    if !transform.scalePixels(picture, 90, 60, 100, result, 90, 60, 90, transform.BICUBIC) { return 231 }
    if result[0] != picture[0] || result[59 * 90 + 89] != picture[59 * 100 + 89] || result[90 + 7] != picture[100 + 7] { return 232 }
    if !transform.scalePixels(picture, 40, 30, 100, result, 80, 60, 90, transform.NEAREST) { return 233 }
    if result[0] != picture[0] || result[1] != picture[0] || result[90] != picture[0] || result[59 * 90 + 79] != picture[29 * 100 + 39] || result[21 * 90 + 33] != picture[10 * 100 + 16] { return 234 }
    var index: usize = 0
    while index < 6400 {
        picture[index] = 0x80C04020
        index += 1
    }
    filter = transform.BILINEAR
    while filter <= transform.BOX {
        if !transform.scalePixels(picture, 17, 9, 100, result, 53, 31, 90, filter) || !transform.scalePixels(picture, 53, 31, 100, result + 2000, 7, 5, 90, filter) { return 235 }
        if result[0] != 0x80C04020 || result[52] != 0x80C04020 || result[30 * 90 + 52] != 0x80C04020 || result[15 * 90 + 20] != 0x80C04020 || result[2000] != 0x80C04020 || result[2000 + 4 * 90 + 6] != 0x80C04020 { return 236 }
        filter += 1
    }
    if !transform.scalePixels(picture, 10, 10, 100, result, 0, 5, 90, transform.BOX) || transform.scalePixels(picture, 0, 10, 100, result, 5, 5, 90, transform.BOX) { return 237 }
    device.destroy(layer)
    allocator.free(memory.?, 100 * 64 * 4 + 90 * 60 * 4, 16)
    return 0
}

// The small, the far and the absurd.
fn edgeChecks(allocator: std.allocator.Allocator) -> u8 {
    // One pixel: nine of it three times as large; a quarter of one at
    // half the size, as red as it was.
    const dot = device.create(allocator, 0).?
    device.setPixel(dot, -1, -1, 0xFFFF0000)
    const thrice = transform.scaling(3.0, 3.0, 0.0, 0.0)
    const nine = device.create(allocator, 0).?
    if !transform.transformInto(dot, nine, &thrice, transform.NEAREST) { return 250 }
    const block = device.exactBounds(nine)
    if block.x != -3 || block.y != -3 || block.width != 3 || block.height != 3 || device.pixel(nine, -2, -2) != 0xFFFF0000 { return 251 }
    device.clear(nine)
    var filter: u8 = transform.BILINEAR
    while filter <= transform.BOX {
        if !transform.scaleDevice(dot, nine, 0.5, 0.5, filter, 0.0, 0.0) { return 252 }
        const quarter = device.pixel(nine, -1, -1)
        // (A quarter of the pixel's area under the box; the wider filters
        // spread it over the neighbours too.)
        if quarter & 0x00FFFFFF != 0x00FF0000 || quarter >> 24 > 64 || quarter >> 24 < 20 || (filter == transform.BOX && quarter != 0x40FF0000) { return 253 }
        if device.pixel(nine, 0, 0) & 0x00FFFFFF != 0 && device.pixel(nine, 0, 0) & 0x00FFFFFF != 0x00FF0000 { return 254 }
        device.clear(nine)
        // One pixel of the result, far from anything, and an area no
        // layer reaches: nothing, and no tile for it.
        const turn = transform.rotation(0.3, 0.0, 0.0)
        if !transform.resample(dot, nine, &turn, filter, geom.rect(200000000, -200000000, 1, 1)) || device.tileCount(nine) != 0 { return 255 }
        if transform.resample(dot, nine, &turn, filter, geom.rect(0, 0, 400000000, 1)) { return 216 }
        // Shrunk to nothing and blown up a million times: both end, the
        // first with nothing to show, the second with the pixel's colour.
        const vanishing = transform.scaling(0.000000001, 0.000000001, 0.0, 0.0)
        if !transform.resample(dot, nine, &vanishing, filter, geom.rect(-2, -2, 4, 4)) || !device.isBlank(nine) { return 217 }
        const enormous = transform.scaling(1000000.0, 1000000.0, 0.0, 0.0)
        if !transform.resample(dot, nine, &enormous, filter, geom.rect(-500010, -500010, 20, 20)) { return 218 }
        if device.pixel(nine, -500000, -500000) != 0xFFFF0000 || device.pixel(nine, -499991, -500009) != 0xFFFF0000 { return 219 }
        device.clear(nine)
        filter += 1
    }
    if !geom.isEmpty(transform.coverage(geom.empty(), &thrice, transform.BICUBIC)) { return 238 }
    const reach = transform.coverage(geom.rect(-1, -1, 1, 1), &thrice, transform.BILINEAR)
    if reach.x > -6 || reach.y > -6 || reach.x + reach.width < 3 || reach.x < -12 || reach.width > 16 { return 239 }
    device.destroy(nine)
    device.destroy(dot)
    return 0
}

fn printRate(what: []const u8, pixels: usize, nanoseconds: usize) -> void {
    // Megapixels a second, with one decimal.
    const tenths = if nanoseconds == 0 { 0 } else { pixels * 10000 / nanoseconds }
    _ = std.io.print(what)
    _ = std.io.writeUnsigned(std.io.stdout(), tenths / 10)
    _ = std.io.print(".")
    _ = std.io.writeUnsigned(std.io.stdout(), tenths % 10)
    _ = std.io.println(" megapixels a second")
}

// A megapixel turned and scaled: no memory of the value arena taken, and
// how fast it goes.
fn speedChecks(allocator: std.allocator.Allocator) -> u8 {
    const big = device.create(allocator, 0).?
    const row = allocator.alloc(1024 * 4, 16)
    if row == null { return 240 }
    const words: [*]u32 = unsafe { @ptrCast([*]u32, row.?) }
    var y: i32 = 0
    while y < 1024 {
        var x: i32 = 0
        while x < 1024 {
            words[@intCast(usize, x)] = marked(x * 3 + y, y * 5 - x)
            x += 1
        }
        if !device.writeRect(big, geom.rect(0, y, 1024, 1), words, 1024) { return 241 }
        y += 1
    }
    allocator.free(row.?, 1024 * 4, 16)
    const half = device.create(allocator, 0).?
    if !transform.scaleDevice(big, half, 0.5, 0.5, transform.BOX, 0.0, 0.0) { return 242 }
    const arena = turns.locate()
    const before = turns.used(arena)
    var filter: u8 = transform.NEAREST
    while filter <= transform.BOX {
        const turned = device.create(allocator, 0).?
        const started = std.time.monotonicNanoseconds()
        if !transform.rotateDevice(big, turned, 0.5, 512.0, 512.0, filter) { return 243 }
        const taken = std.time.monotonicNanoseconds() - started
        if device.pixel(turned, 512, 512) >> 24 != 255 || device.pixel(turned, 3, 3) != 0 { return 244 }
        if filter == transform.BILINEAR { printRate("bilinear rotation of 1024 x 1024: ", 1024 * 1024, taken) }
        if filter == transform.BICUBIC { printRate("bicubic rotation of 1024 x 1024: ", 1024 * 1024, taken) }
        device.destroy(turned)
        const doubled = device.create(allocator, 0).?
        const scale_started = std.time.monotonicNanoseconds()
        if !transform.scaleDevice(half, doubled, 2.0, 2.0, filter, 0.0, 0.0) { return 245 }
        const scale_taken = std.time.monotonicNanoseconds() - scale_started
        if device.pixel(doubled, 512, 512) >> 24 != 255 { return 246 }
        if filter == transform.BICUBIC { printRate("bicubic 2x upscale to 1024 x 1024: ", 1024 * 1024, scale_taken) }
        if filter == transform.BILINEAR { printRate("bilinear 2x upscale to 1024 x 1024: ", 1024 * 1024, scale_taken) }
        device.destroy(doubled)
        filter += 1
    }
    // The exact moves on it, tile onto tile and across tiles: every
    // seventh pixel is where the three say.
    const copy = device.copy(big).?
    if !transform.rotate90(copy, geom.rect(0, 0, 1024, 1024)) || !transform.flipHorizontal(copy, geom.rect(3, 3, 1001, 1001)) || !transform.offset(copy, geom.rect(10, 10, 900, 900), 333, -77) { return 247 }
    y = -5
    while y < 1030 {
        var x: i32 = -20
        while x < 1030 {
            var px = x
            var py = y
            if geom.contains(geom.rect(10, 10, 900, 900), x, y) {
                px = 10 + wrap(x - 10 - 333, 900)
                py = 10 + wrap(y - 10 + 77, 900)
            }
            // Mirrored about the middle of columns 3 to 1003, then the
            // quarter turn back: (u, v) came from (v, 1023 - u).
            px = 1006 - px
            if device.pixel(copy, x, y) != device.pixel(big, py, 1023 - px) { return 184 }
            x += 7
        }
        y += 7
    }
    const small = device.create(allocator, 0).?
    const tiny_started = std.time.monotonicNanoseconds()
    if !transform.scaleDevice(big, small, 0.125, 0.125, transform.BICUBIC, 0.0, 0.0) { return 248 }
    printRate("1024 x 1024 to an eighth (source pixels): ", 1024 * 1024, std.time.monotonicNanoseconds() - tiny_started)
    const grown = turns.used(arena) - before
    if grown > 65536 { return 249 }
    device.destroy(small)
    device.destroy(copy)
    device.destroy(half)
    device.destroy(big)
    return 0
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var failed = matrixChecks()
    if failed != 0 { return failed }
    failed = exactChecks(allocator, 0, 0, 0)
    if failed != 0 { return failed }
    // The same for a mask (opaque greys, nothing where no tile is) that
    // sits somewhere else.
    failed = exactChecks(allocator, mask.NOTHING, -37, 1000)
    if failed != 0 { return failed + 40 }
    failed = copyChecks(allocator)
    if failed != 0 { return failed }
    failed = scaleChecks(allocator)
    if failed != 0 { return failed }
    failed = hugeChecks(allocator)
    if failed != 0 { return failed }
    failed = turnChecks(allocator)
    if failed != 0 { return failed }
    failed = maskChecks(allocator)
    if failed != 0 { return failed }
    failed = inPlaceChecks(allocator)
    if failed != 0 { return failed }
    failed = bufferChecks(allocator)
    if failed != 0 { return failed }
    failed = edgeChecks(allocator)
    if failed != 0 { return failed }
    failed = speedChecks(allocator)
    if failed != 0 { return failed }
    return 13
}
