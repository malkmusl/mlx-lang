const REJECTED = [20][]const u8{ "", " ", "abc", "1.2.3", "1e", "1e+", "--1", "+", ".", "e5", "1 2", "12px", "0x10", "inf", "nan", "1,5", "-", "+-1", "1e5.5", ". 5" }

const EXACT_TENS = [23]f64{ 1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0, 10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0, 1000000000000000.0, 10000000000000000.0, 100000000000000000.0, 1000000000000000000.0, 10000000000000000000.0, 100000000000000000000.0, 1000000000000000000000.0, 10000000000000000000000.0 }

// Whether formatFloat(value, decimals) writes `expected`.
fn writes(value: f64, decimals: usize, expected: []const u8) -> bool {
    var digits: [336]u8 = undefined
    const bytes: [*]u8 = &digits
    const length = text.formatFloat(value, decimals, bytes, text.FLOAT_ROOM)
    return std.text.same(bytes[0..length], expected)
}

// Whether `value` written with `decimals` (into `bytes`, FLOAT_ROOM of
// them: a buffer of the caller's, as a local here it would be a new one of
// the value arena at every call: its slice is handed on) reads back as
// itself, bit for bit.
fn returns(value: f64, decimals: usize, bytes: [*]u8) -> bool {
    const length = text.formatFloat(value, decimals, bytes, text.FLOAT_ROOM)
    var back: f64 = 1.5
    if length == 0 || !text.parseFloat(bytes[0..length], &back) { return false }
    return @bitCast(u64, back) == @bitCast(u64, value)
}

fn reads(source: []const u8, expected: f64) -> bool {
    var value: f64 = 1.5
    return text.parseFloat(source, &value) && @bitCast(u64, value) == @bitCast(u64, expected)
}

fn readsInt(source: []const u8, expected: i64) -> bool {
    var value: i64 = 77
    return text.parseInt(source, &value) && value == expected
}

fn refusesInt(source: []const u8) -> bool {
    var value: i64 = 77
    return !text.parseInt(source, &value) && value == 77
}

// The decimal text of `whole` with its last `places` digits behind the
// point and no zeros at the end: what formatFloat should write for it.
fn decimalText(whole: u64, places: usize, negative: bool, into: [*]u8) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = whole
    while rest != 0 || count <= places {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var skip: usize = 0
    while skip < places && digits[skip] == 48 { skip += 1 }
    var length: usize = 0
    if negative && whole != 0 {
        into[0] = 45
        length = 1
    }
    var index = count
    while index > skip {
        if index == places {
            into[length] = 46
            length += 1
        }
        index -= 1
        into[length] = digits[index]
        length += 1
    }
    return length
}

fn pathIs(length: usize, bytes: [*]const u8, expected: []const u8) -> bool {
    return std.text.same(bytes[0..length], expected)
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()

    // --- Numbers to text: the edges.
    if !writes(0.0, 9, "0") || !writes(-0.0, 9, "0") || !writes(0.1, 9, "0.1") || !writes(0.35, 6, "0.35") { return 1 }
    if !writes(1.0e-9, 9, "0.000000001") || !writes(123456789.125, 9, "123456789.125") || !writes(1.0e15, 9, "1000000000000000") { return 2 }
    if !writes(-12.0, 3, "-12") || !writes(-12.5, 3, "-12.5") || !writes(1.0, 0, "1") || !writes(100.0, 9, "100") { return 3 }
    // Rounded to the nearest, exactly: halves away from zero, and what is
    // a hair below a half (0.995 as a double is) down.
    if !writes(2.5, 0, "3") || !writes(-2.5, 0, "-3") || !writes(0.125, 2, "0.13") || !writes(-0.125, 2, "-0.13") || !writes(0.375, 2, "0.38") { return 4 }
    if !writes(0.995, 2, "0.99") || !writes(0.994, 2, "0.99") || !writes(0.996, 2, "1") || !writes(0.999999, 3, "1") || !writes(9.9996, 3, "10") { return 5 }
    // What rounds to nothing has no sign.
    if !writes(1.0e-10, 9, "0") || !writes(-1.0e-10, 9, "0") || !writes(-0.0004, 3, "0") || !writes(-0.0005, 3, "-0.001") { return 6 }
    // Never more digits than say which double it is.
    if !writes(0.1, 18, "0.1") || !writes(3.141592653589793, 17, "3.141592653589793") || !writes(123456789.125, 18, "123456789.125") || !writes(33344584.8, 9, "33344584.8") { return 7 }
    if !writes(0.30000000000000004, 18, "0.30000000000000004") || !writes(5.0e-324, 18, "0") || !writes(1.0e-18, 18, "0.000000000000000001") || !writes(1.0e-18, 99, "0.000000000000000001") { return 7 }
    if !writes(0.001, 18, "0.001") || !writes(1.0e19, 9, "10000000000000000000") || !writes(18446744073709551616.0, 2, "18446744073709552000") { return 8 }
    if !writes(9007199254740992.0, 4, "9007199254740992") || !writes(2251799813685248.5, 4, "2251799813685248.5") { return 9 }
    // No number, and more than any: "0" and the largest double.
    var room: [336]u8 = undefined
    const bytes: [*]u8 = &room
    const nan = @bitCast(f64, @intCast(u64, 0x7FF8000000000000))
    const infinity = @bitCast(f64, @intCast(u64, 0x7FF0000000000000))
    if !writes(nan, 9, "0") { return 10 }
    var length = text.formatFloat(infinity, 9, bytes, text.FLOAT_ROOM)
    if length != 309 || !std.text.startsWith(bytes[0..length], "17976931348623157000") || !reads(bytes[0..length], 1.7976931348623157e308) { return 11 }
    length = text.formatFloat(-infinity, 9, bytes, text.FLOAT_ROOM)
    if length != 310 || bytes[0] != 45 { return 12 }
    // What does not fit is not written in part.
    if text.formatFloat(0.35, 6, bytes, 3) != 0 || text.formatFloat(0.35, 6, bytes, 4) != 4 || text.formatFloat(-1.0e300, 2, bytes, 300) != 0 { return 14 }
    if text.formatFloat(-0.5, 1, bytes, 3) != 0 || text.formatFloat(7.0, 3, bytes, 1) != 1 || text.formatFloat(7.0, 3, bytes, 0) != 0 { return 15 }
    // The largest and the smallest come back from their digits.
    if !returns(1.7976931348623157e308, 0, bytes) || !returns(1.0e300, 3, bytes) || !returns(-1.0e22, 3, bytes) || !returns(1.0e23, 3, bytes) || !returns(2.0e19, 9, bytes) { return 16 }

    // --- Text to numbers.
    for case in CASES {
        var value: f64 = 1.5
        if !text.parseFloat(case.text, &value) || @bitCast(u64, value) != case.bits { return 17 }
    }
    if !reads("  -12.50e2 ", -1250.0) || !reads("\t7\n", 7.0) || !reads(".5", 0.5) || !reads("5.", 5.0) || !reads("+3", 3.0) { return 18 }
    if !reads("1E-5", 0.00001) || !reads("007", 7.0) || !reads("-0", -0.0) || !reads("0.0", 0.0) || !reads("0e999999999999", 0.0) { return 19 }
    if !reads("-1e999999999999", -infinity) || !reads("1e-999999999999", 0.0) || !reads("0.35", 0.35) || !reads("1.0e15", 1.0e15) { return 20 }
    for refused in REJECTED {
        var value: f64 = 1.5
        if text.parseFloat(refused, &value) || value != 1.5 { return 21 }
    }
    if !readsInt("42", 42) || !readsInt(" -42 ", -42) || !readsInt("+7", 7) || !readsInt("0", 0) || !readsInt("-0", 0) { return 22 }
    if !readsInt("9223372036854775807", 9223372036854775807) || !readsInt("-9223372036854775808", -9223372036854775807 - 1) { return 23 }
    if !refusesInt("9223372036854775808") || !refusesInt("-9223372036854775809") || !refusesInt("99999999999999999999999") { return 24 }
    if !refusesInt("") || !refusesInt("-") || !refusesInt("4.5") || !refusesInt("1e3") || !refusesInt("12a") || !refusesInt("1 2") { return 25 }
    length = text.formatInt(-9223372036854775807 - 1, bytes, 20)
    if !std.text.same(bytes[0..length], "-9223372036854775808") || text.formatInt(-9223372036854775807 - 1, bytes, 19) != 0 { return 26 }
    length = text.formatInt(0, bytes, 20)
    if !std.text.same(bytes[0..length], "0") { return 27 }
    length = text.formatInt(1234567890123, bytes, 20)
    if !std.text.same(bytes[0..length], "1234567890123") { return 28 }

    // --- 100000 decimal values of up to 15 digits, up to 9 of them
    // behind the point: the text is the value's own decimal text, and
    // reads back as the same double.
    var generator: random.Xoshiro256 = undefined
    random.seed(&generator, 41)
    const arena = turns.locate()
    const arena_before = turns.used(arena)
    const live = std.heap.liveBytes()
    const sizes = [6]u64{ 1000, 1000000, 1000000000, 1000000000000, 100000000000000, 1000000000000000 }
    var expected: [40]u8 = undefined
    const wanted: [*]u8 = &expected
    var round: usize = 0
    while round < 100000 {
        const places = @intCast(usize, random.below(&generator, 10))
        const whole = random.below(&generator, sizes[@intCast(usize, random.below(&generator, 6))])
        const negative = random.below(&generator, 2) == 1
        // (Both parts are doubles exactly: the quotient is the nearest.)
        var value = @floatFromInt(f64, whole) / EXACT_TENS[places]
        if negative { value = -value }
        length = text.formatFloat(value, 9, bytes, text.FLOAT_ROOM)
        const wanted_length = decimalText(whole, places, negative, wanted)
        if !std.text.same(bytes[0..length], wanted[0..wanted_length]) { return 29 }
        var back: f64 = 1.5
        if !text.parseFloat(bytes[0..length], &back) || @bitCast(u64, back) != @bitCast(u64, value) {
            // (Only a zero's sign may be lost.)
            if whole != 0 || back != 0.0 { return 30 }
        }
        round += 1
    }
    // Doubles of any size from an eighth up: 17 digits bring each back.
    round = 0
    while round < 20000 {
        const fraction = random.next(&generator) & 0xFFFFFFFFFFFFF
        const power = 1020 + random.below(&generator, 1027)
        const sign = random.below(&generator, 2) << 63
        const value = @bitCast(f64, sign | (power << 52) | fraction)
        if !returns(value, 18, bytes) { return 31 }
        round += 1
    }
    // Digits and a negative exponent: up to 10^22 the quotient of the two
    // (both doubles exactly) is the nearest double.
    round = 0
    while round < 20000 {
        const whole = random.below(&generator, 1000000000000000)
        const down = @intCast(usize, random.below(&generator, 23))
        length = text.formatInt(@bitCast(i64, whole), bytes, 40)
        // (Not std.text.append(.., "e-") and appendUnsigned: a string
        // literal handed to a function that copies it, and appendUnsigned's
        // own digits, are new values of the arena at every call.)
        length = std.text.appendByte(bytes, length, 60, 101)
        length = std.text.appendByte(bytes, length, 60, 45)
        length += text.formatInt(@intCast(i64, down), bytes + length, 20)
        if !reads(bytes[0..length], @floatFromInt(f64, whole) / EXACT_TENS[down]) { return 32 }
        round += 1
    }
    // (This copies the table into the arena once: 2880 bytes.)
    for case in RANDOM_CASES {
        var value: f64 = 1.5
        if !text.parseFloat(case.text, &value) || @bitCast(u64, value) != case.bits { return 33 }
    }
    if turns.used(arena) - arena_before > 65536 { return 35 }
    if std.heap.liveBytes() != live { return 36 }

    // --- XML written.
    var list = std.ArrayList(u8).init(allocator)
    defer list.deinit()
    var writer: text.XmlWriter = undefined
    text.xmlBegin(&writer, &list, 2)
    text.xmlDeclaration(&writer)
    text.xmlRaw(&writer, "<!-- made by a test -->")
    text.xmlOpen(&writer, "image")
    text.xmlAttributeInt(&writer, "w", 640)
    text.xmlAttributeInt(&writer, "h", -480)
    text.xmlOpen(&writer, "stack")
    text.xmlOpen(&writer, "layer")
    text.xmlAttribute(&writer, "name", "a < b & c > \"d\" 'e'")
    text.xmlAttributeFloat(&writer, "opacity", 0.35, 6)
    text.xmlClose(&writer)
    text.xmlOpen(&writer, "layer")
    text.xmlAttribute(&writer, "name", "Zeile 1\nZeile 2\tTab\rR \x01 \u{fc}\u{20ac}")
    text.xmlAttribute(&writer, "leer", "")
    text.xmlClose(&writer)
    text.xmlElement(&writer, "title", "Tom & Jerry <3>\nzweite Zeile\r")
    text.xmlElement(&writer, "empty", "")
    text.xmlOpen(&writer, "mixed")
    text.xmlText(&writer, "vor ")
    text.xmlElement(&writer, "b", "fett")
    text.xmlText(&writer, " nach")
    text.xmlClose(&writer)
    text.xmlClose(&writer)
    if !text.xmlEnd(&writer) { return 37 }
    const EXPECTED = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- made by a test -->\n<image w=\"640\" h=\"-480\">\n  <stack>\n    <layer name=\"a &lt; b &amp; c &gt; &quot;d&quot; 'e'\" opacity=\"0.35\"/>\n    <layer name=\"Zeile 1&#10;Zeile 2&#9;Tab&#13;R &#1; \u{fc}\u{20ac}\" leer=\"\"/>\n    <title>Tom &amp; Jerry &lt;3&gt;\nzweite Zeile&#13;</title>\n    <empty/>\n    <mixed>vor <b>fett</b> nach</mixed>\n  </stack>\n</image>\n"
    if !std.text.same(list.items(), EXPECTED) { return 38 }

    // --- ... and read back with std.xml.
    const document = list.items()
    var tokenizer: xml.Tokenizer = undefined
    var token: xml.Token = undefined
    xml.initAt(&tokenizer, document.pointer, document.length)
    var decoded: [128]u8 = undefined
    const plain: [*]u8 = &decoded
    var layers: usize = 0
    var elements: usize = 0
    var attributes: usize = 0
    var title_next = false
    var title_seen = false
    while xml.next(&tokenizer, &token) {
        if token.kind == xml.TokenKind.attribute { attributes += 1 }
        if token.kind == xml.TokenKind.text && title_next {
            const title = text.unescape(std.string.asSlice(token.value), plain, 128)
            if title == null || !std.text.same(title.?, "Tom & Jerry <3>\nzweite Zeile\r") { return 39 }
            title_seen = true
        }
        title_next = false
        if token.kind != xml.TokenKind.elementStart { continue }
        elements += 1
        if xml.equals(token.name, "title") { title_next = true }
        if xml.equals(token.name, "image") {
            if text.attributeIntOr(document, token.offset, "w", 0) != 640 || text.attributeIntOr(document, token.offset, "h", 0) != -480 { return 40 }
            if text.attributeIntOr(document, token.offset, "d", 7) != 7 || text.attributeOf(document, token.offset, "W") != null { return 41 }
            var number: i64 = 5
            if text.attributeInt(document, token.offset, "name", &number) || number != 5 { return 42 }
        }
        if xml.equals(token.name, "layer") {
            const name = text.attributeText(document, token.offset, "name", plain, 128)
            if name == null { return 43 }
            if layers == 0 {
                if !std.text.same(name.?, "a < b & c > \"d\" 'e'") { return 44 }
                var opacity: f64 = 0.0
                if !text.attributeFloat(document, token.offset, "opacity", &opacity) || opacity != 0.35 { return 45 }
                if text.attributeFloatOr(document, token.offset, "opacity", 1.0) != 0.35 { return 46 }
                const raw = text.attributeOf(document, token.offset, "name")
                if raw == null || !std.text.same(raw.?, "a &lt; b &amp; c &gt; &quot;d&quot; 'e'") { return 47 }
                // (Too little room is no text.)
                if text.attributeText(document, token.offset, "name", plain, 5) != null { return 48 }
            } else {
                if !std.text.same(name.?, "Zeile 1\nZeile 2\tTab\rR \x01 \u{fc}\u{20ac}") { return 49 }
                const none = text.attributeOf(document, token.offset, "leer")
                if none == null || none.?.length != 0 { return 50 }
                if text.attributeFloatOr(document, token.offset, "opacity", 1.0) != 1.0 || text.attributeFloatOr(document, token.offset, "leer", 2.0) != 2.0 { return 51 }
            }
            layers += 1
        }
    }
    if xml.failed(&tokenizer) || layers != 2 || elements != 8 || attributes != 6 || !title_seen { return 52 }
    // Attributes in a hand-written tag: single quotes, spaces around "=",
    // a tag that ends early.
    const loose = "<a  x = '1'\n\ty=\"2&amp;3\" z='\"'/><b x='9'"
    if text.attributeIntOr(loose, 0, "x", 0) != 1 || text.attributeOf(loose, 0, "q") != null { return 53 }
    const y = text.attributeText(loose, 0, "y", plain, 128)
    const z = text.attributeOf(loose, 0, "z")
    if y == null || !std.text.same(y.?, "2&3") || z == null || !std.text.same(z.?, "\"") { return 54 }
    if text.attributeIntOr(loose, 32, "x", 0) != 9 || text.attributeOf(loose, 32, "y") != null || text.attributeOf(loose, 1, "x") != null || text.attributeOf(loose, 900, "x") != null { return 55 }
    if text.unescape("a &bogus; b", plain, 128) != null || text.unescape("&#x41;&#66;", plain, 1) != null { return 56 }
    const letters = text.unescape("&#x41;&#66;&apos;", plain, 128)
    if letters == null || !std.text.same(letters.?, "AB'") { return 57 }

    // The writer says when it was used wrongly, and stops at 64 levels.
    list.clearRetainingCapacity()
    text.xmlBegin(&writer, &list, 0)
    text.xmlOpen(&writer, "a")
    text.xmlText(&writer, "x")
    text.xmlAttribute(&writer, "late", "1")
    if text.xmlEnd(&writer) { return 58 }
    list.clearRetainingCapacity()
    text.xmlBegin(&writer, &list, 0)
    text.xmlClose(&writer)
    if text.xmlEnd(&writer) { return 59 }
    list.clearRetainingCapacity()
    text.xmlBegin(&writer, &list, 1)
    round = 0
    while round < 64 {
        text.xmlOpen(&writer, "deep")
        round += 1
    }
    if !text.xmlEnd(&writer) { return 60 }
    xml.initAt(&tokenizer, list.items().pointer, list.count())
    round = 0
    while xml.next(&tokenizer, &token) {
        if token.kind == xml.TokenKind.elementStart { round += 1 }
    }
    if xml.failed(&tokenizer) || round != 64 { return 61 }
    list.clearRetainingCapacity()
    text.xmlBegin(&writer, &list, 1)
    round = 0
    while round < 65 {
        text.xmlOpen(&writer, "deep")
        round += 1
    }
    if text.xmlEnd(&writer) { return 62 }

    // --- Paths.
    if !std.text.same(text.baseName("a/b/c.png"), "c.png") || !std.text.same(text.baseName("c.png"), "c.png") || text.baseName("a/b/").length != 0 || text.baseName("").length != 0 { return 63 }
    if !std.text.same(text.directory("a/b/c.png"), "a/b") || text.directory("c.png").length != 0 || !std.text.same(text.directory("/c.png"), "/") || !std.text.same(text.directory("/a/c"), "/a") { return 64 }
    if !std.text.same(text.extension("a/b.tar.PNG"), "PNG") || text.extension("a.b/c").length != 0 || text.extension(".config").length != 0 || text.extension("file.").length != 0 || text.extension("").length != 0 { return 65 }
    if !text.hasExtension("Bild.JPeG", "jpeg") || text.hasExtension("Bild.jpg", "jpeg") || !text.hasExtension("noext", "") || !text.sameIgnoringCase("AbC", "aBc") || text.sameIgnoringCase("abc", "abd") { return 66 }
    var made: [64]u8 = undefined
    const path: [*]u8 = &made
    if !pathIs(text.withExtension("a/b.png", "ora", path, 64), path, "a/b.ora") || !pathIs(text.withExtension("a.b/c", "kra", path, 64), path, "a.b/c.kra") { return 67 }
    if !pathIs(text.withExtension("x.tar.gz", "", path, 64), path, "x.tar") || !pathIs(text.withExtension("name.", "png", path, 64), path, "name.png") || !pathIs(text.withExtension(".config", "bak", path, 64), path, ".config.bak") { return 68 }
    if text.withExtension("abc.png", "jpeg", path, 7) != 0 || text.withExtension("abc.png", "jpeg", path, 8) != 8 { return 69 }
    if !pathIs(text.join("a/b", "c.png", path, 64), path, "a/b/c.png") || !pathIs(text.join("a/b/", "c.png", path, 64), path, "a/b/c.png") || !pathIs(text.join("", "c.png", path, 64), path, "c.png") { return 70 }
    if !pathIs(text.join("/", "c", path, 64), path, "/c") || !pathIs(text.join("a", "/root/c", path, 64), path, "/root/c") || text.join("abc", "def", path, 6) != 0 || text.join("abc", "def", path, 7) != 7 { return 71 }

    // --- Files, in a directory of the test's own.
    const FOLDER = "nebula_test_41"
    if !std.fs.makeDirectories(FOLDER, 493) { return 72 }
    var name: [64]u8 = undefined
    const file: [*]u8 = &name
    const file_length = text.join(FOLDER, "notes.xml", file, 64)
    const file_path = file[0..file_length]
    const heap_before = std.heap.liveBytes()
    var contents: text.Contents = undefined
    if text.exists(allocator, file_path) || text.readFile(allocator, file_path, &contents) != text.FileStatus.notFound { return 73 }
    if text.readFile(allocator, FOLDER, &contents) != text.FileStatus.notReadable || text.readFile(allocator, "", &contents) != text.FileStatus.notFound { return 74 }
    if text.readFile(allocator, "nebula_test_41/no/such/folder/x", &contents) != text.FileStatus.notFound || text.readFile(allocator, "nebula_test_41/notes.xml/x", &contents) != text.FileStatus.notFound { return 75 }
    if !text.writeFile(allocator, file_path, EXPECTED) || !text.exists(allocator, file_path) { return 76 }
    if text.readFile(allocator, file_path, &contents) != text.FileStatus.ok { return 77 }
    if !std.text.same(contents.bytes[0..contents.length], EXPECTED) { return 78 }
    text.freeFile(&contents)
    // Replaced whole (by more: 300000 bytes; by nothing), nothing left beside it.
    const LARGE: usize = 300000
    const memory = allocator.alloc(LARGE, 16)
    if memory == null { return 79 }
    var index: usize = 0
    while index < LARGE {
        memory.?[index] = @intCast(u8, (index * 7 + index / 251) & 255)
        index += 1
    }
    if !text.writeFile(allocator, file_path, memory.?[0..LARGE]) { return 80 }
    if text.readFile(allocator, file_path, &contents) != text.FileStatus.ok || contents.length != LARGE || !std.mem.eql(contents.bytes, memory.?, LARGE) { return 81 }
    text.freeFile(&contents)
    text.freeFile(&contents)
    allocator.free(memory.?, LARGE, 16)
    if !text.writeFile(allocator, file_path, "") || text.readFile(allocator, file_path, &contents) != text.FileStatus.ok || contents.length != 0 { return 82 }
    text.freeFile(&contents)
    if text.exists(allocator, "nebula_test_41/notes.xml.new") { return 83 }
    // Nowhere to write to, no path at all.
    if text.writeFile(allocator, "nebula_test_41/no/such/folder/x", "x") || text.writeFile(allocator, "", "x") || text.exists(allocator, "") { return 84 }
    if !text.deleteFile(allocator, file_path) || text.exists(allocator, file_path) || text.deleteFile(allocator, file_path) { return 85 }
    if std.heap.liveBytes() != heap_before { return 86 }
    if !std.fs.removeTree(FOLDER.pointer) { return 87 }
    return 13
}
