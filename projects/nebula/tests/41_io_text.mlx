// nebula's text for files (io/text.mlx): numbers written and read back
// (100000 pseudo-random decimal values of up to 15 digits give the text
// expected and read back as the same double; 20000 doubles of any size
// come back to the bit from 17 digits; the edges: 0, -0, 0.1, 0.35, 1e-9,
// 123456789.125, 1e15, halves, the largest and the smallest double),
// parseFloat against doubles known from elsewhere (the hard cases around
// the limits and between two doubles, very long digit strings),
// rejections, parseInt and formatInt at the ends of an i64; XML written
// (indentation, escaping) and read back with std.xml, attribute values
// with everything that has to be escaped in them, the helpers that find
// and convert an element's attributes; the path helpers; a file written,
// replaced, read and removed in a directory of the test's own, missing
// ones and folders told apart; and that the loops leave the value arena
// and the heap alone. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const random = @import("std.random")
const turns = @import("std.turns")
const xml = @import("std.xml")
const text = @import("../io/text.mlx")

const Case = struct {
    text: []const u8
    bits: u64
}

