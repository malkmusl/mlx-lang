// probe (temporary): best of three for some filters
const std = @import("std")
const crash = @import("std.crash")
const filters = @import("../filters/registry.mlx")

fn run(name: []const u8, params: *const filters.Params, pixels: [*]u32, keep: [*]const u32, width: usize, height: usize) -> void {
    var best: usize = 0
    var round: usize = 0
    while round < 3 {
        var index: usize = 0
        while index < width * height {
            pixels[index] = keep[index]
            index += 1
        }
        const start = std.time.monotonicNanoseconds()
        _ = filters.apply(params, pixels, width, height, width)
        const took = std.time.monotonicNanoseconds() - start
        const rate = width * height * 10 / (took / 1000 + 1)
        if rate > best { best = rate }
        round += 1
    }
    _ = std.io.print(name)
    _ = std.io.print(": ")
    _ = std.io.writeUnsigned(std.io.stdout(), best)
    _ = std.io.println(" MP/s x 10")
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const width: usize = 1024
    const height: usize = 1024
    var pixels: [*]u32 = undefined
    var keep: [*]u32 = undefined
    unsafe {
        pixels = @ptrCast([*]u32, allocator.alloc(width * height * 4, 16).?)
        keep = @ptrCast([*]u32, allocator.alloc(width * height * 4, 16).?)
    }
    var seed: u32 = 12345
    var index: usize = 0
    while index < width * height {
        seed = seed *% 1664525 +% 1013904223
        keep[index] = (seed ^ (seed >> 15)) | 0xFF000000
        if (index / 64) % 3 == 0 { keep[index] = seed ^ (seed >> 15) }
        index += 1
    }
    var params: filters.Params = undefined
    filters.defaults(154, &params)
    run("wavelet", &params, pixels, keep, width, height)
    filters.defaults(100, &params)
    run("gaussian 5", &params, pixels, keep, width, height)
    params.values[0] = 30.0
    params.values[1] = 30.0
    run("gaussian 30", &params, pixels, keep, width, height)
    filters.defaults(152, &params)
    run("unsharp", &params, pixels, keep, width, height)
    filters.defaults(103, &params)
    run("lens 5", &params, pixels, keep, width, height)
    params.values[0] = 20.0
    run("lens 20", &params, pixels, keep, width, height)
    filters.defaults(102, &params)
    params.values[0] = 90.0
    params.values[1] = 40.0
    run("motion 90 40", &params, pixels, keep, width, height)
    params.values[0] = 30.0
    params.values[1] = 17.0
    run("motion 30 17", &params, pixels, keep, width, height)
    filters.defaults(101, &params)
    run("blur circle 5", &params, pixels, keep, width, height)
    return 13
}
