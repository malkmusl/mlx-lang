// The selection tools (tools/selections.mlx) played by scripts on an App
// without a window (app/script.mlx), the selection read back as amounts:
// a rectangle drag selects exactly its pixels (across the tile borders at
// 64 and 128, cut at the image's edge when it starts outside, a 4 x 4 box
// is no click); Shift adds, Alt subtracts, Shift and Alt intersect; a
// click deselects; a feather of 4 softens the edge; the ellipse's area; a
// polygon by clicks and Enter and by a double click; a freehand outline
// by a drag; the wand on a red square in white selects the square exactly
// at threshold 0, sampling the image or the active layer, a single pixel
// alone or with its diagonal neighbour; the similar colour selection
// takes all red patches; the bezier outline closes with its handle's
// bulge; a drag inside the selection moves it (cut at the image's edge);
// the magnetic outline follows the rim of a disc, not the straight lines
// between its anchors. Every action is one step of the history named
// after its mode (in German too), undo puts back the selection before
// exactly (also none) and redo the one after; Escape in the middle of a
// drag or a move leaves the old selection and takes the dashed outline
// away; the line to the pointer goes when the outline closes; Backspace
// takes a corner or an anchor back. The options panel of every tool is
// drawn at 1024 x 768 in the dark and the light theme and in German, its
// mode buttons set the mode, and what it sets is kept in the settings.
// Searching edges and drawing outlines many times takes nothing of the
// value arena. Pictures: select.png (ants), select-drag.png (a dashed box
// being dragged), select-polygon.png, select-magnetic.png,
// select-options-dark.png, select-options-light.png,
// select-options-german.png, also into $NEBULA_SHOTS when it names a
// folder. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const png = @import("std.png")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const settings = @import("../app/settings.mlx")
const kit_module = @import("../ui/kit.mlx")
const viewport = @import("../ui/viewport.mlx")
const tools = @import("../tools/registry.mlx")
const select = @import("../tools/selections.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const mask = @import("../core/mask.mlx")
const selection = @import("../core/selection.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const raster = @import("../core/raster.mlx")
const geom = @import("../core/geom.mlx")
const blend = @import("../core/blend.mlx")

const App = state.App

// The script being put together (in the program's data: the steps are
// many and short).
var text: [4096]u8 = undefined
var length: usize = 0
// The folder pictures go to besides the current one ("": none).
var shots: [512]u8 = undefined
var shotsLength: usize = 0
// Three pictures of a selection's amounts (a byte a pixel, the image's
// width a row) and whether there was one.
var before: usize = 0
var after: usize = 0
var now: usize = 0
var beforeSelected: bool = false
var afterSelected: bool = false
const MOST_PIXELS: usize = 120000

fn add(piece: []const u8) -> void {
    const bytes: [*]u8 = &text
    length = std.text.append(bytes, length, 4096, piece)
}

fn addNumber(value: i32) -> void {
    const bytes: [*]u8 = &text
    length = std.text.appendSigned(bytes, std.text.append(bytes, length, 4096, " "), 4096, @intCast(isize, value))
}

// " X Y": the window pixel a tool gets image pixel (x, y) from (its
// corner or its middle, by how the area's middle falls).
fn addPlace(app: *App, x: i32, y: i32) -> void {
    const doc = api.document(app).?
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(&doc.*.view, @floatFromInt(f64, x) + 0.25, @floatFromInt(f64, y) + 0.25, &wx, &wy)
    addNumber(@intFromFloat(i32, @floor(wx)))
    addNumber(@intFromFloat(i32, @floor(wy)))
}

fn play(app: *App) -> bool {
    const ok = script.run(app, text[0..length])
    length = 0
    return ok
}

fn step(app: *App, line: []const u8) -> bool {
    add(line)
    add("\n")
    return play(app)
}

fn drag(app: *App, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    add("drag")
    addPlace(app, x0, y0)
    addPlace(app, x1, y1)
    add(" 8\n")
    return play(app)
}

fn click(app: *App, x: i32, y: i32) -> bool {
    add("click")
    addPlace(app, x, y)
    add("\n")
    return play(app)
}

fn pointer(app: *App, x: i32, y: i32) -> bool {
    add("pointer")
    addPlace(app, x, y)
    add("\n")
    return play(app)
}

// A picture of the frame: `name` here and in the shots folder.
fn shot(app: *App, name: []const u8) -> bool {
    add("shot ")
    add(name)
    add("\n")
    if shotsLength > 0 {
        add("shot ")
        add(shots[0..shotsLength])
        add("/")
        add(name)
        add("\n")
    }
    return play(app)
}

fn bytesAt(address: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, address) }
}

// The selection's amounts over the image into `into`; whether there is
// one.
fn take(app: *App, into: usize) -> bool {
    const image = api.image(app).?
    const area = image_module.bounds(image)
    std.mem.zero(bytesAt(into), MOST_PIXELS)
    if !image.*.selected { return false }
    mask.readBytes(image.*.selection, area, bytesAt(into), @intCast(usize, area.width))
    return true
}

fn amount(app: *App, x: i32, y: i32) -> u32 {
    const image = api.image(app).?
    if !image.*.selected { return 0 }
    return mask.at(image.*.selection, x, y)
}

fn steps(app: *App) -> usize {
    return history.stepsDone(api.image(app).?.*.history)
}

fn lastName(app: *App, name: []const u8) -> bool {
    return std.text.same(history.undoName(api.image(app).?.*.history), name)
}

// How many pixels are selected by half or more.
fn counted(app: *App) -> usize {
    _ = take(app, now)
    const image = api.image(app).?
    const count = @intCast(usize, image.*.width) * @intCast(usize, image.*.height)
    var total: usize = 0
    var index: usize = 0
    while index < count {
        if bytesAt(now)[index] >= 128 { total += 1 }
        index += 1
    }
    return total
}

fn sameAs(app: *App, picture: usize, selected: bool) -> bool {
    const is = take(app, now)
    return is == selected && std.mem.eql(bytesAt(now), bytesAt(picture), MOST_PIXELS)
}

// Before an action: what the selection was.
fn remember(app: *App) -> void {
    beforeSelected = take(app, before)
}

// After an action: it was one step named `name`; undo gives back the
// selection before it exactly, redo the one after. 0, or what failed
// (1-5).
fn oneStep(app: *App, done_before: usize, name: []const u8) -> u8 {
    if steps(app) != done_before + 1 { return 1 }
    if !lastName(app, name) { return 2 }
    afterSelected = take(app, after)
    if !step(app, "key Ctrl+Z") || !sameAs(app, before, beforeSelected) { return 3 }
    if !step(app, "key Ctrl+Shift+Z") || !sameAs(app, after, afterSelected) { return 4 }
    if api.toolBusy(app) { return 5 }
    return 0
}

fn checked(base: u8, failed: u8) -> u8 {
    if failed == 0 { return 0 }
    return base + failed
}

fn options(app: *App, id: u8) -> *select.Options {
    return select.optionsOf(app, id).?
}

// ---------------------------------------------------------------------------

// Rectangles: exact pixels, the four modes, a click, the image's edge,
// Escape in the middle of a drag, a feather.
fn rectangles(app: *App) -> u8 {
    if !step(app, "tool selectrect") || app.*.tool != select.RECTANGLE { return 20 }
    const image = api.image(app).?
    if image.*.selected || steps(app) != 0 { return 21 }

    // Pixels 50-149 x 40-119: across the tile borders at 64 and 128.
    remember(app)
    if !drag(app, 50, 40, 150, 120) { return 22 }
    var into = geom.empty()
    if !image.*.selected || !selection.isRectangle(image.*.selection, &into) || !geom.same(into, geom.rect(50, 40, 100, 80)) { return 23 }
    if amount(app, 50, 40) != 255 || amount(app, 149, 119) != 255 || amount(app, 49, 40) != 0 || amount(app, 150, 60) != 0 || amount(app, 100, 39) != 0 || amount(app, 100, 120) != 0 { return 24 }
    var failed = checked(24, oneStep(app, 0, "Select"))
    if failed != 0 { return failed }

    // Shift: the union with 100-199 x 80-159.
    remember(app)
    if !step(app, "down Shift") || !drag(app, 100, 80, 200, 160) || !step(app, "up Shift") { return 30 }
    if amount(app, 180, 150) != 255 || amount(app, 60, 50) != 255 || amount(app, 180, 50) != 0 || amount(app, 60, 150) != 0 || amount(app, 200, 100) != 0 { return 31 }
    failed = checked(31, oneStep(app, 1, "Add to Selection"))
    if failed != 0 { return failed }

    // Alt: 60-89 x 50-69 taken out.
    remember(app)
    if !step(app, "down Alt") || !drag(app, 60, 50, 90, 70) || !step(app, "up Alt") { return 37 }
    if amount(app, 70, 60) != 0 || amount(app, 89, 69) != 0 || amount(app, 90, 60) != 255 || amount(app, 70, 70) != 255 { return 38 }
    failed = checked(38, oneStep(app, 2, "Subtract from Selection"))
    if failed != 0 { return failed }

    // Shift and Alt: only what lies in 0-119 x 0-99 stays.
    remember(app)
    if !step(app, "down Shift\ndown Alt") || !drag(app, 0, 0, 120, 100) || !step(app, "up Alt\nup Shift") { return 44 }
    if amount(app, 110, 90) != 255 || amount(app, 130, 90) != 0 || amount(app, 70, 60) != 0 || amount(app, 110, 100) != 0 || amount(app, 150, 150) != 0 { return 45 }
    failed = checked(45, oneStep(app, 3, "Intersect Selection"))
    if failed != 0 { return failed }

    // A click deselects (undo brings it back); a click with nothing
    // selected does nothing.
    remember(app)
    if !click(app, 300, 250) || image.*.selected { return 51 }
    failed = checked(51, oneStep(app, 4, "Deselect"))
    if failed != 0 { return failed }
    if !click(app, 300, 250) || steps(app) != 5 { return 57 }

    // From outside the image: cut at its edge.
    if !drag(app, -30, -20, 40, 30) || !selection.isRectangle(image.*.selection, &into) || !geom.same(into, geom.rect(0, 0, 40, 30)) { return 58 }
    // A small box (4 x 4) is no click.
    if !drag(app, 300, 200, 304, 204) || !selection.isRectangle(image.*.selection, &into) || !geom.same(into, geom.rect(300, 200, 4, 4)) { return 59 }
    if steps(app) != 7 { return 60 }

    // Escape in the middle of a drag: the dashed box shows while the
    // button is down and goes; the selection stays as it was, nothing is
    // recorded.
    remember(app)
    if !pointer(app, 100, 60) || !step(app, "press") || !pointer(app, 160, 90) || !pointer(app, 220, 130) { return 61 }
    if !api.toolBusy(app) || !shot(app, "select-drag.png") { return 62 }
    if blackOnRow(app, 60, 110, 210) < 8 { return 63 }
    if !step(app, "key Escape") || api.toolBusy(app) { return 64 }
    if blackOnRow(app, 60, 110, 210) != 0 { return 65 }
    if !step(app, "release") || steps(app) != 7 || !sameAs(app, before, beforeSelected) { return 66 }

    // A feather of 4: the edge is soft over about 4 pixels each way, the
    // inside whole, nothing beyond.
    options(app, select.RECTANGLE).*.feather = 4
    if !drag(app, 50, 40, 150, 120) { return 67 }
    options(app, select.RECTANGLE).*.feather = 0
    const edge = amount(app, 50, 80)
    const inside_edge = amount(app, 52, 80)
    const outside_edge = amount(app, 48, 80)
    if amount(app, 100, 80) != 255 || amount(app, 55, 80) != 255 || amount(app, 44, 80) != 0 || amount(app, 100, 34) != 0 { return 68 }
    if edge == 0 || edge == 255 || outside_edge == 0 || outside_edge >= edge || inside_edge <= edge || inside_edge == 255 { return 69 }
    if steps(app) != 8 { return 70 }
    return 0
}

// How many window pixels of the frame are black on the window row that
// shows image row `y`, between the columns of image columns `x0` and
// `x1`.
fn blackOnRow(app: *App, y: i32, x0: i32, x1: i32) -> usize {
    const frame = script.frameOf(app).?
    const doc = api.document(app).?
    var ax: f64 = 0.0
    var ay: f64 = 0.0
    var bx: f64 = 0.0
    var by: f64 = 0.0
    viewport.toWindow(&doc.*.view, @floatFromInt(f64, x0), @floatFromInt(f64, y), &ax, &ay)
    viewport.toWindow(&doc.*.view, @floatFromInt(f64, x1), @floatFromInt(f64, y), &bx, &by)
    const row = @intFromFloat(i32, @floor(ay))
    var total: usize = 0
    // The dashed line lies on the row or the one above it (where the
    // corner's coordinate falls between two).
    var r = row - 1
    while r <= row {
        var x = @intFromFloat(i32, @floor(ax))
        while x < @intFromFloat(i32, @floor(bx)) {
            if x >= 0 && r >= 0 && @intCast(usize, x) < frame.*.width && @intCast(usize, r) < frame.*.height {
                if frame.*.pixels[@intCast(usize, r) * frame.*.stride + @intCast(usize, x)] & 0x00FFFFFF == 0 { total += 1 }
            }
            x += 1
        }
        r += 1
    }
    return total
}

// How many window pixels of the frame are black within `reach` of the
// one that shows image pixel (x, y): marks (dashes, ants) on a picture
// that has no black there.
fn darkNear(app: *App, x: i32, y: i32, reach: i32) -> usize {
    const frame = script.frameOf(app).?
    const doc = api.document(app).?
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(&doc.*.view, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &wx, &wy)
    const cx = @intFromFloat(i32, @floor(wx))
    const cy = @intFromFloat(i32, @floor(wy))
    var total: usize = 0
    var j = cy - reach
    while j <= cy + reach {
        var i = cx - reach
        while i <= cx + reach {
            if i >= 0 && j >= 0 && @intCast(usize, i) < frame.*.width && @intCast(usize, j) < frame.*.height {
                if frame.*.pixels[@intCast(usize, j) * frame.*.stride + @intCast(usize, i)] & 0x00FFFFFF == 0 { total += 1 }
            }
            i += 1
        }
        j += 1
    }
    return total
}

// The ellipse, the polygon, the freehand outline.
fn outlines(app: *App) -> u8 {
    const image = api.image(app).?
    // A circle of 100 around (200, 150), hard edged.
    if !step(app, "tool selectellipse") || app.*.tool != select.ELLIPSE { return 71 }
    options(app, select.ELLIPSE).*.antialias = false
    // (A drag from inside the selection would move it: it goes first.)
    if !click(app, 390, 290) || image.*.selected { return 72 }
    remember(app)
    var done = steps(app)
    if !drag(app, 100, 50, 300, 250) { return 72 }
    const disc = counted(app)
    if disc < 31100 || disc > 31730 { return 73 }
    if amount(app, 200, 150) != 255 || amount(app, 200, 51) != 255 || amount(app, 200, 49) != 0 || amount(app, 101, 51) != 0 || amount(app, 299, 150) != 255 { return 74 }
    var failed = checked(74, oneStep(app, done, "Select"))
    if failed != 0 { return failed }

    // A triangle by three clicks and Enter: 15000 pixels.
    if !step(app, "tool selectpolygon") || app.*.tool != select.POLYGON { return 80 }
    options(app, select.POLYGON).*.antialias = false
    remember(app)
    done = steps(app)
    if !click(app, 50, 50) || !click(app, 250, 50) || !api.toolBusy(app) { return 81 }
    // Backspace takes the second corner back; it is put again.
    // (After a pause: at once on the same place it would be a double
    // click, which closes.)
    if !step(app, "key Backspace\nwait 500") || !api.toolBusy(app) || !click(app, 250, 50) || !click(app, 150, 200) || !pointer(app, 120, 230) { return 82 }
    // The line to the pointer shows while the corners are placed, and
    // goes with them.
    if !shot(app, "select-polygon.png") || steps(app) != done || darkNear(app, 135, 215, 3) == 0 { return 83 }
    if !step(app, "key Enter") || api.toolBusy(app) || darkNear(app, 135, 215, 3) != 0 { return 84 }
    const triangle = counted(app)
    if triangle < 14850 || triangle > 15150 || amount(app, 150, 100) != 255 || amount(app, 60, 190) != 0 || amount(app, 150, 210) != 0 { return 85 }
    failed = checked(85, oneStep(app, done, "Select"))
    if failed != 0 { return failed }

    // Another closed by a double click, added with Shift: 20-79 x 230-289
    // joins (a square drawn by three corners and the fourth clicked
    // twice).
    remember(app)
    done = steps(app)
    if !step(app, "down Shift") || !click(app, 20, 230) || !click(app, 80, 230) || !click(app, 80, 290) || !click(app, 20, 290) || !click(app, 20, 290) || !step(app, "up Shift") { return 91 }
    if api.toolBusy(app) || amount(app, 50, 260) != 255 || amount(app, 150, 100) != 255 || amount(app, 100, 260) != 0 { return 92 }
    failed = checked(92, oneStep(app, done, "Add to Selection"))
    if failed != 0 { return failed }

    // Freehand: round a square of 50-250 x 50-250, letting go near the
    // start: 40000 pixels.
    if !step(app, "tool selectfreehand") || app.*.tool != select.FREEHAND { return 98 }
    options(app, select.FREEHAND).*.antialias = false
    remember(app)
    done = steps(app)
    if !pointer(app, 50, 50) || !step(app, "press") || !pointer(app, 150, 50) || !pointer(app, 250, 50) || !pointer(app, 250, 150) || !pointer(app, 250, 250) || !pointer(app, 150, 250) || !pointer(app, 50, 250) || !pointer(app, 50, 150) || !pointer(app, 50, 52) || !step(app, "release") { return 99 }
    const square = counted(app)
    if square < 39700 || square > 40300 || amount(app, 150, 150) != 255 || amount(app, 40, 150) != 0 || amount(app, 260, 150) != 0 { return 100 }
    failed = checked(100, oneStep(app, done, "Select"))
    if failed != 0 { return failed }
    if !image.*.selected { return 106 }
    return 0
}

// The wand and the similar colour selection.
fn colors(app: *App) -> u8 {
    const image = api.image(app).?
    // A red square on the white background (the layer below the active
    // one), another one far from it.
    const ground = node_module.childAt(image.*.root, 0)
    if !device.fill(ground.*.device.?, geom.rect(60, 60, 50, 40), 0xFFFF0000) || !device.fill(ground.*.device.?, geom.rect(250, 180, 40, 40), 0xFFFF0000) { return 107 }
    image_module.damageAll(image)
    if !step(app, "tool selectcontiguous") || app.*.tool != select.CONTIGUOUS { return 108 }
    const wand = options(app, select.CONTIGUOUS)
    wand.*.threshold = 0
    wand.*.sample = select.SAMPLE_IMAGE
    remember(app)
    var done = steps(app)
    var into = geom.empty()
    if !click(app, 80, 80) || !selection.isRectangle(image.*.selection, &into) || !geom.same(into, geom.rect(60, 60, 50, 40)) { return 109 }
    var failed = checked(109, oneStep(app, done, "Select"))
    if failed != 0 { return failed }

    // Sampling the active layer (empty: one transparent region) takes all
    // of the image; with a blue square on it, all but that.
    wand.*.sample = select.SAMPLE_LAYER
    if !click(app, 80, 80) || !selection.isRectangle(image.*.selection, &into) || !geom.same(into, image_module.bounds(image)) { return 115 }
    if !device.fill(api.activeNode(app).?.*.device.?, geom.rect(200, 100, 30, 30), 0xFF0000FF) { return 116 }
    image_module.damageAll(image)
    if !click(app, 80, 80) || amount(app, 80, 80) != 255 || amount(app, 210, 110) != 0 || amount(app, 199, 110) != 255 || counted(app) != 120000 - 900 { return 117 }
    // Two red pixels that touch at a corner: one pixel, or both with
    // diagonal neighbours. A click outside the image deselects.
    if !device.fill(ground.*.device.?, geom.rect(330, 20, 1, 1), 0xFFFF0000) || !device.fill(ground.*.device.?, geom.rect(331, 21, 1, 1), 0xFFFF0000) { return 118 }
    image_module.damageAll(image)
    wand.*.sample = select.SAMPLE_IMAGE
    if !click(app, 330, 20) || counted(app) != 1 || amount(app, 330, 20) != 255 { return 184 }
    wand.*.diagonal = true
    if !click(app, 330, 20) || counted(app) != 2 || amount(app, 331, 21) != 255 { return 185 }
    wand.*.diagonal = false
    if !click(app, 420, 150) || image.*.selected { return 186 }

    // Similar: both red squares and the two red pixels, and nothing else.
    if !step(app, "tool selectsimilar") || app.*.tool != select.SIMILAR { return 119 }
    const similar = options(app, select.SIMILAR)
    similar.*.threshold = 0
    similar.*.sample = select.SAMPLE_IMAGE
    remember(app)
    done = steps(app)
    if !click(app, 70, 70) { return 120 }
    if amount(app, 260, 190) != 255 || amount(app, 70, 70) != 255 || amount(app, 150, 150) != 0 || amount(app, 210, 110) != 0 || counted(app) != 2000 + 1600 + 2 { return 121 }
    failed = checked(121, oneStep(app, done, "Select"))
    if failed != 0 { return failed }
    return 0
}

// The bezier outline and moving the selection.
fn curves(app: *App) -> u8 {
    const image = api.image(app).?
    if !step(app, "tool selectbezier") || app.*.tool != select.BEZIER { return 127 }
    options(app, select.BEZIER).*.antialias = false
    remember(app)
    var done = steps(app)
    // A at (100, 50); B at (250, 150), its handle pulled out to the right
    // (300, 150); C at (100, 250); Enter closes back to A.
    if !click(app, 100, 50) || !drag(app, 250, 150, 300, 150) || !click(app, 100, 250) || !api.toolBusy(app) { return 128 }
    if !step(app, "key Enter") || api.toolBusy(app) { return 129 }
    // (220, 180) is outside the straight triangle, inside the bulge.
    if amount(app, 150, 150) != 255 || amount(app, 220, 180) != 255 || amount(app, 270, 150) != 0 || amount(app, 90, 150) != 0 { return 130 }
    var failed = checked(130, oneStep(app, done, "Select"))
    if failed != 0 { return failed }
    // A click on the first anchor closes too (and replaces).
    done = steps(app)
    if !click(app, 20, 20) || !click(app, 120, 20) || !drag(app, 120, 120, 120, 160) || !click(app, 20, 20) || api.toolBusy(app) { return 136 }
    if steps(app) != done + 1 || amount(app, 80, 60) != 255 || amount(app, 150, 150) != 0 { return 137 }

    // Moving: a rectangle 50-149 x 40-119 dragged from inside by (30, 20).
    if !step(app, "tool selectrect") || !click(app, 390, 290) || image.*.selected || !drag(app, 50, 40, 150, 120) { return 138 }
    remember(app)
    done = steps(app)
    var into = geom.empty()
    if !drag(app, 100, 80, 130, 100) || !selection.isRectangle(image.*.selection, &into) || !geom.same(into, geom.rect(80, 60, 100, 80)) { return 139 }
    failed = checked(139, oneStep(app, done, "Move Selection"))
    if failed != 0 { return failed }
    // Escape while moving puts it back.
    remember(app)
    done = steps(app)
    if !pointer(app, 120, 100) || !step(app, "press") || !pointer(app, 140, 120) || !pointer(app, 160, 140) { return 145 }
    if !selection.isRectangle(image.*.selection, &into) || !geom.same(into, geom.rect(120, 100, 100, 80)) { return 146 }
    if !step(app, "key Escape\nrelease") || steps(app) != done || !sameAs(app, before, beforeSelected) { return 147 }
    // Moved partly out of the image: what is outside is cut.
    if !drag(app, 120, 100, 400, 280) || !selection.isRectangle(image.*.selection, &into) || !geom.same(into, geom.rect(360, 240, 40, 60)) { return 148 }
    // A click inside deselects.
    remember(app)
    done = steps(app)
    if !click(app, 380, 260) || image.*.selected { return 149 }
    failed = checked(149, oneStep(app, done, "Deselect"))
    if failed != 0 { return failed }
    return 0
}

// The magnetic outline round a black disc of radius 50 on white, its four
// anchors clicked a little off the rim.
fn magnetic(app: *App) -> u8 {
    if !step(app, "new 300 220 FFFFFF") { return 155 }
    const image = api.image(app).?
    const path = raster.create(std.heap.allocator()).?
    raster.circle(path, 150.0, 110.0, 50.0)
    const ground = node_module.childAt(image.*.root, 0)
    _ = raster.fillDevice(ground.*.device.?, path, raster.NONZERO, false, image_module.bounds(image), 0xFF000000, blend.NORMAL, 255, 0, null)
    raster.destroy(path)
    image_module.damageAll(image)
    if !step(app, "tool selectmagnetic") || app.*.tool != select.MAGNETIC { return 156 }
    const magnetic_options = options(app, select.MAGNETIC)
    magnetic_options.*.antialias = false
    if magnetic_options.*.sample != select.SAMPLE_IMAGE { return 157 }
    if !click(app, 150, 57) || !click(app, 204, 108) || !click(app, 152, 163) || !pointer(app, 100, 120) || !shot(app, "select-magnetic.png") { return 158 }
    // Backspace takes the third anchor back; it is set again.
    if !step(app, "key Backspace\nwait 500") || !click(app, 152, 163) || !click(app, 96, 111) || !api.toolBusy(app) || steps(app) != 0 { return 159 }
    if !step(app, "key Enter") || api.toolBusy(app) || steps(app) != 1 || !lastName(app, "Select") { return 160 }
    // Inside the disc and outside the diamond of the anchors: selected;
    // just outside the disc: not.
    if amount(app, 150, 110) != 255 || amount(app, 182, 78) != 255 || amount(app, 118, 142) != 255 || amount(app, 187, 73) != 0 || amount(app, 150, 58) != 0 { return 161 }
    const disc = counted(app)
    if disc < 7700 || disc > 8000 { return 162 }
    if !step(app, "key Ctrl+Z") || image.*.selected { return 163 }
    return 0
}

// The options panel of every tool, at 1024 x 768, in the dark and the
// light theme; the mode buttons; the settings.
fn panel(app: *App, canvas: *canvas_module.Canvas, light: bool) -> u8 {
    app.*.theme = theme_module.scaled(if light { theme_module.light() } else { theme_module.dark() }, 1)
    const widgets = state.uiOf(app)
    const kit = api.kit(app)
    const kept_tool = app.*.tool
    view.begin(widgets, canvas)
    kit_module.resize(kit, 1024, 768)
    kit_module.begin(kit, widgets, canvas, state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app), 0, app.*.german)
    canvas_module.clear(canvas, app.*.theme.background)
    var id: u8 = select.RECTANGLE
    while id <= select.MAGNETIC {
        const index = @intCast(i32, id - select.RECTANGLE)
        const area = ui.rect(16 + (index % 4) * 252, 16 + (index / 4) * 376, 236, 344)
        canvas_module.fillRect(canvas, area.x - 8, area.y - 8, area.width + 16, area.height + 16, app.*.theme.panel)
        app.*.tool = id
        const tool = tools.find(id).?
        const used = tool.*.options.?(app, area)
        if used < 100 || used > 320 { return 165 }
        id += 1
    }
    app.*.tool = kept_tool
    _ = kit_module.end(kit)
    _ = view.end(widgets)
    return 0
}

fn savePicture(canvas: *canvas_module.Canvas, name: []const u8) -> bool {
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    if !png.saveFile(std.text.zeroTerminated(bytes, 600, name), canvas.*.pixels, canvas.*.width, canvas.*.height, canvas.*.stride, false, std.heap.allocator()) { return false }
    if shotsLength == 0 { return true }
    var with: [600]u8 = undefined
    const other: [*]u8 = &with
    const total = std.text.append(other, std.text.append(other, std.text.append(other, 0, 600, shots[0..shotsLength]), 600, "/"), 600, name)
    return png.saveFile(std.text.zeroTerminated(bytes, 600, other[0..total]), canvas.*.pixels, canvas.*.width, canvas.*.height, canvas.*.stride, false, std.heap.allocator())
}

// One tool's panel alone in a frame of the window's size.
fn panelFrame(app: *App, canvas: *canvas_module.Canvas) -> i32 {
    const widgets = state.uiOf(app)
    const kit = api.kit(app)
    view.begin(widgets, canvas)
    kit_module.resize(kit, 1024, 768)
    kit_module.begin(kit, widgets, canvas, state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app), 0, app.*.german)
    const used = api.tool(app).?.*.options.?(app, ui.rect(780, 120, 236, 344))
    _ = kit_module.end(kit)
    _ = view.end(widgets)
    return used
}

fn panels(app: *App, canvas: *canvas_module.Canvas) -> u8 {
    const kept_theme = app.*.theme
    var failed = panel(app, canvas, false)
    if failed != 0 { return failed }
    if !savePicture(canvas, "select-options-dark.png") { return 166 }
    failed = panel(app, canvas, true)
    if failed != 0 { return 178 }
    if !savePicture(canvas, "select-options-light.png") { return 167 }
    app.*.german = true
    failed = panel(app, canvas, false)
    app.*.german = false
    if failed != 0 { return 179 }
    if !savePicture(canvas, "select-options-german.png") { return 168 }
    app.*.theme = kept_theme

    // The rectangle's Add button: pressed and let go on it, the next
    // frame takes the click; the settings keep it.
    if !step(app, "tool selectrect") { return 169 }
    const widgets = state.uiOf(app)
    _ = panelFrame(app, canvas)
    const button = view.areaOf(widgets, select.modeButton(selection.ADD))
    if button.width <= 0 || button.x < 780 { return 170 }
    _ = view.pointerMove(widgets, button.x + button.width / 2, button.y + button.height / 2)
    _ = view.pointerButton(widgets, true)
    _ = view.pointerButton(widgets, false)
    _ = panelFrame(app, canvas)
    if options(app, select.RECTANGLE).*.mode != selection.ADD { return 171 }
    if !std.text.contains(settings.text(app, "tool.selectrect"), "mode=1") { return 172 }
    // A drag without a key now adds.
    const image = api.image(app).?
    if !drag(app, 10, 10, 30, 30) || !drag(app, 50, 10, 70, 30) || amount(app, 20, 20) != 255 || amount(app, 60, 20) != 255 { return 173 }
    if !lastName(app, "Add to Selection") { return 174 }
    options(app, select.RECTANGLE).*.mode = selection.REPLACE
    select.keepOptions(app, select.RECTANGLE)
    if !std.text.contains(settings.text(app, "tool.selectrect"), "mode=0") { return 175 }
    // Ranges are held.
    options(app, select.CONTIGUOUS).*.threshold = 999
    select.keepOptions(app, select.CONTIGUOUS)
    if options(app, select.CONTIGUOUS).*.threshold != 255 || !std.text.contains(settings.text(app, "tool.selectcontiguous"), "threshold=255") { return 176 }
    if !image.*.selected { return 177 }
    return 0
}

// The edge search and the outline's marks many times over: the value
// arena does not grow. The tool's functions are called as the program
// calls them.
fn arena(app: *App) -> u8 {
    const tool = tools.find(select.MAGNETIC).?
    if app.*.tool != select.MAGNETIC { return 180 }
    var input: state.Input = undefined
    input.pressure = 1.0
    input.tiltX = 0.0
    input.tiltY = 0.0
    input.rotation = 0.0
    input.time = 0.0
    input.button = ui_app.BUTTON_LEFT
    input.buttons = state.BUTTONS_LEFT
    input.modifiers = 0
    input.clicks = 1
    const frame = script.frameOf(app).?
    const base = turns.locate()
    const start = turns.used(base)
    var round: usize = 0
    while round < 40 {
        input.x = 150.5
        input.y = 57.5
        input.windowX = 100
        input.windowY = 100
        tool.*.press.?(app, &input)
        tool.*.release.?(app, &input)
        input.x = 204.5
        input.y = 108.5
        input.windowX = 300
        input.windowY = 300
        tool.*.press.?(app, &input)
        tool.*.release.?(app, &input)
        input.x = 120.5
        input.y = 170.5
        input.windowX = 200
        input.windowY = 400
        input.button = 0
        tool.*.move.?(app, &input)
        input.button = ui_app.BUTTON_LEFT
        tool.*.overlay.?(app, frame)
        if !tool.*.busy.?(app) { return 181 }
        tool.*.cancel.?(app)
        round += 1
    }
    const grown = turns.used(base) - start
    if grown > 65536 { return 182 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const folder = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if folder != null && folder.?.length > 0 && folder.?.length < 400 {
        var index: usize = 0
        while index < folder.?.length {
            shots[index] = folder.?.pointer[index]
            index += 1
        }
        shotsLength = folder.?.length
        while shotsLength > 1 && shots[shotsLength - 1] == 47 { shotsLength -= 1 }
    }
    const pictures = allocator.alloc(MOST_PIXELS * 3, 16)
    if pictures == null { return 1 }
    before = @intFromPtr(pictures.?)
    after = before + MOST_PIXELS
    now = after + MOST_PIXELS
    const made = script.headless(allocator)
    if made == null { return 2 }
    const app = made.?
    if !script.run(app, "size 1024 768\nnew 400 300 FFFFFF\n") { return 3 }
    const doc = api.document(app).?
    if doc.*.view.zoom != 1.0 || app.*.count != 1 { return 4 }

    // The eight tools are there, in the selection group, with their keys.
    var id: u8 = select.RECTANGLE
    while id <= select.MAGNETIC {
        const tool = tools.find(id)
        if tool == null || tool.?.*.group != state.GROUP_SELECT || tool.?.*.options == null || tool.?.*.overlay == null { return 5 }
        id += 1
    }
    if tools.byKey("selectrect").?.*.id != select.RECTANGLE || tools.byKey("selectmagnetic").?.*.id != select.MAGNETIC { return 6 }
    // Their shortcuts: Ctrl+R and J.
    if !step(app, "key J") || app.*.tool != select.ELLIPSE || !step(app, "key Ctrl+R") || app.*.tool != select.RECTANGLE { return 7 }
    if options(app, select.RECTANGLE).*.mode != selection.REPLACE || options(app, select.MAGNETIC).*.sample != select.SAMPLE_IMAGE { return 8 }

    var failed = rectangles(app)
    if failed != 0 { return failed }
    failed = outlines(app)
    if failed != 0 { return failed }
    failed = colors(app)
    if failed != 0 { return failed }
    failed = curves(app)
    if failed != 0 { return failed }
    // The pictures of a selection: a wand's square and a feathered circle
    // added, the ants marching round both.
    options(app, select.CONTIGUOUS).*.sample = select.SAMPLE_IMAGE
    if !step(app, "tool selectcontiguous") || !click(app, 80, 80) || !step(app, "tool selectellipse") { return 9 }
    options(app, select.ELLIPSE).*.feather = 6
    if !step(app, "down Shift") || !drag(app, 180, 120, 300, 240) || !step(app, "up Shift") || !shot(app, "select.png") { return 10 }
    // The ants on the red square's edge, nothing black inside it.
    if darkNear(app, 85, 60, 4) == 0 || darkNear(app, 85, 80, 4) != 0 { return 15 }
    options(app, select.ELLIPSE).*.feather = 0
    if !step(app, "german") || !lastName(app, "Add to Selection") { return 11 }
    if !drag(app, 10, 10, 50, 50) || !lastName(app, "Ausw\xC3\xA4hlen") { return 12 }
    app.*.german = false
    failed = magnetic(app)
    if failed != 0 { return failed }
    failed = arena(app)
    if failed != 0 { return failed }
    failed = panels(app, script.frameOf(app).?)
    if failed != 0 { return failed }
    if !std.fs.exists("select.png\x00".pointer) || !std.fs.exists("select-options-dark.png\x00".pointer) { return 14 }
    return 13
}
