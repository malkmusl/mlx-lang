// The Layers docker (dockers/layers.mlx), played without a window as a
// person would, in a window of 1024 x 768 with the docker in the right
// dock: nothing to show without an image; a new image's two layers
// listed topmost first with their names; a click makes the lower one
// active; its eye hides it (the image shows it no more) as one step that
// undo takes back; a double click on a name renames it in place (typed,
// Enter: one step; Escape: nothing), one beside the name opens the
// properties; the new layer button adds a layer above the active one and
// makes it active; delete removes it, undo brings it back; the top row
// dragged below the bottom one changes the order in one step, a drag let
// go where it began or beside the list changes nothing; a group from the
// kinds' list, a layer dragged into it (indented under it), the group
// folded (the active layer in it gives way to the group) and unfolded; a
// clone of the group beside it; pass-through and inherit alpha by their
// toggles and off by their marks; a layer raised out of its group by
// Page Up; a layer filled red shows red in its row's picture, a group's
// picture what its layers show, a mask of everything white, the
// pictures are not made again frame after frame and at most a few in one
// frame; the opacity slider followed by the image while it is dragged
// and one step of half the opacity when let go; the blend mode chosen
// from its list by typing; alpha lock and lock by their toggles; the
// right button's menu on a row (entries of actions that are not there
// dim) and below the rows (nothing of a node's), a layer duplicated and
// a mask made from it; the keys over the docker (Up, Down, Page Up, Page
// Down, Delete, F2, Escape, Insert); a narrow docker (the names keep
// their room); 120 layers listed with regions for the rows in view only,
// scrolled by End, Home and the scroll bar; no growth of the value arena
// or the heap and no picture made over 300 frames; everything the docker
// draws opaque, dark and light; pictures of images of one pixel and of
// one row. Pictures: layers-default.png (the dock as it starts, 1024 x
// 768), layers-1280.png, layers.png, layers-drag.png (a row being
// dragged), layers-menu.png, layers-narrow.png, layers-many.png,
// layers-light.png, layers-german.png, in the current directory and,
// when NEBULA_SHOTS names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const docs_module = @import("../app/documents.mlx")
const loop = @import("../app/loop.mlx")
const docks = @import("../ui/docks.mlx")
const menus = @import("../ui/menus.mlx")
const kit_module = @import("../ui/kit.mlx")
const layers = @import("../dockers/layers.mlx")
const actions = @import("../actions/registry.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const render = @import("../core/render.mlx")
const ops = @import("../core/ops.mlx")
const blend = @import("../core/blend.mlx")

const App = state.App
const Node = node_module.Node

// The docker alone in the right dock, all of its height.
const LAYOUT = "area left 280\narea right 280\npanel 1000 0 open layers history overview\n"

// A script being put together.
var buffer: [1024]u8 = undefined
var used: usize = 0
// Where the pictures go besides the current directory (NEBULA_SHOTS).
var shotsAt: usize = 0
var shotsLength: usize = 0

fn start() -> void { used = 0 }
fn add(text: []const u8) -> void { used = std.text.append(&buffer, used, 1024, text) }
fn addNumber(value: i32) -> void { used = std.text.appendSigned(&buffer, used, 1024, @intCast(isize, value)) }

fn play(app: *App) -> bool {
    const bytes: [*]const u8 = &buffer
    return script.run(app, bytes[0..used])
}

fn point(app: *App, command: []const u8, x: i32, y: i32) -> bool {
    start()
    add(command)
    add(" ")
    addNumber(x)
    add(" ")
    addNumber(y)
    add("\n")
    return play(app)
}

fn middleX(area: ui.Rect) -> i32 { return area.x + area.width / 2 }
fn middleY(area: ui.Rect) -> i32 { return area.y + area.height / 2 }

fn clickIn(app: *App, area: ui.Rect) -> bool {
    if ui.isEmpty(area) { return false }
    return point(app, "click", middleX(area), middleY(area))
}

fn rightClickIn(app: *App, area: ui.Rect) -> bool {
    if ui.isEmpty(area) { return false }
    if !point(app, "pointer", middleX(area), middleY(area)) { return false }
    return script.run(app, "press right\nrelease right\n")
}

fn dragFrom(app: *App, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    start()
    add("drag ")
    addNumber(x0)
    add(" ")
    addNumber(y0)
    add(" ")
    addNumber(x1)
    add(" ")
    addNumber(y1)
    add(" 12\n")
    return play(app)
}

fn key(app: *App, name: []const u8) -> bool {
    start()
    add("key ")
    add(name)
    add("\n")
    return play(app)
}

// A frame drawn (as the window would when something asks for one).
fn frame(app: *App) -> bool {
    api.redraw(app)
    return script.run(app, "wait 1\n")
}

fn imageOf(app: *App) -> *image_module.Image { return api.image(app).? }

fn find(app: *App, id: u32) -> ?*Node { return image_module.find(imageOf(app), id) }

fn steps(app: *App) -> usize { return history.stepsDone(imageOf(app).*.history) }

fn rootCount(app: *App) -> usize { return node_module.childCount(imageOf(app).*.root) }

fn activeId(app: *App) -> u32 {
    const node = api.activeNode(app)
    if node == null { return 0 }
    return node.?.*.id
}

fn partArea(app: *App, part: usize) -> ui.Rect { return view.areaOf(state.uiOf(app), layers.partId(part)) }

fn idArea(app: *App, id: u64) -> ui.Rect { return view.areaOf(state.uiOf(app), id) }

// The pixel the image shows at (x, y).
fn shown(app: *App, x: i32, y: i32) -> u32 {
    const image = imageOf(app)
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

// The window's pixel at (x, y) in the last frame.
fn windowAt(app: *App, x: i32, y: i32) -> u32 {
    const canvas = script.frameOf(app).?
    return canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)]
}

fn inside(part: ui.Rect, whole: ui.Rect) -> bool {
    return part.x >= whole.x && part.y >= whole.y && ui.right(part) <= ui.right(whole) && ui.bottom(part) <= ui.bottom(whole)
}

// Whether anything is drawn in `area` of the last frame besides the
// colour of its right edge's middle (a name's letters on its row).
fn inked(app: *App, area: ui.Rect) -> bool {
    if ui.isEmpty(area) { return false }
    const ground = windowAt(app, ui.right(area) - 1, middleY(area))
    var y = area.y + 2
    while y < ui.bottom(area) - 2 {
        var x = area.x
        while x < ui.right(area) {
            if windowAt(app, x, y) != ground { return true }
            x += 1
        }
        y += 1
    }
    return false
}

// Whether every pixel of `area` in the last frame is opaque.
fn opaque(app: *App, area: ui.Rect) -> bool {
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            if windowAt(app, x, y) >> 24 != 255 { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// The open menu's row called `name` (null: none).
fn menuRow(app: *App, name: []const u8) -> ?usize {
    var index: usize = 0
    while index < menus.rowCount(app, 0) {
        if std.text.same(menus.rowName(app, 0, index), name) { return index }
        index += 1
    }
    return null
}

fn chooseInMenu(app: *App, name: []const u8) -> bool {
    const row = menuRow(app, name)
    if row == null { return false }
    return clickIn(app, menus.rowArea(app, 0, row.?))
}

// The frame as a picture here and in the shots' directory.
fn save(app: *App, name: []const u8) -> bool {
    start()
    add("shot ")
    add(name)
    add("\n")
    if !play(app) { return false }
    if shotsLength == 0 || shotsLength > 400 { return true }
    const shots = unsafe { @ptrFromInt([*]const u8, shotsAt) }[0..shotsLength]
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, shots)
    if bytes[length - 1] != '/' { length = std.text.appendByte(bytes, length, 599, '/') }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    const canvas = script.frameOf(app).?
    return png.saveFile(bytes, canvas.*.pixels, canvas.*.width, canvas.*.height, canvas.*.stride, false, app.*.allocator)
}

// Frames one after another, the value arena given back before each as a
// window's loop does: each takes what the one before took, the heap
// holds what it held after the first few, and no picture is made.
fn steady(app: *App) -> u8 {
    const canvas = script.frameOf(app).?
    var loop_turns: turns.Turns = undefined
    turns.begin(&loop_turns, true, false)
    const arena = loop_turns.base
    const mark = turns.used(arena)
    var first: usize = 0
    var live: usize = 0
    var made: u64 = 0
    var round: usize = 0
    while round < 300 {
        turns.turn(&loop_turns)
        app.*.shell.*.clock += 16
        api.redraw(app)
        loop.frame(app, canvas)
        const now = turns.used(arena) - mark
        if round == 4 {
            first = now
            live = std.heap.liveBytes()
            made = layers.thumbnailsMade(app)
        }
        if round > 4 {
            const off = if now > first { now - first } else { first - now }
            if off != 0 || now > 1048576 { return 1 }
            if std.heap.liveBytes() != live { return 2 }
            if layers.thumbnailsMade(app) != made { return 3 }
        }
        round += 1
    }
    turns.turn(&loop_turns)
    if turns.used(arena) != mark { return 4 }
    return 0
}

// The first checks: the list of a new image, choosing, the eye, renaming.
fn basics(app: *App) -> u8 {
    const content = docks.contentOf(app, layers.ID)
    if content.width < 200 || content.height < 400 { return 1 }
    // Two layers, the topmost ("Layer 1", 3) above the background (2).
    if layers.rowCount(app) != 2 || layers.rowNode(app, 0) != 3 || layers.rowNode(app, 1) != 2 { return 2 }
    const top = layers.rowArea(app, 3)
    const bottom = layers.rowArea(app, 2)
    if ui.isEmpty(top) || ui.isEmpty(bottom) || top.y >= bottom.y || !inside(top, content) || !inside(bottom, content) { return 3 }
    if top.height < 24 || top.height > 26 { return 4 }
    if app.*.small.loaded && (!inked(app, layers.nameArea(app, 3)) || !inked(app, layers.nameArea(app, 2))) { return 5 }
    if activeId(app) != 3 { return 6 }
    // A click on the lower one makes it active, and is no step.
    if !clickIn(app, layers.nameArea(app, 2)) || activeId(app) != 2 || steps(app) != 0 { return 7 }
    // Its eye hides it: the image shows nothing there; one step, undone.
    if !clickIn(app, idArea(app, layers.eyeId(2))) { return 8 }
    if find(app, 2).?.*.visible || steps(app) != 1 || shown(app, 10, 10) != 0 { return 9 }
    if !key(app, "Ctrl+Z") || !find(app, 2).?.*.visible || shown(app, 10, 10) != 0xFFFFFFFF || steps(app) != 0 { return 10 }
    // A double click on the name: typed in place, Enter takes it.
    const name = layers.nameArea(app, 3)
    if !clickIn(app, name) || !clickIn(app, name) { return 11 }
    if layers.renaming(app) != 3 || !kit_module.editing(api.kit(app), layers.partId(layers.PART_RENAME)) { return 12 }
    if !script.run(app, "type Sky\nkey Enter\n") { return 13 }
    if !std.text.same(node_module.nameOf(find(app, 3).?), "Sky") || layers.renaming(app) != 0 || steps(app) != 1 { return 14 }
    // Escape leaves the name as it was.
    if !clickIn(app, name) || !clickIn(app, name) || layers.renaming(app) != 3 { return 15 }
    if !script.run(app, "type Cloud\nkey Escape\n") { return 16 }
    if !std.text.same(node_module.nameOf(find(app, 3).?), "Sky") || layers.renaming(app) != 0 || steps(app) != 1 { return 17 }
    return 0
}

// New, delete, undo, a row dragged, a group and folding.
fn tree(app: *App) -> u8 {
    // The new layer goes above the active one (Sky) and is active.
    if activeId(app) != 3 { return 1 }
    if !clickIn(app, partArea(app, layers.PART_NEW)) { return 2 }
    const fresh = api.activeNode(app)
    if fresh == null || fresh.?.*.id == 3 || fresh.?.*.id == 2 || rootCount(app) != 3 || steps(app) != 2 { return 3 }
    const fresh_id = fresh.?.*.id
    if node_module.indexIn(imageOf(app).*.root, fresh.?).? != 2 || !std.text.startsWith(node_module.nameOf(fresh.?), "Layer ") { return 4 }
    if layers.rowNode(app, 0) != fresh_id { return 5 }
    // Deleted, and back by undo.
    if !clickIn(app, partArea(app, layers.PART_DELETE)) { return 6 }
    if find(app, fresh_id) != null || rootCount(app) != 2 || steps(app) != 3 { return 7 }
    if !key(app, "Ctrl+Z") || find(app, fresh_id) == null || rootCount(app) != 3 { return 8 }
    // The top row dragged onto the lower part of the bottom one: below
    // it, one step.
    if !frame(app) { return 9 }
    const before = steps(app)
    const from = layers.nameArea(app, fresh_id)
    const onto = layers.rowArea(app, 2)
    if ui.isEmpty(from) || ui.isEmpty(onto) { return 10 }
    if !dragFrom(app, middleX(from), middleY(from), middleX(onto), onto.y + onto.height * 7 / 8) { return 11 }
    const root = imageOf(app).*.root
    if node_module.childAt(root, 0).*.id != fresh_id || node_module.childAt(root, 1).*.id != 2 || steps(app) != before + 1 { return 12 }
    if layers.rowNode(app, 2) != fresh_id || activeId(app) != fresh_id { return 13 }
    // A group from the list of kinds, made the active one.
    if !clickIn(app, partArea(app, layers.PART_KINDS)) || !menus.isOpen(app) { return 14 }
    if !chooseInMenu(app, state.tr(app, "Group", "Gruppe")) || menus.isOpen(app) { return 15 }
    const group = api.activeNode(app)
    if group == null || group.?.*.kind != node_module.GROUP { return 16 }
    const group_id = group.?.*.id
    // Sky dragged onto the middle of the group's row: into it.
    if !frame(app) { return 17 }
    const sky = layers.nameArea(app, 3)
    const group_row = layers.rowArea(app, group_id)
    if ui.isEmpty(sky) || ui.isEmpty(group_row) { return 18 }
    if !dragFrom(app, middleX(sky), middleY(sky), middleX(group_row), middleY(group_row)) { return 19 }
    if find(app, 3).?.*.parent == null || find(app, 3).?.*.parent.?.*.id != group_id { return 20 }
    if layers.nameArea(app, 3).x <= layers.nameArea(app, group_id).x || layers.rowArea(app, 3).y <= layers.rowArea(app, group_id).y { return 21 }
    // Folded: Sky is not listed; open again: it is.
    const listed = layers.rowCount(app)
    if !clickIn(app, idArea(app, layers.expanderId(group_id))) { return 22 }
    if !find(app, group_id).?.*.collapsed || layers.rowCount(app) != listed - 1 || !ui.isEmpty(layers.rowArea(app, 3)) { return 23 }
    if !clickIn(app, idArea(app, layers.expanderId(group_id))) { return 24 }
    if find(app, group_id).?.*.collapsed || layers.rowCount(app) != listed || ui.isEmpty(layers.rowArea(app, 3)) { return 25 }
    // Folding the group with Sky active: the group becomes the active one.
    if !clickIn(app, layers.nameArea(app, 3)) || activeId(app) != 3 { return 26 }
    if !clickIn(app, idArea(app, layers.expanderId(group_id))) || activeId(app) != group_id { return 27 }
    if !clickIn(app, idArea(app, layers.expanderId(group_id))) || find(app, group_id).?.*.collapsed { return 28 }
    // A clone of the group, beside it (above), not in it.
    if !clickIn(app, partArea(app, layers.PART_KINDS)) || !chooseInMenu(app, state.tr(app, "Clone Layer", "Klonebene")) { return 29 }
    const clone = api.activeNode(app)
    if clone == null || clone.?.*.kind != node_module.CLONE || clone.?.*.cloneOf != group_id || clone.?.*.parent == null || clone.?.*.parent.?.*.id != 1 { return 30 }
    const group_at = node_module.indexIn(root, find(app, group_id).?).?
    if node_module.indexIn(root, clone.?).? != group_at + 1 { return 31 }
    if !clickIn(app, partArea(app, layers.PART_DELETE)) || activeId(app) == clone.?.*.id { return 32 }
    // Pass-through: only for a group; its mark on the row takes it off.
    if !clickIn(app, layers.nameArea(app, group_id)) || !clickIn(app, partArea(app, layers.PART_PASS)) || !find(app, group_id).?.*.passThrough { return 33 }
    if !clickIn(app, idArea(app, layers.passMarkId(group_id))) || find(app, group_id).?.*.passThrough { return 34 }
    if !clickIn(app, layers.nameArea(app, 3)) || !ui.isEmpty(partArea(app, layers.PART_PASS)) { return 35 }
    if !clickIn(app, partArea(app, layers.PART_INHERIT)) || !find(app, 3).?.*.inheritAlpha { return 36 }
    if !clickIn(app, idArea(app, layers.inheritMarkId(3))) || find(app, 3).?.*.inheritAlpha { return 37 }
    // Raised past the group's top: out of it, above it; undone: back in.
    const list = idArea(app, layers.partId(layers.PART_WELL))
    if !point(app, "pointer", middleX(list), ui.bottom(list) - 4) { return 38 }
    if !key(app, "PageUp") || find(app, 3).?.*.parent.?.*.id != 1 { return 39 }
    if node_module.indexIn(root, find(app, 3).?).? != node_module.indexIn(root, find(app, group_id).?).? + 1 { return 40 }
    if !key(app, "Ctrl+Z") || find(app, 3).?.*.parent.?.*.id != group_id { return 41 }
    return 0
}

// The pictures, the opacity, the blend mode, the alpha lock.
fn properties(app: *App) -> u8 {
    // The background filled red: its row's picture is red.
    const image = imageOf(app)
    const ground = find(app, 2).?
    if !ops.beginPixels(image, ground) { return 1 }
    _ = device.fill(ground.*.device.?, image_module.bounds(image), 0xFFFF0000)
    _ = ops.endPixels(image, ground, "Fill")
    if !frame(app) { return 2 }
    const box = layers.thumbnailArea(app, 2)
    if ui.isEmpty(box) || windowAt(app, middleX(box), middleY(box)) != 0xFFFF0000 { return 3 }
    // The empty layer's picture is the grey squares of nothing.
    const sky_box = layers.thumbnailArea(app, 3)
    const grey = windowAt(app, middleX(sky_box), middleY(sky_box))
    if ui.isEmpty(sky_box) || (grey != 0xFFCCCCCC && grey != 0xFF999999) { return 4 }
    // A group's picture is what its layers show: Sky (in it) filled blue;
    // undone, the squares again.
    const sky = find(app, 3).?
    const group_id = sky.*.parent.?.*.id
    if !ops.beginPixels(image, sky) { return 20 }
    _ = device.fill(sky.*.device.?, image_module.bounds(image), 0xFF2060C0)
    _ = ops.endPixels(image, sky, "Fill")
    if !frame(app) { return 21 }
    const group_box = layers.thumbnailArea(app, group_id)
    if ui.isEmpty(group_box) || windowAt(app, middleX(group_box), middleY(group_box)) != 0xFF2060C0 || windowAt(app, middleX(sky_box), middleY(sky_box)) != 0xFF2060C0 { return 22 }
    if !key(app, "Ctrl+Z") || windowAt(app, middleX(group_box), middleY(group_box)) == 0xFF2060C0 { return 23 }
    // Frames that change nothing make no picture.
    const made = layers.thumbnailsMade(app)
    var round: usize = 0
    while round < 10 {
        if !frame(app) { return 5 }
        round += 1
    }
    if layers.thumbnailsMade(app) != made || made == 0 { return 6 }
    // The opacity dragged: the image follows at once, the step is made
    // when it is let go (half, one step).
    if !clickIn(app, layers.nameArea(app, 2)) || activeId(app) != 2 { return 7 }
    const before = steps(app)
    const bar = partArea(app, layers.PART_OPACITY)
    if ui.isEmpty(bar) || !point(app, "pointer", ui.right(bar) - 2, middleY(bar)) || !script.run(app, "press\n") { return 8 }
    if !point(app, "pointer", bar.x + bar.width / 4, middleY(bar)) { return 24 }
    const quarter = find(app, 2).?.*.opacity
    const quarter_alpha = shown(app, 10, 10) >> 24
    if quarter < 56 || quarter > 72 || quarter_alpha < 56 || quarter_alpha > 72 || steps(app) != before { return 25 }
    if !point(app, "pointer", bar.x + bar.width / 2, middleY(bar)) || !script.run(app, "release\n") { return 9 }
    const opacity = find(app, 2).?.*.opacity
    if opacity < 120 || opacity > 136 || steps(app) != before + 1 { return 10 }
    const alpha = shown(app, 10, 10) >> 24
    if alpha < 120 || alpha > 136 { return 11 }
    // The blend mode from its list: opened, a name typed, Enter.
    if !clickIn(app, partArea(app, layers.PART_BLEND)) || !kit_module.wantsKeys(api.kit(app)) { return 12 }
    if !script.run(app, "type multiply\nkey Enter\n") { return 13 }
    if find(app, 2).?.*.blend != blend.MULTIPLY || steps(app) != before + 2 { return 14 }
    // Alpha lock by its toggle; its mark on the row takes it off.
    if !clickIn(app, partArea(app, layers.PART_ALPHA_LOCK)) || !find(app, 2).?.*.alphaLocked || steps(app) != before + 3 { return 15 }
    if !clickIn(app, idArea(app, layers.alphaMarkId(2))) || find(app, 2).?.*.alphaLocked || steps(app) != before + 4 { return 16 }
    if !ui.isEmpty(idArea(app, layers.alphaMarkId(2))) { return 17 }
    // Locked: the lock's mark shows on the row.
    if !clickIn(app, partArea(app, layers.PART_LOCK)) || !find(app, 2).?.*.locked || ui.isEmpty(idArea(app, layers.lockMarkId(2))) { return 18 }
    if !clickIn(app, partArea(app, layers.PART_LOCK)) || find(app, 2).?.*.locked { return 19 }
    // A double click beside the name: the properties.
    const picture = layers.thumbnailArea(app, 2)
    if !clickIn(app, picture) || !clickIn(app, picture) || !api.dialogOpen(app) { return 26 }
    if !key(app, "Escape") || api.dialogOpen(app) || layers.renaming(app) != 0 { return 27 }
    // The right button below the rows: the menu of new layers, nothing of
    // a node's.
    const list = idArea(app, layers.partId(layers.PART_WELL))
    if !rightClickIn(app, ui.rect(list.x, ui.bottom(list) - 20, list.width, 16)) || !menus.isOpen(app) { return 28 }
    const rename = menuRow(app, "Rename")
    const paint = menuRow(app, "New Paint Layer")
    if rename == null || paint == null || menus.rowFlags(app, 0, rename.?) & menus.ROW_DISABLED == 0 || menus.rowFlags(app, 0, paint.?) & menus.ROW_DISABLED != 0 { return 29 }
    if !key(app, "Escape") || menus.isOpen(app) { return 30 }
    return 0
}

// The right button's menu, and the keys over the docker.
fn menuAndKeys(app: *App) -> u8 {
    if !rightClickIn(app, layers.nameArea(app, 2)) || !menus.isOpen(app) || activeId(app) != 2 { return 1 }
    if menus.rowCount(app, 0) < 18 { return 2 }
    if menuRow(app, "Rename") == null || menuRow(app, "Duplicate") == null || menuRow(app, "Delete") == null || menuRow(app, "New Group") == null || menuRow(app, "Transparency Mask") == null || menuRow(app, "Merge Down") == null || menuRow(app, "Properties…") == null { return 3 }
    const merge = menuRow(app, "Merge Down").?
    const disabled = menus.rowFlags(app, 0, merge) & menus.ROW_DISABLED != 0
    if actions.byKey("layer_merge_down") == null && !disabled { return 4 }
    if !save(app, "layers-menu.png") { return 5 }
    // Duplicate: one more node, above the background.
    const count = image_module.nodeCount(imageOf(app))
    if !chooseInMenu(app, "Duplicate") || menus.isOpen(app) || image_module.nodeCount(imageOf(app)) != count + 1 { return 6 }
    const copy = api.activeNode(app)
    if copy == null || copy.?.*.id == 2 { return 7 }
    const copy_id = copy.?.*.id
    // A transparency mask on the background, under it in the list.
    if !rightClickIn(app, layers.nameArea(app, 2)) || !chooseInMenu(app, "Transparency Mask") { return 8 }
    const mask = api.activeNode(app)
    if mask == null || mask.?.*.kind != node_module.TRANSPARENCY_MASK || mask.?.*.parent == null || mask.?.*.parent.?.*.id != 2 { return 9 }
    const mask_id = mask.?.*.id
    if !frame(app) { return 10 }
    const mask_row = layers.rowArea(app, mask_id)
    if ui.isEmpty(mask_row) || mask_row.y <= layers.rowArea(app, 2).y || layers.nameArea(app, mask_id).x <= layers.nameArea(app, 2).x { return 11 }
    if ui.isEmpty(idArea(app, layers.expanderId(2))) { return 12 }
    // A mask of everything: its picture is white.
    const box = layers.thumbnailArea(app, mask_id)
    if windowAt(app, middleX(box), middleY(box)) != 0xFFFFFFFF { return 13 }
    // Keys with the pointer over the list: Up and Down choose.
    const list = idArea(app, layers.partId(layers.PART_WELL))
    if ui.isEmpty(list) || !point(app, "pointer", middleX(list), ui.bottom(list) - 4) { return 14 }
    if !key(app, "Up") || activeId(app) != 2 { return 15 }
    if !key(app, "Down") || activeId(app) != mask_id { return 16 }
    // Page Up and Page Down move the background past the copy and back.
    if !key(app, "Up") || activeId(app) != 2 { return 17 }
    const root = imageOf(app).*.root
    const at = node_module.indexIn(root, find(app, 2).?).?
    if !key(app, "PageUp") || node_module.indexIn(root, find(app, 2).?).? != at + 1 { return 18 }
    if !key(app, "PageDown") || node_module.indexIn(root, find(app, 2).?).? != at { return 19 }
    // Delete removes the active node (the copy).
    if !key(app, "Up") || activeId(app) != copy_id { return 20 }
    const done = steps(app)
    if !key(app, "Delete") || find(app, copy_id) != null || steps(app) != done + 1 { return 21 }
    // F2 renames, Escape leaves it.
    if !key(app, "F2") || layers.renaming(app) != activeId(app) || activeId(app) == 0 { return 22 }
    if !key(app, "Escape") || layers.renaming(app) != 0 { return 23 }
    // Insert: a new paint layer.
    const nodes = image_module.nodeCount(imageOf(app))
    if !key(app, "Insert") || image_module.nodeCount(imageOf(app)) != nodes + 1 || api.activeNode(app).?.*.kind != node_module.PAINT { return 24 }
    return 0
}

// Many layers: only the rows in view take regions; End, Home and the
// scroll bar move the list.
fn many(app: *App) -> u8 {
    const image = imageOf(app)
    var made: usize = 0
    while made < 120 {
        if ops.newLayer(image, node_module.PAINT, "Many", "New layer") == null { return 1 }
        made += 1
    }
    // All pictures are old now: one frame makes a few of them, the next
    // frames the rest.
    const canvas = script.frameOf(app).?
    const before = layers.thumbnailsMade(app)
    api.redraw(app)
    loop.frame(app, canvas)
    const one = layers.thumbnailsMade(app) - before
    if one == 0 || one > 8 { return 12 }
    if !frame(app) { return 2 }
    const widgets = state.uiOf(app)
    if widgets.*.shownCount >= 2048 || widgets.*.shownCount > 700 { return 3 }
    if layers.rowCount(app) < 125 { return 4 }
    const list = idArea(app, layers.partId(layers.PART_WELL))
    if ui.isEmpty(list) || !point(app, "pointer", middleX(list), middleY(list)) { return 5 }
    if !key(app, "End") || layers.scrollOffset(app) <= 0 { return 6 }
    const last = layers.rowNode(app, layers.rowCount(app) - 1)
    if activeId(app) != last || ui.isEmpty(layers.rowArea(app, last)) { return 7 }
    if !save(app, "layers-many.png") { return 8 }
    if !key(app, "Home") || layers.scrollOffset(app) != 0 || activeId(app) != layers.rowNode(app, 0) { return 9 }
    // The bar at the list's right, dragged down.
    if !dragFrom(app, ui.right(list) - 4, list.y + 12, ui.right(list) - 4, ui.bottom(list) - 2) || layers.scrollOffset(app) <= 0 { return 10 }
    if widgets.*.shownCount >= 2048 { return 11 }
    return 0
}

// More rows in view than pictures are kept (a window 4000 pixels tall,
// over 150 rows): the frames settle and frames that change nothing make
// no picture, rather than the rows taking the pictures from each other.
fn tall(app: *App) -> u8 {
    const image = imageOf(app)
    var made: usize = 0
    while made < 30 {
        if ops.newLayer(image, node_module.PAINT, "Tall", "New layer") == null { return 1 }
        made += 1
    }
    if !script.run(app, "size 1024 4000\n") { return 2 }
    var rounds: usize = 0
    var still: usize = 0
    var last = layers.thumbnailsMade(app)
    while rounds < 80 && still < 3 {
        if !frame(app) { return 2 }
        const now = layers.thumbnailsMade(app)
        if now == last { still += 1 } else { still = 0 }
        last = now
        rounds += 1
    }
    // (Over 128 rows are in view.)
    if still < 3 || layers.rowCount(app) < 150 || ui.isEmpty(layers.rowArea(app, layers.rowNode(app, 140))) { return 3 }
    var round: usize = 0
    while round < 20 {
        if !frame(app) || layers.thumbnailsMade(app) != last { return 4 }
        round += 1
    }
    if state.uiOf(app).*.shownCount >= 2048 || !script.run(app, "size 1024 768\n") || !frame(app) { return 5 }
    return 0
}

// Pictures made again in every one of 400 frames (the last step undone
// and done again in turn): the value arena a frame takes stays the same
// (frames of the same kind alike: the status bar's note is "Undone" or
// "Redone"), and so does the heap.
fn churn(app: *App) -> u8 {
    const canvas = script.frameOf(app).?
    var loop_turns: turns.Turns = undefined
    turns.begin(&loop_turns, true, false)
    const arena = loop_turns.base
    const mark = turns.used(arena)
    var first_even: usize = 0
    var first_odd: usize = 0
    var live: usize = 0
    var made = layers.thumbnailsMade(app)
    var round: usize = 0
    while round < 400 {
        turns.turn(&loop_turns)
        app.*.shell.*.clock += 16
        if round % 2 == 0 { api.undo(app) } else { api.redo(app) }
        loop.frame(app, canvas)
        const now = turns.used(arena) - mark
        const made_now = layers.thumbnailsMade(app)
        if made_now == made { return 1 }
        made = made_now
        if round == 4 { first_even = now }
        if round == 5 {
            first_odd = now
            live = std.heap.liveBytes()
        }
        if round > 5 {
            if now != (if round % 2 == 0 { first_even } else { first_odd }) || now > 1048576 { return 2 }
            if std.heap.liveBytes() != live { return 3 }
        }
        round += 1
    }
    turns.turn(&loop_turns)
    if turns.used(arena) != mark { return 4 }
    return 0
}

// What a picture shows of channel `c` at alpha `a` over the grey `under`,
// worked out apart from the docker, in integers: the nearest whole of
// (c a + under (255 - a)) / 255.
fn over(c: u32, a: u32, under: u32) -> u32 { return (2 * (c * a + under * (255 - a)) + 255) / 510 }

fn debugHex(value: u32) -> void {
    _ = std.io.writeHex(std.io.stdout(), @intCast(usize, value))
    _ = std.io.print("\n")
}

fn greyOf(value: u32) -> u32 { return 0xFF000000 | (value << 16) | (value << 8) | value }

// The window's pixel at (tx, ty) of the part of node `id`'s picture box
// the image fills, which begins `top` rows into the box.
fn pictureAt(app: *App, id: u32, top: i32, tx: i32, ty: i32) -> u32 {
    const box = layers.thumbnailArea(app, id)
    return windowAt(app, box.x + tx, box.y + top + ty)
}

// Node `id`'s pixels changed by `fill` over `area` (after a clear when
// `clear`), one step, and a frame drawn.
fn repaint(app: *App, id: u32, area: ui.Rect, color: u32, clear: bool) -> bool {
    const image = imageOf(app)
    const node = find(app, id)
    if node == null || !ops.beginPixels(image, node.?) { return false }
    if clear { device.clear(node.?.*.device.?) }
    _ = device.fill(node.?.*.device.?, area, color)
    _ = ops.endPixels(image, node.?, "Fill")
    return frame(app)
}

// Pictures worked out by hand. An image of 128 x 64 has pictures of 30 x
// 15 (64 * 30 / 128), two rows down in a box of 30 x 20: its columns
// 0-14 cover x 0-63 (15 * 128 / 30 = 64), so a layer red left of the tile
// border at x = 64 and blue right of it shows red there and blue beyond;
// red at alpha 128 over the squares (4 pixels a side, light 204 first)
// is over(255, 128, 204) = 230 and over(0, 128, 204) = 102, over the dark
// 153 it is 204 and 76; alpha 0 is the squares alone; pixels only at
// negative places show nothing, moved by (100, 100) onto x and y 0-49
// they fill columns and rows 0-10 (11 * 128 / 30 = 46, 11 * 64 / 15 = 46)
// and not 12 on (12 * 128 / 30 = 51); a mask of nothing is black, of the
// left half white there; one column of 4000 is a column in the box's
// middle (column 14 of 30, with the frame's lines at 13 and 15).
fn exact(app: *App) -> u8 {
    if !script.run(app, "new 128 64 000000\n") || !frame(app) { return 1 }
    const image = imageOf(app)
    const box = layers.thumbnailArea(app, 2)
    if box.width != 30 || box.height != 20 || find(app, 2) == null { return 2 }
    if !repaint(app, 2, ui.rect(0, 0, 64, 64), 0xFFFF0000, true) || !repaint(app, 2, ui.rect(64, 0, 64, 64), 0xFF0000FF, false) { return 3 }
    var tx: i32 = 0
    while tx < 30 {
        const wanted: u32 = if tx < 15 { 0xFFFF0000 } else { 0xFF0000FF }
        if pictureAt(app, 2, 2, tx, 0) != wanted || pictureAt(app, 2, 2, tx, 14) != wanted { return 4 }
        tx += 1
    }
    // Above and below the fitted part: the frame's lines and the row.
    if pictureAt(app, 2, 2, 5, -1) == 0xFFFF0000 || pictureAt(app, 2, 2, 5, 15) == 0xFFFF0000 || pictureAt(app, 2, 2, 5, 16) == 0xFFFF0000 { return 5 }
    if !repaint(app, 2, image_module.bounds(image), 0x80FF0000, false) { return 6 }
    const light = 0xFF000000 | (over(255, 128, 204) << 16) | (over(0, 128, 204) << 8) | over(0, 128, 204)
    const dark = 0xFF000000 | (over(255, 128, 153) << 16) | (over(0, 128, 153) << 8) | over(0, 128, 153)
    if light != 0xFFE66666 || dark != 0xFFCC4C4C { return 7 }
    if pictureAt(app, 2, 2, 0, 0) != light || pictureAt(app, 2, 2, 4, 0) != dark || pictureAt(app, 2, 2, 4, 4) != light || pictureAt(app, 2, 2, 29, 14) != light || pictureAt(app, 2, 2, 27, 12) != dark { return 8 }
    if !repaint(app, 2, image_module.bounds(image), 0x00FF0000, false) { return 9 }
    if pictureAt(app, 2, 2, 0, 0) != greyOf(204) || pictureAt(app, 2, 2, 4, 0) != greyOf(153) { return 10 }
    if !repaint(app, 2, ui.rect(-100, -100, 50, 50), 0xFFFF0000, true) || pictureAt(app, 2, 2, 0, 0) != greyOf(204) || pictureAt(app, 2, 2, 10, 10) != greyOf(204) { return 11 }
    const ground = find(app, 2).?
    if !ops.beginPixels(image, ground) { return 12 }
    device.moveBy(ground.*.device.?, 100, 100)
    _ = ops.endPixels(image, ground, "Move")
    if !frame(app) || shown(app, 49, 49) != 0xFFFF0000 { return 13 }
    if pictureAt(app, 2, 2, 0, 0) != 0xFFFF0000 || pictureAt(app, 2, 2, 10, 10) != 0xFFFF0000 || pictureAt(app, 2, 2, 10, 0) != 0xFFFF0000 { return 14 }
    if pictureAt(app, 2, 2, 12, 0) != greyOf(153) || pictureAt(app, 2, 2, 0, 12) != greyOf(153) { return 15 }
    // Masks.
    const mask = ops.newMask(image, ground, node_module.TRANSPARENCY_MASK, "Mask", "New mask")
    if mask == null || !frame(app) { return 16 }
    const mask_id = mask.?.*.id
    if pictureAt(app, mask_id, 2, 7, 7) != 0xFFFFFFFF { return 17 }
    if !ops.beginPixels(image, mask.?) { return 18 }
    device.setDefault(mask.?.*.device.?, 0xFF000000)
    _ = ops.endPixels(image, mask.?, "Clear mask")
    if !frame(app) || pictureAt(app, mask_id, 2, 7, 7) != 0xFF000000 { return 19 }
    if !repaint(app, mask_id, ui.rect(0, 0, 64, 64), 0xFFFFFFFF, false) || pictureAt(app, mask_id, 2, 14, 7) != 0xFFFFFFFF || pictureAt(app, mask_id, 2, 15, 7) != 0xFF000000 { return 20 }
    // One column.
    if !script.run(app, "new 1 4000 FF20C040\n") || !frame(app) { return 21 }
    const column = layers.thumbnailArea(app, 2)
    const middle = middleY(column)
    if ui.isEmpty(column) || windowAt(app, column.x + 14, middle) != 0xFF20C040 || windowAt(app, column.x + 13, middle) == 0xFF20C040 || windowAt(app, column.x + 15, middle) == 0xFF20C040 { return 22 }
    return 0
}

// While a step of the history is open (as a tool keeps one), nothing the
// docker does changes the image: the keys, the buttons, the eyes, the
// opacity (not even offered); the status bar says why; a click still
// chooses. Once it is closed they work again.
fn guard(app: *App) -> u8 {
    if !script.run(app, "new 64 64 FFFFFF\n") || !frame(app) { return 1 }
    const image = imageOf(app)
    const nodes = image_module.nodeCount(image)
    history.begin(image.*.history, "Held")
    if !frame(app) || !ui.isEmpty(partArea(app, layers.PART_OPACITY)) { return 2 }
    const list = idArea(app, layers.partId(layers.PART_WELL))
    if !point(app, "pointer", middleX(list), ui.bottom(list) - 4) || !key(app, "Delete") || image_module.nodeCount(image) != nodes { return 3 }
    if !std.text.contains(api.noteOf(app), "Finish") { return 4 }
    if !clickIn(app, partArea(app, layers.PART_NEW)) || image_module.nodeCount(image) != nodes { return 5 }
    if !clickIn(app, idArea(app, layers.eyeId(3))) || !find(app, 3).?.*.visible { return 6 }
    if !clickIn(app, layers.nameArea(app, 2)) || activeId(app) != 2 { return 7 }
    history.end(image.*.history)
    if steps(app) != 0 || !frame(app) || ui.isEmpty(partArea(app, layers.PART_OPACITY)) { return 8 }
    if !point(app, "pointer", middleX(list), ui.bottom(list) - 4) || !key(app, "Delete") || image_module.nodeCount(image) != nodes - 1 || steps(app) != 1 { return 9 }
    return 0
}

// A row let go below or above the list (over the buttons, over the
// toggles) moves nowhere; a mask dragged onto another layer goes to it;
// a layer let go on a group that has a layer goes to the group's top, and
// the rows under the group are indented, deeper for the mask; folding is
// no step.
fn drops(app: *App) -> u8 {
    if !script.run(app, "new 64 64 FFFFFF\n") || !frame(app) { return 1 }
    const image = imageOf(app)
    const list = idArea(app, layers.partId(layers.PART_WELL))
    const top = layers.nameArea(app, 3)
    if ui.isEmpty(list) || ui.isEmpty(top) { return 2 }
    if !dragFrom(app, middleX(top), middleY(top), middleX(list), ui.bottom(list) + 8) || steps(app) != 0 || layers.rowNode(app, 0) != 3 { return 3 }
    if !dragFrom(app, middleX(top), middleY(top), middleX(list), list.y - 8) || steps(app) != 0 || layers.rowNode(app, 0) != 3 { return 4 }
    // The mask of the background onto Layer 1.
    const mask = ops.newMask(image, find(app, 2).?, node_module.TRANSPARENCY_MASK, "Mask", "New mask")
    if mask == null || !frame(app) { return 5 }
    const mask_id = mask.?.*.id
    const from = layers.nameArea(app, mask_id)
    const onto = layers.rowArea(app, 3)
    if ui.isEmpty(from) || ui.isEmpty(onto) || !dragFrom(app, middleX(from), middleY(from), middleX(onto), middleY(onto)) { return 6 }
    if mask.?.*.parent.?.*.id != 3 || steps(app) != 2 { return 7 }
    // A group with the background in it; Layer 1 let go on its row.
    const group = ops.newLayer(image, node_module.GROUP, "Group", "New layer")
    if group == null || !ops.move(image, find(app, 2).?, group.?, 0, "Move layer") || !frame(app) { return 8 }
    const group_id = group.?.*.id
    const layer = layers.nameArea(app, 3)
    const group_row = layers.rowArea(app, group_id)
    if ui.isEmpty(layer) || ui.isEmpty(group_row) || !dragFrom(app, middleX(layer), middleY(layer), middleX(group_row), middleY(group_row)) { return 9 }
    if find(app, 3).?.*.parent.?.*.id != group_id || node_module.childCount(group.?) != 2 || node_module.indexIn(group.?, find(app, 3).?).? != 1 || steps(app) != 5 { return 10 }
    // Listed: the group, Layer 1, its mask, the background.
    if layers.rowNode(app, 0) != group_id || layers.rowNode(app, 1) != 3 || layers.rowNode(app, 2) != mask_id || layers.rowNode(app, 3) != 2 { return 11 }
    if layers.nameArea(app, 3).x <= layers.nameArea(app, group_id).x || layers.nameArea(app, mask_id).x <= layers.nameArea(app, 3).x || layers.nameArea(app, 2).x != layers.nameArea(app, 3).x { return 12 }
    if !clickIn(app, idArea(app, layers.expanderId(group_id))) || !find(app, group_id).?.*.collapsed || steps(app) != 5 || layers.rowCount(app) != 1 { return 13 }
    return 0
}

// A long name (in byte 122 a character of two bytes begins).
var longName: [128]u8 = undefined

// New layers are named one past the largest number of their word; copies
// "... copy", again "... copy copy"; a copy of a name of 128 bytes is cut
// where " copy" fits, at a character's beginning; the opacity dragged far
// past the slider's ends is 0 and 255 exactly, a step each.
fn names(app: *App) -> u8 {
    if !script.run(app, "new 32 32 FFFFFF\n") || !frame(app) { return 1 }
    const image = imageOf(app)
    if !clickIn(app, partArea(app, layers.PART_NEW)) || !std.text.same(node_module.nameOf(api.activeNode(app).?), "Layer 2") { return 2 }
    if !clickIn(app, partArea(app, layers.PART_NEW)) || !std.text.same(node_module.nameOf(api.activeNode(app).?), "Layer 3") { return 3 }
    ops.rename(image, api.activeNode(app).?, "Layer 9", "Rename layer")
    if !clickIn(app, partArea(app, layers.PART_NEW)) || !std.text.same(node_module.nameOf(api.activeNode(app).?), "Layer 10") { return 4 }
    if !clickIn(app, partArea(app, layers.PART_DUPLICATE)) || !std.text.same(node_module.nameOf(api.activeNode(app).?), "Layer 10 copy") { return 5 }
    if !clickIn(app, partArea(app, layers.PART_DUPLICATE)) || !std.text.same(node_module.nameOf(api.activeNode(app).?), "Layer 10 copy copy") { return 6 }
    var index: usize = 0
    while index < 128 {
        var byte: u8 = 'a'
        if index == 122 || index == 124 { byte = 0xC3 }
        if index == 123 || index == 125 { byte = 0xA4 }
        if index >= 126 { byte = 'z' }
        longName[index] = byte
        index += 1
    }
    const bytes: [*]const u8 = &longName
    node_module.setName(api.activeNode(app).?, bytes[0..128])
    if !clickIn(app, partArea(app, layers.PART_DUPLICATE)) { return 7 }
    const cut = node_module.nameOf(api.activeNode(app).?)
    if cut.length != 127 || !std.text.same(cut[0..122], bytes[0..122]) || !std.text.same(cut[122..127], " copy") { return 8 }
    // The background's opacity at the ends.
    if !clickIn(app, layers.nameArea(app, 2)) || activeId(app) != 2 { return 9 }
    const before = steps(app)
    const bar = partArea(app, layers.PART_OPACITY)
    if ui.isEmpty(bar) || !point(app, "pointer", middleX(bar), middleY(bar)) || !script.run(app, "press\n") || !point(app, "pointer", bar.x - 60, middleY(bar)) || !script.run(app, "release\n") { return 10 }
    if find(app, 2).?.*.opacity != 0 || steps(app) != before + 1 || shown(app, 5, 5) >> 24 != 0 { return 11 }
    // (Later than a double click, which would open the number for typing.)
    if !script.run(app, "wait 600\n") || !point(app, "pointer", middleX(bar), middleY(bar)) || !script.run(app, "press\n") || !point(app, "pointer", ui.right(bar) + 60, middleY(bar)) || !script.run(app, "release\n") { return 12 }
    if find(app, 2).?.*.opacity != 255 || steps(app) != before + 2 || shown(app, 5, 5) != 0xFFFFFFFF { return 12 }
    return 0
}

// An image left without layers: nothing listed, the keys over the list
// do nothing (and nothing breaks), what needs a node is not offered, the
// menu of the empty list offers a new layer, which is "Layer 1".
fn emptied(app: *App) -> u8 {
    if !script.run(app, "new 32 32 FFFFFF\n") || !frame(app) { return 1 }
    const list = idArea(app, layers.partId(layers.PART_WELL))
    if !point(app, "pointer", middleX(list), middleY(list)) || !key(app, "Delete") || !key(app, "Delete") { return 2 }
    if rootCount(app) != 0 || layers.rowCount(app) != 0 || api.activeNode(app) != null || steps(app) != 2 { return 3 }
    if !key(app, "Up") || !key(app, "Down") || !key(app, "Home") || !key(app, "End") || !key(app, "PageUp") || !key(app, "PageDown") || !key(app, "Delete") || !key(app, "F2") { return 4 }
    if steps(app) != 2 || layers.renaming(app) != 0 || api.activeNode(app) != null || !frame(app) { return 5 }
    if !ui.isEmpty(partArea(app, layers.PART_DUPLICATE)) || !ui.isEmpty(partArea(app, layers.PART_DELETE)) || !ui.isEmpty(partArea(app, layers.PART_OPACITY)) || !ui.isEmpty(partArea(app, layers.PART_BLEND)) || ui.isEmpty(partArea(app, layers.PART_NEW)) { return 6 }
    if !rightClickIn(app, list) || !menus.isOpen(app) { return 7 }
    const rename = menuRow(app, "Rename")
    const paint = menuRow(app, "New Paint Layer")
    if rename == null || paint == null || menus.rowFlags(app, 0, rename.?) & menus.ROW_DISABLED == 0 || menus.rowFlags(app, 0, paint.?) & menus.ROW_DISABLED != 0 { return 8 }
    if !chooseInMenu(app, "New Paint Layer") || menus.isOpen(app) || layers.rowCount(app) != 1 { return 9 }
    if !std.text.same(node_module.nameOf(api.activeNode(app).?), "Layer 1") || steps(app) != 3 { return 10 }
    if !key(app, "Insert") || layers.rowCount(app) != 2 || !std.text.same(node_module.nameOf(api.activeNode(app).?), "Layer 2") { return 11 }
    return 0
}

// A drag of the opacity under way when another image comes in front is
// a step of the image it was made on: undo there takes it back.
fn switching(app: *App) -> u8 {
    if !script.run(app, "new 32 32 FFFFFF\n") || !frame(app) { return 1 }
    const first = app.*.current
    const image = imageOf(app)
    if !clickIn(app, layers.nameArea(app, 2)) || activeId(app) != 2 { return 2 }
    const bar = partArea(app, layers.PART_OPACITY)
    if ui.isEmpty(bar) || !point(app, "pointer", ui.right(bar) - 2, middleY(bar)) || !script.run(app, "press\n") || !point(app, "pointer", bar.x + bar.width / 4, middleY(bar)) { return 3 }
    const quarter = find(app, 2).?.*.opacity
    if quarter < 56 || quarter > 72 || history.stepsDone(image.*.history) != 0 { return 4 }
    if !script.run(app, "new 16 16 FFFFFF\n") || !frame(app) || history.stepsDone(image.*.history) != 1 { return 5 }
    if !script.run(app, "release\n") { return 6 }
    docs_module.show(app, first)
    if !frame(app) || @intFromPtr(imageOf(app)) != @intFromPtr(image) || !key(app, "Ctrl+Z") || find(app, 2).?.*.opacity != 255 || history.stepsDone(image.*.history) != 0 { return 6 }
    return 0
}

// A frame with the docker alone in `area` (on the last frame's pixels, or
// laid out only: `layout`), as the loop's pass makes one.
fn alone(app: *App, area: ui.Rect, layout: bool) -> void {
    const widgets = state.uiOf(app)
    const k = api.kit(app)
    var nowhere = view.layoutCanvas()
    var canvas = script.frameOf(app).?
    if layout { canvas = &nowhere }
    view.begin(widgets, canvas)
    kit_module.begin(k, widgets, canvas, state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app), @intCast(u64, app.*.time), app.*.german)
    kit_module.clipBegin(k, area)
    layers.drawInto(app, area)
    kit_module.clipEnd(k)
    _ = kit_module.end(k)
    _ = view.end(widgets)
}

// The docker drawn on its own: a frame that only lays out names the rows
// but makes no picture (the next drawn one does); areas of nothing, of
// one pixel, partly off the window at negative places and past its
// right and bottom, and one taller than the window break nothing.
fn apart(app: *App) -> u8 {
    if !script.run(app, "new 64 64 FFFFFF\n") || !frame(app) { return 1 }
    const area = ui.rect(300, 100, 260, 500)
    if !repaint(app, 3, ui.rect(0, 0, 8, 8), 0xFFFF0000, false) { return 2 }
    // (The pictures are stale: the step came after the frame drew them.)
    const image = imageOf(app)
    if !ops.beginPixels(image, find(app, 3).?) { return 3 }
    _ = device.fill(find(app, 3).?.*.device.?, ui.rect(0, 0, 8, 8), 0xFF0000FF)
    _ = ops.endPixels(image, find(app, 3).?, "Fill")
    const made = layers.thumbnailsMade(app)
    alone(app, area, true)
    const row = idArea(app, layers.rowId(3))
    if ui.isEmpty(row) || !inside(row, area) || layers.thumbnailsMade(app) != made || layers.rowCount(app) != 2 { return 4 }
    alone(app, area, false)
    if layers.thumbnailsMade(app) <= made || ui.isEmpty(layers.thumbnailArea(app, 3)) || !inside(layers.thumbnailArea(app, 3), area) { return 5 }
    alone(app, ui.rect(10, 10, 0, 0), false)
    alone(app, ui.rect(10, 10, 1, 1), false)
    alone(app, ui.rect(-200, -300, 260, 400), false)
    alone(app, ui.rect(900, 700, 300, 300), false)
    alone(app, ui.rect(0, 0, 260, 6000), false)
    alone(app, ui.rect(0, 0, 260, 6000), true)
    if layers.rowCount(app) != 2 || !frame(app) || layers.rowCount(app) != 2 { return 6 }
    return 0
}

// Drawn everywhere in `area` (no pixel left clear): the docks are the
// desktop's glass, translucent, with the widgets on it.
fn drawnIn(app: *state.App, area: ui.Rect) -> bool {
    const canvas = script.frameOf(app).?
    if area.width <= 0 || area.height <= 0 { return false }
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)] >> 24 == 0 { return false }
            x += 1
        }
        y += 1
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null {
        const shots = std.string.asSlice(named.?)
        shotsAt = @intFromPtr(shots.pointer)
        shotsLength = shots.length
    }
    const made = script.headless(allocator)
    if made == null { return 1 }
    const app = made.?
    if layers.list().length != 1 || layers.list()[0].id != layers.ID || !std.text.same(layers.list()[0].key, "layers") { return 2 }

    // Without an image the docker lists nothing and draws.
    if !script.run(app, "size 1024 768\n") || !docks.read(app, LAYOUT) || !frame(app) { return 3 }
    if layers.rowCount(app) != 0 || ui.isEmpty(docks.contentOf(app, layers.ID)) { return 4 }

    // The dock as it starts, at 1024 x 768 and 1280 x 800.
    if !script.run(app, "new 400 300 FFFFFF\n") { return 5 }
    docks.defaults(app)
    if !save(app, "layers-default.png") { return 6 }
    if !script.run(app, "size 1280 800\n") || !save(app, "layers-1280.png") { return 7 }
    if !script.run(app, "size 1024 768\n") || !docks.read(app, LAYOUT) || !frame(app) { return 8 }

    const first = basics(app)
    if first != 0 { return 14 + first }
    const second = tree(app)
    if second != 0 { return 31 + second }
    const third = properties(app)
    if third != 0 { return 72 + third }
    if !save(app, "layers.png") { return 102 }

    // A row being dragged: the line where it would go (between the
    // background and the group), then back where it was: nothing moves.
    const done = steps(app)
    const from = layers.nameArea(app, 3)
    const over = layers.rowArea(app, 2)
    if ui.isEmpty(from) || ui.isEmpty(over) || !point(app, "pointer", middleX(from), middleY(from)) || !script.run(app, "press\n") { return 103 }
    if !point(app, "pointer", middleX(from), from.y - 10) || !point(app, "pointer", middleX(from), over.y + over.height * 3 / 4) { return 104 }
    if !save(app, "layers-drag.png") { return 105 }
    // Let go beside the list (over the canvas): nothing moves either.
    if !point(app, "pointer", app.*.canvasArea.x + 40, over.y + over.height * 3 / 4) || !script.run(app, "release\n") || steps(app) != done || find(app, 3).?.*.parent.?.*.kind != node_module.GROUP { return 107 }
    if !point(app, "pointer", middleX(from), middleY(from)) || !script.run(app, "press\n") || !point(app, "pointer", middleX(from), from.y - 10) { return 108 }
    if !point(app, "pointer", middleX(from), middleY(from)) || !script.run(app, "release\n") || steps(app) != done || find(app, 3).?.*.parent.?.*.kind != node_module.GROUP { return 106 }

    const fourth = menuAndKeys(app)
    if fourth != 0 { return 108 + fourth }

    // Everything the docker draws is opaque, dark and light; German.
    if !frame(app) || !drawnIn(app, docks.contentOf(app, layers.ID)) { return 133 }
    app.*.shell.*.lightness = 1024
    if !save(app, "layers-light.png") || !drawnIn(app, docks.contentOf(app, layers.ID)) { return 134 }
    app.*.shell.*.lightness = 0
    if !script.run(app, "german\n") || !save(app, "layers-german.png") { return 135 }
    app.*.german = false

    // A narrow docker: everything inside it.
    docks.setAreaWidth(app, docks.AREA_RIGHT, docks.SMALLEST_WIDTH)
    if !frame(app) || !save(app, "layers-narrow.png") { return 136 }
    const narrow = docks.contentOf(app, layers.ID)
    if !inside(partArea(app, layers.PART_NEW), narrow) || !inside(partArea(app, layers.PART_DELETE), narrow) || !inside(partArea(app, layers.PART_DOWN), narrow) || !inside(partArea(app, layers.PART_OPACITY), narrow) || !inside(partArea(app, layers.PART_BLEND), narrow) { return 137 }
    // Every row keeps room for its name; the pictures give way first.
    if layers.nameArea(app, 2).width < 40 || layers.nameArea(app, 3).width < 40 { return 138 }
    docks.setAreaWidth(app, docks.AREA_RIGHT, docks.DEFAULT_WIDTH)

    const fifth = many(app)
    if fifth != 0 { return 138 + fifth }
    const tall_window = tall(app)
    if tall_window != 0 { return 150 + tall_window }

    // (A note in the status bar goes away first: the frames are then all
    // alike.)
    if !script.run(app, "wait 6000\n") { return 156 }
    const sixth = steady(app)
    if sixth != 0 { return 156 + sixth }
    const remade = churn(app)
    if remade != 0 { return 160 + remade }

    // Pictures of images of one pixel and of one row: the whole box's
    // height, and one row of it.
    if !script.run(app, "new 1 1 FF20C040\n") || app.*.count != 2 || !frame(app) { return 165 }
    const dot = layers.thumbnailArea(app, 2)
    if ui.isEmpty(dot) || windowAt(app, middleX(dot), middleY(dot)) != 0xFF20C040 || windowAt(app, middleX(dot), dot.y + 1) != 0xFF20C040 { return 166 }
    if !script.run(app, "new 4000 1 FF20C040\n") || app.*.count != 3 || !frame(app) { return 167 }
    const line = layers.thumbnailArea(app, 2)
    if ui.isEmpty(line) || windowAt(app, middleX(line), line.y + (line.height - 1) / 2) != 0xFF20C040 || windowAt(app, middleX(line), line.y + 1) == 0xFF20C040 { return 168 }

    const seventh = exact(app)
    if seventh != 0 { return 168 + seventh }
    const eighth = guard(app)
    if eighth != 0 { return 190 + eighth }
    const ninth = drops(app)
    if ninth != 0 { return 199 + ninth }
    const tenth = names(app)
    if tenth != 0 { return 212 + tenth }
    const eleventh = emptied(app)
    if eleventh != 0 { return 224 + eleventh }
    const twelfth = switching(app)
    if twelfth != 0 { return 235 + twelfth }
    const thirteenth = apart(app)
    if thirteenth != 0 { return 241 + thirteenth }
    return 13
}
