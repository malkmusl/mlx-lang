// nebula's brush dynamics and settings: response curves (the identity, a
// line, an S curve against the spline's values worked out by hand,
// clamping, the baked table, their text, points put in, moved and taken
// out), the numbers of preset files, every sensor's reading for a pen
// that is made to do one thing (pressure, tilt, speed in proportion to
// distance over time, the eight directions of the compass, distance,
// time and fade with their wrap, the random ones), the ways sensors
// combine, the list of engines, and a brush written to text and read
// back with every field changed, with keys nobody knows and with keys
// missing; names and texts kept as one line (line ends, blanks at the
// ends, a cut inside a character of UTF-8) so that a text cannot add
// lines to a preset; writing and reading presets without the value
// arena; angles at the ends of the turn, a pen going back in time and
// one at no place, a pressure that is no number through a curve; the
// registry's records staying where they are. Exits 13.
const std = @import("std")
const math = @import("std.math")
const types = @import("../brush/types.mlx")
const curve = @import("../brush/curve.mlx")
const dynamics = @import("../brush/dynamics.mlx")
const engines = @import("../brush/engines.mlx")
const tip = @import("../brush/tip.mlx")
const point = @import("../brush/point.mlx")
const blend = @import("../core/blend.mlx")
const turns = @import("std.turns")

const Settings = types.Settings
const State = types.State
const Sensor = types.Sensor

fn close(value: f64, wanted: f64) -> bool {
    return math.abs(value - wanted) < 0.000001
}

fn roughly(value: f64, wanted: f64, by: f64) -> bool {
    return math.abs(value - wanted) <= by
}

fn sameCurve(a: *const curve.Curve, b: *const curve.Curve) -> bool {
    if a.*.count != b.*.count { return false }
    var index: usize = 0
    while index < @intCast(usize, a.*.count) {
        if !close(a.*.x[index], b.*.x[index]) || !close(a.*.y[index], b.*.y[index]) { return false }
        index += 1
    }
    return true
}

fn sameSensor(a: *const Sensor, b: *const Sensor) -> bool {
    return a.*.kind == b.*.kind && sameCurve(&a.*.curve, &b.*.curve) && close(a.*.length, b.*.length) && a.*.periodic == b.*.periodic && a.*.fanCorners == b.*.fanCorners && close(a.*.fanStep, b.*.fanStep) && a.*.lockAngle == b.*.lockAngle && close(a.*.angleOffset, b.*.angleOffset)
}

// 0 when the two brushes are the same in every field a preset keeps,
// else a number that says where they differ.
fn difference(a: *const Settings, b: *const Settings) -> u8 {
    if !std.text.same(types.nameOf(a), types.nameOf(b)) { return 1 }
    if a.*.engine != b.*.engine { return 2 }
    if !close(a.*.size, b.*.size) || !close(a.*.opacity, b.*.opacity) || !close(a.*.flow, b.*.flow) { return 3 }
    if a.*.blend != b.*.blend || a.*.eraser != b.*.eraser || a.*.paintMode != b.*.paintMode { return 4 }
    if a.*.airbrush != b.*.airbrush || !close(a.*.airbrushRate, b.*.airbrushRate) { return 5 }
    if !close(a.*.scatterAmount, b.*.scatterAmount) || a.*.scatterX != b.*.scatterX || a.*.scatterY != b.*.scatterY { return 6 }
    if a.*.colorSource != b.*.colorSource { return 7 }
    if a.*.texture != b.*.texture || !close(a.*.textureStrength, b.*.textureStrength) || !close(a.*.textureScale, b.*.textureScale) || a.*.textureMode != b.*.textureMode { return 8 }
    if !std.text.same(types.textOf(a), types.textOf(b)) { return 9 }
    var index: usize = 0
    while index < types.VALUES {
        if !close(@floatCast(f64, a.*.values[index]), @floatCast(f64, b.*.values[index])) { return 10 }
        index += 1
    }
    const s = &a.*.tip
    const t = &b.*.tip
    if s.*.kind != t.*.kind || s.*.shape != t.*.shape || !close(s.*.ratio, t.*.ratio) { return 11 }
    if !close(s.*.horizontalFade, t.*.horizontalFade) || !close(s.*.verticalFade, t.*.verticalFade) || !close(s.*.angle, t.*.angle) { return 12 }
    if s.*.spikes != t.*.spikes || !close(s.*.density, t.*.density) || !close(s.*.randomness, t.*.randomness) { return 14 }
    if s.*.softness != t.*.softness || s.*.antialias != t.*.antialias || s.*.predefined != t.*.predefined || s.*.asImage != t.*.asImage { return 15 }
    if !close(s.*.spacing, t.*.spacing) || s.*.autoSpacing != t.*.autoSpacing || !close(s.*.autoSpacingCoefficient, t.*.autoSpacingCoefficient) || s.*.precision != t.*.precision { return 16 }
    index = 0
    while index < types.OPTIONS {
        const o = &a.*.options[index]
        const p = &b.*.options[index]
        if o.*.on != p.*.on || o.*.count != p.*.count || o.*.combine != p.*.combine || !close(o.*.strength, p.*.strength) { return 17 }
        var slot: usize = 0
        while slot < @intCast(usize, o.*.count) {
            if !sameSensor(&o.*.sensors[slot], &p.*.sensors[slot]) { return 18 }
            slot += 1
        }
        index += 1
    }
    return 0
}

fn newSettings() -> *Settings {
    const memory = std.heap.allocator().alloc(@sizeOf(Settings), 16).?
    unsafe { return @ptrCast(*Settings, memory) }
}

// A sensor of `kind` with nothing special.
fn sensorOf(kind: u8) -> Sensor {
    var made: Sensor = undefined
    types.defaultSensor(&made, kind)
    return made
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()

    // ------------------------------------------------------------------
    // Curves
    var line = curve.identity()
    if !curve.isIdentity(&line) || curve.evaluate(&line, 0.0) != 0.0 || !close(curve.evaluate(&line, 0.25), 0.25) || curve.evaluate(&line, 1.0) != 1.0 { return 1 }
    if curve.evaluate(&line, -3.0) != 0.0 || curve.evaluate(&line, 7.0) != 1.0 { return 2 }
    // Two points: a straight line between them, level outside.
    const line_x = [2]f64{ 0.2, 0.8 }
    const line_y = [2]f64{ 0.1, 0.9 }
    line = curve.fromPoints(line_x[0..], line_y[0..])
    if curve.isIdentity(&line) || !close(curve.evaluate(&line, 0.5), 0.5) || !close(curve.evaluate(&line, 0.35), 0.3) { return 3 }
    if !close(curve.evaluate(&line, 0.1), 0.1) || !close(curve.evaluate(&line, 0.0), 0.1) || !close(curve.evaluate(&line, 0.9), 0.9) || !close(curve.evaluate(&line, 1.0), 0.9) { return 4 }
    // An S through (0, 0), (0.25, 0.1), (0.75, 0.9), (1, 1). The natural
    // spline's bends at the two inner points are 7.2 and -7.2 (from
    // 1.5 M1 + 0.5 M2 = 7.2 and 0.5 M1 + 1.5 M2 = -7.2), so the first
    // piece is 0.1 t + 4.8 t^3 and the second, from 0.25 on, is
    // 0.1 + t + 3.6 t^2 - 4.8 t^3.
    const s_x = [4]f64{ 0.0, 0.25, 0.75, 1.0 }
    const s_y = [4]f64{ 0.0, 0.1, 0.9, 1.0 }
    var bent = curve.fromPoints(s_x[0..], s_y[0..])
    if !close(curve.evaluate(&bent, 0.125), 0.021875) || !close(curve.evaluate(&bent, 0.375), 0.271875) || !close(curve.evaluate(&bent, 0.5), 0.5) { return 5 }
    if !close(curve.evaluate(&bent, 0.625), 0.728125) || !close(curve.evaluate(&bent, 0.875), 0.978125) { return 6 }
    if !close(curve.evaluate(&bent, 0.25), 0.1) || !close(curve.evaluate(&bent, 0.75), 0.9) || curve.evaluate(&bent, 0.0) != 0.0 || curve.evaluate(&bent, 1.0) != 1.0 { return 7 }
    // Given in any order the points are sorted.
    const mixed_x = [4]f64{ 0.75, 0.0, 1.0, 0.25 }
    const mixed_y = [4]f64{ 0.9, 0.0, 1.0, 0.1 }
    const sorted = curve.fromPoints(mixed_x[0..], mixed_y[0..])
    if !sameCurve(&sorted, &bent) { return 8 }
    // The spline swings beyond its points; the curve does not leave 0..1.
    const hill_x = [4]f64{ 0.0, 0.4, 0.6, 1.0 }
    const hill_y = [4]f64{ 0.0, 1.0, 1.0, 0.0 }
    const hill = curve.fromPoints(hill_x[0..], hill_y[0..])
    const pit_y = [4]f64{ 1.0, 0.0, 0.0, 1.0 }
    const pit = curve.fromPoints(hill_x[0..], pit_y[0..])
    if curve.evaluate(&hill, 0.5) != 1.0 || curve.evaluate(&pit, 0.5) != 0.0 { return 9 }
    var step: usize = 0
    while step <= 1000 {
        const up = curve.evaluate(&hill, @floatFromInt(f64, step) / 1000.0)
        const down = curve.evaluate(&pit, @floatFromInt(f64, step) / 1000.0)
        if up < 0.0 || up > 1.0 || down < 0.0 || down > 1.0 { return 10 }
        step += 1
    }
    // Points beyond 0..1 are held, points on one x are one, fewer than
    // two give the identity.
    const wild_x = [3]f64{ -1.0, 0.5, 0.5 }
    const wild_y = [3]f64{ 2.0, 0.25, 0.75 }
    const wild = curve.fromPoints(wild_x[0..], wild_y[0..])
    if wild.count != 2 || wild.x[0] != 0.0 || wild.y[0] != 1.0 || wild.x[1] != 0.5 || wild.y[1] != 0.25 { return 11 }
    const lone = curve.fromPoints(wild_x[0..1], wild_y[0..1])
    if !curve.isIdentity(&lone) { return 12 }

    // Baked: 256 numbers, the curve at i / 255, rising for a rising curve.
    const table_memory = allocator.alloc(types.SENSORS * 256 * 4, 16)
    if table_memory == null { return 14 }
    const tables: [*]f32 = unsafe { @ptrCast([*]f32, table_memory.?) }
    const table: *[256]f32 = unsafe { @ptrCast(*[256]f32, table_memory.?) }
    curve.bake(&bent, table)
    if table.*[0] != 0.0 || table.*[255] != 1.0 { return 15 }
    step = 0
    while step < 256 {
        if step > 0 && table.*[step] < table.*[step - 1] { return 16 }
        if !roughly(@floatCast(f64, table.*[step]), curve.evaluate(&bent, @floatFromInt(f64, step) / 255.0), 0.0000001) { return 17 }
        step += 1
    }
    curve.bake(&hill, table)
    if table.*[128] != 1.0 || table.*[0] != 0.0 || table.*[255] != 0.0 { return 18 }

    // Text, there and back.
    var text = std.ArrayList(u8).init(allocator)
    if !curve.write(&bent, &text) || !std.text.same(text.items(), "0,0;0.25,0.1;0.75,0.9;1,1") { return 19 }
    var read = curve.identity()
    if !curve.parse(text.items(), &read) || !sameCurve(&read, &bent) { return 20 }
    if !curve.parse(" 1 , 1 ; 0,0 ;0.5, 0.125 ; ", &read) || read.count != 3 || read.x[1] != 0.5 || read.y[1] != 0.125 || read.x[2] != 1.0 { return 21 }
    const before_bad = read
    if curve.parse("", &read) || curve.parse("0,0", &read) || curve.parse("0,0;1", &read) || curve.parse("0,0;1,1;x", &read) || curve.parse("a,b;c,d", &read) { return 22 }
    if !sameCurve(&read, &before_bad) { return 23 }
    // Ten points: the first eight count.
    if !curve.parse("0,0;0.1,0.1;0.2,0.2;0.3,0.3;0.4,0.4;0.5,0.5;0.6,0.6;0.7,0.7;0.8,0.8;0.9,0.9", &read) || read.count != 8 || !close(read.x[7], 0.7) { return 24 }

    // Points put in, moved and taken out; x stays ascending.
    var edited = bent
    const placed = curve.insert(&edited, 0.5, 0.6)
    if placed == null || placed.? != 2 || edited.count != 5 || edited.x[2] != 0.5 || edited.y[2] != 0.6 || edited.x[3] != 0.75 { return 25 }
    if curve.insert(&edited, 0.5, 0.1) != null || curve.insert(&edited, 0.0, 0.1) != null { return 26 }
    if curve.insert(&edited, 0.1, 5.0) == null || curve.insert(&edited, 0.9, -5.0) == null || curve.insert(&edited, 0.6, 0.5) == null { return 27 }
    if edited.count != 8 || edited.y[1] != 1.0 || edited.y[6] != 0.0 || curve.insert(&edited, 0.3, 0.3) != null { return 28 }
    step = 1
    while step < 8 {
        if !(edited.x[step] > edited.x[step - 1]) { return 29 }
        step += 1
    }
    // Dragged past its neighbour a point stops just before it.
    if !curve.move(&edited, 3, 0.95, 0.4) || !(edited.x[3] < edited.x[4]) || !(edited.x[3] > 0.59) || edited.y[3] != 0.4 { return 30 }
    if !curve.move(&edited, 0, 0.5, 0.2) || !(edited.x[0] < edited.x[1]) || curve.move(&edited, 8, 0.5, 0.5) { return 31 }
    if !curve.remove(&edited, 1) || edited.count != 7 || curve.remove(&edited, 7) { return 32 }
    while edited.count > 2 {
        if !curve.remove(&edited, 0) { return 33 }
    }
    if curve.remove(&edited, 0) || curve.remove(&edited, 1) || edited.count != 2 || edited.x[1] != 1.0 { return 34 }

    // The numbers of preset files.
    const numbers = [8]f64{ 0.1, 12.5, -3.25, 1000000.0, 0.000001, 0.0000001, 123.456789, -0.0000001 }
    const written = [8][]const u8{ "0.1", "12.5", "-3.25", "1000000", "0.000001", "0", "123.456789", "0" }
    for number, index in numbers {
        text.clearRetainingCapacity()
        if !curve.appendNumber(&text, number) || !std.text.same(text.items(), written[index]) { return 35 }
    }
    text.clearRetainingCapacity()
    if !curve.appendNumber(&text, math.nan()) || !std.text.same(text.items(), "0") { return 36 }
    var at: usize = 0
    var number: f64 = 0.0
    if !curve.parseNumber("  1.5e2,", &at, &number) || number != 150.0 || at != 7 { return 37 }
    at = 0
    if !curve.parseNumber("-.5", &at, &number) || number != -0.5 || at != 3 { return 38 }
    at = 0
    if !curve.parseNumber("25e-1x", &at, &number) || number != 2.5 || at != 5 { return 39 }
    at = 0
    if curve.parseNumber("abc", &at, &number) || curve.parseNumber("-", &at, &number) || curve.parseNumber("", &at, &number) || at != 0 || number != 2.5 { return 40 }

    // ------------------------------------------------------------------
    // Sensors
    var state: State = undefined
    const origin = point.at(0.0, 0.0, 0.3, 1000.0)
    dynamics.start(&state, 42, &origin)
    var sensor = sensorOf(types.SENSOR_PRESSURE)
    if !close(dynamics.value(&sensor, &state, 0), 0.3) { return 41 }
    state.point.pressure = 7.0
    if dynamics.value(&sensor, &state, 0) != 1.0 { return 42 }
    state.point.pressure = -1.0
    if dynamics.value(&sensor, &state, 0) != 0.0 { return 43 }
    // Pressure in: only up.
    sensor = sensorOf(types.SENSOR_PRESSURE_IN)
    if !close(dynamics.value(&sensor, &state, 0), 0.3) { return 44 }
    state.point.pressure = 0.7
    dynamics.place(&state, 0.0, 0.0)
    state.point.pressure = 0.4
    dynamics.place(&state, 0.0, 0.0)
    if !close(dynamics.value(&sensor, &state, 0), 0.7) { return 45 }
    // Tilt.
    state.point.tiltX = -0.25
    state.point.tiltY = 0.5
    sensor = sensorOf(types.SENSOR_X_TILT)
    if !close(dynamics.value(&sensor, &state, 0), 0.75) { return 46 }
    sensor = sensorOf(types.SENSOR_Y_TILT)
    if !close(dynamics.value(&sensor, &state, 0), 0.5) { return 47 }
    sensor = sensorOf(types.SENSOR_TILT_DIRECTION)
    const lean_x = [5]f64{ 1.0, 0.0, -1.0, 0.0, 0.0 }
    const lean_y = [5]f64{ 0.0, 0.5, 0.0, -0.2, 0.0 }
    const lean = [5]f64{ 0.0, 0.25, 0.5, 0.75, 0.0 }
    for wanted, index in lean {
        state.point.tiltX = lean_x[index]
        state.point.tiltY = lean_y[index]
        if !close(dynamics.value(&sensor, &state, 0), wanted) { return 48 }
    }
    sensor = sensorOf(types.SENSOR_TILT_ELEVATION)
    if dynamics.value(&sensor, &state, 0) != 1.0 { return 49 }
    state.point.tiltX = 0.3
    state.point.tiltY = -0.4
    if !close(dynamics.value(&sensor, &state, 0), 0.5) { return 50 }
    state.point.tiltX = 1.0
    state.point.tiltY = 1.0
    if dynamics.value(&sensor, &state, 0) != 0.0 { return 51 }
    // The pen's own turn.
    sensor = sensorOf(types.SENSOR_ROTATION)
    state.point.rotation = math.pi
    if !close(dynamics.value(&sensor, &state, 0), 0.5) { return 52 }
    state.point.rotation = 0.0 - math.pi * 0.5
    if !close(dynamics.value(&sensor, &state, 0), 0.75) { return 53 }

    // Speed: in proportion to distance over time, 1 from 3 pixels a
    // millisecond on, 0 at the start; 63% of the way after the time
    // constant; dying down at rest.
    sensor = sensorOf(types.SENSOR_SPEED)
    const speeds = [3]f64{ 0.6, 1.5, 6.0 }
    const readings = [3]f64{ 0.2, 0.5, 1.0 }
    for wanted, index in speeds {
        dynamics.start(&state, 1, &origin)
        if dynamics.value(&sensor, &state, 0) != 0.0 { return 54 }
        var from = origin
        step = 0
        while step < 50 {
            const next = point.at(from.x + wanted * 10.0, 0.0, 1.0, from.time + 10.0)
            dynamics.segment(&state, &from, &next)
            state.point = next
            dynamics.place(&state, 1.0, wanted * 10.0)
            dynamics.finish(&state)
            from = next
            step += 1
        }
        if !roughly(dynamics.value(&sensor, &state, 0), readings[index], 0.002) { return 55 }
        if !roughly(dynamics.speed(&state), wanted, wanted * 0.002) { return 56 }
        if !close(state.distance, wanted * 500.0) || !close(state.time, 500.0) { return 57 }
    }
    dynamics.start(&state, 1, &origin)
    const after = point.at(75.0, 0.0, 1.0, 1050.0)
    dynamics.segment(&state, &origin, &after)
    state.point = after
    dynamics.place(&state, 1.0, 75.0)
    if !roughly(dynamics.value(&sensor, &state, 0), 0.5 * (1.0 - math.exp(-1.0)), 0.0001) { return 58 }
    // Halfway along the piece: half the time at this speed.
    dynamics.place(&state, 0.5, 37.5)
    if !roughly(dynamics.value(&sensor, &state, 0), 0.5 * (1.0 - math.exp(-0.5)), 0.0001) { return 59 }
    dynamics.finish(&state)
    const moving = dynamics.speed(&state)
    dynamics.rest(&state, dynamics.SPEED_TIME)
    if !roughly(dynamics.speed(&state), moving * math.exp(-1.0), 0.0001) { return 60 }
    // A piece without duration keeps the speed.
    const instant = point.at(175.0, 0.0, 1.0, 1050.0)
    const kept_speed = dynamics.speed(&state)
    dynamics.segment(&state, &after, &instant)
    dynamics.place(&state, 1.0, 100.0)
    if dynamics.speed(&state) != kept_speed { return 61 }

    // The drawing angle: the eight directions of the compass, from the
    // right clockwise (y grows downward).
    sensor = sensorOf(types.SENSOR_DRAWING_ANGLE)
    dynamics.start(&state, 1, &origin)
    if dynamics.value(&sensor, &state, 0) != 0.0 { return 62 }
    const go_x = [8]f64{ 10.0, 10.0, 0.0, -10.0, -10.0, -10.0, 0.0, 10.0 }
    const go_y = [8]f64{ 0.0, 10.0, 10.0, 10.0, 0.0, -10.0, -10.0, -10.0 }
    for dx, index in go_x {
        const there = point.at(dx, go_y[index], 1.0, 1010.0)
        dynamics.segment(&state, &origin, &there)
        if !close(dynamics.value(&sensor, &state, 0), @floatFromInt(f64, index) / 8.0) { return 63 }
        if !close(dynamics.turnPart(state.direction), @floatFromInt(f64, index) / 8.0) { return 64 }
    }
    // The offset is added (and wraps), the lock keeps the first direction.
    sensor.angleOffset = 90.0
    if !close(dynamics.value(&sensor, &state, 0), 0.125) { return 65 }
    sensor.angleOffset = 0.0
    sensor.lockAngle = true
    if dynamics.value(&sensor, &state, 0) != 0.0 { return 66 }
    // A piece without length keeps the direction.
    const same_place = point.at(0.0, 0.0, 1.0, 1020.0)
    sensor.lockAngle = false
    dynamics.segment(&state, &origin, &same_place)
    if !close(dynamics.value(&sensor, &state, 0), 0.875) { return 67 }

    // Distance, time and fade: up to 1 over the length, or around again.
    dynamics.start(&state, 1, &origin)
    sensor = sensorOf(types.SENSOR_DISTANCE)
    sensor.length = 100.0
    state.distance = 50.0
    if !close(dynamics.value(&sensor, &state, 0), 0.5) { return 68 }
    state.distance = 150.0
    if dynamics.value(&sensor, &state, 0) != 1.0 { return 69 }
    sensor.periodic = true
    if !close(dynamics.value(&sensor, &state, 0), 0.5) { return 70 }
    state.distance = 200.0
    if dynamics.value(&sensor, &state, 0) != 0.0 { return 71 }
    state.distance = 275.0
    if !close(dynamics.value(&sensor, &state, 0), 0.75) { return 72 }
    sensor = sensorOf(types.SENSOR_TIME)
    sensor.length = 400.0
    state.time = 100.0
    if !close(dynamics.value(&sensor, &state, 0), 0.25) { return 73 }
    state.time = 900.0
    if dynamics.value(&sensor, &state, 0) != 1.0 { return 74 }
    sensor.periodic = true
    if !close(dynamics.value(&sensor, &state, 0), 0.25) { return 75 }
    sensor = sensorOf(types.SENSOR_FADE)
    sensor.length = 50.0
    step = 0
    while step < 25 {
        dynamics.placed(&state)
        step += 1
    }
    if !close(dynamics.value(&sensor, &state, 0), 0.5) { return 76 }
    while step < 75 {
        dynamics.placed(&state)
        step += 1
    }
    if dynamics.value(&sensor, &state, 0) != 1.0 { return 77 }
    sensor.periodic = true
    if !close(dynamics.value(&sensor, &state, 0), 0.5) { return 78 }
    // The time a dab has is its point's since the first one's.
    state.point.time = 1250.0
    dynamics.place(&state, 0.0, 0.0)
    if state.time != 250.0 { return 79 }

    // Random: a new number for every dab, one for the stroke; the same
    // seed gives the same numbers, another seed others.
    sensor = sensorOf(types.SENSOR_FUZZY_DAB)
    dynamics.start(&state, 5, &origin)
    const first_draw = dynamics.value(&sensor, &state, 0)
    const second_draw = dynamics.value(&sensor, &state, 0)
    if first_draw == second_draw || first_draw < 0.0 || first_draw >= 1.0 || second_draw < 0.0 || second_draw >= 1.0 { return 80 }
    dynamics.start(&state, 5, &origin)
    if dynamics.value(&sensor, &state, 0) != first_draw || dynamics.value(&sensor, &state, 0) != second_draw { return 81 }
    dynamics.start(&state, 6, &origin)
    if dynamics.value(&sensor, &state, 0) == first_draw { return 82 }
    var total: f64 = 0.0
    step = 0
    while step < 4000 {
        total += dynamics.value(&sensor, &state, 0)
        step += 1
    }
    if !roughly(total / 4000.0, 0.5, 0.03) { return 83 }
    sensor = sensorOf(types.SENSOR_FUZZY_STROKE)
    const for_stroke = dynamics.value(&sensor, &state, 3)
    if dynamics.value(&sensor, &state, 3) != for_stroke || dynamics.value(&sensor, &state, 4) == for_stroke || for_stroke < 0.0 || for_stroke >= 1.0 { return 84 }
    dynamics.start(&state, 7, &origin)
    if dynamics.value(&sensor, &state, 3) == for_stroke { return 85 }
    dynamics.start(&state, 6, &origin)
    if dynamics.value(&sensor, &state, 3) != for_stroke { return 86 }
    sensor = sensorOf(types.SENSOR_PERSPECTIVE)
    if dynamics.value(&sensor, &state, 0) != 1.0 { return 87 }
    sensor = sensorOf(types.SENSOR_TANGENTIAL_PRESSURE)
    if dynamics.value(&sensor, &state, 0) != 0.0 { return 88 }
    state.point.tangentialPressure = 0.4
    if !close(dynamics.value(&sensor, &state, 0), 0.4) { return 89 }

    // ------------------------------------------------------------------
    // Options: curves and combinations
    var option: types.Option = undefined
    types.defaultOption(&option)
    dynamics.bake(&option, tables)
    state.point.pressure = 0.123
    state.point.tiltX = 0.5
    state.point.tiltY = 0.0
    // Off: 1. On: the pressure through the identity.
    if dynamics.evaluate(&option, tables, &state, 0) != 1.0 { return 90 }
    option.on = true
    if !roughly(dynamics.evaluate(&option, tables, &state, 0), 0.123, 0.0000001) { return 91 }
    option.strength = 0.5
    if !roughly(dynamics.evaluate(&option, tables, &state, 0), 0.0615, 0.0000001) { return 92 }
    option.count = 0
    if dynamics.evaluate(&option, tables, &state, 0) != 0.5 { return 93 }
    // Through the S curve.
    option.count = 1
    option.strength = 1.0
    option.sensors[0].curve = bent
    dynamics.bake(&option, tables)
    state.point.pressure = 0.375
    if !roughly(dynamics.evaluate(&option, tables, &state, 0), 0.271875, 0.0001) { return 94 }
    state.point.pressure = 1.0
    if dynamics.evaluate(&option, tables, &state, 0) != 1.0 { return 95 }
    // Pressure 0.8, tilt 0.5 (through a curve that halves: 0.25), and a
    // third sensor at 1: each way of combining.
    option.sensors[0].curve = curve.identity()
    option.sensors[1].kind = types.SENSOR_X_TILT
    const halving_y = [2]f64{ 0.0, 0.5 }
    const ends_x = [2]f64{ 0.0, 1.0 }
    option.sensors[1].curve = curve.fromPoints(ends_x[0..], halving_y[0..])
    option.sensors[2].kind = types.SENSOR_PERSPECTIVE
    dynamics.bake(&option, tables)
    state.point.pressure = 0.8
    option.count = 2
    const modes = [5]u8{ types.COMBINE_MULTIPLY, types.COMBINE_ADD, types.COMBINE_MAX, types.COMBINE_MIN, types.COMBINE_DIFFERENCE }
    const of_two = [5]f64{ 0.2, 1.0, 0.8, 0.25, 0.55 }
    const of_three = [5]f64{ 0.2, 1.0, 1.0, 0.25, 0.75 }
    for mode, index in modes {
        option.combine = mode
        option.count = 2
        if !roughly(dynamics.evaluate(&option, tables, &state, 0), of_two[index], 0.0000001) { return @intCast(u8, 96 + index) }
        option.count = 3
        if !roughly(dynamics.evaluate(&option, tables, &state, 0), of_three[index], 0.0000001) { return @intCast(u8, 101 + index) }
        // One sensor alone is itself, however it would combine.
        option.count = 1
        if !roughly(dynamics.evaluate(&option, tables, &state, 0), 0.8, 0.0000001) { return 106 }
    }
    // Adding below 1 stays below it.
    state.point.pressure = 0.3
    option.combine = types.COMBINE_ADD
    option.count = 2
    if !roughly(dynamics.evaluate(&option, tables, &state, 0), 0.55, 0.0000001) { return 107 }
    allocator.free(table_memory.?, types.SENSORS * 256 * 4, 16)

    // ------------------------------------------------------------------
    // The list of engines, and names
    if engines.count() < 2 || engines.at(engines.count()) != null || engines.at(0) == null { return 108 }
    const brush = engines.find(types.ENGINE_PAINTBRUSH)
    const rubber = engines.byKey("eraser")
    if brush == null || !std.text.same(brush.?.*.key, "paintbrush") || rubber == null || rubber.?.*.id != types.ENGINE_ERASER { return 109 }
    if engines.find(9999) != null || engines.byKey("") != null || engines.byKey("nothing") != null { return 110 }
    if engines.name(types.ENGINE_ERASER, true).length == 0 || engines.name(types.ENGINE_ERASER, false).length == 0 || engines.name(9999, false).length != 0 { return 111 }
    step = 0
    while step < engines.count() {
        const listed = engines.at(step).?
        const found = engines.find(listed.*.id)
        if found == null || @intFromPtr(found.?) != @intFromPtr(listed) || listed.*.key.length == 0 || listed.*.name.length == 0 || listed.*.german.length == 0 { return 112 }
        step += 1
    }
    step = 0
    while step < types.SENSOR_KINDS {
        if types.sensorKey(@intCast(u8, step)).length == 0 || types.sensorName(@intCast(u8, step), false).length == 0 || types.sensorName(@intCast(u8, step), true).length == 0 { return 114 }
        step += 1
    }
    step = 0
    while step < types.OPTIONS {
        if types.optionKey(step).length == 0 || types.optionName(step, false).length == 0 || types.optionName(step, true).length == 0 { return 115 }
        step += 1
    }
    if types.sensorKey(200).length != 0 || types.optionName(types.OPTIONS, false).length != 0 || types.combineName(types.COMBINE_DIFFERENCE, true).length == 0 || types.softnessName(types.SOFT_GAUSSIAN, false).length == 0 || types.colorSourceName(types.COLOR_TOTAL_RANDOM, true).length == 0 { return 116 }

    // ------------------------------------------------------------------
    // Settings
    const plain = newSettings()
    const changed = newSettings()
    const back = newSettings()
    types.defaults(plain)
    // The default: a plain round brush.
    if !std.text.same(types.nameOf(plain), "Round brush") || plain.*.engine != types.ENGINE_PAINTBRUSH || plain.*.size != 40.0 || plain.*.tip.spacing != 0.1 { return 117 }
    if plain.*.tip.kind != types.TIP_AUTO || plain.*.tip.shape != types.SHAPE_CIRCLE || plain.*.tip.horizontalFade != 1.0 || plain.*.tip.verticalFade != 1.0 || plain.*.opacity != 1.0 || plain.*.flow != 1.0 { return 118 }
    if !plain.*.options[types.OPTION_SIZE].on || plain.*.options[types.OPTION_SIZE].count != 1 || plain.*.options[types.OPTION_SIZE].sensors[0].kind != types.SENSOR_PRESSURE || !curve.isIdentity(&plain.*.options[types.OPTION_SIZE].sensors[0].curve) { return 119 }
    step = 1
    while step < types.OPTIONS {
        if plain.*.options[step].on { return 120 }
        step += 1
    }
    // Written and read back it is itself.
    text.clearRetainingCapacity()
    if !types.write(plain, &text) || !types.parse(text.items(), back) { return 121 }
    if difference(plain, back) != 0 { return 122 }

    // Every field something else.
    types.defaults(changed)
    types.setName(changed, "Test brush = äö 2")
    changed.*.engine = types.ENGINE_ERASER
    changed.*.size = 123.456
    changed.*.opacity = 0.6
    changed.*.flow = 0.3
    changed.*.blend = blend.ERASE
    changed.*.eraser = true
    changed.*.paintMode = types.MODE_BUILD_UP
    changed.*.airbrush = true
    changed.*.airbrushRate = 12.5
    changed.*.scatterAmount = 2.5
    changed.*.scatterX = false
    changed.*.scatterY = false
    changed.*.colorSource = types.COLOR_TOTAL_RANDOM
    changed.*.texture = 7
    changed.*.textureStrength = 0.4
    changed.*.textureScale = 2.5
    changed.*.textureMode = 3
    types.setText(changed, "bristles = 12; length = 0.5")
    step = 0
    while step < types.VALUES {
        changed.*.values[step] = @floatCast(f32, @floatFromInt(f64, step) * 0.5 - 3.0)
        step += 1
    }
    changed.*.tip.kind = types.TIP_PREDEFINED
    changed.*.tip.shape = types.SHAPE_RECTANGLE
    changed.*.tip.ratio = 0.5
    changed.*.tip.horizontalFade = 0.25
    changed.*.tip.verticalFade = 0.75
    changed.*.tip.angle = 33.5
    changed.*.tip.spikes = 7
    changed.*.tip.density = 0.8
    changed.*.tip.randomness = 0.3
    changed.*.tip.softness = types.SOFT_GAUSSIAN
    changed.*.tip.antialias = false
    changed.*.tip.predefined = 5
    changed.*.tip.asImage = true
    changed.*.tip.spacing = 0.37
    changed.*.tip.autoSpacing = true
    changed.*.tip.autoSpacingCoefficient = 2.5
    changed.*.tip.precision = 3
    step = 0
    while step < types.OPTIONS {
        const record = &changed.*.options[step]
        record.*.on = step % 2 == 1
        record.*.count = @intCast(u8, (step + 1) % 5)
        record.*.combine = @intCast(u8, (step + 2) % 5)
        record.*.strength = 0.1 + @floatFromInt(f64, step) * 0.03
        var slot: usize = 0
        while slot < types.SENSORS {
            const item = &record.*.sensors[slot]
            item.*.kind = @intCast(u8, (step + slot * 3 + 1) % types.SENSOR_KINDS)
            const cx = [3]f64{ 0.0, 0.25 + @floatFromInt(f64, slot) * 0.125, 1.0 }
            const cy = [3]f64{ @floatFromInt(f64, step) / 32.0, 0.5, 1.0 - @floatFromInt(f64, slot) * 0.125 }
            item.*.curve = curve.fromPoints(cx[0..], cy[0..])
            item.*.length = 10.0 + @floatFromInt(f64, step * 7 + slot)
            item.*.periodic = (step + slot) % 2 == 0
            item.*.fanCorners = (step + slot) % 3 == 0
            item.*.fanStep = 5.0 + @floatFromInt(f64, slot) + @floatFromInt(f64, step) * 0.5
            item.*.lockAngle = (step + slot) % 4 == 1
            item.*.angleOffset = -90.0 + @floatFromInt(f64, step * 10 + slot)
            slot += 1
        }
        step += 1
    }
    text.clearRetainingCapacity()
    if !types.write(changed, &text) { return 123 }
    if !types.parse(text.items(), back) { return 124 }
    const where = difference(changed, back)
    if where != 0 { return 124 + where }
    // (Really all changed: nothing of it is the default's.)
    if difference(changed, plain) == 0 || back.*.options[3].sensors[0].kind == types.SENSOR_PRESSURE || back.*.tip.predefined != 5 { return 143 }
    // Sensors past an option's count are not kept: they come back plain.
    var plain_sensor = sensorOf(types.SENSOR_PRESSURE)
    if back.*.options[4].count != 0 || !sameSensor(&back.*.options[4].sensors[0], &plain_sensor) || !sameSensor(&back.*.options[0].sensors[1], &plain_sensor) { return 144 }
    // Written again, the text is the same: the format is stable.
    var again = std.ArrayList(u8).init(allocator)
    if !types.write(back, &again) || !std.text.same(again.items(), text.items()) { return 145 }

    // Keys nobody knows, values that are none, and lines that are no
    // lines are passed over; what is there counts.
    if !again.appendSlice("\nfuture.key = 5\noption.nonsense.strength = 0.5\ntip.wings = 2\nsize = big\nnot a line at all\n# a comment = 1\n   \nvalue.99 = 1\noption = 1\noption.size.sensor.9 = pressure\n") { return 146 }
    if !types.parse(again.items(), back) || difference(changed, back) != 0 { return 147 }
    // Windows line ends and blanks around everything.
    if !types.parse("  size   =   77  \r\n\r\nopacity=0.5\r\ntip.fade_h =0.25\r\noption.opacity = on\r\n", back) { return 148 }
    // Keys that are missing keep the default's value.
    types.defaults(changed)
    changed.*.size = 77.0
    changed.*.opacity = 0.5
    changed.*.tip.horizontalFade = 0.25
    changed.*.options[types.OPTION_OPACITY].on = true
    if difference(changed, back) != 0 { return 149 }
    // A later line wins; an engine by its key.
    if !types.parse("size = 5\nsize = 6\nengine = eraser\n", back) || back.*.size != 6.0 || back.*.engine != types.ENGINE_ERASER { return 150 }
    // Not a preset: nothing in it counts, or its engine is not known.
    if types.parse("", back) || types.parse("hello\nworld\n", back) || types.parse("# only = a comment\n", back) || types.parse("size = 50\nengine = warp-drive\n", back) { return 151 }
    types.defaults(plain)
    if difference(plain, back) != 0 { return 152 }
    // What is out of range is held to it.
    if !types.parse("size = 1e9\nopacity = -4\nflow = 3\ntip.spikes = 99\ntip.ratio = 0\ntip.precision = 0\nairbrush_rate = 0\ntip.spacing = 500\noption.size.sensors = 9\noption.size.strength = 2\noption.size.sensor.0.curve = 5,5;-1,-1;0.5,0.5\n", back) { return 153 }
    if back.*.size != types.LARGEST_SIZE || back.*.opacity != 0.0 || back.*.flow != 1.0 || back.*.tip.spikes != 12 || back.*.tip.ratio != 0.01 || back.*.tip.precision != 1 || back.*.airbrushRate != 1.0 || back.*.tip.spacing != 10.0 { return 154 }
    const held = &back.*.options[types.OPTION_SIZE]
    if held.*.count != 4 || held.*.strength != 1.0 || held.*.sensors[0].curve.count != 3 || held.*.sensors[0].curve.x[0] != 0.0 || held.*.sensors[0].curve.y[0] != 0.0 || held.*.sensors[0].curve.x[2] != 1.0 || held.*.sensors[0].curve.y[2] != 1.0 { return 155 }
    // sanitize() alone, on numbers that are none.
    types.defaults(back)
    back.*.size = math.nan()
    back.*.opacity = math.nan()
    back.*.tip.kind = 77
    back.*.tip.predefined = 60000
    back.*.options[2].count = 200
    back.*.options[2].sensors[3].kind = 99
    back.*.options[2].sensors[3].curve.count = 77
    back.*.colorSource = 99
    // (A length beyond the array is held to it, and the name becomes one
    // line: a line end in it a blank.)
    step = 11
    while step < types.NAME {
        back.*.name[step] = if step == 30 { 10 } else { 120 }
        step += 1
    }
    back.*.nameLength = 5000
    types.sanitize(back)
    if back.*.size != 40.0 || back.*.opacity != 1.0 || back.*.tip.kind != types.TIP_AUTO || back.*.tip.predefined != 0 || back.*.options[2].count != 4 || back.*.options[2].sensors[3].kind != types.SENSOR_PRESSURE || back.*.options[2].sensors[3].curve.count > 8 || back.*.colorSource != types.COLOR_PLAIN || back.*.nameLength != types.NAME || back.*.name[30] != 32 || back.*.name[63] != 120 || !std.text.same(types.nameOf(back)[0..12], "Round brushx") { return 156 }
    // A name and a text are one line each: line ends and tabs become
    // blanks, blanks at the ends go; so what is set is what a preset
    // file gives back, and a text cannot add lines of its own.
    types.defaults(changed)
    types.setName(changed, " \t Wet\nbrush\r  ")
    types.setText(changed, "a = 1\nengine = warp-drive\nsize = 3")
    if !std.text.same(types.nameOf(changed), "Wet brush") || !std.text.same(types.textOf(changed), "a = 1 engine = warp-drive size = 3") { return 158 }
    text.clearRetainingCapacity()
    if !types.write(changed, &text) || !types.parse(text.items(), back) || difference(changed, back) != 0 || back.*.size != 40.0 { return 158 }
    // Cut to NAME bytes where a character of UTF-8 begins (no half "ä").
    var long_name = std.ArrayList(u8).init(allocator)
    if !long_name.append(97) { return 159 }
    step = 0
    while step < 40 {
        if !long_name.appendSlice("ä") { return 159 }
        step += 1
    }
    types.setName(changed, long_name.items())
    if changed.*.nameLength != 63 || changed.*.name[61] != 0xC3 || changed.*.name[62] != 0xA4 { return 159 }
    types.setName(changed, "      ")
    if changed.*.nameLength != 0 { return 159 }
    // Writing and reading presets takes nothing from the value arena.
    types.defaults(changed)
    const arena = turns.locate()
    const arena_before = turns.used(arena)
    step = 0
    while step < 300 {
        text.clearRetainingCapacity()
        if !types.write(changed, &text) || !types.parse(text.items(), back) { return 160 }
        step += 1
    }
    if turns.used(arena) - arena_before > 1024 { return 160 }

    // Angles at the turn's ends: a tiny turn back is nearly a whole turn
    // (part 0, not 1); what is no number or no size is 0.
    if dynamics.turnPart(-0.0000000000000000001) != 0.0 || dynamics.turnPart(math.tau) != 0.0 || dynamics.turnPart(math.nan()) != 0.0 || dynamics.turnPart(1.0e300) != 0.0 { return 161 }
    if !close(dynamics.turnPart(0.0 - math.pi * 0.5), 0.75) || !close(dynamics.turnPart(math.tau * 3.0 + math.pi), 0.5) { return 161 }
    // A piece that goes back in time keeps the speed (as one without
    // duration does); the speed never reads beyond 0..1.
    sensor = sensorOf(types.SENSOR_SPEED)
    dynamics.start(&state, 1, &origin)
    const quick = point.at(300.0, 0.0, 1.0, 1010.0)
    dynamics.segment(&state, &origin, &quick)
    dynamics.place(&state, 1.0, 300.0)
    dynamics.finish(&state)
    const fast = dynamics.speed(&state)
    if !(fast > 3.0) || dynamics.value(&sensor, &state, 0) != 1.0 { return 162 }
    const back_in_time = point.at(310.0, 0.0, 1.0, 900.0)
    dynamics.segment(&state, &quick, &back_in_time)
    dynamics.place(&state, 1.0, 10.0)
    if dynamics.speed(&state) != fast { return 162 }
    const nowhere = point.at(math.nan(), 0.0, math.nan(), math.nan())
    dynamics.segment(&state, &back_in_time, &nowhere)
    state.point = nowhere
    dynamics.place(&state, 0.5, 0.0)
    const reading = dynamics.value(&sensor, &state, 0)
    if !(reading >= 0.0 && reading <= 1.0) { return 162 }
    // A pressure that is no number reads as none, through any curve.
    sensor = sensorOf(types.SENSOR_PRESSURE)
    if dynamics.value(&sensor, &state, 0) != 0.0 { return 163 }
    const curve_room = allocator.alloc(types.SENSORS * 256 * 4, 16)
    if curve_room == null { return 163 }
    const curves: [*]f32 = unsafe { @ptrCast([*]f32, curve_room.?) }
    var lifted: types.Option = undefined
    types.defaultOption(&lifted)
    lifted.on = true
    const lift_x = [2]f64{ 0.0, 1.0 }
    const lift_y = [2]f64{ 0.25, 1.0 }
    lifted.sensors[0].curve = curve.fromPoints(lift_x[0..], lift_y[0..])
    dynamics.bake(&lifted, curves)
    if !roughly(dynamics.evaluate(&lifted, curves, &state, 0), 0.25, 0.0000001) { return 163 }
    state.point.pressure = 0.5
    if !roughly(dynamics.evaluate(&lifted, curves, &state, 0), 0.625, 0.0000001) { return 163 }
    allocator.free(curve_room.?, types.SENSORS * 256 * 4, 16)
    // The registry hands out the same records every time.
    if @intFromPtr(engines.at(0).?) != @intFromPtr(engines.at(0).?) || @intFromPtr(engines.byKey("paintbrush").?) != @intFromPtr(engines.find(types.ENGINE_PAINTBRUSH).?) { return 164 }

    // The tip a preset names by key.
    if !types.parse("tip.kind = predefined\ntip.predefined = star\n", back) || back.*.tip.kind != types.TIP_PREDEFINED || @intCast(usize, back.*.tip.predefined) != tip.predefinedByKey("star").? { return 157 }
    return 13
}
