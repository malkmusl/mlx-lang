// nebula's overlays made the layer's own: a tool's overlay merged into a
// layer as it showed (opacity, blend mode, the selection, locked alpha),
// across tiles and for a layer that was moved, one undoable step; and an
// overlay dropped. Exits 13.
const std = @import("std")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const node = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const render = @import("../core/render.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")

const RED: u32 = 0xFFFF0000
const BLUE: u32 = 0xFF0000FF

fn shown(image: *image_module.Image, x: i32, y: i32) -> u32 {
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const image = image_module.create(allocator, 400, 300, 72.0).?
    const layer = ops.newLayer(image, node.PAINT, "Layer", "New layer").?
    _ = ops.beginPixels(image, layer)
    _ = device.fill(layer.*.device.?, geom.rect(0, 0, 200, 300), RED)
    _ = ops.endPixels(image, layer, "Fill")
    // The layer sits elsewhere than its tiles' grid.
    device.begin(layer.*.device.?)
    device.moveBy(layer.*.device.?, 7, 5)
    _ = device.commit(layer.*.device.?)
    image_module.damageAll(image)
    if shown(image, 7, 5) != RED || shown(image, 6, 5) != 0 { return 1 }

    // A blue band at half opacity over red and over nothing.
    const band = device.create(allocator, 0).?
    _ = device.fill(band, geom.rect(100, 60, 200, 10), BLUE)
    layer.*.overlay = band
    layer.*.overlayOpacity = 128
    layer.*.overlayBlend = blend.NORMAL
    layer.*.overlayMasked = false
    image_module.damage(image, device.extent(band))
    const over_red = shown(image, 150, 65)
    const over_nothing = shown(image, 250, 65)
    if over_red != pixel.over(RED, BLUE, 128) || over_nothing != 0x800000FF { return 2 }
    const steps = history.stepsDone(image.*.history)
    const area = ops.mergeOverlay(image, layer, "Stroke")
    if geom.isEmpty(area) || layer.*.overlay != null { return 3 }
    if device.pixel(layer.*.device.?, 150, 65) != over_red || device.pixel(layer.*.device.?, 250, 65) != over_nothing { return 4 }
    if shown(image, 150, 65) != over_red || shown(image, 250, 65) != over_nothing || shown(image, 150, 75) != RED { return 5 }
    if history.stepsDone(image.*.history) != steps + 1 || !std.text.same(history.undoName(image.*.history), "Stroke") { return 6 }
    _ = history.undo(image.*.history, image)
    if shown(image, 150, 65) != RED || shown(image, 250, 65) != 0 { return 7 }
    _ = history.redo(image.*.history, image)
    if shown(image, 150, 65) != over_red { return 8 }

    // Masked by the selection and with alpha locked: only on paint, only
    // in the selection.
    ops.beginSelection(image)
    _ = device.fill(image.*.selection, geom.rect(0, 0, 180, 300), mask.ALL)
    ops.endSelection(image, true, "Select")
    const second = device.create(allocator, 0).?
    _ = device.fill(second, geom.rect(100, 100, 250, 10), BLUE)
    layer.*.overlay = second
    layer.*.overlayOpacity = 255
    layer.*.overlayMasked = true
    layer.*.alphaLocked = true
    _ = ops.mergeOverlay(image, layer, "Stroke")
    if device.pixel(layer.*.device.?, 150, 105) != BLUE { return 9 }
    if device.pixel(layer.*.device.?, 190, 105) != RED { return 10 }
    if device.pixel(layer.*.device.?, 250, 105) != 0 { return 11 }

    // Erasing through an overlay.
    layer.*.alphaLocked = false
    ops.beginSelection(image)
    ops.endSelection(image, false, "Deselect")
    const rubber = device.create(allocator, 0).?
    _ = device.fill(rubber, geom.rect(20, 200, 10, 10), 0xFF000000)
    layer.*.overlay = rubber
    layer.*.overlayBlend = blend.ERASE
    layer.*.overlayOpacity = 255
    _ = ops.mergeOverlay(image, layer, "Erase")
    if device.pixel(layer.*.device.?, 25, 205) != 0 || device.pixel(layer.*.device.?, 35, 205) != RED { return 12 }

    // Dropped: nothing stays.
    const dropped = device.create(allocator, 0).?
    _ = device.fill(dropped, geom.rect(0, 0, 50, 50), BLUE)
    layer.*.overlay = dropped
    layer.*.overlayBlend = blend.NORMAL
    image_module.damageAll(image)
    if shown(image, 10, 10) != BLUE { return 14 }
    const before = history.stepsDone(image.*.history)
    _ = ops.dropOverlay(image, layer)
    if shown(image, 10, 10) != RED || history.stepsDone(image.*.history) != before { return 15 }
    if geom.isEmpty(ops.mergeOverlay(image, layer, "Nothing")) == false { return 16 }
    image_module.destroy(image)
    return 13
}
