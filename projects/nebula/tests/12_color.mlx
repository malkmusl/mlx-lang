// nebula's colours (core/color.mlx): the six primaries and secondaries
// through every model against the numbers they must give; the greys, whose
// hue and saturation are 0 everywhere; hues that wrap and values held to
// their range; 50000 pseudo-random colours there and back through every
// model (HSV, HSL, HSI, HSY, linear light, XYZ, Lab, LCh, CMYK, YCbCr),
// and every lightness and saturation set on them; the sRGB tables
// against the exact curve; Lab of white and of sRGB's primaries against
// published values; colours read and written as hex; the colour of a
// temperature; black or white on a colour; the W3C compositing
// specification's SetLum and SetSat on examples worked out by hand, and
// its Lum, SetLum, SetSat and four non-separable modes against its
// pseudo-code written down here; how far apart pixels are; mixing in
// linear light; a grid of 64000 colours with each channel's first and
// last six bytes there and back through every model; chromas a rounding
// above nothing and model numbers past the last. None of it takes memory
// of the value arena. Exits 13.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")
const color = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")

// Red, yellow, green, cyan, blue, magenta: the hues 0/6 to 5/6.
const WHEEL: [6]u32 = [6]u32{ 0xFFFF0000, 0xFFFFFF00, 0xFF00FF00, 0xFF00FFFF, 0xFF0000FF, 0xFFFF00FF }
const LUMA_601: [6]f64 = [6]f64{ 0.299, 0.886, 0.587, 0.701, 0.114, 0.413 }
const LUMA_709: [6]f64 = [6]f64{ 0.2126, 0.9278, 0.7152, 0.7874, 0.0722, 0.2848 }
const LUMA_W3C: [6]f64 = [6]f64{ 0.3, 0.89, 0.59, 0.7, 0.11, 0.41 }
// 0.5 + (B - Y) / 1.772 and 0.5 + (R - Y) / 1.402 with Y of Rec. 601.
const CB: [6]f64 = [6]f64{ 0.3312641083521445, 0.0, 0.16873589164785557, 0.6687358916478555, 1.0, 0.8312641083521444 }
const CR: [6]f64 = [6]f64{ 1.0, 0.5813124108416549, 0.0813124108416548, 0.0, 0.4186875891583452, 0.9186875891583453 }
// IEC 61966-2-1's matrix as published, to four digits: X, Y, Z of red,
// green and blue.
const XYZ_PUBLISHED: [9]f64 = [9]f64{ 0.4124, 0.2126, 0.0193, 0.3576, 0.7152, 0.1192, 0.1805, 0.0722, 0.9505 }
// Lab (D50, Bradford) of sRGB's red, green and blue as Bruce Lindbloom's
// calculator publishes them.
const LAB_PUBLISHED: [9]f64 = [9]f64{ 54.2917, 80.8125, 69.8851, 87.8181, -79.2873, 80.9902, 29.5676, 68.2986, -112.0294 }
// The same for all six, worked out apart from the module with exact
// fractions for the matrices (D65 of x 0.3127, y 0.3290; D50 0.9642, 1,
// 0.8249).
const LAB: [18]f64 = [18]f64{ 54.289632, 80.814356, 69.889742, 97.607388, -15.747929, 93.391258, 87.819406, -79.274942, 80.992723, 90.666407, -50.663054, -14.961013, 29.565939, 68.286208, -112.032919, 60.167321, 93.546663, -60.502719 }

var seed: u64 = 0x9E3779B97F4A7C15

// 24 pseudo-random bits: a colour.
fn next() -> u32 {
    seed = seed *% 6364136223846793005 +% 1442695040888963407
    return @intCast(u32, seed >> 40)
}

fn near(a: f64, b: f64, within: f64) -> bool {
    return math.abs(a - b) <= within
}

fn near3(a: f64, b: f64, c: f64, x: f64, y: f64, z: f64, within: f64) -> bool {
    return near(a, x, within) && near(b, y, within) && near(c, z, within)
}

// Whether a colour is inside 0..1 but for a rounding.
fn inside(r: f64, g: f64, b: f64) -> bool {
    return r >= -1.0e-12 && g >= -1.0e-12 && b >= -1.0e-12 && r <= 1.0 + 1.0e-12 && g <= 1.0 + 1.0e-12 && b <= 1.0 + 1.0e-12
}

// Whether a colour is inside 0..1 to the last digit.
fn within(r: f64, g: f64, b: f64) -> bool {
    return r >= 0.0 && r <= 1.0 && g >= 0.0 && g <= 1.0 && b >= 0.0 && b <= 1.0
}

// 48 pseudo-random bits as a number from 0 up to, not including, 1.
fn fraction() -> f64 {
    const high = @floatFromInt(f64, next())
    const low = @floatFromInt(f64, next())
    return (high * 16777216.0 + low) / 281474976710656.0
}

// The same, but three times in sixteen an end of 0..1, a number a few
// roundings beside one, or one so small it has lost digits (5e-324 and
// its first multiples, up to some 1e-307): where arithmetic gives way
// first.
fn edgy() -> f64 {
    const pick = next() & 31
    if pick == 0 { return 0.0 }
    if pick == 1 { return 1.0 }
    if pick == 2 { return @floatFromInt(f64, next() & 1023) * 1.0e-19 }
    if pick == 3 { return 1.0 - @floatFromInt(f64, next() & 1023) * 1.1102230246251565e-16 }
    if pick == 4 { return @bitCast(f64, @intCast(u64, next() & 1023)) }
    if pick == 5 { return @floatFromInt(f64, next() & 1023) * 1.0e-310 }
    return fraction()
}

// The number next above `value` (a positive one).
fn above(value: f64) -> f64 {
    return @bitCast(f64, @bitCast(u64, value) + 1)
}

// The number next below `value` (a positive one).
fn below(value: f64) -> f64 {
    return @bitCast(f64, @bitCast(u64, value) - 1)
}

// The textbook's hue in degrees, 0 for a grey: 60 times (g - b) / d,
// (b - r) / d + 2 or (r - g) / d + 4 by which channel is the largest, d
// the largest less the smallest.
fn classicHue(r: f64, g: f64, b: f64) -> f64 {
    const high = math.max(r, math.max(g, b))
    const delta = high - math.min(r, math.min(g, b))
    if delta == 0.0 { return 0.0 }
    var sixths: f64 = 0.0
    if high == r {
        sixths = (g - b) / delta
    } else if high == g {
        sixths = (b - r) / delta + 2.0
    } else {
        sixths = (r - g) / delta + 4.0
    }
    if sixths < 0.0 { sixths += 6.0 }
    return sixths * 60.0
}

// How far two hues in degrees are apart, the short way round.
fn degreesApart(a: f64, b: f64) -> f64 {
    const apart = math.abs(a - b)
    return if apart > 180.0 { 360.0 - apart } else { apart }
}

// The textbook's colour of a hue (a part of the turn below 1), a chroma
// `c` and what is under it, `m`: (C, X, 0), (X, C, 0), (0, C, X),
// (0, X, C), (X, 0, C), (C, 0, X) by the sixth of the turn, each plus m,
// X = C (1 - |h' mod 2 - 1|) and h' the hue in sixths.
fn classicColor(hue: f64, c: f64, m: f64, r: *f64, g: *f64, b: *f64) -> void {
    const sixths = hue * 6.0
    const pair = sixths - 2.0 * @floor(sixths / 2.0)
    const x = c * (1.0 - math.abs(pair - 1.0))
    var r1: f64 = c
    var g1: f64 = 0.0
    var b1: f64 = x
    if sixths < 1.0 {
        g1 = x
        b1 = 0.0
    } else if sixths < 2.0 {
        r1 = x
        g1 = c
        b1 = 0.0
    } else if sixths < 3.0 {
        r1 = 0.0
        g1 = c
    } else if sixths < 4.0 {
        r1 = 0.0
        g1 = x
        b1 = c
    } else if sixths < 5.0 {
        r1 = x
        b1 = c
    }
    r.* = r1 + m
    g.* = g1 + m
    b.* = b1 + m
}

// Whether two colours have one hue (those that have one at all).
fn sameHue(r: f64, g: f64, b: f64, x: f64, y: f64, z: f64) -> bool {
    if color.chroma(r, g, b) < 1.0e-4 || color.chroma(x, y, z) < 1.0e-4 { return true }
    var h1: f64 = 0.0
    var h2: f64 = 0.0
    var s: f64 = 0.0
    var v: f64 = 0.0
    color.rgbToHsv(r, g, b, &h1, &s, &v)
    color.rgbToHsv(x, y, z, &h2, &s, &v)
    var apart = math.abs(h1 - h2)
    if apart > 0.5 { apart = 1.0 - apart }
    return apart <= 1.0e-9
}

// Checks 1-29: the primaries and secondaries through every model.
fn wheel() -> u8 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    var r2: f64 = 0.0
    var g2: f64 = 0.0
    var b2: f64 = 0.0
    var k: usize = 0
    while k < 6 {
        const p = WHEEL[k]
        const hue = @floatFromInt(f64, k) / 6.0
        color.toRgb(p, &r, &g, &b)
        if (r != 0.0 && r != 1.0) || (g != 0.0 && g != 1.0) || (b != 0.0 && b != 1.0) { return 1 }

        color.rgbToHsv(r, g, b, &h, &s, &l)
        if h != hue || s != 1.0 || l != 1.0 { return 2 }
        color.hsvToRgb(h, s, l, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-15) || color.fromHsv(hue, 1.0, 1.0, 255) != p { return 3 }

        color.rgbToHsl(r, g, b, &h, &s, &l)
        if h != hue || s != 1.0 || l != 0.5 { return 4 }
        color.hslToRgb(h, s, l, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-15) || color.fromHsl(hue, 1.0, 0.5, 255) != p { return 5 }

        // A primary is a third as bright as white, a secondary two.
        color.rgbToHsi(r, g, b, &h, &s, &l)
        if h != hue || s != 1.0 || !near(l, if k % 2 == 0 { 1.0 / 3.0 } else { 2.0 / 3.0 }, 1.0e-15) { return 6 }
        color.hsiToRgb(h, s, l, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-15) { return 7 }

        color.rgbToHsy(color.REC601, r, g, b, &h, &s, &l)
        if h != hue || s != 1.0 || !near(l, LUMA_601[k], 1.0e-15) { return 8 }
        color.hsyToRgb(color.REC601, h, s, l, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-15) { return 9 }
        color.rgbToHsy(color.REC709, r, g, b, &h, &s, &l)
        if h != hue || s != 1.0 || !near(l, LUMA_709[k], 1.0e-15) { return 10 }
        color.hsyToRgb(color.REC709, h, s, l, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-15) { return 11 }
        color.rgbToHsy(color.W3C, r, g, b, &h, &s, &l)
        if h != hue || s != 1.0 || !near(l, LUMA_W3C[k], 1.0e-15) { return 12 }
        color.hsyToRgb(color.W3C, h, s, l, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-15) { return 14 }

        // The same through the model's number, and lum and sat of it.
        color.rgbToModel(color.HSY709, r, g, b, &h, &s, &l)
        if h != hue || s != 1.0 || !near(l, LUMA_709[k], 1.0e-15) { return 15 }
        if !near(color.lum(color.HSY, r, g, b), LUMA_601[k], 1.0e-15) || !near(color.lum(color.HSY_W3C, r, g, b), LUMA_W3C[k], 1.0e-15) { return 16 }
        if color.lum(color.HSV, r, g, b) != 1.0 || color.lum(color.HSL, r, g, b) != 0.5 || color.sat(color.HSV, r, g, b) != 1.0 || color.sat(color.HSL, r, g, b) != 1.0 || color.sat(color.HSI, r, g, b) != 1.0 || color.sat(color.HSY, r, g, b) != 1.0 { return 17 }
        if !near(color.lumaOf(p, color.REC601), LUMA_601[k], 1.0e-15) || !near(color.lumaOf(p, color.REC709), LUMA_709[k], 1.0e-15) || !near(color.lumaOf(p, color.W3C), LUMA_W3C[k], 1.0e-15) { return 18 }

        // No black in any of the six: each ink is what its channel lacks.
        var c: f64 = 0.0
        var m: f64 = 0.0
        var y: f64 = 0.0
        var black: f64 = 0.0
        color.rgbToCmyk(r, g, b, &c, &m, &y, &black)
        if c != 1.0 - r || m != 1.0 - g || y != 1.0 - b || black != 0.0 { return 19 }
        color.cmykToRgb(c, m, y, black, &r2, &g2, &b2)
        if r2 != r || g2 != g || b2 != b { return 20 }

        var cb: f64 = 0.0
        var cr: f64 = 0.0
        color.rgbToYcbcr(r, g, b, &y, &cb, &cr)
        if !near3(y, cb, cr, LUMA_601[k], CB[k], CR[k], 1.0e-15) { return 21 }
        color.ycbcrToRgb(y, cb, cr, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-15) { return 22 }

        // The six are their own linear light (0 and 1 stay 0 and 1).
        if !near(color.srgbToLinear(r), r, 1.0e-15) || !near(color.linearToSrgb(g), g, 1.0e-15) || !near(color.linear8(pixel.blue(p)), b, 1.0e-15) { return 23 }
        var x: f64 = 0.0
        var z: f64 = 0.0
        color.linearToXyz(r, g, b, &x, &y, &z)
        if k % 2 == 0 {
            const at = (k / 2) * 3
            if !near3(x, y, z, XYZ_PUBLISHED[at], XYZ_PUBLISHED[at + 1], XYZ_PUBLISHED[at + 2], 0.000051) { return 24 }
        }
        if !near(y, color.luminance(p), 0.00005) { return 25 }
        color.xyzToLinear(x, y, z, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-14) { return 26 }

        var light: f64 = 0.0
        var a: f64 = 0.0
        var bb: f64 = 0.0
        color.xyzToLab(x, y, z, &light, &a, &bb)
        if !near3(light, a, bb, LAB[k * 3], LAB[k * 3 + 1], LAB[k * 3 + 2], 0.00001) { return 27 }
        if k % 2 == 0 {
            const at = (k / 2) * 3
            if !near3(light, a, bb, LAB_PUBLISHED[at], LAB_PUBLISHED[at + 1], LAB_PUBLISHED[at + 2], 0.05) { return 28 }
        }
        color.toLab(p, &r2, &g2, &b2)
        if !near3(r2, g2, b2, light, a, bb, 1.0e-12) || color.fromLab(light, a, bb, 255) != p { return 29 }
        k += 1
    }
    return 0
}

// Checks 30-49: the greys, white's XYZ and Lab, Lab's hue.
fn greys() -> u8 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    var r2: f64 = 0.0
    var g2: f64 = 0.0
    var b2: f64 = 0.0
    var darker: f64 = -1.0
    var value: u32 = 0
    while value < 256 {
        const p = pixel.gray(value)
        const level = @floatFromInt(f64, value) / 255.0
        color.toRgb(p, &r, &g, &b)
        if r != level || g != level || b != level { return 30 }
        var model: u8 = 0
        while model < color.MODELS {
            // No hue, no saturation, and the grey itself as lightness.
            h = 9.0
            s = 9.0
            color.rgbToModel(model, r, g, b, &h, &s, &l)
            if h != 0.0 || s != 0.0 || l != level { return 31 }
            color.modelToRgb(model, 0.7, 0.0, level, &r2, &g2, &b2)
            if r2 != level || g2 != level || b2 != level || color.fromRgb(r2, g2, b2, 255) != p { return 32 }
            if color.sat(model, r, g, b) != 0.0 || !near(color.lum(model, r, g, b), level, 1.0e-15) { return 33 }
            model += 1
        }
        // Through the pixel's functions, its alpha kept.
        color.toHsv(pixel.withAlpha(p, value), &h, &s, &l)
        if h != 0.0 || s != 0.0 || l != level || color.fromHsv(h, s, l, value) != pixel.withAlpha(p, value) || color.fromHsv(h, s, l, 255) != p { return 34 }
        color.toHsl(p, &h, &s, &l)
        if h != 0.0 || s != 0.0 || l != level || color.fromHsl(h, s, l, 255 - value) != pixel.withAlpha(p, 255 - value) || color.fromHsl(h, s, l, 255) != p { return 35 }

        // Lab: no a, no b, a lightness that rises with the grey, and LCh
        // reads no hue out of what is left of a and b.
        var light: f64 = 0.0
        var a: f64 = 0.0
        var bb: f64 = 0.0
        color.toLab(p, &light, &a, &bb)
        if !near(a, 0.0, 1.0e-10) || !near(bb, 0.0, 1.0e-10) || light <= darker { return 36 }
        darker = light
        if color.fromLab(light, a, bb, 255) != p || color.fromLab(light, 0.0, 0.0, 255) != p { return 37 }
        var c: f64 = 9.0
        var angle: f64 = 9.0
        color.labToLch(a, bb, &c, &angle)
        if angle != 0.0 || c > 1.0e-10 { return 38 }

        var m: f64 = 0.0
        var y: f64 = 0.0
        var black: f64 = 0.0
        color.rgbToCmyk(r, g, b, &c, &m, &y, &black)
        if c != 0.0 || m != 0.0 || y != 0.0 || !near(black, 1.0 - level, 1.0e-15) { return 39 }
        color.cmykToRgb(c, m, y, black, &r2, &g2, &b2)
        if !near3(r2, g2, b2, level, level, level, 1.0e-15) { return 40 }
        var cb: f64 = 0.0
        var cr: f64 = 0.0
        color.rgbToYcbcr(r, g, b, &y, &cb, &cr)
        if !near3(y, cb, cr, level, 0.5, 0.5, 1.0e-15) { return 41 }
        value += 1
    }

    // White: D65's XYZ, Lab 100, 0, 0; black: 0, 0, 0.
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    color.linearToXyz(1.0, 1.0, 1.0, &x, &y, &z)
    if !near3(x, y, z, 0.3127 / 0.3290, 1.0, (1.0 - 0.3127 - 0.3290) / 0.3290, 1.0e-15) { return 42 }
    var light: f64 = 0.0
    var a: f64 = 0.0
    var bb: f64 = 0.0
    color.xyzToLab(x, y, z, &light, &a, &bb)
    if !near3(light, a, bb, 100.0, 0.0, 0.0, 1.0e-10) { return 43 }
    color.toLab(pixel.WHITE, &light, &a, &bb)
    if !near3(light, a, bb, 100.0, 0.0, 0.0, 1.0e-10) { return 44 }
    color.toLab(pixel.BLACK, &light, &a, &bb)
    if light != 0.0 || a != 0.0 || bb != 0.0 { return 45 }
    // Next to black L is 24389/27 times Y, to the last digit.
    color.linearToXyz(1.0e-9, 1.0e-9, 1.0e-9, &x, &y, &z)
    color.xyzToLab(x, y, z, &light, &a, &bb)
    if !near(light, 24389.0 / 27.0 * 1.0e-9, 1.0e-18) || !near(a, 0.0, 1.0e-12) || !near(bb, 0.0, 1.0e-12) { return 45 }
    color.labToXyz(light, a, bb, &x, &y, &z)
    if !near(y, 1.0e-9, 1.0e-16) { return 45 }
    color.labToXyz(100.0, 0.0, 0.0, &x, &y, &z)
    if !near3(x, y, z, 0.3127 / 0.3290, 1.0, (1.0 - 0.3127 - 0.3290) / 0.3290, 1.0e-14) { return 46 }

    // Lab's hue: a part of the turn from +a toward +b.
    var c: f64 = 0.0
    var angle: f64 = 0.0
    color.labToLch(3.0, 4.0, &c, &angle)
    if !near(c, 5.0, 1.0e-15) || !near(angle, 0.14758361765043326, 1.0e-15) { return 47 }
    color.labToLch(0.0, 2.0, &c, &angle)
    if c != 2.0 || !near(angle, 0.25, 1.0e-15) { return 48 }
    color.labToLch(-2.0, 0.0, &c, &angle)
    if c != 2.0 || !near(angle, 0.5, 1.0e-15) { return 48 }
    color.labToLch(0.0, -2.0, &c, &angle)
    if c != 2.0 || !near(angle, 0.75, 1.0e-15) { return 48 }
    color.labToLch(2.0, 0.0, &c, &angle)
    if c != 2.0 || angle != 0.0 { return 48 }
    color.lchToLab(5.0, 1.25, &a, &bb)
    if !near(a, 0.0, 1.0e-14) || !near(bb, 5.0, 1.0e-14) { return 49 }
    // sRGB's red and blue: the chroma and the hue of their a and b.
    color.toLab(0xFFFF0000, &light, &a, &bb)
    color.labToLch(a, bb, &c, &angle)
    if !near(c, 106.84351, 0.00001) || !near(angle, 0.113483, 0.000001) { return 49 }
    color.toLab(0xFF0000FF, &light, &a, &bb)
    color.labToLch(a, bb, &c, &angle)
    if !near(c, 131.20359, 0.00001) || !near(angle, 0.837120, 0.000001) { return 49 }
    return 0
}

// Checks 50-69: hues that wrap, values held to their range, rounding,
// the curve's own numbers.
fn edges() -> u8 {
    if color.hueToDegrees(0.5) != 180.0 || color.hueToDegrees(-0.25) != 270.0 || color.hueToDegrees(1.0) != 0.0 || color.hueToDegrees(2.75) != 270.0 { return 50 }
    if color.hueFromDegrees(-90.0) != 0.75 || color.hueFromDegrees(720.0) != 0.0 || !near(color.hueFromDegrees(120.0), 1.0 / 3.0, 1.0e-15) || color.hueFromDegrees(math.nan()) != 0.0 { return 51 }
    if color.hueFromDegrees(math.infinity()) != 0.0 || color.hueToDegrees(math.negativeInfinity()) != 0.0 || color.hueToDegrees(-1.0e-30) != 0.0 || color.hueFromDegrees(1.0e300) != 0.0 || !near(color.hueToDegrees(1.0e9 + 0.25), 90.0, 0.0001) { return 51 }

    // A hue wraps, whatever it is; what is no hue at all is red.
    const yellow_green = color.fromHsv(0.25, 1.0, 1.0, 255)
    if yellow_green != 0xFF80FF00 { return 52 }
    if color.fromHsv(1.25, 1.0, 1.0, 255) != yellow_green || color.fromHsv(-0.75, 1.0, 1.0, 255) != yellow_green || color.fromHsv(-3.75, 1.0, 1.0, 255) != yellow_green { return 53 }
    if color.fromHsv(1.0, 1.0, 1.0, 255) != 0xFFFF0000 || color.fromHsv(-1.0e-30, 1.0, 1.0, 255) != 0xFFFF0000 || color.fromHsv(1.0e300, 1.0, 1.0, 255) != 0xFFFF0000 { return 54 }
    if color.fromHsv(math.nan(), 1.0, 1.0, 255) != 0xFFFF0000 || color.fromHsv(math.infinity(), 1.0, 1.0, 255) != 0xFFFF0000 || color.fromHsl(math.negativeInfinity(), 1.0, 0.5, 255) != 0xFFFF0000 { return 55 }
    if color.fromHsl(0.25, 1.0, 0.5, 255) != yellow_green || color.fromHsl(7.25, 1.0, 0.5, 255) != yellow_green { return 56 }

    // A colour a rounding on the magenta side of red is red, not a hue
    // of one whole turn.
    var h: f64 = 9.0
    var s: f64 = 9.0
    var v: f64 = 9.0
    color.rgbToHsv(1.0, 0.5, 0.5000000000000001, &h, &s, &v)
    if h != 0.0 || !near(s, 0.5, 1.0e-15) || v != 1.0 { return 56 }
    color.rgbToHsv(1.0, 0.5, 0.5000001, &h, &s, &v)
    if !(h > 0.9999 && h < 1.0) { return 56 }

    // Saturation and lightness are held to 0..1, an alpha to 255.
    if color.fromHsv(0.0, 2.0, 5.0, 255) != 0xFFFF0000 || color.fromHsv(0.5, -1.0, 0.5, 255) != 0xFF808080 || color.fromHsv(0.5, 1.0, -3.0, 255) != 0xFF000000 { return 57 }
    if color.fromHsl(0.0, 9.0, 0.5, 255) != 0xFFFF0000 || color.fromHsl(0.3, 1.0, 4.0, 255) != 0xFFFFFFFF || color.fromHsl(0.3, 1.0, -4.0, 255) != 0xFF000000 || color.fromHsl(0.3, math.nan(), 0.5, 255) != 0xFF808080 { return 58 }
    if color.fromHsv(0.0, 1.0, 1.0, 0) != 0x00FF0000 || color.fromHsv(0.0, 1.0, 1.0, 7) != 0x07FF0000 || color.fromHsv(0.0, 1.0, 1.0, 900) != 0xFFFF0000 || color.fromHsl(0.0, 1.0, 0.5, 4000000000) != 0xFFFF0000 { return 59 }
    if color.fromRgb(math.nan(), -1.0, 2.0, 300) != 0xFF0000FF || color.fromRgb(0.0, 0.0, 0.0, 0) != 0 || color.fromLab(50.0, 0.0, 0.0, 600) >> 24 != 255 { return 60 }

    // Rounding: the nearest byte, halves up.
    if color.toByte(0.5) != 128 || color.toByte(127.0 / 255.0) != 127 || color.toByte(0.0019) != 0 || color.toByte(0.002) != 1 || color.toByte(0.999) != 255 || color.toByte(0.998) != 254 { return 61 }
    if color.toByte(-0.2) != 0 || color.toByte(1.0) != 255 || color.toByte(1.0e300) != 255 || color.toByte(math.nan()) != 0 || color.toByte(math.infinity()) != 255 || color.toByte(math.negativeInfinity()) != 0 { return 62 }

    // A saturation the lightness has no room for gives way: the hue and
    // the lightness stay. Full red is no brighter than a third (HSI) or
    // than its weight (HSY).
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    color.hsiToRgb(0.0, 1.0, 0.5, &r, &g, &b)
    if !near3(r, g, b, 1.0, 0.25, 0.25, 1.0e-15) { return 63 }
    color.hsiToRgb(0.0, 1.0, 1.0, &r, &g, &b)
    if !near3(r, g, b, 1.0, 1.0, 1.0, 1.0e-15) { return 63 }
    color.hsyToRgb(color.REC601, 0.0, 1.0, 0.6495, &r, &g, &b)
    if !near3(r, g, b, 1.0, 0.5, 0.5, 1.0e-12) || !near(color.luma(color.REC601, r, g, b), 0.6495, 1.0e-15) { return 64 }
    color.hsyToRgb(color.REC601, 2.0 / 3.0, 1.0, 0.057, &r, &g, &b)
    if !near3(r, g, b, 0.0, 0.0, 0.5, 1.0e-12) { return 64 }

    // The curve at numbers known for it.
    if color.srgbToLinear(0.0) != 0.0 || color.linearToSrgb(0.0) != 0.0 || !near(color.srgbToLinear(1.0), 1.0, 1.0e-15) || !near(color.linearToSrgb(1.0), 1.0, 1.0e-15) { return 65 }
    if !near(color.srgbToLinear(0.5), 0.21404114048223255, 1.0e-15) || !near(color.linearToSrgb(0.5), 0.7353569830524495, 1.0e-15) || !near(color.srgbToLinear(0.2), 0.033104766570885055, 1.0e-15) || !near(color.linearToSrgb(0.2), 0.48452920448170694, 1.0e-15) { return 66 }
    // Where the straight piece and the power meet, and below 0.
    if !near(color.srgbToLinear(0.04045), 0.0031308049535603713, 1.0e-17) || !near(color.linearToSrgb(0.0031308), 0.040449936, 1.0e-15) || !near(color.srgbToLinear(-0.1292), -0.01, 1.0e-15) || !near(color.linearToSrgb(-0.01), -0.1292, 1.0e-15) { return 67 }
    if !near(color.srgbToLinear(0.04046), 0.0031316, 0.0000001) || !near(color.linearToSrgb(0.0031309), 0.0404512, 0.0000001) { return 68 }

    // CMYK's black, and YCbCr outside the cube comes back outside 0..1.
    var c: f64 = 9.0
    var m: f64 = 9.0
    var y: f64 = 9.0
    var k: f64 = 9.0
    color.rgbToCmyk(0.0, 0.0, 0.0, &c, &m, &y, &k)
    if c != 0.0 || m != 0.0 || y != 0.0 || k != 1.0 { return 69 }
    color.rgbToCmyk(0.5, 0.25, 0.125, &c, &m, &y, &k)
    if c != 0.0 || m != 0.5 || y != 0.75 || k != 0.5 { return 69 }
    color.cmykToRgb(0.2, 0.4, 0.6, 0.5, &r, &g, &b)
    if !near3(r, g, b, 0.4, 0.3, 0.2, 1.0e-15) { return 69 }
    color.ycbcrToRgb(1.0, 0.5, 1.0, &r, &g, &b)
    if !near(r, 1.701, 1.0e-15) || b != 1.0 || g >= 1.0 { return 69 }
    return 0
}

// Checks 70-99: 50000 colours there and back through every model, and
// every lightness and saturation set on them.
fn sweep() -> u8 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    var r2: f64 = 0.0
    var g2: f64 = 0.0
    var b2: f64 = 0.0
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    var x2: f64 = 0.0
    var y2: f64 = 0.0
    var z2: f64 = 0.0
    var round: usize = 0
    while round < 50000 {
        const bits = next()
        const alpha = next() & 255
        const p = (alpha << 24) | bits
        const target = @floatFromInt(f64, next() & 255) / 255.0
        color.toRgb(p, &r, &g, &b)
        if color.fromRgb(r, g, b, alpha) != p { return 70 }

        var model: u8 = 0
        while model < color.MODELS {
            // There and back: far inside the 1/255 a byte is wide.
            color.rgbToModel(model, r, g, b, &h, &s, &l)
            if !(h >= 0.0 && h < 1.0) || !(s >= 0.0 && s <= 1.0) || !(l >= 0.0 && l <= 1.0) { return 71 }
            if !near(s, color.sat(model, r, g, b), 1.0e-15) || !near(l, color.lum(model, r, g, b), 1.0e-15) { return 72 }
            color.modelToRgb(model, h, s, l, &r2, &g2, &b2)
            if !near3(r2, g2, b2, r, g, b, 1.0e-12) || color.fromRgb(r2, g2, b2, alpha) != p { return 73 }
            // The hue a whole turn further is the same colour.
            color.modelToRgb(model, h - 2.0, s, l, &r2, &g2, &b2)
            if !near3(r2, g2, b2, r, g, b, 1.0e-12) { return 74 }

            // A lightness set is the lightness had, inside the gamut, of
            // the hue there was.
            r2 = r
            g2 = g
            b2 = b
            color.setLum(model, &r2, &g2, &b2, target)
            if !near(color.lum(model, r2, g2, b2), target, 1.0e-12) || !inside(r2, g2, b2) { return 75 }
            if !sameHue(r, g, b, r2, g2, b2) { return 76 }

            // A saturation set leaves the lightness and the hue; HSV and
            // HSL have room for every saturation, HSI and HSY may have
            // less than was asked for.
            r2 = r
            g2 = g
            b2 = b
            color.setSat(model, &r2, &g2, &b2, target)
            if color.chroma(r, g, b) == 0.0 {
                if r2 != r || g2 != g || b2 != b { return 77 }
            } else {
                if !near(color.lum(model, r2, g2, b2), l, 1.0e-12) || !inside(r2, g2, b2) || !sameHue(r, g, b, r2, g2, b2) { return 78 }
                const reached = color.sat(model, r2, g2, b2)
                if model == color.HSV || model == color.HSL {
                    if !near(reached, target, 1.0e-9) { return 79 }
                } else if reached > target + 1.0e-9 {
                    return 80
                }
                // What the model's own way through a hue gives.
                color.modelToRgb(model, h, target, l, &x, &y, &z)
                if !near3(r2, g2, b2, x, y, z, 1.0e-9) { return 81 }
            }
            if model >= color.HSY {
                // For a luma, that is the W3C's SetSat and then SetLum.
                x = r
                y = g
                z = b
                color.setChroma(&x, &y, &z, target)
                if !near(color.chroma(x, y, z), if color.chroma(r, g, b) == 0.0 { 0.0 } else { target }, 1.0e-15) || math.min(x, math.min(y, z)) != 0.0 { return 82 }
                color.setLum(model, &x, &y, &z, l)
                if color.chroma(r, g, b) != 0.0 && !near3(r2, g2, b2, x, y, z, 1.0e-12) { return 83 }
            }
            model += 1
        }

        // The pixel's functions give the very pixel back, not only one
        // within a step of it.
        color.toHsv(p, &h, &s, &l)
        if color.fromHsv(h, s, l, alpha) != p { return 84 }
        color.toHsl(p, &h, &s, &l)
        if color.fromHsl(h, s, l, alpha) != p { return 85 }
        color.toLab(p, &h, &s, &l)
        if color.fromLab(h, s, l, alpha) != p { return 86 }

        // The curve, XYZ, Lab, LCh and all the way back.
        const lr = color.srgbToLinear(r)
        const lg = color.srgbToLinear(g)
        const lb = color.srgbToLinear(b)
        if lr != color.linear8(pixel.red(p)) || lg != color.linear8(pixel.green(p)) || lb != color.linear8(pixel.blue(p)) { return 87 }
        if !near3(color.linearToSrgb(lr), color.linearToSrgb(lg), color.linearToSrgb(lb), r, g, b, 1.0e-12) { return 88 }
        color.linearToXyz(lr, lg, lb, &x, &y, &z)
        color.xyzToLinear(x, y, z, &r2, &g2, &b2)
        if !near3(r2, g2, b2, lr, lg, lb, 1.0e-12) { return 89 }
        var light: f64 = 0.0
        var a: f64 = 0.0
        var bb: f64 = 0.0
        color.xyzToLab(x, y, z, &light, &a, &bb)
        if !(light >= 0.0 && light <= 100.0 + 1.0e-9) || !(a > -80.0 && a < 94.0) || !(bb > -113.0 && bb < 94.0) { return 90 }
        color.labToXyz(light, a, bb, &x2, &y2, &z2)
        if !near3(x2, y2, z2, x, y, z, 1.0e-12) { return 91 }
        var c: f64 = 0.0
        var angle: f64 = 0.0
        color.labToLch(a, bb, &c, &angle)
        if !(angle >= 0.0 && angle < 1.0) || !(c >= 0.0) { return 92 }
        var a2: f64 = 0.0
        var bb2: f64 = 0.0
        color.lchToLab(c, angle, &a2, &bb2)
        if !near(a2, a, 1.0e-9) || !near(bb2, bb, 1.0e-9) { return 93 }
        color.labToXyz(light, a2, bb2, &x2, &y2, &z2)
        color.xyzToLinear(x2, y2, z2, &r2, &g2, &b2)
        if !near3(color.linearToSrgb(r2), color.linearToSrgb(g2), color.linearToSrgb(b2), r, g, b, 1.0e-10) { return 94 }

        var cyan: f64 = 0.0
        var magenta: f64 = 0.0
        var yellow: f64 = 0.0
        var black: f64 = 0.0
        color.rgbToCmyk(r, g, b, &cyan, &magenta, &yellow, &black)
        if !(cyan >= 0.0 && cyan <= 1.0 && magenta >= 0.0 && magenta <= 1.0 && yellow >= 0.0 && yellow <= 1.0 && black >= 0.0 && black <= 1.0) { return 95 }
        if cyan != 0.0 && magenta != 0.0 && yellow != 0.0 { return 95 }
        color.cmykToRgb(cyan, magenta, yellow, black, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-12) { return 96 }
        color.rgbToYcbcr(r, g, b, &y, &x, &z)
        if !(y >= 0.0 && y <= 1.0 && x >= -1.0e-15 && x <= 1.0 + 1.0e-15 && z >= -1.0e-15 && z <= 1.0 + 1.0e-15) { return 97 }
        color.ycbcrToRgb(y, x, z, &r2, &g2, &b2)
        if !near3(r2, g2, b2, r, g, b, 1.0e-12) { return 98 }

        // Luma and luminance stay between the darkest and the brightest
        // channel.
        const dark = math.min(r, math.min(g, b))
        const bright = math.max(r, math.max(g, b))
        if color.lumaOf(p, color.REC709) < dark - 1.0e-15 || color.lumaOf(p, color.W3C) > bright + 1.0e-15 || color.luminance(p) < color.srgbToLinear(dark) - 1.0e-15 || color.luminance(p) > color.srgbToLinear(bright) + 1.0e-15 { return 99 }
        round += 1
    }
    return 0
}

// Checks 100-112: the sRGB tables against the exact curve.
fn tables() -> u8 {
    const to_linear = color.linearTable()
    const to_linear32 = color.linearTable32()
    const to_srgb = color.srgbTable()
    var byte: u32 = 0
    while byte < 256 {
        const exact = color.srgbToLinear(@floatFromInt(f64, byte) / 255.0)
        const index = @intCast(usize, byte)
        if to_linear[index] != exact || color.linear8(byte) != exact { return 100 }
        if to_linear32[index] != @floatCast(f32, exact) { return 101 }
        if index > 0 && !(to_linear[index] > to_linear[index - 1]) { return 102 }
        // A byte comes back from its linear light as itself, by the
        // function and by the table.
        if color.srgb8(exact) != byte { return 103 }
        if @intCast(u32, to_srgb[@intFromFloat(usize, exact * color.SRGB_STEPS + 0.5)]) != byte { return 104 }
        byte += 1
    }
    if to_linear[0] != 0.0 || !near(to_linear[255], 1.0, 1.0e-15) || color.linear8(256 + 7) != to_linear[7] { return 105 }

    // The 4096 steps: from 0 to 255, never falling, never jumping a
    // byte, each the byte of the exact curve.
    if to_srgb[0] != 0 || to_srgb[4095] != 255 || color.SRGB_STEPS != 4095.0 { return 106 }
    var step: usize = 1
    while step < 4096 {
        if to_srgb[step] < to_srgb[step - 1] || to_srgb[step] - to_srgb[step - 1] > 1 { return 107 }
        if @intCast(u32, to_srgb[step]) != color.toByte(color.linearToSrgb(@floatFromInt(f64, step) / 4095.0)) { return 108 }
        step += 1
    }

    // srgb8 is the exact curve rounded, for any linear light (but where
    // the curve is on the border between two bytes to the last digit).
    var round: usize = 0
    var before: u32 = 0
    while round < 50000 {
        const linear = @floatFromInt(f64, round) / 49999.0
        const exact = color.linearToSrgb(linear) * 255.0
        const got = color.srgb8(linear)
        const part = exact + 0.5 - @floor(exact + 0.5)
        if part > 1.0e-9 && part < 1.0 - 1.0e-9 && got != color.toByte(exact / 255.0) { return 109 }
        if math.abs(@floatFromInt(f64, got) - exact) > 0.5 + 1.0e-9 || got < before { return 110 }
        before = got
        round += 1
    }
    if color.srgb8(0.0) != 0 || color.srgb8(1.0) != 255 || color.srgb8(-5.0) != 0 || color.srgb8(7.0) != 255 || color.srgb8(math.nan()) != 0 || color.srgb8(math.infinity()) != 255 { return 111 }
    // 18 % grey is byte 118, half the light byte 188.
    if color.srgb8(0.18) != 118 || color.srgb8(0.5) != 188 || color.srgb8(0.0003) != 1 || color.srgb8(0.0001) != 0 { return 112 }
    return 0
}

// Checks 140-159: colours as hex.
fn hex() -> u8 {
    var typed: u32 = 7
    if !color.parseHex("#f80", &typed) || typed != 0xFFFF8800 { return 140 }
    if !color.parseHex("F80", &typed) || typed != 0xFFFF8800 { return 141 }
    if !color.parseHex("#FF8800", &typed) || typed != 0xFFFF8800 { return 142 }
    if !color.parseHex("12abEF", &typed) || typed != 0xFF12ABEF { return 143 }
    if !color.parseHex("#80ff8800", &typed) || typed != 0x80FF8800 { return 144 }
    if !color.parseHex("00FFFFFF", &typed) || typed != 0x00FFFFFF { return 145 }
    if !color.parseHex("  #abc\t\n", &typed) || typed != 0xFFAABBCC { return 146 }
    if !color.parseHex("#000", &typed) || typed != 0xFF000000 { return 147 }
    if !color.parseHex("#00000000", &typed) || typed != 0 { return 148 }
    if !color.parseHex("#ffffffff", &typed) || typed != 0xFFFFFFFF { return 149 }

    // What is no colour leaves `into` alone.
    typed = 0x12345678
    if color.parseHex("", &typed) || color.parseHex("#", &typed) || color.parseHex("   ", &typed) || color.parseHex("f", &typed) || color.parseHex("#ff", &typed) { return 150 }
    if color.parseHex("#ffff", &typed) || color.parseHex("#fffff", &typed) || color.parseHex("#fffffff", &typed) || color.parseHex("#fffffffff", &typed) || color.parseHex("ffffffffffffffff", &typed) { return 151 }
    if color.parseHex("#ggg", &typed) || color.parseHex("#ff88zz", &typed) || color.parseHex("ff 800", &typed) || color.parseHex("##fff", &typed) || color.parseHex("0xff8800", &typed) || color.parseHex("#-ff880", &typed) || color.parseHex("#ff8800#", &typed) || color.parseHex("ff\x00800", &typed) { return 152 }
    if typed != 0x12345678 { return 153 }

    var text: [16]u8 = undefined
    const bytes: [*]u8 = &text
    text[7] = 33
    text[9] = 33
    if color.formatHex(0x80FF8800, bytes, false) != 7 || !std.text.same(bytes[0..7], "#ff8800") || text[7] != 33 { return 154 }
    if color.formatHex(0x80FF8800, bytes, true) != 9 || !std.text.same(bytes[0..9], "#80ff8800") || text[9] != 33 { return 155 }
    if color.formatHex(0, bytes, true) != 9 || !std.text.same(bytes[0..9], "#00000000") { return 156 }
    if color.formatHex(0x00ABCDEF, bytes, false) != 7 || !std.text.same(bytes[0..7], "#abcdef") { return 157 }

    // Written and read back, with and without its alpha.
    var round: usize = 0
    while round < 50000 {
        const p = (next() << 8) ^ next()
        var length = color.formatHex(p, bytes, true)
        if length != 9 || !color.parseHex(bytes[0..length], &typed) || typed != p { return 158 }
        length = color.formatHex(p, bytes, false)
        if length != 7 || !color.parseHex(bytes[1..length], &typed) || typed != (p | 0xFF000000) { return 159 }
        round += 1
    }
    return 0
}

// Checks 160-166: the colour of a temperature.
fn kelvin() -> u8 {
    // Near white at 6500 K, the warm and the cold ends, and what the fit
    // gives at temperatures people know.
    const daylight = color.kelvinToRgb(6500)
    if daylight != 0xFFFFFEFA || color.distanceRgb(daylight, pixel.WHITE) > 5 { return 160 }
    if color.kelvinToRgb(1000) != 0xFFFF4400 || color.kelvinToRgb(2000) != 0xFFFF890E || color.kelvinToRgb(2700) != 0xFFFFA757 || color.kelvinToRgb(5000) != 0xFFFFE4CE { return 161 }
    if color.kelvinToRgb(10000) != 0xFFCADAFF || color.kelvinToRgb(20000) != 0xFFABC6FF || color.kelvinToRgb(40000) != 0xFF98BAFF { return 162 }
    if color.kelvinToRgb(0) != color.kelvinToRgb(1000) || color.kelvinToRgb(999) != 0xFFFF4400 || color.kelvinToRgb(4000000000) != color.kelvinToRgb(40000) { return 163 }
    // Hotter is never redder and never less blue; opaque, and its
    // brightest channel full (red up to 6600 K, blue from there on).
    var degrees: u32 = 1000
    var before = color.kelvinToRgb(degrees)
    while degrees <= 40000 {
        const now = color.kelvinToRgb(degrees)
        if now >> 24 != 255 || pixel.larger(pixel.red(now), pixel.blue(now)) != 255 { return 164 }
        if (degrees <= 6600 && pixel.red(now) != 255) || (degrees >= 6600 && pixel.blue(now) != 255) { return 164 }
        if pixel.red(now) > pixel.red(before) || pixel.blue(now) < pixel.blue(before) { return 165 }
        if degrees <= 6600 && pixel.green(now) < pixel.green(before) { return 166 }
        before = now
        degrees += 50
    }
    return 0
}

// Checks 170-179: luminance, and black or white on a colour.
fn contrast() -> u8 {
    if color.luminance(pixel.BLACK) != 0.0 || !near(color.luminance(pixel.WHITE), 1.0, 1.0e-15) { return 170 }
    if !near(color.luminance(0xFFFF0000), 0.2126, 1.0e-15) || !near(color.luminance(0xFF00FF00), 0.7152, 1.0e-15) || !near(color.luminance(0xFF0000FF), 0.0722, 1.0e-15) { return 171 }
    if !near(color.luminance(0xFF808080), 0.21586050011389926, 1.0e-15) || color.luminance(0x00808080) != color.luminance(0xFF808080) { return 172 }
    if color.contrastColor(pixel.BLACK) != pixel.WHITE || color.contrastColor(pixel.WHITE) != pixel.BLACK || color.contrastColor(0) != pixel.WHITE || color.contrastColor(0x00FFFFFF) != pixel.BLACK { return 173 }
    // The greys turn at 118: 117 has 5.36 to 1 against white and 4.56
    // against black, 118 has 4.54 and 4.62.
    var value: u32 = 0
    while value < 256 {
        if color.contrastColor(pixel.gray(value)) != (if value < 118 { pixel.WHITE } else { pixel.BLACK }) { return 174 }
        value += 1
    }
    if color.contrastColor(0xFFFF0000) != pixel.BLACK || color.contrastColor(0xFF00FF00) != pixel.BLACK || color.contrastColor(0xFF0000FF) != pixel.WHITE || color.contrastColor(0xFFFFFF00) != pixel.BLACK || color.contrastColor(0xFF800080) != pixel.WHITE { return 175 }
    // Whichever it is, it is the one with the larger ratio.
    var round: usize = 0
    while round < 50000 {
        const p = 0xFF000000 | next()
        const light = color.luminance(p)
        const on_black = (light + 0.05) / 0.05
        const on_white = 1.05 / (light + 0.05)
        const chosen = color.contrastColor(p)
        if chosen != pixel.BLACK && chosen != pixel.WHITE { return 176 }
        if chosen == pixel.BLACK && on_black < on_white - 1.0e-12 { return 177 }
        if chosen == pixel.WHITE && on_white < on_black - 1.0e-12 { return 178 }
        // The better of the two is never worse than 4.58 to 1.
        if math.max(on_black, on_white) < 4.58 { return 179 }
        round += 1
    }
    return 0
}

// Checks 180-209: lum, sat, setLum, setChroma and setSat on examples
// worked out by hand: the W3C compositing specification's Lum, Sat,
// SetLum (with ClipColor) and SetSat, and the same in the other models.
fn bySpecification() -> u8 {
    // C = (1, 0.5, 0.25). Lum = 0.3 + 0.295 + 0.0275.
    if !near(color.lum(color.HSY_W3C, 1.0, 0.5, 0.25), 0.6225, 1.0e-15) || color.chroma(1.0, 0.5, 0.25) != 0.75 { return 180 }
    if color.lum(color.HSV, 1.0, 0.5, 0.25) != 1.0 || color.lum(color.HSL, 1.0, 0.5, 0.25) != 0.625 || !near(color.lum(color.HSI, 1.0, 0.5, 0.25), 1.75 / 3.0, 1.0e-15) { return 181 }
    if !near(color.lum(color.HSY, 1.0, 0.5, 0.25), 0.621, 1.0e-15) || !near(color.lum(color.HSY709, 1.0, 0.5, 0.25), 0.58825, 1.0e-15) { return 182 }
    if color.sat(color.HSV, 1.0, 0.5, 0.25) != 0.75 || color.sat(color.HSL, 1.0, 0.5, 0.25) != 1.0 || !near(color.sat(color.HSI, 1.0, 0.5, 0.25), 4.0 / 7.0, 1.0e-15) || color.sat(color.HSY, 1.0, 0.5, 0.25) != 0.75 || color.sat(color.HSY_W3C, 1.0, 0.5, 0.25) != 0.75 { return 183 }

    // SetLum(C, 0.9): C + 0.2775 = (1.2775, 0.7775, 0.5275), above 1, so
    // ClipColor pulls toward 0.9 by 0.1 / 0.3775.
    var r: f64 = 1.0
    var g: f64 = 0.5
    var b: f64 = 0.25
    color.setLum(color.HSY_W3C, &r, &g, &b, 0.9)
    if !near3(r, g, b, 1.0, 0.8675496688741722, 0.8013245033112583, 1.0e-14) { return 184 }
    // SetLum(C, 0.1): C - 0.5225 = (0.4775, -0.0225, -0.2725), below 0:
    // toward 0.1 by 0.1 / 0.3725.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSY_W3C, &r, &g, &b, 0.1)
    if !near3(r, g, b, 0.20134228187919463, 0.06711409395973154, 0.0, 1.0e-14) { return 185 }
    // SetLum to the lightness there is changes nothing; to 0 and 1 gives
    // black and white; a lightness outside is held.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSY_W3C, &r, &g, &b, 0.6225)
    if !near3(r, g, b, 1.0, 0.5, 0.25, 1.0e-15) { return 186 }
    color.setLum(color.HSY_W3C, &r, &g, &b, 0.0)
    if !near3(r, g, b, 0.0, 0.0, 0.0, 1.0e-15) { return 187 }
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSY_W3C, &r, &g, &b, 7.0)
    if !near3(r, g, b, 1.0, 1.0, 1.0, 1.0e-15) { return 187 }

    // SetSat(C, 0.3): the largest 0.3, the smallest 0, the middle
    // (0.5 - 0.25) * 0.3 / 0.75.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setChroma(&r, &g, &b, 0.3)
    if !near3(r, g, b, 0.3, 0.1, 0.0, 1.0e-15) { return 188 }
    // The same with the channels in another order, and a grey: black.
    r = 0.25
    g = 1.0
    b = 0.5
    color.setChroma(&r, &g, &b, 0.3)
    if !near3(r, g, b, 0.0, 0.3, 0.1, 1.0e-15) { return 189 }
    r = 0.4
    g = 0.4
    b = 0.4
    color.setChroma(&r, &g, &b, 0.3)
    if r != 0.0 || g != 0.0 || b != 0.0 { return 190 }

    // The "saturation" mode, SetLum(SetSat(Cb, Sat(Cs)), Lum(Cb)), with
    // Cb = C and Cs = (0.2, 0.6, 0.4), Sat 0.4: SetSat gives
    // (0.4, 0.1333, 0) of Lum 0.198667, SetLum adds 0.423833.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setChroma(&r, &g, &b, color.chroma(0.2, 0.6, 0.4))
    color.setLum(color.HSY_W3C, &r, &g, &b, 0.6225)
    if !near3(r, g, b, 0.8238333333333333, 0.5571666666666667, 0.4238333333333333, 1.0e-14) { return 191 }
    // setSat is that in one.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setSat(color.HSY_W3C, &r, &g, &b, color.sat(color.HSY_W3C, 0.2, 0.6, 0.4))
    if !near3(r, g, b, 0.8238333333333333, 0.5571666666666667, 0.4238333333333333, 1.0e-14) { return 192 }

    // The "hue" mode with blue over yellow (Sat 1, Lum 0.89): SetSat
    // leaves blue, SetLum adds 0.78 to (0.78, 0.78, 1.78), clipped
    // toward 0.89 by 0.11 / 0.89.
    r = 0.0
    g = 0.0
    b = 1.0
    color.setChroma(&r, &g, &b, color.chroma(1.0, 1.0, 0.0))
    color.setLum(color.HSY_W3C, &r, &g, &b, color.lum(color.HSY_W3C, 1.0, 1.0, 0.0))
    if !near3(r, g, b, 0.8764044943820225, 0.8764044943820225, 1.0, 1.0e-14) { return 193 }
    // The "colour" mode, SetLum(Cs, Lum(Cb)): Cs + 0.1645, and the
    // "luminosity" mode, SetLum(Cb, Lum(Cs)): Cb - 0.1645.
    r = 0.2
    g = 0.6
    b = 0.4
    color.setLum(color.HSY_W3C, &r, &g, &b, 0.6225)
    if !near3(r, g, b, 0.3645, 0.7645, 0.5645, 1.0e-14) { return 194 }
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSY_W3C, &r, &g, &b, color.lum(color.HSY_W3C, 0.2, 0.6, 0.4))
    if !near3(r, g, b, 0.8355, 0.3355, 0.0855, 1.0e-14) { return 195 }

    // The other models' lightness set on C. Value 0.5: C - 0.5 is
    // (0.5, 0, -0.25), toward 0.5 by 0.5 / 0.75.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSV, &r, &g, &b, 0.5)
    if !near3(r, g, b, 0.5, 1.0 / 6.0, 0.0, 1.0e-15) { return 196 }
    // Lightness 0.25: C - 0.375 is (0.625, 0.125, -0.125), toward 0.25
    // by 0.25 / 0.375.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSL, &r, &g, &b, 0.25)
    if !near3(r, g, b, 0.5, 1.0 / 6.0, 0.0, 1.0e-15) { return 197 }
    // Intensity 0.9: C + 0.316667 is (1.316667, 0.816667, 0.566667),
    // toward 0.9 by 0.1 / 0.416667.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSI, &r, &g, &b, 0.9)
    if !near3(r, g, b, 1.0, 0.88, 0.82, 1.0e-14) { return 198 }
    // Luma (Rec. 601) 0.8: C + 0.179 is (1.179, 0.679, 0.429), toward
    // 0.8 by 0.2 / 0.379.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setLum(color.HSY, &r, &g, &b, 0.8)
    if !near3(r, g, b, 1.0, 0.8 - 0.121 * 0.2 / 0.379, 0.8 - 0.371 * 0.2 / 0.379, 1.0e-14) { return 199 }

    // The other models' saturation set on C. HSV 0.5: the value stays,
    // the others close in on it by 0.5 / 0.75.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setSat(color.HSV, &r, &g, &b, 0.5)
    if !near3(r, g, b, 1.0, 2.0 / 3.0, 0.5, 1.0e-15) { return 200 }
    // HSL 0.5 (of 1): half as far from the lightness 0.625.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setSat(color.HSL, &r, &g, &b, 0.5)
    if !near3(r, g, b, 0.8125, 0.5625, 0.4375, 1.0e-15) { return 201 }
    // HSI 0.2 (of 4/7): 0.35 as far from the intensity 0.583333.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setSat(color.HSI, &r, &g, &b, 0.2)
    if !near3(r, g, b, 0.7291666666666666, 0.5541666666666667, 0.4666666666666667, 1.0e-14) { return 202 }
    // HSI 1: there is no room for more than there is, C stays.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setSat(color.HSI, &r, &g, &b, 1.0)
    if !near3(r, g, b, 1.0, 0.5, 0.25, 1.0e-14) { return 203 }
    // HSY 0.3 (of 0.75): 0.4 as far from the luma 0.621.
    r = 1.0
    g = 0.5
    b = 0.25
    color.setSat(color.HSY, &r, &g, &b, 0.3)
    if !near3(r, g, b, 0.621 + 0.379 * 0.4, 0.621 - 0.121 * 0.4, 0.621 - 0.371 * 0.4, 1.0e-14) { return 204 }
    // No saturation is the grey of the lightness; a grey stays a grey
    // whatever is asked.
    var model: u8 = 0
    while model < color.MODELS {
        r = 1.0
        g = 0.5
        b = 0.25
        const light = color.lum(model, r, g, b)
        color.setSat(model, &r, &g, &b, 0.0)
        if !near3(r, g, b, light, light, light, 1.0e-15) { return 205 }
        r = 0.4
        g = 0.4
        b = 0.4
        color.setSat(model, &r, &g, &b, 1.0)
        if r != 0.4 || g != 0.4 || b != 0.4 { return 206 }
        color.setLum(model, &r, &g, &b, 0.7)
        if !near3(r, g, b, 0.7, 0.7, 0.7, 1.0e-15) { return 207 }
        model += 1
    }
    if color.weightsOf(color.HSY) != color.REC601 || color.weightsOf(color.HSY709) != color.REC709 || color.weightsOf(color.HSY_W3C) != color.W3C || color.weightsOf(color.HSV) != color.REC601 { return 208 }
    if color.luma(color.REC601, 1.0, 0.5, 0.25) != color.lum(color.HSY, 1.0, 0.5, 0.25) || color.luma(color.REC709, 1.0, 0.5, 0.25) != color.lum(color.HSY709, 1.0, 0.5, 0.25) || color.luma(color.W3C, 1.0, 0.5, 0.25) != color.lum(color.HSY_W3C, 1.0, 0.5, 0.25) { return 209 }
    return 0
}

// Checks 210-237: how far apart pixels are, and mixing in linear light.
fn apart() -> u8 {
    if color.distance(0xFF102030, 0xFF142838) != 8 || color.distance(0xFF142838, 0xFF102030) != 8 || color.distance(0xFF102030, 0xFF102030) != 0 { return 210 }
    if color.distance(pixel.BLACK, pixel.WHITE) != 255 || color.distance(0, pixel.WHITE) != 255 || color.distance(0xFFFF0000, 0xFE00FF00) != 255 || color.distance(0xFF000000, 0x80000000) != 127 { return 211 }
    if color.distance(0xFF112233, 0xF0112234) != 15 || color.distance(0x40112233, 0x41112273) != 64 { return 212 }
    // Next to a fully transparent pixel only the alphas count.
    if color.distance(0x00FF0000, 0x00000000) != 0 || color.distance(0x00FFFFFF, 0x05000000) != 5 || color.distance(0x05000000, 0x00FFFFFF) != 5 || color.distance(0x01FFFFFF, 0x05000000) != 255 { return 213 }
    if color.distanceRgb(0x00FF0000, 0xFF000000) != 255 || color.distanceRgb(0x10203040, 0xF0213243) != 3 || color.distanceRgb(0x10203040, 0xF0203040) != 0 || color.distanceRgb(0xFF00FF00, 0xFF0AF500) != 10 { return 214 }

    // CIE76: black to white is 100; sRGB's primaries by their published
    // Lab.
    if !near(color.deltaE76(pixel.BLACK, pixel.WHITE), 100.0, 1.0e-10) || color.deltaE76(0xFF123456, 0x00123456) != 0.0 { return 215 }
    if !near(color.deltaE76(0xFFFF0000, 0xFF00FF00), 163.939334, 0.00001) || !near(color.deltaE76(0xFFFF0000, 0xFF0000FF), 184.021928, 0.00001) || !near(color.deltaE76(0xFF0000FF, 0xFF00FF00), 249.853273, 0.00001) { return 216 }
    // A step of one byte is far below what an eye notices, but not
    // nothing.
    const step = color.deltaE76(0xFF808080, 0xFF818181)
    if !(step > 0.2 && step < 0.6) { return 217 }

    // Mixing in linear light: the ends are the ends, half the light
    // between black and white is byte 188 (the bytes' middle is 128).
    if color.mixLinear(pixel.BLACK, pixel.WHITE, 0) != pixel.BLACK || color.mixLinear(pixel.BLACK, pixel.WHITE, 255) != pixel.WHITE || color.mixLinear(pixel.BLACK, pixel.WHITE, 999) != pixel.WHITE { return 218 }
    if color.mixLinear(pixel.BLACK, pixel.WHITE, 128) != 0xFFBCBCBC || pixel.mix(pixel.BLACK, pixel.WHITE, 128) != 0xFF808080 || color.mixLinear(pixel.BLACK, pixel.WHITE, 64) != 0xFF898989 || color.mixLinear(pixel.BLACK, pixel.WHITE, 1) != 0xFF0D0D0D { return 219 }
    if color.mixLinearAt(pixel.BLACK, pixel.WHITE, 0.5) != 0xFFBCBCBC || color.mixLinearAt(pixel.BLACK, pixel.WHITE, 0.0003) != 0xFF010101 { return 220 }
    if color.mixLinearAt(0x11223344, 0x55667788, 0.0) != 0x11223344 || color.mixLinearAt(0x11223344, 0x55667788, -3.0) != 0x11223344 || color.mixLinearAt(0x11223344, 0x55667788, math.nan()) != 0x11223344 || color.mixLinearAt(0x11223344, 0x55667788, 1.0) != 0x55667788 || color.mixLinearAt(0x11223344, 0x55667788, 4.0) != 0x55667788 { return 221 }
    // Red to green: the middle is a yellow of 188, not the bytes' 128.
    if color.mixLinearAt(0xFFFF0000, 0xFF00FF00, 0.5) != 0xFFBCBC00 || color.mixLinearAt(0xFFFF0000, 0xFF00FF00, 0.25) != 0xFFE18900 { return 222 }
    // Alpha goes evenly and weighs the colours: a transparent end gives
    // none of its colour; half-transparent red counts half.
    if color.mixLinearAt(0x00FF0000, 0xFF0000FF, 0.5) != 0x800000FF || color.mixLinearAt(0xFF0000FF, 0x00FF0000, 0.5) != 0x800000FF { return 223 }
    if color.mixLinearAt(0x80FF0000, 0xFF0000FF, 0.5) != 0xC09C00D5 { return 224 }
    if color.mixLinearAt(0x00FF0000, 0x0000FF00, 0.5) != 0 || color.mixLinearAt(0x01FF0000, 0x00FF0000, 0.9) != 0 { return 225 }

    var round: usize = 0
    while round < 50000 {
        const a = (next() << 8) ^ next()
        const b = (next() << 8) ^ next()
        const t = next() & 255
        if color.distance(a, b) != color.distance(b, a) || color.distanceRgb(a, b) != color.distanceRgb(b, a) || color.distance(a, a) != 0 { return 226 }
        if color.distanceRgb(a, b) != color.distance(a | 0xFF000000, b | 0xFF000000) || color.distance(a, b) > 255 { return 227 }
        // Never less than the alphas are apart, never more than the
        // farthest channel.
        const alphas = if a >> 24 > b >> 24 { (a >> 24) - (b >> 24) } else { (b >> 24) - (a >> 24) }
        if color.distance(a, b) < alphas || color.distance(a, b) > pixel.larger(alphas, color.distanceRgb(a, b)) { return 228 }
        // A pixel mixed with itself is itself; a mix is between its ends
        // in every channel, and mixed the other way round the same.
        if color.mixLinear(a, a, t) != a && a >> 24 != 0 { return 229 }
        const mixed = color.mixLinear(a, b, t)
        if mixed != color.mixLinear(b, a, 255 - t) && t != 0 && t != 255 { return 230 }
        if pixel.alpha(mixed) < pixel.smaller(a >> 24, b >> 24) || pixel.alpha(mixed) > pixel.larger(a >> 24, b >> 24) { return 231 }
        if mixed >> 24 != 0 && a >> 24 != 0 && b >> 24 != 0 {
            if pixel.red(mixed) < pixel.smaller(pixel.red(a), pixel.red(b)) || pixel.red(mixed) > pixel.larger(pixel.red(a), pixel.red(b)) { return 232 }
            if pixel.green(mixed) < pixel.smaller(pixel.green(a), pixel.green(b)) || pixel.green(mixed) > pixel.larger(pixel.green(a), pixel.green(b)) { return 233 }
            if pixel.blue(mixed) < pixel.smaller(pixel.blue(a), pixel.blue(b)) || pixel.blue(mixed) > pixel.larger(pixel.blue(a), pixel.blue(b)) { return 234 }
        }
        const far = color.deltaE76(a, b)
        if far != color.deltaE76(b, a) || !(far >= 0.0 && far < 260.0) || (far == 0.0) != (color.distanceRgb(a, b) == 0) { return 235 }
        round += 1
    }

    // A gradient from black to white in linear light never falls and
    // takes no step of more than a byte when its positions are fine
    // enough.
    var before: u32 = 0
    var position: u32 = 0
    while position <= 20000 {
        const now = pixel.blue(color.mixLinearAt(pixel.BLACK, pixel.WHITE, @floatFromInt(f64, position) / 20000.0))
        if now < before || now - before > 1 { return 236 }
        before = now
        position += 1
    }
    if before != 255 { return 237 }
    return 0
}

// A mix by the rule itself: the alpha goes evenly, each colour counts by
// its alpha, in linear light by the exact curve and without a table.
// `sure` is false where a channel is on the border between two bytes to
// the last digit.
fn mixedByRule(a: u32, b: u32, position: f64, sure: *bool) -> u32 {
    sure.* = true
    const share_a = @floatFromInt(f64, a >> 24) * (1.0 - position)
    const share_b = @floatFromInt(f64, b >> 24) * position
    const total = share_a + share_b
    const alpha = @intFromFloat(u32, @floor(total + 0.5))
    if alpha == 0 { return 0 }
    var result = alpha << 24
    var shift: u32 = 0
    while shift < 24 {
        const of_a = color.srgbToLinear(@floatFromInt(f64, (a >> shift) & 255) / 255.0)
        const of_b = color.srgbToLinear(@floatFromInt(f64, (b >> shift) & 255) / 255.0)
        const exact = color.linearToSrgb((of_a * share_a + of_b * share_b) / total) * 255.0 + 0.5
        const part = exact - @floor(exact)
        if part < 1.0e-9 || part > 1.0 - 1.0e-9 { sure.* = false }
        const byte = if exact >= 255.0 { 255 } else { @intFromFloat(u32, exact) }
        result = result | (byte << shift)
        shift += 8
    }
    return result
}

// How far apart two pixels are by the rule itself: the largest
// difference of a byte, the alpha's among them with `with_alpha`.
fn apartByRule(a: u32, b: u32, with_alpha: bool) -> u32 {
    var most: u32 = 0
    var shift: u32 = 0
    while shift < 32 {
        if shift < 24 || with_alpha {
            const of_a = (a >> shift) & 255
            const of_b = (b >> shift) & 255
            const apart = if of_a > of_b { of_a - of_b } else { of_b - of_a }
            if apart > most { most = apart }
        }
        shift += 8
    }
    return most
}

// A colour read by the rule itself: blanks off both ends, one '#' may
// lead, then 3, 6 or 8 hex digits and nothing else.
fn readByRule(text: []const u8, into: *u32) -> bool {
    var start: usize = 0
    var end = text.length
    while start < end && (text[start] == 32 || text[start] == 9) { start += 1 }
    while end > start && (text[end - 1] == 32 || text[end - 1] == 9) { end -= 1 }
    if start < end && text[start] == 35 { start += 1 }
    const count = end - start
    if count != 3 && count != 6 && count != 8 { return false }
    var value: u64 = 0
    while start < end {
        const byte = @intCast(u64, text[start])
        var digit: u64 = 0
        if byte >= 48 && byte <= 57 {
            digit = byte - 48
        } else if byte >= 97 && byte <= 102 {
            digit = byte - 87
        } else if byte >= 65 && byte <= 70 {
            digit = byte - 55
        } else {
            return false
        }
        value = value * 16 + digit
        start += 1
    }
    if count == 3 {
        const red = (value >> 8) & 15
        const green = (value >> 4) & 15
        const blue = value & 15
        value = 0xFF000000 + (red * 16 + red) * 65536 + (green * 16 + green) * 256 + blue * 16 + blue
    } else if count == 6 {
        value += 0xFF000000
    }
    into.* = @intCast(u32, value)
    return true
}

// Tanner Helland's fit as he published it: red is full up to 6600 K and a
// power of the hundreds of kelvin less 60 above; green a logarithm up to
// 6600 K and a power above; blue full from 6600 K on, nothing up to
// 1900 K and a logarithm of the hundreds less 10 between; each held to
// 0..255 and rounded.
fn hellandByte(value: f64) -> u32 {
    return if value <= 0.0 { 0 } else if value >= 255.0 { 255 } else { @intFromFloat(u32, value + 0.5) }
}

fn helland(kelvin: u32) -> u32 {
    const hundreds = @floatFromInt(f64, kelvin) / 100.0
    var red: f64 = 255.0
    var green: f64 = 0.0
    var blue: f64 = 255.0
    if hundreds > 66.0 { red = 329.698727446 * math.pow(hundreds - 60.0, -0.1332047592) }
    if hundreds <= 66.0 {
        green = 99.4708025861 * math.ln(hundreds) - 161.1195681661
    } else {
        green = 288.1221695283 * math.pow(hundreds - 60.0, -0.0755148492)
    }
    if hundreds < 66.0 {
        blue = if hundreds <= 19.0 { 0.0 } else { 138.5177312231 * math.ln(hundreds - 10.0) - 305.0447927307 }
    }
    return 0xFF000000 | (hellandByte(red) << 16) | (hellandByte(green) << 8) | hellandByte(blue)
}

// The six orders of 0.2, 0.4 and 0.6: the hues 30, 90 ... 330 degrees.
// In each the value is 0.6 and its saturation 2/3, the lightness 0.4 and
// its saturation 0.5, the intensity 0.4 and its saturation 0.5, the
// chroma 0.4.
const TWELFTHS: [18]f64 = [18]f64{ 0.6, 0.4, 0.2, 0.4, 0.6, 0.2, 0.2, 0.6, 0.4, 0.2, 0.4, 0.6, 0.4, 0.2, 0.6, 0.6, 0.2, 0.4 }
// Lab (D50, Bradford) of 0x336699, 0xC08040, 0x123456, 0x808080, 0x777777
// and 0x010203, worked out apart from the module as LAB above.
const LAB_PIXELS: [6]u32 = [6]u32{ 0xFF336699, 0xFFC08040, 0xFF123456, 0xFF808080, 0xFF777777, 0xFF010203 }
const LAB_OF_PIXELS: [18]f64 = [18]f64{ 41.520684, -4.576345, -33.494110, 59.446547, 21.087104, 44.384180, 20.675350, -2.279144, -24.593119, 53.585013, 0.0, 0.0, 50.034439, 0.0, 0.0, 0.503968, -0.167814, -0.477656 }
// The colour of a temperature by Tanner Helland's fit, worked out apart
// from the module: kelvin, pixel.
const KELVIN: [26]u32 = [26]u32{ 1000, 0xFFFF4400, 1900, 0xFFFF8400, 2000, 0xFFFF890E, 2700, 0xFFFFA757, 5000, 0xFFFFE4CE, 6500, 0xFFFFFEFA, 6599, 0xFFFFFFFD, 6600, 0xFFFFFFFF, 6601, 0xFFFFFCFF, 6700, 0xFFFEF9FF, 10000, 0xFFCADAFF, 20000, 0xFFABC6FF, 40000, 0xFF98BAFF }

var fuzz_text: [16]u8 = undefined

// Checks 113-127: every model against a second, straightforward way of
// working it out (the textbook's formulas, the definitions, the rule a
// comment states), and against numbers worked out apart from the module.
fn reference() -> u8 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    var round: usize = 0
    while round < 50000 {
        // From RGB: the textbook's HSV and HSL, HSI's and HSY's
        // definitions. (An 8-bit colour: near black and white an HSL
        // saturation is a quotient of two roundings.)
        const p = next()
        color.toRgb(p, &r, &g, &b)
        const high = math.max(r, math.max(g, b))
        const low = math.min(r, math.min(g, b))
        const delta = high - low
        const degrees = classicHue(r, g, b)
        color.rgbToHsv(r, g, b, &h, &s, &l)
        if degreesApart(color.hueToDegrees(h), degrees) > 1.0e-9 || !near(s, if high == 0.0 { 0.0 } else { delta / high }, 1.0e-12) || l != high { return 113 }
        color.rgbToHsl(r, g, b, &h, &s, &l)
        const middle = (high + low) / 2.0
        if degreesApart(color.hueToDegrees(h), degrees) > 1.0e-9 || !near(s, if delta == 0.0 { 0.0 } else { delta / (1.0 - math.abs(2.0 * middle - 1.0)) }, 1.0e-12) || !near(l, middle, 1.0e-15) { return 115 }
        color.rgbToHsi(r, g, b, &h, &s, &l)
        const mean = (r + g + b) / 3.0
        if degreesApart(color.hueToDegrees(h), degrees) > 1.0e-9 || !near(s, if delta == 0.0 { 0.0 } else { 1.0 - low / mean }, 1.0e-12) || !near(l, mean, 1.0e-15) { return 117 }
        color.rgbToHsy(color.REC601, r, g, b, &h, &s, &l)
        if degreesApart(color.hueToDegrees(h), degrees) > 1.0e-9 || !near(s, delta, 1.0e-15) || !near(l, 0.299 * r + 0.587 * g + 0.114 * b, 1.0e-15) { return 117 }
        color.rgbToHsy(color.REC709, r, g, b, &h, &s, &l)
        if !near(s, delta, 1.0e-15) || !near(l, 0.2126 * r + 0.7152 * g + 0.0722 * b, 1.0e-15) { return 117 }
        color.rgbToHsy(color.W3C, r, g, b, &h, &s, &l)
        if !near(s, delta, 1.0e-15) || !near(l, 0.3 * r + 0.59 * g + 0.11 * b, 1.0e-15) { return 117 }

        // To RGB, from any numbers of 0..1 and their ends: the textbook's
        // C, X and m.
        const hue = fraction()
        const saturation = edgy()
        const light = edgy()
        var chroma = light * saturation
        classicColor(hue, chroma, light - chroma, &x, &y, &z)
        color.hsvToRgb(hue, saturation, light, &r, &g, &b)
        if !near3(r, g, b, x, y, z, 1.0e-12) || !within(r, g, b) { return 114 }
        chroma = (1.0 - math.abs(2.0 * light - 1.0)) * saturation
        classicColor(hue, chroma, light - chroma / 2.0, &x, &y, &z)
        color.hslToRgb(hue, saturation, light, &r, &g, &b)
        if !near3(r, g, b, x, y, z, 1.0e-12) || !within(r, g, b) { return 116 }

        // HSI: the intensity is the mean whatever the saturation; the
        // saturation is the one asked for where the largest channel
        // stayed below 1, and no more than it where it had to give way;
        // the hue is the hue.
        color.hsiToRgb(hue, saturation, light, &r, &g, &b)
        if !within(r, g, b) || !near((r + g + b) / 3.0, light, 1.0e-12) { return 118 }
        var most = math.max(r, math.max(g, b))
        var least = math.min(r, math.min(g, b))
        var reached = if most - least == 0.0 || light == 0.0 { 0.0 } else { 1.0 - least / ((r + g + b) / 3.0) }
        if light > 1.0e-3 {
            if reached > saturation + 1.0e-9 { return 118 }
            if most < 1.0 - 1.0e-12 && !near(reached, saturation, 1.0e-9) { return 118 }
        }
        if most - least > 1.0e-3 && degreesApart(classicHue(r, g, b), hue * 360.0) > 1.0e-9 { return 118 }

        // HSY, with each of the weights: the luma is the luma, the chroma
        // the one asked for where no channel came to 0 or 1, and no more
        // than it otherwise.
        var weights: u8 = 0
        while weights < 3 {
            color.hsyToRgb(weights, hue, saturation, light, &r, &g, &b)
            if !within(r, g, b) || !near(color.luma(weights, r, g, b), light, 1.0e-12) { return 119 }
            most = math.max(r, math.max(g, b))
            least = math.min(r, math.min(g, b))
            reached = most - least
            if reached > saturation + 1.0e-12 { return 119 }
            if most < 1.0 - 1.0e-12 && least > 1.0e-12 && !near(reached, saturation, 1.0e-12) { return 119 }
            if reached > 1.0e-3 && degreesApart(classicHue(r, g, b), hue * 360.0) > 1.0e-9 { return 119 }
            weights += 1
        }
        round += 1
    }

    // The six orders of 0.2, 0.4, 0.6 by hand, there and back.
    var k: usize = 0
    while k < 6 {
        const red = TWELFTHS[k * 3]
        const green = TWELFTHS[k * 3 + 1]
        const blue = TWELFTHS[k * 3 + 2]
        const hue = @floatFromInt(f64, 2 * k + 1) / 12.0
        var model: u8 = 0
        while model < color.MODELS {
            var saturation: f64 = 0.4
            var light: f64 = 0.4
            if model == color.HSV {
                saturation = 2.0 / 3.0
                light = 0.6
            } else if model == color.HSL || model == color.HSI {
                saturation = 0.5
            } else if model == color.HSY {
                light = 0.299 * red + 0.587 * green + 0.114 * blue
            } else if model == color.HSY709 {
                light = 0.2126 * red + 0.7152 * green + 0.0722 * blue
            } else {
                light = 0.3 * red + 0.59 * green + 0.11 * blue
            }
            color.rgbToModel(model, red, green, blue, &h, &s, &l)
            if !near3(h, s, l, hue, saturation, light, 1.0e-14) { return 120 }
            if !near(color.sat(model, red, green, blue), saturation, 1.0e-14) || !near(color.lum(model, red, green, blue), light, 1.0e-14) { return 120 }
            color.modelToRgb(model, hue, saturation, light, &r, &g, &b)
            if !near3(r, g, b, red, green, blue, 1.0e-14) { return 120 }
            model += 1
        }
        if !near(color.hueToDegrees(h), @floatFromInt(f64, 60 * k + 30), 1.0e-11) { return 120 }
        k += 1
    }

    // Mixing in linear light against the rule worked out with the exact
    // curve; how far pixels are apart against the rule.
    var sure: bool = true
    round = 0
    while round < 50000 {
        var first = (next() << 8) ^ next()
        var second = (next() << 8) ^ next()
        // Every eighth pair has a transparent or an opaque end.
        const pick = next() & 31
        if pick == 0 { first = first & 0x00FFFFFF }
        if pick == 1 { second = second & 0x00FFFFFF }
        if pick == 2 { first = first | 0xFF000000 }
        if pick == 3 {
            first = first | 0xFF000000
            second = second | 0xFF000000
        }
        const position = fraction()
        var expected = if position > 0.0 { mixedByRule(first, second, position, &sure) } else { first }
        if sure && color.mixLinearAt(first, second, position) != expected { return 121 }
        const t = next() & 255
        if t != 0 && t != 255 {
            expected = mixedByRule(first, second, @floatFromInt(f64, t) / 255.0, &sure)
            if sure && color.mixLinear(first, second, t) != expected { return 121 }
        }

        if color.distanceRgb(first, second) != apartByRule(first, second, false) { return 122 }
        const alphas = apartByRule(first & 0xFF000000, second & 0xFF000000, true)
        const all = if first >> 24 == 0 || second >> 24 == 0 { alphas } else { apartByRule(first, second, true) }
        if color.distance(first, second) != all { return 122 }
        round += 1
    }

    // Texts of digits, other letters, '#' and blanks in any order, read
    // as the rule reads them.
    const letters = "0123456789abcdefABCDEF#gG x"
    round = 0
    var accepted: usize = 0
    while round < 50000 {
        var length: usize = 0
        const shape = next()
        var blanks = shape & 3
        while blanks > 2 {
            fuzz_text[length] = 32
            length += 1
            blanks -= 1
        }
        if (shape >> 2) & 1 == 1 {
            fuzz_text[length] = 35
            length += 1
        }
        var count = (shape >> 3) % 10
        // Most of the time only digits: a text of them is a colour when
        // their number is right.
        const any = (shape >> 8) & 3 == 0
        while count > 0 {
            const letter = if any { (next() >> 3) % 27 } else { (next() >> 3) % 22 }
            fuzz_text[length] = letters[@intCast(usize, letter)]
            length += 1
            count -= 1
        }
        if (shape >> 10) & 3 == 0 {
            fuzz_text[length] = 9
            length += 1
        }
        var got: u32 = 0x12345678
        var wanted: u32 = 0x12345678
        const read = color.parseHex(fuzz_text[0..length], &got)
        if read != readByRule(fuzz_text[0..length], &wanted) || got != wanted { return 123 }
        if read { accepted += 1 }
        round += 1
    }
    // (The sweep is of both kinds.)
    if accepted < 5000 || accepted > 45000 { return 123 }

    // The colour of every temperature against the fit as published, and
    // against numbers worked out apart: 6600 K, where the fit's two
    // halves meet, is white.
    var degrees: u32 = 1000
    while degrees <= 40000 {
        if color.kelvinToRgb(degrees) != helland(degrees) { return 124 }
        degrees += 1
    }
    k = 0
    while k < 26 {
        if color.kelvinToRgb(KELVIN[k]) != KELVIN[k + 1] { return 124 }
        k += 2
    }
    if color.kelvinToRgb(40001) != 0xFF98BAFF || color.kelvinToRgb(500) != 0xFFFF4400 { return 124 }

    // Lab of colours that are no primaries.
    k = 0
    while k < 6 {
        color.toLab(LAB_PIXELS[k], &x, &y, &z)
        if !near3(x, y, z, LAB_OF_PIXELS[k * 3], LAB_OF_PIXELS[k * 3 + 1], LAB_OF_PIXELS[k * 3 + 2], 0.000001) { return 125 }
        k += 1
    }

    // Where Lab's curve turns from the straight piece into the cube
    // root, at Y = 216/24389 (L = 8): greys of that Y and of one a little
    // to either side, each by its own piece (the other piece is 0.0001
    // off there), and the same backwards.
    const white_x = 0.3127 / 0.3290
    const white_z = (1.0 - 0.3127 - 0.3290) / 0.3290
    color.xyzToLab(216.0 / 24389.0 * white_x, 216.0 / 24389.0, 216.0 / 24389.0 * white_z, &x, &y, &z)
    if !near3(x, y, z, 8.0, 0.0, 0.0, 1.0e-12) { return 126 }
    color.xyzToLab(0.0089 * white_x, 0.0089, 0.0089 * white_z, &x, &y, &z)
    if !near3(x, y, z, 8.03927273748743, 0.0, 0.0, 1.0e-12) { return 126 }
    color.xyzToLab(0.0088 * white_x, 0.0088, 0.0088 * white_z, &x, &y, &z)
    if !near3(x, y, z, 7.949007407407408, 0.0, 0.0, 1.0e-12) { return 126 }
    color.labToXyz(8.04, 0.0, 0.0, &x, &y, &z)
    if !near3(x, y, z, 0.008900807782196889 * white_x, 0.008900807782196889, 0.008900807782196889 * white_z, 1.0e-15) { return 126 }
    color.labToXyz(7.96, 0.0, 0.0, &x, &y, &z)
    if !near3(x, y, z, 0.008812169420640453 * white_x, 0.008812169420640453, 0.008812169420640453 * white_z, 1.0e-15) { return 126 }

    // srgb8's borders: the linear light of a byte less a half is that
    // byte, the next number below it the byte before; and the tables
    // stay where they are.
    var byte: u32 = 1
    while byte < 256 {
        const border = color.srgbToLinear((@floatFromInt(f64, byte) - 0.5) / 255.0)
        if color.srgb8(border) != byte || color.srgb8(below(border)) != byte - 1 || color.srgb8(above(border)) != byte { return 127 }
        byte += 1
    }
    if @intFromPtr(color.linearTable()) != @intFromPtr(color.linearTable()) || @intFromPtr(color.linearTable32()) != @intFromPtr(color.linearTable32()) || @intFromPtr(color.srgbTable()) != @intFromPtr(color.srgbTable()) { return 127 }
    return 0
}

const AMOUNTS: [5]f64 = [5]f64{ 0.0, 0.25, 0.6377610522931314, 0.9, 1.0 }

// Checks 128-139: colours a rounding away from a grey, arguments outside
// their range, channels outside 0..1 and channels that are no numbers.
fn roundings() -> u8 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0

    // A grey with one channel the next number above the others has a
    // hue (that channel's), and a saturation set on it is the colour of
    // that hue at the grey's lightness: not whatever the rounding of the
    // lightness is, scaled up to a colour.
    var value: u32 = 1
    while value < 256 {
        const level = @floatFromInt(f64, value) / 255.0
        const raised = if value == 255 { level } else { above(level) }
        const lowered = if value == 255 { below(level) } else { level }
        var which: u32 = 0
        while which < 3 {
            const red = if which == 0 { raised } else { lowered }
            const green = if which == 1 { raised } else { lowered }
            const blue = if which == 2 { raised } else { lowered }
            var model: u8 = 0
            while model < color.MODELS {
                const light = color.lum(model, red, green, blue)
                color.rgbToModel(model, red, green, blue, &h, &s, &l)
                // (A rounding below white the lightness of HSL is 1 to
                // the last digit: no room for a saturation, no hue.)
                const hue = if model == color.HSL && value == 255 { 0.0 } else { @floatFromInt(f64, which) / 3.0 }
                if !(s >= 0.0 && s <= 1.0e-13) || h != hue || !near(l, level, 1.0e-15) { return 136 }
                var k: usize = 0
                while k < 5 {
                    r = red
                    g = green
                    b = blue
                    color.setSat(model, &r, &g, &b, AMOUNTS[k])
                    if !near(color.lum(model, r, g, b), light, 1.0e-12) || !within(r, g, b) { return 128 }
                    color.modelToRgb(model, h, AMOUNTS[k], l, &x, &y, &z)
                    if !near3(r, g, b, x, y, z, 1.0e-12) { return 129 }
                    k += 1
                }
                model += 1
            }
            which += 1
        }
        value += 1
    }

    // By hand: 0.5, 0.5 and the next number above 0.5 is a blue of no
    // saturation to speak of. All of it at value 0.5 is (0, 0, 0.5); at
    // lightness 0.5 pure blue; at intensity 0.5 blue with 0.25 of the
    // others (blue alone is no brighter than 1/3); at luma 0.5 blue with
    // what brings the luma from blue's 0.114 to 0.5.
    const raised = above(0.5)
    r = 0.5
    g = 0.5
    b = raised
    color.setSat(color.HSV, &r, &g, &b, 1.0)
    if !near3(r, g, b, 0.0, 0.0, 0.5, 1.0e-15) { return 130 }
    r = 0.5
    g = 0.5
    b = raised
    color.setSat(color.HSL, &r, &g, &b, 1.0)
    if !near3(r, g, b, 0.0, 0.0, 1.0, 1.0e-15) { return 130 }
    r = 0.5
    g = 0.5
    b = raised
    color.setSat(color.HSI, &r, &g, &b, 1.0)
    if !near3(r, g, b, 0.25, 0.25, 1.0, 1.0e-15) { return 130 }
    r = 0.5
    g = 0.5
    b = raised
    color.setSat(color.HSY, &r, &g, &b, 1.0)
    if !near3(r, g, b, 0.5 - 0.114 * 0.5 / 0.886, 0.5 - 0.114 * 0.5 / 0.886, 1.0, 1.0e-15) { return 130 }
    // A yellow a rounding below white: value 1 has room for a
    // saturation, the other lightnesses have none at white.
    const nearly = below(1.0)
    r = 1.0
    g = 1.0
    b = nearly
    color.setSat(color.HSV, &r, &g, &b, 0.75)
    if !near3(r, g, b, 1.0, 1.0, 0.25, 1.0e-15) { return 131 }
    var model: u8 = color.HSL
    while model < color.MODELS {
        r = 1.0
        g = 1.0
        b = nearly
        color.setSat(model, &r, &g, &b, 0.75)
        if !near3(r, g, b, 1.0, 1.0, 1.0, 1.0e-15) || !within(r, g, b) { return 131 }
        model += 1
    }

    // A saturation and a lightness outside 0..1 are held to it, by the
    // functions themselves and not by a rounding to bytes after them;
    // what is no number is 0.
    color.hsvToRgb(0.0, 1.0, 5.0, &r, &g, &b)
    if r != 1.0 || g != 0.0 || b != 0.0 { return 132 }
    model = 0
    while model < color.MODELS {
        color.modelToRgb(model, 0.3, 1.0, 1.0, &x, &y, &z)
        color.modelToRgb(model, 0.3, 7.0, 7.0, &r, &g, &b)
        if r != x || g != y || b != z || !within(r, g, b) { return 132 }
        color.modelToRgb(model, 0.3, math.infinity(), math.infinity(), &r, &g, &b)
        if r != x || g != y || b != z { return 132 }
        color.modelToRgb(model, 0.3, 0.5, 0.5, &x, &y, &z)
        color.modelToRgb(model, 0.3, 0.5, 0.5, &r, &g, &b)
        if r != x || g != y || b != z { return 132 }
        color.modelToRgb(model, 0.3, -7.0, 0.5, &r, &g, &b)
        if r != 0.5 || g != 0.5 || b != 0.5 { return 132 }
        color.modelToRgb(model, 0.3, math.nan(), 0.5, &r, &g, &b)
        if r != 0.5 || g != 0.5 || b != 0.5 { return 132 }
        color.modelToRgb(model, 0.3, 0.5, -7.0, &r, &g, &b)
        if r != 0.0 || g != 0.0 || b != 0.0 { return 132 }
        color.modelToRgb(model, 0.3, 0.5, math.nan(), &r, &g, &b)
        if r != 0.0 || g != 0.0 || b != 0.0 { return 132 }

        // The same for what is set on a colour.
        x = 1.0
        y = 0.5
        z = 0.25
        color.setSat(model, &x, &y, &z, 1.0)
        r = 1.0
        g = 0.5
        b = 0.25
        color.setSat(model, &r, &g, &b, 7.0)
        if r != x || g != y || b != z { return 133 }
        const light = color.lum(model, 1.0, 0.5, 0.25)
        r = 1.0
        g = 0.5
        b = 0.25
        color.setSat(model, &r, &g, &b, -3.0)
        if !near3(r, g, b, light, light, light, 1.0e-15) { return 133 }
        r = 1.0
        g = 0.5
        b = 0.25
        color.setSat(model, &r, &g, &b, math.nan())
        if !near3(r, g, b, light, light, light, 1.0e-15) { return 133 }
        r = 1.0
        g = 0.5
        b = 0.25
        color.setLum(model, &r, &g, &b, -2.0)
        if r != 0.0 || g != 0.0 || b != 0.0 { return 133 }
        r = 1.0
        g = 0.5
        b = 0.25
        color.setLum(model, &r, &g, &b, math.nan())
        if r != 0.0 || g != 0.0 || b != 0.0 { return 133 }
        model += 1
    }
    r = 1.0
    g = 0.5
    b = 0.25
    color.setChroma(&r, &g, &b, 7.0)
    if !near3(r, g, b, 1.0, 1.0 / 3.0, 0.0, 1.0e-15) { return 133 }
    color.setChroma(&r, &g, &b, -1.0)
    if r != 0.0 || g != 0.0 || b != 0.0 { return 133 }
    r = 1.0
    g = 0.5
    b = 0.25
    color.setChroma(&r, &g, &b, math.nan())
    if r != 0.0 || g != 0.0 || b != 0.0 { return 133 }

    // A colour with no channel above 0 has no saturation and no hue
    // (nothing is divided by nothing), and its lightness is the model's
    // as lum has it.
    model = 0
    while model < color.MODELS {
        h = 9.0
        s = 9.0
        color.rgbToModel(model, -0.5, -0.25, 0.0, &h, &s, &l)
        if model < color.HSY {
            if h != 0.0 || s != 0.0 { return 134 }
        } else if !near(h, 7.0 / 12.0, 1.0e-15) || s != 0.5 {
            return 134
        }
        if !near(l, color.lum(model, -0.5, -0.25, 0.0), 1.0e-15) { return 134 }
        if model < color.HSY && color.sat(model, -0.5, -0.25, 0.0) != 0.0 { return 134 }
        model += 1
    }

    // Whatever is set on whatever colour of 0..1, what comes out is inside
    // 0..1 to the last digit, has the lightness asked for or kept, and
    // setting it again changes nothing.
    var round: usize = 0
    while round < 50000 {
        const red = edgy()
        const green = edgy()
        const blue = edgy()
        const target = edgy()
        model = 0
        while model < color.MODELS {
            r = red
            g = green
            b = blue
            color.setLum(model, &r, &g, &b, target)
            if !within(r, g, b) || !near(color.lum(model, r, g, b), target, 1.0e-12) { return 135 }
            x = r
            y = g
            z = b
            color.setLum(model, &x, &y, &z, target)
            if !near3(x, y, z, r, g, b, 1.0e-12) { return 135 }
            const light = color.lum(model, red, green, blue)
            r = red
            g = green
            b = blue
            color.setSat(model, &r, &g, &b, target)
            if !within(r, g, b) || !near(color.lum(model, r, g, b), light, 1.0e-12) { return 137 }
            const reached = color.sat(model, r, g, b)
            x = r
            y = g
            z = b
            color.setSat(model, &x, &y, &z, reached)
            if !near3(x, y, z, r, g, b, 1.0e-9) { return 137 }
            model += 1
        }
        round += 1
    }

    // A hue that is no number is 0 for Lab's hue too; a hue's degrees stay
    // below 360.
    color.lchToLab(5.0, math.nan(), &x, &y)
    if x != 5.0 || y != 0.0 { return 138 }
    color.lchToLab(5.0, math.infinity(), &x, &y)
    if x != 5.0 || y != 0.0 { return 138 }
    if !(color.hueToDegrees(below(1.0)) < 360.0) || !(color.hueToDegrees(-1.0e-17) < 360.0) || !(color.hueFromDegrees(below(360.0)) < 1.0) { return 138 }

    // Channels that are no numbers trap nowhere and are 0 in a pixel.
    const nothing = math.nan()
    model = 0
    while model < color.MODELS {
        color.rgbToModel(model, nothing, 0.5, 0.25, &h, &s, &l)
        color.rgbToModel(model, nothing, nothing, nothing, &h, &s, &l)
        r = nothing
        g = 0.5
        b = nothing
        color.setLum(model, &r, &g, &b, 0.5)
        color.setSat(model, &r, &g, &b, 0.5)
        if !within(r, g, b) { return 139 }
        model += 1
    }
    color.rgbToCmyk(nothing, nothing, nothing, &x, &y, &z, &l)
    color.rgbToYcbcr(nothing, 0.5, 0.5, &x, &y, &z)
    color.linearToXyz(nothing, 0.5, 0.5, &x, &y, &z)
    color.xyzToLab(x, y, z, &r, &g, &b)
    color.labToLch(g, b, &x, &y)
    if y != 0.0 { return 139 }
    if color.fromRgb(nothing, nothing, nothing, 255) != pixel.BLACK || color.fromLab(nothing, nothing, nothing, 255) != pixel.BLACK || color.fromHsv(nothing, nothing, nothing, 255) != pixel.BLACK || color.fromHsl(nothing, nothing, nothing, 255) != pixel.BLACK { return 139 }
    if color.srgb8(color.srgbToLinear(nothing)) != 0 || color.toByte(color.linearToSrgb(nothing)) != 0 { return 139 }
    return 0
}

// The W3C compositing specification's Lum, ClipColor, SetLum and SetSat
// written down as its pseudo-code has them: ClipColor takes n and x once,
// before either pull; SetSat names the channels max, mid and min and
// sets them through pointers.
fn w3cLum(r: f64, g: f64, b: f64) -> f64 {
    return 0.3 * r + 0.59 * g + 0.11 * b
}

fn w3cClipColor(r: *f64, g: *f64, b: *f64) -> void {
    const l = w3cLum(r.*, g.*, b.*)
    const n = math.min(r.*, math.min(g.*, b.*))
    const x = math.max(r.*, math.max(g.*, b.*))
    if n < 0.0 {
        r.* = l + (((r.* - l) * l) / (l - n))
        g.* = l + (((g.* - l) * l) / (l - n))
        b.* = l + (((b.* - l) * l) / (l - n))
    }
    if x > 1.0 {
        r.* = l + (((r.* - l) * (1.0 - l)) / (x - l))
        g.* = l + (((g.* - l) * (1.0 - l)) / (x - l))
        b.* = l + (((b.* - l) * (1.0 - l)) / (x - l))
    }
}

fn w3cSetLum(r: *f64, g: *f64, b: *f64, l: f64) -> void {
    const d = l - w3cLum(r.*, g.*, b.*)
    r.* = r.* + d
    g.* = g.* + d
    b.* = b.* + d
    w3cClipColor(r, g, b)
}

fn w3cSetSat(r: *f64, g: *f64, b: *f64, s: f64) -> void {
    var high: *f64 = r
    var middle: *f64 = g
    var low: *f64 = b
    if middle.* > high.* {
        const swap = high
        high = middle
        middle = swap
    }
    if low.* > middle.* {
        const swap = middle
        middle = low
        low = swap
    }
    if middle.* > high.* {
        const swap = high
        high = middle
        middle = swap
    }
    if high.* > low.* {
        middle.* = (((middle.* - low.*) * s) / (high.* - low.*))
        high.* = s
    } else {
        middle.* = 0.0
        high.* = 0.0
    }
    low.* = 0.0
}

// Whether the specification's SetSat as written, (mid - min) * s /
// (max - min), is a reference for a colour of chroma `span`: none or one
// that has all its digits. Below some 2.2e-308 a number has fewer than 53
// bits, and the product before the division loses them with it (a chroma
// of 989 times 5e-324 makes the middle channel 0.1 % off); color.mlx
// divides first and keeps them.
fn spanKeepsDigits(span: f64) -> bool {
    return span == 0.0 || span >= 1.0e-300
}

// Whether two colours are the same to the last digit.
fn same3(r: f64, g: f64, b: f64, x: f64, y: f64, z: f64) -> bool {
    return r == x && g == y && b == z
}

// The grid of channel values: 0-5, every ninth from 6 to 249, 250-255.
fn gridLevel(index: u32) -> u32 {
    if index < 6 { return index }
    if index >= 34 { return 250 + (index - 34) }
    return 6 + (index - 6) * 9
}

// The model numbers past the last one, each taken for HSY.
const STRAY_MODELS: [4]u8 = [4]u8{ 6, 7, 200, 255 }

var attack_text: [16]u8 = undefined

// Checks 243-254: setChroma where the chroma is a rounding above
// nothing; the W3C's Lum, SetLum, SetSat and its four non-separable
// modes against the specification's pseudo-code; model and weight
// numbers past the last; mixLinear's alpha against pixel.mix's rule and
// positions beyond its ends; the 4096 table read as its comment says; a
// grid of 64000 colours with the first and last six bytes of each
// channel there and back through every model at its own alpha; Lab's
// distance as a distance; more texts that are and are not colours.
fn attack() -> u8 {
    var r: f64 = 0.0
    var g: f64 = 0.0
    var b: f64 = 0.0
    var h: f64 = 0.0
    var s: f64 = 0.0
    var l: f64 = 0.0
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    var r2: f64 = 0.0
    var g2: f64 = 0.0
    var b2: f64 = 0.0

    // A chroma of the smallest number there is: the colour of that hue
    // all the same, nothing infinite and nothing that is no number.
    const one_bit: u64 = 1
    const tiniest = @bitCast(f64, one_bit)
    r = 0.0
    g = 0.0
    b = tiniest
    color.setChroma(&r, &g, &b, 1.0)
    if r != 0.0 || g != 0.0 || b != 1.0 { return 243 }
    r = 0.5
    g = above(0.5)
    b = 0.5
    color.setChroma(&r, &g, &b, 0.75)
    if r != 0.0 || g != 0.75 || b != 0.0 { return 243 }
    r = tiniest
    g = 0.0
    b = tiniest
    color.setChroma(&r, &g, &b, 0.5)
    if r != 0.5 || g != 0.0 || b != 0.5 { return 243 }
    var model: u8 = 0
    while model < color.MODELS {
        r = 0.0
        g = tiniest
        b = 0.0
        color.setSat(model, &r, &g, &b, 1.0)
        if !within(r, g, b) { return 243 }
        r = 0.0
        g = tiniest
        b = 0.0
        color.setLum(model, &r, &g, &b, 0.5)
        if !within(r, g, b) || !near(color.lum(model, r, g, b), 0.5, 1.0e-15) { return 243 }
        model += 1
    }

    var round: usize = 0
    while round < 50000 {
        const red = edgy()
        const green = edgy()
        const blue = edgy()
        // An amount a little outside 0..1 now and then.
        const amount = edgy() * 1.25 - 0.125
        const wanted = if !(amount > 0.0) { 0.0 } else if amount > 1.0 { 1.0 } else { amount }
        const low = math.min(red, math.min(green, blue))
        const span = math.max(red, math.max(green, blue)) - low

        // setChroma: the smallest channel 0, the largest the amount to
        // the last digit, the middle where it was in the span; and the
        // W3C's SetSat as written.
        r = red
        g = green
        b = blue
        color.setChroma(&r, &g, &b, amount)
        if math.min(r, math.min(g, b)) != 0.0 { return 244 }
        if span > 0.0 {
            if math.max(r, math.max(g, b)) != wanted { return 244 }
            if !near3(r, g, b, (red - low) / span * wanted, (green - low) / span * wanted, (blue - low) / span * wanted, 1.0e-15) { return 244 }
            if !sameHue(red, green, blue, r, g, b) { return 244 }
        } else if r != 0.0 || g != 0.0 || b != 0.0 {
            return 244
        }
        x = red
        y = green
        z = blue
        w3cSetSat(&x, &y, &z, wanted)
        if spanKeepsDigits(span) && !near3(r, g, b, x, y, z, 1.0e-15) { return 244 }

        // Lum and SetLum as written.
        if !near(color.lum(color.HSY_W3C, red, green, blue), w3cLum(red, green, blue), 1.0e-15) || color.chroma(red, green, blue) != span { return 245 }
        r = red
        g = green
        b = blue
        color.setLum(color.HSY_W3C, &r, &g, &b, wanted)
        x = red
        y = green
        z = blue
        w3cSetLum(&x, &y, &z, wanted)
        if !near3(r, g, b, x, y, z, 1.0e-12) { return 245 }

        // The four modes, backdrop (red, green, blue), source the next
        // colour: hue, saturation, colour and luminosity. Where the
        // specification as written has no digits left, the result is
        // inside 0..1 and of the backdrop's luma all the same.
        const sr = edgy()
        const sg = edgy()
        const sb = edgy()
        const backdrop_luma = color.lum(color.HSY_W3C, red, green, blue)
        r = sr
        g = sg
        b = sb
        color.setChroma(&r, &g, &b, color.chroma(red, green, blue))
        color.setLum(color.HSY_W3C, &r, &g, &b, backdrop_luma)
        x = sr
        y = sg
        z = sb
        w3cSetSat(&x, &y, &z, span)
        w3cSetLum(&x, &y, &z, w3cLum(red, green, blue))
        if spanKeepsDigits(color.chroma(sr, sg, sb)) && !near3(r, g, b, x, y, z, 1.0e-12) { return 246 }
        if !within(r, g, b) || !near(color.lum(color.HSY_W3C, r, g, b), backdrop_luma, 1.0e-12) { return 246 }
        r = red
        g = green
        b = blue
        color.setSat(color.HSY_W3C, &r, &g, &b, color.chroma(sr, sg, sb))
        x = red
        y = green
        z = blue
        w3cSetSat(&x, &y, &z, math.max(sr, math.max(sg, sb)) - math.min(sr, math.min(sg, sb)))
        w3cSetLum(&x, &y, &z, w3cLum(red, green, blue))
        if spanKeepsDigits(span) && !near3(r, g, b, x, y, z, 1.0e-12) { return 246 }
        if !within(r, g, b) || !near(color.lum(color.HSY_W3C, r, g, b), backdrop_luma, 1.0e-12) { return 246 }
        r = sr
        g = sg
        b = sb
        color.setLum(color.HSY_W3C, &r, &g, &b, color.lum(color.HSY_W3C, red, green, blue))
        x = sr
        y = sg
        z = sb
        w3cSetLum(&x, &y, &z, w3cLum(red, green, blue))
        if !near3(r, g, b, x, y, z, 1.0e-12) { return 246 }
        r = red
        g = green
        b = blue
        color.setLum(color.HSY_W3C, &r, &g, &b, color.lum(color.HSY_W3C, sr, sg, sb))
        x = red
        y = green
        z = blue
        w3cSetLum(&x, &y, &z, w3cLum(sr, sg, sb))
        if !near3(r, g, b, x, y, z, 1.0e-12) { return 246 }

        // A model number past the last is HSY, weights past the last
        // Rec. 601's, in every function that takes them.
        var stray: usize = 0
        while stray < 4 {
            const odd = STRAY_MODELS[stray]
            color.rgbToModel(odd, red, green, blue, &h, &s, &l)
            color.rgbToModel(color.HSY, red, green, blue, &x, &y, &z)
            if !same3(h, s, l, x, y, z) { return 247 }
            if color.lum(odd, red, green, blue) != color.lum(color.HSY, red, green, blue) || color.sat(odd, red, green, blue) != color.sat(color.HSY, red, green, blue) || color.weightsOf(odd) != color.REC601 { return 247 }
            color.modelToRgb(odd, sr, sg, sb, &r, &g, &b)
            color.modelToRgb(color.HSY, sr, sg, sb, &x, &y, &z)
            if !same3(r, g, b, x, y, z) { return 247 }
            r = red
            g = green
            b = blue
            x = red
            y = green
            z = blue
            color.setSat(odd, &r, &g, &b, amount)
            color.setSat(color.HSY, &x, &y, &z, amount)
            if !same3(r, g, b, x, y, z) { return 247 }
            color.setLum(odd, &r, &g, &b, wanted)
            color.setLum(color.HSY, &x, &y, &z, wanted)
            if !same3(r, g, b, x, y, z) { return 247 }
            // The same number as weights: 6, 7, 200 and 255 are no weights.
            if color.luma(odd, red, green, blue) != color.luma(color.REC601, red, green, blue) { return 247 }
            color.rgbToHsy(odd, red, green, blue, &h, &s, &l)
            color.rgbToHsy(color.REC601, red, green, blue, &x, &y, &z)
            if !same3(h, s, l, x, y, z) { return 247 }
            color.hsyToRgb(odd, sr, sg, sb, &r, &g, &b)
            color.hsyToRgb(color.REC601, sr, sg, sb, &x, &y, &z)
            if !same3(r, g, b, x, y, z) { return 247 }
            stray += 1
        }
        if color.lumaOf(0xFF336699, 3) != color.lumaOf(0xFF336699, color.REC601) || color.lumaOf(0xFF336699, 255) != color.lumaOf(0xFF336699, color.REC601) { return 247 }
        round += 1
    }

    // mixLinear's alpha goes evenly, by pixel.mix's own rule: the alphas
    // weighted (255 - t) and t, rounded, for every pair of alphas.
    var t_index: usize = 0
    while t_index < 8 {
        const t: u32 = if t_index == 0 { 1 } else if t_index == 7 { 254 } else { @intCast(u32, t_index) * 36 + 1 }
        var first_alpha: u32 = 0
        while first_alpha < 256 {
            var second_alpha: u32 = 0
            while second_alpha < 256 {
                const a = pixel.withAlpha(0x123456, first_alpha)
                const b_pixel = pixel.withAlpha(0xFEDCBA, second_alpha)
                const evenly = (first_alpha * (255 - t) + second_alpha * t + 127) / 255
                const mixed = color.mixLinear(a, b_pixel, t)
                if mixed >> 24 != evenly || pixel.mix(a, b_pixel, t) >> 24 != evenly { return 248 }
                // A mix of no alpha is the transparent pixel 0.
                if evenly == 0 && mixed != 0 { return 248 }
                second_alpha += 1
            }
            first_alpha += 1
        }
        t_index += 1
    }

    // Positions far beyond the ends are the ends, and nothing traps.
    if color.mixLinear(0x80112233, 0x40445566, 256) != 0x40445566 || color.mixLinear(0x80112233, 0x40445566, 0xFFFFFFFF) != 0x40445566 { return 249 }
    if color.mixLinearAt(0x80112233, 0x40445566, math.infinity()) != 0x40445566 || color.mixLinearAt(0x80112233, 0x40445566, math.negativeInfinity()) != 0x80112233 || color.mixLinearAt(0x80112233, 0x40445566, 1.0e300) != 0x40445566 { return 249 }
    if color.mixLinearAt(0x80112233, 0x40445566, 5.0e-324) != 0x80112233 || color.mixLinearAt(0x80112233, 0x40445566, below(1.0)) != 0x40445566 { return 249 }

    // The 4096 table read as srgbTable's comment says: the byte of the
    // nearest step, at most one beside srgb8's; at the steps themselves
    // srgb8's own.
    const to_srgb = color.srgbTable()
    round = 0
    while round <= 100000 {
        const linear = @floatFromInt(f64, round) / 100000.0
        const looked = @intCast(u32, to_srgb[@intFromFloat(usize, linear * color.SRGB_STEPS + 0.5)])
        const exact = color.srgb8(linear)
        if looked > exact + 1 || exact > looked + 1 { return 250 }
        round += 1
    }
    var step: usize = 0
    while step < 4096 {
        if @intCast(u32, to_srgb[step]) != color.srgb8(@floatFromInt(f64, step) / color.SRGB_STEPS) { return 250 }
        step += 1
    }

    // The grid: every way there and back gives the very pixel, at its
    // own alpha; what has nothing to do with alpha does not look at it.
    var index: u32 = 0
    while index < 64000 {
        const alpha = (index * 37) & 255
        const opaque = pixel.rgb(gridLevel(index % 40), gridLevel((index / 40) % 40), gridLevel(index / 1600))
        const p = pixel.withAlpha(opaque, alpha)
        color.toRgb(p, &r, &g, &b)
        model = 0
        while model < color.MODELS {
            color.rgbToModel(model, r, g, b, &h, &s, &l)
            color.modelToRgb(model, h, s, l, &r2, &g2, &b2)
            if color.fromRgb(r2, g2, b2, alpha) != p { return 251 }
            model += 1
        }
        color.toHsv(p, &h, &s, &l)
        if color.fromHsv(color.hueFromDegrees(color.hueToDegrees(h)), s, l, alpha) != p { return 251 }
        color.toHsl(p, &h, &s, &l)
        if color.fromHsl(color.hueFromDegrees(color.hueToDegrees(h)), s, l, alpha) != p { return 251 }
        color.toLab(p, &l, &x, &y)
        color.labToLch(x, y, &s, &h)
        color.lchToLab(s, h, &x, &y)
        if color.fromLab(l, x, y, alpha) != p { return 251 }
        var black: f64 = 0.0
        color.rgbToCmyk(r, g, b, &x, &y, &z, &black)
        color.cmykToRgb(x, y, z, black, &r2, &g2, &b2)
        if color.fromRgb(r2, g2, b2, alpha) != p { return 251 }
        color.rgbToYcbcr(r, g, b, &x, &y, &z)
        color.ycbcrToRgb(x, y, z, &r2, &g2, &b2)
        if color.fromRgb(r2, g2, b2, alpha) != p { return 251 }
        color.linearToXyz(color.srgbToLinear(r), color.srgbToLinear(g), color.srgbToLinear(b), &x, &y, &z)
        color.xyzToLinear(x, y, z, &r2, &g2, &b2)
        if color.fromRgb(color.linearToSrgb(r2), color.linearToSrgb(g2), color.linearToSrgb(b2), alpha) != p { return 251 }

        // WCAG's relative luminance by the exact curve; the contrast
        // colour, Lab's distance and luminance of the colour alone.
        const wcag = 0.2126 * color.srgbToLinear(r) + 0.7152 * color.srgbToLinear(g) + 0.0722 * color.srgbToLinear(b)
        if color.luminance(p) != wcag || color.luminance(opaque) != wcag { return 252 }
        if color.contrastColor(p) != color.contrastColor(opaque) || color.deltaE76(p, opaque) != 0.0 || color.distance(p, p) != 0 || color.distanceRgb(p, opaque) != 0 { return 252 }
        index += 1
    }

    // Lab's distance is a distance: symmetric, nothing only from a colour
    // to itself, and no way round through a third colour is shorter.
    round = 0
    while round < 20000 {
        const a = next()
        const b_pixel = next()
        const c_pixel = next()
        const ab = color.deltaE76(a, b_pixel)
        const bc = color.deltaE76(b_pixel, c_pixel)
        const ac = color.deltaE76(a, c_pixel)
        if ab != color.deltaE76(b_pixel, a) || ac > ab + bc + 1.0e-9 || ab > ac + bc + 1.0e-9 || bc > ab + ac + 1.0e-9 { return 253 }
        if (ab == 0.0) != ((a & 0xFFFFFF) == (b_pixel & 0xFFFFFF)) { return 253 }
        round += 1
    }

    // Texts: blanks are spaces, tabs and line ends; a vertical tab, a
    // blank or a '#' inside, a sign and bytes past ASCII are not colours.
    var typed: u32 = 0x5A5A5A5A
    if !color.parseHex(" \r\n#AbC\r\n ", &typed) || typed != 0xFFAABBCC { return 254 }
    if !color.parseHex("#FfEeDd", &typed) || typed != 0xFFFFEEDD || !color.parseHex("\tFFFFFFFF\t", &typed) || typed != 0xFFFFFFFF { return 254 }
    typed = 0x5A5A5A5A
    if color.parseHex("\x0b#fff", &typed) || color.parseHex("#fff\x0c", &typed) || color.parseHex("#ff88 00", &typed) || color.parseHex("# ff8800", &typed) || color.parseHex("ff#8800", &typed) { return 254 }
    if color.parseHex("+fff", &typed) || color.parseHex("-fff", &typed) || color.parseHex("#ff8800\x80", &typed) || color.parseHex("\xff\xff\xff", &typed) || color.parseHex("0000000", &typed) || color.parseHex("\r\n", &typed) { return 254 }
    if typed != 0x5A5A5A5A { return 254 }
    // formatHex writes exactly its 7 or 9 bytes and parseHex reads all of
    // what it wrote, every alpha, every byte value in every place.
    // In capitals it reads the same.
    const bytes: [*]u8 = &attack_text
    var shift: u32 = 0
    while shift < 32 {
        var byte: u32 = 0
        while byte < 256 {
            const p = (0x5A5A5A5A ^ (0x5A << shift)) | (byte << shift)
            attack_text[9] = 33
            if color.formatHex(p, bytes, true) != 9 || attack_text[9] != 33 || !color.parseHex(bytes[0..9], &typed) || typed != p { return 254 }
            var at: usize = 1
            while at < 9 {
                if attack_text[at] >= 97 { attack_text[at] = attack_text[at] - 32 }
                at += 1
            }
            if !color.parseHex(bytes[0..9], &typed) || typed != p { return 254 }
            attack_text[7] = 33
            if color.formatHex(p, bytes, false) != 7 || attack_text[7] != 33 || !color.parseHex(bytes[0..7], &typed) || typed != (p | 0xFF000000) { return 254 }
            byte += 1
        }
        shift += 8
    }
    return 0
}

pub fn main() -> u8 {
    const arena = turns.locate()
    // (Not found, the check at the end would look at nothing.)
    if arena == 0 { return 241 }
    const before = turns.used(arena)
    const live = std.heap.liveBytes()
    var failed: u8 = wheel()
    if failed != 0 { return failed }
    failed = greys()
    if failed != 0 { return failed }
    failed = edges()
    if failed != 0 { return failed }
    failed = sweep()
    if failed != 0 { return failed }
    failed = tables()
    if failed != 0 { return failed }
    failed = hex()
    if failed != 0 { return failed }
    failed = kelvin()
    if failed != 0 { return failed }
    failed = contrast()
    if failed != 0 { return failed }
    failed = bySpecification()
    if failed != 0 { return failed }
    failed = apart()
    if failed != 0 { return failed }
    failed = reference()
    if failed != 0 { return failed }
    failed = roundings()
    if failed != 0 { return failed }
    const before_attack = turns.used(arena)
    failed = attack()
    if failed != 0 { return failed }
    // (Not one of its some six million calls takes a byte of the arena.)
    if turns.used(arena) != before_attack { return 238 }

    // All those sweeps made no value but numbers: the value arena is
    // where it was, and the module took nothing from the heap (its
    // tables are its own).
    if turns.used(arena) - before > 4096 { return 240 }
    if std.heap.liveBytes() != live { return 242 }
    return 13
}
