// nebula test 38: ui/colorsolid.mlx, the colour body to turn and choose
// on. Exit 13: all well; otherwise the number of the first check that
// failed. With NEBULA_SHOTS naming a directory it also writes the frames
// of a demonstration there (solid-00.png ...: the sRGB cube turning, its
// colours moving to their places in OKLab, the OKLab body cut lower and
// lower, a colour chosen on the cut).
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const colorsolid = @import("../ui/colorsolid.mlx")
const color = @import("../core/color.mlx")

const SIZE: i32 = 360
const GROUND: u32 = 0xFFF7F7F7

fn smooth(t: f64) -> f64 { return t * t * (3.0 - 2.0 * t) }

fn save(solid: *colorsolid.Solid, directory: []const u8, number: usize, allocator: std.allocator.Allocator) -> bool {
    var name: [1024]u8 = undefined
    const bytes: [*]u8 = &name
    var length = std.text.append(bytes, 0, 1000, directory)
    length = std.text.append(bytes, length, 1000, "/solid-")
    if number < 10 { length = std.text.appendByte(bytes, length, 1000, 48) }
    length = std.text.appendUnsigned(bytes, length, 1000, number)
    length = std.text.append(bytes, length, 1000, ".png")
    var path: [1024]u8 = undefined
    return png.saveFile(std.text.zeroTerminated(&path, 1024, bytes[0..length]), colorsolid.pixels(solid), @intCast(usize, SIZE), @intCast(usize, SIZE), @intCast(usize, SIZE), false, allocator)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var solid: colorsolid.Solid = undefined
    colorsolid.init(&solid, allocator)
    solid.background = GROUND

    // 1-3: the cube is drawn, around it the ground; picking there gives
    // nothing, on the body a colour.
    if !colorsolid.render(&solid, SIZE, SIZE) { return 1 }
    var chosen: u32 = 0
    if colorsolid.pick(&solid, 2, 2, &chosen) || colorsolid.pixels(&solid)[0] != GROUND { return 2 }
    if !colorsolid.pick(&solid, SIZE / 2, SIZE / 2, &chosen) || chosen >> 24 != 255 { return 3 }

    // 4: a morph at 0 is the space it starts from.
    var cube: [8]u32 = undefined
    var index: usize = 0
    while index < 8 {
        cube[index] = colorsolid.pixels(&solid)[@intCast(usize, SIZE) * (100 + index * 20) + 180]
        index += 1
    }
    solid.from = colorsolid.SRGB
    solid.to = colorsolid.OKLAB
    solid.morph = 0.0
    if !colorsolid.render(&solid, SIZE, SIZE) { return 4 }
    index = 0
    while index < 8 {
        if colorsolid.pixels(&solid)[@intCast(usize, SIZE) * (100 + index * 20) + 180] != cube[index] { return 4 }
        index += 1
    }

    // 5-6: the OKLab body cut at L = 0.55, seen from above: what is picked
    // in its middle is a colour of that lightness, and it is grey there.
    solid.from = colorsolid.OKLAB
    solid.morph = 1.0
    solid.cut = 0.55
    solid.pitch = 1.45
    if !colorsolid.render(&solid, SIZE, SIZE) { return 5 }
    if !colorsolid.pick(&solid, SIZE / 2, SIZE / 2, &chosen) { return 5 }
    var l: f64 = 0.0
    var a: f64 = 0.0
    var b: f64 = 0.0
    color.toOklab(chosen, &l, &a, &b)
    if l < 0.53 || l > 0.57 { return 6 }
    const spread = a * a + b * b
    if spread > 0.0009 { return 6 }

    // 7: a picture of another size, and memory given back.
    if !colorsolid.render(&solid, 120, 80) || solid.width != 120 { return 7 }
    colorsolid.release(&solid)

    // The demonstration, when asked for.
    const shots = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if shots != null && shots.?.length > 0 {
        const directory = std.string.asSlice(shots.?)
        colorsolid.init(&solid, allocator)
        solid.background = GROUND
        const started = std.time.milliseconds()
        var frame: usize = 0
        while frame < 72 {
            const t = @floatFromInt(f64, frame)
            solid.yaw = -0.6 + t * 0.045
            solid.pitch = 0.42
            solid.cut = 1.0
            solid.hasMark = false
            solid.from = colorsolid.SRGB
            solid.to = colorsolid.OKLAB
            if frame < 20 {
                solid.morph = 0.0
            } else if frame < 44 {
                solid.morph = smooth((t - 20.0) / 23.0)
            } else {
                solid.morph = 1.0
                solid.cut = 1.0 - (t - 44.0) / 27.0 * 0.5
                solid.pitch = 0.42 + (t - 44.0) / 27.0 * 0.5
                solid.mark = color.fromOklch(solid.cut, 0.09, 1.0 + t * 0.05, 255)
                solid.hasMark = true
            }
            if !colorsolid.render(&solid, SIZE, SIZE) { return 8 }
            if !save(&solid, directory, frame, allocator) { return 9 }
            frame += 1
        }
        const took = std.time.milliseconds() - started
        var line: [64]u8 = undefined
        var length = std.text.append(&line, 0, 64, "72 frames in ")
        length = std.text.appendUnsigned(&line, length, 64, took)
        length = std.text.append(&line, length, 64, " ms")
        _ = std.io.println(line[0..length])
        colorsolid.release(&solid)
    }
    return 13
}
