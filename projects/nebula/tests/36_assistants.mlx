// nebula's painting assistants (core/assistants.mlx) and the Assistant
// tool (tools/assist.mlx):
//
// - every kind's place for a point against its formula worked out here:
//   a ruler holds the point between its ends, an infinite one does not, a
//   parallel ruler's line goes through the stroke's start along its
//   handles, a vanishing point's through the point and the start; the
//   ellipse's nearest point within half a pixel of a search along the
//   whole ellipse for 50 points around a turned one (and the point on
//   it); the concentric ellipse scaled to pass through the start; the
//   fisheye's ellipse of the family through the start (and its axis for a
//   start on it); the perspective's two vanishing points where its sides
//   meet, its line toward the nearer one, kept once the pen is 10 pixels
//   away, parallel sides giving their direction; the two-point
//   perspective's lines and its upright; the spline's nearest point at
//   least as near as the best of 200001 samples of the curve, for 50
//   points; snapOnto only asks (it keeps no perspective line);
// - every kind gives the same place for the same point when everything
//   is moved 70000 by 130000 pixels into negative coordinates, scaled
//   down to a few pixels or up ten thousand times (what moving and
//   scaling the plane must give);
// - snap single keeps the first choice (without it the nearer one takes
//   the point), magnetism 0.5 goes half way, 0 nowhere; snapping off,
//   an assistant not snapping, one not complete, a start on a vanishing
//   point, NaN and huge numbers leave the point; a ruler of no length is
//   its point; 32 assistants and no more; only valid assistants go in
//   (a kind of the module's, no more handles than it has, each a place),
//   one that is not draws nothing;
// - the history's custom steps add, change and remove, undone and redone;
//   an undone step replaced gives its memory back, the image destroyed
//   gives all back (the heap's live bytes as before); undoing and redoing
//   them takes no more of the value arena than a step that does nothing;
// - the text written reads back as the same set (the same numbers to
//   the last bit from 0.01 on in size, 12 sets of 32 assistants of random
//   coordinates; smaller ones within 1e-18; write gives the same text
//   again, reading twice the same set), what is not such a text is
//   refused and leaves the set; writing and reading leave the arena;
// - the preview's polylines: a ruler's ends, an ellipse's points on it,
//   the vanishing point's rays, the perspective's grid, the handles of an
//   unfinished one, too little room said, room enough at the largest
//   density for every kind; drawn, colours of alpha 0 leave the picture,
//   one not snapping is at half its alpha, lines with ends a billion
//   pixels away cross the picture whole (row 64, column 450);
// - the tool (a window-less App, app/script.mlx): two clicks place a
//   ruler, one step that an undo removes and a redo brings back; a drag
//   places one too; Escape gives up a half placed one; dragging a handle
//   moves it (one step, undone), Escape before the release puts it back
//   (no step); Delete removes the chosen one (none chosen: nothing), the
//   cross beside it too; its options (clicked as the window's events
//   would): snapping off and on, the chosen one's colour and snapping and
//   a vanishing point's density (a step each), all removed (one step,
//   undone), not taller than 560 pixels; the painting tools' entry (beginStroke, adjust) snaps, 2000
//   times without the arena, and the guides drawn for another tool take
//   no more of it than the overlay's painter alone; the text that goes
//   with the document's file, refused for a document not open; the
//   assistants of a closed document are let go (their memory given
//   back), also when the next one takes its memory;
// - a picture of all kinds (assistants.png, also into NEBULA_SHOTS when
//   it names a directory): the ruler's row in its colour, much drawn;
// - thousands of projections, previews and drawings leave the value
//   arena as it was.
//
// Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const documents = @import("../app/documents.mlx")
const viewport = @import("../ui/viewport.mlx")
const overlay = @import("../ui/overlay.mlx")
const kit_module = @import("../ui/kit.mlx")
const geom = @import("../core/geom.mlx")
const image_module = @import("../core/image.mlx")
const history = @import("../core/history.mlx")
const assistants = @import("../core/assistants.mlx")
const assist = @import("../tools/assist.mlx")
const tools = @import("../tools/registry.mlx")

const Set = assistants.Set
const Assistant = assistants.Assistant
const Canvas = state.Canvas

const WIDTH: usize = 800
const HEIGHT: usize = 600
const GROUND: u32 = 0xFF303030

fn near(a: f64, b: f64, within: f64) -> bool { return math.abs(a - b) <= within }

// An assistant of `kind` with `count` handles (x and y of each in turn
// in `points`) added to `set`; its place.
fn put(set: *Set, kind: u8, count: usize, points: *const [8]f64) -> usize {
    var made = assistants.blank(kind, assistants.COLOR)
    var handle: usize = 0
    while handle < count {
        _ = assistants.setHandle(&made, handle, points.*[handle * 2], points.*[handle * 2 + 1])
        handle += 1
    }
    const at = assistants.add(set, &made)
    if at == null { return assistants.NONE }
    return at.?
}

fn points2(x0: f64, y0: f64, x1: f64, y1: f64) -> [8]f64 {
    return [8]f64{ x0, y0, x1, y1, 0.0, 0.0, 0.0, 0.0 }
}

fn points4(x0: f64, y0: f64, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64) -> [8]f64 {
    return [8]f64{ x0, y0, x1, y1, x2, y2, x3, y3 }
}

// The set with only `kind` on it, a stroke begun at (sx, sy), full
// magnetism.
fn only(set: *Set, kind: u8, count: usize, points: *const [8]f64, sx: f64, sy: f64) -> void {
    assistants.clear(set)
    set.*.snap = true
    set.*.single = false
    set.*.magnetism = 1.0
    _ = put(set, kind, count, points)
    assistants.begin(set, sx, sy)
}

// Whether the set puts (x, y) at (ex, ey).
fn goes(set: *Set, x: f64, y: f64, ex: f64, ey: f64) -> bool {
    var gx: f64 = 0.0
    var gy: f64 = 0.0
    if !assistants.project(set, x, y, &gx, &gy) { return false }
    return near(gx, ex, 0.000001) && near(gy, ey, 0.000001)
}

// Whether the set leaves (x, y) where it is.
fn stays(set: *Set, x: f64, y: f64) -> bool {
    var gx: f64 = 1.0
    var gy: f64 = 1.0
    const moved = assistants.project(set, x, y, &gx, &gy)
    if moved { return false }
    return (gx == x || (gx != gx && x != x)) && (gy == y || (gy != gy && y != y))
}

// ---------------------------------------------------------------------------
// Rulers and the vanishing point

// The ruler's rule: a + clamp(dot(p - a, b - a) / |b - a|^2, 0, 1) (b - a);
// `held`: with the clamp.
fn onRuler(ax: f64, ay: f64, bx: f64, by: f64, px: f64, py: f64, held: bool, ox: *f64, oy: *f64) -> void {
    const dx = bx - ax
    const dy = by - ay
    var t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)
    if held && t < 0.0 { t = 0.0 }
    if held && t > 1.0 { t = 1.0 }
    ox.* = ax + t * dx
    oy.* = ay + t * dy
}

const PROBES = [12]f64{ 60.0, 45.0, 0.0, 100.0, 200.0, 0.0, -50.0, -50.0, 120.0, 90.0, 110.0, 70.0 }

fn checkRulers(set: *Set) -> u8 {
    const ends = points2(10.0, 20.0, 110.0, 70.0)
    only(set, assistants.RULER, 2, &ends, 0.0, 0.0)
    var probe: usize = 0
    var ex: f64 = 0.0
    var ey: f64 = 0.0
    while probe < 6 {
        const px = PROBES[probe * 2]
        const py = PROBES[probe * 2 + 1]
        onRuler(10.0, 20.0, 110.0, 70.0, px, py, true, &ex, &ey)
        if !goes(set, px, py, ex, ey) { return 1 }
        probe += 1
    }
    // Beyond the ends: the ends themselves.
    if !goes(set, 200.0, 0.0, 110.0, 70.0) || !goes(set, -50.0, -50.0, 10.0, 20.0) { return 2 }

    only(set, assistants.INFINITE_RULER, 2, &ends, 0.0, 0.0)
    probe = 0
    while probe < 6 {
        const px = PROBES[probe * 2]
        const py = PROBES[probe * 2 + 1]
        onRuler(10.0, 20.0, 110.0, 70.0, px, py, false, &ex, &ey)
        if !goes(set, px, py, ex, ey) { return 3 }
        probe += 1
    }
    // (200, 0) is beyond b: not held there.
    onRuler(10.0, 20.0, 110.0, 70.0, 200.0, 0.0, false, &ex, &ey)
    if near(ex, 110.0, 1.0) || !goes(set, 200.0, 0.0, ex, ey) { return 4 }

    // Parallel: the line through the start (300, 300) along b - a.
    only(set, assistants.PARALLEL_RULER, 2, &ends, 300.0, 300.0)
    probe = 0
    while probe < 6 {
        const px = PROBES[probe * 2] + 250.0
        const py = PROBES[probe * 2 + 1] + 260.0
        onRuler(300.0, 300.0, 400.0, 350.0, px, py, false, &ex, &ey)
        if !goes(set, px, py, ex, ey) { return 5 }
        probe += 1
    }
    // The start itself stays.
    if !goes(set, 300.0, 300.0, 300.0, 300.0) { return 6 }

    // Vanishing point (500, 100): the line through it and the start.
    const point = points2(500.0, 100.0, 0.0, 0.0)
    only(set, assistants.VANISHING_POINT, 1, &point, 300.0, 300.0)
    probe = 0
    while probe < 6 {
        const px = PROBES[probe * 2] + 280.0
        const py = PROBES[probe * 2 + 1] + 230.0
        onRuler(500.0, 100.0, 300.0, 300.0, px, py, false, &ex, &ey)
        if !goes(set, px, py, ex, ey) { return 7 }
        probe += 1
    }
    // A start on the vanishing point gives no line.
    assistants.begin(set, 500.0, 100.0)
    if !stays(set, 520.0, 130.0) { return 8 }

    // A ruler of no length is its one point; an infinite one of no
    // length takes nothing; nor does one with a handle missing.
    const dot = points2(40.0, 40.0, 40.0, 40.0)
    only(set, assistants.RULER, 2, &dot, 0.0, 0.0)
    if !goes(set, 90.0, -3.0, 40.0, 40.0) { return 9 }
    only(set, assistants.INFINITE_RULER, 2, &dot, 0.0, 0.0)
    if !stays(set, 90.0, -3.0) { return 10 }
    only(set, assistants.RULER, 1, &ends, 0.0, 0.0)
    if !stays(set, 90.0, -3.0) || assistants.isComplete(&set.*.items[0]) { return 11 }
    return 0
}

// ---------------------------------------------------------------------------
// Ellipses

// The image point of the ellipse at parameter angle t.
fn ellipsePoint(e: *const assistants.Ellipse, t: f64, x: *f64, y: *f64) -> void {
    const u = e.*.along * math.cos(t)
    const v = e.*.across * math.sin(t)
    x.* = e.*.centerX + u * e.*.axisX - v * e.*.axisY
    y.* = e.*.centerY + u * e.*.axisY + v * e.*.axisX
}

fn ellipseDistance(e: *const assistants.Ellipse, t: f64, px: f64, py: f64) -> f64 {
    var x: f64 = 0.0
    var y: f64 = 0.0
    ellipsePoint(e, t, &x, &y)
    return (x - px) * (x - px) + (y - py) * (y - py)
}

// The nearest point the plain way: 3600 angles, the best refined by
// golden section between its neighbours.
fn searchEllipse(e: *const assistants.Ellipse, px: f64, py: f64, x: *f64, y: *f64) -> void {
    var best_t: f64 = 0.0
    var best = ellipseDistance(e, 0.0, px, py)
    var step: usize = 1
    while step < 3600 {
        const t = @floatFromInt(f64, step) * math.tau / 3600.0
        const distance = ellipseDistance(e, t, px, py)
        if distance < best {
            best = distance
            best_t = t
        }
        step += 1
    }
    var a = best_t - math.tau / 3600.0
    var b = best_t + math.tau / 3600.0
    var round: usize = 0
    while round < 100 {
        const c = b - (b - a) * 0.6180339887498949
        const d = a + (b - a) * 0.6180339887498949
        if ellipseDistance(e, c, px, py) < ellipseDistance(e, d, px, py) { b = d } else { a = c }
        round += 1
    }
    ellipsePoint(e, (a + b) / 2.0, x, y)
}

// How far image point (x, y) is from being on `e` scaled by `scale`
// ((u / A)^2 + (v / B)^2 - 1).
fn offEllipse(e: *const assistants.Ellipse, scale: f64, x: f64, y: f64) -> f64 {
    const u = (x - e.*.centerX) * e.*.axisX + (y - e.*.centerY) * e.*.axisY
    const v = (y - e.*.centerY) * e.*.axisX - (x - e.*.centerX) * e.*.axisY
    const a = e.*.along * scale
    const b = e.*.across * scale
    return math.abs(u * u / (a * a) + v * v / (b * b) - 1.0)
}

// A number from 0 to 1 of a simple sequence (the same in every run).
fn unit(seed: *u64) -> f64 {
    seed.* = seed.* *% 6364136223846793005 +% 1442695040888963407
    return @floatFromInt(f64, seed.* >> 11) / 9007199254740992.0
}

// The handles of a turned ellipse: its axis from (100, 200) to (400,
// 260), half the axis across 60, the third handle on it at angle 1.
fn ellipseHandles(into: *[8]f64) -> void {
    const length = math.hypot(300.0, 60.0)
    const ux = 300.0 / length
    const uy = 60.0 / length
    const u = length / 2.0 * math.cos(1.0)
    const v = 60.0 * math.sin(1.0)
    into.* = [8]f64{ 100.0, 200.0, 400.0, 260.0, 250.0 + u * ux - v * uy, 230.0 + u * uy + v * ux, 0.0, 0.0 }
}

// 50 points around `e` scaled by `scale`: each one's place from the set
// is on the ellipse and within half a pixel of the searched nearest.
fn nearestEverywhere(set: *Set, e: *const assistants.Ellipse, scale: f64, seed_value: u64) -> bool {
    var scaled = e.*
    scaled.along = e.*.along * scale
    scaled.across = e.*.across * scale
    var seed = seed_value
    var done: usize = 0
    while done < 50 {
        const px = scaled.centerX + (unit(&seed) * 2.0 - 1.0) * (scaled.along + 80.0)
        const py = scaled.centerY + (unit(&seed) * 2.0 - 1.0) * (scaled.along + 80.0)
        // (On the long axis inside the ellipse two points are nearest.)
        const v = (py - scaled.centerY) * scaled.axisX - (px - scaled.centerX) * scaled.axisY
        if math.abs(v) < 1.0 { continue }
        var gx: f64 = 0.0
        var gy: f64 = 0.0
        if !assistants.project(set, px, py, &gx, &gy) { return false }
        var sx: f64 = 0.0
        var sy: f64 = 0.0
        searchEllipse(&scaled, px, py, &sx, &sy)
        if offEllipse(e, scale, gx, gy) > 0.000001 { return false }
        if math.hypot(gx - sx, gy - sy) > 0.5 { return false }
        if math.hypot(gx - px, gy - py) > math.hypot(sx - px, sy - py) + 0.000001 { return false }
        done += 1
    }
    return true
}

fn checkEllipses(set: *Set) -> u8 {
    var handles: [8]f64 = undefined
    ellipseHandles(&handles)
    only(set, assistants.ELLIPSE, 3, &handles, 0.0, 0.0)
    var e: assistants.Ellipse = undefined
    if !assistants.ellipseOf(&set.*.items[0], &e) { return 20 }
    if !near(e.along, math.hypot(300.0, 60.0) / 2.0, 0.000001) || !near(e.across, 60.0, 0.000001) || !near(e.centerX, 250.0, 0.000001) { return 21 }
    if offEllipse(&e, 1.0, handles[4], handles[5]) > 0.000000001 { return 22 }
    if !nearestEverywhere(set, &e, 1.0, 7) { return 23 }
    // The centre, the axis's ends, a point on the long axis outside: on
    // the ellipse, nothing traps.
    var gx: f64 = 0.0
    var gy: f64 = 0.0
    if !assistants.project(set, 250.0, 230.0, &gx, &gy) || offEllipse(&e, 1.0, gx, gy) > 0.000001 { return 24 }
    if !goes(set, 100.0, 200.0, 100.0, 200.0) { return 25 }
    if !assistants.project(set, 500.0, 280.0, &gx, &gy) || !near(gx, 400.0, 0.000001) || !near(gy, 260.0, 0.000001) { return 26 }

    // Concentric: scaled to pass through the start, half the size.
    const start_x = 250.0 + 0.5 * (e.along * math.cos(2.0) * e.axisX - e.across * math.sin(2.0) * e.axisY)
    const start_y = 230.0 + 0.5 * (e.along * math.cos(2.0) * e.axisY + e.across * math.sin(2.0) * e.axisX)
    only(set, assistants.CONCENTRIC_ELLIPSE, 3, &handles, start_x, start_y)
    if !assistants.project(set, start_x, start_y, &gx, &gy) || !near(gx, start_x, 0.000001) || !near(gy, start_y, 0.000001) { return 27 }
    if !nearestEverywhere(set, &e, 0.5, 11) { return 28 }
    // A start in the middle makes no ellipse.
    assistants.begin(set, 250.0, 230.0)
    if !stays(set, 300.0, 300.0) { return 29 }

    // Fisheye: the ellipse of the family through the start (the same
    // axis, its half axis across through the start).
    const fu = 60.0
    const fv = 30.0
    const fx = 250.0 + fu * e.axisX - fv * e.axisY
    const fy = 230.0 + fu * e.axisY + fv * e.axisX
    only(set, assistants.FISHEYE, 3, &handles, fx, fy)
    var family = e
    family.across = fv / @sqrt(1.0 - (fu / e.along) * (fu / e.along))
    if !nearestEverywhere(set, &family, 1.0, 13) { return 30 }
    if !assistants.project(set, fx, fy, &gx, &gy) || !near(gx, fx, 0.000001) || !near(gy, fy, 0.000001) { return 31 }
    // A start on the axis: the axis between its ends.
    assistants.begin(set, 250.0 + 50.0 * e.axisX, 230.0 + 50.0 * e.axisY)
    if !goes(set, 250.0 - 20.0 * e.axisY, 230.0 + 20.0 * e.axisX, 250.0, 230.0) { return 32 }
    if !goes(set, 900.0, 400.0, 400.0, 260.0) { return 33 }
    // A start beyond the axis's ends: no ellipse of the family.
    assistants.begin(set, 500.0, 280.0)
    if !stays(set, 300.0, 300.0) { return 34 }

    // A third handle beyond the axis's ends makes no ellipse.
    const flat = points4(100.0, 200.0, 400.0, 260.0, 450.0, 200.0, 0.0, 0.0)
    only(set, assistants.ELLIPSE, 3, &flat, 0.0, 0.0)
    if assistants.ellipseOf(&set.*.items[0], &e) || !stays(set, 300.0, 300.0) { return 35 }
    return 0
}

// ---------------------------------------------------------------------------
// Perspectives

// Where the lines through (ax, ay) and (bx, by) and through (cx, cy) and
// (dx, dy) meet (Cramer's rule).
fn crossing(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, dx: f64, dy: f64, x: *f64, y: *f64) -> void {
    const a1 = by - ay
    const b1 = ax - bx
    const c1 = a1 * ax + b1 * ay
    const a2 = dy - cy
    const b2 = cx - dx
    const c2 = a2 * cx + b2 * cy
    const det = a1 * b2 - a2 * b1
    x.* = (c1 * b2 - c2 * b1) / det
    y.* = (a1 * c2 - a2 * c1) / det
}

// Whether (x, y) is on the line through (sx, sy) toward (vx, vy).
fn onLine(sx: f64, sy: f64, vx: f64, vy: f64, x: f64, y: f64) -> bool {
    const dx = vx - sx
    const dy = vy - sy
    return math.abs((x - sx) * dy - (y - sy) * dx) / math.hypot(dx, dy) < 0.000001
}

fn checkPerspectives(set: *Set) -> u8 {
    const quad = points4(100.0, 100.0, 300.0, 120.0, 320.0, 300.0, 80.0, 280.0)
    only(set, assistants.PERSPECTIVE, 4, &quad, 200.0, 200.0)
    var v0x: f64 = 0.0
    var v0y: f64 = 0.0
    var v1x: f64 = 0.0
    var v1y: f64 = 0.0
    crossing(100.0, 100.0, 300.0, 120.0, 80.0, 280.0, 320.0, 300.0, &v0x, &v0y)
    crossing(300.0, 120.0, 320.0, 300.0, 100.0, 100.0, 80.0, 280.0, &v1x, &v1y)
    var point: assistants.Vanishing = undefined
    if !assistants.vanishing(&set.*.items[0], 0, &point) || !point.finite || !near(point.x, v0x, 0.0001) || !near(point.y, v0y, 0.0001) { return 40 }
    if !assistants.vanishing(&set.*.items[0], 1, &point) || !point.finite || !near(point.x, v1x, 0.0001) || !near(point.y, v1y, 0.0001) { return 41 }
    // Toward the first vanishing point (a little off it): its line.
    const d0 = math.hypot(v0x - 200.0, v0y - 200.0)
    const d1 = math.hypot(v1x - 200.0, v1y - 200.0)
    const ax = 200.0 + (v0x - 200.0) / d0 * 6.0 + 1.0
    const ay = 200.0 + (v0y - 200.0) / d0 * 6.0
    var gx: f64 = 0.0
    var gy: f64 = 0.0
    var ex: f64 = 0.0
    var ey: f64 = 0.0
    if !assistants.project(set, ax, ay, &gx, &gy) || !onLine(200.0, 200.0, v0x, v0y, gx, gy) { return 42 }
    onRuler(200.0, 200.0, v0x, v0y, ax, ay, false, &ex, &ey)
    if !near(gx, ex, 0.000001) || !near(gy, ey, 0.000001) { return 43 }
    // Not yet 10 pixels away: a point toward the other one takes its line.
    const bx = 200.0 + (v1x - 200.0) / d1 * 6.0
    const by = 200.0 + (v1y - 200.0) / d1 * 6.0 + 0.5
    if !assistants.project(set, bx, by, &gx, &gy) || !onLine(200.0, 200.0, v1x, v1y, gx, gy) { return 44 }
    // 20 pixels toward the first: decided; then near the second's line
    // the first's still takes it.
    if !assistants.project(set, 200.0 + (v0x - 200.0) / d0 * 20.0, 200.0 + (v0y - 200.0) / d0 * 20.0 + 1.0, &gx, &gy) || !onLine(200.0, 200.0, v0x, v0y, gx, gy) { return 45 }
    if !assistants.project(set, 200.0 + (v1x - 200.0) / d1 * 40.0, 200.0 + (v1y - 200.0) / d1 * 40.0, &gx, &gy) || !onLine(200.0, 200.0, v0x, v0y, gx, gy) { return 46 }
    // A new stroke chooses again.
    assistants.begin(set, 200.0, 200.0)
    if !assistants.project(set, 200.0 + (v1x - 200.0) / d1 * 40.0, 200.0 + (v1y - 200.0) / d1 * 40.0 + 2.0, &gx, &gy) || !onLine(200.0, 200.0, v1x, v1y, gx, gy) { return 47 }

    // A rectangle: the vanishing points are at no place, the lines go
    // along the sides.
    const box = points4(100.0, 100.0, 300.0, 100.0, 300.0, 200.0, 100.0, 200.0)
    only(set, assistants.PERSPECTIVE, 4, &box, 150.0, 150.0)
    if !assistants.vanishing(&set.*.items[0], 0, &point) || point.finite || !near(math.abs(point.dx), 1.0, 0.000001) { return 48 }
    if !goes(set, 180.0, 153.0, 180.0, 150.0) { return 49 }
    assistants.begin(set, 150.0, 150.0)
    if !goes(set, 152.0, 190.0, 150.0, 190.0) { return 50 }

    // Two points: toward either, or upright to the horizon.
    const two = points4(-200.0, 150.0, 900.0, 150.0, 350.0, 300.0, 0.0, 0.0)
    only(set, assistants.TWO_POINT_PERSPECTIVE, 3, &two, 300.0, 400.0)
    if !goes(set, 301.0, 380.0, 300.0, 380.0) { return 51 }
    assistants.begin(set, 300.0, 400.0)
    const wx = 300.0 + (900.0 - 300.0) / math.hypot(600.0, 250.0) * 30.0
    const wy = 400.0 + (150.0 - 400.0) / math.hypot(600.0, 250.0) * 30.0 + 1.0
    if !assistants.project(set, wx, wy, &gx, &gy) || !onLine(300.0, 400.0, 900.0, 150.0, gx, gy) { return 52 }
    assistants.begin(set, 300.0, 400.0)
    if !assistants.project(set, 270.0, 392.0, &gx, &gy) || !onLine(300.0, 400.0, -200.0, 150.0, gx, gy) { return 53 }
    if !assistants.vanishing(&set.*.items[0], 2, &point) || point.finite || !near(math.abs(point.dy), 1.0, 0.000001) { return 54 }

    // snapOnto only asks: 40 pixels toward the second vanishing point it
    // gives that one's line, and the stroke may still take the first's.
    only(set, assistants.PERSPECTIVE, 4, &quad, 200.0, 200.0)
    if !assistants.snapOnto(set, 0, 200.0 + (v1x - 200.0) / d1 * 40.0, 200.0 + (v1y - 200.0) / d1 * 40.0 + 2.0, &gx, &gy) || !onLine(200.0, 200.0, v1x, v1y, gx, gy) { return 55 }
    if !assistants.project(set, 200.0 + (v0x - 200.0) / d0 * 40.0, 200.0 + (v0y - 200.0) / d0 * 40.0 + 1.0, &gx, &gy) || !onLine(200.0, 200.0, v0x, v0y, gx, gy) { return 56 }
    // ... and does not take the line the stroke kept.
    if !assistants.snapOnto(set, 0, 200.0 + (v1x - 200.0) / d1 * 40.0, 200.0 + (v1y - 200.0) / d1 * 40.0, &gx, &gy) || !onLine(200.0, 200.0, v0x, v0y, gx, gy) { return 57 }
    return 0
}

// ---------------------------------------------------------------------------
// The spline

fn splineHandles() -> [8]f64 {
    return points4(50.0, 300.0, 450.0, 300.0, 150.0, 50.0, 350.0, 550.0)
}

fn checkSpline(set: *Set) -> u8 {
    const handles = splineHandles()
    only(set, assistants.SPLINE, 4, &handles, 0.0, 0.0)
    const curve = &set.*.items[0]
    var x: f64 = 0.0
    var y: f64 = 0.0
    assistants.splineAt(curve, 0.0, &x, &y)
    if x != 50.0 || y != 300.0 { return 60 }
    assistants.splineAt(curve, 1.0, &x, &y)
    if x != 450.0 || y != 300.0 { return 61 }
    var seed: u64 = 99
    var done: usize = 0
    while done < 50 {
        const px = unit(&seed) * 600.0 - 50.0
        const py = unit(&seed) * 600.0
        var gx: f64 = 0.0
        var gy: f64 = 0.0
        if !assistants.project(set, px, py, &gx, &gy) { return 62 }
        var best: f64 = 1.0e300
        var sample: usize = 0
        while sample <= 200000 {
            assistants.splineAt(curve, @floatFromInt(f64, sample) / 200000.0, &x, &y)
            const distance = (x - px) * (x - px) + (y - py) * (y - py)
            if distance < best { best = distance }
            sample += 1
        }
        const found = math.hypot(gx - px, gy - py)
        if found > @sqrt(best) + 0.000001 || found < @sqrt(best) - 0.01 { return 63 }
        done += 1
    }
    // A spline with a handle missing takes nothing.
    only(set, assistants.SPLINE, 3, &handles, 0.0, 0.0)
    if !stays(set, 100.0, 100.0) { return 64 }
    return 0
}

// ---------------------------------------------------------------------------
// Choosing, magnetism, the edges

fn checkChoosing(set: *Set) -> u8 {
    assistants.clear(set)
    set.*.magnetism = 1.0
    set.*.snap = true
    set.*.single = true
    const upper = points2(0.0, 100.0, 400.0, 100.0)
    const lower = points2(0.0, 140.0, 400.0, 140.0)
    _ = put(set, assistants.RULER, 2, &upper)
    _ = put(set, assistants.RULER, 2, &lower)
    // Snap single: the one nearest 10 pixels on is kept.
    assistants.begin(set, 50.0, 105.0)
    if !goes(set, 52.0, 105.0, 52.0, 100.0) || assistants.chosenOf(set) != assistants.NONE { return 70 }
    if !goes(set, 65.0, 105.0, 65.0, 100.0) || assistants.chosenOf(set) != 0 { return 71 }
    if !goes(set, 100.0, 138.0, 100.0, 100.0) { return 72 }
    // Before the choice the nearest takes each point.
    assistants.begin(set, 50.0, 135.0)
    if !goes(set, 51.0, 135.0, 51.0, 140.0) || !goes(set, 52.0, 102.0, 52.0, 100.0) { return 73 }
    // Without it the nearer one takes each point.
    set.*.single = false
    assistants.begin(set, 50.0, 105.0)
    if !goes(set, 65.0, 105.0, 65.0, 100.0) || !goes(set, 100.0, 138.0, 100.0, 140.0) { return 74 }
    // The one kept stops snapping: nothing snaps.
    set.*.single = true
    assistants.begin(set, 50.0, 105.0)
    _ = goes(set, 65.0, 105.0, 65.0, 100.0)
    set.*.items[0].snap = false
    if !stays(set, 70.0, 105.0) { return 75 }
    // A new stroke: the other one.
    assistants.begin(set, 50.0, 105.0)
    if !goes(set, 70.0, 105.0, 70.0, 140.0) { return 76 }
    set.*.items[0].snap = true

    // Magnetism: half way, none.
    set.*.magnetism = 0.5
    assistants.begin(set, 60.0, 120.0)
    if !goes(set, 60.0, 112.0, 60.0, 106.0) { return 77 }
    set.*.magnetism = 0.0
    assistants.begin(set, 60.0, 120.0)
    if !goes(set, 60.0, 112.0, 60.0, 112.0) { return 78 }
    set.*.magnetism = math.nan()
    assistants.begin(set, 60.0, 120.0)
    if !goes(set, 60.0, 112.0, 60.0, 112.0) { return 79 }
    set.*.magnetism = 1.0

    // Snapping off; no stroke begun; NaN and huge points and starts.
    set.*.snap = false
    assistants.begin(set, 60.0, 120.0)
    if !stays(set, 60.0, 112.0) { return 80 }
    set.*.snap = true
    if !stays(set, math.nan(), 112.0) || !stays(set, 1.0e300, 5.0) || !stays(set, math.infinity(), 0.0) { return 81 }
    assistants.begin(set, math.nan(), 0.0)
    if !stays(set, 60.0, 112.0) { return 82 }
    assistants.begin(set, 1.0e20, 0.0)
    if !stays(set, 60.0, 112.0) { return 83 }

    // Handles: in order, not beyond the kind's, places only.
    var made = assistants.blank(assistants.RULER, 0)
    if assistants.setHandle(&made, 1, 0.0, 0.0) || !assistants.setHandle(&made, 0, 1.0, 1.0) { return 84 }
    if assistants.setHandle(&made, 0, math.nan(), 0.0) || assistants.setHandle(&made, 1, 2.0e9, 0.0) { return 85 }
    if !assistants.setHandle(&made, 1, 5.0, 5.0) || assistants.setHandle(&made, 2, 9.0, 9.0) || made.count != 2 { return 86 }
    // A kind that is none becomes a ruler.
    if assistants.blank(200, 0).kind != assistants.RULER || assistants.kindByKey("ruler") != assistants.RULER || @intCast(usize, assistants.kindByKey("nothing")) != assistants.KINDS { return 87 }

    // 32 and no more; places beyond the end are refused.
    assistants.clear(set)
    var count: usize = 0
    while count < assistants.MAX {
        if put(set, assistants.RULER, 2, &upper) != count { return 88 }
        count += 1
    }
    if assistants.add(set, &made) != null || assistants.insert(set, 0, &made) { return 89 }
    if assistants.remove(set, 32) || !assistants.remove(set, 31) || assistants.insert(set, 32, &made) || !assistants.insert(set, 0, &made) { return 90 }
    if set.*.items[0].x[1] != 5.0 || set.*.count != 32 { return 91 }
    assistants.clear(set)
    return 0
}

// Only assistants of the module's own make go in (a kind of its own, no
// more handles than the kind has, each a place): what the set holds is
// always written as a text that reads back. One that is not drawn is
// nothing (and nothing beyond its four handles is read).
fn checkValid(set: *Set, other: *Set, points: [*]f64, runs: [*]u32) -> u8 {
    assistants.clear(set)
    var kind: u8 = 0
    while @intCast(usize, kind) < assistants.KINDS {
        const empty = assistants.blank(kind, 0)
        if !assistants.isValid(&empty) { return 92 }
        kind += 1
    }
    var bad = assistants.blank(assistants.RULER, 0)
    _ = assistants.setHandle(&bad, 0, 1.0, 2.0)
    _ = assistants.setHandle(&bad, 1, 3.0, 4.0)
    bad.kind = 77
    if assistants.isValid(&bad) || assistants.add(set, &bad) != null || assistants.insert(set, 0, &bad) || set.*.count != 0 { return 93 }
    bad.kind = assistants.RULER
    bad.count = 3
    if assistants.isValid(&bad) || assistants.add(set, &bad) != null { return 94 }
    bad.kind = assistants.SPLINE
    bad.count = 200
    var lines = assistants.linesInto(points, POINTS, runs, RUNS)
    if assistants.isValid(&bad) || assistants.add(set, &bad) != null || !assistants.preview(&bad, 100.0, &lines) || lines.runCount != 0 || lines.count != 0 { return 95 }
    bad.count = 2
    bad.x[1] = math.nan()
    if assistants.isValid(&bad) || assistants.add(set, &bad) != null { return 96 }
    bad.x[1] = 3.0
    bad.y[0] = -2.0e9
    if assistants.isValid(&bad) || assistants.add(set, &bad) != null { return 97 }
    bad.y[0] = 2.0
    // Now a spline with two of its handles: taken, written, read back.
    if assistants.add(set, &bad) == null || set.*.count != 1 { return 98 }
    var text = std.ArrayList(u8).init(std.heap.allocator())
    if !assistants.write(set, &text) || !assistants.read(other, text.items()) || other.*.count != 1 || other.*.items[0].count != 2 || other.*.items[0].y[0] != 2.0 { return 99 }
    assistants.clear(set)
    return 0
}

// The configuration of each kind for checkMoved: its handles and a
// stroke's start.
fn configOf(kind: u8, handles: *[8]f64, sx: *f64, sy: *f64) -> void {
    sx.* = 300.0
    sy.* = 300.0
    if kind == assistants.RULER || kind == assistants.INFINITE_RULER || kind == assistants.PARALLEL_RULER {
        handles.* = points2(10.0, 20.0, 110.0, 70.0)
    } else if kind == assistants.VANISHING_POINT {
        handles.* = points2(500.0, 100.0, 0.0, 0.0)
    } else if kind == assistants.PERSPECTIVE {
        handles.* = points4(100.0, 100.0, 300.0, 120.0, 320.0, 300.0, 80.0, 280.0)
        sx.* = 200.0
        sy.* = 200.0
    } else if kind == assistants.TWO_POINT_PERSPECTIVE {
        handles.* = points4(-200.0, 150.0, 900.0, 150.0, 350.0, 300.0, 0.0, 0.0)
        sy.* = 400.0
    } else if kind == assistants.SPLINE {
        handles.* = splineHandles()
    } else {
        ellipseHandles(handles)
        sx.* = 270.0
        sy.* = 250.0
    }
}

// Where `kind` (configOf) puts start + (ox, oy) of a stroke begun at its
// start, everything first scaled by `scale` about the origin and moved by
// (dx, dy), the result moved and scaled back. False when it took nothing.
fn placedAs(set: *Set, kind: u8, ox: f64, oy: f64, scale: f64, dx: f64, dy: f64, x: *f64, y: *f64) -> bool {
    var handles: [8]f64 = undefined
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    configOf(kind, &handles, &sx, &sy)
    var moved: [8]f64 = undefined
    var index: usize = 0
    while index < 4 {
        moved[index * 2] = handles[index * 2] * scale + dx
        moved[index * 2 + 1] = handles[index * 2 + 1] * scale + dy
        index += 1
    }
    only(set, kind, assistants.handlesOf(kind), &moved, sx * scale + dx, sy * scale + dy)
    var gx: f64 = 0.0
    var gy: f64 = 0.0
    if !assistants.project(set, (sx + ox) * scale + dx, (sy + oy) * scale + dy, &gx, &gy) { return false }
    x.* = (gx - dx) / scale
    y.* = (gy - dy) / scale
    return true
}

const OFFSETS = [8]f64{ 37.0, -21.0, -80.0, 45.0, 5.0, 140.0, -3.0, -4.0 }

// Every kind puts a point the same way wherever the configuration lies
// (far off in negative coordinates) and whatever its size (a few pixels
// across, or ten thousand times as large): what moving and scaling the
// plane must give.
fn checkMoved(set: *Set) -> u8 {
    var kind: u8 = 0
    while @intCast(usize, kind) < assistants.KINDS {
        // The spline's nearest point comes from a search: its parameter
        // is held to about 1e-8.
        const within: f64 = if kind == assistants.SPLINE { 0.001 } else { 0.000001 }
        var probe: usize = 0
        while probe < 4 {
            const ox = OFFSETS[probe * 2]
            const oy = OFFSETS[probe * 2 + 1]
            var x: f64 = 0.0
            var y: f64 = 0.0
            if !placedAs(set, kind, ox, oy, 1.0, 0.0, 0.0, &x, &y) { return 36 }
            var mx: f64 = 0.0
            var my: f64 = 0.0
            if !placedAs(set, kind, ox, oy, 1.0, -70000.25, -130000.5, &mx, &my) || !near(mx, x, within) || !near(my, y, within) { return 37 }
            if !placedAs(set, kind, ox, oy, 1.0 / 256.0, -3.0, 5.0, &mx, &my) || !near(mx, x, within) || !near(my, y, within) { return 38 }
            if !placedAs(set, kind, ox, oy, 20000.0, 0.0, 0.0, &mx, &my) || !near(mx, x, within) || !near(my, y, within) { return 39 }
            probe += 1
        }
        kind += 1
    }
    assistants.clear(set)
    return 0
}

// ---------------------------------------------------------------------------
// Undo

// A custom step that changes nothing.
fn nothing(context: usize, image: *image_module.Image, undo: bool) -> geom.Rect {
    return geom.empty()
}

// What 1000 undos and redos of the last step take of the value arena.
fn undoneMany(steps: *history.History, image: *image_module.Image) -> usize {
    const arena = turns.locate()
    const used = turns.used(arena)
    var round: usize = 0
    while round < 1000 {
        _ = history.undo(steps, image)
        _ = history.redo(steps, image)
        round += 1
    }
    return turns.used(arena) - used
}

fn checkHistory(set: *Set) -> u8 {
    const allocator = std.heap.allocator()
    const start_live = std.heap.liveBytes()
    const made = image_module.create(allocator, 100, 100, 72.0)
    if made == null { return 100 }
    const image = made.?
    const steps = image.*.history
    assistants.clear(set)
    const ends = points2(1.0, 2.0, 3.0, 4.0)
    const first = put(set, assistants.RULER, 2, &ends)
    if first != 0 || !assistants.recordAdded(steps, set, 0, "Add assistant") { return 101 }
    if history.stepsDone(steps) != 1 || !std.text.same(history.undoName(steps), "Add assistant") { return 102 }
    _ = history.undo(steps, image)
    if set.*.count != 0 { return 103 }
    _ = history.redo(steps, image)
    if set.*.count != 1 || set.*.items[0].x[1] != 3.0 { return 104 }
    // Changed.
    const before = set.*.items[0]
    set.*.items[0].x[1] = 99.0
    set.*.items[0].color = 0xFF00FF00
    if !assistants.recordChanged(steps, set, 0, &before, "Move") { return 105 }
    _ = history.undo(steps, image)
    if set.*.items[0].x[1] != 3.0 || set.*.items[0].color != assistants.COLOR { return 106 }
    _ = history.redo(steps, image)
    if set.*.items[0].x[1] != 99.0 || set.*.items[0].color != 0xFF00FF00 { return 107 }
    // A second one before it; the first removed.
    const other = points2(7.0, 7.0, 8.0, 8.0)
    var second = assistants.blank(assistants.SPLINE, 0)
    _ = assistants.setHandle(&second, 0, other[0], other[1])
    if !assistants.insert(set, 0, &second) || !assistants.recordAdded(steps, set, 0, "Add") { return 108 }
    const removed = set.*.items[1]
    if !assistants.remove(set, 1) || !assistants.recordRemoved(steps, set, 1, &removed, "Remove") { return 109 }
    if set.*.count != 1 || set.*.items[0].kind != assistants.SPLINE { return 110 }
    _ = history.undo(steps, image)
    if set.*.count != 2 || set.*.items[1].kind != assistants.RULER || set.*.items[1].x[1] != 99.0 { return 111 }
    _ = history.undo(steps, image)
    if set.*.count != 1 || set.*.items[0].kind != assistants.RULER { return 112 }
    _ = history.jump(steps, image, 4)
    if set.*.count != 1 || set.*.items[0].kind != assistants.SPLINE { return 113 }
    // Out of range is refused.
    if assistants.recordAdded(steps, set, 5, "x") || assistants.recordChanged(steps, set, 1, &before, "x") { return 114 }
    // A step undone and then replaced by a new one: the undone one's
    // memory is given back (the new one takes as much).
    const changed = set.*.items[0]
    set.*.items[0].x[0] = 11.0
    if !assistants.recordChanged(steps, set, 0, &changed, "Move") { return 116 }
    const recorded = std.heap.liveBytes()
    _ = history.undo(steps, image)
    if set.*.items[0].x[0] != changed.x[0] { return 117 }
    set.*.items[0].x[0] = 12.0
    if !assistants.recordChanged(steps, set, 0, &changed, "Move") || std.heap.liveBytes() != recorded { return 118 }
    // Thousands of undos and redos take no more of the value arena than
    // the history takes for a custom step that does nothing (it takes
    // some itself: see the report).
    const ours = undoneMany(steps, image)
    if set.*.items[0].x[0] != 12.0 { return 119 }
    history.custom(steps, "Nothing", 0, nothing, null)
    if undoneMany(steps, image) != ours { return 119 }
    // The image goes: the steps are forgotten, all their memory given
    // back.
    image_module.destroy(image)
    if std.heap.liveBytes() != start_live { return 115 }
    assistants.clear(set)
    return 0
}

// ---------------------------------------------------------------------------
// The text

fn same(a: *const Assistant, b: *const Assistant) -> bool {
    if a.*.kind != b.*.kind || a.*.count != b.*.count || a.*.snap != b.*.snap || a.*.color != b.*.color || a.*.density != b.*.density { return false }
    var handle: usize = 0
    while handle < @intCast(usize, a.*.count) {
        if a.*.x[handle] != b.*.x[handle] || a.*.y[handle] != b.*.y[handle] { return false }
        handle += 1
    }
    return true
}

fn refused(set: *Set, text: []const u8) -> bool {
    const count = set.*.count
    const kind = set.*.items[0].kind
    if assistants.read(set, text) { return false }
    return set.*.count == count && set.*.items[0].kind == kind
}

fn checkText(set: *Set, other: *Set) -> u8 {
    assistants.clear(set)
    set.*.show = false
    set.*.snap = true
    set.*.single = false
    set.*.magnetism = 0.37
    const odd = points2(1.0 / 3.0, -12345.678, 0.1, 1.0e-5)
    _ = put(set, assistants.RULER, 2, &odd)
    const point = points2(-0.0, 640.25, 0.0, 0.0)
    const vp = put(set, assistants.VANISHING_POINT, 1, &point)
    set.*.items[vp].color = 0x80123456
    set.*.items[vp].snap = false
    set.*.items[vp].density = 24
    const quad = points4(100.0, 100.0, 300.0, 120.0, 320.0, 300.0, 80.0, 280.0)
    _ = put(set, assistants.PERSPECTIVE, 4, &quad)
    const handles = splineHandles()
    _ = put(set, assistants.SPLINE, 4, &handles)
    // One not complete is kept as it is.
    _ = put(set, assistants.ELLIPSE, 2, &quad)
    var text = std.ArrayList(u8).init(std.heap.allocator())
    if !assistants.write(set, &text) { return 120 }
    if !assistants.read(other, text.items()) { return 121 }
    if other.*.count != 5 || other.*.show || !other.*.snap || other.*.single || other.*.magnetism != 0.37 { return 122 }
    var index: usize = 0
    while index < 5 {
        if !same(&set.*.items[index], &other.*.items[index]) { return 123 }
        index += 1
    }
    var again = std.ArrayList(u8).init(std.heap.allocator())
    if !assistants.write(other, &again) || !std.text.same(text.items(), again.items()) { return 124 }
    // What is not such a text changes nothing.
    if !refused(other, "") || !refused(other, "assistants 2\noptions 1 1 1 1\n") || !refused(other, "assistants 1\n") { return 125 }
    if !refused(other, "assistants 1\noptions 1 1 1 1.5\n") || !refused(other, "assistants 1\noptions 1 1 2 1\n") { return 126 }
    if !refused(other, "assistants 1\noptions 1 1 1 1\nplank FF000000 1 0 2 0 0 1 1\n") { return 127 }
    if !refused(other, "assistants 1\noptions 1 1 1 1\nruler FF00000 1 0 2 0 0 1 1\n") || !refused(other, "assistants 1\noptions 1 1 1 1\nruler FF000000 1 0 3 0 0 1 1 2 2\n") { return 128 }
    if !refused(other, "assistants 1\noptions 1 1 1 1\nruler FF000000 1 0 2 0 0 1 nan\n") || !refused(other, "assistants 1\noptions 1 1 1 1\nruler FF000000 1 0 2 0 0 1 1 junk\n") { return 129 }
    if !refused(other, "assistants 1\noptions 1 1 1 1\nruler FF000000 1 0 2 0 0 1\n") || !refused(other, "assistants 1\noptions 1 1 1 1\nruler FF000000 1 65 2 0 0 1 1\n") { return 130 }
    if !refused(other, "assistants 1\noptions 1 1 1 1\nruler FF000000 1 0 2 0 0 1 2e9\n") { return 131 }
    // More than 32 lines.
    var many = std.ArrayList(u8).init(std.heap.allocator())
    _ = many.appendSlice("assistants 1\noptions 1 1 1 1\n")
    var line: usize = 0
    while line < 33 {
        _ = many.appendSlice("ruler ff00aa00 1 0 2 0 0 1 1\n")
        line += 1
    }
    if !refused(other, many.items()) { return 132 }
    // 32 are fine, lower-case colours, blank lines and blanks around.
    many.clearRetainingCapacity()
    _ = many.appendSlice("\n  assistants 1 \r\n\noptions 0 0 0 0.25\n")
    line = 0
    while line < 32 {
        _ = many.appendSlice("ruler ff00aa00 1 0 2 0 0 1 1\n\n")
        line += 1
    }
    if !assistants.read(other, many.items()) || other.*.count != 32 || other.*.items[31].color != 0xFF00AA00 || other.*.magnetism != 0.25 || other.*.snap { return 133 }
    // An empty set.
    assistants.clear(set)
    text.clearRetainingCapacity()
    if !assistants.write(set, &text) || !assistants.read(other, text.items()) || other.*.count != 0 { return 134 }
    // Numbers beyond their ranges are written as held there.
    set.*.magnetism = 7.0
    const far_point = points2(1.0, 2.0, 0.0, 0.0)
    set.*.items[put(set, assistants.VANISHING_POINT, 1, &far_point)].density = 500
    text.clearRetainingCapacity()
    if !assistants.write(set, &text) || !assistants.read(other, text.items()) || other.*.magnetism != 1.0 || other.*.items[0].density != assistants.DENSITY { return 135 }
    assistants.clear(set)
    return 0
}

// A coordinate of 0.01 to 1e9 in size, either sign.
fn coordinate(seed: *u64) -> f64 {
    const size = 0.01 * math.pow(10.0, unit(seed) * 10.99)
    return if unit(seed) < 0.5 { 0.0 - size } else { size }
}

// The text's numbers: every double from 0.01 on in size reads back as
// itself (384 sets of 32 four-handled assistants of random coordinates);
// a smaller one comes back within 1e-18 (written to 18 decimals). Reading
// the same text twice gives the same set; writing and reading many times
// leaves the value arena alone.
fn checkNumbers(set: *Set, other: *Set) -> u8 {
    var seed: u64 = 4242
    var text = std.ArrayList(u8).init(std.heap.allocator())
    var full: usize = 0
    while full < 12 {
        assistants.clear(set)
        while set.*.count < assistants.MAX {
            var made = assistants.blank(assistants.PERSPECTIVE, 0)
            var handle: usize = 0
            while handle < 4 {
                const x = coordinate(&seed)
                const y = coordinate(&seed)
                if !assistants.setHandle(&made, handle, x, y) { return 201 }
                handle += 1
            }
            _ = assistants.add(set, &made)
        }
        text.clearRetainingCapacity()
        if !assistants.write(set, &text) || !assistants.read(other, text.items()) || other.*.count != assistants.MAX { return 202 }
        var index: usize = 0
        while index < assistants.MAX {
            if !same(&set.*.items[index], &other.*.items[index]) { return 202 }
            index += 1
        }
        full += 1
    }
    // Small ones.
    assistants.clear(set)
    const tiny = points4(1.0 / 3000.0, -2.0e-5 / 3.0, 1.0e-300, -0.0073456789012345678, 0.0, 0.0, 0.0, 0.0)
    _ = put(set, assistants.PARALLEL_RULER, 2, &tiny)
    text.clearRetainingCapacity()
    if !assistants.write(set, &text) || !assistants.read(other, text.items()) || other.*.count != 1 { return 203 }
    const back = &other.*.items[0]
    if !near(back.*.x[0], tiny[0], 1.0e-18) || !near(back.*.y[0], tiny[1], 1.0e-18) || !near(back.*.x[1], tiny[2], 1.0e-18) || !near(back.*.y[1], tiny[3], 1.0e-18) { return 203 }
    // Twice the same text, the same set; many times, no arena.
    const once = other.*.items[0]
    other.*.items[0].x[0] = 5.0
    if !assistants.read(other, text.items()) || other.*.count != 1 || !same(&once, &other.*.items[0]) { return 204 }
    const arena = turns.locate()
    const used = turns.used(arena)
    var round: usize = 0
    while round < 500 {
        text.clearRetainingCapacity()
        if !assistants.write(set, &text) || !assistants.read(other, text.items()) { return 204 }
        round += 1
    }
    if turns.used(arena) != used { return 204 }
    assistants.clear(set)
    return 0
}

// ---------------------------------------------------------------------------
// The preview

const POINTS: usize = 16384
const RUNS: usize = 2048

fn checkPreview(points: [*]f64, runs: [*]u32) -> u8 {
    var lines = assistants.linesInto(points, POINTS, runs, RUNS)
    var made = assistants.blank(assistants.RULER, 0)
    _ = assistants.setHandle(&made, 0, 10.0, 20.0)
    _ = assistants.setHandle(&made, 1, 30.0, 40.0)
    if !assistants.preview(&made, 1000.0, &lines) || lines.runCount != 1 || lines.runs[0] != 2 { return 140 }
    if points[0] != 10.0 || points[1] != 20.0 || points[2] != 30.0 || points[3] != 40.0 { return 141 }
    // An ellipse: its points on it, then its axis.
    var handles: [8]f64 = undefined
    ellipseHandles(&handles)
    var ellipse = assistants.blank(assistants.ELLIPSE, 0)
    var handle: usize = 0
    while handle < 3 {
        _ = assistants.setHandle(&ellipse, handle, handles[handle * 2], handles[handle * 2 + 1])
        handle += 1
    }
    var e: assistants.Ellipse = undefined
    _ = assistants.ellipseOf(&ellipse, &e)
    lines = assistants.linesInto(points, POINTS, runs, RUNS)
    if !assistants.preview(&ellipse, 1000.0, &lines) || lines.runCount != 2 || lines.runs[1] != 2 { return 142 }
    var at: usize = 0
    while at < @intCast(usize, lines.runs[0]) {
        if offEllipse(&e, 1.0, points[at * 2], points[at * 2 + 1]) > 0.000000001 { return 143 }
        at += 1
    }
    // A vanishing point: 16 rays and its mark.
    var vp = assistants.blank(assistants.VANISHING_POINT, 0)
    _ = assistants.setHandle(&vp, 0, 5.0, 5.0)
    lines = assistants.linesInto(points, POINTS, runs, RUNS)
    if !assistants.preview(&vp, 500.0, &lines) || lines.runCount != 18 || !near(math.hypot(points[2] - 5.0, points[3] - 5.0), 500.0, 0.000001) { return 144 }
    // A perspective: its outline, 7 lines each way, its two marks.
    var quad = assistants.blank(assistants.PERSPECTIVE, 0)
    const corners = points4(100.0, 100.0, 300.0, 120.0, 320.0, 300.0, 80.0, 280.0)
    handle = 0
    while handle < 4 {
        _ = assistants.setHandle(&quad, handle, corners[handle * 2], corners[handle * 2 + 1])
        handle += 1
    }
    lines = assistants.linesInto(points, POINTS, runs, RUNS)
    if !assistants.preview(&quad, 500.0, &lines) || lines.runCount != 1 + 14 + 4 || lines.runs[0] != 5 { return 145 }
    // The grid's first line across ends on the first and third sides.
    if !onLine(100.0, 100.0, 300.0, 120.0, points[10], points[11]) || !onLine(80.0, 280.0, 320.0, 300.0, points[12], points[13]) { return 146 }
    // Not complete: its handles joined.
    var half = assistants.blank(assistants.SPLINE, 0)
    _ = assistants.setHandle(&half, 0, 1.0, 1.0)
    _ = assistants.setHandle(&half, 1, 2.0, 2.0)
    lines = assistants.linesInto(points, POINTS, runs, RUNS)
    if !assistants.preview(&half, 500.0, &lines) || lines.runCount != 1 || lines.runs[0] != 2 { return 147 }
    // Too little room: said, what fitted is there.
    lines = assistants.linesInto(points, 3, runs, RUNS)
    if assistants.preview(&ellipse, 500.0, &lines) || lines.count != 3 { return 148 }
    lines = assistants.linesInto(points, POINTS, runs, 1)
    if assistants.preview(&vp, 500.0, &lines) || lines.runCount != 1 { return 149 }
    // Every kind at the largest density fits previewRoom's room.
    var kind: u8 = 0
    while @intCast(usize, kind) < assistants.KINDS {
        var any = assistants.blank(kind, 0)
        handle = 0
        while handle < assistants.handlesOf(kind) {
            _ = assistants.setHandle(&any, handle, corners[handle * 2], corners[handle * 2 + 1])
            handle += 1
        }
        if kind == assistants.TWO_POINT_PERSPECTIVE || kind == assistants.ELLIPSE || kind == assistants.CONCENTRIC_ELLIPSE || kind == assistants.FISHEYE {
            handle = 0
            while handle < 3 {
                _ = assistants.setHandle(&any, handle, handles[handle * 2], handles[handle * 2 + 1])
                handle += 1
            }
        }
        any.density = assistants.DENSITY + 100
        var room: usize = 0
        var run_room: usize = 0
        assistants.previewRoom(any.density, &room, &run_room)
        if room > POINTS || run_room > RUNS { return 150 }
        lines = assistants.linesInto(points, room, runs, run_room)
        if !assistants.preview(&any, 1.0e12, &lines) || lines.runCount == 0 { return 151 }
        kind += 1
    }
    return 0
}

// The rings of a concentric ellipse and of a fisheye at the largest
// density, to the last bit: ring k (1 to 64) is the base ellipse with its
// half axes (a fisheye's across alone) times k / 4, 97 points at the
// angles 2 pi j / 96 in turn; the axis after them.
fn checkRings(points: [*]f64, runs: [*]u32) -> u8 {
    var handles: [8]f64 = undefined
    ellipseHandles(&handles)
    var kind = assistants.CONCENTRIC_ELLIPSE
    var pass: usize = 0
    while pass < 2 {
        var made = assistants.blank(kind, 0)
        var handle: usize = 0
        while handle < 3 {
            _ = assistants.setHandle(&made, handle, handles[handle * 2], handles[handle * 2 + 1])
            handle += 1
        }
        made.density = assistants.DENSITY
        var e: assistants.Ellipse = undefined
        if !assistants.ellipseOf(&made, &e) { return 158 }
        var lines = assistants.linesInto(points, POINTS, runs, RUNS)
        if !assistants.preview(&made, 1000.0, &lines) || lines.runCount != 65 || lines.runs[64] != 2 { return 158 }
        var at: usize = 0
        var ring: usize = 1
        while ring <= 64 {
            if lines.runs[ring - 1] != 97 { return 158 }
            const scale = @floatFromInt(f64, ring) / 4.0
            var shown = e
            if kind == assistants.CONCENTRIC_ELLIPSE { shown.along = e.along * scale }
            shown.across = e.across * scale
            var step: usize = 0
            while step <= 96 {
                var x: f64 = 0.0
                var y: f64 = 0.0
                ellipsePoint(&shown, @floatFromInt(f64, step) * math.tau / 96.0, &x, &y)
                if points[at * 2] != x || points[at * 2 + 1] != y { return 159 }
                at += 1
                step += 1
            }
            ring += 1
        }
        kind = assistants.FISHEYE
        pass += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// The tool

// A script step with a window place of image point (x, y): "click X Y".
fn at(into: *[160]u8, command: []const u8, doc: *state.Document, x: f64, y: f64, rest: []const u8) -> []const u8 {
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(&doc.*.view, x, y, &wx, &wy)
    const bytes: [*]u8 = into
    var length = std.text.append(bytes, 0, 160, command)
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, @floor(wx))))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, @floor(wy))))
    length = std.text.append(bytes, length, 160, rest)
    return bytes[0..length]
}

// A frame of the tool's options alone, into `canvas` (or a layout pass);
// the height they took.
fn optionsFrame(app: *state.App, canvas: *Canvas, layout: bool) -> i32 {
    var nowhere = view.layoutCanvas()
    const target: *Canvas = if layout { &nowhere } else { canvas }
    const widgets = state.uiOf(app)
    view.begin(widgets, target)
    if !layout { canvas_module.clear(target, state.themeOf(app).*.background) }
    const k = api.kit(app)
    kit_module.begin(k, widgets, target, state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app), @intCast(u64, app.*.time), app.*.german)
    const height = tools.byKey("assistant").?.*.options.?(app, ui.rect(0, 0, 300, @intCast(i32, HEIGHT)))
    _ = kit_module.end(k)
    _ = view.end(widgets)
    return height
}

// Clicks the middle of the options' widget `name` (`index`: of a row of
// them) as the window's events would; false when it was not drawn.
fn optionsClick(app: *state.App, canvas: *Canvas, name: []const u8, index: usize, indexed: bool) -> bool {
    _ = optionsFrame(app, canvas, false)
    const id = if indexed { view.idOf(view.id(name), index) } else { view.id(name) }
    const area = view.areaOf(state.uiOf(app), id)
    if area.width <= 0 || area.height <= 0 { return false }
    _ = ui_app.feed(state.uiOf(app), ui_app.EVENT_MOTION, @bitCast(u32, area.x + area.width / 2), area.y + area.height / 2)
    _ = optionsFrame(app, canvas, false)
    _ = optionsFrame(app, canvas, true)
    _ = ui_app.feed(state.uiOf(app), ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 1)
    _ = optionsFrame(app, canvas, false)
    if ui_app.feed(state.uiOf(app), ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 0) == ui_app.FEED_CLICK { _ = optionsFrame(app, canvas, true) }
    _ = optionsFrame(app, canvas, false)
    return true
}

// The tool's options: the global ones, the chosen assistant's colour
// and snapping, removing all (one step, undone); they fit 1024 x 768.
fn checkOptions(app: *state.App, canvas: *Canvas, set: *Set) -> u8 {
    const doc = api.document(app).?
    const steps = doc.*.image.*.history
    const height = optionsFrame(app, canvas, false)
    if height <= 0 || height > 560 { return 185 }
    if view.areaOf(state.uiOf(app), view.id("nebula.assist.kind")).width <= 0 { return 186 }
    if !optionsClick(app, canvas, "nebula.assist.snap", 0, false) || set.*.snap { return 187 }
    if !optionsClick(app, canvas, "nebula.assist.snap", 0, false) || !set.*.snap { return 188 }
    // Its handle touched, the first is chosen: its colour, its snapping.
    var line: [160]u8 = undefined
    if !script.run(app, at(&line, "click", doc, set.*.items[0].x[0], set.*.items[0].y[0], "\n")) || set.*.count != 1 || api.toolBusy(app) { return 189 }
    const before = history.stepsDone(steps)
    if !optionsClick(app, canvas, "nebula.assist.color", 1, true) || set.*.items[0].color != 0xE0FF5050 || history.stepsDone(steps) != before + 1 { return 190 }
    if !optionsClick(app, canvas, "nebula.assist.own-snap", 0, false) || set.*.items[0].snap || history.stepsDone(steps) != before + 2 { return 191 }
    if !script.run(app, "key Ctrl+Z\n") || !set.*.items[0].snap || set.*.items[0].color != 0xE0FF5050 { return 192 }
    if !optionsClick(app, canvas, "nebula.assist.clear", 0, false) || set.*.count != 0 || !std.text.same(history.undoName(steps), "Remove all assistants") { return 193 }
    if !script.run(app, "key Ctrl+Z\n") || set.*.count != 1 { return 194 }
    // A vanishing point chosen (its handle touched): its density slider
    // clicked half way along is one step, undone.
    var point = assistants.blank(assistants.VANISHING_POINT, assistants.COLOR)
    _ = assistants.setHandle(&point, 0, 300.5, 60.5)
    if assistants.add(set, &point) == null || !script.run(app, at(&line, "click", doc, 300.5, 60.5, "\n")) || set.*.count != 2 || api.toolBusy(app) { return 68 }
    const done = history.stepsDone(steps)
    if !optionsClick(app, canvas, "nebula.assist.density", 0, false) || set.*.items[1].density < 30 || set.*.items[1].density > 35 { return 69 }
    if history.stepsDone(steps) != done + 1 || !std.text.same(history.undoName(steps), "Assistant density") { return 69 }
    if !script.run(app, "key Ctrl+Z\n") || set.*.items[1].density != 16 || set.*.items[1].x[0] != 300.5 { return 69 }
    _ = assistants.remove(set, 1)
    _ = optionsFrame(app, canvas, false)
    if !png.saveFile("assistant-options.png\x00".pointer, canvas.*.pixels, WIDTH, HEIGHT, WIDTH, false, std.heap.allocator()) { return 195 }
    return 0
}

// The overlay's painter made and dropped (what it costs alone).
fn painterAlone(app: *state.App, canvas: *Canvas) -> void {
    const marks = overlay.begin(app, canvas)
    overlay.line(&marks, 0.0, 0.0, 0.0, 0.0)
}

fn checkTool(app: *state.App, canvas: *Canvas) -> u8 {
    if !script.run(app, "size 800 600\nnew 400 300 FFFFFF\ntool assistant\n") { return 160 }
    const found = tools.byKey("assistant")
    if found == null || found.?.*.id != assist.ID || app.*.tool != assist.ID || found.?.*.group != state.GROUP_OTHER { return 161 }
    const doc = api.document(app).?
    const steps = doc.*.image.*.history
    var line: [160]u8 = undefined
    // Two clicks: a ruler, one step.
    if !script.run(app, at(&line, "click", doc, 100.5, 150.5, "\n")) || !api.toolBusy(app) { return 162 }
    if !script.run(app, at(&line, "click", doc, 300.5, 150.5, "\n")) || api.toolBusy(app) { return 163 }
    const set = assist.setOf(app)
    if set == null || set.?.*.count != 1 || set.?.*.items[0].kind != assistants.RULER || set.?.*.items[0].count != 2 { return 164 }
    if !near(set.?.*.items[0].x[0], 100.5, 0.6) || !near(set.?.*.items[0].x[1], 300.5, 0.6) || !near(set.?.*.items[0].y[1], 150.5, 0.6) { return 165 }
    if history.stepsDone(steps) != 1 || !std.text.same(history.undoName(steps), "Add assistant") { return 166 }
    // Undone it is gone, redone back.
    if !script.run(app, "key Ctrl+Z\n") || set.?.*.count != 0 { return 167 }
    if !script.run(app, "key Ctrl+Shift+Z\n") || set.?.*.count != 1 { return 168 }
    // The painting tools' entry snaps to it.
    assist.beginStroke(app, 120.0, 160.0)
    var gx: f64 = 0.0
    var gy: f64 = 0.0
    if !assist.adjust(app, 150.0, 160.0, &gx, &gy) || gx != 150.0 || !near(gy, set.?.*.items[0].y[0], 0.000001) { return 169 }
    // Escape gives up a half placed one.
    if !script.run(app, at(&line, "click", doc, 100.5, 250.5, "\nkey Escape\n")) || api.toolBusy(app) || set.?.*.count != 1 { return 170 }
    // A drag places one too.
    if !script.run(app, "key Ctrl+Z\n") || set.?.*.count != 0 || !script.run(app, "key Ctrl+Shift+Z\n") { return 171 }
    var wx0: f64 = 0.0
    var wy0: f64 = 0.0
    var wx1: f64 = 0.0
    var wy1: f64 = 0.0
    viewport.toWindow(&doc.*.view, 50.5, 50.5, &wx0, &wy0)
    viewport.toWindow(&doc.*.view, 250.5, 90.5, &wx1, &wy1)
    var text: [160]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 160, "drag ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wx0)))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wy0)))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wx1)))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wy1)))
    length = std.text.append(bytes, length, 160, " 8\n")
    if !script.run(app, bytes[0..length]) || set.?.*.count != 2 || set.?.*.items[1].count != 2 || !near(set.?.*.items[1].x[1], 250.5, 0.6) { return 172 }
    if history.stepsDone(steps) != 2 { return 173 }
    // Dragging the first ruler's second handle: moved, one step, undone.
    length = std.text.append(bytes, 0, 160, "drag ")
    viewport.toWindow(&doc.*.view, set.?.*.items[0].x[1], set.?.*.items[0].y[1], &wx0, &wy0)
    viewport.toWindow(&doc.*.view, 320.5, 200.5, &wx1, &wy1)
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wx0)))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wy0)))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wx1)))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, wy1)))
    length = std.text.append(bytes, length, 160, " 8\n")
    if !script.run(app, bytes[0..length]) || set.?.*.count != 2 || !near(set.?.*.items[0].x[1], 320.5, 0.6) || !near(set.?.*.items[0].y[1], 200.5, 0.6) { return 174 }
    if history.stepsDone(steps) != 3 || !script.run(app, "key Ctrl+Z\n") || !near(set.?.*.items[0].x[1], 300.5, 0.6) { return 175 }
    // Delete removes the chosen one (the first: its handle was touched).
    if !script.run(app, "key Delete\n") || set.?.*.count != 1 || !near(set.?.*.items[0].x[0], 50.5, 0.6) { return 176 }
    if !script.run(app, "key Ctrl+Z\n") || set.?.*.count != 2 || !near(set.?.*.items[0].x[0], 100.5, 0.6) { return 177 }
    // The cross beside the second's first handle removes it.
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    viewport.toWindow(&doc.*.view, set.?.*.items[1].x[0], set.?.*.items[1].y[0], &cx, &cy)
    length = std.text.append(bytes, 0, 160, "click ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, cx + 16.0)))
    length = std.text.append(bytes, length, 160, " ")
    length = std.text.appendSigned(bytes, length, 160, @intCast(isize, @intFromFloat(i64, cy - 16.0)))
    length = std.text.append(bytes, length, 160, "\n")
    if !script.run(app, bytes[0..length]) || set.?.*.count != 1 || api.toolBusy(app) || !std.text.same(history.undoName(steps), "Remove assistant") { return 178 }
    // Delete with none chosen (the one removed was): nothing goes.
    if !script.run(app, "key Delete\n") || set.?.*.count != 1 { return 12 }
    // A handle dragged and Escape pressed before the release: it is back
    // where it was, no step.
    const done_before = history.stepsDone(steps)
    if !script.run(app, at(&line, "pointer", doc, set.?.*.items[0].x[1], set.?.*.items[0].y[1], "\npress\n")) || !script.run(app, at(&line, "pointer", doc, 200.5, 80.5, "\n")) { return 14 }
    if !api.toolBusy(app) || !near(set.?.*.items[0].x[1], 200.5, 0.6) || !near(set.?.*.items[0].y[1], 80.5, 0.6) { return 14 }
    if !script.run(app, "key Escape\nrelease\n") || api.toolBusy(app) || !near(set.?.*.items[0].x[1], 300.5, 0.6) || !near(set.?.*.items[0].y[1], 150.5, 0.6) || history.stepsDone(steps) != done_before { return 15 }
    // The painting tools' entry, thousands of times, leaves the value
    // arena as it was; the guides drawn while another tool is in use take
    // what the overlay's painter takes itself, nothing more (see the
    // report).
    const arena = turns.locate()
    var used = turns.used(arena)
    var round: usize = 0
    while round < 2000 {
        assist.beginStroke(app, 120.0, 160.0)
        _ = assist.adjust(app, 150.0 + @floatFromInt(f64, round % 50), 160.0, &gx, &gy)
        round += 1
    }
    if turns.used(arena) != used || !near(gy, set.?.*.items[0].y[0], 0.000001) { return 65 }
    used = turns.used(arena)
    round = 0
    while round < 100 {
        assist.drawMarks(app, canvas)
        round += 1
    }
    const drawing = turns.used(arena) - used
    used = turns.used(arena)
    round = 0
    while round < 100 {
        painterAlone(app, canvas)
        round += 1
    }
    if drawing != turns.used(arena) - used { return 67 }
    // A frame with the tool's marks is drawn without harm.
    if !script.run(app, "shot assistant-tool.png\n") { return 179 }
    const options_failed = checkOptions(app, canvas, set.?)
    if options_failed != 0 { return options_failed }
    // Saved with the document and read back.
    var saved = std.ArrayList(u8).init(std.heap.allocator())
    if !assist.writeOf(app, doc, &saved) || saved.count() == 0 { return 180 }
    // Forgotten (a document closing): no set, its memory given back; read
    // back: the same. A document that is not open takes none.
    const live = std.heap.liveBytes()
    assist.forget(app, doc)
    if assist.setOf(app) != null || live - std.heap.liveBytes() < @sizeOf(Set) { return 181 }
    const stranger = std.heap.allocator().alloc(@sizeOf(state.Document), 16)
    if stranger == null { return 66 }
    const unlisted: *state.Document = unsafe { @ptrCast(*state.Document, stranger.?) }
    const holding = std.heap.liveBytes()
    if assist.readInto(app, unlisted, saved.items()) || std.heap.liveBytes() != holding { return 66 }
    unsafe { std.heap.allocator().free(stranger.?, @sizeOf(state.Document), 16) }
    if !assist.readInto(app, doc, saved.items()) || assist.setOf(app) == null || assist.setOf(app).?.*.count != 1 { return 182 }
    var again = std.ArrayList(u8).init(std.heap.allocator())
    if !assist.writeOf(app, doc, &again) || !std.text.same(saved.items(), again.items()) { return 183 }
    // Closed without being forgotten, and a new document (most likely in
    // the same memory): it has none (the options docker, when it is
    // drawn, makes it an empty set of its own).
    documents.close(app, 0)
    if !script.run(app, "new 64 64\n") { return 184 }
    const fresh = assist.setOf(app)
    if fresh != null && fresh.?.*.count != 0 { return 184 }
    return 0
}

// ---------------------------------------------------------------------------
// The picture

// One of each kind, each in a colour of its own.
fn allKinds(set: *Set) -> void {
    assistants.clear(set)
    const ruler = points2(40.0, 40.5, 240.0, 40.5)
    set.*.items[put(set, assistants.RULER, 2, &ruler)].color = 0xFFFF5050
    const infinite = points2(40.0, 520.0, 200.0, 560.0)
    set.*.items[put(set, assistants.INFINITE_RULER, 2, &infinite)].color = 0xFFFFB020
    const parallel = points2(280.0, 40.0, 380.0, 90.0)
    set.*.items[put(set, assistants.PARALLEL_RULER, 2, &parallel)].color = 0xFF40C060
    const vp = points2(700.0, 80.0, 0.0, 0.0)
    set.*.items[put(set, assistants.VANISHING_POINT, 1, &vp)].color = 0x8000C8C8
    var handles: [8]f64 = undefined
    ellipseHandles(&handles)
    set.*.items[put(set, assistants.ELLIPSE, 3, &handles)].color = 0xFF3C8CFF
    var shifted = handles
    var index: usize = 0
    while index < 6 {
        shifted[index] = if index % 2 == 0 { handles[index] + 300.0 } else { handles[index] + 180.0 }
        index += 1
    }
    set.*.items[put(set, assistants.CONCENTRIC_ELLIPSE, 3, &shifted)].color = 0xFFB060FF
    const quad = points4(450.0, 250.0, 600.0, 270.0, 620.0, 400.0, 430.0, 380.0)
    set.*.items[put(set, assistants.PERSPECTIVE, 4, &quad)].color = 0xFFFFFFFF
    const two = points4(-300.0, 300.0, 1100.0, 300.0, 400.0, 450.0, 0.0, 0.0)
    set.*.items[put(set, assistants.TWO_POINT_PERSPECTIVE, 3, &two)].color = 0x60FFFF00
    const fish = points4(40.0, 300.0, 300.0, 300.0, 170.0, 250.0, 0.0, 0.0)
    set.*.items[put(set, assistants.FISHEYE, 3, &fish)].color = 0xFFFF80C0
    const curve = points4(450.0, 500.0, 780.0, 500.0, 520.0, 420.0, 700.0, 590.0)
    set.*.items[put(set, assistants.SPLINE, 4, &curve)].color = 0xFF80FF80
}

fn picture(set: *Set, canvas: *Canvas, shown: *const viewport.View) -> void {
    var index: usize = 0
    while index < WIDTH * HEIGHT {
        canvas.*.pixels[index] = GROUND
        index += 1
    }
    const marks = overlay.painter(canvas, shown, 0, 0, ui.rect(0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT)), null)
    assist.draw(&marks, shown, set)
}

fn save(canvas: *Canvas, shots: []const u8) -> bool {
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    if !png.saveFile("assistants.png\x00".pointer, canvas.*.pixels, WIDTH, HEIGHT, WIDTH, false, std.heap.allocator()) { return false }
    if shots.length == 0 || shots.length > 400 { return true }
    var length = std.text.append(bytes, 0, 599, shots)
    if bytes[length - 1] != 47 { length = std.text.appendByte(bytes, length, 599, 47) }
    length = std.text.append(bytes, length, 599, "assistants.png")
    bytes[length] = 0
    return png.saveFile(bytes, canvas.*.pixels, WIDTH, HEIGHT, WIDTH, false, std.heap.allocator())
}

fn checkPicture(set: *Set, canvas: *Canvas, shots: []const u8) -> u8 {
    var shown: viewport.View = undefined
    viewport.init(&shown, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))
    shown.area = ui.rect(0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))
    allKinds(set)
    picture(set, canvas, &shown)
    // The ruler's row in its colour, nothing beside its ends.
    if canvas.*.pixels[40 * WIDTH + 140] != 0xFFFF5050 || canvas.*.pixels[40 * WIDTH + 20] != GROUND { return 196 }
    var changed: usize = 0
    var index: usize = 0
    while index < WIDTH * HEIGHT {
        if canvas.*.pixels[index] != GROUND { changed += 1 }
        index += 1
    }
    if changed < 20000 { return 197 }
    // The vanishing point's rays reach the picture's edge.
    if canvas.*.pixels[80 * WIDTH + 795] == GROUND { return 198 }
    if !save(canvas, shots) || !std.fs.exists("assistants.png\x00".pointer) { return 199 }
    return 0
}

// One channel of `color` at alpha `a` over the opaque `ground`, worked
// out by hand: (c a + g (255 - a)) / 255.
fn overChannel(color: u32, ground: u32, shift: u5, a: u32) -> u32 {
    const c = (color >> shift) & 255
    const g = (ground >> shift) & 255
    return (c * a + g * (255 - a) + 127) / 255
}

// Whether every channel of `a` is within `within` of `b`'s.
fn channelsNear(a: u32, b: u32, within: u32) -> bool {
    var shift: u5 = 0
    while true {
        const x = (a >> shift) & 255
        const y = (b >> shift) & 255
        const apart = if x > y { x - y } else { y - x }
        if apart > within { return false }
        if shift == 24 { break }
        shift += 8
    }
    return true
}

// Assistants in colours of alpha 0 leave the picture as it was; one that
// does not snap is drawn at half its alpha; lines whose ends lie close to
// a billion pixels away are drawn where they cross the picture (all of
// row 64 and of column 450, nothing beside them).
fn checkDrawn(set: *Set, canvas: *Canvas) -> u8 {
    var shown: viewport.View = undefined
    viewport.init(&shown, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))
    shown.area = ui.rect(0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))
    assistants.clear(set)
    const unseen = points2(10.0, 100.5, 700.0, 100.5)
    set.*.items[put(set, assistants.INFINITE_RULER, 2, &unseen)].color = 0x00FF0000
    const point = points2(300.0, 300.0, 0.0, 0.0)
    set.*.items[put(set, assistants.VANISHING_POINT, 1, &point)].color = 0x0000FF00
    picture(set, canvas, &shown)
    var index: usize = 0
    while index < WIDTH * HEIGHT {
        if canvas.*.pixels[index] != GROUND { return 152 }
        index += 1
    }
    assistants.clear(set)
    const faint = points2(40.0, 200.5, 240.0, 200.5)
    const ruler = put(set, assistants.RULER, 2, &faint)
    set.*.items[ruler].color = 0xFF20A0E0
    set.*.items[ruler].snap = false
    picture(set, canvas, &shown)
    // Half of 255 is 127.
    const expected = 0xFF000000 | (overChannel(0xFF20A0E0, GROUND, 16, 127) << 16) | (overChannel(0xFF20A0E0, GROUND, 8, 127) << 8) | overChannel(0xFF20A0E0, GROUND, 0, 127)
    if !channelsNear(canvas.*.pixels[200 * WIDTH + 140], expected, 2) || canvas.*.pixels[201 * WIDTH + 140] != GROUND { return 153 }
    assistants.clear(set)
    const row = points2(-900000000.0, 64.5, 900000000.0, 64.5)
    set.*.items[put(set, assistants.RULER, 2, &row)].color = 0xFFFFFFFF
    const column = points2(450.5, 999999999.0, 450.5, -999999999.0)
    set.*.items[put(set, assistants.INFINITE_RULER, 2, &column)].color = 0xFFFFFFFF
    if set.*.count != 2 { return 154 }
    picture(set, canvas, &shown)
    index = 0
    while index < WIDTH {
        if canvas.*.pixels[64 * WIDTH + index] != 0xFFFFFFFF { return 155 }
        index += 1
    }
    index = 0
    while index < HEIGHT {
        if canvas.*.pixels[index * WIDTH + 450] != 0xFFFFFFFF { return 156 }
        index += 1
    }
    if canvas.*.pixels[63 * WIDTH + 10] != GROUND || canvas.*.pixels[65 * WIDTH + 10] != GROUND || canvas.*.pixels[10 * WIDTH + 449] != GROUND || canvas.*.pixels[10 * WIDTH + 451] != GROUND { return 157 }
    assistants.clear(set)
    return 0
}

// ---------------------------------------------------------------------------
// The value arena

fn churn(set: *Set, canvas: *Canvas, shown: *const viewport.View, round: usize) -> void {
    var gx: f64 = 0.0
    var gy: f64 = 0.0
    const x = @floatFromInt(f64, round % 700)
    const y = @floatFromInt(f64, (round * 7) % 500)
    assistants.begin(set, x, y)
    _ = assistants.project(set, x + 30.0, y + 3.0, &gx, &gy)
    var index: usize = 0
    while index < set.*.count {
        _ = assistants.snapOnto(set, index, x + 12.0, y - 20.0, &gx, &gy)
        index += 1
    }
    if round % 20 == 0 { picture(set, canvas, shown) }
}

fn checkArena(set: *Set, canvas: *Canvas) -> u8 {
    var shown: viewport.View = undefined
    viewport.init(&shown, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))
    shown.area = ui.rect(0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))
    allKinds(set)
    set.*.single = false
    churn(set, canvas, &shown, 0)
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: usize = 1
    while round < 2000 {
        churn(set, canvas, &shown, round)
        round += 1
    }
    if turns.used(arena) != before { return 200 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const made = assistants.create(allocator)
    const second = assistants.create(allocator)
    const points = allocator.alloc(POINTS * 16, 16)
    const runs = allocator.alloc(RUNS * 4, 16)
    const pixels = allocator.alloc(WIDTH * HEIGHT * 4, 16)
    if made == null || second == null || points == null || runs == null || pixels == null { return 16 }
    const set = made.?
    if set.*.count != 0 || !set.*.show || !set.*.snap || !set.*.single || set.*.magnetism != 1.0 { return 17 }
    if !stays(set, 5.0, 5.0) { return 18 }
    var failed = checkRulers(set)
    if failed != 0 { return failed }
    failed = checkEllipses(set)
    if failed != 0 { return failed }
    failed = checkPerspectives(set)
    if failed != 0 { return failed }
    failed = checkSpline(set)
    if failed != 0 { return failed }
    failed = checkChoosing(set)
    if failed != 0 { return failed }
    failed = checkMoved(set)
    if failed != 0 { return failed }
    failed = checkHistory(set)
    if failed != 0 { return failed }
    failed = checkText(set, second.?)
    if failed != 0 { return failed }
    failed = checkNumbers(set, second.?)
    if failed != 0 { return failed }
    var point_memory: [*]f64 = undefined
    var run_memory: [*]u32 = undefined
    unsafe {
        point_memory = @ptrCast([*]f64, points.?)
        run_memory = @ptrCast([*]u32, runs.?)
    }
    failed = checkPreview(point_memory, run_memory)
    if failed != 0 { return failed }
    failed = checkValid(set, second.?, point_memory, run_memory)
    if failed != 0 { return failed }
    failed = checkRings(point_memory, run_memory)
    if failed != 0 { return failed }
    var canvas = Canvas.{ .pixels = undefined, .width = WIDTH, .height = HEIGHT, .stride = WIDTH, .swapRedBlue = false, .device = 0, .opacity = 255 }
    unsafe { canvas.pixels = @ptrCast([*]u32, pixels.?) }
    var shots: []const u8 = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { shots = std.string.asSlice(named.?) }
    failed = checkPicture(set, &canvas, shots)
    if failed != 0 { return failed }
    failed = checkDrawn(set, &canvas)
    if failed != 0 { return failed }
    failed = checkArena(set, &canvas)
    if failed != 0 { return failed }
    const app = script.headless(allocator)
    if app == null { return 19 }
    failed = checkTool(app.?, &canvas)
    if failed != 0 { return failed }
    assistants.destroy(set)
    assistants.destroy(second.?)
    return 13
}
