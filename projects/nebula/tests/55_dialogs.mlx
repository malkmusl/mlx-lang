// nebula's dialogs (ui/dialogs.mlx) and forms (ui/forms.mlx), played
// by scripts on an App with no window (app/script.mlx): a message shows
// and Enter, Escape, its OK button and its close cross each close it; a
// confirmation runs the right function for yes, no, Escape, Enter, the
// close cross and Tab then Enter; of two dialogs only the top one takes
// keys and presses, and closing it brings back the one under it; a prompt
// hands over what was typed on Enter and nothing on Escape; the texts
// given are copied; the colour dialog: the red slider dragged changes the
// colour and hue, saturation and value follow it, "#336699" typed into
// the hex field is taken, a live caller gets the first colour back when
// it is cancelled; a form of seven rows of every kind edits its record
// (slider, check box, a choice by keys, a colour from the colour dialog,
// text), tells of each change, Defaults and Cancel put values back, the
// German names show; a form of thirty rows scrolls by keys to its last
// row; New Image: a predefined size, millimetres at 300 ppi (210 mm is
// 2480 pixels), the background chosen, Cancel makes nothing; Layer
// Properties changes name, opacity and blend mode in one step of the
// history that undo takes back, and Cancel leaves no trace; About and the
// progress dialog; every dialog inside windows of 1024 x 768 and 800 x 600
// with its buttons there; the light theme; no growth of the value arena
// over 200 frames with a form open.
//
// And where such code breaks: a prompt answered by a button while its
// field is typed in; Enter and Escape in one turn (Enter came first);
// Tab, Shift+Tab and Right among three buttons; four dialogs open and a
// fifth refused; a grey and black keep their hue in the colour dialog,
// a text that is no colour, a colour with alpha, transparent black;
// forms of odd tables (a choice without choices, a value far out of
// range, a range of one value) and of 33 rows (32 shown); New Image
// turned to landscape, a resolution other than a size's own, inches, a
// side of 0; Layer Properties unchanged, of a group, of a node not in
// front; the progress dialog without one open, begun twice, odd
// fractions, ended under a message; windows from 1 pixel up; the heap
// after fifty rounds of every dialog; 200 frames drawn as the window's
// loop draws them, the value arena given back and overwritten at each
// turn; the colour dialog in a window too low for it. Pictures
// dialog-*.png go to the current directory and, when NEBULA_SHOTS names
// a directory, there too. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const view = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const keys = @import("../app/keys.mlx")
const loop = @import("../app/loop.mlx")
const script = @import("../app/script.mlx")
const documents = @import("../app/documents.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const forms = @import("../ui/forms.mlx")
const types = @import("../filters/types.mlx")
const node_module = @import("../core/node.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const render = @import("../core/render.mlx")
const ops = @import("../core/ops.mlx")

const App = state.App

// What the callbacks saw (they get no context of their own).
var yesCount: u32 = 0
var noCount: u32 = 0
var thirdCount: u32 = 0
var textCount: u32 = 0
var textSeen: [64]u8 = undefined
var textSeenLength: usize = 0
// How long the text handed over was (textSeen keeps its first 64 bytes).
var textHanded: usize = 0
// Two-byte characters for a prompt's initial text.
var wide: [600]u8 = undefined
var colorCount: u32 = 0
var lastColor: u32 = 0
var changeCount: u32 = 0
var acceptCount: u32 = 0
var cancelCount: u32 = 0
var previewFlag: bool = false
// NEBULA_SHOTS, where pictures go besides the current directory.
var shotsAt: [512]u8 = undefined
var shotsLength: usize = 0

fn onYes(app: *App) -> void { yesCount += 1 }
fn onNo(app: *App) -> void { noCount += 1 }
fn onThird(app: *App) -> void { thirdCount += 1 }
fn onChange(app: *App) -> void { changeCount += 1 }
fn onAccept(app: *App) -> void { acceptCount += 1 }
fn onCancel(app: *App) -> void { cancelCount += 1 }

fn onText(app: *App, text: []const u8) -> void {
    textCount += 1
    textHanded = text.length
    const bytes: [*]u8 = &textSeen
    textSeenLength = std.text.append(bytes, 0, 64, text)
}

fn onColor(app: *App, color: u32) -> void {
    colorCount += 1
    lastColor = color
}

fn seen() -> []const u8 {
    const bytes: [*]const u8 = &textSeen
    return bytes[0..textSeenLength]
}

