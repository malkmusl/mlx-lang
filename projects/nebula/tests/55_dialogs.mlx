    types.Param.{ .name = "Option 4", .german = "Option 4", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Option 5", .german = "Option 5", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
