    types.Param.{ .name = "Option 27", .german = "Option 27", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Option 28", .german = "Option 28", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Option 29", .german = "Option 29", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
    types.Param.{ .name = "Option 30", .german = "Option 30", .kind = types.BOOL, .low = 0.0, .high = 1.0, .initial = 0.0, .choices = "", .choicesGerman = "" },
}

// The tables as slices made in a constant initializer: they point at the
// program's data (a slice made at run time would be a copy that the loop
// gives back).
const Tables = struct {
    seven: []const types.Param
    thirty: []const types.Param
}

const TABLES = Tables.{ .seven = SEVEN_ROWS[0..], .thirty = THIRTY_ROWS[0..] }

fn run(app: *App, text: []const u8) -> bool { return script.run(app, text) }

// A picture of the window as it is now, here and in NEBULA_SHOTS.
fn picture(app: *App, name: []const u8) -> bool {
    var line: [700]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 700, "shot ")
    length = std.text.append(bytes, length, 700, name)
    length = std.text.append(bytes, length, 700, "\n")
    if !run(app, bytes[0..length]) { return false }
    if shotsLength == 0 { return true }
    const shots: [*]const u8 = &shotsAt
    length = std.text.append(bytes, 0, 700, "shot ")
    length = std.text.append(bytes, length, 700, shots[0..shotsLength])
    if shotsAt[shotsLength - 1] != 47 { length = std.text.append(bytes, length, 700, "/") }
    length = std.text.append(bytes, length, 700, name)
    length = std.text.append(bytes, length, 700, "\n")
    return run(app, bytes[0..length])
}

fn step2(app: *App, command: []const u8, x: i32, y: i32) -> bool {
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, command)
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, x))
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, y))
    length = std.text.append(bytes, length, 96, "\n")
    return run(app, bytes[0..length])
}

fn drag(app: *App, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, "drag ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, x0))
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, y0))
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, x1))
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, y1))
    length = std.text.append(bytes, length, 96, " 8\n")
    return run(app, bytes[0..length])
}

// Where part `part` of the dialog on top was in the last frame.
fn areaOf(app: *App, part: usize) -> ui.Rect {
    const id = dialogs.partId(app, part)
    if id == view.NONE { return ui.rect(0, 0, 0, 0) }
    return view.areaOf(state.uiOf(app), id)
}

fn clickPart(app: *App, part: usize) -> bool {
    const area = areaOf(app, part)
    if area.width <= 0 || area.height <= 0 { return false }
    return step2(app, "click", area.x + area.width / 2, area.y + area.height / 2)
}

// Drags across part `part` from its left end to beyond its right end
// (`right`) or the other way.
fn dragPart(app: *App, part: usize, right: bool) -> bool {
    const area = areaOf(app, part)
    if area.width <= 0 { return false }
    const middle = area.y + area.height / 2
    if right { return drag(app, area.x + 2, middle, ui.right(area) + 40, middle) }
    return drag(app, ui.right(area) - 2, middle, area.x - 40, middle)
}

fn inside(inner: ui.Rect, outer: ui.Rect) -> bool {
    return inner.width > 0 && inner.height > 0 && inner.x >= outer.x && inner.y >= outer.y && ui.right(inner) <= ui.right(outer) && ui.bottom(inner) <= ui.bottom(outer)
}

fn framePixel(app: *App, x: i32, y: i32) -> u32 {
    const canvas = script.frameOf(app).?
    if x < 0 || y < 0 || @intCast(usize, x) >= canvas.*.width || @intCast(usize, y) >= canvas.*.height { return 0 }
    return canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)]
}

// A number for what `area` of the frame shows.
fn frameHash(app: *App, area: ui.Rect) -> u64 {
    var hash: u64 = 14695981039346656037
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            hash = (hash ^ @intCast(u64, framePixel(app, x, y))) *% 1099511628211
            x += 1
        }
        y += 1
    }
    return hash
}

// The dialog on top lies in a window `width` x `height` and its first
// button is in it.
fn fits(app: *App, width: i32, height: i32) -> bool {
    const window = ui.rect(0, 0, width, height)
    const panel = dialogs.frameArea(app)
    return inside(panel, window) && inside(areaOf(app, dialogs.PART_BUTTON), panel)
}

fn sized(app: *App, width: i32, height: i32) -> bool {
    var line: [64]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 64, "size ")
    length = std.text.appendSigned(bytes, length, 64, @intCast(isize, width))
    length = std.text.append(bytes, length, 64, " ")
    length = std.text.appendSigned(bytes, length, 64, @intCast(isize, height))
    length = std.text.append(bytes, length, 64, "\nwait 0\n")
    return run(app, bytes[0..length])
}

// What `frames` frames drawn on `canvas` take from the value arena.
fn arenaFor(app: *App, canvas: *state.Canvas, frames: usize) -> usize {
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: usize = 0
    while round < frames {
        app.*.shell.*.wantFrame = true
        loop.frame(app, canvas)
        round += 1
    }
    return turns.used(arena) - before
}

fn channel(color: u32, shift: u5) -> u32 { return (color >> shift) & 255 }

fn sevenValues(values: *node_module.Params) -> void {
    node_module.clearParams(values)
    var index: usize = 0
    while index < 7 {
        values.*.values[index] = SEVEN_ROWS[index].initial
        index += 1
    }
}

// Every dialog opened in a window of `width` x `height`: inside it, its
// first button there; then closed. 0 when all fit, else the check's
// number.
fn allFit(app: *App, width: i32, height: i32, values: *node_module.Params, base: u8) -> u8 {
    if !sized(app, width, height) { return base }
    if !dialogs.message(app, "Size", "A message in a window of this size.", dialogs.WARNING) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 1 }
    if !dialogs.confirm(app, "Size", "A question?", "Yes", "No", onYes, onNo) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 2 }
    if !dialogs.prompt(app, "Size", "Name", "", onText) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 3 }
    if !dialogs.pickColor(app, "Size", 0xFF808080, onColor, false) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 4 }
    var options = forms.FormOptions.{ .onChange = null, .onAccept = onAccept, .onCancel = null, .preview = null, .reset = true }
    if !forms.open(app, "Size", TABLES.thirty, values, &options) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 5 }
    if !dialogs.newImage(app) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 6 }
    if !dialogs.layerProperties(app, api.activeNode(app).?) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 7 }
    if !dialogs.about(app) || !run(app, "wait 0\n") || !fits(app, width, height) || !run(app, "key Escape\n") { return base + 8 }
    if !dialogs.progressBegin(app, "Size") || !run(app, "wait 0\n") || !fits(app, width, height) { return base + 9 }
    dialogs.progressEnd(app)
    if app.*.dialogCount != 0 { return base + 10 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const shots = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if shots != null {
        const bytes: [*]u8 = &shotsAt
        shotsLength = std.text.append(bytes, 0, 512, std.string.asSlice(shots.?))
    }
    const allocator = std.heap.allocator()
    const made = script.headless(allocator)
    if made == null { return 1 }
    const app = made.?
    const memory = allocator.alloc(@sizeOf(node_module.Params), 16)
    if memory == null { return 2 }
    const values: *node_module.Params = unsafe { @ptrCast(*node_module.Params, memory.?) }
    if !run(app, "size 800 600\nnew 320 240 FFFFFF\n") { return 3 }
    const fonts = state.bodyOf(app).*.loaded
    const theme = state.themeOf(app)

    // A message: where it is, what it shows; Enter, Escape, OK and the
    // cross close it.
    const behind = framePixel(app, 400, 20)
    if !dialogs.message(app, "Saved", "The picture was written to the disk. It has three layers and a selection.", dialogs.INFO) { return 4 }
    if !run(app, "wait 0\n") || app.*.dialogCount != 1 { return 5 }
    const panel = dialogs.frameArea(app)
    if !inside(panel, ui.rect(0, 0, 800, 600)) || panel.width != 440 { return 6 }
    const ok = areaOf(app, dialogs.PART_BUTTON)
    if !inside(ok, panel) || !inside(areaOf(app, dialogs.PART_CLOSE), panel) { return 7 }
    if framePixel(app, panel.x + 3, ui.bottom(panel) - 4) != theme.*.panel { return 8 }
    if framePixel(app, ok.x + 3, ok.y + ok.height / 2) != theme.*.primary { return 9 }
    const veiled = framePixel(app, 400, 20)
    if veiled >> 24 != 255 || channel(veiled, 16) >= channel(behind, 16) || channel(veiled, 0) >= channel(behind, 0) { return 10 }
    if !picture(app, "dialog-message.png") { return 11 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 { return 12 }
    if framePixel(app, 400, 20) != behind { return 14 }
    _ = dialogs.message(app, "Saved", "Again.", dialogs.WARNING)
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 15 }
    _ = dialogs.message(app, "Saved", "Again.", dialogs.ERROR)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_BUTTON) || app.*.dialogCount != 0 { return 16 }
    _ = dialogs.message(app, "Saved", "Again.", dialogs.INFO)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_CLOSE) || app.*.dialogCount != 0 { return 17 }
    // A press beside the panel does nothing.
    _ = dialogs.message(app, "Saved", "Again.", dialogs.INFO)
    if !run(app, "wait 0\nclick 20 300\n") || app.*.dialogCount != 1 || !run(app, "key Enter\n") { return 18 }

    // A confirmation: yes, no, Escape, Enter, the cross, Tab and Enter.
    _ = dialogs.confirm(app, "Delete", "Delete the layer?", "Delete", "Keep", onYes, onNo)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_BUTTON) || yesCount != 1 || noCount != 0 || app.*.dialogCount != 0 { return 19 }
    _ = dialogs.confirm(app, "Delete", "Delete the layer?", "Delete", "Keep", onYes, onNo)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_BUTTON + 1) || yesCount != 1 || noCount != 1 || app.*.dialogCount != 0 { return 20 }
    _ = dialogs.confirm(app, "Delete", "Delete the layer?", "Delete", "Keep", onYes, onNo)
    if !run(app, "key Escape\n") || noCount != 2 || app.*.dialogCount != 0 { return 21 }
    _ = dialogs.confirm(app, "Delete", "Delete the layer?", "Delete", "Keep", onYes, onNo)
    if !run(app, "key Enter\n") || yesCount != 2 || app.*.dialogCount != 0 { return 22 }
    _ = dialogs.confirm(app, "Delete", "Delete the layer?", "Delete", "Keep", onYes, null)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_CLOSE) || yesCount != 2 || noCount != 2 || app.*.dialogCount != 0 { return 23 }
    _ = dialogs.confirm(app, "Delete", "Delete the layer?", "Delete", "Keep", onYes, onNo)
    if !run(app, "key Tab\nkey Enter\n") || yesCount != 2 || noCount != 3 { return 24 }
    // Three choices: the third is Escape's.
    _ = dialogs.choose3(app, "Close", "Save the changes to Untitled-1?", "Save", "Discard", "Cancel", onYes, onNo, onThird)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_BUTTON + 1) || noCount != 4 { return 25 }
    _ = dialogs.choose3(app, "Close", "Save the changes to Untitled-1?", "Save", "Discard", "Cancel", onYes, onNo, onThird)
    if !run(app, "key Escape\n") || thirdCount != 1 || yesCount != 2 { return 26 }

    // Two at once: only the top one takes keys and presses; closing it
    // brings the lower one back.
    _ = dialogs.confirm(app, "Delete", "Delete the layer?", "Delete", "Keep", onYes, onNo)
    if !run(app, "wait 0\n") { return 27 }
    const keep = areaOf(app, dialogs.PART_BUTTON + 1)
    const lower_close = areaOf(app, dialogs.PART_CLOSE)
    // (Taller than the question: where its cross and its Keep button
    // are, this one has neither cross nor button.)
    _ = dialogs.message(app, "Note", "On top of the question: this note has so many words that it wraps to six or seven lines, and so its panel is taller than the one of the question under it. Where that one has its close cross and its Keep button, this one has only its text, which takes no press at all.", dialogs.INFO)
    if !run(app, "wait 0\n") || app.*.dialogCount != 2 { return 28 }
    if !step2(app, "click", lower_close.x + lower_close.width / 2, lower_close.y + lower_close.height / 2) { return 29 }
    if !step2(app, "click", keep.x + 2, keep.y + 2) || noCount != 4 || app.*.dialogCount < 1 { return 30 }
    if app.*.dialogCount == 2 && !run(app, "key Enter\n") { return 31 }
    if app.*.dialogCount != 1 || yesCount != 2 || noCount != 4 { return 32 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 || yesCount != 3 { return 33 }

    // What a message or a question shows is a copy of what it was given.
    var said: [32]u8 = undefined
    const said_bytes: [*]u8 = &said
    const said_length = std.text.append(said_bytes, 0, 32, "Original words")
    _ = dialogs.message(app, "Copy", said_bytes[0..said_length], dialogs.INFO)
    if !run(app, "wait 0\n") { return 34 }
    const said_area = dialogs.frameArea(app)
    const first_look = frameHash(app, said_area)
    var index: usize = 0
    while index < said_length {
        said[index] = 88
        index += 1
    }
    if !picture(app, "dialog-copy.png") || frameHash(app, said_area) != first_look { return 35 }
    if !run(app, "key Enter\n") { return 36 }
    _ = dialogs.message(app, "Copy", said_bytes[0..said_length], dialogs.INFO)
    if !run(app, "wait 0\n") { return 37 }
    if fonts && frameHash(app, said_area) == first_look { return 38 }
    if !run(app, "key Enter\n") { return 39 }
    index = 0
    while index < said_length {
        said[index] = 89
        index += 1
    }
    _ = dialogs.confirm(app, "Copy", "Which?", said_bytes[0..4], "No", onYes, onNo)
    index = 0
    while index < said_length {
        said[index] = 0
        index += 1
    }
    if !run(app, "key Enter\n") || yesCount != 4 { return 40 }

    // A prompt: Enter hands over what was typed, Escape nothing.
    if !dialogs.prompt(app, "Rename", "Name", "Layer 1", onText) { return 41 }
    if !run(app, "type Sky\nkey Enter\n") || app.*.dialogCount != 0 || textCount != 1 || !std.text.same(seen(), "Sky") { return 42 }
    _ = dialogs.prompt(app, "Rename", "Name", "Layer 1", onText)
    if !run(app, "type abc\nkey Escape\n") || app.*.dialogCount != 0 || textCount != 1 { return 43 }
    _ = dialogs.prompt(app, "Rename", "Name", "Layer 1", onText)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_BUTTON) || textCount != 2 || !std.text.same(seen(), "Layer 1") { return 44 }

    // The colour dialog, live: the red slider, then value: hue and
    // saturation followed the red; the hex field; cancel gives the first
    // colour back.
    if !dialogs.pickColor(app, "Foreground", 0xFF0000FF, onColor, true) || !run(app, "wait 0\n") { return 45 }
    if !dragPart(app, dialogs.PART_FIELD, true) || lastColor != 0xFFFF00FF { return 46 }
    const value_area = areaOf(app, dialogs.PART_FIELD + 6)
    if value_area.width <= 0 { return 47 }
    if !drag(app, ui.right(value_area) - 2, value_area.y + 5, value_area.x + value_area.width / 2, value_area.y + 5) { return 48 }
    const halfway = lastColor
    if channel(halfway, 8) != 0 || channel(halfway, 16) != channel(halfway, 0) || channel(halfway, 16) < 100 || channel(halfway, 16) > 160 { return 49 }
    if !clickPart(app, dialogs.PART_FIELD + 7) || !run(app, "type #336699\nkey Enter\n") || lastColor != 0xFF336699 || app.*.dialogCount != 1 { return 50 }
    if !picture(app, "dialog-color.png") { return 51 }
    const before_cancel = colorCount
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 || lastColor != 0xFF0000FF || colorCount != before_cancel + 1 { return 52 }
    // Not live: one call, on OK, with the colour chosen; the old swatch
    // takes the first colour back.
    _ = dialogs.pickColor(app, "Background", 0xFF102030, onColor, false)
    const calls = colorCount
    if !run(app, "wait 0\n") || !dragPart(app, dialogs.PART_FIELD + 1, true) || colorCount != calls { return 53 }
    if !clickPart(app, dialogs.PART_FIELD + 8) || !dragPart(app, dialogs.PART_FIELD + 3, false) { return 54 }
    if !clickPart(app, dialogs.PART_BUTTON) || colorCount != calls + 1 || lastColor != 0x00102030 { return 55 }

    // A form of seven rows of every kind.
    sevenValues(values)
    var options = forms.FormOptions.{ .onChange = onChange, .onAccept = onAccept, .onCancel = onCancel, .preview = &previewFlag, .reset = true }
    if !forms.open(app, "Filter", TABLES.seven, values, &options) || !run(app, "wait 0\n") { return 56 }
    if !inside(dialogs.frameArea(app), ui.rect(0, 0, 800, 600)) { return 57 }
    var changes = changeCount
    if !dragPart(app, dialogs.PART_FIELD, true) || values.*.values[0] != 100.0 || changeCount <= changes { return 58 }
    changes = changeCount
    if !clickPart(app, dialogs.PART_FIELD + 2) || values.*.values[2] != 1.0 || changeCount != changes + 1 { return 59 }
    changes = changeCount
    if !clickPart(app, dialogs.PART_FIELD + 3) || !run(app, "key Down\nkey Enter\nwait 0\n") || values.*.values[3] != 2.0 || changeCount != changes + 1 { return 60 }
    if !clickPart(app, dialogs.PART_FIELD + 6) || !run(app, "type hello\nkey Enter\nwait 0\n") || !std.text.same(node_module.paramsText(values), "hello") { return 61 }
    if !clickPart(app, dialogs.PART_FIELD + 4) || app.*.dialogCount != 2 { return 62 }
    if !clickPart(app, dialogs.PART_FIELD + 7) || !run(app, "type #00FF00\nkey Enter\n") || values.*.values[4] != 4278255360.0 { return 63 }
    if !clickPart(app, dialogs.PART_BUTTON) || app.*.dialogCount != 1 || values.*.values[4] != 4278255360.0 { return 64 }
    if !clickPart(app, dialogs.PART_FIELD + 32) || !previewFlag { return 65 }
    if !picture(app, "dialog-form.png") { return 66 }
    // Defaults: every number as it began; the text stays.
    changes = changeCount
    if !clickPart(app, dialogs.PART_BUTTON) || values.*.values[0] != 10.0 || values.*.values[2] != 0.0 || values.*.values[3] != 1.0 || values.*.values[4] != 4294901760.0 || changeCount != changes + 1 { return 67 }
    if !std.text.same(node_module.paramsText(values), "hello") { return 68 }
    // Cancel: what was there when it opened.
    if !dragPart(app, dialogs.PART_FIELD + 1, true) || values.*.values[1] != 1.0 { return 69 }
    if !clickPart(app, dialogs.PART_BUTTON + 2) || app.*.dialogCount != 0 || cancelCount != 1 || acceptCount != 0 { return 70 }
    if values.*.values[1] != 0.5 || values.*.textLength != 0 || previewFlag { return 71 }
    // OK keeps what was set.
    _ = forms.open(app, "Filter", TABLES.seven, values, &options)
    if !run(app, "wait 0\n") || !dragPart(app, dialogs.PART_FIELD + 5, false) || values.*.values[5] != -180.0 { return 72 }
    if !clickPart(app, dialogs.PART_BUTTON + 1) || acceptCount != 1 || values.*.values[5] != -180.0 || app.*.dialogCount != 0 { return 73 }
    // The German names.
    sevenValues(values)
    _ = forms.open(app, "Filter", TABLES.seven, values, &options)
    if !run(app, "wait 0\n") { return 74 }
    const strength = areaOf(app, dialogs.PART_FIELD + 1)
    const label_area = ui.rect(dialogs.frameArea(app).x + 14, strength.y, strength.x - dialogs.frameArea(app).x - 14, strength.height)
    const english = frameHash(app, label_area)
    if !run(app, "german\nwait 0\n") { return 75 }
    if fonts && frameHash(app, label_area) == english { return 76 }
    if !picture(app, "dialog-form-german.png") { return 77 }
    app.*.german = false
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 78 }

    // Thirty rows: the last is reached by keys and takes a click.
    node_module.clearParams(values)
    var plain = forms.FormOptions.{ .onChange = null, .onAccept = onAccept, .onCancel = null, .preview = null, .reset = false }
    _ = forms.open(app, "Options", TABLES.thirty, values, &plain)
    if !run(app, "wait 0\n") { return 79 }
    const form_panel = dialogs.frameArea(app)
    if inside(areaOf(app, dialogs.PART_FIELD + 29), form_panel) { return 80 }
    if !run(app, "key End\nwait 0\n") || !inside(areaOf(app, dialogs.PART_FIELD + 29), form_panel) { return 81 }
    if !clickPart(app, dialogs.PART_FIELD + 29) || values.*.values[29] != 1.0 { return 82 }
    if !run(app, "key Home\nwait 0\n") || !inside(areaOf(app, dialogs.PART_FIELD), form_panel) { return 83 }
    if !picture(app, "dialog-form-long.png") { return 84 }

    // 200 frames with the form open take nothing from the value arena that
    // a frame does not give back: the second hundred drawn frames take
    // what the first did. (A drawn frame takes a fixed amount, given back
    // when the window's loop turns: std.ui.text takes 4 KB for each text
    // it draws, the kit and std.ui.view some bytes for each widget.) On
    // frames that only lay out, the form takes no more than its widgets'
    // own 32 bytes each.
    const canvas = script.frameOf(app).?
    const first_hundred = arenaFor(app, canvas, 100)
    const second_hundred = arenaFor(app, canvas, 100)
    if second_hundred != first_hundred { return 85 }
    var nowhere = view.layoutCanvas()
    const laid_open = arenaFor(app, &nowhere, 200)
    if !run(app, "key Escape\n") || app.*.dialogCount != 0 { return 86 }
    const laid_closed = arenaFor(app, &nowhere, 200)
    if laid_open > laid_closed + 200 * 32 * 36 { return 128 }

    // New Image: a size of the list, millimetres at 300 ppi, the
    // background; Cancel makes nothing.
    const documents_before = app.*.count
    if !dialogs.newImage(app) || !run(app, "wait 0\n") || !picture(app, "dialog-new-image.png") { return 87 }
    if !run(app, "key Escape\n") || app.*.count != documents_before || app.*.dialogCount != 0 { return 88 }
    _ = dialogs.newImage(app)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_FIELD + 1) || !run(app, "type 12\nkey Enter\nwait 0\n") { return 89 }
    if !clickPart(app, dialogs.PART_BUTTON) || app.*.count != documents_before + 1 { return 90 }
    const hd = api.image(app).?
    if hd.*.width != 1280 || hd.*.height != 720 || framePixel(app, 0, 0) == 0 { return 91 }
    _ = render.update(hd)
    if device.pixel(hd.*.projection, 640, 360) != 0xFFFFFFFF { return 92 }
    _ = dialogs.newImage(app)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_FIELD + 4) || !run(app, "key Down\nkey Enter\nwait 0\n") { return 93 }
    if !clickPart(app, dialogs.PART_FIELD + 2) || !run(app, "type 210\nkey Enter\nwait 0\n") { return 94 }
    if !clickPart(app, dialogs.PART_FIELD + 3) || !run(app, "type 10\nkey Enter\nwait 0\n") { return 95 }
    if !clickPart(app, dialogs.PART_FIELD + 8) || !run(app, "key Down\nkey Enter\nwait 0\n") { return 96 }
    if !clickPart(app, dialogs.PART_FIELD) || !run(app, "type Strip\nkey Enter\nwait 0\n") { return 97 }
    if !picture(app, "dialog-new-image-mm.png") { return 98 }
    if !run(app, "key Enter\n") || app.*.count != documents_before + 2 { return 99 }
    const strip = api.image(app).?
    if strip.*.width != 2480 || strip.*.height != 118 || strip.*.resolution != 300.0 { return 100 }
    _ = render.update(strip)
    if device.pixel(strip.*.projection, 5, 5) != 0xFF000000 || device.pixel(strip.*.projection, 2479, 117) != 0xFF000000 { return 101 }
    const strip_doc = api.document(app).?
    if !std.text.same(strip_doc.*.name[0..strip_doc.*.nameLength], "Strip") { return 102 }

    // Layer Properties: three changes, one step; undo takes all back;
    // Cancel leaves no trace.
    const node = api.activeNode(app).?
    const steps = history.stepsDone(strip.*.history)
    if !dialogs.layerProperties(app, node) || !run(app, "wait 0\n") { return 103 }
    if !clickPart(app, dialogs.PART_FIELD) || !run(app, "type Sky\nkey Enter\nwait 0\n") { return 104 }
    if !dragPart(app, dialogs.PART_FIELD + 1, false) { return 105 }
    if !clickPart(app, dialogs.PART_FIELD + 2) || !run(app, "key Down\nkey Enter\nwait 0\n") { return 106 }
    if !clickPart(app, dialogs.PART_FIELD + 11) { return 107 }
    if !picture(app, "dialog-layer.png") { return 108 }
    if node.*.opacity != 255 || node.*.blend != 0 || history.stepsDone(strip.*.history) != steps { return 109 }
    if !clickPart(app, dialogs.PART_BUTTON) || app.*.dialogCount != 0 { return 110 }
    if !std.text.same(node_module.nameOf(node), "Sky") || node.*.opacity != 0 || node.*.blend == 0 || node.*.label != 3 { return 111 }
    if history.stepsDone(strip.*.history) != steps + 1 { return 112 }
    if !run(app, "key Ctrl+Z\n") || node.*.opacity != 255 || node.*.blend != 0 || node.*.label != 0 || std.text.same(node_module.nameOf(node), "Sky") { return 113 }
    if history.stepsDone(strip.*.history) != steps { return 114 }
    _ = dialogs.layerProperties(app, node)
    if !run(app, "wait 0\n") || !clickPart(app, dialogs.PART_FIELD) || !run(app, "type Gone\nkey Enter\nkey Escape\n") { return 115 }
    if app.*.dialogCount != 0 || std.text.same(node_module.nameOf(node), "Gone") || history.stepsDone(strip.*.history) != steps || history.canRedo(strip.*.history) == false { return 116 }

    // About and the progress dialog.
    if !dialogs.about(app) || !run(app, "wait 0\n") || !picture(app, "dialog-about.png") || !run(app, "key Enter\n") || app.*.dialogCount != 0 { return 117 }
    if !dialogs.progressBegin(app, "Exporting") { return 118 }
    dialogs.progressUpdate(app, 0.4, "Layer 3 of 7")
    if !run(app, "wait 0\n") || !picture(app, "dialog-progress.png") || dialogs.progressCancelled(app) { return 119 }
    if !run(app, "key Escape\n") || !dialogs.progressCancelled(app) || app.*.dialogCount != 1 { return 120 }
    dialogs.progressEnd(app)
    if app.*.dialogCount != 0 || dialogs.progressCancelled(app) { return 121 }

    // The light theme: the panel is the light one's, opaque.
    app.*.shell.*.lightness = 1024
    _ = dialogs.message(app, "Saved", "The picture was written to the disk. It has three layers and a selection.", dialogs.INFO)
    if !run(app, "wait 0\n") || !picture(app, "dialog-message-light.png") { return 122 }
    const light_panel = dialogs.frameArea(app)
    if framePixel(app, light_panel.x + 3, ui.bottom(light_panel) - 4) != state.themeOf(app).*.panel || state.themeOf(app).*.panel >> 24 != 255 { return 123 }
    if !run(app, "key Enter\n") { return 124 }
    _ = dialogs.newImage(app)
    if !run(app, "wait 0\n") || !picture(app, "dialog-new-image-light.png") || !run(app, "key Escape\n") { return 125 }
    app.*.shell.*.lightness = 0

    // Every dialog fits a window of 1024 x 768 and one of 800 x 600.
    const large = allFit(app, 1024, 768, values, 130)
    if large != 0 { return large }
    const small = allFit(app, 800, 600, values, 150)
    if small != 0 { return small }
    return 13
}
