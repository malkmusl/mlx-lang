// nebula's menus (ui/menus.mlx) in the whole program without a window
// (app/script.mlx), at 1024 x 768: with rows of the test's own
// (menus.useTestItems) the bar shows ten titles in English and in German
// (a menu without entries dim, but there); a click on Edit opens its list
// under its title, the pointer on File then opens File; entries,
// separators, disabled and checked ones are where the items say, the row
// under the pointer is lit (the frame's pixels), the lists and the bar are
// opaque; a click on an entry runs it and closes, one on a disabled entry
// does nothing; a press outside closes without running and reaches no
// canvas (a brush click there leaves the image as it was; the next one
// paints), so does the right button; a click on the open title closes;
// the keys: F10, Right, Down, Down, Enter runs the second entry that can
// be chosen of the second menu, Escape closes a level at a time, a letter
// jumps, Alt tapped alone opens the first menu; a submenu opens beside its
// row (on the left at the window's right edge) and its entry runs; a list
// taller than the window scrolls by the wheel and by its arrows and its
// last entry is reached by End and run; openAt keeps a context menu inside
// the window at its bottom right corner; popup() and chosen() in a round
// trip; with the test items gone the bar is still drawn and every action
// of actions/registry.mlx that has a menu is in the model exactly once;
// the light theme; a window of 1280 x 800; no growth of the value arena
// over 300 frames with a menu and a submenu open; a context menu asked
// for outside the window is moved in; a dialog coming or going closes
// what was open. Pictures (menus-open.png, menus-submenu.png,
// menus-german.png, menus-scroll.png, menus-light.png, menus-popup.png)
// are written to the current directory and, when NEBULA_SHOTS names one,
// there. Then the edges: the frame's pixels of a list (the separator's
// line, the check marks, the shortcuts' right edge, a disabled entry's
// colour, the titles lit or not), places at the ends of i32, a popup of
// more entries and longer texts than it keeps, a popup without entries
// while one is open, a right press whose release drew no frame, the
// language changing while a list is open, a press on a title that opens
// nothing, lists exactly as tall as their room and a row taller, more
// rows than a list keeps, the wheel far past the ends, a list where
// nothing can be chosen, a window of 64 x 64, the pointer at the ends of
// i32; a thousand rounds of opening and closing with the value arena and
// the heap watched. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const ui = @import("std.ui")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const keys = @import("../app/keys.mlx")
const menus = @import("../ui/menus.mlx")
const actions = @import("../actions/registry.mlx")
const render = @import("../core/render.mlx")
const device = @import("../core/device.mlx")

const App = state.App
const TestItem = menus.TestItem

const WIDTH: i32 = 1024
const HEIGHT: i32 = 768
const FILTERS: usize = 60
const ITEMS: usize = 120
const EXTRA: usize = 200
const LARGEST: i32 = 2147483647
const SMALLEST: i32 = -2147483647 - 1

// The test's rows, in heap memory with the names of the long list.
const Items = struct {
    items: [120]TestItem
    count: usize
    names: [60][12]u8
}

// Rows and popup entries of the checks that try the edges, in heap
// memory.
const Extra = struct {
    items: [200]TestItem
    count: usize
    names: [200][16]u8
    entries: [40]menus.Entry
    longName: [64]u8
}

fn extraAdd(extra: *Extra, menu: u8, submenu: []const u8, name: []const u8, flags: u8, enabled: bool, number: usize) -> void {
    if extra.*.count >= EXTRA { return }
    extra.*.items[extra.*.count] = TestItem.{ .menu = menu, .submenu = submenu, .name = name, .shortcut = "", .flags = flags, .enabled = enabled, .checked = false, .number = number }
    extra.*.count += 1
}

// `count` rows "PREFIX 1", "PREFIX 2", ... in `menu`, numbered from
// `number` on.
fn extraRows(extra: *Extra, menu: u8, prefix: []const u8, count: usize, number: usize) -> void {
    var index: usize = 0
    while index < count && extra.*.count < EXTRA {
        const bytes: [*]u8 = &extra.*.names[extra.*.count]
        var length = std.text.append(bytes, 0, 16, prefix)
        length = std.text.appendUnsigned(bytes, length, 16, index + 1)
        extraAdd(extra, menu, "", bytes[0..length], 0, true, number + index)
        index += 1
    }
}

fn add(list: *Items, menu: u8, submenu: []const u8, name: []const u8, shortcut: []const u8, flags: u8, enabled: bool, checked: bool, number: usize) -> void {
    if list.*.count >= ITEMS { return }
    list.*.items[list.*.count] = TestItem.{ .menu = menu, .submenu = submenu, .name = name, .shortcut = shortcut, .flags = flags, .enabled = enabled, .checked = checked, .number = number }
    list.*.count += 1
}

fn makeItems(list: *Items) -> void {
    const sep = state.ACTION_SEPARATOR_BEFORE
    const check = state.ACTION_CHECKABLE
    list.*.count = 0
    add(list, state.MENU_FILE, "", "New", "Ctrl+N", 0, true, false, 101)
    add(list, state.MENU_FILE, "", "Open...", "Ctrl+O", 0, true, false, 102)
    add(list, state.MENU_FILE, "Open Recent|Zuletzt ge\xC3\xB6ffnet", "one.png", "", 0, true, false, 103)
    add(list, state.MENU_FILE, "Open Recent|Zuletzt ge\xC3\xB6ffnet", "two.png", "", 0, true, false, 104)
    add(list, state.MENU_FILE, "", "Save", "Ctrl+S", sep, true, false, 105)
    add(list, state.MENU_FILE, "", "Save As...", "Ctrl+Shift+S", 0, false, false, 106)
    add(list, state.MENU_FILE, "", "Quit", "Ctrl+Q", sep, true, false, 107)
    add(list, state.MENU_EDIT, "", "Undo", "Ctrl+Z", 0, false, false, 201)
    add(list, state.MENU_EDIT, "", "Redo", "Ctrl+Shift+Z", 0, true, false, 202)
    add(list, state.MENU_EDIT, "", "Cut", "Ctrl+X", sep, true, false, 203)
    add(list, state.MENU_EDIT, "", "Copy", "Ctrl+C", 0, true, false, 204)
    add(list, state.MENU_EDIT, "", "Paste", "Ctrl+V", 0, true, false, 205)
    add(list, state.MENU_EDIT, "", "Snap to Grid", "", sep | check, true, true, 206)
    add(list, state.MENU_EDIT, "", "Show Rulers", "", check, true, false, 207)
    add(list, state.MENU_VIEW, "", "Zoom In", "Ctrl++", 0, true, false, 301)
    add(list, state.MENU_VIEW, "", "Zoom Out", "Ctrl+-", 0, true, false, 302)
    add(list, state.MENU_VIEW, "", "Show Grid", "", sep | check, true, true, 303)
    add(list, state.MENU_IMAGE, "", "Canvas Size...", "", 0, true, false, 401)
    add(list, state.MENU_IMAGE, "Rotate|Drehen", "90\xC2\xB0 Clockwise", "", 0, true, false, 402)
    add(list, state.MENU_IMAGE, "Rotate|Drehen", "180\xC2\xB0", "", 0, true, false, 403)
    add(list, state.MENU_LAYER, "", "New Layer", "Ins", 0, true, false, 501)
    add(list, state.MENU_LAYER, "", "Delete Layer", "Del", 0, false, false, 502)
    add(list, state.MENU_SELECT, "", "All", "Ctrl+A", 0, true, false, 601)
    add(list, state.MENU_SELECT, "", "None", "Ctrl+Shift+A", 0, true, false, 602)
    add(list, state.MENU_SETTINGS, "", "Preferences...", "", 0, true, false, 901)
    add(list, state.MENU_HELP, "", "About Nebula", "", 0, true, false, 1001)
    // A list taller than the window.
    var index: usize = 0
    while index < FILTERS {
        const bytes: [*]u8 = &list.*.names[index]
        var length = std.text.append(bytes, 0, 12, "Filter ")
        length = std.text.appendUnsigned(bytes, length, 12, index + 1)
        add(list, state.MENU_FILTER, "", bytes[0..length], "", 0, true, false, 701 + index)
        index += 1
    }
}

// Plays "COMMAND X Y".
fn at(app: *App, command: []const u8, x: i32, y: i32) -> bool {
    var text: [96]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 96, command)
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, x))
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, y))
    length = std.text.append(bytes, length, 96, "\n")
    return script.run(app, bytes[0..length])
}

fn clickIn(app: *App, area: ui.Rect) -> bool { return at(app, "click", area.x + area.width / 2, area.y + area.height / 2) }
fn pointIn(app: *App, area: ui.Rect) -> bool { return at(app, "pointer", area.x + area.width / 2, area.y + area.height / 2) }

// A frame drawn now.
fn draw(app: *App) -> bool {
    app.*.shell.*.wantFrame = true
    return script.run(app, "wait 0\n")
}

fn windowPixel(app: *App, x: i32, y: i32) -> u32 {
    const frame = script.frameOf(app).?
    if x < 0 || y < 0 || @intCast(usize, x) >= frame.*.width || @intCast(usize, y) >= frame.*.height { return 0 }
    return frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)]
}

// Every pixel of `area` (inside the window) opaque.
fn opaque(app: *App, area: ui.Rect) -> bool {
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            if windowPixel(app, x, y) >> 24 != 255 { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// Whether something (a title's letters) is drawn in `area` in another
// colour than `ground`.
fn marked(app: *App, area: ui.Rect, ground: u32) -> bool {
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            if windowPixel(app, x, y) != ground { return true }
            x += 1
        }
        y += 1
    }
    return false
}

fn shown(app: *App, x: i32, y: i32) -> u32 {
    const image = api.image(app).?
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

fn inside(inner: ui.Rect, outer: ui.Rect) -> bool {
    return inner.x >= outer.x && inner.y >= outer.y && ui.right(inner) <= ui.right(outer) && ui.bottom(inner) <= ui.bottom(outer) && inner.width > 0 && inner.height > 0
}

fn shot(app: *App, shots: []const u8, name: []const u8) -> bool {
    var text: [600]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 600, "shot ")
    length = std.text.append(bytes, length, 600, name)
    length = std.text.append(bytes, length, 600, "\n")
    if !script.run(app, bytes[0..length]) { return false }
    if shots.length == 0 || shots.length > 400 { return true }
    length = std.text.append(bytes, 0, 600, "shot ")
    length = std.text.append(bytes, length, 600, shots)
    if shots[shots.length - 1] != '/' { length = std.text.appendByte(bytes, length, 600, '/') }
    length = std.text.append(bytes, length, 600, name)
    length = std.text.append(bytes, length, 600, "\n")
    return script.run(app, bytes[0..length])
}

fn ran(app: *App, number: usize) -> bool {
    const last = menus.lastTestItem(app)
    return last != null && last.? == number
}

fn nothingRan(app: *App) -> bool { return menus.lastTestItem(app) == null }

fn activeIs(app: *App, at: usize, row: usize) -> bool {
    const active = menus.activeRow(app, at)
    return active != null && active.? == row
}

// The bar, the titles and opening by the pointer.
fn checkBar(app: *App, shots: []const u8) -> u8 {
    const theme = state.themeOf(app)
    const panel = theme.*.panel | 0xFF000000
    var menu: u8 = 1
    var right: i32 = 0
    while @intCast(usize, menu) < state.MENUS {
        const area = menus.titleArea(app, menu)
        // Ten titles side by side in one row along the top.
        if area.width <= 0 || area.y != 0 || area.height != menus.barHeight(app) || area.x < right { return 1 }
        right = ui.right(area)
        if menus.title(app, menu).length == 0 { return 2 }
        if app.*.body.loaded && !marked(app, ui.rect(area.x + 6, area.y + 4, area.width - 12, area.height - 8), panel) { return 3 }
        menu += 1
    }
    if right > WIDTH { return 4 }
    if !std.text.same(menus.title(app, state.MENU_EDIT), "Edit") || !std.text.same(menus.title(app, state.MENU_SETTINGS), "Settings") { return 5 }
    if menus.hasEntries(app, state.MENU_TOOLS) || !menus.hasEntries(app, state.MENU_FILE) { return 6 }
    // The bar is the desktop's glass: drawn (not clear), translucent.
    const bar_frame = script.frameOf(app).?
    if (bar_frame.*.pixels[@intCast(usize, WIDTH - 4)] >> 24) == 0 { return 7 }

    // A click on Edit opens its list under its title; the pointer on File
    // opens File.
    const edit = menus.titleArea(app, state.MENU_EDIT)
    if !clickIn(app, edit) { return 8 }
    if !menus.isOpen(app) || menus.openMenu(app) != state.MENU_EDIT || menus.depth(app) != 1 { return 9 }
    const box = menus.listArea(app, 0)
    if box.y != ui.bottom(edit) || box.x != edit.x || box.width < 180 { return 10 }
    if menus.rowCount(app, 0) != 7 { return 11 }
    if !std.text.same(menus.rowName(app, 0, 0), "Undo") || !std.text.same(menus.rowNote(app, 0, 0), "Ctrl+Z") { return 12 }
    if menus.rowFlags(app, 0, 0) & menus.ROW_DISABLED == 0 || menus.rowFlags(app, 0, 1) != 0 { return 14 }
    if menus.rowFlags(app, 0, 2) != menus.ROW_SEPARATOR_BEFORE { return 15 }
    if menus.rowFlags(app, 0, 5) != menus.ROW_SEPARATOR_BEFORE | menus.ROW_CHECKABLE | menus.ROW_CHECKED { return 16 }
    if menus.rowFlags(app, 0, 6) != menus.ROW_CHECKABLE { return 17 }
    // Rows one under the other, the separator's room between Redo and Cut.
    const redo = menus.rowArea(app, 0, 1)
    const cut = menus.rowArea(app, 0, 2)
    const copy = menus.rowArea(app, 0, 3)
    if redo.height != 26 || copy.y != ui.bottom(cut) || cut.y <= ui.bottom(redo) || !inside(cut, box) { return 18 }
    // (Inside its rounded corners: they lie over the bars' glass.)
    if !opaque(app, ui.rect(box.x + 8, box.y + 8, box.width - 16, box.height - 16)) { return 19 }
    // The row under the pointer is lit, the others are not.
    if !pointIn(app, cut) || !activeIs(app, 0, 2) { return 20 }
    const lit = windowPixel(app, cut.x + 2, cut.y + cut.height / 2)
    if lit != theme.*.menuChosen || windowPixel(app, copy.x + 2, copy.y + copy.height / 2) == lit { return 21 }
    if !shot(app, shots, "menus-open.png") { return 22 }
    // The pointer on a disabled row lights nothing; a click there does
    // nothing.
    if !pointIn(app, menus.rowArea(app, 0, 0)) || menus.activeRow(app, 0) != null { return 23 }
    if !clickIn(app, menus.rowArea(app, 0, 0)) || !menus.isOpen(app) || !nothingRan(app) { return 24 }

    const file = menus.titleArea(app, state.MENU_FILE)
    if !pointIn(app, file) || menus.openMenu(app) != state.MENU_FILE { return 25 }
    if menus.listArea(app, 0).x != file.x || menus.rowCount(app, 0) != 6 { return 26 }
    if menus.rowFlags(app, 0, 2) & menus.ROW_SUBMENU == 0 || !std.text.same(menus.rowName(app, 0, 2), "Open Recent") { return 27 }
    // A click on an entry runs it and closes the menu.
    if !clickIn(app, menus.rowArea(app, 0, 1)) || menus.isOpen(app) || !ran(app, 102) { return 28 }
    // A click on the open title closes it.
    if !clickIn(app, file) || menus.openMenu(app) != state.MENU_FILE { return 29 }
    if !clickIn(app, file) || menus.isOpen(app) || !nothingRan(app) { return 30 }
    // A title without entries opens nothing.
    if !clickIn(app, menus.titleArea(app, state.MENU_TOOLS)) || menus.isOpen(app) { return 31 }
    return 0
}

// A press outside, with the brush over the canvas.
fn checkOutside(app: *App) -> u8 {
    if !script.run(app, "new 400 300 FFFFFF\ntool brush\n") { return 40 }
    const area = app.*.canvasArea
    const middle_x = area.x + area.width / 2
    const middle_y = area.y + area.height / 2
    if !clickIn(app, menus.titleArea(app, state.MENU_EDIT)) || !menus.isOpen(app) { return 41 }
    if ui.contains(menus.listArea(app, 0), middle_x, middle_y) { return 42 }
    if !at(app, "click", middle_x, middle_y) || menus.isOpen(app) || !nothingRan(app) { return 43 }
    if shown(app, 200, 150) != 0xFFFFFFFF { return 44 }
    // The right button outside closes as well, and paints nothing.
    if !clickIn(app, menus.titleArea(app, state.MENU_EDIT)) || !menus.isOpen(app) { return 45 }
    if !at(app, "pointer", middle_x, middle_y) || !script.run(app, "press right\nrelease right\n") || menus.isOpen(app) { return 46 }
    if shown(app, 200, 150) != 0xFFFFFFFF { return 47 }
    // With nothing open the click reaches the canvas: the brush paints.
    if !at(app, "click", middle_x, middle_y) || shown(app, 200, 150) == 0xFFFFFFFF { return 48 }
    return 0
}

// The keys.
fn checkKeys(app: *App) -> u8 {
    // F10 opens the first menu, Right the next; the second entry that can
    // be chosen there (Undo cannot) runs.
    if !script.run(app, "key F10\n") || menus.openMenu(app) != state.MENU_FILE || menus.activeRow(app, 0) != null { return 50 }
    if !script.run(app, "key Right\n") || menus.openMenu(app) != state.MENU_EDIT { return 51 }
    if !script.run(app, "key Down\nkey Down\n") || !activeIs(app, 0, 2) { return 52 }
    if !script.run(app, "key Enter\n") || menus.isOpen(app) || !ran(app, 203) { return 53 }
    // Escape closes; Left from the first menu goes round to the last one
    // that has entries; Up from nothing is the last entry; round the end.
    if !script.run(app, "key F10\nkey Escape\n") || menus.isOpen(app) { return 54 }
    if !script.run(app, "key F10\nkey Left\n") || menus.openMenu(app) != state.MENU_HELP { return 55 }
    if !script.run(app, "key Left\nkey Left\n") || menus.openMenu(app) != state.MENU_FILTER { return 56 }
    if !script.run(app, "key Right\nkey Right\nkey Right\nkey Up\n") || menus.openMenu(app) != state.MENU_FILE || !activeIs(app, 0, 5) { return 57 }
    if !script.run(app, "key Down\n") || !activeIs(app, 0, 0) { return 58 }
    // A letter jumps to the next entry that starts with it; Home and End.
    if !script.run(app, "key S\n") || !activeIs(app, 0, 3) { return 59 }
    if !script.run(app, "key O\nkey O\nkey O\n") || !activeIs(app, 0, 1) { return 60 }
    if !script.run(app, "key End\n") || !activeIs(app, 0, 5) || !script.run(app, "key Home\n") || !activeIs(app, 0, 0) { return 61 }
    // Into the submenu with Right (its first entry active), out with Left,
    // in again with Enter; Escape closes one level at a time.
    if !script.run(app, "key Down\nkey Down\nkey Right\n") || menus.depth(app) != 2 || !activeIs(app, 1, 0) { return 62 }
    if !script.run(app, "key Left\n") || menus.depth(app) != 1 || !activeIs(app, 0, 2) { return 63 }
    if !script.run(app, "key Enter\nkey Down\n") || menus.depth(app) != 2 || !activeIs(app, 1, 1) { return 64 }
    if !script.run(app, "key Escape\n") || menus.depth(app) != 1 || !menus.isOpen(app) { return 65 }
    if !script.run(app, "key Escape\n") || menus.isOpen(app) || !nothingRan(app) { return 66 }
    // Space runs too; a shortcut's chord closes the menu and is the
    // shortcut's.
    if !script.run(app, "key F10\nkey Down\nkey Space\n") || menus.isOpen(app) || !ran(app, 101) { return 67 }
    if !script.run(app, "key F10\n") || menus.key(app, 44, keys.CONTROL, "") || menus.isOpen(app) { return 68 }
    // Nothing open: keys other than F10 are not the menus'.
    if menus.key(app, keys.DOWN, 0, "") || menus.key(app, keys.ESCAPE, 0, "") || menus.isOpen(app) { return 69 }
    // Alt tapped alone opens the first menu; Alt again closes it; Alt with
    // something between opens nothing.
    if menus.key(app, keys.LEFT_ALT, keys.ALT, "") || !menus.keyUp(app, keys.LEFT_ALT) || menus.openMenu(app) != state.MENU_FILE { return 70 }
    if !menus.key(app, keys.LEFT_ALT, keys.ALT, "") || menus.isOpen(app) { return 71 }
    _ = menus.key(app, keys.LEFT_ALT, keys.ALT, "")
    _ = menus.key(app, 30, keys.ALT, "a")
    if menus.keyUp(app, keys.LEFT_ALT) || menus.isOpen(app) { return 72 }
    if !draw(app) { return 73 }
    return 0
}

// Submenus by the pointer.
fn checkSubmenus(app: *App, shots: []const u8) -> u8 {
    if !clickIn(app, menus.titleArea(app, state.MENU_FILE)) { return 80 }
    const recent = menus.rowArea(app, 0, 2)
    if !pointIn(app, recent) || menus.depth(app) != 2 || menus.rowCount(app, 1) != 2 { return 81 }
    const outer = menus.listArea(app, 0)
    const sub = menus.listArea(app, 1)
    // Beside its row, on the right, its first row level with it.
    if sub.x < ui.right(outer) - 4 || sub.y > recent.y || ui.bottom(sub) < ui.bottom(recent) { return 82 }
    if !std.text.same(menus.rowName(app, 1, 1), "two.png") || !opaque(app, sub) { return 83 }
    if !shot(app, shots, "menus-submenu.png") { return 84 }
    // Heading for the submenu across the row under it leaves it open;
    // going on down the list closes it.
    const two = menus.rowArea(app, 1, 1)
    const save = menus.rowArea(app, 0, 3)
    if !at(app, "pointer", ui.right(recent) - 20, save.y + 4) || menus.depth(app) != 2 || !activeIs(app, 0, 2) { return 85 }
    if !pointIn(app, menus.rowArea(app, 0, 5)) || menus.depth(app) != 1 || !activeIs(app, 0, 5) { return 86 }
    if !pointIn(app, recent) || menus.depth(app) != 2 { return 87 }
    if !clickIn(app, two) || menus.isOpen(app) || !ran(app, 104) { return 88 }
    // At the window's right edge it opens on the left.
    menus.openAt(app, state.MENU_FILE, WIDTH - 5, 200)
    if !draw(app) || !menus.isOpen(app) || menus.openMenu(app) != state.MENU_FILE { return 89 }
    if !pointIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 2 { return 90 }
    if ui.right(menus.listArea(app, 1)) > menus.listArea(app, 0).x + 4 || menus.listArea(app, 1).x < 0 { return 91 }
    if !clickIn(app, menus.rowArea(app, 1, 0)) || menus.isOpen(app) || !ran(app, 103) { return 92 }
    return 0
}

// A list taller than the window.
fn checkScroll(app: *App, shots: []const u8) -> u8 {
    if !clickIn(app, menus.titleArea(app, state.MENU_FILTER)) || menus.rowCount(app, 0) != FILTERS { return 100 }
    const box = menus.listArea(app, 0)
    // As tall as the room under the bar allows, in whole rows.
    if ui.bottom(box) > HEIGHT - 4 || ui.bottom(box) <= HEIGHT - 4 - 26 || (box.height - 4 * 2 - 18 * 2) % 26 != 0 || menus.firstShown(app, 0) != 0 { return 101 }
    if ui.isEmpty(menus.rowArea(app, 0, 0)) || !ui.isEmpty(menus.rowArea(app, 0, FILTERS - 1)) { return 102 }
    // The wheel, then the arrow at the top and the one at the bottom.
    if !pointIn(app, box) || !script.run(app, "wheel 2\n") || menus.firstShown(app, 0) != 6 { return 103 }
    if !at(app, "click", box.x + box.width / 2, box.y + 4 + 9) || menus.firstShown(app, 0) != 3 { return 104 }
    if !at(app, "click", box.x + box.width / 2, ui.bottom(box) - 4 - 9) || menus.firstShown(app, 0) != 6 { return 105 }
    if !menus.isOpen(app) || !nothingRan(app) { return 106 }
    // The last entry by End, shown whole, run by Enter.
    if !script.run(app, "key End\n") || !activeIs(app, 0, FILTERS - 1) { return 107 }
    const last = menus.rowArea(app, 0, FILTERS - 1)
    if !inside(last, box) || menus.firstShown(app, 0) == 0 || ui.bottom(last) != ui.bottom(box) - 4 - 18 { return 108 }
    if !shot(app, shots, "menus-scroll.png") { return 109 }
    if !script.run(app, "key Enter\n") || menus.isOpen(app) || !ran(app, 700 + FILTERS) { return 110 }
    // Page Down from the top moves by what is shown.
    if !script.run(app, "key F10\nkey Left\nkey Left\nkey Left\nkey Down\nkey PageDown\n") || menus.openMenu(app) != state.MENU_FILTER { return 111 }
    const paged = menus.activeRow(app, 0)
    if paged == null || paged.? < 20 || ui.isEmpty(menus.rowArea(app, 0, paged.?)) { return 112 }
    if !script.run(app, "key Escape\n") || menus.isOpen(app) { return 113 }
    return 0
}

// Context menus at a place.
fn checkPlaces(app: *App, shots: []const u8) -> u8 {
    const window = ui.rect(0, 0, WIDTH, HEIGHT)
    menus.openAt(app, state.MENU_EDIT, WIDTH - 5, HEIGHT - 5)
    if !draw(app) || menus.openMenu(app) != state.MENU_EDIT { return 120 }
    const box = menus.listArea(app, 0)
    if !inside(box, window) || ui.right(box) != WIDTH - 5 || ui.bottom(box) != HEIGHT - 5 { return 121 }
    // Left and Right do not go to other menus from a context menu.
    if !script.run(app, "key Right\n") || menus.openMenu(app) != state.MENU_EDIT { return 122 }
    if !clickIn(app, menus.rowArea(app, 0, 4)) || menus.isOpen(app) || !ran(app, 205) { return 123 }
    // At the top left it opens where it was asked.
    menus.openAt(app, state.MENU_EDIT, 300, 200)
    if !draw(app) || menus.listArea(app, 0).x != 300 || menus.listArea(app, 0).y != 200 { return 124 }
    if !script.run(app, "key Escape\n") || menus.isOpen(app) { return 125 }
    // Asked for outside the window: as far in as it takes.
    menus.openAt(app, state.MENU_EDIT, -50, -50)
    if !draw(app) || menus.listArea(app, 0).x != 4 || menus.listArea(app, 0).y != 4 { return 136 }
    if !script.run(app, "key Escape\n") || menus.isOpen(app) { return 137 }

    // A popup's entries: its owner learns which was chosen, once.
    var entries: [4]menus.Entry = undefined
    entries[0] = menus.Entry.{ .name = "Rename", .note = "F2", .action = "", .flags = 0 }
    entries[1] = menus.Entry.{ .name = "Delete", .note = "Del", .action = "", .flags = menus.ENTRY_SEPARATOR_BEFORE | menus.ENTRY_DISABLED }
    entries[2] = menus.Entry.{ .name = "Locked", .note = "", .action = "", .flags = menus.ENTRY_CHECKED }
    entries[3] = menus.Entry.{ .name = "A name far longer than the sixty-three bytes a popup keeps of a name", .note = "", .action = "", .flags = 0 }
    menus.popup(app, 77, 400, 300, entries[0..])
    if !draw(app) || !menus.isOpen(app) || menus.openMenu(app) != state.MENU_NONE || menus.rowCount(app, 0) != 4 { return 126 }
    if menus.rowName(app, 0, 3).length != 63 || menus.rowFlags(app, 0, 2) != menus.ROW_CHECKED | menus.ROW_CHECKABLE { return 127 }
    if !pointIn(app, menus.rowArea(app, 0, 0)) || !shot(app, shots, "menus-popup.png") { return 138 }
    if !clickIn(app, menus.rowArea(app, 0, 1)) || !menus.isOpen(app) || menus.chosen(app, 77) != null { return 128 }
    if !clickIn(app, menus.rowArea(app, 0, 2)) || menus.isOpen(app) { return 129 }
    if menus.chosen(app, 78) != null { return 130 }
    const picked = menus.chosen(app, 77)
    if picked == null || picked.? != 2 || menus.chosen(app, 77) != null { return 131 }
    // By the keys, and closed without a choice.
    menus.popup(app, 77, 400, 300, entries[0..])
    if !draw(app) || !script.run(app, "key Down\nkey Down\nkey Enter\n") || menus.isOpen(app) { return 132 }
    const keyed = menus.chosen(app, 77)
    if keyed == null || keyed.? != 2 { return 133 }
    menus.popup(app, 77, 400, 300, entries[0..])
    if !draw(app) || !script.run(app, "key Escape\n") || menus.isOpen(app) || menus.chosen(app, 77) != null { return 134 }
    // No entries: nothing opens.
    menus.popup(app, 77, 400, 300, entries[0..0])
    if menus.isOpen(app) { return 135 }
    // A dialog coming closes what was open under it; a popup opened over
    // the dialog goes with it.
    menus.openAt(app, state.MENU_EDIT, 300, 200)
    if !draw(app) || !menus.isOpen(app) { return 190 }
    if !api.pushDialog(app, state.Dialog.{ .draw = noDialog, .keyPress = null, .cancel = null, .accept = null }) || !draw(app) || menus.isOpen(app) { return 191 }
    menus.popup(app, 77, 400, 300, entries[0..])
    if !draw(app) || !menus.isOpen(app) || menus.listArea(app, 0).x != 400 { return 192 }
    api.popDialog(app)
    if !draw(app) || menus.isOpen(app) || menus.chosen(app, 77) != null { return 193 }
    return 0
}

fn noDialog(app: *App, window: ui.Rect) -> void {}

// German, and the light theme.
fn checkLooks(app: *App, shots: []const u8) -> u8 {
    if !script.run(app, "german\n") || !draw(app) { return 140 }
    if !std.text.same(menus.title(app, state.MENU_FILE), "Datei") || !std.text.same(menus.title(app, state.MENU_EDIT), "Bearbeiten") || !std.text.same(menus.title(app, state.MENU_HELP), "Hilfe") { return 141 }
    var menu: u8 = 1
    var right: i32 = 0
    while @intCast(usize, menu) < state.MENUS {
        const area = menus.titleArea(app, menu)
        if area.width <= 0 || area.x < right { return 142 }
        right = ui.right(area)
        menu += 1
    }
    if right > WIDTH { return 143 }
    if !clickIn(app, menus.titleArea(app, state.MENU_FILE)) || !pointIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 2 { return 144 }
    if !std.text.same(menus.rowName(app, 0, 2), "Zuletzt ge\xC3\xB6ffnet") { return 145 }
    if !shot(app, shots, "menus-german.png") { return 146 }
    if !script.run(app, "key Escape\nkey Escape\n") || menus.isOpen(app) { return 147 }
    app.*.german = false

    app.*.shell.*.lightness = 1024
    if !draw(app) || !clickIn(app, menus.titleArea(app, state.MENU_EDIT)) { return 148 }
    const theme = state.themeOf(app)
    const cut = menus.rowArea(app, 0, 2)
    if !pointIn(app, cut) || windowPixel(app, cut.x + 2, cut.y + cut.height / 2) != theme.*.menuChosen { return 149 }
    if !opaque(app, inset(menus.listArea(app, 0))) { return 150 }
    if !shot(app, shots, "menus-light.png") { return 151 }
    if !script.run(app, "key Escape\n") { return 152 }
    app.*.shell.*.lightness = 0
    return 0
}

// A larger window: the bar and a long list in it.
fn checkLarger(app: *App) -> u8 {
    if !script.run(app, "size 1280 800\n") || !draw(app) { return 180 }
    if ui.right(menus.titleArea(app, state.MENU_HELP)) > 1280 || menus.titleArea(app, state.MENU_HELP).width <= 0 { return 181 }
    if !clickIn(app, menus.titleArea(app, state.MENU_FILTER)) { return 182 }
    const box = menus.listArea(app, 0)
    if ui.bottom(box) > 800 - 4 || ui.bottom(box) <= 800 - 4 - 26 || ui.isEmpty(menus.rowArea(app, 0, 0)) { return 183 }
    if !script.run(app, "key Escape\nsize 1024 768\n") || menus.isOpen(app) { return 184 }
    return 0
}

// Twice the scale: the bar, the rows, the separators' room, the narrowest
// list and the margin at the window's edge all twice as large.
fn checkScale(app: *App) -> u8 {
    app.*.scale = 2
    // (Another lightness makes the frame scale the theme again.)
    app.*.lightness = -2
    if !draw(app) || menus.barHeight(app) != 52 || menus.titleArea(app, state.MENU_EDIT).height != 52 { return 185 }
    if !clickIn(app, menus.titleArea(app, state.MENU_EDIT)) || menus.openMenu(app) != state.MENU_EDIT { return 186 }
    const box = menus.listArea(app, 0)
    const redo = menus.rowArea(app, 0, 1)
    const cut = menus.rowArea(app, 0, 2)
    if redo.height != 52 || cut.y - ui.bottom(redo) != 18 || box.width < 360 || box.y != 52 || menus.rowArea(app, 0, 0).y != box.y + 8 { return 187 }
    menus.openAt(app, state.MENU_EDIT, WIDTH - 1, HEIGHT - 1)
    if !draw(app) || ui.right(menus.listArea(app, 0)) != WIDTH - 8 || ui.bottom(menus.listArea(app, 0)) != HEIGHT - 8 { return 188 }
    app.*.scale = 1
    app.*.lightness = -2
    if !script.run(app, "key Escape\n") || menus.isOpen(app) || !draw(app) || menus.barHeight(app) != 26 { return 189 }
    return 0
}

// 300 frames with a menu and its submenu open: each takes what the one
// before took of the value arena (std.ui's text takes some for every line
// it draws), none more.
fn checkArena(app: *App) -> u8 {
    if !clickIn(app, menus.titleArea(app, state.MENU_FILE)) || !pointIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 2 { return 160 }
    const canvas = script.frameOf(app).?
    var frames: turns.Turns = undefined
    turns.begin(&frames, true, false)
    const arena = frames.base
    const mark = turns.used(arena)
    var first: usize = 0
    var last: usize = 0
    var round: usize = 0
    while round < 300 {
        turns.turn(&frames)
        loop.frame(app, canvas)
        last = turns.used(arena) - mark
        if round == 1 { first = last }
        if last > 1048576 { return 161 }
        round += 1
    }
    if last != first { return 162 }
    turns.turn(&frames)
    if turns.used(arena) != mark || menus.depth(app) != 2 { return 163 }
    if !script.run(app, "key Escape\nkey Escape\n") || menus.isOpen(app) { return 164 }
    return 0
}

// With the actions' own tables: the bar is drawn, and each action that has
// a menu is in the model once.
fn checkRegistries(app: *App, items: *Items, allocator: std.allocator.Allocator) -> u8 {
    menus.useTestItems(app, items.*.items[0..0])
    if !draw(app) { return 170 }
    const panel = state.themeOf(app).*.panel | 0xFF000000
    var menu: u8 = 1
    while @intCast(usize, menu) < state.MENUS {
        const area = menus.titleArea(app, menu)
        if area.width <= 0 { return 171 }
        if app.*.body.loaded && !marked(app, ui.rect(area.x + 6, area.y + 4, area.width - 12, area.height - 8), panel) { return 177 }
        menu += 1
    }
    const total = actions.count()
    const list_memory = allocator.alloc(@sizeOf(menus.List) * 2, 16)
    const seen_memory = allocator.alloc(total * 4 + 4, 16)
    if list_memory == null || seen_memory == null { return 172 }
    const lists: [*]menus.List = unsafe { @ptrCast([*]menus.List, list_memory.?) }
    const seen: [*]u32 = unsafe { @ptrCast([*]u32, seen_memory.?) }
    menu = 1
    while @intCast(usize, menu) < state.MENUS {
        const list = &lists[0]
        menus.fill(app, list, menu, "")
        var row: usize = 0
        while row < list.*.count {
            const entry = &list.*.rows[row]
            if entry.*.origin == menus.ORIGIN_ACTION && entry.*.index < total { seen[entry.*.index] += 1 }
            if entry.*.flags & menus.ROW_SUBMENU != 0 {
                const sub = &lists[1]
                menus.fill(app, sub, menu, entry.*.submenu)
                if sub.*.count == 0 && entry.*.flags & menus.ROW_DISABLED == 0 { return 173 }
                var inner: usize = 0
                while inner < sub.*.count {
                    const subentry = &sub.*.rows[inner]
                    if subentry.*.origin == menus.ORIGIN_ACTION && subentry.*.index < total { seen[subentry.*.index] += 1 }
                    inner += 1
                }
            }
            row += 1
        }
        menu += 1
    }
    var index: usize = 0
    while index < total {
        const action = actions.at(index).?
        const wanted: u32 = if action.*.menu != state.MENU_NONE && @intCast(usize, action.*.menu) < state.MENUS { 1 } else { 0 }
        if seen[index] != wanted { return 174 }
        index += 1
    }
    // A title opens something exactly when the model has rows for it; F10
    // opens a menu exactly when one has.
    var any = false
    menu = 1
    while @intCast(usize, menu) < state.MENUS {
        menus.fill(app, &lists[0], menu, "")
        if menus.hasEntries(app, menu) != (lists[0].count > 0) { return 178 }
        if lists[0].count > 0 { any = true }
        menu += 1
    }
    if menus.key(app, keys.F10, 0, "") != any || menus.isOpen(app) != any { return 179 }
    menus.close(app)
    if !draw(app) || menus.isOpen(app) { return 199 }
    allocator.free(list_memory.?, @sizeOf(menus.List) * 2, 16)
    allocator.free(seen_memory.?, total * 4 + 4, 16)
    // A menu with entries opens and closes as with the test's.
    menu = 1
    while @intCast(usize, menu) < state.MENUS && !menus.hasEntries(app, menu) { menu += 1 }
    if @intCast(usize, menu) < state.MENUS {
        if !clickIn(app, menus.titleArea(app, menu)) || !menus.isOpen(app) { return 175 }
        if !script.run(app, "key Escape\n") || menus.isOpen(app) { return 176 }
    }
    return 0
}

// The rightmost column of `area` (from its middle on) with a pixel other
// than `ground`; -1 for none.
fn rightmostInk(app: *App, area: ui.Rect, ground: u32) -> i32 {
    var x = ui.right(area) - 1
    while x >= area.x + area.width / 2 {
        var y = area.y
        while y < ui.bottom(area) {
            if windowPixel(app, x, y) != ground { return x }
            y += 1
        }
        x -= 1
    }
    return -1
}

// Whether some pixel of `area` is exactly `color`.
fn hasColor(app: *App, area: ui.Rect, color: u32) -> bool {
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            if windowPixel(app, x, y) == color { return true }
            x += 1
        }
        y += 1
    }
    return false
}

// The frame's pixels of an open list and of the bar: the separator's line
// in the middle of its 9 rows of room, the rows' ground the popup's
// surface over the panel, a check mark only where an entry is checked,
// the shortcuts ending at one right edge 12 pixels in from the row's, a
// disabled entry in the theme's colour for that and an enabled one in
// the text's; the open title lit, the others not, a title under the
// pointer lit when its menu has entries and not when it has none.
fn checkInk(app: *App) -> u8 {
    const theme = state.themeOf(app)
    const panel = theme.*.panel | 0xFF000000
    const surface = canvas_module.over(panel, theme.*.popup, 255)
    const edit = menus.titleArea(app, state.MENU_EDIT)
    if !clickIn(app, edit) || menus.openMenu(app) != state.MENU_EDIT { return 205 }
    const cut = menus.rowArea(app, 0, 2)
    if !pointIn(app, cut) || !activeIs(app, 0, 2) { return 206 }
    const middle = cut.x + cut.width / 2
    if windowPixel(app, middle, cut.y - 5) != theme.*.popupBorder || windowPixel(app, middle, cut.y - 6) != surface || windowPixel(app, middle, cut.y - 4) != surface { return 207 }
    if windowPixel(app, middle, cut.y - 10) != surface || windowPixel(app, middle, cut.y - 1) != surface { return 208 }
    const snap = menus.rowArea(app, 0, 5)
    const rulers = menus.rowArea(app, 0, 6)
    if !marked(app, ui.rect(snap.x, snap.y, 26, snap.height), surface) || marked(app, ui.rect(rulers.x, rulers.y, 26, rulers.height), surface) { return 209 }
    const undo = menus.rowArea(app, 0, 0)
    const redo = menus.rowArea(app, 0, 1)
    if app.*.small.loaded {
        const end_undo = rightmostInk(app, undo, surface)
        const end_redo = rightmostInk(app, redo, surface)
        if end_undo != end_redo || end_redo > ui.right(redo) - 13 || end_redo < ui.right(redo) - 16 { return 210 }
    }
    if app.*.body.loaded && theme.*.text >> 24 == 255 && theme.*.disabled >> 24 == 255 {
        const undo_name = ui.rect(undo.x + 26, undo.y, 60, undo.height)
        const redo_name = ui.rect(redo.x + 26, redo.y, 60, redo.height)
        if !hasColor(app, undo_name, theme.*.disabled) || hasColor(app, undo_name, theme.*.text) || !hasColor(app, redo_name, theme.*.text) { return 211 }
    }
    // The bar: the open title lit, the one beside it not.
    const file = menus.titleArea(app, state.MENU_FILE)
    // (The bar is the desktop's glass.)
    if windowPixel(app, edit.x + 3, edit.y + 12) != theme.*.menuChosen || windowPixel(app, file.x + 3, file.y + 12) != theme.*.glass { return 212 }
    if !script.run(app, "key Escape\n") || menus.isOpen(app) { return 213 }
    const view_title = menus.titleArea(app, state.MENU_VIEW)
    if !pointIn(app, view_title) || windowPixel(app, view_title.x + 3, view_title.y + 12) != theme.*.hover { return 214 }
    const tools_title = menus.titleArea(app, state.MENU_TOOLS)
    if !pointIn(app, tools_title) || windowPixel(app, tools_title.x + 3, tools_title.y + 12) != theme.*.glass { return 215 }
    if !at(app, "pointer", 500, 400) { return 216 }
    return 0
}

fn noEntries(extra: *Extra) -> []const menus.Entry { return extra.*.entries[0..0] }

// The edges: places far outside the window, a popup of more entries than
// it keeps and of names, notes and action keys too long, a popup without
// entries while one is open, a right press whose release drew no frame,
// the language changing while a list is open, a press on a title that
// opens nothing, a list exactly as tall as its room and one a row
// taller, more rows than a list keeps, the wheel far past both ends, a
// list where nothing can be chosen, a window of 64 x 64, the pointer at
// the ends of i32, questions about what is not there.
fn checkEdges(app: *App, items: *Items, extra: *Extra) -> u8 {
    const window = ui.rect(0, 0, WIDTH, HEIGHT)
    // Places at the ends of i32: inside the window, no overflow.
    menus.openAt(app, state.MENU_EDIT, LARGEST, LARGEST)
    if !draw(app) || menus.openMenu(app) != state.MENU_EDIT || !inside(menus.listArea(app, 0), window) || ui.right(menus.listArea(app, 0)) != WIDTH - 4 { return 220 }
    menus.openAt(app, state.MENU_EDIT, SMALLEST, SMALLEST)
    if !draw(app) || menus.listArea(app, 0).x != 4 || menus.listArea(app, 0).y != 4 { return 221 }
    // A place a little below and right of the window, and one in the
    // margin at its corner: the list's corner 4 pixels in from the
    // window's.
    menus.openAt(app, state.MENU_EDIT, WIDTH + 976, HEIGHT + 1232)
    if !draw(app) || ui.right(menus.listArea(app, 0)) != WIDTH - 4 || ui.bottom(menus.listArea(app, 0)) != HEIGHT - 4 { return 217 }
    menus.openAt(app, state.MENU_EDIT, WIDTH - 1, HEIGHT - 1)
    if !draw(app) || ui.right(menus.listArea(app, 0)) != WIDTH - 4 || ui.bottom(menus.listArea(app, 0)) != HEIGHT - 4 { return 218 }
    // A menu that is none, past the last, or without entries: nothing.
    menus.close(app)
    menus.openAt(app, state.MENU_NONE, 10, 10)
    menus.openAt(app, 11, 10, 10)
    menus.openAt(app, 255, 10, 10)
    menus.openAt(app, state.MENU_TOOLS, 10, 10)
    if !draw(app) || menus.isOpen(app) { return 222 }

    // A popup of 40 entries keeps 32; a name of 62 bytes and a two-byte
    // character is cut before the character; a note is cut at 32 bytes;
    // an action key past 64 bytes makes the entry dim.
    var index: usize = 0
    while index < 62 {
        extra.*.longName[index] = 'a'
        index += 1
    }
    extra.*.longName[62] = 0xC3
    extra.*.longName[63] = 0xB6
    const long_name: [*]const u8 = &extra.*.longName
    index = 0
    while index < 40 {
        extra.*.entries[index] = menus.Entry.{ .name = "Entry", .note = "", .action = "", .flags = 0 }
        index += 1
    }
    extra.*.entries[0] = menus.Entry.{ .name = long_name[0..64], .note = "Ctrl+Alt+Shift+Super+Page Down, again", .action = "", .flags = 0 }
    extra.*.entries[1] = menus.Entry.{ .name = "Too long a key", .note = "", .action = "an_action_key_that_is_longer_than_the_sixty_four_bytes_a_popup_keeps", .flags = 0 }
    extra.*.entries[2] = menus.Entry.{ .name = "No such action", .note = "", .action = "no_such_action", .flags = 0 }
    menus.popup(app, 91, LARGEST, SMALLEST, extra.*.entries[0..40])
    if !draw(app) || menus.rowCount(app, 0) != 32 || !inside(menus.listArea(app, 0), window) { return 223 }
    if menus.rowName(app, 0, 0).length != 62 || menus.rowNote(app, 0, 0).length != 32 || !std.text.same(menus.rowNote(app, 0, 0), "Ctrl+Alt+Shift+Super+Page Down, ") { return 224 }
    if menus.rowFlags(app, 0, 1) & menus.ROW_DISABLED == 0 || menus.rowFlags(app, 0, 2) & menus.ROW_DISABLED != 0 { return 225 }
    // The last kept entry by End; an action that is not there runs nothing
    // and is told to nobody.
    if !script.run(app, "key End\nkey Enter\n") || menus.isOpen(app) { return 226 }
    const last = menus.chosen(app, 91)
    if last == null || last.? != 31 { return 227 }
    menus.popup(app, 91, 300, 300, extra.*.entries[0..3])
    if !draw(app) || !clickIn(app, menus.rowArea(app, 0, 2)) || menus.isOpen(app) || menus.chosen(app, 91) != null { return 228 }

    // A popup without entries while one is open: what is open stays, and
    // so does its owner.
    menus.popup(app, 77, 400, 300, extra.*.entries[2..5])
    if !draw(app) || !script.run(app, "key Down\n") || !activeIs(app, 0, 0) { return 229 }
    menus.popup(app, 88, 10, 10, noEntries(extra))
    if !draw(app) || !menus.isOpen(app) || menus.listArea(app, 0).x != 400 || !activeIs(app, 0, 0) { return 230 }
    if !clickIn(app, menus.rowArea(app, 0, 1)) || menus.isOpen(app) || menus.chosen(app, 88) != null { return 231 }
    const kept = menus.chosen(app, 77)
    if kept == null || kept.? != 1 { return 232 }
    // The same popup opened twice: the second starts afresh.
    menus.popup(app, 77, 400, 300, extra.*.entries[2..5])
    if !draw(app) || !script.run(app, "key Down\n") || !activeIs(app, 0, 0) { return 233 }
    menus.popup(app, 77, 400, 300, extra.*.entries[2..5])
    if !draw(app) || menus.activeRow(app, 0) != null || !script.run(app, "key Escape\n") || menus.isOpen(app) { return 234 }

    // A popup opened while the right button is down (a right click's
    // press); its release draws no frame; the next right press closes it
    // all the same and reaches nothing else.
    if !at(app, "pointer", 900, 500) { return 235 }
    loop.event(app, ui_app.EVENT_BUTTON, ui_app.BUTTON_RIGHT, 1)
    menus.popup(app, 92, 900, 500, extra.*.entries[2..5])
    if !draw(app) || !menus.isOpen(app) { return 236 }
    loop.event(app, ui_app.EVENT_BUTTON, ui_app.BUTTON_RIGHT, 0)
    app.*.shell.*.clock += 40
    loop.event(app, ui_app.EVENT_BUTTON, ui_app.BUTTON_RIGHT, 1)
    if menus.isOpen(app) || menus.chosen(app, 92) != null { return 237 }
    loop.event(app, ui_app.EVENT_BUTTON, ui_app.BUTTON_RIGHT, 0)
    if !draw(app) || menus.isOpen(app) { return 238 }

    // The language changes while a list and its submenu are open: the list
    // is the German one, the submenu closed, under the German title.
    if !clickIn(app, menus.titleArea(app, state.MENU_FILE)) || !pointIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 2 { return 239 }
    if !script.run(app, "german\n") || !draw(app) || !menus.isOpen(app) || menus.depth(app) != 1 { return 240 }
    if !std.text.same(menus.rowName(app, 0, 2), "Zuletzt ge\xC3\xB6ffnet") || menus.listArea(app, 0).x != menus.titleArea(app, state.MENU_FILE).x { return 241 }
    app.*.german = false
    if !script.run(app, "key Escape\n") || menus.isOpen(app) || !draw(app) { return 242 }

    // A press on a title that opens nothing, with a list open, is outside:
    // it closes, runs nothing, and the title opens nothing.
    if !clickIn(app, menus.titleArea(app, state.MENU_EDIT)) || !menus.isOpen(app) { return 243 }
    if !clickIn(app, menus.titleArea(app, state.MENU_TOOLS)) || menus.isOpen(app) || !nothingRan(app) { return 244 }
    if !clickIn(app, menus.titleArea(app, state.MENU_TOOLS)) || menus.isOpen(app) { return 245 }

    // A list as tall as its room under the bar (768 - 26 - 4 = 738 pixels:
    // 28 rows and 8 of border) does not scroll; one row more scrolls, in
    // 26 whole rows (738 - 8 - 36 = 694) between the arrows.
    extra.*.count = 0
    extraRows(extra, state.MENU_VIEW, "View ", 28, 3000)
    extraRows(extra, state.MENU_IMAGE, "Image ", 29, 4000)
    menus.useTestItems(app, extra.*.items[0..extra.*.count])
    if !draw(app) || !clickIn(app, menus.titleArea(app, state.MENU_VIEW)) || menus.rowCount(app, 0) != 28 { return 246 }
    const fits = menus.listArea(app, 0)
    if fits.height != 28 * 26 + 8 || ui.bottom(menus.rowArea(app, 0, 27)) != ui.bottom(fits) - 4 || menus.rowArea(app, 0, 0).y != fits.y + 4 { return 247 }
    if !script.run(app, "key Escape\n") || !clickIn(app, menus.titleArea(app, state.MENU_IMAGE)) || menus.rowCount(app, 0) != 29 { return 248 }
    const taller = menus.listArea(app, 0)
    if taller.height != 26 * 26 + 8 + 36 || menus.rowArea(app, 0, 0).y != taller.y + 4 + 18 || ui.isEmpty(menus.rowArea(app, 0, 25)) || !ui.isEmpty(menus.rowArea(app, 0, 26)) { return 249 }
    if !script.run(app, "key Escape\n") { return 250 }

    // More rows than a list keeps (128 of the 160 items kept; the items
    // past 160 are not kept at all): End reaches the 128th, the wheel far
    // past the end stops at the last 26, far past the start at the first.
    extra.*.count = 0
    extraRows(extra, state.MENU_LAYER, "Layer ", 164, 5000)
    extraRows(extra, state.MENU_HELP, "Help ", 6, 6000)
    menus.useTestItems(app, extra.*.items[0..extra.*.count])
    if !draw(app) || menus.hasEntries(app, state.MENU_HELP) || !clickIn(app, menus.titleArea(app, state.MENU_LAYER)) || menus.rowCount(app, 0) != menus.MAX_ROWS { return 251 }
    const layers = menus.listArea(app, 0)
    if !pointIn(app, layers) || !script.run(app, "wheel 60\n") || menus.firstShown(app, 0) != 128 - 26 { return 252 }
    if !script.run(app, "wheel -60\n") || menus.firstShown(app, 0) != 0 { return 253 }
    if !script.run(app, "key End\n") || !activeIs(app, 0, 127) || ui.isEmpty(menus.rowArea(app, 0, 127)) { return 254 }
    if !script.run(app, "key Enter\n") || menus.isOpen(app) || !ran(app, 5127) { return 32 }

    // Nothing in a list can be chosen: the keys move to nothing and run
    // nothing; a submenu whose entries are all dim is a dim row that opens
    // nothing; a line asked for above the first row takes no room.
    extra.*.count = 0
    extraAdd(extra, state.MENU_SELECT, "", "Grow", state.ACTION_SEPARATOR_BEFORE, false, 7001)
    extraAdd(extra, state.MENU_SELECT, "", "Shrink", 0, false, 7002)
    extraAdd(extra, state.MENU_SELECT, "Mode|Modus", "Add", 0, false, 7003)
    extraAdd(extra, state.MENU_SELECT, "Mode|Modus", "Subtract", 0, false, 7004)
    menus.useTestItems(app, extra.*.items[0..extra.*.count])
    if !draw(app) || !clickIn(app, menus.titleArea(app, state.MENU_SELECT)) || menus.rowCount(app, 0) != 3 { return 33 }
    if menus.rowFlags(app, 0, 2) != menus.ROW_SUBMENU | menus.ROW_DISABLED || menus.rowArea(app, 0, 0).y != menus.listArea(app, 0).y + 4 { return 34 }
    if !script.run(app, "key Down\nkey Up\nkey End\nkey Enter\nkey Right\n") || menus.activeRow(app, 0) != null || menus.openMenu(app) != state.MENU_SELECT || menus.depth(app) != 1 || !nothingRan(app) { return 35 }
    if !pointIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 1 || !clickIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 1 || !menus.isOpen(app) { return 36 }
    // New items while a list is open close it.
    menus.useTestItems(app, items.*.items[0..items.*.count])
    if menus.isOpen(app) || !draw(app) { return 37 }

    // The pointer at the ends of i32 while a submenu is open, then back on
    // a row: no overflow on the way.
    if !clickIn(app, menus.titleArea(app, state.MENU_FILE)) || !pointIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 2 { return 38 }
    const save = menus.rowArea(app, 0, 3)
    loop.event(app, ui_app.EVENT_MOTION, @bitCast(u32, SMALLEST), SMALLEST)
    if !draw(app) { return 39 }
    if !pointIn(app, save) || !menus.isOpen(app) { return 74 }
    loop.event(app, ui_app.EVENT_MOTION, @bitCast(u32, LARGEST), LARGEST)
    if !draw(app) || !pointIn(app, menus.rowArea(app, 0, 2)) || menus.depth(app) != 2 { return 75 }
    if !script.run(app, "key Escape\nkey Escape\n") || menus.isOpen(app) { return 76 }

    // What is not there: empty answers.
    if menus.rowCount(app, 0) != 0 || menus.rowName(app, 5, 999).length != 0 || menus.rowNote(app, 0, 0).length != 0 || menus.rowFlags(app, 0, 999) != 0 { return 77 }
    if !ui.isEmpty(menus.rowArea(app, 1, 0)) || !ui.isEmpty(menus.listArea(app, 7)) || !ui.isEmpty(menus.titleArea(app, 200)) || !ui.isEmpty(menus.titleArea(app, state.MENU_NONE)) { return 78 }
    if menus.activeRow(app, 9) != null || menus.firstShown(app, 3) != 0 || menus.depth(app) != 0 || menus.title(app, 11).length != 0 || menus.title(app, 0).length != 0 { return 79 }

    // A window of 64 x 64: no room for anything, nothing overflows, the
    // keys still choose (the last entry of File that can be chosen is
    // Quit), lists stay inside the window's width.
    if !script.run(app, "size 64 64\n") || !draw(app) { return 93 }
    if !script.run(app, "key F10\nkey End\nkey Enter\n") || menus.isOpen(app) || !ran(app, 107) { return 94 }
    if !script.run(app, "key F10\nkey Left\n") || menus.openMenu(app) != state.MENU_HELP || menus.titleArea(app, state.MENU_HELP).width != 0 { return 95 }
    const narrow = menus.listArea(app, 0)
    if narrow.x < 0 || ui.right(narrow) > 64 || narrow.width <= 0 { return 96 }
    menus.openAt(app, state.MENU_FILE, 60, 60)
    if !draw(app) || menus.listArea(app, 0).x < 0 || ui.right(menus.listArea(app, 0)) > 64 { return 97 }
    if !pointIn(app, menus.rowArea(app, 0, 2)) || !script.run(app, "key Escape\nkey Escape\n") || menus.isOpen(app) { return 98 }
    if !script.run(app, "size 1024 768\n") || !draw(app) || menus.isOpen(app) || !nothingRan(app) { return 99 }
    return 0
}

// Opening and closing a thousand times (lists, submenus, popups), the
// value arena watched: each round takes what the second one took and all
// of it goes back; the heap holds what it held before.
fn checkCycles(app: *App) -> u8 {
    const canvas = script.frameOf(app).?
    var entries: [3]menus.Entry = undefined
    entries[0] = menus.Entry.{ .name = "One", .note = "", .action = "", .flags = 0 }
    entries[1] = menus.Entry.{ .name = "Two", .note = "F2", .action = "", .flags = menus.ENTRY_CHECKED }
    entries[2] = menus.Entry.{ .name = "Three", .note = "", .action = "", .flags = menus.ENTRY_SEPARATOR_BEFORE }
    loop.frame(app, canvas)
    var frames: turns.Turns = undefined
    turns.begin(&frames, true, false)
    const arena = frames.base
    const mark = turns.used(arena)
    const heap = std.heap.liveBytes()
    var first: usize = 0
    var round: usize = 0
    while round < 1000 {
        turns.turn(&frames)
        menus.openAt(app, state.MENU_FILE, 300, 200)
        _ = menus.key(app, keys.DOWN, 0, "")
        _ = menus.key(app, keys.DOWN, 0, "")
        _ = menus.key(app, keys.DOWN, 0, "")
        _ = menus.key(app, keys.RIGHT, 0, "")
        if menus.depth(app) != 2 { return 194 }
        loop.frame(app, canvas)
        _ = menus.key(app, keys.ESCAPE, 0, "")
        _ = menus.key(app, keys.ESCAPE, 0, "")
        menus.popup(app, 5, 200, 200, entries[0..3])
        _ = menus.key(app, keys.END, 0, "")
        _ = menus.key(app, keys.ENTER, 0, "")
        const picked = menus.chosen(app, 5)
        if picked == null || picked.? != 2 || menus.isOpen(app) { return 195 }
        const used = turns.used(arena) - mark
        if round == 1 { first = used }
        if round > 1 && used != first { return 196 }
        round += 1
    }
    turns.turn(&frames)
    if turns.used(arena) != mark { return 197 }
    if std.heap.liveBytes() != heap || !nothingRan(app) { return 198 }
    loop.frame(app, canvas)
    return 0
}

// A list's area inside its rounded corners (they lie over the bars' glass).
fn inset(area: ui.Rect) -> ui.Rect {
    return ui.rect(area.x + 8, area.y + 8, area.width - 16, area.height - 16)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var shots: []const u8 = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { shots = std.string.asSlice(named.?) }
    const made = script.headless(allocator)
    if made == null { return 200 }
    const app = made.?
    const memory = allocator.alloc(@sizeOf(Items), 16)
    if memory == null { return 201 }
    const items: *Items = unsafe { @ptrCast(*Items, memory.?) }
    makeItems(items)
    menus.useTestItems(app, items.*.items[0..items.*.count])
    if menus.isOpen(app) || menus.depth(app) != 0 || menus.rowCount(app, 0) != 0 || menus.chosen(app, 1) != null { return 202 }
    if !script.run(app, "size 1024 768\n") || !draw(app) { return 203 }

    var failed = checkBar(app, shots)
    if failed != 0 { return failed }
    failed = checkInk(app)
    if failed != 0 { return failed }
    failed = checkOutside(app)
    if failed != 0 { return failed }
    failed = checkKeys(app)
    if failed != 0 { return failed }
    failed = checkSubmenus(app, shots)
    if failed != 0 { return failed }
    failed = checkScroll(app, shots)
    if failed != 0 { return failed }
    failed = checkPlaces(app, shots)
    if failed != 0 { return failed }
    failed = checkLooks(app, shots)
    if failed != 0 { return failed }
    failed = checkArena(app)
    if failed != 0 { return failed }
    failed = checkLarger(app)
    if failed != 0 { return failed }
    failed = checkScale(app)
    if failed != 0 { return failed }
    const extra_memory = allocator.alloc(@sizeOf(Extra), 16)
    if extra_memory == null { return 204 }
    const extra: *Extra = unsafe { @ptrCast(*Extra, extra_memory.?) }
    failed = checkEdges(app, items, extra)
    if failed != 0 { return failed }
    failed = checkCycles(app)
    if failed != 0 { return failed }
    failed = checkRegistries(app, items, allocator)
    if failed != 0 { return failed }
    return 13
}
