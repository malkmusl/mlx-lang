// nebula's Image and Layer menus (actions/image.mlx, actions/layer.mlx),
// played on an App without a window (app/script.mlx): Scale Image from
// its dialog (50 typed as the width, the height following, the Box
// filter) makes a 100 x 80 image 50 x 40 whose every pixel is the mean
// of the four it came from, and undo brings back size and pixels
// exactly; Resize Canvas with the middle anchor moves the pixels by half
// the growth, another anchor by all of it, typed offsets by theirs, a
// smaller canvas keeps what lies outside; a quarter turn swaps width and
// height and puts a marker where it belongs (across a tile's border
// too), four of them change nothing, half a turn and free angles (the
// image grows) and mirroring (the selection with it); crop to the
// selection and trim to a layer; Flatten Image and Merge Down give one
// layer with the composite's pixels (50 % red over blue; a filter layer
// merged into what is below), undo brings both layers back; Flatten
// Layer applies a mask; a duplicate shares its tiles until it is painted
// on; Insert, Ctrl+G putting the active layer into a group and Ungroup
// taking it out; cut and copy of the selection to a new layer; raise,
// lower, to the top and bottom, out of a group at its end; a layer
// mirrored, turned about the image's middle, scaled and wrapped from
// their dialogs, a locked one left alone; a filter layer (Invert, and one
// with settings in a form), a fill layer (the foreground colour), a
// filter mask from their dialogs change the composite, with a selection
// only where it is; Layer Properties changes name and opacity in one
// step, Image Properties the name and the resolution; every action is
// one step of the history, also on 50 layers, and all of them undone
// give the image back; the edges (a 1 pixel image, sizes of 0 and beyond
// the largest, negative places, an empty layer, nothing selected); the
// value arena does not grow with the pixels; the dialogs fit 1024 x 768
// and 800 x 600, in the dark and the light theme and in German. Pictures
// actions-*.png go to the current directory and, when NEBULA_SHOTS names
// a directory, there too. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const documents = @import("../app/documents.mlx")
const dialogs = @import("../ui/dialogs.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const image_actions = @import("../actions/image.mlx")
const layer_actions = @import("../actions/layer.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const device = @import("../core/device.mlx")
const mask = @import("../core/mask.mlx")
const history = @import("../core/history.mlx")
const render = @import("../core/render.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const selection = @import("../core/selection.mlx")
const transform = @import("../core/transform.mlx")
const tilepool = @import("../core/tilepool.mlx")
const filters = @import("../filters/registry.mlx")
const generators = @import("../generators/registry.mlx")

const App = state.App
const Image = image_module.Image
const Node = node_module.Node

const RED: u32 = 0xFFFF0000
const GREEN: u32 = 0xFF00FF00
const BLUE: u32 = 0xFF0000FF
const WHITE: u32 = 0xFFFFFFFF

// NEBULA_SHOTS, where pictures go besides the current directory.
var shotsAt: [512]u8 = undefined
var shotsLength: usize = 0

fn run(app: *App, text: []const u8) -> bool { return script.run(app, text) }

// A picture of the window as it is now, here and in NEBULA_SHOTS.
fn picture(app: *App, name: []const u8) -> bool {
    var line: [700]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 700, "shot ")
    length = std.text.append(bytes, length, 700, name)
    length = std.text.append(bytes, length, 700, "\n")
    if !run(app, bytes[0..length]) { return false }
    if shotsLength == 0 { return true }
    const shots: [*]const u8 = &shotsAt
    length = std.text.append(bytes, 0, 700, "shot ")
    length = std.text.append(bytes, length, 700, shots[0..shotsLength])
    if shotsAt[shotsLength - 1] != 47 { length = std.text.append(bytes, length, 700, "/") }
    length = std.text.append(bytes, length, 700, name)
    length = std.text.append(bytes, length, 700, "\n")
    return run(app, bytes[0..length])
}

fn step2(app: *App, command: []const u8, x: i32, y: i32) -> bool {
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, command)
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, x))
    length = std.text.append(bytes, length, 96, " ")
    length = std.text.appendSigned(bytes, length, 96, @intCast(isize, y))
    length = std.text.append(bytes, length, 96, "\n")
    return run(app, bytes[0..length])
}

// Where part `part` of the dialog on top was in the last frame.
fn areaOf(app: *App, part: usize) -> ui.Rect {
    const id = dialogs.partId(app, part)
    if id == view.NONE { return ui.rect(0, 0, 0, 0) }
    return view.areaOf(state.uiOf(app), id)
}

fn clickPart(app: *App, part: usize) -> bool {
    const area = areaOf(app, part)
    if area.width <= 0 || area.height <= 0 { return false }
    return step2(app, "click", area.x + area.width / 2, area.y + area.height / 2)
}

// A number typed into a field of the dialog on top.
fn typeInto(app: *App, part: usize, text: []const u8) -> bool {
    if !clickPart(app, part) { return false }
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, "type ")
    length = std.text.append(bytes, length, 96, text)
    length = std.text.append(bytes, length, 96, "\nkey Enter\nwait 0\n")
    return run(app, bytes[0..length])
}

// A number typed into a slider of the dialog on top (the right button
// opens it for typing; a click would set it by the place).
fn typeIntoSlider(app: *App, part: usize, text: []const u8) -> bool {
    const area = areaOf(app, part)
    if area.width <= 0 || !step2(app, "pointer", area.x + area.width / 2, area.y + area.height / 2) || !run(app, "press right\nrelease right\nwait 0\n") { return false }
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, "type ")
    length = std.text.append(bytes, length, 96, text)
    length = std.text.append(bytes, length, 96, "\nkey Enter\nwait 0\n")
    return run(app, bytes[0..length])
}

fn inside(inner: ui.Rect, outer: ui.Rect) -> bool {
    return inner.width > 0 && inner.height > 0 && inner.x >= outer.x && inner.y >= outer.y && ui.right(inner) <= ui.right(outer) && ui.bottom(inner) <= ui.bottom(outer)
}

// The dialog on top lies in a window `width` x `height` and its buttons
// are in it.
fn fits(app: *App, width: i32, height: i32) -> bool {
    const window = ui.rect(0, 0, width, height)
    const panel = dialogs.frameArea(app)
    return inside(panel, window) && inside(areaOf(app, dialogs.PART_BUTTON), panel) && inside(areaOf(app, dialogs.PART_BUTTON + 1), panel)
}

fn sized(app: *App, width: i32, height: i32) -> bool {
    var line: [64]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 64, "size ")
    length = std.text.appendSigned(bytes, length, 64, @intCast(isize, width))
    length = std.text.append(bytes, length, 64, " ")
    length = std.text.appendSigned(bytes, length, 64, @intCast(isize, height))
    length = std.text.append(bytes, length, 64, "\nwait 0\n")
    return run(app, bytes[0..length])
}

// A new transparent image in front ("Background" and "Layer 1", the
// second active), every other document closed first.
fn fresh(app: *App, width: i32, height: i32) -> ?*Image {
    while app.*.count > 0 {
        const doc = app.*.documents[app.*.count - 1].?
        canvasview.forget(app, doc)
        documents.close(app, app.*.count - 1)
    }
    var line: [64]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 64, "new ")
    length = std.text.appendSigned(bytes, length, 64, @intCast(isize, width))
    length = std.text.append(bytes, length, 64, " ")
    length = std.text.appendSigned(bytes, length, 64, @intCast(isize, height))
    length = std.text.append(bytes, length, 64, "\n")
    if !run(app, bytes[0..length]) { return null }
    return api.image(app)
}

// What was painted so far is where the image starts: nothing to undo.
fn settle(image: *Image) -> void {
    history.clear(image.*.history)
    image_module.damageAll(image)
}

fn steps(image: *Image) -> usize { return history.stepsDone(image.*.history) }

fn shown(image: *Image, x: i32, y: i32) -> u32 {
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

fn at(node: *Node, x: i32, y: i32) -> u32 { return device.pixel(node.*.device.?, x, y) }

fn put(node: *Node, x: i32, y: i32, color: u32) -> void { device.setPixel(node.*.device.?, x, y, color) }

fn layerAt(image: *Image, index: usize) -> *Node { return node_module.childAt(image.*.root, index) }

fn named(node: *Node, name: []const u8) -> bool { return std.text.same(node_module.nameOf(node), name) }

// The selection made a rectangle (one step).
fn select(image: *Image, area: geom.Rect) -> bool {
    ops.beginSelection(image)
    if !selection.fromRect(image.*.selection, area, selection.REPLACE, 0.0) { return false }
    ops.endSelection(image, true, "Select")
    return image.*.selected
}

// The colour every pixel of the pattern has: opaque, the channels
// changing at every pixel and differently along each side.
fn patternAt(x: i32, y: i32) -> u32 {
    const r = @intCast(u32, (x * 37 + y * 11) & 255)
    const g = @intCast(u32, (x * 5 + y * 23) & 255)
    const b = @intCast(u32, (x ^ y) & 255)
    return pixel.rgb(r, g, b)
}

fn paintPattern(node: *Node, width: i32, height: i32) -> void {
    var y: i32 = 0
    while y < height {
        var x: i32 = 0
        while x < width {
            put(node, x, y, patternAt(x, y))
            x += 1
        }
        y += 1
    }
}

// A number for what `area` of a node holds.
fn hashOf(node: *Node, area: geom.Rect) -> u64 {
    var hash: u64 = 14695981039346656037
    var y = area.y
    while y < geom.bottom(area) {
        var x = area.x
        while x < geom.right(area) {
            hash = (hash ^ @intCast(u64, at(node, x, y))) *% 1099511628211
            x += 1
        }
        y += 1
    }
    return hash
}

// The same for what the whole image shows.
fn shownHash(image: *Image) -> u64 {
    _ = render.update(image)
    var hash: u64 = 14695981039346656037
    var y: i32 = 0
    while y < image.*.height {
        var x: i32 = 0
        while x < image.*.width {
            hash = (hash ^ @intCast(u64, device.pixel(image.*.projection, x, y))) *% 1099511628211
            x += 1
        }
        y += 1
    }
    return hash
}

// Whether a channel of `scaled` is the mean of those of the four pixels
// it came from, to the nearest (|4 v - sum| <= 2).
fn meanOk(scaled: u32, sum: u32) -> bool {
    const four = scaled * 4
    return (four >= sum && four - sum <= 2) || (sum > four && sum - four <= 2)
}

fn channelSum(x: i32, y: i32, shift: u5) -> u32 {
    return ((patternAt(x, y) >> shift) & 255) + ((patternAt(x + 1, y) >> shift) & 255) + ((patternAt(x, y + 1) >> shift) & 255) + ((patternAt(x + 1, y + 1) >> shift) & 255)
}

// ---------------------------------------------------------------------------
// Scale Image

fn scaleSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 20 }
    const image = found.?
    const layer = api.activeNode(app).?
    paintPattern(layer, 100, 80)
    settle(image)
    const before = hashOf(layer, geom.rect(-8, -8, 116, 96))
    // From its dialog: 50 typed as the width, the height follows (the
    // sides are linked), the Box filter chosen from the list.
    if !run(app, "action image_scale\nwait 0\n") || app.*.dialogCount != 1 || !fits(app, 1024, 768) { return 21 }
    if !typeInto(app, image_actions.SCALE_WIDTH, "50") { return 22 }
    if !clickPart(app, image_actions.SCALE_FILTER) || !run(app, "key Down\nkey Down\nkey Enter\nwait 0\n") { return 23 }
    if !picture(app, "actions-scale.png") { return 24 }
    if image.*.width != 100 || steps(image) != 0 { return 25 }
    if !clickPart(app, dialogs.PART_BUTTON) || app.*.dialogCount != 0 { return 26 }
    if image.*.width != 50 || image.*.height != 40 || image.*.resolution != 72.0 || steps(image) != 1 { return 27 }
    // Every pixel the mean of the four it came from.
    var y: i32 = 0
    while y < 40 {
        var x: i32 = 0
        while x < 50 {
            const scaled = at(layer, x, y)
            if scaled >> 24 != 255 { return 28 }
            if !meanOk(pixel.red(scaled), channelSum(x * 2, y * 2, 16)) || !meanOk(pixel.green(scaled), channelSum(x * 2, y * 2, 8)) || !meanOk(pixel.blue(scaled), channelSum(x * 2, y * 2, 0)) { return 29 }
            x += 1
        }
        y += 1
    }
    if shown(image, 49, 39) != at(layer, 49, 39) { return 30 }
    const after = hashOf(layer, geom.rect(-8, -8, 66, 56))
    // Undo: size and pixels exactly as they were; redo: as scaled.
    api.undo(app)
    if image.*.width != 100 || image.*.height != 80 || hashOf(layer, geom.rect(-8, -8, 116, 96)) != before || at(layer, 99, 79) != patternAt(99, 79) { return 31 }
    api.redo(app)
    if image.*.width != 50 || hashOf(layer, geom.rect(-8, -8, 66, 56)) != after { return 32 }
    api.undo(app)
    // Cancel changes nothing.
    if !run(app, "action image_scale\nwait 0\n") || !typeInto(app, image_actions.SCALE_WIDTH, "10") || !clickPart(app, dialogs.PART_BUTTON + 1) { return 33 }
    if image.*.width != 100 || steps(image) != 0 || !history.canRedo(image.*.history) { return 34 }
    // Unlinked, by percent: 200 % across only.
    if !run(app, "action image_scale\nwait 0\n") || !clickPart(app, image_actions.SCALE_LINKED) { return 35 }
    if !clickPart(app, image_actions.SCALE_UNIT) || !run(app, "key Down\nkey Enter\nwait 0\n") || !typeInto(app, image_actions.SCALE_WIDTH, "200") { return 36 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 || image.*.width != 200 || image.*.height != 80 || steps(image) != 1 { return 37 }
    api.undo(app)
    // Sizes that are none: nothing happens.
    if image_actions.scaleImage(app, 0, 10, 72.0, transform.BOX) || image_actions.scaleImage(app, 40000, 10, 72.0, transform.BOX) || steps(image) != 0 || image.*.width != 100 { return 38 }
    // The same size at another resolution: one step that changes only it.
    if !image_actions.scaleImage(app, 100, 80, 300.0, transform.BOX) || image.*.resolution != 300.0 || steps(image) != 1 || hashOf(layer, geom.rect(-8, -8, 116, 96)) != before { return 39 }
    api.undo(app)
    if image.*.resolution != 72.0 { return 40 }
    // One pixel made 3 x 2 with the nearest pixel: all of it that colour.
    const tiny = fresh(app, 1, 1)
    if tiny == null { return 41 }
    const dot = api.activeNode(app).?
    put(dot, 0, 0, 0x80336699)
    settle(tiny.?)
    if !image_actions.scaleImage(app, 3, 2, 72.0, transform.NEAREST) || tiny.?.*.width != 3 || at(dot, 2, 1) != 0x80336699 || at(dot, 0, 0) != 0x80336699 || at(dot, 3, 0) != 0 { return 42 }
    return 0
}

// ---------------------------------------------------------------------------
// Resize Canvas

fn canvasSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 50 }
    const image = found.?
    const layer = api.activeNode(app).?
    // A marker, and one across a tile's border (64).
    put(layer, 10, 5, RED)
    put(layer, 70, 66, GREEN)
    settle(image)
    // 120 x 100 with the anchor in the middle: everything 10 to the right
    // and 10 down.
    if !run(app, "action image_canvas_size\nwait 0\n") || !fits(app, 1024, 768) { return 51 }
    if !typeInto(app, image_actions.CANVAS_WIDTH, "120") || !typeInto(app, image_actions.CANVAS_HEIGHT, "100") { return 52 }
    if !picture(app, "actions-canvas.png") { return 53 }
    if !clickPart(app, dialogs.PART_BUTTON) || app.*.dialogCount != 0 { return 54 }
    if image.*.width != 120 || image.*.height != 100 || steps(image) != 1 { return 55 }
    if at(layer, 20, 15) != RED || at(layer, 80, 76) != GREEN || at(layer, 10, 5) != 0 || shown(image, 20, 15) != RED { return 56 }
    api.undo(app)
    if image.*.width != 100 || at(layer, 10, 5) != RED || at(layer, 20, 15) != 0 || at(layer, 70, 66) != GREEN { return 57 }
    // The bottom right anchor: the image keeps to that corner.
    if !run(app, "action image_canvas_size\nwait 0\n") || !typeInto(app, image_actions.CANVAS_WIDTH, "140") || !clickPart(app, image_actions.CANVAS_ANCHOR + 8) { return 58 }
    if !run(app, "wait 0\nkey Enter\n") || app.*.dialogCount != 0 || image.*.width != 140 || at(layer, 50, 5) != RED || at(layer, 110, 66) != GREEN { return 59 }
    api.undo(app)
    // Offsets typed by hand count over the anchor's.
    if !run(app, "action image_canvas_size\nwait 0\n") || !typeInto(app, image_actions.CANVAS_X, "-3") || !typeInto(app, image_actions.CANVAS_Y, "7") || !run(app, "key Enter\n") { return 60 }
    if image.*.width != 100 || at(layer, 7, 12) != RED || steps(image) != 1 { return 61 }
    api.undo(app)
    // A smaller canvas keeps what lies outside it (layers have no edges).
    if !image_actions.resizeCanvas(app, 50, 40, -25, -20) || image.*.width != 50 || at(layer, -15, -15) != RED || at(layer, 45, 46) != GREEN { return 62 }
    api.undo(app)
    if image_actions.resizeCanvas(app, 0, 40, 0, 0) || image_actions.resizeCanvas(app, 40, 32769, 0, 0) || steps(image) != 0 { return 63 }
    if image_actions.anchorOffset(100, 120, 0) != 0 || image_actions.anchorOffset(100, 120, 1) != 10 || image_actions.anchorOffset(100, 120, 2) != 20 || image_actions.anchorOffset(100, 51, 1) != -24 { return 64 }
    return 0
}

// ---------------------------------------------------------------------------
// Turns and mirrors

fn turnSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 70 }
    const image = found.?
    const layer = api.activeNode(app).?
    paintPattern(layer, 100, 80)
    put(layer, 10, 5, RED)
    put(layer, 70, 66, GREEN)
    settle(image)
    const before = hashOf(layer, geom.rect(-8, -8, 116, 96))
    // A quarter clockwise: 80 x 100, (x, y) at (79 - y, x).
    if !run(app, "action image_rotate_90_cw\n") || image.*.width != 80 || image.*.height != 100 || steps(image) != 1 { return 71 }
    if at(layer, 74, 10) != RED || at(layer, 13, 70) != GREEN || at(layer, 79, 0) != patternAt(0, 0) || shown(image, 74, 10) != RED { return 72 }
    // And back.
    if !run(app, "action image_rotate_90_ccw\n") || image.*.width != 100 || at(layer, 10, 5) != RED || hashOf(layer, geom.rect(-8, -8, 116, 96)) != before { return 73 }
    // Four quarters are nothing; each one step.
    if !run(app, "action image_rotate_90_cw\naction image_rotate_90_cw\naction image_rotate_90_cw\naction image_rotate_90_cw\n") { return 74 }
    if image.*.width != 100 || image.*.height != 80 || hashOf(layer, geom.rect(-8, -8, 116, 96)) != before || steps(image) != 6 { return 75 }
    // A quarter anticlockwise: (x, y) at (y, 99 - x).
    if !run(app, "action image_rotate_90_ccw\n") || at(layer, 5, 89) != RED || at(layer, 66, 29) != GREEN { return 76 }
    api.undo(app)
    if !run(app, "action image_rotate_180\n") || image.*.width != 100 || at(layer, 89, 74) != RED || at(layer, 29, 13) != GREEN { return 77 }
    api.undo(app)
    // Ninety degrees asked as an angle is the exact quarter.
    if !image_actions.rotateImage(app, 90.0, transform.BICUBIC) || at(layer, 74, 10) != RED || image.*.width != 80 { return 78 }
    api.undo(app)
    // A free angle: the image grows to hold it; undo is exact.
    const steps_before = steps(image)
    if !run(app, "action image_rotate\nwait 0\n") || !fits(app, 1024, 768) || !typeIntoSlider(app, image_actions.ROTATE_ANGLE, "30") { return 79 }
    if !picture(app, "actions-rotate.png") || !run(app, "key Enter\n") || app.*.dialogCount != 0 { return 80 }
    if image.*.width < 126 || image.*.width > 128 || image.*.height < 118 || image.*.height > 120 || steps(image) != steps_before + 1 { return 81 }
    // The middle stays the middle, turned.
    const middle = at(layer, image.*.width / 2, image.*.height / 2)
    if middle >> 24 != 255 { return 82 }
    api.undo(app)
    if image.*.width != 100 || hashOf(layer, geom.rect(-8, -8, 116, 96)) != before { return 83 }
    // The quick buttons of the dialog.
    if !run(app, "action image_rotate\nwait 0\n") || !clickPart(app, image_actions.ROTATE_QUICK + 2) || !run(app, "wait 0\nkey Enter\n") || at(layer, 89, 74) != RED { return 84 }
    api.undo(app)
    // Mirrors, the selection with them.
    if !select(image, geom.rect(0, 0, 10, 10)) { return 85 }
    if !run(app, "action image_mirror_horizontal\n") || at(layer, 89, 5) != RED || at(layer, 29, 66) != GREEN || mask.at(image.*.selection, 95, 5) != 255 || mask.at(image.*.selection, 5, 5) != 0 { return 86 }
    if !run(app, "action image_mirror_vertical\n") || at(layer, 89, 74) != RED || mask.at(image.*.selection, 95, 75) != 255 { return 87 }
    api.undo(app)
    api.undo(app)
    if at(layer, 10, 5) != RED || mask.at(image.*.selection, 5, 5) != 255 { return 88 }
    // The selection turns with the image.
    if !run(app, "action image_rotate_90_cw\n") || mask.at(image.*.selection, 75, 5) != 255 || mask.at(image.*.selection, 5, 5) != 0 { return 89 }
    api.undo(app)
    return 0
}

// ---------------------------------------------------------------------------
// Crop and trim

fn cropSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 90 }
    const image = found.?
    const layer = api.activeNode(app).?
    put(layer, 25, 15, RED)
    put(layer, 10, 5, GREEN)
    settle(image)
    // Nothing selected: the action cannot run.
    if run(app, "action image_crop_to_selection\n") || image_actions.cropToSelection(app) { return 91 }
    if !select(image, geom.rect(20, 10, 30, 25)) { return 92 }
    const done = steps(image)
    if !run(app, "action image_crop_to_selection\n") || image.*.width != 30 || image.*.height != 25 || steps(image) != done + 1 { return 93 }
    // What was outside is gone; the selection came along.
    if at(layer, 5, 5) != RED || at(layer, -10, -5) != 0 || mask.at(image.*.selection, 0, 0) != 255 || mask.at(image.*.selection, 29, 24) != 255 { return 94 }
    api.undo(app)
    if image.*.width != 100 || at(layer, 10, 5) != GREEN || at(layer, 25, 15) != RED || mask.at(image.*.selection, 20, 10) != 255 { return 95 }
    // Trim to a layer: the rectangle around what it holds (beyond the
    // image too).
    const other = layerAt(image, 0)
    put(other, 30, 20, BLUE)
    put(other, 39, 29, BLUE)
    put(other, 110, 29, BLUE)
    image.*.active = other
    if !run(app, "action image_trim_to_layer\n") || image.*.width != 81 || image.*.height != 10 || at(other, 0, 0) != BLUE || at(other, 80, 9) != BLUE { return 96 }
    api.undo(app)
    // An empty layer: nothing to trim to.
    image.*.active = layer
    device.clear(layer.*.device.?)
    if image_actions.trimToLayer(app) || image.*.width != 100 { return 97 }
    return 0
}

// ---------------------------------------------------------------------------
// Flatten Image and Merge Down

fn mergeSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 100 }
    const image = found.?
    const ground = layerAt(image, 0)
    const top = layerAt(image, 1)
    // Blue below, red at half opacity over a part of it.
    _ = device.fill(ground.*.device.?, image_module.bounds(image), BLUE)
    _ = device.fill(top.*.device.?, geom.rect(20, 10, 50, 40), RED)
    top.*.opacity = 128
    settle(image)
    const mixed = shown(image, 30, 20)
    if mixed != 0xFF80007F || shown(image, 5, 5) != BLUE { return 101 }
    const composite = shownHash(image)
    // Merge Down: one paint layer, the lower one's name, the composite's
    // pixels.
    if !run(app, "key Ctrl+E\n") || node_module.childCount(image.*.root) != 1 || steps(image) != 1 { return 102 }
    const merged = layerAt(image, 0)
    if !named(merged, "Background") || merged.*.kind != node_module.PAINT || merged.*.opacity != 255 || at(merged, 30, 20) != mixed || at(merged, 5, 5) != BLUE { return 103 }
    if shownHash(image) != composite || image.*.active == null || @intFromPtr(image.*.active.?) != @intFromPtr(merged) { return 104 }
    if !picture(app, "actions-merged.png") { return 105 }
    // Undo brings both back as they were.
    api.undo(app)
    if node_module.childCount(image.*.root) != 2 || @intFromPtr(layerAt(image, 0)) != @intFromPtr(ground) || @intFromPtr(layerAt(image, 1)) != @intFromPtr(top) { return 106 }
    if top.*.opacity != 128 || at(top, 30, 20) != RED || at(ground, 30, 20) != BLUE || shownHash(image) != composite { return 107 }
    // The lowest layer has nothing to merge into.
    image.*.active = ground
    if run(app, "action layer_merge_down\n") || node_module.childCount(image.*.root) != 2 { return 108 }
    // Flatten Image: one layer showing what all showed.
    if !run(app, "key Ctrl+Shift+E\n") || node_module.childCount(image.*.root) != 1 || shownHash(image) != composite || at(layerAt(image, 0), 30, 20) != mixed { return 109 }
    api.undo(app)
    if node_module.childCount(image.*.root) != 2 || shownHash(image) != composite { return 110 }
    // A filter layer (Invert) merged down inverts what is below it.
    image.*.active = top
    var params: node_module.Params = undefined
    filters.defaults(filters.INVERT, &params)
    const inverted = layer_actions.newFilterLayer(app, &params, "")
    if inverted == null || shown(image, 5, 5) != 0xFFFFFF00 { return 111 }
    if !run(app, "action layer_merge_down\n") || node_module.childCount(image.*.root) != 2 { return 112 }
    const into = layerAt(image, 1)
    // (What the layer did not cover is inverted too, and stays without
    // alpha.)
    if !named(into, "Layer 1") || at(into, 30, 20) != 0xFF00FFFF || at(into, 5, 5) >> 24 != 0 || shown(image, 30, 20) != pixel.over(BLUE, 0xFF00FFFF, 128) || shown(image, 5, 5) != BLUE { return 113 }
    api.undo(app)
    api.undo(app)
    // A layer with masks flattened: the masks are applied.
    image.*.active = top
    if !run(app, "action layer_new_transparency_mask\n") || node_module.childCount(top) != 1 { return 114 }
    const hiding = node_module.childAt(top, 0)
    _ = device.fill(hiding.*.device.?, geom.rect(20, 10, 25, 40), mask.NOTHING)
    image_module.damageAll(image)
    const masked = shownHash(image)
    if shown(image, 21, 11) != BLUE { return 115 }
    image.*.active = top
    if !run(app, "action layer_flatten\n") || node_module.childCount(image.*.root) != 2 { return 116 }
    const flat = layerAt(image, 1)
    if flat.*.kind != node_module.PAINT || node_module.childCount(flat) != 0 || flat.*.opacity != 128 || at(flat, 21, 11) != 0 || at(flat, 50, 20) != RED || shownHash(image) != masked { return 117 }
    api.undo(app)
    if node_module.childCount(top) != 1 { return 118 }
    return 0
}

// ---------------------------------------------------------------------------
// Duplicate, group, ungroup, order

fn duplicateSection(app: *App) -> u8 {
    const found = fresh(app, 200, 150)
    if found == null { return 120 }
    const image = found.?
    const layer = api.activeNode(app).?
    _ = device.fill(layer.*.device.?, geom.rect(0, 0, 200, 150), GREEN)
    settle(image)
    const tiles = tilepool.liveTiles()
    if !run(app, "key Ctrl+J\n") || node_module.childCount(image.*.root) != 3 || steps(image) != 1 { return 121 }
    const copy = layerAt(image, 2)
    if !named(copy, "Layer 1 copy") || @intFromPtr(image.*.active.?) != @intFromPtr(copy) || at(copy, 199, 149) != GREEN { return 122 }
    // Not one tile more until it is painted on; then one.
    if tilepool.liveTiles() != tiles { return 123 }
    _ = ops.beginPixels(image, copy)
    put(copy, 100, 100, RED)
    _ = ops.endPixels(image, copy, "Paint")
    if tilepool.liveTiles() != tiles + 1 || at(layer, 100, 100) != GREEN || at(copy, 100, 100) != RED { return 124 }
    api.undo(app)
    api.undo(app)
    if node_module.childCount(image.*.root) != 2 { return 125 }
    // Delete, and undo.
    image.*.active = layer
    if !run(app, "key Shift+Delete\n") || node_module.childCount(image.*.root) != 1 { return 126 }
    api.undo(app)
    if node_module.childCount(image.*.root) != 2 || @intFromPtr(layerAt(image, 1)) != @intFromPtr(layer) { return 127 }
    // Insert: a new paint layer above the active one, named after the
    // layers there are.
    image.*.active = layer
    if !run(app, "key Insert\n") || node_module.childCount(image.*.root) != 3 || !named(layerAt(image, 2), "Layer 2") || api.activeNode(app).?.*.kind != node_module.PAINT { return 128 }
    if !run(app, "key Insert\n") || !named(layerAt(image, 3), "Layer 3") { return 129 }
    return 0
}

fn groupSection(app: *App) -> u8 {
    const found = fresh(app, 64, 64)
    if found == null { return 130 }
    const image = found.?
    const ground = layerAt(image, 0)
    const layer = layerAt(image, 1)
    settle(image)
    // Ctrl+G: the active layer into a new group in its place.
    image.*.active = layer
    if !run(app, "key Ctrl+G\n") || node_module.childCount(image.*.root) != 2 || steps(image) != 1 { return 131 }
    const group = layerAt(image, 1)
    if group.*.kind != node_module.GROUP || layer.*.parent == null || @intFromPtr(layer.*.parent.?) != @intFromPtr(group) || !named(group, "Group 1") { return 132 }
    api.undo(app)
    if @intFromPtr(layer.*.parent.?) != @intFromPtr(image.*.root) || node_module.childCount(image.*.root) != 2 { return 133 }
    api.redo(app)
    // Raise and lower: a layer at a group's end steps out of it.
    image.*.active = layer
    if !run(app, "action layer_raise\n") || @intFromPtr(layer.*.parent.?) != @intFromPtr(image.*.root) || node_module.indexIn(image.*.root, layer).? != 2 { return 134 }
    if !run(app, "action layer_lower\n") || node_module.indexIn(image.*.root, layer).? != 1 || node_module.indexIn(image.*.root, group).? != 2 { return 135 }
    if !run(app, "action layer_lower\n") || node_module.indexIn(image.*.root, layer).? != 0 || @intFromPtr(layerAt(image, 1)) != @intFromPtr(ground) { return 136 }
    if run(app, "action layer_lower\n") { return 137 }
    if !run(app, "key Ctrl+Shift+PgUp\n") || node_module.indexIn(image.*.root, layer).? != 2 { return 138 }
    if !run(app, "key Ctrl+Shift+PgDown\n") || node_module.indexIn(image.*.root, layer).? != 0 { return 139 }
    if !run(app, "key Ctrl+PgUp\n") || node_module.indexIn(image.*.root, layer).? != 1 { return 140 }
    // Into the group again by undoing, then Ungroup.
    while steps(image) > 1 { api.undo(app) }
    if @intFromPtr(layer.*.parent.?) != @intFromPtr(group) { return 141 }
    image.*.active = group
    const done = steps(image)
    if !run(app, "key Ctrl+Alt+G\n") || node_module.childCount(image.*.root) != 2 || @intFromPtr(layer.*.parent.?) != @intFromPtr(image.*.root) || node_module.indexIn(image.*.root, layer).? != 1 { return 142 }
    if steps(image) != done + 1 || node_module.find(image.*.root, group.*.id) != null { return 143 }
    api.undo(app)
    if @intFromPtr(layer.*.parent.?) != @intFromPtr(group) || node_module.indexIn(image.*.root, group).? != 1 { return 144 }
    // Ungroup of what is no group cannot run.
    image.*.active = ground
    if run(app, "action layer_ungroup\n") { return 145 }
    return 0
}

// ---------------------------------------------------------------------------
// The selection to a new layer

fn cutSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 150 }
    const image = found.?
    const layer = api.activeNode(app).?
    _ = device.fill(layer.*.device.?, geom.rect(10, 10, 60, 40), RED)
    settle(image)
    if !select(image, geom.rect(40, 20, 50, 50)) { return 151 }
    const done = steps(image)
    const composite = shownHash(image)
    if !run(app, "key Ctrl+Shift+J\n") || node_module.childCount(image.*.root) != 3 || steps(image) != done + 1 { return 152 }
    const cut = layerAt(image, 2)
    if at(cut, 50, 30) != RED || at(cut, 20, 20) != 0 || at(layer, 50, 30) != 0 || at(layer, 20, 20) != RED || shownHash(image) != composite { return 153 }
    if @intFromPtr(image.*.active.?) != @intFromPtr(cut) { return 154 }
    api.undo(app)
    if node_module.childCount(image.*.root) != 2 || at(layer, 50, 30) != RED { return 155 }
    // A copy leaves the layer as it is.
    image.*.active = layer
    if !run(app, "key Ctrl+Alt+J\n") || at(layer, 50, 30) != RED || at(layerAt(image, 2), 50, 30) != RED || at(layerAt(image, 2), 20, 20) != 0 { return 156 }
    api.undo(app)
    // A fill layer's colour copied: what it shows, where it is selected.
    image.*.active = layer
    var params: node_module.Params = undefined
    generators.defaults(generators.COLOR, &params)
    if layer_actions.newFillLayer(app, &params, "White") == null { return 157 }
    // (The fill layer filled only what was selected: a mask of it.)
    if node_module.childCount(api.activeNode(app).?) != 1 || shown(image, 20, 20) != RED || shown(image, 50, 30) != WHITE { return 158 }
    if !run(app, "action layer_copy_selection_to_new\n") || at(api.activeNode(app).?, 50, 30) != WHITE || at(api.activeNode(app).?, 20, 20) != 0 { return 159 }
    return 0
}

// ---------------------------------------------------------------------------
// Filter layers, fill layers, filter masks from their dialogs

fn makingSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 160 }
    const image = found.?
    const ground = layerAt(image, 0)
    _ = device.fill(ground.*.device.?, image_module.bounds(image), WHITE)
    settle(image)
    // Invert, the first choice, has no settings: made at once.
    if !run(app, "action layer_new_filter\nwait 0\n") || app.*.dialogCount != 1 || !fits(app, 1024, 768) || !picture(app, "actions-new-filter.png") { return 161 }
    if !run(app, "key Enter\nwait 0\n") || app.*.dialogCount != 0 || node_module.childCount(image.*.root) != 3 || steps(image) != 1 { return 162 }
    const invert = layerAt(image, 2)
    if invert.*.kind != node_module.FILTER || invert.*.params.id != filters.INVERT || !named(invert, "Invert") || shown(image, 5, 5) != 0xFF000000 { return 163 }
    api.undo(app)
    if shown(image, 5, 5) != WHITE { return 164 }
    // Another filter, named, its numbers asked in a form.
    if !run(app, "action layer_new_filter\nwait 0\n") || !clickPart(app, layer_actions.CHOOSER_NAME) || !run(app, "type Soft\nkey Enter\nwait 0\n") { return 165 }
    if !clickPart(app, layer_actions.CHOOSER_LIST) || !run(app, "key Down\nkey Enter\nwait 0\n") || !clickPart(app, dialogs.PART_BUTTON) { return 166 }
    if app.*.dialogCount == 1 {
        if !run(app, "wait 0\n") || !fits(app, 1024, 768) || !picture(app, "actions-filter-form.png") || !run(app, "key Enter\nwait 0\n") { return 167 }
    }
    const soft = layerAt(image, 2)
    if app.*.dialogCount != 0 || soft.*.kind != node_module.FILTER || soft.*.params.id == filters.INVERT || !named(soft, "Soft") || steps(image) != 1 { return 168 }
    api.undo(app)
    // A fill layer of the foreground colour: the form, then the layer.
    if !run(app, "color 336699\naction layer_new_fill\nwait 0\n") || !picture(app, "actions-new-fill.png") || !run(app, "key Enter\nwait 0\n") || app.*.dialogCount != 1 { return 169 }
    if !fits(app, 1024, 768) || !picture(app, "actions-fill-form.png") || !run(app, "key Enter\nwait 0\n") || app.*.dialogCount != 0 { return 170 }
    const fill = layerAt(image, 2)
    if fill.*.kind != node_module.FILL || shown(image, 5, 5) != 0xFF336699 || shown(image, 99, 79) != 0xFF336699 || steps(image) != 1 { return 171 }
    api.undo(app)
    // Cancelled in the form: nothing is made.
    if !run(app, "action layer_new_fill\nwait 0\nkey Enter\nwait 0\nkey Escape\n") || app.*.dialogCount != 0 || node_module.childCount(image.*.root) != 2 || steps(image) != 0 { return 172 }
    // A filter mask on the active layer.
    image.*.active = ground
    if !run(app, "action layer_new_filter_mask\nwait 0\nkey Enter\nwait 0\n") || node_module.childCount(ground) != 1 || node_module.childAt(ground, 0).*.kind != node_module.FILTER_MASK || shown(image, 5, 5) != 0xFF000000 || steps(image) != 1 { return 173 }
    api.undo(app)
    // With a selection: a filter layer filters only what is selected.
    if !select(image, geom.rect(0, 0, 50, 80)) { return 174 }
    if !run(app, "action layer_new_filter\nwait 0\nkey Enter\nwait 0\n") || shown(image, 5, 5) != 0xFF000000 || shown(image, 60, 5) != WHITE { return 175 }
    return 0
}

// ---------------------------------------------------------------------------
// Layer Properties

fn propertiesSection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 176 }
    const image = found.?
    const layer = api.activeNode(app).?
    _ = device.fill(layer.*.device.?, image_module.bounds(image), RED)
    settle(image)
    if !run(app, "key F3\nwait 0\n") || app.*.dialogCount != 1 || !fits(app, 1024, 768) { return 177 }
    if !clickPart(app, dialogs.PART_FIELD) || !run(app, "type Sky\nkey Enter\nwait 0\n") || !typeIntoSlider(app, dialogs.PART_FIELD + 1, "50") { return 178 }
    if !picture(app, "actions-layer-properties.png") || steps(image) != 0 { return 179 }
    if !clickPart(app, dialogs.PART_BUTTON) || app.*.dialogCount != 0 { return 180 }
    if !named(layer, "Sky") || layer.*.opacity < 127 || layer.*.opacity > 128 || steps(image) != 1 { return 181 }
    // One step: undo takes back both.
    api.undo(app)
    if !named(layer, "Layer 1") || layer.*.opacity != 255 || steps(image) != 0 { return 182 }
    // Image Properties: the name and the resolution.
    if !run(app, "action image_properties\nwait 0\n") || !fits(app, 1024, 768) || !clickPart(app, image_actions.PROPERTIES_NAME) || !run(app, "type Seascape\nkey Enter\nwait 0\n") { return 183 }
    if !typeInto(app, image_actions.PROPERTIES_RESOLUTION, "300") || !picture(app, "actions-image-properties.png") || !clickPart(app, dialogs.PART_BUTTON) { return 184 }
    if !std.text.same(documents.nameOf(api.document(app).?), "Seascape") || image.*.resolution != 300.0 || steps(image) != 1 || image.*.width != 100 { return 185 }
    return 0
}

// ---------------------------------------------------------------------------
// Every action one step

// The keys of actions run one after the other below, each one step.
const SEQUENCE = "image_rotate_90_cw\nimage_rotate_90_ccw\nimage_rotate_180\nimage_mirror_horizontal\nimage_mirror_vertical\nimage_crop_to_selection\nimage_trim_to_layer\nlayer_select_opaque\nlayer_new\nlayer_new_group\nlayer_ungroup\nlayer_new_clone\nlayer_convert_to_paint\nlayer_new_from_visible\nlayer_duplicate\nlayer_delete\nlayer_new_transparency_mask\nlayer_new_colorize_mask\nlayer_new_transform_mask\nlayer_new_selection_mask\nlayer_flatten\nlayer_cut_selection_to_new\nlayer_copy_selection_to_new\nlayer_alpha_to_mask\nlayer_mirror_horizontal\nlayer_mirror_vertical\nlayer_rotate_90_cw\nlayer_rotate_90_ccw\nlayer_rotate_180\nlayer_lower\nlayer_raise\nlayer_to_bottom\nlayer_to_top\nlayer_toggle_visible\nlayer_toggle_visible\nlayer_lock\nlayer_lock\nlayer_alpha_lock\nlayer_inherit_alpha\nlayer_merge_down\nimage_flatten\n"

fn everySection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 186 }
    const image = found.?
    const layer = api.activeNode(app).?
    _ = device.fill(layer.*.device.?, geom.rect(10, 10, 60, 40), 0x80FF0000)
    _ = device.fill(layerAt(image, 0).*.device.?, image_module.bounds(image), BLUE)
    settle(image)
    if !select(image, geom.rect(5, 5, 80, 60)) { return 187 }
    const text = SEQUENCE
    var at_byte: usize = 0
    var index: usize = 0
    while at_byte < text.length {
        var end = at_byte
        while end < text.length && text[end] != 10 { end += 1 }
        const key = text[at_byte..end]
        const before = steps(image)
        if !api.run(app, key) || steps(image) != before + 1 {
            _ = std.io.eprintln(key)
            return 188
        }
        at_byte = end + 1
        index += 1
    }
    if node_module.childCount(image.*.root) != 1 || steps(image) != index + 1 { return 189 }
    // And all of it undone, step by step, back to where it began.
    while history.canUndo(image.*.history) { api.undo(app) }
    if image.*.width != 100 || node_module.childCount(image.*.root) != 2 || at(layer, 10, 10) != 0x80FF0000 || image.*.selected { return 190 }
    return 0
}

// ---------------------------------------------------------------------------
// Fifty layers

fn manySection(app: *App) -> u8 {
    const found = fresh(app, 64, 64)
    if found == null { return 191 }
    const image = found.?
    while node_module.childCount(image.*.root) < 50 {
        const made = ops.newLayer(image, node_module.PAINT, "Many", "New layer")
        if made == null { return 192 }
    }
    var index: usize = 0
    while index < 50 {
        put(layerAt(image, index), @intCast(i32, index), @intCast(i32, index), 0xFF000000 | @intCast(u32, index * 5))
        index += 1
    }
    settle(image)
    if !image_actions.scaleImage(app, 128, 128, 72.0, transform.NEAREST) || steps(image) != 1 { return 193 }
    index = 0
    while index < 50 {
        const place = @intCast(i32, index * 2)
        if at(layerAt(image, index), place, place) != 0xFF000000 | @intCast(u32, index * 5) { return 194 }
        index += 1
    }
    if !run(app, "action image_rotate_90_cw\naction image_flatten\n") || steps(image) != 3 || node_module.childCount(image.*.root) != 1 { return 195 }
    api.undo(app)
    api.undo(app)
    api.undo(app)
    if steps(image) != 0 || node_module.childCount(image.*.root) != 50 || image.*.width != 64 || at(layerAt(image, 49), 49, 49) != 0xFF000000 | 245 { return 196 }
    return 0
}

// ---------------------------------------------------------------------------
// The value arena

// What `rounds` rounds of actions on a 300 x 300 image take from the
// value arena.
fn arenaFor(app: *App, rounds: usize) -> usize {
    const arena = turns.locate()
    const before = turns.used(arena)
    var round: usize = 0
    while round < rounds {
        _ = image_actions.rotateImage90(app, 1)
        _ = image_actions.mirrorImage(app, true)
        _ = image_actions.scaleImage(app, 150, 150, 72.0, transform.BILINEAR)
        _ = layer_actions.mergeDown(app)
        api.undo(app)
        api.undo(app)
        api.undo(app)
        api.undo(app)
        _ = layer_actions.alphaToMask(app)
        api.undo(app)
        round += 1
    }
    return turns.used(arena) - before
}

fn arenaSection(app: *App) -> u8 {
    const found = fresh(app, 300, 300)
    if found == null { return 197 }
    const image = found.?
    paintPattern(layerAt(image, 0), 300, 300)
    _ = device.fill(layerAt(image, 1).*.device.?, geom.rect(30, 30, 200, 200), 0x80FF0000)
    settle(image)
    const once = arenaFor(app, 1)
    const five = arenaFor(app, 5)
    // What the actions keep there does not grow with the pixels (90000
    // of them): a few small records a call at most.
    if five > 5 * 16384 || once > 16384 || steps(image) != 0 { return 198 }
    return 0
}

// ---------------------------------------------------------------------------
// How the dialogs look: smaller windows, the light theme, German

fn opened(app: *App, key: []const u8) -> bool {
    var line: [96]u8 = undefined
    const bytes: [*]u8 = &line
    var length = std.text.append(bytes, 0, 96, "action ")
    length = std.text.append(bytes, length, 96, key)
    length = std.text.append(bytes, length, 96, "\nwait 0\n")
    return run(app, bytes[0..length]) && app.*.dialogCount == 1
}

fn looksSection(app: *App) -> u8 {
    const found = fresh(app, 400, 300)
    if found == null { return 199 }
    const image = found.?
    _ = device.fill(layerAt(image, 0).*.device.?, image_module.bounds(image), WHITE)
    _ = device.fill(layerAt(image, 1).*.device.?, geom.rect(50, 40, 200, 120), 0xFF3060C0)
    settle(image)
    // Every dialog in a window of 800 x 600 with its buttons in it.
    if !sized(app, 800, 600) { return 200 }
    if !opened(app, "image_scale") || !fits(app, 800, 600) || !run(app, "key Escape\n") { return 201 }
    if !opened(app, "image_canvas_size") || !fits(app, 800, 600) || !run(app, "key Escape\n") { return 202 }
    if !opened(app, "image_rotate") || !fits(app, 800, 600) || !run(app, "key Escape\n") { return 203 }
    if !opened(app, "image_offset") || !fits(app, 800, 600) || !run(app, "key Escape\n") { return 204 }
    if !opened(app, "image_properties") || !fits(app, 800, 600) || !run(app, "key Escape\n") { return 205 }
    if !opened(app, "layer_scale") || !fits(app, 800, 600) || !run(app, "key Escape\n") { return 206 }
    if !opened(app, "layer_new_fill") || !fits(app, 800, 600) || !run(app, "key Escape\n") { return 207 }
    // The light theme.
    if !sized(app, 1024, 768) { return 208 }
    app.*.shell.*.lightness = 1024
    if !opened(app, "image_canvas_size") || !picture(app, "actions-light-canvas.png") || !run(app, "key Escape\n") { return 209 }
    if !opened(app, "layer_offset") || !picture(app, "actions-light-offset.png") || !run(app, "key Escape\n") { return 210 }
    app.*.shell.*.lightness = 0
    // German.
    if !run(app, "german\n") || !opened(app, "image_scale") || !picture(app, "actions-german-scale.png") || !run(app, "key Escape\n") { return 211 }
    if !opened(app, "layer_new_filter") || !picture(app, "actions-german-filter.png") || !run(app, "key Escape\n") { return 212 }
    // What came of some actions, as the window shows it.
    if !run(app, "action layer_rotate_90_cw\naction image_mirror_horizontal\n") || !picture(app, "actions-result.png") { return 213 }
    return 0
}

// ---------------------------------------------------------------------------
// A layer's geometry

fn layerGeometrySection(app: *App) -> u8 {
    const found = fresh(app, 100, 80)
    if found == null { return 214 }
    const image = found.?
    const layer = api.activeNode(app).?
    const ground = layerAt(image, 0)
    _ = device.fill(layer.*.device.?, geom.rect(10, 20, 20, 10), RED)
    put(ground, 3, 3, GREEN)
    settle(image)
    // Mirrored about the image's middle; the other layer stays.
    if !run(app, "action layer_mirror_horizontal\n") || at(layer, 89, 20) != RED || at(layer, 10, 20) != 0 || at(ground, 3, 3) != GREEN || steps(image) != 1 { return 215 }
    api.undo(app)
    if !run(app, "action layer_mirror_vertical\n") || at(layer, 10, 59) != RED || at(layer, 10, 20) != 0 { return 216 }
    api.undo(app)
    // A quarter turn about the image's middle (50, 40): (x, y) at
    // (90 - y - 1 + 10, x - 10) ... the rectangle 20 x 10 at (10, 20)
    // becomes 10 x 20 at (60, 0).
    if !run(app, "action layer_rotate_90_cw\n") || at(layer, 60, 0) != RED || at(layer, 69, 19) != RED || at(layer, 59, 0) != 0 || at(layer, 70, 0) != 0 || at(layer, 60, 20) != 0 { return 217 }
    if !run(app, "action layer_rotate_90_ccw\n") || at(layer, 10, 20) != RED || at(layer, 29, 29) != RED || at(layer, 30, 20) != 0 { return 218 }
    if !run(app, "action layer_rotate_180\n") || at(layer, 89, 59) != RED || at(layer, 70, 50) != RED || steps(image) != 3 { return 219 }
    api.undo(app)
    // Scale Layer: what it holds, from its dialog: 40 typed as the width,
    // the height follows, the nearest pixel (a sharp edge stays sharp);
    // the top left corner stays.
    if !run(app, "action layer_scale\nwait 0\n") || !fits(app, 1024, 768) || !typeInto(app, image_actions.SCALE_WIDTH, "40") || !picture(app, "actions-scale-layer.png") { return 220 }
    if !clickPart(app, image_actions.SCALE_FILTER) || !run(app, "key Home\nkey Enter\nwait 0\n") { return 234 }
    if !run(app, "key Enter\n") || app.*.dialogCount != 0 || steps(image) != 3 { return 221 }
    const scaled = device.exactBounds(layer.*.device.?)
    if scaled.x != 10 || scaled.y != 20 || scaled.width != 40 || scaled.height != 20 || at(layer, 49, 39) != RED || image.*.width != 100 { return 222 }
    api.undo(app)
    // Offset Layer: half the image's size, wrapping around its edges.
    if !run(app, "action layer_offset\nwait 0\n") || !clickPart(app, image_actions.OFFSET_HALF) || !run(app, "wait 0\nkey Enter\n") || app.*.dialogCount != 0 { return 223 }
    if at(layer, 60, 60) != RED || at(layer, 79, 69) != RED || at(layer, 10, 20) != 0 || at(ground, 3, 3) != GREEN || steps(image) != 3 { return 224 }
    api.undo(app)
    // Offset Image: every layer.
    if !run(app, "action image_offset\nwait 0\n") || !typeInto(app, image_actions.OFFSET_X, "-5") || !typeInto(app, image_actions.OFFSET_Y, "-4") || !run(app, "key Enter\n") { return 225 }
    if at(layer, 5, 16) != RED || at(ground, 98, 79) != GREEN || steps(image) != 3 { return 226 }
    api.undo(app)
    // Rotate Layer by an angle: one step, undone exactly.
    if !run(app, "action layer_rotate\nwait 0\n") || !typeIntoSlider(app, image_actions.ROTATE_ANGLE, "45") || !run(app, "key Enter\n") || steps(image) != 3 { return 227 }
    if at(layer, 50, 40) != 0 || image.*.width != 100 { return 228 }
    api.undo(app)
    if at(layer, 10, 20) != RED || device.exactBounds(layer.*.device.?).width != 20 { return 229 }
    // A locked layer is not changed, and says why.
    if !run(app, "action layer_lock\n") || !layer.*.locked { return 230 }
    const locked = steps(image)
    if image_actions.mirrorLayer(app, true) || steps(image) != locked || at(layer, 10, 20) != RED || !run(app, "expect-note locked\n") { return 231 }
    if !run(app, "action layer_lock\n") || layer.*.locked { return 232 }
    // An empty layer has nothing to scale.
    image.*.active = layerAt(image, 0)
    device.clear(ground.*.device.?)
    if image_actions.scaleLayer(app, 10, 10, transform.BOX) || run(app, "action layer_scale\n") && app.*.dialogCount != 0 { return 233 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const shots = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if shots != null {
        const bytes: [*]u8 = &shotsAt
        shotsLength = std.text.append(bytes, 0, 512, std.string.asSlice(shots.?))
    }
    const made = script.headless(std.heap.allocator())
    if made == null { return 1 }
    const app = made.?
    if !run(app, "size 1024 768\n") { return 2 }
    var failed = scaleSection(app)
    if failed != 0 { return failed }
    failed = canvasSection(app)
    if failed != 0 { return failed }
    failed = turnSection(app)
    if failed != 0 { return failed }
    failed = cropSection(app)
    if failed != 0 { return failed }
    failed = mergeSection(app)
    if failed != 0 { return failed }
    failed = duplicateSection(app)
    if failed != 0 { return failed }
    failed = groupSection(app)
    if failed != 0 { return failed }
    failed = cutSection(app)
    if failed != 0 { return failed }
    failed = layerGeometrySection(app)
    if failed != 0 { return failed }
    failed = makingSection(app)
    if failed != 0 { return failed }
    failed = propertiesSection(app)
    if failed != 0 { return failed }
    failed = everySection(app)
    if failed != 0 { return failed }
    failed = manySection(app)
    if failed != 0 { return failed }
    failed = arenaSection(app)
    if failed != 0 { return failed }
    failed = looksSection(app)
    if failed != 0 { return failed }
    return 13
}
