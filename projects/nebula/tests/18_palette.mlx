// nebula's palettes (core/palette.mlx) and the Palettize filter
// (filters/palettize.mlx): entries edited (added, inserted, removed,
// moved, recoloured, renamed with names cut in whole characters, put in
// groups that are renamed and removed, as many as there may be), copied
// and cleared; the built-in palettes made in English and German, none
// empty, their names and their entries' names and colours unique, and
// the filter's choices the same palettes and dithers in the same order;
// the nearest entry exact for every member of every built-in palette,
// a grey for mid grey, never farther (CIE76) than any other entry for
// 3000 random colours, and a Finder answering the same (also from what
// it remembers); median cut finding exactly the 5 colours of a picture
// of 5 (transparent pixels left out), evenly spread entries for a grey
// ramp, more entries where more pixels are, 16 of a picture of too many
// colours to count; quantize without a dither giving every pixel of a
// 257 x 130 picture the nearest entry's colour (all checked, alpha kept
// or made 0/255, the words beside the rows untouched), every dither
// giving palette colours only and the same each time, Floyd-Steinberg
// keeping a flat grey's mean within 2 levels on a black and white
// palette and using both, ordered dithering repeating with period 8,
// quantizeIndices agreeing with quantize, no entries, no pixels, one
// pixel; sorting by lightness and around the colour wheel, stable;
// GIMP's .gpl written and read back and a hand-typed one with a byte
// order mark, tabs, comments, line ends of two bytes, missing names and
// numbers too large, a reader starting from nothing; .aco of
// version 1 and of 1 and 2 (names in UTF-16 with a pair of surrogates),
// .ase with a group and a grey, Krita's .kpl (a ZIP built here, groups,
// grid places, entities, a Lab entry left out) and the plain list, all
// from bytes built here, and read() telling them apart; every truncation
// and 1000 random damages of each, and 500 of a .kpl's XML, read without
// a trap; the filter through filters/registry.mlx (find(311), defaults,
// margin 0, 1x1 and 257x130 with every palette, every number at its ends
// and NaN, colours from the text); 50 rounds of all of it take nothing
// of the value arena and leave the scratch pool as it was, and what the
// palettes take of the heap is given back; the built-in palettes and the
// filter's numbers, first asked for inside a turn of a loop, the same
// after the turn wrote over the value arena. Also: a palette copied onto
// itself, groups renumbered, a picture of palette colours unchanged by
// error diffusion, pictures of 1 to 199 pixels across every dither, the
// patterns anchored (blocks of 64 as the whole), strengths outside 0..1,
// flat greys near black and white and colours inside the web-safe cube
// keeping their mean, one row's diffusion worked out here (from the
// left, then from the right: serpentine), whites at the highest ranks
// of Bayer's matrix, alpha 127 and 128, Finders with and without a grid
// against nearest() for palettes of 1 to 1500 colours with repeats;
// median cut of one colour, of one pixel, a weighted mean, every grey,
// as many colours as are counted and more; .gpl and the plain list with
// '\r' line ends, .aco of no colours, cut off, Lab and CMYK, .ase of no
// blocks, 70 groups, every model, and .kpl as Krita writes it (RGB
// elements of sRGB, linear sRGB and another space, a grid wider than
// shown). Prints megapixels a second of mapping to 64 colours. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const palette = @import("../core/palette.mlx")
const color = @import("../core/color.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")
const node = @import("../core/node.mlx")
const zip = @import("../io/zip.mlx")
const filters = @import("../filters/registry.mlx")
const types = @import("../filters/types.mlx")
const palettize = @import("../filters/palettize.mlx")

const Allocator = std.allocator.Allocator
const Bytes = std.ArrayList(u8)
const Palette = palette.Palette

const SENTINEL: u32 = 0xDEADBEEF

// The picture most checks use: odd sizes, a stride wider than a row.
const WIDTH: usize = 257
const HEIGHT: usize = 130
const STRIDE: usize = 260

// A GIMP palette as people type them: a byte order mark, line ends of
// two bytes, comments, an empty line, names after tabs or blanks or
// none, a tab inside a name, numbers too large, lines that are no colour,
// no line end at the end.
const HAND_TYPED = "\u{feff}GIMP Palette\r\nName: Hand typed\r\nColumns: 4\r\n# a comment\r\n#\r\n\r\n255   0   0\tRed\r\n  0 255   0    Green  \r\n0 0 255\r\n 12 34 56\tdeep\tsea\r\n300 -1 2 junk\r\nnot a colour line\r\n128 128 128 Grey 50%\r\n999 1000 256\tclipped"

const HEX_LIST = "#ff0000 Red\n#00FF00\n; a comment\n// another\n\n0000ff   Blue sky\r\n#abc\n"

// Krita's colorset.xml as Krita 4 and 5 write it: entries out of their
// grid's order, one in Lab (not read), a group, entities.
const KPL_TEXT = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Colorset version=\"2.0\" name=\"Krita &amp; friends\" columns=\"4\" readonly=\"false\" comment=\"\" rows=\"2\">\n <ColorSetEntry name=\"Second\" id=\"2\" spot=\"false\" bitdepth=\"U8\">\n  <sRGB r=\"0\" g=\"1\" b=\"0\" space=\"sRGB-elle-V2-srgbtrc.icc\"/>\n  <Position row=\"0\" column=\"1\"/>\n </ColorSetEntry>\n <ColorSetEntry name=\"First\" id=\"1\" spot=\"false\" bitdepth=\"U8\">\n  <sRGB r=\"1\" g=\"0.5\" b=\"0.0\" space=\"sRGB-elle-V2-srgbtrc.icc\"/>\n  <Position row=\"0\" column=\"0\"/>\n </ColorSetEntry>\n <ColorSetEntry name=\"Lab one\" id=\"9\" spot=\"false\" bitdepth=\"U16\">\n  <Lab L=\"50\" a=\"0\" b=\"0\" space=\"Lab identity built-in\"/>\n  <Position row=\"0\" column=\"2\"/>\n </ColorSetEntry>\n <ColorSetEntry name=\"Next row\" id=\"3\" spot=\"true\" bitdepth=\"U16\">\n  <sRGB r=\"2.5e-1\" g=\"0.25\" b=\".25\"/>\n  <Position row=\"1\" column=\"0\"/>\n </ColorSetEntry>\n <Group name=\"Greys &lt;3\" rows=\"1\">\n  <ColorSetEntry name=\"Mid &#x47;rey\" id=\"4\" bitdepth=\"U8\">\n   <Gray g=\"0.50196\" space=\"Gray-D50-elle-V2-srgbtrc.icc\"/>\n   <Position row=\"0\" column=\"0\"/>\n  </ColorSetEntry>\n </Group>\n</Colorset>\n"

// Krita 3's: no places, the file's order.
const KPL_OLD = "<Colorset version=\"1.0\" name=\"Old\" columns=\"2\" readonly=\"false\" comment=\"\">\n<ColorSetEntry name=\"B\" spot=\"false\" bitdepth=\"U8\"><sRGB r=\"0\" g=\"0\" b=\"1\"/></ColorSetEntry>\n<ColorSetEntry name=\"A\" spot=\"false\" bitdepth=\"U8\"><sRGB r=\"1\" g=\"0\" b=\"0\"/></ColorSetEntry>\n</Colorset>"

// ---------------------------------------------------------------------------
// Helpers

fn words(count: usize) -> ?[*]u32 {
    const memory = std.heap.allocator().alloc(count * 4, 16)
    if memory == null { return null }
    unsafe { return @ptrCast([*]u32, memory.?) }
}

fn freeWords(pixels: [*]u32, count: usize) -> void {
    unsafe { std.heap.allocator().free(@ptrCast([*]u8, pixels), count * 4, 16) }
}

fn copyWords(target: [*]u32, source: [*]const u32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        target[index] = source[index]
        index += 1
    }
}

fn sameWords(a: [*]const u32, b: [*]const u32, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// A generator of its own (xorshift): the same seed, the same numbers.
fn step(state: u64) -> u64 {
    var x = state
    x ^= x << 13
    x ^= x >> 7
    x ^= x << 17
    return x
}

fn next(state: *u64) -> u32 {
    state.* = step(state.*)
    return @intCast(u32, state.* >> 32)
}

// `width` x `height` pixels of noise at `pixels` (`stride` words a row): a
// quarter fully transparent (their colour bytes left in), a quarter of
// any alpha, half opaque; SENTINEL beside the rows. (The generator's
// state is not handed by its address: a local whose address is taken is
// taken from the value arena, and the arena is measured.)
fn noise(pixels: [*]u32, width: usize, height: usize, stride: usize, seed: u64) -> void {
    var state = seed
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < stride {
            state = step(state)
            var value = @intCast(u32, state >> 32)
            if x >= width {
                value = SENTINEL
            } else if value & 3 == 0 {
                value = value & 0x00FFFFFF
            } else if value & 3 == 1 {
                value = (value & 0x00FFFFFF) | ((value >> 3) << 24)
            } else {
                value = value | 0xFF000000
            }
            pixels[y * stride + x] = value
            x += 1
        }
        y += 1
    }
}

// One colour everywhere (the stride the width).
fn flat(pixels: [*]u32, count: usize, value: u32) -> void {
    var index: usize = 0
    while index < count {
        pixels[index] = value
        index += 1
    }
}

// Piece `wanted` of a text of pieces between '|' ("" past the last).
fn piece(text: []const u8, wanted: usize) -> []const u8 {
    var at: usize = 0
    var index: usize = 0
    while at <= text.length {
        var end = at
        while end < text.length && text[end] != 124 { end += 1 }
        if index == wanted { return text[at..end] }
        index += 1
        at = end + 1
    }
    return ""
}

fn pieces(text: []const u8) -> usize {
    var total: usize = 1
    for byte in text {
        if byte == 124 { total += 1 }
    }
    return total
}

// The entries' names are the pieces of `expected`, in order.
fn namesAre(p: *const Palette, expected: []const u8) -> bool {
    if palette.count(p) != pieces(expected) { return false }
    var index: usize = 0
    while index < palette.count(p) {
        if !std.text.same(palette.nameAt(p, index), piece(expected, index)) { return false }
        index += 1
    }
    return true
}

fn samePalettes(a: *const Palette, b: *const Palette) -> bool {
    if !std.text.same(palette.name(a), palette.name(b)) || a.*.columns != b.*.columns { return false }
    if palette.count(a) != palette.count(b) || palette.groupCount(a) != palette.groupCount(b) { return false }
    var index: usize = 0
    while index < palette.count(a) {
        if palette.colorAt(a, index) != palette.colorAt(b, index) || palette.groupAt(a, index) != palette.groupAt(b, index) { return false }
        if !std.text.same(palette.nameAt(a, index), palette.nameAt(b, index)) { return false }
        index += 1
    }
    index = 1
    while index < palette.groupCount(a) {
        if !std.text.same(palette.groupName(a, index), palette.groupName(b, index)) { return false }
        index += 1
    }
    return true
}

// Entry `index` is `value` named `text` in `group`.
fn entryIs(p: *const Palette, index: usize, value: u32, text: []const u8, group: usize) -> bool {
    return palette.colorAt(p, index) == value && std.text.same(palette.nameAt(p, index), text) && palette.groupAt(p, index) == group
}

// What any palette is, whatever was read into it.
fn sane(p: *const Palette) -> bool {
    if palette.count(p) > palette.MOST || palette.groupCount(p) < 1 || palette.groupCount(p) > palette.GROUPS { return false }
    if p.*.columns < 1 || p.*.columns > palette.MOST_COLUMNS || palette.name(p).length > palette.TITLE { return false }
    var index: usize = 0
    while index < palette.count(p) {
        if palette.colorAt(p, index) >> 24 != 255 || palette.nameAt(p, index).length > palette.NAME || palette.groupAt(p, index) >= palette.groupCount(p) { return false }
        index += 1
    }
    return true
}

// The palette's colours as bits of a map of 2^24 (`on`), or taken out.
fn markColors(known: [*]u8, p: *const Palette, on: bool) -> void {
    var index: usize = 0
    while index < palette.count(p) {
        const rgb = palette.colorAt(p, index) & 0x00FFFFFF
        known[@intCast(usize, rgb >> 3)] = if on { known[@intCast(usize, rgb >> 3)] | (@intCast(u8, 1) << @intCast(u8, rgb & 7)) } else { 0 }
        index += 1
    }
}

// Every pixel of `work` has a colour of the palette marked in `known` and
// the alpha it had in `source` (`keep`; a transparent one is 0), or
// (not `keep`) is opaque where it had 128 or more and 0 where less; the
// words beside the rows are as they were.
fn inPalette(work: [*]const u32, source: [*]const u32, width: usize, height: usize, stride: usize, known: [*]const u8, keep: bool) -> bool {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < stride {
            const at = y * stride + x
            const before = source[at]
            const after = work[at]
            x += 1
            if x > width {
                if after != before { return false }
                continue
            }
            const alpha = before >> 24
            if keep {
                if alpha == 0 {
                    if after != 0 { return false }
                    continue
                }
                if after >> 24 != alpha { return false }
            } else {
                if alpha < 128 {
                    if after != 0 { return false }
                    continue
                }
                if after >> 24 != 255 { return false }
            }
            const rgb = after & 0x00FFFFFF
            if (known[@intCast(usize, rgb >> 3)] >> @intCast(u8, rgb & 7)) & 1 == 0 { return false }
        }
        y += 1
    }
    return true
}

fn put16(out: *Bytes, value: u32) -> bool {
    return out.*.append(@intCast(u8, (value >> 8) & 255)) && out.*.append(@intCast(u8, value & 255))
}

fn put32(out: *Bytes, value: u32) -> bool {
    return put16(out, value >> 16) && put16(out, value & 0xFFFF)
}

// ASCII text as UTF-16 units, the high byte first.
fn putUnits(out: *Bytes, text: []const u8) -> bool {
    for byte in text {
        if !put16(out, @intCast(u32, byte)) { return false }
    }
    return true
}

fn floatBits(value: f64) -> u32 {
    return @bitCast(u32, @floatCast(f32, value))
}

// ---------------------------------------------------------------------------
// Through the loop's turns

// The built-in palettes and the filter's numbers, first asked for inside
// a turn of a loop as the window's loop asks, are what they are after
// the turn gave the value arena back and wrote over it (poison): their
// colours worked out here (the greys 0x11 apart, the web-safe cube red
// first), their names, the filter's choices. Must run before anything
// else asks for them.
fn keptThroughTurns(allocator: Allocator) -> u8 {
    var loop: turns.Turns = undefined
    turns.begin(&loop, true, true)
    if loop.base == 0 { return 240 }
    if palette.builtins().length != palette.BUILTINS || filters.find(palettize.PALETTIZE) == null { return 240 }
    turns.turn(&loop)
    const greys = palette.builtinColors(palette.GREYS)
    if greys.length != 16 { return 241 }
    var index: usize = 0
    while index < 16 {
        if greys[index] != 0xFF000000 | (@intCast(u32, index) * 0x111111) { return 241 }
        index += 1
    }
    const web = palette.builtinColors(palette.WEB_SAFE)
    if web.length != 216 { return 241 }
    index = 0
    while index < 216 {
        const r = @intCast(u32, index / 36)
        const g = @intCast(u32, index / 6 % 6)
        const b = @intCast(u32, index % 6)
        if web[index] != 0xFF000000 | (r * 0x330000) | (g * 0x3300) | (b * 0x33) { return 241 }
        index += 1
    }
    const made = palette.create(allocator)
    if made == null { return 242 }
    const p = made.?
    if !palette.make(p, palette.PC_16, true) || !std.text.same(palette.name(p), "PC 16 Farben") || !std.text.same(palette.nameAt(p, 15), "Wei\u{df}") || palette.colorAt(p, 15) != 0xFFFFFFFF { return 242 }
    if !palette.make(p, palette.DEFAULT, false) || !std.text.same(palette.nameAt(p, 9), "Orange 2") || !std.text.same(palette.nameAt(p, 71), "Grey 8") || palette.colorAt(p, 71) != 0xFF000000 { return 242 }
    const info = filters.find(palettize.PALETTIZE)
    if info == null || !std.text.same(info.?.*.params[palettize.PALETTE].name, "Palette") || !std.text.same(piece(info.?.*.params[palettize.DITHER].choices, 1), "Floyd-Steinberg") { return 243 }
    turns.turn(&loop)
    palette.destroy(p)
    return 0
}

// ---------------------------------------------------------------------------
// Entries

fn entries(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const other = palette.create(allocator)
    if made == null || other == null { return 1 }
    const p = made.?
    const twin = other.?
    if palette.count(p) != 0 || palette.groupCount(p) != 1 || palette.name(p).length != 0 || p.*.columns != palette.COLUMNS { return 2 }
    palette.rename(p, "Mine")
    palette.setColumns(p, 0)
    if !std.text.same(palette.name(p), "Mine") || p.*.columns != 1 { return 3 }
    palette.setColumns(p, 1000)
    if p.*.columns != palette.MOST_COLUMNS { return 3 }
    palette.rename(p, "0123456789012345678901234567890123456789012345678901234567890123456789")
    if palette.name(p).length != palette.TITLE { return 3 }
    palette.rename(p, "Mine")
    if !palette.add(p, 0x00112233, "One", 0) || !palette.add(p, 0xFF445566, "Two", 0) || !palette.add(p, 0x80778899, "Three", 0) { return 4 }
    // A palette's colours are opaque, whatever alpha was given.
    if palette.colorAt(p, 0) != 0xFF112233 || palette.colorAt(p, 2) != 0xFF778899 || palette.colorAt(p, 3) != 0 || palette.nameAt(p, 3).length != 0 || palette.groupAt(p, 3) != 0 { return 5 }
    if !palette.insert(p, 0, 0xFFAABBCC, "Zero", 0) || !palette.insert(p, 4, 0xFFDDEEFF, "Four", 0) || !palette.insert(p, 2, 0xFF010203, "Mid", 0) { return 6 }
    if !namesAre(p, "Zero|One|Mid|Two|Three|Four") { return 7 }
    if palette.insert(p, 7, 0xFF000000, "Far", 0) || palette.insert(p, 0, 0xFF000000, "Nowhere", 1) || palette.count(p) != 6 { return 8 }
    if !palette.remove(p, 2) || palette.remove(p, 5) || !namesAre(p, "Zero|One|Two|Three|Four") { return 9 }
    if !palette.move(p, 0, 3) || !namesAre(p, "One|Two|Three|Zero|Four") { return 10 }
    if !palette.move(p, 4, 0) || !namesAre(p, "Four|One|Two|Three|Zero") { return 11 }
    if !palette.move(p, 1, 1) || palette.move(p, 5, 0) || palette.move(p, 0, 5) || !namesAre(p, "Four|One|Two|Three|Zero") { return 12 }
    if palette.colorAt(p, 0) != 0xFFDDEEFF || palette.colorAt(p, 4) != 0xFFAABBCC { return 13 }
    if !palette.setColor(p, 0, 0x12345678) || palette.colorAt(p, 0) != 0xFF345678 || palette.setColor(p, 5, 0) { return 14 }
    // Names: cut at 31 bytes, never inside a character; what is no text
    // is a blank.
    if !palette.setName(p, 1, "abcdefghijklmnopqrstuvwxyz0123456789") || !std.text.same(palette.nameAt(p, 1), "abcdefghijklmnopqrstuvwxyz01234") { return 15 }
    if !palette.setName(p, 1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u{fc}") || palette.nameAt(p, 1).length != 30 { return 16 }
    if !palette.setName(p, 1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u{fc}") || palette.nameAt(p, 1).length != 31 { return 16 }
    if !palette.setName(p, 2, "a\tb\nc") || !std.text.same(palette.nameAt(p, 2), "a b c") || palette.setName(p, 5, "x") { return 17 }
    // Finding a colour: its alpha does not count.
    const found = palette.find(p, 0x00345678)
    if found == null || found.? != 0 || palette.find(p, 0xFF000001) != null { return 18 }

    // Groups.
    const warm = palette.addGroup(p, "Warm")
    const cool = palette.addGroup(p, "Cool")
    if warm == null || cool == null || warm.? != 1 || cool.? != 2 || palette.groupCount(p) != 3 { return 19 }
    if !palette.setGroup(p, 0, 1) || !palette.setGroup(p, 1, 2) || !palette.setGroup(p, 2, 2) || palette.setGroup(p, 0, 3) || palette.setGroup(p, 9, 1) { return 20 }
    if palette.groupAt(p, 0) != 1 || palette.groupAt(p, 2) != 2 || palette.groupAt(p, 3) != 0 || palette.countIn(p, 2) != 2 || palette.countIn(p, 0) != 2 { return 21 }
    if !std.text.same(palette.groupName(p, 1), "Warm") || palette.groupName(p, 0).length != 0 || palette.groupName(p, 3).length != 0 { return 22 }
    if !palette.renameGroup(p, 1, "Hot") || palette.renameGroup(p, 0, "x") || palette.renameGroup(p, 3, "x") || !std.text.same(palette.groupName(p, 1), "Hot") { return 23 }
    // A group taken away: its entries in group 0, the later groups one
    // lower.
    if !palette.removeGroup(p, 1) || palette.removeGroup(p, 0) || palette.removeGroup(p, 2) { return 24 }
    if palette.groupCount(p) != 2 || palette.groupAt(p, 0) != 0 || palette.groupAt(p, 1) != 1 || palette.groupAt(p, 2) != 1 || !std.text.same(palette.groupName(p, 1), "Cool") { return 25 }
    var added: usize = 0
    while added < 100 && palette.addGroup(p, "More") != null { added += 1 }
    if palette.groupCount(p) != palette.GROUPS || added != palette.GROUPS - 2 { return 26 }

    if !palette.copy(twin, p) || !samePalettes(twin, p) { return 27 }
    palette.clear(p)
    if palette.count(p) != 0 || palette.groupCount(p) != 1 || !std.text.same(palette.name(p), "Mine") || palette.colorAt(p, 0) != 0 { return 28 }
    // As many entries as there may be, and no more.
    var index: usize = 0
    while index < palette.MOST {
        if !palette.add(p, @intCast(u32, index), "", 0) { return 29 }
        index += 1
    }
    if palette.add(p, 0, "", 0) || palette.insert(p, 0, 0, "", 0) || palette.count(p) != palette.MOST || palette.colorAt(p, palette.MOST - 1) != 0xFF00FFFE { return 29 }
    palette.destroy(p)
    palette.destroy(twin)
    return 0
}

// A palette copied onto itself, groups renumbered after a removal (each
// entry's group worked out here), a palette's name cut in whole
// characters with what is no text made blanks.
fn moreEntries(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    if made == null { return 61 }
    const p = made.?
    if !palette.make(p, palette.DEFAULT, false) || palette.addGroup(p, "G") == null || !palette.setGroup(p, 3, 1) { return 61 }
    const before = palette.count(p)
    if !palette.copy(p, p) || palette.count(p) != before || palette.groupCount(p) != 2 || palette.groupAt(p, 3) != 1 || !std.text.same(palette.name(p), "Default") { return 61 }
    palette.clear(p)
    var group: usize = 1
    while group <= 5 {
        if palette.addGroup(p, "g") == null { return 62 }
        group += 1
    }
    var index: usize = 0
    while index < 12 {
        if !palette.add(p, @intCast(u32, index), "", index % 6) { return 62 }
        index += 1
    }
    if !palette.removeGroup(p, 2) || palette.groupCount(p) != 5 { return 62 }
    index = 0
    while index < 12 {
        const was = index % 6
        const now: usize = if was == 2 { 0 } else if was > 2 { was - 1 } else { was }
        if palette.groupAt(p, index) != now { return 62 }
        index += 1
    }
    // 62 bytes of "a" and an "ü": the "ü" does not fit 63 bytes whole.
    palette.rename(p, "\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u{fc}")
    if palette.name(p).length != 62 || palette.name(p)[0] != 32 || palette.name(p)[61] != 97 { return 63 }
    palette.rename(p, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u{fc}")
    if palette.name(p).length != 63 { return 63 }
    palette.destroy(p)
    return 0
}

// ---------------------------------------------------------------------------
// The built-in palettes

fn builtins(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    if made == null { return 30 }
    const p = made.?
    var which: usize = 0
    while which < palette.BUILTINS {
        var language: usize = 0
        while language < 2 {
            const german = language == 1
            if !palette.make(p, which, german) || palette.count(p) == 0 { return 31 }
            if palette.name(p).length == 0 || !std.text.same(palette.name(p), palette.builtinName(which, german)) { return 32 }
            var before: usize = 0
            while before < which {
                if std.text.same(palette.builtinName(before, german), palette.builtinName(which, german)) { return 33 }
                before += 1
            }
            var index: usize = 0
            while index < palette.count(p) {
                if palette.nameAt(p, index).length == 0 || palette.colorAt(p, index) >> 24 != 255 || palette.groupAt(p, index) != 0 { return 34 }
                before = 0
                while before < index {
                    if palette.colorAt(p, before) == palette.colorAt(p, index) || std.text.same(palette.nameAt(p, before), palette.nameAt(p, index)) { return 35 }
                    before += 1
                }
                index += 1
            }
            const colors = palette.builtinColors(which)
            if colors.length != palette.count(p) { return 36 }
            index = 0
            while index < colors.length {
                if colors[index] != palette.colorAt(p, index) { return 36 }
                index += 1
            }
            language += 1
        }
        which += 1
    }
    if palette.make(p, palette.BUILTINS, false) || palette.count(p) != 0 || palette.builtinName(palette.BUILTINS, false).length != 0 || palette.builtinColors(palette.BUILTINS).length != 0 { return 37 }
    // The sizes asked for.
    if palette.builtinColors(palette.GREYS).length != 16 || palette.builtinColors(palette.WEB_SAFE).length != 216 || palette.builtinColors(palette.PC_16).length != 16 { return 38 }
    if palette.builtinColors(palette.HANDHELD_4).length != 4 || palette.builtinColors(palette.CONSOLE_16).length != 16 { return 38 }
    if palette.builtinColors(palette.SKIN_TONES).length < 12 || palette.builtinColors(palette.PASTEL).length < 12 || palette.builtinColors(palette.MATERIAL).length < 40 { return 38 }
    const painter = palette.builtinColors(palette.DEFAULT).length
    if painter < 56 || painter > 80 { return 38 }

    // The filter's choices are these palettes and these dithers, in this
    // order.
    const info = filters.find(palettize.PALETTIZE)
    if info == null || info.?.*.params.length != 5 { return 39 }
    const choice = info.?.*.params[palettize.PALETTE]
    const dither = info.?.*.params[palettize.DITHER]
    if pieces(choice.choices) != palette.BUILTINS + 1 || pieces(choice.choicesGerman) != palette.BUILTINS + 1 || choice.high != @floatFromInt(f64, palette.BUILTINS) { return 39 }
    which = 0
    while which < palette.BUILTINS {
        if !std.text.same(piece(choice.choices, which), palette.builtinName(which, false)) || !std.text.same(piece(choice.choicesGerman, which), palette.builtinName(which, true)) { return 39 }
        which += 1
    }
    if pieces(dither.choices) != @intCast(usize, palette.DITHERS) || pieces(dither.choicesGerman) != @intCast(usize, palette.DITHERS) || dither.high != @floatFromInt(f64, palette.DITHERS - 1) { return 39 }
    var method: u8 = 0
    while method < palette.DITHERS {
        if !std.text.same(piece(dither.choices, @intCast(usize, method)), palette.ditherName(method, false)) || !std.text.same(piece(dither.choicesGerman, @intCast(usize, method)), palette.ditherName(method, true)) { return 39 }
        method += 1
    }
    if palette.ditherName(palette.DITHERS, false).length != 0 { return 39 }
    palette.destroy(p)
    return 0
}

// ---------------------------------------------------------------------------
// The nearest entry

fn nearestColors(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    if made == null { return 40 }
    const p = made.?
    // Each member of each built-in palette is its own nearest.
    var which: usize = 0
    while which < palette.BUILTINS {
        if !palette.make(p, which, false) { return 40 }
        var index: usize = 0
        while index < palette.count(p) {
            const near = palette.nearest(p, palette.colorAt(p, index))
            if near == null || near.? != index { return 41 }
            index += 1
        }
        which += 1
    }
    // Mid grey is nearest to a grey.
    if !palette.make(p, palette.DEFAULT, false) { return 42 }
    const grey = palette.nearest(p, 0xFF808080)
    if grey == null { return 42 }
    const value = palette.colorAt(p, grey.?)
    if pixel.red(value) != pixel.green(value) || pixel.green(value) != pixel.blue(value) || color.deltaE76(value, 0xFF808080) > 8.0 { return 42 }
    palette.clear(p)
    if !palette.add(p, 0xFFFF0000, "", 0) || !palette.add(p, 0xFF00FF00, "", 0) || !palette.add(p, 0xFF0000FF, "", 0) || !palette.add(p, 0xFF777777, "", 0) || !palette.add(p, 0xFFFFFFFF, "", 0) { return 43 }
    const middle = palette.nearest(p, 0xFF808080)
    const reddish = palette.nearest(p, 0x10F01010)
    if middle == null || middle.? != 3 || reddish == null || reddish.? != 0 { return 43 }

    // No entry is nearer (CIE76, as color.mlx has it) than the one found,
    // and a Finder says the same, also when asked again.
    if !palette.make(p, palette.DEFAULT, false) { return 44 }
    const pool = scratch.common()
    const mark = scratch.mark(pool)
    const finder = palette.finder(pool, p, 3000)
    if finder == null { return 44 }
    var round: usize = 0
    while round < 2 {
        var state: u64 = 4242
        var asked: usize = 0
        while asked < 3000 {
            const asking = next(&state)
            const near = palette.nearest(p, asking)
            if near == null { return 45 }
            const best = color.deltaE76(asking, palette.colorAt(p, near.?))
            var index: usize = 0
            while index < palette.count(p) {
                if color.deltaE76(asking, palette.colorAt(p, index)) < best - 1.0e-9 { return 45 }
                index += 1
            }
            const place = palette.nearestOf(finder.?, asking)
            if place != near.? || palette.colorOf(finder.?, place) != palette.colorAt(p, place) & 0x00FFFFFF { return 46 }
            asked += 1
        }
        round += 1
    }
    scratch.release(pool, mark)
    // A Finder of a plain list.
    const list = palette.finderOfColors(pool, palette.builtinColors(palette.PC_16), 16)
    if list == null || palette.nearestOf(list.?, 0xFF0000AB) != 1 || palette.nearestOf(list.?, 0xFFFFFF50) != 14 { return 47 }
    scratch.release(pool, mark)
    palette.clear(p)
    if palette.nearest(p, 0xFF808080) != null || palette.finder(pool, p, 10) != null { return 48 }
    scratch.release(pool, mark)
    palette.destroy(p)
    return 0
}

// ---------------------------------------------------------------------------
// Median cut

const FIVE = [5]u32{ 0xFF102030, 0xFFF0E0D0, 0xFF808080, 0xFF00FF00, 0xFFFF0000 }

fn medianCut(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const memory = words(512 * 512)
    if made == null || memory == null { return 50 }
    const p = made.?
    const pixels = memory.?
    // Five colours, often and seldom, one of them half there, and two
    // more fully transparent (not looked at).
    var state: u64 = 5
    var index: usize = 0
    while index < 5000 {
        const pick = next(&state) % 10
        var value = FIVE[0]
        if pick == 4 {
            value = FIVE[1]
        } else if pick == 5 || pick == 6 {
            value = FIVE[2]
        } else if pick == 7 {
            value = FIVE[3]
        } else if pick == 8 {
            value = 0x80FF0000
        } else if pick == 9 {
            value = if index & 1 == 0 { 0x000000FF } else { 0x00FFFF00 }
        }
        pixels[index] = value
        index += 1
    }
    pixels[0] = FIVE[1]
    pixels[1] = FIVE[3]
    pixels[2] = 0x80FF0000
    palette.rename(p, "Kept")
    var wanted: usize = 5
    while wanted <= 9 {
        if !palette.fromPixels(p, pixels, 5000, wanted) || palette.count(p) != 5 { return 51 }
        index = 0
        while index < 5 {
            if palette.find(p, FIVE[index]) == null { return 52 }
            index += 1
        }
        // Dark to light.
        index = 1
        while index < 5 {
            var l0: f64 = 0.0
            var l1: f64 = 0.0
            var a: f64 = 0.0
            var b: f64 = 0.0
            color.toLab(palette.colorAt(p, index - 1), &l0, &a, &b)
            color.toLab(palette.colorAt(p, index), &l1, &a, &b)
            if l0 > l1 { return 53 }
            index += 1
        }
        wanted += 4
    }
    if !std.text.same(palette.name(p), "Kept") { return 54 }
    if !palette.fromPixels(p, pixels, 5000, 100000) || palette.count(p) != 5 { return 55 }
    if !palette.fromPixels(p, pixels, 5000, 0) || palette.count(p) != 0 { return 56 }
    if !palette.fromPixels(p, pixels, 0, 8) || palette.count(p) != 0 { return 56 }
    flat(pixels, 100, 0x00FFFFFF)
    if !palette.fromPixels(p, pixels, 100, 8) || palette.count(p) != 0 { return 56 }

    // A grey ramp, every level as often: eight entries at even steps.
    index = 0
    while index < 1024 {
        pixels[index] = pixel.gray(@intCast(u32, index / 4))
        index += 1
    }
    if !palette.fromPixels(p, pixels, 1024, 8) || palette.count(p) != 8 { return 57 }
    index = 0
    while index < 8 {
        const entry = palette.colorAt(p, index)
        const expected = @intCast(i32, index * 32 + 16)
        const level = @intCast(i32, pixel.red(entry))
        if pixel.green(entry) != pixel.red(entry) || pixel.blue(entry) != pixel.red(entry) || level < expected - 2 || level > expected + 2 { return 58 }
        index += 1
    }
    // Weighed by how often a colour is there: dark and light greys as
    // often give as many dark entries as light ones; nine of ten pixels
    // dark give more dark entries.
    var share: usize = 1
    while share <= 9 {
        index = 0
        while index < 1000 {
            const level = if index < 100 * share { index % 100 } else { 156 + index % 100 }
            pixels[index] = pixel.gray(@intCast(u32, level))
            index += 1
        }
        const count = if share == 1 { 200 } else { 1000 }
        if !palette.fromPixels(p, pixels, count, 10) || palette.count(p) != 10 { return 59 }
        var dark: usize = 0
        index = 0
        while index < 10 {
            if pixel.red(palette.colorAt(p, index)) < 128 { dark += 1 }
            index += 1
        }
        if (share == 1 && dark != 5) || (share == 9 && dark < 6) { return 59 }
        share += 8
    }
    // More colours than can be counted one by one.
    noise(pixels, 512, 512, 512, 77)
    if !palette.fromPixels(p, pixels, 512 * 512, 16) || palette.count(p) != 16 || !sane(p) { return 60 }
    index = 0
    while index < 16 {
        if palette.find(p, palette.colorAt(p, index)).? != index { return 60 }
        index += 1
    }
    palette.destroy(p)
    freeWords(pixels, 512 * 512)
    return 0
}

// Median cut at its edges: one colour, one pixel, two colours into one
// (their weighted mean), every grey wanted (all of them, in order), and
// as many colours as are counted one by one and one more (cells): the
// cuts are along whole levels, so every box has a colour of its own and
// as many entries come out as were wanted.
fn moreCuts(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const memory = words(70000)
    if made == null || memory == null { return 167 }
    const p = made.?
    const pixels = memory.?
    flat(pixels, 1000, 0xFF123456)
    if !palette.fromPixels(p, pixels, 1000, 16) || palette.count(p) != 1 || palette.colorAt(p, 0) != 0xFF123456 { return 167 }
    if !palette.fromPixels(p, pixels, 1, 1) || palette.count(p) != 1 || palette.colorAt(p, 0) != 0xFF123456 { return 168 }
    // Three black to one white: 255 / 4 = 63.75.
    flat(pixels, 3, 0xFF000000)
    pixels[3] = 0xFFFFFFFF
    if !palette.fromPixels(p, pixels, 4, 1) || palette.count(p) != 1 || palette.colorAt(p, 0) != 0xFF404040 { return 169 }
    var index: usize = 0
    while index < 256 {
        pixels[index] = pixel.gray(@intCast(u32, 255 - index))
        index += 1
    }
    if !palette.fromPixels(p, pixels, 256, 256) || palette.count(p) != 256 { return 170 }
    index = 0
    while index < 256 {
        if palette.colorAt(p, index) != pixel.gray(@intCast(u32, index)) { return 170 }
        index += 1
    }
    // 65536 different colours (a step of 255 through the cube), and 70000
    // of noise (more than 65536 different ones).
    index = 0
    while index < 65536 {
        pixels[index] = 0xFF000000 | @intCast(u32, index * 255)
        index += 1
    }
    if !palette.fromPixels(p, pixels, 65536, 5000) || palette.count(p) != palette.FROM_PIXELS_MOST || !sane(p) { return 171 }
    var state: u64 = 171
    index = 0
    while index < 70000 {
        pixels[index] = next(&state) | 0xFF000000
        index += 1
    }
    if !palette.fromPixels(p, pixels, 70000, palette.FROM_PIXELS_MOST) || palette.count(p) != palette.FROM_PIXELS_MOST || !sane(p) { return 172 }
    index = 1
    while index < palette.count(p) {
        if palette.find(p, palette.colorAt(p, index)).? != index { return 172 }
        index += 1
    }
    palette.destroy(p)
    freeWords(pixels, 70000)
    return 0
}

// ---------------------------------------------------------------------------
// Reducing pictures

fn quantizing(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const bw_made = palette.create(allocator)
    const source_memory = words(STRIDE * HEIGHT)
    const work_memory = words(STRIDE * HEIGHT)
    const plain_memory = words(STRIDE * HEIGHT)
    const index_memory = allocator.alloc(WIDTH * HEIGHT, 16)
    const known_memory = allocator.alloc(2097152, 16)
    if made == null || bw_made == null || source_memory == null || work_memory == null || plain_memory == null || index_memory == null || known_memory == null { return 70 }
    const p = made.?
    const bw = bw_made.?
    const source = source_memory.?
    const work = work_memory.?
    const plain = plain_memory.?
    const indices = index_memory.?
    const known = known_memory.?
    const total = STRIDE * HEIGHT
    if !palette.make(p, palette.DEFAULT, false) { return 70 }
    noise(source, WIDTH, HEIGHT, STRIDE, 18)

    // Without a dither every pixel is the nearest entry's colour, checked
    // one by one, at its own alpha (a transparent one 0) or opaque at
    // 128; the words beside the rows stay.
    var keep: usize = 0
    while keep < 2 {
        copyWords(work, source, total)
        if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, palette.NONE, 1.0, keep == 1) { return 71 }
        var y: usize = 0
        while y < HEIGHT {
            var x: usize = 0
            while x < STRIDE {
                const at = y * STRIDE + x
                const before = source[at]
                if x >= WIDTH {
                    if work[at] != SENTINEL { return 72 }
                } else {
                    var expected: u32 = 0
                    const alpha = before >> 24
                    const near = palette.colorAt(p, palette.nearest(p, before).?) & 0x00FFFFFF
                    if keep == 1 && alpha != 0 { expected = (alpha << 24) | near }
                    if keep == 0 && alpha >= 128 { expected = 0xFF000000 | near }
                    if work[at] != expected { return 73 }
                }
                x += 1
            }
            y += 1
        }
        keep += 1
    }
    copyWords(plain, work, total)
    // Strength 0 is no dither, and a dither not known is none.
    copyWords(work, source, total)
    if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, palette.FLOYD_STEINBERG, 0.0, true) || !sameWords(work, plain, total) { return 74 }
    copyWords(work, source, total)
    if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, 200, 1.0, true) || !sameWords(work, plain, total) { return 75 }
    // NaN as strength is all of it.
    copyWords(plain, source, total)
    copyWords(work, source, total)
    if !palette.quantize(plain, WIDTH, HEIGHT, STRIDE, p, palette.FLOYD_STEINBERG, 1.0, true) || !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, palette.FLOYD_STEINBERG, math.nan(), true) || !sameWords(work, plain, total) { return 76 }

    // Every dither: colours of the palette only, the alpha as it was, the
    // same each time; and quantizeIndices names the same entries.
    var index: usize = 0
    while index < 2097152 {
        known[index] = 0
        index += 1
    }
    markColors(known, p, true)
    var method: u8 = 0
    while method < palette.DITHERS {
        copyWords(work, source, total)
        copyWords(plain, source, total)
        if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, method, 0.8, true) || !palette.quantize(plain, WIDTH, HEIGHT, STRIDE, p, method, 0.8, true) { return 77 }
        if !inPalette(work, source, WIDTH, HEIGHT, STRIDE, known, true) || !sameWords(work, plain, total) { return 78 }
        copyWords(work, source, total)
        if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, method, 0.8, false) || !inPalette(work, source, WIDTH, HEIGHT, STRIDE, known, false) { return 79 }
        if !palette.quantizeIndices(source, WIDTH, HEIGHT, STRIDE, p, method, 0.8, 255, indices) { return 80 }
        var y: usize = 0
        while y < HEIGHT {
            var x: usize = 0
            while x < WIDTH {
                const place = @intCast(usize, indices[y * WIDTH + x])
                const got = work[y * STRIDE + x]
                if place == 255 {
                    if got != 0 { return 81 }
                } else if got != palette.colorAt(p, place) {
                    return 81
                }
                x += 1
            }
            y += 1
        }
        method += 1
    }
    markColors(known, p, false)
    // A plain list of colours does what the palette of them does.
    copyWords(work, source, total)
    copyWords(plain, source, total)
    if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, palette.ORDERED_BAYER_8, 1.0, true) || !palette.quantizeColors(plain, WIDTH, HEIGHT, STRIDE, palette.builtinColors(palette.DEFAULT), palette.ORDERED_BAYER_8, 1.0, true) || !sameWords(work, plain, total) { return 82 }

    // Edges: no entries, no pixels, one pixel, too many entries to index.
    copyWords(work, source, total)
    if palette.quantize(work, WIDTH, HEIGHT, STRIDE, bw, palette.NONE, 1.0, true) || palette.quantizeIndices(source, WIDTH, HEIGHT, STRIDE, bw, palette.NONE, 1.0, 0, indices) || !sameWords(work, source, total) { return 83 }
    if !palette.quantize(work, 0, 0, STRIDE, p, palette.FLOYD_STEINBERG, 1.0, true) || !palette.quantize(work, WIDTH, 0, STRIDE, p, palette.ATKINSON, 1.0, true) || !sameWords(work, source, total) { return 84 }
    work[0] = 0xFF7F7F7F
    work[1] = SENTINEL
    if !palette.quantize(work, 1, 1, 1, p, palette.FLOYD_STEINBERG, 1.0, true) || palette.find(p, work[0]) == null || work[0] >> 24 != 255 || work[1] != SENTINEL { return 85 }
    if !palette.make(bw, palette.WEB_SAFE, false) || !palette.quantizeIndices(source, WIDTH, HEIGHT, STRIDE, bw, palette.NONE, 1.0, 0, indices) { return 86 }
    index = 0
    while index < 100 {
        if !palette.add(bw, 0xFF000001 + @intCast(u32, index), "", 0) { return 86 }
        index += 1
    }
    if palette.quantizeIndices(source, WIDTH, HEIGHT, STRIDE, bw, palette.NONE, 1.0, 0, indices) { return 86 }

    // Floyd-Steinberg on a flat grey with black and white: the mean stays
    // within 2 levels and both are used.
    palette.clear(bw)
    if !palette.add(bw, 0xFF000000, "Black", 0) || !palette.add(bw, 0xFFFFFFFF, "White", 0) { return 87 }
    var level: u32 = 32
    while level < 255 {
        flat(work, 64 * 64, pixel.gray(level))
        if !palette.quantize(work, 64, 64, 64, bw, palette.FLOYD_STEINBERG, 1.0, true) { return 87 }
        var sum: u32 = 0
        var lit: u32 = 0
        index = 0
        while index < 64 * 64 {
            if work[index] != 0xFF000000 && work[index] != 0xFFFFFFFF { return 88 }
            if work[index] == 0xFFFFFFFF { lit += 1 }
            sum += pixel.red(work[index])
            index += 1
        }
        const mean = (sum + 2048) / 4096
        if mean + 2 < level || mean > level + 2 || lit == 0 || lit == 4096 { return 89 }
        level += 32
    }
    // Atkinson: black and white only, both used.
    flat(work, 64 * 64, pixel.gray(128))
    if !palette.quantize(work, 64, 64, 64, bw, palette.ATKINSON, 1.0, true) { return 90 }
    var blacks: usize = 0
    index = 0
    while index < 64 * 64 {
        if work[index] != 0xFF000000 && work[index] != 0xFFFFFFFF { return 90 }
        if work[index] == 0xFF000000 { blacks += 1 }
        index += 1
    }
    if blacks == 0 || blacks == 4096 { return 90 }

    // Ordered dithering: the same each time, repeating every 8 pixels both
    // ways, anchored at the buffer's first pixel, both colours used.
    flat(work, 64 * 48, pixel.gray(100))
    flat(plain, 64 * 48, pixel.gray(100))
    if !palette.quantize(work, 64, 48, 64, bw, palette.ORDERED_BAYER_8, 1.0, true) || !palette.quantize(plain, 64, 48, 64, bw, palette.ORDERED_BAYER_8, 1.0, true) || !sameWords(work, plain, 64 * 48) { return 91 }
    var whites: usize = 0
    var y: usize = 0
    while y < 48 {
        var x: usize = 0
        while x < 64 {
            const here = work[y * 64 + x]
            if here == 0xFFFFFFFF { whites += 1 }
            if x + 8 < 64 && work[y * 64 + x + 8] != here { return 92 }
            if y + 8 < 48 && work[(y + 8) * 64 + x] != here { return 92 }
            x += 1
        }
        y += 1
    }
    if whites == 0 || whites == 64 * 48 { return 93 }
    // A smaller pattern repeats sooner.
    flat(work, 64 * 48, pixel.gray(100))
    if !palette.quantize(work, 64, 48, 64, bw, palette.ORDERED_BAYER_2, 1.0, true) { return 94 }
    y = 0
    while y < 46 {
        var x: usize = 0
        while x < 62 {
            if work[y * 64 + x + 2] != work[y * 64 + x] || work[(y + 2) * 64 + x] != work[y * 64 + x] { return 94 }
            x += 1
        }
        y += 1
    }

    palette.destroy(p)
    palette.destroy(bw)
    freeWords(source, total)
    freeWords(work, total)
    freeWords(plain, total)
    allocator.free(indices, WIDTH * HEIGHT, 16)
    allocator.free(known, 2097152, 16)
    return 0
}

// The mean of channel `shift` (0 blue, 8 green, 16 red) of `count` pixels,
// in tenths of a level.
fn meanTenths(pixels: [*]const u32, count: usize, shift: u32) -> u32 {
    var sum: u32 = 0
    var index: usize = 0
    while index < count {
        sum += (pixels[index] >> shift) & 255
        index += 1
    }
    return @intCast(u32, @intCast(usize, sum) * 10 / count)
}

fn moreQuantizing(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const source_memory = words(STRIDE * HEIGHT)
    const work_memory = words(STRIDE * HEIGHT)
    const other_memory = words(STRIDE * HEIGHT)
    const index_memory = allocator.alloc(WIDTH * HEIGHT, 16)
    if made == null || source_memory == null || work_memory == null || other_memory == null || index_memory == null { return 225 }
    const p = made.?
    const source = source_memory.?
    const work = work_memory.?
    const other = other_memory.?
    const indices = index_memory.?
    const total = STRIDE * HEIGHT

    // A picture of the palette's own colours at any alpha comes out of a
    // diffusing dither as it went in: no pixel has an error to hand on.
    var state: u64 = 225
    var which: usize = 0
    while which < palette.BUILTINS {
        if !palette.make(p, which, false) { return 225 }
        var index: usize = 0
        while index < total {
            const entry = palette.colorAt(p, @intCast(usize, next(&state)) % palette.count(p))
            source[index] = (entry & 0x00FFFFFF) | ((next(&state) | 0x01000000) & 0xFF000000)
            work[index] = source[index]
            other[index] = source[index]
            index += 1
        }
        if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, palette.FLOYD_STEINBERG, 1.0, true) || !palette.quantize(other, WIDTH, HEIGHT, STRIDE, p, palette.ATKINSON, 1.0, true) { return 225 }
        if !sameWords(work, source, total) || !sameWords(other, source, total) { return 225 }
        which += 1
    }

    // Narrow and short pictures around a tile's 64, every dither and one
    // not known, alpha kept and not: palette colours only (or 0), the word
    // after each row untouched.
    if !palette.make(p, palette.PC_16, false) { return 226 }
    const widths = [9]usize{ 1, 2, 3, 7, 63, 64, 65, 129, 199 }
    var shape: usize = 0
    while shape < 9 {
        const width = widths[shape]
        var height: usize = 1
        while height <= 3 {
            var method: u8 = 0
            while method <= palette.DITHERS {
                var keep: usize = 0
                while keep < 2 {
                    var index: usize = 0
                    while index < (width + 1) * height {
                        work[index] = if index % (width + 1) == width { SENTINEL } else { next(&state) }
                        index += 1
                    }
                    if !palette.quantize(work, width, height, width + 1, p, method, 1.0, keep == 1) { return 226 }
                    index = 0
                    while index < (width + 1) * height {
                        if index % (width + 1) == width {
                            if work[index] != SENTINEL { return 227 }
                        } else if work[index] != 0 && palette.find(p, work[index]) == null {
                            return 228
                        }
                        index += 1
                    }
                    keep += 1
                }
                method += 1
            }
            height += 1
        }
        shape += 1
    }

    // The patterns are anchored at the buffer's first pixel and repeat
    // every 8: blocks of 64 come out as the whole picture does.
    if !palette.make(p, palette.WEB_SAFE, false) { return 229 }
    const patterns = [5]u8{ palette.ORDERED_BAYER_8, palette.ORDERED_BAYER_4, palette.ORDERED_BAYER_2, palette.HALFTONE, palette.LINES }
    var pattern: usize = 0
    while pattern < 5 {
        noise(work, WIDTH, HEIGHT, STRIDE, 229 + @intCast(u64, pattern))
        copyWords(other, work, total)
        if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, patterns[pattern], 0.7, false) { return 229 }
        var top: usize = 0
        while top < HEIGHT {
            var left: usize = 0
            while left < WIDTH {
                const w = if WIDTH - left < 64 { WIDTH - left } else { 64 }
                const h = if HEIGHT - top < 64 { HEIGHT - top } else { 64 }
                if !palette.quantize(other + top * STRIDE + left, w, h, STRIDE, p, patterns[pattern], 0.7, false) { return 229 }
                left += 64
            }
            top += 64
        }
        if !sameWords(work, other, total) { return 229 }
        pattern += 1
    }

    // A strength above 1 (or infinite) is 1, below 0 is no dither.
    if !palette.make(p, palette.DEFAULT, false) { return 230 }
    noise(source, WIDTH, HEIGHT, STRIDE, 230)
    var method: u8 = 0
    while method < palette.DITHERS {
        var trial: usize = 0
        while trial < 3 {
            const high = if trial == 0 { 5.0 } else if trial == 1 { math.infinity() } else { 1.0e300 }
            const low = if trial == 0 { -3.0 } else if trial == 1 { 0.0 - math.infinity() } else { -1.0e-300 }
            copyWords(work, source, total)
            copyWords(other, source, total)
            if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, method, high, true) || !palette.quantize(other, WIDTH, HEIGHT, STRIDE, p, method, 1.0, true) || !sameWords(work, other, total) { return 230 }
            copyWords(work, source, total)
            copyWords(other, source, total)
            if !palette.quantize(work, WIDTH, HEIGHT, STRIDE, p, method, low, true) || !palette.quantize(other, WIDTH, HEIGHT, STRIDE, p, palette.NONE, 1.0, true) || !sameWords(work, other, total) { return 231 }
            trial += 1
        }
        method += 1
    }

    // Floyd-Steinberg keeps a flat area's mean where the palette can mix
    // it: greys near the ends with black and white (within 2 levels), and
    // colours inside the web-safe cube, each channel.
    palette.clear(p)
    if !palette.add(p, 0xFF000000, "", 0) || !palette.add(p, 0xFFFFFFFF, "", 0) { return 232 }
    const levels = [6]u32{ 1, 3, 8, 128, 247, 254 }
    var level: usize = 0
    while level < 6 {
        flat(work, 128 * 128, pixel.gray(levels[level]))
        if !palette.quantize(work, 128, 128, 128, p, palette.FLOYD_STEINBERG, 1.0, true) { return 232 }
        const mean = meanTenths(work, 128 * 128, 0)
        if mean + 20 < levels[level] * 10 || mean > levels[level] * 10 + 20 { return 232 }
        level += 1
    }
    if !palette.make(p, palette.WEB_SAFE, false) { return 233 }
    const colours = [4]u32{ 0xFF20A0E0, 0xFF0A0A0A, 0xFFF5F5F0, 0xFF808070 }
    var colour: usize = 0
    while colour < 4 {
        flat(work, 128 * 128, colours[colour])
        if !palette.quantize(work, 128, 128, 128, p, palette.FLOYD_STEINBERG, 1.0, true) { return 233 }
        var shift: u32 = 0
        while shift <= 16 {
            const mean = meanTenths(work, 128 * 128, shift)
            const wanted = ((colours[colour] >> shift) & 255) * 10
            if mean + 20 < wanted || mean > wanted + 20 { return 233 }
            shift += 8
        }
        colour += 1
    }

    // Half there: alpha 128 is a colour, 127 is transparent, for indices
    // and for pixels made opaque; with alpha kept 1 is a colour.
    flat(work, 4, 0x7F336699)
    work[1] = 0x80336699
    work[2] = 0x01336699
    work[3] = 0x00336699
    if !palette.quantizeIndices(work, 4, 1, 4, p, palette.NONE, 1.0, 250, indices) { return 234 }
    const place = palette.nearest(p, 0xFF336699).?
    if indices[0] != 250 || @intCast(usize, indices[1]) != place || indices[2] != 250 || indices[3] != 250 { return 234 }
    copyWords(other, work, 4)
    if !palette.quantize(other, 4, 1, 4, p, palette.NONE, 1.0, false) || other[0] != 0 || other[1] != 0xFF336699 || other[2] != 0 || other[3] != 0 { return 234 }
    if !palette.quantize(work, 4, 1, 4, p, palette.NONE, 1.0, true) || work[0] != 0x7F336699 || work[1] != 0x80336699 || work[2] != 0x01336699 || work[3] != 0 { return 234 }

    // Error diffusion along one row worked out here, in sixteenths of a
    // level as palette.mlx keeps them: a grey of 100 on black and white,
    // the first row from the left (Floyd-Steinberg hands 7/16 on, Atkinson
    // 1/8 to each of the next two), the second from the right (the scan
    // is serpentine) under a first row of black, which has no error.
    palette.clear(p)
    if !palette.add(p, 0xFF000000, "", 0) || !palette.add(p, 0xFFFFFFFF, "", 0) { return 236 }
    var diffuser: usize = 0
    while diffuser < 3 {
        flat(work, 74, pixel.gray(100))
        if diffuser == 2 { flat(work, 37, 0xFF000000) }
        const method = if diffuser == 1 { palette.ATKINSON } else { palette.FLOYD_STEINBERG }
        if !palette.quantize(work, 37, if diffuser == 2 { 2 } else { 1 }, 37, p, method, 1.0, true) { return 236 }
        const row = if diffuser == 2 { work + 37 } else { work }
        var carry: i32 = 0
        var carry2: i32 = 0
        var done: usize = 0
        while done < 37 {
            const x = if diffuser == 2 { 36 - done } else { done }
            const want = 1600 + carry
            const chosen = palette.colorAt(p, palette.nearest(p, pixel.gray(pixel.clamp((want + 8) >> 4))).?)
            if row[x] != chosen { return 236 }
            const e = want - @intCast(i32, pixel.red(chosen)) * 16
            if diffuser == 1 {
                carry = carry2 + (e >> 3)
                carry2 = e >> 3
            } else {
                carry = (e * 7) >> 4
            }
            done += 1
        }
        diffuser += 1
    }

    // Bayer's patterns on flat greys with black and white: in each cell
    // the white pixels are those of the highest ranks of Bayer's matrix,
    // built here the textbook way (M of 2n = 4 M of n + the 2 x 2 matrix
    // [0 2; 3 1] of the quarter), its rank 0 at the buffer's first pixel.
    const greys = [4]u32{ 40, 100, 160, 220 }
    var size_bits: usize = 1
    while size_bits <= 3 {
        const method = if size_bits == 3 { palette.ORDERED_BAYER_8 } else if size_bits == 2 { palette.ORDERED_BAYER_4 } else { palette.ORDERED_BAYER_2 }
        var grey: usize = 0
        while grey < 4 {
            flat(work, 16 * 16, pixel.gray(greys[grey]))
            if !palette.quantize(work, 16, 16, 16, p, method, 1.0, true) { return 237 }
            var darkest_white: usize = 64
            var lightest_black: usize = 0
            var blacks: usize = 0
            var index: usize = 0
            const side: usize = if size_bits == 3 { 8 } else if size_bits == 2 { 4 } else { 2 }
            while index < 256 {
                var x = (index & 15) & (side - 1)
                var y = (index >> 4) & (side - 1)
                // The quarter at each level, the largest first, is the
                // rank's lowest two bits.
                var rank: usize = 0
                var weight: usize = 1
                var half = side >> 1
                while half > 0 {
                    const qx = x / half
                    const qy = y / half
                    const quarter: usize = if qx == 0 && qy == 0 { 0 } else if qx == 1 && qy == 0 { 2 } else if qx == 0 { 3 } else { 1 }
                    rank += quarter * weight
                    weight *= 4
                    x = x % half
                    y = y % half
                    half = half >> 1
                }
                if work[index] == 0xFFFFFFFF {
                    if rank < darkest_white { darkest_white = rank }
                } else {
                    blacks += 1
                    if rank > lightest_black { lightest_black = rank }
                }
                index += 1
            }
            if blacks != 0 && blacks != 256 && lightest_black >= darkest_white { return 237 }
            if greys[grey] == 100 && (blacks == 0 || blacks == 256) { return 237 }
            grey += 1
        }
        size_bits += 1
    }

    // A Finder (with a grid and without) answers what nearest() answers,
    // also for palettes with a colour twice and more colours than a grid
    // is made for.
    const sizes = [6]usize{ 1, 2, 5, 33, 300, 1500 }
    const pool = scratch.common()
    var size: usize = 0
    while size < 6 {
        palette.clear(p)
        var index: usize = 0
        while index < sizes[size] {
            var value = next(&state)
            if index > 0 && value & 7 == 0 { value = palette.colorAt(p, @intCast(usize, next(&state)) % index) }
            if !palette.add(p, value, "", 0) { return 235 }
            index += 1
        }
        var gridded: usize = 0
        while gridded < 2 {
            const mark = scratch.mark(pool)
            const finder = palette.finder(pool, p, if gridded == 1 { 100000 } else { 10 })
            if finder == null { return 235 }
            var asked: usize = 0
            while asked < 3000 {
                var value = next(&state)
                if asked % 3 == 0 { value = palette.colorAt(p, @intCast(usize, next(&state)) % palette.count(p)) ^ (next(&state) & 0x030303) }
                if palette.nearestOf(finder.?, value) != palette.nearest(p, value).? { return 235 }
                asked += 1
            }
            scratch.release(pool, mark)
            gridded += 1
        }
        size += 1
    }

    palette.destroy(p)
    freeWords(source, total)
    freeWords(work, total)
    freeWords(other, total)
    allocator.free(indices, WIDTH * HEIGHT, 16)
    return 0
}

// ---------------------------------------------------------------------------
// Sorting

fn lightness(value: u32) -> f64 {
    var l: f64 = 0.0
    var a: f64 = 0.0
    var b: f64 = 0.0
    color.toLab(value, &l, &a, &b)
    return l
}

fn sorting(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    if made == null { return 100 }
    const p = made.?
    // Dark to light.
    if !palette.make(p, palette.DEFAULT, false) || !palette.sortByLightness(p) || palette.count(p) != palette.builtinColors(palette.DEFAULT).length { return 100 }
    var index: usize = 1
    while index < palette.count(p) {
        if lightness(palette.colorAt(p, index - 1)) > lightness(palette.colorAt(p, index)) + 1.0e-9 { return 101 }
        index += 1
    }
    // Around the wheel: the greys first, dark to light, then the hues from
    // red on; entries of one colour keep their order.
    palette.clear(p)
    if !palette.add(p, 0xFF0000FF, "blue", 0) || !palette.add(p, 0xFFFFFFFF, "white", 0) || !palette.add(p, 0xFF00FF00, "green", 0) || !palette.add(p, 0xFF000000, "black", 0) { return 102 }
    if !palette.add(p, 0xFFFF0000, "red", 0) || !palette.add(p, 0xFF800000, "dark red", 0) || !palette.add(p, 0xFF00FF00, "green again", 0) || !palette.add(p, 0xFFFFFF00, "yellow", 0) { return 102 }
    if !palette.sortByHue(p) || !namesAre(p, "black|white|dark red|red|yellow|green|green again|blue") { return 103 }
    if !palette.sortByLightness(p) || !std.text.same(palette.nameAt(p, 0), "black") || !std.text.same(palette.nameAt(p, 7), "white") { return 104 }
    palette.destroy(p)
    return 0
}

// ---------------------------------------------------------------------------
// Files

// Four .aco entries (RGB, grey, HSB, one of a colour book), each named in
// version 2: "Orange", "Grün 50", "Red " and a face (a pair of
// surrogates), "Book".
fn acoEntries(out: *Bytes, named: bool) -> bool {
    if !put16(out, 0) || !put16(out, 0xFFFF) || !put16(out, 0x8080) || !put16(out, 0) || !put16(out, 0) { return false }
    if named && (!put32(out, 7) || !putUnits(out, "Orange") || !put16(out, 0)) { return false }
    if !put16(out, 8) || !put16(out, 5000) || !put16(out, 0) || !put16(out, 0) || !put16(out, 0) { return false }
    if named && (!put32(out, 8) || !putUnits(out, "Gr") || !put16(out, 0xFC) || !putUnits(out, "n 50") || !put16(out, 0)) { return false }
    if !put16(out, 1) || !put16(out, 0) || !put16(out, 0xFFFF) || !put16(out, 0xFFFF) || !put16(out, 0) { return false }
    if named && (!put32(out, 7) || !putUnits(out, "Red ") || !put16(out, 0xD83D) || !put16(out, 0xDE00) || !put16(out, 0)) { return false }
    if !put16(out, 10) || !put16(out, 1) || !put16(out, 2) || !put16(out, 3) || !put16(out, 4) { return false }
    if named && (!put32(out, 5) || !putUnits(out, "Book") || !put16(out, 0)) { return false }
    return true
}

// An .aco: version 1, and version 2 after it when `both`.
fn makeAco(out: *Bytes, both: bool) -> bool {
    if !put16(out, 1) || !put16(out, 4) || !acoEntries(out, false) { return false }
    if !both { return true }
    return put16(out, 2) && put16(out, 4) && acoEntries(out, true)
}

fn aseGroup(out: *Bytes, text: []const u8) -> bool {
    const units = @intCast(u32, text.length + 1)
    return put16(out, 0xC001) && put32(out, 2 + units * 2) && put16(out, units) && putUnits(out, text) && put16(out, 0)
}

fn aseColor(out: *Bytes, text: []const u8, model: u32, floats: u32, a: f64, b: f64, c: f64) -> bool {
    const units = @intCast(u32, text.length + 1)
    if !put16(out, 1) || !put32(out, 2 + units * 2 + 4 + floats * 4 + 2) || !put16(out, units) || !putUnits(out, text) || !put16(out, 0) || !put32(out, model) { return false }
    if !put32(out, floatBits(a)) { return false }
    if floats > 1 && (!put32(out, floatBits(b)) || !put32(out, floatBits(c))) { return false }
    return put16(out, 2)
}

// An .ase: a group "Warm" of orange and red, a grey of a quarter outside
// it, and a colour of a model not known.
fn makeAse(out: *Bytes) -> bool {
    if !out.*.appendSlice("ASEF") || !put16(out, 1) || !put16(out, 0) || !put32(out, 6) { return false }
    if !aseGroup(out, "Warm") || !aseColor(out, "Orange", 0x52474220, 3, 1.0, 0.5, 0.0) || !aseColor(out, "Red", 0x52474220, 3, 1.0, 0.0, 0.0) { return false }
    if !put16(out, 0xC002) || !put32(out, 0) { return false }
    return aseColor(out, "Quarter", 0x47726179, 1, 0.25, 0.0, 0.0) && aseColor(out, "Odd", 0x58595A20, 3, 0.1, 0.2, 0.3)
}

// A .kpl: "mimetype" (left out when empty) and `text` as colorset.xml.
fn makeKpl(out: *Bytes, allocator: Allocator, text: []const u8, mimetype: []const u8) -> bool {
    var writer: zip.Writer = undefined
    zip.begin(&writer, out, allocator)
    if mimetype.length > 0 && !zip.add(&writer, "mimetype", mimetype, zip.STORED, 0) { return false }
    return zip.add(&writer, "colorset.xml", text, zip.DEFLATED, 6) && zip.add(&writer, "profiles.xml", "<Profiles/>", zip.DEFLATED, 6) && zip.finish(&writer)
}

fn files(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const back_made = palette.create(allocator)
    if made == null || back_made == null { return 110 }
    const p = made.?
    const back = back_made.?
    var text = Bytes.init(allocator)
    defer text.deinit()

    // GIMP's .gpl and the plain list, written and read back.
    var which: usize = 0
    while which < palette.BUILTINS {
        if !palette.make(p, which, which % 2 == 1) { return 110 }
        text.clearRetainingCapacity()
        if !palette.writeGpl(p, &text) || !palette.readGpl(back, text.items()) || !samePalettes(p, back) { return 111 }
        if palette.read(back, text.items()) != palette.GPL || !samePalettes(p, back) { return 112 }
        text.clearRetainingCapacity()
        if !palette.writeHexList(p, &text) || !palette.readHexList(back, text.items()) || palette.count(back) != palette.count(p) { return 113 }
        var index: usize = 0
        while index < palette.count(p) {
            if palette.colorAt(back, index) != palette.colorAt(p, index) || !std.text.same(palette.nameAt(back, index), palette.nameAt(p, index)) { return 113 }
            index += 1
        }
        if palette.read(back, text.items()) != palette.HEX { return 114 }
        which += 1
    }
    // A hand-typed one.
    if palette.read(p, HAND_TYPED) != palette.GPL || palette.count(p) != 6 { return 115 }
    if !std.text.same(palette.name(p), "Hand typed") || p.*.columns != 4 { return 116 }
    if !entryIs(p, 0, 0xFFFF0000, "Red", 0) || !entryIs(p, 1, 0xFF00FF00, "Green", 0) || !entryIs(p, 2, 0xFF0000FF, "", 0) { return 117 }
    if !entryIs(p, 3, 0xFF0C2238, "deep sea", 0) || !entryIs(p, 4, 0xFF808080, "Grey 50%", 0) || !entryIs(p, 5, 0xFFFFFFFF, "clipped", 0) { return 118 }
    if palette.readGpl(p, "GIMP Palette\nName: Empty\n") == false || palette.count(p) != 0 || !std.text.same(palette.name(p), "Empty") { return 119 }
    if palette.readGpl(p, "JASC-PAL\n0100\n2\n0 0 0\n") || palette.readGpl(p, "") || palette.count(p) != 0 { return 119 }
    // The plain list.
    if palette.read(p, HEX_LIST) != palette.HEX || palette.count(p) != 4 { return 120 }
    if !entryIs(p, 0, 0xFFFF0000, "Red", 0) || !entryIs(p, 1, 0xFF00FF00, "", 0) || !entryIs(p, 2, 0xFF0000FF, "Blue sky", 0) || !entryIs(p, 3, 0xFFAABBCC, "", 0) { return 121 }
    if palette.readHexList(p, "#ff0000\nzzz\n") || palette.count(p) != 0 || palette.read(p, "garbage") != palette.UNKNOWN || palette.read(p, "") != palette.UNKNOWN { return 122 }
    // A reader starts from nothing: no name, the columns a new palette has.
    palette.rename(p, "Before")
    palette.setColumns(p, 3)
    if palette.read(p, HEX_LIST) != palette.HEX || palette.name(p).length != 0 || p.*.columns != palette.COLUMNS { return 122 }
    // Colours of a filter's text.
    const room = words(8)
    if room == null { return 123 }
    const into = room.?
    if palette.parseColors("#FF0000, #0f0;00f junk #12345678 #ff", into, 8) != 4 { return 123 }
    if into[0] != 0xFFFF0000 || into[1] != 0xFF00FF00 || into[2] != 0xFF0000FF || into[3] != 0xFF345678 { return 123 }
    if palette.parseColors("#FF0000 #FF0000 #FF0000", into, 2) != 2 || palette.parseColors("", into, 8) != 0 { return 123 }

    // .aco: version 1 alone, and 1 then 2 (the named one is taken).
    text.clearRetainingCapacity()
    if !makeAco(&text, false) { return 124 }
    if palette.read(p, text.items()) != palette.ACO || palette.count(p) != 3 { return 125 }
    if !entryIs(p, 0, 0xFFFF8000, "", 0) || !entryIs(p, 1, 0xFF808080, "", 0) || !entryIs(p, 2, 0xFFFF0000, "", 0) { return 126 }
    text.clearRetainingCapacity()
    if !makeAco(&text, true) { return 124 }
    if palette.read(p, text.items()) != palette.ACO || palette.count(p) != 3 { return 127 }
    if !entryIs(p, 0, 0xFFFF8000, "Orange", 0) || !entryIs(p, 1, 0xFF808080, "Gr\u{fc}n 50", 0) || !entryIs(p, 2, 0xFFFF0000, "Red \u{1f600}", 0) { return 128 }

    // .ase.
    text.clearRetainingCapacity()
    if !makeAse(&text) { return 129 }
    if palette.read(p, text.items()) != palette.ASE || palette.count(p) != 3 || palette.groupCount(p) != 2 || !std.text.same(palette.groupName(p, 1), "Warm") { return 130 }
    if !entryIs(p, 0, 0xFFFF8000, "Orange", 1) || !entryIs(p, 1, 0xFFFF0000, "Red", 1) || !entryIs(p, 2, 0xFF404040, "Quarter", 0) { return 131 }

    // Krita's .kpl.
    text.clearRetainingCapacity()
    if !makeKpl(&text, allocator, KPL_TEXT, "krita/x-colorset") { return 132 }
    if palette.read(p, text.items()) != palette.KPL || palette.count(p) != 4 || palette.groupCount(p) != 2 { return 133 }
    if !std.text.same(palette.name(p), "Krita & friends") || p.*.columns != 4 || !std.text.same(palette.groupName(p, 1), "Greys <3") { return 134 }
    if !entryIs(p, 0, 0xFFFF8000, "First", 0) || !entryIs(p, 1, 0xFF00FF00, "Second", 0) || !entryIs(p, 2, 0xFF404040, "Next row", 0) || !entryIs(p, 3, 0xFF808080, "Mid Grey", 1) { return 135 }
    text.clearRetainingCapacity()
    if !makeKpl(&text, allocator, KPL_OLD, "") { return 136 }
    if !palette.readKpl(p, text.items()) || palette.count(p) != 2 || p.*.columns != 2 || !std.text.same(palette.name(p), "Old") { return 137 }
    if !entryIs(p, 0, 0xFF0000FF, "B", 0) || !entryIs(p, 1, 0xFFFF0000, "A", 0) { return 137 }
    // Another mimetype, no colorset, another root, broken XML, nothing
    // that could be read.
    text.clearRetainingCapacity()
    if !makeKpl(&text, allocator, KPL_OLD, "application/x-krita") || palette.readKpl(p, text.items()) || palette.count(p) != 0 { return 138 }
    text.clearRetainingCapacity()
    if !makeKpl(&text, allocator, "<Palette><ColorSetEntry name=\"x\"><sRGB r=\"1\" g=\"1\" b=\"1\"/></ColorSetEntry></Palette>", "krita/x-colorset") || palette.readKpl(p, text.items()) { return 139 }
    text.clearRetainingCapacity()
    if !makeKpl(&text, allocator, "<Colorset name=\"x\"><ColorSetEntry name=\"x\"><sRGB r=\"1\" g=\"1\" b=\"1\"/></ColorSetEntry>", "krita/x-colorset") || palette.readKpl(p, text.items()) || palette.count(p) != 0 { return 140 }
    text.clearRetainingCapacity()
    if !makeKpl(&text, allocator, "<Colorset name=\"x\"><ColorSetEntry name=\"x\"><Lab L=\"1\" a=\"1\" b=\"1\"/></ColorSetEntry></Colorset>", "krita/x-colorset") || palette.readKpl(p, text.items()) { return 141 }
    text.clearRetainingCapacity()
    var writer: zip.Writer = undefined
    zip.begin(&writer, &text, allocator)
    if !zip.add(&writer, "mimetype", "krita/x-colorset", zip.STORED, 0) || !zip.finish(&writer) || palette.readKpl(p, text.items()) || palette.read(p, text.items()) != palette.UNKNOWN { return 142 }
    // What is no number in a component is 0.
    text.clearRetainingCapacity()
    if !makeKpl(&text, allocator, "<Colorset><ColorSetEntry><sRGB r=\"x\" g=\"1e999\" b=\"-1\"/></ColorSetEntry><ColorSetEntry><sRGB r=\"1.\" g=\"1e-999\" b=\"0.0000000000000000000001e22\"/></ColorSetEntry></Colorset>", "") || !palette.readKpl(p, text.items()) { return 143 }
    if palette.count(p) != 2 || palette.colorAt(p, 0) != 0xFF00FF00 || palette.colorAt(p, 1) != 0xFFFF00FF { return 143 }
    palette.destroy(p)
    palette.destroy(back)
    freeWords(into, 8)
    return 0
}

// An .aco entry: colour space and four numbers, and (`named`) a name of
// ASCII.
fn acoEntry(out: *Bytes, space: u32, w: u32, x: u32, y: u32, z: u32, named: bool, text: []const u8) -> bool {
    if !put16(out, space) || !put16(out, w) || !put16(out, x) || !put16(out, y) || !put16(out, z) { return false }
    return !named || (put32(out, @intCast(u32, text.length + 1)) && putUnits(out, text) && put16(out, 0))
}

// An .ase CMYK colour.
fn aseCmyk(out: *Bytes, text: []const u8, c: f64, m: f64, y: f64, k: f64) -> bool {
    const units = @intCast(u32, text.length + 1)
    if !put16(out, 1) || !put32(out, 2 + units * 2 + 4 + 16 + 2) || !put16(out, units) || !putUnits(out, text) || !put16(out, 0) || !out.*.appendSlice("CMYK") { return false }
    return put32(out, floatBits(c)) && put32(out, floatBits(m)) && put32(out, floatBits(y)) && put32(out, floatBits(k)) && put16(out, 2)
}

// The start of an .ase that says it has `blocks` blocks.
fn aseHead(out: *Bytes, blocks: u32) -> bool {
    return out.*.appendSlice("ASEF") && put16(out, 1) && put16(out, 0) && put32(out, blocks)
}

// Krita's colorset.xml as Krita writes it: RGB elements naming their
// profile, the attributes in any order. sRGB's profile, sRGB's of gamma
// 1.0 (linear: 0.5 is sRGB's 0.7354, the byte 188), none named (sRGB),
// another space (left out), Gray of gamma 1.0; a grid wider than a
// palette is shown, its second row after the whole first.
const KPL_KRITA = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Colorset readonly=\"false\" version=\"2.0\" columns=\"100\" name=\"Krita writes\" comment=\"\" rows=\"2\">\n <ColorSetEntry spot=\"false\" bitdepth=\"U8\" name=\"Row 1\" id=\"1\">\n  <RGB space=\"sRGB-elle-V2-srgbtrc.icc\" g=\"0\" r=\"0\" b=\"1\"/>\n  <Position column=\"0\" row=\"1\"/>\n </ColorSetEntry>\n <ColorSetEntry spot=\"false\" bitdepth=\"F32\" name=\"Linear\" id=\"2\">\n  <RGB r=\"0.5\" g=\"0.5\" b=\"0.5\" space=\"sRGB-elle-V2-g10.icc\"/>\n  <Position row=\"0\" column=\"70\"/>\n </ColorSetEntry>\n <ColorSetEntry name=\"Wide\" id=\"3\" bitdepth=\"U16\">\n  <RGB r=\"1\" g=\"0\" b=\"0\" space=\"Rec2020-elle-V4-g10.icc\"/>\n  <Position row=\"0\" column=\"1\"/>\n </ColorSetEntry>\n <ColorSetEntry name=\"Plain\" id=\"4\">\n  <RGB r=\"1\" g=\"1\" b=\"0\"/>\n  <Position row=\"0\" column=\"5\"/>\n </ColorSetEntry>\n <ColorSetEntry name=\"Linear grey\" id=\"5\">\n  <Gray g=\"0.5\" space=\"Gray-D50-elle-V2-g10.icc\"/>\n  <Position row=\"0\" column=\"80\"/>\n </ColorSetEntry>\n</Colorset>\n"

fn moreFiles(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const back_made = palette.create(allocator)
    if made == null || back_made == null { return 144 }
    const p = made.?
    const back = back_made.?
    var out = Bytes.init(allocator)
    defer out.deinit()

    // .gpl from an old Mac ('\r' alone ends a line); columns beyond the
    // most; an empty palette written and read back; a name of two-byte
    // characters cut whole and kept through a file.
    if palette.read(p, "GIMP Palette\rName: Mac\r1 2 3\tOne\r4 5 6 Two\r") != palette.GPL || palette.count(p) != 2 || !std.text.same(palette.name(p), "Mac") { return 144 }
    if !entryIs(p, 0, 0xFF010203, "One", 0) || !entryIs(p, 1, 0xFF040506, "Two", 0) { return 144 }
    if palette.read(p, "#102030 a\r#405060 b") != palette.HEX || !entryIs(p, 1, 0xFF405060, "b", 0) { return 144 }
    if !palette.readGpl(p, "GIMP Palette\nColumns: 99999999999\n# only a comment\n") || p.*.columns != palette.MOST_COLUMNS || palette.count(p) != 0 { return 145 }
    palette.clear(p)
    palette.rename(p, "")
    if !palette.writeGpl(p, &out) || !palette.readGpl(back, out.items()) || !samePalettes(p, back) { return 145 }
    if !palette.add(p, 0xFF102030, "\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}\u{fc}", 0) || palette.nameAt(p, 0).length != 30 { return 146 }
    out.clearRetainingCapacity()
    if !palette.writeGpl(p, &out) || !palette.readGpl(back, out.items()) || !samePalettes(p, back) { return 146 }

    // .aco: no colours; three said and two there.
    out.clearRetainingCapacity()
    if !put16(&out, 1) || !put16(&out, 0) || palette.read(p, out.items()) != palette.UNKNOWN || palette.count(p) != 0 { return 147 }
    out.clearRetainingCapacity()
    if !put16(&out, 1) || !put16(&out, 3) || !acoEntry(&out, 0, 0xFFFF, 0, 0, 0, false, "") || !acoEntry(&out, 0, 0, 0xFFFF, 0, 0, false, "") { return 148 }
    if palette.read(p, out.items()) != palette.UNKNOWN || palette.count(p) != 0 { return 148 }
    // Version 2 alone: Lab white (L 10000) and black, CMYK without ink
    // (0 is all of an ink) and of black alone.
    out.clearRetainingCapacity()
    if !put16(&out, 2) || !put16(&out, 4) || !acoEntry(&out, 7, 10000, 0, 0, 0, true, "") || !acoEntry(&out, 7, 0, 0, 0, 0, true, "Black") { return 149 }
    if !acoEntry(&out, 2, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF, true, "Paper") || !acoEntry(&out, 2, 0xFFFF, 0xFFFF, 0xFFFF, 0, true, "Ink") { return 149 }
    if palette.read(p, out.items()) != palette.ACO || palette.count(p) != 4 { return 149 }
    if !entryIs(p, 0, 0xFFFFFFFF, "", 0) || !entryIs(p, 1, 0xFF000000, "Black", 0) || !entryIs(p, 2, 0xFFFFFFFF, "Paper", 0) || !entryIs(p, 3, 0xFF000000, "Ink", 0) { return 149 }

    // .ase: no blocks; more blocks said than there are.
    out.clearRetainingCapacity()
    if !aseHead(&out, 0) || palette.read(p, out.items()) != palette.UNKNOWN { return 150 }
    out.clearRetainingCapacity()
    if !aseHead(&out, 3) || !aseColor(&out, "A", 0x52474220, 3, 1.0, 0.0, 0.0) || palette.read(p, out.items()) != palette.UNKNOWN || palette.count(p) != 0 { return 150 }
    // 70 groups of a colour each (the first 63 become the palette's, the
    // colours of the others go to group 0); RGB beyond 0..1 and not a
    // number; CMYK without ink and of black; Lab's white; Gray's white; a
    // block of a kind not known; Gray's black.
    out.clearRetainingCapacity()
    if !aseHead(&out, 70 * 3 + 7) { return 151 }
    var group: usize = 0
    while group < 70 {
        if !aseGroup(&out, "Group") || !aseColor(&out, "In", 0x52474220, 3, 0.0, 0.0, 1.0) || !put16(&out, 0xC002) || !put32(&out, 0) { return 151 }
        group += 1
    }
    if !aseColor(&out, "Out", 0x52474220, 3, 2.0, -1.0, math.nan()) || !aseCmyk(&out, "Paper", 0.0, 0.0, 0.0, 0.0) || !aseCmyk(&out, "Ink", 0.0, 0.0, 0.0, 1.0) { return 151 }
    if !aseColor(&out, "Lab", 0x4C414220, 3, 1.0, 0.0, 0.0) || !aseColor(&out, "Grey", 0x47726179, 1, 1.0, 0.0, 0.0) { return 151 }
    if !put16(&out, 0x1234) || !put32(&out, 3) || !put16(&out, 0) || !out.append(0) || !aseColor(&out, "Last", 0x47726179, 1, 0.0, 0.0, 0.0) { return 151 }
    if palette.read(p, out.items()) != palette.ASE || palette.count(p) != 76 || palette.groupCount(p) != palette.GROUPS { return 151 }
    if !entryIs(p, 0, 0xFF0000FF, "In", 1) || !entryIs(p, 62, 0xFF0000FF, "In", 63) || !entryIs(p, 63, 0xFF0000FF, "In", 0) || !entryIs(p, 69, 0xFF0000FF, "In", 0) { return 152 }
    if !entryIs(p, 70, 0xFFFF0000, "Out", 0) || !entryIs(p, 71, 0xFFFFFFFF, "Paper", 0) || !entryIs(p, 72, 0xFF000000, "Ink", 0) { return 152 }
    if !entryIs(p, 73, 0xFFFFFFFF, "Lab", 0) || !entryIs(p, 74, 0xFFFFFFFF, "Grey", 0) || !entryIs(p, 75, 0xFF000000, "Last", 0) { return 152 }

    // .kpl as Krita writes it, and with the root spelt "ColorSet".
    out.clearRetainingCapacity()
    if !makeKpl(&out, allocator, KPL_KRITA, "krita/x-colorset") { return 153 }
    if palette.read(p, out.items()) != palette.KPL || palette.count(p) != 4 || p.*.columns != palette.MOST_COLUMNS || !std.text.same(palette.name(p), "Krita writes") { return 153 }
    if !entryIs(p, 0, 0xFFFFFF00, "Plain", 0) || !entryIs(p, 1, 0xFFBCBCBC, "Linear", 0) || !entryIs(p, 2, 0xFFBCBCBC, "Linear grey", 0) || !entryIs(p, 3, 0xFF0000FF, "Row 1", 0) { return 154 }
    out.clearRetainingCapacity()
    if !makeKpl(&out, allocator, "<ColorSet name=\"Spelt\"><ColorSetEntry name=\"x\"><RGB r=\"1\" g=\"0\" b=\"1\" space=\"sRGB built-in\"/></ColorSetEntry></ColorSet>", "krita/x-colorset") { return 155 }
    if !palette.readKpl(p, out.items()) || palette.count(p) != 1 || !entryIs(p, 0, 0xFFFF00FF, "x", 0) { return 155 }
    // Only colours of another space: nothing to read.
    out.clearRetainingCapacity()
    if !makeKpl(&out, allocator, "<Colorset><ColorSetEntry><RGB r=\"1\" g=\"0\" b=\"1\" space=\"ClayRGB-elle-V2-g22.icc\"/></ColorSetEntry></Colorset>", "krita/x-colorset") { return 156 }
    if palette.readKpl(p, out.items()) || palette.count(p) != 0 { return 156 }
    palette.destroy(p)
    palette.destroy(back)
    return 0
}

// ---------------------------------------------------------------------------
// Damaged files

const SAMPLES: usize = 6

fn damaged(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    if made == null { return 160 }
    const p = made.?
    // The samples one after the other: .gpl, .aco, .ase, .kpl, plain
    // list, hand-typed .gpl.
    var all = Bytes.init(allocator)
    defer all.deinit()
    var starts: [7]usize = undefined
    starts[0] = 0
    if !palette.make(p, palette.PC_16, true) || !palette.writeGpl(p, &all) { return 160 }
    starts[1] = all.count()
    if !makeAco(&all, true) { return 160 }
    starts[2] = all.count()
    if !makeAse(&all) { return 160 }
    starts[3] = all.count()
    if !makeKpl(&all, allocator, KPL_TEXT, "krita/x-colorset") { return 160 }
    starts[4] = all.count()
    if !palette.writeHexList(p, &all) { return 160 }
    starts[5] = all.count()
    if !all.appendSlice(HAND_TYPED) { return 160 }
    starts[6] = all.count()
    const memory = allocator.alloc(all.count(), 16)
    if memory == null { return 160 }
    const buffer = memory.?

    // Every truncation: no trap, and a binary file cut off is not read
    // (an .aco may end after its first section).
    var sample: usize = 0
    while sample < SAMPLES {
        const whole = all.items()[starts[sample]..starts[sample + 1]]
        var length: usize = 0
        while length < whole.length {
            const kind = palette.read(p, whole[0..length])
            if !sane(p) || (kind == palette.UNKNOWN && palette.count(p) != 0) { return 161 }
            if (sample == 2 || sample == 3) && kind != palette.UNKNOWN { return 162 }
            if sample == 1 && length < 44 && kind != palette.UNKNOWN { return 163 }
            length += 1
        }
        sample += 1
    }
    // 1000 damages of one to four bytes.
    var state: u64 = 1818
    var round: usize = 0
    while round < 1000 {
        sample = round % SAMPLES
        const whole = all.items()[starts[sample]..starts[sample + 1]]
        var index: usize = 0
        while index < whole.length {
            buffer[index] = whole[index]
            index += 1
        }
        var flips = 1 + next(&state) % 4
        while flips > 0 {
            const at = @intCast(usize, next(&state)) % whole.length
            buffer[at] = buffer[at] ^ @intCast(u8, 1 + next(&state) % 255)
            flips -= 1
        }
        const kind = palette.read(p, buffer[0..whole.length])
        if !sane(p) || (kind == palette.UNKNOWN && palette.count(p) != 0) { return 164 }
        round += 1
    }
    // 300 damages of a .kpl's XML in a sound archive, and 200 of one as
    // Krita writes it.
    var xml_text = Bytes.init(allocator)
    defer xml_text.deinit()
    var archive = Bytes.init(allocator)
    defer archive.deinit()
    round = 0
    while round < 500 {
        xml_text.clearRetainingCapacity()
        archive.clearRetainingCapacity()
        if !xml_text.appendSlice(if round < 300 { KPL_TEXT } else { KPL_KRITA }) { return 165 }
        var flips = 1 + next(&state) % 3
        while flips > 0 {
            const at = @intCast(usize, next(&state)) % xml_text.count()
            xml_text.items()[at] = xml_text.items()[at] ^ @intCast(u8, 1 + next(&state) % 255)
            flips -= 1
        }
        if !makeKpl(&archive, allocator, xml_text.items(), "krita/x-colorset") { return 165 }
        const read = palette.readKpl(p, archive.items())
        if !sane(p) || (!read && palette.count(p) != 0) { return 166 }
        round += 1
    }
    allocator.free(buffer, all.count(), 16)
    palette.destroy(p)
    return 0
}

// ---------------------------------------------------------------------------
// The filter

fn filtering(allocator: Allocator) -> u8 {
    const info = filters.find(palettize.PALETTIZE)
    if info == null { return 180 }
    const filter = info.?
    if !std.text.same(filter.*.key, "palettize") || filter.*.category != types.MAP || filter.*.name.length == 0 || filter.*.german.length == 0 || filter.*.params.length != 5 { return 181 }
    const keyed = filters.byKey("palettize")
    if keyed == null || keyed.?.*.id != palettize.PALETTIZE { return 182 }
    const params_memory = allocator.alloc(@sizeOf(filters.Params), 16)
    const made = palette.create(allocator)
    const source_memory = words(STRIDE * HEIGHT)
    const work_memory = words(STRIDE * HEIGHT)
    const known_memory = allocator.alloc(2097152, 16)
    if params_memory == null || made == null || source_memory == null || work_memory == null || known_memory == null { return 183 }
    const params: *filters.Params = unsafe { @ptrCast(*filters.Params, params_memory.?) }
    const p = made.?
    const source = source_memory.?
    const work = work_memory.?
    const known = known_memory.?
    const total = STRIDE * HEIGHT
    var index: usize = 0
    while index < 2097152 {
        known[index] = 0
        index += 1
    }
    filters.defaults(palettize.PALETTIZE, params)
    if params.*.values[palettize.PALETTE] != 0.0 || params.*.values[palettize.DITHER] != @floatFromInt(f64, palette.FLOYD_STEINBERG) || params.*.values[palettize.STRENGTH] != 100.0 || params.*.values[palettize.KEEP_ALPHA] != 1.0 { return 184 }
    if filters.margin(params) != 0 || filter.*.margin == null { return 185 }

    // One pixel.
    if !palette.make(p, palette.DEFAULT, false) { return 186 }
    work[0] = 0xFF7F6F5F
    work[1] = SENTINEL
    if !filters.apply(params, work, 1, 1, 1) || palette.find(p, work[0]) == null || work[0] >> 24 != 255 || work[1] != SENTINEL { return 186 }

    // Every palette with four dithers: colours of that palette, alpha
    // kept, the words beside the rows untouched.
    noise(source, WIDTH, HEIGHT, STRIDE, 311)
    var which: usize = 0
    while which < palette.BUILTINS {
        if !palette.make(p, which, false) { return 187 }
        markColors(known, p, true)
        var method: u8 = 0
        while method < palette.DITHERS {
            filters.defaults(palettize.PALETTIZE, params)
            params.*.values[palettize.PALETTE] = @floatFromInt(f64, which)
            params.*.values[palettize.DITHER] = @floatFromInt(f64, method)
            copyWords(work, source, total)
            if !filters.apply(params, work, WIDTH, HEIGHT, STRIDE) || !inPalette(work, source, WIDTH, HEIGHT, STRIDE, known, true) { return 188 }
            method += 1
        }
        markColors(known, p, false)
        which += 1
    }

    // Each number below its range, above it and NaN.
    if !palette.make(p, palette.DEFAULT, false) { return 189 }
    markColors(known, p, true)
    var place: usize = 0
    while place < 4 {
        var trial: usize = 0
        while trial < 3 {
            filters.defaults(palettize.PALETTIZE, params)
            params.*.values[place] = if trial == 0 { -1000.0 } else if trial == 1 { 1000.0 } else { math.nan() }
            copyWords(work, source, total)
            if !filters.apply(params, work, WIDTH, HEIGHT, STRIDE) { return 189 }
            if place == palettize.PALETTE && trial == 1 {
                // The text's colours, and the text has none: nothing
                // changes.
                if !sameWords(work, source, total) { return 190 }
            } else {
                const keep = !(place == palettize.KEEP_ALPHA && trial == 0)
                if !inPalette(work, source, WIDTH, HEIGHT, STRIDE, known, keep) { return 191 }
            }
            trial += 1
        }
        place += 1
    }
    markColors(known, p, false)

    // Colours from the text.
    filters.defaults(palettize.PALETTIZE, params)
    params.*.values[palettize.PALETTE] = @floatFromInt(f64, palettize.FROM_TEXT)
    node.setParamsText(params, "#FF0000 #0000ff, #fff")
    palette.clear(p)
    if !palette.add(p, 0xFFFF0000, "", 0) || !palette.add(p, 0xFF0000FF, "", 0) || !palette.add(p, 0xFFFFFFFF, "", 0) { return 192 }
    markColors(known, p, true)
    copyWords(work, source, total)
    if !filters.apply(params, work, WIDTH, HEIGHT, STRIDE) || !inPalette(work, source, WIDTH, HEIGHT, STRIDE, known, true) { return 192 }
    // Without keep alpha: opaque or nothing.
    params.*.values[palettize.KEEP_ALPHA] = 0.0
    copyWords(work, source, total)
    if !filters.apply(params, work, WIDTH, HEIGHT, STRIDE) || !inPalette(work, source, WIDTH, HEIGHT, STRIDE, known, false) { return 193 }
    markColors(known, p, false)
    node.setParamsText(params, "no colour here")
    copyWords(work, source, total)
    if !filters.apply(params, work, WIDTH, HEIGHT, STRIDE) || !sameWords(work, source, total) { return 194 }
    // A text length nobody could have written.
    params.*.textLength = 100000
    copyWords(work, source, total)
    if !filters.apply(params, work, WIDTH, HEIGHT, STRIDE) { return 195 }

    // Without a dither each pixel is its own: blocks give what the whole
    // gives; and strength 0 is no dither.
    filters.defaults(palettize.PALETTIZE, params)
    params.*.values[palettize.DITHER] = @floatFromInt(f64, palette.NONE)
    copyWords(work, source, total)
    if !filters.apply(params, work, WIDTH, HEIGHT, STRIDE) { return 196 }
    const blocks_memory = words(STRIDE * HEIGHT)
    if blocks_memory == null { return 196 }
    const blocks = blocks_memory.?
    copyWords(blocks, source, total)
    var top: usize = 0
    while top < HEIGHT {
        var left: usize = 0
        while left < WIDTH {
            const w = if WIDTH - left < 64 { WIDTH - left } else { 64 }
            const h = if HEIGHT - top < 64 { HEIGHT - top } else { 64 }
            if !filters.apply(params, blocks + top * STRIDE + left, w, h, STRIDE) { return 196 }
            left += 64
        }
        top += 64
    }
    if !sameWords(work, blocks, total) { return 197 }
    params.*.values[palettize.DITHER] = @floatFromInt(f64, palette.FLOYD_STEINBERG)
    params.*.values[palettize.STRENGTH] = 0.0
    copyWords(blocks, source, total)
    if !filters.apply(params, blocks, WIDTH, HEIGHT, STRIDE) || !sameWords(work, blocks, total) { return 198 }

    palette.destroy(p)
    allocator.free(params_memory.?, @sizeOf(filters.Params), 16)
    allocator.free(known, 2097152, 16)
    freeWords(source, total)
    freeWords(work, total)
    freeWords(blocks, total)
    return 0
}

// ---------------------------------------------------------------------------
// The value arena and the scratch pool

fn arena(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const other = palette.create(allocator)
    const params_memory = allocator.alloc(@sizeOf(filters.Params), 16)
    const memory = words(64 * 64)
    const index_memory = allocator.alloc(64 * 64, 16)
    if made == null || other == null || params_memory == null || memory == null || index_memory == null { return 210 }
    const p = made.?
    const q = other.?
    const params: *filters.Params = unsafe { @ptrCast(*filters.Params, params_memory.?) }
    const work = memory.?
    const indices = index_memory.?
    var kpl = Bytes.init(allocator)
    defer kpl.deinit()
    var aco = Bytes.init(allocator)
    defer aco.deinit()
    var ase = Bytes.init(allocator)
    defer ase.deinit()
    var written = Bytes.init(allocator)
    defer written.deinit()
    if !makeKpl(&kpl, allocator, KPL_TEXT, "krita/x-colorset") || !makeAco(&aco, true) || !makeAse(&ase) { return 210 }
    if !palette.make(p, palette.DEFAULT, false) { return 210 }
    filters.defaults(palettize.PALETTIZE, params)
    const pool = scratch.common()
    var round: usize = 0
    var base: usize = 0
    var before: usize = 0
    var mark = scratch.mark(pool)
    // The first round makes what is made at the first asking (the tables
    // of Lab, the kept lists).
    while round < 51 {
        if round == 1 {
            base = turns.locate()
            before = turns.used(base)
            mark = scratch.mark(pool)
        }
        noise(work, 64, 64, 64, @intCast(u64, round) + 1)
        if !palette.quantize(work, 64, 64, 64, p, palette.FLOYD_STEINBERG, 1.0, true) { return 211 }
        noise(work, 64, 64, 64, @intCast(u64, round) + 1)
        if !palette.quantize(work, 64, 64, 64, p, palette.ORDERED_BAYER_8, 1.0, false) { return 211 }
        if !palette.quantizeIndices(work, 64, 64, 64, p, palette.ATKINSON, 0.5, 0, indices) { return 211 }
        if palette.nearest(p, work[round]) == null || !palette.sortByHue(p) || !palette.sortByLightness(p) { return 211 }
        noise(work, 64, 64, 64, @intCast(u64, round) + 1)
        if !filters.apply(params, work, 64, 64, 64) { return 211 }
        if !palette.fromPixels(q, work, 64 * 64, 16) || !palette.make(q, round % palette.BUILTINS, round % 2 == 0) { return 212 }
        if palette.read(q, HAND_TYPED) != palette.GPL || palette.read(q, kpl.items()) != palette.KPL || palette.read(q, aco.items()) != palette.ACO || palette.read(q, HEX_LIST) != palette.HEX { return 213 }
        // Editing, copying, writing, the other readers, a Finder.
        palette.rename(q, "A name \u{fc}")
        if !palette.insert(q, 1, 0xFF00FF00, "Inserted", 0) || !palette.move(q, 1, 3) || !palette.setName(q, 3, "Moved") || !palette.remove(q, 3) || !palette.copy(q, p) { return 216 }
        const made_group = palette.addGroup(q, "Group")
        if made_group == null || !palette.removeGroup(q, made_group.?) { return 216 }
        written.clearRetainingCapacity()
        if !palette.writeGpl(q, &written) || !palette.writeHexList(q, &written) || palette.read(q, ase.items()) != palette.ASE { return 216 }
        if palette.parseColors("#ff0000 #00ff00, #00f", work, 3) != 3 || palette.builtinName(round % palette.BUILTINS, true).length == 0 || palette.ditherName(@intCast(u8, round % 9), false).length == 0 { return 216 }
        const finder_mark = scratch.mark(pool)
        const finder = palette.finder(pool, p, 5000)
        if finder == null || palette.nearestOf(finder.?, @intCast(u32, round) * 77777) >= palette.count(p) { return 216 }
        scratch.release(pool, finder_mark)
        noise(work, 64, 64, 64, @intCast(u64, round) + 1)
        if !palette.quantizeColors(work, 64, 64, 64, palette.builtinColors(round % palette.BUILTINS), palette.NOISE, 1.0, true) { return 216 }
        round += 1
    }
    // (50 rounds: what grows by a byte a round shows; the 16 bytes of
    // the mark taken after `before` do not.)
    if turns.used(base) - before > 64 { return 214 }
    const after = scratch.mark(pool)
    if after.block != mark.block || after.used != mark.used { return 215 }
    palette.destroy(p)
    palette.destroy(q)
    allocator.free(params_memory.?, @sizeOf(filters.Params), 16)
    allocator.free(indices, 64 * 64, 16)
    freeWords(work, 64 * 64)
    return 0
}

// What the palettes take of the heap is given back: two rounds of
// everything that allocates (palettes grown past their first room,
// copies, built-ins, files written and read, the .kpl's unpacked text,
// median cut, reductions), the second measured against the heap before
// it (the first makes what stays: the scratch pool's blocks, the kept
// tables).
fn heapBack(allocator: Allocator) -> u8 {
    var text = Bytes.init(allocator)
    defer text.deinit()
    var kpl = Bytes.init(allocator)
    defer kpl.deinit()
    var aco = Bytes.init(allocator)
    defer aco.deinit()
    var ase = Bytes.init(allocator)
    defer ase.deinit()
    const memory = words(64 * 64)
    if memory == null || !makeKpl(&kpl, allocator, KPL_TEXT, "krita/x-colorset") || !makeAco(&aco, true) || !makeAse(&ase) { return 217 }
    const work = memory.?
    var round: usize = 0
    var before: usize = 0
    while round < 2 {
        text.clearRetainingCapacity()
        if round == 1 { before = std.heap.liveBytes() }
        const made = palette.create(allocator)
        const other = palette.create(allocator)
        if made == null || other == null { return 217 }
        const p = made.?
        const q = other.?
        var index: usize = 0
        while index < 3000 {
            if !palette.add(p, @intCast(u32, index) * 5591, "n", 0) { return 217 }
            index += 1
        }
        if !palette.copy(q, p) || !palette.sortByHue(q) || !palette.make(q, palette.WEB_SAFE, true) || !palette.writeGpl(p, &text) || !palette.readGpl(q, text.items()) { return 217 }
        if palette.read(q, kpl.items()) != palette.KPL || palette.read(q, aco.items()) != palette.ACO || palette.read(q, ase.items()) != palette.ASE { return 217 }
        noise(work, 64, 64, 64, 217)
        if !palette.fromPixels(q, work, 64 * 64, 64) || !palette.quantize(work, 64, 64, 64, p, palette.FLOYD_STEINBERG, 1.0, true) { return 217 }
        palette.destroy(p)
        palette.destroy(q)
        round += 1
    }
    if std.heap.liveBytes() != before { return 218 }
    freeWords(work, 64 * 64)
    return 0
}

// ---------------------------------------------------------------------------
// Speed

// Megapixels a second, with one decimal.
fn report(name: []const u8, count: usize, nanoseconds: usize) -> void {
    const elapsed = if nanoseconds == 0 { 1 } else { nanoseconds }
    const tenths = count * 10000 / elapsed
    _ = std.io.print(name)
    _ = std.io.print(": ")
    _ = std.io.writeUnsigned(std.io.stdout(), tenths / 10)
    _ = std.io.print(".")
    _ = std.io.writeUnsigned(std.io.stdout(), tenths % 10)
    _ = std.io.print(" megapixels a second\n")
}

// The fastest of `rounds`: the machine may be busy with other things.
fn timed(name: []const u8, p: *const Palette, pixels: [*]u32, source: [*]const u32, dither: u8, rounds: usize) -> bool {
    const count: usize = 1024 * 1024
    var fastest: usize = 0
    var round: usize = 0
    while round < rounds {
        copyWords(pixels, source, count)
        const before = std.time.monotonicNanoseconds()
        if !palette.quantize(pixels, 1024, 1024, 1024, p, dither, 1.0, true) { return false }
        const spent = std.time.monotonicNanoseconds() - before
        if round == 0 || spent < fastest { fastest = spent }
        round += 1
    }
    report(name, count, fastest)
    return true
}

fn speed(allocator: Allocator) -> u8 {
    const made = palette.create(allocator)
    const source_memory = words(1024 * 1024)
    const work_memory = words(1024 * 1024)
    if made == null || source_memory == null || work_memory == null { return 220 }
    const p = made.?
    const source = source_memory.?
    const work = work_memory.?
    // 64 colours: the painter's palette without its greys.
    if !palette.make(p, palette.DEFAULT, false) { return 220 }
    while palette.count(p) > 64 { _ = palette.remove(p, palette.count(p) - 1) }
    // Something like a painting: smooth colour across the picture, a
    // little grain.
    var state: u64 = 64
    var y: usize = 0
    while y < 1024 {
        var x: usize = 0
        while x < 1024 {
            const grain = next(&state) & 7
            const r = @intCast(u32, x / 4)
            const g = @intCast(u32, y / 4)
            const b = @intCast(u32, (x + y) / 8) + grain
            source[y * 1024 + x] = pixel.rgb(r, g, pixel.smaller(b, 255))
            x += 1
        }
        y += 1
    }
    _ = std.io.print("nearest of 64 colours, a megapixel\n")
    if !timed("  a painting-like picture, no dither", p, work, source, palette.NONE, 4) { return 221 }
    if !timed("  a painting-like picture, Floyd-Steinberg", p, work, source, palette.FLOYD_STEINBERG, 4) { return 221 }
    if !timed("  a painting-like picture, Bayer 8 x 8", p, work, source, palette.ORDERED_BAYER_8, 4) { return 221 }
    noise(source, 1024, 1024, 1024, 99)
    if !timed("  noise (every colour new), no dither", p, work, source, palette.NONE, 4) { return 221 }
    palette.destroy(p)
    freeWords(source, 1024 * 1024)
    freeWords(work, 1024 * 1024)
    return 0
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var failed = keptThroughTurns(allocator)
    if failed == 0 { failed = entries(allocator) }
    if failed == 0 { failed = moreEntries(allocator) }
    if failed == 0 { failed = builtins(allocator) }
    if failed == 0 { failed = nearestColors(allocator) }
    if failed == 0 { failed = medianCut(allocator) }
    if failed == 0 { failed = moreCuts(allocator) }
    if failed == 0 { failed = quantizing(allocator) }
    if failed == 0 { failed = moreQuantizing(allocator) }
    if failed == 0 { failed = sorting(allocator) }
    if failed == 0 { failed = files(allocator) }
    if failed == 0 { failed = moreFiles(allocator) }
    if failed == 0 { failed = damaged(allocator) }
    if failed == 0 { failed = filtering(allocator) }
    if failed == 0 { failed = arena(allocator) }
    if failed == 0 { failed = heapBack(allocator) }
    if failed == 0 { failed = speed(allocator) }
    if failed != 0 { return failed }
    return 13
}
