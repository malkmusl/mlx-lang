// probe
const std = @import("std")
const palette = @import("../core/palette.mlx")
const filters = @import("../filters/registry.mlx")
pub fn main() -> u8 {
    const p = palette.create(std.heap.allocator()).?
    const bytes = "x"
    _ = palette.read(p, bytes)
    var params: filters.Params = undefined
    filters.defaults(311, &params)
    var pix: [4]u32 = [4]u32{ 0xFF808080, 0xFF102030, 0x80FFFFFF, 0 }
    _ = filters.apply(&params, &pix, 2, 2, 2)
    return 13
}
