// nebula's palettes (core/palette.mlx). Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const palette = @import("../core/palette.mlx")

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const made = palette.create(allocator)
    if made == null { return 1 }
    const p = made.?
    if !palette.make(p, palette.DEFAULT, false) { return 2 }
    if palette.count(p) != 72 { return 3 }
    _ = std.io.println(palette.nameAt(p, 10))
    const near = palette.nearest(p, 0xFF808080)
    if near == null { return 4 }
    _ = std.io.writeHex(std.io.stdout(), @intCast(usize, palette.colorAt(p, near.?)))
    _ = std.io.println("")
    palette.destroy(p)
    return 13
}
