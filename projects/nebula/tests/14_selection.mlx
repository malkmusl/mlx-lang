// nebula's selections (core/selection.mlx): two masks joined in each mode,
// hard and soft, also where a mask's default is all; select all, invert,
// clip; shapes from a rectangle, a layer's alpha and lightness, a colour;
// feather (the sum stays, symmetric, the same wherever the tiles lie, a
// straight edge keeps its place), grow and shrink (exact discs, a square
// grown and shrunk again is itself, the image's edge), border, smooth,
// sharpen; bounds, isRectangle; the outline's segments (a rectangle, an L,
// two pixels touching at a corner, cut by the area); a selection applied
// to pixels (clear, copy, fill); that only tiles that differ are written;
// that nothing of it takes memory of the value arena; and how long a
// feather and a grow of 20 pixels take on 2048 x 2048. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const pixel = @import("../core/pixel.mlx")
const blend = @import("../core/blend.mlx")
const selection = @import("../core/selection.mlx")

const Device = device.Device
const Rect = geom.Rect
const Segment = selection.Segment

// Room for the amounts of 700 x 700 pixels.
const ROOM: usize = 490000

fn gray(target: *Device, area: Rect, amount: u32) -> void {
    _ = device.fill(target, area, pixel.gray(amount))
}

fn sameRect(a: Rect, x: i32, y: i32, width: i32, height: i32) -> bool {
    return a.x == x && a.y == y && a.width == width && a.height == height
}

// The sum of the amounts in `area`.
fn total(target: *Device, area: Rect, room: [*]u8) -> u64 {
    const width = @intCast(usize, area.width)
    const count = width * @intCast(usize, area.height)
    mask.readBytes(target, area, room, width)
    var sum: u64 = 0
    var index: usize = 0
    while index < count {
        sum += @intCast(u64, room[index])
        index += 1
    }
    return sum
}

// Whether `a` in `area` holds what `b` holds in the rectangle of the same
// size at (bx, by).
fn alike(a: *Device, area: Rect, b: *Device, bx: i32, by: i32, room_a: [*]u8, room_b: [*]u8) -> bool {
    const width = @intCast(usize, area.width)
    const count = width * @intCast(usize, area.height)
    mask.readBytes(a, area, room_a, width)
    mask.readBytes(b, geom.rect(bx, by, area.width, area.height), room_b, width)
    return std.mem.eql(room_a, room_b, count)
}

fn isSegment(segment: Segment, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
    return segment.x0 == x0 && segment.y0 == y0 && segment.x1 == x1 && segment.y1 == y1
}

// One pixel grown by `radius` is the disc of all pixels whose centres are
// that near, and nothing else.
fn discGrown(allocator: std.allocator.Allocator, radius: i32, room: [*]u8) -> bool {
    const made = mask.create(allocator, false).?
    const cx: i32 = -3
    const cy: i32 = 70
    mask.set(made, cx, cy, 255)
    if !selection.grow(made, radius) { return false }
    const side = radius * 2 + 5
    const area = geom.rect(cx - radius - 2, cy - radius - 2, side, side)
    mask.readBytes(made, area, room, @intCast(usize, side))
    var count: u32 = 0
    var dy = -radius - 2
    while dy <= radius + 2 {
        var dx = -radius - 2
        while dx <= radius + 2 {
            const amount = room[@intCast(usize, (dy + radius + 2) * side + dx + radius + 2)]
            const inside = dx * dx + dy * dy <= radius * radius
            if inside && amount != 255 { return false }
            if !inside && amount != 0 { return false }
            if inside { count += 1 }
            dx += 1
        }
        dy += 1
    }
    // Its area is that of the circle, within 6 % (a disc of a few
    // pixels is too coarse to say).
    const circle = math.pi * @floatFromInt(f64, radius * radius)
    if radius >= 5 && math.abs(@floatFromInt(f64, count) - circle) > circle * 0.06 { return false }
    if !sameRect(selection.bounds(made), cx - radius, cy - radius, radius * 2 + 1, radius * 2 + 1) { return false }
    // Shrunk by as much, the one pixel is left.
    if !selection.shrink(made, radius, geom.empty(), true) { return false }
    if !sameRect(selection.bounds(made), cx, cy, 1, 1) || mask.at(made, cx, cy) != 255 { return false }
    device.destroy(made)
    return true
}

fn printTime(what: []const u8, milliseconds: usize) -> void {
    _ = std.io.print(what)
    _ = std.io.writeUnsigned(std.io.stdout(), milliseconds)
    _ = std.io.println(" ms")
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const room = allocator.alloc(ROOM, 16).?
    const other = allocator.alloc(ROOM, 16).?
    const image = geom.rect(0, 0, 200, 150)
    const everywhere = geom.rect(-10000, -10000, 20000, 20000)

    // Two hard squares that overlap, across tile borders and the origin,
    // joined in each mode.
    const a = mask.create(allocator, false).?
    const b = mask.create(allocator, false).?
    const first = geom.rect(-20, -20, 100, 100)
    const second = geom.rect(40, 40, 100, 100)
    gray(b, second, 255)

    gray(a, first, 255)
    if !selection.combine(a, b, selection.ADD) { return 1 }
    if mask.at(a, -20, -20) != 255 || mask.at(a, 139, 139) != 255 || mask.at(a, 60, 60) != 255 || mask.at(a, 100, 0) != 0 || mask.at(a, -21, 0) != 0 { return 2 }
    if !sameRect(selection.bounds(a), -20, -20, 160, 160) { return 3 }

    selection.clear(a)
    gray(a, first, 255)
    if !selection.combine(a, b, selection.SUBTRACT) { return 4 }
    if mask.at(a, 0, 0) != 255 || mask.at(a, 39, 79) != 255 || mask.at(a, 40, 40) != 0 || mask.at(a, 79, 79) != 0 || mask.at(a, 100, 100) != 0 { return 5 }
    if !sameRect(selection.bounds(a), -20, -20, 100, 100) { return 6 }

    selection.clear(a)
    gray(a, first, 255)
    if !selection.combine(a, b, selection.INTERSECT) { return 7 }
    if mask.at(a, 40, 40) != 255 || mask.at(a, 79, 79) != 255 || mask.at(a, 39, 40) != 0 || mask.at(a, 80, 79) != 0 || mask.at(a, 0, 0) != 0 { return 8 }
    if !sameRect(selection.bounds(a), 40, 40, 40, 40) { return 9 }

    selection.clear(a)
    gray(a, first, 255)
    if !selection.combine(a, b, selection.SYMMETRIC_DIFFERENCE) { return 10 }
    if mask.at(a, 0, 0) != 255 || mask.at(a, 50, 50) != 0 || mask.at(a, 100, 100) != 255 || mask.at(a, 139, 139) != 255 || mask.at(a, 140, 139) != 0 { return 11 }

    selection.clear(a)
    gray(a, first, 255)
    if !selection.combine(a, b, selection.REPLACE) { return 12 }
    if !sameRect(selection.bounds(a), 40, 40, 100, 100) || mask.at(a, 0, 0) != 0 || mask.at(a, 139, 40) != 255 { return 14 }
    // The shape is not written when the mask that took its tiles is.
    mask.set(a, 50, 50, 7)
    if mask.at(b, 50, 50) != 255 || mask.at(a, 50, 50) != 7 { return 15 }

    // A mask joined with itself.
    selection.clear(a)
    gray(a, first, 255)
    if !selection.combine(a, a, selection.ADD) || !sameRect(selection.bounds(a), -20, -20, 100, 100) { return 16 }
    if !selection.combine(a, a, selection.SYMMETRIC_DIFFERENCE) || !selection.isEmpty(a) { return 17 }

    // Soft amounts: 200 on the left, 100 on the right, both in the middle.
    const soft = mask.create(allocator, false).?
    gray(soft, geom.rect(50, 0, 100, 50), 100)
    selection.clear(a)
    gray(a, geom.rect(0, 0, 100, 50), 200)
    if !selection.combine(a, soft, selection.ADD) { return 18 }
    if mask.at(a, 10, 10) != 200 || mask.at(a, 70, 10) != 200 || mask.at(a, 120, 10) != 100 || mask.at(a, 150, 10) != 0 { return 19 }
    selection.clear(a)
    gray(a, geom.rect(0, 0, 100, 50), 200)
    if !selection.combine(a, soft, selection.SUBTRACT) { return 20 }
    if mask.at(a, 10, 10) != 200 || mask.at(a, 70, 10) != 122 || mask.at(a, 120, 10) != 0 { return 21 }
    selection.clear(a)
    gray(a, geom.rect(0, 0, 100, 50), 200)
    if !selection.combine(a, soft, selection.INTERSECT) { return 22 }
    if mask.at(a, 10, 10) != 0 || mask.at(a, 70, 10) != 100 || mask.at(a, 120, 10) != 0 { return 23 }
    selection.clear(a)
    gray(a, geom.rect(0, 0, 100, 50), 200)
    if !selection.combine(a, soft, selection.SYMMETRIC_DIFFERENCE) { return 24 }
    if mask.at(a, 10, 10) != 200 || mask.at(a, 70, 10) != 100 || mask.at(a, 120, 10) != 100 || mask.at(a, 99, 49) != 100 || mask.at(a, 100, 50) != 0 { return 25 }
    device.destroy(soft)

    // Masks whose default is all. All and a square: the square, and the
    // default is nothing again.
    const all = mask.create(allocator, true).?
    if !selection.combine(all, b, selection.INTERSECT) { return 26 }
    if mask.reachesEverywhere(all) || !sameRect(selection.bounds(all), 40, 40, 100, 100) || mask.at(all, 1000, 1000) != 0 { return 27 }
    // All less a square.
    selection.clear(all)
    device.setDefault(all, mask.ALL)
    if !selection.combine(all, b, selection.SUBTRACT) { return 28 }
    if !mask.reachesEverywhere(all) || mask.at(all, 1000, -1000) != 255 || mask.at(all, 50, 50) != 0 || mask.at(all, 39, 40) != 255 || mask.at(all, 140, 139) != 255 { return 29 }
    // A square and all with a hole: all but what of the hole the square
    // does not fill.
    const holed = mask.create(allocator, true).?
    gray(holed, geom.rect(0, 0, 300, 300), 0)
    selection.clear(a)
    gray(a, first, 255)
    if !selection.combine(a, holed, selection.ADD) { return 30 }
    if !mask.reachesEverywhere(a) || mask.at(a, 10, 10) != 255 || mask.at(a, 200, 200) != 0 || mask.at(a, 1000, 1000) != 255 || mask.at(a, 300, 0) != 255 || mask.at(a, 299, 299) != 0 || mask.at(a, -20, -20) != 255 { return 31 }
    // What differs from all: everything but the square.
    selection.clear(a)
    gray(a, first, 255)
    selection.clear(all)
    device.setDefault(all, mask.ALL)
    if !selection.combine(a, all, selection.SYMMETRIC_DIFFERENCE) { return 32 }
    if !mask.reachesEverywhere(a) || mask.at(a, 0, 0) != 0 || mask.at(a, 500, 500) != 255 || mask.at(a, 80, 79) != 255 { return 33 }
    // A square and all: the square.
    selection.clear(a)
    gray(a, first, 255)
    if !selection.combine(a, all, selection.INTERSECT) || !sameRect(selection.bounds(a), -20, -20, 100, 100) || mask.reachesEverywhere(a) { return 34 }
    device.destroy(holed)
    device.destroy(all)

    // Select all: the image's rectangle and nothing else, whatever was
    // there.
    const s = mask.create(allocator, false).?
    gray(s, geom.rect(-50, -50, 30, 30), 255)
    var found = geom.empty()
    if !selection.selectAll(s, image) { return 35 }
    if !sameRect(selection.bounds(s), 0, 0, 200, 150) || mask.at(s, -40, -40) != 0 || mask.at(s, 200, 149) != 0 || mask.at(s, 199, 149) != 255 { return 36 }
    if !selection.isRectangle(s, &found) || !sameRect(found, 0, 0, 200, 150) { return 37 }

    // Inverted inside the image, and twice is as never.
    selection.clear(s)
    gray(s, geom.rect(10, 10, 50, 50), 255)
    gray(s, geom.rect(100, 20, 40, 40), 200)
    const kept = device.copy(s).?
    if !selection.invert(s, image) { return 38 }
    if mask.at(s, 20, 20) != 0 || mask.at(s, 0, 0) != 255 || mask.at(s, 199, 149) != 255 || mask.at(s, 110, 30) != 55 || mask.at(s, 200, 10) != 0 || mask.at(s, -1, -1) != 0 { return 39 }
    if !selection.invert(s, image) { return 40 }
    if !alike(s, geom.rect(-10, -10, 230, 180), kept, -10, -10, room, other) { return 41 }
    device.destroy(kept)
    const inverted = mask.create(allocator, true).?
    if !selection.invert(inverted, image) || mask.at(inverted, 5, 5) != 0 || mask.at(inverted, 199, 149) != 0 || mask.at(inverted, 300, 300) != 255 { return 42 }
    device.destroy(inverted)

    // Clipped to the image.
    selection.clear(s)
    gray(s, geom.rect(-30, -30, 100, 100), 255)
    if !selection.clip(s, image) || !sameRect(selection.bounds(s), 0, 0, 70, 70) { return 43 }
    if !selection.clip(s, geom.empty()) || !selection.isEmpty(s) || !geom.isEmpty(selection.bounds(s)) { return 44 }

    // Rectangles, hard and soft.
    if !selection.fromRect(s, geom.rect(10, 10, 30, 30), selection.REPLACE, 0.0) { return 45 }
    if !selection.isRectangle(s, &found) || !sameRect(found, 10, 10, 30, 30) { return 46 }
    if !selection.fromRect(s, geom.rect(40, 10, 30, 30), selection.ADD, 0.0) || !selection.isRectangle(s, &found) || !sameRect(found, 10, 10, 60, 30) { return 47 }
    if !selection.fromRect(s, geom.rect(10, 10, 60, 10), selection.SUBTRACT, 0.0) || !selection.isRectangle(s, &found) || !sameRect(found, 10, 20, 60, 20) { return 48 }
    if !selection.fromRect(s, geom.rect(60, 20, 50, 50), selection.ADD, 0.0) || selection.isRectangle(s, &found) { return 49 }
    if !selection.fromRect(s, geom.rect(100, 100, 60, 60), selection.REPLACE, 6.0) { return 50 }
    if mask.at(s, 130, 130) != 255 || mask.at(s, 93, 130) != 0 || mask.at(s, 94, 130) == 0 || !sameRect(selection.bounds(s), 94, 94, 72, 72) { return 51 }
    if mask.at(s, 99, 130) + mask.at(s, 100, 130) < 254 || mask.at(s, 99, 130) + mask.at(s, 100, 130) > 256 { return 52 }
    // A rectangle from anywhere does no harm.
    if !selection.fromRect(s, geom.rect(2147483000, -2147483000, 2147483000, 2147483000), selection.SUBTRACT, 0.0) || mask.at(s, 130, 130) != 255 { return 53 }

    // What is opaque in a layer, what is light.
    const layer = device.create(allocator, 0).?
    _ = device.fill(layer, geom.rect(-10, -10, 40, 40), 0x80FF0000)
    _ = device.fill(layer, geom.rect(100, 100, 10, 10), 0xFF00FF00)
    if !selection.fromAlpha(s, layer, selection.REPLACE) { return 54 }
    if mask.at(s, 0, 0) != 128 || mask.at(s, -10, -10) != 128 || mask.at(s, 105, 105) != 255 || mask.at(s, 50, 50) != 0 || mask.at(s, 130, 130) != 0 { return 55 }
    if !sameRect(selection.bounds(s), -10, -10, 120, 120) { return 56 }
    gray(s, geom.rect(0, 0, 200, 5), 60)
    if !selection.fromAlpha(s, layer, selection.INTERSECT) || mask.at(s, 0, 0) != 60 || mask.at(s, 0, 5) != 128 || mask.at(s, 50, 0) != 0 { return 57 }
    _ = device.fill(layer, geom.rect(0, 200, 10, 10), 0xFFFFFFFF)
    _ = device.fill(layer, geom.rect(10, 200, 10, 10), 0xFF808080)
    _ = device.fill(layer, geom.rect(20, 200, 10, 10), 0x80FFFFFF)
    _ = device.fill(layer, geom.rect(30, 200, 10, 10), 0xFF000000)
    if !selection.fromLuma(s, layer, selection.REPLACE) { return 58 }
    if mask.at(s, 5, 205) != 255 || mask.at(s, 15, 205) != 128 || mask.at(s, 25, 205) != 128 || mask.at(s, 35, 205) != 0 || mask.at(s, 105, 105) != 149 { return 59 }
    device.destroy(layer)

    // Pixels like a colour: exactly, within 20 levels, and with a soft
    // end over 10 more.
    const picture = device.create(allocator, 0).?
    device.setPixel(picture, 0, 0, 0xFF6496C8)
    device.setPixel(picture, 1, 0, 0xFF6E96C8)
    device.setPixel(picture, 2, 0, 0xFF64AAC8)
    device.setPixel(picture, 3, 0, 0xFF6496E1)
    device.setPixel(picture, 4, 0, 0xFF8C96C8)
    device.setPixel(picture, 5, 0, 0xFF6496DD)
    device.setPixel(picture, 6, 0, 0xFF6496E6)
    device.setPixel(picture, 70, 0, 0xFF6496C8)
    device.setPixel(picture, -5, 0, 0xFF6496C8)
    device.setPixel(picture, 10, 5, 0x80FF0000)
    const strip = geom.rect(0, 0, 100, 10)
    if !selection.fromColor(s, picture, 0xFF6496C8, 0, 0, strip, selection.REPLACE) { return 60 }
    if mask.at(s, 0, 0) != 255 || mask.at(s, 1, 0) != 0 || mask.at(s, 2, 0) != 0 || mask.at(s, 70, 0) != 255 || mask.at(s, -5, 0) != 0 || mask.at(s, 50, 5) != 0 { return 61 }
    if !sameRect(selection.bounds(s), 0, 0, 71, 1) { return 62 }
    if !selection.fromColor(s, picture, 0xFF6496C8, 20, 0, strip, selection.REPLACE) { return 63 }
    if mask.at(s, 0, 0) != 255 || mask.at(s, 1, 0) != 255 || mask.at(s, 2, 0) != 255 || mask.at(s, 3, 0) != 0 || mask.at(s, 4, 0) != 0 || mask.at(s, 5, 0) != 0 { return 64 }
    if !selection.fromColor(s, picture, 0xFF6496C8, 20, 10, strip, selection.REPLACE) { return 65 }
    if mask.at(s, 2, 0) != 255 || mask.at(s, 3, 0) != 128 || mask.at(s, 5, 0) != 230 || mask.at(s, 6, 0) != 0 || mask.at(s, 4, 0) != 0 { return 66 }
    // What is transparent, whatever colour it is said in; where there is
    // no tile too, but only inside the area.
    if !selection.fromColor(s, picture, 0x00FF0000, 0, 0, strip, selection.REPLACE) { return 67 }
    if mask.at(s, 50, 5) != 255 || mask.at(s, 0, 0) != 0 || mask.at(s, 99, 9) != 255 || mask.at(s, 100, 9) != 0 || mask.at(s, 50, 10) != 0 || mask.at(s, 10, 5) != 0 { return 68 }
    // Half transparent red is itself, not opaque red, and 127 from it.
    if !selection.fromColor(s, picture, 0x80FF0000, 0, 0, strip, selection.REPLACE) || mask.at(s, 10, 5) != 255 || mask.at(s, 11, 5) != 0 { return 69 }
    if !selection.fromColor(s, picture, 0xFFFF0000, 126, 0, strip, selection.REPLACE) || mask.at(s, 10, 5) != 0 { return 70 }
    if !selection.fromColor(s, picture, 0xFFFF0000, 127, 0, strip, selection.REPLACE) || mask.at(s, 10, 5) != 255 { return 71 }
    device.destroy(picture)

    // Feather: the sum of the amounts stays within half a percent.
    const f = mask.create(allocator, false).?
    gray(f, geom.rect(30, 30, 100, 100), 255)
    const whole_area = geom.rect(20, 20, 120, 120)
    const sum_before = total(f, whole_area, room)
    if sum_before != 2550000 { return 72 }
    // (No radius: nothing happens.)
    const sharp = device.copy(f).?
    if !selection.feather(f, 0.0) || !selection.feather(f, 0.3) || !selection.feather(f, -4.0) { return 73 }
    if !alike(f, whole_area, sharp, 20, 20, room, other) { return 74 }
    device.destroy(sharp)
    if !selection.feather(f, 8.0) { return 75 }
    const sum_after = total(f, whole_area, room)
    const off = if sum_after > sum_before { sum_after - sum_before } else { sum_before - sum_after }
    if off * 200 > sum_before { return 76 }
    // It reaches 8 pixels and no farther.
    if !sameRect(selection.bounds(f), 22, 22, 116, 116) { return 77 }
    // The same seen from left and right, from above and below, and
    // across the diagonal.
    var y: usize = 0
    while y < 120 {
        var x: usize = 0
        while x < 120 {
            const amount = room[y * 120 + x]
            if amount != room[y * 120 + 119 - x] || amount != room[(119 - y) * 120 + x] || amount != room[x * 120 + y] { return 78 }
            x += 1
        }
        y += 1
    }
    // Across a straight edge (between x = 29 and x = 30) the amounts
    // only rise, from nothing 9 pixels outside to all 8 pixels inside,
    // through half at the edge.
    var column: i32 = 20
    while column < 45 {
        if mask.at(f, column, 80) > mask.at(f, column + 1, 80) { return 79 }
        column += 1
    }
    if mask.at(f, 21, 80) != 0 || mask.at(f, 22, 80) == 0 || mask.at(f, 37, 80) == 255 || mask.at(f, 38, 80) != 255 { return 80 }
    const outside = mask.at(f, 29, 80)
    const inside = mask.at(f, 30, 80)
    if outside >= 128 || inside < 128 || outside + inside < 254 || outside + inside > 256 { return 81 }
    // The same square elsewhere among the tiles (left of and above the
    // origin) feathers to the same amounts.
    const moved = mask.create(allocator, false).?
    gray(moved, geom.rect(-131, -197, 100, 100), 255)
    if !selection.feather(moved, 8.0) { return 82 }
    if !alike(f, whole_area, moved, -141, -207, room, other) { return 83 }
    device.destroy(moved)
    // A hole in a mask of all: all stays all far away, the hole's edge
    // is soft and where it was.
    const hole = mask.create(allocator, true).?
    gray(hole, geom.rect(0, 0, 40, 40), 0)
    if !selection.feather(hole, 5.0) { return 84 }
    if mask.at(hole, 1000, 1000) != 255 || mask.at(hole, 20, 20) != 0 || mask.at(hole, -6, 20) != 255 || mask.at(hole, -5, 20) != 252 || mask.at(hole, -1, 20) + mask.at(hole, 0, 20) != 255 { return 85 }
    device.destroy(hole)
    device.destroy(f)

    // Grow: one pixel becomes the disc, for small and large radii.
    if !discGrown(allocator, 5, room) { return 86 }
    if !discGrown(allocator, 20, room) { return 87 }
    if !discGrown(allocator, 50, room) { return 88 }
    if !discGrown(allocator, 1, room) { return 89 }
    // No radius: nothing happens. Soft amounts: from half on a pixel
    // grows, below it stays what it is.
    const g = mask.create(allocator, false).?
    gray(g, geom.rect(0, 0, 10, 10), 255)
    mask.set(g, 10, 5, 200)
    mask.set(g, 30, 5, 100)
    if !selection.grow(g, 0) || !selection.grow(g, -3) || mask.at(g, 10, 5) != 200 || mask.at(g, 11, 5) != 0 { return 90 }
    if !selection.grow(g, 3) { return 91 }
    if mask.at(g, 10, 5) != 255 || mask.at(g, 13, 5) != 255 || mask.at(g, 14, 5) != 0 || mask.at(g, 12, 0) != 255 || mask.at(g, 13, 4) != 0 || mask.at(g, 30, 5) != 100 || mask.at(g, 29, 5) != 0 { return 92 }
    // And shrink: below half a pixel takes its neighbours with it, what
    // stays keeps its amount.
    selection.clear(g)
    gray(g, geom.rect(0, 0, 40, 40), 200)
    mask.set(g, 20, 20, 100)
    if !selection.shrink(g, 2, everywhere, true) { return 93 }
    if mask.at(g, 1, 20) != 0 || mask.at(g, 2, 20) != 200 || mask.at(g, 20, 20) != 0 || mask.at(g, 22, 20) != 0 || mask.at(g, 23, 20) != 200 || mask.at(g, 21, 21) != 0 || mask.at(g, 22, 21) != 200 { return 94 }

    // A big square grown has round corners; shrunk again it is itself.
    selection.clear(g)
    gray(g, geom.rect(100, 100, 300, 300), 255)
    const square = device.copy(g).?
    if !selection.grow(g, 20) { return 95 }
    if !sameRect(selection.bounds(g), 80, 80, 340, 340) || mask.at(g, 80, 250) != 255 || mask.at(g, 79, 250) != 0 || mask.at(g, 80, 80) != 0 || mask.at(g, 86, 86) != 255 || mask.at(g, 85, 86) != 0 { return 96 }
    if !selection.shrink(g, 20, everywhere, true) { return 97 }
    if !alike(g, geom.rect(60, 60, 380, 380), square, 60, 60, room, other) { return 98 }
    device.destroy(square)

    // Shrinking and the image's edge.
    if !selection.selectAll(g, image) || !selection.shrink(g, 10, image, true) { return 99 }
    if !selection.isRectangle(g, &found) || !sameRect(found, 10, 10, 180, 130) { return 100 }
    if !selection.selectAll(g, image) || !selection.shrink(g, 10, image, false) { return 101 }
    if !selection.isRectangle(g, &found) || !sameRect(found, 0, 0, 200, 150) { return 102 }
    if !selection.fromRect(g, geom.rect(0, 40, 50, 50), selection.REPLACE, 0.0) || !selection.shrink(g, 5, image, false) { return 103 }
    if !selection.isRectangle(g, &found) || !sameRect(found, 0, 45, 45, 40) { return 104 }
    if !selection.shrink(g, 5, image, true) || !selection.isRectangle(g, &found) || !sameRect(found, 5, 50, 35, 30) { return 105 }

    // In a mask of all a hole closes in when what is selected grows (it
    // keeps its corners) and widens when it shrinks (round corners).
    selection.clear(g)
    device.setDefault(g, mask.ALL)
    gray(g, geom.rect(0, 0, 40, 40), 0)
    if !selection.grow(g, 5) { return 106 }
    if mask.at(g, 4, 20) != 255 || mask.at(g, 5, 20) != 0 || mask.at(g, 5, 5) != 0 || mask.at(g, 34, 34) != 0 || mask.at(g, 35, 34) != 255 || mask.at(g, 1000, 0) != 255 { return 107 }
    selection.clear(g)
    device.setDefault(g, mask.ALL)
    gray(g, geom.rect(0, 0, 40, 40), 0)
    if !selection.shrink(g, 5, image, true) { return 108 }
    if mask.at(g, -5, 20) != 0 || mask.at(g, -6, 20) != 255 || mask.at(g, -4, -4) != 255 || mask.at(g, -3, -4) != 0 || mask.at(g, 1000, 1000) != 255 || mask.at(g, 20, 20) != 0 { return 109 }

    // Border: 10 pixels to each side of the outline, hard, whatever the
    // amounts were.
    selection.clear(g)
    gray(g, geom.rect(100, 100, 300, 300), 255)
    gray(g, geom.rect(400, 100, 3, 300), 90)
    if !selection.border(g, 0) || mask.at(g, 250, 250) != 255 { return 110 }
    if !selection.border(g, 10) { return 111 }
    if mask.at(g, 90, 250) != 255 || mask.at(g, 89, 250) != 0 || mask.at(g, 109, 250) != 255 || mask.at(g, 110, 250) != 0 || mask.at(g, 250, 250) != 0 { return 112 }
    if mask.at(g, 390, 250) != 255 || mask.at(g, 389, 250) != 0 || mask.at(g, 409, 250) != 255 || mask.at(g, 410, 250) != 0 { return 113 }
    if !sameRect(selection.bounds(g), 90, 90, 320, 320) || total(g, geom.rect(80, 250, 40, 1), room) != 20 * 255 { return 114 }
    // Around a hole in a mask of all: the band, and nothing far away.
    selection.clear(g)
    device.setDefault(g, mask.ALL)
    gray(g, geom.rect(0, 0, 40, 40), 0)
    if !selection.border(g, 3) { return 115 }
    if mask.reachesEverywhere(g) || mask.at(g, 1000, 1000) != 0 || mask.at(g, 20, 20) != 0 || mask.at(g, -3, 20) != 255 || mask.at(g, -4, 20) != 0 || mask.at(g, 2, 20) != 255 || mask.at(g, 3, 20) != 0 { return 116 }

    // Smooth: the mean of nine. A pixel sticking out of a straight edge
    // falls out of the outline, the edge stays in.
    selection.clear(g)
    gray(g, geom.rect(10, 10, 50, 50), 255)
    mask.set(g, 30, 9, 255)
    if !selection.smooth(g) { return 117 }
    if mask.at(g, 30, 9) != 113 || mask.at(g, 30, 10) != 198 || mask.at(g, 20, 9) != 85 || mask.at(g, 20, 10) != 170 || mask.at(g, 20, 11) != 255 { return 118 }
    if mask.at(g, 29, 8) != 28 || mask.at(g, 10, 10) != 113 || mask.at(g, 9, 9) != 28 || mask.at(g, 8, 8) != 0 || mask.at(g, 30, 30) != 255 { return 119 }

    // Sharpen: all or nothing at half.
    selection.clear(g)
    gray(g, geom.rect(0, 0, 10, 10), 127)
    gray(g, geom.rect(10, 0, 10, 10), 128)
    gray(g, geom.rect(20, 0, 10, 10), 200)
    gray(g, geom.rect(30, 0, 10, 10), 255)
    if !selection.sharpen(g) { return 120 }
    if mask.at(g, 5, 5) != 0 || mask.at(g, 15, 5) != 255 || mask.at(g, 25, 5) != 255 || mask.at(g, 35, 5) != 255 || !selection.isRectangle(g, &found) || !sameRect(found, 10, 0, 30, 10) { return 121 }

    // Asking: nothing, a soft rectangle, a mask of all.
    selection.clear(g)
    if !selection.isEmpty(g) || selection.isRectangle(g, &found) || !geom.isEmpty(selection.bounds(g)) { return 122 }
    gray(g, geom.rect(-70, -70, 10, 10), 200)
    if selection.isEmpty(g) || selection.isRectangle(g, &found) || !sameRect(selection.bounds(g), -70, -70, 10, 10) { return 123 }
    mask.set(g, -61, -61, 0)
    mask.set(g, -70, -70, 1)
    if !sameRect(selection.bounds(g), -70, -70, 10, 10) { return 124 }
    selection.clear(g)
    device.setDefault(g, mask.ALL)
    if selection.isEmpty(g) || selection.isRectangle(g, &found) { return 125 }
    selection.clear(g)

    // The outline of a rectangle: its four sides, in order.
    var segments = std.ArrayList(Segment).init(allocator)
    defer segments.deinit()
    gray(g, geom.rect(5, 5, 20, 10), 255)
    if !selection.outline(g, geom.rect(0, 0, 100, 100), &segments) || segments.count() != 4 { return 126 }
    if !isSegment(segments.items()[0], 5, 5, 25, 5) || !isSegment(segments.items()[1], 5, 5, 5, 15) || !isSegment(segments.items()[2], 25, 5, 25, 15) || !isSegment(segments.items()[3], 5, 15, 25, 15) { return 127 }
    // The same when the area is the rectangle itself; none inside it.
    segments.clearRetainingCapacity()
    if !selection.outline(g, geom.rect(5, 5, 20, 10), &segments) || segments.count() != 4 || !isSegment(segments.items()[3], 5, 15, 25, 15) { return 128 }
    segments.clearRetainingCapacity()
    if !selection.outline(g, geom.rect(8, 8, 5, 5), &segments) || segments.count() != 0 { return 129 }
    // Cut by the area: only what lies in it, and not closed where it is
    // cut.
    if !selection.outline(g, geom.rect(10, 0, 10, 100), &segments) || segments.count() != 2 { return 130 }
    if !isSegment(segments.items()[0], 10, 5, 20, 5) || !isSegment(segments.items()[1], 10, 15, 20, 15) { return 131 }
    segments.clearRetainingCapacity()
    if !selection.outline(g, geom.rect(0, 0, 15, 10), &segments) || segments.count() != 2 { return 132 }
    if !isSegment(segments.items()[0], 5, 5, 15, 5) || !isSegment(segments.items()[1], 5, 5, 5, 10) { return 133 }
    // (Added to what the list holds.)
    if !selection.outline(g, geom.rect(0, 0, 15, 10), &segments) || segments.count() != 4 { return 134 }
    segments.clearRetainingCapacity()

    // An L across a tile border: six sides.
    selection.clear(g)
    gray(g, geom.rect(60, 60, 10, 20), 255)
    gray(g, geom.rect(70, 70, 10, 10), 255)
    if !selection.outline(g, geom.rect(-5, -5, 200, 200), &segments) || segments.count() != 6 { return 135 }
    if !isSegment(segments.items()[0], 60, 60, 70, 60) || !isSegment(segments.items()[1], 60, 60, 60, 80) || !isSegment(segments.items()[2], 70, 60, 70, 70) { return 136 }
    if !isSegment(segments.items()[3], 70, 70, 80, 70) || !isSegment(segments.items()[4], 80, 70, 80, 80) || !isSegment(segments.items()[5], 60, 80, 80, 80) { return 137 }
    segments.clearRetainingCapacity()

    // Two pixels that touch at a corner: eight sides of one pixel's
    // length, none joined through the corner. The pixel beside them that
    // is selected by just less than half is outside.
    selection.clear(g)
    mask.set(g, 3, 3, 255)
    mask.set(g, 4, 4, 128)
    mask.set(g, 5, 4, 127)
    if !selection.outline(g, geom.rect(0, 0, 20, 20), &segments) || segments.count() != 8 { return 138 }
    if !isSegment(segments.items()[0], 3, 3, 4, 3) || !isSegment(segments.items()[1], 3, 3, 3, 4) || !isSegment(segments.items()[2], 4, 3, 4, 4) || !isSegment(segments.items()[3], 3, 4, 4, 4) { return 139 }
    if !isSegment(segments.items()[4], 4, 4, 5, 4) || !isSegment(segments.items()[5], 4, 4, 4, 5) || !isSegment(segments.items()[6], 5, 4, 5, 5) || !isSegment(segments.items()[7], 4, 5, 5, 5) { return 140 }
    segments.clearRetainingCapacity()

    // All of the image: its rim. A hole in a mask of all: the hole, and
    // no rim. Left of and above the origin.
    if !selection.selectAll(g, image) || !selection.outline(g, image, &segments) || segments.count() != 4 { return 141 }
    if !isSegment(segments.items()[0], 0, 0, 200, 0) || !isSegment(segments.items()[1], 0, 0, 0, 150) || !isSegment(segments.items()[2], 200, 0, 200, 150) || !isSegment(segments.items()[3], 0, 150, 200, 150) { return 142 }
    segments.clearRetainingCapacity()
    selection.clear(g)
    device.setDefault(g, mask.ALL)
    gray(g, geom.rect(10, 10, 5, 5), 0)
    if !selection.outline(g, geom.rect(0, 0, 50, 50), &segments) || segments.count() != 4 || !isSegment(segments.items()[0], 10, 10, 15, 10) || !isSegment(segments.items()[2], 15, 10, 15, 15) { return 143 }
    segments.clearRetainingCapacity()
    selection.clear(g)
    gray(g, geom.rect(-70, -10, 10, 5), 255)
    if !selection.outline(g, geom.rect(-100, -100, 200, 200), &segments) || segments.count() != 4 || !isSegment(segments.items()[1], -70, -10, -70, -5) || !isSegment(segments.items()[3], -70, -5, -60, -5) { return 144 }
    segments.clearRetainingCapacity()
    selection.clear(g)
    if !selection.outline(g, image, &segments) || segments.count() != 0 { return 145 }

    // A selection applied to pixels: all in one part, 100 of 255 in
    // another, nothing elsewhere; the area ends inside the soft part.
    const paint = device.create(allocator, 0).?
    const tint: u32 = 0xC0336699
    _ = device.fill(paint, geom.rect(-10, -10, 150, 100), tint)
    selection.clear(g)
    gray(g, geom.rect(0, 0, 30, 80), 255)
    gray(g, geom.rect(30, 0, 30, 80), 100)
    const part = geom.rect(0, 0, 50, 200)
    const faint = (tint & 0x00FFFFFF) | (pixel.mul(0xC0, 100) << 24)
    const copied = selection.copySelected(paint, g, part)
    if copied == null { return 146 }
    if device.pixel(copied.?, 10, 10) != tint || device.pixel(copied.?, 40, 10) != faint || device.pixel(copied.?, 49, 79) != faint { return 147 }
    if device.pixel(copied.?, 50, 10) != 0 || device.pixel(copied.?, 10, 80) != 0 || device.pixel(copied.?, -5, 10) != 0 || device.pixel(copied.?, 100, 50) != 0 { return 148 }
    if !sameRect(device.exactBounds(copied.?), 0, 0, 50, 80) || device.pixel(paint, 10, 10) != tint || device.pixel(paint, 100, 50) != tint { return 149 }
    device.destroy(copied.?)
    // No selection: all of the area; a whole tile is the source's own.
    const patch = selection.copySelected(paint, null, geom.rect(60, 60, 10, 10))
    if patch == null || !sameRect(device.exactBounds(patch.?), 60, 60, 10, 10) || device.pixel(patch.?, 60, 60) != tint || device.pixel(patch.?, 69, 69) != tint { return 150 }
    device.destroy(patch.?)
    const tile = selection.copySelected(paint, null, geom.rect(0, 0, 64, 64))
    if tile == null || device.tileCount(tile.?) != 1 || device.pixel(tile.?, 63, 63) != tint || device.pixel(tile.?, 64, 63) != 0 { return 151 }
    device.setPixel(tile.?, 5, 5, 0xFF000000)
    if device.pixel(paint, 5, 5) != tint { return 152 }
    device.destroy(tile.?)
    // A source that is something everywhere (a mask): its default too.
    const plane = mask.create(allocator, true).?
    const cut = selection.copySelected(plane, g, geom.rect(20, 0, 20, 10))
    if cut == null || device.pixel(cut.?, 25, 5) != 0xFFFFFFFF || device.pixel(cut.?, 35, 5) != 0x64FFFFFF || device.pixel(cut.?, 40, 5) != 0 || device.pixel(cut.?, 19, 5) != 0 || device.pixel(cut.?, 25, 10) != 0 { return 153 }
    device.destroy(cut.?)
    device.destroy(plane)

    // Cleared: what was selected goes, as much as it was selected, and
    // only inside the area.
    if !selection.clearSelected(paint, g, part) { return 154 }
    if device.pixel(paint, 10, 10) != 0 || device.pixel(paint, 40, 10) != ((tint & 0x00FFFFFF) | (pixel.mul(0xC0, 155) << 24)) { return 155 }
    if device.pixel(paint, 50, 10) != tint || device.pixel(paint, 10, 80) != tint || device.pixel(paint, -1, 10) != tint { return 156 }
    if !selection.clearSelected(paint, null, geom.rect(100, 0, 5, 5)) || device.pixel(paint, 100, 0) != 0 || device.pixel(paint, 104, 4) != 0 || device.pixel(paint, 105, 4) != tint || device.pixel(paint, 99, 0) != tint { return 157 }
    // Clearing where nothing is selected writes no tile.
    device.begin(paint)
    if !selection.clearSelected(paint, g, geom.rect(0, 80, 200, 200)) || device.commit(paint) != null { return 158 }
    device.destroy(paint)

    // Filled: the colour at the opacity times the amount, over opaque
    // and over translucent pixels, over nothing, and taken away (erase).
    const canvas = device.create(allocator, 0).?
    const under: u32 = 0xFF102030
    const thin: u32 = 0x80405060
    const ink: u32 = 0xFFFF8000
    _ = device.fill(canvas, geom.rect(0, 0, 100, 50), under)
    _ = device.fill(canvas, geom.rect(0, 50, 100, 50), thin)
    if !selection.fillSelected(canvas, g, everywhere, ink, blend.NORMAL, 200) { return 159 }
    if device.pixel(canvas, 10, 10) != blend.blendPixel(blend.NORMAL, under, ink, 200) || device.pixel(canvas, 40, 10) != blend.blendPixel(blend.NORMAL, under, ink, pixel.mul(200, 100)) || device.pixel(canvas, 70, 10) != under { return 160 }
    if device.pixel(canvas, 10, 60) != blend.blendPixel(blend.NORMAL, thin, ink, 200) || device.pixel(canvas, 40, 60) != blend.blendPixel(blend.NORMAL, thin, ink, pixel.mul(200, 100)) || device.pixel(canvas, 10, 80) != thin { return 161 }
    if device.pixel(canvas, 10, 10) == under || device.pixel(canvas, 40, 60) == thin { return 162 }
    const was = device.pixel(canvas, 40, 10)
    if !selection.fillSelected(canvas, g, everywhere, 0xFF000000, blend.ERASE, 255) { return 163 }
    if device.pixel(canvas, 10, 10) != 0 || device.pixel(canvas, 40, 10) != blend.blendPixel(blend.ERASE, was, 0xFF000000, 100) || device.pixel(canvas, 70, 10) != under { return 164 }
    device.clear(canvas)
    if !selection.fillSelected(canvas, g, everywhere, ink, blend.NORMAL, 255) { return 165 }
    if device.pixel(canvas, 10, 10) != ink || device.pixel(canvas, 40, 10) != 0x64FF8000 || device.pixel(canvas, 70, 10) != 0 || device.tileCount(canvas) != 2 { return 166 }
    device.clear(canvas)
    if !selection.fillSelected(canvas, g, everywhere, ink, blend.NORMAL, 0) || device.tileCount(canvas) != 0 { return 167 }
    if !selection.fillSelected(canvas, null, geom.rect(-5, -5, 10, 10), ink, blend.NORMAL, 255) { return 168 }
    if !sameRect(device.exactBounds(canvas), -5, -5, 10, 10) || device.pixel(canvas, -5, -5) != ink || device.pixel(canvas, 4, 4) != ink { return 169 }
    device.destroy(canvas)

    // Only what differs is written: adding what is selected already is
    // no change, and growing a square of 25 tiles by a pixel makes the
    // 20 tiles around it (not the corners) and touches no other.
    selection.clear(g)
    gray(g, geom.rect(0, 0, 320, 320), 255)
    device.begin(g)
    if !selection.fromRect(g, geom.rect(10, 10, 100, 100), selection.ADD, 0.0) || device.commit(g) != null { return 170 }
    device.begin(g)
    if !selection.grow(g, 1) { return 171 }
    const change = device.commit(g)
    if change == null || change.?.*.count != 20 || mask.at(g, -1, 100) != 255 || mask.at(g, -1, -1) != 0 { return 172 }
    // Undone, the square is back.
    _ = device.apply(g, change.?, true)
    if !selection.isRectangle(g, &found) || !sameRect(found, 0, 0, 320, 320) { return 173 }
    device.destroyChange(change.?)

    // Nothing of all this takes memory that stays taken: a hundred
    // rounds of everything.
    const stage = device.create(allocator, 0).?
    const arena = turns.locate()
    const used = turns.used(arena)
    var round: u32 = 0
    while round < 100 {
        if !selection.fromRect(g, geom.rect(-10, 10, 150, 80), selection.REPLACE, 0.0) || !selection.feather(g, 4.0) { return 174 }
        if !selection.grow(g, 3) || !selection.shrink(g, 3, image, false) || !selection.smooth(g) || !selection.combine(g, b, selection.SYMMETRIC_DIFFERENCE) { return 175 }
        if !selection.invert(g, image) || !selection.clip(g, image) || !selection.border(g, 2) || !selection.sharpen(g) { return 176 }
        segments.clearRetainingCapacity()
        if !selection.outline(g, image, &segments) || segments.count() == 0 || selection.isEmpty(g) || selection.isRectangle(g, &found) { return 177 }
        if !selection.fillSelected(stage, g, image, ink, blend.NORMAL, 128) || !selection.clearSelected(stage, g, image) { return 178 }
        const lifted = selection.copySelected(stage, g, image)
        if lifted == null { return 179 }
        device.destroy(lifted.?)
        round += 1
    }
    if turns.used(arena) - used > 65536 { return 180 }
    device.destroy(stage)

    // 2048 x 2048, all selected, feathered and grown by 20 pixels: in
    // several bands, which must not show. The time is printed.
    const large = geom.rect(0, 0, 2048, 2048)
    if !selection.selectAll(g, large) { return 181 }
    var started = std.time.milliseconds()
    if !selection.feather(g, 20.0) { return 182 }
    printTime("feather 20 on 2048 x 2048: ", std.time.milliseconds() - started)
    // (The last pixels of a wide feather are less than half a level:
    // nothing.)
    const feathered = selection.bounds(g)
    if feathered.x < -20 || feathered.x > -17 || feathered.y != feathered.x || feathered.width != 2048 - feathered.x * 2 || feathered.height != feathered.width { return 183 }
    if mask.at(g, 1000, 1000) != 255 || mask.at(g, -1, 1000) + mask.at(g, 0, 1000) != 255 || mask.at(g, -21, 1000) != 0 || mask.at(g, 20, 1000) != 255 { return 191 }
    // Down a column near the left edge and along the row near the top
    // edge the amounts are the same, and the same from both ends.
    mask.readBytes(g, geom.rect(3, -24, 1, 2096), room, 1)
    mask.readBytes(g, geom.rect(-24, 3, 2096, 1), other, 2096)
    var index: usize = 0
    while index < 2096 {
        if room[index] != other[index] || room[index] != room[2095 - index] { return 184 }
        index += 1
    }
    if !selection.selectAll(g, large) { return 185 }
    mask.set(g, 1000, 1000, 0)
    started = std.time.milliseconds()
    if !selection.grow(g, 20) { return 186 }
    printTime("grow 20 on 2048 x 2048: ", std.time.milliseconds() - started)
    if !sameRect(selection.bounds(g), -20, -20, 2088, 2088) || mask.at(g, 1000, 1000) != 255 || mask.at(g, -20, 1000) != 255 || mask.at(g, -20, -20) != 0 || mask.at(g, -14, -14) != 255 { return 187 }
    // The round corners are the same at all four ends, whatever band
    // they were in.
    mask.readBytes(g, geom.rect(-24, -24, 2096, 30), room, 2096)
    mask.readBytes(g, geom.rect(-24, 2042, 2096, 30), other, 2096)
    index = 0
    while index < 2096 * 30 {
        const row = index / 2096
        const at = index % 2096
        if room[index] != other[(29 - row) * 2096 + at] || room[index] != room[row * 2096 + 2095 - at] { return 188 }
        index += 1
    }
    started = std.time.milliseconds()
    if !selection.shrink(g, 20, large, true) { return 189 }
    printTime("shrink 20 on 2048 x 2048: ", std.time.milliseconds() - started)
    if !selection.isRectangle(g, &found) || !sameRect(found, 0, 0, 2048, 2048) { return 190 }

    device.destroy(g)
    device.destroy(s)
    device.destroy(a)
    device.destroy(b)
    allocator.free(room, ROOM, 16)
    allocator.free(other, ROOM, 16)
    return 13
}
