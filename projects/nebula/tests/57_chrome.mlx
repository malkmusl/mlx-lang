// The window around the canvas (ui/chrome.mlx and its parts), played
// without a window as a person would: the layout at 1280 x 800, 1024 x
// 768 and 800 x 600 (no two parts overlap, all inside the window, the
// canvas 480 wide at 1024), with the canvas only, and too short for two
// columns of tools; the toolbar's size slider along its curve, opacity
// from 0 to 1, the eraser, undo and redo disabled on a new image and
// working after a stroke, the blend mode chosen from its list, the
// controls that go into the "more" list when the window is narrow and a
// toggle switched there; the toolbox's buttons; two documents' tabs, the
// dot of changes, closing by the cross and by the middle button; the
// history docker going back a step and to the original state, and by
// keys over it (also at its ends); the grip between dock and canvas
// within its limits; a panel folded; a docker hidden and shown, all of
// them hidden and shown; tabs dragged into a panel of their own, into
// another panel, onto their own place, to the canvas's edge (the left
// area opens) and back; a panel 0 pixels tall made larger by its grip;
// the layout as text and back, and texts that are not of its form
// refused; the overview's picture of a red image, of a new image in a
// closed one's memory, after a stroke against a second making of it, and
// its outline dragged; the status bar's fields (the selection's size,
// also of a new image in a closed one's memory, the pointer's place on
// the image, the memory, the zoom held), its note in red for a failure,
// its zoom buttons; German, with no slider's name cut at 1024; windows
// of every size down to none (nothing traps, nothing lies outside its
// part); sixteen documents' tabs; everything around the canvas opaque,
// light and dark; no growth of the value arena and of the heap over 300
// frames. Pictures: chrome-1280.png, chrome-1024.png, chrome-800.png,
// chrome-german.png, chrome-light.png and chrome-dark.png (and
// chrome-more.png with the list open), in the current directory and,
// when NEBULA_SHOTS names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const ui_keys = @import("std.ui.keys")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const loop = @import("../app/loop.mlx")
const documents = @import("../app/documents.mlx")
const brushes = @import("../app/brushes.mlx")
const viewport = @import("../ui/viewport.mlx")
const chrome = @import("../ui/chrome.mlx")
const toolbar = @import("../ui/toolbar.mlx")
const toolbox = @import("../ui/toolbox.mlx")
const tabbar = @import("../ui/tabbar.mlx")
const statusbar = @import("../ui/statusbar.mlx")
const docks = @import("../ui/docks.mlx")
const kit_module = @import("../ui/kit.mlx")
const history_docker = @import("../dockers/history.mlx")
const overview = @import("../dockers/overview.mlx")
const tools = @import("../tools/registry.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const image_module = @import("../core/image.mlx")
const render = @import("../core/render.mlx")
const blend = @import("../core/blend.mlx")
const geom = @import("../core/geom.mlx")
const ops = @import("../core/ops.mlx")
const selection = @import("../core/selection.mlx")
const tilepool = @import("../core/tilepool.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const text_module = @import("std.ui.text")

const App = state.App

// A script being put together.
var buffer: [1024]u8 = undefined
var used: usize = 0
// Where the pictures go besides the current directory (NEBULA_SHOTS).
var shotsAt: usize = 0
var shotsLength: usize = 0

fn start() -> void { used = 0 }
fn add(text: []const u8) -> void { used = std.text.append(&buffer, used, 1024, text) }
fn addNumber(value: i32) -> void { used = std.text.appendSigned(&buffer, used, 1024, @intCast(isize, value)) }

fn play(app: *App) -> bool {
    const bytes: [*]const u8 = &buffer
    return script.run(app, bytes[0..used])
}

fn point(app: *App, command: []const u8, x: i32, y: i32) -> bool {
    start()
    add(command)
    add(" ")
    addNumber(x)
    add(" ")
    addNumber(y)
    add("\n")
    return play(app)
}

fn click(app: *App, x: i32, y: i32) -> bool { return point(app, "click", x, y) }
fn pointer(app: *App, x: i32, y: i32) -> bool { return point(app, "pointer", x, y) }

fn middleX(area: ui.Rect) -> i32 { return area.x + area.width / 2 }
fn middleY(area: ui.Rect) -> i32 { return area.y + area.height / 2 }

fn clickIn(app: *App, area: ui.Rect) -> bool {
    if ui.isEmpty(area) { return false }
    return click(app, middleX(area), middleY(area))
}

fn drag(app: *App, x0: i32, y0: i32, x1: i32, y1: i32) -> bool { return dragIn(app, x0, y0, x1, y1, 8) }

// A drag in `steps` motions.
fn dragIn(app: *App, x0: i32, y0: i32, x1: i32, y1: i32, steps: i32) -> bool {
    start()
    add("drag ")
    addNumber(x0)
    add(" ")
    addNumber(y0)
    add(" ")
    addNumber(x1)
    add(" ")
    addNumber(y1)
    add(" ")
    addNumber(steps)
    add("\n")
    return play(app)
}

// The pixel the image shows at window place (x, y).
fn shownAt(app: *App, x: i32, y: i32) -> u32 {
    const doc = api.document(app).?
    var ix: f64 = 0.0
    var iy: f64 = 0.0
    viewport.toImage(&doc.*.view, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &ix, &iy)
    _ = render.update(doc.*.image)
    return device.pixel(doc.*.image.*.projection, @intFromFloat(i32, @floor(ix)), @intFromFloat(i32, @floor(iy)))
}

// The window's pixel at (x, y) in the last frame.
fn windowAt(app: *App, x: i32, y: i32) -> u32 {
    const frame = script.frameOf(app).?
    return frame.*.pixels[@intCast(usize, y) * frame.*.stride + @intCast(usize, x)]
}

// The frame as a picture here and in the shots' directory.
fn save(app: *App, name: []const u8) -> bool {
    start()
    add("shot ")
    add(name)
    add("\n")
    if !play(app) { return false }
    if shotsLength == 0 || shotsLength > 400 { return true }
    const shots = unsafe { @ptrFromInt([*]const u8, shotsAt) }[0..shotsLength]
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, shots)
    if bytes[length - 1] != '/' { length = std.text.appendByte(bytes, length, 599, '/') }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    const frame = script.frameOf(app).?
    return png.saveFile(bytes, frame.*.pixels, frame.*.width, frame.*.height, frame.*.stride, false, app.*.allocator)
}

fn inside(part: ui.Rect, window: ui.Rect) -> bool {
    return part.x >= window.x && part.y >= window.y && ui.right(part) <= ui.right(window) && ui.bottom(part) <= ui.bottom(window)
}

// The window's parts as laid out now: inside the window, none over
// another, the canvas `least` wide at least.
fn checkLayout(app: *App, least: i32) -> bool {
    var parts: [8]ui.Rect = [8]ui.Rect{ app.*.menuBar, app.*.toolBar, app.*.tabBar, chrome.toolboxArea(app), app.*.leftDock, app.*.rightDock, app.*.canvasArea, app.*.statusBar }
    var index: usize = 0
    while index < 8 {
        if !ui.isEmpty(parts[index]) {
            if !inside(parts[index], app.*.window) { return false }
            var other = index + 1
            while other < 8 {
                if !ui.isEmpty(parts[other]) && !ui.isEmpty(ui.intersect(parts[index], parts[other])) { return false }
                other += 1
            }
        }
        index += 1
    }
    if app.*.canvasArea.width < least || ui.isEmpty(app.*.toolBar) || ui.isEmpty(app.*.statusBar) || ui.isEmpty(chrome.toolboxArea(app)) { return false }
    // The toolbar's controls lie inside it and none over another.
    index = 0
    while index < toolbar.ITEMS {
        const area = toolbar.itemArea(app, index)
        if !ui.isEmpty(area) {
            if !inside(area, app.*.toolBar) { return false }
            var other = index + 1
            while other < toolbar.ITEMS {
                const next = toolbar.itemArea(app, other)
                if !ui.isEmpty(next) && !ui.isEmpty(ui.intersect(area, next)) { return false }
                other += 1
            }
        }
        index += 1
    }
    return true
}

fn sized(app: *App, width: i32, height: i32) -> bool {
    start()
    add("size ")
    addNumber(width)
    add(" ")
    addNumber(height)
    add("\npointer 2 2\n")
    return play(app)
}

fn near(a: f64, b: f64, slack: f64) -> bool { return a - b <= slack && b - a <= slack }

// A frame of a window `width` x `height` drawn into pixels of the test's
// own, as a host would (a layout pass's canvas for an empty window).
fn frameOfSize(app: *App, width: i32, height: i32) -> bool {
    app.*.shell.*.width = width
    app.*.shell.*.height = height
    api.redraw(app)
    if width <= 0 || height <= 0 {
        var nowhere = view.layoutCanvas()
        loop.frame(app, &nowhere)
        return true
    }
    const words = @intCast(usize, width) * @intCast(usize, height)
    const memory = app.*.allocator.alloc(words * 4, 16)
    if memory == null { return false }
    var canvas = state.Canvas.{ .pixels = unsafe { @ptrCast([*]u32, memory.?) }, .width = @intCast(usize, width), .height = @intCast(usize, height), .stride = @intCast(usize, width), .swapRedBlue = false, .device = 0, .opacity = 255 }
    loop.frame(app, &canvas)
    app.*.allocator.free(memory.?, words * 4, 16)
    return true
}

fn insideEither(part: ui.Rect, one: ui.Rect, other: ui.Rect) -> bool {
    return (!ui.isEmpty(one) && inside(part, one)) || (!ui.isEmpty(other) && inside(part, other))
}

// What checkLayout says of any window, however small: the parts in the
// window and apart, and what is inside a part (the toolbar's controls,
// the zoom's, the dockers' tabs and contents, the documents' tabs, the
// first tool's button when it is in sight) inside that part.
fn partsApart(app: *App) -> bool {
    var parts: [8]ui.Rect = [8]ui.Rect{ app.*.menuBar, app.*.toolBar, app.*.tabBar, chrome.toolboxArea(app), app.*.leftDock, app.*.rightDock, app.*.canvasArea, app.*.statusBar }
    var index: usize = 0
    while index < 8 {
        if !ui.isEmpty(parts[index]) {
            if !inside(parts[index], app.*.window) { return false }
            var other = index + 1
            while other < 8 {
                if !ui.isEmpty(parts[other]) && !ui.isEmpty(ui.intersect(parts[index], parts[other])) { return false }
                other += 1
            }
        }
        index += 1
    }
    index = 0
    while index < toolbar.ITEMS {
        const area = toolbar.itemArea(app, index)
        if !ui.isEmpty(area) {
            if !inside(area, app.*.toolBar) { return false }
            var other = index + 1
            while other < toolbar.ITEMS {
                const next = toolbar.itemArea(app, other)
                if !ui.isEmpty(next) && !ui.isEmpty(ui.intersect(area, next)) { return false }
                other += 1
            }
        }
        index += 1
    }
    index = 0
    while index < 3 {
        const zoom = statusbar.zoomArea(app, index)
        if !ui.isEmpty(zoom) && !inside(zoom, app.*.statusBar) { return false }
        index += 1
    }
    var ids: [2]u8 = [2]u8{ history_docker.ID, overview.ID }
    index = 0
    while index < 2 {
        const tab = docks.tabOf(app, ids[index])
        if !ui.isEmpty(tab) && !insideEither(tab, app.*.leftDock, app.*.rightDock) { return false }
        const content = docks.contentOf(app, ids[index])
        if !ui.isEmpty(content) && !insideEither(content, app.*.leftDock, app.*.rightDock) { return false }
        index += 1
    }
    index = 0
    while index < app.*.count {
        const tab = tabbar.tabArea(app, index)
        if !ui.isEmpty(tab) && !inside(tab, app.*.tabBar) { return false }
        index += 1
    }
    const column = chrome.toolboxArea(app)
    const button = toolbox.buttonArea(app, 0)
    // (A column the window cuts narrower than a button: what is beyond
    // the window is neither seen nor pressed.)
    if !ui.isEmpty(button) && !ui.isEmpty(ui.intersect(button, column)) && ui.right(button) > ui.right(column) && ui.right(column) < ui.right(app.*.window) { return false }
    return true
}

// How many pixels of the last frame outside the canvas are not opaque.
fn seeThrough(app: *App) -> usize {
    const frame = script.frameOf(app).?
    const canvas = app.*.canvasArea
    var count: usize = 0
    var y: usize = 0
    while y < frame.*.height {
        var x: usize = 0
        while x < frame.*.width {
            if !ui.contains(canvas, @intCast(i32, x), @intCast(i32, y)) && frame.*.pixels[y * frame.*.stride + x] >> 24 != 255 { count += 1 }
            x += 1
        }
        y += 1
    }
    return count
}

// The layout's text form now.
var layoutText: [2048]u8 = undefined
var layoutLength: usize = 0
fn keepLayout(app: *App) -> bool {
    var text = std.ArrayList(u8).init(app.*.allocator)
    if !docks.write(app, &text) || text.items().length > 2048 { return false }
    layoutLength = 0
    for byte in text.items() {
        layoutText[layoutLength] = byte
        layoutLength += 1
    }
    return true
}

fn sameLayout(app: *App) -> bool {
    var text = std.ArrayList(u8).init(app.*.allocator)
    if !docks.write(app, &text) { return false }
    const kept: [*]const u8 = &layoutText
    return std.text.same(text.items(), kept[0..layoutLength])
}

fn countOf(text: []const u8, word: []const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at + word.length <= text.length {
        if std.text.same(text[at..at + word.length], word) { count += 1 }
        at += 1
    }
    return count
}

fn panels(app: *App) -> usize {
    var text = std.ArrayList(u8).init(app.*.allocator)
    if !docks.write(app, &text) { return 0 }
    return countOf(text.items(), "panel ")
}

// Every document closed (as the tab bar does when there is no action
// for it).
fn closeAll(app: *App) -> void {
    while app.*.count > 0 {
        canvasview.forget(app, app.*.documents[0].?)
        documents.close(app, 0)
    }
}

// Whether the overview's picture is all `color`.
fn thumbnailAll(app: *App, color: u32) -> bool {
    const small = overview.thumbnail(app)
    if small.width < 8 || small.height < 8 { return false }
    var at: usize = 0
    while at < @intCast(usize, small.width * small.height) {
        if small.pixels[at] != color { return false }
        at += 1
    }
    return true
}

fn differs(a: u32, b: u32, shift: u32) -> u32 {
    const x = (a >> shift) & 255
    const y = (b >> shift) & 255
    return if x > y { x - y } else { y - x }
}

// The overview's picture of an opaque image against a second, plain
// making of it: each picture pixel the mean of the image's block of
// pixels it stands for (the image's width and height cut in as many
// equal parts as the picture has columns and rows, a part at least a
// pixel), within 1 a channel. How many picture pixels are not the
// image's first pixel's colour goes to `others`.
fn thumbnailMatches(app: *App, others: *usize) -> bool {
    const small = overview.thumbnail(app)
    const picture = api.image(app).?
    _ = render.update(picture)
    const width = picture.*.width
    const height = picture.*.height
    if small.width < 8 || small.height < 8 { return false }
    const first = device.pixel(picture.*.projection, 0, 0)
    others.* = 0
    var ty: i32 = 0
    while ty < small.height {
        const y0 = ty * height / small.height
        var y1 = (ty + 1) * height / small.height
        if y1 <= y0 { y1 = y0 + 1 }
        var tx: i32 = 0
        while tx < small.width {
            const x0 = tx * width / small.width
            var x1 = (tx + 1) * width / small.width
            if x1 <= x0 { x1 = x0 + 1 }
            var red: u32 = 0
            var green: u32 = 0
            var blue: u32 = 0
            var count: u32 = 0
            var y = y0
            while y < y1 {
                var x = x0
                while x < x1 {
                    const value = device.pixel(picture.*.projection, x, y)
                    red += (value >> 16) & 255
                    green += (value >> 8) & 255
                    blue += value & 255
                    count += 1
                    x += 1
                }
                y += 1
            }
            const expected = 0xFF000000 | (((red * 2 + count) / (count * 2)) << 16) | (((green * 2 + count) / (count * 2)) << 8) | ((blue * 2 + count) / (count * 2))
            const got = small.pixels[@intCast(usize, ty * small.width + tx)]
            if got >> 24 != 255 || differs(got, expected, 16) > 1 || differs(got, expected, 8) > 1 || differs(got, expected, 0) > 1 { return false }
            if got != first { others.* += 1 }
            tx += 1
        }
        ty += 1
    }
    return true
}

// A rectangle selected on the image in front, as a tool does.
fn selectRect(app: *App, area: geom.Rect) -> bool {
    const picture = api.image(app).?
    ops.beginSelection(picture)
    if !selection.fromRect(picture.*.selection, area, selection.REPLACE, 0.0) { return false }
    ops.endSelection(picture, true, "Select")
    api.redraw(app)
    return true
}

// How many pixels of the last frame in `area` are clearly red (text is
// smoothed: its pixels are the colour mixed with what is under it).
fn reddish(app: *App, area: ui.Rect) -> usize {
    const frame = script.frameOf(app).?
    var count: usize = 0
    var row = area.y
    while row < ui.bottom(area) {
        var column = area.x
        while column < ui.right(area) {
            const value = frame.*.pixels[@intCast(usize, row) * frame.*.stride + @intCast(usize, column)]
            const red = (value >> 16) & 255
            if red > ((value >> 8) & 255) + 64 && red > (value & 255) + 64 { count += 1 }
            column += 1
        }
        row += 1
    }
    return count
}

// The window place on the canvas where the frame shows `color` first
// (false: nowhere).
fn findInFrame(app: *App, color: u32, x: *i32, y: *i32) -> bool {
    const frame = script.frameOf(app).?
    const canvas = app.*.canvasArea
    var row = canvas.y
    while row < ui.bottom(canvas) {
        var column = canvas.x
        while column < ui.right(canvas) {
            if frame.*.pixels[@intCast(usize, row) * frame.*.stride + @intCast(usize, column)] == color {
                x.* = column
                y.* = row
                return true
            }
            column += 1
        }
        row += 1
    }
    return false
}

// What a status bar field says.
var said: [256]u8 = undefined
fn field(app: *App, which: u8) -> []const u8 {
    const length = statusbar.text(app, which, &said)
    const bytes: [*]const u8 = &said
    return bytes[0..length]
}

// Frames one after another, the value arena given back before each as a
// window's loop does: each takes what the one before took (std.ui's text
// takes some for every line it draws), far less than a canvas of pixels
// would; and the heap holds what it held after the first few.
fn steady(app: *App) -> u8 {
    const canvas = script.frameOf(app).?
    var loop_turns: turns.Turns = undefined
    turns.begin(&loop_turns, true, false)
    const arena = loop_turns.base
    const mark = turns.used(arena)
    var first: usize = 0
    var live: usize = 0
    var round: usize = 0
    while round < 300 {
        turns.turn(&loop_turns)
        app.*.shell.*.clock += 16
        api.redraw(app)
        loop.frame(app, canvas)
        const now = turns.used(arena) - mark
        if round == 4 {
            first = now
            live = std.heap.liveBytes()
        }
        if round > 4 {
            const off = if now > first { now - first } else { first - now }
            if off != 0 || now > 1048576 { return 1 }
            if std.heap.liveBytes() != live { return 2 }
        }
        round += 1
    }
    turns.turn(&loop_turns)
    if turns.used(arena) != mark { return 3 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null {
        const shots = std.string.asSlice(named.?)
        shotsAt = @intFromPtr(shots.pointer)
        shotsLength = shots.length
    }
    const made = script.headless(allocator)
    if made == null { return 2 }
    const app = made.?

    // The layout at three sizes, and the canvas alone.
    if !script.run(app, "size 1280 800\nnew 640 480 FFFFFF\n") { return 3 }
    if !checkLayout(app, 480) || ui.isEmpty(app.*.rightDock) || ui.isEmpty(app.*.tabBar) { return 4 }
    // At 1024 every control of the toolbar has its place in it.
    if !sized(app, 1024, 768) || !checkLayout(app, 480) || ui.isEmpty(app.*.rightDock) || toolbar.isDropped(app, toolbar.ITEM_WRAP) || toolbar.isDropped(app, toolbar.ITEM_ERASER) { return 5 }
    if !sized(app, 800, 600) || !checkLayout(app, 200) { return 6 }
    // At 800 the controls at the right went into the "more" list.
    if !toolbar.isDropped(app, toolbar.ITEM_WRAP) || ui.isEmpty(toolbar.itemArea(app, toolbar.ITEM_MORE)) || ui.isEmpty(toolbar.itemArea(app, toolbar.ITEM_SIZE)) { return 7 }
    if !clickIn(app, toolbar.itemArea(app, toolbar.ITEM_MORE)) || !toolbar.moreOpen(app) { return 8 }
    if !save(app, "chrome-more.png") { return 9 }
    // A press beside the list closes it and does nothing else.
    if !click(app, 400, 300) || toolbar.moreOpen(app) || history.stepCount(api.image(app).?.*.history) != 0 { return 10 }
    app.*.canvasOnly = true
    chrome.layOut(app, 1024, 768)
    if app.*.canvasArea.width != 1024 || app.*.canvasArea.height != 768 || !ui.isEmpty(app.*.toolBar) || !ui.isEmpty(app.*.rightDock) || !ui.isEmpty(chrome.toolboxArea(app)) { return 11 }
    app.*.canvasOnly = false
    // A window too short for two columns of tools: the toolbox is wider
    // (three columns, a scroll bar when even those do not fit), the parts
    // still apart.
    chrome.layOut(app, 1280, 800)
    const two_columns = chrome.toolboxArea(app).width
    chrome.layOut(app, 900, 160)
    if chrome.toolboxArea(app).width <= two_columns { return 12 }
    if !checkLayout(app, 200) { return 14 }
    if !sized(app, 1280, 800) || !checkLayout(app, 480) || chrome.toolboxArea(app).width != two_columns { return 15 }

    // The size slider dragged to its middle: the size along the curve
    // (the left half of the bar is the smallest eighth of the sizes).
    const size_area = toolbar.itemArea(app, toolbar.ITEM_SIZE)
    if ui.isEmpty(size_area) { return 16 }
    const middle = size_area.x + size_area.width / 2
    if !drag(app, size_area.x + 10, middleY(size_area), middle, middleY(size_area)) { return 17 }
    const position = @floatFromInt(f64, middle - size_area.x) / @floatFromInt(f64, size_area.width)
    const expected = 0.01 + (1000.0 - 0.01) * position * position * position
    if !near(brushes.current(app).*.size, expected, 0.011) { return 18 }
    // Opacity: all the way down and up.
    const opacity_area = toolbar.itemArea(app, toolbar.ITEM_OPACITY)
    if !drag(app, middleX(opacity_area), middleY(opacity_area), opacity_area.x - 40, middleY(opacity_area)) || brushes.current(app).*.opacity != 0.0 { return 19 }
    if !drag(app, middleX(opacity_area), middleY(opacity_area), ui.right(opacity_area) + 40, middleY(opacity_area)) || brushes.current(app).*.opacity != 1.0 { return 20 }
    brushes.setSize(app, 12.0)

    // The eraser on and off.
    const eraser = toolbar.itemArea(app, toolbar.ITEM_ERASER)
    if !clickIn(app, eraser) || !app.*.eraser { return 21 }
    if !clickIn(app, eraser) || app.*.eraser { return 22 }

    // Undo and redo take no press on a new image; after a stroke they work.
    const widgets = state.uiOf(app)
    const undo = toolbar.itemArea(app, toolbar.ITEM_UNDO)
    const redo = toolbar.itemArea(app, toolbar.ITEM_REDO)
    if !pointer(app, middleX(undo), middleY(undo)) || view.hitAt(widgets, middleX(undo), middleY(undo)) == toolbar.idOfItem(toolbar.ITEM_UNDO) { return 23 }
    const canvas = app.*.canvasArea
    if !script.run(app, "color 2040C0\n") { return 24 }
    const stroke_y = middleY(canvas)
    if !drag(app, middleX(canvas) - 60, stroke_y, middleX(canvas) + 60, stroke_y) { return 25 }
    if shownAt(app, middleX(canvas), stroke_y) != 0xFF2040C0 { return 26 }
    if !pointer(app, middleX(undo), middleY(undo)) || view.hitAt(widgets, middleX(undo), middleY(undo)) != toolbar.idOfItem(toolbar.ITEM_UNDO) { return 27 }
    if !clickIn(app, undo) || shownAt(app, middleX(canvas), stroke_y) != 0xFFFFFFFF { return 28 }
    if !clickIn(app, redo) || shownAt(app, middleX(canvas), stroke_y) != 0xFF2040C0 { return 29 }

    // The blend mode from its list: opened, a name typed, Enter.
    if !clickIn(app, toolbar.itemArea(app, toolbar.ITEM_BLEND)) || !kit_module.wantsKeys(api.kit(app)) { return 30 }
    if !script.run(app, "type multiply\nkey Enter\n") || brushes.current(app).*.blend != blend.MULTIPLY { return 31 }
    brushes.current(app).*.blend = blend.NORMAL

    // The toolbox: a button for every tool, the one clicked in use.
    const tool_count = tools.count()
    if tool_count == 0 { return 32 }
    var index: usize = 0
    while index < tool_count {
        const button = toolbox.buttonArea(app, index)
        if ui.isEmpty(button) || !inside(button, chrome.toolboxArea(app)) { return 33 }
        index += 1
    }
    app.*.tool = state.NO_TOOL
    if !clickIn(app, toolbox.buttonArea(app, 0)) || app.*.tool != tools.at(0).?.*.id { return 34 }

    // Two documents: two tabs; the first clicked comes in front; a stroke
    // on the second shows its dot; its cross closes it.
    if !script.run(app, "new 320 240 FFFFFF\n") || app.*.count != 2 || app.*.current != 1 { return 35 }
    if ui.isEmpty(tabbar.tabArea(app, 0)) || ui.isEmpty(tabbar.tabArea(app, 1)) { return 36 }
    const dot = tabbar.closeArea(app, 1)
    if !pointer(app, 5, ui.bottom(app.*.toolBar) + 100) || windowAt(app, middleX(dot), middleY(dot)) == app.*.theme.text { return 37 }
    if !drag(app, middleX(app.*.canvasArea) - 20, middleY(app.*.canvasArea), middleX(app.*.canvasArea) + 20, middleY(app.*.canvasArea)) { return 38 }
    if !documents.isModified(api.document(app).?) { return 39 }
    if !pointer(app, 5, ui.bottom(app.*.toolBar) + 100) || windowAt(app, middleX(dot), middleY(dot)) != app.*.theme.text { return 40 }
    if !clickIn(app, tabbar.tabArea(app, 0)) || app.*.current != 0 { return 41 }
    const second = tabbar.tabArea(app, 1)
    if !pointer(app, middleX(second), middleY(second)) || !clickIn(app, tabbar.closeArea(app, 1)) || app.*.count != 1 { return 42 }
    // The middle button on a tab closes it too.
    if !script.run(app, "new 100 100\n") || app.*.count != 2 { return 43 }
    const third = tabbar.tabArea(app, 1)
    if !chrome.press(app, ui_app.BUTTON_MIDDLE, middleX(third), middleY(third)) || app.*.count != 1 { return 44 }

    // The history docker: two strokes on a new image; the first step's
    // row undoes the second, the original state's both.
    if !script.run(app, "new 400 300 FFFFFF\ncolor 20A040\n") { return 45 }
    if !sized(app, 1280, 800) { return 46 }
    const area = app.*.canvasArea
    const first_y = middleY(area) - 40
    const second_y = middleY(area) + 40
    if !drag(app, middleX(area) - 50, first_y, middleX(area) + 50, first_y) { return 47 }
    if !drag(app, middleX(area) - 50, second_y, middleX(area) + 50, second_y) { return 48 }
    const steps = api.image(app).?.*.history
    if history.stepCount(steps) != 2 || history.stepsDone(steps) != 2 { return 49 }
    if shownAt(app, middleX(area), second_y) != 0xFF20A040 { return 50 }
    if ui.isEmpty(history_docker.rowArea(app, 2)) || !ui.isEmpty(history_docker.rowArea(app, 3)) { return 51 }
    if !clickIn(app, history_docker.rowArea(app, 1)) || history.stepsDone(steps) != 1 { return 52 }
    if shownAt(app, middleX(area), second_y) != 0xFFFFFFFF || shownAt(app, middleX(area), first_y) != 0xFF20A040 { return 53 }
    if !clickIn(app, history_docker.rowArea(app, 0)) || history.stepsDone(steps) != 0 || shownAt(app, middleX(area), first_y) != 0xFFFFFFFF { return 54 }
    if !clickIn(app, history_docker.rowArea(app, 2)) || history.stepsDone(steps) != 2 { return 55 }
    // Up and Down over the docker step back and forth; elsewhere a key is
    // not the docker's.
    const list = docks.contentOf(app, history_docker.ID)
    if !pointer(app, middleX(list), middleY(list)) || !chrome.key(app, ui_keys.UP, 0, "") || history.stepsDone(steps) != 1 { return 56 }
    if !chrome.key(app, ui_keys.DOWN, 0, "") || history.stepsDone(steps) != 2 { return 57 }
    if !pointer(app, middleX(area), middleY(area)) || chrome.key(app, ui_keys.UP, 0, "") || history.stepsDone(steps) != 2 { return 58 }

    // The grip between the right dock and the canvas: wider by what it was
    // dragged, the canvas narrower as much; held between the limits.
    const grip = docks.gripOf(app, docks.AREA_RIGHT)
    const dock_before = app.*.rightDock.width
    const canvas_before = app.*.canvasArea.width
    if ui.isEmpty(grip) || !drag(app, middleX(grip), middleY(grip), middleX(grip) - 60, middleY(grip)) { return 59 }
    if app.*.rightDock.width != dock_before + 60 || app.*.canvasArea.width != canvas_before - 60 { return 60 }
    var moved = docks.gripOf(app, docks.AREA_RIGHT)
    if !drag(app, middleX(moved), middleY(moved), middleX(moved) - 600, middleY(moved)) || app.*.rightDock.width != docks.LARGEST_WIDTH { return 61 }
    moved = docks.gripOf(app, docks.AREA_RIGHT)
    if !drag(app, middleX(moved), middleY(moved), middleX(moved) + 600, middleY(moved)) || app.*.rightDock.width != docks.SMALLEST_WIDTH { return 62 }
    docks.setAreaWidth(app, docks.AREA_RIGHT, docks.DEFAULT_WIDTH)
    if !pointer(app, 2, 2) || app.*.rightDock.width != docks.DEFAULT_WIDTH { return 63 }

    // A panel folded shows its tabs only; open again.
    const fold = docks.foldOf(app, history_docker.ID)
    if !clickIn(app, fold) || !ui.isEmpty(docks.contentOf(app, history_docker.ID)) || !ui.isEmpty(history_docker.rowArea(app, 0)) { return 64 }
    if ui.isEmpty(docks.tabOf(app, history_docker.ID)) { return 65 }
    if !clickIn(app, docks.foldOf(app, history_docker.ID)) || ui.isEmpty(docks.contentOf(app, history_docker.ID)) { return 66 }

    // Hidden and shown again.
    docks.toggle(app, history_docker.ID)
    if docks.isShown(app, history_docker.ID) || !pointer(app, 3, 3) || !ui.isEmpty(docks.tabOf(app, history_docker.ID)) { return 67 }
    docks.toggle(app, history_docker.ID)
    if !docks.isShown(app, history_docker.ID) || !pointer(app, 2, 2) || ui.isEmpty(docks.tabOf(app, history_docker.ID)) { return 68 }

    // A tab dragged onto the lower quarter of the panel: a panel of its
    // own under it.
    const tab = docks.tabOf(app, overview.ID)
    const content = docks.contentOf(app, history_docker.ID)
    if !drag(app, middleX(tab), middleY(tab), middleX(content), ui.bottom(content) - 10) { return 69 }
    const own = docks.tabOf(app, overview.ID)
    if ui.isEmpty(own) || own.y <= ui.bottom(docks.tabOf(app, history_docker.ID)) || ui.isEmpty(docks.contentOf(app, overview.ID)) || ui.isEmpty(docks.contentOf(app, history_docker.ID)) { return 70 }

    // The layout as text and back, into another program's App.
    var text = std.ArrayList(u8).init(allocator)
    var again = std.ArrayList(u8).init(allocator)
    if !docks.write(app, &text) || !std.text.contains(text.items(), "panel ") { return 71 }
    const fresh = script.headless(allocator)
    if fresh == null || !docks.read(fresh.?, text.items()) || !docks.write(fresh.?, &again) { return 72 }
    if !std.text.same(text.items(), again.items()) { return 73 }
    if docks.read(fresh.?, "panel 1 0 open history\n") || docks.read(fresh.?, "area middle 200\n") { return 74 }
    again.clearRetainingCapacity()
    if !docks.write(fresh.?, &again) || !std.text.same(text.items(), again.items()) { return 75 }

    // The overview: the picture of a red image is red; its outline dragged
    // moves the view.
    const node = api.activeNode(app).?
    const picture = api.image(app).?
    _ = device.fill(node.*.device.?, image_module.bounds(picture), 0xFFFF0000)
    api.imageChanged(app, image_module.bounds(picture))
    if !pointer(app, 4, 4) { return 76 }
    const small = overview.thumbnail(app)
    if small.width < 8 || small.height < 8 { return 77 }
    var reds: u64 = 0
    var at: usize = 0
    while at < @intCast(usize, small.width * small.height) {
        if small.pixels[at] == 0xFFFF0000 { reds += 1 }
        at += 1
    }
    if reds != @intCast(u64, small.width * small.height) { return 78 }
    const box = overview.pictureArea(app)
    const doc = api.document(app).?
    const center_x = doc.*.view.centerX
    const center_y = doc.*.view.centerY
    const scale = @floatFromInt(f64, small.width) / @floatFromInt(f64, picture.*.width)
    if !drag(app, middleX(box), middleY(box), middleX(box) + 20, middleY(box) + 10) { return 79 }
    if !near(doc.*.view.centerX, center_x + 20.0 / scale, 1.0) || !near(doc.*.view.centerY, center_y + 10.0 / scale, 1.0) { return 80 }

    // The status bar: the image's size, its kind, the zoom; a step in and
    // out by its buttons.
    if !std.text.same(field(app, statusbar.FIELD_SIZE), "400 \xC3\x97 300 px") || !std.text.same(field(app, statusbar.FIELD_FORMAT), "RGBA 8-bit") { return 81 }
    if !std.text.contains(field(app, statusbar.FIELD_MEMORY), "MiB") || !std.text.contains(field(app, statusbar.FIELD_ZOOM), " %") { return 82 }
    if !pointer(app, middleX(app.*.canvasArea), middleY(app.*.canvasArea)) || field(app, statusbar.FIELD_POINTER).length == 0 { return 83 }
    const zoom = doc.*.view.zoom
    if !clickIn(app, statusbar.zoomArea(app, 2)) || !(doc.*.view.zoom > zoom * 1.1) { return 84 }
    if !clickIn(app, statusbar.zoomArea(app, 0)) || !near(doc.*.view.zoom, zoom, zoom * 0.01) { return 85 }

    // The pictures, German and light.
    if !sized(app, 1280, 800) || !save(app, "chrome-1280.png") { return 86 }
    if !sized(app, 1024, 768) || !checkLayout(app, 480) || !save(app, "chrome-1024.png") { return 87 }
    if !sized(app, 800, 600) || !checkLayout(app, 200) || !save(app, "chrome-800.png") { return 88 }
    if !script.run(app, "size 1024 768\ngerman\n") || !std.text.same(field(app, statusbar.FIELD_FORMAT), "RGBA 8 Bit") { return 89 }
    if !std.text.contains(field(app, statusbar.FIELD_MEMORY), ",") { return 90 }
    if !save(app, "chrome-german.png") { return 91 }
    app.*.german = false
    app.*.shell.*.lightness = 1024
    if !save(app, "chrome-light.png") { return 92 }
    if seeThrough(app) != 0 { return 110 }
    app.*.shell.*.lightness = 0
    if !save(app, "chrome-dark.png") { return 93 }

    // Light and dark: everything around the canvas opaque (with the "more"
    // list open too).
    if seeThrough(app) != 0 { return 111 }
    app.*.shell.*.lightness = 1024
    if !sized(app, 800, 600) || !clickIn(app, toolbar.itemArea(app, toolbar.ITEM_MORE)) || !toolbar.moreOpen(app) || seeThrough(app) != 0 { return 112 }
    app.*.shell.*.lightness = 0
    if !pointer(app, 3, 3) || seeThrough(app) != 0 { return 113 }

    // A toggle in the "more" list: its row (found by what is under the
    // pointer down the list's middle) switches it, the list stays open.
    const more = toolbar.itemArea(app, toolbar.ITEM_MORE)
    var row_y = ui.bottom(app.*.toolBar)
    const row_x = ui.right(more) - 100
    while row_y < ui.bottom(app.*.toolBar) + 300 && view.hitAt(widgets, row_x, row_y) != toolbar.idOfItem(toolbar.ITEM_WRAP) { row_y += 1 }
    if view.hitAt(widgets, row_x, row_y) != toolbar.idOfItem(toolbar.ITEM_WRAP) || app.*.wrapAround { return 114 }
    if !click(app, row_x, row_y + 4) || !app.*.wrapAround || !toolbar.moreOpen(app) { return 115 }
    if !click(app, row_x, row_y + 4) || app.*.wrapAround { return 116 }
    if !clickIn(app, more) || toolbar.moreOpen(app) { return 117 }

    // German at 1024: nothing in the "more" list, no slider's name cut
    // (the kit's slider gives its name what its width leaves after 8
    // pixels at each end and between name and number).
    if !script.run(app, "size 1024 768\ngerman\npointer 2 2\n") || !checkLayout(app, 480) { return 118 }
    index = 0
    while index < toolbar.ITEMS {
        if toolbar.isDropped(app, index) { return 119 }
        index += 1
    }
    const small_font = state.smallOf(app)
    const opacity_room = toolbar.itemArea(app, toolbar.ITEM_OPACITY).width - 24 - text_module.measure(small_font, "100 %")
    const flow_room = toolbar.itemArea(app, toolbar.ITEM_FLOW).width - 24 - text_module.measure(small_font, "100 %")
    const size_room = toolbar.itemArea(app, toolbar.ITEM_SIZE).width - 24 - text_module.measure(small_font, "10000,00 px")
    if opacity_room < text_module.measure(small_font, "Deckkraft") || flow_room < text_module.measure(small_font, "Fluss") || size_room < text_module.measure(small_font, "Gr\xC3\xB6\xC3\x9Fe") { return 120 }
    app.*.german = false
    if !sized(app, 1280, 800) || !checkLayout(app, 480) { return 121 }

    // The layout's text: what is not of its form is refused and changes
    // nothing (a docker named twice, an area missing or named twice, an
    // empty text, a key too long).
    if !keepLayout(app) { return 122 }
    var bad_texts: [7][]const u8 = [7][]const u8{ "", "area left 280\narea right 280\npanel 1 0 open history history\n", "area left 280\narea right 280\npanel 1 0 open history\npanel 1 0 open overview history\n", "area right 280\npanel 1 0 open history\n", "area left 280\narea left 300\narea right 280\n", "area left 280\narea right 280\npanel 1 0 open abcdefghijklmnopqrstuvwxyz\n", "area left 280\narea right 280\npanel 1 0 open\n" }
    index = 0
    while index < 7 {
        if docks.read(app, bad_texts[index]) || !sameLayout(app) { return 123 }
        index += 1
    }
    // Line ends with a carriage return are read as the same lines.
    if !docks.read(fresh.?, "area left 200\r\narea right 300\r\npanel 1 0 open history\r\n") || docks.areaWidth(fresh.?, docks.AREA_RIGHT) != 300 { return 124 }

    // Tabs dragged: onto the middle of their own panel's content nothing
    // changes; onto another panel's row the docker joins it (its own panel
    // goes); onto the canvas's left edge it opens the left area, and back.
    const history_tab = docks.tabOf(app, history_docker.ID)
    const history_content = docks.contentOf(app, history_docker.ID)
    if ui.isEmpty(history_tab) || ui.isEmpty(history_content) || ui.isEmpty(docks.contentOf(app, overview.ID)) { return 125 }
    if !drag(app, middleX(history_tab), middleY(history_tab), middleX(history_content), middleY(history_content)) || !sameLayout(app) { return 126 }
    const panels_before = panels(app)
    const overview_tab = docks.tabOf(app, overview.ID)
    if !drag(app, middleX(overview_tab), middleY(overview_tab), ui.right(history_tab) + 20, middleY(history_tab)) { return 127 }
    if panels(app) + 1 != panels_before || docks.tabOf(app, overview.ID).y != docks.tabOf(app, history_docker.ID).y || docks.tabOf(app, overview.ID).x <= docks.tabOf(app, history_docker.ID).x { return 128 }
    const right_width = app.*.rightDock.width
    if !drag(app, middleX(docks.tabOf(app, history_docker.ID)), middleY(docks.tabOf(app, history_docker.ID)), app.*.canvasArea.x + 10, middleY(app.*.canvasArea)) { return 129 }
    if ui.isEmpty(app.*.leftDock) || !inside(docks.tabOf(app, history_docker.ID), app.*.leftDock) || !inside(docks.contentOf(app, history_docker.ID), app.*.leftDock) || !checkLayout(app, 480) { return 130 }
    if !sized(app, 1024, 768) || !checkLayout(app, 480) || ui.isEmpty(app.*.leftDock) || ui.isEmpty(app.*.rightDock) { return 131 }
    if !sized(app, 1280, 800) { return 132 }
    if !drag(app, middleX(docks.tabOf(app, history_docker.ID)), middleY(docks.tabOf(app, history_docker.ID)), middleX(docks.tabOf(app, overview.ID)), middleY(docks.tabOf(app, overview.ID))) { return 133 }
    if !ui.isEmpty(app.*.leftDock) || app.*.rightDock.width != right_width || !inside(docks.tabOf(app, history_docker.ID), app.*.rightDock) { return 134 }

    // Everything hidden: the right area goes and the canvas takes its
    // place; shown again: as before.
    const canvas_width = app.*.canvasArea.width
    docks.hideAll(app)
    if !pointer(app, 3, 3) || !ui.isEmpty(app.*.rightDock) || app.*.canvasArea.width != canvas_width + right_width || docks.isShown(app, history_docker.ID) || docks.isShown(app, overview.ID) { return 135 }
    docks.showAll(app)
    if !pointer(app, 2, 2) || app.*.rightDock.width != right_width || app.*.canvasArea.width != canvas_width || !docks.isShown(app, history_docker.ID) || !docks.isShown(app, overview.ID) { return 136 }

    // Two panels whose shares are far apart: the small one is 0 pixels
    // tall, and the grip between them still makes it larger.
    if !docks.read(app, "area left 280\narea right 280\npanel 1 0 open history\npanel 999 0 open overview\n") || !pointer(app, 3, 3) { return 137 }
    const tiny = docks.contentOf(app, history_docker.ID)
    const large = docks.contentOf(app, overview.ID)
    if tiny.height > 1 || ui.isEmpty(large) { return 138 }
    const both = tiny.height + large.height
    const grip_y = ui.bottom(tiny) + docks.GRIP / 2
    if !dragIn(app, middleX(large), grip_y, middleX(large), grip_y + 100, 1) { return 139 }
    const grown = docks.contentOf(app, history_docker.ID)
    if grown.height < 99 || grown.height > 101 || grown.height + docks.contentOf(app, overview.ID).height != both { return 140 }
    docks.defaults(app)

    // Windows of every size, down to none: nothing traps, the parts stay in
    // the window and apart, and what is in a part stays in it.
    var widths: [14]i32 = [14]i32{ 0, 1, 2, 17, 64, 100, 199, 333, 480, 640, 800, 1024, 1366, 1920 }
    var heights: [13]i32 = [13]i32{ 0, 1, 2, 17, 50, 64, 100, 139, 200, 333, 600, 768, 1080 }
    index = 0
    while index < 14 {
        var other: usize = 0
        while other < 13 {
            if !frameOfSize(app, widths[index], heights[other]) || !partsApart(app) { return 141 }
            other += 1
        }
        index += 1
    }
    if !frameOfSize(app, -5, -7) || !ui.isEmpty(app.*.window) || !sized(app, 1280, 800) || !checkLayout(app, 480) { return 142 }

    // Sixteen documents: their tabs in the bar, left to right, apart, at
    // 1280 and at 800.
    closeAll(app)
    index = 0
    while index < state.DOCUMENTS {
        if !script.run(app, "new 64 48 FFFFFF\n") { return 143 }
        index += 1
    }
    if app.*.count != state.DOCUMENTS { return 144 }
    var round: usize = 0
    while round < 2 {
        if !sized(app, if round == 0 { 1280 } else { 800 }, if round == 0 { 800 } else { 600 }) || !partsApart(app) { return 145 }
        index = 0
        while index < app.*.count {
            const tab_area = tabbar.tabArea(app, index)
            if ui.isEmpty(tab_area) || !inside(tab_area, app.*.tabBar) { return 146 }
            if index > 0 && tab_area.x < ui.right(tabbar.tabArea(app, index - 1)) { return 147 }
            index += 1
        }
        round += 1
    }
    if !sized(app, 1280, 800) { return 148 }

    // The overview keeps no picture of an image that is gone: one closed
    // and another of its size made (in its memory, most likely) shows the
    // new one's colour.
    closeAll(app)
    if !script.run(app, "new 300 200 FFFFFF\npointer 2 2\n") { return 149 }
    const overview_shown = docks.tabOf(app, overview.ID)
    if !clickIn(app, overview_shown) || !pointer(app, 3, 3) || !thumbnailAll(app, 0xFFFFFFFF) { return 150 }
    closeAll(app)
    if !pointer(app, 2, 2) || !script.run(app, "new 300 200 2060A0\npointer 3 3\n") || !thumbnailAll(app, 0xFF2060A0) { return 151 }
    // A stroke: the picture is made again where it changed, as a second
    // making of all of it says; undone, the picture is as it was.
    if !script.run(app, "color F0D000\n") { return 152 }
    const stroke_area = app.*.canvasArea
    if !drag(app, middleX(stroke_area) - 80, middleY(stroke_area) - 30, middleX(stroke_area) + 70, middleY(stroke_area) + 40) || !pointer(app, 2, 2) { return 153 }
    var painted: usize = 0
    if !thumbnailMatches(app, &painted) || painted == 0 { return 154 }
    if !script.run(app, "key Ctrl+Z\npointer 3 3\n") || !thumbnailAll(app, 0xFF2060A0) { return 155 }
    if !script.run(app, "key Ctrl+Shift+Z\npointer 2 2\n") || !thumbnailMatches(app, &painted) || painted == 0 { return 156 }

    // The selection's size, and none kept of an image that is gone.
    if !selectRect(app, geom.rect(10, 20, 30, 40)) || !pointer(app, 3, 3) || !std.text.same(field(app, statusbar.FIELD_SELECTION), "Selection 30 \xC3\x97 40 px") { return 157 }
    closeAll(app)
    if !pointer(app, 2, 2) || !script.run(app, "new 300 200 FFFFFF\npointer 3 3\n") { return 158 }
    if field(app, statusbar.FIELD_SELECTION).length != 0 { return 159 }
    if !selectRect(app, geom.rect(5, 6, 7, 8)) || !pointer(app, 2, 2) || !std.text.same(field(app, statusbar.FIELD_SELECTION), "Selection 7 \xC3\x97 8 px") { return 160 }

    // Where the pointer is on the image: over the one pixel of a colour of
    // its own, that pixel's place.
    _ = device.fill(api.activeNode(app).?.*.device.?, geom.rect(37, 21, 1, 1), 0xFF123456)
    api.imageChanged(app, geom.rect(37, 21, 1, 1))
    var mark_x: i32 = 0
    var mark_y: i32 = 0
    if !pointer(app, 3, 3) || !findInFrame(app, 0xFF123456, &mark_x, &mark_y) { return 161 }
    if !pointer(app, mark_x, mark_y) || !std.text.same(field(app, statusbar.FIELD_POINTER), "37, 21 px") { return 162 }
    if !pointer(app, 3, 3) || field(app, statusbar.FIELD_POINTER).length != 0 { return 163 }

    // The memory: pixel tiles of 16 KiB in MiB with a tenth; the zoom in
    // whole per cent, held to 1 .. 100000.
    var memory_text: [64]u8 = undefined
    const tenths = tilepool.liveTiles() * 16384 * 10 / 1048576
    var memory_length = std.text.appendUnsigned(&memory_text, 0, 64, tenths / 10)
    memory_length = std.text.appendByte(&memory_text, memory_length, 64, '.')
    memory_length = std.text.appendUnsigned(&memory_text, memory_length, 64, tenths % 10)
    memory_length = std.text.append(&memory_text, memory_length, 64, " MiB")
    const memory_shown: [*]const u8 = &memory_text
    if !std.text.same(field(app, statusbar.FIELD_MEMORY), memory_shown[0..memory_length]) { return 164 }
    const zoomed = api.document(app).?
    const zoom_was = zoomed.*.view.zoom
    zoomed.*.view.zoom = 1.0
    if !std.text.same(field(app, statusbar.FIELD_ZOOM), "100 %") { return 165 }
    zoomed.*.view.zoom = 0.3333
    if !std.text.same(field(app, statusbar.FIELD_ZOOM), "33 %") { return 166 }
    zoomed.*.view.zoom = 0.0001
    if !std.text.same(field(app, statusbar.FIELD_ZOOM), "1 %") { return 167 }
    zoomed.*.view.zoom = 1.0e12
    if !std.text.same(field(app, statusbar.FIELD_ZOOM), "100000 %") { return 168 }
    zoomed.*.view.zoom = zoom_was

    // The history's keys at its ends: Up at the original state and Down
    // at the last step are taken and change nothing.
    const steps_now = api.image(app).?.*.history
    const list_now = docks.contentOf(app, history_docker.ID)
    if ui.isEmpty(list_now) && !clickIn(app, docks.tabOf(app, history_docker.ID)) { return 169 }
    const history_list = docks.contentOf(app, history_docker.ID)
    if !pointer(app, middleX(history_list), middleY(history_list)) || history.stepCount(steps_now) != 1 { return 170 }
    if !chrome.key(app, ui_keys.UP, 0, "") || history.stepsDone(steps_now) != 0 || !chrome.key(app, ui_keys.UP, 0, "") || history.stepsDone(steps_now) != 0 { return 171 }
    if !chrome.key(app, ui_keys.DOWN, 0, "") || history.stepsDone(steps_now) != 1 || !chrome.key(app, ui_keys.DOWN, 0, "") || history.stepsDone(steps_now) != 1 { return 172 }
    if chrome.key(app, ui_keys.UP, ui_keys.CONTROL, "") || history.stepsDone(steps_now) != 1 { return 173 }

    // A middle press on the tab bar beside the tabs and a right press on a
    // tab close nothing.
    const only_tab = tabbar.tabArea(app, 0)
    if chrome.press(app, ui_app.BUTTON_MIDDLE, ui.right(app.*.tabBar) - 3, middleY(only_tab)) || chrome.press(app, ui_app.BUTTON_RIGHT, middleX(only_tab), middleY(only_tab)) || app.*.count != 1 { return 174 }

    // The status bar's left: a note while there is one, a failure's in the
    // theme's red (and only then); then the tool and what it does.
    api.say(app, "Saved", false)
    if !pointer(app, 2, 2) || !std.text.same(field(app, statusbar.FIELD_LEFT), "Saved") || reddish(app, app.*.statusBar) != 0 { return 175 }
    api.say(app, "Not saved", true)
    if !pointer(app, 3, 3) || !std.text.same(field(app, statusbar.FIELD_LEFT), "Not saved") || (app.*.fontsLoaded && state.smallOf(app).*.loaded && reddish(app, app.*.statusBar) < 10) { return 176 }

    // Frames by the hundred, once the status bar's note is gone (what is
    // drawn stays the same): no growth.
    if !script.run(app, "wait 6000\n") { return 94 }
    const tool_now = api.tool(app).?
    const left_now = field(app, statusbar.FIELD_LEFT)
    if left_now.length <= tool_now.*.name.length || !std.text.same(left_now[0..tool_now.*.name.length], tool_now.*.name) || !std.text.contains(left_now, " \xE2\x80\x94 ") { return 177 }
    const failed = steady(app)
    if failed != 0 { return 94 + failed }
    return 13
}
