// nebula's fill tools (tools/fills.mlx) on a headless App, played by
// scripts in a window of 1024 x 768. The bucket: a white region inside a
// black square outline filled with red exactly inside (counted) and not
// outside, one step "Fill" that undo takes back exactly and redo brings
// again, a click beside the image doing nothing; the threshold letting a
// light grey region join; sampling all layers (the outline on the layer
// below); similar colours anywhere; the whole selection filled exactly,
// and a region fill kept to the selection; a feathered fill soft at its
// edge; a pattern laid from the image's corner; half opacity. The
// gradient: a drag from left to right over 256 pixels makes a ramp (the
// first column the foreground, the last the background, monotonic, every
// row alike), reversed, radial from the centre (alike at alike
// distances), one step "Gradient" each; while dragging the layer shows
// the preview overlay and the window the drag's marks, which Escape (and
// another tool chosen) takes away with no trace and no step; Shift holds
// the angle to 15 degrees; an image seen whole beyond the preview's most
// pixels has no overlay while dragging and its gradient all the same on
// release. Enclose and fill: a rectangle around an island fills its
// inside ("regions enclosed by a colour") or the island and its outline
// ("all regions"), an ellipse and a lasso around it the same, Escape and
// a mere click leave nothing. The options: read from the settings at the
// first asking; each panel drawn at the docker's usual width (dark and
// English, light and German) and its least (labels over what they name)
// without trapping, fitting a screen 768 pixels tall, every row named; a
// click on "Sample all layers" changes the option and keeps it in the
// settings' text; a layout pass draws nothing. Many fills and gradients
// leave the value arena alone (but for what core/device.mlx's commit
// keeps there). Pictures: fill.png, gradient.png, fills-options.png,
// fills-options-light.png, fills-options-narrow.png (also into
// $NEBULA_SHOTS when that names a directory). Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const turns = @import("std.turns")
const png = @import("std.png")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const settings = @import("../app/settings.mlx")
const kit_module = @import("../ui/kit.mlx")
const viewport = @import("../ui/viewport.mlx")
const tools = @import("../tools/registry.mlx")
const fills = @import("../tools/fills.mlx")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const image_module = @import("../core/image.mlx")
const node_module = @import("../core/node.mlx")
const history = @import("../core/history.mlx")
const ops = @import("../core/ops.mlx")
const selection = @import("../core/selection.mlx")
const pixel = @import("../core/pixel.mlx")
const gradient = @import("../core/gradient.mlx")
const fill = @import("../core/fill.mlx")
const patterns = @import("../generators/patterns.mlx")
const blend = @import("../core/blend.mlx")
const render = @import("../core/render.mlx")
const documents = @import("../app/documents.mlx")
const math = @import("std.math")

const App = state.App
const Canvas = canvas_module.Canvas

const WHITE: u32 = 0xFFFFFFFF
const BLACK: u32 = 0xFF000000
const RED: u32 = 0xFFFF0000
const GREEN: u32 = 0xFF00FF00
const BLUE: u32 = 0xFF0000FF
const GREY: u32 = 0xFFE0E0E0

// The script being put together, and where pictures go besides the
// current directory (0 long: nowhere else).
var line: [4096]u8 = undefined
var lineLength: usize = 0
var shots: [1024]u8 = undefined
var shotsLength: usize = 0

fn put(text: []const u8) -> void {
    lineLength = std.text.append(&line, lineLength, 4096, text)
}

fn putNumber(value: i32) -> void {
    lineLength = std.text.appendSigned(&line, lineLength, 4096, @intCast(isize, value))
}

// Plays what was put together; true when every step went well.
fn play(app: *App) -> bool {
    const done = script.run(app, line[0..lineLength])
    lineLength = 0
    return done
}

fn run(app: *App, text: []const u8) -> bool {
    put(text)
    return play(app)
}

// The window pixel that shows image pixel (x, y) (whose centre the view
// was set to put on a window pixel's centre: alignView).
fn windowOf(app: *App, x: i32, y: i32, wx: *i32, wy: *i32) -> void {
    const doc = api.document(app).?
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    viewport.toWindow(&doc.*.view, @floatFromInt(f64, x) + 0.5, @floatFromInt(f64, y) + 0.5, &fx, &fy)
    wx.* = @intFromFloat(i32, @floor(fx))
    wy.* = @intFromFloat(i32, @floor(fy))
}

// " WX WY" of image pixel (x, y) onto the script.
fn putPlace(app: *App, x: i32, y: i32) -> void {
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, x, y, &wx, &wy)
    put(" ")
    putNumber(wx)
    put(" ")
    putNumber(wy)
}

// The view moved by less than a pixel so that the centre of an image
// pixel is the centre of a window pixel: a click there is at the image
// pixel's centre exactly.
fn alignView(app: *App) -> void {
    const doc = api.document(app).?
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    viewport.toWindow(&doc.*.view, 0.5, 0.5, &fx, &fy)
    doc.*.view.centerX += (fx - @floor(fx) - 0.5) / doc.*.view.zoom
    doc.*.view.centerY += (fy - @floor(fy) - 0.5) / doc.*.view.zoom
}

fn layerOf(app: *App) -> *device.Device {
    return api.activeNode(app).?.*.device.?
}

fn imageOf(app: *App) -> *image_module.Image {
    return api.image(app).?
}

// The node below the active one (the background layer of a new image).
fn groundOf(app: *App) -> *node_module.Node {
    return node_module.childAt(imageOf(app).*.root, 0)
}

// How many pixels of `area` of `plane` are `color`.
fn count(plane: *device.Device, area: geom.Rect, color: u32) -> usize {
    var total: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if device.pixel(plane, x, y) == color { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

fn checksum(plane: *device.Device, area: geom.Rect) -> u64 {
    var sum: u64 = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            sum = sum *% 1000003 +% @intCast(u64, device.pixel(plane, x, y))
            x += 1
        }
        y += 1
    }
    return sum
}

fn wholeImage(app: *App) -> geom.Rect {
    return image_module.bounds(imageOf(app))
}

fn stepsOf(app: *App) -> usize {
    return history.stepsDone(imageOf(app).*.history)
}

// A square outline one pixel wide, `side` across from (x, y).
fn outline(plane: *device.Device, x: i32, y: i32, side: i32, color: u32) -> void {
    _ = device.fill(plane, geom.rect(x, y, side, 1), color)
    _ = device.fill(plane, geom.rect(x, y + side - 1, side, 1), color)
    _ = device.fill(plane, geom.rect(x, y, 1, side), color)
    _ = device.fill(plane, geom.rect(x + side - 1, y, 1, side), color)
}

// The image's pixels were written behind the history's back.
fn touched(app: *App) -> void {
    image_module.damageAll(imageOf(app))
    api.canvasChanged(app)
}

// A picture of the window as `name` here and in $NEBULA_SHOTS.
fn shot(app: *App, name: []const u8) -> bool {
    put("shot ")
    put(name)
    put("\n")
    if shotsLength > 0 {
        put("shot ")
        put(shots[0..shotsLength])
        put("/")
        put(name)
        put("\n")
    }
    return play(app)
}

// A picture's path being put together (not a local: an array this large
// would be taken from the value arena).
var path: [1200]u8 = undefined

// A picture of `canvas` as `name` here and in $NEBULA_SHOTS.
fn save(canvas: *Canvas, name: []const u8) -> bool {
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 1200, name)
    length = std.text.appendByte(bytes, length, 1200, 0)
    if !png.saveFile(bytes, canvas.*.pixels, canvas.*.width, canvas.*.height, canvas.*.stride, false, std.heap.allocator()) { return false }
    if shotsLength == 0 { return true }
    length = std.text.append(bytes, 0, 1200, shots[0..shotsLength])
    length = std.text.append(bytes, length, 1200, "/")
    length = std.text.append(bytes, length, 1200, name)
    length = std.text.appendByte(bytes, length, 1200, 0)
    return png.saveFile(bytes, canvas.*.pixels, canvas.*.width, canvas.*.height, canvas.*.stride, false, std.heap.allocator())
}

// ---------------------------------------------------------------------------
// The tools are there

fn present(app: *App) -> u8 {
    const bucket = tools.byKey("fill")
    const ramp = tools.byKey("gradient")
    const enclose = tools.byKey("enclosefill")
    if bucket == null || ramp == null || enclose == null { return 2 }
    if bucket.?.*.id != fills.FILL || ramp.?.*.id != fills.GRADIENT || enclose.?.*.id != fills.ENCLOSE { return 3 }
    if bucket.?.*.group != state.GROUP_FILL || ramp.?.*.group != state.GROUP_FILL || enclose.?.*.group != state.GROUP_FILL { return 4 }
    if bucket.?.*.options == null || ramp.?.*.options == null || enclose.?.*.options == null || ramp.?.*.overlay == null || enclose.?.*.busy == null { return 5 }
    if tools.find(30) == null || tools.find(31) == null || tools.find(32) == null { return 6 }
    // Their keys choose them.
    if !run(app, "key G\n") || app.*.tool != fills.GRADIENT { return 7 }
    if !run(app, "key F\n") || app.*.tool != fills.FILL { return 8 }
    return 0
}

// ---------------------------------------------------------------------------
// The bucket

// A white layer with a black square outline from (50, 50), 100 across:
// its inside is 98 x 98 pixels.
const INSIDE: usize = 9604

fn drawSquare(app: *App) -> void {
    const layer = layerOf(app)
    _ = device.fill(layer, wholeImage(app), WHITE)
    outline(layer, 50, 50, 100, BLACK)
    touched(app)
}

fn clickAt(app: *App, x: i32, y: i32) -> bool {
    put("click")
    putPlace(app, x, y)
    put("\n")
    return play(app)
}

fn undo(app: *App) -> bool {
    return run(app, "key Ctrl+Z\n")
}

fn bucket(app: *App) -> u8 {
    if !run(app, "new 400 300 FFFFFF\ntool fill\ncolor FF0000\n") { return 9 }
    alignView(app)
    const options = fills.fillOptions(app)
    if options == null { return 10 }
    // The defaults: a contiguous region of the foreground colour.
    if options.?.*.target != fills.TARGET_REGION || options.?.*.common.source != fills.SOURCE_FOREGROUND || options.?.*.common.merged || options.?.*.common.opacity != 100.0 { return 11 }
    drawSquare(app)
    const layer = layerOf(app)
    const before = checksum(layer, wholeImage(app))
    if !clickAt(app, 100, 100) { return 12 }
    if count(layer, wholeImage(app), RED) != INSIDE || count(layer, geom.rect(51, 51, 98, 98), RED) != INSIDE { return 14 }
    if device.pixel(layer, 50, 100) != BLACK || device.pixel(layer, 149, 120) != BLACK || device.pixel(layer, 49, 100) != WHITE || device.pixel(layer, 10, 10) != WHITE { return 15 }
    if stepsOf(app) != 1 || !std.text.same(history.undoName(imageOf(app).*.history), "Fill") { return 16 }
    if !run(app, "expect 100 100 FFFF0000\nexpect 300 200 FFFFFFFF\n") { return 17 }
    if !shot(app, "fill.png") { return 18 }
    // Undo takes it back exactly; redo brings it again.
    if !undo(app) || checksum(layer, wholeImage(app)) != before || stepsOf(app) != 0 { return 19 }
    if !run(app, "key Ctrl+Shift+Z\n") || count(layer, wholeImage(app), RED) != INSIDE { return 20 }
    if !undo(app) { return 21 }
    // Beside the image nothing happens.
    if !clickAt(app, -20, 100) || stepsOf(app) != 0 || checksum(layer, wholeImage(app)) != before { return 22 }
    // Filling red over red leaves it red. (The step it makes holds tiles
    // written again: core/device.mlx's commit tells changes by tile.)
    _ = device.fill(layer, wholeImage(app), RED)
    touched(app)
    if !clickAt(app, 10, 10) || count(layer, wholeImage(app), RED) != 120000 { return 23 }
    if stepsOf(app) > 0 && !undo(app) { return 24 }
    return 0
}

// A light grey square inside (20 x 20 at (60, 60), 31 from white) joins
// the region from a threshold of 31 on.
fn threshold(app: *App) -> u8 {
    drawSquare(app)
    const layer = layerOf(app)
    _ = device.fill(layer, geom.rect(60, 60, 20, 20), GREY)
    touched(app)
    const options = fills.fillOptions(app).?
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != INSIDE - 400 || count(layer, wholeImage(app), GREY) != 400 { return 25 }
    if !undo(app) { return 26 }
    options.*.common.threshold = 40.0
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != INSIDE || count(layer, wholeImage(app), GREY) != 0 { return 27 }
    if !undo(app) { return 28 }
    // A threshold of 0 takes white alone.
    options.*.common.threshold = 0.0
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != INSIDE - 400 { return 29 }
    if !undo(app) { return 30 }
    // Similar colours: every white pixel, inside the outline or not.
    options.*.common.threshold = 20.0
    options.*.target = fills.TARGET_SIMILAR
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != 120000 - 396 - 400 { return 31 }
    if !undo(app) { return 32 }
    options.*.target = fills.TARGET_REGION
    return 0
}

// The outline on the layer below, the active layer empty: the region is
// all of the empty layer unless all layers are sampled.
fn merged(app: *App) -> u8 {
    const layer = layerOf(app)
    device.clear(layer)
    outline(groundOf(app).*.device.?, 50, 50, 100, BLACK)
    touched(app)
    const options = fills.fillOptions(app).?
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != 120000 { return 33 }
    if !undo(app) || count(layer, wholeImage(app), RED) != 0 { return 34 }
    options.*.common.merged = true
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != INSIDE || count(layer, geom.rect(51, 51, 98, 98), RED) != INSIDE { return 35 }
    if !run(app, "expect 100 100 FFFF0000\nexpect 50 100 FF000000\nexpect 20 20 FFFFFFFF\n") { return 36 }
    if !undo(app) { return 37 }
    options.*.common.merged = false
    // The ground white again.
    _ = device.fill(groundOf(app).*.device.?, wholeImage(app), WHITE)
    touched(app)
    return 0
}

fn select(app: *App, area: geom.Rect) -> void {
    const image = imageOf(app)
    ops.beginSelection(image)
    _ = selection.fromRect(image.*.selection, area, selection.REPLACE, 0.0)
    ops.endSelection(image, true, "Select")
}

fn deselect(app: *App) -> void {
    const image = imageOf(app)
    ops.beginSelection(image)
    selection.clear(image.*.selection)
    ops.endSelection(image, false, "Deselect")
}

// "The selection": all of it, whatever the colours under it; and a
// region is always kept to the selection.
fn selected(app: *App) -> u8 {
    const layer = layerOf(app)
    device.clear(layer)
    touched(app)
    const options = fills.fillOptions(app).?
    const area = geom.rect(20, 30, 50, 40)
    select(app, area)
    if !imageOf(app).*.selected { return 38 }
    const steps = stepsOf(app)
    options.*.target = fills.TARGET_SELECTION
    // (A click anywhere fills it, also outside it.)
    if !clickAt(app, 300, 250) || count(layer, wholeImage(app), RED) != 2000 || count(layer, area, RED) != 2000 { return 39 }
    if stepsOf(app) != steps + 1 { return 40 }
    if !undo(app) || count(layer, wholeImage(app), RED) != 0 { return 41 }
    options.*.target = fills.TARGET_REGION
    if !clickAt(app, 200, 200) || count(layer, wholeImage(app), RED) != 2000 || count(layer, area, RED) != 2000 { return 42 }
    if !undo(app) { return 43 }
    deselect(app)
    // Without a selection "the selection" is the whole image.
    options.*.target = fills.TARGET_SELECTION
    if !clickAt(app, 5, 5) || count(layer, wholeImage(app), RED) != 120000 { return 44 }
    if !undo(app) { return 45 }
    options.*.target = fills.TARGET_REGION
    return 0
}

// A feathered region fades at its edge; a pattern fills with its tile;
// half the opacity mixes half.
fn softened(app: *App) -> u8 {
    drawSquare(app)
    const layer = layerOf(app)
    const options = fills.fillOptions(app).?
    options.*.common.feather = 6.0
    if !clickAt(app, 100, 100) { return 46 }
    const middle = device.pixel(layer, 100, 100)
    const edge = device.pixel(layer, 51, 100)
    // The middle red, beside the outline a mix of red and white.
    if middle != RED || edge == RED || edge == WHITE || pixel.red(edge) != 255 || pixel.green(edge) == 0 || pixel.green(edge) == 255 { return 47 }
    // Farther in, less white.
    if pixel.green(device.pixel(layer, 53, 100)) >= pixel.green(edge) { return 48 }
    if !undo(app) { return 49 }
    options.*.common.feather = 0.0
    // The pattern from the image's corner.
    options.*.common.source = fills.SOURCE_PATTERN
    options.*.common.pattern = patterns.BRICKS
    if !clickAt(app, 100, 100) { return 50 }
    var width: usize = 0
    var height: usize = 0
    const tile = patterns.pattern(patterns.BRICKS, &width, &height)
    if tile == null || width == 0 { return 51 }
    var y: i32 = 51
    while y < 149 {
        var x: i32 = 51
        while x < 149 {
            if device.pixel(layer, x, y) != tile.?[@intCast(usize, y) % height * width + @intCast(usize, x) % width] { return 52 }
            x += 7
        }
        y += 5
    }
    if device.pixel(layer, 20, 20) != WHITE { return 53 }
    if !undo(app) { return 54 }
    // The background colour at half: red and white half and half.
    options.*.common.source = fills.SOURCE_BACKGROUND
    options.*.common.opacity = 50.0
    if !run(app, "background FF0000\ncolor 0000FF\n") || !clickAt(app, 100, 100) { return 55 }
    const half = device.pixel(layer, 100, 100)
    if pixel.red(half) != 255 || pixel.green(half) < 126 || pixel.green(half) > 129 || pixel.alpha(half) != 255 { return 56 }
    if !undo(app) { return 57 }
    options.*.common.source = fills.SOURCE_FOREGROUND
    options.*.common.opacity = 100.0
    if !run(app, "color FF0000\nbackground FFFFFF\n") { return 58 }
    return 0
}

// ---------------------------------------------------------------------------
// The gradient

// A drag from image pixel (x0, y0) to (x1, y1), and `rest` after it.
fn dragFrom(app: *App, x0: i32, y0: i32, x1: i32, y1: i32, rest: []const u8) -> bool {
    put("drag")
    putPlace(app, x0, y0)
    putPlace(app, x1, y1)
    put(" 12\n")
    put(rest)
    return play(app)
}

// The first and the last column are the two colours, the channels go
// one way only in between, every row is the same.
fn ramp(layer: *device.Device, first: u32, last: u32) -> u8 {
    if device.pixel(layer, 0, 10) != first || device.pixel(layer, 255, 10) != last { return 59 }
    var x: i32 = 1
    while x < 256 {
        const before = device.pixel(layer, x - 1, 10)
        const now = device.pixel(layer, x, 10)
        if pixel.alpha(now) != 255 { return 60 }
        if pixel.red(first) > pixel.red(last) && pixel.red(now) > pixel.red(before) { return 61 }
        if pixel.red(first) < pixel.red(last) && pixel.red(now) < pixel.red(before) { return 62 }
        if pixel.blue(first) > pixel.blue(last) && pixel.blue(now) > pixel.blue(before) { return 63 }
        if pixel.blue(first) < pixel.blue(last) && pixel.blue(now) < pixel.blue(before) { return 64 }
        if device.pixel(layer, x, 0) != now || device.pixel(layer, x, 63) != now { return 65 }
        x += 1
    }
    return 0
}

fn ramps(app: *App) -> u8 {
    if !run(app, "new 256 64\ntool gradient\ncolor FF0000\nbackground 0000FF\n") { return 66 }
    alignView(app)
    const layer = layerOf(app)
    const options = fills.gradientOptions(app)
    if options == null { return 67 }
    if options.?.*.gradient != gradient.FOREGROUND_TO_BACKGROUND || options.?.*.shape != @intCast(usize, gradient.LINEAR) || options.?.*.reverse { return 68 }
    if !dragFrom(app, 0, 32, 255, 32, "") { return 69 }
    if ramp(layer, RED, BLUE) != 0 { return 70 }
    if stepsOf(app) != 1 || !std.text.same(history.undoName(imageOf(app).*.history), "Gradient") || api.activeNode(app).?.*.overlay != null || api.toolBusy(app) { return 71 }
    if !undo(app) || device.pixel(layer, 100, 10) != 0 || count(layer, wholeImage(app), 0) != 256 * 64 { return 72 }
    // Reversed.
    options.?.*.reverse = true
    if !dragFrom(app, 0, 32, 255, 32, "") || ramp(layer, BLUE, RED) != 0 || stepsOf(app) != 1 { return 73 }
    if !undo(app) { return 74 }
    options.?.*.reverse = false
    // Radial from a pixel's centre, 60 pixels out: alike at alike
    // distances, the end colour beyond.
    options.?.*.shape = @intCast(usize, gradient.RADIAL)
    if !dragFrom(app, 127, 31, 187, 31, "") || stepsOf(app) != 1 { return 75 }
    if device.pixel(layer, 127, 31) != RED || device.pixel(layer, 0, 31) != BLUE || device.pixel(layer, 255, 0) != BLUE { return 76 }
    if device.pixel(layer, 97, 31) != device.pixel(layer, 157, 31) || device.pixel(layer, 127, 1) != device.pixel(layer, 97, 31) || device.pixel(layer, 127, 61) != device.pixel(layer, 157, 31) { return 77 }
    const mid = device.pixel(layer, 157, 31)
    if mid == RED || mid == BLUE || pixel.red(mid) < 100 || pixel.blue(mid) < 100 { return 78 }
    if !undo(app) { return 79 }
    options.?.*.shape = @intCast(usize, gradient.LINEAR)
    return 0
}

// The window's pixel at image pixel (x, y) in the frame drawn last.
fn shownAt(app: *App, x: i32, y: i32) -> u32 {
    var wx: i32 = 0
    var wy: i32 = 0
    windowOf(app, x, y, &wx, &wy)
    const frame = script.frameOf(app).?
    return frame.*.pixels[@intCast(usize, wy) * frame.*.stride + @intCast(usize, wx)]
}

// While the drag goes on the layer shows the preview and the window the
// drag's marks; Escape takes both away with no trace, the release after
// it does nothing; so does choosing another tool.
fn previewed(app: *App) -> u8 {
    const layer = layerOf(app)
    const node = api.activeNode(app).?
    const steps = stepsOf(app)
    const unmarked = shownAt(app, 10, 32)
    put("pointer")
    putPlace(app, 10, 32)
    put("\npress\npointer")
    putPlace(app, 120, 32)
    put("\npointer")
    putPlace(app, 200, 40)
    put("\n")
    if !play(app) { return 80 }
    if !api.toolBusy(app) || node.*.overlay == null || !device.isBlank(layer) { return 81 }
    // The start's marker: white in its middle.
    if shownAt(app, 10, 32) != WHITE || unmarked == WHITE { return 82 }
    // What the image shows: the foreground at the start, the background
    // past the end.
    if !run(app, "expect 5 32 FFFF0000\nexpect 250 32 FF0000FF\n") { return 83 }
    if !shot(app, "gradient.png") { return 84 }
    if !run(app, "key Escape\n") { return 85 }
    if api.toolBusy(app) || node.*.overlay != null || !device.isBlank(layer) || stepsOf(app) != steps || shownAt(app, 10, 32) != unmarked { return 86 }
    if !run(app, "expect 5 32 00000000\nrelease\n") || stepsOf(app) != steps || !device.isBlank(layer) { return 87 }
    // A click is no drag: nothing.
    if !clickAt(app, 50, 20) || stepsOf(app) != steps || !device.isBlank(layer) { return 88 }
    // Another tool chosen in the middle of a drag ends it the same way.
    put("pointer")
    putPlace(app, 10, 32)
    put("\npress\npointer")
    putPlace(app, 120, 32)
    put("\n")
    if !play(app) || node.*.overlay == null { return 89 }
    if !run(app, "tool fill\nrelease\ntool gradient\n") || node.*.overlay != null || api.toolBusy(app) || stepsOf(app) != steps || !device.isBlank(layer) { return 90 }
    return 0
}

// An image seen whole that is larger than the preview's most: no overlay
// while dragging (the line alone shows the drag), the gradient laid all
// the same on release.
fn large(app: *App) -> u8 {
    if !run(app, "new 1400 900\n") { return 91 }
    const node = api.activeNode(app).?
    put("pointer")
    putPlace(app, 100, 450)
    put("\npress\npointer")
    putPlace(app, 700, 450)
    put("\npointer")
    putPlace(app, 1300, 450)
    put("\n")
    if !play(app) || !api.toolBusy(app) || node.*.overlay != null { return 92 }
    if !run(app, "release\n") || stepsOf(app) != 1 || api.toolBusy(app) { return 93 }
    const layer = layerOf(app)
    if device.pixel(layer, 0, 450) != RED || device.pixel(layer, 1399, 0) != BLUE { return 94 }
    return 0
}

// With Shift a drag a little off level is level.
fn snapped(app: *App) -> u8 {
    const layer = layerOf(app)
    if !run(app, "down Shift\n") { return 95 }
    if !dragFrom(app, 0, 20, 255, 34, "up Shift\n") { return 96 }
    if stepsOf(app) != 1 { return 97 }
    var x: i32 = 0
    while x < 256 {
        if device.pixel(layer, x, 0) != device.pixel(layer, x, 63) { return 98 }
        x += 5
    }
    if device.pixel(layer, 0, 5) != RED { return 99 }
    if !undo(app) { return 100 }
    // Without it the same drag is not level.
    if !dragFrom(app, 0, 20, 255, 34, "") || device.pixel(layer, 128, 0) == device.pixel(layer, 128, 63) { return 101 }
    if !undo(app) { return 102 }
    return 0
}

// ---------------------------------------------------------------------------
// Enclose and fill

// An island: a black outline 40 across at (120, 80) on white, white
// inside (38 x 38).
fn drawIsland(app: *App) -> void {
    const layer = layerOf(app)
    _ = device.fill(layer, wholeImage(app), WHITE)
    outline(layer, 120, 80, 40, BLACK)
    touched(app)
}

fn island(app: *App) -> u8 {
    if !run(app, "new 300 200 FFFFFF\ntool enclosefill\ncolor 00FF00\n") { return 103 }
    alignView(app)
    drawIsland(app)
    const layer = layerOf(app)
    const options = fills.encloseOptions(app)
    if options == null { return 104 }
    options.?.*.shape = fills.ENCLOSE_RECTANGLE
    options.?.*.method = @intCast(usize, fill.REGIONS_SURROUNDED_BY)
    options.?.*.reference = BLACK
    options.?.*.common.threshold = 20.0
    const before = checksum(layer, wholeImage(app))
    if !dragFrom(app, 100, 60, 180, 140, "") { return 105 }
    if count(layer, wholeImage(app), GREEN) != 1444 || count(layer, geom.rect(121, 81, 38, 38), GREEN) != 1444 { return 106 }
    if count(layer, wholeImage(app), BLACK) != 156 || device.pixel(layer, 105, 65) != WHITE { return 107 }
    if stepsOf(app) != 1 || !std.text.same(history.undoName(imageOf(app).*.history), "Enclose and Fill") || api.toolBusy(app) { return 108 }
    if !undo(app) || checksum(layer, wholeImage(app)) != before { return 109 }
    // All regions: the outline too (it lies wholly inside), not what
    // reaches the rectangle's edge.
    options.?.*.method = @intCast(usize, fill.ALL_REGIONS)
    if !dragFrom(app, 100, 60, 180, 140, "") || count(layer, wholeImage(app), GREEN) != 1600 || count(layer, wholeImage(app), BLACK) != 0 { return 110 }
    if !undo(app) { return 111 }
    // A rectangle that cuts the island takes none of it.
    options.?.*.method = @intCast(usize, fill.REGIONS_SURROUNDED_BY)
    if !dragFrom(app, 100, 60, 140, 140, "") || stepsOf(app) != 0 || checksum(layer, wholeImage(app)) != before { return 112 }
    // An ellipse around it.
    options.?.*.shape = fills.ENCLOSE_ELLIPSE
    if !dragFrom(app, 95, 55, 185, 145, "") || count(layer, wholeImage(app), GREEN) != 1444 { return 113 }
    if !undo(app) { return 114 }
    // A lasso around it, point by point.
    options.?.*.shape = fills.ENCLOSE_LASSO
    put("pointer")
    putPlace(app, 100, 60)
    put("\npress\npointer")
    putPlace(app, 180, 62)
    put("\npointer")
    putPlace(app, 185, 140)
    put("\npointer")
    putPlace(app, 140, 150)
    put("\npointer")
    putPlace(app, 98, 138)
    put("\nrelease\n")
    if !play(app) || count(layer, wholeImage(app), GREEN) != 1444 || stepsOf(app) != 1 { return 115 }
    if !undo(app) { return 116 }
    // Escape while dragging, and a click: nothing.
    options.?.*.shape = fills.ENCLOSE_RECTANGLE
    put("pointer")
    putPlace(app, 100, 60)
    put("\npress\npointer")
    putPlace(app, 180, 140)
    put("\n")
    if !play(app) || !api.toolBusy(app) { return 117 }
    if !run(app, "key Escape\nrelease\n") || api.toolBusy(app) || stepsOf(app) != 0 || checksum(layer, wholeImage(app)) != before { return 118 }
    if !clickAt(app, 140, 100) || stepsOf(app) != 0 { return 119 }
    return 0
}

// ---------------------------------------------------------------------------
// Where such code breaks: the bucket

// How many pixels of `area` of `plane` are not wholly transparent.
fn shownCount(plane: *device.Device, area: geom.Rect) -> usize {
    var total: usize = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            if device.pixel(plane, x, y) >> 24 != 0 { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

// What the image shows at (x, y), brought up to date first.
fn projected(app: *App, x: i32, y: i32) -> u32 {
    const image = imageOf(app)
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

// Undoes until `steps` steps are left.
fn undoTo(app: *App, steps: usize) -> bool {
    while stepsOf(app) > steps {
        if !undo(app) { return false }
    }
    return true
}

// The selection made by hand inside one step: `area` at `amount` on a
// mask whose default is `default_pixel`.
fn selectWith(app: *App, default_pixel: u32, area: geom.Rect, amount: u32) -> void {
    const image = imageOf(app)
    ops.beginSelection(image)
    selection.clear(image.*.selection)
    device.setDefault(image.*.selection, default_pixel)
    _ = device.fill(image.*.selection, area, pixel.gray(amount))
    ops.endSelection(image, true, "Select")
}

// One pixel; the last column and row; grown, grown by a fraction, shrunk;
// the threshold's rounding; a spread below 100; another blend mode; an
// opacity of 0; the same fill twice; another button; a hidden layer; a
// locked alpha; a selection whose default is everything; a selection of
// half an amount; a layer moved off the image's corner.
fn bucketEdges(app: *App) -> u8 {
    if !run(app, "new 1 1 FFFFFF\ntool fill\ncolor FF0000\nbackground FFFFFF\n") { return 139 }
    alignView(app)
    if !clickAt(app, 0, 0) || device.pixel(layerOf(app), 0, 0) != RED || stepsOf(app) != 1 { return 140 }
    if !run(app, "new 400 300 FFFFFF\ntool fill\n") { return 141 }
    alignView(app)
    drawSquare(app)
    const layer = layerOf(app)
    const before = checksum(layer, wholeImage(app))
    // The region outside the square reaches the last column and row.
    if !clickAt(app, 399, 299) || count(layer, wholeImage(app), RED) != 120000 - 10000 || device.pixel(layer, 0, 0) != RED || device.pixel(layer, 100, 100) != WHITE { return 142 }
    if !undo(app) || checksum(layer, wholeImage(app)) != before { return 143 }
    // Grown by one pixel (a disc of radius 1 is a plus): the 98 x 98 inside
    // becomes 100 x 100 but for the outline's four corners.
    const options = fills.fillOptions(app).?
    options.*.common.grow = 1.0
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != 9996 || count(layer, wholeImage(app), BLACK) != 4 || device.pixel(layer, 50, 50) != BLACK { return 144 }
    if !undo(app) { return 145 }
    options.*.common.grow = 0.6
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != 9996 { return 146 }
    if !undo(app) { return 147 }
    options.*.common.grow = -1.0
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != 9216 || count(layer, geom.rect(52, 52, 96, 96), RED) != 9216 { return 148 }
    if !undo(app) || checksum(layer, wholeImage(app)) != before { return 149 }
    options.*.common.grow = 0.0
    // The grey block is 31 from white: a threshold of 30.6 is 31 and takes
    // it, 30.4 is 30 and does not.
    _ = device.fill(layer, geom.rect(60, 60, 20, 20), GREY)
    touched(app)
    const plain = checksum(layer, wholeImage(app))
    options.*.common.threshold = 30.6
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), GREY) != 0 || count(layer, wholeImage(app), RED) != INSIDE { return 150 }
    if !undo(app) { return 151 }
    options.*.common.threshold = 30.4
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), GREY) != 400 || count(layer, wholeImage(app), RED) != INSIDE - 400 { return 152 }
    if !undo(app) { return 153 }
    // Spread 50 of a threshold of 40: whole up to 20, the grey (31 away)
    // by (255 * (41 - 31) + 10) / 21 = 121 of 255: red over E0 by that is
    // 224 + 31 * 121 / 255 = 238.7 and 224 * 134 / 255 = 117.7.
    options.*.common.threshold = 40.0
    options.*.common.spread = 50.0
    if !clickAt(app, 100, 100) { return 154 }
    const soft = device.pixel(layer, 70, 70)
    if pixel.red(soft) < 237 || pixel.red(soft) > 240 || pixel.green(soft) < 116 || pixel.green(soft) > 119 || pixel.blue(soft) != pixel.green(soft) || device.pixel(layer, 100, 100) != RED { return 155 }
    if !undo(app) { return 156 }
    options.*.common.spread = 100.0
    // Multiply: red times white is red, times E0 grey E00000.
    options.*.common.mode = blend.MULTIPLY
    if !clickAt(app, 100, 100) || count(layer, wholeImage(app), 0xFFE00000) != 400 || count(layer, wholeImage(app), RED) != INSIDE - 400 { return 157 }
    if !undo(app) || checksum(layer, wholeImage(app)) != plain { return 158 }
    options.*.common.mode = blend.NORMAL
    options.*.common.threshold = 20.0
    // An opacity of 0 changes nothing and makes no step.
    const steps = stepsOf(app)
    options.*.common.opacity = 0.0
    if !clickAt(app, 100, 100) || checksum(layer, wholeImage(app)) != plain || stepsOf(app) != steps { return 159 }
    options.*.common.opacity = 100.0
    // The same fill twice: red over red stays red; undone, as before.
    if !clickAt(app, 100, 100) || !clickAt(app, 100, 100) || count(layer, wholeImage(app), RED) != INSIDE - 400 || stepsOf(app) < steps + 1 { return 160 }
    if !undoTo(app, steps) || checksum(layer, wholeImage(app)) != plain { return 161 }
    // Another button, a hidden layer: nothing.
    pressWith(app, fills.FILL, 100.5, 100.5, ui_app.BUTTON_RIGHT)
    if stepsOf(app) != steps || checksum(layer, wholeImage(app)) != plain { return 162 }
    const node = api.activeNode(app).?
    node.*.visible = false
    if !clickAt(app, 100, 100) || stepsOf(app) != steps || checksum(layer, wholeImage(app)) != plain { return 163 }
    node.*.visible = true
    // Alpha locked, a layer white on its left half and transparent on its
    // right: "the selection" (all of an image without one) turns the left
    // half red and leaves the right transparent.
    device.clear(layer)
    _ = device.fill(layer, geom.rect(0, 0, 200, 300), WHITE)
    touched(app)
    node.*.alphaLocked = true
    options.*.target = fills.TARGET_SELECTION
    if !clickAt(app, 300, 100) || count(layer, geom.rect(0, 0, 200, 300), RED) != 60000 || shownCount(layer, geom.rect(200, 0, 200, 300)) != 0 { return 164 }
    if !undo(app) { return 165 }
    node.*.alphaLocked = false
    // A selection whose default is everything: all but the left quarter.
    // Both "the selection" and a region keep to it.
    device.clear(layer)
    touched(app)
    selectWith(app, 0xFFFFFFFF, geom.rect(0, 0, 100, 300), 0)
    if !imageOf(app).*.selected { return 166 }
    const chosen = stepsOf(app)
    if !clickAt(app, 300, 100) || count(layer, wholeImage(app), RED) != 90000 || shownCount(layer, geom.rect(0, 0, 100, 300)) != 0 { return 167 }
    if !undo(app) { return 168 }
    options.*.target = fills.TARGET_REGION
    if !clickAt(app, 300, 100) || count(layer, wholeImage(app), RED) != 90000 || shownCount(layer, geom.rect(0, 0, 100, 300)) != 0 { return 169 }
    if !undo(app) || stepsOf(app) != chosen { return 170 }
    // Half selected (128 of 255): "the selection" mixes half the red into
    // white (255 - 255 * 128 / 255 = 127 of green).
    _ = device.fill(layer, wholeImage(app), WHITE)
    touched(app)
    selectWith(app, 0xFF000000, geom.rect(10, 10, 20, 20), 128)
    options.*.target = fills.TARGET_SELECTION
    if !clickAt(app, 300, 100) { return 171 }
    const half = device.pixel(layer, 15, 15)
    if pixel.red(half) != 255 || pixel.green(half) < 126 || pixel.green(half) > 128 || pixel.alpha(half) != 255 || device.pixel(layer, 9, 15) != WHITE || device.pixel(layer, 30, 15) != WHITE { return 172 }
    if !undo(app) { return 173 }
    deselect(app)
    options.*.target = fills.TARGET_REGION
    // A layer moved off the image's corner: the same region where the
    // image has it.
    if !run(app, "new 400 300 FFFFFF\ntool fill\n") { return 174 }
    alignView(app)
    device.moveTo(layerOf(app), -37, 70)
    drawSquare(app)
    const moved = layerOf(app)
    if !clickAt(app, 100, 100) || count(moved, wholeImage(app), RED) != INSIDE || count(moved, geom.rect(51, 51, 98, 98), RED) != INSIDE { return 175 }
    if !undo(app) || count(moved, wholeImage(app), RED) != 0 { return 176 }
    return 0
}

// A press of tool `id` at image place (x, y) with `button`.
fn pressWith(app: *App, id: u8, x: f64, y: f64, button: u32) -> void {
    var input: state.Input = undefined
    inputAt(x, y, button, &input)
    tools.find(id).?.*.press.?(app, &input)
}

// ---------------------------------------------------------------------------
// Where such code breaks: the gradient

// Repeats (what forwards shows at x it shows at x + 64; alternating at x
// and 128 - x alike); a layer moved; half the opacity; a selection (the
// same pixels as without it inside, nothing outside, the preview kept to
// it too); undo waiting while the drag lasts; Shift let go during the
// drag; a new image in front during it; options set from outside to
// anything; a picture of one pixel.
fn rampEdges(app: *App) -> u8 {
    if !run(app, "new 256 64\ntool gradient\ncolor FF0000\nbackground 0000FF\n") { return 177 }
    alignView(app)
    const layer = layerOf(app)
    const options = fills.gradientOptions(app).?
    options.*.repeat = @intCast(usize, gradient.FORWARDS)
    if !dragFrom(app, 0, 32, 64, 32, "") || stepsOf(app) != 1 { return 178 }
    var x: i32 = 0
    while x < 192 {
        if device.pixel(layer, x, 10) != device.pixel(layer, x + 64, 10) { return 179 }
        x += 1
    }
    if !undo(app) { return 180 }
    options.*.repeat = @intCast(usize, gradient.ALTERNATING)
    if !dragFrom(app, 0, 32, 64, 32, "") || device.pixel(layer, 64, 10) != BLUE || device.pixel(layer, 128, 10) != RED || device.pixel(layer, 0, 10) != RED { return 181 }
    x = 0
    while x <= 128 {
        if device.pixel(layer, x, 10) != device.pixel(layer, 128 - x, 10) { return 182 }
        x += 1
    }
    if !undo(app) { return 183 }
    options.*.repeat = @intCast(usize, gradient.NONE)
    device.moveTo(layer, -100, 7)
    if !dragFrom(app, 0, 32, 255, 32, "") || ramp(layer, RED, BLUE) != 0 { return 184 }
    if !undo(app) { return 185 }
    options.*.opacity = 50.0
    if !dragFrom(app, 0, 32, 255, 32, "") || pixel.alpha(device.pixel(layer, 100, 10)) < 127 || pixel.alpha(device.pixel(layer, 100, 10)) > 128 { return 186 }
    if !undo(app) { return 187 }
    options.*.opacity = 100.0
    if !dragFrom(app, 0, 32, 255, 32, "") { return 188 }
    const at60 = device.pixel(layer, 60, 15)
    const at149 = device.pixel(layer, 149, 29)
    if !undo(app) { return 189 }
    select(app, geom.rect(50, 10, 100, 20))
    const steps = stepsOf(app)
    if !dragFrom(app, 0, 32, 255, 32, "") || device.pixel(layer, 60, 15) != at60 || device.pixel(layer, 149, 29) != at149 || shownCount(layer, wholeImage(app)) != 2000 || shownCount(layer, geom.rect(50, 10, 100, 20)) != 2000 { return 190 }
    if stepsOf(app) != steps + 1 || !undo(app) { return 191 }
    put("pointer")
    putPlace(app, 10, 32)
    put("\npress\npointer")
    putPlace(app, 200, 32)
    put("\n")
    if !play(app) || api.activeNode(app).?.*.overlay == null { return 192 }
    if projected(app, 5, 32) != 0 || projected(app, 160, 15) != 0 || projected(app, 60, 15) >> 24 == 0 { return 193 }
    // Undo waits (the selection stays).
    if !run(app, "key Ctrl+Z\n") || stepsOf(app) != steps || !imageOf(app).*.selected { return 194 }
    if !run(app, "key Escape\nrelease\n") || api.activeNode(app).?.*.overlay != null || stepsOf(app) != steps || !device.isBlank(layer) { return 195 }
    deselect(app)
    const kept = stepsOf(app)
    // Shift let go during the drag: the end goes free again (what the
    // window says is held counts, not what the last key's event carried).
    put("down Shift\npointer")
    putPlace(app, 0, 20)
    put("\npress\npointer")
    putPlace(app, 128, 27)
    put("\npointer")
    putPlace(app, 255, 34)
    put("\nup Shift\npointer")
    putPlace(app, 250, 34)
    put("\npointer")
    putPlace(app, 255, 34)
    put("\nrelease\n")
    if !play(app) || stepsOf(app) != kept + 1 { return 196 }
    if device.pixel(layer, 128, 0) == device.pixel(layer, 128, 63) { return 197 }
    if !undo(app) { return 198 }
    // A new image comes in front during the drag: the drag ends, nothing
    // lands in either image, the first keeps no preview.
    const first = app.*.current
    const node = api.activeNode(app).?
    put("pointer")
    putPlace(app, 10, 32)
    put("\npress\npointer")
    putPlace(app, 120, 32)
    put("\n")
    if !play(app) || node.*.overlay == null { return 199 }
    if !run(app, "new 100 80\npointer 400 380\npointer 430 390\nrelease\n") { return 200 }
    if !device.isBlank(layerOf(app)) || stepsOf(app) != 0 || api.activeNode(app).?.*.overlay != null || api.toolBusy(app) { return 201 }
    documents.show(app, first)
    if node.*.overlay != null || !device.isBlank(layer) || stepsOf(app) != kept { return 202 }
    // Options set from outside to what they cannot be: held to what they
    // may be (the shape and repeat unknown: linear, none, not what their
    // low byte would be, radial and forwards; the gradient unknown: black
    // to white; no smoothing below 0, all the opacity above 100 %).
    options.*.shape = 258
    options.*.repeat = 257
    options.*.gradient = 99999
    options.*.smoothing = -5.0
    options.*.opacity = 1.0e300
    if !dragFrom(app, 0, 32, 255, 32, "") || ramp(layer, BLACK, WHITE) != 0 { return 203 }
    if !undo(app) { return 204 }
    options.*.shape = @intCast(usize, gradient.LINEAR)
    options.*.repeat = @intCast(usize, gradient.NONE)
    options.*.gradient = gradient.FOREGROUND_TO_BACKGROUND
    options.*.smoothing = 80.0
    options.*.opacity = 100.0
    if !run(app, "new 1 1\ntool gradient\n") { return 205 }
    alignView(app)
    if !dragFrom(app, 0, 0, 12, 0, "") || device.pixel(layerOf(app), 0, 0) != RED || stepsOf(app) != 1 { return 206 }
    return 0
}

// ---------------------------------------------------------------------------
// Where such code breaks: enclose and fill

// A lasso of `steps` motions round (cx, cy) at `radius`, `rounds` times
// over, played straight to the tool.
fn lassoAround(app: *App, cx: f64, cy: f64, radius: f64, rounds: f64, steps: usize) -> void {
    const tool = tools.find(fills.ENCLOSE).?
    var input: state.Input = undefined
    inputAt(cx + radius, cy, ui_app.BUTTON_LEFT, &input)
    tool.*.press.?(app, &input)
    var index: usize = 1
    while index <= steps {
        const angle = 2.0 * math.pi * rounds * @floatFromInt(f64, index) / @floatFromInt(f64, steps)
        inputAt(cx + radius * math.cos(angle), cy + radius * math.sin(angle), 0, &input)
        tool.*.move.?(app, &input)
        index += 1
    }
    input.button = ui_app.BUTTON_LEFT
    tool.*.release.?(app, &input)
}

// On island()'s image: a rectangle drawn from its far corner back; a lasso
// round the island ten times over in thousands of small steps (its points
// thinned as it grows); a lasso along a line; a selection over the left
// of the island; a new image in front during the drag.
fn islandEdges(app: *App) -> u8 {
    const layer = layerOf(app)
    const options = fills.encloseOptions(app).?
    const before = checksum(layer, wholeImage(app))
    options.*.shape = fills.ENCLOSE_RECTANGLE
    options.*.method = @intCast(usize, fill.REGIONS_SURROUNDED_BY)
    if !dragFrom(app, 180, 140, 100, 60, "") || count(layer, wholeImage(app), GREEN) != 1444 { return 207 }
    if !undo(app) { return 208 }
    options.*.shape = fills.ENCLOSE_LASSO
    lassoAround(app, 140.5, 100.5, 60.0, 10.0, 3000)
    if count(layer, wholeImage(app), GREEN) != 1444 || stepsOf(app) != 1 || api.toolBusy(app) { return 209 }
    if !undo(app) { return 210 }
    put("pointer")
    putPlace(app, 100, 60)
    put("\npress\npointer")
    putPlace(app, 150, 60)
    put("\npointer")
    putPlace(app, 200, 60)
    put("\npointer")
    putPlace(app, 250, 60)
    put("\nrelease\n")
    if !play(app) || stepsOf(app) != 0 || checksum(layer, wholeImage(app)) != before { return 211 }
    options.*.shape = fills.ENCLOSE_RECTANGLE
    select(app, geom.rect(0, 0, 140, 200))
    const steps = stepsOf(app)
    if !dragFrom(app, 100, 60, 180, 140, "") || count(layer, wholeImage(app), GREEN) != 19 * 38 || count(layer, geom.rect(121, 81, 19, 38), GREEN) != 19 * 38 { return 212 }
    if !undoTo(app, steps) { return 213 }
    deselect(app)
    put("pointer")
    putPlace(app, 100, 60)
    put("\npress\npointer")
    putPlace(app, 180, 140)
    put("\n")
    if !play(app) || !api.toolBusy(app) { return 214 }
    if !run(app, "new 60 40\npointer 420 380\nrelease\n") { return 215 }
    if stepsOf(app) != 0 || !device.isBlank(layerOf(app)) || api.toolBusy(app) { return 216 }
    return 0
}

// A place far off the image as a tool may get it (a script's, a pen's
// gone wild), the window's place given apart.
fn inputFar(x: f64, y: f64, window_x: i32, button: u32, into: *state.Input) -> void {
    inputAt(0.0, 0.0, button, into)
    into.*.x = x
    into.*.y = y
    into.*.windowX = window_x
}

// Places a trillion pixels off the image, on the empty layer of
// islandEdges' last image (60 x 40): the bucket does nothing there; a
// rectangle, an ellipse and a lasso that hold all of the image take its
// one region whole (nothing of it is outside them); a gradient that long
// is one colour all over the image. No trap.
fn farAway(app: *App) -> u8 {
    const area = wholeImage(app)
    if area.width != 60 || area.height != 40 { return 235 }
    const layer = layerOf(app)
    // The corners of a square a trillion pixels to each side, the lasso
    // going round them; a rectangle and an ellipse from the first corner
    // to the third.
    var a: state.Input = undefined
    var b: state.Input = undefined
    var c: state.Input = undefined
    var d: state.Input = undefined
    inputFar(-1.0e12, -1.0e12, -1000, ui_app.BUTTON_LEFT, &a)
    inputFar(-1.0e12, 1.0e12, 3000, 0, &b)
    inputFar(1.0e12, 1.0e12, 3000, ui_app.BUTTON_LEFT, &c)
    inputFar(1.0e12, -1.0e12, 3000, ui_app.BUTTON_LEFT, &d)
    tools.find(fills.FILL).?.*.press.?(app, &c)
    if stepsOf(app) != 0 || !device.isBlank(layer) { return 236 }
    const enclose = tools.find(fills.ENCLOSE).?
    const options = fills.encloseOptions(app).?
    const method = options.*.method
    options.*.method = @intCast(usize, fill.ALL_REGIONS)
    var shape: usize = 0
    while shape < 3 {
        options.*.shape = shape
        enclose.*.press.?(app, &a)
        enclose.*.move.?(app, &b)
        enclose.*.move.?(app, &c)
        if shape == fills.ENCLOSE_LASSO {
            enclose.*.move.?(app, &d)
            enclose.*.release.?(app, &d)
        } else {
            enclose.*.release.?(app, &c)
        }
        if count(layer, area, GREEN) != 2400 || stepsOf(app) != 1 { return 237 }
        if !undo(app) || !device.isBlank(layer) { return 238 }
        shape += 1
    }
    options.*.shape = fills.ENCLOSE_RECTANGLE
    options.*.method = method
    if !run(app, "tool gradient\n") { return 239 }
    const ramp_tool = tools.find(fills.GRADIENT).?
    ramp_tool.*.press.?(app, &c)
    ramp_tool.*.move.?(app, &a)
    ramp_tool.*.release.?(app, &a)
    const one = device.pixel(layer, 0, 0)
    if stepsOf(app) != 1 || pixel.alpha(one) != 255 || count(layer, area, one) != 2400 { return 240 }
    if !undo(app) { return 241 }
    return 0
}

// Whether every pixel of `area` of `plane` is an opaque grey.
fn allGrey(plane: *device.Device, area: geom.Rect) -> bool {
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            const value = device.pixel(plane, x, y)
            if pixel.alpha(value) != 255 || pixel.red(value) != pixel.green(value) || pixel.green(value) != pixel.blue(value) { return false }
            x += 1
        }
        y += 1
    }
    return true
}

// Into a mask (amounts: opaque greys) the bucket's red goes as the grey
// of red (pixel.luma), erasing hides there (black), a pattern goes as the
// greys of its texels, a gradient from red to blue as greys from red's to
// blue's. A layer with something unfinished on it (another part's
// overlay, a change of its pixels open) is filled by none of the tools.
fn masked(app: *App) -> u8 {
    if !run(app, "new 100 80 FFFFFF\ntool fill\ncolor FF0000\nbackground 0000FF\n") { return 242 }
    alignView(app)
    const image = imageOf(app)
    const layer_node = api.activeNode(app).?
    const made = ops.newMask(image, layer_node, node_module.TRANSPARENCY_MASK, "Mask", "Add Mask")
    if made == null { return 243 }
    image.*.active = made.?
    const amounts = made.?.*.device.?
    const area = wholeImage(app)
    const steps = stepsOf(app)
    const options = fills.fillOptions(app).?
    if !clickAt(app, 50, 40) || count(amounts, area, pixel.gray(pixel.luma(RED))) != 8000 || stepsOf(app) != steps + 1 { return 244 }
    options.*.common.mode = blend.ERASE
    if !undo(app) || !clickAt(app, 50, 40) || count(amounts, area, BLACK) != 8000 { return 245 }
    options.*.common.mode = blend.NORMAL
    options.*.common.source = fills.SOURCE_PATTERN
    options.*.common.pattern = patterns.BRICKS
    if !undo(app) || !clickAt(app, 50, 40) { return 246 }
    var width: usize = 0
    var height: usize = 0
    const tile = patterns.pattern(patterns.BRICKS, &width, &height).?
    var y: i32 = 0
    while y < 80 {
        var x: i32 = 0
        while x < 100 {
            if device.pixel(amounts, x, y) != pixel.gray(pixel.luma(tile[@intCast(usize, y) % height * width + @intCast(usize, x) % width])) { return 247 }
            x += 3
        }
        y += 3
    }
    options.*.common.source = fills.SOURCE_FOREGROUND
    if !undo(app) || !run(app, "tool gradient\n") || !dragFrom(app, 0, 40, 99, 40, "") { return 248 }
    if device.pixel(amounts, 0, 10) != pixel.gray(pixel.luma(RED)) || device.pixel(amounts, 99, 10) != pixel.gray(pixel.luma(BLUE)) || !allGrey(amounts, area) { return 249 }
    if !undoTo(app, steps) { return 250 }
    image.*.active = layer_node
    // Another part's overlay on the layer: kept, nothing filled.
    const foreign = device.create(std.heap.allocator(), 0).?
    layer_node.*.overlay = foreign
    const before = checksum(layer_node.*.device.?, area)
    if !dragFrom(app, 0, 40, 99, 40, "") || !run(app, "tool fill\n") || !clickAt(app, 50, 40) || !run(app, "tool enclosefill\n") || !dragFrom(app, 10, 10, 90, 70, "") { return 251 }
    if stepsOf(app) != steps || layer_node.*.overlay == null || @intFromPtr(layer_node.*.overlay.?) != @intFromPtr(foreign) || checksum(layer_node.*.device.?, area) != before { return 252 }
    layer_node.*.overlay = null
    device.destroy(foreign)
    // A change of its pixels open (somebody else's): not taken into a
    // step of the fill.
    device.begin(layer_node.*.device.?)
    if !run(app, "tool fill\n") || !clickAt(app, 50, 40) || stepsOf(app) != steps || !device.isRecording(layer_node.*.device.?) { return 253 }
    _ = device.rollback(layer_node.*.device.?)
    if !clickAt(app, 50, 40) || stepsOf(app) != steps + 1 || count(layer_node.*.device.?, area, RED) != 8000 { return 254 }
    return 0
}

// ---------------------------------------------------------------------------
// The options read from what was kept, whatever it says

fn optionsRead() -> u8 {
    const made = script.headless(std.heap.allocator())
    if made == null { return 217 }
    const other = made.?
    // Each name's own number held to its range or, when it is none or out
    // of the choices, the default; a pair without a name or a number, and
    // a number of 13 digits, are passed over.
    if !settings.setText(other, "tool.fill", "target=7;threshold=abc;opacity=-5;grow=99999;feather=1234567890123;mode=-1;merged=2;;=5;spread=;corners=1;source=2;pattern=999999") { return 218 }
    const read = fills.fillOptions(other).?
    const common = &read.*.common
    if read.*.target != fills.TARGET_REGION || common.*.threshold != 20.0 || common.*.opacity != 0.0 || common.*.grow != 400.0 || common.*.feather != 0.0 || common.*.mode != blend.NORMAL { return 219 }
    if !common.*.merged || common.*.spread != 100.0 || !common.*.corners || common.*.source != fills.SOURCE_PATTERN || common.*.pattern != 0 { return 220 }
    if !settings.setText(other, "tool.gradient", "gradient=3;shape=8;repeat=2;reverse=1;dither=1;smoothing=150;mode=29;opacity=33") { return 221 }
    const ramp_options = fills.gradientOptions(other).?
    if ramp_options.*.gradient != 3 || ramp_options.*.shape != 0 || ramp_options.*.repeat != 2 || !ramp_options.*.reverse || !ramp_options.*.dither || ramp_options.*.smoothing != 100.0 || ramp_options.*.mode != 29 || ramp_options.*.opacity != 33.0 { return 222 }
    return 0
}

// ---------------------------------------------------------------------------
// The options

// The id the module gives an option's widget (tools/fills.mlx idOf).
fn optionId(tool: u8, item: usize) -> u64 {
    return view.idOf(view.idOf(view.id("nebula.tools.fills"), @intCast(usize, tool)), item)
}

const ITEM_MERGED: usize = 7
const ITEM_BLEND: usize = 9

// A sum of the pixels of `area` of `canvas` that tells pictures apart.
fn areaSum(canvas: *Canvas, area: ui.Rect) -> u64 {
    var sum: u64 = 0
    var y = area.y
    while y < area.y + area.height {
        var x = area.x
        while x < area.x + area.width {
            sum = sum *% 1000003 +% @intCast(u64, canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)])
            x += 1
        }
        y += 1
    }
    return sum
}

// One frame of the three panels side by side, each `width` across from
// the top of `canvas`; the tallest height they took.
fn panels(app: *App, canvas: *Canvas, width: i32) -> i32 {
    const widgets = state.uiOf(app)
    const kit = api.kit(app)
    view.begin(widgets, canvas)
    kit_module.resize(kit, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height))
    kit_module.begin(kit, widgets, canvas, state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app), 0, app.*.german)
    canvas_module.clear(canvas, app.*.theme.panel)
    var tallest: i32 = 0
    var index: u8 = 0
    while index < 3 {
        const tool = tools.find(fills.FILL + index).?
        const pad: i32 = 10
        const area = ui.rect(@intCast(i32, index) * (width + pad * 2) + pad, pad, width, 740)
        const height = tool.*.options.?(app, area)
        if height > tallest { tallest = height }
        index += 1
    }
    _ = kit_module.end(kit)
    _ = view.end(widgets)
    return tallest
}

fn optionsDrawn(app: *App) -> u8 {
    const allocator = std.heap.allocator()
    const width: usize = 900
    const height: usize = 620
    const memory = allocator.alloc(width * height * 4, 16)
    if memory == null { return 120 }
    var canvas = Canvas.{ .pixels = unsafe { @ptrCast([*]u32, memory.?) }, .width = width, .height = height, .stride = width, .swapRedBlue = false, .device = 0, .opacity = 255 }
    const tallest = panels(app, &canvas, 280)
    if tallest < 200 || tallest > 460 { return 121 }
    // Every row named its region.
    const widgets = state.uiOf(app)
    if widgets.*.regionCount < 30 { return 122 }
    const check = view.areaOf(widgets, optionId(fills.FILL, ITEM_MERGED))
    if check.width < 100 || check.height != kit_module.ROW { return 123 }
    if !save(&canvas, "fills-options.png") { return 124 }
    // Every blend mode is in the list: the last ones show their own names
    // (two modes the list lacked would both show its first row).
    const options = fills.fillOptions(app).?
    const blendArea = view.areaOf(widgets, optionId(fills.FILL, ITEM_BLEND))
    if blendArea.width < 50 { return 223 }
    const last = @intCast(u16, blend.listedCount() - 1)
    options.*.common.mode = last
    _ = panels(app, &canvas, 280)
    const lastShown = areaSum(&canvas, blendArea)
    options.*.common.mode = last - 1
    _ = panels(app, &canvas, 280)
    const beforeLast = areaSum(&canvas, blendArea)
    options.*.common.mode = blend.NORMAL
    _ = panels(app, &canvas, 280)
    if lastShown == beforeLast || lastShown == areaSum(&canvas, blendArea) || beforeLast == areaSum(&canvas, blendArea) { return 224 }
    // A click on "Sample all layers": the option changes and is kept, with
    // the others as they are, so that what is read back is the same.
    options.*.target = fills.TARGET_SIMILAR
    options.*.common.source = fills.SOURCE_PATTERN
    options.*.common.pattern = 2
    options.*.common.threshold = 37.0
    options.*.common.spread = 55.0
    options.*.common.grow = -12.0
    options.*.common.feather = 9.0
    options.*.common.corners = true
    options.*.common.mode = blend.MULTIPLY
    options.*.common.opacity = 61.0
    options.*.common.merged = false
    _ = view.pointerMove(widgets, check.x + 8, check.y + check.height / 2)
    _ = view.pointerButton(widgets, true)
    _ = view.pointerButton(widgets, false)
    _ = panels(app, &canvas, 280)
    if !options.*.common.merged { return 125 }
    const kept = settings.text(app, "tool.fill")
    if !std.text.contains(kept, "merged=1") || !std.text.contains(kept, "threshold=37") { return 126 }
    const again = script.headless(allocator)
    if again == null || !settings.setText(again.?, "tool.fill", kept) { return 225 }
    const back = fills.fillOptions(again.?).?
    const c = &back.*.common
    if back.*.target != fills.TARGET_SIMILAR || c.*.source != fills.SOURCE_PATTERN || c.*.pattern != 2 || c.*.threshold != 37.0 || c.*.spread != 55.0 || c.*.grow != -12.0 { return 226 }
    if c.*.feather != 9.0 || !c.*.corners || !c.*.merged || c.*.mode != blend.MULTIPLY || c.*.opacity != 61.0 { return 227 }
    options.*.target = fills.TARGET_REGION
    options.*.common.source = fills.SOURCE_FOREGROUND
    options.*.common.threshold = 20.0
    options.*.common.spread = 100.0
    options.*.common.grow = 0.0
    options.*.common.feather = 0.0
    options.*.common.corners = false
    options.*.common.mode = blend.NORMAL
    options.*.common.opacity = 100.0
    options.*.common.merged = false
    _ = view.pointerLeave(widgets)
    // German and light; German at the docks' least width (a label above
    // what it names).
    const theme = app.*.theme
    app.*.german = true
    app.*.theme = theme_module.scaled(theme_module.light(), 1)
    const light = panels(app, &canvas, 280)
    if light != tallest { return 127 }
    if !save(&canvas, "fills-options-light.png") { return 128 }
    app.*.theme = theme
    const narrow = panels(app, &canvas, 140)
    if narrow <= tallest || narrow > 600 { return 129 }
    if !save(&canvas, "fills-options-narrow.png") { return 130 }
    app.*.german = false
    // A layout pass names the regions and draws nothing.
    var nowhere = view.layoutCanvas()
    if panels(app, &nowhere, 280) != tallest || widgets.*.regionCount < 30 { return 131 }
    // At twice the scale, twice as wide: twice as tall.
    app.*.theme = theme_module.scaled(theme, 2)
    const doubled = panels(app, &nowhere, 560)
    app.*.theme = theme
    if doubled != tallest * 2 { return 228 }
    // Not even a width: no trap.
    _ = panels(app, &canvas, 0)
    _ = panels(app, &canvas, -40)
    unsafe { allocator.free(memory.?, width * height * 4, 16) }
    return 0
}

// ---------------------------------------------------------------------------
// The value arena

// A place on the image as a tool gets it (the window's place made up:
// four window pixels an image pixel).
fn inputAt(x: f64, y: f64, button: u32, into: *state.Input) -> void {
    into.*.x = x
    into.*.y = y
    into.*.windowX = @intFromFloat(i32, x * 4.0)
    into.*.windowY = @intFromFloat(i32, y * 4.0)
    into.*.pressure = 1.0
    into.*.tiltX = 0.0
    into.*.tiltY = 0.0
    into.*.rotation = 0.0
    into.*.time = 0.0
    into.*.button = button
    into.*.buttons = 0
    into.*.modifiers = 0
    into.*.clicks = 1
}

fn arena(app: *App) -> u8 {
    if !run(app, "new 256 64 FFFFFF\ntool fill\n") { return 132 }
    const bucket = tools.find(fills.FILL).?
    const ramp_tool = tools.find(fills.GRADIENT).?
    var press: state.Input = undefined
    var end: state.Input = undefined
    inputAt(30.5, 30.5, ui_app.BUTTON_LEFT, &press)
    inputAt(200.5, 40.5, ui_app.BUTTON_LEFT, &end)
    // (The first round makes what stays: tiles, the patterns' block.)
    bucket.*.press.?(app, &press)
    api.undo(app)
    const place = turns.locate()
    const before = turns.used(place)
    var round: usize = 0
    while round < 40 {
        bucket.*.press.?(app, &press)
        api.undo(app)
        ramp_tool.*.press.?(app, &press)
        ramp_tool.*.move.?(app, &end)
        ramp_tool.*.release.?(app, &end)
        api.undo(app)
        round += 1
    }
    // What stays is core/device.mlx's: its commit (and an undo's apply)
    // unites a Rect variable per tile changed, 16 bytes of the arena a
    // tile (measured: 224 bytes a round here, two steps of four tiles
    // and their undoing). The tools themselves add nothing.
    const grown = turns.used(place) - before
    if grown > 40 * 256 { return 133 }
    if stepsOf(app) != 0 { return 134 }
    return 0
}

// One step of the same four tiles made and undone without any tool: what
// core/device.mlx's commit and apply keep in the value arena.
fn coreRound(app: *App) -> void {
    const image = imageOf(app)
    const node = api.activeNode(app).?
    _ = ops.beginPixels(image, node)
    _ = device.fill(node.*.device.?, wholeImage(app), RED)
    _ = ops.endPixels(image, node, "Fill")
    api.undo(app)
}

fn fillRound(app: *App, tool: *const state.Tool, press: *const state.Input) -> void {
    tool.*.press.?(app, press)
    api.undo(app)
}

fn gradientRound(app: *App, tool: *const state.Tool, press: *const state.Input, end: *const state.Input) -> void {
    tool.*.press.?(app, press)
    tool.*.move.?(app, end)
    tool.*.release.?(app, end)
    api.undo(app)
}

fn encloseRound(app: *App, tool: *const state.Tool, press: *const state.Input, end: *const state.Input) -> void {
    tool.*.press.?(app, press)
    tool.*.move.?(app, end)
    tool.*.release.?(app, end)
    api.undo(app)
}

// Thousands of rounds: the tools add nothing to the value arena beyond
// what the same steps cost without them, a preview dragged about adds
// nothing, and the heap holds as much after as before.
fn arenaLong(app: *App) -> u8 {
    const bucket = tools.find(fills.FILL).?
    const ramp_tool = tools.find(fills.GRADIENT).?
    const enclose = tools.find(fills.ENCLOSE).?
    var press: state.Input = undefined
    var end: state.Input = undefined
    var back: state.Input = undefined
    inputAt(30.5, 30.5, ui_app.BUTTON_LEFT, &press)
    inputAt(200.5, 40.5, ui_app.BUTTON_LEFT, &end)
    inputAt(90.5, 10.5, 0, &back)
    const place = turns.locate()
    coreRound(app)
    var before = turns.used(place)
    var round: usize = 0
    while round < 1000 {
        coreRound(app)
        round += 1
    }
    const core = turns.used(place) - before
    // (The bucket fills the empty layer whole: the same four tiles.)
    before = turns.used(place)
    round = 0
    while round < 1000 {
        fillRound(app, bucket, &press)
        round += 1
    }
    const filled = turns.used(place) - before
    if filled > core + 64 { return 229 }
    before = turns.used(place)
    round = 0
    while round < 1000 {
        gradientRound(app, ramp_tool, &press, &end)
        round += 1
    }
    const laid = turns.used(place) - before
    if laid > core + 64 { return 230 }
    // The preview rendered again at every motion.
    ramp_tool.*.press.?(app, &press)
    before = turns.used(place)
    round = 0
    while round < 500 {
        ramp_tool.*.move.?(app, if round % 2 == 0 { &end } else { &back })
        round += 1
    }
    const previewed_bytes = turns.used(place) - before
    ramp_tool.*.cancel.?(app)
    if previewed_bytes > 64 || api.activeNode(app).?.*.overlay != null { return 231 }
    // Enclose and fill round an island of one tile: what core keeps for a
    // tile is at most what it keeps for four.
    const layer = layerOf(app)
    outline(layer, 70, 20, 20, BLACK)
    touched(app)
    const options = fills.encloseOptions(app).?
    options.*.method = @intCast(usize, fill.ALL_REGIONS)
    options.*.shape = fills.ENCLOSE_RECTANGLE
    var corner: state.Input = undefined
    var far: state.Input = undefined
    inputAt(65.5, 15.5, ui_app.BUTTON_LEFT, &corner)
    inputAt(95.5, 45.5, ui_app.BUTTON_LEFT, &far)
    encloseRound(app, enclose, &corner, &far)
    before = turns.used(place)
    round = 0
    while round < 1000 {
        encloseRound(app, enclose, &corner, &far)
        round += 1
    }
    const enclosed_bytes = turns.used(place) - before
    if enclosed_bytes > core + 64 { return 232 }
    // The heap: as much after a hundred more rounds of each as before.
    fillRound(app, bucket, &press)
    gradientRound(app, ramp_tool, &press, &end)
    encloseRound(app, enclose, &corner, &far)
    const live = std.heap.liveBytes()
    round = 0
    while round < 100 {
        fillRound(app, bucket, &press)
        gradientRound(app, ramp_tool, &press, &end)
        encloseRound(app, enclose, &corner, &far)
        round += 1
    }
    if std.heap.liveBytes() != live { return 233 }
    if stepsOf(app) != 0 { return 234 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const found = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if found != null {
        const value = std.string.asSlice(found.?)
        shotsLength = std.text.append(&shots, 0, 1000, value)
        // (No slash twice.)
        while shotsLength > 1 && shots[shotsLength - 1] == 47 { shotsLength -= 1 }
    }
    const made = script.headless(std.heap.allocator())
    if made == null { return 135 }
    const app = made.?
    // Options kept from an earlier run are read at the first asking.
    if !settings.setText(app, "tool.enclosefill", "shape=1;method=3;threshold=33;reference=4278190335;mode=999") { return 136 }
    const kept = fills.encloseOptions(app).?
    if kept.*.shape != fills.ENCLOSE_ELLIPSE || kept.*.method != 3 || kept.*.common.threshold != 33.0 || kept.*.reference != 0xFF0000FF || kept.*.common.mode != 0 || kept.*.common.spread != 100.0 { return 137 }
    if !run(app, "size 1024 768\n") { return 138 }
    var failed = present(app)
    if failed == 0 { failed = bucket(app) }
    if failed == 0 { failed = threshold(app) }
    if failed == 0 { failed = merged(app) }
    if failed == 0 { failed = selected(app) }
    if failed == 0 { failed = softened(app) }
    if failed == 0 { failed = bucketEdges(app) }
    if failed == 0 { failed = ramps(app) }
    if failed == 0 { failed = previewed(app) }
    if failed == 0 { failed = snapped(app) }
    if failed == 0 { failed = rampEdges(app) }
    if failed == 0 { failed = large(app) }
    if failed == 0 { failed = island(app) }
    if failed == 0 { failed = islandEdges(app) }
    if failed == 0 { failed = farAway(app) }
    if failed == 0 { failed = masked(app) }
    if failed == 0 { failed = optionsRead() }
    if failed == 0 { failed = optionsDrawn(app) }
    if failed == 0 { failed = arena(app) }
    if failed == 0 { failed = arenaLong(app) }
    if failed != 0 { return failed }
    return 13
}
