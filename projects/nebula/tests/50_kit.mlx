// nebula's widget kit (ui/kit.mlx) without a window: frames drawn into a
// canvas of its own, the pointer and keys injected between them as a
// window's events would be. Checked: numbers as text and back; a slider
// dragged over its range, its exponent, Shift's fine drag, the wheel, a
// double click and the right button opening the number, typing, the
// range holding a typed number, Escape, a soft range; a spin box's
// steppers and typing; a check box; a text box editing the caller's
// bytes; a drop-down list opening over what is drawn after it, keys and
// typing choosing (past headings and lines), a press outside closing it
// without reaching what is under it, a long one at the window's foot
// opening over its box, scrolled, naming only the rows in view; tabs; a
// splitter; clipping (pixels outside untouched, regions cut, nested) and
// scrolling; a grid's clicked cell and that only cells in view are
// regions; a curve's points added, moved and removed; a tooltip only
// after the pointer rested, inside the window in its corner; list rows
// clicked, double clicked, folded
// and dragged; a section, swatches, the two colours' parts; what is
// disabled; the drawing set's pixels; a layout pass that names
// the same regions and touches no pixel; every pixel of the gallery
// opaque; the value arena not growing from frame to frame; the heap as
// it was after a kit's destroy. Pictures of the gallery (kit-dark.png,
// kit-light.png and the two with a list open) are written to the
// current directory and, when NEBULA_SHOTS names one, there. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const ui_app = @import("std.ui.app")
const keys = @import("std.ui.keys")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const field_module = @import("std.ui.field")
const kit = @import("../ui/kit.mlx")
const kit_curve = @import("../ui/kit_curve.mlx")
const table = @import("../core/table.mlx")

const Canvas = canvas_module.Canvas
const Text = text_module.Text

const WIDTH: usize = 900
const HEIGHT: usize = 700

const SCENE_BASIC: u8 = 0
const SCENE_CLIP: u8 = 1
const SCENE_SCROLL: u8 = 2
const SCENE_GRID: u8 = 3
const SCENE_CURVE: u8 = 4
const SCENE_GALLERY: u8 = 5
const SCENE_MORE: u8 = 6

const ID_A: u64 = 101
const ID_B: u64 = 102
const ID_CHECK: u64 = 103
const ID_TEXT: u64 = 104
const ID_COMBO: u64 = 105
const ID_UNDER: u64 = 106
const ID_TABS: u64 = 107
const ID_SPLIT: u64 = 108
const ID_SPIN: u64 = 109
const ID_TOOL: u64 = 110
const ID_INT: u64 = 111
const ID_LONG: u64 = 112
const ID_CORNER: u64 = 113
const ID_CLIPPED: u64 = 120
const ID_SCROLL: u64 = 130
const ID_INNER: u64 = 131
const ID_GRID: u64 = 140
const ID_CURVE: u64 = 150
const ID_ROW: u64 = 201
const ID_FOLD: u64 = 202
const ID_SECTION: u64 = 203
const ID_SWATCH: u64 = 204
const ID_PAIR: u64 = 205
const ID_RADIO: u64 = 206
const ID_OFF: u64 = 207
const ID_FADED: u64 = 208
const ID_ICON: u64 = 209

const MODES = [6][]const u8{ "Normal", "Multiply", "Screen", "Overlay", "Glow", "Hue" }
const TABS = [3][]const u8{ "Tool Options", "Layers", "Palette" }
const HEADS = [4][]const u8{ "Normal", "Under the pointer", "Active", "Disabled" }
const ROW_NAMES = [13][]const u8{ "Button", "Primary", "Plain", "Tool buttons", "Check box", "Radio", "Slider", "Spin box", "Text box", "Drop-down", "Section", "Swatches", "Progress" }
const TOOL_TIPS = [6][]const u8{ "Brush (B)", "Rectangular selection (R)", "Elliptical selection (J)", "Move a layer (T)", "Line (L)", "Fill with the foreground colour (F)" }
const LAYER_NAMES = [4][]const u8{ "Highlights", "Characters with a very long layer name", "Sketch", "Background" }

// The blend modes of the gallery's list: headings, items, a separator.
const BLEND_NAMES = [14][]const u8{ "Normal", "Dissolve", "", "Darken", "Multiply", "Colour burn", "Linear burn", "Lighten", "Screen", "Colour dodge", "Addition", "Contrast", "Overlay", "Soft light" }
const BLEND_KINDS = [14]u8{ 0, 0, 1, 2, 0, 0, 0, 2, 0, 0, 0, 2, 0, 0 }

fn blendName(context: usize, index: usize) -> []const u8 { return BLEND_NAMES[index] }
fn blendKind(context: usize, index: usize) -> u8 { return BLEND_KINDS[index] }

// The lists the widgets get as slices, kept in heap memory once (a
// constant table sliced in every frame would be copied into the value
// arena each time).
var keptModes: table.Kept = table.Kept.{ .address = 0, .length = 0 }
var keptTabs: table.Kept = table.Kept.{ .address = 0, .length = 0 }

fn modes() -> []const []const u8 {
    if keptModes.address != 0 { return table.rows([]const u8, &keptModes) }
    return table.keep([]const u8, &keptModes, MODES[0..])
}

fn tabNames() -> []const []const u8 {
    if keptTabs.address != 0 { return table.rows([]const u8, &keptTabs) }
    return table.keep([]const u8, &keptTabs, TABS[0..])
}

// A long list (as many as there are blend modes and more): "Brush 00" to
// "Brush 69", named from the test's record.
const LONG: usize = 70

fn longName(context: usize, index: usize) -> []const u8 {
    const t: *T = unsafe { @ptrFromInt(*T, context) }
    const bytes: [*]u8 = &t.*.longNames
    return bytes[index * 8..index * 8 + 8]
}

const T = struct {
    ui: view.Ui
    theme: theme_module.Theme
    body: Text
    small: Text
    mono: Text
    fonts: bool
    canvas: Canvas
    pixels: [*]u32
    copy: [*]u32
    kit: *kit.Kit
    time: u64
    scene: u8
    light: bool
    german: bool
    again: bool
    regions: usize

    // The basic scene's values and what its widgets said.
    a: f64
    b: f64
    optionsA: kit.SliderOptions
    optionsB: kit.SliderOptions
    optionsSpin: kit.SliderOptions
    changedA: usize
    releasedA: usize
    changedB: usize
    check: bool
    toggled: usize
    name: [64]u8
    nameLength: usize
    edited: usize
    submitted: usize
    cancelled: usize
    mode: usize
    chose: usize
    underClicks: usize
    tab: usize
    tabChanges: usize
    splitMoved: i32
    splitReleased: usize
    spin: f64
    spinChanges: usize
    whole: i32
    toolClicks: usize
    long: usize
    longChanges: usize
    longNames: [560]u8
    // The other scenes'.
    clipButton: bool
    nested: bool
    offset: i32
    contentY: i32
    inner: f64
    gridOffset: i32
    gridClicked: usize
    xs: [32]f32
    ys: [32]f32
    points: usize
    curveChanges: usize
    curveReleased: usize
    rowClicks: usize
    rowDoubles: usize
    rowOpen: bool
    folds: usize
    dragging: bool
    drops: usize
    sectionOpen: bool
    swatchClicks: usize
    pair: u8
    radioClicks: usize
    offClicks: usize
    iconClicks: usize
    busyOn: bool
    onlyOff: bool
    // The gallery's.
    values: [64]f64
    flags: [64]bool
    texts: [4][32]u8
    textLengths: [4]usize
    choices: [8]usize
    open: [8]bool
    tool: usize
    galleryTab: usize
    blend: usize
    listOffset: i32
    paletteOffset: i32
    palette: usize
    layer: usize
    folded: [4]bool
    options: [4]kit.SliderOptions
    gxs: [32]f32
    gys: [32]f32
    gpoints: usize
}

fn rectA() -> ui.Rect { return ui.rect(20, 20, 200, 24) }
fn rectB() -> ui.Rect { return ui.rect(20, 50, 200, 24) }
fn rectCheck() -> ui.Rect { return ui.rect(20, 80, 200, 24) }
fn rectText() -> ui.Rect { return ui.rect(20, 110, 200, 24) }
fn rectCombo() -> ui.Rect { return ui.rect(20, 140, 200, 24) }
fn rectUnder() -> ui.Rect { return ui.rect(20, 170, 200, 120) }
fn rectTabs() -> ui.Rect { return ui.rect(20, 320, 60, 24) }
fn rectSplit() -> ui.Rect { return ui.rect(400, 20, 6, 200) }
fn rectSpin() -> ui.Rect { return ui.rect(250, 20, 100, 24) }
fn rectTool() -> ui.Rect { return ui.rect(250, 60, 28, 28) }
fn rectInt() -> ui.Rect { return ui.rect(250, 180, 100, 24) }
fn rectLong() -> ui.Rect { return ui.rect(20, 660, 200, 24) }
fn rectScroll() -> ui.Rect { return ui.rect(500, 300, 200, 100) }
fn rectGrid() -> ui.Rect { return ui.rect(20, 400, 208, 100) }
fn rectCurve() -> ui.Rect { return ui.rect(100, 100, 212, 212) }

fn float(value: i32) -> f64 { return @floatFromInt(f64, value) }

// The test's icons: a stroke, a frame, a ring, a cross, a line, squares.
fn icon(context: usize, canvas: *Canvas, x: i32, y: i32, size: i32, color: u32) -> void {
    const fx = float(x)
    const fy = float(y)
    const fs = float(size)
    if context == 0 {
        kit.line(canvas, fx + fs * 0.3, fy + fs * 0.7, fx + fs * 0.85, fy + fs * 0.15, color, 2.5)
        canvas_module.fillRoundedRect(canvas, x + 1, y + size - 7, 6, 6, 3, color)
    } else if context == 1 {
        kit.frame(canvas, ui.rect(x + 2, y + 3, size - 4, size - 6), color)
    } else if context == 2 {
        canvas_module.strokeRoundedRect(canvas, x + 1, y + 1, size - 2, size - 2, (size - 2) / 2, 2, color)
    } else if context == 3 {
        kit.line(canvas, fx + fs * 0.5, fy + 1.0, fx + fs * 0.5, fy + fs - 1.0, color, 1.6)
        kit.line(canvas, fx + 1.0, fy + fs * 0.5, fx + fs - 1.0, fy + fs * 0.5, color, 1.6)
    } else if context == 4 {
        kit.line(canvas, fx + 2.0, fy + fs - 2.0, fx + fs - 2.0, fy + 2.0, color, 1.4)
    } else {
        kit.checker(canvas, ui.rect(x + 2, y + 2, size - 4, size - 4), (size - 4) / 4)
        kit.frame(canvas, ui.rect(x + 2, y + 2, size - 4, size - 4), color)
    }
}

// A palette's cell: a colour made from its number.
fn paletteCell(context: usize, index: usize, canvas: *Canvas, cell: ui.Rect, lit: bool) -> void {
    const red = @intCast(u32, (index * 37 + 40) % 256)
    const green = @intCast(u32, (index * 91 + 90) % 256)
    const blue = @intCast(u32, (index * 151 + 20) % 256)
    canvas_module.fillRoundedRect(canvas, cell.x + 3, cell.y + 3, cell.width - 6, cell.height - 6, 3, canvas_module.color(255, red, green, blue))
}

fn drawBasic(t: *T) -> void {
    const k = t.*.kit
    if kit.slider(k, ID_A, rectA(), "Opacity", &t.*.a, &t.*.optionsA) { t.*.changedA += 1 }
    if kit.released(k, ID_A) { t.*.releasedA += 1 }
    if kit.slider(k, ID_B, rectB(), "Size", &t.*.b, &t.*.optionsB) { t.*.changedB += 1 }
    if kit.checkBox(k, ID_CHECK, rectCheck(), "Lock alpha", &t.*.check) { t.*.toggled += 1 }
    const result = kit.textBox(k, ID_TEXT, rectText(), &t.*.name, &t.*.nameLength, 32, "Name")
    if result == kit.TEXT_EDITED { t.*.edited += 1 }
    if result == kit.TEXT_SUBMITTED { t.*.submitted += 1 }
    if result == kit.TEXT_CANCELLED { t.*.cancelled += 1 }
    if kit.comboBox(k, ID_COMBO, rectCombo(), modes(), &t.*.mode) { t.*.chose += 1 }
    // Drawn after the box whose list covers it.
    if kit.button(k, ID_UNDER, rectUnder(), "", kit.BUTTON_NORMAL) { t.*.underClicks += 1 }
    if kit.tabs(k, ID_TABS, rectTabs(), tabNames(), &t.*.tab) { t.*.tabChanges += 1 }
    t.*.splitMoved += kit.splitter(k, ID_SPLIT, rectSplit(), true)
    if kit.released(k, ID_SPLIT) { t.*.splitReleased += 1 }
    if kit.spinBox(k, ID_SPIN, rectSpin(), &t.*.spin, &t.*.optionsSpin) { t.*.spinChanges += 1 }
    if kit.toolButton(k, ID_TOOL, rectTool(), icon, 0, false, "Brush") { t.*.toolClicks += 1 }
    _ = kit.intBox(k, ID_INT, rectInt(), &t.*.whole, &t.*.optionsSpin)
    // At the window's foot: its list opens over it.
    if kit.comboBoxWith(k, ID_LONG, rectLong(), LONG, longName, @intFromPtr(t), &t.*.long) { t.*.longChanges += 1 }
}

fn drawClip(t: *T) -> void {
    const k = t.*.kit
    if t.*.clipButton {
        kit.clipBegin(k, ui.rect(100, 100, 100, 50))
        _ = kit.button(k, ID_CLIPPED, ui.rect(150, 110, 120, 30), "Clipped", kit.BUTTON_PRIMARY)
        kit.clipEnd(k)
    }
    if t.*.nested {
        kit.clipBegin(k, ui.rect(300, 100, 200, 200))
        kit.clipBegin(k, ui.rect(450, 150, 200, 100))
        kit.fillStraight(kit.canvasOf(k), ui.rect(0, 0, 900, 700), 0xFFFF0000)
        kit.clipEnd(k)
        kit.clipEnd(k)
    }
}

fn drawScroll(t: *T) -> void {
    const k = t.*.kit
    const content = kit.scrollBegin(k, ID_SCROLL, rectScroll(), 300, &t.*.offset)
    t.*.contentY = content.y
    _ = kit.slider(k, ID_INNER, ui.rect(content.x + 4, content.y + 4, content.width - 8, 24), "Inner", &t.*.inner, &t.*.optionsA)
    var row: i32 = 1
    while row < 10 {
        _ = kit.button(k, view.idOf(ID_SCROLL, @intCast(usize, 100 + row)), ui.rect(content.x + 4, content.y + row * 30, content.width - 8, 24), "Row", kit.BUTTON_PRIMARY)
        row += 1
    }
    kit.scrollEnd(k)
}

fn drawGrid(t: *T) -> void {
    const clicked = kit.grid(t.*.kit, ID_GRID, rectGrid(), 40, 40, 1000, 7, &t.*.gridOffset, paletteCell, 0)
    if clicked != null { t.*.gridClicked = clicked.? }
}

fn drawCurve(t: *T) -> void {
    if kit.curveEditor(t.*.kit, ID_CURVE, rectCurve(), &t.*.xs, &t.*.ys, &t.*.points, 8) { t.*.curveChanges += 1 }
    if kit.released(t.*.kit, ID_CURVE) { t.*.curveReleased += 1 }
}

fn drawMore(t: *T) -> void {
    const k = t.*.kit
    // What is disabled, by its kind or by the scope it is drawn in.
    if kit.button(k, ID_OFF, ui.rect(20, 190, 100, 24), "Off", kit.BUTTON_NORMAL | kit.BUTTON_DISABLED) { t.*.offClicks += 1 }
    kit.disabledBegin(k)
    if kit.button(k, ID_FADED, ui.rect(130, 190, 100, 24), "Faded", kit.BUTTON_PRIMARY) { t.*.offClicks += 1 }
    var value: f64 = 5.0
    _ = kit.slider(k, ID_FADED + 1000, ui.rect(240, 190, 100, 24), "", &value, &t.*.optionsA)
    kit.disabledEnd(k)
    if t.*.onlyOff { return }
    const row = ui.rect(20, 20, 200, 24)
    const said = kit.listRow(k, ID_ROW, row, false, false)
    if said == kit.ROW_CLICKED { t.*.rowClicks += 1 }
    if said == kit.ROW_DOUBLE_CLICKED { t.*.rowDoubles += 1 }
    if kit.expander(k, ID_FOLD, 28, 27, &t.*.rowOpen) { t.*.folds += 1 }
    t.*.dragging = kit.dragRow(k, ID_ROW, row)
    if kit.dropped(k, ID_ROW) { t.*.drops += 1 }
    _ = kit.section(k, ID_SECTION, ui.rect(20, 60, 200, 24), "Section", &t.*.sectionOpen)
    if kit.colorSwatch(k, ID_SWATCH, ui.rect(20, 100, 24, 24), 0x80FF0000, false) { t.*.swatchClicks += 1 }
    const part = kit.colorPair(k, ID_PAIR, ui.rect(60, 100, 48, 48), 0xFF102030, 0xFFFFFFFF)
    if part != kit.PAIR_NONE { t.*.pair = part }
    if kit.radio(k, ID_RADIO, ui.rect(20, 160, 200, 24), "Radio", false) { t.*.radioClicks += 1 }
    if kit.iconButton(k, ID_ICON, ui.rect(250, 20, 28, 28), null, 0, "") { t.*.iconClicks += 1 }
    if t.*.busyOn { kit.busy(k, ui.rect(20, 230, 200, 8)) }
    kit.progress(k, ui.rect(20, 250, 200, 8), 0.5)
    // In the window's corner: its tooltip has to go up and to the left.
    _ = kit.toolButton(k, ID_CORNER, ui.rect(868, 668, 28, 28), icon, 4, false, TOOL_TIPS[5])
}

// One widget of the gallery's table in one of four states: as it is,
// with the pointer on it, active (held down, chosen or open), disabled.
// The pointer is put on it by saying so in the context for the call.
fn specimen(t: *T, row: usize, state: usize, id: u64, cell: ui.Rect) -> void {
    const k = t.*.kit
    const widgets = &t.*.ui
    const hover = widgets.*.hover
    const pressed = widgets.*.pressed
    const down = widgets.*.pointerDown
    const slot = row * 4 + state
    if state == 3 { kit.disabledBegin(k) }
    if state == 1 { widgets.*.hover = id }
    if state == 2 && (row <= 2 || row == 10) {
        widgets.*.pressed = id
        widgets.*.pointerDown = true
    }
    if row == 0 {
        _ = kit.button(k, id, cell, "Apply", kit.BUTTON_NORMAL)
    } else if row == 1 {
        _ = kit.button(k, id, cell, "Save", kit.BUTTON_PRIMARY)
    } else if row == 2 {
        _ = kit.button(k, id, cell, "Reset", kit.BUTTON_PLAIN)
    } else if row == 3 {
        var index: usize = 0
        while index < 3 {
            const part = view.idOf(id, index)
            if state == 1 && index == 0 { widgets.*.hover = part }
            _ = kit.toolButton(k, part, ui.rect(cell.x + @intCast(i32, index) * 30, cell.y - 2, 28, 28), icon, index, state == 2 && index == 0, "")
            index += 1
        }
    } else if row == 4 {
        t.*.flags[slot] = state >= 2
        _ = kit.checkBox(k, id, cell, "Lock alpha", &t.*.flags[slot])
    } else if row == 5 {
        _ = kit.radio(k, id, cell, "Round tip", state >= 2)
    } else if row == 6 {
        _ = kit.slider(k, id, cell, "Size", &t.*.values[slot], &t.*.options[0])
    } else if row == 7 {
        _ = kit.spinBox(k, id, cell, &t.*.values[slot], &t.*.options[1])
    } else if row == 8 {
        _ = kit.textBox(k, id, cell, &t.*.texts[state], &t.*.textLengths[state], 32, "Layer name")
    } else if row == 9 {
        _ = kit.comboBox(k, id, cell, modes(), &t.*.choices[state])
    } else if row == 10 {
        t.*.open[state] = state == 2
        _ = kit.section(k, id, cell, "Brush tip", &t.*.open[state])
    } else if row == 11 {
        var index: usize = 0
        while index < 4 {
            const part = view.idOf(id, index)
            if state == 1 && index == 1 { widgets.*.hover = part }
            const colors = [4]u32{ 0xFFE0563B, 0xFF3B8FE0, 0x803BE07A, 0x18FFFFFF }
            _ = kit.colorSwatch(k, part, ui.rect(cell.x + @intCast(i32, index) * 27, cell.y, 24, 24), colors[index], state == 2 && index == 0)
            index += 1
        }
    } else {
        const bar = ui.rect(cell.x, cell.y + 8, cell.width, 8)
        if state == 2 { kit.busy(k, bar) } else { kit.progress(k, bar, if state == 0 { 0.35 } else { 0.8 }) }
    }
    widgets.*.hover = hover
    widgets.*.pressed = pressed
    widgets.*.pointerDown = down
    if state == 3 { kit.disabledEnd(k) }
}

fn drawGallery(t: *T) -> void {
    const k = t.*.kit
    const theme = &t.*.theme
    const canvas = kit.canvasOf(k)
    canvas_module.fillRoundedRect(canvas, 8, 36, 570, 656, 6, theme.*.panel)
    canvas_module.fillRoundedRect(canvas, 590, 36, 302, 656, 6, theme.*.panel)
    kit.heading(k, ui.rect(16, 8, 300, 24), "Nebula: the widget kit")
    kit.label(k, ui.rect(600, 8, 284, 24), if t.*.light { "light theme" } else { "dark theme" }, kit.TEXT_DIM, kit.ALIGN_RIGHT)

    // The table: a widget a row, a state a column.
    var state: usize = 0
    while state < 4 {
        kit.label(k, ui.rect(112 + @intCast(i32, state) * 116, 44, 110, 20), HEADS[state], kit.TEXT_DIM, kit.ALIGN_LEFT)
        state += 1
    }
    var row: usize = 0
    while row < 13 {
        const y = 70 + @intCast(i32, row) * 32
        kit.label(k, ui.rect(18, y, 90, 24), ROW_NAMES[row], kit.TEXT_DIM, kit.ALIGN_LEFT)
        state = 0
        while state < 4 {
            specimen(t, row, state, @intCast(u64, 1000 + row * 10 + state), ui.rect(112 + @intCast(i32, state) * 116, y, 108, 24))
            state += 1
        }
        row += 1
    }
    kit.separator(k, ui.rect(16, 490, 554, 9))

    // A scrolled view of rows, taller than it shows.
    kit.label(k, ui.rect(18, 502, 200, 20), "Scrolled, clipped", kit.TEXT_DIM, kit.ALIGN_LEFT)
    const content = kit.scrollBegin(k, 1500, ui.rect(16, 526, 250, 156), 12 * 28, &t.*.listOffset)
    row = 0
    while row < 12 {
        const line = ui.rect(content.x + 2, content.y + @intCast(i32, row) * 28 + 2, content.width - 6, 24)
        if row % 3 == 0 {
            _ = kit.slider(k, @intCast(u64, 1510 + row), line, "Flow", &t.*.values[52 + row], &t.*.options[2])
        } else if row % 3 == 1 {
            _ = kit.checkBox(k, @intCast(u64, 1510 + row), line, "Pressure changes the size", &t.*.flags[52 + row])
        } else {
            _ = kit.button(k, @intCast(u64, 1510 + row), line, "Reset this group", kit.BUTTON_NORMAL)
        }
        row += 1
    }
    kit.scrollEnd(k)

    // The drawing set.
    kit.label(k, ui.rect(284, 502, 140, 20), "Lines, checker", kit.TEXT_DIM, kit.ALIGN_LEFT)
    kit.checker(canvas, ui.rect(284, 526, 132, 132), 8)
    kit.fillStraight(canvas, ui.rect(284, 592, 132, 66), 0x90203050)
    kit.frame(canvas, ui.rect(284, 526, 132, 132), theme.*.border)
    var spoke: i32 = 0
    while spoke < 12 {
        const end_x = 350.5 + float(60 * @intCast(i32, COSINES[@intCast(usize, spoke)])) / 1000.0
        const end_y = 592.5 + float(60 * @intCast(i32, SINES[@intCast(usize, spoke)])) / 1000.0
        kit.line(canvas, 350.5, 592.5, end_x, end_y, theme.*.accent, 1.0 + float(spoke) * 0.25)
        spoke += 1
    }
    kit.hline(canvas, 284, 668, 132, theme.*.text)
    kit.vline(canvas, 420, 526, 132, theme.*.text)

    // Labels.
    kit.label(k, ui.rect(436, 502, 130, 20), "Labels", kit.TEXT_DIM, kit.ALIGN_LEFT)
    kit.frame(canvas, ui.rect(436, 526, 132, 24), theme.*.divider)
    kit.label(k, ui.rect(436, 526, 132, 24), "Left", kit.TEXT_NORMAL, kit.ALIGN_LEFT)
    kit.frame(canvas, ui.rect(436, 554, 132, 24), theme.*.divider)
    kit.label(k, ui.rect(436, 554, 132, 24), "Centre", kit.TEXT_ACCENT, kit.ALIGN_CENTER)
    kit.frame(canvas, ui.rect(436, 582, 132, 24), theme.*.divider)
    kit.label(k, ui.rect(436, 582, 132, 24), "Right", kit.TEXT_DANGER, kit.ALIGN_RIGHT)
    kit.frame(canvas, ui.rect(436, 610, 132, 24), theme.*.divider)
    kit.label(k, ui.rect(436, 610, 132, 24), "A label that is too long for its place", kit.TEXT_NORMAL, kit.ALIGN_LEFT)
    _ = kit.intBox(k, 1600, ui.rect(436, 642, 132, 24), &t.*.whole, &t.*.options[3])

    // A docker.
    if kit.tabs(k, 2000, ui.rect(598, 42, 286, 26), tabNames(), &t.*.galleryTab) {}
    var tool: usize = 0
    while tool < 6 {
        if kit.toolButton(k, @intCast(u64, 2100 + tool), ui.rect(598 + @intCast(i32, tool) * 30, 76, 28, 28), icon, tool, t.*.tool == tool, TOOL_TIPS[tool]) { t.*.tool = tool }
        tool += 1
    }
    if kit.section(k, 2200, ui.rect(598, 112, 286, 24), "Brush tip", &t.*.open[4]) {
        _ = kit.slider(k, 2201, ui.rect(598, 140, 286, 24), "Size", &t.*.values[48], &t.*.options[0])
        _ = kit.slider(k, 2202, ui.rect(598, 168, 286, 24), "Opacity", &t.*.values[49], &t.*.options[2])
        _ = kit.slider(k, 2203, ui.rect(598, 196, 286, 24), "Rotation", &t.*.values[50], &t.*.options[1])
        kit.label(k, ui.rect(600, 224, 90, 24), "Blend mode", kit.TEXT_NORMAL, kit.ALIGN_LEFT)
        _ = kit.comboBoxKinds(k, 2204, ui.rect(694, 224, 190, 24), 14, blendName, blendKind, 0, &t.*.blend)
        _ = kit.checkBox(k, 2205, ui.rect(598, 252, 286, 24), "Keep the alpha of what is painted on", &t.*.flags[48])
    }
    if kit.section(k, 2300, ui.rect(598, 284, 286, 24), "Pressure curve", &t.*.open[5]) {
        _ = kit.curveEditor(k, 2301, ui.rect(598, 312, 286, 104), &t.*.gxs, &t.*.gys, &t.*.gpoints, 8)
    }
    kit.heading(k, ui.rect(600, 424, 200, 24), "Layers")
    var layer: usize = 0
    while layer < 4 {
        const area = ui.rect(598, 450 + @intCast(i32, layer) * 26, 286, 24)
        const layer_id = @intCast(u64, 2400 + layer * 4)
        if kit.listRow(k, layer_id, area, t.*.layer == layer, false) != kit.ROW_NONE { t.*.layer = layer }
        _ = kit.expander(k, layer_id + 1, area.x + 8, area.y + 7, &t.*.folded[layer])
        _ = kit.colorSwatch(k, layer_id + 2, ui.rect(area.x + 26, area.y + 3, 18, 18), if layer == 1 { 0x60E0A03B } else { 0xFF707890 }, false)
        kit.label(k, ui.rect(area.x + 52, area.y, area.width - 60, 24), LAYER_NAMES[layer], kit.TEXT_NORMAL, kit.ALIGN_LEFT)
        _ = kit.dragRow(k, layer_id, area)
        layer += 1
    }
    kit.dropLine(k, 450 + 3 * 26 - 1, 604, 878)
    _ = kit.splitter(k, 2500, ui.rect(598, 556, 286, 7), false)
    const picked = kit.grid(k, 2600, ui.rect(598, 566, 286, 74), 26, 26, 96, t.*.palette, &t.*.paletteOffset, paletteCell, 0)
    if picked != null { t.*.palette = picked.? }
    _ = kit.colorPair(k, 2700, ui.rect(600, 646, 40, 40), 0xFFE0563B, 0x90FFFFFF)
    _ = kit.spinBox(k, 2800, ui.rect(660, 654, 104, 24), &t.*.values[51], &t.*.options[1])
    _ = kit.button(k, 2801, ui.rect(776, 654, 108, 24), "Add to the palette", kit.BUTTON_NORMAL)
}

// The directions of twelve spokes, in thousandths.
const COSINES = [12]i32{ 1000, 866, 500, 0, -500, -866, -1000, -866, -500, 0, 500, 866 }
const SINES = [12]i32{ 0, 500, 866, 1000, 866, 500, 0, -500, -866, -1000, -866, -500 }

// One frame of the scene: drawn, or only laid out (no pixels).
fn frame(t: *T, layout: bool) -> void {
    var nowhere = view.layoutCanvas()
    const canvas: *Canvas = if layout { &nowhere } else { &t.*.canvas }
    const widgets = &t.*.ui
    view.begin(widgets, canvas)
    if !layout { canvas_module.clear(canvas, t.*.theme.background) }
    kit.begin(t.*.kit, widgets, canvas, &t.*.theme, &t.*.body, &t.*.small, &t.*.mono, t.*.time, t.*.german)
    if t.*.scene == SCENE_BASIC {
        drawBasic(t)
    } else if t.*.scene == SCENE_CLIP {
        drawClip(t)
    } else if t.*.scene == SCENE_SCROLL {
        drawScroll(t)
    } else if t.*.scene == SCENE_GRID {
        drawGrid(t)
    } else if t.*.scene == SCENE_CURVE {
        drawCurve(t)
    } else if t.*.scene == SCENE_MORE {
        drawMore(t)
    } else {
        drawGallery(t)
    }
    t.*.again = kit.end(t.*.kit)
    t.*.regions = widgets.*.regionCount
    _ = view.end(widgets)
}

// The window's events as an app hands them on (a layout pass before a
// press and after a click, as the desktop's apps do), a frame after each.
fn motion(t: *T, x: i32, y: i32) -> void {
    _ = ui_app.feed(&t.*.ui, ui_app.EVENT_MOTION, @bitCast(u32, x), y)
    frame(t, false)
}

fn press(t: *T) -> void {
    frame(t, true)
    _ = ui_app.feed(&t.*.ui, ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 1)
    frame(t, false)
}

fn release(t: *T) -> void {
    if ui_app.feed(&t.*.ui, ui_app.EVENT_BUTTON, ui_app.BUTTON_LEFT, 0) == ui_app.FEED_CLICK { frame(t, true) }
    frame(t, false)
}

fn click(t: *T, x: i32, y: i32) -> void {
    motion(t, x, y)
    press(t)
    release(t)
}

fn wheel(t: *T, steps: i32) -> void {
    _ = ui_app.feed(&t.*.ui, ui_app.EVENT_WHEEL, 0, steps)
    frame(t, false)
}

fn key(t: *T, code: u32, typed: []const u8) -> bool {
    const used = kit.key(t.*.kit, code, 0, typed)
    frame(t, false)
    return used
}

fn pixelAt(t: *T, x: i32, y: i32) -> u32 {
    return t.*.pixels[@intCast(usize, y) * WIDTH + @intCast(usize, x)]
}

fn keep(t: *T) -> void {
    var index: usize = 0
    while index < WIDTH * HEIGHT {
        t.*.copy[index] = t.*.pixels[index]
        index += 1
    }
}

// How many pixels differ from the kept ones, inside `area` or (`inside`
// false) outside it.
fn differing(t: *T, area: ui.Rect, inside: bool) -> usize {
    var count: usize = 0
    var y: i32 = 0
    while y < @intCast(i32, HEIGHT) {
        var x: i32 = 0
        while x < @intCast(i32, WIDTH) {
            const at = @intCast(usize, y) * WIDTH + @intCast(usize, x)
            if ui.contains(area, x, y) == inside && t.*.copy[at] != t.*.pixels[at] { count += 1 }
            x += 1
        }
        y += 1
    }
    return count
}

fn shows(value: f64, decimals: usize, wanted: []const u8) -> bool {
    var room: [kit.NUMBER_ROOM]u8 = undefined
    const bytes: [*]u8 = &room
    return std.text.same(bytes[0..kit.formatNumber(value, decimals, bytes)], wanted)
}

fn reads(text: []const u8, wanted: f64) -> bool {
    var value: f64 = -77.0
    if !kit.parseNumber(text, &value) { return false }
    const off = value - wanted
    return off < 1.0e-9 && off > -1.0e-9
}

fn near(value: f64, wanted: f64) -> bool {
    return value - wanted < 0.0105 && wanted - value < 0.0105
}

// Numbers as text and back.
fn checkNumbers() -> u8 {
    if !shows(0.0, 0, "0") || !shows(0.0, 2, "0.00") { return 1 }
    if !shows(-0.5, 0, "-1") || !shows(-0.5, 1, "-0.5") || !shows(-0.4, 0, "0") { return 2 }
    if !shows(1.0e6, 0, "1000000") || !shows(1.0e6, 2, "1000000.00") { return 3 }
    if !shows(3.14159, 0, "3") || !shows(3.14159, 1, "3.1") || !shows(3.14159, 2, "3.14") || !shows(3.14159, 3, "3.142") || !shows(3.14159, 4, "3.1416") { return 4 }
    if !shows(0.5, 2, "0.50") || !shows(0.285, 2, "0.29") || !shows(99.995, 2, "100.00") { return 5 }
    if !reads("1,5", 1.5) || !reads("1.5", 1.5) || !reads(" -42 px", -42.0) || !reads("+7", 7.0) || !reads("50%", 50.0) || !reads(".25", 0.25) || !reads("0", 0.0) || !reads("\xE2\x88\x923", -3.0) { return 6 }
    var none: f64 = 5.0
    if kit.parseNumber("", &none) || kit.parseNumber("px", &none) || kit.parseNumber("-", &none) || none != 5.0 { return 7 }
    // What is written is read as the same number.
    const values = [5]f64{ 0.0, -0.5, 1.0e6, 3.14159, 12.25 }
    for value in values {
        var decimals: usize = 0
        while decimals <= 4 {
            var room: [kit.NUMBER_ROOM]u8 = undefined
            const bytes: [*]u8 = &room
            const length = kit.formatNumber(value, decimals, bytes)
            var back: f64 = 99.0
            if !kit.parseNumber(bytes[0..length], &back) { return 8 }
            var room2: [kit.NUMBER_ROOM]u8 = undefined
            const bytes2: [*]u8 = &room2
            const length2 = kit.formatNumber(back, decimals, bytes2)
            if !std.text.same(bytes[0..length], bytes2[0..length2]) { return 9 }
            decimals += 1
        }
    }
    return 0
}

// The curve as numbers.
fn checkCurveMath() -> u8 {
    var xs: [8]f32 = undefined
    var ys: [8]f32 = undefined
    xs[0] = 0.0
    ys[0] = 0.0
    xs[1] = 1.0
    ys[1] = 1.0
    var count: usize = 2
    // Two points: the straight line; none: the diagonal.
    if !near(kit_curve.value(&xs, &ys, 2, 0.25), 0.25) || !near(kit_curve.value(&xs, &ys, 0, 0.6), 0.6) { return 1 }
    const added = kit_curve.insert(&xs, &ys, &count, 8, 0.5, 0.9)
    if added == null || added.? != 1 || count != 3 { return 2 }
    // Through its points, smooth between, held in 0..1.
    if !near(kit_curve.value(&xs, &ys, 3, 0.5), 0.9) || !near(kit_curve.value(&xs, &ys, 3, 0.0), 0.0) || !near(kit_curve.value(&xs, &ys, 3, 1.0), 1.0) { return 3 }
    const between = kit_curve.value(&xs, &ys, 3, 0.25)
    if between <= 0.45 || between >= 0.9 { return 4 }
    if kit_curve.value(&xs, &ys, 3, 0.75) > 1.0 { return 5 }
    // No point at another's x, no more than the capacity, the ends stay.
    if kit_curve.insert(&xs, &ys, &count, 8, 0.5, 0.2) != null || kit_curve.insert(&xs, &ys, &count, 3, 0.2, 0.2) != null { return 6 }
    if kit_curve.remove(&xs, &ys, &count, 0) || kit_curve.remove(&xs, &ys, &count, 2) { return 7 }
    if !kit_curve.move(&xs, &ys, 3, 1, 2.0, -1.0) || xs[1] > 1.0 - kit_curve.GAP + 0.0001 || ys[1] != 0.0 { return 8 }
    if !kit_curve.remove(&xs, &ys, &count, 1) || count != 2 || xs[1] != 1.0 { return 9 }
    var lookup: [5]f32 = undefined
    kit_curve.table(&xs, &ys, 2, &lookup, 5)
    if !near(@floatCast(f64, lookup[0]), 0.0) || !near(@floatCast(f64, lookup[2]), 0.5) || !near(@floatCast(f64, lookup[4]), 1.0) { return 10 }
    return 0
}

fn reset(t: *T, scene: u8) -> void {
    t.*.scene = scene
    // (Far from what came before: no press of an earlier check is the
    // first of a double click.)
    t.*.time += 5000
    _ = ui_app.feed(&t.*.ui, ui_app.EVENT_MOTION, 890, 690)
    frame(t, false)
    frame(t, false)
}

fn checkSlider(t: *T) -> u8 {
    const k = t.*.kit
    reset(t, SCENE_BASIC)
    // Dragged from the left end to the right one: low to high.
    t.*.a = 50.0
    t.*.changedA = 0
    t.*.releasedA = 0
    motion(t, 20, 32)
    press(t)
    if t.*.a != 0.0 || t.*.changedA != 1 { return 1 }
    motion(t, 120, 32)
    if t.*.a != 50.0 { return 2 }
    motion(t, 500, 32)
    if t.*.a != 100.0 || t.*.changedA != 3 || t.*.releasedA != 0 { return 3 }
    motion(t, -40, 32)
    if t.*.a != 0.0 { return 4 }
    motion(t, 219, 32)
    release(t)
    if t.*.a != 100.0 || t.*.releasedA != 1 { return 5 }
    // The exponent: the middle of a 1..1000 bar with exponent 3 is an
    // eighth of the way.
    t.*.time += 1000
    motion(t, 120, 62)
    press(t)
    release(t)
    if t.*.b != 126.0 { return 6 }
    // With Shift: from where it is, a tenth of the way.
    t.*.time += 1000
    t.*.a = 50.0
    kit.setModifiers(k, keys.SHIFT)
    motion(t, 40, 32)
    press(t)
    if t.*.a != 50.0 { return 7 }
    motion(t, 140, 32)
    if t.*.a != 55.0 { return 8 }
    release(t)
    kit.setModifiers(k, 0)
    // The wheel: up raises it by a step.
    t.*.releasedA = 0
    wheel(t, -1)
    if t.*.a != 56.0 || t.*.releasedA != 1 { return 9 }
    wheel(t, 2)
    if t.*.a != 54.0 { return 10 }
    // A double click opens the number (and puts back what the first
    // press set); typing 42 and Enter sets it.
    t.*.time += 1000
    t.*.a = 30.0
    motion(t, 120, 32)
    press(t)
    release(t)
    if t.*.a != 50.0 || kit.editing(k, ID_A) { return 11 }
    t.*.time += 150
    press(t)
    if !kit.editing(k, ID_A) || t.*.a != 30.0 || !kit.wantsKeys(k) { return 12 }
    release(t)
    if !kit.editing(k, ID_A) { return 13 }
    if !key(t, 5, "4") || !key(t, 3, "2") { return 14 }
    if t.*.a != 30.0 { return 15 }
    t.*.releasedA = 0
    if !key(t, keys.ENTER, "") { return 16 }
    if t.*.a != 42.0 || kit.editing(k, ID_A) || kit.wantsKeys(k) || t.*.releasedA != 1 { return 17 }
    // Two presses far apart are no double click.
    t.*.time += 1000
    press(t)
    release(t)
    t.*.time += 600
    press(t)
    release(t)
    if kit.editing(k, ID_A) { return 18 }
    // The right button opens it too; a typed number is held in the range.
    kit.secondaryClick(k, 120, 32)
    frame(t, false)
    if !kit.editing(k, ID_A) { return 19 }
    _ = key(t, 6, "5")
    _ = key(t, 11, "0")
    _ = key(t, 11, "0")
    _ = key(t, keys.ENTER, "")
    if t.*.a != 100.0 { return 20 }
    kit.focus(k, ID_A)
    frame(t, false)
    _ = key(t, 12, "-")
    _ = key(t, 4, "3")
    _ = key(t, keys.TAB, "")
    if t.*.a != 0.0 || kit.editing(k, ID_A) { return 21 }
    // A German comma, on a slider with decimals; letters are not typed
    // into a number but are the edit's all the same.
    t.*.optionsA.decimals = 1
    kit.focus(k, ID_A)
    frame(t, false)
    if !key(t, 30, "a") { return 22 }
    _ = key(t, 2, "1")
    _ = key(t, 51, ",")
    _ = key(t, 6, "5")
    _ = key(t, keys.ENTER, "")
    if t.*.a != 1.5 { return 23 }
    t.*.optionsA.decimals = 0
    // Up and Down step what is typed; Escape puts back what was.
    t.*.a = 42.0
    kit.focus(k, ID_A)
    frame(t, false)
    _ = key(t, keys.UP, "")
    _ = key(t, keys.UP, "")
    if t.*.a != 44.0 || !kit.editing(k, ID_A) { return 24 }
    _ = key(t, keys.DOWN, "")
    if t.*.a != 43.0 { return 25 }
    _ = key(t, 8, "7")
    if !key(t, keys.ESCAPE, "") { return 26 }
    if t.*.a != 42.0 || kit.editing(k, ID_A) { return 27 }
    // A press elsewhere ends an edit as Enter does.
    kit.focus(k, ID_A)
    frame(t, false)
    _ = key(t, 10, "9")
    click(t, 600, 600)
    if t.*.a != 9.0 || kit.editing(k, ID_A) { return 28 }
    // A key is not the kit's when nothing is open.
    if key(t, 30, "a") { return 29 }
    // A disabled slider takes nothing.
    t.*.optionsA.disabled = true
    click(t, 200, 32)
    wheel(t, -1)
    if t.*.a != 9.0 { return 30 }
    t.*.optionsA.disabled = false
    // In German numbers are written with a decimal comma (and read with
    // either).
    t.*.german = true
    t.*.optionsA.decimals = 1
    t.*.a = 1.5
    kit.focus(k, ID_A)
    frame(t, false)
    if !std.text.same(field_module.text(&k.*.field), "1,5") { return 31 }
    _ = key(t, 3, "2")
    _ = key(t, 52, ".")
    _ = key(t, 3, "2")
    _ = key(t, 6, "5")
    _ = key(t, keys.ENTER, "")
    if t.*.a != 2.3 { return 32 }
    t.*.german = false
    t.*.optionsA.decimals = 0
    // A soft range: the bar and a drag reach 0..100, a typed number up to
    // 1000, and beyond 100 the bar is full.
    t.*.optionsA.high = 1000.0
    t.*.optionsA.softLow = 0.0
    t.*.optionsA.softHigh = 100.0
    t.*.time += 1000
    motion(t, 120, 32)
    press(t)
    motion(t, 500, 32)
    release(t)
    if t.*.a != 100.0 { return 33 }
    kit.focus(k, ID_A)
    frame(t, false)
    _ = key(t, 6, "5")
    _ = key(t, 11, "0")
    _ = key(t, 11, "0")
    _ = key(t, keys.ENTER, "")
    if t.*.a != 500.0 { return 34 }
    motion(t, 600, 600)
    if pixelAt(t, 215, 22) != pixelAt(t, 25, 22) || pixelAt(t, 215, 22) == t.*.theme.field { return 35 }
    t.*.time += 1000
    motion(t, 120, 32)
    press(t)
    release(t)
    if t.*.a != 50.0 { return 36 }
    t.*.optionsA.high = 100.0
    t.*.optionsA.softHigh = 0.0
    return 0
}

fn checkBoxes(t: *T) -> u8 {
    const k = t.*.kit
    reset(t, SCENE_BASIC)
    // The check box.
    t.*.check = false
    t.*.toggled = 0
    click(t, 30, 92)
    if !t.*.check || t.*.toggled != 1 { return 1 }
    click(t, 30, 92)
    if t.*.check || t.*.toggled != 2 { return 2 }
    // The spin box: its steppers, a held one stepping on, typing.
    t.*.time += 1000
    t.*.spin = 5.0
    click(t, 341, 26)
    if t.*.spin != 6.0 { return 3 }
    click(t, 341, 38)
    click(t, 341, 38)
    if t.*.spin != 4.0 { return 4 }
    motion(t, 341, 26)
    press(t)
    if t.*.spin != 5.0 || !t.*.again { return 5 }
    t.*.time += 100
    frame(t, false)
    if t.*.spin != 5.0 { return 6 }
    t.*.time += 400
    frame(t, false)
    t.*.time += 70
    frame(t, false)
    if t.*.spin != 7.0 { return 7 }
    release(t)
    if t.*.spin != 7.0 { return 8 }
    click(t, 270, 32)
    if !kit.editing(k, ID_SPIN) { return 9 }
    _ = key(t, 3, "2")
    _ = key(t, 4, "3")
    _ = key(t, keys.ENTER, "")
    if t.*.spin != 23.0 || kit.editing(k, ID_SPIN) { return 10 }
    motion(t, 270, 32)
    wheel(t, 1)
    if t.*.spin != 22.0 { return 11 }
    // A press on a stepper while a number is typed: the number is taken,
    // then stepped.
    click(t, 270, 32)
    _ = key(t, 8, "7")
    click(t, 341, 26)
    if t.*.spin != 8.0 || kit.editing(k, ID_SPIN) { return 27 }
    // The same for a whole number.
    t.*.whole = 3
    click(t, 341, 186)
    if t.*.whole != 4 { return 12 }
    // The text box: the caller's bytes change as it is typed.
    t.*.time += 1000
    t.*.name[0] = 'L'
    t.*.name[1] = '1'
    t.*.nameLength = 2
    t.*.edited = 0
    t.*.submitted = 0
    t.*.cancelled = 0
    click(t, 120, 122)
    if !kit.editing(k, ID_TEXT) || t.*.edited != 0 { return 13 }
    // (Its text is selected: what is typed replaces it.)
    if !key(t, 30, "A") { return 14 }
    if t.*.nameLength != 1 || t.*.name[0] != 'A' || t.*.edited != 1 { return 15 }
    _ = key(t, 48, "b")
    if t.*.nameLength != 2 || t.*.name[1] != 'b' || t.*.edited != 2 || t.*.submitted != 0 { return 16 }
    _ = key(t, keys.ENTER, "")
    if t.*.submitted != 1 || kit.editing(k, ID_TEXT) || t.*.nameLength != 2 || t.*.name[0] != 'A' { return 17 }
    // Escape gives back what was there.
    click(t, 120, 122)
    _ = key(t, 45, "x")
    _ = key(t, 45, "y")
    if t.*.nameLength != 2 || t.*.name[0] != 'x' { return 18 }
    _ = key(t, keys.ESCAPE, "")
    if t.*.cancelled != 1 || t.*.nameLength != 2 || t.*.name[0] != 'A' || t.*.name[1] != 'b' || kit.editing(k, ID_TEXT) { return 19 }
    // No more than its capacity (32 here) is taken.
    kit.focus(k, ID_TEXT)
    frame(t, false)
    var typed: usize = 0
    while typed < 40 {
        _ = kit.key(k, 30, 0, "m")
        typed += 1
    }
    frame(t, false)
    _ = key(t, keys.ENTER, "")
    if t.*.nameLength != 32 || t.*.submitted != 2 { return 20 }
    // Tabs.
    t.*.tab = 0
    t.*.tabChanges = 0
    click(t, 50, 332)
    if t.*.tab != 1 || t.*.tabChanges != 1 { return 21 }
    click(t, 70, 332)
    click(t, 70, 332)
    if t.*.tab != 2 || t.*.tabChanges != 2 { return 22 }
    // The splitter: how far the pointer went, frame by frame.
    t.*.splitMoved = 0
    t.*.splitReleased = 0
    motion(t, 403, 100)
    press(t)
    if t.*.splitMoved != 0 { return 23 }
    motion(t, 433, 100)
    if t.*.splitMoved != 30 { return 24 }
    motion(t, 423, 130)
    if t.*.splitMoved != 20 || t.*.splitReleased != 0 { return 25 }
    release(t)
    if t.*.splitMoved != 20 || t.*.splitReleased != 1 { return 26 }
    return 0
}

fn checkList(t: *T) -> u8 {
    const k = t.*.kit
    reset(t, SCENE_BASIC)
    t.*.mode = 0
    t.*.chose = 0
    t.*.underClicks = 0
    const button = t.*.theme.button
    if pixelAt(t, 30, 250) != button { return 1 }
    // A click opens the list, over the button drawn after the box.
    click(t, 120, 152)
    if !kit.wantsKeys(k) || t.*.chose != 0 { return 2 }
    if pixelAt(t, 30, 250) == button || pixelAt(t, 30, 250) >> 24 != 255 { return 3 }
    // A click on its third row chooses that.
    click(t, 120, 230)
    frame(t, false)
    if t.*.mode != 2 || t.*.chose != 1 || kit.wantsKeys(k) || t.*.underClicks != 0 { return 4 }
    motion(t, 600, 600)
    if pixelAt(t, 30, 250) != button { return 5 }
    // Down, Down, Enter: the third item from the first.
    t.*.mode = 0
    click(t, 120, 152)
    if !key(t, keys.DOWN, "") || !key(t, keys.DOWN, "") { return 6 }
    if t.*.mode != 0 { return 7 }
    if !key(t, keys.ENTER, "") { return 8 }
    frame(t, false)
    if t.*.mode != 2 || t.*.chose != 2 || kit.wantsKeys(k) { return 9 }
    // Typing goes to the first item that starts so.
    click(t, 120, 152)
    if !key(t, 34, "g") { return 10 }
    _ = key(t, keys.ENTER, "")
    frame(t, false)
    if t.*.mode != 4 { return 11 }
    click(t, 120, 152)
    _ = key(t, 35, "h")
    _ = key(t, 22, "U")
    _ = key(t, keys.ENTER, "")
    frame(t, false)
    if t.*.mode != 5 { return 12 }
    // Up from the first stays; End and Home.
    t.*.mode = 0
    click(t, 120, 152)
    _ = key(t, keys.UP, "")
    _ = key(t, keys.END, "")
    _ = key(t, keys.UP, "")
    _ = key(t, keys.ENTER, "")
    frame(t, false)
    if t.*.mode != 4 { return 13 }
    // Escape closes with nothing chosen.
    click(t, 120, 152)
    _ = key(t, keys.DOWN, "")
    if !key(t, keys.ESCAPE, "") { return 14 }
    frame(t, false)
    if t.*.mode != 4 || kit.wantsKeys(k) { return 15 }
    // A press outside closes it and is not a click on what is there:
    // neither on the check box nor on the button under the list's place.
    const chosen = t.*.chose
    t.*.check = false
    click(t, 120, 152)
    if !kit.wantsKeys(k) { return 16 }
    click(t, 30, 92)
    if kit.wantsKeys(k) || t.*.check || t.*.chose != chosen || t.*.mode != 4 { return 17 }
    click(t, 120, 152)
    click(t, 210, 500)
    if kit.wantsKeys(k) || t.*.underClicks != 0 { return 18 }
    // While it is open the wheel is the list's, not the slider's under
    // the pointer; and dismiss closes it.
    t.*.a = 50.0
    click(t, 120, 152)
    motion(t, 120, 32)
    wheel(t, -1)
    if t.*.a != 50.0 || !kit.wantsKeys(k) { return 19 }
    kit.dismiss(k)
    frame(t, false)
    if kit.wantsKeys(k) { return 20 }
    // Afterwards a click reaches the button again.
    click(t, 120, 250)
    if t.*.underClicks != 1 { return 21 }
    // A long list at the window's foot opens over its box; only the rows
    // in view are regions; End goes to the last row, Enter chooses it.
    t.*.long = 0
    t.*.longChanges = 0
    motion(t, 600, 600)
    const closed = t.*.regions
    const ground = t.*.theme.background
    if pixelAt(t, 30, 300) != ground { return 22 }
    click(t, 120, 672)
    if !kit.wantsKeys(k) || pixelAt(t, 30, 300) == ground || pixelAt(t, 30, 300) >> 24 != 255 { return 23 }
    if t.*.regions <= closed || t.*.regions - closed > 40 { return 24 }
    _ = key(t, keys.END, "")
    _ = key(t, keys.ENTER, "")
    frame(t, false)
    if t.*.long != LONG - 1 || t.*.longChanges != 1 || kit.wantsKeys(k) { return 25 }
    // Opened again it shows the chosen row at its foot; a notch of the
    // wheel scrolls three rows, and a click chooses what is there now.
    click(t, 120, 672)
    motion(t, 120, 642)
    wheel(t, -1)
    click(t, 120, 642)
    frame(t, false)
    if t.*.long != LONG - 4 || t.*.longChanges != 2 || kit.wantsKeys(k) { return 26 }
    // Letters typed one after another find the first row that starts
    // with all of them.
    click(t, 120, 672)
    const word = "brush 4"
    var at: usize = 0
    while at < word.length {
        if !kit.key(k, 30, 0, word[at..at + 1]) { return 27 }
        at += 1
    }
    frame(t, false)
    _ = key(t, keys.ENTER, "")
    frame(t, false)
    if t.*.long != 40 || kit.wantsKeys(k) { return 28 }
    return 0
}

fn checkMore(t: *T) -> u8 {
    const k = t.*.kit
    reset(t, SCENE_MORE)
    t.*.onlyOff = false
    t.*.rowClicks = 0
    t.*.rowDoubles = 0
    t.*.rowOpen = false
    t.*.folds = 0
    t.*.drops = 0
    // A row: a click, then two close together.
    click(t, 100, 32)
    if t.*.rowClicks != 1 || t.*.rowDoubles != 0 { return 1 }
    t.*.time += 1000
    click(t, 100, 32)
    t.*.time += 200
    click(t, 100, 32)
    if t.*.rowClicks != 2 || t.*.rowDoubles != 1 { return 2 }
    // Its arrow folds it and is no click on the row.
    t.*.time += 1000
    click(t, 30, 30)
    if !t.*.rowOpen || t.*.folds != 1 || t.*.rowClicks != 2 { return 3 }
    // Dragged: only past four pixels, then until it is let go; the end of
    // a drag is a drop and no click.
    motion(t, 150, 32)
    press(t)
    if t.*.dragging { return 4 }
    motion(t, 150, 35)
    if t.*.dragging { return 5 }
    motion(t, 150, 40)
    if !t.*.dragging { return 6 }
    motion(t, 150, 33)
    if !t.*.dragging || t.*.drops != 0 { return 7 }
    release(t)
    if t.*.dragging || t.*.drops != 1 || t.*.rowClicks != 2 { return 8 }
    t.*.time += 1000
    click(t, 100, 32)
    if t.*.drops != 1 || t.*.rowClicks != 3 { return 9 }
    // A section opens and folds.
    t.*.sectionOpen = false
    click(t, 100, 72)
    if !t.*.sectionOpen { return 10 }
    click(t, 100, 72)
    if t.*.sectionOpen { return 11 }
    // A translucent swatch shows the squares under its colour; a click.
    t.*.swatchClicks = 0
    click(t, 32, 112)
    if t.*.swatchClicks != 1 { return 12 }
    motion(t, 600, 600)
    const one = pixelAt(t, 30, 106)
    const other = pixelAt(t, 34, 106)
    if one == other || one >> 24 != 255 || (one >> 16) & 255 < 200 || (other >> 16) & 255 < 150 || one & 255 > 120 { return 13 }
    // The two colours: each part says what it is.
    t.*.pair = kit.PAIR_NONE
    click(t, 65, 105)
    if t.*.pair != kit.PAIR_FOREGROUND { return 14 }
    click(t, 100, 140)
    if t.*.pair != kit.PAIR_BACKGROUND { return 15 }
    click(t, 100, 108)
    if t.*.pair != kit.PAIR_SWAP { return 16 }
    click(t, 68, 140)
    if t.*.pair != kit.PAIR_RESET { return 17 }
    motion(t, 600, 600)
    if pixelAt(t, 70, 110) != 0xFF102030 || pixelAt(t, 100, 140) != 0xFFFFFFFF { return 18 }
    // A radio button and a button without an icon say when clicked.
    t.*.radioClicks = 0
    t.*.iconClicks = 0
    click(t, 100, 172)
    click(t, 264, 34)
    if t.*.radioClicks != 1 || t.*.iconClicks != 1 { return 19 }
    // What is disabled takes no click, names no region and is fainter.
    t.*.offClicks = 0
    click(t, 60, 202)
    click(t, 180, 202)
    click(t, 290, 202)
    if t.*.offClicks != 0 { return 20 }
    t.*.onlyOff = true
    frame(t, false)
    if t.*.regions != 0 { return 21 }
    const faded = pixelAt(t, 140, 202)
    if faded == t.*.theme.primary || faded == t.*.theme.background || faded >> 24 != 255 { return 22 }
    t.*.onlyOff = false
    // A busy bar asks for frames, a progress bar does not; half of it is
    // filled.
    t.*.busyOn = false
    frame(t, false)
    if t.*.again { return 23 }
    if pixelAt(t, 60, 254) != t.*.theme.accent || pixelAt(t, 180, 254) != t.*.theme.track { return 24 }
    t.*.busyOn = true
    frame(t, false)
    if !t.*.again || kit.frameDelay(k) == 0 || kit.frameDelay(k) > 40 { return 25 }
    t.*.busyOn = false
    return 0
}

// The drawing set, pixel by pixel, on the canvas cleared to black.
fn checkDrawing(t: *T) -> u8 {
    const canvas = &t.*.canvas
    const black: u32 = 0xFF000000
    const white: u32 = 0xFFFFFFFF
    canvas_module.clear(canvas, black)
    kit.hline(canvas, 10, 10, 5, white)
    if pixelAt(t, 9, 10) != black || pixelAt(t, 10, 10) != white || pixelAt(t, 14, 10) != white || pixelAt(t, 15, 10) != black || pixelAt(t, 12, 11) != black { return 1 }
    kit.vline(canvas, 10, 20, 5, white)
    if pixelAt(t, 10, 19) != black || pixelAt(t, 10, 20) != white || pixelAt(t, 10, 24) != white || pixelAt(t, 10, 25) != black || pixelAt(t, 11, 22) != black { return 2 }
    kit.frame(canvas, ui.rect(20, 20, 10, 6), white)
    if pixelAt(t, 20, 20) != white || pixelAt(t, 29, 25) != white || pixelAt(t, 20, 25) != white || pixelAt(t, 29, 20) != white || pixelAt(t, 25, 23) != black || pixelAt(t, 30, 22) != black || pixelAt(t, 24, 26) != black { return 3 }
    kit.checker(canvas, ui.rect(40, 40, 8, 8), 4)
    if pixelAt(t, 40, 40) != 0xFFD2D2D2 || pixelAt(t, 44, 40) != 0xFF9A9A9A || pixelAt(t, 40, 44) != 0xFF9A9A9A || pixelAt(t, 47, 47) != 0xFFD2D2D2 || pixelAt(t, 48, 44) != black { return 4 }
    // A straight colour is laid over what is there.
    kit.fillStraight(canvas, ui.rect(60, 60, 4, 4), 0x80FF0000)
    if pixelAt(t, 60, 60) != 0xFF800000 || pixelAt(t, 64, 60) != black { return 5 }
    // A line of one pixel along pixel centres is crisp, with its ends
    // where it ends; between two rows it is half on each.
    kit.line(canvas, 10.5, 100.5, 30.5, 100.5, white, 1.0)
    if pixelAt(t, 10, 100) != white || pixelAt(t, 20, 100) != white || pixelAt(t, 30, 100) != white { return 6 }
    if pixelAt(t, 20, 99) != black || pixelAt(t, 20, 101) != black || pixelAt(t, 9, 100) != black || pixelAt(t, 31, 100) != black { return 7 }
    kit.line(canvas, 10.5, 110.0, 30.5, 110.0, white, 1.0)
    const upper = pixelAt(t, 20, 109) & 255
    const lower = pixelAt(t, 20, 110) & 255
    if upper < 120 || upper > 136 || lower != upper || pixelAt(t, 20, 108) != black || pixelAt(t, 20, 111) != black { return 8 }
    // A slanted one: full on its middle, fading beside it, nothing two
    // pixels away.
    kit.line(canvas, 10.5, 120.5, 30.5, 140.5, white, 1.0)
    const beside = pixelAt(t, 20, 131) & 255
    if pixelAt(t, 20, 130) != white || beside < 40 || beside > 110 || pixelAt(t, 20, 133) != black || pixelAt(t, 22, 130) != black { return 9 }
    // A thick one, and a steep one.
    kit.line(canvas, 10.5, 160.5, 30.5, 160.5, white, 5.0)
    if pixelAt(t, 20, 158) != white || pixelAt(t, 20, 162) != white || pixelAt(t, 20, 157) != black || pixelAt(t, 20, 163) != black { return 10 }
    kit.line(canvas, 50.5, 100.5, 50.5, 140.5, white, 1.0)
    if pixelAt(t, 50, 120) != white || pixelAt(t, 49, 120) != black || pixelAt(t, 51, 120) != black || pixelAt(t, 50, 141) != black { return 11 }
    // Only what is on the canvas is drawn, wherever the line goes; what
    // is no place is no line; and a canvas of no pixels is not written.
    kit.line(canvas, -500.5, -500.5, 2000.5, 2000.5, white, 1.0)
    if pixelAt(t, 5, 5) != white || pixelAt(t, 699, 699) != white { return 12 }
    keep(t)
    kit.line(canvas, 0.0 / zero(), 5.0, 50.0, 50.0, white, 1.0)
    kit.line(canvas, 1.0e30, 5.0, 50.0, 50.0, white, 1.0)
    if differing(t, ui.rect(0, 0, 0, 0), false) != 0 { return 13 }
    var nowhere = view.layoutCanvas()
    kit.line(&nowhere, 0.5, 0.5, 20.5, 20.5, white, 3.0)
    kit.checker(&nowhere, ui.rect(0, 0, 40, 40), 4)
    kit.fillStraight(&nowhere, ui.rect(0, 0, 40, 40), 0x80FF0000)
    // A label cut to a width ends in an ellipsis and fits.
    if t.*.fonts {
        var room: [kit.TEXT_ROOM]u8 = undefined
        const long = "A label that is too long for its place"
        const cut = kit.ellipsized(&t.*.small, long, 90, &room)
        if cut.length >= long.length || cut.length < 6 || cut[cut.length - 3] != 0xE2 || cut[cut.length - 1] != 0xA6 { return 14 }
        if text_module.measure(&t.*.small, cut) > 90 { return 15 }
        if kit.ellipsized(&t.*.small, "Fits", 200, &room).length != 4 || kit.ellipsized(&t.*.small, long, 2, &room).length != 0 { return 16 }
    }
    return 0
}

fn zero() -> f64 { return 0.0 }

fn checkTooltip(t: *T) -> u8 {
    reset(t, SCENE_BASIC)
    const ground = t.*.theme.background
    motion(t, 264, 74)
    if pixelAt(t, 256, 102) != ground || !t.*.again { return 1 }
    t.*.time += 300
    frame(t, false)
    if pixelAt(t, 256, 102) != ground || !t.*.again || kit.frameDelay(t.*.kit) != 300 { return 2 }
    t.*.time += 290
    frame(t, false)
    if pixelAt(t, 256, 102) != ground { return 3 }
    t.*.time += 20
    frame(t, false)
    if pixelAt(t, 256, 102) == ground { return 4 }
    // Gone when the pointer leaves, and the wait starts again.
    motion(t, 600, 600)
    if pixelAt(t, 256, 102) != ground { return 5 }
    motion(t, 264, 74)
    t.*.time += 400
    frame(t, false)
    if pixelAt(t, 256, 102) != ground { return 6 }
    // In the window's corner it goes over its button and to the left, and
    // stays inside the window (its shadow too).
    t.*.onlyOff = false
    t.*.busyOn = false
    reset(t, SCENE_MORE)
    motion(t, 882, 682)
    t.*.time += 700
    frame(t, false)
    if t.*.fonts && (pixelAt(t, 875, 650) == ground || pixelAt(t, 899, 650) != ground || pixelAt(t, 875, 667) != ground) { return 7 }
    return 0
}

fn checkClip(t: *T) -> u8 {
    const k = t.*.kit
    reset(t, SCENE_CLIP)
    t.*.clipButton = false
    t.*.nested = false
    frame(t, false)
    keep(t)
    // A button half outside the clip: nothing outside changes.
    t.*.clipButton = true
    frame(t, false)
    const clip = ui.rect(100, 100, 100, 50)
    if differing(t, clip, false) != 0 { return 1 }
    if differing(t, clip, true) < 500 { return 2 }
    if pixelAt(t, 160, 125) == t.*.theme.background || pixelAt(t, 205, 125) != t.*.theme.background { return 3 }
    // Its region is cut too.
    const area = view.areaOf(&t.*.ui, ID_CLIPPED)
    if area.x != 150 || area.y != 110 || area.width != 50 || area.height != 30 { return 4 }
    // Clips nest: only what is in both shows.
    t.*.clipButton = false
    t.*.nested = true
    frame(t, false)
    if differing(t, ui.rect(450, 150, 50, 100), false) != 0 { return 5 }
    if pixelAt(t, 450, 150) != 0xFFFF0000 || pixelAt(t, 499, 249) != 0xFFFF0000 || differing(t, ui.rect(450, 150, 50, 100), true) != 5000 { return 6 }
    // The canvas is the window's again.
    if @intFromPtr(kit.canvasOf(k)) != @intFromPtr(&t.*.canvas) { return 7 }
    // A disabled widget names no region and is drawn fainter.
    t.*.nested = false
    return 0
}

fn checkScroll(t: *T) -> u8 {
    reset(t, SCENE_SCROLL)
    t.*.offset = 0
    t.*.inner = 50.0
    frame(t, false)
    if t.*.contentY != 300 { return 1 }
    // The wheel scrolls, 48 pixels a notch, and the content moves up.
    motion(t, 600, 380)
    wheel(t, 1)
    frame(t, false)
    if t.*.offset != 48 || t.*.contentY != 252 { return 2 }
    // A row scrolled half out at the top is cut there.
    if pixelAt(t, 520, 299) != t.*.theme.background || pixelAt(t, 520, 300) == t.*.theme.background { return 3 }
    // The offset stays within the content (300 tall in a view of 100).
    wheel(t, 10)
    frame(t, false)
    if t.*.offset != 200 { return 4 }
    wheel(t, -10)
    frame(t, false)
    if t.*.offset != 0 { return 5 }
    t.*.offset = 999
    frame(t, false)
    if t.*.offset != 200 { return 6 }
    t.*.offset = 0
    frame(t, false)
    // Over a slider in it the wheel is the slider's.
    motion(t, 560, 316)
    wheel(t, -1)
    frame(t, false)
    if t.*.inner != 51.0 || t.*.offset != 0 { return 7 }
    // The bar's thumb dragged down scrolls.
    motion(t, 696, 310)
    press(t)
    motion(t, 696, 350)
    release(t)
    if t.*.offset <= 60 || t.*.offset > 200 { return 8 }
    return 0
}

fn checkGrid(t: *T) -> u8 {
    reset(t, SCENE_GRID)
    t.*.gridOffset = 0
    t.*.gridClicked = kit.NOTHING
    frame(t, false)
    // Five columns of 40 in 200; three rows in view of two hundred: 15
    // cells are regions, and the scroll bar.
    if t.*.regions != 16 { return 1 }
    click(t, 120, 460)
    if t.*.gridClicked != 7 { return 2 }
    motion(t, 120, 460)
    wheel(t, 1)
    frame(t, false)
    if t.*.gridOffset != 48 || t.*.regions != 16 { return 3 }
    // The same place is now another cell (a row and 8 pixels further).
    t.*.gridClicked = kit.NOTHING
    click(t, 120, 460)
    if t.*.gridClicked != 12 { return 4 }
    // A layout pass names the same regions.
    frame(t, true)
    if t.*.regions != 16 { return 5 }
    return 0
}

fn checkCurve(t: *T) -> u8 {
    reset(t, SCENE_CURVE)
    t.*.xs[0] = 0.0
    t.*.ys[0] = 0.0
    t.*.xs[1] = 1.0
    t.*.ys[1] = 1.0
    t.*.points = 2
    t.*.curveChanges = 0
    t.*.curveReleased = 0
    frame(t, false)
    // A press beside the curve does nothing.
    click(t, 150, 150)
    if t.*.points != 2 || t.*.curveChanges != 0 { return 1 }
    // A press on the curve (the diagonal's middle) adds a point there.
    motion(t, 205, 206)
    press(t)
    if t.*.points != 3 || t.*.curveChanges != 1 { return 2 }
    if !near(@floatCast(f64, t.*.xs[1]), 0.5) || !near(@floatCast(f64, t.*.ys[1]), 0.5) { return 3 }
    // Dragged up it moves; its x stays left of the last point's.
    motion(t, 205, 150)
    if !near(@floatCast(f64, t.*.ys[1]), 0.779) || !near(@floatCast(f64, t.*.xs[1]), 0.5) { return 4 }
    motion(t, 330, 150)
    if t.*.xs[1] >= t.*.xs[2] || t.*.xs[1] < 0.99 { return 5 }
    motion(t, 205, 150)
    release(t)
    if t.*.points != 3 || t.*.curveReleased != 1 { return 6 }
    // The curve runs through it: drawn there in the text colour.
    if kit_curve.value(&t.*.xs, &t.*.ys, 3, 0.5) < 0.7 { return 7 }
    // Taken again and dragged far out it is removed.
    press(t)
    motion(t, 205, 80)
    if t.*.points != 3 || t.*.ys[1] != 1.0 { return 8 }
    motion(t, 205, 20)
    if t.*.points != 2 || t.*.xs[1] != 1.0 { return 9 }
    release(t)
    // The first point moves but is never removed.
    motion(t, 106, 305)
    press(t)
    motion(t, 106, 250)
    if !near(@floatCast(f64, t.*.ys[0]), 0.276) || t.*.xs[0] != 0.0 { return 10 }
    motion(t, 106, 690)
    if t.*.points != 2 || t.*.ys[0] != 0.0 { return 11 }
    release(t)
    // No more points than its capacity (8).
    var added: i32 = 0
    while added < 10 {
        t.*.time += 1000
        const x = 126 + added * 18
        const y = @intFromFloat(i32, 305.5 - kit_curve.value(&t.*.xs, &t.*.ys, t.*.points, (float(x) - 106.0) / 199.0) * 199.0)
        click(t, x, y)
        added += 1
    }
    if t.*.points != 8 { return 12 }
    return 0
}

// The gallery: its pictures, a layout pass, every pixel opaque.
fn checkGallery(t: *T, allocator: std.allocator.Allocator, shots: []const u8) -> u8 {
    const k = t.*.kit
    var round: usize = 0
    while round < 2 {
        t.*.light = round == 1
        t.*.theme = theme_module.scaled(if t.*.light { theme_module.light() } else { theme_module.dark() }, 1)
        reset(t, SCENE_GALLERY)
        // The pointer rests on a tool; a slider's number is open.
        motion(t, 642, 90)
        kit.focus(k, 1062)
        frame(t, false)
        t.*.time += 700
        frame(t, false)
        if !kit.editing(k, 1062) { return 1 }
        if !save(t, allocator, shots, if t.*.light { "kit-light.png" } else { "kit-dark.png" }) { return 2 }
        // Every pixel is opaque: nothing of the desktop shows through.
        var index: usize = 0
        while index < WIDTH * HEIGHT {
            if t.*.pixels[index] >> 24 != 255 { return 3 }
            index += 1
        }
        // A layout pass names the same regions and writes no pixel.
        const named = t.*.regions
        keep(t)
        frame(t, true)
        if t.*.regions != named || named < 80 || differing(t, ui.rect(0, 0, 0, 0), false) != 0 { return 4 }
        // The same with the list of blend modes open.
        _ = kit.key(k, keys.ESCAPE, 0, "")
        click(t, 780, 236)
        if !kit.wantsKeys(k) { return 5 }
        _ = key(t, keys.DOWN, "")
        motion(t, 760, 330)
        if !save(t, allocator, shots, if t.*.light { "kit-light-list.png" } else { "kit-dark-list.png" }) { return 6 }
        const open = t.*.regions
        frame(t, true)
        if t.*.regions != open || open <= named { return 7 }
        // Up from the item under a heading and a line goes past both.
        _ = key(t, keys.UP, "")
        _ = key(t, keys.UP, "")
        _ = key(t, keys.ENTER, "")
        frame(t, false)
        if t.*.blend != 1 || kit.wantsKeys(k) { return 8 }
        t.*.blend = 4
        kit.dismiss(k)
        frame(t, false)
        round += 1
    }
    return 0
}

// Writes the canvas as a picture into the current directory and into
// `shots` when that is one.
fn save(t: *T, allocator: std.allocator.Allocator, shots: []const u8, name: []const u8) -> bool {
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, name)
    bytes[length] = 0
    if !png.saveFile(bytes, t.*.pixels, WIDTH, HEIGHT, WIDTH, true, allocator) { return false }
    if shots.length == 0 || shots.length > 400 { return true }
    length = std.text.append(bytes, 0, 599, shots)
    if bytes[length - 1] != '/' { length = std.text.appendByte(bytes, length, 599, '/') }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    return png.saveFile(bytes, t.*.pixels, WIDTH, HEIGHT, WIDTH, true, allocator)
}

// Frames of the gallery one after another, the value arena given back
// before each as a window's loop does: a frame takes what the one before
// took (std.ui's text takes some for every line it draws), and far less
// than a canvas of pixels would.
fn checkArena(t: *T) -> u8 {
    reset(t, SCENE_GALLERY)
    motion(t, 642, 90)
    var loop: turns.Turns = undefined
    turns.begin(&loop, true, false)
    const arena = loop.base
    const mark = turns.used(arena)
    var first: usize = 0
    var last: usize = 0
    var round: usize = 0
    while round < 300 {
        turns.turn(&loop)
        t.*.time += 16
        frame(t, false)
        last = turns.used(arena) - mark
        if round == 1 { first = last }
        if last > 2097152 { return 1 }
        round += 1
    }
    const off = if last > first { last - first } else { first - last }
    if off > 65536 { return 2 }
    turns.turn(&loop)
    if turns.used(arena) != mark { return 3 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    var shots: []const u8 = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { shots = std.string.asSlice(named.?) }

    var failed = checkNumbers()
    if failed != 0 { return failed }
    failed = checkCurveMath()
    if failed != 0 { return 13 + failed }

    const memory = allocator.alloc(@sizeOf(T), 16)
    const pixels = allocator.alloc(WIDTH * HEIGHT * 4, 16)
    const copy = allocator.alloc(WIDTH * HEIGHT * 4, 16)
    if memory == null || pixels == null || copy == null { return 24 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    unsafe {
        t.*.pixels = @ptrCast([*]u32, pixels.?)
        t.*.copy = @ptrCast([*]u32, copy.?)
    }
    t.*.canvas = Canvas.{ .pixels = t.*.pixels, .width = WIDTH, .height = HEIGHT, .stride = WIDTH, .swapRedBlue = false, .device = 0, .opacity = 255 }
    // Without fonts no text is drawn; everything else is checked all the
    // same.
    t.*.fonts = text_module.loadText(&t.*.body, 13, allocator)
    _ = text_module.loadText(&t.*.small, 12, allocator)
    _ = text_module.loadMonoText(&t.*.mono, 12, allocator)
    t.*.theme = theme_module.scaled(theme_module.dark(), 1)
    view.init(&t.*.ui, &t.*.theme, &t.*.body, &t.*.small, &t.*.mono)
    t.*.time = 1000000
    t.*.light = false
    t.*.german = false
    t.*.optionsA = kit.sliderOptions(0.0, 100.0, 1.0, 0)
    t.*.optionsA.suffix = " %"
    t.*.optionsB = kit.sliderOptions(1.0, 1000.0, 1.0, 0)
    t.*.optionsB.exponent = 3.0
    t.*.optionsB.suffix = " px"
    t.*.optionsSpin = kit.sliderOptions(-50.0, 50.0, 1.0, 0)
    t.*.a = 50.0
    t.*.b = 40.0
    t.*.spin = 5.0
    t.*.whole = 3
    t.*.gridClicked = kit.NOTHING
    // The gallery's values.
    t.*.options[0] = t.*.optionsB
    t.*.options[1] = kit.sliderOptions(-180.0, 180.0, 0.5, 1)
    t.*.options[1].suffix = "°"
    t.*.options[2] = t.*.optionsA
    t.*.options[3] = kit.sliderOptions(0.0, 9999.0, 1.0, 0)
    var index: usize = 0
    while index < 64 {
        t.*.values[index] = if index >= 28 && index < 32 { 12.5 } else { 40.0 }
        t.*.flags[index] = index % 2 == 0
        index += 1
    }
    t.*.values[48] = 180.0
    t.*.values[49] = 75.0
    t.*.values[50] = -22.5
    t.*.values[51] = 4.5
    index = 0
    while index < 4 {
        t.*.textLengths[index] = if index == 2 { 0 } else { std.text.append(&t.*.texts[index], 0, 32, "Layer 1") }
        t.*.folded[index] = index != 1
        index += 1
    }
    index = 0
    while index < 8 {
        t.*.choices[index] = index % 6
        t.*.open[index] = true
        index += 1
    }
    t.*.long = 0
    t.*.longChanges = 0
    index = 0
    while index < LONG {
        const at = std.text.append(&t.*.longNames, index * 8, 560, "Brush ")
        t.*.longNames[at] = @intCast(u8, 48 + index / 10)
        t.*.longNames[at + 1] = @intCast(u8, 48 + index % 10)
        index += 1
    }
    t.*.tool = 0
    t.*.blend = 4
    t.*.palette = 3
    t.*.layer = 1
    t.*.gxs[0] = 0.0
    t.*.gys[0] = 0.0
    t.*.gxs[1] = 0.35
    t.*.gys[1] = 0.15
    t.*.gxs[2] = 0.7
    t.*.gys[2] = 0.85
    t.*.gxs[3] = 1.0
    t.*.gys[3] = 1.0
    t.*.gpoints = 4

    const made = kit.create(allocator)
    if made == null { return 25 }
    t.*.kit = made.?

    failed = checkSlider(t)
    if failed != 0 { return 30 + failed }
    failed = checkBoxes(t)
    if failed != 0 { return 70 + failed }
    failed = checkList(t)
    if failed != 0 { return 100 + failed }
    failed = checkTooltip(t)
    if failed != 0 { return 130 + failed }
    failed = checkMore(t)
    if failed != 0 { return 210 + failed }
    failed = checkDrawing(t)
    if failed != 0 { return 236 + failed }
    failed = checkClip(t)
    if failed != 0 { return 140 + failed }
    failed = checkScroll(t)
    if failed != 0 { return 150 + failed }
    failed = checkGrid(t)
    if failed != 0 { return 160 + failed }
    failed = checkCurve(t)
    if failed != 0 { return 170 + failed }
    failed = checkGallery(t, allocator, shots)
    if failed != 0 { return 190 + failed }
    failed = checkArena(t)
    if failed != 0 { return 200 + failed }

    // Everything a kit took is given back. (A second kit, for which
    // std.ui's text has every glyph already: the heap is then the kit's
    // alone to change. It has an edit and a list open and two layers.)
    kit.destroy(t.*.kit)
    const live = std.heap.liveBytes()
    const second = kit.create(allocator)
    if second == null { return 253 }
    t.*.kit = second.?
    t.*.theme = theme_module.scaled(theme_module.dark(), 1)
    t.*.light = false
    t.*.nested = true
    reset(t, SCENE_CLIP)
    reset(t, SCENE_GALLERY)
    kit.focus(t.*.kit, 1062)
    frame(t, false)
    click(t, 780, 236)
    if !kit.wantsKeys(t.*.kit) || std.heap.liveBytes() < live + WIDTH * HEIGHT * 8 { return 254 }
    kit.destroy(t.*.kit)
    if std.heap.liveBytes() != live { return 255 }
    return 13
}
