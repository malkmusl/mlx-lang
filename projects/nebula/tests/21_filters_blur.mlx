// bench (temporary)
const std = @import("std")
const crash = @import("std.crash")
const filters = @import("../filters/registry.mlx")

fn run(name: []const u8, params: *const filters.Params, pixels: [*]u32, width: usize, height: usize) -> void {
    const start = std.time.monotonicNanoseconds()
    _ = filters.apply(params, pixels, width, height, width)
    const took = std.time.monotonicNanoseconds() - start
    _ = std.io.print(name)
    _ = std.io.print(": ")
    _ = std.io.writeUnsigned(std.io.stdout(), width * height * 10 / (took / 1000 + 1))
    _ = std.io.println(" MP/s x 10")
}

fn show(pixels: [*]const u32, width: usize, height: usize) -> void {
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            _ = std.io.writeHex(std.io.stdout(), @intCast(usize, pixels[y * width + x]))
            _ = std.io.print(" ")
            x += 1
        }
        _ = std.io.println("")
        y += 1
    }
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const width: usize = 2048
    const height: usize = 1024
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, allocator.alloc(width * height * 4, 16).?) }
    var params: filters.Params = undefined
    var id: u16 = 150
    while id < 155 {
        var index: usize = 0
        while index < 25 {
            pixels[index] = 0xFF643264
            index += 1
        }
        pixels[12] = 0xFF8232BE
        filters.defaults(id, &params)
        if id == 153 { params.values[0] = 40.0 }
        if id == 154 { params.values[0] = 40.0 }
        _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, filters.margin(&params)))
        _ = std.io.println(" margin")
        if !filters.apply(&params, pixels, 5, 5, 5) { return 1 }
        show(pixels, 5, 5)
        id += 1
    }
    var seed: u32 = 12345
    var index: usize = 0
    while index < width * height {
        seed = seed *% 1664525 +% 1013904223
        pixels[index] = seed | 0xFF000000
        if index % 7 == 0 { pixels[index] = seed }
        index += 1
    }
    filters.defaults(100, &params)
    run("gaussian 5", &params, pixels, width, height)
    params.values[0] = 50.0
    params.values[1] = 50.0
    run("gaussian 50", &params, pixels, width, height)
    filters.defaults(150, &params)
    run("sharpen", &params, pixels, width, height)
    filters.defaults(151, &params)
    run("mean removal", &params, pixels, width, height)
    filters.defaults(152, &params)
    run("unsharp light", &params, pixels, width, height)
    params.values[3] = 0.0
    run("unsharp all", &params, pixels, width, height)
    filters.defaults(153, &params)
    run("reducer", &params, pixels, width, height)
    filters.defaults(154, &params)
    run("wavelet", &params, pixels, width, height)
    return 13
}
