// bench (temporary)
const std = @import("std")
const crash = @import("std.crash")
const filters = @import("../filters/registry.mlx")
const blur = @import("../filters/blur.mlx")

fn run(name: []const u8, params: *const filters.Params, pixels: [*]u32, width: usize, height: usize) -> void {
    const start = std.time.monotonicNanoseconds()
    _ = filters.apply(params, pixels, width, height, width)
    const took = std.time.monotonicNanoseconds() - start
    _ = std.io.print(name)
    _ = std.io.print(": ")
    _ = std.io.writeUnsigned(std.io.stdout(), width * height * 10 / (took / 1000 + 1))
    _ = std.io.print(" MP/s x 10, changes ")
    _ = std.io.writeUnsigned(std.io.stdout(), blur.debugCount)
    _ = std.io.println(if blur.debugLanes { " lanes" } else { " wide" })
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const width: usize = 2048
    const height: usize = 1024
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, allocator.alloc(width * height * 4, 16).?) }
    var seed: u32 = 12345
    var index: usize = 0
    while index < width * height {
        seed = seed *% 1664525 +% 1013904223
        pixels[index] = seed | 0xFF000000
        if index % 7 == 0 { pixels[index] = seed }
        index += 1
    }
    var params: filters.Params = undefined
    filters.defaults(100, &params)
    run("gaussian 5", &params, pixels, width, height)
    params.values[0] = 50.0
    params.values[1] = 50.0
    run("gaussian 50", &params, pixels, width, height)
    params.values[0] = 1000.0
    params.values[1] = 1000.0
    run("gaussian 1000", &params, pixels, width, height)
    filters.defaults(101, &params)
    run("blur circle 5", &params, pixels, width, height)
    params.values[4] = 1.0
    run("blur rect 5", &params, pixels, width, height)
    params.values[2] = 100.0
    run("blur rect 5 falling", &params, pixels, width, height)
    params.values[0] = 20.0
    params.values[1] = 20.0
    params.values[4] = 0.0
    params.values[2] = 0.0
    run("blur circle 20", &params, pixels, width, height)
    filters.defaults(102, &params)
    run("motion 5 at 0", &params, pixels, width, height)
    params.values[0] = 30.0
    params.values[1] = 20.0
    run("motion 20 at 30", &params, pixels, width, height)
    filters.defaults(103, &params)
    run("lens 5", &params, pixels, width, height)
    params.values[0] = 20.0
    run("lens 20", &params, pixels, width, height)
    params.values[0] = 100.0
    params.values[1] = 6.0
    run("lens 100 round", &params, pixels, width, height)
    return 13
}
