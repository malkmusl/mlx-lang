// nebula's Blur and Enhance filters (filters/blur.mlx, filters/enhance.mlx)
// through the registry: each is listed with a number and a key of its own
// and numbers that start inside their ranges; a flat picture, a
// transparent one and an opaque one stay what they are at every size
// (1 x 1, a row, a column, 257 x 130) and at the ends of every number's
// range; NaN counts as the initial value and a number out of range as the
// nearest end; neutral numbers change no bit; hand-computed pixels (the
// 3 x 3 kernels on 5 x 5, a box and a gaussian of a single bright pixel,
// motion, lens, unsharp, the noise reducers); a transparent neighbour's
// colour does not bleed; a picture filtered whole is the picture filtered
// in 256-pixel blocks with margin() around each, to the bit; a stride
// wider than the picture; twice the same; scratch given back and no value
// arena used. Prints megapixels a second. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const scratch = @import("../core/scratch.mlx")
const types = @import("../filters/types.mlx")
const filters = @import("../filters/registry.mlx")
const blur = @import("../filters/blur.mlx")
const enhance = @import("../filters/enhance.mlx")

const Params = filters.Params

const MINE_COUNT: usize = 9
const MINE = [9]u16{ blur.GAUSSIAN_BLUR, blur.BLUR, blur.MOTION_BLUR, blur.LENS_BLUR, enhance.SHARPEN, enhance.MEAN_REMOVAL, enhance.UNSHARP_MASK, enhance.GAUSSIAN_NOISE_REDUCTION, enhance.WAVELET_NOISE_REDUCTION }

// Three buffers of SPACE pixels each, made in main.
const SPACE: usize = 1048576
var first: [*]u32 = undefined
var second: [*]u32 = undefined
var third: [*]u32 = undefined

const BLACK: u32 = 0xFF000000
const RED: u32 = 0xFFFF0000

fn next(seed: *u32) -> u32 {
    seed.* = seed.* *% 1664525 +% 1013904223
    // The low bits of such a generator repeat soon: mix the high ones in.
    return seed.* ^ (seed.* >> 15)
}

fn fill(into: [*]u32, count: usize, pixel: u32) -> void {
    var index: usize = 0
    while index < count {
        into[index] = pixel
        index += 1
    }
}

fn copy(into: [*]u32, from: [*]const u32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        into[index] = from[index]
        index += 1
    }
}

fn same(a: [*]const u32, b: [*]const u32, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// Grain: every pixel by chance, opaque or of any alpha (a seventh of
// them wholly transparent with a colour all the same).
fn grain(into: [*]u32, count: usize, opaque: bool, start: u32) -> void {
    var seed = start
    var index: usize = 0
    while index < count {
        var pixel = next(&seed)
        if opaque {
            pixel |= 0xFF000000
        } else if pixel % 7 == 0 {
            pixel &= 0x00FFFFFF
        }
        into[index] = pixel
        index += 1
    }
}

// A picture with everything in it: slopes with grain on them, opaque
// parts, parts of chance alpha, of sloping alpha, and holes whose
// transparent pixels keep a colour.
fn picture(into: [*]u32, width: usize, height: usize, start: u32) -> void {
    var seed = start
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            const chance = next(&seed)
            const part = (x / 37 + y / 29) % 4
            var a: u32 = 255
            if part == 1 {
                a = 0
            } else if part == 2 {
                a = chance >> 24
            } else if part == 3 {
                a = 128 + @intCast(u32, (x * 3 + y) & 127)
            }
            const r = @intCast(u32, (x * 5) & 255) ^ (chance & 31)
            const g = @intCast(u32, (y * 3) & 255) ^ ((chance >> 8) & 63)
            const b = (chance >> 16) & 255
            into[y * width + x] = (a << 24) | (r << 16) | (g << 8) | b
            x += 1
        }
        y += 1
    }
}

fn apply(params: *const Params, pixels: [*]u32, width: usize, height: usize) -> bool {
    return filters.apply(params, pixels, width, height, width)
}

// ---------------------------------------------------------------------

fn key(id: u16) -> []const u8 {
    if id == blur.GAUSSIAN_BLUR { return "gaussian blur" }
    if id == blur.BLUR { return "blur" }
    if id == blur.MOTION_BLUR { return "motion blur" }
    if id == blur.LENS_BLUR { return "lens blur" }
    if id == enhance.SHARPEN { return "sharpen" }
    if id == enhance.MEAN_REMOVAL { return "mean removal" }
    if id == enhance.UNSHARP_MASK { return "unsharp" }
    if id == enhance.GAUSSIAN_NOISE_REDUCTION { return "gaussiannoisereducer" }
    return "waveletnoisereducer"
}

fn bars(text: []const u8) -> usize {
    var count: usize = 0
    for byte in text {
        if byte == '|' { count += 1 }
    }
    return count
}

// Each filter is in the registry, once, described in full.
fn listed() -> u8 {
    if blur.GAUSSIAN_BLUR != 100 || blur.LENS_BLUR != 103 || enhance.SHARPEN != 150 || enhance.WAVELET_NOISE_REDUCTION != 154 { return 1 }
    var params: Params = undefined
    var mine: usize = 0
    while mine < MINE_COUNT {
        const id = MINE[mine]
        const found = filters.find(id)
        if found == null { return 2 }
        const info = found.?
        if info.*.id != id { return 3 }
        const group: u8 = if id < 150 { types.BLUR } else { types.ENHANCE }
        if info.*.category != group { return 4 }
        if !std.text.same(info.*.key, key(id)) || info.*.name.length == 0 || info.*.german.length == 0 { return 5 }
        const named = filters.byKey(info.*.key)
        if named == null || named.?.*.id != id { return 6 }
        if info.*.margin == null { return 7 }
        // No other filter has the number or the key.
        var times: usize = 0
        var index: usize = 0
        const all = filters.count()
        while index < all {
            const other = filters.at(index).?
            if other.*.id == id || std.text.same(other.*.key, info.*.key) { times += 1 }
            index += 1
        }
        if times != 1 { return 8 }
        filters.defaults(id, &params)
        if params.id != id { return 9 }
        index = 0
        while index < info.*.params.length {
            const param = &info.*.params[index]
            if param.*.name.length == 0 || param.*.german.length == 0 { return 10 }
            if !(param.*.low <= param.*.initial) || !(param.*.initial <= param.*.high) { return 11 }
            if params.values[index] != param.*.initial { return 12 }
            if param.*.kind == types.CHOICE {
                // As many choices as the range has places, in both languages.
                if bars(param.*.choices) + 1 != @intFromFloat(usize, param.*.high) + 1 { return 14 }
                if bars(param.*.choicesGerman) != bars(param.*.choices) { return 15 }
            }
            index += 1
        }
        mine += 1
    }
    return 0
}

// ---------------------------------------------------------------------

// The `turn`-th way to put a filter's numbers at the ends of their
// ranges: every mix of ends for up to four numbers, else one number at
// an end and the others as they start. False: there is no such turn.
fn extreme(id: u16, turn: usize, params: *Params) -> bool {
    const info = filters.find(id).?
    const count = info.*.params.length
    filters.defaults(id, params)
    if count == 0 { return turn == 0 }
    if count <= 4 {
        if turn >= @intCast(usize, 1) << @intCast(u6, count) { return false }
        var index: usize = 0
        while index < count {
            params.*.values[index] = if (turn >> @intCast(u6, index)) & 1 == 1 { info.*.params[index].high } else { info.*.params[index].low }
            index += 1
        }
        return true
    }
    if turn >= 2 * count { return false }
    params.*.values[turn / 2] = if turn % 2 == 1 { info.*.params[turn / 2].high } else { info.*.params[turn / 2].low }
    return true
}

// What every filter here keeps at every setting, for one size.
fn keeps(params: *const Params, width: usize, height: usize) -> u8 {
    const count = width * height
    // Nothing stays nothing.
    fill(first, count, 0)
    if !apply(params, first, width, height) { return 20 }
    var index: usize = 0
    while index < count {
        if first[index] != 0 { return 21 }
        index += 1
    }
    // One colour all over stays that colour, opaque or not.
    fill(first, count, 0xFF4080C0)
    _ = apply(params, first, width, height)
    index = 0
    while index < count {
        if first[index] != 0xFF4080C0 { return 22 }
        index += 1
    }
    fill(first, count, 0x80C08040)
    _ = apply(params, first, width, height)
    index = 0
    while index < count {
        if first[index] != 0x80C08040 { return 23 }
        index += 1
    }
    // An opaque picture stays opaque.
    grain(first, count, true, 77)
    _ = apply(params, first, width, height)
    index = 0
    while index < count {
        if first[index] >> 24 != 255 { return 24 }
        index += 1
    }
    // Where a result has no alpha it has no colour either (unless the
    // setting does nothing at all).
    grain(first, count, false, 99)
    copy(second, first, count)
    _ = apply(params, first, width, height)
    if !same(first, second, count) {
        index = 0
        while index < count {
            if first[index] >> 24 == 0 && first[index] != 0 { return 25 }
            index += 1
        }
    }
    return 0
}

fn sizes() -> u8 {
    var params: Params = undefined
    var mine: usize = 0
    while mine < MINE_COUNT {
        var turn: usize = 0
        while extreme(MINE[mine], turn, &params) {
            var failed = keeps(&params, 1, 1)
            if failed == 0 { failed = keeps(&params, 1, 37) }
            if failed == 0 { failed = keeps(&params, 41, 1) }
            if failed == 0 { failed = keeps(&params, 257, 130) }
            if failed != 0 { return failed }
            turn += 1
        }
        mine += 1
    }
    return 0
}

// NaN is the initial value, a number beyond its range the range's end.
fn strays() -> u8 {
    const width: usize = 33
    const height: usize = 21
    const count = width * height
    var params: Params = undefined
    var mine: usize = 0
    while mine < MINE_COUNT {
        const id = MINE[mine]
        const info = filters.find(id).?
        var index: usize = 0
        while index < info.*.params.length {
            picture(first, width, height, 5)
            filters.defaults(id, &params)
            _ = apply(&params, first, width, height)
            picture(second, width, height, 5)
            params.values[index] = math.nan()
            _ = apply(&params, second, width, height)
            if !same(first, second, count) { return 30 }

            picture(first, width, height, 5)
            params.values[index] = info.*.params[index].high
            _ = apply(&params, first, width, height)
            picture(second, width, height, 5)
            params.values[index] = 1.0e300
            _ = apply(&params, second, width, height)
            if !same(first, second, count) { return 31 }
            if filters.margin(&params) < 0 { return 32 }
            picture(second, width, height, 5)
            params.values[index] = math.infinity()
            _ = apply(&params, second, width, height)
            if !same(first, second, count) { return 33 }

            picture(first, width, height, 5)
            params.values[index] = info.*.params[index].low
            _ = apply(&params, first, width, height)
            picture(second, width, height, 5)
            params.values[index] = -1.0e300
            _ = apply(&params, second, width, height)
            if !same(first, second, count) { return 34 }
            if filters.margin(&params) < 0 { return 35 }
            index += 1
        }
        mine += 1
    }
    return 0
}

// A setting that does nothing changes no bit (not even a transparent
// pixel's colour) and reads nothing around a pixel.
fn nothing(params: *const Params) -> bool {
    const width: usize = 45
    const height: usize = 28
    picture(first, width, height, 11)
    picture(second, width, height, 11)
    if !apply(params, first, width, height) { return false }
    return same(first, second, width * height) && filters.margin(params) == 0
}

fn neutral() -> u8 {
    var params: Params = undefined
    filters.defaults(blur.GAUSSIAN_BLUR, &params)
    params.values[0] = 0.0
    params.values[1] = 0.0
    if !nothing(&params) { return 40 }
    filters.defaults(blur.BLUR, &params)
    params.values[0] = 0.0
    params.values[1] = 0.0
    if !nothing(&params) { return 41 }
    params.values[2] = 70.0
    params.values[3] = 33.0
    params.values[4] = 1.0
    if !nothing(&params) { return 42 }
    filters.defaults(blur.MOTION_BLUR, &params)
    params.values[1] = 0.0
    if !nothing(&params) { return 43 }
    filters.defaults(blur.LENS_BLUR, &params)
    params.values[0] = 0.0
    if !nothing(&params) { return 44 }
    filters.defaults(enhance.UNSHARP_MASK, &params)
    params.values[0] = 0.0
    if !nothing(&params) { return 45 }
    filters.defaults(enhance.UNSHARP_MASK, &params)
    params.values[1] = 0.0
    if !nothing(&params) { return 46 }
    filters.defaults(enhance.GAUSSIAN_NOISE_REDUCTION, &params)
    params.values[0] = 0.0
    if !nothing(&params) { return 47 }
    filters.defaults(enhance.GAUSSIAN_NOISE_REDUCTION, &params)
    params.values[1] = 0.0
    if !nothing(&params) { return 48 }
    filters.defaults(enhance.WAVELET_NOISE_REDUCTION, &params)
    params.values[0] = 0.0
    if !nothing(&params) { return 49 }
    return 0
}

// ---------------------------------------------------------------------
// Pixels computed by hand

fn gray(value: u32) -> u32 {
    return 0xFF000000 | (value << 16) | (value << 8) | value
}

// The 3 x 3 kernels on 5 x 5: a pixel (130, 50, 190) in (100, 50, 100).
fn kernels() -> u8 {
    var params: Params = undefined
    fill(first, 25, 0xFF643264)
    first[12] = 0xFF8232BE
    filters.defaults(enhance.SHARPEN, &params)
    if filters.margin(&params) != 1 || !apply(&params, first, 5, 5) { return 50 }
    // Sharpen: (11 own - 2 (left + right + above + below)) / 3.
    // Middle: red (1430 - 800) / 3 = 210, blue (2090 - 800) / 3 = 430,
    // held at 255. Beside it: red (1100 - 2 (130 + 300)) / 3 = 80, blue
    // (1100 - 2 (190 + 300)) / 3 = 40. Green is 50 everywhere:
    // (550 - 400) / 3 = 50.
    var index: usize = 0
    while index < 25 {
        var expected: u32 = 0xFF643264
        if index == 12 { expected = 0xFFD232FF }
        if index == 7 || index == 11 || index == 13 || index == 17 { expected = 0xFF503228 }
        if first[index] != expected { return 51 }
        index += 1
    }
    // Mean Removal: 9 own - the eight around. Middle: red 1170 - 800 =
    // 370, held at 255, blue 1710 - 800 too. The eight around it: red
    // 900 - (130 + 700) = 70, blue 900 - (190 + 700) = 10.
    fill(first, 25, 0xFF643264)
    first[12] = 0xFF8232BE
    filters.defaults(enhance.MEAN_REMOVAL, &params)
    if filters.margin(&params) != 1 || !apply(&params, first, 5, 5) { return 52 }
    index = 0
    while index < 25 {
        const x = index % 5
        const y = index / 5
        var expected: u32 = 0xFF643264
        if x >= 1 && x <= 3 && y >= 1 && y <= 3 { expected = 0xFF46320A }
        if index == 12 { expected = 0xFFFF32FF }
        if first[index] != expected { return 53 }
        index += 1
    }
    // At a corner the pixels outside are the corner itself: a pixel of
    // 110 there, sharpened: (11 * 110 - 2 (110 + 110 + 100 + 100)) / 3 =
    // 123.3; right of it (1100 - 2 (110 + 300)) / 3 = 93.3.
    fill(first, 25, gray(100))
    first[0] = gray(110)
    filters.defaults(enhance.SHARPEN, &params)
    _ = apply(&params, first, 5, 5)
    if first[0] != gray(123) || first[1] != gray(93) || first[5] != gray(93) || first[6] != gray(100) { return 54 }
    return 0
}

// A box of one bright pixel: the same everywhere in the box, nothing
// outside, and as much light as before.
fn boxes() -> u8 {
    var params: Params = undefined
    fill(first, 49, BLACK)
    first[24] = 0xFFE10000
    filters.defaults(blur.BLUR, &params)
    params.values[0] = 1.0
    params.values[1] = 1.0
    params.values[4] = 1.0
    if filters.margin(&params) != 1 || !apply(&params, first, 7, 7) { return 60 }
    // 225 over 3 x 3 pixels: 25 each.
    var index: usize = 0
    while index < 49 {
        const x = index % 7
        const y = index / 7
        const inside = x >= 2 && x <= 4 && y >= 2 && y <= 4
        if first[index] != (if inside { 0xFF190000 } else { BLACK }) { return 61 }
        index += 1
    }
    // 255 over 5 x 3 pixels: 17 each; turned a quarter: 3 x 5.
    var quarter: usize = 0
    while quarter < 2 {
        fill(first, 81, BLACK)
        first[40] = 0xFF00FF00
        params.values[0] = 2.0
        params.values[1] = 1.0
        params.values[3] = if quarter == 1 { 90.0 } else { 0.0 }
        if filters.margin(&params) != 2 || !apply(&params, first, 9, 9) { return 62 }
        index = 0
        while index < 81 {
            const dx = if index % 9 > 4 { index % 9 - 4 } else { 4 - index % 9 }
            const dy = if index / 9 > 4 { index / 9 - 4 } else { 4 - index / 9 }
            const inside = if quarter == 1 { dx <= 1 && dy <= 2 } else { dx <= 2 && dy <= 1 }
            if first[index] != (if inside { 0xFF001100 } else { BLACK }) { return 63 }
            index += 1
        }
        quarter += 1
    }
    // Turned half round the box is itself: 255 over 9 x 3 pixels is 9.44
    // each, 9 after rounding, 243 of the light.
    fill(first, 121, BLACK)
    first[60] = 0xFF0000FF
    params.values[0] = 4.0
    params.values[1] = 1.0
    params.values[3] = 180.0
    _ = apply(&params, first, 11, 11)
    index = 0
    var light: u32 = 0
    while index < 121 {
        const dx = if index % 11 > 5 { index % 11 - 5 } else { 5 - index % 11 }
        const dy = if index / 11 > 5 { index / 11 - 5 } else { 5 - index / 11 }
        if first[index] != (if dx <= 4 && dy <= 1 { 0xFF000009 } else { BLACK }) { return 64 }
        light += first[index] & 255
        index += 1
    }
    if light != 243 { return 65 }
    return 0
}

fn difference(a: u32, b: u32) -> u32 {
    return if a > b { a - b } else { b - a }
}

// `bar` white pixels side by side (an odd number: one is a single bright
// pixel) through the gaussian along the rows only: the same to both
// sides, never rising outward, as much light as before to within a
// hundredth, and the rows above and below untouched.
fn bell(radius: f64, width: usize, bar: usize) -> u8 {
    var params: Params = undefined
    const middle = width / 2
    fill(first, width * 3, BLACK)
    fill(first + (width + middle - bar / 2), bar, 0xFFFFFFFF)
    filters.defaults(blur.GAUSSIAN_BLUR, &params)
    params.values[0] = radius
    params.values[1] = 0.0
    if !apply(&params, first, width, 3) { return 1 }
    const reach = @intCast(usize, filters.margin(&params))
    if reach == 0 || reach >= middle { return 2 }
    var light: u32 = 0
    var x: usize = 0
    while x < width {
        const pixel = first[width + x]
        if first[x] != BLACK || first[2 * width + x] != BLACK { return 3 }
        if pixel != gray(pixel & 255) { return 4 }
        light += pixel & 255
        const away = if x > middle { x - middle } else { middle - x }
        // Nothing beyond what margin() says.
        if away > reach + bar / 2 && pixel != BLACK { return 5 }
        if first[width + middle + away] != first[width + middle - away] { return 6 }
        if away > 0 && x > middle && pixel & 255 > first[width + x - 1] & 255 { return 7 }
        x += 1
    }
    if first[width + middle] & 255 == 0 || first[width + middle + 1] & 255 == 0 { return 8 }
    const whole = 255 * @intCast(u32, bar)
    if difference(light, whole) * 100 > whole { return 9 }
    return 0
}

fn gaussians() -> u8 {
    var params: Params = undefined
    // Weighed out pixel by pixel (deviation 1.2), and as three boxes
    // (deviations 4.5 and 12.3). The widest bell leaves less than 9 of
    // 255 of one bright pixel in any pixel, and seventy pixels each
    // rounded to a whole 255th do not add up to within a hundredth of
    // 255: nine bright pixels side by side do.
    var failed = bell(3.0, 41, 1)
    if failed != 0 { return 70 + failed }
    failed = bell(14.0, 101, 1)
    if failed != 0 { return 80 + failed }
    failed = bell(40.0, 301, 9)
    if failed != 0 { return 90 + failed }

    // Along both directions: the same in all eight directions' mirrors,
    // falling outward, the light kept as far as rounding each pixel to
    // 255ths allows (half a step a pixel).
    const size: usize = 41
    const middle: usize = 20
    fill(first, size * size, BLACK)
    first[middle * size + middle] = 0xFFFFFFFF
    filters.defaults(blur.GAUSSIAN_BLUR, &params)
    params.values[0] = 3.0
    params.values[1] = 3.0
    if !apply(&params, first, size, size) { return 100 }
    var light: u32 = 0
    var lit: u32 = 0
    var j: usize = 0
    while j <= middle {
        var i: usize = 0
        while i <= middle {
            const value = first[(middle + j) * size + middle + i]
            if first[(middle - j) * size + middle + i] != value || first[(middle + j) * size + middle - i] != value || first[(middle - j) * size + middle - i] != value { return 101 }
            if first[(middle + i) * size + middle + j] != value { return 102 }
            if i > 0 && value > first[(middle + j) * size + middle + i - 1] { return 103 }
            i += 1
        }
        j += 1
    }
    var index: usize = 0
    while index < size * size {
        light += first[index] & 255
        if first[index] & 255 != 0 { lit += 1 }
        index += 1
    }
    if difference(light, 255) * 2 > lit + 2 { return 104 }
    if first[middle * size + middle] & 255 < 20 { return 105 }

    // A radius of nothing leaves its direction alone: columns of two
    // colours blurred along the columns stay as they are, rows of two
    // colours blurred along the rows too.
    index = 0
    while index < size * size {
        first[index] = if (index % size) % 2 == 0 { 0xFF102030 } else { 0x80F0E0D0 }
        second[index] = if (index / size) % 2 == 0 { 0xFF102030 } else { 0x80F0E0D0 }
        index += 1
    }
    params.values[0] = 0.0
    params.values[1] = 9.0
    _ = apply(&params, first, size, size)
    params.values[0] = 30.0
    params.values[1] = 0.0
    _ = apply(&params, second, size, size)
    index = 0
    while index < size * size {
        if first[index] != (if (index % size) % 2 == 0 { 0xFF102030 } else { 0x80F0E0D0 }) { return 106 }
        if second[index] != (if (index / size) % 2 == 0 { 0xFF102030 } else { 0x80F0E0D0 }) { return 107 }
        index += 1
    }
    return 0
}

fn streaks() -> u8 {
    var params: Params = undefined
    // A line one pixel to each side: the ends count half. 200 becomes
    // 50, 100, 50 along the row; a quarter turned, along the column.
    var turned: usize = 0
    while turned < 2 {
        fill(first, 49, BLACK)
        first[24] = gray(200)
        filters.defaults(blur.MOTION_BLUR, &params)
        params.values[0] = if turned == 1 { 90.0 } else { 0.0 }
        params.values[1] = 1.0
        if filters.margin(&params) != 1 || !apply(&params, first, 7, 7) { return 110 }
        const step: usize = if turned == 1 { 7 } else { 1 }
        var index: usize = 0
        while index < 49 {
            var expected = BLACK
            if index == 24 { expected = gray(100) }
            if index == 24 - step || index == 24 + step { expected = gray(50) }
            if first[index] != expected { return 111 }
            index += 1
        }
        turned += 1
    }
    // At 45 degrees the line runs from below left to above right, the
    // same to both sides of the pixel, and not along the other diagonal.
    fill(first, 121, BLACK)
    first[60] = gray(255)
    params.values[0] = 45.0
    params.values[1] = 4.0
    if filters.margin(&params) != 3 || !apply(&params, first, 11, 11) { return 112 }
    if first[60 - 11 + 1] == BLACK || first[60 + 11 - 1] == BLACK || first[60 - 22 + 2] == BLACK { return 113 }
    if first[60 - 11 - 1] != BLACK || first[60 + 11 + 1] != BLACK { return 114 }
    var index: usize = 0
    var light: u32 = 0
    while index < 121 {
        if first[index] != first[120 - index] { return 115 }
        light += first[index] & 255
        index += 1
    }
    if difference(light, 255) > 6 { return 116 }
    return 0
}

fn irises() -> u8 {
    var params: Params = undefined
    const size: usize = 15
    const middle: usize = 7
    // A round iris: one white pixel becomes a disc, the same in every
    // mirror, flat inside, nothing beyond the radius.
    fill(first, size * size, BLACK)
    first[middle * size + middle] = gray(255)
    filters.defaults(blur.LENS_BLUR, &params)
    params.values[0] = 3.0
    params.values[1] = 6.0
    if filters.margin(&params) != 3 || !apply(&params, first, size, size) { return 120 }
    const inside = first[middle * size + middle]
    if inside == BLACK { return 121 }
    var light: u32 = 0
    var lit: u32 = 0
    var j: usize = 0
    while j <= middle {
        var i: usize = 0
        while i <= middle {
            const value = first[(middle + j) * size + middle + i]
            if first[(middle - j) * size + middle + i] != value || first[(middle + j) * size + middle - i] != value || first[(middle - j) * size + middle - i] != value { return 122 }
            if first[(middle + i) * size + middle + j] != value { return 123 }
            if i * i + j * j <= 4 && value != inside { return 124 }
            if (i > 3 || j > 3) && value != BLACK { return 125 }
            i += 1
        }
        j += 1
    }
    var index: usize = 0
    while index < size * size {
        light += first[index] & 255
        if first[index] != BLACK { lit += 1 }
        index += 1
    }
    if difference(light, 255) * 2 > lit + 2 { return 126 }
    // A triangle: the white pixel becomes the iris with its first corner
    // to the right; to the left it ends after half the radius.
    fill(first, size * size, BLACK)
    first[middle * size + middle] = gray(255)
    params.values[0] = 4.0
    params.values[1] = 0.0
    params.values[2] = 0.0
    if !apply(&params, first, size, size) { return 127 }
    if first[middle * size + middle + 4] == BLACK || first[middle * size + middle - 4] != BLACK || first[middle * size + middle - 3] != BLACK { return 128 }
    // Turned half round the corner points left.
    fill(first, size * size, BLACK)
    first[middle * size + middle] = gray(255)
    params.values[2] = 180.0
    _ = apply(&params, first, size, size)
    if first[middle * size + middle - 4] == BLACK || first[middle * size + middle + 4] != BLACK { return 129 }
    return 0
}

// An edge between two greys along a row of 40 x 9.
fn edge(into: [*]u32, left: u32, right: u32) -> void {
    var index: usize = 0
    while index < 360 {
        into[index] = if index % 40 < 20 { gray(left) } else { gray(right) }
        index += 1
    }
}

fn unsharps() -> u8 {
    var params: Params = undefined
    // Each side of an edge is pushed away from the other; far from the
    // edge nothing changes; more amount pushes more.
    edge(first, 100, 160)
    filters.defaults(enhance.UNSHARP_MASK, &params)
    params.values[0] = 2.0
    params.values[1] = 1.0
    params.values[3] = 0.0
    if !apply(&params, first, 40, 9) { return 130 }
    const reach = @intCast(usize, filters.margin(&params))
    if reach != 3 { return 131 }
    var y: usize = 0
    while y < 9 {
        const row = first + y * 40
        if row[19] & 255 >= 100 || row[20] & 255 <= 160 { return 132 }
        if row[19 - reach] != gray(100) || row[20 + reach] != gray(160) || row[0] != gray(100) || row[39] != gray(160) { return 133 }
        if row[19] != first[19] || row[20] != first[20] { return 134 }
        y += 1
    }
    // A grey picture has only lightness: both ways give the same.
    edge(second, 100, 160)
    params.values[3] = 1.0
    _ = apply(&params, second, 40, 9)
    if !same(first, second, 360) { return 135 }
    edge(second, 100, 160)
    params.values[1] = 2.0
    _ = apply(&params, second, 40, 9)
    if second[19] & 255 >= first[19] & 255 || second[20] & 255 <= first[20] & 255 { return 136 }
    // The middle of a bell of deviation 0.6 (radius 1) weighs 0.6638 of
    // it, the pixel beside it 0.1655, the next 0.0026. Left of the edge
    // the blur is 100 + 60 (0.1655 + 0.0026) = 110.09, so amount 1 gives
    // 100 - 10.09 = 89.9; right of it 160 + 10.09 = 170.1.
    edge(first, 100, 160)
    params.values[0] = 1.0
    params.values[1] = 1.0
    _ = apply(&params, first, 40, 9)
    if first[19] != gray(90) || first[20] != gray(170) || first[18] != gray(100) || first[21] != gray(160) { return 137 }
    // Below the threshold an edge stays: 10 apart, the blur differs from
    // the picture by less than 50 everywhere.
    edge(first, 100, 110)
    edge(second, 100, 110)
    params.values[2] = 50.0
    _ = apply(&params, first, 40, 9)
    if !same(first, second, 360) { return 138 }
    params.values[2] = 0.0
    _ = apply(&params, first, 40, 9)
    if same(first, second, 360) { return 139 }
    // Lightness only keeps a colour's hue: a red made lighter is lighter
    // in all three colours by the same, and the alpha stays.
    var index: usize = 0
    while index < 360 {
        first[index] = if index % 40 < 20 { 0xC0602020 } else { 0xC0C08080 }
        index += 1
    }
    params.values[1] = 1.0
    params.values[3] = 1.0
    _ = apply(&params, first, 40, 9)
    const lighter = first[20]
    if lighter >> 24 != 0xC0 || first[19] >> 24 != 0xC0 { return 140 }
    if (lighter >> 16) & 255 <= 0xC0 { return 141 }
    const more = ((lighter >> 16) & 255) - 0xC0
    if (lighter >> 8) & 255 != 0x80 + more || lighter & 255 != 0x80 + more { return 142 }
    return 0
}

// One pixel of `value` in a flat 100, through the gaussian noise
// reduction at its initial numbers: the middle, the pixel beside it and
// the one across the corner afterwards.
fn speck(value: u32, middle: u32, beside: u32, across: u32) -> bool {
    var params: Params = undefined
    fill(first, 81, gray(100))
    first[40] = gray(value)
    filters.defaults(enhance.GAUSSIAN_NOISE_REDUCTION, &params)
    if filters.margin(&params) != 1 || !apply(&params, first, 9, 9) { return false }
    var index: usize = 0
    while index < 81 {
        const dx = if index % 9 > 4 { index % 9 - 4 } else { 4 - index % 9 }
        const dy = if index / 9 > 4 { index / 9 - 4 } else { 4 - index / 9 }
        var expected = gray(100)
        if dx == 0 && dy == 0 { expected = gray(middle) }
        if dx + dy == 1 { expected = gray(beside) }
        if dx == 1 && dy == 1 { expected = gray(across) }
        if first[index] != expected { return false }
        index += 1
    }
    return true
}

fn reducers() -> u8 {
    // The window of 1 is a bell of deviation 0.6 cut after one pixel:
    // 0.1664, 0.6672, 0.1664. A speck of 110 is 10 above: its blur is
    // 100 + 10 * 0.6672 * 0.6672 = 104.45, beside it 100 + 10 * 0.6672 *
    // 0.1664 = 101.11, across the corner 100.28: all nearer than 15 to
    // what they were, so all are taken.
    if !speck(110, 104, 101, 100) { return 150 }
    // A speck of 200 is 55.5 from its blur: it stays. Beside it the blur
    // is 111.1, across the corner 102.8: those are taken.
    if !speck(200, 200, 111, 103) { return 151 }
    return 0
}

fn wavelets() -> u8 {
    var params: Params = undefined
    const size: usize = 64
    // Grain of up to 12 on a flat grey: less than half of it is left.
    var seed: u32 = 4242
    var before: u32 = 0
    var index: usize = 0
    while index < size * size {
        const value = 116 + next(&seed) % 25
        first[index] = gray(value)
        before += difference(value, 128)
        index += 1
    }
    filters.defaults(enhance.WAVELET_NOISE_REDUCTION, &params)
    params.values[0] = 20.0
    if filters.margin(&params) != 31 || !apply(&params, first, size, size) { return 160 }
    var after: u32 = 0
    index = 0
    while index < size * size {
        if first[index] != gray(first[index] & 255) { return 161 }
        after += difference(first[index] & 255, 128)
        index += 1
    }
    if after * 2 > before { return 162 }
    // An edge stays an edge: far from it nothing changes at all, at it
    // each side gives a little (the thresholds of all scales together
    // are below 1.3 times the number: 9 of 255 here).
    index = 0
    while index < 80 * 9 {
        first[index] = if index % 80 < 40 { gray(20) } else { gray(235) }
        index += 1
    }
    filters.defaults(enhance.WAVELET_NOISE_REDUCTION, &params)
    _ = apply(&params, first, 80, 9)
    var y: usize = 0
    while y < 9 {
        const row = first + y * 80
        var x: usize = 0
        while x < 80 {
            const was: u32 = if x < 40 { 20 } else { 235 }
            if (x < 8 || x > 71) && row[x] != gray(was) { return 163 }
            if difference(row[x] & 255, was) > 9 { return 164 }
            x += 1
        }
        y += 1
    }
    return 0
}

// ---------------------------------------------------------------------

// The `turn`-th of the settings the following checks go through: every
// filter as it starts and with other numbers, so that every way through
// the code is taken (the bell weighed out and as boxes, the box, weights
// that fall, long and short streaks, each iris). False: no such turn.
fn setting(turn: usize, params: *Params) -> bool {
    if turn == 0 {
        filters.defaults(blur.GAUSSIAN_BLUR, params)
    } else if turn == 1 {
        filters.defaults(blur.GAUSSIAN_BLUR, params)
        params.*.values[0] = 30.0
        params.*.values[1] = 12.0
    } else if turn == 2 {
        filters.defaults(blur.GAUSSIAN_BLUR, params)
        params.*.values[0] = 0.0
        params.*.values[1] = 100.0
    } else if turn == 3 {
        filters.defaults(blur.BLUR, params)
    } else if turn == 4 {
        filters.defaults(blur.BLUR, params)
        params.*.values[0] = 7.0
        params.*.values[1] = 3.0
        params.*.values[4] = 1.0
    } else if turn == 5 {
        filters.defaults(blur.BLUR, params)
        params.*.values[0] = 9.0
        params.*.values[1] = 4.0
        params.*.values[2] = 60.0
        params.*.values[3] = 30.0
        params.*.values[4] = 1.0
    } else if turn == 6 {
        filters.defaults(blur.BLUR, params)
        params.*.values[0] = 12.0
        params.*.values[1] = 5.0
        params.*.values[3] = 75.0
    } else if turn == 7 {
        filters.defaults(blur.MOTION_BLUR, params)
    } else if turn == 8 {
        filters.defaults(blur.MOTION_BLUR, params)
        params.*.values[0] = 30.0
        params.*.values[1] = 17.0
    } else if turn == 9 {
        filters.defaults(blur.MOTION_BLUR, params)
        params.*.values[0] = 90.0
        params.*.values[1] = 40.0
    } else if turn == 10 {
        filters.defaults(blur.LENS_BLUR, params)
    } else if turn == 11 {
        filters.defaults(blur.LENS_BLUR, params)
        params.*.values[0] = 9.5
        params.*.values[1] = 0.0
        params.*.values[2] = 20.0
    } else if turn == 12 {
        filters.defaults(blur.LENS_BLUR, params)
        params.*.values[0] = 14.0
        params.*.values[1] = 6.0
    } else if turn == 13 {
        filters.defaults(enhance.SHARPEN, params)
    } else if turn == 14 {
        filters.defaults(enhance.MEAN_REMOVAL, params)
    } else if turn == 15 {
        filters.defaults(enhance.UNSHARP_MASK, params)
    } else if turn == 16 {
        filters.defaults(enhance.UNSHARP_MASK, params)
        params.*.values[0] = 8.0
        params.*.values[1] = 1.5
        params.*.values[2] = 4.0
        params.*.values[3] = 0.0
    } else if turn == 17 {
        filters.defaults(enhance.UNSHARP_MASK, params)
        params.*.values[0] = 40.0
        params.*.values[1] = 5.0
    } else if turn == 18 {
        filters.defaults(enhance.GAUSSIAN_NOISE_REDUCTION, params)
    } else if turn == 19 {
        filters.defaults(enhance.GAUSSIAN_NOISE_REDUCTION, params)
        params.*.values[0] = 60.0
        params.*.values[1] = 4.0
    } else if turn == 20 {
        filters.defaults(enhance.WAVELET_NOISE_REDUCTION, params)
    } else if turn == 21 {
        filters.defaults(enhance.WAVELET_NOISE_REDUCTION, params)
        params.*.values[0] = 40.0
    } else {
        return false
    }
    return true
}

// A red square (opaque, then half so) on a ground that is transparent
// but white: red stays the only colour wherever anything shows.
fn bleeding() -> u8 {
    const size: usize = 48
    var params: Params = undefined
    var turn: usize = 0
    while setting(turn, &params) {
        var alpha: u32 = 0xFF
        while alpha != 0 {
            var index: usize = 0
            while index < size * size {
                const x = index % size
                const y = index / size
                first[index] = if x >= 16 && x < 32 && y >= 16 && y < 32 { (alpha << 24) | 0xFF0000 } else { 0x00FFFFFF }
                index += 1
            }
            if !apply(&params, first, size, size) { return 170 }
            var shown: usize = 0
            index = 0
            while index < size * size {
                const pixel = first[index]
                if pixel >> 24 == 0 {
                    if pixel != 0 { return 171 }
                } else {
                    if pixel & 0x00FFFFFF != 0xFF0000 { return 172 }
                    shown += 1
                }
                index += 1
            }
            if shown < 100 { return 173 }
            alpha = if alpha == 0xFF { 0x80 } else { 0 }
        }
        turn += 1
    }
    return 0
}

// The picture filtered whole (in `second`) against itself filtered block
// by block as the compositor does it: each block of 256 with margin()
// more pixels on every side (as far as the picture goes), filtered, and
// only the block kept.
fn blocks(params: *const Params, width: usize, height: usize) -> bool {
    const margin = @intCast(usize, filters.margin(params))
    var top: usize = 0
    while top < height {
        const bottom = if top + 256 < height { top + 256 } else { height }
        var left: usize = 0
        while left < width {
            const right = if left + 256 < width { left + 256 } else { width }
            const x0 = if left > margin { left - margin } else { 0 }
            const y0 = if top > margin { top - margin } else { 0 }
            const x1 = if right + margin < width { right + margin } else { width }
            const y1 = if bottom + margin < height { bottom + margin } else { height }
            const wide = x1 - x0
            var y = y0
            while y < y1 {
                copy(third + (y - y0) * wide, first + (y * width + x0), wide)
                y += 1
            }
            if !filters.apply(params, third, wide, y1 - y0, wide) { return false }
            y = top
            while y < bottom {
                if !same(third + ((y - y0) * wide + left - x0), second + (y * width + left), right - left) { return false }
                y += 1
            }
            left = right
        }
        top = bottom
    }
    return true
}

fn seams() -> u8 {
    // Tall enough for the filters' own bands of rows to show their seams
    // too, if they had any.
    const width: usize = 700
    const height: usize = 1000
    var params: Params = undefined
    var turn: usize = 0
    while setting(turn, &params) {
        picture(first, width, height, 31337)
        copy(second, first, width * height)
        if !apply(&params, second, width, height) { return 180 }
        if same(first, second, width * height) { return 181 }
        if !blocks(&params, width, height) { return 182 }
        turn += 1
    }
    // A wide and low one: other blocks, other bands.
    turn = 0
    while setting(turn, &params) {
        picture(first, 1500, 300, 4711)
        copy(second, first, 1500 * 300)
        if !apply(&params, second, 1500, 300) { return 183 }
        if !blocks(&params, 1500, 300) { return 184 }
        turn += 1
    }
    return 0
}

// A buffer wider than the picture: the words beside the picture stay,
// the picture comes out as from a buffer just as wide as itself. And
// the same numbers give the same pixels twice.
fn strides() -> u8 {
    const width: usize = 50
    const height: usize = 23
    const stride: usize = 61
    var params: Params = undefined
    var turn: usize = 0
    while setting(turn, &params) {
        picture(first, width, height, 99)
        fill(second, stride * height, 0xDEADBEEF)
        var y: usize = 0
        while y < height {
            copy(second + y * stride, first + y * width, width)
            y += 1
        }
        copy(third, first, width * height)
        if !apply(&params, first, width, height) { return 190 }
        if !filters.apply(&params, second, width, height, stride) { return 191 }
        y = 0
        while y < height {
            if !same(second + y * stride, first + y * width, width) { return 192 }
            var x = width
            while x < stride {
                if second[y * stride + x] != 0xDEADBEEF { return 193 }
                x += 1
            }
            y += 1
        }
        if !apply(&params, third, width, height) { return 194 }
        if !same(first, third, width * height) { return 195 }
        turn += 1
    }
    return 0
}

// Fifty times each: the working memory is given back each time and the
// value arena is not used. Each filter is found once and then called
// itself, margin and all: what is measured is the filter, not the
// finding.
fn memory() -> u8 {
    const pool = scratch.common()
    var params: Params = undefined
    const arena = turns.locate()
    var grown: usize = 0
    var turn: usize = 0
    while setting(turn, &params) {
        const info = filters.find(params.id).?
        const before = turns.used(arena)
        var round: usize = 0
        while round < 50 {
            grain(first, 64 * 64, false, 3)
            const mark = scratch.mark(pool)
            if info.*.margin.?(&params) < 0 { return 200 }
            info.*.apply(&params, first, 64, 64, 64)
            const after = scratch.mark(pool)
            if after.block != mark.block || after.used != mark.used { return 201 }
            round += 1
        }
        grown += turns.used(arena) - before
        turn += 1
    }
    if grown > 4096 { return 202 }
    // What the registry found stays where it is: the list is not one
    // that is gone when the window's loop turns.
    const again = filters.find(blur.GAUSSIAN_BLUR).?
    const once = filters.find(blur.GAUSSIAN_BLUR).?
    if @intFromPtr(again) != @intFromPtr(once) || @intFromPtr(again.*.params.pointer) != @intFromPtr(once.*.params.pointer) { return 203 }
    if @intFromPtr(again) >= arena && @intFromPtr(again) < arena + 1073741824 { return 204 }
    return 0
}

// How fast: a megapixel through each setting.
fn speeds() -> void {
    const size: usize = 1024
    var params: Params = undefined
    var name: [96]u8 = undefined
    const bytes: [*]u8 = &name
    var turn: usize = 0
    while setting(turn, &params) {
        picture(first, size, size, 2026)
        const start = std.time.monotonicNanoseconds()
        _ = apply(&params, first, size, size)
        const took = std.time.monotonicNanoseconds() - start
        // Megapixels a second, in tenths.
        const tenths = size * size * 10 / (took / 1000 + 1)
        const info = filters.find(params.id).?
        var length = std.text.append(bytes, 0, 96, info.*.name)
        var index: usize = 0
        while index < info.*.params.length {
            // The numbers in tenths (none here is below 0).
            const number = @intFromFloat(usize, params.values[index] * 10.0 + 0.5)
            length = std.text.appendByte(bytes, length, 96, ' ')
            length = std.text.appendUnsigned(bytes, length, 96, number / 10)
            if number % 10 != 0 {
                length = std.text.appendByte(bytes, length, 96, '.')
                length = std.text.appendUnsigned(bytes, length, 96, number % 10)
            }
            index += 1
        }
        length = std.text.append(bytes, length, 96, ": ")
        length = std.text.appendUnsigned(bytes, length, 96, tenths / 10)
        length = std.text.appendByte(bytes, length, 96, '.')
        length = std.text.appendUnsigned(bytes, length, 96, tenths % 10)
        length = std.text.append(bytes, length, 96, " MP/s")
        _ = std.io.println(bytes[0..length])
        turn += 1
    }
}

pub fn main() -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory_first = allocator.alloc(SPACE * 4, 16)
    const memory_second = allocator.alloc(SPACE * 4, 16)
    const memory_third = allocator.alloc(SPACE * 4, 16)
    if memory_first == null || memory_second == null || memory_third == null { return 250 }
    unsafe {
        first = @ptrCast([*]u32, memory_first.?)
        second = @ptrCast([*]u32, memory_second.?)
        third = @ptrCast([*]u32, memory_third.?)
    }
    var failed = listed()
    if failed == 0 { failed = sizes() }
    if failed == 0 { failed = strays() }
    if failed == 0 { failed = neutral() }
    if failed == 0 { failed = kernels() }
    if failed == 0 { failed = boxes() }
    if failed == 0 { failed = gaussians() }
    if failed == 0 { failed = streaks() }
    if failed == 0 { failed = irises() }
    if failed == 0 { failed = unsharps() }
    if failed == 0 { failed = reducers() }
    if failed == 0 { failed = wavelets() }
    if failed == 0 { failed = bleeding() }
    if failed == 0 { failed = seams() }
    if failed == 0 { failed = strides() }
    if failed == 0 { failed = memory() }
    if failed != 0 { return failed }
    speeds()
    return 13
}
