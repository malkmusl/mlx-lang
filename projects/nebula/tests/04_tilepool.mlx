// nebula's tile pool: thousands of tiles come from a few large blocks
// (brixOS gives a process 256 memory regions), a tile given back is used
// again, and a block whose tiles are all back goes to the heap: when the
// last device ends nothing of the pool is left. Exits 13.
const std = @import("std")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const tilepool = @import("../core/tilepool.mlx")

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    if tilepool.liveTiles() != 0 || tilepool.blockCount() != 0 { return 1 }
    const before = std.heap.liveBytes()
    const layer = device.create(allocator, 0).?
    // 4096 x 3072: 64 x 48 tiles.
    if !device.fill(layer, geom.rect(0, 0, 4096, 3072), 0xFF336699) { return 2 }
    if device.tileCount(layer) != 3072 || tilepool.liveTiles() != 3072 { return 3 }
    // 16 MiB blocks of 16400-byte tiles: 1023 each, so four blocks.
    if tilepool.blockCount() != 4 { return 4 }
    if device.pixel(layer, 4095, 3071) != 0xFF336699 || device.pixel(layer, 0, 0) != 0xFF336699 { return 5 }

    // A copy shares; writing one tile of it takes one more.
    const twin = device.copy(layer).?
    if tilepool.liveTiles() != 3072 { return 6 }
    device.setPixel(twin, 10, 10, 0xFFFFFFFF)
    if tilepool.liveTiles() != 3073 { return 7 }
    device.destroy(twin)
    if tilepool.liveTiles() != 3072 { return 8 }

    // Given back and taken again: no more blocks.
    device.clearRect(layer, geom.rect(0, 0, 4096, 1024))
    if tilepool.liveTiles() != 2048 { return 9 }
    _ = device.fill(layer, geom.rect(0, 0, 4096, 1024), 0xFF000000)
    if tilepool.liveTiles() != 3072 || tilepool.blockCount() > 4 { return 10 }

    // A change keeps the tiles it replaced; undone and ended, they go.
    device.begin(layer)
    _ = device.fill(layer, geom.rect(0, 0, 640, 640), 0xFF112233)
    const change = device.commit(layer).?
    if tilepool.liveTiles() != 3072 + 100 { return 11 }
    _ = device.apply(layer, change, true)
    device.destroyChange(change)
    if tilepool.liveTiles() != 3072 || device.pixel(layer, 5, 5) != 0xFF000000 { return 12 }

    device.destroy(layer)
    if tilepool.liveTiles() != 0 || tilepool.blockCount() != 0 { return 14 }
    if std.heap.liveBytes() != before { return 15 }

    // A fresh start after everything was given back.
    const again = device.create(allocator, 0).?
    device.setPixel(again, -5, -5, 0xFFFF0000)
    if device.pixel(again, -5, -5) != 0xFFFF0000 || tilepool.blockCount() != 1 { return 16 }
    device.destroy(again)
    if tilepool.blockCount() != 0 || std.heap.liveBytes() != before { return 17 }
    return 13
}
