// nebula's canvas view (ui/canvasview.mlx) and the tools' marks over it
// (ui/overlay.mlx), in a window of 1000 x 700 without a window
// (app/script.mlx's headless App showing the canvas alone, its frames,
// and frames the test draws into canvases of its own, the canvas area
// set inside the window):
//
// - at zoom 1, 2 and 8 every window pixel of the image's part is the
//   image's pixel under its middle (blocks of 16 pixels in colours of
//   their own, single marker pixels), transparent pixels show the
//   checker anchored to the window, half transparent ones its mix, the
//   ground and the line around the image lie outside; from zoom 8 the
//   pixel grid lies on the pixels' edges;
// - at zoom 0.5 and 0.25 a checkerboard of single pixels is a flat grey,
//   not a moire, and the edge between a red and a blue half stays clean;
// - mirrored, the left marker is on the right; turned by 90 and by 30
//   degrees, markers and blocks are where the turn puts them;
// - inputAt gives back the image point a window pixel shows, upright,
//   mirrored and turned, with rulers and without;
// - after painting into the layer, refresh() names a rectangle around the
//   changed pixels' window rectangle and little more, and the window then
//   equals a fresh draw() bit for bit (upright, turned, below zoom 1:
//   the smaller pictures were brought up to date);
// - marks drawn through ui/overlay.mlx appear, stay inside the canvas
//   area, and a refresh() after they stop removes every pixel of them;
// - the marching ants: on the selection's edge, dashed black and white,
//   moving when 120 ms pass, following zoom and turn, gone when nothing
//   is selected;
// - the document's grid (not denser than 4 window pixels) and guides at
//   their window places; rulers, the image's area less them, the
//   pointer's place marked on them;
// - zoomIn / zoomOut walk the ladder about the pointer, fitPage and
//   fitWidth show the image, the other view commands; the light theme;
// - forget() gives the record's memory back, 300 frames of drawing and
//   refreshing leave the value arena as it was, a layout pass draws
//   nothing; and the speeds are printed (not checked);
// - the edges (checks 228 and up, a code each; the output names the
//   check within): images of one colour at 1 x 1, around 64 and 128 and
//   odd sizes, opaque and half transparent, at zoom 0.011 to 256, upright,
//   mirrored and turned, are that colour to their edge with the ground
//   beside them; areas of a pixel, of no room for the rulers, partly
//   beyond the window; the smaller pictures kept right across zoom
//   changes, many changes, an open change, a moved layer, and a document
//   changed while another was in front; every mark of the overlay (NaN,
//   infinite and huge coordinates, degenerate shapes, empty and long
//   labels) keeps to its clip and names all it drew; within one turn
//   frames take a few hundred bytes of the value arena and marks none;
//   the ants from afar (a coarser outline) and of a selection with too
//   many pieces; grid offsets anywhere in an i32; the view commands with
//   NaN, infinite and extreme values and without a document; a document
//   not drawn yet; the theme at twice the size.
//
// Pictures of what was drawn go into the current directory and, when
// NEBULA_SHOTS names a directory, into it too. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const math = @import("std.math")
const ui = @import("std.ui")
const view_module = @import("std.ui.view")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const documents = @import("../app/documents.mlx")
const canvasview = @import("../ui/canvasview.mlx")
const overlay = @import("../ui/overlay.mlx")
const viewport = @import("../ui/viewport.mlx")
const image_module = @import("../core/image.mlx")
const device = @import("../core/device.mlx")
const node = @import("../core/node.mlx")
const ops = @import("../core/ops.mlx")
const mask = @import("../core/mask.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const render = @import("../core/render.mlx")

const App = state.App
const Canvas = state.Canvas
const Document = state.Document
const Image = image_module.Image

const WIDTH: usize = 1000
const HEIGHT: usize = 700
// What a canvas holds where nothing was drawn.
const UNTOUCHED: u32 = 0xFF3A0F2C

const GREEN: u32 = 0xFF00FF00
const MAGENTA: u32 = 0xFFFF00FF
const CYAN: u32 = 0xFF00FFFF
const YELLOW: u32 = 0xFFFFFF00
const WHITE: u32 = 0xFFFFFFFF
const BLACK: u32 = 0xFF000000
const RED: u32 = 0xFFFF0000
const BLUE: u32 = 0xFF0000FF
// Straight, half transparent.
const SEMI: u32 = 0x802060E0

const T = struct {
    app: *App
    // The canvas drawn and refreshed, and the one a fresh draw goes to.
    a: Canvas
    b: Canvas
    shots: []const u8
    // Found in the first frame: the checker's two greys, the ground, the
    // line around the image.
    light: u32
    dark: u32
    ground: u32
    rim: u32
    // The documents: blocks and markers; single-pixel checks with a red
    // and a blue half; a large one for the speeds.
    blocks: usize
    fine: usize
    large: usize
}

// What the marks of the test's own drawing are (0: none; 2: with marks
// by window coordinates; 3: without the label).
var marksKind: u32 = 0
// A polyline and a brush tip's outline (x and y in turn; variables, so
// that their address is one).
var polygon: [8]f64 = [8]f64{ 210.0, 20.0, 260.0, 30.0, 250.0, 70.0, 215.0, 60.0 }
var tip: [12]f64 = [12]f64{ 12.0, 0.0, 6.0, 10.0, -6.0, 10.0, -12.0, 0.0, -6.0, -10.0, 6.0, -10.0 }

fn floorOf(value: f64) -> i32 {
    const held = if value < -1000000.0 { -1000000.0 } else if value > 1000000.0 { 1000000.0 } else { value }
    return @intFromFloat(i32, @floor(held))
}

fn absolute(value: f64) -> f64 { return if value < 0.0 { -value } else { value } }

fn pixelAt(c: *Canvas, x: i32, y: i32) -> u32 {
    return c.*.pixels[@intCast(usize, y) * c.*.stride + @intCast(usize, x)]
}

fn fillCanvas(c: *Canvas, color: u32) -> void {
    device.fillWords(c.*.pixels, c.*.stride * c.*.height, color)
}

// Every channel of `a` within `reach` of `b`'s.
fn near(a: u32, b: u32, reach: u32) -> bool {
    var shift: u32 = 0
    while shift < 32 {
        const x = (a >> @intCast(u5, shift)) & 255
        const y = (b >> @intCast(u5, shift)) & 255
        const off = if x > y { x - y } else { y - x }
        if off > reach { return false }
        shift += 8
    }
    return true
}

fn blockColor(bx: i32, by: i32) -> u32 {
    const red = @intCast(u32, 40 + bx * 11)
    const green = @intCast(u32, 40 + by * 13)
    const blue = @intCast(u32, 100 + ((bx * 7 + by * 5) & 63))
    return 0xFF000000 | (red << 16) | (green << 8) | blue
}

fn docOf(t: *T) -> *Document { return api.document(t.*.app).? }

// The canvas area the view is given: inside the window, so that what it
// must not touch around it can be looked at. The App runs with the canvas
// alone (canvasOnly), whatever the bars and dockers around it are; after
// every frame of the program's loop the area is set again.
fn useArea(t: *T) -> void {
    t.*.app.*.canvasArea = ui.rect(16, 24, 968, 652)
}

fn areaOf(t: *T) -> ui.Rect { return t.*.app.*.canvasArea }

fn setView(t: *T, x: f64, y: f64, zoom: f64, rotation: f64, mirror: bool) -> void {
    const view = &docOf(t).*.view
    view.*.centerX = x
    view.*.centerY = y
    view.*.zoom = zoom
    view.*.rotation = rotation
    view.*.mirror = mirror
}

// The window pixel image point (x, y) is in (the overlay's way of
// rounding).
fn windowOf(t: *T, x: f64, y: f64, wx: *i32, wy: *i32) -> void {
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    viewport.toWindow(&docOf(t).*.view, x, y, &fx, &fy)
    wx.* = floorOf(fx + 0.001)
    wy.* = floorOf(fy + 0.001)
}

fn show(t: *T) -> void {
    canvasview.draw(t.*.app, &t.*.a, areaOf(t))
}

// A draw from nothing kept into canvas b.
fn reference(t: *T) -> void {
    canvasview.forget(t.*.app, docOf(t))
    fillCanvas(&t.*.b, UNTOUCHED)
    canvasview.draw(t.*.app, &t.*.b, areaOf(t))
}

// Canvases a and b are the same in the canvas area.
fn sameAsReference(t: *T) -> bool {
    const area = areaOf(t)
    var row = area.y
    while row < area.y + area.height {
        var column = area.x
        while column < area.x + area.width {
            if pixelAt(&t.*.a, column, row) != pixelAt(&t.*.b, column, row) { return false }
            column += 1
        }
        row += 1
    }
    return true
}

// The rectangle of the canvas area where a and b differ.
fn difference(t: *T) -> ui.Rect {
    const area = areaOf(t)
    var found = geom.empty()
    var row = area.y
    while row < area.y + area.height {
        var column = area.x
        while column < area.x + area.width {
            if pixelAt(&t.*.a, column, row) != pixelAt(&t.*.b, column, row) { found = geom.unite(found, ui.rect(column, row, 1, 1)) }
            column += 1
        }
        row += 1
    }
    return found
}

// No pixel of canvas `c` outside `area` was drawn.
fn untouchedAround(c: *Canvas, area: ui.Rect) -> bool {
    var row: i32 = 0
    while row < @intCast(i32, HEIGHT) {
        var column: i32 = 0
        while column < @intCast(i32, WIDTH) {
            if !ui.contains(area, column, row) && pixelAt(c, column, row) != UNTOUCHED { return false }
            column += 1
        }
        row += 1
    }
    return true
}

fn covers(outer: ui.Rect, inner: ui.Rect) -> bool {
    if ui.isEmpty(inner) { return true }
    return outer.x <= inner.x && outer.y <= inner.y && outer.x + outer.width >= inner.x + inner.width && outer.y + outer.height >= inner.y + inner.height
}

fn save(t: *T, c: *Canvas, name: []const u8) -> void {
    const allocator = t.*.app.*.allocator
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, name)
    bytes[length] = 0
    _ = png.saveFile(bytes, c.*.pixels, WIDTH, HEIGHT, WIDTH, false, allocator)
    if t.*.shots.length == 0 || t.*.shots.length > 400 { return }
    length = std.text.append(bytes, 0, 599, t.*.shots)
    if bytes[length - 1] != 47 { length = std.text.appendByte(bytes, length, 599, 47) }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    _ = png.saveFile(bytes, c.*.pixels, WIDTH, HEIGHT, WIDTH, false, allocator)
}

// What window pixel (column, row) must show in an upright view: the image
// pixel under its middle over the checker.
fn expectedAt(t: *T, column: i32, row: i32) -> u32 {
    const doc = docOf(t)
    var x: f64 = 0.0
    var y: f64 = 0.0
    viewport.toImage(&doc.*.view, @floatFromInt(f64, column) + 0.5, @floatFromInt(f64, row) + 0.5, &x, &y)
    const value = device.pixel(doc.*.image.*.projection, floorOf(x), floorOf(y))
    if value >> 24 == 255 { return value }
    const check = if (column >> 3) & 1 == (row >> 3) & 1 { t.*.light } else { t.*.dark }
    return pixel.over(check, value, 255)
}

// The image's column (row) under window column (row) `at` of an upright
// view.
fn imageColumn(t: *T, at: i32) -> i32 {
    const view = &docOf(t).*.view
    var x: f64 = 0.0
    var y: f64 = 0.0
    viewport.toImage(view, @floatFromInt(f64, at) + 0.5, @floatFromInt(f64, view.*.area.y), &x, &y)
    return floorOf(x)
}

fn imageRow(t: *T, at: i32) -> i32 {
    const view = &docOf(t).*.view
    var x: f64 = 0.0
    var y: f64 = 0.0
    viewport.toImage(view, @floatFromInt(f64, view.*.area.x), @floatFromInt(f64, at) + 0.5, &x, &y)
    return floorOf(y)
}

// Says where a picture is not as it should be (for whoever reads the
// output of a failed run).
fn mismatch(what: []const u8, x: i32, y: i32, shown: u32, wanted: u32) -> void {
    _ = std.io.print("53_canvasview: ")
    _ = std.io.print(what)
    _ = std.io.print(" at ")
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, if x < 0 { 0 } else { x }))
    _ = std.io.print(", ")
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, if y < 0 { 0 } else { y }))
    _ = std.io.print(": ")
    _ = std.io.writeUnsignedBase(std.io.stdout(), @intCast(usize, shown), 16)
    _ = std.io.print(" shown, ")
    _ = std.io.writeUnsignedBase(std.io.stdout(), @intCast(usize, wanted), 16)
    _ = std.io.print(" wanted\n")
}

// An upright view in canvas `c`, every pixel of the image's area: the
// image where it shows (`skip_grid`: but for the first window column and
// row of each image pixel, where the pixel grid lies), the line around
// it, the ground beyond. 0 when so, else 1 (the image), 2 (the line), 3
// (the ground), 4 (no image at all).
fn checkUpright(t: *T, c: *Canvas, skip_grid: bool) -> u8 {
    const doc = docOf(t)
    const inner = doc.*.view.area
    const image = doc.*.image
    _ = render.update(image)
    var left = inner.x + inner.width
    var right = inner.x - 1
    var at = inner.x
    while at < inner.x + inner.width {
        const ix = imageColumn(t, at)
        if ix >= 0 && ix < image.*.width {
            if at < left { left = at }
            right = at
        }
        at += 1
    }
    var top = inner.y + inner.height
    var bottom = inner.y - 1
    at = inner.y
    while at < inner.y + inner.height {
        const iy = imageRow(t, at)
        if iy >= 0 && iy < image.*.height {
            if at < top { top = at }
            bottom = at
        }
        at += 1
    }
    if right < left || bottom < top { return 4 }
    var row = inner.y
    while row < inner.y + inner.height {
        var column = inner.x
        while column < inner.x + inner.width {
            const shown = pixelAt(c, column, row)
            if column >= left && column <= right && row >= top && row <= bottom {
                const edge = skip_grid && (imageColumn(t, column - 1) != imageColumn(t, column) || imageRow(t, row - 1) != imageRow(t, row))
                if !edge && shown != expectedAt(t, column, row) {
                    mismatch("the image", column, row, shown, expectedAt(t, column, row))
                    return 1
                }
            } else if column >= left - 1 && column <= right + 1 && row >= top - 1 && row <= bottom + 1 {
                if shown != t.*.rim {
                    mismatch("the line around the image", column, row, shown, t.*.rim)
                    return 2
                }
            } else if shown != t.*.ground {
                mismatch("the ground", column, row, shown, t.*.ground)
                return 3
            }
            column += 1
        }
        row += 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// The images

fn blocksImage(allocator: std.allocator.Allocator) -> ?*Image {
    const made = image_module.create(allocator, 300, 200, 72.0)
    if made == null { return null }
    const image = made.?
    const layer = ops.newLayer(image, node.PAINT, "Blocks", "New layer")
    if layer == null { return null }
    const target = layer.?.*.device.?
    var by: i32 = 0
    while by * 16 < 200 {
        var bx: i32 = 0
        while bx * 16 < 240 {
            _ = device.fill(target, geom.rect(bx * 16, by * 16, 16, 16), blockColor(bx, by))
            bx += 1
        }
        by += 1
    }
    // The right part: transparent above, half transparent below.
    _ = device.fill(target, geom.rect(240, 100, 60, 100), SEMI)
    device.setPixel(target, 5, 7, GREEN)
    device.setPixel(target, 230, 190, MAGENTA)
    device.setPixel(target, 120, 3, CYAN)
    device.setPixel(target, 239, 199, YELLOW)
    image_module.damageAll(image)
    return image
}

fn fineImage(allocator: std.allocator.Allocator) -> ?*Image {
    const made = image_module.create(allocator, 512, 256, 72.0)
    if made == null { return null }
    const image = made.?
    const layer = ops.newLayer(image, node.PAINT, "Fine", "New layer")
    if layer == null { return null }
    const target = layer.?.*.device.?
    _ = device.fill(target, geom.rect(0, 0, 256, 256), BLACK)
    var y: i32 = 0
    while y < 256 {
        var x = y & 1
        while x < 256 {
            device.setPixel(target, x, y, WHITE)
            x += 2
        }
        y += 1
    }
    _ = device.fill(target, geom.rect(256, 0, 128, 256), RED)
    _ = device.fill(target, geom.rect(384, 0, 128, 256), BLUE)
    image_module.damageAll(image)
    return image
}

fn largeImage(allocator: std.allocator.Allocator) -> ?*Image {
    const made = image_module.create(allocator, 3000, 2400, 72.0)
    if made == null { return null }
    const image = made.?
    const layer = ops.newLayer(image, node.PAINT, "Large", "New layer")
    if layer == null { return null }
    const target = layer.?.*.device.?
    var ty: i32 = 0
    while ty * 64 < 2400 {
        var tx: i32 = 0
        while tx * 64 < 3000 {
            _ = device.fill(target, geom.rect(tx * 64, ty * 64, 64, 64), blockColor(tx % 14, ty % 12))
            tx += 1
        }
        ty += 1
    }
    // A hole and a veil: the checker and its mix show.
    _ = device.fill(target, geom.rect(1200, 900, 300, 300), 0)
    _ = device.fill(target, geom.rect(1500, 900, 300, 300), SEMI)
    image_module.damageAll(image)
    return image
}

fn add(t: *T, made: ?*Image, name: []const u8) -> bool {
    if made == null { return false }
    if documents.add(t.*.app, made.?, name) == null { return false }
    const ran = script.run(t.*.app, "wait 1\n")
    useArea(t)
    return ran
}

// ---------------------------------------------------------------------------
// The marks a test tool draws

fn testMarks(app: *App, canvas: *Canvas) -> void {
    if marksKind == 0 { return }
    const p = overlay.begin(app, canvas)
    overlay.rect(&p, 40.0, 30.0, 100.0, 60.0)
    overlay.line(&p, 20.0, 150.0, 200.0, 182.0)
    overlay.ellipse(&p, 200.0, 100.0, 40.0, 25.0)
    overlay.circle(&p, 60.0, 140.0, 20.0)
    overlay.handle(&p, 40.0, 30.0, overlay.SQUARE, false)
    overlay.handle(&p, 140.0, 30.0, overlay.ROUND, true)
    overlay.handle(&p, 140.0, 90.0, overlay.DIAMOND, false)
    overlay.cross(&p, 90.0, 60.0)
    overlay.dashedRect(&p, 160.0, 130.0, 60.0, 40.0)
    overlay.dashedLine(&p, 160.0, 120.0, 220.0, 124.0)
    overlay.polyline(&p, &polygon, 4, true)
    overlay.outline(&p, 250.0, 150.0, &tip, 6)
    // (Text costs the value arena a few KiB each time: std.ui.text.)
    if marksKind != 3 { overlay.label(&p, 140.0, 90.0, "100 x 60") }
    // From far outside the window: only the canvas area gets any of it.
    overlay.line(&p, 100.0, -5000.0, 100.0, 5000.0)
    overlay.dashedLine(&p, -3000.0, 100.0, 3000.0, 101.0)
    if marksKind == 2 {
        overlay.windowRect(&p, 30.0, 60.0, 40.0, 30.0)
        overlay.windowLine(&p, 30.0, 100.0, 70.0, 130.0)
    }
}

// ---------------------------------------------------------------------------
// The checks

// The first frame: the checker's greys, the ground and the line found;
// at zoom 1, 2 and 8 every pixel as the image says.
fn checkZooms(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    canvasview.setPixelGrid(app, true)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    fillCanvas(&t.*.a, UNTOUCHED)
    show(t)
    const doc = docOf(t)
    const inner = doc.*.view.area
    if !geom.same(inner, areaOf(t)) || !geom.same(canvasview.imageArea(app, doc), inner) { return 1 }
    // Nothing outside the canvas area was drawn.
    if !untouchedAround(&t.*.a, inner) { return 2 }
    t.*.ground = pixelAt(&t.*.a, inner.x + 1, inner.y + 1)
    if t.*.ground >> 24 != 255 { return 3 }
    // The checker under the transparent part: two greys by the window's
    // squares of 8.
    var x0: i32 = 0
    var y0: i32 = 0
    windowOf(t, 244.0, 4.0, &x0, &y0)
    t.*.light = 0
    t.*.dark = 0
    var row = y0
    while row < y0 + 40 {
        var column = x0
        while column < x0 + 40 {
            const value = pixelAt(&t.*.a, column, row)
            if (column >> 3) & 1 == (row >> 3) & 1 {
                if t.*.light == 0 { t.*.light = value }
                if value != t.*.light { return 4 }
            } else {
                if t.*.dark == 0 { t.*.dark = value }
                if value != t.*.dark { return 5 }
            }
            column += 1
        }
        row += 1
    }
    if t.*.light == t.*.dark || t.*.light >> 24 != 255 || t.*.dark >> 24 != 255 { return 6 }
    if pixel.red(t.*.light) != pixel.blue(t.*.light) || pixel.red(t.*.dark) != pixel.green(t.*.dark) { return 7 }
    // The line around the image: left of its first column.
    windowOf(t, 0.0, 100.0, &x0, &y0)
    t.*.rim = pixelAt(&t.*.a, x0 - 1, y0)
    if t.*.rim == t.*.ground || pixelAt(&t.*.a, x0 - 2, y0) != t.*.ground { return 8 }
    // Markers at their places, and everything else.
    windowOf(t, 5.5, 7.5, &x0, &y0)
    if pixelAt(&t.*.a, x0, y0) != GREEN || pixelAt(&t.*.a, x0 + 1, y0) != blockColor(0, 0) { return 9 }
    windowOf(t, 239.5, 199.5, &x0, &y0)
    if pixelAt(&t.*.a, x0, y0) != YELLOW { return 10 }
    if checkUpright(t, &t.*.a, false) != 0 { return 11 }
    save(t, &t.*.a, "53-zoom-1.png")

    setView(t, 150.0, 100.0, 2.0, 0.0, false)
    show(t)
    windowOf(t, 120.5, 3.5, &x0, &y0)
    if pixelAt(&t.*.a, x0, y0) != CYAN || pixelAt(&t.*.a, x0 - 1, y0 - 1) != CYAN || pixelAt(&t.*.a, x0 + 1, y0) == CYAN { return 12 }
    if checkUpright(t, &t.*.a, false) != 0 { return 14 }
    save(t, &t.*.a, "53-zoom-2.png")

    // Zoom 8 without the pixel grid: exact; with it: exact but on the
    // pixels' edges, and there it differs.
    setView(t, 236.0, 192.0, 8.0, 0.0, false)
    canvasview.setPixelGrid(app, false)
    if canvasview.pixelGrid(app) { return 15 }
    show(t)
    if checkUpright(t, &t.*.a, false) != 0 { return 16 }
    windowOf(t, 239.0, 199.0, &x0, &y0)
    if pixelAt(&t.*.a, x0, y0) != YELLOW || pixelAt(&t.*.a, x0 + 7, y0 + 7) != YELLOW || pixelAt(&t.*.a, x0 + 8, y0) == YELLOW { return 17 }
    canvasview.setPixelGrid(app, true)
    show(t)
    if checkUpright(t, &t.*.a, true) != 0 { return 18 }
    if pixelAt(&t.*.a, x0, y0 + 3) == YELLOW || pixelAt(&t.*.a, x0 + 3, y0) == YELLOW || pixelAt(&t.*.a, x0 + 3, y0 + 3) != YELLOW { return 19 }
    // The grid is faint: the colour under it still shows.
    if !near(pixelAt(&t.*.a, x0 + 3, y0), YELLOW, 110) { return 20 }
    save(t, &t.*.a, "53-zoom-8-grid.png")
    // Below zoom 8 there is none.
    setView(t, 236.0, 192.0, 6.0, 0.0, false)
    show(t)
    if checkUpright(t, &t.*.a, false) != 0 { return 21 }
    return 0
}

// Below zoom 1: averaged, not skipped over.
fn checkSmaller(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.fine)
    var round: usize = 0
    while round < 3 {
        const zoom: f64 = if round == 0 { 0.5 } else if round == 1 { 0.25 } else { 0.3 }
        setView(t, 256.0, 128.0, zoom, 0.0, false)
        show(t)
        const view = &docOf(t).*.view
        var greys: usize = 0
        var row = view.*.area.y
        while row < view.*.area.y + view.*.area.height {
            var column = view.*.area.x
            while column < view.*.area.x + view.*.area.width {
                var x: f64 = 0.0
                var y: f64 = 0.0
                viewport.toImage(view, @floatFromInt(f64, column) + 0.5, @floatFromInt(f64, row) + 0.5, &x, &y)
                const reach = 2.0 / zoom
                if x > reach && x < 256.0 - reach && y > reach && y < 256.0 - reach {
                    if !near(pixelAt(&t.*.a, column, row), 0xFF808080, 2) { return 1 + @intCast(u8, round) * 10 }
                    greys += 1
                }
                column += 1
            }
            row += 1
        }
        if greys < 1000 { return 2 + @intCast(u8, round) * 10 }
        // The red and the blue half: a clean edge in every row.
        var edge_x: i32 = 0
        var edge_y: i32 = 0
        windowOf(t, 384.0, 128.0, &edge_x, &edge_y)
        row = view.*.area.y
        while row < view.*.area.y + view.*.area.height {
            const iy = imageRow(t, row)
            if iy >= 2 && iy < 254 {
                var mixed: i32 = 0
                var column = edge_x - 30
                while column < edge_x + 30 {
                    const value = pixelAt(&t.*.a, column, row)
                    const red = near(value, RED, 2)
                    const blue = near(value, BLUE, 2)
                    if column < edge_x - 2 && !red { return 3 + @intCast(u8, round) * 10 }
                    if column > edge_x + 1 && !blue { return 4 + @intCast(u8, round) * 10 }
                    if !red && !blue { mixed += 1 }
                    column += 1
                }
                if mixed > 2 { return 5 + @intCast(u8, round) * 10 }
            }
            row += 1
        }
        if round == 0 { save(t, &t.*.a, "53-zoom-0.5.png") }
        if round == 1 { save(t, &t.*.a, "53-zoom-0.25.png") }
        round += 1
    }
    return 0
}

// Mirrored and turned views.
fn checkTurned(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    canvasview.setPixelGrid(app, true)
    var x: i32 = 0
    var y: i32 = 0
    setView(t, 150.0, 100.0, 2.0, 0.0, true)
    show(t)
    const inner = docOf(t).*.view.area
    windowOf(t, 5.5, 7.5, &x, &y)
    if x < inner.x + inner.width / 2 || pixelAt(&t.*.a, x, y) != GREEN { return 1 }
    windowOf(t, 230.5, 190.5, &x, &y)
    if x > inner.x + inner.width / 2 || pixelAt(&t.*.a, x, y) != MAGENTA { return 2 }
    if checkUpright(t, &t.*.a, false) != 0 { return 3 }
    save(t, &t.*.a, "53-mirror.png")

    // A quarter turn clockwise: the image's top is on the right.
    setView(t, 150.0, 100.0, 2.0, math.pi / 2.0, false)
    show(t)
    windowOf(t, 5.5, 7.5, &x, &y)
    if x < inner.x + inner.width / 2 || y > inner.y + inner.height / 2 || !near(pixelAt(&t.*.a, x, y), GREEN, 3) { return 4 }
    windowOf(t, 120.5, 3.5, &x, &y)
    if !near(pixelAt(&t.*.a, x, y), CYAN, 3) { return 5 }
    windowOf(t, 239.5, 199.5, &x, &y)
    if x > inner.x + inner.width / 2 || y < inner.y + inner.height / 2 || !near(pixelAt(&t.*.a, x, y), YELLOW, 3) { return 6 }
    save(t, &t.*.a, "53-turn-90.png")

    // Thirty degrees: every block's middle in its colour, the transparent
    // part's in the checker.
    var round: usize = 0
    while round < 2 {
        setView(t, 150.0, 100.0, 1.5, math.pi / 6.0, round == 1)
        show(t)
        var by: i32 = 0
        while by * 16 < 200 {
            var bx: i32 = 0
            while bx * 16 < 300 {
                // (The last row of blocks is 8 pixels tall.)
                const bottom = if by * 16 + 16 > 200 { 200 } else { by * 16 + 16 }
                windowOf(t, @floatFromInt(f64, bx * 16) + 8.0, @floatFromInt(f64, by * 16 + bottom) / 2.0, &x, &y)
                const value = pixelAt(&t.*.a, x, y)
                if bx < 15 {
                    if !near(value, blockColor(bx, by), 3) {
                        mismatch("a block turned", x, y, value, blockColor(bx, by))
                        return 7 + @intCast(u8, round)
                    }
                } else if by * 16 < 96 {
                    if value != t.*.light && value != t.*.dark { return 9 + @intCast(u8, round) }
                } else {
                    const check = if (x >> 3) & 1 == (y >> 3) & 1 { t.*.light } else { t.*.dark }
                    if !near(value, pixel.over(check, SEMI, 255), 3) { return 11 + @intCast(u8, round) }
                }
                bx += 1
            }
            by += 1
        }
        if round == 0 { save(t, &t.*.a, "53-turn-30.png") }
        round += 1
    }
    return 0
}

// One image point back from the window pixel it is shown in.
fn roundTrip(t: *T, x: f64, y: f64) -> bool {
    const doc = docOf(t)
    var wx: i32 = 0
    var wy: i32 = 0
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    viewport.toWindow(&doc.*.view, x, y, &fx, &fy)
    wx = floorOf(fx)
    wy = floorOf(fy)
    if !ui.contains(doc.*.view.area, wx, wy) { return false }
    var input: state.Input = undefined
    canvasview.inputAt(t.*.app, doc, wx, wy, &input)
    const upright = doc.*.view.rotation == 0.0
    const reach = (if upright { 0.5 } else { 0.7072 }) / doc.*.view.zoom + 0.000001
    return absolute(input.x - x) <= reach && absolute(input.y - y) <= reach && input.windowX == wx && input.windowY == wy
}

fn checkInput(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    var rulers: usize = 0
    while rulers < 2 {
        docOf(t).*.showRulers = rulers == 1
        var round: usize = 0
        while round < 3 {
            if round == 0 { setView(t, 150.0, 100.0, 1.0, 0.0, false) }
            if round == 1 { setView(t, 150.0, 100.0, 2.0, 0.0, true) }
            if round == 2 { setView(t, 150.0, 100.0, 1.5, math.pi / 6.0, false) }
            show(t)
            const doc = docOf(t)
            const area = areaOf(t)
            const shrink: i32 = if rulers == 1 { canvasview.RULER } else { 0 }
            const wanted = ui.rect(area.x + shrink, area.y + shrink, area.width - shrink, area.height - shrink)
            if !geom.same(doc.*.view.area, wanted) || !geom.same(canvasview.imageArea(app, doc), wanted) { return 1 }
            const fail = @intCast(u8, 2 + rulers * 10 + round * 3)
            if !roundTrip(t, 5.5, 7.5) || !roundTrip(t, 150.0, 100.0) || !roundTrip(t, 37.25, 151.75) || !roundTrip(t, 299.75, 199.75) || !roundTrip(t, 0.1, 0.2) { return fail }
            // The pixel shown where a marker is clicked is the marker's.
            var input: state.Input = undefined
            var x: i32 = 0
            var y: i32 = 0
            windowOf(t, 230.5, 190.5, &x, &y)
            canvasview.inputAt(app, doc, x, y, &input)
            if floorOf(input.x) != 230 || floorOf(input.y) != 190 { return fail + 1 }
            if round < 2 && pixelAt(&t.*.a, x, y) != MAGENTA { return fail + 2 }
            if rulers == 1 && round == 0 {
                // The rulers' band is the panels' tone, not the ground.
                if pixelAt(&t.*.a, area.x + 2, area.y + 30) == t.*.ground || pixelAt(&t.*.a, area.x + 30, area.y + 2) == t.*.ground { return 30 }
                // The pointer's place is marked on both rulers (the canvas
                // holds the pointer, as during a stroke), and the marks
                // move with it, nothing left where they were.
                const mark = app.*.theme.accent | 0xFF000000
                app.*.pointerInside = true
                app.*.canvasGrab = true
                app.*.pointerX = x
                app.*.pointerY = y
                const first = canvasview.refresh(app, &t.*.a, area)
                if pixelAt(&t.*.a, x, area.y + 5) != mark || pixelAt(&t.*.a, area.x + 5, y) != mark || !covers(first, ui.rect(x, area.y + 5, 1, 1)) { return 31 }
                save(t, &t.*.a, "53-rulers.png")
                app.*.pointerX = x + 37
                app.*.pointerY = y - 21
                _ = canvasview.refresh(app, &t.*.a, area)
                if pixelAt(&t.*.a, x, area.y + 5) == mark || pixelAt(&t.*.a, x + 37, area.y + 5) != mark || pixelAt(&t.*.a, area.x + 5, y - 21) != mark { return 32 }
                app.*.canvasGrab = false
                app.*.pointerInside = false
                _ = canvasview.refresh(app, &t.*.a, area)
                reference(t)
                if !sameAsReference(t) { return 33 }
            }
            round += 1
        }
        rulers += 1
    }
    docOf(t).*.showRulers = false
    return 0
}

// Paints `area` of the blocks' layer in `color`, as a tool does.
fn paint(t: *T, area: geom.Rect, color: u32) -> void {
    const image = docOf(t).*.image
    const layer = image.*.active.?
    _ = ops.beginPixels(image, layer)
    _ = device.fill(layer.*.device.?, area, color)
    _ = ops.endPixels(image, layer, "Paint")
    api.imageChanged(t.*.app, area)
}

// After painting, refresh() draws only around the change and leaves what
// a fresh draw would.
fn checkRefresh(t: *T) -> u8 {
    const app = t.*.app
    var round: usize = 0
    while round < 4 {
        const fail = @intCast(u8, 1 + round * 6)
        if round == 0 {
            documents.show(app, t.*.blocks)
            setView(t, 150.0, 100.0, 1.0, 0.0, false)
        } else if round == 1 {
            setView(t, 150.0, 100.0, 1.5, math.pi / 6.0, false)
        } else if round == 2 {
            documents.show(app, t.*.fine)
            setView(t, 256.0, 128.0, 0.3, 0.0, false)
        } else {
            setView(t, 256.0, 128.0, 0.45, 0.4, true)
        }
        show(t)
        // Nothing changed: nothing to draw.
        if !ui.isEmpty(canvasview.refresh(app, &t.*.a, areaOf(t))) { return fail }
        const changed = if round < 2 { geom.rect(100, 50, 64, 64) } else { geom.rect(60 + @intCast(i32, round) * 70, 40, 70, 90) }
        const view = &docOf(t).*.view
        // Through the history: core/ops.mlx damages the tiles written.
        paint(t, changed, if round == 3 { 0x40FF8800 } else { 0xFF123456 })
        var drawn = canvasview.refresh(app, &t.*.a, areaOf(t))
        var window = ui.intersect(viewport.windowRectOf(view, changed), view.*.area)
        const tiles = geom.rect(changed.x & -64, changed.y & -64, ((changed.x + changed.width + 63) & -64) - (changed.x & -64), ((changed.y + changed.height + 63) & -64) - (changed.y & -64))
        if !covers(drawn, window) || !covers(geom.grown(viewport.windowRectOf(view, tiles), 6), drawn) { return fail + 1 }
        // Written straight into the layer, its place said exactly (as a
        // brush's marks are): that and little more.
        const exact = geom.rect(changed.x + 5, changed.y + 7, 21, 13)
        _ = device.fill(docOf(t).*.image.*.active.?.*.device.?, exact, if round == 3 { 0xC000FF88 } else { 0xFF654321 })
        api.imageChanged(app, exact)
        drawn = canvasview.refresh(app, &t.*.a, areaOf(t))
        window = ui.intersect(viewport.windowRectOf(view, exact), view.*.area)
        if !covers(drawn, window) { return fail + 2 }
        if drawn.width > window.width + 12 || drawn.height > window.height + 12 { return fail + 5 }
        reference(t)
        if !sameAsReference(t) { return fail + 3 }
        // Two changes, the second one far from the first.
        paint(t, geom.rect(10, 10, 3, 3), WHITE)
        paint(t, geom.rect(200, 150, 1, 1), BLACK)
        _ = canvasview.refresh(app, &t.*.a, areaOf(t))
        reference(t)
        if !sameAsReference(t) { return fail + 4 }
        round += 1
    }
    return 0
}

// The test tool's marks appear, keep to the canvas area, and go again.
fn checkMarks(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    marksKind = 0
    canvasview.setMarks(app, testMarks)
    fillCanvas(&t.*.a, UNTOUCHED)
    show(t)
    if !ui.isEmpty(canvasview.refresh(app, &t.*.a, areaOf(t))) { return 1 }
    var round: u32 = 1
    while round <= 2 {
        const fail = @intCast(u8, round * 10)
        marksKind = round
        const drawn = canvasview.refresh(app, &t.*.a, areaOf(t))
        // The rectangle's upper edge: a white line with a dark one below.
        var x: i32 = 0
        var y: i32 = 0
        windowOf(t, 90.0, 30.0, &x, &y)
        if pixelAt(&t.*.a, x, y) != WHITE { return fail }
        const below = pixelAt(&t.*.a, x, y + 1)
        if pixel.red(below) > 60 || pixel.green(below) > 60 || pixel.blue(below) > 60 || below >> 24 != 255 { return fail + 1 }
        // A handle at its corner, 7 pixels across: white inside, black rim.
        windowOf(t, 40.0, 30.0, &x, &y)
        if pixelAt(&t.*.a, x, y) != WHITE || pixelAt(&t.*.a, x - 3, y) != BLACK || pixelAt(&t.*.a, x + 3, y + 3) != BLACK || pixelAt(&t.*.a, x + 5, y + 5) == BLACK { return fail + 2 }
        // The dashed one: black and white.
        windowOf(t, 190.0, 130.0, &x, &y)
        var blacks: usize = 0
        var whites: usize = 0
        var at = x - 20
        while at < x + 20 {
            if pixelAt(&t.*.a, at, y) == BLACK { blacks += 1 }
            if pixelAt(&t.*.a, at, y) == WHITE { whites += 1 }
            at += 1
        }
        if blacks < 12 || whites < 12 { return fail + 3 }
        // Nothing outside the canvas area, though a line came from far.
        if !untouchedAround(&t.*.a, areaOf(t)) { return fail + 4 }
        // What refresh() named holds all of it: a fresh draw differs from
        // the canvas before the marks only there.
        reference(t)
        if !sameAsReference(t) { return fail + 6 }
        if round == 1 { save(t, &t.*.a, "53-marks.png") }
        if !covers(drawn, difference(t)) && round == 1 { return fail + 7 }
        round += 1
    }
    // The marks go: every pixel of them.
    marksKind = 0
    const gone = canvasview.refresh(app, &t.*.a, areaOf(t))
    if ui.isEmpty(gone) { return 30 }
    reference(t)
    if !sameAsReference(t) { return 31 }
    canvasview.setMarks(app, null)
    // On a canvas of no pixels nothing is drawn and nothing breaks.
    var nowhere = view_module.layoutCanvas()
    marksKind = 1
    canvasview.draw(app, &nowhere, areaOf(t))
    if !ui.isEmpty(canvasview.refresh(app, &nowhere, areaOf(t))) { return 32 }
    marksKind = 0
    return 0
}

fn select(t: *T, area: geom.Rect) -> void {
    const image = docOf(t).*.image
    ops.beginSelection(image)
    if !ui.isEmpty(area) { _ = device.fill(image.*.selection, area, mask.ALL) }
    ops.endSelection(image, !ui.isEmpty(area), "Select")
}

fn isInk(value: u32) -> bool { return value == BLACK || value == WHITE }

// How far window pixel (column, row)'s middle lies from the edge of image
// rectangle `area`, in window pixels.
fn fromEdge(t: *T, column: i32, row: i32, area: geom.Rect) -> f64 {
    const view = &docOf(t).*.view
    var x: f64 = 0.0
    var y: f64 = 0.0
    viewport.toImage(view, @floatFromInt(f64, column) + 0.5, @floatFromInt(f64, row) + 0.5, &x, &y)
    const left = @floatFromInt(f64, area.x)
    const top = @floatFromInt(f64, area.y)
    const right = @floatFromInt(f64, area.x + area.width)
    const bottom = @floatFromInt(f64, area.y + area.height)
    var dx: f64 = 0.0
    var dy: f64 = 0.0
    if x < left { dx = left - x }
    if x > right { dx = x - right }
    if y < top { dy = top - y }
    if y > bottom { dy = y - bottom }
    var distance = @sqrt(dx * dx + dy * dy)
    if dx == 0.0 && dy == 0.0 { distance = math.min(math.min(x - left, right - x), math.min(y - top, bottom - y)) }
    return distance * view.*.zoom
}

fn checkAnts(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    const chosen = geom.rect(50, 40, 100, 80)
    select(t, chosen)
    app.*.time = 120000
    show(t)
    if !canvasview.animating(app) { return 1 }
    var x0: i32 = 0
    var y0: i32 = 0
    var x1: i32 = 0
    var y1: i32 = 0
    windowOf(t, 50.0, 40.0, &x0, &y0)
    windowOf(t, 150.0, 120.0, &x1, &y1)
    var blacks: usize = 0
    var whites: usize = 0
    var at = x0
    while at <= x1 {
        if !isInk(pixelAt(&t.*.a, at, y0)) || !isInk(pixelAt(&t.*.a, at, y1)) { return 2 }
        if pixelAt(&t.*.a, at, y0) == BLACK { blacks += 1 } else { whites += 1 }
        at += 1
    }
    at = y0
    while at <= y1 {
        if !isInk(pixelAt(&t.*.a, x0, at)) || !isInk(pixelAt(&t.*.a, x1, at)) { return 3 }
        at += 1
    }
    if blacks < 40 || whites < 40 { return 4 }
    // Off the edge the image shows.
    if pixelAt(&t.*.a, x0 + 1, y0 + 1) != expectedAt(t, x0 + 1, y0 + 1) || pixelAt(&t.*.a, x0 - 1, y0 - 1) != expectedAt(t, x0 - 1, y0 - 1) { return 5 }
    save(t, &t.*.a, "53-ants.png")
    // Nothing more within the same step: nothing to draw.
    app.*.time += 50
    if !ui.isEmpty(canvasview.refresh(app, &t.*.a, areaOf(t))) { return 6 }
    // A step later they moved.
    var before: [128]u32 = undefined
    at = 0
    while at < 100 {
        before[@intCast(usize, at)] = pixelAt(&t.*.a, x0 + at, y0)
        at += 1
    }
    app.*.time += 120
    const drawn = canvasview.refresh(app, &t.*.a, areaOf(t))
    if !covers(drawn, ui.rect(x0, y0, x1 - x0 + 1, y1 - y0 + 1)) { return 7 }
    var moved: usize = 0
    at = 0
    while at < 100 {
        const now = pixelAt(&t.*.a, x0 + at, y0)
        if !isInk(now) { return 8 }
        if now != before[@intCast(usize, at)] { moved += 1 }
        at += 1
    }
    if moved < 10 { return 9 }
    reference(t)
    if !sameAsReference(t) { return 10 }

    // At zoom 2 and turned: only near the edge, and all along it.
    var round: usize = 0
    while round < 2 {
        const fail = @intCast(u8, 11 + round * 4)
        if round == 0 { setView(t, 120.0, 90.0, 2.0, 0.0, false) } else { setView(t, 120.0, 90.0, 1.5, math.pi / 6.0, true) }
        show(t)
        docOf(t).*.showSelection = false
        reference(t)
        docOf(t).*.showSelection = true
        const inner = docOf(t).*.view.area
        var touched: usize = 0
        var row = inner.y
        while row < inner.y + inner.height {
            var column = inner.x
            while column < inner.x + inner.width {
                if pixelAt(&t.*.a, column, row) != pixelAt(&t.*.b, column, row) {
                    if fromEdge(t, column, row, chosen) > 2.0 { return fail }
                    touched += 1
                }
                column += 1
            }
            row += 1
        }
        // The middles of the four edges have ants.
        var side: usize = 0
        while side < 4 {
            const mx: f64 = if side == 0 { 100.0 } else if side == 1 { 150.0 } else if side == 2 { 100.0 } else { 50.0 }
            const my: f64 = if side == 0 { 40.0 } else if side == 1 { 80.0 } else if side == 2 { 120.0 } else { 80.0 }
            var cx: i32 = 0
            var cy: i32 = 0
            windowOf(t, mx, my, &cx, &cy)
            var found = false
            var dy: i32 = -1
            while dy <= 1 {
                var dx: i32 = -1
                while dx <= 1 {
                    if pixelAt(&t.*.a, cx + dx, cy + dy) != pixelAt(&t.*.b, cx + dx, cy + dy) { found = true }
                    dx += 1
                }
                dy += 1
            }
            if !found { return fail + 1 }
            side += 1
        }
        if touched < 300 { return fail + 2 }
        if round == 1 { save(t, &t.*.a, "53-ants-turned.png") }
        // The canvas still shows the ants: the reference went to b only.
        round += 1
    }
    // Nothing selected: they are gone.
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    show(t)
    select(t, geom.empty())
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    if canvasview.animating(app) { return 20 }
    reference(t)
    if !sameAsReference(t) { return 21 }
    return 0
}

// The columns of row `row` where canvases a and b differ lie this far
// apart at least (a large number when fewer than two).
fn closestLines(t: *T, row: i32, from: i32, to: i32) -> i32 {
    var last: i32 = -1000
    var closest: i32 = 1000000
    var column = from
    while column < to {
        if pixelAt(&t.*.a, column, row) != pixelAt(&t.*.b, column, row) {
            if column - last < closest { closest = column - last }
            last = column
        }
        column += 1
    }
    return closest
}

fn checkGrid(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    const doc = docOf(t)
    doc.*.gridX = 32
    doc.*.gridY = 32
    doc.*.gridOffsetX = 0
    doc.*.gridOffsetY = 0
    doc.*.gridDivisions = 2
    doc.*.guidesDown[0] = 100
    doc.*.guidesDownCount = 1
    doc.*.guidesAcross[0] = 150
    doc.*.guidesAcrossCount = 1
    doc.*.showGrid = false
    doc.*.showGuides = false
    reference(t)
    doc.*.showGrid = true
    doc.*.showGuides = true
    show(t)
    // Along image row 8: the lines at every 16 pixels (32 and the
    // parts between), the guide at 100, nothing else.
    var x: i32 = 0
    var y: i32 = 0
    windowOf(t, 0.0, 8.5, &x, &y)
    var column = x
    var count: i32 = 0
    while column < x + 300 {
        const line_x = imageColumn(t, column)
        const on_line = line_x > 0 && line_x % 16 == 0 && imageColumn(t, column - 1) != line_x
        const on_guide = line_x == 100 && imageColumn(t, column - 1) != line_x
        const differs = pixelAt(&t.*.a, column, y) != pixelAt(&t.*.b, column, y)
        if differs != (on_line || on_guide) { return 1 }
        if differs { count += 1 }
        column += 1
    }
    if count != 19 { return 2 }
    // A main line is stronger than a part between.
    windowOf(t, 32.0, 8.5, &x, &y)
    const main = pixelAt(&t.*.a, x, y)
    windowOf(t, 16.0, 8.5, &x, &y)
    const part = pixelAt(&t.*.a, x, y)
    if near(main, blockColor(2, 0), 20) || near(main, part, 4) { return 3 }
    // The guides go through the ground too; the grid stays on the image.
    windowOf(t, 100.0, -10.0, &x, &y)
    if pixelAt(&t.*.a, x, y) == t.*.ground { return 4 }
    windowOf(t, 32.0, -10.0, &x, &y)
    if pixelAt(&t.*.a, x, y) != t.*.ground { return 5 }
    windowOf(t, -10.0, 150.0, &x, &y)
    if pixelAt(&t.*.a, x, y) == t.*.ground { return 6 }
    save(t, &t.*.a, "53-grid.png")
    // Far out the lines are thinned out to 4 window pixels apart at least.
    var round: usize = 0
    while round < 2 {
        const zoom: f64 = if round == 0 { 0.25 } else { 0.11 }
        doc.*.gridX = 8
        doc.*.gridY = 8
        doc.*.gridDivisions = 4
        setView(t, 150.0, 100.0, zoom, 0.0, false)
        doc.*.showGrid = false
        doc.*.showGuides = false
        reference(t)
        doc.*.showGrid = true
        show(t)
        windowOf(t, 0.0, 30.5, &x, &y)
        if closestLines(t, y, x, x + 34) < 4 { return 7 + @intCast(u8, round) }
        if difference(t).width < 20 { return 9 + @intCast(u8, round) }
        round += 1
    }
    doc.*.showGrid = false
    doc.*.showGuides = true
    doc.*.guidesDownCount = 0
    doc.*.guidesAcrossCount = 0
    return 0
}

// The view commands.
fn checkCommands(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    show(t)
    const view = &docOf(t).*.view
    const inner = view.*.area
    // The pointer over the canvas, away from its middle.
    const px = inner.x + inner.width / 2 - 123
    const py = inner.y + inner.height / 2 + 57
    var text: [80]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 80, "pointer ")
    length = std.text.appendSigned(bytes, length, 80, @intCast(isize, px))
    length = std.text.append(bytes, length, 80, " ")
    length = std.text.appendSigned(bytes, length, 80, @intCast(isize, py))
    length = std.text.append(bytes, length, 80, "\n")
    if !script.run(app, bytes[0..length]) { return 1 }
    useArea(t)
    show(t)
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    viewport.toImage(view, @floatFromInt(f64, px) + 0.5, @floatFromInt(f64, py) + 0.5, &x0, &y0)
    const up = [5]f64{ 2.0, 3.0, 4.0, 6.0, 8.0 }
    var step: usize = 0
    while step < 5 {
        app.*.fullRedraw = false
        canvasview.zoomIn(app)
        if view.*.zoom != up[step] || !app.*.fullRedraw { return 2 }
        // (A frame between the steps, as the program draws one.)
        show(t)
        var x: f64 = 0.0
        var y: f64 = 0.0
        viewport.toImage(view, @floatFromInt(f64, px) + 0.5, @floatFromInt(f64, py) + 0.5, &x, &y)
        if absolute(x - x0) > 0.000001 || absolute(y - y0) > 0.000001 { return 3 }
        step += 1
    }
    view.*.zoom = 1.0
    view.*.centerX = 150.0
    view.*.centerY = 100.0
    const down = [8]f64{ 2.0 / 3.0, 0.5, 1.0 / 3.0, 0.25, 1.0 / 6.0, 0.125, 1.0 / 12.0, 0.0625 }
    step = 0
    while step < 8 {
        canvasview.zoomOut(app)
        if absolute(view.*.zoom - down[step]) > 0.0000001 { return 4 }
        show(t)
        var x: f64 = 0.0
        var y: f64 = 0.0
        viewport.toImage(view, @floatFromInt(f64, px) + 0.5, @floatFromInt(f64, py) + 0.5, &x, &y)
        if absolute(x - x0) > 0.000001 || absolute(y - y0) > 0.000001 { return 5 }
        step += 1
    }
    // Between two steps: to the next.
    view.*.zoom = 0.98
    canvasview.zoomIn(app)
    if view.*.zoom != 1.0 { return 6 }
    view.*.zoom = 0.98
    canvasview.zoomOut(app)
    if absolute(view.*.zoom - 2.0 / 3.0) > 0.0000001 { return 7 }
    // The pointer elsewhere: about the middle.
    app.*.pointerInside = false
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    const mx = @floatFromInt(f64, inner.x) + @floatFromInt(f64, inner.width) / 2.0
    const my = @floatFromInt(f64, inner.y) + @floatFromInt(f64, inner.height) / 2.0
    viewport.toImage(view, mx, my, &x0, &y0)
    canvasview.zoomIn(app)
    var x: f64 = 0.0
    var y: f64 = 0.0
    viewport.toImage(view, mx, my, &x, &y)
    if view.*.zoom != 2.0 || absolute(x - x0) > 0.000001 || absolute(y - y0) > 0.000001 { return 8 }
    canvasview.zoomTo(app, 4.0)
    if view.*.zoom != 4.0 { return 9 }
    canvasview.actualSize(app)
    if view.*.zoom != 1.0 { return 10 }

    // The whole image in the area, a margin of 24 on the side that
    // limits it.
    app.*.fullRedraw = false
    canvasview.fitPage(app)
    if !app.*.fullRedraw { return 11 }
    show(t)
    var left: f64 = 0.0
    var top: f64 = 0.0
    var right: f64 = 0.0
    var bottom: f64 = 0.0
    viewport.toWindow(view, 0.0, 0.0, &left, &top)
    viewport.toWindow(view, 300.0, 200.0, &right, &bottom)
    const gap_x = left - @floatFromInt(f64, inner.x)
    const gap_y = top - @floatFromInt(f64, inner.y)
    if gap_x < 23.9 || gap_y < 23.9 || right > @floatFromInt(f64, inner.x + inner.width) - 23.9 || bottom > @floatFromInt(f64, inner.y + inner.height) - 23.9 { return 12 }
    if absolute(gap_x - 24.0) > 0.01 && absolute(gap_y - 24.0) > 0.01 { return 13 }
    if checkUpright(t, &t.*.a, false) != 0 { return 14 }
    canvasview.fitWidth(app)
    viewport.toWindow(view, 0.0, 0.0, &left, &top)
    viewport.toWindow(view, 300.0, 200.0, &right, &bottom)
    if absolute(left - @floatFromInt(f64, inner.x) - 24.0) > 0.01 || absolute(@floatFromInt(f64, inner.x + inner.width) - right - 24.0) > 0.01 { return 15 }

    // Turning in steps of 15 degrees, and back; mirroring; moving.
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    canvasview.rotateBy(app, math.pi / 12.0)
    canvasview.rotateBy(app, math.pi / 12.0)
    if absolute(view.*.rotation - math.pi / 6.0) > 0.0000001 { return 16 }
    canvasview.rotateBy(app, -math.pi / 6.0)
    if view.*.rotation != 0.0 { return 17 }
    canvasview.rotateBy(app, 1.0)
    canvasview.resetRotation(app)
    if view.*.rotation != 0.0 { return 18 }
    canvasview.toggleMirror(app)
    if !view.*.mirror { return 19 }
    canvasview.toggleMirror(app)
    if view.*.mirror { return 20 }
    viewport.toWindow(view, 0.0, 0.0, &left, &top)
    canvasview.panBy(app, 10.0, -4.0)
    viewport.toWindow(view, 0.0, 0.0, &right, &bottom)
    if absolute(right - left - 10.0) > 0.000001 || absolute(bottom - top + 4.0) > 0.000001 { return 21 }
    return 0
}

// The light look: the ground darker than the panels, the line and the
// checker still to be told apart.
fn checkLight(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    // The desktop turns light: the next frame takes the light look.
    app.*.shell.*.lightness = 1024
    api.redraw(app)
    if !script.run(app, "wait 1\n") { return 1 }
    useArea(t)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    docOf(t).*.showRulers = true
    select(t, geom.rect(20, 120, 60, 50))
    show(t)
    const inner = docOf(t).*.view.area
    const ground = pixelAt(&t.*.a, inner.x + 2, inner.y + 2)
    if ground == t.*.ground || pixel.luma(ground) >= pixel.luma(app.*.theme.panel) || pixel.luma(ground) < 100 { return 2 }
    var x: i32 = 0
    var y: i32 = 0
    windowOf(t, 0.0, 100.0, &x, &y)
    if pixelAt(&t.*.a, x - 1, y) == ground { return 3 }
    save(t, &t.*.a, "53-light.png")
    app.*.shell.*.lightness = 0
    api.redraw(app)
    if !script.run(app, "wait 1\n") { return 4 }
    useArea(t)
    select(t, geom.empty())
    docOf(t).*.showRulers = false
    show(t)
    windowOf(t, 0.0, 100.0, &x, &y)
    if pixelAt(&t.*.a, x - 1, y) != t.*.rim || pixelAt(&t.*.a, x - 2, y) != t.*.ground {
        mismatch("the line around the image, dark again", x - 1, y, pixelAt(&t.*.a, x - 1, y), t.*.rim)
        return 5
    }
    return 0
}

// Frames drawn and refreshed, with marks, ants and paint, leave the value
// arena as they found it.
fn checkArena(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 1.25, 0.2, false)
    select(t, geom.rect(30, 30, 120, 90))
    canvasview.setMarks(app, testMarks)
    marksKind = 1
    show(t)
    var loop: turns.Turns = undefined
    turns.begin(&loop, true, false)
    const arena = loop.base
    const mark = turns.used(arena)
    var first: usize = 0
    var last: usize = 0
    var round: usize = 0
    while round < 300 {
        turns.turn(&loop)
        app.*.time += 40
        if round % 10 == 3 { paint(t, geom.rect(@intCast(i32, round % 250), 60, 9, 9), 0xFF000000 | @intCast(u32, round * 50001)) }
        if round % 25 == 7 { docOf(t).*.view.centerX += 1.0 }
        if round % 3 == 0 { show(t) } else { _ = canvasview.refresh(app, &t.*.a, areaOf(t)) }
        last = turns.used(arena) - mark
        if round == 1 { first = last }
        if last > 1048576 { return 1 }
        round += 1
    }
    const off = if last > first { last - first } else { first - last }
    if off > 65536 { return 2 }
    turns.turn(&loop)
    if turns.used(arena) != mark { return 3 }
    marksKind = 0
    canvasview.setMarks(app, null)
    select(t, geom.empty())
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 4 }
    return 0
}

// forget() gives back what the record took.
fn checkForget(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.fine)
    setView(t, 256.0, 128.0, 0.3, 0.3, false)
    select(t, geom.rect(10, 10, 100, 100))
    show(t)
    canvasview.forget(app, docOf(t))
    if docOf(t).*.viewData != 0 { return 1 }
    const before = std.heap.liveBytes()
    show(t)
    if docOf(t).*.viewData == 0 || std.heap.liveBytes() <= before { return 2 }
    canvasview.forget(app, docOf(t))
    if std.heap.liveBytes() != before { return 3 }
    canvasview.forget(app, docOf(t))
    select(t, geom.empty())
    return 0
}

// ---------------------------------------------------------------------------
// Edges: sizes, places and values where such code breaks

// A document of `width` x `height` all in `color` (straight), put in
// front; false without memory.
fn plain(t: *T, width: i32, height: i32, color: u32) -> bool {
    const app = t.*.app
    const made = image_module.create(app.*.allocator, width, height, 72.0)
    if made == null { return false }
    const layer = ops.newLayer(made.?, node.PAINT, "Plain", "New layer")
    if layer == null { return false }
    _ = device.fill(layer.?.*.device.?, geom.rect(0, 0, width, height), color)
    image_module.damageAll(made.?)
    if documents.add(app, made.?, "Plain") == null { return false }
    useArea(t)
    return true
}

// The document in front closed, its view's record let go first.
fn closeFront(t: *T) -> void {
    const app = t.*.app
    canvasview.forget(app, docOf(t))
    documents.close(app, app.*.current)
}

// The window pixels of canvas a around the image of the document in
// front: those whose middle lies `deep` window pixels or more inside the
// image show `color` (straight) over the window's checker, every channel
// within `reach`; those whose middle lies `far` or more outside it (the
// larger of the distances across and down when `square`, else the
// straight distance) show the ground. 0 when so, else 1 (the image) or
// 2 (the ground); `seen` counts the pixels inside.
fn checkPlain(t: *T, color: u32, reach: u32, deep: f64, far: f64, square: bool, seen: *usize) -> u8 {
    const doc = docOf(t)
    const view = &doc.*.view
    const width = @floatFromInt(f64, doc.*.image.*.width)
    const height = @floatFromInt(f64, doc.*.image.*.height)
    const around = ui.intersect(geom.grown(viewport.windowRectOf(view, image_module.bounds(doc.*.image)), 6), view.*.area)
    var row = around.y
    while row < around.y + around.height {
        var column = around.x
        while column < around.x + around.width {
            var x: f64 = 0.0
            var y: f64 = 0.0
            viewport.toImage(view, @floatFromInt(f64, column) + 0.5, @floatFromInt(f64, row) + 0.5, &x, &y)
            const shown = pixelAt(&t.*.a, column, row)
            if x >= 0.0 && x < width && y >= 0.0 && y < height {
                const depth = math.min(math.min(x, width - x), math.min(y, height - y)) * view.*.zoom
                if depth >= deep {
                    const check = if (column >> 3) & 1 == (row >> 3) & 1 { t.*.light } else { t.*.dark }
                    const wanted = if color >> 24 == 255 { color } else { pixel.over(check, color, 255) }
                    if !near(shown, wanted, reach) {
                        mismatch("a plain image", column, row, shown, wanted)
                        return 1
                    }
                    seen.* += 1
                }
            } else {
                var dx: f64 = 0.0
                var dy: f64 = 0.0
                if x < 0.0 { dx = -x }
                if x >= width { dx = x - width }
                if y < 0.0 { dy = -y }
                if y >= height { dy = y - height }
                const out = (if square { math.max(dx, dy) } else { @sqrt(dx * dx + dy * dy) }) * view.*.zoom
                if out >= far && shown != t.*.ground {
                    mismatch("the ground beside a plain image", column, row, shown, t.*.ground)
                    return 2
                }
            }
            column += 1
        }
        row += 1
    }
    return 0
}

// Images of one colour at sizes around the tiles of 64 and the smaller
// pictures' halvings (1 x 1, 63 x 65, 64 x 64, 129 x 127, 200 x 131),
// opaque and half transparent, at zooms 0.7 down to 0.011 and up to 256,
// upright, mirrored and turned: inside they are that colour to the edge
// (nothing transparent mixed in from beyond the image, at no level and
// no tile border), beside them the ground.
fn checkPlainSizes(t: *T) -> u8 {
    const sizes = [10]i32{ 1, 1, 63, 65, 64, 64, 129, 127, 200, 131 }
    const zooms = [7]f64{ 0.7, 0.3, 0.12, 0.05, 0.011, 3.7, 256.0 }
    var size: usize = 0
    while size < 5 {
        const width = sizes[size * 2]
        const height = sizes[size * 2 + 1]
        if !plain(t, width, height, 0xFF3C78B4) { return 1 }
        // (No pixel grid at 256: the colour alone.)
        canvasview.setPixelGrid(t.*.app, false)
        var shade: usize = 0
        while shade < 2 {
            const color: u32 = if shade == 0 { 0xFF3C78B4 } else { SEMI }
            if shade == 1 {
                const layer = docOf(t).*.image.*.active.?
                _ = device.fill(layer.*.device.?, geom.rect(0, 0, width, height), SEMI)
                api.imageChanged(t.*.app, geom.rect(0, 0, width, height))
            }
            var seen: usize = 0
            var zoom: usize = 0
            while zoom < 7 {
                var way: usize = 0
                while way < 3 {
                    setView(t, @floatFromInt(f64, width) / 2.0, @floatFromInt(f64, height) / 2.0, zooms[zoom], if way == 2 { math.pi / 6.0 } else { 0.0 }, way == 1)
                    show(t)
                    const reach: u32 = if shade == 0 { 0 } else { 2 }
                    const failed = if way < 2 { checkPlain(t, color, reach, 0.0, 1.000001, true, &seen) } else { checkPlain(t, color, reach, 1.0, 2.5, false, &seen) }
                    if failed != 0 {
                        _ = std.io.print("53_canvasview: plain image ")
                        _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, width))
                        _ = std.io.print(" x ")
                        _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, height))
                        _ = std.io.print(", zoom number ")
                        _ = std.io.writeUnsigned(std.io.stdout(), zoom)
                        _ = std.io.print(", view ")
                        _ = std.io.writeUnsigned(std.io.stdout(), way)
                        _ = std.io.print("\n")
                        return 1 + failed
                    }
                    way += 1
                }
                zoom += 1
            }
            // At 256 even the single pixel fills a large square.
            if seen < 60000 { return 4 }
            shade += 1
        }
        closeFront(t)
        size += 1
    }
    return 0
}

// Areas of a few pixels, an area partly outside the window, rulers that
// do not fit: nothing breaks, nothing outside the area is drawn, and
// what is drawn is what a fresh draw gives.
fn checkAreas(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    docOf(t).*.showRulers = true
    const areas = [24]i32{ 300, 200, 1, 1, 301, 203, 2, 3, 100, 100, 60, 60, 100, 100, 61, 61, 400, 300, 3, 250, -37, -21, 1100, 760 }
    var index: usize = 0
    while index < 6 {
        const area = ui.rect(areas[index * 4], areas[index * 4 + 1], areas[index * 4 + 2], areas[index * 4 + 3])
        app.*.canvasArea = area
        var round: usize = 0
        while round < 3 {
            if round == 0 { setView(t, 150.0, 100.0, 1.0, 0.0, false) }
            if round == 1 { setView(t, 150.0, 100.0, 0.3, 0.0, true) }
            if round == 2 { setView(t, 150.0, 100.0, 2.5, 0.7, false) }
            fillCanvas(&t.*.a, UNTOUCHED)
            show(t)
            if !untouchedAround(&t.*.a, area) { return 1 }
            // The rulers only where there is room for them.
            const inner = docOf(t).*.view.area
            const ruled = area.width > canvasview.RULER * 3 && area.height > canvasview.RULER * 3
            const wanted = if ruled { ui.rect(area.x + canvasview.RULER, area.y + canvasview.RULER, area.width - canvasview.RULER, area.height - canvasview.RULER) } else { area }
            if !geom.same(inner, wanted) || !geom.same(canvasview.imageArea(app, docOf(t)), wanted) { return 2 }
            paint(t, geom.rect(140, 90, 20, 20), 0xFF000000 | @intCast(u32, index * 40 + round * 9))
            const drawn = canvasview.refresh(app, &t.*.a, area)
            if !covers(ui.intersect(area, ui.rect(0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))), drawn) { return 3 }
            if !untouchedAround(&t.*.a, area) { return 4 }
            reference(t)
            if !sameInside(t, area) { return 5 }
            round += 1
        }
        // Partly outside the window: the image where the window shows it,
        // the checker anchored to the window.
        if index == 5 {
            setView(t, 150.0, 100.0, 1.0, 0.0, false)
            show(t)
            var row: i32 = 0
            while row < @intCast(i32, HEIGHT) {
                var column: i32 = 0
                while column < @intCast(i32, WIDTH) {
                    if imageColumn(t, column) >= 0 && imageColumn(t, column) < 300 && imageRow(t, row) >= 0 && imageRow(t, row) < 200 {
                        if pixelAt(&t.*.a, column, row) != expectedAt(t, column, row) { return 6 }
                    }
                    column += 1
                }
                row += 1
            }
        }
        index += 1
    }
    docOf(t).*.showRulers = false
    useArea(t)
    return 0
}

// Canvases a and b are the same where `area` is in the window.
fn sameInside(t: *T, area: ui.Rect) -> bool {
    const shown = ui.intersect(area, ui.rect(0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT)))
    var row = shown.y
    while row < shown.y + shown.height {
        var column = shown.x
        while column < shown.x + shown.width {
            if pixelAt(&t.*.a, column, row) != pixelAt(&t.*.b, column, row) { return false }
            column += 1
        }
        row += 1
    }
    return true
}

// The smaller pictures kept while the view is elsewhere: a change made at
// zoom 1 (at tile borders of 64 and 128), many changes (more than the
// image remembers), a change while a layer's change is open, a moved
// layer, all show at zoom 0.12 and 0.05 as a fresh draw does; so does a
// refresh at zoom 8 with the pixel grid, the document's grid, guides and
// rulers on.
fn checkLevelsKept(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.fine)
    setView(t, 256.0, 128.0, 0.12, 0.0, false)
    show(t)
    setView(t, 256.0, 128.0, 1.0, 0.0, false)
    show(t)
    paint(t, geom.rect(127, 127, 3, 3), WHITE)
    show(t)
    paint(t, geom.rect(255, 64, 1, 1), 0xFF00C000)
    paint(t, geom.rect(0, 0, 1, 1), 0xFF00C000)
    paint(t, geom.rect(511, 255, 1, 1), 0x00000000)
    show(t)
    setView(t, 256.0, 128.0, 0.12, 0.0, false)
    show(t)
    reference(t)
    if !sameAsReference(t) { return 1 }
    // More changes than the image keeps (each brought into the
    // projection on its own, as another viewer would).
    setView(t, 256.0, 128.0, 1.0, 0.0, false)
    show(t)
    var round: i32 = 0
    while round < 20 {
        paint(t, geom.rect(round * 25, round * 12, 7, 5), 0xFF000000 | @intCast(u32, round * 12345))
        _ = render.update(docOf(t).*.image)
        round += 1
    }
    setView(t, 256.0, 128.0, 0.12, 0.0, false)
    show(t)
    reference(t)
    if !sameAsReference(t) { return 2 }
    // Turned and mirrored far out (the sixteenth), a change refreshed.
    setView(t, 256.0, 128.0, 0.05, 0.9, true)
    show(t)
    paint(t, geom.rect(383, 200, 2, 2), 0xFFFFFF00)
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 3 }
    // A change shown while the layer's change is still open, then closed.
    setView(t, 256.0, 128.0, 0.3, 0.0, false)
    show(t)
    const image = docOf(t).*.image
    const layer = image.*.active.?
    _ = ops.beginPixels(image, layer)
    _ = device.fill(layer.*.device.?, geom.rect(190, 60, 70, 40), 0x80FF0000)
    api.imageChanged(app, geom.rect(190, 60, 70, 40))
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 4 }
    _ = ops.endPixels(image, layer, "Paint")
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 5 }
    // The layer moved (its device sits elsewhere): what it showed moves.
    device.moveTo(layer.*.device.?, 13, -7)
    api.imageChanged(app, image_module.bounds(image))
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 6 }
    device.moveTo(layer.*.device.?, 0, 0)
    api.imageChanged(app, image_module.bounds(image))
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 7 }
    // Zoom 8: the pixel grid, the grid, guides and rulers, refreshed.
    const doc = docOf(t)
    doc.*.showRulers = true
    doc.*.showGrid = true
    doc.*.gridX = 5
    doc.*.gridY = 3
    doc.*.gridDivisions = 2
    doc.*.guidesDown[0] = 133
    doc.*.guidesDownCount = 1
    doc.*.guidesAcross[0] = 62
    doc.*.guidesAcrossCount = 1
    canvasview.setPixelGrid(app, true)
    setView(t, 140.0, 60.0, 8.0, 0.0, false)
    show(t)
    paint(t, geom.rect(130, 60, 5, 3), 0xFF2040FF)
    const drawn = canvasview.refresh(app, &t.*.a, areaOf(t))
    const window = viewport.windowRectOf(&doc.*.view, geom.rect(130, 60, 5, 3))
    if !covers(drawn, window) { return 8 }
    reference(t)
    if !sameAsReference(t) { return 9 }
    // The same turned.
    setView(t, 140.0, 60.0, 8.0, -0.6, false)
    show(t)
    paint(t, geom.rect(134, 61, 4, 4), 0xFFFF4020)
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 10 }
    doc.*.showRulers = false
    doc.*.showGrid = false
    doc.*.guidesDownCount = 0
    doc.*.guidesAcrossCount = 0
    return 0
}

// A document changed while another is in front shows its change when it
// comes back (its smaller pictures were not kept stale).
fn checkTwoDocuments(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 0.3, 0.0, false)
    show(t)
    documents.show(app, t.*.fine)
    useArea(t)
    show(t)
    const image = app.*.documents[t.*.blocks].?.*.image
    _ = device.fill(image.*.active.?.*.device.?, geom.rect(30, 40, 50, 60), 0xFFFFFFFF)
    image_module.damage(image, geom.rect(30, 40, 50, 60))
    // Another viewer (the overview) brings the projection up to date.
    _ = render.update(image)
    show(t)
    documents.show(app, t.*.blocks)
    useArea(t)
    show(t)
    reference(t)
    if !sameAsReference(t) { return 1 }
    // And back to zoom 1: the change is there too.
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    show(t)
    var x: i32 = 0
    var y: i32 = 0
    windowOf(t, 55.5, 70.5, &x, &y)
    if pixelAt(&t.*.a, x, y) != WHITE { return 2 }
    return 0
}

// The rectangle of canvas a's pixels that are not UNTOUCHED.
fn drawnArea(t: *T) -> ui.Rect {
    var found = geom.empty()
    var row: i32 = 0
    while row < @intCast(i32, HEIGHT) {
        const line = t.*.a.pixels + @intCast(usize, row) * WIDTH
        var column: i32 = 0
        while column < @intCast(i32, WIDTH) {
            if line[@intCast(usize, column)] != UNTOUCHED { found = geom.unite(found, ui.rect(column, row, 1, 1)) }
            column += 1
        }
        row += 1
    }
    return found
}

fn floatOf(bits: u64) -> f64 { return @bitCast(f64, bits) }

// One mark of the overlay, numbered `which`; false when there are no
// more.
fn oneMark(p: *const overlay.Painter, which: usize) -> bool {
    const nan = floatOf(0x7FF8000000000000)
    const infinite = floatOf(0x7FF0000000000000)
    if which == 0 { overlay.line(p, 10.0, 10.0, 200.0, 10.3) }
    if which == 1 { overlay.line(p, 10.0, 10.0, 10.0004, 150.0) }
    if which == 2 { overlay.line(p, 10.0, 10.0, 150.0, 150.0) }
    if which == 3 { overlay.line(p, 5.5, 3.25, 7.75, 190.5) }
    if which == 4 { overlay.line(p, -100000000000.0, 50.0, 100000000000.0, 50.5) }
    if which == 5 { overlay.line(p, 100.0, -5000.0, 100.0, 5000.0) }
    if which == 6 { overlay.line(p, nan, 3.0, 40.0, 40.0) }
    if which == 7 { overlay.line(p, 3.0, infinite, 40.0, 40.0) }
    if which == 8 { overlay.rect(p, 20.25, 30.5, 0.0, 0.0) }
    if which == 9 { overlay.rect(p, 120.0, 80.0, -50.5, -30.25) }
    if which == 10 { overlay.dashedRect(p, -10.0, -10.0, 320.0, 220.0) }
    if which == 11 { overlay.circle(p, 100.0, 100.0, 0.0) }
    if which == 12 { overlay.circle(p, 100.0, 100.0, 0.4) }
    if which == 13 { overlay.circle(p, 3.0, 5.0, 300.0) }
    if which == 14 { overlay.circle(p, 3.0, 5.0, 1000000000.0) }
    if which == 15 { overlay.circle(p, 3.0, 5.0, -4.0) }
    if which == 16 { overlay.ellipse(p, 100.0, 100.0, 0.0, 30.0) }
    if which == 17 { overlay.ellipse(p, 100.0, 100.0, 1000000.0, 2.0) }
    if which == 18 { overlay.ellipse(p, 100.0, 100.0, 50.0, 25.0) }
    if which == 19 { overlay.ellipse(p, 100.0, 100.0, nan, 25.0) }
    if which == 20 { overlay.handle(p, -2.0, -1.0, overlay.SQUARE, true) }
    if which == 21 { overlay.handle(p, 300.0, 200.0, overlay.ROUND, false) }
    if which == 22 { overlay.handle(p, 0.0, 200.0, overlay.DIAMOND, true) }
    if which == 23 { overlay.handle(p, 0.0, 200.0, 7, false) }
    if which == 24 { overlay.cross(p, 299.9, -0.2) }
    if which == 25 { overlay.polyline(p, &polygon, 0, true) }
    if which == 26 { overlay.polyline(p, &polygon, 1, true) }
    if which == 27 { overlay.polyline(p, &polygon, 2, true) }
    if which == 28 { overlay.polyline(p, &polygon, 4, false) }
    if which == 29 { overlay.outline(p, 290.0, 195.0, &tip, 6) }
    if which == 30 { overlay.label(p, 299.0, 199.0, "1024 x 768 px") }
    if which == 31 { overlay.label(p, 10.0, 10.0, "") }
    if which == 32 { overlay.label(p, 10.0, 10.0, "a label far too long for the part of the window the marks may go to, so long that it is left out, and longer still: twice as long as it would have to be to be left out") }
    if which == 33 { overlay.windowLine(p, -50.0, 100.0, 2000.0, 400.0) }
    if which == 34 { overlay.windowRect(p, 500.0, 300.0, -40.0, -20.0) }
    if which == 35 { overlay.antsLine(p, 0.0, 100.0, 300.0, 100.0) }
    if which == 36 { overlay.plainLine(p, 0.0, 30.0, 300.0, 170.0, 0) }
    if which == 37 { overlay.plainLine(p, 0.0, 30.0, 300.0, 170.0, 0x80402010) }
    if which == 38 { overlay.dashedLine(p, 299.0, 0.0, 0.0, 199.0) }
    return which < 39
}

// Every mark of the overlay keeps to the painter's clip and names every
// pixel it drew in its bounds (refresh() repaints only what they name),
// at zoom 1, 3.7 turned and mirrored, and 0.3; on a canvas of no pixels
// none is drawn.
fn checkOverlayBounds(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    const clip = ui.rect(100, 80, 600, 400)
    var round: usize = 0
    while round < 3 {
        if round == 0 { setView(t, 150.0, 100.0, 1.0, 0.0, false) }
        if round == 1 { setView(t, 150.0, 100.0, 3.7, 0.3, true) }
        if round == 2 { setView(t, 150.0, 100.0, 0.3, 0.0, false) }
        show(t)
        var which: usize = 0
        while true {
            fillCanvas(&t.*.a, UNTOUCHED)
            var bounds = geom.empty()
            var p = overlay.painter(&t.*.a, &docOf(t).*.view, 0, 0, clip, &bounds)
            p.font = state.smallOf(app)
            p.scale = 1
            if !oneMark(&p, which) { break }
            const drawn = drawnArea(t)
            if !covers(clip, bounds) || !covers(bounds, drawn) {
                _ = std.io.print("53_canvasview: mark number ")
                _ = std.io.writeUnsigned(std.io.stdout(), which)
                _ = std.io.print(" drew outside its bounds or its clip\n")
                return 1 + @intCast(u8, round)
            }
            // Those that must show did (at zoom 1 all the image is in
            // the clip).
            if round == 0 && (which == 0 || which == 2 || which == 4 || which == 5 || which == 13 || which == 18 || which == 30 || which == 33) && ui.isEmpty(drawn) {
                _ = std.io.print("53_canvasview: mark number ")
                _ = std.io.writeUnsigned(std.io.stdout(), which)
                _ = std.io.print(" drew nothing\n")
                return 4 + @intCast(u8, round)
            }
            // Those that must not did not.
            if (which == 6 || which == 7 || which == 19 || which == 25 || which == 26 || which == 31 || which == 32 || which == 36) && !ui.isEmpty(drawn) {
                _ = std.io.print("53_canvasview: mark number ")
                _ = std.io.writeUnsigned(std.io.stdout(), which)
                _ = std.io.print(" drew, but should not have\n")
                return 7 + @intCast(u8, round)
            }
            which += 1
        }
        round += 1
    }
    // A layout pass's canvas: nothing, and nothing named.
    var nowhere = view_module.layoutCanvas()
    var bounds = geom.empty()
    const p = overlay.painter(&nowhere, &docOf(t).*.view, 0, 0, clip, &bounds)
    var which: usize = 0
    while oneMark(&p, which) { which += 1 }
    if !ui.isEmpty(bounds) { return 10 }
    return 0
}

// Within one turn of the window's loop: many frames and refreshes, many
// marks, a long polyline: the value arena does not grow with them.
fn checkArenaInTurn(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 0.7, 0.4, false)
    select(t, geom.rect(30, 30, 120, 90))
    marksKind = 3
    canvasview.setMarks(app, testMarks)
    show(t)
    var loop: turns.Turns = undefined
    turns.begin(&loop, true, false)
    const arena = loop.base
    turns.turn(&loop)
    // One of each first (whatever is made once), then many.
    show(t)
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    var bounds = geom.empty()
    const p = overlay.painter(&t.*.a, &docOf(t).*.view, 0, 0, areaOf(t), &bounds)
    overlay.line(&p, 0.0, 0.0, 300.0, 200.0)
    const start = turns.used(arena)
    var round: usize = 0
    while round < 200 {
        app.*.time += 70
        if round % 2 == 0 { show(t) } else { _ = canvasview.refresh(app, &t.*.a, areaOf(t)) }
        round += 1
    }
    const frames = turns.used(arena) - start
    var many: usize = 0
    while many < 20000 {
        const at = @floatFromInt(f64, many % 300)
        overlay.line(&p, at, 0.0, 300.0 - at, 200.0)
        overlay.handle(&p, at, 50.0, overlay.ROUND, false)
        overlay.antsLine(&p, at, 10.0, at, 20.0)
        many += 1
    }
    var points: [*]f64 = undefined
    const memory = app.*.allocator.alloc(80000 * 8, 16)
    if memory == null { return 1 }
    unsafe { points = @ptrCast([*]f64, memory.?) }
    many = 0
    while many < 40000 {
        points[many * 2] = @floatFromInt(f64, many % 300)
        points[many * 2 + 1] = @floatFromInt(f64, (many * 7) % 200)
        many += 1
    }
    overlay.polyline(&p, points, 40000, true)
    unsafe { app.*.allocator.free(@ptrCast([*]u8, points), 80000 * 8, 16) }
    const all = turns.used(arena) - start
    turns.turn(&loop)
    marksKind = 0
    canvasview.setMarks(app, null)
    select(t, geom.empty())
    _ = std.io.print("53_canvasview: value arena within a turn: 200 frames ")
    _ = std.io.writeUnsigned(std.io.stdout(), frames)
    _ = std.io.print(" bytes, with 60000 marks and a polyline of 40000 points ")
    _ = std.io.writeUnsigned(std.io.stdout(), all)
    _ = std.io.print(" bytes\n")
    // A frame takes a few hundred bytes at most (and the window's loop
    // gives them back at its next turn); marks take none.
    if frames > 200 * 512 { return 2 }
    if all > frames + 4096 { return 3 }
    return 0
}

// The ants from afar (the outline made on a coarser grid): near the
// selection's edge and all along it at zoom 0.25, 0.1 and 0.04; and a
// selection of single pixels with more pieces than the ants may have:
// drawn on a coarser grid, around what it covers.
fn checkAntsFar(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    const chosen = geom.rect(50, 40, 100, 80)
    select(t, chosen)
    var round: usize = 0
    while round < 3 {
        const zoom: f64 = if round == 0 { 0.25 } else if round == 1 { 0.1 } else { 0.04 }
        setView(t, 150.0, 100.0, zoom, 0.0, round == 2)
        docOf(t).*.showSelection = false
        reference(t)
        docOf(t).*.showSelection = true
        show(t)
        if !canvasview.animating(app) { return 1 }
        const inner = docOf(t).*.view.area
        var touched: usize = 0
        var row = inner.y
        while row < inner.y + inner.height {
            var column = inner.x
            while column < inner.x + inner.width {
                if pixelAt(&t.*.a, column, row) != pixelAt(&t.*.b, column, row) {
                    if !isInk(pixelAt(&t.*.a, column, row)) || fromEdge(t, column, row, chosen) > 2.5 { return 2 }
                    touched += 1
                }
                column += 1
            }
            row += 1
        }
        if @floatFromInt(f64, touched) < 180.0 * zoom { return 3 }
        var side: usize = 0
        while side < 4 {
            const mx: f64 = if side == 0 { 100.0 } else if side == 1 { 150.0 } else if side == 2 { 100.0 } else { 50.0 }
            const my: f64 = if side == 0 { 40.0 } else if side == 1 { 80.0 } else if side == 2 { 120.0 } else { 80.0 }
            var cx: i32 = 0
            var cy: i32 = 0
            windowOf(t, mx, my, &cx, &cy)
            var found = false
            var dy: i32 = -1
            while dy <= 1 {
                var dx: i32 = -1
                while dx <= 1 {
                    if pixelAt(&t.*.a, cx + dx, cy + dy) != pixelAt(&t.*.b, cx + dx, cy + dy) { found = true }
                    dx += 1
                }
                dy += 1
            }
            if !found { return 4 }
            side += 1
        }
        round += 1
    }
    // Every other pixel of the image: 120000 pieces at zoom 1.
    const image = docOf(t).*.image
    ops.beginSelection(image)
    var y: i32 = 0
    while y < 200 {
        var x = y & 1
        while x < 300 {
            mask.set(image.*.selection, x, y, 255)
            x += 2
        }
        y += 1
    }
    ops.endSelection(image, true, "Select")
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    docOf(t).*.showSelection = false
    reference(t)
    docOf(t).*.showSelection = true
    show(t)
    if !canvasview.animating(app) { return 5 }
    const inner = docOf(t).*.view.area
    var touched: usize = 0
    var row = inner.y
    while row < inner.y + inner.height {
        var column = inner.x
        while column < inner.x + inner.width {
            if pixelAt(&t.*.a, column, row) != pixelAt(&t.*.b, column, row) {
                if fromEdge(t, column, row, image_module.bounds(image)) > 2.0 { return 6 }
                touched += 1
            }
            column += 1
        }
        row += 1
    }
    if touched < 500 { return 7 }
    select(t, geom.empty())
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    if canvasview.animating(app) { return 8 }
    // What a far view keeps (all six smaller pictures, a coarse outline)
    // goes with forget().
    select(t, chosen)
    canvasview.forget(app, docOf(t))
    const before = std.heap.liveBytes()
    setView(t, 150.0, 100.0, 0.011, 0.3, false)
    show(t)
    setView(t, 150.0, 100.0, 0.2, 0.0, true)
    show(t)
    if docOf(t).*.viewData == 0 || std.heap.liveBytes() <= before { return 9 }
    canvasview.forget(app, docOf(t))
    if std.heap.liveBytes() != before { return 10 }
    select(t, geom.empty())
    return 0
}

// The grid with offsets far beyond the image (any i32): its lines are
// where the offset puts them, at zoom 64 a quarter pixel apart.
fn checkGridFar(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    const doc = docOf(t)
    doc.*.gridX = 1
    doc.*.gridY = 1
    doc.*.gridDivisions = 4
    doc.*.gridOffsetX = 1000000000
    doc.*.gridOffsetY = -2000000000
    doc.*.showGuides = false
    setView(t, 150.0, 100.0, 64.0, 0.0, false)
    doc.*.showGrid = false
    reference(t)
    doc.*.showGrid = true
    show(t)
    var x: i32 = 0
    var y: i32 = 0
    windowOf(t, 150.0, 100.1, &x, &y)
    var lines: i32 = 0
    var column = doc.*.view.area.x
    while column < doc.*.view.area.x + doc.*.view.area.width {
        if pixelAt(&t.*.a, column, y) != pixelAt(&t.*.b, column, y) { lines += 1 }
        column += 1
    }
    if lines < 55 || closestLines(t, y, doc.*.view.area.x, doc.*.view.area.x + doc.*.view.area.width) != 16 { return 1 }
    // One of them at image x 150.25.
    windowOf(t, 150.25, 100.1, &x, &y)
    if pixelAt(&t.*.a, x, y) == pixelAt(&t.*.b, x, y) { return 2 }
    doc.*.showGrid = false
    doc.*.showGuides = true
    doc.*.gridOffsetX = 0
    doc.*.gridOffsetY = 0
    return 0
}

// The view commands given what they cannot use: no number, no size, a
// zoom beyond the ladder, a turn of a whole circle, a move out of sight.
fn checkCommandEdges(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    show(t)
    const view = &docOf(t).*.view
    const nan = floatOf(0x7FF8000000000000)
    const infinite = floatOf(0x7FF0000000000000)
    canvasview.zoomTo(app, nan)
    canvasview.zoomTo(app, -3.0)
    canvasview.zoomTo(app, 0.0)
    if view.*.zoom != 1.0 { return 1 }
    canvasview.zoomTo(app, 1.0e300)
    canvasview.zoomIn(app)
    if view.*.zoom != viewport.LARGEST { return 2 }
    show(t)
    canvasview.zoomTo(app, 1.0e-300)
    canvasview.zoomOut(app)
    if view.*.zoom != viewport.SMALLEST { return 3 }
    show(t)
    canvasview.rotateBy(app, nan)
    canvasview.rotateBy(app, infinite)
    if view.*.rotation != 0.0 { return 4 }
    canvasview.rotateBy(app, math.tau)
    if view.*.rotation != 0.0 { return 5 }
    canvasview.rotateBy(app, -7.0 * math.pi / 12.0)
    if absolute(view.*.rotation + 7.0 * math.pi / 12.0) > 0.0000001 { return 6 }
    canvasview.resetRotation(app)
    const before_x = view.*.centerX
    canvasview.panBy(app, infinite, 0.0)
    canvasview.panBy(app, 0.0, nan)
    if view.*.centerX != before_x { return 7 }
    // Far out of sight: the next frame brings the image back, at least
    // 24 pixels of it each way.
    canvasview.zoomTo(app, 1.0)
    canvasview.panBy(app, 100000000.0, -100000000.0)
    show(t)
    const kept = ui.intersect(viewport.windowRectOf(view, image_module.bounds(docOf(t).*.image)), view.*.area)
    if kept.width < 24 || kept.height < 24 { return 8 }
    // A canvas area too small to fit anything into.
    app.*.canvasArea = ui.rect(10, 10, 30, 30)
    canvasview.fitPage(app)
    canvasview.fitWidth(app)
    if !(view.*.zoom > 0.0) { return 9 }
    show(t)
    useArea(t)
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    show(t)
    return 0
}

// A document not drawn yet (its zoom is chosen at its first frame): the
// pointer's place on it is a place of the image, the one the first frame
// then shows there; the view commands work from the zoom it will have.
fn checkUndrawn(t: *T) -> u8 {
    const app = t.*.app
    app.*.pointerInside = false
    if !plain(t, 640, 480, 0xFF808040) { return 1 }
    const middle_x = areaOf(t).x + areaOf(t).width / 2
    const middle_y = areaOf(t).y + areaOf(t).height / 2
    var before: state.Input = undefined
    canvasview.inputAt(app, docOf(t), middle_x + 7, middle_y - 3, &before)
    if !(before.x > 300.0 && before.x < 340.0 && before.y > 220.0 && before.y < 260.0) { return 2 }
    show(t)
    var after: state.Input = undefined
    canvasview.inputAt(app, docOf(t), middle_x + 7, middle_y - 3, &after)
    if after.x != before.x || after.y != before.y { return 3 }
    closeFront(t)
    // 640 x 480 fits at 100 %: one step in is 200 %, about the middle.
    if !plain(t, 640, 480, 0xFF808040) { return 4 }
    const view = &docOf(t).*.view
    canvasview.zoomIn(app)
    if view.*.zoom != 2.0 || absolute(view.*.centerX - 320.0) > 0.000001 || absolute(view.*.centerY - 240.0) > 0.000001 { return 5 }
    closeFront(t)
    if !plain(t, 640, 480, 0xFF808040) { return 6 }
    canvasview.zoomOut(app)
    if absolute(docOf(t).*.view.zoom - 2.0 / 3.0) > 0.0000001 || absolute(docOf(t).*.view.centerX - 320.0) > 0.000001 { return 7 }
    closeFront(t)
    if !plain(t, 640, 480, 0xFF808040) { return 8 }
    canvasview.rotateBy(app, math.pi / 12.0)
    canvasview.panBy(app, 10.0, 0.0)
    const turned = &docOf(t).*.view
    if turned.*.zoom != 1.0 || absolute(turned.*.rotation - math.pi / 12.0) > 0.0000001 || !(turned.*.centerX > 300.0 && turned.*.centerX < 320.0) { return 9 }
    closeFront(t)
    return 0
}

// The theme at twice the size: rulers 40 pixels, the checker's squares
// 16, a handle 13 across; a refresh still equals a fresh draw.
fn checkScale(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.blocks)
    app.*.scale = 2
    docOf(t).*.showRulers = true
    setView(t, 150.0, 100.0, 1.0, 0.0, false)
    show(t)
    const area = areaOf(t)
    const inner = docOf(t).*.view.area
    if !geom.same(inner, ui.rect(area.x + 40, area.y + 40, area.width - 40, area.height - 40)) || !geom.same(canvasview.imageArea(app, docOf(t)), inner) { return 1 }
    var x0: i32 = 0
    var y0: i32 = 0
    windowOf(t, 244.0, 4.0, &x0, &y0)
    var row = y0
    while row < y0 + 40 {
        var column = x0
        while column < x0 + 40 {
            const wanted = if (column >> 4) & 1 == (row >> 4) & 1 { t.*.light } else { t.*.dark }
            if pixelAt(&t.*.a, column, row) != wanted { return 2 }
            column += 1
        }
        row += 1
    }
    paint(t, geom.rect(200, 20, 50, 30), 0x80FF00FF)
    _ = canvasview.refresh(app, &t.*.a, areaOf(t))
    reference(t)
    if !sameAsReference(t) { return 3 }
    fillCanvas(&t.*.a, UNTOUCHED)
    var bounds = geom.empty()
    var p = overlay.painter(&t.*.a, &docOf(t).*.view, 0, 0, areaOf(t), &bounds)
    p.scale = 2
    overlay.handle(&p, 100.0, 50.0, overlay.SQUARE, false)
    windowOf(t, 100.0, 50.0, &x0, &y0)
    if pixelAt(&t.*.a, x0 - 6, y0) != BLACK || pixelAt(&t.*.a, x0 + 6, y0 + 6) != BLACK || pixelAt(&t.*.a, x0 - 7, y0) != UNTOUCHED || pixelAt(&t.*.a, x0 + 7, y0) != UNTOUCHED || pixelAt(&t.*.a, x0, y0) != WHITE { return 4 }
    if bounds.width != 13 || bounds.height != 13 { return 5 }
    app.*.scale = 1
    docOf(t).*.showRulers = false
    show(t)
    return 0
}

// Says which check of a group failed (the program's exit names the group).
fn failedIn(what: []const u8, code: u8, inner: u8) -> u8 {
    _ = std.io.print("53_canvasview: ")
    _ = std.io.print(what)
    _ = std.io.print(": check ")
    _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, inner))
    _ = std.io.print(" failed\n")
    return code
}

fn micros(start: usize) -> usize { return (std.time.monotonicNanoseconds() - start) / 1000 }

fn report(what: []const u8, value: usize, target: usize) -> void {
    _ = std.io.print("53_canvasview: ")
    _ = std.io.print(what)
    _ = std.io.print(": ")
    _ = std.io.writeUnsigned(std.io.stdout(), value)
    _ = std.io.print(" us (wanted below ")
    _ = std.io.writeUnsigned(std.io.stdout(), target)
    _ = std.io.print(" us)\n")
}

// The speeds, printed: a canvas area of 1000 x 700 over a large image.
fn speeds(t: *T) -> u8 {
    const app = t.*.app
    documents.show(app, t.*.large)
    const kept = app.*.canvasArea
    app.*.canvasArea = ui.rect(0, 0, 1000, 700)
    _ = render.update(docOf(t).*.image)
    setView(t, 1500.0, 1100.0, 1.0, 0.0, false)
    show(t)
    var best: usize = 1000000000
    var round: usize = 0
    while round < 20 {
        const start = std.time.monotonicNanoseconds()
        show(t)
        const took = micros(start)
        if took < best { best = took }
        round += 1
    }
    report("a whole frame from the kept pixels, zoom 1", best, 1500)
    best = 1000000000
    round = 0
    while round < 10 {
        docOf(t).*.view.centerX += 1.0
        const start = std.time.monotonicNanoseconds()
        show(t)
        const took = micros(start)
        if took < best { best = took }
        round += 1
    }
    report("composed anew, zoom 1", best, 12000)
    // The first look from afar: the picture at half the size is made for
    // all of the image (7.2 million pixels read).
    canvasview.forget(app, docOf(t))
    show(t)
    setView(t, 1500.0, 1100.0, 0.3, 0.0, false)
    var start = std.time.monotonicNanoseconds()
    show(t)
    report("the first frame at zoom 0.3, the picture at half the size made", micros(start), 15000)
    best = 1000000000
    round = 0
    while round < 10 {
        docOf(t).*.view.centerX += 3.0
        start = std.time.monotonicNanoseconds()
        show(t)
        const took = micros(start)
        if took < best { best = took }
        round += 1
    }
    report("composed anew at zoom 0.3, the smaller pictures there", best, 15000)
    setView(t, 1500.0, 1100.0, 1.0, 0.0, false)
    show(t)
    best = 1000000000
    var compose_best: usize = 1000000000
    round = 0
    while round < 10 {
        paint(t, geom.rect(1400 + @intCast(i32, round) * 10, 1000, 64, 64), 0xFF000000 | @intCast(u32, round * 7777))
        start = std.time.monotonicNanoseconds()
        _ = render.update(docOf(t).*.image)
        const composed = micros(start)
        start = std.time.monotonicNanoseconds()
        _ = canvasview.refresh(app, &t.*.a, app.*.canvasArea)
        const took = micros(start)
        if took < best { best = took }
        if composed < compose_best { compose_best = composed }
        round += 1
    }
    report("the layers mixed after a change of 64 x 64 (core/render.mlx)", compose_best, 1000)
    report("refresh after a change of 64 x 64", best, 300)
    setView(t, 1500.0, 1100.0, 1.0, math.pi / 6.0, false)
    show(t)
    best = 1000000000
    round = 0
    while round < 5 {
        docOf(t).*.view.centerX += 1.0
        start = std.time.monotonicNanoseconds()
        show(t)
        const took = micros(start)
        if took < best { best = took }
        round += 1
    }
    report("composed anew turned by 30 degrees", best, 40000)
    save(t, &t.*.a, "53-large-turned.png")
    // All of it half transparent (a picture without a background): every
    // pixel mixed with the checker; the left half's alpha going from 0 to
    // 255 every 256 rows.
    const layer = docOf(t).*.image.*.active.?
    _ = device.fill(layer.*.device.?, image_module.bounds(docOf(t).*.image), SEMI)
    var veil: i32 = 0
    while veil < 2400 {
        _ = device.fill(layer.*.device.?, geom.rect(0, veil, 1500, 1), (@intCast(u32, veil & 255) << 24) | 0x002060E0)
        veil += 1
    }
    api.imageChanged(app, image_module.bounds(docOf(t).*.image))
    var turn: usize = 0
    while turn < 3 {
        const zoom: f64 = if turn == 0 { 1.0 } else { 0.3 }
        setView(t, 1500.0, 1100.0, zoom, if turn == 2 { math.pi / 6.0 } else { 0.0 }, false)
        show(t)
        best = 1000000000
        round = 0
        while round < 5 {
            docOf(t).*.view.centerX += 1.0
            start = std.time.monotonicNanoseconds()
            show(t)
            const took = micros(start)
            if took < best { best = took }
            round += 1
        }
        if turn == 0 { report("composed anew at zoom 1, all half transparent", best, 12000) }
        if turn == 1 { report("composed anew at zoom 0.3, all half transparent", best, 15000) }
        if turn == 2 { report("composed anew at zoom 0.3 turned by 30 degrees, all half transparent", best, 40000) }
        if turn == 1 { save(t, &t.*.a, "53-large-veiled.png") }
        if turn == 2 { save(t, &t.*.a, "53-large-veiled-turned.png") }
        turn += 1
    }
    canvasview.forget(app, docOf(t))
    app.*.canvasArea = kept
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(T), 16)
    const first = allocator.alloc(WIDTH * HEIGHT * 4, 16)
    const second = allocator.alloc(WIDTH * HEIGHT * 4, 16)
    if memory == null || first == null || second == null { return 1 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    t.*.shots = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { t.*.shots = std.string.asSlice(named.?) }
    unsafe {
        t.*.a = Canvas.{ .pixels = @ptrCast([*]u32, first.?), .width = WIDTH, .height = HEIGHT, .stride = WIDTH, .swapRedBlue = false, .device = 0, .opacity = 255 }
        t.*.b = Canvas.{ .pixels = @ptrCast([*]u32, second.?), .width = WIDTH, .height = HEIGHT, .stride = WIDTH, .swapRedBlue = false, .device = 0, .opacity = 255 }
    }
    const made = script.headless(allocator)
    if made == null { return 2 }
    t.*.app = made.?
    const app = t.*.app
    app.*.canvasOnly = true
    if !script.run(app, "size 1000 700\n") { return 3 }
    useArea(t)
    // Without a document: the ground alone.
    fillCanvas(&t.*.a, UNTOUCHED)
    canvasview.draw(app, &t.*.a, app.*.canvasArea)
    const area = app.*.canvasArea
    if ui.isEmpty(area) || pixelAt(&t.*.a, area.x + 5, area.y + 5) == UNTOUCHED || canvasview.animating(app) { return 4 }
    const bare = pixelAt(&t.*.a, area.x + 5, area.y + 5)

    if !add(t, blocksImage(allocator), "Blocks") { return 5 }
    t.*.blocks = app.*.current
    if !add(t, fineImage(allocator), "Fine") { return 6 }
    t.*.fine = app.*.current
    if !add(t, largeImage(allocator), "Large") { return 7 }
    t.*.large = app.*.current
    // The pointer is not on the canvas (no pointer's marks).
    app.*.pointerInside = false
    if !geom.same(areaOf(t), ui.rect(16, 24, 968, 652)) { return 8 }

    var failed = checkZooms(t)
    if failed != 0 { return 14 + failed }
    if t.*.ground != bare { return 9 }
    failed = checkSmaller(t)
    if failed != 0 { return 35 + failed }
    failed = checkTurned(t)
    if failed != 0 { return 60 + failed }
    failed = checkInput(t)
    if failed != 0 { return 72 + failed }
    failed = checkRefresh(t)
    if failed != 0 { return 106 + failed }
    failed = checkMarks(t)
    if failed != 0 { return 130 + failed }
    failed = checkAnts(t)
    if failed != 0 { return 162 + failed }
    failed = checkGrid(t)
    if failed != 0 { return 183 + failed }
    failed = checkCommands(t)
    if failed != 0 { return 193 + failed }
    failed = checkLight(t)
    if failed != 0 { return 214 + failed }
    failed = checkArena(t)
    if failed != 0 { return 219 + failed }
    failed = checkForget(t)
    if failed != 0 { return 223 + failed }
    // The edges, a code each (the output names the check within).
    failed = checkPlainSizes(t)
    if failed != 0 { return failedIn("one colour at many sizes and zooms", 228, failed) }
    failed = checkAreas(t)
    if failed != 0 { return failedIn("small areas, an area beyond the window", 229, failed) }
    failed = checkLevelsKept(t)
    if failed != 0 { return failedIn("the smaller pictures kept", 230, failed) }
    failed = checkTwoDocuments(t)
    if failed != 0 { return failedIn("two documents", 231, failed) }
    failed = checkOverlayBounds(t)
    if failed != 0 { return failedIn("the marks' bounds", 232, failed) }
    failed = checkArenaInTurn(t)
    if failed != 0 { return failedIn("the value arena within a turn", 233, failed) }
    failed = checkAntsFar(t)
    if failed != 0 { return failedIn("the ants from afar", 234, failed) }
    failed = checkGridFar(t)
    if failed != 0 { return failedIn("the grid's far offsets", 235, failed) }
    failed = checkCommandEdges(t)
    if failed != 0 { return failedIn("the view commands at their edges", 236, failed) }
    failed = checkUndrawn(t)
    if failed != 0 { return failedIn("a document not drawn yet", 239, failed) }
    failed = checkScale(t)
    if failed != 0 { return failedIn("the theme at twice the size", 240, failed) }
    _ = speeds(t)
    // A document closed after its record was let go.
    var index = app.*.count
    while index > 0 {
        index -= 1
        canvasview.forget(app, app.*.documents[index].?)
        documents.close(app, index)
    }
    fillCanvas(&t.*.a, UNTOUCHED)
    canvasview.draw(app, &t.*.a, app.*.canvasArea)
    if pixelAt(&t.*.a, area.x + 5, area.y + 5) != bare { return 227 }
    // The commands with nothing to show do nothing.
    app.*.fullRedraw = false
    canvasview.zoomIn(app)
    canvasview.zoomOut(app)
    canvasview.zoomTo(app, 2.0)
    canvasview.actualSize(app)
    canvasview.fitPage(app)
    canvasview.fitWidth(app)
    canvasview.rotateBy(app, 1.0)
    canvasview.resetRotation(app)
    canvasview.toggleMirror(app)
    canvasview.panBy(app, 3.0, 4.0)
    canvasview.setPixelGrid(app, false)
    if app.*.fullRedraw || !canvasview.pixelGrid(app) || canvasview.animating(app) { return 237 }
    var nowhere = view_module.layoutCanvas()
    canvasview.draw(app, &nowhere, area)
    if !ui.isEmpty(canvasview.refresh(app, &nowhere, area)) { return 238 }
    return 13
}
