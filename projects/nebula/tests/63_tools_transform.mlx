// nebula's Move, Transform and Crop tools (tools/transforms.mlx) on an
// App without a window (app/script.mlx), driven as a person would: drags
// and keys in the window's pixels, the options clicked. Checked:
//
// Move: a drag moves the layer's pixels by the drag exactly (across a
// tile's border), as one step; the arrow keys by 1 and, with Shift, 10
// pixels, a step a key, also beyond the image's top left corner; undo
// puts it back; Escape in the middle of a drag leaves no trace; the box
// shown while dragging is gone after it; Ctrl and a click makes the
// layer under the pointer the active one; with a selection, the selected
// pixels leave a hole and land at the new place, the selection with them,
// in one step, and undo gives all back.
//
// Transform: the right handle dragged doubles a 10 x 10 square's width:
// before Enter the image shows it (the preview), the layer's own pixels
// and the history are unchanged; on Enter the layer holds a 20 x 10 square
// whose inside is exactly the colour (bilinear), one step "Transform";
// undo. A turn by 90 degrees with Shift held is the exact quarter turn of
// a pattern of distinct pixels. Escape puts the original pixels back and
// leaves the history as it was. Ctrl on a corner handle moves that corner
// alone (perspective): the far corner's pixels stay. The warp mode,
// chosen by a click on its button in the options: one inner point of the
// grid dragged changes the pixels around it and leaves the cells away
// from it exactly as they were. A selected part moved: a hole, the part
// at its new place, the selection with it. The value arena does not grow
// while a warp is dragged.
//
// Crop: a rectangle dragged and Enter: the image's size is the
// rectangle's, every layer's pixels stay where they were against its
// corner, one step; undo gives size and pixels back, redo takes them
// again; Escape leaves all as it was and the darkening outside the
// rectangle goes with it; cropping only the layer clears outside the
// rectangle and keeps the size; a rectangle beyond the image grows it.
//
// The options of all three draw at 1024 x 768 without trapping, dark,
// light and German, also on a layout pass. Pictures (transform.png,
// move.png, crop.png, options-*.png) go to the current directory and,
// when NEBULA_SHOTS names a directory, there too. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const png = @import("std.png")
const turns = @import("std.turns")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const keys = @import("std.ui.keys")
const canvas_module = @import("std.ui.canvas")
const theme_module = @import("std.ui.theme")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const settings = @import("../app/settings.mlx")
const tools = @import("../tools/registry.mlx")
const transforms = @import("../tools/transforms.mlx")
const kit_module = @import("../ui/kit.mlx")
const viewport = @import("../ui/viewport.mlx")
const device_module = @import("../core/device.mlx")
const node_module = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const history = @import("../core/history.mlx")
const mask = @import("../core/mask.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const render = @import("../core/render.mlx")
const selection = @import("../core/selection.mlx")

const App = state.App
const Canvas = canvas_module.Canvas
const Device = device_module.Device

const BLUE: u32 = 0xFF2040C0
const RED: u32 = 0xFFE02020
const GREEN: u32 = 0xFF20C040
const WHITE: u32 = 0xFFFFFFFF
const WIDTH: usize = 1024
const HEIGHT: usize = 768

// A script being written, and the canvas the options are drawn on.
const Work = struct {
    bytes: [8192]u8
    length: usize
    shots: []const u8
    pixels: [*]u32
    canvas: Canvas
    // A pattern kept to compare with.
    kept: [1024]u32
}

fn clear(w: *Work) -> void { w.*.length = 0 }

fn add(w: *Work, text: []const u8) -> void {
    const bytes: [*]u8 = &w.*.bytes
    w.*.length = std.text.append(bytes, w.*.length, 8192, text)
}

fn number(w: *Work, value: i32) -> void {
    const bytes: [*]u8 = &w.*.bytes
    w.*.length = std.text.appendSigned(bytes, w.*.length, 8192, @intCast(isize, value))
}

// The window pixel that shows image point (x, y) of the document in front.
fn windowPixel(app: *App, x: f64, y: f64, wx: *i32, wy: *i32) -> void {
    const doc = api.document(app).?
    var fx: f64 = 0.0
    var fy: f64 = 0.0
    viewport.toWindow(&doc.*.view, x, y, &fx, &fy)
    wx.* = @intFromFloat(i32, @floor(fx))
    wy.* = @intFromFloat(i32, @floor(fy))
}

fn place(w: *Work, app: *App, x: f64, y: f64) -> void {
    var wx: i32 = 0
    var wy: i32 = 0
    windowPixel(app, x, y, &wx, &wy)
    number(w, wx)
    add(w, " ")
    number(w, wy)
}

fn run(w: *Work, app: *App) -> bool {
    const bytes: [*]const u8 = &w.*.bytes
    return script.run(app, bytes[0..w.*.length])
}

// A drag from image point (x0, y0) to (x1, y1) in `steps` motions.
fn drag(w: *Work, app: *App, x0: f64, y0: f64, x1: f64, y1: f64, steps: i32) -> bool {
    clear(w)
    add(w, "drag ")
    place(w, app, x0, y0)
    add(w, " ")
    place(w, app, x1, y1)
    add(w, " ")
    number(w, steps)
    add(w, "\n")
    return run(w, app)
}

fn pointer(w: *Work, app: *App, x: f64, y: f64) -> bool {
    clear(w)
    add(w, "pointer ")
    place(w, app, x, y)
    add(w, "\n")
    return run(w, app)
}

// A click at image point (x, y) with Control held.
fn controlClick(w: *Work, app: *App, x: f64, y: f64) -> bool {
    clear(w)
    add(w, "down Ctrl\nclick ")
    place(w, app, x, y)
    add(w, "\nup Ctrl\n")
    return run(w, app)
}

// The frame as a picture `name`, here and where NEBULA_SHOTS says.
fn shot(w: *Work, app: *App, name: []const u8) -> bool {
    clear(w)
    add(w, "shot ")
    add(w, name)
    add(w, "\n")
    if w.*.shots.length > 0 {
        add(w, "shot ")
        add(w, w.*.shots)
        add(w, "/")
        add(w, name)
        add(w, "\n")
    }
    return run(w, app)
}

// The part `area` of the options' canvas (inside it) as a picture
// `name`, here and there.
fn save(w: *Work, app: *App, name: []const u8, area: ui.Rect) -> bool {
    const first: [*]const u32 = w.*.pixels + (@intCast(usize, area.y) * WIDTH + @intCast(usize, area.x))
    const width = @intCast(usize, area.width)
    const height = @intCast(usize, area.height)
    var path: [1024]u8 = undefined
    const bytes: [*]u8 = &path
    if !png.saveFile(std.text.zeroTerminated(bytes, 1024, name), first, width, height, WIDTH, true, app.*.allocator) { return false }
    if w.*.shots.length == 0 { return true }
    var length = std.text.append(bytes, 0, 1024, w.*.shots)
    length = std.text.append(bytes, length, 1024, "/")
    length = std.text.append(bytes, length, 1024, name)
    var full: [1024]u8 = undefined
    const named: [*]u8 = &full
    return png.saveFile(std.text.zeroTerminated(named, 1024, bytes[0..length]), first, width, height, WIDTH, true, app.*.allocator)
}

// What the image shows at (x, y).
fn shown(app: *App, x: i32, y: i32) -> u32 {
    const image = api.image(app).?
    _ = render.update(image)
    return device_module.pixel(image.*.projection, x, y)
}

fn layerOf(app: *App) -> *Device { return api.activeNode(app).?.*.device.? }

fn steps(app: *App) -> usize { return history.stepsDone(api.image(app).?.*.history) }

fn undoName(app: *App) -> []const u8 { return history.undoName(api.image(app).?.*.history) }

fn select(app: *App, area: geom.Rect) -> void {
    const image = api.image(app).?
    ops.beginSelection(image)
    _ = selection.fromRect(image.*.selection, area, selection.REPLACE, 0.0)
    ops.endSelection(image, true, "Select")
}

fn deselect(app: *App) -> void {
    const image = api.image(app).?
    ops.beginSelection(image)
    selection.clear(image.*.selection)
    ops.endSelection(image, false, "Deselect")
}

// A fresh layer: nothing but a square of `color` at (x, y), `side` long.
fn square(app: *App, x: i32, y: i32, side: i32, color: u32) -> void {
    const layer = layerOf(app)
    device_module.clear(layer)
    _ = device_module.fill(layer, geom.rect(x, y, side, side), color)
    image_module.damageAll(api.image(app).?)
}

// A pattern of distinct pixels in the square from (x, y), `side` long
// (at most 32), also kept in w.kept.
fn pattern(w: *Work, app: *App, x: i32, y: i32, side: i32) -> void {
    const layer = layerOf(app)
    device_module.clear(layer)
    var row: i32 = 0
    while row < side {
        var column: i32 = 0
        while column < side {
            const color = 0xFF000000 | (@intCast(u32, column * 23 + 7) << 16) | (@intCast(u32, row * 19 + 11) << 8) | @intCast(u32, (column * 5 + row * 3) & 255)
            device_module.setPixel(layer, x + column, y + row, color)
            w.*.kept[@intCast(usize, row * 32 + column)] = color
            column += 1
        }
        row += 1
    }
    image_module.damageAll(api.image(app).?)
}

// A pattern of stripes three pixels wide, crossing.
fn stripes(x: i32, y: i32) -> u32 {
    return if ((x / 3) + (y / 3)) % 2 == 0 { BLUE } else { RED }
}

// How many pure black pixels the frame has in the window row that shows
// image row `y` from image column x0 to x1.
fn blackInRow(app: *App, x0: f64, x1: f64, y: f64) -> usize {
    const frame = script.frameOf(app).?
    var wx0: i32 = 0
    var wy: i32 = 0
    var wx1: i32 = 0
    windowPixel(app, x0, y, &wx0, &wy)
    windowPixel(app, x1, y, &wx1, &wy)
    var count: usize = 0
    var x = wx0
    while x <= wx1 {
        if x >= 0 && wy >= 0 && @intCast(usize, x) < frame.*.width && @intCast(usize, wy) < frame.*.height {
            if frame.*.pixels[@intCast(usize, wy) * frame.*.stride + @intCast(usize, x)] == 0xFF000000 { count += 1 }
        }
        x += 1
    }
    return count
}

// ---------------------------------------------------------------------------
// Move

fn moveChecks(w: *Work, app: *App) -> u8 {
    const image = api.image(app).?
    const node = api.activeNode(app).?
    const layer = node.*.device.?
    device_module.clear(layer)
    _ = device_module.fill(layer, geom.rect(40, 30, 20, 10), BLUE)
    device_module.setPixel(layer, 41, 31, RED)
    image_module.damageAll(image)
    const before = steps(app)
    if !script.run(app, "tool move\n") || app.*.tool != transforms.MOVE { return 14 }
    // A drag by (13, 7): across the tile border at 64, by the drag exactly.
    if !drag(w, app, 50.5, 35.5, 63.5, 42.5, 8) { return 15 }
    if layer.*.x != 13 || layer.*.y != 7 { return 16 }
    if device_module.pixel(layer, 54, 38) != RED || device_module.pixel(layer, 41, 31) != 0 || device_module.pixel(layer, 53, 37) != BLUE || device_module.pixel(layer, 72, 46) != BLUE || device_module.pixel(layer, 73, 47) != 0 || device_module.pixel(layer, 52, 37) != 0 { return 17 }
    if steps(app) != before + 1 || !std.text.same(undoName(app), "Move layer") { return 18 }
    if node.*.overlay != null || api.toolBusy(app) { return 19 }
    if shown(app, 54, 38) != RED || shown(app, 41, 31) != WHITE || shown(app, 72, 46) != BLUE { return 20 }
    // The arrow keys: a pixel, ten with Shift; a step each.
    if !script.run(app, "key Right\nkey Shift+Down\n") { return 21 }
    if layer.*.x != 14 || layer.*.y != 17 || steps(app) != before + 3 { return 22 }
    if !script.run(app, "key Ctrl+Z\nkey Ctrl+Z\nkey Ctrl+Z\n") { return 23 }
    if layer.*.x != 0 || layer.*.y != 0 || steps(app) != before || device_module.pixel(layer, 41, 31) != RED || shown(app, 41, 31) != RED { return 24 }
    // Beyond the image's top left corner and back.
    if !script.run(app, "key Shift+Left\nkey Shift+Left\nkey Shift+Left\nkey Shift+Left\nkey Shift+Left\nkey Shift+Up\nkey Shift+Up\nkey Shift+Up\n") { return 25 }
    if layer.*.x != -50 || layer.*.y != -30 || device_module.pixel(layer, -9, 1) != RED || device_module.pixel(layer, -10, 0) != BLUE || shown(app, 5, 5) != BLUE || shown(app, 5, 15) != WHITE || steps(app) != before + 8 { return 26 }
    var back: usize = 0
    while back < 8 {
        if !script.run(app, "key Ctrl+Z\n") { return 27 }
        back += 1
    }
    if layer.*.x != 0 || layer.*.y != 0 || steps(app) != before { return 28 }
    // Escape in the middle of a drag: nothing happened. While it lasts
    // the box around what moves shows (black dashes along its top row),
    // and is gone after.
    if !pointer(w, app, 50.5, 35.5) || !script.run(app, "press\n") || !pointer(w, app, 70.5, 50.5) { return 29 }
    if layer.*.x != 20 || layer.*.y != 15 || !api.toolBusy(app) { return 30 }
    if blackInRow(app, 61.0, 79.0, 45.5) == 0 { return 31 }
    if !shot(w, app, "check-move.png") { return 32 }
    if !script.run(app, "key Escape\nrelease\n") { return 33 }
    if layer.*.x != 0 || layer.*.y != 0 || steps(app) != before || api.toolBusy(app) || node.*.overlay != null { return 34 }
    if device_module.pixel(layer, 41, 31) != RED || shown(app, 41, 31) != RED || shown(app, 61, 46) != WHITE { return 35 }
    if blackInRow(app, 61.0, 79.0, 45.5) != 0 { return 36 }
    // Control and a click: the layer under the pointer is the active one
    // (where the layer on top is transparent: the white background).
    if !controlClick(w, app, 150.5, 100.5) { return 37 }
    const ground = node_module.childAt(image.*.root, 0)
    if image.*.active == null || @intFromPtr(image.*.active.?) != @intFromPtr(ground) || steps(app) != before { return 38 }
    if !controlClick(w, app, 45.5, 35.5) || @intFromPtr(image.*.active.?) != @intFromPtr(node) { return 39 }
    // A selection's pixels: cut out, moved by (30, 40), put down; the
    // selection goes with them; one step.
    select(app, geom.rect(40, 30, 10, 10))
    const selected = steps(app)
    if !drag(w, app, 45.5, 35.5, 75.5, 75.5, 10) { return 40 }
    if layer.*.x != 0 || device_module.pixel(layer, 41, 31) != 0 || device_module.pixel(layer, 45, 35) != 0 || device_module.pixel(layer, 71, 71) != RED || device_module.pixel(layer, 75, 75) != BLUE { return 41 }
    if device_module.pixel(layer, 55, 35) != BLUE || device_module.pixel(layer, 50, 30) != BLUE || device_module.pixel(layer, 80, 80) != 0 { return 42 }
    if steps(app) != selected + 1 || !std.text.same(undoName(app), "Move selection") || node.*.overlay != null { return 43 }
    if !image.*.selected || mask.at(image.*.selection, 75, 75) != 255 || mask.at(image.*.selection, 45, 35) != 0 { return 44 }
    if shown(app, 45, 35) != WHITE || shown(app, 71, 71) != RED { return 45 }
    if !script.run(app, "key Ctrl+Z\n") { return 46 }
    if device_module.pixel(layer, 41, 31) != RED || device_module.pixel(layer, 71, 71) != 0 || mask.at(image.*.selection, 45, 35) != 255 || mask.at(image.*.selection, 75, 75) != 0 || steps(app) != selected { return 47 }
    // The same on a layer whose alpha is locked: the floating pixels show
    // while they are carried (also over the hole they left), and land.
    node.*.alphaLocked = true
    if !pointer(w, app, 45.5, 35.5) || !script.run(app, "press\n") || !pointer(w, app, 48.5, 36.5) { return 180 }
    if shown(app, 44, 32) != RED || node.*.substitute == null || node.*.overlay != null { return 181 }
    if !pointer(w, app, 75.5, 75.5) || shown(app, 71, 71) != RED || shown(app, 41, 31) != WHITE { return 182 }
    if !script.run(app, "release\n") || node.*.substitute != null || device_module.pixel(layer, 71, 71) != RED || steps(app) != selected + 1 { return 183 }
    if !script.run(app, "key Ctrl+Z\n") || device_module.pixel(layer, 41, 31) != RED || device_module.pixel(layer, 71, 71) != 0 { return 184 }
    node.*.alphaLocked = false
    deselect(app)
    return 0
}

// ---------------------------------------------------------------------------
// Transform

fn transformChecks(w: *Work, app: *App) -> u8 {
    const node = api.activeNode(app).?
    const layer = node.*.device.?
    square(app, 100, 100, 10, BLUE)
    _ = settings.setText(app, "tool.transform.filter", "bilinear")
    if !script.run(app, "tool transform\n") || app.*.tool != transforms.TRANSFORM { return 50 }
    const before = steps(app)
    // The right handle to twice the width: shown before Enter, the layer
    // and the history as they were.
    if !drag(w, app, 110.0, 105.0, 120.0, 105.0, 10) { return 51 }
    if !api.toolBusy(app) || node.*.substitute == null || steps(app) != before { return 52 }
    if device_module.pixel(layer, 115, 105) != 0 || shown(app, 115, 105) != BLUE || shown(app, 105, 105) != BLUE || shown(app, 121, 105) != WHITE { return 53 }
    if !shot(w, app, "check-scale.png") { return 54 }
    if !script.run(app, "key Enter\n") { return 55 }
    // Bilinear: the edges are soft by half a source pixel each way (the
    // columns 99, 100 and 119, 120 in part), the rows exactly as they
    // were, every row as much paint as 20 whole pixels, the inside the
    // colour exactly.
    if !geom.same(device_module.exactBounds(layer), geom.rect(99, 100, 22, 10)) { return 56 }
    var y: i32 = 100
    while y < 110 {
        var x: i32 = 101
        while x < 119 {
            if device_module.pixel(layer, x, y) != BLUE { return 57 }
            x += 1
        }
        var paint: u32 = 0
        x = 99
        while x < 121 {
            paint += device_module.pixel(layer, x, y) >> 24
            x += 1
        }
        if paint != 20 * 255 || device_module.pixel(layer, 100, y) != (BLUE & 0x00FFFFFF) | (191 << 24) || device_module.pixel(layer, 99, y) != (BLUE & 0x00FFFFFF) | (64 << 24) { return 57 }
        y += 1
    }
    if node.*.substitute != null || api.toolBusy(app) || steps(app) != before + 1 || !std.text.same(undoName(app), "Transform") { return 58 }
    if !script.run(app, "key Ctrl+Z\n") { return 59 }
    if !geom.same(device_module.exactBounds(layer), geom.rect(100, 100, 10, 10)) || device_module.pixel(layer, 109, 109) != BLUE || steps(app) != before { return 60 }

    // A quarter turn with Shift (15 degree steps) is exact: what was at
    // (x, y) is at (209 - y, x).
    pattern(w, app, 100, 100, 10)
    if !script.run(app, "tool move\ntool transform\n") { return 61 }
    clear(w)
    add(w, "down Shift\ndrag ")
    place(w, app, 105.0, 78.0)
    add(w, " ")
    place(w, app, 128.0, 105.0)
    add(w, " 12\nup Shift\n")
    if !run(w, app) || !api.toolBusy(app) { return 62 }
    if !shot(w, app, "check-turn.png") { return 63 }
    if !script.run(app, "key Enter\n") { return 64 }
    y = 99
    while y <= 110 {
        var x: i32 = 99
        while x <= 110 {
            const found = device_module.pixel(layer, x, y)
            if x < 100 || x > 109 || y < 100 || y > 109 {
                if found != 0 { return 65 }
            } else if found != w.*.kept[@intCast(usize, (209 - x - 100) * 32 + (y - 100))] {
                return 66
            }
            x += 1
        }
        y += 1
    }
    if steps(app) != before + 1 { return 67 }
    if !script.run(app, "key Ctrl+Z\n") || device_module.pixel(layer, 100, 100) != w.*.kept[0] { return 68 }

    // Escape: the original pixels, the history as it was.
    if !drag(w, app, 110.0, 105.0, 120.0, 105.0, 6) || shown(app, 115, 105) == WHITE || node.*.substitute == null { return 69 }
    if !script.run(app, "key Escape\n") { return 70 }
    if node.*.substitute != null || api.toolBusy(app) || steps(app) != before || shown(app, 115, 105) != WHITE { return 71 }
    y = 0
    while y < 10 {
        var x: i32 = 0
        while x < 10 {
            if device_module.pixel(layer, 100 + x, 100 + y) != w.*.kept[@intCast(usize, y * 32 + x)] { return 72 }
            x += 1
        }
        y += 1
    }

    // Control on the top left corner: that corner alone moves.
    square(app, 100, 100, 10, BLUE)
    if !script.run(app, "tool move\ntool transform\n") { return 73 }
    clear(w)
    add(w, "down Ctrl\ndrag ")
    place(w, app, 100.0, 100.0)
    add(w, " ")
    place(w, app, 90.0, 92.0)
    add(w, " 8\nup Ctrl\n")
    if !run(w, app) || !shot(w, app, "check-perspective.png") || !script.run(app, "key Enter\n") { return 74 }
    if device_module.pixel(layer, 97, 98) >> 24 == 0 || device_module.pixel(layer, 108, 108) != BLUE || device_module.pixel(layer, 111, 111) != 0 || device_module.pixel(layer, 115, 100) != 0 { return 75 }
    const bent = device_module.exactBounds(layer)
    if bent.x > 91 || bent.y > 93 || geom.right(bent) > 111 || geom.bottom(bent) > 111 || steps(app) != before + 1 { return 76 }
    if !script.run(app, "key Ctrl+Z\n") || !geom.same(device_module.exactBounds(layer), geom.rect(100, 100, 10, 10)) { return 77 }
    // A layer of more than a million pixels (reaching far beyond the
    // image): while it is dragged the preview is made of the nearest
    // pixels where the window shows it, at the release in full.
    device_module.clear(layer)
    _ = device_module.fill(layer, geom.rect(-500, -400, 1100, 1000), BLUE)
    image_module.damageAll(api.image(app).?)
    if !script.run(app, "tool move\ntool transform\n") { return 78 }
    if !drag(w, app, 30.0, 20.0, 130.0, 70.0, 4) || !api.toolBusy(app) || shown(app, 199, 149) != BLUE || node.*.substitute == null { return 79 }
    if !script.run(app, "key Escape\n") || api.toolBusy(app) || steps(app) != before || layer.*.x != 0 || !geom.same(device_module.exactBounds(layer), geom.rect(-500, -400, 1100, 1000)) { return 48 }
    return 0
}

// The options of `tool` drawn into `area` of the work's canvas (or a
// layout pass): their height.
fn optionsFrame(w: *Work, app: *App, tool: *const state.Tool, area: ui.Rect, layout: bool) -> i32 {
    const widgets = state.uiOf(app)
    const kit = api.kit(app)
    var nowhere = view.layoutCanvas()
    const canvas = if layout { &nowhere } else { &w.*.canvas }
    view.begin(widgets, canvas)
    kit_module.resize(kit, @intCast(i32, WIDTH), @intCast(i32, HEIGHT))
    kit_module.begin(kit, widgets, canvas, state.themeOf(app), state.bodyOf(app), state.smallOf(app), state.monoOf(app), 1000000, app.*.german)
    if !layout {
        canvas_module.clear(canvas, app.*.theme.background | 0xFF000000)
        canvas_module.fillRect(canvas, area.x - 8, area.y - 8, area.width + 16, area.height + 16, app.*.theme.panel | 0xFF000000)
    }
    const height = tool.*.options.?(app, area)
    _ = kit_module.end(kit)
    _ = view.end(widgets)
    return height
}

// The warp mode by its button in the options; an inner point of the grid
// dragged.
fn warpChecks(w: *Work, app: *App) -> u8 {
    const node = api.activeNode(app).?
    const layer = node.*.device.?
    const tool = tools.byKey("transform").?
    const widgets = state.uiOf(app)
    const area = ui.rect(760, 100, 248, 600)
    if optionsFrame(w, app, tool, area, false) <= 0 { return 80 }
    const button = view.areaOf(widgets, transforms.optionId(transforms.TRANSFORM, transforms.ITEM_MODE + @intCast(usize, transforms.MODE_WARP)))
    if button.width <= 0 { return 81 }
    _ = view.pointerMove(widgets, button.x + button.width / 2, button.y + button.height / 2)
    _ = view.pointerButton(widgets, true)
    _ = optionsFrame(w, app, tool, area, false)
    _ = view.pointerButton(widgets, false)
    _ = optionsFrame(w, app, tool, area, false)
    if !std.text.same(settings.text(app, "tool.transform.mode"), "warp") { return 82 }
    _ = view.pointerLeave(widgets)
    // A 30 x 30 square of stripes; the grid's point (1, 1), at (110, 110),
    // dragged by (6, 6).
    const image = api.image(app).?
    device_module.clear(layer)
    var y: i32 = 100
    while y < 130 {
        var x: i32 = 100
        while x < 130 {
            device_module.setPixel(layer, x, y, stripes(x, y))
            x += 1
        }
        y += 1
    }
    image_module.damageAll(image)
    const before = steps(app)
    if !drag(w, app, 110.0, 110.0, 116.0, 116.0, 6) || !api.toolBusy(app) { return 83 }
    if !shot(w, app, "check-warp.png") || !script.run(app, "key Enter\n") { return 84 }
    if steps(app) != before + 1 || node.*.substitute != null { return 85 }
    // The cells away from the point are as they were, to the pixel.
    y = 120
    while y < 130 {
        var x: i32 = 120
        while x < 130 {
            if device_module.pixel(layer, x, y) != stripes(x, y) { return 86 }
            x += 1
        }
        y += 1
    }
    if device_module.pixel(layer, 129, 100) != stripes(129, 100) || device_module.pixel(layer, 129, 110) != stripes(129, 110) || device_module.pixel(layer, 100, 129) != stripes(100, 129) { return 87 }
    // Around the point they are not.
    var differ: usize = 0
    y = 101
    while y < 120 {
        var x: i32 = 101
        while x < 120 {
            if device_module.pixel(layer, x, y) != stripes(x, y) { differ += 1 }
            x += 1
        }
        y += 1
    }
    if differ < 20 { return 88 }
    if !script.run(app, "key Ctrl+Z\n") || device_module.pixel(layer, 113, 113) != stripes(113, 113) || steps(app) != before { return 89 }
    _ = settings.setText(app, "tool.transform.mode", "free")
    // A part of the layer selected, moved by 40 to the right: a hole, the
    // part over there, the rest where it was, the selection moved along.
    square(app, 100, 100, 30, BLUE)
    select(app, geom.rect(100, 100, 24, 24))
    if !script.run(app, "tool move\ntool transform\n") { return 90 }
    const selected = steps(app)
    if !drag(w, app, 106.0, 118.0, 146.0, 118.0, 8) || !script.run(app, "key Enter\n") { return 91 }
    if device_module.pixel(layer, 105, 105) != 0 || device_module.pixel(layer, 127, 105) != BLUE || device_module.pixel(layer, 145, 105) != BLUE || device_module.pixel(layer, 163, 123) != BLUE || device_module.pixel(layer, 165, 105) != 0 { return 92 }
    if steps(app) != selected + 1 || mask.at(image.*.selection, 150, 110) != 255 || mask.at(image.*.selection, 105, 105) != 0 { return 93 }
    if !script.run(app, "key Ctrl+Z\n") || device_module.pixel(layer, 105, 105) != BLUE || device_module.pixel(layer, 145, 105) != 0 || mask.at(image.*.selection, 105, 105) != 255 { return 94 }
    deselect(app)
    return 0
}

// Where the transform tool is told the pointer is: image point (x, y).
fn inputAt(app: *App, x: f64, y: f64) -> state.Input {
    var wx: i32 = 0
    var wy: i32 = 0
    windowPixel(app, x, y, &wx, &wy)
    return state.Input.{ .x = x, .y = y, .windowX = wx, .windowY = wy, .pressure = 1.0, .tiltX = 0.0, .tiltY = 0.0, .rotation = 0.0, .time = 0.0, .button = 272, .buttons = 1, .modifiers = 0, .clicks = 1 }
}

// A warp dragged about many times: the value arena stays as it was.
fn arenaChecks(w: *Work, app: *App) -> u8 {
    square(app, 100, 100, 30, BLUE)
    _ = settings.setText(app, "tool.transform.mode", "warp")
    if !script.run(app, "tool move\ntool transform\n") { return 95 }
    const tool = tools.byKey("transform").?
    var input = inputAt(app, 110.0, 110.0)
    tool.*.press.?(app, &input)
    if !api.toolBusy(app) { return 96 }
    const arena = turns.locate()
    const start = turns.used(arena)
    var round: i32 = 0
    while round < 40 {
        input = inputAt(app, 110.0 + @floatFromInt(f64, round % 7), 110.0 + @floatFromInt(f64, round % 5))
        tool.*.move.?(app, &input)
        round += 1
    }
    tool.*.release.?(app, &input)
    if turns.used(arena) - start > 65536 { return 97 }
    tool.*.cancel.?(app)
    _ = settings.setText(app, "tool.transform.mode", "free")
    if api.toolBusy(app) || api.activeNode(app).?.*.substitute != null { return 98 }
    return 0
}

// ---------------------------------------------------------------------------
// Crop

// The frame's pixel a little inside the canvas area's top left corner
// (the ground around the image).
fn groundPixel(app: *App) -> u32 {
    const frame = script.frameOf(app).?
    const area = api.document(app).?.*.view.area
    return frame.*.pixels[@intCast(usize, area.y + 4) * frame.*.stride + @intCast(usize, area.x + 4)]
}

fn cropChecks(w: *Work, app: *App) -> u8 {
    const image = api.image(app).?
    const node = api.activeNode(app).?
    const layer = node.*.device.?
    const ground = node_module.childAt(image.*.root, 0).*.device.?
    device_module.clear(layer)
    device_module.setPixel(layer, 60, 50, RED)
    device_module.setPixel(layer, 100, 80, GREEN)
    device_module.setPixel(layer, 149, 119, BLUE)
    device_module.setPixel(layer, 10, 10, RED)
    image_module.damageAll(image)
    if !script.run(app, "tool crop\n") || app.*.tool != transforms.CROP { return 100 }
    const before = steps(app)
    const plain = groundPixel(app)
    // Escape: nothing, and the darkening goes.
    if !drag(w, app, 50.0, 40.0, 149.0, 119.0, 8) || !api.toolBusy(app) { return 101 }
    const darker = groundPixel(app)
    if (darker & 255) >= (plain & 255) || ((darker >> 8) & 255) >= ((plain >> 8) & 255) { return 102 }
    if !shot(w, app, "check-crop.png") { return 103 }
    if !script.run(app, "key Escape\n") || api.toolBusy(app) || image.*.width != 200 || steps(app) != before { return 104 }
    if !script.run(app, "wait 20\n") || groundPixel(app) != plain { return 105 }
    // A rectangle from (50, 40) to (149, 119), both in.
    if !drag(w, app, 50.0, 40.0, 149.0, 119.0, 8) || !script.run(app, "key Enter\n") { return 106 }
    if image.*.width != 100 || image.*.height != 80 || api.toolBusy(app) { return 107 }
    if device_module.pixel(layer, 10, 10) != RED || device_module.pixel(layer, 50, 40) != GREEN || device_module.pixel(layer, 99, 79) != BLUE || layer.*.x != -50 || layer.*.y != -40 { return 108 }
    if ground.*.x != -50 || device_module.pixel(ground, 0, 0) != WHITE || device_module.pixel(ground, 99, 79) != WHITE { return 109 }
    if shown(app, 10, 10) != RED || shown(app, 50, 40) != GREEN || shown(app, 0, 0) != WHITE { return 110 }
    if steps(app) != before + 1 || !std.text.same(undoName(app), "Crop") { return 111 }
    if !script.run(app, "key Ctrl+Z\n") { return 112 }
    if image.*.width != 200 || image.*.height != 150 || layer.*.x != 0 || device_module.pixel(layer, 60, 50) != RED || device_module.pixel(layer, 10, 10) != RED || shown(app, 60, 50) != RED || shown(app, 10, 10) != RED || steps(app) != before { return 113 }
    if !script.run(app, "key Ctrl+Shift+Z\n") || image.*.width != 100 || shown(app, 10, 10) != RED { return 114 }
    if !script.run(app, "key Ctrl+Z\n") || image.*.width != 200 { return 115 }
    // Only the layer: cleared outside, the size as it was.
    _ = settings.setText(app, "tool.crop.layer", "1")
    if !script.run(app, "tool move\ntool crop\n") { return 116 }
    if !drag(w, app, 50.0, 40.0, 149.0, 119.0, 8) || !script.run(app, "key Enter\n") { return 117 }
    if image.*.width != 200 || device_module.pixel(layer, 10, 10) != 0 || device_module.pixel(layer, 60, 50) != RED || device_module.pixel(layer, 149, 119) != BLUE || steps(app) != before + 1 { return 118 }
    if !script.run(app, "key Ctrl+Z\n") || device_module.pixel(layer, 10, 10) != RED { return 119 }
    _ = settings.setText(app, "tool.crop.layer", "0")
    // Beyond the image: the canvas grows.
    _ = settings.setText(app, "tool.crop.grow", "1")
    if !script.run(app, "tool move\ntool crop\n") { return 120 }
    if !drag(w, app, -20.0, -10.0, 219.0, 159.0, 8) || !script.run(app, "key Enter\n") { return 121 }
    if image.*.width != 240 || image.*.height != 170 || device_module.pixel(layer, 80, 60) != RED || shown(app, 80, 60) != RED || shown(app, 5, 5) != 0 { return 122 }
    if !script.run(app, "key Ctrl+Z\n") || image.*.width != 200 || device_module.pixel(layer, 60, 50) != RED { return 123 }
    _ = settings.setText(app, "tool.crop.grow", "0")
    return 0
}

// ---------------------------------------------------------------------------
// The options

// The options of tool `name` as pictures: dark, light and German, each
// after a layout pass. Their height into `height`.
fn optionsPictures(w: *Work, app: *App, name: []const u8, area: ui.Rect, height: *i32) -> u8 {
    var look: usize = 0
    while look < 3 {
        const failed = optionsPicture(w, app, name, area, look, if look == 0 { "-dark.png" } else if look == 1 { "-light.png" } else { "-german.png" }, height)
        if failed != 0 { return failed }
        look += 1
    }
    // As narrow and as wide as a docker may be.
    var failed = optionsPicture(w, app, name, ui.rect(808, 60, 200, 690), 0, "-narrow.png", height)
    if failed != 0 { return failed }
    failed = optionsPicture(w, app, name, ui.rect(688, 60, 320, 690), 0, "-wide.png", height)
    if failed != 0 { return failed }
    return 0
}

// One picture: `look` 0 dark, 1 light, 2 German.
fn optionsPicture(w: *Work, app: *App, name: []const u8, area: ui.Rect, look: usize, suffix: []const u8, height: *i32) -> u8 {
    const tool = tools.byKey(name).?
    app.*.theme = theme_module.scaled(if look == 1 { theme_module.light() } else { theme_module.dark() }, 1)
    app.*.german = look == 2
    if optionsFrame(w, app, tool, area, true) <= 0 { return 140 }
    height.* = optionsFrame(w, app, tool, area, false)
    if height.* <= 0 || height.* > area.height { return 141 }
    var text: [64]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 64, "options-")
    length = std.text.append(bytes, length, 64, name)
    length = std.text.append(bytes, length, 64, suffix)
    // The panel and a little of what is around it, as tall as it is.
    const shown_area = ui.intersect(ui.rect(area.x - 16, area.y - 16, area.width + 24, height.* + 32), ui.rect(0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT)))
    if !save(w, app, bytes[0..length], shown_area) { return 142 }
    // Nothing drawn outside the panel's ground.
    if w.*.pixels[10 * WIDTH + 10] != (app.*.theme.background | 0xFF000000) { return 143 }
    app.*.german = false
    app.*.theme = theme_module.scaled(theme_module.dark(), 1)
    return 0
}

// A click on the widget `id` of `tool`'s options, as the window would
// bring it: a frame names the regions, the button goes down and up over
// it, the next frame takes the click.
fn clickOption(w: *Work, app: *App, tool: *const state.Tool, id: u64, area: ui.Rect) -> bool {
    const widgets = state.uiOf(app)
    _ = optionsFrame(w, app, tool, area, false)
    const button = view.areaOf(widgets, id)
    if button.width <= 0 { return false }
    _ = view.pointerMove(widgets, button.x + button.width / 2, button.y + button.height / 2)
    _ = view.pointerButton(widgets, true)
    _ = optionsFrame(w, app, tool, area, false)
    _ = view.pointerButton(widgets, false)
    _ = optionsFrame(w, app, tool, area, false)
    _ = view.pointerLeave(widgets)
    return true
}

fn optionsChecks(w: *Work, app: *App) -> u8 {
    const area = ui.rect(760, 60, 248, 690)
    var height: i32 = 0
    if !script.run(app, "tool move\n") { return 145 }
    var failed = optionsPictures(w, app, "move", area, &height)
    if failed != 0 { return failed }
    // The transform's while one is open: its numbers live, Apply and
    // Cancel to be pressed. Apply applies: one step.
    _ = settings.setText(app, "tool.transform.mode", "free")
    if !script.run(app, "tool transform\n") || !drag(w, app, 150.0, 65.0, 170.0, 65.0, 6) || !api.toolBusy(app) { return 146 }
    failed = optionsPictures(w, app, "transform", area, &height)
    if failed != 0 { return failed }
    const before = steps(app)
    const transform_tool = tools.byKey("transform").?
    if !clickOption(w, app, transform_tool, transforms.optionId(transforms.TRANSFORM, transforms.ITEM_APPLY), area) { return 147 }
    if api.toolBusy(app) || steps(app) != before + 1 || !std.text.same(undoName(app), "Transform") { return 148 }
    if !script.run(app, "key Ctrl+Z\n") || steps(app) != before { return 149 }
    // A width typed into the options (a click opens the number, its text
    // chosen; what is typed takes its place; Enter takes it): the pixels
    // lifted, the box 70 wide, its top left corner where it was. Enter
    // applies.
    const layer = layerOf(app)
    const kit = api.kit(app)
    const width_id = transforms.optionId(transforms.TRANSFORM, transforms.ITEM_WIDTH)
    if !geom.same(device_module.exactBounds(layer), geom.rect(10, 10, 140, 110)) { return 170 }
    if !clickOption(w, app, transform_tool, width_id, area) || !kit_module.editing(kit, width_id) { return 174 }
    _ = kit_module.key(kit, 8, 0, "7")
    _ = kit_module.key(kit, 11, 0, "0")
    _ = kit_module.key(kit, keys.ENTER, 0, "")
    _ = optionsFrame(w, app, transform_tool, area, false)
    if !api.toolBusy(app) || layerOf(app).*.x != 0 || steps(app) != before { return 175 }
    if !script.run(app, "key Enter\n") || api.toolBusy(app) || steps(app) != before + 1 { return 176 }
    const narrow = device_module.exactBounds(layer)
    if narrow.x < 9 || narrow.x > 10 || narrow.y != 10 || geom.right(narrow) < 79 || geom.right(narrow) > 81 || geom.bottom(narrow) != 120 { return 177 }
    if !script.run(app, "key Ctrl+Z\n") || !geom.same(device_module.exactBounds(layer), geom.rect(10, 10, 140, 110)) { return 178 }
    // The crop's with a rectangle.
    if !script.run(app, "tool crop\n") || !drag(w, app, 20.0, 20.0, 119.0, 89.0, 6) || !api.toolBusy(app) { return 171 }
    failed = optionsPictures(w, app, "crop", area, &height)
    if failed != 0 { return failed }
    const crop_tool = tools.byKey("crop").?
    if !clickOption(w, app, crop_tool, transforms.optionId(transforms.CROP, transforms.ITEM_CANCEL), area) || api.toolBusy(app) { return 172 }
    if api.image(app).?.*.width != 200 || layer.*.x != 0 { return 173 }
    return 0
}

// ---------------------------------------------------------------------------
// Pictures of the tools at work on a picture of some size

// A row of the scene: a warm paper ground is the background layer's; on
// the layer above a card of a blue to teal gradient with light bands and
// a soft orange disc.
fn sceneRow(w: *Work, y: i32, width: i32) -> void {
    var x: i32 = 0
    while x < width {
        var color: u32 = 0
        if x >= 150 && x < 330 && y >= 100 && y < 230 {
            const t = @intCast(u32, (y - 100) * 255 / 129)
            const r = (58 * (255 - t) + 43 * t) / 255
            const g = (110 * (255 - t) + 176 * t) / 255
            const b = (165 * (255 - t) + 160 * t) / 255
            color = 0xFF000000 | (r << 16) | (g << 8) | b
            if (x - 150) % 30 < 4 { color = 0xFFE8F1F4 }
        }
        const dx = @floatFromInt(f64, x - 370) + 0.5
        const dy = @floatFromInt(f64, y - 90) + 0.5
        const cover = 34.5 - @sqrt(dx * dx + dy * dy)
        if cover > 0.0 {
            const alpha = if cover >= 1.0 { 255 } else { @intFromFloat(u32, cover * 255.0) }
            color = (alpha << 24) | 0x00F2A541
        }
        w.*.kept[@intCast(usize, x)] = color
        x += 1
    }
}

fn showcase(w: *Work, app: *App) -> u8 {
    if !script.run(app, "new 480 360 F4F1EA\n") { return 150 }
    const layer = layerOf(app)
    var y: i32 = 0
    while y < 360 {
        sceneRow(w, y, 480)
        const row: [*]const u32 = &w.*.kept
        _ = device_module.writeRect(layer, geom.rect(0, y, 480, 1), row, 480)
        y += 1
    }
    image_module.damageAll(api.image(app).?)
    if !geom.same(device_module.exactBounds(layer), geom.rect(150, 56, 254, 174)) { return 151 }
    _ = settings.setText(app, "tool.transform.mode", "free")
    // Transform: made larger by its bottom right corner in proportion,
    // then turned, the angle shown while it turns.
    if !script.run(app, "tool move\ntool transform\ndown Shift\n") { return 152 }
    if !drag(w, app, 404.0, 230.0, 429.0, 248.0, 8) || !script.run(app, "up Shift\n") { return 153 }
    if !pointer(w, app, 460.0, 120.0) || !script.run(app, "press\n") || !pointer(w, app, 455.0, 178.0) { return 154 }
    if !shot(w, app, "transform.png") { return 155 }
    if !script.run(app, "release\nkey Escape\n") || api.toolBusy(app) { return 156 }
    // The warp: the grid's point (1, 1) pulled.
    _ = settings.setText(app, "tool.transform.mode", "warp")
    if !script.run(app, "tool move\ntool transform\n") { return 157 }
    if !pointer(w, app, 234.67, 114.0) || !script.run(app, "press\n") || !pointer(w, app, 262.0, 146.0) { return 158 }
    if !shot(w, app, "transform-warp.png") { return 159 }
    if !script.run(app, "release\nkey Escape\n") { return 160 }
    _ = settings.setText(app, "tool.transform.mode", "free")
    // Perspective: the top right corner with Control.
    if !script.run(app, "tool move\ntool transform\ndown Ctrl\n") { return 161 }
    if !pointer(w, app, 404.0, 56.0) || !script.run(app, "press\n") || !pointer(w, app, 380.0, 92.0) || !script.run(app, "release\nup Ctrl\n") { return 162 }
    if !shot(w, app, "transform-perspective.png") || !script.run(app, "key Escape\n") { return 163 }
    // Move: a selected part of the card lifted and carried.
    select(app, geom.rect(180, 120, 90, 70))
    if !script.run(app, "tool move\n") { return 164 }
    if !pointer(w, app, 220.0, 150.0) || !script.run(app, "press\n") || !pointer(w, app, 268.0, 205.0) { return 165 }
    if !shot(w, app, "move.png") { return 166 }
    if !script.run(app, "key Escape\nrelease\n") { return 167 }
    deselect(app)
    // Crop: a rectangle, the rest darker.
    if !script.run(app, "tool crop\n") || !drag(w, app, 110.0, 60.0, 419.0, 279.0, 8) { return 168 }
    if !shot(w, app, "crop.png") || !script.run(app, "key Escape\n") { return 169 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const made = script.headless(allocator)
    if made == null { return 1 }
    const app = made.?
    const memory = allocator.alloc(@sizeOf(Work), 16)
    const canvas = allocator.alloc(WIDTH * HEIGHT * 4, 16)
    if memory == null || canvas == null { return 2 }
    const w: *Work = unsafe { @ptrCast(*Work, memory.?) }
    w.*.shots = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { w.*.shots = std.string.asSlice(named.?) }
    unsafe { w.*.pixels = @ptrCast([*]u32, canvas.?) }
    w.*.canvas = Canvas.{ .pixels = w.*.pixels, .width = WIDTH, .height = HEIGHT, .stride = WIDTH, .swapRedBlue = false, .device = 0, .opacity = 255 }
    if !script.run(app, "size 1024 768\nnew 200 150 FFFFFF\n") { return 3 }
    if api.image(app).?.*.width != 200 || api.document(app).?.*.view.zoom != 1.0 { return 4 }
    var failed = moveChecks(w, app)
    if failed != 0 { return failed }
    failed = transformChecks(w, app)
    if failed != 0 { return failed }
    failed = warpChecks(w, app)
    if failed != 0 { return failed }
    failed = arenaChecks(w, app)
    if failed != 0 { return failed }
    failed = cropChecks(w, app)
    if failed != 0 { return failed }
    failed = optionsChecks(w, app)
    if failed != 0 { return failed }
    failed = showcase(w, app)
    if failed != 0 { return failed }
    return 13
}
