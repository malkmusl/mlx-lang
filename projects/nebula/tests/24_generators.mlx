// nebula's generators (generators/registry.mlx, noise.mlx, patterns.mlx)
// and the Gradient Map filter (filters/gradientmap.mlx): every generator
// is in the list once (ids, keys, names, numbers described in range,
// defaults at their initial values); each renders a single pixel and
// 300 x 200 at the low and high ends of its numbers, at numbers that are
// none (then as at its defaults) and without end, and a picture made in
// blocks (64 pixels, and odd pieces from negative places) is the picture
// made at once, bit for bit. Color is exact; Gradient is gradient.render
// over the image; Checker and Stripes put their colours where they
// belong; every built-in pattern is drawn, not blank, without a seam,
// and laid out twice is the tile twice; Simplex Noise is the same for a
// seed and another for another, uses most of the range, and tileable it
// repeats at the image's size and runs on across the edge; Screentone at
// the ends of its brightness is all background or all foreground;
// Multigrid's cells take their colours by de Bruijn's index; the
// Gradient Map sends black, white and mid grey to the gradient's ends
// and middle, keeps alpha, dithers within a step, and filters in pieces
// what it filters at once. Rendering again and again takes no memory of
// the value arena or the heap; at the ends of the coordinates every
// generator renders, in blocks as at once. Prints the megapixels a
// second of a linear and a radial gradient and of simplex noise.
// Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const generators = @import("../generators/registry.mlx")
const patterns = @import("../generators/patterns.mlx")
const noise = @import("../generators/noise.mlx")
const filters = @import("../filters/registry.mlx")
const gradientmap = @import("../filters/gradientmap.mlx")
const types = @import("../filters/types.mlx")
const gradient = @import("../core/gradient.mlx")
const node = @import("../core/node.mlx")
const geom = @import("../core/geom.mlx")
const pixel = @import("../core/pixel.mlx")
const color = @import("../core/color.mlx")

const Params = generators.Params

const WIDE: usize = 300
const HIGH: usize = 200

fn words(count: usize) -> [*]u32 {
    const memory = std.heap.allocator().alloc(count * 4, 16).?
    unsafe { return @ptrCast([*]u32, memory) }
}

fn gap(a: u32, b: u32) -> u32 {
    return if a > b { a - b } else { b - a }
}

// The largest difference of a channel, alpha included.
fn apart(a: u32, b: u32) -> u32 {
    var most = gap(a >> 24, b >> 24)
    most = pixel.larger(most, gap(pixel.red(a), pixel.red(b)))
    most = pixel.larger(most, gap(pixel.green(a), pixel.green(b)))
    return pixel.larger(most, gap(pixel.blue(a), pixel.blue(b)))
}

fn countOf(choices: []const u8) -> usize {
    var count: usize = 1
    for byte in choices {
        if byte == 124 { count += 1 }
    }
    return count
}

fn same(a: [*]const u32, b: [*]const u32, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// ---- The list -------------------------------------------------------------------

fn listed() -> u8 {
    if generators.count() < 8 || generators.list().length != generators.count() { return 1 }
    var index: usize = 0
    while index < generators.count() {
        const info = generators.at(index)
        if info == null { return 2 }
        const found = generators.find(info.?.*.id)
        if found == null || @intFromPtr(found.?) != @intFromPtr(info.?) { return 3 }
        const keyed = generators.byKey(info.?.*.key)
        if keyed == null || @intFromPtr(keyed.?) != @intFromPtr(info.?) { return 4 }
        if info.?.*.key.length == 0 || info.?.*.name.length == 0 || info.?.*.german.length == 0 { return 5 }
        if info.?.*.category >= generators.CATEGORIES || generators.categoryName(info.?.*.category, true).length == 0 { return 6 }
        var other: usize = 0
        while other < index {
            const before = generators.at(other).?
            if before.*.id == info.?.*.id || std.text.same(before.*.key, info.?.*.key) { return 7 }
            other += 1
        }
        // Its numbers: described, in range, the defaults their initial
        // values.
        const rows = info.?.*.params
        if rows.length > node.VALUES { return 8 }
        var params: Params = undefined
        generators.defaults(info.?.*.id, &params)
        if params.id != info.?.*.id || params.textLength != 0 { return 9 }
        var place: usize = 0
        while place < rows.length {
            const row = &rows[place]
            if row.*.name.length == 0 || row.*.german.length == 0 || row.*.kind > types.TEXT { return 10 }
            if !(row.*.low <= row.*.initial && row.*.initial <= row.*.high) { return 11 }
            if params.values[place] != row.*.initial { return 12 }
            if row.*.kind == types.CHOICE {
                const choices = @intFromFloat(usize, row.*.high) + 1
                if row.*.low != 0.0 || countOf(row.*.choices) != choices || countOf(row.*.choicesGerman) != choices { return 13 }
            }
            if row.*.kind == types.BOOL && (row.*.low != 0.0 || row.*.high != 1.0) { return 14 }
            place += 1
        }
        while place < node.VALUES {
            if params.values[place] != 0.0 { return 15 }
            place += 1
        }
        index += 1
    }
    if generators.at(generators.count()) != null || generators.find(999) != null || generators.byKey("nothing") != null { return 16 }
    if generators.find(generators.COLOR) == null || generators.byKey("simplex_noise") == null || generators.byKey("gradient") == null { return 17 }
    // A number that is none: transparent, and said so.
    var unknown: Params = undefined
    node.clearParams(&unknown)
    unknown.id = 999
    const buffer = words(16)
    buffer[3] = 0x12345678
    if generators.render(&unknown, geom.rect(0, 0, 4, 4), buffer, 4, 4, 4) || buffer[3] != 0 { return 18 }
    return 0
}

// ---- Every generator at its ends ----------------------------------------------------

// Numbers of generator `id`: 0 its defaults, 1 the low ends, 2 the high
// ends, 3 numbers that are none, 4 beyond the ends without end.
fn setTo(id: u16, mode: u32, params: *Params) -> void {
    generators.defaults(id, params)
    if mode == 0 { return }
    const rows = generators.paramsOf(id)
    var place: usize = 0
    while place < rows.length {
        if mode == 1 { params.*.values[place] = rows[place].low }
        if mode == 2 { params.*.values[place] = rows[place].high }
        if mode == 3 { params.*.values[place] = math.nan() }
        if mode == 4 { params.*.values[place] = if place % 2 == 0 { math.infinity() } else { math.negativeInfinity() } }
        place += 1
    }
}

fn extremes() -> u8 {
    const buffer = words(WIDE * HIGH)
    const plain = words(WIDE * HIGH)
    var params: Params = undefined
    var index: usize = 0
    while index < generators.count() {
        const id = generators.at(index).?.*.id
        var mode: u32 = 0
        while mode < 5 {
            setTo(id, mode, &params)
            // A single pixel of a single pixel's image, one at a far place,
            // and a picture.
            if !generators.render(&params, geom.rect(0, 0, 1, 1), buffer, 1, 1, 1) { return 20 }
            if !generators.render(&params, geom.rect(-2000000, 1500000, 3, 2), buffer, 3, 1, 1) { return 21 }
            if !generators.render(&params, geom.rect(0, 0, @intCast(i32, WIDE), @intCast(i32, HIGH)), buffer, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH)) { return 22 }
            if !generators.render(&params, geom.rect(-50, -50, 30, 30), buffer, 30, 0, -5) { return 23 }
            if mode == 0 {
                _ = generators.render(&params, geom.rect(0, 0, @intCast(i32, WIDE), @intCast(i32, HIGH)), plain, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH))
            }
            if mode == 3 {
                // Numbers that are none are the initial ones.
                _ = generators.render(&params, geom.rect(0, 0, @intCast(i32, WIDE), @intCast(i32, HIGH)), buffer, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH))
                if !same(buffer, plain, WIDE * HIGH) { return 24 }
            }
            mode += 1
        }
        // An empty area is no work and writes nothing.
        generators.defaults(id, &params)
        buffer[0] = 0x12345678
        if !generators.render(&params, geom.rect(0, 0, 0, 7), buffer, 1, 10, 10) || !generators.render(&params, geom.rect(0, 0, 7, -1), buffer, 7, 10, 10) || buffer[0] != 0x12345678 { return 25 }
        index += 1
    }
    return 0
}

// ---- Pieces equal the whole -------------------------------------------------------------

// Generator `id` with numbers that exercise it (repeats, dithering,
// turns, octaves, colour).
fn busy(id: u16, params: *Params) -> void {
    generators.defaults(id, params)
    if id == generators.COLOR {
        params.*.values[0] = 12.0
        params.*.values[3] = 200.0
    } else if id == generators.GRADIENT {
        node.setParamsText(params, "hsv-cw;0:#ff0000;0.3:fg@0.3/s;0.6:#00ff0080/c;1:bg")
        params.*.values[1] = 6.0
        params.*.values[2] = 2.0
        params.*.values[4] = 1.0
        params.*.values[5] = 0.31
        params.*.values[6] = 0.47
        params.*.values[7] = 0.62
        params.*.values[8] = 0.13
    } else if id == generators.PATTERN {
        params.*.values[0] = @floatFromInt(f64, patterns.BRICKS)
        params.*.values[1] = 0.7
        params.*.values[2] = 33.0
        params.*.values[3] = 17.0
        params.*.values[4] = -9.0
    } else if id == generators.SIMPLEX_NOISE {
        params.*.values[1] = 4.0
        params.*.values[5] = 77.0
        params.*.values[6] = 1.0
        params.*.values[7] = 1.0
    } else if id == generators.SCREENTONE {
        params.*.values[1] = 1.0
        params.*.values[3] = 15.0
        params.*.values[4] = 20.0
    } else if id == generators.MULTIGRID {
        params.*.values[0] = 7.0
        params.*.values[1] = 23.0
        params.*.values[4] = 10.0
    } else if id == generators.STRIPES {
        params.*.values[0] = 7.5
        params.*.values[1] = 31.0
    }
}

fn pieces() -> u8 {
    const whole = words(WIDE * HIGH)
    const piece = words(WIDE * HIGH)
    const area = geom.rect(-37, -21, @intCast(i32, WIDE), @intCast(i32, HIGH))
    var params: Params = undefined
    var index: usize = 0
    while index < generators.count() {
        const id = generators.at(index).?.*.id
        busy(id, &params)
        _ = generators.render(&params, area, whole, WIDE, 400, 300)
        // Blocks of 64 from the area's corner, then odd pieces.
        var round: u32 = 0
        while round < 2 {
            const step_x: i32 = if round == 0 { 64 } else { 37 }
            const step_y: i32 = if round == 0 { 64 } else { 23 }
            var by: i32 = 0
            while by < area.height {
                var bx: i32 = 0
                while bx < area.width {
                    const block = geom.intersect(geom.rect(area.x + bx, area.y + by, step_x, step_y), area)
                    _ = generators.render(&params, block, piece, @intCast(usize, block.width), 400, 300)
                    var line: i32 = 0
                    while line < block.height {
                        var column: i32 = 0
                        while column < block.width {
                            if piece[@intCast(usize, line * block.width + column)] != whole[@intCast(usize, (by + line) * area.width + bx + column)] { return 30 + @intCast(u8, index) }
                            column += 1
                        }
                        line += 1
                    }
                    bx += step_x
                }
                by += step_y
            }
            round += 1
        }
        // A stride wider than the area leaves the rest of a row alone.
        piece[5] = 0x11111111
        _ = generators.render(&params, geom.rect(area.x, area.y, 5, 2), piece, 300, 400, 300)
        if piece[5] != 0x11111111 || piece[0] != whole[0] || piece[304] != whole[WIDE + 4] { return 40 }
        index += 1
    }
    return 0
}

// ---- Color, Gradient, Checker, Stripes ----------------------------------------------------

fn plainOnes() -> u8 {
    const buffer = words(WIDE * HIGH)
    const other = words(WIDE * HIGH)
    var params: Params = undefined
    // Color: exact, and nothing but it.
    generators.defaults(generators.COLOR, &params)
    params.values[0] = 10.0
    params.values[1] = 20.0
    params.values[2] = 30.0
    params.values[3] = 40.0
    if !generators.render(&params, geom.rect(-5, 3, 20, 10), buffer, 20, 10, 10) { return 50 }
    var index: usize = 0
    while index < 200 {
        if buffer[index] != 0x280A141E { return 51 }
        index += 1
    }
    params.values[3] = 0.0
    _ = generators.render(&params, geom.rect(0, 0, 2, 1), buffer, 2, 10, 10)
    if buffer[0] != 0 || buffer[1] != 0 { return 52 }
    params.values[0] = 300.0
    params.values[1] = -4.0
    params.values[2] = 127.4
    params.values[3] = 254.6
    _ = generators.render(&params, geom.rect(0, 0, 1, 1), buffer, 1, 10, 10)
    if buffer[0] != 0xFFFF007F { return 53 }

    // Gradient: gradient.render over the image, start and end as parts
    // of its size.
    generators.defaults(generators.GRADIENT, &params)
    const text = "linear;0:#102030;0.4:fg@0.7/i;0.4:#ff800080;1:bg"
    node.setParamsText(&params, text)
    params.values[1] = @floatFromInt(f64, gradient.SPIRAL)
    params.values[2] = @floatFromInt(f64, gradient.ALTERNATING)
    params.values[3] = 1.0
    params.values[4] = 1.0
    params.values[5] = 0.25
    params.values[6] = 0.5
    params.values[7] = 0.6
    params.values[8] = 0.9
    params.values[9] = 0.1
    params.values[10] = @floatFromInt(f64, 0xFF22CC44)
    params.values[11] = @floatFromInt(f64, 0x80405060)
    _ = generators.render(&params, geom.rect(-10, -20, 280, 190), buffer, 280, 300, 200)
    var shown: gradient.Gradient = undefined
    if !gradient.parse(text, &shown) { return 54 }
    gradient.render(&shown, gradient.SPIRAL, gradient.ALTERNATING, true, true, 75.0, 100.0, 180.0, 180.0, geom.rect(-10, -20, 280, 190), other, 280, 0xFF22CC44, 0x80405060, 0.1)
    if !same(buffer, other, 280 * 190) { return 55 }
    // Its defaults: black to white from the left edge to the right one
    // (pixel i's centre is (i + 0.5) / 256 of the way).
    generators.defaults(generators.GRADIENT, &params)
    _ = generators.render(&params, geom.rect(0, 0, 256, 1), buffer, 256, 256, 1)
    index = 0
    while index < 256 {
        // (Mixed in OKLab, the default: even steps of its lightness L, the
        // grey of L = the place.)
        const place = (@floatFromInt(f64, index) + 0.5) / 256.0
        if apart(buffer[index], color.fromOklab(place, 0.0, 0.0, 255)) > 1 { return 56 }
        index += 1
    }
    if pixel.red(buffer[0]) > 1 || pixel.red(buffer[255]) < 254 || buffer[255] >> 24 != 255 { return 57 }
    // A text that is no gradient is black to white too.
    node.setParamsText(&params, "0:#zz")
    _ = generators.render(&params, geom.rect(0, 0, 256, 1), other, 256, 256, 1)
    if !same(buffer, other, 256) { return 58 }

    // Checker: colour 1 where the corner's square is, below and left of
    // the corner too.
    generators.defaults(generators.CHECKER, &params)
    params.values[0] = 10.0
    params.values[1] = @floatFromInt(f64, 0xFF0000FF)
    params.values[2] = @floatFromInt(f64, 0xFFFF0000)
    _ = generators.render(&params, geom.rect(-20, -20, 40, 40), buffer, 40, 100, 100)
    var y: usize = 0
    while y < 40 {
        var x: usize = 0
        while x < 40 {
            const odd = ((x / 10) + (y / 10)) % 2 == 1
            const wanted: u32 = if odd { 0xFFFF0000 } else { 0xFF0000FF }
            if buffer[y * 40 + x] != wanted { return 59 }
            x += 1
        }
        y += 1
    }

    // Stripes: across, 16 rows of each, colour 1 from the corner on;
    // turned, both colours and their mixes at the edges.
    generators.defaults(generators.STRIPES, &params)
    _ = generators.render(&params, geom.rect(0, -32, 3, 96), buffer, 3, 100, 100)
    y = 0
    while y < 96 {
        const first = ((y / 16) % 2) == 0
        const wanted: u32 = if first { pixel.WHITE } else { pixel.BLACK }
        if buffer[y * 3] != wanted || buffer[y * 3 + 2] != wanted { return 60 }
        y += 1
    }
    params.values[1] = 30.0
    _ = generators.render(&params, geom.rect(0, 0, 100, 100), buffer, 100, 100, 100)
    var whites: usize = 0
    var blacks: usize = 0
    var mixes: usize = 0
    index = 0
    while index < 10000 {
        if buffer[index] == pixel.WHITE {
            whites += 1
        } else if buffer[index] == pixel.BLACK {
            blacks += 1
        } else {
            mixes += 1
        }
        index += 1
    }
    if whites < 3500 || blacks < 3500 || mixes < 300 || mixes > 2000 { return 61 }
    return 0
}

// ---- The built-in patterns ---------------------------------------------------------------------

// The mean difference of the grey of two columns (`across`) or two rows
// of a tile.
fn edgeOf(tile: [*]const u32, size: usize, first: usize, second: usize, across: bool) -> u64 {
    var total: u64 = 0
    var index: usize = 0
    while index < size {
        const a = if across { tile[index * size + first] } else { tile[first * size + index] }
        const b = if across { tile[index * size + second] } else { tile[second * size + index] }
        total += @intCast(u64, gap(pixel.luma(a), pixel.luma(b)))
        index += 1
    }
    return total
}

fn tiles() -> u8 {
    if patterns.count() < 16 { return 70 }
    const buffer = words(256 * 256)
    var params: Params = undefined
    var index: usize = 0
    while index < patterns.count() {
        if patterns.name(index, false).length == 0 || patterns.name(index, true).length == 0 { return 71 }
        var width: usize = 0
        var height: usize = 0
        const tile = patterns.pattern(index, &width, &height)
        if tile == null || width != height || (width != 64 && width != 128) { return 72 }
        const size = width
        // Not blank: a spread of greys, every pixel opaque.
        var darkest: u32 = 255
        var lightest: u32 = 0
        var pixel_index: usize = 0
        while pixel_index < size * size {
            const value = tile.?[pixel_index]
            if value >> 24 != 255 { return 73 }
            darkest = pixel.smaller(darkest, pixel.luma(value))
            lightest = pixel.larger(lightest, pixel.luma(value))
            pixel_index += 1
        }
        if lightest < darkest + 40 { return 74 }
        // No seam: the edge where the tile meets itself differs no more
        // than the most different two neighbouring columns (rows) inside.
        var inner_across: u64 = 0
        var inner_down: u64 = 0
        var line: usize = 0
        while line + 1 < size {
            inner_across = math.maxOf(u64, inner_across, edgeOf(tile.?, size, line, line + 1, true))
            inner_down = math.maxOf(u64, inner_down, edgeOf(tile.?, size, line, line + 1, false))
            line += 1
        }
        if edgeOf(tile.?, size, size - 1, 0, true) > inner_across || edgeOf(tile.?, size, size - 1, 0, false) > inner_down { return 75 }
        // Asked for again: the same pixels, not drawn anew.
        var again_width: usize = 0
        var again_height: usize = 0
        const again = patterns.pattern(index, &again_width, &again_height)
        if again == null || @intFromPtr(again.?) != @intFromPtr(tile.?) || again_width != size { return 76 }
        // The Pattern generator at scale 1, no turn: two periods are the
        // tile twice, also moved by a whole period.
        generators.defaults(generators.PATTERN, &params)
        params.values[0] = @floatFromInt(f64, index)
        var round: u32 = 0
        while round < 2 {
            if round == 1 {
                params.values[3] = @floatFromInt(f64, size)
                params.values[4] = -@floatFromInt(f64, size * 3)
            }
            const span = @intCast(i32, size * 2)
            _ = generators.render(&params, geom.rect(0, 0, span, span), buffer, size * 2, 500, 500)
            var y: usize = 0
            while y < size * 2 {
                var x: usize = 0
                while x < size * 2 {
                    if buffer[y * size * 2 + x] != tile.?[(y % size) * size + x % size] { return 77 }
                    x += 1
                }
                y += 1
            }
            round += 1
        }
        // Moved by a part of a pixel, scaled and turned: still opaque.
        params.values[1] = 1.7
        params.values[2] = -61.0
        params.values[3] = 0.5
        _ = generators.render(&params, geom.rect(-100, -100, 200, 200), buffer, 200, 500, 500)
        pixel_index = 0
        while pixel_index < 200 * 200 {
            if buffer[pixel_index] >> 24 != 255 { return 78 }
            pixel_index += 1
        }
        index += 1
    }
    var width: usize = 7
    var height: usize = 7
    if patterns.pattern(patterns.count(), &width, &height) != null || width != 0 || height != 0 || patterns.name(99, false).length != 0 { return 79 }
    return 0
}

// ---- Simplex noise ---------------------------------------------------------------------------------

fn noisy() -> u8 {
    const buffer = words(WIDE * HIGH * 4)
    const other = words(WIDE * HIGH * 4)
    const area = geom.rect(0, 0, @intCast(i32, WIDE), @intCast(i32, HIGH))
    var params: Params = undefined
    generators.defaults(generators.SIMPLEX_NOISE, &params)
    params.values[5] = 1234.0
    _ = generators.render(&params, area, buffer, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH))
    _ = generators.render(&params, area, other, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH))
    if !same(buffer, other, WIDE * HIGH) { return 80 }
    // Grey, opaque, and most of the range.
    var darkest: u32 = 255
    var lightest: u32 = 0
    var index: usize = 0
    while index < WIDE * HIGH {
        const value = buffer[index]
        if value >> 24 != 255 || pixel.red(value) != pixel.green(value) || pixel.red(value) != pixel.blue(value) { return 81 }
        darkest = pixel.smaller(darkest, pixel.red(value))
        lightest = pixel.larger(lightest, pixel.red(value))
        index += 1
    }
    if darkest > 30 || lightest < 225 { return 82 }
    // Another seed: another picture.
    params.values[5] = 1235.0
    _ = generators.render(&params, area, other, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH))
    var differ: usize = 0
    index = 0
    while index < WIDE * HIGH {
        if apart(buffer[index], other[index]) > 8 { differ += 1 }
        index += 1
    }
    if differ < WIDE * HIGH / 2 { return 83 }
    // More octaves: finer, so neighbours differ more, still in range.
    params.values[1] = 6.0
    _ = generators.render(&params, area, other, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH))
    var rough_plain: u64 = 0
    var rough_more: u64 = 0
    index = 1
    while index < WIDE * HIGH {
        rough_plain += @intCast(u64, gap(pixel.red(buffer[index]), pixel.red(buffer[index - 1])))
        rough_more += @intCast(u64, gap(pixel.red(other[index]), pixel.red(other[index - 1])))
        index += 1
    }
    if rough_more <= rough_plain { return 84 }
    // Colour: the channels each their own.
    params.values[1] = 1.0
    params.values[7] = 1.0
    _ = generators.render(&params, area, other, WIDE, @intCast(i32, WIDE), @intCast(i32, HIGH))
    var colored: usize = 0
    index = 0
    while index < WIDE * HIGH {
        if gap(pixel.red(other[index]), pixel.green(other[index])) > 20 { colored += 1 }
        index += 1
    }
    if colored < WIDE * HIGH / 4 { return 85 }
    // Tileable: the image's size again is the same pixel, and across the
    // edge it runs on as anywhere inside.
    params.values[7] = 0.0
    params.values[6] = 1.0
    const twice = geom.rect(-@intCast(i32, WIDE), 0, @intCast(i32, WIDE * 2), @intCast(i32, HIGH * 2))
    _ = generators.render(&params, twice, buffer, WIDE * 2, @intCast(i32, WIDE), @intCast(i32, HIGH))
    var y: usize = 0
    while y < HIGH {
        var x: usize = 0
        while x < WIDE {
            const here = buffer[y * WIDE * 2 + x]
            if buffer[y * WIDE * 2 + x + WIDE] != here || buffer[(y + HIGH) * WIDE * 2 + x] != here { return 86 }
            x += 1
        }
        y += 1
    }
    var steepest: u32 = 0
    var at_edge: u32 = 0
    y = 0
    while y < HIGH {
        var x: usize = 1
        while x < WIDE * 2 {
            const step = gap(pixel.red(buffer[y * WIDE * 2 + x]), pixel.red(buffer[y * WIDE * 2 + x - 1]))
            if x == WIDE {
                at_edge = pixel.larger(at_edge, step)
            } else {
                steepest = pixel.larger(steepest, step)
            }
            x += 1
        }
        y += 1
    }
    if at_edge > steepest || steepest == 0 { return 87 }
    return 0
}

// ---- Screentone and Multigrid -----------------------------------------------------------------------

fn tones() -> u8 {
    const buffer = words(WIDE * HIGH)
    const area = geom.rect(-7, 5, @intCast(i32, WIDE), @intCast(i32, HIGH))
    var params: Params = undefined
    var shape: u32 = 0
    while shape < 8 {
        generators.defaults(generators.SCREENTONE, &params)
        params.values[0] = if shape >= 4 { 1.0 } else { 0.0 }
        params.values[1] = @floatFromInt(f64, shape % 4)
        params.values[6] = @floatFromInt(f64, 0xFF203040)
        params.values[7] = @floatFromInt(f64, 0xFFF0E0D0)
        params.values[4] = 100.0
        _ = generators.render(&params, area, buffer, WIDE, 400, 400)
        var index: usize = 0
        while index < WIDE * HIGH {
            if buffer[index] != 0xFFF0E0D0 { return 90 }
            index += 1
        }
        params.values[4] = -100.0
        _ = generators.render(&params, area, buffer, WIDE, 400, 400)
        index = 0
        while index < WIDE * HIGH {
            if buffer[index] != 0xFF203040 { return 91 }
            index += 1
        }
        // In between: both colours; darker as brightness falls.
        params.values[4] = 40.0
        _ = generators.render(&params, area, buffer, WIDE, 400, 400)
        var light: u64 = 0
        var papers: usize = 0
        var inks: usize = 0
        index = 0
        while index < WIDE * HIGH {
            light += @intCast(u64, pixel.luma(buffer[index]))
            if buffer[index] == 0xFFF0E0D0 { papers += 1 }
            if buffer[index] == 0xFF203040 { inks += 1 }
            index += 1
        }
        if papers == 0 || inks == 0 { return 92 }
        params.values[4] = -40.0
        _ = generators.render(&params, area, buffer, WIDE, 400, 400)
        var darker: u64 = 0
        index = 0
        while index < WIDE * HIGH {
            darker += @intCast(u64, pixel.luma(buffer[index]))
            index += 1
        }
        if darker >= light { return 93 }
        shape += 1
    }

    // Multigrid: five families make five cell colours (from colour 1 to
    // colour 2) and lines; without colouring, colour 1 and lines only.
    generators.defaults(generators.MULTIGRID, &params)
    params.values[3] = 0.0
    params.values[6] = @floatFromInt(f64, 0xFF000000)
    params.values[7] = @floatFromInt(f64, 0xFF0000FF)
    _ = generators.render(&params, area, buffer, WIDE, 400, 400)
    var seen: [5]bool = [5]bool{ false, false, false, false, false }
    var index: usize = 0
    while index < WIDE * HIGH {
        const value = buffer[index]
        if value & 0xFFFFFF00 != 0xFF000000 { return 94 }
        const blue = pixel.blue(value)
        // (0, 64, 128, 191, 255: index * 255 / 4.)
        var step: usize = 0
        while step < 5 {
            if blue == @intCast(u32, step * 255 / 4) { seen[step] = true }
            step += 1
        }
        index += 1
    }
    if !seen[0] || !seen[1] || !seen[2] || !seen[3] || !seen[4] { return 95 }
    params.values[3] = 2.0
    params.values[8] = 0.0
    params.values[5] = @floatFromInt(f64, 0xFFFF0000)
    _ = generators.render(&params, area, buffer, WIDE, 400, 400)
    var lines: usize = 0
    index = 0
    while index < WIDE * HIGH {
        const value = buffer[index]
        if pixel.green(value) != 0 || pixel.blue(value) != 0 { return 96 }
        if value == 0xFFFF0000 { lines += 1 }
        index += 1
    }
    if lines < 1000 { return 97 }
    return 0
}

// ---- Gradient Map ---------------------------------------------------------------------------------------

fn mapped() -> u8 {
    const info = filters.find(gradientmap.GRADIENT_MAP)
    if info == null || !std.text.same(info.?.*.key, "gradientmap") || info.?.*.category != types.MAP { return 100 }
    if filters.byKey("gradientmap") == null { return 101 }
    var params: filters.Params = undefined
    filters.defaults(gradientmap.GRADIENT_MAP, &params)
    const pixels = words(64 * 64)
    // The default: black to white, which leaves greys as they are.
    pixels[0] = 0xFF000000
    pixels[1] = 0xFFFFFFFF
    pixels[2] = 0xFF808080
    pixels[3] = 0x40FF0000
    pixels[4] = 0x00FFFFFF
    if !filters.apply(&params, pixels, 5, 1, 5) { return 102 }
    if pixels[0] != 0xFF000000 || pixels[1] != 0xFFFFFFFF || pixels[2] != 0xFF808080 || pixels[3] != pixel.withAlpha(pixel.gray(pixel.luma(0xFFFF0000)), 0x40) || pixels[4] != 0 { return 103 }
    // Three colours: black to the first, white to the last, mid grey to
    // the middle; alpha kept.
    const text = "0:#ff0000;0.5:#00ff00;1:#0000ff"
    node.setParamsText(&params, text)
    var three: gradient.Gradient = undefined
    _ = gradient.parse(text, &three)
    pixels[0] = 0xFF000000
    pixels[1] = 0xFFFFFFFF
    pixels[2] = 0xFF808080
    pixels[3] = 0x80808080
    pixels[4] = 0x01FFFFFF
    _ = filters.apply(&params, pixels, 5, 1, 5)
    if pixels[0] != 0xFFFF0000 || pixels[1] != 0xFF0000FF || pixels[4] != 0x010000FF { return 104 }
    if pixels[2] != gradient.colorAt(&three, 128.0 / 255.0, 0, 0) || apart(pixels[2], 0xFF00FF00) > 2 { return 105 }
    if pixels[3] != (pixels[2] & 0x00FFFFFF) | 0x80000000 { return 106 }
    // Dithered: within a step of the plain map, the same every time, and
    // the mean of a flat grey is the gradient's colour there.
    params.values[1] = 1.0
    var y: usize = 0
    while y < 64 {
        var x: usize = 0
        while x < 64 {
            pixels[y * 64 + x] = pixel.gray(@intCast(u32, (x + y * 64) / 16))
            x += 1
        }
        y += 1
    }
    _ = filters.apply(&params, pixels, 64, 64, 64)
    const copy = words(64 * 64)
    var index: usize = 0
    while index < 64 * 64 {
        copy[index] = pixel.gray(@intCast(u32, index / 16))
        index += 1
    }
    _ = filters.apply(&params, copy, 64, 64, 64)
    if !same(pixels, copy, 64 * 64) { return 107 }
    index = 0
    while index < 64 * 64 {
        const plain = gradient.colorAt(&three, @floatFromInt(f64, index / 16) / 255.0, 0, 0)
        if apart(pixels[index], plain) > 1 { return 108 }
        index += 1
    }
    // Flat 0x60 over 8 x 8: the mean green is the gradient's.
    index = 0
    while index < 64 {
        copy[index] = 0xFF606060
        index += 1
    }
    _ = filters.apply(&params, copy, 8, 8, 8)
    var greens: u32 = 0
    index = 0
    while index < 64 {
        greens += pixel.green(copy[index])
        index += 1
    }
    const wanted = gradient.fineAt(&three, @floatFromInt(f64, 0x60 * 256) / 65280.0, 0, 0)
    const fine_green = (wanted >> 16) & 0xFFFF
    // (The mean of 64 greens in 256ths of a step is their sum times 4:
    // the pattern holds each of its 64 thresholds once, so the mean is
    // the fine colour to well within half a step.)
    if gap(greens * 4, @intCast(u32, fine_green)) > 128 { return 109 }

    // In pieces: plain, any cut is the whole; dithered, blocks that start
    // at multiples of 8 (as tiles do) are.
    const picture = words(96 * 80)
    const whole = words(96 * 80)
    const pieces = words(96 * 80)
    y = 0
    while y < 80 {
        var x: usize = 0
        while x < 96 {
            picture[y * 96 + x] = pixel.pack(@intCast(u32, (x * 7 + y * 3) % 256), @intCast(u32, x * 2), @intCast(u32, y * 3), @intCast(u32, (x + y) % 256))
            x += 1
        }
        y += 1
    }
    var dithered: u32 = 0
    while dithered < 2 {
        params.values[1] = @floatFromInt(f64, dithered)
        index = 0
        while index < 96 * 80 {
            whole[index] = picture[index]
            index += 1
        }
        _ = filters.apply(&params, whole, 96, 80, 96)
        const step_x: usize = if dithered == 0 { 37 } else { 40 }
        const step_y: usize = if dithered == 0 { 23 } else { 24 }
        var by: usize = 0
        while by < 80 {
            var bx: usize = 0
            while bx < 96 {
                const width = if bx + step_x > 96 { 96 - bx } else { step_x }
                const height = if by + step_y > 80 { 80 - by } else { step_y }
                // (The piece filtered where it lies in the whole picture's
                // memory, with its stride.)
                index = 0
                while index < 96 * 80 {
                    pieces[index] = picture[index]
                    index += 1
                }
                _ = filters.apply(&params, pieces + (by * 96 + bx), width, height, 96)
                var line: usize = 0
                while line < height {
                    var column: usize = 0
                    while column < width {
                        if pieces[(by + line) * 96 + bx + column] != whole[(by + line) * 96 + bx + column] { return 98 }
                        column += 1
                    }
                    line += 1
                }
                bx += step_x
            }
            by += step_y
        }
        dithered += 1
    }
    return 0
}

// ---- Memory and speed ------------------------------------------------------------------------------------

fn memory() -> u8 {
    const buffer = words(WIDE * HIGH)
    var params: Params = undefined
    // Once each, so that the working memory and the tiles are there.
    var index: usize = 0
    while index < generators.count() {
        busy(generators.at(index).?.*.id, &params)
        _ = generators.render(&params, geom.rect(0, 0, 64, 64), buffer, 64, 300, 200)
        index += 1
    }
    var filter: filters.Params = undefined
    filters.defaults(gradientmap.GRADIENT_MAP, &filter)
    node.setParamsText(&filter, "0:#ff0000;0.5:#00ff00;1:#0000ff")
    _ = filters.apply(&filter, buffer, 64, 64, 64)
    const arena = turns.locate()
    const before = turns.used(arena)
    const heap_before = std.heap.liveBytes()
    var round: u32 = 0
    while round < 40 {
        index = 0
        while index < generators.count() {
            busy(generators.at(index).?.*.id, &params)
            _ = generators.render(&params, geom.rect(@intCast(i32, round) * 7, -9, 120, 80), buffer, 120, 300, 200)
            index += 1
        }
        filter.values[1] = if round % 2 == 0 { 0.0 } else { 1.0 }
        _ = filters.apply(&filter, buffer, 120, 80, 120)
        var width: usize = 0
        var height: usize = 0
        _ = patterns.pattern(@intCast(usize, round) % patterns.count(), &width, &height)
        _ = patterns.name(@intCast(usize, round) % patterns.count(), round % 2 == 0)
        _ = generators.paramsOf(generators.at(@intCast(usize, round) % generators.count()).?.*.id)
        round += 1
    }
    // (Nothing at all: a Rect handed through the list's function
    // pointers cost 16 bytes a render once, which a bound would hide.)
    if turns.used(arena) != before { return 110 }
    // Nor of the heap: the working memory is given back, the patterns'
    // block was taken before.
    if std.heap.liveBytes() != heap_before { return 111 }
    return 0
}

// ---- The ends of the coordinates ----------------------------------------------------------

// Every generator with busy numbers over the last pixels before i32's
// end and the first after its start: no trap, and 64 pixel blocks are
// the picture at once there too. (The Gradient generator anti-aliases:
// its rows around an area were once worked out with wrapping i32s.)
fn far() -> u8 {
    const whole = words(128 * 70)
    const piece = words(64 * 64)
    var params: Params = undefined
    var index: usize = 0
    while index < generators.count() {
        busy(generators.at(index).?.*.id, &params)
        var side: u32 = 0
        while side < 2 {
            const left: i32 = if side == 0 { 2147483647 - 128 } else { -2147483647 - 1 }
            const top: i32 = if side == 0 { 2147483647 - 70 } else { -2147483647 - 1 }
            const area = geom.rect(left, top, 128, 70)
            if !generators.render(&params, area, whole, 128, 2147483647, 2147483647) { return 112 }
            var by: i32 = 0
            while by < 70 {
                var bx: i32 = 0
                while bx < 128 {
                    const block = geom.intersect(geom.rect(left + bx, top + by, 64, 64), area)
                    _ = generators.render(&params, block, piece, @intCast(usize, block.width), 2147483647, 2147483647)
                    var line: i32 = 0
                    while line < block.height {
                        var column: i32 = 0
                        while column < block.width {
                            if piece[@intCast(usize, line * block.width + column)] != whole[@intCast(usize, (by + line) * 128 + bx + column)] { return 113 }
                            column += 1
                        }
                        line += 1
                    }
                    bx += 64
                }
                by += 64
            }
            side += 1
        }
        index += 1
    }
    return 0
}

// Megapixels a second, to a tenth, of `count` pixels in `nanoseconds`.
fn printSpeed(what: []const u8, count: u64, nanoseconds: u64) -> void {
    const tenths = if nanoseconds == 0 { 0 } else { count * 10000 / nanoseconds }
    @discardError(std.io.printFmt("{s}: {d}.{d} megapixels a second\n", .{ what, tenths / 10, tenths % 10 }))
}

fn speed() -> u8 {
    const side: usize = 1000
    const buffer = words(side * side)
    const area = geom.rect(0, 0, @intCast(i32, side), @intCast(i32, side))
    var sky: gradient.Gradient = undefined
    _ = gradient.builtin(5, &sky)
    var start = std.time.monotonicNanoseconds()
    gradient.render(&sky, gradient.LINEAR, gradient.NONE, false, false, 0.0, 0.0, 1000.0, 300.0, area, buffer, side, pixel.BLACK, pixel.WHITE, 1.0)
    printSpeed("linear gradient", @intCast(u64, side * side), @intCast(u64, std.time.monotonicNanoseconds() - start))
    start = std.time.monotonicNanoseconds()
    gradient.render(&sky, gradient.RADIAL, gradient.NONE, false, false, 500.0, 500.0, 900.0, 500.0, area, buffer, side, pixel.BLACK, pixel.WHITE, 1.0)
    printSpeed("radial gradient", @intCast(u64, side * side), @intCast(u64, std.time.monotonicNanoseconds() - start))
    start = std.time.monotonicNanoseconds()
    gradient.render(&sky, gradient.RADIAL, gradient.FORWARDS, false, true, 500.0, 500.0, 600.0, 500.0, area, buffer, side, pixel.BLACK, pixel.WHITE, 0.2)
    printSpeed("radial gradient, repeated, dithered, anti-aliased", @intCast(u64, side * side), @intCast(u64, std.time.monotonicNanoseconds() - start))
    var params: Params = undefined
    generators.defaults(generators.SIMPLEX_NOISE, &params)
    start = std.time.monotonicNanoseconds()
    _ = generators.render(&params, area, buffer, side, @intCast(i32, side), @intCast(i32, side))
    printSpeed("simplex noise", @intCast(u64, side * side), @intCast(u64, std.time.monotonicNanoseconds() - start))
    params.values[1] = 4.0
    params.values[6] = 1.0
    start = std.time.monotonicNanoseconds()
    _ = generators.render(&params, area, buffer, side, @intCast(i32, side), @intCast(i32, side))
    printSpeed("simplex noise, 4 octaves, tileable", @intCast(u64, side * side), @intCast(u64, std.time.monotonicNanoseconds() - start))
    return 0
}

pub fn main() -> u8 {
    _ = crash.install()
    var failed = listed()
    if failed != 0 { return failed }
    failed = extremes()
    if failed != 0 { return failed }
    failed = pieces()
    if failed != 0 { return failed }
    failed = plainOnes()
    if failed != 0 { return failed }
    failed = tiles()
    if failed != 0 { return failed }
    failed = noisy()
    if failed != 0 { return failed }
    failed = tones()
    if failed != 0 { return failed }
    failed = mapped()
    if failed != 0 { return failed }
    failed = memory()
    if failed != 0 { return failed }
    failed = far()
    if failed != 0 { return failed }
    failed = speed()
    if failed != 0 { return failed }
    return 13
}
