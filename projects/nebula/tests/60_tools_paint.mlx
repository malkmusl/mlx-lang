// nebula's painting tools (tools/paint.mlx) on a headless App, played by
// scripts in the window's coordinates of a 1024 x 768 window: the
// freehand brush paints a band of its size in the foreground colour, one
// step of the history named "Brush stroke" that undo takes back to the
// white there was exactly and redo brings again; the eraser takes paint
// away ("Erase"); a selection keeps paint inside it, washed and built up;
// a layer whose alpha is locked keeps its transparency; a washed stroke
// at half opacity that crosses itself stays at half, a built-up one does
// not; mirror left-right paints the mirror image; [ ] change the size, I
// O the opacity; Shift and a drag change the size and paint nothing;
// Escape in the middle of a stroke leaves no trace and no step; a hidden
// and a locked layer refuse with a note; the line tool paints a straight
// line ("Line"), Shift turns it onto 45 degrees; the dynamic brush paints
// behind the pointer along its way; the multibrush with four
// copies paints four turned bands in one step; the colour sampler takes
// the foreground (and with Ctrl the background) from a patch, averages
// over its radius and blends by its share; Ctrl held in the brush takes
// the sampler and gives the brush back when let go; the smart patch
// removes a black dot from a white field ("Smart patch"); the brush's
// outline shows at the pointer over the canvas and not elsewhere; every
// tool's options draw (dark and light, English and German) and a check
// box of them works; painting does not grow the value arena. Pictures
// (painted.png, multibrush.png, options.png, options-light.png,
// options-german.png) are written to the current directory and, when
// NEBULA_SHOTS names a directory, there too. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const png = @import("std.png")
const turns = @import("std.turns")
const theme_module = @import("std.ui.theme")
const canvas_module = @import("std.ui.canvas")
const ui_app = @import("std.ui.app")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const settings = @import("../app/settings.mlx")
const brushes = @import("../app/brushes.mlx")
const viewport = @import("../ui/viewport.mlx")
const kit_module = @import("../ui/kit.mlx")
const tools = @import("../tools/registry.mlx")
const paint = @import("../tools/paint.mlx")
const types = @import("../brush/types.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const mask = @import("../core/mask.mlx")
const node_module = @import("../core/node.mlx")
const ops = @import("../core/ops.mlx")
const geom = @import("../core/geom.mlx")
const render = @import("../core/render.mlx")
const image_module = @import("../core/image.mlx")

const App = state.App
const Canvas = state.Canvas

const TEXT: usize = 4096
// The options' picture: six panels side by side.
const PANEL: i32 = 232
const PANELS_WIDTH: usize = 1392
const PANELS_HEIGHT: usize = 300

const T = struct {
    app: *App
    shots: []const u8
    text: [4096]u8
    length: usize
    panels: Canvas
}

fn clear(t: *T) -> void { t.*.length = 0 }

fn put(t: *T, text: []const u8) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.length = std.text.append(bytes, t.*.length, TEXT, text)
}

fn putNumber(t: *T, value: i32) -> void {
    const bytes: [*]u8 = &t.*.text
    t.*.length = std.text.appendSigned(bytes, t.*.length, TEXT, @intCast(isize, value))
}

// " WX WY": the window pixel that shows image point (x, y).
fn putPlace(t: *T, x: f64, y: f64) -> void {
    const doc = api.document(t.*.app).?
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(&doc.*.view, x, y, &wx, &wy)
    put(t, " ")
    putNumber(t, @intFromFloat(i32, @floor(wx)))
    put(t, " ")
    putNumber(t, @intFromFloat(i32, @floor(wy)))
}

fn play(t: *T) -> bool {
    const bytes: [*]const u8 = &t.*.text
    return script.run(t.*.app, bytes[0..t.*.length])
}

fn run(t: *T, text: []const u8) -> bool {
    return script.run(t.*.app, text)
}

// A drag from image point (x0, y0) to (x1, y1) in so many motions.
fn drag(t: *T, x0: f64, y0: f64, x1: f64, y1: f64, motions: i32) -> bool {
    clear(t)
    put(t, "drag")
    putPlace(t, x0, y0)
    putPlace(t, x1, y1)
    put(t, " ")
    putNumber(t, motions)
    put(t, "\n")
    return play(t)
}

// The pointer to image point (x, y) (`then`: a step after it).
fn pointer(t: *T, x: f64, y: f64, then: []const u8) -> bool {
    clear(t)
    put(t, "pointer")
    putPlace(t, x, y)
    put(t, "\n")
    put(t, then)
    return play(t)
}

fn click(t: *T, x: f64, y: f64) -> bool {
    clear(t)
    put(t, "click")
    putPlace(t, x, y)
    put(t, "\n")
    return play(t)
}

// A stroke pressed at (x0, y), to (x1, y) and back in steps of `step`
// pixels, then let go.
fn backAndForth(t: *T, x0: f64, x1: f64, y: f64, step: f64) -> bool {
    clear(t)
    put(t, "pointer")
    putPlace(t, x0, y)
    put(t, "\npress\n")
    var x = x0 + step
    while x <= x1 {
        put(t, "pointer")
        putPlace(t, x, y)
        put(t, "\n")
        x += step
    }
    x = x1 - step
    while x >= x0 {
        put(t, "pointer")
        putPlace(t, x, y)
        put(t, "\n")
        x -= step
    }
    put(t, "release\n")
    return play(t)
}

// What the image shows at (x, y), and the active layer's own pixel.
fn shown(t: *T, x: i32, y: i32) -> u32 {
    const image = api.image(t.*.app).?
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

fn layer(t: *T, x: i32, y: i32) -> u32 {
    return device.pixel(api.activeNode(t.*.app).?.*.device.?, x, y)
}

fn imageOf(t: *T) -> *image_module.Image { return api.image(t.*.app).? }

fn steps(t: *T) -> usize { return history.stepsDone(imageOf(t).*.history) }

fn lastStep(t: *T, name: []const u8) -> bool {
    return std.text.same(history.undoName(imageOf(t).*.history), name)
}

fn near(a: f64, b: f64, within: f64) -> bool { return a - b <= within && b - a <= within }

// A filled rectangle on the active layer, one step.
fn fillOn(t: *T, area: geom.Rect, color: u32) -> void {
    const image = imageOf(t)
    const node = api.activeNode(t.*.app).?
    _ = ops.beginPixels(image, node)
    _ = device.fill(node.*.device.?, area, color)
    _ = ops.endPixels(image, node, "Fill")
}

// A picture of the frame the script drew last, as a step 'shot' writes
// it: here, and where NEBULA_SHOTS says.
fn shot(t: *T, name: []const u8) -> bool {
    clear(t)
    put(t, "shot ")
    put(t, name)
    put(t, "\n")
    if t.*.shots.length > 0 && t.*.shots.length < 400 {
        put(t, "shot ")
        put(t, t.*.shots)
        if t.*.shots[t.*.shots.length - 1] != 47 { put(t, "/") }
        put(t, name)
        put(t, "\n")
    }
    return play(t)
}

fn savePanels(t: *T, name: []const u8) -> void {
    var path: [600]u8 = undefined
    const bytes: [*]u8 = &path
    var length = std.text.append(bytes, 0, 599, name)
    bytes[length] = 0
    _ = png.saveFile(bytes, t.*.panels.pixels, t.*.panels.width, t.*.panels.height, t.*.panels.stride, true, t.*.app.*.allocator)
    if t.*.shots.length == 0 || t.*.shots.length > 400 { return }
    length = std.text.append(bytes, 0, 599, t.*.shots)
    if t.*.shots[t.*.shots.length - 1] != 47 { length = std.text.append(bytes, length, 599, "/") }
    length = std.text.append(bytes, length, 599, name)
    bytes[length] = 0
    _ = png.saveFile(bytes, t.*.panels.pixels, t.*.panels.width, t.*.panels.height, t.*.panels.stride, true, t.*.app.*.allocator)
}

// ---------------------------------------------------------------------------

// The brush: a band, its step, undo, redo, the eraser.
fn brushBand(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "size 1024 768\nnew 400 300 FFFFFF\ntool brush\ncolor FF0000\n") { return 1 }
    if app.*.tool != paint.BRUSH || api.document(app).?.*.view.zoom != 1.0 { return 2 }
    brushes.setSize(app, 20.0)
    if !drag(t, 100.5, 150.5, 300.5, 150.5, 20) { return 3 }
    if shown(t, 200, 150) != 0xFFFF0000 || shown(t, 200, 142) != 0xFFFF0000 || shown(t, 200, 158) != 0xFFFF0000 || shown(t, 110, 150) != 0xFFFF0000 || shown(t, 290, 150) != 0xFFFF0000 { return 4 }
    if shown(t, 200, 163) != 0xFFFFFFFF || shown(t, 200, 137) != 0xFFFFFFFF || shown(t, 80, 150) != 0xFFFFFFFF || shown(t, 320, 150) != 0xFFFFFFFF { return 5 }
    if steps(t) != 1 || !lastStep(t, "Brush stroke") || api.activeNode(app).?.*.overlay != null || api.toolBusy(app) { return 6 }
    // Undo: the layer (the empty one a new image has over its white
    // ground) as it was, every pixel, and white shows; redo: the band.
    if !run(t, "key Ctrl+Z\n") || steps(t) != 0 { return 7 }
    var y: i32 = 120
    while y < 180 {
        var x: i32 = 70
        while x < 330 {
            if layer(t, x, y) != 0 || shown(t, x, y) != 0xFFFFFFFF { return 8 }
            x += 1
        }
        y += 1
    }
    if !run(t, "key Ctrl+Shift+Z\n") || steps(t) != 1 || shown(t, 200, 150) != 0xFFFF0000 { return 9 }
    // The eraser takes the band away where it goes: the ground shows.
    if !run(t, "key E\n") || !app.*.eraser { return 10 }
    if !drag(t, 200.5, 100.5, 200.5, 200.5, 10) { return 11 }
    if layer(t, 200, 150) >> 24 != 0 || layer(t, 240, 150) != 0xFFFF0000 || shown(t, 200, 150) != 0xFFFFFFFF || shown(t, 240, 150) != 0xFFFF0000 { return 12 }
    if steps(t) != 2 || !lastStep(t, "Erase") { return 14 }
    if !run(t, "key E\nkey Ctrl+Z\n") || app.*.eraser || layer(t, 200, 150) != 0xFFFF0000 { return 15 }
    return 0
}

// The selection, the alpha lock, wash against build-up.
fn limits(t: *T) -> u8 {
    const app = t.*.app
    const image = imageOf(t)
    ops.beginSelection(image)
    _ = device.fill(image.*.selection, geom.rect(0, 0, 200, 300), mask.ALL)
    ops.endSelection(image, true, "Select")
    if !image.*.selected { return 16 }
    const before = steps(t)
    if !run(t, "color 0000FF\n") || !drag(t, 150.5, 220.5, 250.5, 220.5, 12) { return 17 }
    if shown(t, 180, 220) != 0xFF0000FF || shown(t, 199, 220) != 0xFF0000FF || shown(t, 200, 220) != 0xFFFFFFFF || shown(t, 230, 220) != 0xFFFFFFFF { return 18 }
    // Built up on the layer itself: the same.
    brushes.current(app).*.paintMode = types.MODE_BUILD_UP
    if !run(t, "color 00FF00\n") || !drag(t, 150.5, 260.5, 250.5, 260.5, 12) { return 19 }
    brushes.current(app).*.paintMode = types.MODE_WASH
    if shown(t, 180, 260) != 0xFF00FF00 || shown(t, 199, 260) != 0xFF00FF00 || shown(t, 200, 260) != 0xFFFFFFFF || shown(t, 240, 260) != 0xFFFFFFFF { return 20 }
    if steps(t) != before + 2 || !lastStep(t, "Brush stroke") { return 21 }
    ops.beginSelection(image)
    ops.endSelection(image, false, "Deselect")

    // A new layer, transparent but for a square, its alpha locked.
    const made = ops.newLayer(image, node_module.PAINT, "Layer 2", "New layer")
    if made == null || api.activeNode(app) == null || api.activeNode(app).?.*.id != made.?.*.id { return 22 }
    fillOn(t, geom.rect(40, 40, 40, 40), 0xFF00FFFF)
    made.?.*.alphaLocked = true
    brushes.setSize(app, 10.0)
    if !run(t, "color FF0000\n") || !drag(t, 20.5, 60.5, 100.5, 60.5, 10) { return 23 }
    if layer(t, 60, 60) != 0xFFFF0000 || layer(t, 30, 60) != 0 || layer(t, 90, 60) != 0 || layer(t, 60, 70) != 0xFF00FFFF { return 24 }
    brushes.current(app).*.paintMode = types.MODE_BUILD_UP
    if !run(t, "color 00FF00\n") || !drag(t, 20.5, 50.5, 100.5, 50.5, 10) { return 25 }
    brushes.current(app).*.paintMode = types.MODE_WASH
    if layer(t, 60, 50) != 0xFF00FF00 || layer(t, 30, 50) >> 24 != 0 || layer(t, 90, 50) >> 24 != 0 { return 26 }
    made.?.*.alphaLocked = false

    // Half opacity: washed, a stroke that crosses itself stays at half;
    // built up, the dabs add up.
    brushes.setSize(app, 20.0)
    brushes.setOpacity(app, 0.5)
    if !run(t, "color 0000FF\n") || !backAndForth(t, 120.5, 300.5, 230.5, 10.0) { return 27 }
    const washed = layer(t, 200, 230)
    if washed >> 24 < 126 || washed >> 24 > 129 || washed & 0xFFFFFF != 0x0000FF { return 28 }
    if layer(t, 150, 236) >> 24 < 126 || layer(t, 150, 236) >> 24 > 129 { return 29 }
    brushes.current(app).*.paintMode = types.MODE_BUILD_UP
    if !backAndForth(t, 120.5, 300.5, 270.5, 10.0) { return 30 }
    brushes.current(app).*.paintMode = types.MODE_WASH
    if layer(t, 200, 270) >> 24 < 200 { return 31 }
    brushes.setOpacity(app, 1.0)

    // Mirrored left and right about the image's middle (x = 200).
    app.*.mirrorX = true
    brushes.setSize(app, 10.0)
    const mirrored_before = steps(t)
    if !run(t, "color FF0000\n") || !drag(t, 20.5, 20.5, 80.5, 20.5, 8) { return 32 }
    app.*.mirrorX = false
    if layer(t, 50, 20) != 0xFFFF0000 || layer(t, 349, 20) != 0xFFFF0000 || layer(t, 330, 20) != 0xFFFF0000 || layer(t, 200, 20) != 0 || layer(t, 390, 20) != 0 { return 33 }
    if steps(t) != mirrored_before + 1 { return 34 }
    if !shot(t, "painted.png") { return 35 }
    return 0
}

// Keys, Shift and a drag, Escape, layers that refuse.
fn handling(t: *T) -> u8 {
    const app = t.*.app
    brushes.setSize(app, 20.0)
    if !run(t, "key ]\n") || !near(brushes.current(app).*.size, 22.0, 0.001) { return 36 }
    if !run(t, "key [\n") || !near(brushes.current(app).*.size, 19.8, 0.001) { return 37 }
    if !run(t, "key I\nkey I\n") || !near(brushes.current(app).*.opacity, 0.8, 0.001) { return 38 }
    if !run(t, "key O\n") || !near(brushes.current(app).*.opacity, 0.9, 0.001) { return 39 }
    brushes.setOpacity(app, 1.0)

    // Shift and a drag of 40 pixels to the right: the radius grows by 40.
    brushes.setSize(app, 20.0)
    const before = steps(t)
    const under = layer(t, 220, 120)
    if !run(t, "down Shift\n") || !drag(t, 200.5, 120.5, 240.5, 120.5, 8) || !run(t, "up Shift\n") { return 40 }
    if !near(brushes.current(app).*.size, 100.0, 1.0) || steps(t) != before || layer(t, 220, 120) != under || api.toolBusy(app) { return 41 }
    brushes.setSize(app, 20.0)

    // Escape in the middle: nothing stays, nothing to undo.
    if !pointer(t, 120.5, 120.5, "press\n") || !pointer(t, 200.5, 120.5, "") || !pointer(t, 280.5, 120.5, "") { return 42 }
    if !api.toolBusy(app) || api.activeNode(app).?.*.overlay == null { return 43 }
    if !run(t, "key Escape\nrelease\n") { return 44 }
    if api.toolBusy(app) || steps(t) != before || layer(t, 200, 120) != 0 || layer(t, 280, 120) != 0 || api.activeNode(app).?.*.overlay != null { return 45 }
    // The same built up (the layer itself is put back).
    brushes.current(app).*.paintMode = types.MODE_BUILD_UP
    if !pointer(t, 120.5, 120.5, "press\n") || !pointer(t, 280.5, 120.5, "key Escape\nrelease\n") { return 46 }
    brushes.current(app).*.paintMode = types.MODE_WASH
    if steps(t) != before || layer(t, 200, 120) != 0 { return 47 }

    // A hidden layer and a locked one: a note, no step.
    const node = api.activeNode(app).?
    node.*.visible = false
    if !drag(t, 120.5, 120.5, 280.5, 120.5, 8) || !run(t, "expect-note The layer is hidden\n") { return 48 }
    node.*.visible = true
    node.*.locked = true
    if !drag(t, 120.5, 120.5, 280.5, 120.5, 8) || !run(t, "expect-note The layer is locked\n") { return 49 }
    node.*.locked = false
    if steps(t) != before || layer(t, 200, 120) != 0 { return 50 }
    return 0
}

// The line tool.
fn lines(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "tool line\ncolor FF0000\n") || app.*.tool != paint.LINE { return 51 }
    brushes.setSize(app, 6.0)
    const before = steps(t)
    if !drag(t, 30.5, 110.5, 130.5, 110.5, 12) { return 52 }
    if layer(t, 80, 110) != 0xFFFF0000 || layer(t, 35, 110) != 0xFFFF0000 || layer(t, 125, 110) != 0xFFFF0000 || layer(t, 80, 116) != 0 || layer(t, 80, 104) != 0 { return 53 }
    if steps(t) != before + 1 || !lastStep(t, "Line") || api.toolBusy(app) { return 54 }
    // Dragged toward 40 degrees with Shift: on 45.
    if !run(t, "down Shift\n") || !drag(t, 200.5, 100.5, 260.5, 150.5, 10) || !run(t, "up Shift\n") { return 55 }
    // (At x = 240 the snapped line is at y = 140, the one dragged at 134.)
    if layer(t, 230, 130) != 0xFFFF0000 || layer(t, 240, 140) != 0xFFFF0000 || layer(t, 250, 150) != 0xFFFF0000 || layer(t, 240, 133) != 0 || layer(t, 230, 122) != 0 { return 56 }
    // Escape while it is dragged: no line.
    if !pointer(t, 30.5, 140.5, "press\n") || !pointer(t, 130.5, 140.5, "") || !api.toolBusy(app) { return 57 }
    if !run(t, "key Escape\nrelease\n") || layer(t, 80, 140) != 0 || steps(t) != before + 2 { return 58 }
    return 0
}

// The dynamic brush: the pen follows the pointer late, along its way.
fn dynamic(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "tool dynamicbrush\ncolor 00A000\n") || app.*.tool != paint.DYNAMIC { return 114 }
    brushes.setSize(app, 8.0)
    const before = steps(t)
    // (40 motions of 8 milliseconds: the pen takes two steps each.)
    if !drag(t, 20.5, 200.5, 180.5, 200.5, 40) { return 115 }
    if layer(t, 25, 200) != 0xFF00A000 || layer(t, 100, 200) != 0xFF00A000 || layer(t, 100, 192) != 0 || layer(t, 100, 208) != 0 { return 116 }
    // The pen lags behind: the stroke ends short of where the pointer let
    // go, and nothing went past it.
    if layer(t, 180, 200) != 0 || layer(t, 190, 200) != 0 { return 117 }
    if steps(t) != before + 1 || !lastStep(t, "Brush stroke") || api.toolBusy(app) { return 118 }
    return 0
}

// The multibrush: four copies about the image's middle (200, 150).
fn multibrush(t: *T) -> u8 {
    const app = t.*.app
    const image = imageOf(t)
    _ = ops.newLayer(image, node_module.PAINT, "Layer 3", "New layer")
    _ = settings.setText(app, "tool.multibrush.count", "4")
    if !run(t, "tool multibrush\ncolor 0000FF\n") || app.*.tool != paint.MULTIBRUSH { return 59 }
    brushes.setSize(app, 10.0)
    const before = steps(t)
    if !drag(t, 220.5, 60.5, 260.5, 60.5, 8) { return 60 }
    // Turned a quarter each time: (x, y) about the middle goes to
    // (middle - y, x), clockwise on the screen.
    if layer(t, 240, 60) != 0xFF0000FF || layer(t, 289, 190) != 0xFF0000FF || layer(t, 160, 239) != 0xFF0000FF || layer(t, 110, 110) != 0xFF0000FF { return 61 }
    if layer(t, 200, 150) != 0 || layer(t, 240, 239) != 0 { return 62 }
    if steps(t) != before + 1 || !lastStep(t, "Brush stroke") { return 63 }
    // Ctrl+click puts the centre: a stroke about (100, 100) now.
    if !run(t, "down Ctrl\n") || app.*.tool != paint.MULTIBRUSH || !click(t, 100.5, 100.5) || !run(t, "up Ctrl\n") { return 64 }
    if steps(t) != before + 1 { return 65 }
    if !drag(t, 100.5, 40.5, 100.5, 60.5, 4) { return 66 }
    if layer(t, 100, 50) != 0xFF0000FF || layer(t, 150, 100) != 0xFF0000FF || layer(t, 100, 150) != 0xFF0000FF || layer(t, 50, 100) != 0xFF0000FF { return 67 }
    if !pointer(t, 300.5, 40.5, "") || !shot(t, "multibrush.png") { return 68 }
    return 0
}

// The colour sampler.
fn sampler(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 100 100 FFFFFF\n") { return 69 }
    fillOn(t, geom.rect(10, 10, 20, 20), 0xFFFF0000)
    fillOn(t, geom.rect(50, 10, 20, 20), 0xFF0000FF)
    fillOn(t, geom.rect(10, 50, 20, 20), 0xFF00FF00)
    if !run(t, "tool colorsampler\ncolor 000000\nbackground FFFFFF\n") || app.*.tool != paint.SAMPLER { return 70 }
    if !click(t, 20.5, 20.5) || app.*.foreground != 0xFFFF0000 || app.*.background != 0xFFFFFFFF { return 71 }
    if !run(t, "down Ctrl\n") || !click(t, 60.5, 20.5) || !run(t, "up Ctrl\n") { return 72 }
    if app.*.background != 0xFF0000FF || app.*.foreground != 0xFFFF0000 || app.*.tool != paint.SAMPLER { return 73 }
    // Held by Control in the brush: sampled, and the brush back.
    if !run(t, "tool brush\ndown Ctrl\n") || app.*.tool != paint.SAMPLER { return 74 }
    if !click(t, 20.5, 60.5) || app.*.foreground != 0xFF00FF00 || app.*.background != 0xFF0000FF { return 75 }
    if !run(t, "up Ctrl\n") || app.*.tool != paint.BRUSH { return 76 }
    // Ctrl+Z in the brush still undoes (the sampler held meanwhile does not
    // stand in the way).
    const before = steps(t)
    if !run(t, "down Ctrl\nkey Ctrl+Z\nup Ctrl\n") || steps(t) != before - 1 || app.*.tool != paint.BRUSH { return 77 }
    if !run(t, "key Ctrl+Shift+Z\n") || steps(t) != before { return 78 }
    return 0
}

// The sampler's radius and blend, kept as settings, on an App of their own
// (the options are read when the tool is first used).
fn averaging(allocator: std.allocator.Allocator) -> u8 {
    const made = script.headless(allocator)
    if made == null { return 79 }
    const app = made.?
    _ = settings.setText(app, "tool.sampler.radius", "2")
    if !script.run(app, "size 1024 768\nnew 100 100 FFFFFF\n") { return 80 }
    const image = api.image(app).?
    const node = api.activeNode(app).?
    _ = ops.beginPixels(image, node)
    _ = device.fill(node.*.device.?, geom.rect(10, 10, 20, 20), 0xFFFF0000)
    _ = ops.endPixels(image, node, "Fill")
    if !script.run(app, "tool colorsampler\n") { return 81 }
    const doc = api.document(app).?
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    // Inside the patch the circle is all red; on its edge half white.
    viewport.toWindow(&doc.*.view, 20.5, 20.5, &wx, &wy)
    var text: [64]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 64, "click ")
    length = std.text.appendSigned(bytes, length, 64, @intFromFloat(isize, @floor(wx)))
    length = std.text.append(bytes, length, 64, " ")
    length = std.text.appendSigned(bytes, length, 64, @intFromFloat(isize, @floor(wy)))
    length = std.text.append(bytes, length, 64, "\n")
    if !script.run(app, bytes[0..length]) || app.*.foreground != 0xFFFF0000 { return 82 }
    // (A quarter into the pixel: whether the view puts the middles of the
    // window's pixels on the image's pixel middles or on their edges, the
    // pointer lands in this one.)
    viewport.toWindow(&doc.*.view, 29.25, 20.25, &wx, &wy)
    length = std.text.append(bytes, 0, 64, "click ")
    length = std.text.appendSigned(bytes, length, 64, @intFromFloat(isize, @floor(wx)))
    length = std.text.append(bytes, length, 64, " ")
    length = std.text.appendSigned(bytes, length, 64, @intFromFloat(isize, @floor(wy)))
    length = std.text.append(bytes, length, 64, "\n")
    if !script.run(app, bytes[0..length]) { return 83 }
    const mixed = app.*.foreground
    // 21 pixels in the circle: 13 red (columns 27-29), 8 white (30, 31).
    if (mixed >> 16) & 255 != 255 || mixed & 255 < 70 || mixed & 255 > 130 || (mixed >> 8) & 255 != mixed & 255 { return 84 }

    const second = script.headless(allocator)
    if second == null { return 85 }
    const other = second.?
    _ = settings.setText(other, "tool.sampler.blend", "50")
    if !script.run(other, "size 1024 768\nnew 100 100 FF0000\ntool colorsampler\ncolor 000000\n") { return 86 }
    const other_doc = api.document(other).?
    viewport.toWindow(&other_doc.*.view, 50.5, 50.5, &wx, &wy)
    length = std.text.append(bytes, 0, 64, "click ")
    length = std.text.appendSigned(bytes, length, 64, @intFromFloat(isize, @floor(wx)))
    length = std.text.append(bytes, length, 64, " ")
    length = std.text.appendSigned(bytes, length, 64, @intFromFloat(isize, @floor(wy)))
    length = std.text.append(bytes, length, 64, "\n")
    if !script.run(other, bytes[0..length]) || other.*.foreground != 0xFF800000 { return 87 }
    return 0
}

// The smart patch takes a black dot out of a white field (the image's
// opaque background layer), and fills from what is around.
fn patch(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "new 200 200 FFFFFF\n") { return 88 }
    const image = imageOf(t)
    image.*.active = node_module.childAt(image.*.root, 0)
    fillOn(t, geom.rect(98, 98, 5, 5), 0xFF000000)
    _ = settings.setText(app, "tool.patch.size", "16")
    if !run(t, "tool smartpatch\n") || app.*.tool != paint.PATCH { return 89 }
    if shown(t, 100, 100) != 0xFF000000 { return 90 }
    const before = steps(t)
    if !drag(t, 96.5, 100.5, 104.5, 100.5, 4) { return 91 }
    var y: i32 = 98
    while y < 103 {
        var x: i32 = 98
        while x < 103 {
            const found = shown(t, x, y)
            if found >> 24 != 255 || (found >> 16) & 255 < 0xF0 || (found >> 8) & 255 < 0xF0 || found & 255 < 0xF0 { return 92 }
            x += 1
        }
        y += 1
    }
    if steps(t) != before + 1 || !lastStep(t, "Smart patch") || api.activeNode(app).?.*.overlay != null { return 93 }
    // Far from the dot nothing changed; the dot's pixels are the layer's
    // own, opaque.
    if shown(t, 60, 100) != 0xFFFFFFFF || shown(t, 100, 60) != 0xFFFFFFFF || layer(t, 100, 100) >> 24 != 255 { return 94 }
    if !run(t, "key Ctrl+Z\n") || shown(t, 100, 100) != 0xFF000000 { return 95 }
    // Escape while the mask is painted: nothing.
    if !pointer(t, 96.5, 100.5, "press\n") || !pointer(t, 104.5, 100.5, "key Escape\nrelease\n") { return 96 }
    if shown(t, 100, 100) != 0xFF000000 || steps(t) != before || api.activeNode(app).?.*.overlay != null { return 97 }
    // A dot where red meets blue: the patch is red above and blue below.
    fillOn(t, geom.rect(130, 120, 40, 20), 0xFFFF0000)
    fillOn(t, geom.rect(130, 140, 40, 20), 0xFF0000FF)
    fillOn(t, geom.rect(148, 138, 4, 4), 0xFF000000)
    if !drag(t, 146.5, 140.5, 153.5, 140.5, 4) { return 98 }
    const upper = shown(t, 150, 136)
    const lower = shown(t, 150, 143)
    if (upper >> 16) & 255 < 0xA0 || upper & 255 > 0x60 || lower & 255 < 0xA0 || (lower >> 16) & 255 > 0x60 || (upper >> 8) & 255 != 0 { return 99 }
    if !lastStep(t, "Smart patch") { return 100 }
    return 0
}

// How many pixels of a square around window place (x, y) differ between
// two copies of the frame.
fn differing(a: [*]const u32, b: [*]const u32, stride: usize, x: i32, y: i32, reach: i32) -> usize {
    var count: usize = 0
    var j = y - reach
    while j < y + reach {
        var i = x - reach
        while i < x + reach {
            const at = @intCast(usize, j) * stride + @intCast(usize, i)
            if a[at] != b[at] { count += 1 }
            i += 1
        }
        j += 1
    }
    return count
}

// The brush's outline shows at the pointer on the canvas.
fn outline(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "tool brush\n") { return 111 }
    brushes.setSize(app, 40.0)
    const doc = api.document(app).?
    var wx: f64 = 0.0
    var wy: f64 = 0.0
    viewport.toWindow(&doc.*.view, 50.5, 50.5, &wx, &wy)
    const x = @intFromFloat(i32, @floor(wx))
    const y = @intFromFloat(i32, @floor(wy))
    if !pointer(t, 50.5, 50.5, "") { return 112 }
    const frame = script.frameOf(app).?
    const count = frame.*.width * frame.*.height
    const memory = app.*.allocator.alloc(count * 4, 16)
    if memory == null { return 113 }
    const kept: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    device.copyWords(kept, frame.*.pixels, count)
    // Off the canvas (the menu bar): the outline goes.
    if !run(t, "pointer 2 2\n") { return 101 }
    const shown_count = differing(kept, frame.*.pixels, frame.*.stride, x, y, 26)
    // (A ring of 40 pixels across: some 120 pixels of it light and dark.)
    if shown_count < 60 { return 102 }
    // Back on it: the same frame again.
    if !pointer(t, 50.5, 50.5, "") || differing(kept, frame.*.pixels, frame.*.stride, x, y, 26) != 0 { return 103 }
    app.*.allocator.free(memory.?, count * 4, 16)
    return 0
}

// Every painting tool's options, side by side, as the Tool Options docker
// would draw them; then a click on the line's check box.
fn panels(t: *T, name: []const u8, click_at: bool) -> u8 {
    const app = t.*.app
    const canvas = &t.*.panels
    const widgets = state.uiOf(app)
    const k = api.kit(app)
    const theme = state.themeOf(app)
    var round: usize = 0
    while round < 2 {
        view.begin(widgets, canvas)
        kit_module.resize(k, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height))
        kit_module.begin(k, widgets, canvas, theme, state.bodyOf(app), state.smallOf(app), state.monoOf(app), 0, app.*.german)
        canvas_module.fillRect(canvas, 0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height), theme.*.background)
        var index: usize = 0
        while index < 6 {
            const tool = tools.find(@intCast(u8, index))
            if tool == null || tool.?.*.options == null { return 104 }
            const column = ui.rect(@intCast(i32, index) * PANEL, 0, PANEL - 2, @intCast(i32, PANELS_HEIGHT))
            canvas_module.fillRect(canvas, column.x, column.y, column.width, column.height, theme.*.panel)
            kit_module.heading(k, ui.rect(column.x + 8, 4, column.width - 16, 24), if app.*.german { tool.?.*.german } else { tool.?.*.name })
            const height = tool.?.*.options.?(app, ui.rect(column.x, 30, column.width, column.height - 30))
            if height <= 0 || height > column.height - 30 { return 105 }
            index += 1
        }
        _ = kit_module.end(k)
        _ = view.end(widgets)
        if round == 0 && click_at {
            // The line's "Pressure ramp": its third row, below a space.
            const x = PANEL + 30
            const y = 30 + 8 + 26 + 26 + 6 + 12
            _ = view.pointerMove(widgets, x, y)
            _ = view.pointerButton(widgets, true)
            _ = view.pointerButton(widgets, false)
        }
        round += 1
    }
    savePanels(t, name)
    return 0
}

// Painting many strokes leaves the value arena as it was.
fn arena(t: *T) -> u8 {
    const app = t.*.app
    if !run(t, "tool brush\n") { return 106 }
    const tool = tools.find(paint.BRUSH).?
    const memory = app.*.allocator.alloc(@sizeOf(state.Input), 16)
    if memory == null { return 107 }
    const input: *state.Input = unsafe { @ptrCast(*state.Input, memory.?) }
    const location = turns.locate()
    var used: usize = 0
    var round: usize = 0
    while round < 12 {
        // (The first two warm up: memory made once.)
        if round == 2 { used = turns.used(location) }
        strokeBy(app, tool, input, round)
        round += 1
    }
    const grown = turns.used(location) - used
    if grown > 65536 { return 108 }
    if api.toolBusy(app) { return 109 }
    return 0
}

fn strokeBy(app: *App, tool: *const state.Tool, input: *state.Input, round: usize) -> void {
    input.*.x = 20.5
    input.*.y = 20.0 + @floatFromInt(f64, round) * 6.0
    input.*.windowX = 0
    input.*.windowY = 0
    input.*.pressure = 1.0
    input.*.tiltX = 0.0
    input.*.tiltY = 0.0
    input.*.rotation = 0.0
    input.*.time = @floatFromInt(f64, round) * 1000.0
    input.*.button = ui_app.BUTTON_LEFT
    input.*.buttons = 1
    input.*.modifiers = 0
    input.*.clicks = 1
    tool.*.press.?(app, input)
    input.*.button = 0
    var step: usize = 0
    while step < 40 {
        input.*.x += 4.0
        input.*.time += 8.0
        tool.*.move.?(app, input)
        step += 1
    }
    input.*.button = ui_app.BUTTON_LEFT
    tool.*.release.?(app, input)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(T), 16)
    const pixels = allocator.alloc(PANELS_WIDTH * PANELS_HEIGHT * 4, 16)
    if memory == null || pixels == null { return 1 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    t.*.shots = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { t.*.shots = std.string.asSlice(named.?) }
    unsafe { t.*.panels = Canvas.{ .pixels = @ptrCast([*]u32, pixels.?), .width = PANELS_WIDTH, .height = PANELS_HEIGHT, .stride = PANELS_WIDTH, .swapRedBlue = false, .device = 0, .opacity = 255 } }
    const made = script.headless(allocator)
    if made == null { return 1 }
    t.*.app = made.?
    var failed = brushBand(t)
    if failed == 0 { failed = limits(t) }
    if failed == 0 { failed = handling(t) }
    if failed == 0 { failed = lines(t) }
    if failed == 0 { failed = dynamic(t) }
    if failed == 0 { failed = multibrush(t) }
    if failed == 0 { failed = sampler(t) }
    if failed == 0 { failed = averaging(allocator) }
    if failed == 0 { failed = patch(t) }
    if failed == 0 { failed = outline(t) }
    if failed == 0 { failed = panels(t, "options.png", true) }
    if failed == 0 && !std.text.same(settings.text(t.*.app, "tool.line.ramp"), "1") { failed = 110 }
    if failed == 0 {
        t.*.app.*.theme = theme_module.scaled(theme_module.light(), 1)
        failed = panels(t, "options-light.png", false)
        t.*.app.*.theme = theme_module.scaled(theme_module.dark(), 1)
    }
    if failed == 0 {
        t.*.app.*.german = true
        failed = panels(t, "options-german.png", false)
        t.*.app.*.german = false
    }
    if failed == 0 { failed = arena(t) }
    if failed != 0 { return failed }
    return 13
}
