// nebula's blend modes (core/blend.mlx), every one of them: its names
// there and back (Krita's id, the OpenRaster name, the menu's order and
// categories); that an amount of 0, a mask byte of 0 and a transparent
// source leave the backdrop bit for bit (Copy, Destination In and
// Destination Atop are the three that act on a transparent source: what
// they do instead is checked), that the flags hold alpha and channels
// and that under the alpha lock a mode's B goes over a translucent pixel
// as over an opaque one (Source Atop; values worked out by hand too);
// an opaque pixel over an opaque one against the mode's formula, written
// here a second time in f64, within one step of a channel for a grid of
// channel pairs with 0 and 255 in it (and for whole colours where the
// mode looks at the colour), for every pair of channels where the
// module's rows read the mode from a table; translucent pixels against
// the mixing formula of the module's header; Normal against pixel.over
// exactly and against the straight-alpha formula in f64; the modes with
// their own rule for alpha one by one (Erase,
// Behind, Destination In/Atop, Source Atop, Copy, Dissolve, Alpha
// Darken, Greater, Shine); every loop of compositeSpanAt against
// blendPixelAt over random spans with every combination of flags, with
// and without a mask; the edges of a row for every mode (opacities and
// amounts above 255, a mask of 255 everywhere against none, flag bits
// past the four, numbers past the modes, spans of one pixel and spans
// cut at multiples of 64 against one span, a row mixed into itself, the
// same work twice); seeds at the ends of the coordinates; that nothing
// of it takes memory of the value arena (names and titles too) and that
// the heap holds one block of tables at the most, made once. Prints how
// long a pixel takes in a few modes. Exits 13.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")
const blend = @import("../core/blend.mlx")
const pixel = @import("../core/pixel.mlx")

// ---- Random pixels ------------------------------------------------------

var state: u64 = 0x2545F4914F6CDD1D

fn random() -> u32 {
    state ^= state << 13
    state ^= state >> 7
    state ^= state << 17
    return @intCast(u32, state >> 32)
}

// Any pixel, the edges more often than chance has them: transparent,
// opaque, channels at 0 and 255.
fn randomPixel() -> u32 {
    var value = random()
    const kind = random() % 10
    if kind == 0 { return value & 0x00FFFFFF }
    if kind <= 3 { return value | 0xFF000000 }
    if kind == 4 {
        if value & 1 != 0 { value |= 0x00FF0000 } else { value &= 0xFF00FFFF }
        if value & 2 != 0 { value |= 0x0000FF00 } else { value &= 0xFFFF00FF }
        if value & 4 != 0 { value |= 0x000000FF } else { value &= 0xFFFFFF00 }
    }
    return value
}

fn randomAmount() -> u32 {
    const kind = random() % 6
    if kind == 0 { return 255 }
    if kind == 1 { return 1 }
    if kind == 2 { return 128 }
    return random() % 256
}

fn report(code: u8, mode: u16, under: u32, source: u32, got: u32) -> u8 {
    const out = std.io.stdout()
    _ = std.io.print("check ")
    _ = std.io.writeUnsigned(out, @intCast(usize, code))
    _ = std.io.print(" mode ")
    _ = std.io.writeUnsigned(out, @intCast(usize, mode))
    _ = std.io.print(" (")
    _ = std.io.print(blend.name(mode))
    _ = std.io.print(") under ")
    _ = std.io.writeHex(out, @intCast(usize, under))
    _ = std.io.print(" source ")
    _ = std.io.writeHex(out, @intCast(usize, source))
    _ = std.io.print(" got ")
    _ = std.io.writeHex(out, @intCast(usize, got))
    _ = std.io.println("")
    return code
}

// ---- The formulas a second time -----------------------------------------
//
// b is the backdrop's channel, s the source's, 0 to 1; the result may
// leave 0-1 and is held there by the caller.

fn held(value: f64) -> f64 {
    return if value < 0.0 { 0.0 } else if value > 1.0 { 1.0 } else { value }
}

fn lower(a: f64, b: f64) -> f64 { return if a < b { a } else { b } }
fn higher(a: f64, b: f64) -> f64 { return if a > b { a } else { b } }
fn distance(a: f64, b: f64) -> f64 { return if a > b { a - b } else { b - a } }

fn dodgeOf(b: f64, s: f64) -> f64 {
    if b == 0.0 { return 0.0 }
    if s == 1.0 { return 1.0 }
    return lower(1.0, b / (1.0 - s))
}

fn burnOf(b: f64, s: f64) -> f64 {
    if b == 1.0 { return 1.0 }
    if s == 0.0 { return 0.0 }
    return 1.0 - lower(1.0, (1.0 - b) / s)
}

fn hardLightOf(b: f64, s: f64) -> f64 {
    if s <= 0.5 { return b * 2.0 * s }
    const top = 2.0 * s - 1.0
    return b + top - b * top
}

// 2 atan(over / under) / pi.
fn arcOf(under: f64, over: f64) -> f64 {
    if under == 0.0 { return if over == 0.0 { 0.0 } else { 1.0 } }
    return 2.0 * math.atan2(over, under) / math.pi
}

// Penumbra B.
fn penumbraOf(b: f64, s: f64) -> f64 {
    if b == 1.0 { return 1.0 }
    if b + s < 1.0 { return dodgeOf(s, b) / 2.0 }
    if s == 0.0 { return 0.0 }
    return 1.0 - held((1.0 - b) / s / 2.0)
}

fn glowOf(b: f64, s: f64) -> f64 {
    if b == 1.0 { return 1.0 }
    return held(s * s / (1.0 - b))
}

fn heatOf(b: f64, s: f64) -> f64 {
    if s == 1.0 { return 1.0 }
    if b == 0.0 { return 0.0 }
    return 1.0 - held((1.0 - s) * (1.0 - s) / b)
}

fn heatGlowOf(b: f64, s: f64) -> f64 {
    if b + s > 1.0 { return heatOf(b, s) }
    if s == 0.0 { return 0.0 }
    return glowOf(b, s)
}

fn freezeReflectOf(b: f64, s: f64) -> f64 {
    if b + s > 1.0 { return heatOf(s, b) }
    if b == 0.0 { return 0.0 }
    return glowOf(s, b)
}

// The fraction of b / s, a whole quotient counting as 1.
fn divisiveModuloOf(b: f64, s: f64) -> f64 {
    if b == 0.0 { return 0.0 }
    if s == 0.0 { return 1.0 }
    const quotient = b / s
    const fraction = quotient - math.floor(quotient)
    return if fraction == 0.0 { 1.0 } else { fraction }
}

fn divisiveModuloContinuousOf(b: f64, s: f64) -> f64 {
    if b == 0.0 { return 0.0 }
    if s == 0.0 { return 1.0 }
    const quotient = b / s
    const step = math.ceil(quotient)
    const fraction = quotient - (step - 1.0)
    const odd = math.floor(step / 2.0) * 2.0 != step
    return if odd { fraction } else { 1.0 - fraction }
}

// A channel's eight bits combined one by one by a truth table: bit
// (2 * backdrop's + source's) of `table` is the result.
fn bitsOf(table: u32, b: f64, s: f64) -> f64 {
    const cb = @intFromFloat(u32, b * 255.0 + 0.5)
    const cs = @intFromFloat(u32, s * 255.0 + 0.5)
    var result: u32 = 0
    var bit: u32 = 0
    while bit < 8 {
        const row = ((cb >> bit) & 1) * 2 + ((cs >> bit) & 1)
        result += ((table >> row) & 1) << bit
        bit += 1
    }
    return @floatFromInt(f64, result) / 255.0
}

// The W3C's soft light.
fn softLightOf(b: f64, s: f64) -> f64 {
    if s <= 0.5 { return b - (1.0 - 2.0 * s) * b * (1.0 - b) }
    var d = math.sqrt(b)
    if b <= 0.25 { d = ((16.0 * b - 12.0) * b + 4.0) * b }
    return b + (2.0 * s - 1.0) * (d - b)
}

// What a mode with a function of one channel gives for b and s.
fn separable(mode: u16, b: f64, s: f64) -> f64 {
    if mode == blend.OVERLAY { return hardLightOf(s, b) }
    if mode == blend.HARD_OVERLAY {
        if s == 1.0 { return 1.0 }
        if s > 0.5 { return b / (2.0 - 2.0 * s) }
        return 2.0 * s * b
    }
    if mode == blend.GRAIN_MERGE { return b + s - 128.0 / 255.0 }
    if mode == blend.GRAIN_EXTRACT { return b - s + 128.0 / 255.0 }
    if mode == blend.GEOMETRIC_MEAN { return math.sqrt(b * s) }
    if mode == blend.ALLANON { return (b + s) / 2.0 }
    if mode == blend.PARALLEL {
        if b == 0.0 || s == 0.0 { return 0.0 }
        return 2.0 / (1.0 / b + 1.0 / s)
    }
    if mode == blend.INTERPOLATION || mode == blend.INTERPOLATION_2X {
        const once = 0.5 - math.cos(math.pi * s) / 4.0 - math.cos(math.pi * b) / 4.0
        if mode == blend.INTERPOLATION { return once }
        return 0.5 - math.cos(math.pi * once) / 4.0 - math.cos(math.pi * once) / 4.0
    }
    if mode == blend.PENUMBRA_A { return penumbraOf(s, b) }
    if mode == blend.PENUMBRA_B { return penumbraOf(b, s) }
    if mode == blend.PENUMBRA_C { return if s == 1.0 { 1.0 } else { arcOf(1.0 - s, b) } }
    if mode == blend.PENUMBRA_D { return if b == 1.0 { 1.0 } else { arcOf(1.0 - b, s) } }
    if mode == blend.HARD_MIX { return if b > 0.5 { dodgeOf(b, s) } else { burnOf(b, s) } }
    if mode == blend.HARD_MIX_PHOTOSHOP { return if b + s > 1.0 { 1.0 } else { 0.0 } }
    if mode == blend.HARD_MIX_SOFTER { return 3.0 * b - 2.0 * (1.0 - s) }
    if mode == blend.ADDITION { return b + s }
    if mode == blend.SUBTRACT { return b - s }
    if mode == blend.INVERSE_SUBTRACT { return b - (1.0 - s) }
    if mode == blend.MULTIPLY { return b * s }
    if mode == blend.DIVIDE {
        if s == 0.0 { return if b == 0.0 { 0.0 } else { 1.0 } }
        return b / s
    }
    if mode == blend.DARKEN { return lower(b, s) }
    if mode == blend.BURN { return burnOf(b, s) }
    if mode == blend.LINEAR_BURN { return b + s - 1.0 }
    if mode == blend.GAMMA_DARK { return if s == 0.0 { 0.0 } else { math.pow(b, 1.0 / s) } }
    if mode == blend.SHADE { return 1.0 - ((1.0 - b) * s + math.sqrt(1.0 - s)) }
    if mode == blend.FOG_DARKEN {
        if s < 0.5 { return (1.0 - s) * s + s * b }
        return s * b + s - s * s
    }
    if mode == blend.EASY_BURN { return 1.0 - math.pow(1.0 - b, s * 1.04) }
    if mode == blend.LIGHTEN { return higher(b, s) }
    if mode == blend.SCREEN { return 1.0 - (1.0 - b) * (1.0 - s) }
    if mode == blend.DODGE { return dodgeOf(b, s) }
    if mode == blend.LINEAR_LIGHT { return b + 2.0 * s - 1.0 }
    if mode == blend.HARD_LIGHT { return hardLightOf(b, s) }
    if mode == blend.SOFT_LIGHT_SVG { return softLightOf(b, s) }
    if mode == blend.SOFT_LIGHT_PHOTOSHOP {
        if s > 0.5 { return b + (2.0 * s - 1.0) * (math.sqrt(b) - b) }
        return b - (1.0 - 2.0 * s) * b * (1.0 - b)
    }
    if mode == blend.SOFT_LIGHT_PEGTOP { return (1.0 - b) * b * s + b * (1.0 - (1.0 - b) * (1.0 - s)) }
    if mode == blend.SOFT_LIGHT_IFS { return math.pow(b, math.pow(2.0, 2.0 * (0.5 - s))) }
    if mode == blend.PIN_LIGHT { return higher(2.0 * s - 1.0, lower(b, 2.0 * s)) }
    if mode == blend.VIVID_LIGHT {
        if s < 0.5 {
            if s == 0.0 { return if b == 1.0 { 1.0 } else { 0.0 } }
            return 1.0 - (1.0 - b) / (2.0 * s)
        }
        if s == 1.0 { return if b == 0.0 { 0.0 } else { 1.0 } }
        return b / (2.0 * (1.0 - s))
    }
    if mode == blend.FLAT_LIGHT {
        if s == 0.0 { return 0.0 }
        return if (1.0 - s) + b > 1.0 { penumbraOf(b, s) } else { penumbraOf(s, b) }
    }
    if mode == blend.GAMMA_LIGHT { return math.pow(b, s) }
    if mode == blend.GAMMA_ILLUMINATION { return if s == 1.0 { 1.0 } else { 1.0 - math.pow(1.0 - b, 1.0 / (1.0 - s)) } }
    if mode == blend.PNORM_A { return math.pow(math.pow(b, 2.0 + 1.0 / 3.0) + math.pow(s, 2.0 + 1.0 / 3.0), 3.0 / 7.0) }
    if mode == blend.PNORM_B { return math.pow(b * b * b * b + s * s * s * s, 0.25) }
    if mode == blend.SUPER_LIGHT {
        if s < 0.5 { return 1.0 - math.pow(math.pow(1.0 - b, 2.875) + math.pow(1.0 - 2.0 * s, 2.875), 1.0 / 2.875) }
        return math.pow(math.pow(b, 2.875) + math.pow(2.0 * s - 1.0, 2.875), 1.0 / 2.875)
    }
    if mode == blend.TINT { return s * (1.0 - b) + math.sqrt(b) }
    if mode == blend.FOG_LIGHTEN {
        if s < 0.5 { return 1.0 - (1.0 - s) * s - (1.0 - b) * (1.0 - s) }
        return s - (1.0 - b) * (1.0 - s) + (1.0 - s) * (1.0 - s)
    }
    if mode == blend.EASY_DODGE { return if s == 1.0 { 1.0 } else { math.pow(b, (1.0 - s) * 1.04) } }
    if mode == blend.DIFFERENCE { return distance(b, s) }
    if mode == blend.EXCLUSION { return b + s - 2.0 * b * s }
    if mode == blend.EQUIVALENCE { return 1.0 - distance(b, s) }
    if mode == blend.NEGATION { return 1.0 - distance(1.0 - s, b) }
    if mode == blend.ADDITIVE_SUBTRACTIVE { return distance(math.sqrt(b), math.sqrt(s)) }
    if mode == blend.ARCUS_TANGENT { return arcOf(b, s) }
    // Truth tables, the rows backdrop/source = 00, 01, 10, 11 from the
    // lowest bit.
    if mode == blend.AND { return bitsOf(8, b, s) }
    if mode == blend.OR { return bitsOf(14, b, s) }
    if mode == blend.XOR { return bitsOf(6, b, s) }
    if mode == blend.NAND { return bitsOf(7, b, s) }
    if mode == blend.NOR { return bitsOf(1, b, s) }
    if mode == blend.XNOR { return bitsOf(9, b, s) }
    if mode == blend.IMPLICATION { return bitsOf(11, b, s) }
    if mode == blend.NOT_IMPLICATION { return bitsOf(4, b, s) }
    if mode == blend.CONVERSE { return bitsOf(13, b, s) }
    if mode == blend.NOT_CONVERSE { return bitsOf(2, b, s) }
    if mode == blend.MODULO {
        const step = s + 1.0 / 255.0
        return b - math.floor(b / step) * step
    }
    if mode == blend.MODULO_CONTINUOUS { return divisiveModuloContinuousOf(b, s) * s }
    if mode == blend.DIVISIVE_MODULO { return divisiveModuloOf(b, s) }
    if mode == blend.DIVISIVE_MODULO_CONTINUOUS { return divisiveModuloContinuousOf(b, s) }
    if mode == blend.MODULO_SHIFT {
        if s == 1.0 && b == 0.0 { return 0.0 }
        return if b + s > 1.0 { b + s - 1.0 } else { b + s }
    }
    if mode == blend.MODULO_SHIFT_CONTINUOUS { return if b + s > 1.0 { 2.0 - (b + s) } else { b + s } }
    if mode == blend.REFLECT { return glowOf(s, b) }
    if mode == blend.GLOW { return glowOf(b, s) }
    if mode == blend.FREEZE { return heatOf(s, b) }
    if mode == blend.HEAT { return heatOf(b, s) }
    if mode == blend.GLOW_HEAT {
        if b == 1.0 { return 1.0 }
        return if b + s > 1.0 { glowOf(b, s) } else { heatOf(b, s) }
    }
    if mode == blend.HEAT_GLOW { return heatGlowOf(b, s) }
    if mode == blend.REFLECT_FREEZE {
        if s == 1.0 { return 1.0 }
        return if b + s > 1.0 { glowOf(s, b) } else { heatOf(s, b) }
    }
    if mode == blend.FREEZE_REFLECT { return freezeReflectOf(b, s) }
    if mode == blend.HEAT_GLOW_FREEZE_REFLECT { return (freezeReflectOf(b, s) + heatGlowOf(b, s)) / 2.0 }
    return -1000.0
}

// A step of a channel is 1/255; a formula with a jump or a case of its
// own at a whole value may land on either side of it in f64, so what the
// module gives may be the formula's value a hair to any side instead.
const HAIR: f64 = 0.0000001

fn beside(value: f64, side: u32) -> f64 {
    if side == 1 { return held(value - HAIR) }
    if side == 2 { return held(value + HAIR) }
    return value
}

fn separableFits(mode: u16, got: u32, cb: u32, cs: u32) -> bool {
    const b = @floatFromInt(f64, cb) / 255.0
    const s = @floatFromInt(f64, cs) / 255.0
    const value = @floatFromInt(f64, got)
    var sideB: u32 = 0
    while sideB < 3 {
        var sideS: u32 = 0
        while sideS < 3 {
            const wanted = 255.0 * held(separable(mode, beside(b, sideB), beside(s, sideS)))
            if distance(value, wanted) <= 1.0 { return true }
            sideS += 1
        }
        sideB += 1
    }
    return false
}

// ---- Whole colours ------------------------------------------------------

fn part(color: u32, channel: u32) -> f64 {
    return @floatFromInt(f64, (color >> (16 - 8 * channel)) & 255) / 255.0
}

fn most(r: f64, g: f64, b: f64) -> f64 { return higher(r, higher(g, b)) }
fn least(r: f64, g: f64, b: f64) -> f64 { return lower(r, lower(g, b)) }

// Space 0: HSY (the W3C's Lum), 1: HSI, 2: HSL, 3: HSV.
fn lightOf(space: u32, r: f64, g: f64, b: f64) -> f64 {
    if space == 0 { return 0.3 * r + 0.59 * g + 0.11 * b }
    if space == 1 { return (r + g + b) / 3.0 }
    if space == 2 { return (most(r, g, b) + least(r, g, b)) / 2.0 }
    return most(r, g, b)
}

fn saturationOf(space: u32, r: f64, g: f64, b: f64) -> f64 {
    const top = most(r, g, b)
    const bottom = least(r, g, b)
    if space == 0 { return top - bottom }
    if space == 1 {
        if top - bottom < 0.000001 { return 0.0 }
        return 1.0 - bottom / lightOf(1, r, g, b)
    }
    if space == 2 {
        const light = (top + bottom) / 2.0
        const room = 1.0 - distance(2.0 * light, 1.0)
        if room < 0.000001 { return 1.0 }
        return (top - bottom) / room
    }
    if top == 0.0 { return 0.0 }
    return (top - bottom) / top
}

// The W3C's SetSat for the channel `c` of the colour (r, g, b).
fn stretched(c: f64, r: f64, g: f64, b: f64, saturation: f64) -> f64 {
    const top = most(r, g, b)
    const bottom = least(r, g, b)
    if top > bottom { return (c - bottom) * saturation / (top - bottom) }
    return 0.0
}

// The channel `c` of (r, g, b) after `delta` was added to all three and
// the colour clipped (the W3C's ClipColor with the space's lightness).
fn shifted(space: u32, c: f64, r: f64, g: f64, b: f64, delta: f64) -> f64 {
    const light = lightOf(space, r + delta, g + delta, b + delta)
    const bottom = least(r, g, b) + delta
    const top = most(r, g, b) + delta
    var value = c + delta
    if bottom < 0.0 && light - bottom > 0.000001 { value = light + (value - light) * light / (light - bottom) }
    if top > 1.0 && top - light > 0.000001 { value = light + (value - light) * (1.0 - light) / (top - light) }
    return value
}

// One channel of what the eight modes of a space give.
fn hsxOf(space: u32, op: u32, under: u32, source: u32, channel: u32) -> f64 {
    const br = part(under, 0)
    const bg = part(under, 1)
    const bb = part(under, 2)
    const sr = part(source, 0)
    const sg = part(source, 1)
    const sb = part(source, 2)
    const backdropLight = lightOf(space, br, bg, bb)
    const sourceLight = lightOf(space, sr, sg, sb)
    const backdropSaturation = saturationOf(space, br, bg, bb)
    const sourceSaturation = saturationOf(space, sr, sg, sb)
    if op == 0 {
        // Colour: SetLum(Cs, Lum(Cb)).
        return shifted(space, part(source, channel), sr, sg, sb, backdropLight - sourceLight)
    }
    if op == 1 {
        // Hue: SetLum(SetSat(Cs, Sat(Cb)), Lum(Cb)).
        const r = stretched(sr, sr, sg, sb, backdropSaturation)
        const g = stretched(sg, sr, sg, sb, backdropSaturation)
        const b = stretched(sb, sr, sg, sb, backdropSaturation)
        const c = stretched(part(source, channel), sr, sg, sb, backdropSaturation)
        return shifted(space, c, r, g, b, backdropLight - lightOf(space, r, g, b))
    }
    if op == 3 {
        // Lightness: SetLum(Cb, Lum(Cs)).
        return shifted(space, part(under, channel), br, bg, bb, sourceLight - backdropLight)
    }
    if op == 6 { return shifted(space, part(under, channel), br, bg, bb, sourceLight) }
    if op == 7 { return shifted(space, part(under, channel), br, bg, bb, sourceLight - 1.0) }
    // The three that give the backdrop another saturation at its own
    // lightness.
    var saturation = sourceSaturation
    if op == 4 { saturation = backdropSaturation + (1.0 - backdropSaturation) * sourceSaturation }
    if op == 5 { saturation = backdropSaturation * sourceSaturation }
    const r = stretched(br, br, bg, bb, saturation)
    const g = stretched(bg, br, bg, bb, saturation)
    const b = stretched(bb, br, bg, bb, saturation)
    const c = stretched(part(under, channel), br, bg, bb, saturation)
    return shifted(space, c, r, g, b, backdropLight - lightOf(space, r, g, b))
}

// The W3C's Lum in hundredths of a channel: whole numbers, so two
// colours that are level are level.
fn hundredths(color: u32) -> f64 {
    return 30.0 * @floatFromInt(f64, (color >> 16) & 255) + 59.0 * @floatFromInt(f64, (color >> 8) & 255) + 11.0 * @floatFromInt(f64, color & 255)
}

// One channel (0 red, 1 green, 2 blue) of what a mode with a function of
// the whole colour gives.
fn colorOf(mode: u16, under: u32, source: u32, channel: u32) -> f64 {
    if mode >= blend.COLOR && mode <= blend.DECREASE_VALUE {
        const place = @intCast(u32, mode - blend.COLOR)
        return hsxOf(place / 8, place % 8, under, source, channel)
    }
    if mode == blend.DARKER_COLOR { return if hundredths(under) < hundredths(source) { part(under, channel) } else { part(source, channel) } }
    if mode == blend.LIGHTER_COLOR { return if hundredths(under) > hundredths(source) { part(under, channel) } else { part(source, channel) } }
    if mode == blend.COPY_RED { return if channel == 0 { part(source, channel) } else { part(under, channel) } }
    if mode == blend.COPY_GREEN { return if channel == 1 { part(source, channel) } else { part(under, channel) } }
    if mode == blend.COPY_BLUE { return if channel == 2 { part(source, channel) } else { part(under, channel) } }
    if mode == blend.TANGENT_NORMALMAP {
        return part(source, channel) + part(under, channel) - (if channel == 2 { 1.0 } else { 0.5 })
    }
    if mode == blend.COMBINE_NORMALMAP {
        // Reoriented normal mapping: t from the source, u from the
        // backdrop, r = t (t.u) / t.z - u, normalized.
        const tx = part(source, 0) * 2.0 - 1.0
        const ty = part(source, 1) * 2.0 - 1.0
        const tz = higher(part(source, 2) * 2.0, 0.000001)
        const ux = part(under, 0) * -2.0 + 1.0
        const uy = part(under, 1) * -2.0 + 1.0
        const uz = part(under, 2) * 2.0 - 1.0
        const dot = tx * ux + ty * uy + tz * uz
        const rx = tx * dot / tz - ux
        const ry = ty * dot / tz - uy
        const rz = tz * dot / tz - uz
        const size = math.sqrt(rx * rx + ry * ry + rz * rz)
        const picked = if channel == 0 { rx } else if channel == 1 { ry } else { rz }
        return picked / size * 0.5 + 0.5
    }
    if mode == blend.BUMPMAP {
        const light = (306.0 * part(source, 0) + 601.0 * part(source, 1) + 117.0 * part(source, 2)) / 1024.0
        return part(under, channel) * light
    }
    return -1000.0
}

fn colorFits(mode: u16, got: u32, under: u32, source: u32) -> bool {
    var channel: u32 = 0
    while channel < 3 {
        const wanted = 255.0 * held(colorOf(mode, under, source, channel))
        const value = @floatFromInt(f64, (got >> (16 - 8 * channel)) & 255)
        if distance(value, wanted) > 1.0 { return false }
        channel += 1
    }
    return true
}

// How a mode is computed: 0 a function of one channel, 1 of the whole
// colour, 2 its own rule for alpha.
fn kindOf(mode: u16) -> u32 {
    if mode <= blend.GREATER || mode == blend.LUMINOSITY_SAI { return 2 }
    if mode == blend.DARKER_COLOR || mode == blend.LIGHTER_COLOR || mode >= blend.COLOR { return 1 }
    return 0
}

// ---- Tables of the test -------------------------------------------------

var GRID: [30]u32 = [30]u32{ 0, 1, 2, 3, 5, 8, 13, 21, 34, 55, 63, 64, 89, 100, 126, 127, 128, 129, 144, 170, 191, 192, 200, 222, 233, 250, 252, 253, 254, 255 }

const PAIRS: usize = 20
var UNDERS: [20]u32 = [20]u32{ 0xFF000000, 0xFFFFFFFF, 0xFF000000, 0xFFFFFFFF, 0xFF804020, 0xFFFF8000, 0xFF102030, 0xFF7F7F7F, 0xFF808080, 0xFFC83C96, 0xFF00FF7F, 0xFF404040, 0xFF0A141E, 0xFFFAF0E6, 0xFF336699, 0xFF01FE80, 0xFFFF0000, 0xFF00FF00, 0xFF8080FF, 0xFF7F7FFF }
var SOURCES: [20]u32 = [20]u32{ 0xFF000000, 0xFFFFFFFF, 0xFFFFFFFF, 0xFF000000, 0xFF2040C0, 0xFF0080FF, 0xFFF0E0D0, 0xFF808080, 0xFF7F7F7F, 0xFF3CC864, 0xFFFF0040, 0xFFC0C0C0, 0xFF050A0F, 0xFFF5FFFA, 0xFF336699, 0xFFFE0180, 0xFF0000FF, 0xFFFF00FF, 0xFFA060E0, 0xFF6090F0 }

const Known = struct {
    mode: u16
    id: []const u8
    ora: []const u8
}

// Names files have had for years: the mode of each must not change.
const KNOWN: [28]Known = [28]Known{
    Known.{ .mode = blend.NORMAL, .id = "normal", .ora = "svg:src-over" },
    Known.{ .mode = blend.MULTIPLY, .id = "multiply", .ora = "svg:multiply" },
    Known.{ .mode = blend.SCREEN, .id = "screen", .ora = "svg:screen" },
    Known.{ .mode = blend.OVERLAY, .id = "overlay", .ora = "svg:overlay" },
    Known.{ .mode = blend.DARKEN, .id = "darken", .ora = "svg:darken" },
    Known.{ .mode = blend.LIGHTEN, .id = "lighten", .ora = "svg:lighten" },
    Known.{ .mode = blend.DODGE, .id = "dodge", .ora = "svg:color-dodge" },
    Known.{ .mode = blend.BURN, .id = "burn", .ora = "svg:color-burn" },
    Known.{ .mode = blend.HARD_LIGHT, .id = "hard_light", .ora = "svg:hard-light" },
    Known.{ .mode = blend.SOFT_LIGHT_SVG, .id = "soft_light_svg", .ora = "svg:soft-light" },
    Known.{ .mode = blend.DIFFERENCE, .id = "diff", .ora = "svg:difference" },
    Known.{ .mode = blend.COLOR, .id = "color", .ora = "svg:color" },
    Known.{ .mode = blend.LUMINOSITY, .id = "luminize", .ora = "svg:luminosity" },
    Known.{ .mode = blend.HUE, .id = "hue", .ora = "svg:hue" },
    Known.{ .mode = blend.SATURATION, .id = "saturation", .ora = "svg:saturation" },
    Known.{ .mode = blend.ADDITION, .id = "add", .ora = "svg:plus" },
    Known.{ .mode = blend.DESTINATION_IN, .id = "destination-in", .ora = "svg:dst-in" },
    Known.{ .mode = blend.ERASE, .id = "erase", .ora = "svg:dst-out" },
    Known.{ .mode = blend.SOURCE_ATOP, .id = "atop", .ora = "svg:src-atop" },
    Known.{ .mode = blend.DESTINATION_ATOP, .id = "destination-atop", .ora = "svg:dst-atop" },
    Known.{ .mode = blend.BEHIND, .id = "behind", .ora = "krita:behind" },
    Known.{ .mode = blend.DISSOLVE, .id = "dissolve", .ora = "krita:dissolve" },
    Known.{ .mode = blend.LINEAR_BURN, .id = "linear_burn", .ora = "krita:linear_burn" },
    Known.{ .mode = blend.INCREASE_LUMINOSITY, .id = "inc_luminosity", .ora = "krita:inc_luminosity" },
    Known.{ .mode = blend.SOFT_LIGHT_PHOTOSHOP, .id = "soft_light", .ora = "krita:soft_light" },
    Known.{ .mode = blend.HARD_MIX, .id = "hard mix", .ora = "krita:hard mix" },
    Known.{ .mode = blend.COPY, .id = "copy", .ora = "krita:copy" },
    Known.{ .mode = blend.VALUE, .id = "value", .ora = "krita:value" },
}

// The modes compositeSpanAt has a loop of their own for.
var DEDICATED: [13]u16 = [13]u16{ blend.NORMAL, blend.ERASE, blend.MULTIPLY, blend.SCREEN, blend.OVERLAY, blend.DARKEN, blend.LIGHTEN, blend.ADDITION, blend.DIFFERENCE, blend.DODGE, blend.BURN, blend.HARD_LIGHT, blend.SOFT_LIGHT_SVG }

// ---- The checks ---------------------------------------------------------

fn names() -> u8 {
    if blend.NORMAL != 0 || blend.ERASE != 1 || blend.COUNT != 130 { return 1 }
    if blend.FLAG_ALPHA_LOCK != 1 || blend.FLAG_LOCK_RED != 2 || blend.FLAG_LOCK_GREEN != 4 || blend.FLAG_LOCK_BLUE != 8 { return 1 }
    var mode: u16 = 0
    while mode < blend.COUNT {
        const id = blend.name(mode)
        const ora = blend.oraName(mode)
        if id.length == 0 || blend.byName(id) != mode { return report(2, mode, 0, 0, 0) }
        if blend.byName(ora) != mode { return report(3, mode, 0, 0, 0) }
        // An OpenRaster name is an SVG one or Krita's id behind "krita:".
        const svg = std.text.startsWith(ora, "svg:")
        if !svg && (!std.text.startsWith(ora, "krita:") || !std.text.same(ora[6..], id)) { return report(4, mode, 0, 0, 0) }
        // Small letters only: ids are compared as files write them.
        var index: usize = 0
        while index < id.length {
            if id[index] >= 65 && id[index] <= 90 { return report(4, mode, 0, 0, 0) }
            index += 1
        }
        if blend.title(mode, false).length == 0 || blend.title(mode, true).length == 0 { return report(5, mode, 0, 0, 0) }
        if blend.category(mode) >= blend.CATEGORY_COUNT { return report(5, mode, 0, 0, 0) }
        mode += 1
    }
    var known: usize = 0
    var svgCount: usize = 0
    while known < 28 {
        const entry = KNOWN[known]
        if !std.text.same(blend.name(entry.mode), entry.id) || !std.text.same(blend.oraName(entry.mode), entry.ora) { return report(6, entry.mode, 0, 0, 0) }
        if blend.byName(entry.id) != entry.mode || blend.byName(entry.ora) != entry.mode { return report(6, entry.mode, 0, 0, 0) }
        known += 1
    }
    mode = 0
    while mode < blend.COUNT {
        if std.text.startsWith(blend.oraName(mode), "svg:") { svgCount += 1 }
        mode += 1
    }
    if svgCount != 20 { return 6 }
    // Other spellings, and what no file should name.
    if blend.byName("krita:multiply") != blend.MULTIPLY || blend.byName("Hard Mix") != blend.HARD_MIX || blend.byName("hard_mix") != blend.HARD_MIX { return 7 }
    if blend.byName("svg:dst-over") != blend.BEHIND || blend.byName("linear_dodge") != blend.ADDITION || blend.byName("krita:penumbra a") != blend.PENUMBRA_A { return 7 }
    if blend.byName("") != blend.NORMAL || blend.byName("no such mode") != blend.NORMAL || blend.byName("krita:") != blend.NORMAL || blend.byName("svg:nothing") != blend.NORMAL { return 7 }
    // A number that is no mode is Normal everywhere.
    if !std.text.same(blend.name(blend.COUNT), "normal") || !std.text.same(blend.title(9999, false), "Normal") || blend.category(blend.COUNT) != blend.CATEGORY_MIX { return 7 }
    if blend.blendPixel(blend.COUNT + 5, 0xFF102030, 0x80405060, 200) != pixel.over(0xFF102030, 0x80405060, 200) { return 7 }
    if !std.text.same(blend.title(blend.NORMAL, true), "Normal") || !std.text.same(blend.title(blend.ERASE, false), "Erase") || !std.text.same(blend.title(blend.ERASE, true), "Radieren") { return 8 }
    if !std.text.same(blend.title(blend.MULTIPLY, false), "Multiply") || !std.text.same(blend.title(blend.MULTIPLY, true), "Multiplizieren") { return 8 }
    if blend.category(blend.NORMAL) != blend.CATEGORY_MIX || blend.category(blend.MULTIPLY) != blend.CATEGORY_ARITHMETIC || blend.category(blend.BURN) != blend.CATEGORY_DARKEN { return 8 }
    if blend.category(blend.SCREEN) != blend.CATEGORY_LIGHTEN || blend.category(blend.EXCLUSION) != blend.CATEGORY_NEGATIVE || blend.category(blend.XOR) != blend.CATEGORY_BINARY { return 8 }
    if blend.category(blend.MODULO) != blend.CATEGORY_MODULO || blend.category(blend.GLOW) != blend.CATEGORY_QUADRATIC || blend.category(blend.HUE) != blend.CATEGORY_HSY { return 8 }
    if blend.category(blend.INTENSITY) != blend.CATEGORY_HSI || blend.category(blend.LIGHTNESS) != blend.CATEGORY_HSL || blend.category(blend.VALUE) != blend.CATEGORY_HSV || blend.category(blend.BUMPMAP) != blend.CATEGORY_MISC { return 8 }
    var which: u8 = 0
    while which < blend.CATEGORY_COUNT {
        if blend.categoryTitle(which, false).length == 0 || blend.categoryTitle(which, true).length == 0 { return 9 }
        which += 1
    }
    if !std.text.same(blend.categoryTitle(blend.CATEGORY_MIX, false), "Mix") || !std.text.same(blend.categoryTitle(blend.CATEGORY_MISC, true), "Verschiedenes") || blend.categoryTitle(blend.CATEGORY_COUNT, false).length != 0 { return 9 }
    return 0
}

// The menu's order: every mode once, Normal first, a category never
// coming back once it was left, and each category has modes.
fn menu(seen: [*]u8) -> u8 {
    if blend.listedCount() != @intCast(usize, blend.COUNT) || blend.listed(0) != blend.NORMAL { return 10 }
    var index: usize = 0
    while index < @intCast(usize, blend.COUNT) {
        seen[index] = 0
        index += 1
    }
    var last: u8 = 0
    var categories: u32 = 1
    index = 0
    while index < blend.listedCount() {
        const mode = blend.listed(index)
        if mode >= blend.COUNT || seen[@intCast(usize, mode)] != 0 { return 10 }
        seen[@intCast(usize, mode)] = 1
        const now = blend.category(mode)
        if now < last { return 11 }
        if now > last { categories += 1 }
        last = now
        index += 1
    }
    if categories != @intCast(u32, blend.CATEGORY_COUNT) { return 11 }
    if blend.listed(blend.listedCount()) != blend.NORMAL { return 11 }
    return 0
}

// What must leave the backdrop alone, for one mode.
fn untouched(mode: u16, under: [*]u32, source: [*]u32, mask: [*]u8) -> u8 {
    var round: u32 = 0
    while round < 60 {
        var before = randomPixel()
        // A transparent backdrop keeps even the colour it does not show.
        if round == 0 { before = 0x00123456 }
        if round == 1 { before = 0 }
        if round == 2 { before = 0xFFFFFFFF }
        const top = randomPixel()
        const amount = 1 + random() % 255
        const flags = random() % 16
        const seed = random()
        if blend.blendPixel(mode, before, top, 0) != before { return report(12, mode, before, top, blend.blendPixel(mode, before, top, 0)) }
        if blend.blendPixelAt(mode, before, top, 0, flags, seed) != before { return report(12, mode, before, top, 0) }
        // A transparent source, whatever colour it has.
        const nothing = top & 0x00FFFFFF
        const result = blend.blendPixelAt(mode, before, nothing, amount, 0, seed)
        if !blend.affectsWithoutSource(mode) && result != before { return report(14, mode, before, nothing, result) }
        // The flags.
        const mixed = blend.blendPixelAt(mode, before, top, amount, flags, seed)
        if flags & blend.FLAG_ALPHA_LOCK != 0 {
            if mixed >> 24 != before >> 24 { return report(15, mode, before, top, mixed) }
            if before >> 24 == 0 && mixed != before { return report(15, mode, before, top, mixed) }
        }
        if flags & blend.FLAG_LOCK_RED != 0 && (mixed ^ before) & 0x00FF0000 != 0 { return report(16, mode, before, top, mixed) }
        if flags & blend.FLAG_LOCK_GREEN != 0 && (mixed ^ before) & 0x0000FF00 != 0 { return report(16, mode, before, top, mixed) }
        if flags & blend.FLAG_LOCK_BLUE != 0 && (mixed ^ before) & 0x000000FF != 0 { return report(16, mode, before, top, mixed) }
        // What is not held: without the alpha lock what the mode gives
        // without flags. Under it a mode with a B takes the backdrop as
        // opaque (Source Atop): each channel from the backdrop's toward
        // B, which is what the mode makes of the two colours opaque, by
        // the cover; the modes with their own rule for alpha give what
        // they give without flags, and where that is nothing at all the
        // pixel stays.
        const free = blend.blendPixelAt(mode, before, top, amount, 0, seed)
        var holds: u32 = 0
        if flags & blend.FLAG_ALPHA_LOCK != 0 { holds |= 0xFF000000 }
        if flags & blend.FLAG_LOCK_RED != 0 { holds |= 0x00FF0000 }
        if flags & blend.FLAG_LOCK_GREEN != 0 { holds |= 0x0000FF00 }
        if flags & blend.FLAG_LOCK_BLUE != 0 { holds |= 0x000000FF }
        var expected = free
        if flags & blend.FLAG_ALPHA_LOCK != 0 {
            const cover = pixel.mul(top >> 24, amount)
            if before >> 24 == 0 {
                expected = before
            } else if kindOf(mode) != 2 || mode == blend.NORMAL {
                var b = top
                if mode != blend.NORMAL { b = blend.blendPixel(mode, before | 0xFF000000, top | 0xFF000000, 255) }
                expected = if cover == 0 { before } else { pixel.pack(before >> 24, pixel.lerp(pixel.red(before), pixel.red(b), cover), pixel.lerp(pixel.green(before), pixel.green(b), cover), pixel.lerp(pixel.blue(before), pixel.blue(b), cover)) }
            } else if free >> 24 == 0 {
                expected = before
            }
        }
        if (mixed ^ expected) & ~holds != 0 { return report(17, mode, before, top, mixed) }
        // A row: no opacity, and a mask of nothing.
        var index: usize = 0
        while index < 8 {
            under[index] = if index == 0 { before } else { randomPixel() }
            under[index + 8] = under[index]
            source[index] = if index == 0 { top } else { randomPixel() }
            mask[index] = 0
            index += 1
        }
        blend.compositeSpanAt(mode, under, source, 8, 0, null, flags, seed)
        blend.compositeSpanAt(mode, under, source, 8, amount, mask, flags, seed)
        blend.compositeSpan(mode, under, source, 0, amount, null, flags)
        index = 0
        while index < 8 {
            if under[index] != under[index + 8] { return report(18, mode, under[index + 8], source[index], under[index]) }
            index += 1
        }
        round += 1
    }
    return 0
}

// An opaque pixel over an opaque one at the full amount: the mode's
// formula, each channel within one step.
fn overOpaque(mode: u16) -> u8 {
    const kind = kindOf(mode)
    if kind == 0 {
        var i: usize = 0
        while i < 30 {
            var j: usize = 0
            while j < 30 {
                const b = GRID[i]
                const s = GRID[j]
                // Three pairs at once: (b, s), (s, b) and both inverted.
                const before = pixel.rgb(b, s, 255 - b)
                const top = pixel.rgb(s, b, 255 - s)
                const got = blend.blendPixel(mode, before, top, 255)
                if got >> 24 != 255 { return report(19, mode, before, top, got) }
                if !separableFits(mode, pixel.red(got), b, s) || !separableFits(mode, pixel.green(got), s, b) || !separableFits(mode, pixel.blue(got), 255 - b, 255 - s) { return report(19, mode, before, top, got) }
                j += 1
            }
            i += 1
        }
        return 0
    }
    var round: usize = 0
    while round < 400 {
        var before = random() | 0xFF000000
        var top = random() | 0xFF000000
        if round < PAIRS {
            before = UNDERS[round]
            top = SOURCES[round]
        } else if round < 2 * PAIRS {
            // Greys and near-greys: where hue and saturation give way.
            before = pixel.gray(random() % 256) ^ (random() & 0x00010101)
            top = pixel.gray(random() % 256) ^ (random() & 0x00010100)
        }
        const got = blend.blendPixel(mode, before, top, 255)
        if kind == 1 {
            if got >> 24 != 255 || !colorFits(mode, got, before, top) { return report(20, mode, before, top, got) }
        } else {
            // The rules for alpha: what each leaves of two opaque pixels.
            var wanted = top
            if mode == blend.ERASE { wanted = 0 }
            if mode == blend.BEHIND || mode == blend.DESTINATION_IN || mode == blend.DESTINATION_ATOP || mode == blend.GREATER { wanted = before }
            if mode == blend.LUMINOSITY_SAI {
                wanted = pixel.rgb(pixel.smaller(255, pixel.red(before) + pixel.red(top)), pixel.smaller(255, pixel.green(before) + pixel.green(top)), pixel.smaller(255, pixel.blue(before) + pixel.blue(top)))
            }
            if got != wanted { return report(21, mode, before, top, got) }
        }
        round += 1
    }
    return 0
}

// Every pair of channels, for the modes whose rows the module reads from
// tables it makes (Dodge, Burn, Soft Light (SVG)) and for Hard Mix, made
// of the first two: a row of opaque pixels for each backdrop channel,
// every pixel of it against blendPixel and the formula, so each entry
// of those tables is held against both.
fn everyPair(mode: u16, under: [*]u32, source: [*]u32) -> u8 {
    var b: u32 = 0
    while b < 256 {
        var s: u32 = 0
        while s < 256 {
            under[@intCast(usize, s)] = pixel.rgb(b, s, 255 - b)
            source[@intCast(usize, s)] = pixel.rgb(s, b, 255 - s)
            s += 1
        }
        blend.compositeSpan(mode, under, source, 256, 255, null, 0)
        s = 0
        while s < 256 {
            const before = pixel.rgb(b, s, 255 - b)
            const top = pixel.rgb(s, b, 255 - s)
            const got = under[@intCast(usize, s)]
            if got != blend.blendPixel(mode, before, top, 255) { return report(50, mode, before, top, got) }
            if !separableFits(mode, pixel.red(got), b, s) || !separableFits(mode, pixel.green(got), s, b) || !separableFits(mode, pixel.blue(got), 255 - b, 255 - s) { return report(50, mode, before, top, got) }
            s += 1
        }
        b += 1
    }
    return 0
}

// Translucent pixels: the alpha and the colour of the module's header,
// with the mode's own B for the two colours (what it gives when both are
// opaque, checked above).
fn translucent(mode: u16) -> u8 {
    var round: usize = 0
    while round < 300 {
        const before = randomPixel()
        const top = randomPixel()
        const amount = randomAmount()
        const got = blend.blendPixel(mode, before, top, amount)
        const cover = pixel.mul(top >> 24, amount)
        const ab = before >> 24
        if cover == 0 {
            if got != before { return report(22, mode, before, top, got) }
        } else if ab == 0 {
            if got != ((cover << 24) | (top & 0x00FFFFFF)) { return report(22, mode, before, top, got) }
        } else {
            const blended = blend.blendPixel(mode, before | 0xFF000000, top | 0xFF000000, 255)
            const total = cover * 255 + ab * 255 - cover * ab
            if got >> 24 != (total + 127) / 255 { return report(23, mode, before, top, got) }
            const as = @floatFromInt(f64, cover) / 255.0
            const bs = @floatFromInt(f64, ab) / 255.0
            var channel: u32 = 0
            while channel < 3 {
                const shift = 16 - 8 * channel
                const cs = @floatFromInt(f64, (top >> shift) & 255)
                const cb = @floatFromInt(f64, (before >> shift) & 255)
                const both = @floatFromInt(f64, (blended >> shift) & 255)
                const wanted = ((1.0 - bs) * as * cs + (1.0 - as) * bs * cb + as * bs * both) / (as + bs - as * bs)
                if distance(@floatFromInt(f64, (got >> shift) & 255), wanted) > 0.5001 { return report(24, mode, before, top, got) }
                channel += 1
            }
        }
        round += 1
    }
    return 0
}

// Normal is pixel.over, and exact where it can be.
fn normal() -> u8 {
    var round: usize = 0
    while round < 20000 {
        const before = randomPixel()
        const top = randomPixel()
        const amount = randomAmount()
        const got = blend.blendPixel(blend.NORMAL, before, top, amount)
        if got != pixel.over(before, top, amount) { return report(25, blend.NORMAL, before, top, got) }
        // The straight-alpha mix in f64: alpha as + ab - as ab, each
        // channel as Cs + (1 - as) ab Cb over it.
        const as = @floatFromInt(f64, pixel.mul(top >> 24, amount)) / 255.0
        const ab = @floatFromInt(f64, before >> 24) / 255.0
        const ao = as + ab - as * ab
        if as == 0.0 {
            if got != before { return report(25, blend.NORMAL, before, top, got) }
        } else {
            if distance(@floatFromInt(f64, got >> 24), 255.0 * ao) > 0.5001 { return report(25, blend.NORMAL, before, top, got) }
            var channel: u32 = 0
            while channel < 3 {
                const shift = 16 - 8 * channel
                const wanted = (as * @floatFromInt(f64, (top >> shift) & 255) + (1.0 - as) * ab * @floatFromInt(f64, (before >> shift) & 255)) / ao
                if distance(@floatFromInt(f64, (got >> shift) & 255), wanted) > 0.5001 { return report(25, blend.NORMAL, before, top, got) }
                channel += 1
            }
        }
        // An opaque pixel at the full amount is stored as it is.
        const solid = top | 0xFF000000
        if blend.blendPixel(blend.NORMAL, before, solid, 255) != solid { return report(26, blend.NORMAL, before, solid, 0) }
        // A colour over itself stays that colour, whatever the alphas.
        if top >> 24 != 0 && before >> 24 != 0 {
            const same = (before & 0xFF000000) | (top & 0x00FFFFFF)
            const twice = blend.blendPixel(blend.NORMAL, same, top, amount)
            if (twice ^ top) & 0x00FFFFFF != 0 { return report(27, blend.NORMAL, same, top, twice) }
        }
        round += 1
    }
    return 0
}

// A pixel of a row and what blendPixelAt says it must be.
fn rows(mode: u16, rounds: usize, under: [*]u32, source: [*]u32, wanted: [*]u32, mask: [*]u8) -> u8 {
    var round: usize = 0
    while round < rounds {
        const flags = @intCast(u32, round % 16)
        const masked = (round / 16) % 2 == 1
        var opacity = random() % 256
        if round % 5 == 0 { opacity = 255 }
        if round % 37 == 36 { opacity = 0 }
        var count: usize = @intCast(usize, random() % 120)
        if round % 9 == 0 { count = round % 3 }
        if round % 50 == 49 { count = 300 }
        const seed = random()
        // Stretches of transparent and of opaque source pixels, as layers
        // have them, between the random ones.
        var index: usize = 0
        var run: u32 = 0
        var runKind: u32 = 0
        while index < count + 2 {
            if run == 0 {
                run = 1 + random() % 12
                runKind = random() % 4
            }
            run -= 1
            under[index] = randomPixel()
            source[index] = randomPixel()
            if runKind == 0 { source[index] &= 0x00FFFFFF }
            if runKind == 1 { source[index] |= 0xFF000000 }
            const cover = random()
            mask[index] = @intCast(u8, if cover % 5 == 0 { 0 } else if cover % 5 == 1 { 255 } else { (cover >> 8) & 255 })
            var amount = opacity
            if masked { amount = pixel.mul(opacity, @intCast(u32, mask[index])) }
            wanted[index] = if index < count { blend.blendPixelAt(mode, under[index], source[index], amount, flags, seed +% @intCast(u32, index)) } else { under[index] }
            index += 1
        }
        var amounts: ?[*]const u8 = null
        if masked { amounts = mask }
        blend.compositeSpanAt(mode, under, source, count, opacity, amounts, flags, seed)
        index = 0
        while index < count + 2 {
            if under[index] != wanted[index] {
                _ = std.io.print("row: flags ")
                _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, flags))
                _ = std.io.print(if masked { " masked" } else { " plain" })
                _ = std.io.print(" opacity ")
                _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, opacity))
                _ = std.io.print(" pixel ")
                _ = std.io.writeUnsigned(std.io.stdout(), index)
                _ = std.io.print(" of ")
                _ = std.io.writeUnsigned(std.io.stdout(), count)
                _ = std.io.print(" wanted ")
                _ = std.io.writeHex(std.io.stdout(), @intCast(usize, wanted[index]))
                _ = std.io.println("")
                var code: u8 = 28
                if index >= count { code = 29 }
                return report(code, mode, 0, source[index], under[index])
            }
            index += 1
        }
        round += 1
    }
    return 0
}

// compositeSpan is compositeSpanAt with seed 0.
fn unseeded(mode: u16, under: [*]u32, source: [*]u32, wanted: [*]u32) -> u8 {
    var index: usize = 0
    while index < 64 {
        under[index] = randomPixel()
        wanted[index] = under[index]
        source[index] = randomPixel()
        index += 1
    }
    blend.compositeSpan(mode, under, source, 64, 200, null, 0)
    blend.compositeSpanAt(mode, wanted, source, 64, 200, null, 0, 0)
    index = 0
    while index < 64 {
        if under[index] != wanted[index] { return report(30, mode, wanted[index], source[index], under[index]) }
        index += 1
    }
    return 0
}

// The modes with a rule of their own for alpha.
fn rules(under: [*]u32, source: [*]u32, wanted: [*]u32) -> u8 {
    // Erase: the backdrop's alpha times what the source leaves.
    if blend.blendPixel(blend.ERASE, 0xFF112233, 0x80000000, 255) != 0x7F112233 { return 31 }
    if blend.blendPixel(blend.ERASE, 0xFF112233, 0xFFABCDEF, 255) != 0 || blend.blendPixel(blend.ERASE, 0x80112233, 0xFF000000, 128) != 0x40112233 { return 31 }
    if blend.blendPixelAt(blend.ERASE, 0xFF112233, 0xFF000000, 255, blend.FLAG_ALPHA_LOCK, 0) != 0xFF112233 { return 31 }

    // Behind: nothing under an opaque pixel, the source itself where
    // there was nothing, and between the two the backdrop over it.
    if blend.blendPixel(blend.BEHIND, 0xFF112233, 0xFFABCDEF, 255) != 0xFF112233 || blend.blendPixel(blend.BEHIND, 0x00112233, 0x80ABCDEF, 255) != 0x80ABCDEF { return 32 }
    if blend.blendPixel(blend.BEHIND, 0x00112233, 0xFFABCDEF, 128) != 0x80ABCDEF { return 32 }
    var round: usize = 0
    while round < 2000 {
        const before = randomPixel()
        const top = randomPixel()
        const amount = randomAmount()
        const cover = pixel.mul(top >> 24, amount)
        const ab = before >> 24

        const behind = blend.blendPixel(blend.BEHIND, before, top, amount)
        if cover != 0 && ab != 0 {
            const total = cover * 255 + ab * 255 - cover * ab
            if behind >> 24 != (total + 127) / 255 { return report(32, blend.BEHIND, before, top, behind) }
            const as = @floatFromInt(f64, cover) / 255.0
            const bs = @floatFromInt(f64, ab) / 255.0
            var channel: u32 = 0
            while channel < 3 {
                const shift = 16 - 8 * channel
                const wantedChannel = (bs * @floatFromInt(f64, (before >> shift) & 255) + (1.0 - bs) * as * @floatFromInt(f64, (top >> shift) & 255)) / (as + bs - as * bs)
                if distance(@floatFromInt(f64, (behind >> shift) & 255), wantedChannel) > 0.5001 { return report(32, blend.BEHIND, before, top, behind) }
                channel += 1
            }
        }

        // Destination In: the colour stays, the alpha goes to its
        // product with the source's as the amount goes to 1.
        const within = blend.blendPixel(blend.DESTINATION_IN, before, top, amount)
        const left = pixel.mul(ab, 255 - pixel.mul(255 - (top >> 24), amount))
        if within != (if left == 0 { 0 } else { (before & 0x00FFFFFF) | (left << 24) }) { return report(33, blend.DESTINATION_IN, before, top, within) }

        // Source Atop: the alpha stays, the colour goes to the source's.
        const atop = blend.blendPixel(blend.SOURCE_ATOP, before, top, amount)
        if atop >> 24 != ab { return report(34, blend.SOURCE_ATOP, before, top, atop) }
        if ab == 0 || cover == 0 {
            if atop != before { return report(34, blend.SOURCE_ATOP, before, top, atop) }
        } else if atop != ((ab << 24) | (pixel.lerp(pixel.red(before), pixel.red(top), cover) << 16) | (pixel.lerp(pixel.green(before), pixel.green(top), cover) << 8) | pixel.lerp(pixel.blue(before), pixel.blue(top), cover)) {
            return report(34, blend.SOURCE_ATOP, before, top, atop)
        }

        // Copy: the pixel on its way to the source.
        const copied = blend.blendPixel(blend.COPY, before, top, amount)
        if copied != pixel.mix(before, top, amount) { return report(35, blend.COPY, before, top, copied) }
        if blend.blendPixel(blend.COPY, before, top, 255) != top { return report(35, blend.COPY, before, top, 0) }

        // Destination Atop: at the full amount the source's alpha, with
        // the backdrop's colour where the backdrop was.
        const dest = blend.blendPixel(blend.DESTINATION_ATOP, before, top, 255)
        if top >> 24 == 0 {
            if dest != 0 { return report(36, blend.DESTINATION_ATOP, before, top, dest) }
        } else {
            if dest >> 24 != top >> 24 { return report(36, blend.DESTINATION_ATOP, before, top, dest) }
            if ab == 255 && (dest ^ before) & 0x00FFFFFF != 0 { return report(36, blend.DESTINATION_ATOP, before, top, dest) }
            if ab == 0 && (dest ^ top) & 0x00FFFFFF != 0 { return report(36, blend.DESTINATION_ATOP, before, top, dest) }
        }

        // Alpha Darken: the alpha never falls and never passes the
        // larger of what it was and the amount.
        const washed = blend.blendPixel(blend.ALPHA_DARKEN, before, top, amount)
        if washed >> 24 < ab || washed >> 24 > pixel.larger(ab, amount) { return report(37, blend.ALPHA_DARKEN, before, top, washed) }

        // Greater: the alpha never falls and never passes the larger of
        // the two; an opaque backdrop stays.
        const greater = blend.blendPixel(blend.GREATER, before, top, amount)
        if greater >> 24 < ab || greater >> 24 > pixel.larger(ab, cover) { return report(38, blend.GREATER, before, top, greater) }
        if ab == 255 && greater != before { return report(38, blend.GREATER, before, top, greater) }
        // A source far below the backdrop's alpha changes nothing, one
        // far above it gives its own alpha.
        if ab != 0 && cover + 64 < ab && greater != before { return report(38, blend.GREATER, before, top, greater) }
        if cover > ab + 64 && greater >> 24 != cover { return report(38, blend.GREATER, before, top, greater) }

        // Shine over an opaque backdrop: the source's colour times its
        // alpha, added.
        const solid = before | 0xFF000000
        const shine = blend.blendPixel(blend.LUMINOSITY_SAI, solid, top, amount)
        const lit = pixel.rgb(pixel.smaller(255, pixel.red(solid) + pixel.mul(pixel.red(top), cover)), pixel.smaller(255, pixel.green(solid) + pixel.mul(pixel.green(top), cover)), pixel.smaller(255, pixel.blue(solid) + pixel.mul(pixel.blue(top), cover)))
        if shine != lit { return report(39, blend.LUMINOSITY_SAI, solid, top, shine) }
        const faint = blend.blendPixel(blend.LUMINOSITY_SAI, before, top, amount)
        if cover != 0 && ab != 0 && faint >> 24 != (cover * 255 + ab * 255 - cover * ab + 127) / 255 { return report(39, blend.LUMINOSITY_SAI, before, top, faint) }
        round += 1
    }
    if blend.blendPixel(blend.DESTINATION_IN, 0xFF112233, 0x80445566, 255) != 0x80112233 || blend.blendPixel(blend.DESTINATION_IN, 0xFF112233, 0x80445566, 128) != 0xBF112233 { return 33 }
    if blend.blendPixel(blend.DESTINATION_IN, 0xFF112233, 0x00445566, 255) != 0 { return 33 }
    if blend.blendPixel(blend.SOURCE_ATOP, 0x80102030, 0xFF405060, 255) != 0x80405060 || blend.blendPixel(blend.SOURCE_ATOP, 0x00102030, 0xFF405060, 255) != 0x00102030 { return 34 }
    if blend.blendPixel(blend.COPY, 0xFF102030, 0x00405060, 255) != 0x00405060 || blend.blendPixel(blend.COPY, 0xFF000000, 0xFFFFFFFF, 128) != 0xFF808080 { return 35 }
    if blend.blendPixel(blend.DESTINATION_ATOP, 0xFF112233, 0x80445566, 255) != 0x80112233 || blend.blendPixel(blend.DESTINATION_ATOP, 0, 0x80445566, 255) != 0x80445566 { return 36 }
    if blend.blendPixel(blend.DESTINATION_ATOP, 0xFF112233, 0x00445566, 255) != 0 || blend.blendPixel(blend.DESTINATION_ATOP, 0xFF112233, 0x00445566, 128) != 0x7F112233 { return 36 }
    if !blend.affectsWithoutSource(blend.COPY) || !blend.affectsWithoutSource(blend.DESTINATION_IN) || !blend.affectsWithoutSource(blend.DESTINATION_ATOP) { return 40 }
    var mode: u16 = 0
    var acting: u32 = 0
    while mode < blend.COUNT {
        if blend.affectsWithoutSource(mode) { acting += 1 }
        mode += 1
    }
    if acting != 3 { return 40 }

    // Alpha Darken: dabs of a half-opaque brush at a stroke opacity of
    // 100 rise to exactly that and stay, and take the brush's colour.
    var wash: u32 = 0
    var dab: u32 = 0
    while dab < 40 {
        const next = blend.blendPixel(blend.ALPHA_DARKEN, wash, 0x80FF8000, 100)
        if next >> 24 < wash >> 24 || next >> 24 > 100 { return 41 }
        wash = next
        dab += 1
    }
    if wash != 0x64FF8000 { return 41 }
    if blend.blendPixel(blend.ALPHA_DARKEN, 0xFF000000, 0xFFFFFFFF, 128) != 0xFF808080 || blend.blendPixel(blend.ALPHA_DARKEN, 0xC8102030, 0xFF102030, 100) != 0xC8102030 { return 41 }

    // Greater: on nothing an opaque source is itself.
    if blend.blendPixel(blend.GREATER, 0, 0xFF405060, 255) != 0xFF405060 || blend.blendPixel(blend.GREATER, 0x00FFFFFF, 0xC8405060, 255) != 0xC8405060 { return 42 }
    // Shine on nothing is the source.
    if blend.blendPixel(blend.LUMINOSITY_SAI, 0, 0x80405060, 255) != 0x80405060 || blend.blendPixel(blend.LUMINOSITY_SAI, 0xFF808080, 0x80FFFFFF, 255) != 0xFFFFFFFF { return 43 }
    if blend.blendPixel(blend.LUMINOSITY_SAI, 0xFF101010, 0x80808080, 255) != 0xFF505050 { return 43 }

    // Dissolve: a pixel is the source, opaque, or it is as it was; the
    // share taken is the source's alpha times the amount; the same seed
    // gives the same pixels, however the row is cut; another row falls
    // differently.
    const count: usize = 4096
    var share: u32 = 0
    while share < 5 {
        const alpha: u32 = if share == 0 { 255 } else if share == 1 { 128 } else if share == 2 { 26 } else if share == 3 { 230 } else { 1 }
        const amount: u32 = if share == 3 { 128 } else { 255 }
        const cover = pixel.mul(alpha, amount)
        var index: usize = 0
        while index < count {
            under[index] = 0x40102030
            wanted[index] = 0x40102030
            source[index] = (alpha << 24) | 0x00ABCDEF
            index += 1
        }
        const seed = blend.seedAt(-17, 5)
        blend.compositeSpanAt(blend.DISSOLVE, under, source, count, amount, null, 0, seed)
        var taken: u32 = 0
        index = 0
        while index < count {
            if under[index] == 0xFFABCDEF { taken += 1 } else if under[index] != 0x40102030 { return report(44, blend.DISSOLVE, 0x40102030, source[index], under[index]) }
            if under[index] != blend.blendPixelAt(blend.DISSOLVE, 0x40102030, source[index], amount, 0, seed +% @intCast(u32, index)) { return 44 }
            index += 1
        }
        // The expected count and five of its standard deviations (32 at
        // the most for 4096 pixels).
        const expected = @intCast(u32, count) * cover / 255
        if taken + 160 < expected || taken > expected + 160 { return report(45, blend.DISSOLVE, alpha, amount, taken) }
        if cover == 255 && taken != @intCast(u32, count) { return 45 }
        // Cut in three: the same picture.
        blend.compositeSpanAt(blend.DISSOLVE, wanted, source, 1000, amount, null, 0, seed)
        blend.compositeSpanAt(blend.DISSOLVE, wanted + 1000, source + 1000, 1, amount, null, 0, seed +% 1000)
        blend.compositeSpanAt(blend.DISSOLVE, wanted + 1001, source + 1001, count - 1001, amount, null, 0, blend.seedAt(-17 + 1001, 5))
        index = 0
        while index < count {
            if under[index] != wanted[index] { return report(46, blend.DISSOLVE, wanted[index], source[index], under[index]) }
            index += 1
        }
        // The row below.
        if cover > 20 && cover < 240 {
            index = 0
            while index < count {
                wanted[index] = 0x40102030
                index += 1
            }
            blend.compositeSpanAt(blend.DISSOLVE, wanted, source, count, amount, null, 0, blend.seedAt(-17, 6))
            var different: u32 = 0
            index = 0
            while index < count {
                if under[index] != wanted[index] { different += 1 }
                index += 1
            }
            if different < 100 { return report(47, blend.DISSOLVE, alpha, amount, different) }
        }
        share += 1
    }
    if blend.seedAt(8, -3) != blend.seedAt(7, -3) +% 1 || blend.seedAt(0, 0) == blend.seedAt(0, 1) { return 47 }
    return 0
}

// ---- Edges --------------------------------------------------------------

// A row of `count` random pixels at `at`, the same into `copy`.
fn fill(at: [*]u32, copy: [*]u32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        at[index] = randomPixel()
        copy[index] = at[index]
        index += 1
    }
}

fn sameRow(a: [*]const u32, b: [*]const u32, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// The alpha lock, by values worked out by hand: a faint pixel takes as
// much of the new colour as a solid one, a mode's B counts the backdrop
// as opaque, and what a mode would take away wholly stays.
fn alphaLock() -> u8 {
    const lock = blend.FLAG_ALPHA_LOCK
    // Half of blue over red: 127 of red left, 128 of blue, either alpha.
    if blend.blendPixelAt(blend.NORMAL, 0x10FF0000, 0x800000FF, 255, lock, 0) != 0x107F0080 { return 52 }
    if blend.blendPixelAt(blend.NORMAL, 0xFFFF0000, 0x800000FF, 255, lock, 0) != 0xFF7F0080 { return 52 }
    // Without the lock the faint pixel is almost all blue: 0x10 + 0x80
    // (1 - 0x80/255) = 0x88 of alpha, blue 128 * 255 / (128 * 255 +
    // 16 * 127) = 0.941 of it.
    if blend.blendPixel(blend.NORMAL, 0x10FF0000, 0x800000FF, 255) != 0x880F00F0 { return 52 }
    // Multiply: 128 * 64 / 255 = 32.1, all of it.
    if blend.blendPixelAt(blend.MULTIPLY, 0x20808080, 0xFF404040, 255, lock, 0) != 0x20202020 { return 52 }
    // Screen by half: 128 + 64 - 32 = 160, half of the way from 128: 144.
    if blend.blendPixelAt(blend.SCREEN, 0x01808080, 0xFF404040, 128, lock, 0) != 0x01909090 { return 52 }
    // A row with the lock: the same as pixel by pixel.
    var mode: u16 = 0
    while mode < blend.COUNT {
        // The three that act on a transparent source: under the lock
        // they would leave nothing, so the pixel stays as it was.
        const keeps = blend.blendPixelAt(mode, 0x80123456, 0x00ABCDEF, 255, lock, 7)
        if blend.affectsWithoutSource(mode) && keeps != 0x80123456 { return report(53, mode, 0x80123456, 0x00ABCDEF, keeps) }
        mode += 1
    }
    if blend.blendPixelAt(blend.ERASE, 0x80123456, 0xFFABCDEF, 255, lock, 0) != 0x80123456 { return 53 }
    if blend.blendPixelAt(blend.COPY, 0x80123456, 0xFFABCDEF, 255, lock, 0) != 0x80ABCDEF { return 53 }
    // Unlocked, the same take the alpha away.
    if blend.blendPixel(blend.DESTINATION_ATOP, 0x80123456, 0x00ABCDEF, 255) >> 24 != 0 || blend.blendPixel(blend.COPY, 0x80123456, 0x00ABCDEF, 255) >> 24 != 0 { return 53 }
    return 0
}

// For every mode: an opacity or amount above 255 is 255; a mask of 255
// everywhere is no mask; flags beyond the four do nothing; a number
// past the modes is Normal; spans of one pixel and spans cut at
// multiples of 64 (a tile's width) give what one span gives; a row
// mixed into itself; twice the same work gives the same.
fn rowEdges(mode: u16, under: [*]u32, source: [*]u32, wanted: [*]u32, mask: [*]u8) -> u8 {
    const count: usize = 192
    var round: u32 = 0
    while round < 4 {
        const flags = random() % 16
        const seed = random()
        fill(source, wanted, count)
        fill(under, wanted, count)
        var index: usize = 0
        while index < count {
            mask[index] = 255
            index += 1
        }
        blend.compositeSpanAt(mode, wanted, source, count, 255, null, flags, seed)
        // Above 255.
        var tries: u32 = 0
        while tries < 3 {
            const opacity: u32 = if tries == 0 { 256 } else if tries == 1 { 1000 } else { 0xFFFFFFFF }
            index = 0
            while index < count {
                under[index + count] = under[index]
                index += 1
            }
            blend.compositeSpanAt(mode, under + count, source, count, opacity, null, flags, seed)
            if !sameRow(under + count, wanted, count) { return report(54, mode, under[0], source[0], opacity) }
            tries += 1
        }
        if blend.blendPixelAt(mode, under[5], source[5], 300, flags, seed) != blend.blendPixelAt(mode, under[5], source[5], 255, flags, seed) { return report(54, mode, under[5], source[5], 0) }
        // A mask of 255 everywhere, and flags past the four.
        index = 0
        while index < count {
            under[index + count] = under[index]
            under[index + 2 * count] = under[index]
            index += 1
        }
        blend.compositeSpanAt(mode, under + count, source, count, 255, mask, flags, seed)
        if !sameRow(under + count, wanted, count) { return report(55, mode, under[0], source[0], 0) }
        blend.compositeSpanAt(mode, under + 2 * count, source, count, 255, null, flags | 0xFFFFFFF0, seed)
        if !sameRow(under + 2 * count, wanted, count) { return report(56, mode, under[0], source[0], 0) }
        // Cut at 64 and 128, and one pixel at a time across 63/64.
        const opacity = 1 + random() % 255
        index = 0
        while index < count {
            under[index + count] = under[index]
            under[index + 2 * count] = under[index]
            index += 1
        }
        blend.compositeSpanAt(mode, under + count, source, count, opacity, null, flags, seed)
        blend.compositeSpanAt(mode, under + 2 * count, source, 64, opacity, null, flags, seed)
        blend.compositeSpanAt(mode, under + 2 * count + 64, source + 64, 64, opacity, null, flags, seed +% 64)
        blend.compositeSpanAt(mode, under + 2 * count + 128, source + 128, 64, opacity, null, flags, seed +% 128)
        if !sameRow(under + count, under + 2 * count, count) { return report(57, mode, under[0], source[0], 0) }
        index = 0
        while index < count {
            under[index + 2 * count] = under[index]
            index += 1
        }
        index = 0
        while index < count {
            blend.compositeSpanAt(mode, under + 2 * count + index, source + index, 1, opacity, null, flags, seed +% @intCast(u32, index))
            index += 1
        }
        if !sameRow(under + count, under + 2 * count, count) { return report(58, mode, under[0], source[0], 0) }
        // Twice: the same work on the same row gives the same row.
        index = 0
        while index < count {
            under[index + 2 * count] = under[index]
            index += 1
        }
        blend.compositeSpanAt(mode, under + 2 * count, source, count, opacity, mask, flags, seed)
        if !sameRow(under + count, under + 2 * count, count) { return report(58, mode, under[0], source[0], 1) }
        // A number past the modes is Normal.
        if mode == blend.NORMAL {
            var past: u32 = 0
            while past < 2 {
                index = 0
                while index < count {
                    under[index + 2 * count] = under[index]
                    index += 1
                }
                blend.compositeSpanAt(if past == 0 { blend.COUNT } else { 0xFFFF }, under + 2 * count, source, count, opacity, null, flags, seed)
                if !sameRow(under + count, under + 2 * count, count) { return report(59, mode, under[0], source[0], past) }
                past += 1
            }
        }
        // A row mixed into itself: each pixel what blendPixelAt makes of
        // it over itself.
        index = 0
        while index < count {
            wanted[index] = blend.blendPixelAt(mode, under[index], under[index], opacity, flags, seed +% @intCast(u32, index))
            index += 1
        }
        blend.compositeSpanAt(mode, under, under, count, opacity, null, flags, seed)
        if !sameRow(under, wanted, count) { return report(60, mode, under[0], 0, 0) }
        round += 1
    }
    return 0
}

// Modes that reach their result in one go at the full amount over an
// opaque backdrop: done twice, the same as once.
fn twice() -> u8 {
    var round: u32 = 0
    while round < 500 {
        const before = random() | 0xFF000000
        const top = random() | 0xFF000000
        var which: u32 = 0
        while which < 4 {
            const mode = if which == 0 { blend.NORMAL } else if which == 1 { blend.DARKEN } else if which == 2 { blend.LIGHTEN } else { blend.COPY }
            const once = blend.blendPixel(mode, before, top, 255)
            if blend.blendPixel(mode, once, top, 255) != once { return report(61, mode, before, top, once) }
            which += 1
        }
        // Darken and Lighten are the smaller and larger channel exactly.
        const dark = blend.blendPixel(blend.DARKEN, before, top, 255)
        const light = blend.blendPixel(blend.LIGHTEN, before, top, 255)
        if dark != pixel.rgb(pixel.smaller(pixel.red(before), pixel.red(top)), pixel.smaller(pixel.green(before), pixel.green(top)), pixel.smaller(pixel.blue(before), pixel.blue(top))) { return report(61, blend.DARKEN, before, top, dark) }
        if light != pixel.rgb(pixel.larger(pixel.red(before), pixel.red(top)), pixel.larger(pixel.green(before), pixel.green(top)), pixel.larger(pixel.blue(before), pixel.blue(top))) { return report(61, blend.LIGHTEN, before, top, light) }
        round += 1
    }
    return 0
}

// Seeds at the ends of the coordinates: no trap, the next pixel the
// next seed (the largest x is followed by the smallest), and Dissolve
// over a row whose seeds pass 2^32 the same as pixel by pixel.
fn seeds(under: [*]u32, source: [*]u32, wanted: [*]u32) -> u8 {
    const most: i32 = 2147483647
    const least: i32 = -2147483647 - 1
    if blend.seedAt(least, 9) != blend.seedAt(most, 9) +% 1 || blend.seedAt(most, least) +% 1 != blend.seedAt(least, least) { return 62 }
    if blend.seedAt(0, most) == blend.seedAt(0, least) { return 62 }
    const seed: u32 = 0xFFFFFFE0
    var index: usize = 0
    while index < 64 {
        under[index] = randomPixel()
        source[index] = randomPixel() | 0x40000000
        wanted[index] = blend.blendPixelAt(blend.DISSOLVE, under[index], source[index], 200, 0, seed +% @intCast(u32, index))
        index += 1
    }
    blend.compositeSpanAt(blend.DISSOLVE, under, source, 64, 200, null, 0, seed)
    if !sameRow(under, wanted, 64) { return 62 }
    return 0
}

// ---- How long a pixel takes ---------------------------------------------

const PIXELS: usize = 1048576

fn timed(label: []const u8, mode: u16, under: [*]u32, source: [*]const u32, backdrop: [*]const u32) -> void {
    var best: usize = 0
    var round: u32 = 0
    while round < 3 {
        var index: usize = 0
        while index < PIXELS {
            under[index] = backdrop[index]
            index += 1
        }
        const started = std.time.monotonicNanoseconds()
        blend.compositeSpan(mode, under, source, PIXELS, 255, null, 0)
        const taken = std.time.monotonicNanoseconds() - started
        if round == 0 || taken < best { best = taken }
        round += 1
    }
    _ = std.io.print(label)
    _ = std.io.print(": ")
    _ = std.io.writeUnsigned(std.io.stdout(), best * 1000 / PIXELS)
    _ = std.io.println(" ps/pixel")
}

fn words(count: usize) -> ?[*]u32 {
    const memory = std.heap.allocator().alloc(count * 4, 16)
    if memory == null { return null }
    return unsafe { @ptrCast([*]u32, memory.?) }
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const small = words(4 * 4200)
    const bytes = allocator.alloc(4200, 16)
    if small == null || bytes == null { return 250 }
    const under = small.?
    const source = small.? + 4200
    const wanted = small.? + 8400
    const mask = bytes.?

    // The tables Dodge, Burn and Soft Light (SVG) are read from: made
    // the first time, in one block of 192 KiB at the most, which stays
    // (checked again at the end: nothing more however often they run).
    const heapBefore = std.heap.liveBytes()
    under[0] = 0xFF808080
    source[0] = 0x80406080
    blend.compositeSpan(blend.DODGE, under, source, 1, 255, null, 0)
    blend.compositeSpan(blend.BURN, under, source, 1, 255, null, 0)
    blend.compositeSpan(blend.SOFT_LIGHT_SVG, under, source, 1, 255, null, 0)
    const heapTables = std.heap.liveBytes()
    if heapTables < heapBefore || heapTables - heapBefore > 196608 { return 63 }

    var failed = names()
    if failed != 0 { return failed }
    failed = menu(mask)
    if failed != 0 { return failed }

    var mode: u16 = 0
    while mode < blend.COUNT {
        failed = untouched(mode, under, source, mask)
        if failed != 0 { return failed }
        failed = overOpaque(mode)
        if failed != 0 { return failed }
        if kindOf(mode) != 2 {
            failed = translucent(mode)
            if failed != 0 { return failed }
        }
        mode += 1
    }
    failed = everyPair(blend.DODGE, under, source)
    if failed == 0 { failed = everyPair(blend.BURN, under, source) }
    if failed == 0 { failed = everyPair(blend.SOFT_LIGHT_SVG, under, source) }
    if failed == 0 { failed = everyPair(blend.HARD_MIX, under, source) }
    if failed != 0 { return failed }
    // The three that act where the source is transparent, at the full
    // amount: Copy leaves the source's pixel, the other two nothing.
    if blend.blendPixel(blend.COPY, 0xFF112233, 0x00445566, 255) != 0x00445566 { return 48 }
    if blend.blendPixel(blend.DESTINATION_IN, 0xFF112233, 0x00445566, 255) != 0 || blend.blendPixel(blend.DESTINATION_ATOP, 0xFF112233, 0x00445566, 255) != 0 { return 48 }

    failed = normal()
    if failed != 0 { return failed }
    failed = rules(under, source, wanted)
    if failed != 0 { return failed }
    failed = alphaLock()
    if failed != 0 { return failed }
    failed = twice()
    if failed != 0 { return failed }
    failed = seeds(under, source, wanted)
    if failed != 0 { return failed }
    mode = 0
    while mode < blend.COUNT {
        failed = rowEdges(mode, under, source, wanted, mask)
        if failed != 0 { return failed }
        mode += 1
    }

    // Rows: 200 of each loop made for a mode, 64 of every other mode (the
    // loops that call the mode's function), all flags, with and without
    // a mask.
    var dedicated: usize = 0
    while dedicated < 13 {
        failed = rows(DEDICATED[dedicated], 200, under, source, wanted, mask)
        if failed != 0 { return failed }
        dedicated += 1
    }
    mode = 0
    while mode < blend.COUNT {
        failed = rows(mode, 64, under, source, wanted, mask)
        if failed != 0 { return failed }
        failed = unseeded(mode, under, source, wanted)
        if failed != 0 { return failed }
        mode += 1
    }

    // Rows of every mode, many times: nothing of the value arena.
    var index: usize = 0
    while index < 256 {
        source[index] = randomPixel()
        mask[index] = @intCast(u8, random() & 255)
        index += 1
    }
    const arena = turns.locate()
    const before = turns.used(arena)
    const heapAfter = std.heap.liveBytes()
    var round: u32 = 0
    while round < 40 {
        mode = 0
        while mode < blend.COUNT {
            index = 0
            while index < 256 {
                under[index] = source[255 - index] ^ (round *% 0x01010101)
                index += 1
            }
            var amounts: ?[*]const u8 = null
            if round % 2 == 0 { amounts = mask }
            blend.compositeSpanAt(mode, under, source, 256, 200, amounts, round % 16, blend.seedAt(@intCast(i32, round), 3))
            _ = blend.blendPixelAt(mode, under[0], source[1], 99, round % 16, 7)
            // What menus and files ask for every frame or every layer.
            var named = blend.name(mode).length + blend.oraName(mode).length + blend.title(mode, round % 2 == 0).length
            named += blend.categoryTitle(blend.category(mode), round % 2 == 1).length
            if blend.byName(blend.oraName(blend.listed(@intCast(usize, mode)))) != mode || named == 0 { return 49 }
            mode += 1
        }
        round += 1
    }
    const grown = turns.used(arena) - before
    _ = std.io.print("value arena grown over 40 rows of every mode: ")
    _ = std.io.writeUnsigned(std.io.stdout(), grown)
    _ = std.io.println(" bytes")
    if grown != 0 { return 49 }
    if std.heap.liveBytes() != heapAfter { return 63 }

    // Timings, for the record: a translucent source over an opaque and
    // over a translucent backdrop, so that every pixel is computed.
    const large = words(3 * PIXELS)
    if large == null { return 251 }
    const canvas = large.?
    const layer = large.? + PIXELS
    const backdrop = large.? + 2 * PIXELS
    index = 0
    while index < PIXELS {
        layer[index] = (random() & 0x00FFFFFF) | ((1 + random() % 254) << 24)
        backdrop[index] = random() | 0xFF000000
        index += 1
    }
    timed("normal over an opaque backdrop", blend.NORMAL, canvas, layer, backdrop)
    timed("multiply over an opaque backdrop", blend.MULTIPLY, canvas, layer, backdrop)
    timed("soft light (svg) over an opaque backdrop", blend.SOFT_LIGHT_SVG, canvas, layer, backdrop)
    timed("exclusion (generic loop, whole numbers) over an opaque backdrop", blend.EXCLUSION, canvas, layer, backdrop)
    timed("gamma light (generic loop, f64 pow) over an opaque backdrop", blend.GAMMA_LIGHT, canvas, layer, backdrop)
    timed("hue (generic loop, whole colour) over an opaque backdrop", blend.HUE, canvas, layer, backdrop)
    index = 0
    while index < PIXELS {
        backdrop[index] = (backdrop[index] & 0x00FFFFFF) | ((1 + random() % 254) << 24)
        index += 1
    }
    timed("normal over a translucent backdrop", blend.NORMAL, canvas, layer, backdrop)
    timed("multiply over a translucent backdrop", blend.MULTIPLY, canvas, layer, backdrop)
    index = 0
    while index < PIXELS {
        layer[index] |= 0xFF000000
        if (index / 4096) % 2 == 0 { layer[index] = 0 }
        index += 1
    }
    timed("normal, stretches of opaque and of transparent source", blend.NORMAL, canvas, layer, backdrop)
    return 13
}
