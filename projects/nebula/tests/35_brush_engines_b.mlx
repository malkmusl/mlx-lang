// nebula's procedural brush engines (brush/sketch_engine.mlx and the
// engines that share its ink: spray, hairy, shape, particle, hatching,
// curve, grid, dyna). Each is in the registry by its key and number, its
// numbers' table is sound and defaults() makes a brush of it. For each:
// a test stroke that loops across the origin and the tiles' borders
// paints something, and every call (begin, each motion, end) changes
// pixels only inside the rectangle it returns, washed, built up through
// a selection, mirrored and wrapped around; the same seed paints the
// same pixels, another seed others where the engine is random; numbers
// far beyond their ranges, a tap and the smallest brush do not trap;
// 3000 dabs take nothing from the value arena and the heap is as it was
// after the stroke. And what each engine is for: sketch joins close
// points by extra lines and by none at density 0; spray's painted pixels
// grow with its count; the bristles' ink runs out along a long stroke;
// shape fills what lies between two passes, washed exactly as built up;
// hatching gives lines at its angle and separation (and the
// perpendicular ones when asked); grid fills its cells once a stroke and
// leaves their borders. Writes engines-b.png, a sample stroke of each
// engine. Exits 13.
const std = @import("std")
const crash = @import("std.crash")
const math = @import("std.math")
const turns = @import("std.turns")
const png = @import("std.png")
const types = @import("../brush/types.mlx")
const engines = @import("../brush/engines.mlx")
const stroke_module = @import("../brush/stroke.mlx")
const point = @import("../brush/point.mlx")
const tip = @import("../brush/tip.mlx")
const sketch_engine = @import("../brush/sketch_engine.mlx")
const spray_engine = @import("../brush/spray_engine.mlx")
const hairy_engine = @import("../brush/hairy_engine.mlx")
const shape_engine = @import("../brush/shape_engine.mlx")
const particle_engine = @import("../brush/particle_engine.mlx")
const hatching_engine = @import("../brush/hatching_engine.mlx")
const curve_engine = @import("../brush/curve_engine.mlx")
const grid_engine = @import("../brush/grid_engine.mlx")
const dyna_engine = @import("../brush/dyna_engine.mlx")
const device = @import("../core/device.mlx")
const geom = @import("../core/geom.mlx")
const mask = @import("../core/mask.mlx")
const node = @import("../core/node.mlx")
const image_module = @import("../core/image.mlx")
const ops = @import("../core/ops.mlx")
const pixel = @import("../core/pixel.mlx")
const scratch = @import("../core/scratch.mlx")

const Device = device.Device
const Stroke = types.Stroke
const Settings = types.Settings
const Target = types.Target
const Rect = geom.Rect

const INK: u32 = 0xFF204080
const PAPER: u32 = 0xFFFFFFFF
const BASE: u32 = 0xFF80C040
const ENGINES: usize = 9

// The part of the image every check looks at: the test strokes and all
// they may paint lie in it (checked).
const LEFT: i32 = -160
const TOP: i32 = -160
const WIDE: usize = 640
const HIGH: usize = 480

fn area() -> Rect { return geom.rect(LEFT, TOP, @intCast(i32, WIDE), @intCast(i32, HIGH)) }

// The test stroke: from point to point, each leg in three motions, the
// pressure rising and falling. It crosses x = 0 and y = 0 and the tiles'
// borders at 64 and 128, comes back near where it was and closes a loop.
const PATH = [16]f64{ -40.0, -30.0, 60.0, 40.0, 150.0, -20.0, 230.0, 80.0, 130.0, 170.0, 20.0, 120.0, 90.0, 60.0, 160.0, 100.0 }
const LEGS: usize = 7

const T = struct {
    allocator: std.allocator.Allocator
    image: *image_module.Image
    layer: *node.Node
    brush: *Settings
    stroke: *Stroke
    // The area's pixels before and after a call (or of two devices).
    before: [*]u32
    after: [*]u32
    // A selection: all of x < 100, nothing right of it.
    selection: *Device
}

// ---------------------------------------------------------------------------
// The engines, by their place in this test

fn keyOf(which: usize) -> []const u8 {
    if which == 0 { return "sketch" }
    if which == 1 { return "spray" }
    if which == 2 { return "hairy" }
    if which == 3 { return "shape" }
    if which == 4 { return "particle" }
    if which == 5 { return "hatching" }
    if which == 6 { return "curve" }
    if which == 7 { return "grid" }
    return "dyna"
}

fn idOf(which: usize) -> u16 {
    if which == 0 { return types.ENGINE_SKETCH }
    if which == 1 { return types.ENGINE_SPRAY }
    if which == 2 { return types.ENGINE_HAIRY }
    if which == 3 { return types.ENGINE_SHAPE }
    if which == 4 { return particle_engine.ENGINE_PARTICLE }
    if which == 5 { return hatching_engine.ENGINE_HATCHING }
    if which == 6 { return curve_engine.ENGINE_CURVE }
    if which == 7 { return grid_engine.ENGINE_GRID }
    return dyna_engine.ENGINE_DYNA
}

fn listOf(which: usize) -> []const types.Engine {
    if which == 0 { return sketch_engine.list() }
    if which == 1 { return spray_engine.list() }
    if which == 2 { return hairy_engine.list() }
    if which == 3 { return shape_engine.list() }
    if which == 4 { return particle_engine.list() }
    if which == 5 { return hatching_engine.list() }
    if which == 6 { return curve_engine.list() }
    if which == 7 { return grid_engine.list() }
    return dyna_engine.list()
}

fn valuesOf(which: usize) -> []const sketch_engine.Value {
    if which == 0 { return sketch_engine.values() }
    if which == 1 { return spray_engine.values() }
    if which == 2 { return hairy_engine.values() }
    if which == 3 { return shape_engine.values() }
    if which == 4 { return particle_engine.values() }
    if which == 5 { return hatching_engine.values() }
    if which == 6 { return curve_engine.values() }
    if which == 7 { return grid_engine.values() }
    return dyna_engine.values()
}

// The engine's own brush.
fn setUp(settings: *Settings, which: usize) -> void {
    if which == 0 { sketch_engine.defaults(settings) }
    if which == 1 { spray_engine.defaults(settings) }
    if which == 2 { hairy_engine.defaults(settings) }
    if which == 3 { shape_engine.defaults(settings) }
    if which == 4 { particle_engine.defaults(settings) }
    if which == 5 { hatching_engine.defaults(settings) }
    if which == 6 { curve_engine.defaults(settings) }
    if which == 7 { grid_engine.defaults(settings) }
    if which == 8 { dyna_engine.defaults(settings) }
}

// Whether the engine draws random numbers (another seed: other pixels).
fn isRandom(which: usize) -> bool {
    return which == 0 || which == 1 || which == 2 || which == 4 || which == 7
}

// ---------------------------------------------------------------------------
// Helpers

fn targetOn(t: *T, onto: *Device, direct: bool) -> Target {
    return Target.{ .image = t.*.image, .node = t.*.layer, .device = onto, .direct = direct, .foreground = INK, .background = PAPER, .selection = null, .alphaLock = false, .mirrorHorizontal = false, .axisX = 0.0, .mirrorVertical = false, .axisY = 0.0, .wrap = false, .seed = 1, .sample = null }
}

fn penAt(pen: *point.Point, x: f64, y: f64, pressure: f64, time: f64) -> void {
    pen.* = point.at(x, y, pressure, time)
}

// The pen at motion `step` of the test stroke (0: its start), moved by
// (dx, dy).
fn pathPoint(pen: *point.Point, step: usize, dx: f64, dy: f64) -> void {
    const leg = step / 3
    const part = @floatFromInt(f64, step % 3) / 3.0
    var x = PATH[leg * 2]
    var y = PATH[leg * 2 + 1]
    if leg < LEGS {
        x += (PATH[leg * 2 + 2] - x) * part
        y += (PATH[leg * 2 + 3] - y) * part
    }
    const pressure = 0.6 + 0.4 * math.sin(@floatFromInt(f64, step) * 0.7)
    penAt(pen, x + dx, y + dy, pressure, @floatFromInt(f64, step) * 30.0)
}

// The test stroke on `target`, moved by (dx, dy).
fn drawStroke(t: *T, target: *const Target, dx: f64, dy: f64) -> void {
    var pen: point.Point = undefined
    pathPoint(&pen, 0, dx, dy)
    _ = stroke_module.begin(t.*.stroke, target, t.*.brush, &pen)
    var step: usize = 1
    while step <= LEGS * 3 {
        pathPoint(&pen, step, dx, dy)
        _ = stroke_module.to(t.*.stroke, &pen)
        step += 1
    }
    _ = stroke_module.end(t.*.stroke)
}

// The area's pixels of `plane` into `into`.
fn grab(plane: *Device, into: [*]u32) -> void {
    device.readRect(plane, area(), into, WIDE)
}

// Whether every pixel that differs between t.before and what `plane`
// shows now lies in `reported`; t.before then holds what it shows.
fn changedWithin(t: *T, plane: *Device, reported: Rect) -> bool {
    grab(plane, t.*.after)
    var fine = true
    var row: usize = 0
    while row < HIGH {
        var column: usize = 0
        while column < WIDE {
            const at = row * WIDE + column
            if t.*.before[at] != t.*.after[at] {
                if !geom.contains(reported, LEFT + @intCast(i32, column), TOP + @intCast(i32, row)) { fine = false }
                t.*.before[at] = t.*.after[at]
            }
            column += 1
        }
        row += 1
    }
    return fine
}

// The test stroke on `target`, each call's changes checked against the
// rectangle it returned. False when one lies outside.
fn checkedStroke(t: *T, target: *const Target) -> bool {
    const plane = target.*.device
    grab(plane, t.*.before)
    var pen: point.Point = undefined
    pathPoint(&pen, 0, 0.0, 0.0)
    var fine = changedWithin(t, plane, stroke_module.begin(t.*.stroke, target, t.*.brush, &pen))
    var step: usize = 1
    while step <= LEGS * 3 {
        pathPoint(&pen, step, 0.0, 0.0)
        if !changedWithin(t, plane, stroke_module.to(t.*.stroke, &pen)) { fine = false }
        step += 1
    }
    if !changedWithin(t, plane, stroke_module.end(t.*.stroke)) { fine = false }
    return fine
}

// How many pixels of `inside` are not transparent.
fn painted(plane: *Device, inside: Rect) -> usize {
    var total: usize = 0
    var y = inside.y
    while y < inside.y + inside.height {
        var x = inside.x
        while x < inside.x + inside.width {
            if device.pixel(plane, x, y) >> 24 != 0 { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

// How many pixels of `inside` are not `value`.
fn notOf(plane: *Device, inside: Rect, value: u32) -> usize {
    var total: usize = 0
    var y = inside.y
    while y < inside.y + inside.height {
        var x = inside.x
        while x < inside.x + inside.width {
            if device.pixel(plane, x, y) != value { total += 1 }
            x += 1
        }
        y += 1
    }
    return total
}

// The sum of the alphas of `inside`.
fn alphaSum(plane: *Device, inside: Rect) -> usize {
    var total: usize = 0
    var y = inside.y
    while y < inside.y + inside.height {
        var x = inside.x
        while x < inside.x + inside.width {
            total += @intCast(usize, device.pixel(plane, x, y) >> 24)
            x += 1
        }
        y += 1
    }
    return total
}

fn alphaAt(plane: *Device, x: i32, y: i32) -> u32 { return device.pixel(plane, x, y) >> 24 }

// Whether the two devices show the same pixels in the area.
fn same(t: *T, a: *Device, b: *Device) -> bool {
    grab(a, t.*.before)
    grab(b, t.*.after)
    var index: usize = 0
    while index < WIDE * HIGH {
        if t.*.before[index] != t.*.after[index] { return false }
        index += 1
    }
    return true
}

// Whether everything `plane` holds lies in `inside`.
fn holdsOnlyIn(plane: *Device, inside: Rect) -> bool {
    const bounds = device.exactBounds(plane)
    if geom.isEmpty(bounds) { return true }
    return bounds.x >= inside.x && bounds.y >= inside.y && bounds.x + bounds.width <= inside.x + inside.width && bounds.y + bounds.height <= inside.y + inside.height
}

fn show(what: []const u8, value: usize) -> void {
    _ = std.io.print(what)
    _ = std.io.writeUnsigned(std.io.stdout(), value)
    _ = std.io.println("")
}

// ---------------------------------------------------------------------------
// Each engine

// In the registry under its key and number, its table and defaults sound.
fn registered(t: *T, which: usize) -> u8 {
    const key = keyOf(which)
    const id = idOf(which)
    const by_key = engines.byKey(key)
    if by_key == null || by_key.?.*.id != id { return 1 }
    const by_id = engines.find(id)
    if by_id == null || !std.text.same(by_id.?.*.key, key) { return 2 }
    if engines.name(id, false).length == 0 || engines.name(id, true).length == 0 { return 3 }
    if listOf(which).length != 1 || listOf(which)[0].id != id { return 4 }
    const list = valuesOf(which)
    if list.length == 0 || list.length > types.VALUES { return 5 }
    var index: usize = 0
    while index < list.length {
        const value = &list[index]
        if !(value.*.low <= value.*.initial) || !(value.*.initial <= value.*.high) { return 6 }
        if value.*.key.length == 0 || value.*.name.length == 0 || value.*.german.length == 0 { return 6 }
        index += 1
    }
    setUp(t.*.brush, which)
    if t.*.brush.*.engine != id { return 7 }
    index = 0
    while index < list.length {
        if t.*.brush.*.values[index] != @floatCast(f32, list[index].initial) { return 8 }
        index += 1
    }
    return 0
}

// The test stroke on a fresh device: something painted, inside the
// area, every call inside its rectangle; washed and built up, through a
// selection, mirrored, wrapped.
fn strokes(t: *T, which: usize) -> u8 {
    setUp(t.*.brush, which)
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    var target = targetOn(t, plane, false)
    if !checkedStroke(t, &target) { return 11 }
    if painted(plane, area()) == 0 || !holdsOnlyIn(plane, area()) { return 12 }
    // Built up, on a layer that has paint already, through the selection
    // (all left of x = 100, nothing right of it).
    device.clear(plane)
    _ = device.fill(plane, geom.rect(-20, -20, 300, 220), BASE)
    target = targetOn(t, plane, true)
    target.selection = t.*.selection
    if !checkedStroke(t, &target) { return 13 }
    var y: i32 = TOP
    while y < TOP + @intCast(i32, HIGH) {
        var x: i32 = 100
        while x < LEFT + @intCast(i32, WIDE) {
            const expected: u32 = if x < 280 && y >= -20 && y < 200 { BASE } else { 0 }
            if device.pixel(plane, x, y) != expected { return 14 }
            x += 3
        }
        y += 3
    }
    if notOf(plane, geom.rect(-20, -20, 120, 220), BASE) == 0 { return 15 }
    // Mirrored both ways and wrapped around the image (600 x 400).
    device.clear(plane)
    target = targetOn(t, plane, false)
    target.mirrorHorizontal = true
    target.axisX = 100.0
    target.mirrorVertical = true
    target.axisY = 50.0
    target.wrap = true
    if !checkedStroke(t, &target) { return 16 }
    if painted(plane, area()) == 0 || !holdsOnlyIn(plane, geom.rect(0, 0, 600, 400)) { return 17 }
    return 0
}

// The same seed, the same pixels; another, others (where random).
fn seeds(t: *T, which: usize) -> u8 {
    setUp(t.*.brush, which)
    // (The grid is random only in its random shapes.)
    if which == 7 { t.*.brush.*.values[2] = 2.0 }
    const a = device.create(t.*.allocator, 0).?
    const b = device.create(t.*.allocator, 0).?
    defer device.destroy(a)
    defer device.destroy(b)
    var target = targetOn(t, a, false)
    drawStroke(t, &target, 0.0, 0.0)
    target.device = b
    drawStroke(t, &target, 0.0, 0.0)
    if !same(t, a, b) { return 21 }
    device.clear(b)
    target.seed = 99
    drawStroke(t, &target, 0.0, 0.0)
    if same(t, a, b) == isRandom(which) { return 22 }
    return 0
}

// Numbers far beyond their ranges either way (and 0, and one half), a
// tap, the smallest brush and a large one wrapped at the image's corner:
// no trap, and the wrapped paint stays inside the image.
fn extremes(t: *T, which: usize) -> u8 {
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    var target = targetOn(t, plane, false)
    var round: usize = 0
    while round < 4 {
        setUp(t.*.brush, which)
        t.*.brush.*.size = 12.0
        var index: usize = 0
        while index < types.VALUES {
            t.*.brush.*.values[index] = if round == 0 { 1.0e30 } else if round == 1 { -1.0e30 } else if round == 2 { 0.0 } else { 0.5 }
            index += 1
        }
        var pen: point.Point = undefined
        penAt(&pen, 30.5, 20.5, 1.0, 0.0)
        _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
        penAt(&pen, 33.0, 21.5, 0.0, 10.0)
        _ = stroke_module.to(t.*.stroke, &pen)
        _ = stroke_module.end(t.*.stroke)
        round += 1
    }
    // A tap.
    setUp(t.*.brush, which)
    var pen: point.Point = undefined
    penAt(&pen, 5.5, 5.5, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    _ = stroke_module.end(t.*.stroke)
    // The smallest brush, and a large one wrapped at the image's corner.
    t.*.brush.*.size = types.SMALLEST_SIZE
    drawStroke(t, &target, 0.0, 0.0)
    device.clear(plane)
    t.*.brush.*.size = 400.0
    target.wrap = true
    penAt(&pen, 590.0, 390.0, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    penAt(&pen, 610.0, 420.0, 1.0, 10.0)
    _ = stroke_module.to(t.*.stroke, &pen)
    _ = stroke_module.end(t.*.stroke)
    if !holdsOnlyIn(plane, geom.rect(0, 0, 600, 400)) { return 31 }
    return 0
}

// 3000 dabs (mirrored: two copies of each) take nothing from the value
// arena, and after the stroke the heap is as it was.
fn lasting(t: *T, which: usize) -> u8 {
    setUp(t.*.brush, which)
    // Once before the count: what is made at the first use (the kept
    // tables, the stroke's mask, working memory) is there then.
    const warm = device.create(t.*.allocator, 0).?
    var target = targetOn(t, warm, false)
    target.mirrorHorizontal = true
    target.axisX = 300.0
    drawStroke(t, &target, 0.0, 0.0)
    device.destroy(warm)
    // (The working memory core/scratch.mlx keeps for the next taking
    // grows with what a stroke asks of it: given back here and after.)
    scratch.trim(scratch.common())
    const live = std.heap.liveBytes()
    const plane = device.create(t.*.allocator, 0).?
    target.device = plane
    var pen: point.Point = undefined
    penAt(&pen, 100.0, 100.0, 0.5, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    const arena = turns.locate()
    const before = turns.used(arena)
    var step: usize = 1
    while t.*.stroke.*.dabs < 3000 && step < 100000 {
        legPoint(&pen, step)
        _ = stroke_module.to(t.*.stroke, &pen)
        step += 1
    }
    const grown = turns.used(arena) - before
    const dabs = t.*.stroke.*.dabs
    _ = stroke_module.end(t.*.stroke)
    if dabs < 3000 { return 41 }
    if grown > 1024 {
        show("arena grew by ", grown)
        return 42
    }
    if device.isBlank(plane) { return 43 }
    device.destroy(plane)
    scratch.trim(scratch.common())
    if std.heap.liveBytes() != live { return 44 }
    return 0
}

// The pen's place on step `step` of the long stroke (in a function of
// its own: a Point made in a full frame would be a value of the arena).
fn legPoint(pen: *point.Point, step: usize) -> void {
    const turn = @floatFromInt(f64, step) * 0.37
    pen.* = point.at(200.0 + 150.0 * math.cos(turn) + 30.0 * math.sin(turn * 5.1), 150.0 + 110.0 * math.sin(turn * 1.3), 0.3 + 0.6 * math.abs(math.sin(turn * 3.0)), @floatFromInt(f64, step) * 15.0)
}

// ---------------------------------------------------------------------------
// What each engine is for

// A zigzag whose legs come close at their turns (30 apart at the top
// and bottom, 100 high).
fn zigzag(t: *T, target: *const Target) -> void {
    var pen: point.Point = undefined
    penAt(&pen, 50.0, 50.0, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, target, t.*.brush, &pen)
    var leg: usize = 1
    while leg <= 8 {
        penAt(&pen, 50.0 + 30.0 * @floatFromInt(f64, leg), if leg % 2 == 1 { 150.0 } else { 50.0 }, 1.0, 100.0 * @floatFromInt(f64, leg))
        _ = stroke_module.to(t.*.stroke, &pen)
        leg += 1
    }
    _ = stroke_module.end(t.*.stroke)
}

// Sketch: between the first two legs, 8 pixels from each, the web shows
// at density 1 and nothing at density 0 (only the line along the path);
// without the connection line too, only the first dab's dot is left.
fn sketchJoins(t: *T) -> u8 {
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    const target = targetOn(t, plane, false)
    const between = geom.rect(77, 112, 7, 16)
    sketch_engine.defaults(t.*.brush)
    t.*.brush.*.values[1] = 1.0
    zigzag(t, &target)
    const dense = painted(plane, area())
    if painted(plane, between) == 0 { return 51 }
    device.clear(plane)
    t.*.brush.*.values[1] = 0.0
    zigzag(t, &target)
    const bare = painted(plane, area())
    if painted(plane, between) != 0 || bare == 0 || dense < bare * 2 { return 52 }
    device.clear(plane)
    t.*.brush.*.values[4] = 0.0
    zigzag(t, &target)
    const dot = painted(plane, area())
    if dot == 0 || dot > 4 { return 53 }
    return 0
}

// One dab of the spray (a tap) of 240 pixels with `count` particles of
// 2: the pixels painted.
fn sprayed(t: *T, plane: *Device, count: f32) -> usize {
    device.clear(plane)
    const target = targetOn(t, plane, false)
    spray_engine.defaults(t.*.brush)
    t.*.brush.*.size = 240.0
    t.*.brush.*.values[0] = count
    t.*.brush.*.values[4] = 2.0
    var pen: point.Point = undefined
    penAt(&pen, 200.0, 150.0, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    _ = stroke_module.end(t.*.stroke)
    return painted(plane, area())
}

// Spray: four times the count paints three to five times the pixels
// (where particles overlap, fewer), a count of 0 nothing; spread
// uniformly, as many land in the outer half of the area as in the inner.
fn sprayDensity(t: *T) -> u8 {
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    const few = sprayed(t, plane, 25.0)
    const many = sprayed(t, plane, 100.0)
    if few == 0 || many < few * 3 || many > few * 5 { return 61 }
    if sprayed(t, plane, 0.0) != 0 { return 62 }
    const all = sprayed(t, plane, 400.0)
    // (The disc of half the area has the radius 120 / sqrt 2: 85.)
    var inner: usize = 0
    var y: i32 = 30
    while y < 270 {
        var x: i32 = 80
        while x < 320 {
            const dx = @floatFromInt(f64, x) + 0.5 - 200.0
            const dy = @floatFromInt(f64, y) + 0.5 - 150.0
            if dx * dx + dy * dy < 7200.0 && alphaAt(plane, x, y) != 0 { inner += 1 }
            x += 1
        }
        y += 1
    }
    if inner * 10 < all * 4 || inner * 10 > all * 6 { return 63 }
    return 0
}

// Hairy: along a straight 900 pixel stroke with ink for 600, the paint
// fades: more alpha near the start than in the middle, more there than
// late, and none past where the ink ends. With the depletion curve held
// at full (text "0,1;1,1") nothing runs out.
fn hairyDepletes(t: *T) -> u8 {
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    const target = targetOn(t, plane, false)
    hairy_engine.defaults(t.*.brush)
    t.*.brush.*.values[3] = 600.0
    var pen: point.Point = undefined
    penAt(&pen, -300.0, 100.0, 0.5, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    var step: usize = 1
    while step <= 30 {
        penAt(&pen, -300.0 + 30.0 * @floatFromInt(f64, step), 100.0, 0.5, @floatFromInt(f64, step) * 20.0)
        _ = stroke_module.to(t.*.stroke, &pen)
        step += 1
    }
    _ = stroke_module.end(t.*.stroke)
    const start = alphaSum(plane, geom.rect(-280, 70, 60, 60))
    const middle = alphaSum(plane, geom.rect(-20, 70, 60, 60))
    const late = alphaSum(plane, geom.rect(180, 70, 60, 60))
    const gone = alphaSum(plane, geom.rect(320, 60, 280, 80))
    if !(start > middle && middle > late && late > 0) || gone != 0 { return 71 }
    device.clear(plane)
    types.setText(t.*.brush, "0,1;1,1")
    penAt(&pen, -300.0, 100.0, 0.5, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    penAt(&pen, 600.0, 100.0, 0.5, 600.0)
    _ = stroke_module.to(t.*.stroke, &pen)
    _ = stroke_module.end(t.*.stroke)
    if alphaSum(plane, geom.rect(320, 60, 280, 80)) == 0 { return 72 }
    return 0
}

fn drawU(t: *T, target: *const Target) -> void {
    var pen: point.Point = undefined
    penAt(&pen, 100.0, 100.0, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, target, t.*.brush, &pen)
    penAt(&pen, 300.0, 100.0, 1.0, 100.0)
    _ = stroke_module.to(t.*.stroke, &pen)
    penAt(&pen, 300.0, 160.0, 1.0, 200.0)
    _ = stroke_module.to(t.*.stroke, &pen)
    penAt(&pen, 100.0, 160.0, 1.0, 300.0)
    _ = stroke_module.to(t.*.stroke, &pen)
    _ = stroke_module.end(t.*.stroke)
}

// Shape: a U (right, down, back left) fills what lies between its two
// passes; washed it ends exactly as built up (the preview leaves nothing
// behind); without the fill only the band is there.
fn shapeFills(t: *T) -> u8 {
    const washed = device.create(t.*.allocator, 0).?
    const built = device.create(t.*.allocator, 0).?
    defer device.destroy(washed)
    defer device.destroy(built)
    shape_engine.defaults(t.*.brush)
    var round: usize = 0
    while round < 2 {
        const plane = if round == 0 { washed } else { built }
        const target = targetOn(t, plane, round == 1)
        drawU(t, &target)
        // Between the passes (y 100 and 160), and on them.
        if alphaAt(plane, 200, 130) != 255 || alphaAt(plane, 150, 100) != 255 || alphaAt(plane, 150, 160) != 255 { return 81 }
        if device.pixel(plane, 200, 130) != INK { return 82 }
        // Outside: above, below, beyond the band.
        if alphaAt(plane, 200, 80) != 0 || alphaAt(plane, 200, 180) != 0 || alphaAt(plane, 330, 130) != 0 { return 83 }
        round += 1
    }
    if !same(t, washed, built) { return 84 }
    device.clear(washed)
    t.*.brush.*.values[2] = 0.0
    const target = targetOn(t, washed, false)
    drawU(t, &target)
    if alphaAt(washed, 200, 130) != 0 || alphaAt(washed, 150, 100) != 255 { return 85 }
    return 0
}

// One dab (a tap) of a hard hatching brush of 100 pixels at (200.5,
// 150.5): lines 2 thick, 8 apart.
fn hatch(t: *T, plane: *Device, angle: f32, crossing: f32) -> void {
    device.clear(plane)
    const target = targetOn(t, plane, false)
    hatching_engine.defaults(t.*.brush)
    t.*.brush.*.size = 100.0
    t.*.brush.*.values[0] = angle
    t.*.brush.*.values[1] = 8.0
    t.*.brush.*.values[2] = 2.0
    t.*.brush.*.values[3] = crossing
    t.*.brush.*.values[4] = 0.0
    var pen: point.Point = undefined
    penAt(&pen, 200.5, 150.5, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    _ = stroke_module.end(t.*.stroke)
}

// Hatching: at 0 degrees rows 8k - 1 and 8k are covered and no other;
// the perpendicular set adds the columns 8k - 1 and 8k; at 30 degrees,
// measured across the lines from the origin, pixels on a line are
// covered and those 2 pixels or more from every line are not.
fn hatchingLines(t: *T) -> u8 {
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    hatch(t, plane, 0.0, 0.0)
    var y: i32 = 110
    while y < 190 {
        const on_line = (y & 7) == 7 || (y & 7) == 0
        const alpha = alphaAt(plane, 200, y)
        if on_line && alpha != 255 { return 91 }
        if !on_line && alpha != 0 { return 92 }
        y += 1
    }
    if alphaAt(plane, 199, 132) != 0 { return 93 }
    hatch(t, plane, 0.0, 1.0)
    if alphaAt(plane, 199, 132) != 255 || alphaAt(plane, 200, 132) != 255 || alphaAt(plane, 196, 132) != 0 { return 94 }
    hatch(t, plane, 30.0, 0.0)
    const nx = 0.0 - math.sin(math.pi / 6.0)
    const ny = math.cos(math.pi / 6.0)
    var on: usize = 0
    var off: usize = 0
    y = 120
    while y < 180 {
        var x: i32 = 170
        while x < 230 {
            const across = (@floatFromInt(f64, x) + 0.5) * nx + (@floatFromInt(f64, y) + 0.5) * ny
            const distance = math.abs(across - math.round(across / 8.0) * 8.0)
            const alpha = alphaAt(plane, x, y)
            if distance < 0.4 {
                if alpha < 200 { return 95 }
                on += 1
            }
            if distance > 2.0 {
                if alpha != 0 { return 96 }
                off += 1
            }
            x += 1
        }
        y += 1
    }
    if on < 200 || off < 1000 { return 97 }
    return 0
}

// Grid: 10 x 10 cells with borders of 2: under a hard dab of 80 pixels
// every cell whose centre it covers is filled in its middle 6 x 6 and
// not on its borders; cells far from it are empty. Built up at half the
// opacity along a stroke whose dabs overlap, a cell is filled once: its
// alpha is the half's, nowhere more.
fn gridCells(t: *T) -> u8 {
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    var target = targetOn(t, plane, false)
    grid_engine.defaults(t.*.brush)
    t.*.brush.*.size = 80.0
    t.*.brush.*.values[0] = 10.0
    t.*.brush.*.values[1] = 10.0
    t.*.brush.*.values[4] = 2.0
    t.*.brush.*.values[5] = 2.0
    var pen: point.Point = undefined
    penAt(&pen, 200.0, 150.0, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    _ = stroke_module.end(t.*.stroke)
    var row: i32 = 12
    while row < 18 {
        var column: i32 = 17
        while column < 23 {
            const x = column * 10
            const y = row * 10
            if alphaAt(plane, x + 2, y + 2) != 255 || alphaAt(plane, x + 7, y + 7) != 255 || alphaAt(plane, x + 5, y + 4) != 255 { return 101 }
            if alphaAt(plane, x, y + 5) != 0 || alphaAt(plane, x + 1, y + 5) != 0 || alphaAt(plane, x + 8, y + 5) != 0 || alphaAt(plane, x + 5, y + 9) != 0 { return 102 }
            column += 1
        }
        row += 1
    }
    if painted(plane, geom.rect(0, 0, 140, 300)) != 0 || painted(plane, geom.rect(260, 0, 200, 300)) != 0 { return 103 }
    device.clear(plane)
    target = targetOn(t, plane, true)
    t.*.brush.*.opacity = 0.5
    penAt(&pen, 200.0, 150.0, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    penAt(&pen, 260.0, 170.0, 1.0, 100.0)
    _ = stroke_module.to(t.*.stroke, &pen)
    _ = stroke_module.end(t.*.stroke)
    if t.*.stroke.*.dabs < 4 { return 104 }
    var cells: usize = 0
    var y: i32 = 100
    while y < 230 {
        var x: i32 = 150
        while x < 320 {
            const alpha = alphaAt(plane, x, y)
            if alpha != 0 && alpha != 128 { return 105 }
            if alpha == 128 { cells += 1 }
            x += 1
        }
        y += 1
    }
    if cells < 36 * 60 { return 106 }
    return 0
}

// A straight dyna stroke of 300 pixels in `lapse` milliseconds: the
// pixels painted.
fn dynaStroke(t: *T, plane: *Device, lapse: f64) -> usize {
    device.clear(plane)
    const target = targetOn(t, plane, false)
    dyna_engine.defaults(t.*.brush)
    t.*.brush.*.size = 30.0
    var pen: point.Point = undefined
    penAt(&pen, 50.0, 100.0, 1.0, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    var step: usize = 1
    while step <= 30 {
        penAt(&pen, 50.0 + 10.0 * @floatFromInt(f64, step), 100.0, 1.0, lapse * @floatFromInt(f64, step) / 30.0)
        _ = stroke_module.to(t.*.stroke, &pen)
        step += 1
    }
    _ = stroke_module.end(t.*.stroke)
    return painted(plane, area())
}

// Dyna: drawn slowly (300 pixels in 6 seconds) the ribbon is far wider
// than drawn fast (in 60 milliseconds), and at most as wide as the dab.
fn dynaThins(t: *T) -> u8 {
    const plane = device.create(t.*.allocator, 0).?
    defer device.destroy(plane)
    const slow = dynaStroke(t, plane, 6000.0)
    if painted(plane, geom.rect(0, 0, 400, 84)) != 0 || painted(plane, geom.rect(0, 117, 400, 100)) != 0 { return 111 }
    const fast = dynaStroke(t, plane, 60.0)
    if slow == 0 || fast == 0 || slow < fast * 2 { return 112 }
    return 0
}

// ---------------------------------------------------------------------------
// The picture

fn colourOf(which: usize) -> u32 {
    if which == 0 { return 0xFF303030 }
    if which == 1 { return 0xFFC03060 }
    if which == 2 { return 0xFF805020 }
    if which == 3 { return 0xFF3070C0 }
    if which == 4 { return 0xFF208060 }
    if which == 5 { return 0xFF404080 }
    if which == 6 { return 0xFF8030A0 }
    if which == 7 { return 0xFFD08020 }
    return 0xFF101010
}

// The sample stroke of engine `which` into its cell of the sheet: a wave
// across the cell, the pressure rising and falling.
fn sample(t: *T, plane: *Device, which: usize) -> void {
    const left = @floatFromInt(f64, (which % 3) * 300)
    const top = @floatFromInt(f64, (which / 3) * 200)
    setUp(t.*.brush, which)
    var target = targetOn(t, plane, false)
    target.foreground = colourOf(which)
    var pen: point.Point = undefined
    penAt(&pen, left + 40.0, top + 100.0, 0.4, 0.0)
    _ = stroke_module.begin(t.*.stroke, &target, t.*.brush, &pen)
    var step: usize = 1
    while step <= 60 {
        const along = @floatFromInt(f64, step) / 60.0
        const x = left + 40.0 + 220.0 * along
        const y = top + 100.0 - 55.0 * math.sin(along * math.tau) + 15.0 * math.sin(along * 19.0)
        penAt(&pen, x, y, 0.4 + 0.6 * math.sin(along * math.pi), @floatFromInt(f64, step) * 25.0)
        _ = stroke_module.to(t.*.stroke, &pen)
        step += 1
    }
    _ = stroke_module.end(t.*.stroke)
}

// A sample stroke of each engine in a cell of a 3 x 3 sheet over white,
// written to engines-b.png (and into the directory NEBULA_SHOTS names,
// when it is set).
fn picture(t: *T, shots: []const u8) -> bool {
    const width: usize = 900
    const height: usize = 600
    const sheet = t.*.allocator.alloc(width * height * 4, 16)
    if sheet == null { return false }
    const pixels: [*]u32 = unsafe { @ptrCast([*]u32, sheet.?) }
    const plane = device.create(t.*.allocator, 0).?
    var which: usize = 0
    while which < ENGINES {
        sample(t, plane, which)
        which += 1
    }
    var y: usize = 0
    while y < height {
        var x: usize = 0
        while x < width {
            pixels[y * width + x] = pixel.over(PAPER, device.pixel(plane, @intCast(i32, x), @intCast(i32, y)), 255)
            x += 1
        }
        y += 1
    }
    device.destroy(plane)
    var saved = png.saveFile("engines-b.png\x00".pointer, pixels, width, height, width, false, t.*.allocator)
    if shots.length > 0 && shots.length < 400 {
        var path: [512]u8 = undefined
        const bytes: [*]u8 = &path
        var length = std.text.append(bytes, 0, 500, shots)
        if bytes[length - 1] != 47 { length = std.text.appendByte(bytes, length, 500, 47) }
        length = std.text.append(bytes, length, 500, "engines-b.png")
        bytes[length] = 0
        saved = png.saveFile(bytes, pixels, width, height, width, false, t.*.allocator) && saved
    }
    t.*.allocator.free(sheet.?, width * height * 4, 16)
    return saved
}

// ---------------------------------------------------------------------------

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(T), 16)
    const brush = allocator.alloc(@sizeOf(Settings), 16)
    const before = allocator.alloc(WIDE * HIGH * 4, 16)
    const after = allocator.alloc(WIDE * HIGH * 4, 16)
    if memory == null || brush == null || before == null || after == null { return 1 }
    const t: *T = unsafe { @ptrCast(*T, memory.?) }
    t.*.allocator = allocator
    t.*.image = image_module.create(allocator, 600, 400, 72.0).?
    t.*.layer = ops.newLayer(t.*.image, node.PAINT, "Layer", "New layer").?
    unsafe { t.*.brush = @ptrCast(*Settings, brush.?) }
    unsafe { t.*.before = @ptrCast([*]u32, before.?) }
    unsafe { t.*.after = @ptrCast([*]u32, after.?) }
    t.*.stroke = stroke_module.create(allocator).?
    t.*.selection = mask.create(allocator, false).?
    _ = device.fill(t.*.selection, geom.rect(-1000, -1000, 1100, 3000), mask.ALL)

    // Every engine through the general checks (the engine that fails is
    // named).
    var which: usize = 0
    while which < ENGINES {
        var failed = registered(t, which)
        if failed == 0 { failed = strokes(t, which) }
        if failed == 0 { failed = seeds(t, which) }
        if failed == 0 { failed = extremes(t, which) }
        if failed == 0 { failed = lasting(t, which) }
        if failed != 0 {
            _ = std.io.print("engine ")
            _ = std.io.println(keyOf(which))
            return failed
        }
        which += 1
    }
    var failed = sketchJoins(t)
    if failed == 0 { failed = sprayDensity(t) }
    if failed == 0 { failed = hairyDepletes(t) }
    if failed == 0 { failed = shapeFills(t) }
    if failed == 0 { failed = hatchingLines(t) }
    if failed == 0 { failed = gridCells(t) }
    if failed == 0 { failed = dynaThins(t) }
    if failed != 0 { return failed }

    var shots: []const u8 = ""
    const named = std.process.environmentFrom(std.process.environmentEntries(arguments), "NEBULA_SHOTS")
    if named != null { shots = std.string.asSlice(named.?) }
    if !picture(t, shots) { return 120 }

    device.destroy(t.*.selection)
    stroke_module.destroy(t.*.stroke)
    image_module.destroy(t.*.image)
    tip.dropPredefined()
    allocator.free(after.?, WIDE * HIGH * 4, 16)
    allocator.free(before.?, WIDE * HIGH * 4, 16)
    allocator.free(brush.?, @sizeOf(Settings), 16)
    allocator.free(memory.?, @sizeOf(T), 16)
    return 13
}
