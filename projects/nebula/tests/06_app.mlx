// nebula as a whole, without a window (app/script.mlx): a new image, a
// stroke of the brush that becomes one step of the history, undo and
// redo by their keys, the eraser, the colours swapped, the view zoomed
// by the wheel and moved by the hand, a tool chosen by its key, what the
// status bar says, a frame saved as a picture; and scripts that fail say
// so. Exits 13.
const std = @import("std")
const chrome = @import("../ui/chrome.mlx")
const state = @import("../app/state.mlx")
const api = @import("../app/api.mlx")
const script = @import("../app/script.mlx")
const documents = @import("../app/documents.mlx")
const history = @import("../core/history.mlx")
const device = @import("../core/device.mlx")
const render = @import("../core/render.mlx")

fn shown(app: *state.App, x: i32, y: i32) -> u32 {
    const image = api.image(app).?
    _ = render.update(image)
    return device.pixel(image.*.projection, x, y)
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const made = script.headless(allocator)
    if made == null { return 1 }
    const app = made.?
    if api.document(app) != null || api.image(app) != null || api.activeNode(app) != null { return 2 }

    // A white image of 400 x 300 in a window of 800 x 600: shown at its
    // own size, its middle in the middle of the canvas area.
    if !script.run(app, "size 800 600\nnew 400 300 FFFFFF\n") { return 3 }
    const doc = api.document(app).?
    if doc.*.image.*.width != 400 || doc.*.view.zoom != 1.0 || app.*.count != 1 { return 4 }
    if documents.isModified(doc) || history.canUndo(doc.*.image.*.history) { return 5 }
    if shown(app, 10, 10) != 0xFFFFFFFF { return 6 }
    // The canvas area: inside the window, beside the toolbox and the
    // dockers, at least half the width chrome.mlx keeps for it.
    const area = app.*.canvasArea
    if area.width < chrome.LEAST_CANVAS / 2 || area.height < 400 || area.x < 0 || area.y < 0 || area.x + area.width > 800 || area.y + area.height > 600 { return 7 }
    const middle_x = area.x + area.width / 2
    const middle_y = area.y + area.height / 2

    // A stroke across the middle: paint where the pointer went, none
    // elsewhere, one step to undo.
    var text: [200]u8 = undefined
    const bytes: [*]u8 = &text
    var length = std.text.append(bytes, 0, 200, "color 2040C0\ndrag ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_x - 100))
    length = std.text.append(bytes, length, 200, " ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_y))
    length = std.text.append(bytes, length, 200, " ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_x + 100))
    length = std.text.append(bytes, length, 200, " ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_y))
    length = std.text.append(bytes, length, 200, " 20\n")
    if !script.run(app, bytes[0..length]) { return 8 }
    if shown(app, 200, 150) != 0xFF2040C0 || shown(app, 120, 150) != 0xFF2040C0 || shown(app, 200, 100) != 0xFFFFFFFF { return 9 }
    if !history.canUndo(doc.*.image.*.history) || history.stepsDone(doc.*.image.*.history) != 1 || !documents.isModified(doc) { return 10 }
    if api.activeNode(app).?.*.overlay != null { return 11 }

    // Undo and redo by their keys; what the status bar says.
    if !script.run(app, "key Ctrl+Z\nexpect 200 150 FFFFFFFF\nexpect-note Undone\n") { return 12 }
    if documents.isModified(doc) { return 14 }
    if !script.run(app, "key Ctrl+Shift+Z\nexpect 200 150 FF2040C0\nexpect-note Redone\n") { return 15 }

    // The eraser takes the paint and the ground away: the layer below
    // shows (the white background layer).
    if !script.run(app, "key E\n") || !app.*.eraser { return 16 }
    length = std.text.append(bytes, 0, 200, "click ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_x))
    length = std.text.append(bytes, length, 200, " ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_y))
    length = std.text.append(bytes, length, 200, "\nkey E\n")
    if !script.run(app, bytes[0..length]) || app.*.eraser { return 17 }
    if shown(app, 200, 150) != 0xFFFFFFFF || shown(app, 150, 150) != 0xFF2040C0 { return 18 }
    if device.pixel(api.activeNode(app).?.*.device.?, 200, 150) != 0 { return 19 }

    // The colours swapped and set back.
    if !script.run(app, "background 00FF00\nkey X\n") || app.*.foreground != 0xFF00FF00 || app.*.background != 0xFF2040C0 { return 20 }
    if !script.run(app, "key D\n") || app.*.foreground != 0xFF000000 || app.*.background != 0xFFFFFFFF { return 21 }

    // The wheel zooms about the pointer; the hand (the middle button)
    // moves the view; neither changes the image.
    length = std.text.append(bytes, 0, 200, "pointer ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_x))
    length = std.text.append(bytes, length, 200, " ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_y))
    length = std.text.append(bytes, length, 200, "\nwheel -2\n")
    if !script.run(app, bytes[0..length]) { return 22 }
    if doc.*.view.zoom < 1.5 || doc.*.view.zoom > 1.6 { return 23 }
    if doc.*.view.centerX < 199.0 || doc.*.view.centerX > 201.0 { return 24 }
    const before_x = doc.*.view.centerX
    if !script.run(app, "press middle\n") { return 25 }
    length = std.text.append(bytes, 0, 200, "pointer ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_x + 50))
    length = std.text.append(bytes, length, 200, " ")
    length = std.text.appendSigned(bytes, length, 200, @intCast(isize, middle_y))
    length = std.text.append(bytes, length, 200, "\nrelease middle\n")
    if !script.run(app, bytes[0..length]) { return 26 }
    if doc.*.view.centerX >= before_x - 20.0 { return 27 }
    if history.stepsDone(doc.*.image.*.history) != 2 { return 28 }

    // A tool by its key, by its name, and one that is not there.
    if !script.run(app, "tool brush\nkey B\n") || app.*.tool != 0 { return 29 }
    if script.run(app, "tool no-such-tool\n") { return 30 }
    if script.run(app, "expect 0 0 12345678\n") { return 31 }
    if script.run(app, "bogus step\n") { return 32 }

    // A frame as a picture, the canvas only, and German.
    if !script.run(app, "shot app.png\nkey Tab\n") || !app.*.canvasOnly { return 33 }
    if app.*.canvasArea.height != 600 { return 34 }
    if !script.run(app, "key Tab\ngerman\nkey Ctrl+Z\nexpect-note R\xC3\xBCckg\n") { return 35 }
    const frame = script.frameOf(app)
    if frame == null || frame.?.*.width != 800 || frame.?.*.height != 600 { return 36 }
    if !std.fs.exists("app.png\x00".pointer) { return 37 }

    // A second document comes in front; closing it brings the first back.
    if !script.run(app, "new 64 64\n") || app.*.count != 2 || app.*.current != 1 { return 38 }
    if api.image(app).?.*.width != 64 || shown(app, 5, 5) != 0 { return 39 }
    documents.close(app, 1)
    if app.*.count != 1 || api.image(app).?.*.width != 400 { return 40 }
    return 13
}
